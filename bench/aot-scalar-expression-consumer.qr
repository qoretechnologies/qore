#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

int sub main() {
    int rounds = ENV.QORE_BENCH_ROUNDS ? ENV.QORE_BENCH_ROUNDS.toInt() : 10000000;
    int checksum = 0;
    float float_checksum = 0.0;
    for (int i = 0; i < rounds; ++i) {
        int value = (i & 1023) + 1;
        int divisor = (i & 7) + 1;
        int adjustment = i & 15;
        checksum += nestedScalarDivScore(value, divisor, adjustment);
        checksum += scalarModScore(value, divisor, adjustment);
        checksum += scalarShiftScore(value, adjustment);
        checksum += scalarNegScore(value, adjustment);
        float_checksum += nestedScalarFloatScore(value, divisor, adjustment);
    }
    printf("%d:%.17g\n", checksum, float_checksum);
    return 0;
}
