#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

int sub main() {
    int rounds = ENV.QORE_BENCH_ROUNDS ? ENV.QORE_BENCH_ROUNDS.toInt() : 20000000;
    float checksum = 0.0;
    for (int i = 0; i < rounds; ++i) {
        checksum += wideFloatExpression((i & 1023) * 0.125);
    }
    printf("%.17g\n", checksum);
    return 0;
}

main();
