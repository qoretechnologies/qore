#!/usr/bin/env qr
# -*- mode: qore; indent-tabs-mode: nil -*-
#
# Copyright 2026 Qore Technologies, s.r.o.

%exec-class BenchDataProviderMlGbtRegressionBufferColumns

%requires ../lib/BenchRunner.qm
%requires ../lib/DataFrameBenchData.qm
%requires DataProviderML

%strict-args
%require-types
%enable-all-warnings

class BenchDataProviderMlGbtRegressionBufferColumns {
    constructor() {
        Bench::BenchRunner r("dataproviderml_gbt_regression_buffercolumns");
        r.iterations = 6;
        r.warmup = 2;

        int rows = DataFrameBench::defaultRows();
        ColumnarResult columns;

        r.setup = sub () {
            buffer<float64> x = buffer<float64>::sized(rows);
            buffer<float64> y = buffer<float64>::sized(rows);
            buffer<float64> target = buffer<float64>::sized(rows);
            for (int i = 0; i < rows; ++i) {
                x[i] = DataFrameBench::amountFor(i) / 100.0;
                y[i] = DataFrameBench::scoreFor(i);
                target[i] = x[i] * 1.5 + y[i] * 0.25;
            }
            columns = ColumnarResult::fromColumnHash({"x": x, "y": y, "target": target});
            r.bytes_processed = rows * 24;
        };

        r.measure = sub () {
            DataProviderML::QoreGBTRegressionProcessor proc({
                "fields": ("x", "y"),
                "target_field": "target",
                "window_size": 50,
                "n_estimators": 5,
                "max_depth": 3,
                "learning_rate": 0.1,
            });
            ColumnarResult result = proc.processRecordsShape(columns, DataProviderShape::BufferColumns);
            DataFrameBench::verifyColumnarRows("dataproviderml_gbt_regression_buffercolumns", result, rows);
            if (result.getColumn("event_type").lsize() != rows) {
                throw "BENCHMARK-ERROR", "GBT regression did not produce expected output rows";
            }
        };

        exit(r.run());
    }
}
