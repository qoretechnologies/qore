#!/usr/bin/env qr
# -*- mode: qore; indent-tabs-mode: nil -*-
#
# Copyright 2026 Qore Technologies, s.r.o.

%exec-class BenchDataProviderMlRandomForestClassificationBufferColumns

%requires ../lib/BenchRunner.qm
%requires ../lib/DataFrameBenchData.qm
%requires DataProviderML

%strict-args
%require-types
%enable-all-warnings

class BenchDataProviderMlRandomForestClassificationBufferColumns {
    constructor() {
        Bench::BenchRunner r("dataproviderml_random_forest_classification_buffercolumns");
        r.iterations = 6;
        r.warmup = 2;

        int rows = DataFrameBench::defaultRows();
        ColumnarResult columns;

        r.setup = sub () {
            buffer<float64> x = buffer<float64>::sized(rows);
            buffer<float64> y = buffer<float64>::sized(rows);
            buffer<float64> label = buffer<float64>::sized(rows);
            for (int i = 0; i < rows; ++i) {
                x[i] = float(i % 50) / 50.0;
                y[i] = float((i * 7) % 50) / 50.0;
                label[i] = (x[i] + y[i]) > 1.0 ? 1.0 : 0.0;
            }
            columns = ColumnarResult::fromColumnHash({"x": x, "y": y, "label": label});
            r.bytes_processed = rows * 24;
        };

        r.measure = sub () {
            DataProviderML::QoreRandomForestClassificationProcessor proc({
                "fields": ("x", "y"),
                "target_field": "label",
                "window_size": 50,
                "n_trees": 5,
                "max_depth": 5,
            });
            ColumnarResult result = proc.processRecordsShape(columns, DataProviderShape::BufferColumns);
            DataFrameBench::verifyColumnarRows(
                "dataproviderml_random_forest_classification_buffercolumns", result, rows);
            if (result.getColumn("event_type").lsize() != rows) {
                throw "BENCHMARK-ERROR", "random forest classification did not produce expected output rows";
            }
        };

        exit(r.run());
    }
}
