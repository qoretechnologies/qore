#!/usr/bin/env qr
# -*- mode: qore; indent-tabs-mode: nil -*-
#
# Copyright 2026 Qore Technologies, s.r.o.

%exec-class BenchDataProviderMlKnnClassificationBufferColumns

%requires ../lib/BenchRunner.qm
%requires ../lib/DataFrameBenchData.qm
%requires DataProviderML

%strict-args
%require-types
%enable-all-warnings

class BenchDataProviderMlKnnClassificationBufferColumns {
    constructor() {
        Bench::BenchRunner r("dataproviderml_knn_classification_buffercolumns");
        r.iterations = 6;
        r.warmup = 2;

        int rows = DataFrameBench::defaultRows();
        ColumnarResult columns;

        r.setup = sub () {
            buffer<float64> x = buffer<float64>::sized(rows);
            buffer<float64> y = buffer<float64>::sized(rows);
            buffer<float64> label = buffer<float64>::sized(rows);
            for (int i = 0; i < rows; ++i) {
                int c = i % 2;
                x[i] = (c ? 10.0 : 0.0) + float(i % 20) / 100.0;
                y[i] = (c ? 10.0 : 0.0) + float((i * 7) % 20) / 100.0;
                label[i] = c;
            }
            columns = ColumnarResult::fromColumnHash({"x": x, "y": y, "label": label});
            r.bytes_processed = rows * 24;
        };

        r.measure = sub () {
            DataProviderML::QoreKNNClassificationProcessor proc({
                "fields": ("x", "y"),
                "target_field": "label",
                "window_size": 50,
                "k": 5,
            });
            ColumnarResult result = proc.processRecordsShape(columns, DataProviderShape::BufferColumns);
            DataFrameBench::verifyColumnarRows("dataproviderml_knn_classification_buffercolumns", result, rows);
            if (result.getColumn("event_type").lsize() != rows) {
                throw "BENCHMARK-ERROR", "KNN classification did not produce expected output rows";
            }
        };

        exit(r.run());
    }
}
