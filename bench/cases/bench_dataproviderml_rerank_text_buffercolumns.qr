#!/usr/bin/env qr
# -*- mode: qore; indent-tabs-mode: nil -*-

%exec-class BenchDataProviderMlRerankTextBufferColumns

%requires ../lib/BenchRunner.qm
%requires ../lib/OnnxBenchData.qm
%requires DataProviderML
%requires ml

%strict-args
%require-types
%enable-all-warnings

class BenchDataProviderMlRerankTextBufferColumns {
    constructor() {
        string model_path = OnnxBench::tokenRerankerModelPath();
        if (!OnnxBench::canRunTextOnnx(model_path)) {
            printf("dataproviderml_rerank_text_buffercolumns: skipped (ONNX text fixtures not available)\n");
            exit(0);
        }

        Bench::BenchRunner r("dataproviderml_rerank_text_buffercolumns");
        r.iterations = 4;
        r.warmup = 1;

        int rows = OnnxBench::textRows();
        ColumnarResult columns;
        DataProviderML::QoreRerankerProcessor proc({
            "query_field": "query",
            "passage_field": "passage",
            "top_k": rows,
            "reranker_mode": "onnx",
            "reranker_model_path": model_path,
            "tokenizer_config_path": OnnxBench::tokenizerPath(),
            "onnx_session_config": <ML::OnnxSessionConfig>{"providers": ()},
            "max_length": 24,
        });

        r.setup = sub () {
            columns = ColumnarResult::fromColumnHash(OnnxBench::makeRerankColumnHash(rows));
            r.bytes_processed = OnnxBench::approxTextBytes(rows);
        };

        r.measure = sub () {
            ColumnarResult result = proc.processRecordsShape(columns, DataProviderShape::BufferColumns);
            OnnxBench::verifyRerankColumns("dataproviderml_rerank_text_buffercolumns", result, rows);
        };

        exit(r.run());
    }
}
