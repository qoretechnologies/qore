#!/usr/bin/env qr
# -*- mode: qore; indent-tabs-mode: nil -*-
#
# Copyright 2026 Qore Technologies, s.r.o.

%exec-class BenchDataProviderMlLofRows

%requires ../lib/BenchRunner.qm
%requires ../lib/DataFrameBenchData.qm
%requires DataProviderML

%strict-args
%require-types
%enable-all-warnings

class BenchDataProviderMlLofRows {
    constructor() {
        Bench::BenchRunner r("dataproviderml_lof_rows");
        r.iterations = 6;
        r.warmup = 2;

        int rows = DataFrameBench::defaultRows();
        list<hash<auto>> records;

        r.setup = sub () {
            for (int i = 0; i < rows; ++i) {
                push records, {
                    "x": float(i % 50) / 10.0,
                    "y": float((i * 7) % 50) / 10.0,
                };
            }
            r.bytes_processed = rows * 16;
        };

        r.measure = sub () {
            DataProviderML::QoreLOFProcessor proc({
                "fields": ("x", "y"),
                "window_size": 50,
                "k": 5,
            });
            list<auto> result;
            foreach hash<auto> rec in (records) {
                *auto row_result = proc.processRecord(rec);
                if (exists row_result) {
                    result += row_result;
                }
            }
            if (result.lsize() != rows) {
                throw "BENCHMARK-ERROR", "LOF did not produce expected row output";
            }
        };

        exit(r.run());
    }
}
