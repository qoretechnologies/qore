#!/usr/bin/env qr
# -*- mode: qore; indent-tabs-mode: nil -*-

%exec-class BenchOnnxRunTensor

%requires ../lib/BenchRunner.qm
%requires ../lib/OnnxBenchData.qm
%requires ml

%strict-args
%require-types
%enable-all-warnings

class BenchOnnxRunTensor {
    constructor() {
        string model_path = OnnxBench::modelPath();
        if (!OnnxBench::canRunOnnx(model_path)) {
            printf("onnx_run_tensor: skipped (ONNX Runtime or test model not available)\n");
            exit(0);
        }

        Bench::BenchRunner r("onnx_run_tensor");
        r.iterations = 8;
        r.warmup = 2;

        int rows = OnnxBench::rows();
        ML::OnnxModel model(model_path, <ML::OnnxSessionConfig>{"providers": ()});
        ML::Tensor input;

        r.setup = sub () {
            input = new ML::Tensor(OnnxBench::makeFloat32Input(rows), (rows, 1));
            r.bytes_processed = OnnxBench::approxBytes(rows);
        };

        r.measure = sub () {
            hash<auto> result = model.runTensors({"X": input});
            ML::Tensor output = result.Y;
            OnnxBench::verifyTensorOutput("onnx_run_tensor", output, rows);
        };

        exit(r.run());
    }
}
