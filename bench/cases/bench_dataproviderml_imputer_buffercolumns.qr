#!/usr/bin/env qr
# -*- mode: qore; indent-tabs-mode: nil -*-
#
# Copyright 2026 Qore Technologies, s.r.o.

%exec-class BenchDataProviderMlImputerBufferColumns

%requires ../lib/BenchRunner.qm
%requires ../lib/DataFrameBenchData.qm
%requires DataProviderML

%strict-args
%require-types
%enable-all-warnings

class BenchDataProviderMlImputerBufferColumns {
    constructor() {
        Bench::BenchRunner r("dataproviderml_imputer_buffercolumns");
        r.iterations = 6;
        r.warmup = 2;

        int rows = DataFrameBench::defaultRows();
        ColumnarResult columns;

        r.setup = sub () {
            list<auto> x;
            list<auto> y;
            for (int i = 0; i < rows; ++i) {
                push x, (i % 11) == 10 ? NOTHING : DataFrameBench::amountFor(i);
                push y, (i % 13) == 12 ? NOTHING : DataFrameBench::scoreFor(i);
            }
            columns = ColumnarResult::fromColumnHash({"x": x, "y": y});
            r.bytes_processed = rows * 16;
        };

        r.measure = sub () {
            DataProviderML::QoreImputerProcessor proc({
                "fields": ("x", "y"),
                "window_size": rows,
                "strategy": "mean",
            });
            ColumnarResult result = proc.processRecordsShape(columns, DataProviderShape::BufferColumns);
            DataFrameBench::verifyColumnarRows("dataproviderml_imputer_buffercolumns", result, rows);
            if (result.getColumn("event_type").lsize() != rows) {
                throw "BENCHMARK-ERROR", "imputer did not produce expected output rows";
            }
        };

        exit(r.run());
    }
}
