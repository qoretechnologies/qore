#!/usr/bin/env qr
# -*- mode: qore; indent-tabs-mode: nil -*-
#
# Copyright 2026 Qore Technologies, s.r.o.

%exec-class BenchDataProviderMlChunkTextBufferColumnsBridge

%requires ../lib/BenchRunner.qm
%requires ../lib/OnnxBenchData.qm
%requires DataProviderML

%strict-args
%require-types
%enable-all-warnings

class BenchDataProviderMlChunkTextBufferColumnsBridge {
    constructor() {
        if (!OnnxBench::canRunTokenizer()) {
            printf("dataproviderml_chunk_text_buffercolumns_bridge: skipped (tokenizer fixture not available)\n");
            exit(0);
        }

        Bench::BenchRunner r("dataproviderml_chunk_text_buffercolumns_bridge");
        r.iterations = 6;
        r.warmup = 2;

        int rows = OnnxBench::textRows();
        ColumnarResult columns;
        DataProviderML::QoreChunkTextProcessor proc({
            "text_field": "body",
            "tokenizer_config_path": OnnxBench::tokenizerPath(),
            "chunk_size": 6,
            "chunk_overlap": 0,
        });

        r.setup = sub () {
            columns = ColumnarResult::fromColumnHash(OnnxBench::makeTextColumnHash(rows));
            r.bytes_processed = OnnxBench::approxTextBytes(rows);
        };

        r.measure = sub () {
            list<auto> input_rows = AbstractDataProcessor::convertShape(
                columns, DataProviderShape::BufferColumns, DataProviderShape::RowRecords);
            list<auto> output_rows;
            foreach auto row in (input_rows) {
                OnnxBench::collectResult(\output_rows, proc.processRecord(row));
            }
            hash<auto> bulk = AbstractDataProcessor::recordsToHashList(output_rows);
            ColumnarResult result = AbstractDataProcessor::convertHashListResultShape(
                bulk, DataProviderShape::BufferColumns);
            int out_rows = AbstractDataProcessor::shapeRecordCount(result, DataProviderShape::BufferColumns);
            if (out_rows < rows || result.getColumn("chunk_text").lsize() != out_rows
                    || result.getColumn("chunk_token_count").lsize() != out_rows) {
                throw "BENCHMARK-ERROR", "chunk-text bridge BufferColumns produced invalid output";
            }
        };

        exit(r.run());
    }
}
