#!/usr/bin/env qr
# -*- mode: qore; indent-tabs-mode: nil -*-
#
# Copyright 2026 Qore Technologies, s.r.o.

%exec-class BenchDataProviderMlClassificationMetricsBufferColumns

%requires ../lib/BenchRunner.qm
%requires ../lib/DataFrameBenchData.qm
%requires DataProviderML

%strict-args
%require-types
%enable-all-warnings

class BenchDataProviderMlClassificationMetricsBufferColumns {
    constructor() {
        Bench::BenchRunner r("dataproviderml_classification_metrics_buffercolumns");
        r.iterations = 6;
        r.warmup = 2;

        int rows = DataFrameBench::defaultRows();
        ColumnarResult columns;

        r.setup = sub () {
            buffer<int64> pred = buffer<int64>::sized(rows);
            buffer<int64> actual = buffer<int64>::sized(rows);
            for (int i = 0; i < rows; ++i) {
                actual[i] = i % 3;
                pred[i] = (i % 10) == 0 ? ((i + 1) % 3) : actual[i];
            }
            columns = ColumnarResult::fromColumnHash({"pred": pred, "actual": actual});
            r.bytes_processed = rows * 16;
        };

        r.measure = sub () {
            DataProviderML::QoreClassificationMetricsProcessor proc({
                "predicted_field": "pred",
                "true_field": "actual",
                "window_size": rows,
            });
            ColumnarResult result = proc.processRecordsShape(columns, DataProviderShape::BufferColumns);
            DataFrameBench::verifyColumnarRows("dataproviderml_classification_metrics_buffercolumns", result, 1);
            if (result.getColumn("sample_count")[0] != rows) {
                throw "BENCHMARK-ERROR", "classification metrics did not process all samples";
            }
        };

        exit(r.run());
    }
}
