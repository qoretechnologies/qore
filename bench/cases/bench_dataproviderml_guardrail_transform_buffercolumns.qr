#!/usr/bin/env qr
# -*- mode: qore; indent-tabs-mode: nil -*-
#
# Copyright 2026 Qore Technologies, s.r.o.

%exec-class BenchDataProviderMlGuardrailTransformBufferColumns

%requires ../lib/BenchRunner.qm
%requires ../lib/OnnxBenchData.qm
%requires DataProviderML

%strict-args
%require-types
%enable-all-warnings

class BenchDataProviderMlGuardrailTransformBufferColumns {
    constructor() {
        Bench::BenchRunner r("dataproviderml_guardrail_transform_buffercolumns");
        r.iterations = 6;
        r.warmup = 2;

        int rows = guardrailRows();
        ColumnarResult columns;
        DataProviderML::QoreGuardrailTransformProcessor proc({
            "text_field": "body",
            "rules": (
                {"type": "pii", "severity": "high", "params": {"action": "redact"}},
            ),
        });

        r.setup = sub () {
            columns = ColumnarResult::fromColumnHash(makeGuardrailColumnHash(rows));
            r.bytes_processed = rows * 96;
        };

        r.measure = sub () {
            ColumnarResult result = proc.processRecordsShape(columns, DataProviderShape::BufferColumns);
            int out_rows = AbstractDataProcessor::shapeRecordCount(result, DataProviderShape::BufferColumns);
            list<auto> passed = OnnxBench::columnToList(result.getColumn("_guardrail_passed"));
            if (out_rows != rows || passed.lsize() != rows) {
                throw "BENCHMARK-ERROR",
                    sprintf("guardrail-transform native returned %d/%d rows; expected %d",
                        out_rows, passed.lsize(), rows);
            }
        };

        exit(r.run());
    }

    private static int guardrailRows() {
        *string env_rows = ENV.QORE_BENCH_GUARDRAIL_ROWS;
        return env_rows ? env_rows.toInt() : 20000;
    }

    private static hash<auto> makeGuardrailColumnHash(int rows) {
        buffer<int64> ids = buffer<int64>::sized(rows);
        list<string> bodies;
        for (int i = 0; i < rows; ++i) {
            ids[i] = i;
            push bodies, (i % 10) == 0
                ? sprintf("customer %d email user%d@example.com", i, i)
                : sprintf("clean customer support note %d", i);
        }
        return {"id": ids, "body": bodies};
    }
}
