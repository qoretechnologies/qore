#!/usr/bin/env qr
# -*- mode: qore; indent-tabs-mode: nil -*-

%exec-class BenchDataFrameConstructBuffers

%requires ../lib/BenchRunner.qm
%requires ../lib/DataFrameBenchData.qm
%requires dataframe

%strict-args
%require-types
%enable-all-warnings

class BenchDataFrameConstructBuffers {
    constructor() {
        Bench::BenchRunner r("dataframe_construct_buffers");
        r.iterations = 8;
        r.warmup = 2;

        int rows = DataFrameBench::defaultRows();
        hash<auto> columns;

        r.setup = sub () {
            columns = DataFrameBench::makeBufferColumns(rows);
            r.bytes_processed = DataFrameBench::approxBytes(rows);
        };

        r.measure = sub () {
            DataFrame::DataFrame df(columns);
            DataFrameBench::verifyRows("dataframe_construct_buffers", df, rows);
            if (df.getColumnBuffer("id").lsize() != rows) {
                throw "BENCHMARK-ERROR", "dataframe_construct_buffers lost dense id storage";
            }
        };

        exit(r.run());
    }
}
