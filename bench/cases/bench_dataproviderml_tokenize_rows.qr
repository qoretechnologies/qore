#!/usr/bin/env qr
# -*- mode: qore; indent-tabs-mode: nil -*-

%exec-class BenchDataProviderMlTokenizeRows

%requires ../lib/BenchRunner.qm
%requires ../lib/OnnxBenchData.qm
%requires DataProviderML

%strict-args
%require-types
%enable-all-warnings

class BenchDataProviderMlTokenizeRows {
    constructor() {
        if (!OnnxBench::canRunTokenizer()) {
            printf("dataproviderml_tokenize_rows: skipped (tokenizer fixture not available)\n");
            exit(0);
        }

        Bench::BenchRunner r("dataproviderml_tokenize_rows");
        r.iterations = 6;
        r.warmup = 2;

        int rows = OnnxBench::textRows();
        list<hash<auto>> records;
        DataProviderML::QoreTokenizeProcessor proc({
            "text_field": "body",
            "tokenizer_config_path": OnnxBench::tokenizerPath(),
            "add_special_tokens": False,
        });

        r.setup = sub () {
            records = OnnxBench::makeTextRecords(rows);
            r.bytes_processed = OnnxBench::approxTextBytes(rows);
        };

        r.measure = sub () {
            list<auto> results;
            foreach hash<auto> rec in (records) {
                OnnxBench::collectResult(\results, proc.processRecord(rec));
            }
            OnnxBench::verifyTokenRows("dataproviderml_tokenize_rows", results, rows);
        };

        exit(r.run());
    }
}
