#!/usr/bin/env qr
# -*- mode: qore; indent-tabs-mode: nil -*-

%exec-class BenchDataFrameArrowIpcSlicedNullable

%requires ../lib/BenchRunner.qm
%requires ../lib/DataFrameBenchData.qm
%requires dataframe

%strict-args
%require-types
%enable-all-warnings

class BenchDataFrameArrowIpcSlicedNullable {
    constructor() {
        Bench::BenchRunner r("dataframe_arrow_ipc_sliced_nullable");
        r.iterations = 8;
        r.warmup = 2;

        int rows = DataFrameBench::defaultRows();
        DataFrame::DataFrame sliced;

        r.setup = sub () {
            list<auto> ids;
            list<auto> flags;
            list<auto> amounts;

            for (int i = 0; i < rows + 2; ++i) {
                push ids, (i % 5) == 0 ? NOTHING : i;
                push flags, (i % 7) == 0 ? NOTHING : ((i % 2) == 0);
                push amounts, (i % 11) == 0 ? NOTHING : (i.toNumber() / 100n);
            }

            DataFrame::DataFrame df({
                "id": new buffer<*int64>(ids),
                "flag": new buffer<*bool>(flags),
                "amount": new buffer<*decimal128>(amounts),
            });
            sliced = df.slice(1, rows + 1);
            r.bytes_processed = rows * (8 + 1 + 16) * 2;
        };

        r.measure = sub () {
            binary payload = sliced.toArrowIpc();
            DataFrame::DataFrame copy = DataFrame::DataFrame::fromArrowIpc(payload);
            DataFrameBench::verifyRows("dataframe_arrow_ipc_sliced_nullable", copy, rows);
            if (copy.getColumn("id")[0] != 1) {
                throw "BENCHMARK-ERROR", "dataframe_arrow_ipc_sliced_nullable returned an unexpected first row";
            }
        };

        exit(r.run());
    }
}
