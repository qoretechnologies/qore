#!/usr/bin/env qr
# -*- mode: qore; indent-tabs-mode: nil -*-

%exec-class BenchDataProviderMlEmbedTextDataFrameColumns

%requires ../lib/BenchRunner.qm
%requires ../lib/OnnxBenchData.qm
%requires dataframe
%requires DataProviderML
%requires ml

%strict-args
%require-types
%enable-all-warnings

class BenchDataProviderMlEmbedTextDataFrameColumns {
    constructor() {
        string model_path = OnnxBench::tokenEmbeddingModelPath();
        if (!OnnxBench::canRunTextOnnx(model_path)) {
            printf("dataproviderml_embed_text_dataframe_columns: skipped "
                "(ONNX text fixtures not available)\n");
            exit(0);
        }

        Bench::BenchRunner r("dataproviderml_embed_text_dataframe_columns");
        r.iterations = 4;
        r.warmup = 1;

        int rows = OnnxBench::textRows();
        DataFrame::DataFrame frame;
        DataProviderML::QoreEmbedTextProcessor proc({
            "text_field": "body",
            "window_size": 128,
            "embedding_mode": "onnx",
            "embedding_model_path": model_path,
            "tokenizer_config_path": OnnxBench::tokenizerPath(),
            "onnx_session_config": <ML::OnnxSessionConfig>{"providers": ()},
            "max_tokens": 16,
            "output_mode": "columns",
        });

        r.setup = sub () {
            frame = OnnxBench::makeTextFrame(rows);
            r.bytes_processed = OnnxBench::approxTextBytes(rows);
        };

        r.measure = sub () {
            DataFrame::DataFrame result = proc.processRecordsShape(frame, DataProviderShape::DataFrameBlock);
            OnnxBench::verifyEmbedFlatFrame("dataproviderml_embed_text_dataframe_columns", result, rows);
        };

        exit(r.run());
    }
}
