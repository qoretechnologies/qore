#!/usr/bin/env qr
# -*- mode: qore; indent-tabs-mode: nil -*-
#
# Copyright 2026 Qore Technologies, s.r.o.

%exec-class BenchDataProviderMlImputerRows

%requires ../lib/BenchRunner.qm
%requires ../lib/DataFrameBenchData.qm
%requires DataProviderML

%strict-args
%require-types
%enable-all-warnings

class BenchDataProviderMlImputerRows {
    constructor() {
        Bench::BenchRunner r("dataproviderml_imputer_rows");
        r.iterations = 6;
        r.warmup = 2;

        int rows = DataFrameBench::defaultRows();
        list<hash<auto>> records;

        r.setup = sub () {
            for (int i = 0; i < rows; ++i) {
                push records, {
                    "x": (i % 11) == 10 ? NOTHING : DataFrameBench::amountFor(i),
                    "y": (i % 13) == 12 ? NOTHING : DataFrameBench::scoreFor(i),
                };
            }
            r.bytes_processed = rows * 16;
        };

        r.measure = sub () {
            DataProviderML::QoreImputerProcessor proc({
                "fields": ("x", "y"),
                "window_size": rows,
                "strategy": "mean",
            });
            list<auto> result;
            foreach hash<auto> rec in (records) {
                *auto row_result = proc.processRecord(rec);
                if (exists row_result) {
                    result += row_result;
                }
            }
            if (result.lsize() != rows) {
                throw "BENCHMARK-ERROR", "imputer did not produce expected row output";
            }
        };

        exit(r.run());
    }
}
