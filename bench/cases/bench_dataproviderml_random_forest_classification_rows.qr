#!/usr/bin/env qr
# -*- mode: qore; indent-tabs-mode: nil -*-
#
# Copyright 2026 Qore Technologies, s.r.o.

%exec-class BenchDataProviderMlRandomForestClassificationRows

%requires ../lib/BenchRunner.qm
%requires ../lib/DataFrameBenchData.qm
%requires DataProviderML

%strict-args
%require-types
%enable-all-warnings

class BenchDataProviderMlRandomForestClassificationRows {
    constructor() {
        Bench::BenchRunner r("dataproviderml_random_forest_classification_rows");
        r.iterations = 6;
        r.warmup = 2;

        int rows = DataFrameBench::defaultRows();
        list<hash<auto>> records;

        r.setup = sub () {
            for (int i = 0; i < rows; ++i) {
                float x = float(i % 50) / 50.0;
                float y = float((i * 7) % 50) / 50.0;
                push records, {
                    "x": x,
                    "y": y,
                    "label": (x + y) > 1.0 ? 1.0 : 0.0,
                };
            }
            r.bytes_processed = rows * 24;
        };

        r.measure = sub () {
            DataProviderML::QoreRandomForestClassificationProcessor proc({
                "fields": ("x", "y"),
                "target_field": "label",
                "window_size": 50,
                "n_trees": 5,
                "max_depth": 5,
            });
            list<auto> result;
            foreach hash<auto> rec in (records) {
                *auto row_result = proc.processRecord(rec);
                if (exists row_result) {
                    result += row_result;
                }
            }
            if (result.lsize() != rows) {
                throw "BENCHMARK-ERROR", "random forest classification did not produce expected row output";
            }
        };

        exit(r.run());
    }
}
