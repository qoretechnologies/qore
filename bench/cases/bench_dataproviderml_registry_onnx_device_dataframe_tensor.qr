#!/usr/bin/env qr
# -*- mode: qore; indent-tabs-mode: nil -*-

%exec-class BenchDataProviderMlRegistryOnnxDeviceDataFrameTensor

%requires ../lib/BenchRunner.qm
%requires ../lib/OnnxBenchData.qm
%requires dataframe
%requires DataProviderML
%requires QoreModelRegistry
%requires ml

%strict-args
%require-types
%enable-all-warnings

#! Registry-backed DataProviderML ONNX tensor path with a device-binding manifest policy.
/** The package is registered with a device-binding execution policy that the
    QoreModelRegistry execution adapter honors. With the default CPU provider the
    policy resolves to CPU output memory, so the benchmark runs everywhere; set
    QORE_BENCH_ONNX_PROVIDER=CUDA to retain device outputs. Transfer counters from
    the processor diagnostics are printed after the run.
*/
class BenchDataProviderMlRegistryOnnxDeviceDataFrameTensor {
    constructor() {
        string model_path = OnnxBench::modelPath();
        if (!OnnxBench::canRunOnnx(model_path)) {
            printf("dataproviderml_registry_onnx_device_dataframe_tensor: skipped "
                "(ONNX Runtime or test model not available)\n");
            exit(0);
        }

        Bench::BenchRunner r("dataproviderml_registry_onnx_device_dataframe_tensor");
        r.iterations = 8;
        r.warmup = 2;

        int rows = OnnxBench::rows();
        string dir = tmp_location() + DirSep + "qore_onnx_bench_" + get_random_bytes(4).toHex();
        on_exit {
            OnnxBench::cleanupDir(dir);
        }
        mkdir_ex(dir, 0755, True);

        string package_dir = dir + DirSep + "linear_onnx";
        mkdir_ex(package_dir, 0755, True);
        File f();
        f.open(package_dir + DirSep + "model.onnx", O_CREAT | O_WRONLY | O_TRUNC, 0644);
        f.write(ReadOnlyFile::readBinaryFile(model_path));

        QoreModelRegistry::ModelRegistry registry({"path": dir});
        string vid = registry.registerPackage(package_dir, {
            "name": "linear-onnx-bench-device-tensor",
            "description": "benchmark ONNX package for device-bound tensor registry inference",
            # the session config carries the provider and the device-binding policy; the
            # registry propagates device_binding into the loaded session and the adapter
            "execution_config": OnnxBench::deviceSessionConfig(),
        });

        DataFrame::DataFrame frame;
        DataProviderML::QoreRegistryModelProcessor proc({
            "registry_path": dir,
            "model_name": "linear-onnx-bench-device-tensor",
            "version": vid,
            "fields": "x",
            "window_size": rows,
            "output_mode": "tensor",
        });

        r.setup = sub () {
            frame = OnnxBench::makeFloat32Frame(rows);
            r.bytes_processed = OnnxBench::approxBytes(rows);
        };

        r.measure = sub () {
            hash<auto> result = proc.processRecordsShape(frame, DataProviderShape::DataFrameBlock);
            # shape-only check so device-resident outputs are not materialized in the hot loop
            OnnxBench::verifyTensorShape("dataproviderml_registry_onnx_device_dataframe_tensor",
                result.Y, rows);
        };

        int rc = r.run();
        OnnxBench::reportTransfers("dataproviderml_registry_onnx_device_dataframe_tensor",
            proc.getDiagnostics().device_binding.transfers);
        exit(rc);
    }
}
