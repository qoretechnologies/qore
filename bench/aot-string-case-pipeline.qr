#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

int sub transformedSliceContains(string left, string right,
        string pattern, int rounds) {
    int result = 0;
    for (int i = 0; i < rounds; ++i) {
        result += concatSlice(left, right, i & 1, 19)
            .lwr().contains(pattern);
    }
    return result;
}

int sub main() {
    int rounds = ENV.QORE_BENCH_ROUNDS
        ? ENV.QORE_BENCH_ROUNDS.toInt() : 1000000;
    printf("%d\n", transformedSliceContains(
        "DVORAK-DVO", "RAK-DVORAK-TAIL", "dvorak", rounds));
    return 0;
}

main();
