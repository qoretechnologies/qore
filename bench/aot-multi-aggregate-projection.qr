#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

hash<string, int> sub makeRow(int left, int middle, int right) {
    return {
        "left": left,
        "middle": middle,
        "right": right,
    };
}

list<int> sub makeValues(int left, int middle, int right) {
    return (left, middle, right);
}

int sub projectionKernel(int rounds) {
    int checksum = 0;
    for (int i = 0; i < rounds; ++i) {
        hash<string, int> row = makeRow(i, i + 1, i + 2);
        checksum += row.left + row.middle + row.right;
        list<int> values = makeValues(i, i + 1, i + 2);
        checksum += values[0] + values[1] + values[2];
    }
    return checksum;
}

int rounds = ARGV.size() ? ARGV[0].toInt() : 2000000;
printf("%d\n", projectionKernel(rounds));
