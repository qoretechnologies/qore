#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

list<float> sub makeFloats(float left, float right) {
    return (left, right);
}

int sub projectionKernel(int rounds) {
    int checksum = 0;
    for (int i = 0; i < rounds; ++i) {
        float selected = ((i % 2)
            ? makeFloats(i + 0.25, i + 0.5)
            : makeFloats(i + 0.75, i + 1.0))[1];
        checksum += selected > 0.0 ? 1 : 0;
    }
    return checksum;
}

int rounds = ARGV.size() ? ARGV[0].toInt() : 2000000;
printf("%d\n", projectionKernel(rounds));
