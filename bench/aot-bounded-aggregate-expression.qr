#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

list<int> sub makeComputedValues(int left, int right) {
    return (left + right, left - right, left * 3);
}

list<bool> sub makeComparedValues(int left, int right) {
    return (left < right,);
}

int sub projectionKernel(int rounds) {
    int checksum = 0;
    for (int i = 0; i < rounds; ++i) {
        checksum += makeComputedValues(i, i + 1)[0];
        checksum += makeComputedValues(i, i + 1)[1];
        checksum += makeComputedValues(i, i + 1)[2];
        checksum += makeComparedValues(i, i + 1)[0] ? 1 : 0;
    }
    return checksum;
}

int rounds = ARGV.size() ? ARGV[0].toInt() : 1000000;
printf("%d\n", projectionKernel(rounds));
