#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

int sub consume(auto value) {
    return value;
}

int sub run(int rounds) {
    int checksum = 0;
    for (int i = 0; i < rounds; ++i) {
        checksum += consume(i & 1023);
    }
    return checksum;
}

int sub main() {
    int rounds = ARGV.size() ? ARGV[0].toInt() : 20000000;
    printf("%d\n", run(rounds));
    return 0;
}

main();
