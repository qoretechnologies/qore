#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

hash<string, int> sub makeRow(int value) {
    return {
        "value": value,
    };
}

int sub projectionKernel(int rounds) {
    int checksum = 0;
    for (int i = 0; i < rounds; ++i) {
        hash<string, int> row = makeRow(i);
        *int first = row.missing;
        *int second = row.missing;
        *int third = row.missing;
        if (first === NOTHING && second === NOTHING && third === NOTHING) {
            ++checksum;
        }
    }
    return checksum;
}

int rounds = ARGV.size() ? ARGV[0].toInt() : 1000000;
printf("%d\n", projectionKernel(rounds));
