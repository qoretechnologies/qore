#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

list<int> sub variedValues(int left, int right) {
    return (left, right + 1, 7);
}

list<auto> sub mixedValues(int value, float ratio, bool enabled) {
    return (value, ratio, enabled);
}

int sub projectionKernel(int rounds) {
    int checksum = 0;
    for (int i = 0; i < rounds; ++i) {
        int index = (i % 5) - 1;
        *int selected = variedValues(i, i + 1)[index];
        checksum += selected === NOTHING ? 1 : selected;
    }
    return checksum;
}

int rounds = ARGV.size() ? ARGV[0].toInt() : 2000000;
printf("%d\n", projectionKernel(rounds));
printf("%y\n", mixedValues(11, 2.5, True)[0]);
printf("%.1f\n", mixedValues(11, 2.5, True)[1]);
printf("%y\n", mixedValues(11, 2.5, True)[2]);
