#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

hash<string, int> sub selectRow(
        int required, hash<string, int> selected) {
    return selected;
}

int sub boxedReturnSelection(int rounds) {
    hash<string, int> row = ("value": 7);
    int total = 0;
    for (int i = 0; i < rounds; ++i) {
        total = (total + selectRow(i, row).value) & 0x7fffffff;
    }
    return total;
}

int sub main() {
    int rounds = ARGV.size() ? ARGV[0].toInt() : 10000000;
    printf("%d\n", boxedReturnSelection(rounds));
    return 0;
}

main();
