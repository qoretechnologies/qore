#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

list<string> sub makeWords(string left, string right) {
    return (left, right);
}

int sub projectionKernel(int rounds) {
    string left = "alpha";
    string right = "beta";
    int checksum = 0;
    for (int i = 0; i < rounds; ++i) {
        list<string> words = makeWords(left, right);
        checksum += words[0].length() + words[1].length();
    }
    return checksum;
}

int rounds = ARGV.size() ? ARGV[0].toInt() : 2000000;
printf("%d\n", projectionKernel(rounds));
