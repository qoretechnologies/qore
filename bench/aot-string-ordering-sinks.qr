#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

int sub orderingSinks(string value, string lower, string upper, int rounds) {
    int result = 0;
    for (int i = 0; i < rounds; ++i) {
        if (lower < value) {
            ++result;
        }
        if (lower <= value) {
            ++result;
        }
        if (upper > value) {
            ++result;
        }
        if (upper >= value) {
            ++result;
        }
    }
    return result;
}

int sub main() {
    int rounds = ENV.QORE_BENCH_ROUNDS
        ? ENV.QORE_BENCH_ROUNDS.toInt() : 1000000;
    printf("%d\n", orderingSinks(
        "Prefix ABCDEFGHIJKLMNOPQRSTUVWXYZ",
        "Lower ABCDEFGHIJKLMNOPQRSTUVWXYZ",
        "Upper ABCDEFGHIJKLMNOPQRSTUVWXYZ",
        rounds));
    return 0;
}

main();
