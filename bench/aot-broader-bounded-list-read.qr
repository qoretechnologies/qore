#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

int sub affineRead(int rounds) {
    list<bool> flags = (True, False, True, True, False, True, False, True);
    list<string> words = ("a", "bb", "ccc", "dddd", "eeeee", "ffffff", "ggggggg", "hhhhhhhh");
    int total = 0;
    for (int round = 0; round < rounds; ++round) {
        for (int i = 0; i < flags.size() - 1; ++i) {
            if (flags[i + 1]) {
                ++total;
            }
        }
        for (int i = 0; i < words.size() - 1; ++i) {
            if (words[i + 1] !== "") {
                ++total;
            }
        }
    }
    return total;
}

int sub reverseRead(int rounds) {
    list<bool> flags = (True, False, True, True, False, True, False, True);
    list<string> words = ("a", "bb", "ccc", "dddd", "eeeee", "ffffff", "ggggggg", "hhhhhhhh");
    int total = 0;
    for (int round = 0; round < rounds; ++round) {
        for (int i = flags.size() - 1; i >= 0; --i) {
            if (flags[i]) {
                ++total;
            }
        }
        for (int i = words.size() - 1; i >= 0; --i) {
            if (words[i] !== "") {
                ++total;
            }
        }
    }
    return total;
}

string kernel = ARGV.size() ? ARGV[0] : "affine";
int rounds = ARGV.size() > 1 ? ARGV[1].toInt() : 2000000;
printf("%d\n", kernel == "reverse" ? reverseRead(rounds) : affineRead(rounds));
