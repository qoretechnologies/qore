#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

bool sub fixedBoolQuery(bool value) {
    list<bool> values = (value, True, False);
    return values[0];
}

int sub boolKernel(int rounds) {
    int checksum = 0;
    for (int i = 0; i < rounds; ++i) {
        if (fixedBoolQuery((i & 1) == 0)) {
            ++checksum;
        }
    }
    return checksum;
}

int rounds = ARGV.size() ? ARGV[0].toInt() : 20000000;
printf("%d\n", boolKernel(rounds));
