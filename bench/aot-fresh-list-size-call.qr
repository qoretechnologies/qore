#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

int sub listSize(list<int> values) {
    return values.size();
}

int sub run(int rounds) {
    int total = 0;
    for (int i = 0; i < rounds; ++i) {
        total += listSize((i, i + 1, i + 2, i + 3));
    }
    return total;
}

int rounds = int(ENV.QORE_BENCH_ROUNDS ?? 1000000);
printf("%d\n", run(rounds));
