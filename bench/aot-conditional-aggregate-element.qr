#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

list<int> sub makeConditionalValues(bool reverse, int left, int right) {
    if (reverse) {
        return (right, left, 7);
    }
    return (left, right, 9);
}

int sub projectionKernel(int rounds) {
    int checksum = 0;
    for (int i = 0; i < rounds; ++i) {
        checksum += makeConditionalValues(
            (i % 2) == 0, i, i + 1)[0];
    }
    return checksum;
}

int rounds = ARGV.size() ? ARGV[0].toInt() : 2000000;
printf("%d\n", projectionKernel(rounds));
