#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

list<int> sub makeValues(int left, int middle, int right) {
    return (left, middle, right);
}

int sub projectionKernel(int rounds, int index) {
    int checksum = 0;
    for (int i = 0; i < rounds; ++i) {
        list<int> values = (i & 1)
            ? makeValues(i, i + 1, i + 2)
            : makeValues(i + 3, i + 4, i + 5);
        *int first = values[index];
        *int second = values[index];
        checksum += first === second ? first : 0;
    }
    return checksum;
}

int sub main() {
    int rounds = ARGV.size() ? ARGV[0].toInt() : 2000000;
    printf("%d\n", projectionKernel(rounds, 1));
    return 0;
}

main();
