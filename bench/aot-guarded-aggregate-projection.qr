#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

list<int> sub repeatValue(int value) {
    return (value, value, value);
}

hash<string, int> sub makeRow(int value) {
    return {
        "value": value,
    };
}

int sub projectionKernel(int rounds) {
    int checksum = 0;
    for (int i = 0; i < rounds; ++i) {
        int index = (i % 5) - 1;
        *int selected = repeatValue(i)[index];
        checksum += selected === NOTHING ? 1 : selected;
        checksum += makeRow(i).missing === NOTHING ? 1 : 100;
    }
    return checksum;
}

int rounds = ARGV.size() ? ARGV[0].toInt() : 2000000;
printf("%d\n", projectionKernel(rounds));
