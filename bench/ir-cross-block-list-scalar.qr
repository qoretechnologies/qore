#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

int sub measured(int rounds) {
    int sum = 0;
    for (int i = 0; i < rounds; ++i) {
        list<int> values = (i, i + 1, i + 2);
        if (i & 1) {
            sum += values[0] + values[2];
        } else {
            sum += values[1] + values[2];
        }
    }
    return sum;
}

int sub main() {
    int rounds = ENV.QORE_BENCH_ROUNDS
        ? ENV.QORE_BENCH_ROUNDS.toInt() : 5000000;
    printf("%d\n", measured(rounds));
    return 0;
}

main();
