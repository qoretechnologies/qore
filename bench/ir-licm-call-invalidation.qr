#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

int sub opaque(int value) {
    return value & 1;
}

int sub measured(int rounds) {
    int invariant = 37;
    int sum = 0;
    for (int i = 0; i < rounds; ++i) {
        sum += invariant * 11;
        sum += opaque(i);
    }
    return sum;
}

int sub main() {
    int rounds = ENV.QORE_BENCH_ROUNDS
        ? ENV.QORE_BENCH_ROUNDS.toInt() : 20000000;
    printf("%d\n", measured(rounds));
    return 0;
}

main();
