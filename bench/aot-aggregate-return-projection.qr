#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

hash<string, int> sub makeRow(int left, int middle, int right) {
    return {
        "left": left,
        "middle": middle,
        "right": right,
    };
}

list<int> sub makeValues(int left, int middle, int right) {
    return (left, middle, right);
}

int sub projectionKernel(int rounds) {
    int checksum = 0;
    for (int i = 0; i < rounds; ++i) {
        checksum += makeRow(i, i + 1, i + 2).middle;
        checksum += makeValues(i, i + 1, i + 2).size();
        checksum += makeValues(i, i + 1, i + 2)[1].toInt();
    }
    return checksum;
}

int rounds = ARGV.size() ? ARGV[0].toInt() : 2000000;
printf("%d\n", projectionKernel(rounds));
