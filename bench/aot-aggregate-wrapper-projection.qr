#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

hash<string, int> sub makeRow(int left, int middle, int right) {
    return {
        "left": left,
        "middle": middle,
        "right": right,
    };
}

hash<string, int> sub remapRow(int left, int middle, int right) {
    return makeRow(right, left, middle);
}

hash<string, int> sub forwardRow(int left, int middle, int right) {
    return remapRow(middle, right, left);
}

int sub projectionKernel(int rounds) {
    int checksum = 0;
    for (int i = 0; i < rounds; ++i) {
        checksum += forwardRow(i, i + 1, i + 2).middle;
    }
    return checksum;
}

int rounds = ARGV.size() ? ARGV[0].toInt() : 2000000;
printf("%d\n", projectionKernel(rounds));
