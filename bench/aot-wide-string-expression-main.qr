#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

int sub main() {
    int rounds = ENV.QORE_BENCH_ROUNDS ? ENV.QORE_BENCH_ROUNDS.toInt() : 10000000;
    int checksum = 0;
    string left = "Dvo\u0159\u00e1k";
    string right = "Smetana";
    for (int i = 0; i < rounds; ++i) {
        checksum += wideStringExpression(left, i & 1023, right).length();
    }
    printf("%d\n", checksum);
    return 0;
}

main();
