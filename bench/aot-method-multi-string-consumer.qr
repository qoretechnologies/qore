#!/usr/bin/env qore

%modern

final class StringFactory {
    static string makeStatic(string prefix, string suffix) {
        return prefix + suffix;
    }

    string makeInstance(string prefix, string suffix) {
        return prefix + suffix;
    }

    int run(int rounds) {
        int checksum;
        for (int i = 0; i < rounds; ++i) {
            string static_value =
                StringFactory::makeStatic("record", "done");
            checksum += static_value.size();
            checksum += static_value.length();
            string instance_value = self.makeInstance("record", "done");
            checksum += instance_value.size();
            checksum += instance_value.length();
        }
        return checksum;
    }
}

int sub main() {
    int rounds = ENV.QORE_BENCH_ROUNDS
        ? ENV.QORE_BENCH_ROUNDS.toInt() : 5000000;
    StringFactory factory();
    printf("%d\n", factory.run(rounds));
    return 0;
}

main();
