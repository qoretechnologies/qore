#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

int rounds = ARGV.size() ? ARGV[0].toInt() : 2000000;

int sub increment(int value) {
    return value + 1;
}

code<int(int)> transform = \increment();

int checksum = 0;
for (int i = 0; i < rounds; ++i) {
    checksum += transform(i & 1023);
}
printf("%d\n", checksum);
