%requires qore >= 2.0
%requires dataframe
%requires ml

%new-style
%strict-args
%require-types
%enable-all-warnings

module OnnxBenchData {
    version = "0.1";
    desc    = "Shared deterministic data generation for ONNX benchmarks";
    author  = "Qore developers";
    url     = "https://qore.org";
    license = "MIT";
}

public namespace OnnxBench {
    public int sub rows() {
        *string env_rows = ENV.QORE_BENCH_ONNX_ROWS;
        return env_rows ? env_rows.toInt() : 10000;
    }

    public int sub approxBytes(int rows) {
        # One float input column and one float output column.
        return rows * 8;
    }

    public int sub approxSklearnBytes(int rows) {
        # Four float32 input columns, three float32 probability outputs, and one int64 label.
        return rows * ((4 + 3) * 4 + 8);
    }

    public bool sub canRunOnnx(string model_path) {
        hash<ML::MLCapabilities> caps = ML::ml_get_capabilities();
        return caps.has_onnx && is_file(model_path);
    }

    public string sub modelPath() {
        string path = get_script_dir() + "/../../modules/ml/test/data/test_linear.onnx";
        if (is_file(path)) {
            return path;
        }
        return "modules/ml/test/data/test_linear.onnx";
    }

    public string sub sklearnModelPath() {
        string path = get_script_dir() + "/../../modules/ml/test/data/test_sklearn_rf.onnx";
        if (is_file(path)) {
            return path;
        }
        return "modules/ml/test/data/test_sklearn_rf.onnx";
    }

    public list<list<float>> sub makeNestedInput(int rows) {
        list<list<float>> input;
        for (int i = 0; i < rows; ++i) {
            push input, (i.toFloat(),);
        }
        return input;
    }

    public buffer<float32> sub makeFloat32Input(int rows) {
        buffer<float32> input = buffer<float32>::sized(rows);
        for (int i = 0; i < rows; ++i) {
            input[i] = i.toFloat();
        }
        return input;
    }

    public DataFrame::DataFrame sub makeFrame(int rows) {
        buffer<float64> input = buffer<float64>::sized(rows);
        for (int i = 0; i < rows; ++i) {
            input[i] = i.toFloat();
        }
        return new DataFrame::DataFrame({"x": input});
    }

    public DataFrame::DataFrame sub makeFloat32Frame(int rows) {
        buffer<float32> input = buffer<float32>::sized(rows);
        for (int i = 0; i < rows; ++i) {
            input[i] = i.toFloat();
        }
        return new DataFrame::DataFrame({"x": input});
    }

    public DataFrame::DataFrame sub makeSklearnFrame(int rows) {
        buffer<float32> sepal_length = buffer<float32>::sized(rows);
        buffer<float32> sepal_width = buffer<float32>::sized(rows);
        buffer<float32> petal_length = buffer<float32>::sized(rows);
        buffer<float32> petal_width = buffer<float32>::sized(rows);

        for (int i = 0; i < rows; ++i) {
            int cls = i % 3;
            if (cls == 0) {
                sepal_length[i] = 5.1;
                sepal_width[i] = 3.5;
                petal_length[i] = 1.4;
                petal_width[i] = 0.2;
            } else if (cls == 1) {
                sepal_length[i] = 7.0;
                sepal_width[i] = 3.2;
                petal_length[i] = 4.7;
                petal_width[i] = 1.4;
            } else {
                sepal_length[i] = 6.3;
                sepal_width[i] = 3.3;
                petal_length[i] = 6.0;
                petal_width[i] = 2.5;
            }
        }

        return new DataFrame::DataFrame({
            "sepal_length": sepal_length,
            "sepal_width": sepal_width,
            "petal_length": petal_length,
            "petal_width": petal_width,
        });
    }

    public list<hash<auto>> sub makeRecords(int rows) {
        list<hash<auto>> records;
        for (int i = 0; i < rows; ++i) {
            push records, {"x": i.toFloat()};
        }
        return records;
    }

    public nothing sub verifyListOutput(string name, list<auto> values, int rows) {
        if (values.size() != rows) {
            throw "BENCHMARK-ERROR", sprintf("%s returned %d rows; expected %d", name, values.size(), rows);
        }
        if (rows) {
            float expected = (rows - 1).toFloat() * 2.0 + 1.0;
            float actual = values[rows - 1].toFloat();
            if (abs(expected - actual) > 0.01) {
                throw "BENCHMARK-ERROR", sprintf("%s returned %f; expected %f", name, actual, expected);
            }
        }
    }

    public nothing sub verifyTensorOutput(string name, ML::Tensor tensor, int rows) {
        if (tensor.getShape() != (rows, 1)) {
            throw "BENCHMARK-ERROR", sprintf("%s returned shape %y; expected (%d, 1)", name, tensor.getShape(), rows);
        }
        buffer<float32> values = tensor.getBuffer();
        if (values.lsize() != rows) {
            throw "BENCHMARK-ERROR", sprintf("%s returned %d dense values; expected %d", name, values.lsize(), rows);
        }
        if (rows) {
            float expected = (rows - 1).toFloat() * 2.0 + 1.0;
            float actual = values[rows - 1].toFloat();
            if (abs(expected - actual) > 0.01) {
                throw "BENCHMARK-ERROR", sprintf("%s returned %f; expected %f", name, actual, expected);
            }
        }
    }

    public nothing sub verifySklearnTensorOutput(string name, hash<auto> result, int rows) {
        ML::Tensor labels = result.label;
        if (labels.getShape() != (rows,)) {
            throw "BENCHMARK-ERROR", sprintf("%s returned label shape %y; expected (%d)",
                name, labels.getShape(), rows);
        }
        ML::Tensor probabilities = result.probabilities;
        if (probabilities.getShape() != (rows, 3)) {
            throw "BENCHMARK-ERROR", sprintf("%s returned probability shape %y; expected (%d, 3)",
                name, probabilities.getShape(), rows);
        }

        if (rows >= 3) {
            list<auto> label_values = labels.getBuffer().toList();
            if (label_values[0].toInt() != 0 || label_values[1].toInt() != 1
                    || label_values[2].toInt() != 2) {
                throw "BENCHMARK-ERROR",
                    sprintf("%s returned unexpected first labels: %y", name, label_values[0..2]);
            }
        }
    }

    public nothing sub verifyProcessorRows(string name, list<auto> rows_out, int rows) {
        if (rows_out.size() != rows) {
            throw "BENCHMARK-ERROR", sprintf("%s returned %d rows; expected %d", name, rows_out.size(), rows);
        }
        if (rows) {
            float expected = (rows - 1).toFloat() * 2.0 + 1.0;
            float actual = rows_out[rows - 1].model_output.Y.toFloat();
            if (abs(expected - actual) > 0.01) {
                throw "BENCHMARK-ERROR", sprintf("%s returned %f; expected %f", name, actual, expected);
            }
        }
    }

    public nothing sub verifyProcessorFrame(string name, DataFrame::DataFrame frame, int rows, string column) {
        if (frame.numRows() != rows) {
            throw "BENCHMARK-ERROR", sprintf("%s returned %d rows; expected %d", name, frame.numRows(), rows);
        }
        list<auto> values = frame.getColumn(column);
        if (values.size() != rows) {
            throw "BENCHMARK-ERROR", sprintf("%s returned %d values; expected %d", name, values.size(), rows);
        }
        if (rows) {
            float expected = (rows - 1).toFloat() * 2.0 + 1.0;
            float actual = values[rows - 1].Y.toFloat();
            if (abs(expected - actual) > 0.01) {
                throw "BENCHMARK-ERROR", sprintf("%s returned %f; expected %f", name, actual, expected);
            }
        }
    }

    public nothing sub verifyProcessorFlatFrame(string name, DataFrame::DataFrame frame, int rows, string column) {
        if (frame.numRows() != rows) {
            throw "BENCHMARK-ERROR", sprintf("%s returned %d rows; expected %d", name, frame.numRows(), rows);
        }
        list<auto> values = frame.getColumn(column);
        if (values.size() != rows) {
            throw "BENCHMARK-ERROR", sprintf("%s returned %d values; expected %d", name, values.size(), rows);
        }
        if (rows) {
            float expected = (rows - 1).toFloat() * 2.0 + 1.0;
            float actual = values[rows - 1].toFloat();
            if (abs(expected - actual) > 0.01) {
                throw "BENCHMARK-ERROR", sprintf("%s returned %f; expected %f", name, actual, expected);
            }
        }
    }

    public nothing sub collectResult(reference<list<auto>> results, auto r) {
        if (exists r) {
            if (r.typeCode() == NT_LIST) {
                results += r;
            } else {
                push results, r;
            }
        }
    }

    public nothing sub cleanupDir(string dir) {
        if (!is_dir(dir)) {
            return;
        }
        Dir d();
        d.chdir(dir);
        foreach string subdir in (d.listDirs()) {
            cleanupDir(dir + DirSep + subdir);
        }
        foreach string f in (d.listFiles()) {
            unlink(dir + DirSep + f);
        }
        rmdir(dir);
    }
}
