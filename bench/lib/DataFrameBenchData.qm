%requires qore >= 2.0
%requires dataframe

%new-style
%strict-args
%require-types
%enable-all-warnings

module DataFrameBenchData {
    version = "0.1";
    desc    = "Shared deterministic data generation for DataFrame benchmarks";
    author  = "Qore developers";
    url     = "https://qore.org";
    license = "MIT";
}

public namespace DataFrameBench {
    public int sub defaultRows() {
        *string env_rows = ENV.QORE_BENCH_DF_ROWS;
        return env_rows ? env_rows.toInt() : 100000;
    }

    public int sub sqlRows() {
        *string env_rows = ENV.QORE_BENCH_DF_SQL_ROWS;
        return env_rows ? env_rows.toInt() : 20000;
    }

    public int sub approxBytes(int rows) {
        # Seven scalar columns: three int/bool-ish columns, two floats, and two short strings.
        return rows * 64;
    }

    public string sub statusFor(int i) {
        return (i % 5) == 0 ? "inactive" : "active";
    }

    public string sub regionFor(int i) {
        switch (i % 6) {
            case 0:
                return "north";
            case 1:
                return "south";
            case 2:
                return "east";
            case 3:
                return "west";
            case 4:
                return "central";
        }
        return "remote";
    }

    public float sub amountFor(int i) {
        return float((i * 37) % 100000) / 10.0;
    }

    public float sub scoreFor(int i) {
        return float(50 + ((i * 17) % 5000)) / 50.0;
    }

    public hash<auto> sub makeColumns(int rows) {
        list<int> ids;
        list<int> customer_ids;
        list<string> statuses;
        list<float> amounts;
        list<float> scores;
        list<string> regions;
        list<bool> flags;

        for (int i = 0; i < rows; ++i) {
            push ids, i;
            push customer_ids, i % 10000;
            push statuses, statusFor(i);
            push amounts, amountFor(i);
            push scores, scoreFor(i);
            push regions, regionFor(i);
            push flags, (i % 7) == 0;
        }

        return {
            "id": ids,
            "customer_id": customer_ids,
            "status": statuses,
            "amount": amounts,
            "score": scores,
            "region": regions,
            "flag": flags,
        };
    }

    public list<hash<auto>> sub makeRecords(int rows) {
        list<hash<auto>> records;
        for (int i = 0; i < rows; ++i) {
            push records, {
                "id": i,
                "customer_id": i % 10000,
                "status": statusFor(i),
                "amount": amountFor(i),
                "score": scoreFor(i),
                "region": regionFor(i),
                "flag": (i % 7) == 0,
            };
        }
        return records;
    }

    public hash<auto> sub makeCustomerColumns(int rows) {
        list<int> customer_ids;
        list<string> segments;
        list<string> regions;
        list<float> weights;

        for (int i = 0; i < rows; ++i) {
            push customer_ids, i;
            push segments, (i % 3) == 0 ? "enterprise" : ((i % 3) == 1 ? "midmarket" : "smb");
            push regions, regionFor(i);
            push weights, float(100 + (i % 25)) / 100.0;
        }

        return {
            "customer_id": customer_ids,
            "segment": segments,
            "customer_region": regions,
            "weight": weights,
        };
    }

    public DataFrame::DataFrame sub makeFrame(int rows) {
        return new DataFrame::DataFrame(makeColumns(rows));
    }

    public DataFrame::DataFrame sub makeCustomerFrame(int rows) {
        return new DataFrame::DataFrame(makeCustomerColumns(rows));
    }

    public nothing sub verifyRows(string name, DataFrame::DataFrame df, int min_rows) {
        if (df.numRows() < min_rows) {
            throw "BENCHMARK-ERROR", sprintf("%s produced %d rows, expected at least %d",
                name, df.numRows(), min_rows);
        }
    }
}
