#!BuildConstraint: hardware:physicalmemory:size unit=G 24
#!BuildConstraint: hardware:disk:size unit=G 30
# Source archives are prepared from pinned commits by qore-packaging.
# Use the pinned source epoch for RPM headers and installed file timestamps.
%global source_date_epoch_from_changelog 1
%global use_source_date_epoch_as_buildtime 1
%if v"%{rpmversion}" >= v"4.20"
%global build_mtime_policy clamp_to_source_date_epoch
%else
%global clamp_mtime_to_source_date_epoch 1
%endif
%global upstream_version 3.0.0
%global module_api 2.0
%global soname 20
%global module_dir %{_libdir}/qore-modules
%global _vpath_builddir build
%bcond_without tests
%bcond_without docs

%if 0%{?suse_version}
%global libname libqore%{soname}
%global llvm_major 19
%else
%if 0%{?rhel}
%global llvm_major 21
%else
%global llvm_major 22
%endif
%global libname libqore
%endif

Name: qore
Version: 3.0.0
Release: 16%{?dist}
Summary: Multithreaded programming language and integration platform
License: (LGPL-2.1-or-later OR GPL-2.0-or-later OR MIT) AND LGPL-2.1-or-later AND Apache-2.0 AND BSD-3-Clause AND BSL-1.0 AND Unicode-3 AND BSD-2-Clause AND ISC AND HPND-Markus-Kuhn AND HPND-sell-variant AND BSD-2-Clause-NetBSD
URL: https://qore.org
Source0: %{name}-%{version}.tar.xz
BuildRequires: cmake >= 3.20
BuildRequires: make
BuildRequires: gcc-c++
BuildRequires: flex >= 2.5.35
BuildRequires: bison
BuildRequires: git
BuildRequires: python3 >= 3.11
%if %{with tests}
BuildRequires: gdb
%endif
%if 0%{?fedora}
# Fedora 0.7.3 needs bounded descriptors and correctly excluded temporary files
# when normalizing the full Qore documentation tree in OBS.
BuildRequires: add-determinism(qore-tempfile-fix) = 1
BuildRequires: linkdupes(qore-bounded-descriptors) = 1
%endif
BuildRequires: pkgconfig
BuildRequires: pkgconfig(openssl) >= 3.5
BuildRequires: pkgconfig(zlib)
BuildRequires: pkgconfig(libpcre2-8)
BuildRequires: pkgconfig(gmp)
BuildRequires: pkgconfig(mpfr)
BuildRequires: pkgconfig(libnghttp2) >= 1.70.0
BuildRequires: pkgconfig(libngtcp2) >= 1.25.0
BuildRequires: pkgconfig(libngtcp2_crypto_ossl) >= 1.25.0
BuildRequires: pkgconfig(libnghttp3) >= 1.18.0
BuildRequires: pkgconfig(libcares) >= 1.34.8
BuildRequires: c-ares(qore-query-lifecycle-fixes) = 1
BuildRequires: pkgconfig(libbrotlienc)
BuildRequires: pkgconfig(libbrotlidec)
BuildRequires: pkgconfig(libzstd)
BuildRequires: pkgconfig(liblz4)
BuildRequires: pkgconfig(krb5)
BuildRequires: pkgconfig(krb5-gssapi)
BuildRequires: pkgconfig(tree-sitter) >= 0.26.13
BuildRequires: pkgconfig(icu-uc)
BuildRequires: pkgconfig(icu-i18n)
BuildRequires: pkgconfig(eigen3) >= 3.4
BuildRequires: pkgconfig(protobuf)
BuildRequires: pkgconfig(yaml-0.1)
BuildRequires: pkgconfig(libutf8proc)
BuildRequires: pkgconfig(arrow)
BuildRequires: pkgconfig(parquet)
# CMake supports both driver APIs; EPEL also transitions to 2.x during EL10.
BuildRequires: (pkgconfig(mongoc2) or pkgconfig(libmongoc-1.0))
BuildRequires: pkgconfig(tesseract)
# Some distributions expose curl and archive directly through tesseract.pc.
BuildRequires: pkgconfig(libcurl)
BuildRequires: pkgconfig(libarchive)
BuildRequires: pkgconfig(lept)
BuildRequires: pkgconfig(liburing) >= 2.0
BuildRequires: llvm-devel >= %{llvm_major}
BuildRequires: llvm-devel < %{expr:%{llvm_major}+1}
# Upstream CI uses 1.22.0; qualify the matched distro headers/library together.
# Debian's >= 1.23.2 is its qualified archive baseline, not a CMake API minimum.
BuildRequires: onnxruntime-devel >= 1.22.2
%if 0%{?suse_version}
BuildRequires: libbz2-devel
BuildRequires: protobuf-devel
%else
BuildRequires: bzip2-devel
BuildRequires: protobuf-compiler
%endif
%if %{with docs}
BuildRequires: doxygen
BuildRequires: graphviz
%if 0%{?suse_version}
BuildRequires: util-linux
%else
BuildRequires: util-linux-core
%endif
%endif
Requires: %{libname}%{?_isa} = %{version}-%{release}
Requires: %{name}-stdlib%{?_isa} = %{version}-%{release}
Recommends: ca-certificates
Suggests: %{name}-debug-tools
Suggests: %{name}-misc-tools

# LLVM AOT DWARF is not supported by every target's dwz. Keep separate debug
# files and normal stripping; only the incompatible DWARF deduplication is off.
%global _find_debuginfo_dwz_opts %{nil}

%description
Qore provides a multithreaded language, an embeddable C++ runtime, a native
compiler, and a standard library for enterprise integration and general use.

%package -n %{libname}
Summary: Qore runtime shared library
Provides: qore-module(abi)%{?_isa} = %{module_api}
Requires: c-ares(qore-query-lifecycle-fixes)%{?_isa} = 1
# iconv loads these converters dynamically; ELF dependency discovery cannot
# detect them. Minimal installations otherwise lose non-Unicode encodings.
%if 0%{?suse_version}
Requires: glibc-gconv-modules-extra%{?_isa}
%else
Requires: glibc-gconv-extra%{?_isa}
%endif
# These libraries retain their SONAME across API additions. ELF dependencies
# alone do not enforce the versions selected by Qore's compile-time headers.
%if 0%{?suse_version}
Requires: libnghttp2-14%{?_isa} >= 1.70.0
Requires: libngtcp2-16%{?_isa} >= 1.25.0
Requires: libngtcp2_crypto_ossl0%{?_isa} >= 1.25.0
Requires: libnghttp3-9%{?_isa} >= 1.18.0
%else
Requires: libnghttp2%{?_isa} >= 1.70.0
Requires: ngtcp2%{?_isa} >= 1.25.0
Requires: ngtcp2-crypto-ossl%{?_isa} >= 1.25.0
Requires: libnghttp3%{?_isa} >= 1.18.0
%endif
%if ! 0%{?suse_version}
Provides: libqore%{soname}%{?_isa} = %{version}-%{release}
Obsoletes: libqore%{soname} < %{version}-%{release}
%endif

%description -n %{libname}
The SONAME library for Qore interpreters, embedded clients and native modules.

%package stdlib
Summary: Qore standard library and bundled native modules
Requires: %{libname}%{?_isa} = %{version}-%{release}
%if 0%{?suse_version}
Requires: libtree-sitter0_26%{?_isa} >= 0.26.13
%elif 0%{?fedora}
Requires: libtree-sitter%{?_isa} >= 0.26.13
%else
Requires: tree-sitter%{?_isa} >= 0.26.13
%endif
Provides: qore-json-module = %{version}-%{release}
Obsoletes: qore-json-module < 1.13
Provides: qore-yaml-module = %{version}-%{release}
Obsoletes: qore-yaml-module < %{version}
Provides: qore-linenoise-module = %{version}-%{release}
Obsoletes: qore-linenoise-module < %{version}

%description stdlib
Native and AOT-compiled standard modules, source fallbacks, resources and
translations. This package includes JSON, YAML and CPU ONNX inference.

%package devel
Summary: Qore headers, native compiler and module development tools
Requires: %{libname}%{?_isa} = %{version}-%{release}
Requires: %{name}%{?_isa} = %{version}-%{release}
Requires: gcc-c++
Requires: pkgconfig(openssl)
Requires: llvm-devel%{?_isa} >= %{llvm_major}
Requires: llvm-devel%{?_isa} < %{expr:%{llvm_major}+1}

%description devel
Public headers, qpp, qcc, qdx, qjar, compiler metadata, linker configuration,
and CMake/pkg-config integration for embedding Qore and developing modules.

%package rpm-macros
Summary: RPM build helpers for Qore modules
BuildArch: noarch
Requires: python3 >= 3.11
Requires: rpm

%description rpm-macros
RPM macros and dependency generators for Qore's native and AOT modules.
These preserve metadata during stripping and derive runtime dependencies
from the installed SDK. They are only needed to build module RPMs.

%package misc-tools
Summary: Qore command-line integration tools
BuildArch: noarch
Requires: %{name} = %{version}-%{release}

%description misc-tools
Command-line tools for REST APIs, databases, data providers, downloads,
formatting, schema generation, translation catalogs and ONNX models.

%package debug-tools
Summary: Qore remote debugger tools
BuildArch: noarch
Requires: %{name} = %{version}-%{release}

%description debug-tools
The remote debugger, debugger server and Visual Studio Code debug adapter.

%if %{with docs}
%package doc
Summary: Qore language and module documentation
BuildArch: noarch

%description doc
Language and standard-library API documentation and example programs.

%package devel-doc
Summary: Qore C++ API documentation
BuildArch: noarch

%description devel-doc
API reference for embedding Qore and writing native modules.
%endif

# Keep this block identical to rpm/macros.qore's implementation. Core Qore
# bootstraps the macro package and cannot BuildRequire itself.
%global qore_rpm_helper rpm/preserve-aot-metadata.py
%global qore_debug_source_dir %{lua:local p = rpm.expand("/usr/src/debug/%{name}-%{version}"); if (tonumber(rpm.expand("%{?_unique_debug_srcs}")) or 0) > 0 then p = p .. rpm.expand("-%{release}.%{_arch}") end; print(p)}
%{lua:
  -- Preserve LLVM's .debug_names without requesting a second GDB index.
  rpm.undefine("_include_gdb_index")
  local original = rpm.expand("%{macrobody:__spec_install_post}")
  local newline = string.char(10)
  local continuation = string.char(92, 10)
  rpm.define("qore_original_install_post " .. original:gsub(newline, continuation))
  local wrapper = [=[
cat > qore-rpm-post.sh <<'QORE_RPM_POST_EOF'
%{qore_original_install_post}
QORE_RPM_POST_EOF
/usr/bin/python3 "%{qore_rpm_helper}" "%{buildroot}" /bin/sh -e qore-rpm-post.sh
]=]
  rpm.define("__spec_install_post " .. wrapper:gsub(newline, continuation))
}

%if 0%{?suse_version}
%post -n %{libname} -p /sbin/ldconfig
%postun -n %{libname} -p /sbin/ldconfig
%endif

%prep
%autosetup -n %{name}-%{version}
# Retain complete license notices without shipping implementation as license data.
python3 rpm/stage-licenses.py . .

%build
%{?set_build_flags}
. rpm/build-env.sh
qore_set_source_prefix_maps "%{qore_debug_source_dir}"
cmake -S . -B build -G 'Unix Makefiles' \
    -DQORE_GENERATE_JAVA_BINDINGS=OFF \
    -DCMAKE_BUILD_TYPE=Release \
    -DQORE_AOT_LINK_FLAGS="-Wl,-z,relro -Wl,-z,now" \
    -DCMAKE_C_FLAGS_RELEASE:STRING=-DNDEBUG \
    -DCMAKE_CXX_FLAGS_RELEASE:STRING=-DNDEBUG \
    -DCMAKE_INSTALL_PREFIX=%{_prefix} \
    -DCMAKE_INSTALL_LIBDIR=%{_lib} \
    -DCMAKE_SKIP_INSTALL_RPATH=ON \
    -DCMAKE_BUILD_RPATH_USE_ORIGIN=ON \
    -DCMAKE_IGNORE_PREFIX_PATH=/usr/local \
    -DFETCHCONTENT_FULLY_DISCONNECTED=ON \
    -DQORE_REQUIRE_SYSTEM_DEPENDENCIES=ON \
    -DQORE_BUILD_WITH_EXTERNAL_MODULES=OFF \
    -DQORE_BUILD_AOT_MODULES=ON \
    -DQORE_AOT_LINK_SOURCE_MODULES=OFF \
    -DQORE_WITH_ONNXRUNTIME=ON \
    -DQORE_REQUIRE_ONNXRUNTIME=ON \
    -DCMAKE_DISABLE_FIND_PACKAGE_CUDAToolkit=ON \
    -DCMAKE_DISABLE_FIND_PACKAGE_Doxygen=%{!?with_docs:ON}%{?with_docs:OFF}
cmake --build build -- %{?_smp_mflags}
# The installed public LLVM plugin headers require the same LLVM major.
grep -qx 'set(QORE_LLVM_MAJOR_VERSION %{llvm_major})' build/cmake/install/QoreConfig.cmake
%if %{with docs}
cmake --build build --target docs -- %{?_smp_mflags}
%endif

%install
DESTDIR=%{buildroot} cmake --install build
python3 rpm/install-aot-sources.py "%{buildroot}" "%{qore_debug_source_dir}" qlib
install -dm755 %{buildroot}%{_libdir}/qore
mv %{buildroot}%{_bindir}/qcc-format.stamp %{buildroot}%{_libdir}/qore/
sed -i 's|%{_bindir}/qcc-format.stamp|%{_libdir}/qore/qcc-format.stamp|' \
    %{buildroot}%{_libdir}/cmake/Qore/QoreConfig.cmake
# RPM's find-debuginfo selects executable ELF files; qmods are shared objects.
find %{buildroot}%{module_dir} -type f -name '*.qmod' -exec chmod 755 {} +
install -Dm644 rpm/macros.qore %{buildroot}%{_rpmconfigdir}/macros.d/macros.qore
install -Dm644 rpm/qore.attr %{buildroot}%{_rpmconfigdir}/fileattrs/qore.attr
install -Dm755 rpm/qore-requires.py %{buildroot}%{_rpmconfigdir}/qore/qore-requires.py
install -Dm755 rpm/preserve-aot-metadata.py %{buildroot}%{_rpmconfigdir}/qore/preserve-aot-metadata.py
install -Dm755 rpm/install-aot-sources.py %{buildroot}%{_rpmconfigdir}/qore/install-aot-sources.py
install -Dm644 rpm/build-env.sh %{buildroot}%{_rpmconfigdir}/qore/build-env.sh
install -Dm644 rpm/module-env.sh %{buildroot}%{_rpmconfigdir}/qore/module-env.sh
%if %{with docs}
# Install before post-processing so duplicate Doxygen assets share storage.
# Relative %%doc entries are copied later and would lose these hardlinks.
install -d %{buildroot}%{_docdir}/%{name}-doc %{buildroot}%{_docdir}/%{name}-devel-doc
cp -a build/docs/lang build/docs/modules %{buildroot}%{_docdir}/%{name}-doc/
python3 rpm/stage-examples.py examples %{buildroot}%{_docdir}/%{name}-doc/examples
cp -a build/docs/library/html %{buildroot}%{_docdir}/%{name}-devel-doc/
hardlink -t -O %{buildroot}%{_docdir}/%{name}-doc
hardlink -t -O %{buildroot}%{_docdir}/%{name}-devel-doc
%endif
python3 rpm/finalize-install.py %{buildroot} %{_libdir}

%check
%if %{with tests}
. rpm/build-env.sh
export LD_LIBRARY_PATH=$PWD/build
export QORE_MODULE_DIR=$PWD/build/qlib-qmod:$PWD/qlib
for module in "$PWD"/build/modules/*; do
    test -d "$module" || continue
    QORE_MODULE_DIR="$QORE_MODULE_DIR:$module"
done
python3 -B -W error -m unittest discover -s rpm/tests -p 'test_aot_metadata.py' -v
python3 -B -W error -m unittest discover -s rpm/tests -p 'test_requires.py' -v
python3 -B -W error -m unittest discover -s rpm/tests -p 'test_install.py' -v
python3 -B -W error -m unittest discover -s rpm/tests -p 'test_examples.py' -v
python3 -B -W error -m unittest discover -s rpm/tests -p 'test_licenses.py' -v
python3 -B -W error -m unittest discover -s rpm/tests -p 'test_build_env.py' -v
python3 -B -W error -m unittest discover -s rpm/tests -p 'test_aot_sources.py' -v
QORE_RPM_VERIFY_INSTALLED_DEPS=1 python3 -B -W error -m unittest discover -s rpm/tests -p 'test_spec_metadata.py' -v
QORE_TEST_QCC=$PWD/build/qcc QORE_TEST_QORE=$PWD/build/qore \
    python3 -B -W error rpm/tests/qcc-rpm-integration.py -v
QORE_QPP_EXECUTABLE=$PWD/build/qpp QORE_QCC_EXECUTABLE=$PWD/build/qcc \
    QORE_BINARY=$PWD/build/qore python3 -B -m unittest discover -s examples/test/cmake
cmake --build build --target linenoise-unicode-test -- %{?_smp_mflags}
build/modules/linenoise/linenoise-unicode-test
QORE_BINARY=$PWD/build/qore QORE_TEST_QMOD_DIR=$PWD/build/qlib-qmod \
    PATH=$PWD/build:$PATH QORE_TEST_OPTS='-penable-debug' ./run_tests.sh -E -v -d qore
build/qore -b --enable-debug -l ml -e 'if (!ML::ml_get_capabilities().has_onnx) { throw "PACKAGE-TEST-ERROR", "ONNX is required"; }'
build/qore -b --enable-debug modules/ml/test/ml.qtest -v
%endif

%files
%license COPYING.MIT
%{_bindir}/qore
%{_bindir}/qdbg
%{_mandir}/man1/qore.1*
%{_mandir}/man1/qdbg.1*

%files -n %{libname}
%license COPYING.LGPL COPYING.GPL COPYING.MIT README-LICENSE debian/copyright
%{_libdir}/libqore.so.%{soname}*

%files stdlib
%license COPYING.MIT COPYING.LGPL debian/copyright
%license modules/json/third-party/jsoncons/LICENSE linenoise.LICENSE wcwidth.LICENSE
%dir %{_datadir}/qore
%dir %{_datadir}/qore/metadata
%{module_dir}/
%{_datadir}/qore-modules/
%{_datadir}/qore/i18n/

%files devel -f rpm-devel-extra.files
%{_bindir}/qpp
%{_bindir}/qcc
%{_bindir}/qdx
%{_bindir}/qjar
%{_bindir}/qore-extract-qm-metadata
%{_mandir}/man1/qpp.1*
%{_mandir}/man1/qcc.1*
%{_mandir}/man1/qdx.1*
%{_mandir}/man1/qjar.1*
%{_mandir}/man1/qore-extract-qm-metadata.1*
%{_libdir}/libqore.so
%{_libdir}/pkgconfig/qore.pc
%{_libdir}/cmake/Qore/
%{_libdir}/qore/
%{_includedir}/qore/
%{_datadir}/qore/metadata/
%{_datadir}/qore/treesitter/
%if %{with docs}
%{_datadir}/qore/qore.tag
%{_datadir}/qore/module-tags/
%endif

%files rpm-macros
%license COPYING.MIT
%{_rpmconfigdir}/macros.d/macros.qore
%{_rpmconfigdir}/fileattrs/qore.attr
%{_rpmconfigdir}/qore/

%files misc-tools -f rpm-tools.files

%files debug-tools
%{_bindir}/qdbg-server
%{_bindir}/qdbg-remote
%{_bindir}/qdbg-vsc-adapter
%{_mandir}/man1/qdbg-server.1*
%{_mandir}/man1/qdbg-remote.1*
%{_mandir}/man1/qdbg-vsc-adapter.1*

%if %{with docs}
%files doc
%license COPYING.MIT
%doc %{_docdir}/%{name}-doc/

%files devel-doc
%license COPYING.LGPL COPYING.GPL COPYING.MIT
%doc %{_docdir}/%{name}-devel-doc/
%endif

%changelog
* Fri Oct 02 2026 David Nichols <david@qore.org> - 3.0.0-16
- Capture fresh timeout cores from OBS kernel paths and include debugger support.
- Print test-case progress for native build failure diagnosis.

* Fri Oct 02 2026 David Nichols <david@qore.org> - 3.0.0-15
- Qualify complete HTTP charset coverage and the corrected HTTPClient assertion.
- Include committed closure lifetime, closed HTTP connection and AOT test fixes.

* Thu Oct 01 2026 David Nichols <david@qore.org> - 3.0.0-14
- Build packaged HTML documentation without optional Java/JNI artifacts.
- Include corrected enum documentation and canonical HTTP response charsets.
- Include synchronized ONNX async completion statistics in the portable CPU build.

* Thu Oct 01 2026 David Nichols <david@qore.org> - 3.0.0-13
- Accept either supported MongoDB C driver API across distribution updates.

* Thu Oct 01 2026 David Nichols <david@qore.org> - 3.0.0-12
- Validate embedded license grants, including the permissive wcwidth notice.

* Thu Oct 01 2026 David Nichols <david@qore.org> - 3.0.0-11
- Ship runnable user examples without development test fixtures or Git metadata.
- Package complete third-party license notices and sourced shell helpers correctly.
- Avoid self-obsoleting snapshot module compatibility capabilities.

* Thu Oct 01 2026 David Nichols <david@qore.org> - 3.0.0-10
- Require corrected Fedora file post-processors while retaining all BRP checks.

* Thu Oct 01 2026 David Nichols <david@qore.org> - 3.0.0-9
- Ship bundled module documentation indexes in the SDK.

* Thu Oct 01 2026 David Nichols <david@qore.org> - 3.0.0-8
- Include the SDK documentation fix for pure Qore module packages.

* Thu Oct 01 2026 David Nichols <david@qore.org> - 3.0.0-7
- Require Fedora's native libtree-sitter package and verify the runtime provider.

* Thu Oct 01 2026 David Nichols <david@qore.org> - 3.0.0-6
- Unify Fedora, Enterprise Linux and SUSE packaging.
- Preserve AOT metadata, retain debug symbols, and isolate offline builds.
- Align runtime, SDK, tools and module dependencies with installed artifacts.
