# ============================================================================
# CUDA driver / runtime — cuInit/cudaMalloc allocate process-lifetime context
# state that the NVIDIA driver does not free at exit. These are not Qore leaks;
# GPU memory is validated with compute-sanitizer, not valgrind.
# ============================================================================

{
   cuda_driver_init_leak
   Memcheck:Leak
   match-leak-kinds: definite,indirect,possible
   ...
   obj:*libcuda.so*
}

{
   cuda_runtime_init_leak
   Memcheck:Leak
   match-leak-kinds: definite,indirect,possible
   ...
   obj:*libcudart.so*
}

# ============================================================================
# Cyrus SASL GS2 client plugin (mongodb module) -- qore#7137
# ============================================================================
# mongoc_init() (from mongodb_module_init()) runs sasl_client_init() once per
# process, which loads the SASL plugins.  The GS2 plugin's gs2_client_plug_init()
# allocates its table of client plugins (plugins/gs2.c, gs2_common_plug_init())
# into a static, once, and its mech_free never frees it in Cyrus SASL 2.1.28;
# upstream fixed this in cyrus-sasl PR #968 ("fix-init-leaks", 2026-11-17).  The
# plugin is unloaded before the leak report, so its two frames have no object
# name.  One block (192 bytes direct, 20 indirect with its mechanism names) per
# process; remove this entry when the distributions ship the fix.

{
   cyrus_sasl_gs2_client_plugin_table_leak
   Memcheck:Leak
   match-leak-kinds: definite
   fun:malloc
   obj:*
   obj:*
   fun:sasl_client_add_plugin
   obj:*libsasl2.so*
   fun:sasl_client_init
   obj:*libmongoc*
}

# ============================================================================
# PCRE2 JIT-generated code: not suppressed; run with QORE_PCRE2_NO_JIT=1
# ============================================================================
# Regular expressions are compiled with the PCRE2 just-in-time compiler (see
# QoreRegexBase::jitCompile()).  The JIT emits machine code into anonymous
# executable memory, which valgrind can neither symbolize nor unwind through,
# and its scanning loops test whole words, which memcheck reports as reading
# uninitialised values (false positives; upstream's --enable-valgrind build
# option annotates the JIT, and distribution packages are not built with it).
#
# These frames can only be matched as 'obj:*', and an entry whose first frame
# is 'obj:*' matches every error: the entries that were here suppressed every
# uninitialised-value report of a run, also a deliberate read of uninitialised
# heap memory in a plain C++ program (qore#7296).  So there is no entry for
# them: run valgrind with QORE_PCRE2_NO_JIT=1 (see README.md and AGENTS.md),
# which makes Qore use PCRE2's interpreter.  The JIT is what keeps matching
# linear on subjects over 5,000,000 bytes (PCRE2's interpreter disables its
# required-code-unit start-of-match optimization past that size), so a test
# that matches such subjects runs much longer under valgrind without it.
#
# ============================================================================
# libLLVM: speculative reads of values that do not decide the outcome (qore#7296)
# ============================================================================
# Use: valgrind --suppressions=qore.supp ... (with QORE_PCRE2_NO_JIT=1, above)
#
# The distribution's libLLVM (seen with Ubuntu's LLVM 21.1 on aarch64,
# valgrind 3.22.0) is compiled with optimizations that read a value before the
# condition that guards it is known and select or mask the result afterwards:
# a conditional select whose condition depends on an uninitialised value, but
# whose arms are equal when it is (both 0), or a compare masked by a defined
# flag.  memcheck cannot see that the result is defined and reports the
# conditional branch on it.  The C++ source is correct in each case, and none
# of the values comes from Qore:
# - PassBuilder::buildModuleSimplificationPipeline() reads a field of the
#   payload of its std::optional<PGOOptions> member, which is empty (Qore's
#   optimizeModule() and LLVM's own tools pass std::nullopt), and selects the
#   engaged flag or 0 on it; reproduced by a C++ program that only builds the
#   default O2 pipeline with LLVM (no Qore code), and gone when the PassBuilder
#   is constructed in zeroed memory, or when only the payload of that member is
#   left undefined it comes back
# - AsmPrinter::emitPatchableFunctionEntries() compares the output of
#   StringRef::getAsInteger(), which getAsInteger() does not write for an
#   absent attribute ("patchable-function-prefix"/"-entry"), and masks the
#   result with its error flag (origin: a stack slot of the function itself)
# - InstCombinerImpl::SimplifySelectsFeedingBinaryOp() evaluates
#   "LHSIsSelect && RHSIsSelect && A == D" with A == D first, where D is not
#   written when the right operand is not a select: the select on it has two
#   arms that are both 0 then (RHSIsSelect is false), as in the first case
# The PassBuilder and AsmPrinter entries match their function and its caller
# as top frames.  The InstCombine function has no exported symbol in the
# distribution's libLLVM, so its entry matches the five unnamed libLLVM frames
# under InstCombinePass::run() that the report has with that build: it covers
# any uninitialised-value report at that depth under InstCombine (also one in
# another visitor), and another LLVM build, version or architecture inlines
# differently and does not match it; with LLVM's debug symbols installed, the
# frames are named and the entry that names the function matches instead.  A
# report in libLLVM that these entries do not match is not suppressed; if one
# appears, analyze it the same way (--track-origins=yes, --sym-offsets=yes)
# before adding an entry.
# ============================================================================

{
   llvm_PassBuilder_buildModuleSimplificationPipeline_optional_payload
   Memcheck:Cond
   fun:_ZN4llvm11PassBuilder33buildModuleSimplificationPipelineENS_17OptimizationLevelENS_18ThinOrFullLTOPhaseE
   fun:_ZN4llvm11PassBuilder29buildPerModuleDefaultPipelineENS_17OptimizationLevelENS_18ThinOrFullLTOPhaseE
}

{
   llvm_AsmPrinter_emitPatchableFunctionEntries_getAsInteger
   Memcheck:Cond
   fun:_ZN4llvm10AsmPrinter28emitPatchableFunctionEntriesEv
   fun:_ZN4llvm10AsmPrinter16emitFunctionBodyEv
}

{
   llvm_InstCombine_visitor_select
   Memcheck:Cond
   obj:*/libLLVM*.so*
   obj:*/libLLVM*.so*
   obj:*/libLLVM*.so*
   obj:*/libLLVM*.so*
   obj:*/libLLVM*.so*
   fun:_ZN4llvm15InstCombinePass3runERNS_8FunctionERNS_15AnalysisManagerIS1_JEEE
}

{
   llvm_InstCombine_SimplifySelectsFeedingBinaryOp_debug_symbols
   Memcheck:Cond
   fun:*InstCombinerImpl*SimplifySelectsFeedingBinaryOp*
}
