# Valgrind suppression file for Qore
# These are false positives caused by -O3 optimization of NaN-boxed QoreValue bit operations.
# All QoreValue methods use uint64_t bit patterns to encode types, pointers, ints, and doubles
# in a single 8-byte value. Under -O3, the compiler's bitfield handling confuses valgrind into
# reporting uninitialised value errors. These do not appear in debug builds (-O0/-Og).

# Copyright (C) 2003 - 2026 Qore Technologies, s.r.o.

# ============================================================================
# QoreValue::set(AbstractQoreNode*) — all contexts
# ============================================================================
# This is the primary source of false positives. The NaN-boxing tag check in set()
# reads bits that valgrind thinks are uninitialised due to optimizer reordering.

{
   QoreValue_set_AbstractQoreNode_all
   Memcheck:Cond
   fun:*QoreValue*set*AbstractQoreNode*
   ...
}

{
   QoreValue_set_AbstractQoreNode_value
   Memcheck:Value8
   fun:*QoreValue*set*AbstractQoreNode*
   ...
}

# ============================================================================
# QoreValue::getType() — all contexts
# ============================================================================
# getType() decodes the NaN-boxed tag bits; same false positive mechanism.

{
   QoreValue_getType_all
   Memcheck:Cond
   fun:*QoreValue*getType*
   ...
}

{
   QoreValue_getType_value
   Memcheck:Value8
   fun:*QoreValue*getType*
   ...
}

