#
# Writes the header that gives libqore its builtin API identity (qore#7183).
#
# The identity is the SHA-256 digest of the API metadata of libqore's qpp
# files: what qpp writes with --api-metadata, the metadata of the builtin
# classes, functions, constants, hashdecls and enums of a file (names, parents,
# functional domains, code flags, signatures, access, ...) without their
# documentation and without the path of the source file.  An AOT module can
# build such metadata into its code (the functional domains a class inherits
# from a builtin base class, the domains the module's code uses, calls to
# builtin functions that its compiler folded because they are pure, ...), so
# qcc records the identity in every AOT module it compiles, and the module
# loader takes a module recorded with another identity for out of date: it
# loads the module's source instead, or refuses the module; see "AOT Module
# Builtin API Identity" in design/aot-object-files-and-module-artifacts.md.
#
# A change to the documentation or to the code of a builtin method or function
# does not change the identity, nor does a change to any other source of
# libqore: only a change to the API metadata rebuilds the qmods of a build tree
# (they depend on the header, see qore_add_qmod_target() in QoreMacros.cmake).
#
# The files are taken in the order of their names, so the identity does not
# depend on the build directory or on the order of the list.  The header is
# only rewritten when the identity changes, so the one translation unit that
# includes it is only recompiled then.
#
# Inputs:
#   INPUT_LIST - a file listing the API metadata files, one path per line
#   OUTPUT     - the header to write

cmake_policy(SET CMP0007 NEW)

if (NOT DEFINED INPUT_LIST OR "${INPUT_LIST}" STREQUAL "")
    message(FATAL_ERROR "INPUT_LIST is required")
endif ()
if (NOT DEFINED OUTPUT OR "${OUTPUT}" STREQUAL "")
    message(FATAL_ERROR "OUTPUT is required")
endif ()
if (NOT EXISTS "${INPUT_LIST}")
    message(FATAL_ERROR "API metadata file list '${INPUT_LIST}' does not exist")
endif ()

file(STRINGS "${INPUT_LIST}" _files ENCODING UTF-8)
set(_entries)
foreach (_file IN LISTS _files)
    if ("${_file}" STREQUAL "")
        continue()
    endif ()
    if (NOT EXISTS "${_file}")
        message(FATAL_ERROR "API metadata file '${_file}' does not exist")
    endif ()
    get_filename_component(_name "${_file}" NAME)
    file(SHA256 "${_file}" _digest)
    list(APPEND _entries "${_name}\t${_digest}")
endforeach ()
if (NOT _entries)
    message(FATAL_ERROR "API metadata file list '${INPUT_LIST}' names no file")
endif ()
list(SORT _entries)

set(_identity_input "qore-builtin-api-identity-v1\n")
foreach (_entry IN LISTS _entries)
    string(APPEND _identity_input "${_entry}\n")
endforeach ()
string(SHA256 _identity "${_identity_input}")

set(_content "/* generated by cmake/QoreWriteBuiltinApiIdentity.cmake from ${INPUT_LIST}; do not edit */
#ifndef _QORE_INTERN_QORE_BUILTIN_API_IDENTITY_H
#define _QORE_INTERN_QORE_BUILTIN_API_IDENTITY_H
#define QORE_BUILTIN_API_IDENTITY \"${_identity}\"
#endif
")

get_filename_component(_output_dir "${OUTPUT}" DIRECTORY)
if (_output_dir)
    file(MAKE_DIRECTORY "${_output_dir}")
endif ()
set(_current)
if (EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" _current)
endif ()
if (NOT "${_current}" STREQUAL "${_content}")
    file(WRITE "${OUTPUT}" "${_content}")
endif ()
