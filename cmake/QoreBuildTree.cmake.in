# Generated only in the build tree; never installed with the SDK.

set(_qore_build_source_dir "@CMAKE_SOURCE_DIR@")
set(_qore_build_binary_dir "@CMAKE_BINARY_DIR@")
set(_qore_build_cmake_dir "@CMAKE_BINARY_DIR@/cmake")
# Resolve both sides to real paths before comparing: symlinked build/checkout paths
# (common on macOS, e.g. /tmp vs /private/tmp, /var vs /private/var) otherwise make this
# exact STREQUAL fail, falling through to the installed branch which includes a
# QoreMacros.cmake that does not exist next to a build-tree config -> the exported
# qore_* commands become undefined for build-tree consumers.
get_filename_component(_qore_this_cmake_dir_real "${CMAKE_CURRENT_LIST_DIR}" REALPATH)
get_filename_component(_qore_build_cmake_dir_real "${_qore_build_cmake_dir}" REALPATH)
if (_qore_this_cmake_dir_real STREQUAL _qore_build_cmake_dir_real)
    set(_qore_in_build_tree TRUE)
else()
    set(_qore_in_build_tree FALSE)
endif()
# Build-tree mode: point consumers at build outputs for local debugging without install.
# Limitations: assumes single-config generators and default output dirs; multi-config/custom
# output layouts may need explicit Qore_DIR or manual overrides.
if (_qore_in_build_tree)
    set(QORE_CMAKE_DIR "@CMAKE_SOURCE_DIR@/cmake")
    set(QORE_QCC_INCREMENTAL_HELPER "@CMAKE_SOURCE_DIR@/tools/qore-qo-incremental")
    set(QORE_QCC_SOURCE_ORDER_HELPER "@CMAKE_SOURCE_DIR@/tools/qore-qo-source-order")
    set(QORE_QCC_BATCH_BOOTSTRAP_HELPER "@CMAKE_SOURCE_DIR@/tools/qore-qo-batch-bootstrap")
    set(QORE_QCC_INCREMENTAL_PLAN_HELPER "@CMAKE_SOURCE_DIR@/tools/qore-qo-incremental-plan")
    set(QORE_QCC_PRUNE_HELPER "@CMAKE_SOURCE_DIR@/tools/qore-qo-prune")
    set(QORE_INCLUDE_DIR "@CMAKE_SOURCE_DIR@/include")
    set(QORE_INCLUDE_DIRS "${QORE_INCLUDE_DIR};@CMAKE_BINARY_DIR@/include")
    set(QORE_LIBRARY "@CMAKE_BINARY_DIR@/@CMAKE_SHARED_LIBRARY_PREFIX@qore@CMAKE_SHARED_LIBRARY_SUFFIX@")
    set(QORE_LIBRARIES ${QORE_LIBRARY})
    set(QORE_BUILDTREE_BINARY_MODULE_PATH
        "@CMAKE_BINARY_DIR@/modules/astparser:@CMAKE_BINARY_DIR@/modules/reflection:@CMAKE_BINARY_DIR@/modules/logger_bin:@CMAKE_BINARY_DIR@/modules/linenoise:@CMAKE_BINARY_DIR@/modules/i18n:@CMAKE_BINARY_DIR@/modules/krb5:@CMAKE_BINARY_DIR@/modules/mongodb:@CMAKE_BINARY_DIR@/modules/ml:@CMAKE_BINARY_DIR@/modules/tokenizer:@CMAKE_BINARY_DIR@/modules/ocr:@CMAKE_BINARY_DIR@/modules/dataframe:@CMAKE_BINARY_DIR@/modules/sshutil:@CMAKE_BINARY_DIR@/modules/protobuf:@CMAKE_BINARY_DIR@/modules/json:@CMAKE_BINARY_DIR@/modules/yaml")
    set(QORE_BUILDTREE_USER_MODULE_PATH
        "@CMAKE_BINARY_DIR@/qlib-qmod:@CMAKE_SOURCE_DIR@/qlib:${QORE_BUILDTREE_BINARY_MODULE_PATH}")
endif()
