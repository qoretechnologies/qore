# QORE_FOUND - system has qore installed
# QORE_INCLUDE_DIR - includes
# QORE_INCLUDE_DIRS - cmake standard alias for QORE_INCLUDE_DIR
# QORE_LIBRARY - library location
# QORE_LIBRARIES - cmake standard alias for QORE_LIBRARY
#
# QORE_MODULES_DIR - location of qore modules
# QORE_API_VERSION - API version
#
# QORE_EXECUTABLE - qore interpret executable
# QORE_QPP_EXECUTABLE - qore qpp executable
# QORE_QCC_EXECUTABLE - qore AOT compiler (qcc) executable
# QORE_QCC_FORMAT_STAMP - dependency file updated when qcc AOT output can change
# QORE_AOT_MODULES_DIR - install location for AOT-compiled user module .qmod artifacts


if (CMAKE_VERSION VERSION_LESS 2.8.3)
    message(FATAL_ERROR "Qore requires at least CMake version 2.8.3")
endif()

set(QORE_FOUND 1)

set(_qore_build_cmake_dir "@CMAKE_BINARY_DIR@/cmake")
# Build-tree mode: point consumers at build outputs for local debugging without install.
# Limitations: assumes single-config generators and default output dirs; multi-config/custom
# output layouts may need explicit Qore_DIR or manual overrides.
if (CMAKE_CURRENT_LIST_DIR STREQUAL _qore_build_cmake_dir)
    set(QORE_INCLUDE_DIR "@CMAKE_SOURCE_DIR@/include")
    set(QORE_INCLUDE_DIRS "${QORE_INCLUDE_DIR};@CMAKE_BINARY_DIR@/include")
    set(QORE_LIBRARY "@CMAKE_BINARY_DIR@/@CMAKE_SHARED_LIBRARY_PREFIX@qore@CMAKE_SHARED_LIBRARY_SUFFIX@")
    set(QORE_LIBRARIES ${QORE_LIBRARY})
    set(QORE_BUILDTREE_USER_MODULE_PATH "@CMAKE_BINARY_DIR@/qlib-qmod:@CMAKE_SOURCE_DIR@/qlib")
else()
    set(QORE_INCLUDE_DIR @CMAKE_INSTALL_FULL_INCLUDEDIR@)
    set(QORE_INCLUDE_DIRS ${QORE_INCLUDE_DIR})
    find_library(QORE_LIBRARY NAMES qore libqore HINTS "@CMAKE_INSTALL_FULL_LIBDIR@/")
    set(QORE_LIBRARIES ${QORE_LIBRARY})
    set(QORE_BUILDTREE_USER_MODULE_PATH "")
endif()

# allow the module directory to be overridden (for example, when cross-compiling)
if(DEFINED QORE_MODULE_DIR)
    set(QORE_MODULES_DIR ${QORE_MODULE_DIR})
else()
    set(QORE_MODULES_DIR @MODULE_DIR@)
endif()
# allow the module directory to be overridden (for example, when cross-compiling)
if(DEFINED QORE_USER_MODULE_DIR)
    set(QORE_USER_MODULES_DIR ${QORE_USER_MODULE_DIR})
else()
    set(QORE_USER_MODULES_DIR @USER_MODULE_DIR@)
endif()
# allow the module directory to be overridden (for example, when cross-compiling)
if(DEFINED QORE_USER_MODULE_VER_DIR)
    set(QORE_USER_MODULES_VER_DIR ${QORE_USER_MODULE_VER_DIR})
else()
    set(QORE_USER_MODULES_VER_DIR @USER_MODULE_VER_DIR@)
endif()
# allow the AOT user-module directory to be overridden
if(DEFINED QORE_AOT_MODULE_DIR)
    set(QORE_AOT_MODULES_DIR ${QORE_AOT_MODULE_DIR})
elseif(NOT DEFINED QORE_AOT_MODULES_DIR)
    set(QORE_AOT_MODULES_DIR ${QORE_MODULES_DIR})
endif()

set(QORE_API_VERSION @MODULE_API_MAJOR@.@MODULE_API_MINOR@)
set(QORE_HAVE_GENERIC_CLASSES 1)
set(QORE_HAVE_COLUMNAR_RESULT_V2 1)
set(QORE_HAVE_EXTERNAL_BUFFER_STORAGE 1)
set(QORE_HAVE_ARROW_DATAFRAME_INTEROP 1)
set(QORE_HAVE_DECIMAL128_BUFFER 1)
set(QORE_LLVM_PACKAGE_VERSION "@LLVM_PACKAGE_VERSION@")
set(QORE_LLVM_MAJOR_VERSION @QORE_LLVM_MAJOR_VERSION@)
set(QORE_LLVM_INCLUDE_DIRS "@LLVM_INCLUDE_DIRS@")
set(QORE_USERMODULE_DOXYGEN_TEMPLATE @CMAKE_INSTALL_FULL_DATADIR@/qore/Doxyfile.in)

option(QORE_BUILD_AOT_MODULES
       "Build AOT-compiled .qmod artifacts for user modules via qcc"
       ON)
option(QORE_AOT_LINK_SOURCE_MODULES
       "Link generated .qmod artifacts into source qlib directories for qmod-first in-tree tests"
       OFF)

# metadata directory for .meta.json files (API documentation metadata)
if(DEFINED QORE_METADATA_DIR_OVERRIDE)
    set(QORE_METADATA_DIR ${QORE_METADATA_DIR_OVERRIDE})
else()
    set(QORE_METADATA_DIR @CMAKE_INSTALL_FULL_DATADIR@/qore/metadata)
endif()

# allow the qore executable to be overridden (for example, when cross-compiling)
if (CMAKE_CURRENT_LIST_DIR STREQUAL _qore_build_cmake_dir)
    if(NOT DEFINED QORE_EXECUTABLE)
        set(QORE_EXECUTABLE "@CMAKE_BINARY_DIR@/qore${CMAKE_EXECUTABLE_SUFFIX}")
    endif()
    if(DEFINED QPP_EXECUTABLE)
        set(QORE_QPP_EXECUTABLE ${QPP_EXECUTABLE})
    else()
        set(QORE_QPP_EXECUTABLE "@CMAKE_BINARY_DIR@/qpp${CMAKE_EXECUTABLE_SUFFIX}")
    endif()
    if(NOT DEFINED QORE_QCC_EXECUTABLE)
        set(QORE_QCC_EXECUTABLE "@CMAKE_BINARY_DIR@/qcc${CMAKE_EXECUTABLE_SUFFIX}")
    endif()
    set(QORE_QCC_FORMAT_STAMP "@CMAKE_BINARY_DIR@/qcc-format.stamp")
    set(QORE_QDX_EXECUTABLE "@CMAKE_SOURCE_DIR@/doxygen/qdx")
    set(QORE_QM_METADATA_EXECUTABLE "@CMAKE_SOURCE_DIR@/bin/qore-extract-qm-metadata")
    if(DEFINED QJAR_EXECUTABLE)
        set(QORE_QJAR_EXECUTABLE ${QJAR_EXECUTABLE})
    else()
        set(QORE_QJAR_EXECUTABLE "@CMAKE_SOURCE_DIR@/doxygen/qjar")
    endif()
else()
    if(NOT DEFINED QORE_EXECUTABLE)
        set(QORE_EXECUTABLE @CMAKE_INSTALL_FULL_BINDIR@/qore${CMAKE_EXECUTABLE_SUFFIX})
    endif()
    # allow the qpp executable to be overridden (for example, when cross-compiling)
    if(DEFINED QPP_EXECUTABLE)
        set(QORE_QPP_EXECUTABLE ${QPP_EXECUTABLE})
    else()
        set(QORE_QPP_EXECUTABLE @CMAKE_INSTALL_FULL_BINDIR@/qpp${CMAKE_EXECUTABLE_SUFFIX})
    endif()
    # allow the qcc executable to be overridden (for example, when cross-compiling)
    if(NOT DEFINED QORE_QCC_EXECUTABLE)
        set(QORE_QCC_EXECUTABLE @CMAKE_INSTALL_FULL_BINDIR@/qcc${CMAKE_EXECUTABLE_SUFFIX})
    endif()
    set(QORE_QCC_FORMAT_STAMP "")
    set(QORE_QDX_EXECUTABLE @CMAKE_INSTALL_FULL_BINDIR@/qdx)
    set(QORE_QM_METADATA_EXECUTABLE @CMAKE_INSTALL_FULL_BINDIR@/qore-extract-qm-metadata)
    # allow the qjar executable to be overridden
    if(DEFINED QJAR_EXECUTABLE)
        set(QORE_QJAR_EXECUTABLE ${QJAR_EXECUTABLE})
    else()
        set(QORE_QJAR_EXECUTABLE @CMAKE_INSTALL_FULL_BINDIR@/qjar)
    endif()
endif()

# verify that qore-extract-qm-metadata can actually run end-to-end; it depends
# on QoreApiMetadata::toJson(), which in turn requires the json binary module.
# A simple "load json" probe is not sufficient: if the QoreApiMetadata .qmod
# was AOT-compiled when json was unavailable, %try-module json baked in NoJson
# and toJson() will throw at runtime even after json is installed later.
# Exercise the toJson() entry point directly so we catch both situations and
# disable metadata extraction (rather than failing downstream builds).
if(DEFINED QORE_QM_METADATA_EXECUTABLE AND DEFINED QORE_EXECUTABLE)
    execute_process(
        COMMAND ${QORE_EXECUTABLE} [==[--exec=%modern
%requires QoreApiMetadata
QoreApiMetadata::toJson(<QoreApiMetadata::NamespaceInfo>{"name":"x","full_name":"x"});
]==]
        RESULT_VARIABLE _qore_qm_metadata_probe_result
        OUTPUT_QUIET ERROR_QUIET
    )
    if(NOT _qore_qm_metadata_probe_result EQUAL 0)
        message(STATUS "qore-extract-qm-metadata cannot run (QoreApiMetadata::toJson() failed; json module unavailable or QoreApiMetadata was built without json support); QM metadata extraction disabled")
        unset(QORE_QM_METADATA_EXECUTABLE)
    endif()
    unset(_qore_qm_metadata_probe_result)
endif()

# warning: the same prefix for current qore is used if there is no
# CMAKE_INSTALL_PREFIX given
if (CMAKE_INSTALL_PREFIX_INITIALIZED_TO_DEFAULT)
    set(CMAKE_INSTALL_PREFIX @myprefix@)
    message(STATUS "Using detected CMAKE_INSTALL_PREFIX: @myprefix@")
endif (CMAKE_INSTALL_PREFIX_INITIALIZED_TO_DEFAULT)


if (NOT CMAKE_BUILD_TYPE)
    set(CMAKE_BUILD_TYPE "release")
endif (NOT CMAKE_BUILD_TYPE)
string(TOLOWER ${CMAKE_BUILD_TYPE} QORE_BUILD_TYPE_LWR)
if (${QORE_BUILD_TYPE_LWR} MATCHES "debug")
    add_definitions(-DDEBUG)
else ()
    add_definitions(-DNDEBUG)
endif ()


if (CMAKE_CURRENT_LIST_DIR STREQUAL _qore_build_cmake_dir)
    include("@CMAKE_SOURCE_DIR@/cmake/QoreMacros.cmake")
else()
    include("${CMAKE_CURRENT_LIST_DIR}/QoreMacros.cmake")
endif()
