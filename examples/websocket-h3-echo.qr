# --- Echo WebSocket connection ------------------------------------------------

class EchoWsConnection inherits WebSocketConnection {
    constructor(WebSocketHandler handler) : WebSocketConnection(handler) {
    }

    gotMessage(string msg) {
        send(msg);
    }

    gotMessage(binary msg) {
        send(msg);
    }
}

# --- Echo WebSocket handler ---------------------------------------------------

class EchoWsHandler inherits WebSocketHandler {
    WebSocketConnection getConnectionImpl(hash<auto> cx, hash<auto> hdr, string cid) {
        return new EchoWsConnection(self);
    }

    logError(string fmt) {
        vprintf("ERROR " + fmt + "\n", argv);
    }

    logInfo(string fmt) {
        vprintf("INFO " + fmt + "\n", argv);
    }

    logDebug(string fmt) {
        # uncomment for verbose debugging
        #vprintf("DEBUG " + fmt + "\n", argv);
    }

    logWarn(string fmt) {
        vprintf("WARN " + fmt + "\n", argv);
    }
}

# --- Main program -------------------------------------------------------------

sub main() {
    # Create HTTP server with WebSocket echo handler
    EchoWsHandler ws_handler();
    HttpServer server(<HttpServerOptionInfo>{
        "debug": True,
    });

    server.setHandler("ws-handler", "", NOTHING, ws_handler);
    server.setDefaultHandler("ws-handler", ws_handler);
    server.waitForAsyncIo();

    # Add a QUIC (HTTP/3) listener with TLS certificate
    hash<auto> h3info = server.addListener(<HttpListenerOptionInfo>{
        "service": 0,            # let the OS pick a port
        "cert": new SSLCertificate(CertPem),
        "key": new SSLPrivateKey(KeyPem),
        "enable_h3": True,
    });
    server.waitForAsyncIo();
    int port = h3info.port;
    printf("HTTP/3 WebSocket echo server listening on port %d\n\n", port);

    # --- Client side ---

    # Set up message tracking
    list<string> received_messages = ();
    Mutex msg_lock();
    Counter msg_counter(3);  # expecting 3 echo messages
    bool counter_done = False;

    code callback = sub (*data msg) {
        if (!exists msg) {
            return;
        }
        {
            msg_lock.lock();
            on_exit msg_lock.unlock();
            received_messages += msg.typeCode() == NT_BINARY
                ? sprintf("binary(%d bytes)", msg.size())
                : string(msg);
            if (!counter_done) {
                msg_counter.dec();
                if (msg_counter.getCount() == 0) {
                    counter_done = True;
                }
            }
        }
    };

    # Connect using HTTP/3 (http3_mode: "required" forces HTTP/3 via QUIC)
    WebSocketClient ws(callback, {
        "url": "wss://localhost:" + port,
        "http3_mode": "required",
        "ssl_verify_cert": False,
    });

    printf("Connecting WebSocket client over HTTP/3...\n");
    ws.connect();

    # Check which protocol is in use
    *hash<auto> info = ws.getConnectionInfo();
    if (info.http3) {
        printf("Connected via HTTP/3 WebSocket (RFC 9220)\n\n");
    } else if (info.http2) {
        printf("Connected via HTTP/2 WebSocket (RFC 8441)\n\n");
    } else {
        printf("Connected via HTTP/1.1 WebSocket (RFC 6455)\n\n");
    }

    # Send text message
    printf("Sending: Hello HTTP/3 WebSocket!\n");
    ws.send("Hello HTTP/3 WebSocket!");

    # Send another text message
    printf("Sending: QUIC is fast\n");
    ws.send("QUIC is fast");

    # Send binary message (4 bytes)
    binary bin_data = <DEADBEEF>;
    printf("Sending: binary(%d bytes)\n", bin_data.size());
    ws.send(bin_data);

    # Wait for all echoes (with timeout)
    int rc = msg_counter.waitForZero(10s);
    if (rc) {
        printf("\nWARNING: timed out waiting for echo messages\n");
    }

    # Print received messages
    printf("\nReceived %d echo messages:\n", received_messages.size());
    int i = 1;
    foreach string m in (received_messages) {
        printf("  %d. %s\n", i++, m);
    }

    # Disconnect and shut down
    ws.disconnect();
    printf("\nWebSocket disconnected.\n");

    server.stop();
    delete server;
    printf("Server stopped.\n");
}

main();
