#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires FsUtil

%exec-class QppSourceStructureTest

#! qpp reports source it cannot process instead of dropping or copying it, takes -v levels, and locates constants
/** - issue #219: a function or a constant with a doc comment outside a group was dropped with its documentation, and
      the build went on without it; it is now an error, and other code after a doc comment is kept
    - issue #1686: a method of a class of the file without a doc comment was copied into the C++ code as it was; it is
      now an error when its signature is not C++ (a pseudo-class, attributes, an or-nothing return type or a type that
      only %Qore has), as a C++ signature is the method of a C++ class (the class of the private data, which often has
      the name of the class); "-v" took the next argument as its level, and "-vv" set the level to 0
    - issue #2290: the bindings of a group's constants had no source location of their own, so the compiler's errors
      for a constant's value named the wrong line
*/
class QppSourceStructureTest inherits QUnit::Test {
    private {
        string qpp_bin;

        const ConstGroupStart = "/** @defgroup test_constants Test Constants
    Test constants
*/
///@{
";

        const FuncGroupStart = "/** @defgroup test_functions Test Functions
    Test functions
*/
///@{
";

        const GroupEnd = "///@}
";

        const ClassStart = "//! test class
/** a test class
*/
qclass TestCls [arg=void* p; ns=Qore];
";

        const Function = "//! a test function
/**
 */
int t_func(int a) {
    return a + 1;
}
";

        #! a valid source that logs at every level
        const Valid = ConstGroupStart + "//! a constant
const ConstOne = 1;
" + GroupEnd;
    }

    constructor() : QUnit::Test("QppSourceStructureTest", "1.0", \ARGV) {
        string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        string bin_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qpp_bin = ENV.QPP ?? ENV.QORE_QPP
            ?? (is_file(bin_dir + "/qpp") ? bin_dir + "/qpp" : dirname(qore_bin) + "/qpp");

        addTestCase("function outside a group fails", \testFunctionOutsideGroup());
        addTestCase("constant outside a group fails", \testConstantOutsideGroup());
        addTestCase("C++ helper after a doc comment fails", \testCppHelperAfterDocComment());
        addTestCase("function in a group is bound", \testFunctionInGroup());
        addTestCase("other code after a doc comment is kept", \testCodeAfterDocCommentKept());
        addTestCase("empty group is accepted", \testEmptyGroup());
        addTestCase("undocumented method fails", \testUndocumentedMethod());
        addTestCase("undocumented methods of other forms fail", \testUndocumentedMethodForms());
        addTestCase("documented method is bound", \testDocumentedMethod());
        addTestCase("method in a block comment is copied", \testMethodInBlockComment());
        addTestCase("method of a C++ class is copied", \testMethodOfCppClass());
        addTestCase("undocumented group members fail", \testUndocumentedGroupMembers());
        addTestCase("function without a return type outside a group fails", \testFunctionWithoutReturnType());
        addTestCase("constant with :: outside a group fails", \testConstantWithScopeOutsideGroup());
        addTestCase("undocumented pseudo-class method fails", \testUndocumentedPseudoMethod());
        addTestCase("undocumented method with a scoped return type fails", \testUndocumentedScopedReturnType());
        addTestCase("undocumented method before its class fails", \testUndocumentedMethodBeforeClass());
        addTestCase("code in '#if 0' is copied", \testIfZero());
        addTestCase("raw string literals", \testRawStringLiterals());
        addTestCase("statements are not methods", \testStatementsNotMethods());
        addTestCase("doc comments in a block comment are copied", \testDocCommentInBlockComment());
        addTestCase("error line of a last line without a newline", \testLastLineWithoutNewline());
        addTestCase("valid C++ signatures are copied", \testValidCppSignatures());
        addTestCase("comments and '#if 0' in directive lines", \testDirectiveComments());
        addTestCase("group end in a comment", \testGroupEndInComment());
        addTestCase("every error is reported in one run", \testAllErrorsReported());
        addTestCase("constants have their own line markers", \testConstantLineMarkers());
        addTestCase("group text has the line of its first line", \testGroupTextLineMarkers());
        addTestCase("group text after a namespace line", \testGroupNamespaceLineMarkers());
        addTestCase("verbosity options", \testVerbosity());
        addTestCase("invalid verbosity levels fail", \testInvalidVerbosity());
        addTestCase("help text describes -v", \testHelp());

        set_return_value(main());
    }

    #! runs qpp with the given options over a source fragment
    /** @return a hash with the exit status (\c status), the combined output (\c out), the qpp source path
        (\c qpp_path), whether the C++ code was written (\c cpp) and the code (\c cpp_text)
    */
    private hash<auto> runQpp(string source, *list<string> opts) {
        if (!is_file(qpp_bin)) {
            testSkip("qpp binary not found at %y; set QPP or QORE_LIBDIR", qpp_bin);
        }

        TmpDir tmp("qore-qpp-struct-");
        string qpp_path = tmp.path + "/structtest.qpp";
        string cpp_path = tmp.path + "/structtest.cpp";

        File f();
        f.open2(qpp_path, O_WRONLY | O_CREAT | O_TRUNC);
        f.write(source);
        f.close();

        # the exit status is written to a file, so it is the status of qpp itself
        string status_path = tmp.path + "/status";
        string out = backquote(sprintf("%s %s --output=%s --dox-output=%s/structtest.dox.h %s 2>&1; echo $? > %s",
            qpp_bin, opts ? opts.join(" ") : "", cpp_path, tmp.path, qpp_path, status_path));

        return {
            "tmp": tmp,
            "out": out,
            "qpp_path": qpp_path,
            "status": trim(ReadOnlyFile::readTextFile(status_path)).toInt(),
            "cpp": is_file(cpp_path),
            "cpp_text": is_file(cpp_path) ? ReadOnlyFile::readTextFile(cpp_path) : "",
        };
    }

    #! asserts that qpp failed and wrote no C++ code
    private assertFailed(hash<auto> r, string what) {
        assertEq(1, r.status, what + ": qpp exits with status 1: " + r.out);
        assertFalse(r.cpp, what + ": no C++ code is written");
    }

    #! asserts that qpp succeeded
    private assertSucceeded(hash<auto> r, string what) {
        assertEq(0, r.status, what + ": qpp exits with status 0: " + r.out);
        assertTrue(r.cpp, what + ": the C++ code is written");
        assertNRegex("ERROR", r.out, what + ": no error is reported");
    }

    #! returns the number of error lines in qpp output, not counting the summary line
    private int countErrors(string out) {
        int count = 0;
        foreach string line in (out.split("\n")) {
            if (line =~ /ERROR: / && line !~ /please correct the error/) {
                ++count;
            }
        }
        return count;
    }

    testFunctionOutsideGroup() {
        # issue #219: the example of the issue
        hash<auto> r = runQpp("#include <qore/Qore.h>

//! lz4frame
/**

 */
binary lz4frame(binary bin, softint level) {
    return 0;
}
");
        assertFailed(r, "function outside a group");
        assertRegex("structtest\\.qpp:7: 'binary lz4frame\\(binary bin, softint level\\) \\{': a Qore function or "
            "constant with a doc comment must be declared in a group", r.out, "the error names the line");
        assertEq(1, countErrors(r.out), "one error: " + r.out);
    }

    testConstantOutsideGroup() {
        hash<auto> r = runQpp("//! a constant
/**
*/
const Stray = 1;
");
        assertFailed(r, "constant outside a group");
        assertRegex("structtest\\.qpp:4: 'const Stray = 1;': a Qore function or constant", r.out);

        # an or-nothing return type
        r = runQpp("//! a function
/**
*/
*string t_name() {
    return nullptr;
}
");
        assertFailed(r, "function with an or-nothing return type outside a group");
        assertRegex("structtest\\.qpp:4: '\\*string t_name\\(\\) \\{': a Qore function or constant", r.out);
    }

    testCppHelperAfterDocComment() {
        # a C++ function after a '//!' comment was dropped too; the error says to use a C++ comment
        hash<auto> r = runQpp("//! a helper
/**
*/
static int helper(int a) {
    return a;
}
");
        assertFailed(r, "C++ helper after a doc comment");
        assertRegex("C\\+\\+ code takes a '//' or '/\\* \\*/' comment, not '//!'", r.out);

        # with a C++ comment, it is copied
        r = runQpp("// a helper
static int helper(int a) {
    return a;
}
");
        assertSucceeded(r, "C++ helper after a C++ comment");
        assertRegex("static int helper\\(int a\\) \\{", r.cpp_text, "the helper is copied");
    }

    testFunctionInGroup() {
        hash<auto> r = runQpp(FuncGroupStart + Function + GroupEnd);
        assertSucceeded(r, "function in a group");
        assertRegex("addBuiltinVariant\\(\"t_func\"", r.cpp_text, "the function is bound");
    }

    testCodeAfterDocCommentKept() {
        # issue #219: a line after a doc comment that is not a declaration was dropped too
        hash<auto> r = runQpp("//! a value used by the module
/**
*/
static int module_value = 42;
");
        assertSucceeded(r, "code after a doc comment");
        assertRegex("static int module_value = 42;", r.cpp_text, "the line is kept");

        # a kept line with "::" that does not end the statement is copied with its newline
        r = runQpp("#ifdef HAVE_X
//! the default value
/**
*/
static int def_val = Foo::y
#endif
static int other = 2;
");
        assertSucceeded(r, "code with :: after a doc comment");
        assertRegex("static int def_val = Foo::y\n#endif\n", r.cpp_text, "the line keeps its newline");
        r = runQpp("//! the default value
/**
*/
static int def_val2 = Foo::y
    + 1;
");
        assertSucceeded(r, "a continued statement with :: after a doc comment");
        assertRegex("static int def_val2 = Foo::y\n    \\+ 1;", r.cpp_text,
            "the statement keeps its lines");
    }

    testRawStringLiterals() {
        # a '"' or '/*' in a raw string literal is neither a string nor a comment
        hash<auto> r = runQpp(ClassStart + "
static const char* s = R\"x(a\"b/*)x\";
//! documented
/** doc
*/
int TestCls::get() [flags=CONSTANT] {
    return 1;
}
");
        assertSucceeded(r, "a raw string literal with a quote and a comment start");
        assertRegex("TestCls_get", r.cpp_text, "the method after the raw string literal is bound");

        # a raw string literal over lines, with a comment start, a quote and a directive in it
        r = runQpp(ClassStart + "
static const char* s2 = u8R\"(line 1 /* '
#if 0
)\";
//! documented
/** doc
*/
int TestCls::get2() [flags=CONSTANT] {
    return 1;
}
");
        assertSucceeded(r, "a raw string literal over lines");
        assertRegex("TestCls_get2", r.cpp_text, "the method after the raw string literal over lines is bound");

        # a '#' line in a raw string literal or a block comment is not a directive
        r = runQpp(ClassStart + "
#ifdef FOO
static const char* s5 = R\"(
#endif
#else
)\";
/*
#endif
*/
#endif
//! documented
/** doc
*/
int TestCls::get5() [flags=CONSTANT] {
    return 1;
}
");
        assertSucceeded(r, "directive lines in a raw string literal and a block comment");
        assertRegex("TestCls_get5", r.cpp_text, "the method after them is bound");

        # a method in a raw string literal is copied as it is
        r = runQpp(ClassStart + "
static const char* s3 = R\"(
int TestCls::text() [flags=CONSTANT] {
)\";
");
        assertSucceeded(r, "a method in a raw string literal");
        assertRegex("int TestCls::text\\(\\) \\[flags=CONSTANT\\] \\{", r.cpp_text,
            "the method in the raw string literal is copied");

        # an identifier that ends in R before a string is not a raw string prefix: the method after it is checked
        r = runQpp(ClassStart + "
#define FOOR \"(\"
static const char* s4 = FOOR\"(\";
int TestCls::undoc() [flags=CONSTANT] {
    return 1;
}
");
        assertFailed(r, "an undocumented method after a string that is not a raw string literal");
    }

    testEmptyGroup() {
        # the form of the constant group of QC_FtpControlPollOperation.qpp
        hash<auto> r = runQpp("//! @defgroup empty_group Empty Group
/** @since %Qore 3.0
*/
///@{
///@}
" + ClassStart);
        assertSucceeded(r, "empty group");
        assertRegex("///@\\{", r.cpp_text, "the group start is kept as a comment");
    }

    testUndocumentedMethod() {
        # issue #1686: a method without a doc comment was copied into the C++ code as it was
        hash<auto> r = runQpp(ClassStart + "
int TestCls::get() [flags=CONSTANT] {
    return 1;
}
");
        assertFailed(r, "undocumented method");
        assertRegex("structtest\\.qpp:6: 'int TestCls::get\\(\\) \\[flags=CONSTANT\\] \\{': a method of class "
            "'TestCls' must have a leading doc comment", r.out, "the error names the line and the class");

        # a C++ signature is a method of a C++ class with the name of the class, such as the class of its private data
        r = runQpp(ClassStart + "
TestCls::TestCls(const QoreStringNode* s) : str(s) {
}

bool TestCls::next(ExceptionSink* xsink) {
    return true;
}
");
        assertSucceeded(r, "methods of a C++ class with the name of the class");
        assertRegex("bool TestCls::next\\(ExceptionSink\\* xsink\\) \\{", r.cpp_text, "the methods are copied");
    }

    testUndocumentedMethodForms() {
        map assertFailed(runQpp(ClassStart + $1 + "
    return 1;
}
"), $1), (
            "TestCls::constructor() [dom=PROCESS] {",
            "nothing TestCls::run(int a) {",
            "*string TestCls::name() {",
            "hash<auto> TestCls::info(softlist opts) {",
            "static int TestCls::count() [flags=CONSTANT] {",
            "private int TestCls::priv()[flags=CONSTANT] {",
            "int TestCls::conv(softint i, softstring s) {",
            "int TestCls::dflt(int a = f(1), int b = g(h(2))) [flags=CONSTANT] {",
            "int TestCls::fp(int (*cb)(int)) [flags=CONSTANT] {",
            "int TestCls::opt(*string a) [flags=CONSTANT] {",
            "int TestCls::opt2( * string a) [flags=CONSTANT] {",
            "int TestCls::opt3(*Foo::Bar a) [flags=CONSTANT] {",
            "int TestCls::opt4(*hash<auto> a) [const;flags=RET_VALUE_ONLY] {",
            "int TestCls::opt5(int a) [ doconly ] {",
            "enum<Color> TestCls::color() [flags=CONSTANT] {",
            "union<int, string> TestCls::either() [flags=CONSTANT] {",
        );
    }

    testDocumentedMethod() {
        hash<auto> r = runQpp(ClassStart + "
//! a documented method
/**
 */
int TestCls::get() {
    return 1;
}
");
        assertSucceeded(r, "documented method");
        assertRegex("addMethod\\(\"get\"", r.cpp_text, "the method is bound");
    }

    testMethodInBlockComment() {
        # the form of the disabled Socket::startPollReadServerSentEvent() in QC_Socket.qpp
        hash<auto> r = runQpp(ClassStart + "
/*
int TestCls::get() [flags=CONSTANT] {
    return 1;
}
*/
// int TestCls::commented() [flags=CONSTANT] {
/* a one-line comment */ static int after_comment = 1;
const char* str = \"/*\";
int x = 1; // /*
");
        assertSucceeded(r, "method in a block comment");
        assertRegex("int TestCls::get\\(\\) \\[flags=CONSTANT\\] \\{", r.cpp_text, "the commented method is copied");

        # a comment start in a string or a line comment does not hide a method
        r = runQpp(ClassStart + "
const char* str = \"/*\";
int x = 1; // /*
int TestCls::get() [flags=CONSTANT] {
    return 1;
}
");
        assertFailed(r, "undocumented method after a comment start in a string and a line comment");
        assertRegex("'int TestCls::get\\(\\) \\[flags=CONSTANT\\] \\{'", r.out);
    }

    testMethodOfCppClass() {
        # a method of a class that is not a qclass of the file is C++ code
        hash<auto> r = runQpp(ClassStart + "
int Helper::get() {
    return 3;
}
void ns::helper() {
}
");
        assertSucceeded(r, "method of a C++ class");
        assertRegex("int Helper::get\\(\\) \\{", r.cpp_text, "the method is copied");
    }

    testUndocumentedGroupMembers() {
        # issue #1686: a group member without a doc comment was copied into the C++ code as it was
        hash<auto> r = runQpp(ConstGroupStart + "//! one
const One = 1;
const Two = 2;
" + GroupEnd);
        assertFailed(r, "constant without a doc comment");
        assertRegex("structtest\\.qpp:7: 'const Two = 2;': a constant or a function in a group must have a leading "
            "doc comment", r.out);

        r = runQpp(FuncGroupStart + "int t_nodoc(softint a) {
    return a;
}
" + GroupEnd);
        assertFailed(r, "function without a doc comment");
        assertRegex("structtest\\.qpp:5: 'int t_nodoc\\(softint a\\) \\{': a constant or a function in a group",
            r.out);

        r = runQpp(FuncGroupStart + "int t_opt(*string a) [flags=CONSTANT] {
    return 1;
}
" + GroupEnd);
        assertFailed(r, "function with an or-nothing parameter and attributes without a doc comment");

        r = runQpp(FuncGroupStart + "Qore::Xml::XmlDoc t_scoped(string a) [flags=CONSTANT] {
    return 1;
}
" + GroupEnd);
        assertFailed(r, "function with a scoped return type and attributes without a doc comment");

        r = runQpp(FuncGroupStart + "t_noret(int a) [flags=CONSTANT] {
    return a;
}
" + GroupEnd);
        assertFailed(r, "function without a return type and a doc comment");

        # C++ code in a group is kept: a helper function and a C++ constant (with a type)
        r = runQpp(FuncGroupStart + "static void parallel_helper(ExceptionSink* xsink) {
}
const char* const_text = \"text\";
static int helper_value = 1;
// a comment: int f(int a) {
/*
int t_commented(int a) {
*/
" + Function + GroupEnd);
        assertSucceeded(r, "C++ code in a group");
        assertRegex("static void parallel_helper\\(ExceptionSink\\* xsink\\) \\{", r.cpp_text);
        assertRegex("const char\\* const_text", r.cpp_text);
        assertRegex("static int helper_value = 1;", r.cpp_text);
        assertRegex("int t_commented\\(int a\\) \\{", r.cpp_text, "the commented function is copied");
    }

    testFunctionWithoutReturnType() {
        # a group accepts a function without a return type
        hash<auto> r = runQpp("//! a function
/**
*/
t_func2(int a) {
    return a;
}
");
        assertFailed(r, "function without a return type outside a group");
        assertRegex("structtest\\.qpp:4: 't_func2\\(int a\\) \\{': a Qore function or constant", r.out);
    }

    testConstantWithScopeOutsideGroup() {
        # was taken for a method
        hash<auto> r = runQpp("//! a constant
/**
*/
const X = Foo::Bar;
");
        assertFailed(r, "constant with :: outside a group");
        assertRegex("structtest\\.qpp:4: 'const X = Foo::Bar;': a Qore function or constant", r.out);
    }

    testUndocumentedPseudoMethod() {
        # the form of the methods of QC_Pseudo*.qpp
        hash<auto> r = runQpp("//! a pseudo-class
/** a pseudo-class
*/
qclass <tpc> [];

int <tpc>::size() {
    return 0;
}
");
        assertFailed(r, "undocumented pseudo-class method");
        assertRegex("structtest\\.qpp:6: 'int <tpc>::size\\(\\) \\{': a method of class '<tpc>' must have a "
            "leading doc comment", r.out);
    }

    testUndocumentedScopedReturnType() {
        map assertFailed(runQpp(ClassStart + $1 + "
    return 1;
}
"), $1), (
            "Qore::Foo TestCls::m1() [flags=CONSTANT] {",
            "std::string TestCls::m2() [flags=CONSTANT] {",
            "hash<string, int> TestCls::m3(softint i) {",
        );
    }

    testUndocumentedMethodBeforeClass() {
        hash<auto> r = runQpp("int TestCls::early() [flags=CONSTANT] {
    return 1;
}

" + ClassStart);
        assertFailed(r, "undocumented method before its class");
        assertRegex("structtest\\.qpp:1: 'int TestCls::early\\(\\) \\[flags=CONSTANT\\] \\{': a method of class "
            "'TestCls'", r.out);
    }

    testIfZero() {
        hash<auto> r = runQpp(ClassStart + "
#if 0
int TestCls::disabled() [flags=CONSTANT] {
#ifdef NESTED
    return 1;
#endif
}
//! a doc comment
/**
*/
int t_disabled(int a) {
}
#endif
");
        assertSucceeded(r, "code in '#if 0'");
        assertRegex("int TestCls::disabled\\(\\) \\[flags=CONSTANT\\] \\{", r.cpp_text,
            "the disabled method is copied");

        # "#if (0)" and "#if false" are disabled code too
        foreach string cond in (" (0)", " false", " ( false )", "(0)", "(false)") {
            r = runQpp(ClassStart + "
#if" + cond + "
int TestCls::disabled() [flags=CONSTANT] {
}
#endif
");
            assertSucceeded(r, "code in '#if " + cond + "'");
        }

        # after the '#endif', a method is checked again
        r = runQpp(ClassStart + "
#if 0
#endif
int TestCls::enabled() [flags=CONSTANT] {
    return 1;
}
");
        assertFailed(r, "undocumented method after '#if 0' ... '#endif'");

        # '#else' of '#if 0' is compiled
        r = runQpp(ClassStart + "
#if 0
#else
int TestCls::enabled() [flags=CONSTANT] {
    return 1;
}
#endif
");
        assertFailed(r, "undocumented method in the '#else' of '#if 0'");
    }

    testStatementsNotMethods() {
        hash<auto> r = runQpp(ClassStart + "
static void helper() {
TestCls::foo(1);
return TestCls::bar(2);
}
");
        assertSucceeded(r, "statements at column 0");
        assertRegex("TestCls::foo\\(1\\);", r.cpp_text);
    }

    testDocCommentInBlockComment() {
        hash<auto> r = runQpp("/*
//! a commented-out function
/**
*/
int t_old(int a) {
    return a;
}
*/
");
        assertSucceeded(r, "doc comment in a block comment");
        assertRegex("int t_old\\(int a\\) \\{", r.cpp_text, "the commented text is copied");
    }

    testLastLineWithoutNewline() {
        hash<auto> r = runQpp(ClassStart + "
*int TestCls::last() {");
        assertFailed(r, "last line without a newline");
        assertRegex("structtest\\.qpp:6: '\\*int TestCls::last\\(\\) \\{'", r.out, "the error has the line of the method");
    }

    testValidCppSignatures() {
        # methods of a C++ class with the name of the class, which C++ accepts
        hash<auto> r = runQpp(ClassStart + "
std::vector<int>::iterator TestCls::begin() {
}
vector<int>::iterator TestCls::end() {
}
Ref<Foo>::type TestCls::get() const {
}
bool TestCls::check(int softint) {
}
bool TestCls::check2(int x) { // like softstring
}
int TestCls::f(int a) // (a) [see note]
{
}
int TestCls::g(const char* s = \"*string x(\") {
}
int (*TestCls::rows(int))[N] {
}
static void TestCls_helper(int i) {
TestCls::run((Fn)[self = i]() {
    });
}
auto TestCls::table() -> int(&)[3] {
}
int TestCls::sub(int a)[[deprecated]] {
}
static wchar_t quote_char() { return L'\"'; } /* old code:
int TestCls::old(softint a) {
}
*/
// don't: int TestCls::prose(softint a) {
");
        assertSucceeded(r, "methods of a C++ class");
        assertRegex("vector<int>::iterator TestCls::end\\(\\) \\{", r.cpp_text);
        assertRegex("bool TestCls::check\\(int softint\\) \\{", r.cpp_text);

        # C++ code in a group
        r = runQpp(FuncGroupStart + "static int helper(int softint) {
}
int t_helper(int a) /* softint */ {
}
DECLARE(softint)
static auto get_table() -> int(&)[3] {
}
static int (*get_row(int i))[N] {
}
static int (&get_ref(int i))[MAX] {
}
static int (*ns::get_row2(int i))[N] {
}
static int (**pp2(int))[N] {
}
static int (&&rr(int))[N] {
}
static int (*const cp(int))[N] {
}
static int (Cls::*mp(int))[N] {
}
int (*(Cls::*getpmf(int))(double))[N] {
}
int (*(*getfp(int))(double))[N] {
}
int (*Tpl<T>::name2(int))[N] {
}
int (*Cls::operator[](size_t i))[N] {
}
int (*(name3)(int))[N] {
}
static void helper2(int i) {
run((Fn)[self = i]() {
    });
g()[a==b]
    = 1;
}
static int hex = 0x1F'FF; static double f = 1'000.5; /*
int t_hidden(softint a) {
*/
static char32_t c = U'\"'; /*
int t_hidden2(softint a) {
*/
int v = get(a,
*get_ptr(a,
    b));
" + Function + GroupEnd);
        assertSucceeded(r, "C++ code in a group");
        assertRegex("static int helper\\(int softint\\) \\{", r.cpp_text);
        assertRegex("DECLARE\\(softint\\)", r.cpp_text);
    }

    testDirectiveComments() {
        # a comment that starts in a directive line
        hash<auto> r = runQpp(ClassStart + "
#define X 1 /* start
int TestCls::x() [flags=CONSTANT] {
*/
");
        assertSucceeded(r, "a comment started in a directive line");

        # a comment that ends in a directive line: the class after it is processed
        r = runQpp("/* comment
#include <x.h> */
" + ClassStart + "
//! a method
/**
 */
int TestCls::get() {
    return 1;
}
");
        assertSucceeded(r, "a comment ended in a directive line");
        assertRegex("addMethod\\(\"get\"", r.cpp_text, "the method is bound");

        # '#if 0' with a comment, '#elif' and nested conditionals
        r = runQpp(ClassStart + "
#if 0 // disabled
int TestCls::a() [flags=CONSTANT] {
#if defined(X)
int TestCls::b() [flags=CONSTANT] {
#else
int TestCls::c() [flags=CONSTANT] {
#endif
#elif defined(Y)
int TestCls::d() [flags=CONSTANT] {
#endif
");
        assertFailed(r, "'#elif' of '#if 0' is compiled");
        assertRegex("'int TestCls::d\\(\\) \\[flags=CONSTANT\\] \\{'", r.out, "the method after '#elif' is reported");
        assertNRegex("TestCls::[abc]\\(", r.out, "the methods in '#if 0' are not reported");

        r = runQpp(ClassStart + "
#if 0 // disabled
int TestCls::a() [flags=CONSTANT] {
#if defined(X)
int TestCls::b() [flags=CONSTANT] {
#else
int TestCls::c() [flags=CONSTANT] {
#endif
#endif
");
        assertSucceeded(r, "nested conditionals in '#if 0'");

        # a digit separator is not a character literal
        r = runQpp(ClassStart + "
static int big = 1'000'000; /*
int TestCls::x() [flags=CONSTANT] {
*/
");
        assertSucceeded(r, "a digit separator before a comment");
    }

    testGroupEndInComment() {
        # the end of a group ends it in a comment too, as before
        hash<auto> r = runQpp(FuncGroupStart + Function + "/* the end
///@}
*/
");
        assertSucceeded(r, "group end in a comment");
        assertRegex("addBuiltinVariant\\(\"t_func\"", r.cpp_text, "the function is bound");
    }

    testAllErrorsReported() {
        hash<auto> r = runQpp("//! a constant
/**
*/
const Stray = 1;
" + ClassStart + "
int TestCls::first() [flags=CONSTANT] {
    return 1;
}

*string TestCls::second() {
    return 2;
}
");
        assertFailed(r, "three errors");
        assertEq(3, countErrors(r.out), "every error is reported: " + r.out);
        assertRegex("'const Stray = 1;'", r.out);
        assertRegex("'int TestCls::first\\(\\) \\[flags=CONSTANT\\] \\{'", r.out);
        assertRegex("'\\*string TestCls::second\\(\\) \\{'", r.out);
        assertRegex("3 errors found", r.out);
    }

    testConstantLineMarkers() {
        # issue #2290: every constant's binding is preceded by the location of its definition
        string source = ConstGroupStart + "//! the first constant
const ConstOne = 1;

//! the second constant
/** with a long comment
*/
const ConstTwo = 2;
//! a constant defined on two lines
const ConstThree =
    3;
" + GroupEnd;
        hash<auto> r = runQpp(source);
        assertSucceeded(r, "constants");

        list<string> src_lines = source.split("\n");
        list<string> cpp_lines = r.cpp_text.split("\n");
        int found = 0;
        for (int i = 0; i < cpp_lines.size(); ++i) {
            *list<*string> m = (cpp_lines[i] =~ x/ns\.addConstant\("([A-Za-z]+)"/);
            if (!m) {
                continue;
            }
            ++found;
            string name = m[0];
            *list<*string> loc = (cpp_lines[i - 1] =~ x/^# ([0-9]+) "(.*)"$/);
            assertEq(2, loc.size(), sprintf("%s: the binding is preceded by a line marker: %y", name,
                cpp_lines[i - 1]));
            assertEq(r.qpp_path, loc[1], name + ": the marker names the source file");
            int line = loc[0].toInt();
            assertRegex("^const " + name + " =", src_lines[line - 1], sprintf("%s: the marker gives the line of "
                "its definition (line %d)", name, line));
        }
        assertEq(3, found, "the three constants are bound");
    }

    testGroupTextLineMarkers() {
        # issue #2290: a group's text has the location of its first line
        string source = ConstGroupStart + "//! the first constant
const ConstOne = 1;

#ifdef HAVE_SOMETHING_UNDEFINED
//! a conditional constant
const ConstTwo = 2;
#endif
//! a runtime constant
const ConstThree = qore_runtime((bool)1, (bool)0);
" + GroupEnd;
        hash<auto> r = runQpp(source);
        assertSucceeded(r, "group with text");

        list<string> src_lines = source.split("\n");
        list<string> cpp_lines = r.cpp_text.split("\n");
        int found = 0;
        for (int i = 1; i < cpp_lines.size(); ++i) {
            if (cpp_lines[i] !~ /^#ifdef HAVE_SOMETHING_UNDEFINED/) {
                continue;
            }
            ++found;
            # the text starts at the line of the nearest marker before it
            int m = i - 1;
            while (m >= 0 && cpp_lines[m] !~ /^# [0-9]+ "/) {
                --m;
            }
            assertTrue(m >= 0, "the text is preceded by a line marker");
            *list<*string> loc = (cpp_lines[m] =~ x/^# ([0-9]+) "(.*)"$/);
            assertEq("#ifdef HAVE_SOMETHING_UNDEFINED", src_lines[loc[0].toInt() - 1 + (i - m - 1)],
                sprintf("the marker gives the line of the text (marker %y, %d line(s) before)", cpp_lines[m],
                    i - m));
        }
        assertEq(1, found, "the text is written once");

        # a runtime constant's binding has its line too
        found = 0;
        for (int i = 1; i < cpp_lines.size(); ++i) {
            if (cpp_lines[i] !~ /qore_ns_add_runtime_constant\(ns, "Qore", "ConstThree"/) {
                continue;
            }
            ++found;
            *list<*string> loc = (cpp_lines[i - 1] =~ x/^# ([0-9]+) "(.*)"$/);
            assertEq(2, loc.size(), sprintf("the runtime constant is preceded by a line marker: %y",
                cpp_lines[i - 1]));
            assertRegex("^const ConstThree =", src_lines[loc[0].toInt() - 1]);
        }
        assertEq(1, found, "the runtime constant is bound");
    }

    testGroupNamespaceLineMarkers() {
        # a namespace line in a group ends the text before it
        string source = FuncGroupStart + "// comment A
namespace Qore::Foo;
static int x = 1;
" + Function + GroupEnd;
        hash<auto> r = runQpp(source);
        assertSucceeded(r, "group with a namespace line");
        list<string> src_lines = source.split("\n");
        list<string> cpp_lines = r.cpp_text.split("\n");
        int found = 0;
        for (int i = 1; i < cpp_lines.size(); ++i) {
            if (cpp_lines[i] !~ /^static int x = 1;/) {
                continue;
            }
            ++found;
            int m = i - 1;
            while (m >= 0 && cpp_lines[m] !~ /^# [0-9]+ "/) {
                --m;
            }
            assertTrue(m >= 0, "the text is preceded by a line marker");
            *list<*string> loc = (cpp_lines[m] =~ x/^# ([0-9]+) "(.*)"$/);
            assertEq("static int x = 1;", src_lines[loc[0].toInt() - 1 + (i - m - 1)],
                "the marker gives the line of the text");
        }
        assertEq(1, found, "the text is written once");
    }

    testVerbosity() {
        # LL_DEBUG (4) logs every source line read ("<line>: <text>"); LL_DETAIL (3) logs the classes parsed; the
        # default level (2) logs the files written
        string debug_line = "DEBUG: 2: /\\*\\* @defgroup";
        string detail_line = "parsing Qore class 'TestCls'";
        string info_line = "creating cpp file";
        hash<string, hash<auto>> cases = {
            "": {"debug": False, "detail": False, "info": True},
            "-v": {"debug": False, "detail": True, "info": True},
            "-vv": {"debug": True, "detail": True, "info": True},
            "-v -v": {"debug": True, "detail": True, "info": True},
            "-v3": {"debug": False, "detail": True, "info": True},
            "-v4": {"debug": True, "detail": True, "info": True},
            "--verbose=4": {"debug": True, "detail": True, "info": True},
            "--verbose": {"debug": False, "detail": True, "info": True},
            "-v0": {"debug": False, "detail": False, "info": False},
            "--verbose=0": {"debug": False, "detail": False, "info": False},
            "-v -v -v -v": {"debug": True, "detail": True, "info": True},
        };
        foreach hash<auto> c in (cases.pairIterator()) {
            hash<auto> r = runQpp(Valid + ClassStart, c.key ? (c.key,) : NOTHING);
            # issue #1686: "-v" took the next argument (--output=...) as its level and dropped it
            assertSucceeded(r, sprintf("%y", c.key));
            if (c.value.debug) {
                assertRegex(debug_line, r.out, sprintf("%y logs at the debug level", c.key));
            } else {
                assertNRegex(debug_line, r.out, sprintf("%y does not log at the debug level", c.key));
            }
            if (c.value.detail) {
                assertRegex(detail_line, r.out, sprintf("%y logs at the detail level", c.key));
            } else {
                assertNRegex(detail_line, r.out, sprintf("%y does not log at the detail level", c.key));
            }
            if (c.value.info) {
                assertRegex(info_line, r.out, sprintf("%y logs at the info level", c.key));
            } else {
                assertNRegex(info_line, r.out, sprintf("%y does not log at the info level", c.key));
            }
        }
    }

    testInvalidVerbosity() {
        # a level after a space is an input file
        {
            hash<auto> r = runQpp(Valid, ("-v", "3"));
            assertFailed(r, "-v 3");
            assertRegex("\\b3: No such file or directory", r.out);
        }
        # "-vv..." is the short option only, and the long option's level is not empty
        foreach string opt in ("-vx", "-v9", "-v-1", "--verbose=x", "--verbose=5", "-v3x", "-vvx", "--verbose=",
                "--verbose=vv") {
            hash<auto> r = runQpp(Valid, (opt,));
            assertFailed(r, opt);
            assertRegex("invalid verbosity level '[^']*'; expecting an integer from 0 to 4", r.out, opt);
        }
    }

    testHelp() {
        if (!is_file(qpp_bin)) {
            testSkip("qpp binary not found at %y; set QPP or QORE_LIBDIR", qpp_bin);
        }
        string out = backquote(qpp_bin + " --help 2>&1; true");
        assertRegex("-v, --verbose\\[=arg\\] +increases the verbosity level \\(repeatable: -vv\\)", out);
        assertRegex("from 0 to 4 \\(-v3, --verbose=3\\)", out);
    }
}
