#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires Util
%requires QUnit

%exec-class RunTestsCredentialsTest

#! run_tests.sh never prints the password of a datasource string from its environment
/** run_tests.sh prints the QORE_DB_CONNSTR* variables before the tests start; CI job logs can be read by anyone with
    access to the pipeline, so the password component is replaced with "****".
*/
class RunTestsCredentialsTest inherits QUnit::Test {
    public {
        #! the password in every string; it must not appear in the output
        const Secret = "Zq7-s3cr3t";

        #! environment variable -> [datasource string, the string as printed]
        const Cases = {
            "QORE_DB_CONNSTR_PGSQL": (
                "pgsql:user/" + Secret + "@db%localhost:5432",
                "pgsql:user/****@db%localhost:5432",
            ),
            # a password containing '@' and '/' ends at the last '@', as parseDatasource() reads it
            "QORE_DB_CONNSTR_ORACLE": (
                "oracle:scott/" + Secret + "@x/y@orcl(al32utf8)%dbhost:1521",
                "oracle:scott/****@orcl(al32utf8)%dbhost:1521",
            ),
            # the option string is kept, even with an '@' in it
            "QORE_DB_CONNSTR_MYSQL": (
                "mysql:root/" + Secret + "@test{min=1,max=2,note=a@b}",
                "mysql:root/****@test{min=1,max=2,note=a@b}",
            ),
            # no driver name
            "QORE_DB_CONNSTR": (
                "user/" + Secret + "@db",
                "user/****@db",
            ),
            # no password: printed unchanged
            "QORE_DB_CONNSTR_FREETDS": (
                "freetds:sa@master%mssql:1433",
                "freetds:sa@master%mssql:1433",
            ),
        };
    }

    constructor() : QUnit::Test("RunTestsCredentialsTest", "1.0", \ARGV) {
        addTestCase("datasource passwords are masked", \testMasked());
        set_return_value(main());
    }

    testMasked() {
        if (!ENV.QORE_BINARY || !ENV.LIBQORE_BINARY) {
            testSkip("run with run_tests.sh, which sets QORE_BINARY and LIBQORE_BINARY");
        }
        string root = normalize_dir(get_script_dir() + "/../../../..");
        assertTrue(is_file(root + "/run_tests.sh"));

        string env;
        foreach hash<auto> i in (Cases.pairIterator()) {
            env += sprintf("%s=%s ", i.key, quote(i.value[0]));
        }
        # no test is found in the directory, so the script ends after printing its settings
        string out = backquote(sprintf("cd %s && %sQORE_BINARY=%s LIBQORE_BINARY=%s sh ./run_tests.sh "
            "-d no-such-test-directory 2>&1", quote(root), env, quote(ENV.QORE_BINARY), quote(ENV.LIBQORE_BINARY)));

        assertEq(-1, out.find(Secret), "no password is printed");
        foreach hash<auto> i in (Cases.pairIterator()) {
            *string line;
            foreach string l in (out.split("\n")) {
                if (l.equalPartial(i.key + ": ")) {
                    line = l;
                    break;
                }
            }
            assertEq(i.key + ": " + i.value[1], line, i.key);
        }
    }

    #! quotes a string for the shell
    private static string quote(string str) {
        return "'" + replace(str, "'", "'\\''") + "'";
    }
}
