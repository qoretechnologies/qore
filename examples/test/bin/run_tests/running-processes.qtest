#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires Util
%requires FsUtil
%requires QUnit

%exec-class RunningProcessesTest

#! qore_ci_running_processes() tells the processes that a test or a CI job left running apart
/** run_tests.sh fails a test that leaves processes running, and the CI scripts fail a job that does, except for the
    watcher that BusyBox timeout leaves for up to a second after its command ended.  The processes are found first and
    examined afterwards, so a process can end in between, like such a watcher: it is not running, and does not fail
    the test (CI job 213457 failed IRExecModeSmoke.qtest, whose tests had all passed, for a process that was gone when
    it was examined).

    The function reads the /proc directory given in QORE_CI_PROC, so the cases are made with a directory tree of
    their own, where each process ID is a directory with the files that the function reads.
*/
class RunningProcessesTest inherits QUnit::Test {
    constructor() : QUnit::Test("RunningProcessesTest", "1.0", \ARGV) {
        addTestCase("running processes, BusyBox timeout watchers, and processes that are gone", \testStates());
        addTestCase("no process", \testNone());
        set_return_value(main());
    }

    #! returns the output of qore_ci_running_processes() for the given process IDs in the given /proc directory
    private string runningProcesses(string proc, list<int> pids) {
        string script = normalize_dir(get_script_dir() + "/../../docker_test/ci-job-processes.sh");
        assertTrue(is_file(script), "the script exists");
        # the script is $0 of the shell, and the process IDs are its arguments
        return backquote(sprintf("QORE_CI_PROC=%s sh -c '. \"$0\" && qore_ci_running_processes \"$@\"' %s %s 2>&1",
            quote(proc), quote(script), (map sprintf("%d", $1), pids).join(" ")));
    }

    #! quotes a string for the shell
    private static string quote(string str) {
        return "'" + replace(str, "'", "'\\''") + "'";
    }

    #! makes the directory of a process with the given executable and command line (each omitted if NOTHING)
    private makeProcess(string proc, int pid, *string exe, *list<string> args) {
        string dir = sprintf("%s/%d", proc, pid);
        assertEq(0, mkdir(dir));
        if (exe) {
            symlink(exe, dir + "/exe");
        }
        if (args) {
            File f();
            f.open2(dir + "/cmdline", O_CREAT | O_WRONLY | O_TRUNC);
            foreach string arg in (args) {
                f.write(arg);
                f.write(binary(chr(0)));
            }
        }
    }

    testStates() {
%ifdef Windows
        testSkip("Windows");
%endif
        TmpDir proc("qore-running-processes-");
        # a process that is running
        makeProcess(proc.path, 101, "/usr/bin/sleep", ("sleep", "60"));
        # the watcher of BusyBox timeout
        makeProcess(proc.path, 102, "/bin/busybox", ("timeout", "-s", "TERM", "600", "qore", "x.qtest"));
        # the same, started with a path
        makeProcess(proc.path, 103, "/bin/busybox", ("/usr/bin/timeout", "5", "sh"));
        # another BusyBox command
        makeProcess(proc.path, 104, "/bin/busybox", ("sh", "-c", "sleep 60"));
        # a process of another user, whose executable cannot be read
        makeProcess(proc.path, 105, NOTHING, ("qore", "server.q"));
        # 106: a process that had ended when it was examined
        # a process that ended after its executable was read
        makeProcess(proc.path, 107, "/bin/busybox");

        string out = runningProcesses(proc.path, (101, 102, 103, 104, 105, 106, 107));
        assertEq("running 101 sleep 60 \n"
            "watcher 102\n"
            "watcher 103\n"
            "running 104 sh -c sleep 60 \n"
            "running 105 qore server.q \n", out);
    }

    testNone() {
%ifdef Windows
        testSkip("Windows");
%endif
        TmpDir proc("qore-running-processes-");
        assertEq("", runningProcesses(proc.path, ()));
        # only processes that are gone
        assertEq("", runningProcesses(proc.path, (201, 202)));
    }
}
