#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

# A child process created with fork() while another thread holds the lock of the recorded locale data fallbacks can
# use them: the module registers a fork handler for the lock.  Without it, the child got the lock held by a thread
# that does not exist in it and waited forever for it (the test runner's time limit is only a guard).

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"

%requires QUnit
%requires i18n

%exec-class I18nForkTest

class I18nForkTest inherits QUnit::Test {
    constructor() : QUnit::Test("i18n fork", "1.0", \ARGV) {
        addTestCase("fork() while another thread holds the locale data fallback lock", \testFork());
        set_return_value(main());
    }

    testFork() {
        if (!Option::HAVE_FORK) {
            testSkip("fork() is not available");
        }
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("the test needs a debug build of the library");
        }
        # another thread holds the lock while fork() is called; the child takes it as the module does
        hash<auto> r = call_function("dbg_fork_while_handler_held", "i18n_locale_data_fallbacks", int sub () {
            return I18n::get_locale_data_fallbacks().typeCode() == NT_LIST ? 0 : 1;
        });
        assertTrue(r.waited, "fork() waited for the thread holding the lock");
        assertEq(0, r.status, "the child read the recorded fallbacks");
    }
}
