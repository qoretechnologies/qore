%modern

module NativeFixture {
    version = "1.0";
    desc = "gives tests that build C++ fixtures against the library's internal headers their include paths";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
}

/** @mainpage NativeFixture Module

    The library's internal headers include the headers of its dependencies (OpenSSL, LLVM and others), which can be
    outside the compiler's default search path (MacPorts and Homebrew install them under their own prefixes).  The
    build writes the include directories that libqore's users need to \c qore-internal-include-dirs.txt in the build
    directory (see CMakeLists.txt), and native_fixture_include_args() returns them as compiler arguments, so a test
    finds them from the build it tests, not from the environment.
*/

#! the namespace of the module
public namespace NativeFixture {
#! Returns the \c -I compiler arguments for the include directories of the build in the given directory
/** @param libdir the build directory (the directory of libqore)

    @return the \c -I arguments, in the order of the build, without duplicates

    @throw TEST-SETUP-ERROR the build directory has no \c qore-internal-include-dirs.txt (the build was configured
    before CMake wrote it: configure it again)
*/
public list<string> sub native_fixture_include_args(string libdir) {
    string path = libdir + "/qore-internal-include-dirs.txt";
    if (!is_file(path)) {
        throw "TEST-SETUP-ERROR", sprintf("%s does not exist: configure the build in %s again with cmake to write it",
            path, libdir);
    }
    list<string> args = ();
    hash<string, bool> seen = {};
    foreach string dir in (split("\n", File::readTextFile(path))) {
        dir = trim(dir);
        if (!dir || seen{dir}) {
            continue;
        }
        seen{dir} = True;
        push args, "-I" + dir;
    }
    return args;
}
}
