#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - JIT and AOT code generation of the exception edges and exits of streaming operators
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - every check runs the script in a child process that sets its own --exec-mode, or AOT

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../ExecModeHarness.qm

%exec-class StreamingElementCleanupTest

#! issue #5670: streaming operators release their element, list and source when the predicate or the consumer raises
/** The predicate of a streaming operator in an expression (takewhile, takeuntil, first, any, all, count), and of
    select and map-select over an iterator, runs with the element as the implicit argument, whose list holds a
    reference to the element.  An exception that the predicate raised skipped the restoration of the implicit argument,
    so the element was released after the handler (or never, when nothing restored the thread's implicit arguments
    later), and the operator's exception cleanup did not release the element and the list built so far.  A streaming
    operator that stopped before its iterator was exhausted (take, takewhile, first, any) kept the iterator, and with
    it the source, until the function returned, so a consumer of its value that raised released the values after its
    handler; the source of every streaming operator was released at the end of the statement, where the AST
    interpreter releases it when the operator returns.

    The review of the fix found more (streaming-element-cleanup-review.q): a predicate's temporaries were released
    before the element on the normal path; a fused map stage that changes the element released the element after the
    pipeline; fused pipelines and the typed-list map and map-select loops that raised released the source before the
    list in native code; an iterator's next() that raised released the list before the source (the AST interpreter
    ends the functional iterator as if the source were exhausted); a destructor of the previous element that raised
    did not stop the loop in the IR interpreter; the message of a negative take or drop count differed; and code with
    no handler in the function released its values in another order in the IR interpreter.  Its second round found
    that a fused map stage whose value is an object released its last value after the source (and an intermediate
    stage's value one element late), that a throw or an operator cleanup's rethrow with no handler in the function did
    not restore the implicit argument of an enclosing operator in native code, that a division by zero in a
    predicate was taken by native code for an exception of the iterator's next(), and that a predicate whose value is
    an object kept it until the next element's or the statement's end.

    Each script runs its cases and logs the release of every object and the objects that were not released exactly
    once when the case returned.  Its output with the AST interpreter is checked, and it must be the same in every
    other execution mode, on the IR tier and as an AOT executable.
*/
class StreamingElementCleanupTest inherits QUnit::Test {
    public {
        #! lines of the output of the AST interpreter: the cases that the issue reports and the release orders that
        #! decide them
        const AstLines = (
            "takewhile_raises: released h1; released h2; released h3; catch SELECT; after",
            "count_raises: released h1; released h2; catch SELECT; after",
            "it_takewhile_raises: released it3; released it1; released it2; catch SELECT; after",
            "it_count_raises: released it1; released it2; catch SELECT; after",
            "it_select_raises: released it2; released it1; catch SELECT; after",
            "auto_map_raises: released h1; released h2; released h3; catch STAGE; after",
            "consumer_plain: released h1; released h2; catch CONSUMER; after",
            "consumer_take: released h3; released h1; released h2; catch CONSUMER; after",
            "consumer_first: released h2; released h1; catch CONSUMER; after",
            "no_handler: released it2; released it1; catch SELECT; after",
            "implicit_args: released it1; released it2; count 2; released it1; released it2; catch SELECT; "
                "argv [\"b\"]; after",
            "normal_take: released h2; released h3; show 1; released h1; after",
            "normal_it_takewhile: released it2; show 1; released it1; after",
        );

        #! lines of the output of the AST interpreter for the review cases
        const ReviewAstLines = (
            "temp_pred_select: released t0; released it2; released t1; itdone it; released t2; r 2; released it1; "
                "released it3; after",
            "temp_pred_mapsel: released it1; released t0; released it2; released t1; released m0; released it3; "
                "itdone it; released m2; released t2; r 2; after",
            "fmap_take: released it1; itdone it; after",
            "fused_two_stage: released it3; released it1; released it2; itdone it; catch SELECT/it3; after",
            "tl_map_new_raises: released n0; released h1; released h2; catch SELECT/h2; after",
            "next_raises: itdone n; released n1; released n2; catch NEXT/n3; after",
            "next_raises_nh: itdone n; released n1; released n2; catch NEXT/n3; after",
            "dtor_raises_normal_any: released x1; itdone x; catch DTOR/x1; after",
            "fused_stage_raises_nh: released it1; released it2; itdone it; catch STAGE/it2; after",
            "take_neg: itdone it; catch STREAMING-OPERATOR-ERROR/take operator expression requires a non-negative "
                "count, got -1; after",
            "fpm_count: released it1; released p1; released it2; released p2; released it3; released p3; itdone it; "
                "c 3; after",
            "fpm_select: released it1; released p1; released q1; released it2; released p2; released it3; "
                "released p3; released q3; itdone it; c 2; after",
            "fpm_list: released p1; released p2; released h1; released h2; first 0; after",
            "fpm_raises: released it1; released p1; released it2; released p2; itdone it; catch SELECT/p2; after",
            "nh_rethrow: released in1; itdone in; released out1; itdone out; catch NEXT/in2; after",
            "nh_throw: itdone in; released out1; itdone out; catch STREAMING-OPERATOR-ERROR/take operator expression "
                "requires a non-negative count, got -1; after",
            "nh_div_select: released it2; released it1; itdone it; catch DIVISION-BY-ZERO; after",
            "ap_msel_list: released h1; released h2; catch STAGE/h2; after",
            "ap_msel_it: released it1; released it2; itdone it; catch STAGE/it2; after",
            "ap_msel_normal: released it1; released it2; released it3; itdone it; r 3; after",
            "nh_modany_select: released it2; released it1; itdone it; catch DIVISION-BY-ZERO; after",
            "nh_stradd_select: released it2; released it1; itdone it; catch ENCODING-CONVERSION-ERROR; after",
        );
    }

    private {
        string qore_bin;
        string qcc_bin;
        string env;
        string script;
        string review_script;
    }

    constructor() : QUnit::Test("streaming element cleanup", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        string libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
            ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");
        env = sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s QORE_LIBDIR=%s", libqore_dir, libqore_dir, libqore_dir);
        script = get_script_dir() + "/streaming-element-cleanup.q";
        review_script = get_script_dir() + "/streaming-element-cleanup-review.q";

        addTestCase("AST interpreter", \astTest());
        addTestCase("execution modes", \modesTest());
        addTestCase("AOT executable", \aotTest());
        set_return_value(main());
    }

    #! checks the output of the AST interpreter, which the other modes must give
    private astTest() {
        checkAst(script, AstLines);
        checkAst(review_script, ReviewAstLines);
    }

    #! runs the scripts in every execution mode and on the IR tier
    private modesTest() {
        foreach string s in ((script, review_script)) {
            string exp = ast(s);
            string name = basename(s);
            foreach string mode in (ExecModeHarness::ExecModes) {
                if (mode == "ast") {
                    continue;
                }
                assertEq(exp, ExecModeHarness::run(sprintf("%s %s --exec-mode=%s %s", env, qore_bin, mode, s)),
                    name + " " + mode);
            }
            assertEq(exp, ExecModeHarness::run_ir_tier(sprintf("%s %s --exec-mode=tiered %s", env, qore_bin, s)),
                name + " " + ExecModeHarness::IRTierName);
        }
    }

    #! compiles the scripts with qcc and checks that the executables give the output of the AST interpreter
    private aotTest() {
        if (!is_file(qcc_bin)) {
            testSkip("qcc is not available at " + qcc_bin);
        }
        TmpDir dir("streaming-element-cleanup-aot-");
        foreach string s in ((script, review_script)) {
            string exe = dir.path + "/" + basename(s);
            string out = ExecModeHarness::run_any(sprintf("%s %s -O3 -o %s %s", env, qcc_bin, exe, s));
            assertTrue(is_file(exe), "qcc compiles " + basename(s) + ": " + out);
            assertEq(ast(s), ExecModeHarness::run_any(sprintf("%s %s", env, exe)), basename(s) + " AOT");
        }
    }

    #! checks the output of a script with the AST interpreter
    private checkAst(string s, list<string> expected) {
        string out = ast(s);
        list<string> lines = select out.split("\n"), $1;
        foreach string line in (expected) {
            assertTrue(inlist(line, lines), line);
        }
        # no object outlives its case or is released twice in the AST interpreter
        assertEq(-1, out.find(" ERROR: "), basename(s));
        # every case runs three times
        assertEq(3 * StreamingElementCleanupTest::caseCount(lines), lines.size(), basename(s));
    }

    #! returns the output of a script with the AST interpreter
    private string ast(string s) {
        return ExecModeHarness::run(sprintf("%s %s --exec-mode=ast %s", env, qore_bin, s));
    }

    #! returns the number of distinct cases in the output
    private static int caseCount(list<string> lines) {
        hash<string, bool> cases;
        foreach string line in (lines) {
            cases{(line =~ x/^([^:]+):/)[0]} = True;
        }
        return cases.size();
    }
}
