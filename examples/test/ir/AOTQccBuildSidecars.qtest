#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil

%exec-class AOTQccBuildSidecarsTest

class AOTQccBuildSidecarsTest inherits QUnit::Test {
    private {
        string qcc_bin;
        string libqore_dir;
        string env;
    }

    constructor() : QUnit::Test("AOTQccBuildSidecarsTest", "1.0", \ARGV) {
        string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
            ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");
        env = sprintf("LD_LIBRARY_PATH=%s QORE_LIBDIR=%s", libqore_dir, libqore_dir);

        addTestCase("single source qo sidecars and manifest skip", \testSingleSourceSidecars());
        addTestCase("script preload qo libraries can be omitted from manifest",
            \testScriptPreloadManifestInputs());
        addTestCase("existing declaration-contract depfiles remain snapshot inputs",
            \testExistingDeclarationContractSnapshot());
        addTestCase("qo link sidecars and manifest skip", \testQoLinkSidecars());
        addTestCase("script aggregate sidecars and manifest skip", \testScriptAggregateSidecars());

        set_return_value(main());
    }

    private string run(string cmd) {
        return backquote(cmd + " 2>&1");
    }

    private write(string path, string body) {
        File f();
        f.open2(path, O_WRONLY | O_CREAT | O_TRUNC);
        f.write(body);
    }

    private assertContains(string haystack, string needle, string msg) {
        assertTrue(haystack.find(needle) != -1, msg + ": " + haystack);
    }

    testSingleSourceSidecars() {
        TmpDir tmp("qore-aot-qcc-sidecars-");
        string src = tmp.path + "/single.qc";
        string qo = tmp.path + "/single.qo";
        string dep = qo + ".d";
        string idx = qo + ".idx.json";
        string manifest = qo + ".manifest.json";
        string status = qo + ".status.json";
        string success_stamp = qo + ".success.stamp";
        string content_stamp = qo + ".content.stamp";
        string compile_contract_stamp = qo + ".compile-contract.stamp";
        string aggregate_contract_stamp = qo + ".aggregate-contract.stamp";

        write(src, "%new-style
%define QccSidecarContractDefine 1
public class QccSidecarSingle {
    public {
        const C = 41;
    }

    static int f() {
        return C + 1;
    }
}
");

        string cmd = sprintf(
            "%s %s -v -c --parse-option=PO_MODERN --depfile=%s --depfile-target=%s"
            " --write-index-json=%s --write-manifest=%s --skip-if-manifest-current"
            " --write-status-json=%s --success-stamp=%s --content-stamp=%s"
            " --compile-contract-stamp=%s --aggregate-contract-stamp=%s"
            " -o %s %s",
            env, qcc_bin, dep, success_stamp, idx, manifest, status, success_stamp,
            content_stamp, compile_contract_stamp, aggregate_contract_stamp, qo, src);
        string first = run(cmd);
        assertTrue(is_file(qo), "compiled single source .qo: " + first);
        assertTrue(is_file(dep), "wrote single source depfile: " + first);
        assertTrue(is_file(idx), "wrote single source index sidecar: " + first);
        assertTrue(is_file(manifest), "wrote single source manifest: " + first);
        assertTrue(is_file(status), "wrote single source status JSON: " + first);
        assertTrue(is_file(success_stamp), "touched single source success stamp: " + first);
        assertTrue(is_file(content_stamp), "touched single source content stamp: " + first);
        assertTrue(is_file(compile_contract_stamp),
            "wrote single source compile-contract stamp: " + first);
        assertTrue(is_file(aggregate_contract_stamp),
            "wrote single source aggregate-contract stamp: " + first);

        string single_dep_text = File::readTextFile(dep);
        assertTrue(single_dep_text.find(success_stamp + ":") == 0,
            "depfile target names success stamp: " + single_dep_text);
        assertContains(single_dep_text, "single.qc", "depfile names source");
        assertTrue(single_dep_text.find("<builtin>") == -1, "depfile excludes non-file sentinels");
        string index_json = File::readTextFile(idx);
        assertContains(index_json, "\"provides\"", "index JSON has provides");
        assertContains(index_json, "QccSidecarSingle::C", "index JSON has class constant");
        assertContains(index_json, "\"compile_contract_hash\"",
            "index JSON has semantic compile-contract hash");
        assertContains(index_json, "\"aggregate_contract_hash\"",
            "index JSON has aggregate-visible metadata hash");
        string compile_contract = File::readTextFile(compile_contract_stamp);
        assertContains(compile_contract, "native\t",
            "compile contract includes native capability rows");
        assertContains(compile_contract, "QccSidecarSingle::f()",
            "compile contract includes native fast-entry capability");
        assertContains(compile_contract, "source_parse_define",
            "compile contract includes source parse-define context");
        assertContains(compile_contract, "QccSidecarContractDefine=1",
            "compile contract includes source parse-define value");
        string manifest_json = File::readTextFile(manifest);
        assertContains(manifest_json, "\"kind\": \"script-file\"", "manifest records mode");
        assertContains(manifest_json, "\"inputs\"", "manifest records inputs");
        assertContains(manifest_json, aggregate_contract_stamp,
            "manifest records aggregate-contract sidecar");
        string status_json = File::readTextFile(status);
        assertContains(status_json, "\"built\": true", "status records initial build");
        assertContains(status_json, "\"skipped\": false", "status records initial non-skip");
        assertContains(status_json, "\"output_changed\": true", "status records initial content change");
        assertContains(status_json, aggregate_contract_stamp,
            "status records aggregate-contract sidecar");

        string second = run(cmd);
        assertContains(second, "manifest current, skipped script-file",
            "second identical command skips from qcc manifest");
        status_json = File::readTextFile(status);
        assertContains(status_json, "\"built\": false", "status records manifest skip as not built");
        assertContains(status_json, "\"skipped\": true", "status records manifest skip");
        assertContains(status_json, "\"output_changed\": false", "status records skip without content change");

        unlink(content_stamp);
        unlink(compile_contract_stamp);
        unlink(aggregate_contract_stamp);
        string third = run(cmd);
        assertContains(third, "manifest current, skipped script-file",
            "manifest skip creates a missing content-stamp baseline");
        assertTrue(is_file(content_stamp), "manifest skip recreated missing content stamp: " + third);
        assertTrue(is_file(compile_contract_stamp),
            "manifest skip recreated missing compile-contract stamp: " + third);
        assertTrue(is_file(aggregate_contract_stamp),
            "manifest skip recreated missing aggregate-contract stamp: " + third);
        assertContains(File::readTextFile(status), "\"output_changed\": false",
            "status still records no content change when baseline stamp is recreated");

        string contract_before = File::readTextFile(compile_contract_stamp);
        string aggregate_contract_before = File::readTextFile(aggregate_contract_stamp);
        write(src, File::readTextFile(src) + "# semantic no-op\n");
        string comment_rebuild = run(cmd);
        assertEq(contract_before, File::readTextFile(compile_contract_stamp),
            "source-only edit preserves compile contract: " + comment_rebuild);
        assertEq(aggregate_contract_before, File::readTextFile(aggregate_contract_stamp),
            "trailing comment preserves aggregate contract: " + comment_rebuild);

        string shifted = "# shift all source locations\n" + File::readTextFile(src);
        write(src, shifted);
        string location_rebuild = run(cmd);
        assertEq(contract_before, File::readTextFile(compile_contract_stamp),
            "source-location edit preserves compile contract: " + location_rebuild);
        assertNeq(aggregate_contract_before,
            File::readTextFile(aggregate_contract_stamp),
            "source-location edit changes aggregate declaration locations: "
                + location_rebuild);
        string location_aggregate_contract =
            File::readTextFile(aggregate_contract_stamp);

        string body_changed = File::readTextFile(src);
        body_changed =~ s/return C \+ 1/return C + 2/;
        write(src, body_changed);
        string body_rebuild = run(cmd);
        assertNeq(contract_before, File::readTextFile(compile_contract_stamp),
            "native body edit changes compile contract: " + body_rebuild);
        assertEq(location_aggregate_contract,
            File::readTextFile(aggregate_contract_stamp),
            "native body edit preserves declaration-only aggregate contract: "
                + body_rebuild);

        string ranged_body_changed = File::readTextFile(src);
        ranged_body_changed =~ s/        return C \+ 2;/        int ignored = 0;\n        return C + 2;/;
        write(src, ranged_body_changed);
        string aggregate_contract_before_body_range =
            File::readTextFile(aggregate_contract_stamp);
        string body_range_rebuild = run(cmd);
        assertNeq(aggregate_contract_before_body_range,
            File::readTextFile(aggregate_contract_stamp),
            "body line-count edit changes aggregate entry location range: "
                + body_range_rebuild);

        string changed = File::readTextFile(src);
        changed =~ s/const C = 41/const C = 42/;
        write(src, changed);
        string aggregate_contract_before_semantic =
            File::readTextFile(aggregate_contract_stamp);
        string semantic_rebuild = run(cmd);
        assertNeq(contract_before, File::readTextFile(compile_contract_stamp),
            "folded value edit changes compile contract: " + semantic_rebuild);
        assertNeq(aggregate_contract_before_semantic,
            File::readTextFile(aggregate_contract_stamp),
            "folded value edit changes aggregate contract: " + semantic_rebuild);
    }

    testScriptPreloadManifestInputs() {
        TmpDir tmp("qore-aot-qcc-preload-manifest-");
        string provider_src = tmp.path + "/provider.qc";
        string consumer_src = tmp.path + "/consumer.qc";
        string provider_qo = tmp.path + "/provider.qo";
        string provider_compile_contract_stamp = provider_qo
            + ".compile-contract.stamp";
        string preload_dir = tmp.path + "/preload";
        string consumer_qo = tmp.path + "/consumer.qo";
        string dep = consumer_qo + ".d";
        string dep_target = consumer_qo + ".success.stamp";
        string idx = consumer_qo + ".idx.json";
        string manifest = consumer_qo + ".manifest.json";

        write(provider_src, "%new-style
public class QccSidecarProvider {
    public static int value() {
        return 7;
    }
}
");

        write(consumer_src, "%new-style
public class QccSidecarConsumer {
    static int value() {
        return QccSidecarProvider::value();
    }
}
");

        string provider_cmd = sprintf(
            "%s %s -c --parse-option=PO_MODERN --compile-contract-stamp=%s -o %s %s",
            env, qcc_bin, provider_compile_contract_stamp, provider_qo,
            provider_src);
        string provider_out = run(provider_cmd);
        assertTrue(is_file(provider_qo), "compiled provider preload .qo: " + provider_out);
        mkdir(preload_dir);
        run(sprintf("ln %s %s/provider.qo", provider_qo, preload_dir));
        run(sprintf("ln -s %s %s/provider.qo.compile-contract.stamp",
            provider_compile_contract_stamp, preload_dir));

        string consumer_cmd = sprintf(
            "%s %s -v -c -L %s --parse-option=PO_MODERN --depfile=%s --depfile-target=%s"
            " --depfile-compile-contract-stamps"
            " --write-index-json=%s --write-manifest=%s --skip-if-manifest-current"
            " --manifest-skip-qo-library-inputs -o %s %s",
            env, qcc_bin, preload_dir, dep, dep_target, idx, manifest,
            consumer_qo, consumer_src);
        string consumer_out = run(consumer_cmd);
        assertTrue(is_file(consumer_qo), "compiled consumer with preload .qo: " + consumer_out);
        assertTrue(File::readTextFile(dep).find(dep_target + ":") == 0,
            "preload depfile target names override");
        string dep_text = File::readTextFile(dep);
        assertContains(dep_text, provider_compile_contract_stamp,
            "preload depfile uses provider compile contract");
        assertEq(-1, dep_text.find(preload_dir),
            "preload depfile resolves temporary contract symlink");
        assertEq(-1, dep_text.find(provider_src),
            "preload depfile omits provider source covered by exact imports");
        string manifest_json = File::readTextFile(manifest);
        assertTrue(manifest_json.find(sprintf("\"path\": \"%s\",", provider_qo)) == -1,
            "preloaded provider .qo omitted from manifest: " + manifest_json);
        assertContains(manifest_json, provider_compile_contract_stamp,
            "rewritten provider contract is retained in manifest");

        string provider_contract = File::readTextFile(
            provider_compile_contract_stamp);
        string provider_changed = File::readTextFile(provider_src);
        provider_changed =~ s/return 7/return 8/;
        write(provider_src, provider_changed);
        provider_out = run(provider_cmd);
        unlink(preload_dir + "/provider.qo");
        run(sprintf("ln %s %s/provider.qo", provider_qo, preload_dir));
        assertNeq(provider_contract,
            File::readTextFile(provider_compile_contract_stamp),
            "provider semantic change updates its compile contract: "
                + provider_out);
        string changed_consumer = run(consumer_cmd);
        assertEq(-1, changed_consumer.find("manifest current, skipped"),
            "changed provider contract invalidates consumer manifest: "
                + changed_consumer);

        write(provider_src, File::readTextFile(provider_src)
            + "# provider semantic no-op\n");
        provider_out = run(provider_cmd);
        unlink(preload_dir + "/provider.qo");
        run(sprintf("ln %s %s/provider.qo", provider_qo, preload_dir));
        string unchanged_consumer = run(consumer_cmd);
        assertContains(unchanged_consumer, "manifest current, skipped",
            "unchanged provider contract keeps consumer manifest current: "
                + provider_out + unchanged_consumer);

        string explicit_cmd = sprintf(
            "%s %s -c -L %s --parse-option=PO_MODERN --depfile=%s --depfile-target=%s"
            " --depfile-compile-contract-stamps"
            " --write-index-json=%s --write-manifest=%s --skip-if-manifest-current"
            " --manifest-skip-qo-library-inputs --manifest-input=%s -o %s %s",
            env, qcc_bin, tmp.path, dep, dep_target, idx, manifest, provider_qo, consumer_qo,
            consumer_src);
        string explicit_out = run(explicit_cmd);
        assertTrue(is_file(consumer_qo), "compiled consumer with explicit manifest input: " + explicit_out);
        manifest_json = File::readTextFile(manifest);
        assertContains(manifest_json, provider_qo,
            "explicit manifest input records provider .qo");
    }

    # A depfile can outlive the configuration that produced it.  Until qcc has
    # rebuilt and replaced that depfile, every contract prerequisite already in
    # it must be part of the initial input snapshot even when the current command
    # no longer asks qcc to emit declaration-contract dependencies.
    testExistingDeclarationContractSnapshot() {
        TmpDir tmp("qore-aot-qcc-old-declaration-dep-");
        string src = tmp.path + "/consumer.qc";
        string qo = tmp.path + "/consumer.qo";
        string dep = qo + ".d";
        string declaration_stamp = tmp.path
            + "/provider.qo.aggregate-contract.stamp";
        string marker = tmp.path + "/after-input-snapshot.marker";

        write(src, "%new-style\npublic const ExistingDeclarationDep = 1;\n");
        write(declaration_stamp, "before\n");
        write(dep, sprintf("%s: %s %s\n", qo, src, declaration_stamp));

        string out = run(sprintf(
            "{ (i=0; while [ ! -f %s ] && [ $i -lt 500 ]; do sleep 0.01; "
            "i=$((i + 1)); done; [ -f %s ] && printf 'after\\n' > %s) & watcher=$!; "
            "QORE_QCC_TEST_AFTER_INPUT_SNAPSHOT_MARKER=%s "
            "QORE_QCC_TEST_AFTER_INPUT_SNAPSHOT_DELAY_MS=500 "
            "%s %s -c --parse-option=PO_MODERN --depfile=%s "
            "--depfile-compile-contract-stamps -o %s %s; "
            "rc=$?; wait $watcher || rc=$?; echo QCC_RC=$rc; }",
            marker, marker, declaration_stamp, marker, env, qcc_bin, dep, qo, src));
        assertContains(out, "qcc input changed while building",
            "an existing declaration-contract prerequisite is validated: " + out);
        assertContains(out, "QCC_RC=75",
            "a moved existing declaration contract requests a retry: " + out);
    }

    testQoLinkSidecars() {
        TmpDir tmp("qore-aot-qcc-link-sidecars-");
        string provider = tmp.path + "/provider.qc";
        string consumer = tmp.path + "/consumer.qc";
        string provider_qo = tmp.path + "/provider.qo";
        string consumer_qo = tmp.path + "/consumer.qo";
        string provider_content_stamp = provider_qo + ".content.stamp";
        string consumer_content_stamp = consumer_qo + ".content.stamp";
        string aggregate = tmp.path + "/aggregate.qo";
        string dep = aggregate + ".d";
        string idx = aggregate + ".idx.json";
        string link_map = aggregate + ".qolink.json";
        string manifest = aggregate + ".manifest.json";
        string status = aggregate + ".status.json";
        string success_stamp = aggregate + ".success.stamp";
        string content_stamp = aggregate + ".content.stamp";

        write(provider, "%new-style
public class QccSidecarProvider {
    static int f() {
        return 42;
    }
}
");
        write(consumer, "%new-style
public class QccSidecarConsumer {
    static int g() {
        return QccSidecarProvider::f();
    }
}
");

        string provider_out = run(sprintf(
            "%s %s -c --parse-option=PO_MODERN --content-stamp=%s -o %s %s",
            env, qcc_bin, provider_content_stamp, provider_qo, provider));
        assertTrue(is_file(provider_qo), "compiled provider .qo: " + provider_out);
        assertTrue(is_file(provider_content_stamp),
            "compiled provider content stamp: " + provider_out);
        string consumer_out = run(sprintf(
            "%s %s -c -L %s --parse-option=PO_MODERN --content-stamp=%s -o %s %s",
            env, qcc_bin, tmp.path, consumer_content_stamp, consumer_qo, consumer));
        assertTrue(is_file(consumer_qo), "compiled consumer .qo: " + consumer_out);
        assertTrue(is_file(consumer_content_stamp),
            "compiled consumer content stamp: " + consumer_out);

        string cmd = sprintf(
            "%s %s -v --link-qo --aggregate-symbol=QCC_SIDECAR_LINK"
            " --qolink-map=%s --depfile=%s --depfile-target=%s"
            " --depfile-qo-input-content-stamps --write-index-json=%s"
            " --write-manifest=%s --skip-if-manifest-current"
            " --write-status-json=%s --success-stamp=%s --content-stamp=%s"
            " -o %s %s %s",
            env, qcc_bin, link_map, dep, success_stamp, idx, manifest, status, success_stamp,
            content_stamp, aggregate, provider_qo, consumer_qo);
        string first = run(cmd);
        assertTrue(is_file(aggregate), "linked aggregate .qo: " + first);
        assertTrue(is_file(link_map), "wrote link map: " + first);
        assertTrue(is_file(dep), "wrote qo-link depfile: " + first);
        assertTrue(is_file(idx), "wrote qo-link index sidecar: " + first);
        assertTrue(is_file(manifest), "wrote qo-link manifest: " + first);
        assertTrue(is_file(status), "wrote qo-link status JSON: " + first);
        assertTrue(is_file(success_stamp), "touched qo-link success stamp: " + first);
        assertTrue(is_file(content_stamp), "touched qo-link content stamp: " + first);

        string dep_text = File::readTextFile(dep);
        assertTrue(dep_text.find(success_stamp + ":") == 0,
            "qo-link depfile target names success stamp: " + dep_text);
        assertContains(dep_text, provider_content_stamp,
            "qo-link depfile names provider content stamp");
        assertContains(dep_text, consumer_content_stamp,
            "qo-link depfile names consumer content stamp");
        assertTrue(dep_text.find("<builtin>") == -1, "qo-link depfile excludes non-file sentinels");
        string map_text = File::readTextFile(link_map);
        assertContains(map_text, "\"resolved_call_relocations\"", "link map records relocations");
        assertContains(File::readTextFile(manifest), "\"kind\": \"link-qo\"",
            "manifest records qo-link mode");
        assertContains(File::readTextFile(status), "\"output_changed\": true",
            "qo-link status records initial content change");

        string second = run(cmd);
        assertContains(second, "manifest current, skipped qo link aggregate",
            "second identical qo-link command skips from qcc manifest");
        assertContains(File::readTextFile(status), "\"skipped\": true",
            "qo-link status records manifest skip");
    }

    testScriptAggregateSidecars() {
        TmpDir tmp("qore-aot-qcc-script-agg-sidecars-");
        string provider = tmp.path + "/provider.qr";
        string consumer = tmp.path + "/consumer.qr";
        string aggregate = tmp.path + "/script-aggregate.qo";
        string dep = aggregate + ".d";
        string idx = aggregate + ".idx.json";
        string manifest = aggregate + ".manifest.json";
        string status = aggregate + ".status.json";
        string success_stamp = aggregate + ".success.stamp";
        string content_stamp = aggregate + ".content.stamp";

        write(provider, "%modern
public class QccScriptAggProvider {
    static int f() {
        return 42;
    }
}
");
        write(consumer, "%modern
int sub main() {
    return QccScriptAggProvider::f();
}
");

        string cmd = sprintf(
            "%s %s -v -c --script-aggregate=QCC_SCRIPT_AGG"
            " --depfile=%s --depfile-target=%s --write-index-json=%s --write-manifest=%s"
            " --skip-if-manifest-current"
            " --write-status-json=%s --success-stamp=%s --content-stamp=%s"
            " -o %s %s %s",
            env, qcc_bin, dep, success_stamp, idx, manifest, status, success_stamp, content_stamp,
            aggregate, provider, consumer);
        string first = run(cmd);
        assertTrue(is_file(aggregate), "compiled script aggregate .qo: " + first);
        assertTrue(is_file(dep), "wrote script aggregate depfile: " + first);
        assertTrue(is_file(idx), "wrote script aggregate index sidecar: " + first);
        assertTrue(is_file(manifest), "wrote script aggregate manifest: " + first);
        assertTrue(is_file(status), "wrote script aggregate status JSON: " + first);
        assertTrue(is_file(success_stamp), "touched script aggregate success stamp: " + first);
        assertTrue(is_file(content_stamp), "touched script aggregate content stamp: " + first);

        string dep_text = File::readTextFile(dep);
        assertTrue(dep_text.find(success_stamp + ":") == 0,
            "script aggregate depfile target names success stamp: " + dep_text);
        assertContains(dep_text, "provider.qr", "script aggregate depfile names provider source");
        assertContains(dep_text, "consumer.qr", "script aggregate depfile names consumer source");
        assertTrue(dep_text.find("<builtin>") == -1, "script aggregate depfile excludes non-file sentinels");
        assertContains(File::readTextFile(idx), "QccScriptAggProvider",
            "script aggregate index includes provider class");
        assertContains(File::readTextFile(manifest), "\"kind\": \"script-aggregate\"",
            "manifest records script aggregate mode");
        assertContains(File::readTextFile(status), "\"output_changed\": true",
            "script aggregate status records initial content change");

        string second = run(cmd);
        assertContains(second, "manifest current, skipped script aggregate",
            "second identical script aggregate command skips from qcc manifest");
        assertContains(File::readTextFile(status), "\"skipped\": true",
            "script aggregate status records manifest skip");
    }
}
