#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - every check runs a script in a child process that sets its own --exec-mode, or AOT

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../ExecModeHarness.qm

%exec-class TempReleasePointsTest

#! issues #5712, #5801: the release point of a value read from a local when the statement writes the local later
/** The IR interpreter and native code held a read of a local until the end of its statement, also when the statement
    wrote the local later, and a list or hash literal or the value of an operator passed to a call until then as well;
    the AST interpreter borrows the value from the variable and releases an argument when the call returns, so that
    the write destroys the value: f((o,)) + (o = NOTHING) + mark() and o.n + (o = NOTHING) + mark() destroy the object
    before mark() runs (see design/temporary-lifetime.md).

    The script next to the test runs in every execution mode, on the IR tier and as AOT executables, and its output,
    which shows each destruction, must be that of the AST interpreter.
*/
class TempReleasePointsTest inherits QUnit::Test {
    public {
        #! the script
        const Script = "release-cases";
    }

    private {
        string qore_bin;
        string qcc_bin;
        string env;
    }

    constructor() : QUnit::Test("temporary release points", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        string libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
            ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");
        env = sprintf("LD_LIBRARY_PATH=%s QORE_LIBDIR=%s", libqore_dir, libqore_dir);

        addTestCase("AST semantics", \astTest());
        addTestCase("execution modes", \modesTest());
        addTestCase("AOT executables", \aotTest());
        set_return_value(main());
    }

    #! checks the output of the AST interpreter
    private astTest() {
        string out = astOutput();
        assertEq(52, (select out.split("\n"), $1 =~ /^[a-z][a-z ]*:$/).size(), "cases");
        assertTrue(out =~ /^list literal:\n  dtor lit\n  mark lit\n/, "list literal");
        assertTrue(out =~ /\nmember:\n  dtor mem\n  mark mem\n/, "member");
        assertTrue(out =~ /\nno write:\n  mark nw\n  dtor nw\n/, "no write");
        assertTrue(out =~ /\nremove receiver:\n  mark rr\n  dtor rr\n/, "receiver of a chain");
        assertTrue(out =~ /\noperand of plus:\n  mark op\n  dtor op\n/, "operand of an operator");
        assertTrue(out =~ /\noperand of equals:\n  mark eq\n  dtor eq\n/, "operand of equals");
        assertTrue(out =~ /\noperand of and:\n  mark and\n  dtor and\n/, "operand of and");
        assertTrue(out =~ /\ntwo operands:\n  mark two\n  dtor r\n  dtor l\n/, "two operands, right first");
        assertTrue(out =~ /\noperand in map:\n  mark m1\n  dtor m1\n  mark m2\n  dtor m2\n/, "operand in map");
        assertTrue(out =~ /\noperand exception:\n  dtor arg\n  dtor op\n  ! X\n/, "operand and an exception");
        assertTrue(out =~ /\ncondition:\n  mark q\n  dtor q\n/, "condition of ?:");
        assertTrue(out =~ /\noperand of keys:\n  mark k\n  dtor k\n/, "operand of keys");
        assertTrue(out =~ /\nkeys source hash:\n  mark ksh\n  dtor ksh\n/, "keys of a hash as a functional source");
        assertTrue(out =~ /\noperand of index:\n  mark ix\n  dtor ix\n/, "an index");
        assertTrue(out =~ /\nkeys source object:\n  mark kso\n  dtor kso\n/, "keys of an object as a functional source");
        assertTrue(out =~ /\noperand of float compare:\n  mark lt\n  dtor lt\n/, "operand of a float comparison");
        assertTrue(out =~ /\nfloat compare exception:\n  dtor arg\n  dtor gt\n  ! X\n/, "float comparison and an exception");
        assertTrue(out =~ /\ntry block:\n  dtor try\n  mark try\n/, "try block");
        assertTrue(out =~ /\nbranch:\n  dtor br\n  mark br\n/, "branch");
        # the value of a cast, of hash - key and of map, select and foldl given to a call (qore#5801)
        assertTrue(out =~ /\ncast list:\n  dtor castl\n  mark castl\n/, "cast to a list");
        assertTrue(out =~ /\ncast hashdecl:\n  dtor casth\n  mark casth\n/, "cast to a hashdecl");
        assertTrue(out =~ /\nhash minus key:\n  dtor hmk\n  mark hmk\n/, "hash - key");
        assertTrue(out =~ /\nmap:\n  dtor map\n  mark map\n/, "map");
        assertTrue(out =~ /\nselect:\n  dtor sel\n  mark sel\n/, "select");
        assertTrue(out =~ /\nfoldl:\n  dtor fold1\n  dtor fold2\n  mark fold\n/, "foldl");
    }

    #! runs the script in every execution mode and on the IR tier
    private modesTest() {
        string exp = astOutput();
        foreach string mode in (ExecModeHarness::ExecModes) {
            if (mode == "ast") {
                continue;
            }
            assertEq(exp, ExecModeHarness::run(sprintf("%s %s --exec-mode=%s %s", env, qore_bin, mode, scriptPath())),
                mode);
        }
        assertEq(exp, ExecModeHarness::run_ir_tier(sprintf("%s %s --exec-mode=tiered %s", env, qore_bin,
            scriptPath())), ExecModeHarness::IRTierName);
    }

    #! compiles the script with qcc -O0 and -O3 and checks that the executables give the output of the AST
    #! interpreter
    private aotTest() {
        if (!is_file(qcc_bin)) {
            testSkip("qcc is not available at " + qcc_bin);
        }
        string exp = astOutput();
        TmpDir dir("temp-release-points-aot-");
        foreach string opt in ("-O0", "-O3") {
            string exe = sprintf("%s/%s%s", dir.path, Script, opt);
            string out = ExecModeHarness::run_any(sprintf("%s %s %s -o %s %s", env, qcc_bin, opt, exe, scriptPath()));
            assertTrue(is_file(exe), sprintf("%s: qcc compiles the script: %s", opt, out));
            assertEq(exp, ExecModeHarness::run_any(sprintf("%s %s", env, exe)), "AOT " + opt);
        }
    }

    private string scriptPath() {
        return get_script_dir() + "/" + Script + ".q";
    }

    #! the output of the script with the AST interpreter
    private string astOutput() {
        return ExecModeHarness::run(sprintf("%s %s --exec-mode=ast %s", env, qore_bin, scriptPath()));
    }
}
