%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../ExecModeHarness.qm
%requires ../TestInterpreter.qm

%include JITReloadChainFlush.qc

%exec-class JITReloadChainFlushPart5

#! runs part 5 of 5 of the cases of JITReloadChainFlushBase: the results in executables made by qcc -O0 and -O3
class JITReloadChainFlushPart5 inherits JITReloadChainFlushBase {
    constructor() : JITReloadChainFlushBase("JITReloadChainFlushPart5", 5) {
    }
}
