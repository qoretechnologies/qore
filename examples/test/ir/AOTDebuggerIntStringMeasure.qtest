#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (c) 2026 Qore Technologies, s.r.o.
# SPDX-License-Identifier: MIT

/*  The IR rewrites the decimal width of a proven integer (string(i).size(), i.toString().strlen(),
    obj.format(i).length() for a method returning string(i)) into an allocation-free measurement of the native
    integer.  In a program that allows the debugger, a reflective frame keeps a parameter that is read after an
    instruction that may reflect, and every body local, in its runtime slot, so its LLVM value is a NaN-boxed int
    although its IR facts are those of a native int; the lowering refused the boxed operand, and qcc failed with
    "integer string measurement requires a native integer; IR opcode ToString", as in the Qorus server build.
*/

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil

%exec-class AOTDebuggerIntStringMeasureTest

class AOTDebuggerIntStringMeasureTest inherits QUnit::Test {
    public {
        const ModuleName = "AOTDebuggerIntStringMeasureMod";

        const Classes = "final class DismFormatter {
    string format(int value) {
        return string(value);
    }
}

class DismMeasure {
    static int other(hash<auto> h, list<string> kl, hash<auto> w, int max, int k, string err, string desc) {
        return h.size() + kl.size() + w.size() + max + k + err.size() + desc.size();
    }

    # a parameter read after a call that may reflect
    static int bytes(int dispatch_id, hash<auto> prepared_update) {
        if (dispatch_id <= 0 || dispatch_id.toString().strlen() > 14) {
            throw \"ERR\", \"invalid\";
        }
        return DismMeasure::other(prepared_update, (\"a\", \"b\"), {\"status\": 20}, 100, 15, \"ERR\", \"desc\");
    }

    # a parameter measured after a call that may reflect
    static int after(int value, hash<auto> h) {
        int base = DismMeasure::other(h, (\"a\",), {}, 1, 2, \"e\", \"d\");
        return base + string(value).size() + value.toString().length();
    }

    # a body local of a reflective frame
    static int local(int value, hash<auto> h) {
        int doubled = value * 2;
        int width = string(doubled).size();
        return width + DismMeasure::other(h, (), {}, 0, 0, \"\", \"\") + doubled.toString().strlen();
    }

    # the object method form, with a parameter and a body local as its argument
    static int object(int value, DismFormatter formatter, hash<auto> h) {
        int base = DismMeasure::other(h, (), {}, 0, 0, \"\", \"\");
        int shifted = value - 7;
        return base + formatter.format(value).length() + formatter.format(shifted).size();
    }
}
";

        const Main = "foreach int value in ((1, 9, 10, 12345678901234, 123456789012345, 9223372036854775807)) {
    try {
        printf(\"bytes %d: %d\\n\", value, DismMeasure::bytes(value, {\"a\": 1}));
    } catch (hash<ExceptionInfo> ex) {
        printf(\"bytes %d: %s\\n\", value, ex.err);
    }
}
try {
    DismMeasure::bytes(0, {});
} catch (hash<ExceptionInfo> ex) {
    printf(\"bytes 0: %s\\n\", ex.err);
}
foreach int value in ((-9223372036854775807 - 1, -1000, -1, 0, 1, 999, 1000, 9223372036854775807)) {
    printf(\"after %d: %d\\n\", value, DismMeasure::after(value, {\"x\": 1}));
    printf(\"local %d: %d\\n\", value, DismMeasure::local(value / 4, {}));
    printf(\"object %d: %d\\n\", value, DismMeasure::object(value / 2, new DismFormatter(), {\"y\": 2}));
}
";
    }

    private {
        string qore_bin;
        string qcc_bin;
        string libqore_dir;
    }

    constructor() : QUnit::Test("AOTDebuggerIntStringMeasureTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
            ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");

        addTestCase("integer string measurement in a debuggable executable compiles and matches AST",
            \testExecutable());
        addTestCase("integer string measurement in a debuggable module compiles and matches AST", \testModule());
        addTestCase("integer string measurement without the debugger still compiles and matches AST",
            \testNoDebugger());

        set_return_value(main());
    }

    private static string quote(string value) {
        return "'" + replace(value, "'", "'\"'\"'") + "'";
    }

    private string env(*string module_dir) {
        string rv = sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s QORE_LIBDIR=%s ", quote(libqore_dir),
            quote(libqore_dir), quote(libqore_dir));
        if (module_dir) {
            rv += "QORE_MODULE_DIR=" + quote(module_dir + (ENV.QORE_MODULE_DIR ? ":" + ENV.QORE_MODULE_DIR : ""))
                + " ";
        }
        return rv;
    }

    private string run(string cmd, reference<int> status) {
        return backquote(cmd + " 2>&1", \status);
    }

    private static write(string path, string body) {
        File f();
        f.open2(path, O_WRONLY | O_CREAT | O_TRUNC, 0644);
        f.write(body);
    }

    private string moduleSource() {
        return sprintf("%%modern\n%%allow-debugger\nmodule %s {\n    version = \"1.0\";\n"
            "    desc = \"AOT debugger integer string measurement regression\";\n"
            "    author = \"Qore Technologies, s.r.o.\";\n    url = \"https://qore.org\";\n    license = \"MIT\";\n}\n\n",
            ModuleName)
            + regex_subst(Classes, "^(final )?class ", "public $1class ", RE_MultiLine | RE_Global);
    }

    private string astBaseline(string src, *string module_dir) {
        int status;
        string ast_out = run(env(module_dir) + quote(qore_bin) + " --exec-mode=ast " + quote(src), \status);
        assertEq(0, status, ast_out);
        # the baseline must exercise every shape, including the exception path
        assertRegex("bytes 0: ERR\n", ast_out);
        assertRegex("bytes 123456789012345: ERR\n", ast_out);
        assertRegex("bytes 12345678901234: 126\n", ast_out);
        assertRegex("after -9223372036854775808: 47\n", ast_out);
        assertRegex("object 9223372036854775807: 39\n", ast_out);
        return ast_out;
    }

    private compileExecutable(string header, string tmp_path) {
        string src = tmp_path + "/prog.qr";
        write(src, header + Classes + Main);
        string ast_out = astBaseline(src);

        foreach string level in (("-O0", "-O3")) {
            int status;
            string exe = tmp_path + "/prog" + level;
            string compile_out = run(env() + quote(qcc_bin) + " " + level + " -o " + quote(exe) + " " + quote(src),
                \status);
            assertEq(0, status, compile_out);
            assertTrue(is_file(exe), "executable compiled: " + compile_out);
            string out = run(env() + quote(exe), \status);
            assertEq(0, status, out);
            assertEq(ast_out, out, "AOT executable " + level);
        }
    }

    testExecutable() {
        TmpDir tmp("qore-aot-debugger-int-string-measure-exe-");
        compileExecutable("%modern\n%allow-debugger\n", tmp.path);
    }

    testNoDebugger() {
        TmpDir tmp("qore-aot-int-string-measure-exe-");
        compileExecutable("%modern\n", tmp.path);
    }

    testModule() {
        TmpDir tmp("qore-aot-debugger-int-string-measure-mod-");
        string src_dir = tmp.path + "/src";
        mkdir(src_dir);
        string module_src = src_dir + "/" + ModuleName + ".qm";
        write(module_src, moduleSource());
        string probe = tmp.path + "/probe.qr";
        write(probe, sprintf("%%modern\n%%allow-debugger\n%%requires %s\n", ModuleName) + Main);
        string ast_out = astBaseline(probe, src_dir);

        foreach string level in (("-O0", "-O3")) {
            int status;
            string mod_dir = tmp.path + "/qmod" + level;
            mkdir(mod_dir);
            string qmod = mod_dir + "/" + ModuleName + ".qmod";
            string compile_out = run(env(src_dir) + quote(qcc_bin) + " " + level + " --module -o " + quote(qmod)
                + " " + quote(module_src), \status);
            assertEq(0, status, compile_out);
            assertTrue(is_file(qmod), "module compiled: " + compile_out);
            # only the AOT image can satisfy the module requirement
            string out = run(env(mod_dir) + quote(qore_bin) + " " + quote(probe), \status);
            assertEq(0, status, out);
            assertEq(ast_out, out, "AOT module " + level);
        }
    }
}
