#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
string libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
string qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
    ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");

string root = "/tmp/qore-aot-optional-scalar-fast-entry-" + string(getpid());
string enabled_dir = root + "/enabled";
string disabled_dir = root + "/disabled";
mkdir(root);
mkdir(enabled_dir);
mkdir(disabled_dir);

string source_path = root + "/optional-scalar.qr";
string runner_path = root + "/optional-scalar-runner.q";
string source = "%modern

int sub scale(int value, int factor) {
    return value * factor + 3;
}

float sub affine(float value, float factor) {
    return value * factor + 0.5;
}

bool sub combine(bool value, bool invert) {
    return invert ? !value : value;
}

int sub runInt(int iterations, *int factor) {
    int result = 0;
    for (int i = 0; i < iterations; ++i) {
        result += scale(i % 10, factor);
    }
    return result;
}

float sub runFloat(*float factor) {
    return affine(2.0, factor);
}

bool sub runBool(*bool invert) {
    return combine(True, invert);
}

int sub runAssigned(int iterations) {
    *int factor = 3;
    int result = 0;
    for (int i = 0; i < iterations; ++i) {
        factor = (i & 1) ? 4 : 5;
        result += scale(i % 10, factor);
    }
    return result;
}

bool sub nothingFails() {
    *int factor = NOTHING;
    try {
        scale(2, factor);
    } catch (hash<auto> ex) {
        return True;
    }
    return False;
}

bool sub removedFails() {
    *int factor = 4;
    remove factor;
    try {
        scale(2, factor);
    } catch (hash<auto> ex) {
        return True;
    }
    return False;
}

*int sub removedValue() {
    *int factor = 4;
    remove factor;
    return factor;
}

*int sub maybeRemoved(bool remove_value) {
    *int factor = 5;
    if (remove_value) {
        remove factor;
    }
    return factor;
}

int sub overloaded(int value) {
    return value + 1;
}

string sub overloaded(string value) {
    return value + \"!\";
}

auto sub callOverloaded(auto value) {
    return overloaded(value);
}

int sub main() {
    printf(\"%d:%.1f:%d:%d:%d:%d:%d:%d:%d:%s\\n\", runInt(100, 4), runFloat(1.5),
        runBool(True), runBool(False), runAssigned(100), nothingFails(),
        removedFails(), removedValue() === NOTHING,
        maybeRemoved(True) === NOTHING, callOverloaded(3));
    return 0;
}
";

File source_file();
source_file.open2(source_path, O_WRONLY | O_CREAT | O_TRUNC, 0755);
source_file.write(source);
source_file.close();
File runner_file();
runner_file.open2(runner_path, O_WRONLY | O_CREAT | O_TRUNC, 0755);
runner_file.write(source + "\nmain();\n");
runner_file.close();

string env = sprintf("LD_LIBRARY_PATH=%s", libqore_dir);
string ast = backquote(sprintf("%s %s --exec-mode=ast %s 2>&1",
    env, qore_bin, runner_path));
string enabled_compile = backquote(sprintf(
    "%s QORE_AOT_DEBUG=1 %s -O3 -c --output-dir=%s %s 2>&1",
    env, qcc_bin, enabled_dir, source_path));
string disabled_compile = backquote(sprintf(
    "%s QORE_DISABLE_AOT_OPTIONAL_SCALAR_FAST_ENTRY=1"
        + " %s -O3 -c --output-dir=%s %s 2>&1",
    env, qcc_bin, disabled_dir, source_path));
string enabled_qo = enabled_dir + "/optional-scalar.qo";
string disabled_qo = disabled_dir + "/optional-scalar.qo";
if (!is_file(enabled_qo) || !is_file(disabled_qo)) {
    printf("compile failed:\nenabled:\n%sdisabled:\n%s",
        enabled_compile, disabled_compile);
    exit(2);
}
if (!(enabled_compile =~ /eliding fast-entry argument NOTHING guard/)) {
    printf("assigned-state argument guard was not elided:\n%s", enabled_compile);
    exit(2);
}

string enabled_exe = root + "/enabled-aot";
string disabled_exe = root + "/disabled-aot";
string enabled_link = backquote(sprintf("%s %s -O3 -o %s %s 2>&1",
    env, qcc_bin, enabled_exe, enabled_qo));
string disabled_link = backquote(sprintf("%s %s -O3 -o %s %s 2>&1",
    env, qcc_bin, disabled_exe, disabled_qo));
if (!is_file(enabled_exe) || !is_file(disabled_exe)) {
    printf("link failed:\nenabled:\n%sdisabled:\n%s", enabled_link, disabled_link);
    exit(2);
}

string enabled = backquote(sprintf("%s %s 2>&1", env, enabled_exe));
string disabled = backquote(sprintf("%s %s 2>&1", env, disabled_exe));
if (ast != enabled || ast != disabled) {
    printf("execution mismatch:\nAST:\n%sEnabled:\n%sDisabled:\n%s",
        ast, enabled, disabled);
    exit(2);
}
