#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

# Copyright (C) 2003 - 2026 Qore Technologies, s.r.o.

# Regression test for issue #5352: JIT-compiled native code must emit
# statement-boundary debug events (dbgStep) when a debugger attaches.
#
# The companion fixture JitDebugStepScenario.qr runs its top-level block as
# JIT-compiled native code, attaches a debugger to it mid-execution from a worker
# thread, and reports whether a breakpoint fired and which statement lines were
# single-stepped.  Before the fix the JIT lowered the DebugBlock opcode to a
# no-op, so native code produced no debug events at all (breakpoints, single-step
# and line coverage were all blind to JIT-compiled frames).

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit

%exec-class JitDebugStepTest

class JitDebugStepTest inherits QUnit::Test {
    private {
        string qore_bin;
        string scenario;
    }

    constructor() : QUnit::Test("JitDebugStepTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        scenario = get_script_dir() + DirSep + "JitDebugStepScenario.qr";
        addTestCase("breakpoint fires in JIT-compiled code", \testBreakpoint());
        addTestCase("single-step reports JIT statement lines", \testSingleStep());
        set_return_value(main());
    }

    private hash<auto> runScenario(string mode) {
        string cmd = sprintf("%s --enable-debug %s %s 2>&1",
            qore_bin, scenario, mode);
        string out = backquote(cmd);
        # Parse "key=value" lines into a hash.
        hash<auto> h;
        foreach string line in (out.split("\n")) {
            line = trim(line);
            if (line.empty()) {
                continue;
            }
            *list<string> kv = (line =~ x/^([^=]+)=(.*)$/);
            if (kv) {
                h{kv[0]} = kv[1];
            }
        }
        h.raw = out;
        return h;
    }

    testBreakpoint() {
        hash<auto> h = runScenario("break");
        on_error printf("scenario output:\n%s\n", h.raw);
        assertEq(NOTHING, h.error, "scenario reported no error");
        # acc = 7 + 13 + 100 = 120 — correct result even with the debugger attached
        assertEq("120", h.result, "JIT-compiled code produced the correct result");
        # The breakpoint, set on a statement executed as native code after the
        # mid-execution attach, must fire — this is the core of issue #5352.
        assertEq("1", h."bp_hits", "breakpoint fired in JIT-compiled native code");
        assertEq(h.marker, h.steps,
            "the single step event is the breakpointed statement line");
    }

    testSingleStep() {
        hash<auto> h = runScenario("step");
        on_error printf("scenario output:\n%s\n", h.raw);
        assertEq(NOTHING, h.error, "scenario reported no error");
        assertEq("120", h.result, "JIT-compiled code produced the correct result");
        assertEq("1", h."bp_hits", "breakpoint fired in JIT-compiled native code");

        list<int> lines = (map $1.toInt(), h.steps.split(","));
        # Three consecutive statements in the stepping region were single-stepped
        # as native code.
        assertEq(3, lines.size(), "three statement step events were reported");
        int marker = h.marker.toInt();
        assertEq(marker, lines[0], "first step is the breakpointed statement");
        # Lines must be strictly increasing and consecutive (one per statement).
        for (int i = 1; i < lines.size(); ++i) {
            assertEq(lines[i - 1] + 1, lines[i],
                sprintf("step %d reports the next consecutive source line", i));
        }
    }
}
