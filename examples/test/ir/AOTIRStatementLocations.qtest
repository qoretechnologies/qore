#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - native AOT IR encoding and decoding of the runtime locations of IR instructions
# Copyright (C) 2026 Qore Technologies, s.r.o.
# SPDX-License-Identifier: LGPL-2.1-or-later

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires ../TestInterpreter.qm

%exec-class AOTIRStatementLocationsTest

#! qore#6646: AOT images record the runtime locations of IR instructions
/** Runs qore-aot-ir-statement-locations-test (aot_ir_statement_locations.cpp): the locations of the statements of an
    IR function written by the AOT writer are read back with the same sharing, an instruction without one has none,
    the two marks that a PushTempMarkPair is written as have the pair's, and an image predating statement locations
    is refused.  The malformed encodings are checked
    by AOTIRInstructionValidation.qtest.
*/
class AOTIRStatementLocationsTest inherits QUnit::Test {
    constructor() : Test("AOT IR statement locations", "1.0", \ARGV) {
        addTestCase("statement locations of IR read from an AOT image", \nativeCheck());
        set_return_value(main());
    }

    private nativeCheck() {
        string native = ENV.QORE_AOT_IR_STATEMENT_LOCATIONS_TEST
            ?? dirname(TestInterpreter::qore_interpreter()) + "/qore-aot-ir-statement-locations-test";
        if (!is_file(native)) {
            testSkip("the native AOT IR statement location test executable is not available");
            return;
        }
        string prefix;
        foreach string name in (("LD_LIBRARY_PATH", "DYLD_LIBRARY_PATH")) {
            if (ENV{name}) { # live-provider-optin: LD_LIBRARY_PATH and DYLD_LIBRARY_PATH for the child command
                # live-provider-optin: LD_LIBRARY_PATH and DYLD_LIBRARY_PATH for the child command
                prefix += name + "=" + shellQuote(ENV{name}) + " ";
            }
        }
        int rc;
        string output = backquote(prefix + shellQuote(native) + " 2>&1", \rc);
        assertEq(0, rc, output);
        assertEq("PASS: 22 AOT IR statement location checks\n", output);
    }

    private static string shellQuote(string value) {
        return "'" + replace(value, "'", "'\"'\"'") + "'";
    }
}
