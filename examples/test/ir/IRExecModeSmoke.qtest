    testIrMiscOperatorSmoke() {
        string qore_bin = QORE_ARGV[0] ?? ARGV[0] ?? NOTHING;
        if (!qore_bin || qore_bin == NOTHING) {
            testSkip("no qore binary path available");
            return;
        }

        TmpFile script();
        script.file.write("%new-style\n%modern\n");
        script.file.write("string s = \"  hello  \\n\";\n");
        script.file.write("string t = trim(s);\n");
        script.file.write("chomp s;\n");
        script.file.write("string u = s =~ tr/a-z/A-Z/;\n");
        script.file.write("bool nmatch = (\"hello\" !~ /123/);\n");
        script.file.write("bool inst = (t instanceof string);\n");
        script.file.write("int pid = background trim(s);\n");
        script.file.write("(int a, string b) = (1, \"ok\");\n");
        script.file.write("printf(\"t:%s s:%s u:%s n:%d i:%d a:%d b:%s pid:%d\\n\", t, s, u, nmatch, inst, a, b, pid);\n");
        script.file.close();

        TmpFile out();
        TmpFile err();

        string cmd = sprintf("%s --exec-mode=ir %s > %s 2> %s",
            qore_bin, script.path, out.path, err.path);
        int rc = runCommand(cmd, script.path);
        string err_output = ReadOnlyFile::readTextFile(err.path);
        if (rc != 0 && err_output =~ /exec-mode/ && err_output =~ /valid long option/) {
            testSkip("exec-mode option not supported by test qore binary");
            return;
        }

        assertEq(0, rc, "IR exec mode process should exit cleanly");
        assertFalse(err_output =~ /IR exec fallback to AST:/, "Unexpected IR fallback warning");

        string stdout_output = ReadOnlyFile::readTextFile(out.path);
        assertTrue(stdout_output =~ /t:hello/, "Expected trim output in exec-mode");
        assertTrue(stdout_output =~ /n:1/, "Expected regex nmatch output in exec-mode");
        assertTrue(stdout_output =~ /i:1/, "Expected instanceof output in exec-mode");
        assertTrue(stdout_output =~ /a:1/, "Expected list assignment output in exec-mode");
        assertTrue(stdout_output =~ /b:ok/, "Expected list assignment output in exec-mode");
        assertTrue(stdout_output =~ /pid:[0-9]+/, "Expected background output in exec-mode");
    }

