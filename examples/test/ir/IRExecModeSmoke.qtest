        script.file.write("int sum = l[0] + l[1] + l[2];\n");
        script.file.write("printf(\"cast:%d:%s\\n\", sum, maybe == NOTHING ? \"nothing\" : \"bad\");\n");
        script.file.close();

        TmpFile out();
        TmpFile err();

