        script.file.write("    printf(\"rangeslice-seq:bad\\n\");\n");
        script.file.write("} catch (ex) {\n");
        script.file.write("    printf(\"rangeslice-seq:caught\\n\");\n");
        script.file.write("}\n");
        script.file.close();

