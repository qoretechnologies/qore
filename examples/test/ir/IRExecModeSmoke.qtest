    private string makeFailPrefix() {
        ++fail_counter;
        return sprintf("/tmp/ir-exec-fail-%d-%d", getpid(), fail_counter);
    }

    private preserveFailure(string cmd, string script_path, *string out_path, *string err_path,
            *string time_path) {
        string prefix = makeFailPrefix();
        if (script_path && path_exists(script_path)) {
            try {
                copy_file(script_path, prefix + ".q", False, True);
            } catch (hash<ExceptionInfo> err) {
            }
        }
        if (out_path && path_exists(out_path)) {
            try {
                copy_file(out_path, prefix + ".out", False, True);
            } catch (hash<ExceptionInfo> err) {
            }
        }
        if (err_path && path_exists(err_path)) {
            try {
                copy_file(err_path, prefix + ".err", False, True);
            } catch (hash<ExceptionInfo> err) {
            }
        }
        if (time_path && path_exists(time_path)) {
            try {
                copy_file(time_path, prefix + ".time", False, True);
            } catch (hash<ExceptionInfo> err) {
            }
        }
        printf("Preserved failing artifacts: %s{.q,.out,.err,.time}\n", prefix);
        printf("CMD: %s\n", cmd);
    }

    private int runCommand(string cmd, string script_path, int expect_rc = 0) {
        int timeout_s = 120;
        int mem_limit_kb = 4 * 1024 * 1024; # 4 GB virtual memory limit
        # GNU time uses -v for verbose; macOS/BSD time uses -l
        *string time_bin = path_exists("/usr/bin/time") ? "/usr/bin/time" : NOTHING;
        string time_flag = PlatformOS == "Darwin" ? "-l" : "-v";
        TmpFile time_log();
        string wrapped_cmd = sprintf("ulimit -v %d >/dev/null 2>&1; exec %s", mem_limit_kb, cmd);
        *string out_path = NOTHING;
        *string err_path = NOTHING;
        int err_pos = rindex(cmd, " 2> ");
        int out_pos = rindex(cmd, " > ");
        if (err_pos >= 0) {
            err_path = trim(cmd.substr(err_pos + 4));
        }
        if (out_pos >= 0 && (err_pos < 0 || out_pos < err_pos)) {
            int end_pos = err_pos >= 0 ? err_pos : cmd.size();
            out_path = trim(cmd.substr(out_pos + 3, end_pos - (out_pos + 3)));
        }

        if (path_exists("/usr/bin/timeout")) {
            string wrapped = time_bin
                ? sprintf("/usr/bin/timeout -k 5s %ds %s %s /bin/sh -c %y 2> %s",
                    timeout_s, time_bin, time_flag, wrapped_cmd, time_log.path)
                : sprintf("/usr/bin/timeout -k 5s %ds /bin/sh -c %y",
                    timeout_s, wrapped_cmd);
            int rc = system(wrapped);
            if (rc == 124 || rc == 137) {
                printf("IR exec-mode command timed out (%ds)\n", timeout_s);
                printf("CMD: %s\n", cmd);
            }
            if (time_bin && rc != expect_rc) {
                printf("Resource usage (time %s):\n%s\n", time_flag,
                    ReadOnlyFile::readTextFile(time_log.path) ?? "no time output");
                preserveFailure(cmd, script_path, out_path, err_path, time_log.path);
            }
            return rc;
        }
        if (time_bin) {
            string wrapped = sprintf("%s %s /bin/sh -c %y 2> %s",
                time_bin, time_flag, wrapped_cmd, time_log.path);
            int rc = system(wrapped);
            if (rc != expect_rc) {
                printf("Resource usage (time %s):\n%s\n", time_flag,
                    ReadOnlyFile::readTextFile(time_log.path) ?? "no time output");
                preserveFailure(cmd, script_path, out_path, err_path, time_log.path);
            }
            return rc;
        }
        int rc = system(cmd);
        if (expect_rc != 0 && rc != expect_rc) {
            preserveFailure(cmd, script_path, out_path, err_path, NOTHING);
        }
        return rc;
    }

    testIrControlFlowSmoke() {
        string qore_bin = QORE_ARGV[0] ?? ARGV[0] ?? NOTHING;
        if (!qore_bin || qore_bin == NOTHING) {
            testSkip("no qore binary path available");
            return;
        }

        TmpFile script();
        script.file.write("%new-style\n%modern\n");
        script.file.write("int total = 0;\n");
        script.file.write("int i = 0;\n");
        script.file.write("for (; i < 3; ) { total = total + i; i = i + 1; }\n");
        script.file.write("int j = 0;\n");
        script.file.write("while (j < 2) { total = total + j; j = j + 1; }\n");
        script.file.write("string out = \"\";\n");
        script.file.write("if (total == 4) { out = out + \"ok1\"; } else { out = out + \"bad1\"; }\n");
        script.file.write("switch (total) { case 4: out = out + \"ok2\"; break; default: out = out + \"bad2\"; }\n");
        script.file.write("printf(\"%s:%d\\n\", out, total);\n");
        script.file.close();

        TmpFile out();
        TmpFile err();

        string cmd = sprintf("%s --exec-mode=ir %s > %s 2> %s",
            qore_bin, script.path, out.path, err.path);
        int rc = runCommand(cmd, script.path);
        string err_output = ReadOnlyFile::readTextFile(err.path);
        if (rc != 0 && err_output =~ /exec-mode/ && err_output =~ /valid long option/) {
            testSkip("exec-mode option not supported by test qore binary");
            return;
        }

        if (rc != 0) {
            printf("====LVALUE ERR====\\n");
            printf("%s\\n", err_output ?? "no err");
        }

        assertEq(0, rc, "IR exec mode process should exit cleanly");
        assertFalse(err_output =~ /IR exec fallback to AST:/, "Unexpected IR fallback warning");

        string stdout_output = ReadOnlyFile::readTextFile(out.path);
        assertEq("ok1ok2:4\n", stdout_output, "Unexpected IR exec output");
    }

    testIrTryCatchSmoke() {
        string qore_bin = QORE_ARGV[0] ?? ARGV[0] ?? NOTHING;
        if (!qore_bin || qore_bin == NOTHING) {
            testSkip("no qore binary path available");
            return;
        }

        TmpFile script();
        script.file.write("%new-style\n%modern\n");
        script.file.write("int x = 0;\n");
        script.file.write("++x;\n");
        script.file.write("try {\n");
        script.file.write("    throw x;\n");
        script.file.write("} catch (ex) {\n");
        script.file.write("    x = x + 1;\n");
        script.file.write("}\n");
        script.file.write("printf(\"caught:%d\\n\", x);\n");
        script.file.close();

        TmpFile out();
        TmpFile err();

        string cmd = sprintf("%s --exec-mode=ir %s > %s 2> %s",
            qore_bin, script.path, out.path, err.path);
        int rc = runCommand(cmd, script.path);
        string err_output = ReadOnlyFile::readTextFile(err.path);
        if (rc != 0 && err_output =~ /exec-mode/ && err_output =~ /valid long option/) {
            testSkip("exec-mode option not supported by test qore binary");
            return;
        }

        assertEq(0, rc, "IR exec mode process should exit cleanly");
        assertFalse(err_output =~ /IR exec fallback to AST:/, "Unexpected IR fallback warning");

        string stdout_output = ReadOnlyFile::readTextFile(out.path);
        assertEq("caught:2\n", stdout_output, "Unexpected IR try/catch output");
    }

    testIrRangeMaybeSmoke() {
        string qore_bin = QORE_ARGV[0] ?? ARGV[0] ?? NOTHING;
        if (!qore_bin || qore_bin == NOTHING) {
            testSkip("no qore binary path available");
            return;
        }

        TmpFile script();
        script.file.write("%new-style\n%modern\n");
        script.file.write("int maybe;\n");
        script.file.write("auto nums = 1..3;\n");
        script.file.write("int sum = 0;\n");
        script.file.write("foreach (int n) in (nums) {\n");
        script.file.write("    sum = sum + n;\n");
        script.file.write("}\n");
        script.file.write("if (!maybe) {\n");
        script.file.write("    maybe = sum;\n");
        script.file.write("}\n");
        script.file.write("printf(\"sum:%d maybe:%d\\n\", sum, maybe);\n");
        script.file.close();

        TmpFile out();
        TmpFile err();

        string cmd = sprintf("%s --exec-mode=ir %s > %s 2> %s",
            qore_bin, script.path, out.path, err.path);
        int rc = runCommand(cmd, script.path);
        string err_output = ReadOnlyFile::readTextFile(err.path);
        if (rc != 0 && err_output =~ /exec-mode/ && err_output =~ /valid long option/) {
            testSkip("exec-mode option not supported by test qore binary");
            return;
        }

        assertEq(0, rc, "IR exec mode process should exit cleanly");
        assertFalse(err_output =~ /IR exec fallback to AST:/, "Unexpected IR fallback warning");

        string stdout_output = ReadOnlyFile::readTextFile(out.path);
        assertEq("sum:6 maybe:6\n", stdout_output, "Unexpected IR range/maybe output");
    }

