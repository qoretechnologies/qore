        TmpFile script();
        script.file.write("%new-style\n%modern\n");
        script.file.write("class BitwiseContainer { public { int v; } }\n");
        script.file.write("hash h;\n");
        script.file.write("h.v = 13;\n");
        script.file.write("h.v %= 5;\n");
        script.file.write("h.v &= 6;\n");
        script.file.write("h.v |= 1;\n");
        script.file.write("h.v ^= 3;\n");
        script.file.write("list l = (13,);\n");
        script.file.write("l[0] %= 5;\n");
        script.file.write("l[0] &= 6;\n");
        script.file.write("l[0] |= 1;\n");
        script.file.write("l[0] ^= 3;\n");
        script.file.write("BitwiseContainer obj = new BitwiseContainer();\n");
        script.file.write("obj.v = 13;\n");
        script.file.write("obj.v %= 5;\n");
        script.file.write("obj.v &= 6;\n");
        script.file.write("obj.v |= 1;\n");
        script.file.write("obj.v ^= 3;\n");
        script.file.write("printf(\"bitassign:%d:%d:%d\\n\", h.v, l[0], obj.v);\n");
        script.file.close();

        TmpFile out();
        TmpFile err();

        string cmd = sprintf("%s --exec-mode=ir %s > %s 2> %s",
            qore_bin, script.path, out.path, err.path);
        int rc = runCommand(cmd, script.path);
