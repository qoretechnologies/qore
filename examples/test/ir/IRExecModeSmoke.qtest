        script.file.write("%new-style\n");
        script.file.write("hash data;\n");
        script.file.write("data.rng = 1..5;\n");
        script.file.write("printf(\"hashrange-size:%d\\n\", data.rng.size());\n");
        script.file.write("printf(\"hashrange-first:%d\\n\", data.rng[0]);\n");
        script.file.write("printf(\"hashrange-last:%d\\n\", data.rng[data.rng.size() - 1]);\n");
        script.file.write("printf(\"hashrange-step:%d\\n\", data.rng[1] - data.rng[0]);\n");
        script.file.close();

        TmpFile out();
        TmpFile err();

        string cmd = sprintf("%s --exec-mode=ir %s > %s 2> %s",
            qore_bin, script.path, out.path, err.path);
        int rc = system(cmd);
