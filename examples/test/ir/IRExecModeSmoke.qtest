        TmpFile script();
        script.file.write("%new-style\n");
        script.file.write("try {\n");
        script.file.write("    try {\n");
        script.file.write("        throw \"inner\";\n");
        script.file.write("    } catch (inner) {\n");
        script.file.write("        throw inner & \" outer\";\n");
        script.file.write("    }\n");
        script.file.write("} catch (outer) {\n");
        script.file.write("    printf(\"nested:%s\\n\", outer);\n");
        script.file.write("}\n");
        script.file.close();

