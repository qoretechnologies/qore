    testIrRangeForeachSmoke() {
        string qore_bin = QORE_ARGV[0] ?? ARGV[0] ?? NOTHING;
        if (!qore_bin || qore_bin == NOTHING) {
            testSkip("no qore binary path available");
            return;
        }

        TmpFile script();
        script.file.write("%new-style\n%modern\n");
        script.file.write("auto rng = 1..4;\n");
        script.file.write("int sum = 0;\n");
        script.file.write("foreach (int n) in (rng) {\n");
        script.file.write("    sum += n;\n");
        script.file.write("}\n");
        script.file.write("printf(\"foreach:%d\\n\", sum);\n");
        script.file.close();

