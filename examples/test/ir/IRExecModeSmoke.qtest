        script.file.write("shifted >>= 1;\n");
        script.file.write("int lvalue = 1;\n");
        script.file.write("lvalue <<= 3;\n");
        script.file.write("printf(\"shift:%d lvalue:%d\\n\", shifted, lvalue);\n");
        script.file.close();

        TmpFile out();
        TmpFile err();

        string cmd = sprintf("%s --exec-mode=ir %s > %s 2> %s",
