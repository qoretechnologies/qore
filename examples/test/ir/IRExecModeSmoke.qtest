    testIrFoldMapSmoke() {
        string qore_bin = QORE_ARGV[0] ?? ARGV[0] ?? NOTHING;
        if (!qore_bin || qore_bin == NOTHING) {
            testSkip("no qore binary path available");
            return;
        }

        TmpFile script();
        script.file.write("%new-style\n");
        script.file.write("list nums = (1, 2, 3);\n");
        script.file.write("auto sum = foldl ((sub (auto acc, auto v) { return acc + v; }, nums));\n");
        script.file.write("list doubled = map ((sub (int v) { return v * 2; }, nums));\n");
        script.file.write("printf(\"foldmap:%d%s\\n\", doubled.size(), \"ok\");\n");
        script.file.close();

        TmpFile out();
        TmpFile err();

        string cmd = sprintf("%s --exec-mode=ir %s > %s 2> %s",
            qore_bin, script.path, out.path, err.path);
        int rc = system(cmd);
        string err_output = ReadOnlyFile::readTextFile(err.path);
        if (rc != 0 && err_output =~ /exec-mode/ && err_output =~ /valid long option/) {
            testSkip("exec-mode option not supported by test qore binary");
            return;
        }

        assertEq(0, rc, "IR exec mode process should exit cleanly");
        assertFalse(err_output =~ /IR exec fallback to AST:/, "Unexpected IR fallback warning");

        string stdout_output = ReadOnlyFile::readTextFile(out.path);
        assertEq("foldmap:3ok\n", stdout_output, "Unexpected IR fold/map output");
    }

