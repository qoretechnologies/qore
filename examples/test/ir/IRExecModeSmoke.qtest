    testIrMapDotEvalInTrySmoke() {
        string qore_bin = QORE_ARGV[0] ?? ARGV[0] ?? NOTHING;
        if (!qore_bin || qore_bin == NOTHING) {
            testSkip("no qore binary path available");
            return;
        }

        # Test: map with $1.member() call inside try/catch
        # Regression: lowerStatement() pre-evaluated map's child expressions
        # for the Invoke path, but $1 is only valid inside the map body context.
        # The fix skips pre-evaluation for map/select/foldl/foldr operators.
        TmpFile script();
        script.file.write("%new-style\n%modern\n");
        script.file.write("list<hash<auto>> l = ({\"fn\": auto sub () { return \"ok\"; }},);\n");
        script.file.write("auto v;\n");
        script.file.write("try {\n");
        script.file.write("    map v = $1.fn(), l;\n");
        script.file.write("} catch (hash<ExceptionInfo> ex) {\n");
        script.file.write("    v = \"ERROR: \" + ex.err;\n");
        script.file.write("}\n");
        script.file.write("printf(\"map-dot-try:%s\\n\", v);\n");
        script.file.close();

        TmpFile out();
        TmpFile err();

        string cmd = sprintf("%s --exec-mode=ir %s > %s 2> %s",
            qore_bin, script.path, out.path, err.path);
        int rc = runCommand(cmd, script.path);
        string err_output = ReadOnlyFile::readTextFile(err.path);
        if (rc != 0 && err_output =~ /exec-mode/ && err_output =~ /valid long option/) {
            testSkip("exec-mode option not supported by test qore binary");
            return;
        }

        assertEq(0, rc, "IR map dot-eval in try should exit cleanly");
        assertFalse(err_output =~ /IR exec fallback to AST:/, "Unexpected IR fallback warning");

        string stdout_output = ReadOnlyFile::readTextFile(out.path);
        assertEq("map-dot-try:ok\n", stdout_output, "map $1.fn() in try/catch should call closure");
    }

    testIrMapHashBoolValueSmoke() {
        string qore_bin = QORE_ARGV[0] ?? ARGV[0] ?? NOTHING;
        if (!qore_bin || qore_bin == NOTHING) {
            testSkip("no qore binary path available");
            return;
        }

        # Test: map {$1: True} into hash<string, bool>
        # Regression: HashSetKeyValue in LLVM lowering used boxIntInline()
        # for all non-nanboxed operands, but ConstBool has LLVM type i1 —
        # boxIntInline interprets i1 as integer, producing int instead of bool.
        # Fix: check LLVM type and use boxBool() for i1, boxFloat() for double.
        TmpFile script();
        script.file.write("%new-style\n%modern\n");
        script.file.write("sub test_map() {\n");
        script.file.write("    list<string> roles = (\"value\", \"key\");\n");
        script.file.write("    *hash<string, bool> role_hash = map {$1: True}, roles;\n");
        script.file.write("    if (role_hash.value.type() != \"bool\") {\n");
        script.file.write("        printf(\"FAIL: expected bool, got %s\\n\", role_hash.value.type());\n");
        script.file.write("        exit(1);\n");
        script.file.write("    }\n");
        script.file.write("}\n");
        script.file.write("test_map();\n");
        script.file.write("printf(\"map-hash-bool:ok\\n\");\n");
        script.file.close();

        TmpFile out();
        TmpFile err();

        string cmd = sprintf("%s --exec-mode=ir %s > %s 2> %s",
            qore_bin, script.path, out.path, err.path);
        int rc = runCommand(cmd, script.path);
        string err_output = ReadOnlyFile::readTextFile(err.path);
        if (rc != 0 && err_output =~ /exec-mode/ && err_output =~ /valid long option/) {
            testSkip("exec-mode option not supported by test qore binary");
            return;
        }

        assertEq(0, rc, "IR map hash bool should exit cleanly");
        assertFalse(err_output =~ /IR exec fallback to AST:/, "Unexpected IR fallback warning");

        string stdout_output = ReadOnlyFile::readTextFile(out.path);
        assertEq("map-hash-bool:ok\n", stdout_output, "map {$1: True} should preserve bool type");
    }

    testIrClosureDefaultArgsSmoke() {
        string qore_bin = QORE_ARGV[0] ?? ARGV[0] ?? NOTHING;
        if (!qore_bin || qore_bin == NOTHING) {
            testSkip("no qore binary path available");
            return;
        }

        TmpFile script();
        script.file.write("%new-style\n%modern\n");
        script.file.write("code fn = int sub (int x = 42, string s = \"hello\", bool b = True) {\n");
        script.file.write("    return x + s.length() + (b ? 1 : 0);\n");
        script.file.write("};\n");
        script.file.write("int r1 = fn();\n");
        script.file.write("int r2 = fn(10, \"ab\", False);\n");
        script.file.write("printf(\"defaults:%d:%d\\n\", r1, r2);\n");
        script.file.close();

        TmpFile out();
        TmpFile err();

        string cmd = sprintf("%s --exec-mode=ir --ir-fallback-warn %s > %s 2> %s",
            qore_bin, script.path, out.path, err.path);
        int rc = runCommand(cmd, script.path);
        string err_output = ReadOnlyFile::readTextFile(err.path);
        if (rc != 0 && err_output =~ /exec-mode/ && err_output =~ /valid long option/) {
            testSkip("exec-mode option not supported by test qore binary");
            return;
        }

        assertEq(0, rc, "IR closure default args should exit cleanly");
        assertFalse(err_output =~ /IR exec fallback to AST:/, "Unexpected IR fallback warning");

        string stdout_output = ReadOnlyFile::readTextFile(out.path);
        # r1 = 42 + 5 + 1 = 48, r2 = 10 + 2 + 0 = 12
        assertEq("defaults:48:12\n", stdout_output, "Unexpected IR closure default args output");
    }

