        script.file.write("try {\n");
        script.file.write("    try {\n");
        script.file.write("        throw 7;\n");
        script.file.write("    } catch (inner) {\n");
        script.file.write("        throw inner;\n");
        script.file.write("    }\n");
        script.file.write("} catch (outer) {\n");
        script.file.write("    printf(\"outer:ok\\n\");\n");
        script.file.write("}\n");
        script.file.close();

        TmpFile out();
        TmpFile err();

        string cmd = sprintf("%s --exec-mode=ir %s > %s 2> %s",
            qore_bin, script.path, out.path, err.path);
