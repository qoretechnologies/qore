    testIrListShiftUnshiftSpliceSmoke() {
        string qore_bin = QORE_ARGV[0] ?? ARGV[0] ?? NOTHING;
        if (!qore_bin || qore_bin == NOTHING) {
            testSkip("no qore binary path available");
            return;
        }

        TmpFile script();
        script.file.write("%new-style\n%modern\n");
        script.file.write("list l = (1, 2, 3);\n");
        script.file.write("int shifted = shift l;\n");
        script.file.write("unshift l, 0;\n");
        script.file.write("splice l, 1, 1, (9, 8);\n");
        script.file.write("push l, 4;\n");
        script.file.write("int popped = pop l;\n");
        script.file.write("printf(\"listshift:%d:%d,%d,%d,%d pop:%d\\n\", shifted, l[0], l[1], l[2], l[3], popped);\n");
        script.file.write("list empty;\n");
        script.file.write("try {\n");
        script.file.write("    int v = shift empty;\n");
        script.file.write("    printf(\"shift-nothing:%d\\n\", v);\n");
        script.file.write("} catch (ex) {\n");
        script.file.write("    printf(\"shift-nothing:caught\\n\");\n");
        script.file.write("}\n");
        script.file.write("list l2;\n");
        script.file.write("unshift l2, 5;\n");
        script.file.write("list l3;\n");
        script.file.write("splice l3, 0, 0, (1);\n");
        script.file.write("printf(\"unshift-nothing:%d splice-nothing:%d\\n\", l2[0], l3[0]);\n");
        script.file.close();

        TmpFile out();
        TmpFile err();

        string cmd = sprintf("%s --exec-mode=ir %s > %s 2> %s",
            qore_bin, script.path, out.path, err.path);
        int rc = runCommand(cmd, script.path);
        string err_output = ReadOnlyFile::readTextFile(err.path);
        if (rc != 0 && err_output =~ /exec-mode/ && err_output =~ /valid long option/) {
            testSkip("exec-mode option not supported by test qore binary");
            return;
        }

        assertEq(0, rc, "IR exec mode process should exit cleanly");
        assertFalse(err_output =~ /IR exec fallback to AST:/, "Unexpected IR fallback warning");

        string stdout_output = ReadOnlyFile::readTextFile(out.path);
        assertEq("listshift:1:0,9,8,3 pop:4\nshift-nothing:caught\nunshift-nothing:5 splice-nothing:1\n",
            stdout_output, "Unexpected IR list shift/unshift/splice output");
    }

