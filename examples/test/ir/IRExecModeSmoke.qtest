    private testIrExceptionTypePreserveSmoke() {
        string qore_bin = QORE_ARGV[0] ?? ARGV[0] ?? NOTHING;
        if (!qore_bin || qore_bin == NOTHING) {
            testSkip("no qore binary path available");
            return;
        }

        TmpFile script(".q");
        script.file.write("%new-style\n%modern\n");
        script.file.write("string result = \"\";\n");
        script.file.write("try {\n");
        script.file.write("    list l = (1, 2, 3);\n");
        script.file.write("    throw \"TEST-ERR\", \"message\", l;\n");
        script.file.write("} catch (hash<ExceptionInfo> ex) {\n");
        script.file.write("    result = sprintf(\"%s:%s:%d\", ex.err, ex.desc, ex.arg[0]);\n");
        script.file.write("}\n");
        script.file.write("printf(\"exc:%s\\n\", result);\n");
        script.file.close();

        TmpFile out();
        TmpFile err();

        string cmd = sprintf("%s --exec-mode=ir --ir-fallback-warn %s > %s 2> %s",
            qore_bin, script.path, out.path, err.path);
        int rc = runCommand(cmd, script.path);
        string err_output = ReadOnlyFile::readTextFile(err.path);
        if (rc != 0 && err_output =~ /exec-mode/ && err_output =~ /valid long option/) {
            testSkip("exec-mode option not supported by test qore binary");
            return;
        }

        assertEq(0, rc, "IR exception throw should exit cleanly");
        assertFalse(err_output =~ /IR exec fallback to AST:/, "Unexpected IR fallback warning");

        string stdout_output = ReadOnlyFile::readTextFile(out.path);
        assertEq("exc:TEST-ERR:message:1\n", stdout_output, "Exception type should be preserved");
    }

    private testIrNestedExceptionTypeSmoke() {
        string qore_bin = QORE_ARGV[0] ?? ARGV[0] ?? NOTHING;
        if (!qore_bin || qore_bin == NOTHING) {
            testSkip("no qore binary path available");
            return;
        }

        TmpFile script(".q");
        script.file.write("%new-style\n%modern\n");
        script.file.write("string r2 = \"\";\n");
        script.file.write("try {\n");
        script.file.write("    try {\n");
        script.file.write("        throw \"INNER\", \"inner-msg\";\n");
        script.file.write("    } catch (hash<ExceptionInfo> ex) {\n");
        script.file.write("        r2 += ex.err;\n");
        script.file.write("        throw \"OUTER\", \"outer-msg\";\n");
        script.file.write("    }\n");
        script.file.write("} catch (hash<ExceptionInfo> ex) {\n");
        script.file.write("    r2 += \":\" + ex.err;\n");
        script.file.write("}\n");
        script.file.write("printf(\"nested:%s\\n\", r2);\n");
        script.file.close();

        TmpFile out();
        TmpFile err();

        string cmd = sprintf("%s --exec-mode=ir --ir-fallback-warn %s > %s 2> %s",
            qore_bin, script.path, out.path, err.path);
        int rc = runCommand(cmd, script.path);
        string err_output = ReadOnlyFile::readTextFile(err.path);
        if (rc != 0 && err_output =~ /exec-mode/ && err_output =~ /valid long option/) {
            testSkip("exec-mode option not supported by test qore binary");
            return;
        }

        assertEq(0, rc, "IR nested exception should exit cleanly");
        assertFalse(err_output =~ /IR exec fallback to AST:/, "Unexpected IR fallback warning");

        string stdout_output = ReadOnlyFile::readTextFile(out.path);
        assertEq("nested:INNER:OUTER\n", stdout_output, "Nested exception types should be preserved");
    }

