    testSandboxedSubProgramParseOptionsSmoke() {
        # Test that parse options don't leak from a sandboxed sub-program into the caller's context
        # This is a regression test for an aliasing bug in swap_runtime_statement_location()
        # where calling a PO_LOCKDOWN sub-program function and then calling is_dir() would fail
        # with INVALID-FUNCTION-ACCESS because parse options were not properly restored
        Program p(PO_LOCKDOWN | PO_NEW_STYLE);
        p.disableParseOptions(PO_NO_TOP_LEVEL_STATEMENTS);
        p.parse("hash sub get_test() { return {}; }\n", "test");
        p.run();
        p.callFunction("get_test");
        # This must NOT throw INVALID-FUNCTION-ACCESS:
        bool ok = is_dir("/");
        assertTrue(ok, "is_dir() should work after calling sandboxed sub-program");
    }

    testReferenceAssignmentIRMode() {
        # Regression test: simple assignment (=) on reference-typed variables
        # must force StoreLValue path to delegate to AST's LValueHelper.
        # LValueHelper correctly handles initial binding and write-through assignment.
        # This is a regression for IR mode where lowerAssignment() was missing the
        # isReference() check that all compound operators have.

        TmpFile script();
        script.file.write("%new-style\n%modern\n");
        script.file.write("int \$x = 42;\n");
        script.file.write("reference<int> \$ref = \\\$x;\n");
        script.file.write("\$ref = 100;\n");
        script.file.write("printf(\"%d\\\\n\", \$x);\n");
        script.file.close();

        TmpFile out();
        TmpFile err();

        string cmd = sprintf("%s --exec-mode=ir %s > %s 2> %s",
            qore_bin, script.path, out.path, err.path);
        int rc = runCommand(cmd, script.path);

        assertEq(0, rc, "reference assignment in IR mode should exit cleanly");

        string stdout_output = ReadOnlyFile::readTextFile(out.path);
        assertEq("100\n", stdout_output,
            "reference write-through assignment should update original variable");

        string err_output = ReadOnlyFile::readTextFile(err.path);
        assertFalse(err_output =~ /RUNTIME-TYPE-ERROR/, "Should not have RUNTIME-TYPE-ERROR for reference assignment");
        assertFalse(err_output =~ /Segmentation fault/, "Should not segfault");
    }
}
