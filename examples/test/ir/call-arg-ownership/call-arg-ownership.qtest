#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes
# test-platform: macos - JIT and AOT code generation of calls that give their temporary arguments to the callee

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../ExecModeHarness.qm

%exec-class CallArgOwnershipTest

#! Tests when the temporary arguments of a call are released (qore#6055, qore#6053)
/** The AST interpreter gives the temporary arguments of a call to its parameters: a parameter holds the only reference
    to the value of a temporary argument, so assigning to the parameter releases the value (and raises the exception of
    its destructor there), the parameters are released in reverse order when the call ends or raises an exception, and
    the value of the call is released after them.  Native code and the IR interpreter kept their own references to
    the temporary arguments until the call returned.  The checks are in call-arg-ownership-worker.qr, which is run in
    each execution mode (the tiered mode with every function compiled to native code), on the IR tier and as a
    program compiled with qcc; every run must give the results below.
*/
class CallArgOwnershipTest inherits QUnit::Test {
    public {
        #! the result of every check the worker makes
        const Expected = {
            "function": "[\"~p\", \"body\"]",
            "method": "[\"~p\", \"body\"]",
            "static-method": "[\"~p\", \"body\"]",
            "final-method": "[\"~p\", \"body\"]",
            "self-call": "[\"~p\", \"body\"]",
            "closure": "[\"~p\", \"body\"]",
            "in-expression": "[\"~p\", \"body\"]",
            "try-function": "[\"~p\", \"body\"]",
            "try-method": "[\"~p\", \"body\"]",
            "try-static-method": "[\"~p\", \"body\"]",
            "try-closure": "[\"~p\", \"body\"]",
            "nine-arguments-function": "[\"~p\", \"body\"]",
            "nine-arguments-method": "[\"~p\", \"body\"]",
            "nine-arguments-closure": "[\"~p\", \"body\"]",
            "function-destructor-exception": "[\"~p\", \"caught:PX\"]",
            "exception-order": "[\"~b\", \"~a\", \"caught:DX\"]",
            "release-order": "[\"body\", \"~b\", \"~a\"]",
            "value-before-parameters": "[\"~v\", \"~p\", \"caught:DX\"]",
            "recursive-value-before-parameters": "[\"~v\", \"~p1\", \"~p\", \"caught:DX\"]",
            "method-reference-value": "[\"~a\", \"~t\"]",
            "function-reference": "[\"body\", \"~p\"]",
            "stable": "True",
        };

    }

    private {
        string qore_bin;
        string libqore_dir;
        string qcc_bin;
    }

    constructor() : QUnit::Test("CallArgOwnershipTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
            ?? (is_file(libqore_dir + DirSep + "qcc") ? libqore_dir + DirSep + "qcc"
                : dirname(qore_bin) + DirSep + "qcc");
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }

        addTestCase("each execution mode", \testExecModes());
        addTestCase("IR tier", \testIrTier());
        addTestCase("compiled program", \testCompiledProgram());

        set_return_value(main());
    }

    testExecModes() {
        foreach string mode in (ExecModeHarness::ExecModes) {
            string out = ExecModeHarness::run(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s %s -b --enable-debug "
                "--exec-mode=%s %s", libqore_dir, libqore_dir, qore_bin, mode, getWorker()));
            checkWorkerOutput(mode, out);
        }
    }

    #! every function runs on the IR tier, which the tiered run of ExecModes hardly runs
    testIrTier() {
        checkWorkerOutput("ir-tier", ExecModeHarness::run_ir_tier(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s "
            "%s -b --enable-debug --exec-mode=tiered %s", libqore_dir, libqore_dir, qore_bin, getWorker())));
    }

    testCompiledProgram() {
        TmpDir tmp("qore-call-arg-ownership-");
        string exe = tmp.path + DirSep + "call-arg-ownership";
        string compile_out = backquote(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s %s --strip-source -o %s %s "
            "2>&1",
            libqore_dir, libqore_dir, qcc_bin, exe, getWorker()));
        assertTrue(is_file(exe), "compiled program: " + compile_out);
        checkWorkerOutput("aot", backquote(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s %s 2>&1", libqore_dir,
            libqore_dir, exe)));
    }

    private string getWorker() {
        return get_script_dir() + DirSep + "call-arg-ownership-worker.qr";
    }

    #! parses the "name=result" lines printed by the worker and checks them; any other output fails
    private checkWorkerOutput(string label, string out) {
        hash<string, string> results = {};
        foreach string line in (out.split("\n")) {
            *list<*string> parts = (line =~ x/^([-a-z]+)=(.*)$/);
            if (!parts) {
                if (line.val()) {
                    fail(sprintf("%s: unexpected worker output: %y", label, out));
                }
                continue;
            }
            results{parts[0]} = parts[1];
        }
        assertEq(sort(keys Expected), sort(keys results), label + ": checks run");
        foreach hash<auto> i in (Expected.pairIterator()) {
            assertEq(i.value, results{i.key}, sprintf("%s: %s", label, i.key));
        }
    }
}
