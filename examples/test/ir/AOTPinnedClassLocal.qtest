%modern
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil
%exec-class PinnedClassLocalTest

class PinnedClassLocalTest inherits QUnit::Test {
    private {
        string qore = realpath(ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0]);
        string libdir = realpath(ENV.QORE_LIBDIR ?? dirname(qore));
        string qcc = ENV.QCC ?? libdir + "/qcc";
    }
    constructor() : Test("pinned class-local cache", "1.0", \ARGV) {
        addTestCase("guarded cache borrowing preserves local lifetime and reflection", \check());
        set_return_value(main());
    }
    private static string quote(string value) {
        return "'" + replace(value, "'", "'\"'\"'") + "'";
    }
    private string run(list<string> args, string prefix = "") {
        int status;
        string output = backquote(prefix + "LD_LIBRARY_PATH=" + quote(libdir)
            + " DYLD_LIBRARY_PATH=" + quote(libdir) + " "
            + (map quote($1), args).join(" ") + " 2>&1", \status);
        assertEq(0, status, output);
        return output;
    }
    private check() {
        string source = get_script_dir() + "/AOTPinnedClassLocal.qr";
        string expected = "12:1190:1290:7\n903:941:300:657\n40:40\n32,31,30\n32,31,30\n72:50:1\npinned-class-local: ok\n";
        assertEq(expected, run((qore, "--exec-mode=ast", source)), "AST reference");
        # Reflective access to these uncaptured locals is supported by AOT, not
        # the baseline IR/JIT frame lookup. Keep an explicit AST reference.
        TmpDir dir("qore-pinned-class-local-");
        foreach string prefix in (("", "QORE_AOT_EH=1 ",
                "QORE_DISABLE_AOT_PINNED_LOCAL_RECEIVER=1 ",
                "QORE_DISABLE_AOT_PINNED_CLASS_LOCAL=1 ",
                "QORE_DISABLE_AOT_CLASS_LOCAL_SLOT=1 ",
                "QORE_DISABLE_AOT_CLASS_LOCAL_PREPARE=1 ",
                "QORE_DISABLE_AOT_FIRST_PUBLIC_BASE_ACCEPT=1 ",
                "MAKEFLAGS= QCC_JOBS=4 QCC_SPLIT_THRESHOLD=1 ")) {
            foreach string level in (("-O0", "-O3")) {
                string executable = dir.path + "/fixture";
                string ir = run((qcc, level, "--strip-source", "-o", executable, source),
                    prefix + "QORE_DUMP_LLVM_IR=1 ");
                bool pinned = !prefix.startsWith("QORE_DISABLE_AOT_PINNED_CLASS_LOCAL");
                bool prepared = !prefix.startsWith("QORE_DISABLE_AOT_CLASS_LOCAL_SLOT");
                bool constraint = prepared && !prefix.startsWith("QORE_DISABLE_AOT_CLASS_LOCAL_PREPARE");
                if (!prefix || prefix == "QORE_DISABLE_AOT_PINNED_LOCAL_RECEIVER=1 ") {
                    bool receiver_hint = !prefix;
                    foreach string name in (("pinnedLocalStep", "pinnedPhiReceiverChanged",
                            "pinnedPhiSourceChanged", "pinnedDeleteLocalLoop")) {
                        *list<*string> receiver_body = regex_extract(ir,
                            "(?s)define [^\n]*@" + name + "_[^\n]*\n(.*?)\n\\}");
                        assertTrue(!!receiver_body, name + " receiver-local definition");
                        string code = receiver_body[0] ?? "";
                        assertEq(receiver_hint, regex(code, "pinned_receiver_metadata[^\n]* = phi "),
                            name + " selected source metadata " + prefix + level);
                        assertEq(receiver_hint, regex(code, "pinned_base_phi_same_receiver"),
                            name + " actual receiver identity " + prefix + level);
                        assertEq(receiver_hint, regex(code, "pinned_override_phi_same_receiver"),
                            name + " actual override receiver identity " + prefix + level);
                        foreach string kind in (("base", "override")) {
                            assertEq(receiver_hint, regex(code,
                                "pinned_" + kind + "_live_status[^\n]*load atomic i32,[^\n]*seq_cst"),
                                name + " live " + kind + " deletion status " + prefix + level);
                        }
                        assertTrue(regex(code, "call i32 @qore_rt_object_has_exact_aot_target_class\\("),
                            name + " ordinary base fallback " + prefix + level);
                        assertTrue(regex(code, "call ptr @qore_rt_get_live_aot_override_receiver_class_v1"),
                            name + " ordinary override fallback " + prefix + level);
                    }
                }
                foreach string name in (("pinnedPhi", "pinnedReflect", "pinnedReflectReplaced",
                        "pinnedChanging", "pinnedCycle", "pinnedRecursive")) {
                    *list<*string> body = regex_extract(ir,
                        "(?s)define [^\n]*@" + name + "_[^\n]*\n(.*?)\n\\}");
                    assertTrue(!!body, name + " LLVM definition");
                    assertEq(pinned, regex(body[0] ?? "", "class_source_is_pinned"),
                        name + " live identity guard " + prefix + level);
                    assertEq(pinned, regex(body[0] ?? "",
                        "(?:call|invoke) i32 @qore_rt_try_assign_pinned_class_local_aot"),
                        name + " checked borrowed initializer " + prefix + level);
                    if (pinned) {
                        assertEq(prepared, regex(body[0] ?? "",
                            "call ptr @qore_rt_get_class_local_slot_aot_v1"),
                            name + " entry-local slot resolution " + prefix + level);
                        assertEq(prepared, regex(body[0] ?? "",
                            "qore_rt_try_assign_pinned_class_local_aot(?:_throwing)?_v[234]"),
                            name + " prepared initializer " + prefix + level);
                        assertEq(constraint, regex(body[0] ?? "",
                            "call ptr @qore_rt_get_class_local_constraint_aot_v1"),
                            name + " immutable constraint preparation " + prefix + level);
                        assertEq(constraint, regex(body[0] ?? "",
                            "qore_rt_try_assign_pinned_class_local_aot(?:_throwing)?_v[34]"),
                            name + " live acceptance with prepared constraint " + prefix + level);
                        assertEq(constraint && !prefix.startsWith("QORE_DISABLE_AOT_FIRST_PUBLIC_BASE_ACCEPT"),
                            regex(body[0] ?? "", "qore_rt_try_assign_pinned_class_local_aot(?:_throwing)?_v4"),
                            name + " first-public-base helper selection " + prefix + level);
                    }
                }
                *list<*string> body = regex_extract(ir,
                    "(?s)define [^\n]*@notPinned_[^\n]*\n(.*?)\n\\}");
                assertTrue(!!body, "unowned-source definition");
                assertFalse(regex(body[0] ?? "", "qore_rt_try_assign_pinned_class_local_aot"),
                    "body-local sources keep the ordinary cache owner");
                assertEq(expected, run((executable,)), prefix + level);
                assertEq(expected, run((executable,), "QORE_DISABLE_AOT_PINNED_CLASS_LOCAL=1 "),
                    "runtime owned-cache fallback " + prefix + level);
                assertEq(expected, run((executable,), "QORE_DISABLE_IR_CONTEXT_ELISION=1 "),
                    "full runtime context " + prefix + level);
                assertEq(expected, run((executable,), "QORE_DISABLE_AOT_CLASS_LOCAL_SLOT=1 "),
                    "runtime slot-lookup fallback " + prefix + level);
                assertEq(expected, run((executable,), "QORE_DISABLE_AOT_CLASS_LOCAL_PREPARE=1 "),
                    "runtime declaration-metadata fallback " + prefix + level);
            }
        }
    }
}
