#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - JIT and AOT code generation of list selectors with ranges
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - every check runs a script in a child process that sets its own --exec-mode, or AOT

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../ExecModeHarness.qm

%exec-class SelectorRangeNothingTest

#! issue #5656: a range in a list of selectors whose bound evaluates to NOTHING raises RANGE-ERROR
/** The AST interpreter evaluates a range in a list of selectors (l[k..3, 0]) as the range operator, which raises
    RANGE-ERROR for a bound that evaluates to NOTHING, before it resolves negative offsets.  The runtime helper of the
    IR interpreter, native code and AOT resolved negative offsets first, which took a missing bound as the start or
    the end of the list, so l[k..3, 0] with k = NOTHING returned [0, 1, 2, 3, 0].  A single range (l[k..3]) takes a
    missing bound as the start or the end in every execution mode.

    The scripts next to the test (without and with %negative-offsets) run in every execution mode, on the IR tier and
    as AOT executables, and their output must be that of the AST interpreter.
*/
class SelectorRangeNothingTest inherits QUnit::Test {
    public {
        #! the output of both scripts with the AST interpreter, which every execution mode and AOT must give
        const Expected = (
            "multi start: RANGE-ERROR: the start expression of the range operator (..) evaluated to NOTHING",
            "multi end: RANGE-ERROR: the end expression of the range operator (..) evaluated to NOTHING",
            "multi both: RANGE-ERROR: the start expression of the range operator (..) evaluated to NOTHING",
            "multi second selector: RANGE-ERROR: the start expression of the range operator (..) evaluated to NOTHING",
            "multi negative: [3, 4, 0]",
            "multi descending: [3, 2, 1, 0]",
            "multi mixed: [1, 2, 3, 4, 0]",
            "single start: [0, 1, 2, 3]",
            "single end: [1, 2, 3, 4]",
            "string start: RANGE-ERROR: the start expression of the range operator (..) evaluated to NOTHING",
            "string range: \"bca\"",
        );

        #! the scripts print their lines this many times
        const Iterations = 3;

        #! the scripts: without and with %negative-offsets
        const Scripts = ("ranges-plain", "ranges-negative-offsets");
    }

    private {
        string qore_bin;
        string qcc_bin;
        string env;
    }

    constructor() : QUnit::Test("selector range with a NOTHING bound", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        string libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
            ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");
        env = sprintf("LD_LIBRARY_PATH=%s QORE_LIBDIR=%s", libqore_dir, libqore_dir);

        addTestCase("execution modes", \modesTest());
        addTestCase("AOT executables", \aotTest());
        set_return_value(main());
    }

    #! runs each script in every execution mode and on the IR tier
    private modesTest() {
        string exp = expected();
        foreach string name in (Scripts) {
            string path = scriptPath(name);
            foreach string mode in (ExecModeHarness::ExecModes) {
                assertEq(exp, ExecModeHarness::run(sprintf("%s %s --exec-mode=%s %s", env, qore_bin, mode, path)),
                    name + ": " + mode);
            }
            assertEq(exp, ExecModeHarness::run_ir_tier(sprintf("%s %s --exec-mode=tiered %s", env, qore_bin, path)),
                name + ": " + ExecModeHarness::IRTierName);
        }
    }

    #! compiles each script with qcc and checks that the executable gives the output of the AST interpreter
    private aotTest() {
        if (!is_file(qcc_bin)) {
            testSkip("qcc is not available at " + qcc_bin);
        }
        TmpDir dir("selector-range-nothing-aot-");
        foreach string name in (Scripts) {
            string exe = dir.path + "/" + name;
            string out = ExecModeHarness::run_any(sprintf("%s %s -O3 -o %s %s", env, qcc_bin, exe, scriptPath(name)));
            assertTrue(is_file(exe), name + ": qcc compiles the script: " + out);
            assertEq(expected(), ExecModeHarness::run_any(sprintf("%s %s", env, exe)), name + ": AOT");
        }
    }

    private string scriptPath(string name) {
        return get_script_dir() + "/" + name + ".q";
    }

    #! the expected output: the lines, printed once per iteration
    private string expected() {
        return strmul((foldl $1 + "\n" + $2, Expected) + "\n", Iterations);
    }
}
