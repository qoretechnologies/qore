#
# Part 1 of the cases of AOTOutlinedClosure.qc, which describes them:
# the function of the issue at the default thresholds, in an executable and in a module

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../ExecModeHarness.qm
%requires ../TestInterpreter.qm

%include AOTOutlinedClosure.qc

%exec-class AOTOutlinedClosurePart1

#! runs part 1 of 3 of the cases of AOTOutlinedClosureBase
class AOTOutlinedClosurePart1 inherits AOTOutlinedClosureBase {
    constructor() : AOTOutlinedClosureBase("AOTOutlinedClosurePart1", 1) {
    }
}
