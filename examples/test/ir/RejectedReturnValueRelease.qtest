#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-exec-mode: children - its checks run in child processes that set their own execution modes

# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../ExecModeHarness.qm
%exec-class RejectedReturnValueReleaseTest

#! the value of a return that the declared return type rejects is released after the locals (qore#5996)
/** The IR interpreter released it with the temps of the return statement when the check raised the exception, before
    the locals of the blocks that the exception leaves; native code released a value borrowed from a local variable with
    the local.  The AST interpreter releases it after them, as the value of the return that the exception interrupts.
*/
class RejectedReturnValueReleaseTest inherits QUnit::Test {
    private {
        string qore_bin = executablePath(ENV.QORE_BIN ?? QORE_ARGV[0] ?? "qore");
        string lib_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        string qcc_bin = ENV.QCC ?? lib_dir + "/qcc";
        string probe = get_script_dir() + "/RejectedReturnValueRelease/probe.q";
        *string ast_out;
    }

    constructor() : Test("rejected return value release", "1.0", \ARGV) {
        addTestCase("AST releases a rejected return value after the locals", \astReference());
        addTestCase("compiled modes match AST", \sourceModes());
        addTestCase("qcc executables match AST", \compiled());
        set_return_value(main());
    }

    astReference() {
        list<string> lines = getAst().split("\n");
        foreach string line in (
                'k2: ["~k2-z", "~k2-u", "caught:RUNTIME-TYPE-ERROR"]',
                'k3: ["~k3-q", "~k3-z", "~k3-u", "c", "r:T", "~k3-other"]',
                'k4: ["~k4-z", "~k4-u", "caught:RUNTIME-TYPE-ERROR"]',
                'k5: ["~k5-z", "~k5-u", "caught:RUNTIME-TYPE-ERROR"]',
                'k6: ["x2", "~k6-q", "x1", "~k6-z", "~k6-u", "caught:RUNTIME-TYPE-ERROR"]',
                'k7: ["~k7-c", "~k7-b", "~k7-a", "~k7-u", "c:RUNTIME-TYPE-ERROR", "r:none"]',
                'm: ["~m-z", "~m-u", "caught:RUNTIME-TYPE-ERROR"]',
                's: ["~s-z", "~s-u", "caught:RUNTIME-TYPE-ERROR"]',
                'k8: ["~k8-z", "~k8-u", "caught:RUNTIME-TYPE-ERROR"]',
                'k9: ["~k9-z", "r:T", "~k9-t"]',
            ) {
            # each case runs twice, so that the tiered mode runs compiled code on the second call
            assertEq(2, (select lines, $1 == line).size(), line);
        }
        # no value is left unreleased
        assertEq(1, (select lines, $1 == "final live=0").size(), "final live count");
    }

    sourceModes() {
        string expected = getAst();
        foreach string mode in ("ir", "jit") {
            assertEq(expected, run((qore_bin, "-b", "--enable-debug", "--exec-mode=" + mode, probe)), mode);
        }
        assertEq(expected, run(("QORE_JIT_SYNC_COMPILE=1", "QORE_IR_THRESHOLD=1", "QORE_JIT_THRESHOLD=1", qore_bin,
            "-b", "--enable-debug", "--exec-mode=tiered", probe)), "tiered");
    }

    compiled() {
        string expected = getAst();
        foreach string level in ("-O0", "-O3") {
            TmpDir dir("qore-rejected-return-value-release-");
            string exe = dir.path + "/probe";
            run((qcc_bin, level, "-o", exe, probe));
            assertEq(expected, run((exe, "-b", "--enable-debug")), "qcc " + level);
        }
    }

    private string getAst() {
        if (!exists ast_out) {
            ast_out = run((qore_bin, "-b", "--enable-debug", "--exec-mode=ast", probe));
        }
        return ast_out;
    }

    private static string quote(string value) {
        return "'" + join("'\\''", split("'", value)) + "'";
    }

    private static string executablePath(string name) {
        if (name.regex("/")) {
            return realpath(name);
        }
        foreach string directory in (split(":", ENV.PATH ?? "")) {
            string path = (directory ? directory : ".") + "/" + name;
            if (is_executable(path)) {
                return realpath(path);
            }
        }
        throw "TEST-SETUP-ERROR", "cannot locate Qore executable " + name;
    }

    #! runs a command; one that runs qore with an execution mode runs through ExecModeHarness
    private string run(list<string> args) {
        string command = "env LD_LIBRARY_PATH=" + quote(lib_dir) + " QORE_LIBDIR=" + quote(lib_dir) + " "
            + (map quote($1), args).join(" ");
        hash<ExecModeHarness::ModeRunResult> r = ExecModeHarness::run_command(command);
        if (r.mode) {
            ExecModeHarness::check_native(r);
        }
        assertEq(0, r.rc, r.out);
        return r.out;
    }
}
