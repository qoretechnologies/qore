#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../ExecModeHarness.qm
%requires ../../LoaderWarnings.qm

%exec-class ExecModeHarnessTest

#! Tests the ExecModeHarness test module that the execution mode tests run their scripts with
/** The module runs a script with synchronous, traced native compilation and checks the trace: native code must have
    been compiled with --exec-mode=jit (and with --exec-mode=tiered when required), and nothing may be compiled with
    --exec-mode=ast or ir.
*/
class ExecModeHarnessTest inherits QUnit::Test {
    private {
        string qore_bin;
        string env;
        TmpDir tmp("qore-exec-mode-harness-");
        #! top-level code only
        string toplevel;
        #! a function called through a call reference
        string function;
        #! functions called by name, one of them running a loop
        string loop;
        #! a %modern program with a function that is not %modern, which tiered execution runs on the AST tier
        string old_style;
        #! closures, which are lowered to IR when first called, not when their Program is committed
        string closures;
        #! a script with a parse error
        string parse_error;
        #! a script that prints on stdout and stderr and exits with status 3
        string output;
        #! a script that prints on stdout and stderr, and the warnings of the module loader on stderr
        string loader_warning;
        string parse_loader_warning;
    }

    #! the warning of the module loader for an AOT module that is out of date
    const StaleWarning = "warning: AOT module '/build/qlib-qmod/QUnit.qmod' for feature 'QUnit' is out of date: its "
        "source '/opt/lib/qore-modules/xml-api-2.1.qmod' has changed since it was compiled; loading source module "
        "'/src/qlib/QUnit.qm' instead; rebuild the AOT module";

    #! the warning of the module loader for an AOT module that cannot be loaded
    const FallbackWarning = "warning: binary module '/build/qlib-qmod/Util.qmod' for feature 'Util' failed to load; "
        "loading source module '/src/qlib/Util.qm' instead: LOAD-MODULE-ERROR: the module was compiled for another AOT "
        "runtime identity";

    constructor() : QUnit::Test("ExecModeHarnessTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        string libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        env = sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s", libqore_dir, libqore_dir);
        toplevel = write("toplevel.q", "%modern\nint t = 0;\nfor (int i = 0; i < 3; ++i) {\n    t += i;\n}\n"
            "printf(\"%d\\n\", t);\n");
        function = write("function.q", "%modern\nint sub f(int i) {\n    return i + 1;\n}\n"
            "code<int(int)> c = \\f();\nint t = 0;\nfor (int i = 0; i < 3; ++i) {\n    t += c(i);\n}\n"
            "printf(\"%d\\n\", t);\n");
        loop = write("loop.q", "%modern\nint sub hot(int n) {\n    int t = 0;\n    for (int i = 0; i < n; ++i) {\n"
            "        t += i;\n    }\n    return t;\n}\nint sub f(int n) {\n    return hot(n);\n}\n"
            "for (int i = 0; i < 3; ++i) {\n    printf(\"%d\\n\", f(5000));\n}\n");
        closures = write("closures.q", "%modern\ncode<int(int)> c = int sub (int i) {\n    return i + 1;\n};\n"
            "int sub f(int i) {\n    code<int(int)> d = int sub (int j) {\n        return j * 2;\n    };\n"
            "    return d(i);\n}\nint t = 0;\nfor (int i = 0; i < 3; ++i) {\n    t += c(i) + f(i);\n}\n"
            "printf(\"%d\\n\", t);\n");
        # a %modern program with a function that is not %modern, as when old-style code is loaded into it
        old_style = write("old-style.q", "%modern\nint t = 0;\nfor (int i = 0; i < 3; ++i) {\n    t += f(i);\n}\n"
            "printf(\"%d\\n\", t);\n%push-parse-options\n%old-style\nint sub f(int $i) {\n    return $i + 1;\n}\n");
        parse_error = write("parse-error.q", "%modern\nint x = ;\n");
        output = write("output.q", "%modern\nprintf(\"out\\n\");\nstderr.print(\"err\\n\");\nexit(3);\n");
        loader_warning = write("loader-warning.q", sprintf("%%modern\nprintf(\"out\\n\");\nstderr.print(%y);\n"
            "stderr.print(\"err\\n\");\nstderr.print(%y);\n", StaleWarning + "\n", FallbackWarning + "\n"));
        parse_loader_warning = write("parse-loader-warning.q", sprintf("%%modern\nprintf(\"out\\n\");\n"
            "stderr.print(%y);\nstderr.print(\"err\\n\");\n", "warning encountered at script.q:2 (Qore builtin "
            "code)\nBINARY-MODULE-SOURCE-FALLBACK" + FallbackWarning.substr(7) + "\n"));

        addTestCase("trace lines", \testTraceLines());
        addTestCase("execution mode of a command", \testGetMode());
        addTestCase("top-level code", \testTopLevel());
        addTestCase("functions", \testFunctions());
        addTestCase("the IR tier of tiered execution", \testIRTier());
        addTestCase("output and exit status", \testOutput());
        addTestCase("module loader warnings are not output", \testLoaderWarnings());
        addTestCase("negative: native compilation checks", \testChecks());
        set_return_value(main());
    }

    testTraceLines() {
        assertTrue(ExecModeHarness::is_trace_line("[BG-JIT] enqueued compilation of 'f@1_0'"));
        assertTrue(ExecModeHarness::is_trace_line("[JIT] compiled '_toplevel@1_0' synchronously"));
        assertFalse(ExecModeHarness::is_trace_line("unhandled QORE System exception"));
        assertTrue(ExecModeHarness::is_native_compilation("[BG-JIT] compiled 'f@1_0' and promoted to JIT tier"));
        assertTrue(ExecModeHarness::is_native_compilation("[BG-JIT] batch-promoted callee 'g@1_1' to JIT tier"));
        assertTrue(ExecModeHarness::is_native_compilation("[JIT] compiled '_toplevel@1_0' synchronously"));
        assertFalse(ExecModeHarness::is_native_compilation("[BG-JIT] enqueued compilation of 'f@1_0'"));
        assertFalse(ExecModeHarness::is_native_compilation("[BG-JIT] failed to compile 'f@1_0': error"));
        assertFalse(ExecModeHarness::is_native_compilation("[JIT] failed to compile '_toplevel@1_0' synchronously: "
            "error"));
    }

    testGetMode() {
        assertEq("jit", ExecModeHarness::get_mode("qore -b --exec-mode=jit x.q"));
        assertEq("tiered", ExecModeHarness::get_mode("A=1 qore --exec-mode tiered x.q; echo $?"));
        assertEq("ir", ExecModeHarness::get_mode("qore --exec-mode='ir' x.q"));
        assertEq(NOTHING, ExecModeHarness::get_mode("qore x.q"));
        assertThrows("EXEC-MODE-HARNESS-ERROR", \ExecModeHarness::get_mode(),
            "qore --exec-mode=ast a.q; qore --exec-mode=jit b.q");
        # the native compilation of a command without an execution mode cannot be checked
        assertThrows("EXEC-MODE-HARNESS-ERROR", \ExecModeHarness::run(), sprintf("%s %s -b %s", env, qore_bin,
            toplevel));
        hash<ExecModeHarness::ModeRunResult> r = ExecModeHarness::run_command(sprintf("%s %s -b %s", env, qore_bin,
            toplevel));
        assertEq(NOTHING, r.mode);
        assertEq("3\n", r.out);
        # run_any() runs a command without an execution mode, and checks one with an execution mode
        assertEq("3\n", ExecModeHarness::run_any(sprintf("%s %s -b %s", env, qore_bin, toplevel)));
        assertEq("3\n", ExecModeHarness::run_any(sprintf("%s %s -b --exec-mode=jit %s", env, qore_bin, toplevel)));
        assertThrows("EXEC-MODE-NATIVE-ERROR", \ExecModeHarness::run_any(), (sprintf("%s %s -b --exec-mode=jit %s",
            env, qore_bin, parse_error),));
    }

    testTopLevel() {
        # with JIT execution, top-level code is compiled before it runs
        hash<ExecModeHarness::ModeRunResult> r = runScript("jit", toplevel);
        assertEq("3\n", r.out);
        assertEq(1, (select r.trace, $1 =~ /^\[JIT\] compiled '.*' synchronously$/).size(), r.trace.join("\n"));
        ExecModeHarness::check_native(r);
        # tiered execution runs top-level code, which runs once, with the IR interpreter
        r = runScript("tiered", toplevel);
        assertEq("3\n", r.out);
        assertEq((), r.trace);
        ExecModeHarness::check_native(r, ExecModeHarness::NativeCheck::Jit);
        assertThrows("EXEC-MODE-NATIVE-ERROR", \ExecModeHarness::check_native(), (r,
            ExecModeHarness::NativeCheck::JitAndTiered));
        # native code with tiered execution is required by default
        assertEq(ExecModeHarness::NativeCheck::JitAndTiered, ExecModeHarness::get_default_check());
        assertThrows("EXEC-MODE-NATIVE-ERROR", \ExecModeHarness::check_native(), (r,));
        # unless the harness makes JIT execution its default
        ExecModeHarness::set_default_check(ExecModeHarness::NativeCheck::Jit);
        on_exit ExecModeHarness::set_default_check(ExecModeHarness::NativeCheck::JitAndTiered);
        ExecModeHarness::check_native(r);
        foreach string mode in (("ast", "ir")) {
            r = runScript(mode, toplevel);
            assertEq("3\n", r.out, mode);
            assertEq((), r.trace, mode);
            ExecModeHarness::check_native(r, ExecModeHarness::NativeCheck::JitAndTiered);
        }
    }

    testFunctions() {
        foreach string mode in (ExecModeHarness::ExecModes) {
            assertEq("6\n", ExecModeHarness::run(sprintf("%s %s -b --exec-mode=%s %s", env, qore_bin, mode,
                function), ExecModeHarness::NativeCheck::JitAndTiered), mode);
        }
        # f(), called through a call reference, runs on the IR tier in its first call, which compiles it
        hash<ExecModeHarness::ModeRunResult> r = runScript("tiered", function);
        assertEq(1, (select r.trace, $1 =~ /^\[BG-JIT\] compiled 'f@.*' and promoted to JIT tier$/).size(),
            r.trace.join("\n"));
    }

    testIRTier() {
        # tiered execution with the harness's environment compiles functions called by name before they run
        hash<ExecModeHarness::ModeRunResult> r = runScript("tiered", loop);
        assertEq("12497500\n12497500\n12497500\n", r.out);
        assertTrue((select r.trace, ExecModeHarness::is_native_compilation($1)).size() > 0, r.trace.join("\n"));
        # the IR tier run compiles nothing, though hot() runs a loop of 5000 iterations in each call
        foreach string script in ((loop, function)) {
            r = ExecModeHarness::run_command(sprintf("%s %s -b --exec-mode=tiered %s", env, qore_bin, script), True,
                ExecModeHarness::IRTierEnv);
            assertEq((), (select r.trace, ExecModeHarness::is_native_compilation($1)), r.trace.join("\n"));
            ExecModeHarness::check_ir_tier(r);
        }
        assertEq("12497500\n12497500\n12497500\n", ExecModeHarness::run_ir_tier(sprintf("%s %s -b "
            "--exec-mode=tiered %s", env, qore_bin, loop)));
        assertEq("6\n", ExecModeHarness::run_ir_tier(sprintf("%s %s -b --exec-mode=tiered %s", env, qore_bin,
            function)));

        # a closure runs on the IR tier from its first call, which lowers it: the call that promotes a function to the IR
        # tier runs on it
        r = ExecModeHarness::run_command(sprintf("%s %s -b --exec-mode=tiered %s", env, qore_bin, closures), True,
            ExecModeHarness::IRTierEnv);
        assertEq("12\n", r.out);
        assertEq((), (select r.trace, ExecModeHarness::is_ast_trace_line($1)), r.trace.join("\n"));
        assertEq("12\n", ExecModeHarness::run_ir_tier(sprintf("%s %s -b --exec-mode=tiered %s", env, qore_bin,
            closures)));

        # negative: code that runs on the AST interpreter in an IR tier run fails it; the trace is not output
        r = ExecModeHarness::run_command(sprintf("%s %s -b --exec-mode=tiered %s", env, qore_bin, old_style), True,
            ExecModeHarness::IRTierEnv);
        assertEq("6\n", r.out);
        assertTrue((select r.trace, ExecModeHarness::is_ast_trace_line($1)).size() > 0, r.trace.join("\n"));
        assertThrows("EXEC-MODE-IR-ERROR", "the IR tier run ran code on the AST interpreter",
            \ExecModeHarness::check_ir_tier(), (r,));
        assertThrows("EXEC-MODE-IR-ERROR", \ExecModeHarness::run_ir_tier(), (sprintf("%s %s -b --exec-mode=tiered "
            "%s", env, qore_bin, old_style),));
        assertTrue(ExecModeHarness::is_ast_trace_line("[ir-ast-tier] f"));
        assertTrue(ExecModeHarness::is_ast_trace_line("[ir-fallback] lowering: x"));
        assertTrue(ExecModeHarness::is_trace_line("[ir-fallback] lowering: x"));
        assertFalse(ExecModeHarness::is_ast_trace_line("[BG-JIT] compiled 'f@1_0' and promoted to JIT tier"));
        foreach string line in (("[ir-ast-tier] f", "[ir-fallback] lowering: unsupported")) {
            hash<ExecModeHarness::ModeRunResult> sr = <ExecModeHarness::ModeRunResult>{
                "mode": "tiered",
                "out": "",
                "stdout": "",
                "stderr": "",
                "trace": (line,),
                "rc": 0,
            };
            assertThrows("EXEC-MODE-IR-ERROR", \ExecModeHarness::check_ir_tier(), (sr,), line);
        }

        # negative: the IR tier is a tier of tiered execution
        foreach string mode in (("ast", "ir", "jit")) {
            assertThrows("EXEC-MODE-HARNESS-ERROR", \ExecModeHarness::run_ir_tier(), (sprintf("%s %s -b "
                "--exec-mode=%s %s", env, qore_bin, mode, loop),), mode);
        }
        assertThrows("EXEC-MODE-HARNESS-ERROR", \ExecModeHarness::run_ir_tier(), (sprintf("%s %s -b %s", env,
            qore_bin, loop),));
        # negative: native code in an IR tier run
        r = <ExecModeHarness::ModeRunResult>{
            "mode": "tiered",
            "out": "",
            "stdout": "",
            "stderr": "",
            "trace": ("[BG-JIT] compiled 'f@1_0' and promoted to JIT tier",),
            "rc": 0,
        };
        assertThrows("EXEC-MODE-NATIVE-ERROR", "the IR tier run compiled code to native code",
            \ExecModeHarness::check_ir_tier(), (r,));
    }

    testLoaderWarnings() {
        assertTrue(ExecModeHarness::is_loader_warning(StaleWarning));
        assertTrue(ExecModeHarness::is_loader_warning(FallbackWarning));
        assertFalse(ExecModeHarness::is_loader_warning("warning: something else"));
        assertFalse(ExecModeHarness::is_loader_warning("err"));
        # the warnings, which a test run with other binary modules than its build gets, are not the script's output
        hash<ExecModeHarness::ModeRunResult> r = runScript("jit", loader_warning);
        assertEq("out\nerr\n", r.out);
        assertEq("out\n", r.stdout);
        assertEq("err\n", r.stderr);
        assertEq((StaleWarning, FallbackWarning), r.loader_warnings);
        assertEq(0, r.rc);

        # the warnings of a module loaded by a %requires directive of the script are written as parse warnings
        string fallback_parse = "BINARY-MODULE-SOURCE-FALLBACK" + FallbackWarning.substr(7);
        string stale_parse = "BINARY-MODULE-SOURCE-FALLBACK" + StaleWarning.substr(7);
        assertTrue(ExecModeHarness::is_loader_warning(fallback_parse));
        assertTrue(ExecModeHarness::is_loader_warning(stale_parse));
        assertFalse(ExecModeHarness::is_loader_warning("BINARY-MODULE-SOURCE-FALLBACK: something else"));
        string header = "warning encountered at script.q:2 (Qore builtin code)";
        string other_header = "warning encountered at script.q:5 (Qore builtin code)";
        string other = "UNREACHABLE-CODE: code after this statement can never be reached";
        # alone, after another warning, before another warning, and between loader warnings
        list<hash<auto>> cases = (
            {"lines": (header, fallback_parse), "rest": ()},
            {"lines": (other_header, other, "next warning:", header, fallback_parse), "rest": (other_header, other)},
            {"lines": (header, fallback_parse, "next warning:", other_header, other), "rest": (other_header, other)},
            {"lines": (header, stale_parse, "next warning:", header, fallback_parse), "rest": ()},
            {"lines": (header, stale_parse, "next warning:", other_header, other, "next warning:", header,
                fallback_parse), "rest": (other_header, other)},
            # the code alone without the location line is not a loader warning of qore
            {"lines": ("err", fallback_parse), "rest": ("err", fallback_parse), "warnings": ()},
            # a location line followed by another warning is kept
            {"lines": (header, other), "rest": (header, other), "warnings": ()},
        );
        foreach hash<auto> c in (cases) {
            hash<auto> h = LoaderWarnings::split_loader_warning_lines(c.lines);
            assertEq(c.rest, h.lines, sprintf("case %d", $#));
            *list<string> expected_warnings = c.warnings ?? (select c.lines, $1 =~ /^BINARY-MODULE/);
            assertEq(expected_warnings ?? (), h.warnings, sprintf("case %d", $#));
            # the same with line breaks
            hash<auto> t = LoaderWarnings::split_loader_warnings((map $1 + "\n", c.lines).join(""));
            assertEq((map $1 + "\n", c.rest).join(""), t.text, sprintf("case %d text", $#));
            assertEq(expected_warnings ?? (), t.warnings, sprintf("case %d text", $#));
        }

        r = runScript("jit", parse_loader_warning);
        assertEq("out\nerr\n", r.out);
        assertEq("err\n", r.stderr);
        assertEq((fallback_parse,), r.loader_warnings);
        assertEq(0, r.rc);
    }

    testOutput() {
        # the output on stderr that is not part of the trace follows the output on stdout
        hash<ExecModeHarness::ModeRunResult> r = runScript("jit", output);
        assertEq("out\nerr\n", r.out);
        assertEq("out\n", r.stdout);
        assertEq("err\n", r.stderr);
        assertEq(3, r.rc);
        assertEq("jit", r.mode);
        # a shell command that adds to the output
        assertEq("out\nexit=3\nerr\n", ExecModeHarness::run(sprintf("%s %s -b --exec-mode=jit %s; echo exit=$?",
            env, qore_bin, output)));
    }

    testChecks() {
        # a script that does not parse runs no code
        hash<ExecModeHarness::ModeRunResult> r = runScript("jit", parse_error);
        assertEq((), r.trace);
        assertRegex("PARSE-EXCEPTION", r.out);
        assertThrows("EXEC-MODE-NATIVE-ERROR", "--exec-mode=jit ran no native code", \ExecModeHarness::check_native(),
            (r,));
        # unless no native code is required
        ExecModeHarness::check_native(r, ExecModeHarness::NativeCheck::None);
        assertThrows("EXEC-MODE-NATIVE-ERROR", \ExecModeHarness::run(), (sprintf("%s %s -b --exec-mode=jit %s", env,
            qore_bin, parse_error),));
        # code compiled with an interpreter
        r = <ExecModeHarness::ModeRunResult>{
            "mode": "ir",
            "out": "",
            "stdout": "",
            "stderr": "",
            "trace": ("[BG-JIT] compiled 'f@1_0' and promoted to JIT tier",),
            "rc": 0,
        };
        assertThrows("EXEC-MODE-NATIVE-ERROR", "--exec-mode=ir compiled code to native code",
            \ExecModeHarness::check_native(), (r,));
        assertThrows("EXEC-MODE-NATIVE-ERROR", "--exec-mode=ir compiled code to native code",
            \ExecModeHarness::check_native(), (r, ExecModeHarness::NativeCheck::JitAndTiered));
        # unless nothing is checked, as for a script that runs a child Program with JIT execution
        ExecModeHarness::check_native(r, ExecModeHarness::NativeCheck::None);
    }

    private hash<ExecModeHarness::ModeRunResult> runScript(string mode, string script) {
        return ExecModeHarness::run_command(sprintf("%s %s -b --exec-mode=%s %s", env, qore_bin, mode, script), True);
    }

    private string write(string name, string code) {
        string path = tmp.path + DirSep + name;
        File f();
        f.open2(path, O_CREAT | O_WRONLY | O_TRUNC);
        f.write(code);
        return path;
    }
}
