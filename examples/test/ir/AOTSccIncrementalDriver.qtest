#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
#
# Copyright (C) 2003 - 2026 Qore Technologies, s.r.o.
#
# Drives qore-qo-incremental against a fabricated object group whose compiler
# changes the dependency graph while it runs.
#
# This is the failure the SCC scheduler exists to survive: a compile rewrites
# its own depfile, qore-qo-source-order promotes depfile entries to required
# edges, and the strongly connected components are renumbered underneath every
# other builder.  A driver that carries a component index from one helper
# process to the next then compiles one source against another component's
# preload and publishes the result as if it were current.  These tests hold the
# driver to the two properties that prevent it: it addresses its component by a
# name that survives the transition, and it reports a transition as its own
# doing rather than as an external source edit.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil
%requires Util
%requires json

%exec-class AOTSccIncrementalDriverTest

class AOTSccIncrementalDriverTest inherits QUnit::Test {
    private {
        string qore_bin;
        string tools_dir;
        string source_order_tool;
        string incremental_tool;

        #! Above pid_max on every platform these tests run on, so it is dead.
        const DeadPid = 2147483647;

        const MemberArtifactSuffixes = (
            "", ".status.json", ".content.stamp", ".compile-contract.stamp",
            ".aggregate-contract.stamp", ".stamp", ".source.manifest.json",
            ".source-parse-defines",
        );
    }

    constructor() : QUnit::Test("AOTSccIncrementalDriverTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        tools_dir = normalize_dir(get_script_dir() + "/../../../tools");
        source_order_tool = tools_dir + DirSep + "qore-qo-source-order";
        incremental_tool = tools_dir + DirSep + "qore-qo-incremental";

        addTestCase("a stale component compiles and publishes exactly once",
            \testPublishesOnceWithoutRetry());
        addTestCase("a graph transition is survived without blaming the sources",
            \testGraphTransitionIsSurvivedAndAttributed());
        addTestCase("a compile is preloaded from its own component's predecessors",
            \testPreloadFollowsTheComponentNotTheIndex());
        addTestCase("an external source edit is still reported as one",
            \testExternalSourceEditIsReported());
        addTestCase("a frozen graph removes the transition entirely",
            \testFrozenGraphRemovesTheTransition());
        addTestCase("the coordinator plans, compiles and verifies against one graph",
            \testCoordinatorConvergesInOneInvocation());
        addTestCase("a scheduled recipe uses the coordinator's currency rule",
            \testScheduledRecipeSharesTheCoordinatorsRule());
        addTestCase("a scheduled recipe starts the shared parse it cannot replace",
            \testScheduledRecipeStartsTheSharedParseItCannotReplace());
        addTestCase("a scheduled recipe parses only its own component",
            \testScheduledRecipeParsesOnlyItsOwnComponent());
        addTestCase("a group configured without a shared parse still builds",
            \testScheduledRecipeBuildsAGroupWithoutASharedParse());
        addTestCase("the bootstrap hands the stale set to the coordinator",
            \testBootstrapHandsTheStaleSetToTheCoordinator());
        addTestCase("the batch is chosen from what a rebuild reaches, not from what is stale",
            \testPlanChoosesTheBatchFromTheConsumerClosure());
        addTestCase("concurrent recipes publish one coherent generation",
            \testConcurrentRecipesPublishOneGeneration());
        addTestCase("a stale lock survives losing the race to reclaim it",
            \testStaleLockReclaimSurvivesARacingRemover());

        set_return_value(main());
    }

    private write(string path, string body) {
        File f();
        f.open2(path, O_WRONLY | O_CREAT | O_TRUNC);
        f.write(body);
        f.close();
    }

    private string read(string path) {
        return is_file(path) ? ReadOnlyFile::readTextFile(path) : "";
    }

    private string isolatedSource(string name) {
        return sprintf("%%new-style\nstring sub %sFunc() {\n    return \"%s\";\n}\n",
            name, name);
    }

    #! Writes NAME's depfile so that it records a compile against \a providers.
    private writeDepfile(string qo_dir, string name, softlist<string> providers) {
        list<string> deps = (dirname(qo_dir) + "/src/" + name + ".qc",);
        foreach string provider in (providers) {
            push deps, qo_dir + "/" + provider + ".qo.compile-contract.stamp";
        }
        write(qo_dir + "/" + name + ".qo.d",
            qo_dir + "/" + name + ".qo.stamp:"
            + join("", (map " \\\n    " + $1, deps)) + "\n");
    }

    private writeArtifacts(string qo_dir, string name) {
        foreach string suffix in (MemberArtifactSuffixes) {
            write(qo_dir + "/" + name + ".qo" + suffix, name + suffix + "\n");
        }
        write(qo_dir + "/" + name + ".qo.idx.json",
            make_json(("source_parse_defines": ())) + "\n");
    }

    #! A group of four independent sources whose only edges come from depfiles.
    /** a and b are made mutually dependent, so they condense into one component
        and the decomposition is {a,b}, {c}, {d}.  Dropping one of those two
        depfile edges splits the pair and renumbers everything after it.
    */
    private hash<auto> fixture(string root, *softlist<string> compiled,
            bool cyclic = True, *list<string> extra) {
        string src_dir = root + "/src";
        string qo_dir = root + "/qo";
        mkdir(src_dir, 0777, True);
        mkdir(qo_dir, 0777, True);
        list<string> names = ("a", "b", "c", "d") + (extra ?? ());
        list<string> lines = ("format=1", "kind=qcc-object-group",
            "group=scc-driver-test");
        foreach string name in (names) {
            write(src_dir + "/" + name + ".qc", isolatedSource(name));
        }
        foreach string name in (names) {
            push lines, "input=" + src_dir + "/" + name + ".qc";
        }
        foreach string name in (names) {
            push lines, "output=" + qo_dir + "/" + name + ".qo";
        }
        write(qo_dir + "/.qcc-context", join("\n", lines) + "\n");
        foreach string name in (names) {
            writeArtifacts(qo_dir, name);
        }
        writeDepfile(qo_dir, "a", cyclic ? "b" : ());
        writeDepfile(qo_dir, "b", cyclic ? "a" : ());
        writeDepfile(qo_dir, "c", "a");
        writeDepfile(qo_dir, "d", ());
        foreach string name in (extra ?? ()) {
            writeDepfile(qo_dir, name, ());
        }
        # A component only counts as published once it has a generation record,
        # so the members that are meant to start out current get one.
        foreach string name in (compiled ?? ()) {
            hash<auto> component = componentFor(qo_dir, name);
            runTool(("--scc-publish", qo_dir + "/.qcc-context", component.key));
        }
        return ("root": root, "src_dir": src_dir, "qo_dir": qo_dir,
            "context": qo_dir + "/.qcc-context", "names": names);
    }

    #! Writes the stand-in for qcc-single.sh that the driver invokes.
    /** \a mutation is a shell fragment run once, on the first compile only,
        while the driver believes a compile is in progress.  That is the window
        a real qcc occupies when it rewrites its own depfile.
    */
    private string writeCompiler(hash<auto> fx, *string mutation) {
        string script = fx.qo_dir + "/qcc-single.sh";
        string log = fx.qo_dir + "/compiles.log";
        string once = fx.qo_dir + "/mutation.pending";
        string body = "#!/bin/sh\nset -e\n"
            + "src=$1\nout=$2\npreload_dir=$3\n"
            + "printf '%s %s\\n' \"$(basename \"$src\")\" \"$(basename \"$out\")\" >> "
            + sprintf("%y", log) + "\n"
            + "( cd \"$preload_dir\" && ls ) > \"$out.preload.observed\" 2>/dev/null "
            + "|| : > \"$out.preload.observed\"\n";
        if (exists mutation) {
            write(once, "pending\n");
            # The claim is one rename, not a test followed by a removal.  These
            # compiles run concurrently, so two of them can pass the same
            # existence test; the loser then removes a file that is already
            # gone, and `rm -f` does not make that harmless everywhere --
            # busybox reports an ENOENT unlink that follows a successful lstat
            # and exits non-zero, which under `set -e` fails that compile
            # instead of running the mutation once.  GNU coreutils ignores the
            # same errno, which is why only the musl/busybox jobs ever saw it.
            # rename(2) has exactly one winner and cannot fail that way.
            body += "if mv " + sprintf("%y", once) + " "
                + sprintf("%y", once + ".taken") + " 2>/dev/null; then\n"
                + mutation + "\nfi\n";
        }
        foreach string suffix in (MemberArtifactSuffixes) {
            body += "printf 'compiled\\n' > \"$out" + suffix + "\"\n";
        }
        body += "printf '%s\\n' '{\"source_parse_defines\": []}' > \"$out.idx.json\"\n";
        write(script, body);
        chmod(script, 0755);
        return script;
    }

    #! Writes the stand-in for qcc-batch.sh: one parse that writes the group.
    /** The batch is the only builder for a component that spans several sources,
        and the one the coordinator selects for a broad invalidation.  It writes
        every member of the group, which is what makes "the group was built as
        one unit" observable in the same compile log the standalone path uses.
    */
    private string writeBatchCompiler(hash<auto> fx) {
        string script = fx.qo_dir + "/qcc-batch.sh";
        string log = fx.qo_dir + "/compiles.log";
        string body = "#!/bin/sh\nset -e\n";
        foreach string name in (fx.names) {
            string out = fx.qo_dir + "/" + name + ".qo";
            body += "printf 'batch %s\\n' " + sprintf("%y", name + ".qo") + " >> "
                + sprintf("%y", log) + "\n";
            foreach string suffix in (MemberArtifactSuffixes) {
                body += "printf 'compiled\\n' > " + sprintf("%y", out + suffix) + "\n";
            }
            body += "printf '%s\\n' '{\"source_parse_defines\": []}' > "
                + sprintf("%y", out + ".idx.json") + "\n";
        }
        write(script, body);
        chmod(script, 0755);
        return script;
    }

    #! A stand-in for qcc-subset.sh: compiles exactly the sources it is given.
    /** The real script takes the preload directory as its first argument, parses
        the sources that follow together, and resolves what it did not compile
        from the objects staged in that directory.  What matters to the driver is
        which sources reach it, so the stand-in drops the directory, logs them and
        writes the artifacts each one publishes.
    */
    private string writeSubsetCompiler(hash<auto> fx) {
        string script = fx.qo_dir + "/qcc-subset.sh";
        string log = fx.qo_dir + "/compiles.log";
        string body = "#!/bin/sh\nset -e\npreload_dir=$1\nshift\n"
            + "for src in \"$@\"; do\n"
            + "    name=$(basename \"$src\" .qc)\n"
            + "    out=" + sprintf("%y", fx.qo_dir) + "/$name.qo\n"
            + "    printf 'subset %s\\n' \"$name.qo\" >> " + sprintf("%y", log) + "\n";
        foreach string suffix in (MemberArtifactSuffixes) {
            body += "    printf 'compiled\\n' > \"$out" + suffix + "\"\n";
        }
        body += "    printf '%s\\n' '{\"source_parse_defines\": []}' > \"$out.idx.json\"\n"
            + "done\n";
        write(script, body);
        chmod(script, 0755);
        return script;
    }

    private hash<auto> runTool(softlist<string> args) {
        list<string> command = (sprintf("%y", qore_bin), sprintf("%y", source_order_tool));
        foreach string arg in (args) {
            push command, sprintf("%y", arg);
        }
        string output = backquote("{ " + join(" ", command) + "; } 2>&1; echo \"rc=$?\"");
        int marker = output.rfind("rc=");
        return ("output": output.substr(0, marker),
            "rc": output.substr(marker + 3).toInt());
    }

    private hash<auto> componentFor(string qo_dir, string name) {
        hash<auto> result = runTool(("--scc-for", qo_dir + "/.qcc-context",
            qo_dir + "/" + name + ".qo"));
        assertEq(0, result.rc, "--scc-for " + name + ": " + result.output);
        list<string> fields = trim(result.output).split("\t");
        return ("index": fields[0], "key": fields[1], "size": fields[2]);
    }

    private string graphGeneration(hash<auto> fx) {
        hash<auto> result = runTool(("--scc-graph-generation", fx.context));
        assertEq(0, result.rc, "--scc-graph-generation: " + result.output);
        return trim(result.output);
    }

    #! Writes a `rm` that loses the race to remove a lock, and says so.
    /** Reclaiming an abandoned lock is a decision followed by a removal, and
        two waiters that inspected the same lock both decide to remove it.  The
        loser unlinks a path that is already gone, and what it reports is not
        the same everywhere: GNU coreutils absorbs an ENOENT unlink under
        \c -f, while busybox reports it and exits non-zero, because \c -f is
        consulted only when the preceding \c lstat(2) failed.  The race is not
        schedulable, so this stands in for the loser's view of it: the lock is
        removed and then reported missing, exactly as busybox would.

        \return the directory to prepend to PATH.
    */
    private string writeRacingRemover(hash<auto> fx) {
        string dir = fx.root + "/racing-bin";
        mkdir(dir, 0777, True);
        # The shim must call the real utility by absolute path, or it re-enters
        # itself through the PATH it was installed on.
        string real = trim(backquote("command -v rm"));
        if (!real.startsWith("/")) {
            real = "/bin/rm";
        }
        write(dir + "/rm",
            "#!/bin/sh\n"
            + "for arg in \"$@\"; do\n"
            + "    case $arg in\n"
            + "        *.lock)\n"
            + "            if [ -e \"$arg\" ]; then\n"
            + "                " + sprintf("%y", real) + " -f \"$arg\"\n"
            + "                echo \"rm: can't remove '$arg': "
                + "No such file or directory\" >&2\n"
            + "                exit 1\n"
            + "            fi\n"
            + "            ;;\n"
            + "    esac\n"
            + "done\n"
            + "exec " + sprintf("%y", real) + " \"$@\"\n");
        chmod(dir + "/rm", 0755);
        return dir;
    }

    #! Runs the driver the way qore-qo-incremental-plan runs it for a stale component.
    /** \a path_prefix is prepended to PATH, which is how a test replaces one of
        the utilities the driver shells out to.
    */
    private hash<auto> drive(hash<auto> fx, string name, hash<auto> component,
            *string snapshot, *string path_prefix) {
        string qo_dir = fx.qo_dir;
        string command = exists path_prefix
            ? sprintf("PATH=%y ", path_prefix + ":" + ENV.PATH)
            : "";
        command += sprintf(
            "QORE_QCC_PLANNED_STALE=1 QORE_QCC_COMPONENT_INDEX=%y "
            "QORE_QCC_COMPONENT_KEY=%y QORE_QCC_COMPONENT_SIZE=%y "
            "QORE_QCC_COMPONENT_LOCK=%y QORE_QCC_PREREQUISITES_READY=1 "
            "QORE_QCC_QORE_EXECUTABLE=%y QORE_QCC_SOURCE_ORDER_HELPER=%y ",
            component.index, component.key, component.size,
            qo_dir + "/.qcc-scc/" + component.key + ".lock",
            qore_bin, source_order_tool);
        if (exists snapshot) {
            command += sprintf("QORE_QCC_GRAPH_SNAPSHOT=%y ", snapshot);
        }
        command += sprintf("%y %y %y %y", incremental_tool,
            qo_dir + "/" + name + ".qo", fx.src_dir + "/" + name + ".qc",
            qo_dir + "/qcc-single.sh");
        string output = backquote("{ " + command + "; } 2>&1; echo \"rc=$?\"");
        int marker = output.rfind("rc=");
        return ("output": output.substr(0, marker),
            "rc": output.substr(marker + 3).toInt());
    }

    #! Runs the group coordinator the way the build's plan target does.
    private hash<auto> plan(hash<auto> fx) {
        string qo_dir = fx.qo_dir;
        # The coordinator refuses to start without a batch script.  A test that
        # expects the shared parse installs a working one first; for every other
        # test this stand-in is never invoked, and says so loudly if the plan
        # ever reaches for it.
        if (!is_file(qo_dir + "/qcc-batch.sh")) {
            write(qo_dir + "/qcc-batch.sh",
                "#!/bin/sh\necho 'the plan should not have needed the batch' >&2\nexit 9\n");
            chmod(qo_dir + "/qcc-batch.sh", 0755);
        }
        # A component published before the group's last shared parse is stale by
        # definition, so the stamp that dates that parse has to exist for any
        # component to be able to reach currency at all.
        if (!is_file(qo_dir + "/.qcc-batch-bootstrap.stamp")) {
            write(qo_dir + "/.qcc-batch-bootstrap.stamp", "bootstrapped\n");
        }
        string command = sprintf("QORE_QCC_QORE_EXECUTABLE=%y QORE_QCC_GRAPH_SNAPSHOT=%y "
            "%y %y %y %y %y %y %y %y %y",
            qore_bin, fx.context + ".graph-snapshot.json",
            tools_dir + DirSep + "qore-qo-incremental-plan",
            fx.context, qo_dir + "/.qcc-incremental-plan.stamp",
            qo_dir + "/.qcc-batch-bootstrap.stamp", qo_dir + "/qcc-batch.sh",
            qo_dir + "/qcc-single.sh", source_order_tool, incremental_tool,
            tools_dir + DirSep + "qore-qo-batch-bootstrap");
        string output = backquote("{ " + command + "; } 2>&1; echo \"rc=$?\"");
        int marker = output.rfind("rc=");
        return ("output": output.substr(0, marker),
            "rc": output.substr(marker + 3).toInt());
    }

    #! Runs the bootstrap recipe the way CMake's custom command does.
    private hash<auto> bootstrap(hash<auto> fx) {
        string qo_dir = fx.qo_dir;
        string command = sprintf("QORE_QCC_QORE_EXECUTABLE=%y %y %y %y %y %y",
            qore_bin, tools_dir + DirSep + "qore-qo-batch-bootstrap",
            fx.context, qo_dir + "/.qcc-batch-bootstrap.stamp",
            qo_dir + "/qcc-batch.sh", source_order_tool);
        string output = backquote("{ " + command + "; } 2>&1; echo \"rc=$?\"");
        int marker = output.rfind("rc=");
        return ("output": output.substr(0, marker),
            "rc": output.substr(marker + 3).toInt());
    }

    private *hash<auto> record(hash<auto> fx, string key) {
        string path = fx.qo_dir + "/.qcc-scc/" + key + ".generation.json";
        return is_file(path) ? parse_json(read(path)) : NOTHING;
    }

    private list<string> compiles(hash<auto> fx) {
        list<string> result = ();
        foreach string line in (read(fx.qo_dir + "/compiles.log").split("\n")) {
            if (line) {
                push result, line;
            }
        }
        return result;
    }

    testPublishesOnceWithoutRetry() {
        TmpDir tmp("qore-aot-driver-once-");
        hash<auto> fx = fixture(tmp.path);
        writeCompiler(fx);

        hash<auto> component = componentFor(fx.qo_dir, "d");
        string generation = graphGeneration(fx);
        hash<auto> result = drive(fx, "d", component);

        assertEq(0, result.rc, "the driver succeeds: " + result.output);
        assertEq(("d.qc d.qo",), compiles(fx),
            "the component is compiled exactly once");
        assertEq(-1, result.output.find("moved"),
            "no source movement is reported: " + result.output);
        assertEq(-1, result.output.find("rebuilding"),
            "no rebuild is required: " + result.output);
        *hash<auto> published = record(fx, component.key);
        assertTrue(exists published, "the component's generation record is published");
        assertEq(component.key, published.scc, "the record names the component");
        assertEq(generation, published.graph_generation,
            "the record names the graph the compile was planned against");
    }

    testGraphTransitionIsSurvivedAndAttributed() {
        TmpDir tmp("qore-aot-driver-transition-");
        hash<auto> fx = fixture(tmp.path, ("a", "c"));
        string qo_dir = fx.qo_dir;

        hash<auto> before = componentFor(qo_dir, "d");
        hash<auto> neighbour = componentFor(qo_dir, "c");
        assertNeq(before.key, neighbour.key, "d and c are distinct components");

        # While d compiles, b stops depending on a.  The cycle splits, every
        # component after it is renumbered, and d's old index comes to name c.
        writeCompiler(fx, "printf '%s' " + sprintf("%y",
            qo_dir + "/b.qo.stamp: " + fx.src_dir + "/b.qc\n") + " > "
            + sprintf("%y", qo_dir + "/b.qo.d"));
        string neighbour_generation = record(fx, neighbour.key).generation;

        hash<auto> result = drive(fx, "d", before);
        assertEq(0, result.rc, "the driver converges: " + result.output);

        hash<auto> after = componentFor(qo_dir, "d");
        assertEq(before.key, after.key, "d keeps its component key");
        assertNeq(before.index, after.index,
            "the transition really did renumber the components");
        assertEq(before.index, componentFor(qo_dir, "c").index,
            "d's old index now names c, which is what an index-addressed driver "
                "would have published");

        # The driver must have said what actually happened.
        assertTrue(result.output.find("dependency graph changed") >= 0,
            "the transition is reported as a graph change: " + result.output);
        assertEq(-1, result.output.find("something other than this build"),
            "nothing outside the build is blamed: " + result.output);
        assertEq(("d.qc d.qo", "d.qc d.qo"), compiles(fx),
            "only d is compiled, once per attempt, and c is never compiled");

        # Publication landed on d, and c -- the component that inherited d's old
        # index -- was not republished behind its own back.
        *hash<auto> published = record(fx, after.key);
        assertTrue(exists published, "d's generation record is published");
        assertEq(graphGeneration(fx), published.graph_generation,
            "d is published against the graph that superseded the plan");
        assertEq(neighbour_generation, record(fx, neighbour.key).generation,
            "c's published generation is untouched");
    }

    testPreloadFollowsTheComponentNotTheIndex() {
        TmpDir tmp("qore-aot-driver-preload-");
        hash<auto> fx = fixture(tmp.path, ("a",));
        string qo_dir = fx.qo_dir;

        # c requires a, which is in the a<->b component, so c must be compiled
        # against both members of that component and nothing else.
        hash<auto> component = componentFor(qo_dir, "c");
        writeCompiler(fx);
        assertEq(0, drive(fx, "c", component).rc, "c compiles");

        list<string> preloaded = ();
        foreach string line in (read(qo_dir + "/c.qo.preload.observed").split("\n")) {
            if (line) {
                push preloaded, line;
            }
        }
        assertEq(("a.qo", "a.qo.compile-contract.stamp", "a.qo.idx.json",
            "b.qo", "b.qo.compile-contract.stamp", "b.qo.idx.json"),
            sort(preloaded),
            "the preload holds every member of c's one predecessor component");
    }

    testExternalSourceEditIsReported() {
        TmpDir tmp("qore-aot-driver-edit-");
        hash<auto> fx = fixture(tmp.path);
        string qo_dir = fx.qo_dir;

        # An agent outside the build rewrites the member source while the
        # compiler is reading it, every time.  No amount of rebuilding can order
        # that, so the driver must stop and say so.
        string compiler = writeCompiler(fx);
        write(compiler, read(compiler)
            + "printf '# edited %s\\n' \"$$\" >> " + sprintf("%y",
                fx.src_dir + "/d.qc") + "\n");

        hash<auto> component = componentFor(qo_dir, "d");
        hash<auto> result = drive(fx, "d", component);

        assertEq(1, result.rc, "the driver fails: " + result.output);
        assertTrue(result.output.find("moved during compilation") >= 0,
            "the first attempt reports moved sources: " + result.output);
        assertTrue(result.output.find("something other than this build") >= 0,
            "the second attempt names the external agent: " + result.output);
        assertEq(-1, result.output.find("dependency graph"),
            "the build does not blame its own graph: " + result.output);
        assertEq(2, compiles(fx).size(),
            "the component is rebuilt exactly once before the driver gives up");
        assertFalse(exists record(fx, component.key),
            "nothing is published from an unpublishable compile");
    }

    #! The same race as above, with the graph frozen for the build step.
    /** Surviving a transition is the fallback.  Not having one is the fix: while
        the graph is frozen, a compile's own depfile rewrite is invisible to
        every other worker until the coordinator crosses to the next generation,
        so one invocation succeeds with no retry and no diagnostic.
    */
    testFrozenGraphRemovesTheTransition() {
        TmpDir tmp("qore-aot-driver-frozen-");
        hash<auto> fx = fixture(tmp.path, ("a", "c"));
        string qo_dir = fx.qo_dir;
        string snapshot = tmp.path + "/graph-snapshot.json";

        hash<auto> frozen = runTool(("--scc-freeze-graph", snapshot, fx.context));
        assertEq(0, frozen.rc, "the graph freezes: " + frozen.output);

        hash<auto> component = componentFor(qo_dir, "d");
        writeCompiler(fx, "printf '%s' " + sprintf("%y",
            qo_dir + "/b.qo.stamp: " + fx.src_dir + "/b.qc\n") + " > "
            + sprintf("%y", qo_dir + "/b.qo.d"));

        hash<auto> result = drive(fx, "d", component, snapshot);
        assertEq(0, result.rc, "the driver succeeds: " + result.output);
        assertEq(("d.qc d.qo",), compiles(fx),
            "the mid-compile depfile rewrite costs no rebuild");
        assertEq(-1, result.output.find("dependency graph"),
            "no transition is reported at all: " + result.output);
        assertEq(-1, result.output.find("moved"),
            "and nothing is reported as moved: " + result.output);
        assertEq(trim(frozen.output), record(fx, component.key).graph_generation,
            "publication names the frozen graph, not the one the compile left");
    }

    testCoordinatorConvergesInOneInvocation() {
        TmpDir tmp("qore-aot-driver-plan-");
        # Every component a singleton, so the plan stays on the incremental path
        # instead of delegating to the shared parse.
        hash<auto> fx = fixture(tmp.path, NOTHING, False);
        writeCompiler(fx);

        hash<auto> result = plan(fx);
        assertEq(0, result.rc, "the coordinator succeeds: " + result.output);
        assertTrue(is_file(fx.qo_dir + "/.qcc-incremental-plan.stamp"),
            "the plan stamp is written");
        assertTrue(is_file(fx.context + ".graph-snapshot.json"),
            "the coordinator leaves the graph it verified against frozen");
        assertTrue(result.output.find("scheduling against dependency graph") >= 0,
            "the coordinator says which graph it scheduled against: " + result.output);

        assertEq(("a.qc a.qo", "b.qc b.qo", "c.qc c.qo", "d.qc d.qo"),
            sort(compiles(fx)),
            "every stale component is compiled exactly once");
        assertEq(-1, result.output.find("moved"),
            "no source movement is reported: " + result.output);
        assertEq(-1, result.output.find("rebuilding"),
            "no component needs a rebuild: " + result.output);

        # Requirement of a coherent build: every published record names the one
        # graph generation the coordinator finished on.
        hash<auto> generation = runTool(("--scc-graph-generation", fx.context));
        assertEq(0, generation.rc, "the graph generation is readable");
        int published = 0;
        foreach string name in (fx.names) {
            hash<auto> component = componentFor(fx.qo_dir, name);
            *hash<auto> committed = record(fx, component.key);
            assertTrue(exists committed, name + " is published");
            assertEq(trim(generation.output), committed.graph_generation,
                name + " is published against the coordinator's final graph");
            ++published;
        }
        assertEq(4, published, "all four components are published");

        # A second invocation with nothing changed must do nothing at all.
        hash<auto> again = plan(fx);
        assertEq(0, again.rc, "the second invocation succeeds: " + again.output);
        assertEq(4, compiles(fx).size(),
            "a no-op build compiles nothing: " + again.output);

        # And the object recipes that run behind the coordinator must agree with
        # it, or the group compiles a second time in parallel behind its back.
        foreach string name in (fx.names) {
            hash<auto> component = componentFor(fx.qo_dir, name);
            hash<auto> verified = recipe(fx, name, component);
            assertEq(0, verified.rc, name + " recipe succeeds: " + verified.output);
        }
        assertEq(4, compiles(fx).size(),
            "no object recipe compiles behind the coordinator");
    }

    #! Runs the driver the way the build's per-object recipe runs it.
    /** The distinguishing input is QORE_QCC_PREREQUISITES_ORDERED: it says the
        group coordinator already scheduled this group, which makes the recipe a
        verifier rather than a second scheduler.
    */
    private hash<auto> recipe(hash<auto> fx, string name, hash<auto> component,
            *string subset_script) {
        string qo_dir = fx.qo_dir;
        # The partial parse is opt-in while a preloaded shell can carry a
        # declaration the parse itself makes; a caller that hands the recipe a
        # subset script is asking for it.
        string command = exists subset_script
            ? sprintf("QORE_QCC_SUBSET_PARSE=1 QORE_QCC_SUBSET_SCRIPT=%y ",
                subset_script)
            : "";
        command += sprintf(
            "QORE_QCC_PREREQUISITES_ORDERED=1 QORE_QCC_BATCH_BOOTSTRAP_STAMP=%y "
            "QORE_QCC_QORE_EXECUTABLE=%y QORE_QCC_SOURCE_ORDER_HELPER=%y "
            "QORE_QCC_BATCH_BOOTSTRAP_HELPER=%y QORE_QCC_GRAPH_SNAPSHOT=%y %y %y %y %y",
            qo_dir + "/.qcc-batch-bootstrap.stamp", qore_bin, source_order_tool,
            tools_dir + DirSep + "qore-qo-batch-bootstrap",
            fx.context + ".graph-snapshot.json", incremental_tool,
            qo_dir + "/" + name + ".qo", fx.src_dir + "/" + name + ".qc",
            qo_dir + "/qcc-single.sh");
        string output = backquote("{ " + command + "; } 2>&1; echo \"rc=$?\"");
        int marker = output.rfind("rc=");
        return ("output": output.substr(0, marker),
            "rc": output.substr(marker + 3).toInt());
    }

    #! A build input from outside the group must not split the two schedulers.
    /** The coordinator leaves those files to the build tool, which takes them as
        dependencies of its plan target.  A recipe that judged them itself would
        find its component stale after the coordinator found the whole group
        current, and every recipe in the group would reach that conclusion at
        once -- the concurrent fan-out the coordinator exists to replace.
    */
    testScheduledRecipeSharesTheCoordinatorsRule() {
        TmpDir tmp("qore-aot-driver-rule-");
        hash<auto> fx = fixture(tmp.path, NOTHING, False);
        writeCompiler(fx);
        assertEq(0, plan(fx).rc, "the coordinator brings the group current");
        assertEq(4, compiles(fx).size(), "one compile per component");

        # A depfile input from outside the group, newer than every published
        # object: the toolchain moving under a build that has already been
        # planned.  CMake reaches the coordinator when this happens; the recipe
        # must not reach a different verdict on its own.
        string external = tmp.path + "/toolchain.stamp";
        write(external, "newer\n");
        foreach string name in (fx.names) {
            write(fx.qo_dir + "/" + name + ".qo.d",
                ReadOnlyFile::readTextFile(fx.qo_dir + "/" + name + ".qo.d")
                    + "    " + external + "\n");
        }

        hash<auto> component = componentFor(fx.qo_dir, "d");

        # The two rules genuinely disagree here, which is what made the two
        # schedulers diverge.  The stricter one remains available to callers
        # entitled to schedule for themselves.
        assertEq(1, runTool(("--scc-current", fx.context, component.key)).rc,
            "an unscoped currency probe weighs external build inputs");
        assertEq(0, runTool(("--source-deps-only", "--scc-current", fx.context,
            component.key)).rc,
            "the coordinator's rule leaves them to the build tool");

        # The recipe must take the coordinator's side of that disagreement.
        hash<auto> verified = recipe(fx, "d", component);
        assertEq(0, verified.rc, "the scheduled recipe succeeds: " + verified.output);
        assertEq(4, compiles(fx).size(),
            "the scheduled recipe does not compile behind the coordinator");
    }

    #! Part of a group being stale is the coordinator's decision to make.
    /** The bootstrap recipe runs before the coordinator and used to parse the
        whole group for ANY staleness, so a module timestamp or one missing
        generation record reparsed every source before the coordinator was ever
        consulted.  It now reports what it found in the vocabulary currency
        already speaks: the members it found current get a stamp newer than the
        ordering token, and the ones it did not keep the older one, which is what
        "belongs to a previous bootstrap" means to every reader of that tree.
    */
    testBootstrapHandsTheStaleSetToTheCoordinator() {
        TmpDir tmp("qore-aot-driver-handover-");
        hash<auto> fx = fixture(tmp.path, NOTHING, False);
        writeCompiler(fx);
        # A tripwire, not a builder: reaching the group's shared parse for one
        # stale component is the behaviour this replaces.
        write(fx.qo_dir + "/qcc-batch.sh",
            "#!/bin/sh\necho 'the bootstrap should not have parsed the group' >&2\nexit 9\n");
        chmod(fx.qo_dir + "/qcc-batch.sh", 0755);
        assertEq(0, plan(fx).rc, "the coordinator brings the group current");

        hash<auto> stale = componentFor(fx.qo_dir, "d");
        unlink(fx.qo_dir + "/.qcc-scc/" + stale.key + ".generation.json");

        hash<auto> result = bootstrap(fx);
        assertEq(0, result.rc, "the bootstrap succeeds: " + result.output);
        assertEq(-1, result.output.find("one shared parse"),
            "and does not parse the group for one stale component: "
                + result.output);

        date token = hstat(fx.qo_dir + "/.qcc-batch-bootstrap.stamp").mtime;
        assertTrue(hstat(fx.qo_dir + "/d.qo.stamp").mtime < token,
            "the stale component stays older than the ordering token");
        foreach string name in (fx.names) {
            if (name == "d") {
                continue;
            }
            assertTrue(hstat(fx.qo_dir + "/" + name + ".qo.stamp").mtime >= token,
                sprintf("current member %s is dated after the token", name));
        }

        # And the coordinator that runs next rebuilds exactly that component.
        int before = compiles(fx).size();
        assertEq(0, plan(fx).rc, "the coordinator rebuilds what was handed to it");
        assertEq(before + 1, compiles(fx).size(),
            "one compile, for the one component that was stale: "
                + compiles(fx).join(", "));
    }

    #! The batch decision must weigh the consumer closure, not the stale set.
    /** A component's generation names its own sources and its DIRECT
        predecessors' published compile contracts, so editing one widely
        required source leaves exactly one component stale: its consumers still
        name the contract that source published last time.  They go stale the
        moment it is recompiled -- which is why the stale set understates the
        work by the size of the closure, and why deciding from it sent a
        group-wide invalidation down the standalone path.  The observed cost was
        one compile at a time on a 32-core host, followed by the shared parse
        recompiling everything the serial pass had just built.

        The fixture is that shape exactly: one stale component whose consumers
        are the rest of the group.  Holding the coordinator to the batch here is
        what stops the wasted serial pass from coming back.
    */
    testPlanChoosesTheBatchFromTheConsumerClosure() {
        TmpDir tmp("qore-aot-driver-closure-");
        list<string> extra = ();
        for (int i = 0; i < 10; ++i) {
            push extra, sprintf("p%02d", i);
        }
        # Every component a singleton, so nothing is routed to the shared parse
        # for spanning several sources; the decision can only come from the
        # closure.
        hash<auto> fx = fixture(tmp.path, NOTHING, False, extra);
        foreach string name in (extra) {
            writeDepfile(fx.qo_dir, name, "d");
        }
        writeCompiler(fx);
        writeBatchCompiler(fx);

        # A component published before the group's last shared parse is stale by
        # definition, so the marker must not be newer than any member stamp for
        # this fixture to be able to start out current.  Writing the marker first
        # and the stamps after establishes that without waiting for anything: the
        # comparison is strict, so the equal mtimes a whole-second filesystem
        # produces satisfy it too.
        write(fx.qo_dir + "/.qcc-batch-bootstrap.stamp", "bootstrapped\n");
        foreach string name in (fx.names) {
            write(fx.qo_dir + "/" + name + ".qo.stamp", "stamp\n");
        }
        assertEq(0, runTool(("--scc-publish-all", fx.context)).rc,
            "the fixture starts fully published");
        assertEq((), stalePlan(fx).stale, "and fully current");

        # One edited source, and nothing else.
        write(fx.src_dir + "/d.qc", isolatedSource("d") + "# edited\n");

        hash<auto> planned = stalePlan(fx);
        assertEq(1, planned.stale.size(),
            "exactly one component is stale: " + planned.output);
        assertTrue(planned.stale[0].source =~ /\/d\.qc$/,
            "and it is the edited one: " + planned.output);
        assertEq(extra.size() + 1, planned.closure,
            "its consumer closure is d and everything that requires it: "
                + planned.output);

        hash<auto> result = plan(fx);
        assertEq(0, result.rc, "the coordinator succeeds: " + result.output);
        assertTrue(result.output.find("selecting the shared-parse batch") >= 0,
            "the closure selects the shared parse: " + result.output);
        assertEq(-1, result.output.find("incrementally"),
            "and no component is compiled one at a time: " + result.output);

        # The compile log distinguishes the two builders, so "no standalone
        # compile ran first" is checked rather than inferred from timing.
        list<string> compiled = compiles(fx);
        assertEq(fx.names.size(), (select compiled, $1 =~ /^batch /).size(),
            "the shared parse writes every member: " + compiled.join(", "));
        assertEq((), (select compiled, $1 !~ /^batch /),
            "and nothing is compiled standalone: " + compiled.join(", "));

        assertEq((), stalePlan(fx).stale,
            "the group is current when the coordinator returns");
    }

    #! Reads the coordinator's stale plan: its rows and its closure size.
    private hash<auto> stalePlan(hash<auto> fx) {
        hash<auto> result = runTool(("--scc-source-stale", "--rebuild-closure",
            "--batch-stamp", fx.qo_dir + "/.qcc-batch-bootstrap.stamp", fx.context));
        assertEq(0, result.rc, "--scc-source-stale: " + result.output);
        list<hash<auto>> stale = ();
        int closure = -1;
        foreach string line in (result.output.split("\n")) {
            if (!trim(line)) {
                continue;
            }
            list<string> fields = line.split("\t");
            if (fields[0] == "rebuild-closure") {
                closure = fields[1].toInt();
                continue;
            }
            assertEq(5, fields.size(),
                "a stale-plan row names its component and a representative member: "
                    + line);
            push stale, ("key": fields[1], "size": fields[2].toInt(),
                "source": fields[3], "output": fields[4]);
        }
        return ("output": result.output, "stale": stale, "closure": closure);
    }

    #! A component spanning several sources has no builder but the shared parse.
    /** The claim an object recipe carries says the group HAS a coordinator, not
        that the coordinator has already run.  Which is reached first depends on
        how the consuming project asks for the objects, and the plan can also
        have been left behind entirely: its stamp lives beside the build scripts
        while the generations it describes live beside the objects, so removing
        the object directory leaves the stamp asserting a currency that no longer
        exists.

        Reaching a stale multi-member component behind that claim used to be
        treated as a contradiction and end the build, with a message about
        strongly connected components and a recovery nobody could derive from it.
        The schedule is not this recipe's to control, and the component it was
        handed has no valid internal order and therefore no standalone builder at
        all: starting the shared parse is the answer, and refusing to only turned
        a schedule into a failure.
    */
    testScheduledRecipeStartsTheSharedParseItCannotReplace() {
        TmpDir tmp("qore-aot-driver-voidplan-");
        # a and b share a component, and nothing is published, so the recipe for
        # a finds a stale two-member component: the shape that only the shared
        # parse can compile, reached with the plan still claiming to hold.
        hash<auto> fx = fixture(tmp.path);
        writeCompiler(fx);
        writeBatchCompiler(fx);
        write(fx.qo_dir + "/.qcc-batch-bootstrap.stamp", "bootstrapped\n");

        hash<auto> component = componentFor(fx.qo_dir, "a");
        assertEq("2", component.size, "a and b share one component");

        hash<auto> result = recipe(fx, "a", component);
        assertEq(0, result.rc, "the recipe builds it: " + result.output);
        assertTrue(result.output.find("has no standalone builder") >= 0,
            "it says why the shared parse is the only builder for it: "
                + result.output);
        assertEq(-1, result.output.find("cannot be started from a single object"),
            "rather than refusing to start it: " + result.output);

        list<string> compiled = compiles(fx);
        assertEq(fx.names.size(), (select compiled, $1 =~ /^batch /).size(),
            "the whole group is rebuilt through one shared parse: "
                + compiled.join(", "));
        assertEq((), (select compiled, $1 !~ /^batch /),
            "and no member is compiled standalone: " + compiled.join(", "));

        # Recovery means the group is usable, not merely that nothing failed.
        foreach string name in (fx.names) {
            hash<auto> published = componentFor(fx.qo_dir, name);
            assertTrue(exists record(fx, published.key),
                "component " + published.key + " is published");
        }
    }

    #! A component that needs a shared parse does not need the group's.
    /** Its members are mutually dependent; every other member of the group is
        current as far as this recipe is concerned, and is preloaded rather than
        recompiled.  Before a parse could cover part of a group, one stale
        two-source component sent every source in the group through qcc again.
    */
    testScheduledRecipeParsesOnlyItsOwnComponent() {
        TmpDir tmp("qore-aot-driver-subset-");
        hash<auto> fx = fixture(tmp.path);
        writeCompiler(fx);
        writeBatchCompiler(fx);
        string subset = writeSubsetCompiler(fx);
        write(fx.qo_dir + "/.qcc-batch-bootstrap.stamp", "bootstrapped\n");

        hash<auto> component = componentFor(fx.qo_dir, "a");
        assertEq("2", component.size, "a and b share one component");

        hash<auto> result = recipe(fx, "a", component, subset);
        assertEq(0, result.rc, "the recipe builds it: " + result.output);

        list<string> compiled = compiles(fx);
        assertEq(2, (select compiled, $1 =~ /^subset /).size(),
            "only the component's own members are parsed: " + compiled.join(", "));
        assertEq((), (select compiled, $1 =~ /^batch /),
            "and the group's shared parse is not started: " + compiled.join(", "));
        assertTrue(exists record(fx, component.key),
            "the component is published from the parse of its members");
    }

    #! Not every group has a coordinator to have been planned by.
    /** CMake configures the shared parse and the plan target together, and only
        for a group with more than one source, but it writes the ordered claim
        into every object recipe unconditionally.  A one-source group's recipe
        therefore carries a claim about a coordinator that was never configured,
        and its component is stale exactly when it needs compiling -- the normal
        case, not a broken plan.  Escalating there would ask for a shared parse
        the group does not have; the standalone path is the only builder it has
        ever had, and reaching it is not an event worth reporting.
    */
    testScheduledRecipeBuildsAGroupWithoutASharedParse() {
        TmpDir tmp("qore-aot-driver-nogroupbatch-");
        hash<auto> fx = fixture(tmp.path, NOTHING, False);
        writeCompiler(fx);
        # Deliberately no batch script: this is how a one-source group is
        # configured.
        write(fx.qo_dir + "/.qcc-batch-bootstrap.stamp", "bootstrapped\n");
        assertFalse(is_file(fx.qo_dir + "/qcc-batch.sh"),
            "the group has no shared parse");

        hash<auto> component = componentFor(fx.qo_dir, "d");
        assertEq("1", component.size, "d is a singleton component");

        hash<auto> result = recipe(fx, "d", component);
        assertEq(0, result.rc, "the recipe builds it: " + result.output);
        assertEq(-1, result.output.find("shared parse"),
            "a group with no shared parse does not reach for one: " + result.output);
        assertEq(("d.qc d.qo",), compiles(fx),
            "the component is compiled on the standalone path");
        assertTrue(exists record(fx, component.key), "and published");
    }

    /** The reported failure needed concurrency to become visible, so the fix is
        held to it: eighteen workers resolve identity, take locks, select
        preloads, compile and publish simultaneously, and one of them rewrites
        another component's depfile in the middle of it -- the mutation that
        renumbered the decomposition under everybody else.

        Nothing here waits on a timer.  The workers are started together and
        joined, so the check is deterministic rather than a sampled race.

        Every worker is held to its own exit status and its own log, and both are
        reported for every worker that fails: a concurrent failure that is only
        visible as a missing generation record cannot be told apart from any of
        the other ways one recipe can fail.
    */
    testConcurrentRecipesPublishOneGeneration() {
        TmpDir tmp("qore-aot-driver-parallel-");
        list<string> extra = ();
        for (int i = 0; i < 14; ++i) {
            push extra, sprintf("p%02d", i);
        }
        # Every component a singleton, so all of them are eligible to run at
        # once; the a<->b cycle would otherwise be one unit of work.
        hash<auto> fx = fixture(tmp.path, NOTHING, False, extra);
        # c is the only component with a predecessor, so dropping its contract
        # edge is a real change to the live graph and to c's own preload.
        writeCompiler(fx, "printf '%s' " + sprintf("%y",
            fx.qo_dir + "/c.qo.stamp: " + fx.src_dir + "/c.qc\n") + " > "
            + sprintf("%y", fx.qo_dir + "/c.qo.d"));
        write(fx.qo_dir + "/.qcc-batch-bootstrap.stamp", "bootstrapped\n");

        hash<auto> frozen = runTool(("--scc-freeze-graph",
            fx.context + ".graph-snapshot.json", fx.context));
        assertEq(0, frozen.rc, "the graph freezes: " + frozen.output);

        # Resolve every component's identity from the frozen graph first, the
        # way the coordinator hands work out, then start the workers together.
        hash<string, hash<auto>> components = {};
        foreach string name in (fx.names) {
            components{name} = componentFor(fx.qo_dir, name);
        }
        list<string> workers = ();
        foreach string name in (fx.names) {
            # Every worker's status is written where the test can read it. `wait`
            # with no operands reports success whatever its children did, so a
            # status taken from it says nothing at all: a worker that fails -- or
            # is killed -- has to be visible as itself, and named.
            push workers, sprintf("{ %s; echo \"rc=$?\" > %y; } > %y 2>&1 &",
                driveCommand(fx, name, components{name},
                    fx.context + ".graph-snapshot.json"),
                fx.qo_dir + "/" + name + ".worker.rc",
                fx.qo_dir + "/" + name + ".worker.log");
        }
        backquote(join("\n", workers) + "\nwait");

        assertEq(fx.names.size(), components.size(),
            "each source has its own component");
        assertEq(sort((map $1 + ".qc " + $1 + ".qo", fx.names)), sort(compiles(fx)),
            "every component is compiled exactly once");

        # Failures are collected rather than asserted per worker, because the
        # first one to fail is not necessarily the only one, and knowing whether
        # one worker or all of them failed is most of the diagnosis.
        list<string> failed = ();
        list<string> unpublished = ();
        string generation = trim(frozen.output);
        foreach string name in (fx.names) {
            string log = read(fx.qo_dir + "/" + name + ".worker.log");
            if (trim(read(fx.qo_dir + "/" + name + ".worker.rc")) != "rc=0") {
                push failed, name;
            }
            assertEq(-1, log.find("moved"), name + " reports no moved sources: " + log);
            assertEq(-1, log.find("rebuilding"), name + " needs no rebuild: " + log);
            assertEq(-1, log.find("dependency graph"),
                name + " sees no graph transition: " + log);
            *hash<auto> committed = record(fx, components{name}.key);
            if (!exists committed) {
                push unpublished, name;
                continue;
            }
            assertEq(generation, committed.graph_generation,
                name + " is published against the one frozen graph");
        }
        assertEq((), failed,
            "every concurrent worker exits successfully" + workerReport(fx, failed));
        assertEq((), unpublished,
            "every component publishes a generation record"
                + workerReport(fx, unpublished));

        # The mutation has to have actually happened, or the run above proves
        # nothing: the live graph must now differ from the one every worker
        # published against, and only the next freeze may adopt it.
        hash<auto> live = runTool(("--scc-graph-generation", fx.context));
        assertEq(0, live.rc, "the live graph is readable");
        assertNeq(generation, trim(live.output),
            "a worker really did move the graph while the others were running");
    }

    #! A builder that loses the reclaim race still acquires the lock it reclaimed.
    /** Losing that race means the lock is gone, which is the state the reclaim
        asked for -- so the builder must continue.  It used to fail instead,
        because the removal reported the loss and the driver runs under
        \c "set -e"; a whole component then went unbuilt and unpublished with
        nothing in the log but a `rm` diagnostic.  Only musl/busybox hosts could
        show it, which is why it read as an unexplained alpine-only failure.
    */
    testStaleLockReclaimSurvivesARacingRemover() {
        TmpDir tmp("qore-aot-driver-reclaim-");
        hash<auto> fx = fixture(tmp.path);
        writeCompiler(fx);

        hash<auto> component = componentFor(fx.qo_dir, "d");
        string lock = fx.qo_dir + "/.qcc-scc/" + component.key + ".lock";
        mkdir(fx.qo_dir + "/.qcc-scc", 0777, True);
        # A well-formed record naming a pid that cannot be running: the acquire
        # loop can only get past it by reclaiming it, which is the path under
        # test.  The number is above every pid_max this runs on, and the test
        # says so rather than assuming it.
        assertNeq(0, system("kill -0 " + DeadPid + " 2>/dev/null"),
            sprintf("pid %d names no process", DeadPid));
        write(lock, sprintf("%d abandoned\n", DeadPid));

        hash<auto> result = drive(fx, "d", component, NOTHING,
            writeRacingRemover(fx));

        assertEq(0, result.rc,
            "the driver survives losing the reclaim race: " + result.output);
        assertEq(("d.qc d.qo",), compiles(fx),
            "the component is compiled exactly once");
        *hash<auto> published = record(fx, component.key);
        assertTrue(exists published, "the component's generation record is published");
        assertEq(component.key, published.scc, "the record names the component");
        assertFalse(is_file(lock), "no lock is left behind");
    }

    #! Everything the named workers know about why they failed.
    /** A driver that fails after its compile succeeded says why in its own log:
        publication refuses with a diagnostic naming the condition, and a worker
        that is killed outright leaves nothing but its exit status.  A run that
        reports neither can only say that a generation record is missing, which
        is the symptom shared by every one of those causes -- so the report
        carries the status, the log, and which records the group did publish.
    */
    private string workerReport(hash<auto> fx, list<string> names) {
        if (!names) {
            return "";
        }
        string report = "";
        foreach string name in (names) {
            report += sprintf("\n--- %s (%s) ---\n%s", name,
                trim(read(fx.qo_dir + "/" + name + ".worker.rc")),
                read(fx.qo_dir + "/" + name + ".worker.log"));
        }
        # glob() answers NOTHING rather than an empty list when the directory does
        # not exist, which is exactly the case a report is wanted for
        list<string> records = map basename($1),
            (glob(fx.qo_dir + "/.qcc-scc/*.generation.json") ?? ());
        return report + sprintf("--- published records (%d) ---\n%s\n",
            records.size(), join("\n", sort(records)));
    }

    #! The shell command for one scheduled recipe, without running it.
    private string driveCommand(hash<auto> fx, string name, hash<auto> component,
            string snapshot) {
        string qo_dir = fx.qo_dir;
        return sprintf(
            "QORE_QCC_PLANNED_STALE=1 QORE_QCC_COMPONENT_INDEX=%y "
            "QORE_QCC_COMPONENT_KEY=%y QORE_QCC_COMPONENT_SIZE=%y "
            "QORE_QCC_COMPONENT_LOCK=%y QORE_QCC_PREREQUISITES_READY=1 "
            "QORE_QCC_QORE_EXECUTABLE=%y QORE_QCC_SOURCE_ORDER_HELPER=%y "
            "QORE_QCC_GRAPH_SNAPSHOT=%y %y %y %y %y",
            component.index, component.key, component.size,
            qo_dir + "/.qcc-scc/" + component.key + ".lock",
            qore_bin, source_order_tool, snapshot, incremental_tool,
            qo_dir + "/" + name + ".qo", fx.src_dir + "/" + name + ".qc",
            qo_dir + "/qcc-single.sh");
    }
}
