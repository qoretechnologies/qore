#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
string libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
string qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
    ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : dirname(qore_bin) + "/qcc");
if (!is_file(qcc_bin)) {
    qcc_bin = "qcc";
}

string sub sourceCode() {
    return "%modern

class Box {
    private {
        int base;
    }

    constructor(int b) {
        base = b;
    }

    code<int(int)> makeAdder() {
        return int sub (int value) {
            return base + value;
        };
    }
}

string sub exercise() {
    int captured = 3;
    code<int(int)> add = int sub (int value) {
        return value + captured;
    };
    code<int()> bump = int sub () {
        return ++captured;
    };
    int unset;
    code<int()> initialize = int sub () {
        return ++unset;
    };
    code<int()> add_five = int sub () {
        return unset += 5;
    };
    code<int()> decrement = int sub () {
        return --unset;
    };
    code<int(int)> defaulted = int sub (int value = 5) {
        return value * 2;
    };
    code<nothing(reference<int>)> write_ref = nothing sub (reference<int> value) {
        value += 7;
    };
    code<int(int)> loop = int sub (int count) {
        int sum = 0;
        for (int i = 0; i < count; ++i) {
            sum += i * captured;
        }
        return sum;
    };
    code<int()> nested_call = int sub () {
        int offset = 9;
        return int sub (int value) {
            return offset + value;
        }(2);
    };
    code<int(int)> recursive;
    recursive = int sub (int value) {
        return value <= 0 ? 0 : value + recursive(value - 1);
    };
    code<int(int)> guarded = int sub (int value) {
        try {
            if (value < 0) {
                throw \"NATIVE-CLOSURE-TEST\", \"expected\";
            }
            return value;
        } catch (hash<auto> ex) {
            return ex.err == \"NATIVE-CLOSURE-TEST\" ? 17 : -1;
        }
    };
    code<int(int)> branched = int sub (int value) {
        int adjusted = value + 1;
        if (adjusted % 2) {
            adjusted *= 3;
        } else {
            adjusted += 7;
        }
        return adjusted * adjusted - value;
    };
    code<int(int, int)> checked_mod = int sub (int value, int divisor) {
        if (value) {
            return value % divisor;
        }
        return 0;
    };

    int first = add(4);
    int changed = bump();
    int second = add(4);
    int outer_changed = captured += 2;
    int initialized = initialize();
    int added = add_five();
    remove unset;
    int decremented = decrement();
    int ref_value = 6;
    write_ref(\\ref_value);
    Box box(10);
    code<int(int)> object_adder = box.makeAdder();
    int mod_zero_caught = 0;
    try {
        checked_mod(1, 0);
    } catch (hash<auto> ex) {
        mod_zero_caught = 1;
    }
    return sprintf(\"%d:%d:%d:%d:%d:%d:%d:%d:%d:%d:%d:%d:%d:%d:%d:%d:%d\",
        first, changed, second, outer_changed, initialized, added, decremented,
        defaulted(), ref_value, loop(5), nested_call(), object_adder(2), recursive(5), guarded(-1),
        branched(8), branched(9), mod_zero_caught);
}

printf(\"%s\\n\", exercise());
";
}

string source_path = "/tmp/qore-aot-native-closure-" + string(getpid()) + ".qr";
string exe_path = "/tmp/qore-aot-native-closure-" + string(getpid());
string disabled_exe_path = exe_path + "-disabled";
{
    File source();
    source.open2(source_path, O_WRONLY | O_CREAT | O_TRUNC);
    source.write(sourceCode());
}

string ast_out = backquote(sprintf("LD_LIBRARY_PATH=%s %s --exec-mode=ast %s 2>&1",
    libqore_dir, qore_bin, source_path));
string compile_out = backquote(sprintf(
    "QORE_AOT_DEBUG_NATIVE_CLOSURES=1 LD_LIBRARY_PATH=%s %s -O3 -o %s %s 2>&1",
    libqore_dir, qcc_bin, exe_path, source_path));
string disabled_compile_out = backquote(sprintf(
    "QORE_DISABLE_IR_NATIVE_INT_PROGRAM_INLINE=1 LD_LIBRARY_PATH=%s %s -O3 -o %s %s 2>&1",
    libqore_dir, qcc_bin, disabled_exe_path, source_path));
if (!is_file(exe_path) || !is_file(disabled_exe_path)) {
    printf("native closure AOT compile failed:\n%sDisabled:\n%s", compile_out, disabled_compile_out);
    exit(2);
}
if (!(compile_out =~ /compiled native closure/)) {
    printf("native closure body was not compiled:\n%s", compile_out);
    exit(2);
}

string native_out = backquote(sprintf(
    "QORE_AOT_DEBUG_NATIVE_CLOSURES=1 LD_LIBRARY_PATH=%s %s 2>&1", libqore_dir, exe_path));
string fallback_out = backquote(sprintf(
    "QORE_DISABLE_AOT_NATIVE_CLOSURES=1 LD_LIBRARY_PATH=%s %s 2>&1", libqore_dir, exe_path));
string disabled_out = backquote(sprintf(
    "QORE_DISABLE_IR_NATIVE_INT_PROGRAM_INLINE=1 LD_LIBRARY_PATH=%s %s 2>&1",
    libqore_dir, disabled_exe_path));
string expected = "7:4:8:6:1:6:-1:10:13:60:11:12:15:17:721:280:1\n";
if (ast_out != expected || fallback_out != expected || disabled_out != expected
        || !(native_out =~ /registered native closure/)
        || !(native_out =~ /7:4:8:6:1:6:-1:10:13:60:11:12:15:17:721:280:1/)) {
    printf("native closure execution mismatch\nAST:\n%sNative:\n%sFallback:\n%sDisabled:\n%sCompile:\n%s",
        ast_out, native_out, fallback_out, disabled_out, compile_out);
    exit(2);
}
