#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-exec-mode: parent - the test computes the expected large-integer results in its own process

# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../ExecModeHarness.qm

%exec-class IRFusedIntLocalOwnershipTest

#! Regression coverage for large int results of fused local int updates
/** With NaN boxing, an int outside the 48-bit immediate range is a heap node.  Fused local
    updates (<tt>++x</tt>, <tt>x += n</tt>) on boxed int locals leaked such nodes:

    - LLVM code stored the new boxed value into the local's alloca without releasing the value
      it replaced, and for runtime-stack locals cached a value nothing owned
    - the IR interpreter overwrote its local slot cache without releasing the old value, passed
      a temporary to reference-taking assignments and left the result slot out of cleanup
    - binding a reference argument read the lvalue back through a value accessor that creates
      a new heap node for a large int, in every tier including AST

    The fixture checks the computed values in every tier and AOT, and counts the heap ints that
    many updates leave behind (dbg_get_live_bigint_count(), which needs library debugging), which
    must be none.  The count is exact; the resident set size of the process, which the checks used
    to compare with a 2048 kB limit, also grows with no leak, by up to a whole 2 MiB huge page on
    hosts where transparent huge pages back the heap.
*/
class IRFusedIntLocalOwnershipTest inherits QUnit::Test {
    private {
        string qore_bin;
        string qcc_bin;
        string libqore_dir;
        string fixture;

        #! forces promotion on the first call so ir/tiered also run the native code
        const Promote = "QORE_IR_THRESHOLD=1 QORE_JIT_THRESHOLD=1 ";

        #! exec mode -> extra environment
        const Tiers = (
            ("ast", ""),
            ("ir", ""),
            ("ir", Promote),
            ("jit", ""),
            ("jit", Promote),
            ("tiered", ""),
            ("tiered", Promote),
        );

        const Big = 1 << 50;
        const Edge = (1 << 47) - 2;

        #! the update patterns whose leaked heap ints are counted in "live" mode
        const LeakCases = ("body", "direct", "runtime-stack", "closure");
    }

    constructor() : QUnit::Test("IRFusedIntLocalOwnershipTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
            ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");
        fixture = get_script_dir() + "/IRFusedIntLocalOwnershipScenario.qr";

        foreach list<string> tier in (Tiers) {
            string mode = tier[0];
            string env = tier[1];
            string label = mode + (env ? " (promoted)" : "");
            addTestCase("large int values: " + label, sub () {
                checkValues(mode, env);
            });
            addTestCase("large int updates do not leak: " + label, sub () {
                checkLeaks(mode, env);
            });
        }
        addTestCase("large int values: AOT", \testAot());
        addTestCase("leak output parsing", \testLeakOutputParsing());

        set_return_value(main());
    }

    private static string expected() {
        # optional: two +2 loops across the 48-bit boundary, then -4 steps back below it
        list<int> optional = map Edge + 2 * ($1 + 1), xrange(4);
        optional += map Edge + 4 - 4 * $1, xrange(4);
        list<int> soft = map Big + 2 * ($1 + 1), xrange(3);
        list<int> auto_values = map Big + 3 * ($1 + 1), xrange(3);
        string rv;
        for (int i = 0; i < 3; ++i) {
            rv += sprintf("optional[%d]: %y\n", i, optional);
            rv += sprintf("soft[%d]: %y\n", i, soft);
            rv += sprintf("auto[%d]: %y\n", i, auto_values);
            rv += sprintf("parameter[%d]: %y %y\n", i, Big + 6, Edge + 6);
            # sum of (Big + i + 6) - Big for i = 0..2
            rv += sprintf("direct[%d]: %d\n", i, 21);
            rv += sprintf("runtime-stack[%d]: %y\n", i, Big + 6);
            rv += sprintf("closure[%d]: %y\n", i, Big + 6);
        }
        return rv;
    }

    private string run(string mode, string env, *string arg) {
        # ExecModeHarness compiles synchronously, which makes promotion deterministic instead of racing the compiler
        return ExecModeHarness::run(sprintf("%sLD_LIBRARY_PATH=%s %s -b --enable-debug "
            "--exec-mode=%s %s%s", env, shellQuote(libqore_dir), shellQuote(qore_bin), mode,
            shellQuote(fixture), arg ? " " + arg : ""));
    }

    private checkValues(string mode, string env) {
        assertEq(expected(), run(mode, env), sprintf("exec-mode=%s %s output", mode, env));
    }

    #! skips the test case without library debugging, which the heap int count needs
    private checkDebugging() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("dbg_get_live_bigint_count() requires library debugging");
        }
    }

    private checkLeaks(string mode, string env) {
        checkDebugging();
        checkLeakOutput(sprintf("exec-mode=%s %s", mode, env), run(mode, env, "live"));
    }

    #! parses the output of "live" mode: pattern -> heap ints left behind
    /** @throw LEAK-OUTPUT-ERROR the output does not have one well-formed line for each pattern, in order
    */
    private static hash<string, int> parseLeakOutput(string output) {
        list<string> lines = output.split("\n");
        # the text after the last newline is an empty element
        if (lines && lines.last() == "") {
            pop lines;
        }
        if (lines.size() != LeakCases.size()) {
            throw "LEAK-OUTPUT-ERROR", sprintf("expected one line for each of %y; got: %y", LeakCases, output);
        }
        hash<string, int> rv;
        foreach string line in (lines) {
            *list<*string> m = (line =~ x/^([a-z-]+): (-?[0-9]+)$/);
            if (!m || m[0] != LeakCases[$#]) {
                throw "LEAK-OUTPUT-ERROR", sprintf("line %d: expected the count of %y; got: %y", $# + 1,
                    LeakCases[$#], line);
            }
            rv{m[0]} = m[1].toInt();
        }
        return rv;
    }

    private checkLeakOutput(string label, string output) {
        hash<string, int> counts;
        try {
            counts = parseLeakOutput(output);
        } catch (hash<ExceptionInfo> ex) {
            fail(sprintf("%s: %s: %s", label, ex.err, ex.desc));
            return;
        }
        foreach hash<auto> i in (counts.pairIterator()) {
            assertEq(0, i.value, sprintf("%s: %s left heap ints behind", label, i.key));
        }
    }

    #! the leak checks reject output that does not give the count of every pattern
    testLeakOutputParsing() {
        hash<string, int> counts = parseLeakOutput("body: 0\ndirect: 2\nruntime-stack: -1\nclosure: 0\n");
        assertEq({"body": 0, "direct": 2, "runtime-stack": -1, "closure": 0}, counts);
        assertThrows("LEAK-OUTPUT-ERROR", "expected one line", \parseLeakOutput(), ("body: 0\n",));
        assertThrows("LEAK-OUTPUT-ERROR", "line 3", \parseLeakOutput(),
            ("body: 0\ndirect: 0\nruntime-stack: x\nclosure: 0\n",));
        assertThrows("LEAK-OUTPUT-ERROR", "line 1", \parseLeakOutput(),
            ("direct: 0\nbody: 0\nruntime-stack: 0\nclosure: 0\n",));
        assertThrows("LEAK-OUTPUT-ERROR", "expected one line", \parseLeakOutput(), ("",));
    }

    testAot() {
        if (!is_file(qcc_bin) && !backquote("command -v " + qcc_bin + " 2>/dev/null")) {
            testSkip("qcc not available");
        }
        TmpDir tmp("qore-ir-fused-int-local-ownership-");
        string exe = tmp.path + "/ownership";
        string compile_out = backquote(sprintf("LD_LIBRARY_PATH=%s %s -o %s %s 2>&1", shellQuote(libqore_dir),
            shellQuote(qcc_bin), shellQuote(exe), shellQuote(fixture)));
        assertTrue(is_file(exe), "AOT compile produced an executable: " + compile_out);
        assertEq(expected(), backquote(sprintf("LD_LIBRARY_PATH=%s %s 2>&1", shellQuote(libqore_dir),
            shellQuote(exe))), "AOT output");
        if (Option::HAVE_LIBRARY_DEBUGGING) {
            checkLeakOutput("AOT", backquote(sprintf("LD_LIBRARY_PATH=%s %s live 2>&1", shellQuote(libqore_dir),
                shellQuote(exe))));
        }
    }

    private static string shellQuote(string value) {
        return "'" + replace(value, "'", "'\\''") + "'";
    }
}
