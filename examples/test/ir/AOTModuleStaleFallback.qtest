#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../TestFileTime.qm

%exec-class AOTModuleStaleFallbackTest

#! How the module loader reports an AOT module of a build tree that is out of date with its sources
/** An AOT module of a build tree one of whose sources has changed since it was compiled is not loaded: its source
    module is loaded instead (see design/aot-linked-module-sources.md).  A module of a build tree is a symbolic link
    to a built module, or a regular file with the depfile that qcc wrote next to it, as in the directory of the
    built modules that run_tests.sh puts first in the module path; a module without a depfile is not checked.  When the source module fails to load, the
    error that tells why the AOT module was not loaded (\c AOT-MODULE-STALE) follows the error of the source module in
    the exception chain.
*/
class AOTModuleStaleFallbackTest inherits QUnit::Test {
    private {
        string qore_bin;
        string qcc_bin;
        string libqore_dir;
        string env;
    }

    constructor() : QUnit::Test("AOTModuleStaleFallbackTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
            ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");
        env = sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s QORE_LIBDIR=%s", libqore_dir, libqore_dir,
            libqore_dir);

        addTestCase("an out-of-date linked module whose source fails reports why it was not loaded",
            \staleSourceFailsTest());
        addTestCase("a built module that is a regular file with a depfile is checked (the run_tests.sh layout)",
            \regularWithDepfileTest());
        addTestCase("a module compiled without a depfile is not checked", \regularWithoutDepfileTest());
        addTestCase("a depfile copied next to another module is ignored", \copiedDepfileTest());
        addTestCase("a depfile reached through a linked module is used", \linkedDepfileTest());
        addTestCase("a depfile without a rule target, or with a malformed one, is ignored",
            \malformedTargetTest());
        addTestCase("a depfile with a relative target names the module in its directory", \relativeTargetTest());
        set_return_value(main());
    }

    private string run(string cmd) {
        return backquote(cmd + " 2>&1");
    }

    private write(string path, string body) {
        File f();
        f.open2(path, O_WRONLY | O_CREAT | O_TRUNC);
        f.write(body);
    }

    #! sets the modification time of a file to a time after any build
    private touchLater(string path) {
        TestFileTime::set_file_times(2030-01-01T00:00:00Z, path);
        assertEq(1893456000, hstat(path).mtime.getEpochSeconds(), "touch " + path);
    }

    #! writes the source of the Stale module, which returns the given code
    private writeStale(string dir, string body) {
        write(dir + "/Stale.qm", sprintf("%%modern\nmodule Stale { version = \"1.0\"; desc = \"stale\"; "
            "author = \"Qore\"; license = \"MIT\"; }\npublic namespace Stale { public string sub value() { %s } }\n",
            body));
    }

    #! compiles the Stale module from \a src_dir to \a qmod, with a depfile next to it
    private compile(string src_dir, string qmod) {
        string out = run(sprintf("%s QORE_MODULE_DIR=%s %s -m --depfile=%s.d --depfile-module-deps=source -o %s %s",
            env, src_dir, qcc_bin, qmod, qmod, src_dir + "/Stale.qm"));
        assertTrue(is_file(qmod), "compiled Stale.qmod: " + out);
        assertTrue(is_file(qmod + ".d"), "depfile written: " + out);
    }

    #! runs a script that loads the module with the given module path and prints what happened
    private string runStale(string module_path) {
        return trim(run(sprintf("%s QORE_MODULE_DIR=%s %s -ne 'try { load_module(\"Stale\", WARN_MODULES); "
            "printf(\"%%s %%s\\n\", call_function(\"Stale::value\"), basename(get_module_hash().Stale.filename)); } "
            "catch (hash<ExceptionInfo> ex) { while (ex) { printf(\"ex: %%s: %%s\\n\", ex.err, ex.desc); "
            "ex = ex.next; } }'", env, module_path, qore_bin)));
    }

    #! runs a script with %requires in a child process, as a test run by run_tests.sh does
    private string runRequires(string module_path, string script_dir) {
        string script = script_dir + "/requires.q";
        write(script, "%modern\n%requires Stale\nprintf(\"%s %s\\n\", Stale::value(), "
            "basename(get_module_hash().Stale.filename));\n");
        return trim(run(sprintf("%s QORE_MODULE_DIR=%s %s %s", env, module_path, qore_bin, script)));
    }

    regularWithDepfileTest() {
        # run_tests.sh puts the directory of the built modules first in the module path, before the sources
        TmpDir tmp("qore-aot-stale-fallback-");
        string src_dir = tmp.path + "/qlib";
        string qmod_dir = tmp.path + "/build/qlib-qmod";
        mkdir(src_dir);
        mkdir(qmod_dir, 0755, True);
        writeStale(src_dir, "return \"v1\";");
        compile(src_dir, qmod_dir + "/Stale.qmod");
        string module_path = qmod_dir + ":" + src_dir;
        assertEq("v1 Stale.qmod", runRequires(module_path, tmp.path));

        # a source with only a new modification time has not changed: the module is loaded
        touchLater(src_dir + "/Stale.qm");
        assertEq("v1 Stale.qmod", runRequires(module_path, tmp.path));

        # a changed source: the source module is loaded instead, with a warning
        writeStale(src_dir, "return \"v2\";");
        touchLater(src_dir + "/Stale.qm");
        string out = runRequires(module_path, tmp.path);
        assertEq("v2 Stale.qm", out.split("\n").last(), out);
        assertRegex("BINARY-MODULE-SOURCE-FALLBACK: AOT module '.*/qlib-qmod/Stale\\.qmod' for feature 'Stale' is out "
            "of date: its source '.*/qlib/Stale\\.qm' has changed since it was compiled", out);

        # without its depfile, the module is not checked
        unlink(qmod_dir + "/Stale.qmod.d");
        assertEq("v1 Stale.qmod", runRequires(module_path, tmp.path));
    }

    regularWithoutDepfileTest() {
        # qcc --compile-module without --depfile writes no depfile: the module is used even with a changed source
        TmpDir tmp("qore-aot-stale-fallback-");
        string src_dir = tmp.path + "/src";
        mkdir(src_dir);
        writeStale(src_dir, "return \"v1\";");
        string qmod = src_dir + "/Stale.qmod";
        string out = run(sprintf("%s QORE_MODULE_DIR=%s %s -b --compile-module --output %s %s", env, src_dir,
            qore_bin, qmod, src_dir + "/Stale.qm"));
        assertTrue(is_file(qmod), out);
        assertFalse(is_file(qmod + ".d"));
        writeStale(src_dir, "return \"v2\";");
        touchLater(src_dir + "/Stale.qm");
        assertEq("v1 Stale.qmod", runRequires(src_dir, tmp.path));
    }

    #! returns the output of loading Stale with load_module() and with %requires, which must be the same
    private string loadBoth(string module_path, string script_dir) {
        string loaded = runStale(module_path);
        string required = runRequires(module_path, script_dir);
        assertEq(loaded.split("\n").last(), required.split("\n").last(), "load_module() and %requires");
        return required;
    }

    #! changes the source of the Stale module after it was compiled
    private changeSource(string src_dir) {
        writeStale(src_dir, "return \"v2\";");
        touchLater(src_dir + "/Stale.qm");
    }

    #! asserts that the Stale module was loaded from its source because it is out of date
    private assertFallback(string out) {
        assertEq("v2 Stale.qm", out.split("\n").last(), out);
        assertRegex("BINARY-MODULE-SOURCE-FALLBACK: AOT module '.*Stale\\.qmod' for feature 'Stale' is out of date",
            out);
    }

    copiedDepfileTest() {
        # a build tree's qlib-qmod copied to an installation with cp -p, which keeps the modification times, as
        # cp -a and rsync -a do: the depfile names the built module, not the copy
        TmpDir tmp("qore-aot-stale-fallback-");
        string src_dir = tmp.path + "/qlib";
        string qmod_dir = tmp.path + "/build/qlib-qmod";
        string inst_dir = tmp.path + "/inst";
        mkdir(src_dir);
        mkdir(qmod_dir, 0755, True);
        mkdir(inst_dir);
        writeStale(src_dir, "return \"v1\";");
        compile(src_dir, qmod_dir + "/Stale.qmod");
        assertTrue(is_file(qmod_dir + "/Stale.qmod.d.fingerprints"));
        assertEq(0, system(sprintf("cp -p '%s'/Stale.qmod* '%s'", qmod_dir, inst_dir)), "copy");
        assertTrue(is_file(inst_dir + "/Stale.qmod.d"));
        changeSource(src_dir);

        # the copy is loaded: its depfile is not its own
        string out = loadBoth(inst_dir + ":" + src_dir, tmp.path);
        assertEq("v1 Stale.qmod", out, out);
        # the built module is still checked with the same depfile, which is its own
        assertFallback(loadBoth(qmod_dir + ":" + src_dir, tmp.path));

        # a depfile that names a module that does not exist is not used either
        unlink(qmod_dir + "/Stale.qmod");
        out = loadBoth(inst_dir + ":" + src_dir, tmp.path);
        assertEq("v1 Stale.qmod", out, out);
    }

    linkedDepfileTest() {
        # the source qlib links to the built module; the depfile next to the built module names it
        TmpDir tmp("qore-aot-stale-fallback-");
        string src_dir = tmp.path + "/qlib";
        string build_dir = tmp.path + "/build";
        mkdir(src_dir);
        mkdir(build_dir);
        writeStale(src_dir, "return \"v1\";");
        compile(src_dir, build_dir + "/Stale.qmod");
        assertEq(0, system(sprintf("ln -s '%s/Stale.qmod' '%s/Stale.qmod'", build_dir, src_dir)), "link");
        assertEq("v1 Stale.qmod", loadBoth(src_dir, tmp.path));
        # touched only: the fingerprints of the depfile tell that the source has not changed
        touchLater(src_dir + "/Stale.qm");
        assertEq("v1 Stale.qmod", loadBoth(src_dir, tmp.path));
        changeSource(src_dir);
        assertFallback(loadBoth(src_dir, tmp.path));
    }

    malformedTargetTest() {
        TmpDir tmp("qore-aot-stale-fallback-");
        string src_dir = tmp.path + "/qlib";
        string qmod_dir = tmp.path + "/build/qlib-qmod";
        mkdir(src_dir);
        mkdir(qmod_dir, 0755, True);
        writeStale(src_dir, "return \"v1\";");
        string qmod = qmod_dir + "/Stale.qmod";
        compile(src_dir, qmod);
        string depfile = qmod + ".d";
        string source = src_dir + "/Stale.qm";
        changeSource(src_dir);
        string module_path = qmod_dir + ":" + src_dir;
        # with its own depfile the module is out of date, so each of the depfiles below is what keeps it loaded
        assertFallback(loadBoth(module_path, tmp.path));
        unlink(depfile + ".fingerprints");

        foreach string body in ((
                # no target
                sprintf(": %s\n", source),
                sprintf("   : %s\n", source),
                # no rule
                sprintf("%s %s\n", qmod, source),
                "",
                # a target split over two lines
                sprintf("%s\\\n: %s\n", qmod, source),
                # two targets
                sprintf("%s %s: %s\n", qmod, qmod, source),
                # a target that is the module's source, not the module
                sprintf("%s: %s\n", source, source),
            )) {
            write(depfile, body);
            string out = loadBoth(module_path, tmp.path);
            assertEq("v1 Stale.qmod", out, sprintf("%y: %s", body, out));
        }

        # the module's own target, with blanks around it, is used
        write(depfile, sprintf("  %s  : %s\n", qmod, source));
        assertFallback(loadBoth(module_path, tmp.path));
    }

    relativeTargetTest() {
        # qcc writes the -o path as the target; one given relative to the build directory is relative to the
        # directory of the depfile next to it
        TmpDir tmp("qore-aot-stale-fallback-");
        string src_dir = tmp.path + "/qlib";
        string qmod_dir = tmp.path + "/build/qlib-qmod";
        mkdir(src_dir);
        mkdir(qmod_dir, 0755, True);
        writeStale(src_dir, "return \"v1\";");
        string out = run(sprintf("cd '%s' && %s QORE_MODULE_DIR=%s %s -m --depfile=Stale.qmod.d "
            "--depfile-module-deps=source -o Stale.qmod %s", qmod_dir, env, src_dir, qcc_bin, src_dir + "/Stale.qm"));
        assertTrue(is_file(qmod_dir + "/Stale.qmod.d"), out);
        assertRegex("^Stale\\.qmod:", ReadOnlyFile::readTextFile(qmod_dir + "/Stale.qmod.d"));
        string module_path = qmod_dir + ":" + src_dir;
        assertEq("v1 Stale.qmod", loadBoth(module_path, tmp.path));
        changeSource(src_dir);
        assertFallback(loadBoth(module_path, tmp.path));
        # a relative target names the module next to the depfile: one that is not there is not used
        write(qmod_dir + "/Stale.qmod.d", sprintf("other/Stale.qmod: %s\n", src_dir + "/Stale.qm"));
        assertEq("v1 Stale.qmod", loadBoth(module_path, tmp.path));
    }

    staleSourceFailsTest() {
        TmpDir tmp("qore-aot-stale-fallback-");
        string src_dir = tmp.path + "/qlib";
        string build_dir = tmp.path + "/build";
        mkdir(src_dir);
        mkdir(build_dir);
        writeStale(src_dir, "return \"v1\";");
        compile(src_dir, build_dir + "/Stale.qmod");
        assertEq(0, system(sprintf("ln -s '%s/Stale.qmod' '%s/Stale.qmod'", build_dir, src_dir)), "link");
        assertEq("v1 Stale.qmod", runStale(src_dir));

        # the source is changed so that it does not parse: the AOT module is out of date, and its source fails
        writeStale(src_dir, "return \"v2\" SYNTAX ERROR;");
        touchLater(src_dir + "/Stale.qm");
        list<string> lines = runStale(src_dir).split("\n");
        list<string> ex = map $1.substr(4), lines, !$1.find("ex: ");
        assertEq(2, ex.size(), lines.join("\n"));
        assertRegex("^PARSE-EXCEPTION: .*while loading user module \"Stale\"", ex[0]);
        assertRegex("^AOT-MODULE-STALE: AOT module '.*/Stale\\.qmod' for feature 'Stale' is out of date: its "
            "source '.*/Stale\\.qm' has changed since it was compiled; rebuild the AOT module \\(the binary module "
            "was not loaded; source module '.*/Stale\\.qm' was tried instead\\)$", ex[1] ?? "");
        # no warning about the fallback: the load failed
        assertEq((), (select lines, $1 =~ /^warning/), lines.join("\n"));
    }
}
