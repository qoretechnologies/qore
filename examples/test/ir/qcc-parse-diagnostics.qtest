#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - qcc compiles the sources ahead of time
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires ../TestInterpreter.qm
%requires FsUtil
%requires json

%exec-class QccParseDiagnosticsTest

#! qcc reports the parse diagnostics of the code it compiles as diagnostics (issue #6555)
/** A parse error (of the parse or of the commit) or warning of the compiled code is reported in one line on stderr,
    <file>:<line>[:<col>]: error|warning: <code>: <message>, in every compile mode, not as an unhandled exception;
    with --diag-format=json (or QORE_DIAG_FORMAT=json), as one JSON array on stdout at the end of the run, in the
    form of qore --diag-format=json, and with --code-frames as code frames.
*/
class QccParseDiagnosticsTest inherits QUnit::Test {
    private {
        string qcc_bin;
        TmpDir tmp("qore-qcc-parse-diagnostics-");
        string missing_return;
        string syntax_error;
        string other_missing_return;
        string good;
        string warns;
        string warns_and_fails;
        string module;
        string warn_module;
        string not_modern;
        string rich;
        string user_program;
    }

    constructor() : QUnit::Test("QccParseDiagnosticsTest", "1.0", \ARGV) {
        qcc_bin = TestInterpreter::qcc_compiler();
        missing_return = writeFile("missing-return.q", "%modern\nint sub f() {\n}\n");
        other_missing_return = writeFile("other-missing-return.q", "%modern\nstring sub g() {\n}\n");
        syntax_error = writeFile("syntax-error.q", "%modern\nint sub f( {\n");
        good = writeFile("good.q", "%modern\nint sub h() { return 1; }\n");
        # a warning that qcc reports (QP_WARN_DEFAULT)
        warns = writeFile("warns.q", "%modern\n%enable-warning no-such-warning\nsub w() {}\n");
        warns_and_fails = writeFile("warns-and-fails.q", "%modern\n%enable-warning no-such-warning\n"
            "sub w() { no_such_function(); }\n");
        module = writeFile("DiagModule.qm", "%modern\nmodule DiagModule {\n    version = \"1.0\";\n"
            "    desc = \"test\";\n    author = \"test\";\n    url = \"https://qore.org\";\n}\n"
            "public int sub mf() {\n}\n");
        warn_module = writeFile("WarnModule.qm", "%modern\n%enable-warning no-such-warning\nmodule WarnModule {\n"
            "    version = \"1.0\";\n    desc = \"test\";\n    author = \"test\";\n    url = \"https://qore.org\";\n}\n"
            "public sub mw() { no_such_function(); }\n");
        # parses with a warning, then fails the %modern check of the compiler
        not_modern = writeFile("not-modern.q", "%enable-warning no-such-warning\nsub nm() {}\n");
        # a warning and an error with a hint and a possible fix
        rich = writeFile("rich.q", "%modern\n%enable-warning no-such-warning\nclass TrapCtor {}\nsub f() {\n"
            "    TrapCtor();\n}\n");
        # code run by the compile (a constant's initializer) creates a Program whose diagnostics are those of each
        # parse action
        user_program = writeFile("user-program.q", "%modern\nint sub count() {\n    Program p(PO_NEW_STYLE);\n"
            "    p.setParseDiagnosticsCollected(True);\n    try { p.parse(\"sub a() { x1(); }\", \"a\"); } catch () {}\n"
            "    try { p.parse(\"sub b() { x2(); }\", \"b\"); } catch () {}\n"
            "    int n = p.getParseDiagnostics().size();\n    if (n != 1) {\n"
            "        throw \"DIAGNOSTICS-ACCUMULATED\", sprintf(\"%d diagnostics\", n);\n    }\n    return n;\n}\n"
            "const C = count();\n");
        addTestCase("a commit-time error of a single source", \singleCommitTest());
        addTestCase("a parse error of a single source", \singleParseTest());
        addTestCase("a commit-time error of a batch compile", \batchCommitTest());
        addTestCase("an error of an executable compile", \executableTest());
        addTestCase("an error of a module compile", \moduleTest());
        addTestCase("a warning", \warningTest());
        addTestCase("a warning of a compile that fails", \warningAndErrorTest());
        addTestCase("a warning and an error of a module with warnings as errors", \moduleWarningsAsErrorsTest());
        addTestCase("a warning of a compile that fails after the parse", \warningThenFailureTest());
        addTestCase("--diag-format=json", \jsonTest());
        addTestCase("QORE_DIAG_FORMAT=json", \jsonEnvTest());
        addTestCase("--diag-format=json for a compile that succeeds", \jsonSuccessTest());
        addTestCase("--diag-format=json gives the diagnostics of qore --diag-format=json", \jsonParityTest());
        addTestCase("--code-frames", \codeFramesTest());
        addTestCase("a Program that the compiled code creates keeps the diagnostics of each parse",
            \userProgramTest());
        addTestCase("--diag-format=json does not change the output of --version", \jsonVersionTest());
        set_return_value(main());
    }

    private string writeFile(string name, string src) {
        string path = tmp.path + DirSep + name;
        File f();
        f.open2(path, O_WRONLY | O_CREAT | O_TRUNC);
        f.write(src);
        f.close();
        return path;
    }

    #! runs qcc with \a args; returns stdout, stderr and the exit status
    private hash<auto> qcc(string args, *string env) {
        string err_file = tmp.path + DirSep + "stderr.txt";
        int rc;
        # the form of the diagnostics is that of the arguments, not of the environment of the test
        string out = backquote(sprintf("env -u QORE_DIAG_FORMAT -u QORE_CODE_FRAMES %s %s %s 2>%s", env ?? "", qcc_bin,
            args, err_file), \rc);
        return {"out": out, "err": ReadOnlyFile::readTextFile(err_file), "status": rc};
    }

    #! the output has no unhandled-exception or warning banner
    private checkNoBanner(hash<auto> r) {
        assertFalse(r.err =~ /unhandled QORE/, r.err);
        assertFalse(r.err =~ /warning encountered/, r.err);
    }

    singleCommitTest() {
        hash<auto> r = qcc(sprintf("-c -o %s/out.qo %s", tmp.path, missing_return));
        assertNeq(0, r.status, r.err);
        checkNoBanner(r);
        assertRegex("(^|\n)" + quote(missing_return) + ":2: error: MISSING-RETURN: this code block has declared return "
            "type 'int'", r.err);
    }

    singleParseTest() {
        hash<auto> r = qcc(sprintf("-c -o %s/out.qo %s", tmp.path, syntax_error));
        assertNeq(0, r.status, r.err);
        checkNoBanner(r);
        assertRegex("(^|\n)" + quote(syntax_error) + ":2:[0-9]+: error: PARSE-EXCEPTION: syntax error", r.err);
    }

    batchCommitTest() {
        string out_dir = tmp.path + DirSep + "batch";
        mkdir(out_dir);
        hash<auto> r = qcc(sprintf("-c --output-dir %s %s %s %s", out_dir, missing_return, good, other_missing_return));
        assertNeq(0, r.status, r.err);
        checkNoBanner(r);
        assertRegex("(^|\n)" + quote(missing_return) + ":2: error: MISSING-RETURN: ", r.err);
        assertRegex("(^|\n)" + quote(other_missing_return) + ":2: error: MISSING-RETURN: ", r.err);
    }

    executableTest() {
        hash<auto> r = qcc(sprintf("-o %s/exe %s", tmp.path, missing_return));
        assertNeq(0, r.status, r.err);
        checkNoBanner(r);
        assertRegex("(^|\n)" + quote(missing_return) + ":2: error: MISSING-RETURN: ", r.err);
    }

    moduleTest() {
        hash<auto> r = qcc(sprintf("--module -o %s/DiagModule.qmod %s", tmp.path, module));
        assertNeq(0, r.status, r.err);
        checkNoBanner(r);
        assertRegex("(^|\n)" + quote(module) + ":8: error: MISSING-RETURN: ", r.err);
    }

    warningTest() {
        hash<auto> r = qcc(sprintf("-c -o %s/warns.qo %s", tmp.path, warns));
        assertEq(0, r.status, r.err);
        checkNoBanner(r);
        assertRegex("(^|\n)" + quote(warns) + ":2:[0-9]+: warning: UNKNOWN-WARNING: cannot enable unknown warning",
            r.err);
    }

    #! the warning is reported before the error, in the same form
    warningAndErrorTest() {
        foreach string mode in (("-c -o " + tmp.path + "/wf.qo", "-o " + tmp.path + "/wf")) {
            hash<auto> r = qcc(sprintf("%s %s", mode, warns_and_fails));
            assertNeq(0, r.status, r.err);
            checkNoBanner(r);
            assertRegex("(^|\n)" + quote(warns_and_fails) + ":2:[0-9]+: warning: UNKNOWN-WARNING: .*\n"
                + quote(warns_and_fails) + ":3:[0-9]+: error: PARSE-EXCEPTION: ", r.err, mode);
        }
    }

    #! with warnings treated as errors, the error of the module is reported too, in the same form
    moduleWarningsAsErrorsTest() {
        hash<auto> r = qcc(sprintf("-r --module -o %s/WarnModule.qmod %s", tmp.path, warn_module));
        assertNeq(0, r.status, r.err);
        checkNoBanner(r);
        assertRegex("(^|\n)" + quote(warn_module) + ":2:[0-9]+: warning: UNKNOWN-WARNING: ", r.err);
        assertRegex("(^|\n)" + quote(warn_module) + ":9:[0-9]+: error: PARSE-EXCEPTION: ", r.err);
    }

    #! the warning of a parse that succeeded is reported when the compile fails afterwards
    warningThenFailureTest() {
        hash<auto> r = qcc(sprintf("-c -o %s/not-modern.qo %s", tmp.path, not_modern));
        assertNeq(0, r.status, r.err);
        checkNoBanner(r);
        assertRegex("(^|\n)" + quote(not_modern) + ":1:[0-9]+: warning: UNKNOWN-WARNING: ", r.err);
    }

    private checkJson(hash<auto> r) {
        assertNeq(0, r.status, r.err);
        checkNoBanner(r);
        list<auto> diags = parse_json(r.out);
        assertEq(2, diags.size(), r.out);
        assertEq(("MISSING-RETURN", "MISSING-RETURN"), (map $1.code, diags));
        assertEq(("error", "error"), (map $1.severity, diags));
        assertEq((missing_return, other_missing_return), (map $1.file, diags));
        assertEq((2, 2), (map $1.startLine, diags));
    }

    #! one JSON array for the whole batch
    jsonTest() {
        string out_dir = tmp.path + DirSep + "json";
        mkdir(out_dir);
        checkJson(qcc(sprintf("--diag-format=json -c --output-dir %s %s %s %s", out_dir, missing_return, good,
            other_missing_return)));
    }

    jsonEnvTest() {
        string out_dir = tmp.path + DirSep + "json-env";
        mkdir(out_dir);
        checkJson(qcc(sprintf("-c --output-dir %s %s %s %s", out_dir, missing_return, good, other_missing_return),
            "QORE_DIAG_FORMAT=json"));
    }

    #! stdout holds only the JSON array: the other output of the run goes to stderr
    jsonSuccessTest() {
        hash<auto> r = qcc(sprintf("--diag-format=json -c -o %s/warns-json.qo %s", tmp.path, warns));
        assertEq(0, r.status, r.err);
        list<auto> diags = parse_json(r.out);
        assertEq(1, diags.size(), r.out);
        assertEq("warning", diags[0].severity);
        assertEq("UNKNOWN-WARNING", diags[0].code);
        assertEq(2, diags[0].startLine);
        # the report of the compiled object
        assertRegex("warns-json\\.qo", r.err);
    }

    #! the diagnostics are those of the qore binary for the same code, with their hints and possible fixes
    jsonParityTest() {
        hash<auto> r = qcc(sprintf("--diag-format=json -c -o %s/rich.qo %s", tmp.path, rich));
        assertNeq(0, r.status, r.err);
        list<auto> qcc_diags = parse_json(r.out);
        int rc;
        string qore_out = backquote(sprintf("env -u QORE_DIAG_FORMAT -u QORE_CODE_FRAMES %s --diag-format=json %s "
            "2>/dev/null", TestInterpreter::qore_interpreter(), rich), \rc);
        assertEq(2, rc, qore_out);
        list<auto> qore_diags = parse_json(qore_out);
        # qcc names the file by its canonical path
        assertEq(normalize(qore_diags), normalize(qcc_diags));
        assertEq(("UNKNOWN-WARNING", "MISSING-NEW-CONSTRUCTOR"), (map $1.id, qcc_diags));
        assertTrue(exists qcc_diags[1].hint, r.out);
        assertEq(1, qcc_diags[1].fixes.size(), r.out);
    }

    #! the diagnostics with their file names reduced to the base name
    private static list<auto> normalize(list<auto> diags) {
        return map normalizeValue($1), diags;
    }

    private static auto normalizeValue(auto v) {
        switch (v.typeCode()) {
            case NT_HASH: {
                hash<auto> rv;
                foreach hash<auto> i in (v.pairIterator()) {
                    rv{i.key} = (i.key == "file" && i.value.typeCode() == NT_STRING) ? basename(i.value)
                        : normalizeValue(i.value);
                }
                return rv;
            }
            case NT_LIST:
                return map normalizeValue($1), v;
        }
        return v;
    }

    #! a mode that compiles nothing reports on stdout as without --diag-format=json
    jsonVersionTest() {
        hash<auto> r = qcc("--diag-format=json --version");
        assertEq(0, r.status, r.err);
        assertRegex("^qcc ", r.out);
        assertFalse(r.out =~ /\[\]/, r.out);
    }

    #! only the Programs that the compiler creates accumulate their diagnostics for its report
    userProgramTest() {
        hash<auto> r = qcc(sprintf("--diag-format=json -c -o %s/user-program.qo %s", tmp.path, user_program));
        assertEq(0, r.status, r.err);
        assertEq((), parse_json(r.out), r.out);
    }

    codeFramesTest() {
        hash<auto> r = qcc(sprintf("--code-frames -c -o %s/out.qo %s", tmp.path, missing_return));
        assertNeq(0, r.status, r.err);
        checkNoBanner(r);
        assertRegex("(^|\n)" + quote(missing_return) + ":2: error\\[MISSING-RETURN\\]: ", r.err);
        assertRegex("\n  int sub f\\(\\) \\{\n", r.err);
    }

    #! escapes \a str for a regular expression
    private static string quote(string str) {
        return regex_subst(str, "([.+*?^$(){}\\[\\]|\\\\])", "\\\\$1", RE_Global);
    }
}

