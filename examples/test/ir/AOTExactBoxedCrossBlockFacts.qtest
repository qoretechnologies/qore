#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
string libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
string qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
    ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : dirname(qore_bin) + "/qcc");
if (!is_file(qcc_bin)) {
    qcc_bin = "qcc";
}

string provider_source = "%modern

*string sub exactString(bool alternate) {
    return alternate ? \"Dvo\\u0159\\u00e1k\" : \"abcdef\";
}

sub clearString(reference<string> value) {
    remove value;
}
";

string consumer_source = "%modern

string sub mergedStringOps(bool alternate, bool branch) {
    *string value;
    if (branch) {
        value = exactString(alternate);
    } else {
        value = exactString(alternate);
    }
    return sprintf(\"%d:%d:%y\", value.size(), value.length(),
        value.contains(\"a\"));
}

int sub maybeLocalLength(bool assign) {
    *string value;
    if (assign) {
        value = exactString(False);
    }
    try {
        return value.length();
    } catch (hash<auto> ex) {
        return ex.err == \"PSEUDO-METHOD-DOES-NOT-EXIST\" ? -1 : -2;
    }
}

int sub removedLocalLength() {
    string value = exactString(False);
    remove value;
    try {
        return value.length();
    } catch (hash<auto> ex) {
        return ex.err == \"PSEUDO-METHOD-DOES-NOT-EXIST\" ? -1 : -2;
    }
}

int sub restoredLocalLength() {
    string value = exactString(False);
    remove value;
    value = exactString(False);
    try {
        return value.length();
    } catch (hash<auto> ex) {
        return ex.err == \"PSEUDO-METHOD-DOES-NOT-EXIST\" ? -1 : -2;
    }
}

int sub conditionallyRemovedLocalLength(bool restore) {
    string value = exactString(False);
    remove value;
    if (restore) {
        value = exactString(False);
    }
    try {
        return value.length();
    } catch (hash<auto> ex) {
        return ex.err == \"PSEUDO-METHOD-DOES-NOT-EXIST\" ? -1 : -2;
    }
}

int sub conditionallyDeletedLocalLength(bool restore) {
    string value = exactString(False);
    delete value;
    if (restore) {
        value = exactString(False);
    }
    try {
        return value.length();
    } catch (hash<auto> ex) {
        return ex.err == \"PSEUDO-METHOD-DOES-NOT-EXIST\" ? -1 : -2;
    }
}

int sub refClearedLocalLength() {
    string value = exactString(False);
    clearString(\\value);
    try {
        return value.length();
    } catch (hash<auto> ex) {
        return ex.err == \"PSEUDO-METHOD-DOES-NOT-EXIST\" ? -1 : -2;
    }
}

int sub crossBlockStringKernel(int rounds, bool branch) {
    *string value;
    if (branch) {
        value = exactString(False);
    } else {
        value = exactString(False);
    }
    int result = 0;
    for (int i = 0; i < rounds; ++i) {
        result += value.size();
        result += value.length();
        result += value.contains(\"a\");
    }
    return result;
}

int sub main() {
    *string rounds_arg = ENV.QORE_EXACT_BOXED_CROSS_BLOCK_ROUNDS;
    int rounds = rounds_arg ? rounds_arg.toInt() : 1000;
    printf(\"%s\\n%s\\n%d:%d\\n%d:%d\\n%d:%d:%d:%d:%d\\n%d\\n\",
        mergedStringOps(False, True),
        mergedStringOps(True, False), maybeLocalLength(True),
        maybeLocalLength(False), restoredLocalLength(), removedLocalLength(),
        conditionallyRemovedLocalLength(True),
        conditionallyRemovedLocalLength(False),
        conditionallyDeletedLocalLength(True),
        conditionallyDeletedLocalLength(False), refClearedLocalLength(),
        crossBlockStringKernel(rounds, True));
    return 0;
}
";

string root = "/tmp/qore-aot-exact-boxed-cross-block-" + string(getpid());
string provider_dir = root + "/provider";
string enabled_dir = root + "/enabled";
string disabled_dir = root + "/disabled";
mkdir(root);
mkdir(provider_dir);
mkdir(enabled_dir);
mkdir(disabled_dir);
on_exit {
    backquote(sprintf("rm -rf %s", root));
}

string provider_path = root + "/provider.qr";
string consumer_path = root + "/consumer.qr";
File provider_file();
provider_file.open2(provider_path, O_WRONLY | O_CREAT | O_TRUNC);
provider_file.write(provider_source);
provider_file.close();
File consumer_file();
consumer_file.open2(consumer_path, O_WRONLY | O_CREAT | O_TRUNC);
consumer_file.write(consumer_source);
consumer_file.close();

string provider_compile = backquote(sprintf(
    "LD_LIBRARY_PATH=%s %s -O3 -c --strip-source --output-dir=%s %s 2>&1",
    libqore_dir, qcc_bin, provider_dir, provider_path));
string provider_qo = provider_dir + "/provider.qo";
if (!is_file(provider_qo)) {
    printf("provider compile failed:\n%s", provider_compile);
    exit(2);
}
unlink(provider_path);

string sub compileConsumer(string output_dir, string env) {
    string output = backquote(sprintf(
        "%s LD_LIBRARY_PATH=%s QORE_IR_OPT_STATS=1 %s -O3 -c -L %s --output-dir=%s %s 2>&1",
        env, libqore_dir, qcc_bin, provider_dir, output_dir,
        consumer_path));
    if (!is_file(output_dir + "/consumer.qo")) {
        printf("consumer compile failed:\n%s", output);
        exit(2);
    }
    return output;
}

string enabled_compile = compileConsumer(enabled_dir, "");
string disabled_compile = compileConsumer(disabled_dir,
    "QORE_DISABLE_AOT_CROSS_BLOCK_BOXED_FACTS=1");
if (!(enabled_compile =~ /IR-OPT-AOT-EFFECTS: mergedStringOps[^:]*:.*cross-block-boxed-facts=[1-9].*boxed-specializations=[1-9]/)
        || !(enabled_compile =~ /IR-OPT-AOT-EFFECTS: crossBlockStringKernel[^:]*:.*cross-block-boxed-facts=[1-9].*boxed-specializations=[1-9]/)
        || enabled_compile =~ /IR-OPT-AOT-EFFECTS: maybeLocalLength[^:]*:.*cross-block-boxed-facts=[1-9]/
        || disabled_compile =~ /cross-block-boxed-facts=[1-9]/
        || disabled_compile =~ /IR-OPT-AOT-EFFECTS: (mergedStringOps|crossBlockStringKernel)[^:]*:.*boxed-specializations=[1-9]/) {
    printf("unexpected exact boxed cross-block stats:\nenabled:\n%sdisabled:\n%s",
        enabled_compile, disabled_compile);
    exit(2);
}

string sub link(string output, string consumer_qo) {
    string link_out = backquote(sprintf(
        "LD_LIBRARY_PATH=%s %s -O3 -o %s %s %s 2>&1",
        libqore_dir, qcc_bin, output, provider_qo, consumer_qo));
    if (!is_file(output)) {
        printf("link failed:\n%s", link_out);
        exit(2);
    }
    return output;
}

string expected = "6:6:True\n8:6:False\n6:-1\n6:-1\n6:-1:6:-1:-1\n13000\n";
foreach string path in ((link(root + "/enabled-exe",
        enabled_dir + "/consumer.qo"), link(root + "/disabled-exe",
        disabled_dir + "/consumer.qo"))) {
    string actual = backquote(sprintf("LD_LIBRARY_PATH=%s %s 2>&1",
        libqore_dir, path));
    if (actual != expected) {
        printf("AOT mismatch for %s:\nexpected:\n%sactual:\n%s",
            path, expected, actual);
        exit(2);
    }
}

exit(0);
