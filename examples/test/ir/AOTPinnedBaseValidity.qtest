%modern
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil
%exec-class PinnedBaseValidityTest

class PinnedBaseValidityTest inherits QUnit::Test {
    private {
        string qore = realpath(ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0]);
        string libdir = realpath(ENV.QORE_LIBDIR ?? dirname(qore));
        string qcc = ENV.QCC ?? libdir + "/qcc";
    }
    constructor() : Test("conditional receiver deletion", "1.0", \ARGV) {
        addTestCase("live base and override admission", \check());
        set_return_value(main());
    }
    private static string quote(string value) {
        return "'" + replace(value, "'", "'\"'\"'") + "'";
    }
    private string run(list<string> args, string prefix = "") {
        int status;
        string output = backquote(prefix + "LD_LIBRARY_PATH=" + quote(libdir)
            + " DYLD_LIBRARY_PATH=" + quote(libdir)
            + " QORE_JIT_SYNC_COMPILE=1 QORE_IR_THRESHOLD=1 QORE_JIT_THRESHOLD=1 "
            + (map quote($1), args).join(" ") + " 2>&1", \status);
        assertEq(0, status, output);
        return output;
    }
    private check() {
        string source = get_script_dir() + "/AOTPinnedBaseValidity.qr";
        string expected = "pinned-base-validity: ok\n";
        foreach string mode in (("ast", "ir", "jit", "tiered")) {
            assertEq(expected, run((qore, "--exec-mode=" + mode, source)), mode);
        }
        TmpDir dir("qore-pinned-base-validity-");
        foreach string prefix in (("", "QORE_DISABLE_AOT_PINNED_BASE_CLASS=1 ",
                "QORE_DISABLE_AOT_INLINE_RECEIVER_VALIDITY=1 ")) {
            foreach string level in (("-O0", "-O3")) {
                string executable = dir.path + "/fixture";
                string ir = run((qcc, level, "--strip-source", "-o", executable, source),
                    prefix + "QORE_DUMP_LLVM_IR=1 ");
                *list<*string> found = regex_extract(ir,
                    "(?s)define [^\n]*@selectedDeleteLoop_[^\n]*\\(ptr %ctx, ptr %xsink\\)[^\n]*\n(.*?)\n\\}");
                assertTrue(!!found, "normal deletion loop entry");
                string body = found[0] ?? "";
                assertEq(prefix == "", regex(body, "pinned_base_receiver_known"), "base identity");
                assertEq(prefix == "", regex(body,
                    "pinned_base_live_status[^\n]*load atomic i32,[^\n]*seq_cst"), "base live deletion check");
                foreach string runtime in (("", "QORE_DISABLE_AOT_NATIVE_METHOD_ENTRY=1 ",
                        "QORE_DISABLE_AOT_INLINE_RECEIVER_VALIDITY=1 ")) {
                    assertEq(expected, run((executable,), runtime), prefix + level + runtime);
                }
            }
        }
    }
}
