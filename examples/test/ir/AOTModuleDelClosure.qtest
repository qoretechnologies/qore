#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-exec-mode: children - the checks compile modules with qcc and run the interpreter in child processes
# test-platform: macos - qcc compiles the module to native code and the interpreter loads it as a binary module

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil

%exec-class AOTModuleDelClosureTest

#! qore#6015: qcc --module compiled a module whose header has a del closure into a crash, and the compiled module did
#! not run the closure when it was unloaded
/** The closure object is released with the module definition context, before the AOT compile has collected the
    locations of the statements that the Program registered, which the released statements left dangling.

    A source module runs its del closure when it is unloaded (at the latest at the end of the process); the compiled
    module runs its closure as a MODULE_DEL init function from qore_aot_module_delete().
*/
class AOTModuleDelClosureTest inherits QUnit::Test {
    private {
        string qore_bin;
        string qcc_bin;
        string libqore_dir;
    }

    constructor() : QUnit::Test("AOTModuleDelClosureTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
            ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");

        addTestCase("a module with a del closure", \testDelClosure());
        addTestCase("a module with an empty del closure", \testEmptyDelClosure());
        addTestCase("a module with init and del closures", \testInitAndDelClosures());
        addTestCase("the del closure runs when the module is unloaded", \testDelRuns());
        addTestCase("the del closure of a module that is imported by two programs runs once", \testDelRunsOnce());
        addTestCase("the del closure uses the static data of its module", \testDelUsesModuleState());
        addTestCase("the del closure of a module runs before those of the modules it requires, indirectly too",
            \testDelOrder());
        addTestCase("the del closure of a local module of a compiled script runs", \testScriptLocalModuleDel());
        addTestCase("the del closures of the local modules of a compiled script run in the order of their dependencies",
            \testScriptLocalModuleDelOrder());

        set_return_value(main());
    }

    private string run(string cmd) {
        return backquote(cmd + " 2>&1");
    }

    private write(string path, string body) {
        File f();
        f.open2(path, O_WRONLY | O_CREAT | O_TRUNC);
        f.write(body);
    }

    private string env() {
        return sprintf("LD_LIBRARY_PATH=%s QORE_LIBDIR=%s", libqore_dir, libqore_dir);
    }

    private string moduleSource(string name, string closures) {
        return sprintf("%%modern
module %s {
    version = \"1.0\";
    desc = \"del closure probe\";
    author = \"Qore Technologies, s.r.o.\";
    license = \"MIT\";
%s}
public namespace %s {
public int sub value() { return 42; }
}
", name, closures, name);
    }

    #! compiles the module with qcc at each optimization level and loads it into a program of its own
    private checkModule(string name, string closures) {
        foreach string opt in ("-O0", "-O3") {
            TmpDir tmp("qore-aot-del-closure-");
            string mod_dir = tmp.path + "/mods";
            mkdir(mod_dir);
            string src = tmp.path + "/" + name + ".qm";
            write(src, moduleSource(name, closures));

            string qmod = mod_dir + "/" + name + ".qmod";
            string out = run(sprintf("%s %s --module %s --output %s %s", env(), qcc_bin, opt, qmod, src));
            assertTrue(is_file(qmod), name + " compiled with " + opt + ": " + out);
            assertTrue(out.find("module compilation") != -1, name + " " + opt + " reports the compilation: " + out);

            string probe = tmp.path + "/probe.qr";
            write(probe, sprintf("%%modern
%%append-module-path %s
%%requires %s
printf(\"value=%%d\\n\", %s::value());
", mod_dir, name, name));
            assertEq("value=42\n", run(sprintf("%s %s -b %s", env(), qore_bin, probe)),
                name + " " + opt + " loads and runs");
        }
    }

    #! the module whose del closure appends a line to the given file
    private string markerModuleSource(string name, string marker, string extra = "") {
        return sprintf("%%modern
module %s {
    version = \"1.0\";
    desc = \"del closure probe\";
    author = \"Qore Technologies, s.r.o.\";
    license = \"MIT\";
    domains = \"FILESYSTEM\";
%s    del = sub () {
        File f();
        f.open2(%y, O_WRONLY | O_CREAT | O_APPEND);
        f.write(\"del\\n\");
    };
}
public namespace %s {
public int sub value() { return 42; }
}
", name, extra, marker, name);
    }

    #! runs the probe program with the marker file; returns the output and the content of the marker file
    private list<string> runWithMarker(string dir, string name, string probe_body) {
        string marker = dir + "/marker.txt";
        unlink(marker);
        string probe = dir + "/probe.qr";
        write(probe, sprintf("%%modern
%%no-child-restrictions
%%append-module-path %s/mods
%%requires %s
%s
", dir, name, probe_body));
        string out = run(sprintf("%s %s -b %s", env(), qore_bin, probe));
        return (out, is_file(marker) ? ReadOnlyFile::readTextFile(marker) : "");
    }

    #! the module as a source module and compiled with each optimization level
    private checkMarker(string name, string probe_body, string expected_marker) {
        TmpDir tmp("qore-aot-del-run-");
        string dir = tmp.path;
        mkdir(dir + "/mods");
        string marker = dir + "/marker.txt";
        write(dir + "/" + name + ".qm", markerModuleSource(name, marker));

        # the source module: the reference
        string src_dir = dir + "/srcmods";
        mkdir(src_dir);
        write(src_dir + "/" + name + ".qm", markerModuleSource(name, marker));
        string probe = dir + "/probe-src.qr";
        write(probe, sprintf("%%modern
%%no-child-restrictions
%%append-module-path %s
%%requires %s
%s
", src_dir, name, probe_body));
        unlink(marker);
        string out = run(sprintf("%s %s -b %s", env(), qore_bin, probe));
        assertEq(expected_marker, is_file(marker) ? ReadOnlyFile::readTextFile(marker) : "",
            "source module del closure runs: " + out);

        foreach string opt in ("-O0", "-O3") {
            string qmod = dir + "/mods/" + name + ".qmod";
            unlink(qmod);
            string cout = run(sprintf("%s %s --module %s --output %s %s/%s.qm", env(), qcc_bin, opt, qmod, dir, name));
            assertTrue(is_file(qmod), name + " compiled with " + opt + ": " + cout);
            list<string> result = runWithMarker(dir, name, probe_body);
            assertEq(expected_marker, result[1], name + " " + opt + " del closure runs like the source module's: "
                + result[0]);
        }
    }

    testDelRuns() {
        checkMarker("AotDelMarker", "printf(\"value=%d\\n\", AotDelMarker::value());", "del\n");
    }

    #! a module that two Programs import: the closure runs once, when the module is unloaded
    testDelRunsOnce() {
        checkMarker("AotDelOnce", "
Program p();
p.parse(\"%requires AotDelOnce\\nint sub f() { return AotDelOnce::value(); }\", \"p\");
printf(\"value=%d %d\\n\", AotDelOnce::value(), p.callFunction(\"f\"));
", "del\n");
    }

    #! a del closure runs while the data of its module exists, as for a source module (qore#5164 ordering)
    testDelUsesModuleState() {
        TmpDir tmp("qore-aot-del-state-");
        string dir = tmp.path;
        mkdir(dir + "/mods");
        mkdir(dir + "/srcmods");
        string marker = dir + "/marker.txt";
        string src = sprintf("%%modern
module AotDelState {
    version = \"1.0\";
    desc = \"del closure probe\";
    author = \"Qore Technologies, s.r.o.\";
    license = \"MIT\";
    domains = \"FILESYSTEM\";
    del = sub () {
        File f();
        f.open2(%y, O_WRONLY | O_CREAT | O_TRUNC);
        f.write(sprintf(\"s=%%s\\n\", AotDelState::Holder::get()));
    };
}
public namespace AotDelState {
public class Holder {
    public { static string s = \"STATIC\"; }
    static string get() { return Holder::s; }
}
}
", marker);
        write(dir + "/AotDelState.qm", src);
        write(dir + "/srcmods/AotDelState.qm", src);
        string body = "printf(\"%s\\n\", AotDelState::Holder::get());";
        string probe_src = dir + "/probe-src.qr";
        write(probe_src, sprintf("%%modern\n%%append-module-path %s/srcmods\n%%requires AotDelState\n%s\n", dir, body));
        string out = run(sprintf("%s %s -b %s", env(), qore_bin, probe_src));
        assertEq("STATIC\n", out, "source module probe output");
        assertEq("s=STATIC\n", is_file(marker) ? ReadOnlyFile::readTextFile(marker) : "", "source module del closure");

        foreach string opt in ("-O0", "-O3") {
            unlink(marker);
            string qmod = dir + "/mods/AotDelState.qmod";
            unlink(qmod);
            string cout = run(sprintf("%s %s --module %s --output %s %s/AotDelState.qm", env(), qcc_bin, opt, qmod,
                dir));
            assertTrue(is_file(qmod), "compiled with " + opt + ": " + cout);
            list<string> result = runWithMarker(dir, "AotDelState", body);
            assertEq("STATIC\n", result[0], "output with " + opt);
            assertEq("s=STATIC\n", result[1], "del closure of the compiled module (" + opt + ") reads its static data: "
                + result[0]);
        }
    }

    #! the module source for the order test: requires the given modules and appends its name to the marker file
    private string orderModuleSource(string name, string marker, string requires_name = "", bool has_del = True) {
        string del = has_del ? sprintf("    del = sub () {
        File f();
        f.open2(%y, O_WRONLY | O_CREAT | O_APPEND);
        f.write(\"%s\\n\");
    };
", marker, name) : "";
        return sprintf("%%modern
%s
module %s {
    version = \"1.0\";
    desc = \"del closure order probe\";
    author = \"Qore Technologies, s.r.o.\";
    license = \"MIT\";
    domains = \"FILESYSTEM\";
%s}
public namespace %s {
public int sub value() { return %d; }
}
", requires_name.empty() ? "" : "%requires " + requires_name, name, del, name,
            requires_name.empty() ? 1 : 2);
    }

    #! A requires B requires C; A and C have del closures and B has none: the closure of A runs before that of C
    /** The closure of a module can use the modules that it requires, which the teardown of those modules ends: so it
        runs first, whether the modules are required directly or through others.  Without the transitive order the
        two closures have no order of their own: the modules are kept in an unordered map, whose order depends on the
        names, so several chains of names are used.
    */
    testDelOrder() {
        foreach string opt in ("-O0", "-O3") {
            TmpDir tmp("qore-aot-del-order-");
            string dir = tmp.path;
            mkdir(dir + "/mods");
            string qm_env = sprintf("%s QORE_MODULE_DIR=%s/mods", env(), dir);
            # the chains: the first of each requires the second, which requires the third
            list<list<string>> chains = (
                ("AotOrderA", "AotOrderB", "AotOrderC"),
                ("AotOrderZ", "AotOrderY", "AotOrderX"),
                ("AotChainOne", "AotChainTwo", "AotChainThree"),
                ("AotChainThree2", "AotChainTwo2", "AotChainOne2"),
                ("AotLeadM", "AotMidM", "AotTailM"),
                ("AotTailN", "AotMidN", "AotLeadN"),
            );
            foreach list<string> chain in (chains) {
                string marker = dir + "/marker-" + chain[0] + ".txt";
                # compiled in the order of the dependencies
                for (int i = 2; i >= 0; --i) {
                    string name = chain[i];
                    write(dir + "/" + name + ".qm", orderModuleSource(name, marker, i == 2 ? "" : chain[i + 1], i != 1));
                    string qmod = dir + "/mods/" + name + ".qmod";
                    string out = run(sprintf("%s %s --module %s --output %s %s/%s.qm", qm_env, qcc_bin, opt, qmod, dir,
                        name));
                    assertTrue(is_file(qmod), name + " compiled with " + opt + ": " + out);
                }
                string probe = dir + "/probe-" + chain[0] + ".qr";
                write(probe, sprintf("%%modern
%%no-child-restrictions
%%append-module-path %s/mods
%%requires %s
printf(\"value=%%d\\n\", %s::value());
", dir, chain[0], chain[0]));
                # qcc loads the compiled modules that a module requires, and runs their del closures when it ends
                unlink(marker);
                # the hook starts the closures in the reverse of the order of the module map, which for modules that were
                # loaded after the modules they require would be the order that the dependencies give
                string out = run(sprintf("QORE_AOT_TEST_REVERSE_DEL_ORDER=1 %s %s -b %s", env(), qore_bin, probe));
                assertEq("value=2\n", out, "output with " + opt);
                assertEq(chain[0] + "\n" + chain[2] + "\n",
                    is_file(marker) ? ReadOnlyFile::readTextFile(marker) : "",
                    "the del closure of " + chain[0] + " runs before that of " + chain[2] + " with " + opt);
            }
        }
    }

    #! the del closure of a source module that a script loads runs when the script ends; compiled with the module
    #! embedded (qcc -c with local source modules) it runs when the compiled script's Program is cleared
    testScriptLocalModuleDel() {
        TmpDir tmp("qore-aot-del-script-");
        string dir = tmp.path;
        mkdir(dir + "/mods");
        string marker = dir + "/marker.txt";
        write(dir + "/mods/AotScriptDel.qm", markerModuleSource("AotScriptDel", marker));
        string script = dir + "/script.qr";
        write(script, sprintf("%%modern
%%no-child-restrictions
%%append-module-path %s/mods
%%requires AotScriptDel
printf(\"value=%%d\\n\", AotScriptDel::value());
", dir));
        # the reference: the interpreter and the source module
        unlink(marker);
        string expected = run(sprintf("%s %s -b %s", env(), qore_bin, script));
        assertEq("value=42\n", expected, "interpreter output");
        assertEq("del\n", is_file(marker) ? ReadOnlyFile::readTextFile(marker) : "", "the source module's del closure ran");

        foreach string opt in ("-O0", "-O3") {
            unlink(marker);
            string exe = dir + "/script" + opt;
            unlink(exe);
            string out = run(sprintf("%s %s %s -o %s %s", env(), qcc_bin, opt, exe, script));
            assertTrue(is_file(exe), "executable compiled with " + opt + ": " + out);
            unlink(marker);
            string result = run(sprintf("LD_LIBRARY_PATH=%s %s -b", libqore_dir, exe));
            assertEq(expected, result, "output of the executable with " + opt);
            assertEq("del\n", is_file(marker) ? ReadOnlyFile::readTextFile(marker) : "",
                "the del closure of the embedded local module runs with " + opt + ": " + result);
        }
    }

    #! two local modules of a script, the first requiring the second: its del closure runs first, though the names sort
    #! the other way for the closures that the compiler collects
    testScriptLocalModuleDelOrder() {
        TmpDir tmp("qore-aot-del-script-order-");
        string dir = tmp.path;
        mkdir(dir + "/mods");
        string marker = dir + "/marker.txt";
        write(dir + "/mods/AotScrA.qm", orderModuleSource("AotScrA", marker, "AotScrB"));
        write(dir + "/mods/AotScrB.qm", orderModuleSource("AotScrB", marker));
        string script = dir + "/script.qr";
        write(script, sprintf("%%modern
%%no-child-restrictions
%%append-module-path %s/mods
%%requires AotScrA
printf(\"value=%%d\\n\", AotScrA::value());
", dir));
        unlink(marker);
        string expected = run(sprintf("%s %s -b %s", env(), qore_bin, script));
        assertEq("value=2\n", expected, "interpreter output");
        foreach string opt in ("-O0", "-O3") {
            string exe = dir + "/script" + opt;
            unlink(exe);
            string out = run(sprintf("%s %s %s -o %s %s", env(), qcc_bin, opt, exe, script));
            assertTrue(is_file(exe), "executable compiled with " + opt + ": " + out);
            unlink(marker);
            string result = run(sprintf("LD_LIBRARY_PATH=%s %s -b", libqore_dir, exe));
            assertEq(expected, result, "output of the executable with " + opt);
            assertEq("AotScrA\nAotScrB\n", is_file(marker) ? ReadOnlyFile::readTextFile(marker) : "",
                "the closure of AotScrA runs before that of AotScrB with " + opt + ": " + result);
        }
    }

    testDelClosure() {
        checkModule("AotDelProbe", "    del = sub () { int i = 1; };\n");
    }

    testEmptyDelClosure() {
        checkModule("AotEmptyDelProbe", "    del = sub () { };\n");
    }

    testInitAndDelClosures() {
        checkModule("AotInitDelProbe", "    init = sub () { int j = 2; };\n    del = sub () { int i = 1; };\n");
    }
}
