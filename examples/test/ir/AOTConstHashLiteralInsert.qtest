#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
string libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
string qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
    ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : dirname(qore_bin) + "/qcc");
if (!is_file(qcc_bin)) {
    qcc_bin = "qcc";
}

string code = "%modern
%disable-warning duplicate-hash-key

hash<auto> sub makeMixedPair(int number, string text) {
    return {
        \"number\": number,
        \"text\": text,
    };
}

hash<auto> sub makeTriple(int number) {
    return {
        \"first\": number,
        \"second\": number + 1,
        \"third\": number + 2,
    };
}

hash<auto> sub makeMixedTriple(int number, string text, list<int> values) {
    return {
        \"number\": number,
        \"text\": text,
        \"values\": values,
    };
}

hash<auto> sub makeNothingTriple(int number) {
    return {
        \"nothing\": NOTHING,
        \"first\": number,
        \"second\": number + 1,
    };
}

hash<auto> unique = {
    \"alpha-long-key\": 1,
    \"beta-long-key\": \"two\",
    \"gamma-long-key\": NOTHING,
};
hash<auto> duplicate = {
    \"same-long-key\": 1,
    \"other-long-key\": 2,
    \"same-long-key\": 3,
};
hash<string, softint> typed = {
    \"converted-long-key\": \"42\",
};
hash<auto> empty = {};
hash<auto> single = {
    \"single-long-key\": 7,
};
hash<auto> pair_same = {
    \"pair-int-a\": 10,
    \"pair-int-b\": 20,
};
hash<auto> pair_mixed = {
    \"pair-mixed-a\": 10,
    \"pair-mixed-b\": \"twenty\",
};
hash<auto> pair_scanned = {
    \"pair-list-a\": (1,),
    \"pair-list-b\": (2,),
};
hash<auto> pair_nothing = {
    \"pair-nothing-a\": NOTHING,
    \"pair-nothing-b\": 30,
};
hash<auto> function_mixed = makeMixedPair(40, \"forty\");
hash<auto> function_triple = makeTriple(50);
hash<auto> function_mixed_triple = makeMixedTriple(60, \"sixty\", (60, 61));
hash<auto> function_nothing_triple = makeNothingTriple(70);

printf(\"%y|%y|%y|%s|%d\\n\", unique, duplicate, typed,
    join(\",\", keys duplicate), duplicate{\"same-long-key\"});
printf(\"%d|%d\\n\", empty.size(), single{\"single-long-key\"});
printf(\"%s|%s|%s|%d|%s\\n\", pair_same.fullType(), pair_mixed.fullType(),
    pair_scanned.fullType(), pair_same{\"pair-int-b\"}, pair_mixed{\"pair-mixed-b\"});
printf(\"%s|%s|%s\\n\", pair_nothing.fullType(), join(\",\", keys pair_nothing),
    exists pair_nothing{\"pair-nothing-a\"} ? \"exists\" : \"nothing\");
printf(\"%s|%d|%s\\n\", function_mixed.fullType(),
    function_mixed.number, function_mixed.text);
printf(\"%s|%d|%d\\n\", function_triple.fullType(),
    function_triple.first, function_triple.third);
printf(\"%s|%d|%s|%d\\n\", function_mixed_triple.fullType(),
    function_mixed_triple.number, function_mixed_triple.text,
    function_mixed_triple.values[1]);
printf(\"%s|%s|%d\\n\", function_nothing_triple.fullType(),
    exists function_nothing_triple.nothing ? \"exists\" : \"nothing\",
    function_nothing_triple.second);
";

list<string> large_entries;
for (int i = 0; i < 40; ++i) {
    push large_entries, sprintf("\"large-constant-key-%02d\": %d", i, i);
}
list<string> oversized_entries;
for (int i = 0; i < 101; ++i) {
    push oversized_entries, sprintf("\"oversized-constant-key-%03d\": %d", i, i);
}
code += sprintf("
hash<auto> large_unique = {%s};
hash<auto> large_duplicate = {%s, \"large-constant-key-00\": 99};
printf(\"%%d|%%d|%%d|%%d\\n\", large_unique.size(),
    large_unique{\"large-constant-key-39\"}, large_duplicate.size(),
    large_duplicate{\"large-constant-key-00\"});
hash<auto> oversized = {%s};
printf(\"%%d|%%d\\n\", oversized.size(), oversized{\"oversized-constant-key-100\"});
", join(",", large_entries), join(",", large_entries), join(",", oversized_entries));

string script_path = "/tmp/qore-aot-const-hash-literal-" + string(getpid()) + ".qr";
File script();
script.open2(script_path, O_WRONLY | O_CREAT | O_TRUNC);
script.write(code);
script.close();

string sub runMode(string mode, string env) {
    return backquote(sprintf("%s LD_LIBRARY_PATH=%s %s -b --exec-mode=%s %s 2>&1",
        env, libqore_dir, qore_bin, mode, script_path));
}

hash<string, string> aot_compile_outputs;
hash<string, string> aot_symbol_outputs;

string sub runAot(string suffix, string env) {
    string exe = "/tmp/qore-aot-const-hash-literal-" + string(getpid()) + suffix;
    string compile_out = backquote(sprintf(
        "%s QORE_AOT_DEBUG=1 LD_LIBRARY_PATH=%s %s "
            + "--strip-debug-info -O3 -o %s %s 2>&1",
        env, libqore_dir, qcc_bin, exe, script_path));
    aot_compile_outputs{suffix} = compile_out;
    if (!is_file(exe)) {
        printf("AOT compile failed (%s):\n%s", suffix, compile_out);
        exit(2);
    }
    aot_symbol_outputs{suffix} =
        backquote(sprintf("nm -u %s 2>&1", exe));
    return backquote(sprintf("LD_LIBRARY_PATH=%s %s 2>&1", libqore_dir, exe));
}

string expected = "{alpha-long-key: 1, beta-long-key: \"two\", gamma-long-key: null}|"
    + "{same-long-key: 3, other-long-key: 2}|{converted-long-key: 42}|"
    + "same-long-key,other-long-key|3\n0|7\n"
    + "hash<string, int>|hash<auto>|hash<string, list<int>>|20|twenty\n"
    + "hash<string, *int>|pair-nothing-a,pair-nothing-b|nothing\n"
    + "hash<auto>|40|forty\n"
    + "hash<string, int>|50|52\n"
    + "hash<auto>|60|sixty|61\n"
    + "hash<auto>|nothing|71\n"
    + "40|39|40|99\n101|100\n";

foreach string mode in (("ast", "ir", "tiered", "jit")) {
    foreach string env in (("", "QORE_DISABLE_IR_UNIQUE_HASH_LITERAL_INSERT=1")) {
        string actual = runMode(mode, env);
        if (actual != expected) {
            printf("mismatch in %s (%s)\nexpected:\n%sactual:\n%s",
                mode, env ? "fallback" : "optimized", expected, actual);
            exit(2);
        }
    }
}

hash<string, string> aot_modes = {
    "-optimized": "",
    "-fallback": "QORE_DISABLE_IR_UNIQUE_HASH_LITERAL_INSERT=1",
    "-pair-fallback": "QORE_DISABLE_AOT_FIXED_HASH_2_BUILD=1",
    "-triple-fallback": "QORE_DISABLE_AOT_FIXED_HASH_3_BUILD=1",
    "-auto-fallback": "QORE_DISABLE_AOT_FIXED_HASH_AUTO_TYPE=1",
};
foreach string suffix in (keys aot_modes) {
    string actual = runAot(suffix, aot_modes{suffix});
    if (actual != expected) {
        printf("AOT mismatch in %s\nexpected:\n%sactual:\n%s", suffix, expected, actual);
        exit(2);
    }
}
if (!aot_symbol_outputs{"-optimized"}.regex(
        "qore_rt_make_hash_const_keys_3_unique")
        || aot_symbol_outputs{"-triple-fallback"}.regex(
            "qore_rt_make_hash_const_keys_3_unique")) {
    printf("unexpected fixed three-key hash helper selection:\n"
        + "optimized:\n%sdisabled:\n%s",
        aot_symbol_outputs{"-optimized"},
        aot_symbol_outputs{"-triple-fallback"});
    exit(2);
}
if (!aot_compile_outputs{"-optimized"}.regex(
        "fixed hash literal in 'makeMixedPair'.*known_auto=1")
        || aot_compile_outputs{"-auto-fallback"}.regex(
            "fixed hash literal in 'makeMixedPair'.*known_auto=1")) {
    printf("unexpected fixed hash auto-type proof:\noptimized:\n%s"
        + "auto fallback:\n%s", aot_compile_outputs{"-optimized"},
        aot_compile_outputs{"-auto-fallback"});
    exit(2);
}
