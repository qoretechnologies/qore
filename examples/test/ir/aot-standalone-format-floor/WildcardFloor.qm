%modern

module WildcardFloor {
    version = "1.0";
    desc = "AOT format-floor test fixture";
    author = "Qore";
    license = "MIT";
}

public namespace WildcardFloor {
    class Box<T> {
        public { T value; }
        constructor(T v) { value = v; }
    }

    auto sub readBox<T>(auto input) {
        union<Box<T>, ? super T> box = input;
        return box.value;
    }

    public int sub run() {
        return readBox<int>(new Box<int>(42));
    }
}
