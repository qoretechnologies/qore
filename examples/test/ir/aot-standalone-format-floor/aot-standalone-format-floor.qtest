#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-exec-mode: children - the checks run qcc executables in child processes
# test-platform: macos - AOT executable linking, dylib selection and re-signing patched Mach-O images
# Copyright (C) 2026 Qore Technologies, s.r.o.
# SPDX-License-Identifier: LGPL-2.1-or-later

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires ../../TestInterpreter.qm
%requires FsUtil

%exec-class AotStandaloneFormatFloorTest

#! a standalone qcc executable whose embedded image has an older or a newer AOT format is refused when it starts
/** A qcc executable embeds the image of its program (the AOT metadata, header magic "QORD" followed by the format
    version as a little-endian u16) and reads it when it starts, before any module is loaded or any record of the
    image is used.  An executable built by an older qcc must not run with a newer libqore whose format floor it is
    below: its records (e.g. constructor expression records of the format before the floor) would otherwise be read
    as the current format.  The test compiles a program, checks that it runs, and then stamps the embedded image with
    the format version before and after the one that it was written with:
    - the version before: refused with exit code 2 and a message to rebuild the artifact (each batch's format bump
      sets the minimum version that the reader accepts to the version that it writes, so the version before is
      always below the floor);
    - the version after: refused with exit code 2 and a message to update Qore.
    With QORE_TEST_AOT_V51_LIBDIR set to a v51 runtime, the test also runs the unmodified wildcard
    executable and a source-free qmod against that runtime and requires rejection before user code runs.
    When that directory also has the qcc of the v51 build, the test compiles an executable and a source-free qmod
    with it and requires this runtime to refuse them before user code runs: a v51 image has no owner-qualified
    wildcard bounds (qore#7184), no declaration index in its METHODS records (qore#7169) and no callee in its
    background helpers (qore#7087), which this reader must never read; the executable is refused by its format
    version, the module by its AOT runtime identity.
    On macOS the patched executable is signed again (ad hoc), as the system does not run an executable whose
    signature no longer matches.
*/
class AotStandaloneFormatFloorTest inherits QUnit::Test {
    public {
        #! the magic of an AOT image, as it is written (QORE_AOT_BINARY_MAGIC, little endian)
        const Magic = <514f5244>;
    }

    private {
        string qore_bin;
        string qcc_bin;
        string env;
        string dir;
    }

    constructor() : QUnit::Test("standalone AOT format floor", "1.0", \ARGV) {
        qore_bin = TestInterpreter::qore_interpreter();
        string libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
            ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");
        env = sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s QORE_LIBDIR=%s", shellQuote(libqore_dir),
            shellQuote(libqore_dir), shellQuote(libqore_dir));
        dir = get_script_dir();
        addTestCase("older format refused", \olderFormatTest());
        addTestCase("newer format refused", \newerFormatTest());
        addTestCase("v51 runtime refuses the wildcard image", \oldRuntimeTest());
        addTestCase("v51 runtime refuses the wildcard qmod", \oldModuleRuntimeTest());
        addTestCase("a v51 executable is refused", \v51ImageTest());
        addTestCase("a v51 qmod is refused", \v51ModuleTest());
        set_return_value(main());
    }

    olderFormatTest() {
        hash<auto> r = runStamped(-1);
        assertEq(2, r.rc, r.out);
        assertRegex("AOT-ERROR: the AOT-compiled program .* cannot be loaded", r.out);
        assertTrue(r.out.find(sprintf("unsupported binary format version %d (supported %d-%d); rebuild the artifact "
            "with this version of qcc", r.version - 1, r.version, r.version)) >= 0, r.out);
        assertFalse(r.out.find("standalone program ran") >= 0, r.out);
    }

    newerFormatTest() {
        hash<auto> r = runStamped(1);
        assertEq(2, r.rc, r.out);
        assertRegex("AOT-ERROR: the AOT-compiled program .* cannot be loaded", r.out);
        assertTrue(r.out.find(sprintf("unsupported binary format version %d", r.version + 1)) >= 0, r.out);
        assertTrue(r.out.find("please update your Qore installation") >= 0, r.out);
        assertFalse(r.out.find("standalone program ran") >= 0, r.out);
    }

    private string previousRuntimeDir() {
        *string libdir = ENV.QORE_TEST_AOT_V51_LIBDIR;
        if (!libdir) {
            testSkip("set QORE_TEST_AOT_V51_LIBDIR to the directory of a v51 libqore to test across runtimes");
        }
        return libdir;
    }

    oldRuntimeTest() {
        string libdir = previousRuntimeDir();
        TmpDir tmp("aot-v51-wildcard-");
        string exe = tmp.path + "/wildcard";
        compileAndRun(exe);
        int rc;
        string cmd = sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s %s -b 2>&1",
            shellQuote(libdir), shellQuote(libdir), shellQuote(exe));
        string out = backquote(cmd, \rc);
        assertEq(2, rc, out);
        assertRegex("unsupported binary format version [0-9]+ \\(supported 51-51\\)", out);
        assertTrue(out.find("please update your Qore installation") >= 0, out);
        assertFalse(out.find("standalone program ran") >= 0, out);
    }

    oldModuleRuntimeTest() {
        string libdir = previousRuntimeDir();
        TmpDir tmp("aot-v51-wildcard-module-");
        string image = tmp.path + "/WildcardFloor.qmod";
        int rc;
        string out = backquote(sprintf("%s %s -O0 -m -o %s %s 2>&1", env, shellQuote(qcc_bin),
            shellQuote(image), shellQuote(dir + "/WildcardFloor.qm")), \rc);
        assertEq(0, rc, out);

        formatVersionOffset(ReadOnlyFile::readBinaryFile(image));

        # Load only the compiled module from the temporary directory. Re-parsing its source would mask a refusal.
        string load = sprintf("QORE_MODULE_DIR_ONLY=1 QORE_MODULE_DIR=%s %s -b -ne %s 2>&1", shellQuote(tmp.path), shellQuote(qore_bin),
            shellQuote("%requires WildcardFloor\nprintf(\"wildcard module ran: %d\\n\", WildcardFloor::run());"));
        out = backquote(env + " " + load, \rc);
        assertEq(0, rc, out);
        assertEq("wildcard module ran: 42\n", out);
        out = backquote(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s %s",
            shellQuote(libdir), shellQuote(libdir), load), \rc);
        assertEq(2, rc, out);
        assertTrue(out.find("WildcardFloor.qmod") >= 0, out);
        assertTrue(out.find("compiled for AOT runtime identity") >= 0
            || out.find("unsupported binary format version") >= 0, out);
        assertFalse(out.find("wildcard module ran: 42") >= 0, out);
    }

    #! returns the format version that the qcc of this build writes
    private int currentFormat() {
        int rc;
        string out = backquote(sprintf("%s %s --version 2>&1", env, shellQuote(qcc_bin)), \rc);
        assertEq(0, rc, out);
        *string v = (out =~ x/AOT binary format: ([0-9]+)/)[0];
        assertTrue(exists v, "qcc --version reports its format: " + out);
        return v.toInt();
    }

    #! returns the directory of a v51 build (its qcc and libqore), or skips the test case
    private string v51BuildDir() {
        *string libdir = ENV.QORE_TEST_AOT_V51_LIBDIR;
        if (!libdir) {
            testSkip("set QORE_TEST_AOT_V51_LIBDIR to the directory of a v51 build (qcc and libqore) to test v51 "
                "artifacts");
        }
        # the directory can be a v51 runtime without its qcc, which the cases of the v51 runtime use alone
        if (!is_file(libdir + "/qcc")) {
            testSkip(sprintf("QORE_TEST_AOT_V51_LIBDIR=%y has no qcc to compile v51 artifacts with", libdir));
        }
        return libdir;
    }

    #! compiles a source with the qcc of the v51 build and checks that the artifact is a v51 image
    private compileV51(string libdir, string args, string target) {
        int rc;
        string out = backquote(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s QORE_LIBDIR=%s %s %s 2>&1",
            shellQuote(libdir), shellQuote(libdir), shellQuote(libdir), shellQuote(libdir + "/qcc"), args), \rc);
        assertEq(0, rc, "v51 qcc: " + out);
        binary image = ReadOnlyFile::readBinaryFile(target);
        assertEq(51, getU16(image, formatVersionOffset(image)), "the v51 qcc wrote a v51 image");
    }

    v51ImageTest() {
        string libdir = v51BuildDir();
        TmpDir tmp("aot-v51-image-");
        string exe = tmp.path + "/v51";
        compileV51(libdir, sprintf("-O0 -o %s %s", shellQuote(exe), shellQuote(dir + "/aot-standalone-format-floor.q")),
            exe);
        int rc;
        string out = backquote(sprintf("%s %s -b 2>&1", env, shellQuote(exe)), \rc);
        assertEq(2, rc, out);
        assertRegex("AOT-ERROR: the AOT-compiled program .* cannot be loaded", out);
        assertTrue(out.find(sprintf("unsupported binary format version 51 (supported %d-%d); rebuild the artifact "
            "with this version of qcc", currentFormat(), currentFormat())) >= 0, out);
        assertFalse(out.find("standalone program ran") >= 0, out);
    }

    v51ModuleTest() {
        string libdir = v51BuildDir();
        TmpDir tmp("aot-v51-module-");
        string image = tmp.path + "/WildcardFloor.qmod";
        compileV51(libdir, sprintf("-O0 -m -o %s %s", shellQuote(image), shellQuote(dir + "/WildcardFloor.qm")),
            image);
        # load only the compiled module: its source would be loaded instead of a refused image otherwise
        int rc;
        string out = backquote(sprintf("%s QORE_MODULE_DIR_ONLY=1 QORE_MODULE_DIR=%s %s -b -ne %s 2>&1", env,
            shellQuote(tmp.path), shellQuote(qore_bin),
            shellQuote("%requires WildcardFloor\nprintf(\"wildcard module ran: %d\\n\", WildcardFloor::run());")),
            \rc);
        assertEq(2, rc, out);
        assertTrue(out.find("WildcardFloor.qmod") >= 0, out);
        # an AOT module records the AOT runtime identity of the libqore that it was compiled for, which the loader checks
        # before it reads the image, so a v51 module is refused by its identity
        assertTrue(out.find("LOAD-MODULE-ERROR: AOT module") >= 0, out);
        assertRegex("the module was compiled for AOT runtime identity '[0-9a-f]+', but this Qore runtime \\(libqore "
            "[^)]+\\) has AOT runtime identity '[0-9a-f]+'", out);
        assertTrue(out.find("rebuild the module with the qcc of this Qore installation") >= 0, out);
        assertFalse(out.find("wildcard module ran") >= 0, out);
    }

    private static string shellQuote(string s) {
        return "'" + replace(s, "'", "'\"'\"'") + "'";
    }

    #! compiles the program, checks that it runs, stamps its image with the format version + delta and runs it
    /** @return a hash: \c version: the format version that qcc wrote; \c rc: the exit code of the stamped
        executable; \c out: its output (stdout and stderr)
    */
    private hash<auto> runStamped(int delta) {
        TmpDir tmp("aot-standalone-format-floor-");
        string exe = tmp.path + "/aot-standalone-format-floor";
        compileAndRun(exe);
        int rc;
        string out;

        binary image = ReadOnlyFile::readBinaryFile(exe);
        int off = formatVersionOffset(image);
        int version = getU16(image, off);
        int stamped = version + delta;
        binary patched = image.substr(0, off) + parse_hex_string(sprintf("%02x%02x", stamped & 0xff, stamped >> 8))
            + image.substr(off + 2);
        assertEq(image.size(), patched.size());
        {
            File f();
            f.open2(exe, O_CREAT | O_WRONLY | O_TRUNC, 0755);
            f.write(patched);
            f.close();
        }
        chmod(exe, 0755);
        if (PlatformOS == "Darwin") {
            out = backquote(sprintf("codesign -f -s - %s 2>&1", shellQuote(exe)), \rc);
            assertEq(0, rc, "codesign: " + out);
        }
        out = backquote(sprintf("%s %s 2>&1", env, shellQuote(exe)), \rc);
        return {"version": version, "rc": rc, "out": out};
    }

    # Each fixture embeds one QORD image. Ignore occurrences of the magic outside plausible headers.
    private int formatVersionOffset(binary image) {
        list<int> offsets;
        int pos = 0;
        while ((pos = image.find(Magic, pos)) >= 0) {
            pos += Magic.size();
            if (pos + 2 <= image.size()) {
                int version = getU16(image, pos);
                if (version >= 9 && version < 1000) {
                    offsets += pos;
                }
            }
        }
        assertEq(1, offsets.size(), "one embedded AOT image header");
        assertTrue(getU16(image, offsets[0]) >= 52, "a v51 reader must refuse owner-qualified wildcard bounds");
        return offsets[0];
    }

    private compileAndRun(string exe) {
        if (!is_file(qcc_bin)) {
            testSkip("qcc is not available at " + qcc_bin);
        }
        int rc;
        string out = backquote(sprintf("%s %s -O0 -o %s %s 2>&1", env, shellQuote(qcc_bin), shellQuote(exe),
            shellQuote(dir + "/aot-standalone-format-floor.q")), \rc);
        assertEq(0, rc, "qcc: " + out);
        assertTrue(is_file(exe), "qcc wrote the executable: " + out);
        out = backquote(sprintf("%s %s 2>&1", env, shellQuote(exe)), \rc);
        assertEq(0, rc, out);
        assertEq("standalone program ran: 42\n", out);
    }

    #! returns the little-endian u16 at the offset of the binary
    private static int getU16(binary b, int offset) {
        return get_byte(b, offset) | (get_byte(b, offset + 1) << 8);
    }
}
