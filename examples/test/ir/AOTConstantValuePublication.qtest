#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil

%exec-class AOTConstantValuePublicationTest

#! A constant value stored by a deferred AOT initializer must not be copied half-stored
/** Loading an AOT module runs its deferred constant initializers and stores each result
    (ConstantEntry::setRuntimeValue()) in the Program the module is loaded into.  When that Program is itself a
    module's Program - a class method of a module calling load_module(), as ProviderIndexUtil::tryLoadModule()
    does - every import of that module copies the entries while they are being stored, and the store excluded
    no copy.  A copy could take the value from after the store and the flags describing it from before, so it
    held a value it never released; a debug build aborted when the importing Program was destroyed (CI job
    203834, concurrent-module-program-merge.qtest):

    @verbatim
ConstantEntry::~ConstantEntry(): Assertion `saved_val.isNothing()' failed
ConstantEntry::deref(QoreListNode&)
ConstantList::clear(QoreListNode&)
qore_ns_private::clearConstants(QoreListNode&)
qore_program_private::waitForTerminationAndClear(ExceptionSink*)
    @endverbatim

    A debug hook holds the loading thread inside the store (dbg_hold_constant_store()), where a copy can run
    concurrently with it, so the test only runs against a debug build.  One import made meanwhile is released
    without being read - a read would initialize the copy itself and hide the defect - and another is read once
    the load is done.

    A module now exports only its own declarations and the modules it reexports, so importing Outer no longer
    copies the constants its code loaded from Inner at all: they are not visible through Outer during or after the
    load, and a Program reads them by importing Inner itself.
*/
class AOTConstantValuePublicationTest inherits QUnit::Test {
    private {
        string qore_bin;
        string libqore_dir;

        #! the values every read must return
        const Expected = {
            "leaf": {"a": 1, "b": (1, 2)},
            "tree": {
                "leaf": {"a": 1, "b": (1, 2)},
                "list": ({"a": 1, "b": (1, 2)}, {"a": 1, "b": (1, 2)}),
            },
        };

        #! a module whose constants are initialized when it is loaded, one holding references to the other
        const InnerSource = "%modern
module Inner {
    version = \"1.0\";
    desc = \"deferred constants referring to other constants\";
    author = \"Qore Technologies, s.r.o.\";
    url = \"https://qore.org\";
}

public namespace Inner {
    public hash<auto> sub make_leaf() {
        return {\"a\": 1, \"b\": (1, 2)};
    }

    public const Leaf = make_leaf();
    public const Tree = {\"leaf\": Leaf, \"list\": (Leaf, Leaf)};
}
";

        #! a module whose code loads Inner into the module's own Program
        /** A class method runs in the Program of the module that declares it, so Inner's constants are stored in
            Outer's Program; ProviderIndexUtil::tryLoadModule() has the same shape.  Outer does not reexport Inner,
            so an import of Outer does not copy them.
        */
        const OuterSource = "%modern
module Outer {
    version = \"1.0\";
    desc = \"loads a module into its own Program\";
    author = \"Qore Technologies, s.r.o.\";
    url = \"https://qore.org\";
}

public namespace Outer {
    public class Loader {
        static loadInner() {
            load_module(\"Inner\");
        }
    }
}
";

        #! run in a child process, so a failed assertion in the library aborts the child and not the test
        const RaceScript = "%modern
%requires Outer

Program sub import_outer() {
    Program p(PO_NEW_STYLE);
    p.loadModule(\"Outer\");
    return p;
}

# the values of Inner's constants read in the given Program, or the parse exception code if it cannot see them
string sub read(Program p) {
    try {
        p.parse(\"hash<auto> sub get() { return {\\\"leaf\\\": Inner::Leaf, \\\"tree\\\": Inner::Tree}; }\", \"get\");
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
    return sprintf(\"%y\", p.callFunction(\"get\"));
}

Counter held(1);
Counter release(1);
Counter done(1);
call_function(\"dbg_hold_constant_store\", \"Leaf\", held, release);
background sub () {
    on_exit done.dec();
    Outer::Loader::loadInner();
}();
held.waitForZero();

# the loading thread is storing Leaf's value in Outer's Program while Outer is imported.  A read would
# initialize a copy itself, so one import is only released and the other is read once the load is done.
Program released = import_outer();
Program during = import_outer();

release.dec();
done.waitForZero();

# a copy that took the value without the flags describing it fails ConstantEntry's destructor assertion here
delete released;
printf(\"released\\n\");
# Outer does not export the constants its code loaded from Inner
printf(\"during: %s\\n\", read(during));
printf(\"after: %s\\n\", read(import_outer()));
# a Program importing Inner itself reads the values stored while the import of Outer ran
Program direct(PO_NEW_STYLE);
direct.loadModule(\"Inner\");
printf(\"direct: %s\\n\", read(direct));
";
    }

    constructor() : QUnit::Test("AOTConstantValuePublicationTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);

        addTestCase("a constant copied while its value is stored", \testCopyDuringStore());

        set_return_value(main());
    }

    private write(string path, string body) {
        File f();
        f.open2(path, O_WRONLY | O_CREAT | O_TRUNC);
        f.write(body);
    }

    #! Compiles a module source to a .qmod in \a dir
    private compileModule(string dir, string module_name, string body) {
        string qm_path = sprintf("%s/%s.qm", dir, module_name);
        string qmod_path = sprintf("%s/%s.qmod", dir, module_name);
        write(qm_path, body);
        string out = backquote(sprintf("QORE_LIBDIR=%s %s -b --compile-module --strip-source --output %s %s 2>&1",
            libqore_dir, qore_bin, qmod_path, qm_path));
        assertTrue(is_file(qmod_path), sprintf("compiled module %s: %s", module_name, out));
        # the source must not shadow the compiled module
        unlink(qm_path);
    }

    testCopyDuringStore() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("the hook that holds the storing thread is only in debug builds");
        }
        TmpDir tmp("qore-aot-constant-publication-");
        compileModule(tmp.path, "Inner", InnerSource);
        compileModule(tmp.path, "Outer", OuterSource);
        string script = tmp.path + "/race.q";
        write(script, RaceScript);

        string output = backquote(sprintf("LD_LIBRARY_PATH=%s QORE_MODULE_DIR=%s %s -b %s 2>&1; echo \"rc=$?\"",
            libqore_dir, tmp.path, qore_bin, script));
        *list<*string> rc = (output =~ x/rc=([0-9]+)\s*$/);
        assertEq("0", rc[0], "the child exits normally: " + output);

        *list<*string> during = (output =~ x/during: ([^\n]*)/);
        assertEq("PARSE-EXCEPTION", during[0], "an import of Outer made during the store does not see Inner: "
            + output);
        *list<*string> after = (output =~ x/after: ([^\n]*)/);
        assertEq("PARSE-EXCEPTION", after[0], "an import of Outer made after the load does not see Inner: " + output);
        *list<*string> direct = (output =~ x/direct: ([^\n]*)/);
        assertEq(sprintf("%y", Expected), direct[0], "the values read by importing Inner: " + output);
        assertTrue(output =~ /^released\n/m, "a copy made during the store is released: " + output);
    }
}
