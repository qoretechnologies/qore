%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil
%exec-class AOTSameListPublicationTest

class AOTSameListPublicationTest inherits QUnit::Test {
    private {
        string qore = realpath(ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0]);
        string libdir = realpath(ENV.QORE_LIBDIR ?? dirname(qore));
        string qcc = ENV.QCC ?? libdir + "/qcc";
    }
    constructor() : Test("AOT same-list publication", "1.0", \ARGV) {
        addTestCase("same root, replacement, captures and reflection", \check());
        set_return_value(main());
    }
    private static string quote(string value) {
        return "'" + replace(value, "'", "'\"'\"'") + "'";
    }
    private string run(list<string> args, string prefix = "") {
        int status;
        string output = backquote(prefix + "LD_LIBRARY_PATH=" + quote(libdir)
            + " DYLD_LIBRARY_PATH=" + quote(libdir)
            + " QORE_JIT_SYNC_COMPILE=1 QORE_IR_THRESHOLD=1 QORE_JIT_THRESHOLD=1 "
            + (map quote($1), args).join(" ") + " 2>&1", \status);
        assertEq(0, status, output);
        return output;
    }
    private string body(string ir, string name) {
        *list<*string> found = regex_extract(ir,
            "(?s)define [^\n]*@" + name + "_[^\n]*\\(ptr %ctx, ptr %xsink\\)[^\n]*\n(.*?)\n\\}");
        assertTrue(!!found, name + " ordinary LLVM entry");
        return found[0] ?? "";
    }
    private check() {
        string source = get_script_dir() + "/AOTSameListPublication.qr";
        string expected = run((qore, "--exec-mode=ast", source));
        assertRegex("cow:0:\\[2, 1\\]:\\[0\\]", expected);
        assertRegex("recursive:55", expected);
        assertRegex("same-list-publication: ok", expected);
        foreach string mode in (("ir", "jit", "tiered")) {
            assertEq(expected, run((qore, "--exec-mode=" + mode, source)), mode);
        }
        TmpDir dir("qore-same-list-publication-");
        foreach string prefix in (("", "QORE_AOT_EH=1 ", "QORE_AOT_NO_DEBUG_INFO=1 ",
                "MAKEFLAGS= QCC_JOBS=4 QCC_SPLIT_THRESHOLD=1 ",
                "QORE_DISABLE_AOT_SAME_LIST_PUBLICATION=1 ",
                "QORE_DISABLE_AOT_PREPARED_LOCAL_RELOAD=1 ")) {
            foreach string level in (("-O0", "-O3")) {
                string executable = dir.path + "/fixture";
                string ir = run((qcc, level, "--strip-source", "-o", executable, source),
                    prefix + "QORE_DUMP_LLVM_IR=1 ");
                bool selected = !prefix.startsWith("QORE_DISABLE_");
                assertEq(selected, regex(body(ir, "sameListLoop"),
                    "(?:call|invoke) void @qore_rt_assign_same_list_local_aot_(?:throwing_)?v1"),
                    "prepared publication " + prefix + level);
                foreach string excluded in (("sameListParameter", "sameListCaptured", "sameListNoNarrow")) {
                    assertFalse(regex(body(ir, excluded), "@qore_rt_assign_same_list_local_aot_"), excluded);
                }
                foreach string runtime in (("", "QORE_DISABLE_AOT_PREPARED_LOCAL_RELOAD=1 ")) {
                    assertEq(expected, run((executable,), runtime), prefix + level + runtime);
                }
            }
        }
    }
}
