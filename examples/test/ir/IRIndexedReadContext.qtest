%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil
%exec-class IRIndexedReadContextTest

class IRIndexedReadContextTest inherits QUnit::Test {
    private {
        string qore = realpath(ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0]);
        string libdir = realpath(ENV.QORE_LIBDIR ?? dirname(qore));
        string qcc = ENV.QCC ?? libdir + "/qcc";
    }
    constructor() : Test("indexed read live runtime context", "1.0", \ARGV) {
        addTestCase("loop reads use live context and preserve compatibility fallback", \check());
        set_return_value(main());
    }
    private static string quote(string value) {
        return "'" + replace(value, "'", "'\"'\"'") + "'";
    }
    private string run(list<string> args, string prefix = "") {
        int status;
        string output = backquote(prefix + "LD_LIBRARY_PATH=" + quote(libdir)
            + " DYLD_LIBRARY_PATH=" + quote(libdir)
            + " " + (map quote($1), args).join(" ") + " 2>&1", \status);
        assertEq(0, status, output);
        return output;
    }
    private check() {
        string original = File::readTextFile(get_script_dir() + "/IRIndexedReadContext.qr");
        TmpDir dir("qore-index-policy-");
        foreach string policy in (("%negative-offsets", "%no-negative-offsets")) {
            TmpFile source(dir.path);
            source.file.write(replace(original, "%modern\n", "%modern\n" + policy + "\n"));
            source.file.close();
            string expected = run((qore, "--exec-mode=ast", source.path));
            foreach string mode in (("ir", "jit", "tiered")) {
                assertEq(expected, run((qore, "--exec-mode=" + mode, "--enable-debug", source.path)),
                    policy + " " + mode);
            }
            foreach string level in (("-O0", "-O3")) {
                foreach string prefix in (("", "QORE_AOT_EH=1 ", "QORE_AOT_NO_DEBUG_INFO=1 ",
                        "MAKEFLAGS= QCC_JOBS=4 QCC_SPLIT_THRESHOLD=1 ",
                        "QORE_DISABLE_LLVM_INDEX_RUNTIME_CONFIG=1 ")) {
                    string executable = dir.path + "/fixture";
                    string ir = run((qcc, level, "--strip-source", "-o", executable, source.path),
                        prefix + "QORE_DUMP_LLVM_IR=1 ");
                    if (prefix =~ /QORE_DISABLE_LLVM_INDEX_RUNTIME_CONFIG/) {
                        assertRegex("call i64 @qore_rt_list_index_access_compat", ir,
                            policy + " compatibility helper " + level);
                        assertFalse(ir =~ /call i64 @qore_rt_list_index_access_context_v1/,
                            "disabled context helper " + level);
                    } else {
                        assertRegex("call i64 @qore_rt_list_index_access_context_v1", ir,
                            policy + " live-context helper " + prefix + level);
                    }
                    assertEq(expected, run((executable,)), policy + prefix + level);
                }
            }
        }
    }
}
