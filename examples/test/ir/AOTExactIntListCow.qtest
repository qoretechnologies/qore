# Copyright (c) 2026 Qore Technologies, s.r.o.
# SPDX-License-Identifier: MIT
%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil
%exec-class AOTExactIntListCowTest

class AOTExactIntListCowTest inherits QUnit::Test {
    private {
        string qore = realpath(ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0]);
        string libdir = realpath(ENV.QORE_LIBDIR ?? dirname(qore));
        string qcc = ENV.QCC ?? libdir + "/qcc";
    }
    constructor() : Test("AOT integer list COW and reflected-store semantics", "1.0", \ARGV) {
        addTestCase("typed append retains aliases and runtime publication", \check());
        addTestCase("owned result, COW and wide-box lifetime", \nativeOwnership());
        set_return_value(main());
    }
    private static string quote(string value) {
        return "'" + replace(value, "'", "'\"'\"'") + "'";
    }
    private string run(list<string> args, string prefix = "") {
        int status;
        string output = backquote(prefix + "LD_LIBRARY_PATH=" + quote(libdir)
            + " DYLD_LIBRARY_PATH=" + quote(libdir)
            + " QORE_JIT_SYNC_COMPILE=1 QORE_IR_THRESHOLD=1 QORE_JIT_THRESHOLD=1 "
            + (map quote($1), args).join(" ") + " 2>&1", \status);
        assertEq(0, status, output);
        return output;
    }
    private string loopBody(string ir) {
        *list<*string> body = regex_extract(ir,
            "(?s)define [^\n]*@exactCowLoop_[^\n]*\n(.*?)\n\\}");
        assertTrue(!!body, "runtime-backed exact integer loop definition");
        return body[0] ?? "";
    }
    private check() {
        TmpDir dir("qore-exact-int-cow-");
        foreach string fixture in (("AOTExactIntListCow", "IRNativeIntListPush", "AOTInPlaceIntListStore")) {
            string source = get_script_dir() + "/" + fixture + ".qr";
            string expected = run((qore, "--exec-mode=ast", source));
            if (fixture == "AOTExactIntListCow") {
                assertRegex("loop:0:0\nloop:1:249\n", expected, "empty and single-item independent reference");
                assertRegex("alias:9223372036854775807:", expected, "full positive integer range");
                assertRegex("alias:-9223372036854775808:", expected, "full negative integer range");
                assertRegex("parameter:1:\\[3\\]:\\[4, 1\\]", expected, "parameter aliases remain unchanged");
                assertRegex("reflect:1:\\[41, 1\\]:\\[18\\]", expected, "reflective replacement and snapshot survive");
                foreach string mode in (("ir", "jit", "tiered")) {
                    assertEq(expected, run((qore, "--exec-mode=" + mode, source)), mode);
                }
            }
            foreach string prefix in (("", "QORE_AOT_EH=1 ", "QORE_AOT_NO_DEBUG_INFO=1 ",
                    "MAKEFLAGS= QCC_JOBS=4 QCC_SPLIT_THRESHOLD=1 ",
                    "QORE_DISABLE_AOT_IN_PLACE_INT_LIST_STORE=1 ")) {
                foreach string level in (("-O0", "-O3")) {
                    string executable = dir.path + "/fixture";
                    string ir = run((qcc, level, "--strip-source", "-o", executable, source),
                        prefix + "QORE_DUMP_LLVM_IR=1 ");
                    if (fixture == "AOTExactIntListCow") {
                        string body = loopBody(ir);
                        assertTrue(regex(body, "(?:call|invoke) void @qore_rt_assign_local_no_coerce_eval_weak_aot"),
                            "runtime publication remains present " + prefix + level);
                        assertTrue(regex(body, "(?:call|invoke) i64 @qore_rt_coerce_value_aot"),
                            "ordinary paired-store coercion remains present");
                        assertTrue(regex(body, "(?:call|invoke) i64 @qore_rt_lv_path_(?:compound_aot|int_add_prepared_aot_(?:throwing_)?v1)"),
                            "indexed mutation retains a checked lvalue path");
                    }
                    assertEq(expected, run((executable,)), fixture + prefix + level);
                    if (fixture == "AOTExactIntListCow") {
                        assertEq(expected, run((executable, "check-aot-store-type")),
                            "AOT keeps the reflected list's runtime type, as the interpreter does");
                    }
                }
            }
        }
    }
    private nativeOwnership() {
        string root = realpath(get_script_dir() + "/../../..");
        TmpDir dir("qore-native-int-cow-ownership-");
        string executable = dir.path + "/native-test";
        list<string> args = (ENV.CXX ?? "c++", "-std=c++17", "-pthread", "-g",
            "-I" + root + "/include", "-I" + libdir + "/include",
            get_script_dir() + "/native_int_list_cow.cpp", "-L" + libdir,
            "-Wl,-rpath," + libdir, "-lqore", "-o", executable);
        *list<*string> target = (Qore::CFLAGS =~ x/(-mmacosx-version-min=\S+)/);
        if (target) { push args, target[0]; }
        foreach string level in (("-O0", "-O3")) {
            run(args + (level,));
            assertEq("native-int-list-cow: ok\n", run((executable,)), level);
        }
    }
}
