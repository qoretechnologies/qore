#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil

%exec-class AOTContextExpressionSlotsTest

# Standalone-compiled classes using native `context` IR must preserve the
# context data, where, and sort expressions in their .qo slot metadata.  The
# linker may rebuild metadata-only views of the classes, so the slot-map walk
# must not rely on LLVM lowering to discover these expressions.
class AOTContextExpressionSlotsTest inherits QUnit::Test {
    private {
        string qcc_bin;
        string libqore_dir;
    }

    constructor() : QUnit::Test("AOTContextExpressionSlotsTest", "1.0", \ARGV) {
        string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
            ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");

        addTestCase("standalone context class .qo preserves expression slots",
            \testStandaloneContextClassQoLink());

        set_return_value(main());
    }

    private string run(string cmd) {
        return backquote(cmd + " 2>&1");
    }

    private write(string path, string body) {
        File f();
        f.open2(path, O_WRONLY | O_CREAT | O_TRUNC);
        f.write(body);
    }

    testStandaloneContextClassQoLink() {
        TmpDir tmp("qore-aot-context-slots-");
        string tmp_dir = tmp.path;
        string lib_dir = tmp_dir + "/aotlib";
        mkdir(lib_dir);

        string provider_src = tmp_dir + "/provider.qc";
        string consumer_src = tmp_dir + "/consumer.qc";
        string main_src = tmp_dir + "/main.qr";
        string provider_qo = lib_dir + "/provider.qo";
        string consumer_qo = lib_dir + "/consumer.qo";
        string main_qo = lib_dir + "/main.qo";
        string app = tmp_dir + "/context-slots";

        write(provider_src, "%new-style
public class AOTContextSlotProvider {
    public static hash<auto> rows() {
        return (\"id\": (3, 1, 2), \"name\": (\"c\", \"a\", \"b\"));
    }
}
");
        write(consumer_src, "%new-style
public class AOTContextSlotConsumer {
    public static string run() {
        list<string> out = ();
        context (AOTContextSlotProvider::rows()) where (%id > 1) sortBy (%id) {
            out += sprintf(\"%d:%s\", %id, %name);
        }
        return out.join(\",\");
    }
}
");
        write(main_src, "%new-style
int sub main() {
    printf(\"%s\\n\", AOTContextSlotConsumer::run());
    return 0;
}

main();
");

        string env = sprintf("LD_LIBRARY_PATH=%s QORE_LIBDIR=%s", libqore_dir, libqore_dir);
        string provider_out = run(sprintf("%s %s -c -L %s --parse-option=PO_MODERN -o %s %s",
            env, qcc_bin, lib_dir, provider_qo, provider_src));
        assertTrue(is_file(provider_qo), "compiled provider .qo: " + provider_out);

        string consumer_out = run(sprintf("%s %s -c -L %s --parse-option=PO_MODERN -o %s %s",
            env, qcc_bin, lib_dir, consumer_qo, consumer_src));
        assertTrue(is_file(consumer_qo), "compiled consumer .qo: " + consumer_out);

        string main_out = run(sprintf("%s %s -c -L %s --parse-option=PO_MODERN -o %s %s",
            env, qcc_bin, lib_dir, main_qo, main_src));
        assertTrue(is_file(main_qo), "compiled main .qo: " + main_out);

        string link_out = run(sprintf("%s %s -o %s %s %s %s",
            env, qcc_bin, app, provider_qo, consumer_qo, main_qo));
        assertTrue(is_file(app), "linked context executable: " + link_out);

        string out = run(sprintf("%s %s", env, app));
        assertEq("2:b,3:c\n", out, "linked executable preserves context result: " + out);
    }
}
