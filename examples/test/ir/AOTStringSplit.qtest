%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil
%exec-class AOTStringSplitTest

class AOTStringSplitTest inherits QUnit::Test {
    private {
        string qore = realpath(ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0]);
        string libdir = realpath(ENV.QORE_LIBDIR ?? dirname(qore));
        string qcc = ENV.QCC ?? libdir + "/qcc";
    }
    constructor() : Test("AOT canonical string split", "1.0", \ARGV) {
        addTestCase("values, fallback, encodings, exception frames and context", \check());
        set_return_value(main());
    }
    private static string quote(string value) {
        return "'" + replace(value, "'", "'\"'\"'") + "'";
    }
    private string run(list<string> args, string prefix = "") {
        int status;
        string output = backquote(prefix + "LD_LIBRARY_PATH=" + quote(libdir)
            + " DYLD_LIBRARY_PATH=" + quote(libdir)
            + " QORE_JIT_SYNC_COMPILE=1 QORE_IR_THRESHOLD=1 QORE_JIT_THRESHOLD=1 "
            + (map quote($1), args).join(" ") + " 2>&1", \status);
        assertEq(0, status, output);
        return output;
    }
    private check() {
        string source = get_script_dir() + "/AOTStringSplit.qr";
        string expected = run((qore, "--exec-mode=ast", source));
        assertRegex("<string>::split", expected, "conversion error retains the builtin frame");
        foreach string mode in (("ir", "jit", "tiered")) {
            assertEq(expected, run((qore, "--exec-mode=" + mode, source)), mode);
        }
        TmpDir dir("qore-aot-string-split-");
        foreach string prefix in (("", "QORE_AOT_EH=1 ", "QORE_AOT_NO_DEBUG_INFO=1 ",
                "QORE_DISABLE_AOT_STRING_SPLIT=1 ", "MAKEFLAGS= QCC_JOBS=4 QCC_SPLIT_THRESHOLD=1 ")) {
            foreach string level in (("-O0", "-O3")) {
                string executable = dir.path + "/fixture";
                string ir = run((qcc, level, "--strip-source", "-o", executable, source),
                    prefix + "QORE_DUMP_LLVM_IR=1 ");
                string selected = "(?:call|invoke) i64 @qore_rt_pseudo_string_split_aot_v1";
                assertEq(!prefix.startsWith("QORE_DISABLE_AOT_STRING_SPLIT"), regex(ir, selected),
                    "only enabled AOT lowering selects the canonical split helper");
                foreach string runtime in (("", "QORE_DISABLE_AOT_STRING_SPLIT=1 ")) {
                    assertEq(expected, run((executable,), runtime), prefix + level + runtime);
                }
            }
        }
    }
}
