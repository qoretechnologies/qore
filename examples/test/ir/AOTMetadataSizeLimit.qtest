#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-exec-mode: children - the check runs qcc in a child process
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../ExecModeHarness.qm
%exec-class AOTMetadataSizeLimitTest

/*  The AOT loader refuses compressed metadata of more than 100 MB once decompressed; qcc must refuse to write such
    metadata instead of writing an executable that fails to load (qore#6127)
*/
class AOTMetadataSizeLimitTest inherits QUnit::Test {
    private {
        string qore_bin = ENV.QORE_BINARY ?? QORE_ARGV[0];
        string libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        string qcc_bin = ENV.QORE_QCC_EXECUTABLE ?? (libqore_dir + "/qcc");

        # the metadata limit of the AOT format
        const MaxMetadataSize = 100 * 1024 * 1024;
    }

    constructor() : Test("AOTMetadataSizeLimit", "1.0", \ARGV) {
        addTestCase("qcc refuses metadata over the limit", \testTooBig());
        set_return_value(main());
    }

    private static string shellQuote(string value) {
        return "'" + replace(value, "'", "'\\''") + "'";
    }

    testTooBig() {
        TmpDir tmp("aot-metadata-size-");
        string path = tmp.path + "/big.q";
        # 105 functions returning distinct string literals of 1 MB: more metadata than the limit allows
        {
            string chunk = strmul("abcdefghij", 1024 * 1024 / 10);
            File f();
            f.open2(path, O_WRONLY | O_CREAT | O_TRUNC);
            f.write("%modern\n");
            for (int i = 0; i < 105; ++i) {
                f.printf("string sub f%d() { return \"%04d%s\"; }\n", i, i, chunk);
            }
            f.write("printf(\"%d\\n\", f0().size());\n");
            f.close();
        }
        string executable = tmp.path + "/big";
        string env = "LD_LIBRARY_PATH=" + shellQuote(libqore_dir) + " DYLD_LIBRARY_PATH=" + shellQuote(libqore_dir)
            + " QORE_LIBDIR=" + shellQuote(libqore_dir) + " ";
        hash<ExecModeHarness::ModeRunResult> compiled = ExecModeHarness::run_command(env + shellQuote(qcc_bin)
            + " -O0 -o " + shellQuote(executable) + " " + shellQuote(path));
        assertNeq(0, compiled.rc, compiled.out);
        assertRegex("the AOT metadata is [0-9]+ bytes, but the AOT format supports at most " + MaxMetadataSize
            + " bytes of compressed metadata", compiled.out);
        assertFalse(is_file(executable));
    }
}
