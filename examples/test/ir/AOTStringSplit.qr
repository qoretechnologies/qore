%modern

sub emit(string name, auto value) {
    printf("%s:%y\n", name, value);
}
list<string> sub selected(string value, string separator) {
    return value.split(separator);
}
list<string> sub selectedInvoke(string value, string separator) {
    try {
        return value.split(separator);
    } catch (hash<ExceptionInfo> ex) {
        emit("error", (ex.err, ex.callstack[0].function));
        return ("caught",);
    }
}
list<string> sub named(string value, string separator) {
    return value.split(separator: separator);
}
auto sub guardedTrim(string value, string separator) {
    return trim(tolower(value)).split(separator);
}
auto sub guardedTrimInvoke(string value, string separator) {
    try {
        return trim(tolower(value)).split(separator);
    } catch (hash<ExceptionInfo> ex) {
        emit("guarded-error", (ex.err, ex.callstack[0].function));
        return ("caught",);
    }
}
auto sub guardedTrimInvokeLiteral(string value) {
    try {
        return trim(tolower(value)).split(",");
    } catch (hash<ExceptionInfo> ex) {
        emit("guarded-literal-error", ex.err);
        return ("caught",);
    }
}
auto sub guardedTrimInvokeEncoding(string value) {
    try {
        return trim(tolower(value)).split("日");
    } catch (hash<ExceptionInfo> ex) {
        emit("guarded-encoding-error", (ex.err, ex.callstack[0].function));
        return ("caught",);
    }
}
auto sub guardedOptional(*string value, string separator) {
    # This separator has no assignment proof; consuming dispatch must remain.
    return value.split(separator + "");
}
auto sub guardedOptionalLiteral(*string value) {
    return value.split("abcdefgh");
}
auto sub guardedMissing(bool assigned) {
    string value;
    if (assigned) { value = "leftabcdefghrightabcdefgh"; }
    return value.split("abcdefgh");
}
auto sub dynamicSplit(auto value, auto separator) {
    return value.split(separator);
}
sub clear(reference<string> value) { remove value; }
string sub clearAndReturn(reference<string> value) {
    remove value;
    return ",";
}
class SplitOverride {
    public list<string> split(string separator) { return ("override", separator); }
}
class SplitContext {
    private { string value = "context"; }
    private string read() { return value; }
    public string check() {
        string text = "a,b";
        string separator = ",";
        emit("method", text.split(separator));
        emit("method-error", selectedInvoke(convert_encoding(text, "ASCII"), "日"));
        return read();
    }
}

foreach string value in (("", ",", "a,b", "a,,b,", "longer,heap,string,", "日,本語,é")) {
    emit("direct", selected(value, ","));
    emit("invoke", selectedInvoke(value, ","));
    emit("named", named(value, ","));
    emit("empty-separator", selected(value, ""));
    emit("guarded-trim", guardedTrim(" " + value + " ", ","));
    emit("guarded-trim-invoke", guardedTrimInvoke(" " + value + " ", ","));
    emit("guarded-trim-invoke-literal", guardedTrimInvokeLiteral(" " + value + " "));
}
emit("guarded-conversion-error", guardedTrimInvoke(convert_encoding(" A,B ", "ASCII"), "日"));
emit("guarded-literal-conversion-error", guardedTrimInvokeEncoding(convert_encoding(" A,B ", "ASCII")));
emit("guarded-literal-unicode", guardedTrimInvokeEncoding(" 日,本語 "));
emit("guarded-after-error", guardedTrim(" A,B ", ","));
foreach bool assigned in ((True, False)) {
    *string value = assigned ? "leftabcdefghrightabcdefgh" : NOTHING;
    try { emit("guarded-optional", guardedOptional(value, "abcdefgh")); }
    catch (hash<ExceptionInfo> ex) { emit("guarded-optional-error", ex.err); }
    try { emit("guarded-optional-literal", guardedOptionalLiteral(value)); }
    catch (hash<ExceptionInfo> ex) { emit("guarded-optional-literal-error", ex.err); }
    try { emit("guarded-missing", guardedMissing(assigned)); }
    catch (hash<ExceptionInfo> ex) { emit("guarded-missing-error", ex.err); }
}
emit("embedded-null", selected("a\0b,c", ","));
foreach string encoding in (("UTF-8", "UTF-16LE", "UTF-16BE", "ISO-2022-JP")) {
    string value = convert_encoding("a\0b", encoding);
    foreach bool keep in ((False, True)) {
        foreach bool separator in ((False, True)) {
            list<string> result = value.split("", separator, keep);
            if (result.size() != 1 || result[0] !== value) {
                throw "EMPTY-SPLIT", "empty separators must preserve embedded NUL characters";
            }
        }
    }
    if (selected(value, "") !== (value,)) {
        throw "EMPTY-SPLIT", "native split must preserve embedded NUL characters";
    }
}
if (<610062>.split(binary()) !== (<610062>,)) {
    throw "EMPTY-SPLIT", "binary split must preserve embedded NUL bytes";
}
emit("long-separator", selected("leftabcdefghrightabcdefgh", "abcdefgh"));
foreach string encoding in (("UTF-8", "UTF-16LE", "UTF-16BE", "ISO-2022-JP")) {
    string value = convert_encoding("日,本語,", encoding);
    foreach string separator in ((",", convert_encoding(",", encoding))) {
        list<string> result = selected(value, separator);
        emit(encoding, map convert_encoding($1, "UTF-8"), result);
        emit("result-encoding", map $1.encoding(), result);
    }
}
emit("encoding-error", selectedInvoke(convert_encoding("a,b", "ASCII"), "日"));
emit("stateful-error", selectedInvoke(binary_to_string(<1b2442467c4b>, "ISO-2022-JP"), ","));
emit("after-error", selected("a,b", ","));

string flags = "a,,b,";
emit("with-separator", flags.split(",", True));
emit("keep-trailing", flags.split(",", False, True));
emit("quote", "a,\"b,c\",".split(",", "\""));
*string optional = "a,b";
emit("optional", optional.split(","));
optional = NOTHING;
try { emit("optional-nothing", optional.split(",")); }
catch (hash<ExceptionInfo> ex) { emit("optional-nothing-error", ex.err); }
string missing;
try { emit("missing", missing.split(",")); }
catch (hash<ExceptionInfo> ex) { emit("missing-error", ex.err); }
string removed = "a,b";
clear(\removed);
try { emit("removed", removed.split(",")); }
catch (hash<ExceptionInfo> ex) { emit("removed-error", ex.err); }
string missing_separator;
try { emit("missing-separator", flags.split(missing_separator)); }
catch (hash<ExceptionInfo> ex) { emit("missing-separator-error", ex.err); }
string reentry = "a,b";
try { emit("reentry", reentry.split(clearAndReturn(\reentry))); }
catch (hash<ExceptionInfo> ex) { emit("reentry-error", ex.err); }
emit("reentry-after", reentry);
emit("temporary", ("abc" + ",def").split(sprintf("%s", ",")));
emit("dynamic", dynamicSplit("a,b", ","));
SplitOverride override();
emit("override", dynamicSplit(override, ","));
hash<auto> callable = {"split": list<string> sub(string separator) { return ("hash", separator); }};
emit("hash-callref", dynamicSplit(callable, ","));
SplitContext checker();
emit("context-after", checker.check());
