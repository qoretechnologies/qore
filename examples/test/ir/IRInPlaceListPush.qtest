#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
string libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
string qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
    ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : dirname(qore_bin) + "/qcc");
if (!is_file(qcc_bin)) {
    qcc_bin = "qcc";
}

string code = "%modern

int sub assignedPush() {
    list<int> values = ();
    for (int i = 0; i < 20; ++i) {
        push values, i;
    }
    return values.size() * 100 + values[19];
}

int sub singlePush() {
    list<int> values = ();
    push values, 6;
    return values[0];
}

int sub unassignedPush() {
    list<int> values;
    push values, 7;
    return values[0];
}

int sub removedPush() {
    list<int> values = (1, 2);
    remove values;
    push values, 8;
    return values[0];
}

int sub deletedPush() {
    list<int> values = (1, 2);
    delete values;
    push values, 9;
    return values[0];
}

int sub softPush() {
    list<softint> values = ();
    push values, \"3\";
    return values[0];
}

list<int> sub expressionPush() {
    list<int> values = (1,);
    return push values, 2;
}

nothing sub aliasedPush() {
    list<int> values = ();
    list<int> alias = values;
    push values, 10;
}

list<int> sub buildAndReturn() {
    list<int> values = ();
    for (int i = 0; i < 4; ++i) {
        push values, i;
    }
    return values;
}

nothing sub referencePush(reference<list<int>> values) {
    push values, 11;
}

list<int> reference_values = (10,);
referencePush(\\reference_values);
aliasedPush();
list<int> expression_values = expressionPush();
list<int> built_values = buildAndReturn();
printf(\"%d:%d:%d:%d:%d:%d:%d:%d:%d:%d:%d\\n\", assignedPush(), singlePush(), unassignedPush(),
    removedPush(), deletedPush(), softPush(), expression_values.size(), expression_values[1],
    reference_values[1], built_values.size(), built_values[3]);
";

string script_path = "/tmp/qore-ir-in-place-list-push-" + string(getpid()) + ".qr";
File script();
script.open2(script_path, O_WRONLY | O_CREAT | O_TRUNC);
script.write(code);
script.close();

string sub runMode(string mode) {
    return backquote(sprintf("LD_LIBRARY_PATH=%s %s -b --exec-mode=%s %s 2>&1",
        libqore_dir, qore_bin, mode, script_path));
}

string sub runAot() {
    string exe = "/tmp/qore-ir-in-place-list-push-" + string(getpid());
    string compile_out = backquote(sprintf("LD_LIBRARY_PATH=%s %s -O3 -o %s %s 2>&1",
        libqore_dir, qcc_bin, exe, script_path));
    if (!is_file(exe)) {
        printf("AOT compile failed:\n%s", compile_out);
        exit(2);
    }
    return backquote(sprintf("LD_LIBRARY_PATH=%s %s 2>&1", libqore_dir, exe));
}

string expected = "2019:6:7:8:9:3:2:2:11:4:3\n";
foreach string mode in (("ast", "ir", "tiered", "jit")) {
    string actual = runMode(mode);
    if (actual != expected) {
        printf("mismatch in %s\nexpected:\n%sactual:\n%s", mode, expected, actual);
        exit(2);
    }
}
string aot = runAot();
if (aot != expected) {
    printf("mismatch in aot\nexpected:\n%sactual:\n%s", expected, aot);
    exit(2);
}

string stats = backquote(sprintf("QORE_IR_OPT_STATS=1 LD_LIBRARY_PATH=%s %s -b --exec-mode=ir %s 2>&1",
    libqore_dir, qore_bin, script_path));
if (stats !~ /IR-OPT: assignedPush:.*inplace-push=1/) {
    printf("missing assigned in-place push optimization:\n%s", stats);
    exit(2);
}
if (stats !~ /IR-OPT: singlePush:.*inplace-push=1/) {
    printf("missing single in-place push optimization:\n%s", stats);
    exit(2);
}
if (stats !~ /IR-OPT: buildAndReturn:.*inplace-push=1/) {
    printf("missing build-and-return in-place push optimization:\n%s", stats);
    exit(2);
}
if (stats !~ /IR-OPT: softPush:.*inplace-push=1/) {
    printf("missing soft-list in-place push optimization:\n%s", stats);
    exit(2);
}
if (stats !~ /IR-OPT: unassignedPush:.*inplace-push=0/
        || stats !~ /IR-OPT: removedPush:.*inplace-push=0/
        || stats !~ /IR-OPT: deletedPush:.*inplace-push=0/
        || stats !~ /IR-OPT: expressionPush:.*inplace-push=0/
        || stats !~ /IR-OPT: aliasedPush:.*inplace-push=0/
        || stats !~ /IR-OPT: referencePush:.*inplace-push=0/) {
    printf("unsafe in-place push selection:\n%s", stats);
    exit(2);
}
