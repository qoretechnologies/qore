%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil
%exec-class AOTPreparedImmediateReloadTest

class AOTPreparedImmediateReloadTest inherits QUnit::Test {
    private {
        string qore = realpath(ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0]);
        string libdir = realpath(ENV.QORE_LIBDIR ?? dirname(qore));
        string qcc = ENV.QCC ?? libdir + "/qcc";
    }
    constructor() : Test("AOT prepared immediate local reload", "1.0", \ARGV) {
        addTestCase("live storage, reflection, references and disabled preparation", \check());
        set_return_value(main());
    }
    private static string quote(string value) {
        return "'" + replace(value, "'", "'\"'\"'") + "'";
    }
    private string run(list<string> args, string prefix = "") {
        int status;
        string output = backquote(prefix + "LD_LIBRARY_PATH=" + quote(libdir)
            + " DYLD_LIBRARY_PATH=" + quote(libdir)
            + " " + (map quote($1), args).join(" ") + " 2>&1", \status);
        assertEq(0, status, output);
        return output;
    }
    private string body(string ir, string name) {
        *list<*string> found = regex_extract(ir,
            "(?s)define [^\n]*@" + name + "_[^\n]*\\(ptr %ctx, ptr %xsink\\)[^\n]*\n(.*?)\n\\}");
        assertTrue(!!found, name + " ordinary LLVM entry");
        return found[0] ?? "";
    }
    private check() {
        TmpDir dir("qore-immediate-reload-");
        foreach string fixture in (("AOTPreparedIndexedIntAdd", "AOTPreparedIndexedIntAddNegative")) {
            string source = get_script_dir() + "/" + fixture + ".qr";
            string expected = run((qore, "--exec-mode=ast", source));
            foreach string prefix in (("", "QORE_AOT_EH=1 ", "QORE_AOT_NO_DEBUG_INFO=1 ",
                    "MAKEFLAGS= QCC_JOBS=4 QCC_SPLIT_THRESHOLD=1 ",
                    "QORE_DISABLE_AOT_PREPARED_IMMEDIATE_RELOAD=1 ",
                    "QORE_DISABLE_AOT_PREPARED_LOCAL_RELOAD=1 ")) {
                foreach string level in (("-O0", "-O3")) {
                    string executable = dir.path + "/fixture";
                    string ir = run((qcc, level, "--strip-source", "-o", executable, source),
                        prefix + "QORE_DUMP_LLVM_IR=1 ");
                    if (fixture == "AOTPreparedIndexedIntAdd") {
                        bool selected = !prefix.startsWith("QORE_DISABLE_");
                        assertEq(selected, regex(body(ir, "indexedAddLoop"),
                            "call i64 @qore_rt_load_prepared_local_aot_v1"),
                            "prepared immediate body-local reload " + prefix + level);
                        assertFalse(regex(body(ir, "indexedAddParameter"),
                            "@qore_rt_load_prepared_local_aot_v1"),
                            "parameter retains ordinary lookup " + prefix + level);
                    }
                    foreach string runtime in (("", "QORE_DISABLE_AOT_PREPARED_LOCAL_RELOAD=1 ")) {
                        assertEq(expected, run((executable,), runtime), fixture + prefix + level + runtime);
                    }
                }
            }
        }
    }
}
