#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - the release of JIT- and AOT-compiled code of a deleted Program that creates closures
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - every check runs the script in a child process that sets its own --exec-mode, or AOT

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../ExecModeHarness.qm

%exec-class ProgramClosureReleaseTest

#! issue #5822: a Program whose top-level code creates closures is destroyed after it is deleted
/** The code compiled from a Program's top-level statements (IR, native code) refers to the closures that it creates,
    whose variants keep the Program allocated while they live; that code is freed with the Program's code when the
    Program is deleted, so that the Program is destroyed.  Before, it was freed only when the Program was destroyed,
    so in the compiled execution modes neither was ever freed.

    ProgramClosureRelease.qr counts the Programs left after 10 generations of Programs that are created, run and
    deleted; there must be none in every execution mode, with synchronous and with background compiles, and on the IR
    tier.  The script also runs as an AOT executable compiled with -O0 and -O3, whose Programs are parsed at run time
    (their top-level code runs in the IR tier: tiered execution, the default), not compiled ahead of time.  The script
    needs library debugging (dbg_get_live_program_count()).
*/
class ProgramClosureReleaseTest inherits QUnit::Test {
    public {
        #! the output of the script
        const Expected = "Programs left after 10 generations: 0\n";
    }

    private {
        string qore_bin;
        string qcc_bin;
        string env;
        string script;
    }

    constructor() : QUnit::Test("Programs with closures are released", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        string libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
            ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");
        env = sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s QORE_LIBDIR=%s", libqore_dir, libqore_dir, libqore_dir);
        script = get_script_dir() + "/ProgramClosureRelease.qr";

        addTestCase("AST interpreter", \astTest());
        addTestCase("execution modes", \modesTest());
        addTestCase("background compiles", \backgroundTest());
        addTestCase("AOT executable -O0", \aotTest(), "-O0");
        addTestCase("AOT executable -O3", \aotTest(), "-O3");
        set_return_value(main());
    }

    #! skips the test case without library debugging, which the script needs
    private checkDebugging() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("dbg_get_live_program_count() requires library debugging");
        }
    }

    #! checks the output of the AST interpreter, which the other modes must give
    private astTest() {
        checkDebugging();
        assertEq(Expected, ast());
    }

    #! runs the script in every execution mode, with synchronous compiles, and on the IR tier
    private modesTest() {
        checkDebugging();
        string exp = ast();
        foreach string mode in (ExecModeHarness::ExecModes) {
            if (mode == "ast") {
                continue;
            }
            assertEq(exp, ExecModeHarness::run(sprintf("%s %s --exec-mode=%s %s", env, qore_bin, mode, script)), mode);
        }
        assertEq(exp, ExecModeHarness::run_ir_tier(sprintf("%s %s --exec-mode=tiered %s", env, qore_bin, script)),
            ExecModeHarness::IRTierName);
    }

    #! runs the script with background compiles: with tiered execution, the code of the calling Program is compiled
    #! while the defining Program is deleted
    private backgroundTest() {
        checkDebugging();
        string exp = ast();
        foreach string mode in (("ir", "jit", "tiered")) {
            string cmd = sprintf("env -u QORE_JIT_SYNC_COMPILE %s QORE_IR_THRESHOLD=1 QORE_JIT_THRESHOLD=1 %s "
                "--exec-mode=%s %s 2>&1", env, qore_bin, mode, script);
            assertEq(exp, backquote(cmd), mode + " with background compiles");
        }
    }

    #! compiles the script with qcc and checks that the executable gives the output of the AST interpreter
    private aotTest(string opt) {
        checkDebugging();
        if (!is_file(qcc_bin)) {
            testSkip("qcc is not available at " + qcc_bin);
        }
        TmpDir dir("program-closure-release-aot-");
        string exe = dir.path + "/program-closure-release";
        string out = ExecModeHarness::run_any(sprintf("%s %s %s -o %s %s", env, qcc_bin, opt, exe, script));
        assertTrue(is_file(exe), "qcc " + opt + " compiles the script: " + out);
        assertEq(ast(), ExecModeHarness::run_any(sprintf("%s %s", env, exe)), "AOT " + opt);
    }

    #! returns the output of the script with the AST interpreter
    private string ast() {
        return ExecModeHarness::run(sprintf("%s %s --exec-mode=ast %s", env, qore_bin, script));
    }
}
