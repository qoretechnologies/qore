#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires Util
%requires FsUtil

%exec-class AOTNestedConstantRefTest

class AOTNestedConstantRefTest inherits QUnit::Test {
    private {
        string qore_bin;
        string libqore_dir;
        string repo_dir;
        string qjar_path;
    }

    constructor() : QUnit::Test("AOTNestedConstantRefTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        repo_dir = normalize_dir(get_script_dir() + "/../../..");
        qjar_path = repo_dir + "/doxygen/qjar";

        addTestCase("qjar resolves nested constants and non-reexported binary dependency types",
            \testAotJniNestedConstantRefs());

        set_return_value(main());
    }

    private string moduleCode() {
        return "%modern

%requires i18n

module AOTNestedConstantRefMod {
    version = \"1.0\";
    desc = \"AOT nested runtime constant reference regression module\";
    author = \"Qore\";
    license = \"MIT\";
}

public namespace AOTNestedConstantRefMod {
    public class AOTNestedConstantRefClass {
        public {
            const HeaderName = \"Authorization\";
            const AuthArgs = {\"header\": HeaderName};
            const AuthOptions = {
                \"args\": AuthArgs,
                \"nested\": {\"args\": AuthArgs},
                \"list\": (AuthArgs, {\"header\": HeaderName}),
            };
        }

        public I18n::CatalogDiscoveryIndex makeCatalogIndex() {
            return new I18n::CatalogDiscoveryIndex();
        }
    }
}
";
    }

    #! returns why the jni module cannot be loaded, or nothing if it can
    /** Only the standard output of the child is compared: the JVM writes a banner such as
        "Picked up JAVA_TOOL_OPTIONS: ..." to the standard error when JAVA_TOOL_OPTIONS is set, as the CI images set it.
    */
    private *string jniUnavailable() {
        TmpDir tmp("qore-aot-jni-probe-");
        string err_path = tmp.path + "/stderr";
        string out = backquote(sprintf("LD_LIBRARY_PATH=%s:$LD_LIBRARY_PATH %s -b -l jni -ne 'printf(\"ok\");' 2>%s",
            libqore_dir, qore_bin, err_path));
        if (out == "ok") {
            return;
        }
        return sprintf("output %y, error output %y", out, ReadOnlyFile::readTextFile(err_path) ?? "");
    }

    testAotJniNestedConstantRefs() {
        if (*string why = jniUnavailable()) {
            testSkip("jni module not available: " + why);
        }

        TmpDir tmp("qore-aot-nested-const-ref-");
        string tmp_dir = tmp.path;
        string src_dir = tmp_dir + "/src";
        string qmod_dir = tmp_dir + "/qmod";
        string java_dir = tmp_dir + "/java";
        mkdir(src_dir);
        mkdir(qmod_dir);

        string qm_path = src_dir + "/AOTNestedConstantRefMod.qm";
        File qm();
        qm.open2(qm_path, O_WRONLY | O_CREAT | O_TRUNC);
        qm.write(moduleCode());
        qm.close();

        string qmod_path = qmod_dir + "/AOTNestedConstantRefMod.qmod";
        string compile_out = backquote(sprintf("QORE_LIBDIR=%s %s -b --compile-module --strip-source --output %s %s 2>&1",
            libqore_dir, qore_bin, qmod_path, qm_path));
        assertTrue(is_file(qmod_path), "compiled nested constant reference module: " + compile_out);

        string qjar_out = backquote(sprintf("LD_LIBRARY_PATH=%s:$LD_LIBRARY_PATH QORE_MODULE_DIR=%s:$QORE_MODULE_DIR %s -b %s -i=%s -m=AOTNestedConstantRefMod -v 2>&1",
            libqore_dir, qmod_dir, qore_bin, qjar_path, java_dir));
        assertFalse(qjar_out =~ /NT_RTCONSTREF|JNI-ERROR|don't know how to convert/,
            "qjar must resolve nested constants and binary dependency types: " + qjar_out);
        assertTrue(is_file(java_dir + "/qoremod/AOTNestedConstantRefMod/AOTNestedConstantRefClass.class"),
            "qjar generated Java class from AOT qmod: " + qjar_out);
    }
}
