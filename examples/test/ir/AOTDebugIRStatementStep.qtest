#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-exec-mode: children - its checks run in child processes that set their own execution modes or are qcc executables
# test-platform: macos - qcc links and runs a native executable with serialized debugger metadata
# Copyright (C) 2026 Qore Technologies, s.r.o.  SPDX-License-Identifier: MIT

# Regression test: a debugger attached to an AOT program gets the step event of every statement of an AOT
# function, with the statement's own source location, as with the AST interpreter (#5558).
#
# Once a debugger is attached, an AOT function runs its serialized source-stripped debug IR in the IR interpreter
# (UserVariantBase::materializeAOTDebugIR()).  Since 346c9c7efd the IR interpreter fires step events only at
# QoreIROpcode::DebugStatement instructions, but AOT lowering emitted none, so AOT code produced only the
# function-entry event of its synthetic entry block, whose location is the binary's label (for a qcc script
# aggregate, the aggregate's symbol).  A line-coverage recorder attached to such a program (Qorus test runtime
# coverage) saw no statement of the AOT sources.

%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires ../TestInterpreter.qm
%requires ../ExecModeHarness.qm

%exec-class AOTDebugIRStatementStepTest

class AOTDebugIRStatementStepTest inherits QUnit::Test {
    private {
        string qore_bin = TestInterpreter::qore_interpreter();
        string libqore_dir;
        string tmp_dir;

        # probe() is called through call_function() so that the call is dispatched through the tiered entry of
        # the variant, as calls between separately compiled AOT objects are; lines 30-36 are its statements
        # Line 31 starts at column zero and has two distinct statement spans (#7490).
        const ProbeSource = "%modern
%allow-debugger

class StepRecorder inherits DebugProgram {
    public { list<string> seen = (); }
    onAttach(ProgramControl pgm, reference rs, reference rts) { rs = DebugStep; }
    onDetach(ProgramControl pgm, reference rs, reference rts) {}
    onStep(ProgramControl pgm, int blockStatementId, *int statementId, *int breakpointId, reference flow,
            reference rs, reference rts) {
        if (statementId) {
            hash<auto> i = pgm.getStatementIdInfo(statementId);
            seen += sprintf(\"step %s:%d:%d-%d\", basename(i.file), i.start_line + i.offset, i.start_column, i.end_column);
        }
        rs = DebugStep;
    }
    onFunctionEnter(ProgramControl pgm, int statementId, reference rs, reference rts) { rs = DebugStep; }
    onFunctionExit(ProgramControl pgm, int statementId, reference result, reference rs, reference rts) {
        rs = DebugStep;
    }
    onException(ProgramControl pgm, int statementId, hash<auto> ex, reference dismiss, reference rs,
            reference rts) {
        rs = DebugStep;
    }
    onExit(ProgramControl pgm, int statementId, reference result, reference rs, reference rts) {
        rs = DebugStep;
    }
}

int sub probe(int a) {
    list<int> l = (a, 2);
int sum = 0; sum += 0;
    foreach int v in (l) {
        sum += v;
    }
    string s = sprintf(\"%d\", sum);
    return s.toInt();
}

StepRecorder r();
ProgramControl pc = ProgramControl::getProgram();
foreach int id in (pc.findStatementIds(\"probe.q\", 31)) {
    hash<auto> i = pc.getStatementIdInfo(id);
    printf(\"lookup %d:%d-%d\\n\", i.start_line, i.start_column, i.end_column);
}
int rv;
Counter cnt(1);
background sub () {
    on_exit cnt.dec();
    r.addProgram(pc);
    on_exit r.removeProgram(pc);
    rv = call_function(\"probe\", 1);
}();
cnt.waitForZero();
printf(\"rv=%d\\n\", rv);
# only the statements of probe(): AOT top-level code is native code without step events
foreach string e in (r.seen) {
    int line = (e =~ x/:([0-9]+):/)[0].toInt();
    if (line >= 29 && line <= 37) {
        printf(\"%s\\n\", e);
    }
}
";
    }

    constructor() : QUnit::Test("AOTDebugIRStatementStep", "1.0") {
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        tmp_dir = sprintf("%s/qore-aot-debug-ir-step-%d", (ENV.TMPDIR ?? "/tmp"), getpid());
        mkdir(tmp_dir);
        addTestCase("AOT function steps every statement under a debugger", \testAotStatementSteps());
        set_return_value(main());
    }

    destructor() {
        system(sprintf("rm -rf %s", tmp_dir));
    }

    testAotStatementSteps() {
        string src = tmp_dir + "/probe.q";
        string exe = tmp_dir + "/probe.aot";
        {
            File f();
            f.open2(src, O_WRONLY | O_CREAT | O_TRUNC);
            f.write(ProbeSource);
        }

        # the AST interpreter is the benchmark
        string ast_out = ExecModeHarness::run_command(sprintf("%s -b --exec-mode=ast %s", qore_bin, src),
            NOTHING, "QORE_JIT_TIMING=1").out;
        assertEq("lookup 31:0-11\nlookup 31:13-21\nrv=3\nstep probe.q:30:4-24\nstep probe.q:31:0-11\n"
            "step probe.q:31:13-21\nstep probe.q:32:4-5\nstep probe.q:33:8-16\nstep probe.q:33:8-16\n"
            "step probe.q:35:4-33\nstep probe.q:36:4-20\n", ast_out, "AST source spans of probe()");

        list<string> commands = (qore_bin + " -b --compile --compile-debugging",
            qore_bin + " -b --compile --compile-debugging --strip-source");
        if (*string qcc = TestInterpreter::qcc_compiler()) {
            push commands, qcc + " -O0 -g";
            push commands, qcc + " -O3 -g --strip-source";
        }
        foreach string compile in (commands) {
            string compile_out = backquote(sprintf("QORE_LIBDIR=%s %s --output %s %s 2>&1",
                libqore_dir, compile, exe, src));
            assertTrue(is_file(exe), "AOT compile succeeds: " + compile_out);
            string aot_out = run_executable(sprintf("LD_LIBRARY_PATH=%s %s", libqore_dir, exe));
            assertEq(ast_out, aot_out, "AOT step events and statement lookup match source for " + compile);
            unlink(exe);
        }
    }

    #! runs a qcc executable and returns its output (qore#7805)
    /** @return the output on stdout followed by the output on stderr, apart from the module loader's
        warnings and the native compilation trace, which are not output of the program (see
        ExecModeHarness::run_command()); the executable runs in its default environment, which only
        traces native compilation
    */
    private string run_executable(string cmd) {
        return ExecModeHarness::run_command(cmd, NOTHING, "QORE_JIT_TIMING=1").out;
    }
}
