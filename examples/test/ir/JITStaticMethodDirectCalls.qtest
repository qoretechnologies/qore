#!/usr/bin/env qore
# Copyright (c) 2026 Qore Technologies, s.r.o.
# SPDX-License-Identifier: MIT
# test-exec-mode: children - its checks run in child processes that set their own execution modes
#
# Plain functions called directly through their fast entries by native code from methods and static methods, and
# static methods called directly, run in their own object and class context: JITStaticMethodDirectCalls.qr gives the
# same output in every execution mode and in AOT code as with the AST interpreter (results, access checks, call
# stacks, exceptions, the release of temporary arguments and objects)
%modern
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../ExecModeHarness.qm
%exec-class JITStaticMethodDirectCallsTest

class JITStaticMethodDirectCallsTest inherits QUnit::Test {
    private {
        string qore = realpath(ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0]);
        string libdir = realpath(ENV.QORE_LIBDIR ?? dirname(qore));
        string qcc = ENV.QCC ?? libdir + "/qcc";
        string source = get_script_dir() + "/JITStaticMethodDirectCalls.qr";
        string expected;
    }

    constructor() : Test("JIT static method direct calls", "1.0", \ARGV) {
        addTestCase("AST reference output", \astOutput());
        addTestCase("execution modes", \executionModes());
        addTestCase("AOT", \aot());
        set_return_value(main());
    }

    private static string quote(string value) {
        return "'" + replace(value, "'", "'\"'\"'") + "'";
    }

    private string run(list<string> args, string prefix = "") {
        int status;
        string output = backquote(prefix + "LD_LIBRARY_PATH=" + quote(libdir)
            + " DYLD_LIBRARY_PATH=" + quote(libdir) + " "
            + (map quote($1), args).join(" ") + " 2>&1", \status);
        assertEq(0, status, output);
        return output;
    }

    private string getExpected() {
        if (!expected) {
            expected = run((qore, "--exec-mode=ast", source));
        }
        return expected;
    }

    astOutput() {
        string out = getExpected();
        # a plain function called from a static method or a method has no class context of its own: a private method
        # called through an object raises an exception in it
        assertRegex("func from static: -3\n", out);
        assertRegex("func from method: -3\n", out);
        # a static method runs in the context of its class, whatever its caller's
        assertRegex("dyn: 126\n", out);
        assertRegex("other: 126\n", out);
        assertRegex("priv: 225\n", out);
        assertRegex("caught STATIC-ERR x=3 line 35 stack: \\[\"Base::thrower\", \"loop_throw\"\\]\n", out);
        assertRegex("stack: \\[\"get_thread_call_stack\", \"Base::stack\", \"loop_stack\"\\]\n", out);
        # a temporary argument is released when the call returns
        assertRegex("destroyed arg0\nafter keep 0\ndestroyed arg1\nafter keep 1\n", out);
        # a closure made by a static method called from a method does not keep the object
        assertRegex("deleting c\nChild destroyed\ndeleted c; closure: 1\n", out);
    }

    executionModes() {
        string exp = getExpected();
        foreach string mode in (("ir", "jit", "tiered")) {
            foreach string control in (("", "QORE_JIT_SYNC_COMPILE=1 ",
                    "QORE_JIT_SYNC_COMPILE=1 QORE_IR_THRESHOLD=1 QORE_JIT_THRESHOLD=1 ",
                    # every direct native call of a plain function switches the context
                    "QORE_JIT_SYNC_COMPILE=1 QORE_DISABLE_JIT_CONTEXT_FREE_CALLS=1 ")) {
                assertEq(exp, run((qore, "--exec-mode=" + mode, source), control), control + mode);
            }
        }
        # tiered execution kept on the IR tier: nothing is compiled to native code, nothing runs on the AST
        string ir_cmd = "LD_LIBRARY_PATH=" + quote(libdir) + " DYLD_LIBRARY_PATH=" + quote(libdir) + " "
            + quote(qore) + " --exec-mode=tiered " + quote(source);
        assertEq(exp, ExecModeHarness::run_ir_tier(ir_cmd), "IR tier");
    }

    aot() {
        string exp = getExpected();
        TmpDir dir("qore-jit-static-direct-");
        # the control is read when the code is compiled
        foreach string prefix in (("", "QORE_AOT_EH=1 ")) {
            foreach string level in (("-O0", "-O3")) {
                string executable = dir.path + "/fixture";
                run((qcc, level, "-o", executable, source), prefix);
                assertEq(exp, run((executable,)), prefix + level);
            }
        }
    }
}
