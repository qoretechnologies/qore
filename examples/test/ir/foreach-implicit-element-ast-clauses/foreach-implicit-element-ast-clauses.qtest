#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - JIT and AOT code generation of the implicit index of foreach statements
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - every check runs the script in a child process that sets its own --exec-mode, or AOT

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires ../../TestInterpreter.qm
%requires FsUtil
%requires ../../ExecModeHarness.qm

%exec-class ForeachImplicitElementAstClausesTest

#! issue #6341: $# in the clauses of a context statement or a find expression in a foreach body
/** The data, where, sortBy and sortDescendingBy expressions of a context statement and the source, find and where
    expressions of a find expression run as AST at run time, where \c $# reads the thread's implicit element.  The IR
    lowering of a foreach statement drops the push of its index as the implicit element when no code in its body
    reads it, and did not count these instructions as readers, so in a foreach body they gave 0 (the enclosing
    index) in ir, jit, tiered and AOT executables instead of the foreach index.

    foreach-implicit-element-ast-clauses.q prints the values; the AST interpreter's output must be the expected one,
    and every other execution mode, the IR tier and AOT executables compiled with -O0 and -O3 must give the same.
*/
class ForeachImplicitElementAstClausesTest inherits QUnit::Test {
    public {
        #! the output of the script
        const Expected = (
            "context where [0, 1]",
            "context sortBy [0, 1, 2, 1, 0, 2]",
            "context sortDescendingBy [0, 2, 1, 1, 2, 0]",
            "context data [0, 5, 1, 5]",
            "find where [0, 1]",
            "find exp [0, 1]",
            "find source [7, 0, 1, 2]",
            "context body [0, 1, 1, 2]",
            "context where+body [0, 1]",
            "nested context where [0, 0, 1, 1]",
            "function [0, 5, 1, 6]",
            "method [0, 1, 1, 0]",
            "closure [0, 1]",
            "map find [0, 1]",
            "select find [2]",
            "hash map find {1: 0, 2: 1}",
            "count find 1",
            "no index [2, 3]",
            "break continue [0, 2]",
            "return [0, 1]",
            "exception in where [\"DIVISION-BY-ZERO0\", 1]",
        );
    }

    private {
        string qore_bin;
        string qcc_bin;
        string env;
        string script;
    }

    constructor() : QUnit::Test("foreach implicit element AST clauses", "1.0", \ARGV) {
        qore_bin = TestInterpreter::qore_interpreter();
        string libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
            ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");
        env = sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s QORE_LIBDIR=%s", libqore_dir, libqore_dir, libqore_dir);
        script = get_script_dir() + "/foreach-implicit-element-ast-clauses.q";

        addTestCase("AST interpreter", \astTest());
        addTestCase("execution modes", \modesTest());
        addTestCase("AOT executable -O0", \aotTest(), "-O0");
        addTestCase("AOT executable -O3", \aotTest(), "-O3");
        set_return_value(main());
    }

    #! checks the output of the AST interpreter, which the other modes must give
    private astTest() {
        list<string> lines = select ast().split("\n"), $1;
        assertEq(Expected, lines);
    }

    #! runs the script in every execution mode and on the IR tier
    private modesTest() {
        string exp = ast();
        foreach string mode in (ExecModeHarness::ExecModes) {
            if (mode == "ast") {
                continue;
            }
            assertEq(exp, ExecModeHarness::run(sprintf("%s %s --exec-mode=%s %s", env, qore_bin, mode, script)), mode);
        }
        assertEq(exp, ExecModeHarness::run_ir_tier(sprintf("%s %s --exec-mode=tiered %s", env, qore_bin, script)),
            ExecModeHarness::IRTierName);
    }

    #! compiles the script with qcc and checks that the executable gives the output of the AST interpreter
    private aotTest(string opt) {
        if (!is_file(qcc_bin)) {
            testSkip("qcc is not available at " + qcc_bin);
        }
        TmpDir dir("foreach-implicit-element-ast-clauses-aot-");
        string exe = dir.path + "/foreach-implicit-element-ast-clauses";
        string out = ExecModeHarness::run_any(sprintf("%s %s %s -o %s %s", env, qcc_bin, opt, exe, script));
        assertTrue(is_file(exe), "qcc " + opt + " compiles the script: " + out);
        assertEq(ast(), ExecModeHarness::run_any(sprintf("%s %s", env, exe)), "AOT " + opt);
    }

    #! returns the output of the script with the AST interpreter
    private string ast() {
        return ExecModeHarness::run(sprintf("%s %s --exec-mode=ast %s", env, qore_bin, script));
    }
}
