#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil

%exec-class AOTAliasedConstantPathDepthTest

# Regression test for a mutual constant reference written into an AOT object when
# one constant's value is also reachable through another constant that holds it.
#
# The writer records, for every node inside a constant value, the constant path it
# can be recovered from, and emits a VT_CONST_REF for nodes it meets again while
# serializing a different constant.  When a node is reachable by more than one
# path, `aot_constant_reverse_path_is_better()` picks the best one -- and it used
# to pick by raw encoded-string length.  A container constant with a short name
# reaches the interior of a long-named constant it holds, and that deeper path can
# encode SHORTER than the owning constant's own path, so the alias won:
#
#   OptionsBase::InterfaceSystemOptions["stack-size"]        -> 73 bytes encoded
#   OptionsBase::OptionInfo["system"]["stack-size"]          -> 70 bytes encoded
#
# `InterfaceSystemOptions` was then serialized referencing into `OptionInfo`, while
# `OptionInfo["system"]` references `InterfaceSystemOptions` back.  Whichever of
# the two registers first at load time cannot resolve its reference and
# deserializes to a deferred AOT constant-path reference instead of a value.  A
# later compilation unit that folds that constant into a new one (a subclass
# merging its parent's constant) then hands the writer a node that is not a value
# at all:
#
#   error: failed to serialize script namespace tree: CLASSES section: AOT cannot
#   serialize class constant 'OptionsDerived::InterfaceSystemOptions' without data
#   loss (at ["stack-size"], value type 'AOT constant path reference')
#
# When the cycle is instead reached through a constant that already holds a value,
# the same mutual reference makes ConstantEntry::getReferencedValue() and
# RuntimeConstantPathRefNode::evalImpl() call each other without a base case, and
# qcc dies of a stack overflow with no diagnostic at all -- which is how both
# cases below fail against a build without the fix.
#
# Path depth now outranks the length heuristic, so the constant that directly owns
# a node always beats a container that only reaches it *through* that owner, and
# no mutual reference is written.
#
# The names below are load-bearing: `OptionInfo` must be short enough that the
# extra `["system"]` subscript still encodes shorter than the owner's path, which
# is what made the length heuristic pick the alias.
class AOTAliasedConstantPathDepthTest inherits QUnit::Test {
    private {
        string qore_bin;
        string qcc_bin;
        string libqore_dir;
    }

    constructor() : QUnit::Test("AOTAliasedConstantPathDepthTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC
            ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");

        addTestCase("a constant whose value is also held by a shorter-named constant "
            "stays serializable across compilation units",
            \testAliasedConstantPathDepth());
        addTestCase("a list-subscripted alias path does not displace the owning "
            "constant either", \testAliasedListConstantPathDepth());

        set_return_value(main());
    }

    # `InterfaceSystemOptions` is declared first, so it is the constant that
    # registers before its alias `OptionInfo` at load time and therefore the one
    # that cannot resolve a reference into it.
    private string baseCode() {
        return "%modern
public class OptionsBase {
    public {
        const InterfaceSystemOptions = {
            \"stack-size\": {\"type\": \"byte-size\", \"desc\": \"default stack size\"},
        };

        const OptionInfo = {
            \"system\": InterfaceSystemOptions,
        };
    }
}
";
    }

    # a separate compilation unit that folds the base constant into a new one --
    # this is where the deferred reference reaches the writer
    private string derivedCode() {
        return "%modern
public class OptionsDerived inherits OptionsBase {
    public {
        const InterfaceSystemOptions = OptionsBase::InterfaceSystemOptions + {
            \"java-max-heap\": {\"type\": \"byte-size\", \"desc\": \"default max JVM heap\"},
        };
    }

    static string describe() {
        return sort(keys OptionsDerived::InterfaceSystemOptions).join(\",\");
    }

    static string stackSizeType() {
        return OptionsDerived::InterfaceSystemOptions{\"stack-size\"}{\"type\"};
    }

    static string aliasedStackSizeType() {
        return OptionsBase::OptionInfo{\"system\"}{\"stack-size\"}{\"type\"};
    }
}
";
    }

    # the same aliasing shape reached through a list index rather than a hash key,
    # so the depth accounting is exercised for both component kinds
    private string listBaseCode() {
        return "%modern
public class ListOptionsBase {
    public {
        const InterfaceSystemOptionList = (
            {\"type\": \"byte-size\", \"name\": \"stack-size\"},
        );

        const OptInfo = {
            \"system\": InterfaceSystemOptionList,
        };
    }
}
";
    }

    private string listDerivedCode() {
        return "%modern
public class ListOptionsDerived inherits ListOptionsBase {
    public {
        const InterfaceSystemOptionList = ListOptionsBase::InterfaceSystemOptionList + (
            {\"type\": \"byte-size\", \"name\": \"java-max-heap\"},
        );
    }

    static string names() {
        return (map $1.name, ListOptionsDerived::InterfaceSystemOptionList).join(\",\");
    }
}
";
    }

    private string run(string cmd) {
        return backquote(cmd + " 2>&1");
    }

    private writeFile(string path, string contents) {
        File f();
        f.open2(path, O_WRONLY | O_CREAT | O_TRUNC);
        f.write(contents);
    }

    # compile base into its own AOT object, then the dependent unit against it;
    # returns the dependent unit's compiler output
    private string compilePair(string tmp_dir, string base_src, string derived_src) {
        string lib_dir = tmp_dir + "/aotlib";
        mkdir(lib_dir);
        string base_path = tmp_dir + "/base.qc";
        string derived_path = tmp_dir + "/derived.qc";
        writeFile(base_path, base_src);
        writeFile(derived_path, derived_src);

        string env = sprintf("LD_LIBRARY_PATH=%s QORE_LIBDIR=%s", libqore_dir, libqore_dir);
        string base_out = run(sprintf("%s %s -c -L %s --parse-option=PO_MODERN -o %s/base.qo %s",
            env, qcc_bin, lib_dir, lib_dir, base_path));
        assertTrue(is_file(lib_dir + "/base.qo"), "compiled the aliasing base unit: " + base_out);

        return run(sprintf("%s %s -c -L %s --parse-option=PO_MODERN -o %s/derived.qo %s",
            env, qcc_bin, lib_dir, lib_dir, derived_path));
    }

    testAliasedConstantPathDepth() {
        TmpDir tmp("qore-aot-aliased-const-path-");
        string derived_out = compilePair(tmp.path, baseCode(), derivedCode());

        assertEq(-1, derived_out.find("without data loss"),
            "folding an aliased base constant into a new constant serializes: " + derived_out);
        assertEq(-1, derived_out.find("AOT constant path reference"),
            "the base constant deserialized to a value, not a deferred path reference: "
            + derived_out);
        assertTrue(is_file(tmp.path + "/aotlib/derived.qo"),
            "compiled the unit that folds the aliased base constant: " + derived_out);

        # value correctness: the merged constant and both routes to the shared node
        # still hold the expected values
        string script_path = tmp.path + "/run.qr";
        writeFile(script_path, baseCode() + derivedCode()
            + "printf(\"%s|%s|%s\\n\", OptionsDerived::describe(), "
            "OptionsDerived::stackSizeType(), OptionsDerived::aliasedStackSizeType());\n");
        string value_out = run(sprintf("LD_LIBRARY_PATH=%s %s -b --enable-debug %s",
            libqore_dir, qore_bin, script_path));
        assertEq("java-max-heap,stack-size|byte-size|byte-size\n", value_out,
            "the aliased constant keeps its value on both paths: " + value_out);
    }

    testAliasedListConstantPathDepth() {
        TmpDir tmp("qore-aot-aliased-const-list-path-");
        string derived_out = compilePair(tmp.path, listBaseCode(), listDerivedCode());

        assertEq(-1, derived_out.find("without data loss"),
            "folding an aliased base list constant into a new constant serializes: "
            + derived_out);
        assertTrue(is_file(tmp.path + "/aotlib/derived.qo"),
            "compiled the unit that folds the aliased base list constant: " + derived_out);

        string script_path = tmp.path + "/run.qr";
        writeFile(script_path, listBaseCode() + listDerivedCode()
            + "printf(\"%s\\n\", ListOptionsDerived::names());\n");
        string value_out = run(sprintf("LD_LIBRARY_PATH=%s %s -b --enable-debug %s",
            libqore_dir, qore_bin, script_path));
        assertEq("stack-size,java-max-heap\n", value_out,
            "the aliased list constant keeps its value: " + value_out);
    }
}
