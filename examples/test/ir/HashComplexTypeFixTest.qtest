#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%require-types
%enable-all-warnings
%strict-types

# Test for IR CallMethod fallback hash type conversion fix
#
# This test validates that when function parameters with complex hash types
# are accessed via the IR interpreter's CallMethod/CallStatic fallback path,
# the hash type is properly handled and doesn't cause INVALID-MEMBER errors
# when accessing nested hashdecl members.

hashdecl DataProviderExpressionInfo {
    string name;
    string type_name;
}

# Function that accepts a complex hash parameter
# The parameter type is hash<string, hash<DataProviderExpressionInfo>>
sub test_hash_access(hash<string, hash<DataProviderExpressionInfo>> $expressions) {
    # Iterate and access members - this uses the IR fallback path
    my int $count = 0;
    foreach string $key in ($expressions.keys()) {
        # This should work without INVALID-MEMBER error
        my string $name = $expressions{$key}.name;
        $count++;
    }

    if ($count != 2) {
        throw "TEST-ERROR", sprintf("Expected 2 items, got %d", $count);
    }
}

# Create test data
my hash<string, hash<DataProviderExpressionInfo>> $data = (
    "item1": <DataProviderExpressionInfo>{
        "name": "first",
        "type_name": "simple"
    },
    "item2": <DataProviderExpressionInfo>{
        "name": "second",
        "type_name": "complex"
    }
);

# Run test - this should NOT throw INVALID-MEMBER
try {
    test_hash_access($data);
    printf("PASS: Hash type conversion test successful\n");
} catch (hash<ExceptionInfo> $ex) {
    printf("FAIL: %s: %s\n", $ex.err, $ex.desc);
    exit(1);
}
