#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-exec-mode: children - its checks run in child processes that set their own execution modes
# test-platform: macos - JIT and AOT code generation of the paths of a debugger's requests

# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../ExecModeHarness.qm
%exec-class DebugFlowPathCodeTest

#! the code after the paths of a debugger's requests has the lowering state that the code before them left (#6201)
/** Code with step events, the default, has the paths of a debugger's return, break and continue requests at every
    step event, which release the temporaries, the locals and the handlers of the blocks that they leave.  The paths
    run only on a request, and the native code of the blocks after them is lowered with the state that the code before
    them left: the temp scopes still open and the cleanups of the locals of the blocks still open.  The return paths
    share the release of the locals of the bottom blocks of the function, and the paths of the step events of handler
    bodies lowered inline are shared as those of other code, so that the code of the paths grows with the function.
*/
class DebugFlowPathCodeTest inherits QUnit::Test {
    public {
        #! the blocks of the function with step events of handlerPathSize(), for each block without them
        const MaxPathBlockRatio = 2.0;
        #! the size of the function with step events, for each instruction without them, with inline handler code
        const MaxPathInlineRatio = 1.3;
        #! the growth of the code of the paths when the catch blocks double
        const MaxPathGrowth = 2.3;
    }

    private {
        string qore_bin = executablePath(ENV.QORE_BIN ?? QORE_ARGV[0] ?? "qore");
        string lib_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        string qcc_bin = ENV.QCC ?? lib_dir + "/qcc";
        string probe = get_script_dir() + "/DebugFlowPathCode/probe.q";
        *string ast_out;
    }

    constructor() : Test("debug flow path code", "1.0", \ARGV) {
        addTestCase("AST reference", \astReference());
        addTestCase("compiled modes match AST", \sourceModes());
        addTestCase("qcc executables match AST", \compiled());
        addTestCase("the paths of a function with many catch blocks with handlers grow with the function",
            \handlerPathSize());
        set_return_value(main());
    }

    astReference() {
        list<string> lines = getAst().split("\n");
        foreach string line in (
                'cases 3 a3b3c3d3',
                'cases 12 ',
                'loop_switch a0d0b0a1s1b1a2d2b2 ["~a0", "~d0", "~b0", "e0", "~a1", "~s1", "c1", "~b1", "e1", "~a2", "~d2", '
                    '"~b2", "e2"]',
                'block_locals ["a0", "b0", "~e0", "~d0", "c0", "a1", "b1", "~e1", "~d1", "c1", "end"]',
                'locals_tries 50 23',
                'nested_handlers ["h1", "h2", "h3", "~blk", "out:O"]',
            ) {
            # each case runs twice, so that the tiered mode runs compiled code on the second call
            assertEq(2, (select lines, $1 == line).size(), line);
        }
    }

    sourceModes() {
        string expected = getAst();
        foreach string mode in ("ir", "jit") {
            assertEq(expected, run((qore_bin, "-b", "--enable-debug", "--exec-mode=" + mode, probe)), mode);
        }
        assertEq(expected, run(("QORE_JIT_SYNC_COMPILE=1", "QORE_IR_THRESHOLD=1", "QORE_JIT_THRESHOLD=1", qore_bin,
            "-b", "--enable-debug", "--exec-mode=tiered", probe)), "tiered");
    }

    compiled() {
        string expected = getAst();
        foreach string level in ("-O0", "-O3") {
            TmpDir dir("qore-debug-flow-path-code-");
            string exe = dir.path + "/probe";
            run((qcc_bin, level, "-o", exe, probe));
            assertEq(expected, run((exe, "-b", "--enable-debug")), "qcc " + level);
        }
    }

    #! the code of the paths of a function with many catch blocks with handlers grows with the function (#6201)
    /** Before, each path that left a scope ran its handlers with code that publishes and reloads each local of the
        function, also where no handler of the scope is registered yet, and each request of a step event had an entry
        block of its own even where the requests share their path (a break or a continue that no loop takes is a
        return): the function with step events was 1.84 times the size of the same function without them with the
        handlers' code inline (QORE_JIT_OBE_TABLE_BUDGET), and had 2.38 times its blocks; it is 1.11 and 1.81 times
        now (develop, without the paths: 1.05 and 1.50)
    */
    handlerPathSize() {
        hash<auto> small_dbg = compileHandlers(25, True, False);
        hash<auto> small_nd = compileHandlers(25, False, False);
        hash<auto> large_dbg = compileHandlers(50, True, False);
        hash<auto> large_nd = compileHandlers(50, False, False);
        foreach hash<auto> i in (({"n": 25, "dbg": small_dbg, "nd": small_nd}, {"n": 50, "dbg": large_dbg,
                "nd": large_nd})) {
            float ratio = float(i.dbg.blocks) / i.nd.blocks;
            assertTrue(ratio <= MaxPathBlockRatio, sprintf("%d catch blocks: the function has %0.2f times the blocks "
                "of the same function without step events (at most %0.2f): %d and %d", i.n, ratio, MaxPathBlockRatio,
                i.dbg.blocks, i.nd.blocks));
        }
        # the inline code of the handlers (qore#6110)
        hash<auto> small_inline = compileHandlers(25, True, True);
        hash<auto> large_inline = compileHandlers(50, True, True);
        hash<auto> small_inline_nd = compileHandlers(25, False, True);
        hash<auto> large_inline_nd = compileHandlers(50, False, True);
        foreach hash<auto> i in (({"n": 25, "dbg": small_inline, "nd": small_inline_nd}, {"n": 50, "dbg": large_inline,
                "nd": large_inline_nd})) {
            float ratio = float(i.dbg.insts) / i.nd.insts;
            assertTrue(ratio <= MaxPathInlineRatio, sprintf("%d catch blocks, inline handler code: the function is "
                "%0.2f times the size of the same function without step events (at most %0.2f): %d and %d", i.n, ratio,
                MaxPathInlineRatio, i.dbg.insts, i.nd.insts));
        }
        # the code of the paths grows with the function, not with the product of its handlers and its locals
        float growth = float(large_inline.insts - large_inline_nd.insts) / (small_inline.insts - small_inline_nd.insts);
        assertTrue(growth <= MaxPathGrowth, sprintf("the code of the paths grows by %0.2f when the catch blocks double "
            "(at most %0.2f)", growth, MaxPathGrowth));
    }

    #! the function with \a n try statements whose catch blocks have a local and an on_exit handler
    /** As JITLargeFunctionBlocks.qtest (qore#6104), with or without step events
    */
    private static string getHandlerCode(int n, bool debugging) {
        string code = "%modern\n" + (debugging ? "" : "%no-debugging\n") + "
int sub may_throw(int i) { if (i < 0) { throw \"NEG\", \"negative\"; } return i + 1; }

int sub big(int n) {
    int r = 0;
";
        for (int i = 0; i < n; ++i) {
            code += sprintf("    try {
        r += may_throw(n - %d);
    } catch (hash<ExceptionInfo> ex) {
        int l%d = r + %d;
        on_exit { r += l%d; }
        r += 1;
    }
", i % 7 == 3 ? 1000 : 0, i, i, i);
        }
        code += "    return r;
}

printf(\"rv:%d\\n\", big(1) + big(2) + big(3));
";
        return code;
    }

    #! returns the number of instructions and of blocks of the LLVM function of \c big, as lowered (not optimized)
    private hash<auto> compileHandlers(int n, bool debugging, bool inline_handlers) {
        TmpFile tmp(NOTHING, ".qr");
        tmp.file.write(getHandlerCode(n, debugging));
        tmp.file.close();
        list<string> args = ("QORE_JIT_SYNC_COMPILE=1", "QORE_IR_THRESHOLD=1", "QORE_JIT_THRESHOLD=1",
            "QORE_DUMP_LLVM_IR=1", "QORE_JIT_OPT_LEVEL=0", "QORE_JIT_MAX_IR_INSTRUCTIONS=0",
            "QORE_JIT_MAX_HANDLER_COST=0");
        if (inline_handlers) {
            args += "QORE_JIT_OBE_TABLE_BUDGET=100000000";
        }
        args += (qore_bin, "-b", "--exec-mode=jit", tmp.path);
        string command = "env LD_LIBRARY_PATH=" + quote(lib_dir) + " QORE_LIBDIR=" + quote(lib_dir) + " "
            + (map quote($1), args).join(" ") + " 2>&1";
        string out = backquote(command);
        hash<auto> sizes = {"insts": 0, "blocks": 0};
        bool in_big = False;
        foreach string line in (out.split("\n")) {
            if (!in_big) {
                in_big = line =~ /^define .*@"?big/;
                continue;
            }
            if (line =~ /^}/) {
                break;
            }
            if (line =~ /^[A-Za-z0-9_.$"-]+:/) {
                ++sizes.blocks;
            } else if (line =~ /^  [^ ;]/) {
                ++sizes.insts;
            }
        }
        if (!sizes.insts) {
            throw "NO-DUMP", sprintf("no LLVM function 'big' in the output (%d bytes) for %d catch blocks%s%s: the "
                "function was not compiled", out.size(), n, debugging ? "" : " without step events",
                inline_handlers ? " with the inline code of the handlers" : "");
        }
        return sizes;
    }

    private string getAst() {
        if (!exists ast_out) {
            ast_out = run((qore_bin, "-b", "--enable-debug", "--exec-mode=ast", probe));
        }
        return ast_out;
    }

    private static string quote(string value) {
        return "'" + join("'\\''", split("'", value)) + "'";
    }

    private static string executablePath(string name) {
        if (name.regex("/")) {
            return realpath(name);
        }
        foreach string directory in (split(":", ENV.PATH ?? "")) {
            string path = (directory ? directory : ".") + "/" + name;
            if (is_executable(path)) {
                return realpath(path);
            }
        }
        throw "TEST-SETUP-ERROR", "cannot locate Qore executable " + name;
    }

    #! runs a command; one that runs qore with an execution mode runs through ExecModeHarness
    private string run(list<string> args) {
        string command = "env LD_LIBRARY_PATH=" + quote(lib_dir) + " QORE_LIBDIR=" + quote(lib_dir) + " "
            + (map quote($1), args).join(" ");
        hash<ExecModeHarness::ModeRunResult> r = ExecModeHarness::run_command(command);
        if (r.mode) {
            ExecModeHarness::check_native(r);
        }
        assertEq(0, r.rc, r.out);
        return r.out;
    }
}
