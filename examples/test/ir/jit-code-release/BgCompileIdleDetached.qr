#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
#
# The background JIT compiler is not idle while a detached compile that has ended still holds the compile lock
# (qore#7831); see BgCompileIdleDetached.qtest.  The argument is the execution mode of the Programs: "jit" or
# "tiered".

%modern
%no-child-restrictions

# the debug hooks of the background compiler exist only in a debug build of the library
if (!Option::HAVE_LIBRARY_DEBUGGING) {
    print("no library debugging\n");
    exit(0);
}

#! milliseconds to wait for each step of the background compile thread
const T = 60000;

ExecMode em = ARGV[0] == "jit" ? EM_JIT : EM_TIERED;

const Src = "int sub f(int x) { int s = 0; for (int i = 0; i < x; ++i) { s += i % 7; } return s; }";

#! a Program whose code is compiled, which stays: the entries of the GDB JIT interface that its code registered are
#! the base that the other counts are compared with
Program base(PO_MODERN | PO_NO_CHILD_PO_RESTRICTIONS);
base.setExecMode(em);
base.parse(Src, "base");
for (int i = 0; i < 3; ++i) {
    base.callFunction("f", 10);
}
call_function("dbg_wait_bg_compile_idle");
int entries0 = call_function("dbg_get_jit_debugger_entry_count");

# the compile of a Program's function is stopped in the LLVM phase, and the Program is deleted: its teardown detaches
# the compile, whose result is discarded when it ends
Program p(PO_MODERN | PO_NO_CHILD_PO_RESTRICTIONS);
p.setExecMode(em);
p.parse(Src, "p");
call_function("dbg_hold_bg_compile", "llvm");
for (int i = 0; i < 3; ++i) {
    p.callFunction("f", 10);
}
bool held_llvm = call_function("dbg_wait_bg_compile_held", "llvm", T);
delete p;

# the compile is stopped again at its end, where the compile thread still holds the compile lock, and the compile is
# still the detached compile in progress
call_function("dbg_hold_bg_compile", "finish");
bool continued_llvm = call_function("dbg_continue_bg_compile", T);
bool held_finish = call_function("dbg_wait_bg_compile_held", "finish", T);

# the compiler is not idle yet: dbg_wait_bg_compile_idle() does not return here, so a count made after it does not see
# the compile lock held by the detached compile, which made the count of the entries 0
bool idle = call_function("dbg_bg_compile_idle");
*int entries_when_idle = idle ? call_function("dbg_get_jit_debugger_entry_count") : NOTHING;

bool continued_finish = call_function("dbg_continue_bg_compile", T);
call_function("dbg_wait_bg_compile_idle");
int entries = call_function("dbg_get_jit_debugger_entry_count");

printf("held_llvm=%y continued_llvm=%y held_finish=%y idle=%y entries_when_idle=%y continued_finish=%y "
    "entries_restored=%y\n", held_llvm, continued_llvm, held_finish, idle, entries_when_idle, continued_finish,
    entries == entries0);
