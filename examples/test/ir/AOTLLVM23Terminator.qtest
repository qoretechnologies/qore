#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-exec-mode: children - its checks run in child processes that set their own execution modes and in qcc executables

%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires ../ExecModeHarness.qm
%requires ../TestInterpreter.qm
%requires FsUtil

# the test's files are in a temporary directory of its own, which is removed also when a check fails, as exit()
# runs no destructors (qore#7817)
TmpDir tmp("qore-aot-llvm23-terminator-");

sub test_exit(int rc) {
    remove_tree(tmp.path);
    exit(rc);
}

#! runs a qcc executable and returns its output (qore#7805)
/** @return the output on stdout followed by the output on stderr, apart from the module loader's
    warnings and the native compilation trace, which are not output of the program (see
    ExecModeHarness::run_command()); the executable runs in its default environment, which only
    traces native compilation
*/
string sub run_executable(string cmd) {
    return ExecModeHarness::run_command(cmd, NOTHING, "QORE_JIT_TIMING=1").out;
}

string qore_bin = TestInterpreter::qore_interpreter();
string libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
string qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
    ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : dirname(qore_bin) + "/qcc");
if (!is_file(qcc_bin)) {
    qcc_bin = "qcc";
}

string root = tmp.path + "/llvm23-terminator";
mkdir(root);
string source_path = root + "/case.qr";
string executable_path = root + "/case";
string source = "%modern

class ReceiverProbe {
    private {
        hash<string, string> receivers;
    }

    string getOrCreateReceiver(string address, *hash<string, string> options) {
        *string receiver = receivers{address};
        if (!receiver) {
            receiver = options.value ?? address;
            receivers{address} = receiver;
        }
        return receiver;
    }
}

class ChildProbe {
}

class ProviderProbe {
    *ChildProbe getChildProvider(string name) {
        if (name == \"events\") {
            return new ChildProbe();
        }
        return NOTHING;
    }
}

int sub main() {
    ReceiverProbe receiver_probe();
    ProviderProbe provider_probe();
    printf(\"%s:%s:%y:%y\\n\",
        receiver_probe.getOrCreateReceiver(\"first\", (\"value\": \"created\")),
        receiver_probe.getOrCreateReceiver(\"first\", NOTHING),
        provider_probe.getChildProvider(\"events\") !== NOTHING,
        provider_probe.getChildProvider(\"missing\") !== NOTHING);
    return 0;
}

main();
";

File file();
file.open2(source_path, O_WRONLY | O_CREAT | O_TRUNC);
file.write(source);
file.close();

string env = sprintf("LD_LIBRARY_PATH=%s QORE_LIBDIR=%s", libqore_dir, libqore_dir);
# the qore run that the executable's output is compared with runs the same way
string expected = run_executable(sprintf("%s %s %s", env, qore_bin, source_path));
string compile_out = backquote(sprintf(
    "%s %s --strip-debug-info -O3 -o %s %s 2>&1",
    env, qcc_bin, executable_path, source_path));
if (!is_file(executable_path)) {
    printf("AOT compile failed:\n%s", compile_out);
    test_exit(2);
}

string actual = run_executable(sprintf("%s %s", env, executable_path));
if (expected != "created:created:True:False\n" || actual != expected) {
    printf("execution mismatch:\nAST:\n%sAOT:\n%s", expected, actual);
    test_exit(2);
}

unlink(executable_path);
unlink(source_path);
rmdir(root);
