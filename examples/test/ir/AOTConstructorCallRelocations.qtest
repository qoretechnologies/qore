#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil

%exec-class AOTConstructorCallRelocationsTest

# Constructor calls in standalone-compiled classes should carry the same
# optional call-relocation metadata as direct function/static-method calls.
# The link map must then resolve the constructor relocation against the
# provider object's symbol-index record.
class AOTConstructorCallRelocationsTest inherits QUnit::Test {
    private {
        string qcc_bin;
        string libqore_dir;
    }

    constructor() : QUnit::Test("AOTConstructorCallRelocationsTest", "1.0", \ARGV) {
        string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC
            ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");

        addTestCase("standalone constructor call relocation resolves at link time",
            \testStandaloneConstructorRelocation());
        addTestCase("standalone inherited constructor preload defers constant init",
            \testStandaloneInheritedConstructorPreload());

        set_return_value(main());
    }

    private string run(string cmd) {
        return backquote(cmd + " 2>&1");
    }

    private write(string path, string body) {
        File f();
        f.open2(path, O_WRONLY | O_CREAT | O_TRUNC);
        f.write(body);
    }

    testStandaloneConstructorRelocation() {
        TmpDir tmp("qore-aot-ctor-reloc-");
        string tmp_dir = tmp.path;
        string lib_dir = tmp_dir + "/aotlib";
        mkdir(lib_dir);

        string provider_src = tmp_dir + "/provider.qc";
        string consumer_src = tmp_dir + "/consumer.qc";
        string provider_qo = lib_dir + "/provider.qo";
        string consumer_qo = lib_dir + "/consumer.qo";
        string aggregate_qo = lib_dir + "/aggregate.qo";
        string map_path = lib_dir + "/aggregate.qolink.json";
        string strict_aggregate_qo = lib_dir + "/strict-aggregate.qo";
        string strict_map_path = lib_dir + "/strict-aggregate.qolink.json";
        string missing_aggregate_qo = lib_dir + "/missing-provider-aggregate.qo";
        string missing_map_path = lib_dir + "/missing-provider-aggregate.qolink.json";

        write(provider_src, "%new-style
public class AOTCtorRelocProvider {
    public constructor(int value) {
    }
}
");
        write(consumer_src, "%new-style
public class AOTCtorRelocConsumer {
    static AOTCtorRelocProvider make(int value) {
        return new AOTCtorRelocProvider(value);
    }
}
");

        string env = sprintf("LD_LIBRARY_PATH=%s QORE_LIBDIR=%s", libqore_dir, libqore_dir);
        string provider_out = run(sprintf("%s %s -c -L %s --parse-option=PO_MODERN -o %s %s",
            env, qcc_bin, lib_dir, provider_qo, provider_src));
        assertTrue(is_file(provider_qo), "compiled provider .qo: " + provider_out);

        string consumer_out = run(sprintf("%s %s -c -L %s --parse-option=PO_MODERN -o %s %s",
            env, qcc_bin, lib_dir, consumer_qo, consumer_src));
        assertTrue(is_file(consumer_qo), "compiled consumer .qo: " + consumer_out);

        string dump = run(sprintf("%s --dump-info --dump-symbols %s", qcc_bin, consumer_qo));
        assertTrue(dump.find("call relocations: version=1 records=1") != -1,
            "consumer .qo has exactly one call relocation: " + dump);
        assertTrue(dump.find("constructor   AOTCtorRelocProvider::constructor(int)") != -1,
            "consumer .qo records the constructor relocation path: " + dump);

        string index_json = run(sprintf("%s --dump-index-json %s", qcc_bin, consumer_qo));
        assertTrue(index_json.find("\"requires\"") != -1,
            "consumer index JSON includes requires records: " + index_json);
        assertTrue(index_json.find("AOTCtorRelocProvider::constructor(int)") != -1,
            "consumer index JSON records the constructor import: " + index_json);
        assertTrue(index_json.find("\"flags\": 2") != -1,
            "constructor import is marked optional: " + index_json);

        string link_out = run(sprintf(
            "%s --link-qo --aggregate-symbol=AOT_CTOR_RELOC_TEST --qolink-map=%s -o %s %s %s",
            qcc_bin, map_path, aggregate_qo, provider_qo, consumer_qo));
        assertTrue(is_file(aggregate_qo), "linked aggregate .qo: " + link_out);
        assertTrue(is_file(map_path), "wrote link map: " + link_out);

        string link_map = File::readTextFile(map_path);
        assertTrue(link_map.find("\"target_kind\": \"constructor\"") != -1,
            "link map records a constructor relocation: " + link_map);
        assertTrue(link_map.find("\"path\": \"AOTCtorRelocProvider::constructor(int)\"") != -1,
            "link map records the constructor relocation path: " + link_map);
        assertTrue(link_map.find("\"provider_kind\": \"constructor\"") != -1,
            "link map resolves against a constructor provider: " + link_map);
        assertTrue(link_map.find("\"resolution\": \"resolved\"") != -1,
            "link map resolves the constructor relocation: " + link_map);
        assertTrue(link_map.find("\"unresolved\": 0") != -1,
            "link map has no unresolved call relocations: " + link_map);

        string strict_link_out = run(sprintf(
            "%s --link-qo --strict-call-relocations --aggregate-symbol=AOT_CTOR_RELOC_STRICT_TEST"
            " --qolink-map=%s -o %s %s %s",
            qcc_bin, strict_map_path, strict_aggregate_qo, provider_qo, consumer_qo));
        assertTrue(is_file(strict_aggregate_qo), "strict qo-link succeeds with provider: " + strict_link_out);
        assertTrue(is_file(strict_map_path), "strict qo-link writes link map: " + strict_link_out);

        string missing_provider_out = run(sprintf(
            "%s --link-qo --strict-call-relocations --aggregate-symbol=AOT_CTOR_RELOC_MISSING_TEST"
            " --qolink-map=%s -o %s %s",
            qcc_bin, missing_map_path, missing_aggregate_qo, consumer_qo));
        assertTrue(!is_file(missing_aggregate_qo),
            "strict qo-link fails without constructor provider: " + missing_provider_out);
        assertTrue(missing_provider_out.find("unresolved call relocation") != -1,
            "strict qo-link reports unresolved call relocation: " + missing_provider_out);
        assertTrue(missing_provider_out.find("AOTCtorRelocProvider::constructor(int)") != -1,
            "strict qo-link diagnostic names missing constructor: " + missing_provider_out);
    }

    testStandaloneInheritedConstructorPreload() {
        TmpDir tmp("qore-aot-base-ctor-preload-");
        string tmp_dir = tmp.path;
        string lib_dir = tmp_dir + "/aotlib";
        mkdir(lib_dir);

        string base_src = tmp_dir + "/base.qc";
        string derived_src = tmp_dir + "/derived.qc";
        string main_src = tmp_dir + "/main.qr";
        string base_qo = lib_dir + "/base.qo";
        string derived_qo = lib_dir + "/derived.qo";
        string main_qo = lib_dir + "/main.qo";
        string app = tmp_dir + "/base-ctor-preload";

        write(base_src, "%new-style
public class AOTBaseCtorLinkBase {
    private {
        string value;
    }

    constructor(string n_value) {
        value = n_value;
    }

    string getValue() {
        return value;
    }
}
");
        write(derived_src, "%new-style
public class AOTBaseCtorLinkDerived inherits AOTBaseCtorLinkBase {
    constructor(string value) : AOTBaseCtorLinkBase(value) {
    }
}
");
        write(main_src, "%new-style
const object<AOTBaseCtorLinkDerived> AOTBaseCtorLinkObj = new AOTBaseCtorLinkDerived(\"ok\");

int sub main() {
    printf(\"%s\\n\", AOTBaseCtorLinkObj.getValue());
    return 0;
}

main();
");

        string env = sprintf("LD_LIBRARY_PATH=%s QORE_LIBDIR=%s", libqore_dir, libqore_dir);
        string base_out = run(sprintf("%s %s -c -L %s --parse-option=PO_MODERN -o %s %s",
            env, qcc_bin, lib_dir, base_qo, base_src));
        assertTrue(is_file(base_qo), "compiled base .qo: " + base_out);

        string derived_out = run(sprintf("%s %s -c -L %s --parse-option=PO_MODERN -o %s %s",
            env, qcc_bin, lib_dir, derived_qo, derived_src));
        assertTrue(is_file(derived_qo), "compiled derived .qo: " + derived_out);

        string derived_index = run(sprintf("%s --dump-index-json %s", qcc_bin, derived_qo));
        assertTrue(derived_index.find("AOTBaseCtorLinkBase::constructor(string)") != -1,
            "derived index records explicit base-constructor dependency: " + derived_index);
        assertTrue(derived_index.find("\"kind\": \"constructor\"") != -1,
            "derived index marks the base-constructor dependency as a constructor: " + derived_index);

        string main_out = run(sprintf("%s %s -c -L %s --parse-option=PO_MODERN -o %s %s",
            env, qcc_bin, lib_dir, main_qo, main_src));
        assertEq(-1, main_out.find("RUNTIME-OVERLOAD-ERROR"),
            "main compile does not fall back to the base default constructor: " + main_out);
        assertEq(-1, main_out.find("AOT-PENDING-FUNCTION"),
            "main compile defers constants that instantiate a preloaded sibling: " + main_out);
        assertTrue(is_file(main_qo), "compiled main .qo: " + main_out);

        string link_out = run(sprintf("%s %s -o %s %s %s %s",
            env, qcc_bin, app, base_qo, derived_qo, main_qo));
        assertTrue(is_file(app), "linked inherited constructor executable: " + link_out);

        string out = run(sprintf("%s %s", env, app));
        assertEq("ok\n", out, "linked executable initializes the deferred constant: " + out);
    }
}
