#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil

%exec-class CMakeBuildHelpersTest

class CMakeBuildHelpersTest inherits QUnit::Test {
    private {
        string qore_bin;
        string qore_build_dir;
        *string qore_dir;
    }

    constructor() : QUnit::Test("CMakeBuildHelpersTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        qore_build_dir = realpath(ENV.QORE_BUILD_DIR ?? ENV.QORE_LIBDIR
            ?? (ENV.LIBQORE_BINARY ? dirname(ENV.LIBQORE_BINARY) : dirname(qore_bin)));
        qore_dir = qore_build_dir + "/cmake";
        if (!is_file(qore_dir + "/QoreConfig.cmake")
                && is_file(qore_dir + "/Qore/QoreConfig.cmake")) {
            qore_dir += "/Qore";
        }
        if (!is_file(qore_dir + "/QoreConfig.cmake")) {
            qore_dir = NOTHING;
        }

        addTestCase("exported Qore CMake build helpers", \testExportedHelpers());
        addTestCase("generic qcc object helper builds standalone .qo files",
            \testGenericQccObjectHelpers());
        addTestCase("managed qcc outputs prune stale artifacts safely",
            \testManagedQccOutputPruning());

        set_return_value(main());
    }

    private string run(string cmd) {
        return backquote(cmd + " 2>&1");
    }

    private write(string path, string body) {
        File f();
        f.open2(path, O_WRONLY | O_CREAT | O_TRUNC);
        f.write(body);
        f.close();
    }

    private string read(string path) {
        return ReadOnlyFile::readTextFile(path) ?? "";
    }

    private date mtime(string path) {
        hash<auto> info = hstat(path);
        return info.mtime;
    }

    testExportedHelpers() {
        TmpDir tmp("qore-cmake-build-helpers-");
        string src_dir = tmp.path + "/src";
        string build_dir = tmp.path + "/build";
        mkdir(src_dir);

        string input = src_dir + "/input.txt";
        string cmakelists = src_dir + "/CMakeLists.txt";
        write(input, "stable content\n");
        write(cmakelists,
"cmake_minimum_required(VERSION 3.5)
project(QoreCMakeHelperSmoke NONE)
find_package(Qore REQUIRED)

set(INPUT_FILE \"${CMAKE_SOURCE_DIR}/input.txt\")
set(DIGEST_FILE \"${CMAKE_BINARY_DIR}/input.sha256\")
qore_content_digest_target(input-digest
    OUTPUT \"${DIGEST_FILE}\"
    INPUTS \"${INPUT_FILE}\")

qore_get_qcc_command(QCC_CMD)
qore_get_qcc_deps(QCC_DEPS QCC_COMMAND \"${QCC_CMD}\")
qore_qcc_sidecar_paths(\"${CMAKE_BINARY_DIR}/sample.qo\"
    DEPFILE SAMPLE_DEPFILE
    INDEX_JSON SAMPLE_INDEX
    STATUS_JSON SAMPLE_STATUS
    SUCCESS_STAMP SAMPLE_STAMP
    CONTENT_STAMP SAMPLE_CONTENT_STAMP
    COMPILE_CONTRACT_STAMP SAMPLE_COMPILE_CONTRACT_STAMP
    MANIFEST_JSON SAMPLE_MANIFEST)
qore_qcc_sidecar_flags(SAMPLE_FLAGS \"${CMAKE_BINARY_DIR}/sample.qo\" ALL)
file(WRITE \"${CMAKE_BINARY_DIR}/helper-vars.txt\"
    \"qcc=${QCC_CMD}\\n\"
    \"deps=${QCC_DEPS}\\n\"
    \"depfile=${SAMPLE_DEPFILE}\\n\"
    \"status=${SAMPLE_STATUS}\\n\"
    \"compile_contract_stamp=${SAMPLE_COMPILE_CONTRACT_STAMP}\\n\"
    \"flags=${SAMPLE_FLAGS}\\n\")
");

        string configure = run(sprintf("cd %s && cmake -S . -B %s%s",
            src_dir, build_dir, qore_dir ? " -DQore_DIR=" + qore_dir : ""));
        assertTrue(is_file(build_dir + "/helper-vars.txt"),
            "configured with Qore package: " + configure);

        string vars = read(build_dir + "/helper-vars.txt");
        assertTrue(vars.find("qcc=") != -1, "qcc command exported: " + vars);
        assertTrue(vars.find("qcc-format.stamp") != -1,
            "qcc deps use semantic format stamp: " + vars);
        string qcc_format = read(qore_build_dir + "/qcc-format.stamp");
        assertTrue(qcc_format.find("format=1\n") == 0
                && qcc_format.find("QoreAOT.cpp") != -1,
            "qcc format stamp contains a deterministic codegen fingerprint: " + qcc_format);
        assertEq(-1, vars.find("deps=" + qore_build_dir + "/qcc\n"),
            "qcc deps do not mtime-track qcc when format stamp is available: " + vars);
        assertTrue(vars.find("depfile=" + build_dir + "/sample.qo.d") != -1,
            "sidecar depfile path exported: " + vars);
        assertTrue(vars.find("--content-stamp=" + build_dir + "/sample.qo.content.stamp") != -1,
            "sidecar content-stamp flag exported: " + vars);
        assertTrue(vars.find("--compile-contract-stamp="
                + build_dir + "/sample.qo.compile-contract.stamp") != -1,
            "sidecar compile-contract flag exported: " + vars);
        assertTrue(vars.find("--depfile-compile-contract-stamps") != -1,
            "sidecar compile-contract dependency flag exported: " + vars);
        assertTrue(vars.find("--skip-if-manifest-current") != -1,
            "sidecar manifest skip flag exported: " + vars);

        string build1 = run(sprintf("cmake --build %s --target input-digest", build_dir));
        assertTrue(is_file(build_dir + "/input.sha256"),
            "content digest target built: " + build1);
        string digest1 = read(build_dir + "/input.sha256");
        assertTrue(digest1.find("format=1\n") == 0, "digest has stable format header: " + digest1);
        assertTrue(digest1.find("input.txt") != -1, "digest names input: " + digest1);

        write(input, "stable content\n");
        string build2 = run(sprintf("cmake --build %s --target input-digest", build_dir));
        assertEq(digest1, read(build_dir + "/input.sha256"),
            "same-content rebuild does not change digest content: " + build2);

        write(input, "changed content\n");
        string build3 = run(sprintf("cmake --build %s --target input-digest", build_dir));
        assertNeq(digest1, read(build_dir + "/input.sha256"),
            "changed content updates digest: " + build3);
    }

    testGenericQccObjectHelpers() {
        TmpDir tmp("qore-cmake-qcc-helpers-");
        string src_dir = tmp.path + "/src";
        string build_dir = tmp.path + "/build";
        string snippets_dir = src_dir + "/srcs";
        mkdir(src_dir);
        mkdir(snippets_dir);

        string provider = snippets_dir + "/provider.qc";
        string consumer = snippets_dir + "/consumer.qc";
        string base = snippets_dir + "/base.qc";
        string child = snippets_dir + "/child.qc";
        string default_target = snippets_dir + "/defaulttarget.qc";
        string default_holder = snippets_dir + "/defaultholder.qc";
        string hashdecl_provider = snippets_dir + "/hashdeclprovider.qc";
        string hashdecl_consumer = snippets_dir + "/hashdeclconsumer.qc";
        string status_provider = snippets_dir + "/statusprovider.qc";
        string status_holder = snippets_dir + "/statusholder.qc";
        string enum_provider = snippets_dir + "/enumprovider.qc";
        string enum_consumer = snippets_dir + "/enumconsumer.qc";
        string callref_provider = snippets_dir + "/callrefprovider.qc";
        string callref_consumer = snippets_dir + "/callrefconsumer.qc";
        string constinit_provider = snippets_dir + "/constinitprovider.qc";
        string constinit_consumer = snippets_dir + "/constinitconsumer.qc";
        string const_hashdecl_provider = snippets_dir + "/consthashdeclprovider.qc";
        string const_hashdecl_consumer = snippets_dir + "/consthashdeclconsumer.qc";
        string global_provider = snippets_dir + "/globalprovider.qc";
        string global_consumer = snippets_dir + "/globalconsumer.qc";
        string entry = snippets_dir + "/entry.qc";
        string source_runner = src_dir + "/source-runner.qr";
        string host = src_dir + "/host.cpp";
        string late_object_module = src_dir + "/LateObjectModule.qm";
        string late_aggregate_module = src_dir + "/LateAggregateModule.qm";
        write(provider,
"%new-style
class CMakeQoProvider {
    public {
        const StaticConst = \"provider\";
        static string StaticText = \"state\";
    }
    constructor() {}
    static string label() { return StaticConst + \":\" + StaticText; }
    string get() { return label(); }
}
string sub cmakeQoFreeFunction() { return CMakeQoProvider::label(); }
");
        write(consumer,
"%new-style
class CMakeQoConsumer {
    string run() {
        object p = new CMakeQoProvider();
        return p.get() + \":\" + CMakeQoProvider::StaticConst + \":\" + CMakeQoProvider::StaticText
            + \":\" + CMakeQoProvider::label() + \":\" + cmakeQoFreeFunction();
    }
}
");
        write(base,
"%new-style
class CMakeQoBase {
    string base() { return \"base\"; }
}
");
        write(child,
"%new-style
class CMakeQoChild inherits CMakeQoBase {
    string child() { return base(); }
}
");
        write(default_target,
"%new-style
class CMakeQoDefaultTarget {
}
");
        write(default_holder,
"%new-style
class CMakeQoDefaultHolder {
    private {
        CMakeQoDefaultTarget target();
    }
}
");
        write(hashdecl_provider,
"%new-style
hashdecl CMakeQoHashInfo {
    string label;
}
");
        write(hashdecl_consumer,
"%new-style
class CMakeQoHashConsumer {
    hash<CMakeQoHashInfo> get() {
        return new hash<CMakeQoHashInfo>({\"label\": \"hash\"});
    }
}
");
        write(status_provider,
"%new-style
hashdecl CMakeQoStatus {
    string status = \"queued\";
}
");
        write(status_holder,
"%new-style
class CMakeQoStatusHolder {
    private {
        hash<CMakeQoStatus> status();
    }
}
");
        write(enum_provider,
"%new-style
public enum CMakeQoMode : string {
    Fast = \"fast\",
    Slow = \"slow\",
}
");
        write(enum_consumer,
"%new-style
class CMakeQoEnumConsumer {
    enum<CMakeQoMode> get() {
        enum<CMakeQoMode> mode = CMakeQoMode::Slow;
        switch (mode) {
            case CMakeQoMode::Fast:
                return CMakeQoMode::Fast;
            default:
                return mode;
        }
    }
}
");
        write(callref_provider,
"%new-style
string sub cmakeQoCallRefFunction() { return \"callref\"; }
");
        write(callref_consumer,
"%new-style
class CMakeQoCallRefConsumer {
    callref get() {
        return \\cmakeQoCallRefFunction();
    }
}
");
        write(constinit_provider,
"%new-style
class CMakeQoConstInitProvider {
    static int limit() { return 42; }
}
");
        write(constinit_consumer,
"%new-style
class CMakeQoConstInitConsumer {
    public {
        const Limit = CMakeQoConstInitProvider::limit();
    }
}
");
        write(const_hashdecl_provider,
"%new-style
hashdecl CMakeQoConstHashInfo {
    string value;
}
");
        write(const_hashdecl_consumer,
"%new-style
class CMakeQoConstHashConsumer {
    public {
        const Values = (
            <CMakeQoConstHashInfo>{\"value\": \"const\"}
        );
    }
}
");
        write(global_provider,
"%new-style
class CMakeQoGlobalObject {
    private {
        string value;
    }
    constructor(string value) { self.value = value; }
    string get() { return value; }
}
our hash<auto> CMakeQoGlobal = {\"label\": \"global\"};
our list<string> CMakeQoGlobalOrder = ();
string sub CMakeQoRecordGlobal(string value) {
    CMakeQoGlobalOrder += value;
    return value;
}
our string CMakeQoFirst = CMakeQoRecordGlobal(\"first\");
our string CMakeQoSecond = CMakeQoRecordGlobal(\"second\");
our timeout CMakeQoTimeout = 5s;
our softint CMakeQoSoftInt = \"23\";
our *string CMakeQoOptionalString = NULL;
our CMakeQoGlobalObject CMakeQoObject(\"object\");
");
        write(global_consumer,
"%new-style
class CMakeQoGlobalConsumer {
    static string get() {
        return sprintf(\"%s:%s:%d:%d:%s:%s\", CMakeQoGlobal.label,
            CMakeQoGlobalOrder.join(\",\"), CMakeQoTimeout, CMakeQoSoftInt,
            CMakeQoOptionalString === NOTHING ? \"NOTHING\" : \"VALUE\",
            CMakeQoObject.get());
    }
}
");
        write(entry,
"%new-style
int sub main() {
    CMakeQoConsumer consumer();
    CMakeQoHashConsumer hash_consumer();
    CMakeQoEnumConsumer enum_consumer();
    CMakeQoCallRefConsumer callref_consumer();
    CMakeQoChild child();
    callref callback = callref_consumer.get();
    printf(\"%s:%s:%s:%s:%d:%s:%s:%s\\n\",
        consumer.run(), hash_consumer.get().label, enum_consumer.get(), callback(),
        CMakeQoConstInitConsumer::Limit, CMakeQoConstHashConsumer::Values.value,
        CMakeQoGlobalConsumer::get(), child.child());
    return 0;
}
");
        write(source_runner,
"%modern
%include srcs/provider.qc
%include srcs/consumer.qc
%include srcs/base.qc
%include srcs/child.qc
%include srcs/hashdeclprovider.qc
%include srcs/hashdeclconsumer.qc
%include srcs/enumprovider.qc
%include srcs/enumconsumer.qc
%include srcs/callrefprovider.qc
%include srcs/callrefconsumer.qc
%include srcs/constinitprovider.qc
%include srcs/constinitconsumer.qc
%include srcs/consthashdeclprovider.qc
%include srcs/consthashdeclconsumer.qc
%include srcs/globalprovider.qc
%include srcs/globalconsumer.qc
%include srcs/entry.qc
main();
");
        write(host,
"#include <qore/Qore.h>
#include <qore/QoreAOT.h>
#include <stdio.h>

extern \"C\" void init_QORE_CMAKE_SCRIPT_SMOKE_qo(QoreProgram*);

int main(int, char**) {
    qore_init(QL_GPL, \"UTF-8\", true);
    QoreProgram* pgm = qore_create_program(PO_NEW_STYLE | PO_STRICT_ARGS);
    if (!pgm) {
        qore_cleanup();
        return 1;
    }
    qore_aot_script_begin_batch(pgm);
    init_QORE_CMAKE_SCRIPT_SMOKE_qo(pgm);
    int rc = qore_aot_script_end_batch(pgm);
    if (!rc) {
        rc = qore_run_callable(pgm, \"main\", nullptr);
    }
    if (rc) {
        fprintf(stderr, \"AOT host failed rc=%d: %s\\n\", rc, qore_last_error(pgm));
    }
    qore_destroy_program(pgm);
    qore_cleanup();
    return rc;
}
");
        write(late_object_module,
"%new-style
module LateObjectModule {
    version = \"1.0\";
    desc = \"late-defined qcc object dependency\";
    author = \"Qore\";
}
");
        write(late_aggregate_module,
"%new-style
module LateAggregateModule {
    version = \"1.0\";
    desc = \"late-defined qcc aggregate dependency\";
    author = \"Qore\";
}
");

        write(src_dir + "/CMakeLists.txt",
"cmake_minimum_required(VERSION 3.16)
project(QoreQoHelperSmoke CXX)
find_package(Qore REQUIRED)

set(LATE_MODULE_DIR \"${CMAKE_BINARY_DIR}/late-modules\")
set(QORE_QCC_MODULE_PATH \"${QORE_BUILDTREE_USER_MODULE_PATH}\")
if(NOT QORE_QCC_MODULE_PATH)
    set(QORE_QCC_MODULE_PATH \"${QORE_MODULES_DIR}\")
endif()
set(QORE_QCC_MODULE_PATH \"${LATE_MODULE_DIR}:${QORE_QCC_MODULE_PATH}\")

set(QO_SOURCES
    \"${CMAKE_SOURCE_DIR}/srcs/provider.qc\"
    \"${CMAKE_SOURCE_DIR}/srcs/consumer.qc\"
    \"${CMAKE_SOURCE_DIR}/srcs/base.qc\"
    \"${CMAKE_SOURCE_DIR}/srcs/child.qc\"
    \"${CMAKE_SOURCE_DIR}/srcs/defaulttarget.qc\"
    \"${CMAKE_SOURCE_DIR}/srcs/defaultholder.qc\"
    \"${CMAKE_SOURCE_DIR}/srcs/hashdeclprovider.qc\"
    \"${CMAKE_SOURCE_DIR}/srcs/hashdeclconsumer.qc\"
    \"${CMAKE_SOURCE_DIR}/srcs/statusprovider.qc\"
    \"${CMAKE_SOURCE_DIR}/srcs/statusholder.qc\"
    \"${CMAKE_SOURCE_DIR}/srcs/enumprovider.qc\"
    \"${CMAKE_SOURCE_DIR}/srcs/enumconsumer.qc\"
    \"${CMAKE_SOURCE_DIR}/srcs/callrefprovider.qc\"
    \"${CMAKE_SOURCE_DIR}/srcs/callrefconsumer.qc\"
    \"${CMAKE_SOURCE_DIR}/srcs/constinitprovider.qc\"
    \"${CMAKE_SOURCE_DIR}/srcs/constinitconsumer.qc\"
    \"${CMAKE_SOURCE_DIR}/srcs/consthashdeclprovider.qc\"
    \"${CMAKE_SOURCE_DIR}/srcs/consthashdeclconsumer.qc\"
    \"${CMAKE_SOURCE_DIR}/srcs/globalprovider.qc\"
    \"${CMAKE_SOURCE_DIR}/srcs/globalconsumer.qc\"
    \"${CMAKE_SOURCE_DIR}/srcs/entry.qc\")

set(QO_SCRIPT_AGG_OUTPUT \"${CMAKE_BINARY_DIR}/script-aggregate.qo\")
set(QO_SCRIPT_AGG_CONTEXT
    \"${QO_SCRIPT_AGG_OUTPUT}.script-aggregate-context\")

qore_qcc_compile_objects(QO_OBJECTS
    GROUP cmake-smoke
    OUTPUT_DIR \"${CMAKE_BINARY_DIR}/qo\"
    SCRIPT_DIR \"${CMAKE_BINARY_DIR}/qo-scripts\"
    INCLUDE_DIR \"${QORE_INCLUDE_DIR}\"
    MODULE_DIR \"${QORE_QCC_MODULE_PATH}\"
    SOURCES ${QO_SOURCES}
    LOAD_MODULES LateObjectModule LateAggregateModule
    PARSE_OPTIONS PO_MODERN
    WARNINGS_ARE_ERRORS
    STAMPS_VAR QO_STAMPS
    CONTENT_STAMPS_VAR QO_CONTENT_STAMPS
    COMPILE_CONTRACT_STAMPS_VAR QO_COMPILE_CONTRACT_STAMPS
    ORDER_TARGETS_VAR QO_ORDER_TARGETS
    CONTEXT_VAR QO_CONTEXT
    BOOTSTRAP_AGGREGATE_OUTPUT \"${QO_SCRIPT_AGG_OUTPUT}\"
    BOOTSTRAP_AGGREGATE_SYMBOL QORE_CMAKE_SCRIPT_SMOKE
    BOOTSTRAP_AGGREGATE_CONTEXT \"${QO_SCRIPT_AGG_CONTEXT}\"
    BOOTSTRAP_AGGREGATE_NATIVE_REGISTERS)
add_custom_target(qo-objects ALL DEPENDS ${QO_STAMPS})

qore_qcc_link_objects(QO_LINK
    OUTPUT \"${CMAKE_BINARY_DIR}/linked.qo\"
    AGGREGATE_SYMBOL QORE_CMAKE_QO_SMOKE
    INPUTS ${QO_OBJECTS}
    INPUT_CONTENT_STAMPS ${QO_CONTENT_STAMPS}
    INPUT_ORDER_TARGETS ${QO_ORDER_TARGETS}
    WARNINGS_ARE_ERRORS
    STAMP_VAR QO_LINK_STAMP
    LINK_MAP_VAR QO_LINK_MAP)
add_custom_target(qo-link ALL DEPENDS ${QO_LINK_STAMP})

qore_qcc_script_aggregate(QO_SCRIPT_AGG
    OUTPUT \"${QO_SCRIPT_AGG_OUTPUT}\"
    AGGREGATE QORE_CMAKE_SCRIPT_SMOKE
    MODULE_DIR \"${QORE_QCC_MODULE_PATH}\"
    SOURCES ${QO_SOURCES}
    INPUT_CONTENT_STAMPS ${QO_CONTENT_STAMPS}
    INPUT_ORDER_TARGETS ${QO_ORDER_TARGETS}
    LOAD_MODULES LateObjectModule LateAggregateModule
    PARSE_OPTIONS PO_MODERN
    WARNINGS_ARE_ERRORS
    NATIVE_REGISTERS
    STAMP_VAR QO_SCRIPT_AGG_STAMP)
add_custom_target(qo-script-aggregate ALL DEPENDS ${QO_SCRIPT_AGG_STAMP})

qore_qcc_script_aggregate(QO_SCRIPT_AGG_INDEXED
    OUTPUT \"${CMAKE_BINARY_DIR}/script-aggregate-indexed.qo\"
    AGGREGATE QORE_CMAKE_SCRIPT_INDEXED_SMOKE
    MODULE_DIR \"${QORE_QCC_MODULE_PATH}\"
    SOURCES ${QO_SOURCES}
    INPUT_CONTENT_STAMPS ${QO_CONTENT_STAMPS}
    INPUT_ORDER_TARGETS ${QO_ORDER_TARGETS}
    LOAD_MODULES LateAggregateModule
    PARSE_OPTIONS PO_MODERN
    WARNINGS_ARE_ERRORS
    NATIVE_REGISTERS
    STAMP_VAR QO_SCRIPT_AGG_INDEXED_STAMP
    INDEX_JSON_VAR QO_SCRIPT_AGG_INDEX)
add_custom_target(qo-script-aggregate-indexed ALL DEPENDS ${QO_SCRIPT_AGG_INDEXED_STAMP})

qore_qcc_finalize_managed_outputs(
    OUTPUT_ROOT \"${CMAKE_BINARY_DIR}/qo\"
    SCRIPT_ROOT \"${CMAKE_BINARY_DIR}/qo-scripts\")

add_executable(qo-static-host
    \"${CMAKE_SOURCE_DIR}/host.cpp\"
    ${QO_OBJECTS}
    ${QO_SCRIPT_AGG})
add_dependencies(qo-static-host qo-objects qo-script-aggregate)
target_include_directories(qo-static-host PRIVATE ${QORE_INCLUDE_DIRS})
target_link_libraries(qo-static-host PRIVATE ${QORE_LIBRARIES})

set(LATE_OBJECT_QMOD \"${LATE_MODULE_DIR}/LateObjectModule.qmod\")
add_custom_command(
    OUTPUT \"${LATE_OBJECT_QMOD}\"
    COMMAND \"${CMAKE_COMMAND}\" -E make_directory \"${LATE_MODULE_DIR}\"
    COMMAND \"${QORE_QCC_EXECUTABLE}\" --warnings-are-errors -m
        \"${CMAKE_SOURCE_DIR}/LateObjectModule.qm\" -o \"${LATE_OBJECT_QMOD}\"
    DEPENDS \"${CMAKE_SOURCE_DIR}/LateObjectModule.qm\"
    VERBATIM)
add_custom_target(LateObjectModule-qmod DEPENDS \"${LATE_OBJECT_QMOD}\")

set(LATE_AGGREGATE_QMOD \"${LATE_MODULE_DIR}/LateAggregateModule.qmod\")
add_custom_command(
    OUTPUT \"${LATE_AGGREGATE_QMOD}\"
    COMMAND \"${CMAKE_COMMAND}\" -E make_directory \"${LATE_MODULE_DIR}\"
    COMMAND \"${QORE_QCC_EXECUTABLE}\" --warnings-are-errors -m
        \"${CMAKE_SOURCE_DIR}/LateAggregateModule.qm\" -o \"${LATE_AGGREGATE_QMOD}\"
    DEPENDS \"${CMAKE_SOURCE_DIR}/LateAggregateModule.qm\"
    VERBATIM)
add_custom_target(LateAggregateModule-qmod DEPENDS \"${LATE_AGGREGATE_QMOD}\")

file(WRITE \"${CMAKE_BINARY_DIR}/qo-vars.txt\"
    \"objects=${QO_OBJECTS}\\n\"
    \"stamps=${QO_STAMPS}\\n\"
    \"content_stamps=${QO_CONTENT_STAMPS}\\n\"
    \"compile_contract_stamps=${QO_COMPILE_CONTRACT_STAMPS}\\n\"
    \"order_targets=${QO_ORDER_TARGETS}\\n\"
    \"context=${QO_CONTEXT}\\n\"
    \"link=${QO_LINK}\\n\"
    \"link_stamp=${QO_LINK_STAMP}\\n\"
    \"link_map=${QO_LINK_MAP}\\n\"
    \"script_aggregate=${QO_SCRIPT_AGG}\\n\"
    \"script_aggregate_stamp=${QO_SCRIPT_AGG_STAMP}\\n\"
    \"script_aggregate_index=${QO_SCRIPT_AGG_INDEX}\\n\")
file(WRITE \"${CMAKE_BINARY_DIR}/qo-objects.txt\" \"${QO_OBJECTS}\")
");

        string configure = run(sprintf("cd %s && cmake -S . -B %s%s",
            src_dir, build_dir, qore_dir ? " -DQore_DIR=" + qore_dir : ""));
        assertTrue(is_file(build_dir + "/qo-vars.txt"),
            "configured generic qcc helper project: " + configure);
        assertTrue(read(build_dir + "/qo-vars.txt").find(
                ".qo.compile-contract.stamp") != -1,
            "qcc object helper exports compile-contract stamps");

        string direct = read(build_dir + "/qo-scripts/direct-deps.cmake");
        assertTrue(direct.regex("set\\(QORE_QCC_DIRECT_DEPS_cmake_smoke_1 \"\"\\)"),
            "linkable provider references do not become consumer build deps: " + direct);
        assertTrue(direct.regex("QORE_QCC_DIRECT_DEPS_cmake_smoke_3.*base_qc\\.qo"),
            "inheritance remains a source-scanned build prerequisite: " + direct);
        assertTrue(direct.regex("set\\(QORE_QCC_DIRECT_DEPS_cmake_smoke_5 \"\"\\)"),
            "constructed class member defaults remain linkable: " + direct);
        assertTrue(direct.regex("set\\(QORE_QCC_DIRECT_DEPS_cmake_smoke_7 \"\"\\)"),
            "new hash<HashDecl> constructors remain linkable: " + direct);
        assertTrue(direct.regex("set\\(QORE_QCC_DIRECT_DEPS_cmake_smoke_9 \"\"\\)"),
            "constructed typed-hash defaults remain linkable: " + direct);
        assertTrue(direct.regex("QORE_QCC_DIRECT_DEPS_cmake_smoke_11.*enumprovider_qc\\.qo"),
            "enum annotations and members become source-scanned build prerequisites: " + direct);
        assertTrue(direct.regex("QORE_QCC_DIRECT_DEPS_cmake_smoke_13.*callrefprovider_qc\\.qo"),
            "function call references become source-scanned build prerequisites: " + direct);
        assertTrue(direct.regex("set\\(QORE_QCC_DIRECT_DEPS_cmake_smoke_15 \"\"\\)"),
            "static calls in constant initializers remain source-deferred callable imports: " + direct);
        assertTrue(direct.regex("QORE_QCC_DIRECT_DEPS_cmake_smoke_17.*consthashdeclprovider_qc\\.qo"),
            "typed-hash constructors in constant initializers become source-scanned build prerequisites: " + direct);

        string initial_provider = read(provider);
        write(provider, replace(initial_provider,
            "return StaticConst + \":\" + StaticText;",
            "return \"transient-bootstrap\";"));
        string bootstrap_replacement = src_dir + "/bootstrap-provider-replacement.qc";
        string bootstrap_validation_marker = build_dir
            + "/qcc-bootstrap-input-validation.marker";
        write(bootstrap_replacement, initial_provider);
        string build1 = run(sprintf(
            "(i=0; while [ ! -f %s ] && [ $i -lt 500 ]; do sleep 0.01; i=$((i + 1)); done; "
            "[ -f %s ] && cp %s %s) & watcher=$!; "
            "QORE_QCC_TEST_INPUT_VALIDATION_MARKER=%s "
            "QORE_QCC_TEST_INPUT_VALIDATION_SOURCE=%s "
            "QORE_QCC_TEST_INPUT_VALIDATION_DELAY_MS=500 "
            "cmake --build %s -- -j33; rc=$?; wait $watcher || rc=$?; exit $rc",
            bootstrap_validation_marker, bootstrap_validation_marker,
            bootstrap_replacement, provider, bootstrap_validation_marker,
            provider, build_dir));
        assertTrue(build1.find("batch bootstrapping cmake-smoke (21 sources)") != -1,
            "clean object-group build uses one shared-parse batch bootstrap: " + build1);
        assertTrue(build1.find(
                "qcc batch input changed during compilation; retrying (2/3)") != -1,
            "source edit during batch publication retries the shared parse: " + build1);
        assertTrue(build1.find("script aggregate .qo") != -1,
            "clean object-group build emits its script aggregate during bootstrap: " + build1);
        assertEq(-1, build1.find("qcc --script-aggregate: QORE_CMAKE_SCRIPT_SMOKE"),
            "standalone aggregate rule adopts the fused output without running: " + build1);
        assertTrue(is_file(build_dir + "/linked.qo"), "linked .qo aggregate built: " + build1);
        assertTrue(is_file(build_dir + "/linked.qo.qolink.json"),
            "linked .qo map built: " + build1);
        assertTrue(is_file(build_dir + "/script-aggregate.qo"),
            "script aggregate .qo built: " + build1);
        assertFalse(is_file(build_dir + "/script-aggregate.qo.idx.json"),
            "script aggregate omits the optional index sidecar by default: " + build1);
        assertTrue(is_file(build_dir + "/script-aggregate-indexed.qo.idx.json"),
            "script aggregate writes the requested index sidecar: " + build1);
        assertTrue(read(build_dir + "/qo-vars.txt").find(
                "script_aggregate_index=" + build_dir + "/script-aggregate-indexed.qo.idx.json") != -1,
            "script aggregate helper exports the requested index path");
        write(build_dir + "/script-aggregate.qo.idx.json", "legacy index\n");
        string reconfigure = run(sprintf("cd %s && cmake -S . -B %s%s",
            src_dir, build_dir, qore_dir ? " -DQore_DIR=" + qore_dir : ""));
        assertFalse(is_file(build_dir + "/script-aggregate.qo.idx.json"),
            "script aggregate helper removes an unrequested legacy index: " + reconfigure);
        string rebuilt_direct = read(build_dir + "/qo-scripts/direct-deps.cmake");
        assertTrue(rebuilt_direct.regex(
                "QORE_QCC_DIRECT_DEPS_cmake_smoke_1.*provider_qc\\.qo"),
            "native-body depfiles order an unqualified function provider before its consumer: "
                + rebuilt_direct);
        assertTrue(is_file(build_dir + "/late-modules/LateObjectModule.qmod"),
            "late-defined object module dependency built: " + build1);
        assertTrue(is_file(build_dir + "/late-modules/LateAggregateModule.qmod"),
            "late-defined aggregate module dependency built: " + build1);
        assertTrue(is_file(build_dir + "/qo-static-host"),
            "static AOT host linked from per-file and aggregate objects: " + build1);
        string source_qore = realpath(qore_bin) ?? qore_bin;
        string source_out = run(sprintf("cd %s && %s %s", src_dir, source_qore, source_runner));
        string static_out = run(sprintf("LD_LIBRARY_PATH=%s QORE_MODULE_DIR=%s %s",
            qore_build_dir, build_dir + "/late-modules", build_dir + "/qo-static-host"));
        assertEq("provider:state:provider:state:provider:state:provider:state:hash:slow:callref:42:const:global:first,second:5000:23:NOTHING:object:base\n",
            source_out, "source-mode fixture output");
        assertEq(source_out, static_out,
            "statically linked AOT aggregate is load-equivalent to parsed source");
        string source_symbols = read(build_dir + "/qo-scripts/source-symbols.manifest");
        assertTrue(source_symbols.find("class\tCMakeQoProvider\t") != -1
                && source_symbols.find("function\tcmakeQoFreeFunction\t") != -1
                && source_symbols.find("function\tcmakeQoCallRefFunction\t") != -1,
            "qcc object helper writes a source-symbol manifest: " + source_symbols);

        string link_map = read(build_dir + "/linked.qo.qolink.json");
        assertTrue(link_map.find("\"resolution\": \"resolved\"") != -1,
            "qo-link map resolves standalone imports: " + link_map);
        assertTrue(link_map.find("CMakeQoProvider::label") != -1,
            "qo-link map records static method resolution: " + link_map);
        assertTrue(link_map.find("CMakeQoGlobal") != -1,
            "qo-link map records cross-file global resolution: " + link_map);

        string bootstrap_stamp = build_dir + "/qo-scripts/.qcc-batch-bootstrap.stamp";
        unlink(bootstrap_stamp);
        string adopted = run(sprintf("cmake --build %s -- -j33", build_dir));
        assertTrue(is_file(bootstrap_stamp)
                && adopted.find("qcc: script-context .qo") == -1,
            "existing current object tree is adopted without recompiling the batch: " + adopted);

        unlink(bootstrap_stamp);
        write(provider, read(provider) + "# force stale-tree detection\n");
        string stale_adoption = run(sprintf("cmake --build %s -- -j33", build_dir));
        assertTrue(stale_adoption.find("qcc: script-context .qo") != -1,
            "existing stale object tree is batch rebuilt instead of adopted: " + stale_adoption);

        string no_op = run(sprintf("cmake --build %s -- -j33", build_dir));
        assertTrue(no_op.find("qcc -c:") == -1
                && no_op.find("qcc: scanning") == -1
                && no_op.find("qcc --link-qo:") == -1
                && no_op.find("qcc --script-aggregate:") == -1,
            "no-op rebuild does not rerun qcc helper targets: " + no_op);

        list<string> object_paths = trim(read(build_dir + "/qo-objects.txt")).split(";");
        string consumer_object = object_paths[1];
        date batch_consumer_mtime = mtime(consumer_object);
        write(provider, read(provider) + "# compile-contract no-op\n");
        string batch_to_single = run(sprintf("cmake --build %s -- -j33", build_dir));
        assertNeq(batch_consumer_mtime, mtime(consumer_object),
            "batch-to-single contract transition revalidates the unqualified caller: "
                + batch_to_single);

        date consumer_mtime = mtime(consumer_object);
        write(provider, read(provider) + "# second compile-contract no-op\n");
        string semantic_no_op = run(sprintf("cmake --build %s -- -j33", build_dir));
        assertEq(consumer_mtime, mtime(consumer_object),
            "steady-state comment-only provider edit preserves the consumer object: "
                + semantic_no_op);

        string transient_provider = replace(read(provider),
            "return CMakeQoProvider::label();",
            "return \"transient-body\";");
        string final_provider = replace(transient_provider,
            "return \"transient-body\";", "return \"changed-body\";");
        write(provider, transient_provider);
        string replacement = src_dir + "/provider-replacement.qc";
        string validation_marker = build_dir + "/qcc-input-validation.marker";
        write(replacement, final_provider);
        string contract_change = run(sprintf(
            "(i=0; while [ ! -f %s ] && [ $i -lt 500 ]; do sleep 0.01; i=$((i + 1)); done; "
            "[ -f %s ] && cp %s %s) & watcher=$!; "
            "QORE_QCC_TEST_INPUT_VALIDATION_MARKER=%s "
            "QORE_QCC_TEST_INPUT_VALIDATION_SOURCE=%s "
            "QORE_QCC_TEST_INPUT_VALIDATION_DELAY_MS=500 "
            "cmake --build %s -- -j33; rc=$?; wait $watcher || rc=$?; exit $rc",
            validation_marker, validation_marker, replacement, provider,
            validation_marker, provider, build_dir));
        assertTrue(contract_change.find("provider.qc") != -1,
            "provider body change runs the precise incremental path: "
                + contract_change);
        assertTrue(contract_change.find("qcc input changed during compilation; retrying (2/3)") != -1,
            "provider edit during qcc publication is retried in the same build: "
                + contract_change);
        string changed_source_out = run(sprintf("cd %s && %s %s",
            src_dir, source_qore, source_runner));
        string changed_static_out = run(sprintf("LD_LIBRARY_PATH=%s QORE_MODULE_DIR=%s %s",
            qore_build_dir, build_dir + "/late-modules", build_dir + "/qo-static-host"));
        assertEq(changed_source_out, changed_static_out,
            "one-pass native-body incremental rebuild remains load-equivalent");

        string link_content_stamp = read(build_dir + "/linked.qo.content.stamp");
        string provider_body = read(provider);
        write(provider, provider_body);
        string same_content = run(sprintf("cmake --build %s -- -j33", build_dir));
        assertEq(link_content_stamp, read(build_dir + "/linked.qo.content.stamp"),
            "same-content source mtime rebuild does not relink aggregate: " + same_content);
    }

    testManagedQccOutputPruning() {
        TmpDir tmp("qore-cmake-qcc-prune-");
        string src_dir = tmp.path + "/src";
        string build_dir = tmp.path + "/build";
        string snippets_dir = src_dir + "/srcs";
        mkdir(src_dir);
        mkdir(snippets_dir);

        string retained_source = snippets_dir + "/retained.qc";
        string removed_source = snippets_dir + "/removed.qc";
        string replacement_source = snippets_dir + "/replacement.qc";
        string group_b_source = snippets_dir + "/group-b.qc";
        write(retained_source, "%modern\npublic string sub retainedValue() { return \"retained\"; }\n");
        write(removed_source, "%modern\npublic string sub removedValue() { return \"removed\"; }\n");
        write(replacement_source,
            "%modern\npublic string sub replacementValue() { return \"replacement\"; }\n");
        write(group_b_source, "%modern\npublic string sub groupBValue() { return \"group-b\"; }\n");

        write(src_dir + "/CMakeLists.txt",
"cmake_minimum_required(VERSION 3.16)
project(QoreQoPruneSmoke NONE)
find_package(Qore REQUIRED)

set(PRUNE_SOURCE_MODE initial CACHE STRING \"source transition\")
option(ENABLE_GROUP_B \"build the second object group\" ON)
option(ENABLE_AGGREGATES \"build link and script aggregates\" ON)

set(A_SOURCES \"${CMAKE_SOURCE_DIR}/srcs/retained.qc\")
if(PRUNE_SOURCE_MODE STREQUAL \"initial\")
    list(APPEND A_SOURCES \"${CMAKE_SOURCE_DIR}/srcs/removed.qc\")
elseif(PRUNE_SOURCE_MODE STREQUAL \"replace\")
    list(APPEND A_SOURCES \"${CMAKE_SOURCE_DIR}/srcs/replacement.qc\")
elseif(NOT PRUNE_SOURCE_MODE STREQUAL \"single\")
    message(FATAL_ERROR \"unknown PRUNE_SOURCE_MODE=${PRUNE_SOURCE_MODE}\")
endif()

qore_qcc_compile_objects(A_OBJECTS
    GROUP GROUP_A
    OUTPUT_DIR \"${CMAKE_BINARY_DIR}/qo/GROUP_A\"
    SCRIPT_DIR \"${CMAKE_BINARY_DIR}/qo-scripts/GROUP_A\"
    SOURCES ${A_SOURCES}
    PARSE_OPTIONS PO_MODERN
    WARNINGS_ARE_ERRORS
    STAMPS_VAR A_STAMPS
    CONTENT_STAMPS_VAR A_CONTENT_STAMPS
    ORDER_TARGETS_VAR A_ORDER_TARGETS)
set(ALL_QO_STAMPS ${A_STAMPS})

if(ENABLE_GROUP_B)
    qore_qcc_compile_objects(B_OBJECTS
        GROUP GROUP_B
        OUTPUT_DIR \"${CMAKE_BINARY_DIR}/qo/GROUP_B\"
        SCRIPT_DIR \"${CMAKE_BINARY_DIR}/qo-scripts/GROUP_B\"
        SOURCES \"${CMAKE_SOURCE_DIR}/srcs/group-b.qc\"
        PARSE_OPTIONS PO_MODERN
        WARNINGS_ARE_ERRORS
        STAMPS_VAR B_STAMPS)
    list(APPEND ALL_QO_STAMPS ${B_STAMPS})
endif()

if(ENABLE_AGGREGATES)
    qore_qcc_link_objects(A_LINK
        OUTPUT \"${CMAKE_BINARY_DIR}/qo/GROUP_A_link/A_LINK.qo\"
        AGGREGATE_SYMBOL QORE_PRUNE_LINK
        INPUTS ${A_OBJECTS}
        INPUT_CONTENT_STAMPS ${A_CONTENT_STAMPS}
        INPUT_ORDER_TARGETS ${A_ORDER_TARGETS}
        WARNINGS_ARE_ERRORS
        STAMP_VAR A_LINK_STAMP)
    qore_qcc_script_aggregate(A_SCRIPT
        OUTPUT \"${CMAKE_BINARY_DIR}/qo/GROUP_A_script/A_SCRIPT.qo\"
        AGGREGATE QORE_PRUNE_SCRIPT
        SOURCES ${A_SOURCES}
        INPUT_CONTENT_STAMPS ${A_CONTENT_STAMPS}
        INPUT_ORDER_TARGETS ${A_ORDER_TARGETS}
        PARSE_OPTIONS PO_MODERN
        WARNINGS_ARE_ERRORS
        STAMP_VAR A_SCRIPT_STAMP)
    list(APPEND ALL_QO_STAMPS ${A_LINK_STAMP} ${A_SCRIPT_STAMP})
endif()

qore_qcc_finalize_managed_outputs(
    OUTPUT_ROOT \"${CMAKE_BINARY_DIR}/qo\"
    SCRIPT_ROOT \"${CMAKE_BINARY_DIR}/qo-scripts\")
add_custom_target(all-qo ALL DEPENDS ${ALL_QO_STAMPS})

string(REPLACE \";\" \"\\n\" A_OBJECT_LINES \"${A_OBJECTS}\")
file(WRITE \"${CMAKE_BINARY_DIR}/a-objects.txt\" \"${A_OBJECT_LINES}\\n\")
if(ENABLE_GROUP_B)
    string(REPLACE \";\" \"\\n\" B_OBJECT_LINES \"${B_OBJECTS}\")
    file(WRITE \"${CMAKE_BINARY_DIR}/b-objects.txt\" \"${B_OBJECT_LINES}\\n\")
endif()
");

        mkdir(build_dir);
        mkdir(build_dir + "/qo");
        mkdir(build_dir + "/qo/LEGACY_GROUP");
        write(build_dir + "/qo/LEGACY_GROUP/legacy.qo", "legacy\n");
        mkdir(build_dir + "/qo-scripts");
        mkdir(build_dir + "/qo-scripts/LEGACY_GROUP");
        write(build_dir + "/qo-scripts/LEGACY_GROUP/qcc-single.sh", "#!/bin/sh\n");

        string qore_arg = qore_dir ? " -DQore_DIR=" + qore_dir : "";
        string configure = run(sprintf("cmake -S %s -B %s%s", src_dir, build_dir, qore_arg));
        assertTrue(is_file(build_dir + "/.qore-qcc-managed-outputs.manifest"),
            "initial configure writes the managed-output manifest: " + configure);
        assertFalse(is_dir(build_dir + "/qo/LEGACY_GROUP")
                || is_dir(build_dir + "/qo-scripts/LEGACY_GROUP"),
            "first managed configure prunes recognized pre-manifest groups");
        string initial_build = run(sprintf("cmake --build %s -- -j17", build_dir));
        list<string> initial_a = trim(read(build_dir + "/a-objects.txt")).split("\n");
        list<string> initial_b = trim(read(build_dir + "/b-objects.txt")).split("\n");
        assertEq(2, initial_a.size(), "initial group A contains two outputs");
        assertEq(1, initial_b.size(), "initial group B contains one output");
        assertTrue(is_file(initial_a[1] + ".source-parse-defines"),
            "initial build writes the complete object sidecar family: " + initial_build);
        assertTrue(is_file(build_dir + "/qo/GROUP_A_link/A_LINK.qo.qolink-context"),
            "initial build registers link aggregate sidecars");
        assertTrue(is_file(build_dir + "/qo/GROUP_A_script/A_SCRIPT.qo.script-aggregate-context"),
            "initial build registers script aggregate sidecars");

        date retained_mtime = mtime(initial_a[0]);
        string replace_configure = run(sprintf(
            "cmake -S %s -B %s -DPRUNE_SOURCE_MODE=replace%s",
            src_dir, build_dir, qore_arg));
        list<string> replacement_a = trim(read(build_dir + "/a-objects.txt")).split("\n");
        assertEq(2, replacement_a.size(), "replacement keeps the object count unchanged");
        assertEq(initial_a[0], replacement_a[0], "replacement retains the first output identity");
        assertNeq(initial_a[1], replacement_a[1], "replacement changes the second output identity");
        foreach string suffix in ("", ".d", ".idx.json", ".status.json", ".content.stamp",
                ".compile-contract.stamp", ".stamp", ".source.manifest.json",
                ".source-parse-defines", ".lock") {
            assertFalse(is_file(initial_a[1] + suffix),
                "source replacement prunes stale artifact " + suffix + ": " + replace_configure);
        }
        assertEq(retained_mtime, mtime(initial_a[0]),
            "source replacement configuration preserves retained object timestamps");
        string replacement_build = run(sprintf("cmake --build %s -- -j17", build_dir));
        assertTrue(is_file(replacement_a[1] + ".source.manifest.json"),
            "parallel build creates the replacement object: " + replacement_build);

        date retained_after_replace = mtime(replacement_a[0]);
        string single_configure = run(sprintf(
            "cmake -S %s -B %s -DPRUNE_SOURCE_MODE=single%s",
            src_dir, build_dir, qore_arg));
        foreach string suffix in ("", ".d", ".idx.json", ".status.json", ".content.stamp",
                ".compile-contract.stamp", ".stamp", ".source.manifest.json",
                ".source-parse-defines", ".lock") {
            assertFalse(is_file(replacement_a[1] + suffix),
                "source removal prunes stale artifact " + suffix + ": " + single_configure);
        }
        assertFalse(is_file(build_dir + "/qo-scripts/GROUP_A/qcc-batch.sh"),
            "single-source transition prunes the obsolete batch script");
        assertFalse(is_file(build_dir + "/qo-scripts/GROUP_A/.qcc-batch-bootstrap.stamp"),
            "single-source transition prunes the obsolete bootstrap stamp");
        assertEq(retained_after_replace, mtime(replacement_a[0]),
            "source removal configuration preserves the retained object timestamp");
        string single_build = run(sprintf("cmake --build %s -- -j17", build_dir));
        assertTrue(is_file(replacement_a[0] + ".stamp"),
            "parallel build after source removal succeeds: " + single_build);

        string remove_group = run(sprintf(
            "cmake -S %s -B %s -DPRUNE_SOURCE_MODE=single -DENABLE_GROUP_B=OFF"
                + " -DENABLE_AGGREGATES=OFF%s", src_dir, build_dir, qore_arg));
        assertFalse(is_dir(build_dir + "/qo/GROUP_B"),
            "removed object group output directory is pruned: " + remove_group);
        assertFalse(is_dir(build_dir + "/qo-scripts/GROUP_B"),
            "removed object group script directory is pruned");
        assertFalse(is_dir(build_dir + "/qo/GROUP_A_link"),
            "removed link aggregate directory is pruned");
        assertFalse(is_dir(build_dir + "/qo/GROUP_A_script"),
            "removed script aggregate directory is pruned");

        string state_path = build_dir + "/.qore-qcc-managed-outputs.manifest";
        string state_before_error = read(state_path);
        string orphan_dir = build_dir + "/qo/ORPHAN";
        mkdir(orphan_dir);
        write(orphan_dir + "/stale.qo", "stale\n");
        write(orphan_dir + "/keep.txt", "unexpected\n");
        string rejected = run(sprintf(
            "cmake -S %s -B %s -DPRUNE_SOURCE_MODE=single -DENABLE_GROUP_B=OFF"
                + " -DENABLE_AGGREGATES=OFF%s", src_dir, build_dir, qore_arg));
        assertTrue(rejected.find("refusing to prune unexpected files or directories") != -1,
            "unexpected files make configuration fail safely: " + rejected);
        assertTrue(is_file(orphan_dir + "/stale.qo") && is_file(orphan_dir + "/keep.txt"),
            "validation failure removes no files");
        assertEq(state_before_error, read(state_path),
            "validation failure does not advance the managed-output manifest");

        unlink(orphan_dir + "/keep.txt");
        string orphan_cleanup = run(sprintf(
            "cmake -S %s -B %s -DPRUNE_SOURCE_MODE=single -DENABLE_GROUP_B=OFF"
                + " -DENABLE_AGGREGATES=OFF%s", src_dir, build_dir, qore_arg));
        assertFalse(is_dir(orphan_dir),
            "recognized orphan artifacts are pruned after safety validation: " + orphan_cleanup);

        date final_object_mtime = mtime(replacement_a[0]);
        date state_mtime = mtime(state_path);
        string state_content = read(state_path);
        string noop1 = run(sprintf(
            "cmake -S %s -B %s -DPRUNE_SOURCE_MODE=single -DENABLE_GROUP_B=OFF"
                + " -DENABLE_AGGREGATES=OFF%s", src_dir, build_dir, qore_arg));
        string noop2 = run(sprintf(
            "cmake -S %s -B %s -DPRUNE_SOURCE_MODE=single -DENABLE_GROUP_B=OFF"
                + " -DENABLE_AGGREGATES=OFF%s", src_dir, build_dir, qore_arg));
        assertEq(final_object_mtime, mtime(replacement_a[0]),
            "idempotent configurations preserve current object timestamps: " + noop1 + noop2);
        assertEq(state_mtime, mtime(state_path),
            "idempotent configurations do not rewrite the state manifest");
        assertEq(state_content, read(state_path),
            "idempotent configurations preserve the exact state manifest");
    }
}
