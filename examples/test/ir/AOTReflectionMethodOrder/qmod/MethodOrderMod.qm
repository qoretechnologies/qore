# -*- mode: qore; indent-tabs-mode: nil -*-
# a module whose class declares its methods in an order that differs from the order of their names (qore#7169)

%modern

module MethodOrderMod {
    version = "1.0";
    desc = "method declaration order test module";
    author = "Qore Technologies, s.r.o.";
