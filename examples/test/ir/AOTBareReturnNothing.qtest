#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil

%exec-class AOTBareReturnNothingTest

class AOTBareReturnNothingTest inherits QUnit::Test {
    private {
        string qore_bin;
        string qcc_bin;
        string libqore_dir;
    }

    constructor() : QUnit::Test("AOTBareReturnNothingTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
            ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");

        addTestCase("AOT nullable bare return yields NOTHING", \testNullableBareReturn());

        set_return_value(main());
    }

    private string run(string cmd) {
        return backquote(cmd + " 2>&1");
    }

    private write(string path, string body) {
        File f();
        f.open2(path, O_WRONLY | O_CREAT | O_TRUNC);
        f.write(body);
    }

    testNullableBareReturn() {
        TmpDir tmp("qore-aot-bare-return-");
        string tmp_dir = tmp.path;
        string qo_dir = tmp_dir + "/qo";
        mkdir(qo_dir);

        string src = tmp_dir + "/bare-return.qr";
        string linked_src = tmp_dir + "/linked-bare-return.qr";
        string standalone = tmp_dir + "/standalone";
        string linked = tmp_dir + "/linked";
        string aggregate = tmp_dir + "/aggregate.qo";

        write(src, "%modern
class AOTBareReturnProbe {
    static *string maybe(bool use_nothing) {
        code check = bool sub () {
            return use_nothing;
        };
        if (check()) {
            return;
        }
        return \"value\";
    }
}

printf(\"%y\\n\", AOTBareReturnProbe::maybe(True));
printf(\"%y\\n\", AOTBareReturnProbe::maybe(False));
");
        write(linked_src, "%modern
class AOTBareReturnProbe {
    static *string maybe(bool use_nothing) {
        code check = bool sub () {
            return use_nothing;
        };
        if (check()) {
            return;
        }
        return \"value\";
    }
}

int sub main() {
    printf(\"%y\\n\", AOTBareReturnProbe::maybe(True));
    printf(\"%y\\n\", AOTBareReturnProbe::maybe(False));
    return 0;
}
");

        string expected = run(sprintf("%s -b %s", qore_bin, src));
        assertEq("null\n\"value\"\n", expected, "interpreter baseline");

        string env = sprintf("LD_LIBRARY_PATH=%s QORE_LIBDIR=%s", libqore_dir, libqore_dir);
        string standalone_out = run(sprintf("%s %s -b --compile --include-source --output %s %s",
            env, qore_bin, standalone, src));
        assertTrue(is_file(standalone), "standalone executable compiled: " + standalone_out);
        assertEq(expected, run(sprintf("LD_LIBRARY_PATH=%s %s -b", libqore_dir, standalone)),
            "standalone AOT bare return matches interpreter");

        string qo_out = run(sprintf("%s %s -c --output-dir=%s %s", env, qcc_bin, qo_dir, linked_src));
        assertTrue(qo_out.find("script-context .qo") != -1,
            "batch .qo compile emitted a script object: " + qo_out);
        string link_out = run(sprintf("%s %s -o %s %s/*.qo", env, qcc_bin, linked, qo_dir));
        assertTrue(is_file(linked), "linked .qo executable compiled: " + link_out);
        assertEq(expected, run(sprintf("LD_LIBRARY_PATH=%s %s -b", libqore_dir, linked)),
            "linked .qo bare return matches interpreter");

        string aggregate_out = run(sprintf("%s %s -c --script-aggregate=BARE_RETURN_AGG -o %s %s",
            env, qcc_bin, aggregate, linked_src));
        assertTrue(is_file(aggregate), "script aggregate compiled: " + aggregate_out);
        string aggregate_index = run(sprintf("%s %s --dump-index-json %s", env, qcc_bin, aggregate));
        assertTrue(aggregate_index.find("\"qore_path\": \"AOTBareReturnProbe::maybe(bool)\"") != -1,
            "script aggregate index keeps method declaration: " + aggregate_index);
        assertTrue(aggregate_index.find("\"native_symbol\": \"AOTBareReturnProbe::maybe(bool)\"") == -1,
            "script aggregate does not claim native ownership of method bodies: " + aggregate_index);
        string aggregate_dump = run(sprintf("%s %s --dump-info --dump-symbols %s", env, qcc_bin, aggregate));
        assertTrue(aggregate_dump.find("AOT native symbols: (none)") != -1,
            "script aggregate has no native body symbol references: " + aggregate_dump);
    }
}
