%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil
%exec-class IRFiniteHashKeySelectorElisionTest

class IRFiniteHashKeySelectorElisionTest inherits QUnit::Test {
    private {
        string qore = realpath(ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0]);
        string libdir = realpath(ENV.QORE_LIBDIR ?? dirname(qore));
        string qcc = ENV.QCC ?? libdir + "/qcc";
        string gate = "QORE_DISABLE_IR_FINITE_HASH_KEY_SCALAR_REPLACEMENT=1 ";
        string selector_gate = "QORE_DISABLE_IR_FINITE_HASH_KEY_SELECTOR_ELISION=1 ";
    }
    constructor() : Test("Finite literal hash key selector elision", "1.0", \ARGV) {
        addTestCase("branches, lifetimes, exclusions and compiled allocation selection", \check());
        set_return_value(main());
    }
    private static string quote(string value) {
        return "'" + replace(value, "'", "'\"'\"'") + "'";
    }
    private string run(list<string> args, string prefix = "") {
        int status;
        string output = backquote(prefix + "LD_LIBRARY_PATH=" + quote(libdir)
            + " DYLD_LIBRARY_PATH=" + quote(libdir)
            + " QORE_JIT_SYNC_COMPILE=1 QORE_IR_THRESHOLD=1 QORE_JIT_THRESHOLD=1 "
            + (map quote($1), args).join(" ") + " 2>&1", \status);
        assertEq(0, status, output);
        return output;
    }
    private check() {
        string source = get_script_dir() + "/IRFiniteHashKeySelectorElision.qr";
        string expected = run((qore, "--exec-mode=ast", source));
        assertRegex("finite key selector checks passed", expected);
        foreach string prefix in (("", gate, selector_gate)) {
            foreach string mode in (("ir", "jit", "tiered")) {
                assertEq(expected, run((qore, "--exec-mode=" + mode, source), prefix), prefix + mode);
            }
        }
        TmpDir dir("qore-finite-hash-key-");
        foreach string prefix in (("", gate, selector_gate, "QORE_AOT_EH=1 ", "QORE_AOT_NO_DEBUG_INFO=1 ",
                "MAKEFLAGS= QCC_JOBS=4 QCC_SPLIT_THRESHOLD=1 ")) {
            foreach string level in (("-O0", "-O3")) {
                string executable = dir.path + "/fixture";
                string ir = run((qcc, level, "--strip-source", "-o", executable, source),
                    prefix + "QORE_DUMP_LLVM_IR=1 ");
                if (level == "-O3") {
                    foreach string name in (("finiteKey", "directKey", "linkedKey", "repeatedKey",
                            "duplicateKey", "unicodeKey", "extremeKey", "loopKey", "observableKey",
                            "twoHashKey", "copiedKey", "sideEffectKey")) {
                        *list<*string> body = regex_extract(ir, "(?s)define [^\n]*@" + name
                            + "_[^\n]*\n(.*?)\n\\}");
                        assertTrue(!!body, name + " LLVM definition");
                        assertEq(prefix == gate, regex(body[0] ?? "", "(?:call|invoke) [^\n]*@qore_rt_make_hash"),
                            name + " hash allocation selection");
                    }
                    foreach string name in (("wideKey", "wideConstantKey", "earlyKey", "missingKey", "arbitraryKey",
                            "changedKey", "mutatedHash", "capturedHash", "referencedKey", "nestedKey",
                            "caughtKey", "rejoinedKey", "partialKey")) {
                        *list<*string> body = regex_extract(ir, "(?s)define [^\n]*@" + name
                            + "_[^\n]*\n(.*?)\n\\}");
                        assertTrue(!!body, name + " LLVM definition");
                        assertTrue(regex(body[0] ?? "", "(?:call|invoke) [^\n]*@qore_rt_make_hash"),
                            name + " conservative allocation retained");
                    }
                    foreach string name in (("finiteKey", "directKey", "repeatedKey", "duplicateKey",
                            "unicodeKey", "extremeKey", "loopKey", "twoHashKey", "sideEffectKey")) {
                        *list<*string> body = regex_extract(ir, "(?s)define [^\n]*@" + name
                            + "_[^\n]*\n(.*?)\n\\}");
                        assertTrue(!!body, name + " selector LLVM definition");
                        assertEq(prefix == gate || prefix == selector_gate,
                            regex(body[0] ?? "", "(?:call|invoke) [^\n]*@qore_rt_make_string_len"),
                            name + " exclusive selector allocation selection");
                    }
                    foreach string name in (("observableKey", "linkedKey", "copiedKey", "partialKey")) {
                        *list<*string> body = regex_extract(ir, "(?s)define [^\n]*@" + name
                            + "_[^\n]*\n(.*?)\n\\}");
                        assertTrue(!!body, name + " observable selector LLVM definition");
                        assertTrue(regex(body[0] ?? "", "(?:call|invoke) [^\n]*@qore_rt_make_string_len"),
                            name + " observable or unsupported selector retained");
                    }
                }
                assertEq(expected, run((executable,)), prefix + level);
            }
        }
    }
}
