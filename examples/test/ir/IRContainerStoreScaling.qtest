#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

# Copyright (C) 2026 Qore Technologies, s.r.o.
# Regression tests for two IR-interpreter defects that made read+write
# container loops O(N²) in the loop count:
#
# 1. The per-frame cleanup slot list allowed unbounded duplicate entries — a
#    loop body storing a node value to the same slot every iteration grew the
#    list by one entry per iteration, and the per-store linear scans over it
#    (clearSlotForOverwrite() et al.) made the whole loop quadratic.  Fixed by
#    deduplicating entries with a per-slot push count (IRCleanupSlots).
#
# 2. The HashKeyStore / HashKeyStoreDynamic / ListIndexStore fast paths ran
#    their reference_count() uniqueness check while this frame's own
#    bookkeeping references to the container (LoadLocal result slots, the
#    locals slot cache) were still held, so any loop that read and then wrote
#    the same local container looked "shared" and did a full copy-on-write of
#    the container on every store.  Fixed by releasing the frame's bookkeeping
#    references before the check for plain (non-closure) container locals.
#
# Originally surfaced as a >30s load of the Qorus Business-Impact Dashboard,
# pinned in a uniqueInts() id-dedup helper (foreach + hash membership test +
# hash insert + list append: 10k elements took ~20s).
#
# The dedup loop is checked with counters of library debugging, which make the
# check deterministic (it replaced a wall-clock check that 4x the input cost no
# more than ~8x the time, which failed on loaded CI hosts).  The loop runs in a
# child Program in each execution mode, where
# - dbg_get_container_copy_count() counts the hashes and lists that the loop
#   copies: none when the stores change the containers in place, one for each
#   store when they copy them (defect 2)
# - dbg_get_ir_cleanup_entries() and dbg_get_ir_instantiated_local_entries(),
#   read before and after the loop, give the entries of the cleanup ledger and
#   of the list of instantiated locals of the innermost IR interpreter frame:
#   the loop must leave none behind, while a loop that leaves entries for each
#   iteration (such as the break/continue leaks that
#   design/ir-loop-jump-temp-scope.md describes, or temps that a statement end
#   does not release) makes every later scan of them slower.  The values of
#   this loop are statement temps, which each statement end releases, so the
#   duplicate entries of defect 1 can no longer accumulate in it; IRCleanupSlots
#   keeps a ledger free of duplicates by construction.  The ledger is only read
#   in IR interpreter frames: when the loop runs compiled code (the JIT and
#   tiered modes can promote it), another frame is read, whose entries the loop
#   does not change, and only the copy count applies.
# A control loop that stores to a hash that a second variable also holds must
# copy it at each store, which proves that the count sees the copies.  Without
# library debugging the counters do not exist and the check is skipped: the
# Linux CI jobs build libqore with CMAKE_BUILD_TYPE=debug, so they run it.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit

%exec-class IRContainerStoreScalingTest

class IRContainerStoreScalingTest inherits QUnit::Test {
    constructor() : QUnit::Test("IRContainerStoreScalingTest", "1.0", \ARGV) {
        addTestCase("hash static-key store after read", \testHashStaticKeyStoreAfterRead());
        addTestCase("hash dynamic-key store after read", \testHashDynamicKeyStoreAfterRead());
        addTestCase("list index store after read", \testListIndexStoreAfterRead());
        addTestCase("genuinely shared containers still CoW", \testSharedContainersStillCow());
        addTestCase("hash self-assignment stores pre-CoW value", \testHashSelfAssign());
        addTestCase("read+write dedup loop correctness", \testDedupLoopCorrectness());
        addTestCase("exception paths in read+write loops", \testExceptionPaths());
        addTestCase("read+write dedup loop copies no container and keeps its cleanup ledger bounded",
            \testDedupLoopCounts());
        set_return_value(main());
    }

    testHashStaticKeyStoreAfterRead() {
        hash<auto> h = {"a": 1};
        assertEq(1, h.a);           # read populates the interpreter's slot cache
        h.b = 2;                    # HashKeyStore must mutate in place, not CoW
        h = {"c": 3};               # reassign must not double-release cached refs
        assertEq({"c": 3}, h);
    }

    testHashDynamicKeyStoreAfterRead() {
        hash<string, int> h = {"a": 1};
        string k = "b";
        assertEq(1, h{"a"});
        h{k} = 2;                   # HashKeyStoreDynamic
        assertEq(2, h{k});
        h = {"c": 3};
        assertEq({"c": 3}, h);
    }

    testListIndexStoreAfterRead() {
        list<int> l = (1, 2, 3);
        assertEq(1, l[0]);
        l[1] = 20;                  # ListIndexStore
        assertEq((1, 20, 3), l);
        l = (7, 8);
        assertEq((7, 8), l);
    }

    testSharedContainersStillCow() {
        # a second variable holding the container is a genuine external
        # reference: the store must copy, leaving the alias untouched
        hash<auto> h = {"a": 1};
        hash<auto> alias = h;
        assertEq(1, h.a);
        h.b = 2;
        assertEq({"a": 1}, alias);
        assertEq({"a": 1, "b": 2}, h);

        list<int> l = (1, 2, 3);
        list<int> lalias = l;
        assertEq(1, l[0]);
        l[1] = 20;
        assertEq((1, 2, 3), lalias);
        assertEq((1, 20, 3), l);
    }

    testHashSelfAssign() {
        # `h.b = h` must copy the outer hash first and store the original
        hash<auto!> h = {"a": 1};
        h.b = h;
        assertEq(1, h.b.a);
        assertFalse(exists h.b.b);
    }

    private static list<int> uniqueInts(list<int> values) {
        # the original quadratic pattern: foreach + hash membership read +
        # hash insert + list append, all on locals read and written in the
        # same loop body
        list<int> rv = ();
        hash<string, bool> seen = {};
        foreach int value in (values) {
            string key = value.toString();
            if (seen{key}) {
                continue;
            }
            seen{key} = True;
            rv += value;
        }
        return rv;
    }

    testDedupLoopCorrectness() {
        assertEq((5, 3, 1, 2), IRContainerStoreScalingTest::uniqueInts((5, 3, 5, 1, 3, 5, 2)));
        assertEq(new list<int>(), IRContainerStoreScalingTest::uniqueInts(new list<int>()));
        list<int> vals = map $1 % 500, xrange(5000);
        assertEq(500, IRContainerStoreScalingTest::uniqueInts(vals).size());
    }

    testExceptionPaths() {
        # exceptions thrown mid-loop must leave the mutated containers intact
        # and release loop temporaries without crashing
        hash<string, bool> seen = {};
        list<int> rv = ();
        try {
            foreach int i in (xrange(100)) {
                string key = i.toString();
                if (seen{key}) {
                    continue;
                }
                seen{key} = True;
                rv += i;
                if (i == 50) {
                    throw "STOP", "stop";
                }
            }
            assertTrue(False);
        } catch (hash<ExceptionInfo> ex) {
            assertEq("STOP", ex.err);
        }
        assertEq(51, rv.size());
        assertEq(51, seen.size());
    }

    #! the elements of the dedup loop: half of them are distinct, so it makes this many / 2 hash and list stores
    const DedupCount = 8000;

    #! the most copies and frame entries left behind of a dedup loop that changes its containers in place and leaves
    #! no entries behind; a regression copies a container at each store or leaves entries for each iteration
    const MaxCount = DedupCount / 20;

    #! the code of the child Programs: the dedup loop, a control loop, and the functions that count what they do
    const DedupCode = "%modern
int sub copies() {
    return call_function(\"dbg_get_container_copy_count\");
}

# the entries that the loop of uniqueInts() left in the innermost IR interpreter frame of the thread, which is its own
# frame when the IR interpreter runs it; -1 until uniqueInts() sets them.  uniqueInts() calls the counters itself: a
# function that called them would read its own frame
int cleanup_growth;
int local_growth;

list<int> sub uniqueInts(list<int> values) {
    list<int> rv = ();
    hash<string, bool> seen = {};
    int cleanup_before = call_function(\"dbg_get_ir_cleanup_entries\");
    int local_before = call_function(\"dbg_get_ir_instantiated_local_entries\");
    foreach int value in (values) {
        string key = value.toString();
        if (seen{key}) {
            continue;
        }
        seen{key} = True;
        rv += value;
    }
    cleanup_growth = call_function(\"dbg_get_ir_cleanup_entries\") - cleanup_before;
    local_growth = call_function(\"dbg_get_ir_instantiated_local_entries\") - local_before;
    return rv;
}

# the sizes of the snapshots of uniqueIntsShared(), which uses each snapshot so that no optimization removes it
int snapshot_sizes;

# the control: a second variable holds the hash at each store, which must copy it
list<int> sub uniqueIntsShared(list<int> values) {
    list<int> rv = ();
    hash<string, bool> seen = {};
    int sizes = 0;
    foreach int value in (values) {
        string key = value.toString();
        if (seen{key}) {
            continue;
        }
        hash<string, bool> snapshot = seen;
        seen{key} = True;
        rv += value;
        sizes += snapshot.size();
    }
    snapshot_sizes = sizes;
    return rv;
}

hash<auto> sub measure(code<list<int>(list<int>)> dedup, list<int> values) {
    cleanup_growth = -1;
    local_growth = -1;
    int before = copies();
    list<int> rv = dedup(values);
    return {
        \"copies\": copies() - before,
        \"cleanup_growth\": cleanup_growth,
        \"local_growth\": local_growth,
        \"size\": rv.size(),
    };
}

hash<auto> sub measureUnique(list<int> values) {
    return measure(\\uniqueInts(), values);
}

hash<auto> sub measureShared(list<int> values) {
    return measure(\\uniqueIntsShared(), values);
}
";

    testDedupLoopCounts() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("the counters need library debugging");
        }
        list<int> vals = map $1 % (DedupCount / 2), xrange(DedupCount);
        foreach hash<auto> i in ({"ast": EM_AST, "ir": EM_IR, "tiered": EM_TIERED, "jit": EM_JIT}.pairIterator()) {
            Program pgm();
            pgm.setExecMode(i.value);
            pgm.parse(DedupCode, "dedup-" + i.key);
            # a first call and a second call: the tiered and JIT modes run the first in the IR interpreter and can
            # promote the function to compiled code (with a background compile, at a call that depends on timing)
            foreach string call in ("first", "second") {
                hash<auto> h = pgm.callFunction("measureUnique", vals);
                string label = sprintf("%s mode, %s call: %y", i.key, call, h);
                assertEq(DedupCount / 2, h.size, label);
                # the entries that the loop left behind: they cannot be negative, and -1 means they were not read
                assertGe(0, h.cleanup_growth, label);
                assertLt(MaxCount, h.cleanup_growth, label);
                assertGe(0, h.local_growth, label);
                assertLt(MaxCount, h.local_growth, label);
                assertLt(MaxCount, h.copies, label);
            }
            # the control: a store to a hash that a second variable also holds copies it, once for each store
            hash<auto> h = pgm.callFunction("measureShared", vals);
            string label = sprintf("%s mode, shared hash: %y (snapshot sizes: %d)", i.key, h,
                pgm.getGlobalVariable("snapshot_sizes"));
            assertEq(DedupCount / 2, h.size, label);
            assertGe(DedupCount / 2, h.copies, label);
        }
    }
}
