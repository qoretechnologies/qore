#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

#! Regression test: a local or parameter declared "auto" can hold a reference at runtime.
/** Reference capability was established from the *declared* type, which reports "not a
    reference" for \c auto, so an untyped local holding a reference was treated as an ordinary
    value: writes were cached instead of following the reference, the local was classified
    IR-only (never synced to the runtime local stack), and an untyped parameter was even
    treated as an unused parameter and given a private AOT/JIT fast-entry slot.  Every
    mutation through such a local then updated a copy and the aliased variable never changed.

    The declared reference<> cases below are the paired control: they took the correct path
    before the fix and must keep producing identical results.
*/

string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
string libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
string qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
    ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : dirname(qore_bin) + "/qcc");
if (!is_file(qcc_bin)) {
    qcc_bin = "qcc";
}

string code = '%modern

# every mutation through an "auto" local that holds a reference must reach the aliased variable
string sub autoAssign()      { list<int> v = (1,); auto r = \v; r = (9,); return sprintf("%y/%y", v, r); }
string sub autoPlusAssign()  { list<int> v = (1,); auto r = \v; r += 2; return sprintf("%y/%y", v, r); }
string sub autoIndex()       { list<int> v = (1,); auto r = \v; r[1] = 5; return sprintf("%y/%y", v, r); }
string sub autoHashKey()     { hash<string, int> h = {"a": 1}; auto r = \h; r{"b"} = 2; return sprintf("%y/%y", h, r); }
string sub autoPush()        { list<int> v = (1,); auto r = \v; push r, 2; return sprintf("%y/%y", v, r); }
string sub autoUnshift()     { list<int> v = (1,); auto r = \v; unshift r, 0; return sprintf("%y/%y", v, r); }
string sub autoSplice()      { list<int> v = (1, 2, 3); auto r = \v; splice r, 1, 1; return sprintf("%y/%y", v, r); }
string sub autoIncrement()   { int i = 1; auto r = \i; ++r; return sprintf("%y/%y", i, r); }
string sub autoDelete()      { hash<string, int> h = {"a": 1, "b": 2}; auto r = \h; delete r{"a"}; return sprintf("%y/%y", h, r); }
string sub autoIntAssign()   { int i = 1; auto r = \i; r = 7; return sprintf("%y/%y", i, r); }

# control: the same operations through a declared reference<> local
string sub refAssign()       { list<int> v = (1,); reference<list<int>> r = \v; r = (9,); return sprintf("%y/%y", v, r); }
string sub refPlusAssign()   { list<int> v = (1,); reference<list<int>> r = \v; r += 2; return sprintf("%y/%y", v, r); }
string sub refIndex()        { list<int> v = (1,); reference<list<int>> r = \v; r[1] = 5; return sprintf("%y/%y", v, r); }
string sub refHashKey()      { hash<string, int> h = {"a": 1}; reference<hash<string, int>> r = \h; r{"b"} = 2; return sprintf("%y/%y", h, r); }
string sub refIntAssign()    { int i = 1; reference<int> r = \i; r = 7; return sprintf("%y/%y", i, r); }

# a reference also arrives in an untyped parameter from the caller, while the callee itself
# contains no reference-creating expression at all
nothing sub takesAuto(auto p) { p = 99; }
string sub autoParam()       { int i = 1; takesAuto(\i); return sprintf("%y", i); }

# every mutation form applied to an untyped parameter holding a reference.  Only a written
# parameter has to give up its private (runtime-stack-free) slot, so each of these pins one
# write form that the write inventory must recognize
nothing sub pAssign(auto p) { p = 99; }
nothing sub pPlus(auto p)   { p += 1; }
nothing sub pIncr(auto p)   { ++p; }
nothing sub pIndex(auto p)  { p[0] = 5; }
nothing sub pPush(auto p)   { push p, 9; }
nothing sub pKey(auto p)    { p{"b"} = 2; }
nothing sub pDelete(auto p) { delete p{"a"}; }
nothing sub pSplice(auto p) { splice p, 0, 1; }
nothing sub innerRef(reference<int> r) { r = 77; }
nothing sub pRefOn(auto p)  { innerRef(\p); }
string sub paramWrites() {
    int a = 1; pAssign(\a);
    int b = 1; pPlus(\b);
    int c = 1; pIncr(\c);
    list<int> d = (1, 2); pIndex(\d);
    list<int> e = (1,); pPush(\e);
    hash<string, int> f = {"a": 1}; pKey(\f);
    hash<string, int> g = {"a": 1, "b": 2}; pDelete(\g);
    list<int> h = (1, 2); pSplice(\h);
    int i = 1; pRefOn(\i);
    return sprintf("%y,%y,%y,%y,%y,%y,%y,%y,%y", a, b, c, d, e, f, g, h, i);
}

# read-only untyped parameters keep their private slot; a read must still see the
# dereferenced value rather than the reference itself
string sub qFormat(auto p) { return sprintf("%y", p); }
string sub qType(auto p)   { return p.type(); }
int    sub qAdd(auto p)    { return p + 1; }
auto   sub qCopy(auto p)   { auto q = p; return q; }
int    sub qSize(auto p)   { return p.size(); }
auto   sub qIndex(auto p)  { return p[0]; }
string sub paramReads() {
    int i = 41;
    list<int> v = (7, 8);
    return sprintf("%s,%s,%d,%y,%d,%y", qFormat(\i), qType(\i), qAdd(\i), qCopy(\i),
        qSize(\v), qIndex(\v));
}

# reading a variable that holds a reference dereferences it, so a value returned from a call
# is never itself a reference and mutating it must NOT touch the callers variable
auto sub returnsRef(reference<int> r) { return r; }
string sub autoFromCall()    { int i = 1; auto r = returnsRef(\i); r = 5; return sprintf("%y/%y", i, r); }

# control: untyped locals in a function that creates no reference at all stay eligible for the
# IR-only fast path and must still compute the right answer
int sub autoNoReference(int n) {
    auto acc = 0;
    for (int i = 0; i < n; ++i) {
        auto tmp = i * 2;
        acc = acc + tmp;
    }
    return acc;
}

# top-level ("program-wide") locals are never parameters and are never IR-only, so they take
# the reference-aware runtime path regardless of how the reference-capability analysis
# classifies them
int top_target = 1;
auto top_ref = \top_target;
top_ref = 7;
list<int> top_list = (1,);
auto top_list_ref = \top_list;
push top_list_ref, 2;

printf("%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|", autoAssign(), autoPlusAssign(), autoIndex(),
    autoHashKey(), autoPush(), autoUnshift(), autoSplice(), autoIncrement(),
    autoDelete(), autoIntAssign());
printf("%s|%s|%s|%s|%s|", refAssign(), refPlusAssign(), refIndex(), refHashKey(), refIntAssign());
printf("%s|%s|%s|%s|%d|%y,%y\n", autoParam(), paramWrites(), paramReads(), autoFromCall(),
    autoNoReference(1000), top_target, top_list);
';

string base_path = "/tmp/qore-ir-auto-local-reference-" + string(getpid());
string script_path = base_path + ".qr";
File script();
script.open2(script_path, O_WRONLY | O_CREAT | O_TRUNC);
script.write(code);
script.close();

on_exit {
    unlink(script_path);
    unlink(base_path);
}

string expected = "[9]/[9]|[1, 2]/[1, 2]|[1, 5]/[1, 5]|{a: 1, b: 2}/{a: 1, b: 2}|[1, 2]/[1, 2]|"
    + "[0, 1]/[0, 1]|[1, 3]/[1, 3]|2/2|{b: 2}/{b: 2}|7/7|"
    + "[9]/[9]|[1, 2]/[1, 2]|[1, 5]/[1, 5]|{a: 1, b: 2}/{a: 1, b: 2}|7/7|"
    + "99|"
    + "99,2,2,[5, 2],[1, 9],{a: 1, b: 2},{b: 2},[2],77|"
    + "41,integer,42,41,2,7|"
    + "1/5|999000|7,[1, 2]\n";

foreach string mode in ("ast", "ir", "tiered", "jit") {
    string actual = backquote(sprintf(
        "LD_LIBRARY_PATH=%s %s -b --enable-debug --exec-mode=%s %s 2>&1",
        libqore_dir, qore_bin, mode, script_path));
    if (actual != expected) {
        printf("mismatch in %s\nexpected:\n%sactual:\n%s", mode, expected, actual);
        exit(2);
    }
}

string compile_out = backquote(sprintf(
    "LD_LIBRARY_PATH=%s %s --strip-source --strip-debug-info -O3 -o %s %s 2>&1",
    libqore_dir, qcc_bin, base_path, script_path));
if (!is_file(base_path)) {
    printf("AOT compile failed:\n%s", compile_out);
    exit(2);
}
string aot = backquote(sprintf("LD_LIBRARY_PATH=%s %s 2>&1", libqore_dir, base_path));
if (aot != expected) {
    printf("mismatch in AOT\nexpected:\n%sactual:\n%s", expected, aot);
    exit(2);
}
