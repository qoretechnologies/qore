#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-exec-mode: children - its checks run in children that set their own execution modes
# test-platform: macos - the loading of qcc-compiled modules by name and by their paths
# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../ExecModeHarness.qm
%requires ../../TestInterpreter.qm

%exec-class AotLibraryMarkTest

#! A compiled module is library code only if its own load is (qore#7361)
/** LibA's initialization loads LibD by name from the module path, which is library code, and PathC, compiled by qcc,
    by its path from outside the module path, which is not, also while library code is initialized: library code can
    run a closure of a module's initialization as deferred module initialization, PathC cannot, and the closure of
    its own initialization does not qualify.  The output of mark.q must be the same with LibA and LibD loaded from
    source and compiled by qcc at -O0 and -O3, in the ast, ir, jit and tiered modes.
*/
class AotLibraryMarkTest inherits QUnit::Test {
    public {
        #! the execution modes
        const Modes = ("ast", "ir", "jit", "tiered");

        #! the qcc optimization levels
        const OptLevels = ("-O0", "-O3");

        #! the environment of a run in which every function is compiled at its first call
        const CompileEnv = "QORE_JIT_SYNC_COMPILE=1 QORE_IR_THRESHOLD=1 QORE_JIT_THRESHOLD=1";

        #! the library modules of the test, in the order of their compilation
        const LibModules = ("LibD", "LibA");

        #! the output of mark.q
        const Expected = "D runs its init closure: D init closure ran
C init closure qualifies: False
C runs A's init closure: MODULE-INIT-CLOSURE-ERROR
";
    }

    private {
        string qore_bin;
        string qcc_bin;
        #! the library path of the qcc compiles and of the runs
        string lib_env;
        #! the module path of the runs, after the directory of the test's library modules
        string module_path;
    }

    constructor() : QUnit::Test("AotLibraryMarkTest", "1.0", \ARGV) {
        qore_bin = TestInterpreter::qore_interpreter();
        string libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = TestInterpreter::qcc_compiler() ?? "qcc";
        lib_env = sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s", libqore_dir, libqore_dir);
        module_path = ENV.QORE_MODULE_DIR ?? "";
        addTestCase("a compiled module loaded by its path is not library code", \markTest());
        set_return_value(main());
    }

    markTest() {
        TmpDir dir("qore-aot-library-mark-");
        string src_dir = join_paths(dir.path, "src");
        mkdir(src_dir);
        foreach string m in (LibModules) {
            copy_file(get_script_dir() + "/" + m + ".qm", join_paths(src_dir, m + ".qm"));
        }
        # outside the module path
        string c_dir = join_paths(dir.path, "outside");
        mkdir(c_dir);
        copy_file(get_script_dir() + "/PathC.qm", join_paths(c_dir, "PathC.qm"));
        string c_qmod = join_paths(c_dir, "PathC.qmod");
        compile("-O0", c_qmod, join_paths(c_dir, "PathC.qm"), module_path);
        string script = join_paths(dir.path, "mark.q");
        copy_file(get_script_dir() + "/mark.q", script);

        hash<string, string> dirs = {"source": src_dir};
        foreach string opt in (OptLevels) {
            string aot_dir = join_paths(dir.path, "aot" + opt);
            mkdir(aot_dir);
            foreach string m in (LibModules) {
                compile(opt, join_paths(aot_dir, m + ".qmod"), join_paths(src_dir, m + ".qm"), modulePath(src_dir));
            }
            dirs{"qmod " + opt} = aot_dir;
        }

        foreach hash<auto> i in (dirs.pairIterator()) {
            string env = sprintf("%s LIBMARK_C_PATH=%s QORE_MODULE_DIR=%s", lib_env, c_qmod, modulePath(i.value));
            foreach string mode in (Modes) {
                hash<ExecModeHarness::ModeRunResult> r = ExecModeHarness::run_command(sprintf("%s %s %s -b "
                    "--enable-debug --exec-mode=%s %s", env, CompileEnv, qore_bin, mode, script));
                string label = sprintf("LibA and LibD %s, %s", i.key, mode);
                assertEq(0, r.rc, sprintf("%s: exit status (output: %y)", label, r.out));
                assertEq(Expected, r.stdout, label);
            }
        }
    }

    #! compiles a module with qcc
    private compile(string opt, string target, string source, string mod_path) {
        int rc;
        string output = backquote(sprintf("%s QORE_MODULE_DIR=%s %s %s --module -o %s %s 2>&1", lib_env, mod_path,
            qcc_bin, opt, target, source), \rc);
        assertEq(0, rc, sprintf("qcc %s %s: %s", opt, basename(source), output.substr(-2000)));
    }

    #! returns the module path of a run with the test's library modules in the given directory
    private string modulePath(string dir) {
        return module_path ? dir + ":" + module_path : dir;
    }
}
