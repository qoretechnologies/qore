#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (c) 2026 Qore Technologies, s.r.o.
# SPDX-License-Identifier: MIT

/*  In a program that allows the debugger, qcc compiles a function twice: a native body and a debugger body, whose
    local slots must be numbered alike (buildAOTFunctionSlotMap() refuses the function otherwise).  A function that
    cannot run a reflection builtin has a native body lowered again without the reflection-specific rules; that
    lowering does not activate the locals of nested blocks at their declaration, and slots were numbered by first
    reference, so its locals were numbered differently from the debugger body's, and qcc failed with "slot map
    construction failed ...: cancelled or invalid slot numbering", as for QorusProgram::findJavaFrameCycle() in
    the Qorus server build (PO_ALLOW_DEBUGGER).
*/

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil

%exec-class AOTDebuggerReflectionFreeSlotsTest

class AOTDebuggerReflectionFreeSlotsTest inherits QUnit::Test {
    public {
        const ModuleName = "AOTDebuggerReflectionFreeSlotsMod";

        const Classes = "class DrfCycle {
    const MaxOffset = 8;
    const MaxCycle = 16;

    static *hash<auto> findCycle(list<string> frames) {
        for (int start = 0; start <= MaxOffset; ++start) {
            int available = frames.size() - start;
            int max_cycle = available / 2;
            if (max_cycle > MaxCycle) {
                max_cycle = MaxCycle;
            }
            for (int cycle = 1; cycle <= max_cycle; ++cycle) {
                int limit = cycle * 3;
                if (limit > available - cycle) {
                    limit = available - cycle;
                }
                bool match = True;
                for (int i = 0; i < limit; ++i) {
                    if (frames[start + i] != frames[start + i + cycle]) {
                        match = False;
                        break;
                    }
                }
                if (match) {
                    return {\"start\": start, \"length\": cycle};
                }
            }
        }
    }
}
";

        const Main = "printf(\"%y\\n\", DrfCycle::findCycle((\"a\", \"b\", \"a\", \"b\", \"a\", \"b\", \"a\", \"b\")));
printf(\"%y\\n\", DrfCycle::findCycle((\"x\", \"y\", \"z\")));
printf(\"%y\\n\", DrfCycle::findCycle((\"q\", \"a\", \"a\", \"a\", \"a\")));
";

        const Expected = "{start: 0, length: 2}\nnull\n{start: 1, length: 1}\n";
    }

    private {
        string qore_bin;
        string qcc_bin;
        string libqore_dir;
    }

    constructor() : QUnit::Test("AOTDebuggerReflectionFreeSlotsTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
            ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");

        addTestCase("a reflection-free body of a debuggable executable compiles and matches AST", \testExecutable());
        addTestCase("a reflection-free body of a debuggable module compiles and matches AST", \testModule());

        set_return_value(main());
    }

    private static string quote(string value) {
        return "'" + replace(value, "'", "'\"'\"'") + "'";
    }

    private string env(*string module_dir) {
        string rv = sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s QORE_LIBDIR=%s ", quote(libqore_dir),
            quote(libqore_dir), quote(libqore_dir));
        if (module_dir) {
            rv += "QORE_MODULE_DIR=" + quote(module_dir + (ENV.QORE_MODULE_DIR ? ":" + ENV.QORE_MODULE_DIR : ""))
                + " ";
        }
        return rv;
    }

    private string run(string cmd, reference<int> status) {
        return backquote(cmd + " 2>&1", \status);
    }

    private static write(string path, string body) {
        File f();
        f.open2(path, O_WRONLY | O_CREAT | O_TRUNC, 0644);
        f.write(body);
    }

    private string moduleSource() {
        return sprintf("%%modern\n%%allow-debugger\nmodule %s {\n    version = \"1.0\";\n"
            "    desc = \"AOT debugger slot regression\";\n    author = \"Qore Technologies, s.r.o.\";\n"
            "    url = \"https://qore.org\";\n    license = \"MIT\";\n}\n\n", ModuleName)
            + regex_subst(Classes, "^class ", "public class ", RE_MultiLine | RE_Global);
    }

    testExecutable() {
        TmpDir tmp("qore-aot-debugger-reflection-free-slots-exe-");
        string src = tmp.path + "/prog.qr";
        write(src, "%modern\n%allow-debugger\n" + Classes + Main);
        int status;
        string ast_out = run(env() + quote(qore_bin) + " --exec-mode=ast " + quote(src), \status);
        assertEq(0, status, ast_out);
        assertEq(Expected, ast_out, "AST baseline");

        foreach string level in (("-O0", "-O3")) {
            string exe = tmp.path + "/prog" + level;
            string compile_out = run(env() + quote(qcc_bin) + " " + level + " -o " + quote(exe) + " " + quote(src),
                \status);
            assertEq(0, status, compile_out);
            assertTrue(is_file(exe), "executable compiled: " + compile_out);
            string out = run(env() + quote(exe), \status);
            assertEq(0, status, out);
            assertEq(ast_out, out, "AOT executable " + level);
        }
    }

    testModule() {
        TmpDir tmp("qore-aot-debugger-reflection-free-slots-mod-");
        string src_dir = tmp.path + "/src";
        mkdir(src_dir);
        string module_src = src_dir + "/" + ModuleName + ".qm";
        write(module_src, moduleSource());
        string probe = tmp.path + "/probe.qr";
        write(probe, sprintf("%%modern\n%%allow-debugger\n%%requires %s\n", ModuleName) + Main);

        int status;
        string ast_out = run(env(src_dir) + quote(qore_bin) + " --exec-mode=ast " + quote(probe), \status);
        assertEq(0, status, ast_out);
        assertEq(Expected, ast_out, "AST baseline");

        foreach string level in (("-O0", "-O3")) {
            # a per-source object, as the batch builds of applications compile them, takes the same slot map walk
            string obj = tmp.path + "/" + ModuleName + level + ".qo";
            string obj_out = run(env(src_dir) + quote(qcc_bin) + " " + level + " --module -c -o " + quote(obj) + " "
                + quote(module_src), \status);
            assertEq(0, status, obj_out);
            assertTrue(is_file(obj), "object compiled: " + obj_out);

            string mod_dir = tmp.path + "/qmod" + level;
            mkdir(mod_dir);
            string qmod = mod_dir + "/" + ModuleName + ".qmod";
            string compile_out = run(env(src_dir) + quote(qcc_bin) + " " + level + " --module -o " + quote(qmod)
                + " " + quote(module_src), \status);
            assertEq(0, status, compile_out);
            assertTrue(is_file(qmod), "module compiled: " + compile_out);
            # only the AOT image can satisfy the module requirement
            string out = run(env(mod_dir) + quote(qore_bin) + " " + quote(probe), \status);
            assertEq(0, status, out);
            assertEq(ast_out, out, "AOT module " + level);
        }
    }
}
