#!/usr/bin/env qore
# Copyright (c) 2026 Qore Technologies, s.r.o.
# SPDX-License-Identifier: MIT
%modern

int sub dynamicClosureCall(code<int(int)> callback, int value) {
    return callback(value);
}
code<int(int)> sub dynamicClosureFactory(int offset) {
    return int sub (int value) { return ((value * 3 + offset) ^ 5); };
}
code<int(int)> sub dynamicClosurePlain() {
    return int sub (int value) { return ((value * 3 + 17) ^ 5); };
}
code<int(int)> sub dynamicClosureReference(reference<int> offset) {
    return int sub (int value) { return ((value * 3 + offset) ^ 5); };
}
sub checkValue(int expected, int actual, string label) {
    if (expected != actual) {
        throw "DYNAMIC-CLOSURE-TEST", sprintf("%s: expected %d, got %d", label, expected, actual);
    }
}

code<int(int)> first = dynamicClosureFactory(17);
code<int(int)> second = dynamicClosureFactory(31);
code<int(int)> plain = dynamicClosurePlain();
int shared = 9;
code<int(int)> changing = int sub (int value) { return (value + shared) ^ 7; };
code<int(int)> repeated = int sub (int value) { return value + shared - shared; };
code<nothing(int)> write = nothing sub (int value) { shared = value; };
code<int(int)> reference = dynamicClosureReference(\shared);
foreach int input in ((0, 1, -1, 1125899906842624, -1125899906842624,
        9223372036854775807, -9223372036854775807 - 1)) {
    for (int round = 0; round < 8; ++round) {
        checkValue((input * 3 + 17) ^ 5, dynamicClosureCall(first, input), "first environment");
        checkValue((input * 3 + 31) ^ 5, dynamicClosureCall(second, input), "second environment");
        checkValue((input * 3 + 17) ^ 5, dynamicClosureCall(plain, input), "noncapturing");
        write(round + 9);
        checkValue((input + round + 9) ^ 7, dynamicClosureCall(changing, input), "mutation");
        checkValue(input, dynamicClosureCall(repeated, input), "repeated reads");
        checkValue((input * 3 + round + 9) ^ 5,
            dynamicClosureCall(reference, input), "reference fallback");
    }
}
remove shared;
checkValue(12, dynamicClosureCall(changing, 11), "unassigned capture fallback");
shared = 1125899906842624;
checkValue((11 + shared) ^ 7, dynamicClosureCall(changing, 11), "assigned again");

int unset;
try {
    dynamicClosureCall(first, unset);
    throw "DYNAMIC-CLOSURE-TEST", "NOTHING argument accepted";
} catch (hash<ExceptionInfo> ex) {
    if (ex.err == "DYNAMIC-CLOSURE-TEST") { rethrow; }
}
int effects = 0;
code<int(int)> effect = int sub (int value) { ++effects; return value + 1; };
for (int i = 0; i < 16; ++i) {
    checkValue(i + 1, dynamicClosureCall(effect, i), "effect fallback");
}
checkValue(16, effects, "effects exactly once");

# Simultaneous first calls share the variant, not its invocation captures.
const int Threads = 16;
Counter ready(Threads);
Counter done(Threads);
Gate start();
Queue errors();
code<int(int)> concurrent = dynamicClosureFactory(41);
start.enter();
for (int i = 0; i < Threads; ++i) {
    background sub (int input) {
        on_exit done.dec();
        ready.dec();
        start.enter();
        start.exit();
        try {
            for (int round = 0; round < 128; ++round) {
                checkValue((input * 3 + 41) ^ 5,
                    dynamicClosureCall(concurrent, input), "concurrent first entry");
            }
        } catch (hash<ExceptionInfo> ex) {
            errors.push(ex.desc);
        }
    }(i);
}
ready.waitForZero();
start.exit();
done.waitForZero();
if (errors.size()) { throw "DYNAMIC-CLOSURE-TEST", errors.get(); }
printf("dynamic-closure-entry: ok\n");
