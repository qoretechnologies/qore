#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
string libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
string qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
    ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc"
        : dirname(qore_bin) + "/qcc");
if (!is_file(qcc_bin)) {
    qcc_bin = "qcc";
}

string code = "%modern

int sub increment(int value) {
    return value + 1;
}

int sub addTen(int value) {
    return value + 10;
}

int sub defaulted(int value = 7) {
    return value;
}

int sub overloaded(int value) {
    return value + 100;
}

string sub overloaded(string value) {
    return value + \"!\";
}

nothing sub bump(reference<int> value) {
    ++value;
}

int sub exactCall() {
    code<int(int)> fn = \\increment();
    return fn(4);
}

int sub mutableCall(bool replace) {
    code<int(int)> fn = \\increment();
    if (replace) {
        fn = \\addTen();
    }
    return fn(4);
}

int sub defaultCall() {
    code<int()> fn = \\defaulted();
    return fn();
}

int sub overloadedCall() {
    code<int(int)> fn = \\overloaded();
    return fn(4);
}

int sub referenceCall() {
    code<nothing(reference<int>)> fn = \\bump();
    int value = 4;
    fn(\\value);
    return value;
}

string sub maybeNothing(bool assign) {
    code<int(int)> fn = \\increment();
    int value;
    if (assign) {
        value = 4;
    }
    try {
        return string(fn(value));
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
}

string sub sparseIntCall() {
    code<int(int)> fn = \\increment();
    list<int> values = (1, 2);
    delete values[1];
    try {
        return sprintf(\"%y\", (map fn($1), values));
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
}

float sub addHalf(float value) {
    return value + 0.5;
}

string sub sparseFloatCall() {
    code<float(float)> fn = \\addHalf();
    list<float> values = (1.0, 2.0);
    delete values[1];
    try {
        return sprintf(\"%y\", (map fn($1), values));
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
}

string sub largeIntCall() {
    code<int(int)> fn = \\increment();
    list<int> result = (map fn($1), (1125899906842624,));
    return string(result[0]);
}

string sub wrongTypeCall() {
    code<int(int)> fn = \\increment();
    list<auto> values = ();
    push values, \"wrong\";
    try {
        list<int> result = (map fn($1), values);
        return \"unexpected\";
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
}

printf(\"%d:%d:%d:%d:%d:%d:%s:%s:%s:%s:%s:%s\\n\", exactCall(),
    mutableCall(False), mutableCall(True), defaultCall(), overloadedCall(),
    referenceCall(), maybeNothing(False), maybeNothing(True), sparseIntCall(),
    sparseFloatCall(), largeIntCall(), wrongTypeCall());
";

string root = "/tmp/qore-aot-known-callref-fast-entry-" + string(getpid());
string source_path = root + ".qr";
File source();
source.open2(source_path, O_WRONLY | O_CREAT | O_TRUNC);
source.write(code);
source.close();

on_exit {
    unlink(source_path);
    unlink(root + "-enabled");
    unlink(root + "-disabled");
    unlink(root + "-guarded-disabled");
    unlink(root + "-context-disabled");
}

string expected = "5:5:14:7:104:5:RUNTIME-(OVERLOAD|TYPE)-ERROR:5:"
    "RUNTIME-(OVERLOAD|TYPE)-ERROR:RUNTIME-(OVERLOAD|TYPE)-ERROR:"
    "1125899906842625:RUNTIME-(OVERLOAD|TYPE)-ERROR\\n";
foreach string mode in (("ast", "ir", "tiered", "jit")) {
    string actual = backquote(sprintf(
        "LD_LIBRARY_PATH=%s %s -b --exec-mode=%s %s 2>&1",
        libqore_dir, qore_bin, mode, source_path));
    if (!actual.regex("^" + expected + "$")) {
        printf("unexpected %s result:\n%s", mode, actual);
        exit(2);
    }
}

foreach hash<string, string> variant in ((
        ("name": "enabled", "env": ""),
        ("name": "disabled",
            "env": "QORE_DISABLE_AOT_KNOWN_CALLREF_FAST_ENTRY=1"),
        ("name": "guarded-disabled",
            "env": "QORE_DISABLE_AOT_GUARDED_CALLREF_NATIVE_ARGS=1"),
        ("name": "context-disabled",
            "env": "QORE_DISABLE_IR_NATIVE_CALLREF_IMPLICIT_CONTEXT=1"))) {
    string executable = root + "-" + variant.name;
    string compile_out = backquote(sprintf(
        "LD_LIBRARY_PATH=%s %s %s -O3 -o %s %s 2>&1",
        libqore_dir, variant.env, qcc_bin, executable, source_path));
    if (!is_file(executable)) {
        printf("%s AOT compile failed:\n%s", variant.name, compile_out);
        exit(2);
    }
    string actual = backquote(sprintf("LD_LIBRARY_PATH=%s %s 2>&1",
        libqore_dir, executable));
    if (!actual.regex("^" + expected + "$")) {
        printf("unexpected %s AOT result:\n%s", variant.name, actual);
        exit(2);
    }
}
