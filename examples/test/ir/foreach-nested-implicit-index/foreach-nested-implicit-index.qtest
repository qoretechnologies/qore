#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - JIT and AOT code generation of the implicit index of foreach statements
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - every check runs the script in a child process that sets its own --exec-mode, or AOT

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires ../../TestInterpreter.qm
%requires FsUtil
%requires ../../ExecModeHarness.qm

%exec-class ForeachNestedImplicitIndexTest

#! issue #6383: $# in a foreach over a reference or a fused pipeline nested in the body of another foreach
/** The IR lowering of a foreach statement over a value lowers \c $# in its body to its index (the virtual implicit
    element); the lowerings of a foreach over a reference (<tt>foreach auto y in (\\l)</tt>) and over a fused map,
    select or take pipeline set the implicit element at run time but left the virtual element of an enclosing
    foreach, so in their body nested in the body of another foreach, \c $# gave the outer loop's index in ir, jit,
    tiered and AOT executables.

    foreach-nested-implicit-index.q prints the values; the AST interpreter's output must be the expected one, and
    every other execution mode, the IR tier and AOT executables compiled with -O0 and -O3 must give the same.
*/
class ForeachNestedImplicitIndexTest inherits QUnit::Test {
    public {
        #! the output of the script
        const Expected = (
            "ref in foreach [0, 1, 0, 1]",
            "typed ref in foreach, outer after [[10, 11, 12], 0, [20, 21, 22], 1]",
            "fused map in foreach [0, 10, 1, 12, 0, 0, 10, 1, 12, 1]",
            "fused select in foreach [0, 1, 0, 1]",
            "fused take in foreach [0, 1, 0, 1]",
            "ref in ref [[0, 1, 0, 1], [0, 1]]",
            "fused in ref [[0, 1, 0, 1], [10, 11]]",
            "continue break call [0, 1, 0, 1, [100, 1, 102], 0, 0, 1, 0, 1, [100, 1, 102], 1]",
            "method [[0, 10], 0, [0, 10], 1]",
            "closure [0, 1, 0, 1]",
            "ref/ref on_exit 0",
            "value/ref catch 0 7",
            "value/ref catch 1 8",
            "value/fused catch 0 7",
            "value/fused catch 1 8",
            "value/value on_exit 0",
            "ref/value on_exit 0",
            "ref/fused on_exit 0",
            "inner on_exit [0, 1, 0, 1]",
        );
    }

    private {
        string qore_bin;
        string qcc_bin;
        string env;
        string script;
    }

    constructor() : QUnit::Test("foreach nested implicit index", "1.0", \ARGV) {
        qore_bin = TestInterpreter::qore_interpreter();
        string libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
            ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");
        env = sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s QORE_LIBDIR=%s", libqore_dir, libqore_dir, libqore_dir);
        script = get_script_dir() + "/foreach-nested-implicit-index.q";

        addTestCase("AST interpreter", \astTest());
        addTestCase("execution modes", \modesTest());
        addTestCase("AOT executable -O0", \aotTest(), "-O0");
        addTestCase("AOT executable -O3", \aotTest(), "-O3");
        set_return_value(main());
    }

    #! checks the output of the AST interpreter, which the other modes must give
    private astTest() {
        list<string> lines = select ast().split("\n"), $1;
        assertEq(Expected, lines);
    }

    #! runs the script in every execution mode and on the IR tier
    private modesTest() {
        string exp = ast();
        foreach string mode in (ExecModeHarness::ExecModes) {
            if (mode == "ast") {
                continue;
            }
            assertEq(exp, ExecModeHarness::run(sprintf("%s %s --exec-mode=%s %s", env, qore_bin, mode, script)), mode);
        }
        assertEq(exp, ExecModeHarness::run_ir_tier(sprintf("%s %s --exec-mode=tiered %s", env, qore_bin, script)),
            ExecModeHarness::IRTierName);
    }

    #! compiles the script with qcc and checks that the executable gives the output of the AST interpreter
    private aotTest(string opt) {
        if (!is_file(qcc_bin)) {
            testSkip("qcc is not available at " + qcc_bin);
        }
        TmpDir dir("foreach-nested-implicit-index-aot-");
        string exe = dir.path + "/foreach-nested-implicit-index";
        string out = ExecModeHarness::run_any(sprintf("%s %s %s -o %s %s", env, qcc_bin, opt, exe, script));
        assertTrue(is_file(exe), "qcc " + opt + " compiles the script: " + out);
        assertEq(ast(), ExecModeHarness::run_any(sprintf("%s %s", env, exe)), "AOT " + opt);
    }

    #! returns the output of the script with the AST interpreter
    private string ast() {
        return ExecModeHarness::run(sprintf("%s %s --exec-mode=ast %s", env, qore_bin, script));
    }
}
