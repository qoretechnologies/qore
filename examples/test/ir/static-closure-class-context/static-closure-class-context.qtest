#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../ExecModeHarness.qm

%exec-class StaticClosureClassContextTest

#! Tests that a closure created in a static method keeps its class context on the IR tier
/** A closure created in a static method has no captured object, but it keeps the lexical class context of the
    method, which gives it access to the class's private members.  When the IR interpreter ran such a closure in its
    caller, it set the class context only for a closure with a captured object, so a call of a private constructor or
    private static method raised \c RUNTIME-OVERLOAD-ERROR once the closure was on the IR tier, with IR and tiered
    execution.

    The worker calls the closure more often than the IR threshold; it runs in every execution mode through
    ExecModeHarness and as a qcc-compiled executable.
*/
class StaticClosureClassContextTest inherits QUnit::Test {
    public {
        const Expected = "2500\n";
    }

    private {
        string qore_bin;
        string libqore_dir;
        *string qcc_bin;
        string env;
        string worker;
    }

    constructor() : QUnit::Test("StaticClosureClassContextTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE;
        if (!qcc_bin) {
            foreach string dir in ((libqore_dir, dirname(qore_bin))) {
                if (is_file(dir + DirSep + "qcc")) {
                    qcc_bin = dir + DirSep + "qcc";
                    break;
                }
            }
        }
        env = sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s", libqore_dir, libqore_dir);
        worker = get_script_dir() + DirSep + "static-closure-class-context-worker.q";

        addTestCase("each execution mode", \testExecModes());
        addTestCase("qcc-compiled executable", \testCompiled());
        set_return_value(main());
    }

    testExecModes() {
        foreach string mode in (ExecModeHarness::ExecModes) {
            assertEq(Expected, ExecModeHarness::run(sprintf("%s %s -b --enable-debug --exec-mode=%s %s", env,
                qore_bin, mode, worker)), mode);
        }
    }

    testCompiled() {
        if (!qcc_bin) {
            testSkip(sprintf("the in-tree qcc executable is not available in %y; set QCC to test compiled code",
                libqore_dir));
        }
        TmpDir tmp("qore-static-closure-class-context-");
        string exe = tmp.path + DirSep + "static-closure-class-context";
        string compile_out = backquote(sprintf("%s %s -o %s %s 2>&1", env, qcc_bin, exe, worker));
        assertTrue(is_file(exe), "qcc: " + compile_out);
        assertEq(Expected, backquote(sprintf("%s %s 2>&1", env, exe)), "aot");
    }
}
