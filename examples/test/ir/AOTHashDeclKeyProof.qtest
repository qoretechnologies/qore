#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
string libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
string qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
    ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : dirname(qore_bin) + "/qcc");
if (!is_file(qcc_bin)) {
    qcc_bin = "qcc";
}

string root = "/tmp/qore-aot-hashdecl-key-proof-" + string(getpid());
mkdir(root);
string source_path = root + "/case.qr";
string source = "%modern

hashdecl Item {
    int base;
    int value;
    string label = \"default\";
}

hashdecl SoftItem {
    softint value;
}

hashdecl OptionalItem {
    *int value;
}

auto sub opaque(auto value) {
    return value;
}

string sub errorName(code<nothing()> action) {
    try {
        action();
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
    return \"accepted\";
}

Item sub known() {
    Item value((\"value\": opaque(2), \"base\": opaque(1)));
    return value;
}

Item sub fullExact(int base, int value, string label) {
    Item item((\"base\": base, \"value\": value, \"label\": label));
    return item;
}

Item sub reorderedExact(int base, int value, string label) {
    Item item((\"value\": value, \"base\": base, \"label\": label));
    return item;
}

Item sub partialExact(int base, int value) {
    Item item((\"base\": base, \"value\": value));
    return item;
}

int sub softValue() {
    SoftItem item((\"value\": \"10\"));
    return item.value;
}

bool sub optionalValue() {
    OptionalItem item((\"value\": NOTHING));
    return item.value === NOTHING;
}

string sub invalidValue() {
    return errorName(sub () {
        Item invalid((\"base\": opaque(1), \"value\": opaque(\"bad\")));
    });
}

string sub invalidKey() {
    return errorName(sub () {
        hash<auto> init = (\"base\": 1, \"value\": 2);
        init{opaque(\"unknown\")} = 3;
        Item invalid(init);
    });
}

string sub unassignedValue() {
    return errorName(sub () {
        int missing;
        Item invalid((\"base\": 1, \"value\": missing));
    });
}

string sub removedValue() {
    return errorName(sub () {
        int missing = 2;
        remove missing;
        Item invalid((\"base\": 1, \"value\": missing));
    });
}

string sub deletedValue() {
    return errorName(sub () {
        int missing = 2;
        delete missing;
        Item invalid((\"base\": 1, \"value\": missing));
    });
}

int sub main() {
    Item value = known();
    Item full = fullExact(3, 4, \"full\");
    Item reordered = reorderedExact(5, 6, \"reordered\");
    Item partial = partialExact(7, 8);
    printf(\"%d:%d:%s:%d:%d:%s:%d:%d:%s:%d:%d:%s:%d:%y:%s:%s:%s:%s:%s\\n\",
        value.base, value.value, value.label,
        full.base, full.value, full.label,
        reordered.base, reordered.value, reordered.label,
        partial.base, partial.value, partial.label,
        softValue(), optionalValue(),
        invalidValue(), invalidKey(), unassignedValue(), removedValue(), deletedValue());
    return 0;
}

main();
";

File file();
file.open2(source_path, O_WRONLY | O_CREAT | O_TRUNC);
file.write(source);
file.close();

string env = sprintf("LD_LIBRARY_PATH=%s", libqore_dir);
hash<string, string> outputs;
foreach string mode in (("ast", "ir", "jit", "tiered")) {
    outputs{mode} = backquote(sprintf("%s %s --exec-mode=%s %s 2>&1",
        env, qore_bin, mode, source_path));
}

string enabled_exe = root + "/enabled";
string enabled_compile = backquote(sprintf(
    "%s QORE_AOT_DEBUG=1 %s -O3 --strip-source -o %s %s 2>&1",
    env, qcc_bin, enabled_exe, source_path));
if (!is_file(enabled_exe)) {
    printf("enabled compile failed:\n%s", enabled_compile);
    exit(2);
}

string checked_exe = root + "/checked";
string checked_compile = backquote(sprintf(
    "%s QORE_AOT_DEBUG=1 QORE_DISABLE_IR_HASHDECL_KEY_PROOF=1 %s -O3 --strip-source -o %s %s 2>&1",
    env, qcc_bin, checked_exe, source_path));
if (!is_file(checked_exe)) {
    printf("checked compile failed:\n%s", checked_compile);
    exit(2);
}

string value_checked_exe = root + "/value-checked";
string value_checked_compile = backquote(sprintf(
    "%s QORE_AOT_DEBUG=1 QORE_DISABLE_IR_HASHDECL_VALUE_PROOF=1 %s -O3 --strip-source -o %s %s 2>&1",
    env, qcc_bin, value_checked_exe, source_path));
if (!is_file(value_checked_exe)) {
    printf("value-checked compile failed:\n%s", value_checked_compile);
    exit(2);
}

foreach string name in (("known", "invalidValue", "unassignedValue")) {
    if (!enabled_compile.regex(sprintf(
            "hashdecl initializer key scan elided in '[^']*%s", name))) {
        printf("missing key proof for %s:\n%s", name, enabled_compile);
        exit(2);
    }
}
if (enabled_compile.regex("hashdecl initializer key scan elided in '[^']*invalidKey")
        || checked_compile.regex("hashdecl initializer key scan elided")) {
    printf("unexpected hashdecl key proof:\nenabled:\n%schecked:\n%s",
        enabled_compile, checked_compile);
    exit(2);
}


foreach string name in (("fullExact", "reorderedExact", "partialExact")) {
    if (!enabled_compile.regex(sprintf(
            "hashdecl initializer value checks elided in '[^']*%s", name))) {
        printf("missing value proof for %s:\n%s", name, enabled_compile);
        exit(2);
    }
}
foreach string name in (("fullExact",)) {
    if (!enabled_compile.regex(sprintf(
            "hashdecl initializer layout normalization elided in '[^']*%s", name))) {
        printf("missing layout proof for %s:\n%s", name, enabled_compile);
        exit(2);
    }
}
foreach string name in (("softValue", "optionalValue", "invalidValue",
        "unassignedValue", "removedValue", "deletedValue")) {
    if (enabled_compile.regex(sprintf(
            "hashdecl initializer value checks elided in '[^']*%s", name))) {
        printf("unexpected value proof for %s:\n%s", name, enabled_compile);
        exit(2);
    }
}
if (enabled_compile.regex(
        "hashdecl initializer layout normalization elided in '[^']*(reorderedExact|partialExact)")
        || value_checked_compile.regex("hashdecl initializer (value checks|layout normalization) elided")) {
    printf("unexpected hashdecl value/layout proof:\nenabled:\n%svalue-checked:\n%s",
        enabled_compile, value_checked_compile);
    exit(2);
}

outputs.enabled = backquote(sprintf("%s %s 2>&1", env, enabled_exe));
outputs.checked = backquote(sprintf("%s %s 2>&1", env, checked_exe));
outputs.value_checked = backquote(sprintf("%s %s 2>&1", env, value_checked_exe));

string expected = "1:2:default:3:4:full:5:6:reordered:7:8:default:10:True:"
    + "RUNTIME-TYPE-ERROR:HASHDECL-INIT-ERROR:RUNTIME-TYPE-ERROR:RUNTIME-TYPE-ERROR:"
    + "RUNTIME-TYPE-ERROR\n";
foreach string mode in (keys outputs) {
    string output = outputs{mode};
    if (output != expected) {
        printf("%s execution mismatch:\nexpected:\n%sactual:\n%s",
            mode, expected, output);
        exit(2);
    }
}
