#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
#
# Copyright (C) 2003 - 2026 Qore Technologies, s.r.o.
#
# Verifies that a component keeps one identity across a dependency-graph
# transition, and that a build which cannot publish says which of the two
# possible causes it hit.
#
# The graph an incremental AOT build schedules against is not immutable: qcc
# records the compile contract of every provider it was compiled against, and
# qore-qo-source-order promotes those depfile entries to required edges.  A
# compile therefore rewrites part of the graph that decides other components'
# membership, predecessors and numbering.  These tests pin the two properties
# that make that safe: a component key names the same member set or nothing at
# all, and a publication states which graph it was planned against.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil
%requires Util
%requires json

%exec-class AOTSccGraphTransitionTest

class AOTSccGraphTransitionTest inherits QUnit::Test {
    private {
        string qore_bin;
        string source_order_tool;

        #! Every artifact a member must leave behind before it can be published.
        /** memberArtifacts() in qore-qo-source-order is the authority; the
            depfile is written separately here because its content is what these
            tests manipulate.
        */
        const MemberArtifactSuffixes = (
            "", ".idx.json", ".status.json", ".content.stamp",
            ".compile-contract.stamp", ".aggregate-contract.stamp", ".stamp",
            ".source.manifest.json", ".source-parse-defines",
        );

        #! qore-qo-source-order's exit status for "member sources moved".
        const ExitSourcesMoved = 75;
        #! qore-qo-source-order's exit status for "the dependency graph moved".
        const ExitGraphTransition = 76;
    }

    constructor() : QUnit::Test("AOTSccGraphTransitionTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        source_order_tool = normalize_dir(get_script_dir() + "/../../../tools")
            + DirSep + "qore-qo-source-order";

        addTestCase("a component index is not a durable name",
            \testComponentIndexIsNotADurableName());
        addTestCase("the graph generation names the depfile edge set",
            \testGraphGenerationNamesTheDepfileEdgeSet());
        addTestCase("the source token covers only member sources",
            \testSourceTokenCoversOnlyMemberSources());
        addTestCase("publication tells source edits from graph transitions",
            \testPublicationSeparatesCauses());
        addTestCase("a vanished component key is a graph transition",
            \testVanishedKeyIsAGraphTransition());
        addTestCase("published records name one graph generation",
            \testPublishedRecordsNameOneGraphGeneration());
        addTestCase("the compile plan names the graph it was selected from",
            \testCompilePlanNamesItsGraph());

        set_return_value(main());
    }

    #! Runs the helper with \a args verbatim and returns its output and status.
    private hash<auto> run(softlist<string> args) {
        list<string> command = (sprintf("%y", qore_bin), sprintf("%y", source_order_tool));
        foreach string arg in (args) {
            push command, sprintf("%y", arg);
        }
        string output = backquote("{ " + join(" ", command) + "; } 2>&1; echo \"rc=$?\"");
        int marker = output.rfind("rc=");
        return (
            "output": output.substr(0, marker),
            "rc": output.substr(marker + 3).toInt(),
        );
    }

    #! Runs the helper and asserts that it succeeded, returning trimmed output.
    private string ok(softlist<string> args) {
        hash<auto> result = run(args);
        assertEq(0, result.rc, sprintf("qore-qo-source-order %y failed: %s",
            args, result.output));
        return trim(result.output);
    }

    private write(string path, string body) {
        File f();
        f.open2(path, O_WRONLY | O_CREAT | O_TRUNC);
        f.write(body);
        f.close();
    }

    #! Writes a qcc object-group context whose sources share no symbols.
    /** Every required edge in these tests therefore comes from a depfile, which
        is exactly the half of the graph the build itself writes.
    */
    private string writeContext(string root, list<string> names,
            *string suffix) {
        string src_dir = root + "/src";
        string qo_dir = root + "/qo";
        mkdir(src_dir, 0777, True);
        mkdir(qo_dir, 0777, True);
        list<string> lines = ("format=1", "kind=qcc-object-group",
            "group=scc-transition-test");
        foreach string name in (names) {
            write(src_dir + "/" + name + ".qc", isolatedSource(name));
        }
        foreach string name in (names) {
            push lines, "input=" + src_dir + "/" + name + ".qc";
        }
        foreach string name in (names) {
            push lines, "output=" + qo_dir + "/" + name + ".qo";
        }
        string path = qo_dir + "/.qcc-context" + (suffix ?? "");
        write(path, join("\n", lines) + "\n");
        return path;
    }

    #! A source that provides one uniquely named symbol and mentions no other.
    private string isolatedSource(string name) {
        return sprintf("%%new-style\nstring sub %sFunc() {\n    return \"%s\";\n}\n",
            name, name);
    }

    #! Writes NAME's depfile so that it records a compile against \a providers.
    /** This is the shape qcc emits with --depfile-compile-contract-stamps, and
        it is what addDepfileContractEdges() reads back as required edges.
    */
    private writeDepfile(string qo_dir, string name, softlist<string> providers) {
        list<string> deps = (qo_dir + "/../src/" + name + ".qc",);
        foreach string provider in (providers) {
            push deps, qo_dir + "/" + provider + ".qo.compile-contract.stamp";
        }
        write(qo_dir + "/" + name + ".qo.d",
            qo_dir + "/" + name + ".qo.stamp:"
            + join("", (map " \\\n    " + $1, deps)) + "\n");
    }

    #! Writes every artifact except the depfile, so the member can be published.
    private writeArtifacts(string qo_dir, string name) {
        foreach string suffix in (MemberArtifactSuffixes) {
            write(qo_dir + "/" + name + ".qo" + suffix, name + suffix + "\n");
        }
    }

    #! index, key and member count of the component that publishes NAME.
    private hash<auto> componentFor(string context_path, string qo_dir, string name) {
        list<string> fields = ok(("--scc-for", context_path,
            qo_dir + "/" + name + ".qo")).split("\t");
        assertEq(3, fields.size(), "--scc-for emits index, key and size");
        return ("index": fields[0], "key": fields[1], "size": fields[2].toInt());
    }

    #! The member outputs of the component named by \a selector.
    private list<string> members(string context_path, string selector) {
        list<string> names = ();
        foreach string line in (ok(("--scc-members", context_path, selector)).split("\n")) {
            if (line) {
                push names, basename(line.split("\t")[1]);
            }
        }
        return sort(names);
    }

    private string graphGeneration(string context_path) {
        return ok(("--scc-graph-generation", context_path));
    }

    private string sourceToken(string context_path, string selector) {
        return ok(("--scc-source-token", context_path, selector));
    }

    #! A four-source group whose depfiles put a and b in one cyclic component.
    /** Node order is a, b, c, d, and components are numbered by lowest member,
        so the cycle makes the decomposition {a,b}=0, {c}=1, {d}=2.  Dropping one
        of the two depfile edges splits the cycle and renumbers everything above
        it -- which is the transition every test here is built on.
    */
    private hash<auto> cyclicFixture(string root) {
        list<string> names = ("a", "b", "c", "d");
        string context_path = writeContext(root, names);
        string qo_dir = root + "/qo";
        foreach string name in (names) {
            writeArtifacts(qo_dir, name);
        }
        writeDepfile(qo_dir, "a", "b");
        writeDepfile(qo_dir, "b", "a");
        writeDepfile(qo_dir, "c", ());
        writeDepfile(qo_dir, "d", ());
        return ("context": context_path, "qo_dir": qo_dir, "names": names);
    }

    #! Rewrites b's depfile without the contract edge that closed the cycle.
    /** This is what a real compile does when a source stops needing a provider:
        it rewrites its own depfile, and every other component in the group sees
        a different graph the next time the helper runs.
    */
    private splitCycle(string qo_dir) {
        writeDepfile(qo_dir, "b", ());
    }

    testComponentIndexIsNotADurableName() {
        TmpDir tmp("qore-aot-scc-index-");
        hash<auto> fixture = cyclicFixture(tmp.path);
        string context_path = fixture.context;
        string qo_dir = fixture.qo_dir;

        hash<auto> before = componentFor(context_path, qo_dir, "d");
        assertEq("2", before.index,
            "the cycle leaves d as the third component of three");
        assertEq(1, before.size, "d is a singleton component");
        assertEq(("d.qo",), members(context_path, before.index),
            "the index names d while the cycle stands");
        assertEq(("a.qo", "b.qo"), members(context_path, "0"),
            "the cycle is one component");

        splitCycle(qo_dir);

        # The hazard: nothing about d changed, but the number that named it now
        # names its neighbour, because a component the build recompiled split.
        assertEq(("c.qo",), members(context_path, before.index),
            "the same index names a different component after the transition");
        # The property that makes the build safe: the key is a digest of the
        # member output set, so it survives the renumbering.
        assertEq(("d.qo",), members(context_path, before.key),
            "the key still names d after the transition");

        hash<auto> after = componentFor(context_path, qo_dir, "d");
        assertEq(before.key, after.key, "d keeps its component key");
        assertNeq(before.index, after.index, "d does not keep its component index");
        assertEq(("a.qo",), members(context_path, "0"),
            "the split cycle decomposes into singletons");
    }

    testGraphGenerationNamesTheDepfileEdgeSet() {
        TmpDir tmp("qore-aot-scc-graphgen-");
        hash<auto> fixture = cyclicFixture(tmp.path);
        string context_path = fixture.context;
        string qo_dir = fixture.qo_dir;

        string cyclic = graphGeneration(context_path);
        assertRegex("^graph-[0-9a-f]{16}$", cyclic,
            "the graph generation is a content-addressed name");
        assertEq(cyclic, graphGeneration(context_path),
            "an unchanged edge set keeps its generation");

        splitCycle(qo_dir);
        string split = graphGeneration(context_path);
        assertNeq(cyclic, split, "removing a required edge is a new generation");

        # The generation is a function of the edge set alone, so restoring the
        # edge restores the name: a build that oscillates cannot manufacture an
        # endless sequence of distinct generations.
        writeDepfile(qo_dir, "b", "a");
        assertEq(cyclic, graphGeneration(context_path),
            "restoring the edge restores the generation");

        # Node indexes are a property of the order CMake happened to emit, so
        # they must not reach the generation's preimage.  This context names the
        # same sources, the same outputs and the same depfiles in a different
        # order, which renumbers every node without changing one edge.
        string reordered = writeContext(tmp.path, ("d", "c", "b", "a"), ".reordered");
        assertEq(cyclic, graphGeneration(reordered),
            "reordering the context source list preserves the generation");
        assertNeq(componentFor(context_path, qo_dir, "d").index,
            componentFor(reordered, qo_dir, "d").index,
            "the reordered context really does renumber the components");
        assertEq(componentFor(context_path, qo_dir, "d").key,
            componentFor(reordered, qo_dir, "d").key,
            "component keys survive the renumbering too");
    }

    testSourceTokenCoversOnlyMemberSources() {
        TmpDir tmp("qore-aot-scc-token-");
        hash<auto> fixture = cyclicFixture(tmp.path);
        string context_path = fixture.context;
        string qo_dir = fixture.qo_dir;

        string key = componentFor(context_path, qo_dir, "c").key;
        string token = sourceToken(context_path, key);

        # A required edge appearing elsewhere in the group changes the
        # decomposition and c's component index, but not one byte of c's source.
        splitCycle(qo_dir);
        assertEq(token, sourceToken(context_path, key),
            "a graph transition elsewhere leaves the source token alone");

        # A predecessor's published contract is part of the generation token, not
        # of the source token: only the latter is a compare-and-swap over inputs
        # an agent outside the build can move.
        write(qo_dir + "/a.qo.compile-contract.stamp", "a rebuilt contract\n");
        assertEq(token, sourceToken(context_path, key),
            "a predecessor contract rewrite leaves the source token alone");

        # The one thing it must react to.
        write(tmp.path + "/src/c.qc", isolatedSource("c") + "# edited\n");
        assertNeq(token, sourceToken(context_path, key),
            "editing the member source moves the source token");
    }

    testPublicationSeparatesCauses() {
        TmpDir tmp("qore-aot-scc-publish-");
        hash<auto> fixture = cyclicFixture(tmp.path);
        string context_path = fixture.context;
        string qo_dir = fixture.qo_dir;

        string key = componentFor(context_path, qo_dir, "d").key;
        string token = sourceToken(context_path, key);
        string generation = graphGeneration(context_path);
        string record_path = qo_dir + "/.qcc-scc/" + key + ".generation.json";

        ok(("--scc-publish", "--expect", token, "--expect-graph", generation,
            context_path, key));
        assertTrue(is_file(record_path), "a matching publication writes the record");
        hash<auto> record = parse_json(ReadOnlyFile::readTextFile(record_path));
        assertEq(key, record.scc, "the record names its component");
        assertEq(generation, record.graph_generation,
            "the record names the graph it was published against");
        string published = record.generation;

        # A stale graph generation is the build's own doing, so it must not be
        # reported as, or share an exit status with, an external source edit.
        hash<auto> stale_graph = run(("--scc-publish", "--expect", token,
            "--expect-graph", "graph-0000000000000000", context_path, key));
        assertEq(ExitGraphTransition, stale_graph.rc,
            "a stale graph generation is refused as a graph transition");
        assertTrue(stale_graph.output.find("dependency graph") >= 0,
            "the diagnostic names the dependency graph: " + stale_graph.output);
        assertEq(published,
            parse_json(ReadOnlyFile::readTextFile(record_path)).generation,
            "a refused publication leaves the previous record intact");

        # An edited member source is the one condition that does implicate
        # something outside the build.
        write(tmp.path + "/src/d.qc", isolatedSource("d") + "# externally edited\n");
        hash<auto> moved = run(("--scc-publish", "--expect", token,
            "--expect-graph", generation, context_path, key));
        assertEq(ExitSourcesMoved, moved.rc, "a moved member source is refused as moved");
        assertTrue(moved.output.find("moved") >= 0,
            "the diagnostic reports moved sources: " + moved.output);

        # Source movement is checked before the graph, so a build whose sources
        # were edited is never told to look at its own scheduler instead.
        hash<auto> both = run(("--scc-publish", "--expect", token,
            "--expect-graph", "graph-0000000000000000", context_path, key));
        assertEq(ExitSourcesMoved, both.rc,
            "moved sources outrank a graph transition");
    }

    testVanishedKeyIsAGraphTransition() {
        TmpDir tmp("qore-aot-scc-vanished-");
        hash<auto> fixture = cyclicFixture(tmp.path);
        string context_path = fixture.context;
        string qo_dir = fixture.qo_dir;

        string cycle_key = componentFor(context_path, qo_dir, "a").key;
        assertEq(2, componentFor(context_path, qo_dir, "a").size,
            "a and b share one component while the cycle stands");

        splitCycle(qo_dir);

        # The two-member component no longer exists: its key names a member set
        # the current decomposition does not contain.  That is a transition, not
        # a malformed argument, and the caller can act on it by re-resolving.
        foreach string command in (("--scc-members", "--scc-source-token",
                "--scc-lock", "--scc-preload", "--scc-compile-plan")) {
            hash<auto> result = run((command, context_path, cycle_key));
            assertEq(ExitGraphTransition, result.rc,
                command + " reports a vanished key as a graph transition");
            assertTrue(result.output.find("decomposition changed") >= 0,
                command + " explains the transition: " + result.output);
        }

        # An index that does not resolve is a different thing entirely: no index
        # is ever a durable name, so nothing can be inferred from it moving.
        hash<auto> bad_index = run(("--scc-members", context_path, "99"));
        assertEq(1, bad_index.rc, "an out-of-range index stays a plain failure");
        assertTrue(bad_index.output.find("no such strongly connected component") >= 0,
            "an out-of-range index keeps its own diagnostic: " + bad_index.output);
    }

    testPublishedRecordsNameOneGraphGeneration() {
        TmpDir tmp("qore-aot-scc-records-");
        hash<auto> fixture = cyclicFixture(tmp.path);
        string context_path = fixture.context;
        string qo_dir = fixture.qo_dir;

        ok(("--scc-publish-all", context_path));
        string generation = graphGeneration(context_path);
        Dir records();
        records.chdir(qo_dir + "/.qcc-scc");
        list<string> files = records.listFiles("^scc-.*\\.generation\\.json$");
        assertEq(3, files.size(),
            "the group publishes one record per component");
        foreach string file in (files) {
            hash<auto> record =
                parse_json(ReadOnlyFile::readTextFile(qo_dir + "/.qcc-scc/" + file));
            assertEq(generation, record.graph_generation,
                file + " names the group's graph generation");
        }
    }

    testCompilePlanNamesItsGraph() {
        TmpDir tmp("qore-aot-scc-plan-");
        hash<auto> fixture = cyclicFixture(tmp.path);
        string context_path = fixture.context;
        string qo_dir = fixture.qo_dir;

        string key = componentFor(context_path, qo_dir, "c").key;
        hash<string, string> plan = {};
        foreach string line in (ok(("--scc-compile-plan", context_path, key)).split("\n")) {
            if (line) {
                list<string> fields = line.split("\t");
                plan{fields[0]} = fields[1];
            }
        }
        assertEq("0", plan.current, "an unpublished component is not current");
        assertEq(graphGeneration(context_path), plan."graph-generation",
            "the plan names the graph its preload was selected from");
        assertEq(sourceToken(context_path, key), plan."source-token",
            "the plan names the component's source token");
    }
}
