#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
#
# Functions compiled in the background register the EH frames of their code with libgcc.  A compile that is still in
# LLVM when qore_cleanup() stops the compiler is detached, and qore_cleanup() waits for it before it releases the JIT
# (issue #6296), which deregisters the frames (issue #5842): otherwise libgcc frees its table of registered frames at
# exit, and the memory that it allocated for each frame is lost.  The compile of held() is held in LLVM at the end,
# and qore_cleanup() lets it go.  Needs a debug libqore (dbg_hold_bg_compile()); see JitTeardownAtExit.qc.
#
# With the argument "min", f2 is not called: one function (f1) is compiled before held(), which the runs under
# valgrind use (see JitTeardownAtExit.qc).

int sub f1(int x) { int s; for (int i = 0; i < x; ++i) { s += i * 2; } return s; }
int sub f2(int x) { int s; for (int i = 0; i < x; ++i) { s += i * 3; } return s; }
int sub held(int x) { int s; for (int i = 0; i < x; ++i) { s += i * 4; } return s; }

# f1 and f2 (f1 only with "min") are compiled in the background, so that their code is in the JIT
bool minimal = ARGV[0] == "min";
int t = f1(10) + (minimal ? 0 : f2(10));
t += f1(10) + (minimal ? 0 : f2(10));
call_function("dbg_wait_bg_compile_idle");
# the compile of held() is still in LLVM at the end of the process
call_function("dbg_hold_bg_compile", "llvm", "held");
t += held(10);
t += held(10);
bool h = call_function("dbg_wait_bg_compile_held", "llvm", 60000);
printf("held: %y result: %d\n", h, t);
