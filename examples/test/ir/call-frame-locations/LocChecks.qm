# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
module LocChecks {
    version = "1.0";
    desc = "call stack location checks";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
}

public namespace LocChecks {
int sub bad() {
    throw "ERR", "x";
}

class C {
    int m() {
        return bad();
    }

    static int s() {
        return bad();
    }
}

sub g(*int v) {
}

int sub via_function() {
    g(bad());
    return 0;
}

int sub via_method() {
    C c();
    return c.m();
}

int sub via_static() {
    return C::s();
}

int sub ok() {
    int x = 1;
    return x;
}

# raises an exception on the line of a call that returned
int sub via_same_line() {
    int v = ok(); throw "ERR", "after the call " + v;
}

int sub via_closure() {
    code c = int sub () { return bad(); };
    return c();
}

# AOT code can run the fast entry of this function with the context of its caller
int sub divide(int a, int b) {
    return a / b;
}

int sub via_division() {
    int v = divide(10, 0);
    return v;
}

class D {
    int div(int a, int b) {
        return a / b;
    }

    static int sdiv(int a, int b) {
        return a / b;
    }
}

int sub via_method_division() {
    D d();
    return d.div(10, 0);
}

int sub via_static_division() {
    return D::sdiv(10, 0);
}

public string sub run() {
    list<string> out;
    foreach code f in ((\via_function(), \via_method(), \via_static(), \via_closure(), \via_same_line(),
            \via_division(), \via_method_division(), \via_static_division())) {
        try {
            f();
        } catch (hash<ExceptionInfo> ex) {
            # where the exception was raised, then the frames of this module, innermost first, without the call of
            # f() itself
            out += ((sprintf("@%d", ex.line),) + (map sprintf("%s:%d", $1.function, $1.line), ex.callstack,
                $1.file =~ /LocChecks/ && $1.function != "run")).join(",");
        }
    }
    return out.join("|");
}
}
