#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires ../../ExecModeHarness.qm

%exec-class CallFrameLocationsTest

#! Tests the locations of the call stack frames of an exception in each execution mode
/** The frame of a call is where the call was made, as AST execution reports it.  The IR interpreter, which also
    runs the first calls of JIT and tiered execution, gave the frame of a function, method or static method that it
    called directly the location of the callee's declaration instead, and it pushed no frame at all for a closure
    whose IR it ran directly (from the second call of the closure on).

    Native code (JIT) pushed no frame for a call that it made directly to a function compiled with it (a fast
    entry), so the callee was missing from the call stack, and the caller's location stayed the callee's after the
    call returned, so an exception raised later on the line of the call was reported in the callee; and the frames
    that runtime helpers pushed for methods were named without their class.
*/
class CallFrameLocationsTest inherits QUnit::Test {
    public {
        #! the results of LocChecks::run(): where the exception was raised, then the function of each frame and the
        #! line it was called from
        const Expected = (
            "@15,bad:32,via_function:64",
            "@15,bad:20,C::m:38,via_method:64",
            "@15,bad:24,C::s:42,via_static:64",
            "@15,bad:56,<anonymous closure>:57,via_closure:64",
            "@52,via_same_line:64",
        );
    }

    private {
        string qore_bin;
        string libqore_dir;
    }

    constructor() : QUnit::Test("CallFrameLocations", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);

        addTestCase("each execution mode", \testExecModes());

        set_return_value(main());
    }

    testExecModes() {
        string worker = get_script_dir() + DirSep + "call-frame-locations-worker.q";
        foreach string mode in (ExecModeHarness::ExecModes) {
            string out = ExecModeHarness::run(sprintf("LD_LIBRARY_PATH=%s QORE_MODULE_DIR=%s %s -b --exec-mode=%s %s",
                libqore_dir, get_script_dir(), qore_bin, mode, worker));
            list<string> lines = (map $1, out.split("\n"), $1.val());
            assertEq(3, lines.size(), mode + ": rounds: " + out);
            foreach string line in (lines) {
                assertEq(Expected, line.split("|"), sprintf("%s: round %d", mode, $#));
            }
        }
    }
}
