# Copyright (c) 2026 Qore Technologies, s.r.o.
# SPDX-License-Identifier: MIT
%modern
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil
%exec-class AOTReflectiveTypedWriteTest

class AOTReflectiveTypedWriteTest inherits QUnit::Test {
    private {
        string qore = realpath(ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0]);
        string libdir = realpath(ENV.QORE_LIBDIR ?? dirname(qore));
        string qcc = ENV.QCC ?? libdir + "/qcc";

        const Expected = "class:1:RUNTIME-TYPE-ERROR:1:RUNTIME-TYPE-ERROR:RUNTIME-TYPE-ERROR:1:10:TypedDerived\n"
            "optional:1:RUNTIME-TYPE-ERROR:RUNTIME-TYPE-ERROR:1:False\n"
            "class-loop:RUNTIME-TYPE-ERROR:6:10\n"
            "list:RUNTIME-TYPE-ERROR:20:[18]:[20, 3]:list<int>\n"
            "list:RUNTIME-TYPE-ERROR:20:[18]:[20, 3]:list<int>\n"
            "list:RUNTIME-TYPE-ERROR:20:[18]:[20, 3]:list<int>\n"
            "list:RUNTIME-TYPE-ERROR:20:[18]:[20, 3]:list<int>\n"
            "list:ok:43:[18]:[43, 3]:list<int>\n"
            "list:ok:44:[18]:[44, 3]:list<int>\n"
            "list-loop:RUNTIME-TYPE-ERROR:[103, 6, 7]\n"
            "scalars:RUNTIME-TYPE-ERROR,RUNTIME-TYPE-ERROR,ok,RUNTIME-TYPE-ERROR,ok,RUNTIME-TYPE-ERROR,ok,"
                "UNKNOWN-VARIABLE|6:integer:6.0:\"ab\":13:{c: 3, d: 4}:hash<string, int>\n"
            "read-only:RUNTIME-READONLY-VIOLATION,RUNTIME-READONLY-VIOLATION,RUNTIME-READONLY-VIOLATION,"
                "RUNTIME-READONLY-VIOLATION|5:[1, 2]:3:[4]:42\n"
            "int-loop:RUNTIME-TYPE-ERROR:101\n";
    }
    constructor() : Test("typed reflective local writes", "1.0", \ARGV) {
        addTestCase("refused and converted writes in every mode", \check());
        set_return_value(main());
    }
    private static string quote(string value) {
        return "'" + replace(value, "'", "'\"'\"'") + "'";
    }
    private string run(list<string> args, string prefix = "") {
        int status;
        string output = backquote(prefix + "LD_LIBRARY_PATH=" + quote(libdir)
            + " DYLD_LIBRARY_PATH=" + quote(libdir)
            + " QORE_JIT_SYNC_COMPILE=1 QORE_IR_THRESHOLD=1 QORE_JIT_THRESHOLD=1 "
            + (map quote($1), args).join(" ") + " 2>&1", \status);
        assertEq(0, status, output);
        return output;
    }
    private string body(string ir, string name) {
        *list<*string> found = regex_extract(ir,
            "(?s)define [^\n]*@" + name + "_[^\n]*\\(ptr %ctx, ptr %xsink\\)[^\n]*\n(.*?)\n\\}");
        assertTrue(!!found, name + " LLVM definition");
        return found[0] ?? "";
    }
    private check() {
        string source = get_script_dir() + "/AOTReflectiveTypedWrite.qr";
        foreach string mode in (("ast", "ir", "jit", "tiered")) {
            assertEq(Expected, run((qore, "--exec-mode=" + mode, source)), mode);
        }
        TmpDir dir("qore-reflective-typed-write-");
        foreach string prefix in (("", "QORE_AOT_EH=1 ", "QORE_DISABLE_AOT_CLASS_PARAM_CACHE=1 ",
                "QORE_DISABLE_AOT_PREPARED_LOCAL_RELOAD=1 ", "MAKEFLAGS= QCC_JOBS=4 QCC_SPLIT_THRESHOLD=1 ")) {
            foreach string level in (("-O0", "-O3")) {
                string executable = dir.path + "/fixture";
                string ir = run((qcc, level, "--strip-source", "-o", executable, source),
                    prefix + "QORE_DUMP_LLVM_IR=1 ");
                # the refused writes reach the guarded caches and prepared reloads of the compiled code
                foreach string name in (("classParam", "optionalParam", "classLoop")) {
                    assertEq(prefix != "QORE_DISABLE_AOT_CLASS_PARAM_CACHE=1 ",
                        regex(body(ir, name), "@qore_rt_get_class_param_epoch_aot_v1"),
                        name + " class parameter cache " + prefix + level);
                }
                foreach string name in (("intList", "intListLoop")) {
                    assertEq(prefix != "QORE_DISABLE_AOT_PREPARED_LOCAL_RELOAD=1 ",
                        regex(body(ir, name), "@qore_rt_lv_path_int_add_prepared_aot_(?:throwing_)?v1"),
                        name + " prepared indexed update " + prefix + level);
                }
                assertEq(Expected, run((executable,)), prefix + level);
                assertEq(Expected, run((executable,), "QORE_DISABLE_AOT_PREPARED_LOCAL_RELOAD=1 "),
                    "runtime reload control " + prefix + level);
            }
        }
    }
}
