#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
string libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
string qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
    ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : dirname(qore_bin) + "/qcc");
if (!is_file(qcc_bin)) {
    qcc_bin = "qcc";
}

string source = "%modern

int sub lowerSize(string value) {
    return value.lwr().size();
}

int sub upperLength(string value) {
    return value.upr().length();
}

int sub lowerLength(string value) {
    return value.lwr().length();
}

int sub upperSize(string value) {
    return value.upr().size();
}

int sub lowerStrlen(string value) {
    return value.lwr().strlen();
}

bool sub lowerStartsWith(string value, string pattern) {
    return value.lwr().startsWith(pattern);
}

bool sub upperStartsWith(string value, string pattern) {
    return value.upr().startsWith(pattern);
}

bool sub upperEndsWith(string value, string pattern) {
    return value.upr().endsWith(pattern);
}

bool sub lowerContains(string value, string pattern) {
    return value.lwr().contains(pattern);
}

bool sub upperContains(string value, string pattern) {
    return value.upr().contains(pattern);
}

int sub upperFind(string value, string pattern) {
    return value.upr().find(pattern);
}

int sub lowerFindOffset(string value, string pattern, int offset) {
    return value.lwr().find(pattern, offset);
}

int sub upperRFind(string value, string pattern) {
    return value.upr().rfind(pattern);
}

int sub lowerRFindOffset(string value, string pattern, int offset) {
    return value.lwr().rfind(pattern, offset);
}

int sub transformEqualityKinds(string value, string lower_value,
        string upper_value) {
    int result = 0;
    if (value.lwr() == lower_value) {
        result += 1;
    }
    if (upper_value == value.upr()) {
        result += 2;
    }
    if (value.lwr() != upper_value) {
        result += 4;
    }
    if (lower_value != value.upr()) {
        result += 8;
    }
    return result;
}

int sub transformOrderingKinds(string value, string lower_value,
        string upper_value) {
    int result = 0;
    if (value.lwr() > upper_value) {
        result += 1;
    }
    if (upper_value < value.lwr()) {
        result += 2;
    }
    if (value.upr() <= lower_value) {
        result += 4;
    }
    if (lower_value >= value.upr()) {
        result += 8;
    }
    if (value.upr() < lower_value) {
        result += 16;
    }
    if (lower_value > value.upr()) {
        result += 32;
    }
    if (value.lwr() >= upper_value) {
        result += 64;
    }
    if (upper_value <= value.lwr()) {
        result += 128;
    }
    return result;
}

bool sub upperEqualRight(string value, string expected) {
    return expected == value.upr();
}

int sub typedComparisonBranches(string value, string same_value,
        string other_value) {
    int result = 0;
    if (value == same_value) {
        ++result;
    }
    if (value != other_value) {
        ++result;
    }
    return result;
}

string sub sideEffectPattern() {
    printf(\"pattern-side-effect\\n\");
    return \"needle\";
}

bool sub sideEffectContains(string value) {
    return value.lwr().contains(sideEffectPattern());
}

string sub sideEffectEqualityValue() {
    printf(\"equality-side-effect\\n\");
    return \"needle\";
}

bool sub sideEffectEquality(string value) {
    return value.lwr() == sideEffectEqualityValue();
}

string sub sideEffectOrderingValue() {
    printf(\"ordering-side-effect\\n\");
    return \"needle\";
}

bool sub sideEffectOrdering(string value) {
    return value.lwr() < sideEffectOrderingValue();
}

int sub main() {
    string ascii = \"AbCdEf\";
    string utf8 = \"Stra\\u00dfe \\ufb01 \\u0391\\u0392\";
    string latin1 = convert_encoding(\"caf\\u00e9 \\u00df\", \"ISO-8859-1\");
    printf(\"empty:%d:%d\\n\", lowerSize(\"\"), upperLength(\"\"));
    printf(\"ascii:%d:%d:%d\\n\",
        lowerSize(ascii), lowerStrlen(ascii), upperLength(ascii));
    printf(\"utf8:%d:%d:%d:%d\\n\",
        lowerSize(utf8), lowerLength(utf8),
        upperSize(utf8), upperLength(utf8));
    printf(\"latin1:%d:%d\\n\",
        upperSize(latin1), lowerLength(latin1));
    printf(\"search-ascii:%d:%d:%d:%d:%d:%d:%d\\n\",
        lowerStartsWith(\"Prefix\", \"prefix\"),
        upperEndsWith(\"suffix\", \"FIX\"),
        lowerContains(\"A Needle Z\", \"needle\"),
        upperFind(\"a needle z\", \"NEEDLE\"),
        lowerFindOffset(\"Needle needle\", \"needle\", 1),
        upperRFind(\"needle NEEDLE\", \"NEEDLE\"),
        lowerRFindOffset(\"Needle needle\", \"needle\", 7));
    printf(\"search-utf8:%d:%d:%d:%d\\n\",
        lowerStartsWith(utf8, \"stra\\u00dfe\"),
        upperContains(utf8, \"SS\"),
        upperFind(utf8, \"SS\"),
        lowerRFindOffset(utf8, \"\\u03b1\\u03b2\", -1));
    string latin1_pattern = convert_encoding(\"CAF\\u00c9\", \"ISO-8859-1\");
    printf(\"search-latin1:%d:%d\\n\",
        upperStartsWith(latin1, latin1_pattern),
        upperFind(latin1, latin1_pattern));
    printf(\"side-effect:%d\\n\", sideEffectContains(\"Needle\"));
    printf(\"equality-ascii:%d:%d\\n\",
        transformEqualityKinds(\"AbC\", \"abc\", \"ABC\"),
        typedComparisonBranches(\"same\", \"same\", \"other\"));
    printf(\"equality-utf8:%d\\n\",
        transformEqualityKinds(\"Stra\\u00dfe\", \"stra\\u00dfe\", \"STRASSE\"));
    printf(\"equality-latin1:%d:%d\\n\",
        transformEqualityKinds(latin1, \"caf\\u00e9 \\u00df\", \"CAF\\u00c9 SS\"),
        upperEqualRight(latin1, \"CAF\\u00c9 SS\"));
    printf(\"ordering:%d:%d:%d\\n\",
        transformOrderingKinds(\"AbC\", \"abc\", \"ABC\"),
        transformOrderingKinds(utf8, utf8.lwr(), utf8.upr()),
        transformOrderingKinds(latin1, latin1.lwr(), latin1.upr()));
    printf(\"side-effect-equality:%d\\n\", sideEffectEquality(\"Needle\"));
    printf(\"side-effect-ordering:%d\\n\", sideEffectOrdering(\"Needle\"));
    string directional_error;
    try {
        transformEqualityKinds(convert_encoding(\"A\", \"ISO-8859-1\"),
            \"\\u6f22\", \"A\");
    } catch (hash<auto> ex) {
        directional_error = ex.err;
    }
    printf(\"equality-direction:%s:%d\\n\", directional_error,
        upperEqualRight(convert_encoding(\"A\", \"ISO-8859-1\"), \"\\u6f22\"));
    string ordering_left_error;
    try {
        bool ignored = convert_encoding(\"A\", \"ISO-8859-1\").lwr()
            < \"\\u6f22\";
    } catch (hash<auto> ex) {
        ordering_left_error = ex.err;
    }
    string ordering_right_error;
    try {
        bool ignored = convert_encoding(\"A\", \"ISO-8859-1\")
            < \"\\u6f22\".lwr();
    } catch (hash<auto> ex) {
        ordering_right_error = ex.err;
    }
    printf(\"ordering-direction:%s:%s\\n\",
        ordering_left_error, ordering_right_error);
    string latin1_error;
    try {
        upperSize(convert_encoding(\"\\u00b5\", \"ISO-8859-1\"));
    } catch (hash<auto> ex) {
        latin1_error = ex.err;
    }
    printf(\"latin1-error:%s\\n\", latin1_error);

    string unassigned;
    string unassigned_error;
    try {
        unassigned.lwr().size();
    } catch (hash<auto> ex) {
        unassigned_error = ex.err;
    }
    string removed = \"value\";
    remove removed;
    string removed_error;
    try {
        removed.upr().length();
    } catch (hash<auto> ex) {
        removed_error = ex.err;
    }
    string unassigned_search_error;
    try {
        unassigned.lwr().contains(\"value\");
    } catch (hash<auto> ex) {
        unassigned_search_error = ex.err;
    }
    string removed_search_error;
    try {
        removed.upr().find(\"VALUE\");
    } catch (hash<auto> ex) {
        removed_search_error = ex.err;
    }
    string unassigned_equality_error;
    try {
        bool ignored = unassigned.lwr() == \"value\";
    } catch (hash<auto> ex) {
        unassigned_equality_error = ex.err;
    }
    string unassigned_ordering_error;
    try {
        bool ignored = unassigned.lwr() < \"value\";
    } catch (hash<auto> ex) {
        unassigned_ordering_error = ex.err;
    }
    string removed_ordering = \"value\";
    remove removed_ordering;
    string removed_ordering_error;
    try {
        bool ignored = removed_ordering.upr() < \"VALUE\";
    } catch (hash<auto> ex) {
        removed_ordering_error = ex.err;
    }
    printf(\"guards:%s:%s:%s:%s:%s:%s:%s\\n\",
        unassigned_error, removed_error,
        unassigned_search_error, removed_search_error,
        unassigned_equality_error, unassigned_ordering_error,
        removed_ordering_error);
    string unassigned_other;
    string removed_other = \"value\";
    remove removed_other;
    printf(\"equality-unassigned-other:%d:%d:%d:%d\\n\",
        \"VALUE\".lwr() == unassigned_other,
        unassigned_other != \"value\".upr(),
        \"VALUE\".lwr() == removed_other,
        removed_other != \"value\".upr());
    printf(\"ordering-unassigned-other:%d:%d:%d:%d\\n\",
        \"VALUE\".lwr() < unassigned_other,
        unassigned_other > \"value\".upr(),
        \"VALUE\".lwr() < removed_other,
        removed_other > \"value\".upr());
    return 0;
}

main();
";

string root = "/tmp/qore-aot-string-transform-consumer-" + string(getpid());
string enabled_dir = root + "/enabled";
string disabled_dir = root + "/disabled";
string native_disabled_dir = root + "/native-disabled";
mkdir(root);
mkdir(enabled_dir);
mkdir(disabled_dir);
mkdir(native_disabled_dir);

string source_path = root + "/source.qr";
File file();
file.open2(source_path, O_WRONLY | O_CREAT | O_TRUNC);
file.write(source);
file.close();

string ast = backquote(sprintf(
    "LD_LIBRARY_PATH=%s %s -b --exec-mode=ast %s 2>&1",
    libqore_dir, qore_bin, source_path));
string enabled_compile = backquote(sprintf(
    "LD_LIBRARY_PATH=%s QORE_IR_OPT_STATS=1"
        + " %s -O3 -c --output-dir=%s %s 2>&1",
    libqore_dir, qcc_bin, enabled_dir, source_path));
string disabled_compile = backquote(sprintf(
    "LD_LIBRARY_PATH=%s QORE_DISABLE_AOT_STRING_TRANSFORM_CONSUMER_FUSION=1"
        + " %s -O3 -c --output-dir=%s %s 2>&1",
    libqore_dir, qcc_bin, disabled_dir, source_path));
string native_disabled_compile = backquote(sprintf(
    "LD_LIBRARY_PATH=%s QORE_DISABLE_NATIVE_STRING_COMPARISON_RESULTS=1"
        + " %s -O3 -c --output-dir=%s %s 2>&1",
    libqore_dir, qcc_bin, native_disabled_dir, source_path));
string enabled_qo = enabled_dir + "/source.qo";
string disabled_qo = disabled_dir + "/source.qo";
string native_disabled_qo = native_disabled_dir + "/source.qo";
if (!is_file(enabled_qo) || !is_file(disabled_qo)
        || !is_file(native_disabled_qo)) {
    printf("compile failed:\nenabled:\n%sdisabled:\n%snative disabled:\n%s",
        enabled_compile, disabled_compile, native_disabled_compile);
    exit(2);
}
if (enabled_compile !~ /transformEqualityKinds.*string-transform-consumers=4/) {
    printf("string transform-consumer fusion mismatch:\n%s",
        enabled_compile);
    exit(2);
}
if (enabled_compile !~ /transformOrderingKinds.*string-transform-consumers=8/) {
    printf("string transform-ordering fusion mismatch:\n%s",
        enabled_compile);
    exit(2);
}

string enabled_undefined = backquote(sprintf("nm -u %s 2>&1", enabled_qo));
string disabled_undefined = backquote(sprintf("nm -u %s 2>&1", disabled_qo));
string native_disabled_undefined = backquote(sprintf(
    "nm -u %s 2>&1", native_disabled_qo));
if (enabled_undefined !~ /qore_rt_pseudo_string_case_measure_native_noguard/
        || disabled_undefined =~ /qore_rt_pseudo_string_case_measure_native_noguard/
        || enabled_undefined !~ /qore_rt_pseudo_string_case_consume_native_noguard/
        || disabled_undefined =~ /qore_rt_pseudo_string_case_consume_native_noguard/
        || enabled_undefined !~ /qore_rt_string_case_equal_native_noguard/
        || disabled_undefined =~ /qore_rt_string_case_equal_native_noguard/
        || enabled_undefined !~ /qore_rt_string_case_compare_native_noguard/
        || disabled_undefined =~ /qore_rt_string_case_compare_native_noguard/
        || enabled_undefined !~ /qore_rt_string_eq_typed_native/
        || enabled_undefined !~ /qore_rt_string_ne_typed_native/
        || native_disabled_undefined =~ /qore_rt_string_eq_typed_native/
        || native_disabled_undefined =~ /qore_rt_string_ne_typed_native/) {
    printf("string transform-consumer helper mismatch:\nenabled:\n%sdisabled:\n%s"
        + "native disabled:\n%s",
        enabled_undefined, disabled_undefined, native_disabled_undefined);
    exit(2);
}

string enabled_exe = root + "/enabled-aot";
string disabled_exe = root + "/disabled-aot";
string native_disabled_exe = root + "/native-disabled-aot";
string enabled_link = backquote(sprintf(
    "LD_LIBRARY_PATH=%s %s -O3 -o %s %s 2>&1",
    libqore_dir, qcc_bin, enabled_exe, enabled_qo));
string disabled_link = backquote(sprintf(
    "LD_LIBRARY_PATH=%s %s -O3 -o %s %s 2>&1",
    libqore_dir, qcc_bin, disabled_exe, disabled_qo));
string native_disabled_link = backquote(sprintf(
    "LD_LIBRARY_PATH=%s %s -O3 -o %s %s 2>&1",
    libqore_dir, qcc_bin, native_disabled_exe, native_disabled_qo));
if (!is_file(enabled_exe) || !is_file(disabled_exe)
        || !is_file(native_disabled_exe)) {
    printf("link failed:\nenabled:\n%sdisabled:\n%snative disabled:\n%s",
        enabled_link, disabled_link, native_disabled_link);
    exit(2);
}

string enabled = backquote(sprintf(
    "LD_LIBRARY_PATH=%s %s 2>&1", libqore_dir, enabled_exe));
string disabled = backquote(sprintf(
    "LD_LIBRARY_PATH=%s %s 2>&1", libqore_dir, disabled_exe));
string native_disabled = backquote(sprintf(
    "LD_LIBRARY_PATH=%s %s 2>&1", libqore_dir, native_disabled_exe));
if (ast != enabled || ast != disabled || ast != native_disabled) {
    printf("execution mismatch:\nAST:\n%sEnabled:\n%sDisabled:\n%s"
        + "Native disabled:\n%s",
        ast, enabled, disabled, native_disabled);
    exit(2);
}
