#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-exec-mode: children - its checks run in child processes that set their own execution modes

# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../ExecModeHarness.qm

%exec-class NanBoxDoubleTagCollisionTest

#! Regression coverage for finite negative doubles that collide with NaN-boxing value tags
/** A double is stored inline as its raw bits + 2^48, but the short-string (0xFFC) and opaque
    reference (0xFFD) tag families lie inside that range, so the finite negative doubles with raw
    bits from 0xFFBF000000000000 up to 0xFFDF000000000000 (magnitudes from about 2.18e307 to about
    8.71e307) were read back as short strings, NOTHING or opaque references, and could crash.

    Such doubles are now stored as heap float nodes in every tier, which also makes boxing a double
    an allocation in compiled code: the fixture checks the values in every tier and AOT, and counts
    the heap floats that many boxing operations leave behind, which must be none.  The same leak
    checks count the ints outside the 48-bit immediate range in fused AOT aggregate projections,
    which boxed values that were then discarded.

    The leak checks count the heap nodes themselves (dbg_get_live_bigfloat_count() and
    dbg_get_live_bigint_count(), which need library debugging).  They used to compare the resident
    set size of the process with a 2048 kB limit, which a leak-free run exceeded on hosts where
    transparent huge pages back the heap: the first touch of one new page there makes a whole 2 MiB
    huge page resident, so a run that touched 4 kB of new memory reported 2052 kB (CI pipeline
    62463, job 218748, arm64).
*/
class NanBoxDoubleTagCollisionTest inherits QUnit::Test {
    private {
        string qore_bin;
        string qcc_bin;
        string libqore_dir;
        string fixture;
        #! the AST output that every other tier must reproduce
        *string ast_output;

        #! forces promotion on the first call so ir/tiered also run the native code
        const Promote = "QORE_IR_THRESHOLD=1 QORE_JIT_THRESHOLD=1 ";

        #! exec mode -> extra environment
        const Tiers = (
            ("ir", ""),
            ("ir", Promote),
            ("jit", ""),
            ("jit", Promote),
            ("tiered", ""),
            ("tiered", Promote),
        );

        #! the summary that ends a run in which every check passed
        const Summary = "checked: 128\nerrors: 0\n";

        #! the patterns whose leaked heap nodes are counted in "live" mode
        const LeakCases = ("locals", "handler", "projections", "closures");

        #! the iterations of each pattern, and the boxed values that the negative control retains
        const LeakIterations = 200000;
    }

    constructor() : QUnit::Test("NanBoxDoubleTagCollisionTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
            ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");
        fixture = get_script_dir() + "/NanBoxDoubleTagCollisionScenario.qr";

        addTestCase("colliding doubles: ast", \testAst());
        foreach list<string> tier in (Tiers) {
            string mode = tier[0];
            string env = tier[1];
            string label = mode + (env ? " (promoted)" : "");
            addTestCase("colliding doubles: " + label, sub () {
                checkValues(mode, env);
            });
        }
        foreach list<string> tier in ((("ast", ""),) + Tiers) {
            string mode = tier[0];
            string env = tier[1];
            string label = mode + (env ? " (promoted)" : "");
            addTestCase("boxing colliding doubles does not leak: " + label, sub () {
                checkLeaks(mode, env);
            });
        }
        addTestCase("colliding doubles: AOT", \testAot());
        addTestCase("live node counts detect retained boxed values", \testRetainedNodes());
        addTestCase("leak output parsing", \testLeakOutputParsing());

        set_return_value(main());
    }

    testAst() {
        string output = astOutput();
        assertEq(-1, output.find("ERROR:"), "no failed checks: " + output);
        assertEq(Summary, output.substr(-Summary.size()), "summary: " + output);
        assertRegex("^toInt: -?[0-9]+ -2\n", output, "float to int conversions");
        assertRegex("\nnegative NaN: float nan ", output, "negative NaN is a float NaN");
    }

    private string run(string mode, string env, *string arg) {
        # ExecModeHarness compiles synchronously, which makes promotion deterministic instead of racing the compiler
        return ExecModeHarness::run(sprintf("%sLD_LIBRARY_PATH=%s %s -b --enable-debug "
            "--exec-mode=%s %s%s", env, shellQuote(libqore_dir), shellQuote(qore_bin), mode,
            shellQuote(fixture), arg ? " " + arg : ""));
    }

    private checkValues(string mode, string env) {
        # the float to int conversion of an out-of-range value is platform-defined, so every tier is
        # compared with the AST output, which testAst() checks
        assertEq(astOutput(), run(mode, env), sprintf("exec-mode=%s %s output matches AST", mode, env));
    }

    private string astOutput() {
        if (!exists ast_output) {
            ast_output = run("ast", "");
        }
        return ast_output;
    }

    #! skips the test case without library debugging, which the heap node counts need
    private checkDebugging() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("dbg_get_live_bigfloat_count() and dbg_get_live_bigint_count() require library debugging");
        }
    }

    private checkLeaks(string mode, string env) {
        checkDebugging();
        checkLeakOutput(sprintf("exec-mode=%s %s", mode, env), run(mode, env, "live"));
    }

    #! parses the output of "live" mode: pattern -> ("floats": count, "ints": count)
    /** @throw LEAK-OUTPUT-ERROR the output does not have one well-formed line for each pattern, in order
    */
    private static hash<string, hash<string, int>> parseLeakOutput(string output) {
        list<string> lines = output.split("\n");
        # the text after the last newline is an empty element
        if (lines && lines.last() == "") {
            pop lines;
        }
        if (lines.size() != LeakCases.size()) {
            throw "LEAK-OUTPUT-ERROR", sprintf("expected one line for each of %y; got: %y", LeakCases, output);
        }
        hash<string, hash<string, int>> rv;
        foreach string line in (lines) {
            *list<*string> m = (line =~ x/^([a-z-]+): floats (-?[0-9]+) ints (-?[0-9]+)$/);
            if (!m || m[0] != LeakCases[$#]) {
                throw "LEAK-OUTPUT-ERROR", sprintf("line %d: expected the counts of %y; got: %y", $# + 1,
                    LeakCases[$#], line);
            }
            rv{m[0]} = {"floats": m[1].toInt(), "ints": m[2].toInt()};
        }
        return rv;
    }

    private checkLeakOutput(string label, string output) {
        hash<string, hash<string, int>> counts;
        try {
            counts = parseLeakOutput(output);
        } catch (hash<ExceptionInfo> ex) {
            fail(sprintf("%s: %s: %s", label, ex.err, ex.desc));
            return;
        }
        foreach hash<auto> i in (counts.pairIterator()) {
            assertEq(0, i.value.floats, sprintf("%s: %s left heap floats behind", label, i.key));
            assertEq(0, i.value.ints, sprintf("%s: %s left heap ints behind", label, i.key));
        }
    }

    #! the counts see every boxed value that is kept alive, as a missing dereference would keep it
    testRetainedNodes() {
        checkDebugging();
        string output = run("ast", "", "live-retained");
        *list<*string> m = (output =~ x/^retained: floats ([0-9]+) ints ([0-9]+)\nvalues: ([0-9]+)\n$/);
        assertTrue(exists m, "negative control output: " + output);
        if (m) {
            assertEq(LeakIterations, m[2].toInt(), "all values are retained: " + output);
            assertEq(LeakIterations, m[0].toInt(), "each retained boxed double is a live heap float: " + output);
            assertEq(0, m[1].toInt(), "no heap ints are retained: " + output);
        }
    }

    #! the leak checks reject output that does not give the counts of every pattern
    testLeakOutputParsing() {
        hash<string, hash<string, int>> counts = parseLeakOutput("locals: floats 0 ints 0\nhandler: floats 3 ints 0\n"
            "projections: floats 0 ints -1\nclosures: floats 0 ints 0\n");
        assertEq({"floats": 3, "ints": 0}, counts.handler);
        assertEq({"floats": 0, "ints": -1}, counts.projections);
        assertThrows("LEAK-OUTPUT-ERROR", "expected one line", \parseLeakOutput(),
            ("locals: floats 0 ints 0\n",));
        assertThrows("LEAK-OUTPUT-ERROR", "line 2", \parseLeakOutput(),
            ("locals: floats 0 ints 0\nhandler: 0\nprojections: floats 0 ints 0\nclosures: floats 0 ints 0\n",));
        assertThrows("LEAK-OUTPUT-ERROR", "line 1", \parseLeakOutput(),
            ("handler: floats 0 ints 0\nlocals: floats 0 ints 0\nprojections: floats 0 ints 0\n"
                "closures: floats 0 ints 0\n",));
        assertThrows("LEAK-OUTPUT-ERROR", "expected one line", \parseLeakOutput(), ("",));
    }

    testAot() {
        if (!is_file(qcc_bin) && !backquote("command -v " + qcc_bin + " 2>/dev/null")) {
            testSkip("qcc not available");
        }
        TmpDir tmp("qore-nan-box-double-tag-collision-");
        string exe = tmp.path + "/collision";
        # the stats show that the fused aggregate projections the fixture relies on were applied
        string compile_out = backquote(sprintf("QORE_IR_OPT_STATS=1 LD_LIBRARY_PATH=%s %s -o %s %s 2>&1",
            shellQuote(libqore_dir), shellQuote(qcc_bin), shellQuote(exe), shellQuote(fixture)));
        assertTrue(is_file(exe), "AOT compile produced an executable: " + compile_out);
        foreach string function in (("guardedFloatListIndex", "guardedListIndex", "dynamicMixedListIndex",
                "conditionalFloatElementProjection", "conditionalAutoFloatProjection",
                "conditionalAutoFloatInvariantProjection", "conditionalAutoIntProjection")) {
            assertRegex(sprintf("IR-OPT-AOT-EFFECTS: %s_[^:]*:.* aggregate-projections=1 ", function), compile_out,
                function + " uses a fused aggregate projection");
        }
        assertEq(astOutput(), backquote(sprintf("LD_LIBRARY_PATH=%s %s 2>&1", shellQuote(libqore_dir),
            shellQuote(exe))), "AOT output matches AST");
        if (Option::HAVE_LIBRARY_DEBUGGING) {
            checkLeakOutput("AOT", backquote(sprintf("LD_LIBRARY_PATH=%s %s live 2>&1", shellQuote(libqore_dir),
                shellQuote(exe))));
        }
    }

    private static string shellQuote(string value) {
        return "'" + replace(value, "'", "'\\''") + "'";
    }
}
