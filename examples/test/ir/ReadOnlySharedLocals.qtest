#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-exec-mode: children - its checks run in child processes that set their own execution modes and qcc executables
# test-platform: macos - the JIT and AOT code generation of the calls of outlined helpers and of handlers run out of line

# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../TestInterpreter.qm
%requires ../ExecModeHarness.qm

%exec-class ReadOnlySharedLocalsTest

#! The locals that an outlined helper or a handler run out of line only reads (qore#6314)
/** The release of the reload storage of a local before the call of an outlined helper (qore#6300) or of handlers run out
    of line (qore#5942), and its reload after the call, are made only for the locals that the callee can write: those
    that it writes directly, and those that it can reach through a reference or a closure.  The programs read some
    locals and write others in each of these ways; the values and the order of the destructors must be those of the
    AST in every mode and in qcc executables, the outlined program compiled with thresholds that outline it.  The
    locals that a helper writes directly are checked by AOTOutlinedHelperLocalRelease.qtest (qore#6300).

    The programs are in \c readonly-shared-locals/.
*/
class ReadOnlySharedLocalsTest inherits QUnit::Test {
    private {
        string qore_bin = TestInterpreter::qore_interpreter();
        string dir = get_script_dir() + "/readonly-shared-locals";

        const Modes = ("ast", "ir", "jit", "tiered");
        #! the programs, with the environment of their qcc compiles
        const Programs = {
            "readonly-outlined": "QORE_AOT_OUTLINE_FN_MIN_INSTS=20 QORE_AOT_OUTLINE_FN_MIN_BLOCKS=1 "
                "QORE_AOT_OUTLINE_FN_TARGET_INSTS=20 QORE_AOT_DEBUG=1",
            "readonly-handlers": "",
        };
    }

    constructor() : QUnit::Test("ReadOnlySharedLocalsTest", "1.0", \ARGV) {
        addTestCase("every execution mode prints the output of the AST", \testModes());
        addTestCase("qcc executables print the output of the AST", \testCompiled());
        set_return_value(main());
    }

    private string expected(string name) {
        return ReadOnlyFile::readTextFile(dir + "/" + name + ".expected");
    }

    testModes() {
        foreach string name in (keys Programs) {
            foreach string mode in (Modes) {
                hash<ExecModeHarness::ModeRunResult> r = ExecModeHarness::run_command(sprintf("%s -b --enable-debug "
                    "--exec-mode=%s %s/%s.q", qore_bin, mode, dir, name));
                assertEq(0, r.rc, sprintf("%s %s: exit status (output: %y)", name, mode, r.out));
                assertEq(expected(name), r.stdout, name + " " + mode);
            }
        }
    }

    testCompiled() {
        string qcc_bin = ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }
        TmpDir tmp("qore-readonly-shared-locals-");
        foreach hash<auto> i in (Programs.pairIterator()) {
            string name = i.key;
            foreach string opt in (("0", "3")) {
                string exe = sprintf("%s/%s-O%s", tmp.path, name, opt);
                int rc;
                string out = backquote(sprintf("env %s %s -O%s -o %s %s/%s.q 2>&1", i.value, qcc_bin, opt, exe, dir,
                    name), \rc);
                if (rc || !is_file(exe)) {
                    testSkip("qcc is not available or cannot compile " + name + ": " + out);
                }
                if (i.value) {
                    # the function is outlined, so that the calls of its helpers are tested
                    assertRegex("AOT-OUTLINE-FN: 'outlined' outlined [1-9]", out, name + " is outlined");
                }
                # -b must be the first argument of a compiled program
                string result = backquote(sprintf("%s -b 2>&1", exe), \rc);
                assertEq(0, rc, sprintf("%s -O%s: exit status (output: %y)", name, opt, result));
                assertEq(expected(name), result, sprintf("%s -O%s", name, opt));
            }
        }
    }
}
