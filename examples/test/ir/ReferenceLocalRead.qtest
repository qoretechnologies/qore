#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes

%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../ExecModeHarness.qm

%include exec-mode-output-test.qc

%exec-class ReferenceLocalReadTest

#! Regression test: a local variable holding a reference reads as the referenced lvalue after it changed
/** A local variable can hold a reference (<tt>reference r = \x;</tt>, a \c reference<T> parameter), and reads as
    the value of the referenced lvalue.  The IR interpreter cached the value read in the local's slot of the frame's
    slot cache, and later reads took the cached value, though the referenced lvalue can change without a store to the
    local (<tt>x = 10;</tt>, <tt>++x</tt>, <tt>h.a = 3</tt>): <tt>int x = 2; reference r = \x; x = 10;</tt> then
    \c r read as \c 2, and a loop summing \c r while changing \c x summed the first value.  LoadLocal no longer caches
    the value of a local that holds a reference, as it does not cache the target of a weak reference.

    A local of another type (\c auto, \c any) assigned a reference reads the same way.  JIT and tiered native code
    refreshed the local's native cache from the runtime stack after the store, which gave the referenced value of
    that moment, and later loads read the cache; such a local is now read through the reference on every load, as a
    reference-typed local is (AOT code kept the reference itself in the cache and was right).  A parameter given a
    reference whose slot is the variable itself (an IR-only local) read as no value in the IR interpreter after the
    previous change; the slot now holds the reference, which each load reads through.

    In every compiled mode, a loop condition comparing an \c int local with a \c reference<int> local (or two such
    locals) kept using the first value of the reference when its target changed in the loop: the lowering gave it
    the fused instruction BranchIfLtLocalInt, which caches its operands; such a comparison is no longer fused.

    The script reads \c reference and \c reference<int> locals referring to locals, hash and list elements after
    the target changed directly, by increment, through the reference, in a callee, in a closure and in a loop, reads
    a reference parameter, uses reference locals and parameters as loop bounds whose target changes in the loop,
    reads \c auto and \c any locals assigned a reference directly, later, in branches and with the conditional
    operator, writes through them, and reads an \c auto parameter given a reference; each function is called three times through a call reference and by name, in every execution mode and on
    the IR tier of tiered execution (see ExecModeOutputTest).
*/
class ReferenceLocalReadTest inherits ExecModeOutputTest {
    public {
        #! the script run in every execution mode
        const Script = '%modern
# a local holding a reference reads as the referenced lvalue, also after the lvalue changed without a store to the
# local
string sub read_after_store() { int x = 2; reference rr = \x; int a = rr; x = 10; int b = rr; return sprintf("%y %y", a, b); }
string sub write_through() { int x = 2; reference rr = \x; int a = x; rr = 5; int b = x; return sprintf("%y %y", a, b); }
string sub typed() { int x = 2; reference<int> rr = \x; int a = rr; x = 10; int b = rr; return sprintf("%y %y", a, b); }
string sub element() { hash<auto> h = {"a": 1}; reference rr = \h.a; auto a = rr; h.a = 3; auto b = rr; return sprintf("%y %y", a, b); }
string sub increment() { int x = 2; reference rr = \x; int a = rr; ++x; x += 5; int b = rr; return sprintf("%y %y", a, b); }
string sub list_elem() { list<int> l = (1, 2); reference rr = \l[1]; int a = rr; l[1] = 7; push l, 3; int b = rr; return sprintf("%y %y %y", a, b, l); }
# a reference local as an operand of a loop condition comparing int locals
string sub loop_bound() { int x = 1; reference<int> n = \x; int i = 0; int c = 0; while (i < n) { ++i; ++c; if (c == 1) { x = 3; } if (c > 5) { break; } } return sprintf("%y %y", i, c); }
string sub param_bound(reference<int> n) { int i = 0; int c = 0; while (i < n) { ++i; ++c; if (c == 1) { n = 3; } if (c > 5) { break; } } return sprintf("%y %y", i, c); }
string sub param_bound_call() { int x = 1; return param_bound(\x); }
# locals of no reference type assigned a reference read as the referenced lvalue as well
string sub auto_read() { int x = 2; auto rr = \x; int a = rr; x = 10; int b = rr; return sprintf("%y %y", a, b); }
string sub any_read() { int x = 2; any rr = \x; int a = rr; x = 10; int b = rr; return sprintf("%y %y", a, b); }
string sub auto_later() { int x = 2; auto rr; rr = \x; int a = rr; x = 10; int b = rr; return sprintf("%y %y", a, b); }
string sub auto_branch(bool c) { int x = 2; int y = 3; auto rr; if (c) { rr = \x; } else { rr = \y; } int a = rr; x = 10; y = 20; int b = rr; return sprintf("%y %y", a, b); }
string sub auto_ternary(bool c) { int x = 2; int y = 3; auto rr = c ? \x : \y; int a = rr; x = 10; y = 20; int b = rr; return sprintf("%y %y", a, b); }
string sub auto_write() { int x = 2; auto rr = \x; rr = 5; int a = x; ++rr; rr += 3; return sprintf("%y %y %y", a, x, rr); }
string sub auto_elem() { hash<auto> h = {"a": 1}; auto rr = \h.a; h.a = 3; auto b = rr; rr = 7; return sprintf("%y %y", b, h); }
string sub auto_loop() { int x = 0; auto rr = \x; int s = 0; for (int i = 0; i < 3; ++i) { x = i * 10; s += rr; } return sprintf("%y", s); }
string sub auto_copy() { int x = 2; auto rr = \x; auto r2 = rr; x = 10; return sprintf("%y %y", r2, rr); }
# a parameter of no reference type given a reference reads as the referenced lvalue
string sub param_read(auto p) { int a = p; int b = p; return sprintf("%y %y", a, b); }
string sub param_read_call() { int x = 4; return param_read(\x); }
sub set(reference<int> r, int v) { r = v; }
string sub callee() { int x = 2; reference rr = \x; int a = rr; set(\x, 9); int b = rr; return sprintf("%y %y", a, b); }
string sub loop() { int x = 0; reference rr = \x; int s = 0; for (int i = 0; i < 3; ++i) { x = i * 10; s += rr; } return sprintf("%y", s); }
string sub param(reference<int> p) { int a = p; p = 4; int b = p; return sprintf("%y %y", a, b); }
string sub param_call() { int x = 1; string r = param(\x); return sprintf("%s %y", r, x); }
string sub closure() { int x = 2; reference rr = \x; code c = sub () { x = 20; }; int a = rr; c(); int b = rr; return sprintf("%y %y", a, b); }

hash<string, code> tests = {
    "read_after_store": \read_after_store(), "write_through": \write_through(), "typed": \typed(),
    "element": \element(), "increment": \increment(), "list_elem": \list_elem(), "callee": \callee(),
    "loop": \loop(), "param_call": \param_call(), "closure": \closure(), "loop_bound": \loop_bound(), "param_bound": \param_bound_call(),
    "auto_read": \auto_read(), "any_read": \any_read(), "auto_later": \auto_later(),
    "auto_branch": string sub () { return auto_branch(True) + " " + auto_branch(False); },
    "auto_ternary": string sub () { return auto_ternary(True) + " " + auto_ternary(False); },
    "auto_write": \auto_write(), "auto_elem": \auto_elem(), "auto_loop": \auto_loop(), "auto_copy": \auto_copy(),
    "param_read": \param_read_call(),
};
for (int i = 0; i < 3; ++i) {
    foreach hash<auto> t in (tests.pairIterator()) {
        printf("%d %s: %s\n", i, t.key, t.value());
    }
}
for (int i = 0; i < 3; ++i) {
    printf("%d direct: %s | %s | %s | %s | %s | %s | %s\n", i, read_after_store(), element(), loop(), loop_bound(),
        auto_read(), auto_ternary(True), param_read_call());
}
';

        #! the AST interpreter's output
        const Expected = (
            "0 read_after_store: 2 10",
            "0 write_through: 2 5",
            "0 typed: 2 10",
            "0 element: 1 3",
            "0 increment: 2 8",
            "0 list_elem: 2 7 [1, 7, 3]",
            "0 callee: 2 9",
            "0 loop: 30",
            "0 param_call: 1 4 4",
            "0 closure: 2 20",
            "0 loop_bound: 3 3",
            "0 param_bound: 3 3",
            "0 auto_read: 2 10",
            "0 any_read: 2 10",
            "0 auto_later: 2 10",
            "0 auto_branch: 2 10 3 20",
            "0 auto_ternary: 2 10 3 20",
            "0 auto_write: 5 9 9",
            "0 auto_elem: 3 {a: 7}",
            "0 auto_loop: 30",
            "0 auto_copy: 2 10",
            "0 param_read: 4 4",
            "1 read_after_store: 2 10",
            "1 write_through: 2 5",
            "1 typed: 2 10",
            "1 element: 1 3",
            "1 increment: 2 8",
            "1 list_elem: 2 7 [1, 7, 3]",
            "1 callee: 2 9",
            "1 loop: 30",
            "1 param_call: 1 4 4",
            "1 closure: 2 20",
            "1 loop_bound: 3 3",
            "1 param_bound: 3 3",
            "1 auto_read: 2 10",
            "1 any_read: 2 10",
            "1 auto_later: 2 10",
            "1 auto_branch: 2 10 3 20",
            "1 auto_ternary: 2 10 3 20",
            "1 auto_write: 5 9 9",
            "1 auto_elem: 3 {a: 7}",
            "1 auto_loop: 30",
            "1 auto_copy: 2 10",
            "1 param_read: 4 4",
            "2 read_after_store: 2 10",
            "2 write_through: 2 5",
            "2 typed: 2 10",
            "2 element: 1 3",
            "2 increment: 2 8",
            "2 list_elem: 2 7 [1, 7, 3]",
            "2 callee: 2 9",
            "2 loop: 30",
            "2 param_call: 1 4 4",
            "2 closure: 2 20",
            "2 loop_bound: 3 3",
            "2 param_bound: 3 3",
            "2 auto_read: 2 10",
            "2 any_read: 2 10",
            "2 auto_later: 2 10",
            "2 auto_branch: 2 10 3 20",
            "2 auto_ternary: 2 10 3 20",
            "2 auto_write: 5 9 9",
            "2 auto_elem: 3 {a: 7}",
            "2 auto_loop: 30",
            "2 auto_copy: 2 10",
            "2 param_read: 4 4",
            "0 direct: 2 10 | 1 3 | 30 | 3 3 | 2 10 | 2 10 | 4 4",
            "1 direct: 2 10 | 1 3 | 30 | 3 3 | 2 10 | 2 10 | 4 4",
            "2 direct: 2 10 | 1 3 | 30 | 3 3 | 2 10 | 2 10 | 4 4",
        );
    }

    constructor() : ExecModeOutputTest("ReferenceLocalRead", Script, (map $1 + "\n", Expected).join(""),
            "reads a local holding a reference as the referenced lvalue") {
    }
}
