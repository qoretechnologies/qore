#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
string libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
string qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
    ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : dirname(qore_bin) + "/qcc");
if (!is_file(qcc_bin)) {
    qcc_bin = "qcc";
}

string root = "/tmp/qore-aot-global-int-summary-" + string(getpid());
string provider_dir = root + "/provider";
string enabled_dir = root + "/enabled";
string disabled_dir = root + "/disabled";
mkdir(root);
mkdir(provider_dir);
mkdir(enabled_dir);
mkdir(disabled_dir);

string provider_path = root + "/provider.qr";
string consumer_path = root + "/consumer.qr";
string combined_path = root + "/combined.qr";
string provider_code = "%modern

our int global_value;

int sub global_expr(int value) {
    return value + global_value;
}
";
string consumer_code = "%modern

int sub main() {
    bool unassigned_error = False;
    int unassigned_result = -1;
    try {
        unassigned_result = global_expr(5);
    } catch (hash<auto> ex) {
        unassigned_error = True;
    }

    global_value = 3;
    int assigned_result = global_expr(7);
    global_value = 9223372036854775800;
    int large_result = global_expr(7);

    remove global_value;
    bool removed_error = False;
    int removed_result = -1;
    try {
        removed_result = global_expr(11);
    } catch (hash<auto> ex) {
        removed_error = True;
    }

    global_value = -8;
    int reassigned_result = global_expr(3);
    printf(\"%d:%d:%d:%d:%d:%d:%d\\n\", unassigned_error,
        unassigned_result, assigned_result, large_result, removed_error,
        removed_result, reassigned_result);
    return 0;
}
";

File provider_file();
provider_file.open2(provider_path, O_WRONLY | O_CREAT | O_TRUNC);
provider_file.write(provider_code);
provider_file.close();
File consumer_file();
consumer_file.open2(consumer_path, O_WRONLY | O_CREAT | O_TRUNC);
consumer_file.write(consumer_code);
consumer_file.close();
File combined_file();
combined_file.open2(combined_path, O_WRONLY | O_CREAT | O_TRUNC);
combined_file.write(provider_code + consumer_code + "\nmain();\n");
combined_file.close();

string ast = backquote(sprintf("LD_LIBRARY_PATH=%s %s -b --exec-mode=ast %s 2>&1",
    libqore_dir, qore_bin, combined_path));
string provider_compile = backquote(sprintf(
    "LD_LIBRARY_PATH=%s %s -O3 -c --output-dir=%s %s 2>&1",
    libqore_dir, qcc_bin, provider_dir, provider_path));
string provider_qo = provider_dir + "/provider.qo";
if (!is_file(provider_qo)) {
    printf("provider compile failed:\n%s", provider_compile);
    exit(2);
}

string provider_index = backquote(sprintf("%s --dump-index-json %s", qcc_bin, provider_qo));
if (!(provider_index =~ /\"qore_path\": \"global_expr\(int\)\"[^\n]*\"global_int_slot\": 0/)
        || !(provider_index =~ /\"qore_path\": \"global_expr\(int\)\"[^\n]*\"global_int_value_scale\": 1/)
        || !(provider_index =~ /\"qore_path\": \"global_expr\(int\)\"[^\n]*\"global_int_global_scale\": 1/)) {
    printf("unexpected global integer metadata:\n%s", provider_index);
    exit(2);
}

string enabled_compile = backquote(sprintf(
    "LD_LIBRARY_PATH=%s %s -O3 -c -L %s --output-dir=%s %s 2>&1",
    libqore_dir, qcc_bin, provider_dir, enabled_dir, consumer_path));
string disabled_compile = backquote(sprintf(
    "LD_LIBRARY_PATH=%s QORE_DISABLE_AOT_GLOBAL_INT_IMPORT=1"
        + " %s -O3 -c -L %s --output-dir=%s %s 2>&1",
    libqore_dir, qcc_bin, provider_dir, disabled_dir, consumer_path));
string enabled_qo = enabled_dir + "/consumer.qo";
string disabled_qo = disabled_dir + "/consumer.qo";
if (!is_file(enabled_qo) || !is_file(disabled_qo)) {
    printf("consumer compile failed:\nenabled:\n%sdisabled:\n%s",
        enabled_compile, disabled_compile);
    exit(2);
}

string enabled_exe = root + "/enabled-aot";
string disabled_exe = root + "/disabled-aot";
string enabled_link = backquote(sprintf(
    "LD_LIBRARY_PATH=%s %s -O3 -o %s %s %s 2>&1",
    libqore_dir, qcc_bin, enabled_exe, provider_qo, enabled_qo));
string disabled_link = backquote(sprintf(
    "LD_LIBRARY_PATH=%s %s -O3 -o %s %s %s 2>&1",
    libqore_dir, qcc_bin, disabled_exe, provider_qo, disabled_qo));
if (!is_file(enabled_exe) || !is_file(disabled_exe)) {
    printf("link failed:\nenabled:\n%sdisabled:\n%s", enabled_link, disabled_link);
    exit(2);
}

string enabled = backquote(sprintf("LD_LIBRARY_PATH=%s %s 2>&1", libqore_dir, enabled_exe));
string disabled = backquote(sprintf("LD_LIBRARY_PATH=%s %s 2>&1", libqore_dir, disabled_exe));
if (ast != enabled || ast != disabled) {
    printf("execution mismatch:\nAST:\n%sEnabled:\n%sDisabled:\n%s",
        ast, enabled, disabled);
    exit(2);
}
