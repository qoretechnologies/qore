%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil
%exec-class NativeFunctionRefContinuationTest

class NativeFunctionRefContinuationTest inherits QUnit::Test {
    private {
        string qore = realpath(ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0]);
        string libdir = realpath(ENV.QORE_LIBDIR ?? dirname(qore));
        string qcc = ENV.QCC ?? libdir + "/qcc";
    }
    constructor() : Test("native callback continuations", "1.0", \ARGV) {
        addTestCase("native values, ownership, and checked fallbacks", \check());
        set_return_value(main());
    }
    private static string quote(string value) {
        return "'" + replace(value, "'", "'\"'\"'") + "'";
    }
    private string run(list<string> args, string prefix = "") {
        int rc;
        string output = backquote(prefix + "LD_LIBRARY_PATH=" + quote(libdir)
            + " DYLD_LIBRARY_PATH=" + quote(libdir) + " QORE_JIT_SYNC_COMPILE=1 "
            + (map quote($1), args).join(" ") + " 2>&1", \rc);
        assertEq(0, rc, output);
        return output;
    }
    private check() {
        string source = get_script_dir() + "/IRNativeFunctionRefContinuation.qr";
        string expected = "native-funcref-continuation: ok\n";
        foreach string mode in (("ast", "ir", "jit", "tiered")) {
            assertEq(expected, run((qore, "--exec-mode=" + mode, source)), mode);
        }
        TmpDir dir("qore-native-continuation-");
        foreach string prefix in (("", "QORE_DISABLE_AOT_FUNCREF_NATIVE_CONTINUATION=1 ",
                "QORE_DISABLE_AOT_FUNCREF_PREPARED_TARGET=1 ",
                "QORE_DISABLE_AOT_FUNCREF_CALLEE_RUNTIME_CONFIG=1 ",
                "QORE_DISABLE_AOT_FUNCREF_INLINE_STACK_CHECK=1 ",
                "QORE_DISABLE_AOT_INT_EXPRESSION_IMPORT=1 ",
                "QORE_DISABLE_AOT_FLOAT_EXPRESSION_IMPORT=1 ",
                "QORE_DISABLE_AOT_CROSS_OBJECT_LEAF_INLINE=1 ",
                "QORE_DISABLE_AOT_FUNCREF_NATIVE_ENTRY=1 ",
                "QORE_DISABLE_AOT_TYPED_FUNCREF_CALL=1 ", "QORE_DISABLE_AOT_FUNCREF_RUNTIME_CONFIG=1 ",
                "QORE_DISABLE_NATIVE_SCALAR_ASSIGN_GUARD=1 ", "QORE_AOT_EH=1 ",
                "QORE_AOT_NO_DEBUG_INFO=1 ", "MAKEFLAGS= QCC_JOBS=4 QCC_SPLIT_THRESHOLD=1 ")) {
            foreach string level in (("-O0", "-O3")) {
                string executable = dir.path + "/fixture";
                string generated = run((qcc, level, "--strip-source", "-o", executable, source),
                    prefix + "QORE_DUMP_LLVM_IR=1 ");
                bool enabled = !prefix.startsWith("QORE_DISABLE_AOT_FUNCREF_NATIVE_CONTINUATION")
                    && !prefix.startsWith("QORE_DISABLE_AOT_TYPED_FUNCREF_CALL");
                assertEq(enabled, generated.find("typed_funcref_native_value") >= 0,
                    "native continuation selection");
                assertEq(!prefix.startsWith("QORE_DISABLE_AOT_TYPED_FUNCREF_CALL")
                        && !prefix.startsWith("QORE_DISABLE_AOT_FUNCREF_RUNTIME_CONFIG")
                        && !prefix.startsWith("QORE_DISABLE_AOT_FUNCREF_PREPARED_TARGET"),
                    generated.find("qore_rt_try_funcref_int_int_v3") >= 0, "prepared target selection");
                assertEq(!prefix.startsWith("QORE_DISABLE_AOT_TYPED_FUNCREF_CALL")
                        && !prefix.startsWith("QORE_DISABLE_AOT_FUNCREF_NATIVE_ENTRY"),
                    generated =~ /floatAdd[^\n]*funcref_typed_v1/, "float leaf adapter selection");
                assertEq(False, generated =~ /floatDivide[^\n]*funcref_typed_v1/,
                    "throwing float body remains generic");
                bool explicit_callee = !prefix.startsWith("QORE_DISABLE_AOT_TYPED_FUNCREF_CALL")
                    && !prefix.startsWith("QORE_DISABLE_AOT_FUNCREF_NATIVE_ENTRY")
                    && !prefix.startsWith("QORE_DISABLE_AOT_FUNCREF_CALLEE_RUNTIME_CONFIG");
                assertEq(explicit_callee, generated.find("qore_rt_bind_function_call_ref_typed_v2") >= 0,
                    "additive explicit-context entry selection");
                assertEq(explicit_callee, generated.find("qore_rt_check_stack_v2") >= 0,
                    "explicit-context callee retains stack guard");
                assertEq(explicit_callee && !prefix.startsWith("QORE_DISABLE_AOT_CROSS_OBJECT_LEAF_INLINE"),
                    generated =~ /floatAdd[^\n]*funcref_typed_v2/, "explicit float leaf entry selection");
                assertEq(False, generated =~ /floatDivide[^\n]*funcref_typed_v2/,
                    "throwing float body has no explicit native entry");
                bool inline_stack = explicit_callee
                    && !prefix.startsWith("QORE_DISABLE_AOT_FUNCREF_INLINE_STACK_CHECK");
                assertEq(inline_stack, generated.find("qore_rt_bind_function_call_ref_typed_v3") >= 0,
                    "additive inline-stack entry selection");
                assertEq(inline_stack, generated.find("llvm.stacksave") >= 0,
                    "inline guard reads the live native stack pointer");
                if (inline_stack) {
                    assertRegex("icmp ugt", generated, "downward stack comparison");
                    assertRegex("stack_full_check", generated, "null/failed guard retains full check");
                    assertRegex("tail call [^\n]*funcref_typed_v2", generated,
                        "cold guard path returns through the full-check entry");
                }
                assertRegex("qore_rt_coerce_value_by_type_path_aot", generated, "checked fallback retained");
                assertEq(expected, run((executable,)), "AOT " + level);
                assertEq(expected, run((executable,), "QORE_DISABLE_FUNCREF_FAST_CALL=1 "),
                    "runtime fallback " + level);
            }
        }
    }
}
