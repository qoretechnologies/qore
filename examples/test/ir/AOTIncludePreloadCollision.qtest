#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil

%exec-class AOTIncludePreloadCollisionTest

# Regression test for the single-file incremental AOT compiler
# (`qcc -c -L <aot-lib>`).
#
# A `.qc` source frequently `%include`s sibling sources whose own AOT
# objects also live in the `-L` preload directory.  The preload registers
# those siblings' declarations as AOT shells; then the target parse, which
# textually pulls the same files in via `%include`, re-declares them and
# used to abort with:
#
#   PARSE-EXCEPTION: hashdecl 'SharedParams' is already defined in namespace '::'
#   PARSE-EXCEPTION: class 'SharedBase' already exists in namespace '::'
#
# The same class of failure occurs when the target's OWN (stale) `.qo` is in
# the preload directory — the preloaded shell collides with the freshly
# parsed declaration of the target.
#
# The compiler now parses the target once up front (in a throwaway program)
# to learn which source files it declares into — the target plus everything
# it `%include`s — and skips preloading any sibling `.qo` for those files
# (and the target's own `.qo`).  Cross-unit references to TRUE external
# siblings still resolve against the remaining preloaded shells.
class AOTIncludePreloadCollisionTest inherits QUnit::Test {
    private {
        string qore_bin;
        string qcc_bin;
        string libqore_dir;
    }

    constructor() : QUnit::Test("AOTIncludePreloadCollisionTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC
            ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");

        addTestCase("a target that %includes a preloaded sibling .qo compiles "
            "without a duplicate-declaration error", \testIncludePreloadCollision());

        set_return_value(main());
    }

    # shared declarations that the consumer pulls in via %include AND that
    # also have their own AOT object in the -L directory
    private string commonCode() {
        return "%new-style
public hashdecl SharedParams {
    string tag;
    int level;
}
public class SharedBase {
    static hash<SharedParams> defaults() {
        return <SharedParams>{\"tag\": \"base\", \"level\": 1};
    }
}
";
    }

    # the consumer's own class body (no %include); inherits the shared base
    # and uses the shared hashdecl type so resolution actually exercises the
    # shared declarations
    private string consumerClassCode() {
        return "public class Consumer inherits SharedBase {
    static string info() {
        hash<SharedParams> p = SharedBase::defaults();
        return sprintf(\"%s:%d\", p.tag, p.level + 1);
    }
}
";
    }

    private string run(string cmd) {
        return backquote(cmd + " 2>&1");
    }

    private assertNoDup(string out, string ctx) {
        assertEq(-1, out.find("is already defined"), ctx + " (no 'already defined'): " + out);
        assertEq(-1, out.find("already exists"), ctx + " (no 'already exists'): " + out);
    }

    testIncludePreloadCollision() {
        TmpDir tmp("qore-aot-include-preload-collision-");
        string tmp_dir = tmp.path;
        string lib_dir = tmp_dir + "/aotlib";
        mkdir(lib_dir);

        string common_path = tmp_dir + "/common.qc";
        string consumer_path = tmp_dir + "/consumer.qc";
        {
            File f();
            f.open2(common_path, O_WRONLY | O_CREAT | O_TRUNC);
            f.write(commonCode());
        }
        {
            # the consumer %includes common.qc (resolved via the script dir)
            # AND defines its own class using the shared declarations
            File f();
            f.open2(consumer_path, O_WRONLY | O_CREAT | O_TRUNC);
            f.write("%new-style\n%include common.qc\n" + consumerClassCode());
        }

        string env = sprintf("LD_LIBRARY_PATH=%s QORE_LIBDIR=%s", libqore_dir, libqore_dir);

        # compile common.qc into its own AOT object inside the preload dir
        string common_out = run(sprintf("%s %s -c -L %s --parse-option=PO_MODERN -o %s/common.qo %s",
            env, qcc_bin, lib_dir, lib_dir, common_path));
        assertTrue(is_file(lib_dir + "/common.qo"),
            "compiled shared base unit: " + common_out);

        # THE REGRESSION: compile consumer.qc against the preload dir that now
        # holds common.qo.  consumer.qc %includes common.qc, so its parse
        # re-declares SharedParams/SharedBase; the preloaded common.qo must be
        # excluded from the preload so this does not collide.  Also emit a
        # dependency file: qcc must record the `%include`d common.qc as a
        # dependency of consumer.qo, so a build rebuilds it when common.qc
        # changes.
        string dep_path = lib_dir + "/consumer.qo.d";
        string consumer_out = run(sprintf("%s %s -c -L %s --parse-option=PO_MODERN --depfile=%s -o %s/consumer.qo %s",
            env, qcc_bin, lib_dir, dep_path, lib_dir, consumer_path));
        assertNoDup(consumer_out, "consumer that %includes a preloaded sibling");
        assertTrue(is_file(lib_dir + "/consumer.qo"),
            "compiled consumer unit: " + consumer_out);

        # the depfile must list both the target and its %included sibling
        assertTrue(is_file(dep_path), "qcc emitted a dependency file: " + consumer_out);
        string dep = File::readTextFile(dep_path);
        assertTrue(dep.find("consumer.qc") != -1,
            "depfile records the target source: " + dep);
        assertTrue(dep.find("common.qc") != -1,
            "depfile records the %included sibling (so a build rebuilds consumer.qo "
            "when common.qc changes): " + dep);

        # SELF-EXCLUSION: recompile consumer.qc with its own (now stale) .qo
        # present in the preload dir; the target's own object must be skipped so
        # the freshly parsed declaration does not collide with the stale shell.
        string consumer_out2 = run(sprintf("%s %s -c -L %s --parse-option=PO_MODERN -o %s/consumer.qo %s",
            env, qcc_bin, lib_dir, lib_dir, consumer_path));
        assertNoDup(consumer_out2, "recompile with the target's own stale .qo present");
        assertTrue(is_file(lib_dir + "/consumer.qo"),
            "recompiled consumer unit with self .qo present: " + consumer_out2);

        # value correctness: interpreting the merged source yields the value the
        # AOT objects must reproduce (SharedBase::defaults().level + 1)
        string script_path = tmp_dir + "/run.qr";
        {
            File f();
            f.open2(script_path, O_WRONLY | O_CREAT | O_TRUNC);
            f.write(commonCode() + consumerClassCode()
                + "printf(\"%s\\n\", Consumer::info());\n");
        }
        string value_out = run(sprintf("%s %s -b --enable-debug %s",
            env, qore_bin, script_path));
        assertEq("base:2\n", value_out,
            "merged source resolves the shared declarations: " + value_out);
    }
}
