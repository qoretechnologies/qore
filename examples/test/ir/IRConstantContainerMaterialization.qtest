#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../ExecModeHarness.qm

%exec-class IRConstantContainerMaterializationTest

#! A constant whose value is a container must be materialized once, not rebuilt at every read.
/** QoreIRLowering::lowerConstant() used to lower such a constant by emitting one operand per entry
    followed by a MakeHash/MakeList, so every read reconstructed the whole container: reading a
    300-entry constant hash cost 86us under ir/jit/tiered against 1.8us under the AST interpreter,
    which evaluates the value node to a reference to itself.  The cost was therefore O(entries) per
    read instead of O(1).

    The shape assertions check that the emitted IR loads the constant instead of building it, and in
    debug builds the reads are counted: reading a constant container in a loop must create no hash
    and no list in any execution mode (dbg_get_hash_create_count(), dbg_get_list_create_count()),
    while a rebuilt constant creates one for each read.  A loop that builds a hash for each read
    shows that the count sees each container created.

    AOT-compiled code cannot embed a constant value, so it names the constant instead; the same
    shape and count assertions are made against a compiled \c .qmod.  A constant whose value a
    deferred initializer produces must keep being rebuilt there: its value node is shared with the
    expression that computes it, so naming it would make that expression read the constant it is
    computing.  That case is asserted in both directions - the IR shape stays a rebuild, and the
    module still runs with initialization deferred to the first read.
*/
class IRConstantContainerMaterializationTest inherits QUnit::Test {
    private {
        string qore_bin;
        string libqore_dir;

        const Modes = ("ast", "ir", "tiered", "jit");

        #! entries in the large constant used for the shape and count checks
        const LargeEntries = 300;

        #! the number of reads counted
        const CountedReads = 1000;
    }

    constructor() : QUnit::Test("IRConstantContainerMaterializationTest", "1.0", \ARGV) {
        # the scripts run their code too few times for tiered execution to compile it, so native code is only
        # required with JIT execution
        ExecModeHarness::set_default_check(ExecModeHarness::NativeCheck::Jit);
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);

        addTestCase("a constant hash is loaded, not rebuilt", \testHashShape());
        addTestCase("a constant list is loaded, not rebuilt", \testListShape());
        addTestCase("reading a constant creates no container", \testReadsCreateNoContainer());
        addTestCase("every tier reads the same values", \testTiersAgree());
        addTestCase("an AOT constant container is loaded, not rebuilt", \testAotShape());
        addTestCase("an AOT read of a constant creates no container", \testAotReadsCreateNoContainer());
        addTestCase("an AOT qmod reads the same values as its source", \testAotValuesMatchSource());
        addTestCase("a deferred AOT constant is still rebuilt", \testAotDeferredConstantIsRebuilt());

        set_return_value(main());
    }

    private write(string path, string body) {
        File f();
        f.open2(path, O_WRONLY | O_CREAT | O_TRUNC);
        f.write(body);
    }

    private string hashEntries(int n) {
        list<string> parts = ();
        for (int i = 0; i < n; ++i) {
            parts += sprintf("\"k%d\": %d", i, i);
        }
        return parts.join(", ");
    }

    private string listEntries(int n) {
        list<string> parts = ();
        for (int i = 0; i < n; ++i) {
            parts += string(i);
        }
        return parts.join(", ");
    }

    #! Dumps the IR for a read of a container constant through a runtime key/index
    private string dumpIr(string decl, string read) {
        TmpDir tmp("qore-ir-const-materialization-");
        string path = tmp.path + "/const.qr";
        # no output calls: nothing else in the program may build a container
        write(path, sprintf("%%modern\n%s\nstring k = \"k1\";\nint idx = 1;\nauto sink;\n"
            "for (int i = 0; i < 3; ++i) { sink = %s; }\n", decl, read));
        return ExecModeHarness::run(sprintf("LD_LIBRARY_PATH=%s %s -b --exec-mode=ir --ir-dump %s",
            libqore_dir, qore_bin, path));
    }

    testHashShape() {
        string ir = dumpIr(sprintf("const T = {%s};", hashEntries(LargeEntries)), "T{k}");
        assertTrue(ir =~ /load\.constant/, "constant hash is loaded by reference");
        assertFalse(ir =~ /make\.hash/, "constant hash is not rebuilt per read");
    }

    testListShape() {
        string ir = dumpIr(sprintf("const L = (%s);", listEntries(LargeEntries)), "L[idx]");
        assertTrue(ir =~ /load\.constant/, "constant list is loaded by reference");
        assertFalse(ir =~ /make\.list/, "constant list is not rebuilt per read");
    }

    #! the code that counts the containers that the functions of readFunctions() create
    /** Each function is called with no reads and with CountedReads reads, and the difference of the counts is
        printed, so that the containers that the calls themselves create (their argument lists, for example) are not
        counted.  The functions are called first, so that tiered execution compiles them.
    */
    private string countingCode(string prefix) {
        return sprintf("int idx = 1;
string k = \"k1\";
for (int i = 0; i < 200; ++i) {
    %sreadHash(k, 1);
    %sreadList(idx, 1);
    %sbuildHashes(1);
}
int sub count(string counter, code call) {
    int start = call_function(counter);
    call();
    return call_function(counter) - start;
}
int reads = %d;
int hashes = count(\"dbg_get_hash_create_count\", sub () { %sreadHash(k, reads); })
    - count(\"dbg_get_hash_create_count\", sub () { %sreadHash(k, 0); });
int lists = count(\"dbg_get_list_create_count\", sub () { %sreadList(idx, reads); })
    - count(\"dbg_get_list_create_count\", sub () { %sreadList(idx, 0); });
int built = count(\"dbg_get_hash_create_count\", sub () { %sbuildHashes(reads); })
    - count(\"dbg_get_hash_create_count\", sub () { %sbuildHashes(0); });
printf(\"%%d:%%d:%%d\\n\", hashes, lists, built);
", prefix, prefix, prefix, CountedReads, prefix, prefix, prefix, prefix, prefix, prefix);
    }

    #! the functions that read the constants T and L and that build a hash for each read
    private string readFunctions(string visibility) {
        return sprintf("%sint sub readHash(string k, int n) {
    int sink = 0;
    for (int i = 0; i < n; ++i) { sink = T{k}; }
    return sink;
}
%sint sub readList(int idx, int n) {
    int sink = 0;
    for (int i = 0; i < n; ++i) { sink = L[idx]; }
    return sink;
}
# the hashes are kept, so that no tier can leave them out
%sint sub buildHashes(int n) {
    list<hash<auto>> built = ();
    for (int i = 0; i < n; ++i) { push built, {\"k\": i}; }
    return built.size();
}", visibility, visibility, visibility);
    }

    #! checks the counts printed by countingCode()
    private checkCounts(string label, string out) {
        list<string> parts = (trim out).split(":");
        assertEq(3, parts.size(), sprintf("%s: the counting script printed three counts: %s", label, out));
        assertEq(0, parts[0].toInt(), sprintf("%s: %d reads of a %d-entry constant hash create no hash", label,
            CountedReads, LargeEntries));
        assertEq(0, parts[1].toInt(), sprintf("%s: %d reads of a %d-entry constant list create no list", label,
            CountedReads, LargeEntries));
        assertEq(CountedReads, parts[2].toInt(), sprintf("%s: building a hash %d times creates %d hashes", label,
            CountedReads, CountedReads));
    }

    testReadsCreateNoContainer() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("the containers created are counted in debug builds only");
        }
        TmpDir tmp("qore-ir-const-materialization-count-");
        string path = tmp.path + "/count.qr";
        write(path, sprintf("%%modern
const T = {%s};
const L = (%s);
%s
%s", hashEntries(LargeEntries), listEntries(LargeEntries), readFunctions(""), countingCode("")));
        foreach string mode in (Modes) {
            string out = ExecModeHarness::run(sprintf("LD_LIBRARY_PATH=%s %s -b --exec-mode=%s %s", libqore_dir,
                qore_bin, mode, path));
            checkCounts("exec-mode=" + mode, out);
        }
    }

    testTiersAgree() {
        TmpDir tmp("qore-ir-const-materialization-values-");
        string path = tmp.path + "/values.qr";
        write(path, sprintf("%%modern
const T = {%s};
const L = (%s);
string k = \"k7\";
int idx = 7;
list<auto> acc = ();
for (int i = 0; i < 3; ++i) { acc += T{k}; acc += L[idx]; }
# a constant read with a literal key must still fold, and a copy must not alias the constant
hash<auto> copy = T;
copy.k7 = -1;
printf(\"%%y:%%y:%%y\\n\", acc, T.k7, copy.k7);
", hashEntries(20), listEntries(20)));
        string expected;
        foreach string mode in (Modes) {
            string actual = ExecModeHarness::run(sprintf("LD_LIBRARY_PATH=%s %s -b --exec-mode=%s %s",
                libqore_dir, qore_bin, mode, path));
            if (!expected.val()) {
                expected = actual;
                assertEq("[7, 7, 7, 7, 7, 7]:7:-1\n", actual, "AST-tier values");
            } else {
                assertEq(expected, actual, sprintf("exec-mode=%s values", mode));
            }
        }
    }

    #! Compiles a module source to a .qmod and returns the compiler output
    private string compileModule(string qmod_path, string qm_path) {
        return backquote(sprintf("QORE_LIBDIR=%s %s -b --compile-module --strip-source --output %s %s 2>&1",
            libqore_dir, qore_bin, qmod_path, qm_path));
    }

    #! Writes a module source and its compiled .qmod into \a tmp and returns both directory paths
    /** The source directory doubles as a module path, so the same script can be run against the
        interpreted \c .qm and the AOT-compiled \c .qmod.
    */
    private hash<auto> buildModule(TmpDir tmp, string module_name, string body) {
        string src_dir = tmp.path + "/src";
        string qmod_dir = tmp.path + "/qmod";
        mkdir(src_dir);
        mkdir(qmod_dir);
        string qm_path = sprintf("%s/%s.qm", src_dir, module_name);
        string qmod_path = sprintf("%s/%s.qmod", qmod_dir, module_name);
        write(qm_path, body);
        string out = compileModule(qmod_path, qm_path);
        assertTrue(is_file(qmod_path), sprintf("compiled module %s: %s", module_name, out));
        return {"src_dir": src_dir, "qmod_dir": qmod_dir, "qm_path": qm_path, "qmod_path": qmod_path};
    }

    #! Dumps the IR the AOT compiler lowers for \a body, without keeping the compiled output
    private string dumpAotIr(TmpDir tmp, string module_name, string body) {
        string qm_path = sprintf("%s/%s.qm", tmp.path, module_name);
        string qmod_path = sprintf("%s/%s.qmod", tmp.path, module_name);
        write(qm_path, body);
        return backquote(sprintf("QORE_LIBDIR=%s QORE_AOT_DUMP_IR=1 %s -b --compile-module "
            "--strip-source --output %s %s 2>&1", libqore_dir, qore_bin, qmod_path, qm_path));
    }

    #! Returns the dumped IR of one function, so an assertion cannot match another function's shape
    private string irFor(string dump, string header) {
        int start = dump.find(header);
        assertGt(-1, start, sprintf("IR dump contains '%s': %s", header, dump));
        int end = dump.find("=== IR for ", start + header.size());
        return end < 0 ? dump.substr(start) : dump.substr(start, end - start);
    }

    private string moduleSource(string module_name, string decls, string funcs) {
        return sprintf("%%modern

module %s {
    version = \"1.0\";
    desc = \"AOT constant container materialization test\";
    author = \"Qore\";
    license = \"MIT\";
}

public namespace %s {
%s
%s
}
", module_name, module_name, decls, funcs);
    }

    #! Runs \a script with \a module_dir as the only module path
    private string runWithModule(string module_dir, string script_path, string env = "") {
        return backquote(sprintf("LD_LIBRARY_PATH=%s QORE_MODULE_DIR=%s %s %s -b %s 2>&1",
            libqore_dir, module_dir, env, qore_bin, script_path));
    }

    testAotShape() {
        TmpDir tmp("qore-ir-const-materialization-aot-shape-");
        # a class constant is the shape DataProvider reads per word, so it is covered alongside the
        # namespace constants
        string dump = dumpAotIr(tmp, "AOTConstShapeMod", moduleSource("AOTConstShapeMod",
            sprintf("public const T = {%s};
public const L = (%s);
public class Holder {
    public {
        const CT = {%s};
    }

    static int lookupClass(string k) {
        return CT{k};
    }
}", hashEntries(LargeEntries), listEntries(LargeEntries), hashEntries(LargeEntries)),
            "public int sub lookupHash(string k) {\n    return T{k};\n}\n"
            "public int sub lookupList(int idx) {\n    return L[idx];\n}"));

        string hash_ir = irFor(dump, "=== IR for AOTConstShapeMod::lookupHash(string) ===");
        assertTrue(hash_ir =~ /load\.constant/, "AOT constant hash is loaded by reference");
        assertFalse(hash_ir =~ /make\.hash/, "AOT constant hash is not rebuilt per read");

        string list_ir = irFor(dump, "=== IR for AOTConstShapeMod::lookupList(int) ===");
        assertTrue(list_ir =~ /load\.constant/, "AOT constant list is loaded by reference");
        assertFalse(list_ir =~ /make\.list/, "AOT constant list is not rebuilt per read");

        # a static method is dumped under its internal _static_ name
        string class_ir = irFor(dump,
            "=== IR for AOTConstShapeMod::Holder::_static_lookupClass(string) ===");
        assertTrue(class_ir =~ /load\.constant/, "AOT class constant is loaded by reference");
        assertFalse(class_ir =~ /make\.hash/, "AOT class constant is not rebuilt per read");
    }

    testAotReadsCreateNoContainer() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("the containers created are counted in debug builds only");
        }
        TmpDir tmp("qore-ir-const-materialization-aot-count-");
        hash<auto> m = buildModule(tmp, "AOTConstCountMod", moduleSource("AOTConstCountMod",
            sprintf("public const T = {%s};\npublic const L = (%s);", hashEntries(LargeEntries),
                listEntries(LargeEntries)), readFunctions("public ")));

        string script = tmp.path + "/count.qr";
        write(script, "%modern\n%requires AOTConstCountMod\n" + countingCode("AOTConstCountMod::"));
        checkCounts("AOT qmod", runWithModule(m.qmod_dir, script));
        # the module loaded from source runs the same code with the default execution mode
        checkCounts("source module", runWithModule(m.src_dir, script));
    }

    testAotValuesMatchSource() {
        TmpDir tmp("qore-ir-const-materialization-aot-values-");
        hash<auto> m = buildModule(tmp, "AOTConstValueMod", moduleSource("AOTConstValueMod",
            sprintf("public const T = {%s};\npublic const L = (%s);",
                hashEntries(LargeEntries), listEntries(LargeEntries)),
            "public int sub lookupHash(string k) {\n    return T{k};\n}\n"
            "public int sub lookupList(int idx) {\n    return L[idx];\n}"));

        string script = tmp.path + "/values.qr";
        # a copy must not alias the constant, and the constant must survive the copy's mutation
        write(script, "%modern
%requires AOTConstValueMod
string k = \"k7\";
int idx = 7;
hash<auto!> copy = AOTConstValueMod::T;
copy{k} = -1;
printf(\"%y:%y:%y:%y:%d\\n\", AOTConstValueMod::lookupHash(k), AOTConstValueMod::lookupList(idx),
    copy{k}, AOTConstValueMod::T{k}, AOTConstValueMod::T.size());
");
        string from_source = runWithModule(m.src_dir, script);
        assertEq(sprintf("7:7:-1:7:%d\n", LargeEntries), from_source, "source module values");
        assertEq(from_source, runWithModule(m.qmod_dir, script), "AOT qmod values");
    }

    #! A constant computed by an initializer must keep being rebuilt where the initializer runs
    /** The folded literal a helper returns *is* the value node of the constant it initializes, so
        both are the same pointer in the AOT constant reverse map.  Naming the constant there would
        make the helper read the very constant it computes, and the generated \c __const_init would
        then read it while still pending (\c AOT-PENDING-CONSTANT).
    */
    testAotDeferredConstantIsRebuilt() {
        string decls = sprintf("hash<auto> sub makeBase() {\n    return {%s};\n}\n"
            "public const Base = makeBase();", hashEntries(LargeEntries));
        string funcs = "public int sub readBase(string k) {\n    return Base{k};\n}";

        TmpDir dump_tmp("qore-ir-const-materialization-aot-deferred-ir-");
        string dump = dumpAotIr(dump_tmp, "AOTConstDeferredMod",
            moduleSource("AOTConstDeferredMod", decls, funcs));
        string ir = irFor(dump, "=== IR for AOTConstDeferredMod::makeBase() ===");
        assertTrue(ir =~ /make\.hash/, "the helper that computes a constant still builds its value");
        assertFalse(ir =~ /load\.constant/,
            "the helper that computes a constant does not read that constant");

        TmpDir tmp("qore-ir-const-materialization-aot-deferred-");
        hash<auto> m = buildModule(tmp, "AOTConstDeferredMod",
            moduleSource("AOTConstDeferredMod", decls, funcs));
        string script = tmp.path + "/deferred.qr";
        write(script, "%modern
%requires AOTConstDeferredMod
printf(\"%y:%y\\n\", AOTConstDeferredMod::readBase(\"k7\"), AOTConstDeferredMod::Base.k7);
");
        assertEq("7:7\n", runWithModule(m.qmod_dir, script), "AOT qmod reads its computed constant");
        # deferring initialization to the first read is the only deterministic way to reach the
        # path a false self-reference breaks
        string deferred = runWithModule(m.qmod_dir, script, "QORE_AOT_TEST_DEFER_CONSTANT_INIT=1");
        assertEq("7:7\n", deferred, "AOT qmod reads its computed constant with init deferred");
        assertEq(-1, deferred.find("AOT-PENDING-CONSTANT"),
            "reading a computed constant does not report it as unpopulated");
    }
}
