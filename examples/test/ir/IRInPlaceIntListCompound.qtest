#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-exec-mode: children - its checks run in child processes that set their own execution modes
# test-platform: macos - JIT and AOT code generation of the native helper of += and -= on list<int> elements

# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires ../TestInterpreter.qm
%requires FsUtil
%requires ../ExecModeHarness.qm

%exec-class IRInPlaceIntListCompoundTest

#! += and -= on an element of a list<int> local in native code
/** Native code makes <tt>local[index] += value</tt> and <tt>local[index] -= value</tt> on a local declared
    \c list<int> with a constant or native integer index with qore_rt_lv_path_int_list_compound(), which changes an
    inline integer element of a list that only the variable holds in place and makes every other case with the
    generic lvalue path.  The scenario must print in every tier and as a compiled executable what the AST tier prints,
    with and without the helper; the LLVM IR of the functions shows where the helper is used.
*/
class IRInPlaceIntListCompoundTest inherits QUnit::Test {
    private {
        string qore_bin;
        string qcc_bin;
        string libqore_dir;
        string fixture;
        #! the AST output that every other tier must reproduce
        *string ast_output;

        #! disables the helper
        const Gate = "QORE_DISABLE_IR_IN_PLACE_INT_LIST_COMPOUND=1 ";

        #! the functions that use the helper: a loop with a native index, constant indexes, a shared list, indexes
        #! out of range, wide values, other operands, a parameter, a try block, another thread's list
        const Helper = ("mutateLoop", "constantIndex", "sharedList", "outOfRange", "wideValues", "otherOperands",
            "parameters", "inTry", "otherThread");

        #! the functions that do not: lists of other element types, a reference parameter
        const Generic = ("otherTypes", "changeByReference");
    }

    constructor() : QUnit::Test("IRInPlaceIntListCompoundTest", "1.0", \ARGV) {
        qore_bin = TestInterpreter::qore_interpreter();
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = TestInterpreter::qcc_compiler() ?? "";
        fixture = get_script_dir() + "/IRInPlaceIntListCompoundScenario.qr";

        addTestCase("ast", \testAst());
        foreach string tier in (ExecModeHarness::ExecModes[1..]) {
            # a local of the loop body, so that each closure binds its own
            string mode = tier;
            addTestCase(mode, sub () {
                assertEq(astOutput(), run(mode), sprintf("exec-mode=%s output matches AST", mode));
                assertEq(astOutput(), run(mode, Gate), sprintf("exec-mode=%s output without the helper matches AST",
                    mode));
            });
        }
        addTestCase("jit helper", \testJitHelper());
        addTestCase("aot", \testAot());

        set_return_value(main());
    }

    testAst() {
        list<string> lines = astOutput().split("\n");
        assertEq("loop: 0 1101039 266526720", lines[0]);
        assertEq("constant: [15, 22, 23] 23 22", lines[1]);
        assertEq("shared: [11, 12, 13] [1, 2, 3]", lines[2]);
        assertEq("range: [1, 2, 5] RUNTIME-TYPE-ERROR [0, 2, 105]", lines[3]);
        assertEq("wide: [140737488355329, -140737488355329, 140737488355338, 140737488355330, "
            "-9223372036854775801]", lines[4]);
        assertEq("operands: [3, 2, 10, 9]", lines[5]);
        assertEq("holders: [11, 22, -27] [11, 22, -27]", lines[6]);
        assertEq("parameters: [1, 3, 3] [1, 101, 3]", lines[7]);
        assertEq("try: 0:ok 1:ok 2:RUNTIME-TYPE-ERROR 3:RUNTIME-TYPE-ERROR [6, 6, 1]", lines[8]);
        assertEq("types: [1, 2, 3] [6, 2] [4, \"x\"]", lines[9]);
        assertEq("thread: [2, 3, 4] [1, 2, 3]", lines[10]);
    }

    testJitHelper() {
        string ir = run("jit", "QORE_DUMP_LLVM_IR=1 ");
        checkHelper(ir, "qore_rt_lv_path_int_list_compound", True, "jit");
        string disabled = run("jit", Gate + "QORE_DUMP_LLVM_IR=1 ");
        checkHelper(disabled, "qore_rt_lv_path_int_list_compound", False, "jit without the helper");
    }

    testAot() {
        if (!qcc_bin) {
            testSkip("qcc not available");
        }
        TmpDir tmp("qore-ir-int-list-compound-");
        foreach hash<auto> i in ((("level": 0, "env": ""), ("level": 3, "env": ""), ("level": 3, "env": Gate))) {
            string exe = sprintf("%s/scenario-O%d%s", tmp.path, i.level, i.env ? "-disabled" : "");
            string out = ExecModeHarness::run_any(sprintf("%sQORE_DUMP_LLVM_IR=1 LD_LIBRARY_PATH=%s "
                "DYLD_LIBRARY_PATH=%s %s -O%d --strip-source -o %s %s", i.env, shellQuote(libqore_dir),
                shellQuote(libqore_dir), shellQuote(qcc_bin), i.level, shellQuote(exe), shellQuote(fixture)));
            string label = sprintf("AOT -O%d%s", i.level, i.env ? " disabled" : "");
            assertTrue(is_file(exe), sprintf("%s compile produced an executable: %s", label, out.substr(-2000)));
            checkHelper(out, "qore_rt_lv_path_int_list_compound_aot", !i.env, label);
            assertEq(astOutput(), ExecModeHarness::run_any(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s %s",
                shellQuote(libqore_dir), shellQuote(libqore_dir), shellQuote(exe))), label + " output matches AST");
        }
    }

    #! checks which functions of the LLVM IR call the helper
    private checkHelper(string ir, string helper, bool enabled, string label) {
        foreach string name in (Helper) {
            assertEq(enabled, callsHelper(ir, name, helper), sprintf("%s: %s calls %s", label, name, helper));
        }
        foreach string name in (Generic) {
            assertFalse(callsHelper(ir, name, helper), sprintf("%s: %s does not call %s", label, name, helper));
        }
    }

    #! returns True if an LLVM definition of the function (or of code it runs in a background thread) calls the helper
    private bool callsHelper(string ir, string name, string helper) {
        *list<*string> bodies = regex_extract(ir, "(?s)define [^\n]*@\"?" + name + "[_@][^\n]*\n(.*?)\n\\}",
            Qore::RE_Global);
        assertTrue(exists bodies[0], name + " has an LLVM definition");
        return exists (select bodies, regex($1 ?? "", "(?:call|invoke) [^\n]*@" + helper + "(?:_throwing)?\\(")
            )[0];
    }

    private string run(string mode, string env = "") {
        # ExecModeHarness compiles synchronously, so tiered execution reaches native code deterministically
        return ExecModeHarness::run(sprintf("%sLD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s %s -b --enable-debug "
            "--exec-mode=%s %s", env, shellQuote(libqore_dir), shellQuote(libqore_dir), shellQuote(qore_bin), mode,
            shellQuote(fixture)));
    }

    private string astOutput() {
        if (!exists ast_output) {
            ast_output = run("ast");
        }
        return ast_output;
    }

    private static string shellQuote(string value) {
        return "'" + replace(value, "'", "'\\''") + "'";
    }
}
