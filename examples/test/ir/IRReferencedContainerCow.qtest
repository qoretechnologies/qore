#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-exec-mode: children - its checks run in child processes that set their own execution modes

%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires ../ExecModeHarness.qm

string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
string libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
string qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
    ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : dirname(qore_bin) + "/qcc");
if (!is_file(qcc_bin)) {
    qcc_bin = "qcc";
}

string code = "%modern

nothing sub touchHash(reference<hash<string, int>> values) {
    values{\"ref\"} = 99;
}

nothing sub touchList(reference<list<int>> values) {
    push values, 99;
}

class PrivateBox {
    private {
        int value;
    }

    constructor() {
        value = 1;
    }
}

string sub memberAssignmentErrors() {
    object box = new PrivateBox();
    string direct_error = \"none\";
    try {
        box.value = 2;
    } catch (hash<ExceptionInfo> ex) {
        direct_error = ex.err;
    }
    code<nothing()> assign = sub () {
        box.value = 3;
    };
    string closure_error = \"none\";
    try {
        assign();
    } catch (hash<ExceptionInfo> ex) {
        closure_error = ex.err;
    }
    return direct_error + \":\" + closure_error;
}

string sub semanticCases() {
    hash<string, int> values = {\"seed\": 1};
    hash<string, int> alias = values;
    reference<hash<string, int>> values_ref = \\values;
    values{\"direct\"} = 2;
    values_ref{\"through\"} = 3;

    list<int> items = (1,);
    list<int> items_alias = items;
    reference<list<int>> items_ref = \\items;
    push items, 2;
    push items_ref, 3;

    list<int> captured = (4,);
    code<nothing()> append = sub () {
        push captured, 5;
    };
    append();

    list<int> typed = (6,);
    reference<list<int>> typed_ref = \\typed;
    string type_error = \"none\";
    try {
        push typed, \"invalid\";
    } catch (hash<ExceptionInfo> ex) {
        type_error = ex.err;
    }

    list<int> typed_unshift = (7,);
    reference<list<int>> typed_unshift_ref = \\typed_unshift;
    string unshift_error = \"none\";
    try {
        unshift typed_unshift, \"invalid\";
    } catch (hash<ExceptionInfo> ex) {
        unshift_error = ex.err;
    }

    return sprintf(\"%d:%d:%d:%d:%d:%d:%d:%d:%d:%s:%d:%s\",
        alias.size(), values.size(), values_ref{\"through\"},
        items_alias.size(), items.size(), items_ref[2],
        captured.size(), captured[1], typed_ref.size(), type_error,
        typed_unshift_ref.size(), unshift_error);
}

# Copy-on-write probes for the shared-container paths.
#
# The container is mutated through a live reference for the whole loop, which is
# the shape that copies the entire container on every iteration when the lvalue
# path regresses; a reference taken only after the loop checks the plain local
# path instead and proves nothing.  The reference is created in this function and
# a function is called between creating it and the loop on purpose: reading a
# local that holds a reference yields the referenced value, so the AOT reload
# cache used to own the container and every mutation through the reference
# copied it (under source-free AOT).
#
# The check counts the hashes and lists that the loop copies (with library
# debugging, dbg_get_container_copy_count(), which the call before the loop
# reads): a loop that changes the container in place copies none, a loop that
# copies it on every iteration copies one per element, so 4x the input must not
# copy more.  Without library debugging nothing is counted, and the check passes:
# the Linux CI jobs build libqore with CMAKE_BUILD_TYPE=debug
# (test/docker_test/build.sh), so they count the copies; the macOS CI job builds a
# release library, where the check has nothing to count.
int sub copies() {
    if (!Option::HAVE_LIBRARY_DEBUGGING) {
        return -1;
    }
    return call_function(\"dbg_get_container_copy_count\");
}

#! the containers copied since before, or -1 without library debugging
int sub copiedSince(int before) {
    return before < 0 ? -1 : copies() - before;
}

hash<auto> sub measureHash(int n) {
    hash<string, int> values = {};
    reference<hash<string, int>> values_ref = \\values;
    int before = copies();
    for (int i = 0; i < n; ++i) {
        values_ref{sprintf(\"k%d\", i)} = i;
    }
    int copied = copiedSince(before);
    touchHash(\\values);
    return {\"copied\": copied, \"size\": values.size()};
}

hash<auto> sub measureList(int n) {
    list<int> values = ();
    reference<list<int>> values_ref = \\values;
    int before = copies();
    for (int i = 0; i < n; ++i) {
        push values_ref, i;
    }
    int copied = copiedSince(before);
    touchList(\\values);
    return {\"copied\": copied, \"size\": values.size()};
}

# An untyped local can hold a reference at runtime, so it takes the same
# structured lvalue path.  Pushing to one copied the list on every push in IR,
# tiered and AOT until the native Load + ListPush + Store sequence stopped
# claiming reference-capable locals.
hash<auto> sub measureAutoList(int n) {
    auto values = ();
    int before = copies();
    for (int i = 0; i < n; ++i) {
        push values, i;
    }
    int copied = copiedSince(before);
    return {\"copied\": copied, \"size\": values.size()};
}

# warm up (JIT promotion) before the measured runs
measureHash(1000);
measureList(1000);
measureAutoList(1000);
hash<auto> hs = measureHash(8000);
hash<auto> hl = measureHash(32000);
hash<auto> ls = measureList(8000);
hash<auto> ll = measureList(32000);
hash<auto> as = measureAutoList(8000);
hash<auto> al = measureAutoList(32000);
# a loop over 4x the input copies no more containers than the smaller one, and no more than a handful: one copy per
# iteration would give 8000 and 32000.  touchHash() and touchList() each add one element after the loop;
# measureAutoList() adds none.
bool sub inPlace(hash<auto> small, hash<auto> large) {
    return small.copied < 0 || (large.copied <= small.copied && small.copied < 8);
}
bool hash_linear = hs.size == 8001 && hl.size == 32001 && inPlace(hs, hl);
bool list_linear = ls.size == 8001 && ll.size == 32001 && inPlace(ls, ll);
bool auto_list_linear = as.size == 8000 && al.size == 32000 && inPlace(as, al);
printf(\"%s:%s|%y|%y|%y\\n\", semanticCases(), memberAssignmentErrors(),
    hash_linear, list_linear, auto_list_linear);
";

string script_path = "/tmp/qore-ir-referenced-container-cow-" + string(getpid()) + ".qr";
string exe_path = "/tmp/qore-ir-referenced-container-cow-" + string(getpid());
File script();
script.open2(script_path, O_WRONLY | O_CREAT | O_TRUNC);
script.write(code);
script.close();

on_exit {
    unlink(script_path);
    unlink(exe_path);
}

string expected = "1:3:3:1:3:3:2:5:1:RUNTIME-TYPE-ERROR:1:RUNTIME-TYPE-ERROR"
    + ":PRIVATE-MEMBER:PRIVATE-MEMBER|True|True|True\n";
foreach string mode in ("ast", "ir", "tiered", "jit") {
    string actual = ExecModeHarness::run(sprintf("LD_LIBRARY_PATH=%s %s -b --enable-debug --exec-mode=%s %s",
        libqore_dir, qore_bin, mode, script_path));
    if (actual != expected) {
        printf("mismatch in %s\nexpected:\n%sactual:\n%s", mode, expected, actual);
        exit(2);
    }
}

# NOTE: the source-free AOT stage below is the one that matters most for the
# scaling probes: the reference-read caching defect they guard was specific to
# AOT and needed a call between the reference creation and the loop to show up.
string compile_out = backquote(sprintf(
    "LD_LIBRARY_PATH=%s %s --strip-source --strip-debug-info -O3 -o %s %s 2>&1",
    libqore_dir, qcc_bin, exe_path, script_path));
if (!is_file(exe_path)) {
    printf("AOT compile failed:\n%s", compile_out);
    exit(2);
}
string aot = backquote(sprintf("LD_LIBRARY_PATH=%s %s 2>&1", libqore_dir, exe_path));
if (aot != expected) {
    printf("mismatch in source-free AOT\nexpected:\n%sactual:\n%s", expected, aot);
    exit(2);
}
