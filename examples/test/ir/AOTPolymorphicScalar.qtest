#!/usr/bin/env qore
# Copyright (c) 2026 Qore Technologies, s.r.o.
# SPDX-License-Identifier: MIT
%modern
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil
%exec-class PolymorphicScalarTest

class PolymorphicScalarTest inherits QUnit::Test {
    private {
        string qore = realpath(ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0]);
        string libdir = realpath(ENV.QORE_LIBDIR ?? dirname(qore));
        string qcc = ENV.QCC ?? libdir + "/qcc";
    }
    constructor() : Test("bounded polymorphic scalar inlining", "1.0", \ARGV) {
        addTestCase("bound method metadata and override fallbacks", \check());
        set_return_value(main());
    }
    private static string quote(string value) {
        return "'" + replace(value, "'", "'\"'\"'") + "'";
    }
    private string run(list<string> args, string prefix = "") {
        int status;
        string output = backquote(prefix + "LD_LIBRARY_PATH=" + quote(libdir)
            + " DYLD_LIBRARY_PATH=" + quote(libdir)
            + " QORE_JIT_SYNC_COMPILE=1 QORE_IR_THRESHOLD=1 QORE_JIT_THRESHOLD=1 "
            + (map quote($1), args).join(" ") + " 2>&1", \status);
        assertEq(0, status, output);
        return output;
    }
    private string body(string ir, string name) {
        *list<*string> found = regex_extract(ir,
            "(?s)define [^\n]*@" + name + "_[^\n]*\\(ptr %ctx, ptr %xsink\\)[^\n]*\n(.*?)\n\\}");
        assertTrue(!!found, name + " normal LLVM entry");
        return found[0] ?? "";
    }
    private check() {
        string source = get_script_dir() + "/AOTPolymorphicScalar.qr";
        string expected = "polymorphic-scalar: ok\n";
        foreach string mode in (("ast", "ir", "jit", "tiered")) {
            assertEq(expected, run((qore, "--exec-mode=" + mode, source)), mode);
        }
        TmpDir dir("qore-polymorphic-scalar-");
        foreach string prefix in (("", "QORE_DISABLE_AOT_POLYMORPHIC_SCALAR_IMPORT=1 ",
                "QORE_DISABLE_AOT_SCALAR_OVERRIDE_GUARD_HOIST=1 ",
                "QORE_DISABLE_AOT_PINNED_OVERRIDE_RECEIVER=1 ",
                "QORE_AOT_EH=1 ", "MAKEFLAGS= QCC_JOBS=4 QCC_SPLIT_THRESHOLD=1 ")) {
            foreach string level in (("-O0", "-O3")) {
                foreach string source_flag in (("--strip-source", "--include-source")) {
                    string executable = dir.path + "/fixture";
                    string ir = run((qcc, level, source_flag, "-o", executable, source),
                        prefix + "QORE_DUMP_LLVM_IR=1 ");
                    foreach string name in (("scalarIntCall", "scalarFloatCall", "scalarIntInvoke",
                            "scalarFloatInvoke")) {
                        assertEq(prefix != "QORE_DISABLE_AOT_POLYMORPHIC_SCALAR_IMPORT=1 ",
                            regex(body(ir, name), "call i32 @qore_rt_object_has_exact_aot_override_v1"),
                            name + prefix + level + source_flag);
                    }
                    foreach string name in (("scalarIntLoop", "scalarFloatLoop", "scalarIntLoopInvoke",
                            "scalarFloatLoopInvoke")) {
                        string loop = body(ir, name);
                        bool hoisted = prefix != "QORE_DISABLE_AOT_POLYMORPHIC_SCALAR_IMPORT=1 "
                            && prefix != "QORE_DISABLE_AOT_SCALAR_OVERRIDE_GUARD_HOIST=1 ";
                        assertEq(hoisted, regex(loop, "call ptr @qore_rt_get_aot_override_class_v1"), name);
                        assertEq(hoisted, regex(loop, "call ptr @qore_rt_get_live_aot_override_receiver_class_v1"), name);
                        bool pinned = hoisted && prefix != "QORE_DISABLE_AOT_PINNED_OVERRIDE_RECEIVER=1 ";
                        int owners = name == "scalarIntLoop" || name == "scalarFloatLoop" ? 2 : 1;
                        int live_helpers = (select loop.split("\n"),
                            $1 =~ /call ptr @qore_rt_get_live_aot_override_receiver_class_v1/).size();
                        assertEq(hoisted ? (pinned ? owners + 1 : 1) : 0, live_helpers,
                            name + " entry classifications and single cold fallback");
                        assertEq(pinned, regex(loop, "pinned_override_same_receiver"), name + " receiver identity");
                        assertEq(pinned, regex(loop, "pinned_override_live_status[^\n]*load atomic i32,[^\n]*seq_cst"),
                            name + " live deletion check");
                    }
                    assertFalse(regex(body(ir, "scalarManyCall"),
                        "call i32 @qore_rt_object_has_exact_aot_override_v1"), "bounded alternatives");
                    # An overloaded base call has no parse-selected variant and keeps name dispatch.
                    assertFalse(regex(body(ir, "scalarOverloadCall"),
                        "call i32 @qore_rt_object_has_exact_aot_override_v1"), "unresolved overload fallback");
                    foreach string runtime in (("", "QORE_DISABLE_AOT_NATIVE_METHOD_ENTRY=1 ",
                            "QORE_DISABLE_IR_CONTEXT_ELISION=1 ", "QORE_DISABLE_AOT_INLINE_RECEIVER_VALIDITY=1 ")) {
                        assertEq(expected, run((executable,), runtime), prefix + level + source_flag + runtime);
                    }
                }
            }
        }
    }
}
