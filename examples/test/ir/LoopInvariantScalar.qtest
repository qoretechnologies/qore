#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
string libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
string qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
    ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : dirname(qore_bin) + "/qcc");
if (!is_file(qcc_bin)) {
    qcc_bin = "qcc";
}

string sub scriptCode() {
    return "%modern

int sub invariant(int n) {
    int a = 37;
    int b = 11;
    int sum = 0;
    for (int i = 0; i < n; ++i) {
        sum += a * b;
    }
    return sum;
}

int sub mutated(int n) {
    int a = 3;
    int sum = 0;
    for (int i = 0; i < n; ++i) {
        a += 2;
        sum += a * 7;
    }
    return sum;
}

int sub nested(int outer, int inner) {
    int a = 5;
    int b = 9;
    int sum = 0;
    for (int i = 0; i < outer; ++i) {
        for (int j = 0; j < inner; ++j) {
            sum += a * b;
        }
    }
    return sum;
}

int sub unassigned(int n) {
    int a;
    int sum = 0;
    for (int i = 0; i < n; ++i) {
        sum += a * 2;
    }
    return sum;
}

int sub removeAndAssign(int n) {
    int a = 3;
    int sum = 0;
    for (int i = 0; i < n; ++i) {
        remove a;
        sum += a * 2;
        a = i + 1;
    }
    return sum;
}

int sub nestedAssignedState(int n) {
    int found_count = 0;
    for (int i = 0; i < n; ++i) {
        bool found = False;
        foreach int value in ((1, 2)) {
            if (value == 2) {
                found = True;
            }
        }
        if (found) {
            ++found_count;
        }
    }
    return found_count;
}

int sub invariantShift(int n, int value, int amount) {
    int sum = 0;
    for (int i = 0; i < n; ++i) {
        sum += (value << amount) + (value << amount);
    }
    return sum;
}

int sub mutatedShift(int n, int value, int amount) {
    int sum = 0;
    for (int i = 0; i < n; ++i) {
        amount = (amount + 1) % 4;
        sum += value << amount;
    }
    return sum;
}

int sub invariantBool(int n, bool enabled) {
    int count = 0;
    for (int i = 0; i < n; ++i) {
        if (!enabled) {
            ++count;
        }
    }
    return count;
}

int sub mutatedBool(int n, bool enabled) {
    int count = 0;
    for (int i = 0; i < n; ++i) {
        enabled = !enabled;
        if (!enabled) {
            ++count;
        }
    }
    return count;
}

printf(\"%d:%d:%d:%d:%d:%d:%d:%d:%d:%d:%d:%d\\n\", invariant(0), invariant(1000), mutated(1000),
    nested(0, 100), nested(100, 100), unassigned(100), removeAndAssign(100), nestedAssignedState(20),
    invariantShift(100, 3, 2), mutatedShift(100, 3, 0), invariantBool(100, False),
    mutatedBool(100, False));
";
}

string sub runMode(string script_path, string mode) {
    return backquote(sprintf("LD_LIBRARY_PATH=%s %s -b --exec-mode=%s %s 2>&1",
        libqore_dir, qore_bin, mode, script_path));
}

string sub runAot(string script_path) {
    string exe = "/tmp/qore-loop-invariant-scalar-" + string(getpid());
    string compile_out = backquote(sprintf("LD_LIBRARY_PATH=%s %s --strip-source -o %s %s 2>&1",
        libqore_dir, qcc_bin, exe, script_path));
    if (!is_file(exe)) {
        printf("AOT compile failed:\n%s", compile_out);
        exit(2);
    }
    return backquote(sprintf("LD_LIBRARY_PATH=%s %s 2>&1", libqore_dir, exe));
}

sub checkOutput(string label, string expected, string actual) {
    if (actual != expected) {
        printf("mismatch in %s\nexpected:\n%sactual:\n%s", label, expected, actual);
        exit(2);
    }
}

string script_path = "/tmp/qore-loop-invariant-scalar-" + string(getpid()) + ".qr";
File script();
script.open2(script_path, O_WRONLY | O_CREAT | O_TRUNC);
script.write(scriptCode());
script.close();

string ast = runMode(script_path, "ast");
checkOutput("ast", "0:407000:7028000:0:450000:0:0:20:2400:1125:100:50\n", ast);

foreach string mode in (("ir", "tiered", "jit")) {
    checkOutput(mode, ast, runMode(script_path, mode));
}
checkOutput("aot", ast, runAot(script_path));

string stats = backquote(sprintf("QORE_IR_OPT_STATS=1 LD_LIBRARY_PATH=%s %s -b --exec-mode=ir %s 2>&1",
    libqore_dir, qore_bin, script_path));
if (stats !~ /IR-OPT: invariantShift:.*hoisted=[2-9]/
        || stats !~ /IR-OPT: invariantBool:.*hoisted=[2-9]/) {
    printf("missing scalar LICM selection:\n%s", stats);
    exit(2);
}
