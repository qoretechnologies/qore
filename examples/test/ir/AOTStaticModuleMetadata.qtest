#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - a .qo module statically linked into a C++ host by the system linker, its linked metadata

# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil
%requires Util
%requires ../TestBuildTools.qm

%exec-class AOTStaticModuleMetadataTest

#! A module registered statically (from its .qo, or a .qoa) is checked with the metadata record linked with it
/** A statically registered AOT module is not loaded from a file, so it has no metadata section; qcc links its record
    with its register function instead (qore_aot_register_into_program_v2()).  With it, as for a .qmod:
    - the module's dependencies are found with its own %prepend-module-path directories, as its source finds them;
    - an optional module that it was compiled without and that is available now is reported (BINARY-MODULE-STALE;
      the module has no source module to load instead, so it is used).
    The check of the files of a build tree (the depfile) does not apply: the module is part of the program that links
    it, which its build rebuilds.  See design/aot-object-files-and-module-artifacts.md.
*/
class AOTStaticModuleMetadataTest inherits QUnit::Test {
    public {
        #! a C++ host that registers the module from its object and calls it
        const HostCode = "#include <qore/Qore.h>
#include <stdio.h>

extern \"C\" void qore_StatMod_register(QoreProgram*);

int main(int argc, char** argv) {
    qore_init(QL_GPL, \"UTF-8\", true);
    int rc = 1;
    {
        QoreProgram* pgm = new QoreProgram(PO_NEW_STYLE);
        qore_StatMod_register(pgm);
        ExceptionSink xsink;
        pgm->parse(\"%requires StatMod\\nstring sub main() { return StatMod::value(); }\\n\", \"host\", &xsink);
        if (!xsink) {
            ValueHolder v(pgm->callFunction(\"main\", nullptr, &xsink), &xsink);
            if (!xsink && v->getType() == NT_STRING) {
                printf(\"%s\\n\", v->get<const QoreStringNode>()->c_str());
                rc = 0;
            }
        }
        pgm->waitForTerminationAndDeref(&xsink);
    }
    qore_cleanup();
    return rc;
}
";

        #! a C++ host that registers the module in a thread with the stack size (in KB) given as its argument
        /** It prints the error of the registration (from qore_aot_register_into_program_v2(), which reports its
            errors and warnings on stderr), then "result: <value>" if the module could be used, or "failed" and the
            error of the parse
        */
        const ThreadHostCode = "#include <qore/Qore.h>
#include <pthread.h>
#include <stdio.h>
#include <stdlib.h>

extern \"C\" void qore_StatMod_register(QoreProgram*);

static void* work(void*) {
    QoreForeignThreadHelper foreign;
    ExceptionSink xsink;
    QoreProgram* pgm = new QoreProgram(PO_NEW_STYLE);
    qore_StatMod_register(pgm);
    pgm->parse(\"%requires StatMod\\nstring sub main() { return StatMod::value(); }\\n\", \"host\", &xsink);
    if (!xsink) {
        ValueHolder v(pgm->callFunction(\"main\", nullptr, &xsink), &xsink);
        if (!xsink && v->getType() == NT_STRING) {
            printf(\"result: %s\\n\", v->get<const QoreStringNode>()->c_str());
        }
    }
    fflush(stdout);
    if (xsink) {
        printf(\"failed\\n\");
        fflush(stdout);
        xsink.handleExceptions();
    }
    pgm->waitForTerminationAndDeref(&xsink);
    xsink.clear();
    return nullptr;
}

int main(int argc, char** argv) {
    if (argc != 2) {
        return 2;
    }
    qore_init(QL_GPL, \"UTF-8\", true);
    int rc = 1;
    pthread_attr_t attr;
    if (!pthread_attr_init(&attr)) {
        pthread_t thread;
        if (!pthread_attr_setstacksize(&attr, static_cast<size_t>(atoi(argv[1])) * 1024)
                && !pthread_create(&thread, &attr, work, nullptr) && !pthread_join(thread, nullptr)) {
            rc = 0;
        }
        pthread_attr_destroy(&attr);
    }
    qore_cleanup();
    return rc;
}
";

        #! the number of source modules in the chain that the optional module starts
        const OptChainLength = 40;
    }

    private {
        string qore_bin;
        string qcc_bin;
        string libqore_dir;
        string source_root;
        string env;
    }

    constructor() : QUnit::Test("AOTStaticModuleMetadataTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = normalize_dir(ENV.QORE_LIBDIR ?? dirname(qore_bin));
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
            ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");
        source_root = realpath(dirname(get_script_path()) + "/../../..");
        env = sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s QORE_LIBDIR=%s", libqore_dir, libqore_dir,
            libqore_dir);

        addTestCase("a statically registered module is checked with its linked metadata", \staticModuleTest());
        addTestCase("the optional module of a statically registered module runs short of stack",
            \staticModuleStackTest());
        set_return_value(main());
    }

    private static list<string> libqoreTargetFlags() {
        *list<*string> m = (Qore::CFLAGS =~ x/(-mmacosx-version-min=\S+)/);
        return m ? (m[0],) : ();
    }

    private string run(string cmd) {
        return backquote(cmd + " 2>&1");
    }

    private static write(string path, string contents) {
        File f();
        f.open2(path, O_WRONLY | O_CREAT | O_TRUNC);
        f.write(contents);
    }

    #! writes the source of a module with the given directives and body
    private writeModule(string dir, string name, string directives, string body) {
        write(sprintf("%s/%s.qm", dir, name), sprintf("%%modern\n%s\nmodule %s { version = \"1.0\"; "
            "desc = \"test\"; author = \"Qore\"; license = \"MIT\"; }\n%s\n", directives, name, body));
    }

    #! builds a C++ host that links the module object; returns the path of the executable
    private string buildHost(string dir, string code, string obj) {
        string host = dir + "/host.cpp";
        write(host, code);
        string exe = dir + "/static-host";
        # CXX can be a command line, such as "ccache c++"
        list<string> cxx = TestBuildTools::command_words(ENV.CXX, "c++");
        # only a missing compiler skips the test: a compiler that cannot build the host is a failure
        if (!TestBuildTools::find_command(cxx[0])) {
            testSkip(sprintf("no C++ compiler to build the host: %y is not available", cxx[0]));
        }
        int status;
        string out = backquote(sprintf("%s -std=c++17 -pthread -I%s -I%s %s %s -L%s -Wl,-rpath,%s -lqore -o %s %s "
            "2>&1", (map TestBuildTools::shell_quote($1), cxx).join(" "), source_root + "/include",
            libqore_dir + "/include", host, obj, libqore_dir, libqore_dir, exe, libqoreTargetFlags().join(" ")),
            \status);
        assertEq(0, status, "linked the C++ host: " + out);
        assertTrue(is_file(exe), "linked the C++ host: " + out);
        return exe;
    }

    staticModuleTest() {
        TmpDir tmp("qore-aot-static-meta-");
        string src_dir = tmp.path + "/src";
        string own_dir = tmp.path + "/own";
        string opt_dir = tmp.path + "/opt";
        mkdir(src_dir);
        mkdir(own_dir);
        mkdir(opt_dir);
        # Dep is found through StatMod's own directory, before another Dep in the module path; StatOpt is not
        # available when StatMod is compiled
        writeModule(own_dir, "Dep", "", "public namespace Dep { public string sub value() { return \"own\"; } }");
        writeModule(src_dir, "Dep", "", "public namespace Dep { public string sub value() { return \"global\"; } }");
        writeModule(src_dir, "StatMod", sprintf("%%prepend-module-path %s\n%%requires Dep\n%%try-module StatOpt\n"
            "%%define NoStatOpt\n%%endtry", own_dir), "public namespace StatMod { public string sub value() {
%ifdef NoStatOpt
    return Dep::value() + \"-noopt\";
%else
    return Dep::value() + \"-opt\";
%endif
} }");
        string obj = tmp.path + "/StatMod.qo";
        string out = run(sprintf("%s QORE_MODULE_DIR=%s %s -c -o %s %s", env, src_dir, qcc_bin, obj,
            src_dir + "/StatMod.qm"));
        assertTrue(is_file(obj), "compiled the module object: " + out);

        string exe = buildHost(tmp.path, HostCode, obj);

        # the dependency is the Dep of the module's own directory, as for its source
        out = trim(run(sprintf("%s QORE_MODULE_DIR=%s %s", env, src_dir, exe)));
        assertEq("own-noopt", out, out);

        # the optional module is available now: the module is used, and the missing functionality is reported
        writeModule(opt_dir, "StatOpt", "", "public namespace StatOpt {}");
        out = trim(run(sprintf("%s QORE_MODULE_DIR=%s:%s %s", env, src_dir, opt_dir, exe)));
        assertEq("own-noopt", out.split("\n").last(), out);
        assertRegex("warning: AOT module 'StatMod' linked into this program was compiled when optional module "
            "'StatOpt' was not available, but it is available now", out);
    }

    #! The optional module of a statically registered module is checked with the stack of the registering thread
    /** StatMod was compiled without StatOpt, which is available now as the first of a chain of source modules that
        require each other, so the check of the optional module (which loads it) needs much more stack than the
        registration itself.  With the stack for it, the module is used and the missing functionality is reported
        (BINARY-MODULE-STALE); where the check runs short of the thread's stack, it cannot tell, and the registration
        must fail with the parse stack error: the module must never be used silently as if StatOpt were missing
        (issue #6047).  The host runs in a process of its own for each stack size, as a process loads a module once.
    */
    staticModuleStackTest() {
        if (!Option::HAVE_STACK_GUARD) {
            testSkip("runtime built without native stack protection");
        }
        TmpDir tmp("qore-aot-static-stack-");
        string src_dir = tmp.path + "/src";
        string opt_dir = tmp.path + "/opt";
        mkdir(src_dir);
        mkdir(opt_dir);
        writeModule(src_dir, "StatMod", "%try-module StatOpt\n%define NoStatOpt\n%endtry",
            "public namespace StatMod { public string sub value() {
%ifdef NoStatOpt
    return \"noopt\";
%else
    return \"opt\";
%endif
} }");
        string obj = tmp.path + "/StatMod.qo";
        string out = run(sprintf("%s QORE_MODULE_DIR=%s %s -c -o %s %s", env, src_dir, qcc_bin, obj,
            src_dir + "/StatMod.qm"));
        assertTrue(is_file(obj), "compiled the module object: " + out);
        string exe = buildHost(tmp.path, ThreadHostCode, obj);
        for (int i = 0; i < OptChainLength; ++i) {
            writeModule(opt_dir, "StatOpt" + (i ? string(i) : ""),
                i + 1 < OptChainLength ? sprintf("%%requires StatOpt%d", i + 1) : "",
                sprintf("public namespace StatOpt%s { public bool sub matches(string s) { "
                    "return s =~ /^a(b+)c[0-9]{2,}(x|y|z)*$/; } }", i ? string(i) : ""));
        }
        int used;
        int stack_errors;
        for (int kb = 96; kb <= 1024; kb += 32) {
            # only the optional modules are in the module path: the module has no source to load instead
            out = run(sprintf("%s QORE_MODULE_DIR=%s %s %d", env, opt_dir, exe, kb));
            string label = sprintf("%dK", kb);
            if (out =~ /result: noopt/) {
                # the module is used without StatOpt only with the warning that it is available now
                assertRegex("AOT module 'StatMod' linked into this program was compiled when optional module "
                    "'StatOpt' was not available, but it is available now", out, label);
                ++used;
            } else {
                assertRegex("\\bfailed\\b", out, label);
                assertRegex("PARSE-STACK-LIMIT-EXCEEDED", out, label);
                ++stack_errors;
            }
        }
        assertGt(0, used, "the module is used with a large stack");
        assertGt(0, stack_errors, "the check of the optional module runs short of a small stack");
    }
}
