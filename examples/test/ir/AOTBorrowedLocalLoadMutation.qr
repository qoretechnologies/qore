#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright 2026 Qore Technologies, s.r.o.
# SPDX-License-Identifier: MIT

# A value read from a local before an operation that changes the local in place (extract, splice, remove, push,
# an element assignment) keeps the value it was read with when it is used after the operation, as with the AST
# interpreter; AOTBorrowedLocalLoadMutation.qtest compares the output of every mode with AST execution

%modern

list<auto> sub list_extract() {
    list<auto!> l = (1, 2, 3, 4);
    return (l, (extract l, 0, 1), l);
}

list<auto> sub list_splice() {
    list<auto!> l = (1, 2, 3, 4);
    return (l, (splice l, 1, 2, ("x",)), l);
}

list<auto> sub list_push() {
    list<auto!> l = (1, 2);
    return (l, (push l, 3), l);
}

list<auto> sub list_element() {
    list<auto!> l = (1, 2);
    return (l, l[0] = 9, l);
}

list<auto> sub hash_remove() {
    hash<auto!> h = {"a": 1, "b": 2};
    return (h, (remove h.a), h);
}

list<auto> sub hash_member() {
    hash<auto!> h = {"a": 1};
    return (h, h.b = 2, h);
}

list<auto> sub string_splice() {
    string s = "abcdef";
    return (s, (splice s, 1, 3), s);
}

string sub args(list<auto> before, auto extracted, list<auto> after) {
    return sprintf("%y %y %y", before, extracted, after);
}

string sub call_args() {
    list<auto!> l = (1, 2, 3);
    return args(l, (extract l, 0, 1), l);
}

# the value is read before a loop and used after it, while the loop changes the local
list<auto> sub loop_live() {
    list<auto!> l = (1, 2, 3);
    list<auto> before = l;
    auto first = l;
    for (int i = 0; i < 3; ++i) {
        l[i] = l[i] * 10;
    }
    return (before, first, l);
}

# changes in place with no value read before them in use after them: the result is the changed local
int sub loop_in_place() {
    list<int> l = ();
    for (int i = 0; i < 20000; ++i) {
        push l, i;
    }
    for (int i = 0; i < 20000; ++i) {
        l[i] = l[i] + 1;
    }
    int n = 0;
    while (l) {
        list<int> x = extract l, 0, 100;
        n += x.size();
    }
    return n;
}

# each function runs several times, so that tiered execution compiles it
for (int pass = 0; pass < 3; ++pass) {
    list<string> out = (
        sprintf("list extract: %y", list_extract()),
        sprintf("list splice: %y", list_splice()),
        sprintf("list push: %y", list_push()),
        sprintf("list element: %y", list_element()),
        sprintf("hash remove: %y", hash_remove()),
        sprintf("hash member: %y", hash_member()),
        sprintf("string splice: %y", string_splice()),
        sprintf("call args: %s", call_args()),
        sprintf("loop live: %y", loop_live()),
        sprintf("loop in place: %y", loop_in_place()),
    );
    if (!pass) {
        map printf("%s\n", $1), out;
    }
}
