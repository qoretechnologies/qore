}

string map_store_unassigned_path = "/tmp/qore-aot-batch-callee-fast-path-map-store-unassigned-"
    + string(getpid()) + ".qr";
File map_store_unassigned_script();
map_store_unassigned_script.open2(map_store_unassigned_path, O_WRONLY | O_CREAT | O_TRUNC);
map_store_unassigned_script.write(mapStoreUnassignedScriptCode());
