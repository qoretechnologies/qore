#!/usr/bin/env qore
# Copyright 2026 Qore Technologies, s.r.o. -- SPDX-License-Identifier: MIT
%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil
%exec-class CrossProgramMethodEntryTest

class CrossProgramMethodEntryTest inherits QUnit::Test {
    private {
        string root = realpath(get_script_dir() + "/../../..");
        string libdir = realpath(ENV.QORE_LIBDIR ?? root + "/build");
        string qore = ENV.QORE_BIN ?? libdir + "/qore";
        string qcc = ENV.QCC ?? libdir + "/qcc";
    }
    constructor() : Test("native scalar method retry after Program entry", "1.0", \ARGV) {
        addTestCase("integer and float entry and restoration", \check());
        set_return_value(main());
    }
    private static string quote(string value) {
        return "'" + replace(value, "'", "'\"'\"'") + "'";
    }
    private static write(string path, string value) {
        File file();
        file.open2(path, O_WRONLY | O_CREAT | O_TRUNC);
        on_exit file.close();
        file.write(value);
    }
    private string run(list<string> args, string modules, string prefix = "") {
        int status;
        string output = backquote(prefix + "QORE_MODULE_DIR=" + quote(modules)
            + " LD_LIBRARY_PATH=" + quote(libdir) + " DYLD_LIBRARY_PATH=" + quote(libdir)
            + " " + (map quote($1), args).join(" ") + " 2>&1", \status);
        assertEq(0, status, output);
        assertFalse(output.contains("loading source module"));
        return output;
    }
    private check() {
        TmpDir dir("qore-cross-program-method-");
        mkdir(dir.path + "/source");
        mkdir(dir.path + "/modules");
        string source = dir.path + "/source/CrossProgramMethodEntry.qm";
        write(source, "%modern
module CrossProgramMethodEntry { version = \"1.0\"; desc = \"Cross-Program native method regression\";
    author = \"Qore\"; license = \"MIT\"; }
public namespace CrossProgramMethodEntry {
    public class Base { int next(int value) { return value + 11; } }
    public class Derived inherits Base { int next(int value) { return value + 17; } }
    public Base sub make() { return new Derived(); }
    public auto sub call(Base receiver, int value) { return receiver.next(value); }
    public class FloatBase { float next(float value) { return value + 11.0; } }
    public class FloatDerived inherits FloatBase { float next(float value) { return value + 17.0; } }
    public FloatBase sub makeFloat() { return new FloatDerived(); }
    public auto sub callFloat(FloatBase receiver, float value) { return receiver.next(value); }
}
");
        string host = dir.path + "/host.qr";
        write(host, "%modern
%requires CrossProgramMethodEntry
auto integer = CrossProgramMethodEntry::make();
auto floating = CrossProgramMethodEntry::makeFloat();
for (int round = 0; round < 16; ++round) {
    if (CrossProgramMethodEntry::call(integer, -7) != 10
            || CrossProgramMethodEntry::callFloat(floating, -7.25) != 9.75) {
        throw \"CROSS-PROGRAM-METHOD\", \"incorrect result\";
    }
}
printf(\"cross-program-method-source: ok\\n\");
");
        foreach string mode in (("ast", "ir", "jit", "tiered")) {
            assertEq("cross-program-method-source: ok\n",
                run((qore, "--exec-mode=" + mode, host), dir.path + "/source"));
        }
        list<string> probes;
        foreach bool floating in ((False, True)) {
            string probe = dir.path + (floating ? "/float-probe" : "/int-probe");
            list<string> args = (ENV.CXX ?? "c++", "-std=c++20", "-O3", "-DNDEBUG", "-pthread",
                "-DHAVE_UNIX_CONFIG_H", "-I" + root + "/include", "-I" + libdir + "/include",
                "-I" + libdir, get_script_dir() + "/cross_program_method_entry.cpp", "-L" + libdir,
                "-Wl,-rpath," + libdir, "-lqore", "-o", probe);
            if (floating) { push args, "-DPROBE_FLOAT=1"; }
            *list<*string> target = (Qore::CFLAGS =~ x/(-mmacosx-version-min=\S+)/);
            if (target) { push args, target[0]; }
            run(args, dir.path + "/source");
            push probes, probe;
        }
        foreach string compile_prefix in (("", "QORE_AOT_EH=1 ")) {
            foreach string level in (("-O0", "-O3")) {
                run((qcc, level, "--strip-source", "-m", "-o",
                    dir.path + "/modules/CrossProgramMethodEntry.qmod", source),
                    dir.path + "/source", compile_prefix);
                foreach string prefix in (("", "QORE_DISABLE_AOT_NATIVE_METHOD_CONTINUATION=1 ",
                        "QORE_DISABLE_AOT_CROSS_PROGRAM_METHOD_ENTRY=1 ",
                        "QORE_DISABLE_AOT_NATIVE_METHOD_ENTRY=1 ",
                        "QORE_DISABLE_AOT_SCALAR_PARAM_BINDING_CACHE=1 ")) {
                    string enabled = (!prefix || prefix.startsWith("QORE_DISABLE_AOT_NATIVE_METHOD_CONTINUATION"))
                        && !ENV.QORE_TEST_EXPECT_NO_CROSS_PROGRAM_METHOD ? "1" : "0";
                    foreach string probe in (probes) {
                        assertRegex("cross-program-method-entry: [0-9]+ entries; [0-9]+ checks passed",
                            run((probe, enabled), dir.path + "/modules", prefix));
                    }
                    foreach string mode in (("ast", "ir", "jit", "tiered")) {
                        assertEq("cross-program-method-source: ok\n",
                            run((qore, "--exec-mode=" + mode, host), dir.path + "/modules", prefix));
                    }
                }
            }
        }
    }
}
