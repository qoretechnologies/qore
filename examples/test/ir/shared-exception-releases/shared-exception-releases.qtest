#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - every check runs a script in a child process that sets its own --exec-mode, or AOT

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires ../../TestInterpreter.qm
%requires FsUtil
%requires ../../ExecModeHarness.qm

%exec-class SharedExceptionReleasesTest

#! the releases of the temporaries of a statement that an exception interrupts, shared by its checks (qore#7174)
/** The native code of each exception check of a statement released the statement's temporaries that were live at it
    on an edge of its own, so that its code grew with the product of its checks and temporaries (a statement of
    untyped code has dozens of checks); the edges of the checks of a statement now share the releases of the
    temporaries that they release last.

    The script next to the test interrupts statements of untyped and of typed temporaries, in a loop, with the
    iterator of a map operator and in the value of a return, at each of their checks; it runs in every execution mode,
    on the IR tier and as AOT executables, and its output, which shows the destruction of each temporary and the
    exception, must be that of the AST interpreter.
*/
class SharedExceptionReleasesTest inherits QUnit::Test {
    public {
        #! the script
        const Script = "release-cases";
    }

    private {
        string qore_bin;
        string qcc_bin;
        string env;
    }

    constructor() : QUnit::Test("shared exception releases", "1.0", \ARGV) {
        qore_bin = TestInterpreter::qore_interpreter();
        string libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
            ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");
        env = sprintf("LD_LIBRARY_PATH=%s QORE_LIBDIR=%s", libqore_dir, libqore_dir);

        addTestCase("AST semantics", \astTest());
        addTestCase("execution modes", \modesTest());
        addTestCase("AOT executables", \aotTest());
        set_return_value(main());
    }

    #! checks the output of the AST interpreter
    private astTest() {
        string out = astOutput();
        assertTrue(out =~ /^untyped:\n  0: ~a ! AT: check 0\n  1: ~b ~a ! AT: check 1\n/, "untyped, first checks");
        assertTrue(out =~ /\n  4: ~e ~d ~c ~b ~a ! AT: check 4\n  5: ~e ~d ~c ~b ~a = 15\ntyped:\n/,
            "untyped, last check and no exception");
        assertTrue(out =~ /\ntyped:\n  0: ~ta ! AT: check 0\n  1: ~tb ~ta ! AT: check 1\n/, "typed");
        assertTrue(out =~ /\nloop:\n  0: ~l0 ! AT: check 0\n  1: ~m0 ~l0 ! AT: check 1\n  2: ~m0 ~l0 ~l1 ! AT/,
            "loop: the temporaries of each iteration");
        assertTrue(out =~ /\nreturn:\n  0: ~ra ! AT: check 0\n/, "return value");
        # every case runs twice, with the same output
        list<string> parts = out.split("untyped:\n");
        assertEq(3, parts.size(), "two passes");
        assertEq(parts[1], parts[2], "the passes give the same output");
    }

    #! runs the script in every execution mode and on the IR tier
    private modesTest() {
        string exp = astOutput();
        foreach string mode in (ExecModeHarness::ExecModes) {
            if (mode == "ast") {
                continue;
            }
            assertEq(exp, ExecModeHarness::run(sprintf("%s %s --exec-mode=%s %s", env, qore_bin, mode, scriptPath())),
                mode);
        }
        assertEq(exp, ExecModeHarness::run_ir_tier(sprintf("%s %s --exec-mode=tiered %s", env, qore_bin,
            scriptPath())), ExecModeHarness::IRTierName);
    }

    #! compiles the script with qcc -O0 and -O3 and checks that the executables give the output of the AST
    #! interpreter
    private aotTest() {
        if (!is_file(qcc_bin)) {
            testSkip("qcc is not available at " + qcc_bin);
        }
        string exp = astOutput();
        TmpDir dir("shared-exception-releases-aot-");
        foreach string opt in ("-O0", "-O3") {
            string exe = sprintf("%s/%s%s", dir.path, Script, opt);
            string out = ExecModeHarness::run_any(sprintf("%s %s %s -o %s %s", env, qcc_bin, opt, exe, scriptPath()));
            assertTrue(is_file(exe), sprintf("%s: qcc compiles the script: %s", opt, out));
            assertEq(exp, ExecModeHarness::run_any(sprintf("%s %s", env, exe)), "AOT " + opt);
        }
    }

    private string scriptPath() {
        return get_script_dir() + "/" + Script + ".q";
    }

    #! the output of the script with the AST interpreter
    private string astOutput() {
        return ExecModeHarness::run(sprintf("%s %s --exec-mode=ast %s", env, qore_bin, scriptPath()));
    }
}
