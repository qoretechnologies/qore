#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - AOT code generation and linking of qcc executables
# Copyright (C) 2026 Qore Technologies, s.r.o.
# SPDX-License-Identifier: MIT
# test-exec-mode: children - its checks run in child processes that set their own execution modes

%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires ../TestInterpreter.qm
%requires FsUtil
%requires ../ExecModeHarness.qm

%exec-class ForeachReferenceElementReleaseTest

#! The variable of a foreach loop given a reference by an element releases the value that it reads as
/** A foreach loop assigns its variable each element as it is, so an untyped variable can hold a reference given by
    an element, and every read of the variable reads the referenced lvalue; the value read is a temporary of the
    expression, released when the statement ends or by the callee that it is given to.  Native code never released it,
    so the object was leaked (issue #6441).  The script (ForeachReferenceElementRelease.qr) logs the destructions of
    objects read through references to a global variable, a list element, a hash key and a member, read in the loop,
    passed on through auto parameters to functions, methods, static methods and closures that keep the value and clear
    the referenced variable, from functions and from top-level code, and given to methods (called directly, by name,
    through a call reference, with the value of another method call, an overridden method called through a variable
    of the base class and directly, and methods of final classes), static methods and closures called through
    a reference that write the referenced variable and their parameter, whose write destroys the object in every mode
    (issue #6538); every execution mode, native code compiled before the code that calls it runs, tiered execution on
    the IR tier and qcc executables at -O0 and -O3 (with and without QORE_AOT_EH) must give the AST interpreter's
    output, also when two threads run the same function at the same time, one over a list that holds a reference and
    one over a list that does not (ForeachReferenceElementReleaseThreads.qr).
*/
class ForeachReferenceElementReleaseTest inherits QUnit::Test {
    private {
        string qore = TestInterpreter::qore_interpreter();
        string libdir = ENV.QORE_LIBDIR ?? dirname(qore);
        string qcc = ENV.QCC ?? (is_file(libdir + "/qcc") ? libdir + "/qcc" : dirname(qore) + "/qcc");
        string script = get_script_dir() + "/ForeachReferenceElementRelease.qr";
        string threads_script = get_script_dir() + "/ForeachReferenceElementReleaseThreads.qr";
        string env;
        *string expected;

        #! the lines of the AST interpreter's output that must precede another one: (earlier, later)
        const Order = (
            ("dtor alt", "after alt"),
            ("dtor plain", "after plain"),
            ("dtor clear", "after clear clear"),
            ("dtor lel", "after lel"),
            ("dtor hkey", "after hkey"),
            ("dtor member", "after member"),
            ("dtor give", "after write give"),
            ("dtor gmeth", "after write gmeth"),
            ("dtor gfirst", "after write gfirst"),
            ("after write gname", "dtor gname"),
            ("dtor gstatic", "after write gstatic"),
            ("dtor gcref", "after write gcref"),
            ("dtor gmref", "after write gmref"),
            ("dtor gnest", "after write gnest"),
            ("dtor gobase", "after write gobase"),
            ("dtor goderived", "after write goderived"),
            ("dtor gfinal", "after write gfinal"),
            ("dtor kfinal", "after kfinal"),
            ("dtor kmeth", "after kmeth"),
            ("dtor kstatic", "after kstatic"),
            ("dtor kclosure", "after kclosure"),
            ("dtor top", "after clear top"),
        );
    }

    constructor() : Test("ForeachReferenceElementRelease", "1.0", \ARGV) {
        env = sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s ", libdir, libdir);
        addTestCase("the AST interpreter releases a value read through a reference by a foreach variable",
            \testAst());
        addTestCase("every execution mode releases a value read through a reference by a foreach variable",
            \testModes());
        addTestCase("two threads running the same function with and without references release as in the AST "
            "interpreter", \testThreads());
        addTestCase("compiled executables release a value read through a reference by a foreach variable",
            \testAot());
        set_return_value(main());
    }

    private string getExpected() {
        if (!expected) {
            expected = ExecModeHarness::run(sprintf("%s%s -b --enable-debug --exec-mode=ast %s", env, qore,
                script));
        }
        return expected;
    }

    testAst() {
        list<string> lines = getExpected().split("\n");
        assertEq("round end 2", lines.last() ?: lines[lines.size() - 2]);
        # the index of the first occurrence of each line
        hash<string, int> index();
        foreach string line in (lines) {
            if (!exists index{line}) {
                index{line} = $#;
            }
        }
        foreach list<string> order in (Order) {
            *int before = index{order[0]};
            *int after = index{order[1]};
            assertTrue(exists before && exists after && before < after, sprintf("%y before %y", order[0], order[1]));
        }
    }

    testModes() {
        string exp = getExpected();
        hash<string, list<string>> wrong();
        foreach string mode in (ExecModeHarness::ExecModes + ExecModeHarness::IRTierName) {
            bool ir_tier = mode == ExecModeHarness::IRTierName;
            string cmd = sprintf("%s%s -b --enable-debug --exec-mode=%s %s", env, qore, ir_tier ? "tiered" : mode,
                script);
            string actual = ir_tier ? ExecModeHarness::run_ir_tier(cmd) : ExecModeHarness::run(cmd);
            list<string> diff = differences(exp, actual);
            if (diff) {
                wrong{mode} = diff;
            }
        }
        # native code compiled before the code that calls it runs, and call sites that the IR interpreter ran inline
        # calling a callee once it is compiled
        foreach string control in (("QORE_JIT_SYNC_COMPILE=1 QORE_IR_THRESHOLD=1 QORE_JIT_THRESHOLD=1 ",
                "QORE_JIT_SYNC_COMPILE=1 QORE_IR_THRESHOLD=1 QORE_JIT_THRESHOLD=20 ")) {
            foreach string mode in (("jit", "tiered")) {
                string actual = ExecModeHarness::run(sprintf("%s%s%s -b --enable-debug --exec-mode=%s %s", env,
                    control, qore, mode, script));
                list<string> diff = differences(exp, actual);
                if (diff) {
                    wrong{control + mode} = diff;
                }
            }
        }
        assertEq({}, wrong);
    }

    #! two threads run the same function at the same time, one reading through references, the other not
    /** The decision to give the value read to the call is made when the function is lowered, never by a run of it,
        so that a thread whose list holds no reference runs the same code as one whose list does (issue #6538)
    */
    testThreads() {
        string exp = ExecModeHarness::run(sprintf("%s%s -b --enable-debug --exec-mode=ast %s", env, qore,
            threads_script));
        assertEq(1200, exp.split("\n").size());
        hash<string, list<string>> wrong();
        foreach string mode in (ExecModeHarness::ExecModes + ExecModeHarness::IRTierName) {
            bool ir_tier = mode == ExecModeHarness::IRTierName;
            string cmd = sprintf("%s%s -b --enable-debug --exec-mode=%s %s", env, qore, ir_tier ? "tiered" : mode,
                threads_script);
            string actual = ir_tier ? ExecModeHarness::run_ir_tier(cmd) : ExecModeHarness::run(cmd);
            list<string> diff = differences(exp, actual);
            if (diff) {
                wrong{mode} = diff[0..4];
            }
        }
        foreach string control in (("QORE_JIT_SYNC_COMPILE=1 QORE_IR_THRESHOLD=1 QORE_JIT_THRESHOLD=1 ",
                "QORE_JIT_SYNC_COMPILE=1 QORE_IR_THRESHOLD=1 QORE_JIT_THRESHOLD=20 ")) {
            foreach string mode in (("jit", "tiered")) {
                string actual = ExecModeHarness::run(sprintf("%s%s%s -b --enable-debug --exec-mode=%s %s", env,
                    control, qore, mode, threads_script));
                list<string> diff = differences(exp, actual);
                if (diff) {
                    wrong{control + mode} = diff[0..4];
                }
            }
        }
        TmpDir tmp("qore-foreach-reference-element-release-threads-");
        foreach string level in (("-O0", "-O3")) {
            string exe = tmp.path + DirSep + "threads" + level;
            string out = backquote(sprintf("%s%s %s -o %s %s 2>&1", env, qcc, level, exe, threads_script));
            assertTrue(is_file(exe), "compiled the executable: " + out);
            list<string> diff = differences(exp, ExecModeHarness::run_any(env + exe));
            if (diff) {
                wrong{level} = diff[0..4];
            }
            unlink(exe);
        }
        assertEq({}, wrong);
    }

    testAot() {
        string exp = getExpected();
        TmpDir tmp("qore-foreach-reference-element-release-");
        hash<string, list<string>> wrong();
        # QORE_AOT_EH is read when the code is compiled
        foreach string level in (("-O0", "-O3")) {
            foreach string prefix in (("", "QORE_AOT_EH=1 ")) {
                string exe = tmp.path + DirSep + "fixture" + level;
                string out = backquote(sprintf("%s%s%s %s -o %s %s 2>&1", env, prefix, qcc, level, exe, script));
                assertTrue(is_file(exe), "compiled the executable: " + out);
                list<string> diff = differences(exp, ExecModeHarness::run_any(env + exe));
                if (diff) {
                    wrong{prefix + level} = diff;
                }
                unlink(exe);
            }
        }
        assertEq({}, wrong);
    }

    #! returns the lines of the output that differ from the expected output, as "expected -> actual"
    static list<string> differences(string exp, string actual) {
        list<string> el = exp.split("\n");
        list<string> al = actual.split("\n");
        list<string> rv = ();
        for (int i = 0; i < max(el.size(), al.size()); ++i) {
            if (el[i] !== al[i]) {
                rv += sprintf("%d: %y -> %y", i, el[i], al[i]);
            }
        }
        return rv;
    }
}
