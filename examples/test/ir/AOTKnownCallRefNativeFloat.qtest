%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../ExecModeHarness.qm
%exec-class KnownCallRefNativeFloatTest

class KnownCallRefNativeFloatTest inherits QUnit::Test {
    private {
        string libdir = realpath(ENV.QORE_LIBDIR ?? get_script_dir() + "/../../../build");
        string qore = ENV.QORE_BIN ?? libdir + "/qore";
        string qcc = ENV.QCC ?? libdir + "/qcc";
        string behavior = get_script_dir() + "/AOTKnownCallRefNativeFloat.qr";
    }
    constructor() : Test("AOT known callback native float arguments", "1.0", \ARGV) {
        addTestCase("native argument proof and observable fallbacks", \check());
        set_return_value(main());
    }
    private static string quote(string value) {
        return "'" + replace(value, "'", "'\"'\"'") + "'";
    }
    private string run(list<string> args, string prefix = "") {
        hash<ExecModeHarness::ModeRunResult> result = ExecModeHarness::run_command(prefix
            + "LD_LIBRARY_PATH=" + quote(libdir) + " DYLD_LIBRARY_PATH=" + quote(libdir)
            + " " + (map quote($1), args).join(" "));
        if (result.mode) { ExecModeHarness::check_native(result); }
        assertEq(0, result.rc, result.out);
        return result.out;
    }
    private check() {
        foreach string prefix in (("", "QORE_DISABLE_AOT_KNOWN_CALLREF_NATIVE_FLOAT=1 ")) {
            foreach string mode in (("ast", "ir", "jit", "tiered")) {
                assertEq("known-callref-native-float: ok\n",
                    run((qore, "--exec-mode=" + mode, behavior), prefix), prefix + mode);
            }
        }
        TmpDir dir("qore-known-callref-native-float-");
        foreach string prefix in (("", "QORE_DISABLE_AOT_KNOWN_CALLREF_NATIVE_FLOAT=1 ", "QORE_AOT_EH=1 ",
                "MAKEFLAGS= QCC_JOBS=4 QCC_SPLIT_THRESHOLD=1 ")) {
            foreach string level in (("-O0", "-O3")) {
                string executable = dir.path + "/behavior";
                string generated = run((qcc, level, "--strip-source", "-o", executable, behavior),
                    prefix + "QORE_DUMP_IR_AFTER_OPT=1 ");
                if (level == "-O3" && !prefix.contains("QCC_SPLIT_THRESHOLD")) {
                    int inspected = 0;
                    foreach string definition in (generated.split("\ndefine ")) {
                        string header = definition.split("\n")[0];
                        if (!header.contains("@knownNativeFloatLoop_") || !header.contains("_fast_")) {
                            continue;
                        }
                        string body = definition.split("\n}")[0];
                        bool disabled = prefix.startsWith("QORE_DISABLE_");
                        assertEq(disabled, body.contains("@qore_rt_try_funcref_"),
                            "native float argument selection " + prefix);
                        assertEq(disabled, body.contains("@qore_rt_call_closure"),
                            "generic fallback only for arguments needing checks " + prefix);
                        assertTrue(body.contains("@qore_rt_check_stack"), "live entry stack check");
                        assertTrue(body.contains("load atomic"), "live cancellation checks");
                        ++inspected;
                    }
                    assertEq(1, inspected, "inspected known callback fast entry");
                }
                assertEq("known-callref-native-float: ok\n", run((executable,)), prefix + level);
            }
        }
    }
}
