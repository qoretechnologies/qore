%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../TestInterpreter.qm
%requires ../../ExecModeHarness.qm

%include InlineHandlerFlowLoop.qc

%exec-class InlineHandlerFlowLoopPart3

#! runs part 3 of 3 of the cases of InlineHandlerFlowLoopBase: qcc -O3
class InlineHandlerFlowLoopPart3 inherits InlineHandlerFlowLoopBase {
    constructor() : InlineHandlerFlowLoopBase("InlineHandlerFlowLoopPart3", 3) {
    }
}
