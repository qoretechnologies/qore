#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil
%requires Util

%exec-class AOTQoLockTest

# qore-qo-lock is the object-group build's mutual exclusion.  Two things in that
# build are serialised -- the whole-group parse behind its bootstrap stamp, and each
# component's compile behind its own lock -- and both used to publish a hard link
# and poll for it once a second.
#
# The poll was not the whole cost.  A hard link outlives the process that made it,
# so every waiter had to decide whether an existing lock was abandoned: read the
# owner pid out of a record, ask whether that pid was alive, compare-and-remove if
# it was not, and recognise the lock shapes older versions of the helpers published.
# None of that could be made exclusive -- two waiters behind one abandoned lock both
# reclaim it -- so "two builders removed the same lock" had to be defined as normal
# operation rather than as the error it looks like.
#
# An fcntl lock is owned by the kernel and released when its holder exits, however
# it exits.  These cases are the properties the build depends on for that to be a
# replacement rather than a change of subject.
class AOTQoLockTest inherits QUnit::Test {
    private {
        string qore_bin;
        string lock_tool;
    }

    constructor() : QUnit::Test("AOTQoLockTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        lock_tool = normalize_dir(get_script_dir() + "/../../../tools")
            + DirSep + "qore-qo-lock";

        addTestCase("the command runs and its status is the helper's status",
            \testStatusIsPassedThrough());
        addTestCase("an uncontended lock reports that it did not wait",
            \testUncontendedReportsNoWait());
        addTestCase("a second holder waits for the first and does not overlap it",
            \testContendedSerialises());
        addTestCase("a killed holder releases the lock with nothing to reclaim",
            \testKilledHolderReleasesTheLock());
        addTestCase("the lock file is not removed by the holder",
            \testLockFileSurvives());
        addTestCase("arguments reach the command unsplit",
            \testArgumentsAreNotResplit());
        addTestCase("a missing argument is a usage error", \testUsage());

        set_return_value(main());
    }

    #! One shell word, with every expansion suppressed.
    /** Deliberately not sprintf("%y"): that is a double-quoted literal, and a shell
        still expands `$` inside one -- which would make these cases assert what the
        TEST's own quoting did rather than what the helper's did.
    */
    private string q(string s) {
        return "'" + replace(s, "'", "'\\''") + "'";
    }

    #! Returns the next line written to the FIFO open for reading in \a f, or @ref nothing at its end
    /** Opening a FIFO for reading blocks until a writer opens it, and a read blocks until the writer writes, so
        this is a handshake with the process at the other end rather than a condition polled for: the cases wait
        for exactly the event they depend on, however loaded the machine is.
    */
    private *string readFifoLine(ReadOnlyFile f) {
        return f.readLine(False);
    }

    #! Writes a line to the FIFO at \a path, blocking until its reader opens it
    private writeFifoLine(string path, string line) {
        File f();
        f.open2(path, O_WRONLY);
        f.write(line + "\n");
        f.close();
    }

    #! Lets a command blocked reading the FIFO at \a path go on, if one is; for the cleanup of a case
    /** A non-blocking open for writing fails when the FIFO has no reader, so this never blocks.
    */
    private release(string path) {
        try {
            File f();
            f.open2(path, O_WRONLY | O_NONBLOCK);
            f.write("go\n");
            f.close();
        } catch (hash<ExceptionInfo> ex) {
            # no reader: nothing is blocked on it
        }
    }

    #! Creates a FIFO in the case's temporary directory and returns its path
    private string fifo(TmpDir tmp, string name) {
        string path = tmp.path + DirSep + name;
        if (mkfifo(path)) {
            throw "LOCK-TEST-ERROR", sprintf("cannot create FIFO %y: %s", path, strerror());
        }
        return path;
    }

    #! Runs a shell command in a background thread; its exit status and output are put on the queue returned
    /** The case continues while the command runs and later waits for it on the queue, so it never sleeps and
        never polls for the command's end.
    */
    private Queue runInBackground(string command) {
        Queue q();
        background sub () {
            int rc;
            string output = backquote(command, \rc);
            q.push({"rc": rc, "output": output});
        }();
        return q;
    }

    #! Runs the helper, returning its exit status and combined output.
    private hash<auto> run(softlist<string> args) {
        string command = q(qore_bin) + " " + q(lock_tool);
        foreach string arg in (args) {
            command += " " + q(arg);
        }
        string output = backquote("{ " + command + "; } 2>&1; echo \"rc=$?\"");
        int marker = output.rfind("rc=");
        return (
            "output": output.substr(0, marker),
            "rc": output.substr(marker + 3).toInt(),
        );
    }

    private string lockPath(TmpDir tmp, string name) {
        return tmp.path + DirSep + name;
    }

    testStatusIsPassedThrough() {
        TmpDir tmp("qore-qo-lock-status-");
        # The build reads 75 and 76 out of the command it runs under this lock --
        # moved sources and a graph transition -- and acts differently on each, so a
        # status the helper flattened would be a silent behaviour change.
        foreach int status in (0, 1, 75, 76) {
            hash<auto> result = run((lockPath(tmp, "l"), "/bin/sh", "-c",
                sprintf("exit %d", status)));
            assertEq(status, result.rc,
                sprintf("status %d reaches the caller unchanged", status));
        }
    }

    testUncontendedReportsNoWait() {
        TmpDir tmp("qore-qo-lock-free-");
        hash<auto> result = run((lockPath(tmp, "l"), "/bin/sh", "-c",
            "printf '%s' \"$QORE_QO_LOCK_WAITED\""));
        assertEq(0, result.rc, "the command ran: " + result.output);
        assertEq("0", result.output,
            "an uncontended lock reports that nothing was waited for");
    }

    #! A second holder must block until the first leaves, and must know it blocked.
    /** The "did I wait" answer is not cosmetic: a follower that waited for the
        group lock re-checks what it came to do, because the holder it waited behind
        may have published exactly that.  It is taken from a non-blocking attempt
        made before blocking, so it reports contention rather than inferring it from
        how long the wait took.

        Every step is a handshake through a FIFO, never a duration: the holder says
        when it is inside its critical section and leaves only when the case lets it,
        and the waiter's trace says when it found the lock held and blocked on it.
    */
    testContendedSerialises() {
        TmpDir tmp("qore-qo-lock-contended-");
        string lock = lockPath(tmp, "l");
        string log = tmp.path + DirSep + "order";
        string inside = fifo(tmp, "inside");
        string leave = fifo(tmp, "leave");
        string trace = fifo(tmp, "trace");
        on_exit release(leave);

        # the holder stays in its critical section until the case writes to "leave"
        Queue holder = runInBackground(sprintf("%s %s %s /bin/sh -c %s 2>&1",
            q(qore_bin), q(lock_tool), q(lock),
            q(sprintf("echo A-enter-$QORE_QO_LOCK_WAITED >> %s; echo in > %s; cat %s > /dev/null; "
                "echo A-leave >> %s", log, inside, leave, log))));
        # the holder is inside its critical section
        {
            ReadOnlyFile f(inside);
            assertEq("in", readFifoLine(f));
        }

        # the waiter's trace goes to a FIFO
        Queue waiter = runInBackground(sprintf("QORE_QO_LOCK_TRACE=1 %s %s %s /bin/sh -c %s 2> %s",
            q(qore_bin), q(lock_tool), q(lock),
            q(sprintf("echo B-enter-$QORE_QO_LOCK_WAITED >> %s; echo B-leave >> %s", log, log)), q(trace)));
        ReadOnlyFile trace_reader(trace);
        # the waiter found the lock held and is blocked on it
        assertEq("qore-qo-lock: waiting for " + lock, readFifoLine(trace_reader),
            "the waiter blocks on the held lock");

        # the holder leaves, and the waiter then gets the lock and runs its command
        writeFifoLine(leave, "go");
        hash<auto> h = holder.get();
        assertEq(0, h.rc, "the holder ran: " + h.output);
        hash<auto> w = waiter.get();
        assertEq(0, w.rc, "the waiter ran: " + w.output);
        assertEq("qore-qo-lock: locked " + lock + " pid", (readFifoLine(trace_reader) =~ x/^(.* pid) [0-9]+$/)[0],
            "the waiter held the lock after the holder left");

        list<string> order = ();
        foreach string line in (ReadOnlyFile::readTextFile(log).split("\n")) {
            if (trim(line)) {
                push order, trim(line);
            }
        }
        assertEq(("A-enter-0", "A-leave", "B-enter-1", "B-leave"), order,
            sprintf("the critical sections do not overlap and the waiter knows it "
                "waited: %y", order));
    }

    #! The property the hard-link lock could not have: death releases the lock.
    /** Every reclaim path in the old protocol existed because a link left by a
        killed builder had to be recognised and removed by somebody else.  Here
        there is nothing to recognise -- the next waiter simply gets the lock, and
        reports that it did not even have to wait for it.

        The holder is killed by its own pid, which its trace gives, and the case continues when the shell that
        started it reports that it has exited: killing by a pattern would also kill the holders of any other run of
        this test, and a kill is only certain once the process is gone.
    */
    testKilledHolderReleasesTheLock() {
        TmpDir tmp("qore-qo-lock-killed-");
        string lock = lockPath(tmp, "l");
        string trace = fifo(tmp, "trace");
        string inside = fifo(tmp, "inside");
        string hold = fifo(tmp, "hold");
        # the command of the holder waits for "hold"
        on_exit release(hold);

        # the shell's report that the holder was killed goes to the output of the shell, not to the test's
        Queue holder = runInBackground(sprintf("{ QORE_QO_LOCK_TRACE=1 %s %s %s /bin/sh -c %s 2> %s; } 2>&1",
            q(qore_bin), q(lock_tool), q(lock),
            q(sprintf("echo held > %s; cat %s > /dev/null", inside, hold)), q(trace)));
        ReadOnlyFile trace_reader(trace);
        *string line = readFifoLine(trace_reader);
        *list<*string> m = (line =~ x/^qore-qo-lock: locked .* pid ([0-9]+)$/);
        assertTrue(exists m[0], sprintf("the holder reports its pid: %y", line));
        int pid = m[0].toInt();
        # Wait for the holder to be inside its critical section before killing it;
        # killing it earlier would prove nothing about a held lock.
        {
            ReadOnlyFile f(inside);
            assertEq("held", readFifoLine(f));
        }
        # SIGKILL: no handler, no cleanup, nothing the process itself can do.
        assertEq(0, kill(pid, SIGKILL), "the holder is killed");
        # its command outlives it, waiting for "hold"; once that ends, the shell that ran the holder returns, after
        # reaping the killed holder
        writeFifoLine(hold, "go");
        hash<auto> h = holder.get();
        assertNeq(0, h.rc, "the holder was killed: " + h.output);

        hash<auto> result = run((lock, "/bin/sh", "-c",
            "printf '%s' \"$QORE_QO_LOCK_WAITED\""));
        assertEq(0, result.rc, "the next builder acquires the lock: " + result.output);
        assertEq("0", result.output,
            "the lock of a killed holder is free, not abandoned-and-reclaimed");
    }

    #! Unlinking a held lock would let two builders into the critical section.
    /** An fcntl lock is a property of the open file description, not of the path.
        A holder that removed the file would leave the next waiter free to create a
        new inode, take an uncontended lock on THAT, and run alongside it.
    */
    testLockFileSurvives() {
        TmpDir tmp("qore-qo-lock-survives-");
        string lock = lockPath(tmp, "l");
        assertFalse(is_file(lock), "the lock file does not exist yet");
        hash<auto> result = run((lock, "/bin/sh", "-c", "true"));
        assertEq(0, result.rc, "the command ran: " + result.output);
        assertTrue(is_file(lock), "the lock file is created and then left in place");
    }

    #! A path with a space in it is one argument, not two.
    /** system() takes a command line rather than an argument vector, so the helper
        quotes what it was given.  The build passes absolute paths through here --
        object directories, context files, the script being re-executed -- and a
        build tree under a directory with a space in its name is otherwise exactly
        the kind of thing that works everywhere it is tested and fails on someone
        else's machine.
    */
    testArgumentsAreNotResplit() {
        TmpDir tmp("qore-qo-lock-args-");
        string awkward = tmp.path + DirSep + "a dir with spaces";
        mkdir(awkward, 0777, True);
        string marker = awkward + DirSep + "written by $USER; echo not-a-command";
        hash<auto> result = run((lockPath(tmp, "l"), "/bin/sh", "-c",
            "touch \"$1\"", "qore-qo-lock-test", marker));
        assertEq(0, result.rc, "the command ran: " + result.output);
        assertTrue(is_file(marker),
            "an argument with spaces, a dollar sign and a semicolon arrives whole");
    }

    testUsage() {
        TmpDir tmp("qore-qo-lock-usage-");
        hash<auto> no_command = run((lockPath(tmp, "l"),));
        assertNeq(0, no_command.rc, "a lock file with no command is refused");
        assertTrue(no_command.output.find("usage:") != -1,
            "the refusal says how to call it: " + no_command.output);
    }
}
