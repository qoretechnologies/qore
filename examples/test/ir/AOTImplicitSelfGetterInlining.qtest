#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-exec-mode: children - its checks run in child processes that set their own execution modes or are qcc executables

%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires ../TestInterpreter.qm
%requires ../ExecModeHarness.qm
%requires FsUtil

# the test's files are in a temporary directory of its own, which is removed also when a check fails, as exit()
# runs no destructors (qore#7817)
TmpDir tmp("qore-aot-implicit-self-getter-");

sub test_exit(int rc) {
    remove_tree(tmp.path);
    exit(rc);
}

#! runs a qcc executable and returns its output (qore#7805)
/** @return the output on stdout followed by the output on stderr, apart from the module loader's
    warnings and the native compilation trace, which are not output of the program (see
    ExecModeHarness::run_command()); the executable runs in its default environment, which only
    traces native compilation
*/
string sub run_executable(string cmd) {
    return ExecModeHarness::run_command(cmd, NOTHING, "QORE_JIT_TIMING=1").out;
}

string qore_bin = TestInterpreter::qore_interpreter();
string libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
string qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
    ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : dirname(qore_bin) + "/qcc");
if (!is_file(qcc_bin)) {
    qcc_bin = "qcc";
}

string root = tmp.path + "/implicit-self-getter";
mkdir(root);
string source_path = root + "/self-getter.qr";
string executable_path = root + "/self-getter";
string source = "%modern

final class Holder {
    private {
        string value;
        string missing;
        int scalar;
        float ratio;
        bool enabled;
        int missing_int;
    }

    constructor(string value) {
        self.value = value;
        scalar = 9223372036854775807;
        ratio = 1.25;
        enabled = True;
    }

    string getValue() {
        return value;
    }

    string read() {
        return getValue();
    }

    string readOther(Holder other) {
        return other.getValue() + \":\" + getValue();
    }

    string getMissing() {
        return missing;
    }

    *string getOptional() {
        return missing;
    }

    int getScalar() {
        return scalar;
    }

    float getRatio() {
        return ratio;
    }

    bool getEnabled() {
        return enabled;
    }

    int getMissingInt() {
        return missing_int;
    }

    string readScalars() {
        return sprintf(\"%d:%.2f:%y\", getScalar(), getRatio(), getEnabled());
    }

    bool missingRejected() {
        try {
            getMissing();
        } catch (hash<auto> ex) {
            return ex.err == \"RUNTIME-TYPE-ERROR\";
        }
        return False;
    }

    bool optionalAbsent() {
        return getOptional() === NOTHING;
    }

    bool missingIntRejected() {
        try {
            getMissingInt();
        } catch (hash<auto> ex) {
            return ex.err == \"RUNTIME-TYPE-ERROR\";
        }
        return False;
    }
}

Holder first(\"first\");
Holder second(\"second\");
printf(\"%s:%s:%s:%y:%y:%y\\n\", first.read(), first.readOther(second),
    first.readScalars(), first.missingRejected(), first.optionalAbsent(),
    first.missingIntRejected());
";

File source_file();
source_file.open2(source_path, O_WRONLY | O_CREAT | O_TRUNC);
source_file.write(source);
source_file.close();

string ast = ExecModeHarness::run_command(sprintf("LD_LIBRARY_PATH=%s %s --exec-mode=ast %s",
    libqore_dir, qore_bin, source_path), NOTHING, "QORE_JIT_TIMING=1").out;
string compile_output = backquote(sprintf(
    "LD_LIBRARY_PATH=%s QORE_AOT_DEBUG=1 %s -O3 -o %s %s 2>&1",
    libqore_dir, qcc_bin, executable_path, source_path));
if (!is_file(executable_path)) {
    printf("AOT compile failed:\n%s", compile_output);
    test_exit(2);
}
if (!(compile_output =~ /inlined implicit-self getter 'value'/)
        || !(compile_output =~ /inlined implicit-self getter 'missing'/)
        || !(compile_output =~ /inlined implicit-self getter 'scalar'/)
        || !(compile_output =~ /inlined implicit-self getter 'ratio'/)
        || !(compile_output =~ /inlined implicit-self getter 'enabled'/)
        || !(compile_output =~ /inlined implicit-self getter 'missing_int'/)) {
    printf("missing inlined implicit-self getter:\n%s", compile_output);
    test_exit(2);
}

string aot = run_executable(sprintf("LD_LIBRARY_PATH=%s %s",
    libqore_dir, executable_path));
if (ast != "first:second:first:9223372036854775807:1.25:True:True:True:True\n"
        || aot != ast) {
    printf("unexpected output\nAST:\n%sAOT:\n%s", ast, aot);
    test_exit(2);
}
