#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - every check runs a script in a child process that sets its own --exec-mode, or AOT
# test-platform: macos - JIT and AOT code generation of the exception paths of map, select and hash map

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../ExecModeHarness.qm

%exec-class NativeReleaseOrderTest

#! issue #5830: the release order of list elements and temporaries when code in map, select or a hash map raises
/** Native code (JIT, AOT) released the elements of a list source, a temporary of the expression of a map, select or
    hash map, and the temporary object of an iterator source in another order than the AST interpreter when the code
    raised an exception: some after the handler.

    The IR interpreter and native code kept the first element of a fold over a fused pipeline until the statement
    ended, where the AST interpreter releases it when the accumulator is replaced, and native code's accumulator of
    a fold over a pipeline with a select stage borrowed the element or the value of an operator, which the next element
    released or replaced (issue #5883).

    The script next to the test runs in every execution mode (its functions compiled before they run, with
    QORE_JIT_SYNC_COMPILE), on the IR tier and as AOT executables, and its output, which shows each release, must be
    that of the AST interpreter.
*/
class NativeReleaseOrderTest inherits QUnit::Test {
    public {
        #! the script
        const Script = "release-order-cases";
    }

    private {
        string qore_bin;
        string qcc_bin;
        string env;
    }

    constructor() : QUnit::Test("native release order", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        string libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
            ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");
        # the functions are compiled to native code before they run, not in the background
        env = sprintf("LD_LIBRARY_PATH=%s QORE_LIBDIR=%s QORE_JIT_SYNC_COMPILE=1", libqore_dir, libqore_dir);

        addTestCase("AST semantics", \astTest());
        addTestCase("execution modes", \modesTest());
        addTestCase("AOT executables", \aotTest());
        set_return_value(main());
    }

    #! checks the output of the AST interpreter
    private astTest() {
        string out = astOutput();
        assertEq(28, (select out.split("\n"), $1 =~ /^[a-z ]+: /).size(), "cases");
        foreach string c in ("map", "select", "map select", "hash map") {
            assertTrue(regex(out,
                sprintf("(^|\n)%s: released h2; released h3; released h1; catch STAGE; after(\n|$)", c)), c);
        }
        foreach string c in ("map temp local", "select temp local", "hash map temp local") {
            assertTrue(regex(out,
                sprintf("\n%s: released t1; released t2; released local; catch DIVISION-BY-ZERO(\n|$)", c)), c);
        }
        assertTrue(out =~ /\nmap statement iterator: v 10; itdone it; released fac; released local; catch DIVISION-/,
            "map statement over an iterator");
        assertTrue(out =~ /\nmap statement try: released n1; released n2; released n3; stmt/, "map statement in a try");
        assertTrue(out =~ /\nmap dtor raises: mk 1; mk 2; dtor 1; dtor 2; catch DTOR; after/,
            "a destructor raises when a value is replaced");
        assertTrue(out =~ /\nmap iterator temp local: released t1; itdone it; released t2; released local; catch /,
            "a temporary of a map over an iterator");
        foreach string c in ("foldl", "foldr") {
            assertTrue(regex(out, sprintf("\n%s raises: released h1; released h2; catch STAGE \\$1 unset; after", c)), c);
        }
        foreach string c in ("hash map iterator", "hash map select iterator") {
            assertTrue(regex(out, sprintf("\n%s: itdone it; catch DIVISION-BY-ZERO; after", c)), c);
        }
        assertTrue(out =~ /\nfoldl pipeline raises: released h1; released h2; catch STAGE \$1 unset; after/,
            "a fold over a pipeline");
        # qore#5883: a fold over a pipeline releases its first element when the accumulator is replaced
        foreach string c in ("foldl pipeline", "foldl pipeline call") {
            assertTrue(regex(out, sprintf("\n%s: released i1; released i2; itdone it; r i3; released i3; after", c)),
                c);
        }
        assertTrue(out =~ /\nfoldl pipeline select: released i2; released i1; itdone it; r i3; released i3; after/,
            "a fold over a pipeline with a select stage");
        # the values of an operator in a map stage or of the fold's expression
        assertTrue(out =~ /\nfoldl pipeline select string: r pa,qa,ya; r xa\n/, "a select stage after an operator");
        assertTrue(out =~ /\nfoldl pipeline select list: released i2; released i3; itdone it; r i1; released i1; after/,
            "a select stage after a list");
        assertTrue(out =~ /\nfoldl pipeline select concat: released i3; itdone it; r i1,i2; released i1; released i2; /,
            "an operator as the fold's expression with a select stage");
        assertTrue(out =~ /\nfoldl pipeline concat: itdone it; r i1,i2,i3; released i1; released i2; released i3; /,
            "an operator as the fold's expression");
        assertTrue(out =~ /\nfoldl pipeline takewhile: released i1; released i3; itdone it; r i2; released i2; after/,
            "a takewhile stage");
        assertTrue(out =~ /\nfoldl pipeline next raises: released i1; itdone it; released i2; catch NEXT \$1 unset; /,
            "a fold over a pipeline whose iterator's next() raises");
        assertTrue(out =~ /\nfoldl nested raises: released x; released h1; released h2; released h3; catch STAGE /,
            "nested folds");
        assertTrue(out =~ /\nfoldl next raises: released i1; itdone it; released i2; catch NEXT \$1 unset; after/,
            "a fold whose iterator's next() raises");
        assertTrue(out =~ /\nmap fold no handler: released m1; catch STAGE; after/,
            "a fold in a map in a function with no handler");
    }

    #! runs the script in every execution mode and on the IR tier
    private modesTest() {
        string exp = astOutput();
        foreach string mode in (ExecModeHarness::ExecModes) {
            if (mode == "ast") {
                continue;
            }
            assertEq(exp, ExecModeHarness::run(sprintf("%s %s --exec-mode=%s %s", env, qore_bin, mode, scriptPath())),
                mode);
        }
        assertEq(exp, ExecModeHarness::run_ir_tier(sprintf("%s %s --exec-mode=tiered %s", env, qore_bin,
            scriptPath())), ExecModeHarness::IRTierName);
    }

    #! compiles the script with qcc -O0 and -O3 and checks that the executables give the output of the AST
    #! interpreter
    private aotTest() {
        if (!is_file(qcc_bin)) {
            testSkip("qcc is not available at " + qcc_bin);
        }
        string exp = astOutput();
        TmpDir dir("native-release-order-aot-");
        foreach string opt in ("-O0", "-O3") {
            string exe = sprintf("%s/%s%s", dir.path, Script, opt);
            string out = ExecModeHarness::run_any(sprintf("%s %s %s -o %s %s", env, qcc_bin, opt, exe, scriptPath()));
            assertTrue(is_file(exe), sprintf("%s: qcc compiles the script: %s", opt, out));
            assertEq(exp, ExecModeHarness::run_any(sprintf("%s %s", env, exe)), "AOT " + opt);
        }
    }

    private string scriptPath() {
        return get_script_dir() + "/" + Script + ".q";
    }

    #! the output of the script with the AST interpreter
    private string astOutput() {
        return ExecModeHarness::run(sprintf("%s %s --exec-mode=ast %s", env, qore_bin, scriptPath()));
    }
}
