#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

# Copyright (C) 2026 Qore Technologies, s.r.o.
#
# Fixture for IRFusedIntLocalOwnership.qtest: fused local int updates (++x, x += n) on boxed int
# locals whose values cross the 48-bit immediate range in both directions, so compiled code
# must hand each heap-boxed result to the local's owner and release the value it replaces.
#
# Without arguments it prints the computed values.  With "live" it repeats each update pattern
# and prints how many heap ints a promoted call left behind, as counted by the library
# (dbg_get_live_bigint_count(), which needs library debugging): every large int is a separate heap
# node, and a leak-free call leaves none.  The count does not depend on the page size, the
# allocator or the kernel's huge page policy, or on what other threads allocate meanwhile, which
# all change the resident set size of the process with no leak.

const Big = 1 << 50;
const Edge = (1 << 47) - 2;

list<auto> sub bodyOptional() {
    list<auto> rv;
    *int x = Edge;
    for (int i = 0; i < 4; ++i) {
        x += 1;
        ++x;
        rv += x;
    }
    for (int i = 0; i < 4; ++i) {
        x -= 3;
        --x;
        rv += x;
    }
    return rv;
}

list<auto> sub bodySoft() {
    list<auto> rv;
    softint y = Big;
    for (int i = 0; i < 3; ++i) {
        y += 1;
        y++;
        rv += y;
    }
    return rv;
}

list<auto> sub bodyAuto() {
    list<auto> rv;
    auto z = Big;
    for (int i = 0; i < 3; ++i) {
        z += 2;
        ++z;
        rv += z;
    }
    return rv;
}

*int sub parameter(*int x) {
    for (int i = 0; i < 3; ++i) {
        x += 1;
        ++x;
    }
    return x;
}

# JIT-to-JIT calls can bind the parameter through a direct fast entry
int sub directCaller() {
    int sum = 0;
    for (int i = 0; i < 3; ++i) {
        sum += parameter(Big + i) - Big;
    }
    return sum;
}

sub touch(reference<*int> r) {
    r = r + 0;
}

# taking a reference keeps the local on the runtime stack
*int sub runtimeStack() {
    *int x = Big;
    for (int i = 0; i < 3; ++i) {
        x += 1;
        ++x;
    }
    touch(\x);
    return x;
}

*int sub closureCaptured() {
    *int x = Big;
    code c = *int sub () { return x; };
    for (int i = 0; i < 3; ++i) {
        x += 1;
        ++x;
    }
    return c();
}

#! the iterations of each pattern
/** The heap values are counted exactly, so that a pattern that leaves one value behind in each iteration leaves a
    thousand behind, and the count shows each of them; the iterations repeat each pattern's variants (the indexes and
    branches that depend on the iteration) many times.  The test runs this script with ExecModeHarness, whose
    synchronous compiles (QORE_JIT_SYNC_COMPILE) compile each function at its first call, so that the measured call
    runs native code with JIT and tiered execution whatever the count; run without it, the compile in the
    background can end after the measured call.  The count of 200000 was that of the resident memory checks,
    which a leak had to grow by megabytes, and made the leak checks run long in a debug build.
*/
const LeakIterations = 1000;

*int sub leakBody() {
    *int x = Big;
    for (int i = 0; i < LeakIterations; ++i) {
        x += 1;
        ++x;
    }
    return x;
}

*int sub leakParameter(*int x) {
    for (int i = 0; i < LeakIterations; ++i) {
        x += 1;
        ++x;
    }
    return x;
}

int sub leakDirect() {
    return leakParameter(Big) - Big;
}

*int sub leakRuntimeStack() {
    *int x = Big;
    for (int i = 0; i < LeakIterations; ++i) {
        ++x;
        touch(\x);
    }
    return x;
}

*int sub leakClosureCaptured() {
    *int x = Big;
    code c = *int sub () { return x; };
    for (int i = 0; i < LeakIterations; ++i) {
        x += 1;
        ++x;
    }
    return c();
}

if (ARGV[0] == "live") {
    hash<string, code> cases = {
        "body": \leakBody(),
        "direct": \leakDirect(),
        "runtime-stack": \leakRuntimeStack(),
        "closure": \leakClosureCaptured(),
    };
    foreach hash<auto> c in (cases.pairIterator()) {
        code f = c.value;
        # the first call promotes and compiles the function; measure a later call
        f();
        int before = call_function("dbg_get_live_bigint_count");
        f();
        printf("%s: %d\n", c.key, call_function("dbg_get_live_bigint_count") - before);
    }
    return;
}

for (int i = 0; i < 3; ++i) {
    printf("optional[%d]: %y\n", i, bodyOptional());
    printf("soft[%d]: %y\n", i, bodySoft());
    printf("auto[%d]: %y\n", i, bodyAuto());
    printf("parameter[%d]: %y %y\n", i, parameter(Big), parameter(Edge));
    printf("direct[%d]: %d\n", i, directCaller());
    printf("runtime-stack[%d]: %y\n", i, runtimeStack());
    printf("closure[%d]: %y\n", i, closureCaptured());
}
