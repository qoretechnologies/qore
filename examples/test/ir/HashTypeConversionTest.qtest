#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%enable-all-warnings

# Test for hash type conversion in IR CallMethod fallback
# This tests that when a function parameter is declared as hash<string, hash<TypeName>>
# and the hash is accessed via the IR fallback code path, the hash type is properly
# converted from hashdecl-typed to complex hash type

hashdecl ExprInfo {
    string name;
    string value;
    string op;
}

# Function that takes a complex hash parameter
sub processExpressions(hash<string, hash<ExprInfo>> expressions) {
    # This should work correctly - expressions is a complex hash
    foreach string key in (expressions.keys()) {
        # Access a member of the hashdecl-typed value
        my string op = expressions{key}.op;
        # printf("Processed key: %s with op: %s\n", key, op);
    }
}

# Main test
my hash<string, hash<ExprInfo>> test_data = (
    "a": <ExprInfo>{
        "name": "expr_a",
        "value": "val_a",
        "op": "op_a"
    },
    "b": <ExprInfo>{
        "name": "expr_b",
        "value": "val_b",
        "op": "op_b"
    }
);

# Call function - this should work without INVALID-MEMBER error
# The IR CallMethod fallback path should properly handle the hash type
processExpressions(test_data);
