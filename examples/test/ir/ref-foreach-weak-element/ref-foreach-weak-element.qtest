#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-exec-mode: children - its checks run in children that set their own execution modes and in qcc executables
# test-platform: macos - the weak references of foreach loops in JIT code and the native code of qcc executables
# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../ExecModeHarness.qm
%requires ../../TestInterpreter.qm

%exec-class RefForeachWeakElementTest

#! A foreach over a list by reference keeps an element that is a weak reference weak in every mode
/** The AST interpreter assigns the loop variable each element as it is and writes the variable back to the element, so
    that an element that is a weak reference stays one: the variable does not keep the object alive while the body
    runs, and the element holds no strong reference afterwards (qore#6633).  The loops of loops.q, with a typed and an
    untyped variable, an object that outlives the loop, a variable assigned another object, and several weak and strong
    elements with a break, log where their objects are released; the output is compared with the AST in the ir, jit
    and tiered modes, on the IR tier of the tiered mode, and in executables made by qcc at -O0 and -O3.
*/
class RefForeachWeakElementTest inherits QUnit::Test {
    public {
        #! the execution modes compared with the AST
        const Modes = ("ir", "jit", "tiered");

        #! the qcc optimization levels
        const OptLevels = ("-O0", "-O3");

        #! the environment of a run in which every function is compiled at its first call
        const CompileEnv = "QORE_JIT_SYNC_COMPILE=1 QORE_IR_THRESHOLD=1 QORE_JIT_THRESHOLD=1";
    }

    private {
        string qore_bin;
        string qcc_bin;
        #! the library path of the qcc compiles and of the executables
        string lib_env;
    }

    constructor() : QUnit::Test("RefForeachWeakElementTest", "1.0", \ARGV) {
        qore_bin = TestInterpreter::qore_interpreter();
        string libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = TestInterpreter::qcc_compiler() ?? "qcc";
        lib_env = sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s", libqore_dir, libqore_dir);
        addTestCase("a foreach over a list by reference keeps its weak elements weak", \loopTest());
        set_return_value(main());
    }

    #! Returns the output of the script \a path in \a mode
    private string runMode(string path, string mode) {
        hash<ExecModeHarness::ModeRunResult> r = ExecModeHarness::run_command(sprintf("%s %s %s -b --enable-debug "
            "--exec-mode=%s %s", lib_env, CompileEnv, qore_bin, mode, path));
        assertEq(0, r.rc, sprintf("%s: exit status (output: %y)", mode, r.out));
        return r.stdout;
    }

    loopTest() {
        TmpDir dir("qore-ref-foreach-weak-element-");
        string src = join_paths(dir.path, "loops.q");
        copy_file(get_script_dir() + "/loops.q", src);
        string expected = runMode(src, "ast");
        # the object is destroyed in the body, and the element holds no object afterwards
        assertRegex("(?m)^noCall: ~a\\|s\\|after:False$", expected, "the AST keeps the element weak");
        assertRegex("(?m)^call: \\|ca~a\\|s\\|after:False$", expected, "the AST keeps the element weak");
        foreach string mode in (Modes) {
            assertEq(expected, runMode(src, mode), mode);
        }
        assertEq(expected, ExecModeHarness::run_ir_tier(sprintf("%s %s -b --enable-debug --exec-mode=tiered %s",
            lib_env, qore_bin, src)), "IR tier");
        foreach string opt in (OptLevels) {
            string exe = join_paths(dir.path, "loops" + opt);
            int rc;
            string output = backquote(sprintf("%s %s %s -o %s %s 2>&1", lib_env, qcc_bin, opt, exe, src), \rc);
            assertEq(0, rc, sprintf("qcc %s: exit status (output: %s)", opt, output.substr(-2000)));
            # -b must be the first argument of a compiled program
            string out = backquote(sprintf("%s %s -b", lib_env, exe), \rc);
            assertEq(0, rc, sprintf("qcc %s executable: exit status (output: %y)", opt, out));
            assertEq(expected, out, "qcc " + opt);
        }
    }
}
