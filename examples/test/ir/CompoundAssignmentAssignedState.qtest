#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
string libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
string qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
    ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : dirname(qore_bin) + "/qcc");
if (!is_file(qcc_bin)) {
    qcc_bin = "qcc";
}

string sub scriptCode() {
    return "%modern

bool sub choose() {
    return False;
}

int sub knownAssignedPlusEquals() {
    int total = 0;
    for (int i = 0; i < 5; i++) {
        total += i;
    }
    return total;
}

int sub unassignedPlusEquals() {
    int total;
    total += 7;
    return total;
}

int sub removedPlusEquals() {
    int total = 1;
    remove total;
    total += 9;
    return total;
}

int sub conditionalPlusEquals() {
    int total;
    if (choose()) {
        total = 10;
    }
    total += 4;
    return total;
}

int sub knownAssignedMinusEquals() {
    int total = 10;
    for (int i = 0; i < 5; i++) {
        total -= i;
    }
    return total;
}

int sub unassignedMinusEquals() {
    int total;
    total -= 7;
    return total;
}

int sub removedMinusEquals() {
    int total = 1;
    remove total;
    total -= 9;
    return total;
}

int sub conditionalMinusEquals() {
    int total;
    if (choose()) {
        total = 10;
    }
    total -= 4;
    return total;
}

string sub hashAutoInitialPlusEquals() {
    hash<string, int> typed = {\"a\": 1};
    hash<auto> h;
    h += typed;
    return h.fullType() + \":\" + string(h.a);
}

string sub optionalHashAutoInitialPlusEquals() {
    hash<string, int> typed = {\"a\": 1};
    *hash<auto> h;
    h += typed;
    return h.fullType() + \":\" + string(h.a);
}

string sub listAutoInitialPlusEquals() {
    list<int> typed = (1, 2);
    list<auto> l;
    l += typed;
    return l.fullType() + \":\" + string(l[0]) + \":\" + string(l[1]);
}

string sub optionalListAutoInitialPlusEquals() {
    list<int> typed = (1, 2);
    *list<auto> l;
    l += typed;
    return l.fullType() + \":\" + string(l[0]) + \":\" + string(l[1]);
}

int sub nativeIntOpsInTry() {
    int value = 3;
    try {
        value -= 1;
        value *= 2;
        value &= 7;
        value |= 8;
        value ^= 3;
        value <<= 1;
        value >>= 1;
    } catch (hash<ExceptionInfo> ex) {
        return -1;
    }
    return value;
}

float sub nativeFloatOpsInTry() {
    float value = 3.0;
    try {
        value += 1.5;
        value -= 0.5;
        value *= 2.0;
    } catch (hash<ExceptionInfo> ex) {
        return -1.0;
    }
    return value;
}

int sub divisionStillThrows() {
    int zero = 0;
    try {
        return 1 / zero;
    } catch (hash<ExceptionInfo> ex) {
        return 9;
    }
}

printf(\"%d:%d:%d:%d:%d:%d:%d:%d:%s:%s:%s:%s:%d:%g:%d\\n\",
    knownAssignedPlusEquals(), unassignedPlusEquals(), removedPlusEquals(),
    conditionalPlusEquals(), knownAssignedMinusEquals(), unassignedMinusEquals(),
    removedMinusEquals(), conditionalMinusEquals(), hashAutoInitialPlusEquals(),
    optionalHashAutoInitialPlusEquals(), listAutoInitialPlusEquals(),
    optionalListAutoInitialPlusEquals(), nativeIntOpsInTry(),
    nativeFloatOpsInTry(), divisionStillThrows());
";
}

string sub runMode(string script_path, string mode) {
    return backquote(sprintf("LD_LIBRARY_PATH=%s %s -b --exec-mode=%s %s 2>&1",
        libqore_dir, qore_bin, mode, script_path));
}

string sub runAot(string script_path) {
    string exe = "/tmp/qore-compound-assignment-assigned-state-" + string(getpid());
    string compile_out = backquote(sprintf("LD_LIBRARY_PATH=%s %s -o %s %s 2>&1",
        libqore_dir, qcc_bin, exe, script_path));
    if (!is_file(exe)) {
        printf("AOT compile failed:\n%s", compile_out);
        exit(2);
    }
    return backquote(sprintf("LD_LIBRARY_PATH=%s %s 2>&1", libqore_dir, exe));
}

sub checkOutput(string label, string expected, string actual) {
    if (actual != expected) {
        printf("mismatch in %s\nexpected:\n%sactual:\n%s", label, expected, actual);
        exit(2);
    }
}

string script_path = "/tmp/qore-compound-assignment-assigned-state-" + string(getpid()) + ".qr";
File script();
script.open2(script_path, O_WRONLY | O_CREAT | O_TRUNC);
script.write(scriptCode());
script.close();

string ast = runMode(script_path, "ast");
checkOutput("ast", "10:7:9:4:0:-7:-9:-4:hash<auto>:1:hash<auto>:1:list<auto>:1:2:list<auto>:1:2:15:8.0:9\n", ast);

foreach string mode in (("ir", "tiered", "jit")) {
    checkOutput(mode, ast, runMode(script_path, mode));
}
checkOutput("aot", ast, runAot(script_path));
