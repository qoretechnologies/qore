#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit

%include loop-jump-temp-scope-checks.qi

%exec-class LoopJumpTempScopeTest

#! Regression test for a break or continue that leaves one or more open statement temp scopes.
/** The IR interpreter used to leave each left scope's PushTempMark sentinel on its runtime cleanup vector every
    time the jump executed, so the vector grew by one or more per loop iteration and every later cleanup scan got
    slower - an unbounded slowdown in a long-running loop (quadratic in the number of jumps).  A temporary held
    across the jump (a switch value) was also kept alive until the frame exited instead of being released when the
    jump left its scope.

    The checks in loop-jump-temp-scope-checks.qi run in this program and in a worker in each execution mode.
    dbg_get_ir_cleanup_entries() reports the IR cleanup vector size (0 outside the IR interpreter), so the growth
    checks read as "no growth" in ast and native code too.
*/
class LoopJumpTempScopeTest inherits QUnit::Test {
    public {
        #! the execution modes the worker is run in
        const ExecModes = ("ast", "ir", "jit", "tiered");
    }

    private {
        string qore_bin;
        string libqore_dir;
    }

    constructor() : QUnit::Test("LoopJumpTempScopeTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);

        addTestCase("cleanup vector does not grow in this program", \testGrowthInProgram());
        addTestCase("cleanup vector does not grow in each mode", \testGrowthExecModes());
        addTestCase("no temp held past the frame in this program", \testNoLeakInProgram());
        addTestCase("no temp held past the frame in each mode", \testNoLeakExecModes());

        set_return_value(main());
    }

    #! the growth checks read the IR cleanup-vector size, which only a library-debug build exposes
    /** dbg_get_ir_cleanup_entries() is registered only when the library is built with debugging (as the Linux CI
        builds are, covering every execution mode on glibc and musl); a non-debug build such as the macOS CI build
        does not have it, so these cases skip there - the no-leak cases below still run and cover that build.
    */
    private checkGrowthAvailable() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("the IR cleanup-vector size (dbg_get_ir_cleanup_entries()) is only in library-debug builds");
        }
    }

    #! the cleanup vector must not grow across the loop, in whatever mode this test program itself runs
    testGrowthInProgram() {
        checkGrowthAvailable();
        hash<string, int> results = ljts_growth_results();
        assertEq(0, results."if-continue-growth", "in-program: if-continue growth");
        assertEq(0, results."switch-continue-growth", "in-program: switch-continue growth");
        assertEq(0, results."break-growth", "in-program: break growth");
    }

    #! the cleanup vector must not grow in any execution mode
    testGrowthExecModes() {
        checkGrowthAvailable();
        foreach string mode in (ExecModes) {
            hash<string, int> results = runWorker(mode);
            assertEq(0, results."if-continue-growth", mode + ": if-continue growth");
            assertEq(0, results."switch-continue-growth", mode + ": switch-continue growth");
            assertEq(0, results."break-growth", mode + ": break growth");
            if (mode == "ir") {
                # the switch value's temp scope is on the vector of the frame that runs the switch, so the growth
                # checks read the vector of the frame that runs the loop they measure
                assertGt(0, results."switch-scope-recorded", "ir: the switch's temp scope is on the frame's vector");
            }
        }
    }

    #! a temp held across the jump is released when the jump leaves its scope, not kept past the frame (every build)
    testNoLeakInProgram() {
        # in the IR interpreter and AST nothing lingers right after the loop (native code may hold the last one
        # until the next overwrite)
        assertTrue(ljts_switch_continue_pending() <= 1, "in-program: pending bounded");
        # ljts_switch_continue_pending ran in its own frame above; nothing it created is still alive now
        assertEq(ljts_created, ljts_destroyed, "in-program: no permanent leak");
    }

    #! no execution mode keeps a temp alive past the frame that ran the loop
    testNoLeakExecModes() {
        foreach string mode in (ExecModes) {
            hash<string, int> results = runWorker(mode);
            # native code may hold the last switch value in its slot until the next overwrite, so allow one here;
            # the permanent check is what holds in every mode
            assertTrue(results."switch-continue-pending" <= 1, mode + ": switch-continue pending bounded");
            assertEq(0, results."permanent-leak", mode + ": no permanent leak");
        }
    }

    #! runs the worker in the given mode and parses its "name=value" output
    private hash<string, int> runWorker(string mode) {
        string worker = get_script_dir() + DirSep + "loop-jump-temp-scope-worker.q";
        string cmd = sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s %s -b --exec-mode=%s %s 2>&1",
            libqore_dir, libqore_dir, qore_bin, mode, worker);
        string out = backquote(cmd);
        hash<string, int> results = {};
        foreach string line in (out.split("\n")) {
            *list<*string> parts = (line =~ x/^([-a-z]+)=(-?[0-9]+)$/);
            if (!parts) {
                if (line.val()) {
                    fail(sprintf("%s: unexpected worker output: %y", mode, out));
                }
                continue;
            }
            results{parts[0]} = parts[1].toInt();
        }
        assertTrue(results.hasKey("permanent-leak"), mode + ": worker produced results (" + out + ")");
        return results;
    }
}
