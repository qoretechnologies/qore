#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - JIT and AOT code generation of the exception paths that release catch variables
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - every check runs the script in a child process that sets its own --exec-mode, or AOT

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires ../../TestInterpreter.qm
%requires FsUtil
%requires ../../ExecModeHarness.qm

%exec-class CatchVariableReleaseOrderTest

#! issue #6472: the variable of a catch block that raises is released before the enclosing handlers run
/** A catch block without an exit block whose statement raises is left at the exception path of the enclosing block,
    where its catch variable is released before the block's handlers run (#5968).  When the catch block was in the
    body of a foreach over a reference, of a fused foreach, of a foreach over a list that can hold objects or of a
    context statement, the exception went to the statement's own exception block first, so the catch variable was
    released only after the handlers of the enclosing blocks (or an outer catch block) had run, in ir, jit, tiered and
    AOT executables.  Every exception block of a statement that runs code before the exception goes on is now an
    anchor that leaves such catch blocks first.

    catch-variable-release-order.q prints the values; the AST interpreter's output must be the expected one,
    and every other execution mode, the IR tier and AOT executables compiled with -O0 and -O3 must give the same.
*/
class CatchVariableReleaseOrderTest inherits QUnit::Test {
    public {
        #! the output of the script
        const Expected = (
            "D ref destroyed",
            "ref foreach: function on_error",
            "caller: B",
            "D fused destroyed",
            "fused foreach: function on_error",
            "caller: B",
            "D object destroyed",
            "D element 2 destroyed",
            "D element destroyed",
            "object foreach: function on_error",
            "caller: B",
            "D scalar destroyed",
            "scalar foreach: function on_error",
            "caller: B",
            "D context destroyed",
            "context: function on_error",
            "caller: B",
            "D nested destroyed",
            "outer catch: B",
            "D block destroyed",
            "block handler: block on_error",
            "caller: B",
            "normal: caught 1",
            "D normal 1 destroyed",
            "normal: caught 2",
            "D normal 2 destroyed",
            "normal: done",
            "rethrow: function on_error",
            "caller: A",
            "D rethrow destroyed",
            "D if destroyed",
            "if locals: function on_error",
            "caller: B",
            "D handler ref destroyed",
            "handler at return ref: function on_error",
            "caller: B",
            "D handler fused destroyed",
            "handler at return fused: function on_error",
            "caller: B",
            "D handler context destroyed",
            "handler at return context: function on_error",
            "caller: B",
            "D inner destroyed",
            "D outer destroyed",
            "outer catch open: function on_error",
            "caller: B",
        );
    }

    private {
        string qore_bin;
        string qcc_bin;
        string env;
        string script;
    }

    constructor() : QUnit::Test("catch variable release order", "1.0", \ARGV) {
        qore_bin = TestInterpreter::qore_interpreter();
        string libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
            ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");
        env = sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s QORE_LIBDIR=%s", libqore_dir, libqore_dir, libqore_dir);
        script = get_script_dir() + "/catch-variable-release-order.q";

        addTestCase("AST interpreter", \astTest());
        addTestCase("execution modes", \modesTest());
        addTestCase("AOT executable -O0", \aotTest(), "-O0");
        addTestCase("AOT executable -O3", \aotTest(), "-O3");
        set_return_value(main());
    }

    #! checks the output of the AST interpreter, which the other modes must give
    private astTest() {
        list<string> lines = select ast().split("\n"), $1;
        assertEq(Expected, lines);
    }

    #! runs the script in every execution mode and on the IR tier
    private modesTest() {
        string exp = ast();
        foreach string mode in (ExecModeHarness::ExecModes) {
            if (mode == "ast") {
                continue;
            }
            assertEq(exp, ExecModeHarness::run(sprintf("%s %s --exec-mode=%s %s", env, qore_bin, mode, script)), mode);
        }
        assertEq(exp, ExecModeHarness::run_ir_tier(sprintf("%s %s --exec-mode=tiered %s", env, qore_bin, script)),
            ExecModeHarness::IRTierName);
    }

    #! compiles the script with qcc and checks that the executable gives the output of the AST interpreter
    private aotTest(string opt) {
        if (!is_file(qcc_bin)) {
            testSkip("qcc is not available at " + qcc_bin);
        }
        TmpDir dir("catch-variable-release-order-aot-");
        string exe = dir.path + "/catch-variable-release-order";
        string out = ExecModeHarness::run_any(sprintf("%s %s %s -o %s %s", env, qcc_bin, opt, exe, script));
        assertTrue(is_file(exe), "qcc " + opt + " compiles the script: " + out);
        assertEq(ast(), ExecModeHarness::run_any(sprintf("%s %s", env, exe)), "AOT " + opt);
    }

    #! returns the output of the script with the AST interpreter
    private string ast() {
        return ExecModeHarness::run(sprintf("%s %s --exec-mode=ast %s", env, qore_bin, script));
    }
}
