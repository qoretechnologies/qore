#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
string libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
string qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
    ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : dirname(qore_bin) + "/qcc");
if (!is_file(qcc_bin)) {
    qcc_bin = "qcc";
}

string provider_source = "%modern

*string sub exactString(bool alternate) {
    return alternate ? \"Dvo\\u0159\\u00e1k\" : \"abcdef\";
}

*string sub maybeString(bool assign) {
    string value;
    if (assign) {
        value = \"assigned\";
    }
    return value;
}

*string sub removedString(bool restore) {
    string value = \"removed\";
    remove value;
    if (restore) {
        value = \"restored\";
    }
    return value;
}
";

string consumer_source = "%modern

string sub exactStringOps(bool alternate) {
    return sprintf(\"%d:%d:%y:%y:%d:%s\",
        exactString(alternate).size(), exactString(alternate).length(),
        exactString(alternate).startsWith(\"D\"),
        exactString(alternate).contains(\"o\"),
        exactString(alternate).find(\"a\"),
        exactString(alternate).substr(1, 3));
}

int sub stringKernel(int rounds) {
    int result = 0;
    for (int i = 0; i < rounds; ++i) {
        result += exactString(i % 2 == 1).size();
        result += exactString(i % 2 == 1).length();
    }
    return result;
}

string sub maybeStringOps(bool assign) {
    return sprintf(\"%d:%d\", maybeString(assign).length(),
        removedString(assign).length());
}

int sub main() {
    *string rounds_arg = ENV.QORE_EXACT_BOXED_ROUNDS;
    int rounds = rounds_arg ? rounds_arg.toInt() : 1000;
    printf(\"%s\\n%s\\n%s\\n%d\\n\", exactStringOps(False),
        exactStringOps(True), maybeStringOps(True), stringKernel(rounds));
    return 0;
}
";

string root = "/tmp/qore-aot-exact-boxed-return-" + string(getpid());
string provider_dir = root + "/provider";
string enabled_dir = root + "/enabled";
string disabled_dir = root + "/disabled";
mkdir(root);
mkdir(provider_dir);
mkdir(enabled_dir);
mkdir(disabled_dir);

string provider_path = root + "/provider.qr";
string consumer_path = root + "/consumer.qr";
string combined_path = root + "/combined.qr";
File provider_file();
provider_file.open2(provider_path, O_WRONLY | O_CREAT | O_TRUNC);
provider_file.write(provider_source);
provider_file.close();
File consumer_file();
consumer_file.open2(consumer_path, O_WRONLY | O_CREAT | O_TRUNC);
consumer_file.write(consumer_source);
consumer_file.close();
File combined_file();
combined_file.open2(combined_path, O_WRONLY | O_CREAT | O_TRUNC);
combined_file.write(provider_source + consumer_source + "\nmain();\n");
combined_file.close();

string expected = "6:6:False:False:0:bcd\n"
    + "8:6:True:True:-1:vo\u0159\n"
    + "8:8\n13000\n";
foreach string mode in (("ast", "ir", "tiered", "jit")) {
    string actual = backquote(sprintf(
        "LD_LIBRARY_PATH=%s %s -b --exec-mode=%s %s 2>&1",
        libqore_dir, qore_bin, mode, combined_path));
    if (actual != expected) {
        printf("%s mismatch:\nexpected:\n%sactual:\n%s", mode, expected, actual);
        exit(2);
    }
}

string provider_compile = backquote(sprintf(
    "LD_LIBRARY_PATH=%s %s -O3 -c --strip-source --output-dir=%s %s 2>&1",
    libqore_dir, qcc_bin, provider_dir, provider_path));
string provider_qo = provider_dir + "/provider.qo";
if (!is_file(provider_qo)) {
    printf("provider compile failed:\n%s", provider_compile);
    exit(2);
}
string provider_index = backquote(sprintf(
    "LD_LIBRARY_PATH=%s %s --dump-index-json %s 2>&1",
    libqore_dir, qcc_bin, provider_qo));
if (!(provider_index =~ /\"qore_path\": \"exactString\(bool\)\"[^\n]*\"abi_kind\": \"qore_fast_v1\"[^\n]*\"boxed_return_kind\": 1/)
        || !(provider_index =~ /\"qore_path\": \"maybeString\(bool\)\"[^\n]*\"abi_kind\": \"qore_fast_v1\"[^\n]*\"boxed_return_kind\": 0/)
        || provider_index =~ /\"qore_path\": \"removedString\(bool\)\"[^\n]*\"abi_kind\": \"qore_fast_v1\"[^\n]*\"boxed_return_kind\": [1-9]/) {
    printf("unexpected exact boxed-return metadata:\n%s", provider_index);
    exit(2);
}
unlink(provider_path);

string sub compileConsumer(string output_dir, string env) {
    string output = backquote(sprintf(
        "%s LD_LIBRARY_PATH=%s QORE_IR_OPT_STATS=1 %s -O3 -c -L %s --output-dir=%s %s 2>&1",
        env, libqore_dir, qcc_bin, provider_dir, output_dir, consumer_path));
    if (!is_file(output_dir + "/consumer.qo")) {
        printf("consumer compile failed:\n%s", output);
        exit(2);
    }
    return output;
}

string enabled_compile = compileConsumer(enabled_dir, "");
string disabled_compile = compileConsumer(disabled_dir,
    "QORE_DISABLE_AOT_EXACT_BOXED_RETURN_FACTS=1");
if (!(enabled_compile =~ /IR-OPT-AOT-EFFECTS: exactStringOps[^:]*:.*exact-boxed-call-facts=6.*boxed-specializations=6/)
        || !(enabled_compile =~ /IR-OPT-AOT-EFFECTS: stringKernel[^:]*:.*exact-boxed-call-facts=2.*boxed-specializations=2/)
        || enabled_compile =~ /IR-OPT-AOT-EFFECTS: maybeStringOps[^:]*:.*exact-boxed-call-facts=[1-9]/
        || disabled_compile =~ /exact-boxed-call-facts=[1-9]/
        || disabled_compile =~ /boxed-specializations=[1-9]/) {
    printf("unexpected exact boxed-return specialization stats:\nprovider:\n%senabled:\n%sdisabled:\n%s",
        provider_compile, enabled_compile, disabled_compile);
    exit(2);
}

string sub link(string output, string consumer_qo) {
    string link_out = backquote(sprintf(
        "LD_LIBRARY_PATH=%s %s -O3 -o %s %s %s 2>&1",
        libqore_dir, qcc_bin, output, provider_qo, consumer_qo));
    if (!is_file(output)) {
        printf("link failed:\n%s", link_out);
        exit(2);
    }
    return output;
}

foreach string path in ((link(root + "/enabled-exe", enabled_dir + "/consumer.qo"),
        link(root + "/disabled-exe", disabled_dir + "/consumer.qo"))) {
    string actual = backquote(sprintf("LD_LIBRARY_PATH=%s %s 2>&1",
        libqore_dir, path));
    if (actual != expected) {
        printf("AOT mismatch for %s:\nexpected:\n%sactual:\n%s",
            path, expected, actual);
        exit(2);
    }
}

exit(0);
