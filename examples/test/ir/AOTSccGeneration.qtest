#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
#
# Copyright (C) 2003 - 2026 Qore Technologies, s.r.o.
#
# Verifies the strongly-connected-component decomposition and the generation
# identity that qore-qo-source-order publishes for incremental AOT builds.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil
%requires Util
%requires json

%exec-class AOTSccGenerationTest

class AOTSccGenerationTest inherits QUnit::Test {
    private {
        string qore_bin;
        string source_order_tool;
    }

    constructor() : QUnit::Test("AOTSccGenerationTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        source_order_tool = normalize_dir(get_script_dir() + "/../../../tools")
            + DirSep + "qore-qo-source-order";

        addTestCase("required cycles condense into one component",
            \testMutualDependencyComponent());
        addTestCase("acyclic graphs decompose into singleton components",
            \testAcyclicGraphSingletons());
        addTestCase("generation tokens combine member sources with predecessor contracts",
            \testGenerationIdentity());
        addTestCase("source-only stale planning delegates external dependencies to CMake",
            \testSourceStalePlanning());
        addTestCase("a stale plan reports how much of the group a rebuild reaches",
            \testRebuildClosurePlanning());
        addTestCase("a component larger than the old retry limit stays one unit",
            \testLargeComponent());
        addTestCase("component selectors reject unknown arguments",
            \testSelectorErrors());
        addTestCase("degenerate object groups decompose without error",
            \testDegenerateGroups());
        addTestCase("CMake dependency plan is atomic and content-stable",
            \testCMakePlan());
        addTestCase("generation tokens follow the declaration contract",
            \testGenerationFollowsDeclarationContract());
        addTestCase("a baked body contract is watched by the consumer that baked it",
            \testBakedBodyContractIsWatched());
        addTestCase("a regex literal does not hide the namespace of what follows it",
            \testRegexLiteralNamespaceTracking());

        set_return_value(main());
    }

    #! Runs the helper and asserts that it succeeded.
    private string order(string context_path, softlist<string> args) {
        hash<auto> result = runOrder(context_path, args);
        assertEq(0, result.rc, sprintf("qore-qo-source-order %y failed: %s",
            args, result.output));
        return result.output;
    }

    #! Runs the helper with \a args, inserting the context as its first positional.
    private hash<auto> runOrder(string context_path, softlist<string> args) {
        list<string> command = (sprintf("%y", qore_bin), sprintf("%y", source_order_tool));
        list<string> positional = ();
        foreach string arg in (args) {
            if (arg.startsWith("--")) {
                push command, sprintf("%y", arg);
            } else {
                push positional, sprintf("%y", arg);
            }
        }
        push command, sprintf("%y", context_path);
        command += positional;
        string output = backquote("{ " + join(" ", command) + "; } 2>&1; echo \"rc=$?\"");
        int marker = output.rfind("rc=");
        return (
            "output": output.substr(0, marker),
            "rc": output.substr(marker + 3).toInt(),
        );
    }

    private string cmakePlan(string context_path, string group) {
        string command = sprintf("%y %y --cmake-plan %y %y",
            qore_bin, source_order_tool, group, context_path);
        string output = backquote("{ " + command + "; } 2>&1; echo \"rc=$?\"");
        int marker = output.rfind("rc=");
        assertEq(0, output.substr(marker + 3).toInt(),
            "--cmake-plan succeeds: " + output.substr(0, marker));
        return dirname(context_path);
    }

    private write(string path, string body) {
        File f();
        f.open2(path, O_WRONLY | O_CREAT | O_TRUNC);
        f.write(body);
        f.close();
    }

    #! Writes a qcc object-group context for the named sources.
    /** \a names are written to \c src/NAME.qc with the given bodies and mapped
        to \c qo/NAME.qo, which mirrors what QORE_QCC_COMPILE_OBJECTS emits.
    */
    private string writeContext(string root, hash<string, string> sources,
            *list<string> order) {
        string src_dir = root + "/src";
        string qo_dir = root + "/qo";
        mkdir(src_dir, 0777, True);
        mkdir(qo_dir, 0777, True);
        list<string> names = order ?? sort(sources.keys());
        list<string> lines = ("format=1", "kind=qcc-object-group", "group=scc-test");
        foreach string name in (names) {
            write(src_dir + "/" + name + ".qc", sources{name});
        }
        foreach string name in (names) {
            push lines, "input=" + src_dir + "/" + name + ".qc";
        }
        foreach string name in (names) {
            push lines, "output=" + qo_dir + "/" + name + ".qo";
        }
        string path = qo_dir + "/.qcc-context" + (order ? ".ordered" : "");
        write(path, join("\n", lines) + "\n");
        return path;
    }

    #! A source whose body takes a call reference to each named function.
    /** A call reference to a unique free function is a required edge, so mutual
        references are the smallest cycle the build can actually compile.
    */
    private string callRefSource(string name, softlist<string> targets) {
        string body = "%new-style\nstring sub " + name + "Func() {\n";
        foreach string target in (targets) {
            body += sprintf("    code %s_ref = \\%sFunc();\n", target, target);
        }
        body += "    return \"" + name + "\";\n}\n";
        return body;
    }

    private hash<auto> componentMap(string context_path) {
        auto data = parse_json(order(context_path, "--scc-map"));
        assertEq(NT_HASH, data.typeCode(), "--scc-map emits a JSON object");
        return data;
    }

    private *hash<auto> componentFor(hash<auto> decomposition, string output_basename) {
        foreach hash<auto> component in (decomposition.components) {
            foreach hash<auto> member in (component.members) {
                if (basename(member.output) == output_basename) {
                    return component;
                }
            }
        }
        return NOTHING;
    }

    private list<string> memberNames(hash<auto> component) {
        list<string> names = ();
        foreach hash<auto> member in (component.members) {
            push names, basename(member.output);
        }
        return sort(names);
    }

    testCMakePlan() {
        TmpDir tmp("qore-aot-cmake-plan-");
        string context_path = writeContext(tmp.path, (
            "provider": callRefSource("provider", ()),
            "consumer": callRefSource("consumer", "provider"),
        ));
        string output_dir = cmakePlan(context_path, "PLAN_TEST");
        string direct_path = output_dir + "/direct-deps.cmake";
        string build_path = output_dir + "/build-deps.cmake";
        string scc_path = output_dir + "/scc-map.cmake";
        string symbols_path = output_dir + "/source-symbols.manifest";
        foreach string path in ((direct_path, build_path, scc_path, symbols_path,
                symbols_path + ".cache")) {
            assertTrue(is_file(path), "--cmake-plan writes " + basename(path));
        }
        string direct = ReadOnlyFile::readTextFile(direct_path);
        string build = ReadOnlyFile::readTextFile(build_path);
        string scc = ReadOnlyFile::readTextFile(scc_path);
        string symbols = ReadOnlyFile::readTextFile(symbols_path);
        assertTrue(direct.find("QORE_QCC_DIRECT_DEPS_PLAN_TEST_1") >= 0,
            "direct dependency map uses the requested group prefix");
        assertTrue(build.find("QORE_QCC_BUILD_DEPS_PLAN_TEST_1") >= 0,
            "build dependency map uses the requested group prefix");
        assertTrue(scc.find("QORE_QCC_SCC_PLAN_TEST_COUNT \"2\"") >= 0,
            "SCC map is emitted from the same dependency plan");
        assertTrue(symbols.find("function\tproviderFunc\t") >= 0,
            "the plan emits the source symbol manifest");

        # A trailing comment changes the source file but not any configure-time
        # dependency or symbol contract. The cache must absorb the edit without
        # perturbing the generated plan files.
        write(tmp.path + "/src/provider.qc",
            callRefSource("provider", ()) + "# plan-cache comment\n");
        cmakePlan(context_path, "PLAN_TEST");
        assertEq(direct, ReadOnlyFile::readTextFile(direct_path),
            "comment-only edits preserve the direct map");
        assertEq(build, ReadOnlyFile::readTextFile(build_path),
            "comment-only edits preserve the build map");
        assertEq(scc, ReadOnlyFile::readTextFile(scc_path),
            "comment-only edits preserve the SCC map");
        assertEq(symbols, ReadOnlyFile::readTextFile(symbols_path),
            "comment-only edits preserve the symbol manifest");
    }

    testRegexLiteralNamespaceTracking() {
        TmpDir tmp("qore-aot-regex-mask-");
        # The manifest names each declaration by its namespace path, which the scanner tracks by counting
        # braces in the masked source.  A regex literal is not a comment and not a string: reading `#`, `//`
        # or a quote inside one as the start of a comment blanks the rest of the line, and the `{` that opens
        # the block goes with it.  Brace depth then desynchronises for the whole rest of the file, and every
        # declaration after that point is recorded without its namespace -- which makes a type deferred to
        # `hash<Late>` where the same type resolved live is `hash<Ns::Late>`, so a whole-group parse and a
        # parse against preloaded shells publish different signatures for it.
        string context_path = writeContext(tmp.path, (
            "masking": "%new-style\n"
                "public namespace RegexMaskNs {\n"
                "    public class RegexMaskEarly {\n"
                "        static bool comment(string line) {\n"
                "            if (line =~ /^#/ || !line.size()) {\n"
                "                return True;\n"
                "            }\n"
                "            if (line =~ x/(\\/\\/.*)/) {\n"
                "                return True;\n"
                "            }\n"
                "            if (line =~ s/\"#\"/x/) {\n"
                "                return True;\n"
                "            }\n"
                "            return False;\n"
                "        }\n"
                "    }\n"
                "    public hashdecl RegexMaskLate {\n"
                "        string name;\n"
                "    }\n"
                "    public class RegexMaskLast {\n"
                "        static string label() { return \"last\"; }\n"
                "    }\n"
                "}\n",
        ));
        string output_dir = cmakePlan(context_path, "REGEX_MASK_TEST");
        string symbols = ReadOnlyFile::readTextFile(output_dir + "/source-symbols.manifest");
        assertTrue(symbols.find("class\tRegexMaskNs::RegexMaskEarly\t") >= 0,
            "a declaration before the regex literals keeps its namespace: " + symbols);
        assertTrue(symbols.find("hashdecl\tRegexMaskNs::RegexMaskLate\t") >= 0,
            "and so does one declared after them: " + symbols);
        assertTrue(symbols.find("class\tRegexMaskNs::RegexMaskLast\t") >= 0,
            "through to the end of the file: " + symbols);
        assertEq(-1, symbols.find("hashdecl\tRegexMaskLate\t"),
            "the unqualified spelling is not recorded: " + symbols);
    }

    testMutualDependencyComponent() {
        TmpDir tmp("qore-aot-scc-cycle-");
        # a <-> b is a required cycle; c consumes it; d is unrelated.
        string context_path = writeContext(tmp.path, (
            "a": callRefSource("a", "b"),
            "b": callRefSource("b", "a"),
            "c": callRefSource("c", "a"),
            "d": callRefSource("d", ()),
        ));

        hash<auto> decomposition = componentMap(context_path);
        assertEq(3, decomposition.components.size(),
            "four sources with one two-member cycle yield three components");

        hash<auto> cycle = componentFor(decomposition, "a.qo");
        assertEq(("a.qo", "b.qo"), memberNames(cycle),
            "both members of the required cycle land in one component");
        assertEq(cycle.scc, componentFor(decomposition, "b.qo").scc,
            "each cycle member resolves to the same component key");
        assertEq((), cycle.predecessors, "the cycle has no predecessor component");

        hash<auto> consumer = componentFor(decomposition, "c.qo");
        assertEq(("c.qo",), memberNames(consumer),
            "a consumer of the cycle is its own component");
        assertEq((cycle.scc,), consumer.predecessors,
            "the whole cycle is one predecessor of its consumer");
        assertEq((cycle.scc,), consumer.prerequisites,
            "the consumer's transitive prerequisites name the cycle once");

        hash<auto> isolated = componentFor(decomposition, "d.qo");
        assertEq((), isolated.predecessors, "an unrelated source has no predecessor");
        assertNeq(cycle.scc, isolated.scc, "distinct components have distinct keys");

        # The condensation must be acyclic: every predecessor of a component
        # precedes it in the reported topological order.
        hash<string, int> rank = {};
        foreach int index in (decomposition.topological_order) {
            rank{decomposition.components[index].scc} = rank.size();
        }
        assertEq(decomposition.components.size(), rank.size(),
            "the topological order places every component exactly once");
        foreach hash<auto> component in (decomposition.components) {
            foreach string predecessor in (component.predecessors) {
                assertTrue(rank{predecessor} < rank{component.scc},
                    sprintf("%y precedes its consumer %y in the condensation",
                        predecessor, component.scc));
            }
        }

        # --scc-for and --scc-members agree with the decomposition.
        string cycle_output = tmp.path + "/qo/a.qo";
        list<string> resolved = trim(order(context_path,
            ("--scc-for", cycle_output))).split("\t");
        assertEq(cycle.scc, resolved[1], "--scc-for names the member's component");
        assertEq("2", resolved[2], "--scc-for reports the member count");

        list<string> member_lines = ();
        foreach string line in (order(context_path,
                ("--scc-members", cycle.scc)).split("\n")) {
            if (trim(line)) {
                push member_lines, basename(line.split("\t")[1]);
            }
        }
        assertEq(("a.qo", "b.qo"), sort(member_lines),
            "--scc-members lists every member of the component");

        list<string> prerequisite_keys = ();
        foreach string line in (order(context_path,
                ("--scc-prerequisites", consumer.scc)).split("\n")) {
            if (trim(line)) {
                push prerequisite_keys, line.split("\t")[1];
            }
        }
        assertEq((cycle.scc,), prerequisite_keys,
            "--scc-prerequisites emits the predecessor component");
        assertEq("", trim(order(context_path, ("--scc-prerequisites", cycle.scc))),
            "a component with no predecessor has no prerequisites");
    }

    testAcyclicGraphSingletons() {
        TmpDir tmp("qore-aot-scc-acyclic-");
        # A chain plus a fan-in, with no required edge that points backwards.
        string context_path = writeContext(tmp.path, (
            "base": callRefSource("base", ()),
            "middle": callRefSource("middle", "base"),
            "leaf": callRefSource("leaf", ("middle", "base")),
            "other": callRefSource("other", "base"),
        ));

        hash<auto> decomposition = componentMap(context_path);
        assertEq(4, decomposition.components.size(),
            "an acyclic required graph decomposes into one component per source");
        foreach hash<auto> component in (decomposition.components) {
            assertEq(1, component.members.size(),
                sprintf("component %y is a singleton", component.scc));
        }

        # For singleton components the component prerequisites must be exactly
        # the components of the per-file prerequisites the build uses today.
        foreach hash<auto> component in (decomposition.components) {
            string output = component.members[0].output;
            hash<string, bool> expected = {};
            foreach string line in (order(context_path,
                    ("--build-map", output)).split("\n")) {
                if (!trim(line)) {
                    continue;
                }
                expected{componentFor(decomposition, basename(line.split("\t")[1])).scc} = True;
            }
            hash<string, bool> reported = {};
            foreach string line in (order(context_path,
                    ("--scc-prerequisites", component.scc)).split("\n")) {
                if (trim(line)) {
                    reported{line.split("\t")[1]} = True;
                }
            }
            assertEq(sort(expected.keys()), sort(reported.keys()),
                sprintf("singleton component %y reproduces the existing "
                    "prerequisite closure of %s", component.scc, basename(output)));
        }
    }

    #! What a consumer's generation watches in its predecessors, and what it ignores.
    /** A provider publishes two contracts.  The COMPILE contract describes what the
        compile produced, lowering artifacts included: native rows and body-contract
        hashes, which are outputs of the interprocedural summary pass over the batch
        being lowered.  An 875-source parse derives richer summaries than a 1-source
        parse, so recompiling one source standalone against shells publishes a
        different compile contract from the one the group's own parse published for
        it -- with no declaration having changed.  The DECLARATION contract is the
        same description with those artifacts left out, and is byte-identical across
        the two modes.

        A consumer's generation must follow the declaration contract, or the first
        incremental build after every full build walks the whole consumer closure of
        whatever was edited: each recompile republishes a compile contract that
        differs only in how it was lowered, and each such difference invalidates the
        next ring of consumers.  On one real group that turned a one-comment edit
        into 23 compiles where the same edit, built a second time, needed 1.
    */
    testGenerationFollowsDeclarationContract() {
        TmpDir tmp("qore-aot-scc-decl-contract-");
        string context_path = writeContext(tmp.path, (
            "a": callRefSource("a", ()),
            "c": callRefSource("c", "a"),
        ));
        hash<auto> decomposition = componentMap(context_path);
        string provider = componentFor(decomposition, "a.qo").scc;
        string consumer = componentFor(decomposition, "c.qo").scc;
        string compile_stamp = tmp.path + "/qo/a.qo.compile-contract.stamp";
        string declaration_stamp = tmp.path + "/qo/a.qo.aggregate-contract.stamp";

        # With neither contract published there is nothing to watch yet.
        string unpublished = token(context_path, consumer);

        # The compile contract is the fallback, and is what a group with no
        # declaration contracts on disk still resolves against.
        write(compile_stamp, "compile=1\n");
        string compile_only = token(context_path, consumer);
        assertNeq(unpublished, compile_only,
            "with no declaration contract the compile contract is still watched");

        # Once the provider publishes a declaration contract, that is what counts.
        write(declaration_stamp, "declaration=1\n");
        string declared = token(context_path, consumer);
        assertNeq(compile_only, declared,
            "the declaration contract takes precedence over the compile contract");

        # THE REGRESSION: recompiling the provider in a different mode republishes a
        # different compile contract and the same declarations.  That must not move
        # its consumers.
        write(compile_stamp, "compile=2\n");
        assertEq(declared, token(context_path, consumer),
            "a provider recompiled into a different compile contract, with its "
            "declarations unchanged, does not move its consumer's generation");

        # ...and a real declaration change must still move them, or a consumer that
        # folded one of the provider's values keeps a stale literal.
        write(declaration_stamp, "declaration=2\n");
        assertNeq(declared, token(context_path, consumer),
            "a changed declaration contract moves the consumer's generation");

        # Neither contract belongs to the provider's OWN generation: a component is
        # identified by its member sources, and publishing its own contract would
        # make it perpetually stale against the record it just wrote.
        string provider_token = token(context_path, provider);
        write(declaration_stamp, "declaration=3\n");
        write(compile_stamp, "compile=3\n");
        assertEq(provider_token, token(context_path, provider),
            "publishing a contract does not move the publisher's own generation");
    }

    #! What the declaration contract cannot say, and who has to hear it.
    /** A generation watches its predecessors' DECLARATION contracts, which carry no
        body-contract hashes -- that omission is what makes them identical between a
        whole-group parse and a standalone one, and what stops a mode transition
        cascading through the group.

        `--link-qo` does compare body contracts: a consumer that recorded a
        provider's body hash and was not rebuilt when it moved fails the aggregate
        link with "qo-link hash mismatch", naming an object the build had no recorded
        reason to rebuild.  So the consumer records the provider's body contract as a
        dependency of its own, and only when it baked one.

        Only-when-it-baked-one is the entire design.  On one real 875-source group,
        856 objects PUBLISH a body contract and 280 consume one: watching it per
        consumer keeps the other 576 out of a cascade that folding these hashes into
        the declaration contract would have caused.
    */
    testBakedBodyContractIsWatched() {
        TmpDir tmp("qore-aot-scc-body-contract-");
        string context_path = writeContext(tmp.path, (
            "a": callRefSource("a", ()),
            "c": callRefSource("c", "a"),
            "e": callRefSource("e", ()),
        ));
        hash<auto> decomposition = componentMap(context_path);
        string provider = componentFor(decomposition, "a.qo").scc;
        string consumer = componentFor(decomposition, "c.qo").scc;
        string bystander = componentFor(decomposition, "e.qo").scc;
        string body_stamp = tmp.path + "/qo/a.qo" + ".body-contract.stamp";

        # a publishes a body contract; nobody has baked one yet.
        write(body_stamp, "body=1\n");
        string before = token(context_path, consumer);
        string bystander_before = token(context_path, bystander);

        # c bakes one: qcc records the provider's body contract in c's depfile.  The
        # source entry keeps this a realistic depfile; the body-contract entry is the
        # whole point, and it is deliberately NOT spelled with the compile-contract
        # suffix, which is what makes a REQUIRED edge.
        write(tmp.path + "/qo/c.qo.d",
            tmp.path + "/qo/c.qo.stamp: \\\n    "
            + tmp.path + "/src/c.qc \\\n    " + body_stamp + "\n");
        string baked = token(context_path, consumer);
        assertNeq(before, baked,
            "recording a provider's body contract changes what the consumer watches");
        assertEq(3, componentMap(context_path).components.size(),
            "a body-contract dependency is not an ordering edge and does not "
            "condense the graph");

        # THE POINT: the provider's declarations did not move, so its declaration
        # contract is untouched -- and the consumer must still be rebuilt.
        write(body_stamp, "body=2\n");
        string moved = token(context_path, consumer);
        assertNeq(baked, moved,
            "a provider whose body contract moved invalidates the consumer that "
            "baked it, with no declaration having changed");

        # ...and nobody else.  A component that baked nothing is unaffected by the
        # same provider republishing its body contract.
        assertEq(bystander_before, token(context_path, bystander),
            "a component that baked no body contract is not invalidated by one");

        # A consumer that stops baking one stops watching it.
        write(tmp.path + "/qo/c.qo.d",
            tmp.path + "/qo/c.qo.stamp: \\\n    " + tmp.path + "/src/c.qc\n");
        assertEq(before, token(context_path, consumer),
            "dropping the baked body contract restores the generation it had "
            "before, so the manifest carries nothing when nothing is baked");
    }

    testGenerationIdentity() {
        TmpDir tmp("qore-aot-scc-generation-");
        hash<string, string> sources = (
            "a": callRefSource("a", "b"),
            "b": callRefSource("b", "a"),
            "c": callRefSource("c", "a"),
            "d": callRefSource("d", ()),
        );
        string context_path = writeContext(tmp.path, sources);
        hash<auto> decomposition = componentMap(context_path);
        string cycle = componentFor(decomposition, "a.qo").scc;
        string consumer = componentFor(decomposition, "c.qo").scc;
        string isolated = componentFor(decomposition, "d.qo").scc;

        string cycle_token = token(context_path, cycle);
        string consumer_token = token(context_path, consumer);
        string isolated_token = token(context_path, isolated);
        assertEq(64, cycle_token.size(), "a generation token is a sha256 digest");
        assertEq(cycle_token, token(context_path, cycle),
            "an unchanged source tree yields the same generation token");

        # The manifest is the token's preimage: a component's own members
        # contribute their source content, and a predecessor contributes only the
        # published contract its consumers compile against.
        hash<auto> manifest = parse_json(order(context_path,
            ("--scc-generation", cycle)));
        assertEq(cycle, manifest.scc, "the manifest names its own component");
        assertEq(2, manifest.members.size(), "the manifest names every member");
        assertEq((), manifest.prerequisites,
            "a component with no predecessor records no prerequisite contract");
        foreach hash<auto> member in (manifest.members) {
            assertEq(digest("sha256", ReadOnlyFile::readBinaryFile(member.input)).toHex(),
                member.content_digest,
                "the manifest records each member's source content digest");
        }
        hash<auto> consumer_manifest = parse_json(order(context_path,
            ("--scc-generation", consumer)));
        assertEq(1, consumer_manifest.prerequisites.size(),
            "a consumer manifest records its one predecessor component");
        assertEq(cycle, consumer_manifest.prerequisites[0].scc,
            "the recorded prerequisite is the predecessor component");
        assertEq(("a.qo", "b.qo"),
            sort((map basename($1.output), consumer_manifest.prerequisites[0].provides)),
            "the prerequisite entry names every provider member");
        foreach hash<auto> provided in (consumer_manifest.prerequisites[0].provides) {
            assertEq("", provided.contract_digest,
                "an unbuilt provider contributes an empty contract digest");
        }

        # An unrelated component's edit moves only that component.
        write(tmp.path + "/src/d.qc", sources.d + "# unrelated edit\n");
        assertEq(cycle_token, token(context_path, cycle),
            "an unrelated source edit preserves the cycle generation");
        assertEq(consumer_token, token(context_path, consumer),
            "an unrelated source edit preserves the consumer generation");
        assertNeq(isolated_token, token(context_path, isolated),
            "the edited component's own generation changes");

        # A member edit moves its own component, because its own source bytes
        # decide whether it must be recompiled.
        write(tmp.path + "/src/b.qc", sources.b + "# member edit\n");
        string edited_cycle_token = token(context_path, cycle);
        assertNeq(cycle_token, edited_cycle_token,
            "editing one cycle member changes the whole component generation");
        assertEq(consumer_token, token(context_path, consumer),
            "a provider edit that publishes no new contract leaves its consumer "
                "generation alone");

        # Publishing a different contract for one provider member is what moves a
        # consumer: that is the only provider change a consumer compiles against.
        write(tmp.path + "/qo/a.qo.compile-contract.stamp", "contract=1\n");
        string contract_consumer_token = token(context_path, consumer);
        assertNeq(consumer_token, contract_consumer_token,
            "a new provider contract moves the consumer generation");
        assertEq(edited_cycle_token, token(context_path, cycle),
            "publishing a provider contract does not move the provider's own "
                "generation");
        write(tmp.path + "/qo/a.qo.compile-contract.stamp", "contract=2\n");
        assertNeq(contract_consumer_token, token(context_path, consumer),
            "each distinct provider contract is a distinct consumer generation");

        # A consumer-only edit leaves its predecessor alone.
        string before_consumer_edit = token(context_path, consumer);
        write(tmp.path + "/src/c.qc", sources.c + "# consumer edit\n");
        assertEq(edited_cycle_token, token(context_path, cycle),
            "a consumer-only edit preserves the predecessor generation");
        assertNeq(before_consumer_edit, token(context_path, consumer),
            "a consumer-only edit changes the consumer generation");

        # Reordering the context source list must not change any identity: the
        # keys and tokens are derived from member outputs and content, not from
        # the node numbering CMake happens to emit.
        string reordered = writeContext(tmp.path, (
            "a": ReadOnlyFile::readTextFile(tmp.path + "/src/a.qc"),
            "b": ReadOnlyFile::readTextFile(tmp.path + "/src/b.qc"),
            "c": ReadOnlyFile::readTextFile(tmp.path + "/src/c.qc"),
            "d": ReadOnlyFile::readTextFile(tmp.path + "/src/d.qc"),
        ), ("d", "c", "b", "a"));
        hash<auto> reordered_map = componentMap(reordered);
        assertEq(3, reordered_map.components.size(),
            "reordering the source list preserves the decomposition");
        foreach string key in ((cycle, consumer, isolated)) {
            assertEq(token(context_path, key), token(reordered, key),
                sprintf("component %y keeps its generation across a source "
                    "list reorder", key));
        }
    }

    private string token(string context_path, string selector) {
        return trim(order(context_path, ("--scc-generation-token", selector)));
    }

    private writeArtifactFamily(string output, string external_dependency) {
        write(output, "object\n");
        write(output + ".d", sprintf("%s.stamp: %s\n", output,
            external_dependency));
        foreach string suffix in ((".idx.json", ".status.json", ".content.stamp",
                ".compile-contract.stamp", ".aggregate-contract.stamp", ".stamp",
                ".source.manifest.json", ".source-parse-defines")) {
            write(output + suffix, suffix + "\n");
        }
    }

    #! What a rebuild reaches is a different quantity from what is stale now.
    /** A component's generation names its own sources and its direct
        predecessors' published compile contracts.  Editing one source therefore
        leaves exactly one component stale: its consumers still name the contract
        that source published last time, and they go stale only once it is
        recompiled.  A build that sizes its work from the stale set is sizing it
        from the first step of a cascade -- which is what made a group-wide
        invalidation present as a one-component job.
    */
    testRebuildClosurePlanning() {
        TmpDir tmp("qore-aot-scc-closure-");
        # A chain plus a fan-in: everything reaches base, nothing reaches leaf.
        string context_path = writeContext(tmp.path, (
            "base": callRefSource("base", ()),
            "middle": callRefSource("middle", "base"),
            "leaf": callRefSource("leaf", ("middle", "base")),
            "other": callRefSource("other", "base"),
        ));
        string external = tmp.path + "/external.qmod";
        write(external, "module\n");
        # Source-only planning does not weigh depfile inputs from outside the
        # group, so this fixture needs no generation gap between the external
        # dependency and the success stamps -- only the context, which is written
        # before them, has to be no newer than they are.
        foreach string name in (("base", "middle", "leaf", "other")) {
            writeArtifactFamily(tmp.path + "/qo/" + name + ".qo", external);
        }
        assertEq(0, runOrder(context_path, "--scc-publish-all").rc,
            "the complete fixture publishes every component generation");

        # The row is opt-in: a caller that wants only the stale set keeps the
        # output it has always parsed.
        assertEq("", trim(order(context_path, "--scc-source-stale")),
            "the complete fixture is source-current");
        # The row also carries the group's component count, so a coordinator can
        # scale "the closure is the whole group anyway" to the group it is
        # planning rather than to a flat number.
        assertEq("rebuild-closure\t0\t4\n",
            order(context_path, ("--scc-source-stale", "--rebuild-closure")),
            "a current group reaches nothing, and the row names the group size");

        # One edited source at the root of the chain.
        write(tmp.path + "/src/base.qc",
            callRefSource("base", ()) + "# edited\n");
        assertEq(1, staleRows(context_path).size(),
            "editing one source leaves exactly one component stale");
        assertEq(4, rebuildClosure(context_path),
            "but rebuilding it reaches every component that requires it");

        # A leaf has no consumers, so the two quantities agree there -- which is
        # what keeps a genuinely small edit on the standalone path.
        write(tmp.path + "/src/base.qc", callRefSource("base", ()));
        write(tmp.path + "/src/leaf.qc",
            callRefSource("leaf", ("middle", "base")) + "# edited\n");
        assertEq(1, staleRows(context_path).size(),
            "editing a leaf leaves one component stale");
        assertEq(1, rebuildClosure(context_path),
            "and rebuilding it reaches nothing else");
    }

    #! The stale rows of a source-only plan, without the closure row.
    private list<string> staleRows(string context_path) {
        list<string> rows = ();
        foreach string line in (order(context_path,
                ("--scc-source-stale", "--rebuild-closure")).split("\n")) {
            if (trim(line) && line.split("\t")[0] != "rebuild-closure") {
                push rows, line;
            }
        }
        return rows;
    }

    #! The closure size a source-only plan reports.
    private int rebuildClosure(string context_path) {
        foreach string line in (order(context_path,
                ("--scc-source-stale", "--rebuild-closure")).split("\n")) {
            if (line.split("\t")[0] == "rebuild-closure") {
                return line.split("\t")[1].toInt();
            }
        }
        throw "CLOSURE-ERROR", "the stale plan reported no rebuild-closure row";
    }

    testSourceStalePlanning() {
        TmpDir tmp("qore-aot-scc-source-stale-");
        string context_path = writeContext(tmp.path, (
            "provider": callRefSource("provider", ()),
            "consumer": callRefSource("consumer", "provider"),
        ));
        string external = tmp.path + "/external.qmod";
        write(external, "module\n");
        # generationCurrent() deliberately treats an equal depfile-input mtime as
        # stale; separate the fixture's dependency and success-stamp generations.
        # Some supported filesystems expose only whole-second mtimes.  Cross a
        # full timestamp tick so the fixture cannot make the dependency and the
        # generated success stamp compare equal.
        sleep(1100ms);
        foreach string name in (("provider", "consumer")) {
            writeArtifactFamily(tmp.path + "/qo/" + name + ".qo", external);
        }
        assertEq(0, runOrder(context_path, "--scc-publish-all").rc,
            "the complete fixture publishes every component generation");
        assertEq("", trim(order(context_path, "--scc-source-stale")),
            "the complete fixture is source-current");
        hash<auto> decomposition = componentMap(context_path);
        hash<auto> consumer_component = componentFor(decomposition, "consumer.qo");
        assertEq("current\t1\n", order(context_path,
                ("--scc-compile-plan", consumer_component.scc)),
            "a locked compile plan stops after one current-generation result");

        write(external, "new module generation\n");
        list<string> externally_stale = ();
        foreach string line in (order(context_path, "--scc-stale").split("\n")) {
            if (trim(line)) {
                push externally_stale, line;
            }
        }
        assertEq(2, externally_stale.size(),
            "the authoritative currency check rejects every newer external input");
        assertEq("", trim(order(context_path, "--scc-source-stale")),
            "source-only planning leaves external depfile invalidation to CMake");
        foreach string line in (externally_stale) {
            assertEq(5, line.split("\t").size(),
                "a stale-plan row identifies the component and representative member");
        }
        string compile_plan = order(context_path,
            ("--scc-compile-plan", consumer_component.scc));
        assertTrue(compile_plan.find("current\t0\n") == 0,
            "a stale locked compile plan reports that compilation is required: "
                + compile_plan);
        assertTrue(compile_plan.regex("source-token\\t[0-9a-f]{64}\\n"),
            "the compile plan carries the publication compare-and-swap token: "
                + compile_plan);
        assertTrue(compile_plan.find("preload\t" + tmp.path
                + "/qo/provider.qo\n") != -1,
            "the compile plan carries the transitive predecessor preload: "
                + compile_plan);
        assertTrue(compile_plan.find("direct\t" + tmp.path
                + "/qo/provider.qo\n") != -1,
            "the compile plan carries the direct manifest dependency: "
                + compile_plan);
    }

    testLargeComponent() {
        TmpDir tmp("qore-aot-scc-large-");
        # 25 members: more than the 16-attempt retry budget the SCC build unit
        # replaces, so a per-file convergence loop could not have finished.
        int count = 25;
        hash<string, string> sources = {};
        for (int index = 0; index < count; ++index) {
            sources{sprintf("m%02d", index)} = callRefSource(sprintf("m%02d", index),
                sprintf("m%02d", (index + 1) % count));
        }
        string context_path = writeContext(tmp.path, sources);

        hash<auto> decomposition = componentMap(context_path);
        assertEq(1, decomposition.components.size(),
            "a ring of required edges is a single component");
        assertEq(count, decomposition.components[0].members.size(),
            "every ring member belongs to the one component");
        assertEq((), decomposition.components[0].predecessors,
            "a component that spans the whole group has no predecessor");
        assertEq((0,), decomposition.topological_order,
            "a single component orders trivially");

        hash<auto> manifest = parse_json(order(context_path,
            ("--scc-generation", decomposition.components[0].scc)));
        assertEq(count, manifest.members.size(),
            "the generation manifest names every ring member");
        # Members are ordered by output path so the identity cannot depend on
        # the order the context listed them in.
        list<string> outputs = ();
        foreach hash<auto> member in (manifest.members) {
            push outputs, member.output;
        }
        assertEq(sort(outputs), outputs,
            "manifest members are ordered by output path");
        hash<auto> compile_plan = runOrder(context_path,
            ("--scc-compile-plan", decomposition.components[0].scc));
        assertEq(1, compile_plan.rc,
            "a multi-member component is delegated to the shared batch: "
                + compile_plan.output);
        assertTrue(compile_plan.output.find("use the shared batch") != -1,
            "the invalid standalone plan names the required build path: "
                + compile_plan.output);

        # Every member resolves to the same component.
        foreach hash<auto> member in (manifest.members) {
            list<string> resolved = trim(order(context_path,
                ("--scc-for", member.output))).split("\t");
            assertEq(decomposition.components[0].scc, resolved[1],
                sprintf("%s resolves to the group component", basename(member.output)));
            assertEq(string(count), resolved[2],
                "--scc-for reports the full member count");
        }
    }

    testDegenerateGroups() {
        TmpDir tmp("qore-aot-scc-degenerate-");
        # A group configured with no sources has no components, but CMake still
        # asks for the decomposition and the generation directory at configure
        # time, so every group-wide command has to answer rather than fault.
        mkdir(tmp.path + "/qo", 0777, True);
        string empty_context = tmp.path + "/qo/.qcc-context";
        write(empty_context, "format=1\nkind=qcc-object-group\ngroup=empty\n");

        hash<auto> decomposition = componentMap(empty_context);
        assertEq((), decomposition.components,
            "an empty group has no components");
        assertEq((), decomposition.topological_order,
            "an empty group has an empty topological order");
        assertEq(0, runOrder(empty_context, "--scc-current-all").rc,
            "an empty group is trivially current");
        assertEq(0, runOrder(empty_context, "--scc-publish-all").rc,
            "an empty group publishes nothing successfully");
        string generation_dir = trim(order(empty_context, "--scc-generation-dir"));
        assertEq(tmp.path + "/qo/.qcc-scc", generation_dir,
            "an empty group still names a generation directory");
        hash<auto> cmake_map = runOrder(empty_context, ("--scc-map-cmake=EMPTY",));
        assertEq(0, cmake_map.rc,
            "an empty group emits a CMake component map: " + cmake_map.output);
        assertTrue(cmake_map.output.find("set(EMPTY_COUNT \"0\")") != -1,
            "the CMake component map declares zero components: " + cmake_map.output);

        # A single-source group is one singleton component with no predecessors.
        string single_context = writeContext(tmp.path, (
            "only": callRefSource("only", ()),
        ));
        hash<auto> single = componentMap(single_context);
        assertEq(1, single.components.size(),
            "a single-source group has one component");
        assertEq(1, single.components[0].members.size(),
            "the single component has one member");
        assertEq((), single.components[0].predecessors,
            "the single component has no predecessor");
        assertEq(64, token(single_context, single.components[0].scc).size(),
            "a single-source group still has a generation token");
    }

    testSelectorErrors() {
        TmpDir tmp("qore-aot-scc-errors-");
        string context_path = writeContext(tmp.path, (
            "a": callRefSource("a", "b"),
            "b": callRefSource("b", "a"),
        ));

        hash<auto> unknown_component = runOrder(context_path, ("--scc-members", "17"));
        assertEq(1, unknown_component.rc,
            "an out-of-range component index fails: " + unknown_component.output);
        assertTrue(unknown_component.output.find(
                "no such strongly connected component") != -1,
            "an out-of-range component index is diagnosed: "
                + unknown_component.output);

        # A key that does not resolve is not a malformed argument: a key names a
        # member set, so its absence means the decomposition changed under the
        # caller.  That is the build's own doing and has its own exit status, so
        # a builder can re-resolve instead of blaming an external source edit.
        hash<auto> unknown_key = runOrder(context_path, ("--scc-generation", "scc-000000"));
        assertEq(76, unknown_key.rc,
            "an unknown component key is a graph transition: " + unknown_key.output);
        assertTrue(unknown_key.output.find("decomposition changed") != -1,
            "an unknown component key is diagnosed as a transition: "
                + unknown_key.output);

        hash<auto> unknown_output = runOrder(context_path,
            ("--scc-for", tmp.path + "/qo/missing.qo"));
        assertEq(1, unknown_output.rc,
            "an output outside the context fails: " + unknown_output.output);
        assertTrue(unknown_output.output.find("target output not present") != -1,
            "an output outside the context is diagnosed: " + unknown_output.output);

        hash<auto> conflict = runOrder(context_path, ("--scc-map", "--scc-for"));
        assertEq(2, conflict.rc, "conflicting component commands are a usage error: "
            + conflict.output);
        assertTrue(conflict.output.find("conflicts with") != -1,
            "conflicting component commands are diagnosed: " + conflict.output);

        # --scc-map takes no target; the component commands require one.
        hash<auto> extra = runOrder(context_path, ("--scc-map", "extra"));
        assertEq(2, extra.rc, "--scc-map rejects a second positional argument: "
            + extra.output);
        hash<auto> missing = runOrder(context_path, ("--scc-generation",));
        assertEq(2, missing.rc, "--scc-generation requires a component selector: "
            + missing.output);
    }
}
