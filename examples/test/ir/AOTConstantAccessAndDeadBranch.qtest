#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires FsUtil

string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
string libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
string qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
    ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : dirname(qore_bin) + "/qcc");
if (!is_file(qcc_bin)) {
    qcc_bin = "qcc";
}

string source = '%modern

%requires reflection

public const NamespaceHash = {
    "a": {"value": 10, "flag": True},
    "b": {"value": 20, "flag": True},
};

public const NamespaceList = (
    (10, 11),
    (20, 21),
    (30, 31),
);

# Direct aliases must retain their dependency identity while init-function
# constant maps filter the alias currently being initialized.
public const NamespaceListAlias = NamespaceList;

public hashdecl ConstantRecord {
    int present;
}

public const TypedHash = <ConstantRecord>{"present": 1};

# Imported object constants nested inside a folded container must retain
# their runtime identity instead of being serialized as nothing.
public const RuntimeObjectHash = {
    "from": {"type": Qore::Reflection::IntOrNothingType},
};

class NestedDefaultInner {
    private {
        string value;
    }

    constructor(string value) {
        self.value = value;
    }

    string getValue() {
        return value;
    }
}

class NestedDefaultOuter {
    private {
        NestedDefaultInner inner;
    }

    constructor(NestedDefaultInner inner) {
        self.inner = inner;
    }

    string getValue() {
        return inner.getValue();
    }
}

class NestedDefaultHolder {
    public {
        static *NestedDefaultOuter Value = new NestedDefaultOuter(new NestedDefaultInner("nested-default"));
    }
}

class ConstantAccess {
    public {
        const DebugEnabled = False;
        const Masks = {
            "a": {"a1": True, "a2": True, "a3": True},
            "b": {"b1": True, "b2": True, "b3": True},
            "c": {"c1": True, "c2": True, "c3": True},
            "d": {"d1": True, "d2": True, "d3": True},
            "e": {"e1": True, "e2": True, "e3": True},
        };
    }
}

int debug_calls = 0;
int literal_calls = 0;

int sub deadDebugArgument() {
    ++debug_calls;
    throw "DEAD-DEBUG-ARGUMENT", "a constant-false debug argument was evaluated";
}

int sub markLiteral(int value) {
    ++literal_calls;
    return value;
}

hash<auto> sub eraseHashdeclType(auto value) {
    return value;
}

int sub directConstantAccess(int count) {
    int hits = 0;
    for (int i = 0; i < count; ++i) {
        hash<auto> selected = ConstantAccess::Masks{"c"};
        hits += selected.size();
    }
    return hits;
}

int sub constantFalseGuard() {
    int selected = 17;
    if (ConstantAccess::DebugEnabled) {
        selected = deadDebugArgument();
    }
    int phi = ConstantAccess::DebugEnabled ? deadDebugArgument() : 23;
    return selected + phi;
}

string sub verify() {
    hash<auto> namespace_child = NamespaceHash{"a"};
    hash<auto> class_child = ConstantAccess::Masks{"c"};
    list<auto> first_list = NamespaceList[0];
    list<auto> last_list = NamespaceListAlias[-1];

    namespace_child{"value"} = 99;
    first_list[0] = 99;

    int literal_value = ({
        "selected": markLiteral(7),
        "also-evaluated": markLiteral(8),
    }){"selected"};

    string typed_missing = "none";
    try {
        # Erase the static hashdecl type so the unknown member is diagnosed at
        # runtime in every execution mode.
        hash<auto> typed_hash = eraseHashdeclType(TypedHash);
        auto ignored = typed_hash{"missing"};
    } catch (hash<ExceptionInfo> ex) {
        typed_missing = ex.err;
    }

    string caught = "none";
    try {
        if (ConstantAccess::DebugEnabled) {
            deadDebugArgument();
        }
        int zero = 0;
        int ignored = 1 / zero;
    } catch (hash<ExceptionInfo> ex) {
        caught = ex.err;
    }

    return sprintf("%d|%d|%d|%s|%s|%s|%d|%d|%d|%d|%d|%s\n",
        directConstantAccess(4), class_child.size(), NamespaceHash{"a"}{"value"},
        NamespaceHash{"missing"}.type(), NamespaceList[99].type(), typed_missing,
        NamespaceList[0][0], last_list[1], literal_value, literal_calls,
        constantFalseGuard(), caught)
        + sprintf("debug=%d\n", debug_calls)
        + sprintf("runtime-object=%s|%s\n", RuntimeObjectHash{"from"}{"type"}.type(),
            RuntimeObjectHash{"from"}{"type"}.getName())
        + sprintf("nested-default=%s\n", NestedDefaultHolder::Value.getValue());
}

printf("%s", verify());
';

TmpDir tmp("qore-aot-constant-access-");
string root = tmp.path;
string source_path = root + "/constant-access.qr";
File source_file();
source_file.open2(source_path, O_WRONLY | O_CREAT | O_TRUNC);
source_file.write(source);
source_file.close();

string expected = "12|3|10|nothing|nothing|INVALID-MEMBER|10|31|7|2|40|DIVISION-BY-ZERO\ndebug=0\n"
    + "runtime-object=object|*int\nnested-default=nested-default\n";

string sub runMode(string mode) {
    return backquote(sprintf("LD_LIBRARY_PATH=%s %s -b --enable-debug --exec-mode=%s %s 2>&1",
        libqore_dir, qore_bin, mode, source_path));
}

foreach string mode in (("ast", "ir", "tiered", "jit")) {
    string actual = runMode(mode);
    if (actual != expected) {
        printf("%s mismatch:\nexpected:\n%sactual:\n%s", mode, expected, actual);
        exit(2);
    }
}

hash<string, string> sub compile(string suffix, string extra_env) {
    string exe = root + "/constant-access-" + suffix;
    string output = backquote(sprintf(
        "%s LD_LIBRARY_PATH=%s QORE_AOT_DUMP_IR=1 QORE_IR_OPT_STATS=1 "
            + "%s -O3 -o %s %s 2>&1",
        extra_env, libqore_dir, qcc_bin, exe, source_path));
    if (!is_file(exe)) {
        printf("AOT compile failed (%s):\n%s", suffix, output);
        exit(2);
    }
    return {
        "compile": output,
        "run": backquote(sprintf("LD_LIBRARY_PATH=%s %s 2>&1", libqore_dir, exe)),
    };
}

string sub functionIr(string ir, string name) {
    string marker = "=== IR for " + name;
    int start = ir.find(marker);
    int end = start < 0 ? -1 : ir.find("=================", start);
    if (start < 0 || end < 0) {
        return "";
    }
    return ir.substr(start, end - start);
}

string sub functionStats(string output, string name) {
    string marker = "IR-OPT-AOT: " + name + ":";
    int start = output.find(marker);
    int end = start < 0 ? -1 : output.find("\n", start);
    if (start < 0) {
        return "";
    }
    return output.substr(start, end < 0 ? output.size() - start : end - start);
}

hash<string, string> enabled = compile("enabled", "");
hash<string, string> pruning_disabled = compile("pruning-disabled",
    "QORE_DISABLE_IR_UNREACHABLE_BLOCKS=1");
if (enabled.run != expected || pruning_disabled.run != expected) {
    printf("AOT execution mismatch:\nexpected:\n%senabled:\n%spruning disabled:\n%s",
        expected, enabled.run, pruning_disabled.run);
    exit(2);
}

string direct_ir = functionIr(enabled.compile, "directConstantAccess(int)");
if (!direct_ir || direct_ir.find("load.constant") < 0 || direct_ir.find("make.hash") >= 0
        || direct_ir.find("hash.key.access") >= 0) {
    printf("direct constant projection was not lowered to one constant load:\n%s",
        direct_ir ?: enabled.compile);
    exit(2);
}

string enabled_guard_ir = functionIr(enabled.compile, "constantFalseGuard()");
string disabled_guard_ir = functionIr(pruning_disabled.compile, "constantFalseGuard()");
string enabled_guard_stats = functionStats(enabled.compile, "constantFalseGuard");
string disabled_guard_stats = functionStats(pruning_disabled.compile, "constantFalseGuard");
if (!enabled_guard_ir || enabled_guard_ir.find("call.direct") >= 0
        || !disabled_guard_ir || disabled_guard_ir.find("call.direct") < 0
        || !enabled_guard_stats || enabled_guard_stats.find("branches=0") >= 0
        || enabled_guard_stats.find("unreachable=0") >= 0
        || !disabled_guard_stats || disabled_guard_stats.find("unreachable=0") < 0) {
    printf("constant-false branch pruning mismatch:\nenabled IR:\n%sdisabled IR:\n%s"
        + "enabled compile:\n%sdisabled compile:\n%s",
        enabled_guard_ir, disabled_guard_ir, enabled.compile, pruning_disabled.compile);
    exit(2);
}

# Real Qorus runtime gates are declaration-only qcc --stub constants.  They
# must retain the host-supplied value while their loads move out of hot loops.
string stub_path = root + "/runtime-gate-stub.qc";
string provider_false_path = root + "/runtime-gate-false.qr";
string provider_true_path = root + "/runtime-gate-true.qr";
string external_main_path = root + "/runtime-gate-main.qr";

nothing sub writeSource(string path, string contents) {
    File f();
    f.open2(path, O_WRONLY | O_CREAT | O_TRUNC);
    f.write(contents);
    f.close();
}

writeSource(stub_path, '%modern
public namespace RuntimeGate {
    public const DebugEnabled = False;
}
');
writeSource(provider_false_path, '%modern
public namespace RuntimeGate {
    public const DebugEnabled = False;
}
');
writeSource(provider_true_path, '%modern
public namespace RuntimeGate {
    public const DebugEnabled = True;
}
');
writeSource(external_main_path, '%modern

int sub debugArgument() {
    return 1;
}

int sub externalGuard(int count) {
    int result = 0;
    for (int i = 0; i < count; ++i) {
        ++result;
        if (RuntimeGate::DebugEnabled) {
            result += debugArgument();
        }
    }
    return result;
}

sub main() {
    int result = externalGuard(5);
    printf("%d\n", result);
}
');

string provider_false_qo = root + "/runtime-gate-false.qo";
string provider_true_qo = root + "/runtime-gate-true.qo";
string external_main_qo = root + "/runtime-gate-main.qo";
string external_main_disabled_qo = root + "/runtime-gate-main-disabled.qo";
string external_false_exe = root + "/runtime-gate-false";
string external_true_exe = root + "/runtime-gate-true";
string external_disabled_exe = root + "/runtime-gate-disabled";

string external_compile = backquote(sprintf(
    "LD_LIBRARY_PATH=%s QORE_AOT_DUMP_IR=1 QORE_IR_OPT_STATS=1 "
        + "%s -O3 -c --stub=%s -o %s %s 2>&1",
    libqore_dir, qcc_bin, stub_path, external_main_qo, external_main_path));
string external_compile_disabled = backquote(sprintf(
    "QORE_DISABLE_IR_EXTERNAL_BOOL_CONST_LICM=1 LD_LIBRARY_PATH=%s "
        + "QORE_AOT_DUMP_IR=1 QORE_IR_OPT_STATS=1 %s -O3 -c --stub=%s -o %s %s 2>&1",
    libqore_dir, qcc_bin, stub_path, external_main_disabled_qo, external_main_path));
string provider_false_compile = backquote(sprintf(
    "LD_LIBRARY_PATH=%s %s -O3 -c -o %s %s 2>&1",
    libqore_dir, qcc_bin, provider_false_qo, provider_false_path));
string provider_true_compile = backquote(sprintf(
    "LD_LIBRARY_PATH=%s %s -O3 -c -o %s %s 2>&1",
    libqore_dir, qcc_bin, provider_true_qo, provider_true_path));
if (!is_file(external_main_qo) || !is_file(external_main_disabled_qo)
        || !is_file(provider_false_qo) || !is_file(provider_true_qo)) {
    printf("external runtime-gate compilation failed:\nenabled:\n%sdisabled:\n%sfalse provider:\n%s"
        + "true provider:\n%s", external_compile, external_compile_disabled,
        provider_false_compile, provider_true_compile);
    exit(2);
}

string external_link_false = backquote(sprintf(
    "LD_LIBRARY_PATH=%s %s -o %s %s %s 2>&1",
    libqore_dir, qcc_bin, external_false_exe, provider_false_qo, external_main_qo));
string external_link_true = backquote(sprintf(
    "LD_LIBRARY_PATH=%s %s -o %s %s %s 2>&1",
    libqore_dir, qcc_bin, external_true_exe, provider_true_qo, external_main_qo));
string external_link_disabled = backquote(sprintf(
    "LD_LIBRARY_PATH=%s %s -o %s %s %s 2>&1",
    libqore_dir, qcc_bin, external_disabled_exe, provider_false_qo, external_main_disabled_qo));
if (!is_file(external_false_exe) || !is_file(external_true_exe) || !is_file(external_disabled_exe)) {
    printf("external runtime-gate link failed:\nfalse:\n%strue:\n%sdisabled:\n%s",
        external_link_false, external_link_true, external_link_disabled);
    exit(2);
}

string external_false_run = backquote(sprintf("LD_LIBRARY_PATH=%s %s 2>&1",
    libqore_dir, external_false_exe));
string external_true_run = backquote(sprintf("LD_LIBRARY_PATH=%s %s 2>&1",
    libqore_dir, external_true_exe));
string external_disabled_run = backquote(sprintf("LD_LIBRARY_PATH=%s %s 2>&1",
    libqore_dir, external_disabled_exe));
if (external_false_run != "5\n" || external_true_run != "10\n"
        || external_disabled_run != "5\n") {
    printf("external runtime-gate execution mismatch:\nfalse: %y\ntrue: %y\ndisabled: %y\n",
        external_false_run, external_true_run, external_disabled_run);
    exit(2);
}

string external_ir = functionIr(external_compile, "externalGuard(int)");
string external_disabled_ir = functionIr(external_compile_disabled, "externalGuard(int)");
string external_stats = functionStats(external_compile, "externalGuard");
string external_disabled_stats = functionStats(external_compile_disabled, "externalGuard");
if (!external_ir || !external_disabled_ir
        || !external_stats || external_stats.find("hoisted=0") >= 0
        || !external_disabled_stats || external_disabled_stats.find("hoisted=0") < 0) {
    printf("external runtime-gate LICM mismatch:\nenabled IR:\n%sdisabled IR:\n%s"
        + "enabled compile:\n%sdisabled compile:\n%s",
        external_ir, external_disabled_ir, external_compile, external_compile_disabled);
    exit(2);
}
