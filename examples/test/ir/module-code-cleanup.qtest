#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-exec-mode: children - its checks run in child processes that set their own execution modes

# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires ../ExecModeHarness.qm

%exec-class ModuleCodeCleanupTest

#! Module code that runs while the module cleanup runs or while a thread's data is deleted
/** A signal handler that module code sets belongs to the module's Program, and the signal thread runs until the end
    of the cleanup: the module cleanup removes the handler before it clears the module's data, so that the handler
    cannot run module code on data being destroyed.  A foreign thread whose data holds module objects runs module
    code in the module's Program when it is deregistered.  The checks use debug-build functions; each runs in a child
    process in every execution mode, so that a crash fails an assertion rather than the test run.  Once the cleanup
    clears the data of the modules, no thread but the one that runs it, and the threads running the work that it
    hands over (ThreadPool tasks it submits, background threads it starts), can enter module code.
*/
class ModuleCodeCleanupTest inherits QUnit::Test {
    private {
        string qore_bin;
        string libqore_dir;
        string src_dir;
    }

    constructor() : QUnit::Test("ModuleCodeCleanupTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        src_dir = get_script_dir() + "/module-code-cleanup";

        addTestCase("a signal handler set by module code is removed before the module cleanup clears the module's "
            "data", \testSignalHandler());
        addTestCase("a foreign thread's deregistration runs module code in the module's Program",
            \testForeignThread());
        addTestCase("only the thread that runs the module cleanup enters module code while the cleanup clears the "
            "module's data", \testEntryDuringCleanup());
        addTestCase("the work that the module cleanup hands to other threads enters module code while the cleanup "
            "clears the module's data", \testDelegateDuringCleanup());

        set_return_value(main());
    }

    #! runs a script of the test; signal handling is enabled only if \a signals is True
    private hash<ExecModeHarness::ModeRunResult> runScript(string script, string mode, bool signals) {
        return ExecModeHarness::run_command(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s QORE_LIBDIR=%s "
            "QORE_MODULE_DIR=%s %s%s --enable-debug --exec-mode=%s %s", libqore_dir, libqore_dir, libqore_dir,
            src_dir, qore_bin, signals ? "" : " -b", mode, src_dir + "/" + script));
    }

    testSignalHandler() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("the check requires a debug build");
        }
        foreach string mode in (ExecModeHarness::ExecModes) {
            hash<ExecModeHarness::ModeRunResult> r = runScript("signal-cleanup.q", mode, True);
            assertEq(0, r.rc, sprintf("%s: exit code: %s", mode, r.out));
            assertEq("handler ran in: module\ndone\nhandler set while the module's data is cleared: False\n", r.out,
                mode);
        }
    }

    testEntryDuringCleanup() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("the check requires a debug build");
        }
        foreach string mode in (ExecModeHarness::ExecModes) {
            hash<ExecModeHarness::ModeRunResult> r = runScript("entry-cleanup.q", mode, False);
            assertEq(0, r.rc, sprintf("%s: exit code: %s", mode, r.out));
            assertEq("another thread before the cleanup: null\ndone\n"
                "another thread while the module's data is cleared: \"PROGRAM-ERROR\"\n"
                "the cleanup thread while the module's data is cleared: 2\n", r.out, mode);
        }
    }

    testDelegateDuringCleanup() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("the check requires a debug build");
        }
        foreach string mode in (ExecModeHarness::ExecModes) {
            hash<ExecModeHarness::ModeRunResult> r = runScript("delegate-cleanup.q", mode, False);
            assertEq(0, r.rc, sprintf("%s: exit code: %s", mode, r.out));
            assertEq("done\n"
                "a ThreadPool task of the cleanup thread: 2\n"
                "a background thread of the cleanup thread: 2\n"
                "a ThreadPool task of a ThreadPool task of the cleanup thread: 2\n"
                "an asynchronous I/O timer of the cleanup thread: 2\n"
                "an asynchronous I/O timer of a ThreadPool task of the cleanup thread: 2\n"
                "a ThreadPool task of a foreign thread: \"PROGRAM-ERROR\"\n"
                "a background thread of a foreign thread: \"PROGRAM-ERROR\"\n"
                "an asynchronous I/O timer of a foreign thread: \"PROGRAM-ERROR\"\n", r.out, mode);
        }
    }

    testForeignThread() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("the check requires a debug build");
        }
        foreach string mode in (ExecModeHarness::ExecModes) {
            hash<ExecModeHarness::ModeRunResult> r = runScript("foreign-thread.q", mode, False);
            assertEq(0, r.rc, sprintf("%s: exit code: %s", mode, r.out));
            assertEq("foreign thread 0: null\nforeign thread 1: null\nforeign thread 2: null\n"
                "destructor calls in the module's Program at deregistration: 3\n", r.out, mode);
        }
    }
}
