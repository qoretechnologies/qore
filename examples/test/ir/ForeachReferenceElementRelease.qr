#!/usr/bin/env qore
# Copyright (c) 2026 Qore Technologies, s.r.o.
# SPDX-License-Identifier: MIT
# the script of ForeachReferenceElementRelease.qtest: the variable of a foreach loop given a reference by an element
# of the list reads as the referenced lvalue, and the value read is released as in the AST interpreter (issues #6441,
# #6538)
%modern
class T {
    public { string n; *T m; }
    constructor(string n) { self.n = n; }
    destructor() { printf("dtor %s\n", n); }
    string get() { return n; }
}

our *T g_o;
our list<auto> g_l;
our hash<auto> g_h;
our auto g_keep;

# keeps the value, clears the referenced variable and writes the parameter
sub w_k(auto a) { g_keep = a; g_o = NOTHING; a = NOTHING; }
# clears the referenced variable and writes the parameter
sub ww(auto a, string tag) { g_o = NOTHING; a = NOTHING; printf("after write %s\n", tag); }
class C {
    m(auto a) { w_k(a); }
    mw(auto a, string tag) { g_o = NOTHING; a = NOTHING; printf("after write %s\n", tag); }
    static s(auto a) { w_k(a); }
    static sw(auto a, string tag) { g_o = NOTHING; a = NOTHING; printf("after write %s\n", tag); }
    # gives its argument on to another method, which writes its parameter
    auto n(auto a) { return a; }
}

# the issue's case: a reference and a plain value passed on through auto parameters
sub inner(auto r) {
    for (int i = 0; i < 2; ++i) {
        w_k(r);
        g_keep = NOTHING;
    }
}
sub alt(list<auto> args) {
    foreach auto r in (args) {
        inner(r);
    }
}

# a read in the loop: the object is destroyed when the referenced variable is cleared
sub read_clear(list<auto> args, string tag) {
    foreach auto r in (args) {
        printf("%s %s %s\n", tag, r.n, r.get());
        g_o = NOTHING;
        printf("after clear %s\n", tag);
    }
}
# reads of a reference to a list element, a hash key and a member
sub read_end(list<auto> args, string tag) {
    foreach auto r in (args) {
        auto y = r;
        printf("%s %s\n", tag, y.n);
    }
    printf("end %s\n", tag);
}
# the value read is given to a callee that writes the referenced variable and its parameter
sub give(list<auto> args, string tag) {
    foreach auto r in (args) {
        ww(r, tag);
    }
}
sub give_method(list<auto> args, string tag) {
    C c();
    foreach auto r in (args) {
        c.mw(r, tag);
    }
}
# a method called by name, a static method, a closure called through a reference to it, a call reference to a method
# and a method call whose argument is the value of another method call given the value read (issue #6538)
sub give_method_name(list<auto> args, string tag) {
    C c();
    foreach auto r in (args) {
        call_object_method(c, "mw", r, tag);
    }
}
sub give_static(list<auto> args, string tag) {
    foreach auto r in (args) {
        C::sw(r, tag);
    }
}
sub give_closure_ref(list<auto> args, string tag) {
    code f = sub (auto a, string t) { g_o = NOTHING; a = NOTHING; printf("after write %s\n", t); };
    reference<code> fr = \f;
    foreach auto r in (args) {
        fr(r, tag);
    }
}
sub give_call_ref(list<auto> args, string tag) {
    C c();
    code m = \c.mw();
    foreach auto r in (args) {
        m(r, tag);
    }
}
sub give_nested(list<auto> args, string tag) {
    C c();
    C c2();
    foreach auto r in (args) {
        c.mw(c2.n(r), tag);
    }
}
# an overridden method that takes its parameter over, called through a variable of the base class and directly, and
# a method of a final class that takes it over (issue #6538)
class B {
    mw(auto a, string tag) { printf("after write %s\n", tag); }
}
class D inherits B {
    mw(auto a, string tag) { g_o = NOTHING; a = NOTHING; printf("after write %s\n", tag); }
}
final class F {
    mw(auto a, string tag) { g_o = NOTHING; a = NOTHING; printf("after write %s\n", tag); }
}
# a method of a final class that takes nothing over: the value read is kept by the callee
final class FK {
    m(auto a) { w_k(a); }
}
sub give_override_base(list<auto> args, string tag) {
    B b = new D();
    foreach auto r in (args) {
        b.mw(r, tag);
    }
}
sub give_override(list<auto> args, string tag) {
    D d();
    foreach auto r in (args) {
        d.mw(r, tag);
    }
}
sub give_final(list<auto> args, string tag) {
    F f();
    foreach auto r in (args) {
        f.mw(r, tag);
    }
}
sub keep_final(list<auto> args) {
    FK f();
    foreach auto r in (args) {
        f.m(r);
        g_keep = NOTHING;
    }
}

# called first with no reference, before the process reads a value through one, then with one: its call gives the
# value read once the process has read through a reference
sub give_method_first(list<auto> args, string tag) {
    C c();
    foreach auto r in (args) {
        c.mw(r, tag);
    }
}
sub keep_method(list<auto> args) {
    C c();
    foreach auto r in (args) {
        c.m(r);
        g_keep = NOTHING;
    }
}
sub keep_static(list<auto> args) {
    foreach auto r in (args) {
        C::s(r);
        g_keep = NOTHING;
    }
}
sub keep_closure(list<auto> args) {
    code f = sub (auto a) { w_k(a); };
    foreach auto r in (args) {
        f(r);
        g_keep = NOTHING;
    }
}
# an untyped variable: the read as an integer
sub read_int(list<auto> args, string tag) {
    foreach auto r in (args) {
        int i = r + 1;
        printf("%s %d\n", tag, i);
    }
}

# before any read through a reference
give_method_first((1, 2), "first");

for (int round = 0; round < 3; ++round) {
    printf("round %d\n", round);

    g_o = new T("alt");
    T plain("plain");
    alt((\g_o, plain));
    printf("after alt\n");
    delete plain;
    printf("after plain\n");

    g_o = new T("clear");
    read_clear((\g_o,), "clear");
    printf("after read clear\n");

    g_l = (new T("lel"),);
    read_end((\g_l[0],), "lel");
    g_l = ();
    printf("after lel\n");

    g_h = {"k": new T("hkey")};
    read_end((\g_h.k,), "hkey");
    g_h = {};
    printf("after hkey\n");

    g_o = new T("outer");
    g_o.m = new T("member");
    read_end((\g_o.m,), "member");
    g_o.m = NOTHING;
    printf("after member\n");
    g_o = NOTHING;

    g_o = new T("give");
    give((\g_o,), "give");
    printf("after give\n");

    g_o = new T("gmeth");
    give_method((\g_o,), "gmeth");
    printf("after gmeth\n");

    foreach string tag in (("gfirst", "gname", "gstatic", "gcref", "gmref", "gnest", "gobase", "goderived",
            "gfinal")) {
        g_o = new T(tag);
        switch (tag) {
            case "gfirst": give_method_first((\g_o,), tag); break;
            case "gname": give_method_name((\g_o,), tag); break;
            case "gstatic": give_static((\g_o,), tag); break;
            case "gcref": give_closure_ref((\g_o,), tag); break;
            case "gmref": give_call_ref((\g_o,), tag); break;
            case "gnest": give_nested((\g_o,), tag); break;
            case "gobase": give_override_base((\g_o,), tag); break;
            case "goderived": give_override((\g_o,), tag); break;
            case "gfinal": give_final((\g_o,), tag); break;
        }
        printf("after %s\n", tag);
    }

    g_o = new T("kmeth");
    keep_method((\g_o,));
    printf("after kmeth\n");

    g_o = new T("kfinal");
    keep_final((\g_o,));
    printf("after kfinal\n");

    g_o = new T("kstatic");
    keep_static((\g_o,));
    printf("after kstatic\n");

    g_o = new T("kclosure");
    keep_closure((\g_o,));
    printf("after kclosure\n");

    our auto g_i = round;
    read_int((\g_i,), "int");

    # top-level code
    g_o = new T("top");
    foreach auto r in ((\g_o,)) {
        printf("top %s\n", r.n);
        g_o = NOTHING;
        printf("after clear top\n");
    }
    printf("round end %d\n", round);
}
