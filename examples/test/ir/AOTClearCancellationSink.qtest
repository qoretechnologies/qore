#!/usr/bin/env qore
# Copyright (c) 2026 Qore Technologies, s.r.o.
# SPDX-License-Identifier: MIT
%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../NativeFixture.qm
%requires ../LlvmConfig.qm
%exec-class ClearCancellationSinkTest

class ClearCancellationSinkTest inherits QUnit::Test {
    private {
        string root = realpath(get_script_dir() + "/../../..");
        string libdir = realpath(ENV.QORE_LIBDIR ?? root + "/build");
    }

    constructor() : Test("AOT clear cancellation sink proof", "1.0", \ARGV) {
        addTestCase("CFG proof preserves unknown effects and entry checks", \native());
        addTestCase("late AOT selection and disabled controls", \aot());
        set_return_value(main());
    }

    private static string quote(string value) {
        return "'" + replace(value, "'", "'\"'\"'") + "'";
    }

    private string run(list<string> args, string prefix = "") {
        int status;
        string output = backquote(prefix + "LD_LIBRARY_PATH=" + quote(libdir)
            + " DYLD_LIBRARY_PATH=" + quote(libdir) + " "
            + (map quote($1), args).join(" ") + " 2>&1", \status);
        assertEq(0, status, output);
        return output;
    }

    #! the llvm-config of the LLVM this qore was built with, which the driver must be built with
    private string llvmConfig() {
        return LlvmConfig::llvm_config_path();
    }

    private native() {
        TmpDir dir("qore-clear-cancel-sink-");
        string executable = dir.path + "/proof-test";
        string llvm_config = llvmConfig();
        string llvm_include = trim(run((llvm_config, "--includedir")));
        string llvm_lib = trim(run((llvm_config, "--libdir")));
        list<string> llvm_link = split(" ", trim(run((llvm_config, "--libs", "--system-libs"))));
        # Internal headers also need the build's dependency paths (NativeFixture). -O2 folds the null
        # return-type argument in the inline private fast-entry setter; its
        # general type-query implementation is intentionally not exported.
        list<string> args = (ENV.CXX ?? "c++", "-std=c++20", "-O2", "-g", "-DHAVE_UNIX_CONFIG_H",
            "-I" + root + "/include", "-I" + libdir + "/include", "-I" + libdir)
            + native_fixture_include_args(libdir)
            + ("-I" + llvm_include, get_script_dir() + "/aot_clear_cancellation_sink.cpp",
            "-L" + libdir, "-L" + llvm_lib, "-Wl,-rpath," + libdir,
            "-Wl,-rpath," + llvm_lib, "-lqore") + llvm_link + ("-o", executable);
        *list<*string> target = (Qore::CFLAGS =~ x/(-mmacosx-version-min=\S+)/);
        if (target) {
            push args, target[0];
        }
        run(args);
        string expected = "clear-cancellation-sink: 37 cases passed\n";
        assertEq(expected, run((executable,)));

    }
    private aot() {
        TmpDir dir("qore-clear-cancel-sink-aot-");
        string source = get_script_dir() + "/AOTClearCancellationSink.qr";
        string expected = run((libdir + "/qore", "--exec-mode=ast", source));
        foreach string mode in (("ir", "jit", "tiered")) {
            assertEq(expected, run((libdir + "/qore", "--exec-mode=" + mode, source)), mode);
        }
        foreach string prefix in (("", "QORE_DISABLE_LLVM_CLEAR_CANCEL_SINK=1 ",
                "QORE_AOT_EH=1 ", "MAKEFLAGS= QCC_JOBS=4 QCC_SPLIT_THRESHOLD=1 ")) {
            foreach string level in (("-O0", "-O3")) {
                string executable = dir.path + "/fixture";
                string generated = run((ENV.QCC ?? libdir + "/qcc", level, "--strip-source",
                    "-o", executable, source), prefix
                    + "QORE_IR_OPT_STATS=1 QORE_DUMP_IR_AFTER_OPT=1 ");
                if (prefix.startsWith("QORE_DISABLE_")) {
                    assertFalse(generated.contains("clear-cancel-sink-edges="), "disabled control");
                } else if (level == "-O3") {
                    assertTrue(regex(generated, "clear-cancel-sink-edges=[1-9]"), "optimized CFG selection");
                }
                assertTrue(generated.contains("load atomic i8"), "thread poll retained");
                assertTrue(generated.contains("load atomic i64"), "program poll retained");
                assertTrue(generated.contains("@qore_rt_check_cancel_v2("), "slow cancellation retained");
                assertEq(expected, run((executable,)), prefix + level);
            }
        }
    }
}
