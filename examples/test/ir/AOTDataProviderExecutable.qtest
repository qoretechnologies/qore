#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
string libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
string qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
    ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : dirname(qore_bin) + "/qcc");
if (!is_file(qcc_bin)) {
    qcc_bin = "qcc";
}

string source_path = get_script_dir() + "/../qlib/DataProvider/DataProvider.qtest";
string exe_path = "/tmp/qore-aot-dataprovider-executable-" + string(getpid());
on_exit unlink(exe_path);

string compile_out = backquote(sprintf(
    "LD_LIBRARY_PATH=%s %s --strip-debug-info -O3 -o %s %s 2>&1",
    libqore_dir, qcc_bin, exe_path, source_path));
if (!is_file(exe_path)) {
    printf("AOT compile failed:\n%s", compile_out);
    exit(2);
}

string run_out = backquote(sprintf("LD_LIBRARY_PATH=%s %s 2>&1", libqore_dir, exe_path));
if (run_out !~ /Ran 23 test cases, 23 succeeded/) {
    printf("AOT DataProvider execution failed:\n%s", run_out);
    exit(2);
}
