#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../ExecModeHarness.qm

%include exec-mode-output-test.qc

%exec-class ThreadLocalLValuePathTest

#! Regression test: a thread_local variable changed in place through an lvalue path reads as changed
/** The IR interpreter kept a copy of each thread_local variable that a function stored in the function's frame and
    read the copy instead of the variable until the next call.  Operators that change the variable in place through
    an lvalue path (<tt>t.a = 1</tt>, <tt>t{"a"} = 1</tt>, <tt>t[1] = x</tt>, <tt>t[0] += 1</tt>,
    <tt>t += {...}</tt>, \c push, \c delete, a reference to an element, ...) left the copy unchanged, so
    <tt>t = {}; t.id = id; return t;</tt> returned an empty hash in IR mode and wherever JIT or tiered execution ran
    the function with the IR interpreter.  The frame now keeps no copy: a thread_local variable is read from the
    variable every time, as the AST interpreter reads it.

    Each function of the script stores a thread_local variable (hash, list, \c auto, or-nothing hash, \c int,
    \c softint, object), changes it in place and returns it; the controls change it in a closure, through a
    reference argument, in \c on_exit, \c on_success and \c on_error handlers, in recursive calls and in another
    thread (whose thread_local variable is its own).  Each function is called three times, in every execution mode
    and on the IR tier of tiered execution (see ExecModeOutputTest).
*/
class ThreadLocalLValuePathTest inherits ExecModeOutputTest {
    public {
        #! the script run in every execution mode
        const Script = '%modern
%allow-weak-references
thread_local hash<auto> ctx;
thread_local hash<auto!> th;
thread_local list<auto!> tl;
thread_local auto ta;
thread_local *hash<auto!> tn;
thread_local int ti;
thread_local softint ts;
thread_local object tobj;

class K { public { int v = 0; } }

# each function stores the thread_local variable, changes it in place through an lvalue path and reads it
hash<auto> sub init_ctx(string id = "x") { ctx = {}; ctx.id = id; ctx.count += 1; return ctx; }
auto sub h_member() { th = {}; th.a = 1; return th; }
auto sub h_key() { th = {}; th{"a"} = 1; return th; }
auto sub h_nested() { th = {}; th.a.b = 1; th.a.c += 2; return th; }
auto sub h_plus() { th = {}; th += {"a": 1}; return th; }
auto sub h_inc() { th = {"a": 1}; th.a++; ++th.a; th.a *= 3; return th; }
auto sub h_delete() { th = {"a": 1, "b": 2}; delete th.a; remove th.b; return th; }
auto sub h_pop() { th = {"l": (1, 2, 3)}; pop th.l; shift th.l; push th.l, 4; unshift th.l, 0; return th; }
auto sub h_splice() { th = {"l": (1, 2, 3)}; splice th.l, 1, 1; return th; }
auto sub h_ref() { th = {}; reference r = \th.a; r = 5; return th; }
auto sub h_extract() { th = {"l": (1, 2, 3)}; extract th.l, 0, 1; return th; }
auto sub l_elem() { tl = (1, 2); tl[1] = "x"; return tl; }
auto sub l_elem_plus() { tl = (1, 2); tl[0] += 10; return tl; }
auto sub l_plus() { tl = (1, 2); tl += 3; return tl; }
auto sub l_push() { tl = (1, 2); push tl, 3; return tl; }
auto sub l_nested() { tl = (1, (2, 3)); tl[1][0] = 9; return tl; }
auto sub a_hash() { ta = {}; ta.x = 1; return ta; }
auto sub a_list() { ta = (); ta[1] = 2; return ta; }
auto sub a_nested() { ta = {"y": ()}; ta.y[0] = "z"; return ta; }
auto sub n_hash() { tn = NULL; remove tn; tn.k = 1; tn.k++; return tn; }
auto sub i_ops() { ti = 1; ti += 2; ++ti; ti++; ti -= 1; return ti; }
auto sub s_ops() { ts = 1; ts *= 3; ts -= 1; ts /= 2; return ts; }
auto sub o_member() { tobj = new K(); tobj.v = 1; tobj.v += 2; return tobj.v; }
auto sub w_member() { tobj = new K(); th = {}; th.o := tobj; th.o.v++; return (tobj.v, th.o.v); }
# reads after the change in a closure, a callee, a handler and a background thread
auto sub closure() { th = {}; code c = sub () { th.cl = 1; }; c(); th.after = 2; return th; }
auto sub refarg() { th = {}; sub (reference<auto> rr) { rr = 7; }(\th.q); th.after = 2; return th; }
auto sub handlers() {
    th = {};
    {
        on_exit th.exit = True;
        on_success th.ok = True;
        on_error th.err = True;
        th.body = True;
    }
    try {
        on_error th.err2 = True;
        throw "X";
    } catch (hash<ExceptionInfo> ex) {
        th.caught = ex.err;
    }
    return th;
}
int sub rec(int n) {
    th.depth = n;
    if (n) {
        rec(n - 1);
    }
    th.after{n} = th.depth;
    return th.depth;
}
auto sub recursion() { th = {}; rec(2); return th; }
auto sub thread() {
    th = {"main": 1};
    Counter c(1);
    background sub () { th = {"bg": 1}; th.x = 2; c.dec(); }();
    c.waitForZero();
    th.y = 3;
    return th;
}

hash<string, code> tests = {
    "init_ctx": \init_ctx(), "h_member": \h_member(), "h_key": \h_key(), "h_nested": \h_nested(),
    "h_plus": \h_plus(), "h_inc": \h_inc(), "h_delete": \h_delete(), "h_pop": \h_pop(), "h_splice": \h_splice(),
    "h_ref": \h_ref(), "h_extract": \h_extract(), "l_elem": \l_elem(), "l_elem_plus": \l_elem_plus(),
    "l_plus": \l_plus(), "l_push": \l_push(), "l_nested": \l_nested(), "a_hash": \a_hash(), "a_list": \a_list(),
    "a_nested": \a_nested(), "n_hash": \n_hash(), "i_ops": \i_ops(), "s_ops": \s_ops(), "o_member": \o_member(),
    "w_member": \w_member(), "closure": \closure(), "refarg": \refarg(), "handlers": \handlers(),
    "recursion": \recursion(), "thread": \thread(),
};
for (int i = 0; i < 3; ++i) {
    foreach hash<auto> t in (tests.pairIterator()) {
        printf("%d %s: %y\n", i, t.key, t.value());
    }
}
';

        #! the AST interpreter's output for each call, without the number of the call
        const Expected = (
            "init_ctx: {id: \"x\", count: 1}",
            "h_member: {a: 1}",
            "h_key: {a: 1}",
            "h_nested: {a: {b: 1, c: 2}}",
            "h_plus: {a: 1}",
            "h_inc: {a: 9}",
            "h_delete: {}",
            "h_pop: {l: [0, 2, 4]}",
            "h_splice: {l: [1, 3]}",
            "h_ref: {a: 5}",
            "h_extract: {l: [2, 3]}",
            "l_elem: [1, \"x\"]",
            "l_elem_plus: [11, 2]",
            "l_plus: [1, 2, 3]",
            "l_push: [1, 2, 3]",
            "l_nested: [1, [9, 3]]",
            "a_hash: {x: 1}",
            "a_list: [null, 2]",
            "a_nested: {y: [\"z\"]}",
            "n_hash: {k: 2}",
            "i_ops: 4",
            "s_ops: 1",
            "o_member: 3",
            "w_member: [1, 1]",
            "closure: {cl: 1, after: 2}",
            "refarg: {q: 7, after: 2}",
            "handlers: {body: True, ok: True, exit: True, err2: True, caught: \"X\"}",
            "recursion: {depth: 0, after: {0: 0, 1: 0, 2: 0}}",
            "thread: {main: 1, y: 3}",
        );
    }

    constructor() : ExecModeOutputTest("ThreadLocalLValuePath", Script, ThreadLocalLValuePathTest::expected(),
            "reads a thread_local variable changed through an lvalue path as changed") {
    }

    #! returns the AST interpreter's output: each line of Expected for each call
    static string expected() {
        string rv;
        for (int i = 0; i < 3; ++i) {
            rv += (map sprintf("%d %s\n", i, $1), Expected).join("");
        }
        return rv;
    }
}
