#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-exec-mode: children - its checks run in child processes that set their own execution modes

# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../ExecModeHarness.qm

%exec-class ModuleExecutionContextTest

#! Module code called from a restricted Program runs alike in every execution mode, with a sandboxed caller's restrictions
/** Module code (a module function, a method of a module class or a closure created in module code) runs in the
    module's Program.  The fast call paths of the IR interpreter, JIT and AOT code once ran module code with other
    restrictions than an AST call, depending on whether the function has default arguments or on tiered promotion:
    lockdown user code could call \c RWLock::readLock() through a call reference to an \c RWLock that a module
    function created, and module code could create objects of thread classes with \c create_object(), only in some
    modes.

    A sandboxed caller's restrictions are part of its sandbox and apply to module code in every mode, so the calls are
    refused for a sandboxed lockdown caller; a caller restricted only by its parse options restricts its own code, and
    the module code runs with the module's own options.  Each case runs the same script with the source module and
    with the module AOT-compiled with <tt>--compile-module</tt>, in every execution mode, and expects the output of
    the source module with the AST interpreter, which is the reference.
*/
class ModuleExecutionContextTest inherits QUnit::Test {
    private {
        string qore_bin;
        string libqore_dir;

        TmpDir tmp("qore-module-execution-context-");
        string src_dir;
        string qmod_dir;

        #! the output of the source module with the AST interpreter
        const ExpectedContextOutput = "sandboxed callref: INVALID-FUNCTION-ACCESS
sandboxed callref_default_arg: INVALID-FUNCTION-ACCESS
sandboxed direct: INVALID-FUNCTION-ACCESS
sandboxed create_obj: CREATE-OBJECT-ERROR
sandboxed create_obj: CREATE-OBJECT-ERROR
sandboxed create_obj: CREATE-OBJECT-ERROR
sandboxed create_obj_default_arg: CREATE-OBJECT-ERROR
sandboxed create_obj_default_arg: CREATE-OBJECT-ERROR
sandboxed create_obj_default_arg: CREATE-OBJECT-ERROR
sandboxed closure_create_obj: CREATE-OBJECT-ERROR
sandboxed closure_create_obj: CREATE-OBJECT-ERROR
sandboxed closure_create_obj: CREATE-OBJECT-ERROR
sandboxed member: \"member\"
sandboxed member: \"member\"
sandboxed member_default_arg: \"member\"
sandboxed member_default_arg: \"member\"
sandboxed holder: \"member\"
sandboxed holder: \"member\"
unsandboxed callref: null
unsandboxed callref_default_arg: null
unsandboxed direct: INVALID-FUNCTION-ACCESS
unsandboxed create_obj: \"RWLock\"
unsandboxed create_obj: \"RWLock\"
unsandboxed create_obj: \"RWLock\"
unsandboxed create_obj_default_arg: \"RWLock\"
unsandboxed create_obj_default_arg: \"RWLock\"
unsandboxed create_obj_default_arg: \"RWLock\"
unsandboxed closure_create_obj: \"RWLock\"
unsandboxed closure_create_obj: \"RWLock\"
unsandboxed closure_create_obj: \"RWLock\"
unsandboxed member: \"member\"
unsandboxed member: \"member\"
unsandboxed member_default_arg: \"member\"
unsandboxed member_default_arg: \"member\"
unsandboxed holder: \"member\"
unsandboxed holder: \"member\"
";
    }

    constructor() : QUnit::Test("ModuleExecutionContextTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        src_dir = tmp.path + "/src";
        qmod_dir = tmp.path + "/qmod";
        mkdir(src_dir);
        mkdir(qmod_dir);
        writeFile(src_dir + "/ExecContextMod.qm", moduleCode());

        addTestCase("module code called from a sandboxed PO_LOCKDOWN Program runs with its restrictions, and from an "
            "unsandboxed one with the module's own options, in every mode",
            \testExecutionContext());

        set_return_value(main());
    }

    private string moduleCode() {
        return "%modern

module ExecContextMod {
    version = \"1.0\";
    desc = \"module execution context regression module\";
    author = \"Qore\";
    license = \"MIT\";
}

public namespace ExecContextMod {
public class Holder {
    public {
        RWLock lock();
    }

    string check() {
        lock.readLock();
        lock.readUnlock();
        return \"member\";
    }
}

public auto sub getLock() {
    return new RWLock();
}

public auto sub getLockDefaultArg(hash<auto> opts = {}) {
    return new RWLock();
}

public string sub createObject() {
    return create_object(\"RWLock\").className();
}

public string sub createObjectDefaultArg(hash<auto> opts = {}) {
    return create_object(\"RWLock\").className();
}

public code sub closureCreateObject() {
    return string sub () { return create_object(\"RWLock\").className(); };
}

public string sub member() {
    Holder h();
    return h.check();
}

public string sub memberDefaultArg(hash<auto> opts = {}) {
    Holder h();
    return h.check();
}
}
";
    }

    private string contextScript() {
        return "%modern
%requires ExecContextMod

const ProbeCode = \"
auto sub callref() { auto l = ExecContextMod::getLock(); code c = \\\\l.readLock(); return c(); }
auto sub callref_default_arg() { auto l = ExecContextMod::getLockDefaultArg(); code c = \\\\l.readLock(); return c(); }
auto sub direct() { auto l = ExecContextMod::getLock(); l.readLock(); return 'used'; }
auto sub create_obj() { return ExecContextMod::createObject(); }
auto sub create_obj_default_arg() { return ExecContextMod::createObjectDefaultArg(); }
auto sub closure_create_obj() { code c = ExecContextMod::closureCreateObject(); return c(); }
auto sub member() { return ExecContextMod::member(); }
auto sub member_default_arg() { return ExecContextMod::memberDefaultArg(); }
auto sub holder() { ExecContextMod::Holder h(); return h.check(); }
\";

# the same calls from a sandboxed lockdown Program and from one restricted only by its parse options
hash<string, Program> callers;
foreach string label in (\"sandboxed\", \"unsandboxed\") {
    Program p(PO_NEW_STYLE);
    if (label == \"sandboxed\") {
        p.setSandboxManager(new SandboxManager());
    }
    p.loadModule(\"ExecContextMod\");
    p.setParseOptions(PO_LOCKDOWN);
    p.parse(ProbeCode, label);
    callers{label} = p;
}

# repeated calls run the module code on every tier with tiered execution
foreach string label in (\"sandboxed\", \"unsandboxed\") {
    foreach string f in (\"callref\", \"callref_default_arg\", \"direct\", \"create_obj\",
            \"create_obj\", \"create_obj\", \"create_obj_default_arg\", \"create_obj_default_arg\",
            \"create_obj_default_arg\", \"closure_create_obj\", \"closure_create_obj\",
            \"closure_create_obj\", \"member\", \"member\", \"member_default_arg\", \"member_default_arg\",
            \"holder\", \"holder\") {
        string r;
        try {
            r = sprintf(\"%y\", callers{label}.callFunction(f));
        } catch (hash<ExceptionInfo> ex) {
            r = ex.err;
        }
        printf(\"%s %s: %s\\n\", label, f, r);
    }
}
";
    }

    private string writeFile(string path, string contents) {
        File f();
        f.open2(path, O_WRONLY | O_CREAT | O_TRUNC);
        f.write(contents);
        f.close();
        return path;
    }

    private compileModule(string qm_path, string qmod_path) {
        string compile_out = backquote(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s QORE_LIBDIR=%s "
            "%s -b --compile-module --output %s %s 2>&1", libqore_dir, libqore_dir, libqore_dir, qore_bin,
            qmod_path, qm_path));
        assertTrue(is_file(qmod_path), sprintf("compiled %s: %s", basename(qmod_path), compile_out));
    }

    private hash<ExecModeHarness::ModeRunResult> runScript(string module_dir, string script_path, string mode) {
        return ExecModeHarness::run_command(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s QORE_LIBDIR=%s "
            "QORE_MODULE_DIR=%s %s -b --enable-debug --exec-mode=%s %s", libqore_dir, libqore_dir, libqore_dir,
            module_dir, qore_bin, mode, script_path));
    }

    #! runs the script with the source and the AOT module in every mode against the source module's AST output
    private checkAllModes(string script_name, string script, string expected) {
        string script_path = writeFile(tmp.path + "/" + script_name, script);
        hash<ExecModeHarness::ModeRunResult> reference = runScript(src_dir, script_path, "ast");
        assertEq(expected, reference.out, script_name + ": source module, ast");
        foreach string mode in (ExecModeHarness::ExecModes) {
            hash<ExecModeHarness::ModeRunResult> r = runScript(src_dir, script_path, mode);
            assertEq(reference.out, r.out, sprintf("%s: source module, %s", script_name, mode));
            r = runScript(qmod_dir, script_path, mode);
            assertEq(reference.out, r.out, sprintf("%s: AOT module, %s", script_name, mode));
        }
    }

    testExecutionContext() {
        compileModule(src_dir + "/ExecContextMod.qm", qmod_dir + "/ExecContextMod.qmod");
        checkAllModes("context.q", contextScript(), ExpectedContextOutput);
    }
}
