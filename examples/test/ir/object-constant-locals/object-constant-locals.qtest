#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit

%include object-constant-locals-checks.qi

%exec-class ObjectConstantLocalsTest

#! Regression test for the IR's local analysis of a function that calls a method on stdout or stderr
/** The analysis gave up on such a function, so all of its locals stayed on the runtime local stack.  The checks in
    object-constant-locals-checks.qi read how many locals each function keeps there, in this program and in a worker
    in each execution mode, and check the functions' results.
*/
class ObjectConstantLocalsTest inherits QUnit::Test {
    public {
        #! the execution modes the worker is run in
        const ExecModes = ("ast", "ir", "jit", "tiered");
        #! the results of the functions
        const Results = {
            "control-result": 17,
            "stderr-result": 17,
            "stdout-result": 19,
            "object-result": 3,
        };
    }

    private {
        string qore_bin;
        string libqore_dir;
    }

    constructor() : QUnit::Test("ObjectConstantLocalsTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);

        addTestCase("functions calling methods on stdout and stderr compute their results", \testResults());
        addTestCase("their plain locals are not kept on the runtime stack", \testAnalysis());

        set_return_value(main());
    }

    testResults() {
        checkResults("in-program", ocl_results());
        foreach string mode in (ExecModes) {
            checkResults(mode, runWorker(mode));
        }
    }

    testAnalysis() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("the count of the locals on the runtime stack (dbg_get_ir_instantiated_local_entries()) is only "
                "in library-debug builds");
        }
        hash<string, int> results = runWorker("ir");
        # the object is on the runtime stack, so the counter reads the function's own frame
        assertGt(results."control-entries", results."object-entries", "ir: the object local is on the runtime stack");
        assertEq(results."control-entries", results."stderr-entries",
            "ir: no body local of the stderr function is on the runtime stack");
        assertEq(results."control-entries", results."stdout-entries",
            "ir: no body local of the stdout function is on the runtime stack");
    }

    #! checks the results of the functions
    private checkResults(string label, hash<string, int> results) {
        foreach hash<auto> i in (Results.pairIterator()) {
            assertEq(i.value, results{i.key}, label + ": " + i.key);
        }
    }

    #! runs the worker in the given mode and parses its "name=value" output
    private hash<string, int> runWorker(string mode) {
        string worker = get_script_dir() + DirSep + "object-constant-locals-worker.q";
        string cmd = sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s %s -b --exec-mode=%s %s 2>&1",
            libqore_dir, libqore_dir, qore_bin, mode, worker);
        string out = backquote(cmd);
        hash<string, int> results = {};
        foreach string line in (out.split("\n")) {
            *list<*string> parts = (line =~ x/^([-a-z]+)=(-?[0-9]+)$/);
            if (!parts) {
                if (line.val()) {
                    fail(sprintf("%s: unexpected worker output: %y", mode, out));
                }
                continue;
            }
            results{parts[0]} = parts[1].toInt();
        }
        assertEq(8, results.size(), mode + ": worker produced results (" + out + ")");
        return results;
    }
}
