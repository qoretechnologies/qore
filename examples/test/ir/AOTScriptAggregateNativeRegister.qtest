#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil

%exec-class AOTScriptAggregateNativeRegisterTest

class AOTScriptAggregateNativeRegisterTest inherits QUnit::Test {
    private {
        string qore_bin;
        string qcc_bin;
        string libqore_dir;
        string source_root;
        string env;
    }

    constructor() : QUnit::Test("AOTScriptAggregateNativeRegisterTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
            ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");
        source_root = realpath(dirname(get_script_path()) + "/../../..");
        env = sprintf("QORE_DISABLE_IR_NATIVE_LEAF_INLINE=1 "
            "LD_LIBRARY_PATH=%s QORE_LIBDIR=%s QORE_INCLUDE_DIR=%s",
            libqore_dir, libqore_dir, source_root + "/include");

        addTestCase("script aggregate binds per-file native bodies", \testNativeRegisterAggregate());
        addTestCase("declaration-only aggregate reports what it emitted",
            \testDeclarationOnlyReporting());

        set_return_value(main());
    }

    private string run(string cmd) {
        return backquote(cmd + " 2>&1");
    }

    private write(string path, string body) {
        File f();
        f.open2(path, O_WRONLY | O_CREAT | O_TRUNC, 0755);
        f.write(body);
    }

    testNativeRegisterAggregate() {
        TmpDir tmp("qore-aot-script-native-register-");
        string tmp_dir = tmp.path;
        string qo_dir = tmp_dir + "/qo";
        mkdir(qo_dir);

        string provider = tmp_dir + "/provider.qr";
        string consumer = tmp_dir + "/consumer.qr";
        string aggregate = tmp_dir + "/native-aggregate.qo";
        string glue = tmp_dir + "/host.cpp";
        string exe = tmp_dir + "/native-aggregate";

        write(provider, "%modern
class NativeRegisterProvider {
    static code<int(int)> makeAdder(int base) {
        return int sub (int value) {
            return base + value;
        };
    }
}
");
        write(consumer, "%modern
int sub main() {
    code<int(int)> add = NativeRegisterProvider::makeAdder(19);
    printf(\"%d\\n\", add(23));
    return 0;
}
");
        write(glue, "#include <qore/Qore.h>
#include <qore/QoreAOT.h>
#include <stdio.h>

extern \"C\" void init_NATIVE_REGISTER_AGG_qo(QoreProgram*);

int main(int, char**) {
    qore_init(QL_GPL, \"UTF-8\", true);
    QoreProgram* pgm = qore_create_program(PO_NEW_STYLE | PO_STRICT_ARGS);
    if (!pgm) {
        fprintf(stderr, \"qore_create_program failed\\n\");
        qore_cleanup();
        return 1;
    }
    qore_aot_script_begin_batch(pgm);
    init_NATIVE_REGISTER_AGG_qo(pgm);
    int rc = qore_aot_script_end_batch(pgm);
    if (rc != 0) {
        fprintf(stderr, \"batch flush failed rc=%d: %s\\n\", rc, qore_last_error(pgm));
        qore_destroy_program(pgm);
        qore_cleanup();
        return 1;
    }
    rc = qore_run_callable(pgm, \"main\", NULL);
    if (rc != 0) {
        fprintf(stderr, \"main failed rc=%d: %s\\n\", rc, qore_last_error(pgm));
    }
    qore_destroy_program(pgm);
    qore_cleanup();
    return rc;
}
");

        string qo_out = run(sprintf(
            "%s %s -c --output-dir=%s --batch-script-aggregate=NATIVE_REGISTER_AGG"
            " --batch-script-aggregate-output=%s --script-aggregate-native-registers %s %s",
            env, qcc_bin, qo_dir, aggregate, provider, consumer));
        assertTrue(qo_out.find("script-context .qo") != -1,
            "batch .qo compile emitted script objects: " + qo_out);
        assertTrue(is_file(aggregate),
            "batch compile emitted native-register script aggregate: " + qo_out);
        string invalid_out = run(sprintf(
            "%s %s -c --output-dir=%s --batch-script-aggregate=MISSING_OUTPUT %s %s",
            env, qcc_bin, qo_dir, provider, consumer));
        assertTrue(invalid_out.find(
                "--batch-script-aggregate and --batch-script-aggregate-output must be used together") != -1,
            "batch aggregate symbol requires an output path: " + invalid_out);
        invalid_out = run(sprintf(
            "%s %s -c --output-dir=%s --batch-script-aggregate-manifest-input=%s %s %s",
            env, qcc_bin, qo_dir, provider, provider, consumer));
        assertTrue(invalid_out.find(
                "--batch-script-aggregate-manifest-input requires --batch-script-aggregate") != -1,
            "batch aggregate manifest input requires aggregate mode: " + invalid_out);

        string aggregate_dump = run(sprintf("%s %s --dump-info --dump-symbols %s",
            env, qcc_bin, aggregate));
        assertTrue(aggregate_dump.find("_script_native_register") != -1,
            "aggregate references per-file native register symbols: " + aggregate_dump);

        string cxx = ENV.CXX ?? "g++";
        # qore-version.h is GENERATED into the build dir (CMAKE_BINARY_DIR/include), not
        # the source include tree, so the host TU (<qore/Qore.h> -> qore-version.h) also
        # needs the build include dir. libqore_dir is the build dir when running in-tree
        # (the CI runs build/qore); a non-existent dir is harmlessly ignored by the
        # compiler for installed layouts whose include tree already has everything.
        string link_out = run(sprintf(
            "LD_LIBRARY_PATH=%s %s -std=c++17 -I%s -I%s %s %s/*.qo %s -L%s -Wl,-rpath,%s -lqore -o %s",
            libqore_dir, cxx, source_root + "/include", libqore_dir + "/include",
            glue, qo_dir, aggregate, libqore_dir, libqore_dir, exe));
        assertTrue(is_file(exe), "linked native-register aggregate host: " + link_out);

        string out = run(sprintf(
            "QORE_AOT_DEBUG_NATIVE_CLOSURES=1 LD_LIBRARY_PATH=%s %s", libqore_dir, exe));
        assertTrue(out.find("registered native closure") != -1,
            "aggregate metadata binds the per-file native closure body: " + out);
        assertTrue(out.find("42\n") != -1,
            "aggregate metadata plus per-file native registers run cross-file closure call: " + out);
    }

    # A native-register aggregate carries declarations only and delegates every body to
    # its linked per-source .qo objects, so its code-variant count is necessarily zero.
    # Reporting a bare "0 Qore code variants" beside a multi-megabyte declaration blob
    # reads as a failed build, so that mode must report what it actually emitted.
    testDeclarationOnlyReporting() {
        TmpDir tmp("qore-aot-script-aggregate-report-");
        string tmp_dir = tmp.path;
        string qo_dir = tmp_dir + "/qo";
        mkdir(qo_dir);

        string src = tmp_dir + "/report.qr";
        write(src, "%modern
int sub report_add(int i, int j) {
    return i + j;
}
");
        string verbose_env = "QORE_AOT_VERBOSE=1 " + env;

        string decl_out = run(sprintf(
            "%s %s -c --script-aggregate=REPORT_DECL_AGG --script-aggregate-native-registers"
            " -o %s %s", verbose_env, qcc_bin, tmp_dir + "/decl-agg.qo", src));
        assertTrue(decl_out.find("declaration metadata for 1 source, no Qore code variants") != -1,
            "declaration-only aggregate reports its declaration source count: " + decl_out);
        assertTrue(decl_out.find("bodies in the linked per-source .qo objects") != -1,
            "declaration-only aggregate says where the bodies live: " + decl_out);
        assertEq(-1, decl_out.find("0 Qore code variants"),
            "declaration-only aggregate never reports a bare zero variant count: " + decl_out);
        assertTrue(decl_out.find("compiled script aggregate .qo (-O3, declarations only)") != -1,
            "verbose standalone aggregate summary names the declaration-only mode: " + decl_out);
        assertEq(-1, decl_out.find("(-O3, 0 variants"),
            "verbose standalone aggregate summary drops the zero variant count: " + decl_out);

        # An aggregate that does lower bodies keeps reporting its real variant count.
        string full_out = run(sprintf(
            "%s %s -c --script-aggregate=REPORT_FULL_AGG -o %s %s",
            verbose_env, qcc_bin, tmp_dir + "/full-agg.qo", src));
        assertTrue(full_out.regex("with metadata for [1-9][0-9]* Qore code variants"),
            "body-lowering aggregate still reports its code-variant count: " + full_out);
        assertTrue(full_out.regex("compiled script aggregate \\.qo \\(-O3, [1-9][0-9]* variants\\)"),
            "verbose body-lowering aggregate summary keeps its variant count: " + full_out);
        assertEq(-1, full_out.find("declaration metadata"),
            "body-lowering aggregate is not reported as declaration-only: " + full_out);

        # The fused batch aggregate reaches the same reporting through compileScriptAggregate;
        # batch mode requires at least two sources, which also covers the plural source count.
        string src2 = tmp_dir + "/report2.qr";
        write(src2, "%modern
int sub report_sub(int i, int j) {
    return i - j;
}
");
        string fused_out = run(sprintf(
            "%s %s -c --output-dir=%s --batch-script-aggregate=REPORT_FUSED_AGG"
            " --batch-script-aggregate-output=%s --script-aggregate-native-registers %s %s",
            verbose_env, qcc_bin, qo_dir, tmp_dir + "/fused-agg.qo", src, src2));
        assertTrue(fused_out.find("declaration metadata for 2 sources, no Qore code variants") != -1,
            "fused declaration-only aggregate reports its declaration source count: " + fused_out);
        assertTrue(fused_out.find(
                "compiled fused script aggregate .qo (-O3, declarations only)") != -1,
            "verbose fused aggregate summary names the declaration-only mode: " + fused_out);
        assertEq(-1, fused_out.find("(-O3, 0 variants"),
            "verbose fused aggregate summary drops the zero variant count: " + fused_out);
    }
}
