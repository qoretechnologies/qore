#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
string libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
string qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
    ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : dirname(qore_bin) + "/qcc");
if (!is_file(qcc_bin)) {
    qcc_bin = "qcc";
}

string provider_source = "%modern

*list<int> sub exactList(list<int> value, bool alternate) {
    return alternate ? value : value;
}

*binary sub exactBinary(binary value, bool alternate) {
    return alternate ? value : value;
}

*list<int> sub maybeList(bool assign) {
    list<int> value;
    if (assign) {
        value = (9, 10);
    }
    return value;
}
";

string consumer_source = "%modern

string sub exactCollectionOps(list<int> list_value, binary binary_value) {
    return sprintf(\"%d:%y:%y:%d:%d\\n%d:%y:%y\",
        exactList(list_value, False).size(),
        exactList(list_value, False).empty(),
        exactList(list_value, False).val(),
        exactList(list_value, False).first(),
        exactList(list_value, False).last(),
        exactBinary(binary_value, False).size(),
        exactBinary(binary_value, False).empty(),
        exactBinary(binary_value, False).val());
}

int sub collectionKernel(list<int> list_value, binary binary_value,
        int rounds) {
    int result = 0;
    for (int i = 0; i < rounds; ++i) {
        bool alternate = i % 2 == 1;
        result += exactList(list_value, alternate).size();
        result += exactList(list_value, alternate).empty();
        result += exactList(list_value, alternate).val();
        result += exactList(list_value, alternate).first();
        result += exactList(list_value, alternate).last();
        result += exactBinary(binary_value, alternate).size();
        result += exactBinary(binary_value, alternate).empty();
        result += exactBinary(binary_value, alternate).val();
    }
    return result;
}

int sub main() {
    list<int> list_value = (1, 2, 3);
    binary binary_value = <01020304>;
    *string rounds_arg = ENV.QORE_EXACT_COLLECTION_ROUNDS;
    int rounds = rounds_arg ? rounds_arg.toInt() : 1000;
    printf(\"%s\\n%d\\n%d\\n\", exactCollectionOps(list_value,
        binary_value), maybeList(True).size(),
        collectionKernel(list_value, binary_value, rounds));
    return 0;
}
";

string root = "/tmp/qore-aot-exact-boxed-collection-" + string(getpid());
string provider_dir = root + "/provider";
string enabled_dir = root + "/enabled";
string disabled_dir = root + "/disabled";
mkdir(root);
mkdir(provider_dir);
mkdir(enabled_dir);
mkdir(disabled_dir);

string provider_path = root + "/provider.qr";
string consumer_path = root + "/consumer.qr";
File provider_file();
provider_file.open2(provider_path, O_WRONLY | O_CREAT | O_TRUNC);
provider_file.write(provider_source);
provider_file.close();
File consumer_file();
consumer_file.open2(consumer_path, O_WRONLY | O_CREAT | O_TRUNC);
consumer_file.write(consumer_source);
consumer_file.close();

string provider_compile = backquote(sprintf(
    "LD_LIBRARY_PATH=%s %s -O3 -c --strip-source --output-dir=%s %s 2>&1",
    libqore_dir, qcc_bin, provider_dir, provider_path));
string provider_qo = provider_dir + "/provider.qo";
if (!is_file(provider_qo)) {
    printf("provider compile failed:\n%s", provider_compile);
    exit(2);
}
unlink(provider_path);

string sub compileConsumer(string output_dir, string env) {
    string output = backquote(sprintf(
        "%s LD_LIBRARY_PATH=%s QORE_IR_OPT_STATS=1 QORE_DISABLE_AOT_BOXED_RETURN_PARAM_CALL_FOLD=1 %s -O3 -c -L %s --output-dir=%s %s 2>&1",
        env, libqore_dir, qcc_bin, provider_dir, output_dir,
        consumer_path));
    if (!is_file(output_dir + "/consumer.qo")) {
        printf("consumer compile failed:\n%s", output);
        exit(2);
    }
    return output;
}

string enabled_compile = compileConsumer(enabled_dir, "");
string disabled_compile = compileConsumer(disabled_dir,
    "QORE_DISABLE_AOT_LATE_COLLECTION_SPECIALIZATION=1");
# list.size() is already a dedicated ListSize opcode; the other seven calls are pseudo-methods.
if (!(enabled_compile =~ /IR-OPT-AOT-EFFECTS: exactCollectionOps[^:]*:.*exact-boxed-call-facts=8.*collection-specializations=7/)
        || !(enabled_compile =~ /IR-OPT-AOT-EFFECTS: collectionKernel[^:]*:.*exact-boxed-call-facts=8.*collection-specializations=7/)
        || !(enabled_compile =~ /IR-OPT-AOT-EFFECTS: main[^:]*:.*exact-boxed-call-facts=1/)
        || disabled_compile =~ /collection-specializations=[1-9]/) {
    printf("unexpected exact collection specialization stats (qcc: %s):\nenabled:\n%sdisabled:\n%s",
        qcc_bin, enabled_compile, disabled_compile);
    exit(2);
}

string sub link(string output, string consumer_qo) {
    string link_out = backquote(sprintf(
        "LD_LIBRARY_PATH=%s %s -O3 -o %s %s %s 2>&1",
        libqore_dir, qcc_bin, output, provider_qo, consumer_qo));
    if (!is_file(output)) {
        printf("link failed:\n%s", link_out);
        exit(2);
    }
    return output;
}

string expected = "3:False:True:1:3\n4:False:True\n2\n13000\n";
foreach string path in ((link(root + "/enabled-exe",
        enabled_dir + "/consumer.qo"), link(root + "/disabled-exe",
        disabled_dir + "/consumer.qo"))) {
    string actual = backquote(sprintf("LD_LIBRARY_PATH=%s %s 2>&1",
        libqore_dir, path));
    if (actual != expected) {
        printf("AOT mismatch for %s:\nexpected:\n%sactual:\n%s",
            path, expected, actual);
        exit(2);
    }
}

exit(0);
