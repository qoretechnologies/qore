#!/usr/bin/env qore
# test-platform: macos - native qcc linking and iconv conversion of tagged source and switch values
# Copyright (c) 2026 Qore Technologies, s.r.o.
# SPDX-License-Identifier: MIT
#
# A switch on a string value whose cases are ASCII strings, which the compiled tiers dispatch with a string lookup,
# compares the value with the cases as the AST interpreter does: with the value's encoding and length, so a UTF-16
# value matches the case with its characters and a value with a null byte after a case does not match the case; a
# value that cannot be converted for the comparison is not the case (and "case ==" raises the conversion error), and
# a constant case in another encoding is compared with its characters; the bytes of ASCII characters in an encoding in
# which they are other characters, or that iconv does not know, are not the case; and a string with a null byte or in
# another encoding keeps them in AOT code, in a case and elsewhere (SwitchStringEncoding.qr, in every execution mode and
# as qcc executables)
%modern
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires ../TestInterpreter.qm
%requires FsUtil
%exec-class SwitchStringEncodingTest

class SwitchStringEncodingTest inherits QUnit::Test {
    private {
        string qore = realpath(TestInterpreter::qore_interpreter());
        string libdir = realpath(ENV.QORE_LIBDIR ?? dirname(qore));
        string qcc = ENV.QCC ?? libdir + "/qcc";
        string source = get_script_dir() + "/SwitchStringEncoding.qr";
        string expected;
    }

    constructor() : Test("switch string encoding", "1.0", \ARGV) {
        addTestCase("AST reference output", \astOutput());
        addTestCase("execution modes", \executionModes());
        addTestCase("AOT", \aot());
        addTestCase("source and image literal encodings", \sourceLiterals());
        addTestCase("regex result encodings", \regexEncodings());
        addTestCase("UTF-8 files and stdin", \fileEncoding());
        addTestCase("whole source validation", \wholeSource());
        set_return_value(main());
    }

    private static string quote(string value) {
        return "'" + replace(value, "'", "'\"'\"'") + "'";
    }

    private string run(list<string> args, string prefix = "", bool expect_error = False) {
        int status;
        string output = backquote(prefix + "LD_LIBRARY_PATH=" + quote(libdir)
            + " DYLD_LIBRARY_PATH=" + quote(libdir) + " "
            + (map quote($1), args).join(" ") + " 2>&1", \status);
        if (expect_error) {
            assertTrue(status != 0, output);
        } else {
            assertEq(0, status, output);
        }
        return output;
    }

    regexEncodings() {
        string probe = get_script_dir() + "/utf8-source-literals/regex-results.q";
        string expected = "regex encodings passed\n";
        foreach string charset in ("ISO-8859-1", "UTF-8") {
            string env = "QORE_CHARSET=" + charset + " QORE_JIT_SYNC_COMPILE=1 QORE_IR_THRESHOLD=1 QORE_JIT_THRESHOLD=1 ";
            foreach string mode in ("ast", "ir", "jit", "tiered") {
                assertEq(expected, run((qore, "-b", "--exec-mode=" + mode, probe), env), mode);
            }
            foreach string opt in ("-O0", "-O3") {
                TmpDir tmp("qore-regex-result-encoding-");
                string exe = tmp.path + "/probe";
                run((qcc, opt, "-o", exe, probe), env);
                assertEq(expected, run((exe, "-b"), env), opt);
            }
        }
    }

    sourceLiterals() {
        string dir = get_script_dir() + "/utf8-source-literals";
        string probe = dir + "/probe.q";
        string out = "UTF-8 1 True\nUTF-8 1 True\nUTF-8 1 True\nUTF-8 1 True\n"
            "UTF-8 1 True\nUTF-8 3 True\nTrue\nTrue\n";
        string module_out = "UTF-8 3 True\nUTF-8 1 True\nISO-8859-1 1 True\n";
        string latin = "QORE_CHARSET=ISO-8859-1 ";
        string tiers = "QORE_JIT_SYNC_COMPILE=1 QORE_IR_THRESHOLD=1 QORE_JIT_THRESHOLD=1 ";
        foreach string mode in ("ast", "ir", "jit", "tiered") {
            assertEq(out, run((qore, "-b", "--exec-mode=" + mode, probe), latin + tiers), mode);
        }
        foreach string opt in ("-O0", "-O3") {
            TmpDir tmp("qore-source-literal-encoding-");
            string module_env = "QORE_MODULE_DIR=" + quote(tmp.path) + " ";
            run((qcc, opt, "-o", tmp.path + "/SourceText.qmod", dir + "/SourceText.qm"), "QORE_CHARSET=UTF-8 ");
            string caller = tmp.path + "/module-probe.q";
            copy_file(dir + "/module-probe.q", caller);
            assertEq(module_out, run((qore, "-b", "--exec-mode=ast", caller), latin + module_env), opt + " module");
            string exe = tmp.path + "/image";
            run((qcc, opt, "-o", exe, caller), "QORE_CHARSET=UTF-8 " + module_env);
            assertEq(module_out, run((exe, "-b"), latin + module_env), opt + " compiled module caller");
            run((qcc, opt, "-o", exe, probe), "QORE_CHARSET=UTF-8 ");
            assertEq(out, run((exe, "-b"), latin), opt + " tagged parser input");
        }
    }

    private checkInvalid(list<string> args, string location, string prefix = "") {
        string out = run(args, prefix, True);
        assertTrue(out.find("invalid UTF-8 in source") >= 0, out);
        assertTrue(out.find(location) >= 0, out);
    }

    fileEncoding() {
        TmpDir dir("qore-unlabelled-source-");
        string path = dir.path + "/file.q";
        foreach binary bytes in (<e9>, <c3a9>) {
            FileOutputStream file(path);
            file.write(binary("%modern\nstring s = '"));
            file.write(bytes);
            file.write(binary("'; printf(\"%s %d\\n\", s.encoding(), length(s));\n"));
            file.close();
            if (bytes.size() == 1) {
                foreach string mode in ("ast", "ir", "jit", "tiered") {
                    checkInvalid((qore, "-b", "--charset=ISO-8859-1", "--exec-mode=" + mode, path), path + ":2");
                }
                checkInvalid((qore, "-b", "--charset=ISO-8859-1"), "<stdin>:2", "<" + quote(path) + " ");
                foreach string opt in ("-O0", "-O3") {
                    checkInvalid((qcc, opt, "-o", dir.path + "/invalid", path), path + ":2");
                }
            } else {
                foreach string mode in ("ast", "ir", "jit", "tiered") {
                    assertEq("UTF-8 1\n", run((qore, "-b", "--charset=ISO-8859-1", "--exec-mode=" + mode, path),
                        "QORE_JIT_SYNC_COMPILE=1 QORE_IR_THRESHOLD=1 QORE_JIT_THRESHOLD=1 "), "converted " + mode);
                }
                assertEq("UTF-8 1\n", run((qore, "-b"), "<" + quote(path) + " QORE_CHARSET=ISO-8859-1 "), "stdin");
                foreach string opt in ("-O0", "-O3") {
                    string exe = dir.path + "/image";
                    run((qcc, opt, "-o", exe, path));
                    assertEq("UTF-8 1\n", run((exe, "-b"), "QORE_CHARSET=ISO-8859-1 "), opt + " image");
                }
            }
        }

        # Start a four-byte character at the end of an input block. Comments
        # are validated too, including a partial character at physical EOF.
        foreach binary seq in (<f09f9880>, <f09f98>, <f09f9841>, <eda080>, <c080>, <f4908080>) {
            FileOutputStream file(path);
            file.write(binary("%modern\n#" + sprintf("%16374s", "")));
            file.write(seq);
            file.close();
            if (seq == <f09f9880>) {
                assertEq("", run((qore, "-b", path)), "split UTF-8 character");
            } else {
                checkInvalid((qore, "-b", path), path + ":2");
            }
        }
        string inc = dir.path + "/include.qi";
        FileOutputStream file(inc);
        file.write(binary("string sub inside() { return '"));
        file.write(<c3a9>);
        file.write(binary("'; }\n"));
        file.close();
        string fragment = dir.path + "/literal.qi";
        FileOutputStream literal(fragment);
        literal.write(<27c3a9270a>);
        literal.close();
        string child = get_script_dir() + "/utf8-source-literals/include-probe.q";
        assertEq("UTF-8 1\nUTF-8 1\nUTF-8 3\nTrue\n",
            run((qore, "-b", "--charset=ISO-8859-1", child, inc, fragment)),
            "include inside tagged UTF-8 Program source");

        FileOutputStream broken(inc);
        broken.write(binary("# line 1\n# "));
        broken.write(<ff>);
        broken.close();
        checkInvalid((qore, "-b", child, inc, fragment), inc + ":2");

        # A failed refill in the middle of an included literal is an encoding error at the physical line.
        FileOutputStream large(inc);
        large.write(binary("# first line\nstring s = \"" + sprintf("%32768s", "")));
        large.write(<ff>);
        large.close();
        FileOutputStream outer(path);
        outer.write(binary("%modern\n%include include.qi\n%include must-not-resume.qi\n"));
        outer.close();
        foreach list<string> args in ((qore, "-b", path), (qcc, "-O0", "-o", dir.path + "/invalid", path)) {
            string out = run(args, "", True);
            assertTrue(out.find(inc + ":2") >= 0, out);
            assertTrue(out.find("invalid UTF-8 in source") >= 0, out);
            assertFalse(out.find("unexpected end of file in string literal") >= 0, out);
            assertFalse(out.find("must-not-resume.qi") >= 0, out);
        }

        FileOutputStream errors(path);
        errors.write(binary("%exec-class\n#" + sprintf("%32768s", "") + "\n#"));
        errors.write(<ff>);
        errors.close();
        string both = run((qore, "-b", path), "", True);
        assertTrue(both.find("missing argument to %exec-class") >= 0, both);
        assertTrue(both.find(path + ":3") >= 0, both);
        assertTrue(both.find("invalid UTF-8 in source") >= 0, both);

        string accented = dir.path + "/café.qi";
        FileOutputStream named(accented);
        named.write(binary("int sub fromFile() { return 7; }\n"));
        named.close();
        string including = dir.path + "/including.q";
        FileOutputStream source(including);
        source.write(binary("%modern\n%include café.qi\nprintf(\"%d\\n\", fromFile());\n"));
        source.close();
        foreach string charset in ("UTF-8", "ISO-8859-1") {
            assertEq("7\n", run((qore, "-b", "--charset=" + charset, including)), "UTF-8 include spelling");
            assertEq("7\n", run((qore, "-b", "--charset=" + charset,
                get_script_dir() + "/utf8-source-literals/named-include.q", dir.path)), "tagged include filename");
        }
    }

    wholeSource() {
        # A NUL in a comment must not hide malformed bytes later in memory-backed input.
        string label = "tagged-source";
        Program pgm(PO_NEW_STYLE);
        *hash<ExceptionInfo> error;
        try {
            pgm.parse(binary_to_string(<2320636f6d6d656e7400ff>, "UTF-8"), label);
        } catch (hash<ExceptionInfo> ex) {
            error = ex;
        }
        assertTrue(exists error, "invalid UTF-8 after NUL in Program source");
        assertEq("PARSE-EXCEPTION", error.err);
        assertEq(label, error.file);
        assertEq(1, error.line);
        assertTrue(error.desc.find("invalid UTF-8 in source") >= 0, error.desc);

        TmpDir tmp("qore-invalid-module-");
        string dir = tmp.path + "/SourceText";
        mkdir(dir);
        string main = dir + "/SourceText.qm";
        string module = get_script_dir() + "/utf8-source-literals/SourceText.qm";
        copy_file(module, main);
        string worker = tmp.path + "/load.q";
        FileOutputStream code(worker);
        code.write(binary("%modern\n%requires SourceText\n"));
        code.close();
        string env = "QORE_CHARSET=ISO-8859-1 QORE_MODULE_DIR=" + quote(tmp.path) + " ";
        foreach string file in (main, dir + "/Invalid.qc") {
            if (file != main) {
                copy_file(module, main, False, True);
            }
            FileOutputStream append(file, True);
            append.write(binary("\n# "));
            append.write(<00ff>);
            append.close();
            checkInvalid((qore, "-b", worker), file + ":", env);
            checkInvalid((qcc, "-O0", "-o", tmp.path + "/out.qmod", dir), file + ":", env);
            if (file == main) {
                checkInvalid((qcc, "-O3", "-o", tmp.path + "/out.qmod", main), file + ":", env);
            }
        }
    }

    private string getExpected() {
        if (!expected) {
            expected = run((qore, "--exec-mode=ast", source));
        }
        return expected;
    }

    astOutput() {
        string out = getExpected();
        # 3 rounds of 19 values
        assertEq(57, (select out.split("\n"), $1 =~ / typed=/).size());
        # and of the values for the conversion cases, which depend on the encodings of the platform's iconv
        int conv = (select out.split("\n"), $1 =~ / try=/).size();
        assertEq(0, conv % 3);
        assertGe(3 * 20, conv);
        # a value in another encoding matches the case with its characters
        assertRegex("\n0 UTF-16LE !!binary YQBiAGMA: typed=abc lwr=abc auto=abc\n", out, "UTF-16LE abc");
        assertRegex("\n0 UTF-16BE !!binary AGEAYgBj: typed=abc lwr=abc auto=abc\n", out, "UTF-16BE abc");
        assertRegex("\n0 UTF-16LE !!binary QQBCAEMA: typed=default lwr=abc auto=default\n", out, "UTF-16LE ABC");
        assertRegex("\n0 ISO-8859-1 !!binary YWJj: typed=abc lwr=abc auto=abc\n", out, "ISO-8859-1 abc");
        # a value with a null byte after a case is not the case
        assertRegex("\n0 UTF-8 !!binary YQA=: typed=default lwr=default auto=default\n", out, "a\\0");
        assertRegex("\n0 UTF-8 !!binary YWJjAA==: typed=default lwr=default auto=default\n", out, "abc\\0");
        assertRegex("\n0 UTF-8 !!binary QQA=: typed=default lwr=default auto=default\n", out, "A\\0");
        # a prefix or an extension of a case is not the case
        assertRegex("\n0 UTF-8 !!binary YWI=: typed=default lwr=default auto=default\n", out, "ab");
        assertRegex("\n0 UTF-8 !!binary YWJjZA==: typed=default lwr=default auto=default\n", out, "abcd");
        # an empty string in any encoding is the empty case
        assertRegex("\n0 UTF-16LE !!binary : typed=empty lwr=empty auto=empty\n", out, "UTF-16LE empty");
        # a value with a changed byte or an extension of a case is no case, and a prefix is the case that it is
        string lens;
        foreach list<string> c in ((("4", "default"), ("7", "default"), ("8", "7"), ("9", "8"), ("15", "default"),
                ("16", "15"), ("17", "16"), ("20", "default"))) {
            lens += sprintf(" %s default default default %s default %s", c[0], c[1], c[0]);
        }
        assertRegex("\n0 lengths:" + lens + "\n", out, "case lengths");
        # the bytes of a case are not the case in an encoding that iconv does not know, and are in an ASCII superset
        assertRegex("\n0 NO-SUCH-ENCODING !!binary YQ==: try=default ", out, "unknown encoding");
        assertRegex("\n0 ISO-8859-1 !!binary XA==: try=bs ", out, "ISO-8859-1 backslash");
        assertRegex("\n0 US-ASCII !!binary YQ==: try=a ", out, "US-ASCII a");
        # cases folded to a string with a null byte or in another encoding
        assertRegex("\n0 UTF-8 !!binary YQ==: folded=a\n", out, "a is not the case with a null byte");
        assertRegex("\n0 UTF-8 !!binary YQBi: folded=nul-literal\n", out, "literal null byte");
        assertRegex("\n0 UTF-8 !!binary YWM=: folded=utf16\n", out, "folded UTF-16 case");
        assertRegex("\n0 UTF-16BE !!binary AGEAYw==: folded=utf16\n", out, "folded UTF-16 case, UTF-16BE value");
        assertRegex("\n0 UTF-8 !!binary eAB5eg==: folded=nul\n", out, "folded case with a null byte");
        assertRegex("\n0 UTF-8 !!binary eAB5: folded=default\n", out, "prefix of a folded case");
        # the same strings outside a switch keep their encoding and null bytes
        assertRegex("\n0 nonswitch: UTF-16LE !!binary YQBjAA== \\| UTF-8 !!binary cABx \\| UTF-8 !!binary "
            "cHFyc3R1dnd4eXoAcQ== \\| UTF-16LE !!binary YQBkAA== \\| UTF-16LE !!binary YQBlAA== \\| UTF-8 !!binary eAB5 "
            "\\| UTF-16LE !!binary YQBmAA== \\| UTF-8 !!binary dQB2 \\| UTF-8 !!binary cwB0 \\| UTF-16LE !!binary "
            "YQBnAA== \\| UTF-8 !!binary bQBu\n", out, "strings outside a switch");
        # a value that cannot be converted for a comparison with a plain case is not the case, and the switch raises
        # no exception (as QoreValue::isEqualHard() compares them); "case ==" raises the conversion error
        assertRegex("\n0 ISO-2022-JP !!binary GyRC/w==: try=default eq=EX ENCODING-CONVERSION-ERROR const=default\n",
            out, "invalid ISO-2022-JP");
        # the iconv of musl has no UTF-7: a UTF-7 value or case can then be compared with no case in another encoding
        *string utf7_plus;
        try {
            utf7_plus = convert_encoding("+", "UTF-7");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("ENCODING-CONVERSION-ERROR", ex.err);
        }
        bool have_utf7 = exists utf7_plus;
        if (have_utf7) {
            # UTF-7 encodes "+" as "+-"
            assertEq(binary("+-"), binary(utf7_plus), "UTF-7 \"+\"");
            assertRegex("\n0 UTF-7 !!binary K/8=: try=default eq=EX ENCODING-CONVERSION-ERROR const=default\n", out,
                "invalid UTF-7");
            # a constant case in another encoding is compared with its characters: UTF-7 "+" is "+-"
            assertRegex("\n0 UTF-8 !!binary Kw==: try=plus eq=eq-plus const=utf7-plus\n", out, "UTF-8 +");
            assertRegex("\n0 UTF-7 !!binary Ky0=: try=plus eq=eq-plus const=utf7-plus\n", out, "UTF-7 +");
        } else {
            # the UTF-7 constant case cannot be converted for the comparison, so it is not taken
            assertRegex("\n0 UTF-8 !!binary Kw==: try=plus eq=eq-plus const=default\n", out, "UTF-8 + without UTF-7");
        }
        assertRegex("\n0 UTF-8 !!binary Ky0=: try=default eq=default const=default\n", out, "UTF-8 +-");
        # the SHIFT_JIS constant is U+00A5, not "\\", where iconv's SHIFT_JIS has the yen sign at that byte (libiconv,
        # glibc); in musl's, the byte is "\\"
        bool sjis_backslash = convert_encoding(force_encoding("\\", "SHIFT_JIS"), "UTF-8") == "\\";
        assertRegex("\n0 UTF-8 !!binary XA==: try=bs eq=eq-bs const=" + (sjis_backslash ? "sjis-yen" : "default")
            + "\n", out, "UTF-8 \\");
        # a UTF-16LE class constant and a UTF-7 constant declared after the function
        assertRegex("\n0 UTF-8 !!binary YWI=: try=default eq=default const=utf16-ab\n", out, "UTF-8 ab");
        assertRegex("\n0 UTF-8 !!binary YSs=: try=default eq=default const=" + (have_utf7 ? "utf7-a" : "default")
            + "\n", out, "UTF-8 a+");
    }

    executionModes() {
        string exp = getExpected();
        foreach string mode in (("ir", "jit", "tiered")) {
            foreach string control in (("", "QORE_JIT_SYNC_COMPILE=1 ",
                    "QORE_JIT_SYNC_COMPILE=1 QORE_IR_THRESHOLD=1 QORE_JIT_THRESHOLD=1 ")) {
                assertEq(exp, run((qore, "--exec-mode=" + mode, source), control), control + mode);
            }
        }
    }

    aot() {
        string exp = getExpected();
        TmpDir dir("qore-switch-string-encoding-");
        # QORE_AOT_EH is read when the code is compiled
        foreach string prefix in (("", "QORE_AOT_EH=1 ")) {
            foreach string level in (("-O0", "-O3")) {
                string executable = dir.path + "/fixture";
                run((qcc, level, "-o", executable, source), prefix);
                assertEq(exp, run((executable,)), prefix + level);
            }
        }
    }
}
