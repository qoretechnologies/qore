        write(consumer_src,
            "%new-style\n"
            "hash<AOTDeferredConstructInfo> sub aot_make_hashdecl_constructor() {\n"
            "    hash<AOTDeferredConstructInfo> h();\n"
            "    h.name = \"constructed\";\n"
            "    return h;\n"
            "}\n");
