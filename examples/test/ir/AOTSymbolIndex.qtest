            "%new-style\n"
            "hashdecl AOTDeferredConstructInfo {\n"
            "    string name;\n"
            "}\n");
        write(main_src,
            "%new-style\n"
            "int sub main() {\n"
            "    printf(\"%s\\n\", aot_make_hashdecl_constructor().name);\n"
