#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
%exec-class BenchmarkRunner

# Copyright (c) 2026 Qore Technologies, s.r.o.
# SPDX-License-Identifier: MIT


# Benchmark script to compare all execution modes: AST, IR, tiered, JIT, AOT
#
# Usage:
#   LD_LIBRARY_PATH=build-release qore examples/test/ir/benchmark_exec_modes.qr
#   QORE_BIN=build-release/qore LD_LIBRARY_PATH=build-release qore examples/test/ir/benchmark_exec_modes.qr
#
# Environment variables:
#   QORE_BIN         Path to the qore binary to benchmark (default: argv[0] or "qore")
#   LD_LIBRARY_PATH  Library path for the qore binary
#   BENCH_MODES      Comma-separated list of modes to run (default: ast,ir,tiered,jit,aot)
#   BENCH_ITERS      Base iteration count (default: 10000000 for extended benchmarks)
#   BENCH_SAMPLES    Timed process samples per mode (default: 5)
#   BENCH_WARMUP     Untimed process warmups per mode (default: 1)
#   BENCH_TESTS      Optional comma-separated list of benchmark names
#
# Note: This is the extended benchmark suite with 10x longer iterations for more
# reliable measurements. Compilation time is separated from execution time for AOT.

const DEFAULT_ITERATIONS = 10000000;  # 10x longer than original (1M -> 10M)

hash<auto> sub run_benchmark(string name, string code, string mode, string qore_bin, string ld_path,
        int samples, int warmup) {
    # Write code to temp file
    string tmp = sprintf("/tmp/bench_%s.qr", name);
    {
        File f();
        f.open(tmp, O_CREAT | O_WRONLY | O_TRUNC);
        f.write(code);
    }

    string cmd;
    float compile_ms = 0.0;

    if (mode == "aot") {
        # For AOT, measure compilation and execution separately
        string qcc_bin = regex_subst(qore_bin, "qore$", "qcc");
        string aot_exe = sprintf("/tmp/bench_%s_aot", name);
        string compile_cmd = sprintf("LD_LIBRARY_PATH=%s %s -o %s %s 2>/dev/null",
            ld_path, qcc_bin, aot_exe, tmp);

        # Time the compilation
        date compile_start = now_us();
        system(compile_cmd);
        date compile_end = now_us();
        compile_ms = (compile_end - compile_start).durationMicroseconds() / 1000.0;

        cmd = sprintf("LD_LIBRARY_PATH=%s %s 2>/dev/null", ld_path, aot_exe);
    } else {
        cmd = sprintf("LD_LIBRARY_PATH=%s %s --exec-mode=%s %s 2>/dev/null",
            ld_path, qore_bin, mode, tmp);
    }

    for (int i = 0; i < warmup; ++i) {
        backquote(cmd);
    }

    list<float> timings;
    bool samples_match = True;
    string first_output;
    for (int i = 0; i < samples; ++i) {
        date start = now_us();
        string sample_output = trim(backquote(cmd));
        date end = now_us();
        timings += (end - start).durationMicroseconds() / 1000.0;
        if (!i) {
            first_output = sample_output;
        } else if (sample_output != first_output) {
            samples_match = False;
        }
    }

    list<auto> sorted = sort(timings);
    float median_ms = samples % 2
        ? sorted[samples / 2].toFloat()
        : (sorted[samples / 2 - 1].toFloat() + sorted[samples / 2].toFloat()) / 2.0;
    float sum_ms = 0.0;
    foreach float timing in (timings) {
        sum_ms += timing;
    }
    float mean_ms = sum_ms / samples;
    float sq_sum = 0.0;
    foreach float timing in (timings) {
        sq_sum += (timing - mean_ms) * (timing - mean_ms);
    }

    return {
        "elapsed_ms": median_ms,
        "stdev_ms": sqrt(sq_sum / samples),
        "compile_ms": compile_ms,  # Only non-zero for AOT
        "output": first_output,
        "samples_match": samples_match,
    };
}

class BenchmarkRunner {
    constructor() {
        main();
    }

    private main() {
        int iterations = int(ENV.BENCH_ITERS ?? DEFAULT_ITERATIONS);
        int samples = int(ENV.BENCH_SAMPLES ?? 5);
        int warmup = int(ENV.BENCH_WARMUP ?? 1);
        if (samples <= 0 || warmup < 0) {
            stderr.printf("BENCH_SAMPLES must be positive and BENCH_WARMUP must be non-negative\n");
            exit(2);
        }

    # ==========================================================================
    # Test 1: Simple integer loop (baseline - tests typed int ops)
    # ==========================================================================
    string loop_code = sprintf("%%modern
int sum = 0;
for (int i = 0; i < %d; ++i) {
    sum += i;
}
printf(\"%%d\\n\", sum);
", iterations);

    # ==========================================================================
    # Test 2: Recursive fibonacci (tests deep call stack with CallDirect)
    # ==========================================================================
    string fib_code = "%modern
int sub fib(int n) {
    if (n <= 1) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}
printf(\"%d\\n\", fib(30));
";

    # ==========================================================================
    # Test 3: self.method() calls on final class (CallMethodDirect)
    # ==========================================================================
    string self_method_code = sprintf("%%modern

final class SelfAccum {
    public {
        int total = 0;
    }

    int add(int x) {
        total += x;
        return total;
    }

    int compute() {
        int result = 0;
        for (int i = 0; i < %d; ++i) {
            result = self.add(1);
        }
        return result;
    }
}

SelfAccum a();
printf(\"%%d\\n\", a.compute());
", iterations / 10);

    # ==========================================================================
    # Test 3b: final method in a non-final class
    # ==========================================================================
    string final_method_code = sprintf("%%modern

class FinalMethodAccum {
    private {
        int total = 0;
    }

    final int add(int x) {
        total += x;
        return total;
    }

    int compute() {
        int result = 0;
        for (int i = 0; i < %d; ++i) {
            result = self.add(1);
        }
        return result;
    }
}

FinalMethodAccum a();
printf(\"%%d\\n\", a.compute());
", iterations / 10);

    # ==========================================================================
    # Test 4: obj.method() calls - DotEvalMethodDirect
    # ==========================================================================
    string dot_eval_code = sprintf("%%modern

class MyProcessor {
    private {
        int count = 0;
    }

    int process(int x) {
        count += x;
        return count;
    }

    int getCount() {
        return count;
    }
}

MyProcessor p();
int result = 0;
for (int i = 0; i < %d; ++i) {
    result = p.process(1);
}
printf(\"%%d\\n\", result);
", iterations / 10);

    # ==========================================================================
    # Test 4b: guarded non-final obj.method() call with a context-free body
    # ==========================================================================
    string dot_eval_pure_code = sprintf("%%modern

class PureProcessor {
    int process(int x) {
        return x * 3 + 1;
    }
}

PureProcessor p();
int result = 0;
for (int i = 0; i < %d; ++i) {
    result += p.process(i %% 7);
}
printf(\"%%d\\n\", result);
", iterations / 10);

    # ==========================================================================
    # Test 5: obj.method() in try/catch - InvokeDotEvalMethodDirect
    # ==========================================================================
    string dot_eval_try_code = sprintf("%%modern

class MyCounter {
    private {
        int val = 0;
    }

    int increment(int x) {
        val += x;
        return val;
    }
}

MyCounter c();
int result = 0;
for (int i = 0; i < %d; ++i) {
    try {
        result = c.increment(1);
    } catch (hash<auto> ex) {
        # won't happen
    }
}
printf(\"%%d\\n\", result);
", iterations / 10);

    # ==========================================================================
    # Test 6: Static method calls - CallStaticDirect
    # ==========================================================================
    string static_call_code = sprintf("%%modern

class MathHelper {
    static int square(int x) {
        return x * x;
    }

    static int add(int a, int b) {
        return a + b;
    }
}

int sum = 0;
for (int i = 0; i < %d; ++i) {
    sum = MathHelper::add(sum, MathHelper::square(i %% 100));
}
printf(\"%%d\\n\", sum);
", iterations / 10);

    # ==========================================================================
    # Test 7: Functional operators - foldl
    # ==========================================================================
    string foldl_code = sprintf("%%modern
list<int> nums = range(%d);
int sum = (foldl $1 + $2, nums, 0);
printf(\"%%d\\n\", sum);
", iterations);

    # ==========================================================================
    # Test 8: Functional operators - map (int list)
    # ==========================================================================
    string map_int_code = sprintf("%%modern
list<int> nums = range(%d);
list<int> doubled = (map $1 * 2, nums);
printf(\"%%d\\n\", doubled.size());
", iterations / 10);

    # ==========================================================================
    # Test 9: map expression over list<hash<auto>> (hash key access pattern)
    # ==========================================================================
    string map_hash_expr_code = sprintf("%%modern
list<hash<auto>> sub build_data(int n) {
    list<hash<auto>> data = ();
    for (int i = 0; i < n; ++i) {
        push data, {\"name\": \"item\" + string(i), \"value\": i, \"score\": i * 1.5};
    }
    return data;
}
list<hash<auto>> data = build_data(%d);
list<auto> vals = (map $1.value + 1, data);
printf(\"%%d\\n\", vals.size());
", iterations / 10);

    # ==========================================================================
    # Test 9b: repeated hash-key map over prebuilt data
    # ==========================================================================
    string map_hash_lookup_code = sprintf("%%modern
list<hash<auto>> sub build_data(int n) {
    list<hash<auto>> data = ();
    for (int i = 0; i < n; ++i) {
        push data, {\"value\": i};
    }
    return data;
}
list<hash<auto>> data = build_data(10000);
int total = 0;
for (int i = 0; i < %d; ++i) {
    list<auto> vals = (map $1.value + 1, data);
    total += vals[0] + vals[-1];
}
printf(\"%%d\\n\", total);
", iterations / 10000);

    # ==========================================================================
    # Test 9c: direct function with guarded typed hash-key arithmetic
    # ==========================================================================
    string function_hash_expression_code = sprintf("%%modern
int sub project(hash<string, int> row, int delta) {
    return row.value * 3 + delta;
}
hash<string, int> row = {\"value\": 7};
int total = 0;
for (int i = 0; i < %d; ++i) {
    total += project(row, i %% 5);
}
printf(\"%%d\\n\", total);
", iterations / 10);

    # ==========================================================================
    # Test 10: map hash body over list<hash<auto>> (hash remapping pattern)
    # ==========================================================================
    string map_hash_body_code = sprintf("%%modern
hash<auto> sub remap(hash<auto> h) { return {\"n\": h.name, \"v\": h.value}; }
list<hash<auto>> sub build_data(int n) {
    list<hash<auto>> data = ();
    for (int i = 0; i < n; ++i) {
        push data, {\"name\": \"item\" + string(i), \"value\": i, \"score\": i * 1.5};
    }
    return data;
}
list<hash<auto>> data = build_data(%d);
list<hash<auto>> result = (map remap($1), data);
printf(\"%%d\\n\", result.size());
", iterations / 10);

    # ==========================================================================
    # Test 11: select with hash predicate
    # ==========================================================================
    string select_hash_code = sprintf("%%modern
list<hash<auto>> sub build_data(int n) {
    list<hash<auto>> data = ();
    for (int i = 0; i < n; ++i) {
        push data, {\"name\": \"item\" + string(i), \"value\": i, \"active\": i %% 2 == 0};
    }
    return data;
}
list<hash<auto>> data = build_data(%d);
list<hash<auto>> result = (select data, $1.value > 0);
printf(\"%%d\\n\", result.size());
", iterations / 10);

    # ==========================================================================
    # Test 11b: repeated hash predicate over prebuilt data
    # ==========================================================================
    string select_hash_lookup_code = sprintf("%%modern
list<hash<auto>> sub build_data(int n) {
    list<hash<auto>> data = ();
    for (int i = 0; i < n; ++i) {
        push data, {\"value\": i};
    }
    return data;
}
list<hash<auto>> data = build_data(10000);
int total = 0;
for (int i = 0; i < %d; ++i) {
    list<hash<auto>> result = (select data, $1.value > 0);
    total += result.size();
}
printf(\"%%d\\n\", total);
", iterations / 10000);

    # ==========================================================================
    # Test 12: closure basic - closure captures variable, called in tight loop
    # ==========================================================================
    string closure_basic_code = sprintf("%%modern
int base = 100;
code add_base = int sub(int x) { return x + base; };
int sum = 0;
for (int i = 0; i < %d; ++i) {
    sum += add_base(i);
}
printf(\"%%d\\n\", sum);
", iterations / 10);

    # ==========================================================================
    # Test 13: closure write-back - closure modifies captured variable
    # ==========================================================================
    string closure_writeback_code = sprintf("%%modern
int counter = 0;
code inc = sub() { ++counter; };
for (int i = 0; i < %d; ++i) {
    inc();
}
printf(\"%%d\\n\", counter);
", iterations / 10);

    # ==========================================================================
    # Test 14: closure over loop variable - each iteration captures its own binding
    # (fixed: IR now properly creates a fresh CVV per loop iteration)
    # ==========================================================================
    string closure_loop_var_code = sprintf("%%modern
list<code> closures = ();
for (int i = 0; i < %d; ++i) {
    int captured = i;
    closures += int sub() { return captured; };
}
int sum = (foldl $1 + $2, (map $1(), closures), 0);
printf(\"%%d\\n\", sum);
", iterations / 100);

    # ==========================================================================
    # Test 15: closure as comparator - closure used as sort/map callback
    # ==========================================================================
    string closure_callback_code = sprintf("%%modern
int multiplier = 3;
code triple = int sub(int x) { return x * multiplier; };
int sum = 0;
for (int i = 0; i < %d; ++i) {
    sum += triple(i %% 1000);
}
printf(\"%%d\\n\", sum);
", iterations / 10);

    # ==========================================================================
    # Test 16: noncapturing scalar closure - typed direct-closure candidate
    # ==========================================================================
    string closure_noncapturing_code = sprintf("%%modern
code<int(int)> increment = int sub(int x) { return x + 2; };
int sum = 0;
for (int i = 0; i < %d; ++i) {
    sum += increment(i);
}
printf(\"%%d\\n\", sum);
", iterations / 10);

    # ==========================================================================
    # Tests 17-18: equivalent nonleaf direct function and closure bodies
    # ==========================================================================
    string function_noncapturing_branch_code = sprintf("%%modern
int sub transform(int x) {
    int value = x + 1;
    if (value %% 2) {
        value *= 3;
    } else {
        value += 7;
    }
    return value * value - x;
}
int sum = 0;
for (int i = 0; i < %d; ++i) {
    sum += transform(i %% 1000);
}
printf(\"%%d\\n\", sum);
", iterations / 10);

    string closure_noncapturing_branch_code = sprintf("%%modern
code<int(int)> transform = int sub(int x) {
    int value = x + 1;
    if (value %% 2) {
        value *= 3;
    } else {
        value += 7;
    }
    return value * value - x;
};
int sum = 0;
for (int i = 0; i < %d; ++i) {
    sum += transform(i %% 1000);
}
printf(\"%%d\\n\", sum);
", iterations / 10);

    hash<string, string> tests = {
        "loop": loop_code,
        "fibonacci": fib_code,
        "self_method": self_method_code,
        "final_method": final_method_code,
        "dot_eval": dot_eval_code,
        "dot_eval_pure": dot_eval_pure_code,
        "dot_eval_try": dot_eval_try_code,
        "static_call": static_call_code,
        "foldl": foldl_code,
        "map_int": map_int_code,
        "map_hash_expr": map_hash_expr_code,
        "map_hash_lookup": map_hash_lookup_code,
        "function_hash_expression": function_hash_expression_code,
        "map_hash_body": map_hash_body_code,
        "select_hash": select_hash_code,
        "select_hash_lookup": select_hash_lookup_code,
        "closure_basic": closure_basic_code,
        "closure_writeback": closure_writeback_code,
        "closure_loop_var": closure_loop_var_code,
        "closure_callback": closure_callback_code,
        "closure_noncapturing": closure_noncapturing_code,
        "function_noncapturing_branch": function_noncapturing_branch_code,
        "closure_noncapturing_branch": closure_noncapturing_branch_code,
    };

    string qore_bin = ENV.QORE_BIN ?? QORE_ARGV[0] ?? "qore";
    string ld_path = ENV.LD_LIBRARY_PATH ?? "";

    # Parse modes from environment or use default
    list<string> modes;
    if (ENV.BENCH_MODES) {
        modes = ENV.BENCH_MODES.split(",");
    } else {
        modes = ("ast", "ir", "tiered", "jit", "aot");
    }

    hash<string, bool> selected_tests;
    if (ENV.BENCH_TESTS) {
        foreach string test_name in (ENV.BENCH_TESTS.split(",")) {
            selected_tests{test_name} = True;
        }
    }

    printf("================================================================================\n");
    printf("Extended Performance Benchmark (10x longer iterations for reliable measurements)\n");
    printf("================================================================================\n");
    printf("Modes: %s\n", modes.join(" vs "));
    printf("Base iterations: %d\n", iterations);
    printf("Samples: %d timed, %d warmup\n", samples, warmup);
    printf("Binary: %s\n", qore_bin);
    printf("Note: AOT shows execution time (compilation time shown separately)\n");
    printf("================================================================================\n\n");

    # Results table
    hash<string, hash<string, float>> results;

    foreach string test_name in (keys tests) {
        if (!selected_tests.empty() && !selected_tests{test_name}) {
            continue;
        }
        string code = tests{test_name};
        printf("Test: %s\n", test_name);
        printf("------------------------------------------------------------------------\n");

        hash<string, float> test_results;
        string expected_output;
        bool have_expected = False;

        foreach string mode in (modes) {
            hash<auto> r = run_benchmark(test_name, code, mode, qore_bin, ld_path, samples, warmup);
            test_results{mode} = r.elapsed_ms;
            if (!have_expected) {
                expected_output = r.output;
                have_expected = True;
            }
            string status = r.samples_match && r.output == expected_output ? "OK" : "MISMATCH";
            if (mode == "aot" && r.compile_ms > 0) {
                # Show AOT as: execution time (compilation time)
                printf("  %-7s: %8.1f ms (+/-%6.1f, compile: %6.1f ms)  [%s]\n",
                    mode, r.elapsed_ms, r.stdev_ms, r.compile_ms, status);
            } else {
                printf("  %-7s: %8.1f ms (+/-%6.1f)  [%s]\n", mode, r.elapsed_ms, r.stdev_ms, status);
            }
        }

        # Calculate speedups relative to AST
        if (test_results.ast > 0) {
            float ast_time = test_results.ast;
            printf("  Speedup vs AST:");
            foreach string mode in (modes) {
                if (mode != "ast") {
                    float speedup = ast_time / test_results{mode};
                    printf("  %s=%.2fx", mode, speedup);
                }
            }
            printf("\n");
        }

        results{test_name} = test_results;
        printf("\n");
    }

    # Summary table
    printf("================================================================================\n");
    printf("SUMMARY (execution times in ms, compilation time excluded for AOT)\n");
    printf("================================================================================\n");
    # Header
    string header = sprintf("%-15s", "Test");
    foreach string mode in (modes) {
        header += sprintf(" %8s", mode);
    }
    printf("%s\n", header);
    printf("------------------------------------------------------------------------\n");

    # Data rows
    foreach string test_name in (keys results) {
        hash<string, float> r = results{test_name};
        string row = sprintf("%-15s", test_name);
        foreach string mode in (modes) {
            row += sprintf(" %8.1f", r{mode} ?? 0.0);
        }
        printf("%s\n", row);
    }
    printf("------------------------------------------------------------------------\n");

    # Geometric-mean speedups avoid overweighting isolated short kernels.
    printf("\nGeometric Mean Speedup vs AST:\n");
    foreach string mode in (modes) {
        if (mode == "ast") {
            continue;
        }
        float speedup_product = 1.0;
        int count = 0;
        foreach string test_name in (keys results) {
            hash<string, float> r = results{test_name};
            if (r.ast > 0 && r{mode} > 0) {
                speedup_product *= r.ast / r{mode};
                ++count;
            }
        }
        if (count > 0) {
            printf("  %-7s: %.2fx\n", mode, pow(speedup_product, 1.0 / count));
        }
    }

    printf("\n");
    printf("================================================================================\n");
    printf("NOTES:\n");
    printf("  - All times are EXECUTION times (how fast the code runs)\n");
    printf("  - AOT compilation times are shown separately per test and NOT included above\n");
    printf("  - JIT/tiered compilation happens during first execution and is included\n");
    printf("  - Summary values are medians from repeated process executions\n");
    printf("================================================================================\n");
}
}
