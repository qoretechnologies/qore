#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-exec-mode: children - every check runs a script in a child process that sets its own --exec-mode, or AOT
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../ExecModeHarness.qm

%exec-class ReferenceNothingTest

#! a value read through a reference has no value when its target has none, whatever the referenced type (issue #5685)
/** The target of a reference can be cleared where the code reading it does not see it (a member of an object
    deleted since, a removed hash key, a variable removed through another reference); the compiled modes took a read
    through a parameter of a \c reference<int> type as a value of the referenced type, so they stored or used no
    value as 0 where the AST interpreter raises RUNTIME-TYPE-ERROR.

    The scripts next to the test run in every execution mode, on the IR tier and as AOT executables at -O0 and -O3;
    their output must be that of the AST interpreter, which the test runs first, and that of the script's
    <script>.expected file.
*/
class ReferenceNothingTest inherits QUnit::Test {
    public {
        #! the scripts
        const Scripts = ("reference-nothing",);
    }

    private {
        string qore_bin;
        string qcc_bin;
        string env;
        string dir;
    }

    constructor() : QUnit::Test("reference nothing", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        string libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
            ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");
        env = sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s QORE_LIBDIR=%s", libqore_dir, libqore_dir, libqore_dir);
        dir = get_script_dir();
        foreach string script in (Scripts) {
            addTestCase(script + ": execution modes", sub () { modesTest(script); });
            addTestCase(script + ": AOT executable -O0", sub () { aotTest(script, "-O0"); });
            addTestCase(script + ": AOT executable -O3", sub () { aotTest(script, "-O3"); });
        }
        set_return_value(main());
    }

    #! returns the output of the AST interpreter for the script
    private string astOutput(string script) {
        return ExecModeHarness::run(sprintf("%s %s --exec-mode=ast %s/%s.q", env, qore_bin, dir, script));
    }

    #! runs the script in every execution mode and on the IR tier
    private modesTest(string script) {
        string exp = astOutput(script);
        assertEq(ReadOnlyFile::readTextFile(sprintf("%s/%s.expected", dir, script)), exp,
            script + ": the output of the AST interpreter");
        foreach string mode in (ExecModeHarness::ExecModes) {
            assertEq(exp, ExecModeHarness::run(sprintf("%s %s --exec-mode=%s %s/%s.q", env, qore_bin, mode, dir,
                script)), script + ": " + mode);
        }
        assertEq(exp, ExecModeHarness::run_ir_tier(sprintf("%s %s --exec-mode=tiered %s/%s.q", env, qore_bin, dir,
            script)), script + ": " + ExecModeHarness::IRTierName);
    }

    #! compiles the script with qcc and checks that the executable gives the output of the AST interpreter
    private aotTest(string script, string opt) {
        if (!is_file(qcc_bin)) {
            testSkip("qcc is not available at " + qcc_bin);
        }
        TmpDir tmp("reference-nothing-aot-");
        string exe = tmp.path + "/" + script;
        string out = ExecModeHarness::run_any(sprintf("%s %s %s -o %s %s/%s.q", env, qcc_bin, opt, exe, dir, script));
        assertTrue(is_file(exe), opt + ": qcc compiles the script: " + out);
        assertEq(astOutput(script), ExecModeHarness::run_any(sprintf("%s %s", env, exe)), script + ": AOT " + opt);
    }
}
