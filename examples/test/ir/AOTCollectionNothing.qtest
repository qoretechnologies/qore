#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil

%exec-class AOTCollectionNothingTest

class AOTCollectionNothingTest inherits QUnit::Test {
    private {
        string qore_bin;
        string libqore_dir;
    }

    constructor() : QUnit::Test("AOTCollectionNothingTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);

        addTestCase("IR/JIT direct-index collection operators preserve NOTHING",
            \testExecModesDirectIndexCollectionNothing());
        addTestCase("AOT qmod direct-index collection operators preserve NOTHING",
            \testAOTQmodDirectIndexCollectionNothing());
        addTestCase("AOT qmod constants can be NOTHING or NULL",
            \testAOTQmodFalseyConstants());
        addTestCase("AOT qmod preinit leaves pending source statics untouched",
            \testAOTQmodPendingSourceStaticIsolation());

        set_return_value(main());
    }

    private string expectedOutput() {
        return "typed-nothing:missing:missing:missing:missing:missing\n"
            "typed-empty:list:list:list:hash:hash\n"
            "typed-bool-map:TFTF:RUNTIME-TYPE-ERROR:RUNTIME-TYPE-ERROR\n"
            "typed-bool-select:TT:RUNTIME-TYPE-ERROR:SELECT-HELPER-ERROR\n"
            "typed-string-select:alpha,atom:RUNTIME-TYPE-ERROR:STRING-SELECT-ERROR\n"
            "typed-helper-map:9:7.5:TFTF:RUNTIME-TYPE-ERROR:MAP-HELPER-ERROR\n"
            "typed-helper-phi:10:9.5:TFFF:4.5:RUNTIME-TYPE-ERROR:MAP-HELPER-ERROR\n"
            "qorus-options:missing\n";
    }

    private string collectionNothingFunctions(string prefix) {
        string access = prefix == "" ? "" : prefix + " ";

        return sprintf("%sstring sub kind(auto v) {
    return !exists v ? \"missing\" : (v instanceof list ? \"list\" : (v instanceof hash ? \"hash\" : v.type()));
}

%sstring sub boolList(list<bool> values) {
    string result;
    for (int i = 0; i < values.size(); ++i) {
        result += values[i] === NOTHING ? \"N\" : values[i] ? \"T\" : \"F\";
    }
    return result;
}

%sint sub mapInt(int value) {
    return value + 1;
}

%sint sub mapIntAlternate(int value) {
    return value + 2;
}

%sfloat sub mapFloat(float value) {
    return value + 0.5;
}

%sfloat sub mapFloatAlternate(float value) {
    return value + 1.5;
}

%sbool sub mapBool(int value) {
    return (value & 1) == 0;
}

%sbool sub mapBoolAlternate(int value) {
    return (value & 2) == 0;
}

%s*int sub mapMaybeNothing(int value) {
    int result;
    if (value) {
        result = value;
    }
    return result;
}

%sint sub mapThrow(int value) {
    if (value == 2) {
        throw \"MAP-HELPER-ERROR\", \"expected\";
    }
    return value;
}

%sbool sub selectThrow(bool value) {
    if (!value) {
        throw \"SELECT-HELPER-ERROR\", \"expected\";
    }
    return value;
}

%sbool sub selectStringThrow(string value) {
    if (value == \"beta\") {
        throw \"STRING-SELECT-ERROR\", \"expected\";
    }
    return True;
}

%sstring sub verify() {
    list<int> l;
    auto m = map $1 + 1, l;
    auto s = (select l, True);
    auto ms = map ($1, l, True);
    auto hm = map {$1: $1}, l;
    auto hms = map ({$1: $1}, l, True);

    list<int> e = ();
    auto em = map $1 + 1, e;
    auto es = (select e, True);
    auto ems = map ($1, e, True);
    auto ehm = map {$1: $1}, e;
    auto ehms = map ({$1: $1}, e, True);

    list<int> bool_source = (0, 1, 2, 3);
    list<bool> bool_map = (map ($1 & 1) == 0, bool_source);
    list<bool> sparse_bool = (True, False, True);
    delete sparse_bool[1];
    string sparse_bool_error = \"none\";
    try {
        list<bool> sparse_bool_map = (map $1, sparse_bool);
    } catch (hash<ExceptionInfo> ex) {
        sparse_bool_error = ex.err;
    }
    bool unassigned_bool;
    string missing_bool_error = \"none\";
    try {
        list<bool> missing_bool_map = (map unassigned_bool, bool_source);
    } catch (hash<ExceptionInfo> ex) {
        missing_bool_error = ex.err;
    }
    list<bool> bool_select = (select bool_map, $1);
    string sparse_bool_select_error = \"none\";
    try {
        list<bool> sparse_bool_select = (select sparse_bool, True);
    } catch (hash<ExceptionInfo> ex) {
        sparse_bool_select_error = ex.err;
    }
    string throwing_bool_select_error = \"none\";
    try {
        list<bool> throwing_bool_select = (select bool_map, selectThrow($1));
    } catch (hash<ExceptionInfo> ex) {
        throwing_bool_select_error = ex.err;
    }
    list<string> string_select;
    {
        list<string> string_source = (\"alpha\", \"beta\", \"atom\");
        string_select = (select string_source, $1.startsWith(\"a\"));
    }
    list<string> sparse_string = (\"alpha\", \"beta\", \"atom\");
    delete sparse_string[1];
    string sparse_string_select_error = \"none\";
    try {
        list<string> sparse_string_select = (select sparse_string, True);
    } catch (hash<ExceptionInfo> ex) {
        sparse_string_select_error = ex.err;
    }
    string throwing_string_select_error = \"none\";
    try {
        list<string> throwing_string_select = (select (\"alpha\", \"beta\", \"atom\"),
            selectStringThrow($1));
    } catch (hash<ExceptionInfo> ex) {
        throwing_string_select_error = ex.err;
    }

    list<int> helper_source = (1, 2, 3);
    list<int> helper_int_map = (map mapInt($1), helper_source);
    list<float> helper_float_map = (map mapFloat($1), (1.0, 2.0, 3.0));
    list<bool> helper_bool_map = (map mapBool($1), (0, 1, 2, 3));
    string helper_nothing_error = \"none\";
    try {
        list<int> helper_nothing_map = (map mapMaybeNothing($1), (0, 1));
    } catch (hash<ExceptionInfo> ex) {
        helper_nothing_error = ex.err;
    }
    string helper_throw_error = \"none\";
    try {
        list<int> helper_throw_map = (map mapThrow($1), helper_source);
    } catch (hash<ExceptionInfo> ex) {
        helper_throw_error = ex.err;
    }
    list<int> helper_int_phi = (map ($1 & 1)
        ? mapInt($1) : mapIntAlternate($1), helper_source);
    list<float> helper_float_phi = (map ($# & 1)
        ? mapFloat($1) : mapFloatAlternate($1), (1.0, 2.0, 3.0));
    list<bool> helper_bool_phi = (map ($# & 1)
        ? mapBool($1) : mapBoolAlternate($1), (0, 1, 2, 3));
    list<float> helper_mixed_phi = (map ($1 & 1)
        ? mapInt($1) : mapFloat(float($1)), (1, 2));
    string helper_phi_nothing_error = \"none\";
    try {
        list<int> helper_phi_nothing = (map $1
            ? mapInt($1) : mapMaybeNothing($1), (0, 1));
    } catch (hash<ExceptionInfo> ex) {
        helper_phi_nothing_error = ex.err;
    }
    string helper_phi_throw_error = \"none\";
    try {
        list<int> helper_phi_throw = (map $1 == 2
            ? mapThrow($1) : mapInt($1), helper_source);
    } catch (hash<ExceptionInfo> ex) {
        helper_phi_throw_error = ex.err;
    }

    hash<auto> opts;
    auto workflow_options = map (\"name\": $1) + opts.$1, keys opts;

    return sprintf(\"typed-nothing:%%s:%%s:%%s:%%s:%%s\\n\"
        \"typed-empty:%%s:%%s:%%s:%%s:%%s\\n\"
        \"typed-bool-map:%%s:%%s:%%s\\n\"
        \"typed-bool-select:%%s:%%s:%%s\\n\"
        \"typed-string-select:%%s:%%s:%%s\\n\"
        \"typed-helper-map:%%d:%%g:%%s:%%s:%%s\\n\"
        \"typed-helper-phi:%%d:%%g:%%s:%%g:%%s:%%s\\n\"
        \"qorus-options:%%s\\n\",
        kind(m), kind(s), kind(ms), kind(hm), kind(hms),
        kind(em), kind(es), kind(ems), kind(ehm), kind(ehms),
        boolList(bool_map), sparse_bool_error, missing_bool_error,
        boolList(bool_select), sparse_bool_select_error,
        throwing_bool_select_error,
        join(\",\", string_select), sparse_string_select_error,
        throwing_string_select_error,
        helper_int_map[0] + helper_int_map[1] + helper_int_map[2],
        helper_float_map[0] + helper_float_map[1] + helper_float_map[2],
        boolList(helper_bool_map), helper_nothing_error, helper_throw_error,
        helper_int_phi[0] + helper_int_phi[1] + helper_int_phi[2],
        helper_float_phi[0] + helper_float_phi[1] + helper_float_phi[2],
        boolList(helper_bool_phi), helper_mixed_phi[0] + helper_mixed_phi[1],
        helper_phi_nothing_error, helper_phi_throw_error,
        kind(workflow_options));
}
", access, access, access, access, access, access, access, access, access, access,
    access, access, access);
    }

    private string collectionNothingCode() {
        return "%modern

" + collectionNothingFunctions("");
    }

    private string moduleCode() {
        return "%modern

module AOTCollectionNothingMod {
    version = \"1.0\";
    desc = \"AOT collection NOTHING regression module\";
    author = \"Qore\";
    license = \"MIT\";
}

public namespace AOTCollectionNothingMod {
public const NothingConst = NOTHING;
public const NullConst = NULL;
public const FalseConst = False;
public const ZeroConst = 0;
public const EmptyStringConst = \"\";

" + collectionNothingFunctions("public") + "

public string sub verifyConstants() {
    return sprintf(\"nothing:%s\\nnull:%s\\nfalse:%s\\nzero:%s\\nempty-string:%s\\n\", kind(NothingConst),
        kind(NullConst), kind(FalseConst), kind(ZeroConst), kind(EmptyStringConst));
}
}
";
    }

    private string runScript(string mode, string script_path) {
        return backquote(sprintf("LD_LIBRARY_PATH=%s %s -b --exec-mode=%s %s 2>&1",
            libqore_dir, qore_bin, mode, script_path));
    }

    private string runModule(string module_dir, string script_path) {
        return backquote(sprintf("LD_LIBRARY_PATH=%s QORE_MODULE_DIR=%s %s -b --enable-debug %s 2>&1",
            libqore_dir, module_dir, qore_bin, script_path));
    }

    testExecModesDirectIndexCollectionNothing() {
        TmpFile script("qore-ir-collection-nothing-", ".q");
        script.file.write(collectionNothingCode());
        script.file.write("printf(\"%s\", verify());\n");
        script.file.close();

        string ast = runScript("ast", script.path);
        string ir = runScript("ir", script.path);
        string jit = runScript("jit", script.path);

        assertEq(expectedOutput(), ast, "AST direct-index collection operator baseline");
        assertEq(ast, ir, "IR direct-index collection operators match AST for NOTHING inputs");
        assertEq(ast, jit, "JIT direct-index collection operators match AST for NOTHING inputs");
    }

    testAOTQmodDirectIndexCollectionNothing() {
        TmpDir tmp("qore-aot-collection-nothing-");
        string tmp_dir = tmp.path;
        string src_dir = tmp_dir + "/src";
        string qmod_dir = tmp_dir + "/qmod";
        mkdir(src_dir);
        mkdir(qmod_dir);

        string qm_path = src_dir + "/AOTCollectionNothingMod.qm";
        File qm();
        qm.open2(qm_path, O_WRONLY | O_CREAT | O_TRUNC);
        qm.write(moduleCode());
        qm.close();

        string script_path = tmp_dir + "/run.qr";
        File script();
        script.open2(script_path, O_WRONLY | O_CREAT | O_TRUNC);
        script.write("%modern
%requires AOTCollectionNothingMod
printf(\"%s\", AOTCollectionNothingMod::verify());
");
        script.close();

        string qmod_path = qmod_dir + "/AOTCollectionNothingMod.qmod";
        string compile_out = backquote(sprintf("QORE_LIBDIR=%s %s -b --compile-module --strip-source --output %s %s 2>&1",
            libqore_dir, qore_bin, qmod_path, qm_path));
        assertTrue(is_file(qmod_path), "compiled collection NOTHING module: " + compile_out);

        assertEq(expectedOutput(), runModule(src_dir, script_path),
            "source module direct-index collection operators");
        assertEq(expectedOutput(), runModule(qmod_dir, script_path),
            "AOT qmod direct-index collection operators");
    }

    testAOTQmodFalseyConstants() {
        TmpDir tmp("qore-aot-falsey-constants-");
        string tmp_dir = tmp.path;
        string src_dir = tmp_dir + "/src";
        string qmod_dir = tmp_dir + "/qmod";
        mkdir(src_dir);
        mkdir(qmod_dir);

        string qm_path = src_dir + "/AOTCollectionNothingMod.qm";
        File qm();
        qm.open2(qm_path, O_WRONLY | O_CREAT | O_TRUNC);
        qm.write(moduleCode());
        qm.close();

        string script_path = tmp_dir + "/run.qr";
        File script();
        script.open2(script_path, O_WRONLY | O_CREAT | O_TRUNC);
        script.write("%modern
%requires AOTCollectionNothingMod
printf(\"%s\", AOTCollectionNothingMod::verifyConstants());
");
        script.close();

        string qmod_path = qmod_dir + "/AOTCollectionNothingMod.qmod";
        string compile_out = backquote(sprintf("QORE_LIBDIR=%s %s -b --compile-module --strip-source --output %s %s 2>&1",
            libqore_dir, qore_bin, qmod_path, qm_path));
        assertTrue(is_file(qmod_path), "compiled falsey constant module: " + compile_out);

        string expected = "nothing:missing\nnull:NULL\nfalse:bool\nzero:integer\nempty-string:string\n";
        assertEq(expected, runModule(src_dir, script_path),
            "source module falsey constants");
        assertEq(expected, runModule(qmod_dir, script_path),
            "AOT qmod falsey constants");
    }

    testAOTQmodPendingSourceStaticIsolation() {
        TmpDir tmp("qore-aot-pending-source-static-");
        string tmp_dir = tmp.path;
        string src_dir = tmp_dir + "/src";
        string qmod_dir = tmp_dir + "/qmod";
        mkdir(src_dir);
        mkdir(qmod_dir);

        string qm_path = src_dir + "/AOTCollectionNothingMod.qm";
        File qm();
        qm.open2(qm_path, O_WRONLY | O_CREAT | O_TRUNC);
        qm.write(moduleCode());
        qm.close();

        string qmod_path = qmod_dir + "/AOTCollectionNothingMod.qmod";
        string compile_out = backquote(sprintf(
            "QORE_LIBDIR=%s %s -b --compile-module --strip-source --output %s %s 2>&1",
            libqore_dir, qore_bin, qmod_path, qm_path));
        assertTrue(is_file(qmod_path), "compiled pending source static module: " + compile_out);

        string script_path = tmp_dir + "/run.qr";
        File script();
        script.open2(script_path, O_WRONLY | O_CREAT | O_TRUNC);
        script.write("%modern
class AOTPendingSourceStatic {
    public {
        static hash Values;
    }
}
%requires AOTCollectionNothingMod
printf(\"%d\\n\", AOTPendingSourceStatic::Values.size());
");
        script.close();

        assertEq("0\n", runModule(qmod_dir, script_path),
            "AOT module initialization does not preinitialize pending source static variables");
    }
}
