#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires ../../../qlib/QUnit.qm
%requires ../../../qlib/FsUtil.qm
%requires ../ExecModeHarness.qm
%exec-class RecursiveClosureLocalsTest

class RecursiveClosureLocalsTest inherits QUnit::Test {
    #! The macOS deployment target libqore was built for, as compiler flags, or an empty list
    /** A driver compiled without it targets the compiler's default, which can be older than libqore's, and the
        linker then warns that libqore was built for a newer macOS.  Qore::CFLAGS names it on macOS.
    */
    private static list<string> libqoreTargetFlags() {
        *list<*string> m = (Qore::CFLAGS =~ x/(-mmacosx-version-min=\S+)/);
        return m ? (m[0],) : ();
    }

    private {
        string qore_bin = executablePath(ENV.QORE_BIN ?? QORE_ARGV[0] ?? "qore");
        string lib_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        string source = get_script_dir() + "/RecursiveClosureLocals.qr";
    }

    constructor() : Test("Recursive closure and reference locals", "1.0", \ARGV) {
        addTestCase("Recursive values and cleanup agree across execution modes", \modes());
        addTestCase("Native calls preserve distinct recursive frames after compilation completes", \nativeCalls());
        addTestCase("Source-stripped AOT preserves recursive and captured values", \compiled());
        set_return_value(main());
    }

    private static string quote(string value) {
        return "'" + join("'\\''", split("'", value)) + "'";
    }

    private static string executablePath(string name) {
        if (name.regex("/")) {
            return realpath(name);
        }
        foreach string directory in (split(":", ENV.PATH ?? "")) {
            string path = (directory ? directory : ".") + "/" + name;
            if (is_executable(path)) {
                return realpath(path);
            }
        }
        throw "TEST-SETUP-ERROR", "cannot locate executable " + name;
    }

    #! Returns the toolchain roots that hold a versioned LLVM install, newest version first
    /** Distributions that ship several LLVM versions side by side keep each one in its own
        prefix and do not link its driver into a PATH directory: alpine uses
        \c /usr/lib/llvm<major>, MacPorts \c /opt/local/libexec/llvm-<major> and Homebrew
        \c /opt/homebrew/opt/llvm@<major>.  These are the same families
        examples/test/docker_test/test-alpine.sh and test-macos.sh search when they configure
        the build.  Several versions can be installed: llvmConfigPath() takes the one whose version is
        Qore::LLVMVersion.
    */
    private static list<string> llvmPrefixes() {
        list<string> prefixes = ();
        foreach string parent in (("/usr/lib", "/usr/lib64", "/usr/local/lib", "/usr/local/lib64",
            "/opt/homebrew/opt", "/usr/local/opt", "/opt/local/libexec")) {
            foreach string candidate in (glob(parent + "/llvm*") ?? ()) {
                if (is_dir(candidate)) {
                    prefixes += candidate;
                }
            }
        }
        # newest first; an unversioned prefix (Homebrew's plain "llvm") sorts last
        return sort_descending(prefixes, int sub (string l, string r) {
            int lv = llvmPrefixVersion(l);
            int rv = llvmPrefixVersion(r);
            return lv == rv ? (l < r ? -1 : (l == r ? 0 : 1)) : (lv < rv ? -1 : 1);
        });
    }

    #! Returns the major LLVM version encoded in a prefix directory name, or 0 if it has none
    private static int llvmPrefixVersion(string prefix) {
        *list<*string> match = (basename(prefix) =~ x/([0-9]+)/);
        return match[0].toInt();
    }

    #! Returns the "<major>.<minor>" part of an LLVM version, which names the LLVM library's ABI
    private static string llvmVersionKey(string version) {
        *list<*string> m = (version =~ x/^([0-9]+\.[0-9]+)/);
        return m ? m[0] : version;
    }

    #! Returns the LLVM version that the given llvm-config reports, or nothing if it cannot be run
    private static *string llvmConfigVersion(string path) {
        int rc;
        string out = backquote(quote(path) + " --version 2>/dev/null", \rc);
        if (rc) {
            return;
        }
        return trim(out);
    }

    #! Returns the path to the llvm-config of the LLVM this qore was built with (Qore::LLVMVersion)
    /** The driver includes the library's JIT header, which includes LLVM's headers, and links LLVM: built with
        another LLVM than libqore's, it has two LLVMs in one process and crashes (SIGSEGV in LLVM, exit 139).

        \c llvm-config is only in the \c PATH where the distribution ships a single LLVM;
        everywhere else it lives in the versioned prefix, so a PATH-only lookup fails on
        exactly the platforms where the JIT is fully functional (alpine in CI, MacPorts and
        Homebrew locally).  Of the llvm-config found in the \c PATH and in the prefixes, the first whose version
        matches is taken; \c LLVM_CONFIG overrides the search and must name a matching one.
    */
    private static string llvmConfigPath() {
        string want = llvmVersionKey(Qore::LLVMVersion);
        if (ENV.LLVM_CONFIG) {
            string path = executablePath(ENV.LLVM_CONFIG);
            *string version = llvmConfigVersion(path);
            if (!version || llvmVersionKey(version) != want) {
                throw "TEST-SETUP-ERROR", sprintf("LLVM_CONFIG names %s, which reports LLVM %s, but this qore was "
                    "built with LLVM %s; set LLVM_CONFIG to the llvm-config of LLVM %s", path,
                    version ?? "<no version>", Qore::LLVMVersion, Qore::LLVMVersion);
            }
            return path;
        }
        list<string> candidates = ();
        foreach string directory in (split(":", ENV.PATH ?? "")) {
            string path = (directory ? directory : ".") + "/llvm-config";
            if (is_executable(path)) {
                candidates += realpath(path);
            }
        }
        foreach string prefix in (llvmPrefixes()) {
            string path = prefix + "/bin/llvm-config";
            if (is_executable(path)) {
                candidates += realpath(path);
            }
        }
        list<string> found = ();
        foreach string path in (candidates) {
            *string version = llvmConfigVersion(path);
            if (version && llvmVersionKey(version) == want) {
                return path;
            }
            found += sprintf("%s (%s)", path, version ?? "cannot be run");
        }
        throw "TEST-SETUP-ERROR", sprintf("this qore was built with LLVM %s, but no llvm-config of that version was "
            "found (%s); set LLVM_CONFIG to the llvm-config of LLVM %s", Qore::LLVMVersion,
            found ? "found: " + found.join(", ") : "none found", Qore::LLVMVersion);
    }

    #! runs a command; one that runs qore with an execution mode runs through ExecModeHarness
    private string run(list<string> args) {
        string command = "LD_LIBRARY_PATH=" + quote(lib_dir)
            + " " + (map quote($1), args).join(" ");
        hash<ExecModeHarness::ModeRunResult> r = ExecModeHarness::run_command(command);
        if (r.mode) {
            ExecModeHarness::check_native(r);
        }
        assertEq(0, r.rc, r.out);
        assertFalse(r.out.regex("(?i)warning:"), r.out);
        return r.out;
    }

    private modes() {
        TmpDir dir("qore-recursive-locals-modes-");
        foreach string mode in ("ast", "ir", "jit", "tiered") {
            assertEq("recursive-closure-locals: ok\n",
                run((qore_bin, "-b", "--enable-debug", "--exec-mode=" + mode, source)));
        }
    }

    private nativeCalls() {
        TmpDir dir("qore-recursive-locals-native-");
        string llvm_config = llvmConfigPath();
        string llvm_include = trim(run((llvm_config, "--includedir")));
        string llvm_lib = trim(run((llvm_config, "--libdir")));
        list<string> llvm_link = split(" ", trim(run((llvm_config, "--libs"))));
        string root = get_script_dir() + "/../../..";
        string executable = dir.path + "/recursive-locals";
        # -Wl,-rpath is what lets the driver find libqore (and a shared LLVM): LD_LIBRARY_PATH
        # is a Linux-only mechanism, and libqore's macOS install name is
        # @rpath/libqore.<ver>.dylib, so a binary linked with -L/-l alone has nowhere to look
        # and dies in dyld before main()
        run((ENV.CXX ?? "c++", "-std=c++20", "-g", "-I" + root + "/include",
            "-I" + lib_dir + "/include", "-I" + llvm_include,
            get_script_dir() + "/recursive_closure_locals.cpp", "-L" + lib_dir,
            "-L" + llvm_lib, "-Wl,-rpath," + lib_dir, "-Wl,-rpath," + llvm_lib,
            "-lqore") + llvm_link + ("-o", executable) + libqoreTargetFlags());
        assertEq("recursive-closure-locals: ok\n", run((executable, source)));
    }

    private compiled() {
        TmpDir dir("qore-recursive-locals-aot-");
        string executable = dir.path + "/recursive-locals";
        run((ENV.QCC ?? lib_dir + "/qcc", "-O3", "--strip-source",
            "--parse-option=PO_ENABLE_DEBUG", "-o", executable, source));
        assertEq("recursive-closure-locals: ok\n", run((executable,)));
    }
}
