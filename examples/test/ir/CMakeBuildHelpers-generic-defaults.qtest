#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires ../../../qlib/QUnit.qm
%requires ../../../qlib/FsUtil.qm
%requires ./CMakeBuildHelpersTestBase.qm

%exec-class CMakeGenericDefaultsTest

#! Generic qcc objects: member defaults and types in the contracts of a source
/** One scenario of the incremental life of the generic qcc object helper project of CMakeBuildHelpersTestBase.qm,
    on a baseline built for it.  Each scenario is a file of its own, so that none comes near the time limit of a
    test and test shards run them side by side.
*/
class CMakeGenericDefaultsTest inherits CMakeBuildHelpersTestBase::GenericQccObjectTest {
    constructor() : GenericQccObjectTest("CMakeGenericDefaultsTest", "1.0", \ARGV) {
        addTestCase("generic qcc objects: member defaults rebuild the script aggregate, a member type the "
            "consumers too", \testDefaultsAndTypes());
        set_return_value(main());
    }

    #! Member and hashdecl defaults rebuild the script aggregate and keep the consumers; a member type rebuilds both
    /** Setup: the tree is current (@ref settleGenericBaseline()), and the provider's object was last published by
        a compile of its component alone (@ref publishProviderAlone()): the contracts the first step compares with a
        compile of the provider alone are those of a compile of the provider alone, not of the baseline's shared
        parse.

        Steps, each on the tree the step before it left:
        - the provider's member default changed: the aggregate contract and the script aggregate move, the compile
          and declaration contracts and the consumer object do not
        - a hashdecl member default changed: the script aggregate is rebuilt, the object that creates the hashes is
          kept
        - the type of the member the first step retagged changed: the aggregate and the consumer are rebuilt, and
          the program prints what it printed after the hashdecl default changed
    */
    testDefaultsAndTypes() {
        TmpDir tmp("qore-cmake-qcc-defaults-");
        hash<GenericQccProject> project = buildGenericBaseline(tmp.path);
        settleGenericBaseline(project);
        publishProviderAlone(project);

        string src_dir = project.src_dir;
        string build_dir = project.build_dir;
        string provider = project.provider;
        string status_provider = project.status_provider;
        string source_runner = project.source_runner;
        string source_qore = project.source_qore;
        list<string> object_paths = project.object_paths;
        string provider_object = project.provider_object;
        string consumer_object = object_paths[1];

        # The script aggregate embeds the declarations of its sources, with the defaults of their members, and the
        # linked program initializes an object's members from them.  A source that changes only a member initializer
        # must therefore rebuild the aggregate, while its consumers, which depend on its declaration and compile
        # contracts and do not compile against the default, keep their objects.
        date member_default_aggregate_mtime = mtime(build_dir + "/script-aggregate.qo");
        date member_default_consumer_mtime = mtime(consumer_object);
        string member_default_declaration_contract = read(provider_object + ".declaration-contract.stamp");
        string member_default_compile_contract = read(provider_object + ".compile-contract.stamp");
        string member_default_aggregate_contract = read(provider_object + ".aggregate-contract.stamp");
        string tagged_provider = read(provider);
        assertTrue(tagged_provider.find("string tag = \"tag\";") != -1,
            "the provider declares the member initializer the fixture changes");
        write(provider, replace(tagged_provider, "string tag = \"tag\";", "string tag = \"retagged\";"));
        string member_default_change = run(buildCommand(build_dir));
        assertEq(member_default_compile_contract, read(provider_object + ".compile-contract.stamp"),
            "a member initializer does not move the provider's compile contract: " + member_default_change);
        assertEq(member_default_declaration_contract, read(provider_object + ".declaration-contract.stamp"),
            "a member initializer does not move the provider's declaration contract: " + member_default_change);
        assertNeq(member_default_aggregate_contract, read(provider_object + ".aggregate-contract.stamp"),
            "a member initializer moves the provider's aggregate contract: " + member_default_change);
        assertEq(member_default_consumer_mtime, mtime(consumer_object),
            "a member initializer preserves the consumer object: " + member_default_change);
        assertNeq(member_default_aggregate_mtime, mtime(build_dir + "/script-aggregate.qo"),
            "a member initializer rebuilds the script aggregate: " + member_default_change);
        string member_default_source_out = run(sprintf("cd %s && %s %s", src_dir, source_qore, source_runner));
        string member_default_static_out = run(sprintf("LD_LIBRARY_PATH=%s QORE_MODULE_DIR=%s %s",
            qore_build_dir, build_dir + "/late-modules", build_dir + "/qo-static-host"));
        assertTrue(member_default_source_out.find(":retagged:") != -1,
            "the parsed source sees the new member default: " + member_default_source_out);
        assertEq(member_default_source_out, member_default_static_out,
            "the statically linked program sees the new member default");

        # A hashdecl member default is embedded the same way, and initializes a hash of the type wherever it is
        # created, also in the code of another source, which therefore keeps its object
        string status_holder_object = "";
        foreach string object_path in (object_paths) {
            if (object_path.endsWith("_statusholder_qc.qo")) {
                status_holder_object = object_path;
            }
        }
        assertTrue(status_holder_object != "", "the hashdecl consumer is in the object list");
        date hashdecl_default_aggregate_mtime = mtime(build_dir + "/script-aggregate.qo");
        date hashdecl_default_consumer_mtime = mtime(status_holder_object);
        write(status_provider, replace(read(status_provider), "string status = \"queued\";",
            "string status = \"started\";"));
        string hashdecl_default_change = run(buildCommand(build_dir));
        assertNeq(hashdecl_default_aggregate_mtime, mtime(build_dir + "/script-aggregate.qo"),
            "a hashdecl member default rebuilds the script aggregate: " + hashdecl_default_change);
        assertEq(hashdecl_default_consumer_mtime, mtime(status_holder_object),
            "a hashdecl member default preserves the object that creates a hash of the type: "
                + hashdecl_default_change);
        string hashdecl_default_source_out = run(sprintf("cd %s && %s %s", src_dir, source_qore, source_runner));
        assertTrue(hashdecl_default_source_out.find(":started:started") != -1,
            "the parsed source sees the new hashdecl default: " + hashdecl_default_source_out);
        assertEq(hashdecl_default_source_out, run(sprintf("LD_LIBRARY_PATH=%s QORE_MODULE_DIR=%s %s",
            qore_build_dir, build_dir + "/late-modules", build_dir + "/qo-static-host")),
            "the statically linked program sees the new hashdecl default");
        member_default_source_out = hashdecl_default_source_out;

        # A member's type is what consumers compile against, so changing it rebuilds both the aggregate and the
        # consumer.
        date member_type_aggregate_mtime = mtime(build_dir + "/script-aggregate.qo");
        date member_type_consumer_mtime = mtime(consumer_object);
        string retagged_provider = read(provider);
        write(provider, replace(retagged_provider, "string tag = \"retagged\";", "*string tag = \"retagged\";"));
        string member_type_change = run(buildCommand(build_dir));
        assertNeq(member_type_aggregate_mtime, mtime(build_dir + "/script-aggregate.qo"),
            "a member type change rebuilds the script aggregate: " + member_type_change);
        assertNeq(member_type_consumer_mtime, mtime(consumer_object),
            "a member type change rebuilds the consumer object: " + member_type_change);
        assertEq(member_default_source_out, run(sprintf("LD_LIBRARY_PATH=%s QORE_MODULE_DIR=%s %s",
            qore_build_dir, build_dir + "/late-modules", build_dir + "/qo-static-host")),
            "the statically linked program runs the same after a member type change");
    }
}
