#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil

%exec-class AOTLValuePathCountTest

#! A compiled function can have more than 255 LValuePath instructions (#6127)
/** The slot map entry of a compiled function had the count of its LValuePath instructions as a u8: a function with
    300 of them was read back with 44 slots, and its 45th assignment through a lvalue path raised
    AOT-INTERNAL-ERROR ("LValuePath assign: slot 44 out of range").  The count is also written as a u32.
*/
class AOTLValuePathCountTest inherits QUnit::Test {
    private {
        string libqore_dir;
        string qcc_bin;
    }

    constructor() : QUnit::Test("AOTLValuePathCountTest", "1.0") {
        string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");
        addTestCase("qcc -O0: 300 assignments through lvalue paths", \countTest());
        set_return_value(main());
    }

    countTest() {
        TmpDir tmp("qore-aot-lvalue-path-count-");
        string script = tmp.path + DirSep + "lvalue-paths.q";
        string src = "%modern\nint sub f() {\n    hash<auto> h = {};\n";
        for (int i = 0; i < 300; ++i) {
            src += sprintf("    h.k%d.x = %d;\n", i, i);
        }
        src += "    return h.size();\n}\nprintf(\"%d\\n\", f());\n";
        File f();
        f.open2(script, O_CREAT | O_WRONLY | O_TRUNC);
        f.write(src);
        f.close();
        string exe = tmp.path + DirSep + "lvalue-paths";
        string out = backquote(sprintf("QORE_LIBDIR=%s %s -O0 -o %s %s 2>&1", libqore_dir, qcc_bin, exe, script));
        assertTrue(is_file(exe), "compiled the executable: " + out);
        out = backquote(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s %s 2>&1", libqore_dir, libqore_dir, exe));
        assertEq("300\n", out);
    }
}
