#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
string libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
string qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
    ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : dirname(qore_bin) + "/qcc");
if (!is_file(qcc_bin)) {
    qcc_bin = "qcc";
}

string code = "%modern

list<string> regular = (\"alpha\", \"beta\", \"gamma\");
list<string> sparse = (\"alpha\", \"beta\", \"gamma\");
delete sparse[1];
list<string> all_missing = (\"alpha\", \"beta\", \"gamma\");
delete all_missing[0];
delete all_missing[1];
delete all_missing[2];
list<string> empty = ();
list<string> singleton = (\"solo\",);

string eval_order;
list<string> sub methodValues() {
    eval_order += \"V\";
    return (\"left\", \"right\");
}
string sub methodSeparator() {
    eval_order += \"S\";
    return \"/\";
}
string ordered_result = methodValues().join(methodSeparator());

string latin1_separator = convert_encoding(\" / \", \"ISO-8859-1\");
list<string> mixed = (convert_encoding(\"caf\\u00e9\", \"ISO-8859-1\"), \"d\\u00e9j\\u00e0\");
string mixed_result = mixed.join(latin1_separator);

string encoding_exception = \"none\";
try {
    string ascii_separator = convert_encoding(\",\", \"US-ASCII\");
    list<string> incompatible = (\"ascii\", \"\\u00df\");
    auto unused = incompatible.join(ascii_separator);
} catch (hash<ExceptionInfo> ex) {
    encoding_exception = ex.err;
}

list<string> unassigned;
string unassigned_exception = \"none\";
try {
    auto unused = unassigned.join(\",\");
} catch (hash<ExceptionInfo> ex) {
    unassigned_exception = ex.err;
}

list<string> removed = (\"removed\",);
remove removed;
string removed_exception = \"none\";
try {
    auto unused = removed.join(\",\");
} catch (hash<ExceptionInfo> ex) {
    removed_exception = ex.err;
}

string identity_map_sparse_exception = \"none\";
try {
    auto unused = (map $1, sparse).join(\", \");
} catch (hash<ExceptionInfo> ex) {
    identity_map_sparse_exception = ex.err;
}

printf(\"%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s|%s\\n\",
    regular.join(\", \"),
    sparse.join(\", \"),
    all_missing.join(\", \"),
    empty.join(\", \"),
    singleton.join(\", \"),
    ordered_result,
    eval_order,
    convert_encoding(mixed_result, \"UTF-8\"),
    mixed_result.encoding(),
    encoding_exception,
    unassigned_exception,
    removed_exception,
    (map $1, regular).join(\", \"),
    (map $1, empty).join(\", \"),
    (map $1, singleton).join(\", \"),
    identity_map_sparse_exception);
";

string script_path = "/tmp/qore-aot-list-string-join-method-" + string(getpid()) + ".qr";
File script();
script.open2(script_path, O_WRONLY | O_CREAT | O_TRUNC);
script.write(code);
script.close();

string sub runMode(string mode) {
    return backquote(sprintf("LD_LIBRARY_PATH=%s %s -b --exec-mode=%s %s 2>&1",
        libqore_dir, qore_bin, mode, script_path));
}

string sub runAot(string suffix, string env) {
    string exe = "/tmp/qore-aot-list-string-join-method-" + string(getpid()) + suffix;
    string compile_out = backquote(sprintf("%s LD_LIBRARY_PATH=%s %s --strip-debug-info -O3 -o %s %s 2>&1",
        env, libqore_dir, qcc_bin, exe, script_path));
    if (!is_file(exe)) {
        printf("AOT compile failed (%s):\n%s", suffix, compile_out);
        exit(2);
    }
    string result = backquote(sprintf("LD_LIBRARY_PATH=%s %s 2>&1", libqore_dir, exe));
    unlink(exe);
    return result;
}

string expected = "alpha, beta, gamma|alpha, , gamma|, , ||solo|left/right|VS|"
    + "caf\u00e9 / d\u00e9j\u00e0|ISO-8859-1|ENCODING-CONVERSION-ERROR|"
    + "PSEUDO-METHOD-DOES-NOT-EXIST|PSEUDO-METHOD-DOES-NOT-EXIST|"
    + "alpha, beta, gamma||solo|RUNTIME-TYPE-ERROR\n";
foreach string mode in (("ast", "ir", "tiered", "jit")) {
    string actual = runMode(mode);
    if (actual != expected) {
        printf("mismatch in %s\nexpected:\n%sactual:\n%s", mode, expected, actual);
        exit(2);
    }
}

string ir_dump = backquote(sprintf("LD_LIBRARY_PATH=%s %s -b --exec-mode=ir --ir-dump %s 2>&1",
    libqore_dir, qore_bin, script_path));
if (ir_dump !~ /list\.string\.join/) {
    printf("typed list string join opcode missing from method IR dump:\n%s", ir_dump);
    exit(2);
}
if (ir_dump !~ /list\.string\.join\.identity-map/) {
    printf("identity-map list string join opcode missing from method IR dump:\n%s", ir_dump);
    exit(2);
}

hash<string, string> aot_modes = {
    "-enabled": "",
    "-fallback": "QORE_DISABLE_IR_LIST_STRING_JOIN_METHOD=1",
    "-identity-fallback": "QORE_DISABLE_IR_METHOD_IDENTITY_MAP_STRING_JOIN=1",
};
foreach string suffix in (keys aot_modes) {
    string actual = runAot(suffix, aot_modes{suffix});
    if (actual != expected) {
        printf("AOT mismatch in %s\nexpected:\n%sactual:\n%s", suffix, expected, actual);
        exit(2);
    }
}

unlink(script_path);
