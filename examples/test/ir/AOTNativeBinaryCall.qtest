#!/usr/bin/env qore
# Copyright (c) 2026 Qore Technologies, s.r.o.
# SPDX-License-Identifier: MIT
%modern
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil
%exec-class NativeBinaryCallTest

class NativeBinaryCallTest inherits QUnit::Test {
    private {
        string qore = realpath(ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0]);
        string libdir = realpath(ENV.QORE_LIBDIR ?? dirname(qore));
        string qcc = ENV.QCC ?? libdir + "/qcc";
    }
    constructor() : Test("native call binary arithmetic", "1.0", \ARGV) {
        addTestCase("binary arithmetic and boxed fallbacks", \check());
        set_return_value(main());
    }
    private static string quote(string value) {
        return "'" + replace(value, "'", "'\"'\"'") + "'";
    }
    private string run(list<string> args, string prefix = "") {
        int status;
        string output = backquote(prefix + "LD_LIBRARY_PATH=" + quote(libdir)
            + " DYLD_LIBRARY_PATH=" + quote(libdir)
            + " QORE_JIT_SYNC_COMPILE=1 QORE_IR_THRESHOLD=1 QORE_JIT_THRESHOLD=1 "
            + (map quote($1), args).join(" ") + " 2>&1", \status);
        assertEq(0, status, output);
        return output;
    }
    private string body(string ir, string name) {
        *list<*string> found = regex_extract(ir,
            "(?s)define [^\n]*@" + name + "_[^\n]*\\(ptr %ctx, ptr %xsink\\)[^\n]*\n(.*?)\n\\}");
        assertTrue(!!found, name + " normal LLVM entry");
        return found[0] ?? "";
    }
    private check() {
        string source = get_script_dir() + "/AOTNativeBinaryCall.qr";
        string expected = "native-binary-call: ok\n";
        foreach string mode in (("ast", "ir", "jit", "tiered")) {
            assertEq(expected, run((qore, "--exec-mode=" + mode, source)), mode);
        }
        TmpDir dir("qore-native-binary-call-");
        foreach string prefix in (("", "QORE_DISABLE_AOT_NATIVE_BINARY_CALL_ARITHMETIC=1 ",
                "QORE_DISABLE_AOT_NATIVE_CALL_ARITHMETIC=1 ",
                "QORE_DISABLE_AOT_NATIVE_FLOAT_CALL_ARITHMETIC=1 ",
                "QORE_AOT_EH=1 ", "QORE_DISABLE_AOT_FUNCREF_NATIVE_CONTINUATION=1 ",
                "QORE_DISABLE_AOT_NATIVE_METHOD_CONTINUATION=1 ",
                "QORE_DISABLE_AOT_RESOLVED_METHOD_NATIVE_CONTINUATION=1 ")) {
            foreach string level in (("-O0", "-O3")) {
                string executable = dir.path + "/fixture";
                string ir = run((qcc, level, "--strip-source", "-o", executable, source),
                    prefix + "QORE_DUMP_LLVM_IR=1 ");
                # Callback expressions use generic arithmetic; resolved typed methods use native opcodes.
                foreach string kind in (("Int", "Float")) {
                    foreach string operation in (("Add", "Sub", "Mul")) {
                        foreach string site in (("callback", "method")) {
                            string name = site + kind + operation;
                            bool enabled = site == "method" && prefix != "QORE_DISABLE_AOT_NATIVE_BINARY_CALL_ARITHMETIC=1 "
                                && prefix != "QORE_DISABLE_AOT_NATIVE_CALL_ARITHMETIC=1 "
                                && (kind != "Float"
                                    || prefix != "QORE_DISABLE_AOT_NATIVE_FLOAT_CALL_ARITHMETIC=1 ")
                                && (site == "callback"
                                    ? prefix != "QORE_DISABLE_AOT_FUNCREF_NATIVE_CONTINUATION=1 "
                                    : prefix != "QORE_DISABLE_AOT_NATIVE_METHOD_CONTINUATION=1 ");
                            assertEq(enabled, regex(body(ir, name), "native_call_converted_value"),
                                name + prefix + level);
                        }
                    }
                }
                foreach string name in (("multipleConsumers", "phiConsumer")) {
                    assertFalse(regex(body(ir, name), "native_call_converted_value"), name + " excluded result");
                }
                foreach string runtime in (("", "QORE_DISABLE_FUNCREF_FAST_CALL=1 ",
                        "QORE_DISABLE_AOT_NATIVE_METHOD_ENTRY=1 ",
                        "QORE_DISABLE_AOT_RESOLVED_METHOD_CACHE=1 ",
                        "QORE_DISABLE_AOT_NATIVE_METHOD_DEFERRED_CONTEXT=1 ")) {
                    assertEq(expected, run((executable,), runtime), prefix + level + runtime);
                }
            }
        }
    }
}
