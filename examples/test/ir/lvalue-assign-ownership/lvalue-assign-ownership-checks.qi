%allow-weak-references
%allow-opaque-references

/** Compiled code may hand the value assigned to an lvalue path over to the lvalue instead of copying a reference
    to it, when the value is not used again.  Each check reports values that show who owns what afterwards - the
    values held, and the objects destroyed - and the test requires every execution tier and a compiled module to
    report exactly what the AST interpreter reports.  Every check runs in its own function, so that the values it
    creates are released before the next one starts.
*/
public namespace LValueAssignOwnership {
#! an object that counts its destructions
public class Tracked {
    public {
        auto v;
        auto peer;
        int n = 0;

        static int destroyed = 0;
    }

    constructor(auto v) {
        self.v = v;
    }

    destructor() {
        ++Tracked::destroyed;
    }

    #! writes a new object into a member of self, as a constructor or method storing a child does
    setChild(int i) {
        peer = new Tracked(i);
    }

    #! appends a new object to a list in a member of self, with += or push
    addChild(int i, bool use_push) {
        if (use_push) {
            push peer, new Tracked(i);
        } else {
            peer += new Tracked(i);
        }
    }
}

#! the root of a graph whose nodes refer to it
public class GraphRoot {
    public {
        list<auto> nodes = ();
    }

    #! appends a new node that refers to this root to the list of nodes of this root, with += or push
    addNode(bool use_push) {
        if (use_push) {
            push nodes, new GraphNode(self);
        } else {
            nodes += new GraphNode(self);
        }
    }
}

#! a node of a graph that refers to its root
public class GraphNode {
    public {
        auto root;
    }

    constructor(auto root) {
        self.root = root;
    }
}

#! returns an object from a call, so that the value assigned is a call result
Tracked sub make(auto v) {
    return new Tracked(v);
}

#! objects written to a hash in a loop: each is held by the hash only
int sub hash_objects() {
    int d0 = Tracked::destroyed;
    {
        hash<auto> h = {};
        for (int i = 0; i < 10; ++i) {
            h{"k" + i} = new Tracked(i);
        }
        if (h.k7.v != 7 || h.size() != 10) {
            return -1;
        }
    }
    return Tracked::destroyed - d0;
}

#! call results written to object members, overwriting each other
int sub member_overwrite() {
    int d0 = Tracked::destroyed;
    int during;
    {
        Tracked holder(0);
        for (int i = 0; i < 10; ++i) {
            holder.peer = make(i);
        }
        during = Tracked::destroyed - d0;
        if (holder.peer.v != 9) {
            return -1;
        }
    }
    # 9 overwritten while the holder lived, then the holder and the last value
    return during * 100 + (Tracked::destroyed - d0);
}

#! the result of the assignment is used: the value is held by the lvalue and by the result
int sub result_used() {
    int d0 = Tracked::destroyed;
    int same;
    {
        hash<auto> h = {};
        Tracked r = (h.a = new Tracked(1));
        same = (r == h.a) ? 1 : 0;
        remove h.a;
        # the result still holds the object
        same += (Tracked::destroyed == d0) ? 10 : 0;
    }
    return same * 100 + (Tracked::destroyed - d0);
}

#! a constant list assigned repeatedly: the constant must never be handed over or changed
int sub constant_value() {
    hash<auto> h = {};
    for (int i = 0; i < 5; ++i) {
        h{"k" + i} = (1, 2, 3);
        h{"k" + i} += i;
    }
    # every assignment got the constant's value, not a list another iteration changed
    int sum = 0;
    foreach string k in (keys h) {
        sum += h{k}.size() * 1000 + h{k}.last();
    }
    return sum;
}

#! a value computed once before a loop and assigned in every iteration
string sub loop_invariant(string a, string b) {
    hash<auto> h = {};
    for (int i = 0; i < 5; ++i) {
        h{"k" + i} = a + b;
    }
    return foldl $1 + "|" + $2, h.values();
}

#! a typed hash with a single key
public hashdecl OwnershipDecl {
    int a = 1;
}

#! assigns a new object to a key the hash's type does not declare; the assignment is not in a try block, so compiled
#! code hands the value over to the assignment, which must release it when the key is refused
sub assign_to_undeclared_key(hash<OwnershipDecl> h, string key) {
    h{key} = new Tracked(1);
}

#! an object that fails to be assigned because the key is refused: it is released once, before the handler runs
int sub navigation_error() {
    int d0 = Tracked::destroyed;
    hash<OwnershipDecl> h();
    try {
        # a key only known at run time
        assign_to_undeclared_key(h, "no_" + "such");
    } catch (hash<ExceptionInfo> ex) {
        return (Tracked::destroyed - d0) * 10 + (ex.err ? 1 : 0);
    }
    return -1;
}

#! returns an object as auto, so that a type error is only found when it is assigned
auto sub make_untyped() {
    return new Tracked(2);
}

#! an object with a typed member
public class TypedHolder {
    public {
        int m = 0;
    }

    #! assigns a value that the member's type refuses
    setBad() {
        m = make_untyped();
    }
}

#! a method assigning a value to a member of self that refuses its type: it is released once, by the assignment
int sub self_member_type_error() {
    int d0 = Tracked::destroyed;
    TypedHolder h();
    try {
        h.setBad();
    } catch (hash<ExceptionInfo> ex) {
        return (Tracked::destroyed - d0) * 10 + (ex.err == "RUNTIME-TYPE-ERROR" ? 1 : 0);
    }
    return -1;
}

#! a weak assignment of a new object: nothing else holds it, so it is destroyed
int sub weak_assign() {
    int d0 = Tracked::destroyed;
    hash<auto> h = {};
    h.a := new Tracked(1);
    return Tracked::destroyed - d0;
}

#! an opaque assignment of a new object: the hash owns it
int sub opaque_assign() {
    int d0 = Tracked::destroyed;
    int during;
    {
        hash<auto> h = {};
        h.a @= new Tracked(1);
        during = Tracked::destroyed - d0;
        if (h.a.v != 1) {
            return -1;
        }
    }
    return during * 100 + (Tracked::destroyed - d0);
}

#! a method storing a new object in a member of self
int sub self_member() {
    int d0 = Tracked::destroyed;
    {
        Tracked t(0);
        for (int i = 0; i < 5; ++i) {
            t.setChild(i);
        }
        if (t.peer.v != 4) {
            return -1;
        }
    }
    return Tracked::destroyed - d0;
}

#! a new object that references its holder, written to the holder: a cycle collected when released
int sub cycle_write() {
    int d0 = Tracked::destroyed;
    {
        list<Tracked> l = (new Tracked(0),);
        for (int i = 0; i < 5; ++i) {
            Tracked child(i);
            child.peer = l[0];
            l[0].peer = new Tracked(child);
        }
    }
    return Tracked::destroyed - d0;
}

#! a fresh container assigned to a hash key and then changed through the key
string sub container_write() {
    hash<auto> h = {};
    h.a = {"x": 1};
    h.a.y = 2;
    h.b = (1, 2);
    h.b += 3;
    return sprintf("%y", h);
}

#! objects appended to lists in a hash with +=, push and unshift: each is held by its list only
int sub list_appends() {
    int d0 = Tracked::destroyed;
    int during;
    {
        hash<auto> h = {"a": (), "b": (), "c": ()};
        for (int i = 0; i < 5; ++i) {
            h.a += new Tracked(i);
            push h.b, new Tracked(i);
            unshift h.c, new Tracked(i);
        }
        if (h.a[4].v != 4 || h.b[4].v != 4 || h.c[0].v != 4) {
            return -1;
        }
        during = Tracked::destroyed - d0;
    }
    return during * 100 + (Tracked::destroyed - d0);
}

#! a value computed once before a loop and appended in every iteration: it is never handed over
string sub append_loop_invariant(string a, string b) {
    hash<auto> h = {"l": ()};
    for (int i = 0; i < 3; ++i) {
        h.l += a + b;
        push h.l, a + b;
    }
    return h.l.join("|");
}

#! pushes a new object to a list that refuses its type; the push is not in a try block, so compiled code hands the
#! value over to the push, which must release it when the list refuses it
sub push_refused(hash<auto> h) {
    push h.l, make_untyped();
}

#! a value pushed to a list that refuses its type is released once, before the handler runs
int sub append_type_error() {
    int d0 = Tracked::destroyed;
    hash<auto> h = {"l": cast<list<int>>((1,))};
    try {
        push_refused(h);
    } catch (hash<ExceptionInfo> ex) {
        return (Tracked::destroyed - d0) * 10 + (ex.err ? 1 : 0);
    }
    return -1;
}

#! the result of += is used: the list holds the value, and so does the result
int sub append_result_used() {
    int d0 = Tracked::destroyed;
    int rv;
    {
        hash<auto> h = {"l": ()};
        list<auto> r = (h.l += new Tracked(1));
        remove h.l;
        rv = (r[0].v == 1 && Tracked::destroyed == d0) ? 1 : 0;
    }
    return rv * 10 + (Tracked::destroyed - d0);
}

#! a method appending new objects to a member of self with += and push
int sub self_member_appends() {
    int d0 = Tracked::destroyed;
    {
        Tracked t(0);
        t.peer = ();
        for (int i = 0; i < 4; ++i) {
            t.addChild(i, (i % 2) == 1);
        }
        if (t.peer.size() != 4) {
            return -1;
        }
    }
    return Tracked::destroyed - d0;
}

#! new nodes that refer to their root appended to the root's list: cycles collected when the root is released
int sub append_cycles() {
    int d0 = Tracked::destroyed;
    {
        Tracked root(0);
        root.peer = ();
        for (int i = 0; i < 4; ++i) {
            Tracked child(root);
            root.peer += child;
            push root.peer, new Tracked(root);
        }
    }
    return Tracked::destroyed - d0;
}

#! the objects that the recursive-reference scans enter while new nodes are appended to a graph held by a local
/** The constructor of a node defers the scan of the new node, as its self holds a real reference; a dereference
    after the node has been linked into the graph would make the scan, which walks the whole graph.  The AST
    interpreter hands the node over to the list, so the scans enter no object; the scans are only counted in debug
    builds.
*/
int sub append_scans() {
    if (!Option::HAVE_LIBRARY_DEBUGGING) {
        return 0;
    }
    GraphRoot root();
    int start = call_function("dbg_get_scan_object_count");
    for (int i = 0; i < 64; ++i) {
        root.nodes += new GraphNode(root);
        push root.nodes, new GraphNode(root);
        unshift root.nodes, new GraphNode(root);
        root.addNode((i % 2) == 1);
    }
    int rv = call_function("dbg_get_scan_object_count") - start;
    # the graph is collected when the root is released
    foreach GraphNode node in (root.nodes) {
        node.root = NOTHING;
    }
    return rv;
}

#! Returns the result of every check
public hash<string, auto> sub get_results() {
    return {
        "hash-objects": hash_objects(),
        "member-overwrite": member_overwrite(),
        "result-used": result_used(),
        "constant-value": constant_value(),
        "loop-invariant": loop_invariant("x", "y"),
        "navigation-error": navigation_error(),
        "self-member-type-error": self_member_type_error(),
        "weak-assign": weak_assign(),
        "opaque-assign": opaque_assign(),
        "self-member": self_member(),
        "cycle-write": cycle_write(),
        "container-write": container_write(),
        "list-appends": list_appends(),
        "append-loop-invariant": append_loop_invariant("x", "y"),
        "append-type-error": append_type_error(),
        "append-result-used": append_result_used(),
        "self-member-appends": self_member_appends(),
        "append-cycles": append_cycles(),
        "append-scans": append_scans(),
    };
}
}
