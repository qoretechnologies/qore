# Copyright (c) 2026 Qore Technologies, s.r.o.
# SPDX-License-Identifier: MIT
%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil
%exec-class FloatComparisonSummaryTest

class FloatComparisonSummaryTest inherits QUnit::Test {
    private {
        string qore = realpath(ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0]);
        string libdir = realpath(ENV.QORE_LIBDIR ?? dirname(qore));
        string qcc = ENV.QCC ?? libdir + "/qcc";
        const Expected = "float-comparison-summary: ok\n";
    }
    constructor() : Test("float comparison summaries", "1.0", \ARGV) {
        addTestCase("native callbacks and checked fallbacks", \check());
        addTestCase("optional cross-object summary metadata", \crossObject());
        set_return_value(main());
    }
    private static string quote(string value) {
        return "'" + replace(value, "'", "'\"'\"'") + "'";
    }
    private string run(list<string> args, string prefix = "") {
        int status;
        string output = backquote(prefix + "LD_LIBRARY_PATH=" + quote(libdir)
            + " DYLD_LIBRARY_PATH=" + quote(libdir) + " QORE_JIT_SYNC_COMPILE=1 "
            + (map quote($1), args).join(" ") + " 2>&1", \status);
        assertEq(0, status, output);
        return output;
    }
    private string combined(string dir) {
        string path = dir + "/combined.qr";
        File output();
        output.open2(path, O_WRONLY | O_CREAT | O_TRUNC);
        output.write(ReadOnlyFile::readTextFile(get_script_dir() + "/AOTFloatComparisonProvider.qr")
            + "\n" + ReadOnlyFile::readTextFile(get_script_dir() + "/AOTFloatComparisonConsumer.qr") + "\nmain();\n");
        output.close();
        return path;
    }
    private check() {
        TmpDir dir("qore-float-comparison-");
        string source = combined(dir.path);
        foreach string mode in (("ast", "ir", "jit", "tiered")) {
            assertEq(Expected, run((qore, "--exec-mode=" + mode, source)), mode);
        }
        foreach string prefix in (("", "QORE_DISABLE_AOT_FLOAT_EXPRESSION_IMPORT=1 ",
                "QORE_DISABLE_AOT_FUNCREF_NATIVE_ENTRY=1 ", "QORE_DISABLE_AOT_TYPED_FUNCREF_CALL=1 ",
                "QORE_DISABLE_AOT_FUNCREF_CALLEE_RUNTIME_CONFIG=1 ",
                "QORE_DISABLE_AOT_FUNCREF_INLINE_STACK_CHECK=1 ", "QORE_AOT_EH=1 ",
                "QORE_AOT_NO_DEBUG_INFO=1 ", "MAKEFLAGS= QCC_JOBS=4 QCC_SPLIT_THRESHOLD=1 ")) {
            foreach string level in (("-O0", "-O3")) {
                string executable = dir.path + "/fixture";
                string ir = run((qcc, level, "--strip-source", "-o", executable, source),
                    prefix + "QORE_DUMP_LLVM_IR=1 ");
                bool typed = !prefix.startsWith("QORE_DISABLE_AOT_FLOAT_EXPRESSION_IMPORT")
                    && !prefix.startsWith("QORE_DISABLE_AOT_FUNCREF_NATIVE_ENTRY")
                    && !prefix.startsWith("QORE_DISABLE_AOT_TYPED_FUNCREF_CALL");
                foreach string name in (("cmpEq", "cmpNe", "cmpLt", "cmpLe", "cmpGt", "cmpGe",
                        "cmpRightEq", "cmpRightNe", "cmpRightLt", "cmpRightLe", "cmpRightGt", "cmpRightGe",
                        "cmpIf", "cmpNested", "cmpSignedZero")) {
                    assertEq(typed, regex(ir, name + "[^\n]*funcref_typed_v1"), "typed entry: " + name);
                    assertEq(typed && !prefix.startsWith("QORE_DISABLE_AOT_FUNCREF_CALLEE_RUNTIME_CONFIG"),
                        regex(ir, name + "[^\n]*funcref_typed_v2"), "explicit-context entry: " + name);
                    assertEq(typed && !prefix.startsWith("QORE_DISABLE_AOT_FUNCREF_CALLEE_RUNTIME_CONFIG")
                            && !prefix.startsWith("QORE_DISABLE_AOT_FUNCREF_INLINE_STACK_CHECK"),
                        regex(ir, name + "[^\n]*funcref_typed_v3"), "inline-stack entry: " + name);
                }
                assertEq(False, ir =~ /cmpDivision[^\n]*funcref_typed_v[12]/,
                    "division stays outside scalar callback admission");
                assertEq(False, ir =~ /cmpNestedDivision[^\n]*funcref_typed_v[12]/,
                    "composed division stays outside scalar callback admission");
                assertEq(False, ir =~ /cmpEffect[^\n]*funcref_typed_v[12]/,
                    "side effects stay outside scalar callback admission");
                assertEq(Expected, run((executable,)), "AOT " + level);
                assertEq(Expected, run((executable,), "QORE_DISABLE_FUNCREF_FAST_CALL=1 "), "runtime fallback");
            }
        }
    }
    private crossObject() {
        TmpDir dir("qore-float-comparison-import-");
        string provider = get_script_dir() + "/AOTFloatComparisonProvider.qr";
        string consumer = get_script_dir() + "/AOTFloatComparisonConsumer.qr";
        string provider_qo = dir.path + "/AOTFloatComparisonProvider.qo";
        string consumer_qo = dir.path + "/AOTFloatComparisonConsumer.qo";
        run((qcc, "-O3", "-c", "--strip-source", "--output-dir=" + dir.path, provider));
        string index = run((qcc, "--dump-index-json", provider_qo));
        assertRegex("\"qore_path\": \"cmpEq\\(float\\)\"[^\n]*\"float_expression_nodes\": \\[\\{", index);
        assertRegex("\"qore_path\": \"cmpDivision\\(float\\)\"[^\n]*\"float_expression_nodes\": \\[\\]", index);
        assertRegex("\"qore_path\": \"cmpNestedDivision\\(float\\)\"[^\n]*\"float_expression_nodes\": \\[\\]", index);
        assertRegex("\"qore_path\": \"cmpEffect\\(float\\)\"[^\n]*\"float_expression_nodes\": \\[\\]", index);
        foreach string prefix in (("", "QORE_DISABLE_AOT_FLOAT_EXPRESSION_IMPORT=1 ")) {
            string ir = run((qcc, "-O3", "-c", "-L", dir.path, "--output-dir=" + dir.path, consumer),
                prefix + "QORE_DUMP_LLVM_IR=1 ");
            assertEq(prefix.val(), ir =~ /call double @cmpEq[^\n]*fast/,
                "cross-object float summary replaces the direct native call");
            string exe = dir.path + "/linked";
            run((qcc, "-O3", "-o", exe, provider_qo, consumer_qo));
            assertEq(Expected, run((exe,)), "linked comparison summary");
        }
    }
}
