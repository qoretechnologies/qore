#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes

%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../ExecModeHarness.qm

%include exec-mode-output-test.qc

%exec-class ExceptionExitHandlerLocalUpdateTest

#! Regression test: a handler that assigns to or removes a local of a block left by an exception (qore#5942)
/** The value that a handler of a block left by an exception replaces or removes is released where the handler does
    so, and the value it assigns is released with the frame's locals, as with the AST interpreter.  Native code runs
    such handlers out of line, and gave them a counted copy of each local in a slot cache while its own cache of the
    local kept another reference, so that the handler's assignment or remove released only a copy and the old value
    was destroyed after the other locals of the frame (or after the catch block of a try block left by the
    exception): the native code now publishes the locals to the runtime stack, where the handlers read and assign
    them, and releases its own references to them before the handlers run, and reloads its caches afterwards
    (QoreIRToLLVM::publishLocalsForHandlers()).  The local is referenced by the handler, so it is never IR-only
    (QoreIRFunction::computeIROnlyLocals()).  The script runs every case twice, in every execution mode (with
    native compilation at the first call, so that JIT and tiered execution run native code), on the IR tier of
    tiered execution and as qcc executables compiled at -O0 and -O3 (see ExecModeOutputTest).
*/
class ExceptionExitHandlerLocalUpdateTest inherits ExecModeOutputTest {
    public {
        #! the script run in every execution mode
        const Script = '%modern
class T {
    public { string n; }
    constructor(string n) { self.n = n; }
    destructor() { printf("dtor %s\n", n); }
}
# a handler that assigns to a local while an exception leaves the function
sub assign() {
    T a("ga");
    on_exit { printf("on_exit assign\n"); a = new T("ga2"); printf("after assign\n"); }
    T b("gb");
    printf("%s%s\n", b.n, a.n);
    throw "A";
}
# a handler that removes a local while an exception leaves the function
sub removeLocal() {
    T a("ra");
    on_error { printf("on_error remove\n"); remove a; printf("after remove\n"); }
    T b("rb");
    printf("%s%s\n", b.n, a.n);
    throw "R";
}
# a handler that assigns to a local twice, and untyped locals
sub assignTwice() {
    auto a = new T("ta");
    on_exit {
        printf("on_exit twice\n");
        a = new T("ta2");
        printf("after first\n");
        a = new T("ta3");
        printf("after second\n");
    }
    auto b = new T("tb");
    printf("%s%s\n", b.n, a.n);
    throw "T";
}
# the handlers of a try block left by an exception that the function catches
string sub caught() {
    T a("ca");
    T r("cr");
    try {
        on_exit { printf("block on_exit assign\n"); a = new T("ca2"); printf("after block assign\n"); }
        on_error { printf("block on_error remove\n"); remove r; printf("after block remove\n"); }
        throw "C";
    } catch (hash<ExceptionInfo> ex) {
        printf("caught %s\n", ex.err);
    }
    printf("after catch: %s %y\n", a.n, r ? r.n : NOTHING);
    return a.n;
}
# a handler that reads the local after the assignment of another handler
sub readAfter() {
    T a("ea");
    on_exit { printf("on_exit reads %s\n", a.n); }
    on_error { printf("on_error assign\n"); a = new T("ea2"); printf("after assign\n"); }
    throw "E";
}
for (int i = 0; i < 2; ++i) {
    try { assign(); } catch (hash<ExceptionInfo> ex) { printf("caught %s\n", ex.err); }
    try { removeLocal(); } catch (hash<ExceptionInfo> ex) { printf("caught %s\n", ex.err); }
    try { assignTwice(); } catch (hash<ExceptionInfo> ex) { printf("caught %s\n", ex.err); }
    printf("returned %s\n", caught());
    try { readAfter(); } catch (hash<ExceptionInfo> ex) { printf("caught %s\n", ex.err); }
    printf("--\n");
}
';

        #! the AST interpreter's output of one iteration of the script's loop
        const ExpectedOnce = (
            "gbga",
            "on_exit assign",
            "dtor ga",
            "after assign",
            "dtor gb",
            "dtor ga2",
            "caught A",
            "rbra",
            "on_error remove",
            "dtor ra",
            "after remove",
            "dtor rb",
            "caught R",
            "tbta",
            "on_exit twice",
            "dtor ta",
            "after first",
            "dtor ta2",
            "after second",
            "dtor tb",
            "dtor ta3",
            "caught T",
            "block on_error remove",
            "dtor cr",
            "after block remove",
            "block on_exit assign",
            "dtor ca",
            "after block assign",
            "caught C",
            "after catch: ca2 null",
            "dtor ca2",
            "returned ca2",
            "on_error assign",
            "dtor ea",
            "after assign",
            "on_exit reads ea2",
            "dtor ea2",
            "caught E",
            "--",
        );
    }

    constructor() : ExecModeOutputTest("ExceptionExitHandlerLocalUpdate", Script,
            (map $1 + "\n", ExpectedOnce + ExpectedOnce).join(""),
            "releases the value that a handler of a block left by an exception replaces or removes where the "
            "handler does so", NOTHING, NOTHING, ("-O0", "-O3")) {
    }
}
