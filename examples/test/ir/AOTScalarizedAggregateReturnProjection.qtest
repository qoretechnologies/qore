#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
string libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
string qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
    ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : dirname(qore_bin) + "/qcc");
if (!is_file(qcc_bin)) {
    qcc_bin = "qcc";
}

string code = "%modern

hashdecl ReturnPair {
    int left;
    int right;
}

hash<string, int> sub hashProducer(int value) {
    hash<string, int> values = {\"left\": value, \"right\": value + 1};
    values.left += 1;
    values.right += 2;
    return values;
}

list<int> sub listProducer(int value) {
    list<int> values = (value, value + 1);
    values[0] += 1;
    values[1] += 2;
    return values;
}

ReturnPair sub hashdeclProducer(int value) {
    ReturnPair values((\"left\": value, \"right\": value + 1));
    values.left += 1;
    values.right += 2;
    return values;
}

int sub aggregateKernel(int rounds) {
    int checksum = 0;
    for (int i = 0; i < rounds; ++i) {
        checksum += hashProducer(i).left + hashProducer(i).right;
        checksum += listProducer(i)[0] + listProducer(i)[1];
        checksum += hashdeclProducer(i).left + hashdeclProducer(i).right;
    }
    return checksum;
}

int sub maybeAssignedKernel(bool assign, int value) {
    int candidate;
    if (assign) {
        candidate = value;
    }
    return hashProducer(candidate).left;
}

printf(\"%d:%d\\n\", aggregateKernel(1000),
    maybeAssignedKernel(True, 7));
";

string src = "/tmp/qore-aot-scalarized-aggregate-return-" + string(getpid()) + ".qr";
string exe = "/tmp/qore-aot-scalarized-aggregate-return-" + string(getpid());
string disabled = exe + "-disabled";
string scalar_disabled = exe + "-scalar-disabled";
File source();
source.open2(src, O_WRONLY | O_CREAT | O_TRUNC);
source.write(code);
source.close();

string sub compile(string out, string env) {
    string compile_out = backquote(sprintf(
        "%s LD_LIBRARY_PATH=%s %s -O3 -o %s %s 2>&1",
        env, libqore_dir, qcc_bin, out, src));
    if (!is_file(out)) {
        printf("AOT compile failed:\n%s", compile_out);
        exit(2);
    }
    return compile_out;
}

string enabled_compile = compile(exe, "QORE_IR_OPT_STATS=1");
string disabled_compile = compile(disabled,
    "QORE_IR_OPT_STATS=1 QORE_DISABLE_AOT_AGGREGATE_RETURN_PROJECTION=1");
string scalar_disabled_compile = compile(scalar_disabled,
    "QORE_IR_OPT_STATS=1 QORE_DISABLE_IR_FIXED_AGGREGATE_MUTATION_SCALAR_REPLACEMENT=1");
if (enabled_compile
        !~ /IR-OPT-AOT-EFFECTS: aggregateKernel[^:]*:.*aggregate-projections=6/) {
    printf("missing scalarized aggregate-return projections:\n%s", enabled_compile);
    exit(2);
}
if (enabled_compile
        =~ /IR-OPT-AOT-EFFECTS: maybeAssignedKernel[^:]*:.*aggregate-projections=[1-9]/
        || disabled_compile =~ /aggregate-projections=[1-9]/
        || scalar_disabled_compile =~ /aggregate-projections=[1-9]/) {
    printf("unsafe or disabled scalarized aggregate-return projection:\n%s\n%s\n%s",
        enabled_compile, disabled_compile, scalar_disabled_compile);
    exit(2);
}

string expected = "3009000:8\n";
foreach string mode in (("ast", "ir", "tiered", "jit")) {
    string actual = backquote(sprintf(
        "LD_LIBRARY_PATH=%s %s -b --exec-mode=%s %s 2>&1",
        libqore_dir, qore_bin, mode, src));
    if (actual != expected) {
        printf("mismatch in %s\nexpected:\n%sactual:\n%s",
            mode, expected, actual);
        exit(2);
    }
}
foreach string path in ((exe, disabled, scalar_disabled)) {
    string actual = backquote(sprintf(
        "LD_LIBRARY_PATH=%s %s 2>&1", libqore_dir, path));
    if (actual != expected) {
        printf("AOT mismatch for %s\nexpected:\n%sactual:\n%s",
            path, expected, actual);
        exit(2);
    }
}

unlink(src);
unlink(exe);
unlink(disabled);
unlink(scalar_disabled);
