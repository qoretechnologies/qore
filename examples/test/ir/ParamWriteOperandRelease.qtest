#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - AOT code generation and linking of qcc executables
# Copyright (C) 2026 Qore Technologies, s.r.o.
# SPDX-License-Identifier: MIT
# test-exec-mode: children - its checks run in child processes that set their own execution modes

%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires ../TestInterpreter.qm
%requires FsUtil
%requires ../ExecModeHarness.qm

%exec-class ParamWriteOperandReleaseTest

#! A parameter's write releases the value of a functional operator or a value read through a reference
/** The AST interpreter's map and hash map operators push the values of their expressions into the result container,
    a fold releases its source when it has run, and a value read through a reference is held by the argument list
    only; each is then held by the parameter alone, so a write of the parameter destroys the objects before the
    callee continues (issue #6262).  The script (ParamWriteOperandRelease.qr) logs the destructions for map, map with
    select, hash map and hash map with select, folds over lists and single values, the operators' values given to
    functions, methods, static methods and closures, and values read through references by a parameter and by a local
    passed on to a function, a method, a static method and a closure that write the referenced variable and the
    parameter, from functions and from top-level code; every execution mode, tiered execution on the IR tier and qcc
    executables at -O0 and -O3 (with and without QORE_AOT_EH) must give the AST interpreter's output.
*/
class ParamWriteOperandReleaseTest inherits QUnit::Test {
    private {
        string qore = TestInterpreter::qore_interpreter();
        string libdir = ENV.QORE_LIBDIR ?? dirname(qore);
        string qcc = ENV.QCC ?? (is_file(libdir + "/qcc") ? libdir + "/qcc" : dirname(qore) + "/qcc");
        string script = get_script_dir() + "/ParamWriteOperandRelease.qr";
        string env;
        *string expected;

        #! the lines of the AST interpreter's output that must precede another one: (earlier, later)
        const Order = (
            # the operand of a cast lives until the statement ends (issue #5712)
            ("after write cast", "dtor cast"),
            ("dtor map1", "after write map"),
            ("dtor map2", "after write map"),
            ("dtor msel2", "after write msel"),
            ("dtor hmap1", "after write hmap"),
            ("dtor hmap2", "after write hmap"),
            ("dtor hsel1", "after write hsel"),
            ("dtor hsel2", "after write hsel"),
            ("dtor iter1", "after write iter"),
            ("dtor iter2", "after write iter"),
            ("dtor hiter1", "after write hiter"),
            ("dtor nest1", "after write nest"),
            ("dtor mapn", "after write mapn"),
            ("dtor seln", "after write seln"),
            ("dtor foldx", "after write foldx"),
            ("dtor foldn", "after write foldn"),
            ("dtor flb", "dtor fla"),
            ("dtor fla", "after write fl"),
            ("dtor fra", "dtor frb"),
            ("dtor frb", "after write fr"),
            ("dtor frx", "after write frx"),
            ("dtor ftb", "dtor fta"),
            ("dtor fta", "after write ft"),
            ("dtor mmap1", "after write mmap"),
            ("dtor mfold", "after write mfold"),
            ("dtor sfold", "after write sfold"),
            ("dtor smap1", "after write smap"),
            ("dtor cfold", "after write cfold"),
            ("dtor cmap1", "after write cmap"),
            ("dtor ref", "after write ref"),
            ("dtor mref", "after write mref"),
            ("dtor sref", "after write sref"),
            ("dtor cref", "after write cref"),
            ("dtor lref", "after write lref"),
            ("dtor top-map2", "after write top-map"),
            ("dtor top-fla", "after write top-fl"),
            ("dtor top-foldx", "after write top-foldx"),
            ("dtor top-ref", "after write top-ref"),
        );
    }

    constructor() : Test("ParamWriteOperandRelease", "1.0", \ARGV) {
        env = sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s ", libdir, libdir);
        addTestCase("the AST interpreter destroys a parameter's argument at the parameter's write", \testAst());
        addTestCase("every execution mode destroys a parameter's argument at the parameter's write", \testModes());
        addTestCase("compiled executables destroy a parameter's argument at the parameter's write", \testAot());
        set_return_value(main());
    }

    private string getExpected() {
        if (!expected) {
            expected = ExecModeHarness::run(sprintf("%s%s -b --enable-debug --exec-mode=ast %s", env, qore,
                script));
        }
        return expected;
    }

    testAst() {
        list<string> lines = getExpected().split("\n");
        assertEq("round end 2", lines.last() ?: lines[lines.size() - 2]);
        # the index of the first occurrence of each line
        hash<string, int> index();
        foreach string line in (lines) {
            if (!exists index{line}) {
                index{line} = $#;
            }
        }
        foreach list<string> order in (Order) {
            *int before = index{order[0]};
            *int after = index{order[1]};
            assertTrue(exists before && exists after && before < after, sprintf("%y before %y", order[0], order[1]));
        }
    }

    testModes() {
        string exp = getExpected();
        hash<string, list<string>> wrong();
        foreach string mode in (ExecModeHarness::ExecModes + ExecModeHarness::IRTierName) {
            bool ir_tier = mode == ExecModeHarness::IRTierName;
            string cmd = sprintf("%s%s -b --enable-debug --exec-mode=%s %s", env, qore, ir_tier ? "tiered" : mode,
                script);
            string actual = ir_tier ? ExecModeHarness::run_ir_tier(cmd) : ExecModeHarness::run(cmd);
            list<string> diff = differences(exp, actual);
            if (diff) {
                wrong{mode} = diff;
            }
        }
        # native code compiled before the code that calls it runs, and call sites that the IR interpreter ran inline
        # calling a callee once it is compiled
        foreach string control in (("QORE_JIT_SYNC_COMPILE=1 QORE_IR_THRESHOLD=1 QORE_JIT_THRESHOLD=1 ",
                "QORE_JIT_SYNC_COMPILE=1 QORE_IR_THRESHOLD=1 QORE_JIT_THRESHOLD=20 ")) {
            foreach string mode in (("jit", "tiered")) {
                string actual = ExecModeHarness::run(sprintf("%s%s%s -b --enable-debug --exec-mode=%s %s", env,
                    control, qore, mode, script));
                list<string> diff = differences(exp, actual);
                if (diff) {
                    wrong{control + mode} = diff;
                }
            }
        }
        assertEq({}, wrong);
    }

    testAot() {
        string exp = getExpected();
        TmpDir tmp("qore-param-write-operand-release-");
        hash<string, list<string>> wrong();
        # QORE_AOT_EH is read when the code is compiled
        foreach string level in (("-O0", "-O3")) {
            foreach string prefix in (("", "QORE_AOT_EH=1 ")) {
                string exe = tmp.path + DirSep + "fixture" + level;
                string out = backquote(sprintf("%s%s%s %s -o %s %s 2>&1", env, prefix, qcc, level, exe, script));
                assertTrue(is_file(exe), "compiled the executable: " + out);
                list<string> diff = differences(exp, ExecModeHarness::run_any(env + exe));
                if (diff) {
                    wrong{prefix + level} = diff;
                }
                unlink(exe);
            }
        }
        assertEq({}, wrong);
    }

    #! returns the lines of the output that differ from the expected output, as "expected -> actual"
    static list<string> differences(string exp, string actual) {
        list<string> el = exp.split("\n");
        list<string> al = actual.split("\n");
        list<string> rv = ();
        for (int i = 0; i < max(el.size(), al.size()); ++i) {
            if (el[i] !== al[i]) {
                rv += sprintf("%d: %y -> %y", i, el[i], al[i]);
            }
        }
        return rv;
    }
}
