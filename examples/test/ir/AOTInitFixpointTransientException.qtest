#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil

%exec-class AOTInitFixpointTransientExceptionTest

# Regression coverage for pass-0 AOT init fixpoint retries.  A lazy static-var
# read can temporarily return NOTHING while its dependencies are still pending,
# which may surface as a normal overload/type error rather than
# AOT-PENDING-CONSTANT.  The descriptor must remain retryable until the pass-0
# fixpoint settles.
class AOTInitFixpointTransientExceptionTest inherits QUnit::Test {
    private {
        string qcc_bin;
        string qore_bin;
        string libqore_dir;
    }

    constructor() : QUnit::Test("AOTInitFixpointTransientExceptionTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
            ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");

        addTestCase("script qo init retries transient non-pending static-var errors",
            \testScriptQoInitRetriesTransientStaticVarError());

        set_return_value(main());
    }

    private string run(string cmd) {
        return backquote(cmd + " 2>&1");
    }

    private write(string path, string body) {
        File f();
        f.open2(path, O_WRONLY | O_CREAT | O_TRUNC);
        f.write(body);
    }

    testScriptQoInitRetriesTransientStaticVarError() {
        TmpDir tmp("qore-aot-init-fixpoint-");
        string tmp_dir = tmp.path;
        string qo_dir = tmp_dir + "/qo";
        mkdir(qo_dir);

        string src = tmp_dir + "/fixpoint.qr";
        string app = tmp_dir + "/fixpoint";

        write(src, "%modern
%require-types

class ZAOTFixpointDep {
    public {
        const Fields = {
            \"name\": \"dep\",
        };
    }
}

class YAOTFixpointThing {
    private {
        string n;
    }

    public constructor(hash<auto> fields) {
        n = fields.name;
    }

    public string name() {
        return n;
    }
}

class BAOTFixpointManager {
    public {
        static YAOTFixpointThing thing = new YAOTFixpointThing(ZAOTFixpointDep::Fields);
    }
}

class AAOTFixpointConsumer {
    public {
        const Value = BAOTFixpointManager::thing.name();
    }
}

int sub emit() {
    printf(\"%s\\n\", AAOTFixpointConsumer::Value);
    return 0;
}

int sub main() {
    return emit();
}

main();
");

        string env = sprintf("LD_LIBRARY_PATH=%s QORE_LIBDIR=%s", libqore_dir, libqore_dir);
        string interpreted = run(sprintf("%s %s", qore_bin, src));
        assertEq("dep\n", interpreted, "source script result: " + interpreted);

        string compile_out = run(sprintf("%s %s -c --output-dir=%s %s", env, qcc_bin, qo_dir, src));
        assertTrue(compile_out.find("script-context .qo") != -1,
            "qcc emitted script .qo: " + compile_out);

        string link_out = run(sprintf("%s %s -o %s %s/*.qo", env, qcc_bin, app, qo_dir));
        assertTrue(is_file(app), "qcc linked script .qo executable: " + link_out);

        string compiled = run(sprintf("LD_LIBRARY_PATH=%s %s", libqore_dir, app));
        assertEq(interpreted, compiled, "linked script .qo result matches source mode: " + compiled);
    }
}
