#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil

%exec-class AOTStreamingOperatorsTest

class AOTStreamingOperatorsTest inherits QUnit::Test {
    private {
        string qore_bin;
        string qcc_bin;
        string libqore_dir;
    }

    constructor() : QUnit::Test("AOTStreamingOperatorsTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC
            ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");

        addTestCase("AOT qmod preserves streaming operators",
            \testAOTQmodStreamingOperators());

        set_return_value(main());
    }

    private string moduleCode() {
        return "%modern

module AOTStreamingOperatorsMod {
    version = \"1.0\";
    desc = \"AOT streaming operator regression module\";
    author = \"Qore\";
    license = \"MIT\";
}

public namespace AOTStreamingOperatorsMod {
    public string sub verify() {
        list<int> values = (1, 2, 3, 4, 5);
        list<int> string_codes = map $1.ord(), (iterate \"AZ\");
        binary b = binary(\"AZ\");
        list<int> bytes = map $1, (iterate b);
        list<int> list_iter = map $1 * 2, (iterate (1, 2, 3));
        list<int> int_iter = map $1, (iterate 4);
        list<int> iterator_iter = map $1, (iterate xrange(3));
        hash<string, int> h = {\"a\": 1, \"b\": 2};
        hash pair = first $1.key == \"b\", h;

        list<int> taken = take 2, values;
        list<int> dropped = drop 2, values;
        list<int> take_while = takewhile $1 < 4, values;
        list<int> take_until = takeuntil $1 == 4, values;

        hash q = (\"name\": (\"amy\", \"bob\", \"cam\"), \"age\": (9, 10, 11));
        *string first_name = find first %name in q where (%age >= 10);
        *string last_name = find last %name in q where (%age >= 10);
        *string one_name = find one %name in q where (%age == 10);

        return sprintf(\"%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%s,%s,%s\\n\",
            string_codes[0], string_codes[1],
            bytes[0], bytes[1],
            list_iter[2], int_iter[3], iterator_iter[2], pair.value,
            (first values),
            (any $1 > 3, values) ? 1 : 0,
            (all $1 > 0, values) ? 1 : 0,
            (count $1 % 2 == 1, values),
            taken[1], dropped[0], take_while.size(), take_until.size(),
            (first (drop 2, values)), (count (take 2, values)),
            first_name, last_name, one_name);
    }
}
";
    }

    private string noFusionModuleCode() {
        return "%modern
%no-stream-fusion

module AOTStreamingNoFusionMod {
    version = \"1.0\";
    desc = \"AOT streaming operator no-fusion regression module\";
    author = \"Qore\";
    license = \"MIT\";
}

public namespace AOTStreamingNoFusionMod {
    public string sub verify() {
        list<int> values = (1, 2, 3, 4, 5);
        list<int> chain = take 2, (drop 1, values);
        return sprintf(\"%d,%d,%d,%d\\n\", (first (drop 2, values)),
            (count (take 3, values)), chain[0], chain[1]);
    }
}
";
    }

    private string modulePath(string module_dir) {
        string cur = ENV.QORE_MODULE_DIR ?? "";
        return cur == "" ? module_dir : module_dir + ":" + cur;
    }

    private writeFile(string path, string code) {
        File f();
        f.open2(path, O_WRONLY | O_CREAT | O_TRUNC);
        f.write(code);
        f.close();
    }

    private string runModule(string module_dir, string script_path) {
        return backquote(sprintf("LD_LIBRARY_PATH=%s QORE_MODULE_DIR=%s %s -b --enable-debug %s 2>&1",
            libqore_dir, modulePath(module_dir), qore_bin, script_path));
    }

    private compileModule(string src_path, string qmod_path) {
        string compile_out = backquote(sprintf(
            "QORE_LIBDIR=%s %s -m --strip-source -o %s %s 2>&1",
            libqore_dir, qcc_bin, qmod_path, src_path));
        assertTrue(is_file(qmod_path), "compiled streaming module: " + compile_out);
    }

    testAOTQmodStreamingOperators() {
        TmpDir tmp("qore-aot-streaming-operators-");
        string tmp_dir = tmp.path;
        string src_dir = tmp_dir + "/src";
        string qmod_dir = tmp_dir + "/qmod";
        mkdir(src_dir);
        mkdir(qmod_dir);

        string qm_path = src_dir + "/AOTStreamingOperatorsMod.qm";
        string no_fusion_qm_path = src_dir + "/AOTStreamingNoFusionMod.qm";
        writeFile(qm_path, moduleCode());
        writeFile(no_fusion_qm_path, noFusionModuleCode());

        string script_path = tmp_dir + "/run.qr";
        writeFile(script_path, "%modern
%requires AOTStreamingOperatorsMod
printf(\"%s\", AOTStreamingOperatorsMod::verify());
");

        string no_fusion_script_path = tmp_dir + "/run-no-fusion.qr";
        writeFile(no_fusion_script_path, "%modern
%requires AOTStreamingNoFusionMod
printf(\"%s\", AOTStreamingNoFusionMod::verify());
");

        string qmod_path = qmod_dir + "/AOTStreamingOperatorsMod.qmod";
        string no_fusion_qmod_path = qmod_dir + "/AOTStreamingNoFusionMod.qmod";
        compileModule(qm_path, qmod_path);
        compileModule(no_fusion_qm_path, no_fusion_qmod_path);

        string expected = "65,90,65,90,6,3,2,2,1,1,1,3,2,3,3,3,3,2,bob,cam,bob\n";
        string no_fusion_expected = "3,3,2,3\n";

        assertEq(expected, runModule(src_dir, script_path),
            "source module preserves streaming operator semantics");
        assertEq(expected, runModule(qmod_dir, script_path),
            "AOT qmod preserves streaming operator semantics");
        assertEq(no_fusion_expected, runModule(src_dir, no_fusion_script_path),
            "source module preserves streaming operator semantics without fusion");
        assertEq(no_fusion_expected, runModule(qmod_dir, no_fusion_script_path),
            "AOT qmod preserves streaming operator semantics without fusion");
    }
}
