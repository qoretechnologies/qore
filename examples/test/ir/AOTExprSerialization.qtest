#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

%requires QUnit
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires FsUtil

%exec-class AOTExprSerializationTest

class AOTExprSerializationTest inherits QUnit::Test {
    private {
        string qore_bin;
        string libqore_dir;
    }

    constructor() : QUnit::Test("AOTExprSerializationTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);

        addTestCase("AOT module serializes native expression nodes",
            \testAOTModuleNativeExprSerialization());

        set_return_value(main());
    }

    private string moduleCode() {
        return "%modern

module AOTExprSerializationMod {
    version = \"1.0\";
    desc = \"AOT expression serialization regression module\";
    author = \"Qore\";
    license = \"MIT\";
}

public class AOTIssueProgram inherits Program {
    constructor(*int po) : Program(PO_NEW_STYLE | PO_REQUIRE_TYPES | (po & 7) | (po ^ 1) | (po << 0)
            | (po >> 0)) {
    }
}

public namespace AOTExprSerializationMod {
    public list<string> sub head(list<string> xs, int n) {
        return xs[0..n - 1];
    }

    public string sub tail(string s, int i) {
        return s[i..];
    }

    public *string sub token(string arg, int i) {
        *string template = (arg[i..] =~ x/^([a-z-]+):/)[0];
        return template;
    }

    public string sub verify() {
        AOTIssueProgram p(0);
        list<string> h = head((\"a\", \"b\", \"c\"), 2);
        if (h != (\"a\", \"b\")) {
            return \"bad list range\";
        }
        if (tail(\"abcdef\", 2) != \"cdef\") {
            return \"bad string range\";
        }
        *string t = token(\"abc-def:rest\", 0);
        if (t != \"abc-def\") {
            return \"bad regex operand range\";
        }
        return \"ok\";
    }
}
";
    }

    private string runModule(string module_dir, string script_path) {
        return backquote(sprintf("LD_LIBRARY_PATH=%s QORE_MODULE_DIR=%s %s -b --enable-debug %s 2>&1",
            libqore_dir, module_dir, qore_bin, script_path));
    }

    testAOTModuleNativeExprSerialization() {
        TmpDir tmp("qore-aot-expr-serialization-");
        string tmp_dir = tmp.path;
        string src_dir = tmp_dir + "/src";
        string qmod_dir = tmp_dir + "/qmod";
        mkdir(src_dir);
        mkdir(qmod_dir);

        string qm_path = src_dir + "/AOTExprSerializationMod.qm";
        File qm();
        qm.open2(qm_path, O_WRONLY | O_CREAT | O_TRUNC);
        qm.write(moduleCode());
        qm.close();

        string script_path = tmp_dir + "/run.qr";
        File script();
        script.open2(script_path, O_WRONLY | O_CREAT | O_TRUNC);
        script.write("%modern\n%requires AOTExprSerializationMod\n"
            "printf(\"%s\\n\", AOTExprSerializationMod::verify());\n");
        script.close();

        string qmod_path = qmod_dir + "/AOTExprSerializationMod.qmod";
        string compile_out = backquote(sprintf(
            "QORE_LIBDIR=%s %s -b --compile-module --strip-source --output %s %s 2>&1",
            libqore_dir, qore_bin, qmod_path, qm_path));
        assertTrue(is_file(qmod_path), "compiled expression-serialization module: " + compile_out);

        assertEq("ok\n", runModule(qmod_dir, script_path),
            "AOT qmod preserves serialized native expression nodes");
        assertEq("ok\n", runModule(src_dir, script_path),
            "source module preserves serialized native expression semantics");
    }
}
