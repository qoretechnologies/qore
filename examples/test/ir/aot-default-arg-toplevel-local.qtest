#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-exec-mode: children - its checks run in child processes that set their own execution modes
# test-platform: macos - AOT serialization and loading of default argument expressions

# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../ExecModeHarness.qm

%exec-class AotDefaultArgTopLevelLocalTest

#! a default argument expression that reads a top-level local variable (qore#5868)
/** `K k();` at the top level of a %modern script declares a top-level local, not a global.  A default argument
    expression that read it (`k.m2("A", "B")`, `tl + 1`, `str + "!"`, `lst[1]`, `hsh.b`, `kk(str)`) could not be
    serialized without a local slot table, was written as an opaque default and was loaded as the boolean True, so
    the call that used the default got True, or a RUNTIME-TYPE-ERROR for a typed parameter.  The expression is now
    written with the index and the name of the top-level local, and read once the Program has its top-level locals.
    The value of the variable at the time of the call is read.  Every mode, qcc executables included, must print the
    output of the AST.

    The program is in \c aot-default-arg-toplevel-local/.
*/
class AotDefaultArgTopLevelLocalTest inherits QUnit::Test {
    private {
        string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        string dir = get_script_dir() + "/aot-default-arg-toplevel-local";

        const Modes = ("ast", "ir", "jit", "tiered");
        const Programs = ("aot-default-arg-toplevel-local", "shadowed-names", "closure-default");
    }

    constructor() : QUnit::Test("AotDefaultArgTopLevelLocalTest", "1.0", \ARGV) {
        addTestCase("the AST interpreter prints the expected output", \testAst());
        addTestCase("IR, JIT and tiered execution print the output of the AST", \testModes());
        addTestCase("qcc executables print the output of the AST", \testCompiled());
        addTestCase("a module's function with a closure as the default argument", \testModuleDefaultClosure());
        set_return_value(main());
    }

    private string expected(string name) {
        return ReadOnlyFile::readTextFile(dir + "/" + name + ".expected");
    }

    private string run(string name, string mode) {
        hash<ExecModeHarness::ModeRunResult> r = ExecModeHarness::run_command(sprintf("%s -b --enable-debug "
            "--exec-mode=%s %s/%s.q", qore_bin, mode, dir, name));
        assertEq(0, r.rc, sprintf("%s %s: exit status (output: %y)", name, mode, r.out));
        return r.stdout;
    }

    testAst() {
        foreach string name in (Programs) {
            assertEq(expected(name), run(name, "ast"), name + " ast");
        }
    }

    testModes() {
        foreach string name in (Programs) {
            foreach string mode in (Modes) {
                assertEq(expected(name), run(name, mode), name + " " + mode);
            }
        }
    }

    #! a module has no top-level locals: a closure default of its function binds as before, and the module loads
    testModuleDefaultClosure() {
        string qcc_bin = ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }
        foreach string opt in (("0", "3")) {
            TmpDir tmp("qore-aot-default-closure-module-");
            string src = tmp.path + "/AotDefClosure.qm";
            {
                File f();
                f.open2(src, O_CREAT | O_WRONLY | O_TRUNC);
                f.write("%modern
module AotDefClosure {
    version = \"1.0\";
    desc = \"closure default probe\";
    author = \"Qore Technologies, s.r.o.\";
    license = \"MIT\";
}
public namespace AotDefClosure {
public const Base = 40;
public auto sub run(code c = auto sub () { return Base + 2; }) {
    return c();
}
}
");
            }
            mkdir(tmp.path + "/mods");
            string qmod = tmp.path + "/mods/AotDefClosure.qmod";
            int rc;
            string out = backquote(sprintf("%s -O%s --module --output %s %s 2>&1", qcc_bin, opt, qmod, src), \rc);
            assertEq(0, rc, "module compiled with -O" + opt + ": " + out);
            string prog = tmp.path + "/probe.qr";
            {
                File f();
                f.open2(prog, O_CREAT | O_WRONLY | O_TRUNC);
                f.write(sprintf("%%modern\n%%append-module-path %s/mods\n%%requires AotDefClosure\n", tmp.path)
                    + "printf(\"%y %y\\n\", AotDefClosure::run(), AotDefClosure::run(auto sub () { return 1; }));\n");
            }
            hash<ExecModeHarness::ModeRunResult> r = ExecModeHarness::run_command(sprintf("%s -b %s", qore_bin, prog));
            assertEq(0, r.rc, "module probe exit status with -O" + opt + ": " + r.out);
            assertEq("42 1\n", r.stdout, "the module's closure default with -O" + opt);
        }
    }

    testCompiled() {
        string qcc_bin = ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }
        TmpDir tmp("qore-aot-default-arg-toplevel-local-");
        foreach string name in (Programs) {
            foreach string opt in (("0", "3")) {
                string exe = sprintf("%s/%s-O%s", tmp.path, name, opt);
                int rc;
                string out = backquote(sprintf("%s -O%s -o %s %s/%s.q 2>&1", qcc_bin, opt, exe, dir, name), \rc);
                if (rc || !is_file(exe)) {
                    testSkip("qcc is not available or cannot compile " + name + ": " + out);
                }
                # -b must be the first argument of a compiled program
                string result = backquote(sprintf("%s -b 2>&1", exe), \rc);
                assertEq(0, rc, sprintf("%s -O%s: exit status (output: %y)", name, opt, result));
                assertEq(expected(name), result, sprintf("%s -O%s", name, opt));
            }
        }
    }
}
