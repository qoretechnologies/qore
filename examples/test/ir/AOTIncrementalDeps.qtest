#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil
%requires json

%exec-class AOTIncrementalDepsTest

# Phase 1 of cross-unit AOT incremental dependency tracking.
#
# When `qcc -c -L <dir>` compiles a target that references a declaration in a
# *sibling* `.qo` (not `%include`d), some references are erased from the emitted
# object:
#   - a compile-time constant (`Sibling::CONST`) is folded to a literal;
#   - an enum member (`SiblingEnum::Member`) folds the same way.
# No symbol, string, or metadata path survives, so a depfile built from the
# output alone would miss the dependency — editing the sibling would leave a
# stale `.qo` with the old folded value.
#
# qcc now records the source file of every constant/enum a target resolves while
# it is parsed+committed (deserialized siblings carry their original source file
# as their declaration location), and emits those siblings into the depfile.
#
# This test compiles one sibling per reference kind into its own `.qo`, then a
# target that references it, and asserts the depfile names the sibling.  A
# negative case (a sibling class used only as a type annotation — which does NOT
# affect the target's output) asserts that pure-type references are NOT treated
# as dependencies.
class AOTIncrementalDepsTest inherits QUnit::Test {
    private {
        string qore_bin;
        string qcc_bin;
        string libqore_dir;
        string lib_dir;
        string tmp_dir;
        string env;
    }

    constructor() : QUnit::Test("AOTIncrementalDepsTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC
            ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");

        addTestCase("folded namespace constant", \testNamespaceConstant());
        addTestCase("folded class constant", \testClassConstant());
        addTestCase("pure type reference is not a dependency", \testPureTypeNotDep());
        addTestCase("typed global import is a build dependency", \testTypedGlobalImportDep());
        addTestCase("a folded constant depends on the provider's declaration contract",
            \testFoldedConstantDeclarationContractDep());
        addTestCase("declaration-contract dependencies require a source-content map",
            \testDeclarationContractRequiresSourceContentMap());
        addTestCase("batch depfile directory emits per-output depfiles", \testBatchDepfileDir());
        addTestCase("a batch attributes a folded scoped constant to its consumer",
            \testBatchScopedConstantDeps());
        addTestCase("a static class variable reached by name is imported in either compile mode",
            \testStaticVarImportBothModes());
        addTestCase("module depfiles use deterministic dependency forms",
            \testModuleDependencyForms());
        addTestCase("cross-file fast entry is a build dependency", \testCrossFileFastEntryDep());
        addTestCase("stale sibling fast entries are not imported", \testStaleSiblingFastEntry());
        addTestCase("inlined body summary is a build dependency", \testBodySummaryDep());
        addTestCase("body summary dependencies are transitive", \testTransitiveBodySummaryDep());
        addTestCase("ordinary cross-file call has no body dependency", \testOrdinaryCallNotBodyDep());
        addTestCase("source parse can execute a preloaded AOT body",
            \testSourceParsePreloadedBody());
        addTestCase("a preloaded body that cannot load at parse commit is a preload failure",
            \testPreloadedBodyUnloadableAtCommit());
        addTestCase("a construction parse commit reaches before its class is linked is deferred",
            \testCommitConstructionOfLaterLinkedClass());
        addTestCase("repeated AOT compilation is byte reproducible",
            \testByteReproducibleObject());
        # enum members route through the SAME constant hook as a folded constant: they are registered as
        # ConstantList entries carrying the enum's declaration location, whether the enum is parsed or preloaded
        addTestCase("a folded enum member is a build dependency", \testEnumMemberDep());
        addTestCase("a folded enum member depends on the provider's declaration contract",
            \testEnumMemberDeclarationContractDep());
        addTestCase("same-named enums in different namespaces are told apart",
            \testEnumSameNameDifferentNamespaces());
        addTestCase("an enum's consumers publish the same declarations in either compile mode",
            \testEnumDeclarationsModeIndependent());
        addTestCase("a preloaded object's module dependency loads in a program already parsing",
            \testPreloadModuleDependencyUnderParse());
        addTestCase("a consumer records the body-contract rows it baked",
            \testBodyContractImportRows());

        set_return_value(main());
    }

    private string run(string cmd) {
        return backquote(cmd + " 2>&1");
    }

    private write(string path, string body) {
        File f();
        f.open2(path, O_WRONLY | O_CREAT | O_TRUNC);
        f.write(body);
    }

    # compile a sibling source into its own .qo inside the preload dir
    private compileSibling(string name, string body) {
        string src = tmp_dir + "/" + name + ".qc";
        write(src, "%new-style\n" + body);
        string out = run(sprintf("%s %s -c -L %s --parse-option=PO_MODERN -o %s/%s.qo %s",
            env, qcc_bin, lib_dir, lib_dir, name, src));
        assertTrue(is_file(lib_dir + "/" + name + ".qo"), "compiled sibling " + name + ": " + out);
    }

    # compile a target against the preload dir, returning its depfile contents
    private string compileTargetDep(string name, string body) {
        string src = tmp_dir + "/" + name + ".qc";
        write(src, "%new-style\n" + body);
        string dep = lib_dir + "/" + name + ".qo.d";
        string out = run(sprintf("%s %s -c -L %s --parse-option=PO_MODERN --depfile=%s -o %s/%s.qo %s",
            env, qcc_bin, lib_dir, dep, lib_dir, name, src));
        assertTrue(is_file(lib_dir + "/" + name + ".qo"), "compiled target " + name + ": " + out);
        assertTrue(is_file(dep), "emitted depfile for " + name + ": " + out);
        return File::readTextFile(dep);
    }

    # Establish a fresh temp dir + preload dir for a test; the returned TmpDir
    # must be held in a method-scoped variable so the directory survives for the
    # duration of the test case.
    private TmpDir initDirs() {
        TmpDir tmp("qore-aot-incr-deps-");
        tmp_dir = tmp.path;
        lib_dir = tmp_dir + "/aotlib";
        mkdir(lib_dir);
        env = sprintf("LD_LIBRARY_PATH=%s QORE_LIBDIR=%s", libqore_dir, libqore_dir);
        return tmp;
    }

    testNamespaceConstant() {
        TmpDir tmp = initDirs();
        compileSibling("nsk", "public const NSVAL = 7;");
        string dep = compileTargetDep("use_ns",
            "class UseNs { static int f() { return NSVAL * 3 + 1; } }");
        assertTrue(dep.find("nsk.qc") != -1,
            "depfile records the sibling defining the folded namespace constant: " + dep);
    }

    testClassConstant() {
        TmpDir tmp = initDirs();
        compileSibling("ck", "public class Ck { public { const CC = 9; } }");
        string dep = compileTargetDep("use_cc",
            "class UseCc { static int f() { return Ck::CC + 2; } }");
        assertTrue(dep.find("ck.qc") != -1,
            "depfile records the sibling defining the folded class constant: " + dep);
    }

    # A folded constant leaves nothing behind in the emitted object, so the compile
    # records the PROVIDER'S SOURCE -- and with --depfile-source-content-map that becomes the
    # provider's source-content digest, i.e. a dependency at source-byte granularity.  That is
    # too coarse: appending a comment to a widely required source then rebuilds every object
    # that folded any constant from it, and on a real 875-source group the consumer closure of
    # such a source is most of the group.
    #
    # --depfile-declaration-contract-stamps narrows the edge to the provider's declaration
    # contract, which is exactly what a folded value consumes: it carries a value_hash for
    # every constant the provider defines, and leaves out the lowering artifacts that make the
    # provider's COMPILE contract differ between a whole-group parse and a standalone one.
    #
    # Both halves are asserted, because only the pair is a dependency: the narrowed edge must
    # NOT move for an edit that changes no declaration, and it MUST move when the folded value
    # changes -- otherwise the consumer keeps a stale literal with nothing to rebuild it.
    testFoldedConstantDeclarationContractDep() {
        TmpDir tmp = initDirs();
        string prov_src = tmp_dir + "/dck.qc";
        string cons_src = tmp_dir + "/use_dc.qc";
        write(prov_src, "%new-style\npublic const DCVAL = 7;\n");
        write(cons_src,
            "%new-style\nclass UseDc { static int f() { return DCVAL * 3 + 1; } }\n");

        string prov_obj = lib_dir + "/dck.qo";
        string decl_stamp = prov_obj + ".aggregate-contract.stamp";
        string compile_stamp = prov_obj + ".compile-contract.stamp";
        code compileProvider = sub () {
            string out = run(sprintf("%s %s -c -L %s --parse-option=PO_MODERN"
                + " --compile-contract-stamp=%s --aggregate-contract-stamp=%s -o %s %s",
                env, qcc_bin, lib_dir, compile_stamp, decl_stamp, prov_obj, prov_src));
            assertTrue(is_file(prov_obj), "compiled the constant provider: " + out);
            assertTrue(is_file(decl_stamp), "emitted the declaration contract: " + out);
        };
        compileProvider();

        # the source-content map is what tells qcc which dependency is a member of this build
        # group; its digest sidecars are what a source-byte dependency narrows to
        hash<string, string> sidecars = {};
        foreach string src in ((prov_src, cons_src)) {
            string sidecar = src + ".sha256";
            write(sidecar, sprintf("sha256=%s\n",
                digest("sha256", ReadOnlyFile::readBinaryFile(src)).toHex()));
            sidecars{src} = sidecar;
        }
        string map_file = tmp_dir + "/source-content.map";
        write(map_file, sprintf("%s\t%s\n%s\t%s\n", prov_src, sidecars{prov_src},
            cons_src, sidecars{cons_src}));

        # BASELINE: without the option the edge is the provider's source-content digest
        string plain_dep = lib_dir + "/use_dc.plain.d";
        run(sprintf("%s %s -c -L %s --parse-option=PO_MODERN --depfile=%s"
            + " --depfile-compile-contract-stamps --depfile-source-content-map=%s"
            + " -o %s/use_dc.qo %s",
            env, qcc_bin, lib_dir, plain_dep, map_file, lib_dir, cons_src));
        string plain = File::readTextFile(plain_dep);
        assertTrue(plain.find("dck.qc.sha256") != -1,
            "without the option the folded constant is a source-byte dependency: " + plain);
        assertEq(-1, plain.find("dck.qo.aggregate-contract.stamp"),
            "without the option no declaration contract is recorded: " + plain);

        # NARROWED: the same compile with the option records the declaration contract instead
        string dep_file = lib_dir + "/use_dc.qo.d";
        string cons_out = run(sprintf("%s %s -c -L %s --parse-option=PO_MODERN --depfile=%s"
            + " --depfile-compile-contract-stamps --depfile-declaration-contract-stamps"
            + " --depfile-source-content-map=%s -o %s/use_dc.qo %s",
            env, qcc_bin, lib_dir, dep_file, map_file, lib_dir, cons_src));
        assertTrue(is_file(lib_dir + "/use_dc.qo"), "compiled the folding consumer: " + cons_out);
        string dep = File::readTextFile(dep_file);
        assertTrue(dep.find("dck.qo.aggregate-contract.stamp") != -1,
            "the folded-constant edge narrows to the provider's declaration contract: " + dep);
        assertEq(-1, dep.find("dck.qc.sha256"),
            "the provider's source-byte edge is replaced, not merely accompanied: " + dep);
        # the consumer's OWN source must stay a source-byte dependency: its own bytes are what
        # decide whether it is recompiled, and its own declaration contract cannot say that
        assertTrue(dep.find("use_dc.qc.sha256") != -1,
            "the target's own source is still recorded at source-byte granularity: " + dep);

        # An edit that changes no declaration must not move the narrowed edge.  This is the
        # whole point of the narrowing: under the source-byte edge this rebuilt the consumer.
        string declared = File::readTextFile(decl_stamp);
        write(prov_src, "%new-style\npublic const DCVAL = 7;\n# a comment changes no declaration\n");
        compileProvider();
        assertEq(declared, File::readTextFile(decl_stamp),
            "a comment-only provider edit leaves the declaration contract byte-identical");

        # ...and a changed VALUE must move it, or the consumer keeps a stale folded literal
        write(prov_src, "%new-style\npublic const DCVAL = 8;\n");
        compileProvider();
        assertNeq(declared, File::readTextFile(decl_stamp),
            "changing the folded value moves the declaration contract, so the consumer rebuilds");
    }

    # The map is the only thing that says which dependency is a member of this build group, so
    # the option cannot do anything useful without it and says so rather than silently narrowing
    # nothing.
    testDeclarationContractRequiresSourceContentMap() {
        TmpDir tmp = initDirs();
        string src = tmp_dir + "/dcreq.qc";
        write(src, "%new-style\npublic const DCREQ = 1;\n");
        string out = run(sprintf("%s %s -c -L %s --parse-option=PO_MODERN --depfile=%s"
            + " --depfile-declaration-contract-stamps -o %s/dcreq.qo %s 2>&1 || true",
            env, qcc_bin, lib_dir, lib_dir + "/dcreq.qo.d", lib_dir, src));
        assertTrue(out.find("--depfile-declaration-contract-stamps requires") != -1,
            "the option is rejected without a source-content map: " + out);
        assertFalse(is_file(lib_dir + "/dcreq.qo"),
            "the rejected compile emits no object");
    }

    testPureTypeNotDep() {
        TmpDir tmp = initDirs();
        compileSibling("widget", "public class Widget { int x() { return 1; } }");
        # A sibling class referenced only as a type, inherited, called, etc. is
        # NOT a build dependency: every such cross-unit reference is resolved by
        # name at load/register time, so a stale dependent picks up the new
        # sibling automatically (verified empirically — base method bodies and
        # inherited member values both update without recompiling the
        # dependent).  Only folded compile-time constants/enum members bake a
        # value with no trace and therefore require a dependency.  Here Widget is
        # used only as a return-type annotation, so it must NOT appear.
        string dep = compileTargetDep("use_type",
            "class UseType { static *Widget make() { return; } }");
        assertEq(-1, dep.find("widget.qc"),
            "a pure-type reference is not recorded as a build dependency: " + dep);
        assertTrue(dep.find("use_type.qc") != -1,
            "depfile still records the target's own source: " + dep);
    }

    # A typed global is the one cross-unit reference that IS hash-verified at link
    # time: the consumer bakes the provider's declaration hash into its own symbol
    # index, and `--link-qo` compares the two.  Unlike a call or an inherited
    # method, a stale consumer therefore does not silently pick up the new
    # declaration — it fails the aggregate link with "qo-link hash mismatch"
    # naming an object the build had no recorded reason to rebuild.  The provider
    # source (or its compile-contract stamp) must be in the consumer's depfile.
    testTypedGlobalImportDep() {
        TmpDir tmp = initDirs();
        string thing = tmp_dir + "/gthing.qc";
        string prov = tmp_dir + "/gprov.qr";
        string cons = tmp_dir + "/gcons.qc";
        write(thing, "%modern\npublic class GThing { public { int calls = 0; } }\n");
        # the provider is a main script, as a program entry point that owns the
        # process-wide typed globals is
        write(prov, "%modern\nour GThing GSM;\nint sub main() { GSM = new GThing(); return GSM.calls; }\n");
        write(cons, "%modern\nclass GCons { static int f() { return GSM.calls; } }\n");

        string thing_out = run(sprintf("%s %s -c -L %s"
            + " --compile-contract-stamp=%s/gthing.qo.compile-contract.stamp -o %s/gthing.qo %s",
            env, qcc_bin, lib_dir, lib_dir, lib_dir, thing));
        assertTrue(is_file(lib_dir + "/gthing.qo"), "compiled the class sibling: " + thing_out);

        string prov_stamp = lib_dir + "/gprov.qo.compile-contract.stamp";
        string prov_out = run(sprintf("%s %s -c -L %s"
            + " --compile-contract-stamp=%s -o %s/gprov.qo %s",
            env, qcc_bin, lib_dir, prov_stamp, lib_dir, prov));
        assertTrue(is_file(lib_dir + "/gprov.qo"), "compiled the global provider: " + prov_out);
        assertTrue(is_file(prov_stamp), "emitted the provider compile-contract stamp: " + prov_out);
        string first_stamp = File::readTextFile(prov_stamp);

        string cons_dep = lib_dir + "/gcons.qo.d";
        string cons_out = run(sprintf("%s %s -c -L %s --depfile=%s -o %s/gcons.qo %s",
            env, qcc_bin, lib_dir, cons_dep, lib_dir, cons));
        assertTrue(is_file(lib_dir + "/gcons.qo"), "compiled the global consumer: " + cons_out);
        # THE REGRESSION: without this edge nothing rebuilds gcons.qo when the
        # declaration of GSM changes, and the aggregate link fails
        assertTrue(File::readTextFile(cons_dep).find("gprov.qr") != -1,
            "depfile records the source providing the typed global: " + File::readTextFile(cons_dep));

        # with contract stamps the edge narrows to the provider's API contract, so
        # unrelated edits to the provider still do not rebuild the consumer
        string cons_stamp_dep = lib_dir + "/gcons.stamps.d";
        run(sprintf("%s %s -c -L %s --depfile=%s"
            + " --depfile-compile-contract-stamps -o %s/gcons.qo %s",
            env, qcc_bin, lib_dir, cons_stamp_dep, lib_dir, cons));
        string stamp_dep = File::readTextFile(cons_stamp_dep);
        assertTrue(stamp_dep.find("gprov.qo.compile-contract.stamp") != -1,
            "the dependency narrows to the provider's compile-contract stamp: " + stamp_dep);

        # link cleanly before the provider changes
        string link_ok = run(sprintf("%s %s --link-qo --aggregate-symbol=GAPP -o %s/gagg.qo"
            + " %s/gthing.qo %s/gprov.qo %s/gcons.qo",
            env, qcc_bin, lib_dir, lib_dir, lib_dir, lib_dir));
        assertEq(-1, link_ok.find("hash mismatch"),
            "the aggregate links with a current consumer: " + link_ok);

        # change the declaration of the typed global and rebuild ONLY the provider
        write(prov, "%modern\nour *GThing GSM;\nint sub main() { GSM = new GThing(); return GSM.calls; }\n");
        string prov_out2 = run(sprintf("%s %s -c -L %s"
            + " --compile-contract-stamp=%s -o %s/gprov.qo %s",
            env, qcc_bin, lib_dir, prov_stamp, lib_dir, prov));
        assertTrue(is_file(lib_dir + "/gprov.qo"), "rebuilt the global provider: " + prov_out2);
        assertNeq(first_stamp, File::readTextFile(prov_stamp),
            "the provider's compile-contract stamp changes with the declaration, so the recorded "
            "dependency fires");

        # a retained consumer now carries the old hash: this is the failure the
        # dependency edge prevents
        string link_stale = run(sprintf("%s %s --link-qo --aggregate-symbol=GAPP -o %s/gagg.qo"
            + " %s/gthing.qo %s/gprov.qo %s/gcons.qo",
            env, qcc_bin, lib_dir, lib_dir, lib_dir, lib_dir));
        assertTrue(link_stale.find("hash mismatch") != -1,
            "a retained consumer fails the aggregate link after the provider changes: " + link_stale);

        # rebuilding the consumer — what the recorded dependency makes the build do
        # — restores the link
        string cons_out2 = run(sprintf("%s %s -c -L %s --depfile=%s -o %s/gcons.qo %s",
            env, qcc_bin, lib_dir, cons_dep, lib_dir, cons));
        assertTrue(is_file(lib_dir + "/gcons.qo"), "rebuilt the global consumer: " + cons_out2);
        string link_fixed = run(sprintf("%s %s --link-qo --aggregate-symbol=GAPP -o %s/gagg.qo"
            + " %s/gthing.qo %s/gprov.qo %s/gcons.qo",
            env, qcc_bin, lib_dir, lib_dir, lib_dir, lib_dir));
        assertEq(-1, link_fixed.find("hash mismatch"),
            "rebuilding the consumer restores the aggregate link: " + link_fixed);
    }

    testBatchDepfileDir() {
        TmpDir tmp = initDirs();
        string a = tmp_dir + "/batch_a.qc";
        string b = tmp_dir + "/batch_b.qc";
        write(a, "%new-style\npublic const BatchMagic = 41;\n"
            + "our hash<auto> BatchGlobal = {\"value\": 1};\n");
        write(b, "%new-style\nclass BatchUser { static int f() { return BatchMagic + BatchGlobal.value; } }\n");

        string out = run(sprintf(
            "%s %s -c --parse-option=PO_MODERN --batch-build-sidecars --output-dir=%s --depfile-dir=%s %s %s",
            env, qcc_bin, lib_dir, lib_dir, a, b));
        string count = trim(run(sprintf("find %s -maxdepth 1 -name '*.qo.d' | wc -l", lib_dir)));
        assertEq(2, count.toInt(), "batch compile emitted one depfile per .qo: " + out);

        string provider_dep = run(sprintf("cat %s/*batch_a_qc.qo.d", lib_dir));
        string consumer_dep = run(sprintf("cat %s/*batch_b_qc.qo.d", lib_dir));
        assertTrue(provider_dep.find("batch_a.qc") != -1,
            "provider depfile includes its own source: " + provider_dep);
        assertEq(-1, provider_dep.find("batch_b.qc"),
            "provider depfile does not create an all-to-all batch edge: " + provider_dep);
        assertTrue(consumer_dep.find("batch_a.qc") != -1
                && consumer_dep.find("batch_b.qc") != -1,
            "consumer depfile includes its source and folded-constant provider: " + consumer_dep);
        string consumer_index = run(sprintf("%s --dump-index-json %s/*batch_b_qc.qo",
            qcc_bin, lib_dir));
        assertTrue(consumer_index.find("\"qore_path\": \"BatchGlobal\"") != -1
                && consumer_index.find("batch_a.qc") != -1,
            "batch consumer index attributes a cross-file global to its provider: " + consumer_index);
        assertTrue(consumer_dep.find(".qo.stamp:") != -1,
            "batch build-sidecar depfile targets the success stamp: " + consumer_dep);
        foreach string suffix in (".idx.json", ".status.json", ".content.stamp",
                ".stamp", ".source.manifest.json") {
            string sidecar_count = trim(run(sprintf(
                "find %s -maxdepth 1 -name '*.qo%s' | wc -l", lib_dir, suffix)));
            assertEq(2, sidecar_count.toInt(),
                "batch compile emits every per-object " + suffix + " sidecar: " + out);
        }
        string deps = provider_dep + consumer_dep;
        assertEq(-1, deps.find("qorus-bootstrap-fallback"),
            "batch depfiles are real qcc depfiles, not wrapper fallback depfiles: " + deps);
    }

    #! A batch must attribute a folded SCOPED constant reference to the source that made it.
    /** A batch parses every source before it commits, and a constant initializer is resolved at
        the commit -- so the "source currently being parsed" that batch dependency attribution
        hangs on is gone by the time the reference is folded.  An UNSCOPED reference survived
        that anyway, because its resolver passes the referring expression's own location down to
        the constant lookup; the scoped resolvers (`Owner::CONST`) did not, so the dependency was
        not recorded at all -- not as a weaker edge, absent.

        The lost dependency is worse than a missed rebuild.  The aliasing object serializes its
        constant as a `const_ref` naming the OWNER's constant, so a later incremental compile
        that preloads the alias alone has nothing to resolve it against, and the whole compile
        fails:

          sibling .qo cross-resolution failed: AOT cannot deserialize value for class constant
            'ScopeAlias::AliasInfo': cannot resolve const_ref 'ScopeCat::Info'

        That is the shape a Qorus incremental build stopped on after a clean shared-parse build.
        Every case below is a scoped reference resolved at parse commit: a class constant aliased
        by another class's constant, a namespace constant aliased by another namespace's, and
        both folded inside a function body instead of a constant initializer.
    */
    testBatchScopedConstantDeps() {
        TmpDir tmp = initDirs();
        string cat = tmp_dir + "/scope_cat.qc";
        string ns = tmp_dir + "/scope_ns.qc";
        string alias = tmp_dir + "/scope_alias.qc";
        string body = tmp_dir + "/scope_body.qc";
        write(cat, "%new-style\npublic class ScopeCat { public { const Info = {\"k\": 5}; } }\n");
        write(ns, "%new-style\npublic namespace ScopeNs { public const TopInfo = {\"k\": 6}; }\n");
        write(alias, "%new-style\npublic class ScopeAlias {\n"
            + "    public {\n"
            + "        const AliasInfo = ScopeCat::Info;\n"
            + "        const AliasTop = ScopeNs::TopInfo;\n"
            + "    }\n}\n");
        write(body, "%new-style\nint sub scopeBodyFunc() {\n"
            + "    return ScopeCat::Info.k + ScopeNs::TopInfo.k;\n}\n");

        string out = run(sprintf("%s %s -c --parse-option=PO_MODERN --batch-build-sidecars "
            "--output-dir=%s --depfile-dir=%s %s %s %s %s",
            env, qcc_bin, lib_dir, lib_dir, cat, ns, alias, body));
        string alias_dep = run(sprintf("cat %s/*scope_alias_qc.qo.d", lib_dir));
        string body_dep = run(sprintf("cat %s/*scope_body_qc.qo.d", lib_dir));
        assertTrue(alias_dep.find("scope_cat.qc") != -1,
            "a constant aliasing a scoped class constant depends on its owner: " + alias_dep);
        assertTrue(alias_dep.find("scope_ns.qc") != -1,
            "a constant aliasing a scoped namespace constant depends on its owner: " + alias_dep);
        assertTrue(body_dep.find("scope_cat.qc") != -1,
            "a body folding a scoped class constant depends on its owner: " + body_dep);
        assertTrue(body_dep.find("scope_ns.qc") != -1,
            "a body folding a scoped namespace constant depends on its owner: " + body_dep);

        # the reverse edges must not appear: attribution is per consumer, not per batch
        string cat_dep = run(sprintf("cat %s/*scope_cat_qc.qo.d", lib_dir));
        string ns_dep = run(sprintf("cat %s/*scope_ns_qc.qo.d", lib_dir));
        assertEq(-1, cat_dep.find("scope_alias.qc"),
            "the owner does not depend on the source that aliases it: " + cat_dep);
        assertEq(-1, ns_dep.find("scope_body.qc"),
            "the owner does not depend on the source that folds it: " + ns_dep);

        # a standalone compile of the same alias records the same provider; the batch must not
        # publish a weaker dependency set than the compile it is meant to replace
        string single_lib = tmp_dir + "/single";
        mkdir(single_lib);
        run(sprintf("%s %s -c -L %s --parse-option=PO_MODERN -o %s/scope_cat.qo %s",
            env, qcc_bin, single_lib, single_lib, cat));
        run(sprintf("%s %s -c -L %s --parse-option=PO_MODERN -o %s/scope_ns.qo %s",
            env, qcc_bin, single_lib, single_lib, ns));
        string single_dep = single_lib + "/scope_alias.qo.d";
        run(sprintf("%s %s -c -L %s --parse-option=PO_MODERN --depfile=%s -o %s/scope_alias.qo %s",
            env, qcc_bin, single_lib, single_dep, single_lib, alias));
        string single = File::readTextFile(single_dep);
        assertTrue(single.find("scope_cat.qc") != -1 && single.find("scope_ns.qc") != -1,
            "the standalone compile records both scoped owners: " + single);
    }

    #! The static_var import records in \a object's symbol index, as "path flags=N provider=P" rows
    private list<string> staticVarImports(string object) {
        string out = run(sprintf("%s %s --dump-index-json %s", env, qcc_bin, object));
        auto index = parse_json(out);
        list<string> rv = ();
        foreach hash<auto> rec in (index.requires ?? ()) {
            if (rec.kind == "static_var") {
                push rv, sprintf("%s flags=%d provider=%s", rec.qore_path, rec.flags,
                    rec.provider_source_file ?? "");
            }
        }
        return sort(rv);
    }

    #! A static class variable another source declares is imported whether the compile resolved it or not.
    /** A read the parse resolves is a LoadStaticVar that names the variable itself and takes no expression
        slot, and every write is a LValuePath rooted at the variable, so only a read deferred to link time used
        to reach the symbol index.  The whole-group parse resolves such a read, so its object named the
        variable's class nowhere, while a compile that did not have the class declared deferred the read and
        named it -- and the load requirements a preload set closes over are read from those imports.  A
        constant initializer that folded a static variable therefore lost its provider from the next partial
        parse's preloads, was deferred instead of run, recorded the provider again, and alternated between the
        two forms every build (issue #5466).

        Each consumer reaches the variable a different way: a folded constant initializer, a function body,
        and a write.  The record must be the same in the batch and in a standalone compile against the
        provider's object, and carry no provider: only the compile that resolved the variable would know one,
        and an import's provider widens a dependency on that source to its compile contract.
    */
    testStaticVarImportBothModes() {
        TmpDir tmp = initDirs();
        string holder = tmp_dir + "/sv_holder.qc";
        string folded = tmp_dir + "/sv_folded.qc";
        string reader = tmp_dir + "/sv_reader.qc";
        string writer = tmp_dir + "/sv_writer.qc";
        write(holder, "%new-style\npublic class SvHolder {\n"
            + "    public {\n        static int count = 5;\n    }\n}\n");
        write(folded, "%new-style\npublic class SvFolded {\n"
            + "    public {\n        const Read = SvHolder::count + 1;\n"
            + "        static int own = 2;\n    }\n"
            + "    static int ownRead() {\n        return SvFolded::own;\n    }\n}\n");
        write(reader, "%new-style\npublic int sub svRead() {\n    return SvHolder::count;\n}\n");
        write(writer, "%new-style\npublic sub svWrite(int v) {\n    SvHolder::count = v;\n}\n");

        string out = run(sprintf("%s %s -c --parse-option=PO_MODERN --batch-build-sidecars "
            "--output-dir=%s --depfile-dir=%s %s %s %s %s",
            env, qcc_bin, lib_dir, lib_dir, holder, folded, reader, writer));
        hash<string, list<string>> batch;
        foreach string name in (("sv_holder", "sv_folded", "sv_reader", "sv_writer")) {
            list<string> objects = glob(sprintf("%s/*%s_qc.qo", lib_dir, name)) ?? ();
            assertEq(1, objects.size(), "the batch emitted " + name + ": " + out);
            batch{name} = staticVarImports(objects[0]);
        }
        list<string> expected = ("SvHolder::count flags=2 provider=",);
        assertEq(expected, batch.sv_folded,
            "a constant initializer folding another source's static variable imports it, "
            "and a class's own static variable is not an import");
        assertEq(expected, batch.sv_reader, "a resolved read in a function body imports the variable");
        assertEq(expected, batch.sv_writer, "a write imports the variable");
        assertEq((), batch.sv_holder, "the declaring source imports nothing of its own");

        # a standalone compile of each consumer against the provider's object records the same thing
        string single_lib = tmp_dir + "/single";
        mkdir(single_lib);
        out = run(sprintf("%s %s -c -L %s --parse-option=PO_MODERN -o %s/sv_holder.qo %s",
            env, qcc_bin, single_lib, single_lib, holder));
        assertTrue(is_file(single_lib + "/sv_holder.qo"), "compiled the provider standalone: " + out);
        foreach string name in (("sv_folded", "sv_reader", "sv_writer")) {
            string object = sprintf("%s/%s.qo", single_lib, name);
            out = run(sprintf("%s %s -c -L %s --parse-option=PO_MODERN -o %s %s/%s.qc",
                env, qcc_bin, single_lib, object, tmp_dir, name));
            assertTrue(is_file(object), "compiled " + name + " standalone: " + out);
            assertEq(batch{name}, staticVarImports(object),
                name + ": a standalone compile against the provider's object records what the batch did");
        }
    }

    testModuleDependencyForms() {
        TmpDir tmp = initDirs();
        string source_root = tmp_dir + "/modules";
        string dep_source = source_root + "/Dep";
        string artifact_root = tmp_dir + "/qmods";
        string dep_artifact_dir = artifact_root + "/Dep";
        mkdir(source_root);
        mkdir(dep_source);
        mkdir(artifact_root);
        mkdir(dep_artifact_dir);

        write(dep_source + "/Dep.qm", "%modern\n"
            + "module Dep { version = \"1.0\"; desc = \"dep\"; author = \"Qore\"; license = \"MIT\"; }\n"
            + "public namespace Dep { public string sub value() { return helper(); } }\n");
        write(dep_source + "/Extra.qc",
            "public namespace Dep { public string sub helper() { return \"ok\"; } }\n");
        string dep_qmod = dep_artifact_dir + "/Dep.qmod";
        string dep_out = run(sprintf("%s %s -m -o %s %s",
            env, qcc_bin, dep_qmod, dep_source));
        assertTrue(is_file(dep_qmod), "compiled split dependency module: " + dep_out);

        string consumer = tmp_dir + "/Consumer.qm";
        write(consumer, "%modern\n%requires Dep\n"
            + "module Consumer { version = \"1.0\"; desc = \"consumer\"; author = \"Qore\"; license = \"MIT\"; }\n"
            + "public namespace Consumer { public string sub value() { return Dep::value(); } }\n");
        string module_env = sprintf("%s QORE_MODULE_DIR=%s:%s", env,
            artifact_root, source_root);

        string source_depfile = tmp_dir + "/source.d";
        string source_out = run(sprintf("%s %s -m --depfile=%s -o %s/source.qmod %s",
            module_env, qcc_bin, source_depfile, tmp_dir, consumer));
        string source_deps = File::readTextFile(source_depfile);
        assertTrue(is_file(tmp_dir + "/source.qmod"),
            "compiled consumer with source dependency mode: " + source_out);
        assertTrue(source_deps.find("Dep/Dep.qm") != -1
                && source_deps.find("Dep/Extra.qc") != -1,
            "default source mode expands the complete split module: " + source_deps);
        assertEq(-1, source_deps.find("Dep.qmod"),
            "default source mode excludes the generated dependency artifact: " + source_deps);

        string artifact_depfile = tmp_dir + "/artifact.d";
        string artifact_out = run(sprintf("%s %s -m --depfile-module-deps=artifact"
            + " --depfile=%s -o %s/artifact.qmod %s", module_env, qcc_bin,
            artifact_depfile, tmp_dir, consumer));
        string artifact_deps = File::readTextFile(artifact_depfile);
        assertTrue(is_file(tmp_dir + "/artifact.qmod"),
            "compiled consumer with artifact dependency mode: " + artifact_out);
        assertTrue(artifact_deps.find("Dep/Dep.qmod") != -1,
            "artifact mode preserves the resolved qmod prerequisite: " + artifact_deps);
        assertEq(-1, artifact_deps.find("Dep/Extra.qc"),
            "artifact mode does not expand dependency sources: " + artifact_deps);

        string artifact_only_depfile = tmp_dir + "/artifact-only.d";
        string artifact_only_env = sprintf("%s QORE_MODULE_DIR=%s", env,
            artifact_root);
        string artifact_only_out = run(sprintf("%s %s -m --depfile=%s"
            + " -o %s/artifact-only.qmod %s", artifact_only_env, qcc_bin,
            artifact_only_depfile, tmp_dir, consumer));
        string artifact_only_deps = File::readTextFile(artifact_only_depfile);
        assertTrue(is_file(tmp_dir + "/artifact-only.qmod"),
            "compiled consumer with artifact-only dependency: " + artifact_only_out);
        assertTrue(artifact_only_deps.find("Dep/Dep.qmod") != -1,
            "source mode retains an artifact when no source representation is available: "
                + artifact_only_deps);

        string none_depfile = tmp_dir + "/none.d";
        string none_out = run(sprintf("%s %s -m --depfile-module-deps=none"
            + " --depfile=%s -o %s/none.qmod %s", module_env, qcc_bin,
            none_depfile, tmp_dir, consumer));
        string none_deps = File::readTextFile(none_depfile);
        assertTrue(is_file(tmp_dir + "/none.qmod"),
            "compiled consumer with omitted module dependencies: " + none_out);
        assertEq(-1, none_deps.find("/Dep/"),
            "none mode omits dependency module files: " + none_deps);
        assertTrue(none_deps.find("Consumer.qm") != -1,
            "none mode retains the consumer's own source: " + none_deps);

        string moved_qmod = dep_qmod + ".saved";
        run(sprintf("mv %s %s", dep_qmod, moved_qmod));
        string fallback_depfile = tmp_dir + "/fallback.d";
        string fallback_out = run(sprintf("%s %s -m --depfile=%s -o %s/fallback.qmod %s",
            module_env, qcc_bin, fallback_depfile, tmp_dir, consumer));
        string fallback_deps = File::readTextFile(fallback_depfile);
        assertTrue(is_file(tmp_dir + "/fallback.qmod"),
            "compiled consumer with source-loaded dependency: " + fallback_out);
        assertTrue(fallback_deps.find("Dep/Dep.qm") != -1
                && fallback_deps.find("Dep/Extra.qc") != -1,
            "source mode is complete when no dependency artifact exists: " + fallback_deps);
        assertEq(-1, fallback_deps.find("Dep.qmod"),
            "source mode is independent of dependency artifact availability: " + fallback_deps);
    }

    # A callee body that qualifies for a direct cross-file fast entry.
    private string fastEligibleCallee() {
        return "%new-style\n%require-types\n"
            "namespace FastX {\n"
            "our bool fx_blocked;\n"
            "sub fasthelper(string value) {\n"
            "    if (fx_blocked || !value.val()) {\n"
            "        throw \"EMPTY\", \"value is empty\";\n"
            "    }\n"
            "}\n"
            "}\n";
    }

    # The SAME declaration with a body that cannot have a fast entry: the
    # closure capture forces `value` into a real runtime local, so the direct
    # unboxed-argument entry disappears while the signature, the declaration
    # hash, and the standard entry symbol all stay identical.
    private string fastIneligibleCallee() {
        return "%new-style\n%require-types\n"
            "namespace FastX {\n"
            "our bool fx_blocked;\n"
            "sub fasthelper(string value) {\n"
            "    auto closure = string sub () { return value; };\n"
            "    if (fx_blocked || !closure().val()) {\n"
            "        throw \"EMPTY\", \"value is empty\";\n"
            "    }\n"
            "}\n"
            "}\n";
    }

    private string fastCaller() {
        return "%new-style\n%require-types\n"
            "namespace FastX {\n"
            "sub fastcaller(string value) {\n"
            "    fasthelper(value);\n"
            "}\n"
            "}\n";
    }

    # batch-compile the fast-entry callee/caller pair into lib_dir
    private string batchCompileFastPair() {
        return run(sprintf("%s %s -c --parse-option=PO_MODERN --batch-build-sidecars "
            "--output-dir=%s --depfile-dir=%s %s/fastcallee.qc %s/fastcaller.qc",
            env, qcc_bin, lib_dir, lib_dir, tmp_dir, tmp_dir));
    }

    # incrementally recompile one source of the pair against the sibling .qo dir,
    # exactly as an incremental build driven by the emitted depfiles does
    private string recompileFastSource(string name) {
        string object = trim(run(sprintf("find %s -maxdepth 1 -name '*%s_qc.qo'", lib_dir, name)));
        assertTrue(is_file(object), "batch object for " + name + " exists: " + object);
        return run(sprintf("%s %s -c -L %s --parse-option=PO_MODERN -o %s %s/%s.qc",
            env, qcc_bin, lib_dir, object, tmp_dir, name));
    }

    # undefined `_fast` symbols an object requires from another object
    private string undefinedFastSymbols(string name) {
        string object = trim(run(sprintf("find %s -maxdepth 1 -name '*%s_qc.qo'", lib_dir, name)));
        string dump = run(sprintf("%s %s --dump-info --dump-symbols %s", env, qcc_bin, object));
        string rv = "";
        foreach string line in (dump.split("\n")) {
            if (line.find(" U ") != -1 && line.find("_fast") != -1) {
                rv += trim(line) + "\n";
            }
        }
        return rv;
    }

    # link every object in lib_dir into one executable; qcc's link mode fails on
    # an undefined hidden `_fast` symbol exactly as the reported Qorus link did
    private string linkFastPair() {
        return run(sprintf("%s %s -o %s/fastapp %s/*.qo", env, qcc_bin, tmp_dir, lib_dir));
    }

    # A direct cross-file call into a sibling's fast entry hard-requires a hidden
    # symbol whose existence is derived from the CALLEE'S BODY, not its
    # declaration.  A body-only edit that costs the callee its fast entry leaves
    # an unchanged caller referencing a symbol nothing defines, so the callee
    # must be recorded as a build dependency of the caller.
    testCrossFileFastEntryDep() {
        TmpDir tmp = initDirs();
        write(tmp_dir + "/fastcallee.qc", fastEligibleCallee());
        write(tmp_dir + "/fastcaller.qc", fastCaller());

        string out = batchCompileFastPair();
        assertEq("", undefinedFastSymbols("fastcallee"),
            "the callee defines its own fast entry: " + out);
        assertTrue(undefinedFastSymbols("fastcaller").find("_fast_h") != -1,
            "the caller emits a contract-qualified cross-file fast-entry reference: " + out);

        string caller_dep = run(sprintf("cat %s/*fastcaller_qc.qo.d", lib_dir));
        assertTrue(caller_dep.find("fastcallee.qc") != -1,
            "the caller's depfile records the fast-entry callee source: " + caller_dep);
        string callee_dep = run(sprintf("cat %s/*fastcallee_qc.qo.d", lib_dir));
        assertEq(-1, callee_dep.find("fastcaller.qc"),
            "the fast-entry edge is one-way, not an all-to-all batch edge: " + callee_dep);

        assertTrue(linkFastPair().find("undefined reference") == -1,
            "the freshly batch-compiled pair links");

        # a body-only edit: same declaration, no fast entry any more
        write(tmp_dir + "/fastcallee.qc", fastIneligibleCallee());
        # the depfile above makes both objects out of date, so an incremental
        # build recompiles both
        recompileFastSource("fastcallee");
        recompileFastSource("fastcaller");
        assertEq("", undefinedFastSymbols("fastcaller"),
            "the rebuilt caller no longer requires the removed fast entry");
        string link = linkFastPair();
        assertEq(-1, link.find("undefined reference"),
            "the incrementally rebuilt pair links: " + link);
        assertTrue(is_file(tmp_dir + "/fastapp"), "link produced an executable: " + link);
    }

    # The rebuild order of two objects that changed together is not fixed (make
    # runs independent recipes in any order, and in parallel), so a caller can be
    # recompiled while the callee's `.qo` is still the pre-edit one.  Importing
    # fast entries from that stale object would bake in a reference to an entry
    # the very next recompile deletes.  qcc must detect the sibling is out of
    # date with its source and fall back to the ordinary call path.
    testStaleSiblingFastEntry() {
        TmpDir tmp = initDirs();
        write(tmp_dir + "/fastcallee.qc", fastEligibleCallee());
        write(tmp_dir + "/fastcaller.qc", fastCaller());
        string out = batchCompileFastPair();
        assertTrue(undefinedFastSymbols("fastcaller").find("_fast") != -1,
            "the caller starts with a direct cross-file fast-entry reference: " + out);

        # sanity: with the sibling `.qo` still current, the optimization survives
        # an incremental recompile of the caller alone
        recompileFastSource("fastcaller");
        assertTrue(undefinedFastSymbols("fastcaller").find("_fast") != -1,
            "a current sibling still provides its fast entry to an incremental rebuild");
        string caller_dep = run(sprintf("cat %s/*fastcaller_qc.qo.d", lib_dir));
        assertTrue(caller_dep.find("fastcallee.qc") != -1,
            "the incremental caller depfile also records the callee source: " + caller_dep);

        # now edit the callee and rebuild the CALLER first
        write(tmp_dir + "/fastcallee.qc", fastIneligibleCallee());
        recompileFastSource("fastcaller");
        assertEq("", undefinedFastSymbols("fastcaller"),
            "no fast entry is imported from a sibling .qo that is stale with its source");

        recompileFastSource("fastcallee");
        string link = linkFastPair();
        assertEq(-1, link.find("undefined reference"),
            "the pair links whichever object was rebuilt first: " + link);
        assertTrue(is_file(tmp_dir + "/fastapp"), "link produced an executable: " + link);
    }

    private string objectPath(string name) {
        return trim(run(sprintf("find %s -maxdepth 1 -name '*%s_qc.qo'", lib_dir, name)));
    }

    private string objectDep(string name) {
        return File::readTextFile(objectPath(name) + ".d");
    }

    private recompileSummarySource(string name) {
        string object = objectPath(name);
        string out = run(sprintf("%s %s -c -L %s --parse-option=PO_MODERN --depfile=%s.d -o %s %s/%s.qc",
            env, qcc_bin, lib_dir, object, object, tmp_dir, name));
        assertTrue(is_file(object), "recompiled summary source " + name + ": " + out);
    }

    testBodySummaryDep() {
        TmpDir tmp = initDirs();
        write(tmp_dir + "/sumcallee.qc", "%modern\nnamespace SumX { int sub scale(int x) { return x * 3; } }\n");
        write(tmp_dir + "/sumcaller.qc", "%modern\nnamespace SumX {\n"
            "int sub useScale(int x) { return scale(x) + 1; }\n"
            "}\nint sub main() { printf(\"%d\\n\", SumX::useScale(10)); return 0; }\n");
        string out = run(sprintf("%s %s -c --parse-option=PO_MODERN --batch-build-sidecars "
            "--output-dir=%s --depfile-dir=%s %s/sumcallee.qc %s/sumcaller.qc",
            env, qcc_bin, lib_dir, lib_dir, tmp_dir, tmp_dir));
        string dep = objectDep("sumcaller");
        assertTrue(dep.find("sumcallee.qc") != -1,
            "summary consumer records the callee body: " + dep + out);
        assertEq("", undefinedFastSymbols("sumcaller"),
            "the imported summary leaves no fast-entry symbol");
        string caller_index = run(sprintf("%s --dump-index-json %s", qcc_bin,
            objectPath("sumcaller")));
        assertTrue(caller_index.find("qore_body_contract_import_v1") != -1
                && caller_index.find("\"body_contract_hash\": \"fnv1a64:") != -1,
            "summary consumer records an exact semantic body contract: " + caller_index);

        # A source-only edit that leaves the imported contract unchanged must
        # not invalidate the old caller.
        write(tmp_dir + "/sumcallee.qc", "%modern\nnamespace SumX {\n"
            "# contract-preserving source edit\n"
            "int sub scale(int x) { return x * 3; }\n}\n");
        recompileSummarySource("sumcallee");
        string link = run(sprintf("%s %s -o %s/sumapp %s/*.qo", env, qcc_bin, tmp_dir, lib_dir));
        assertEq(-1, link.find("body_contract"),
            "an unchanged semantic body contract remains link-compatible: " + link);
        assertEq("31", trim(run(sprintf("%s %s/sumapp", env, tmp_dir))),
            "contract-preserving rebuild keeps the original result");

        write(tmp_dir + "/sumcallee.qc", "%modern\nnamespace SumX { int sub scale(int x) { return x * 4; } }\n");
        recompileSummarySource("sumcallee");
        string stale_link = run(sprintf("%s %s -o %s/sumapp %s/*.qo", env, qcc_bin, tmp_dir, lib_dir));
        assertTrue(stale_link.find("body_contract") != -1,
            "link rejects a stale caller with the old folded contract: " + stale_link);

        recompileSummarySource("sumcaller");
        link = run(sprintf("%s %s -o %s/sumapp %s/*.qo", env, qcc_bin, tmp_dir, lib_dir));
        assertTrue(is_file(tmp_dir + "/sumapp"), "summary pair links: " + link);
        assertEq("41", trim(run(sprintf("%s %s/sumapp", env, tmp_dir))),
            "incremental rebuild uses the changed callee summary");
    }

    testTransitiveBodySummaryDep() {
        TmpDir tmp = initDirs();
        write(tmp_dir + "/leaf.qc", "%modern\nnamespace SumT { int sub leaf(int x) { return x * 3; } }\n");
        write(tmp_dir + "/middle.qc", "%modern\nnamespace SumT { int sub middle(int x) { return leaf(x) + 1; } }\n");
        write(tmp_dir + "/top.qc", "%modern\nnamespace SumT { int sub top(int x) { return middle(x) + 2; } }\n"
            "int sub main() { printf(\"%d\\n\", SumT::top(10)); return 0; }\n");
        string out = run(sprintf("%s %s -c --parse-option=PO_MODERN --batch-build-sidecars "
            "--output-dir=%s --depfile-dir=%s %s/leaf.qc %s/middle.qc %s/top.qc",
            env, qcc_bin, lib_dir, lib_dir, tmp_dir, tmp_dir, tmp_dir));
        string middle_dep = objectDep("middle");
        string top_dep = objectDep("top");
        assertTrue(middle_dep.find("leaf.qc") != -1,
            "middle summary records its leaf provider: " + middle_dep + out);
        assertTrue(top_dep.find("middle.qc") != -1 && top_dep.find("leaf.qc") != -1,
            "top summary records direct and transitive providers: " + top_dep + out);
        string middle_index = run(sprintf("%s --dump-index-json %s", qcc_bin,
            objectPath("middle")));
        assertTrue(middle_index.find("body_dependency_files") != -1
                && middle_index.find("leaf.qc") != -1,
            "summary provenance is durable in the object index: " + middle_index);
        string top_index = run(sprintf("%s --dump-index-json %s", qcc_bin,
            objectPath("top")));
        assertTrue(top_index.find("qore_body_contract_import_v1") != -1
                && top_index.find("leaf.qc") != -1,
            "top records the transitive semantic leaf contract: " + top_index);
        string leaf_dep = objectDep("leaf");
        assertEq(-1, leaf_dep.find("middle.qc"),
            "transitive provenance remains one-way: " + leaf_dep);
        assertEq(-1, leaf_dep.find("top.qc"),
            "transitive provenance does not create an all-to-all edge: " + leaf_dep);

        # Re-import the middle summary from its object and verify that its
        # serialized leaf provenance survives the single-file `-L` path.
        recompileSummarySource("top");
        top_dep = objectDep("top");
        assertTrue(top_dep.find("middle.qc") != -1 && top_dep.find("leaf.qc") != -1,
            "preloaded summary preserves transitive body provenance: " + top_dep);

        write(tmp_dir + "/leaf.qc", "%modern\nnamespace SumT { int sub leaf(int x) { return x * 4; } }\n");
        recompileSummarySource("leaf");
        string stale_link = run(sprintf("%s %s -o %s/transitive-app %s/*.qo",
            env, qcc_bin, tmp_dir, lib_dir));
        assertTrue(stale_link.find("body_contract") != -1,
            "link rejects callers with a stale transitive leaf contract: " + stale_link);

        recompileSummarySource("middle");
        stale_link = run(sprintf("%s %s -o %s/transitive-app %s/*.qo",
            env, qcc_bin, tmp_dir, lib_dir));
        assertTrue(stale_link.find("body_contract") != -1,
            "link rejects top after only the middle contract is refreshed: " + stale_link);

        recompileSummarySource("top");
        string link = run(sprintf("%s %s -o %s/transitive-app %s/*.qo",
            env, qcc_bin, tmp_dir, lib_dir));
        assertEq(-1, link.find("body_contract"),
            "fully refreshed transitive contracts link: " + link);
        assertEq("43", trim(run(sprintf("%s %s/transitive-app", env, tmp_dir))),
            "transitive rebuild uses the changed leaf summary");
    }

    testOrdinaryCallNotBodyDep() {
        TmpDir tmp = initDirs();
        write(tmp_dir + "/ordinarycallee.qc", fastIneligibleCallee());
        write(tmp_dir + "/ordinarycaller.qc", fastCaller());
        string out = run(sprintf("%s %s -c --parse-option=PO_MODERN --batch-build-sidecars "
            "--output-dir=%s --depfile-dir=%s %s/ordinarycallee.qc %s/ordinarycaller.qc",
            env, qcc_bin, lib_dir, lib_dir, tmp_dir, tmp_dir));
        assertEq("", undefinedFastSymbols("ordinarycaller"),
            "ordinary caller has no body-derived fast symbol: " + out);
        string dep = objectDep("ordinarycaller");
        assertEq(-1, dep.find("ordinarycallee.qc"),
            "ordinary runtime-resolved call does not depend on the callee body: " + dep);
    }

    testSourceParsePreloadedBody() {
        TmpDir tmp = initDirs();
        compileSibling("parse_provider", "public class ParseProvider {\n"
            + "    public static int value() { return 42; }\n"
            + "}\n");

        string src = tmp_dir + "/parse_consumer.qc";
        write(src, "%modern\npublic const PARSE_VALUE = ParseProvider::value();\n"
            + "int sub main() { printf(\"%d\\n\", PARSE_VALUE); return 0; }\n");
        string object = lib_dir + "/parse_consumer.qo";
        string out = run(sprintf("%s %s -c -L %s --parse-option=PO_MODERN -o %s %s",
            env, qcc_bin, lib_dir, object, src));
        assertTrue(is_file(object),
            "consumer compile executes the source-stripped provider body: " + out);

        string link = run(sprintf("%s %s -o %s/parse-app %s/parse_provider.qo %s",
            env, qcc_bin, tmp_dir, lib_dir, object));
        assertTrue(is_file(tmp_dir + "/parse-app"),
            "consumer links with the provider: " + link);
        assertEq("42", trim(run(sprintf("%s %s/parse-app", env, tmp_dir))),
            "consumer preserves the value produced during source parse");
    }

    #! Runs \a cmd, returning its exit status and output.
    private hash<auto> runStatus(string cmd) {
        string out = run("{ " + cmd + "; } 2>&1; echo QCC-EXIT=$?");
        *list<string> m = (out =~ x/QCC-EXIT=([0-9]+)/);
        return {"rc": m ? m[0].toInt() : -1, "out": out};
    }

    # Parse commit runs the initializers of what it preloads, and code they call in a preloaded object is that
    # object's source-stripped IR, which registers only in a Program that declares everything it calls.  A preload
    # set that leaves out a class that code calls therefore fails the commit -- a property of the preload set and
    # not of the source, which qcc reports with exit status 78 so that an incremental build can answer it with a
    # parse that preloads nothing.  A failure in the compiled source's own code is still exit status 1.
    testPreloadedBodyUnloadableAtCommit() {
        TmpDir tmp = initDirs();
        compileSibling("commit_policy", "public class CommitPolicy {\n"
            + "    public static int check(int v) { return v + 1; }\n"
            + "}\n");
        compileSibling("commit_engine", "public class CommitEngine {\n"
            + "    public { const Marker = 3; }\n"
            + "    public static int kinds() { return CommitPolicy::check(41); }\n"
            + "}\n");
        compileSibling("commit_registry", "public class CommitRegistry {\n"
            + "    public { const Marker = CommitEngine::Marker; static int kinds = CommitEngine::kinds(); }\n"
            + "}\n");

        # the preload set the consumer is given: the registry and the engine, not the engine's callee
        string partial_dir = tmp_dir + "/partial";
        mkdir(partial_dir);
        foreach string name in (("commit_engine", "commit_registry")) {
            string copy = run(sprintf("cp %s/%s.qo %s/", lib_dir, name, partial_dir));
            assertTrue(is_file(partial_dir + "/" + name + ".qo"), "copied " + name + ": " + copy);
        }

        string src = tmp_dir + "/commit_store.qc";
        write(src, "%new-style\npublic class CommitStore {\n"
            + "    public { const Marker = CommitRegistry::Marker; }\n"
            + "}\n");
        hash<auto> result = runStatus(sprintf("%s %s -c -L %s --parse-option=PO_MODERN -o %s/commit_store.qo %s",
            env, qcc_bin, partial_dir, partial_dir, src));
        assertTrue(result.out.find("AOT-SOURCE-IR-ERROR") != -1,
            "the registry's initializer cannot load the engine's code without its callee: " + result.out);
        assertEq(78, result.rc, "a preloaded object's code that cannot load is a preload failure: " + result.out);

        # with the callee preloaded as well, the same compile succeeds
        result = runStatus(sprintf("%s %s -c -L %s --parse-option=PO_MODERN -o %s/commit_store.qo %s",
            env, qcc_bin, lib_dir, lib_dir, src));
        assertEq(0, result.rc, "the complete preload set loads the engine's code: " + result.out);

        # the compiled source's own initializer failing at parse commit, against a complete preload set, is the
        # source's failure
        string own = tmp_dir + "/commit_own.qc";
        write(own, "%new-style\npublic class CommitOwn {\n"
            + "    public { const Marker = CommitRegistry::Marker; static int k = CommitOwn::f(); }\n"
            + "    static int f() { throw \"COMMIT-OWN-ERROR\", \"the source's own failure\"; }\n"
            + "}\n");
        result = runStatus(sprintf("%s %s -c -L %s --parse-option=PO_MODERN -o %s/commit_own.qo %s",
            env, qcc_bin, lib_dir, lib_dir, own));
        assertTrue(result.out.find("COMMIT-OWN-ERROR") != -1, "the source's initializer failed: " + result.out);
        assertEq(1, result.rc, "a failure in the compiled source is not a preload failure: " + result.out);
    }

    # The shape of a Qorus TestEngine compile: the source constructs a build-group class with a declaration
    # (`Policy p(41)`), which the source-symbol manifest defers because no preloaded object declares it, and a
    # preloaded object's static initializer calls that code at parse commit.  The class is linked later, so the
    # initializer is pending, exactly as it is for a scoped `new Policy(41)` or a static call; it used to fail the
    # compile instead ("CREATE-OBJECT-ERROR: cannot resolve class 'Policy' for instantiation").
    testCommitConstructionOfLaterLinkedClass() {
        TmpDir tmp = initDirs();
        string manifest = tmp_dir + "/symbols.manifest";
        write(manifest, sprintf("format=1\nclass\tLaterPolicy\t%s/later_policy.qc\n"
            + "class\tLaterEngine\t%s/later_engine.qc\nclass\tLaterRegistry\t%s/later_registry.qc\n",
            tmp_dir, tmp_dir, tmp_dir));
        hash<string, string> sources = {
            "later_policy": "public class LaterPolicy {\n"
                + "    public { int base; }\n"
                + "    constructor(int b) { base = b; }\n"
                + "    int get() { return base; }\n"
                + "}\n",
            "later_engine": "public class LaterEngine {\n"
                + "    public { const Marker = 1; }\n"
                + "    public static int kinds() { LaterPolicy p(41); return p.get(); }\n"
                + "}\n",
            "later_registry": "public class LaterRegistry {\n"
                + "    public { const M = LaterEngine::Marker; static int k = LaterEngine::kinds(); }\n"
                + "}\n"
                + "int sub main() { printf(\"%d\\n\", LaterRegistry::k); return 0; }\n",
        };
        foreach hash<auto> i in (sources.pairIterator()) {
            write(tmp_dir + "/" + i.key + ".qc", "%new-style\n" + i.value);
        }
        foreach string name in (("later_policy", "later_engine", "later_registry")) {
            hash<auto> result = runStatus(sprintf("%s %s -c -L %s --parse-option=PO_MODERN "
                "--source-symbol-manifest=%s -o %s/%s.qo %s/%s.qc", env, qcc_bin, lib_dir, manifest, lib_dir, name,
                tmp_dir, name));
            assertEq(0, result.rc, "compiled " + name + " with its providers preloaded: " + result.out);
        }

        # the engine alone again, preloading the registry but not the policy
        string partial_dir = tmp_dir + "/partial";
        mkdir(partial_dir);
        string copy = run(sprintf("cp %s/later_registry.qo %s/", lib_dir, partial_dir));
        assertTrue(is_file(partial_dir + "/later_registry.qo"), "copied the registry: " + copy);
        hash<auto> result = runStatus(sprintf("%s %s -c -L %s --parse-option=PO_MODERN --source-symbol-manifest=%s "
            "-o %s/later_engine.qo %s/later_engine.qc", env, qcc_bin, partial_dir, manifest, partial_dir, tmp_dir));
        assertEq(-1, result.out.find("CREATE-OBJECT-ERROR"),
            "a class linked later is not reported as missing: " + result.out);
        assertEq(0, result.rc, "the registry's initializer is deferred until the class is linked: " + result.out);

        # and linked with the class, the program computes the value the deferred initializer did not
        string app = tmp_dir + "/later-app";
        string link = run(sprintf("%s %s -o %s %s/later_policy.qo %s/later_engine.qo %s/later_registry.qo",
            env, qcc_bin, app, lib_dir, partial_dir, lib_dir));
        assertTrue(is_file(app), "linked the program: " + link);
        assertEq("41", trim(run(sprintf("%s %s", env, app))), "the deferred initializer runs in the linked program");
    }

    # A folded `Enum::Member` leaves no trace in the emitted object, exactly like a folded constant, so the compile
    # must record the source that declares the enum.  It did not in either mode: a parsed enum registered its
    # members with a builtin location, which the dependency hook skips, and a preloaded shell registered no
    # members at all -- the reference was deferred to run time as `auto`, so the consumer depended on nothing and
    # published a different declaration than the same source compiled in a group parse.
    testEnumMemberDep() {
        TmpDir tmp = initDirs();
        string prov = tmp_dir + "/enum_prov.qc";
        string cons = tmp_dir + "/enum_cons.qc";
        write(prov, "%new-style\npublic namespace EP { public enum Color { Red = 1, Green = 2 } }\n");
        write(cons, "%new-style\nclass UseEnum {\n"
            + "    public { const C = EP::Color::Green; }\n"
            + "    static EP::Color f() { return EP::Color::Red; }\n"
            + "}\n"
            + "int sub main() { printf(\"%y %y\\n\", UseEnum::C, UseEnum::f()); return 0; }\n");

        # standalone: the enum is preloaded from its .qo shell
        string out = run(sprintf("%s %s -c -L %s --parse-option=PO_MODERN -o %s/enum_prov.qo %s",
            env, qcc_bin, lib_dir, lib_dir, prov));
        assertTrue(is_file(lib_dir + "/enum_prov.qo"), "compiled the enum provider: " + out);
        string dep = lib_dir + "/enum_cons.qo.d";
        out = run(sprintf("%s %s -c -L %s --parse-option=PO_MODERN --depfile=%s -o %s/enum_cons.qo %s",
            env, qcc_bin, lib_dir, dep, lib_dir, cons));
        assertTrue(is_file(lib_dir + "/enum_cons.qo"), "compiled the folding consumer: " + out);
        string standalone = File::readTextFile(dep);
        assertTrue(standalone.find("enum_prov.qc") != -1,
            "a standalone compile records the source declaring a folded enum: " + standalone);

        # the member is folded with its declared type, and the linked program sees the right members
        string link = run(sprintf("%s %s -o %s/enum-app %s/enum_prov.qo %s/enum_cons.qo",
            env, qcc_bin, tmp_dir, lib_dir, lib_dir));
        assertTrue(is_file(tmp_dir + "/enum-app"), "linked the enum consumer: " + link);
        assertEq("2 1", trim(run(sprintf("%s %s/enum-app", env, tmp_dir))),
            "the preloaded enum's members fold to their own values");

        # batch: the enum is declared by another source in the same parse
        string batch_dir = tmp_dir + "/batch";
        mkdir(batch_dir);
        out = run(sprintf("%s %s -c --parse-option=PO_MODERN --batch-build-sidecars --output-dir=%s "
            "--depfile-dir=%s %s %s", env, qcc_bin, batch_dir, batch_dir, prov, cons));
        string cons_dep = run(sprintf("cat %s/*enum_cons_qc.qo.d", batch_dir));
        string prov_dep = run(sprintf("cat %s/*enum_prov_qc.qo.d", batch_dir));
        assertTrue(cons_dep.find("enum_prov.qc") != -1,
            "a batch attributes a folded enum member to its consumer: " + cons_dep + out);
        assertEq(-1, prov_dep.find("enum_cons.qc"),
            "the enum's source does not depend on the source that folds it: " + prov_dep);
    }

    # The narrowed edge is only sound if the enum's declaration contract moves when a member value does and
    # stays put when nothing a consumer can fold changes.
    testEnumMemberDeclarationContractDep() {
        TmpDir tmp = initDirs();
        string prov_src = tmp_dir + "/dce.qc";
        string cons_src = tmp_dir + "/use_dce.qc";
        write(prov_src, "%new-style\npublic namespace DE { public enum Mode { On = 1, Off = 2 } }\n");
        write(cons_src, "%new-style\nclass UseDe { static DE::Mode f() { return DE::Mode::Off; } }\n");

        string prov_obj = lib_dir + "/dce.qo";
        string decl_stamp = prov_obj + ".aggregate-contract.stamp";
        code compileProvider = sub () {
            string out = run(sprintf("%s %s -c -L %s --parse-option=PO_MODERN"
                + " --compile-contract-stamp=%s.compile-contract.stamp --aggregate-contract-stamp=%s -o %s %s",
                env, qcc_bin, lib_dir, prov_obj, decl_stamp, prov_obj, prov_src));
            assertTrue(is_file(decl_stamp), "emitted the enum's declaration contract: " + out);
        };
        compileProvider();

        string map_file = tmp_dir + "/source-content.map";
        string map_body;
        foreach string src in ((prov_src, cons_src)) {
            write(src + ".sha256", sprintf("sha256=%s\n", digest("sha256", ReadOnlyFile::readBinaryFile(src)).toHex()));
            map_body += sprintf("%s\t%s.sha256\n", src, src);
        }
        write(map_file, map_body);

        string dep_file = lib_dir + "/use_dce.qo.d";
        string out = run(sprintf("%s %s -c -L %s --parse-option=PO_MODERN --depfile=%s"
            + " --depfile-compile-contract-stamps --depfile-declaration-contract-stamps"
            + " --depfile-source-content-map=%s -o %s/use_dce.qo %s",
            env, qcc_bin, lib_dir, dep_file, map_file, lib_dir, cons_src));
        string dep = File::readTextFile(dep_file);
        assertTrue(dep.find("dce.qo.aggregate-contract.stamp") != -1,
            "the folded enum member narrows to the provider's declaration contract: " + dep + out);
        assertEq(-1, dep.find("/dce.qc.sha256"),
            "the provider's source-byte edge is replaced, not merely accompanied: " + dep);

        string declared = File::readTextFile(decl_stamp);
        write(prov_src, "%new-style\npublic namespace DE { public enum Mode { On = 1, Off = 2 } }\n# comment\n");
        compileProvider();
        assertEq(declared, File::readTextFile(decl_stamp),
            "a comment-only edit to the enum's source leaves its declaration contract byte-identical");

        write(prov_src, "%new-style\npublic namespace DE { public enum Mode { On = 1, Off = 3 } }\n");
        compileProvider();
        assertNeq(declared, File::readTextFile(decl_stamp),
            "changing a member value moves the declaration contract, so the consumer rebuilds");
    }

    # With a builtin location the only thing that rebuilt a consumer was the source-symbol summary edge, and that
    # needs the enum's name to resolve to ONE provider.  Two sources declaring same-named enums defeat it, so the
    # recorded dependency must name the source that declares the enum actually folded -- and only that one.
    testEnumSameNameDifferentNamespaces() {
        TmpDir tmp = initDirs();
        string pa = tmp_dir + "/enum_a.qc";
        string pb = tmp_dir + "/enum_b.qc";
        string cons = tmp_dir + "/enum_ab.qc";
        write(pa, "%new-style\npublic namespace A { public enum E { X = 1 } }\n");
        write(pb, "%new-style\npublic namespace B { public enum E { X = 2 } }\n");
        write(cons, "%new-style\nclass UseA { public { const V = A::E::X; } }\n");

        foreach string src in ((pa, pb)) {
            string name = basename(src);
            name =~ s/\.qc$//;
            string out = run(sprintf("%s %s -c -L %s --parse-option=PO_MODERN -o %s/%s.qo %s",
                env, qcc_bin, lib_dir, lib_dir, name, src));
            assertTrue(is_file(sprintf("%s/%s.qo", lib_dir, name)), "compiled " + name + ": " + out);
        }
        string dep = lib_dir + "/enum_ab.qo.d";
        string out = run(sprintf("%s %s -c -L %s --parse-option=PO_MODERN --depfile=%s -o %s/enum_ab.qo %s",
            env, qcc_bin, lib_dir, dep, lib_dir, cons));
        string standalone = File::readTextFile(dep);
        assertTrue(standalone.find("enum_a.qc") != -1,
            "the consumer depends on the source declaring the enum it folded: " + standalone + out);
        assertEq(-1, standalone.find("enum_b.qc"),
            "and not on the source declaring a same-named enum elsewhere: " + standalone);

        string batch_dir = tmp_dir + "/batch";
        mkdir(batch_dir);
        run(sprintf("%s %s -c --parse-option=PO_MODERN --batch-build-sidecars --output-dir=%s --depfile-dir=%s "
            "%s %s %s", env, qcc_bin, batch_dir, batch_dir, pa, pb, cons));
        string batch = run(sprintf("cat %s/*enum_ab_qc.qo.d", batch_dir));
        assertTrue(batch.find("enum_a.qc") != -1, "a batch names the folded enum's source: " + batch);
        assertEq(-1, batch.find("enum_b.qc"), "a batch does not name the same-named enum's source: " + batch);
    }

    # A preloaded shell built the enum's type from the unrooted path the writer records, and the parser builds it
    # rooted, so a declaration mentioning the enum -- a return type, a constant folded from it -- published a
    # different contract depending on whether the enum's source was in the same parse.  Switching a component
    # between the two modes then rebuilt every consumer of it for no change at all.
    testEnumDeclarationsModeIndependent() {
        TmpDir tmp = initDirs();
        string prov = tmp_dir + "/mode_enum.qc";
        string cons = tmp_dir + "/mode_cons.qc";
        write(prov, "%new-style\npublic namespace ME { public enum Level { Low = 1, High = 2 } }\n");
        write(cons, "%new-style\nclass UseLevel {\n"
            + "    public { const L = ME::Level::High; }\n"
            + "    static ME::Level f(*ME::Level l) { return l ?? ME::Level::Low; }\n"
            + "}\n");

        run(sprintf("%s %s -c -L %s --parse-option=PO_MODERN -o %s/mode_enum.qo %s",
            env, qcc_bin, lib_dir, lib_dir, prov));
        string shell_stamp = lib_dir + "/mode_cons.decl";
        string out = run(sprintf("%s %s -c -L %s --parse-option=PO_MODERN --aggregate-contract-stamp=%s"
            + " -o %s/mode_cons.qo %s", env, qcc_bin, lib_dir, shell_stamp, lib_dir, cons));
        assertTrue(is_file(shell_stamp), "compiled the consumer against the enum's shell: " + out);

        string batch_dir = tmp_dir + "/batch";
        mkdir(batch_dir);
        out = run(sprintf("%s %s -c --parse-option=PO_MODERN --batch-build-sidecars --output-dir=%s"
            + " --depfile-dir=%s %s %s", env, qcc_bin, batch_dir, batch_dir, prov, cons));
        string group = run(sprintf("cat %s/*mode_cons_qc.qo.aggregate-contract.stamp", batch_dir));
        assertEq(File::readTextFile(shell_stamp), group,
            "the consumer publishes the same declaration contract in a group parse and against a shell: " + out);
    }

    # A preloaded object whose class inherits a class declared in an AOT module needs that module loaded, and
    # when no source this compile parses `%requires` it, only the preload loads it.  A `--stub` parse has already
    # put the program mid-parse by then, and the preload loaded its objects' modules outside the parse lock, so an
    # AOT module's namespace init -- which enters the importing program -- was refused ("the Program accessed is
    # currently undergoing parsing"), the refusal was discarded, and the compile failed later with an unresolved
    # base class naming nothing that had changed.
    testPreloadModuleDependencyUnderParse() {
        TmpDir tmp = initDirs();
        string mod_dir = tmp_dir + "/mods";
        mkdir(mod_dir);
        write(mod_dir + "/PreBaseMod.qm", "%modern\n"
            + "module PreBaseMod { version = \"1.0\"; desc = \"base\"; author = \"Qore\"; license = \"MIT\"; }\n"
            + "public namespace PB { public class Base { int v() { return 1; } } }\n");
        string mod_env = env + " QORE_MODULE_DIR=" + mod_dir;
        string out = run(sprintf("%s %s -m -o %s/PreBaseMod.qmod %s/PreBaseMod.qm", mod_env, qcc_bin, mod_dir,
            mod_dir));
        assertTrue(is_file(mod_dir + "/PreBaseMod.qmod"), "compiled the AOT module: " + out);

        string derived = tmp_dir + "/pre_derived.qc";
        write(derived, "%modern\n%requires PreBaseMod\n"
            + "public namespace PB { public class Derived inherits Base { int w() { return 2; } } }\n");
        out = run(sprintf("%s %s -c -L %s --parse-option=PO_MODERN -o %s/pre_derived.qo %s", mod_env, qcc_bin,
            lib_dir, lib_dir, derived));
        assertTrue(is_file(lib_dir + "/pre_derived.qo"), "compiled the module-derived class: " + out);

        # neither the stub nor the target requires the module: only the preloaded object names it
        string stub = tmp_dir + "/pre_stub.qc";
        write(stub, "%modern\npublic class PreStub {}\n");
        string other = tmp_dir + "/pre_other.qc";
        write(other, "%modern\npublic class PreOther { int x() { return 3; } }\n");
        out = run(sprintf("%s %s -c -L %s --stub=%s --parse-option=PO_MODERN -o %s/pre_other.qo %s", mod_env,
            qcc_bin, lib_dir, stub, lib_dir, other));
        assertEq(-1, out.find("cross-resolution failed"), "the preloaded class resolves its module base: " + out);
        assertTrue(is_file(lib_dir + "/pre_other.qo"), "the compile succeeds: " + out);

        # a module that really cannot be loaded is still best-effort, but it is named when resolution then fails,
        # instead of leaving only the class it would have declared
        unlink(mod_dir + "/PreBaseMod.qmod");
        unlink(mod_dir + "/PreBaseMod.qm");
        unlink(lib_dir + "/pre_other.qo");
        out = run(sprintf("%s %s -c -L %s --stub=%s --parse-option=PO_MODERN -o %s/pre_other.qo %s", mod_env,
            qcc_bin, lib_dir, stub, lib_dir, other));
        assertFalse(is_file(lib_dir + "/pre_other.qo"), "the compile fails without the module: " + out);
        assertTrue(out.find("cannot resolve base class '::PB::Base'") != -1, "the unresolved base is reported: "
            + out);
        assertTrue(out.find("PreBaseMod: failed to load module 'PreBaseMod'") != -1,
            "and so is the module load that caused it: " + out);
    }

    # The depfile edge names a provider's whole body contract, but `--link-qo` validates only the rows the
    # consumer baked -- so the rows are recorded beside the object, and that record is what the scheduler digests.
    testBodyContractImportRows() {
        TmpDir tmp = initDirs();
        string prov = tmp_dir + "/rowprov.qc";
        string cons = tmp_dir + "/rowcons.qc";
        write(prov, "%modern\nnamespace RowX {\nint sub scale(int x) { return x * 3; }\n"
            + "int sub other(int x) { return x - 1; }\n}\n");
        write(cons, "%modern\nnamespace RowX {\nint sub useScale(int x) { return scale(x) + 1; }\n}\n");
        string map_file = tmp_dir + "/source-content.map";
        code writeMap = sub () {
            string map_body;
            foreach string src in ((prov, cons)) {
                write(src + ".sha256", sprintf("sha256=%s\n",
                    digest("sha256", ReadOnlyFile::readBinaryFile(src)).toHex()));
                map_body += sprintf("%s\t%s.sha256\n", src, src);
            }
            write(map_file, map_body);
        };
        code compile = string sub (string name) {
            string out = lib_dir + "/" + name + ".qo";
            return run(sprintf("%s %s -c -L %s --parse-option=PO_MODERN --depfile=%s.d --depfile-target=%s.stamp"
                + " --depfile-compile-contract-stamps --depfile-declaration-contract-stamps"
                + " --depfile-source-content-map=%s --compile-contract-stamp=%s.compile-contract.stamp"
                + " --aggregate-contract-stamp=%s.aggregate-contract.stamp --body-contract-stamp=%s.body-contract.stamp"
                + " -o %s %s/%s.qc", env, qcc_bin, lib_dir, out, out, map_file, out, out, out, out, tmp_dir, name));
        };
        writeMap();
        string out = compile("rowprov");
        string body_stamp = lib_dir + "/rowprov.qo.body-contract.stamp";
        string stamp = File::readTextFile(body_stamp);
        assertTrue(stamp.find("RowX::scale(int)") != -1 && stamp.find("RowX::other(int)") != -1,
            "the provider publishes a body contract for both functions: " + stamp + out);
        out = compile("rowcons");
        string imports_path = lib_dir + "/rowcons.qo.body-contract-imports";
        assertTrue(is_file(imports_path), "the consumer records the rows it baked: " + out);
        string expected = sprintf("format=1\nimport\t%d:%s%d:%s\n", body_stamp.size(), body_stamp,
            "RowX::scale(int)".size(), "RowX::scale(int)");
        assertEq(expected, File::readTextFile(imports_path),
            "exactly the row it baked, naming the stamp as its depfile does");
        assertTrue(File::readTextFile(lib_dir + "/rowcons.qo.d").find(body_stamp) != -1,
            "the depfile names the provider's body contract");

        # a consumer that bakes nothing any more leaves no record behind
        write(cons, "%modern\nnamespace RowX {\nint sub useScale(int x) { return x + 1; }\n}\n");
        writeMap();
        out = compile("rowcons");
        assertFalse(is_file(imports_path), "the record is removed when nothing is baked: " + out);
    }

    testByteReproducibleObject() {
        TmpDir tmp = initDirs();
        string src = tmp_dir + "/repro.qc";
        string object = lib_dir + "/repro.qo";
        write(src, "%modern\nnamespace Repro {\n"
            + "    int sub zed(int x) { return x + 1; }\n"
            + "    int sub alpha(int x) { return zed(x) * 2; }\n"
            + "    int sub middle(int x) { return alpha(x) - 3; }\n"
            + "}\n");
        string cmd = sprintf("%s %s -c --parse-option=PO_MODERN -o %s %s",
            env, qcc_bin, object, src);
        string first_out = run(cmd);
        assertTrue(is_file(object), "first reproducibility compile: " + first_out);
        binary first = File::readBinaryFile(object);
        string second_out = run(cmd);
        assertTrue(is_file(object), "second reproducibility compile: " + second_out);
        assertEq(first, File::readBinaryFile(object),
            "identical source and output path produce an identical AOT object");
    }
}
