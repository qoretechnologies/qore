#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil

%exec-class AOTExecutableOptionsTest

#! Tests the options that an executable generated by qcc reads before the arguments of its program
/** <tt>-b</tt> disables signal handling as <tt>qore -b</tt> does (no signal thread is started, which runs under
    valgrind need), <tt>-G</tt> / <tt>--enable-debug</tt> are accepted without enabling the debug statements of the
    compiled code, and the arguments of the program start with the first argument that is not an option of the
    executable, so that an option given after it reaches the program in ARGV.
*/
class AOTExecutableOptionsTest inherits QUnit::Test {
    public {
        const Script = '%modern
printf("signals=%y argv=%y\n", HAVE_SIGNAL_HANDLING, ARGV);
try {
    @assert(False);
    printf("debug=off\n");
} catch (hash<ExceptionInfo> ex) {
    printf("debug=on\n");
}
';
    }

    private {
        string qore_bin;
        string libqore_dir;
        string qcc_bin;
    }

    constructor() : QUnit::Test("AOTExecutableOptions", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
            ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : dirname(qore_bin) + "/qcc");
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }
        addTestCase("an executable runs with signal handling unless -b is given", \testSignals());
        addTestCase("--enable-debug and -G are accepted and not given to the program", \testDebug());
        addTestCase("the arguments of the program start with the first argument that is not an option",
            \testArguments());
        set_return_value(main());
    }

    #! compiles the script to an executable in the directory given and returns the executable's path
    private string compile(TmpDir tmp) {
        string path = tmp.path + DirSep + "options.qr";
        File f();
        f.open2(path, O_WRONLY | O_CREAT | O_TRUNC);
        f.write(Script);
        f.close();
        string exe = tmp.path + DirSep + "options";
        string out = backquote(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s %s -o %s %s 2>&1", libqore_dir,
            libqore_dir, qcc_bin, exe, path));
        assertTrue(is_file(exe), "compiled the executable: " + out);
        return exe;
    }

    #! runs the executable with the arguments given and returns its output
    private string run(string exe, string args) {
        int rc;
        string out = backquote(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s %s %s 2>&1", libqore_dir,
            libqore_dir, exe, args), \rc);
        assertEq(0, rc, out);
        return out;
    }

    testSignals() {
        if (Qore::PlatformOS == "Windows") {
            testSkip("no signal handling on Windows");
        }
        TmpDir tmp("qore-aot-options-");
        string exe = compile(tmp);
        assertEq("signals=True argv=[]\ndebug=off\n", run(exe, ""));
        assertEq("signals=False argv=[]\ndebug=off\n", run(exe, "-b"));
    }

    testDebug() {
        TmpDir tmp("qore-aot-options-");
        string exe = compile(tmp);
        assertEq("signals=False argv=[]\ndebug=off\n", run(exe, "-b --enable-debug"));
        assertEq("signals=False argv=[]\ndebug=off\n", run(exe, "-G -b"));
    }

    testArguments() {
        TmpDir tmp("qore-aot-options-");
        string exe = compile(tmp);
        assertEq("signals=False argv=[\"a\", \"-b\", \"-G\"]\ndebug=off\n", run(exe, "-b a -b -G"));
    }
}
