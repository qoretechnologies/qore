#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
string libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
string qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
    ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : dirname(qore_bin) + "/qcc");
if (!is_file(qcc_bin)) {
    qcc_bin = "qcc";
}

string code = "%modern
%disable-warning duplicate-hash-key

hash<string, int> sub makeRow(int left, int middle, int right) {
    return {
        \"left\": left,
        \"middle\": middle,
        \"right\": right,
    };
}

list<int> sub makeValues(int left, int middle, int right) {
    return (left, middle, right);
}

list<float> sub makeFloats(float left, float right) {
    return (left, right);
}

list<string> sub makeWords(string left, string right) {
    return (left, right);
}

hash<string, string> sub makeWordMap(string left, string right) {
    return {
        \"left\": left,
        \"right\": right,
    };
}

hash<string, int> sub makeDuplicate(int first, int second) {
    return {
        \"same\": first,
        \"same\": second,
    };
}

hash<string, int> sub makeTagged(int value) {
    return {
        \"value\": value,
        \"scale\": 3,
        \"bias\": 7,
    };
}

hash<string, int> sub makeComputedRow(int left, int middle, int right) {
    return {
        \"left\": left,
        \"middle\": middle + 0,
        \"right\": right,
    };
}

list<float> sub makeFloatConstant(float value) {
    return (value, 2.5);
}

list<int> sub makeIntConstant(int value) {
    return (value, 42);
}

list<bool> sub makeBoolConstant(bool value) {
    return (value, True);
}

hash<string, int> sub remapRow(int left, int middle, int right) {
    return makeRow(right, left, middle);
}

hash<string, int> sub forwardRow(int left, int middle, int right) {
    return remapRow(middle, right, left);
}

hash<string, int> sub taggedWrapper(int value) {
    return makeTagged(value);
}

list<string> sub wordWrapper(string left, string right) {
    return makeWords(right, left);
}

list<int> sub valuesWrapper(int left, int middle, int right) {
    return makeValues(right, middle, left);
}

hash<string, int> sub computedWrapper(int left, int middle, int right) {
    return makeRow(left + 0, middle, right);
}

hash<string, hash<string, int>> sub wrapRow(
        hash<string, int> row, hash<string, int> unused) {
    return {
        \"row\": row,
        \"unused\": unused,
    };
}

hash<string, hash<string, hash<string, int>>> sub wrapRows(
        hash<string, hash<string, int>> rows,
        hash<string, hash<string, int>> unused) {
    return {
        \"rows\": rows,
        \"unused\": unused,
    };
}

hash<string, list<string>> sub wrapWords(
        list<string> words, list<string> unused) {
    return {
        \"words\": words,
        \"unused\": unused,
    };
}

list<string> sub makeFirstWord(string value, string ignored) {
    return (value,);
}

list<string> sub bindingWrapper(string value, softstring ignored) {
    return makeFirstWord(value, ignored);
}

int sub freshHashProjection() {
    return makeRow(4, 5, 6).middle;
}

int sub sideEffectProjection() {
    int projection_effects = 0;
    int value = makeRow((projection_effects = 1),
        (projection_effects = 2), (projection_effects = 3)).middle;
    return value * 10 + projection_effects;
}

int sub freshListSize() {
    return makeValues(7, 8, 9).size();
}

int sub freshListProjection() {
    return makeValues(4, 5, 6)[-1];
}

bool sub freshFloatProjection() {
    return makeFloats(1.25, 2.5)[-1] == 2.5;
}

int sub duplicateKeyProjection() {
    return makeDuplicate(10, 11).same;
}

int sub constantHashProjection() {
    return makeTagged(10).scale;
}

bool sub constantFloatProjection() {
    return makeFloatConstant(1.25)[1] == 2.5;
}

int sub constantIntProjection() {
    return makeIntConstant(1)[1];
}

bool sub constantBoolProjection() {
    return makeBoolConstant(False)[1];
}

string sub boxedListProjection() {
    return makeWords(\"alpha\", \"beta\")[0];
}

string sub boxedHashProjection() {
    return makeWordMap(\"alpha\", \"beta\").right;
}

string sub appendMark(string value) {
    return value + \"!\";
}

string sub boxedTemporaryProjection() {
    return makeWords(appendMark(\"left\"), appendMark(\"right\"))[0];
}

string sub boxedMultiListProjection() {
    string left = \"left-projection-value\";
    string right = \"right-projection-value\";
    list<string> words = makeWords(left, right);
    return words[0] + \"/\" + words[1] + \"/\" + words[0];
}

string sub boxedMultiHashProjection() {
    string left = \"hash-left-projection-value\";
    string right = \"hash-right-projection-value\";
    hash<string, string> words = makeWordMap(left, right);
    return words.left + \"/\" + words.right + \"/\" + words.left;
}

int sub wrapperProjection() {
    return forwardRow(10, 11, 12).middle;
}

int sub wrapperConstantProjection() {
    return taggedWrapper(9).scale;
}

string sub wrapperBoxedProjection() {
    return wordWrapper(\"left\", \"right\")[0];
}

int sub wrapperListSize() {
    return valuesWrapper(1, 2, 3).size();
}

int sub nonComposedWrapperProjection() {
    return computedWrapper(1, 2, 3).middle;
}

string sub nonComposedBindingProjection() {
    return bindingWrapper(\"kept\", 42)[0];
}

int sub nestedNativeProjection() {
    return wrapRow(makeRow(1, 2, 3), makeRow(4, 5, 6)).row.middle;
}

int sub nestedSideEffectProjection() {
    int effects = 0;
    int value = wrapRow(
        makeRow((effects = 1), (effects = 2), (effects = 3)),
        makeRow((effects = 4), (effects = 5), (effects = 6))).row.middle;
    return value * 10 + effects;
}

int sub deepNestedProjection() {
    return wrapRows(
        wrapRow(makeRow(7, 8, 9), makeRow(10, 11, 12)),
        wrapRow(makeRow(13, 14, 15), makeRow(16, 17, 18)))
        .rows.row.middle;
}

string sub nestedBoxedProjection() {
    return wrapWords(
        makeWords(\"alpha\", \"beta\"),
        makeWords(\"unused-left\", \"unused-right\")).words[1];
}

int sub sharedNestedInput() {
    hash<string, int> row = makeRow(1, 2, 3);
    return wrapRow(row, makeRow(4, 5, 6)).row.middle + row.left;
}

int sub nonNestedComputedProjection() {
    return wrapRow(
        makeComputedRow(1, 2, 3), makeRow(4, 5, 6)).row.middle;
}

int sub listFirstProjection() {
    return makeValues(4, 5, 6).first();
}

int sub listLastProjection() {
    return makeValues(4, 5, 6).last();
}

bool sub listEmptyProjection() {
    return makeValues(4, 5, 6).empty();
}

bool sub listValProjection() {
    return makeValues(4, 5, 6).val();
}

int sub listElementsProjection() {
    return elements makeValues(4, 5, 6);
}

int sub hashElementsProjection() {
    return elements makeRow(4, 5, 6);
}

int sub duplicateHashElementsProjection() {
    return elements makeDuplicate(4, 5);
}

bool sub listExistsProjection() {
    return exists makeValues(4, 5, 6);
}

bool sub hashExistsProjection() {
    return exists makeRow(4, 5, 6);
}

int sub aggregateConsumerSideEffects() {
    int effects = 0;
    int count = elements makeValues(
        (effects = 1), (effects = 2), (effects = 3));
    return count * 10 + effects;
}

int sub nonConsumerComputedProjection() {
    return elements makeComputedRow(1, 2, 3);
}

bool sub optionalAggregateConsumer(*int value) {
    try {
        return (elements makeValues(1, value, 3)) == 3;
    } catch (hash<auto> ex) {
        return value === NOTHING;
    }
}

int sub sharedResult() {
    hash<string, int> row = makeRow(1, 2, 3);
    return row.left + row.right;
}

int sub singleLocalProjection() {
    int effects = 0;
    hash<string, int> row = makeRow(
        (effects = 1), (effects = 2), (effects = 3));
    return row.middle * 10 + effects;
}

int sub crossBlockProjection(bool left_branch) {
    hash<string, int> row = makeRow(1, 2, 3);
    list<int> values = makeValues(4, 5, 6);
    if (left_branch) {
        return row.left + row.right + values[0] + values[2];
    }
    return row.middle + row.right + values[1] + values[2];
}

bool sub nonDominatingAssignment(bool assign) {
    hash<string, int> row;
    if (assign) {
        row = makeRow(1, 2, 3);
    }
    try {
        return row.left == 1;
    } catch (hash<auto> ex) {
        return !assign;
    }
}

int sub phiProjection(bool left_branch) {
    return (left_branch
        ? makeRow(1, 2, 3)
        : makeRow(4, 5, 6)).middle;
}

int sub phiSideEffectProjection(bool left_branch) {
    int effects = 0;
    int value = (left_branch
        ? makeRow((effects = 1), (effects = 2), (effects = 3))
        : makeRow((effects = 4), (effects = 5), (effects = 6))).middle;
    return value * 10 + effects;
}

string sub boxedPhiProjection(bool left_branch) {
    return (left_branch
        ? makeWords(\"left-unused\", \"left-selected\")
        : makeWords(\"right-unused\", \"right-selected\"))[1];
}

bool sub boxedConstantPhiProjection(bool left_branch) {
    return (left_branch
        ? makeBoolConstant(False)
        : makeBoolConstant(True))[1];
}

int sub boxedSizePhiProjection(bool left_branch) {
    return elements (left_branch
        ? makeValues(1, 2, 3)
        : makeValues(4, 5, 6));
}

int sub mixedPhiProjection(bool left_branch) {
    return (left_branch
        ? makeRow(1, 2, 3)
        : makeComputedRow(4, 5, 6)).middle;
}

bool sub nothingPhiProjection(bool left_branch) {
    *hash<string, int> row = left_branch ? makeRow(1, 2, 3) : NOTHING;
    return left_branch ? row.middle == 2 : row === NOTHING;
}

int sub sharedMutated() {
    hash<string, int> row = makeRow(1, 2, 3);
    row.left = 10;
    return row.left + row.right;
}

int sub consumeRow(hash<string, int> row) {
    return row.middle;
}

string sub consumeWords(list<string> words) {
    return words[1];
}

int sub sharedEscapes() {
    hash<string, int> row = makeRow(1, 2, 3);
    return row.left + consumeRow(row);
}

string sub boxedMixedUse() {
    list<string> words =
        makeWords(appendMark(\"alpha\"), appendMark(\"beta\"));
    return words[0] + \"/\" + consumeWords(words);
}

int sub dynamicListIndex(int index) {
    return makeValues(4, 5, 6)[index].toInt();
}

int sub boxedListSize() {
    return makeWords(\"a\", \"b\").size();
}

bool sub optionalInput(*int value) {
    try {
        int result = makeRow(1, value, 3).middle;
        return result == 0;
    } catch (hash<auto> ex) {
        return value === NOTHING;
    }
}

bool sub optionalListInput(*int value) {
    try {
        int result = makeValues(1, value, 3).size();
        return result == 0;
    } catch (hash<auto> ex) {
        return value === NOTHING;
    }
}

printf(\"%d:%d:%d:%d:%y:%d:%d:%y:%d:%y:%s:%s:%s:%d:%d:%d:%y:%d:%d:%d:%d:%d:%d:%y:%y:%d:%d:%d:%d:%y:%y:%s:%s:%s:%d:%d:%s:%d:%d:%s:%d:%d:%d:%s:%d:%d:%d:%d:%y:%y:%d:%d:%d:%y:%y:%d:%d:%y:%d:%s:%s:%y:%d\\n\",
    freshHashProjection(), sideEffectProjection(), freshListSize(),
    freshListProjection(), freshFloatProjection(), duplicateKeyProjection(),
    constantHashProjection(), constantFloatProjection(),
    constantIntProjection(), constantBoolProjection(),
    boxedListProjection(), boxedHashProjection(), boxedTemporaryProjection(),
    sharedResult(), crossBlockProjection(True), crossBlockProjection(False),
    nonDominatingAssignment(False), phiProjection(True), phiProjection(False),
    phiSideEffectProjection(True), phiSideEffectProjection(False),
    mixedPhiProjection(True), mixedPhiProjection(False),
    nothingPhiProjection(True), nothingPhiProjection(False),
    sharedMutated(), sharedEscapes(), dynamicListIndex(1), boxedListSize(),
    optionalInput(NOTHING), optionalListInput(NOTHING),
    boxedMultiListProjection(), boxedMultiHashProjection(), boxedMixedUse(),
    wrapperProjection(), wrapperConstantProjection(),
    wrapperBoxedProjection(), wrapperListSize(),
    nonComposedWrapperProjection(), nonComposedBindingProjection(),
    nestedNativeProjection(), nestedSideEffectProjection(),
    deepNestedProjection(), nestedBoxedProjection(), sharedNestedInput(),
    nonNestedComputedProjection(), listFirstProjection(),
    listLastProjection(), listEmptyProjection(), listValProjection(),
    listElementsProjection(), hashElementsProjection(),
    duplicateHashElementsProjection(), listExistsProjection(),
    hashExistsProjection(),
    aggregateConsumerSideEffects(), nonConsumerComputedProjection(),
    optionalAggregateConsumer(NOTHING), singleLocalProjection(),
    boxedPhiProjection(True), boxedPhiProjection(False),
    boxedConstantPhiProjection(True), boxedSizePhiProjection(False));
";

string src = "/tmp/qore-aot-aggregate-return-projection-" + string(getpid()) + ".qr";
string exe = "/tmp/qore-aot-aggregate-return-projection-" + string(getpid());
string disabled = exe + "-disabled";
string qo_dir = exe + "-qo";
File source();
source.open2(src, O_WRONLY | O_CREAT | O_TRUNC);
source.write(code);
source.close();
mkdir(qo_dir);

string sub compile(string out, string env) {
    string compile_out = backquote(sprintf(
        "%s LD_LIBRARY_PATH=%s %s -O3 -o %s %s 2>&1",
        env, libqore_dir, qcc_bin, out, src));
    if (!is_file(out)) {
        printf("AOT compile failed:\n%s", compile_out);
        exit(2);
    }
    return compile_out;
}

string enabled_compile = compile(exe, "QORE_IR_OPT_STATS=1");
string disabled_compile = compile(disabled,
    "QORE_IR_OPT_STATS=1 QORE_DISABLE_AOT_AGGREGATE_RETURN_PROJECTION=1");
foreach string function in (("freshHashProjection", "sideEffectProjection",
        "freshListSize", "freshListProjection", "freshFloatProjection",
        "duplicateKeyProjection", "constantHashProjection",
        "constantFloatProjection", "constantIntProjection",
        "constantBoolProjection", "boxedListProjection",
        "boxedHashProjection", "boxedListSize", "sharedResult",
        "singleLocalProjection")) {
    if (!enabled_compile.regex(sprintf(
            "IR-OPT-AOT-EFFECTS: %s:.*aggregate-projections=1",
            function))) {
        printf("missing aggregate-return projection for %s:\n%s",
            function, enabled_compile);
        exit(2);
    }
}
if (enabled_compile !~ /IR-OPT-AOT-EFFECTS: crossBlockProjection:.*aggregate-projections=1/) {
    printf("missing cross-block aggregate-return projections:\n%s",
        enabled_compile);
    exit(2);
}
foreach string function in (("phiProjection", "phiSideEffectProjection")) {
    if (!enabled_compile.regex(sprintf(
            "IR-OPT-AOT-EFFECTS: %s:.*aggregate-projections=1",
            function))) {
        printf("missing aggregate phi projection for %s:\n%s",
            function, enabled_compile);
        exit(2);
    }
}
foreach string function in (("boxedPhiProjection",
        "boxedConstantPhiProjection", "boxedSizePhiProjection")) {
    if (!enabled_compile.regex(sprintf(
            "IR-OPT-AOT-EFFECTS: %s:.*aggregate-projections=1",
            function))) {
        printf("missing boxed aggregate phi projection for %s:\n%s",
            function, enabled_compile);
        exit(2);
    }
}
foreach string function in (
        ("boxedMultiListProjection", "boxedMultiHashProjection")) {
    if (!enabled_compile.regex(sprintf(
            "IR-OPT-AOT-EFFECTS: %s:.*aggregate-projections=1",
            function))) {
        printf("missing multi-use boxed aggregate projection for %s:\n%s",
            function, enabled_compile);
        exit(2);
    }
}
foreach string function in (("wrapperProjection",
        "wrapperConstantProjection", "wrapperBoxedProjection",
        "wrapperListSize")) {
    if (!enabled_compile.regex(sprintf(
            "IR-OPT-AOT-EFFECTS: %s:.*aggregate-projections=1",
            function))) {
        printf("missing composed aggregate projection for %s:\n%s",
            function, enabled_compile);
        exit(2);
    }
}
foreach string function in (("nestedNativeProjection",
        "nestedSideEffectProjection", "deepNestedProjection",
        "nestedBoxedProjection")) {
    if (!enabled_compile.regex(sprintf(
            "IR-OPT-AOT-EFFECTS: %s:.*aggregate-projections=1",
            function))) {
        printf("missing nested aggregate projection for %s:\n%s",
            function, enabled_compile);
        exit(2);
    }
}
foreach string function in (("listFirstProjection", "listLastProjection",
        "listEmptyProjection", "listValProjection",
        "listElementsProjection", "hashElementsProjection",
        "duplicateHashElementsProjection",
        "listExistsProjection", "hashExistsProjection")) {
    if (!enabled_compile.regex(sprintf(
            "IR-OPT-AOT-EFFECTS: %s:.*aggregate-projections=1",
            function))) {
        printf("missing aggregate consumer projection for %s:\n%s",
            function, enabled_compile);
        exit(2);
    }
}
if (enabled_compile
        !~ /IR-OPT-AOT-EFFECTS: aggregateConsumerSideEffects:.*aggregate-projections=1/) {
    printf("missing side-effecting aggregate consumer projection:\n%s",
        enabled_compile);
    exit(2);
}
if (enabled_compile
            =~ /IR-OPT-AOT-EFFECTS: (nonDominatingAssignment|mixedPhiProjection|nothingPhiProjection|sharedMutated|sharedEscapes|boxedMixedUse|nonComposedWrapperProjection|nonComposedBindingProjection|nonNestedComputedProjection|nonConsumerComputedProjection|optionalAggregateConsumer|dynamicListIndex|optionalInput|optionalListInput):.*aggregate-projections=[1-9]/
        || disabled_compile =~ /aggregate-projections=[1-9]/) {
    printf("unsafe or disabled aggregate-return projection:\n%s",
        enabled_compile + disabled_compile);
    exit(2);
}

string qo_compile = backquote(sprintf(
    "LD_LIBRARY_PATH=%s %s -O3 -c --output-dir=%s %s 2>&1",
    libqore_dir, qcc_bin, qo_dir, src));
string qo = qo_dir + "/" + regex_subst(basename(src), "\\.qr$", ".qo");
if (!is_file(qo)) {
    printf(".qo compile failed:\n%s", qo_compile);
    exit(2);
}
string dump = backquote(sprintf(
    "LD_LIBRARY_PATH=%s %s --dump-index-json %s 2>&1",
    libqore_dir, qcc_bin, qo));
string row_line;
string values_line;
string floats_line;
string tagged_line;
string float_constant_line;
string forward_row_line;
string tagged_wrapper_line;
string word_wrapper_line;
foreach string line in (dump.split("\n")) {
    if (line.find("makeRow(") != -1
            && line.find("\"abi_kind\": \"qore_fast_v1\"") != -1) {
        row_line = line;
    } else if (line.find("makeValues(") != -1
            && line.find("\"abi_kind\": \"qore_fast_v1\"") != -1) {
        values_line = line;
    } else if (line.find("makeFloats(") != -1
            && line.find("\"abi_kind\": \"qore_fast_v1\"") != -1) {
        floats_line = line;
    } else if (line.find("makeTagged(") != -1
            && line.find("\"abi_kind\": \"qore_fast_v1\"") != -1) {
        tagged_line = line;
    } else if (line.find("makeFloatConstant(") != -1
            && line.find("\"abi_kind\": \"qore_fast_v1\"") != -1) {
        float_constant_line = line;
    } else if (line.find("forwardRow(") != -1
            && line.find("\"abi_kind\": \"qore_fast_v1\"") != -1) {
        forward_row_line = line;
    } else if (line.find("taggedWrapper(") != -1
            && line.find("\"abi_kind\": \"qore_fast_v1\"") != -1) {
        tagged_wrapper_line = line;
    } else if (line.find("wordWrapper(") != -1
            && line.find("\"abi_kind\": \"qore_fast_v1\"") != -1) {
        word_wrapper_line = line;
    }
}
if (row_line.find("\"aggregate_return_kind\": 2") == -1
        || row_line.find("\"aggregate_return_value_params\": [0, 1, 2]") == -1
        || row_line.find("\"aggregate_return_keys\": [\"left\", \"middle\", \"right\"]") == -1
        || values_line.find("\"aggregate_return_kind\": 1") == -1
        || values_line.find("\"aggregate_return_value_params\": [0, 1, 2]") == -1
        || values_line.find("\"aggregate_return_keys\": []") == -1
        || floats_line.find("\"aggregate_return_kind\": 1") == -1
        || floats_line.find("\"aggregate_return_value_params\": [0, 1]") == -1
        || floats_line.find("\"aggregate_return_keys\": []") == -1
        || tagged_line.find("\"aggregate_return_value_params\": [0, -1, -1]") == -1
        || tagged_line.find("\"aggregate_return_value_kinds\": [0, 1, 1]") == -1
        || tagged_line.find("\"aggregate_return_value_ints\": [0, 3, 7]") == -1
        || float_constant_line.find("\"aggregate_return_value_params\": [0, -1]") == -1
        || float_constant_line.find("\"aggregate_return_value_kinds\": [0, 2]") == -1
        || float_constant_line.find("\"aggregate_return_value_floats\": [0, 2.5]") == -1
        || forward_row_line.find("\"aggregate_return_kind\": 2") == -1
        || forward_row_line.find("\"aggregate_return_value_params\": [0, 1, 2]") == -1
        || forward_row_line.find("\"aggregate_return_keys\": [\"left\", \"middle\", \"right\"]") == -1
        || tagged_wrapper_line.find("\"aggregate_return_value_params\": [0, -1, -1]") == -1
        || tagged_wrapper_line.find("\"aggregate_return_value_ints\": [0, 3, 7]") == -1
        || word_wrapper_line.find("\"aggregate_return_kind\": 1") == -1
        || word_wrapper_line.find("\"aggregate_return_value_params\": [1, 0]") == -1) {
    printf("missing aggregate-return symbol metadata:\n%s", dump);
    exit(2);
}

string expected = "5:23:3:6:True:11:3:True:42:True:alpha:beta:left!:4:14:16:False:2:5:23:56:2:5:True:True:13:3:5:2:True:True:left-projection-value/right-projection-value/left-projection-value:hash-left-projection-value/hash-right-projection-value/hash-left-projection-value:alpha!/beta!:11:3:right:3:2:kept:2:26:8:beta:3:2:4:6:False:True:3:3:1:True:True:33:3:True:23:left-selected:right-selected:True:3\n";
foreach string mode in (("ast", "ir", "tiered", "jit")) {
    string actual = backquote(sprintf(
        "LD_LIBRARY_PATH=%s %s -b --exec-mode=%s %s 2>&1",
        libqore_dir, qore_bin, mode, src));
    if (actual != expected) {
        printf("mismatch in %s\nexpected:\n%sactual:\n%s",
            mode, expected, actual);
        exit(2);
    }
}
foreach string path in ((exe, disabled)) {
    string actual = backquote(sprintf(
        "LD_LIBRARY_PATH=%s %s 2>&1", libqore_dir, path));
    if (actual != expected) {
        printf("AOT mismatch for %s\nexpected:\n%sactual:\n%s",
            path, expected, actual);
        exit(2);
    }
}

unlink(src);
unlink(exe);
unlink(disabled);
