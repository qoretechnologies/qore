            "\"aggregate_return_value_kinds\": [12, 12, 12, 12, 12, 12]") == -1
        || compared_values_line.find(
            "\"aggregate_return_value_ints\": [1, 257, 513, 769, 1025, 1281]") == -1) {
    printf("missing serialized computed aggregate metadata:\n%s\n%s\n%s\n%s\n%s",
        computed_row_line, computed_values_line, computed_floats_line,
        bounded_values_line, compared_values_line);
    exit(2);
}

string expected = "5:23:3:6:True:11:3:True:42:True:alpha:beta:left!:4:14:16:False:2:5:23:56:2:5:True:True:13:3:5:2:True:True:left-projection-value/right-projection-value/left-projection-value:hash-left-projection-value/hash-right-projection-value/hash-left-projection-value:alpha!/beta!:11:3:right:3:2:kept:2:26:8:beta:3:2:4:6:False:True:3:3:1:True:True:33:3:True:23:left-selected:right-selected:True:3:2:2:8:3:False:True:23:True:True:16:True:False:13:True:True:3:5:2:21:2:callref-size\n12:13:True:True:5:True\n120\n11:2.5:True\nTrue:True:True:True\n";
expected += "True:True:True:True:True:True:True:True:True:True:True:True:True:True\n";
expected += "True:True:True:True:True:True:True:True\n";
expected += "True:True:True:True:True:True:True:True:True:True:True:True:True:True:True:True\n";
expected += "True:True:True:True:True:True:True:True\n";
expected += "4:13:True\n";
foreach string mode in (("ast", "ir", "tiered", "jit")) {
    string actual = backquote(sprintf(
        "LD_LIBRARY_PATH=%s %s -b --exec-mode=%s %s 2>&1",
        libqore_dir, qore_bin, mode, src));
    if (actual != expected) {
        printf("mismatch in %s\nexpected:\n%sactual:\n%s",
            mode, expected, actual);
        exit(2);
    }
}
foreach string path in ((exe, disabled)) {
    string actual = backquote(sprintf(
        "LD_LIBRARY_PATH=%s %s 2>&1", libqore_dir, path));
    if (actual != expected) {
        printf("AOT mismatch for %s\nexpected:\n%sactual:\n%s",
            path, expected, actual);
        exit(2);
    }
}

unlink(src);
unlink(exe);
unlink(disabled);
