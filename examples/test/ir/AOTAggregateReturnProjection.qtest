    guardedListIndex(9, -4) === NOTHING,
    guardedListIndex(9, -9223372036854775807 - 1) === NOTHING,
    guardedComputedListIndex(5, 1) == 12,
    guardedFloatListIndex(2.5, -1) == 2.5,
    guardedBoolListIndex(True, 2) == True,
    guardedConstantListIndex(1) == 17,
    guardedSideEffectOrder(),
    optionalGuardedListIndex(8, NOTHING) == 8,
    guardedUnusedBoxedListIndex(8, \"unused\", 1) == 8,
    dynamicSignedZeroListIndex(1) == \"0.0\",
