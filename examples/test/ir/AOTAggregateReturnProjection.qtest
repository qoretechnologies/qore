#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
string libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
string qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
    ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : dirname(qore_bin) + "/qcc");
if (!is_file(qcc_bin)) {
    qcc_bin = "qcc";
}

string code = "%modern
%disable-warning duplicate-hash-key

hash<string, int> sub makeRow(int left, int middle, int right) {
    return {
        \"left\": left,
        \"middle\": middle,
        \"right\": right,
    };
}

list<int> sub makeValues(int left, int middle, int right) {
    return (left, middle, right);
}

int guarded_reference_index = 0;

list<int> sub makeValuesAndSetGuard(
        int left, int middle, int right) {
    guarded_reference_index = 1;
    return (left, middle, right);
}

list<int> sub repeatValue(int value) {
    return (value, value, value);
}

list<int> sub repeatComputedValue(int value) {
    return (value + 7, value + 7, value + 7);
}

list<float> sub repeatFloat(float value) {
    return (value, value);
}

list<float> sub signedZeroValues() {
    return (-0.0, 0.0);
}

list<bool> sub repeatBool(bool value) {
    return (value, value, value);
}

list<auto> sub makeMixedValues(int value, float ratio, bool enabled) {
    return (value, ratio, enabled);
}

list<int> sub repeatConstant() {
    return (17, 17);
}

list<int> sub repeatWithUnusedBoxed(int value, string unused) {
    return (value, value);
}

list<float> sub makeFloats(float left, float right) {
    return (left, right);
}

list<string> sub makeWords(string left, string right) {
    return (left, right);
}

hash<string, string> sub makeWordMap(string left, string right) {
    return {
        \"left\": left,
        \"right\": right,
    };
}

hash<string, int> sub makeDuplicate(int first, int second) {
    return {
        \"same\": first,
        \"same\": second,
    };
}

hash<string, int> sub makeTagged(int value) {
    return {
        \"value\": value,
        \"scale\": 3,
        \"bias\": 7,
    };
}

hash<string, int> sub makeComputedRow(int left, int middle, int right) {
    return {
        \"left\": left,
        \"middle\": middle + 0,
        \"right\": right,
    };
}

list<int> sub makeComputedValues(int value) {
    return (value + 7,);
}

list<float> sub makeComputedFloats(float value) {
    return (value + 1.25,);
}

list<int> sub makeTwoParamComputedValues(int left, int right) {
    return (left + right,);
}

list<int> sub makeBoundedValues(int left, int right) {
    return (left + right, left - right, left * right, left * 3);
}

list<bool> sub makeComparedValues(int left, int right) {
    return (left == right, left != right, left < right, left <= right,
        left > right, left >= right);
}

list<float> sub makeFloatConstant(float value) {
    return (value, 2.5);
}

list<int> sub makeIntConstant(int value) {
    return (value, 42);
}

list<bool> sub makeBoolConstant(bool value) {
    return (value, True);
}

list<int> sub makeConditionalValues(bool reverse, int left, int right) {
    if (reverse) {
        return (right, left, 7);
    }
    return (left, right, 9);
}

list<float> sub makeConditionalFloats(
        bool reverse, float left, float right) {
    if (reverse) {
        return (right, left);
    }
    return (left, right);
}

list<bool> sub makeConditionalBools(
        bool reverse, bool left, bool right) {
    if (reverse) {
        return (right, left);
    }
    return (left, right);
}

list<int> sub makeVariableShape(bool long_value, int value) {
    if (long_value) {
        return (value, value + 1, value + 2);
    }
    return (value, value + 1);
}

int conditional_shape_effects = 0;

list<int> sub makeConditionalSideEffect(bool reverse, int value) {
    ++conditional_shape_effects;
    if (reverse) {
        return (value + 1, value);
    }
    return (value, value + 1);
}

list<int> sub makePotentiallyLooping(bool loop, bool alternate) {
    while (loop) {
    }
    if (alternate) {
        return (1, 2);
    }
    return (3, 4);
}

list<int> sub makeEmptyValues() {
    return ();
}

hash<string, int> sub makeEmptyRow() {
    return {};
}

list<int> sub makeConstantValues() {
    return (3, 5, 7);
}

hash<string, int> sub makeConstantRow() {
    return {
        \"left\": 11,
        \"right\": 13,
    };
}

hash<string, int> sub remapRow(int left, int middle, int right) {
    return makeRow(right, left, middle);
}

hash<string, int> sub forwardRow(int left, int middle, int right) {
    return remapRow(middle, right, left);
}

hash<string, int> sub taggedWrapper(int value) {
    return makeTagged(value);
}

list<string> sub wordWrapper(string left, string right) {
    return makeWords(right, left);
}

list<int> sub valuesWrapper(int left, int middle, int right) {
    return makeValues(right, middle, left);
}

hash<string, int> sub computedWrapper(int left, int middle, int right) {
    return makeRow(left + 0, middle, right);
}

hash<string, hash<string, int>> sub wrapRow(
        hash<string, int> row, hash<string, int> unused) {
    return {
        \"row\": row,
        \"unused\": unused,
    };
}

hash<string, hash<string, hash<string, int>>> sub wrapRows(
        hash<string, hash<string, int>> rows,
        hash<string, hash<string, int>> unused) {
    return {
        \"rows\": rows,
        \"unused\": unused,
    };
}

hash<string, list<string>> sub wrapWords(
        list<string> words, list<string> unused) {
    return {
        \"words\": words,
        \"unused\": unused,
    };
}

list<string> sub makeFirstWord(string value, string ignored) {
    return (value,);
}

list<string> sub bindingWrapper(string value, softstring ignored) {
    return makeFirstWord(value, ignored);
}

int sub freshHashProjection() {
    return makeRow(4, 5, 6).middle;
}

int sub sideEffectProjection() {
    int projection_effects = 0;
    int value = makeRow((projection_effects = 1),
        (projection_effects = 2), (projection_effects = 3)).middle;
    return value * 10 + projection_effects;
}

int sub freshListSize() {
    return makeValues(7, 8, 9).size();
}

int sub freshListProjection() {
    return makeValues(4, 5, 6)[-1];
}

bool sub freshFloatProjection() {
    return makeFloats(1.25, 2.5)[-1] == 2.5;
}

int sub duplicateKeyProjection() {
    return makeDuplicate(10, 11).same;
}

int sub constantHashProjection() {
    return makeTagged(10).scale;
}

bool sub constantFloatProjection() {
    return makeFloatConstant(1.25)[1] == 2.5;
}

int sub constantIntProjection() {
    return makeIntConstant(1)[1];
}

bool sub constantBoolProjection() {
    return makeBoolConstant(False)[1];
}

string sub boxedListProjection() {
    return makeWords(\"alpha\", \"beta\")[0];
}

string sub boxedHashProjection() {
    return makeWordMap(\"alpha\", \"beta\").right;
}

string sub appendMark(string value) {
    return value + \"!\";
}

string sub boxedTemporaryProjection() {
    return makeWords(appendMark(\"left\"), appendMark(\"right\"))[0];
}

string sub boxedMultiListProjection() {
    string left = \"left-projection-value\";
    string right = \"right-projection-value\";
    list<string> words = makeWords(left, right);
    return words[0] + \"/\" + words[1] + \"/\" + words[0];
}

string sub boxedMultiHashProjection() {
    string left = \"hash-left-projection-value\";
    string right = \"hash-right-projection-value\";
    hash<string, string> words = makeWordMap(left, right);
    return words.left + \"/\" + words.right + \"/\" + words.left;
}

int sub wrapperProjection() {
    return forwardRow(10, 11, 12).middle;
}

int sub wrapperConstantProjection() {
    return taggedWrapper(9).scale;
}

string sub wrapperBoxedProjection() {
    return wordWrapper(\"left\", \"right\")[0];
}

int sub wrapperListSize() {
    return valuesWrapper(1, 2, 3).size();
}

int sub nonComposedWrapperProjection() {
    return computedWrapper(1, 2, 3).middle;
}

string sub nonComposedBindingProjection() {
    return bindingWrapper(\"kept\", 42)[0];
}

int sub nestedNativeProjection() {
    return wrapRow(makeRow(1, 2, 3), makeRow(4, 5, 6)).row.middle;
}

int sub nestedSideEffectProjection() {
    int effects = 0;
    int value = wrapRow(
        makeRow((effects = 1), (effects = 2), (effects = 3)),
        makeRow((effects = 4), (effects = 5), (effects = 6))).row.middle;
    return value * 10 + effects;
}

int sub deepNestedProjection() {
    return wrapRows(
        wrapRow(makeRow(7, 8, 9), makeRow(10, 11, 12)),
        wrapRow(makeRow(13, 14, 15), makeRow(16, 17, 18)))
        .rows.row.middle;
}

string sub nestedBoxedProjection() {
    return wrapWords(
        makeWords(\"alpha\", \"beta\"),
        makeWords(\"unused-left\", \"unused-right\")).words[1];
}

int sub nestedLocalProjection() {
    hash<string, hash<string, int>> wrapper = wrapRow(
        makeRow(1, 2, 3), makeRow(4, 5, 6));
    return wrapper.row.middle;
}

int sub nestedPhiProjection(bool left_branch) {
    return (left_branch
        ? wrapRow(makeRow(1, 2, 3), makeRow(4, 5, 6))
        : wrapRow(makeRow(7, 8, 9), makeRow(10, 11, 12))).row.middle;
}

int sub sharedNestedInput() {
    hash<string, int> row = makeRow(1, 2, 3);
    return wrapRow(row, makeRow(4, 5, 6)).row.middle + row.left;
}

int sub nonNestedComputedProjection() {
    return wrapRow(
        makeComputedRow(1, 2, 3), makeRow(4, 5, 6)).row.middle;
}

int sub listFirstProjection() {
    return makeValues(4, 5, 6).first();
}

int sub listLastProjection() {
    return makeValues(4, 5, 6).last();
}

bool sub listEmptyProjection() {
    return makeValues(4, 5, 6).empty();
}

bool sub listValProjection() {
    return makeValues(4, 5, 6).val();
}

int sub listElementsProjection() {
    return elements makeValues(4, 5, 6);
}

int sub hashElementsProjection() {
    return elements makeRow(4, 5, 6);
}

int sub duplicateHashElementsProjection() {
    return elements makeDuplicate(4, 5);
}

bool sub listExistsProjection() {
    return exists makeValues(4, 5, 6);
}

bool sub hashExistsProjection() {
    return exists makeRow(4, 5, 6);
}

int sub aggregateConsumerSideEffects() {
    int effects = 0;
    int count = elements makeValues(
        (effects = 1), (effects = 2), (effects = 3));
    return count * 10 + effects;
}

int sub nonConsumerComputedProjection() {
    return elements makeComputedRow(1, 2, 3);
}

int sub computedIntProjection(int value) {
    return makeComputedValues(value)[0];
}

int sub computedBoxedIntProjection(int value) {
    return makeComputedValues(value).first();
}

bool sub computedIntOverflowProjection() {
    return computedIntProjection(9223372036854775807)
        == -9223372036854775802;
}

bool sub computedFloatProjection() {
    return makeComputedFloats(2.5)[0] == 3.75;
}

int sub twoParamComputedProjection() {
    return makeTwoParamComputedValues(2, 3)[0];
}

bool sub boundedExpressionProjection() {
    return makeBoundedValues(2, 3)[0] == 5
        && makeBoundedValues(2, 3)[1] == -1
        && makeBoundedValues(2, 3)[2] == 6
        && makeBoundedValues(2, 3)[3] == 6
        && makeBoundedValues(2, 3).first() == 5
        && makeBoundedValues(9223372036854775807, 2)[2] == -2
        && makeComparedValues(2, 3)[0] == False
        && makeComparedValues(2, 3)[1] == True
        && makeComparedValues(2, 3)[2] == True
        && makeComparedValues(2, 3)[3] == True
        && makeComparedValues(2, 3)[4] == False
        && makeComparedValues(2, 3)[5] == False;
}

bool sub optionalAggregateConsumer(*int value) {
    try {
        return (elements makeValues(1, value, 3)) == 3;
    } catch (hash<auto> ex) {
        return value === NOTHING;
    }
}

int sub hashSizeProjection() {
    return makeRow(1, 2, 3).size();
}

bool sub hashEmptyProjection() {
    return makeRow(1, 2, 3).empty();
}

bool sub hashValProjection() {
    return makeRow(1, 2, 3).val();
}

hash<auto> sub makeSizeOverride(code<string()> size_call) {
    return {
        \"size\": size_call,
    };
}

auto sub hashSizeOverride() {
    return makeSizeOverride(
        string sub () { return \"callref-size\"; }).size();
}

int sub sharedResult() {
    hash<string, int> row = makeRow(1, 2, 3);
    return row.left + row.right;
}

int sub singleLocalProjection() {
    int effects = 0;
    hash<string, int> row = makeRow(
        (effects = 1), (effects = 2), (effects = 3));
    return row.middle * 10 + effects;
}

int sub boxedIntLocalProjection() {
    int effects = 0;
    list<int> values = makeValues(
        (effects = 1), (effects = 2), (effects = 3));
    return values[1] * 10 + effects;
}

bool sub boxedFloatLocalProjection() {
    list<float> values = makeFloatConstant(1.25);
    return values[1] == 2.5;
}

bool sub boxedBoolLocalProjection() {
    list<bool> values = makeBoolConstant(False);
    return values[1];
}

int sub boxedIntMultiLocalProjection() {
    list<int> values = makeValues(4, 5, 7);
    return values[0] + values[1] + values[2];
}

bool sub boxedFloatMultiLocalProjection() {
    list<float> values = makeFloats(1.25, 1.5);
    return values[0] + values[1] + values[0] == 4.0;
}

bool sub boxedBoolMultiLocalProjection() {
    list<bool> values = makeBoolConstant(False);
    return values[0] + values[1] + values[1] == 2;
}

int sub boxedSizeMultiLocalProjection() {
    list<int> values = makeValues(4, 5, 6);
    return values.size() + values[0] + values[2];
}

int sub conditionalShapeProjection(bool reverse) {
    return makeConditionalValues(reverse, 4, 5).size();
}

int sub conditionalElementProjection(bool reverse) {
    return makeConditionalValues(reverse, 4, 5)[0];
}

bool sub conditionalFloatElementProjection(bool reverse) {
    return makeConditionalFloats(reverse, 1.25, 2.5)[0]
        == (reverse ? 2.5 : 1.25);
}

bool sub conditionalBoolElementProjection(bool reverse) {
    return makeConditionalBools(reverse, False, True)[0]
        == reverse;
}

int sub variableShapeProjection(bool long_value) {
    return makeVariableShape(long_value, 4).size();
}

int sub conditionalSideEffectProjection(bool reverse) {
    conditional_shape_effects = 0;
    int size = makeConditionalSideEffect(reverse, 4).size();
    return size * 10 + conditional_shape_effects;
}

int sub potentiallyLoopingProjection(bool alternate) {
    return makePotentiallyLooping(False, alternate).size();
}

int sub crossBlockProjection(bool left_branch) {
    hash<string, int> row = makeRow(1, 2, 3);
    list<int> values = makeValues(4, 5, 6);
    if (left_branch) {
        return row.left + row.right + values[0] + values[2];
    }
    return row.middle + row.right + values[1] + values[2];
}

bool sub nonDominatingAssignment(bool assign) {
    hash<string, int> row;
    if (assign) {
        row = makeRow(1, 2, 3);
    }
    try {
        return row.left == 1;
    } catch (hash<auto> ex) {
        return !assign;
    }
}

int sub phiProjection(bool left_branch) {
    return (left_branch
        ? makeRow(1, 2, 3)
        : makeRow(4, 5, 6)).middle;
}

int sub phiSideEffectProjection(bool left_branch) {
    int effects = 0;
    int value = (left_branch
        ? makeRow((effects = 1), (effects = 2), (effects = 3))
        : makeRow((effects = 4), (effects = 5), (effects = 6))).middle;
    return value * 10 + effects;
}

string sub boxedPhiProjection(bool left_branch) {
    return (left_branch
        ? makeWords(\"left-unused\", \"left-selected\")
        : makeWords(\"right-unused\", \"right-selected\"))[1];
}

bool sub boxedConstantPhiProjection(bool left_branch) {
    return (left_branch
        ? makeBoolConstant(False)
        : makeBoolConstant(True))[1];
}

int sub boxedSizePhiProjection(bool left_branch) {
    return elements (left_branch
        ? makeValues(1, 2, 3)
        : makeValues(4, 5, 6));
}

bool sub nativeFloatPhiProjection(bool left_branch) {
    float selected = (left_branch
        ? makeFloats(1.25, 2.5)
        : makeFloats(3.75, 5.0))[1];
    return selected == (left_branch ? 2.5 : 5.0);
}

int sub mixedPhiProjection(bool left_branch) {
    return (left_branch
        ? makeRow(1, 2, 3)
        : makeComputedRow(4, 5, 6)).middle;
}

bool sub nothingPhiProjection(bool left_branch) {
    *hash<string, int> row = left_branch ? makeRow(1, 2, 3) : NOTHING;
    return left_branch ? row.middle == 2 : row === NOTHING;
}

int sub sharedMutated() {
    hash<string, int> row = makeRow(1, 2, 3);
    row.left = 10;
    return row.left + row.right;
}

int sub consumeRow(hash<string, int> row) {
    return row.middle;
}

int sub consumeListSize(list<int> values) {
    return values.size();
}

int sub consumeMutatingRow(hash<string, int> row) {
    row.middle = 10;
    return row.middle;
}

int sub consumeRowWithRequiredUnused(
        hash<string, int> row, int required_unused) {
    return row.middle;
}

string sub consumeWords(list<string> words) {
    return words[1];
}

int sub sharedEscapes() {
    hash<string, int> row = makeRow(1, 2, 3);
    return row.left + consumeRow(row);
}

int sub sharedListSizeConsumer() {
    list<int> values = makeValues(1, 2, 3);
    return values[0] + consumeListSize(values);
}

int sub sharedMutatingConsumer() {
    hash<string, int> row = makeRow(1, 2, 3);
    return row.left + consumeMutatingRow(row) + row.middle;
}

bool sub requiredUnsetConsumer() {
    int required_unused;
    try {
        consumeRowWithRequiredUnused(
            makeRow(1, 2, 3), required_unused);
    } catch (hash<auto> ex) {
        return True;
    }
    return False;
}

string sub boxedMixedUse() {
    list<string> words =
        makeWords(appendMark(\"alpha\"), appendMark(\"beta\"));
    return words[0] + \"/\" + consumeWords(words);
}

int sub dynamicListIndex(int index) {
    return makeValues(4, 5, 6)[index].toInt();
}

*int sub guardedListIndex(int value, int index) {
    return repeatValue(value)[index];
}

*int sub guardedComputedListIndex(int value, int index) {
    return repeatComputedValue(value)[index];
}

*float sub guardedFloatListIndex(float value, int index) {
    return repeatFloat(value)[index];
}

string sub dynamicSignedZeroListIndex(int index) {
    return sprintf(\"%.1f\", signedZeroValues()[index]);
}

string sub dynamicMixedListIndex(int index) {
    return sprintf(\"%y\", makeMixedValues(11, 2.5, True)[index]);
}

*bool sub guardedBoolListIndex(bool value, int index) {
    return repeatBool(value)[index];
}

*int sub guardedConstantListIndex(int index) {
    return repeatConstant()[index];
}

*int sub guardedMultiLocalProjection(int index) {
    list<int> values = makeValues(4, 5, 6);
    *int first = values[index];
    *int second = values[index];
    *int third = values[index];
    return first === second && second === third ? first : NOTHING;
}

bool sub guardedMutableLocalProjection() {
    list<int> values = makeValues(4, 5, 6);
    int index = 0;
    *int first = values[index];
    ++index;
    *int second = values[index];
    return first == 4 && second == 5;
}

bool sub guardedDifferentIndexProjection(int left, int right) {
    list<int> values = makeValues(4, 5, 6);
    return values[left] == 4 && values[right] == 6;
}

*int sub guardedPhiProjection(bool left_branch, int index) {
    list<int> values = left_branch
        ? makeValues(1, 2, 3) : makeValues(4, 5, 6);
    *int first = values[index];
    *int second = values[index];
    return first === second ? first : NOTHING;
}

*int sub guardedDirectPhiProjection(bool left_branch, int index) {
    return (left_branch
        ? makeValues(1, 2, 3) : makeValues(4, 5, 6))[index];
}

*float sub guardedDirectFloatPhiProjection(
        bool left_branch, int index) {
    return (left_branch
        ? makeFloats(1.25, 2.5) : makeFloats(3.75, 5.0))[index];
}

*int sub guardedMutableDirectPhiProjection(
        bool left_branch, int index) {
    ++index;
    return (left_branch
        ? makeValues(1, 2, 3) : makeValues(4, 5, 6))[index];
}

bool sub guardedDirectPhiSideEffectOrder(bool left_branch) {
    int effects = 0;
    *int selected = (left_branch
        ? makeValues((effects = 1), 2, 3)
        : makeValues((effects = 1), 5, 6))[(effects = 2) - 1];
    return selected == (left_branch ? 2 : 5) && effects == 2;
}

*int sub guardedReferenceDirectPhiProjection(
        bool left_branch, reference<int> index) {
    return (left_branch
        ? makeValuesAndSetGuard(1, 2, 3)
        : makeValuesAndSetGuard(4, 5, 6))[index];
}

bool sub guardedReferenceDirectPhiOrder(bool left_branch) {
    guarded_reference_index = 0;
    *int selected = guardedReferenceDirectPhiProjection(
        left_branch, \\guarded_reference_index);
    return selected == (left_branch ? 2 : 5)
        && guarded_reference_index == 1;
}

bool sub guardedSideEffectOrder() {
    int effects = 0;
    *int selected = repeatValue((effects = 1))[(effects = 2) - 1];
    return selected == 1 && effects == 2;
}

*int sub optionalGuardedListIndex(int value, *int index) {
    return repeatValue(value)[index];
}

*int sub guardedUnusedBoxedListIndex(
        int value, string unused, int index) {
    return repeatWithUnusedBoxed(value, unused)[index];
}

bool sub missingHashProjection(int value) {
    return makeRow(value, value + 1, value + 2).missing === NOTHING;
}

bool sub repeatedMissingLocalProjection(int value) {
    hash<string, int> row = makeRow(value, value + 1, value + 2);
    *int first = row.missing;
    *int second = row.missing;
    *int third = row.missing;
    return first === NOTHING
        && second === NOTHING && third === NOTHING;
}

*int sub dynamicHashKeyProjection(int value, string key) {
    return makeRow(value, value + 1, value + 2){key};
}

*int sub repeatedDynamicHashKeyProjection(int value, string key) {
    hash<string, int> row = makeRow(value, value + 1, value + 2);
    *int first = row{key};
    *int second = row{key};
    return first === second ? first : NOTHING;
}

*int sub dynamicDuplicateHashKeyProjection(
        int first, int second, string key) {
    return makeDuplicate(first, second){key};
}

bool sub dynamicHashDifferentKeys(string left_key, string right_key) {
    hash<string, int> row = makeRow(4, 5, 6);
    return row{left_key} == 4 && row{right_key} == 6;
}

bool sub optionalDynamicHashKey(int value, *string key) {
    return makeRow(value, value + 1, value + 2){key} === NOTHING;
}

string sub setProjectionKey(reference<int> effects) {
    effects = 2;
    return \"middle\";
}

bool sub dynamicHashSideEffectOrder() {
    int effects = 0;
    *int selected = makeRow((effects = 1), 5, 6){
        setProjectionKey(\\effects)
    };
    return selected == 5 && effects == 2;
}

int sub boxedListSize() {
    return makeWords(\"a\", \"b\").size();
}

bool sub optionalInput(*int value) {
    try {
        int result = makeRow(1, value, 3).middle;
        return result == 0;
    } catch (hash<auto> ex) {
        return value === NOTHING;
    }
}

bool sub optionalListInput(*int value) {
    try {
        int result = makeValues(1, value, 3).size();
        return result == 0;
    } catch (hash<auto> ex) {
        return value === NOTHING;
    }
}

int sub emptyZeroArgProjections() {
    int checksum = 0;
    checksum += makeEmptyValues().size();
    checksum += makeEmptyValues().empty() ? 1 : 100;
    checksum += makeEmptyValues().val() ? 100 : 1;
    checksum += elements makeEmptyRow();
    checksum += exists makeEmptyRow() ? 100 : 1;
    checksum += makeConstantValues()[1];
    checksum += makeConstantRow().right;
    return checksum;
}

