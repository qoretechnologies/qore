foreach string function in (("hashSizeProjection", "hashEmptyProjection",
        "hashValProjection")) {
    if (!enabled_compile.regex(sprintf(
            "IR-OPT-AOT-EFFECTS: %s[^:]*:.*aggregate-projections=1",
            function))) {
        printf("missing hash pseudo consumer projection for %s:\n%s",
            function, enabled_compile);
        exit(2);
    }
}
if (enabled_compile
        !~ /IR-OPT-AOT-EFFECTS: aggregateConsumerSideEffects[^:]*:.*aggregate-projections=1/) {
    printf("missing side-effecting aggregate consumer projection:\n%s",
        enabled_compile);
    exit(2);
}
if (enabled_compile
            =~ /IR-OPT-AOT-EFFECTS: (nonDominatingAssignment|mixedPhiProjection|nothingPhiProjection|sharedMutated|boxedMixedUse|nonComposedBindingProjection|optionalAggregateConsumer|dynamicMixedListIndex|optionalGuardedListIndex|guardedUnusedBoxedListIndex|guardedMutableLocalProjection|guardedDifferentIndexProjection|guardedMutableDirectPhiProjection|guardedDirectPhiSideEffectOrder|guardedReferenceDirectPhiProjection|dynamicHashDifferentKeys|optionalDynamicHashKey|dynamicHashSideEffectOrder|optionalInput|optionalListInput|noNarrowProjection|optionalDefaultUnsetProjection|hashSizeOverride|conditionalSideEffectProjection|potentiallyLoopingProjection|conditionalDifferentComputedProjection|conditionalDifferentZeroProjection)[^:]*:.*aggregate-projections=[1-9]/
        || disabled_compile =~ /aggregate-projections=[1-9]/) {
    printf("unsafe or disabled aggregate-return projection:\n%s",
        enabled_compile + disabled_compile);
    exit(2);
}
if (shape_disabled_compile
        =~ /IR-OPT-AOT-EFFECTS: (variableShapeProjection|variableEmptyProjection|variableValProjection|variableElementsProjection)[^:]*:.*aggregate-projections=[1-9]/) {
    printf("disabled conditional aggregate shape projection:\n%s",
        shape_disabled_compile);
    exit(2);
}
foreach string function in (("sharedEscapes", "sharedListSizeConsumer",
        "sharedBoxedHashConsumer")) {
    if (!enabled_compile.regex(sprintf(
            "IR-OPT-AOT-EFFECTS: %s[^:]*:.*aggregate-projections=1",
            function))) {
        printf("missing composed aggregate consumer projection for %s:\n%s",
            function, enabled_compile);
        exit(2);
    }
}
if (enabled_compile
        =~ /IR-OPT-AOT-EFFECTS: (sharedMutatingConsumer|requiredUnsetConsumer)[^:]*:.*aggregate-projections=[1-9]/) {
    printf("unsafe aggregate consumer projection:\n%s",
        enabled_compile);
    exit(2);
}

string qo_compile = backquote(sprintf(
    "LD_LIBRARY_PATH=%s %s -O3 -c --output-dir=%s %s 2>&1",
    libqore_dir, qcc_bin, qo_dir, src));
string qo = qo_dir + "/" + regex_subst(basename(src), "\\.qr$", ".qo");
if (!is_file(qo)) {
    printf(".qo compile failed:\n%s", qo_compile);
    exit(2);
}
string dump = backquote(sprintf(
    "LD_LIBRARY_PATH=%s %s --dump-index-json %s 2>&1",
    libqore_dir, qcc_bin, qo));
