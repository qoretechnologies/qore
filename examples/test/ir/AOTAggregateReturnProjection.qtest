#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
string libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
string qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
    ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : dirname(qore_bin) + "/qcc");
if (!is_file(qcc_bin)) {
    qcc_bin = "qcc";
}

string code = "%modern
%disable-warning duplicate-hash-key

hash<string, int> sub makeRow(int left, int middle, int right) {
    return {
        \"left\": left,
        \"middle\": middle,
        \"right\": right,
    };
}

list<int> sub makeValues(int left, int middle, int right) {
    return (left, middle, right);
}

int guarded_reference_index = 0;

list<int> sub makeValuesAndSetGuard(
        int left, int middle, int right) {
    guarded_reference_index = 1;
    return (left, middle, right);
}

list<int> sub repeatValue(int value) {
    return (value, value, value);
}

list<int> sub repeatComputedValue(int value) {
    return (value + 7, value + 7, value + 7);
}

list<float> sub repeatFloat(float value) {
    return (value, value);
}

list<float> sub signedZeroValues() {
    return (-0.0, 0.0);
}

list<bool> sub repeatBool(bool value) {
    return (value, value, value);
}

list<auto> sub makeMixedValues(int value, float ratio, bool enabled) {
    return (value, ratio, enabled);
}

list<int> sub repeatConstant() {
    return (17, 17);
}

list<int> sub repeatWithUnusedBoxed(int value, string unused) {
    return (value, value);
}

list<float> sub makeFloats(float left, float right) {
    return (left, right);
}

list<string> sub makeWords(string left, string right) {
    return (left, right);
}

list<auto> sub forwardAuto(auto value) {
    return (value,);
}

list<hash<auto>> sub forwardNoNarrow(hash<auto!> value) {
    return (value,);
}

list<*int> sub forwardOptional(*int value) {
    return (value,);
}

list<*int> sub forwardOptionalDefault(*int value = 43) {
    return (value,);
}

hash<string, string> sub makeWordMap(string left, string right) {
    return {
        \"left\": left,
        \"right\": right,
    };
}

hash<string, int> sub makeDuplicate(int first, int second) {
    return {
        \"same\": first,
        \"same\": second,
    };
}

hash<string, int> sub makeTagged(int value) {
    return {
        \"value\": value,
        \"scale\": 3,
        \"bias\": 7,
    };
}

hash<string, int> sub makeComputedRow(int left, int middle, int right) {
    return {
        \"left\": left,
        \"middle\": middle + 0,
        \"right\": right,
    };
}

list<int> sub makeComputedValues(int value) {
    return (value + 7,);
}

list<float> sub makeComputedFloats(float value) {
    return (value + 1.25,);
}

list<int> sub makeTwoParamComputedValues(int left, int right) {
    return (left + right,);
}

list<int> sub makeBoundedValues(int left, int right) {
    return (left + right, left - right, left * right, left * 3);
}

list<bool> sub makeComparedValues(int left, int right) {
    return (left == right, left != right, left < right, left <= right,
        left > right, left >= right);
}

list<float> sub makeFloatConstant(float value) {
    return (value, 2.5);
}

list<int> sub makeIntConstant(int value) {
    return (value, 42);
}

list<bool> sub makeBoolConstant(bool value) {
    return (value, True);
}

list<int> sub makeConditionalValues(bool reverse, int left, int right) {
    if (reverse) {
        return (right, left, 7);
    }
    return (left, right, 9);
}

list<float> sub makeConditionalFloats(
        bool reverse, float left, float right) {
    if (reverse) {
        return (right, left);
    }
    return (left, right);
}

list<bool> sub makeConditionalBools(
        bool reverse, bool left, bool right) {
    if (reverse) {
        return (right, left);
    }
    return (left, right);
}

list<int> sub makeConditionalComputedValues(bool reverse,
        int left, int right, int invariant) {
    if (reverse) {
        return (right, left, invariant + 7, invariant * 3,
            left + right, 11);
    }
    return (left, right, invariant + 7, invariant * 3,
        left + right, 11);
}

list<float> sub makeConditionalComputedFloats(bool reverse,
        float left, float right, float invariant) {
    if (reverse) {
        return (right, invariant + 0.25, -0.0);
    }
    return (left, invariant + 0.25, -0.0);
}

list<bool> sub makeConditionalComparedValues(bool reverse,
        bool left, bool right, int lhs, int rhs) {
    if (reverse) {
        return (right, left, lhs < rhs, True);
    }
    return (left, right, lhs < rhs, True);
}

list<auto> sub makeConditionalAutoValues(bool reverse,
        int left, int right, int invariant) {
    if (reverse) {
        return (right, invariant + 7);
    }
    return (left, invariant + 7);
}

list<int> sub makeConditionalDifferentComputed(
        bool alternate, int value) {
    if (alternate) {
        return (value + 1,);
    }
    return (value + 2,);
}

list<float> sub makeConditionalDifferentZero(bool negative) {
    if (negative) {
        return (-0.0,);
    }
    return (0.0,);
}

list<int> sub makeVariableShape(bool long_value, int value) {
    if (long_value) {
        return (value, value + 1, value + 2);
    }
    return (value, value + 1);
}

list<int> sub makeMaybeValues(bool present, int value) {
    if (present) {
        return (value,);
    }
    return ();
}

int conditional_shape_effects = 0;

list<int> sub makeConditionalSideEffect(bool reverse, int value) {
    ++conditional_shape_effects;
    if (reverse) {
        return (value + 1, value);
    }
    return (value, value + 1);
}

list<int> sub makePotentiallyLooping(bool loop, bool alternate) {
    while (loop) {
    }
    if (alternate) {
        return (1, 2);
    }
    return (3, 4);
}

list<int> sub makeEmptyValues() {
    return ();
}

hash<string, int> sub makeEmptyRow() {
    return {};
}

list<int> sub makeConstantValues() {
    return (3, 5, 7);
}

hash<string, int> sub makeConstantRow() {
    return {
        \"left\": 11,
        \"right\": 13,
    };
}

hash<string, int> sub remapRow(int left, int middle, int right) {
    return makeRow(right, left, middle);
}

hash<string, int> sub forwardRow(int left, int middle, int right) {
    return remapRow(middle, right, left);
}

hash<string, int> sub taggedWrapper(int value) {
    return makeTagged(value);
}

list<string> sub wordWrapper(string left, string right) {
    return makeWords(right, left);
}

list<int> sub valuesWrapper(int left, int middle, int right) {
    return makeValues(right, middle, left);
}

hash<string, int> sub computedWrapper(int left, int middle, int right) {
    return makeRow(left + 7, middle, right);
}

list<int> sub nestedComputedWrapper(int value) {
    return makeComputedValues(value + 3);
}

list<float> sub computedFloatWrapper(float left, float right) {
    return makeFloats(left + 0.25, right);
}

hash<string, hash<string, int>> sub wrapRow(
        hash<string, int> row, hash<string, int> unused) {
    return {
        \"row\": row,
        \"unused\": unused,
    };
}

hash<string, hash<string, hash<string, int>>> sub wrapRows(
        hash<string, hash<string, int>> rows,
        hash<string, hash<string, int>> unused) {
    return {
        \"rows\": rows,
        \"unused\": unused,
    };
}

hash<string, list<string>> sub wrapWords(
        list<string> words, list<string> unused) {
    return {
        \"words\": words,
        \"unused\": unused,
    };
}

list<string> sub makeFirstWord(string value, string ignored) {
    return (value,);
}

list<string> sub bindingWrapper(string value, softstring ignored) {
    return makeFirstWord(value, ignored);
}

int sub freshHashProjection() {
    return makeRow(4, 5, 6).middle;
}

int sub sideEffectProjection() {
    int projection_effects = 0;
    int value = makeRow((projection_effects = 1),
        (projection_effects = 2), (projection_effects = 3)).middle;
    return value * 10 + projection_effects;
}

int sub freshListSize() {
    return makeValues(7, 8, 9).size();
}

int sub freshListProjection() {
    return makeValues(4, 5, 6)[-1];
}

bool sub freshFloatProjection() {
    return makeFloats(1.25, 2.5)[-1] == 2.5;
}

int sub duplicateKeyProjection() {
    return makeDuplicate(10, 11).same;
}

int sub constantHashProjection() {
    return makeTagged(10).scale;
}

bool sub constantFloatProjection() {
    return makeFloatConstant(1.25)[1] == 2.5;
}

int sub constantIntProjection() {
    return makeIntConstant(1)[1];
}

bool sub constantBoolProjection() {
    return makeBoolConstant(False)[1];
}

string sub boxedListProjection() {
    return makeWords(\"alpha\", \"beta\")[0];
}

string sub boxedHashProjection() {
    return makeWordMap(\"alpha\", \"beta\").right;
}

string sub appendMark(string value) {
    return value + \"!\";
}

string sub boxedTemporaryProjection() {
    return makeWords(appendMark(\"left\"), appendMark(\"right\"))[0];
}

string sub boxedMultiListProjection() {
    string left = \"left-projection-value\";
    string right = \"right-projection-value\";
    list<string> words = makeWords(left, right);
    return words[0] + \"/\" + words[1] + \"/\" + words[0];
}

string sub boxedMultiHashProjection() {
    string left = \"hash-left-projection-value\";
    string right = \"hash-right-projection-value\";
    hash<string, string> words = makeWordMap(left, right);
    return words.left + \"/\" + words.right + \"/\" + words.left;
}

int sub wrapperProjection() {
    return forwardRow(10, 11, 12).middle;
}

int sub wrapperConstantProjection() {
    return taggedWrapper(9).scale;
}

string sub wrapperBoxedProjection() {
    return wordWrapper(\"left\", \"right\")[0];
}

int sub wrapperListSize() {
    return valuesWrapper(1, 2, 3).size();
}

int sub computedWrapperProjection(int value) {
    return computedWrapper(value, 2, 3).left;
}

bool sub computedWrapperOverflowProjection() {
    return computedWrapperProjection(9223372036854775807)
        == -9223372036854775802;
}

int sub nestedComputedWrapperProjection(int value) {
    return nestedComputedWrapper(value)[0];
}

bool sub nestedComputedWrapperOverflowProjection() {
    return nestedComputedWrapperProjection(9223372036854775807)
        == -9223372036854775799;
}

bool sub computedFloatWrapperProjection() {
    return computedFloatWrapper(1.25, 2.5)[0] == 1.5;
}

string sub nonComposedBindingProjection() {
    return bindingWrapper(\"kept\", 42)[0];
}

int sub nestedNativeProjection() {
    return wrapRow(makeRow(1, 2, 3), makeRow(4, 5, 6)).row.middle;
}

int sub nestedSideEffectProjection() {
    int effects = 0;
    int value = wrapRow(
        makeRow((effects = 1), (effects = 2), (effects = 3)),
        makeRow((effects = 4), (effects = 5), (effects = 6))).row.middle;
    return value * 10 + effects;
}

int sub deepNestedProjection() {
    return wrapRows(
        wrapRow(makeRow(7, 8, 9), makeRow(10, 11, 12)),
        wrapRow(makeRow(13, 14, 15), makeRow(16, 17, 18)))
        .rows.row.middle;
}

string sub nestedBoxedProjection() {
    return wrapWords(
        makeWords(\"alpha\", \"beta\"),
        makeWords(\"unused-left\", \"unused-right\")).words[1];
}

int sub nestedLocalProjection() {
    hash<string, hash<string, int>> wrapper = wrapRow(
        makeRow(1, 2, 3), makeRow(4, 5, 6));
    return wrapper.row.middle;
}

int sub nestedPhiProjection(bool left_branch) {
    return (left_branch
        ? wrapRow(makeRow(1, 2, 3), makeRow(4, 5, 6))
        : wrapRow(makeRow(7, 8, 9), makeRow(10, 11, 12))).row.middle;
}

int sub sharedNestedInput() {
    hash<string, int> row = makeRow(1, 2, 3);
    return wrapRow(row, makeRow(4, 5, 6)).row.middle + row.left;
}

int sub nonNestedComputedProjection() {
    return wrapRow(
        makeComputedRow(1, 2, 3), makeRow(4, 5, 6)).row.middle;
}

int sub listFirstProjection() {
    return makeValues(4, 5, 6).first();
}

int sub listLastProjection() {
    return makeValues(4, 5, 6).last();
}

bool sub listEmptyProjection() {
    return makeValues(4, 5, 6).empty();
}

bool sub listValProjection() {
    return makeValues(4, 5, 6).val();
}

int sub listElementsProjection() {
    return elements makeValues(4, 5, 6);
}

int sub hashElementsProjection() {
    return elements makeRow(4, 5, 6);
}

int sub duplicateHashElementsProjection() {
    return elements makeDuplicate(4, 5);
}

bool sub listExistsProjection() {
    return exists makeValues(4, 5, 6);
}

bool sub hashExistsProjection() {
    return exists makeRow(4, 5, 6);
}

int sub aggregateConsumerSideEffects() {
    int effects = 0;
    int count = elements makeValues(
        (effects = 1), (effects = 2), (effects = 3));
    return count * 10 + effects;
}

int sub nonConsumerComputedProjection() {
    return elements makeComputedRow(1, 2, 3);
}

int sub computedIntProjection(int value) {
    return makeComputedValues(value)[0];
}

int sub computedBoxedIntProjection(int value) {
    return makeComputedValues(value).first();
}

bool sub computedIntOverflowProjection() {
    return computedIntProjection(9223372036854775807)
        == -9223372036854775802;
}

bool sub computedFloatProjection() {
    return makeComputedFloats(2.5)[0] == 3.75;
}

int sub twoParamComputedProjection() {
    return makeTwoParamComputedValues(2, 3)[0];
}

bool sub boundedExpressionProjection() {
    return makeBoundedValues(2, 3)[0] == 5
        && makeBoundedValues(2, 3)[1] == -1
        && makeBoundedValues(2, 3)[2] == 6
        && makeBoundedValues(2, 3)[3] == 6
        && makeBoundedValues(2, 3).first() == 5
        && makeBoundedValues(9223372036854775807, 2)[2] == -2
        && makeComparedValues(2, 3)[0] == False
        && makeComparedValues(2, 3)[1] == True
        && makeComparedValues(2, 3)[2] == True
        && makeComparedValues(2, 3)[3] == True
        && makeComparedValues(2, 3)[4] == False
        && makeComparedValues(2, 3)[5] == False;
}

bool sub optionalAggregateConsumer(*int value) {
    try {
        return (elements makeValues(1, value, 3)) == 3;
    } catch (hash<auto> ex) {
        return value === NOTHING;
    }
}

int sub hashSizeProjection() {
    return makeRow(1, 2, 3).size();
}

