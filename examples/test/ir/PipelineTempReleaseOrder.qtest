#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-exec-mode: children - its checks run in child processes that set their own execution modes
# test-platform: macos - JIT and AOT code generation of the exception edges of functional loops

# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../ExecModeHarness.qm
%requires ../TestInterpreter.qm
%exec-class PipelineTempReleaseOrderTest

#! the temporaries of an element of a pipeline are released before the catch block of a try statement (qore#6072)
/** The cleanup blocks of a select stage that map, fold or first stages follow were lowered by native code after the code
    after the pipeline, which closes the temp scope of the statement: their exception edges released none of its
    temporaries, which were released after the catch block.
*/
class PipelineTempReleaseOrderTest inherits QUnit::Test {
    private {
        string qore_bin = executablePath(TestInterpreter::qore_interpreter());
        string lib_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        string qcc_bin = ENV.QCC ?? lib_dir + "/qcc";
        string probe = get_script_dir() + "/PipelineTempReleaseOrder/probe.q";
        *string ast_out;
    }

    constructor() : Test("pipeline temporary release order", "1.0", \ARGV) {
        addTestCase("AST releases the temporaries before the catch blocks", \astReference());
        addTestCase("compiled modes match AST", \sourceModes());
        addTestCase("qcc executables match AST", \compiled());
        set_return_value(main());
    }

    astReference() {
        string out = getAst();
        assertRegex("~top-old\ntop args 1 1\n", out);
        assertRegex("~captured-old\ncaptured args 1 1\ncaptured captured-new\n~captured-new\n", out);
        assertRegex("~condition-old\nconstructor args 1 1\n~condition-new\n"
            + "~pipeline-old\nconstructor pipeline\n~pipeline-new\n~local-old\nlocal args 1 1\n~local-new\n"
            + "held held-old held-new\n~held-old\n~held-new\n", out);
        foreach string c in ("map-select", "map-select-map", "foldl-select", "first", "condition", "plain-map") {
            assertRegex("\n~[a-z]+1\n~[a-z]+2\ntop " + c + ": caught ERR\n", "\n" + out, c);
            assertRegex("\n~[a-z]+1\n~[a-z]+2\nfunction " + c + ": caught ERR\n", "\n" + out, c);
        }
        assertRegex("~lo11\n~lo12\nloop 1: caught ERR\n~lo21\n~lo22\nloop 2: caught ERR\n", out);
        assertRegex("~plain\nmark plain\nfirst 1\nmark reference\n~reference\nfirst 1\n", out, "fused first source lifetime");
        assertRegex("~local\nmark local\nfirst 1\n", out, "IR-only source local");
        assertRegex("~top-plain\nmark top-plain\nmark top-reference\n~top-reference\n", out);
        assertFalse(out =~ /none/, out);
    }

    sourceModes() {
        string expected = getAst();
        foreach string mode in ("ir", "jit") {
            assertEq(expected, run(("QORE_JIT_SYNC_COMPILE=1", qore_bin, "-b", "--enable-debug", "--exec-mode=" + mode,
                probe)), mode);
        }
        assertEq(expected, run(("QORE_JIT_SYNC_COMPILE=1", "QORE_IR_THRESHOLD=1", "QORE_JIT_THRESHOLD=1", qore_bin,
            "-b", "--enable-debug", "--exec-mode=tiered", probe)), "tiered");
    }

    compiled() {
        string expected = getAst();
        foreach string level in ("-O0", "-O3") {
            TmpDir dir("qore-pipeline-temp-release-order-");
            string exe = dir.path + "/probe";
            run((qcc_bin, level, "-o", exe, probe));
            assertEq(expected, run((exe, "-b", "--enable-debug")), "qcc " + level);
        }
    }

    private string getAst() {
        if (!exists ast_out) {
            ast_out = run((qore_bin, "-b", "--enable-debug", "--exec-mode=ast", probe));
        }
        return ast_out;
    }

    private static string quote(string value) {
        return "'" + join("'\\''", split("'", value)) + "'";
    }

    private static string executablePath(string name) {
        if (name.regex("/")) {
            return realpath(name);
        }
        foreach string directory in (split(":", ENV.PATH ?? "")) {
            string path = (directory ? directory : ".") + "/" + name;
            if (is_executable(path)) {
                return realpath(path);
            }
        }
        throw "TEST-SETUP-ERROR", "cannot locate Qore executable " + name;
    }

    #! runs a command; one that runs qore with an execution mode runs through ExecModeHarness
    private string run(list<string> args) {
        string command = "env LD_LIBRARY_PATH=" + quote(lib_dir) + " QORE_LIBDIR=" + quote(lib_dir) + " "
            + (map quote($1), args).join(" ");
        hash<ExecModeHarness::ModeRunResult> r = ExecModeHarness::run_command(command);
        if (r.mode) {
            ExecModeHarness::check_native(r);
        }
        assertEq(0, r.rc, r.out);
        return r.out;
    }
}
