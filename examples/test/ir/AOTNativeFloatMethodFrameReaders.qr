#!/usr/bin/env qore
# Copyright (c) 2026 Qore Technologies, s.r.o.
# SPDX-License-Identifier: MIT
%modern

hashdecl NativeFloatMethodFrameReadResult {
    int seen;
    list<string> errors;
}

class NativeFloatReaderA {
    float next(float value) { return 65535.0 - value; }
}
class NativeFloatReaderB inherits NativeFloatReaderA {
    float next(float value) { return 65537.0 - value; }
}

float sub nativeFloatMethodReaderBatch(NativeFloatReaderA first, NativeFloatReaderA second, bool replace) {
    float value = 0.0;
    for (int i = 0; i < 4096; ++i) {
        NativeFloatReaderA receiver = replace && (i & 1) ? first : second;
        value = receiver.next(value);
    }
    return value;
}

float sub nativeFloatGenericMethodReaderBatch(auto first, auto second, bool replace) {
    auto value = 0.0;
    for (int i = 0; i < 4096; ++i) {
        value = (replace && (i & 1) ? first : second).next(value);
    }
    return value;
}

sub nativeFloatMethodReaderCaller(Counter started, Counter readers, Counter done, Queue failures) {
    on_exit done.dec();
    NativeFloatReaderA first();
    NativeFloatReaderB second();
    started.dec();
    bool replace = False;
    bool generic = !!ARGV;
    while (readers.getCount()) {
        float actual = generic ? nativeFloatGenericMethodReaderBatch(first, second, replace)
            : nativeFloatMethodReaderBatch(first, second, replace);
        if (actual != (replace ? -4096.0 : 0.0)) {
            failures.push("incorrect callback result");
            return;
        }
        replace = !replace;
    }
}

sub nativeFloatMethodReader(Counter readers, Counter done, Queue results) {
    on_exit {
        readers.dec();
        done.dec();
    }
    hash<NativeFloatMethodFrameReadResult> result();
    result.seen = 0;
    result.errors = ();
    for (int i = 0; i < 400; ++i) {
        hash<string, list<hash<CallStackInfo>>> stacks = get_all_thread_call_stacks();
        foreach hash<auto> tid_stack in (stacks.pairIterator()) {
            bool caller = False;
            foreach hash<CallStackInfo> frame in (tid_stack.value) {
                if (frame.function == "nativeFloatMethodReaderCaller") {
                    caller = True;
                    break;
                }
            }
            if (!caller) {
                continue;
            }
            foreach hash<CallStackInfo> frame in (tid_stack.value) {
                # Baseline compiled background scopes can have an empty name;
                # AST method frames use bare "next". Validate named method
                # frames without treating those existing representations as new failures.
                if (frame.type == "user" && !frame.function.empty()
                        && frame.function != "nativeFloatMethodReaderCaller"
                        && frame.function != "nativeFloatGenericMethodReaderBatch"
                        && frame.function != "nativeFloatMethodReaderBatch" && frame.function != "NativeFloatReaderA::next"
                        && frame.function != "NativeFloatReaderB::next" && frame.function != "next") {
                    result.errors += sprintf("unexpected caller frame: %y", frame);
                }
                if (frame.function == "NativeFloatReaderA::next" || frame.function == "NativeFloatReaderB::next"
                        || frame.function == "next") {
                    ++result.seen;
                    if (frame.type != "user" || frame.file.empty() || frame.line < 0
                            || frame.endline < frame.line) {
                        result.errors += sprintf("invalid native frame: %y", frame);
                    }
                }
            }
        }
    }
    results.push(result);
}

Counter started(4);
Counter readers(2);
Counter callers_done(4);
Counter readers_done(2);
Queue failures();
Queue results();
for (int i = 0; i < 4; ++i) {
    background nativeFloatMethodReaderCaller(started, readers, callers_done, failures);
}
started.waitForZero();
for (int i = 0; i < 2; ++i) {
    background nativeFloatMethodReader(readers, readers_done, results);
}
readers_done.waitForZero();
callers_done.waitForZero();
int seen = 0;
for (int i = 0; i < 2; ++i) {
    hash<NativeFloatMethodFrameReadResult> result = results.get(10000);
    seen += result.seen;
    if (result.errors) {
        throw "NATIVE-METHOD-FRAME-TEST", result.errors.join("\n");
    }
}
if (!seen || failures.size()) {
    throw "NATIVE-METHOD-FRAME-TEST", sprintf("observed %d leaf frames; %d caller failures", seen, failures.size());
}
printf("native-float-method-frame-readers: ok\n");
