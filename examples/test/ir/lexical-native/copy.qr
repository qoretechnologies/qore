# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%no-child-restrictions
%requires compatprobe
%requires reflection

auto sub invoke(Program target, string name) { return target.callFunction(name); }

const Cases = {
    "native_origin": 'return CompatProbe::native_copy(obj).observed()[0];',
    "native_restore": 'return CompatProbe::native_copy_state(obj);',
    "native_exception": 'CompatProbe::NativeProbe failing("text", True); return CompatProbe::native_copy_state(failing);',
    "user_exception": 'ThrowCopy failing(); return CompatProbe::native_copy_state(failing);',
    "direct": 'return obj.copy().observed()[0];',
    "dynamic": 'return call_object_method(obj, "copy").observed()[0];',
    "reflection_method": 'return cls.getCopyMethod().call(obj).observed()[0];',
    "reflection_variant": 'return cls.getCopyVariant().call(obj).observed()[0];',
    "self_copy": 'Derived derived(); return derived.duplicate().observed()[0];',
    "implicit_base": 'Derived derived(); return derived.copy().observed()[0];',
    "leaf_implicit_base": 'Leaf derived(); return derived.copy().observed()[0];',
    "user_copy_base": 'UserCopy derived(); return derived.copy().observed()[0];',
};
int failures;
foreach bool declaration_legacy in (False, True) {
    foreach bool legacy in (False, True) {
        Program p(PO_NEW_STYLE | PO_REQUIRE_TYPES | PO_STRICT_ARGS | PO_NO_CHILD_PO_RESTRICTIONS);
        if (declaration_legacy) p.setParseOptions(PO_STRICT_BOOLEAN_EVAL);
        p.parsePending('%requires compatprobe
%requires reflection
            class Derived inherits CompatProbe::NativeProbe {
                constructor() : CompatProbe::NativeProbe("text", False) {}
                auto duplicate() { return copy(); }
            }
            class UserCopy inherits CompatProbe::NativeProbe {
                constructor() : CompatProbe::NativeProbe("text", False) {}
                copy() {}
            }
            class Leaf inherits UserCopy {}
            class ThrowCopy inherits CompatProbe::NativeProbe {
                constructor() : CompatProbe::NativeProbe("text", False) {}
                copy() { throw "COPY-ERROR"; }
            }
        ', "native-copy-declarations");
        if (legacy) p.setParseOptions(PO_STRICT_BOOLEAN_EVAL);
        else p.disableParseOptions(PO_STRICT_BOOLEAN_EVAL);
        string source;
        foreach string name in (keys Cases) {
            source += 'auto sub ' + name + '() {
                CompatProbe::NativeProbe obj("text", False);
                Reflection::Class cls = Reflection::Class::forName("CompatProbe::NativeProbe");
                ' + Cases{name} + ' }
            ';
        }
        p.parsePending(source, "native-copy-policy");
        p.parseCommit();
        foreach int mutation in (0, 1) {
            foreach string name in (keys Cases) {
                auto actual = invoke(p, name);
                auto expected = name == "native_origin" ? True
                    : (name == "self_copy" || name == "user_copy_base") ? !declaration_legacy : !legacy;
                if (name == "native_restore" || name == "native_exception" || name == "user_exception") {
                    expected = (!legacy, !legacy, name != "native_restore");
                }
                bool passed = actual === expected;
                printf("%s declaration=%y caller=%y mutated=%d expected=%y actual=%y %s\n",
                    name, declaration_legacy, legacy, mutation, expected, actual, passed ? "PASS" : "FAIL");
                if (!passed) ++failures;
            }
            if (legacy) p.disableParseOptions(PO_STRICT_BOOLEAN_EVAL);
            else p.setParseOptions(PO_STRICT_BOOLEAN_EVAL);
        }
    }
}
if (failures) throw "NATIVE-COPY-POLICY", sprintf("%d failures", failures);
printf("PASS\n");
