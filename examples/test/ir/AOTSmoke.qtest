}

hash<auto> h = {\"a\": (), \"b\": (2,), \"c\": (1, 2, 3)};
map remove_value(\\h{$1}, 2), h.keyIterator();
printf(\"%d:%d:%d:%d\\n\", h.a.size(), h.b.size(), h.c.size(), h.c[1]);
