        printf(\"captured=%s\\n\", t.className());
    }
}

class Holder {
    run() {
        Program p = new Program(PO_NEW_STYLE);
        p.setThreadInit(sub () {Target::check(self);});
        p.parse(\"%modern
background sub () {
}();
sleep(100ms);
\", \"child\");
