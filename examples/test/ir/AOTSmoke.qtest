    testControlFlow() {
        string code = "%modern
int x = 42;
if (x > 40) {
    printf(\"big\\n\");
} else {
    printf(\"small\\n\");
}

int count = 0;
while (count < 5) {
    ++count;
}
printf(\"count: %d\\n\", count);

int total = 0;
int i = 0;
do {
    total += i;
    ++i;
} while (i < 5);
printf(\"total: %d\\n\", total);

switch (x) {
    case 42:
        printf(\"matched\\n\");
        break;
    default:
        printf(\"no match\\n\");
        break;
}
";
