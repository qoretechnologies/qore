    }

    testFunctions() {
        string code = "%modern
int sub factorial(int n) {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

int sub fibonacci(int n) {
    if (n <= 1) {
        return n;
    }
    return fibonacci(n - 1) + fibonacci(n - 2);
}

printf(\"fact(10): %d\\n\", factorial(10));
printf(\"fib(10): %d\\n\", fibonacci(10));
";
