    testStripSourceReferenceMemberParseReference() {
        string code = "%modern
class Holder {
    public {
        static hash<auto> h();
        reference<hash<auto>> r;
    }

    constructor() {
        r = \\h;
    }

    *hash<auto> getHashViaMemberReference() {
        reference<auto> rr = \\self.r;
        return rr;
    }
}

Holder holder();
printf(\"%y\\n\", holder.getHashViaMemberReference());
exit(0);
";
