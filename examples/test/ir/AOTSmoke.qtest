        guard = new Guard();
    }

    touch(string key) {
    }

    run() {
        hash<auto> h = {\"a\": 1, \"b\": 2};
        map useContext($1, self), keys h;
        map touch($1), keys h;
    }
}

sub useContext(string key, Context ctx) {
    ctx.touch(key);
}

sub launch() {
