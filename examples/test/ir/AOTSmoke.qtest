%requires StripHashDeclInhMod

hash<StripHashDeclInhMod::ExtendedInfo> info = StripHashDeclInhMod::getExtendedInfo(\"id123\", \"test\", 99);
printf(\"id: %s, name: %s, value: %d\\n\", info.id, info.name, info.value);
exit(0);
";
