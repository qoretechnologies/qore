    testAOTModuleClosureCapturedLoopCondition() {
        string tmp_dir = sprintf("/tmp/aot_closure_loop_%d", getpid());
        mkdir(tmp_dir);
        on_exit {
            backquote(sprintf("rm -rf %s", tmp_dir));
