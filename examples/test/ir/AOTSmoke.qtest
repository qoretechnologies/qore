class Inner {
    string openInputStream() {
        return \"ok\";
    }
}

class Outer {
    auto memberGate(string key) {
        if (key == \"file\") {
            return new Inner();
        }
        return NOTHING;
    }
}

Outer outer();
printf(\"%s\\n\", outer.file.openInputStream());
";
