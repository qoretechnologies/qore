#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

%requires QUnit
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires FsUtil

%exec-class AOTSmokeTest

class AOTSmokeTest inherits QUnit::Test {
    private {
        string qore_bin;
        string libqore_dir;
    }

    constructor() : QUnit::Test("AOTSmokeTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? QORE_ARGV[0] ?? "qore";
        # Determine the directory containing libqore (for compile/link)
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        addTestCase("AOT hello world", \testHelloWorld());
        addTestCase("AOT arithmetic", \testArithmetic());
        addTestCase("AOT number literal arithmetic", \testNumberLiteralArithmetic());
        addTestCase("AOT Phase 5.3 fast-path functions", \testPhase53FastPaths());
        addTestCase("AOT control flow", \testControlFlow());
        addTestCase("AOT functions", \testFunctions());
        addTestCase("AOT string operations", \testStringOps());
        addTestCase("AOT regex switch", \testSwitchRegex());
        addTestCase("AOT exit code", \testExitCode());
        addTestCase("AOT ARGV passthrough", \testArgvPassthrough());
        addTestCase("AOT error handling", \testErrorHandling());
        addTestCase("AOT exception stops method execution", \testExceptionStopsMethodExecution());
        addTestCase("AOT compile missing file", \testCompileMissingFile());
        addTestCase("AOT compile default output", \testCompileDefaultOutput());
        # Phase 7b: pointer indirection tests
        addTestCase("AOT all functions pre-compiled", \testAllFunctionsPrecompiled());
        addTestCase("AOT local variable scoping", \testLocalVariableScoping());
        addTestCase("AOT nested duplicate local names", \testNestedDuplicateLocalNames());
        addTestCase("AOT lvalue operations", \testLvalueOps());
        addTestCase("AOT multiple user functions", \testMultipleUserFunctions());
        addTestCase("AOT method calls", \testMethodCalls());
        addTestCase("AOT hash operations", \testHashOps());
        addTestCase("AOT list operations", \testListOps());
        addTestCase("AOT nested function calls", \testNestedFunctionCalls());
        addTestCase("AOT on_exit blocks", \testOnExitBlocks());
        addTestCase("AOT handler re-inlining cycle guard",
            \testHandlerRecursionGuard());
        addTestCase("AOT cross-module same-name dispatch",
            \testCrossModuleSameName());
        addTestCase("AOT ref foreach ParseNode pointer",
            \testRefForeachParseNode());
        addTestCase("AOT ref foreach narrowed element type",
            \testRefForeachNarrowedElement());
        addTestCase("AOT type conversions", \testTypeConversions());
        # AOT opt-level, cross-compilation, and static linking tests
        addTestCase("AOT optimization levels", \testAOTOptLevels());
        addTestCase("AOT target triple", \testAOTTargetTriple());
        addTestCase("AOT static linking", \testAOTStaticLink());
        addTestCase("AOT static link not built", \testAOTStaticLinkNotBuilt());
        # Module compilation tests
        addTestCase("AOT module compile", \testAOTModuleCompile());
        addTestCase("AOT module no-narrow member types", \testAOTModuleNoNarrowMemberTypes());
        addTestCase("AOT module hashdecl member compound lvalue",
            \testAOTModuleHashdeclMemberCompoundLValue());
        addTestCase("AOT module hashdecl class constants", \testAOTModuleHashdeclClassConstants());
        addTestCase("AOT module BCA hashdecl class constants",
            \testAOTModuleBcaHashdeclClassConstants());
        addTestCase("AOT module computed member defaults",
            \testAOTModuleComputedMemberDefaults());
        addTestCase("AOT module closure-captured loop condition",
            \testAOTModuleClosureCapturedLoopCondition());
        addTestCase("AOT module default object args", \testAOTModuleDefaultObjectArgs());
        addTestCase("AOT module compile custom output", \testAOTModuleCompileCustomOutput());
        addTestCase("AOT module compile opt levels", \testAOTModuleCompileOptLevels());
        addTestCase("AOT module compile error", \testAOTModuleCompileError());
        # Split module tests
        addTestCase("AOT split module basic", \testAOTSplitModuleBasic());
        addTestCase("AOT split module qm only", \testAOTSplitModuleQmOnly());
        addTestCase("AOT split module missing qm", \testAOTSplitModuleMissingQm());
        addTestCase("AOT split module auto detect", \testAOTSplitModuleAutoDetect());
        addTestCase("AOT split module trailing slash", \testAOTSplitModuleTrailingSlash());
        # Source stripping tests (Phase 8)
        addTestCase("AOT strip source basic", \testStripSourceBasic());
        addTestCase("AOT strip source arithmetic", \testStripSourceArithmetic());
        addTestCase("AOT strip source strings", \testStripSourceStrings());
        addTestCase("AOT strip source multiple functions", \testStripSourceMultipleFunctions());
        addTestCase("AOT strip source binary size", \testStripSourceBinarySize());
        addTestCase("AOT strip source backward compat", \testStripSourceBackwardCompat());
        addTestCase("AOT strip source compile output", \testStripSourceCompileOutput());
        addTestCase("AOT strip source no source in binary", \testStripSourceNoSourceInBinary());
        # Strip source type export tests (Phase 9)
        addTestCase("AOT strip source hashdecl", \testStripSourceHashDecl());
        addTestCase("AOT strip source hashdecl inheritance", \testStripSourceHashDeclInheritance());
        addTestCase("AOT strip source enum", \testStripSourceEnum());
        addTestCase("AOT strip source module dependency", \testStripSourceModuleDependency());
        # Class inheritance and static member tests
        addTestCase("AOT strip source class inheritance", \testStripSourceClassInheritance());
        addTestCase("AOT strip source static members", \testStripSourceStaticMembers());
        # Map optimization opcodes
        addTestCase("AOT map hash key opcodes", \testAOTMapHashKeyOpcodes());
        addTestCase("AOT direct-index map with heap results", \testAOTDirectIndexMapHeapResults());
        # AOT Binary Format v1 tests
        addTestCase("AOT v1 version field", \testVersionField());
        addTestCase("AOT v1 parse options high bits", \testPOHighBitsRoundTrip());
        addTestCase("AOT v1 source stale detection", \testSourceStaleDetection());
        addTestCase("AOT v1 feature flags", \testFeatureFlagsNonZero());
        addTestCase("AOT subscript compound assign", \testSubscriptCompoundAssign());
        addTestCase("AOT hash compound native", \testHashCompoundNative());
        addTestCase("AOT thread-local vars", \testThreadLocalVars());
        # Strip source: global variable initialization
        addTestCase("AOT strip source global var init", \testStripSourceGlobalVarInit());
        # Strip source: complex hash/list construction via new
        addTestCase("AOT strip source complex type new", \testStripSourceComplexTypeNew());
        # Strip source: runtime constant resolution
        addTestCase("AOT strip source runtime const ref", \testStripSourceRuntimeConstRef());
        # Strip source: static class variable access (module)
        addTestCase("AOT strip source static varref module", \testStripSourceStaticVarrefModule());
        # Strip source: on_exit/on_success handler IR
        addTestCase("AOT strip source on_exit handlers", \testStripSourceOnExitHandlers());
        addTestCase("AOT strip source on_exit builtin class", \testStripSourceOnExitBuiltinClass());
        addTestCase("AOT strip source constructor args", \testStripSourceConstructorArgs());
        addTestCase("AOT strip source default args", \testStripSourceDefaultArgs());
        addTestCase("AOT strip source cast parse hash", \testStripSourceCastParseHash());
        # Closure and regex handler serialization tests
        addTestCase("AOT closure in function", \testClosureInFunction());
        addTestCase("AOT closure lambda", \testClosureLambda());
        addTestCase("AOT closure typed params defaults", \testClosureTypedParamsDefaults());
        addTestCase("AOT closure multi capture", \testClosureMultiCapture());
        addTestCase("AOT closure strip source", \testClosureStripSource());
        addTestCase("AOT method closure param", \testAOTMethodClosureParam());
        addTestCase("AOT regex switch in on_exit", \testRegexSwitchInOnExit());
        addTestCase("AOT nested on_exit", \testNestedOnExit());
        # Closure default value serialization tests
        addTestCase("AOT closure default int", \testClosureDefaultInt());
        addTestCase("AOT closure default bool", \testClosureDefaultBool());
        addTestCase("AOT closure default float", \testClosureDefaultFloat());
        addTestCase("AOT closure default multiple", \testClosureDefaultMultiple());
        addTestCase("AOT closure default strip source", \testClosureDefaultStripSource());
        # Operator expression coverage tests (select, keys, instanceof, map)
        addTestCase("AOT operator select standalone", \testOperatorSelectStandalone());
        addTestCase("AOT operator select as argument", \testOperatorSelectAsArgument());
        addTestCase("AOT operator keys", \testOperatorKeys());
        addTestCase("AOT operator instanceof", \testOperatorInstanceof());
        addTestCase("AOT operator map optimized", \testOperatorMapOptimized());
        addTestCase("AOT context row expression", \testContextRowExpression());
        # Closure exception safety tests
        addTestCase("AOT closure exception safety", \testClosureExceptionSafety());
        addTestCase("AOT closure exception outer", \testClosureExceptionOuter());
        # Regression: corrupt .qmod load must not deadlock inside parse-lock scope
        addTestCase("AOT corrupt qmod load no deadlock", \testCorruptQmodLoadNoDeadlock());
        set_return_value(main());
    }

    #! Write code to a temp .q file and return {src_path, out_path}
    private hash<auto> writeTempScript(string code) {
        # Use a unique name with proper .q extension
        string base = sprintf("/tmp/aot_test_%d_%d", getpid(), rand());
        string src_path = base + ".q";
        string out_path = base;

        File f();
        f.open2(src_path, O_WRONLY | O_CREAT | O_TRUNC);
        f.write(code);
        f.close();

        return {
            "src": src_path,
            "out": out_path,
        };
    }

    #! Compile a script with extra compile flags, run it, and return {compile_out, run_out}
    private hash<auto> compileWithFlags(string code, list<string> compile_flags, *list<string> run_args) {
        hash<auto> paths = writeTempScript(code);
        on_exit {
            unlink(paths.src);
            unlink(paths.out);
        }

        # Build compile command with extra flags (flags must come BEFORE the source file)
        string flags_str = "";
        for (int i = 0; i < compile_flags.size(); ++i) {
            flags_str += " " + compile_flags[i];
        }

        string compile_cmd = sprintf("QORE_LIBDIR=%s %s -b --compile --output %s%s %s 2>&1",
            libqore_dir, qore_bin, paths.out, flags_str, paths.src);
        string compile_out = backquote(compile_cmd);

        string run_out;
        if (is_file(paths.out)) {
            string run_cmd = sprintf("LD_LIBRARY_PATH=%s %s -b", libqore_dir, paths.out);
            if (run_args) {
                for (int i = 0; i < run_args.size(); ++i) {
                    run_cmd += " " + run_args[i];
                }
            }
            run_cmd += " 2>&1";
            run_out = backquote(run_cmd);
        } else {
            run_out = "";
        }

        return {
            "compile_out": compile_out,
            "run_out": run_out,
            "compiled": is_file(paths.out),
        };
    }

    #! Try to compile with extra flags and return compile output (no run)
    private string compileOnly(string code, list<string> compile_flags) {
        hash<auto> paths = writeTempScript(code);
        on_exit {
            unlink(paths.src);
            unlink(paths.out);
            unlink(paths.out + ".o");
        }

        # Flags must come BEFORE the source file
        string flags_str = "";
        for (int i = 0; i < compile_flags.size(); ++i) {
            flags_str += " " + compile_flags[i];
        }

        string compile_cmd = sprintf("QORE_LIBDIR=%s %s -b --compile --output %s%s %s 2>&1",
            libqore_dir, qore_bin, paths.out, flags_str, paths.src);
        return backquote(compile_cmd);
    }

    #! Compile a script to a standalone executable, run it, and return stdout
    private string compileAndRun(string code, *list<string> run_args) {
        hash<auto> paths = writeTempScript(code);
        on_exit {
            unlink(paths.src);
            unlink(paths.out);
        }

        # Compile with --include-source for full source fallback (set QORE_LIBDIR so the AOT
        # linker finds the correct libqore)
        string compile_cmd = sprintf("QORE_LIBDIR=%s %s -b --compile --include-source %s --output %s 2>&1",
            libqore_dir, qore_bin, paths.src, paths.out);
        string compile_out = backquote(compile_cmd);

        # Verify the executable was created
        if (!is_file(paths.out)) {
            return "COMPILE_FAILED: " + compile_out;
        }

        # Run the compiled executable
        string run_cmd = sprintf("LD_LIBRARY_PATH=%s %s -b", libqore_dir, paths.out);
        if (run_args) {
            for (int i = 0; i < run_args.size(); ++i) {
                run_cmd += " " + run_args[i];
            }
        }
        run_cmd += " 2>&1";
        return backquote(run_cmd);
    }

    #! Compile a script and return {compile_out, run_out, all_precompiled}
    private hash<auto> compileCheckAndRun(string code, *list<string> run_args) {
        hash<auto> paths = writeTempScript(code);
        on_exit {
            unlink(paths.src);
            unlink(paths.out);
        }

        # Compile with --include-source for full source fallback
        string compile_cmd = sprintf("QORE_LIBDIR=%s %s -b --compile --include-source %s --output %s 2>&1",
            libqore_dir, qore_bin, paths.src, paths.out);
        string compile_out = backquote(compile_cmd);

        # Parse "N/M functions pre-compiled" from compile output
        bool all_precompiled = False;
        *list<string> match = (compile_out =~ x/(\d+)\/(\d+) functions pre-compiled/);
        if (match) {
            all_precompiled = (match[0] == match[1]);
        }

        string run_out;
        if (is_file(paths.out)) {
            string run_cmd = sprintf("LD_LIBRARY_PATH=%s %s -b", libqore_dir, paths.out);
            if (run_args) {
                for (int i = 0; i < run_args.size(); ++i) {
                    run_cmd += " " + run_args[i];
                }
            }
            run_cmd += " 2>&1";
            run_out = backquote(run_cmd);
        } else {
            run_out = "COMPILE_FAILED: " + compile_out;
        }

        return {
            "compile_out": compile_out,
            "run_out": run_out,
            "all_precompiled": all_precompiled,
        };
    }

    #! Run a script with the interpreter and return stdout
    private string runInterpreted(string code, *list<string> run_args) {
        hash<auto> paths = writeTempScript(code);
        on_exit {
            unlink(paths.src);
        }

        string cmd = sprintf("%s -b --enable-debug %s", qore_bin, paths.src);
        if (run_args) {
            for (int i = 0; i < run_args.size(); ++i) {
                cmd += " " + run_args[i];
            }
        }
        cmd += " 2>&1";
        return backquote(cmd);
    }

    testHelloWorld() {
        string code = "%modern\nprintf(\"Hello, World!\\n\");\n";
        string aot_out = compileAndRun(code);
        string interp_out = runInterpreted(code);
        assertEq(interp_out, aot_out, "AOT hello world output matches interpreter");
    }

    testArithmetic() {
        string code = "%modern
int sum = 0;
for (int i = 0; i < 10; ++i) {
    sum += i;
}
printf(\"sum: %d\\n\", sum);

int a = 100;
int b = 37;
printf(\"add: %d\\n\", a + b);
printf(\"sub: %d\\n\", a - b);
printf(\"mul: %d\\n\", a * b);
printf(\"div: %d\\n\", a / b);
printf(\"mod: %d\\n\", a % b);
";
        string aot_out = compileAndRun(code);
        string interp_out = runInterpreted(code);
        assertEq(interp_out, aot_out, "AOT arithmetic output matches interpreter");
    }

    testNumberLiteralArithmetic() {
        string code = "%modern
number result_add = 3.14159n + 2.71828n;
number result_sub = 3.14159n - 2.71828n;
number result_mul = 3.14159n * 2.71828n;
number result_div = 3.14159n / 2.71828n;
printf(\"%n\\n\", result_add);
printf(\"%n\\n\", result_sub);
printf(\"%n\\n\", result_mul);
printf(\"%n\\n\", result_div);
";
        string aot_out = compileAndRun(code);
        string interp_out = runInterpreted(code);
        assertEq(interp_out, aot_out, "AOT number literal arithmetic output matches interpreter");
    }

    testPhase53FastPaths() {
        string code = "%modern
# Test Phase 5.3 fast-path builtin functions
# These use optimized fast-call paths when called from JIT/AOT code
int result1 = length(\"hello world\");
printf(\"length: %d\\n\", result1);

string upper = toupper(\"hello world\");
printf(\"upper: %s\\n\", upper);

string lower = tolower(\"HELLO WORLD\");
printf(\"lower: %s\\n\", lower);

int len = strlen(\"test string\");
printf(\"strlen: %d\\n\", len);

# Verify pseudo-method size works
list l = (1, 2, 3, 4, 5);
printf(\"list size: %d\\n\", l.size());

hash h = (\"a\": 1, \"b\": 2, \"c\": 3);
printf(\"hash size: %d\\n\", h.size());
";
        string aot_out = compileAndRun(code);
        string interp_out = runInterpreted(code);
        assertEq(interp_out, aot_out, "AOT Phase 5.3 fast-path functions output matches interpreter");
    }

    testControlFlow() {
        string code = "%modern
int x = 42;
if (x > 40) {
    printf(\"big\\n\");
} else {
    printf(\"small\\n\");
}

int count = 0;
while (count < 5) {
    ++count;
}
printf(\"count: %d\\n\", count);

int total = 0;
int i = 0;
do {
    total += i;
    ++i;
} while (i < 5);
printf(\"total: %d\\n\", total);

switch (x) {
    case 42:
        printf(\"matched\\n\");
        break;
    default:
        printf(\"no match\\n\");
        break;
}
";
        string aot_out = compileAndRun(code);
        string interp_out = runInterpreted(code);
        assertEq(interp_out, aot_out, "AOT control flow output matches interpreter");
    }

    testFunctions() {
        string code = "%modern
int sub factorial(int n) {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

int sub fibonacci(int n) {
    if (n <= 1) {
        return n;
    }
    return fibonacci(n - 1) + fibonacci(n - 2);
}

printf(\"fact(10): %d\\n\", factorial(10));
printf(\"fib(10): %d\\n\", fibonacci(10));
";
        string aot_out = compileAndRun(code);
        string interp_out = runInterpreted(code);
        assertEq(interp_out, aot_out, "AOT function output matches interpreter");
    }

    testStringOps() {
        string code = "%modern
string s = \"Hello\";
s += \", World!\";
printf(\"%s\\n\", s);
printf(\"len: %d\\n\", s.size());
printf(\"upper: %s\\n\", s.upr());
printf(\"lower: %s\\n\", s.lwr());
";
        string aot_out = compileAndRun(code);
        string interp_out = runInterpreted(code);
        assertEq(interp_out, aot_out, "AOT string ops output matches interpreter");
    }

    testSwitchRegex() {
        string code = "%modern
string s = \"test123\";
switch (s) {
    case /^test\\d+$/:
        printf(\"matched pattern\\n\");
        break;
    case /^[a-z]+$/:
        printf(\"matched letters\\n\");
        break;
    default:
        printf(\"no match\\n\");
        break;
}
";
        string aot_out = compileAndRun(code);
        string interp_out = runInterpreted(code);
        assertEq(interp_out, aot_out, "AOT regex switch output matches interpreter");
    }

    testExitCode() {
        # AOT binary should return 0 on success
        hash<auto> paths = writeTempScript("%modern\nprintf(\"ok\\n\");\n");
        on_exit {
            unlink(paths.src);
            unlink(paths.out);
        }

        string compile_cmd = sprintf("QORE_LIBDIR=%s %s -b --compile %s --output %s 2>&1",
            libqore_dir, qore_bin, paths.src, paths.out);
        backquote(compile_cmd);

        assertTrue(is_file(paths.out), "AOT executable was created");
        int rc = system(sprintf("LD_LIBRARY_PATH=%s %s -b > /dev/null 2>&1", libqore_dir, paths.out));
        assertEq(0, rc, "AOT binary exits with code 0");
    }

    testArgvPassthrough() {
        string code = "%modern
list<auto> args = ARGV;
for (int i = 0; i < args.size(); ++i) {
    printf(\"arg%d: %s\\n\", i, args[i]);
}
";
        list<string> args = ("foo", "bar", "baz");
        string aot_out = compileAndRun(code, args);
        string interp_out = runInterpreted(code, args);
        assertEq(interp_out, aot_out, "AOT ARGV passthrough matches interpreter");
    }

    testErrorHandling() {
        string code = "%modern
try {
    throw \"TEST-ERROR\", \"test message\";
} catch (hash<ExceptionInfo> ex) {
    printf(\"caught: %s: %s\\n\", ex.err, ex.desc);
}
";
        string aot_out = compileAndRun(code);
        string interp_out = runInterpreted(code);
        assertEq(interp_out, aot_out, "AOT error handling matches interpreter");
    }

    testExceptionStopsMethodExecution() {
        string code = "%modern
class P {
    getFuture() {
        printf(\"unexpected future\\n\");
    }
}

class C {
    fail() {
        throw \"EXPECTED\", \"stop\";
    }

    run() {
        fail();
        P p();
        p.getFuture();
    }
}

C c();
c.run();
";
        string aot_out = compileAndRun(code);
        assertTrue(aot_out.regex("EXPECTED: stop"), "AOT preserves the original exception: " + aot_out);
        assertFalse(aot_out.regex("chained exception"), "AOT stops execution after exception: " + aot_out);
        assertFalse(aot_out.regex("PSEUDO-METHOD-DOES-NOT-EXIST"),
            "AOT does not run post-exception pseudo-method call: " + aot_out);
    }

    testCompileMissingFile() {
        # Compiling a non-existent file should fail
        string cmd = sprintf("QORE_LIBDIR=%s %s -b --compile /tmp/nonexistent_file_12345.q --output /tmp/nonexistent_out 2>&1",
            libqore_dir, qore_bin);
        string out = backquote(cmd);
        assertTrue(out.size() > 0, "error message for missing source file");
    }

    testCompileDefaultOutput() {
        # Test that --output can be omitted (default output name derived from source)
        hash<auto> paths = writeTempScript("%modern\nprintf(\"default\\n\");\n");
        on_exit {
            unlink(paths.src);
            unlink(paths.out);
        }

        # Compile without --output
        string compile_cmd = sprintf("QORE_LIBDIR=%s %s -b --compile %s 2>&1",
            libqore_dir, qore_bin, paths.src);
        backquote(compile_cmd);

        assertTrue(is_file(paths.out), "AOT default output file was created");
        string out = backquote(sprintf("LD_LIBRARY_PATH=%s %s -b 2>&1", libqore_dir, paths.out));
        assertEq("default\n", out, "default output binary runs correctly");
    }

    # ---- Phase 7b: Pointer Indirection Tests ----

    testAllFunctionsPrecompiled() {
        # Verify that ALL functions (including _toplevel) are pre-compiled with pointer indirection
        string code = "%modern
int sub add(int a, int b) {
    return a + b;
}

int sub multiply(int a, int b) {
    return a * b;
}

string sub greet(string name) {
    return \"Hello, \" + name + \"!\";
}

printf(\"%d\\n\", add(3, 4));
printf(\"%d\\n\", multiply(5, 6));
printf(\"%s\\n\", greet(\"World\"));
";
        hash<auto> result = compileCheckAndRun(code);
        assertTrue(result.all_precompiled, "all functions pre-compiled: " + result.compile_out);
        string interp_out = runInterpreted(code);
        assertEq(interp_out, result.run_out, "multi-function AOT output matches interpreter");
    }

    testLocalVariableScoping() {
        # Test local variable assignment, reassignment, and scoping
        string code = "%modern
int x = 10;
printf(\"x=%d\\n\", x);
x = 20;
printf(\"x=%d\\n\", x);

{
    int y = 30;
    printf(\"y=%d\\n\", y);
    x = x + y;
}
printf(\"x=%d\\n\", x);

# Test multiple locals in a function
int sub compute(int a, int b, int c) {
    int temp1 = a + b;
    int temp2 = temp1 * c;
    int result = temp2 - a;
    return result;
}
printf(\"result=%d\\n\", compute(3, 4, 5));
";
        hash<auto> result = compileCheckAndRun(code);
        assertTrue(result.all_precompiled, "local scoping: all pre-compiled: " + result.compile_out);
        string interp_out = runInterpreted(code);
        assertEq(interp_out, result.run_out, "local variable scoping output matches interpreter");
    }

    testNestedDuplicateLocalNames() {
        # Test that nested scopes with duplicate variable names (e.g., 'x' in nested blocks,
        # 'tmp' in if/else branches) resolve correctly under AOT — previously caused assertion
        # failures due to name collisions in stmt_local_map overwriting earlier LocalVar* pointers
        string code = "%modern
int sub nested_blocks() {
    int result = 0;
    {
        int x = 10;
        result += x;
    }
    {
        int x = 20;
        result += x;
    }
    {
        int x = 30;
        result += x;
    }
    return result;
}

int sub nested_if_scopes(int val) {
    int r = 0;
    if (val > 0) {
        int tmp = val * 2;
        r += tmp;
    } else {
        int tmp = val * 3;
        r += tmp;
    }
    return r;
}

int sub deeply_nested() {
    int sum = 0;
    for (int i = 0; i < 3; ++i) {
        {
            int v = i * 10;
            sum += v;
        }
        {
            int v = i * 100;
            sum += v;
        }
    }
    return sum;
}

printf(\"%d\\n\", nested_blocks());
printf(\"%d\\n\", nested_if_scopes(5));
printf(\"%d\\n\", nested_if_scopes(-3));
printf(\"%d\\n\", deeply_nested());
";
        hash<auto> result = compileCheckAndRun(code);
        assertTrue(result.all_precompiled, "nested dup names: all pre-compiled: " + result.compile_out);
        string interp_out = runInterpreted(code);
        assertEq(interp_out, result.run_out, "nested duplicate local names output matches interpreter");
    }

    testLvalueOps() {
        # Test pre-increment/decrement and compound assignment
        # NOTE: post-increment (a++) on typed int vars uses QoreIntPostIncrementOperatorNode
        # which is not yet handled by IR lowering; pre-increment (++a) works via
        # QorePreIncrementOperatorNode
        string code = "%modern
int a = 10;
++a;
printf(\"++a: %d\\n\", a);
--a;
printf(\"--a: %d\\n\", a);

# Compound assignment operators
int b = 100;
b += 10;
printf(\"b+=10: %d\\n\", b);
b -= 30;
printf(\"b-=30: %d\\n\", b);
b *= 2;
printf(\"b*=2: %d\\n\", b);
b /= 4;
printf(\"b/=4: %d\\n\", b);
b %= 7;
printf(\"b%%=7: %d\\n\", b);
";
        hash<auto> result = compileCheckAndRun(code);
        assertTrue(result.all_precompiled, "lvalue ops: all pre-compiled: " + result.compile_out);
        string interp_out = runInterpreted(code);
        assertEq(interp_out, result.run_out, "lvalue operations output matches interpreter");
    }

    testMultipleUserFunctions() {
