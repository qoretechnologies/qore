# int to string
int n = 42;
string s = sprintf(\"%d\", n);
printf(\"str: %s\\n\", s);

# string to int
string num_str = \"123\";
int parsed = int(num_str);
printf(\"int: %d\\n\", parsed);

# float to int
float f = 3.7;
int truncated = int(f);
printf(\"trunc: %d\\n\", truncated);

# bool
