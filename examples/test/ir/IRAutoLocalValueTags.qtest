%modern
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil
%exec-class AutoLocalValueTagsTest

class AutoLocalValueTagsTest inherits QUnit::Test {
    private {
        string qore = realpath(ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0]);
        string libdir = realpath(ENV.QORE_LIBDIR ?? dirname(qore));
        string qcc = ENV.QCC ?? libdir + "/qcc";
    }
    constructor() : Test("untyped local value representations", "1.0", \ARGV) {
        addTestCase("untyped loads preserve values, references and lifetimes", \check());
        set_return_value(main());
    }
    private static string quote(string value) {
        return "'" + replace(value, "'", "'\"'\"'") + "'";
    }
    private string run(list<string> args, string prefix = "") {
        int status;
        string output = backquote(prefix + "LD_LIBRARY_PATH=" + quote(libdir)
            + " DYLD_LIBRARY_PATH=" + quote(libdir)
            + " QORE_JIT_SYNC_COMPILE=1 QORE_IR_THRESHOLD=1 QORE_JIT_THRESHOLD=1 "
            + (map quote($1), args).join(" ") + " 2>&1", \status);
        assertEq(0, status, output);
        return output;
    }
    private check() {
        string source = get_script_dir() + "/IRAutoLocalValueTags.qr";
        string expected = "auto-local-value-tags: ok\n";
        foreach string mode in (("ast", "ir", "jit", "tiered")) {
            assertEq(expected, run((qore, "--exec-mode=" + mode, source)), mode);
        }
        # Baseline IR/tiered cannot store the iterator's raw reference in an
        # IR-only auto local (LVALUE-ERROR); the parameter form above works.
        # Keep local-form coverage in the modes that support it.
        foreach string mode in (("ast", "jit")) {
            assertEq(expected, run((qore, "--exec-mode=" + mode, source, "raw-local")), mode);
        }
        TmpDir dir("qore-auto-local-value-tags-");
        foreach string prefix in (("", "QORE_AOT_EH=1 ", "QORE_AOT_NO_DEBUG_INFO=1 ",
                "QORE_DISABLE_AOT_STABLE_UNTYPED_LOAD=1 ",
                "MAKEFLAGS= QCC_JOBS=4 QCC_SPLIT_THRESHOLD=1 ")) {
            foreach string level in (("-O0", "-O3")) {
                string executable = dir.path + "/fixture";
                string ir = run((qcc, level, "--strip-source", "-o", executable, source),
                    prefix + "QORE_DUMP_LLVM_IR=1 ");
                foreach string name in (("readUntyped", "readIteratorLocal", "callUntyped")) {
                    *list<*string> body = regex_extract(ir,
                        "(?s)define [^\n]*@" + name
                            + "_[^\n]*\\(ptr %ctx, ptr %xsink\\)[^\n]*\n(.*?)\n\\}");
                    assertTrue(!!body, name + " normal LLVM entry");
                    bool stable = name == "readUntyped" && !prefix.startsWith("QORE_DISABLE_");
                    assertEq(stable, regex(body[0] ?? "", "call i8 @qore_rt_deref_stable_local_v2"),
                        name + " caches only repeated stable parameter reads");
                    # Writable body locals and read-once parameters keep the ordinary helper.
                    assertRegex("call i64 @qore_rt_deref_if_reference", body[0] ?? "",
                        name + " retains ordinary body-local / read-once handling");
                }
                foreach string runtime in (("", "QORE_DISABLE_IR_CONTEXT_ELISION=1 ",
                        "QORE_DISABLE_FUNCREF_FAST_CALL=1 ", "QORE_DISABLE_AOT_NATIVE_METHOD_ENTRY=1 ")) {
                    assertEq(expected, run((executable,), runtime), prefix + level + runtime);
                    assertEq(expected, run((executable, "raw-local"), runtime), prefix + level + runtime);
                }
            }
        }
    }
}
