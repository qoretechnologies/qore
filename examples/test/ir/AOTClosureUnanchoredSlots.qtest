#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (c) 2026 Qore Technologies, s.r.o.
# SPDX-License-Identifier: MIT

/*  The runtime binds the local slots of a closure's native AOT body to the variables of the closure's serialized IR
    by slot index, so both must number their slots alike.  Lowering numbers local slots in block order, and the local
    unwind anchors of a block change that order: an anchored block splits at every call into an invoke continuation
    block placed after the block's siblings.  The native body is lowered again without anchors when its locals are
    released in reverse declaration order without them; the serialized IR was always lowered with them.

    In the closure below, the anchored lowering numbers "stmt" (read in the else branch) before "sql" (read after the
    "ds" member call of the then branch), and the unanchored native body numbers them the other way round: the native
    body read "stmt" as "sql" and "sql" as "stmt", as PgsqlTable::getBulkUpdateClosure() did in the AOT-compiled
    PgsqlSqlUtilBase module.
*/

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil

%exec-class AOTClosureUnanchoredSlotsTest

class AOTClosureUnanchoredSlotsTest inherits QUnit::Test {
    public {
        const ModuleName = "AOTClosureUnanchoredSlotsMod";

        const Classes = "class CcExec {
    string vexec(string sql, list<auto> args) {
        return \"direct \" + sql + \":\" + (foldl $1 + \",\" + $2, args);
    }
}

class CcStmt {
    private {
        string sql;
    }

    prepare(string n_sql) {
        sql = n_sql;
    }

    string execArgs(list<auto> args) {
        return \"stmt \" + sql + \":\" + (foldl $1 + \",\" + $2, args);
    }
}

class CcTable {
    private {
        CcExec ds();
    }

    code<string(hash<auto>)> getClosure(hash<auto> example, bool use_direct_exec) {
        string sql = \"update \" + (foldl $1 + \",\" + $2, keys example);
        *CcStmt stmt;
        if (!use_direct_exec) {
            stmt = new CcStmt();
            stmt.prepare(sql);
        }
        list<string> set_keys = keys example;
        return string sub (hash<auto> data) {
            hash<auto> combined;
            map (combined{$1} = data{$1}), set_keys;
            list<auto> args = combined.values();
            string rv;
            if (use_direct_exec) {
                rv = ds.vexec(sql, args);
            } else {
                rv = stmt.execArgs(args);
            }
            return rv;
        };
    }
}
";

        const Main = "CcTable t();
printf(\"%s\\n\", t.getClosure({\"a\": 1, \"b\": 2}, True)({\"a\": 1, \"b\": \"x\"}));
printf(\"%s\\n\", t.getClosure({\"a\": 1, \"b\": 2}, False)({\"a\": 1, \"b\": \"x\"}));
printf(\"%s\\n\", t.getClosure({\"c\": 3}, False)({\"c\": True}));
";

        const Expected = "direct update a,b:1,x\nstmt update a,b:1,x\nstmt update c:1\n";
    }

    private {
        string qore_bin;
        string qcc_bin;
        string libqore_dir;
    }

    constructor() : QUnit::Test("AOTClosureUnanchoredSlotsTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
            ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");

        addTestCase("AOT closure slots in an executable match AST", \testExecutable());
        addTestCase("AOT closure slots in a module match AST", \testModule());

        set_return_value(main());
    }

    private static string quote(string value) {
        return "'" + replace(value, "'", "'\"'\"'") + "'";
    }

    private string env(*string module_dir) {
        string rv = sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s QORE_LIBDIR=%s ", quote(libqore_dir),
            quote(libqore_dir), quote(libqore_dir));
        if (module_dir) {
            rv += "QORE_MODULE_DIR=" + quote(module_dir + (ENV.QORE_MODULE_DIR ? ":" + ENV.QORE_MODULE_DIR : ""))
                + " ";
        }
        return rv;
    }

    private string run(string cmd, reference<int> status) {
        return backquote(cmd + " 2>&1", \status);
    }

    private static write(string path, string body) {
        File f();
        f.open2(path, O_WRONLY | O_CREAT | O_TRUNC, 0644);
        f.write(body);
    }

    private string moduleSource() {
        return sprintf("%%modern\nmodule %s {\n    version = \"1.0\";\n    desc = \"AOT closure slot regression\";\n"
            "    author = \"Qore Technologies, s.r.o.\";\n    url = \"https://qore.org\";\n    license = \"MIT\";\n}\n\n",
            ModuleName) + regex_subst(Classes, "^class ", "public class ", RE_MultiLine | RE_Global);
    }

    testExecutable() {
        TmpDir tmp("qore-aot-closure-unanchored-slots-exe-");
        foreach string directive in (("", "%no-debugging\n")) {
            string src = tmp.path + "/prog" + $# + ".qr";
            write(src, "%modern\n" + directive + Classes + Main);
            int status;
            string ast_out = run(env() + quote(qore_bin) + " --exec-mode=ast " + quote(src), \status);
            assertEq(0, status, ast_out);
            assertEq(Expected, ast_out, "AST baseline " + directive);

            foreach string level in (("-O0", "-O3")) {
                string exe = tmp.path + "/prog" + $# + level;
                string compile_out = run(env() + quote(qcc_bin) + " " + level + " -o " + quote(exe) + " "
                    + quote(src), \status);
                assertEq(0, status, compile_out);
                assertTrue(is_file(exe), "executable compiled: " + compile_out);
                string out = run(env() + quote(exe), \status);
                assertEq(0, status, out);
                assertEq(ast_out, out, sprintf("AOT executable %s %s", level, directive));
            }
        }
    }

    testModule() {
        TmpDir tmp("qore-aot-closure-unanchored-slots-mod-");
        string src_dir = tmp.path + "/src";
        mkdir(src_dir);
        write(src_dir + "/" + ModuleName + ".qm", moduleSource());
        string probe = tmp.path + "/probe.qr";
        write(probe, sprintf("%%modern\n%%requires %s\n", ModuleName) + Main);

        int status;
        string ast_out = run(env(src_dir) + quote(qore_bin) + " --exec-mode=ast " + quote(probe), \status);
        assertEq(0, status, ast_out);
        assertEq(Expected, ast_out, "AST baseline");

        foreach string level in (("-O0", "-O3")) {
            string mod_dir = tmp.path + "/qmod" + level;
            mkdir(mod_dir);
            string qmod = mod_dir + "/" + ModuleName + ".qmod";
            string compile_out = run(env(src_dir) + quote(qcc_bin) + " " + level + " --module -o " + quote(qmod)
                + " " + quote(src_dir + "/" + ModuleName + ".qm"), \status);
            assertEq(0, status, compile_out);
            assertTrue(is_file(qmod), "module compiled: " + compile_out);
            # only the AOT image can satisfy the module requirement
            string out = run(env(mod_dir) + quote(qore_bin) + " " + quote(probe), \status);
            assertEq(0, status, out);
            assertEq(ast_out, out, "AOT module " + level);
        }
    }
}
