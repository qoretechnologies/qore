#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

# Copyright (C) 2003 - 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%requires QUnit
%requires ../../../qlib/FsUtil.qm

%exec-class Phase4bSmokeTest

class Phase4bSmokeTest inherits QUnit::Test {
    private {
        string qore_bin;
    }

    constructor() : QUnit::Test("Phase4bSmokeTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? QORE_ARGV[0] ?? "qore";
        # Type profiling tests
        addTestCase("type profiling int correctness", \testTypeProfilingInt());
        addTestCase("type profiling float correctness", \testTypeProfilingFloat());
        addTestCase("type profiling mixed types", \testTypeProfilingMixed());
        addTestCase("type profiling guard promotion", \testTypeProfilingGuardPromotion());
        # Profile-informed JIT guard tests
        addTestCase("profiled guard int fast-path", \testProfiledGuardIntFastPath());
        addTestCase("profiled guard float fast-path", \testProfiledGuardFloatFastPath());
        addTestCase("profiled guard not-nothing fast-path", \testProfiledGuardNotNothingFastPath());
        # Deopt and correctness tests
        addTestCase("deopt mixed type correctness", \testDeoptMixedTypeCorrectness());
        addTestCase("deopt type change mid-execution", \testDeoptTypeChangeMidExecution());
        addTestCase("profiled tiered promotion correctness", \testProfiledTieredPromotionCorrectness());
        # Deopt-triggered recompilation tests
        addTestCase("deopt recompilation correctness", \testDeoptRecompilationCorrectness());
        addTestCase("deopt heavy type change", \testDeoptHeavyTypeChange());
        # OSR (loop-aware JIT promotion) tests
        addTestCase("OSR while loop promotion", \testOSRWhileLoopPromotion());
        addTestCase("OSR for loop promotion", \testOSRForLoopPromotion());
        addTestCase("OSR nested loops", \testOSRNestedLoops());
        addTestCase("OSR cross-mode correctness", \testOSRCrossModeCorrectness());
        set_return_value(main());
    }

    private string runScript(string code, *string exec_mode, *string extra_opts) {
        string mode = exec_mode ?? "tiered";
        TmpFile tmp(".q");
        tmp.file.write(code);
        tmp.file.close();
        string path = tmp.path;
        string cmd = sprintf("%s --enable-debug --exec-mode=%s %s %s 2>&1",
            qore_bin, mode, extra_opts ?? "", path);
        return backquote(cmd);
    }

    # --- Type profiling basic tests ---

    testTypeProfilingInt() {
        # Function called many times with int args in tiered mode.
        # Type profiles should accumulate int counts; result must be correct.
        string code = "%modern
auto sub add_any(auto a, auto b) {
    return a + b;
}
int total = 0;
for (int i = 0; i < 200; i++) {
    total += add_any(i, 1);
}
printf(\"%d\\n\", total);
";
        # Tiered mode with low thresholds to trigger IR and JIT quickly
        string result = trim(runScript(code, "tiered", "--jit-ir-threshold=10 --jit-jit-threshold=50"));
        assertEq("20100", result, "type profiling int: sum correct after tiered promotion");
    }

    testTypeProfilingFloat() {
        # Function called many times with float args.
        string code = "%modern
auto sub mul_any(auto a, auto b) {
    return a * b;
}
float total = 0.0;
for (int i = 0; i < 200; i++) {
    total += mul_any(2.5, float(i));
}
printf(\"%.1f\\n\", total);
";
        string result = trim(runScript(code, "tiered", "--jit-ir-threshold=10 --jit-jit-threshold=50"));
        assertEq("49750.0", result, "type profiling float: product sum correct");
    }

    testTypeProfilingMixed() {
        # Function called with mixed types: ints first, then floats, then strings.
        # No single type should dominate, so guards remain generic.
        string code = "%modern
auto sub identity(auto v) {
    return v;
}
list results = ();
# Call with ints
for (int i = 0; i < 100; i++) {
    push results, identity(i);
}
# Call with floats
for (int i = 0; i < 100; i++) {
    push results, identity(float(i));
}
# Call with strings
for (int i = 0; i < 100; i++) {
    push results, identity(string(i));
}
printf(\"%d %s %s\\n\", results[0], string(results[100]), results[200]);
";
        string result = trim(runScript(code, "tiered", "--jit-ir-threshold=10 --jit-jit-threshold=50"));
        assertEq("0 0.0 0", result, "type profiling mixed: correct results for mixed types");
    }

    testTypeProfilingGuardPromotion() {
        # Verify that a function with typed int params runs correctly through
        # all three tiers (AST → IR with profiling → JIT with profiled guards).
        string code = "%modern
int sub square(int n) {
    return n * n;
}
int total = 0;
for (int i = 0; i < 500; i++) {
    total += square(i);
}
printf(\"%d\\n\", total);
";
        string result = trim(runScript(code, "tiered", "--jit-ir-threshold=5 --jit-jit-threshold=100"));
        # Sum of i^2 from 0 to 499 = 499*500*999/6 = 41541750
        assertEq("41541750", result, "type profiling guard promotion: sum of squares correct");
    }

    # --- Profile-informed guard fast-path tests ---

    testProfiledGuardIntFastPath() {
        # Test that functions consistently called with ints produce correct results
        # when JIT uses profiled inline guard checks.
        # Compare IR vs tiered to ensure profile-informed JIT matches.
        string code = "%modern
int sub fib(int n) {
    if (n <= 1) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}
printf(\"%d\\n\", fib(20));
";
        string ir_result = trim(runScript(code, "ir"));
        string tiered_result = trim(runScript(code, "tiered", "--jit-ir-threshold=5 --jit-jit-threshold=20"));
        assertEq("6765", ir_result, "profiled guard int: IR fib(20) correct");
        assertEq(ir_result, tiered_result,
            "profiled guard int: tiered (with profiled JIT) matches IR");
    }

    testProfiledGuardFloatFastPath() {
        # Function consistently called with floats; verify profile-informed float guards.
        string code = "%modern
float sub area(float r) {
    return 3.14159265 * r * r;
}
float total = 0.0;
for (int i = 0; i < 300; i++) {
    total += area(float(i));
}
printf(\"%.2f\\n\", total);
";
        string ir_result = trim(runScript(code, "ir"));
        string tiered_result = trim(runScript(code, "tiered", "--jit-ir-threshold=10 --jit-jit-threshold=50"));
        assertEq(ir_result, tiered_result,
            "profiled guard float: tiered matches IR for float-heavy function");
    }

    testProfiledGuardNotNothingFastPath() {
        # Function with 'auto' params that are never NOTHING; profile should
        # show never-NOTHING and enable inline guard.
        string code = "%modern
auto sub process(auto val) {
    if (val.typeCode() == NT_INT) {
        return val * 2;
    }
    return val;
}
int total = 0;
for (int i = 0; i < 300; i++) {
    total += process(i);
}
printf(\"%d\\n\", total);
";
        string ir_result = trim(runScript(code, "ir"));
        string tiered_result = trim(runScript(code, "tiered", "--jit-ir-threshold=10 --jit-jit-threshold=50"));
        assertEq(ir_result, tiered_result,
            "profiled guard not-nothing: tiered matches IR for non-nothing args");
    }

    # --- Deopt and type change tests ---

    testDeoptMixedTypeCorrectness() {
        # Function JIT'd with int profile, then called with different types.
        # The guard should fail and the deopt path should produce correct results.
        string code = "%modern
auto sub double_it(auto v) {
    return v + v;
}
# Warm up with ints to build profile and trigger JIT
list results = ();
for (int i = 0; i < 200; i++) {
    push results, double_it(i);
}
# Now call with float — guard may fail but result must be correct
push results, double_it(3.14);
# Call with string
push results, double_it(\"hello\");
printf(\"%d %.2f %s\\n\", results[5], results[200], results[201]);
";
        string result = trim(runScript(code, "tiered", "--jit-ir-threshold=10 --jit-jit-threshold=50"));
        assertEq("10 6.28 hellohello", result,
            "deopt mixed types: correct results after type change");
    }

    testDeoptTypeChangeMidExecution() {
        # Function that receives ints for many calls, then floats, then strings.
        # Each type change may trigger guard failures; results must remain correct.
        string code = "%modern
auto sub negate(auto v) {
    return -v;
}
list results = ();
# Phase 1: ints (build profile, trigger JIT)
for (int i = 1; i <= 200; i++) {
    push results, negate(i);
}
# Phase 2: floats (guard may fail for first float call)
for (int i = 1; i <= 50; i++) {
    push results, negate(float(i) + 0.5);
}
printf(\"%d %.1f\\n\", results[0], results[200]);
";
        string result = trim(runScript(code, "tiered", "--jit-ir-threshold=10 --jit-jit-threshold=50"));
        assertEq("-1 -1.5", result,
            "deopt type change: correct results across int→float transition");
    }

    testProfiledTieredPromotionCorrectness() {
        # Comprehensive test: function goes through AST → IR (with profiling) → JIT
        # across all three tiers, with results verified at each stage.
        string code = "%modern
int sub collatz_steps(int n) {
    int steps = 0;
    while (n != 1) {
        if (n % 2 == 0) {
            n = n / 2;
        } else {
            n = 3 * n + 1;
        }
        steps++;
    }
    return steps;
}
# Call many times to go through all tiers
int total = 0;
for (int i = 1; i <= 300; i++) {
    total += collatz_steps(i);
}
printf(\"%d\\n\", total);
";
        # Run in all modes and compare
        string ast_result = trim(runScript(code, "ast"));
        string ir_result = trim(runScript(code, "ir"));
        string tiered_result = trim(runScript(code, "tiered", "--jit-ir-threshold=5 --jit-jit-threshold=50"));
        assertEq(ast_result, ir_result,
            "profiled tiered promotion: IR matches AST");
        assertEq(ast_result, tiered_result,
            "profiled tiered promotion: tiered (profiled JIT) matches AST");
        # Verify the result is non-trivial (Collatz sequence)
        assertTrue(ast_result.toInt() > 0,
            "profiled tiered promotion: Collatz total is positive");
    }

    # --- Deopt-triggered recompilation tests ---

    testDeoptRecompilationCorrectness() {
        # Function initially JIT'd with int profile. Then called many times with
        # floats, triggering enough deopts (>= 10) to potentially trigger recompilation.
        # The result must be correct regardless of whether recompilation happens.
        string code = "%modern
auto sub compute(auto x) {
    return x * 2 + 1;
}
# Phase 1: warm up with ints → IR → JIT with int profile
int int_total = 0;
for (int i = 0; i < 200; i++) {
    int_total += compute(i);
}
# Phase 2: call many times with floats → triggers deopt counter
float float_total = 0.0;
for (int i = 0; i < 100; i++) {
    float_total += compute(float(i));
}
printf(\"%d %.1f\\n\", int_total, float_total);
";
        string result = trim(runScript(code, "tiered", "--jit-ir-threshold=10 --jit-jit-threshold=50"));
        # int_total = sum(i*2+1, i=0..199) = 2*(199*200/2)+200 = 40000
        assertEq("40000 10000.0", result,
            "deopt recompilation: correct results after many type-changing calls");
    }

    testDeoptHeavyTypeChange() {
        # Alternating types: int, float, int, float, ... to stress deopt tracking.
        # The function must produce correct results for all types throughout.
        string code = "%modern
auto sub add_one(auto v) {
    return v + 1;
}
# Warm up with ints
for (int i = 0; i < 200; i++) {
    add_one(i);
}
# Now alternate types rapidly
list results = ();
for (int i = 0; i < 50; i++) {
    push results, add_one(i);
    push results, add_one(float(i) + 0.5);
}
printf(\"%d %.1f %d %.1f\\n\", results[0], results[1], results[98], results[99]);
";
        string result = trim(runScript(code, "tiered", "--jit-ir-threshold=10 --jit-jit-threshold=50"));
        assertEq("1 1.5 50 50.5", result,
            "deopt heavy type change: correct alternating type results");
    }

    # --- OSR (loop-aware JIT promotion) tests ---

    testOSRWhileLoopPromotion() {
        # Function with a hot while loop. The loop should trigger OSR-based
        # JIT promotion even with a low IR threshold and high JIT threshold,
        # because loop iterations exceed the JIT threshold.
        string code = "%modern
int sub sum_while(int n) {
    int total = 0;
    int i = 0;
    while (i < n) {
        total += i;
        i++;
    }
    return total;
}
# Call once with a large loop count — OSR should trigger JIT promotion
# even though exec_count is only 1 (below normal JIT threshold of 5000)
printf(\"%d\\n\", sum_while(2000));
";
        # IR threshold=1 (promote to IR immediately), JIT threshold=5000 (high)
        # OSR should trigger because the while loop iterates 2000 times > threshold
        string ir_result = trim(runScript(code, "ir"));
        string tiered_result = trim(runScript(code, "tiered",
            "--jit-ir-threshold=1 --jit-jit-threshold=5000"));
        assertEq("1999000", ir_result, "OSR while: IR result correct");
        assertEq(ir_result, tiered_result,
            "OSR while: tiered (with OSR) matches IR");
    }

    testOSRForLoopPromotion() {
        # Function with a hot for loop — same OSR principle.
        string code = "%modern
int sub factorial_sum(int n) {
    int total = 0;
    for (int i = 1; i <= n; i++) {
        total += i * i;
    }
    return total;
}
printf(\"%d\\n\", factorial_sum(3000));
";
        string ir_result = trim(runScript(code, "ir"));
        string tiered_result = trim(runScript(code, "tiered",
            "--jit-ir-threshold=1 --jit-jit-threshold=5000"));
        assertEq(ir_result, tiered_result,
            "OSR for: tiered (with OSR) matches IR for sum of squares");
    }

    testOSRNestedLoops() {
        # Function with nested loops — inner loop should trigger OSR.
        string code = "%modern
int sub matrix_sum(int rows, int cols) {
    int total = 0;
    for (int i = 0; i < rows; i++) {
        for (int j = 0; j < cols; j++) {
            total += i * cols + j;
        }
    }
    return total;
}
printf(\"%d\\n\", matrix_sum(50, 100));
";
        string ir_result = trim(runScript(code, "ir"));
        string tiered_result = trim(runScript(code, "tiered",
            "--jit-ir-threshold=1 --jit-jit-threshold=5000"));
        assertEq(ir_result, tiered_result,
            "OSR nested: tiered matches IR for nested loop computation");
    }

    testOSRCrossModeCorrectness() {
        # Verify that OSR-promoted functions produce identical results across
        # all execution modes for a non-trivial computation.
        string code = "%modern
int sub sieve_count(int limit) {
    int count = 0;
    for (int i = 2; i < limit; i++) {
        bool is_prime = True;
        for (int j = 2; j * j <= i; j++) {
            if (i % j == 0) {
                is_prime = False;
                break;
            }
        }
        if (is_prime) {
            count++;
        }
    }
    return count;
}
printf(\"%d\\n\", sieve_count(500));
";
        string ast_result = trim(runScript(code, "ast"));
        string ir_result = trim(runScript(code, "ir"));
        string tiered_result = trim(runScript(code, "tiered",
            "--jit-ir-threshold=1 --jit-jit-threshold=5000"));
        assertEq(ast_result, ir_result, "OSR cross-mode: IR matches AST");
        assertEq(ast_result, tiered_result,
            "OSR cross-mode: tiered (with OSR) matches AST");
        # primes below 500 = 95
        assertEq("95", ast_result, "OSR cross-mode: sieve count correct");
    }
}
