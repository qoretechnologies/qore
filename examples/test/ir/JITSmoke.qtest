    testLValueCompoundAssignString() {
        # Test string concat via slow path (non-int/float)
        string code = "%modern
auto a = \"hello\";
a += \" world\";  # slow path: string concat
auto b = \"foo\";
b += \"bar\";
printf(\"%s,%s\\n\", a, b);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("hello world,foobar", result,
