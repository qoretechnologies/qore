#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

%requires QUnit
%requires ../../../qlib/FsUtil.qm

%exec-class JITSmokeTest

class JITSmokeTest inherits QUnit::Test {
    private {
        string qore_bin;
    }

    constructor() : QUnit::Test("JITSmokeTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? QORE_ARGV[0] ?? "qore";
        addTestCase("JIT integer arithmetic", \testJitIntArithmetic());
        addTestCase("JIT integer comparisons", \testJitIntComparisons());
        addTestCase("JIT float arithmetic", \testJitFloatArithmetic());
        addTestCase("JIT float comparisons", \testJitFloatComparisons());
        addTestCase("JIT mixed int/float arithmetic", \testJitMixedIntFloatArithmetic());
        addTestCase("JIT mixed int/float comparisons", \testJitMixedIntFloatComparisons());
        addTestCase("JIT boolean operations", \testJitBoolOps());
        addTestCase("JIT control flow", \testJitControlFlow());
        addTestCase("JIT bitwise operations", \testJitBitwiseOps());
        addTestCase("JIT division by zero", \testJitDivisionByZero());
        addTestCase("JIT nested if/else", \testJitNestedIfElse());
        addTestCase("JIT loop computation", \testJitLoopComputation());
        addTestCase("JIT fallback to IR", \testJitFallbackToIr());
        addTestCase("JIT non-modern fallback", \testJitNonModernFallback());
        addTestCase("JIT try/catch exception", \testJitTryCatch());
        addTestCase("JIT float division by zero", \testJitFloatDivByZero());
        addTestCase("JIT modulo by zero", \testJitModuloByZero());
        addTestCase("JIT unary operations", \testJitUnaryOps());
        addTestCase("JIT mixed arithmetic", \testJitMixedArithmetic());
        addTestCase("JIT string operations", \testJitStringOps());
        addTestCase("JIT switch statement", \testJitSwitch());
        addTestCase("JIT while loop", \testJitWhileLoop());
        addTestCase("JIT do-while loop", \testJitDoWhileLoop());
        addTestCase("JIT correctness across modes", \testJitCorrectnessAcrossModes());
        addTestCase("JIT hash construction and access", \testJitHashAccess());
        addTestCase("JIT list construction and access", \testJitListOps());
        addTestCase("JIT string concatenation", \testJitStringConcat());
        addTestCase("JIT dynamic comparison ops", \testJitDynamicComparisons());
        addTestCase("JIT dynamic bitwise ops", \testJitDynamicBitwise());
        addTestCase("JIT dynamic unary ops", \testJitDynamicUnary());
        addTestCase("JIT compound assignment ops", \testJitCompoundAssign());
        addTestCase("JIT compound assign bitwise", \testJitCompoundAssignBitwise());
        addTestCase("JIT compound assign float", \testJitCompoundAssignFloat());
        addTestCase("JIT compound assign any", \testJitCompoundAssignAny());
        addTestCase("JIT compound assign any bitwise", \testJitCompoundAssignAnyBitwise());
        addTestCase("JIT compound assign any NOTHING", \testJitCompoundAssignAnyNothing());
        addTestCase("JIT compound assign loop", \testJitCompoundAssignLoop());
        addTestCase("JIT compound assign overflow", \testJitCompoundAssignOverflow());
        addTestCase("JIT division inline zero-check", \testJitDivisionInlineZeroCheck());
        addTestCase("JIT throw with list args", \testJitThrowList());
        addTestCase("JIT multiple exceptions", \testJitMultipleExceptions());
        addTestCase("JIT scoped object construction", \testJitScopedObjectConstruction());
        # Phase 5b optimization tests
        addTestCase("JIT hash key access fast-path", \testJitHashKeyFastPath());
        addTestCase("JIT list index access fast-path", \testJitListIndexFastPath());
        addTestCase("JIT string concat fast-path", \testJitStringConcatFastPath());
        addTestCase("JIT any arithmetic fast-path", \testJitAnyArithFastPath());
        addTestCase("JIT any comparison fast-path", \testJitAnyCmpFastPath());
        addTestCase("JIT any arithmetic mixed types", \testJitAnyArithMixed());
        addTestCase("JIT Phase 5b cross-mode correctness", \testJitPhase5bCrossMode());
        # Phase 5c debug info tests
        addTestCase("JIT debug info compile", \testJitDebugInfoCompile());
        addTestCase("JIT debug info multi-line", \testJitDebugInfoMultiLine());
        # Double-eval regression tests
        addTestCase("side-effecting args", \testJitSideEffectingArgs());
        addTestCase("tracked side effects", \testJitTrackedSideEffects());
        addTestCase("nested call side effects", \testJitNestedCallSideEffects());
        addTestCase("binary invoke try/catch", \testJitBinaryInvokeTryCatch());
        addTestCase("call cross-mode", \testJitCallCrossMode());
        # Bug fix regression tests
        addTestCase("no-arg function call", \testJitNoArgCall());
        addTestCase("int post-increment", \testJitIntPostIncrement());
        addTestCase("int post-decrement", \testJitIntPostDecrement());
        addTestCase("ternary operator", \testJitTernary());
        # DotEval double-evaluation regression tests
        addTestCase("dot-eval method call single eval", \testJitDotEvalSingleEval());
        addTestCase("dot-eval invoke path single eval", \testJitDotEvalInvokeSingleEval());
        addTestCase("dot-eval chained methods", \testJitDotEvalChained());
        addTestCase("dot-eval hash member access", \testJitDotEvalHashMember());
        # Regex double-evaluation regression tests
        addTestCase("regex match single eval", \testJitRegexMatchSingleEval());
        addTestCase("regex match invoke single eval", \testJitRegexMatchInvokeSingleEval());
        addTestCase("regex extract single eval", \testJitRegexExtractSingleEval());
        addTestCase("regex extract invoke single eval", \testJitRegexExtractInvokeSingleEval());
        # Optimized higher-order function tests
        addTestCase("optimized foldl sum/prod", \testJitFoldlSumProd());
        addTestCase("optimized foldl diff/min/max", \testJitFoldlDiffMinMax());
        addTestCase("optimized map patterns", \testJitMapOptimized());
        addTestCase("optimized select patterns", \testJitSelectOptimized());
        addTestCase("fused map+select patterns", \testJitFusedMapSelect());
        addTestCase("fused map+foldl patterns", \testJitFusedMapFoldl());
        addTestCase("IR foreach lowering", \testIRForeachLowering());
        addTestCase("typed string concatenation", \testTypedStringConcat());
        addTestCase("typed string equality", \testTypedStringEquality());
        addTestCase("string switch optimization", \testStringSwitchOptimization());
        addTestCase("final class devirtualization", \testFinalClassDevirtualization());
        addTestCase("string builder optimization", \testStringBuilderOptimization());
        addTestCase("native map with method call", \testNativeMapWithMethodCall());
        addTestCase("native select with comparison", \testNativeSelectWithComparison());
        addTestCase("native foldl with function call", \testNativeFoldlWithFunctionCall());
        addTestCase("on_block_exit handlers", \testOnBlockExitHandlers());
        addTestCase("on_block_exit top-level local update", \testOnBlockExitTopLevelLocalUpdate());
        addTestCase("invoke method direct", \testInvokeMethodDirect());
        addTestCase("big int loop correctness", \testBigIntLoopCorrectness());
        addTestCase("invoke result in loop", \testInvokeResultInLoop());
        addTestCase("big int boxing inline", \testBigIntBoxingInline());
        addTestCase("lvalue compound assign NOTHING", \testLValueCompoundAssignNothing());
        addTestCase("lvalue compound assign int fast path", \testLValueCompoundAssignInt());
        addTestCase("lvalue compound assign float fast path", \testLValueCompoundAssignFloat());
        addTestCase("lvalue compound assign string slow path", \testLValueCompoundAssignString());
        addTestCase("lvalue compound assign loop", \testLValueCompoundAssignLoop());
        addTestCase("lvalue compound assign bitwise", \testLValueCompoundAssignBitwise());
        addTestCase("lvalue compound assign div/mod slow path", \testLValueCompoundAssignDivMod());
        addTestCase("range lvalue delegate-to-AST", \testRangeLValueDelegate());
        addTestCase("self member access", \testSelfMemberAccess());
        addTestCase("static class variable access", \testStaticClassVarAccess());
        addTestCase("new object instantiation", \testNewObjectInstantiation());
        addTestCase("runtime constants", \testRuntimeConstants());
        addTestCase("closure creation", \testClosureCreation());
        addTestCase("foldr native", \testFoldrNative());
        addTestCase("empty-list fold min/max returns NOTHING", \testEmptyListFoldMinMax());
        addTestCase("map+select fused", \testMapSelectFused());
        addTestCase("hash map native", \testHashMapNative());
        addTestCase("hash map+select native", \testHashMapSelectNative());
        addTestCase("hash map over typed hash list", \testHashMapOverTypedHashList());
        addTestCase("map tuple over typed hash list", \testMapTupleOverTypedHashList());
        addTestCase("typed container construction", \testTypedContainerConstruction());
        addTestCase("call references", \testCallReferences());
        addTestCase("parse references", \testParseReferences());
        addTestCase("reference write-through", \testReferenceWriteThrough());
        addTestCase("NOTHING input to iterators", \testNothingInputIterators());
        addTestCase("VarRefNewObjectNode split", \testVarRefNewObjectSplit());
        addTestCase("VarRefNewObjectNode typed containers", \testVrnTypedContainers());
        addTestCase("direct function call", \testCallDirect());
        addTestCase("function call in loop (stack safety)", \testCallInLoopStackSafety());
        addTestCase("fast function call", \testFastCall());
        addTestCase("fast method call", \testFastMethodCall());
        addTestCase("fast closure/callref call", \testFastClosureCall());
        addTestCase("IR-only body locals skip instantiation", \testIROnlyBodyLocals());
        addTestCase("assert with IR-only locals", \testAssertIROnly());
        addTestCase("on_block_exit with IR-only locals", \testOnBlockExitWithIROnlyLocals());
        addTestCase("multi-function batch compilation", \testBatchCompilation());
        addTestCase("direct-index foldl on typed lists", \testDirectIndexFoldl());
        addTestCase("direct-index map on typed lists", \testDirectIndexMap());
        addTestCase("call closure/callref direct", \testCallClosureDirect());
        addTestCase("dot-eval method fast call", \testDotEvalMethodFastCall());
        addTestCase("builtin function fast call", \testBuiltinFastCall());
        addTestCase("specialized hash-key map opcodes", \testMapHashKeyOpcodes());
        addTestCase("direct-index select on typed lists", \testDirectIndexSelect());
        addTestCase("hash key access skip invoke for plain hash", \testHashKeyAccessSkipInvoke());
        addTestCase("hash key access int opcode", \testHashKeyAccessInt());
        addTestCase("direct-index map with heap-allocated results", \testDirectIndexMapHeapResults());
        addTestCase("hash map duplicate keys", \testHashMapDuplicateKeys());
        addTestCase("hash key access int missing key", \testHashKeyAccessIntMissingKey());
        set_return_value(main());
    }

    private string runScript(string code, *string exec_mode) {
        string mode = exec_mode ?? "jit";
        TmpFile tmp(".q");
        tmp.file.write(code);
        tmp.file.close();
        string path = tmp.path;
        string cmd = sprintf("%s --enable-debug --exec-mode=%s %s 2>&1", qore_bin, mode, path);
        return backquote(cmd);
    }

    testJitIntArithmetic() {
        # Test that JIT or fallback produces correct integer arithmetic
        string code = "%modern
int sub compute(int a, int b) {
    int sum = a + b;
    int diff = a - b;
    int prod = a * b;
    return sum + diff + prod;
}
printf(\"%d\\n\", compute(10, 3));
";
        string result = trim(runScript(code));
        assertEq("50", result, "integer arithmetic: (10+3) + (10-3) + (10*3) = 13+7+30 = 50");
    }

    testJitIntComparisons() {
        string code = "%modern
int a = 5;
int b = 10;
list<string> results = ();
if (a < b) { results += \"lt\"; }
if (a <= b) { results += \"le\"; }
if (b > a) { results += \"gt\"; }
if (b >= a) { results += \"ge\"; }
if (a == a) { results += \"eq\"; }
if (a != b) { results += \"ne\"; }
printf(\"%s\\n\", results.join(\",\"));
";
        string result = trim(runScript(code));
        assertEq("lt,le,gt,ge,eq,ne", result, "integer comparisons");
    }

    testJitFloatArithmetic() {
        string code = "%modern
float sub fcompute(float a, float b) {
    float sum = a + b;
    float diff = a - b;
    float prod = a * b;
    return sum + diff + prod;
}
printf(\"%.1f\\n\", fcompute(10.0, 3.0));
";
        string result = trim(runScript(code));
        assertEq("50.0", result, "float arithmetic");
    }

    testJitMixedIntFloatArithmetic() {
        string code = "%modern
float f = 2.5;
int i = 3;
# mixed int/float arithmetic should promote to float
float r1 = f + i;
float r2 = f * i;
float r3 = f - i;
float r4 = i / f;
printf(\"%.1f,%.1f,%.1f,%.1f\\n\", r1, r2, r3, r4);
";
        string result = trim(runScript(code));
        assertEq("5.5,7.5,-0.5,1.2", result, "mixed int/float arithmetic");
    }

    testJitFloatComparisons() {
        string code = "%modern
float a = 1.5;
float b = 2.5;
list<string> results = ();
if (a < b) { results += \"lt\"; }
if (a <= b) { results += \"le\"; }
if (b > a) { results += \"gt\"; }
if (b >= a) { results += \"ge\"; }
if (a == a) { results += \"eq\"; }
if (a != b) { results += \"ne\"; }
printf(\"%s\\n\", results.join(\",\"));
";
        string result = trim(runScript(code));
        assertEq("lt,le,gt,ge,eq,ne", result, "float comparisons");
    }

    testJitMixedIntFloatComparisons() {
        string code = "%modern
float f = 2.5;
int i = 3;
list<string> results = ();
if (f < i) { results += \"f_lt_i\"; }
if (f <= i) { results += \"f_le_i\"; }
if (i > f) { results += \"i_gt_f\"; }
if (i >= f) { results += \"i_ge_f\"; }
if (f == 2.5) { results += \"f_eq_lit\"; }
if (f != i) { results += \"f_ne_i\"; }
# int compared to float literal
if (i > 2.0) { results += \"i_gt_flit\"; }
if (i < 4.0) { results += \"i_lt_flit\"; }
printf(\"%s\\n\", results.join(\",\"));
";
        string result = trim(runScript(code));
        assertEq("f_lt_i,f_le_i,i_gt_f,i_ge_f,f_eq_lit,f_ne_i,i_gt_flit,i_lt_flit", result,
            "mixed int/float comparisons");
    }

    testJitBoolOps() {
        string code = "%modern
bool a = True;
bool b = False;
list<string> results = ();
if (a) { results += \"a_true\"; }
if (!b) { results += \"b_false\"; }
if (a != b) { results += \"ne\"; }
printf(\"%s\\n\", results.join(\",\"));
";
        string result = trim(runScript(code));
        assertEq("a_true,b_false,ne", result, "boolean operations");
    }

    testJitControlFlow() {
        string code = "%modern
int sub fib(int n) {
    if (n <= 1) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}
printf(\"%d\\n\", fib(10));
";
        string result = trim(runScript(code));
        assertEq("55", result, "recursive fibonacci");
    }

    testJitBitwiseOps() {
        string code = "%modern
int a = 0xFF;
int b = 0x0F;
int and_result = a & b;
int or_result = a | b;
int xor_result = a ^ b;
int shl_result = 1 << 8;
int shr_result = 256 >> 4;
printf(\"%d,%d,%d,%d,%d\\n\", and_result, or_result, xor_result, shl_result, shr_result);
";
        string result = trim(runScript(code));
        assertEq("15,255,240,256,16", result, "bitwise operations");
    }

    testJitDivisionByZero() {
        string code = "%modern
%disable-warning unreferenced-variable
try {
    int zero = 0;
    int x = 10 / zero;
    printf(\"ERROR: no exception\\n\");
} catch (hash<ExceptionInfo> ex) {
    printf(\"%s\\n\", ex.err);
}
";
        string result = trim(runScript(code));
        assertEq("DIVISION-BY-ZERO", result, "division by zero exception");
    }

    testJitNestedIfElse() {
        string code = "%modern
int sub classify(int n) {
    if (n < 0) {
        return -1;
    } else if (n == 0) {
        return 0;
    } else {
        return 1;
    }
}
printf(\"%d,%d,%d\\n\", classify(-5), classify(0), classify(5));
";
        string result = trim(runScript(code));
        assertEq("-1,0,1", result, "nested if/else");
    }

    testJitLoopComputation() {
        string code = "%modern
int sum = 0;
for (int i = 1; i <= 100; i++) {
    sum += i;
}
printf(\"%d\\n\", sum);
";
        string result = trim(runScript(code));
        assertEq("5050", result, "loop sum 1..100");
    }

    testJitFallbackToIr() {
        # Test that JIT falls back gracefully for complex operations
        string code = "%modern
hash<auto> h = {\"key\": \"value\"};
printf(\"%s\\n\", h.key);
";
        string result = trim(runScript(code));
        assertEq("value", result, "JIT fallback for hash access");
    }

    testJitNonModernFallback() {
        # Non-%modern code should fall back to AST; check output contains "42"
        string code = "printf(\"%d\\n\", 42);\n";
        string result = runScript(code);
        assertRegex("42", result, "non-modern fallback to AST produces correct output");
    }

    testJitTryCatch() {
        string code = "%modern
try {
    throw \"TEST-ERROR\", \"test message\";
} catch (hash<ExceptionInfo> ex) {
    printf(\"%s:%s\\n\", ex.err, ex.desc);
}
";
        string result = trim(runScript(code));
        assertEq("TEST-ERROR:test message", result, "try/catch with throw");
    }

    testJitFloatDivByZero() {
        string code = "%modern
%disable-warning unreferenced-variable
try {
    float zero = 0.0;
    float x = 10.0 / zero;
    printf(\"ERROR: no exception\\n\");
} catch (hash<ExceptionInfo> ex) {
    printf(\"%s\\n\", ex.err);
}
";
        string result = trim(runScript(code));
        assertEq("DIVISION-BY-ZERO", result, "float division by zero");
    }

    testJitModuloByZero() {
        string code = "%modern
%disable-warning unreferenced-variable
try {
    int zero = 0;
    int x = 10 % zero;
    printf(\"ERROR: no exception\\n\");
} catch (hash<ExceptionInfo> ex) {
    printf(\"%s\\n\", ex.err);
}
";
        string result = trim(runScript(code));
        assertEq("DIVISION-BY-ZERO", result, "modulo by zero");
    }

    testJitUnaryOps() {
        string code = "%modern
int a = 42;
int neg = -a;
float f = 3.14;
float fneg = -f;
printf(\"%d,%.2f\\n\", neg, fneg);
";
        string result = trim(runScript(code));
        assertEq("-42,-3.14", result, "unary negation");
    }

    testJitMixedArithmetic() {
        string code = "%modern
int a = 7;
int b = 3;
int sum = a + b;
int diff = a - b;
int prod = a * b;
int quot = a / b;
int mod = a % b;
printf(\"%d,%d,%d,%d,%d\\n\", sum, diff, prod, quot, mod);
";
        string result = trim(runScript(code));
        assertEq("10,4,21,2,1", result, "mixed integer arithmetic");
    }

    testJitStringOps() {
        string code = "%modern
string s = \"hello\";
printf(\"%s world\\n\", s);
";
        string result = trim(runScript(code));
        assertEq("hello world", result, "string operations");
    }

    testJitSwitch() {
        string code = "%modern
int sub classify(int n) {
    switch (n) {
        case 1: return 10;
        case 2: return 20;
        case 3: return 30;
        default: return -1;
    }
}
printf(\"%d,%d,%d,%d\\n\", classify(1), classify(2), classify(3), classify(99));
";
        string result = trim(runScript(code));
        assertEq("10,20,30,-1", result, "switch statement");

        # Test integer switch optimization across all modes
        string switch_code = "%modern
int sub test_switch(int val) {
    switch (val) {
        case -5: return 100;
        case 0: return 200;
        case 7: return 300;
        case 42: return 400;
        case 1000: return 500;
        default: return -999;
    }
}
printf(\"%d,%d,%d,%d,%d,%d\\n\",
    test_switch(-5), test_switch(0), test_switch(7),
    test_switch(42), test_switch(1000), test_switch(99));
";
        foreach string mode in ("ast", "ir", "jit") {
            result = trim(runScript(switch_code, mode));
            assertEq("100,200,300,400,500,-999", result, sprintf("integer switch optimization %s", mode));
        }

        # Test switch with fall-through cases (no return)
        string fallthrough_code = "%modern
int sub test_fallthrough(int val) {
    int result = 0;
    switch (val) {
        case 1:
        case 2:
        case 3:
            result = 10;
            break;
        case 4:
        case 5:
            result = 20;
            break;
        default:
            result = -1;
    }
    return result;
}
printf(\"%d,%d,%d,%d,%d,%d\\n\",
    test_fallthrough(1), test_fallthrough(2), test_fallthrough(3),
    test_fallthrough(4), test_fallthrough(5), test_fallthrough(99));
";
        foreach string mode in ("ast", "ir", "jit") {
            result = trim(runScript(fallthrough_code, mode));
            assertEq("10,10,10,20,20,-1", result, sprintf("switch fallthrough %s", mode));
        }

        # Test switch with string expression - should NOT use SwitchInt, must use soft-equal semantics
        string string_switch_code = "%modern
string sub test_string_switch(string val) {
    switch (val) {
        case \"1\": return \"one\";
        case \"2\": return \"two\";
        case \"hello\": return \"greeting\";
        default: return \"unknown\";
    }
}
printf(\"%s,%s,%s,%s\\n\",
    test_string_switch(\"1\"), test_string_switch(\"2\"),
    test_string_switch(\"hello\"), test_string_switch(\"other\"));
";
        foreach string mode in ("ast", "ir", "jit") {
            result = trim(runScript(string_switch_code, mode));
            assertEq("one,two,greeting,unknown", result, sprintf("switch string expression %s", mode));
        }

        # Test switch with float expression - should NOT use SwitchInt
        string float_switch_code = "%modern
string sub test_float_switch(float val) {
    switch (val) {
        case 1.0: return \"one\";
        case 2.5: return \"two-half\";
        default: return \"other\";
    }
}
printf(\"%s,%s,%s\\n\",
    test_float_switch(1.0), test_float_switch(2.5), test_float_switch(3.0));
";
        foreach string mode in ("ast", "ir", "jit") {
            result = trim(runScript(float_switch_code, mode));
            assertEq("one,two-half,other", result, sprintf("switch float expression %s", mode));
        }
    }

    testJitWhileLoop() {
        string code = "%modern
int n = 10;
int sum = 0;
int i = 1;
while (i <= n) {
    sum += i;
    i++;
}
printf(\"%d\\n\", sum);
";
        string result = trim(runScript(code));
        assertEq("55", result, "while loop sum");
    }

    testJitDoWhileLoop() {
        string code = "%modern
int n = 5;
int prod = 1;
int i = 1;
do {
    prod *= i;
    i++;
} while (i <= n);
printf(\"%d\\n\", prod);
";
        string result = trim(runScript(code));
        assertEq("120", result, "do-while factorial");
    }

    testJitCorrectnessAcrossModes() {
        # Verify identical output across all three modes for a non-trivial program
        string code = "%modern
int sub compute(int n) {
    int result = 0;
    for (int i = 0; i < n; i++) {
        if (i % 2 == 0) {
            result += i * i;
        } else {
            result -= i;
        }
    }
    return result;
}
printf(\"%d\\n\", compute(20));
";
        string ast_result = trim(runScript(code, "ast"));
        string ir_result = trim(runScript(code, "ir"));
        string jit_result = trim(runScript(code, "jit"));
        assertEq(ast_result, ir_result, "IR produces same result as AST");
        assertEq(ast_result, jit_result, "JIT produces same result as AST");
    }

    testJitHashAccess() {
        string code = "%modern
hash<auto> h = {\"key\": \"value\", \"num\": 42};
printf(\"%s:%d\\n\", h.key, h.num);
";
        string result = trim(runScript(code));
        assertEq("value:42", result, "hash construction and dot-access");
    }

    testJitListOps() {
        string code = "%modern
list<int> l = (10, 20, 30, 40, 50);
int sum = 0;
for (int i = 0; i < l.size(); i++) {
    sum += l[i];
}
printf(\"%d:%d\\n\", l.size(), sum);
";
        string result = trim(runScript(code));
        assertEq("5:150", result, "list construction, indexing, and size");
    }

    testJitStringConcat() {
        string code = "%modern
string a = \"hello\";
string b = \" world\";
string c = a + b;
printf(\"%s:%d\\n\", c, c.size());
";
        string result = trim(runScript(code));
        assertEq("hello world:11", result, "string concatenation and size");
    }

    testJitDynamicComparisons() {
        string code = "%modern
auto a = 5;
auto b = 10;
list<string> results = ();
if (a < b) { results += \"lt\"; }
if (a <= b) { results += \"le\"; }
if (b > a) { results += \"gt\"; }
if (b >= a) { results += \"ge\"; }
if (a == a) { results += \"eq\"; }
if (a != b) { results += \"ne\"; }
printf(\"%s\\n\", results.join(\",\"));
";
        string result = trim(runScript(code));
        assertEq("lt,le,gt,ge,eq,ne", result, "dynamic auto comparison operators");
    }

    testJitDynamicBitwise() {
        string code = "%modern
auto a = 0xFF;
auto b = 0x0F;
auto and_r = a & b;
auto or_r = a | b;
auto xor_r = a ^ b;
auto shl_r = 1 << 8;
auto shr_r = 256 >> 4;
printf(\"%d,%d,%d,%d,%d\\n\", and_r, or_r, xor_r, shl_r, shr_r);
";
        string result = trim(runScript(code));
        assertEq("15,255,240,256,16", result, "dynamic auto bitwise operators");
    }

    testJitDynamicUnary() {
        string code = "%modern
auto a = 42;
auto neg = -a;
auto f = 3.14;
auto fneg = -f;
printf(\"%d,%.2f\\n\", neg, fneg);
";
        string result = trim(runScript(code));
        assertEq("-42,-3.14", result, "dynamic auto unary negation");
    }

    testJitCompoundAssign() {
        string code = "%modern
int a = 10;
a += 5;
int b = 20;
b -= 3;
int c = 4;
c *= 3;
int d = 15;
d /= 3;
int e = 17;
e %= 5;
printf(\"%d,%d,%d,%d,%d\\n\", a, b, c, d, e);
";
        string result = trim(runScript(code));
        assertEq("15,17,12,5,2", result, "compound assignment operators");
    }

    testJitCompoundAssignBitwise() {
        # Test native LLVM lowering for bitwise compound assignments
        string code = "%modern
int a = 0xFF;
a &= 0x0F;      # AND
int b = 0x0F;
b |= 0xF0;      # OR
int c = 0xFF;
c ^= 0xAA;      # XOR
int d = 1;
d <<= 8;        # SHL
int e = 256;
e >>= 4;        # SHR
printf(\"%d,%d,%d,%d,%d\\n\", a, b, c, d, e);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("15,255,85,256,16", result, sprintf("bitwise compound assign %s", mode));
        }
    }

    testJitCompoundAssignFloat() {
        # Test native LLVM lowering for float compound assignments
        string code = "%modern
float a = 10.0;
a += 2.5;       # Add
float b = 20.0;
b -= 3.5;       # Sub
float c = 4.0;
c *= 2.5;       # Mul
printf(\"%.1f,%.1f,%.1f\\n\", a, b, c);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("12.5,16.5,10.0", result, sprintf("float compound assign %s", mode));
        }
    }

    testJitCompoundAssignAny() {
        # Test fast-path for any-typed compound assignments (int+int and float+float)
