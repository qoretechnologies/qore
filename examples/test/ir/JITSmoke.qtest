        code = "%modern
class MyConfig {
    public {
        static string name = \"default\";
    }
    static string getName() {
        try {
            return MyConfig::name;
        } catch (hash<auto> ex) {
            return \"error\";
        }
    }
}
printf(\"%s\\n\", MyConfig::getName());
";
        foreach string mode in ("ast", "ir", "jit") {
