    testJitCompoundAssignLoop() {
        # Test compound assignments in a tight loop (benchmark scenario)
        string code = "%modern
int sum = 0;
for (int i = 1; i <= 100; i++) {
    sum += i;
}
int prod = 1;
for (int j = 1; j <= 10; j++) {
    prod *= j;
}
printf(\"%d,%d\\n\", sum, prod);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("5050,3628800", result, sprintf("compound assign loop %s", mode));
        }
    }

    testJitCompoundAssignOverflow() {
        # Test compound assignments with large values (edge case)
        string code = "%modern
int a = 9223372036854775800;  # Near max int64
a += 7;
int b = -9223372036854775800;  # Near min int64
b -= 8;
printf(\"%d,%d\\n\", a, b);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("9223372036854775807,-9223372036854775808", result,
                    sprintf("compound assign overflow %s", mode));
        }
    }

    testJitDivisionInlineZeroCheck() {
        # Test inline zero-check for division/modulo operations
        # This verifies that native LLVM division is used for non-zero divisors
        # and runtime exception is raised for zero divisors
        string code = "%modern
int sub test_div_mod() {
    int sum = 0;
    # Normal division/modulo in loop (tests inline fast-path)
    for (int i = 1; i <= 10; i++) {
        sum += 100 / i;
        sum += 100 % i;
    }
    # Compound division/modulo
    int a = 1000;
    a /= 10;
    int b = 97;
    b %= 10;
    # Float division
    float f = 100.0;
    float g = 4.0;
    float fdiv = f / g;
    float h = 50.0;
    h /= 5.0;
    return sum + a + b + int(fdiv) + int(h);
}
printf(\"%d\\n\", test_div_mod());
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("445", result, sprintf("division inline zero-check %s", mode));
        }

        # Test that zero divisor still raises exception with inline check
        string zero_code = "%modern
%disable-warning unreferenced-variable
try {
    int a = 100;
    int b = 0;
    int c = a / b;
    printf(\"ERROR\");
} catch (hash<ExceptionInfo> ex) {
    printf(\"%s\", ex.err);
}
";
        assertEq("DIVISION-BY-ZERO", trim(runScript(zero_code, "jit")),
                "inline zero-check raises DIVISION-BY-ZERO");
    }

    testJitThrowList() {
        string code = "%modern
try {
    throw \"MY-ERROR\", \"my description\";
} catch (hash<ExceptionInfo> ex) {
    printf(\"%s:%s\\n\", ex.err, ex.desc);
}
";
        string result = trim(runScript(code));
        assertEq("MY-ERROR:my description", result, "throw with err and desc args");
    }

    testJitMultipleExceptions() {
        string code = "%modern
list<string> results = ();
for (int i = 0; i < 5; i++) {
    try {
        if (i % 2 == 0) {
            throw \"EVEN-ERROR\", sprintf(\"i=%d\", i);
        } else {
            results += sprintf(\"ok:%d\", i);
        }
    } catch (hash<ExceptionInfo> ex) {
        results += sprintf(\"%s:%s\", ex.err, ex.desc);
    }
}
printf(\"%s\\n\", results.join(\",\"));
";
        string result = trim(runScript(code));
        assertEq("EVEN-ERROR:i=0,ok:1,EVEN-ERROR:i=2,ok:3,EVEN-ERROR:i=4", result, "multiple exceptions in loop");
    }

    testJitScopedObjectConstruction() {
        # Test "ClassName var(args)" syntax (VarRefNewObjectNode)
        string code = "%modern
class Point {
    public {
        int x;
        int y;
    }
    constructor(int a, int b) {
        x = a;
        y = b;
    }
}
Point p(3, 7);
printf(\"%d:%d\\n\", p.x, p.y);
";
        string ast_result = trim(runScript(code, "ast"));
        string ir_result = trim(runScript(code, "ir"));
        string jit_result = trim(runScript(code, "jit"));
        assertEq("3:7", ast_result, "scoped object construction AST");
        assertEq(ast_result, ir_result, "scoped object construction IR matches AST");
        assertEq(ast_result, jit_result, "scoped object construction JIT matches AST");
    }

    # --- Phase 5b optimization tests ---

    testJitHashKeyFastPath() {
        # Test hash key access via DotEvalHash with constant string key
        string code = "%modern
hash<auto> h = {\"name\": \"alice\", \"age\": 30, \"score\": 99.5};
printf(\"%s:%d:%.1f\\n\", h.name, h.age, h.score);
";
        string ast_result = trim(runScript(code, "ast"));
        string jit_result = trim(runScript(code, "jit"));
        assertEq("alice:30:99.5", ast_result, "hash key access AST");
        assertEq(ast_result, jit_result, "hash key access JIT matches AST");
    }

    testJitListIndexFastPath() {
        # Test list index access with integer index
        string code = "%modern
list<auto> l = (\"alpha\", 42, 3.14, True);
printf(\"%s:%d:%.2f:%s\\n\", l[0], l[1], l[2], l[3] ? \"true\" : \"false\");
";
        string ast_result = trim(runScript(code, "ast"));
        string jit_result = trim(runScript(code, "jit"));
        assertEq("alpha:42:3.14:true", ast_result, "list index access AST");
        assertEq(ast_result, jit_result, "list index access JIT matches AST");
    }

    testJitStringConcatFastPath() {
        # Test string concatenation through AddAny (auto-typed)
        string code = "%modern
auto a = \"hello\";
auto b = \" world\";
auto c = a + b;
printf(\"%s\\n\", c);
";
        string ast_result = trim(runScript(code, "ast"));
        string jit_result = trim(runScript(code, "jit"));
        assertEq("hello world", ast_result, "string concat AST");
        assertEq(ast_result, jit_result, "string concat JIT matches AST");
    }

    testJitAnyArithFastPath() {
        # Test inline int+int and float+float fast-paths for .any arithmetic
        string code = "%modern
auto a = 10;
auto b = 20;
auto sum = a + b;
auto diff = a - b;
auto prod = a * b;
auto fa = 1.5;
auto fb = 2.5;
auto fsum = fa + fb;
auto fdiff = fa - fb;
auto fprod = fa * fb;
printf(\"%d:%d:%d:%.1f:%.1f:%.2f\\n\", sum, diff, prod, fsum, fdiff, fprod);
";
        string ast_result = trim(runScript(code, "ast"));
        string jit_result = trim(runScript(code, "jit"));
        assertEq("30:-10:200:4.0:-1.0:3.75", ast_result, "any arith AST");
        assertEq(ast_result, jit_result, "any arith JIT matches AST");
    }

    testJitAnyCmpFastPath() {
        # Test inline int-vs-int and float-vs-float fast-paths for comparisons
        string code = "%modern
auto a = 5;
auto b = 10;
list<string> r = ();
if (a == a) { r += \"eq\"; }
if (a != b) { r += \"ne\"; }
if (a < b) { r += \"lt\"; }
if (a <= b) { r += \"le\"; }
if (b > a) { r += \"gt\"; }
if (b >= a) { r += \"ge\"; }
auto fa = 1.5;
auto fb = 2.5;
if (fa == fa) { r += \"feq\"; }
if (fa != fb) { r += \"fne\"; }
if (fa < fb) { r += \"flt\"; }
if (fb > fa) { r += \"fgt\"; }
printf(\"%s\\n\", r.join(\",\"));
";
        string ast_result = trim(runScript(code, "ast"));
        string jit_result = trim(runScript(code, "jit"));
        assertEq("eq,ne,lt,le,gt,ge,feq,fne,flt,fgt", ast_result, "any cmp AST");
        assertEq(ast_result, jit_result, "any cmp JIT matches AST");
    }

    testJitAnyArithMixed() {
        # Test .any arithmetic with mixed types (int+float should fall to slow path)
        string code = "%modern
auto a = 10;
auto b = 2.5;
auto result = a + b;
printf(\"%.1f\\n\", result);
";
        string ast_result = trim(runScript(code, "ast"));
        string jit_result = trim(runScript(code, "jit"));
        assertEq("12.5", ast_result, "mixed any arith AST");
        assertEq(ast_result, jit_result, "mixed any arith JIT matches AST");
    }

    testJitPhase5bCrossMode() {
        # Comprehensive test exercising hash, list, string, arith, and comparison
        # across all execution modes
        string code = "%modern
auto sub compute(auto n) {
    hash<auto> h = {\"val\": n, \"doubled\": n * 2};
    list<auto> l = (h.val, h.doubled);
    auto sum = l[0] + l[1];
    if (sum > 10) {
        return sum;
    }
    return 0;
}
list<auto> results = ();
for (int i = 0; i < 10; i++) {
    results += compute(i);
}
printf(\"%s\\n\", (map $1.toString(), results).join(\",\"));
";
        string ast_result = trim(runScript(code, "ast"));
        string ir_result = trim(runScript(code, "ir"));
        string jit_result = trim(runScript(code, "jit"));
        assertEq(ast_result, ir_result, "Phase 5b cross-mode: IR matches AST");
        assertEq(ast_result, jit_result, "Phase 5b cross-mode: JIT matches AST");
    }

    # --- Phase 5c debug info tests ---

    testJitDebugInfoCompile() {
        # Simple function with local variables; verify correct result under JIT
        # (exercises DIBuilder code path for every JIT compilation)
        string code = "%modern
int sub add_locals(int a, int b) {
    int x = a + 1;
    int y = b + 2;
    int result = x + y;
    return result;
}
printf(\"%d\\n\", add_locals(10, 20));
";
        string ast_result = trim(runScript(code, "ast"));
        string jit_result = trim(runScript(code, "jit"));
        assertEq("33", ast_result, "debug info compile AST");
        assertEq(ast_result, jit_result, "debug info compile JIT matches AST");
    }

    testJitDebugInfoMultiLine() {
        # Multi-line function with branches and loops; verify correct result
        # (exercises per-instruction debug locations across blocks)
        string code = "%modern
int sub multi_line(int n) {
    int total = 0;
    for (int i = 0; i < n; i++) {
        if (i % 3 == 0) {
            total += i * 2;
        } else if (i % 3 == 1) {
            total -= 1;
        } else {
            total += i;
        }
    }
    return total;
}
printf(\"%d\\n\", multi_line(15));
";
        string ast_result = trim(runScript(code, "ast"));
        string jit_result = trim(runScript(code, "jit"));
        assertEq(ast_result, jit_result, "debug info multi-line JIT matches AST");
    }

    # --- Double-eval regression tests ---

    testJitSideEffectingArgs() {
        # Verify that side-effecting function args are evaluated exactly once per call
        string code = "%modern
int counter = 0;
int sub side_effect(int v) {
    counter++;
    return v;
}
int sub add(int a, int b) { return a + b; }
int result = add(side_effect(10), side_effect(20));
printf(\"%d:%d\\n\", result, counter);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("30:2", result, sprintf("side-effecting args %s", mode));
        }
    }

    testJitTrackedSideEffects() {
        # Verify tracked_inc() (a side-effecting call) evaluates once as arg
        string code = "%modern
int counter = 0;
int sub tracked_inc(int v) {
    counter++;
    return v;
}
int sub identity(int v) { return v; }
int i = 5;
int result = identity(tracked_inc(i));
printf(\"%d:%d\\n\", result, counter);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("5:1", result, sprintf("tracked side effects %s", mode));
        }
    }

    testJitNestedCallSideEffects() {
        # Verify nested calls with side effects: log should have exactly 3 entries
        string code = "%modern
list<int> log = ();
int sub logged(int v) {
    log += v;
    return v;
}
int sub add3(int a, int b, int c) { return a + b + c; }
int result = add3(logged(1), logged(2), logged(3));
printf(\"%d:%d:%s\\n\", result, log.size(), (map $1.toString(), log).join(\",\"));
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("6:3:1,2,3", result, sprintf("nested call side effects %s", mode));
        }
    }

    testJitBinaryInvokeTryCatch() {
        # Verify binary ops inside try/catch (Invoke path) work correctly
        string code = "%modern
auto a = 10;
auto b = 0;
string result;
try {
    auto r = a / b;
    result = \"no-exception\";
} catch (hash<ExceptionInfo> ex) {
    result = ex.err;
}
printf(\"%s\\n\", result);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("DIVISION-BY-ZERO", result,
                    sprintf("binary invoke try/catch %s", mode));
        }
    }

    testJitCallCrossMode() {
        # Verify call with side effects produces same results across modes
        string code = "%modern
int counter = 0;
int sub bump() {
    counter++;
    return counter;
}
int a = bump();
int b = bump();
int c = bump();
printf(\"%d:%d:%d:%d\\n\", a, b, c, counter);
";
        string ast_result = trim(runScript(code, "ast"));
        string ir_result = trim(runScript(code, "ir"));
        string jit_result = trim(runScript(code, "jit"));
        assertEq("1:2:3:3", ast_result, "call cross-mode AST");
        assertEq(ast_result, ir_result, "call cross-mode IR matches AST");
        assertEq(ast_result, jit_result, "call cross-mode JIT matches AST");
    }

    # --- Bug fix regression tests ---

    testJitNoArgCall() {
        # Bug 2: zero-argument function calls failed IR lowering
        string code = "%modern
int sub no_arg_func() {
    return 42;
}
printf(\"%d\\n\", no_arg_func());
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("42", result, sprintf("no-arg function call %s", mode));
        }
    }

    testJitIntPostIncrement() {
        # Bug 1: int-typed post-increment failed IR lowering (QoreIntPostIncrementOperatorNode
        # does not inherit from QorePostIncrementOperatorNode)
        string code = "%modern
int i = 5;
int r = i++;
printf(\"%d:%d\\n\", r, i);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("5:6", result, sprintf("int post-increment %s", mode));
        }
    }

    testJitIntPostDecrement() {
        # Bug 1: int-typed post-decrement failed IR lowering (QoreIntPostDecrementOperatorNode
        # does not inherit from QorePostDecrementOperatorNode)
        string code = "%modern
int i = 5;
int r = i--;
printf(\"%d:%d\\n\", r, i);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("5:4", result, sprintf("int post-decrement %s", mode));
        }
    }

    testJitTernary() {
        # Bug 3: ternary operator PHI node had zero incoming values in LLVM lowering
        string code = "%modern
int sub ternary_test(int x) {
    int r = (x > 0) ? 10 : 20;
    return r;
}
printf(\"%d:%d:%d\\n\", ternary_test(5), ternary_test(0), ternary_test(-3));
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("10:20:20", result, sprintf("ternary operator %s", mode));
        }
    }

    testJitDotEvalSingleEval() {
        # Bug A: DotEval double-evaluation — base expression f() should be called once, not twice
        string code = "%modern
our int counter = 0;
class C {
    int get() { return 42; }
}
C sub f() { counter++; return new C(); }
int r = f().get();
printf(\"%d:%d\\n\", r, counter);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("42:1", result, sprintf("dot-eval single eval %s", mode));
        }
    }

    testJitDotEvalInvokeSingleEval() {
        # Bug A: DotEval inside try/catch (Invoke path) — base called once
        string code = "%modern
our int counter = 0;
class C {
    int get() { return 99; }
}
C sub f() { counter++; return new C(); }
int r;
try { r = f().get(); } catch (hash<auto> ex) { r = -1; }
printf(\"%d:%d\\n\", r, counter);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("99:1", result, sprintf("dot-eval invoke single eval %s", mode));
        }
    }

    testJitDotEvalChained() {
        # Bug A: chained method calls — each base evaluated once
        string code = "%modern
our int counter = 0;
class C {
    C next() { return new C(); }
    int val() { return 7; }
}
C sub f() { counter++; return new C(); }
int r = f().next().val();
printf(\"%d:%d\\n\", r, counter);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("7:1", result, sprintf("dot-eval chained %s", mode));
        }
    }

    testJitDotEvalHashMember() {
        # Bug A: hash member access on side-effecting base — evaluated once
        string code = "%modern
our int counter = 0;
hash<auto> sub f() { counter++; return {\"key\": \"hello\"}; }
auto r = f().key;
printf(\"%s:%d\\n\", r, counter);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("hello:1", result, sprintf("dot-eval hash member %s", mode));
        }
    }

    testJitRegexMatchSingleEval() {
        # Regex match: subject f() should be called once, not twice
        string code = "%modern
our int counter = 0;
string sub f() { counter++; return \"hello123world\"; }
bool r = f() =~ /\\d+/;
printf(\"%s:%d\\n\", r ? \"true\" : \"false\", counter);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("true:1", result, sprintf("regex match single eval %s", mode));
        }
    }

    testJitRegexMatchInvokeSingleEval() {
        # Regex match inside try/catch (Invoke path): f() called once
        string code = "%modern
our int counter = 0;
string sub f() { counter++; return \"abc456def\"; }
bool r;
try { r = f() =~ /\\d+/; } catch (hash<auto> ex) { r = False; }
printf(\"%s:%d\\n\", r ? \"true\" : \"false\", counter);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("true:1", result, sprintf("regex match invoke single eval %s", mode));
        }
    }

    testJitRegexExtractSingleEval() {
        # Regex extract: subject f() should be called once
        string code = "%modern
our int counter = 0;
string sub f() { counter++; return \"abc123def456\"; }
auto r = (f() =~ x/(\\d+)/);
printf(\"%s:%d\\n\", r[0], counter);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("123:1", result, sprintf("regex extract single eval %s", mode));
        }
    }

    testJitRegexExtractInvokeSingleEval() {
        # Regex extract inside try/catch (Invoke path): f() called once
        string code = "%modern
our int counter = 0;
string sub f() { counter++; return \"xyz789\"; }
auto r;
try { r = (f() =~ x/(\\d+)/); } catch (hash<auto> ex) { r = list(); }
printf(\"%s:%d\\n\", r[0], counter);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("789:1", result, sprintf("regex extract invoke single eval %s", mode));
        }
    }

    testJitFoldlSumProd() {
        # Test optimized foldl with $1 + $2 and $1 * $2 patterns
        string code = "%modern
list<int> nums = (1, 2, 3, 4, 5);
int sum_result = (foldl $1 + $2, nums);
int prod_result = (foldl $1 * $2, nums);
printf(\"%d:%d\\n\", sum_result, prod_result);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("15:120", result, sprintf("foldl int sum/prod %s", mode));
        }

        # Test with floats
        string float_code = "%modern
list<float> nums = (1.5, 2.5, 3.0);
float sum_f = (foldl $1 + $2, nums);
float prod_f = (foldl $1 * $2, nums);
printf(\"%.1f:%.2f\\n\", sum_f, prod_f);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(float_code, mode));
            assertEq("7.0:11.25", result, sprintf("foldl float sum/prod %s", mode));
        }

        # Test with single element (edge case)
        string single_code = "%modern
list<int> single = (42,);
int s = (foldl $1 + $2, single);
int p = (foldl $1 * $2, single);
printf(\"%d:%d\\n\", s, p);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(single_code, mode));
            assertEq("42:42", result, sprintf("foldl single element %s", mode));
        }
    }

    testJitFoldlDiffMinMax() {
        # Test optimized foldl with $1 - $2 (diff) pattern
        string diff_code = "%modern
list<int> nums = (100, 20, 5, 3);
int diff_result = (foldl $1 - $2, nums);
printf(\"%d\\n\", diff_result);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(diff_code, mode));
            # 100 - 20 - 5 - 3 = 72
            assertEq("72", result, sprintf("foldl int diff %s", mode));
        }

        # Test min($1, $2) pattern
        string min_code = "%modern
list<int> nums = (5, 2, 8, 1, 9);
int min_result = (foldl min($1, $2), nums);
printf(\"%d\\n\", min_result);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(min_code, mode));
            assertEq("1", result, sprintf("foldl int min %s", mode));
        }

        # Test max($1, $2) pattern
        string max_code = "%modern
list<int> nums = (5, 2, 8, 1, 9);
int max_result = (foldl max($1, $2), nums);
printf(\"%d\\n\", max_result);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(max_code, mode));
            assertEq("9", result, sprintf("foldl int max %s", mode));
        }

        # Test with floats
        string float_diff_code = "%modern
list<float> nums = (10.5, 2.5, 1.0);
float diff_f = (foldl $1 - $2, nums);
printf(\"%.1f\\n\", diff_f);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(float_diff_code, mode));
            # 10.5 - 2.5 - 1.0 = 7.0
            assertEq("7.0", result, sprintf("foldl float diff %s", mode));
        }

        string float_min_code = "%modern
list<float> nums = (3.5, 1.2, 4.8);
float min_f = (foldl min($1, $2), nums);
printf(\"%.1f\\n\", min_f);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(float_min_code, mode));
            assertEq("1.2", result, sprintf("foldl float min %s", mode));
        }

        string float_max_code = "%modern
list<float> nums = (3.5, 1.2, 4.8);
float max_f = (foldl max($1, $2), nums);
printf(\"%.1f\\n\", max_f);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(float_max_code, mode));
            assertEq("4.8", result, sprintf("foldl float max %s", mode));
        }

        # Test with single element (edge case)
        string single_code = "%modern
list<int> single = (42,);
int d = (foldl $1 - $2, single);
int mi = (foldl min($1, $2), single);
int ma = (foldl max($1, $2), single);
printf(\"%d:%d:%d\\n\", d, mi, ma);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(single_code, mode));
            assertEq("42:42:42", result, sprintf("foldl diff/min/max single element %s", mode));
        }

        # Test with two elements
        string two_code = "%modern
list<int> two = (10, 3);
int d = (foldl $1 - $2, two);
int mi = (foldl min($1, $2), two);
int ma = (foldl max($1, $2), two);
printf(\"%d:%d:%d\\n\", d, mi, ma);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(two_code, mode));
            # 10 - 3 = 7, min(10,3) = 3, max(10,3) = 10
            assertEq("7:3:10", result, sprintf("foldl diff/min/max two elements %s", mode));
        }

        # Test with negative numbers
        string neg_code = "%modern
list<int> nums = (-5, 3, -2, 8);
int mi = (foldl min($1, $2), nums);
int ma = (foldl max($1, $2), nums);
printf(\"%d:%d\\n\", mi, ma);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(neg_code, mode));
            assertEq("-5:8", result, sprintf("foldl min/max with negatives %s", mode));
        }
    }

    testJitMapOptimized() {
        # Test optimized map patterns: $1 * const (scale), $1 + const (offset), $1 * $1 (square)
        string scale_code = "%modern
list<int> nums = (1, 2, 3, 4, 5);
list<int> scaled = (map $1 * 2, nums);
printf(\"%s\\n\", (map $1.toString(), scaled).join(\",\"));
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(scale_code, mode));
            assertEq("2,4,6,8,10", result, sprintf("map scale int %s", mode));
        }

        string offset_code = "%modern
list<int> nums = (1, 2, 3, 4, 5);
list<int> offset = (map $1 + 10, nums);
printf(\"%s\\n\", (map $1.toString(), offset).join(\",\"));
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(offset_code, mode));
            assertEq("11,12,13,14,15", result, sprintf("map offset int %s", mode));
        }

        string square_code = "%modern
list<int> nums = (1, 2, 3, 4, 5);
list<int> squared = (map $1 * $1, nums);
printf(\"%s\\n\", (map $1.toString(), squared).join(\",\"));
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(square_code, mode));
            assertEq("1,4,9,16,25", result, sprintf("map square int %s", mode));
        }

        # Test with floats
        string float_scale_code = "%modern
list<float> nums = (1.0, 2.0, 3.0);
list<float> scaled = (map $1 * 2.5, nums);
printf(\"%.1f,%.1f,%.1f\\n\", scaled[0], scaled[1], scaled[2]);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(float_scale_code, mode));
            assertEq("2.5,5.0,7.5", result, sprintf("map scale float %s", mode));
        }

        # Test with empty list (edge case)
        string empty_code = "%modern
list<int> empty = ();
list<int> result = (map $1 * 2, empty);
printf(\"%d\\n\", result.size());
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(empty_code, mode));
            assertEq("0", result, sprintf("map empty list %s", mode));
        }
    }

    testJitSelectOptimized() {
        # Test optimized select patterns: $1 > 0 (positive), $1 != 0 (nonzero)
        # Syntax: (select list, condition)
        string positive_code = "%modern
list<int> nums = (-3, -2, -1, 0, 1, 2, 3);
list<int> positive = (select nums, $1 > 0);
printf(\"%s\\n\", (map $1.toString(), positive).join(\",\"));
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(positive_code, mode));
            assertEq("1,2,3", result, sprintf("select positive int %s", mode));
        }

        string nonzero_code = "%modern
list<int> nums = (-2, -1, 0, 1, 2);
list<int> nonzero = (select nums, $1 != 0);
printf(\"%s\\n\", (map $1.toString(), nonzero).join(\",\"));
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(nonzero_code, mode));
            assertEq("-2,-1,1,2", result, sprintf("select nonzero int %s", mode));
        }

        # Test with floats
        string float_positive_code = "%modern
list<float> nums = (-1.5, 0.0, 1.5, 2.5);
list<float> positive = (select nums, $1 > 0);
printf(\"%.1f,%.1f\\n\", positive[0], positive[1]);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(float_positive_code, mode));
            assertEq("1.5,2.5", result, sprintf("select positive float %s", mode));
        }

        # Test with all-filtered-out list (edge case)
        string all_filtered_code = "%modern
list<int> nums = (-3, -2, -1);
list<int> positive = (select nums, $1 > 0);
printf(\"%d\\n\", positive.size());
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(all_filtered_code, mode));
            assertEq("0", result, sprintf("select all filtered %s", mode));
        }

        # Test with empty list (edge case)
        string empty_code = "%modern
list<int> empty = ();
list<int> result = (select empty, $1 > 0);
printf(\"%d\\n\", result.size());
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(empty_code, mode));
            assertEq("0", result, sprintf("select empty list %s", mode));
        }
    }

    testJitFusedMapSelect() {
        # Test fused map+select patterns: (map expr, (select list, $1 > 0))
        # This optimizes to a single-pass operation without intermediate list

        # Pattern: (map $1 * 2, (select list, $1 > 0)) -> filter positive, then scale
        string scale_positive_code = "%modern
list<int> nums = (-3, -2, -1, 0, 1, 2, 3);
list<int> result = (map $1 * 2, (select nums, $1 > 0));
printf(\"%s\\n\", (map $1.toString(), result).join(\",\"));
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(scale_positive_code, mode));
            # Positive values: 1, 2, 3 -> scaled by 2 -> 2, 4, 6
            assertEq("2,4,6", result, sprintf("fused map scale select positive int %s", mode));
        }

        # Pattern: (map $1 + 10, (select list, $1 > 0)) -> filter positive, then offset
        string offset_positive_code = "%modern
list<int> nums = (-5, 0, 1, 2, 3);
list<int> result = (map $1 + 10, (select nums, $1 > 0));
printf(\"%s\\n\", (map $1.toString(), result).join(\",\"));
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(offset_positive_code, mode));
            # Positive values: 1, 2, 3 -> plus 10 -> 11, 12, 13
            assertEq("11,12,13", result, sprintf("fused map offset select positive int %s", mode));
        }

        # Pattern: (map $1 * $1, (select list, $1 > 0)) -> filter positive, then square
        string square_positive_code = "%modern
list<int> nums = (-3, -2, -1, 0, 1, 2, 3);
list<int> result = (map $1 * $1, (select nums, $1 > 0));
printf(\"%s\\n\", (map $1.toString(), result).join(\",\"));
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(square_positive_code, mode));
            # Positive values: 1, 2, 3 -> squared -> 1, 4, 9
            assertEq("1,4,9", result, sprintf("fused map square select positive int %s", mode));
        }

        # Float versions
        string float_scale_code = "%modern
list<float> nums = (-1.5, 0.0, 1.0, 2.0, 3.0);
list<float> result = (map $1 * 2.0, (select nums, $1 > 0));
printf(\"%.1f,%.1f,%.1f\\n\", result[0], result[1], result[2]);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(float_scale_code, mode));
            assertEq("2.0,4.0,6.0", result, sprintf("fused map scale select positive float %s", mode));
        }

        string float_square_code = "%modern
list<float> nums = (-2.0, -1.0, 0.0, 1.0, 2.0, 3.0);
list<float> result = (map $1 * $1, (select nums, $1 > 0));
printf(\"%.1f,%.1f,%.1f\\n\", result[0], result[1], result[2]);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(float_square_code, mode));
            assertEq("1.0,4.0,9.0", result, sprintf("fused map square select positive float %s", mode));
        }

        # Edge case: all filtered out
        string all_filtered_code = "%modern
list<int> nums = (-3, -2, -1, 0);
list<int> result = (map $1 * 2, (select nums, $1 > 0));
printf(\"%d\\n\", result.size());
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(all_filtered_code, mode));
            assertEq("0", result, sprintf("fused map select all filtered %s", mode));
        }

        # Edge case: single element
        string single_code = "%modern
list<int> nums = (5,);
list<int> result = (map $1 * 3, (select nums, $1 > 0));
printf(\"%s\\n\", (map $1.toString(), result).join(\",\"));
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(single_code, mode));
            assertEq("15", result, sprintf("fused map select single element %s", mode));
        }
    }

    testJitFusedMapFoldl() {
        # Test fused map+foldl patterns: foldl $1 + $2, (map $1 * c, list)
        # This optimizes to a single-pass operation without intermediate list

        # Pattern: foldl $1 + $2, (map $1 * 2, list) -> sum(list[i] * 2)
        string sum_scale_code = "%modern
list<int> nums = (1, 2, 3, 4, 5);
int result = (foldl $1 + $2, (map $1 * 2, nums));
printf(\"%d\\n\", result);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(sum_scale_code, mode));
            # (1*2 + 2*2 + 3*2 + 4*2 + 5*2) = 2+4+6+8+10 = 30
            assertEq("30", result, sprintf("fused map foldl sum scale int %s", mode));
        }

        # Pattern: foldl $1 + $2, (map $1 * $1, list) -> sum(list[i]^2)
        string sum_square_code = "%modern
list<int> nums = (1, 2, 3, 4, 5);
int result = (foldl $1 + $2, (map $1 * $1, nums));
printf(\"%d\\n\", result);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(sum_square_code, mode));
            # 1 + 4 + 9 + 16 + 25 = 55
            assertEq("55", result, sprintf("fused map foldl sum square int %s", mode));
        }

        # Pattern: foldl $1 * $2, (map $1 * 2, list) -> prod(list[i] * 2)
        string prod_scale_code = "%modern
list<int> nums = (1, 2, 3);
int result = (foldl $1 * $2, (map $1 * 2, nums));
printf(\"%d\\n\", result);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(prod_scale_code, mode));
            # (1*2) * (2*2) * (3*2) = 2 * 4 * 6 = 48
            assertEq("48", result, sprintf("fused map foldl prod scale int %s", mode));
        }

        # Float versions
        string float_sum_scale_code = "%modern
list<float> nums = (1.0, 2.0, 3.0);
float result = (foldl $1 + $2, (map $1 * 2.0, nums));
printf(\"%.1f\\n\", result);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(float_sum_scale_code, mode));
            # (1*2 + 2*2 + 3*2) = 2+4+6 = 12.0
            assertEq("12.0", result, sprintf("fused map foldl sum scale float %s", mode));
        }

        string float_sum_square_code = "%modern
list<float> nums = (1.0, 2.0, 3.0);
float result = (foldl $1 + $2, (map $1 * $1, nums));
printf(\"%.1f\\n\", result);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(float_sum_square_code, mode));
            # 1 + 4 + 9 = 14.0
            assertEq("14.0", result, sprintf("fused map foldl sum square float %s", mode));
        }

        # Edge case: single element
        string single_code = "%modern
list<int> single = (5,);
int result = (foldl $1 + $2, (map $1 * 2, single));
printf(\"%d\\n\", result);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(single_code, mode));
            # 5 * 2 = 10
            assertEq("10", result, sprintf("fused map foldl single element %s", mode));
        }

        # Edge case: empty list
        # AST mode returns NOTHING, IR/JIT return identity value (0 for sum, 1 for product)
        # This is existing behavior difference between AST and IR/JIT optimized paths
        string empty_code = "%modern
list<int> empty = ();
auto result = (foldl $1 + $2, (map $1 * 2, empty));
printf(\"%s\\n\", exists result ? string(result) : \"NOTHING\");
";
        assertEq("NOTHING", trim(runScript(empty_code, "ast")), "fused map foldl empty list ast");
        assertEq("0", trim(runScript(empty_code, "ir")), "fused map foldl empty list ir");
        assertEq("0", trim(runScript(empty_code, "jit")), "fused map foldl empty list jit");

        # Test float precision - ensure no truncation to int
        string precision_code = "%modern
list<float> nums = (0.5, 1.5, 2.5);
float result = (foldl $1 + $2, (map $1 * 2.0, nums));
printf(\"%.1f\\n\", result);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(precision_code, mode));
            # (0.5*2 + 1.5*2 + 2.5*2) = 1.0+3.0+5.0 = 9.0
            assertEq("9.0", result, sprintf("fused map foldl float precision %s", mode));
        }

        # Test product with floats
        string float_prod_code = "%modern
list<float> nums = (1.0, 2.0, 3.0);
float result = (foldl $1 * $2, (map $1 * 0.5, nums));
printf(\"%.4f\\n\", result);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(float_prod_code, mode));
            # (1*0.5) * (2*0.5) * (3*0.5) = 0.5 * 1.0 * 1.5 = 0.75
            assertEq("0.7500", result, sprintf("fused map foldl float product %s", mode));
        }
    }

    testIRForeachLowering() {
        # Test basic foreach loop lowering to IR
        string basic_code = "%modern
list<int> nums = (1, 2, 3, 4, 5);
int sum = 0;
foreach int n in (nums) {
    sum += n;
}
printf(\"%d\\n\", sum);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(basic_code, mode));
            assertEq("15", result, sprintf("foreach basic sum %s", mode));
        }

        # Test foreach with break
        string break_code = "%modern
list<int> nums = (1, 2, 3, 4, 5);
int sum = 0;
foreach int n in (nums) {
    if (n == 3) {
        break;
    }
    sum += n;
}
printf(\"%d\\n\", sum);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(break_code, mode));
            # 1 + 2 = 3 (break before processing 3)
            assertEq("3", result, sprintf("foreach break %s", mode));
        }

        # Test foreach with continue
        string continue_code = "%modern
list<int> nums = (1, 2, 3, 4, 5);
int sum = 0;
foreach int n in (nums) {
    if (n == 3) {
        continue;
    }
    sum += n;
}
printf(\"%d\\n\", sum);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(continue_code, mode));
            # 1 + 2 + 4 + 5 = 12 (skip 3)
            assertEq("12", result, sprintf("foreach continue %s", mode));
        }

        # Test foreach with empty list
        string empty_code = "%modern
list<int> empty = ();
int sum = 0;
foreach int n in (empty) {
    sum += n;
}
printf(\"%d\\n\", sum);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(empty_code, mode));
            assertEq("0", result, sprintf("foreach empty %s", mode));
        }

        # Test nested foreach
        string nested_code = "%modern
list<list<int>> nested = ((1, 2), (3, 4), (5, 6));
int total = 0;
foreach list<int> inner in (nested) {
    foreach int n in (inner) {
        total += n;
    }
}
printf(\"%d\\n\", total);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(nested_code, mode));
            # 1+2+3+4+5+6 = 21
            assertEq("21", result, sprintf("foreach nested %s", mode));
        }
    }

    testTypedStringConcat() {
        # Test basic typed string concatenation (AddString opcode)
        string basic_code = "%modern
string a = \"hello\";
string b = \" world\";
string result = a + b;
printf(\"%s\\n\", result);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(basic_code, mode));
            assertEq("hello world", result, sprintf("typed string concat basic %s", mode));
        }

        # Test chained string concatenation
        string chain_code = "%modern
string a = \"one\";
string b = \"two\";
string c = \"three\";
string result = a + b + c;
printf(\"%s\\n\", result);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(chain_code, mode));
            assertEq("onetwothree", result, sprintf("typed string concat chain %s", mode));
        }

        # Test string concatenation with function return
        string func_code = "%modern
string sub getPrefix() { return \"prefix_\"; }
string sub getSuffix() { return \"_suffix\"; }
string middle = \"value\";
string result = getPrefix() + middle + getSuffix();
printf(\"%s\\n\", result);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(func_code, mode));
            assertEq("prefix_value_suffix", result, sprintf("typed string concat func %s", mode));
        }

        # Test string concatenation in loop
        string loop_code = "%modern
string result = \"\";
for (int i = 0; i < 3; i++) {
    result = result + \"x\";
}
printf(\"%s\\n\", result);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(loop_code, mode));
            assertEq("xxx", result, sprintf("typed string concat loop %s", mode));
        }
    }

    testTypedStringEquality() {
        # Test typed string equality (EqString opcode)
        string eq_code = "%modern
string sub test_eq(string a, string b) {
    if (a == b) {
        return \"equal\";
    }
    return \"not equal\";
}
printf(\"%s,%s,%s\\n\",
    test_eq(\"hello\", \"hello\"),
    test_eq(\"hello\", \"world\"),
    test_eq(\"\", \"\"));
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(eq_code, mode));
            assertEq("equal,not equal,equal", result, sprintf("typed string equality %s", mode));
        }

        # Test typed string inequality (NeString opcode)
        string ne_code = "%modern
string sub test_ne(string a, string b) {
    if (a != b) {
        return \"different\";
    }
    return \"same\";
}
printf(\"%s,%s,%s\\n\",
    test_ne(\"hello\", \"world\"),
    test_ne(\"hello\", \"hello\"),
    test_ne(\"abc\", \"ABC\"));
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(ne_code, mode));
            assertEq("different,same,different", result, sprintf("typed string inequality %s", mode));
        }

        # Test string comparison in loop
        string loop_code = "%modern
int sub count_matches(list<string> items, string target) {
    int count = 0;
    foreach string s in (items) {
        if (s == target) {
            count++;
        }
    }
    return count;
}
list<string> data = (\"a\", \"b\", \"a\", \"c\", \"a\");
printf(\"%d,%d,%d\\n\",
    count_matches(data, \"a\"),
    count_matches(data, \"b\"),
    count_matches(data, \"x\"));
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(loop_code, mode));
            assertEq("3,1,0", result, sprintf("typed string equality loop %s", mode));
        }
    }

    testStringSwitchOptimization() {
        # Test string switch with multiple cases (uses SwitchString opcode)
        string switch_code = "%modern
string sub classify(string val) {
    switch (val) {
        case \"red\": return \"color\";
        case \"blue\": return \"color\";
        case \"green\": return \"color\";
        case \"apple\": return \"fruit\";
        case \"banana\": return \"fruit\";
        case \"orange\": return \"fruit\";
        case \"dog\": return \"animal\";
        case \"cat\": return \"animal\";
        default: return \"unknown\";
    }
}
printf(\"%s,%s,%s,%s,%s\\n\",
    classify(\"red\"), classify(\"apple\"), classify(\"dog\"),
    classify(\"blue\"), classify(\"xyz\"));
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(switch_code, mode));
            assertEq("color,fruit,animal,color,unknown", result, sprintf("string switch optimization %s", mode));
        }

        # Test string switch with empty string case
        string empty_case_code = "%modern
string sub check_empty(string val) {
    switch (val) {
        case \"\": return \"empty\";
        case \"null\": return \"null string\";
        default: return \"has value\";
    }
}
printf(\"%s,%s,%s\\n\",
    check_empty(\"\"), check_empty(\"null\"), check_empty(\"test\"));
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(empty_case_code, mode));
            assertEq("empty,null string,has value", result, sprintf("string switch empty case %s", mode));
        }

        # Test string switch with similar strings
        string similar_code = "%modern
string sub similar_test(string val) {
    switch (val) {
        case \"test\": return \"1\";
        case \"test1\": return \"2\";
        case \"test12\": return \"3\";
        case \"test123\": return \"4\";
        default: return \"0\";
    }
}
printf(\"%s,%s,%s,%s,%s\\n\",
    similar_test(\"test\"), similar_test(\"test1\"), similar_test(\"test12\"),
    similar_test(\"test123\"), similar_test(\"test1234\"));
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(similar_code, mode));
            assertEq("1,2,3,4,0", result, sprintf("string switch similar strings %s", mode));
        }
    }

    testFinalClassDevirtualization() {
        # Test final class devirtualization - self.method() calls in final classes
        # should use CallMethodDirect opcode instead of CallMethod

        # Test 1: Final class with recursive self call
        # The self.compute() call inside compute() should be devirtualized
        string recursive_code = "%new-style
%strict-args
%require-types
%disable-warning non-existent-method-call

final class Calculator {
    public {
        int calls = 0;
    }

    int compute(int n) {
        ++calls;
        if (n <= 1) {
            return 1;
        }
        return n * self.compute(n - 1);
    }
}

Calculator c();
int result = c.compute(5);
printf(\"%d,%d\\n\", result, c.calls);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(recursive_code, mode));
            # factorial(5) = 120, calls = 5 (5, 4, 3, 2, 1)
            assertEq("120,5", result, sprintf("final class recursive self call %s", mode));
        }

        # Test 2: Final class with multiple self calls in one method
        string multi_self_code = "%new-style
%strict-args
%require-types
%disable-warning non-existent-method-call

final class MyCounter {
    public {
        int count = 0;
    }

    int inc() {
        return ++count;
    }

    int getValue() {
        return count;
    }

    # Multiple self calls - all should be devirtualized
    int compute(int a, int b) {
        return self.inc() + a + self.inc() + b + self.getValue();
    }
}

MyCounter c();
int result = c.compute(10, 20);
printf(\"%d\\n\", result);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(multi_self_code, mode));
            # inc() returns 1, a=10, inc() returns 2, b=20, get() returns 2
            # Total: 1 + 10 + 2 + 20 + 2 = 35
            assertEq("35", result, sprintf("final class multiple self calls %s", mode));
        }

        # Test 3: Final class with exception in self call
        string exception_code = "%new-style
%strict-args
%require-types
%disable-warning non-existent-method-call

final class SafeDiv {
    int divide(int a, int b) {
        if (b == 0) {
            throw \"DIVISION-ERROR\", \"cannot divide by zero\";
        }
        return a / b;
    }

    int safeDivide(int a, int b) {
        try {
            return self.divide(a, b);
        } catch (hash<auto> ex) {
            return -1;
        }
    }
}

SafeDiv s();
printf(\"%d,%d\\n\", s.safeDivide(10, 2), s.safeDivide(10, 0));
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(exception_code, mode));
            assertEq("5,-1", result, sprintf("final class self call with exception %s", mode));
        }

        # Test 4: Verify polymorphic calls still work correctly (NOT devirtualized)
        string polymorphic_code = "%new-style
%strict-args
%require-types
%disable-warning non-existent-method-call

class Animal {
    string speak() {
        return \"...\";
    }
}

class Dog inherits Animal {
    string speak() {
        return \"woof\";
    }
}

class Cat inherits Animal {
    string speak() {
        return \"meow\";
    }
}

list<Animal> animals = (new Dog(), new Cat(), new Animal());
list<string> sounds = ();
foreach Animal a in (animals) {
    sounds += a.speak();
}
printf(\"%s\\n\", sounds.join(\",\"));
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(polymorphic_code, mode));
            assertEq("woof,meow,...", result, sprintf("polymorphic calls (no devirt) %s", mode));
        }
    }

    testStringBuilderOptimization() {
        # Test string builder optimization - chains of string concatenation
        # should use StringConcat opcode for efficiency

        # Test 1: Simple 3-string chain
        string simple_chain = "%modern
string a = \"hello\";
string b = \" \";
string c = \"world\";
string result = a + b + c;
printf(\"%s\\n\", result);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(simple_chain, mode));
            assertEq("hello world", result, sprintf("simple 3-string chain %s", mode));
        }

        # Test 2: Longer 5-string chain
        string long_chain = "%modern
string a = \"a\";
string b = \"b\";
string c = \"c\";
string d = \"d\";
string e = \"e\";
string result = a + b + c + d + e;
printf(\"%s\\n\", result);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(long_chain, mode));
            assertEq("abcde", result, sprintf("5-string chain %s", mode));
        }

        # Test 3: Chain with string literals
        string literal_chain = "%modern
string prefix = \"Hello, \";
string result = prefix + \"my \" + \"name \" + \"is \" + \"Qore\";
printf(\"%s\\n\", result);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(literal_chain, mode));
            assertEq("Hello, my name is Qore", result, sprintf("chain with literals %s", mode));
        }

        # Test 4: Chain in function
        string func_chain = "%modern
string sub build_message(string name, string action) {
    return \"User \" + name + \" has \" + action + \" successfully\";
}
printf(\"%s\\n\", build_message(\"Alice\", \"logged in\"));
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(func_chain, mode));
            assertEq("User Alice has logged in successfully", result, sprintf("chain in function %s", mode));
        }

        # Test 5: Nested chains (verify associativity)
        string nested_chain = "%modern
string a = \"1\";
string b = \"2\";
string c = \"3\";
string d = \"4\";
# (a + b) + (c + d) - both sides are chains
string left = a + b;
string right = c + d;
string result = left + right;
printf(\"%s\\n\", result);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(nested_chain, mode));
            assertEq("1234", result, sprintf("nested chains %s", mode));
        }

        # Test 6: Chain inside try block (tests invoke path)
        string try_chain = "%modern
string result;
try {
    string a = \"try\";
    string b = \" \";
    string c = \"block\";
    string d = \" \";
    string e = \"test\";
    result = a + b + c + d + e;
} catch (hash<auto> ex) {
    result = \"error\";
}
printf(\"%s\\n\", result);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(try_chain, mode));
            assertEq("try block test", result, sprintf("chain in try block %s", mode));
        }
    }

    testNativeMapWithMethodCall() {
        # Test native IR lowering for map with method calls (non-optimized patterns)
        # These patterns use the new native loop with implicit argument context

        # Test map with toString() method call
        string map_tostring = "%modern
list<int> input = (1, 2, 3);
list<string> result = (map $1.toString(), input);
printf(\"%y\\n\", result);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(map_tostring, mode));
            assertEq("[\"1\", \"2\", \"3\"]", result, sprintf("map toString %s", mode));
        }

        # Test map with $# (element index)
        string map_with_index = "%modern
list<int> input = (10, 20, 30);
list<int> result = (map $1 + $#, input);
printf(\"%y\\n\", result);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(map_with_index, mode));
            assertEq("[10, 21, 32]", result, sprintf("map with index %s", mode));
        }

        # Test map with function call
        string map_strlen = "%modern
list<string> input = (\"a\", \"bb\", \"ccc\");
list<int> result = (map $1.length(), input);
printf(\"%y\\n\", result);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(map_strlen, mode));
            assertEq("[1, 2, 3]", result, sprintf("map length %s", mode));
        }
    }

