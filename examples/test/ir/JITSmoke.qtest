    testCallReferences() {
        # Function call reference
        string code = "%modern
int sub double_it(int x) { return x * 2; }
code ref = \\double_it();
printf(\"%d\\n\", ref(21));
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("42", result,
                    sprintf("function call ref %s", mode));
        }

        # Method call reference
        code = "%modern
class MyCalc {
    int mul(int x, int y) { return x * y; }
}
MyCalc c();
code ref = \\c.mul();
printf(\"%d\\n\", ref(6, 7));
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("42", result,
                    sprintf("method call ref %s", mode));
        }

        # Call ref in try/catch
        code = "%modern
int sub add(int a, int b) { return a + b; }
code ref;
try {
    ref = \\add();
} catch (hash<auto> ex) {
    ref = int sub(int a, int b) { return -1; };
}
printf(\"%d\\n\", ref(20, 22));
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("42", result,
                    sprintf("call ref try/catch %s", mode));
        }
    }

    testParseReferences() {
        # Basic parse reference
