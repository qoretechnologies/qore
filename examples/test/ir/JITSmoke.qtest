    testOnBlockExitHandlers() {
        # Test on_exit (unconditional - runs on both normal and exception exit)
        string on_exit_test = "%modern
list<string> log = ();
sub test() {
    on_exit log += \"exit\";
    log += \"body\";
}
test();
printf(\"%y\\n\", log);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(on_exit_test, mode));
            assertEq("[\"body\", \"exit\"]", result, sprintf("on_exit %s", mode));
        }

        # Test on_success (runs only on normal exit, not on exception)
        string on_success_test = "%modern
list<string> log = ();
sub test() {
    on_success log += \"success\";
    on_error log += \"error\";
    log += \"body\";
}
test();
printf(\"%y\\n\", log);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(on_success_test, mode));
            assertEq("[\"body\", \"success\"]", result, sprintf("on_success %s", mode));
        }

        # Test on_error (runs only when exception occurs)
        string on_error_test = "%modern
list<string> log = ();
sub test() {
    on_success log += \"success\";
    on_error log += \"error\";
    log += \"body\";
    throw \"TEST\", \"test exception\";
}
try {
    test();
} catch (hash<ExceptionInfo> ex) {
    log += \"caught\";
}
printf(\"%y\\n\", log);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(on_error_test, mode));
            assertEq("[\"body\", \"error\", \"caught\"]", result, sprintf("on_error %s", mode));
        }

        # Test nested scopes with on_error
        string nested_error_test = "%modern
list<string> log = ();
sub inner() {
    on_error log += \"inner_error\";
    throw \"TEST\", \"inner exception\";
}
sub outer() {
    on_error log += \"outer_error\";
    inner();
}
try {
    outer();
} catch (hash<ExceptionInfo> ex) {
    log += \"caught\";
}
printf(\"%y\\n\", log);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(nested_error_test, mode));
            assertEq("[\"inner_error\", \"outer_error\", \"caught\"]", result, sprintf("nested on_error %s", mode));
        }
    }

    testOnBlockExitTopLevelLocalUpdate() {
        # Test on_exit at top level modifies local variable correctly.
        # Regression: on_exit handlers execute through the AST path, which modifies
        # the thread-local variable stack, but IR/JIT cached the old value.
        string toplevel_exit = "%modern
int x = 0;
{
    on_exit x = 99;
    x = 1;
}
printf(\"%d\\n\", x);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(toplevel_exit, mode));
            assertEq("99", result, sprintf("toplevel on_exit local update %s", mode));
        }

        # Test on_exit in function modifies local and returns updated value
        string func_exit = "%modern
int sub test_on_exit() {
    int x = 0;
    {
        on_exit x = 42;
        x = 1;
    }
    return x;
}
printf(\"%d\\n\", test_on_exit());
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(func_exit, mode));
            assertEq("42", result, sprintf("func on_exit local update %s", mode));
        }

        # Test on_success modifies local variable
        string success_update = "%modern
int x = 0;
{
    on_success x += 100;
    x = 5;
}
printf(\"%d\\n\", x);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(success_update, mode));
            assertEq("105", result, sprintf("on_success local update %s", mode));
        }

        # Test on_exit with multiple variables
        string multi_var = "%modern
int a = 0;
int b = 0;
{
    on_exit { a = 10; b = 20; }
    a = 1;
    b = 2;
}
printf(\"%d %d\\n\", a, b);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(multi_var, mode));
            assertEq("10 20", result, sprintf("on_exit multi-var update %s", mode));
        }
    }

    testInvokeMethodDirect() {
        # Test InvokeMethodDirect opcode - devirtualized method calls in try/catch blocks
        # This tests the optimization path where final class method calls in try/catch
        # use the direct InvokeMethodDirect opcode instead of falling back to AST evaluation

        # Test 1: Multiple successive self method calls in try/catch (success path)
        string success_test = "%new-style
%strict-args
%require-types
%disable-warning non-existent-method-call

final class MethodCounter {
    public {
        int count = 0;
    }

    int increment() {
        return ++count;
    }

    int run() {
        int result;
        try {
            result = self.increment();
            result += self.increment();
            result += self.increment();
        } catch (hash<auto> ex) {
            result = -1;
        }
        return result;
    }
}

MethodCounter c();
printf(\"%d,%d\\n\", c.run(), c.count);
";
        foreach string mode in ("ast", "ir", "jit") {
            string out = trim(runScript(success_test, mode));
            # increment returns 1, 2, 3; sum = 6; count = 3
            assertEq("6,3", out, sprintf("invoke.method.direct success path %s", mode));
        }

        # Test 2: Exception in self method call routes to catch block correctly
        string exception_test = "%new-style
%strict-args
%require-types
%disable-warning non-existent-method-call

final class Thrower {
    nothing doThrow() {
        throw \"TEST\", \"test error\";
    }

    string run() {
        string result;
        try {
            self.doThrow();
            result = \"no-catch\";
        } catch (hash<auto> ex) {
            result = \"caught:\" + ex.err;
        }
        return result;
    }
}

Thrower t();
printf(\"%s\\n\", t.run());
";
        foreach string mode in ("ast", "ir", "jit") {
            string out = trim(runScript(exception_test, mode));
            assertEq("caught:TEST", out, sprintf("invoke.method.direct exception path %s", mode));
        }

        # Test 3: Mix of successful calls and exception - verify state consistency
        string mixed_test = "%new-style
%strict-args
%require-types
%disable-warning non-existent-method-call

final class MixedOps {
    public {
        int count = 0;
    }

    int inc() {
        return ++count;
    }

    nothing maybeThrow(int limit) {
        if (count >= limit) {
            throw \"LIMIT\", \"limit reached\";
        }
    }

    int run() {
        int result = 0;
        try {
            result += self.inc();      # count=1, result=1
            self.maybeThrow(5);        # no throw
            result += self.inc();      # count=2, result=3
            self.maybeThrow(5);        # no throw
            result += self.inc();      # count=3, result=6
            self.maybeThrow(3);        # throws!
            result += self.inc();      # not reached
        } catch (hash<auto> ex) {
            result = -result;          # negate to indicate exception path
        }
        return result;
    }
}

MixedOps m();
printf(\"%d,%d\\n\", m.run(), m.count);
";
        foreach string mode in ("ast", "ir", "jit") {
            string out = trim(runScript(mixed_test, mode));
            # result was 6 before throw, negated to -6; count stays at 3
            assertEq("-6,3", out, sprintf("invoke.method.direct mixed path %s", mode));
        }

        # Test 4: Nested try/catch with devirtualized self method calls
        string nested_test = "%new-style
%strict-args
%require-types
%disable-warning non-existent-method-call

final class NestedOps {
    int level1(int x) {
        if (x <= 0) {
            throw \"NEGATIVE\", \"x is non-positive\";
        }
        return x * 2;
    }

    int level2(int x) {
        int result;
        try {
            result = self.level1(x);
        } catch (hash<auto> ex) {
            result = -1;
        }
        return result;
    }

    list<int> run() {
        list<int> results = ();
        try {
            results += self.level2(5);   # returns 10
            results += self.level2(0);   # inner catch, returns -1
            results += self.level2(3);   # returns 6
        } catch (hash<auto> ex) {
            results += -100;  # not reached
        }
        return results;
    }
}

NestedOps n();
printf(\"%y\\n\", n.run());
";
        foreach string mode in ("ast", "ir", "jit") {
            string out = trim(runScript(nested_test, mode));
            assertEq("[10, -1, 6]", out, sprintf("invoke.method.direct nested try/catch %s", mode));
        }
    }

    testBigIntLoopCorrectness() {
        # Test big int (>48-bit) values in a loop — exercises boxValue cleanup
        # in loops. Before the fix, the cleanup alloca was overwritten each
        # iteration without decref'ing the previous QoreBigIntNode.
        string code = "%modern
int big = 9223372036854775800;
for (int i = 0; i < 100; i++) {
    big += 1;
    big -= 1;
}
printf(\"%d\\n\", big);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("9223372036854775800", result,
                    sprintf("big int loop correctness %s", mode));
        }
    }

    testInvokeResultInLoop() {
        # Test Invoke results in a loop — exercises trackResultForCleanup in
        # loops. Before the fix, the cleanup alloca was overwritten each
        # iteration without decref'ing the previous result.
        string code = "%modern
list<string> results = ();
for (int i = 0; i < 50; i++) {
    string s = sprintf(\"%d\", i);
    if (i == 0 || i == 49) {
        results += s;
    }
}
printf(\"%y\\n\", results);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("[\"0\", \"49\"]", result,
                    sprintf("invoke result in loop %s", mode));
        }
    }

    testBigIntBoxingInline() {
        # Test that boxIntInline handles both INT48 and big int paths correctly
        string code = "%modern
# INT48 range boundary values
int a = 140737488355327;    # INT48_MAX = (1 << 47) - 1
int b = -140737488355328;   # INT48_MIN = -(1 << 47)
# Big int values outside INT48 range
int c = 140737488355328;    # INT48_MAX + 1
int d = -140737488355329;   # INT48_MIN - 1
# Arithmetic that crosses the INT48 boundary
int e = a + 1;              # INT48_MAX + 1 -> big int
int f = b - 1;              # INT48_MIN - 1 -> big int
printf(\"%d,%d,%d,%d,%d,%d\\n\", a, b, c, d, e, f);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("140737488355327,-140737488355328,140737488355328,"
                    "-140737488355329,140737488355328,-140737488355329", result,
                    sprintf("big int boxing inline %s", mode));
        }
    }

    testLValueCompoundAssignNothing() {
        # Test NOTHING += value fast path (AddAssignLValue)
        # NOTHING += int stores directly, NOTHING += hash/list performs type conversion
        string code = "%modern
auto a;     # NOTHING
a += 42;    # NOTHING -> 42 via lvalue_store
auto b;     # NOTHING
b += {\"x\": 1};  # NOTHING -> hash<auto>
auto c;     # NOTHING
c += (1, 2, 3);  # NOTHING -> list<auto>
printf(\"%d,%s,%s\\n\", a, b{\"x\"}, c[1]);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("42,1,2", result,
                    sprintf("lvalue compound assign NOTHING %s", mode));
        }
    }

    testLValueCompoundAssignInt() {
        # Test INT48+INT48 fast path for lvalue compound assignments
        string code = "%modern
auto a = 10;
a += 5;         # int fast path
auto b = 20;
b -= 3;         # int fast path
auto c = 4;
c *= 3;         # int fast path
printf(\"%d,%d,%d\\n\", a, b, c);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("15,17,12", result,
                    sprintf("lvalue compound assign int fast path %s", mode));
        }
    }

    testLValueCompoundAssignFloat() {
        # Test float+float fast path for lvalue compound assignments
