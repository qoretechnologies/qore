    testReferenceWriteThrough() {
        # Write-through updates target variable
        string code = "%modern
int val = 10;
reference<int> ref = \\val;
ref = 42;
printf(\"val:%d ref:%d\\n\", val, ref);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("val:42 ref:42", result,
                    sprintf("reference write-through %s", mode));
        }

        # Reference write-through in loop
        code = "%modern
int total = 0;
reference<int> ref = \\total;
for (int i = 0; i < 5; ++i) {
    ref += i;
}
printf(\"%d\\n\", total);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("10", result,
                    sprintf("reference write-through loop %s", mode));
        }

        # Multiple references
        code = "%modern
int a = 1;
int b = 2;
reference<int> r1 = \\a;
reference<int> r2 = \\b;
r1 = 10;
r2 = 20;
printf(\"%d:%d\\n\", a, b);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("10:20", result,
                    sprintf("multiple references %s", mode));
        }
    }

    testNothingInputIterators() {
        # map with NOTHING → NOTHING
        string code = "%modern
%disable-warning invalid-operation
auto result = map $1 * 2, NOTHING;
printf(\"%s\\n\", exists result ? \"EXISTS\" : \"NOTHING\");
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("NOTHING", result,
                    sprintf("map NOTHING %s", mode));
        }

        # select with NOTHING → NOTHING
        code = "%modern
%disable-warning invalid-operation
auto result = (select NOTHING, $1 > 0);
printf(\"%s\\n\", exists result ? \"EXISTS\" : \"NOTHING\");
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("NOTHING", result,
                    sprintf("select NOTHING %s", mode));
        }

        # foldl with NOTHING → NOTHING
        code = "%modern
%disable-warning invalid-operation
*int result = (foldl $1 + $2, NOTHING);
printf(\"%s\\n\", exists result ? string(result) : \"NOTHING\");
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("NOTHING", result,
                    sprintf("foldl NOTHING %s", mode));
        }

        # map with single element
        code = "%modern
list<int> l = (42,);
list<int> result = map $1 * 2, l;
printf(\"%d\\n\", result[0]);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("84", result,
                    sprintf("map single element %s", mode));
        }
    }

    testVarRefNewObjectSplit() {
        # Basic VarRefNewObjectNode: Foo f(args) syntax
        string code = "%modern
class MyVrnPoint {
    public { int x; int y; }
    constructor(int n_x, int n_y) { x = n_x; y = n_y; }
    int getX() { return x; }
    int getY() { return y; }
}
MyVrnPoint p(10, 20);
printf(\"%d:%d\\n\", p.getX(), p.getY());
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("10:20", result,
                    sprintf("VarRefNewObject basic %s", mode));
        }

        # VarRefNewObjectNode in try/catch (invoke path)
        code = "%modern
class MyVrnObj {
    public { string name; }
    constructor(string n) { name = n; }
    string getName() { return name; }
}
string result;
try {
    MyVrnObj obj(\"hello\");
    result = obj.getName();
} catch (hash<auto> ex) {
    result = \"error\";
}
printf(\"%s\\n\", result);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("hello", result,
                    sprintf("VarRefNewObject invoke %s", mode));
        }

        # VarRefNewObjectNode with method calls on result
        code = "%modern
class MyVrnCounter {
    public { int count = 0; }
    constructor(int initial) { count = initial; }
    MyVrnCounter increment() { count++; return self; }
    int getCount() { return count; }
}
MyVrnCounter c(5);
c.increment().increment().increment();
printf(\"%d\\n\", c.getCount());
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("8", result,
                    sprintf("VarRefNewObject chain %s", mode));
        }
    }

    testVrnTypedContainers() {
        # VarRefNewObjectNode hashdecl construction (VRN_HASHDECL)
        string code = "%modern
hashdecl MyVrnPoint {
    int x;
    int y;
}
hash<MyVrnPoint> p({\"x\": 5, \"y\": 7});
printf(\"%d\\n\", p.x + p.y);
";
