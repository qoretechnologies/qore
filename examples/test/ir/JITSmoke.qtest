            string result = trim(runScript(code, mode));
            assertEq("12", result,
                    sprintf("VRN hashdecl construction %s", mode));
        }

        # VarRefNewObjectNode hashdecl in try/catch (invoke path)
        code = "%modern
hashdecl MyVrnData {
    string name;
    int value;
}
try {
    hash<MyVrnData> d({\"name\": \"test\", \"value\": 42});
    printf(\"%s:%d\\n\", d.name, d.value);
} catch (hash<ExceptionInfo> ex) {
    printf(\"ERROR\\n\");
}
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("test:42", result,
                    sprintf("VRN hashdecl invoke %s", mode));
        }

        # VarRefNewObjectNode complex hash construction (VRN_COMPLEXHASH)
        code = "%modern
hash<string, int> h({\"a\": 10, \"b\": 20});
printf(\"%d\\n\", h.a + h.b);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("30", result,
                    sprintf("VRN complex hash construction %s", mode));
        }

        # VarRefNewObjectNode complex list construction (VRN_COMPLEXLIST)
        code = "%modern
list<int> l(1, 2, 3, 4);
