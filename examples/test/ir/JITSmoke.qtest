";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("42", result,
                    sprintf("new object no-arg %s", mode));
        }
    }

    testRuntimeConstants() {
        # Basic constant usage
        string code = "%modern
const MY_CONST = 42;
const MY_STR = \"hello\";
printf(\"%d:%s\\n\", MY_CONST, MY_STR);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("42:hello", result,
                    sprintf("runtime constants basic %s", mode));
        }

        # Constant in try/catch (invoke path)
        code = "%modern
const TIMEOUT = 30;
int sub get_timeout() {
    try {
        return TIMEOUT * 2;
    } catch (hash<auto> ex) {
        return -1;
    }
}
printf(\"%d\\n\", get_timeout());
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("60", result,
                    sprintf("runtime constants invoke %s", mode));
        }

        # Constant in computation
        code = "%modern
const BASE = 100;
const FACTOR = 3;
int result = 0;
for (int i = 0; i < 5; ++i) {
    result += BASE + i * FACTOR;
}
printf(\"%d\\n\", result);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("530", result,
                    sprintf("runtime constants computation %s", mode));
        }
    }

    testClosureCreation() {
        # Basic closure
        string code = "%modern
code adder = int sub(int x) { return x + 10; };
printf(\"%d\\n\", adder(32));
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("42", result,
                    sprintf("closure basic %s", mode));
        }

        # Closure with capture
        code = "%modern
int base = 100;
code add_base = int sub(int x) { return x + base; };
printf(\"%d\\n\", add_base(42));
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("142", result,
                    sprintf("closure capture %s", mode));
        }

        # Closure in method context
        code = "%modern
class MyAdder {
    private { int offset; }
    constructor(int o) { offset = o; }
    code getAdder() {
        return int sub(int x) { return x + offset; };
    }
}
MyAdder a(10);
code fn = a.getAdder();
printf(\"%d\\n\", fn(32));
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("42", result,
                    sprintf("closure method context %s", mode));
        }

        # Closure in try/catch
        code = "%modern
code fn;
try {
    fn = int sub(int x) { return x * 2; };
} catch (hash<auto> ex) {
    fn = int sub(int x) { return -1; };
}
printf(\"%d\\n\", fn(21));
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("42", result,
                    sprintf("closure try/catch %s", mode));
        }
    }

    testFoldrNative() {
        # Basic foldr sum (same as foldl for commutative ops)
        string code = "%modern
list<int> l = (1, 2, 3, 4, 5);
int result = (foldr $1 + $2, l);
printf(\"%d\\n\", result);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("15", result,
                    sprintf("foldr sum %s", mode));
        }

        # foldr string concatenation (processes right to left)
        code = "%modern
list<string> l = (\"a\", \"b\", \"c\");
string result = (foldr $1 + $2, l);
printf(\"%s\\n\", result);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("cba", result,
                    sprintf("foldr string concat %s", mode));
        }

        # foldr with NOTHING input
        code = "%modern
%disable-warning invalid-operation
*int result = (foldr $1 + $2, NOTHING);
printf(\"%s\\n\", exists result ? string(result) : \"NOTHING\");
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("NOTHING", result,
                    sprintf("foldr NOTHING input %s", mode));
        }
    }

