    testHashMapOverTypedHashList() {
        # map {} over list<hash<auto>> — direct-index optimization with hash key access
        string code = "%modern
list<hash<auto>> people = ({\"name\": \"alice\", \"age\": 30}, {\"name\": \"bob\", \"age\": 25});
hash<auto> result = map {$1.name: $1.age}, people;
printf(\"%d:%d\\n\", result.alice, result.bob);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("30:25", result,
                    sprintf("hash map over typed hash list %s", mode));
        }

        # map {} over list<hash<auto>> with value computation
        code = "%modern
list<hash<auto>> items = ({\"k\": \"x\", \"v\": 10}, {\"k\": \"y\", \"v\": 20}, {\"k\": \"z\", \"v\": 30});
hash<auto> result = map {$1.k: $1.v * 2}, items;
printf(\"%d:%d:%d\\n\", result.x, result.y, result.z);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("20:40:60", result,
                    sprintf("hash map over typed hash list computation %s", mode));
        }

        # empty list<hash<auto>> — should return empty hash
        code = "%modern
list<hash<auto>> empty = ();
hash<auto> result = map {$1.name: $1.age}, empty;
printf(\"%d\\n\", result.size());
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("0", result,
                    sprintf("hash map over empty typed hash list %s", mode));
        }

        # map {} over list<hash<auto>> with select
        code = "%modern
list<hash<auto>> people = ({\"name\": \"alice\", \"age\": 30}, {\"name\": \"bob\", \"age\": 25}, {\"name\": \"charlie\", \"age\": 35});
hash<auto> result = map {$1.name: $1.age}, people, $1.age > 28;
printf(\"%d:%d\\n\", result.size(), result.alice + result.charlie);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("2:65", result,
                    sprintf("hash map+select over typed hash list %s", mode));
        }
    }

    testMapTupleOverTypedHashList() {
