        }
    }

    testLValueCompoundAssignLoop() {
        # Test compound assign in a tight loop (stress test for refcounting/cleanup)
        string code = "%modern
auto sum = 0;
for (int i = 1; i <= 100; i++) {
    sum += i;
}
auto prod = 1;
for (int j = 1; j <= 10; j++) {
    prod *= j;
}
printf(\"%d,%d\\n\", sum, prod);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("5050,3628800", result,
                    sprintf("lvalue compound assign loop %s", mode));
        }
    }

    testLValueCompoundAssignBitwise() {
        # Test bitwise compound assign on lvalues (int-only fast path)
        string code = "%modern
auto a = 0xFF;
a &= 0x0F;      # AND fast path
auto b = 0x0F;
b |= 0xF0;      # OR fast path
auto c = 0xFF;
c ^= 0xAA;      # XOR fast path
auto d = 1;
d <<= 8;         # SHL fast path
auto e = 256;
e >>= 4;         # SHR fast path
printf(\"%d,%d,%d,%d,%d\\n\", a, b, c, d, e);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("15,255,85,256,16", result,
                    sprintf("lvalue compound assign bitwise %s", mode));
        }
    }

    testLValueCompoundAssignDivMod() {
        # Test div/mod lvalue ops (always slow path, no inline fast path)
        string code = "%modern
auto a = 100;
a /= 5;
auto b = 17;
b %= 5;
printf(\"%d,%d\\n\", a, b);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("20,2", result,
                    sprintf("lvalue compound assign div/mod slow path %s", mode));
        }
    }

    testRangeLValueDelegate() {
        # Range lvalue operations (list[0..2] = x) are parse errors - the parser rejects them.
        # The isRangeLValue() checks in IR lowering are defensive guards that delegate to AST
        # if somehow reached. We verify non-range list index operations work correctly across
        # all modes (regression test to ensure the defensive code changes don't break anything).

        # Test list index assignment (non-range) still works in all modes
        string code = "%modern
list<auto> l = (1, 2, 3, 4, 5);
l[2] = 30;
printf(\"%y\\n\", l);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("[1, 2, 30, 4, 5]", result,
                    sprintf("list index assignment %s", mode));
        }

        # Test list index compound assignment
        code = "%modern
list<auto> l = (10, 20, 30, 40, 50);
l[1] += 5;
l[3] -= 10;
printf(\"%d,%d\\n\", l[1], l[3]);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("25,30", result,
                    sprintf("list index compound assign %s", mode));
        }

        # Test list index increment/decrement
        code = "%modern
list<auto> l = (10, 20, 30);
++l[0];
l[2]--;
printf(\"%d,%d\\n\", l[0], l[2]);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("11,29", result,
                    sprintf("list index inc/dec %s", mode));
        }

        # Test list range read works in all modes
        code = "%modern
list<auto> l = (1, 2, 3, 4, 5);
list<auto> sub_list = l[1..3];
printf(\"%y\\n\", sub_list);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("[2, 3, 4]", result,
                    sprintf("range read %s", mode));
        }

        # Test string range read
        code = "%modern
string s = \"hello world\";
string substr = s[0..4];
printf(\"%s\\n\", substr);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("hello", result,
                    sprintf("string range read %s", mode));
        }
    }

    testSelfMemberAccess() {
        # Test basic self.x member access in a class
        string code = "%modern
class Foo {
    public {
        int x;
        string name;
    }
    constructor(int n_x, string n_name) {
        x = n_x;
        name = n_name;
    }
    int getX() { return self.x; }
    string getName() { return self.name; }
    string getInfo() { return sprintf(\"%s:%d\", self.name, self.x); }
}
Foo f(42, \"test\");
printf(\"%d,%s,%s\\n\", f.getX(), f.getName(), f.getInfo());
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("42,test,test:42", result,
                    sprintf("self member access %s", mode));
        }

        # Test self member access in try/catch (invoke path)
        code = "%modern
class Bar {
    public {
        int val;
    }
    constructor(int v) { val = v; }
    int getVal() {
        try {
            return self.val;
        } catch (hash<auto> ex) {
            return -1;
        }
    }
}
Bar b(99);
printf(\"%d\\n\", b.getVal());
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("99", result,
                    sprintf("self member access invoke path %s", mode));
        }

        # Test self member access with multiple members and computation
        code = "%modern
class Point {
    public {
        float x;
        float y;
    }
    constructor(float n_x, float n_y) { x = n_x; y = n_y; }
    float distFromOrigin() {
        return (self.x * self.x + self.y * self.y);
    }
}
Point p(3.0, 4.0);
printf(\"%.1f\\n\", p.distFromOrigin());
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("25.0", result,
                    sprintf("self member computation %s", mode));
        }
    }

    testStaticClassVarAccess() {
        # Test basic static class variable read
        string code = "%modern
class MyCounter {
    public {
        static int count = 0;
    }
    static int getCount() { return MyCounter::count; }
    static nothing increment() { MyCounter::count++; }
}
MyCounter::increment();
MyCounter::increment();
MyCounter::increment();
printf(\"%d\\n\", MyCounter::getCount());
";
