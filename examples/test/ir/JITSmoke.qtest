    testMapSelectFused() {
        # Basic map+select
        string code = "%modern
list<int> l = (1, 2, 3, 4, 5, 6);
list<int> result = (map $1 * 10, l, $1 > 3);
printf(\"%s\\n\", (foldl $1 + \",\" + $2, (map string($1), result)));
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("40,50,60", result,
                    sprintf("map+select basic %s", mode));
        }

        # map+select with NOTHING input
        code = "%modern
%disable-warning invalid-operation
auto result = (map $1 * 2, NOTHING, $1 > 0);
printf(\"%s\\n\", exists result ? \"EXISTS\" : \"NOTHING\");
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("NOTHING", result,
                    sprintf("map+select NOTHING input %s", mode));
        }

        # map+select with $# (element index)
        code = "%modern
list<string> names = (\"alice\", \"bob\", \"charlie\");
list<string> result = (map sprintf(\"%d:%s\", $#, $1), names, $# > 0);
printf(\"%s\\n\", (foldl $1 + \",\" + $2, result));
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("1:bob,2:charlie", result,
                    sprintf("map+select with index %s", mode));
        }
    }

    testHashMapNative() {
        # Basic hash map
        string code = "%modern
list<string> names = (\"a\", \"b\", \"c\");
hash<auto> h = map {$1: $# + 1}, names;
printf(\"%d:%d:%d\\n\", h.a, h.b, h.c);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("1:2:3", result,
                    sprintf("hash map basic %s", mode));
        }

        # Hash map with NOTHING input
        code = "%modern
%disable-warning invalid-operation
auto result = map {$1: $1}, NOTHING;
printf(\"%s\\n\", exists result ? \"EXISTS\" : \"NOTHING\");
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("NOTHING", result,
                    sprintf("hash map NOTHING input %s", mode));
        }

        # Hash map with computation
        code = "%modern
list<int> vals = (10, 20, 30);
hash<auto> h = map {string($1): $1 * 2}, vals;
int total = 0;
map (total += $1.value), h.pairIterator();
printf(\"%d\\n\", total);
";
        foreach string mode in ("ast", "ir", "jit") {
            string result = trim(runScript(code, mode));
            assertEq("120", result,
                    sprintf("hash map computation %s", mode));
        }
    }

