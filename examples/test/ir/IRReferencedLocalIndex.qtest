#!/usr/bin/env qore
# Copyright (c) 2026 Qore Technologies, s.r.o.
# SPDX-License-Identifier: MIT
%modern
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil
%exec-class ReferencedLocalIndexTest

#! Tests the '[]' operator, slices and member reads on locals whose reference has been taken
/** A function that takes a reference to a local reads it with exception edges, and '[]' on a hash read that way
    raised INVALID-MEMBER for a hashdecl hash in IR, JIT and tiered modes (a key read) instead of giving no value as
    the interpreter does.  Every mode and compiled executable must match the interpreter.
*/
class ReferencedLocalIndexTest inherits QUnit::Test {
    private {
        string qore = realpath(ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0]);
        string libdir = realpath(ENV.QORE_LIBDIR ?? dirname(qore));
        string qcc = ENV.QCC ?? libdir + "/qcc";
    }

    constructor() : Test("referenced local index", "1.0", \ARGV) {
        addTestCase("[] slices and member reads on referenced locals", \check());
        set_return_value(main());
    }

    private static string quote(string value) {
        return "'" + replace(value, "'", "'\"'\"'") + "'";
    }

    private string run(list<string> args, string prefix = "") {
        int status;
        string output = backquote(prefix + "LD_LIBRARY_PATH=" + quote(libdir)
            + " DYLD_LIBRARY_PATH=" + quote(libdir) + " "
            + (map quote($1), args).join(" ") + " 2>&1", \status);
        assertEq(0, status, output);
        return output;
    }

    private check() {
        string source = get_script_dir() + "/IRReferencedLocalIndex.qr";
        string expected = run((qore, "--exec-mode=ast", source));
        assertRegex("ir-referenced-local-index: ok\n$", expected);
        # '[]' on a hash gives no value; a member read of an undeclared hashdecl key raises
        assertRegex("\nhash ti\\[0\\]: null\n", expected);
        assertRegex("\nlist \\[0\\]\\[0\\]: null\n", expected);
        assertRegex("\nhash ti.unknown: INVALID-MEMBER: ", expected);
        foreach string mode in (("ir", "jit", "tiered")) {
            assertEq(expected, run((qore, "--exec-mode=" + mode, source),
                "QORE_JIT_SYNC_COMPILE=1 QORE_IR_THRESHOLD=1 QORE_JIT_THRESHOLD=1 "), mode);
        }
        TmpDir dir("qore-referenced-local-index-");
        foreach string prefix in (("", "QORE_AOT_EH=1 ")) {
            foreach string level in (("-O0", "-O3")) {
                string executable = dir.path + "/fixture";
                run((qcc, level, "--strip-source", "-o", executable, source), prefix);
                assertEq(expected, run((executable,)), prefix + level);
            }
        }
    }
}
