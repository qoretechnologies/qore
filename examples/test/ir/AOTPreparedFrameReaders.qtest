%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../../../qlib"
%requires QUnit
%requires FsUtil
%exec-class PreparedFrameReadersTest

class PreparedFrameReadersTest inherits QUnit::Test {
    private {
        string qore = realpath(ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0]);
        string libdir = realpath(ENV.QORE_LIBDIR ?? dirname(qore));
        string qcc = ENV.QCC ?? libdir + "/qcc";
        const Expected = "prepared-frame-readers: ok\n";
    }
    constructor() : Test("prepared frame stack readers", "1.0", \ARGV) {
        addTestCase("read frames while prepared targets hit, replace and clear", \check());
        set_return_value(main());
    }
    private static string quote(string value) {
        return "'" + replace(value, "'", "'\"'\"'") + "'";
    }
    private string run(list<string> args, string prefix = "") {
        int status;
        string output = backquote(prefix + "LD_LIBRARY_PATH=" + quote(libdir)
            + " DYLD_LIBRARY_PATH=" + quote(libdir) + " QORE_JIT_SYNC_COMPILE=1 "
            + (map quote($1), args).join(" ") + " 2>&1", \status);
        assertEq(0, status, output);
        return output;
    }
    private check() {
        string source = get_script_dir() + "/AOTPreparedFrameReaders.qr";
        foreach string mode in (("ast", "ir", "jit", "tiered")) {
            assertEq(Expected, run((qore, "--exec-mode=" + mode, source)), mode);
        }
        TmpDir dir("qore-prepared-frame-readers-");
        foreach string prefix in (("", "QORE_DISABLE_AOT_FUNCREF_PREPARED_TARGET=1 ",
                "QORE_AOT_EH=1 ", "MAKEFLAGS= QCC_JOBS=4 QCC_SPLIT_THRESHOLD=1 ")) {
            foreach string level in (("-O0", "-O3")) {
                string executable = dir.path + "/fixture";
                string ir = run((qcc, level, "--strip-source", "-o", executable, source),
                    prefix + "QORE_DUMP_LLVM_IR=1 ");
                assertEq(!prefix.startsWith("QORE_DISABLE_AOT_FUNCREF_PREPARED_TARGET"),
                    ir.find("qore_rt_try_funcref_int_int_v3") >= 0, "prepared target lowering");
                assertRegex("preparedLeafA[^\n]*funcref_typed_v2", ir, "native target A");
                assertRegex("preparedLeafB[^\n]*funcref_typed_v2", ir, "native target B");
                assertEq(Expected, run((executable,)), "AOT " + level);
                assertEq(Expected, run((executable,), "QORE_DISABLE_FUNCREF_FAST_CALL=1 "), "generic fallback");
            }
        }
    }
}
