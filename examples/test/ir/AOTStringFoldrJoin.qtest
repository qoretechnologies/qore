#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%no-child-restrictions

string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
string libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
string qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
    ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : dirname(qore_bin) + "/qcc");
if (!is_file(qcc_bin)) {
    qcc_bin = "qcc";
}

string code = "%modern

list<string> regular = (\"alpha\", \"beta\", \"gamma\");
list<string> sparse = (\"alpha\", \"beta\", \"gamma\");
delete sparse[1];
list<string> all_missing = (\"alpha\", \"beta\", \"gamma\");
delete all_missing[0];
delete all_missing[1];
delete all_missing[2];
list<string> empty = ();
list<string> singleton = (\"solo\",);
list<string> singleton_missing = (\"solo\",);
delete singleton_missing[0];

string dynamic_separator = \" / \";
string latin1 = convert_encoding(\"caf\\u00e9\", \"ISO-8859-1\");
list<string> mixed = (latin1, \"d\\u00e9j\\u00e0\");
string mixed_result = (foldr \$1 + \", \" + \$2, mixed);

string encoding_exception = \"none\";
try {
    list<string> incompatible = (\"\\u00df\", convert_encoding(\"ascii\", \"US-ASCII\"));
    encoding_exception = (foldr \$1 + \", \" + \$2, incompatible);
} catch (hash<ExceptionInfo> ex) {
    encoding_exception = ex.err;
}

auto empty_result = (foldr \$1 + \", \" + \$2, empty);
auto singleton_missing_result = (foldr \$1 + \", \" + \$2, singleton_missing);
printf(\"%s|%s|%s|%s|%s|%s|%s|%s|%s|%s\\n\",
    (foldr \$1 + \", \" + \$2, regular),
    (foldr \$1 + \", \" + \$2, sparse),
    (foldr \$1 + \", \" + \$2, all_missing),
    exists empty_result ? string(empty_result) : \"NOTHING\",
    (foldr \$1 + \", \" + \$2, singleton),
    exists singleton_missing_result ? string(singleton_missing_result) : \"NOTHING\",
    (foldr \$1 + dynamic_separator + \$2, regular),
    convert_encoding(mixed_result, \"UTF-8\"),
    mixed_result.encoding(),
    encoding_exception);
";

string script_path = "/tmp/qore-aot-string-foldr-join-" + string(getpid()) + ".qr";
File script();
script.open2(script_path, O_WRONLY | O_CREAT | O_TRUNC);
script.write(code);
script.close();

string sub runMode(string mode, string env = "") {
    return backquote(sprintf("%s LD_LIBRARY_PATH=%s %s -b --exec-mode=%s %s 2>&1",
        env, libqore_dir, qore_bin, mode, script_path));
}

string sub runAot(string suffix) {
    string exe = "/tmp/qore-aot-string-foldr-join-" + string(getpid()) + suffix;
    string compile_out = backquote(sprintf("LD_LIBRARY_PATH=%s %s --strip-debug-info -O3 -o %s %s 2>&1",
        libqore_dir, qcc_bin, exe, script_path));
    if (!is_file(exe)) {
        printf("AOT compile failed (%s):\n%s", suffix, compile_out);
        exit(2);
    }
    string result = backquote(sprintf("LD_LIBRARY_PATH=%s %s 2>&1", libqore_dir, exe));
    unlink(exe);
    return result;
}

string expected = "gamma, beta, alpha|gamma, , alpha|, , |NOTHING|solo|NOTHING|"
    + "gamma / beta / alpha|d\u00e9j\u00e0, caf\u00e9|UTF-8|ENCODING-CONVERSION-ERROR\n";
foreach string mode in (("ast", "ir", "tiered", "jit")) {
    string actual = runMode(mode);
    if (actual != expected) {
        printf("mismatch in %s\nexpected:\n%sactual:\n%s", mode, expected, actual);
        exit(2);
    }
}

string fallback = runMode("ast", "QORE_DISABLE_AST_STRING_FOLD_JOIN=1");
if (fallback != expected) {
    printf("AST fallback mismatch\nexpected:\n%sactual:\n%s", expected, fallback);
    exit(2);
}

string aot = runAot("-enabled");
if (aot != expected) {
    printf("AOT mismatch\nexpected:\n%sactual:\n%s", expected, aot);
    exit(2);
}

unlink(script_path);
