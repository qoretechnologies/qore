%exec-class DeepSeekDataProviderTest

class DeepSeekWireHandler inherits AbstractHttpRequestHandler {
    private {
        Mutex lock();
        hash<auto> request;
        *data body;
    }
    hash handleRequest(hash cx, hash hdr, *data body) {
        AutoLock al(lock);
        request = hdr;
        self.body = body;
        if (hdr.authorization != "Bearer wire-key") {
            return makeResponse(401, "{}", {"Content-Type": MimeTypeJson});
        }
        return makeResponse(200, make_json({"id": "wire", "object": "file", "choices": (),
            "created": 0, "created_at": 0, "bytes": 1, "filename": "a.png", "purpose": "user_data"}),
            {"Content-Type": MimeTypeJson});
    }
    hash<auto> getRequest() {
        AutoLock al(lock);
        return {"hdr": request, "body": body};
    }
}

class FakeDeepSeekRestClientIo inherits RestClientIo::RestClientIo {
    public {
        auto last_request;
        *hash<auto> last_headers;
        *list<hash<auto>> pages;
        int calls = 0;
        *hash<ExceptionInfo> failure;
        string last_method;
        string last_path;
        hash<auto> response_body;
    }

    constructor() : RestClientIo({"url": "https://api.deepseek.com", "token": "x"}) {
    }

    RestClient::AbstractRestClient copyWithUrl(string url) {
        return self;
    }

    hash<RestClient::RestResponseInfo> restDoRawRequest(string method, string path, *data body,
            *hash<auto> hdr, *hash<auto> info) {
        return restDoRequest(method, path, body, hdr);
    }

    hash<RestClient::RestResponseInfo> restDoRequest(string method, string path,
            auto body, *hash<auto> hdr) {
        ++calls;
        if (failure) {
            throw failure.err, failure.desc, failure.arg;
        }
        last_headers = hdr;
        last_method = method;
        last_path = path;
        last_request = body;
        return <RestClient::RestResponseInfo>{
            "body": pages ? shift pages : response_body,
        };
    }

    hash<RestClient::RestResponseInfo> restGet(string path, *hash<auto> hdr) {
        return restDoRequest("GET", path, NOTHING, hdr);
    }

    hash<RestClient::RestResponseInfo> restPost(string path, auto body,
            *hash<auto> hdr) {
        return restDoRequest("POST", path, body, hdr);
    }

    hash<RestClient::RestResponseInfo> restDel(string path, auto body,
            *hash<auto> hdr) {
        return restDoRequest("DELETE", path, body, hdr);
    }

    string getSafeUrl() {
        return "https://api.deepseek.com";
    }
}

public class DeepSeekDataProviderTest inherits QUnit::Test {
    public {
        const MyOpts = Opts + {
            "conn": "c,connection=s",
        };

        const OptionColumn = 22;
    }

    private {
        *string conn_name;
    }

    constructor() : Test("DeepSeekDataProvider Test", "1.0", \ARGV, MyOpts) {
        conn_name = m_options.conn ?? ENV.DEEPSEEK_CONNECTION;

        addTestCase("factory registered with DataProvider", \factoryTest());
        addTestCase("app registered with action catalog",   \appCatalogTest());
        addTestCase("root provider lists children",         \rootProviderTest());
        addTestCase("chat-completion provider basic shape", \chatProviderTest());
        addTestCase("chat-completion sends OpenAI-shape body, "
            "converts Unix created field", \chatRequestTest());
        addTestCase("request type schema is enforceable",   \requestSchemaTest());

        # Live test requires a real DeepSeek connection.
        # Cost: 1 token-bounded deepseek-v4-flash request (~$0.0001 per run).
        if (conn_name) {
            addTestCase("live: ping + chat-completion (deepseek-v4-flash)",
                \liveDeepSeekTest());
        }
        addTestCase("all actions have usable metadata and paths", \actionMetadataTest());
        addTestCase("complete action inventory survives repeated registration", \registrationQualificationTest());
        addTestCase("all locales match the root catalog and retain short-label translations", \translationTest());
        addTestCase("empty schemas and nested choices survive serialization", \schemaBoundaryTest());
        addTestCase("model and paginated file dropdowns", \referenceDataTest());
        addTestCase("all API routes and timestamp conversion", \apiRoutesTest());
        addTestCase("beta prefix and strict tool routing", \betaTest());
        addTestCase("image multipart upload and expiration", \multipartTest());
        addTestCase("invalid generation inputs fail before transport", \negativeGenerationTest());
        addTestCase("invalid file inputs and pagination fail", \negativeFilesTest());
        addTestCase("constructor injection and client isolation", \constructorTest());
        addTestCase("API failures are not replayed", \errorTest());
        addTestCase("HTTP JSON and multipart wire contracts", \wireTest());
        if (ENV.DEEPSEEK_APIKEY) {
            addTestCase("live model and balance lookup", \liveAccountTest());
        }
        if (ENV.DEEPSEEK_INFERENCE) {
            addTestCase("live chat, Responses, FIM, and image file lifecycle", \liveApiTest());
            addTestCase("live JSON, reasoning, and strict tools", \liveAdvancedTest());
            addTestCase("live empty Responses JSON Schema", \liveEmptySchemaTest());
        }
        set_return_value(main());
    }

    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-c,--connection=ARG",
            "set the DeepSeek connection name; without it (and "
            "without the DEEPSEEK_CONNECTION env var) the live test is skipped",
            OptionColumn);
    }

    private factoryTest() {
        DataProvider::AbstractDataProviderFactory f =
            DataProvider::DataProvider::getFactory("deepseek");
        assertEq("deepseek", f.getInfo().name);
        hash<DataProviderInfo> info = f.getProviderInfo();
        assertEq("deepseek", info.name);
        assertEq("DeepSeekDataProvider", info.type);
        assertTrue(info.supports_children);
    }

    private appCatalogTest() {
        hash<DataProviderAppInfo> app =
            DataProvider::DataProviderActionCatalog::getApp("DeepSeek");
        assertEq("DeepSeek", app.name);
        assertEq("deepseek", app.scheme);
        assertEq("deepseek-logo.svg", app.logo_file_name);
        assertTrue(app.logo.size() > 0);

        # filter out the framework-injected make-api-call action (covered by
        # GenericApiCallAutoInjection.qtest in RestClientDataProvider)
        list<hash<DataProviderActionInfo>> actions = select
            DataProvider::DataProviderActionCatalog::getActions("DeepSeek"),
            $1.action != AbstractDataProvider::GenericApiCallActionName;
        assertEq(9, actions.size());
        assertEq("chat-completion", actions[0].action);
        assertEq("/chat-completion", actions[0].path);
        assertEq(DPAT_API, actions[0].action_code);
        assertEq(NT_BOOLEAN, actions[0].mutates_state.typeCode(),
            "chat-completion publishes a typed mutation effect");
        assertFalse(DataProviderActionCatalog::actionMutatesState(actions[0]),
            "chat-completion is pure inference by its producer contract");
        # `messages` and `model` must be present and required
        assertTrue(exists actions[0].options.messages);
        assertTrue(actions[0].options.messages.required);
        assertTrue(exists actions[0].options.model);
        assertTrue(actions[0].options.model.required);
    }

    private rootProviderTest() {
        FakeDeepSeekRestClientIo fake();
        DeepSeekDataProvider::DeepSeekDataProvider prov(fake);
        assertEq("deepseek", prov.getName());
        # filter out the framework-injected __call__ child (covered by
        # GenericApiCallAutoInjection.qtest in RestClientDataProvider)
        list<string> children = select prov.getChildProviderNames(),
            $1 != AbstractDataProvider::GenericApiCallChildName;
        assertEq(sort(("chat-completion",) + (keys DeepSeekActions::Operations)), sort(children));
        AbstractDataProvider chat = prov.getChildProvider("chat-completion");
        assertTrue(chat instanceof
            DeepSeekDataProvider::DeepSeekChatCompletionDataProvider);
    }

    private chatProviderTest() {
        FakeDeepSeekRestClientIo fake();
        DeepSeekDataProvider::DeepSeekChatCompletionDataProvider prov(fake);
        assertEq("chat-completion", prov.getName());
        hash<DataProviderInfo> info = prov.getInfo();
        assertTrue(info.supports_request);
        AbstractDataProviderType rt = prov.getRequestType();
        AbstractDataProviderType rsp = prov.getResponseType();
        assertTrue(exists rt);
        assertTrue(exists rsp);
    }

    private chatRequestTest() {
        FakeDeepSeekRestClientIo fake();
        # response has Unix-seconds `created`; provider must convert to date
        fake.response_body = {
            "id": "test-id",
            "object": "chat.completion",
            "created": 1700000000,
            "model": "deepseek-v4-flash",
            "choices": (
                {
                    "index": 0,
                    "message": {
                        "role": "assistant",
                        "content": "Hello!",
                    },
                    "finish_reason": "stop",
                },
            ),
            "usage": {
                "prompt_tokens": 10,
                "completion_tokens": 5,
                "total_tokens": 15,
            },
        };

        DeepSeekDataProvider::DeepSeekChatCompletionDataProvider prov(fake);
        hash<auto> req = {
            "model": "deepseek-v4-flash",
            "messages": (
                {"role": "user", "content": "Hi"},
            ),
            "temperature": 0.7,
        };
        auto resp = prov.doRequest(req);

        # OpenAI-compatible POST path
        assertEq("POST", fake.last_method);
        assertEq("/v1/chat/completions", fake.last_path);
        # Request body forwarded unchanged
        assertEq("deepseek-v4-flash", fake.last_request.model);
        assertEq(0.7, fake.last_request.temperature);
        assertEq(1, fake.last_request.messages.size());
        # Response shape and converted `created`
        assertEq("test-id", resp.id);
        assertEq(1700000000, int(resp.created - 1970-01-01Z));
        assertEq(NT_DATE, resp.created.typeCode());
        assertEq("Hello!", resp.choices[0].message.content);
        assertEq(15, resp.usage.total_tokens);
    }

    private requestSchemaTest() {
        DeepSeekDataProvider::DeepSeekChatCompletionRequestDataType t();
        hash<auto> fields = t.getFields();
        assertTrue(exists fields.messages);
        assertTrue(exists fields.model);
        assertTrue(exists fields.temperature);
        assertTrue(exists fields.max_tokens);
        # tool_choice has constrained values
        assertTrue(exists fields.tool_choice);
    }

    #! Exercises DeepSeek's live chat-completion endpoint
    /** Verifies the actual wire format against DeepSeek's production endpoint
        with a token-bounded request on `deepseek-v4-flash`. Cost: ~$0.0001 per
        run (capped via max_tokens=16).
    */
    private liveDeepSeekTest() {
        AbstractConnection conn = get_connection(conn_name);
        hash<auto> ping = conn.ping(True);
        assertTrue(ping.ok, sprintf("DeepSeek connection ping failed: %s",
            ping.info ?? "no info"));

        AbstractDataProvider prov = conn.getDataProvider();
        AbstractDataProvider chat = prov.getChildProvider("chat-completion");
        auto resp = chat.doRequest({
            "model": "deepseek-v4-flash",
            "messages": ({"role": "user", "content": "Say hi in one word."},),
            "max_tokens": 32,
            "thinking": {"type": "disabled"},
        });
        assertTrue(resp.choices[0].message.content.val(),
            "DeepSeek returned non-empty assistant content");
        assertTrue(resp.usage.total_tokens > 0,
            "DeepSeek reported positive total_tokens");
    }
    private actionMetadataTest() {
        FakeDeepSeekRestClientIo fake();
        DeepSeekDataProvider::DeepSeekDataProvider root(fake);
        foreach hash<DataProviderActionInfo> action in (DataProviderActionCatalog::getActions("DeepSeek")) {
            if (action.action == AbstractDataProvider::GenericApiCallActionName) {
                continue;
            }
            assertTrue(action.display_name.val());
            assertTrue(action.short_desc.val() && action.short_desc.size() < 80);
            assertTrue(action.desc.val());
            assertTrue(exists action.output_type);
            assertNothing(action.cls);
            AbstractDataProvider child = root.getChildProvider(action.path.substr(1));
            assertTrue(child.getInfo().supports_request);
            assertTrue(exists child.getResponseType());
            if (exists child.getRequestType()) {
                foreach string key in (keys child.getRequestType().getFields()) {
                    if (key != "stream") {
                        assertTrue(exists action.options{key}, action.action + ": " + key);
                    }
                }
            }
            if (exists action.options.model) {
                assertTrue(action.options.model.ref_data.val());
                assertTrue(action.options.model.allowed_values_creatable);
            }
            if (action.action == "fim-completion") {
                assertTrue(action.options.suffix.preselected,
                    "show both sides of the insertion point in the default form");
                assertFalse(action.options.suffix.required,
                    "suffix remains optional for prefix-only completion");
            }
            assertEq(action.action == "upload-file" || action.action == "delete-file",
                DataProviderActionCatalog::actionMutatesState(action));
        }
        assertEq(9, root.getChildProviderSummaryInfo().size());
    }

    private registrationQualificationTest() {
        # Independent inventory: a missing or substituted registration must not hide behind a healthy subset.
        list<string> expected = sort(("chat-completion", "create-response", "delete-file", "fim-completion",
            "get-balance", "get-file", "list-files", "list-models", "upload-file",
            AbstractDataProvider::GenericApiCallActionName));
        foreach int pass in (0..1) {
            if (pass) {
                DeepSeekActions::registerActions();
            }
            assertEq(expected, sort(map $1.action, DataProviderActionCatalog::getActions("DeepSeek")));
            assertEq((), DataProviderActionCatalog::getInitializationFailures(("DeepSeek",)),
                "complete registration also requires no retained initialization failures");
        }
    }

    private translationTest() {
        string catalog_dir = get_script_dir()
            + "/../../../../qlib/DeepSeekDataProvider/i18n/data-provider.RGVlcFNlZWs/";
        hash<auto> root = parse_json(File::readTextFile(catalog_dir + "root.json")).locales.root.messages;
        hash<DataProviderAppInfo> app = DataProviderActionCatalog::getApp("DeepSeek");
        hash<auto> generated = DataProviderPresentation::buildSourceCatalogs(app,
            DataProviderActionCatalog::getActions("DeepSeek"));
        assertEq(generated{DataProviderPresentation::appCatalogDomain(app)}.locales.root.messages, root,
            "the committed root catalog covers the registered presentation metadata");
        # Specific regressions for previously untranslated Japanese labels. Do not reject identical text
        # globally: technical literals and cognates are legitimate, including in future nested catalogs.
        list<string> translated_labels = (
            DataProviderPresentation::optionMessageId("DeepSeek", "upload-file", "file", "display_name"),
            DataProviderPresentation::optionMessageId("DeepSeek", "fim-completion", "echo", "display_name"),
            DataProviderPresentation::optionMessageId("DeepSeek", "create-response", "text", "display_name"),
        );
        foreach string locale in (DataProviderPresentation::StandardTranslationLocales) {
            hash<auto> catalog = parse_json(File::readTextFile(catalog_dir + locale + ".json"));
            hash<auto> messages = catalog.locales{locale}.messages;
            assertEq(sort(keys root), sort(keys messages), locale + ": exact root message IDs");
            list<string> invalid = ();
            foreach hash<auto> entry in (messages.pairIterator()) {
                if (entry.value.source != root{entry.key}.source || !trim(entry.value.message)) {
                    push invalid, entry.key;
                }
            }
            assertEq((), invalid, locale + ": exact sources and non-empty translations");
            if (locale == "ja") {
                foreach string id in (translated_labels) {
                    assertNeq(root{id}.source, messages{id}.message,
                        "previously untranslated Japanese short label: " + id);
                }
            }
        }
    }

    private schemaBoundaryTest() {
        FakeDeepSeekRestClientIo fake();
        DeepSeekApiDataProvider response(fake, "create-response");
        fake.response_body = {"id": "schema", "object": "response", "created_at": 0,
            "status": "completed", "model": "deepseek-v4-flash", "output": ()};
        AbstractDataProviderType original = response.getRequestType();
        AbstractDataProviderType restored = Serializable::deserialize(original.serialize());
        assertEq(original.className(), restored.className(), "stable named type identity survives serialization");
        foreach AbstractDataProviderType type in (original, restored) {
            AbstractDataField effort = type.getField("reasoning").getType().getField("effort");
            assertEq(("none", "minimal", "low", "medium", "high", "xhigh", "max"),
                map $1.value, effort.getAllowedValues());
            assertEq("xhigh", effort.acceptsValue("xhigh"));
            assertThrows("FIELD-VALUE-ERROR", \effort.acceptsValue(), "Extra High");
            foreach hash<auto> schema in ({}, {"type": "object", "properties": {"value": {"type": "string"}},
                    "default": {"value": "ORD-1001"}}) {
                foreach string name in ("reply", "", " ") {
                    hash<auto> request = type.acceptsValue({"model": "deepseek-v4-flash", "input": "Return JSON",
                        "text": {"format": {"type": "json_schema", "name": name, "schema": schema}}});
                    assertEq(schema, request.text.format.schema, "raw schema hashes retain value members");
                    response.doRequest(request);
                    assertEq("/v1/responses", fake.last_path);
                    assertEq(schema, fake.last_request.text.format.schema, "empty and populated schemas reach transport");
                    assertEq(name, fake.last_request.text.format.name, "schema names remain opaque strings");
                }
            }
        }
        int calls = fake.calls;
        foreach hash<auto> format in ({"name": "reply"}, {"name": "reply", "schema": NULL},
                {"schema": {}}, {"name": NULL, "schema": {}}) {
            assertThrows("DEEPSEEK-REQUEST-ERROR", sub () {
                response.doRequest({"model": "deepseek-v4-flash", "input": "Return JSON",
                    "text": {"format": {"type": "json_schema"} + format}});
            });
        }
        assertEq(calls, fake.calls, "invalid schema configurations fail before transport");
    }

    private referenceDataTest() {
        FakeDeepSeekRestClientIo fake();
        DeepSeekDataProvider::DeepSeekDataProvider root(fake);
        fake.response_body = {"data": ({"id": "deepseek-v4-flash"}, {"id": "deepseek-v4-pro"}, {})};
        assertEq(("deepseek-v4-flash", "deepseek-v4-pro"),
            map $1.value, root.getReferenceData("models"));
        assertEq(("deepseek-v4-pro",), map $1.value, root.getReferenceData("fim-models"));
        assertEq("/v1/models", fake.last_path);
        fake.pages = (
            {"data": ({"id": "file-a", "filename": "a.png"},), "last_id": "file-a", "has_more": True},
            {"data": ({"id": "file-b", "filename": "b.png"},), "last_id": "file-b", "has_more": False},
        );
        list<hash<AllowedValueInfo>> files = root.getReferenceData("files");
        assertEq(("file-a", "file-b"), map $1.value, files);
        assertEq("a.png (file-a)", files[0].display_name);
        assertEq("/v1/files?limit=1000&after=file-a", fake.last_path);
        fake.response_body = {"data": (), "has_more": False};
        assertEq((), root.getReferenceData("files"));
    }

    private hash<auto> fileResponse() {
        return {"id": "file-a", "object": "file", "bytes": 1, "created_at": 0,
            "filename": "a.png", "purpose": "user_data", "expires_at": 3600};
    }

    private hash<auto> chatRequest() {
        list<hash<auto>> messages = ({"role": "user", "content": "Hello"},);
        return {"model": "deepseek-v4-flash", "messages": messages};
    }

    private apiRoutesTest() {
        FakeDeepSeekRestClientIo fake();
        DeepSeekDataProvider::DeepSeekDataProvider root(fake);
        fake.response_body = {"object": "list", "data": ({"id": "m", "object": "model", "owned_by": "deepseek"},)};
        assertEq("m", root.getChildProvider("list-models").doRequest().data[0].id);
        assertEq("GET", fake.last_method);
        assertEq("/v1/models", fake.last_path);
        assertNothing(fake.last_request);
        # the model details returned by the API are accepted by the response type
        hash<auto> models = {"object": "list", "data": ({
            "id": "deepseek-v4-pro",
            "object": "model",
            "owned_by": "deepseek",
            "name": "DeepSeek-V4-Pro",
            "context_window": 1048576,
            "max_output_tokens": 393216,
            "input_modalities": ("text", "image"),
            "output_modalities": ("text",),
            "effort": {"supported_levels": ("low", "high", "max"), "default_level": "high"},
            "api_capabilities": {"anthropic_messages": {"system_prompt_update": "in-history"}},
        },)};
        fake.response_body = models;
        auto rv = root.getChildProvider("list-models").doRequest();
        assertEq(models, root.getChildProvider("list-models").getResponseType().acceptsValue(rv));
        fake.response_body = {"is_available": False, "balance_infos": ({"currency": "USD", "total_balance": "0.00",
            "granted_balance": "0.00", "topped_up_balance": "0.00"},)};
        assertFalse(root.getChildProvider("get-balance").doRequest().is_available);
        assertEq("/v1/user/balance", fake.last_path);
        fake.response_body = fileResponse();
        hash<auto> file = root.getChildProvider("get-file").doRequest({"file_id": "file/a?b"});
        assertEq("/v1/files/file%2Fa%3Fb", fake.last_path);
        assertEq(1970-01-01Z, file.created_at);
        assertEq(1970-01-01Z + 1h, file.expires_at);
        fake.response_body = {"object": "list", "data": (fileResponse(),), "has_more": False};
        auto page = root.getChildProvider("list-files").doRequest({"after": "file/a", "limit": 1, "order": "desc"});
        assertEq("/v1/files?after=file%2Fa&limit=1&order=desc", fake.last_path);
        assertNothing(fake.last_request);
        assertEq(1970-01-01Z, page.data[0].created_at);
        fake.response_body = {"id": "file-a", "object": "file", "deleted": True};
        assertTrue(root.getChildProvider("delete-file").doRequest({"file_id": "file-a"}).deleted);
        assertEq("DELETE", fake.last_method);
        assertNothing(fake.last_request);
        fake.response_body = {"id": "fim", "object": "text_completion", "created": 0,
            "model": "deepseek-v4-pro", "choices": ({"index": 0, "text": "42", "finish_reason": "stop"},)};
        auto fim = root.getChildProvider("fim-completion").doRequest({"model": "deepseek-v4-pro", "prompt": "x = ",
            "suffix": "\n", "echo": True, "logprobs": 20, "stop": "END"});
        assertEq("/beta/completions", fake.last_path);
        assertEq("END", fake.last_request.stop);
        assertEq("42", fim.choices[0].text);
        assertEq(1970-01-01Z, fim.created);
        root.getChildProvider("fim-completion").doRequest({"model": "deepseek-v4-pro", "prompt": "", "suffix": "end"});
        assertEq("", fake.last_request.prompt);
        assertEq("end", fake.last_request.suffix);
        fake.response_body = {"id": "resp", "object": "response", "created_at": 0, "status": "completed",
            "model": "deepseek-v4-flash", "output": ()};
        auto resp = root.getChildProvider("create-response").doRequest({"model": "deepseek-v4-flash",
            "input": "", "instructions": "Say hello", "reasoning": {"effort": "none"},
            "text": {"format": {"type": "json_schema", "name": "reply", "schema": {"type": "object"}}}});
        assertEq("/v1/responses", fake.last_path);
        assertEq("json_schema", fake.last_request.text.format.type);
        assertEq(1970-01-01Z, resp.created_at);
        root.getChildProvider("create-response").doRequest({"model": "m", "tools": ({"type": "custom", "name": "apply_patch"},),
            "input": ({"type": "custom_tool_call", "call_id": "call-a", "name": "apply_patch", "input": "patch"},
                {"type": "custom_tool_call_output", "call_id": "call-a", "output": "done"},
                {"type": "web_search_call", "id": "ws-a", "status": "completed", "action": {"type": "search"}},
                {"type": "reasoning", "content": ({"type": "reasoning_text", "text": "step"},), "summary": ()})});
        assertEq("apply_patch", fake.last_request.tools[0].name);
        assertEq("patch", fake.last_request.input[0].input);
        assertEq("search", fake.last_request.input[2].action.type);
    }

    private betaTest() {
        FakeDeepSeekRestClientIo fake();
        DeepSeekChatCompletionDataProvider chat(fake);
        fake.response_body = {"choices": ()};
        hash<auto> req = chatRequest();
        push req.messages, {"role": "assistant", "content": "Answer:", "prefix": True,
            "reasoning_content": "A previous step"};
        chat.doRequest(req);
        assertEq("/beta/chat/completions", fake.last_path);
        assertEq("A previous step", fake.last_request.messages[1].reasoning_content);
        req = chatRequest() + {"tools": ({"type": "function", "function": {"name": "lookup_order", "strict": True}},),
            "tool_choice": {"type": "function", "function": {"name": "lookup_order"}}};
        chat.doRequest(req);
        assertEq("/beta/chat/completions", fake.last_path);
        assertEq("lookup_order", fake.last_request.tool_choice.function.name);
        chat.doRequest(chatRequest() + {"thinking": {"type": "disabled"}, "logprobs": True, "top_logprobs": 20});
        assertEq("/v1/chat/completions", fake.last_path);
        assertEq("disabled", fake.last_request.thinking.type);
    }

    private multipartTest() {
        FakeDeepSeekRestClientIo fake();
        DeepSeekApiDataProvider upload(fake, "upload-file");
        fake.response_body = fileResponse();
        hash<auto> req = {"file": {"name": "a.png", "content": binary("image\0bytes")},
            "purpose": "user_data", "expires_after_seconds": 3600};
        auto file = upload.doRequest(req);
        assertEq(1970-01-01Z, file.created_at);
        assertEq("POST", fake.last_method);
        assertEq("/v1/files", fake.last_path);
        assertTrue(fake.last_headers."Content-Type".startsWith("multipart/form-data"));
        string wire = fake.last_request.toString();
        assertTrue(index(wire, "image\0bytes") >= 0);
        assertTrue(index(wire, 'name="expires_after[anchor]"') >= 0);
        assertTrue(index(wire, "created_at") >= 0);
        assertTrue(index(wire, 'name="expires_after[seconds]"') >= 0);
        assertTrue(index(wire, "3600") >= 0);
        req.file.content = make_base64_string(binary("base64-image"));
        remove req.expires_after_seconds;
        upload.doRequest(req);
        assertTrue(index(fake.last_request.toString(), "base64-image") >= 0);
        assertTrue(index(fake.last_request.toString(), "expires_after") < 0);
    }

    private negativeGenerationTest() {
        FakeDeepSeekRestClientIo fake();
        DeepSeekChatCompletionDataProvider chat(fake);
        foreach hash<auto> invalid in (
            {"model": " "}, {"messages": ()}, {"temperature": -0.1}, {"temperature": 2.1}, {"top_p": 1.1},
            {"max_tokens": 0}, {"top_logprobs": 1}, {"logprobs": True, "top_logprobs": 21},
            {"stop": ("",)}, {"tool_choice": "bogus"}, {"user_id": "personal@example.com"}, {"tool_choice": "required"},
            {"messages": ({"role": "tool", "content": "result"},)},
            {"messages": ({"role": "user", "content": "x", "prefix": True},)},
            {"tools": ({"type": "function", "function": {"name": "bad name"}},)},
            {"tools": ({"type": "function", "function": {"name": "lookup"}},),
                "tool_choice": {"type": "function", "function": {"name": "missing"}}}
        ) {
            assertThrows("DEEPSEEK-REQUEST-ERROR", sub () { chat.doRequest(chatRequest() + invalid); });
        }
        foreach hash<auto> invalid in ({"stream": True}, {"thinking": {"type": "bogus"}}, {"seed": 42},
            {"user": "obsolete"}, {"frequency_penalty": 1}, {"response_format": {"type": "json_schema"}},
            {"messages": ({"role": "invalid", "content": "x"},)}, {"messages": "text"}) {
            assertThrows("RUNTIME-TYPE-ERROR", sub () { chat.doRequest(chatRequest() + invalid); });
        }
        foreach hash<auto> part in ({"type": "text"}, {"type": "image_url"},
            {"type": "file"}, {"type": "file", "file_id": "file-a", "file_data": "data:image/png;base64,abc"}) {
            assertThrows("DEEPSEEK-REQUEST-ERROR", sub () {
                chat.doRequest({"model": "m", "messages": ({"role": "user", "content": (part,)},)});
            });
        }
        DeepSeekApiDataProvider response(fake, "create-response");
        foreach hash<auto> invalid in ({}, {"input": " "}, {"input": "hi", "max_output_tokens": 0},
            {"input": "hi", "text": {"format": {"type": "json_schema"}}}) {
            assertThrows("DEEPSEEK-REQUEST-ERROR", sub () {
                response.doRequest({"model": "deepseek-v4-flash"} + invalid);
            });
        }
        DeepSeekApiDataProvider fim(fake, "fim-completion");
        assertThrows("INVALID-REQUEST", sub () {
            fim.doRequest({"model": "deepseek-v4-pro"});
        });
        assertThrows("DEEPSEEK-REQUEST-ERROR", sub () {
            response.doRequest({"model": "m", "input": "hi", "tools": ({"type": "custom", "name": "unsupported"},)});
        });
        assertEq(0, fake.calls);
    }

    private negativeFilesTest() {
        FakeDeepSeekRestClientIo fake();
        DeepSeekDataProvider::DeepSeekDataProvider root(fake);
        foreach string id in ("", ".", "..") {
            assertThrows("DEEPSEEK-REQUEST-ERROR", sub () { root.getChildProvider("get-file").doRequest({"file_id": id}); });
        }
        foreach int limit in (0, 1001) {
            assertThrows("DEEPSEEK-REQUEST-ERROR", sub () { root.getChildProvider("list-files").doRequest({"limit": limit}); });
        }
        foreach hash<auto> file in ({"name": "a.png", "content": binary()}, {"name": "a\r\n.png", "content": binary("x")},
            {"name": "a.png", "content": binary("x"), "mime_type": "image/png\r\nx: y"}) {
            assertThrows("DEEPSEEK-REQUEST-ERROR", sub () {
                root.getChildProvider("upload-file").doRequest({"file": file, "purpose": "user_data"});
            });
        }
        assertThrows("DEEPSEEK-REQUEST-ERROR", sub () {
            root.getChildProvider("upload-file").doRequest({"file": {"name": "a.png", "content": binary("x")},
                "purpose": "user_data", "expires_after_seconds": 3599});
        });
        assertEq(0, fake.calls);
        fake.response_body = {"data": (), "has_more": True, "last_id": "stuck"};
        assertThrows("REFERENCE-DATA-ERROR", sub () { root.getReferenceData("files"); });
        assertEq(2, fake.calls);
    }

    private constructorTest() {
        DeepSeekRestClientIo client({"apikey": "test-key", "api": "beta"});
        DeepSeekChatCompletionDataProvider chat(client);
        assertEq("/beta", client.getConnectionPath());
        DeepSeekDataProvider::DeepSeekDataProvider root({"restclient": client});
        root.getChildProvider("list-models");
        assertEq("/beta", client.getConnectionPath());
        assertThrows("CONSTRUCTOR-ERROR", sub () { new DeepSeekDataProvider::DeepSeekDataProvider({}); });
        assertThrows("DEEPSEEK-ACTION-ERROR", sub () { new DeepSeekApiDataProvider(client, "missing"); });
        assertThrows("DEEPSEEK-CHILD-ERROR", sub () {
            DeepSeekDataProvider::DeepSeekDataProvider::registerChild("list-models",
                Class::forName("DeepSeekChatCompletionDataProvider"));
        });
    }

    private errorTest() {
        FakeDeepSeekRestClientIo fake();
        DeepSeekChatCompletionDataProvider chat(fake);
        foreach string error in ("REST-RESPONSE-ERROR", "SOCKET-CLOSED", "PROGRAM-INTERRUPTED") {
            fake.failure = <ExceptionInfo>{"err": error, "desc": "test failure", "arg": {"status_code": 429}};
            assertThrows(error, sub () { chat.doRequest(chatRequest()); });
        }
        assertEq(3, fake.calls);
    }

    private liveAccountTest() {
        DeepSeekRestConnection conn("live", "Live account verification", DeepSeekRestConnection::DefaultUrl, {},
            {"apikey": ENV.DEEPSEEK_APIKEY});
        assertTrue(conn.ping(True).ok);
        AbstractDataProvider root = conn.getDataProvider();
        auto models = root.getChildProvider("list-models").doRequest();
        assertTrue(models.data.size() > 0);
        assertEq(models, root.getChildProvider("list-models").getResponseType().acceptsValue(models));
        assertEq((map $1.id, models.data), (map $1.value, root.getReferenceData("models")));
        auto balance = root.getChildProvider("get-balance").doRequest();
        assertEq(NT_BOOLEAN, balance.is_available.typeCode());
        assertTrue(balance.balance_infos.size() > 0);
        assertEq(balance, root.getChildProvider("get-balance").getResponseType().acceptsValue(balance));
        assertEq(NT_STRING, balance.balance_infos[0].total_balance.typeCode());
    }

    private liveApiTest() {
        DeepSeekDataProvider::DeepSeekDataProvider root({"apikey": ENV.DEEPSEEK_APIKEY});
        auto chat = root.getChildProvider("chat-completion").doRequest(chatRequest() + {
            "thinking": {"type": "disabled"}, "max_tokens": 32});
        assertTrue(chat.choices[0].message.content.val());
        assertEq(chat, root.getChildProvider("chat-completion").getResponseType().acceptsValue(chat));
        auto resp = root.getChildProvider("create-response").doRequest({"model": "deepseek-v4-flash", "input": "Say hello.",
            "reasoning": {"effort": "none"}, "max_output_tokens": 32});
        assertEq("completed", resp.status);
        assertEq(resp, root.getChildProvider("create-response").getResponseType().acceptsValue(resp));
        assertTrue(resp.output.size() > 0);
        auto fim = root.getChildProvider("fim-completion").doRequest({"model": "deepseek-v4-pro", "prompt": "x = ",
            "suffix": "\nprint(x)", "max_tokens": 32});
        assertTrue(fim.choices[0].text.val());
        assertEq(fim, root.getChildProvider("fim-completion").getResponseType().acceptsValue(fim));
        # A solid red 64-pixel square; no private image or user content is uploaded.
        auto file = root.getChildProvider("upload-file").doRequest({"purpose": "user_data", "expires_after_seconds": 3600,
            "file": {"name": "qore-deepseek-test.png", "content":
                "iVBORw0KGgoAAAANSUhEUgAAAEAAAABACAIAAAAlC+aJAAAAb0lEQVR4nO3PAQkAAAyEwO9feoshgnABdLep8QUNyPEFDcjxBQ3I8QUNyPEFDcjxBQ3I8QUNyPEFDcjxBQ3I8QUNyPEFDcjxBQ3I8QUNyPEFDcjxBQ3I8QUNyPEFDcjxBQ3I8QUNyPEFDcjxBQ3IPanc8OLDQitxAAAAAElFTkSuQmCC"}});
        bool deleted = False;
        on_exit {
            if (!deleted) {
                root.getChildProvider("delete-file").doRequest({"file_id": file.id});
            }
        }
        assertEq(file.id, root.getChildProvider("get-file").doRequest({"file_id": file.id}).id);
        assertEq(NT_DATE, file.created_at.typeCode());
        assertEq("qore-deepseek-test.png", file.filename);
        assertEq(file, root.getChildProvider("get-file").getResponseType().acceptsValue(file));
        assertEq("user_data", file.purpose);
        assertEq(3600, int(file.expires_at - file.created_at));
        auto vision = root.getChildProvider("chat-completion").doRequest({"model": "deepseek-v4-flash-vision-exp",
            "messages": ({"role": "user", "content": (
                {"type": "text", "text": "Name the dominant color in one word."},
                {"type": "file", "file_id": file.id},
            )},), "thinking": {"type": "disabled"}, "max_tokens": 32});
        assertRegex("(?i)red", vision.choices[0].message.content);
        assertTrue(root.getChildProvider("list-files").doRequest({"limit": 1, "order": "desc"}).data.size() > 0);
        assertTrue((select root.getReferenceData("files"), $1.value == file.id).size() > 0);
        auto removed = root.getChildProvider("delete-file").doRequest({"file_id": file.id});
        deleted = True;
        assertEq(file.id, removed.id);
        assertTrue(removed.deleted);
        assertThrows("REST-RESPONSE-ERROR", "HTTP 400.*", {"status_code": 400}, sub () {
            root.getChildProvider("get-file").doRequest({"file_id": file.id});
        });
    }

    private wireTest() {
        HttpServer http(<HttpServerOptionInfo>{"logger": new Logger("test", LoggerLevel::getLevelWarn())});
        on_exit delete http;
        int port = http.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        DeepSeekWireHandler handler();
        http.setDefaultHandler("wire", handler);
        DeepSeekRestClientIo client({"url": sprintf("http://127.0.0.1:%d", port),
            "apikey": "wire-key", "api": "beta", "http_version": "1.1"});
        DeepSeekDataProvider::DeepSeekDataProvider root(client);
        root.getChildProvider("chat-completion").doRequest(chatRequest() + {"max_tokens": 8});
        hash<auto> wire = handler.getRequest();
        assertEq("beta/chat/completions", wire.hdr.path);
        assertEq("POST", wire.hdr.method);
        assertEq("Bearer wire-key", wire.hdr.authorization);
        assertTrue(wire.hdr."content-type".startsWith("application/json"));
        assertEq(8, parse_json(wire.body.toString()).max_tokens);
        assertEq("/beta", client.getConnectionPath());
        root.getChildProvider("create-response").doRequest({"model": "m", "input": "Return JSON",
            "text": {"format": {"type": "json_schema", "name": "reply", "schema": {}}}});
        wire = handler.getRequest();
        assertEq("v1/responses", wire.hdr.path);
        assertEq({}, parse_json(wire.body.toString()).text.format.schema,
            "the HTTP body preserves an empty schema object");
        root.getChildProvider("upload-file").doRequest({"purpose": "user_data", "file": {
            "name": "a.png", "content": binary("image\0payload")}});
        wire = handler.getRequest();
        assertEq("v1/files", wire.hdr.path);
        assertTrue(wire.hdr."content-type".startsWith("multipart/form-data;"));
        assertTrue(index(wire.body.toString(), "image\0payload") >= 0);
        assertEq("Bearer wire-key", wire.hdr.authorization);
        root.getChildProvider("get-file").doRequest({"file_id": "file-a"});
        wire = handler.getRequest();
        assertEq("GET", wire.hdr.method);
        assertEq("v1/files/file-a", wire.hdr.path);
        assertNothing(wire.body);
    }

    private liveEmptySchemaTest() {
        DeepSeekDataProvider::DeepSeekDataProvider root({"apikey": ENV.DEEPSEEK_APIKEY});
        auto response = root.getChildProvider("create-response").doRequest({"model": "deepseek-v4-flash",
            "input": "Reply with the JSON object {\"ok\":true}.", "reasoning": {"effort": "none"},
            "text": {"format": {"type": "json_schema", "name": "", "schema": {}}},
            "max_output_tokens": 64});
        assertEq("completed", response.status);
        list<hash<auto>> messages = select response.output, $1.type == "message";
        assertTrue(parse_json(messages[0].content[0].text).ok);
    }

    private liveAdvancedTest() {
        DeepSeekDataProvider::DeepSeekDataProvider root({"apikey": ENV.DEEPSEEK_APIKEY});
        AbstractDataProvider chat = root.getChildProvider("chat-completion");
        auto json_reply = chat.doRequest({"model": "deepseek-v4-flash", "messages": (
            {"role": "user", "content": "Return JSON with exactly one key, total, set to 42."},),
            "thinking": {"type": "disabled"}, "response_format": {"type": "json_object"}, "max_tokens": 64});
        assertEq(42, parse_json(json_reply.choices[0].message.content).total);
        auto tool_reply = chat.doRequest({"model": "deepseek-v4-flash", "messages": (
            {"role": "user", "content": "Look up order 123."},), "thinking": {"type": "disabled"},
            "tools": ({"type": "function", "function": {"name": "lookup_order", "strict": True,
                "parameters": {"type": "object", "properties": {"order_id": {"type": "string"}},
                    "required": ("order_id",), "additionalProperties": False}}},),
            "tool_choice": {"type": "function", "function": {"name": "lookup_order"}}, "max_tokens": 128});
        assertEq("tool_calls", tool_reply.choices[0].finish_reason);
        assertEq("lookup_order", tool_reply.choices[0].message.tool_calls[0].function.name);
        assertEq("123", parse_json(tool_reply.choices[0].message.tool_calls[0].function.arguments).order_id);
        auto structured = root.getChildProvider("create-response").doRequest({"model": "deepseek-v4-flash",
            "input": "Extract the total from: invoice total 42.", "reasoning": {"effort": "none"},
            "text": {"format": {"type": "json_schema", "name": "invoice", "schema": {
                "type": "object", "properties": {"total": {"type": "number"}}, "required": ("total",),
                "additionalProperties": False}}}, "max_output_tokens": 128});
        list<hash<auto>> messages = select structured.output, $1.type == "message";
        assertEq(42, parse_json(messages[0].content[0].text).total);
        list<hash<auto>> history = ({"role": "user", "content": "The invoice total is 42."},);
        history += structured.output;
        push history, {"role": "user", "content": "What was the total? Reply with the number only."};
        auto continued = root.getChildProvider("create-response").doRequest({"model": "deepseek-v4-flash",
            "input": history, "reasoning": {"effort": "none"}, "max_output_tokens": 32});
        messages = select continued.output, $1.type == "message";
        assertRegex("42", messages[0].content[0].text);
        auto thinking = chat.doRequest(chatRequest() + {"thinking": {"type": "enabled"},
            "reasoning_effort": "low", "max_tokens": 128});
        assertTrue(thinking.choices[0].message.reasoning_content.val());
        assertTrue(thinking.usage.completion_tokens_details.reasoning_tokens > 0);
    }

}
