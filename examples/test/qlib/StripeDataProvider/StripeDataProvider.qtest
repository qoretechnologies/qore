%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires DataProvider
%requires ConnectionProvider
%requires StripeDataProvider
%requires StripeRestClient
%requires RestClientIo

%requires json

%exec-class StripeDataProviderTest

#! A recorded outgoing request
hashdecl RecordedRequest {
    string method;
    string path;
    auto body;
    *hash<auto> headers;
}

#! A Stripe REST client that records requests instead of making them
class FakeStripeRestClient inherits StripeRestClient::StripeRestClientIo {
    public {
        #! Every request made, in order
        list<hash<RecordedRequest>> requests = ();

        #! Queued responses, consumed in order
        list<hash<auto>> responses = ();

        #! Used when the response queue is empty
        hash<auto> default_response = {"body": {}, "headers": {}};
    }

    constructor() : StripeRestClientIo({"api_key": "sk_test_fake"}) {
    }

    push_response(hash<auto> resp) {
        push responses, resp;
    }

    reset() {
        requests = ();
        responses = ();
    }

    hash<RecordedRequest> last() {
        if (!requests) {
            throw "TEST-ERROR", "no requests were recorded";
        }
        return requests[requests.size() - 1];
    }

    hash<RestClient::RestResponseInfo> restGet(string path, *hash<auto> hdr) {
        return record("GET", path, NOTHING, hdr);
    }

    hash<RestClient::RestResponseInfo> restPost(string path, auto body, *hash<auto> hdr) {
        return record("POST", path, body, hdr);
    }

    hash<RestClient::RestResponseInfo> restPut(string path, auto body, *hash<auto> hdr) {
        return record("PUT", path, body, hdr);
    }

    hash<RestClient::RestResponseInfo> restPatch(string path, auto body, *hash<auto> hdr) {
        return record("PATCH", path, body, hdr);
    }

    hash<RestClient::RestResponseInfo> restDel(string path, auto body, *hash<auto> hdr) {
        return record("DELETE", path, body, hdr);
    }

    hash<RestClient::RestResponseInfo> restDoRequest(string method, string path, auto body, *hash<auto> hdr) {
        return record(method, path, body, hdr);
    }

    hash<RestClient::RestResponseInfo> restDoRawRequest(string method, string path, *data body,
            *hash<auto> hdr) {
        return record(method, path, body, hdr);
    }

    private hash<RestClient::RestResponseInfo> record(string method, string path, auto body, *hash<auto> hdr) {
        push requests, <RecordedRequest>{
            "method": method,
            "path": path,
            "body": body,
            "headers": hdr,
        };
        hash<auto> resp = responses ? shift responses : default_response;
        if (resp.throw_status) {
            throw "REST-RESPONSE-ERROR", sprintf("HTTP %d response received", resp.throw_status),
                <RestClient::RestResponseInfo>{
                    "status_code": resp.throw_status,
                    "headers": resp.headers ?? {},
                    "body": resp.body,
                    "request_path": path,
                };
        }
        return <RestClient::RestResponseInfo>{
            "status_code": resp.status_code ?? 200,
            "body": resp.body,
            "headers": resp.headers ?? {},
        };
    }
}


#! A Stripe event provider that exposes delivery handling for testing
class TestStripeEventProvider inherits StripeDataProvider::StripeChargeSucceededEventDataProvider {
    public {
        #! Events the provider reported to its observers
        list<auto> notified = ();
    }

    constructor() : StripeChargeSucceededEventDataProvider(NOTHING) {
    }

    #! Sets the signing secret, standing in for registering the endpoint with Stripe
    setSecret(string secret) {
        webhook_secret = secret;
    }

    reset() {
        notified = ();
    }

    #! Returns a Stripe-Signature header value for the given body
    string sign(string body, date ts, *string secret) {
        int t = get_epoch_seconds(ts);
        return sprintf("t=%d,v1=%s", t, DataProvider::WebhookSignature::sign(secret ?? webhook_secret,
            sprintf("%d.%s", t, body)));
    }

    #! Delivers a signed payload and returns the event that was reported, if any
    *hash<auto> deliver(string body, string sig_header, date ts) {
        reset();
        deliverRaw({"body": body, "hdr": {"Stripe-Signature": sig_header}});
        return notified ? notified[0] : NOTHING;
    }

    #! Delivers a raw request as the webhook infrastructure would
    deliverRaw(hash<auto> request) {
        handleWebhookEvent(request);
    }

    #! Records what would have been reported to observers
    notifyObservers(string event_id, hash<auto> data) {
        notified += data;
    }
}

public class StripeDataProviderTest inherits QUnit::Test {
    public {
        #! Actions that legitimately open with an empty form
        /** Retrieving the account or the balance takes no arguments at all beyond Stripe's \c "expand"
            control, so there is nothing to show; every other action must offer something.
        */
        const NoInputActions = {
            "get-account": True,
            "get-balance": True,
        };

        #! The operations the application is intended to export
        /** 37 of these are the operations the TypeScript application selected; \c "GET /v1/accounts" was
            added so that connected-account options can be a dropdown, which the previous application
            provided through a helper that called an endpoint outside its own allowed set.
        */
        const ExpectedOperations = (
            "GET /v1/account",
            "GET /v1/accounts",
            "POST /v1/account_links",
            "DELETE /v1/accounts/{account}",
            "GET /v1/accounts/{account}",
            "POST /v1/accounts/{account}",
            "GET /v1/accounts/{account}/external_accounts",
            "POST /v1/accounts/{account}/external_accounts",
            "POST /v1/accounts/{account}/login_links",
            "GET /v1/accounts/{account}/persons",
            "POST /v1/accounts/{account}/persons",
            "GET /v1/balance",
            "GET /v1/balance/history",
            "GET /v1/balance/history/{id}",
            "GET /v1/charges",
            "POST /v1/charges",
            "GET /v1/charges/{charge}",
            "POST /v1/charges/{charge}",
            "GET /v1/customers",
            "POST /v1/customers",
            "DELETE /v1/customers/{customer}",
            "GET /v1/customers/{customer}",
            "POST /v1/customers/{customer}",
            "GET /v1/customers/{customer}/balance_transactions",
            "POST /v1/customers/{customer}/balance_transactions",
            "GET /v1/customers/{customer}/sources",
            "POST /v1/customers/{customer}/sources",
            "GET /v1/customers/{customer}/subscriptions",
            "POST /v1/customers/{customer}/subscriptions",
            "GET /v1/invoices",
            "POST /v1/invoices",
            "DELETE /v1/invoices/{invoice}",
            "GET /v1/invoices/{invoice}",
            "POST /v1/invoices/{invoice}",
            "GET /v1/payment_intents",
            "POST /v1/payment_intents",
            "GET /v1/refunds",
            "POST /v1/refunds",
        );
    }

    private {
        RestSchemaActionSet aset;
        list<hash<DataProviderActionInfo>> actions;
    }

    public {
        #! command-line options
        const MyOpts = Opts + {
            "conn": "c,connection=s",
            "write": "W,write-tests",
        };

        #! Width of the option column in the usage text
        const OptionColumn = 26;
    }

    constructor() : Test("StripeDataProviderTest", "1.0", \ARGV, MyOpts) {
        aset = StripeSchema::getActionSet();
        actions = aset.getActionInfoList(StripeDataProvider::AppName);

        addTestCase("schema provenance", \provenanceTest());
        addTestCase("exported operations", \exportedOperationsTest());
        addTestCase("action presentation", \actionPresentationTest());
        addTestCase("action paths resolve", \actionPathTest());
        addTestCase("reference data", \referenceDataTest());
        addTestCase("timestamp conversion", \timestampTest());
        addTestCase("request reconstruction", \requestReconstructionTest());
        addTestCase("response contract", \responseContractTest());
        addTestCase("connection", \connectionTest());
        addTestCase("webhook events", \webhookEventTest());
        addTestCase("webhook delivery verification", \webhookVerificationTest());
        # live tests; each skips unless a connection is named
        addTestCase("live account and balance", \liveAccountTest());
        addTestCase("live listings", \liveListingTest());
        addTestCase("live error handling", \liveErrorTest());
        addTestCase("live customer round trip", \liveCustomerRoundTripTest());

        set_return_value(main());
    }

    #! Prints the extra options this suite accepts
    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-c,--connection=ARG", "set connection name for live tests", OptionColumn);
        printOption("-W,--write-tests", "enable live tests that create and delete objects", OptionColumn);
    }

    provenanceTest() {
        # the vendored schema has to be the revision the manifest was reviewed against, and the API version
        # the client sends has to be the one that schema describes; a mismatch means the declared response
        # types and what Stripe actually returns can disagree
        hash<StripeSchemaProvenanceInfo> p = StripeSchema::Provenance;
        assertEq("2026-07-29.dahlia", p.api_version);
        assertEq(p.api_version, StripeRestClientBase::DefaultApiVersion);
        assertRegex("^[0-9a-f]{64}$", p.source_sha256);
        assertRegex("stripe/openapi", p.source_url);

        OpenApi3Schema schema = StripeSchema::getSchema();
        assertEq(p.api_version, schema.info.version);
        # the scheme declared by the schema must survive: a client built from it must not talk plaintext
        assertEq("https://api.stripe.com", schema.getTargetUrl());
    }

    exportedOperationsTest() {
        # every intended operation is exported exactly once, and nothing else is
        list<string> exported = ();
        foreach string name in (aset.getActionNames()) {
            RestSchemaActionOperation op = aset.getOperationEx(name);
            exported += sprintf("%s %s", op.getMethod(), op.getPath());
        }
        assertEq(ExpectedOperations.size(), exported.size());
        assertEq(sort(ExpectedOperations), sort(exported));
        # ... exactly once each
        assertEq(exported.size(), (keys (map {$1: True}, exported)).size());

        # action IDs are unique and stable, and independent of Stripe's operationId values
        assertEq(exported.size(), aset.getActionNames().size());
    }

    actionPresentationTest() {
        # an action with an empty form, no output type or no documentation does not meet the checklist,
        # however valid the request it generates would be
        foreach hash<DataProviderActionInfo> a in (actions) {
            assertEq(DPAT_API, a.action_code, a.action + ": action code");
            assertEq("/" + a.action, a.path, a.action + ": path");
            assertTrue(a.display_name.val(), a.action + ": display name");
            assertTrue(a.short_desc.val(), a.action + ": short description");
            assertTrue(a.desc.val(), a.action + ": description");
            assertTrue(a.groups.val(), a.action + ": groups");
            assertTrue(exists a.output_type, a.action + ": output type");
            assertTrue(a.options.val(), a.action + ": options");
            # a short description is a single plain-text line
            assertLt(90, a.short_desc.size(), a.action + ": short description length");
            assertEq(-1, a.short_desc.find("\n"), a.action + ": short description is one line");

            # something has to be visible when the form opens, unless the operation genuinely takes no
            # meaningful input -- these two accept only Stripe's "expand" control
            bool visible = False;
            foreach hash<auto> o in (a.options.iterator()) {
                if (o.required || o.preselected) {
                    visible = True;
                    break;
                }
            }
            if (NoInputActions{a.action}) {
                assertEq(("expand",), keys a.options, a.action + ": takes no input beyond \"expand\"");
            } else {
                assertTrue(visible, a.action + ": has an initially visible option");
            }
        }
    }

    actionPathTest() {
        # an action whose path does not resolve exists in the catalog but cannot be executed
        FakeStripeRestClient rest();
        StripeDataProvider root(rest);
        aset.validateActionPaths(root);
        # besides the actions the root resolves two more children: the generic API-call child the
        # framework injects into every REST-scheme provider, and the container holding the event providers
        list<string> children = root.getChildProviderNames();
        assertEq(actions.size() + 2, children.size());
        assertEq(actions.size(), (map $1, children,
            $1 != "__call__" && $1 != StripeDataProvider::EventsChildName).size());
        assertNothing(root.getChildProvider("no-such-action"));

        AbstractDataProvider child = root.getChildProviderEx("get-customer");
        assertTrue(child.getInfo().supports_request);
        assertEq("Get Customer", child.getDisplayName());
    }

    referenceDataTest() {
        # every identifier that the application can list is offered as a dropdown rather than free text
        hash<string, hash<RestSchemaReferenceDataInfo>> rd = aset.getReferenceDataDecls();
        assertEq(("stripe-account", "stripe-customer", "stripe-charge", "stripe-invoice",
            "stripe-payment-intent", "stripe-balance-transaction"), keys rd);

        # the reference data behind the customer selector really is the customer listing; the application
        # this replaces populated its invoice selector from the payment-intents endpoint
        assertEq("list-customers", rd."stripe-customer".action);
        assertEq("list-invoices", rd."stripe-invoice".action);
        assertEq("list-payment-intents", rd."stripe-payment-intent".action);

        # the only option in the application taking an invoice ID gets the invoice listing
        RestSchemaActionOperation op = aset.getOperationEx("list-customer-balance-transactions");
        assertEq("stripe-invoice", op.getRequestFields().invoice.getAttributes().ref_data);

        # a customer selector reaches the customer-scoped actions
        map assertEq("stripe-customer", aset.getOperationEx($1).getRequestFields().customer.getAttributes().ref_data,
            $1 + ": customer reference data"),
            ("get-customer", "update-customer", "delete-customer", "list-customer-sources", "list-invoices");

        # a dropdown is filled by executing the listing action and mapping its records
        FakeStripeRestClient rest();
        StripeDataProvider root(rest);
        AbstractDataProvider gc = root.getChildProviderEx("get-customer");
        assertEq({"stripe-customer": True}, gc.getSupportedReferenceData());
        rest.push_response({"body": {"data": (
            {"id": "cus_1", "email": "a@example.com"},
            {"id": "cus_2"},
        ), "has_more": False}});
        *list<hash<AllowedValueInfo>> values = gc.getReferenceData("stripe-customer");
        assertEq(2, values.size());
        assertEq("cus_1", values[0].value);
        assertEq("a@example.com", values[0].display_name);
        # a customer with no email shows its ID rather than an empty row
        assertEq("cus_2", values[1].display_name);
        # the dropdown asks for one full page rather than walking the collection
        assertRegex("limit=100", rest.last().path);
    }

    timestampTest() {
        # Stripe's timestamps are counts of SECONDS since the epoch; presenting them as milliseconds is
        # wrong by a factor of 1000, which is a defect the previous application shipped
        hash<string, list<string>> expected = {
            "create-invoice": ("due_date", "effective_at", "automatically_finalizes_at"),
            "update-invoice": ("due_date", "effective_at", "automatically_finalizes_at"),
            "create-customer-subscription": ("trial_end", "billing_cycle_anchor", "cancel_at",
                "backdate_start_date"),
        };
        foreach hash<auto> i in (expected.pairIterator()) {
            RestSchemaActionOperation op = aset.getOperationEx(i.key);
            foreach string field in (i.value) {
                assertEq(RestSchemaActionCodecs::UnixSeconds, op.getFlatMap(){field}.codec,
                    sprintf("%s.%s codec", i.key, field));
                assertEq(NT_DATE, op.getRequestFields(){field}.getType().getBaseTypeCode(),
                    sprintf("%s.%s type", i.key, field));
            }
        }

        # a date supplied by a user reaches the wire as Unix seconds
        RestSchemaActionOperation ci = aset.getOperationEx("create-invoice");
        hash<auto> wire = ci.unflatten({"customer": "cus_1", "due_date": 2026-09-01T00:00:00Z});
        assertEq(1788220800, wire.req.body.due_date);
        # ... and comes back as the same date
        assertEq(2026-09-01T00:00:00Z, ci.flatten(wire).due_date);
    }

    requestReconstructionTest() {
        FakeStripeRestClient rest();
        StripeDataProvider root(rest);

        # a path variable is substituted into the URI and query arguments are appended
        rest.push_response({"body": {"id": "cus_1", "object": "customer"}});
        auto resp = root.getChildProviderEx("get-customer").doRequest({
            "customer": "cus_1",
            "expand": ("sources",),
        });
        assertEq({"id": "cus_1", "object": "customer"}, resp);
        assertEq("GET", rest.last().method);
        assertEq("/v1/customers/cus_1?expand=sources", rest.last().path);
        # every request carries the pinned API version; the client merges its default headers below the
        # point this fake intercepts, so the header is asserted on the client itself
        assertEq(StripeRestClientBase::DefaultApiVersion,
            rest.getDefaultHeaders(){StripeRestClientBase::ApiVersionHeader});

        # a form-encoded body with a nested object and an array uses Stripe's deepObject encoding
        rest.reset();
        rest.push_response({"body": {"id": "cus_2", "object": "customer"}});
        root.getChildProviderEx("create-customer").doRequest({
            "email": "a@example.com",
            "name": "Test",
            "metadata": {"order_id": "6735"},
            "expand": ("sources",),
        });
        assertEq("POST", rest.last().method);
        assertEq("/v1/customers", rest.last().path);
        assertEq(MimeTypeFormUrlEncoded, rest.last().headers."Content-Type");
        string body = rest.last().body.toString();
        assertRegex("email=a%40example.com", body);
        assertRegex("metadata%5Border_id%5D=6735", body);
        assertRegex("expand%5B0%5D=sources", body);

        # a DELETE reaches the right method and path
        rest.reset();
        rest.push_response({"body": {"id": "cus_1", "deleted": True}});
        root.getChildProviderEx("delete-customer").doRequest({"customer": "cus_1"});
        assertEq("DELETE", rest.last().method);
        assertEq("/v1/customers/cus_1", rest.last().path);

        # a missing path variable is reported rather than sent as a literal placeholder; the request type
        # is validated before the request is built, so a required path variable is caught there first
        AbstractDataProvider gc = root.getChildProviderEx("get-customer");
        assertThrows("INVALID-REQUEST", "mandatory string field \"customer\"", \gc.doRequest(),
            {"expand": ("sources",)});

        # an error response reaches the caller with its context
        rest.reset();
        rest.push_response({"throw_status": 404, "body": {"error": {"message": "No such customer"}}});
        assertThrows("REST-RESPONSE-ERROR", "HTTP 404", \gc.doRequest(), {"customer": "cus_missing"});
    }

    responseContractTest() {
        # the action publishes the success response body, not the HTTP envelope
        RestSchemaActionOperation gc = aset.getOperationEx("get-customer");
        assertEq("200", gc.getResponseCode());
        # this operation returns a customer or a deleted customer, so its output is the union of both
        assertRegex("customer", gc.getResponseType().getName());

        # a listing keeps its envelope, because has_more is what a caller needs to paginate
        RestSchemaActionOperation lc = aset.getOperationEx("list-customers");
        assertEq(("data", "has_more", "object", "url"), keys lc.getResponseType().getFields());
        assertEq(NT_LIST, lc.getResponseType().getFields().data.getType().getBaseTypeCode());

        # a representative response conforms to the published output type
        FakeStripeRestClient rest();
        StripeDataProvider root(rest);
        rest.push_response({"body": {
            "object": "list",
            "url": "/v1/customers",
            "has_more": False,
            "data": ({
                "id": "cus_1",
                "object": "customer",
                "email": "a@example.com",
                "created": 1709294400,
                "livemode": False,
            },),
        }});
        auto resp = root.getChildProviderEx("list-customers").doRequest({"limit": 1});
        assertEq(1, resp.data.size());
        assertEq("cus_1", resp.data[0].id);
        assertFalse(resp.has_more);
        # the type accepts the value the service returned
        assertEq(resp, lc.getResponseType().acceptsValue(resp));
    }

    connectionTest() {
        StripeRestConnection conn("stripe-test", "test connection", "stripe://api.stripe.com", {}, {
            "api_key": "sk_test_fake",
        });
        assertEq("stripe", conn.getType());
        assertTrue(conn.hasDataProvider());
        # the scheme is what decides the connection class, so it has to be registered
        assertTrue(exists ConnectionSchemeCache::getScheme("stripe"));

        # the API version travels on every request, and a connected account can be named for all of them
        StripeRestClientIo c({"api_key": "sk_test_fake", "stripe_account": "acct_1"});
        assertEq(StripeRestClientBase::DefaultApiVersion, c.getApiVersion());
        assertEq("acct_1", c.getDefaultHeaders(){StripeRestClientBase::AccountHeader});

        # an explicitly supplied header wins over the default
        StripeRestClientIo c2({"api_key": "sk_test_fake", "stripe_version": "2020-08-27"});
        assertEq("2020-08-27", c2.getApiVersion());

        # an unknown data provider option is reported rather than ignored
        assertThrows("CONSTRUCTOR-ERROR", "unknown option", sub () { new StripeDataProvider({"bogus": 1}); });
    }

    webhookEventTest() {
        FakeStripeRestClient rest();
        StripeDataProvider root(rest);

        # every event action names a path under "/events", so that container has to resolve
        AbstractDataProvider events = root.getChildProviderEx(StripeDataProvider::EventsChildName);
        list<string> ids = events.getChildProviderNames();
        assertEq(13, ids.size());

        foreach string id in (ids) {
            AbstractDataProvider ep = events.getChildProviderEx(id);
            assertTrue(ep.getInfo().supports_observable, id + ": observable");
            assertEq((id,), keys ep.getEventTypes(), id + ": event types");
            assertTrue(ep.getEventTypes(){id}.desc.val(), id + ": event description");
        }
        assertNothing(events.getChildProvider("no-such-event"));

        # the example event is formatted to the version the actions were generated from, so what a user
        # is shown matches what will actually arrive
        rest.push_response({"throw_status": 404, "body": {}});
        hash<auto> example = events.getChildProviderEx("charge-succeeded").getExampleEventData("charge-succeeded");
        assertEq("charge.succeeded", example.type);
        assertEq(StripeSchema::Provenance.api_version, example.api_version);
        assertTrue(example.data.object.hasKey("amount"));

        # a real recent event is preferred over the static one
        rest.reset();
        rest.push_response({"body": {"data": ({"id": "evt_real", "type": "charge.succeeded"},)}});
        assertEq("evt_real",
            events.getChildProviderEx("charge-succeeded").getExampleEventData("charge-succeeded").id);
    }

    webhookVerificationTest() {
        # a webhook endpoint is a URL anyone can post to: an unverified endpoint would accept a forged
        # "charge.succeeded", which is enough to make an integration ship goods that were never paid for
        TestStripeEventProvider ep();
        ep.setSecret("whsec_test");

        string body = "{\"id\":\"evt_1\",\"type\":\"charge.succeeded\",\"data\":{\"object\":{\"id\":\"ch_1\"}}}";
        date ts = now_us();

        # a correctly signed delivery is accepted
        assertEq("evt_1", ep.deliver(body, ep.sign(body, ts), ts).id);

        # a forged delivery signed with a different secret is dropped
        assertNothing(ep.deliver(body, ep.sign(body, ts, "whsec_attacker"), ts));

        # so is one whose body was altered after signing
        assertNothing(ep.deliver(body + " ", ep.sign(body, ts), ts));

        # a captured delivery replayed beyond the tolerance is dropped
        date old = ts - 10m;
        assertNothing(ep.deliver(body, ep.sign(body, old), old));

        # a delivery with no signature header at all is dropped
        assertNothing(ep.deliverRaw({"body": body, "hdr": {}}));

        # ... as is one whose header carries no usable values
        assertNothing(ep.deliverRaw({"body": body, "hdr": {"Stripe-Signature": "garbage"}}));

        # a delivery that arrives already parsed cannot be verified, because the signature covers the
        # bytes as sent; it is dropped rather than accepted unchecked
        assertNothing(ep.deliverRaw({
            "body": parse_json(body),
            "hdr": {"Stripe-Signature": ep.sign(body, ts)},
        }));

        # nothing is accepted before the endpoint has been registered and a secret is known
        TestStripeEventProvider unregistered();
        assertNothing(unregistered.deliver(body, "t=1,v1=deadbeef", ts));

        # a signed delivery of some other event type is not reported by this provider
        string other = "{\"id\":\"evt_2\",\"type\":\"charge.refunded\"}";
        ep.reset();
        ep.deliverRaw({"body": other, "hdr": {"Stripe-Signature": ep.sign(other, ts)}});
        assertEq((), ep.notified);

        # the header name is matched without regard to case, as HTTP header names are case-insensitive
        ep.reset();
        ep.deliverRaw({"body": body, "hdr": {"STRIPE-SIGNATURE": ep.sign(body, ts)}});
        assertEq(1, ep.notified.size());
    }


    # --- Live tests (require -c <connection>; writes additionally require -W) ---

    #! Returns a client for the connection named on the command line, or skips the test
    /** Works either side of the flag day.  A native \c "stripe" connection is used directly; a connection
        still serving the TypeScript application is used by seeding a native client from its stored
        credentials, which is how this application can be verified against a real account before the
        TypeScript one is removed.
    */
    private *StripeRestClientIo getLiveClient() {
        *string conn_name = m_options.conn ?? ENV.STRIPE_CONNECTION;
        if (!conn_name.val()) {
            testSkip("no connection specified; use -c,--connection=ARG or set STRIPE_CONNECTION");
            return;
        }
        AbstractConnection conn = get_connection(conn_name);
        if (conn.getType() == "stripe") {
            return cast<StripeRestClientIo>(conn.getAsync());
        }
        *string token = conn.getInfo({"with_passwords": True}).opts.token;
        if (!token.val()) {
            throw "OPTION-ERROR", sprintf("connection %y is type %y and has no stored token to seed a "
                "native client with; use a native \"stripe\" connection, or one still serving the "
                "TypeScript application that has been authorized", conn_name, conn.getType());
        }
        return new StripeRestClientIo({"api_key": token});
    }

    liveAccountTest() {
        *StripeRestClientIo rest = getLiveClient();
        if (!rest) {
            return;
        }
        StripeDataProvider dp(rest);

        # the account the credentials authenticate as, which also proves the pinned API version is
        # accepted: Stripe rejects a version it does not recognize
        hash<auto> acct = dp.getChildProviderEx("get-account").doRequest();
        assertRegex("^acct_", acct.id);
        assertTrue(acct.country.val(), "the account declares a country");
        assertEq(StripeRestClientBase::DefaultApiVersion, rest.getApiVersion());

        # the balance response shape is a contract this module publishes, so upstream drift fails here
        hash<auto> bal = dp.getChildProviderEx("get-balance").doRequest();
        assertEq("balance", bal.object);
        assertEq(NT_LIST, bal.available.typeCode());
        assertEq(NT_LIST, bal.pending.typeCode());
        if (bal.available) {
            assertEq(NT_INT, bal.available[0].amount.typeCode(),
                "balance amounts are integers in the currency's smallest unit");
            assertTrue(bal.available[0].currency.val());
        }
    }

    liveListingTest() {
        *StripeRestClientIo rest = getLiveClient();
        if (!rest) {
            return;
        }
        StripeDataProvider dp(rest);

        # every listing returns the same envelope, and this module publishes it rather than unwrapping
        # it, because has_more is what a caller needs to paginate
        foreach string action in (("list-customers", "list-charges", "list-invoices",
            "list-payment-intents", "list-refunds", "list-balance-transactions")) {
            hash<auto> resp = dp.getChildProviderEx(action).doRequest({"limit": 1});
            assertEq("list", resp.object, action + ": envelope object");
            assertEq(NT_LIST, resp.data.typeCode(), action + ": data is a list");
            assertEq(NT_BOOLEAN, resp.has_more.typeCode(), action + ": has_more is a boolean");
            assertLe(1, resp.data.size(), action + ": limit is honored");
        }

        # the persons listing is the endpoint Stripe's schema declares twice and answers on once
        hash<auto> people = dp.getChildProviderEx("list-account-people").doRequest({
            "account": dp.getChildProviderEx("get-account").doRequest().id,
            "limit": 1,
        });
        assertEq("list", people.object);
    }

    liveErrorTest() {
        *StripeRestClientIo rest = getLiveClient();
        if (!rest) {
            return;
        }
        StripeDataProvider dp(rest);
        AbstractDataProvider gc = dp.getChildProviderEx("get-customer");

        # a real Stripe error reaches the caller with its status and its error envelope intact, rather
        # than as an opaque failure
        try {
            gc.doRequest({"customer": "cus_qore_does_not_exist"});
            fail("retrieving a non-existent customer must throw");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("REST-RESPONSE-ERROR", ex.err);
            assertEq(404, ex.arg.status_code);
            assertEq("invalid_request_error", ex.arg.body.error.type);
            assertRegex("No such customer", ex.arg.body.error.message);
        }
    }

    liveCustomerRoundTripTest() {
        *StripeRestClientIo rest = getLiveClient();
        if (!rest) {
            return;
        }
        if (!m_options.write) {
            testSkip("write tests not enabled; use -W,--write-tests");
            return;
        }
        StripeDataProvider dp(rest);

        # a create/retrieve/update/delete round trip, which is also what proves the form encoding on a
        # live account: metadata travels as Stripe's deepObject form, not as JSON
        hash<auto> created = dp.getChildProviderEx("create-customer").doRequest({
            "email": "qore-test@example.com",
            "name": "Qore Test Customer",
            "description": "created by the Qore StripeDataProvider test suite",
            "metadata": {"qore_test": "1"},
        });
        assertRegex("^cus_", created.id);
        assertEq("qore-test@example.com", created.email);
        # the nested metadata object survived form encoding
        assertEq("1", created.metadata.qore_test);

        on_exit {
            # always remove the object this test created, whatever happened above
            try {
                dp.getChildProviderEx("delete-customer").doRequest({"customer": created.id});
            } catch (hash<ExceptionInfo> ex) {
                printf("WARNING: could not delete test customer %y: %s\n", created.id,
                    get_exception_string(ex));
            }
        }

        hash<auto> fetched = dp.getChildProviderEx("get-customer").doRequest({"customer": created.id});
        assertEq(created.id, fetched.id);
        # Stripe carries created as a count of seconds, and the response is published unconverted
        assertEq(NT_INT, fetched.created.typeCode());

        hash<auto> updated = dp.getChildProviderEx("update-customer").doRequest({
            "customer": created.id,
            "name": "Qore Test Customer (updated)",
        });
        assertEq("Qore Test Customer (updated)", updated.name);

        hash<auto> deleted = dp.getChildProviderEx("delete-customer").doRequest({"customer": created.id});
        assertTrue(deleted.deleted);
    }

}
