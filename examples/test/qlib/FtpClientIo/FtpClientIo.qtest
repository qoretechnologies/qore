#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%enable-all-warnings

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires Util
%requires FsUtil
%requires ../../../../qlib/FtpClientIo/FtpClientIo.qm

%include ../../qore/classes/FtpServer.qc

%exec-class FtpClientIoTest

class FtpClientIoTest inherits QUnit::Test {
    private {
        int port;
        FtpServer ftpServer;
    }

    constructor() : QUnit::Test("FtpClientIo", "1.0") {
        addTestCase("FtpControlPollOperation basic", \testControlPollOperationBasic());
        addTestCase("FtpControlPollOperation login", \testControlPollOperationLogin());
        addTestCase("FtpControlPollOperation command", \testControlPollOperationCommand());
        addTestCase("FtpDataPollOperation basic", \testDataPollOperationBasic());

        ftpServer = new FtpServer(0, m_options.verbose);
        port = ftpServer.getPort();

        set_return_value(main());

        ftpServer.shutdown();
    }

    #! Drive a poll operation to completion using continuePoll + Socket::poll
    private drivePollOp(AbstractPollOperation op, timeout tmout = 10s) {
        date deadline = now_us() + tmout;
        while (!op.goalReached()) {
            *hash<SocketPollInfo> pi = op.continuePoll();
            if (pi) {
                list<hash<SocketPollInfo>> poll_list = (pi,);
                timeout remaining = deadline - now_us();
                if (remaining <= 0) {
                    throw "TIMEOUT", "poll operation timed out";
                }
                Socket::poll(poll_list, remaining);
            }
        }
    }

    testControlPollOperationBasic() {
        # Test basic construction and state
        FtpControlPollOperation op("localhost", port);
        assertEq("FtpControlPollOperation", op.className());
        assertEq("connecting", op.getState());
        assertEq("ftp-login", op.getGoal());
        assertFalse(op.goalReached());
        assertFalse(op.isReady());
        assertFalse(op.isClosed());
        assertEq(0, op.getLastResponseCode());

        # Finish the login handshake so the test observes the server response
        # instead of dropping the operation while the fake server is replying.
        drivePollOp(op);
        assertTrue(op.isReady(), "operation should be in ready state after login");
        assertTrue(op.goalReached(), "goal should be reached after login");
        int code = op.getLastResponseCode();
        assertTrue(code >= 200 && code < 300, sprintf("expected 2xx login code, got %d", code));
    }

    testControlPollOperationLogin() {
        # Test login via poll driver
        FtpControlPollOperation op("localhost", port);

        # Drive to login completion
        drivePollOp(op);

        assertTrue(op.isReady(), "operation should be in ready state after login");
        assertTrue(op.goalReached(), "goal should be reached after login");
        int code = op.getLastResponseCode();
        assertTrue(code >= 200 && code < 300, sprintf("expected 2xx login code, got %d", code));

        hash<auto> output = op.getOutput();
        assertEq(True, output.login_complete);
    }

    testControlPollOperationCommand() {
        # Test command execution after login
        FtpControlPollOperation op("localhost", port);

        # Login first
        drivePollOp(op);
        assertTrue(op.isReady(), "should be ready after login");

        # Submit PWD command
        op.submitCommand("PWD");
        assertEq("ftp-command", op.getGoal());

        # Drive command to completion
        drivePollOp(op);

        assertTrue(op.goalReached(), "goal should be reached after command");
        assertTrue(op.isReady(), "should be ready after command");
        hash<auto> output = op.getOutput();
        assertEq(257, output.code, "PWD should return 257");
        if (m_options.verbose > 1) {
            printf("PWD response: %d %s\n", output.code, output.message);
        }

        # Submit TYPE I command
        op.submitCommand("TYPE", "I");
        drivePollOp(op);
        assertEq(200, op.getLastResponseCode(), "TYPE I should return 200");
    }

    testDataPollOperationBasic() {
        Queue q();
        binary payload = binary("ftp-data-payload");
        background sub () {
            try {
                Socket data_server();
                if (data_server.bind("127.0.0.1:0", True)) {
                    throw "TEST-ERROR", "failed to bind data server";
                }
                data_server.listen();
                q.push(data_server.getSocketInfo().port);

                Socket peer = data_server.accept(5s);
                peer.send(payload, 5s);
                peer.close();
                q.push(True);
            } catch (hash<ExceptionInfo> ex) {
                q.push(ex);
            }
        }();

        int data_port = q.get(5s);
        FtpDataPollOperation data_op("127.0.0.1", data_port);
        assertEq("FtpDataPollOperation", data_op.className());
        assertEq("data-connecting", data_op.getState());
        assertEq("ftp-data-recv", data_op.getGoal());
        assertFalse(data_op.goalReached());

        drivePollOp(data_op);
        assertTrue(data_op.goalReached(), "data operation should finish after server close");
        assertTrue(data_op.isDone(), "data operation should be done after EOF");
        assertEq(payload, data_op.getOutput());

        auto server_result = q.get(5s);
        if (server_result.typeCode() == NT_HASH) {
            fail(sprintf("Data server exception: %s: %s", server_result.err, server_result.desc));
        }
        assertTrue(server_result);
    }
}
