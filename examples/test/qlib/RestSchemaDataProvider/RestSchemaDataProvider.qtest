#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%new-style
%enable-all-warnings
%require-types
%strict-args

# try importing JSON and YAML modules
%try-module json
%define NoJson
%endtry
%try-module yaml
%define NoYaml
%endtry

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/Mime.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/FsUtil.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/DataProvider
%requires ../../../../qlib/HttpServerUtil.qm
%requires ../../../../qlib/RestSchemaValidator.qm
%requires ../../../../qlib/Swagger.qm
%requires ../../../../qlib/OpenApi3.qm
%requires ../../../../qlib/ConnectionProvider
%requires ../../../../qlib/RestClient.qm
%requires ../../../../qlib/RestSchemaDataProvider

%exec-class RestSchemaDataProviderTest

public class RestSchemaDataProviderTest inherits QUnit::Test {
    constructor() : Test("RestSchemaDataProviderTest", "1.0") {
        addTestCase("Swagger schema test", \testSwaggerSchema());
        addTestCase("OpenAPI 3.0 schema test", \testOpenApi3Schema());
        addTestCase("Factory test", \testFactory());
        set_return_value(main());
    }

    checkModules() {
%ifdef NoJson
        testSkip("no json module");
%endif
%ifdef NoYaml
        testSkip("no yaml module");
%endif
    }

    testSwaggerSchema() {
        checkModules();

        bool set = AbstractDataProvider::setDynamicValueCallbacks(
            bool sub (auto uri_path) { return uri_path =~ /\$/; },
            auto sub (auto uri_path) { uri_path =~ s/\$id/1/; return uri_path; });
        assertTrue(set);
        assertFalse(AbstractDataProvider::setDynamicValueCallbacks());

        hash<auto> opts = {
            "schema": get_script_dir() + "/../Swagger/PetStore.swagger.yaml",
        };
        RestSchemaDataProvider provider(opts);
        assertEq("Swagger Petstore", provider.getName());
        assertTrue(provider.isSwagger());
        assertFalse(provider.isOpenApi3());

        {
            AbstractDataProvider p0 = provider.getChildProviderPath("pet/findByStatus/GET");
            AbstractDataProviderType req = p0.getRequestType();
            assertEq(NT_HASH, req.getField("query").getType().getBaseTypeCode());
            AbstractDataProviderType resp = p0.getResponseType();
            AbstractDataProviderType type = resp.getField("body").getType().getElementType();
            assertEq("*softint", type.getFieldType("id").getName());
            assertEq("softstring", type.getFieldType("name").getName());
            assertEq(("id", "category", "name", "photoUrls", "tags", "status"), keys type.getFields());

            assertThrows("SCHEMA-VALIDATION-ERROR", "enumerated values.*x", \p0.doRequest(),
                {"query": {"status": ("x",)}});
        }

        {
            AbstractDataProvider p0 = provider.getChildProviderPath("pet/$id/POST");
            assertEq("POST", p0.getInfo().name);
            AbstractDataProviderType req = p0.getRequestType();
            assertEq(NT_HASH, req.getField("formData").getType().getBaseTypeCode());
        }

        # Test with schema string
        opts.schema = File::readTextFile(opts.schema);
        provider = new RestSchemaDataProvider(opts);
        {
            AbstractDataProvider p0 = provider.getChildProviderPath("pet/findByStatus/GET");
            AbstractDataProviderType req = p0.getRequestType();
            assertEq(NT_HASH, req.getField("query").getType().getBaseTypeCode());
        }
    }

    testOpenApi3Schema() {
        checkModules();

        hash<auto> opts = {
            "schema": get_script_dir() + "/../OpenApi3/PetStore.openapi3.yaml",
        };
        RestSchemaDataProvider provider(opts);
        assertEq("Swagger Petstore", provider.getName());
        assertFalse(provider.isSwagger());
        assertTrue(provider.isOpenApi3());

        {
            AbstractDataProvider p0 = provider.getChildProviderPath("pets/GET");
            AbstractDataProviderType req = p0.getRequestType();
            # OpenAPI 3.0 PetStore has query parameters
            *AbstractDataField queryField = req.getField("query");
            if (queryField) {
                assertEq(NT_HASH, queryField.getType().getBaseTypeCode());
            }
            AbstractDataProviderType resp = p0.getResponseType();
            *AbstractDataField bodyField = resp.getField("body");
            if (bodyField) {
                assertEq(Type::List, bodyField.getType().getBaseTypeName());
            }
        }

        # Test with schema string
        opts.schema = File::readTextFile(opts.schema);
        provider = new RestSchemaDataProvider(opts);
        assertTrue(provider.isOpenApi3());
        {
            AbstractDataProvider p0 = provider.getChildProviderPath("pets/GET");
            assertEq("GET", p0.getName());
        }
    }

    testFactory() {
        checkModules();

        RestSchemaDataProviderFactory factory();
        hash<DataProviderFactoryInfo> info = factory.getInfo();
        assertEq("restschema", info.name);
        assertTrue(info.children_can_support_apis);
    }
}
