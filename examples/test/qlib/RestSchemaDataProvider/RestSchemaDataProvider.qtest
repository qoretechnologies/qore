";
            RestSchemaDataProvider provider({"schema": schema_yaml});
            AbstractDataProvider p0 = provider.getChildProviderPath("writeonly-test/POST");
            assertEq("POST", p0.getName());
        }

        # Test deprecated schema
        {
            string schema_yaml = "openapi: '3.0.0'
info:
  title: Deprecated Test
  version: '1.0'
paths:
  /deprecated-test:
    post:
      operationId: testDeprecated
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                oldField:
                  type: string
                  deprecated: true
                newField:
                  type: string
      responses:
        '200':
          description: Success
";
            RestSchemaDataProvider provider({"schema": schema_yaml});
            AbstractDataProvider p0 = provider.getChildProviderPath("deprecated-test/POST");
            assertEq("POST", p0.getName());
        }
    }

    testOpenApi3TypeValidation() {
        checkModules();

        # Test basic type validation with simple schema
        {
            string schema_yaml = "openapi: '3.0.0'
info:
  title: Simple Type Test
  version: '1.0'
paths:
  /test:
    post:
      operationId: testSimple
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                name:
                  type: string
                age:
                  type: integer
              required:
                - name
      responses:
        '200':
          description: Success
";
            RestSchemaDataProvider provider({"schema": schema_yaml});
            AbstractDataProvider p0 = provider.getChildProviderPath("test/POST");
            AbstractDataProviderType reqType = p0.getRequestType();
            *AbstractDataField bodyField = reqType.getField("body");
            assertTrue(bodyField.val());
            AbstractDataProviderType bodyType = bodyField.getType();

            # Valid data - should pass
            hash validData = {"name": "John", "age": 30};
            auto result = bodyType.acceptsValue(validData);
            assertEq("John", result.name);
            assertEq(30, result.age);

            # Valid data with only required fields
            validData = {"name": "Jane"};
            result = bodyType.acceptsValue(validData);
            assertEq("Jane", result.name);

            # Invalid data - missing required field
            hash invalidData = {"age": 25};
            assertThrows("MISSING-VALUE-ERROR", "name", \bodyType.acceptsValue(), invalidData);
        }

        # Test oneOf type validation
        {
            string schema_yaml = "openapi: '3.0.0'
info:
  title: OneOf Type Test
  version: '1.0'
paths:
  /test:
    post:
      operationId: testOneOf
      requestBody:
        required: true
        content:
          application/json:
            schema:
              oneOf:
                - type: object
                  properties:
                    petType:
                      type: string
                    bark:
                      type: boolean
                  required:
                    - petType
                    - bark
                - type: object
                  properties:
                    petType:
                      type: string
                    meow:
                      type: boolean
                  required:
                    - petType
                    - meow
      responses:
        '200':
          description: Success
";
            RestSchemaDataProvider provider({"schema": schema_yaml});
            AbstractDataProvider p0 = provider.getChildProviderPath("test/POST");
            AbstractDataProviderType reqType = p0.getRequestType();
            *AbstractDataField bodyField = reqType.getField("body");
            assertTrue(bodyField.val());
            AbstractDataProviderType bodyType = bodyField.getType();

            # Valid data - matches first schema (dog)
            hash dogData = {"petType": "dog", "bark": True};
            auto result = bodyType.acceptsValue(dogData);
            assertEq("dog", result.petType);
            assertTrue(result.bark);

            # Valid data - matches second schema (cat)
            hash catData = {"petType": "cat", "meow": True};
            result = bodyType.acceptsValue(catData);
            assertEq("cat", result.petType);
            assertTrue(result.meow);

            # Invalid data - matches neither (missing required fields)
            hash birdData = {"petType": "bird"};
            assertThrows("RUNTIME-TYPE-ERROR", "does not match any oneOf schema", \bodyType.acceptsValue(),
                birdData);

            # Invalid data - matches neither: strict schema validation rejects "meow" as an undeclared property of
            # the dog schema and "bark" as an undeclared property of the cat schema, so a hybrid object satisfies
            # neither alternative
            hash hybridData = {"petType": "hybrid", "bark": True, "meow": True};
            assertThrows("RUNTIME-TYPE-ERROR", "does not match any oneOf schema", \bodyType.acceptsValue(),
                hybridData);
        }

        # Test oneOf "matches multiple schemas" detection with overlapping alternatives
        {
            string schema_yaml = "openapi: '3.0.0'
info:
  title: OneOf Multiple Match Test
  version: '1.0'
paths:
  /test:
    post:
      operationId: testOneOfMultiple
      requestBody:
        required: true
        content:
          application/json:
            schema:
              oneOf:
                - type: object
                  properties:
                    petType:
                      type: string
                  required:
                    - petType
                - type: object
                  properties:
                    petType:
                      type: string
                    name:
                      type: string
                  required:
                    - petType
      responses:
        '200':
          description: Success
";
            RestSchemaDataProvider provider({"schema": schema_yaml});
            AbstractDataProvider p0 = provider.getChildProviderPath("test/POST");
            AbstractDataProviderType reqType = p0.getRequestType();
            *AbstractDataField bodyField = reqType.getField("body");
            assertTrue(bodyField.val());
            AbstractDataProviderType bodyType = bodyField.getType();

            # an object with only "petType" satisfies both overlapping alternatives, so oneOf must reject it as
            # matching more than one schema
            hash ambiguousData = {"petType": "ambiguous"};
            assertThrows("RUNTIME-TYPE-ERROR", "matches multiple oneOf schemas", \bodyType.acceptsValue(),
                ambiguousData);
        }

        # Test anyOf type validation
        {
            string schema_yaml = "openapi: '3.0.0'
info:
  title: AnyOf Type Test
  version: '1.0'
paths:
  /test:
    post:
      operationId: testAnyOf
      requestBody:
        required: true
        content:
          application/json:
            schema:
              anyOf:
                - type: object
                  properties:
                    name:
                      type: string
                  required:
                    - name
                - type: object
                  properties:
                    id:
                      type: integer
                  required:
                    - id
      responses:
        '200':
          description: Success
";
            RestSchemaDataProvider provider({"schema": schema_yaml});
            AbstractDataProvider p0 = provider.getChildProviderPath("test/POST");
            AbstractDataProviderType reqType = p0.getRequestType();
            *AbstractDataField bodyField = reqType.getField("body");
            assertTrue(bodyField.val());
            AbstractDataProviderType bodyType = bodyField.getType();

            # Valid data - matches first schema
            hash nameData = {"name": "John"};
            auto result = bodyType.acceptsValue(nameData);
            assertEq("John", result.name);

            # Valid data - matches second schema
            hash idData = {"id": 123};
            result = bodyType.acceptsValue(idData);
            assertEq(123, result.id);

            # Invalid data - strict schema validation rejects "id" as an undeclared property of the name schema and
            # "name" as an undeclared property of the id schema, so an object with both satisfies neither alternative
            hash bothData = {"name": "John", "id": 123};
            assertThrows("RUNTIME-TYPE-ERROR", "does not match any anyOf schema", \bodyType.acceptsValue(),
                bothData);

            # Invalid data - matches neither
            hash neitherData = {"other": "value"};
            assertThrows("RUNTIME-TYPE-ERROR", "does not match any anyOf schema", \bodyType.acceptsValue(),
                neitherData);
        }

        # Test anyOf accepting a value that matches multiple overlapping alternatives (returns the first match)
        {
            string schema_yaml = "openapi: '3.0.0'
info:
  title: AnyOf Multiple Match Test
  version: '1.0'
paths:
  /test:
    post:
      operationId: testAnyOfMultiple
      requestBody:
        required: true
        content:
          application/json:
            schema:
              anyOf:
                - type: object
                  properties:
                    petType:
                      type: string
                  required:
                    - petType
                - type: object
                  properties:
                    petType:
                      type: string
                    name:
                      type: string
                  required:
                    - petType
      responses:
        '200':
          description: Success
";
            RestSchemaDataProvider provider({"schema": schema_yaml});
            AbstractDataProvider p0 = provider.getChildProviderPath("test/POST");
            AbstractDataProviderType reqType = p0.getRequestType();
            *AbstractDataField bodyField = reqType.getField("body");
            assertTrue(bodyField.val());
            AbstractDataProviderType bodyType = bodyField.getType();

            # an object with only "petType" satisfies both overlapping alternatives; anyOf accepts it and returns
            # the value from the first matching alternative
            hash multiData = {"petType": "ambiguous"};
            auto result = bodyType.acceptsValue(multiData);
            assertEq("ambiguous", result.petType);
        }

        # Test not type validation
        {
            string schema_yaml = "openapi: '3.0.0'
info:
  title: Not Type Test
  version: '1.0'
paths:
  /test:
    post:
      operationId: testNot
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                value:
                  type: string
              not:
                type: object
                properties:
                  forbidden:
                    type: string
                required:
                  - forbidden
      responses:
        '200':
          description: Success
";
            RestSchemaDataProvider provider({"schema": schema_yaml});
            AbstractDataProvider p0 = provider.getChildProviderPath("test/POST");
            AbstractDataProviderType reqType = p0.getRequestType();
            *AbstractDataField bodyField = reqType.getField("body");
            assertTrue(bodyField.val());
            AbstractDataProviderType bodyType = bodyField.getType();

            # Valid data - does not have forbidden property
            hash validData = {"value": "allowed"};
            auto result = bodyType.acceptsValue(validData);
            assertEq("allowed", result.value);

            # Invalid data - has the forbidden property
            hash forbiddenData = {"value": "allowed", "forbidden": "not allowed"};
            assertThrows("RUNTIME-TYPE-ERROR", "'not' schema", \bodyType.acceptsValue(), forbiddenData);
        }

        # Test readOnly type validation
        {
            string schema_yaml = "openapi: '3.0.0'
info:
  title: ReadOnly Type Test
  version: '1.0'
paths:
  /test:
    post:
      operationId: testReadOnly
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                id:
                  type: integer
                  readOnly: true
                name:
                  type: string
      responses:
        '200':
          description: Success
";
            RestSchemaDataProvider provider({"schema": schema_yaml});
            AbstractDataProvider p0 = provider.getChildProviderPath("test/POST");
            AbstractDataProviderType reqType = p0.getRequestType();
            *AbstractDataField bodyField = reqType.getField("body");
            assertTrue(bodyField.val());
            AbstractDataProviderType bodyType = bodyField.getType();

            # Valid data - no readOnly field in request
            hash validData = {"name": "John"};
            auto result = bodyType.acceptsValue(validData);
            assertEq("John", result.name);

            # Invalid data - readOnly field in request
            hash invalidData = {"id": 123, "name": "John"};
            assertThrows("RUNTIME-TYPE-ERROR", "read-only", \bodyType.acceptsValue(), invalidData);
        }

        # Test writeOnly type validation
        {
            string schema_yaml = "openapi: '3.0.0'
info:
  title: WriteOnly Type Test
  version: '1.0'
paths:
  /test:
    post:
      operationId: testWriteOnly
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                password:
                  type: string
                  writeOnly: true
                username:
                  type: string
      responses:
        '200':
          description: Success
          content:
            application/json:
              schema:
                type: object
                properties:
                  password:
                    type: string
                    writeOnly: true
                  username:
                    type: string
";
            RestSchemaDataProvider provider({"schema": schema_yaml});
            AbstractDataProvider p0 = provider.getChildProviderPath("test/POST");

            # Request type - writeOnly fields are allowed
            AbstractDataProviderType reqType = p0.getRequestType();
            *AbstractDataField bodyField = reqType.getField("body");
            assertTrue(bodyField.val());
            AbstractDataProviderType reqBodyType = bodyField.getType();

            hash reqData = {"password": "secret", "username": "john"};
            auto result = reqBodyType.acceptsValue(reqData);
            assertEq("secret", result.password);
            assertEq("john", result.username);
        }

        # Test allOf type validation (properties from multiple schemas)
        {
            string schema_yaml = "openapi: '3.0.0'
info:
  title: AllOf Type Test
  version: '1.0'
paths:
  /test:
    post:
      operationId: testAllOf
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                name:
                  type: string
                age:
                  type: integer
              required:
                - name
                - age
      responses:
        '200':
          description: Success
";
            RestSchemaDataProvider provider({"schema": schema_yaml});
            AbstractDataProvider p0 = provider.getChildProviderPath("test/POST");
            AbstractDataProviderType reqType = p0.getRequestType();
            *AbstractDataField bodyField = reqType.getField("body");
            assertTrue(bodyField.val());
            AbstractDataProviderType bodyType = bodyField.getType();

            # Valid data - has all required properties
            hash validData = {"name": "John", "age": 30};
            auto result = bodyType.acceptsValue(validData);
            assertEq("John", result.name);
            assertEq(30, result.age);

            # Invalid data - missing required property
            hash missingName = {"age": 30};
            assertThrows("MISSING-VALUE-ERROR", "name", \bodyType.acceptsValue(), missingName);

            hash missingAge = {"name": "John"};
            assertThrows("MISSING-VALUE-ERROR", "age", \bodyType.acceptsValue(), missingAge);
        }
    }

    testOpenApi31Features() {
        checkModules();

        # Test OpenAPI 3.1 schema with nullable types (type array syntax)
        {
            string schemaStr = '{
                "openapi": "3.1.0",
                "info": {"title": "Test API", "version": "1.0"},
                "paths": {
                    "/test": {
                        "post": {
                            "operationId": "createTest",
                            "requestBody": {
                                "required": true,
                                "content": {
                                    "application/json": {
                                        "schema": {
                                            "type": "object",
                                            "properties": {
                                                "nullableField": {
                                                    "type": ["string", "null"]
                                                },
                                                "requiredField": {
                                                    "type": "string"
                                                }
                                            },
                                            "required": ["requiredField"]
                                        }
                                    }
                                }
                            },
                            "responses": {
                                "200": {"description": "OK"}
                            }
                        }
                    }
                }
            }';

            hash<auto> opts = {"schema": schemaStr};
            RestSchemaDataProvider provider(opts);
            assertFalse(provider.isSwagger());
            assertTrue(provider.isOpenApi3());

            # Verify the provider can access the path
            AbstractDataProvider p0 = provider.getChildProviderPath("test/POST");
            assertEq("POST", p0.getInfo().name);

            # Get the request type and verify nullable field handling
            AbstractDataProviderType req = p0.getRequestType();
            assertEq(NT_HASH, req.getField("body").getType().getBaseTypeCode());
        }

        # Test OpenAPI 3.1 version detection via is31OrLater
        {
            string schema31 = '{
                "openapi": "3.1.0",
                "info": {"title": "Test API 3.1", "version": "1.0"},
                "paths": {}
            }';
            hash<auto> opts = {"schema": schema31};
            RestSchemaDataProvider provider(opts);
            assertTrue(provider.isOpenApi3());
            # Get the underlying schema object to verify version
            assertEq("Test API 3.1", provider.getName());
        }

        # Test OpenAPI 3.0 backward compatibility
        {
            string schema30 = '{
                "openapi": "3.0.3",
                "info": {"title": "Test API 3.0", "version": "1.0"},
                "paths": {}
            }';
            hash<auto> opts = {"schema": schema30};
            RestSchemaDataProvider provider(opts);
            assertTrue(provider.isOpenApi3());
            assertEq("Test API 3.0", provider.getName());
        }
    }

    testAbstractValidatorQueryDateOptions() {
        checkModules();

        AbstractRestSchemaValidator null_validator = new NullRestSchemaValidator();
        assertEq(NOTHING, null_validator.getUtcDates());
        assertEq(NOTHING, null_validator.getQueryDateFormat());

        string swagger_schema = '{
            "swagger": "2.0",
            "info": {"title": "Swagger Date Options", "version": "1"},
            "paths": {}
        }';
        AbstractRestSchemaValidator swagger_default = SwaggerLoader::fromString(swagger_schema, True);
        assertEq(NOTHING, swagger_default.getUtcDates());
        assertEq(NOTHING, swagger_default.getQueryDateFormat());

        AbstractRestSchemaValidator swagger_schema_obj = SwaggerLoader::fromString(swagger_schema, True, {
            "utc_dates": True,
            "query_date_format": "YYYY-MM-DD",
        });
        RestSchemaDataProvider swagger_provider(swagger_schema_obj);
        AbstractRestSchemaValidator swagger_provider_schema = swagger_provider.getSchema();
        assertTrue(swagger_provider_schema.getUtcDates());
        assertEq("YYYY-MM-DD", swagger_provider_schema.getQueryDateFormat());

        string openapi3_schema = '{
            "openapi": "3.0.0",
            "info": {"title": "OpenAPI Date Options", "version": "1"},
            "paths": {}
        }';
        AbstractRestSchemaValidator openapi3_default = OpenApi3Loader::fromString(openapi3_schema, True);
        assertEq(NOTHING, openapi3_default.getUtcDates());
        assertEq(NOTHING, openapi3_default.getQueryDateFormat());

        AbstractRestSchemaValidator openapi3_schema_obj = OpenApi3Loader::fromString(openapi3_schema, True, {
            "utc_dates": False,
            "query_date_format": "YYYY-MM-DDTHH:mm:SS",
        });
        RestSchemaDataProvider openapi3_provider(openapi3_schema_obj);
        AbstractRestSchemaValidator openapi3_provider_schema = openapi3_provider.getSchema();
        assertFalse(openapi3_provider_schema.getUtcDates());
        assertEq("YYYY-MM-DDTHH:mm:SS", openapi3_provider_schema.getQueryDateFormat());
    }

    testOverlappingSwaggerPaths() {
        checkModules();

        string schema = '{
            "swagger": "2.0",
            "info": {"title": "AOT Reference Test", "version": "1"},
            "paths": {
                "/events": {
                    "get": {"responses": {"200": {"description": "ok"}}}
                },
                "/events/{id}": {
                    "get": {"responses": {"200": {"description": "ok"}}}
                },
                "/events/{id}/foo": {
                    "post": {"responses": {"200": {"description": "ok"}}}
                }
            }
        }';

        RestSchemaDataProvider provider({"schema": schema});
        assertTrue(provider.isSwagger());
        assertEq("AOT Reference Test", provider.getName());
        assertEq(("events",), provider.getChildProviderNames());

        AbstractDataProvider events = provider.getChildProvider("events");
        assertEq(("*", "GET"), events.getChildProviderNames());

        AbstractDataProvider get = provider.getChildProviderPath("events/GET");
        assertEq("GET", get.getName());
    }

    testFactory() {
        checkModules();

        RestSchemaDataProviderFactory factory();
        hash<DataProviderFactoryInfo> info = factory.getInfo();
        assertEq("restschema", info.name);
        assertTrue(info.api_management);
        assertTrue(info.children_can_support_apis);
        assertEq(("rest",), info.api_profiles);
    }
}
