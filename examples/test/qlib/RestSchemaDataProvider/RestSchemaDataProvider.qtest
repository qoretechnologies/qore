#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

# try importing JSON and YAML modules
%try-module json
%define NoJson
%endtry
%try-module yaml
%define NoYaml
%endtry

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires Mime
%requires QUnit
%requires FsUtil
%requires Logger
%requires DataProvider
%requires HttpServerUtil
%requires RestSchemaValidator
%requires Swagger
%requires OpenApi3
%requires ConnectionProvider
%requires RestClient
%requires AsyncSocketIo
%requires HttpClientIo
%requires RestClientIo
%requires RestSchemaDataProvider

%exec-class RestSchemaDataProviderTest

public class RestSchemaDataProviderTest inherits QUnit::Test {
    constructor() : Test("RestSchemaDataProviderTest", "1.0") {
        addTestCase("Swagger schema test", \testSwaggerSchema());
        addTestCase("OpenAPI 3.0 schema test", \testOpenApi3Schema());
        addTestCase("inline schema content detection", \testInlineSchemaContentDetection());
        addTestCase("OpenAPI 3.0 schema composition test", \testOpenApi3SchemaComposition());
        addTestCase("OpenAPI 3.0 data provider type validation", \testOpenApi3TypeValidation());
        addTestCase("OpenAPI 3.1 data provider features", \testOpenApi31Features());
        addTestCase("Abstract validator query date options", \testAbstractValidatorQueryDateOptions());
        addTestCase("Overlapping Swagger paths test", \testOverlappingSwaggerPaths());
        addTestCase("Factory test", \testFactory());
        set_return_value(main());
    }

    checkModules() {
%ifdef NoJson
        testSkip("no json module");
%endif
%ifdef NoYaml
        testSkip("no yaml module");
%endif
    }

    testSwaggerSchema() {
        checkModules();

        bool set = AbstractDataProvider::setDynamicValueCallbacks(
            bool sub (auto uri_path) { return uri_path =~ /\$/; },
            auto sub (auto uri_path) { uri_path =~ s/\$id/1/; return uri_path; });
        assertTrue(set);
        assertFalse(AbstractDataProvider::setDynamicValueCallbacks());

        hash<auto> opts = {
            "schema": get_script_dir() + "/../Swagger/PetStore.swagger.yaml",
        };
        RestSchemaDataProvider provider(opts);
        assertEq("Swagger Petstore", provider.getName());
        assertTrue(provider.isSwagger());
        assertFalse(provider.isOpenApi3());

        {
            AbstractDataProvider p0 = provider.getChildProviderPath("pet/findByStatus/GET");
            object rp0 = cast<object>(p0);
            assertEq("GET", rp0.getOperation().method);
            AbstractDataProviderType req = p0.getRequestType();
            assertEq(NT_HASH, req.getField("query").getType().getBaseTypeCode());
            AbstractDataProviderType resp = p0.getResponseType();
            AbstractDataProviderType type = resp.getField("body").getType().getElementType();
            assertEq("*softint", type.getFieldType("id").getName());
            assertEq("softstring", type.getFieldType("name").getName());
            assertEq(("id", "category", "name", "photoUrls", "tags", "status"), keys type.getFields());

            # Note: doRequest() actually connects to external API, so check manually
            # to handle connection errors gracefully in CI
            try {
                p0.doRequest({"query": {"status": ("x",)}});
                fail("expected SCHEMA-VALIDATION-ERROR exception");
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err == "SOCKET-CONNECT-ERROR" || ex.err == "SOCKET-SSL-ERROR"
                        || ex.err == "QOREADDRINFO-GETINFO-ERROR" || ex.err == "SOCKET-TIMEOUT" || ex.err == "HTTPCLIENT-NEGOTIATE-TIMEOUT" || ex.err == "HTTPCLIENT-TIMEOUT") {
                    # Skip - external API is unavailable
                } else if (ex.err == "SCHEMA-VALIDATION-ERROR") {
                    assertTrue(ex.desc =~ /enumerated values.*x/);
                } else {
                    rethrow;
                }
            }
        }

        {
            AbstractDataProvider p0 = provider.getChildProviderPath("pet/$id/POST");
            assertEq("POST", p0.getInfo().name);
            AbstractDataProviderType req = p0.getRequestType();
            assertEq(NT_HASH, req.getField("formData").getType().getBaseTypeCode());
        }

        # Test with schema string
        opts.schema = File::readTextFile(opts.schema);
        provider = new RestSchemaDataProvider(opts);
        {
            AbstractDataProvider p0 = provider.getChildProviderPath("pet/findByStatus/GET");
            object rp0 = cast<object>(p0);
            assertEq("GET", rp0.getOperation().method);
            AbstractDataProviderType req = p0.getRequestType();
            assertEq(NT_HASH, req.getField("query").getType().getBaseTypeCode());
        }
    }

    testOpenApi3Schema() {
        checkModules();

        hash<auto> opts = {
            "schema": get_script_dir() + "/../OpenApi3/PetStore.openapi3.yaml",
        };
        RestSchemaDataProvider provider(opts);
        assertEq("Swagger Petstore", provider.getName());
        assertFalse(provider.isSwagger());
        assertTrue(provider.isOpenApi3());

        {
            AbstractDataProvider p0 = provider.getChildProviderPath("pets/GET");
            AbstractDataProviderType req = p0.getRequestType();
            # OpenAPI 3.0 PetStore has query parameters
            *AbstractDataField queryField = req.getField("query");
            if (queryField) {
                assertEq(NT_HASH, queryField.getType().getBaseTypeCode());
            }
            AbstractDataProviderType resp = p0.getResponseType();
            *AbstractDataField bodyField = resp.getField("body");
            if (bodyField) {
                assertEq(Type::List, bodyField.getType().getBaseTypeName());
            }
        }

        # Test with schema string
        opts.schema = File::readTextFile(opts.schema);
        provider = new RestSchemaDataProvider(opts);
        assertTrue(provider.isOpenApi3());
        {
            AbstractDataProvider p0 = provider.getChildProviderPath("pets/GET");
            assertEq("GET", p0.getName());
        }
    }

    # An inline "schema" string passed by value must be recognized as schema content even when it does not
    # begin with a bare "openapi:"/"swagger:"/"{" token.  A YAML serializer can emit a document prefixed
    # with a "%YAML 1.2" version directive and/or a "---" document-start marker, in flow style; such a
    # document was previously misclassified as a filesystem path and failed to open (qorus#327 follow-up).
    testInlineSchemaContentDetection() {
        checkModules();

        # 1. "%YAML 1.2" directive + "---" marker + flow style (the exact shape make_yaml() emits by
        #    default, and the shape that triggered the original failure)
        {
            string directive_flow = "%YAML 1.2\n"
                "--- {openapi: \"3.0.3\", info: {title: \"directive flow\", version: \"1.0.0\"}, "
                "paths: {/ping: {get: {operationId: \"ping\", responses: {\"200\": {description: \"ok\"}}}}}}\n";
            RestSchemaDataProvider provider({"schema": directive_flow});
            assertTrue(provider.isOpenApi3(), "directive+flow OpenAPI 3 document is loaded as inline content");
            assertEq("GET", provider.getChildProviderPath("ping/GET").getName());
        }

        # 2. flow style without a directive (leading "{")
        {
            string flow = "{openapi: \"3.0.0\", info: {title: \"flow\", version: \"1.0.0\"}, "
                "paths: {/ping: {get: {operationId: \"ping\", responses: {\"200\": {description: \"ok\"}}}}}}";
            RestSchemaDataProvider provider({"schema": flow});
            assertTrue(provider.isOpenApi3(), "flow-style OpenAPI 3 document is loaded as inline content");
        }

        # 3. block style with a leading "---" document-start marker
        {
            string block_marker = "---\n"
                "openapi: \"3.0.0\"\n"
                "info:\n"
                "  title: block marker\n"
                "  version: \"1.0.0\"\n"
                "paths:\n"
                "  /ping:\n"
                "    get:\n"
                "      operationId: ping\n"
                "      responses:\n"
                "        \"200\":\n"
                "          description: ok\n";
            RestSchemaDataProvider provider({"schema": block_marker});
            assertTrue(provider.isOpenApi3(), "block document with leading '---' marker is loaded as inline content");
        }
    }

    testOpenApi3SchemaComposition() {
        checkModules();

        # Test allOf - value must match all schemas
        {
            string schema_yaml = "openapi: '3.0.0'
info:
  title: Schema Composition Test
  version: '1.0'
paths:
  /allof-test:
    post:
      operationId: testAllOf
      requestBody:
        required: true
        content:
          application/json:
            schema:
              allOf:
                - type: object
                  properties:
                    name:
                      type: string
                  required:
                    - name
                - type: object
                  properties:
                    age:
                      type: integer
                  required:
                    - age
      responses:
        '200':
          description: Success
";
            RestSchemaDataProvider provider({"schema": schema_yaml});
            AbstractDataProvider p0 = provider.getChildProviderPath("allof-test/POST");
            assertEq("POST", p0.getName());
        }

        # Test oneOf - value must match exactly one schema
        {
            string schema_yaml = "openapi: '3.0.0'
info:
  title: OneOf Test
  version: '1.0'
paths:
  /oneof-test:
    post:
      operationId: testOneOf
      requestBody:
        required: true
        content:
          application/json:
            schema:
              oneOf:
                - type: object
                  properties:
                    petType:
                      type: string
                    bark:
                      type: boolean
                  required:
                    - petType
                    - bark
                - type: object
                  properties:
                    petType:
                      type: string
                    meow:
                      type: boolean
                  required:
                    - petType
                    - meow
      responses:
        '200':
          description: Success
";
            RestSchemaDataProvider provider({"schema": schema_yaml});
            AbstractDataProvider p0 = provider.getChildProviderPath("oneof-test/POST");
            assertEq("POST", p0.getName());
        }

        # Test anyOf - value must match at least one schema
        {
            string schema_yaml = "openapi: '3.0.0'
info:
  title: AnyOf Test
  version: '1.0'
paths:
  /anyof-test:
    post:
      operationId: testAnyOf
      requestBody:
        required: true
        content:
          application/json:
            schema:
              anyOf:
                - type: object
                  properties:
                    name:
                      type: string
                  required:
                    - name
                - type: object
                  properties:
                    id:
                      type: integer
                  required:
                    - id
      responses:
        '200':
          description: Success
";
            RestSchemaDataProvider provider({"schema": schema_yaml});
            AbstractDataProvider p0 = provider.getChildProviderPath("anyof-test/POST");
            assertEq("POST", p0.getName());
        }

        # Test not - value must NOT match the schema
        {
            string schema_yaml = "openapi: '3.0.0'
info:
  title: Not Test
  version: '1.0'
paths:
  /not-test:
    post:
      operationId: testNot
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                value:
                  type: string
              not:
                type: object
                properties:
                  forbidden:
                    type: string
                required:
                  - forbidden
      responses:
        '200':
          description: Success
";
            RestSchemaDataProvider provider({"schema": schema_yaml});
            AbstractDataProvider p0 = provider.getChildProviderPath("not-test/POST");
            assertEq("POST", p0.getName());
        }

        # Test readOnly - property cannot be in request
        {
            string schema_yaml = "openapi: '3.0.0'
info:
  title: ReadOnly Test
  version: '1.0'
paths:
  /readonly-test:
    post:
      operationId: testReadOnly
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                id:
                  type: integer
                  readOnly: true
                name:
                  type: string
      responses:
        '200':
          description: Success
          content:
            application/json:
              schema:
                type: object
                properties:
                  id:
                    type: integer
                    readOnly: true
                  name:
                    type: string
";
            RestSchemaDataProvider provider({"schema": schema_yaml});
            AbstractDataProvider p0 = provider.getChildProviderPath("readonly-test/POST");
            assertEq("POST", p0.getName());
        }

        # Test writeOnly - property cannot be in response
        {
            string schema_yaml = "openapi: '3.0.0'
info:
  title: WriteOnly Test
  version: '1.0'
paths:
  /writeonly-test:
    post:
      operationId: testWriteOnly
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
