        assertTrue(createInvoiceFields.hasKey("notes"));
        assertTrue(createInvoiceFields.hasKey("terms"));
        assertTrue(createInvoiceFields.hasKey("discount_value"));
    }

    #! Trigger example data tests - verify getExampleEventData() for all triggers
    triggerExampleDataTests() {
        checkJson();
        FreshBooksDataProvider::FreshBooksDataProvider prov;
        try {
            prov = new FreshBooksDataProvider::FreshBooksDataProvider({
                "freshbooksrestclient_options": {
                    "token": "fake-token",
                    "account_id": "fake-account",
                    "business_id": "fake-business",
                },
            });
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "OAUTH2-ERROR") {
                testSkip("OAuth2 requires manual authorization - skipping trigger tests");
            }
            if (ex.err == "QOREADDRINFO-GETINFO-ERROR") {
                testSkip("no network connection - skipping trigger tests");
            }
            rethrow;
        }

        AbstractDataProvider events = prov.getChildProvider("events");
        list<string> triggerNames = (
            "invoice-created",
            "payment-created",
            "client-created",
            "expense-created",
            "estimate-created",
        );

        foreach string triggerName in (triggerNames) {
            AbstractDataProvider triggerProvider = events.getChildProvider(triggerName);

            # Verify event types are defined
            hash<string, hash<DataProviderMessageInfo>> eventTypes = triggerProvider.getEventTypes();
            assertTrue(eventTypes.hasKey(triggerName),
                sprintf("%s should define event type '%s'", triggerName, triggerName));

            # Verify event type has a data type
            assertTrue(eventTypes{triggerName}.type instanceof AbstractDataProviderType,
                sprintf("%s event type should have a data type", triggerName));

            # Get example event data (will fall back to fake data since we have fake credentials)
            auto exampleData = triggerProvider.getExampleEventData(triggerName);
            assertTrue(exampleData instanceof hash,
                sprintf("%s getExampleEventData() should return a hash", triggerName));

            # Verify example data has basic fields
            hash<auto> data = exampleData;
            assertTrue(data.hasKey("id"),
                sprintf("%s example data should have 'id' field", triggerName));
        }

        # Verify resource-specific fields in example data
        auto invoiceExample = events.getChildProvider("invoice-created")
            .getExampleEventData("invoice-created");
        assertTrue(invoiceExample.hasKey("invoiceid"), "Invoice example should have invoiceid");
        assertTrue(invoiceExample.hasKey("invoice_number"), "Invoice example should have invoice_number");
        assertTrue(invoiceExample.hasKey("customerid"), "Invoice example should have customerid");

        auto paymentExample = events.getChildProvider("payment-created")
            .getExampleEventData("payment-created");
        assertTrue(paymentExample.hasKey("paymentid"), "Payment example should have paymentid");
        assertTrue(paymentExample.hasKey("invoiceid"), "Payment example should have invoiceid");

        auto clientExample = events.getChildProvider("client-created")
            .getExampleEventData("client-created");
        assertTrue(clientExample.hasKey("fname"), "Client example should have fname");
        assertTrue(clientExample.hasKey("lname"), "Client example should have lname");
        assertTrue(clientExample.hasKey("email"), "Client example should have email");

        auto expenseExample = events.getChildProvider("expense-created")
            .getExampleEventData("expense-created");
        assertTrue(expenseExample.hasKey("expenseid"), "Expense example should have expenseid");
        assertTrue(expenseExample.hasKey("vendor"), "Expense example should have vendor");

        auto estimateExample = events.getChildProvider("estimate-created")
            .getExampleEventData("estimate-created");
        assertTrue(estimateExample.hasKey("estimateid"), "Estimate example should have estimateid");
        assertTrue(estimateExample.hasKey("estimate_number"),
            "Estimate example should have estimate_number");
    }

    #! Negative tests - test error handling and invalid inputs
    negativeTests() {
        checkJson();
        FreshBooksDataProvider::FreshBooksDataProvider prov;
        try {
            prov = new FreshBooksDataProvider::FreshBooksDataProvider({
                "freshbooksrestclient_options": {
                    "token": "fake-token",
                    "account_id": "fake-account",
                    "business_id": "fake-business",
                },
            });
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "OAUTH2-ERROR") {
                testSkip("OAuth2 requires manual authorization - skipping negative tests");
            }
            if (ex.err == "QOREADDRINFO-GETINFO-ERROR") {
                testSkip("no network connection - skipping negative tests");
            }
            rethrow;
        }

        # Test getting non-existent child provider
        assertThrows("INVALID-CHILD-PROVIDER", sub() {
            prov.getChildProviderEx("nonexistent");
        });

        # Test invalid child in events provider
        AbstractDataProvider events = prov.getChildProvider("events");
        assertThrows("INVALID-CHILD-PROVIDER", sub() {
            events.getChildProviderEx("invalid-event");
        });
    }

    #! Connection tests - verify connection scheme registration
    connectionTests() {
        checkJson();
        # Verify connection scheme is registered
        hash<ConnectionSchemeInfo> scheme = ConnectionSchemeCache::getScheme("freshbooks");
        assertEq("FreshBooks REST Connection", scheme.display_name);
        assertTrue(scheme.short_desc.val());
        assertTrue(scheme.desc.val());

        # Verify required options
        assertTrue(scheme.options.hasKey("account_id"));
        assertTrue(scheme.options.hasKey("business_id"));
        assertTrue(scheme.options.hasKey("oauth2_client_id"));
        assertTrue(scheme.options.hasKey("oauth2_client_secret"));

        # Verify connection can be created
        FreshBooksRestClient::FreshBooksRestConnection conn("test", "test connection",
            FreshBooksRestClient::FreshBooksRestClient::DefaultUrl, {}, {
                "oauth2_client_id": "x",
                "oauth2_client_secret": "x",
                "account_id": "test-account",
                "business_id": "test-business",
            });
        assertTrue(conn.hasDataProvider());
        assertEq("FreshBooks", conn.getAppName());
        assertEq("freshbooks", conn.getType());
    }

    #! Integration tests - require FreshBooks credentials
    integrationTests() {
        checkJson();
        if (!client) {
            testSkip("No FreshBooks credentials provided (use -t, -a, -b options or env vars)");
            return;
        }

        # Test API connectivity
        testApiConnectivity();

        # Test client CRUD flow: create -> search -> update
        testClientCrudFlow();

        # Test expense CRUD flow: create -> get -> delete
        testExpenseCrudFlow();

        # Test item CRUD flow: create -> search -> update
        testItemCrudFlow();

        # Test service CRUD flow: create -> search -> update
        testServiceCrudFlow();

        # Test invoice CRUD flow (requires client): create -> search -> update
        if (testClientId) {
            testInvoiceCrudFlow();
        }

        # Test estimate flow (requires client): create -> search
        if (testClientId) {
            testEstimateCrudFlow();
        }

        # Test payment flow (requires invoice): create -> update -> delete
        if (testInvoiceId) {
            testPaymentCrudFlow();
        }

        # Test get-* (DPAT_FIND_SINGLE) for all entity types
        testGetSingleRecords();

        # Test execute-api-call
        testExecuteApiCall();

        # Cleanup test data
        cleanup();
    }

    #! Test API connectivity
    private testApiConnectivity() {
        if (m_options.verbose) {
            printf("\n--- Testing API Connectivity ---\n");
        }

        # Test that we can connect to the API via the identity endpoint
        hash<auto> response = client.get("/auth/api/v1/users/me");
        assertTrue(response.body.response.id.val() || response.body.response.first_name.val());
        if (m_options.verbose) {
            printf("Connected to FreshBooks - User: %s %s\n",
                response.body.response.first_name ?? "N/A",
                response.body.response.last_name ?? "N/A");
        }

        if (m_options.verbose) {
            printf("--- API Connectivity tests completed ---\n");
        }
