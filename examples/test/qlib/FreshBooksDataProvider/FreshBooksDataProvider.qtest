                    verifyPayments[0].note, verifyPayments[0].type);
            }

            # Step 5: Delete the payment (soft delete via vis_state = 1)
            AbstractDataProvider deletePaymentProvider = prov.getChildProvider("delete-payment");
            hash<auto> deleteResult = deletePaymentProvider.doRequest({
                "account_id": accountId,
                "id": testPaymentId,
            });
            if (m_options.verbose) {
                printf("Deleted payment: ID %d (vis_state: %d)\n",
                    testPaymentId, deleteResult.vis_state ?? -1);
            }

            # Step 6: Verify deletion - payment should have vis_state = 1
            sleep(500ms);
            list<hash<auto>> deletedPayments = map $1, paymentsProvider.searchRecords(
                NOTHING, {"account_id": accountId, "id": testPaymentId});
            if (deletedPayments.size() > 0) {
                assertEq(1, deletedPayments[0].vis_state,
                    "Deleted payment should have vis_state = 1");
                if (m_options.verbose) {
                    printf("Verified payment deletion: vis_state = %d\n",
                        deletedPayments[0].vis_state);
                }
            }
            # Mark as cleaned up
            testPaymentId = NOTHING;
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("Payment CRUD flow failed: %s: %s\n", ex.err, ex.desc);
            }
            rethrow;
        }

        if (m_options.verbose) {
            printf("--- Payment CRUD Flow tests completed ---\n");
        }
    }

    #! Test get-* (DPAT_FIND_SINGLE) actions for all entity types
    private testGetSingleRecords() {
        if (m_options.verbose) {
            printf("\n--- Testing Get Single Record (DPAT_FIND_SINGLE) ---\n");
        }

        FreshBooksDataProvider::FreshBooksDataProvider prov(client);

        # Test get-client (DPAT_FIND_SINGLE)
        if (testClientId) {
            AbstractDataProvider clientsProvider = prov.getChildProvider("clients");
            list<hash<auto>> result = map $1, clientsProvider.searchRecords(
                NOTHING, {"account_id": accountId, "id": testClientId});
            assertEq(1, result.size(), "get-client should return exactly one client");
            assertEq(testClientId, result[0].id, "get-client should return the correct client");
            assertTrue(result[0].fname.val() || result[0].lname.val() || result[0].organization.val(),
                "get-client should return client data with name fields");
            if (m_options.verbose) {
                printf("get-client: OK (ID: %d, name: %s %s)\n",
                    result[0].id, result[0].fname ?? "", result[0].lname ?? "");
            }
        }

        # Test get-item (DPAT_FIND_SINGLE)
        if (testItemId) {
            AbstractDataProvider itemsProvider = prov.getChildProvider("items");
            list<hash<auto>> result = map $1, itemsProvider.searchRecords(
                NOTHING, {"account_id": accountId, "id": testItemId});
            assertEq(1, result.size(), "get-item should return exactly one item");
            assertEq(testItemId, result[0].id, "get-item should return the correct item");
            assertTrue(result[0].name.val(), "get-item should return item with a name");
            if (m_options.verbose) {
                printf("get-item: OK (ID: %d, name: %s)\n", result[0].id, result[0].name);
            }
        }

        # Note: get-service, get-expense, get-estimate, get-payment are tested within
        # their respective CRUD flows (step 2: search by ID)

        # Test get-invoice (DPAT_FIND_SINGLE)
        if (testInvoiceId) {
            AbstractDataProvider invoicesProvider = prov.getChildProvider("invoices");
            list<hash<auto>> result = map $1, invoicesProvider.searchRecords(
                NOTHING, {"account_id": accountId, "id": testInvoiceId});
            assertEq(1, result.size(), "get-invoice should return exactly one invoice");
            assertEq(testInvoiceId, result[0].id, "get-invoice should return the correct invoice");
            assertEq(testClientId, result[0].customerid,
                "get-invoice should return invoice with correct customer");
            if (m_options.verbose) {
                printf("get-invoice: OK (ID: %d, number: %s)\n",
                    result[0].id, result[0].invoice_number ?? "N/A");
            }
        }

        if (m_options.verbose) {
            printf("--- Get Single Record tests completed ---\n");
        }
    }

    #! Test execute-api-call provider
    private testExecuteApiCall() {
        if (m_options.verbose) {
            printf("\n--- Testing Execute API Call ---\n");
        }

        FreshBooksDataProvider::FreshBooksDataProvider prov(client);
        AbstractDataProvider apiCallProvider = prov.getChildProvider("execute-api-call");

        # Test GET request via execute-api-call
        hash<auto> result = apiCallProvider.doRequest({
            "method": "GET",
            "path": "/auth/api/v1/users/me",
        });
        assertTrue(result.id.val() || result.first_name.val(),
            "execute-api-call GET should return user data");
        if (m_options.verbose) {
            printf("execute-api-call GET: OK (user: %s %s)\n",
                result.first_name ?? "N/A", result.last_name ?? "N/A");
        }

        if (m_options.verbose) {
            printf("--- Execute API Call tests completed ---\n");
        }
    }

    #! Cleanup test data
    private cleanup() {
        if (m_options.verbose) {
            printf("\n--- Cleanup ---\n");
        }

        FreshBooksDataProvider::FreshBooksDataProvider prov(client);

        # Delete test payment if not already deleted
        if (testPaymentId) {
            try {
                AbstractDataProvider deletePaymentProvider = prov.getChildProvider("delete-payment");
                deletePaymentProvider.doRequest({"account_id": accountId, "id": testPaymentId});
                if (m_options.verbose) {
                    printf("Soft-deleted test payment: %d\n", testPaymentId);
                }
            } catch (hash<ExceptionInfo> ex) {
                if (m_options.verbose) {
                    printf("Failed to delete payment: %s\n", ex.desc);
