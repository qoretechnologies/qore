    #! Test client CRUD flow: create -> search -> update -> verify
    private testClientCrudFlow() {
        if (m_options.verbose) {
            printf("\n--- Testing Client CRUD Flow ---\n");
        }

        FreshBooksDataProvider::FreshBooksDataProvider prov(client);

        # Step 1: Create a test client
        AbstractDataProvider createClientProvider = prov.getChildProvider("create-client");
        string testOrgName = sprintf("Test Org %s", now_us().format("YYYYMMDDHHmmss"));

        try {
            hash<auto> newClient = createClientProvider.doRequest({
                "account_id": accountId,
                "fname": "IntTest",
                "lname": "Client",
                "email": sprintf("inttest-%s@example.com", now_us().format("YYYYMMDDHHmmss")),
                "organization": testOrgName,
                "note": "Created by FreshBooks integration test",
