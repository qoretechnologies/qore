                    foundClient.fname, foundClient.lname, foundClient.organization);
            }

            # Step 3: Update the client
            AbstractDataProvider updateClientProvider = prov.getChildProvider("update-client");
            string updatedOrg = sprintf("Updated Org %s", now_us().format("YYYYMMDDHHmmss"));
            updateClientProvider.doRequest({
                "account_id": accountId,
                "id": testClientId,
                "organization": updatedOrg,
                "note": "Updated by integration test",
            });

            if (m_options.verbose) {
                printf("Updated client organization to: %s\n", updatedOrg);
            }

            # Step 4: Verify update persisted by re-fetching
            sleep(500ms);
            list<hash<auto>> verifyClients = map $1, clientsProvider.searchRecords(
                NOTHING, {"account_id": accountId, "id": testClientId});
            assertTrue(verifyClients.size() > 0, "Should find the updated client");
            assertEq(updatedOrg, verifyClients[0].organization,
                "Organization update should persist");
            if (m_options.verbose) {
                printf("Verified update persisted: organization = %s\n",
                    verifyClients[0].organization);
            }
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("Client CRUD flow failed: %s: %s\n", ex.err, ex.desc);
            }
            rethrow;
        }

        if (m_options.verbose) {
            printf("--- Client CRUD Flow tests completed ---\n");
        }
    }

    #! Test expense CRUD flow: create -> get -> delete -> verify
    private testExpenseCrudFlow() {
        if (m_options.verbose) {
            printf("\n--- Testing Expense CRUD Flow ---\n");
        }

        FreshBooksDataProvider::FreshBooksDataProvider prov(client);

        # Step 0: Get a valid expense category ID
        hash<auto> catResponse = client.get(
            sprintf("/accounting/account/%s/expenses/categories", accountId));
        int categoryId = catResponse.body.response.result.categories[0].id;
        if (m_options.verbose) {
            printf("Using expense category: %s (ID: %d)\n",
                catResponse.body.response.result.categories[0].category, categoryId);
        }

        # Step 1: Create a test expense
        AbstractDataProvider createExpenseProvider = prov.getChildProvider("create-expense");
        string testNotes = sprintf("Test expense %s", now_us().format("YYYYMMDDHHmmss"));
        string expenseDate = now().format("YYYY-MM-DD");

        try {
            hash<auto> newExpense = createExpenseProvider.doRequest({
                "account_id": accountId,
                "staffid": 1,
                "categoryid": categoryId,
                "amount": {"amount": "75.50", "code": "USD"},
                "vendor": "Test Vendor Inc",
                "date": expenseDate,
                "notes": testNotes,
            });

            assertTrue(newExpense.id.val(), "Expense should be created with an ID");
            testExpenseId = newExpense.id;
            if (m_options.verbose) {
                printf("Created test expense: %s (ID: %d)\n", testNotes, testExpenseId);
            }

            # Step 2: Get the expense via the expenses collection provider to verify persistence
            sleep(500ms);
            AbstractDataProvider expensesProvider = prov.getChildProvider("expenses");
            list<hash<auto>> expenses = map $1, expensesProvider.searchRecords(
                NOTHING, {"account_id": accountId, "id": testExpenseId});
            assertTrue(expenses.size() > 0, "Should find the created expense by ID");

            # Verify data persistence
            hash<auto> foundExpense = expenses[0];
            assertEq(testExpenseId, foundExpense.id);
            assertEq("Test Vendor Inc", foundExpense.vendor);
            assertEq(testNotes, foundExpense.notes);
            assertEq(expenseDate, foundExpense.date);
            if (m_options.verbose) {
                printf("Verified expense: vendor=%s, notes=%s, date=%s\n",
                    foundExpense.vendor, foundExpense.notes, foundExpense.date);
            }

            # Step 3: Update the expense
            AbstractDataProvider updateExpenseProvider = prov.getChildProvider("update-expense");
            updateExpenseProvider.doRequest({
                "account_id": accountId,
                "id": testExpenseId,
                "vendor": "Updated Vendor Inc",
                "notes": "Updated by integration test",
            });
            if (m_options.verbose) {
                printf("Updated expense: ID %d\n", testExpenseId);
            }

            # Step 4: Verify update persisted
            sleep(500ms);
            list<hash<auto>> verifyExpenses = map $1, expensesProvider.searchRecords(
                NOTHING, {"account_id": accountId, "id": testExpenseId});
            assertTrue(verifyExpenses.size() > 0, "Should find the updated expense");
            assertEq("Updated Vendor Inc", verifyExpenses[0].vendor,
                "Expense vendor update should persist");
            assertEq("Updated by integration test", verifyExpenses[0].notes,
                "Expense notes update should persist");
            if (m_options.verbose) {
                printf("Verified update persisted: vendor=%s, notes=%s\n",
                    verifyExpenses[0].vendor, verifyExpenses[0].notes);
            }

            # Step 5: Delete the expense (soft delete via vis_state = 1)
            AbstractDataProvider deleteExpenseProvider = prov.getChildProvider("delete-expense");
            hash<auto> deleteResult = deleteExpenseProvider.doRequest({
                "account_id": accountId,
                "id": testExpenseId,
            });
            if (m_options.verbose) {
                printf("Deleted expense: ID %d (vis_state: %d)\n",
                    testExpenseId, deleteResult.vis_state ?? -1);
            }

            # Step 6: Verify deletion - expense should now have vis_state = 1
            sleep(500ms);
            list<hash<auto>> deletedExpenses = map $1, expensesProvider.searchRecords(
                NOTHING, {"account_id": accountId, "id": testExpenseId});
            if (deletedExpenses.size() > 0) {
                assertEq(1, deletedExpenses[0].vis_state,
                    "Deleted expense should have vis_state = 1");
                if (m_options.verbose) {
                    printf("Verified expense deletion: vis_state = %d\n",
                        deletedExpenses[0].vis_state);
                }
            }
            # Mark as cleaned up so we don't try to delete again
            testExpenseId = NOTHING;
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("Expense CRUD flow failed: %s: %s\n", ex.err, ex.desc);
            }
            rethrow;
        }

        if (m_options.verbose) {
            printf("--- Expense CRUD Flow tests completed ---\n");
        }
    }

