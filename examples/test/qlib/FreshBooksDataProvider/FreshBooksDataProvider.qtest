            testClientId = newClient.id;
            if (m_options.verbose) {
                printf("Created test client: %s (ID: %d)\n", testOrgName, testClientId);
            }

            # Step 2: Search for the client via the clients collection provider
            sleep(500ms);
            AbstractDataProvider clientsProvider = prov.getChildProvider("clients");
            list<hash<auto>> clients = map $1, clientsProvider.searchRecords(
                NOTHING, {"account_id": accountId, "id": testClientId});
            assertTrue(clients.size() > 0, "Should find the created client by ID");

            # Verify data persistence - the values we set must be returned
            hash<auto> foundClient = clients[0];
            assertEq(testClientId, foundClient.id);
            assertEq("IntTest", foundClient.fname);
            assertEq("Client", foundClient.lname);
            assertEq(testOrgName, foundClient.organization);
            if (m_options.verbose) {
