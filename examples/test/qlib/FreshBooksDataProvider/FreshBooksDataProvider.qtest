    #! Test invoice CRUD flow: create -> search -> update -> verify data integrity
    private testInvoiceCrudFlow() {
        if (m_options.verbose) {
            printf("\n--- Testing Invoice CRUD Flow ---\n");
        }

        FreshBooksDataProvider::FreshBooksDataProvider prov(client);

        # Step 1: Create a test invoice
        AbstractDataProvider createInvoiceProvider = prov.getChildProvider("create-invoice");
        string invoiceDate = now().format("YYYY-MM-DD");
        string testNotes = sprintf("Test invoice created at %s", now_us().toString());
        string testTerms = "Net 30 - Integration test payment terms";

        try {
            hash<auto> newInvoice = createInvoiceProvider.doRequest({
                "account_id": accountId,
                "customerid": testClientId,
                "create_date": invoiceDate,
                "due_offset_days": 30,
                "notes": testNotes,
                "terms": testTerms,
                "currency_code": "USD",
            });

            assertTrue(newInvoice.id.val(), "Invoice should be created with an ID");
            testInvoiceId = newInvoice.id;
            if (m_options.verbose) {
                printf("Created test invoice: ID %d (number: %s)\n",
                    testInvoiceId, newInvoice.invoice_number ?? "N/A");
            }

            # Step 2: Search for the invoice via the invoices collection provider
            sleep(500ms);
            AbstractDataProvider invoicesProvider = prov.getChildProvider("invoices");
            list<hash<auto>> invoices = map $1, invoicesProvider.searchRecords(
                NOTHING, {"account_id": accountId, "id": testInvoiceId});
            assertTrue(invoices.size() > 0, "Should find the created invoice by ID");

            # Verify data persistence - critical check per CLAUDE.md
            hash<auto> foundInvoice = invoices[0];
            assertEq(testInvoiceId, foundInvoice.id);
            assertEq(testClientId, foundInvoice.customerid);
            assertEq(invoiceDate, foundInvoice.create_date);
            assertEq(testNotes, foundInvoice.notes);
            assertEq(testTerms, foundInvoice.terms);
            assertTrue(foundInvoice.invoice_number.val(), "Invoice should have an invoice number");
            if (m_options.verbose) {
                printf("Verified invoice: customerid=%d, date=%s, notes=%s, terms=%s\n",
                    foundInvoice.customerid, foundInvoice.create_date,
                    foundInvoice.notes, foundInvoice.terms);
            }

            # Step 3: Update the invoice
            AbstractDataProvider updateInvoiceProvider = prov.getChildProvider("update-invoice");
            string updatedNotes = sprintf("Updated by integration test at %s",
                now_us().toString());
            string updatedTerms = "Net 45 - Updated payment terms";
            updateInvoiceProvider.doRequest({
                "account_id": accountId,
                "id": testInvoiceId,
                "notes": updatedNotes,
                "terms": updatedTerms,
                "due_offset_days": 45,
            });
            if (m_options.verbose) {
                printf("Updated invoice: ID %d\n", testInvoiceId);
            }

            # Step 4: Verify update persisted - data integrity check
            sleep(500ms);
            list<hash<auto>> verifyInvoices = map $1, invoicesProvider.searchRecords(
                NOTHING, {"account_id": accountId, "id": testInvoiceId});
            assertTrue(verifyInvoices.size() > 0, "Should find the updated invoice");
            assertEq(updatedNotes, verifyInvoices[0].notes,
                "Invoice notes update should persist");
            assertEq(updatedTerms, verifyInvoices[0].terms,
                "Invoice terms update should persist");
            if (m_options.verbose) {
                printf("Verified update persisted: notes=%s, terms=%s\n",
                    verifyInvoices[0].notes, verifyInvoices[0].terms);
            }
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("Invoice CRUD flow failed: %s: %s\n", ex.err, ex.desc);
            }
            rethrow;
        }

        if (m_options.verbose) {
            printf("--- Invoice CRUD Flow tests completed ---\n");
        }
    }

