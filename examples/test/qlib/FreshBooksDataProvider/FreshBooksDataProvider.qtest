    #! Test service CRUD flow: create -> search -> update -> verify
    private testServiceCrudFlow() {
        if (m_options.verbose) {
            printf("\n--- Testing Service CRUD Flow ---\n");
        }

        FreshBooksDataProvider::FreshBooksDataProvider prov(client);

        # Step 1: Create a test service
        AbstractDataProvider createServiceProvider = prov.getChildProvider("create-service");
        string testServiceName = sprintf("Test Service %s", now_us().format("YYYYMMDDHHmmss"));

        try {
            hash<auto> newService = createServiceProvider.doRequest({
                "business_id": businessId,
                "name": testServiceName,
                "billable": True,
            });

            assertTrue(newService.id.val(), "Service should be created with an ID");
            testServiceId = newService.id;
            if (m_options.verbose) {
                printf("Created test service: %s (ID: %d)\n", testServiceName, testServiceId);
            }

            # Step 2: Search for the service via the services collection provider
            sleep(500ms);
            AbstractDataProvider servicesProvider = prov.getChildProvider("services");
            list<hash<auto>> services = map $1, servicesProvider.searchRecords(
                NOTHING, {"business_id": businessId});
            bool found = False;
            foreach hash<auto> svc in (services) {
                if (svc.id == testServiceId) {
                    found = True;
                    assertEq(testServiceName, svc.name);
                    if (m_options.verbose) {
                        printf("Verified service: name=%s, billable=%s\n",
                            svc.name, svc.billable);
                    }
                    break;
                }
            }
            assertTrue(found, "Should find the created service in the list");

            # Step 3: Update the service
            AbstractDataProvider updateServiceProvider = prov.getChildProvider("update-service");
            string updatedServiceName = sprintf("Updated Svc %s",
                now_us().format("YYYYMMDDHHmmss"));
            updateServiceProvider.doRequest({
                "business_id": businessId,
                "id": testServiceId,
                "name": updatedServiceName,
            });

            if (m_options.verbose) {
                printf("Updated service name to: %s\n", updatedServiceName);
            }

            # Step 4: Verify update persisted
            sleep(500ms);
            list<hash<auto>> verifyServices = map $1, servicesProvider.searchRecords(
                NOTHING, {"business_id": businessId});
            bool foundUpdated = False;
            foreach hash<auto> svc in (verifyServices) {
                if (svc.id == testServiceId) {
                    foundUpdated = True;
                    assertEq(updatedServiceName, svc.name,
                        "Service name update should persist");
                    if (m_options.verbose) {
                        printf("Verified update persisted: name=%s\n", svc.name);
                    }
                    break;
                }
            }
            assertTrue(foundUpdated, "Should find the updated service");

            # Step 5: Delete the service
            AbstractDataProvider deleteServiceProvider = prov.getChildProvider("delete-service");
            deleteServiceProvider.doRequest({
                "business_id": businessId,
                "id": testServiceId,
            });
            if (m_options.verbose) {
                printf("Deleted service: ID %d\n", testServiceId);
            }

            # Step 6: Verify deletion - service should have vis_state = 1
            sleep(500ms);
            list<hash<auto>> deletedServices = map $1, servicesProvider.searchRecords(
                NOTHING, {"business_id": businessId, "id": testServiceId});
            if (deletedServices.size() > 0) {
                assertEq(1, deletedServices[0].vis_state,
                    "Deleted service should have vis_state = 1");
                if (m_options.verbose) {
                    printf("Verified service deletion: vis_state = %d\n",
                        deletedServices[0].vis_state);
                }
            }
            # Mark as cleaned up
