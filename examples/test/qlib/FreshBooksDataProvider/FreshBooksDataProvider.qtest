%modern

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/DataProvider
%requires ../../../../qlib/ConnectionProvider
%requires ../../../../qlib/RestClient.qm

%try-module json
%define NoJson
%endtry

%requires ../../../../qlib/FreshBooksRestClient.qm
%requires ../../../../qlib/FreshBooksDataProvider

%exec-class FreshBooksDataProviderTest

public class FreshBooksDataProviderTest inherits QUnit::Test {
    private {
        #! FreshBooks REST client for integration tests
        *FreshBooksRestClient::FreshBooksRestClient client;

        #! Logger for verbose output
        Logger logger;

        #! Custom command-line options
        const MyOpts = Opts + {
            "client_id": "i,client-id=s",
            "client_secret": "s,client-secret=s",
            "token": "t,token=s",
            "account_id": "a,account-id=s",
            "business_id": "b,business-id=s",
            "conn": "c,connection=s",
        };

        #! Test client ID (created during test)
        *int testClientId;

        #! Test expense ID (created during test)
        *int testExpenseId;

        #! Test invoice ID (created during test)
        *int testInvoiceId;

        #! Test item ID (created during test)
        *int testItemId;

        #! Test service ID (created during test)
        *int testServiceId;

        #! Test estimate ID (created during test)
        *int testEstimateId;

        #! Test payment ID (created during test)
        *int testPaymentId;

        #! Account ID for tests
        *string accountId;

        #! Business ID for tests
        *string businessId;
    }

    constructor() : Test("FreshBooksDataProvider Test", "1.0", \ARGV, MyOpts) {
        logger = new Logger("test", LoggerLevel::getLevelInfo());

        # Unit tests (always run, no credentials needed)
        addTestCase("sanity tests", \sanityTests());
        addTestCase("factory tests", \factoryTests());
        addTestCase("metadata tests", \metadataTests());
        addTestCase("child provider tests", \childProviderTests());
        addTestCase("data type tests", \dataTypeTests());
        addTestCase("trigger example data tests", \triggerExampleDataTests());
        addTestCase("negative tests", \negativeTests());
        addTestCase("connection tests", \connectionTests());

        # Integration tests (require FreshBooks credentials)
        addTestCase("integration tests", \integrationTests());

        # Try to set up connection for integration tests
        try {
            setupConnection();
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("Connection setup failed: %s: %s\n", ex.err, ex.desc);
            }
        }

        set_return_value(main());
    }

    #! Sets up the FreshBooks client for integration tests
    private setupConnection() {
        # Try to use a connection from Qorus if specified
        *string conn_name = m_options.conn ?? ENV.FRESHBOOKS_CONNECTION;
        if (conn_name) {
            if (m_options.verbose) {
                printf("Using connection: %s\n", conn_name);
            }
            client = get_connection(conn_name).get();
            return;
        }

        *string token = m_options.token ?? ENV.FRESHBOOKS_TOKEN;
        *string client_id = m_options.client_id ?? ENV.FRESHBOOKS_CLIENT_ID;
        *string client_secret = m_options.client_secret ?? ENV.FRESHBOOKS_CLIENT_SECRET;
        *string account_id = m_options.account_id ?? ENV.FRESHBOOKS_ACCOUNT_ID;
        *string business_id = m_options.business_id ?? ENV.FRESHBOOKS_BUSINESS_ID;

        if (!account_id || !business_id) {
            if (m_options.verbose) {
                printf("Missing FreshBooks credentials. Required:\n");
                printf("  - FRESHBOOKS_CONNECTION or -c option (Qorus connection name)\n");
                printf("Or:\n");
                printf("  - FRESHBOOKS_TOKEN or -t option (access token)\n");
                printf("  - FRESHBOOKS_ACCOUNT_ID or -a option\n");
                printf("  - FRESHBOOKS_BUSINESS_ID or -b option\n");
                printf("Or:\n");
                printf("  - FRESHBOOKS_CLIENT_ID or -i option\n");
                printf("  - FRESHBOOKS_CLIENT_SECRET or -s option\n");
                printf("  - FRESHBOOKS_ACCOUNT_ID or -a option\n");
                printf("  - FRESHBOOKS_BUSINESS_ID or -b option\n");
            }
            return;
        }

        # Token-only mode: access token without OAuth2 credentials
        if (token && (!client_id || !client_secret)) {
            if (m_options.verbose) {
                printf("Using token-only mode (no OAuth2 refresh)\n");
            }
            hash<auto> opts = {
                "token": token,
                "account_id": account_id,
                "business_id": business_id,
            };
            client = new FreshBooksRestClient::FreshBooksRestClient(opts);
            accountId = client.getAccountId();
            businessId = client.getBusinessId();
            return;
        }

        # Full OAuth2 mode
        if (!client_id || !client_secret) {
            if (m_options.verbose) {
                printf("Missing OAuth2 credentials (client_id and client_secret required)\n");
            }
            return;
        }

        hash<auto> opts = {
            "oauth2_client_id": client_id,
            "oauth2_client_secret": client_secret,
            "account_id": account_id,
            "business_id": business_id,
        };
        if (token) {
            opts.token = token;
        }

        client = new FreshBooksRestClient::FreshBooksRestClient(opts);

        # Store account_id and business_id for integration tests
        if (client) {
            accountId = client.getAccountId();
            businessId = client.getBusinessId();
        }
    }

    #! Check if json module is available
    private checkJson() {
%ifdef NoJson
        testSkip("no json module present");
%endif
    }

    #! Basic sanity tests - provider instantiation
    sanityTests() {
        checkJson();
        # Test creating provider with fake credentials via freshbooksrestclient_options
        try {
            FreshBooksDataProvider::FreshBooksDataProvider prov({
                "freshbooksrestclient_options": {
                    "token": "fake-token",
                    "account_id": "fake-account",
                    "business_id": "fake-business",
                },
            });
            assertEq("freshbooks", prov.getName());
            assertTrue(prov.getDesc().val());
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "OAUTH2-ERROR") {
                testSkip("OAuth2 requires manual authorization - skipping sanity tests");
            }
            if (ex.err == "QOREADDRINFO-GETINFO-ERROR") {
                testSkip("no network connection - skipping sanity tests");
            }
            rethrow;
        }
    }

    #! Factory tests - verify factory registration
    factoryTests() {
        checkJson();
        # Verify factory is registered
        AbstractDataProviderFactory factory = DataProvider::getFactory("freshbooks");
        assertEq("freshbooks", factory.getInfo().name);
        assertEq("FreshBooks data provider factory", factory.getInfo().desc);
        assertTrue(factory.getInfo().children_can_support_apis);
        assertTrue(factory.getInfo().children_can_support_records);
        assertTrue(factory.getInfo().children_can_support_observers);

        # Verify factory can create provider with options
        hash<auto> factoryOpts = factory.getInfo().provider_info.constructor_options;
        assertTrue(factoryOpts.hasKey("freshbooksrestclient"));
    }

    #! Metadata tests - verify provider info structure
    metadataTests() {
        checkJson();
        try {
            FreshBooksDataProvider::FreshBooksDataProvider prov({
                "freshbooksrestclient_options": {
                    "token": "fake-token",
                    "account_id": "fake-account",
                    "business_id": "fake-business",
                },
            });
            hash<DataProviderInfo> info = prov.getInfo();

            assertTrue(info.supports_children);
            assertTrue(info.children_can_support_apis);
            assertTrue(info.children_can_support_records);
            assertTrue(info.children_can_support_observers);
            assertEq("FreshBooksDataProvider", info.type);

            # Check constructor options
            assertTrue(info.constructor_options.hasKey("freshbooksrestclient"));
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "OAUTH2-ERROR") {
                testSkip("OAuth2 requires manual authorization - skipping metadata tests");
            }
            if (ex.err == "QOREADDRINFO-GETINFO-ERROR") {
                testSkip("no network connection - skipping metadata tests");
            }
            rethrow;
        }
    }

    #! Child provider tests - verify hierarchy
    childProviderTests() {
        checkJson();
        FreshBooksDataProvider::FreshBooksDataProvider prov;
        try {
            prov = new FreshBooksDataProvider::FreshBooksDataProvider({
                "freshbooksrestclient_options": {
                    "token": "fake-token",
                    "account_id": "fake-account",
                    "business_id": "fake-business",
                },
            });
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "OAUTH2-ERROR") {
                testSkip("OAuth2 requires manual authorization - skipping child provider tests");
            }
            if (ex.err == "QOREADDRINFO-GETINFO-ERROR") {
                testSkip("no network connection - skipping child provider tests");
            }
            rethrow;
        }

        # Check child provider names
        list<string> children = prov.getChildProviderNames();

        # Verify collection providers exist
        assertTrue(children.contains("clients"));
        assertTrue(children.contains("invoices"));
        assertTrue(children.contains("expenses"));
        assertTrue(children.contains("estimates"));
        assertTrue(children.contains("items"));
        assertTrue(children.contains("services"));

        # Verify collection providers
        assertTrue(children.contains("payments"));

        # Verify action providers exist
        assertTrue(children.contains("create-client"));
        assertTrue(children.contains("update-client"));
        assertTrue(children.contains("delete-client"));
        assertTrue(children.contains("create-invoice"));
        assertTrue(children.contains("update-invoice"));
        assertTrue(children.contains("delete-invoice"));
        assertTrue(children.contains("create-expense"));
        assertTrue(children.contains("update-expense"));
        assertTrue(children.contains("delete-expense"));
        assertTrue(children.contains("create-item"));
        assertTrue(children.contains("update-item"));
        assertTrue(children.contains("delete-item"));
        assertTrue(children.contains("create-service"));
        assertTrue(children.contains("update-service"));
        assertTrue(children.contains("delete-service"));
        assertTrue(children.contains("create-estimate"));
        assertTrue(children.contains("update-estimate"));
        assertTrue(children.contains("create-payment"));
        assertTrue(children.contains("update-payment"));
        assertTrue(children.contains("delete-payment"));
        assertTrue(children.contains("execute-api-call"));

        # Verify events provider exists
        assertTrue(children.contains("events"));

        # Check clients child provider
        AbstractDataProvider clients = prov.getChildProvider("clients");
        assertEq("clients", clients.getName());
        hash<DataProviderInfo> clientsInfo = clients.getInfo();
        assertTrue(clientsInfo.supports_read);
        assertTrue(clientsInfo.supports_native_search);

        # Check invoices child provider
        AbstractDataProvider invoices = prov.getChildProvider("invoices");
        assertEq("invoices", invoices.getName());
        hash<DataProviderInfo> invoicesInfo = invoices.getInfo();
        assertTrue(invoicesInfo.supports_read);
        assertTrue(invoicesInfo.supports_native_search);

        # Check expenses child provider
        AbstractDataProvider expenses = prov.getChildProvider("expenses");
        assertEq("expenses", expenses.getName());
        hash<DataProviderInfo> expensesInfo = expenses.getInfo();
        assertTrue(expensesInfo.supports_read);
        assertTrue(expensesInfo.supports_native_search);

        # Check events child provider
        AbstractDataProvider events = prov.getChildProvider("events");
        assertEq("events", events.getName());
        hash<DataProviderInfo> eventsInfo = events.getInfo();
        assertTrue(eventsInfo.supports_children);

        # Check events child providers (triggers)
        list<string> eventChildren = events.getChildProviderNames();
        assertTrue(eventChildren.contains("invoice-created"));
        assertTrue(eventChildren.contains("payment-created"));
        assertTrue(eventChildren.contains("client-created"));
        assertTrue(eventChildren.contains("expense-created"));
        assertTrue(eventChildren.contains("estimate-created"));

        # Verify event providers have correct info
        AbstractDataProvider invoiceCreatedEvent = events.getChildProvider("invoice-created");
        assertEq("invoice-created", invoiceCreatedEvent.getName());
        hash<DataProviderInfo> invoiceCreatedInfo = invoiceCreatedEvent.getInfo();
        assertTrue(invoiceCreatedInfo.supports_observable);
    }

    #! Data type tests - verify record type definitions
    dataTypeTests() {
        checkJson();
        # Test client data type
        FreshBooksDataProvider::FreshBooksClientDataType clientType();
        hash<string, AbstractDataField> clientFields = clientType.getFields();
        assertTrue(clientFields.hasKey("id"));
        assertTrue(clientFields.hasKey("fname"));
        assertTrue(clientFields.hasKey("lname"));
        assertTrue(clientFields.hasKey("email"));
        assertTrue(clientFields.hasKey("organization"));
        assertTrue(clientFields.hasKey("phone"));
        assertTrue(clientFields.hasKey("note"));
        assertTrue(clientFields.hasKey("vis_state"));

        # Test invoice data type
        FreshBooksDataProvider::FreshBooksInvoiceDataType invoiceType();
        hash<string, AbstractDataField> invoiceFields = invoiceType.getFields();
        assertTrue(invoiceFields.hasKey("id"));
        assertTrue(invoiceFields.hasKey("invoiceid"));
        assertTrue(invoiceFields.hasKey("invoice_number"));
        assertTrue(invoiceFields.hasKey("customerid"));
        assertTrue(invoiceFields.hasKey("create_date"));
        assertTrue(invoiceFields.hasKey("currency_code"));
        assertTrue(invoiceFields.hasKey("status"));
        assertTrue(invoiceFields.hasKey("amount"));
        assertTrue(invoiceFields.hasKey("notes"));
        assertTrue(invoiceFields.hasKey("terms"));
        assertTrue(invoiceFields.hasKey("vis_state"));

        # Test expense data type
        FreshBooksDataProvider::FreshBooksExpenseDataType expenseType();
        hash<string, AbstractDataField> expenseFields = expenseType.getFields();
        assertTrue(expenseFields.hasKey("id"));
        assertTrue(expenseFields.hasKey("expenseid"));
        assertTrue(expenseFields.hasKey("categoryid"));
        assertTrue(expenseFields.hasKey("amount"));
        assertTrue(expenseFields.hasKey("vendor"));
        assertTrue(expenseFields.hasKey("date"));
        assertTrue(expenseFields.hasKey("notes"));
        assertTrue(expenseFields.hasKey("status"));
        assertTrue(expenseFields.hasKey("vis_state"));

        # Test item data type
        FreshBooksDataProvider::FreshBooksItemDataType itemType();
        hash<string, AbstractDataField> itemFields = itemType.getFields();
        assertTrue(itemFields.hasKey("id"));
        assertTrue(itemFields.hasKey("itemid"));
        assertTrue(itemFields.hasKey("name"));
        assertTrue(itemFields.hasKey("description"));
        assertTrue(itemFields.hasKey("sku"));
        assertTrue(itemFields.hasKey("unit_cost"));
        assertTrue(itemFields.hasKey("vis_state"));

        # Test service data type
        FreshBooksDataProvider::FreshBooksServiceDataType serviceType();
        hash<string, AbstractDataField> serviceFields = serviceType.getFields();
        assertTrue(serviceFields.hasKey("id"));
        assertTrue(serviceFields.hasKey("name"));
        assertTrue(serviceFields.hasKey("billable"));
        assertTrue(serviceFields.hasKey("vis_state"));

        # Test estimate data type
        FreshBooksDataProvider::FreshBooksEstimateDataType estimateType();
        hash<string, AbstractDataField> estimateFields = estimateType.getFields();
        assertTrue(estimateFields.hasKey("id"));
        assertTrue(estimateFields.hasKey("estimateid"));
        assertTrue(estimateFields.hasKey("estimate_number"));
        assertTrue(estimateFields.hasKey("customerid"));
        assertTrue(estimateFields.hasKey("create_date"));
        assertTrue(estimateFields.hasKey("currency_code"));
        assertTrue(estimateFields.hasKey("status"));
        assertTrue(estimateFields.hasKey("amount"));
        assertTrue(estimateFields.hasKey("notes"));
        assertTrue(estimateFields.hasKey("terms"));

        # Test payment data type
        FreshBooksDataProvider::FreshBooksPaymentDataType paymentType();
        hash<string, AbstractDataField> paymentFields = paymentType.getFields();
        assertTrue(paymentFields.hasKey("id"));
        assertTrue(paymentFields.hasKey("paymentid"));
        assertTrue(paymentFields.hasKey("invoiceid"));
        assertTrue(paymentFields.hasKey("amount"));
        assertTrue(paymentFields.hasKey("date"));
        assertTrue(paymentFields.hasKey("type"));
        assertTrue(paymentFields.hasKey("note"));
        assertTrue(paymentFields.hasKey("vis_state"));

        # Test create payment request type
        FreshBooksDataProvider::FreshBooksPaymentCreateDataType createPaymentType();
        hash<string, AbstractDataField> createPaymentFields = createPaymentType.getFields();
        assertTrue(createPaymentFields.hasKey("invoiceid"));
        assertTrue(createPaymentFields.hasKey("account_id"));
        assertTrue(createPaymentFields.hasKey("amount"));
        assertTrue(createPaymentFields.hasKey("date"));
        assertTrue(createPaymentFields.hasKey("type"));
        assertTrue(createPaymentFields.hasKey("note"));

        # Test update payment request type
        FreshBooksDataProvider::FreshBooksPaymentUpdateDataType updatePaymentType();
        hash<string, AbstractDataField> updatePaymentFields = updatePaymentType.getFields();
        assertTrue(updatePaymentFields.hasKey("id"));
        assertTrue(updatePaymentFields.hasKey("amount"));
        assertTrue(updatePaymentFields.hasKey("date"));
        assertTrue(updatePaymentFields.hasKey("type"));
        assertTrue(updatePaymentFields.hasKey("note"));

        # Test create client request type
        FreshBooksDataProvider::FreshBooksClientCreateDataType createClientType();
        hash<string, AbstractDataField> createClientFields = createClientType.getFields();
        assertTrue(createClientFields.hasKey("fname"));
        assertTrue(createClientFields.hasKey("account_id"));
        assertTrue(createClientFields.hasKey("lname"));
        assertTrue(createClientFields.hasKey("email"));
        assertTrue(createClientFields.hasKey("organization"));

        # Test create invoice request type
        FreshBooksDataProvider::FreshBooksInvoiceCreateDataType createInvoiceType();
