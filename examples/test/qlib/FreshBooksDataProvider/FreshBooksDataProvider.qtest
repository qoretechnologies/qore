        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("Service CRUD flow failed: %s: %s\n", ex.err, ex.desc);
            }
            rethrow;
        }

        if (m_options.verbose) {
            printf("--- Service CRUD Flow tests completed ---\n");
        }
