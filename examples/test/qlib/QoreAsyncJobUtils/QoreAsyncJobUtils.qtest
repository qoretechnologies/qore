#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires QoreAsyncJobUtils

%exec-class QoreAsyncJobUtilsTest

#! A clock for the poller that only the fake status fetchers and sleepers advance (issue #6068)
/** The deadline of AsyncJobPoller::poll() is then decided by the time the test gives each fetch and sleep, not by
    the time the test takes to run
*/
class FakeClock {
    public {
        date now = 2026-01-01T00:00:00Z;
    }

    #! installs the clock in the poller
    install(AsyncJobPoller p) {
        p.setClock(date sub () { return now; });
    }

    #! advances the clock
    advance(timeout t) {
        now += milliseconds(int(t));
    }
}

public class QoreAsyncJobUtilsTest inherits QUnit::Test {
    constructor() : Test("QoreAsyncJobUtils Test", "1.0") {
        addTestCase("poll returns first terminal status",     \terminalImmediatelyTest());
        addTestCase("poll iterates through non-terminal states until terminal",
            \multiIterationTest());
        addTestCase("sleeper is called between non-terminal iterations only",
            \sleeperCallCountTest());
        addTestCase("custom exception class is raised on timeout",
            \customErrorClassTest());
        addTestCase("default exception class is ASYNC-JOB-TIMEOUT",
            \defaultErrorClassTest());
        addTestCase("timeout exception carries last status",  \timeoutPayloadTest());
        addTestCase("setSleeper replaces sleeper after construction",
            \setSleeperTest());
        addTestCase("poll sleep is bounded by the remaining deadline",
            \customIntervalTest());
        addTestCase("late completion is a timeout and limits must be positive", \deadlineTest());
        addTestCase("the default sleeper waits between polls",
            \defaultSleeperTest());
        set_return_value(main());
    }

    #! Polls with the sleeper the poller installs for itself
    /** Every other case here injects one through setSleeper(), so the default was never run: it was
        written with its type in the block's return-type position, which declared the block to return
        a closure and then fall off its end, and every poll that had to wait failed with "block
        missing return statement".  Four applications poll jobs through this class, so the first
        status that was not already terminal broke all of them.
    */
    private defaultSleeperTest() {
        int fetch_calls = 0;
        QoreAsyncJobUtils::AsyncJobPoller p(
            hash<auto> sub (string j) {
                return {"id": j, "status": ++fetch_calls >= 3 ? "DONE" : "RUNNING"};
            },
            bool sub (hash<auto> s) { return s.status == "DONE"; },
        );
        # the deadline is measured with a clock that does not advance, so only the sleeps take time
        FakeClock clock();
        clock.install(p);
        # timeout values are milliseconds, but usleep(integer) expects microseconds.
        # Observe elapsed time to catch a 1000-fold unit error in the default sleeper: two sleeps of
        # 20 ms take at least 40 ms
        date start = now_us();
        hash<auto> r = p.poll("job-default-sleeper", 10s, 20ms);
        assertTrue(get_duration_milliseconds(now_us() - start) >= 40);
        assertEq("DONE", r.status);
        assertEq(3, fetch_calls, "the poller waited and polled again rather than throwing");
    }

    private terminalImmediatelyTest() {
        # The first fetch returns a terminal status — should return immediately
        # without calling the sleeper at all.
        int sleep_calls = 0;
        int fetch_calls = 0;
        QoreAsyncJobUtils::AsyncJobPoller p(
            hash<auto> sub (string j) {
                ++fetch_calls;
                return {"id": j, "status": "SUCCESS"};
            },
            bool sub (hash<auto> s) { return s.status == "SUCCESS"; },
        );
        FakeClock clock();
        clock.install(p);
        p.setSleeper(nothing sub (timeout t) { ++sleep_calls; });

        hash<auto> r = p.poll("job-1");
        assertEq("SUCCESS", r.status);
        assertEq(1, fetch_calls);
        assertEq(0, sleep_calls);
    }

    private multiIterationTest() {
        list<string> seq = ("PENDING", "PROCESSING", "PROCESSING", "DONE");
        int idx = 0;
        QoreAsyncJobUtils::AsyncJobPoller p(
            hash<auto> sub (string j) {
                string s = seq[idx];
                if (idx < seq.size() - 1) {
                    ++idx;
                }
                return {"id": j, "status": s};
            },
            bool sub (hash<auto> s) { return s.status == "DONE"; },
        );
        FakeClock clock();
        clock.install(p);
        p.setSleeper(nothing sub (timeout t) {});

        hash<auto> r = p.poll("job-X");
        assertEq("DONE", r.status);
        assertEq("job-X", r.id);
    }

    private sleeperCallCountTest() {
        # 3 non-terminal then 1 terminal = exactly 3 sleeper invocations
        list<string> seq = ("PENDING", "PROCESSING", "PROCESSING", "SUCCESS");
        int idx = 0;
        int sleeps = 0;
        QoreAsyncJobUtils::AsyncJobPoller p(
            hash<auto> sub (string j) {
                string s = seq[idx];
                if (idx < seq.size() - 1) {
                    ++idx;
                }
                return {"status": s};
            },
            bool sub (hash<auto> s) { return s.status == "SUCCESS"; },
        );
        FakeClock clock();
        clock.install(p);
        p.setSleeper(nothing sub (timeout t) { ++sleeps; });
        p.poll("job-S");
        assertEq(3, sleeps);
    }

    private customErrorClassTest() {
        QoreAsyncJobUtils::AsyncJobPoller p(
            hash<auto> sub (string j) { return {"status": "PENDING"}; },
            bool sub (hash<auto> s) { return False; },
            "Foo job",
            "FOO-TIMEOUT",
        );
        FakeClock clock();
        clock.install(p);
        p.setSleeper(nothing sub (timeout t) { clock.advance(t); });
        assertThrows("FOO-TIMEOUT", sub () {
            p.poll("j", 1ms, 1ms);
        });
    }

    private defaultErrorClassTest() {
        QoreAsyncJobUtils::AsyncJobPoller p(
            hash<auto> sub (string j) { return {"status": "PENDING"}; },
            bool sub (hash<auto> s) { return False; },
        );
        FakeClock clock();
        clock.install(p);
        p.setSleeper(nothing sub (timeout t) { clock.advance(t); });
        assertThrows("ASYNC-JOB-TIMEOUT", sub () {
            p.poll("j", 1ms, 1ms);
        });
    }

    private timeoutPayloadTest() {
        # The exception's arg hash carries job_id + last observed status
        QoreAsyncJobUtils::AsyncJobPoller p(
            hash<auto> sub (string j) { return {"status": "STUCK", "extra": "x"}; },
            bool sub (hash<auto> s) { return False; },
        );
        FakeClock clock();
        clock.install(p);
        p.setSleeper(nothing sub (timeout t) { clock.advance(t); });
        try {
            p.poll("job-99", 1ms, 1ms);
            fail("expected timeout");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("ASYNC-JOB-TIMEOUT", ex.err);
            assertEq("job-99", ex.arg.job_id);
            assertEq("STUCK", ex.arg.last_status.status);
            assertEq("x", ex.arg.last_status.extra);
        }
    }

    private setSleeperTest() {
        # Replace the initial usleep-based sleeper with a counting one
        QoreAsyncJobUtils::AsyncJobPoller p(
            hash<auto> sub (string j) {
                return {"status": j == "ready" ? "OK" : "WAIT"};
            },
            bool sub (hash<auto> s) { return s.status == "OK"; },
        );
        int calls = 0;
        FakeClock clock();
        clock.install(p);
        p.setSleeper(nothing sub (timeout t) {
            ++calls;
            clock.advance(t);
        });
        # Will time out (status never becomes OK with this id) — proves the
        # counting sleeper replaced the default
        assertThrows("ASYNC-JOB-TIMEOUT", sub () {
            p.poll("never", 1ms, 1ms);
        });
        # the first sleep reaches the deadline of 1 ms
        assertEq(1, calls);
    }

    private customIntervalTest() {
        # A long polling interval cannot extend a short overall deadline.
        timeout observed;
        QoreAsyncJobUtils::AsyncJobPoller p(
            hash<auto> sub (string j) { return {"status": "PENDING"}; },
            bool sub (hash<auto> s) { return False; },
        );
        FakeClock clock();
        clock.install(p);
        p.setSleeper(nothing sub (timeout t) {
            observed = t;
            clock.advance(t);
        });
        assertThrows("ASYNC-JOB-TIMEOUT", sub () { p.poll("j", 1ms, 250ms); });
        assertEq(1, int(observed));
    }

    private deadlineTest() {
        int fetches = 0;
        FakeClock clock();
        # each fetch takes 30 ms of the clock, so one that starts within a deadline of 10 ms ends after it
        AsyncJobPoller poller(hash<auto> sub (string id) {
            ++fetches;
            clock.advance(30ms);
            return {"status": "succeeded"};
        }, bool sub (hash<auto> status) { return True; });
        clock.install(poller);
        assertThrows("ASYNC-JOB-TIMEOUT", sub () { poller.poll("job", 0, 1); });
        assertThrows("ASYNC-JOB-TIMEOUT", sub () { poller.poll("job", 100, 0); });
        assertEq(0, fetches);
        try {
            poller.poll("late", 10ms, 1ms);
            fail("late success must retain a timeout");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("ASYNC-JOB-TIMEOUT", ex.err);
            assertEq("late", ex.arg.job_id);
            assertEq("succeeded", ex.arg.last_status.status);
        }
        assertEq(1, fetches);
    }
}
