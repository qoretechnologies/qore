    constructor() : Test("Http2ClientIoTest", "1.0") {
        # Module and definition tests
        addTestCase("module load test", \testModuleLoad());
        addTestCase("hashdecl and enum definitions", \testDefinitions());
        addTestCase("connection manager creation", \testConnectionManagerCreation());

        # Basic functionality tests
        addTestCase("connection manager stats", \testConnectionManagerStats());

        # Negative tests
        addTestCase("invalid URL handling", \testInvalidUrl());
        addTestCase("connection manager shutdown", \testConnectionManagerShutdown());

        # Corner case tests
        addTestCase("empty options hashdecl", \testEmptyOptions());
        addTestCase("stream state transitions", \testStreamStateTransitions());

        # C++ layer tests for fixes
        addTestCase("submitHttp2Request missing headers", \testSubmitHttp2RequestMissingHeaders());

        # Stream handle tests
        addTestCase("stream handle state management", \testStreamHandleStateManagement());

        # End-to-end tests (require actual HTTP/2 connections)
        addTestCase("basic HTTP/2 request", \testBasicHttp2Request());
        addTestCase("POST request with body", \testPostRequestWithBody());
        addTestCase("error response handling", \testErrorResponse());
        addTestCase("large response body", \testLargeResponse());
        addTestCase("concurrent multiplexed requests", \testConcurrentRequests());
        addTestCase("connection pooling", \testConnectionPooling());
        addTestCase("async callback API", \testAsyncCallback());
        addTestCase("SSL accept_all_certs option", \testSslAcceptAllCerts());

        set_return_value(main());
    }

    globalSetUp() {
        mLogger = new Logger("http2-client-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            mLogger.addAppender(new StdoutAppender());
        }

        hash<HttpServerOptionInfo> opts = <HttpServerOptionInfo>{
            "logger": mLogger,
            "debug": True,
            "async_mode": True,
        };
        mServer = new HttpServer(opts);

        # Register handlers
        mServer.setHandler("simple", "/simple", NOTHING, new SimpleGetHandler());
        mServer.setHandler("large", "/large", NOTHING, new LargeResponseHandler());
        mServer.setHandler("echo", "/echo", NOTHING, new EchoHandler());
        mServer.setHandler("slow", "/slow", NOTHING, new SlowHandler());
        mServer.setHandler("error", "/error", NOTHING, new ErrorHandler());
        mServer.setHandler("json", "/json", NOTHING, new JsonHandler());

        # Add HTTPS listener for HTTP/2
        mSslPort = mServer.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        }).port;
        mSslUrl = "https://localhost:" + mSslPort;

        mServer.waitForAsyncIo();

        if (m_options.verbose > 1) {
            printf("HTTPS test server on port %d\n", mSslPort);
        }
    }

    globalTearDown() {
        delete mServer;
    }

    #! Test that the module loaded successfully
    testModuleLoad() {
        # If we got here, the module loaded
        assertEq(True, True, "module loaded successfully");
    }

    #! Test hashdecl and enum definitions are accessible
    testDefinitions() {
        # Test stream state enums have expected values
        assertEq(0, Http2ClientIo::Http2ClientStreamState::Pending, "stream state Pending");
        assertEq(1, Http2ClientIo::Http2ClientStreamState::Open, "stream state Open");
        assertEq(2, Http2ClientIo::Http2ClientStreamState::HeadersReceived, "stream state HeadersReceived");
        assertEq(3, Http2ClientIo::Http2ClientStreamState::ReceivingBody, "stream state ReceivingBody");
        assertEq(4, Http2ClientIo::Http2ClientStreamState::Complete, "stream state Complete");
        assertEq(5, Http2ClientIo::Http2ClientStreamState::Cancelled, "stream state Cancelled");
        assertEq(6, Http2ClientIo::Http2ClientStreamState::Error, "stream state Error");

        # Test connection state enums have expected values
        assertEq(0, Http2ClientIo::Http2ClientConnectionState::Connecting, "conn state Connecting");
        assertEq(1, Http2ClientIo::Http2ClientConnectionState::Ready, "conn state Ready");
        assertEq(2, Http2ClientIo::Http2ClientConnectionState::Draining, "conn state Draining");
        assertEq(3, Http2ClientIo::Http2ClientConnectionState::Closed, "conn state Closed");

        # Test constants have expected values
        assertEq(6, Http2ClientIo::DefaultMaxConnectionsPerHost, "default max connections per host");
        assertEq(100, Http2ClientIo::DefaultMaxStreamsPerConnection, "default max streams per connection");
        assertTrue(Http2ClientIo::DefaultConnectionIdleTimeout > 0, "default idle timeout > 0");
        assertTrue(Http2ClientIo::DefaultConnectTimeout > 0, "default connect timeout > 0");
        assertTrue(Http2ClientIo::DefaultRequestTimeout > 0, "default request timeout > 0");

        # Test hashdecl can be instantiated with values
        hash<Http2ClientIo::Http2ClientConnectionManagerOptions> opts = <Http2ClientIo::Http2ClientConnectionManagerOptions>{
            "max_connections_per_host": 4,
            "max_streams_per_connection": 50,
            "idle_timeout": 30s,
            "connect_timeout": 15s,
            "request_timeout": 45s,
            "accept_all_certs": True,
        };
        assertEq(4, opts.max_connections_per_host, "manager options max_connections_per_host");
        assertEq(50, opts.max_streams_per_connection, "manager options max_streams_per_connection");
        assertEq(30000, int(opts.idle_timeout), "manager options idle_timeout");
        assertEq(15000, int(opts.connect_timeout), "manager options connect_timeout");
        assertEq(45000, int(opts.request_timeout), "manager options request_timeout");
        assertEq(True, opts.accept_all_certs, "manager options accept_all_certs");

        # Test request options hashdecl
        hash<Http2ClientIo::Http2ClientRequestOptions> req_opts = <Http2ClientIo::Http2ClientRequestOptions>{
            "timeout": 5s,
            "priority_weight": 128,
        };
        assertEq(5000, int(req_opts.timeout), "request options timeout");
        assertEq(128, req_opts.priority_weight, "request options priority_weight");

        # Test response info hashdecl
        hash<Http2ClientIo::Http2ClientResponseInfo> resp_info = <Http2ClientIo::Http2ClientResponseInfo>{
            "status_code": 200,
            "headers": {"content-type": "text/plain"},
            "body": "test",
            "stream_id": 1,
        };
        assertEq(200, resp_info.status_code, "response info status_code");
        assertEq("text/plain", resp_info.headers."content-type", "response info headers");
        assertEq("test", resp_info.body, "response info body");
        assertEq(1, resp_info.stream_id, "response info stream_id");

        # Test error info hashdecl
        hash<Http2ClientIo::Http2ClientErrorInfo> err_info = <Http2ClientIo::Http2ClientErrorInfo>{
            "err": "HTTP2-ERROR",
            "desc": "test error",
            "stream_id": 3,
            "h2_error_code": 1,
        };
        assertEq("HTTP2-ERROR", err_info.err, "error info err");
        assertEq("test error", err_info.desc, "error info desc");
        assertEq(3, err_info.stream_id, "error info stream_id");
        assertEq(1, err_info.h2_error_code, "error info h2_error_code");

        # Test connection info hashdecl - state field must be assigned separately
        # due to enum type handling in hashdecl initializers
        hash<Http2ClientIo::Http2ClientConnectionInfo> conn_info = <Http2ClientIo::Http2ClientConnectionInfo>{
            "host": "example.com",
            "port": 443,
            "ssl": True,
            "active_streams": 5,
            "max_concurrent_streams": 100,
            "connection_id": 1,
        };
        conn_info.state = Http2ClientIo::Http2ClientConnectionState::Ready;
        assertEq("example.com", conn_info.host, "connection info host");
        assertEq(443, conn_info.port, "connection info port");
        assertEq(True, conn_info.ssl, "connection info ssl");
        assertEq(Http2ClientIo::Http2ClientConnectionState::Ready, conn_info.state, "connection info state");
        assertEq(5, conn_info.active_streams, "connection info active_streams");
        assertEq(100, conn_info.max_concurrent_streams, "connection info max_concurrent_streams");
        assertEq(1, conn_info.connection_id, "connection info connection_id");
    }

    #! Test connection manager creation with various options
    testConnectionManagerCreation() {
        # Create with default options
        Http2ClientIo::Http2ClientConnectionManager manager1();
        hash<auto> stats1 = manager1.getStats();
        assertEq(0, stats1.total_connections, "default manager initial connections");
        assertEq(0, stats1.total_active_streams, "default manager initial streams");
        assertEq(0, stats1.hosts, "default manager initial hosts");

        # Create with custom options
        Http2ClientIo::Http2ClientConnectionManager manager2(<Http2ClientIo::Http2ClientConnectionManagerOptions>{
            "max_connections_per_host": 4,
            "max_streams_per_connection": 50,
            "idle_timeout": 30s,
            "connect_timeout": 15s,
            "request_timeout": 45s,
            "logger": mLogger,
        });
        hash<auto> stats2 = manager2.getStats();
        assertEq(0, stats2.total_connections, "custom manager initial connections");
        assertEq(0, stats2.total_active_streams, "custom manager initial streams");

        # Create with minimal options
        Http2ClientIo::Http2ClientConnectionManager manager3(<Http2ClientIo::Http2ClientConnectionManagerOptions>{
            "max_connections_per_host": 1,
        });
        hash<auto> stats3 = manager3.getStats();
        assertEq(0, stats3.total_connections, "minimal manager initial connections");

        # Create with SSL options
        Http2ClientIo::Http2ClientConnectionManager manager4(<Http2ClientIo::Http2ClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "ssl_verify_mode": 0,
        });
        hash<auto> stats4 = manager4.getStats();
        assertEq(0, stats4.total_connections, "ssl manager initial connections");
    }

    #! Test connection manager statistics
    testConnectionManagerStats() {
        Http2ClientIo::Http2ClientConnectionManager manager();

        # Initial stats should be empty
        hash<auto> stats = manager.getStats();
        assertEq(0, stats.total_connections, "initial total_connections");
        assertEq(0, stats.total_active_streams, "initial total_active_streams");
        assertEq(0, stats.hosts, "initial hosts count");
        assertEq({}, stats.per_host, "initial per_host empty");

        # After cleanup (no connections to clean)
        manager.cleanupIdleConnections();
        stats = manager.getStats();
        assertEq(0, stats.total_connections, "after cleanup total_connections");
    }

    #! Test invalid URL handling
    testInvalidUrl() {
        Http2ClientIo::Http2ClientConnectionManager manager();

        # Test URL without host
        assertThrows("HTTP2-URL-ERROR", \manager.acquireStream(), ("https:///path",),
            "URL without host should throw");

        # Test empty URL
        assertThrows("HTTP2-URL-ERROR", \manager.acquireStream(), ("",),
            "empty URL should throw");

        # Test URL with only scheme
        assertThrows("HTTP2-URL-ERROR", \manager.acquireStream(), ("https://",),
            "URL with only scheme should throw");
    }

    #! Test connection manager shutdown
    testConnectionManagerShutdown() {
        Http2ClientIo::Http2ClientConnectionManager manager();

        # Close all connections (should work even with no connections)
        manager.closeAll();

        # After closeAll, acquiring streams should fail
        assertThrows("HTTP2-SHUTDOWN", \manager.acquireStream(), (mSslUrl,),
            "acquireStream after shutdown should throw");

        # Stats should show no connections
        hash<auto> stats = manager.getStats();
        assertEq(0, stats.total_connections, "after shutdown total_connections");
    }

    #! Test empty options hashdecl
    testEmptyOptions() {
        # Create manager with empty hash (should use defaults)
        Http2ClientIo::Http2ClientConnectionManager manager(<Http2ClientIo::Http2ClientConnectionManagerOptions>{});
        hash<auto> stats = manager.getStats();
        assertEq(0, stats.total_connections, "empty options manager works");
    }

    #! Test stream state transitions
    testStreamStateTransitions() {
        # Verify state values are distinct
        list<int> states = (
            Http2ClientIo::Http2ClientStreamState::Pending,
            Http2ClientIo::Http2ClientStreamState::Open,
            Http2ClientIo::Http2ClientStreamState::HeadersReceived,
            Http2ClientIo::Http2ClientStreamState::ReceivingBody,
            Http2ClientIo::Http2ClientStreamState::Complete,
            Http2ClientIo::Http2ClientStreamState::Cancelled,
            Http2ClientIo::Http2ClientStreamState::Error,
        );

        # All states should be unique
        hash<string, bool> seen;
        foreach int state in (states) {
            string key = string(state);
            assertFalse(seen{key} ?? False, sprintf("state %d should be unique", state));
            seen{key} = True;
        }
        assertEq(7, seen.size(), "should have 7 unique stream states");

        # Verify connection states are distinct
        list<int> conn_states = (
            Http2ClientIo::Http2ClientConnectionState::Connecting,
            Http2ClientIo::Http2ClientConnectionState::Ready,
            Http2ClientIo::Http2ClientConnectionState::Draining,
            Http2ClientIo::Http2ClientConnectionState::Closed,
        );

        hash<string, bool> conn_seen;
        foreach int state in (conn_states) {
            string key = string(state);
            assertFalse(conn_seen{key} ?? False, sprintf("conn state %d should be unique", state));
            conn_seen{key} = True;
        }
        assertEq(4, conn_seen.size(), "should have 4 unique connection states");
    }

    #! Test Socket::submitHttp2Request with missing required headers
    #! Requires qore to be rebuilt with the latest C++ changes
    testSubmitHttp2RequestMissingHeaders() {
        # Check if the new Socket methods are available
        Socket sock();
        if (!sock.hasCallableMethod("startPollHttp2ClientMultiplex")) {
            testSkip("Socket::startPollHttp2ClientMultiplex() not available - rebuild qore required");
            return;
        }

        # Connect and run the actual tests
        sock.connect("localhost:" + mSslPort);
        # Set ALPN to negotiate HTTP/2
        sock.setAlpnProtocols(("h2",));
        sock.upgradeClientToSSL(30s);

        # Start HTTP/2 client multiplex mode
        AbstractPollOperation poll_op = sock.startPollHttp2ClientMultiplex();

        # Drive the poll operation until ready (or error)
        date start = now_us();
        date timeout = 10s;
        while (!poll_op.goalReached()) {
            if (now_us() - start > timeout) {
                testSkip("HTTP/2 connection establishment timed out");
                return;
            }
            *hash<SocketPollInfo> info = poll_op.continuePoll();
            if (info) {
                Socket::poll((info,), 1s);
            }
        }

        # Test 1: Missing headers entirely (should throw HTTP2-ERROR)
        # Note: With %modern, we cannot pass NOTHING as hash<auto>, so we test
        # with an empty hash instead (which should also fail for missing :method/:path)
        assertThrows("HTTP2-ERROR", ":method.*missing",
            sub () { sock.submitHttp2Request({}); },
            NOTHING, "submitHttp2Request with empty headers should throw");

        # Test 2: Headers without :method (should throw HTTP2-ERROR)
        hash<auto> headers_no_method = {
            ":path": "/test",
            ":scheme": "https",
            ":authority": "localhost",
        };
        assertThrows("HTTP2-ERROR", ":method.*missing",
            sub () { sock.submitHttp2Request(headers_no_method); },
            NOTHING, "submitHttp2Request without :method should throw");

        # Test 3: Headers without :path (should throw HTTP2-ERROR)
        hash<auto> headers_no_path = {
            ":method": "GET",
            ":scheme": "https",
            ":authority": "localhost",
        };
        assertThrows("HTTP2-ERROR", ":path.*missing",
            sub () { sock.submitHttp2Request(headers_no_path); },
            NOTHING, "submitHttp2Request without :path should throw");

        # Test 4: Headers with empty :method (should throw HTTP2-ERROR)
        hash<auto> headers_empty_method = {
            ":method": "",
            ":path": "/test",
            ":scheme": "https",
            ":authority": "localhost",
        };
        assertThrows("HTTP2-ERROR", ":method.*missing",
            sub () { sock.submitHttp2Request(headers_empty_method); },
            NOTHING, "submitHttp2Request with empty :method should throw");

        # Test 5: Headers with empty :path (should throw HTTP2-ERROR)
        hash<auto> headers_empty_path = {
            ":method": "GET",
            ":path": "",
            ":scheme": "https",
            ":authority": "localhost",
        };
        assertThrows("HTTP2-ERROR", ":path.*missing",
            sub () { sock.submitHttp2Request(headers_empty_path); },
            NOTHING, "submitHttp2Request with empty :path should throw");

        # Test 6: Valid headers should not throw (returns stream ID)
        hash<auto> valid_headers = {
            ":method": "GET",
            ":path": "/simple",
            ":scheme": "https",
            ":authority": "localhost:" + mSslPort,
        };
        int stream_id = sock.submitHttp2Request(valid_headers);
        assertTrue(stream_id > 0, "valid submitHttp2Request should return positive stream ID");
    }

    #! Test Http2ClientStreamHandle state management
    testStreamHandleStateManagement() {
        # Test that stream states are properly defined and have expected relationships

        # Pending is the initial state
        assertEq(0, Http2ClientIo::Http2ClientStreamState::Pending, "Pending is initial state (0)");

        # Terminal states should be distinct
        int complete = Http2ClientIo::Http2ClientStreamState::Complete;
        int cancelled = Http2ClientIo::Http2ClientStreamState::Cancelled;
        int error = Http2ClientIo::Http2ClientStreamState::Error;

        assertTrue(complete != cancelled, "Complete != Cancelled");
        assertTrue(complete != error, "Complete != Error");
        assertTrue(cancelled != error, "Cancelled != Error");

        # All terminal states should be >= 4 (after ReceivingBody)
        assertTrue(complete >= 4, "Complete is a terminal state");
        assertTrue(cancelled >= 4, "Cancelled is a terminal state");
        assertTrue(error >= 4, "Error is a terminal state");
    }

