#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires Util
%requires FsUtil
%requires FileLocationHandler

%exec-class FileLocationHandlerRestrictedCallersTest

#! Tests that FileLocationHandler refuses a caller restricted from the domain of a location's scheme (qore#6959)
/** The domain is decided per scheme: a \c file location (and a location without a scheme) is in the FILESYSTEM domain,
    an \c http, \c https, \c ftp, \c ftps, \c sftp, \c rest or \c rests location in the NETWORK domain, and a \c data
    location in none.  A caller restricted from the domain of a location's scheme gets PERMISSION-DENIED from every
    static method of FileLocationHandler that reads or writes a location and from the handler that getHandler()
    returns; a caller restricted only from the other domain is not refused.  This holds also when unrestricted code
    loaded the module first (a Program that loads a module that is already loaded gets the module's code as it is, so
    only the module's own checks restrict the calls).  The restricted calls leave the directory of the test as it was.
    A \c conn location follows the policy of the connection (FileLocationHandlerConnection.qtest), and a scheme that
    host code registers the policy of its handler (testRegistered()).
*/
class FileLocationHandlerRestrictedCallersTest inherits QUnit::Test {
    private {
        const Modes = {"ast": EM_AST, "ir": EM_IR, "jit": EM_JIT, "tiered": EM_TIERED};

        #! the uses refused to a caller restricted from the file system (given the directory "d" with the file "f")
        const FilesystemUses = {
            "getTextFileFromLocation": "FileLocationHandler::getTextFileFromLocation(\"file://\" + d + \"/f\")",
            "no scheme": "FileLocationHandler::getBinaryFileFromLocation(d + \"/f\")",
            "getFileFromLocation": "FileLocationHandler::getFileFromLocation(True, \"file://\" + d + \"/f\")",
            "getResourceFromLocation": "FileLocationHandler::getResourceFromLocation(\"file://\" + d + \"/f\")",
            "getIoPollerForLocation": "FileLocationHandler::getIoPollerForLocation(\"file://\" + d + \"/f\")",
            "getResourcePollerForLocation":
                "FileLocationHandler::getResourcePollerForLocation(\"file://\" + d + \"/f\")",
            "getStreamReaderFromLocation":
                "FileLocationHandler::getStreamReaderFromLocation(\"file://\" + d + \"/f\")",
            "getBinaryStreamFromLocation":
                "FileLocationHandler::getBinaryStreamFromLocation(\"file://\" + d + \"/f\")",
            "writeFileToLocation": "FileLocationHandler::writeFileToLocation(\"file://\" + d + \"/w\", \"x\")",
            "getOutputStreamForLocation":
                "FileLocationHandler::getOutputStreamForLocation(\"file://\" + d + \"/w\")",
            "getHandler": "FileLocationHandler::AbstractFileLocationHandler h = FileLocationHandler::getHandler(\"file\"); "
                "h.getTextFile(\"file\", d + \"/f\")",
        };

        #! the uses refused to a caller restricted from the network (given the closed port "port")
        const NetworkUses = {
            "http": "FileLocationHandler::getTextFileFromLocation(sprintf(\"http://localhost:%d/\", port))",
            "https": "FileLocationHandler::getBinaryFileFromLocation(sprintf(\"https://localhost:%d/\", port))",
            "ftp": "FileLocationHandler::getTextFileFromLocation(sprintf(\"ftp://localhost:%d/x\", port))",
            "sftp": "FileLocationHandler::getTextFileFromLocation(sprintf(\"sftp://localhost:%d/x\", port))",
            "rest": "FileLocationHandler::getTextFileFromLocation(sprintf(\"rest://localhost:%d/x\", port))",
            "write": "FileLocationHandler::writeFileToLocation(sprintf(\"http://localhost:%d/x\", port), \"x\")",
            "getHandler": "FileLocationHandler::AbstractFileLocationHandler h = FileLocationHandler::getHandler(\"http\"); "
                "h.getTextFile(\"http\", sprintf(\"localhost:%d/\", port))",
            "ftps": "FileLocationHandler::getTextFileFromLocation(sprintf(\"ftps://localhost:%d/x\", port))",
            "rests": "FileLocationHandler::getTextFileFromLocation(sprintf(\"rests://localhost:%d/x\", port))",
        };

        #! the handler of every built-in scheme that is in a domain, from getHandler(): the restriction and the
        #! location (given the directory "d" and the closed port "port")
        const HandlerUses = {
            "file": (PO_NO_FILESYSTEM, "d + \"/f\""),
            "http": (PO_NO_NETWORK, "sprintf(\"localhost:%d/\", port)"),
            "https": (PO_NO_NETWORK, "sprintf(\"localhost:%d/\", port)"),
            "ftp": (PO_NO_NETWORK, "sprintf(\"localhost:%d/x\", port)"),
            "ftps": (PO_NO_NETWORK, "sprintf(\"localhost:%d/x\", port)"),
            "sftp": (PO_NO_NETWORK, "sprintf(\"localhost:%d/x\", port)"),
            "rest": (PO_NO_NETWORK, "sprintf(\"localhost:%d/x\", port)"),
            "rests": (PO_NO_NETWORK, "sprintf(\"localhost:%d/x\", port)"),
        };

        #! the options that name local files, which a caller restricted from the file system cannot give even where it
        #! may use the network (given the directory "d" with the file "f" and the closed port "port")
        const PathOptionUses = {
            "https ssl_cert_path": "FileLocationHandler::getTextFileFromLocation(sprintf(\"https://localhost:%d/x"
                "{ssl_cert_path=%s}\", port, d + \"/f\"))",
            "https ssl_key_path": "FileLocationHandler::getTextFileFromLocation(sprintf(\"https://localhost:%d/x"
                "{ssl_key_path=%s}\", port, d + \"/f\"))",
            "sftp ssh2_private_key": "FileLocationHandler::getTextFileFromLocation(sprintf(\"sftp://localhost:%d/x"
                "{ssh2_private_key=%s}\", port, d + \"/f\"))",
        };
    }

    constructor() : QUnit::Test("FileLocationHandlerRestrictedCallers", "1.0", \ARGV) {
        foreach string mode in (keys Modes) {
            string m = mode;
            addTestCase("file system, " + m, sub () { testDomain(m, PO_NO_FILESYSTEM, FilesystemUses); });
            addTestCase("network, " + m, sub () { testDomain(m, PO_NO_NETWORK, NetworkUses); });
            addTestCase("other domains and schemes, " + m, sub () { testAllowed(m); });
            addTestCase("the handlers of getHandler(), " + m, sub () { testHandlers(m); });
            addTestCase("options that name local files, " + m, sub () { testPathOptions(m); });
            addTestCase("handlers bound to a client, " + m, sub () { testBound(m); });
        }
        addTestCase("registered scheme", \testRegistered());
        set_return_value(main());
    }

    private testDomain(string mode, int po, hash<string, string> uses) {
        TmpDir tmp("qore-flh-restricted-");
        string d = tmp.path;
        writeFile(d + "/f");
        string before = listing(d);
        int port = get_free_port();

        foreach hash<auto> i in (uses.pairIterator()) {
            assertEq("PERMISSION-DENIED", run(mode, po, i.value, d, port), sprintf("%s, %s", i.key, mode));
        }
        assertEq(before, listing(d), "the directory after the restricted uses, " + mode);
    }

    private testAllowed(string mode) {
        TmpDir tmp("qore-flh-allowed-");
        string d = tmp.path;
        writeFile(d + "/f");
        int port = get_free_port();

        # data locations are in no domain
        assertEq("called", run(mode, PO_NO_FILESYSTEM | PO_NO_NETWORK,
            "FileLocationHandler::getTextFileFromLocation(\"data://test\")", d, port), "data, " + mode);
        # a caller restricted from the network reads a file
        assertEq("called", run(mode, PO_NO_NETWORK,
            "FileLocationHandler::getTextFileFromLocation(\"file://\" + d + \"/f\")", d, port), "file, " + mode);
        # a caller restricted from the file system makes a request, which the closed port refuses
        string rv = run(mode, PO_NO_FILESYSTEM,
            "FileLocationHandler::getTextFileFromLocation(sprintf(\"http://localhost:%d/\", port))", d, port);
        assertNeq("PERMISSION-DENIED", rv, "http, " + mode);
        assertNeq("called", rv, "http, " + mode);
    }

    #! the handler of every built-in scheme in a domain refuses a caller restricted from it
    private testHandlers(string mode) {
        TmpDir tmp("qore-flh-handlers-");
        string d = tmp.path;
        writeFile(d + "/f");
        int port = get_free_port();
        foreach hash<auto> i in (HandlerUses.pairIterator()) {
            string code = sprintf("FileLocationHandler::AbstractFileLocationHandler h = "
                "FileLocationHandler::getHandler(%y); h.getBinaryFile(%y, %s)", i.key, i.key, i.value[1]);
            assertEq("PERMISSION-DENIED", run(mode, i.value[0], code, d, port), sprintf("%s, %s", i.key, mode));
        }
    }

    #! a caller restricted from the file system that may use the network cannot give options that name local files
    private testPathOptions(string mode) {
        TmpDir tmp("qore-flh-path-options-");
        string d = tmp.path;
        writeFile(d + "/f");
        int port = get_free_port();
        foreach hash<auto> i in (PathOptionUses.pairIterator()) {
            assertEq("PERMISSION-DENIED", run(mode, PO_NO_FILESYSTEM, i.value, d, port), sprintf("%s, %s", i.key, mode));
        }
        # without them, the request is made, and fails as nothing listens on the port
        string rv = run(mode, PO_NO_FILESYSTEM, "FileLocationHandler::getTextFileFromLocation(sprintf("
            "\"https://localhost:%d/x\", port))", d, port);
        assertNeq("PERMISSION-DENIED", rv, "https without path options, " + mode);
        assertNeq("called", rv, "https without path options, " + mode);
    }

    #! a handler bound to a client is the capability of the code that bound it: a handler that code restricted from
    #! the network bound to a client that it made is refused, one that trusted code bound is not
    private testBound(string mode) {
        int port = get_free_port();
        string url = sprintf("http://localhost:%d", port);
        string code = sprintf("object m = create_object(\"HttpClientIo::HttpClientConnectionManager\"); "
            "FileLocationHandler::AbstractFileLocationHandler h = FileLocationHandler::getHttpHandlerForClient(m, %y); "
            "h.getTextFile(\"http\", \"/x\")", url);
        Program p(PO_NEW_STYLE | PO_NO_NETWORK);
        p.setExecMode(Modes{mode});
        p.parse("%modern\n%requires FileLocationHandler\n%requires HttpClientIo\nstring sub t() { try { " + code
            + "; return \"called\"; } catch (hash<ExceptionInfo> ex) { return ex.err; } }\n"
            "string sub host(FileLocationHandler::AbstractFileLocationHandler h) { try { h.getTextFile(\"http\", "
            "\"/x\"); return \"called\"; } catch (hash<ExceptionInfo> ex) { return ex.err; } }", "bound");
        assertEq("PERMISSION-DENIED", p.callFunction("t"), "bound by restricted code, " + mode);
        # a handler that trusted code bound is the host's capability: the request is made and fails as nothing
        # listens on the port
        load_module("HttpClientIo");
        object m = create_object("HttpClientIo::HttpClientConnectionManager");
        AbstractFileLocationHandler h = FileLocationHandler::getHttpHandlerForClient(m, url);
        string rv = p.callFunction("host", h);
        assertNeq("PERMISSION-DENIED", rv, "bound by trusted code, " + mode);
        assertNeq("called", rv, "bound by trusted code, " + mode);
    }

    #! a scheme that unrestricted host code registers follows its handler's own policy
    private testRegistered() {
        FileLocationHandler::tryRegisterHandler("qore6959", new HostHandler());
        assertEq("called", run("ast", PO_NO_FILESYSTEM | PO_NO_NETWORK,
            "FileLocationHandler::getTextFileFromLocation(\"qore6959://x\")", "", 0));
    }

    #! runs a use in a Program with the given restrictions and returns "called" or the code of its exception
    private static string run(string mode, int po, string code, string d, int port) {
        Program p(PO_NEW_STYLE | po);
        p.setExecMode(Modes{mode});
        p.parse(sprintf("%%modern\n%%requires FileLocationHandler\nstring sub t(string d, int port) { try { %s; "
            "return \"called\"; } catch (hash<ExceptionInfo> ex) { return ex.err; } }", code), "use");
        return p.callFunction("t", d, port);
    }

    private static writeFile(string path) {
        File f();
        f.open2(path, O_CREAT | O_WRONLY | O_TRUNC);
        f.write("data");
    }

    #! returns the sorted paths under a directory
    private static string listing(string dir) {
        list<string> rv;
        Dir d();
        d.chdir(dir);
        foreach string e in (d.list() ?? ()) {
            rv += e;
            if (is_dir(dir + "/" + e)) {
                rv += map e + "/" + $1, split(",", listing(dir + "/" + e));
            }
        }
        return ((map $1, sort(rv), $1 != "") ?? ()).join(",");
    }
}

#! a handler that host code registers; it serves its locations from memory
class HostHandler inherits FileLocationHandler::AbstractFileLocationHandler {
    private string getTextFileImpl(string scheme, string location, *hash<auto> opts) {
        return "host:" + location;
    }
    private binary getBinaryFileImpl(string scheme, string location, *hash<auto> opts) {
        return binary("host:" + location);
    }
    private Qore::AbstractPollOperation getIoPollerForLocationImpl(string scheme, string location,
            *hash<auto> opts) {
        throw "UNSUPPORTED";
    }
    private Qore::StreamReader getStreamReaderImpl(string scheme, string location, *hash<auto> opts) {
        throw "UNSUPPORTED";
    }
    private Qore::InputStream getBinaryStreamImpl(string scheme, string location, *hash<auto> opts) {
        throw "UNSUPPORTED";
    }
    private writeFileImpl(string scheme, string location, data contents, *hash<auto> opts) {
        throw "UNSUPPORTED";
    }
    private OutputStreamWrapper getOutputStreamImpl(string scheme, string location, *hash<auto> opts) {
        throw "UNSUPPORTED";
    }
    private hash<string, hash<FileHandlerOptionInfo>> getReadOptionsImpl() {
        return {};
    }
    private hash<string, hash<FileHandlerOptionInfo>> getWriteOptionsImpl() {
        return {};
    }
}
