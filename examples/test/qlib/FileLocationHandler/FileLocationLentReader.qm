%requires qore >= 2.0
%modern

%requires FileLocationHandler

module FileLocationLentReader {
    version = "1.0";
    desc = "library code that reads locations for the code that the host lends it to";
    author = "Qore Technologies, s.r.o.";
    license = "MIT";
}

#! the classes of the module
public namespace FileLocationLentReader {
#! Reads the locations that its caller gives, as the data providers of library modules do (qore#7806)
/** An object that the host creates is lent to the restricted code that it gives it to: its methods lend the file
    system and the network to the code that they call, so FileLocationHandler's read methods do not refuse the
    borrower, and the object checks a location that the borrower gives with checkCallerLocation()
*/
public class LentReader {
    private {
        #! the location that the object was created with
        *string own;
    }

    constructor(*string own) {
        self.own = own;
    }

    #! reads a location that the caller gives, which is checked first
    string read(string location) {
        FileLocationHandler::checkCallerLocation(location);
        return FileLocationHandler::getTextFileFromLocation(location);
    }

    #! reads a resource from a location with read options that the caller gives, which are checked first
    data readResource(string location, hash<auto> read_options) {
        FileLocationHandler::checkCallerLocation(location, True, read_options);
        return FileLocationHandler::getResourceFromLocation(location, read_options).data;
    }

    #! writes a location that the caller gives, which is checked first
    write(string location, string data) {
        FileLocationHandler::checkCallerLocation(location, False);
        FileLocationHandler::writeFileToLocation(location, data);
    }

    #! reads the location that the object was created with
    string readOwn() {
        return FileLocationHandler::getTextFileFromLocation(own);
    }
}
}
