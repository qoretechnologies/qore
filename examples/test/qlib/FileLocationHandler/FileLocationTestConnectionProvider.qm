%requires qore >= 2.0
%modern

%requires ConnectionProvider

module FileLocationTestConnectionProvider {
    version = "1.0";
    desc = "test connection provider for conn:// file locations";
    author = "Qore Technologies, s.r.o.";
    license = "MIT";
}

/*  The root directory served by the "files" connection is passed in the FLH_TEST_ROOT environment variable.

    NOTE: getenv() is used rather than the ENV hash.  ENV is a per-Program snapshot taken when the Program is
    created and is not updated by setenv(); this module is loaded into a fresh Program by
    ConnectionProvider::get_connection(), so a value set by the running test would not appear in ENV.  getenv()
    reads the real process environment and does see it.
*/

public ConnectionProvider::AbstractConnection sub get_mod_connection(string name) {
    *hash<auto> conf = ConnectionMap(){name};
    if (!conf) {
        throw "CONNECTION-ERROR", sprintf("connection %y is unknown to the test connection provider; known "
            "connections: %y", name, keys ConnectionMap());
    }
    return conf.cls.newObject(conf.config);
}

public *hash<string, ConnectionProvider::AbstractConnection> sub get_mod_connections() {
    # NOTE: built explicitly rather than with map; a hash produced by map is typed "hash", which does not satisfy
    # the declared complex return type
    hash<string, ConnectionProvider::AbstractConnection> rv();
    foreach hash<auto> i in (ConnectionMap().pairIterator()) {
        rv{i.key} = i.value.cls.newObject(i.value.config);
    }
    return rv;
}

#! Returns the test connection configuration
/** Built on each call so that the test can change FLH_TEST_ROOT between test cases
*/
hash<string, hash<auto>> sub ConnectionMap() {
    string root = getenv("FLH_TEST_ROOT") ?? "/nonexistent-flh-test-root";
    return {
        # a filesystem connection rooted at the test directory
        "files": {
            "cls": Class::forName("ConnectionProvider::FilesystemConnection"),
            "config": {
                "name": "files",
                "desc": "test filesystem connection",
                "url": "file://" + root,
            },
        },
        # a read-only filesystem connection over the same directory
        "files-ro": {
            "cls": Class::forName("ConnectionProvider::FilesystemConnection"),
            "config": {
                "name": "files-ro",
                "desc": "read-only test filesystem connection",
                "url": "file://" + root,
                "opts": {"readonly": True},
            },
        },
        # an FTP connection whose URL carries a password; used to verify that credentials never appear in errors
        "ftp-secret": {
            "cls": Class::forName("ConnectionProvider::FtpConnection"),
            "config": {
                "name": "ftp-secret",
                "desc": "test FTP connection with a password in the URL",
                "url": "ftp://ftpuser:" + PasswordMarker + "@localhost:1/base",
            },
        },
        # a connection type with no file location support at all
        "no-files": {
            "cls": Class::forName("FileLocationTestConnectionProvider::NoFileConnection"),
            "config": {
                "name": "no-files",
                "desc": "connection with no file location support",
                "url": "nofiles://localhost",
            },
        },
    };
}

#! A distinctive password value so tests can assert it never leaks into error output
public const PasswordMarker = "sup3rs3cr3tpw";

#! Test namespace
public namespace FileLocationTestConnectionProvider {
#! A connection that supports neither a file location redirect nor a native file location handler
/** Used to verify that such connections are rejected with a clear error rather than failing obscurely
*/
public class NoFileConnection inherits ConnectionProvider::AbstractConnection {
    constructor(hash<auto> config, *hash<auto> attr) : ConnectionProvider::AbstractConnection(config, attr) {
    }

    string getType() {
        return "nofiles";
    }

    private object getImpl(bool connect = True, *hash<auto> rtopts) {
        throw "TEST-CONNECTION-ERROR", "this test connection cannot be acquired";
    }
}
}
