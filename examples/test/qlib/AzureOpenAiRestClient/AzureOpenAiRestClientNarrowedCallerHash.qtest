%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires AzureOpenAiRestClient
%requires Mime

%exec-class AzureOpenAiRestClientNarrowedCallerHashTest

#! Gives access to the request signer of the client
class SigningAzureOpenAiRestClient inherits AzureOpenAiRestClient {
    constructor(hash<auto> options) : AzureOpenAiRestClient(options, True) {
    }

    hash<auto> sign(hash<auto> hdr) {
        signRequest("GET", "/models", NOTHING, \hdr);
        return hdr;
    }
}

#! Option and configuration hashes whose values all have the same type
/** A hash literal whose values all have the same type, such as \c {"apikey": "..."}, has a narrowed type (here
    \c hash<string, string>); the library must still be able to add values of other types to its own copy and report
    the real problem with the configuration.  No request is sent: connections and clients are only created
*/
class AzureOpenAiRestClientNarrowedCallerHashTest inherits QUnit::Test {
    constructor() : Test("AzureOpenAiRestClientNarrowedCallerHashTest", "1.0", \ARGV) {
        addTestCase("string-only client options", \stringClientOptions());
        addTestCase("signing narrowed request headers", \signNarrowedHeaders());
        set_return_value(main());
    }

    #! Returns the hash with its runtime type, as a caller's literal arrives in a library function
    static hash<auto> mk(hash<auto> h) {
        return h;
    }

    stringClientOptions() {
        # the options are a hash<string, string>, which cannot take the header hash
        assertEq("hash<string, string>", mk({"url": "https://example.openai.azure.com", "api_key": "test-key"})
            .fullType());
        hash<auto> opts = AzureOpenAiRestClientBase::getOptions({"url": "https://example.openai.azure.com",
            "api_key": "test-key"});
        assertEq("json", opts.data);
        assertEq({"accept": MimeTypeJson}, opts.headers);
        assertEq("https://example.openai.azure.com", opts.url);
        assertFalse(opts.hasKey("api_key"));
    }

    signNarrowedHeaders() {
        # the request headers are a hash<string, int>, which cannot take the string api-key header
        assertEq("hash<string, int>", mk({"X-Count": 1}).fullType());
        SigningAzureOpenAiRestClient client({"url": "https://example.openai.azure.com", "api_key": "test-key"});
        assertEq({"X-Count": 1, "api-key": "test-key"}, client.sign({"X-Count": 1}));
    }
}
