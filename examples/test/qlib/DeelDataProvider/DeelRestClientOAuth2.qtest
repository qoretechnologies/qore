%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires Logger
%requires Mime
%requires json
%requires ConnectionProvider
%requires RestClient
%requires HttpServerUtil
%requires HttpServer
%requires DeelRestClient

%exec-class DeelRestClientOAuth2Test

#! A local stand-in for Deel's token endpoint and API that records the requests it gets
class DeelStandInHandler inherits AbstractHttpRequestHandler {
    public {
        #! the requests received
        list<hash<auto>> requests = ();
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        requests += {
            "method": hdr.method,
            "path": hdr.path,
            "authorization": hdr.authorization,
            "x-client-id": hdr."x-client-id",
            "content-type": hdr."content-type",
            "body": body ? body.toString() : NOTHING,
        };
        if (hdr.path == "oauth2/tokens") {
            return <HttpResponseInfo>{
                "code": 200,
                "hdr": {"Content-Type": MimeTypeJson},
                "body": make_json({
                    "access_token": "new-access-token",
                    "token_type": "Bearer",
                    "expires_in": 2592000,
                    "refresh_token": "new-refresh-token",
                }),
            };
        }
        return <HttpResponseInfo>{
            "code": 200,
            "hdr": {"Content-Type": MimeTypeJson},
            "body": make_json({"data": ()}),
        };
    }
}

#! OAuth2 and API token authentication of the Deel REST client and connection (qore#6896)
/** No credentials and no network: options and URLs are inspected, and requests go to a local stand-in.
*/
public class DeelRestClientOAuth2Test inherits QUnit::Test {
    constructor() : Test("DeelRestClientOAuth2", "1.0", \ARGV, Opts) {
        addTestCase("scheme", \schemeTest());
        addTestCase("OAuth2 connection", \oauth2ConnectionTest());
        addTestCase("API token fallback", \apiTokenFallbackTest());
        addTestCase("requests to a stand-in", \standInRequestTest());
        set_return_value(main());
    }

    #! The connection scheme names OAuth2 first and defaults its options to Deel's endpoints
    schemeTest() {
        hash<ConnectionSchemeInfo> scheme = ConnectionSchemeCache::getScheme("deel");
        assertEq("oauth2_client_id,oauth2_client_secret|apikey", scheme.required_options);
        # OAuth2 is the first alternative and the API token the second
        list<string> alternatives = scheme.required_options.split("|");
        assertEq("oauth2_client_id,oauth2_client_secret", alternatives[0]);
        assertEq("apikey", alternatives[1]);

        assertEq("https://app.deel.com/oauth2/authorize", scheme.options.oauth2_auth_url.default_value);
        assertEq("https://app.deel.com/oauth2/tokens", scheme.options.oauth2_token_url.default_value);
        assertEq("authorization_code", scheme.options.oauth2_grant_type.default_value);
        assertEq(True, scheme.options.oauth2_token_use_basic_auth.default_value);
        assertEq(DeelRestClientBase::DefaultScopes, scheme.options.oauth2_scopes.default_value);
        assertTrue(inlist("contracts:read", scheme.options.oauth2_scopes.default_value));
        # the credentials are sensitive
        assertTrue(scheme.options.apikey.sensitive);
        assertTrue(scheme.options.oauth2_client_secret.sensitive);
    }

    #! A connection with the OAuth2 client credentials gets Deel's OAuth2 options and sends the client ID header
    oauth2ConnectionTest() {
        DeelRestConnection conn({
            "name": "deel-oauth2",
            "opts": {
                "oauth2_client_id": "client-1",
                "oauth2_client_secret": "secret-1",
                "oauth2_redirect_url": "https://example.com/callback",
            },
        });
        hash<auto> opts = conn.getConnectionOptions();
        assertEq("https://app.deel.com/oauth2/authorize", opts.oauth2_auth_url);
        assertEq("https://app.deel.com/oauth2/tokens", opts.oauth2_token_url);
        assertEq("authorization_code", opts.oauth2_grant_type);
        assertEq(True, opts.oauth2_token_use_basic_auth);

        # the connection offers the authorization code flow
        *hash<auto> features = conn.getFeatures();
        assertTrue(features{RestConnection::RCF_OAUTH2});
        assertTrue(features{RestConnection::RCF_OAUTH2_AUTH_CODE});

        string auth_req = conn.getAuthorizationCodeRequest(<AuthCodeInfo>{"state": "st"});
        assertRegex("^https://app\\.deel\\.com/oauth2/authorize\\?", auth_req);
        assertRegex("client_id=client-1", auth_req);
        assertRegex("response_type=code", auth_req);
        assertRegex("scope=contracts%3Aread", auth_req);

        # an authorized client sends the token with the client ID in the x-client-id header
        hash<auto> client_opts = DeelRestClientBase::getOptions(opts + {"token": "access-1"});
        assertEq("client-1", client_opts.headers."x-client-id");
        assertEq("https://app.deel.com/oauth2/tokens", client_opts.oauth2_token_url);
        DeelRestClient client(opts + {"token": "access-1"}, True);
        assertEq("client-1", client.getDefaultHeaders()."x-client-id");
        assertEq("Bearer access-1", client.getDefaultHeaders().Authorization);
        DeelRestClientIo client_io(opts + {"token": "access-1"});
        assertEq("client-1", client_io.getDefaultHeaders()."x-client-id");
    }

    #! An API token wins over OAuth2: the OAuth2 options are removed and no client ID header is sent
    apiTokenFallbackTest() {
        DeelRestConnection conn({
            "name": "deel-apikey",
            "opts": {
                "apikey": "api-token-1",
            },
        });
        # the connection does not claim OAuth2 or report the defaulted OAuth2 options as missing
        hash<auto> info = conn.getInfo();
        assertTrue(info.up);
        assertFalse(conn.getFeatures(){RestConnection::RCF_OAUTH2} ?? False);
        # nor does it need authorization (qore#6901)
        assertFalse(conn.needsAuth());
        assertEq("none", conn.getExtendedInfo().oauth2_grant_type);
        # the defaults are applied to the connection, but not to the options of its clients (qore#6901)
        assertEq("authorization_code", conn.opts.oauth2_grant_type);
        assertNothing(conn.getConnectionOptions().oauth2_grant_type);
        hash<auto> client_opts = DeelRestClientBase::getOptions(conn.getConnectionOptions());
        assertEq("Bearer api-token-1", client_opts.headers.Authorization);
        assertNothing(client_opts.headers."x-client-id");
        assertNothing(client_opts.apikey);
        foreach string opt in (DeelRestClientBase::OAuth2OptionNames) {
            assertFalse(client_opts.hasKey(opt), opt);
        }

        # an API token given with OAuth2 credentials still wins
        client_opts = DeelRestClientBase::getOptions({
            "apikey": "api-token-1",
            "oauth2_client_id": "client-1",
            "oauth2_client_secret": "secret-1",
        });
        assertEq("Bearer api-token-1", client_opts.headers.Authorization);
        assertNothing(client_opts.headers."x-client-id");
        assertFalse(client_opts.hasKey("oauth2_client_id"));

        # with neither, the client cannot authenticate
        assertThrows("DEEL-ERROR", sub () { DeelRestClientBase::getOptions({}); });
    }

    #! An expired OAuth2 token is refreshed with HTTP basic client authentication, and API calls send the client ID
    standInRequestTest() {
        HttpServer server(<HttpServerOptionInfo>{
            "logger": new Logger("server", LoggerLevel::getLevelError()),
        });
        on_exit server.stop();
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "localhost", "service": 0}).port;
        DeelStandInHandler handler();
        server.setDefaultHandler("deel", handler);
        string base = "http://localhost:" + port;

        DeelRestClient client({
            "url": base + "/rest/v2",
            "oauth2_client_id": "client-1",
            "oauth2_client_secret": "secret-1",
            "oauth2_token_url": base + "/oauth2/tokens",
            "token": "old-access-token",
            "oauth2_refresh_token": "old-refresh-token",
            "oauth2_token_expiry": now_us() - 1h,
        }, True);
        client.get("legal-entities");

        assertEq(2, handler.requests.size());
        hash<auto> token_req = handler.requests[0];
        assertEq("POST", token_req.method);
        assertEq("oauth2/tokens", token_req.path);
        assertEq("Basic " + make_base64_string("client-1:secret-1"), token_req.authorization);
        hash<auto> form = mime_parse_form_urlencoded_string(token_req.body);
        assertEq("refresh_token", form.grant_type);
        assertEq("old-refresh-token", form.refresh_token);
        assertFalse(form.hasKey("client_secret"));

        hash<auto> api_req = handler.requests[1];
        assertEq("GET", api_req.method);
        assertEq("rest/v2/legal-entities", api_req.path);
        assertEq("Bearer new-access-token", api_req.authorization);
        assertEq("client-1", api_req."x-client-id");

        # the async client sends the client ID too
        handler.requests = ();
        DeelRestClientIo client_io({
            "url": base + "/rest/v2",
            "oauth2_client_id": "client-1",
            "oauth2_client_secret": "secret-1",
            "token": "access-io",
        });
        client_io.restGet("legal-entities");
        assertEq(1, handler.requests.size());
        assertEq("Bearer access-io", handler.requests[0].authorization);
        assertEq("client-1", handler.requests[0]."x-client-id");

        # an API token is sent without the client ID header
        handler.requests = ();
        DeelRestClient key_client({"url": base + "/rest/v2", "apikey": "api-token-1"}, True);
        key_client.get("legal-entities");
        assertEq(1, handler.requests.size());
        assertEq("Bearer api-token-1", handler.requests[0].authorization);
        assertNothing(handler.requests[0]."x-client-id");
    }
}
