%modern

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/DataProvider
%requires ../../../../qlib/ConnectionProvider
%requires ../../../../qlib/RestClient.qm
%requires ../../../../qlib/Mime.qm

%try-module json
%define NoJson
%endtry

%requires ../../../../qlib/DeelRestClient.qm
%requires ../../../../qlib/DeelDataProvider

%exec-class DeelDataProviderTest

public class DeelDataProviderTest inherits QUnit::Test {
    private {
        #! Deel REST client for integration tests
        *DeelRestClient::DeelRestClient client;

        #! Logger for verbose output
        Logger logger;

        #! Deel sandbox API URL
        const SandboxApiUrl = "https://api-sandbox.demo.deel.com/rest/v2";

        #! Custom command-line options
        const MyOpts = Opts + {
            "token": "t,token=s",
            "conn": "c,connection=s",
            "contract_id": "C,contract-id=s",
            "url": "u,url=s",
            "sandbox": "s,sandbox",
        };
    }

    constructor() : Test("DeelDataProvider Test", "1.0", \ARGV, MyOpts) {
        logger = new Logger("test", LoggerLevel::getLevelInfo());

        # Unit tests (always run, no credentials needed)
        addTestCase("sanity tests", \sanityTests());
        addTestCase("factory tests", \factoryTests());
        addTestCase("metadata tests", \metadataTests());
        addTestCase("child provider tests", \childProviderTests());
        addTestCase("data type tests", \dataTypeTests());
        addTestCase("connection tests", \connectionTests());
        addTestCase("action catalog tests", \actionCatalogTests());

        # Integration tests (require DEEL_API_TOKEN)
        addTestCase("integration tests", \integrationTests());

        # Watch trigger tests
        addTestCase("watch trigger tests", \watchTriggerTests());

        # Try to set up connection for integration tests
        try {
            setupConnection();
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("Connection setup failed: %s: %s\n", ex.err, ex.desc);
            }
        }

        set_return_value(main());
    }

    #! Sets up the Deel client for integration tests
    private setupConnection() {
        *string token = m_options.token ?? ENV.DEEL_API_TOKEN;
        if (!token) {
            if (m_options.verbose) {
                printf("No API token provided (use -t option or DEEL_API_TOKEN env var)\n");
            }
            return;
        }
        hash<auto> client_opts = {"apikey": token};
        if (m_options.sandbox) {
            client_opts.url = SandboxApiUrl;
            if (m_options.verbose) {
                printf("Using Deel sandbox API: %s\n", SandboxApiUrl);
            }
        } else if (m_options.url) {
            client_opts.url = m_options.url;
            if (m_options.verbose) {
                printf("Using custom API URL: %s\n", m_options.url);
            }
        }
        client = new DeelRestClient::DeelRestClient(client_opts);
    }

    #! Check if json module is available
    private checkJson() {
%ifdef NoJson
        testSkip("no json module present");
%endif
    }

    #! Creates a DeelDataProvider for unit tests
    private *DeelDataProvider::DeelDataProvider tryCreateProvider() {
        try {
            return new DeelDataProvider::DeelDataProvider({
                "deelrestclient_options": {
                    "apikey": "fake-test-token-for-unit-tests",
                },
            });
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "SOCKET-CONNECT-ERROR" || ex.err == "SOCKET-SSL-ERROR"
                    || ex.err == "QOREADDRINFO-GETINFO-ERROR") {
                testSkip(sprintf("cannot connect to Deel API: %s", ex.desc));
            }
            # 401 Unauthorized from a reachable API — skip rather than fail unit tests
            if (ex.err == "REST-RESPONSE-ERROR" && ex.arg.status_code == 401) {
                testSkip("Deel API returned 401; skipping unit tests that require connectivity");
            }
            # Same for HTTP-CLIENT-RECEIVE-ERROR with 401
            if (ex.arg.status_code == 401) {
                testSkip("Deel API returned 401; skipping unit tests that require connectivity");
            }
            rethrow;
        }
    }

    #! Creates a provider using the real client (integration tests only)
    private *DeelDataProvider::DeelDataProvider createRealProvider() {
        if (!client) {
            testSkip("No Deel API token provided; set DEEL_API_TOKEN or use -t option");
        }
        return new DeelDataProvider::DeelDataProvider(client);
    }

    #! Basic sanity tests - provider instantiation
    sanityTests() {
        checkJson();
        *DeelDataProvider::DeelDataProvider prov = tryCreateProvider();
        if (!prov) {
            return;
        }
        assertEq("deel", prov.getName());
        assertEq("Deel data provider for global workforce management", prov.getDesc());
    }

    #! Factory tests - verify factory registration
    factoryTests() {
        checkJson();
        # Verify factory is registered
        AbstractDataProviderFactory factory = DataProvider::getFactory("deel");
        assertEq("deel", factory.getInfo().name);
        assertTrue(factory.getInfo().children_can_support_apis);
        assertTrue(factory.getInfo().children_can_support_records);

        # Verify constructor options
        hash<auto> factoryOpts = factory.getInfo().provider_info.constructor_options;
        assertTrue(factoryOpts.hasKey("deelrestclient"));
        assertTrue(factoryOpts.hasKey("deelrestclient_options"));
    }

    #! Metadata tests - verify provider info structure
    metadataTests() {
        checkJson();
        *DeelDataProvider::DeelDataProvider prov = tryCreateProvider();
        if (!prov) {
            return;
        }
        hash<DataProviderInfo> info = prov.getInfo();

        assertTrue(info.supports_children);
        assertTrue(info.children_can_support_apis);
        assertTrue(info.children_can_support_records);
        assertEq("DeelDataProvider", info.type);

        # Check constructor options include REST client options
        assertTrue(info.constructor_options.hasKey("deelrestclient"));
    }

    #! Child provider tests - verify hierarchy
    childProviderTests() {
        checkJson();
        *DeelDataProvider::DeelDataProvider prov = tryCreateProvider();
        if (!prov) {
            return;
        }

        # Check top-level child provider names
        list<string> children = prov.getChildProviderNames();

        # Collection providers
        assertTrue(inlist("contracts", children));
        assertTrue(inlist("timesheets", children));
        assertTrue(inlist("adjustments", children));
        assertTrue(inlist("workers", children));
        assertTrue(inlist("time-off", children));
        assertTrue(inlist("legal-entities", children));
        assertTrue(inlist("invoices", children));
        assertTrue(inlist("events", children));

        # Check contracts collection provider
        AbstractDataProvider contracts = prov.getChildProvider("contracts");
        assertEq("contracts", contracts.getName());
        hash<DataProviderInfo> contractsInfo = contracts.getInfo();
        assertTrue(contractsInfo.supports_read);
        assertTrue(contractsInfo.supports_native_search);
        assertTrue(contractsInfo.has_record);

        # Check contracts children (action providers)
        list<string> contractChildren = contracts.getChildProviderNames();
        assertTrue(inlist("create", contractChildren));
        assertTrue(inlist("terminate", contractChildren));
        assertTrue(inlist("sign", contractChildren));
        assertTrue(inlist("update", contractChildren));

        # Check create contract action provider
        AbstractDataProvider createContract = contracts.getChildProvider("create");
        assertEq("create", createContract.getName());
        hash<DataProviderInfo> createInfo = createContract.getInfo();
        assertTrue(createInfo.supports_request);

        # Check update contract action provider
        AbstractDataProvider updateContract = contracts.getChildProvider("update");
        assertEq("update", updateContract.getName());
        assertTrue(updateContract.getInfo().supports_request);

        # Check timesheets collection children
        AbstractDataProvider timesheets = prov.getChildProvider("timesheets");
        list<string> timesheetChildren = timesheets.getChildProviderNames();
        assertTrue(inlist("submit", timesheetChildren));
        assertTrue(inlist("update", timesheetChildren));
        assertTrue(inlist("approve", timesheetChildren));
        assertTrue(inlist("reject", timesheetChildren));
        assertTrue(inlist("delete", timesheetChildren));

        # Check adjustments collection children
        AbstractDataProvider adjustments = prov.getChildProvider("adjustments");
        list<string> adjustmentChildren = adjustments.getChildProviderNames();
        assertTrue(inlist("create", adjustmentChildren));
        assertTrue(inlist("update", adjustmentChildren));
        assertTrue(inlist("review", adjustmentChildren));
        assertTrue(inlist("delete", adjustmentChildren));

        # Check time-off children
        AbstractDataProvider timeOff = prov.getChildProvider("time-off");
        list<string> timeOffChildren = timeOff.getChildProviderNames();
        assertTrue(inlist("create-request", timeOffChildren));
        assertTrue(inlist("approve-request", timeOffChildren));
        assertTrue(inlist("reject-request", timeOffChildren));

        # Check events container
        AbstractDataProvider events = prov.getChildProvider("events");
        assertEq("events", events.getName());
        hash<DataProviderInfo> eventsInfo = events.getInfo();
        assertTrue(eventsInfo.supports_children);
        assertTrue(eventsInfo.children_can_support_observers);

        # Check event triggers
        list<string> eventChildren = events.getChildProviderNames();
        assertTrue(inlist("contract-created", eventChildren));
        assertTrue(inlist("contract-status-updated", eventChildren));
        assertTrue(inlist("contract-terminated", eventChildren));
        assertTrue(inlist("invoice-adjustment-created", eventChildren));
        assertTrue(inlist("invoice-adjustment-reviewed", eventChildren));
        assertTrue(inlist("timesheet-created", eventChildren));
        assertTrue(inlist("timesheet-reviewed", eventChildren));
        assertTrue(inlist("time-off-created", eventChildren));
        assertTrue(inlist("time-off-updated", eventChildren));
        assertTrue(inlist("time-off-reviewed", eventChildren));
    }

    #! Data type tests - verify record type field definitions
    dataTypeTests() {
        checkJson();

        # Test contract data type
        DeelDataProvider::DeelContractDataType contractType();
        hash<string, AbstractDataField> contractFields = contractType.getFields();
        assertTrue(contractFields.hasKey("id"));
        assertTrue(contractFields.hasKey("title"));
        assertTrue(contractFields.hasKey("type"));
        assertTrue(contractFields.hasKey("status"));
        assertTrue(contractFields.hasKey("currency"));
        assertTrue(contractFields.hasKey("start_date"));
        assertTrue(contractFields.hasKey("created_at"));
        assertTrue(contractFields.hasKey("updated_at"));

        # Test timesheet data type
        DeelDataProvider::DeelTimesheetDataType timesheetType();
        hash<string, AbstractDataField> timesheetFields = timesheetType.getFields();
        assertTrue(timesheetFields.hasKey("id"));
        assertTrue(timesheetFields.hasKey("contract_id"));
        assertTrue(timesheetFields.hasKey("quantity"));
        assertTrue(timesheetFields.hasKey("date"));
        assertTrue(timesheetFields.hasKey("status"));
        assertTrue(timesheetFields.hasKey("created_at"));

        # Test adjustment data type
        DeelDataProvider::DeelAdjustmentDataType adjustmentType();
        hash<string, AbstractDataField> adjustmentFields = adjustmentType.getFields();
        assertTrue(adjustmentFields.hasKey("id"));
        assertTrue(adjustmentFields.hasKey("contract_id"));
        assertTrue(adjustmentFields.hasKey("amount"));
        assertTrue(adjustmentFields.hasKey("currency"));
        assertTrue(adjustmentFields.hasKey("reason"));
        assertTrue(adjustmentFields.hasKey("status"));

        # Test worker data type
        DeelDataProvider::DeelWorkerDataType workerType();
        hash<string, AbstractDataField> workerFields = workerType.getFields();
        assertTrue(workerFields.hasKey("id"));
        assertTrue(workerFields.hasKey("first_name"));
        assertTrue(workerFields.hasKey("last_name"));
        assertTrue(workerFields.hasKey("email"));
        assertTrue(workerFields.hasKey("country_code"));
        assertTrue(workerFields.hasKey("status"));

        # Test time-off type data type
        DeelDataProvider::DeelTimeOffTypeDataType timeOffType();
        hash<string, AbstractDataField> timeOffFields = timeOffType.getFields();
        assertTrue(timeOffFields.hasKey("id"));
        assertTrue(timeOffFields.hasKey("name"));
        assertTrue(timeOffFields.hasKey("type"));
        assertTrue(timeOffFields.hasKey("balance"));

        # Test legal entity data type
        DeelDataProvider::DeelLegalEntityDataType legalEntityType();
        hash<string, AbstractDataField> legalEntityFields = legalEntityType.getFields();
        assertTrue(legalEntityFields.hasKey("id"));
        assertTrue(legalEntityFields.hasKey("name"));
        assertTrue(legalEntityFields.hasKey("country"));

        # Test invoice data type
        DeelDataProvider::DeelInvoiceDataType invoiceType();
        hash<string, AbstractDataField> invoiceFields = invoiceType.getFields();
        assertTrue(invoiceFields.hasKey("id"));
        assertTrue(invoiceFields.hasKey("amount"));
        assertTrue(invoiceFields.hasKey("currency"));
        assertTrue(invoiceFields.hasKey("status"));
        assertTrue(invoiceFields.hasKey("due_date"));

        # Test time-off request data type
        DeelDataProvider::DeelTimeOffRequestDataType timeOffRequestType();
        hash<string, AbstractDataField> timeOffRequestFields = timeOffRequestType.getFields();
        assertTrue(timeOffRequestFields.hasKey("id"));
        assertTrue(timeOffRequestFields.hasKey("start_date"));
        assertTrue(timeOffRequestFields.hasKey("end_date"));
        assertTrue(timeOffRequestFields.hasKey("status"));

        # Test delete response data type
        DeelDataProvider::DeelDeletedResponseDataType deletedType();
        hash<string, AbstractDataField> deletedFields = deletedType.getFields();
        assertTrue(deletedFields.hasKey("deleted"));

        # Test getSupportedReferenceData() returns expected reference data types
        *DeelDataProvider::DeelDataProvider prov = tryCreateProvider();
        if (prov) {
            *hash<string, bool> refData = prov.getSupportedReferenceData();
            assertTrue(refData.hasKey("contracts"));
            assertTrue(refData.hasKey("workers"));
            assertTrue(refData.hasKey("timesheets"));
            assertTrue(refData.hasKey("adjustments"));
            assertTrue(refData.hasKey("time_off_types"));
            assertTrue(refData.hasKey("time_off_requests"));
        }
    }

    #! Connection tests - verify connection scheme registration
    connectionTests() {
        # Verify the deel:// scheme is registered
        hash<ConnectionSchemeInfo> scheme = ConnectionSchemeCache::getScheme("deel");
        
        assertTrue(scheme.options.hasKey("apikey"));

        # Verify token option is sensitive and preselected
        assertTrue(scheme.options.apikey.sensitive ?? False);
    }

    #! Action catalog tests - verify all actions are registered
    actionCatalogTests() {
        checkJson();
        # Verify app is registered
        *hash<DataProviderAppInfo> appInfo = DataProviderActionCatalog::getApp("Deel");
        assertEq("Deel", appInfo.name);
        assertEq("deel", appInfo.scheme);

        # Verify key actions are registered
        *list<hash<DataProviderActionInfo>> actions = DataProviderActionCatalog::getActions("Deel");
        hash<string, bool> actionMap;
        map actionMap{$1.action} = True, actions;

        # Contract actions
        assertTrue(actionMap{"create-contract"} ?? False);
        assertTrue(actionMap{"terminate-contract"} ?? False);
        assertTrue(actionMap{"sign-contract"} ?? False);
        assertTrue(actionMap{"search-contracts"} ?? False);
        assertTrue(actionMap{"get-contract"} ?? False);

        # Timesheet actions
        assertTrue(actionMap{"submit-timesheet"} ?? False);
        assertTrue(actionMap{"update-timesheet"} ?? False);
        assertTrue(actionMap{"approve-timesheet"} ?? False);
        assertTrue(actionMap{"reject-timesheet"} ?? False);
        assertTrue(actionMap{"delete-timesheet"} ?? False);
        assertTrue(actionMap{"search-timesheets"} ?? False);
        assertTrue(actionMap{"get-timesheet"} ?? False);

        # Invoice adjustment actions
        assertTrue(actionMap{"create-invoice-adjustment"} ?? False);
        assertTrue(actionMap{"update-invoice-adjustment"} ?? False);
        assertTrue(actionMap{"review-invoice-adjustment"} ?? False);
        assertTrue(actionMap{"delete-invoice-adjustment"} ?? False);
        assertTrue(actionMap{"search-invoice-adjustments"} ?? False);
        assertTrue(actionMap{"get-invoice-adjustment"} ?? False);

        # Worker actions
        assertTrue(actionMap{"create-worker"} ?? False);
        assertTrue(actionMap{"update-worker"} ?? False);
        assertTrue(actionMap{"search-workers"} ?? False);
        assertTrue(actionMap{"get-worker"} ?? False);

        # Additional contract actions
        assertTrue(actionMap{"update-contract"} ?? False);

        # Time-off actions
        assertTrue(actionMap{"create-time-off-request"} ?? False);
        assertTrue(actionMap{"approve-time-off-request"} ?? False);
        assertTrue(actionMap{"reject-time-off-request"} ?? False);
        assertTrue(actionMap{"search-time-off-types"} ?? False);

        # Legal entity actions
        assertTrue(actionMap{"list-legal-entities"} ?? False);

        # Invoice actions
        assertTrue(actionMap{"search-invoices"} ?? False);
        assertTrue(actionMap{"get-invoice"} ?? False);

        # Event triggers
        assertTrue(actionMap{"contract-created"} ?? False);
        assertTrue(actionMap{"contract-status-updated"} ?? False);
        assertTrue(actionMap{"contract-terminated"} ?? False);
        assertTrue(actionMap{"invoice-adjustment-created"} ?? False);
        assertTrue(actionMap{"invoice-adjustment-reviewed"} ?? False);
        assertTrue(actionMap{"timesheet-created"} ?? False);
        assertTrue(actionMap{"timesheet-reviewed"} ?? False);
        assertTrue(actionMap{"time-off-created"} ?? False);
        assertTrue(actionMap{"time-off-updated"} ?? False);
        assertTrue(actionMap{"time-off-reviewed"} ?? False);
    }

    #! Integration tests - require a real Deel API token
    integrationTests() {
        checkJson();
        if (!client) {
            testSkip("No Deel API token provided; set DEEL_API_TOKEN or use -t option");
        }

        testLegalEntities();
        testContracts();
        testWorkers();
        testTimesheets();
        testAdjustments();
        testInvoices();
        testTimeOffTypes();
        writeTests();
    }

    #! Test legal entities listing
    private testLegalEntities() {
        if (m_options.verbose) {
            printf("Testing legal entities...\n");
        }
        DeelDataProvider::DeelDataProvider prov(client);
        AbstractDataProvider legalEntities = prov.getChildProvider("legal-entities");
        assertEq("legal-entities", legalEntities.getName());

        # Search for legal entities - some tokens may lack access (401/403)
        int count = 0;
        try {
            AbstractDataProviderRecordIterator it = legalEntities.searchRecords(NOTHING, {"limit": 5});
            while (it.next()) {
                hash<auto> record = it.getValue();
                assertTrue(record.hasKey("id"));
                count++;
            }
        } catch (hash<ExceptionInfo> ex) {
            if (ex.arg.status_code == 401 || ex.arg.status_code == 403) {
                if (m_options.verbose) {
                    printf("NOTE: Skipping legal entities search - token lacks access (%d)\n",
                        ex.arg.status_code);
                }
                return;
            }
            rethrow;
        }
        if (m_options.verbose) {
            printf("Found %d legal entities\n", count);
        }
    }

