    #! Test time-off types listing
    private testTimeOffTypes() {
        if (m_options.verbose) {
            printf("Testing time-off types...\n");
        }
        DeelDataProvider::DeelDataProvider prov(client);
        AbstractDataProvider timeOff = prov.getChildProvider("time-off");
        assertEq("time-off", timeOff.getName());

        # Verify the search call completes without error (endpoint works with time_offs)
        bool search_succeeded = False;
        int count = 0;
        try {
            AbstractDataProviderRecordIterator it = timeOff.searchRecords(NOTHING, {"limit": 5});
            search_succeeded = True;
            while (it.next()) {
                hash<auto> record = it.getValue();
                assertTrue(record.typeCode() == NT_HASH);
                count++;
            }
        } catch (hash<ExceptionInfo> ex) {
            if (ex.arg.status_code == 403) {
                if (m_options.verbose) {
                    printf("NOTE: Skipping time-off search - token lacks access (403)\n");
                }
                return;
            }
            rethrow;
        }
        assertTrue(search_succeeded);
        if (m_options.verbose) {
            printf("Found %d time-off records\n", count);
        }
    }

    #! Write tests with cleanup - test create/update/delete lifecycle
    private writeTests() {
        if (m_options.verbose) {
            printf("Testing write operations (create/update/delete)...\n");
        }
        DeelDataProvider::DeelDataProvider prov(client);

        # Prefer contract ID from command line option, otherwise search for one
        *string contract_id = m_options.contract_id;
        if (contract_id) {
            if (m_options.verbose) {
                printf("Using contract %s from --contract-id option\n", contract_id);
            }
        } else {
            # Find an existing contractor-type contract to use for adjustment/timesheet writes.
            # Invoice adjustments and timesheets only work with contractor contracts, not EOR or
            # global_payroll types. Search up to 50 contracts to find a compatible one.
            hash<string, bool> contractor_types = {
                "pay_as_you_go_time_based": True,
                "ongoing_time_based": True,
                "payg_milestones": True,
                "payg_task": True,
                "fixed": True,
            };
            AbstractDataProvider contracts = prov.getChildProvider("contracts");
            AbstractDataProviderRecordIterator it = contracts.searchRecords(NOTHING, {"limit": 50});
            while (it.next()) {
                hash<auto> rec = it.getValue();
                string ctype = string(rec.type ?? "");
                if (contractor_types{ctype}) {
                    contract_id = string(rec.id);
                    if (m_options.verbose) {
                        printf("Found contractor contract %s (type=%s) for write tests\n",
                            contract_id, ctype);
                    }
                    break;
                }
            }
            if (!contract_id && m_options.verbose) {
                printf("NOTE: No contractor-type contracts found in first 50 results\n");
            }
        }

        if (!contract_id) {
            if (m_options.verbose) {
                printf("NOTE: No contractor-type contracts found - skipping "
                    "adjustment/timesheet write tests\n"
                    "TIP: Create a PAYG/hourly contract in the Deel dashboard and pass its ID "
                    "with --contract-id=<id>\n");
            }
        } else {
            testWriteAdjustment(prov, contract_id);
            testWriteTimesheet(prov, contract_id);
        }
    }

    #! Test create → update → delete lifecycle for invoice adjustments
    private testWriteAdjustment(DeelDataProvider::DeelDataProvider prov, string contract_id) {
        if (m_options.verbose) {
            printf("  Testing invoice adjustment write lifecycle...\n");
        }
        AbstractDataProvider adjustments = prov.getChildProvider("adjustments");
        AbstractDataProvider createProvider = adjustments.getChildProvider("create");
        AbstractDataProvider updateProvider = adjustments.getChildProvider("update");
        AbstractDataProvider deleteProvider = adjustments.getChildProvider("delete");

        # Create an adjustment
        string today = now().format("YYYY-MM-DD");
        hash<auto> createResult = createProvider.doRequest({
            "contract_id": contract_id,
            "amount": 100.0,
            "currency": "USD",
            "date_submitted": today,
            "type": "bonus",
            "description": "Integration test bonus - safe to delete",
        });
        assertTrue(createResult.hasKey("id"));
        string adjustment_id = string(createResult.id);
        if (m_options.verbose) {
            printf("    Created adjustment %s\n", adjustment_id);
        }

        try {
            # Verify the adjustment was actually created by fetching it
            AbstractDataProvider searchProvider = adjustments;
            AbstractDataProviderRecordIterator it = searchProvider.searchRecords(NOTHING,
                {"adjustment_id": adjustment_id});
            assertTrue(it.next());
            hash<auto> fetched = it.getValue();
            assertEq(adjustment_id, string(fetched.id));
            if (m_options.verbose) {
                printf("    Verified adjustment %s exists\n", adjustment_id);
            }

            # Update the adjustment (returns {"updated": true}, no id)
            hash<auto> updateResult = updateProvider.doRequest({
                "adjustment_id": adjustment_id,
                "amount": 150.0,
                "description": "Integration test bonus - updated amount",
            });
            assertTrue(updateResult.updated ?? False);
            if (m_options.verbose) {
                printf("    Updated adjustment %s\n", adjustment_id);
            }
        } catch (hash<ExceptionInfo> ex) {
            # Cleanup even if assertions fail
            try {
                deleteProvider.doRequest({"adjustment_id": adjustment_id});
            } catch () {}
            rethrow;
        }

        # Delete the adjustment (cleanup)
        deleteProvider.doRequest({"adjustment_id": adjustment_id});
        if (m_options.verbose) {
            printf("    Deleted adjustment %s (cleanup)\n", adjustment_id);
        }

        # Verify it's gone: Deel returns 403 for deleted records, which is correct behavior
        bool confirmed_gone = False;
        try {
            AbstractDataProviderRecordIterator it2 = adjustments.searchRecords(NOTHING,
                {"adjustment_id": adjustment_id});
            confirmed_gone = !it2.next();
        } catch (hash<ExceptionInfo> ex) {
            if (ex.arg.status_code == 403 || ex.arg.status_code == 404) {
                confirmed_gone = True;  # 403/404 = record no longer accessible = deleted
            } else {
                rethrow;
            }
        }
        assertTrue(confirmed_gone);
        if (m_options.verbose) {
            printf("    Confirmed adjustment %s deleted\n", adjustment_id);
        }
    }

    #! Test submit → update → delete lifecycle for timesheets
    private testWriteTimesheet(DeelDataProvider::DeelDataProvider prov, string contract_id) {
        if (m_options.verbose) {
            printf("  Testing timesheet write lifecycle...\n");
        }
        AbstractDataProvider timesheets = prov.getChildProvider("timesheets");
        AbstractDataProvider submitProvider = timesheets.getChildProvider("submit");
        AbstractDataProvider updateProvider = timesheets.getChildProvider("update");
        AbstractDataProvider deleteProvider = timesheets.getChildProvider("delete");

        # Submit a timesheet
        string today = now().format("YYYY-MM-DD");
        hash<auto> submitResult = submitProvider.doRequest({
            "contract_id": contract_id,
            "date_submitted": today,
            "quantity": 4.0,
            "description": "Integration test work - safe to delete",
        });
        assertTrue(submitResult.hasKey("id"));
        string timesheet_id = string(submitResult.id);
        if (m_options.verbose) {
            printf("    Submitted timesheet %s\n", timesheet_id);
        }

        try {
            # Verify the timesheet was created
            AbstractDataProviderRecordIterator it = timesheets.searchRecords(NOTHING,
                {"timesheet_id": timesheet_id});
            assertTrue(it.next());
            hash<auto> fetched = it.getValue();
            assertEq(timesheet_id, string(fetched.id));
            if (m_options.verbose) {
                printf("    Verified timesheet %s exists\n", timesheet_id);
            }

            # Update the timesheet (returns {"updated": true}, no id)
            hash<auto> updateResult = updateProvider.doRequest({
                "timesheet_id": timesheet_id,
                "quantity": 6.0,
                "description": "Integration test work - updated hours",
            });
            assertTrue(updateResult.updated ?? False);
            if (m_options.verbose) {
                printf("    Updated timesheet %s\n", timesheet_id);
            }
        } catch (hash<ExceptionInfo> ex) {
            # Cleanup even if assertions fail
            try {
                deleteProvider.doRequest({"timesheet_id": timesheet_id});
            } catch () {}
            rethrow;
        }

        # Delete the timesheet (cleanup); Deel soft-deletes timesheets so the record remains
        # visible in searches — deletion success is confirmed by the call not throwing
        deleteProvider.doRequest({"timesheet_id": timesheet_id});
        if (m_options.verbose) {
            printf("    Deleted timesheet %s (cleanup)\n", timesheet_id);
        }
    }

    #! Watch trigger tests - verify polling trigger providers
    watchTriggerTests() {
        checkJson();
        *DeelDataProvider::DeelDataProvider prov = tryCreateProvider();
        if (!prov) {
            return;
        }

        AbstractDataProvider events = prov.getChildProvider("events");

        # Test each watch provider
        list<string> triggerNames = (
            "contract-created",
            "contract-status-updated",
            "contract-terminated",
            "invoice-adjustment-created",
            "invoice-adjustment-reviewed",
            "timesheet-created",
            "timesheet-reviewed",
            "time-off-created",
            "time-off-updated",
            "time-off-reviewed",
        );

        foreach string triggerName in (triggerNames) {
            AbstractDataProvider trigger = events.getChildProvider(triggerName);
            assertEq(triggerName, trigger.getName());

            hash<DataProviderInfo> triggerInfo = trigger.getInfo();
            assertTrue(triggerInfo.supports_observable);

            # Verify event types are registered
            hash<string, hash<DataProviderMessageInfo>> eventTypes = trigger.getEventTypes();
            assertTrue(eventTypes.hasKey(triggerName));

            # Verify example event data is available and has expected fields
            auto exampleData = trigger.getExampleEventData(triggerName);
            assertTrue(exampleData.val());
            assertEq(Type::Hash, exampleData.type());
            assertTrue(exampleData.id.val());

            if (m_options.verbose) {
                printf("Watch trigger '%s' OK - event type registered, example data valid\n",
                    triggerName);
            }
        }
    }
}
