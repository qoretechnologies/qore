#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/FsUtil.qm
%requires ../../../../qlib/EdifactUtil

%exec-class EdifactSchemaTest

public class EdifactSchemaTest inherits QUnit::Test {
    constructor() : Test("EdifactSchemaTest", "1.0") {
        addTestCase("Schema loader fixture", \schemaLoaderFixtureTest());
        addTestCase("Schema loader raw storage", \schemaLoaderRawStorageTest());
        addTestCase("Schema loader cache behavior", \schemaLoaderCacheBehaviorTest());
        addTestCase("Schema loader strict edge fixtures", \schemaLoaderStrictEdgeFixtureTest());
        addTestCase("Schema loader invalid fixtures", \schemaLoaderInvalidFixtureTest());
        addTestCase("Schema loader golden fixtures validation", \schemaLoaderGoldenFixturesValidationTest());

        # Return for compatibility with test harness that checks return value.
        set_return_value(main());
    }

    private *hash<EdifactMessageNode> findGroup(list<hash<EdifactMessageNode>> nodes, string id) {
        foreach hash<EdifactMessageNode> n in (nodes) {
            if (n.kind == "group" && n.id == id) {
                return n;
            }
        }
        return NOTHING;
    }

    private *hash<EdifactMessageNode> findNode(list<hash<EdifactMessageNode>> nodes, string kind, string id) {
        foreach hash<EdifactMessageNode> n in (nodes) {
            if (n.kind == kind && n.id == id) {
                return n;
            }
            if (n.children.size()) {
                *hash<EdifactMessageNode> found = findNode(n.children, kind, id);
                if (found) {
                    return found;
                }
            }
        }
        return NOTHING;
    }

    private string getFixturesRoot() {
        string script_path = get_script_path();
        if (!script_path || script_path == NOTHING) {
            script_path = getcwd();
        }
        return normalize_dir(dirname(script_path)) + DirSep + "fixtures" + DirSep;
    }

