#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires ../../../TestInterpreter.qm
%requires ../../../ExecModeHarness.qm

%exec-class SharedReleaseSchemasTest

#! Regression test for issue #7685: the release schemas of the process-wide EDIFACT registry are shared objects
/** A release schema that trusted code loads into EdifactSchemaRegistry, which getRelease() returns to every caller,
    is marked as shared: sandboxed code that gets it cannot change its members or delete it (SHARED-OBJECT-ERROR).
    Trusted code still changes it, and a schema that a tenant creates itself is its own.

    SharedReleaseSchemas.q makes the checks; its output must be the one in SharedReleaseSchemas.expected in every
    execution mode.
*/
class SharedReleaseSchemasTest inherits QUnit::Test {
    private {
        string qore_bin = TestInterpreter::qore_interpreter();
        string fixture = get_script_dir() + "/SharedReleaseSchemas.q";
        string expected = ReadOnlyFile::readTextFile(get_script_dir() + "/SharedReleaseSchemas.expected");
    }

    constructor() : QUnit::Test("shared EDIFACT release schemas", "1.0", \ARGV) {
        foreach string mode in (ExecModeHarness::ExecModes) {
            string execution_mode = mode;
            addTestCase("execution mode " + mode, sub () {
                # the checks run in child Programs and in the library modules, which choose their own execution
                assertEq(expected, ExecModeHarness::run(command(execution_mode), ExecModeHarness::NativeCheck::None));
            });
        }
        set_return_value(main());
    }

    private string command(string mode) {
        # the modules of the environment, which report on stderr, are not loaded
        return sprintf("env -u QORE_DATA_PROVIDERS -u QORE_FILE_LOCATION_HANDLERS %s --exec-mode=%s %s",
            shellQuote(qore_bin), mode, shellQuote(fixture));
    }

    private static string shellQuote(string value) {
        return "'" + replace(value, "'", "'\\''") + "'";
    }
}
