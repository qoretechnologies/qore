    testConnectCompressedFrameRoundtrip() {
        # Test connect_get_send with compression → connect_get_recv with decompression
        *code gzip_encode = ds_get_content_encode("gzip");
        *code gzip_decode = ds_get_content_decode("gzip");
        if (!gzip_encode || !gzip_decode) {
            testSkip("gzip not available");
        }

        list<auto> items = (
            {"name": "alpha", "val": 1},
            {"name": "beta", "val": 2},
            {"name": "gamma", "val": 3},
        );
        int send_idx = 0;

        code data_provider = auto sub () {
            if (send_idx >= items.size()) {
                return NOTHING;
            }
            return items[send_idx++];
        };

        # Create send callback with compression
        code send_cb = connect_get_send(data_provider, gzip_encode);

        # Collect all sent frames
        list<binary> frames = ();
        while (True) {
            auto frame = send_cb();
            if (!exists frame) {
                break;
            }
            push frames, frame;
        }
        # 3 data frames + 1 EndStreamResponse
        assertEq(4, frames.size(), "compressed: 4 frames total");

        # Verify data frames have CONNECT_FLAG_COMPRESSED set
        for (int i = 0; i < 3; i++) {
            hash<auto> f = connect_unframe_message(frames[i]);
            assertEq(CONNECT_FLAG_COMPRESSED, f.flags & CONNECT_FLAG_COMPRESSED,
                sprintf("compressed: frame %d has compressed flag", i));
            # Raw payload should be gzip-compressed (not valid YAML as-is)
            assertTrue(f.data.size() > 0, sprintf("compressed: frame %d has data", i));
        }

        # Verify EndStreamResponse is NOT compressed
        hash<auto> eos = connect_unframe_message(frames[3]);
        assertEq(CONNECT_FLAG_END_STREAM, eos.flags & CONNECT_FLAG_END_STREAM,
            "compressed: last frame is EOS");
        assertEq(0, eos.flags & CONNECT_FLAG_COMPRESSED,
            "compressed: EOS not compressed");

        # Now feed all frames to connect_get_recv with content-encoding header
        list<auto> received = ();
        bool eod_called = False;
        *string eod_error;

        code recv_cb = sub (auto data) { push received, data; };
        code eod_cb = sub (*string err) { eod_called = True; eod_error = err; };

        code callback = connect_get_recv(recv_cb, eod_cb);

        MockSocket sock();
        callback({
            "hdr": {
                "content-type": ConnectStreamMimeTypeYaml,
                ConnectContentEncodingHdr: "gzip",
            },
            "obj": sock,
        });

        # Deliver all frames as concatenated binary
        binary all_data = binary();
        for (int i = 0; i < frames.size(); i++) {
            all_data += frames[i];
        }
        callback({"data": all_data});

        assertEq(3, received.size(), "compressed recv: 3 messages");
        for (int i = 0; i < 3; i++) {
            assertEq(items[i].name, received[i].name,
                sprintf("compressed recv: msg %d name", i));
            assertEq(items[i].val, received[i].val,
                sprintf("compressed recv: msg %d val", i));
        }
        assertTrue(eod_called, "compressed recv: EOD called");
        assertEq(NOTHING, eod_error, "compressed recv: no error");
    }

    testConnectEndStreamResponseErrorFormat() {
        # Test that EndStreamResponse error JSON has the correct structure:
        # {"error":{"code":"internal","message":"ERR: desc"}}
        code data_provider = auto sub () {
            throw "MY-ERROR", "something went wrong";
        };

        code send_cb = connect_get_send(data_provider);
        auto result = send_cb();

        assertTrue(result.typeCode() == NT_BINARY, "error format: result is binary");
        hash<auto> frame = connect_unframe_message(result);
        assertEq(CONNECT_FLAG_END_STREAM, frame.flags & CONNECT_FLAG_END_STREAM,
            "error format: EOS flag set");

        # Verify JSON payload structure: {"error":{"code":"internal","message":"..."}}
        string json_str = frame.data.toString("utf-8");
        assertTrue(json_str =~ /\"error\"/, "error format: has 'error' key");
        assertTrue(json_str =~ /\"code\"/, "error format: has 'code' key");
        assertTrue(json_str =~ /\"message\"/, "error format: has 'message' key");
        assertTrue(json_str =~ /\"internal\"/, "error format: code is 'internal'");
        assertTrue(json_str =~ /MY-ERROR/, "error format: message contains error name");
        assertTrue(json_str =~ /something went wrong/,
            "error format: message contains description");

        # Verify newlines/CRs are stripped from error message
        code nl_provider = auto sub () {
            throw "NL-ERROR", "line1\nline2\rline3";
        };
        send_cb = connect_get_send(nl_provider);
        result = send_cb();
        frame = connect_unframe_message(result);
        json_str = frame.data.toString("utf-8");
        assertFalse(json_str =~ /\n/, "error format: no newline in JSON");
        assertFalse(json_str =~ /\r/, "error format: no CR in JSON");
        assertTrue(json_str =~ /line1/, "error format: NL msg preserved");
    }

    testConnectNonConnectHttpError() {
        # Test that connect_get_recv throws CONNECT-HTTP-ERROR for non-Connect error responses
        list<auto> received = ();
        bool eod_called = False;

        code recv_cb = sub (auto data) { push received, data; };
        code eod_cb = sub (*string err) { eod_called = True; };

        code callback = connect_get_recv(recv_cb, eod_cb);

        MockSocket sock();

        # HTTP 400 with text/plain content type should throw CONNECT-HTTP-ERROR
        assertThrows("CONNECT-HTTP-ERROR", sub () {
            callback({
                "hdr": {
                    "content-type": "text/plain",
                    "status_code": 400,
                },
                "obj": sock,
            });
        });

        # HTTP 500 with text/html should also throw
        callback = connect_get_recv(recv_cb, eod_cb);
        assertThrows("CONNECT-HTTP-ERROR", sub () {
            callback({
                "hdr": {
                    "content-type": "text/html; charset=utf-8",
                    "status_code": 500,
                },
                "obj": sock,
            });
        });

        # HTTP 400 with Connect content type should NOT throw
        callback = connect_get_recv(recv_cb, eod_cb);
        callback({
            "hdr": {
                "content-type": ConnectStreamMimeTypeYaml,
                "status_code": 400,
            },
            "obj": sock,
        });
        # Should not throw — Connect framing handles errors via EndStreamResponse

        # HTTP 200 with text/plain should NOT throw (not an error status)
        callback = connect_get_recv(recv_cb, eod_cb);
        callback({
            "hdr": {
                "content-type": "text/plain",
                "status_code": 200,
            },
            "obj": sock,
        });

        # HTTP/2 :status pseudo-header should also work
        callback = connect_get_recv(recv_cb, eod_cb);
        assertThrows("CONNECT-HTTP-ERROR", sub () {
            callback({
                "hdr": {
                    "content-type": "application/json",
                    ":status": 404,
                },
                "obj": sock,
            });
        });
    }

    testConnectBoundaryMaxMessageSize() {
        # Test connect_get_recv with payload exactly at max_message_size boundary
        int limit = 200;

        # Payload exactly at limit — should succeed
        {
            list<auto> received = ();
            bool eod_called = False;
            *string eod_error;

            code recv_cb = sub (auto data) { push received, data; };
            code eod_cb = sub (*string err) { eod_called = True; eod_error = err; };

            code callback = connect_get_recv(recv_cb, eod_cb, NOTHING, NOTHING, limit);

            MockSocket sock();
            callback({
                "hdr": {"content-type": ConnectStreamMimeTypeYaml},
                "obj": sock,
            });

            # Create valid YAML payload exactly at the limit
            # Pad with spaces to reach exact size (spaces are valid YAML)
            string yaml_str = "x: 1";
            if (yaml_str.size() < limit) {
                yaml_str += strmul(" ", limit - yaml_str.size());
            }
            binary payload = binary(yaml_str);
            @assert(payload.size() == limit, sprintf("payload size %d != limit %d",
                payload.size(), limit));
            binary framed = connect_frame_message(payload);

            # This should succeed (payload size == limit, valid YAML)
            callback({"data": framed});
            assertEq(1, received.size(), "at-limit payload received");
        }

        # Payload at limit + 1 — should fail with CONNECT-MESSAGE-SIZE-ERROR
        {
            list<auto> received = ();
            bool eod_called = False;

            code recv_cb = sub (auto data) { push received, data; };
            code eod_cb = sub (*string err) { eod_called = True; };

            code callback = connect_get_recv(recv_cb, eod_cb, NOTHING, NOTHING, limit);

            MockSocket sock();
            callback({
                "hdr": {"content-type": ConnectStreamMimeTypeYaml},
                "obj": sock,
            });

            binary payload = binary(strmul("x", limit + 1));
            binary framed = connect_frame_message(payload);

            assertThrows("CONNECT-MESSAGE-SIZE-ERROR", sub () {
                callback({"data": framed});
            });
        }

        # connect_unframe_message: payload exactly at limit
        {
            binary payload = binary(strmul("y", limit));
            binary framed = connect_frame_message(payload);
            hash<auto> frame = connect_unframe_message(framed, limit);
            assertEq(limit, frame.data.size(), "unframe: at limit succeeds");
        }

        # connect_unframe_message: payload at limit + 1
        {
            binary payload = binary(strmul("y", limit + 1));
            binary framed = connect_frame_message(payload);
            assertThrows("CONNECT-MESSAGE-SIZE-ERROR", \connect_unframe_message(),
                (framed, limit));
        }
    }

    testConnectSerializationError() {
        # Test that connect_get_send handles serialization errors gracefully
        # by emitting an EndStreamResponse with error info
        int call_count = 0;

        code data_provider = auto sub () {
            call_count++;
            if (call_count == 1) {
                # First call: return valid data
                return {"key": "valid"};
            }
            if (call_count == 2) {
                # Second call: throw a serialization-like error
                throw "SERIALIZATION-ERROR", "cannot serialize data";
            }
            return NOTHING;
        };

        code send_cb = connect_get_send(data_provider);

        # First call: valid data frame
        auto result = send_cb();
        assertTrue(result.typeCode() == NT_BINARY, "ser error: first result is binary");
        hash<auto> frame = connect_unframe_message(result);
        assertEq(0, frame.flags & CONNECT_FLAG_END_STREAM,
            "ser error: first frame is not EOS");
        auto parsed = parse_yaml(frame.data.toString("utf-8"));
        assertEq("valid", parsed.key, "ser error: first frame data correct");

        # Second call: should get EndStreamResponse with error (not crash)
        result = send_cb();
        assertTrue(result.typeCode() == NT_BINARY, "ser error: error result is binary");
        frame = connect_unframe_message(result);
        assertEq(CONNECT_FLAG_END_STREAM, frame.flags & CONNECT_FLAG_END_STREAM,
            "ser error: error frame has EOS flag");
        string json_str = frame.data.toString("utf-8");
        assertTrue(json_str =~ /SERIALIZATION-ERROR/,
            "ser error: error contains exception name");
        assertTrue(json_str =~ /cannot serialize/,
            "ser error: error contains description");

        # Third call: should return NOTHING (stream is done)
        result = send_cb();
        assertEq(NOTHING, result, "ser error: after error returns NOTHING");
    }

    testDSv1SendRecvRoundtrip() {
        # Test DS v1 send callback produces YAML and recv callback consumes it
        list<auto> items = (
            {"name": "alpha", "val": 1},
            {"name": "beta", "val": 2},
            {"name": "gamma", "val": 3},
        );
        int send_idx = 0;

        # Create send callback
        code data_provider = auto sub () {
            if (send_idx >= items.size()) {
                return NOTHING;
            }
            return items[send_idx++];
        };
        code send_cb = ds_get_send(data_provider);

        # Collect sent chunks — ds_get_send returns YAML strings for data items
        # and NOTHING when done
        list<auto> sent_chunks = ();
        while (True) {
            auto chunk = send_cb();
            if (!exists chunk) {
                break;
            }
            push sent_chunks, chunk;
        }
        assertEq(3, sent_chunks.size(), "DS v1 send: 3 chunks");

        # Verify each sent chunk is valid YAML
        for (int i = 0; i < 3; i++) {
            auto parsed = parse_yaml(string(sent_chunks[i]));
            assertEq(items[i].name, parsed.name, sprintf("DS v1 send: chunk %d name", i));
            assertEq(items[i].val, parsed.val, sprintf("DS v1 send: chunk %d val", i));
        }

        # Create receive callback and feed the sent chunks as pre-deserialized data
        # In real HTTP: each chunk is a YAML string, ds_get_recv deserializes it
        # Here we deliver pre-deserialized to test the callback flow
        list<auto> received = ();
        bool eod_called = False;
        *string eod_error;

        code recv_data = sub (auto data) { push received, data; };
        code eod_data = sub (*string err) { eod_called = True; eod_error = err; };

        code recv_cb = ds_get_recv(recv_data, eod_data);

        # First call: header delivery
        MockSocket sock();
        recv_cb({
            "hdr": {
                "content-type": MimeTypeYaml + ";charset=utf8",
                DataStreamContentType.lwr(): MimeTypeYaml + ";charset=utf8",
                "transfer-encoding": "chunked",
                "status_code": 200,
            },
            "obj": sock,
        });

        # Deliver data chunks as pre-deserialized (deserialized: True)
        for (int i = 0; i < items.size(); i++) {
            recv_cb({"data": items[i], "deserialized": True});
        }

        # Signal end of data via trailer headers
        recv_cb({"hdr": {}});

        assertEq(3, received.size(), "DS v1 recv: 3 items");
        assertEq("alpha", received[0].name, "DS v1 recv: first name");
        assertEq("beta", received[1].name, "DS v1 recv: second name");
        assertEq("gamma", received[2].name, "DS v1 recv: third name");
        assertTrue(eod_called, "DS v1 recv: EOD called");
        assertEq(NOTHING, eod_error, "DS v1 recv: no error");
    }

    testDSv1MultiplexedPartialYaml() {
        list<auto> items = (
            {"name": "alpha", "val": 1},
            {"name": "beta", "val": 2},
            {"name": "gamma", "val": 3},
        );
        string first = make_yaml(items[0]);
        string second = make_yaml(items[1]);
        string third = make_yaml(items[2]);

        list<auto> received = ();
        bool eod_called = False;
        *string eod_error;

        code recv_data = sub (auto data) { push received, data; };
        code eod_data = sub (*string err) { eod_called = True; eod_error = err; };
        code recv_cb = ds_get_recv(recv_data, eod_data);

        MockSocket sock();
        recv_cb({
            "hdr": {
                "content-type": "application/octet-stream",
                DataStreamContentType.lwr(): MimeTypeYaml + ";charset=utf8",
                "status_code": 200,
            },
            "obj": sock,
        });

        int split_pos = first.size() / 2;
        recv_cb({"data": first.substr(0, split_pos)});
        assertEq(0, received.size(), "partial first document is buffered");

        recv_cb({"data": first.substr(split_pos) + second.substr(0, 8)});
        assertEq(1, received.size(), "first document delivered at next YAML boundary");
        assertEq("alpha", received[0].name, "first buffered document value");

        recv_cb({"data": second.substr(8) + third});
        assertEq(2, received.size(), "second document delivered at next YAML boundary");
        assertEq("beta", received[1].name, "second buffered document value");
        assertFalse(eod_called, "EOD not called before trailer");

        recv_cb({"hdr": {}});
        assertTrue(eod_called, "EOD called after trailer");
        assertEq(NOTHING, eod_error, "multiplexed DS v1 recv: no error");
        assertEq(3, received.size(), "trailing document delivered at EOD");
        assertEq("gamma", received[2].name, "trailing buffered document value");

        received = ();
        recv_cb = ds_get_recv(recv_data, eod_data);
        MockSocket sock2();
        recv_cb({
            "hdr": {
                "content-type": "application/octet-stream",
                DataStreamContentType.lwr(): MimeTypeYaml + ";charset=utf8",
                "status_code": 200,
            },
            "obj": sock2,
        });
        recv_cb({"data": first + second + third, "final": True});
        assertEq(3, received.size(), "final full body delivers all documents");
        assertEq("gamma", received[2].name, "final full body trailing value");
    }

    testDSv1SendErrorTrailer() {
        # Test DS v1 send callback error handling — exception creates DataStream-Error trailer
        code data_provider = auto sub () {
            throw "SEND-ERROR", "provider failed";
        };

        code send_cb = ds_get_send(data_provider);

        # ds_get_send catches the exception and returns a hash with DataStreamError
        # This hash is NOT YAML-encoded — the HTTP chunked layer handles that
        auto result = send_cb();
        assertEq(NT_HASH, result.typeCode(), "DS v1 error: result is hash");
        assertTrue(result.hasKey(DataStreamError), "DS v1 error: has DataStreamError key");
        assertTrue(result{DataStreamError} =~ /SEND-ERROR/, "DS v1 error: contains error code");
        assertTrue(result{DataStreamError} =~ /provider failed/,
            "DS v1 error: contains error desc");

        # Verify the error can be received via ds_get_recv as a trailer
        # The DataStreamError hash is what gets sent as the last chunk
        # and then reported as a trailer via the hdr callback
        list<auto> received = ();
        bool eod_called = False;
        *string eod_error;

        code recv_data = sub (auto data) { push received, data; };
        code eod_data = sub (*string err) { eod_called = True; eod_error = err; };

        code recv_cb = ds_get_recv(recv_data, eod_data);

        MockSocket sock();
        recv_cb({
            "hdr": {
                "content-type": MimeTypeYaml + ";charset=utf8",
                "status_code": 200,
            },
            "obj": sock,
        });

        # Deliver the error trailer via the second header delivery
        recv_cb({
            "hdr": {
                DataStreamError.lwr(): result{DataStreamError},
            },
        });

        assertTrue(eod_called, "DS v1 error recv: EOD called");
        assertEq(result{DataStreamError}, eod_error, "DS v1 error recv: error propagated");
    }
}

# Mock socket class for testing
class MockSocket {
    private {
        string encoding = "UTF-8";
    }

    setEncoding(string enc) {
        encoding = enc;
    }

    string encoding() {
        return encoding;
    }
}
