%modern
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Logger
%requires Mime
%requires HttpServerUtil
%requires HttpServer
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/GeminiBodyShape.qm
%requires ../../../../qlib/GeminiRestClient.qm
%requires ../../../../qlib/VertexAiRestClient.qm
%requires ../../../../qlib/QoreLlmUtils
%requires json
%exec-class GeminiToolSchemaTest

#! Captures generateContent requests and answers them with a canned response
class CaptureToolRest inherits RestClientIo::RestClientIo {
    public {
        list<hash<auto>> bodies = ();
        hash<auto> response;
    }
    constructor(hash<auto> response) : RestClientIo({"url": "http://localhost", "data": "json"}) {
        self.response = response;
    }
    hash<RestClient::RestResponseInfo> restPostWithTimeout(string path, auto body, *hash<auto> hdr, int timeout_ms) {
        push bodies, body;
        return <RestClient::RestResponseInfo>{"status_code": 200, "body": response};
    }
}

#! Answers every generateContent request with an HTTP error, as the REST client raises it
class ErrorToolRest inherits CaptureToolRest {
    public {
        int status_code;
        hash<auto> error_body;
    }
    constructor(int status_code, hash<auto> error_body) : CaptureToolRest({}) {
        self.status_code = status_code;
        self.error_body = error_body;
    }
    hash<RestClient::RestResponseInfo> restPostWithTimeout(string path, auto body, *hash<auto> hdr, int timeout_ms) {
        push bodies, body;
        throw "REST-RESPONSE-ERROR", sprintf("HTTP %d response received", status_code), {
            "status_code": status_code,
            "body": error_body,
        };
    }
}

class CaptureToolGeminiProvider inherits GeminiRestClient::GeminiLlmProvider {
    private {
        CaptureToolRest rest;
    }
    constructor(hash<QoreLlmUtils::LlmBackendConfig> config, CaptureToolRest rest) : GeminiLlmProvider(config) {
        self.rest = rest;
    }
    RestClientIo::RestClientIo createRestClient() {
        return rest;
    }
}

class CaptureToolVertexProvider inherits VertexAiRestClient::VertexAiLlmProvider {
    private {
        CaptureToolRest rest;
    }
    constructor(hash<QoreLlmUtils::LlmBackendConfig> config, CaptureToolRest rest) : VertexAiLlmProvider(config) {
        self.rest = rest;
    }
    RestClientIo::RestClientIo createRestClient() {
        return rest;
    }
    *hash<auto> getRequestHeaders(*hash<QoreLlmUtils::LlmRequestOptions> opts) {
        return NOTHING;
    }
}

#! Serves one streamed Gemini response
class FakeGeminiStreamHandler inherits AbstractHttpRequestHandler {
    public {
        list<hash<auto>> chunks;
        list<hash<auto>> requests = ();
        *hash<auto> error_body;
    }
    constructor(list<hash<auto>> chunks) {
        self.chunks = chunks;
    }
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        push requests, {"path": cx.raw_path, "body": body.val() ? parse_json(body) : {}};
        if (error_body) {
            return makeResponse(400, make_json(error_body), {"Content-Type": MimeTypeJson});
        }
        list<string> frames = map "data: " + make_json($1), chunks;
        return makeResponse(200, frames.join("\n\n") + "\n\n", {"Content-Type": "text/event-stream"});
    }
}

class GeminiToolSchemaTest inherits QUnit::Test {
    private {
        #! a choice dialog: an array of objects
        const PresentChoices = {
            "type": "object",
            "properties": {
                "question": {"type": "string", "description": "the question to ask"},
                "options": {
                    "type": "array",
                    "description": "the choices offered",
                    "minItems": 2,
                    "items": {
                        "type": "object",
                        "additionalProperties": False,
                        "properties": {
                            "label": {"type": "string", "maxLength": 80},
                            "value": {"type": "string"},
                            "description": {"type": "string"},
                        },
                        "required": ("label", "value"),
                    },
                },
            },
            "required": ("question", "options"),
        };

        #! nested objects
        const CreateCustomer = {
            "type": "object",
            "properties": {
                "customer": {
                    "type": "object",
                    "properties": {
                        "name": {"type": "string"},
                        "address": {
                            "type": "object",
                            "properties": {
                                "street": {"type": "string"},
                                "city": {"type": "string"},
                                "geo": {
                                    "type": "object",
                                    "properties": {
                                        "lat": {"type": "number"},
                                        "lng": {"type": "number"},
                                    },
                                    "required": ("lat", "lng"),
                                },
                            },
                            "required": ("city",),
                        },
                    },
                    "required": ("name", "address"),
                },
            },
            "required": ("customer",),
        };

        #! an OpenAPI operation: path and query parameters plus a request body with referenced schemas
        const CreateOrder = {
            "type": "object",
            "$defs": {
                "Line": {
                    "type": "object",
                    "properties": {
                        "sku": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
                        "quantity": {"type": "integer", "minimum": 1},
                        "product": {"$ref": "#/$defs/Product"},
                    },
                    "required": ("sku", "quantity"),
                },
                "Product": {
                    "type": "object",
                    "properties": {
                        "name": {"type": "string"},
                        "price": {"type": "number"},
                    },
                },
            },
            "properties": {
                "storeId": {"type": "string", "description": "path parameter"},
                "dryRun": {"type": "boolean", "description": "query parameter"},
                "body": {
                    "type": "object",
                    "description": "request body",
                    "properties": {
                        "customer": {
                            "type": "object",
                            "properties": {
                                "id": {"type": "string", "format": "uuid"},
                                "email": {"type": "string", "format": "email"},
                            },
                        },
                        "lines": {
                            "type": "array",
                            "items": {"$ref": "#/$defs/Line"},
                        },
                        "note": {
                            "anyOf": ({"type": "string"}, {"type": "null"}),
                        },
                        "priority": {"type": ("string", "null"), "enum": ("low", "high", NOTHING)},
                    },
                    "required": ("customer", "lines"),
                },
            },
            "required": ("storeId", "body"),
        };

        #! objects nested seven deep
        const DeepTree = {
            "type": "object",
            "properties": {
                "l2": {"type": "object", "properties": {
                    "l3": {"type": "object", "properties": {
                        "l4": {"type": "object", "properties": {
                            "l5": {"type": "object", "properties": {
                                "name": {"type": "string"},
                                "l6": {"type": "object", "description": "deep detail", "properties": {
                                    "l7": {"type": "object", "properties": {
                                        "leaf": {"type": "string"},
                                    }},
                                    "count": {"type": "integer"},
                                }, "required": ("l7",)},
                            }},
                        }},
                    }},
                }},
            },
        };

        #! constraints that Gemini does not receive
        const Constrained = {
            "type": "object",
            "properties": {
                "currency": {"type": "string", "description": "ISO currency", "enum": ("EUR", "USD", "CZK"),
                    "default": "EUR", "pattern": "^[A-Z]{3}$", "minLength": 3, "maxLength": 3},
                "quantity": {"type": "integer", "minimum": 1, "maximum": 10, "multipleOf": 2},
                "ratio": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 100},
                "score": {"type": "number", "minimum": 0, "exclusiveMinimum": True, "maximum": 5},
                "due": {"type": "string", "format": "date-time"},
                "company": {"type": "string", "minLength": 1, "example_value": "ACME"},
                "tags": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": True,
                    "items": {"type": "string", "enum": ("a", "b")}},
                "labels_closed": {"type": "object", "properties": {"x": {"type": "string"}}, "minProperties": 1},
                "odd": {"type": "string", "enum": ("a, b", "", 1, True, NULL)},
                "level": {"type": "string", "allowed_values": ({"value": "low", "display_name": "Low"},
                    {"value": "high", "display_name": "High"}), "default_value": "low"},
            },
        };

        #! schemas that Gemini cannot declare as structure
        const Unsupported = {
            "type": "object",
            "$defs": {
                "Node": {
                    "type": "object",
                    "properties": {
                        "label": {"type": "string"},
                        "children": {"type": "array", "items": {"$ref": "#/$defs/Node"}},
                    },
                },
            },
            "properties": {
                "labels": {"type": "object", "additionalProperties": {"type": "string"},
                    "description": "label map"},
                "settings": {"type": "object"},
                "empty": {"type": "object", "properties": {}, "additionalProperties": False},
                "value": {"anyOf": ({"type": "string"}, {"type": "object", "properties": {"x": {"type": "integer"}}})},
                "anything": {"description": "any value"},
                "mode": {"const": "fast"},
                "tree": {"$ref": "#/$defs/Node"},
                "missing": {"$ref": "#/$defs/Missing"},
                "options": {"type": ("object", "null"), "description": "optional settings"},
            },
        };
    }

    constructor() : Test("Gemini tool schemas", "1.0", \ARGV) {
        addTestCase("nested objects keep every member", \nestedObjects());
        addTestCase("arrays of objects keep their item members", \arrayOfObjects());
        addTestCase("OpenAPI request bodies resolve references", \openApiBody());
        addTestCase("nesting beyond the limit is sent as JSON text", \deepNesting());
        addTestCase("unsupported schemas are sent as JSON text", \unsupported());
        addTestCase("providers return tool calls with their declared types", \providerRoundTrip());
        addTestCase("replayed tool calls take their declared shape", \replay());
        addTestCase("streamed tool calls are decoded", \streaming());
        addTestCase("decoding keeps what is not JSON text", \decodingEdges());
        addTestCase("dropped constraints are stated in descriptions", \constraintNotes());
        addTestCase("constraint notes are bounded", \constraintNoteCap());
        addTestCase("constraint notes do not repeat the description", \constraintNoteDuplicates());
        addTestCase("constraint notes do not change tool calls", \constraintNoteRoundTrip());
        addTestCase("JSON text summaries name every required member", \summaryMembers());
        addTestCase("JSON text summaries are bounded and deterministic", \summaryBound());
        addTestCase("a tool catalog too complex for any-tool mode raises a specific error", \tooComplex());
        addTestCase("other errors are raised as before", \tooComplexNot());
        addTestCase("a streamed tool catalog too complex for any-tool mode raises a specific error",
            \tooComplexStream());
        set_return_value(main());
    }

    nestedObjects() {
        hash<auto> params = declaredParameters("create_customer", CreateCustomer);
        assertEq((), lostMembers(CreateCustomer, params));
        assertEq(("lat", "lng"), params.properties.customer.properties.address.properties.geo.required);
        assertEq("number", params.properties.customer.properties.address.properties.geo.properties.lat.type);
        assertEq((), GeminiBodyShape::shapeToolParameters(CreateCustomer).stringified, "nothing is stringified");
    }

    arrayOfObjects() {
        hash<auto> params = declaredParameters("present_choices", PresentChoices);
        assertEq((), lostMembers(PresentChoices, params));
        hash<auto> item = params.properties.options.items;
        assertEq("object", item.type);
        assertEq(("label", "value"), item.required);
        assertFalse(item.hasKey("additionalProperties"));
        assertFalse(item.properties.label.hasKey("maxLength"));
        assertFalse(params.properties.options.hasKey("minItems"));
    }

    openApiBody() {
        hash<auto> params = declaredParameters("create_order", CreateOrder);
        assertEq((), lostMembers(CreateOrder, params));
        assertFalse(params.hasKey("$defs"));
        hash<auto> line = params.properties.body.properties.lines.items;
        assertEq("object", line.type);
        assertEq(("sku", "quantity"), line.required);
        assertEq("number", line.properties.product.properties.price.type, "a nested reference is resolved");
        assertEq({"type": "string", "nullable": True}, params.properties.body.properties.note,
            "a null alternative makes the value nullable");
        assertEq({"type": "string", "nullable": True, "description": "Allowed values: low, high, null"},
            params.properties.body.properties.priority, "a null type makes the value nullable");
        assertEq("request body", params.properties.body.description);
        assertEq((), GeminiBodyShape::shapeToolParameters(CreateOrder).stringified);
    }

    deepNesting() {
        hash<GeminiToolParameterSchema> shaped = GeminiBodyShape::shapeToolParameters(DeepTree);
        assertEq((("l2", "l3", "l4", "l5", "l6"),), shaped.stringified);
        hash<auto> l5 = shaped.parameters.properties.l2.properties.l3.properties.l4.properties.l5;
        assertEq("object", l5.type, "depth 5 is structured");
        assertEq("string", l5.properties.name.type);
        assertEq("string", l5.properties.l6.type, "depth 6 is JSON text");
        assertTrue(l5.properties.l6.description.find("deep detail") == 0, "the original description is kept");
        assertTrue(l5.properties.l6.description.find("{l7*: {leaf: string}, count: integer}") > 0,
            "the description summarizes the original schema");
        assertEq((), lostMembers(DeepTree, declaredParameters("deep", DeepTree)));

        hash<auto> l6 = {"l7": {"leaf": "green"}, "count": 3};
        hash<auto> args = {"l2": {"l3": {"l4": {"l5": {"name": "n", "l6": l6}}}}};
        hash<auto> wire = GeminiBodyShape::encodeToolArguments(args, shaped.stringified);
        assertEq(make_json(l6), wire.l2.l3.l4.l5.l6);
        assertEq(args, callTool("deep", DeepTree, wire), "the provider decodes the deep value");
    }

    unsupported() {
        hash<GeminiToolParameterSchema> shaped = GeminiBodyShape::shapeToolParameters(Unsupported);
        hash<auto> props = shaped.parameters.properties;
        assertEq((("labels",), ("settings",), ("value",), ("anything",), ("tree", "children", NOTHING),
            ("missing",), ("options",)), shaped.stringified);
        foreach string name in (("labels", "settings", "value", "anything", "missing")) {
            assertEq("string", props{name}.type, name);
        }
        assertTrue(props.labels.description.find("label map") == 0);
        assertEq("string", props.options.type);
        assertTrue(props.options.nullable, "a nullable value sent as JSON text stays nullable");
        assertTrue(props.value.description.find(": string | {x: integer}") > 0, "the alternatives are described");
        assertEq({"type": "object", "properties": {}}, props.empty, "a closed empty object needs no text");
        assertEq({"type": "string", "description": "Allowed values: fast"}, props.mode,
            "a constant is a string whose value is stated as a constraint");
        hash<auto> tree = props.tree;
        assertEq("object", tree.type, "the first level of a recursive schema is structured");
        assertEq("string", tree.properties.label.type);
        assertEq("string", tree.properties.children.items.type, "the recursion is JSON text");
        assertTrue(tree.properties.children.items.description.find(": {label: string, children: [{…}]}") > 0,
            "the description summarizes the referenced schema and marks the recursion");
        assertEq((), lostMembers(Unsupported, declaredParameters("unsupported", Unsupported)));

        hash<auto> args = {
            "labels": {"env": "prod", "team": "ops"},
            "settings": {"retries": 3, "verbose": True},
            "empty": {},
            "value": {"x": 2},
            "anything": (1, "two"),
            "mode": "fast",
            "tree": {"label": "root", "children": ({"label": "a", "children": ({"label": "a1"},)}, {"label": "b"})},
            "missing": {"free": "form"},
            "options": {"retries": 2},
        };
        assertEq(args, callTool("unsupported", Unsupported,
            GeminiBodyShape::encodeToolArguments(args, shaped.stringified)));
    }

    providerRoundTrip() {
        hash<auto> args = {
            "question": "Which database?",
            "options": (
                {"label": "PostgreSQL", "value": "pgsql", "description": "relational"},
                {"label": "Oracle", "value": "oracle"},
            ),
        };
        foreach string mode in (("gemini", "vertex")) {
            CaptureToolRest rest(functionCallResponse("present_choices", args));
            hash<QoreLlmUtils::ChatResponse> rv = makeProvider(mode, rest).chat(
                (<QoreLlmUtils::ChatMessage>{"role": "user", "content": "ask"},),
                (<QoreLlmUtils::ToolDefinition>{"name": "present_choices", "parameters": PresentChoices},));
            assertEq(args, rv.tool_calls[0].arguments, mode);
            assertEq((), lostMembers(PresentChoices,
                rest.bodies[0].tools[0].functionDeclarations[0].parameters), mode);
        }
    }

    replay() {
        hash<GeminiToolParameterSchema> shaped = GeminiBodyShape::shapeToolParameters(Unsupported);
        hash<auto> args = {"settings": {"retries": 3}, "tree": {"label": "root",
            "children": ({"label": "a"},)}};
        hash<auto> body = GeminiBodyShape::shapeChatBody((
            <QoreLlmUtils::ChatMessage>{"role": "user", "content": "configure"},
            <QoreLlmUtils::ChatMessage>{"role": "assistant", "tool_calls": (<QoreLlmUtils::ChatToolCall>{
                "id": "call-1", "name": "unsupported", "arguments": args},)},
            <QoreLlmUtils::ChatMessage>{"role": "tool", "tool_call_id": "call-1", "content": "{\"ok\":true}"},
        ), (<QoreLlmUtils::ToolDefinition>{"name": "unsupported", "parameters": Unsupported},), NOTHING, {});
        hash<auto> replayed = body.contents[1].parts[0].functionCall.args;
        assertEq("{\"retries\":3}", replayed.settings);
        assertEq("{\"label\":\"a\"}", replayed.tree.children[0]);
        assertEq("root", replayed.tree.label);
        assertEq(args, GeminiBodyShape::decodeToolArguments(replayed, shaped.stringified));

        hash<GeminiChatRequest> request = GeminiBodyShape::shapeChatRequest((), (
            <QoreLlmUtils::ToolDefinition>{"name": "unsupported", "parameters": Unsupported},
            <QoreLlmUtils::ToolDefinition>{"name": "create_customer", "parameters": CreateCustomer},
        ), NOTHING, {"cached_content": "cachedContents/abc"});
        assertFalse(request.body.hasKey("tools"), "the tools of a cached request are in the cache");
        assertEq({"unsupported": shaped.stringified}, request.stringified_arguments,
            "the arguments of a cached request's tools are still decoded");
    }

    streaming() {
        hash<auto> args = {"labels": {"env": "prod"}, "tree": {"label": "root", "children": ({"label": "a"},)}};
        hash<auto> wire = GeminiBodyShape::encodeToolArguments(args,
            GeminiBodyShape::shapeToolParameters(Unsupported).stringified);
        Logger logger("test", LoggerLevel::getLevelWarn());
        HttpServer http(<HttpServerOptionInfo>{"logger": logger, "debug": False});
        on_exit delete http;
        int port = http.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        FakeGeminiStreamHandler handler(({
            "candidates": ({
                "content": {"parts": ({"functionCall": {"name": "unsupported", "args": wire}},)},
                "finishReason": "STOP",
            },),
        },));
        http.setHandler("gemini", "/", MimeTypeJson, handler);
        QoreLlmUtils::LlmBackend llm(<QoreLlmUtils::LlmBackendConfig>{
            "mode": "gemini", "url": "http://localhost:" + port, "model": "gemini-2.5-flash",
            "api_key": "test-only-key", "max_retries": 0,
        });
        list<hash<QoreLlmUtils::ChatStreamEvent>> events = ();
        hash<QoreLlmUtils::ChatResponse> rv = llm.chatStreamCollect(
            (<QoreLlmUtils::ChatMessage>{"role": "user", "content": "configure"},),
            sub (hash<QoreLlmUtils::ChatStreamEvent> event) { push events, event; },
            (<QoreLlmUtils::ToolDefinition>{"name": "unsupported", "parameters": Unsupported},));
        assertEq(args, rv.tool_calls[0].arguments);
        assertEq(args, events[0].raw.candidates[0].content.parts[0].functionCall.args,
            "the streamed chunk carries the decoded arguments");
        assertEq("string", handler.requests[0].body.tools[0].functionDeclarations[0].parameters.properties.labels.type);
    }

    decodingEdges() {
        list<list<*string>> paths = (("a",), ("list", NOTHING), ("missing", "x"));
        assertEq({"a": {"x": 1}, "list": ({"y": 2}, "not json", 3)},
            GeminiBodyShape::decodeToolArguments({"a": "{\"x\":1}", "list": ("{\"y\":2}", "not json", 3)}, paths),
            "invalid JSON text and values that are already structured are kept");
        assertEq({"a": {"x": 1}}, GeminiBodyShape::decodeToolArguments({"a": {"x": 1}}, paths));
        assertEq({"b": "{\"x\":1}"}, GeminiBodyShape::decodeToolArguments({"b": "{\"x\":1}"}, paths),
            "only the recorded paths are decoded");
        assertEq({}, GeminiBodyShape::decodeToolArguments({}, NOTHING));
        hash<auto> body = {"candidates": ({"content": {"parts": ({"text": "hi"},
            {"functionCall": {"name": "other", "args": {"a": "{\"x\":1}"}}})}},)};
        assertEq(body, GeminiBodyShape::decodeResponseToolArguments(body, {"tool": paths}),
            "the arguments of other tools are unchanged");
    }

    constraintNotes() {
        hash<auto> props = declaredParameters("constrained", Constrained).properties;
        assertEq("ISO currency\nAllowed values: EUR, USD, CZK; default: EUR; pattern: ^[A-Z]{3}$; length: 3",
            props.currency.description);
        assertEq("string", props.currency.type);
        assertFalse(props.currency.hasKey("enum"));
        assertEq("range: 1 to 10; multiple of: 2", props.quantity.description);
        assertEq("greater than 0; less than 100", props.ratio.description, "exclusive bounds (JSON Schema 2019)");
        assertEq("greater than 0; maximum: 5", props.score.description, "exclusive bounds (JSON Schema draft 4)");
        assertEq("format: date-time", props.due.description);
        assertEq("length: at least 1; example: ACME", props.company.description);
        assertEq("items: 1 to 5; items: unique", props.tags.description);
        assertEq("Allowed values: a, b", props.tags.items.description, "item constraints are stated on the item");
        assertEq("properties: at least 1", props.labels_closed.description);
        assertEq("Allowed values: \"a, b\", \"\", 1, true, null", props.odd.description,
            "values that the note's punctuation would make ambiguous are quoted");
        assertEq("Allowed values: low, high; default: low", props.level.description,
            "data provider allowed_values and default_value are stated");
        # a value sent as JSON text already has its whole schema in the description
        hash<auto> deep = declaredParameters("deep", DeepTree).properties.l2.properties.l3.properties.l4
            .properties.l5.properties.l6;
        assertEq(1, (deep.description =~ x/(holding JSON text)/g).size());
        assertFalse(deep.description =~ /\n(Allowed values|range|length|format):/,
            "no constraint note is added to JSON text");

        # a response schema keeps enum and default natively, so only the other constraints are stated
        hash<auto> response = GeminiBodyShape::sanitizeSchema(Constrained).properties.currency;
        assertEq(("EUR", "USD", "CZK"), response."enum");
        assertEq("EUR", response."default");
        assertEq("ISO currency\npattern: ^[A-Z]{3}$; length: 3", response.description);
    }

    constraintNoteCap() {
        list<string> values = map sprintf("value_%03d", $1), xrange(60);
        hash<auto> schema = {"type": "object", "properties": {
            "big": {"type": "string", "enum": values},
            "big_with_range": {"type": "string", "enum": values, "minLength": 9, "maxLength": 9,
                "pattern": "^value_[0-9]{3}$", "default": "value_000"},
            "long_pattern": {"type": "string", "pattern": "^" + strmul("[a-z]", 30) + "$", "minLength": 30},
            "huge": {"type": "string", "enum": (strmul("x", 300), "y")},
        }};
        hash<auto> props = GeminiBodyShape::shapeToolParameters(schema).parameters.properties;
        string big = props.big.description;
        assertTrue(big.length() <= GeminiBodyShape::SchemaConstraintNoteMaxChars, big);
        assertRegex("^Allowed values: value_000, value_001, .* … and [0-9]+ more$", big);
        int shown = (big =~ x/(value_[0-9]+)/g).size();
        assertEq(sprintf(" … and %d more", 60 - shown), big.substr(big.rfind(" …")), "the count is exact");
        assertTrue(big.length() > GeminiBodyShape::SchemaConstraintNoteMaxChars - 20, "the cap is used");

        string with_range = props.big_with_range.description;
        assertTrue(with_range.length() <= GeminiBodyShape::SchemaConstraintNoteMaxChars, with_range);
        assertRegex("^Allowed values: value_000, .* … and [0-9]+ more; default: value_000; "
            "pattern: \\^value_\\[0-9\\]\\{3\\}\\$; length: 9$", with_range,
            "the other constraints are kept and the values take what is left");

        assertEq("length: at least 30", props.long_pattern.description,
            "a pattern too long to state whole is left out rather than cut");
        assertEq("2 allowed values", props.huge.description, "a value longer than the cap is counted");
    }

    constraintNoteDuplicates() {
        hash<auto> schema = {"type": "object", "properties": {
            "currency": {"type": "string", "enum": ("EUR", "USD"), "default": "EUR",
                "description": "Currency, one of EUR or USD (default EUR)"},
            "code": {"type": "string", "pattern": "^[A-Z]{3}$",
                "description": "Three letters matching ^[A-Z]{3}$"},
            "due": {"type": "string", "format": "date-time", "description": "Due date in date-time format"},
            "count": {"type": "integer", "minimum": 1, "maximum": 9, "description": "range: 1 to 9 units"},
            "flag": {"type": "string", "enum": ("y", "n"), "description": "y or n"},
            "mode": {"type": "string", "enum": ("fast", "slow"), "description": "fast or medium"},
        }};
        hash<auto> props = GeminiBodyShape::shapeToolParameters(schema).parameters.properties;
        assertEq("Currency, one of EUR or USD (default EUR)", props.currency.description);
        assertEq("Three letters matching ^[A-Z]{3}$", props.code.description);
        assertEq("Due date in date-time format", props.due.description);
        assertEq("range: 1 to 9 units", props.count.description);
        assertEq("y or n\nAllowed values: y, n", props.flag.description,
            "one-character values are never taken as already stated");
        assertEq("fast or medium\nAllowed values: fast, slow", props.mode.description,
            "values are stated unless the description names all of them");
    }

    constraintNoteRoundTrip() {
        hash<auto> args = {"currency": "USD", "quantity": 4, "ratio": 2.5, "score": 3, "due": "2026-10-09T00:00:00Z",
            "company": "ACME", "tags": ("a", "b"), "labels_closed": {}, "odd": "a, b", "level": "high"};
        assertEq((), GeminiBodyShape::shapeToolParameters(Constrained).stringified);
        assertEq(args, callTool("constrained", Constrained, args));
        assertEq(Constrained, Constrained + {}, "the caller's schema is not changed");
    }

    summaryMembers() {
        # typical shapes sent as JSON text: beyond the depth limit, a free-form map, a type alternative
        hash<auto> leaf = {
            "type": "object",
            "properties": {
                "invoice": {
                    "type": "object",
                    "properties": {
                        "number": {"type": "string"},
                        "issued": {"type": "string", "format": "date"},
                        "total": {"type": "number"},
                        "status": {"type": "string", "enum": ("draft", "sent", "paid")},
                        "lines": {"type": "array", "items": {"$ref": "#/$defs/Line"}},
                        "note": {"type": ("string", "null")},
                    },
                    "required": ("number", "total", "lines"),
                },
                "options": {"type": "array", "items": PresentChoices.properties.options.items},
            },
            "required": ("invoice", "options"),
        };
        hash<auto> schema = {
            "type": "object",
            "$defs": {"Line": {"type": "object", "properties": {"sku": {"type": "string"},
                "quantity": {"type": "integer"}, "tags": {"type": "array", "items": {"type": "string"}}},
                "required": ("sku", "quantity")}},
            "properties": {"a": {"type": "object", "properties": {"b": {"type": "object", "properties": {
                "c": {"type": "object", "properties": {"d": {"type": "object", "properties": {
                    "e": leaf}}}}}}}},
                "attributes": {"type": "object", "additionalProperties": {"type": "integer"}},
                "amount": {"type": ("number", "string")},
            },
        };
        hash<GeminiToolParameterSchema> shaped = GeminiBodyShape::shapeToolParameters(schema);
        assertEq((("a", "b", "c", "d", "e"), ("attributes",), ("amount",)), shaped.stringified);
        string e = shaped.parameters.properties.a.properties.b.properties.c.properties.d.properties.e.description;
        assertEq("This value is a string holding JSON text (not an object or list) in this shape (* marks a required "
            "member): {invoice*: {number*: string, total*: number, lines*: [{sku*: string, quantity*: integer, "
            "tags: [string]}], issued: string<date>, status: \"draft\"|\"sent\"|\"paid\", note: string | null}, "
            "options*: [{label*: string, value*: string, description: string}]}", e);
        assertTrue(shaped.parameters.properties.attributes.description =~ /: \{\[key\]: integer\}$/);
        assertTrue(shaped.parameters.properties.amount.description =~ /: number \| string$/);

        # the model fills the value from the summary; the caller gets the declared structure back
        hash<auto> args = {"a": {"b": {"c": {"d": {"e": {
            "invoice": {"number": "INV-7", "total": 12.5, "lines": ({"sku": "A-1", "quantity": 2},)},
            "options": ({"label": "Pay", "value": "pay"},),
        }}}}}, "attributes": {"priority": 2}, "amount": 12.5};
        CaptureToolRest rest(functionCallResponse("bill", GeminiBodyShape::encodeToolArguments(args,
            shaped.stringified)));
        hash<QoreLlmUtils::ChatResponse> rv = makeProvider("vertex", rest).chat(
            (<QoreLlmUtils::ChatMessage>{"role": "user", "content": "bill"},),
            (<QoreLlmUtils::ToolDefinition>{"name": "bill", "parameters": schema},));
        assertEq(args, rv.tool_calls[0].arguments);
    }

    summaryBound() {
        # 120 members, 4 required (declared last), each an object with nested members, beyond the depth limit
        hash<auto> wide = {"type": "object", "properties": {}, "required": ()};
        for (int i = 0; i < 120; ++i) {
            wide.properties{sprintf("member_%03d", i)} = {"type": "object", "properties": {
                "code": {"type": "string"}, "detail": {"type": "object", "properties": {
                    "text": {"type": "string"}, "count": {"type": "integer"}}}}};
        }
        wide.required = ("member_119", "member_118", "member_117", "member_116");
        hash<auto> schema = {"type": "object", "properties": {"l2": {"type": "object", "properties": {
            "l3": {"type": "object", "properties": {"l4": {"type": "object", "properties": {
                "l5": {"type": "object", "properties": {"wide": wide}}}}}}}}}};
        hash<GeminiToolParameterSchema> shaped = GeminiBodyShape::shapeToolParameters(schema);
        string desc = shaped.parameters.properties.l2.properties.l3.properties.l4.properties.l5.properties.wide
            .description;
        string summary = desc.substr(desc.find("member): ") + 9);
        assertTrue(summary.length() <= GeminiBodyShape::SchemaSummaryMaxChars, sprintf("%d", summary.length()));
        assertTrue(summary.length() > GeminiBodyShape::SchemaSummaryMaxChars - 40, "the bound is used");
        assertRegex("^\\{member_119\\*: \\{…\\}, member_118\\*: \\{…\\}, member_117\\*: \\{…\\}, "
            "member_116\\*: \\{…\\}, member_000: \\{…\\}, .*, …\\}$", summary,
            "required members come first; members that do not fit are replaced by …");
        assertEq(desc, GeminiBodyShape::shapeToolParameters(schema).parameters.properties.l2.properties.l3
            .properties.l4.properties.l5.properties.wide.description, "the summary is deterministic");

        # a shape that fits at a shallower level keeps every member and shortens only the deep levels
        hash<auto> medium = {"type": "object", "properties": {}};
        for (int i = 0; i < 30; ++i) {
            medium.properties{sprintf("field_%02d", i)} = {"type": "object", "properties": {
                "value": {"type": "string"}, "unit": {"type": "string"}}};
        }
        string m = GeminiBodyShape::shapeToolParameters({"type": "object", "properties": {"m": medium + {
            "additionalProperties": True, "properties": {}}}}).parameters.properties.m.description;
        assertTrue(m =~ /: object$/, "a free-form object without members is summarized as object");
        hash<auto> deep_medium = {"type": "object", "properties": {"a": {"type": "object", "properties": {
            "b": {"type": "object", "properties": {"c": {"type": "object", "properties": {
                "d": {"type": "object", "properties": {"medium": medium}}}}}}}}}};
        string dm = GeminiBodyShape::shapeToolParameters(deep_medium).parameters.properties.a.properties.b
            .properties.c.properties.d.properties.medium.description;
        string dms = dm.substr(dm.find("member): ") + 9);
        assertTrue(dms.length() <= GeminiBodyShape::SchemaSummaryMaxChars);
        assertEq(30, (dms =~ x/(field_[0-9]+: \{…\})/g).size(), "every member is kept, its detail is shortened");
        assertFalse(dms =~ /, …\}$/, "no member is cut");
    }

    #! the error response that Vertex AI returned for a real Qorus tool set in unrestricted any-tool mode
    const BudgetErrorBody = {"error": {"code": 400, "message": "Request contains an invalid argument.",
        "status": "INVALID_ARGUMENT"}};

    #! a synthetic stress catalog
    private list<hash<QoreLlmUtils::ToolDefinition>> stressTools() {
        list<hash<QoreLlmUtils::ToolDefinition>> rv = ();
        foreach hash<auto> i in ({"present_choices": PresentChoices, "create_customer": CreateCustomer,
                "create_order": CreateOrder, "deep": DeepTree, "unsupported": Unsupported,
                "constrained": Constrained}.pairIterator()) {
            rv += <QoreLlmUtils::ToolDefinition>{"name": i.key, "description": "stress tool " + i.key,
                "parameters": i.value};
        }
        return rv;
    }

    private static hash<QoreLlmUtils::LlmRequestOptions> modeOpts(string mode, *list<string> allowed) {
        hash<auto!> calling = {"mode": mode};
        if (allowed) {
            calling.allowedFunctionNames = allowed;
        }
        return <QoreLlmUtils::LlmRequestOptions>{"body_options": {"toolConfig": {"functionCallingConfig": calling}}};
    }

    #! Returns the exception raised by a chat call that answers with the given error
    private hash<ExceptionInfo> chatError(string mode, int status_code, hash<auto> error_body,
            *list<hash<QoreLlmUtils::ToolDefinition>> tools, *hash<QoreLlmUtils::LlmRequestOptions> opts,
            reference<list<hash<auto>>> sent) {
        ErrorToolRest rest(status_code, error_body);
        try {
            makeProvider(mode, rest).chat((<QoreLlmUtils::ChatMessage>{"role": "user", "content": "go"},), tools,
                opts);
        } catch (hash<ExceptionInfo> ex) {
            sent = rest.bodies;
            return ex;
        }
        throw "TEST-ERROR", "the chat call did not fail";
    }

    tooComplex() {
        foreach string mode in (("gemini", "vertex")) {
            list<hash<auto>> sent;
            hash<ExceptionInfo> ex = chatError(mode, 400, BudgetErrorBody, stressTools(), modeOpts("ANY"), \sent);
            assertEq(GeminiBodyShape::ToolSchemaTooComplexError, ex.err, mode);
            assertEq("GEMINI-TOOL-SCHEMA-TOO-COMPLEX", ex.err);
            assertEq(<GeminiToolSchemaTooComplexInfo>{
                "tool_count": 6,
                "declaration_bytes": make_json(sent[0].tools).size(),
                "function_calling_mode": "ANY",
                "provider_status": "INVALID_ARGUMENT",
                "provider_message": "Request contains an invalid argument.",
                "status_code": 400,
            }, ex.arg, mode);
            assertRegex("6 tool declarations \\([0-9]+ bytes\\).*constrained-decoding budget.*unrestricted "
                "any-tool mode.*tiered or two-phase tool catalog.*allowedFunctionNames", ex.desc, mode);
            assertEq(1, sent.size(), "a rejected request is not retried");
        }
        # a message that names the cause is recognized in any mode
        list<hash<auto>> sent;
        hash<ExceptionInfo> ex = chatError("vertex", 400, {"error": {"code": 400, "status": "INVALID_ARGUMENT",
            "message": "The specified schema produces a constraint that has too many states for serving."}},
            stressTools(), modeOpts("AUTO"), \sent);
        assertEq(GeminiBodyShape::ToolSchemaTooComplexError, ex.err);
        assertEq("AUTO", ex.arg.function_calling_mode);
    }

    tooComplexNot() {
        list<hash<auto>> sent;
        hash<string, list<auto>> cases = {
            "a request without tools": ("ANY", 400, BudgetErrorBody, NOTHING),
            "AUTO mode": ("AUTO", 400, BudgetErrorBody, stressTools()),
            "no tool config (AUTO)": (NOTHING, 400, BudgetErrorBody, stressTools()),
            "ANY restricted with allowedFunctionNames": ("ANY:deep", 400, BudgetErrorBody, stressTools()),
            "a 400 naming the invalid field": ("ANY", 400, {"error": {"code": 400, "status": "INVALID_ARGUMENT",
                "message": "Invalid JSON payload received. Unknown name \"foo\" at 'tools[0]': Cannot find field."}},
                stressTools()),
            "a 400 with details": ("ANY", 400, BudgetErrorBody + {"error": BudgetErrorBody.error + {"details": (
                {"@type": "type.googleapis.com/google.rpc.BadRequest"},)}}, stressTools()),
            "another status": ("ANY", 400, {"error": {"code": 400, "status": "FAILED_PRECONDITION",
                "message": "Request contains an invalid argument."}}, stressTools()),
            "a 500": ("ANY", 500, {"error": {"code": 500, "status": "INTERNAL",
                "message": "Request contains an invalid argument."}}, stressTools()),
        };
        foreach hash<auto> i in (cases.pairIterator()) {
            *string mode = i.value[0];
            *hash<QoreLlmUtils::LlmRequestOptions> opts;
            if (mode) {
                list<string> parts = mode.split(":");
                opts = modeOpts(parts[0], parts[1] ? (parts[1],) : NOTHING);
            }
            hash<ExceptionInfo> ex = chatError("gemini", i.value[1], i.value[2], i.value[3], opts, \sent);
            assertEq("LLM-ERROR", ex.err, i.key);
            assertEq("REST-RESPONSE-ERROR", ex.arg.err, i.key + ": the REST error is kept");
            assertTrue(ex.desc.find(i.value[2].error.message) > 0, i.key + ": the provider message is reported");
        }
    }

    tooComplexStream() {
        Logger logger("test", LoggerLevel::getLevelWarn());
        HttpServer http(<HttpServerOptionInfo>{"logger": logger, "debug": False});
        on_exit delete http;
        int port = http.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        FakeGeminiStreamHandler handler(());
        handler.error_body = BudgetErrorBody;
        http.setHandler("gemini", "/", MimeTypeJson, handler);
        QoreLlmUtils::LlmBackend llm(<QoreLlmUtils::LlmBackendConfig>{
            "mode": "gemini", "url": "http://localhost:" + port, "model": "gemini-2.5-flash",
            "api_key": "test-only-key", "max_retries": 0,
        });
        code stream = sub (*hash<QoreLlmUtils::LlmRequestOptions> opts) {
            llm.chatStreamCollect((<QoreLlmUtils::ChatMessage>{"role": "user", "content": "go"},),
                sub (hash<QoreLlmUtils::ChatStreamEvent> event) {}, stressTools(), opts);
        };
        try {
            stream(modeOpts("ANY"));
            assertTrue(False, "the stream must fail");
        } catch (hash<ExceptionInfo> ex) {
            assertEq(GeminiBodyShape::ToolSchemaTooComplexError, ex.err);
            assertEq(6, ex.arg.tool_count);
        }
        assertThrows("LLM-ERROR", stream, (modeOpts("AUTO"),));
    }

    #! Returns the parameters of a tool as the provider sends them
    private hash<auto> declaredParameters(string name, hash<auto> schema) {
        CaptureToolRest rest(functionCallResponse(name, {}));
        makeProvider("gemini", rest).chat((<QoreLlmUtils::ChatMessage>{"role": "user", "content": "go"},),
            (<QoreLlmUtils::ToolDefinition>{"name": name, "parameters": schema},));
        return rest.bodies[0].tools[0].functionDeclarations[0].parameters;
    }

    #! Calls a tool through the provider with a response carrying the given wire arguments
    private hash<auto> callTool(string name, hash<auto> schema, hash<auto> wire_args) {
        CaptureToolRest rest(functionCallResponse(name, wire_args));
        hash<QoreLlmUtils::ChatResponse> rv = makeProvider("gemini", rest).chat(
            (<QoreLlmUtils::ChatMessage>{"role": "user", "content": "go"},),
            (<QoreLlmUtils::ToolDefinition>{"name": name, "parameters": schema},));
        assertEq(wire_args, rv.raw.candidates[0].content.parts[0].functionCall.args, "raw keeps the wire form");
        return rv.tool_calls[0].arguments;
    }

    private GeminiBodyShape::AbstractGeminiModelProvider makeProvider(string mode, CaptureToolRest rest) {
        hash<QoreLlmUtils::LlmBackendConfig> config = <QoreLlmUtils::LlmBackendConfig>{
            "model": "gemini-2.5-flash", "api_key": "test-only-key", "max_retries": 0,
            "provider_options": {"gcp_project_id": "test-project"},
        };
        return mode == "gemini"
            ? new CaptureToolGeminiProvider(config, rest)
            : new CaptureToolVertexProvider(config, rest);
    }

    private static hash<auto> functionCallResponse(string name, hash<auto> args) {
        return {
            "candidates": ({
                "content": {"parts": ({"functionCall": {"name": name, "args": args}},)},
                "finishReason": "STOP",
            },),
        };
    }

    #! Returns the member paths of a schema that the provider form neither declares nor describes as JSON text
    private list<string> lostMembers(hash<auto> original, hash<auto> provider_form) {
        return lostMembersIntern(original, original, provider_form, "", {});
    }

    private list<string> lostMembersIntern(hash<auto> root, hash<auto> original, *hash<auto> provider_form,
            string path, hash<string, bool> seen) {
        if (original."$ref".typeCode() == NT_STRING) {
            if (seen{original."$ref"}) {
                return ();
            }
            seen{original."$ref"} = True;
            original = resolve(root, original."$ref") + (original - "$ref");
        }
        list<string> rv = ();
        hash<auto> members = original.properties.typeCode() == NT_HASH ? original.properties : {};
        foreach string key in (("anyOf", "oneOf", "allOf")) {
            foreach auto variant in (original{key}) {
                if (variant.properties.typeCode() == NT_HASH) {
                    members += variant.properties;
                }
            }
        }
        foreach hash<auto> member in (members.pairIterator()) {
            string member_path = path + "." + member.key;
            auto provided = provider_form.properties{member.key};
            if (provided.typeCode() != NT_HASH) {
                rv += member_path;
                continue;
            }
            if (provided.type == "string" && provided.description =~ /holding JSON text/) {
                # the value is JSON text described by the whole original schema
                continue;
            }
            if (member.value.typeCode() == NT_HASH) {
                rv += lostMembersIntern(root, member.value, provided, member_path, seen);
            }
        }
        if (original.items.typeCode() == NT_HASH) {
            auto provided = provider_form.items;
            if (provided.typeCode() != NT_HASH) {
                rv += path + "[]";
            } else if (provided.type != "string" || provided.description !~ /holding JSON text/) {
                rv += lostMembersIntern(root, original.items, provided, path + "[]", seen);
            }
        }
        return rv;
    }

    private static hash<auto> resolve(hash<auto> root, string ref) {
        auto cur = root;
        foreach string seg in (ref.substr(2).split("/")) {
            cur = cur{seg};
        }
        return cur ?? {};
    }
}
