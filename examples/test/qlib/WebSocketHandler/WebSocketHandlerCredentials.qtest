#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - HTTP/1.1 WebSocket upgrade over a TCP socket of the HTTP server
# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires HttpServer
%requires HttpServerUtil
%requires WebSocketHandler

%exec-class WebSocketHandlerCredentialsTest

#! The connection of a WebSocket handler of restricted code gets the upgrade request without its credentials (qore#7303)
/** The HTTP server starts the connection of a WebSocket handler with the request of its upgrade
    (WebSocketHandler::getConnectionImpl()); a handler of restricted code gets it without the credentials of the
    request, as its other methods that the server calls do, and a trusted handler gets it as before
*/

#! a hang guard only, never a timing assertion
const HangGuard = 20s;

class WebSocketHandlerCredentialsTest inherits QUnit::Test {
    public {
        #! the tenant's handler: records what its connection's setup saw of the credentials of the request
        const TenantSource = "%modern
%requires WebSocketHandler
class TenantWsHandler inherits WebSocketHandler {
    private { Queue seen; }
    constructor(Queue seen) {
        self.seen = seen;
    }
    WebSocketConnection getConnectionImpl(hash<auto> cx, hash<auto> hdr, string cid) {
        seen.push(sprintf(\"authorization=%y cookie=%y cx.auth=%y cx.hdr.authorization=%y\", exists hdr.authorization,
            exists hdr.cookie, exists cx.auth, exists cx.hdr.authorization));
        return new WebSocketConnection(self);
    }
}
WebSocketHandler sub get_handler(Queue seen) {
    return new TenantWsHandler(seen);
}
";

        #! what a handler gets without the credentials of the request
        const Filtered = "authorization=False cookie=False cx.auth=False cx.hdr.authorization=False";
    }

    constructor() : Test("WebSocketHandlerCredentialsTest", "1.0", \ARGV) {
        addTestCase("the connection of a WebSocket handler of restricted code", \restrictedTest());
        addTestCase("the connection of a trusted WebSocket handler", \trustedTest());
        set_return_value(main());
    }

    #! returns the tenant's Program with the given sandbox
    private Program getTenant(*SandboxManager sm) {
        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        if (sm) {
            p.setSandboxManager(sm);
        }
        p.parse(TenantSource, "tenant");
        return p;
    }

    #! upgrades a connection with credentials to the handler; returns what the handler's connection saw
    private *string upgrade(Program p) {
        Queue seen();
        WebSocketHandler handler = p.callFunction("get_handler", seen);
        HttpServer server(<HttpServerOptionInfo>{});
        on_exit server.stop();
        server.setDefaultHandler("ws", handler);
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        server.waitForAsyncIo();
        Socket c();
        c.connect("127.0.0.1:" + port, HangGuard);
        on_exit c.close();
        c.send("GET /ws HTTP/1.1\r\nHost: localhost\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
            "Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n"
            "Authorization: Bearer secret\r\nCookie: session=secret\r\n\r\n");
        hash<auto> h = c.readHTTPHeader(HangGuard);
        assertEq(101, h.status_code, "the connection is upgraded");
        return seen.get(HangGuard);
    }

    restrictedTest() {
        # the default sandbox does not trust its code
        assertEq(Filtered, upgrade(getTenant(new SandboxManager())));
    }

    trustedTest() {
        assertEq("authorization=True cookie=True cx.auth=True cx.hdr.authorization=True", upgrade(getTenant()));
    }
}
