#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-exec-mode: children - the server runs in a child process of the qore binary started without an execution mode
# test-platform: macos - the end of a process whose WebSocket connection is open, and the async I/O controller's sockets

/*
    Copyright (C) 2026 Qore Technologies, s.r.o., all rights reserved

    Permission is hereby granted, free of charge, to any person obtaining a
    copy of this software and associated documentation files (the "Software"),
    to deal in the Software without restriction, including without limitation
    the rights to use, copy, modify, merge, publish, distribute, sublicense,
    and/or sell copies of the Software, and to permit persons to whom the
    Software is furnished to do so, subject to the following conditions:

    The above copyright notice and this permission notice shall be included in
    all copies or substantial portions of the Software.

    THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
    IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
    FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
    AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
    LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
    FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
    DEALINGS IN THE SOFTWARE.

    Regression test for qore#5752: the main program of a server returns while the WebSocket connection of a client is
    open, as qdbg-server's does when the program that it debugs ends (VscDebugAdapter.qtest).  No thread waits for an
    asynchronous WebSocket connection since qore#5752, so nothing kept the Program from ending and being deleted while
    the connection was open; the end of the connection then never ran, and the server, kept by the objects that the
    connection's close callbacks release, kept the process from ending.  The Program now waits for the connection: the
    server serves it until the client closes it, runs its close callback and ends; and a server that the program
    releases closes the connection itself.
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires WebSocketClient

%try-module process >= 2.2
%define NoProcess
%endtry

%exec-class WebSocketProgramEndTest

#! Upper bound for any wait that a regression turns into a hang
const HangTimeout = 30s;

class WebSocketProgramEndTest inherits QUnit::Test {
    constructor() : Test("WebSocketProgramEndTest", "1.0") {
        addTestCase("a program that returns with an open WebSocket connection serves it until the client closes it",
            \clientClosesTest());
        addTestCase("a program that releases its server with an open WebSocket connection ends", \releaseTest());
        set_return_value(main());
    }

%ifdef NoProcess
    clientClosesTest() {
        testSkip("no process module 2.2 or later");
    }

    releaseTest() {
        testSkip("no process module 2.2 or later");
    }
%else
    #! The server's main program returns while the connection is open; the client closes it afterwards
    clientClosesTest() {
        ServerProcess server();
        on_exit server.stop();
        Queue echoes();
        WebSocketClient ws(sub (*data msg) {
            if (exists msg) {
                echoes.push(msg);
            }
        }, {"url": sprintf("ws://127.0.0.1:%d", server.port)});
        ws.connect();
        ws.send("before");
        assertEq("before", echoes.get(HangTimeout));

        server.endMain();
        # the server still serves the connection
        ws.send("after");
        assertEq("after", echoes.get(HangTimeout), "the server serves the connection at the end of its main program");
        assertEq(("port", "main returned"), server.lines(), "nothing has ended but the main program");

        ws.disconnect();
        assertTrue(server.wait(), "the server ends once the client has closed the connection");
        assertEq(0, server.exitCode());
        assertEq(("port", "main returned", "connection closed", "server destroyed"), server.lines(),
            "the connection's close callback runs, and then the server is destroyed");
    }

    #! The server's main program releases the server while the connection is open
    releaseTest() {
        ServerProcess server("release");
        on_exit server.stop();
        Queue echoes();
        WebSocketClient ws(sub (*data msg) {
            if (exists msg) {
                echoes.push(msg);
            }
        }, {"url": sprintf("ws://127.0.0.1:%d", server.port)});
        on_exit ws.disconnect();
        ws.connect();
        ws.send("before");
        assertEq("before", echoes.get(HangTimeout));

        server.endMain();
        assertTrue(server.wait(), "the server ends with the connection open");
        assertEq(0, server.exitCode());
        # the release destroys the server at once, and its stop waits for the end of the connection that it closes
        assertEq(("port", "server destroyed", "connection closed", "main returned"), server.lines(),
            "the server is destroyed, and its stop closes the connection, whose close callback runs");
    }
%endif
}

%ifndef NoProcess
#! The server process (ws-program-end-server.q)
class ServerProcess {
    public {
        int port;
    }

    private {
        Process proc;
        #! the output read so far
        string out = "";
    }

    constructor(*string mode) {
        string script = get_script_dir() + "/ws-program-end-server.q";
        proc = new Process(executablePath(ENV.QORE_EXECUTABLE ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore"),
            (script,) + (mode ? (mode,) : ()), {"env": Process::getEnvironment()});
        readUntil("\n");
        port = (out =~ x/port ([0-9]+)/)[0].toInt();
    }

    #! Tells the server's main program to return, and waits until it has
    endMain() {
        proc.write("\n");
        readUntil("main returned\n");
    }

    #! Waits for the process to end and reads the rest of its output; returns False if it did not end in time
    bool wait() {
        if (!proc.wait(HangTimeout)) {
            return False;
        }
        while (*string s = proc.readStdout(1024, 0)) {
            out += s;
        }
        return True;
    }

    int exitCode() {
        return proc.exitCode();
    }

    #! The lines of output, without the port number
    list<string> lines() {
        return map ($1 =~ /^port /) ? "port" : $1, (select out.split("\n"), $1);
    }

    #! Ends the process if it is still running
    stop() {
        if (proc.running()) {
            proc.terminate();
        }
    }

    private readUntil(string end) {
        while (out.find(end) < 0) {
            *string s = proc.readStdout(1024, HangTimeout);
            if (!exists s) {
                throw "TEST-ERROR", sprintf("the server did not write %y: %y", end, out);
            }
            out += s;
        }
    }

    #! Returns the absolute path of the given Qore executable (see VscDebugAdapter.qtest)
    private static string executablePath(string name) {
        if (name.regex("/")) {
            return realpath(name);
        }
        foreach string dir in (split(":", ENV.PATH ?? "")) {
            string path = (dir ? dir : ".") + "/" + name;
            if (is_executable(path)) {
                return realpath(path);
            }
        }
        throw "TEST-SETUP-ERROR", sprintf("cannot locate Qore executable %y", name);
    }
}
%endif
