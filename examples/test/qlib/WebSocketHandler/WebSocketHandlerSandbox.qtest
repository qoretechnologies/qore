%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires Util

%exec-class WebSocketHandlerSandboxTest

public class WebSocketHandlerSandboxTest inherits QUnit::Test {
    constructor() : QUnit::Test("WebSocketHandlerSandboxTest", "1.0", \ARGV) {
        addTestCase("a handler is constructed in a program without filesystem access", \testConstruct());
        addTestCase("a handler is constructed in an unrestricted program", \testUnrestricted());
        set_return_value(main());
    }

    #! returns a program with a WebSocketHandler subclass; the module path of this program applies to the modules
    private Program makeProgram(bool sandboxed) {
        Program p(PO_NEW_STYLE);
        if (sandboxed) {
            SandboxManager sm();
            sm.setFilesystemDefaultPolicy(False);
            p.setSandboxManager(sm);
        }
        p.parse("
%requires HttpServer
%requires WebSocketHandler

class SandboxWsConnection inherits WebSocketConnection {
    constructor(WebSocketHandler handler) : WebSocketConnection(handler) {
    }

    gotMessage(string msg) {
    }

    gotMessage(binary msg) {
    }
}

class SandboxWsHandler inherits WebSocketHandler {
    constructor() : WebSocketHandler() {
    }

    WebSocketConnection getConnectionImpl(hash<auto> cx, hash<auto> hdr, string cid, *hash<auto> conn) {
        return new SandboxWsConnection(self);
    }
}

bool sub construct() {
    SandboxWsHandler handler();
    return handler instanceof WebSocketHandler;
}

sub open_urandom() {
    ReadOnlyFile f(\"/dev/urandom\");
}
", "websocket-handler-sandbox");
        return p;
    }

    testConstruct() {
        Program p = makeProgram(True);
        # the sandbox denies the file that get_random_string() used to read
        assertThrows("FILESYSTEM-ACCESS-DENIED", \p.callFunction(), "open_urandom");
        assertTrue(p.callFunction("construct"), "the handler is constructed in the sandboxed program");
    }

    testUnrestricted() {
        Program p = makeProgram(False);
        assertTrue(p.callFunction("construct"), "the handler is constructed in an unrestricted program");
    }
}
