HKxBldRZ0sw2gJLAE6UKH/qDNmp+2qWEdrDE8YcAeCQxo6rk+Ns5qqsvmn2SR14Y
mvtgHHS1D+9lsqea5jUTSXrc0wKBgQDWVAwsZOtah2CHvsonqOyQXotnRtBool0u
6rtGrRXoDFvwrjRsicBv6L1kf/npD+QhkaRe3ZkOBZxPsjv9Kfc974czLBAf1zeD
rW931aSp1YiHyBo8+PmjTvbbiOK7K/8n79CN8W+zwr9plaU+HE1nLwwp/UmaCYtM
fArq1jHbcQKBgFWnUVkSdHk5zsX67iaga38PfInTnAIm2ekMCjkzBWDIwEwnT8bD
ESe7Q5+sFdJIU3YYRJylMcoo+PIrW80VyJdYgDVAQTSac1TgWlwjnX5gWcRoacG1
EVkyRhmmx8oMQu4+r3nj1PQRwYCwwBfnRHnjtOKXVYJpVBalFpJFgoT5AoGAGTUx
aVdFRxR9CfoqlJeNmz1DcBYoFOZjx0zcUeexl+U8OwaCK/HXrFHXVKaoofy4fCpB
BtdRVRDb3ZO88n2pEqPFZwNbsiMB6H7RiWqbP05aDH5Ad8NguRBkgFWNNS5riCrw
gIFQ/fd9w9FR6ggyIlyqNZYQvgk5VPmR3yTqIEECgYEA0akqJwH4M2aQb3mP6FGX
MbQ5aconCeXHrT2u80LEhF4KzwQz8k8XX2K2XRZ+4LgWq3tOfeVnkEivkJBzFEao
/g5l2ZjftRO2yAdYhP4Sbcws88pP+cr64tWDI6qK6tlGXI93EyfCVT1FSX5CC1aq
Do+Sl1gfqlpgpszQaOMjR4M=
-----END PRIVATE KEY-----";    }

    constructor() : Test("WebSocketH2SendOrderTest", "1.0") {
        addTestCase("WS-over-H2 replies keep their order across the direct-send transition",
            \testSendOrderAcrossDirectSendTransition());
        set_return_value(main());
    }

    globalSetUp() {
        mLogger = new Logger("ws-h2-order-test", m_options.verbose > 2
            ? LoggerLevel::getLevelInfo()
            : LoggerLevel::getLevelWarn());
        mLogger.addAppender(new StdoutAppender());

        mWsHandler = new OrderEchoWsHandler({"logger": mLogger});
        mServer = new HttpServer(<HttpServerOptionInfo>{"logger": mLogger, "debug": True});
        mServer.setHandler("ws-handler", "/ws", NOTHING, mWsHandler);
        mPort = mServer.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        }).port;
        mWsUrl = "wss://localhost:" + mPort + "/ws";
        mServer.waitForAsyncIo();
        if (m_options.verbose > 1) {
            printf("WS/H2 send-order test server on port %d\n", mPort);
        }
    }

    globalTearDown() {
        delete mServer;
    }

    #! frames buffered before the transport is registered must not be overtaken
    /** @ref registered() runs before the async transport is registered, so every frame it
        sends is queued on the connection's Channel; the handler thread flushes that queue
        when it enables direct sends.  @ref GreetingCount frames make that flush take
        appreciably longer than the round trip of @ref DirectMessage, which the test sends
        as soon as @ref registered() has returned — so the reply to it is dispatched to
        @c gotMessage() on an I/O worker thread while the flush is still running.

        Without the connection's outbound ordering point that reply is written straight to
        the HTTP/2 stream while the earlier frames are still queued, and the client sees
        "ECHO:ping" ahead of frames that were sent before it — a WebSocket protocol
        violation.  With it, the reply blocks until the flush has finished and arrives last.
    */
    testSendOrderAcrossDirectSendTransition() {
        # each frame is labeled and then padded; only the labels are compared so a failure
        # reports the order rather than the padding
        list<string> labels();
        for (int i = 0; i < GreetingCount; ++i) {
            labels += sprintf("greeting-%03d", i);
        }
        ws_greetings = map $1 + "|" + strmul("x", GreetingSize), labels;
        ws_registered = new Counter(1);

        list<string> received();
        Mutex recv_lock();
        Counter recv_done(GreetingCount + 1);

        WebSocketClient wsc(sub (*data msg) {
            if (!exists msg) {
                return;
            }
            {
                AutoLock al(recv_lock);
                received += (msg.toString().split("|"))[0];
            }
            recv_done.dec();
        }, {
            "url": mWsUrl,
            "logger": mLogger,
            "http_version": "2.0",
            "ssl_verify_cert": False,
            "timeout": 30000,
        });
        on_exit delete wsc;

        wsc.connect();

        # registered() has returned, so the greetings are queued on the connection's
        # Channel and the handler thread is about to enable direct sends
        ws_registered.waitForZero(30s);

        # this message is dispatched to gotMessage() on an I/O worker while the handler
        # thread sits in the enableDirectSend() window, so its reply takes the direct
        # transport path while the greetings are still buffered
        wsc.send(DirectMessage);

        recv_done.waitForZero(30s);
        wsc.disconnect();

        list<string> expected = labels + ("ECHO:" + DirectMessage,);
        assertEq(expected, received, "WebSocket frames keep their send order across the "
            "direct-send transition");
    }
}
