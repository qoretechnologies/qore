    FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
    DEALINGS IN THE SOFTWARE.

    WebSocket-over-HTTP/2 (RFC 8441) server send-ordering regression test.

    WebSocket requires that messages sent on a connection reach the peer in the
    order they were sent.  A WebSocketConnection has two outbound paths — the
    Channel buffer used before the async transport is registered, and the direct
    stream-context write used after — and messages answered from gotMessage()
    during the registration window take the first while later messages take the
    second.  Without a single ordering point across that transition, a reply sent
    after the transition can be written to the wire ahead of an earlier reply still
    buffered on the Channel, which the peer sees as reordered messages.
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Mime
%requires Logger
%requires HttpServerUtil
%requires HttpServerAsyncIo
%requires HttpServer
%requires WebSocketUtil
%requires WebSocketHandler
%requires WebSocketClient
%requires ../../TestCertificates.qm

%exec-class WebSocketH2SendOrderTest

#! Messages the connection sends from registered(); set by the test
our *list<string> ws_greetings;

#! Released once registered() has returned, i.e. once the greetings are buffered
our *Counter ws_registered;

#! Sends the greetings from registered() and echoes every client message back
class OrderEchoWsConnection inherits WebSocketConnection {
    constructor(WebSocketHandler handler) : WebSocketConnection(handler) {
    }

    #! Sends the greetings while the connection is still buffering outbound frames
    /** registered() runs before the async transport is registered, so
        direct_send_enabled is still False here and every frame sent is queued on the
        connection's Channel — that is what makes the buffered side of the race
        deterministic rather than timing-dependent.
    */
    registered() {
        map send($1), ws_greetings;
        if (ws_registered) {
            ws_registered.dec();
        }
    }

    gotMessage(string msg) {
        send("ECHO:" + msg);
    }
}

class OrderEchoWsHandler inherits WebSocketHandler {
    constructor(*hash<auto> opts) : WebSocketHandler(NOTHING, opts) {
    }

    WebSocketConnection getConnectionImpl(hash<auto> cx, hash<auto> hdr, string cid, *hash<auto> conn) {
        return new OrderEchoWsConnection(self);
    }
}

class WebSocketH2SendOrderTest inherits QUnit::Test {
    private {
        HttpServer mServer;
        OrderEchoWsHandler mWsHandler;
        Logger mLogger;
        int mPort;
        string mWsUrl;

        #! number of frames sent from registered(), i.e. while the connection still
        #! buffers output; each one is a separate transport write, so enough of them
        #! that flushing them all takes appreciably longer than the round trip of the
        #! client message sent once the flush has started
        const GreetingCount = 200;

        #! payload size of each buffered frame; the window is widened by the frame
        #! count (one transport write each), not by the byte count, so the payload is
        #! kept small to keep the test fast
        const GreetingSize = 200;

        #! client message whose reply takes the direct transport path; it must not
        #! overtake the buffered frames
        const DirectMessage = "ping";

        const CertPem = TestCertificates::CertPem;

        const KeyPem = TestCertificates::KeyPem;    }

    constructor() : Test("WebSocketH2SendOrderTest", "1.0") {
        addTestCase("WS-over-H2 replies keep their order across the direct-send transition",
            \testSendOrderAcrossDirectSendTransition());
        set_return_value(main());
    }

    globalSetUp() {
        mLogger = new Logger("ws-h2-order-test", m_options.verbose > 2
            ? LoggerLevel::getLevelInfo()
            : LoggerLevel::getLevelWarn());
        mLogger.addAppender(new StdoutAppender());

        mWsHandler = new OrderEchoWsHandler({"logger": mLogger});
        mServer = new HttpServer(<HttpServerOptionInfo>{"logger": mLogger, "debug": True});
        mServer.setHandler("ws-handler", "/ws", NOTHING, mWsHandler);
        mPort = mServer.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        }).port;
        mWsUrl = "wss://localhost:" + mPort + "/ws";
        mServer.waitForAsyncIo();
        if (m_options.verbose > 1) {
            printf("WS/H2 send-order test server on port %d\n", mPort);
        }
    }

    globalTearDown() {
        delete mServer;
    }

    #! frames buffered before the transport is registered must not be overtaken
    /** @ref registered() runs before the async transport is registered, so every frame it
        sends is queued on the connection's Channel; the handler thread flushes that queue
        when it enables direct sends.  @ref GreetingCount frames make that flush take
        appreciably longer than the round trip of @ref DirectMessage, which the test sends
        as soon as @ref registered() has returned — so the reply to it is dispatched to
        @c gotMessage() on an I/O worker thread while the flush is still running.

        Without the connection's outbound ordering point that reply is written straight to
        the HTTP/2 stream while the earlier frames are still queued, and the client sees
        "ECHO:ping" ahead of frames that were sent before it — a WebSocket protocol
        violation.  With it, the reply blocks until the flush has finished and arrives last.
    */
    testSendOrderAcrossDirectSendTransition() {
        # each frame is labeled and then padded; only the labels are compared so a failure
        # reports the order rather than the padding
        list<string> labels();
        for (int i = 0; i < GreetingCount; ++i) {
            labels += sprintf("greeting-%03d", i);
        }
        ws_greetings = map $1 + "|" + strmul("x", GreetingSize), labels;
        ws_registered = new Counter(1);

        list<string> received();
        Mutex recv_lock();
        Counter recv_done(GreetingCount + 1);

        WebSocketClient wsc(sub (*data msg) {
            if (!exists msg) {
                return;
            }
            {
                AutoLock al(recv_lock);
                received += (msg.toString().split("|"))[0];
            }
            recv_done.dec();
        }, {
            "url": mWsUrl,
            "logger": mLogger,
            "http_version": "2.0",
            "ssl_verify_cert": False,
            "timeout": 30000,
        });
        on_exit delete wsc;

        wsc.connect();

        # registered() has returned, so the greetings are queued on the connection's
        # Channel and the handler thread is about to enable direct sends
        ws_registered.waitForZero(30s);

        # this message is dispatched to gotMessage() on an I/O worker while the handler
        # thread sits in the enableDirectSend() window, so its reply takes the direct
        # transport path while the greetings are still buffered
        wsc.send(DirectMessage);

        recv_done.waitForZero(30s);
        wsc.disconnect();

        list<string> expected = labels + ("ECHO:" + DirectMessage,);
        assertEq(expected, received, "WebSocket frames keep their send order across the "
            "direct-send transition");
    }
}
