    WebSocket-over-HTTP/2 (RFC 8441) server send-ordering regression test.

    WebSocket requires that messages sent on a connection reach the peer in the
    order they were sent.  A WebSocketConnection has two outbound paths — the
    Channel buffer used before the async transport is registered, and the direct
    stream-context write used after — and messages answered from gotMessage()
    during the registration window take the first while later messages take the
    second.  Without a single ordering point across that transition, a reply sent
    after the transition can be written to the wire ahead of an earlier reply still
    buffered on the Channel, which the peer sees as reordered messages.
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Mime
%requires Logger
%requires HttpServerUtil
%requires HttpServerAsyncIo
%requires HttpServer
%requires WebSocketUtil
%requires WebSocketHandler
%requires WebSocketClient

%exec-class WebSocketH2SendOrderTest

#! Messages the connection sends from registered(); set by the test
our *list<string> ws_greetings;

#! Released once registered() has returned, i.e. once the greetings are buffered
our *Counter ws_registered;

#! Sends the greetings from registered() and echoes every client message back
class OrderEchoWsConnection inherits WebSocketConnection {
    constructor(WebSocketHandler handler) : WebSocketConnection(handler) {
    }

    #! Sends the greetings while the connection is still buffering outbound frames
    /** registered() runs before the async transport is registered, so
        direct_send_enabled is still False here and every frame sent is queued on the
        connection's Channel — that is what makes the buffered side of the race
        deterministic rather than timing-dependent.
    */
    registered() {
        map send($1), ws_greetings;
        if (ws_registered) {
            ws_registered.dec();
        }
    }

    gotMessage(string msg) {
        send("ECHO:" + msg);
    }
}

class OrderEchoWsHandler inherits WebSocketHandler {
    constructor(*hash<auto> opts) : WebSocketHandler(NOTHING, opts) {
    }

    WebSocketConnection getConnectionImpl(hash<auto> cx, hash<auto> hdr, string cid, *hash<auto> conn) {
        return new OrderEchoWsConnection(self);
    }
}

class WebSocketH2SendOrderTest inherits QUnit::Test {
    private {
        HttpServer mServer;
        OrderEchoWsHandler mWsHandler;
        Logger mLogger;
        int mPort;
        string mWsUrl;

        #! number of frames sent from registered(), i.e. while the connection still
        #! buffers output; each one is a separate transport write, so enough of them
        #! that flushing them all takes appreciably longer than the round trip of the
        #! client message sent once the flush has started
        const GreetingCount = 200;

        #! payload size of each buffered frame; the window is widened by the frame
        #! count (one transport write each), not by the byte count, so the payload is
        #! kept small to keep the test fast
        const GreetingSize = 200;

        #! client message whose reply takes the direct transport path; it must not
        #! overtake the buffered frames
        const DirectMessage = "ping";

        const CertPem = "-----BEGIN CERTIFICATE-----
MIIDCTCCAfGgAwIBAgIULwwY9Xmqwn7ZZIYgEu8otC1aRNMwDQYJKoZIhvcNAQEL
BQAwFDESMBAGA1UEAwwJbG9jYWxob3N0MB4XDTI1MTIzMTE4MjIyOVoXDTI2MTIz
MTE4MjIyOVowFDESMBAGA1UEAwwJbG9jYWxob3N0MIIBIjANBgkqhkiG9w0BAQEF
