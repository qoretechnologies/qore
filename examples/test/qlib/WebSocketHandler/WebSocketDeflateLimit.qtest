    Tests for permessage-deflate (RFC 7692) on the WebSocket server:
    - the server requires clients to compress each message on its own (client_no_context_takeover)
    - messages that end with a sync flush, as browsers send them, are decompressed
    - a message whose decompressed size exceeds the maximum message size closes the connection with 1009,
      over HTTP/1.1 and HTTP/2
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Mime
%requires Logger
%requires HttpServerUtil
%requires HttpServerAsyncIo
%requires HttpServer
%requires WebSocketUtil
%requires WebSocketHandler
%requires WebSocketClient

%exec-class WebSocketDeflateLimitTest

#! echoes each message back
class EchoWsConnection inherits WebSocketConnection {
    constructor(WebSocketHandler handler) : WebSocketConnection(handler) {
    }

    gotMessage(string msg) {
        send("ECHO:" + msg);
    }

    gotMessage(binary msg) {
        send(msg);
    }
}

#! a WebSocket handler with permessage-deflate that records its errors
class DeflateWsHandler inherits WebSocketHandler {
    public {
        Queue errs();
    }

    constructor(*hash<auto> opts) : WebSocketHandler(NOTHING, {"extensions": ("permessage-deflate",)} + opts) {
    }

    WebSocketConnection getConnectionImpl(hash<auto> cx, hash<auto> hdr, string cid) {
        return new EchoWsConnection(self);
    }

    logError(string fmt) {
        errs.push(vsprintf(fmt, argv));
        logArgs(LoggerLevel::ERROR, fmt, argv);
    }
}

class WebSocketDeflateLimitTest inherits QUnit::Test {
    private {
        # the maximum message size of the limited handler
        const MaxMessageSize = 64 * 1024;

        # messages as a browser sends them with client_no_context_takeover: each is compressed on its own and ends
        # with a sync flush whose trailing 0x00 0x00 0xff 0xff is removed (RFC 7692 section 7.2.1)
