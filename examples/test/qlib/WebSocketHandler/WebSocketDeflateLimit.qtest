Do+Sl1gfqlpgpszQaOMjR4M=
-----END PRIVATE KEY-----";
    }

    private {
        Logger logger;
        HttpServer server;
        int port;
        int tls_port;
        DeflateWsHandler limited;
        DeflateWsHandler unlimited;
    }

    constructor() : Test("WebSocketDeflateLimitTest", "1.0") {
        addTestCase("negotiation", \negotiationTest());
        addTestCase("messages ending with a sync flush", \syncFlushTest());
        addTestCase("maximum message size over HTTP/1.1", \http1LimitTest());
        addTestCase("default maximum decompressed message size", \defaultLimitTest());
        addTestCase("maximum message size over HTTP/2", \http2LimitTest());
        set_return_value(main());
    }

    globalSetUp() {
        logger = new Logger("ws-deflate-limit-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }
        server = new HttpServer(<HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        });
        limited = new DeflateWsHandler({"logger": logger, "max_message_size": MaxMessageSize});
        unlimited = new DeflateWsHandler({"logger": logger});
        server.setHandler("limited", "/small", NOTHING, limited);
        server.setHandler("unlimited", "/default", NOTHING, unlimited);
        port = server.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        tls_port = server.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        }).port;
        server.waitForAsyncIo();
    }

    globalTearDown() {
        delete server;
    }

    # opens a WebSocket connection with permessage-deflate on a raw socket and returns the response headers
    private hash<auto> openRaw(Socket s, string path) {
        s.connect("localhost:" + port);
        hash<auto> hdr = {
            "Host": "localhost:" + port,
            "Upgrade": "websocket",
            "Connection": "Upgrade",
            "Sec-WebSocket-Key": get_random_string(16).toBase64(),
            "Sec-WebSocket-Version": "13",
            "Sec-WebSocket-Extensions": "permessage-deflate; client_max_window_bits",
        };
        hash<auto> info;
        s.sendHTTPMessage("GET", path, "1.1", hdr, NOTHING, \info);
        hash<auto> rh = s.readHTTPHeader(10s);
        assertEq(101, rh.status_code, "the WebSocket handshake succeeds");
        return rh;
    }

    # sends a compressed text message as a client does
    private static sendCompressed(Socket s, binary payload) {
        s.send(ws_encode_message(payload, WSOP_Text, True, True, WS_RSV1));
    }

    # reads a message and returns it decompressed
    private static string readText(Socket s) {
        hash<WsMsgInfo> h = ws_read_message(s, 10s);
        if (h.rsv1) {
            return inflate_raw_to_string(binary(h.msg) + <0000ffff>, "utf-8");
        }
        return h.msg;
    }

    # asserts that the server closes the connection with 1009 (Message Too Big)
    private assertTooBig(Socket s, DeflateWsHandler handler) {
        hash<WsMsgInfo> h = ws_read_message(s, 30s);
        assertEq(WSOP_Close, h.op, "the server closes the connection");
        assertEq(WSCC_MessageTooBig, h.close, "with 1009 (Message Too Big)");
        assertRegex("exceeds the maximum message size", handler.errs.get(30s));
    }

    negotiationTest() {
        Socket s();
        on_exit s.close();
        hash<auto> rh = openRaw(s, "/small");
        assertRegex("permessage-deflate", rh."sec-websocket-extensions");
        assertRegex("client_no_context_takeover", rh."sec-websocket-extensions");
    }

    syncFlushTest() {
        Socket s();
        on_exit s.close();
        openRaw(s, "/small");
        foreach list<auto> m in (ClientMessages) {
            sendCompressed(s, m[1]);
            assertEq("ECHO:" + m[0], readText(s));
        }
    }

    http1LimitTest() {
        {
            Socket s();
            on_exit s.close();
            openRaw(s, "/small");
            # at the limit
            string msg = strmul("x", MaxMessageSize - 5);
            sendCompressed(s, deflate_raw(msg));
            assertEq("ECHO:" + msg, readText(s));
        }
        Socket s();
        on_exit s.close();
        openRaw(s, "/small");
        # the compressed frame is small, but the message decompresses to much more than the limit
        binary payload = deflate_raw(strmul("x", MaxMessageSize * 16));
        assertLt(MaxMessageSize, payload.size(), "the compressed frame is within the limit");
        sendCompressed(s, payload);
        assertTooBig(s, limited);
    }

    # returns raw DEFLATE data that decompresses to the given number of spaces, without holding the decompressed
    # data; the zlib stream of a transform without its 2-byte header and 4-byte trailer
    private static binary makeRawBomb(int size) {
        BinaryOutputStream bos();
        TransformOutputStream tos(bos, get_compressor(COMPRESSION_ALG_ZLIB));
        binary chunk = binary(strmul(" ", 1024 * 1024));
        for (int i = 0; i < size / chunk.size(); ++i) {
            tos.write(chunk);
        }
        tos.close();
        binary data = bos.getData();
        return data.substr(2, data.size() - 6);
    }

    defaultLimitTest() {
        Socket s();
        on_exit s.close();
        openRaw(s, "/default");
        # a handler without a maximum message size limits decompressed messages to the default of the extension
        sendCompressed(s, makeRawBomb(PerMessageDeflateExtension::DefaultMaxMessageSize + 1024 * 1024));
        assertTooBig(s, unlimited);
    }

    http2LimitTest() {
        Queue msgs();
        WebSocketClient wsc(sub (*data msg) {
            msgs.push(msg);
        }, {
            "url": sprintf("wss://localhost:%d/small", tls_port),
            "logger": logger,
            "http_version": "2.0",
            "ssl_verify_cert": False,
            "extensions": (new PerMessageDeflateExtension(),),
            "timeout": 30000,
        });
        on_exit delete wsc;
        wsc.connect();
        if (!wsc.isHttp2()) {
            testSkip("HTTP/2 was not negotiated");
        }
        assertTrue(wsc.hasPerMessageDeflate());

        # a compressed message within the limit is echoed
        string msg = strmul("y", 4096);
        wsc.send(msg);
        assertEq("ECHO:" + msg, msgs.get(30s));

        # a message that decompresses to more than the limit closes the connection
        wsc.send(strmul("z", MaxMessageSize * 16));
        assertRegex("exceeds the maximum message size", limited.errs.get(30s));
        assertNothing(msgs.get(30s), "the connection is closed");
    }
}
