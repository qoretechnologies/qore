class MyBadWsConnection inherits WebSocketConnection {
    constructor(WebSocketHandler handler) : WebSocketConnection(handler) {
    }

    gotMessage(string msg) {
        send("RESPONSE:"+msg);
    }

    registered() {
        throw "ERROR", "error";
    }
}

class MyWsConnection inherits WebSocketConnection {
    constructor(WebSocketHandler handler) : WebSocketConnection(handler) {
    }

    int gotRawMessage(hash<WsMsgInfo> msg) {
        #printf("raw msg: %y\n", msg);
        return WSC_Process;
    }

    gotMessage(string msg) {
        switch (msg) {
            case "STOP":
                stop();
                break;
            case "FLUSH":
                send("flushing");
                flush();
                break;
            case "FRAGMENT":
                send("PART1-", WSOP_Text, False);
                send("PART2", WSOP_Continuation, True);
                break;
            case "PING":
                send("test ping", WSOP_Ping, True);
                break;
            case =~ /^ECHO/:
                # echo the message back
                send(msg.substr(4), WSOP_Text, True);
                break;
            case =~ /^BROADCAST/:
                # broadcast message to all connections via handler
                handler.sendAll(msg.substr(9));
                break;
            case =~ /^BCASTBIN/:
                # broadcast binary message to all connections via handler
                handler.sendAll(binary(msg.substr(8)));
                break;
            case "WAIT":
                send(strmul("x", 1024 * 1024 * 5), WSOP_Text, True);
                break;
            default:
                send("RESPONSE:" + msg);
                break;
        }
    }
}

class MyWsHandler inherits WebSocketHandler {
    public {
        Queue errs();
        bool debug = False;
    }

    constructor(*hash<auto> opts) : WebSocketHandler(NOTHING, opts) {
    }

    WebSocketConnection getConnectionImpl(hash<auto> cx, hash<auto> hdr, string cid) {
        return hdr.bad ? new MyBadWsConnection(self) : new MyWsConnection(self);
    }

    logError(string fmt) {
        errs.push(vsprintf(fmt, argv));
        logArgs(LoggerLevel::ERROR, fmt, argv);
    }
}

#! WebSocket handler with extension support for testing
class MyWsHandlerWithExtensions inherits WebSocketHandler {
    public {
        Queue errs();
    }

    constructor(*hash<auto> opts) : WebSocketHandler(NOTHING, opts) {
    }

    WebSocketConnection getConnectionImpl(hash<auto> cx, hash<auto> hdr, string cid) {
        return new MyWsConnection(self);
    }

    logError(string fmt) {
        errs.push(vsprintf(fmt, argv));
        logArgs(LoggerLevel::ERROR, fmt, argv);
    }
}

class MyWsClient inherits WebSocketClient {
    private {
        WaitGroup wg;
        bool ping_signaled = False;
    }

    constructor(code cb, hash<auto> opts, WaitGroup wg) : WebSocketClient(cb, opts) {
        self.wg = wg;
    }

    private handlePing(hash<auto> h) {
        WebSocketClient::handlePing(h);
        if (!ping_signaled) {
            ping_signaled = True;
            wg.done();
        }
    }
}

class WebSocketHandlerTest inherits QUnit::Test {
    public {
        HttpServer mServer;
        MyWsHandler wsHandler;
        Logger logger;
        int port;
    }

    constructor() : Test("WebSocketHandlerTest", "1.0") {
        addTestCase("disconnect test", \disconnectTest());
        addTestCase("WebSocketHandler tests", \webSocketHandlerTests());
        addTestCase("extension tests", \extensionTests());
        addTestCase("extension negative tests", \extensionNegativeTests());
        addTestCase("sendAll extension tests", \sendAllExtensionTests());
        addTestCase("stream context API tests", \streamContextApiTests());
        addTestCase("pending send buffer tests", \pendingSendBufferTests());

        logger = new Logger("test", m_options.verbose > 3 ? LoggerLevel::LevelDebug : LoggerLevel::LevelInfo);
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }
        wsHandler = new MyWsHandler({
            "heartbeat": 1s,
            "heartbeat_msg": "test",
            "logger": logger,
        });
        hash<HttpServerOptionInfo> http_opts = <HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        };
        mServer = new HttpServer(http_opts);
        mServer.setHandler("ws-handler", "", NOTHING, wsHandler);
        mServer.setDefaultHandler("ws-handler", wsHandler);
        port = mServer.addListener(<HttpListenerOptionInfo>{"service": 0}).port;

        set_return_value(main());

        mServer.stop();
        # Stop the global async I/O controller's ThreadPool to allow clean exit
        AsyncSocketIo::AsyncSocketIoController ctrl = AsyncSocketIo::getGlobalAsyncIoController();
        ctrl.stopClear();
    }

    disconnectTest() {
        # Test that the server detects when a client abruptly disconnects.
        # With async I/O, disconnect is detected via TCP FIN/RST causing
        # the recv to return 0 bytes (EOF) or an SSL error.

        hash<auto> linfo = mServer.addListener(<HttpListenerOptionInfo>{
            "cert": new SSLCertificate(TestCert),
            "key": new SSLPrivateKey(TestCert),
            "service": 0,
        });
        on_exit mServer.stopListener(linfo.name);

        string key = get_random_string(16).toBase64();
        hash<auto> hdr = {
            "User-Agent": "BadTestClient/1.0",
            "Upgrade": "websocket",
            "Connection": "Upgrade",
            "Sec-WebSocket-Key": key,
        };

        Socket s();
        s.connectSSL("localhost:" + linfo.port);

        hash<auto> info;
        s.sendHTTPMessage("GET", "/", "1.0", hdr, NOTHING, \info);
        hash<auto> rh = s.readHTTPHeader();
        assertEq(101, rh.status_code);
        assertEq(ws_get_response_key(key), rh."sec-websocket-accept");

        # send a message to confirm the WS connection is active
        s.setNoDelay(True);
        s.send(ws_encode_message("hello", WSOP_Text, True));
        usleep(200ms);

        # verify the echo was received by the server (the WS handler echoes messages)
        assertTrue(True, "connection established and message sent");

        # close the client socket abruptly
        delete s;

        # Wait for the server to detect the disconnect. The async I/O
        # controller detects EOF via recv returning 0 bytes (or SSL error).
        # The handler thread exits when the WS poll op completes.
        # stopListener (in on_exit) will block until cleanup completes.
        # If the server doesn't detect the disconnect within the test
        # timeout (60s), the test framework will kill it.
        usleep(1s);

        # verify the server handled the disconnect cleanly — no assertions
        # needed beyond the test completing without hanging
        assertTrue(True, "server handled disconnect");

        # drain any errors logged during disconnect
        while (wsHandler.errs.size()) {
            wsHandler.errs.get(0);
        }
    }

    webSocketHandlerTests() {
        assertThrows("WEBSOCKETHANDLER-OPTION-ERROR", sub () { new MyWsHandler({"heartbeat": {}}); });
        assertThrows("WEBSOCKETHANDLER-OPTION-ERROR", sub () { new MyWsHandler({"heartbeat": -1}); });

        {
            MyWsHandler wsh();
            assertEq(20, wsh.getHeartbeat());
            assertEq("heartbeat", wsh.getHeartbeatMessage());
        }

        assertEq(1, wsHandler.getHeartbeat());
        assertEq("test", wsHandler.getHeartbeatMessage());

        {
            WaitGroup wg();
            wg.add();
            MyWsClient wsc(sub (*data msg) {}, {"url": "ws://localhost:" + port}, wg);
            wsc.connect();
            wg.wait();
            assertTrue(wsc.isOpen());
        }

        # check bad handler
        {
            WebSocketClient wsc(sub (*data msg) {}, {"url": "ws://localhost:" + port});
            wsc.connect({"hdr": {"Bad": "1"}});
            wsc.disconnect();
        }

        # check close connection from server side
        {
            WaitGroup wg();
            wg.add();
            wsHandler.setHeartbeat(20);  # to not trigger handlePing
            MyWsClient wsc(sub (*data msg) { try { wg.done(); } catch () {} },
                {"url": "ws://localhost:" + port}, wg);
            wsc.connect();
            assertTrue(wsc.isOpen());
            wsc.send("STOP");
            wg.wait();
            # Disconnect before block exit to ensure the delivery thread has finished
            # accessing captured local variables (wg) from the callback closure
            wsc.disconnect();
        }

        # check fragmented messaging and flushing I/O
        {
            WaitGroup wg();
            wg.add();
            Queue msgs();
            code callback = sub (*data msg) {
                msgs.push(msg);
            };
            list<hash<WsMsgInfo>> raw_msgs;
            code raw_callback = int sub (hash<WsMsgInfo> msg) {
                raw_msgs += msg;
                return WSC_Process;
            };
            MyWsClient wsc(callback, {
                "url": "ws://localhost:" + port,
                "raw_callback": raw_callback,
                "logger": logger,
            }, wg);
            wsc.connect();
            assertTrue(wsc.isOpen());
            wsc.send("ECHO😀");
            assertEq("😀", msgs.get(5s));
            # Fragmented send: C++ reassembles before delivery — gotRawMessage
            # sees the complete message, not individual fragments
            wsc.send("FRAG", WSOP_Text, False);
            wsc.send("MENT", WSOP_Continuation, True);
            assertEq("PART1-PART2", msgs.get(5s));
            wsc.send("FLUSH");
            assertEq("flushing", msgs.get(5s));
            wsc.send("PING");
            # wait for ping
            wg.wait();
            # raw_callback sees complete reassembled messages (C++ handles fragmentation)
            assertTrue(raw_msgs.size() >= 1, "raw callback received messages");
            assertEq(WSOP_Text, raw_msgs[0].op);
        }

        wsHandler.errs.get(10s);
        assertEq(0, wsHandler.errs.size());
    }

    extensionTests() {
        # Test handler constructor with extensions option
        {
            MyWsHandlerWithExtensions wsh({
                "extensions": ("permessage-deflate",),
                "logger": logger,
            });
            assertTrue(wsh.hasExtensionSupport());
            assertEq(("permessage-deflate",), wsh.getSupportedExtensions());
        }

        # Test handler constructor with registry
        {
            WebSocketExtensionRegistry reg();
            MyWsHandlerWithExtensions wsh({
                "extensions": reg,
                "logger": logger,
            });
            assertTrue(wsh.hasExtensionSupport());
            assertEq(("permessage-deflate",), wsh.getSupportedExtensions());
        }

        # Test handler without extensions
        {
            MyWsHandlerWithExtensions wsh({
                "logger": logger,
            });
            assertFalse(wsh.hasExtensionSupport());
            assertEq(NOTHING, wsh.getSupportedExtensions());
        }

        # Create a server with extension support
        MyWsHandlerWithExtensions extHandler({
            "extensions": ("permessage-deflate",),
            "logger": logger,
            "heartbeat": 30,
        });

        # Add handler to server
        mServer.setHandler("ws-ext-handler", "/ext", NOTHING, extHandler);

        # Test client without extensions connecting to server with extensions
        {
            Queue msgs();
            code callback = sub (*data msg) {
                msgs.push(msg);
            };
            WebSocketClient wsc(callback, {
                "url": "ws://localhost:" + port + "/ext",
                "logger": logger,
            });
            wsc.connect();
            assertTrue(wsc.isOpen());
            wsc.send("ECHO test");
            *string resp = msgs.get(5s);
            assertEq(" test", resp);
            wsc.disconnect();
        }

        # Test client with extensions connecting to server with extensions
        {
            Queue msgs();
            code callback = sub (*data msg) {
                msgs.push(msg);
            };
            PerMessageDeflateExtension ext();
            WebSocketClient wsc(callback, {
                "url": "ws://localhost:" + port + "/ext",
                "extensions": (ext,),
                "logger": logger,
            });
            wsc.connect();
            assertTrue(wsc.isOpen());
            assertTrue(wsc.hasPerMessageDeflate());
            assertEq(("permessage-deflate",), wsc.getActiveExtensions());

            # Test small message (below compression threshold)
            wsc.send("ECHO small");
            *string resp = msgs.get(5s);
            assertEq(" small", resp);

            wsc.disconnect();
        }
    }

    extensionNegativeTests() {
        # Test invalid extensions option type
        assertThrows("WEBSOCKETHANDLER-OPTION-ERROR", sub () {
            new MyWsHandlerWithExtensions({"extensions": "invalid"});
        });

        assertThrows("WEBSOCKETHANDLER-OPTION-ERROR", sub () {
            new MyWsHandlerWithExtensions({"extensions": 123});
        });

        # Test WebSocketConnection extension methods
        {
            WebSocketConnection conn(wsHandler);

            # Connection without extensions
            assertFalse(conn.hasPerMessageDeflate());
            assertEq(NOTHING, conn.getActiveExtensions());
            assertTrue(conn.validateRsvBits(False, False, False));
            assertFalse(conn.validateRsvBits(True, False, False));  # RSV1 not allowed without extension

            # Set extensions
            PerMessageDeflateExtension ext();
            ext.setActive(True);
            conn.setExtensions((ext,), WS_RSV1);

            assertTrue(conn.hasPerMessageDeflate());
            assertEq(("permessage-deflate",), conn.getActiveExtensions());
            assertTrue(conn.validateRsvBits(True, False, False));  # RSV1 allowed with permessage-deflate
            assertFalse(conn.validateRsvBits(False, True, False));  # RSV2 not allowed
            assertFalse(conn.validateRsvBits(True, True, False));   # RSV2 not allowed even with RSV1
        }

        # Test empty extension list
        {
            WebSocketConnection conn(wsHandler);
            conn.setExtensions((), 0);
            assertFalse(conn.hasPerMessageDeflate());
            assertEq(NOTHING, conn.getActiveExtensions());
        }
    }

    sendAllExtensionTests() {
        # Create extension-enabled handler
        MyWsHandlerWithExtensions extHandler({
            "extensions": ("permessage-deflate",),
            "logger": logger,
            "heartbeat": 30,
        });
        mServer.setHandler("ws-sendall-ext", "/sendall-ext", NOTHING, extHandler);

        # Test 1: sendAll with two extension clients
        {
            Queue msgs1();
            Queue msgs2();
            WebSocketClient wsc1(sub (*data msg) { msgs1.push(msg); }, {
                "url": "ws://localhost:" + port + "/sendall-ext",
                "extensions": (new PerMessageDeflateExtension(),),
                "logger": logger,
            });
            WebSocketClient wsc2(sub (*data msg) { msgs2.push(msg); }, {
                "url": "ws://localhost:" + port + "/sendall-ext",
                "extensions": (new PerMessageDeflateExtension(),),
                "logger": logger,
            });
            wsc1.connect();
            wsc2.connect();
            on_exit {
                wsc1.disconnect();
                wsc2.disconnect();
            }
            assertTrue(wsc1.isOpen());
            assertTrue(wsc2.isOpen());
            assertTrue(wsc1.hasPerMessageDeflate());
            assertTrue(wsc2.hasPerMessageDeflate());

            # Round-trip echo to confirm both are registered
            wsc1.send("ECHO ping1");
            assertEq(" ping1", msgs1.get(5s));
            wsc2.send("ECHO ping2");
            assertEq(" ping2", msgs2.get(5s));

            # Trigger broadcast from wsc1 — small message
            wsc1.send("BROADCAST hello all");
            assertEq(" hello all", msgs1.get(5s));
            assertEq(" hello all", msgs2.get(5s));

            # Trigger broadcast — large message (well above compression threshold)
            string large_msg = strmul("X", 4096);
            wsc2.send("BROADCAST " + large_msg);
            assertEq(" " + large_msg, msgs1.get(5s));
            assertEq(" " + large_msg, msgs2.get(5s));
        }

        # Test 2: sendAll without extensions (backward compatibility)
        {
            Queue msgs1();
            Queue msgs2();
            WebSocketClient wsc1(sub (*data msg) { msgs1.push(msg); }, {
                "url": "ws://localhost:" + port,
                "logger": logger,
            });
            WebSocketClient wsc2(sub (*data msg) { msgs2.push(msg); }, {
                "url": "ws://localhost:" + port,
                "logger": logger,
            });
            wsc1.connect();
            wsc2.connect();
            on_exit {
                wsc1.disconnect();
                wsc2.disconnect();
            }
            assertTrue(wsc1.isOpen());
            assertTrue(wsc2.isOpen());

            # Round-trip echo to confirm both are registered
            wsc1.send("ECHO ping1");
            assertEq(" ping1", msgs1.get(5s));
            wsc2.send("ECHO ping2");
            assertEq(" ping2", msgs2.get(5s));

            # Trigger broadcast
            wsc1.send("BROADCAST no-ext test");
            assertEq(" no-ext test", msgs1.get(5s));
            assertEq(" no-ext test", msgs2.get(5s));
        }

        # Test 3: sendAll with mixed connections (one with extensions, one without)
        {
            Queue msgs1();
            Queue msgs2();
            # Client with permessage-deflate
            WebSocketClient wsc1(sub (*data msg) { msgs1.push(msg); }, {
                "url": "ws://localhost:" + port + "/sendall-ext",
                "extensions": (new PerMessageDeflateExtension(),),
                "logger": logger,
            });
            # Client without extensions
            WebSocketClient wsc2(sub (*data msg) { msgs2.push(msg); }, {
                "url": "ws://localhost:" + port + "/sendall-ext",
                "logger": logger,
            });
            wsc1.connect();
            wsc2.connect();
            on_exit {
                wsc1.disconnect();
                wsc2.disconnect();
            }
            assertTrue(wsc1.isOpen());
            assertTrue(wsc2.isOpen());
            assertTrue(wsc1.hasPerMessageDeflate());

            # Round-trip echo to confirm both are registered
            wsc1.send("ECHO ping1");
            assertEq(" ping1", msgs1.get(5s));
            wsc2.send("ECHO ping2");
            assertEq(" ping2", msgs2.get(5s));

            # Trigger broadcast — small message
            wsc1.send("BROADCAST mixed small");
            assertEq(" mixed small", msgs1.get(5s));
            assertEq(" mixed small", msgs2.get(5s));

            # Trigger broadcast — large message
            string large_msg = strmul("Y", 4096);
            wsc2.send("BROADCAST " + large_msg);
            assertEq(" " + large_msg, msgs1.get(5s));
            assertEq(" " + large_msg, msgs2.get(5s));
        }

        # Test 4: sendAll with binary data (mixed clients)
        {
            Queue msgs1();
            Queue msgs2();
            WebSocketClient wsc1(sub (*data msg) { msgs1.push(msg); }, {
                "url": "ws://localhost:" + port + "/sendall-ext",
                "extensions": (new PerMessageDeflateExtension(),),
                "logger": logger,
            });
            WebSocketClient wsc2(sub (*data msg) { msgs2.push(msg); }, {
                "url": "ws://localhost:" + port + "/sendall-ext",
                "logger": logger,
            });
            wsc1.connect();
            wsc2.connect();
            on_exit {
                wsc1.disconnect();
                wsc2.disconnect();
            }
            assertTrue(wsc1.isOpen());
            assertTrue(wsc2.isOpen());

            # Round-trip echo to confirm both are registered
            wsc1.send("ECHO ping1");
            assertEq(" ping1", msgs1.get(5s));
            wsc2.send("ECHO ping2");
            assertEq(" ping2", msgs2.get(5s));

            # Trigger binary broadcast
            wsc1.send("BCASTBIN\x00\x01\x02\x03test binary");
            binary expected = binary("\x00\x01\x02\x03test binary");
            assertEq(expected, msgs1.get(5s));
            assertEq(expected, msgs2.get(5s));
        }

        # Test 5: sendOne with extensions (end-to-end)
        {
            Queue msgs1();
            WebSocketClient wsc1(sub (*data msg) { msgs1.push(msg); }, {
                "url": "ws://localhost:" + port + "/sendall-ext",
                "extensions": (new PerMessageDeflateExtension(),),
                "logger": logger,
            });
            wsc1.connect();
            on_exit wsc1.disconnect();
            assertTrue(wsc1.isOpen());
            assertTrue(wsc1.hasPerMessageDeflate());

            # The ECHO command triggers send() on the connection, which goes through sendWithExtensions
            wsc1.send("ECHO sendOne ext test");
            assertEq(" sendOne ext test", msgs1.get(5s));

            # Large message to exercise compression
            string large_msg = strmul("Z", 4096);
            wsc1.send("ECHO " + large_msg);
            assertEq(" " + large_msg, msgs1.get(5s));
        }
    }

    streamContextApiTests() {
        # Test the unified AbstractStreamContext API on WebSocketConnection
        WebSocketConnection wsc(wsHandler);

        # Initially, no stream context should be set
        assertNothing(wsc.getStreamContext(), "no stream context initially");

        # Test setStreamContext with NOTHING
        wsc.setStreamContext(NOTHING);
        assertNothing(wsc.getStreamContext(), "setStreamContext(NOTHING) clears context");

        # Create a real HTTP/2 stream context to test the polymorphic API
        # We need a connected TCP socket for Http2StreamContext
        Socket server_sock();
        server_sock.bind("localhost:0");
        server_sock.listen();
        int svr_port = server_sock.getSocketInfo().port;

        Socket client_sock();
        client_sock.connect("localhost:" + svr_port);
        Socket accepted_sock = server_sock.accept();
        on_exit {
            try { client_sock.close(); } catch () {}
            try { accepted_sock.close(); } catch () {}
            try { server_sock.close(); } catch () {}
        }

        # Create Http2StreamContext with the connected socket and a data queue
        Queue h2_data_queue();
        auto h2_ctx = new AsyncSocketIo::Http2StreamContext(accepted_sock, 1, h2_data_queue);
        assertTrue(h2_ctx instanceof AsyncSocketIo::AbstractStreamContext,
            "Http2StreamContext is an AbstractStreamContext");
        assertEq("http2", h2_ctx.getProtocol(), "Http2StreamContext.getProtocol() returns 'http2'");
        assertEq(1, h2_ctx.getStreamId(), "Http2StreamContext.getStreamId()");
        assertTrue(h2_ctx.isOpen(), "Http2StreamContext.isOpen() on open socket");

        # Test setStreamContext/getStreamContext with Http2StreamContext
        wsc.setStreamContext(h2_ctx);
        *AsyncSocketIo::AbstractStreamContext retrieved = wsc.getStreamContext();
        assertEq(True, exists retrieved, "getStreamContext() returns the context");
        assertEq("http2", retrieved.getProtocol(), "retrieved context protocol is http2");

        # Test close() on Http2StreamContext (should be a no-op, not throw)
        h2_ctx.close();

        # Clear and verify
        wsc.setStreamContext(NOTHING);
        assertNothing(wsc.getStreamContext(), "context cleared after setStreamContext(NOTHING)");
    }

    pendingSendBufferTests() {
        WebSocketConnection wsc(wsHandler);

        # --- initially empty ---
        assertFalse(wsc.hasPendingSends(), "empty buffer: hasPendingSends");
        assertEq(0, wsc.getPendingSendBytes(), "empty buffer: getPendingSendBytes");

        # --- queue a single frame ---
        binary frame1 = <0102030405>;
        assertTrue(wsc.queuePendingSend(frame1), "queue first frame succeeds");
        assertTrue(wsc.hasPendingSends(), "non-empty after first queue");
        assertEq(frame1.size(), wsc.getPendingSendBytes(), "byte count after first queue");

        # --- peek is idempotent ---
        assertEq(frame1, wsc.peekPendingSend(), "peek returns first frame");
        assertEq(frame1, wsc.peekPendingSend(), "peek again returns same frame");
        assertEq(frame1.size(), wsc.getPendingSendBytes(), "byte count unchanged after peeks");

        # --- queue a second frame, verify FIFO order ---
        binary frame2 = <0a0b0c>;
        assertTrue(wsc.queuePendingSend(frame2), "queue second frame succeeds");
        assertEq(frame1.size() + frame2.size(), wsc.getPendingSendBytes(),
            "byte count after two queues");
        # peek still returns first frame (FIFO)
        assertEq(frame1, wsc.peekPendingSend(), "peek still returns first frame");

        # --- dequeue first, then second ---
        binary got1 = wsc.dequeuePendingSend();
        assertEq(frame1, got1, "dequeue returns first frame");
        assertEq(frame2.size(), wsc.getPendingSendBytes(), "byte count after first dequeue");
        assertTrue(wsc.hasPendingSends(), "still has sends after first dequeue");

        binary got2 = wsc.dequeuePendingSend();
        assertEq(frame2, got2, "dequeue returns second frame");
        assertEq(0, wsc.getPendingSendBytes(), "byte count zero after both dequeued");
        assertFalse(wsc.hasPendingSends(), "empty after both dequeued");

        # --- buffer limit enforcement ---
        # Create a frame that is exactly at the limit
        int limit = WebSocketHandler::MaxPendingSendBytes;
        binary big_frame = binary(strmul("x", limit));
        assertTrue(wsc.queuePendingSend(big_frame), "frame at exact limit queues");
        assertEq(limit, wsc.getPendingSendBytes(), "byte count at limit");

        # Any additional frame should be rejected
        binary tiny = <ff>;
        assertFalse(wsc.queuePendingSend(tiny), "frame rejected when buffer full");
        assertEq(limit, wsc.getPendingSendBytes(), "byte count unchanged after rejection");

        # Drain and verify
        wsc.dequeuePendingSend();
        assertFalse(wsc.hasPendingSends(), "empty after draining big frame");
        assertEq(0, wsc.getPendingSendBytes(), "byte count zero after big frame drained");

        # --- frame larger than limit can never be buffered ---
        binary oversized = binary(strmul("y", limit + 1));
        assertFalse(wsc.queuePendingSend(oversized), "oversized frame rejected on empty buffer");
        assertFalse(wsc.hasPendingSends(), "still empty after oversized rejection");

        # --- ordering with many frames ---
        list<binary> frames;
        for (int i = 0; i < 20; ++i) {
            binary f = binary(sprintf("frame-%03d", i));
            assertTrue(wsc.queuePendingSend(f), sprintf("queue frame %d", i));
            push frames, f;
        }
        int total_bytes = 0;
        for (int i = 0; i < frames.size(); ++i) {
            total_bytes += frames[i].size();
        }
        assertEq(total_bytes, wsc.getPendingSendBytes(),
            "all 20 frames queued (total byte count matches)");
        for (int i = 0; i < 20; ++i) {
            assertEq(frames[i], wsc.peekPendingSend(), sprintf("peek order frame %d", i));
            assertEq(frames[i], wsc.dequeuePendingSend(), sprintf("dequeue order frame %d", i));
        }
        assertFalse(wsc.hasPendingSends(), "empty after draining all 20 frames");
    }

    private log(string str) {
        if (m_options.verbose > 2) {
            vprintf(str + "\n", argv);
        }
    }
}
