%modern

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/HttpServerUtil.qm
%requires ../../../../qlib/HttpServerAsyncIo
%requires ../../../../qlib/HttpServer.qm
%requires ../../../../qlib/WebSocketUtil.qm
%requires ../../../../qlib/WebSocketHandler.qm
%requires ../../../../qlib/WebSocketClient.qm

%exec-class WebSocketH2PerfTest

#! Echo WebSocket connection - echoes back text and binary messages exactly
class PerfWsConnection inherits WebSocketConnection {
    private {
        *int delay_ms;
    }

    constructor(WebSocketHandler handler, *int delay_ms) : WebSocketConnection(handler) {
        self.delay_ms = delay_ms;
    }

    gotMessage(string msg) {
        if (delay_ms) {
            sleep(milliseconds(delay_ms));
        }
        send(msg);
    }

    gotMessage(binary msg) {
        if (delay_ms) {
            sleep(milliseconds(delay_ms));
        }
        send(msg);
    }
}

#! Flood WebSocket connection - floods the send queue on registration for backpressure testing
class FloodWsConnection inherits WebSocketConnection {
    private {
        int flood_count;
        int msg_size;
    }

    constructor(WebSocketHandler handler, int flood_count, int msg_size) : WebSocketConnection(handler) {
        self.flood_count = flood_count;
        self.msg_size = msg_size;
    }

    registered() {
        binary payload = binary(strmul("F", msg_size));
        for (int i = 0; i < flood_count; ++i) {
            send(payload);
        }
    }

    gotMessage(string msg) {
        # no-op for flood connections
    }

    gotMessage(binary msg) {
        # no-op for flood connections
    }
}

#! WebSocket handler that routes to connection types based on X-Test-Mode header
class PerfWsHandler inherits WebSocketHandler {
    public {
        bool debug = False;
    }

    WebSocketConnection getConnectionImpl(hash<auto> cx, hash<auto> hdr, string cid) {
        switch (hdr."x-test-mode") {
            case "flood": {
                int flood_count = (hdr."x-flood-count" ?? "200").toInt();
                int msg_size = (hdr."x-msg-size" ?? "65536").toInt();
                return new FloodWsConnection(self, flood_count, msg_size);
            }
            case "slow": {
                int delay = (hdr."x-delay-ms" ?? "10").toInt();
                return new PerfWsConnection(self, delay);
            }
            default:
                return new PerfWsConnection(self);
        }
    }

    logError(string fmt) {
        if (debug) {
            vprintf("ERROR " + fmt + "\n", argv);
        }
    }

    logInfo(string fmt) {
        if (debug) {
            vprintf("INFO " + fmt + "\n", argv);
        }
    }

    logDebug(string fmt) {
        if (debug) {
            vprintf("DEBUG " + fmt + "\n", argv);
        }
    }
}

