#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Mime
%requires ConnectionProvider
%requires Logger
%requires HttpServerUtil
%requires RestClient
%requires Sap4HanaRestClient
%requires HttpServerAsyncIo
%requires HttpServer

%requires json

%exec-class Main

class FakeSap4HanaRestHandler inherits AbstractHttpRequestHandler {
    private {
        string m_data;
        string m_mime;
    }

    constructor(string mime, string str) {
        m_mime = mime;
        m_data = str;
    }

    hash<auto> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        if (!hdr."apikey")
            return makeResponse(400, "missing api key");
        if (hdr.method == "GET") {
            return makeResponse(("Content-Type": m_mime), 200, m_data);
        } else if (hdr.method == "PUT") {
            return makeResponse(("Content-Type": m_mime), 200, m_data);
        }
    }
}

const VALUE_JSON = (
    "input": "{\"foo\":{\"bar\":1}}",
    "output": ("foo": ("bar": 1)),
);

public class Main inherits QUnit::Test {
    private {
        HttpServer m_http;
        int port;
    }

    constructor() : Test("Sap4HanaRestClientTest", "1.0") {
        addTestCase("GET tests", \methodGetTest());
        addTestCase("PUT tests", \methodPutTest());
        addTestCase("neg tests", \negTest());
        addTestCase("connection tests", \connectionTest());
        addTestCase("OAuth2 feature tests", \oauth2FeatureTest());

        # Return for compatibility with test harness that checks return value.
        set_return_value(main());
    }

    setUp() {
        Logger logger("test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }
        hash<HttpServerOptionInfo> http_opts = <HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        };
        m_http = new HttpServer(http_opts);
        m_http.setHandler("/api_json", "/api_json", MimeTypeJson, new FakeSap4HanaRestHandler(MimeTypeJson, VALUE_JSON.input));
        port = m_http.addListener(<HttpListenerOptionInfo>{"node": "localhost", "service": 0}).port;
    }

    tearDown() {
        delete m_http;
    }

    checkModule() {
    }

    methodGetTest() {
        checkModule();
        Sap4HanaRestClient rest(("url": "http://localhost:" + port, "apikey": "key"));
        auto ret;

        ret = rest.get("/api_json");
        testAssertionValue("/api_json", ret.body, VALUE_JSON.output);
    }

    methodPutTest() {
        checkModule();
        Sap4HanaRestClient rest(("url": "http://localhost:" + port, "apikey": "key"));
        auto ret;

        rest.setSerialization("json");
        ret = rest.put("/api_json", VALUE_JSON.output);
        testAssertionValue("/api_json", ret.body, VALUE_JSON.output);
    }

    negTest() {
        checkModule();
        assertThrows("SAP4HANARESTCLIENT-ERROR", sub () {
            new Sap4HanaRestClient({
                "url": "http://localhost:" + port,
            });
        });
        RestClient rest(("url": "http://localhost:" + port, "apikey": ""));
        assertThrows("REST-RESPONSE-ERROR", \rest.get(), "/api_json");
    }

    connectionTest() {
        checkModule();
        # a hard-coded port encodes an assumption about the machine that the test cannot verify; ports in
        # common use (8080 above all) are occupied on many developer machines, and connecting to whatever is
        # listening there produces an unrelated error.  Reserve an unused one instead
        int port = get_free_port();
        string url = sprintf("http://localhost:%d", port);
        Sap4HanaRestConnection swsc("test", "test", url, {}, ("apikey": "x"));
        assertEq(True, swsc instanceof Sap4HanaRestConnection);

        assertThrows("CONNECTION-OPTION-ERROR", sub () { Sap4HanaRestConnection swsc1("test", "test", url);});

        Sap4HanaRestClient client = swsc.get(False);
        # issue #3321: check default timeouts
        assertEq(45000, client.getTimeout());
        assertEq(45000, client.getConnectTimeout());
    }

    #! This connection holds its OAuth2 credentials under its own option names, and must still report OAuth2
    /** the client applies the client credentials grant whenever both credentials are present, but nothing set
        \c oauth2_grant_type on the connection, so the connection reported that it had nothing to do with OAuth2
        (issue 5441)
    */
    oauth2FeatureTest() {
        checkModule();
        string url = sprintf("http://localhost:%d", get_free_port());

        Sap4HanaRestConnection oauth2("test", "test", url, {}, {
            "client_id": "client-id",
            "client_secret": "client-secret",
        });
        hash<auto> info = oauth2.getExtendedInfoAsData();
        assertTrue(info.oauth2, "a connection with both credentials authenticates with OAuth2");
        assertEq("client_credentials", info.oauth2_grant_type, "with the grant the client applies");
        assertTrue(info.oauth2_client_credentials, "and claims that grant's feature");
        assertTrue(oauth2.getFeatures(){RestConnection::RCF_OAUTH2}, "as a connection feature as well");
        assertFalse(info.oauth2_auth, "the credentials are configuration, so there is nothing to authorize");

        # API key authentication is not OAuth2, and the connection must not claim that it is
        Sap4HanaRestConnection apikey("test", "test", url, {}, {"apikey": "x"});
        info = apikey.getExtendedInfoAsData();
        assertFalse(info.oauth2, "an API key connection does not authenticate with OAuth2");
        assertEq("none", info.oauth2_grant_type, "and reports no grant type");
        assertNothing(apikey.getFeatures(){RestConnection::RCF_OAUTH2}, "and claims no OAuth2 feature");
    }
}
