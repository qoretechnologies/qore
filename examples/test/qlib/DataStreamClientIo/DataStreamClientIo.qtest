    constructor() : Test("DataStreamClientIo test", "1.0") {
        addTestCase("protocol mode accessors", \testProtocolModeAccessors());
        addTestCase("max message size", \testMaxMessageSize());
        addTestCase("non-streaming unary (Connect)", \testNonStreamingConnect());
        addTestCase("connection class", \testConnectionClass());

        Logger logger("test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            logger.addAppender(new TestAppender());
        }
        hash<HttpServerOptionInfo> http_opts = <HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
            "quic_headers_only": True,
        };
        m_http = new HttpServer(http_opts);
        # Enable async I/O for HTTP/2 streaming support
        try {
            m_http.waitForAsyncIo();
        } catch (hash<ExceptionInfo> ex) {
            printf("AsyncIo not available: %s\n", ex.desc);
        }

        # Register ConnectHandler with unary and streaming handlers
        Connect::ConnectHandler handler();
        handler.registerUnary("TestService", "Echo",
            auto sub (auto request, hash<auto> metadata) {
                return request;
            });
        handler.registerUnary("TestService", "Add",
            auto sub (auto request, hash<auto> metadata) {
                return {"result": request.a + request.b};
            });
        handler.registerServerStream("TestService", "Numbers",
            sub (auto request, Connect::ConnectServerStream stream, hash<auto> metadata) {
                int count = request.count ?? 5;
                for (int i = 0; i < count; ++i) {
                    stream.write({"index": i, "value": sprintf("msg-%d", i)});
                }
            });
        handler.registerClientStream("TestService", "Aggregate",
            auto sub (Connect::ConnectServerStream stream, hash<auto> metadata) {
                list<string> items();
                while (*auto msg = stream.read()) {
                    items += msg.name;
                }
                return {"count": items.size(), "names": items};
            });
        handler.registerBidiStream("TestService", "BidiEcho",
            sub (Connect::ConnectServerStream stream, hash<auto> metadata) {
                while (*auto msg = stream.read()) {
                    stream.write({"reply": "echo:" + msg.text});
                }
            });

        m_http.setHandler("connect", "", NOTHING, handler);
        m_http.setDefaultHandler("connect", handler);
        m_http.setHandler("ds-rest", "/ds", NOTHING, new RestDataStreamHandler(), NOTHING, False);

        # HTTP/1.1 (plain) listener for non-streaming tests
        m_port = m_http.addListener(<HttpListenerOptionInfo>{"service": 0}).port;

        # TLS listener for HTTP/2 streaming tests
        try {
            hash<auto> tls_info = m_http.addListener(<HttpListenerOptionInfo>{
                "service": 0,
                "cert": new SSLCertificate(CertPem),
                "key": new SSLPrivateKey(KeyPem),
            });
            m_tls_port = tls_info.port;
            m_tls_available = True;

            addTestCase("H2 recvDataStream (Connect)", \testH2RecvDataStream());
            addTestCase("H2 sendDataStream (Connect)", \testH2SendDataStream());
            addTestCase("H2 sendRecvDataStream (Connect)", \testH2SendRecvDataStream());
            addTestCase("H2 openConnectInteractiveStream (Connect)",
                \testH2OpenConnectInteractiveStream());
        } catch (hash<ExceptionInfo> ex) {
            printf("TLS listener setup failed: %s: %s\n", ex.err, ex.desc);
        }

        # QUIC (HTTP/3) listener for H3 streaming tests
        try {
            hash<auto> quic_info = m_http.addQuicListener(<HttpListenerOptionInfo>{
                "cert": new SSLCertificate(CertPem),
                "key": new SSLPrivateKey(KeyPem),
            });
            m_quic_port = quic_info.port;
            m_quic_available = True;

            addTestCase("H3 recvDataStream (Connect)", \testH3RecvDataStream());
            addTestCase("H3 REST recvDataStream initial body (Connect)",
                \testH3RestRecvDataStreamInitialBody());
            addTestCase("H3 sendDataStream (Connect)", \testH3SendDataStream());
            addTestCase("H3 sendRecvDataStream (Connect)", \testH3SendRecvDataStream());
            addTestCase("H3 openConnectInteractiveStream (Connect)",
                \testH3OpenConnectInteractiveStream());
        } catch (hash<ExceptionInfo> ex) {
            printf("QUIC listener setup failed: %s: %s\n", ex.err, ex.desc);
        }

        set_return_value(main());

        delete m_http;
    }

    private string getHttpUrl() {
        return sprintf("http://localhost:%d", m_port);
    }

    private string getHttpsUrl() {
        return sprintf("https://127.0.0.1:%d", m_tls_port);
    }

    private string getQuicUrl() {
        return sprintf("https://127.0.0.1:%d", m_quic_port);
    }

    # ---- Protocol mode accessor tests ----

    testProtocolModeAccessors() {
        DataStreamClient::DataStreamClientIo client({"url": getHttpUrl()});
        assertEq("auto", client.getProtocol(), "default protocol is auto");
        assertNothing(client.getDetectedProtocol(), "no detected protocol initially");

        client.setProtocol(DataStreamClient::DataStreamProtocol::Connect);
        assertEq("connect", client.getProtocol(), "protocol set to connect");

        client.setProtocol(DataStreamClient::DataStreamProtocol::DataStream);
        assertEq("datastream", client.getProtocol(), "protocol set to datastream");

        client.setProtocol(DataStreamClient::DataStreamProtocol::Auto);
        assertEq("auto", client.getProtocol(), "protocol reset to auto");

        client.resetProtocolCache();
        assertNothing(client.getDetectedProtocol(), "cache cleared");
    }

    # ---- Max message size tests ----

    testMaxMessageSize() {
        DataStreamClient::DataStreamClientIo client({"url": getHttpUrl()});
        assertEq(CONNECT_DEFAULT_MAX_MESSAGE_SIZE, client.getMaxMessageSize(),
            "default max message size");

        client.setMaxMessageSize(1024);
        assertEq(1024, client.getMaxMessageSize(), "custom max message size");

        client.setMaxMessageSize(0);
        assertEq(0, client.getMaxMessageSize(), "unlimited max message size");

        # Constructor option
        DataStreamClient::DataStreamClientIo client2({"url": getHttpUrl(),
            "max_message_size": 2048});
        assertEq(2048, client2.getMaxMessageSize(), "max_message_size from constructor");
    }

    # ---- Non-streaming Connect unary test ----

    testNonStreamingConnect() {
        DataStreamClient::DataStreamClientIo client({
            "url": getHttpUrl(),
            "protocol": "connect",
        });

        # POST with body
        hash<auto> resp = client.restPost("/TestService/Echo", {"hello": "world"});
        assertEq(200, resp.status_code, "echo status 200");
        assertEq("world", resp.body.hello, "echo body matches");

        # POST with Add
        resp = client.restPost("/TestService/Add", {"a": 3, "b": 4});
        assertEq(200, resp.status_code, "add status 200");
        assertEq(7, resp.body.result, "add result");
    }

    # ---- Connection class tests ----

    testConnectionClass() {
        # Verify connection scheme registration
        string url = getHttpUrl();
        url =~ s/^http:/dsio:/;
        DataStreamClient::DataStreamConnectionIo conn("test", "test connection", url);
        assertEq("dsios", conn.getType(), "connection type");

        # Get a client from the connection
        DataStreamClient::DataStreamClientIo client = conn.get(True);
        assertTrue(client instanceof DataStreamClient::DataStreamClientIo,
            "connection returns DataStreamClientIo");
    }

    private hash<auto> readConnectReply(HttpClientIo::HttpClientStreamHandle stream,
            binary buf, string label) {
        while (True) {
            while (True) {
                int frame_size = connect_next_frame_size(buf);
                if (frame_size < 0) {
                    break;
                }
                hash<auto> frame = connect_unframe_message(buf);
                if (buf.size() > frame_size) {
                    buf = buf.substr(frame_size);
                } else {
                    buf = binary();
                }

                if (frame.flags & CONNECT_FLAG_END_STREAM) {
                    return {"end": True, "buf": buf};
                }

                return {
                    "body": parse_yaml(frame.data.toString("utf-8")),
                    "buf": buf,
                };
            }

            auto rd = stream.readData(10s);
            if (!exists rd) {
                throw "CONNECT-INTERACTIVE-STREAM-TIMEOUT",
                    sprintf("%s: timed out waiting for a Connect reply", label);
            }
            if (rd.typeCode() == NT_HASH) {
                if (rd.end_stream) {
                    return {"end": True, "buf": buf};
                }
                if (rd.error) {
                    throw "CONNECT-INTERACTIVE-STREAM-ERROR",
                        sprintf("%s: stream error: %y", label, rd.error);
                }
                continue;
            }

            buf += rd.typeCode() == NT_BINARY ? rd : binary(rd);
        }
    }

    private testOpenConnectInteractiveStream(string url, string label) {
        DataStreamClient::DataStreamClientIo client({
            "url": url,
            "protocol": "connect",
            "accept_all_certs": True,
        });

        HttpClientIo::HttpClientStreamHandle stream = client.openConnectInteractiveStream(
            "POST", "/TestService/BidiEcho");
        on_exit stream.cancel();

        binary buf = binary();
        stream.sendData(connect_frame_message(binary(make_yaml({"text": "hello"})), 0), False);
        stream.sendData(connect_frame_message(binary(make_yaml({"text": "world"})), 0), False);
        stream.writesDone();

        hash<auto> reply = readConnectReply(stream, buf, label);
        buf = reply.buf;
        assertEq("echo:hello", reply.body.reply, label + ": first interactive reply");

        reply = readConnectReply(stream, buf, label);
        buf = reply.buf;
        assertEq("echo:world", reply.body.reply, label + ": second interactive reply");
    }

    # ---- HTTP/2 streaming tests (require TLS) ----

    testH2RecvDataStream() {
        if (!m_tls_available) {
            testSkip("TLS not available");
            return;
        }

        DataStreamClient::DataStreamClientIo client({
            "url": getHttpsUrl(),
            "protocol": "connect",
            "accept_all_certs": True,
        });

        list<auto> received();
        *string recv_error;
        client.recvDataStream(
            sub (auto data) {
                received += data;
            },
            sub (*string err) {
                recv_error = err;
            },
            "POST", "/TestService/Numbers",
            {"count": 3},
            30s,
        );

        assertEq(3, received.size(), "received 3 messages");
        assertEq(0, received[0].index, "first message index");
        assertEq("msg-0", received[0].value, "first message value");
        assertEq(2, received[2].index, "last message index");
        assertNothing(recv_error, "no error");
    }

    testH2SendDataStream() {
        if (!m_tls_available) {
            testSkip("TLS not available");
            return;
        }

        DataStreamClient::DataStreamClientIo client({
            "url": getHttpsUrl(),
            "protocol": "connect",
            "accept_all_certs": True,
        });

        list<hash<auto>> items = (
            {"name": "alice"},
            {"name": "bob"},
            {"name": "charlie"},
        );
        int idx = 0;
        hash<auto> resp = client.sendDataStream(
            auto sub () {
                if (idx >= items.size()) {
                    return NOTHING;
                }
                return items[idx++];
            },
            "POST", "/TestService/Aggregate",
            30s,
        );

        assertEq(3, resp.body.count, "aggregated count");
        assertEq(("alice", "bob", "charlie"), resp.body.names, "aggregated names");
    }

    testH2SendRecvDataStream() {
        if (!m_tls_available) {
            testSkip("TLS not available");
            return;
        }

        DataStreamClient::DataStreamClientIo client({
            "url": getHttpsUrl(),
            "protocol": "connect",
            "accept_all_certs": True,
        });

        list<hash<auto>> to_send = (
            {"text": "hello"},
            {"text": "world"},
        );
        int idx = 0;
        list<auto> received();

        client.sendRecvDataStream(
            auto sub () {
                if (idx >= to_send.size()) {
                    return NOTHING;
                }
                return to_send[idx++];
            },
            sub (auto data) {
                received += data;
            },
            sub (*string err) {
                if (err) {
                    throw "BIDI-ERROR", err;
                }
            },
            "POST", "/TestService/BidiEcho",
            30s,
        );

        assertEq(2, received.size(), "received 2 bidi replies");
        assertEq("echo:hello", received[0].reply, "first bidi reply");
        assertEq("echo:world", received[1].reply, "second bidi reply");
    }

    testH2OpenConnectInteractiveStream() {
        if (!m_tls_available) {
            testSkip("TLS not available");
            return;
        }

        testOpenConnectInteractiveStream(getHttpsUrl(), "H2");
    }

    # ---- HTTP/3 (QUIC) Connect streaming tests ----

    testH3RecvDataStream() {
        if (!m_quic_available) {
            testSkip("QUIC not available");
            return;
        }

        DataStreamClient::DataStreamClientIo client({
            "url": getQuicUrl(),
            "protocol": "connect",
            "accept_all_certs": True,
        });

        list<auto> received();
        *string recv_error;
        client.recvDataStream(
            sub (auto data) {
                received += data;
            },
            sub (*string err) {
                recv_error = err;
            },
            "POST", "/TestService/Numbers",
            {"count": 3},
            30s,
        );

        assertEq(3, received.size(), "H3: received 3 messages");
        assertEq(0, received[0].index, "H3: first message index");
        assertEq("msg-0", received[0].value, "H3: first message value");
        assertEq(2, received[2].index, "H3: last message index");
        assertNothing(recv_error, "H3: no error");
    }

    testH3RestRecvDataStreamInitialBody() {
        if (!m_quic_available) {
            testSkip("QUIC not available");
            return;
        }

        DataStreamClient::DataStreamClientIo client({
            "url": getQuicUrl(),
            "protocol": "connect",
            "accept_all_certs": True,
        });

        list<auto> received();
        *string recv_error;
        client.recvDataStream(
            sub (auto data) {
                received += data;
            },
            sub (*string err) {
                recv_error = err;
            },
            "PUT", "/ds?action=args",
            {"sql": "select 1 as a", "args": ("x")},
            30s,
        );

        assertEq(1, received.size(), "H3 REST: received one response message");
        assertEq("select 1 as a", received[0].sql, "H3 REST: initial body sql received");
        assertEq(("x"), received[0].args, "H3 REST: initial body args received");
        assertNothing(recv_error, "H3 REST: no error");
    }

    testH3SendDataStream() {
        if (!m_quic_available) {
            testSkip("QUIC not available");
            return;
        }

        DataStreamClient::DataStreamClientIo client({
            "url": getQuicUrl(),
            "protocol": "connect",
            "accept_all_certs": True,
        });

        list<hash<auto>> items = (
            {"name": "alice"},
            {"name": "bob"},
            {"name": "charlie"},
        );
        int idx = 0;
        hash<auto> resp = client.sendDataStream(
            auto sub () {
                if (idx >= items.size()) {
                    return NOTHING;
                }
                return items[idx++];
            },
            "POST", "/TestService/Aggregate",
            30s,
        );

        assertEq(3, resp.body.count, "H3: aggregated count");
        assertEq(("alice", "bob", "charlie"), resp.body.names, "H3: aggregated names");
    }

    testH3SendRecvDataStream() {
        if (!m_quic_available) {
            testSkip("QUIC not available");
            return;
        }

        DataStreamClient::DataStreamClientIo client({
            "url": getQuicUrl(),
            "protocol": "connect",
            "accept_all_certs": True,
        });

        list<hash<auto>> to_send = (
            {"text": "hello"},
            {"text": "world"},
        );
        int send_idx = 0;
        list<auto> received();
        client.sendRecvDataStream(
            auto sub () {
                if (send_idx >= to_send.size()) {
                    return NOTHING;
                }
                return to_send[send_idx++];
            },
            sub (auto data) {
                received += data;
            },
            sub (*string err) {
                if (err) {
                    throw "BIDI-ERROR", err;
                }
            },
            "POST", "/TestService/BidiEcho",
            30s,
        );

        assertEq(2, received.size(), "H3: received 2 bidi replies");
        assertEq("echo:hello", received[0].reply, "H3: first bidi reply");
        assertEq("echo:world", received[1].reply, "H3: second bidi reply");
    }

    testH3OpenConnectInteractiveStream() {
        if (!m_quic_available) {
            testSkip("QUIC not available");
            return;
        }

        testOpenConnectInteractiveStream(getQuicUrl(), "H3");
    }
}

class TestAppender inherits LoggerAppenderWithLayout {
    constructor() : LoggerAppenderWithLayout("test", new LoggerLayoutPattern("%d T%t [%p]: %m%n")) {
    }

    processEventImpl(int type, auto params) {
        switch (type) {
            case EVENT_LOG:
                print(params);
                break;
        }
    }
}
