%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"

%requires HttpClientIo
%requires HttpServer
%requires Logger
%requires Mime
%requires yaml
%requires json
%requires DataStreamUtil
%requires DataStreamClientIo
%requires DataStreamRequestHandler
%requires Connect
%requires RestHandler
%requires QUnit

%exec-class DataStreamClientIoTest

class RestDataStreamArgHandler inherits AbstractDataStreamRequestHandler {
    private {
        hash<auto> args = {};
    }

    constructor(hash<auto> cx, *hash<auto> ah) : AbstractDataStreamRequestHandler(cx, ah) {
    }

    private nothing recvDataImpl(auto data) {
        if (data.typeCode() == NT_HASH) {
            map args.$1 = data.$1, keys data;
        }
    }

    hash<auto> getResponseHeaderMessageImpl() {
        *hash<auto> err = getErrorResponse();
        if (err) {
            return err;
        }
        return {
            "code": 200,
            "body": args,
        };
    }

    *code getPersistentClosedNotification() {
        return sub () {};
    }

    private auto sendDataImpl() {
    }
}

class RestDataStreamHandler inherits RestHandler::RestHandler {
    constructor() : RestHandler(NOTHING) {
    }

    removeRootPath(reference<string> path) {
        path = regex_subst(path, "^/?ds", "");
    }

    bool wantsBodyStreaming(hash<auto> cx, hash<auto> hdr) {
        return RestHandler::wantsBodyStreaming(cx, hdr);
    }

    AbstractRestStreamRequestHandler streamPutArgs(hash<auto> cx, *hash<auto> ah) {
        return new RestDataStreamArgHandler(cx, ah);
    }
}

