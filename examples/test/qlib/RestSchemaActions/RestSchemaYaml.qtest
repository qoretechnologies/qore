%modern
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires RestSchemaActions
%requires json
%requires yaml

%exec-class RestSchemaYamlTest

class RestSchemaYamlTest inherits QUnit::Test {
    constructor() : Test("RestSchemaYamlTest", "1.0") {
        addTestCase("JSON serialization without external modules", \jsonTest());
        addTestCase("Bundled YAML serialization", \yamlTest());
        set_return_value(main());
    }

    private jsonTest() {
        hash<auto> schema = {"openapi": "3.0.0", "paths": {"/records": {"get": {}}}};
        string text = RestSchemaImporter::serialize(schema, True);
        assertEq(schema, parse_json(text));
        assertEq("\n", text.substr(-1));
    }

    private yamlTest() {
        assertTrue(RestSchemaImporter::yamlCoreSchemaSupported());
        hash<auto> schema = {"openapi": "3.0.0"};
        string text = RestSchemaImporter::serialize(schema, False);
        assertEq(schema, RestSchemaImporter::parseYamlDocument(text));
    }
}
