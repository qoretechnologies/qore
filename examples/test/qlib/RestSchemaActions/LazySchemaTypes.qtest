#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires DataProvider
%requires RestSchemaActions

%exec-class LazySchemaTypesTest

#! Verifies that the public request and response types built from a vendored schema are built on first use
/** Loading the modules builds no action set; each accessor builds its type once and returns the same type
    afterwards, also to threads calling it at once
*/
class LazySchemaTypesTest inherits QUnit::Test {
    public {
        #! The modules, and their classes with type accessors
        const Classes = {
            "MistralDataProvider": (
                "MistralDataProvider::MistralChatCompletionDataProvider",
                "MistralDataProvider::MistralEmbeddingDataProvider",
                "MistralDataProvider::MistralOcrDataProvider",
            ),
            "CohereDataProvider": (
                "CohereDataProvider::CohereChatDataProvider",
                "CohereDataProvider::CohereEmbedDataProvider",
                "CohereDataProvider::CohereRerankDataProvider",
                "CohereDataProvider::CohereClassifyDataProvider",
            ),
            "JinaDataProvider": (
                "JinaDataProvider::JinaEmbeddingDataProvider",
                "JinaDataProvider::JinaRerankDataProvider",
            ),
            "GoogleDocumentAiDataProvider": (
                "GoogleDocumentAiDataProvider::GoogleDocumentAiProcessDocumentDataProvider",
                "GoogleDocumentAiDataProvider::GoogleDocumentAiWaitOperationDataProvider",
            ),
            "AzureDocumentIntelligenceDataProvider": (
                "AzureDocumentIntelligenceDataProvider::AzureDocumentIntelligenceAnalyzeDocumentDataProvider",
            ),
            "StabilityAiDataProvider": (
                "StabilityAiDataProvider::StabilityAiGenerateImageDataProvider",
            ),
            "BflDataProvider": (
                "BflDataProvider::BflGenerateImageDataProvider",
            ),
            "AssemblyAiDataProvider": (
                "AssemblyAiDataProvider::AssemblyAiTranscribeDataProvider",
            ),
        };

        #! The shared batch types of the Jina module, built from its schema-derived embedding type
        const JinaShared = (
            "JinaDataProvider::JinaBatchRecordResponseDataType",
            "JinaDataProvider::JinaBatchRecordDataType",
            "JinaDataProvider::JinaBatchDownloadResponseDataType",
        );
    }

    private {
        #! the action sets built by loading the modules
        int load_sets;
    }

    constructor() : Test("public schema types are built on first use", "1.0") {
        int before = RestSchemaActionSet::getConstructionCount();
        map load_module($1), keys Classes;
        load_sets = RestSchemaActionSet::getConstructionCount() - before;

        addTestCase("loading builds no action set", \loadTest());
        # first: the types must not have been built yet
        addTestCase("a sandboxed first use builds each type outside the sandbox", \sandboxedFirstUseTest());
        addTestCase("the AssemblyAI types are available before the catalog is read", \assemblyAiTest());
        addTestCase("concurrent first calls build one type", \concurrentTest());
        addTestCase("each accessor builds its type once", \accessorTest());
        addTestCase("the Jina batch types are shared and built on first use", \jinaTest());
        set_return_value(main());
    }

    loadTest() {
        assertEq(0, load_sets);
    }

    concurrentTest() {
        string cls = "CohereDataProvider::CohereChatDataProvider";
        int threads = 8;
        Counter ready(threads);
        Counter go(1);
        Counter done(threads);
        Queue results();
        for (int i = 0; i < threads; ++i) {
            background LazySchemaTypesTest::callAccessor(cls, "responseType", ready, go, done, results);
        }
        ready.waitForZero();
        go.dec();
        done.waitForZero();
        assertEq(threads, results.size());
        object first = results.get();
        assertTrue(first instanceof AbstractDataProviderType);
        while (results.size()) {
            assertTrue(first == results.get(), "every thread gets the same type");
        }
        assertTrue(first == call_static_method(cls, "responseType"));
    }

    accessorTest() {
        foreach hash<auto> i in (Classes.pairIterator()) {
            foreach string cls in (i.value) {
                foreach string method in (("requestType", "responseType")) {
                    auto t = call_static_method(cls, method);
                    assertTrue(t instanceof AbstractDataProviderType, sprintf("%s::%s()", cls, method));
                    assertTrue(t.getName().val(), sprintf("%s::%s() has a name", cls, method));
                    assertTrue(t == call_static_method(cls, method), sprintf("%s::%s() is built once", cls, method));
                }
            }
        }
    }

    sandboxedFirstUseTest() {
        # the sandbox denies the filesystem, where the vendored API descriptions are read from
        SandboxManager sm();
        sm.setFilesystemDefaultPolicy(False);
        Program p(PO_NEW_STYLE | PO_NO_CHILD_PO_RESTRICTIONS, True);
        map p.loadModule($1), keys Classes;
        p.parse("auto sub get(string cls, string method) { return call_static_method(cls, method); }\n",
            "sandboxed-first-use");
        p.setSandboxManager(sm);
        list<string> calls = ();
        foreach hash<auto> i in (Classes.pairIterator()) {
            foreach string cls in (i.value) {
                calls += map cls + "::" + $1, ("requestType", "responseType");
            }
        }
        calls += map $1 + "::instance", JinaShared;
        hash<string, object> types = {};
        foreach string call in (calls) {
            (*string cls, *string method) = (call =~ x/^(.*)::([^:]+)$/);
            try {
                types{call} = p.callFunction("get", cls, method);
            } catch (hash<ExceptionInfo> ex) {
                assertEq("", sprintf("%s: %s", ex.err, ex.desc), call);
            }
        }
        # the types are shared: trusted callers get the same ones
        foreach hash<auto> i in (types.pairIterator()) {
            (*string cls, *string method) = (i.key =~ x/^(.*)::([^:]+)$/);
            assertTrue(i.value == call_static_method(cls, method), i.key + " is shared");
        }
        assertEq(calls.size(), types.size());
    }

    assemblyAiTest() {
        assertEq("AssemblyAI Transcription Request",
            call_static_method("AssemblyAiDataProvider::AssemblyAiTranscribeDataProvider", "requestType").getName());
        assertTrue(call_static_method("AssemblyAiDataProvider::AssemblyAiTranscribeDataProvider", "responseType")
            instanceof AbstractDataProviderType);
    }

    jinaTest() {
        foreach string cls in (JinaShared) {
            auto t = call_static_method(cls, "instance");
            assertTrue(t instanceof AbstractDataProviderType, cls);
            assertTrue(t == call_static_method(cls, "instance"), cls + " is built once");
        }
        # the record body is the embedding response type that the provider returns
        assertEq(call_static_method("JinaDataProvider::JinaEmbeddingDataProvider", "responseType").getName(),
            call_static_method("JinaDataProvider::JinaBatchRecordResponseDataType", "instance").getFields().body
                .getType().getMandatoryType().getName());
    }

    #! Calls a type accessor once every thread is ready; runs in a thread of the test
    private static callAccessor(string cls, string method, Counter ready, Counter go, Counter done, Queue results) {
        on_exit done.dec();
        try {
            ready.dec();
            go.waitForZero();
            results.push(call_static_method(cls, method));
        } catch (hash<ExceptionInfo> ex) {
            results.push(ex);
        }
    }
}
