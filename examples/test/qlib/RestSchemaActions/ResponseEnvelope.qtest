#!/usr/bin/env qore
# Copyright 2026 Qore Technologies, s.r.o. SPDX-License-Identifier: MIT
%modern
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires RestSchemaActions
%requires json
%exec-class EnvelopeTest

class EnvelopeClient inherits RestClientIo::RestClientIo {
    public { auto body; }
    constructor() : RestClientIo({"url": "https://fixture.example"}) {}
    hash<RestClient::RestResponseInfo> restDoRawRequest(string method, string path, *data data, *hash<auto> headers) {
        return <RestClient::RestResponseInfo>{"status_code": 202, "body": body,
            "headers": {"operation-location": "/jobs/1", "retry-after": "2"}};
    }
}
class EnvelopeTest inherits QUnit::Test {
    constructor() : Test("REST schema response envelopes", "1.0") {
        addTestCase("accepted responses retain status and headers with and without a body", \envelopes());
        addTestCase("nested response direction survives copies without mutating requests", \responseDirection());
        addTestCase("response snapshots preserve shared descendants in a deep type graph", \sharedGraph());
        set_return_value(main());
    }
    private envelopes() {
        foreach bool with_body in (False, True) {
            hash<auto!> response = {"description": "Accepted"};
            if (with_body) { response.content = {"application/json": {"schema": {}}}; }
            OpenApi3::OpenApi3Schema schema = OpenApi3::OpenApi3Loader::fromString(make_json({
                "openapi": "3.1.0", "info": {"title": "Jobs", "version": "1"},
                "paths": {"/jobs": {"post": {"responses": {"202": response}}}},
            }), True);
            assertFalse(schema.hasDirectionalProperties());
            hash<RestSchemaActionInfo> manifest = <RestSchemaActionInfo>{"action": "start", "method": "POST", "path": "/jobs",
                "display_name": "Start", "short_desc": "Start a job", "desc": "Start a job.", "response_envelope": True};
            RestSchemaActionSet actions(schema, (manifest,));
            RestSchemaActionOperation op = actions.getOperationEx("start");
            EnvelopeClient client();
            RestSchemaActionDataProvider provider(actions, op, client);
            foreach auto value in (with_body ? (NOTHING, NULL, {}, (), False, 0, "") : (NOTHING,)) {
                client.body = value;
                hash<auto> result = provider.doRequest({});
                assertEq(202, result.status_code);
                assertEq("/jobs/1", result.headers."operation-location");
                assertEq("2", result.headers."retry-after");
                assertEq(value, result.body);
            }
            AbstractDataProviderType restored = Serializable::deserialize(op.getResponseType().serialize());
            restored = Serializable::deserialize(restored.serialize());
            assertEq(("status_code", "headers", "body"), keys restored.getFields());
        }
    }

    private responseDirection() {
        hash<auto> record = {"type": "object", "required": ("secret",), "properties": {
            "id": {"type": "string", "readOnly": True}, "secret": {"type": "string", "writeOnly": True}}};
        OpenApi3::OpenApi3Schema schema = OpenApi3::OpenApi3Loader::fromString(make_json({
            "openapi": "3.0.3", "info": {"title": "Direction", "version": "1"}, "paths": {},
            "components": {"schemas": {"Record": record, "Outer": {"type": "object", "properties": {
                "direct": {"$ref": "#/components/schemas/Record"},
                "records": {"type": "array", "items": {"$ref": "#/components/schemas/Record"}},
                "map": {"type": "object", "additionalProperties": {"$ref": "#/components/schemas/Record"}},
                "union": {"oneOf": ({"$ref": "#/components/schemas/Record"}, {"type": "integer"})},
            }}}},
        }), True);
        assertTrue(schema.hasDirectionalProperties());
        AbstractDataProviderType request_type = schema.getTypeForReference("Outer");
        AbstractDataProviderType response_type = OpenApi3::OpenApi3HashDataType::forResponse(request_type);
        hash<auto> response = {"direct": {"id": "r"}, "records": ({"id": "r"},),
            "map": {"value": {"id": "r"}}, "union": {"id": "r"}};
        hash<auto> request = {"direct": {"secret": "s"}, "records": ({"secret": "s"},),
            "map": {"value": {"secret": "s"}}, "union": {"secret": "s"}};
        for (int round = 0; round < 3; ++round) {
            assertEq(response, response_type.acceptsValue(response));
            assertEq(request, request_type.acceptsValue(request));
            assertThrows("RUNTIME-TYPE-ERROR", sub () {
                response_type.acceptsValue({"direct": {"secret": "s"}});
            });
            response_type = Serializable::deserialize(response_type.serialize());
        }
        assertEq(response, response_type.getSoftType().acceptsValue(response));
        assertEq(response, response_type.getOrNothingType().acceptsValue(response));
    }

    private sharedGraph() {
        HashDataType current("leaf");
        for (int i = 0; i < 25; ++i) {
            HashDataType next("node-" + i);
            next.addField(new QoreDataField("left", "Left", current));
            next.addField(new QoreDataField("right", "Right", current));
            current = next;
        }
        AbstractDataProviderType snapshot = OpenApi3::OpenApi3HashDataType::forResponse(current);
        assertNeq(current.uniqueHash(), snapshot.uniqueHash());
        for (int i = 0; i < 25; ++i) {
            hash<string, AbstractDataField> fields = snapshot.getFields();
            assertEq(fields.left.getType().uniqueHash(), fields.right.getType().uniqueHash());
            snapshot = fields.left.getType();
        }
    }
}
