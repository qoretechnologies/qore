%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires DataProvider
%requires RestSchemaActions
%requires RestClientIo

%requires json

%exec-class RestSchemaActionSetTest

#! A recorded outgoing request
hashdecl RecordedRequest {
    string method;
    string path;
    auto body;
    *hash<auto> headers;
}

#! A REST client that records requests instead of making them
/** Responses come from a queue so that a flow needing more than one call -- populating a dropdown and
    then making the call that uses it -- can be driven exactly as the service would drive it.
*/
class FakeRestClient inherits RestClientIo::RestClientIo {
    public {
        #! Every request made, in order
        list<hash<RecordedRequest>> requests = ();

        #! Queued responses, consumed in order
        list<hash<auto>> responses = ();

        #! Used when the response queue is empty
        hash<auto> default_response = {"body": {}, "headers": {}};
    }

    constructor() : RestClientIo({"url": "http://widget.example.com/api"}) {
    }

    push_response(hash<auto> resp) {
        push responses, resp;
    }

    reset() {
        requests = ();
        responses = ();
    }

    hash<RecordedRequest> last() {
        if (!requests) {
            throw "TEST-ERROR", "no requests were recorded";
        }
        return requests[requests.size() - 1];
    }

    hash<RestClient::RestResponseInfo> restDoRawRequest(string method, string path, *data body,
            *hash<auto> hdr) {
        push requests, <RecordedRequest>{
            "method": method,
            "path": path,
            "body": body,
            "headers": hdr,
        };
        hash<auto> resp = responses ? shift responses : default_response;
        if (resp.throw_status) {
            throw "REST-RESPONSE-ERROR", sprintf("HTTP %d response received", resp.throw_status),
                <RestClient::RestResponseInfo>{
                    "status_code": resp.throw_status,
                    "headers": resp.headers ?? {},
                    "body": resp.body,
                    "request_path": path,
                };
        }
        return <RestClient::RestResponseInfo>{
            "status_code": resp.status_code ?? 200,
            "body": resp.body,
            "headers": resp.headers ?? {},
        };
    }
}

public class RestSchemaActionSetTest inherits QUnit::Test {
    public {
        #! The fixture schema
        const SchemaFile = get_script_dir() + DirSep + "widget-store.json";

        #! Reference data: widget categories, listed by the "list-categories" action
        const RefData = {
            "category": <RestSchemaReferenceDataInfo>{
                "name": "category",
                "action": "list-categories",
                "records_path": "data",
                "value_field": "id",
                "display_field": "label",
                "desc": "widget categories",
            },
        };

        #! Reference data scoped by a value the calling action supplies
        /** Most identifiers are not global: a widget belongs to a category, so listing widgets without
            one would offer values from a scope the user did not choose.
        */
        const ScopedRefData = {
            "widget": <RestSchemaReferenceDataInfo>{
                "name": "widget",
                "action": "list-widgets",
                "options": {"limit": 100},
                "options_from": {"category": "category"},
                "records_path": "data",
                "value_field": "id",
                "display_field": "name",
                "desc": "widgets in the chosen category",
            },
        };
    }

    private {
        OpenApi3Schema schema;
    }

    constructor() : Test("RestSchemaActionSetTest", "1.0") {
        schema = OpenApi3::OpenApi3Loader::fromFile(SchemaFile);

        addTestCase("parameterless operation", \parameterlessTest());
        addTestCase("path and query flattening", \pathQueryTest());
        addTestCase("body flattening", \bodyFlatteningTest());
        addTestCase("body root", \bodyRootTest());
        addTestCase("optional body relaxes requiredness", \optionalBodyTest());
        addTestCase("no output type", \noOutputTypeTest());
        addTestCase("ambiguous output contract", \ambiguousResponseTest());
        addTestCase("response unwrapping", \responseUnwrapTest());
        addTestCase("collision detection", \collisionTest());
        addTestCase("round trip", \roundTripTest());
        addTestCase("wire codecs", \codecTest());
        addTestCase("overlay presentation", \overlayTest());
        addTestCase("overlay errors", \overlayErrorTest());
        addTestCase("manifest errors", \manifestErrorTest());
        addTestCase("narrowed operation variants", \variantTest());
        addTestCase("operation id drift", \driftTest());
        addTestCase("reference data", \referenceDataTest());
        addTestCase("scoped reference data", \scopedReferenceDataTest());
        addTestCase("nested reference data fields", \nestedReferenceDataTest());
        addTestCase("a value that follows another option", \valueFromTest());
        addTestCase("action registration", \actionRegistrationTest());
        addTestCase("action mutation effects", \actionMutationEffectTest());
        addTestCase("provider execution", \providerExecutionTest());
        addTestCase("provider paths", \providerPathTest());
        addTestCase("a header the connection owns", \connectionHeaderTest());
        addTestCase("schema drift", \driftReportTest());
        addTestCase("a body lifted out of an envelope", \requestUnwrapTest());
        addTestCase("a grouping object published as options", \liftTest());
        addTestCase("a response envelope merged into what carries it", \mergeTest());

        set_return_value(main());
    }

    #! Returns a manifest entry with the required descriptive fields filled in
    private hash<RestSchemaActionInfo> entry(string action, string method, string path, *hash<auto> extra) {
        hash<auto> h = {
            "action": action,
            "method": method,
            "path": path,
            "display_name": action,
            "short_desc": action + " short",
            "desc": action + " description",
        } + extra;
        return cast<hash<RestSchemaActionInfo>>(h);
    }

    #! Returns an action set built from the given manifest entries
    private RestSchemaActionSet makeSet(list<hash<RestSchemaActionInfo>> manifest,
            *hash<string, hash<RestSchemaReferenceDataInfo>> refdata) {
        return new RestSchemaActionSet(schema, manifest, refdata);
    }

    #! Returns a single operation built from one manifest entry
    private RestSchemaActionOperation makeOp(hash<RestSchemaActionInfo> info) {
        return new RestSchemaActionOperation(schema, info);
    }

    parameterlessTest() {
        RestSchemaActionOperation op = makeOp(entry("get-status", "GET", "/status"));
        # an operation with no parameters and no body must produce an action with no options at all,
        # rather than an empty transport envelope
        assertNothing(op.getRequestType());
        assertNothing(op.getRequestFields());
        assertEq({}, op.getFlatMap());
        assertEq("200", op.getResponseCode());
        assertEq(("status", "version"), keys op.getResponseType().getFields());
        # unflattening nothing must still produce a usable (empty) request
        hash<auto> wire = op.unflatten();
        assertEq({}, wire.req);
        assertEq({}, wire.path_vars);
    }

    pathQueryTest() {
        RestSchemaActionOperation op = makeOp(entry("get-widget", "GET", "/widgets/{widget_id}"));
        *hash<string, AbstractDataField> fields = op.getRequestFields();
        # path variables come first: they identify the object the action acts on
        assertEq(("widget_id", "expand"), keys fields);

        # a path variable is part of the URI, so it is always required and always visible
        assertTrue(fields.widget_id.getType().isMandatory());
        assertTrue(fields.widget_id.getAttributes().required);
        assertTrue(fields.widget_id.getAttributes().preselected);
        assertEq("the ID of the widget", fields.widget_id.getShortDescription());

        assertFalse(fields.expand.getType().isMandatory());
        assertEq(NOTHING, fields.expand.getAttributes().required);

        hash<string, hash<RestSchemaFlatFieldInfo>> flat = op.getFlatMap();
        assertEq(RSAL_PATH, flat.widget_id.loc);
        assertEq("widget_id", flat.widget_id.wire_name);
        assertEq(RSAL_QUERY, flat.expand.loc);

        hash<auto> wire = op.unflatten({"widget_id": "w_1", "expand": ("dimensions",)});
        assertEq({"widget_id": "w_1"}, wire.path_vars);
        assertEq({"query": {"expand": ("dimensions",)}}, wire.req);

        # a missing path variable would produce a request against a URI still containing "{widget_id}"
        assertThrows("REST-SCHEMA-ACTION-ERROR", "missing a value for URI path variable",
            \op.unflatten(), {"expand": ("dimensions",)});
        # an option the action does not declare must be reported, not silently dropped
        assertThrows("REST-SCHEMA-ACTION-ERROR", "has no option", \op.unflatten(),
            {"widget_id": "w_1", "bogus": 1});
    }

    bodyFlatteningTest() {
        RestSchemaActionOperation op = makeOp(entry("create-widget", "POST", "/widgets"));
        *hash<string, AbstractDataField> fields = op.getRequestFields();
        assertEq(("name", "category", "status", "created", "homepage", "dimensions", "tags"), keys fields);

        # the transport envelope must be gone
        assertEq(NOTHING, fields.body);
        # the body is required, so its required property stays required
        assertTrue(fields.name.getType().isMandatory());
        assertTrue(fields.name.getAttributes().required);
        assertFalse(fields.category.getType().isMandatory());

        # a meaningful nested domain object is preserved, not flattened away
        assertEq(NT_HASH, fields.dimensions.getType().getBaseTypeCode());
        assertEq(("width", "height", "measured"), keys fields.dimensions.getType().getFields());
        # enums survive flattening
        assertEq(("draft", "active", "retired"), (map $1.value, fields.status.getAllowedValues()));

        map assertEq(RSAL_BODY, $1.loc), op.getFlatMap().values();

        hash<auto> wire = op.unflatten({"name": "gizmo", "tags": ("a",)});
        assertEq({"body": {"name": "gizmo", "tags": ("a",)}}, wire.req);
        assertEq({}, wire.path_vars);
    }

    bodyRootTest() {
        # an array body has no properties to lift, so the whole body is presented as one option
        RestSchemaActionOperation op = makeOp(entry("create-widgets", "POST", "/widgets/bulk"));
        *hash<string, AbstractDataField> fields = op.getRequestFields();
        assertEq(("body",), keys fields);
        assertEq(RSAL_BODY_ROOT, op.getFlatMap().body.loc);
        assertEq(NT_LIST, fields.body.getType().getBaseTypeCode());

        list<auto> payload = ({"name": "a"}, {"name": "b"});
        hash<auto> wire = op.unflatten({"body": payload});
        assertEq({"body": payload}, wire.req);
        assertEq({"body": payload}, op.flatten(wire));
    }

    optionalBodyTest() {
        # /widgets/{widget_id}/archive has an optional body; its properties therefore cannot be required
        # at the action level, because omitting the body entirely is a valid request
        RestSchemaActionOperation op = makeOp(entry("archive-widget", "POST", "/widgets/{widget_id}/archive", {
            "fields": {"body.widget_id": <RestSchemaFieldOverlayInfo>{"name": "archive_id"}},
        }));
        *hash<string, AbstractDataField> fields = op.getRequestFields();
        assertFalse(fields.reason.getType().isMandatory());
        # no body option supplied => no body is sent at all
        hash<auto> wire = op.unflatten({"widget_id": "w_1"});
        assertEq(NOTHING, wire.req.body);
        assertEq({"widget_id": "w_1"}, wire.path_vars);
    }

    noOutputTypeTest() {
        # a 204 declares no body, so the action has no output type rather than an empty one
        RestSchemaActionOperation op = makeOp(entry("delete-widget", "DELETE", "/widgets/{widget_id}"));
        assertNothing(op.getResponseType());
        assertNothing(op.getResponseCode());
        assertEq(("widget_id",), keys op.getRequestFields());
    }

    ambiguousResponseTest() {
        # PUT declares both 200 and 201 with a body: registration must refuse to guess
        assertThrows("REST-SCHEMA-ACTION-ERROR", "declares 2 success responses with a body",
            \makeOp(), entry("put-widget", "PUT", "/widgets/{widget_id}"));

        # ... and accept an explicit selection
        RestSchemaActionOperation op = makeOp(entry("put-widget", "PUT", "/widgets/{widget_id}", {
            "response_code": "201",
        }));
        assertEq("201", op.getResponseCode());
        assertEq("widget", op.getResponseType().getName());

        # a selection that names a response the operation does not declare is an error
        assertThrows("REST-SCHEMA-ACTION-ERROR", "which the operation does not declare", \makeOp(),
            entry("put-widget", "PUT", "/widgets/{widget_id}", {"response_code": "203"}));
        # ... as is one that declares no body
        assertThrows("REST-SCHEMA-ACTION-ERROR", "declares no response body", \makeOp(),
            entry("delete-widget", "DELETE", "/widgets/{widget_id}", {"response_code": "204"}));
    }

    responseUnwrapTest() {
        RestSchemaActionOperation op = makeOp(entry("list-widgets", "GET", "/widgets", {
            "response_unwrap": ("data",),
        }));
        # the output type is the list of widgets, not the envelope carrying it
        assertEq(NT_LIST, op.getResponseType().getBaseTypeCode());
        assertEq(("id", "name", "category", "created", "homepage", "dimensions", "tags"),
            keys op.getResponseType().getElementType().getFields());
        assertEq(({"id": "w_1"},), op.processResponse({"data": ({"id": "w_1"},), "has_more": False}));

        # unwrapping a field the response does not have must fail at registration, not at runtime
        assertThrows("REST-SCHEMA-ACTION-ERROR", "the response type", \makeOp(),
            entry("list-widgets", "GET", "/widgets", {"response_unwrap": ("nope",)}));
    }

    collisionTest() {
        # the archive operation declares a body property with the same name as the path variable
        assertThrows("REST-SCHEMA-ACTION-ERROR", "is produced by both the path and the body value",
            \makeOp(), entry("archive-widget", "POST", "/widgets/{widget_id}/archive"));

        # a location-qualified overlay key resolves it without touching the wire contract
        RestSchemaActionOperation op = makeOp(entry("archive-widget", "POST", "/widgets/{widget_id}/archive", {
            "fields": {
                "body.widget_id": <RestSchemaFieldOverlayInfo>{
                    "name": "archive_id",
                    "display_name": "Archive ID",
                },
            },
        }));
        assertEq(("widget_id", "archive_id", "reason"), keys op.getRequestFields());
        assertEq("Archive ID", op.getRequestFields().archive_id.getDisplayName());
        # the renamed option still travels under its original wire name
        hash<string, hash<RestSchemaFlatFieldInfo>> flat = op.getFlatMap();
        assertEq(RSAL_BODY, flat.archive_id.loc);
        assertEq("widget_id", flat.archive_id.wire_name);
        assertEq(RSAL_PATH, flat.widget_id.loc);

        hash<auto> wire = op.unflatten({"widget_id": "w_1", "archive_id": "arch_9", "reason": "old"});
        assertEq({"widget_id": "w_1"}, wire.path_vars);
        assertEq({"widget_id": "arch_9", "reason": "old"}, wire.req.body);
    }

    roundTripTest() {
        RestSchemaActionOperation op = makeOp(entry("create-widget", "POST", "/widgets", {
            "fields": {
                "created": <RestSchemaFieldOverlayInfo>{"codec": RestSchemaActionCodecs::UnixSeconds},
                "dimensions": <RestSchemaFieldOverlayInfo>{
                    "fields": {
                        "measured": <RestSchemaFieldOverlayInfo>{"codec": RestSchemaActionCodecs::UnixSeconds},
                    },
                },
            },
        }));
        hash<auto> options = {
            "name": "gizmo",
            "category": "tools",
            "status": "active",
            "created": 2024-03-01T12:00:00Z,
            "dimensions": {"width": 10.5, "height": 2.25, "measured": 2024-02-01T00:00:00Z},
            "tags": ("a", "b"),
        };
        hash<auto> wire = op.unflatten(options);
        # every value has to survive the trip out and back, at every depth
        assertEq(options, op.flatten(wire));

        # the same has to hold for an operation whose values are spread over three locations
        RestSchemaActionOperation gw = makeOp(entry("get-widget", "GET", "/widgets/{widget_id}"));
        hash<auto> gopts = {"widget_id": "w_1", "expand": ("dimensions", "tags")};
        assertEq(gopts, gw.flatten(gw.unflatten(gopts)));

        RestSchemaActionOperation lw = makeOp(entry("list-widgets", "GET", "/widgets"));
        hash<auto> lopts = {"limit": 10, "category": "tools", "X-Request-Id": "req-1"};
        hash<auto> lwire = lw.unflatten(lopts);
        # the header must travel as a header and the query arguments as query arguments
        assertEq({"X-Request-Id": "req-1"}, lwire.req.header);
        assertEq({"limit": 10, "category": "tools"}, lwire.req.query);
        assertEq(lopts, lw.flatten(lwire));

        # a value the action does not declare must be reported when rebuilding options
        assertThrows("REST-SCHEMA-ACTION-ERROR", "does not declare a query value named", \lw.flatten(),
            {"req": {"query": {"nope": 1}}});
    }

    codecTest() {
        # Stripe-style Unix seconds: the defect this codec exists to prevent is presenting a seconds
        # value as milliseconds, which is off by a factor of 1000
        hash<RestSchemaWireCodecInfo> secs = RestSchemaActionCodecs::getCodecEx(RestSchemaActionCodecs::UnixSeconds);
        assertEq(1709294400, secs.to_wire(2024-03-01T12:00:00Z));
        assertEq(2024-03-01T12:00:00Z, secs.from_wire(1709294400));
        assertNothing(secs.to_wire(NOTHING));
        assertNothing(secs.from_wire(NOTHING));

        hash<RestSchemaWireCodecInfo> ms = RestSchemaActionCodecs::getCodecEx(RestSchemaActionCodecs::UnixMilliseconds);
        assertEq(1709294400500, ms.to_wire(2024-03-01T12:00:00.500Z));
        assertEq(2024-03-01T12:00:00.500Z, ms.from_wire(1709294400500));
        # a negative millisecond value must floor towards -infinity so the remainder stays non-negative
        assertEq(1969-12-31T23:59:58.500Z, ms.from_wire(-1500));
        assertEq(-1500, ms.to_wire(1969-12-31T23:59:58.500Z));

        hash<RestSchemaWireCodecInfo> iso = RestSchemaActionCodecs::getCodecEx(RestSchemaActionCodecs::Iso8601Utc);
        # a "Z" in a date format string writes the UTC offset, so the designator has to be literal
        assertEq("2024-03-01T12:00:00Z", iso.to_wire(2024-03-01T13:00:00+01:00));
        assertEq(2024-03-01T12:00:00Z, iso.from_wire("2024-03-01T12:00:00Z"));

        assertThrows("REST-SCHEMA-CODEC-ERROR", "is unknown", \RestSchemaActionCodecs::getCodecEx(), "nope");
        assertThrows("REST-SCHEMA-CODEC-ERROR", "empty name", \RestSchemaActionCodecs::registerCodec(),
            <RestSchemaWireCodecInfo>{
                "name": "",
                "type": AbstractDataProviderTypeMap."*string",
                "to_wire": auto sub (auto v) { return v; },
                "from_wire": auto sub (auto v) { return v; },
            });

        # a codec replaces the presented type and documents the conversion where it will be read
        RestSchemaActionOperation op = makeOp(entry("create-widget", "POST", "/widgets", {
            "fields": {"created": <RestSchemaFieldOverlayInfo>{"codec": RestSchemaActionCodecs::UnixSeconds}},
        }));
        AbstractDataField f = op.getRequestFields().created;
        assertEq(NT_DATE, f.getType().getBaseTypeCode());
        assertRegex("seconds since 1970-01-01Z", f.getDescription());
        assertEq(RestSchemaActionCodecs::UnixSeconds, op.getFlatMap().created.codec);
        assertEq({"body": {"created": 1709294400}}, op.unflatten({"created": 2024-03-01T12:00:00Z}).req);

        # a codec applies to response values too
        RestSchemaActionOperation gw = makeOp(entry("get-widget", "GET", "/widgets/{widget_id}", {
            "response_fields": {"created": <RestSchemaFieldOverlayInfo>{
                "codec": RestSchemaActionCodecs::UnixSeconds,
            }},
        }));
        assertEq(NT_DATE, gw.getResponseType().getFields().created.getType().getBaseTypeCode());
        assertEq({"id": "w_1", "created": 2024-03-01T12:00:00Z},
            gw.processResponse({"id": "w_1", "created": 1709294400}));
    }

    overlayTest() {
        RestSchemaActionOperation op = makeOp(entry("create-widget", "POST", "/widgets", {
            "field_order": ("name", "category", "tags"),
            "fields": {
                "category": <RestSchemaFieldOverlayInfo>{
                    "display_name": "Widget Category",
                    "short_desc": "The category to file the widget under",
                    "desc": "Pick a **category**",
                    "preselected": True,
                    "ref_data": "category",
                    "example_value": "tools",
                },
                "homepage": <RestSchemaFieldOverlayInfo>{
                    "type": AbstractDataProviderTypeMap."*uri",
                },
                "status": <RestSchemaFieldOverlayInfo>{
                    "required": True,
                    "default_value": "draft",
                },
                "tags": <RestSchemaFieldOverlayInfo>{
                    "required_groups": ("identity",),
                    "depends_on": ("name",),
                },
                "dimensions": <RestSchemaFieldOverlayInfo>{"ignore": True},
            },
        }), );

        *hash<string, AbstractDataField> fields = op.getRequestFields();
        # ordering: named fields first in the order given, then the rest in derived order
        assertEq(("name", "category", "tags", "status", "created", "homepage"), keys fields);
        # an ignored field is gone from both the form and the reverse map
        assertEq(NOTHING, fields.dimensions);
        assertEq(NOTHING, op.getFlatMap().dimensions);

        assertEq("Widget Category", fields.category.getDisplayName());
        assertEq("The category to file the widget under", fields.category.getShortDescription());
        assertEq("Pick a **category**", fields.category.getDescription());
        assertEq("category", fields.category.getAttributes().ref_data);
        assertTrue(fields.category.getAttributes().preselected);

        # requiredness may be narrowed, and narrowing must reach both the type and the attributes
        assertTrue(fields.status.getType().isMandatory());
        assertTrue(fields.status.getAttributes().required);
        assertTrue(fields.status.getAttributes().preselected);
        assertEq("draft", fields.status.getDefaultValue());

        assertEq("*uri", fields.homepage.getType().getName());
        assertEq(("identity",), fields.tags.getAttributes().required_groups);
        assertEq(("name",), fields.tags.getAttributes().depends_on);

        # renaming a field must not disturb the others, and the original schema field must be untouched
        AbstractDataField orig = schema.getFieldFromSchema("category", NOTHING,
            cast<OpenApi3Schema>(schema).components.schemas.widget_create.properties.category, False);
        assertEq("category", orig.getDisplayName() == "Widget Category" ? "mutated" : "category");
    }

    overlayErrorTest() {
        # an overlay entry that no longer names anything must fail, so an upstream rename cannot silently
        # drop a deliberate presentation choice
        assertThrows("REST-SCHEMA-ACTION-ERROR", "does not name any value the operation declares",
            \makeOp(), entry("create-widget", "POST", "/widgets", {
                "fields": {"gone": <RestSchemaFieldOverlayInfo>{"display_name": "Gone"}},
            }));

        # an action may present a narrower contract than the API, never a wider one
        assertThrows("REST-SCHEMA-ACTION-ERROR", "never a wider one", \makeOp(),
            entry("create-widget", "POST", "/widgets", {
                "fields": {"name": <RestSchemaFieldOverlayInfo>{"required": False}},
            }));

        # field_order must name real options
        assertThrows("REST-SCHEMA-ACTION-ERROR", "which the action does not have", \makeOp(),
            entry("create-widget", "POST", "/widgets", {"field_order": ("nope",)}));
        assertThrows("REST-SCHEMA-ACTION-ERROR", "more than once", \makeOp(),
            entry("create-widget", "POST", "/widgets", {"field_order": ("name", "name")}));

        # nested overlays must name real fields
        assertThrows("REST-SCHEMA-ACTION-ERROR", "does not name a field of", \makeOp(),
            entry("create-widget", "POST", "/widgets", {
                "fields": {"dimensions": <RestSchemaFieldOverlayInfo>{
                    "fields": {"depth": <RestSchemaFieldOverlayInfo>{"display_name": "Depth"}},
                }},
            }));

        # a nested rename would lose the wire name, so it is refused rather than silently ignored
        assertThrows("REST-SCHEMA-ACTION-ERROR", "nested fields cannot be renamed", \makeOp(),
            entry("create-widget", "POST", "/widgets", {
                "fields": {"dimensions": <RestSchemaFieldOverlayInfo>{
                    "fields": {"width": <RestSchemaFieldOverlayInfo>{"name": "w"}},
                }},
            }));

        # overriding fields of a type that has none is a mistake worth reporting
        assertThrows("REST-SCHEMA-ACTION-ERROR", "has no fields", \makeOp(),
            entry("create-widget", "POST", "/widgets", {
                "fields": {"name": <RestSchemaFieldOverlayInfo>{
                    "fields": {"x": <RestSchemaFieldOverlayInfo>{"display_name": "X"}},
                }},
            }));

        # an unknown codec must fail at registration
        assertThrows("REST-SCHEMA-CODEC-ERROR", "is unknown", \makeOp(),
            entry("create-widget", "POST", "/widgets", {
                "fields": {"created": <RestSchemaFieldOverlayInfo>{"codec": "no-such-codec"}},
            }));
    }

    manifestErrorTest() {
        assertThrows("REST-SCHEMA-ACTION-ERROR", "is not declared in the schema", \makeOp(),
            entry("nope", "GET", "/nope"));
        assertThrows("REST-SCHEMA-ACTION-ERROR", "declares no \"PATCH\" operation", \makeOp(),
            entry("patch-widget", "PATCH", "/widgets/{widget_id}"));

        assertThrows("REST-SCHEMA-ACTION-ERROR", "declared more than once in the manifest", \makeSet(), (
            (entry("get-status", "GET", "/status"), entry("get-status", "GET", "/categories")),
        ));
        assertThrows("REST-SCHEMA-ACTION-ERROR", "is exported twice", \makeSet(), (
            (entry("a", "GET", "/status"), entry("b", "GET", "/status")),
        ));
    }

    variantTest() {
        # a second action on the same operation is allowed when it says it is a deliberately narrowed
        # variant, so that an application can export both a general action and a one-job version of it
        RestSchemaActionSet aset = makeSet((
            entry("update-widget", "POST", "/widgets"),
            entry("archive-widget", "POST", "/widgets", {"variant_of": "update-widget"}),
        ));
        assertEq(("update-widget", "archive-widget"), aset.getActionNames());
        assertEq("POST", aset.getOperationEx("archive-widget").getMethod());
        assertEq("/widgets", aset.getOperationEx("archive-widget").getPath());

        # the guard still catches the accident it exists for, and says how to declare the exception
        assertThrows("REST-SCHEMA-ACTION-ERROR", "variant_of", \makeSet(), (
            (entry("update-widget", "POST", "/widgets"), entry("archive-widget", "POST", "/widgets")),
        ));

        # a variant of an action that does not exist is a typo, not an export
        assertThrows("REST-SCHEMA-ACTION-ERROR", "not declared before it in the manifest", \makeSet(), (
            (entry("update-widget", "POST", "/widgets"),
                entry("archive-widget", "POST", "/widgets", {"variant_of": "no-such-action"})),
        ));

        # naming a variant base declared later cannot work, because it has not been seen yet
        assertThrows("REST-SCHEMA-ACTION-ERROR", "not declared before it in the manifest", \makeSet(), (
            (entry("archive-widget", "POST", "/widgets", {"variant_of": "update-widget"}),
                entry("update-widget", "POST", "/widgets")),
        ));

        # the marker must not be usable to wave through an unrelated duplicate
        assertThrows("REST-SCHEMA-ACTION-ERROR", "a variant must narrow the same operation", \makeSet(), (
            (entry("get-status", "GET", "/status"),
                entry("list-categories", "GET", "/categories", {"variant_of": "get-status"})),
        ));
    }

    driftTest() {
        # the operationId locates an operation, but it is never action identity: a rename upstream has to
        # surface as drift rather than silently renaming an action existing workflows call
        RestSchemaActionOperation op = makeOp(entry("get-status", "GET", "/status", {
            "operation_id": "getStatus",
        }));
        assertEq("get-status", op.getAction());

        assertThrows("REST-SCHEMA-ACTION-ERROR", "this is upstream schema drift", \makeOp(),
            entry("get-status", "GET", "/status", {"operation_id": "getServiceStatus"}));
    }

    referenceDataTest() {
        list<hash<RestSchemaActionInfo>> manifest = (
            entry("list-categories", "GET", "/categories"),
            entry("create-widget", "POST", "/widgets", {
                "fields": {"category": <RestSchemaFieldOverlayInfo>{"ref_data": "category"}},
            }),
        );
        RestSchemaActionSet aset = makeSet(manifest, RefData);
        assertEq(("list-categories", "create-widget"), aset.getActionNames());

        # an overlay naming reference data the set does not declare would leave a dropdown silently empty
        assertThrows("REST-SCHEMA-ACTION-ERROR", "not declared in the reference data", \makeSet(),
            (manifest,));

        # reference data produced by an action the manifest does not export cannot work
        assertThrows("REST-SCHEMA-ACTION-ERROR", "which the manifest does not export", \makeSet(),
            (manifest, {"category": cast<hash<RestSchemaReferenceDataInfo>>(RefData.category + {"action": "list-things"})}));

        # a fixed option the listing action does not accept would fail only when a user opened the
        # dropdown, so it is checked when the set is built
        assertThrows("REST-SCHEMA-ACTION-ERROR", "which does not declare it", \makeSet(),
            (manifest, {"category": cast<hash<RestSchemaReferenceDataInfo>>(RefData.category + {"options": {"page_size": 5}})}));

        # ... and the declaration has to agree with the key it is registered under
        assertThrows("REST-SCHEMA-ACTION-ERROR", "names itself", \makeSet(),
            (manifest, {"cat": RefData.category}));
    }

    scopedReferenceDataTest() {
        list<hash<RestSchemaActionInfo>> manifest = (
            entry("list-widgets", "GET", "/widgets"),
            entry("create-widget", "POST", "/widgets", {
                "fields": {"tags": <RestSchemaFieldOverlayInfo>{
                    "element_ref_data": "widget",
                    "depends_on": ("category",),
                }},
            }),
        );
        RestSchemaActionSet aset = makeSet(manifest, ScopedRefData);
        assertEq(("list-widgets", "create-widget"), aset.getActionNames());

        FakeRestClient rest();
        RestSchemaActionSetDataProvider root(aset, rest);
        AbstractDataProvider create = root.getChildProviderEx("create-widget");

        # the value the dropdown is scoped by reaches the listing action
        rest.push_response({"body": {"data": ({"id": "w1", "name": "Hammer"},)}});
        *list<hash<AllowedValueInfo>> values = create.getReferenceData("widget", {"category": "tools"});
        assertEq(1, values.size());
        assertEq("w1", values[0].value);
        assertEq("Hammer", values[0].display_name);
        assertRegex("category=tools", rest.last().path);
        assertRegex("limit=100", rest.last().path, "fixed options are sent as well");

        # until it has one, the dropdown is empty rather than listing widgets from every category
        rest.reset();
        assertNothing(create.getReferenceData("widget", {}));
        assertNothing(create.getReferenceData("widget"));
        assertThrows("TEST-ERROR", "no requests were recorded", \rest.last());

        # the listing action has to declare the option a value is forwarded into
        assertThrows("REST-SCHEMA-ACTION-ERROR", "forwards a value into option", \makeSet(),
            (manifest, {"widget": cast<hash<RestSchemaReferenceDataInfo>>(ScopedRefData.widget
                + {"options_from": {"no_such_option": "category"}})}));

        # fixing an option and forwarding a value into it would let one silently win
        assertThrows("REST-SCHEMA-ACTION-ERROR", "both fixes option", \makeSet(),
            (manifest, {"widget": cast<hash<RestSchemaReferenceDataInfo>>(ScopedRefData.widget
                + {"options": {"category": "tools"}})}));

        # an action offering a dropdown scoped by a value it does not have would show an empty list and
        # no reason for it, so it is rejected when the set is built
        assertThrows("REST-SCHEMA-ACTION-ERROR", "could never be populated", \makeSet(), ((
            entry("list-widgets", "GET", "/widgets"),
            entry("get-widget", "GET", "/widgets/{widget_id}", {
                "fields": {"widget_id": <RestSchemaFieldOverlayInfo>{"ref_data": "widget"}},
            }),
        ), ScopedRefData));
    }

    nestedReferenceDataTest() {
        # a record that carries its identity below the top level: a Bitbucket workspace membership is
        # {user: {uuid, display_name}}, and a dropdown that could only read top-level fields would have
        # nothing to offer
        hash<string, hash<RestSchemaReferenceDataInfo>> refdata = {
            "category": <RestSchemaReferenceDataInfo>{
                "name": "category",
                "action": "list-categories",
                "records_path": "data",
                "value_field": "owner.id",
                "display_field": "owner.name",
                "desc": "categories by owner",
            },
        };
        RestSchemaActionSet aset = makeSet((
            entry("list-categories", "GET", "/categories"),
            entry("create-widget", "POST", "/widgets", {
                "fields": {"category": <RestSchemaFieldOverlayInfo>{"ref_data": "category"}},
            }),
        ), refdata);

        FakeRestClient rest();
        RestSchemaActionSetDataProvider root(aset, rest);
        AbstractDataProvider create = root.getChildProviderEx("create-widget");
        rest.push_response({"body": {"data": (
            {"owner": {"id": "u1", "name": "Ada"}},
            {"owner": {"id": "u2"}},
            {"owner": {"id": "u3", "name": "Grace"}},
            # a record that does not carry the path at all is skipped, not reported as an empty row
            {"other": {"id": "u4"}},
        )}});
        *list<hash<AllowedValueInfo>> values = create.getReferenceData("category");
        assertEq(3, values.size());
        assertEq("u1", values[0].value);
        assertEq("Ada", values[0].display_name);
        # a missing display falls back to the value, as it does for a top-level field
        assertEq("u2", values[1].display_name);
        assertEq("u3", values[2].value);
        assertEq("Grace", values[2].display_name);
    }

    valueFromTest() {
        # the shape of the real case: an API that wants the identity of the object being changed in both
        # the URL and the body, where the two must always be equal
        list<hash<RestSchemaActionInfo>> manifest = (
            entry("update-widget", "PUT", "/widgets/{widget_id}", {
                "response_code": "200",
                "fields": {
                    "body.name": <RestSchemaFieldOverlayInfo>{"value_from": "widget_id"},
                },
            }),
        );
        RestSchemaActionSet aset = makeSet(manifest);
        RestSchemaActionOperation op = aset.getOperationEx("update-widget");

        # the followed value is not something the user is asked for
        hash<string, AbstractDataField> fields = op.getRequestFields();
        assertTrue(exists fields.widget_id);
        assertNothing(fields.name, "a value that follows another option is not published as one");

        # ... but it is sent, carrying what the option it follows carries
        hash<auto> wire = op.unflatten({"widget_id": "w1"});
        assertEq({"widget_id": "w1"}, wire.path_vars);
        assertEq("w1", wire.req.body.name);

        # an unsupplied source sends nothing rather than an empty value
        RestSchemaActionSet oset = makeSet((
            entry("create-widget", "POST", "/widgets", {
                "fields": {
                    "status": <RestSchemaFieldOverlayInfo>{"value_from": "name"},
                },
            }),
        ));
        RestSchemaActionOperation oop = oset.getOperationEx("create-widget");
        assertNothing(oop.unflatten({}).req.body.status);
        assertEq("thing", oop.unflatten({"name": "thing"}).req.body.status);

        # following an option the action does not have could never be filled in
        assertThrows("REST-SCHEMA-ACTION-ERROR", "which this action does not declare", \makeSet(), ((
            entry("update-widget", "PUT", "/widgets/{widget_id}", {
                "response_code": "200",
                "fields": {
                    "body.name": <RestSchemaFieldOverlayInfo>{"value_from": "no_such_option"},
                },
            }),
        ),));
    }

    actionRegistrationTest() {
        RestSchemaActionSet aset = makeSet((
            entry("get-status", "GET", "/status"),
            entry("get-widget", "GET", "/widgets/{widget_id}", {"groups": ("Widgets",)}),
        ));
        list<hash<DataProviderActionInfo>> actions = aset.getActionInfoList("WidgetStore");
        assertEq(2, actions.size());

        hash<DataProviderActionInfo> status = actions[0];
        assertEq("WidgetStore", status.app);
        assertEq("get-status", status.action);
        assertEq("/get-status", status.path);
        assertEq(DPAT_API, status.action_code);
        # an action with no options must publish none, rather than an empty transport envelope
        assertEq(NOTHING, status.options);
        assertEq(("status", "version"), keys status.output_type.getFields());

        hash<DataProviderActionInfo> widget = actions[1];
        assertEq(("Widgets",), widget.groups);
        # options are generated after the overlay is applied, so requiredness reaches the option
        assertEq(("widget_id", "expand"), keys widget.options);
        assertTrue(widget.options.widget_id.required);
        assertTrue(widget.options.widget_id.preselected);
        assertFalse(widget.options.expand.required);
        assertEq("Widget Id", widget.options.widget_id.display_name);

        # values merged into every action definition
        list<hash<DataProviderActionInfo>> with_common = aset.getActionInfoList("WidgetStore", {
            "subtype": "widgets",
        });
        map assertEq("widgets", $1.subtype), with_common;
    }

    actionMutationEffectTest() {
        # Safe-method classification is based only on exact, normalized HTTP protocol tokens.  Action IDs and
        # translated presentation text are deliberately irrelevant.
        assertEq({"GET": True, "HEAD": True, "OPTIONS": True, "TRACE": True},
            RestSchemaReadOnlyHttpMethods);

        RestSchemaActionSet aset = makeSet((
            entry("importante-resumen", "get", "/status"),
            entry("sendvič-nabídka", "POST", "/widgets"),
        ));
        list<hash<DataProviderActionInfo>> actions = aset.getActionInfoList("WidgetStore");
        assertFalse(actions[0].mutates_state);
        assertFalse(DataProviderActionCatalog::actionMutatesState(actions[0]));
        assertTrue(actions[1].mutates_state);
        assertTrue(DataProviderActionCatalog::actionMutatesState(actions[1]));

        # Generic API actions without producer metadata fail closed, while exact record-read types remain
        # available independent of their identifiers or prose.
        hash<DataProviderActionInfo> unknown = actions[0];
        unknown.action = "restorelser";
        unknown.mutates_state = NOTHING;
        assertTrue(DataProviderActionCatalog::actionMutatesState(unknown));
        unknown.action_code = DPAT_FIND;
        assertFalse(DataProviderActionCatalog::actionMutatesState(unknown));
    }

    providerExecutionTest() {
        RestSchemaActionSet aset = makeSet((
            entry("get-widget", "GET", "/widgets/{widget_id}"),
            entry("create-widget", "POST", "/widgets", {
                "fields": {"created": <RestSchemaFieldOverlayInfo>{"codec": RestSchemaActionCodecs::UnixSeconds}},
            }),
            entry("list-widgets", "GET", "/widgets", {"response_unwrap": ("data",)}),
        ));
        FakeRestClient rest();
        RestSchemaActionSetDataProvider root(aset, rest);

        # a path variable must be substituted into the URI, and a query argument appended to it
        rest.push_response({"body": {"id": "w_1", "name": "gizmo"}});
        AbstractDataProvider get = root.getChildProviderEx("get-widget");
        auto resp = get.doRequest({"widget_id": "w_1", "expand": ("dimensions",)});
        # the action publishes the response body, not the HTTP envelope carrying it
        assertEq({"id": "w_1", "name": "gizmo"}, resp);
        assertEq("GET", rest.last().method);
        assertEq("/api/widgets/w_1?expand=dimensions", rest.last().path);

        # a form-encoded body must be serialized as the schema declares, with the codec applied
        rest.reset();
        rest.push_response({"body": {"id": "w_2", "name": "gadget"}});
        AbstractDataProvider create = root.getChildProviderEx("create-widget");
        create.doRequest({"name": "gadget", "created": 2024-03-01T12:00:00Z});
        assertEq("POST", rest.last().method);
        assertEq("/api/widgets", rest.last().path);
        assertEq(MimeTypeFormUrlEncoded, rest.last().headers."Content-Type");
        assertRegex("name=gadget", rest.last().body);
        assertRegex("created=1709294400", rest.last().body);

        # response unwrapping reaches the value the caller receives
        rest.reset();
        rest.push_response({"body": {"data": ({"id": "w_1"}, {"id": "w_2"}), "has_more": False}});
        assertEq(({"id": "w_1"}, {"id": "w_2"}), root.getChildProviderEx("list-widgets").doRequest());

        # an error response must reach the caller with its context intact
        rest.reset();
        rest.push_response({"throw_status": 404, "body": {"message": "no such widget"}});
        assertThrows("REST-RESPONSE-ERROR", "HTTP 404", \get.doRequest(), {"widget_id": "gone"});
    }

    connectionHeaderTest() {
        # A header the connection owns is dropped from the action, which is the point: nobody should be
        # asked for an API key or a tenant on every call.  The schema may still declare it required, so
        # the request is filled in from the client's own default headers when it is built.
        hash<auto> overlay = {
            "fields": {
                "X-Tenant-Id": <RestSchemaFieldOverlayInfo>{
                    "ignore": True,
                    "connection_option": "tenant_id",
                },
                "X-Request-Id": <RestSchemaFieldOverlayInfo>{"ignore": True},
            },
        };
        RestSchemaActionSet aset = makeSet((
            entry("get-tenant-status", "GET", "/tenant-status", overlay),
        ));
        RestSchemaActionOperation op = aset.getOperationEx("get-tenant-status");
        assertFalse(op.getRequestFields().hasKey("X-Tenant-Id"),
            "a connection-owned header is not an action option");
        assertFalse(op.getRequestFields().hasKey("X-Request-Id"));

        list<hash<RestSchemaConnectionHeaderInfo>> conn_hdrs = op.getConnectionHeaders();
        assertEq(2, conn_hdrs.size());
        assertEq("X-Tenant-Id", conn_hdrs[0].wire_name);
        assertTrue(conn_hdrs[0].required, "the schema still requires it, whoever supplies it");
        assertEq("tenant_id", conn_hdrs[0].connection_option);
        assertEq("X-Request-Id", conn_hdrs[1].wire_name);
        assertFalse(conn_hdrs[1].required);
        assertNothing(conn_hdrs[1].connection_option);

        # a connection that supplies the header sends it, however either side spells it
        FakeRestClient rest();
        rest.addDefaultHeaders({"x-tenant-id": "t-1"});
        RestSchemaActionSetDataProvider root(aset, rest);
        AbstractDataProvider status = root.getChildProviderEx("get-tenant-status");
        rest.push_response({"body": {"status": "ok"}});
        hash<auto> no_args = {};
        assertEq("ok", status.doRequest(no_args).status);
        assertEq("t-1", rest.last().headers{"X-Tenant-Id"},
            "the header travels under the name the schema declares, from the value the client holds");

        # ... and a connection that does not supply it says so, naming the option to set, rather than
        # failing as a schema type error about a header no action offers
        FakeRestClient bare();
        RestSchemaActionSetDataProvider bare_root(aset, bare);
        AbstractDataProvider bare_status = bare_root.getChildProviderEx("get-tenant-status");
        assertThrows("REST-CONNECTION-OPTION-ERROR", "set the \"tenant_id\" option on the connection",
            \bare_status.doRequest(), no_args);

        # the optional one is simply left out: an idempotency key no connection sets is not an error
        RestSchemaActionSet opt_only = makeSet((
            entry("get-tenant-status", "GET", "/tenant-status", {
                "fields": {"X-Request-Id": <RestSchemaFieldOverlayInfo>{"ignore": True}},
            }),
        ));
        FakeRestClient opt_rest();
        opt_rest.addDefaultHeaders({"X-Tenant-Id": "t-2"});
        RestSchemaActionSetDataProvider opt_root(opt_only, opt_rest);
        AbstractDataProvider opt_status = opt_root.getChildProviderEx("get-tenant-status");
        opt_rest.push_response({"body": {"status": "ok"}});
        opt_status.doRequest({"X-Tenant-Id": "t-2"});
        assertNothing(opt_rest.last().headers{"X-Request-Id"},
            "an optional header nobody supplies is left out rather than reported");
    }

    providerPathTest() {
        RestSchemaActionSet aset = makeSet((
            entry("list-categories", "GET", "/categories"),
            entry("create-widget", "POST", "/widgets", {
                "fields": {"category": <RestSchemaFieldOverlayInfo>{"ref_data": "category"}},
            }),
        ), RefData);

        FakeRestClient rest();
        RestSchemaActionSetDataProvider root(aset, rest);
        assertEq(("list-categories", "create-widget"), root.getChildProviderNames());
        # every registered action path has to resolve to a provider that can execute it
        aset.validateActionPaths(root);
        assertNothing(root.getChildProvider("nope"));

        # the dropdown is populated by executing the listing action and mapping its records
        AbstractDataProvider create = root.getChildProviderEx("create-widget");
        assertEq({"category": True}, create.getSupportedReferenceData());
        rest.push_response({"body": {"data": ({"id": "tools", "label": "Tools"}, {"id": "toys"})}});
        *list<hash<AllowedValueInfo>> values = create.getReferenceData("category");
        assertEq(2, values.size());
        assertEq("tools", values[0].value);
        assertEq("Tools", values[0].display_name);
        # a record with no human-readable name shows its ID rather than an empty row
        assertEq("toys", values[1].value);
        assertEq("toys", values[1].display_name);
        assertEq("GET", rest.last().method);
        assertEq("/api/categories", rest.last().path);
    }
    driftReportTest() {
        list<hash<RestSchemaActionInfo>> manifest = (
            entry("get-widget", "GET", "/widgets/{widget_id}", {"operation_id": "getWidget"}),
            entry("create-widget", "POST", "/widgets"),
        );
        RestSchemaActionSet aset = makeSet(manifest);

        # the same schema must report nothing at all
        assertEq((), RestSchemaDrift::compare(aset, schema));
        assertNothing(RestSchemaDrift::getBreaking(()));
        assertRegex("no drift", RestSchemaDrift::getReport());

        # a new optional option can be adopted without touching the manifest
        list<hash<RestSchemaDriftInfo>> drift = RestSchemaDrift::compare(aset, mutate(sub (reference<hash<auto>> d) {
            d.paths."/widgets/{widget_id}".get.parameters += {
                "name": "include_archived", "in": "query", "required": False,
                "schema": {"type": "boolean"},
            };
        }));
        assertEq(1, drift.size());
        assertEq(RSD_OPTION_ADDED, drift[0].kind);
        assertEq("include_archived", drift[0].option);
        assertTrue(drift[0].compatible);
        assertNothing(RestSchemaDrift::getBreaking(drift));

        # an option that disappeared breaks every caller that supplies it
        drift = RestSchemaDrift::compare(aset, mutate(sub (reference<hash<auto>> d) {
            remove d.components.schemas.widget_create.properties.category;
        }));
        assertEq(RSD_OPTION_REMOVED, drift[0].kind);
        assertEq("category", drift[0].option);
        assertFalse(drift[0].compatible);
        assertEq(1, RestSchemaDrift::getBreaking(drift).size());

        # a newly required option breaks callers that omit it; the report says which action and option
        drift = RestSchemaDrift::compare(aset, mutate(sub (reference<hash<auto>> d) {
            d.components.schemas.widget_create.required = ("name", "category");
        }));
        # making an option required also changes its type from "*string" to "string", so both differences
        # are reported; both are breaking
        list<hash<RestSchemaDriftInfo>> cat = select drift, $1.option == "category";
        assertEq(2, cat.size());
        assertEq((RSD_OPTION_TYPE_CHANGED, RSD_OPTION_REQUIREDNESS_CHANGED), (map $1.kind, cat));
        map assertFalse($1.compatible, $1.kind + " is breaking"), cat;
        assertRegex("BREAKING", RestSchemaDrift::getReport(drift));
        assertRegex("create-widget", RestSchemaDrift::getReport(drift));

        # losing an enum value rejects requests that used to work; gaining one does not
        drift = RestSchemaDrift::compare(aset, mutate(sub (reference<hash<auto>> d) {
            d.components.schemas.widget_create.properties.status{"enum"} = ("draft", "active");
        }));
        assertEq(RSD_OPTION_VALUES_CHANGED, (select drift, $1.option == "status")[0].kind);
        assertFalse((select drift, $1.option == "status")[0].compatible);

        drift = RestSchemaDrift::compare(aset, mutate(sub (reference<hash<auto>> d) {
            d.components.schemas.widget_create.properties.status{"enum"} = ("draft", "active", "retired",
                "archived");
        }));
        assertTrue((select drift, $1.option == "status")[0].compatible);

        # an operation that is gone entirely is reported, and does not stop the rest of the report
        drift = RestSchemaDrift::compare(aset, mutate(sub (reference<hash<auto>> d) {
            remove d.paths."/widgets/{widget_id}".get;
        }));
        assertEq(RSD_OPERATION_REMOVED, drift[0].kind);
        assertEq("get-widget", drift[0].action);
        assertFalse(drift[0].compatible);

        # an operationId rename never renames an action, but it is reported
        drift = RestSchemaDrift::compare(aset, mutate(sub (reference<hash<auto>> d) {
            d.paths."/widgets/{widget_id}".get.operationId = "retrieveWidget";
        }));
        assertEq(RSD_OPERATION_RENAMED, drift[0].kind);
        assertEq("getWidget", drift[0].old_value);
        assertEq("retrieveWidget", drift[0].new_value);
        assertFalse(drift[0].compatible);

        # a documentation-only change can be adopted
        drift = RestSchemaDrift::compare(aset, mutate(sub (reference<hash<auto>> d) {
            d.paths."/widgets/{widget_id}".get.parameters[0].description = "which properties to expand";
        }));
        assertEq(RSD_DOCUMENTATION_CHANGED, drift[0].kind);
        assertTrue(drift[0].compatible);
        assertNothing(RestSchemaDrift::getBreaking(drift));

        # a changed request content type changes how every request is serialized
        drift = RestSchemaDrift::compare(aset, mutate(sub (reference<hash<auto>> d) {
            hash<auto> content = d.paths."/widgets".post.requestBody.content;
            d.paths."/widgets".post.requestBody.content = {
                MimeTypeJson: content{MimeTypeFormUrlEncoded},
            };
        }));
        assertEq(RSD_CONTENT_TYPE_CHANGED, (select drift, $1.kind == RSD_CONTENT_TYPE_CHANGED)[0].kind);
        assertFalse((select drift, $1.kind == RSD_CONTENT_TYPE_CHANGED)[0].compatible);

        # a response that lost a field breaks callers reading it; one that gained a field does not
        drift = RestSchemaDrift::compare(aset, mutate(sub (reference<hash<auto>> d) {
            remove d.components.schemas.widget.properties.category;
        }));
        assertEq(RSD_RESPONSE_CHANGED, (select drift, $1.kind == RSD_RESPONSE_CHANGED)[0].kind);
        assertFalse((select drift, $1.kind == RSD_RESPONSE_CHANGED)[0].compatible);

        drift = RestSchemaDrift::compare(aset, mutate(sub (reference<hash<auto>> d) {
            d.components.schemas.widget.properties.colour = {"type": "string", "description": "the colour"};
        }));
        assertEq(RSD_RESPONSE_CHANGED, (select drift, $1.kind == RSD_RESPONSE_CHANGED)[0].kind);
        assertTrue((select drift, $1.kind == RSD_RESPONSE_CHANGED)[0].compatible);
    }

    #! An action whose options are lifted out of a fixed request envelope
    /** The JSON:API shape: everything a caller supplies is two levels inside a "data"/"attributes"
        wrapper, so lifting only the body's top level would publish a single "data" option.
    */
    private requestUnwrapTest() {
        hash<auto> doc = {
            "openapi": "3.0.1",
            "info": {"title": "t", "version": "1"},
            "paths": {
                "/things": {
                    "post": {
                        "operationId": "create_thing",
                        "requestBody": {
                            "required": True,
                            "content": {
                                MimeTypeJson: {
                                    "schema": {
                                        "type": "object",
                                        "required": ("data",),
                                        "properties": {
                                            "data": {
                                                "type": "object",
                                                "required": ("type", "attributes"),
                                                "properties": {
                                                    "type": {"type": "string", "enum": ("thing",)},
                                                    "attributes": {
                                                        "type": "object",
                                                        "required": ("name",),
                                                        "properties": {
                                                            "name": {"type": "string"},
                                                            "size": {"type": "integer"},
                                                        },
                                                    },
                                                },
                                            },
                                        },
                                    },
                                },
                            },
                        },
                        "responses": {"200": {"description": "ok"}},
                    },
                },
            },
        };
        OpenApi3Schema schema = OpenApi3::OpenApi3Loader::fromString(make_json(doc), True);

        hash<RestSchemaActionInfo> ai = <RestSchemaActionInfo>{
            "action": "create_thing",
            "method": "POST",
            "path": "/things",
            "display_name": "Create Thing",
            "short_desc": "x",
            "desc": "x",
            "request_unwrap": ("data", "attributes"),
        };
        RestSchemaActionSet aset(schema, (ai,));
        RestSchemaActionOperation op = aset.getOperationEx("create_thing");

        # the attributes are the options, not the envelope
        assertEq(("name", "size"), sort(keys (op.getRequestType().getFields() ?? {})),
            "the options come from inside the envelope");

        # and the envelope is rebuilt on the way out, including the discriminator nobody was asked for
        hash<auto> wire = op.unflatten({"name": "widget", "size": 3});
        assertEq({
            "data": {
                "type": "thing",
                "attributes": {"name": "widget", "size": 3},
            },
        }, wire.req.body, "the envelope is rebuilt and the fixed discriminator filled in");

        # without it the action publishes the envelope itself, which is the behaviour every other
        # application depends on
        RestSchemaActionSet plain(schema, (cast<hash<RestSchemaActionInfo>>(ai - "request_unwrap"),));
        assertEq(("data",), sort(keys (plain.getOperationEx("create_thing").getRequestType().getFields() ?? {})),
            "lifting is opt-in");

        # a path that does not resolve is an error naming what the level does declare
        assertThrows("REST-SCHEMA-ACTION-ERROR", "declares no such property",
            sub () {
                new RestSchemaActionSet(schema,
                    (cast<hash<RestSchemaActionInfo>>(ai + {"request_unwrap": ("data", "nope")}),));
            });

        # a sibling with no single permitted value is published as an option at the level it belongs to,
        # rather than being dropped: JSON:API carries the identity of the object being changed there
        hash<auto> doc2 = doc;
        doc2.paths."/things".post.requestBody.content{MimeTypeJson}.schema.properties.data.properties.id =
            {"type": "string"};
        doc2.paths."/things".post.requestBody.content{MimeTypeJson}.schema.properties.data.required =
            ("type", "attributes", "id");
        OpenApi3Schema schema2 = OpenApi3::OpenApi3Loader::fromString(make_json(doc2), True);
        RestSchemaActionSet with_id(schema2, (ai,));
        RestSchemaActionOperation op2 = with_id.getOperationEx("create_thing");
        assertEq(("id", "name", "size"), sort(keys (op2.getRequestType().getFields() ?? {})),
            "an envelope sibling is published as an option");
        assertEq(("data",), op2.getFlatMap().id.wire_path, "the option records the level it belongs to");
        hash<auto> wire2 = op2.unflatten({"id": "x1", "name": "widget"});
        assertEq({
            "data": {
                "id": "x1",
                "type": "thing",
                "attributes": {"name": "widget"},
            },
        }, wire2.req.body, "the sibling travels at its own level, not among the attributes");
        assertEq({"id": "x1", "name": "widget"}, op2.flatten(wire2),
            "a nested body flattens back to the options that built it");

        # the discriminator at the level the options were lifted to is filled in too, rather than becoming a
        # required option nobody can usefully answer
        hash<RestSchemaActionInfo> shallow = cast<hash<RestSchemaActionInfo>>(ai + {"request_unwrap": "data"});
        RestSchemaActionOperation op3 = new RestSchemaActionSet(schema2, (shallow,))
            .getOperationEx("create_thing");
        assertEq(("attributes", "id"), sort(keys (op3.getRequestType().getFields() ?? {})),
            "the fixed discriminator is not published at the level lifted to");
        assertEq({
            "data": {
                "id": "x1",
                "type": "thing",
                "attributes": {"name": "widget"},
            },
        }, op3.unflatten({"id": "x1", "attributes": {"name": "widget"}}).req.body,
            "the discriminator is filled in at the level lifted to");

        # a required sibling that must simply repeat a path variable follows it rather than being asked for
        # "auto!" because a literal whose values happen to share a type narrows to it, and a path item
        # carries both an operation hash and a parameter list
        hash<auto!> path_item = {
            "patch": doc2.paths."/things".post + {"operationId": "update_thing"},
            "parameters": (
                {"name": "id", "in": "path", "required": True, "schema": {"type": "string"}},
            ),
        };
        hash<auto!> paths3 = doc2.paths;
        paths3."/things/{id}" = path_item;
        hash<auto!> doc3 = doc2;
        doc3.paths = paths3;
        OpenApi3Schema schema3 = OpenApi3::OpenApi3Loader::fromString(make_json(doc3), True);
        RestSchemaActionOperation op4 = new RestSchemaActionSet(schema3, (
            cast<hash<RestSchemaActionInfo>>(ai + {
                "action": "update_thing",
                "method": "PATCH",
                "path": "/things/{id}",
                "operation_id": "update_thing",
                "fields": {
                    "body.data.id": <RestSchemaFieldOverlayInfo>{"value_from": "id"},
                },
            }),)).getOperationEx("update_thing");
        assertEq(("id", "name", "size"), sort(keys (op4.getRequestType().getFields() ?? {})),
            "the body identity is not a second option beside the path variable");
        hash<auto> wire4 = op4.unflatten({"id": "x1", "name": "widget"});
        assertEq({"id": "x1"}, wire4.path_vars, "the identity travels in the path");
        assertEq({
            "data": {
                "type": "thing",
                "id": "x1",
                "attributes": {"name": "widget"},
            },
        }, wire4.req.body, "and is repeated in the envelope without being asked for twice");
    }

    private mergeTest() {
        hash<auto> record = {
            "type": "object",
            "properties": {
                "id": {"type": "string"},
                "type": {"type": "string"},
                "attributes": {
                    "type": "object",
                    "properties": {
                        "email": {"type": "string"},
                        "created": {"type": "integer"},
                    },
                },
            },
        };
        hash<auto> doc = {
            "openapi": "3.0.1",
            "info": {"title": "t", "version": "1"},
            "paths": {
                "/people/{id}": {
                    "get": {
                        "operationId": "get_person",
                        "parameters": (
                            {"name": "id", "in": "path", "required": True, "schema": {"type": "string"}},
                        ),
                        "responses": {
                            "200": {
                                "description": "ok",
                                "content": {
                                    MimeTypeJson: {
                                        "schema": {
                                            "type": "object",
                                            "properties": {"data": record},
                                        },
                                    },
                                },
                            },
                        },
                    },
                },
                "/people": {
                    "get": {
                        "operationId": "get_people",
                        "responses": {
                            "200": {
                                "description": "ok",
                                "content": {
                                    MimeTypeJson: {
                                        "schema": {
                                            "type": "object",
                                            "properties": {
                                                "data": {"type": "array", "items": record},
                                            },
                                        },
                                    },
                                },
                            },
                        },
                    },
                },
            },
        };
        OpenApi3Schema schema = OpenApi3::OpenApi3Loader::fromString(make_json(doc), True);

        # a single resource: the envelope's properties are published beside the identity
        RestSchemaActionOperation op = new RestSchemaActionSet(schema, (<RestSchemaActionInfo>{
            "action": "get_person",
            "method": "GET",
            "path": "/people/{id}",
            "display_name": "Get Person",
            "short_desc": "x",
            "desc": "x",
            "response_unwrap": "data",
            "response_fields": {
                "attributes": <RestSchemaFieldOverlayInfo>{"merge": True},
            },
        },)).getOperationEx("get_person");
        assertEq(("created", "email", "id", "type"),
            sort(keys (op.getResponseType().getFields() ?? {})), "the envelope is not a field of its own");
        assertEq({"id": "p1", "type": "person", "email": "a@example.com", "created": 5},
            op.processResponse({"data": {"id": "p1", "type": "person",
                "attributes": {"email": "a@example.com", "created": 5}}}),
            "the envelope's properties are published beside the identity");
        # a value the envelope does not carry is left alone rather than being invented
        assertEq({"id": "p1", "type": "person"},
            op.processResponse({"data": {"id": "p1", "type": "person"}}),
            "a response with no envelope is passed through");

        # a collection: the overlay reaches the element type, and a codec inside the envelope still applies
        RestSchemaActionOperation lop = new RestSchemaActionSet(schema, (<RestSchemaActionInfo>{
            "action": "get_people",
            "method": "GET",
            "path": "/people",
            "display_name": "List People",
            "short_desc": "x",
            "desc": "x",
            "response_fields": {
                "data": <RestSchemaFieldOverlayInfo>{
                    "fields": {
                        "attributes": <RestSchemaFieldOverlayInfo>{
                            "merge": True,
                            "fields": {
                                "created": <RestSchemaFieldOverlayInfo>{
                                    "codec": RestSchemaActionCodecs::UnixSeconds,
                                },
                            },
                        },
                    },
                },
            },
        },)).getOperationEx("get_people");
        *AbstractDataProviderType et = lop.getResponseType().getFields().data.getType().getElementType();
        assertEq(("created", "email", "id", "type"), sort(keys (et.getFields() ?? {})),
            "the merge reaches the element type of a collection");
        assertEq({
            "data": (
                {"id": "p1", "type": "person", "email": "a@example.com", "created": 1970-01-01T00:00:05Z},
                {"id": "p2", "type": "person", "email": "b@example.com", "created": 1970-01-01T00:00:10Z},
            ),
        }, lop.processResponse({
            "data": (
                {"id": "p1", "type": "person", "attributes": {"email": "a@example.com", "created": 5}},
                {"id": "p2", "type": "person", "attributes": {"email": "b@example.com", "created": 10}},
            ),
        }), "every element is merged, and a codec inside the envelope still converts");

        # merging something that is not an object says so
        assertThrows("REST-SCHEMA-ACTION-ERROR", "which is not an object",
            sub () {
                new RestSchemaActionSet(schema, (<RestSchemaActionInfo>{
                    "action": "get_person",
                    "method": "GET",
                    "path": "/people/{id}",
                    "display_name": "Get Person",
                    "short_desc": "x",
                    "desc": "x",
                    "response_unwrap": "data",
                    "response_fields": {"id": <RestSchemaFieldOverlayInfo>{"merge": True}},
                },));
            });
    }

    private liftTest() {
        hash<auto> doc = {
            "openapi": "3.0.1",
            "info": {"title": "t", "version": "1"},
            "paths": {
                "/people": {
                    "post": {
                        "operationId": "create_person",
                        "parameters": (
                            {"name": "where", "in": "query", "schema": {"type": "string"}},
                        ),
                        "requestBody": {
                            "required": True,
                            "content": {
                                MimeTypeJson: {
                                    "schema": {
                                        "type": "object",
                                        "required": ("name",),
                                        "properties": {
                                            "name": {"type": "string"},
                                            "location": {
                                                "type": "object",
                                                "properties": {
                                                    "city": {"type": "string"},
                                                    "zip": {"type": "string"},
                                                },
                                            },
                                        },
                                    },
                                },
                            },
                        },
                        "responses": {"200": {"description": "ok"}},
                    },
                },
            },
        };
        OpenApi3Schema schema = OpenApi3::OpenApi3Loader::fromString(make_json(doc), True);
        hash<RestSchemaActionInfo> ai = <RestSchemaActionInfo>{
            "action": "create_person",
            "method": "POST",
            "path": "/people",
            "display_name": "Create Person",
            "short_desc": "x",
            "desc": "x",
            "fields": {
                "location": <RestSchemaFieldOverlayInfo>{"lift": True},
            },
        };
        RestSchemaActionOperation op = new RestSchemaActionSet(schema, (ai,)).getOperationEx("create_person");

        # the grouping object is gone and its properties are options in its place
        assertEq(("city", "name", "where", "zip"), sort(keys (op.getRequestType().getFields() ?? {})),
            "a lifted value's properties are the options");
        assertEq(NOTHING, op.getFlatMap().location, "the lifted value is not itself an option");
        assertEq("location", op.getFlatMap().city.lift_into, "each option records what it is assembled into");

        hash<auto> wire = op.unflatten({"name": "ada", "city": "Prague", "zip": "11000"});
        assertEq({"name": "ada", "location": {"city": "Prague", "zip": "11000"}}, wire.req.body,
            "the value is assembled back from the options published in its place");
        assertEq({"name": "ada", "city": "Prague", "zip": "11000"}, op.flatten(wire),
            "and splits back into them");

        # a value left entirely unset is not sent as an empty object
        assertEq({"name": "ada"}, op.unflatten({"name": "ada"}).req.body,
            "an unset lifted value contributes nothing");

        # a property that collides with an option the action already has is reported rather than chosen
        hash<auto> doc2 = doc;
        doc2.paths."/people".post.parameters = (
            {"name": "city", "in": "query", "schema": {"type": "string"}},
        );
        assertThrows("REST-SCHEMA-ACTION-ERROR", "is produced by both",
            sub () {
                new RestSchemaActionSet(OpenApi3::OpenApi3Loader::fromString(make_json(doc2), True), (ai,));
            });

        # lifting something that is not an object says so
        assertThrows("REST-SCHEMA-ACTION-ERROR", "which is not an object",
            sub () {
                new RestSchemaActionSet(schema, (cast<hash<RestSchemaActionInfo>>(ai + {
                    "fields": {"name": <RestSchemaFieldOverlayInfo>{"lift": True}},
                }),));
            });
    }

    #! Returns the fixture schema with the given mutation applied
    private OpenApi3Schema mutate(code change) {
        hash<auto> doc = parse_json(File::readTextFile(SchemaFile));
        change(\doc);
        return OpenApi3::OpenApi3Loader::fromString(make_json(doc), True);
    }

}
