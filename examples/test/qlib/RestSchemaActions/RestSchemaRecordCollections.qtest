%modern
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires RestSchemaActions
%requires RestClientIo
%requires json
%exec-class CollectionTest

class CollectionLog {
    public {
        list<hash<auto>> requests = ();
        list<hash<auto>> responses = ();
    }
}
class CollectionClient inherits RestClientIo::RestClientIo {
    public {
        static CollectionLog log = new CollectionLog();
    }
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager mgr) : RestClientIo(opts, mgr) {
    }
    #! Schema dispatch now supplies an explicit target; retain this mock's response recorder.
    hash<RestClient::RestResponseInfo> restDoRawRequestTarget(string method,
            hash<RestClient::RestRequestTarget> target, *data body, *hash<auto> hdr) {
        return restDoRawRequest(method, target.path, body, hdr);
    }

    hash<RestClient::RestResponseInfo> restDoRawRequest(string method, string path, *data body,
            *hash<auto> headers) {
        CollectionClient::log.requests += {"url": getUrl().toString(), "path": path, "method": method,
            "body": body ? parse_json(body) : NOTHING, "headers": getDefaultHeaders()};
        if (!CollectionClient::log.responses) {
            throw "TEST-ERROR", sprintf("unexpected request %s %s", method, path);
        }
        return <RestClient::RestResponseInfo>{"status_code": 200,
            "body": shift CollectionClient::log.responses, "headers": {}};
    }
}
class CollectionTest inherits QUnit::Test {
    private {
        RestSchemaActionSet aset;
        hash<RestSchemaRecordTableInfo> decl;
        CollectionClient rest;
    }
    constructor() : Test("Record collection transport", "1.0") {
        list<hash<RestSchemaActionInfo>> manifest = ();
        foreach string name in (("list", "filter", "fetch", "create", "update", "delete", "host")) {
            manifest += <RestSchemaActionInfo>{"action": name, "path": "/" + name,
                "method": inlist(name, ("list", "host")) ? "GET" : "POST",
                "operation_id": name, "display_name": name, "short_desc": name, "desc": name,
                "host_from": name == "host" ? NOTHING : "collection"};
        }
        aset = new RestSchemaActionSet(OpenApi3::OpenApi3Loader::fromFile(
            get_script_dir() + "/collection-store.json"), manifest, NOTHING, NOTHING, {
                "collection": <RestSchemaHostSourceInfo>{"name": "collection", "action": "host",
                    "key_option": "scope", "lookup_option": "scope", "host_field": "host",
                    "scheme": "https", "allowed_host_suffixes": "data.example.com", "desc": "Collection"},
            });
        decl = <RestSchemaRecordTableInfo>{"name": "records", "display_name": "Records",
            "short_desc": "Records", "desc": "Records", "list_action": "list", "get_action": "fetch",
            "create_action": "create", "update_action": "update", "delete_action": "delete",
            "scope_options": "scope", "create_scope_options": ("scope", "parent"), "records_path": "records", "record_path": "by_id",
            "record_is_map": True, "hydrate_list": True, "id_list_actions": ("fetch", "delete"),
            "action_id_options": {"fetch": "ids", "delete": "ids"},
            "write_list_options": {"create": "records"}, "write_returns_record": False,
            "paging": <RestSchemaRecordPagingInfo>{"mode": RSRP_CURSOR, "page_option": "cursor",
                "size_option": "limit", "max_size": 2, "next_path": ("pagination", "next")},
            "query_listing": <RestSchemaRecordListingInfo>{"list_action": "filter", "records_path": "by_id",
                "records_are_map": True, "paging": <RestSchemaRecordPagingInfo>{"mode": RSRP_CURSOR,
                    "page_option": "cursor", "size_option": "limit", "max_size": 2,
                    "next_path": ("pagination", "next")}},
            "query": <RestSchemaRecordQueryInfo>{"option": "filter",
                "syntax": <RestSchemaQuerySyntaxInfo>{"name": "test", "binary_ops": {DP_SEARCH_OP_EQ: "$eq"},
                    "not_op": NOTHING, "render_query": auto sub (hash<DataProviderExpression> exp) {
                        return {exp.args[0].field: {"$eq": exp.args[1]}};
                    }}},
        };
        rest = new CollectionClient({"url": "https://control.example.com", "headers": {"Api-Key": "test-key"}});
        addTestCase("ID pages hydrate complete records and retain pagination", \hydrateTest());
        addTestCase("native query selects full-record map listing", \queryTest());
        addTestCase("identity and write shapes", \writeTest());
        addTestCase("malformed collections and repeated cursors fail", \negativeTest());
        addTestCase("scopes differ between listing and create", \scopeTest());
        set_return_value(main());
    }
    private RestSchemaTableDataProvider table(list<hash<auto>> responses, *hash<RestSchemaRecordTableInfo> d) {
        CollectionClient::log.requests = ();
        CollectionClient::log.responses = ({"host": "one.data.example.com"},) + responses;
        return new RestSchemaTableDataProvider(aset, d ?? decl, rest);
    }
    private hydrateTest() {
        RestSchemaTableDataProvider t = table((
            {"records": ({"id": "gone"},), "pagination": {"next": "second"}},
            {"by_id": {}},
            {"records": ({"id": "a"}, {"id": "b"}), "pagination": {"next": "third"}},
            {"by_id": {"b": {"id": "b", "value": 2}, "a": {"id": "a", "value": 1}}},
        ));
        list<hash<auto>> rows = map $1, t.searchRecords(<DataProviderExpression>{"exp": DP_SEARCH_OP_GT, "args": (
            <DataProviderFieldReference>{"field": "value"}, 1)}, {"scope": "s", "limit": 1});
        # Force residual evaluation to exercise hydration rather than the alternate query listing.
        assertEq(({"id": "b", "value": 2},), rows);
        assertEq(5, CollectionClient::log.requests.size());
        assertEq({"ids": ("a", "b")}, CollectionClient::log.requests[4].body);
        assertEq("test-key", CollectionClient::log.requests[4].headers."Api-Key");
        assertTrue(CollectionClient::log.requests[4].url =~ /one\.data\.example\.com/);
        assertEq((), CollectionClient::log.responses);
    }
    private queryTest() {
        RestSchemaTableDataProvider t = table((
            {"by_id": {"a": {"id": "a", "value": 2}}, "pagination": {"next": "second"}},
            {"by_id": {"b": {"id": "b", "value": 2}}},
        ));
        list<hash<auto>> rows = map $1, t.searchRecords({"value": 2}, {"scope": "s"});
        assertEq(2, rows.size());
        assertEq("/filter", CollectionClient::log.requests[1].path);
        assertEq({"value": {"$eq": 2}}, CollectionClient::log.requests[1].body.filter);
        assertEq("second", CollectionClient::log.requests[2].body.cursor);
    }
    private writeTest() {
        RestSchemaTableDataProvider t = table(({"by_id": {"a": {"id": "a", "value": 1}}}, {}, {}, {}));
        assertEq("a", t.searchSingleRecord({"id": "a"}, {"scope": "s"}).id);
        assertEq({"ids": ("a",)}, CollectionClient::log.requests[1].body);
        assertEq({"id": "b", "value": 2}, t.createRecord({"id": "b", "value": 2}, {"scope": "s", "parent": "p"}));
        assertEq(({"id": "b", "value": 2},), CollectionClient::log.requests[2].body.records);
        assertEq(1, t.updateRecords({"value": 3}, {"id": "a"}, {"scope": "s"}));
        assertEq({"id": "a", "value": 3}, CollectionClient::log.requests[3].body);
        assertEq(1, t.deleteRecords({"id": "a"}, {"scope": "s"}));
        assertEq({"ids": ("a",)}, CollectionClient::log.requests[4].body);
        RestSchemaTableDataProvider missing = table(({"by_id": {}},),
            cast<hash<RestSchemaRecordTableInfo>>(decl + {"check_write_identity": True}));
        assertEq(0, missing.deleteRecords({"id": "absent"}, {"scope": "s"}));
        assertEq(2, CollectionClient::log.requests.size());
    }
    private negativeTest() {
        foreach auto bad in ((12, ({"id": "a"},))) {
            assertThrows("REST-SCHEMA-RECORD-ERROR", sub () {
                RestSchemaRecordPageIterator::extractRecordValues(bad, NOTHING, True, "test");
            });
        }
        assertThrows("REST-SCHEMA-RECORD-ERROR", sub () {
            RestSchemaRecordPageIterator::extractRecordValues({"a": 1}, NOTHING, True, "test");
        });
        foreach auto bad in ((12, {"a": "invalid"}, {"a": ({"id": "a"},)})) {
            RestSchemaTableDataProvider malformed = table(({"by_id": bad},));
            assertThrows("REST-SCHEMA-RECORD-ERROR", sub () {
                malformed.searchSingleRecord({"id": "a"}, {"scope": "s"});
            });
        }
        RestSchemaTableDataProvider t = table((
            {"by_id": {}, "pagination": {"next": "same"}},
            {"by_id": {}, "pagination": {"next": "same"}},
        ));
        assertThrows("REST-SCHEMA-RECORD-ERROR", sub () {
            map $1, t.searchRecords({"value": 2}, {"scope": "s"});
        });
        assertThrows("REST-SCHEMA-RECORD-ERROR", sub () {
            new RestSchemaTableDataProvider(aset,
                cast<hash<RestSchemaRecordTableInfo>>(decl - "get_action"), rest);
        });
    }
    private scopeTest() {
        RestSchemaTableDataProvider t = table(({"records": ()},));
        assertThrows("SEARCH-OPTION-ERROR", sub () { map $1, t.searchRecords(); });
        assertEq(0, CollectionClient::log.requests.size());
        # The create-only scope is declared by create rather than an unrelated listing.
        hash<RestSchemaRecordTableInfo> d = cast<hash<RestSchemaRecordTableInfo>>(
            decl + {"create_scope_options": ("scope", "parent")});
        RestSchemaTableDataProvider c = table(({},), d);
        assertTrue(c.getInfo().create_options.parent.required);
        c.createRecord({"id": "a", "value": 1}, {"scope": "s", "parent": "p"});
        assertEq("p", CollectionClient::log.requests[1].body.parent);
    }
}
