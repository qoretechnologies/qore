#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright 2026 Qore Technologies, s.r.o. SPDX-License-Identifier: MIT
# test-platform: macos - HTTP server and client over a loopback socket for a newline-delimited JSON response
%modern
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires RestSchemaActions
%requires HttpServer
%requires HttpServerUtil
%requires json
%exec-class RecordSequenceTest

#! A client that returns a fixed response body and records the request headers
class RecordSequenceClient inherits RestClientIo::RestClientIo {
    public {
        auto body;
        *hash<auto> last_headers;
    }
    constructor() : RestClientIo({"url": "https://fixture.example"}) {}

    hash<RestClient::RestResponseInfo> restDoRawRequestTarget(string method,
            hash<RestClient::RestRequestTarget> target, *data body, *hash<auto> hdr) {
        return restDoRawRequest(method, target.path, body, hdr);
    }

    hash<RestClient::RestResponseInfo> restDoRawRequest(string method, string path, *data data,
            *hash<auto> headers) {
        last_headers = headers;
        return <RestClient::RestResponseInfo>{"status_code": 200, "body": body};
    }
}

#! Serves a newline-delimited JSON response
class RecordSequenceHandler inherits AbstractHttpRequestHandler {
    private {
        Mutex lock();
        *string accept;
    }

    hash handleRequest(hash cx, hash hdr, *data body) {
        AutoLock al(lock);
        accept = hdr.accept;
        return makeResponse(200, "{\"status\":\"generated\",\"translated\":false}\n{\"content\":\"Hello \"}\n"
            "{\"content\":\"world\"}\n", {"Content-Type": "application/x-ndjson"});
    }

    *string getAccept() {
        AutoLock al(lock);
        return accept;
    }
}

#! A response that is a sequence of JSON records (application/x-ndjson) is the list of its records (qore#6503)
class RecordSequenceTest inherits QUnit::Test {
    public {
        #! the record types of the response: metadata, content chunks and errors
        const Records = {"anyOf": (
            {"type": "object", "title": "Metadata", "required": ("status", "translated"), "properties": {
                "status": {"type": "string", "enum": ("generated", "handwritten")},
                "translated": {"type": "boolean"},
            }},
            {"type": "object", "title": "Chunk", "required": ("content",), "properties": {
                "content": {"type": "string"},
            }},
            {"type": "object", "title": "Error", "required": ("error",), "properties": {
                "error": {"type": "string"},
            }},
        )};
    }

    constructor() : Test("REST schema record sequence responses", "1.0") {
        addTestCase("the output type is a list of the record type", \typeTest());
        addTestCase("a newline-delimited JSON body is the list of its records", \parseTest());
        addTestCase("a line that is not JSON is refused", \invalidTest());
        addTestCase("a record sequence cannot be unwrapped", \unwrapTest());
        addTestCase("a record sequence over HTTP", \httpTest());
        set_return_value(main());
    }

    #! returns an action set with one action that selects the NDJSON response
    static RestSchemaActionSet actions(*hash<auto> extra) {
        OpenApi3::OpenApi3Schema schema = OpenApi3::OpenApi3Loader::fromString(make_json({
            "openapi": "3.1.0", "info": {"title": "Summaries", "version": "1"},
            "paths": {"/summary": {"post": {"responses": {"200": {"description": "Records",
                "content": {"application/x-ndjson": {"schema": Records}}}}}}},
        }), True);
        hash<RestSchemaActionInfo> manifest = cast<hash<RestSchemaActionInfo>>(<RestSchemaActionInfo>{
            "action": "summarize", "method": "POST", "path": "/summary", "display_name": "Summarize",
            "short_desc": "Summarize", "desc": "Summarize.", "response_content_type": "application/x-ndjson",
        } + extra);
        return new RestSchemaActionSet(schema, (manifest,));
    }

    typeTest() {
        RestSchemaActionOperation op = actions().getOperationEx("summarize");
        assertTrue(op.isRecordSequence());
        AbstractDataProviderType type = op.getResponseType();
        *AbstractDataProviderType element = type.getElementType();
        assertTrue(exists element, "the output is a list");
        assertEq(({"content": "x"}, {"error": "e"}), type.acceptsValue(({"content": "x"}, {"error": "e"})));
        # each element is one of the record types
        assertEq(3, cast<QoreUnionDataType>(element).getUnionTypes().size());

        # a response overlay applies to each record
        op = actions({"response_fields": {"content": <RestSchemaFieldOverlayInfo>{"display_name": "Text"}}})
            .getOperationEx("summarize");
        bool found;
        foreach AbstractDataProviderType alternative in (cast<QoreUnionDataType>(op.getResponseType()
                .getElementType()).getUnionTypes()) {
            if (*AbstractDataField field = alternative.getFields().content) {
                assertEq("Text", field.getDisplayName());
                found = True;
            }
        }
        assertTrue(found, "the overlay reaches the record field");

        # an action without a record sequence is unchanged
        assertFalse(actions({"response_content_type": NOTHING}).getOperationEx("summarize").isRecordSequence());
    }

    parseTest() {
        RestSchemaActionSet set = actions();
        RecordSequenceClient client();
        RestSchemaActionDataProvider provider(set, set.getOperationEx("summarize"), client);

        client.body = "{\"status\":\"generated\",\"translated\":true}\n\n{\"content\":\"a\"}\r\n  \n{\"content\":\"b\"}";
        assertEq(({"status": "generated", "translated": True}, {"content": "a"}, {"content": "b"}),
            provider.doRequest({}));
        assertEq("application/x-ndjson", client.last_headers.Accept, "the request asks for the record sequence");

        client.body = binary("{\"error\":\"failed\"}\n");
        assertEq(({"error": "failed"},), provider.doRequest({}));

        # a body that the client already decoded
        client.body = {"content": "one"};
        assertEq(({"content": "one"},), provider.doRequest({}));
        client.body = ({"content": "one"}, {"content": "two"});
        assertEq(({"content": "one"}, {"content": "two"}), provider.doRequest({}));

        # no records
        foreach auto body in (NOTHING, "", "\n\n") {
            client.body = body;
            assertEq((), provider.doRequest({}), sprintf("%y", body));
        }
    }

    invalidTest() {
        RestSchemaActionSet set = actions();
        RecordSequenceClient client();
        RestSchemaActionDataProvider provider(set, set.getOperationEx("summarize"), client);
        client.body = "{\"content\":\"a\"}\n{not json\n";
        assertThrows("REST-SCHEMA-ACTION-ERROR", "line 2 is not valid JSON", \provider.doRequest(), {});
        client.body = 42;
        assertThrows("REST-SCHEMA-ACTION-ERROR", "not newline-delimited JSON", \provider.doRequest(), {});
    }

    unwrapTest() {
        assertThrows("REST-SCHEMA-ACTION-ERROR", "sequence of records", sub () {
            actions({"response_unwrap": "content"}).getOperationEx("summarize").getResponseType();
        });
    }

    httpTest() {
        HttpServer server(<HttpServerOptionInfo>{});
        on_exit delete server;
        RecordSequenceHandler handler();
        server.setDefaultHandler("records", handler);
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        RestClientIo::RestClientIo client({"url": sprintf("http://127.0.0.1:%d", port), "http_version": "1.1"});
        RestSchemaActionSet set = actions();
        RestSchemaActionDataProvider provider(set, set.getOperationEx("summarize"), client);
        assertEq(({"status": "generated", "translated": False}, {"content": "Hello "}, {"content": "world"}),
            provider.doRequest({}));
        assertEq("application/x-ndjson", handler.getAccept());

        # the REST client returns a newline-delimited JSON body as text, as it is not one JSON document
        hash<auto> response = (new RestSchemaValidator::NullRestSchemaValidator()).parseResponse("POST", "/summary", 200,
            "{\"content\":\"a\"}\n{\"content\":\"b\"}\n", {"content-type": "application/x-ndjson"});
        assertEq("{\"content\":\"a\"}\n{\"content\":\"b\"}\n", response.body);
    }
}
