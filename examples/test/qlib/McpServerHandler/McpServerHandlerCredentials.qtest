#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires json
%requires QUnit
%requires HttpServer
%requires HttpServerUtil
%requires Logger
%requires McpClient
%requires McpServerHandler

%exec-class McpServerHandlerCredentialsTest

#! a hang guard only, never a timing assertion
const HangGuard = 20s;

#! The code of a restricted Program that a trusted MCP handler calls gets the request without its credentials
#! (qore#7303)
/** A resource reader, a prompt handler and a tool that calls McpServerHandler::getToolCallContext() get the request
    context without the \c Authorization and \c Cookie fields, the raw \c Authorization value, the objects of the
    server and the \c Mcp-Session-Id field when their code is of a %Program that a sandbox that does not trust its code
    governs, also when a handler of trusted code calls them; they keep the handler's keys (the session in
    \c mcp_session, the request ID in \c jsonid, and \c sid of the call context).  Trusted code gets the request as
    the server has it.
*/
class McpServerHandlerCredentialsTest inherits QUnit::Test {
    public {
        #! the tenant's code: records what of the credentials of the request it saw
        const TenantSource = "%modern
%requires McpServerHandler
string sub seen(hash<auto> cx) {
    return sprintf(\"auth=%y authorization=%y cookie=%y session_hdr=%y raw_authorization=%y raw_session=%y \"
        \"logger=%y listener=%y socket=%y uctx=%y mcp_session=%y jsonid=%y\", exists cx.auth,
        exists cx.hdr.authorization, exists cx.hdr.cookie, exists cx.hdr.\"mcp-session-id\",
        exists cx.\"header-info\".\"headers-raw\".Authorization,
        exists cx.\"header-info\".\"headers-raw\".\"Mcp-Session-Id\", cx.hasKey(\"logger\"),
        cx.hasKey(\"listener\"), cx.hasKey(\"socket\"), cx.hasKey(\"uctx\"), exists cx.mcp_session,
        exists cx.jsonid);
}
code sub get_reader(Queue q) {
    return auto sub (hash<auto> cx, string uri) { q.push(seen(cx)); return \"text\"; };
}
code sub get_prompt(Queue q) {
    return auto sub (hash<auto> cx, *hash<auto> args) {
        q.push(seen(cx));
        return ({\"role\": \"user\", \"content\": {\"type\": \"text\", \"text\": \"hi\"}},);
    };
}
code sub get_tool(Queue q) {
    return auto sub (auto args) {
        *hash<McpToolCallContext> ctx = McpServerHandler::getToolCallContext();
        q.push(seen(ctx.cx) + sprintf(\" sid=%y handler=%y\", exists ctx.sid, exists ctx.handler));
        return \"ok\";
    };
}
";

        #! the keys that the code of a restricted Program keeps: the session and the request ID
        const Kept = " mcp_session=True jsonid=True";

        #! what the code of a restricted Program sees
        const Filtered = "auth=False authorization=False cookie=False session_hdr=False raw_authorization=False "
            "raw_session=False logger=False listener=False socket=False uctx=False" + Kept;

        #! what trusted code sees
        const Raw = "auth=True authorization=True cookie=True session_hdr=True raw_authorization=True "
            "raw_session=True logger=True listener=False socket=True uctx=True" + Kept;

        const ClientInfo = {
            "protocolVersion": McpClient::McpVersion::V2025_11_25,
            "capabilities": {},
            "clientInfo": {"name": "McpServerHandlerCredentialsClient", "version": "1.0"},
        };
    }

    constructor() : Test("McpServerHandlerCredentialsTest", "1.0", \ARGV) {
        addTestCase("the code of a restricted Program", \restrictedTest());
        addTestCase("trusted code", \trustedTest());
        addTestCase("the call context outside of a call", \noCallTest());
        set_return_value(main());
    }

    #! returns the tenant's Program with the given sandbox
    private Program getTenant(*SandboxManager sm) {
        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        if (sm) {
            p.setSandboxManager(sm);
        }
        p.parse(TenantSource, "tenant");
        return p;
    }

    #! calls the reader, the prompt handler and the tool of the Program with credentials; returns what they saw
    private hash<string, string> call(Program p) {
        Queue q();
        McpServerHandler handler(new Logger("mcp", LoggerLevel::getLevelInfo()), new PermissiveAuthenticator());
        handler.registerResource("test://r", "r", "a resource", "text/plain", p.callFunction("get_reader", q));
        handler.registerPrompt("p", "a prompt", NOTHING, p.callFunction("get_prompt", q));
        handler.registerTool("t", "a tool", NOTHING, p.callFunction("get_tool", q));

        HttpServer server(<HttpServerOptionInfo>{});
        on_exit server.stop();
        server.setDefaultHandler("mcp", handler);
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        server.waitForAsyncIo();

        HTTPClient hc({"url": sprintf("http://127.0.0.1:%d", port), "timeout": HangGuard});
        on_exit hc.disconnect();
        hash<auto> info;
        hash<auto> init = post(hc, {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": ClientInfo}, NOTHING,
            \info);
        assertEq(McpClient::McpVersion::V2025_11_25, init.result.protocolVersion, "initialize");
        string session = info."response-headers"{McpSessionHeader.lwr()};
        post(hc, {"jsonrpc": "2.0", "method": "notifications/initialized"}, session);

        hash<string, string> rv = {};
        hash<auto> r = post(hc, {"jsonrpc": "2.0", "id": 2, "method": "resources/read",
            "params": {"uri": "test://r"}}, session);
        assertEq("text", r.result.contents[0].text, "the resource is read");
        rv.reader = q.get(HangGuard);
        r = post(hc, {"jsonrpc": "2.0", "id": 3, "method": "prompts/get", "params": {"name": "p"}}, session);
        assertEq("hi", r.result.messages[0].content.text, "the prompt is served");
        rv.prompt = q.get(HangGuard);
        r = post(hc, {"jsonrpc": "2.0", "id": 4, "method": "tools/call", "params": {"name": "t", "arguments": {}}},
            session);
        assertEq("ok", r.result.content[0].text, "the tool is called");
        rv.tool = q.get(HangGuard);
        return rv;
    }

    #! posts a JSON-RPC message with credentials; returns the parsed response, if any
    private *hash<auto> post(HTTPClient hc, hash<auto> msg, *string session, *reference<hash<auto>> info) {
        hash<auto> hdr = {
            "Content-Type": "application/json",
            "Accept": "application/json, text/event-stream",
            "Authorization": "Bearer secret",
            "Cookie": "session=secret",
        };
        if (session) {
            hdr{McpSessionHeader} = session;
        }
        hash<auto> my_info;
        hash<auto> resp = hc.send(make_json(msg), "POST", "/", hdr, False, \my_info);
        info = my_info;
        auto body = resp.body;
        if (!body.val()) {
            return;
        }
        return parse_json(body.typeCode() == NT_BINARY ? body.toString("UTF-8") : body);
    }

    restrictedTest() {
        # the default sandbox does not trust its code
        hash<string, string> r = call(getTenant(new SandboxManager()));
        assertEq(Filtered, r.reader, "the resource reader");
        assertEq(Filtered, r.prompt, "the prompt handler");
        assertEq(Filtered + " sid=True handler=True", r.tool, "the tool's call context");
    }

    trustedTest() {
        hash<string, string> r = call(getTenant());
        assertEq(Raw, r.reader, "the resource reader");
        assertEq(Raw, r.prompt, "the prompt handler");
        assertEq(Raw + " sid=True handler=True", r.tool, "the tool's call context");
    }

    noCallTest() {
        assertEq(NOTHING, McpServerHandler::getToolCallContext(), "trusted code outside of a call");
        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        p.setSandboxManager(new SandboxManager());
        p.parse("%modern\n%requires McpServerHandler\nauto sub get() { return McpServerHandler::getToolCallContext(); }",
            "tenant");
        assertEq(NOTHING, p.callFunction("get"), "restricted code outside of a call");
    }
}
