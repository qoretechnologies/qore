%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires json
%requires QUnit
%requires HttpServerUtil
%requires DataProvider
%requires McpServerHandler
%exec-class McpServerHandlerTypeInfoTest

#! Exposes the registered input schemas
class TestMcpServerHandler inherits McpServerHandler {
    constructor() : McpServerHandler(new PermissiveAuthenticator()) {
    }

    *hash<auto> getInput(string name) {
        return tmap{name}.input;
    }

    bool getNeedsMap(string name) {
        return tmap{name}.needs_map ?? False;
    }

    #! Looks up a field's allowed values on demand, as a subclass's lookup tool would
    *list<hash<AllowedValueInfo>> lookUp(AbstractDataField field, AbstractDataProvider prov) {
        return getAllowedValues(field, prov);
    }

    #! Looks up the allowed values of a list field's elements on demand, as a subclass's lookup tool would
    *list<hash<AllowedValueInfo>> lookUpElements(AbstractDataField field, *AbstractDataProvider prov) {
        return getElementAllowedValues(field, prov);
    }
}

#! Names a lookup tool in the description of a reference-data parameter
class LookupMcpServerHandler inherits TestMcpServerHandler {
    private string getReferenceDataDescription(string name, string ref_data, *AbstractDataProvider prov) {
        return sprintf("Find %s with tool lookup-%s of %s.", name, ref_data, prov ? prov.getName() : "n/a");
    }

    private string getElementReferenceDataDescription(string name, string ref_data, *AbstractDataProvider prov) {
        return sprintf("Find each of %s with tool lookup-%s of %s.", name, ref_data,
            prov ? prov.getName() : "n/a");
    }

    private string getSuggestedValuesDescription(string name, list<auto> values, bool for_elements) {
        return sprintf("%s suggests %d value(s)%s.", name, values.size(), for_elements ? " for each element" : "");
    }
}

#! Gives reference data from the connected system and counts each read
class CustomerProvider inherits AbstractDataProvider {
    public {
        int reads = 0;
    }

    private {
        const ProviderInfo = <DataProviderInfo>{
            "type": "CustomerProvider",
        };
    }

    string getName() {
        return "customers";
    }

    private hash<DataProviderInfo> getStaticInfoImpl() {
        return ProviderInfo;
    }

    private *list<hash<AllowedValueInfo>> getReferenceDataImpl(string type, *hash<auto> action_opts) {
        ++reads;
        return map <AllowedValueInfo>{"value": sprintf("gid://shopify/Customer/%d", $1)}, range(1, 4);
    }

    private *list<hash<AllowedValueInfo>> getElementReferenceDataImpl(string type, *hash<auto> action_opts) {
        ++reads;
        return map <AllowedValueInfo>{"value": sprintf("tag-%d", $1)}, range(1, 3);
    }
}

public class McpServerHandlerTypeInfoTest inherits QUnit::Test {
    constructor() : Test("McpServerHandler tools from type descriptions", "1.0") {
        addTestCase("a type description gives the schema of its type", \equivalenceTest());
        addTestCase("constraints are published as JSON schema keywords", \constraintTest());
        addTestCase("reference data is described, never listed or read for a schema", \referenceDataTest());
        addTestCase("a subclass names its lookup for reference data", \referenceDataLookupTest());
        addTestCase("fixed values are listed up to the bound", \fixedValueBoundTest());
        addTestCase("a list's element reference data is described for its elements", \elementReferenceDataTest());
        addTestCase("a subclass names its lookup for element reference data", \elementReferenceDataLookupTest());
        addTestCase("a list's fixed element values are the enum of its items", \elementFixedValueTest());
        addTestCase("suggested values are described, not an enum", \suggestedValueTest());
        set_return_value(main());
    }

    #! Returns an input type covering the described kinds of values
    private static HashDataType getInputType() {
        HashDataType inner("Inner");
        inner.addQoreFields({"flag": {"name": "flag", "type": AbstractDataProviderTypeMap."*bool"}});
        HashDataType type("Input");
        type.addQoreFields({
            "name": {"name": "name", "type": AbstractDataProviderTypeMap."string",
                "desc": "The name of the thing"},
            "code": {"name": "code", "type": AbstractDataProviderTypeMap."softstring".copyWithConstraints(
                <DataTypeConstraintInfo>{"min_length": 2, "max_length": 4, "pattern": "^[A-Z]"})},
            "count": {"name": "count", "type": AbstractDataProviderTypeMap."*int".copyWithConstraints(
                <DataTypeConstraintInfo>{"minimum": 1, "exclusive_maximum": 10})},
            "tags": {"name": "tags", "type": (new ListDataType(AbstractDataProviderTypeMap."string", True))
                .copyWithConstraints(<DataTypeConstraintInfo>{"max_items": 3, "unique_items": True})},
            "mode": {"name": "mode", "type": AbstractDataProviderTypeMap."*string", "allowed_values": (
                <AllowedValueInfo>{"value": "fast"}, <AllowedValueInfo>{"value": "slow"})},
            "either": {"name": "either", "type": new QoreUnionDataType((AbstractDataProviderTypeMap."string",
                AbstractDataProviderTypeMap."int"))},
            "data": {"name": "data", "type": AbstractDataProviderTypeMap."*binary"},
            "inner": {"name": "inner", "type": inner},
        });
        return type;
    }

    equivalenceTest() {
        TestMcpServerHandler handler();
        foreach AbstractDataProviderType type in ((getInputType(), AbstractDataProviderTypeMap."softint",
                AbstractDataProviderTypeMap."*string", new ListDataType(AbstractDataProviderTypeMap."int"))) {
            handler.registerTool("from-type", "a tool", type, sub (auto v) {});
            handler.registerToolWithTypeInfo("from-info", "a tool", type.getInfo(), sub (auto v) {});
            assertEq(make_json(handler.getInput("from-type")), make_json(handler.getInput("from-info")),
                type.getName());
            assertEq(handler.getNeedsMap("from-type"), handler.getNeedsMap("from-info"), type.getName());
        }
        # no input
        handler.registerTool("from-type", "a tool", NOTHING, sub (auto v) {});
        handler.registerToolWithTypeInfo("from-info", "a tool", NOTHING, sub (auto v) {});
        assertEq(handler.getInput("from-type"), handler.getInput("from-info"));
    }

    constraintTest() {
        TestMcpServerHandler handler();
        handler.registerToolWithTypeInfo("tool", "a tool", getInputType().getInfo(), sub (auto v) {});
        hash<auto> props = handler.getInput("tool").properties;
        assertEq({"type": "string", "minLength": 2, "maxLength": 4, "pattern": "^[A-Z]"}, props.code);
        assertEq({"type": "integer", "minimum": 1n, "exclusiveMaximum": 10n}, props.count);
        assertEq(3, props.tags.maxItems);
        assertTrue(props.tags.uniqueItems);
        assertEq(("fast", "slow"), props.mode."enum");
        assertEq({}, props.either);
        assertEq(("name", "code", "either", "inner"), handler.getInput("tool").required);
    }

    #! Returns an input type with a reference-data parameter, a fixed-value parameter and a plain one
    private static HashDataType getReferenceInputType() {
        HashDataType type("CustomerTag");
        type.addQoreFields({
            "customerId": {"name": "customerId", "type": AbstractDataProviderTypeMap."string",
                "desc": "The customer", "attr": {"ref_data": "customerId"}},
            "mode": {"name": "mode", "type": AbstractDataProviderTypeMap."*string", "allowed_values": (
                <AllowedValueInfo>{"value": "add"}, <AllowedValueInfo>{"value": "remove"}),
                "attr": {"ref_data": "mode"}},
            "note": {"name": "note", "type": AbstractDataProviderTypeMap."*string"},
        });
        return type;
    }

    referenceDataTest() {
        TestMcpServerHandler handler();
        CustomerProvider prov();
        HashDataType type = getReferenceInputType();
        handler.registerTool("from-type", "a tool", type, sub (auto v) {}, NOTHING, NOTHING, prov);
        handler.registerToolWithTypeInfo("from-info", "a tool", type.getInfo(), sub (auto v) {}, NOTHING,
            NOTHING, prov);
        # building either schema reads nothing from the connected system
        assertEq(0, prov.reads);
        foreach string tool in (("from-type", "from-info")) {
            hash<auto> props = handler.getInput(tool).properties;
            assertFalse(props.customerId.hasKey("enum"), tool);
            assertRegex("^The customer The value identifies an existing record of the connected system "
                "\\(reference data \"customerId\"\\)", props.customerId.description, tool);
            assertEq("string", props.customerId.type, tool);
            # fixed values win over reference data and are listed
            assertEq(("add", "remove"), props.mode."enum", tool);
            assertFalse(props.mode.hasKey("description"), tool);
            assertEq({"type": "string"}, props.note, tool);
            assertEq(("customerId",), handler.getInput(tool).required, tool);
        }
        assertEq(make_json(handler.getInput("from-type")), make_json(handler.getInput("from-info")));
        assertEq(0, prov.reads);

        # a subclass can still read the values on demand
        *list<hash<AllowedValueInfo>> values = handler.lookUp(type.getField("customerId"), prov);
        assertEq(("gid://shopify/Customer/1", "gid://shopify/Customer/2", "gid://shopify/Customer/3"),
            map $1.value, values);
        assertEq(1, prov.reads);
        # fixed values are returned without reading
        assertEq(("add", "remove"), map $1.value, handler.lookUp(type.getField("mode"), prov));
        assertEq(1, prov.reads);

        # without a provider, a reference-data parameter is described in the same way
        handler.registerTool("no-prov", "a tool", type, sub (auto v) {});
        assertFalse(handler.getInput("no-prov").properties.customerId.hasKey("enum"));
        assertRegex("reference data \"customerId\"", handler.getInput("no-prov").properties.customerId.description);
    }

    referenceDataLookupTest() {
        LookupMcpServerHandler handler();
        CustomerProvider prov();
        HashDataType type = getReferenceInputType();
        handler.registerTool("from-type", "a tool", type, sub (auto v) {}, NOTHING, NOTHING, prov);
        handler.registerToolWithTypeInfo("from-info", "a tool", type.getInfo(), sub (auto v) {}, NOTHING,
            NOTHING, prov);
        foreach string tool in (("from-type", "from-info")) {
            assertEq("The customer Find customerId with tool lookup-customerId of customers.",
                handler.getInput(tool).properties.customerId.description, tool);
        }
        assertEq(0, prov.reads);
    }

    fixedValueBoundTest() {
        TestMcpServerHandler handler();
        list<hash<AllowedValueInfo>> at_bound = map <AllowedValueInfo>{"value": sprintf("v%d", $1)},
            range(1, McpServerHandler::MaxInlineEnumValues + 1);
        list<hash<AllowedValueInfo>> over_bound = at_bound + (<AllowedValueInfo>{"value": "one-more"},);
        list<string> over_strings = map $1.value, over_bound;
        HashDataType type("Bound");
        type.addQoreFields({
            "at": {"name": "at", "type": AbstractDataProviderTypeMap."string", "allowed_values": at_bound},
            "over": {"name": "over", "type": AbstractDataProviderTypeMap."string", "allowed_values": over_bound,
                "desc": "A code"},
            "constrained": {"name": "constrained", "type": AbstractDataProviderTypeMap."string"
                .copyWithConstraints(<DataTypeConstraintInfo>{"enum_values": over_strings})},
            "constrained_at": {"name": "constrained_at", "type": AbstractDataProviderTypeMap."string"
                .copyWithConstraints(<DataTypeConstraintInfo>{"enum_values": ("x", "y")})},
        });
        handler.registerTool("from-type", "a tool", type, sub (auto v) {});
        handler.registerToolWithTypeInfo("from-info", "a tool", type.getInfo(), sub (auto v) {});
        foreach string tool in (("from-type", "from-info")) {
            hash<auto> props = handler.getInput(tool).properties;
            assertEq(McpServerHandler::MaxInlineEnumValues, props.at."enum".size(), tool);
            assertEq("v1", props.at."enum"[0], tool);
            assertFalse(props.over.hasKey("enum"), tool);
            assertEq(sprintf("A code The value is one of %d fixed values; a value that is not one of them is "
                "rejected when the tool is called.", McpServerHandler::MaxInlineEnumValues + 1),
                props.over.description, tool);
            assertFalse(props.constrained.hasKey("enum"), tool);
            assertRegex(sprintf("one of %d fixed values", McpServerHandler::MaxInlineEnumValues + 1),
                props.constrained.description, tool);
            assertEq(("x", "y"), props.constrained_at."enum", tool);
        }
    }

    #! Returns an input type with lists whose elements are reference data, fixed values or suggested values
    private static HashDataType getElementInputType() {
        HashDataType type("CustomerTags");
        type.addQoreFields({
            "tags": {"name": "tags", "type": new ListDataType(AbstractDataProviderTypeMap."string"),
                "desc": "The tags to add", "attr": {"element_ref_data": "tags"}},
            "ids": {"name": "ids", "type": new SoftListDataType(AbstractDataProviderTypeMap."softstring", True),
                "desc": "Return only these customers", "attr": {"element_ref_data": "customers"}},
            "states": {"name": "states", "type": new ListDataType(AbstractDataProviderTypeMap."string", True),
                "element_allowed_values": (<AllowedValueInfo>{"value": "active"},
                    <AllowedValueInfo>{"value": "archived"}),
                "attr": {"element_ref_data": "states"}},
            "languages": {"name": "languages", "type": new ListDataType(AbstractDataProviderTypeMap."string",
                True), "desc": "The languages", "element_allowed_values": (<AllowedValueInfo>{"value": "en"},
                <AllowedValueInfo>{"value": "de"}), "element_allowed_values_creatable": True},
        });
        return type;
    }

    elementReferenceDataTest() {
        TestMcpServerHandler handler();
        CustomerProvider prov();
        HashDataType type = getElementInputType();
        handler.registerTool("from-type", "a tool", type, sub (auto v) {}, NOTHING, NOTHING, prov);
        handler.registerToolWithTypeInfo("from-info", "a tool", type.getInfo(), sub (auto v) {}, NOTHING,
            NOTHING, prov);
        # building either schema reads nothing from the connected system
        assertEq(0, prov.reads);
        foreach string tool in (("from-type", "from-info")) {
            hash<auto> props = handler.getInput(tool).properties;
            # the list parameter's description says where each element comes from; the elements stay plain values
            assertEq("The tags to add Each element identifies an existing record of the connected system "
                "(reference data \"tags\"); the values are not listed here: use values given by the user or "
                "returned by another tool.", props.tags.description, tool);
            assertEq("array", props.tags.type, tool);
            assertEq({"type": "string", "description": "array items"}, props.tags.items, tool);
            assertFalse(props.tags.hasKey("enum"), tool);
            # a list that also accepts a single value is described in the same way
            assertRegex("^Return only these customers Each element identifies an existing record of the connected "
                "system \\(reference data \"customers\"\\)", props.ids.description, tool);
            assertFalse(props.ids.items.hasKey("enum"), tool);
            # fixed element values win over element reference data and are listed for the elements
            assertEq(("active", "archived"), props.states.items."enum", tool);
            assertFalse(props.states.hasKey("description"), tool);
        }
        assertEq(make_json(handler.getInput("from-type")), make_json(handler.getInput("from-info")));
        assertEq(0, prov.reads);

        # a subclass can still read the values of the elements on demand
        assertEq(("tag-1", "tag-2"), map $1.value, handler.lookUpElements(type.getField("tags"), prov));
        assertEq(1, prov.reads);
        # fixed element values are returned without reading
        assertEq(("active", "archived"), map $1.value, handler.lookUpElements(type.getField("states"), prov));
        assertEq(1, prov.reads);
        # element reference data is not the reference data of the value
        assertEq(NOTHING, handler.lookUp(type.getField("tags"), prov));
        assertEq(1, prov.reads);

        # without a provider, the elements are described in the same way
        handler.registerTool("no-prov", "a tool", type, sub (auto v) {});
        assertRegex("reference data \"tags\"", handler.getInput("no-prov").properties.tags.description);
        assertEq(NOTHING, handler.lookUpElements(type.getField("tags"), NOTHING));
    }

    elementReferenceDataLookupTest() {
        LookupMcpServerHandler handler();
        CustomerProvider prov();
        HashDataType type = getElementInputType();
        handler.registerTool("from-type", "a tool", type, sub (auto v) {}, NOTHING, NOTHING, prov);
        handler.registerToolWithTypeInfo("from-info", "a tool", type.getInfo(), sub (auto v) {}, NOTHING,
            NOTHING, prov);
        foreach string tool in (("from-type", "from-info")) {
            assertEq("The tags to add Find each of tags with tool lookup-tags of customers.",
                handler.getInput(tool).properties.tags.description, tool);
        }
        assertEq(0, prov.reads);
    }

    elementFixedValueTest() {
        TestMcpServerHandler handler();
        list<hash<AllowedValueInfo>> at_bound = map <AllowedValueInfo>{"value": sprintf("v%d", $1)},
            range(1, McpServerHandler::MaxInlineEnumValues + 1);
        list<hash<AllowedValueInfo>> over_bound = at_bound + (<AllowedValueInfo>{"value": "one-more"},);
        HashDataType type = getElementInputType();
        type.addQoreFields({
            "at": {"name": "at", "type": new ListDataType(AbstractDataProviderTypeMap."string"),
                "element_allowed_values": at_bound},
            "over": {"name": "over", "type": new ListDataType(AbstractDataProviderTypeMap."string"),
                "element_allowed_values": over_bound, "desc": "Codes"},
            "codes": {"name": "codes", "type": new ListDataType(AbstractDataProviderTypeMap."int"),
                "element_allowed_values": (<AllowedValueInfo>{"value": 1}, <AllowedValueInfo>{"value": 2})},
        });
        handler.registerTool("from-type", "a tool", type, sub (auto v) {});
        handler.registerToolWithTypeInfo("from-info", "a tool", type.getInfo(), sub (auto v) {});
        foreach string tool in (("from-type", "from-info")) {
            hash<auto> props = handler.getInput(tool).properties;
            assertEq(McpServerHandler::MaxInlineEnumValues, props.at.items."enum".size(), tool);
            assertEq("v1", props.at.items."enum"[0], tool);
            # the elements' values are not the values of the list
            assertFalse(props.at.hasKey("enum"), tool);
            assertFalse(props.over.items.hasKey("enum"), tool);
            assertEq(sprintf("Codes Each element is one of %d fixed values; a list with an element that is not "
                "one of them is rejected when the tool is called.", McpServerHandler::MaxInlineEnumValues + 1),
                props.over.description, tool);
            assertEq((1, 2), props.codes.items."enum", tool);
            assertEq("integer", props.codes.items.type, tool);
            # values that only suggest an element would reject the others as an enum, so the description lists them
            assertFalse(props.languages.items.hasKey("enum"), tool);
            assertFalse(props.languages.hasKey("enum"), tool);
            assertEq("The languages Suggested values for each element: \"en\", \"de\"; other values are accepted "
                "too.", props.languages.description, tool);
        }
    }

    suggestedValueTest() {
        list<hash<AllowedValueInfo>> over_bound = (map <AllowedValueInfo>{"value": sprintf("v%d", $1)},
            range(1, McpServerHandler::MaxInlineEnumValues + 1)) + (<AllowedValueInfo>{"value": "one-more"},);
        assertEq(McpServerHandler::MaxInlineEnumValues + 1, over_bound.size());
        HashDataType type("Models");
        type.addQoreFields({
            "model": {"name": "model", "type": AbstractDataProviderTypeMap."string", "desc": "The model",
                "allowed_values": (<AllowedValueInfo>{"value": "gpt-4o"}, <AllowedValueInfo>{"value": "gpt-4.1"}),
                "allowed_values_creatable": True},
            "size": {"name": "size", "type": AbstractDataProviderTypeMap."*int",
                "allowed_values": (<AllowedValueInfo>{"value": 256}, <AllowedValueInfo>{"value": 512}),
                "allowed_values_creatable": True},
            "code": {"name": "code", "type": AbstractDataProviderTypeMap."string", "desc": "A code",
                "allowed_values": over_bound, "allowed_values_creatable": True},
            "codes": {"name": "codes", "type": new ListDataType(AbstractDataProviderTypeMap."string"),
                "element_allowed_values": over_bound, "element_allowed_values_creatable": True},
        });
        TestMcpServerHandler handler();
        handler.registerTool("from-type", "a tool", type, sub (auto v) {});
        handler.registerToolWithTypeInfo("from-info", "a tool", type.getInfo(), sub (auto v) {});
        foreach string tool in (("from-type", "from-info")) {
            hash<auto> props = handler.getInput(tool).properties;
            # another model is accepted, so the suggestions are not an enum
            assertFalse(props.model.hasKey("enum"), tool);
            assertEq("The model Suggested values: \"gpt-4o\", \"gpt-4.1\"; other values are accepted too.",
                props.model.description, tool);
            assertEq("Suggested values: 256, 512; other values are accepted too.", props.size.description, tool);
            assertFalse(props.size.hasKey("enum"), tool);
            # more suggestions than the bound are described by their number
            assertEq(sprintf("A code The value can be one of %d suggested values or another value.",
                McpServerHandler::MaxInlineEnumValues + 1), props.code.description, tool);
            assertEq(sprintf("Each element can be one of %d suggested values or another value.",
                McpServerHandler::MaxInlineEnumValues + 1), props.codes.description, tool);
            assertFalse(props.codes.items.hasKey("enum"), tool);
        }
        assertEq(make_json(handler.getInput("from-type")), make_json(handler.getInput("from-info")));

        # a subclass words the sentence
        LookupMcpServerHandler lookup();
        lookup.registerTool("from-type", "a tool", type, sub (auto v) {});
        lookup.registerToolWithTypeInfo("from-info", "a tool", type.getInfo(), sub (auto v) {});
        foreach string tool in (("from-type", "from-info")) {
            hash<auto> props = lookup.getInput(tool).properties;
            assertEq("The model model suggests 2 value(s).", props.model.description, tool);
            assertEq(sprintf("codes suggests %d value(s) for each element.", McpServerHandler::MaxInlineEnumValues + 1),
                props.codes.description, tool);
        }
    }
}
