#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires json

%requires QUnit
%requires HttpServer
%requires Logger
%requires Mime
%requires DataProvider
%requires JsonRpcHandler
%requires McpServerHandler
%exec-class McpServerHandlerTypeGraphTest

#! Registers tools whose input types are not trees
class TypeGraphMcpServerHandler inherits McpServerHandler {
    constructor(LoggerInterface logger, AbstractDataProviderType dag, AbstractDataProviderType cyclic)
            : McpServerHandler(logger, new PermissiveAuthenticator()) {
        registerTool("dag-tool", "a tool whose input type shares subtypes", dag, \noop());
        registerTool("cyclic-tool", "a tool whose input type is self-referencing", cyclic, \noop());
    }

    auto noop(auto arg) {
        return arg;
    }

    #! Returns the input schema published for the given tool
    *hash<auto> getToolInputSchema(string name) {
        return tmap{name}.input;
    }
}

#! Registers tools whose inputs are wildcards: a value of any type, or a union of different base types
class WildcardMcpServerHandler inherits McpServerHandler {
    constructor(LoggerInterface logger) : McpServerHandler(logger, new PermissiveAuthenticator()) {
        HashDataType fields();
        fields.addField(new QoreDataField("label", "a plain string", StringType));
        fields.addField(new QoreDataField("any_value", "an optional value of any type", AutoType));
        fields.addField(new QoreDataField("choice", "a string or an integer",
            new QoreUnionDataType(("string", "int"))));
        fields.addField(new QoreDataField("choices", "strings or integers",
            new ListDataType("list", new QoreUnionDataType(("string", "int")))));
        registerTool("wildcard-fields-tool", "a tool with wildcard fields", fields, \echo());
        registerTool("optional-wildcard-tool", "a tool taking an optional value of any type",
            AbstractDataProviderTypeMap."auto", \echo());
        registerTool("mandatory-wildcard-tool", "a tool taking a string or an integer",
            new QoreUnionDataType(("string", "int")), \echo());
    }

    auto echo(auto arg) {
        return arg;
    }

    #! Returns the input schema published for the given tool
    *hash<auto> getToolInputSchema(string name) {
        return tmap{name}.input;
    }

    #! Returns True if the given tool receives its input under the \c data argument
    *bool getToolNeedsMap(string name) {
        return tmap{name}.needs_map;
    }
}

#! Tests that building a tool's input schema is bounded in time and memory
/** A tool's input type is traversed as a graph of live type objects, not a tree: a type object reachable from more
    than one parent must be described once, not once per path to it, otherwise building the schema is exponential
    in the depth of the type graph.
*/
public class McpServerHandlerTypeGraphTest inherits QUnit::Test {
    public {
        #! Depth of the shared-subtype DAG; each level references the same child type object 3 times
        /** A traversal that re-describes shared subtypes performs 3 ** 14 (4,782,969) leaf expansions, which
            neither completes in reasonable time nor fits in memory; describing each distinct type object once
            performs 15 of them
        */
        const Depth = 14;

        #! Upper bound on schema generation; the unbounded implementation needs many minutes and many GB here
        const MaxSchemaTime = 30s;
    }

    constructor() : Test("McpServerHandlerTypeGraphTest", "1.0") {
        addTestCase("shared subtypes do not blow up the input schema", \sharedSubtypeSchemaTest());
        addTestCase("self-referencing input types terminate", \cyclicSchemaTest());
        addTestCase("wildcard fields are published as values of any type", \wildcardFieldSchemaTest());
        addTestCase("wildcard tool inputs keep their calling convention", \wildcardInputSchemaTest());

        set_return_value(main());
    }

    #! Returns a logger that discards output
    private LoggerInterface getLogger() {
        Logger logger("test", LoggerLevel::getLevelInfo());
        return logger;
    }

    #! Builds an acyclic type DAG where every level shares the same child type object 3 times
    private AbstractDataProviderType getSharedSubtypeDag(int depth) {
        HashDataType leaf();
        leaf.addField(new QoreDataField("str", "a string field", StringType));

        AbstractDataProviderType rv = leaf;
        for (int i = 0; i < depth; ++i) {
            HashDataType t();
            # all three fields reference the *same* child type object
            foreach string fname in ("a", "b", "c") {
                t.addField(new QoreDataField(fname, "shared subtype", rv));
            }
            rv = t;
        }
        return rv;
    }

    #! A self-referencing input type
    private AbstractDataProviderType getCyclicType() {
        HashDataType rv();
        rv.addField(new QoreDataField("self", "self-referencing field", rv));
        rv.addField(new QoreDataField("str", "a string field", StringType));
        return rv;
    }

    sharedSubtypeSchemaTest() {
        AbstractDataProviderType dag = getSharedSubtypeDag(Depth);

        date start = now_us();
        TypeGraphMcpServerHandler handler(getLogger(), dag, getCyclicType());
        date elapsed = now_us() - start;

        assertLt(MaxSchemaTime, elapsed, "building a tool input schema must not re-describe shared subtypes");

        # the schema is intact: Depth levels of "a"/"b"/"c" above the leaf
        *hash<auto> schema = handler.getToolInputSchema("dag-tool");
        assertEq("object", schema.type, "input schema is an object");
        hash<auto> node = schema;
        for (int i = 0; i < Depth; ++i) {
            assertEq(("a", "b", "c"), sort(keys node.properties), sprintf("level %d properties", i));
            node = node.properties.a;
        }
        assertEq(("str",), keys node.properties, "leaf properties");
        assertEq("string", node.properties.str.type, "leaf property type");
    }

    cyclicSchemaTest() {
        date start = now_us();
        TypeGraphMcpServerHandler handler(getLogger(), getSharedSubtypeDag(3), getCyclicType());
        date elapsed = now_us() - start;

        assertLt(MaxSchemaTime, elapsed, "building a self-referencing tool input schema must terminate");

        *hash<auto> schema = handler.getToolInputSchema("cyclic-tool");
        assertEq("string", schema.properties.str.type, "non-recursive property is described");
        # the cycle is truncated with an opaque object rather than followed
        assertEq("object", schema.properties.self.type, "the cycle is described as an opaque object");
        assertNothing(schema.properties.self.properties, "the cycle is truncated rather than followed");
    }
    #! A field of any type, or of a union of different base types, used to be dropped when optional and to fail
    #! the whole tool when mandatory: the wildcard case fell through into the object case
    wildcardFieldSchemaTest() {
        WildcardMcpServerHandler handler(getLogger());
        *hash<auto> schema = handler.getToolInputSchema("wildcard-fields-tool");
        assertEq("object", schema.type, "input schema is an object");

        assertEq("string", schema.properties.label.type, "a typed field is described by its type");

        assertEq({"description": "an optional value of any type"}, schema.properties.any_value,
            "an optional field of any type is published, accepting any value");
        assertFalse(inlist("any_value", schema.required), "an optional wildcard field is not required");

        assertEq({"description": "a string or an integer"}, schema.properties.choice,
            "a union of different base types is published, accepting any value");
        assertTrue(inlist("choice", schema.required), "a mandatory union field stays required");

        hash<auto> choices = schema.properties.choices;
        assertEq("array", choices.type, "a list of union elements is an array");
        assertEq({"description": "array items"}, choices.items,
            "the union elements of a list accept any value");
        assertTrue(inlist("choices", schema.required), "a mandatory list field stays required");
    }

    #! A tool taking one wildcard input
    wildcardInputSchemaTest() {
        WildcardMcpServerHandler handler(getLogger());

        # an optional wildcard input has always been published as taking no structured input, and its tool
        # receives the arguments hash as it is; that calling convention must not change
        assertEq(McpServerHandler::NoInputDescription, handler.getToolInputSchema("optional-wildcard-tool"),
            "an optional wildcard input keeps the no-input description");
        assertFalse(handler.getToolNeedsMap("optional-wildcard-tool") ?? False,
            "an optional wildcard input still receives the arguments hash");

        # a mandatory wildcard input could not be published at all; it is wrapped like any non-object input
        *hash<auto> schema = handler.getToolInputSchema("mandatory-wildcard-tool");
        assertEq("object", schema.type, "a mandatory wildcard input is published as an object");
        assertEq({}, schema.properties.data, "its data argument accepts any value");
        assertEq(("data",), schema.required, "its data argument is required");
        assertTrue(handler.getToolNeedsMap("mandatory-wildcard-tool"),
            "a mandatory wildcard input receives its value under data");
    }
}
