    #! Test promotional credit operations
    /** Creates a temporary customer, adds/deducts/sets promotional credits, then cleans up.
    */
    private testPromotionalCreditOperations() {
        if (m_options.verbose) {
            printf("\n--- Testing Promotional Credit Operations ---\n");
        }

        ChargebeeDataProvider::ChargebeeDataProvider prov(client);

        # Create a temporary customer for credit operations
        string testEmail = sprintf("promo_test_%s_%d@example.com",
            now_us().format("YYYYMMDDHHmmss"), rand() % 10000);

        AbstractDataProvider createCustomerProvider = prov.getChildProvider("create-customer");
        *string customerId;

        try {
            auto customer = createCustomerProvider.doRequest({
                "first_name": "Promo",
                "last_name": "Test",
                "email": testEmail,
            });
            customerId = customer.id;

            if (m_options.verbose) {
                printf("  Created test customer: %y\n", customerId);
            }

            # Add promotional credits
            if (m_options.verbose) {
                printf("  Adding promotional credits...\n");
            }

            AbstractDataProvider addCreditProvider = prov.getChildProvider("add-promotional-credit");
            auto addResult = addCreditProvider.doRequest({
                "customer_id": customerId,
                "amount": 1000,
                "currency_code": "USD",
                "description": "Test promotional credit",
            });

            assertTrue(exists addResult.id, "Add credit should return customer");

            if (m_options.verbose) {
                printf("    Credits after add: %y\n", addResult.promotional_credits);
            }

            # Deduct promotional credits
            if (m_options.verbose) {
                printf("  Deducting promotional credits...\n");
            }

            AbstractDataProvider deductCreditProvider = prov.getChildProvider("deduct-promotional-credit");
            auto deductResult = deductCreditProvider.doRequest({
                "customer_id": customerId,
                "amount": 500,
                "currency_code": "USD",
                "description": "Test deduction",
            });

            assertTrue(exists deductResult.id, "Deduct credit should return customer");
            if (m_options.verbose) {
                printf("    Credits after deduct: %y\n", deductResult.promotional_credits);
            }

            # Set promotional credits
            if (m_options.verbose) {
                printf("  Setting promotional credits...\n");
            }

            AbstractDataProvider setCreditProvider = prov.getChildProvider("set-promotional-credit");
            auto setResult = setCreditProvider.doRequest({
                "customer_id": customerId,
                "amount": 2000,
                "currency_code": "USD",
                "description": "Test set credit",
            });

            assertTrue(exists setResult.id, "Set credit should return customer");

            if (m_options.verbose) {
                printf("    Credits after set: %y\n", setResult.promotional_credits);
            }

            # Cleanup: delete the test customer
            AbstractDataProvider deleteCustomerProvider = prov.getChildProvider("delete-customer");
            deleteCustomerProvider.doRequest({"id": customerId});
            if (m_options.verbose) {
                printf("  Cleaned up test customer: %y\n", customerId);
            }

        } catch (hash<ExceptionInfo> ex) {
            # Cleanup on failure
            if (customerId) {
                try {
                    AbstractDataProvider deleteCustomerProvider = prov.getChildProvider("delete-customer");
                    deleteCustomerProvider.doRequest({"id": customerId});
                } catch () {}
            }
            if (m_options.verbose) {
                printf("  Promotional credit test failed: %s: %s\n", ex.err, ex.desc);
            }
            rethrow;
        }

        if (m_options.verbose) {
            printf("--- Promotional Credit Operations tests completed ---\n");
        }
    }

    #! Test reference data
    private testReferenceData() {
        if (m_options.verbose) {
            printf("\n--- Testing Reference Data ---\n");
        }

        ChargebeeDataProvider::ChargebeeDataProvider prov(client);

        # Test customers reference data
        *list<hash<AllowedValueInfo>> customers = prov.getReferenceData("customers");
        if (customers && customers.size() > 0) {
            assertTrue(customers[0].display_name.val());
            assertTrue(exists customers[0].value);
            if (m_options.verbose) {
                printf("  Reference data: %d customers available\n", customers.size());
            }
        }

        # Test subscriptions reference data
        *list<hash<AllowedValueInfo>> subscriptions = prov.getReferenceData("subscriptions");
        if (subscriptions && subscriptions.size() > 0) {
            assertTrue(subscriptions[0].display_name.val());
            assertTrue(exists subscriptions[0].value);
            if (m_options.verbose) {
                printf("  Reference data: %d subscriptions available\n", subscriptions.size());
            }
        }

        if (m_options.verbose) {
            printf("--- Reference Data tests completed ---\n");
        }
    }

    #! Event trigger tests - verify event data providers
    eventTriggerTests() {
        checkJson();
        if (!client) {
            testSkip("No Chargebee credentials provided");
            return;
        }

        if (m_options.verbose) {
            printf("\n--- Testing Event Trigger Providers ---\n");
        }

        # ============================================
        # Test Watch Customers Event Provider
        # ============================================
        if (m_options.verbose) {
            printf("\nTesting ChargebeeWatchCustomersEventDataProvider...\n");
        }

        ChargebeeDataProvider::ChargebeeWatchCustomersEventDataProvider watchCustomersProv(client);
        assertEq("watch-customers", watchCustomersProv.getName());
        assertTrue(watchCustomersProv.getInfo().supports_observable);

        hash<string, hash<DataProviderMessageInfo>> customerEventTypes = watchCustomersProv.getEventTypes();
        assertTrue(customerEventTypes.hasKey("watch-customers"));
        assertTrue(customerEventTypes{"watch-customers"}.desc.val());

        # Test example event data
        auto customerExampleData = watchCustomersProv.getExampleEventData("watch-customers");
        assertTrue(customerExampleData.hasKey("id") || customerExampleData.hasKey("event_type"),
            "Example data should have event fields");

        if (m_options.verbose) {
            printf("  Event types: %y\n", keys customerEventTypes);
        }

        # ============================================
        # Test Watch Events Event Provider
        # ============================================
        if (m_options.verbose) {
            printf("\nTesting ChargebeeWatchEventsEventDataProvider...\n");
        }

        ChargebeeDataProvider::ChargebeeWatchEventsEventDataProvider watchEventsProv(client);
        assertEq("watch-events", watchEventsProv.getName());
        assertTrue(watchEventsProv.getInfo().supports_observable);

        hash<string, hash<DataProviderMessageInfo>> allEventTypes = watchEventsProv.getEventTypes();
        assertTrue(allEventTypes.hasKey("watch-events"));

        if (m_options.verbose) {
            printf("  Event types: %y\n", keys allEventTypes);
        }

        # ============================================
        # Test Watch Invoices Event Provider
        # ============================================
        if (m_options.verbose) {
            printf("\nTesting ChargebeeWatchInvoicesEventDataProvider...\n");
        }

        ChargebeeDataProvider::ChargebeeWatchInvoicesEventDataProvider watchInvoicesProv(client);
        assertEq("watch-invoices", watchInvoicesProv.getName());
        assertTrue(watchInvoicesProv.getInfo().supports_observable);

        hash<string, hash<DataProviderMessageInfo>> invoiceEventTypes = watchInvoicesProv.getEventTypes();
        assertTrue(invoiceEventTypes.hasKey("watch-invoices"));

        if (m_options.verbose) {
            printf("  Event types: %y\n", keys invoiceEventTypes);
        }

        # ============================================
        # Test Watch Subscriptions Event Provider
        # ============================================
        if (m_options.verbose) {
            printf("\nTesting ChargebeeWatchSubscriptionsEventDataProvider...\n");
        }

        ChargebeeDataProvider::ChargebeeWatchSubscriptionsEventDataProvider watchSubsProv(client);
        assertEq("watch-subscriptions", watchSubsProv.getName());
        assertTrue(watchSubsProv.getInfo().supports_observable);

        hash<string, hash<DataProviderMessageInfo>> subEventTypes = watchSubsProv.getEventTypes();
        assertTrue(subEventTypes.hasKey("watch-subscriptions"));

        if (m_options.verbose) {
            printf("  Event types: %y\n", keys subEventTypes);
        }

        if (m_options.verbose) {
            printf("\n--- Event Trigger tests completed ---\n");
        }
    }
