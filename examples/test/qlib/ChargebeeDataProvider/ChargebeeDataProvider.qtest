                couponsProvider.searchRecords(NOTHING, {"id": testCouponId});

            assertTrue(verifyResults.size() > 0, "Should still find the coupon");
            assertEq("Updated Coupon " + testCouponId, verifyResults[0].name, "Coupon name should be updated");

            if (m_options.verbose) {
                printf("    Update persistence verified\n");
            }

            # Step 5: Delete coupon
            if (m_options.verbose) {
                printf("  Step 5: Delete coupon...\n");
            }

            AbstractDataProvider deleteProvider = prov.getChildProvider("delete-coupon");
            auto deleteResult = deleteProvider.doRequest({
                "id": testCouponId,
            });

            assertTrue(exists deleteResult.id, "Delete should return the coupon");
            if (m_options.verbose) {
                printf("    Deleted coupon: %y\n", testCouponId);
            }
            testCouponId = NOTHING;

        } catch (hash<ExceptionInfo> ex) {
            # Cleanup on failure
            if (testCouponId) {
