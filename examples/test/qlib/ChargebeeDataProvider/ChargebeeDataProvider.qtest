    #! Test events collection provider (listing past events)
    private testEventsCollectionProvider() {
        if (m_options.verbose) {
            printf("\n--- Testing Events Collection Provider ---\n");
        }

        ChargebeeDataProvider::ChargebeeDataProvider prov(client);

        # The "events" child is the event trigger container, not the list endpoint
        # But we can verify the events container works
        AbstractDataProvider eventsProvider = prov.getChildProvider("events");
        hash<DataProviderInfo> info = eventsProvider.getInfo();

        assertTrue(info.supports_children, "Events should support children");
        assertTrue(info.children_can_support_observers, "Events children should support observers");

        list<string> eventChildren = eventsProvider.getChildProviderNames();
        assertTrue(eventChildren.size() > 0, "Should have event type children");

        if (m_options.verbose) {
            printf("  Event types: %y\n", eventChildren);
        }
    }

    #! Test customer CRUD - create, get, update, verify, delete
    /** CRITICAL: This test verifies that customer data is correctly saved and retrievable.
        This catches issues like:
        - Wrong Content-Type
        - Silent API acceptance without data persistence
        - Incorrect field handling
    */
    private testCustomerCrud() {
        if (m_options.verbose) {
            printf("\n--- Testing Customer CRUD ---\n");
        }

        ChargebeeDataProvider::ChargebeeDataProvider prov(client);

        # Generate unique test identifiers
        string testEmail = sprintf("test_%s_%d@example.com",
            now_us().format("YYYYMMDDHHmmss"), rand() % 10000);

        # Step 1: Create customer
        if (m_options.verbose) {
            printf("\n  Step 1: Create customer...\n");
        }

        AbstractDataProvider createProvider = prov.getChildProvider("create-customer");

        try {
            auto createResult = createProvider.doRequest({
                "first_name": "Test",
                "last_name": "Customer",
                "email": testEmail,
                "company": "Qore Test Corp",
            });

            if (m_options.verbose) {
                printf("    Created customer: id=%y, email=%y\n", createResult.id, createResult.email);
            }
            assertTrue(exists createResult.id, "Customer should be created with an ID");
            testCustomerId = createResult.id;

            # Step 2: Get customer via collection search
            if (m_options.verbose) {
                printf("  Step 2: Get customer...\n");
            }

            AbstractDataProvider customersProvider = prov.getChildProvider("customers");
            list<hash<auto>> results = map $1,
                customersProvider.searchRecords(NOTHING, {"id": testCustomerId});

            assertTrue(results.size() > 0, "Should find the created customer");
            assertEq(testCustomerId, results[0].id, "Customer ID should match");
            assertEq(testEmail, results[0].email, "Customer email should match");
            assertEq("Test", results[0].first_name, "Customer first name should match");
            assertEq("Customer", results[0].last_name, "Customer last name should match");

            if (m_options.verbose) {
                printf("    Data integrity verified: customer saved and retrieved correctly\n");
            }

            # Step 3: Update customer
            if (m_options.verbose) {
                printf("  Step 3: Update customer...\n");
            }

            AbstractDataProvider updateProvider = prov.getChildProvider("update-customer");
            auto updateResult = updateProvider.doRequest({
                "id": testCustomerId,
                "first_name": "Updated",
                "company": "Updated Corp",
            });

            assertTrue(exists updateResult.id, "Update should return customer");
            if (m_options.verbose) {
                printf("    Updated customer: first_name=%y, company=%y\n",
                    updateResult.first_name, updateResult.company);
            }

            # Step 4: Verify update persisted
            if (m_options.verbose) {
                printf("  Step 4: Verify update...\n");
            }

            list<hash<auto>> verifyResults = map $1,
                customersProvider.searchRecords(NOTHING, {"id": testCustomerId});

            assertTrue(verifyResults.size() > 0, "Should still find the customer");
            assertEq("Updated", verifyResults[0].first_name, "First name should be updated");
            assertEq("Updated Corp", verifyResults[0].company, "Company should be updated");
            assertEq(testEmail, verifyResults[0].email, "Email should be unchanged");

            if (m_options.verbose) {
                printf("    Update persistence verified\n");
            }

            # Step 5: Delete customer
            if (m_options.verbose) {
                printf("  Step 5: Delete customer...\n");
            }

            AbstractDataProvider deleteProvider = prov.getChildProvider("delete-customer");
            auto deleteResult = deleteProvider.doRequest({
                "id": testCustomerId,
            });

            assertTrue(exists deleteResult.id, "Delete should return the customer");
            if (m_options.verbose) {
                printf("    Deleted customer: %y\n", testCustomerId);
            }
            testCustomerId = NOTHING;

        } catch (hash<ExceptionInfo> ex) {
            # Cleanup on failure
            if (testCustomerId) {
                try {
                    AbstractDataProvider deleteProvider = prov.getChildProvider("delete-customer");
                    deleteProvider.doRequest({"id": testCustomerId});
                    if (m_options.verbose) {
                        printf("    Cleaned up test customer: %y\n", testCustomerId);
                    }
                    testCustomerId = NOTHING;
                } catch () {}
            }
            if (m_options.verbose) {
                printf("  Customer CRUD failed: %s: %s\n", ex.err, ex.desc);
            }
            rethrow;
        }

        if (m_options.verbose) {
            printf("--- Customer CRUD tests completed ---\n");
        }
    }

    #! Test coupon CRUD - create, get, update, verify, delete
    private testCouponCrud() {
        if (m_options.verbose) {
            printf("\n--- Testing Coupon CRUD ---\n");
        }

        ChargebeeDataProvider::ChargebeeDataProvider prov(client);

        # Generate unique coupon ID
        string couponId = sprintf("TEST_COUPON_%s_%d",
            now_us().format("YYYYMMDDHHmmss"), rand() % 10000);

