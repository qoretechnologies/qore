    #! Test promotional credits collection provider
    private testPromotionalCreditsProvider() {
        if (m_options.verbose) {
            printf("\n--- Testing Promotional Credits Provider ---\n");
        }

        ChargebeeDataProvider::ChargebeeDataProvider prov(client);

        AbstractDataProvider promoProvider = prov.getChildProvider("promotional-credits");
        hash<DataProviderInfo> info = promoProvider.getInfo();

        assertTrue(info.supports_read, "Promotional credits should support read");
