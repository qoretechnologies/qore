%modern

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/DataProvider
%requires ../../../../qlib/ConnectionProvider
%requires ../../../../qlib/RestClient.qm
%requires ../../../../qlib/Mime.qm

%try-module json
%define NoJson
%endtry

%requires ../../../../qlib/ChargebeeRestClient.qm
%requires ../../../../qlib/ChargebeeDataProvider

%exec-class ChargebeeDataProviderTest

public class ChargebeeDataProviderTest inherits QUnit::Test {
    private {
        #! Chargebee REST client for integration tests
        *ChargebeeRestClient::ChargebeeRestClient client;

        #! Logger for verbose output
        Logger logger;

        #! Custom command-line options
        const MyOpts = Opts + {
            "apikey": "k,apikey=s",
            "site": "s,site=s",
            "conn": "c,connection=s",
        };

        #! Test customer ID created during tests (for cleanup)
        *string testCustomerId;

        #! Test coupon ID created during tests (for cleanup)
        *string testCouponId;
    }

    constructor() : Test("ChargebeeDataProvider Test", "1.0", \ARGV, MyOpts) {
        logger = new Logger("test", LoggerLevel::getLevelInfo());

        # Sanity tests (always run, no credentials needed)
        addTestCase("sanity tests", \sanityTests());
        addTestCase("factory tests", \factoryTests());
        addTestCase("metadata tests", \metadataTests());
        addTestCase("child provider tests", \childProviderTests());
        addTestCase("data type tests", \dataTypeTests());
        addTestCase("negative tests", \negativeTests());
        addTestCase("corner case tests", \cornerCaseTests());
        addTestCase("connection tests", \connectionTests());
        addTestCase("action catalog tests", \actionCatalogTests());

        # Integration tests (require CHARGEBEE_API_KEY and CHARGEBEE_SITE)
        addTestCase("integration tests", \integrationTests());

        # Event/trigger tests
        addTestCase("event trigger tests", \eventTriggerTests());

        # Try to set up connection for integration tests
        try {
            setupConnection();
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("Connection setup failed: %s: %s\n", ex.err, ex.desc);
            }
        }

        set_return_value(main());
    }

    #! Sets up the Chargebee client for integration tests
    private setupConnection() {
        *string apikey = m_options.apikey ?? ENV.CHARGEBEE_API_KEY;
        *string site = m_options.site ?? ENV.CHARGEBEE_SITE;
        if (!apikey || !site) {
            if (m_options.verbose) {
                printf("No API credentials provided (use -k/-s options or CHARGEBEE_API_KEY/CHARGEBEE_SITE env vars)\n");
            }
            return;
        }
        hash<auto> opts = {
            "api_key": apikey,
            "site": site,
        };
        client = new ChargebeeRestClient::ChargebeeRestClient(opts);
    }

    #! Check if json module is available
    private checkJson() {
%ifdef NoJson
        testSkip("no json module present");
%endif
    }

    #! Creates a ChargebeeDataProvider for unit tests
    /** Catches connection errors and skips the test (for CI where external APIs may be unavailable)
        @return the provider, or NOTHING if the test should be skipped
    */
    private *ChargebeeDataProvider::ChargebeeDataProvider tryCreateProvider() {
        try {
            return new ChargebeeDataProvider::ChargebeeDataProvider({
                "api_key": "test_xxx",
                "site": "test-site",
            });
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "SOCKET-CONNECT-ERROR" || ex.err == "SOCKET-SSL-ERROR") {
                testSkip(sprintf("cannot connect to Chargebee API: %s", ex.desc));
            }
            rethrow;
        }
    }

    #! Basic sanity tests - provider instantiation
    sanityTests() {
        checkJson();
        # Test creating provider with fake credentials
        *ChargebeeDataProvider::ChargebeeDataProvider prov = tryCreateProvider();
        if (!prov) {
            return;
        }
        assertEq("chargebee", prov.getName());
        assertEq("Chargebee data provider for subscription billing and revenue management", prov.getDesc());
    }

    #! Factory tests - verify factory registration
    factoryTests() {
        checkJson();
        # Verify factory is registered
        AbstractDataProviderFactory factory = DataProvider::getFactory("chargebee");
        assertEq("chargebee", factory.getInfo().name);
        assertEq("Chargebee data provider factory for subscription billing and revenue management",
            factory.getInfo().desc);
        assertTrue(factory.getInfo().children_can_support_apis);
        assertTrue(factory.getInfo().children_can_support_records);

        # Verify factory can create provider with options
        hash<auto> factoryOpts = factory.getInfo().provider_info.constructor_options;
        assertTrue(factoryOpts.hasKey("api_key"));
        assertTrue(factoryOpts.hasKey("site"));
        assertTrue(factoryOpts.hasKey("chargebeerestclient"));
        assertTrue(factoryOpts.hasKey("chargebeerestclient_options"));
    }

    #! Metadata tests - verify provider info structure
    metadataTests() {
        checkJson();
        *ChargebeeDataProvider::ChargebeeDataProvider prov = tryCreateProvider();
        if (!prov) {
            return;
        }
        hash<DataProviderInfo> info = prov.getInfo();

        assertTrue(info.supports_children);
        assertTrue(info.children_can_support_apis);
        assertTrue(info.children_can_support_records);
        assertEq("ChargebeeDataProvider", info.type);

        # Check constructor options
        assertTrue(info.constructor_options.hasKey("api_key"));
        assertTrue(info.constructor_options.hasKey("site"));
        assertTrue(info.constructor_options.hasKey("chargebeerestclient"));
    }

    #! Child provider tests - verify hierarchy
    childProviderTests() {
        checkJson();
        *ChargebeeDataProvider::ChargebeeDataProvider prov = tryCreateProvider();
        if (!prov) {
            return;
        }

        # Check child provider names
        list<string> children = prov.getChildProviderNames();

        # Collection providers
        assertTrue(children.contains("customers"));
        assertTrue(children.contains("subscriptions"));
        assertTrue(children.contains("invoices"));
        assertTrue(children.contains("coupons"));
        assertTrue(children.contains("promotional-credits"));

        # Customer actions
        assertTrue(children.contains("create-customer"));
        assertTrue(children.contains("update-customer"));
        assertTrue(children.contains("delete-customer"));

        # Subscription actions
        assertTrue(children.contains("create-subscription"));
        assertTrue(children.contains("update-subscription"));
        assertTrue(children.contains("delete-subscription"));

        # Invoice actions
        assertTrue(children.contains("create-invoice"));
        assertTrue(children.contains("update-invoice"));
        assertTrue(children.contains("delete-invoice"));
        assertTrue(children.contains("collect-invoice-payment"));
        assertTrue(children.contains("record-invoice-payment"));
        assertTrue(children.contains("refund-invoice"));
        assertTrue(children.contains("get-invoice-link"));

        # Coupon actions
        assertTrue(children.contains("create-coupon"));
        assertTrue(children.contains("update-coupon"));
        assertTrue(children.contains("delete-coupon"));

        # Promotional credit actions
        assertTrue(children.contains("add-promotional-credit"));
        assertTrue(children.contains("deduct-promotional-credit"));
        assertTrue(children.contains("set-promotional-credit"));

        # Transaction actions
        assertTrue(children.contains("get-transaction"));

        # Event providers
        assertTrue(children.contains("events"));

        # Check customers child provider
        AbstractDataProvider customers = prov.getChildProvider("customers");
        assertEq("customers", customers.getName());
        hash<DataProviderInfo> customersInfo = customers.getInfo();
        assertTrue(customersInfo.supports_read);
        assertTrue(customersInfo.supports_native_search);
        assertTrue(customersInfo.has_record);

        # Check create-customer child provider
        AbstractDataProvider createCustomer = prov.getChildProvider("create-customer");
        assertEq("create-customer", createCustomer.getName());
        hash<DataProviderInfo> createCustomerInfo = createCustomer.getInfo();
        assertTrue(createCustomerInfo.supports_request);

        # Check events child provider
        AbstractDataProvider events = prov.getChildProvider("events");
        assertEq("events", events.getName());
        hash<DataProviderInfo> eventsInfo = events.getInfo();
        assertTrue(eventsInfo.supports_children);
        assertTrue(eventsInfo.children_can_support_observers);

        # Check events child providers
        list<string> eventChildren = events.getChildProviderNames();
        assertTrue(eventChildren.contains("watch-customers"));
        assertTrue(eventChildren.contains("watch-events"));
        assertTrue(eventChildren.contains("watch-invoices"));
        assertTrue(eventChildren.contains("watch-subscriptions"));
    }

    #! Data type tests - verify record type definitions
    dataTypeTests() {
        checkJson();
        # Test customer data type
        ChargebeeDataProvider::ChargebeeCustomerDataType customerType();
        hash<string, AbstractDataField> customerFields = customerType.getFields();
        assertTrue(customerFields.hasKey("id"));
        assertTrue(customerFields.hasKey("first_name"));
        assertTrue(customerFields.hasKey("last_name"));
        assertTrue(customerFields.hasKey("email"));
        assertTrue(customerFields.hasKey("phone"));
        assertTrue(customerFields.hasKey("company"));
        assertTrue(customerFields.hasKey("auto_collection"));
        assertTrue(customerFields.hasKey("created_at"));
        assertTrue(customerFields.hasKey("updated_at"));
        assertTrue(customerFields.hasKey("promotional_credits"));

        # Test coupon data type
        ChargebeeDataProvider::ChargebeeCouponDataType couponType();
        hash<string, AbstractDataField> couponFields = couponType.getFields();
        assertTrue(couponFields.hasKey("id"));
        assertTrue(couponFields.hasKey("name"));
        assertTrue(couponFields.hasKey("discount_type"));
        assertTrue(couponFields.hasKey("discount_percentage"));
        assertTrue(couponFields.hasKey("discount_amount"));

        # Test subscription data type
        ChargebeeDataProvider::ChargebeeSubscriptionDataType subscriptionType();
        hash<string, AbstractDataField> subscriptionFields = subscriptionType.getFields();
        assertTrue(subscriptionFields.hasKey("id"));
        assertTrue(subscriptionFields.hasKey("customer_id"));
        assertTrue(subscriptionFields.hasKey("status"));

        # Test invoice data type
        ChargebeeDataProvider::ChargebeeInvoiceDataType invoiceType();
        hash<string, AbstractDataField> invoiceFields = invoiceType.getFields();
        assertTrue(invoiceFields.hasKey("id"));
        assertTrue(invoiceFields.hasKey("customer_id"));
        assertTrue(invoiceFields.hasKey("status"));

        # Test event data type
        ChargebeeDataProvider::ChargebeeEventDataType eventType();
        hash<string, AbstractDataField> eventFields = eventType.getFields();
        assertTrue(eventFields.hasKey("id"));
        assertTrue(eventFields.hasKey("event_type"));
        assertTrue(eventFields.hasKey("occurred_at"));

        # Test promotional credit data type
        ChargebeeDataProvider::ChargebeePromotionalCreditDataType promoType();
        hash<string, AbstractDataField> promoFields = promoType.getFields();
        assertTrue(promoFields.hasKey("id") || promoFields.hasKey("customer_id") || promoFields.size() > 0,
            "Promotional credit data type should have fields");

        # Test transaction data type
        ChargebeeDataProvider::ChargebeeTransactionDataType transactionType();
        hash<string, AbstractDataField> transactionFields = transactionType.getFields();
        assertTrue(transactionFields.hasKey("id") || transactionFields.size() > 0,
            "Transaction data type should have fields");
    }

    #! Negative tests - test error handling and invalid inputs
    negativeTests() {
        checkJson();
        *ChargebeeDataProvider::ChargebeeDataProvider prov = tryCreateProvider();
        if (!prov) {
            return;
        }

        # Test getting non-existent child provider
        assertThrows("INVALID-CHILD-PROVIDER", sub() {
            prov.getChildProviderEx("nonexistent");
        });

        # Test invalid child in events provider
        AbstractDataProvider events = prov.getChildProvider("events");
        assertThrows("INVALID-CHILD-PROVIDER", sub() {
            events.getChildProviderEx("invalid-event-type");
        });
    }

    #! Corner case tests - edge cases and boundary conditions
    cornerCaseTests() {
        checkJson();
        # Test REST client URL construction
        try {
            ChargebeeRestClient::ChargebeeRestClient client1({
                "api_key": "test_xxx",
                "site": "test-site",
            });
            assertTrue(client1.getURL() =~ /test-site\.chargebee\.com/);
            assertTrue(client1.getURL() =~ /api\/v2$/);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "SOCKET-CONNECT-ERROR" || ex.err == "SOCKET-SSL-ERROR") {
                testSkip(sprintf("cannot connect to Chargebee API: %s", ex.desc));
                return;
            }
            rethrow;
        }

        # Test missing api_key throws error
        assertThrows("CHARGEBEE-ERROR", sub() {
            new ChargebeeRestClient::ChargebeeRestClient({"site": "test-site"});
        });

        # Test missing site throws error
        assertThrows("CHARGEBEE-ERROR", sub() {
            new ChargebeeRestClient::ChargebeeRestClient({"api_key": "test_xxx"});
        });

        # Test missing both throws error
        assertThrows("CHARGEBEE-ERROR", sub() {
            new ChargebeeRestClient::ChargebeeRestClient({});
        });
    }

    #! Connection tests - verify connection scheme registration
    connectionTests() {
        checkJson();
        # Verify connection scheme is registered
        hash<ConnectionSchemeInfo> scheme = ConnectionSchemeCache::getScheme("chargebee");
        assertEq("Chargebee REST Connection", scheme.display_name);
        assertTrue(scheme.options.hasKey("api_key"));
        assertTrue(scheme.options.hasKey("site"));
        assertTrue(scheme.options."api_key".sensitive);

        # Verify connection can create data provider
        ChargebeeRestClient::ChargebeeRestConnection conn("test", "test connection",
            "chargebee://test-site.chargebee.com/api/v2", {},
            {"api_key": "test_xxx", "site": "test-site"});
        assertTrue(conn.hasDataProvider());
        assertEq("Chargebee", conn.getAppName());
        assertEq("chargebee", conn.getType());
    }

    #! Action catalog tests - verify all actions are registered
    actionCatalogTests() {
        checkJson();
        # Get all actions for the Chargebee app
        *list<hash<DataProviderActionInfo>> actions = DataProviderActionCatalog::getActions(
            ChargebeeDataProvider::AppName);

        # If the module does not yet register actions in an init block, skip this test
        if (!actions || actions.size() == 0) {
            testSkip("Chargebee action catalog not yet registered (module init pending)");
            return;
        }

        assertTrue(actions.size() > 0);

        # Verify action names
        list<string> actionNames = map $1.action, actions;

        # Customer actions
        assertTrue(actionNames.contains("find-customers"));
        assertTrue(actionNames.contains("get-customer"));
        assertTrue(actionNames.contains("create-customer"));
        assertTrue(actionNames.contains("update-customer"));
        assertTrue(actionNames.contains("delete-customer"));

        # Subscription actions
        assertTrue(actionNames.contains("find-subscriptions"));
        assertTrue(actionNames.contains("get-subscription"));
        assertTrue(actionNames.contains("create-subscription"));
        assertTrue(actionNames.contains("update-subscription"));
        assertTrue(actionNames.contains("delete-subscription"));

        # Invoice actions
        assertTrue(actionNames.contains("find-invoices"));
        assertTrue(actionNames.contains("get-invoice"));
        assertTrue(actionNames.contains("create-invoice"));
        assertTrue(actionNames.contains("update-invoice"));
        assertTrue(actionNames.contains("delete-invoice"));
        assertTrue(actionNames.contains("collect-invoice-payment"));
        assertTrue(actionNames.contains("record-invoice-payment"));
        assertTrue(actionNames.contains("refund-invoice"));
        assertTrue(actionNames.contains("get-invoice-link"));

        # Coupon actions
        assertTrue(actionNames.contains("find-coupons"));
        assertTrue(actionNames.contains("get-coupon"));
        assertTrue(actionNames.contains("create-coupon"));
        assertTrue(actionNames.contains("update-coupon"));
        assertTrue(actionNames.contains("delete-coupon"));

        # Promotional credit actions
        assertTrue(actionNames.contains("find-promotional-credits"));
        assertTrue(actionNames.contains("get-promotional-credit"));
        assertTrue(actionNames.contains("add-promotional-credit"));
        assertTrue(actionNames.contains("deduct-promotional-credit"));
        assertTrue(actionNames.contains("set-promotional-credit"));

        # Transaction actions
        assertTrue(actionNames.contains("get-transaction"));

        # Trigger actions
        assertTrue(actionNames.contains("watch-customers"));
        assertTrue(actionNames.contains("watch-events"));
        assertTrue(actionNames.contains("watch-invoices"));
        assertTrue(actionNames.contains("watch-subscriptions"));

        # Verify trigger actions have correct action_code
        *hash<DataProviderActionInfo> watchCustomersAction = DataProviderActionCatalog::getAppAction(
            ChargebeeDataProvider::AppName, "watch-customers");
        if (watchCustomersAction) {
            assertEq(DPAT_EVENT, watchCustomersAction.action_code);
        }

        if (m_options.verbose) {
            printf("  Total registered actions: %d\n", actions.size());
        }
    }

    #! Integration tests - require CHARGEBEE_API_KEY and CHARGEBEE_SITE
    integrationTests() {
        checkJson();
        if (!client) {
            testSkip("No Chargebee credentials provided (use -k/-s options or "
                "CHARGEBEE_API_KEY/CHARGEBEE_SITE env vars)");
            return;
        }

        # Test API connectivity
        testApiConnectivity();

        # Test customers provider
        testCustomersProvider();

        # Test subscriptions provider
        testSubscriptionsProvider();

        # Test invoices provider
        testInvoicesProvider();

        # Test coupons provider
        testCouponsProvider();

        # Test promotional credits provider
        testPromotionalCreditsProvider();

        # Test events provider
        testEventsCollectionProvider();

        # Test customer CRUD: create -> get -> update -> verify -> delete
        testCustomerCrud();

        # Test coupon CRUD: create -> get -> update -> verify -> delete
        testCouponCrud();

        # Test promotional credit operations (requires a customer)
        testPromotionalCreditOperations();

        # Test reference data
        testReferenceData();
    }

    #! Test API connectivity
    private testApiConnectivity() {
        if (m_options.verbose) {
            printf("\n--- Testing API Connectivity ---\n");
        }

        # Test that we can connect to the API
        hash<auto> response = client.get("subscriptions?limit=1");
        assertTrue(response.body.typeCode() == NT_HASH);
        if (m_options.verbose) {
            printf("  Connected to Chargebee API successfully\n");
        }
    }

    #! Test customers collection provider
    private testCustomersProvider() {
        if (m_options.verbose) {
            printf("\n--- Testing Customers Provider ---\n");
        }

        ChargebeeDataProvider::ChargebeeDataProvider prov(client);

        AbstractDataProvider customersProvider = prov.getChildProvider("customers");
        hash<DataProviderInfo> info = customersProvider.getInfo();

        assertTrue(info.supports_read, "Customers should support read");
        assertTrue(info.supports_native_search, "Customers should support native search");
        assertTrue(info.has_record, "Customers should have record type");

        # Verify search options exist
        assertTrue(info.search_options.hasKey("id"), "Should have id search option");
        assertTrue(info.search_options.hasKey("email"), "Should have email search option");
        assertTrue(info.search_options.hasKey("limit"), "Should have limit search option");

        # Fetch some customers (limited)
        hash<auto> searchOpts = {"limit": 5};
        list<hash<auto>> customers = map $1, customersProvider.searchRecords(NOTHING, searchOpts);

        if (m_options.verbose) {
            printf("  Found %d customers (limited to 5)\n", customers.size());
        }

        if (customers.size() > 0) {
            hash<auto> customer = customers[0];
            assertTrue(customer.hasKey("id"), "Customer should have id");
            if (m_options.verbose) {
                printf("  Sample customer: %y (%y)\n", customer.id, customer.email ?? "N/A");
            }
        }
    }

    #! Test subscriptions collection provider
    private testSubscriptionsProvider() {
        if (m_options.verbose) {
            printf("\n--- Testing Subscriptions Provider ---\n");
        }

        ChargebeeDataProvider::ChargebeeDataProvider prov(client);

        AbstractDataProvider subscriptionsProvider = prov.getChildProvider("subscriptions");
        hash<DataProviderInfo> info = subscriptionsProvider.getInfo();

        assertTrue(info.supports_read, "Subscriptions should support read");
        assertTrue(info.supports_native_search, "Subscriptions should support native search");
        assertTrue(info.has_record, "Subscriptions should have record type");

        # Fetch some subscriptions (limited)
        hash<auto> searchOpts = {"limit": 5};
        list<hash<auto>> subscriptions = map $1, subscriptionsProvider.searchRecords(NOTHING, searchOpts);

        if (m_options.verbose) {
            printf("  Found %d subscriptions (limited to 5)\n", subscriptions.size());
        }

        if (subscriptions.size() > 0) {
            hash<auto> subscription = subscriptions[0];
            assertTrue(subscription.hasKey("id"), "Subscription should have id");
            if (m_options.verbose) {
                printf("  Sample subscription: %y (status: %y)\n", subscription.id, subscription.status ?? "N/A");
            }
        }
    }

