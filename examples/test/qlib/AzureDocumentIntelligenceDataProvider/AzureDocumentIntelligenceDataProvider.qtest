#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%allow-injection

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/ConnectionProvider
%requires ../../../../qlib/DataProvider
%requires ../../../../qlib/QoreAsyncJobUtils.qm
%requires ../../../../qlib/AzureDocumentIntelligenceRestClient.qm
%requires ../../../../qlib/AzureDocumentIntelligenceDataProvider

%exec-class AzureDocumentIntelligenceDataProviderTest

class FakeAzureDocIntelClient
        inherits AzureDocumentIntelligenceRestClient::AzureDocumentIntelligenceRestClientIo {
    public {
        list<hash<auto>> calls = ();
    }
    constructor() : AzureDocumentIntelligenceRestClient::AzureDocumentIntelligenceRestClientIo(
            {"url": "https://x.cognitiveservices.azure.com", "apikey": "k"}) {
        setSleeper(nothing sub (timeout to) {});
    }

    hash<RestClient::RestResponseInfo> restPost(string path, auto body, *hash<auto> hdr) {
        push calls, {"method": "POST", "path": path, "body": body};
        return <RestClient::RestResponseInfo>{
            "headers": {"operation-location": "/poll-url"},
            "body": "",
        };
    }
    hash<RestClient::RestResponseInfo> restGet(string path, *hash<auto> hdr) {
        push calls, {"method": "GET", "path": path};
        return <RestClient::RestResponseInfo>{
            "body": {
                "status": "succeeded",
                "analyzeResult": {"content": "OK", "modelId": "prebuilt-invoice"},
            },
        };
    }
    string getSafeUrl() { return "https://x.cognitiveservices.azure.com"; }
}

public class AzureDocumentIntelligenceDataProviderTest inherits QUnit::Test {
    public {
        const MyOpts = Opts + {
            "conn": "c,connection=s",
        };

        const OptionColumn = 22;

        #! Microsoft's published sample invoice PDF — used by Azure's own
        #! Document Intelligence quickstart docs.  Stable, public, free.
        const LiveDocUrl =
            "https://raw.githubusercontent.com/Azure-Samples/cognitive-services-REST-api-samples/"
            "master/curl/form-recognizer/sample-invoice.pdf";
    }

    private {
        *string conn_name;
    }

    constructor() : Test("AzureDocumentIntelligenceDataProvider Test", "1.0",
            \ARGV, MyOpts) {
        conn_name = m_options.conn ?? ENV.AZURE_DOCUMENTINTELLIGENCE_CONNECTION;

        addTestCase("factory + app + action registered",  \registrationTest());
        addTestCase("analyze-document with URL source",   \urlSourceTest());
        addTestCase("analyze-document with bytes encodes base64",
            \base64SourceTest());
        addTestCase("analyze-document raises when no source given",
            \noSourceTest());
        addTestCase("app declares Documents AppGroup",    \documentsAppGroupTest());
        addTestCase("model_id allowed_values has display_name",
            \allowedValuesTest());

        # Live tests require a real Azure Document Intelligence connection.
        # Cost: 1 page on prebuilt-document (free-tier eligible — 500
        # pages/month for 12 months).
        if (conn_name) {
            addTestCase("live: ping + analyze-document",
                \liveAzureDocIntelTest());
        }
        set_return_value(main());
    }

    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-c,--connection=ARG",
            "set the Azure Document Intelligence connection name; without "
            "it (and without the AZURE_DOCUMENTINTELLIGENCE_CONNECTION env "
            "var) the live test is skipped",
            OptionColumn);
    }

    private registrationTest() {
        DataProvider::AbstractDataProviderFactory f =
            DataProvider::DataProvider::getFactory("azure-documentintelligence");
        assertEq("azure-documentintelligence", f.getInfo().name);

        hash<DataProviderAppInfo> app =
            DataProvider::DataProviderActionCatalog::getApp("AzureDocumentIntelligence");
        assertEq("AzureDocumentIntelligence", app.name);
        assertEq("azure-documentintelligence", app.scheme);

        # filter out the framework-injected make-api-call action (covered by
        # GenericApiCallAutoInjection.qtest in RestClientDataProvider)
        list<hash<DataProviderActionInfo>> actions = select
            DataProvider::DataProviderActionCatalog::getActions("AzureDocumentIntelligence"),
            $1.action != AbstractDataProvider::GenericApiCallActionName;
        assertEq(1, actions.size());
        assertEq("analyze-document", actions[0].action);
    }

    private urlSourceTest() {
        FakeAzureDocIntelClient fake();
        AzureDocumentIntelligenceDataProvider::AzureDocumentIntelligenceAnalyzeDocumentDataProvider
            prov(fake);
        auto r = prov.doRequest({
            "model_id":     "prebuilt-invoice",
            "document_url": "https://example.com/invoice.pdf",
            "poll_interval": 1ms,
        });
        assertEq("OK", r.content);
        # POST body uses urlSource
        assertEq("https://example.com/invoice.pdf", fake.calls[0].body.urlSource);
        # Not base64Source
        assertEq(NOTHING, fake.calls[0].body.base64Source);
    }

    private base64SourceTest() {
        FakeAzureDocIntelClient fake();
        AzureDocumentIntelligenceDataProvider::AzureDocumentIntelligenceAnalyzeDocumentDataProvider
            prov(fake);
        prov.doRequest({
            "model_id":       "prebuilt-invoice",
            "document_bytes": binary("PDF-BYTES-HERE"),
            "poll_interval":  1ms,
        });
        # base64-encoded
        assertTrue(fake.calls[0].body.base64Source.val());
        assertEq(NOTHING, fake.calls[0].body.urlSource);
    }

    private noSourceTest() {
        FakeAzureDocIntelClient fake();
        AzureDocumentIntelligenceDataProvider::AzureDocumentIntelligenceAnalyzeDocumentDataProvider
            prov(fake);
        assertThrows("AZURE-DOCUMENT-INTELLIGENCE-CONFIG-ERROR", sub () {
            prov.doRequest({"model_id": "prebuilt-invoice", "poll_interval": 1ms});
        });
    }

    private documentsAppGroupTest() {
        hash<DataProviderAppInfo> app =
            DataProvider::DataProviderActionCatalog::getApp("AzureDocumentIntelligence");
        assertTrue(inlist(DataProvider::AppGroup::AiLlm,     app.groups));
        assertTrue(inlist(DataProvider::AppGroup::Documents, app.groups));
    }

    private allowedValuesTest() {
        *hash<auto> fld =
            AzureDocumentIntelligenceDataProvider::AzureDocumentIntelligenceAnalyzeRequestDataType::Fields.model_id;
        assertTrue(fld.allowed_values.size() >= 5);
        # Every allowed value has a display_name
        foreach hash<auto> av in (fld.allowed_values) {
            assertTrue(av.value.val());
            assertTrue(av.display_name.val());
        }
    }

    #! Exercises Azure DI's live `/documentintelligence/documentModels` API
    /** Verifies the actual wire format against Azure's Document
        Intelligence service — including the operation-location header
        parsing and async poll-until-succeeded lifecycle.  Cost: 1 page
        on the prebuilt-document model (free-tier eligible).
    */
    private liveAzureDocIntelTest() {
        AbstractConnection conn = get_connection(conn_name);
        hash<auto> ping = conn.ping(True);
        assertTrue(ping.ok, sprintf("Azure DI connection ping failed: %s",
            ping.info ?? "no info"));

        AbstractDataProvider prov = conn.getDataProvider();
        AbstractDataProvider ad = prov.getChildProvider("analyze-document");
        auto result = ad.doRequest({
            "model_id":     "prebuilt-document",
            "document_url": LiveDocUrl,
        });
        assertTrue(result.content.val(),
            "Azure DI returned non-empty content");
        assertTrue(result.pages.size() >= 1,
            "Azure DI returned at least one page");
        assertEq("prebuilt-document", result.modelId,
            "Azure DI echoed the model id");
    }
}
