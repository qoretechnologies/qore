#!/usr/bin/env qore

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit

%modern
%enable-all-warnings

%exec-class GetRandomStringTest

public class GetRandomStringTest inherits QUnit::Test {
    constructor() : Test ("GetRandomStringTest", "1.0") {
        addTestCase("Basic tests", \test_basic());
        addTestCase("Length tests", \test_length());
        addTestCase("Level tests", \test_levels());
        addTestCase("Randomness tests", \test_randomness());
        addTestCase("Alphabet tests", \test_alphabet());
        addTestCase("Sandbox tests", \test_sandbox());
        set_return_value(main());
    }

    test_basic() {
        # Default parameters
        string s = get_random_string();
        assertEq(15, s.length());
        assertTrue(s.val());
    }

    test_length() {
        # Various lengths
        assertEq(1, get_random_string(1).length());
        assertEq(5, get_random_string(5).length());
        assertEq(10, get_random_string(10).length());
        assertEq(50, get_random_string(50).length());
        assertEq(100, get_random_string(100).length());
        # Zero length
        assertEq(0, get_random_string(0).length());
    }

    test_levels() {
        # Level 1: only uppercase A-Z
        string s1 = get_random_string(100, 1);
        assertEq(100, s1.length());
        assertTrue(s1 =~ /^[A-Z]+$/);

        # Level 2: A-Z and a-z
        string s2 = get_random_string(100, 2);
        assertEq(100, s2.length());
        assertTrue(s2 =~ /^[A-Za-z]+$/);

        # Level 3: alphanumeric
        string s3 = get_random_string(100, 3);
        assertEq(100, s3.length());
        assertTrue(s3 =~ /^[A-Za-z0-9]+$/);

        # Level 4: alphanumeric + symbols
        string s4 = get_random_string(100, 4);
        assertEq(100, s4.length());
        # Should contain printable ASCII but no quote chars
        assertTrue(s4 =~ /^[\x20-\x7E]+$/);

        # Level out of range - should be clamped
        string slow = get_random_string(100, 0);
        assertTrue(slow =~ /^[A-Z]+$/);

        string shigh = get_random_string(100, 10);
        assertTrue(shigh =~ /^[\x20-\x7E]+$/);
    }

    #! the characters of each level are exactly those of its alphabet, and every one of them is produced
    test_alphabet() {
        string upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
        string lower = "abcdefghijklmnopqrstuvwxyz";
        string digits = "0123456789";
        # the symbols of level 4: the printable ASCII characters from "!" to "/", ":" to "@" and "{" to "~"
        string symbols;
        for (int c = 33; c <= 47; ++c) {
            symbols += chr(c);
        }
        for (int c = 58; c <= 64; ++c) {
            symbols += chr(c);
        }
        for (int c = 123; c <= 126; ++c) {
            symbols += chr(c);
        }
        list<string> alphabets = (upper, upper + lower, upper + lower + digits, upper + lower + digits + symbols);
        for (int level = 1; level <= 4; ++level) {
            string alphabet = alphabets[level - 1];
            string s = get_random_string(alphabet.size() * 300, level);
            hash<string, int> seen;
            for (int i = 0; i < s.size(); ++i) {
                string c = s[i];
                assertTrue(alphabet.find(c) >= 0, sprintf("level %d: %y is not in the alphabet", level, c));
                ++seen{c};
            }
            # 300 characters of each expected: a missing character would mean a biased or truncated range
            assertEq(alphabet.size(), seen.size(), sprintf("level %d: every character of the alphabet is produced",
                level));
            foreach string c in (keys seen) {
                assertTrue(seen{c} > 150 && seen{c} < 450,
                    sprintf("level %d: %y occurred %d times, 300 expected", level, c, seen{c}));
            }
        }
    }

    #! the function reads no file: it works for a program whose sandbox denies the filesystem (qore#5588)
    test_sandbox() {
        Program p(PO_NEW_STYLE);
        SandboxManager sm();
        sm.setFilesystemDefaultPolicy(False);
        p.setSandboxManager(sm);
        p.parse("%requires Util\nstring sub rnd(int len, int level) { return get_random_string(len, level); }\n"
            "string sub rnd_default() { return get_random_string(); }\n"
            "sub open_urandom() { ReadOnlyFile f(\"/dev/urandom\"); }", "get-random-string-sandbox");

        # the sandbox denies the file that the old implementation read
        assertThrows("FILESYSTEM-ACCESS-DENIED", \p.callFunction(), "open_urandom");
        string s = p.callFunction("rnd_default");
        assertEq(15, s.size());
        assertTrue(s =~ /^[A-Za-z0-9]+$/);
        for (int level = 1; level <= 4; ++level) {
            string r = p.callFunction("rnd", 40, level);
            assertEq(40, r.size(), "level " + level);
            assertTrue(r =~ /^[\x21-\x7E]+$/, "level " + level);
        }
        assertTrue(p.callFunction("rnd", 20, 3) != p.callFunction("rnd", 20, 3), "two calls differ");
        assertEq(0, p.callFunction("rnd", 0, 3).size());
    }

    test_randomness() {
        # Multiple calls should produce different strings
        string s1 = get_random_string(20);
        string s2 = get_random_string(20);
        string s3 = get_random_string(20);
        # Highly unlikely all three are the same
        assertTrue(s1 != s2 || s2 != s3);
    }
}
