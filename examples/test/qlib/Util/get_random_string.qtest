#!/usr/bin/env qore

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm

%new-style
%require-types
%enable-all-warnings

%exec-class GetRandomStringTest

public class GetRandomStringTest inherits QUnit::Test {
    constructor() : Test ("GetRandomStringTest", "1.0") {
        addTestCase("Basic tests", \test_basic());
        addTestCase("Length tests", \test_length());
        addTestCase("Level tests", \test_levels());
        addTestCase("Randomness tests", \test_randomness());
        set_return_value(main());
    }

    test_basic() {
        # Default parameters
        string s = get_random_string();
        assertEq(15, s.length());
        assertTrue(s.val());
    }

    test_length() {
        # Various lengths
        assertEq(1, get_random_string(1).length());
        assertEq(5, get_random_string(5).length());
        assertEq(10, get_random_string(10).length());
        assertEq(50, get_random_string(50).length());
        assertEq(100, get_random_string(100).length());
        # Zero length
        assertEq(0, get_random_string(0).length());
    }

    test_levels() {
        # Level 1: only uppercase A-Z
        string s1 = get_random_string(100, 1);
        assertEq(100, s1.length());
        assertTrue(s1 =~ /^[A-Z]+$/);

        # Level 2: A-Z and a-z
        string s2 = get_random_string(100, 2);
        assertEq(100, s2.length());
        assertTrue(s2 =~ /^[A-Za-z]+$/);

        # Level 3: alphanumeric
        string s3 = get_random_string(100, 3);
        assertEq(100, s3.length());
        assertTrue(s3 =~ /^[A-Za-z0-9]+$/);

        # Level 4: alphanumeric + symbols
        string s4 = get_random_string(100, 4);
        assertEq(100, s4.length());
        # Should contain printable ASCII but no quote chars
        assertTrue(s4 =~ /^[\x20-\x7E]+$/);

        # Level out of range - should be clamped
        string slow = get_random_string(100, 0);
        assertTrue(slow =~ /^[A-Z]+$/);

        string shigh = get_random_string(100, 10);
        assertTrue(shigh =~ /^[\x20-\x7E]+$/);
    }

    test_randomness() {
        # Multiple calls should produce different strings
        string s1 = get_random_string(20);
        string s2 = get_random_string(20);
        string s3 = get_random_string(20);
        # Highly unlikely all three are the same
        assertTrue(s1 != s2 || s2 != s3);
    }
}
