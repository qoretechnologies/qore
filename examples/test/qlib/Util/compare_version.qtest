#!/usr/bin/env qore

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm

%modern
%enable-all-warnings

%exec-class CompareVersionTest

public class CompareVersionTest inherits QUnit::Test {
    constructor() : Test ("CompareVersionTest", "1.0") {
        addTestCase("Basic version comparisons", \test_basic());
        addTestCase("Multi-component versions", \test_multi_component());
        addTestCase("Equal versions", \test_equal());
        addTestCase("Edge cases", \test_edge_cases());
        set_return_value(main());
    }

    test_basic() {
        # Simple comparisons
        assertTrue(compare_version("2.0", "1.0") > 0);
        assertTrue(compare_version("1.0", "2.0") < 0);
        assertTrue(compare_version("1.1", "1.0") > 0);
        assertTrue(compare_version("1.0", "1.1") < 0);
        assertTrue(compare_version("10.0", "9.0") > 0);
        assertTrue(compare_version("9.0", "10.0") < 0);
    }

    test_multi_component() {
        # Three component versions
        assertTrue(compare_version("1.2.3", "1.2.2") > 0);
        assertTrue(compare_version("1.2.3", "1.2.4") < 0);
        assertTrue(compare_version("1.3.0", "1.2.9") > 0);
        assertTrue(compare_version("2.0.0", "1.9.9") > 0);
        # Four component versions
        assertTrue(compare_version("1.0.0.1", "1.0.0.0") > 0);
        assertTrue(compare_version("1.0.0.0", "1.0.0.1") < 0);
    }

    test_equal() {
        assertEq(0, compare_version("1.0", "1.0"));
        assertEq(0, compare_version("1.0.0", "1.0.0"));
        assertEq(0, compare_version("1", "1"));
        assertEq(0, compare_version("0", "0"));
        assertEq(0, compare_version("1.2.3.4", "1.2.3.4"));
    }

    test_edge_cases() {
        # Different number of components
        assertTrue(compare_version("1.0.1", "1.0") > 0);
        assertTrue(compare_version("1.0", "1.0.1") < 0);
        # Zero versions
        assertEq(0, compare_version("0.0.0", "0.0.0"));
        assertTrue(compare_version("0.0.1", "0.0.0") > 0);
        # Large version numbers
        assertTrue(compare_version("999.999", "999.998") > 0);
        # Single component
        assertTrue(compare_version("5", "4") > 0);
        assertTrue(compare_version("4", "5") < 0);
    }
}
