#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

# GraphQLHandler.qtest Copyright (C) 2026 Qore Technologies, s.r.o.
# tests for the GraphQLHandler module: lexer, parser, schema, execution, introspection,
# the HTTP handler, and the DataProvider bridge

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires Logger
%requires QUnit
%requires Mime
%requires DataProvider
%requires HttpServerUtil
%requires HttpServer
%requires RestClient
%requires json
%requires GraphQLHandler

%exec-class GraphQLHandlerTest

#! a minimal in-memory data provider used to exercise the DataProvider bridge
class MemProvider inherits DataProvider::AbstractDataProvider {
    public {
        list<hash<auto>> data;
        # when False, the provider advertises read-only (no create/update/delete/upsert)
        bool mutable;
    }

    constructor(list<hash<auto>> d, bool n_mutable = True) {
        data = d;
        mutable = n_mutable;
    }

    string getName() {
        return "people";
    }

    private hash<DataProviderInfo> getStaticInfoImpl() {
        return <DataProviderInfo>{
            "supports_read": True,
            "supports_create": mutable,
            "supports_update": mutable,
            "supports_delete": mutable,
            "supports_upsert": mutable,
            "supports_bulk_create": mutable,
            "supports_bulk_upsert": mutable,
            # advertise advanced search expressions so DPQL where-filters are generated; the
            # generic expression implementations evaluate them in memory
            "supports_search_expressions": mutable,
            "expressions": mutable ? DataProviderGenericExpressions : NOTHING,
            "has_record": True,
        };
    }

    private *hash<string, AbstractDataField> getRecordTypeImpl(*hash<auto> search_options) {
        return {
            "id": new QoreDataField("id", "the id", IntType),
            "name": new QoreDataField("name", "the name", StringType),
            "active": new QoreDataField("active", "active flag", SoftBoolType),
        };
    }

    private AbstractDataProviderRecordIterator searchRecordsImpl(*hash<auto> where_cond, *hash<auto> search_options) {
        return new DefaultRecordIterator(data.iterator(), where_cond, search_options, getRecordTypeImpl());
    }

    private *hash<auto> createRecordImpl(hash<auto> rec, *hash<auto> create_options) {
        push data, rec;
        return rec;
    }

    private string upsertRecordImpl(hash<auto> rec, *hash<auto> upsert_options) {
        push data, rec;
        return rec.id.toString();
    }

    # converts a columnar bulk block (hash of lists) to a list of row hashes
    private list<hash<auto>> columnarToRows(hash<auto> recs) {
        list<hash<auto>> rows = ();
        int n = recs.firstValue().size();
        for (int i = 0; i < n; ++i) {
            hash<auto> row;
            foreach string col in (keys recs) {
                row{col} = recs{col}[i];
            }
            rows += row;
        }
        return rows;
    }

    private *hash<auto> createRecordsBulkImpl(hash<auto> recs, *hash<auto> create_options) {
        data += columnarToRows(recs);
        return recs;
    }

    private *list<string> upsertRecordsBulkImpl(hash<auto> recs, *hash<auto> upsert_options) {
        list<hash<auto>> rows = columnarToRows(recs);
        data += rows;
        return map $1.id.toString(), rows;
    }

    # reuses the generic expression matcher (via DefaultRecordIterator) to find matching ids
    private hash<string, bool> matchedIds(*hash<auto> where_cond, *hash<auto> opts) {
        hash<string, bool> ids;
        DefaultRecordIterator it(data.iterator(), where_cond, opts, getRecordTypeImpl());
        map ids{$1.id.toString()} = True, it;
        return ids;
    }

    private int updateRecordsImpl(hash<auto> set, *hash<auto> where_cond, *hash<auto> search_options) {
        hash<string, bool> ids = matchedIds(where_cond, search_options);
        int n = 0;
        for (int i = 0; i < data.size(); ++i) {
            if (ids{data[i].id.toString()}) {
                data[i] += set;
                ++n;
            }
        }
        return n;
    }

    private int deleteRecordsImpl(*hash<auto> where_cond, *hash<auto> search_options) {
        hash<string, bool> ids = matchedIds(where_cond, search_options);
        int before = data.size();
        data = select data, !ids{$1.id.toString()};
        return before - data.size();
    }
}

class GraphQLHandlerTest inherits QUnit::Test {
    private {
        HttpServer mServer;
        int port;

        const StarWarsSdl = "
            schema { query: Query mutation: Mutation }
            \"\"\"the root query\"\"\"
            type Query {
                hello(name: String): String
                add(a: Int!, b: Int!): Int!
                hero(episode: Episode = JEDI): Character
                numbers: [Int!]!
                nonNull: String!
            }
            type Mutation { echo(msg: String!): String! }
            interface Character { id: ID! name: String! }
            type Droid implements Character { id: ID! name: String! primaryFunction: String }
            type Human implements Character { id: ID! name: String! homePlanet: String }
            enum Episode { NEWHOPE EMPIRE JEDI }
        ";
    }

    constructor() : Test("GraphQLHandlerTest", "1.0") {
        addTestCase("lexer", \lexerTest());
        addTestCase("parser", \parserTest());
        addTestCase("parser errors", \parserErrorTest());
        addTestCase("schema model", \schemaTest());
        addTestCase("schema validation errors", \schemaErrorTest());
        addTestCase("execution basics", \executionTest());
        addTestCase("execution variables", \variablesTest());
        addTestCase("fragments and interfaces", \fragmentTest());
        addTestCase("directives", \directiveTest());
        addTestCase("error propagation", \errorPropagationTest());
        addTestCase("mutation", \mutationTest());
        addTestCase("introspection", \introspectionTest());
        addTestCase("http handler", \httpHandlerTest());
        addTestCase("http errors", \httpErrorTest());
        addTestCase("dataprovider bridge", \bridgeTest());
        addTestCase("bridge bulk and return-records", \bridgePhaseCTest());
        addTestCase("review hardening", \hardeningTest());
        addTestCase("bridge type graph", \typeGraphTest());
        addTestCase("bridge child providers and operator gating", \childGatingTest());
        addTestCase("document validation", \validationTest());
        addTestCase("http persisted queries and batching", \apqBatchTest());
        addTestCase("bridge paging and transactions", \pagingTxTest());

        set_return_value(main());
    }

    globalSetUp() {
        Logger logger("test", LoggerLevel::getLevelInfo());
        mServer = new HttpServer(<HttpServerOptionInfo>{"logger": logger, "debug": True});
        GraphQLHandler gh(StarWarsSdl, getStarWarsResolvers());
        mServer.setDefaultHandler("graphql", gh);
        port = mServer.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
    }

    globalTearDown() {
        if (mServer) {
            mServer.stop();
        }
    }

    private hash<auto> getStarWarsResolvers() {
        return {
            "Query": {
                "hello": string sub (auto p, hash<auto> a, auto c) {
                    return sprintf("Hello, %s!", a.name ?? "world");
                },
                "add": int sub (auto p, hash<auto> a, auto c) { return a.a + a.b; },
                "hero": auto sub (auto p, hash<auto> a, auto c) {
                    return {"__typename": "Droid", "id": "2001", "name": "R2-D2",
                        "primaryFunction": "Astromech"};
                },
                "numbers": auto sub (auto p, hash<auto> a, auto c) { return (1, 2, 3); },
                "nonNull": auto sub (auto p, hash<auto> a, auto c) { return NOTHING; },
            },
            "Mutation": {
                "echo": string sub (auto p, hash<auto> a, auto c) { return a.msg; },
            },
        };
    }

    private GraphQLExecutor getExecutor() {
        return new GraphQLExecutor(new GraphQLSchema(StarWarsSdl), getStarWarsResolvers());
    }

    lexerTest() {
        list<hash<GraphQLToken>> toks = GraphQLLexer::tokenize("{ hero(id: 1) }");
        assertEq(GraphQLLexer::TK_BRACE_L, toks[0].kind);
        assertEq(GraphQLLexer::TK_NAME, toks[1].kind);
        assertEq("hero", toks[1].value);
        assertEq(GraphQLLexer::TK_EOF, toks[toks.size() - 1].kind);

        # numbers, escapes, unicode (commas are ignored, not emitted as tokens)
        list<hash<GraphQLToken>> n = GraphQLLexer::tokenize("[-42, 3.14e2, \"a\\nb\", \"\\u0041\"]");
        assertEq(GraphQLLexer::TK_INT, n[1].kind);
        assertEq(-42, n[1].value);
        assertEq(GraphQLLexer::TK_FLOAT, n[2].kind);
        assertEq(314.0, n[2].value);
        assertEq("a\nb", n[3].value);
        assertEq("A", n[4].value);

        # block string dedent
        list<hash<GraphQLToken>> b = GraphQLLexer::tokenize("\"\"\"\n    Hello\n      World\n    \"\"\"");
        assertEq("Hello\n  World", b[0].value);

        # line/column tracking
        list<hash<GraphQLToken>> p = GraphQLLexer::tokenize("a\n  b");
        assertEq(1, p[0].line);
        assertEq(2, p[1].line);
        assertEq(3, p[1].column);

        assertThrows("GRAPHQL-SYNTAX-ERROR", \GraphQLLexer::tokenize(), "{ ~ }");
    }

    parserTest() {
        hash<GraphQLDocument> doc = GraphQLParser::parse(
            "query Hero(\$ep: Episode = JEDI) { hero(episode: \$ep) { name ...F } } "
            "fragment F on Character { id }");
        assertEq(2, doc.definitions.size());
        hash<GraphQLOperationDefinition> op = cast<hash<GraphQLOperationDefinition>>(doc.definitions[0]);
        assertEq("query", op.operation);
        assertEq("Hero", op.name);
        assertEq(1, op.variableDefinitions.size());
        hash<GraphQLVariableDefinition> vd = cast<hash<GraphQLVariableDefinition>>(op.variableDefinitions[0]);
        assertEq("ep", vd.name);
        assertEq("Episode", GraphQLSchema::typeRefToString(vd.type));

        hash<GraphQLSelectionSet> ss = cast<hash<GraphQLSelectionSet>>(op.selectionSet);
        hash<GraphQLField> hero = cast<hash<GraphQLField>>(ss.selections[0]);
        assertEq("hero", hero.name);
        assertEq(1, hero.arguments.size());

        hash<GraphQLFragmentDefinition> fd = cast<hash<GraphQLFragmentDefinition>>(doc.definitions[1]);
        assertEq("F", fd.name);
        assertEq("Character", fd.typeCondition);

        # anonymous shorthand query with alias
        hash<GraphQLDocument> doc2 = GraphQLParser::parse("{ a: hello }");
        hash<GraphQLOperationDefinition> op2 = cast<hash<GraphQLOperationDefinition>>(doc2.definitions[0]);
        assertEq("query", op2.operation);
        hash<GraphQLField> f = cast<hash<GraphQLField>>(
            cast<hash<GraphQLSelectionSet>>(op2.selectionSet).selections[0]);
        assertEq("a", f.alias);
        assertEq("hello", f.name);
    }

    parserErrorTest() {
        assertThrows("GRAPHQL-SYNTAX-ERROR", "selection set", \GraphQLParser::parse(), "query { }");
        assertThrows("GRAPHQL-SYNTAX-ERROR", \GraphQLParser::parse(), "query {");
        assertThrows("GRAPHQL-SYNTAX-ERROR", \GraphQLParser::parse(), "mutation");
        assertThrows("GRAPHQL-SYNTAX-ERROR", "fragment name cannot be",
            \GraphQLParser::parse(), "fragment on on T { x }");
    }

    schemaTest() {
        GraphQLSchema schema(StarWarsSdl);
        assertEq("Query", schema.getQueryType().name);
        assertEq("Mutation", schema.getMutationType().name);
        assertNothing(schema.getSubscriptionType());
        assertEq(("id", "name"), keys schema.getType("Character").fields);
        assertEq(TYPE_INTERFACE, schema.getType("Character").kind);
        assertEq(("Character",), schema.getType("Droid").interfaces);
        assertEq(("NEWHOPE", "EMPIRE", "JEDI"), schema.getType("Episode").enumValues);
        assertEq("[Int!]!", GraphQLSchema::typeRefToString(schema.getType("Query").fields.numbers.type));
        # built-in scalars present
        assertEq(TYPE_SCALAR, schema.getType("Int").kind);
    }

    schemaErrorTest() {
        assertThrows("GRAPHQL-SCHEMA-ERROR", "undefined type",
            sub () { new GraphQLSchema("type Query { x: Nope }"); });
        assertThrows("GRAPHQL-SCHEMA-ERROR", "query root type",
            sub () { new GraphQLSchema("type Foo { x: Int }"); });
        assertThrows("GRAPHQL-SCHEMA-ERROR", "more than once",
            sub () { new GraphQLSchema("type Query { x: Int } type Query { y: Int }"); });
    }

    executionTest() {
        GraphQLExecutor ex = getExecutor();
        assertEq({"data": {"hello": "Hello, world!"}}, ex.execute("{ hello }"));
        assertEq({"data": {"hello": "Hello, Ada!"}}, ex.execute("{ hello(name: \"Ada\") }"));
        assertEq({"data": {"sum": 7}}, ex.execute("{ sum: add(a: 3, b: 4) }"));
        assertEq({"data": {"numbers": (1, 2, 3)}}, ex.execute("{ numbers }"));

        # unknown field is reported as an error
        hash<auto> r = ex.execute("{ nope }");
        assertEq("cannot query field \"nope\" on type \"Query\"", r.errors[0].message);
    }

    variablesTest() {
        GraphQLExecutor ex = getExecutor();
        assertEq({"data": {"add": 42}},
            ex.execute("query(\$x: Int!, \$y: Int!) { add(a: \$x, b: \$y) }", {"x": 20, "y": 22}));

        # missing required variable
        hash<auto> r = ex.execute("query(\$x: Int!, \$y: Int!) { add(a: \$x, b: \$y) }", {"x": 1});
        assertEq(0, r.data.size() ?? 0);
        assertRegex("required variable", r.errors[0].message);

        # invalid variable type
        hash<auto> r2 = ex.execute("query(\$x: Int!, \$y: Int!) { add(a: \$x, b: \$y) }",
            {"x": "notint", "y": 2});
        assertRegex("must be an integer", r2.errors[0].message);
    }

    fragmentTest() {
        GraphQLExecutor ex = getExecutor();
        # inline fragment on the concrete type + __typename + alias
        hash<auto> r = ex.execute(
            "{ h: hero { __typename id name ... on Droid { primaryFunction } } }");
        assertEq("Droid", r.data.h.__typename);
        assertEq("R2-D2", r.data.h.name);
        assertEq("Astromech", r.data.h.primaryFunction);

        # named fragment spread
        hash<auto> r2 = ex.execute("{ hero { ...CharFields } } fragment CharFields on Character { id name }");
        assertEq("2001", r2.data.hero.id);
        assertEq("R2-D2", r2.data.hero.name);
    }

    directiveTest() {
        GraphQLExecutor ex = getExecutor();
        # @skip(if: true) omits the field
        hash<auto> r = ex.execute("{ a: hello @skip(if: true) b: hello(name: \"x\") }");
        assertFalse(r.data.hasKey("a"));
        assertEq("Hello, x!", r.data.b);

        # @include(if: false) omits the field
        hash<auto> r2 = ex.execute("{ a: hello @include(if: false) b: hello(name: \"y\") }");
        assertFalse(r2.data.hasKey("a"));
        assertEq("Hello, y!", r2.data.b);

        # @skip with a variable
        hash<auto> r3 = ex.execute("query(\$s: Boolean!) { a: hello @skip(if: \$s) }", {"s": True});
        assertFalse(r3.data.hasKey("a"));
    }

    errorPropagationTest() {
        GraphQLExecutor ex = getExecutor();
        # a non-null field resolving to null nulls the data and reports an error with a path
        hash<auto> r = ex.execute("{ nonNull }");
        assertNothing(r.data);
        assertRegex("non-nullable", r.errors[0].message);
        assertEq(("nonNull",), r.errors[0].path);
    }

    mutationTest() {
        GraphQLExecutor ex = getExecutor();
        assertEq({"data": {"echo": "hi"}}, ex.execute("mutation { echo(msg: \"hi\") }"));
    }

    introspectionTest() {
        GraphQLExecutor ex = getExecutor();
        assertEq("Query", ex.execute("{ __typename }").data.__typename);

        hash<auto> s = ex.execute("{ __schema { queryType { name } mutationType { name } } }");
        assertEq("Query", s.data.__schema.queryType.name);
        assertEq("Mutation", s.data.__schema.mutationType.name);

        # __type with nested ofType
        hash<auto> t = ex.execute(
            "{ __type(name: \"Droid\") { kind name fields { name type { kind ofType { kind name } } } "
            "interfaces { name } } }");
        assertEq("OBJECT", t.data.__type.kind);
        assertEq("Droid", t.data.__type.name);
        # the "id" field has type ID! -> NON_NULL wrapping SCALAR ID
        hash<auto> idField = (select t.data.__type.fields, $1.name == "id")[0];
        assertEq("NON_NULL", idField.type.kind);
        assertEq("ID", idField.type.ofType.name);
        assertEq(("Character",), (map $1.name, t.data.__type.interfaces));

        # enum introspection
        hash<auto> e = ex.execute("{ __type(name: \"Episode\") { kind enumValues { name } } }");
        assertEq("ENUM", e.data.__type.kind);
        assertEq(("NEWHOPE", "EMPIRE", "JEDI"), (map $1.name, e.data.__type.enumValues));
    }

    httpHandlerTest() {
        RestClient rc({"url": "http://localhost:" + port, "data": "json"});
        # POST query
        assertEq({"hello": "Hello, Ada!"},
            rc.post("/graphql", {"query": "{ hello(name: \"Ada\") }"}).body.data);
        # POST with variables
        assertEq({"add": 42},
            rc.post("/graphql", {"query": "query(\$a: Int!, \$b: Int!) { add(a: \$a, b: \$b) }",
                "variables": {"a": 20, "b": 22}}).body.data);
        # GET query (RestClient URL-encodes the path once; the server decodes it once)
        assertEq({"hello": "Hello, world!"},
            rc.get("/graphql?query={ hello }").body.data);
        # introspection over HTTP
        assertEq("Query",
            rc.post("/graphql", {"query": "{ __schema { queryType { name } } }"}).body.data.__schema.queryType.name);
        # mutation over HTTP
        assertEq({"echo": "yo"},
            rc.post("/graphql", {"query": "mutation { echo(msg: \"yo\") }"}).body.data);
    }

    httpErrorTest() {
        RestClient rc({"url": "http://localhost:" + port, "data": "json"});
        rc.setErrorPassthru(True);

        # missing query -> 400
        hash<auto> r = rc.post("/graphql", {"notquery": "x"});
        assertEq(400, r.status_code);
        assertRegex("no GraphQL query", r.body.errors[0].message);

        # syntax error -> 200 with errors envelope
        hash<auto> r2 = rc.post("/graphql", {"query": "{ broken"});
        assertEq(200, r2.status_code);
        assertRegex("syntax error", r2.body.errors[0].message);

        # field error -> 200 with data + errors
        hash<auto> r3 = rc.post("/graphql", {"query": "{ unknownField }"});
        assertEq(200, r3.status_code);
        assertRegex("cannot query field", r3.body.errors[0].message);

        # a mutation over GET is rejected (GET is query-only; CSRF defense)
        hash<auto> gm = rc.get("/graphql?query=mutation { echo(msg: \"x\") }");
        assertEq(200, gm.status_code);
        assertRegex("not permitted", gm.body.errors[0].message);
        # the same mutation over POST still works
        assertEq({"echo": "x"}, rc.post("/graphql", {"query": "mutation { echo(msg: \"x\") }"}).body.data);
    }

    bridgeTest() {
        MemProvider mp((
            {"id": 1, "name": "Ada", "active": True},
            {"id": 2, "name": "Bob", "active": False},
        ));
        DataProviderGraphQLSchema bridge(mp);

        # generated SDL contains the record type and the search/create/update/delete/upsert operations
        string sdl = bridge.getSdl();
        assertRegex("type peopleRecord", sdl);
        assertRegex("search\\(filter: peopleRecordWhereInput, where: String, limit: Int, offset: Int\\): \\[peopleRecord!\\]!", sdl);
        assertRegex("create\\(", sdl);
        assertRegex("update\\(set: peopleRecordSetInput!, filter: peopleRecordWhereInput, where: String\\): Int!", sdl);
        assertRegex("delete\\(filter: peopleRecordWhereInput, where: String\\): Int!", sdl);
        assertRegex("upsert\\(.*\\): String!", sdl);
        assertRegex("input peopleRecordSetInput", sdl);
        # typed filter input types (Phase B)
        assertRegex("input peopleRecordWhereInput", sdl);
        assertRegex("_and: \\[peopleRecordWhereInput!\\]", sdl);
        assertRegex("input IntFilter", sdl);
        assertRegex("input StringFilter", sdl);
        assertRegex("input BooleanFilter", sdl);

        GraphQLExecutor ex = bridge.getExecutor();
        # search (no filter)
        hash<auto> r = ex.execute("{ search { id name active } }");
        assertEq(2, r.data.search.size());
        assertEq("Ada", r.data.search[0].name);
        # limit / offset
        assertEq(1, ex.execute("{ search(limit: 1) { name } }").data.search.size());
        assertEq("Bob", ex.execute("{ search(offset: 1) { name } }").data.search[0].name);

        # DPQL filtered search (raw where string)
        hash<auto> f = ex.execute("{ search(where: \"@active == true\") { name } }");
        assertEq(("Ada",), (map $1.name, f.data.search));
        # compound DPQL filter
        hash<auto> f2 = ex.execute("{ search(where: \"@id >= 1 && @name like \\\"A%\\\"\") { name } }");
        assertEq(("Ada",), (map $1.name, f2.data.search));

        # typed filters (Phase B) compiled to DPQL
        assertEq(("Ada",),
            (map $1.name, ex.execute("{ search(filter: {active: {eq: true}}) { name } }").data.search));
        assertEq(("Ada", "Bob"),
            (map $1.name, ex.execute("{ search(filter: {id: {in: [1, 2]}}) { name } }").data.search));
        # logical combinators
        assertEq(("Bob",),
            (map $1.name, ex.execute("{ search(filter: {_not: {active: {eq: true}}}) { name } }").data.search));
        assertEq(("Ada", "Bob"),
            (map $1.name, ex.execute("{ search(filter: {_or: [{name: {eq: \"Ada\"}}, {name: {eq: \"Bob\"}}]}) { name } }").data.search));
        # a typed filter combined with a raw where (AND-ed)
        assertEq(("Bob",),
            (map $1.name, ex.execute("{ search(filter: {id: {gte: 1}}, where: \"@active == false\") { name } }").data.search));

        # create
        hash<auto> c = ex.execute("mutation { create(id: 3, name: \"Cy\", active: true) { id name } }");
        assertEq("Cy", c.data.create.name);
        assertEq(3, ex.execute("{ search { id } }").data.search.size());

        # update with set + raw where -> affected count, then verify
        assertEq(1, ex.execute("mutation { update(set: {name: \"Adita\"}, where: \"@id == 1\") }").data.update);
        assertEq("Adita", ex.execute("{ search(where: \"@id == 1\") { name } }").data.search[0].name);

        # update with a typed filter
        assertEq(1, ex.execute("mutation { update(set: {name: \"Bobby\"}, filter: {id: {eq: 2}}) }").data.update);
        assertEq("Bobby", ex.execute("{ search(filter: {id: {eq: 2}}) { name } }").data.search[0].name);

        # delete with a typed filter -> affected count, then verify
        assertEq(1, ex.execute("mutation { delete(filter: {active: {eq: false}}) }").data.delete);
        assertFalse((map $1.name, ex.execute("{ search { name } }").data.search).contains("Bobby"));

        # upsert -> record id
        assertEq("4", ex.execute("mutation { upsert(id: 4, name: \"Dee\", active: true) }").data.upsert);

        # invalid filter (unknown field) -> field error from validateDpqlExpression
        assertRegex("Unknown field", ex.execute("{ search(where: \"@nope == 1\") { id } }").errors[0].message);

        # template references are rejected by default
        assertRegex("template references are not permitted",
            ex.execute("{ search(where: \"@name == \$env:HOME\") { id } }").errors[0].message);

        # safety: an update/delete with no selector (neither filter nor where) is a runtime error
        assertRegex("requires a \"filter\" or \"where\" condition",
            ex.execute("mutation { delete }").errors[0].message);
        assertRegex("requires a \"filter\" or \"where\" condition",
            ex.execute("mutation { update(set: {name: \"x\"}) }").errors[0].message);

        # name sanitization transform
        assertEq("first_name", DataProviderGraphQLSchema::sanitizeName("first-name"));

        # field-name round-tripping: an arg whose GraphQL name was sanitized maps back to the
        # provider's native field name when creating a record
        HyphenProvider hp();
        GraphQLExecutor hex = (new DataProviderGraphQLSchema(hp)).getExecutor();
        # the provider field is "full-name"; the GraphQL arg is the sanitized "full_name"
        assertRegex("full_name", hex.getSchema().getType("hyphenRecord").fields.full_name.name);
        hex.execute("mutation { create(id: 1, full_name: \"Ada Lovelace\") { id } }");
        # the stored record uses the provider's native field name
        assertEq("Ada Lovelace", hp.data[0]."full-name");

        # a read-only provider generates no Mutation type and no where-filtered search
        MemProvider ro((), False);
        DataProviderGraphQLSchema roBridge(ro);
        assertFalse(roBridge.getSdl() =~ /type Mutation/);
        assertRegex("search\\(limit: Int, offset: Int\\)", roBridge.getSdl());

        # an empty _not filter must not compile to a match-everything "!()" that bypasses the
        # mass-mutation guard
        assertRegex("requires a \"filter\" or \"where\" condition",
            ex.execute("mutation { delete(filter: {_not: {}}) }").errors[0].message);
        # an unknown filter field is rejected (input-object coercion rejects undefined fields)
        assertRegex("unknown input field",
            ex.execute("{ search(filter: {nosuchfield: {eq: 1}}) { id } }").errors[0].message);
    }

    hardeningTest() {
        # an abstract-type resolver that omits __typename produces a field error, not a crash
        string asdl = "type Query { hero: Character } interface Character { id: ID! } "
            "type Droid implements Character { id: ID! }";
        GraphQLExecutor aex(new GraphQLSchema(asdl), {
            "Query": {"hero": auto sub (auto p, hash<auto> a, auto c) { return {"id": "1"}; }},
        });
        hash<auto> ar = aex.execute("{ hero { id } }");
        assertNothing(ar.data.hero);
        assertRegex("__typename", ar.errors[0].message);

        # an ill-typed leaf value produces a field error, not a crash
        GraphQLExecutor lex(new GraphQLSchema("type Query { n: Int }"), {
            "Query": {"n": auto sub (auto p, hash<auto> a, auto c) { return {"not": "an int"}; }},
        });
        assertTrue(exists lex.execute("{ n }").errors, "ill-typed leaf becomes an error, not a crash");

        # a query exceeding the maximum nesting depth is rejected
        string nsdl = "type Query { root: Node } type Node { value: Int child: Node }";
        auto deep = {"value": 0};
        for (int i = 0; i < 70; ++i) {
            deep = {"value": i, "child": deep};
        }
        GraphQLExecutor dex(new GraphQLSchema(nsdl), {
            "Query": {"root": auto sub (auto p, hash<auto> a, auto c) { return deep; }},
        });
        string q = "{ root { value ";
        for (int i = 0; i < 70; ++i) {
            q += "child { value ";
        }
        for (int i = 0; i < 70; ++i) {
            q += "} ";
        }
        q += "} }";
        assertRegex("nesting depth", dex.execute(q).errors[0].message);

        # a provider with two fields that sanitize to the same GraphQL name is rejected
        assertThrows("GRAPHQL-SCHEMA-ERROR", "map to the GraphQL field name",
            sub () { new DataProviderGraphQLSchema(new CollisionProvider()); });

        # the GraphQL Int scalar is a signed 32-bit value: out-of-range input is rejected
        GraphQLExecutor iex(new GraphQLSchema("type Query { add(a: Int!, b: Int!): Int! }"), {
            "Query": {"add": int sub (auto p, hash<auto> a, auto c) { return a.a + a.b; }},
        });
        assertRegex("32-bit range",
            iex.execute("{ add(a: 3000000000, b: 1) }").errors[0].message);
        # an out-of-range Int result is a field error
        assertRegex("32-bit",
            iex.execute("{ add(a: 2000000000, b: 200000000) }").errors[0].message);
        # in-range still works
        assertEq(3, iex.execute("{ add(a: 1, b: 2) }").data.add);

        # custom-scalar coercers are applied on input then output
        hash<auto> coercers = {
            "Upper": {
                "input": auto sub (auto v) { return "in:" + v; },
                "output": auto sub (auto v) { return "out:" + v; },
            },
        };
        GraphQLExecutor cex(new GraphQLSchema("scalar Upper\ntype Query { shout(text: Upper): Upper }"), {
            "Query": {"shout": auto sub (auto p, hash<auto> a, auto c) { return a.text; }},
        }, coercers);
        assertEq("out:in:hi", cex.execute("{ shout(text: \"hi\") }").data.shout);
    }

    typeGraphTest() {
        # the bridge recurses non-scalar record types into GraphQL types: dates -> DateTime scalar,
        # binary -> Base64 scalar, lists -> list types, nested records -> nested object types
        TypeGraphProvider tp();
        DataProviderGraphQLSchema bridge(tp);
        string sdl = bridge.getSdl();
        assertRegex("created: DateTime!", sdl);
        assertRegex("blob: Base64!", sdl);
        assertRegex("tags: \\[String!\\]!", sdl);
        assertRegex("address: thingRecordAddress!", sdl);
        assertRegex("type thingRecordAddress", sdl);
        assertRegex("scalar DateTime", sdl);
        assertRegex("scalar Base64", sdl);

        GraphQLExecutor ex = bridge.getExecutor();
        hash<auto> r = ex.execute(
            "{ search { id created blob tags address { street zip } } }").data.search[0];
        # date serialized as ISO-8601, binary as base64, list and nested object resolved
        assertEq("2026-01-15T10:30:00", r.created);
        assertEq("aGk=", r.blob);
        assertEq(("a", "b"), r.tags);
        assertEq("Main", r.address.street);
        assertEq(12345, r.address.zip);

        # a date round-trips through the DateTime coercer (input ISO string -> Qore date for the
        # raw DPQL filter is exercised separately); here verify the output coercer produced ISO
        assertRegex("T", r.created);
    }

    childGatingTest() {
        # operator gating (gap 8): a provider advertising only "==" and ">" generates filter
        # types with only the corresponding operators
        ParentChildProvider pc();
        DataProviderGraphQLSchema bridge(pc);
        string sdl = bridge.getSdl();
        assertRegex("input IntFilter \\{\\n  eq: Int\\n  gt: Int\\n\\}", sdl);
        assertRegex("input StringFilter \\{\\n  eq: String\\n\\}", sdl);
        assertFalse(sdl =~ /like:/, "unsupported 'like' operator is not generated");

        # child-provider traversal (gap 5): a Query field for the direct child provider
        assertRegex("orders\\(limit: Int, offset: Int\\): \\[customerRecordChildOrders!\\]!", sdl);
        assertRegex("type customerRecordChildOrders", sdl);
        GraphQLExecutor ex = bridge.getExecutor();
        hash<auto> o = ex.execute("{ orders { oid total } }");
        assertEq((100, 101), (map $1.oid, o.data.orders));
        assertEq(9.99, o.data.orders[0].total);

        # output field-name mapping: a field whose GraphQL name was sanitized resolves correctly
        # on output (reads the provider's native field name)
        HyphenProvider hp();
        GraphQLExecutor hex = (new DataProviderGraphQLSchema(hp)).getExecutor();
        hex.execute("mutation { create(id: 1, full_name: \"Ada Lovelace\") { id } }");
        assertEq("Ada Lovelace", hex.execute("{ search { full_name } }").data.search[0].full_name);
    }

    apqBatchTest() {
        RestClient rc({"url": "http://localhost:" + port, "data": "json"});
        rc.setErrorPassthru(True);

        # Automatic Persisted Queries: a hash-only request before registration is not found
        string q = "{ hello }";
        string h = SHA256(q);
        hash<auto> ext = {"extensions": {"persistedQuery": {"sha256Hash": h}}};
        assertRegex("PersistedQueryNotFound", rc.post("/graphql", ext).body.errors[0].message);
        # registering with the query+hash executes and caches it
        assertEq("Hello, world!", rc.post("/graphql", ext + {"query": q}).body.data.hello);
        # a subsequent hash-only request now resolves from the cache
        assertEq("Hello, world!", rc.post("/graphql", ext).body.data.hello);
        # a hash that does not match the supplied query is rejected
        assertRegex("PersistedQueryHashMismatch",
            rc.post("/graphql", {"query": q, "extensions": {"persistedQuery": {"sha256Hash": "bad"}}})
                .body.errors[0].message);

        # request batching: an array body returns an array of envelopes, one per operation
        auto batch = rc.post("/graphql", (
            {"query": "{ hello(name: \"A\") }"},
            {"query": "{ add(a: 2, b: 3) }"},
            {"query": "{ nope }"},
        )).body;
        assertEq("Hello, A!", batch[0].data.hello);
        assertEq(5, batch[1].data.add);
        assertRegex("cannot query field", batch[2].errors[0].message);
    }

    pagingTxTest() {
        # limit/offset pushdown (F1): a provider advertising limit/offset receives them as search
        # options instead of the bridge paging client-side
        PagingProvider pp();
        GraphQLExecutor pex = (new DataProviderGraphQLSchema(pp)).getExecutor();
        assertEq((2, 3), (map $1.id, pex.execute("{ search(limit: 2, offset: 1) { id } }").data.search));
        assertEq(2, pp.last_options.limit);
        assertEq(1, pp.last_options.offset);

        # transactional return_records (F4): a transaction-capable provider wraps the mutate+re-read
        TxProvider tp();
        GraphQLExecutor tex = (new DataProviderGraphQLSchema(tp, {"return_records": True})).getExecutor();
        hash<auto> u = tex.execute("mutation { update(set: {name: \"Z\"}, filter: {id: {eq: 1}}) { id name } }");
        assertEq("Z", u.data.update[0].name);
        assertTrue(tp.began, "beginTransaction was called");
        assertTrue(tp.committed, "commit was called");
    }

    validationTest() {
        string sdl = "type Query { me: String greet(name: String): String hero: Character } "
            "type Character { id: ID! name: String! }";
        GraphQLExecutor ex(new GraphQLSchema(sdl), {});

        # leaf field must not have a selection set
        assertRegex("must not have a selection set", ex.execute("{ me { x } }").errors[0].message);
        # composite field must have a selection set
        assertRegex("must have a selection set", ex.execute("{ hero }").errors[0].message);
        # unknown field
        assertRegex("cannot query field", ex.execute("{ nope }").errors[0].message);
        # unknown argument
        assertRegex("unknown argument", ex.execute("{ greet(bad: 1) }").errors[0].message);
        # unsupported directive
        assertRegex("directive", ex.execute("{ me @foo }").errors[0].message);
        # duplicate operation name
        assertRegex("only one operation named",
            ex.execute("query A { me } query A { me }").errors[0].message);
        # the lone-anonymous-operation rule
        assertRegex("only operation", ex.execute("{ me } query B { me }").errors[0].message);
        # a declared-but-unused variable
        assertRegex("declared but never used", ex.execute("query(\$x: Int) { me }").errors[0].message);
        # a used-but-undeclared variable
        assertRegex("used but not declared", ex.execute("{ greet(name: \$x) }").errors[0].message);
        # an unused fragment
        assertRegex("never used",
            ex.execute("{ me } fragment F on Query { me }").errors[0].message);
        # an unknown fragment spread
        assertRegex("unknown fragment", ex.execute("{ ...Nope }").errors[0].message);
        # a fragment cycle
        assertRegex("cycle",
            ex.execute("{ ...A } fragment A on Query { ...B } fragment B on Query { ...A }").errors[0].message);

        # a valid query still executes (validation does not reject good documents)
        GraphQLExecutor vex(new GraphQLSchema(sdl), {
            "Query": {"me": string sub (auto p, hash<auto> a, auto c) { return "hi"; }},
        });
        assertEq("hi", vex.execute("{ me }").data.me);

        # the complexity budget rejects over-large queries
        GraphQLExecutor cex(new GraphQLSchema(sdl), {});
        cex.setValidation(True, 2);
        assertRegex("complexity", cex.execute("{ me hero { id } }").errors[0].message);
        # disabling validation lets a document through to execution
        GraphQLExecutor nex(new GraphQLSchema(sdl), {});
        nex.setValidation(False);
        assertRegex("cannot query field", nex.execute("{ nope }").errors[0].message);
    }

    bridgePhaseCTest() {
        # bulk operations (Phase C)
        MemProvider bp(());
        DataProviderGraphQLSchema bulkBridge(bp);
        string sdl = bulkBridge.getSdl();
        assertRegex("createMany\\(records: \\[peopleRecordInput!\\]!\\): Int!", sdl);
        assertRegex("upsertMany\\(records: \\[peopleRecordInput!\\]!\\): \\[String!\\]!", sdl);
        assertRegex("input peopleRecordInput", sdl);

        GraphQLExecutor bex = bulkBridge.getExecutor();
        assertEq(2, bex.execute(
            "mutation { createMany(records: [{id: 10, name: \"X\", active: true}, "
            "{id: 11, name: \"Y\", active: false}]) }").data.createMany);
        assertEq(("12",), bex.execute(
            "mutation { upsertMany(records: [{id: 12, name: \"Z\", active: true}]) }").data.upsertMany);
        assertEq((10, 11, 12), (map $1.id, bex.execute("{ search { id } }").data.search));

        # return_records option (Phase C): update/delete return the affected records
        MemProvider rp((
            {"id": 1, "name": "Ada", "active": True},
            {"id": 2, "name": "Bob", "active": False},
        ));
        DataProviderGraphQLSchema rrBridge(rp, {"return_records": True});
        # the SDL return type switches from Int! to [<R>!]!
        assertRegex("update\\(set: peopleRecordSetInput!, filter: peopleRecordWhereInput, where: String\\): \\[peopleRecord!\\]!",
            rrBridge.getSdl());
        assertRegex("delete\\(filter: peopleRecordWhereInput, where: String\\): \\[peopleRecord!\\]!",
            rrBridge.getSdl());

        GraphQLExecutor rex = rrBridge.getExecutor();
        # update returns the updated record(s)
        hash<auto> u = rex.execute("mutation { update(set: {active: false}, filter: {id: {eq: 1}}) { id name active } }");
        assertEq(1, u.data.update.size());
        assertEq("Ada", u.data.update[0].name);
        assertEq(False, u.data.update[0].active);
        # delete returns the deleted record(s)
        hash<auto> d = rex.execute("mutation { delete(filter: {active: {eq: false}}) { id name } }");
        assertEq(("Ada", "Bob"), (map $1.name, d.data.delete));
        assertEq(0, rex.execute("{ search { id } }").data.search.size());
    }
}

#! a provider with a field name requiring GraphQL-name sanitization, to test name round-tripping
class HyphenProvider inherits DataProvider::AbstractDataProvider {
    public {
        list<hash<auto>> data;
    }

    string getName() {
        return "hyphen";
    }

    private hash<DataProviderInfo> getStaticInfoImpl() {
        return <DataProviderInfo>{"supports_read": True, "supports_create": True, "has_record": True};
    }

    private *hash<string, AbstractDataField> getRecordTypeImpl(*hash<auto> search_options) {
        return {
            "id": new QoreDataField("id", "the id", IntType),
            "full-name": new QoreDataField("full-name", "the full name", StringType),
        };
    }

    private AbstractDataProviderRecordIterator searchRecordsImpl(*hash<auto> where_cond, *hash<auto> search_options) {
        return new DefaultRecordIterator(data.iterator(), where_cond, search_options, getRecordTypeImpl());
    }

    private *hash<auto> createRecordImpl(hash<auto> rec, *hash<auto> create_options) {
        push data, rec;
        return rec;
    }
}

#! a provider with two field names that sanitize to the same GraphQL name, to test collision detection
class CollisionProvider inherits DataProvider::AbstractDataProvider {
    string getName() {
        return "collision";
    }

    private hash<DataProviderInfo> getStaticInfoImpl() {
        return <DataProviderInfo>{"supports_read": True, "has_record": True};
    }

    private *hash<string, AbstractDataField> getRecordTypeImpl(*hash<auto> search_options) {
        # both "a-b" and "a.b" sanitize to the GraphQL name "a_b"
        return {
            "a-b": new QoreDataField("a-b", "field one", StringType),
            "a.b": new QoreDataField("a.b", "field two", StringType),
        };
    }

    private AbstractDataProviderRecordIterator searchRecordsImpl(*hash<auto> where_cond, *hash<auto> search_options) {
        return new DefaultRecordIterator(().iterator(), where_cond, search_options, getRecordTypeImpl());
    }
}

#! a provider whose record has date, binary, list, and nested-object fields, to test type recursion
class TypeGraphProvider inherits DataProvider::AbstractDataProvider {
    public {
        list<hash<auto>> data = (
            {"id": 1, "created": 2026-01-15T10:30:00, "blob": binary("hi"), "tags": ("a", "b"),
                "address": {"street": "Main", "zip": 12345}},
        );
    }

    string getName() {
        return "thing";
    }

    private hash<DataProviderInfo> getStaticInfoImpl() {
        return <DataProviderInfo>{"supports_read": True, "has_record": True};
    }

    private *hash<string, AbstractDataField> getRecordTypeImpl(*hash<auto> search_options) {
        HashDataType addr("Addr");
        addr.addField(new QoreDataField("street", "the street", StringType));
        addr.addField(new QoreDataField("zip", "the zip", IntType));
        return {
            "id": new QoreDataField("id", "the id", IntType),
            "created": new QoreDataField("created", "creation date", DateType),
            "blob": new QoreDataField("blob", "binary blob", BinaryType),
            "tags": new QoreDataField("tags", "tag list", new SoftListDataType(StringType)),
            "address": new QoreDataField("address", "nested address", addr),
        };
    }

    private AbstractDataProviderRecordIterator searchRecordsImpl(*hash<auto> where_cond, *hash<auto> search_options) {
        return new DefaultRecordIterator(data.iterator(), where_cond, search_options, getRecordTypeImpl());
    }
}

#! a child provider exposed via a parent's getChildProvider(), to test child traversal
class OrdersProvider inherits DataProvider::AbstractDataProvider {
    public {
        list<hash<auto>> rows = ({"oid": 100, "total": 9.99}, {"oid": 101, "total": 5.0});
    }

    string getName() {
        return "orders";
    }

    private hash<DataProviderInfo> getStaticInfoImpl() {
        return <DataProviderInfo>{"supports_read": True, "has_record": True};
    }

    private *hash<string, AbstractDataField> getRecordTypeImpl(*hash<auto> search_options) {
        return {
            "oid": new QoreDataField("oid", "order id", IntType),
            "total": new QoreDataField("total", "order total", FloatType),
        };
    }

    private AbstractDataProviderRecordIterator searchRecordsImpl(*hash<auto> where_cond, *hash<auto> search_options) {
        return new DefaultRecordIterator(rows.iterator(), where_cond, search_options, getRecordTypeImpl());
    }
}

#! a provider with a reduced operator set and a child provider, to test gating + child traversal
class ParentChildProvider inherits DataProvider::AbstractDataProvider {
    public {
        list<hash<auto>> data = ({"id": 1, "name": "Ada"},);
        OrdersProvider child();
    }

    string getName() {
        return "customer";
    }

    private hash<DataProviderInfo> getStaticInfoImpl() {
        # advertise only the "==" and ">" operators
        return <DataProviderInfo>{
            "supports_read": True,
            "supports_search_expressions": True,
            "expressions": DataProviderGenericExpressions{("==", ">")},
            "has_record": True,
        };
    }

    private *hash<string, AbstractDataField> getRecordTypeImpl(*hash<auto> search_options) {
        return {
            "id": new QoreDataField("id", "the id", IntType),
            "name": new QoreDataField("name", "the name", StringType),
        };
    }

    private AbstractDataProviderRecordIterator searchRecordsImpl(*hash<auto> where_cond, *hash<auto> search_options) {
        return new DefaultRecordIterator(data.iterator(), where_cond, search_options, getRecordTypeImpl());
    }

    private *list<string> getChildProviderNamesImpl() {
        return ("orders",);
    }

    private *AbstractDataProvider getChildProviderImpl(string name) {
        return name == "orders" ? child : NOTHING;
    }
}

#! a provider advertising limit/offset search options, to test server-side paging pushdown
class PagingProvider inherits DataProvider::AbstractDataProvider {
    public {
        list<hash<auto>> data = ({"id": 1}, {"id": 2}, {"id": 3}, {"id": 4});
        *hash<auto> last_options;
    }

    string getName() {
        return "page";
    }

    private hash<DataProviderInfo> getStaticInfoImpl() {
        return <DataProviderInfo>{
            "supports_read": True,
            "has_record": True,
            "search_options": {
                "limit": <DataProviderOptionInfo>{
                    "display_name": "Limit", "short_desc": "limit", "desc": "limit",
                    "type": AbstractDataProviderTypeMap."int",
                },
                "offset": <DataProviderOptionInfo>{
                    "display_name": "Offset", "short_desc": "offset", "desc": "offset",
                    "type": AbstractDataProviderTypeMap."int",
                },
            },
        };
    }

    private *hash<string, AbstractDataField> getRecordTypeImpl(*hash<auto> search_options) {
        return {"id": new QoreDataField("id", "the id", IntType)};
    }

    private AbstractDataProviderRecordIterator searchRecordsImpl(*hash<auto> where_cond, *hash<auto> search_options) {
        last_options = search_options;
        list<hash<auto>> sliced = data;
        if (exists search_options.offset && search_options.offset < sliced.size()) {
            sliced = sliced[search_options.offset..];
        }
        if (exists search_options.limit && search_options.limit < sliced.size()) {
            sliced = sliced[0..(search_options.limit - 1)];
        }
        return new DefaultRecordIterator(sliced.iterator(), where_cond, {}, getRecordTypeImpl());
    }
}

#! a transaction-capable provider, to test atomic return_records update/delete
class TxProvider inherits DataProvider::AbstractDataProvider {
    public {
        list<hash<auto>> data = ({"id": 1, "name": "A"},);
        bool began = False;
        bool committed = False;
    }

    string getName() {
        return "tx";
    }

    private hash<DataProviderInfo> getStaticInfoImpl() {
        return <DataProviderInfo>{
            "supports_read": True,
            "supports_update": True,
            "supports_search_expressions": True,
            "expressions": DataProviderGenericExpressions,
            "transaction_management": True,
            "has_record": True,
        };
    }

    private *hash<string, AbstractDataField> getRecordTypeImpl(*hash<auto> search_options) {
        return {
            "id": new QoreDataField("id", "the id", IntType),
            "name": new QoreDataField("name", "the name", StringType),
        };
    }

    private AbstractDataProviderRecordIterator searchRecordsImpl(*hash<auto> where_cond, *hash<auto> search_options) {
        return new DefaultRecordIterator(data.iterator(), where_cond, search_options, getRecordTypeImpl());
    }

    private int updateRecordsImpl(hash<auto> set, *hash<auto> where_cond, *hash<auto> search_options) {
        hash<string, bool> ids;
        DefaultRecordIterator it(data.iterator(), where_cond, search_options, getRecordTypeImpl());
        map ids{$1.id.toString()} = True, it;
        int n = 0;
        for (int i = 0; i < data.size(); ++i) {
            if (ids{data[i].id.toString()}) {
                data[i] += set;
                ++n;
            }
        }
        return n;
    }

    beginTransaction() {
        began = True;
    }

    commit() {
        committed = True;
    }
}
