#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%allow-injection

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Logger
%requires ConnectionProvider
%requires DataProvider
%requires GoogleDocumentAiRestClient
%requires GoogleDocumentAiDataProvider

%exec-class GoogleDocumentAiDataProviderTest

public class GoogleDocumentAiDataProviderTest inherits QUnit::Test {
    public {
        const MyOpts = Opts + {
            "conn": "c,connection=s",
        };

        const OptionColumn = 22;

        #! Tiny inline PNG (1x1 transparent pixel) — minimum-cost input
        const TinyPng = parse_base64_string(
            "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAj"
            "CB0C8AAAAASUVORK5CYII=");
    }

    private {
        *string conn_name;
    }

    constructor() : Test("GoogleDocumentAiDataProvider Test", "1.0",
            \ARGV, MyOpts) {
        conn_name = m_options.conn ?? ENV.GOOGLE_DOCUMENTAI_CONNECTION;

        addTestCase("factory + app + process-document registered",
            \registrationTest());
        addTestCase("app declares Documents AppGroup",
            \documentsAppGroupTest());
        addTestCase("app declares GoogleWorkspace AppGroup",
            \workspaceAppGroupTest());
        addTestCase("request type fields are typed correctly",
            \requestFieldsTest());
        addTestCase("constructor rejects missing gcp_project_id",
            \missingProjectTest());

        # Live tests require a real Google Document AI connection + a
        # `processor_id` env var (Google Doc AI processors are account-
        # specific and must be created in the GCP console).
        # Cost: 1 page on the OCR processor (free-tier eligible).
        if (conn_name) {
            addTestCase("live: ping + process-document",
                \liveGoogleDocAiTest());
        }
        set_return_value(main());
    }

    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-c,--connection=ARG",
            "set the Google Document AI connection name; without it (and "
            "without the GOOGLE_DOCUMENTAI_CONNECTION env var) the live "
            "test is skipped.  Also requires GOOGLE_DOCUMENTAI_PROCESSOR_ID "
            "naming a processor in the project.",
            OptionColumn);
    }

    private registrationTest() {
        DataProvider::AbstractDataProviderFactory f =
            DataProvider::DataProvider::getFactory("google-documentai");
        assertEq("google-documentai", f.getInfo().name);

        hash<DataProviderAppInfo> app =
            DataProvider::DataProviderActionCatalog::getApp("GoogleDocumentAi");
        assertEq("GoogleDocumentAi", app.name);
        assertEq("google-documentai", app.scheme);

        # filter out the framework-injected make-api-call action (covered by
        # GenericApiCallAutoInjection.qtest in RestClientDataProvider)
        list<hash<DataProviderActionInfo>> actions = select
            DataProvider::DataProviderActionCatalog::getActions("GoogleDocumentAi"),
            $1.action != AbstractDataProvider::GenericApiCallActionName;
        assertEq(1, actions.size());
        assertEq("process-document", actions[0].action);
    }

    private documentsAppGroupTest() {
        hash<DataProviderAppInfo> app =
            DataProvider::DataProviderActionCatalog::getApp("GoogleDocumentAi");
        assertTrue(inlist(DataProvider::AppGroup::AiLlm,     app.groups));
        assertTrue(inlist(DataProvider::AppGroup::Documents, app.groups));
    }

    private workspaceAppGroupTest() {
        hash<DataProviderAppInfo> app =
            DataProvider::DataProviderActionCatalog::getApp("GoogleDocumentAi");
        # Google services belong in the GoogleWorkspace group too
        assertTrue(inlist(DataProvider::AppGroup::GoogleWorkspace, app.groups));
    }

    private requestFieldsTest() {
        # processor_id is required + string
        *hash<auto> fld = GoogleDocumentAiDataProvider::GoogleDocumentAiProcessDocumentRequestDataType::Fields.processor_id;
        assertEq(True, fld.required);

        # mime_type has allowed_values with display_name
        *hash<auto> mt = GoogleDocumentAiDataProvider::GoogleDocumentAiProcessDocumentRequestDataType::Fields.mime_type;
        assertEq("application/pdf", mt.default_value);
        assertTrue(mt.allowed_values.size() >= 4);
        # First allowed value has both value + display_name
        assertEq("application/pdf", mt.allowed_values[0].value);
        assertEq("PDF",             mt.allowed_values[0].display_name);
    }

    private missingProjectTest() {
        assertThrows("CONSTRUCTOR-ERROR", sub () {
            GoogleDocumentAiDataProvider::GoogleDocumentAiDataProvider p({});
        });
    }

    #! Exercises Google Document AI's live `:process` endpoint
    /** Verifies the actual wire format against Google Cloud's Document
        AI service.  Requires both a connection name AND a
        `GOOGLE_DOCUMENTAI_PROCESSOR_ID` env var naming a processor in
        the connection's project.  Cost: 1 page on the OCR processor
        (free-tier eligible).
    */
    private liveGoogleDocAiTest() {
        *string processor_id = ENV.GOOGLE_DOCUMENTAI_PROCESSOR_ID;
        if (!processor_id.val()) {
            testSkip("GOOGLE_DOCUMENTAI_PROCESSOR_ID env var is required "
                "for the live test (create a processor in the GCP console "
                "and set this env var to its UUID)");
        }

        AbstractConnection conn = get_connection(conn_name);
        hash<auto> ping = conn.ping(True);
        assertTrue(ping.ok, sprintf("Google Document AI connection ping "
            "failed: %s", ping.info ?? "no info"));

        AbstractDataProvider prov = conn.getDataProvider();
        AbstractDataProvider pd = prov.getChildProvider("process-document");
        auto result = pd.doRequest({
            "processor_id":   processor_id,
            "document_bytes": TinyPng,
            "mime_type":      "image/png",
        });
        # Document AI returns a Document object with mimeType + (often
        # empty) text on a blank pixel
        assertTrue(exists result.document,
            "Google Document AI returned a document object");
        assertTrue(result.document.mimeType.val(),
            "document.mimeType is set");
    }
}
