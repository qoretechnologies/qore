%modern
%allow-injection

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Logger
%requires ConnectionProvider
%requires DataProvider
%requires GoogleDocumentAiRestClient
%requires GoogleDocumentAiDataProvider

%exec-class GoogleDocumentAiDataProviderTest

public class GoogleDocumentAiDataProviderTest inherits QUnit::Test {
    public {
        const MyOpts = Opts + {
            "conn": "c,connection=s",
        };

        const OptionColumn = 22;

        # Independent expected inventory: never derived from the implementation manifest.
        const ExpectedActions = (
            "process-document", "wait-for-operation", "make-api-call",
            "list-locations", "get-location", "list-processor-types", "get-processor-type",
            "list-processors", "get-processor", "create-processor", "delete-processor",
            "enable-processor", "disable-processor", "set-default-version",
            "start-batch-processing", "start-version-batch-processing", "list-processor-versions",
            "get-processor-version", "delete-processor-version", "train-processor-version",
            "deploy-processor-version", "undeploy-processor-version", "evaluate-processor-version",
            "list-evaluations", "get-evaluation", "list-operations", "get-operation", "cancel-operation",
            "list-schemas", "get-schema", "create-schema", "update-schema", "delete-schema",
            "list-schema-versions", "get-schema-version", "create-schema-version", "update-schema-version",
            "delete-schema-version", "generate-schema-version", "beta-update-dataset", "beta-get-dataset-schema",
            "beta-update-dataset-schema", "beta-get-dataset-document", "beta-list-dataset-documents",
            "beta-import-dataset-documents", "beta-delete-dataset-documents", "beta-import-processor-version",
        );
    }

    private {
        *string conn_name;
    }

    constructor() : Test("GoogleDocumentAiDataProvider Test", "1.0",
            \ARGV, MyOpts) {
        conn_name = m_options.conn ?? ENV.GOOGLE_DOCUMENTAI_CONNECTION;

        addTestCase("independent complete factory, app, and action inventory",
            \registrationTest());
        addTestCase("app declares Documents AppGroup",
            \documentsAppGroupTest());
        addTestCase("app declares GoogleWorkspace AppGroup",
            \workspaceAppGroupTest());
        addTestCase("request type fields are typed correctly",
            \requestFieldsTest());
        addTestCase("constructor rejects missing gcp_project_id",
            \missingProjectTest());

        # Opt in with a named connection or ADC project plus an existing processor.
        # Cost: three synthetic pages; never provisions resources or assumes free-tier eligibility.
        if (conn_name || (ENV.QORE_DOCUMENTAI_LIVE_PROJECT && ENV.GOOGLE_DOCUMENTAI_PROCESSOR_ID)) {
            addTestCase("live: ping + process-document",
                \liveGoogleDocAiTest());
        }
        set_return_value(main());
    }

    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-c,--connection=ARG",
            "set the Google Document AI connection name; without it (and "
            "without the GOOGLE_DOCUMENTAI_CONNECTION env var) the live "
            "test is skipped.  Also requires GOOGLE_DOCUMENTAI_PROCESSOR_ID "
            "naming a processor in the project. Alternatively set QORE_DOCUMENTAI_LIVE_PROJECT "
            "to use ADC directly. Processing submits three synthetic pages.",
            OptionColumn);
    }

    private registrationTest() {
        DataProvider::AbstractDataProviderFactory f =
            DataProvider::DataProvider::getFactory("google-documentai");
        assertEq("google-documentai", f.getInfo().name);

        hash<DataProviderAppInfo> app =
            DataProvider::DataProviderActionCatalog::getApp("GoogleDocumentAi");
        assertEq("GoogleDocumentAi", app.name);
        assertEq("google-documentai", app.scheme);

        list<hash<DataProviderActionInfo>> actions = DataProviderActionCatalog::getActions("GoogleDocumentAi");
        assertEq(sort(ExpectedActions), sort(map $1.action, actions));
        foreach hash<DataProviderActionInfo> action in (actions) {
            assertTrue(action.display_name.val());
            assertTrue(action.short_desc.size() < 80);
            assertFalse(action.options.hasKey("project_id"));
            assertFalse(action.options.hasKey("location"));
        }
    }

    private documentsAppGroupTest() {
        hash<DataProviderAppInfo> app =
            DataProvider::DataProviderActionCatalog::getApp("GoogleDocumentAi");
        assertTrue(inlist(DataProvider::AppGroup::AiLlm,     app.groups));
        assertTrue(inlist(DataProvider::AppGroup::Documents, app.groups));
    }

    private workspaceAppGroupTest() {
        hash<DataProviderAppInfo> app =
            DataProvider::DataProviderActionCatalog::getApp("GoogleDocumentAi");
        # Google services belong in the GoogleWorkspace group too
        assertTrue(inlist(DataProvider::AppGroup::GoogleWorkspace, app.groups));
    }

    private requestFieldsTest() {
        # processor_id is required + string
        *hash<auto> fld = GoogleDocumentAiDataProvider::GoogleDocumentAiProcessDocumentRequestDataType::Fields.processor_id;
        assertEq(True, fld.required);

        # mime_type has allowed_values with display_name
        *hash<auto> mt = GoogleDocumentAiDataProvider::GoogleDocumentAiProcessDocumentRequestDataType::Fields.mime_type;
        assertEq("application/pdf", mt.default_value);
        assertTrue(mt.allowed_values.size() >= 4);
        # First allowed value has both value + display_name
        assertEq("application/pdf", mt.allowed_values[0].value);
        assertEq("PDF",             mt.allowed_values[0].display_name);
    }

    private missingProjectTest() {
        assertThrows("CONSTRUCTOR-ERROR", sub () {
            GoogleDocumentAiDataProvider::GoogleDocumentAiDataProvider p({});
        });
    }

    #! Exercises Google Document AI's live `:process` endpoint
    /** Verifies the actual wire format against Google Cloud's Document
        AI service.  Requires both a connection name AND a
        `GOOGLE_DOCUMENTAI_PROCESSOR_ID` env var naming a processor in
        the connection's project, or an ADC project in QORE_DOCUMENTAI_LIVE_PROJECT.
        Cost: three synthetic pages on the selected processor.
    */
    private liveGoogleDocAiTest() {
        *string processor_id = ENV.GOOGLE_DOCUMENTAI_PROCESSOR_ID;
        if (!processor_id.val()) {
            testSkip("GOOGLE_DOCUMENTAI_PROCESSOR_ID must identify an existing processor for the live test");
        }

        AbstractConnection conn = conn_name ? get_connection(conn_name) : new GoogleDocumentAiRestConnection({
            "name": "document-ai-live-verification", "opts": {"gcp_project_id": ENV.QORE_DOCUMENTAI_LIVE_PROJECT,
                "gcp_region": ENV.QORE_DOCUMENTAI_LIVE_REGION ?? "us"}});
        hash<auto> ping = conn.ping(True);
        assertTrue(ping.ok, sprintf("Google Document AI connection ping "
            "failed: %s", ping.info ?? "no info"));

        AbstractDataProvider prov = conn.getDataProvider();
        AbstractDataProvider pd = prov.getChildProvider("process-document");
        auto processor = prov.getChildProvider("get-processor").doRequest({"processor_id": processor_id});
        assertTrue(processor.defaultProcessorVersion.val());
        auto versions = prov.getChildProvider("list-processor-versions").doRequest({
            "processor_id": processor_id, "pageSize": 10});
        assertTrue(versions.processorVersions.size() > 0);
        auto version = prov.getChildProvider("get-processor-version").doRequest({
            "processor_id": processor_id, "processor_version_id": processor.defaultProcessorVersion});
        assertEq(processor.defaultProcessorVersion, version.name);
        string fixture = get_script_dir() + "/../AwsTextractDataProvider/synthetic-invoice.pdf";
        foreach hash<auto> input in ((
                {"document_bytes": File::readBinaryFile(fixture)},
                {"document_path": fixture, "imageless_mode": True,
                    "process_options": {"individualPageSelector": {"pages": (1,)}}},
                {"document_bytes": File::readBinaryFile(fixture),
                    "processor_version_id": processor.defaultProcessorVersion,
                    "field_mask": "text,pages.pageNumber"})) {
            auto result = pd.doRequest(input + {"processor_id": processor_id, "mime_type": "application/pdf"});
            assertTrue(result.document.pages.size() > 0);
            foreach string expected in (("QORE TEXTRACT TEST INVOICE", "TEST-5420", "Synthetic Office Supplies", "12.34")) {
                assertTrue(result.document.text.find(expected) >= 0, "expected synthetic content: " + expected);
            }
            assertEq(1, result.document.pages[0].pageNumber);
        }
    }
}
