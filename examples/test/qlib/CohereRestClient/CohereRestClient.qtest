#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires ConnectionProvider
%requires DataProvider
%requires QoreLlmTypes
%requires QoreLlmUtils
%requires QoreRagTypes
%requires QoreRagUtils
%requires CohereRestClient

%exec-class CohereRestClientTest

public class CohereRestClientTest inherits QUnit::Test {
    public {
        #! command-line options; use -c/--connection to run the live tests
        const MyOpts = Opts + {
            "conn": "c,connection=s",
        };

        const OptionColumn = 22;
    }

    private {
        #! name of a live Cohere connection, if given
        *string conn_name;
    }

    constructor() : Test("CohereRestClient Test", "1.0", \ARGV, MyOpts) {
        conn_name = m_options.conn ?? ENV.COHERE_CONNECTION;

        addTestCase("connection scheme registered",       \connectionSchemeTest());
        addTestCase("LLM factory registered + advertises capabilities",
            \llmFactoryTest());
        addTestCase("Embedder factory registered",        \embedderFactoryTest());
        addTestCase("Reranker factory registered",        \rerankerFactoryTest());
        addTestCase("LLM provider requires api_key",      \providerConfigTest());
        addTestCase("REST client options apply Bearer mapping + v2 path",
            \restOptionsTest());
        addTestCase("embedder requires api_key",          \embedderConfigTest());
        addTestCase("reranker requires api_key",          \rerankerConfigTest());
        addTestCase("connection accepts both model options and rejects unknown ones",
            \connectionOptionsTest());
        addTestCase("live: ping + embed + rerank with the connection's models",
            \liveConnectionTest());
        set_return_value(main());
    }

    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-c,--connection=ARG",
            "set the Cohere connection name; without it (and without the "
            "COHERE_CONNECTION env var) the live test is skipped",
            OptionColumn);
    }

    private connectionSchemeTest() {
        hash<ConnectionSchemeInfo> info =
            ConnectionProvider::ConnectionSchemeCache::getScheme("cohere");
        assertEq("Cohere REST Connection", info.display_name);
        assertTrue(info.schemes.cohere);
        assertEq("apikey", info.required_options);

        # the connection serves both /embed and /rerank; the two model families
        # are distinct and are configured independently
        hash<ConnectionOptionInfo> emb = info.options."embedding-model";
        assertEq("Embedding Model", emb.display_name);
        assertEq("string", emb.type);
        assertEq("embed-multilingual-v3.0", emb.default_value);
        assertEq(CohereRestClient::CohereRestClientBase::DefaultEmbeddingModel,
            emb.default_value);

        hash<ConnectionOptionInfo> rr = info.options."rerank-model";
        assertEq("Reranking Model", rr.display_name);
        assertEq("string", rr.type);
        assertEq("rerank-v3.5", rr.default_value);
        assertEq(CohereRestClient::CohereRestClientBase::DefaultRerankModel,
            rr.default_value);
        assertNeq(emb.default_value, rr.default_value);
    }

    private llmFactoryTest() {
        QoreLlmUtils::AbstractLlmProviderFactory f =
            QoreLlmUtils::LlmProviderRegistry::getFactoryEx("cohere");
        assertEq("cohere", f.getMode());
        assertEq("Cohere chat (Command R/R+)", f.getDisplayName());
        assertEq("CohereRestClient", f.getInfo().module_name);
        hash<QoreLlmUtils::LlmProviderInfo> info = f.getInfo();
        # Cohere v1 doesn't ship streaming yet; document this clearly
        assertFalse(info.supports_streaming);
        assertTrue(info.supports_tools);
        assertTrue(info.supports_structured_output);
    }

    private embedderFactoryTest() {
        QoreRagUtils::AbstractEmbedderFactory ef =
            QoreRagUtils::RagProviderRegistry::getEmbedderFactoryEx("cohere");
        assertEq("cohere", ef.getType());
        assertEq("Cohere embeddings", ef.getDisplayName());
    }

    private rerankerFactoryTest() {
        QoreRagUtils::AbstractRerankerFactory rf =
            QoreRagUtils::RagProviderRegistry::getRerankerFactoryEx("cohere");
        assertEq("cohere", rf.getType());
        assertEq("Cohere rerank", rf.getDisplayName());
    }

    private providerConfigTest() {
        assertThrows("LLM-CONFIG-ERROR", sub () {
            new CohereRestClient::CohereLlmProvider(
                <QoreLlmUtils::LlmBackendConfig>{
                    "model": "command-r-plus",
                });
        });
    }

    private restOptionsTest() {
        hash<auto> opts = CohereRestClient::CohereRestClientBase::getOptions({
            "apikey": "my-key",
            "embedding-model": "embed-english-v3.0",
            "rerank-model": "rerank-multilingual-v3.0",
        });
        assertEq("my-key", opts.token);
        assertEq(NOTHING, opts.apikey);
        # Cohere defaults to v2 (not v1) — important distinction
        assertEq("https://api.cohere.com", opts.url);
        assertEq("v2", opts.api);
        assertEq("/v2", opts.default_path);
        # connection-level metadata must not leak into REST client options
        assertEq(NOTHING, opts{"embedding-model"});
        assertEq(NOTHING, opts{"rerank-model"});
    }

    private connectionOptionsTest() {
        CohereRestClient::CohereRestConnection conn("cohere-test", "test connection",
            CohereRestClient::CohereRestConnection::DefaultUrl, {}, {
                "apikey": "my-key",
                "embedding-model": "embed-english-v3.0",
                "rerank-model": "rerank-multilingual-v3.0",
            });
        assertEq("cohere", conn.getType());
        # getRealOptions() reports the configured connection option values
        assertEq("embed-english-v3.0", conn.getRealOptions(){"embedding-model"});
        assertEq("rerank-multilingual-v3.0", conn.getRealOptions(){"rerank-model"});
        # a client must still be constructible with the connection-only options present
        object client = conn.get(False);
        assertTrue(client instanceof CohereRestClient::CohereRestClient);

        assertThrows("CONNECTION-OPTION-ERROR", sub () {
            new CohereRestClient::CohereRestConnection("cohere-bad", "test",
                CohereRestClient::CohereRestConnection::DefaultUrl, {}, {
                    "apikey": "my-key",
                    "reranking_model": "rerank-v3.5",
                });
        });
    }

    private embedderConfigTest() {
        assertThrows("EMBEDDER-CONFIG-ERROR", sub () {
            new QoreRagUtils::CohereEmbedder(<QoreRagUtils::EmbedderConfig>{
                "backend": "cohere",
            });
        });
        QoreRagUtils::CohereEmbedder e(<QoreRagUtils::EmbedderConfig>{
            "backend": "cohere",
            "api_key": "k",
        });
        assertEq("embed-multilingual-v3.0", e.getModel());
    }

    private rerankerConfigTest() {
        assertThrows("RERANKER-CONFIG-ERROR", sub () {
            new QoreRagUtils::CohereReranker(<QoreRagUtils::RerankerConfig>{
                "backend": "cohere",
            });
        });
        QoreRagUtils::CohereReranker r(<QoreRagUtils::RerankerConfig>{
            "backend": "cohere",
            "api_key": "k",
        });
        assertEq("rerank-v3.5", r.getModel());
    }

    #! exercises a real Cohere connection end to end: ping, embed, rerank
    /** the embedding and reranking models come from the connection's
        \c embedding-model and \c rerank-model options, falling back to the
        scheme defaults when the connection does not set them
    */
    private liveConnectionTest() {
        if (!conn_name) {
            testSkip("no Cohere connection given; use -c/--connection or set "
                "COHERE_CONNECTION");
        }
        AbstractConnection conn = get_connection(conn_name);
        hash<PingInfo> ping = conn.ping(True);
        assertTrue(ping.ok, sprintf("connection %y ping failed: %s", conn_name,
            ping.info ?? "no info"));

        *hash<auto> copts = conn.getRealOptions();
        string emb_model = copts{"embedding-model"}
            ?? CohereRestClient::CohereRestClientBase::DefaultEmbeddingModel;
        string rr_model = copts{"rerank-model"}
            ?? CohereRestClient::CohereRestClientBase::DefaultRerankModel;

        AbstractDataProvider prov = conn.getDataProvider();
        AbstractDataProvider emb = prov.getChildProvider("embed");
        hash<auto> eresp = emb.doRequest({
            "model": emb_model,
            "texts": ("What is machine learning?",),
            "input_type": "search_query",
        });
        # Cohere v2 returns embeddings keyed by embedding type, not as a bare
        # list of vectors as v1 did
        assertEq(NT_HASH, eresp.embeddings.typeCode(),
            "v2 embeddings envelope is keyed by embedding type");
        *list<auto> vectors = eresp.embeddings."float";
        assertEq(1, vectors.lsize(), "one embedding per input text");
        assertTrue(vectors[0].lsize() > 0, "embedding vector is non-empty");

        AbstractDataProvider rrk = prov.getChildProvider("rerank");
        hash<auto> rresp = rrk.doRequest({
            "model": rr_model,
            "query": "What is machine learning?",
            "documents": (
                "Machine learning is a branch of AI focused on data-driven learning.",
                "The stock market closed higher today.",
            ),
            "top_n": 2,
        });
        assertEq(2, rresp.results.lsize());
        assertTrue(rresp.results[0].relevance_score >= rresp.results[1].relevance_score,
            "results sorted by relevance descending");
        assertEq(0, rresp.results[0]."index",
            "the machine-learning document ranks above the unrelated one");
    }
}
