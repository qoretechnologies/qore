#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - directory polling with stat() of new files in temp dirs, file-event dates and observers
# Copyright 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires FsUtil
%requires DataProvider
%requires ConnectionProvider
%requires FilePoller
# the interpreter that the test runner runs (examples/test/runner/test_interpreter_lookup)
%requires ../../TestInterpreter.qm

%exec-class FilePollerTest

class MyFilePoller inherits FilePoller {
    public {
        list fl = ();
    }

    constructor(string dir, *hash<auto> opts) : FilePoller(dir, ".*", opts) {
    }

    singleFileEvent(hash h) {
        fl += h.name;
    }
}

#! a poller that ignores its events
class IdleFilePoller inherits FilePoller {
    constructor(string dir) : FilePoller(dir, ".*", {"poll_interval": 1}) {
    }

    singleFileEvent(hash<FilePollerFileEventInfo> event) {
    }
}

#! the holder of a poller's only reference, which a poller's event can drop
class PollerHolder {
    public {
        *FilePoller poller;
    }
}

#! a poller that reports its events and its destruction; an event can drop its holder's reference to it
class LifetimePoller inherits FilePoller {
    private {
        Queue events;
        *PollerHolder drop;
        #! released when the poller is destroyed, which ends the sleep closure's wait
        *Counter release;
    }

    constructor(string dir, Queue events, *PollerHolder drop, *hash<auto> opts, *Counter release)
            : FilePoller(dir, "^lifetime-", {"poll_interval": 1} + opts) {
        self.events = events;
        self.drop = drop;
        self.release = release;
    }

    destructor() {
        events.push({"destructor": gettid()});
        if (release) {
            release.dec();
        }
    }

    singleFileEvent(hash<FilePollerFileEventInfo> event) {
        unlink(event.filepath);
        if (drop) {
            # the event drops the last reference that is not the polling thread's own
            remove drop.poller;
            remove drop;
        }
        events.push({"event": gettid()});
    }
}

public class FilePollerTest inherits QUnit::Test {
    public {
    }

    private {
        const Files = (
            "file1",
            "file2",
            "file3",
        );
    }

    constructor() : Test("FilePoller", "1.0") {
        addTestCase("FilePoller", \filePollerTest());
        addTestCase("FilePollerDataProvider", \filePollerDataProviderTest());
        addTestCase("stable file-event date examples", \dateExamples());
        addTestCase("start_thread from the thread's capability", \capabilityTest());
        addTestCase("start_thread from the thread's capability in a restricted Program", \restrictedCapabilityTest());
        addTestCase("dropping the last reference to a started poller stops its thread", \lastReferenceTest());
        addTestCase("the last reference dropped in the polling thread stops it without a deadlock",
            \lastReferenceInPollThreadTest());
        addTestCase("an observer refusal keeps the file and polling", \observerRefusalTest());
        addTestCase("a file list error stops polling", \listErrorStopsTest());

        # Return for compatibility with test harness that checks return value
        set_return_value(main());
    }

    #! the polling thread holds the poller only for each poll: dropping the owner's reference destroys the poller,
    #! whose destructor stops the thread and waits for it
    lastReferenceTest() {
        TmpDir dir("file-poller-lifetime-");
        Queue events();
        # the polling thread sleeps in this closure, which refers to no poller, until the poller is destroyed: the
        # reference is dropped while the thread holds none
        Counter release(1);
        code sleeper = sub (int secs) {
            events.push({"sleeping": gettid()});
            release.waitForZero();
        };
        int tid;
        # the file is polled before the thread sleeps
        writeLifetimeFile(dir.path, "1");
        {
            LifetimePoller poller(dir.path, events, NOTHING, {"poll_interval": 3600, "sleep": sleeper}, release);
            tid = poller.start();
            assertEq({"event": tid}, events.get(60s), "the polling thread polls");
            assertEq({"sleeping": tid}, events.get(60s), "and sleeps");
        }
        # the destructor ran when the last reference was dropped, and stopped the thread
        # the sleep closure can run again after the subclass destructor has released it, before the poller stops
        assertEq(({"destructor": gettid()},), (select (map events.get(), xrange(events.size())), $1.destructor),
            "the poller was destroyed in the thread that dropped its last reference, which the thread had left");
    }

    #! an event that drops the poller's last other reference leaves the polling thread's own as the last: the
    #! destructor runs in the polling thread after the poll and does not wait for itself
    lastReferenceInPollThreadTest() {
        TmpDir dir("file-poller-lifetime-");
        Queue events();
        PollerHolder holder();
        holder.poller = new LifetimePoller(dir.path, events, holder);
        int tid = holder.poller.start();
        writeLifetimeFile(dir.path, "1");
        assertEq({"event": tid}, events.get(60s), "the polling thread polls");
        assertEq({"destructor": tid}, events.get(60s), "the poller is destroyed in the polling thread");
        assertEq(NOTHING, holder.poller, "the holder's reference was dropped");
    }

    private static writeLifetimeFile(string dir, string name) {
        File f();
        f.open2(dir + "/lifetime-" + name, O_CREAT | O_WRONLY | O_TRUNC);
        f.write(name);
        f.close();
    }

    #! without the option, a poller created in a host's capability scope starts its thread with the host's
    #! start_thread (qorus#867)
    private capabilityTest() {
        TmpDir dir("FilePollerCapability-");
        Queue started();
        FilePoller fp;
        {
            ThreadCapabilityScope scope({"start_thread": int sub (code<nothing()> c) {
                started.push(True);
                return background c();
            }});
            fp = new IdleFilePoller(dir.path);
        }
        # the capability is taken when the poller is created, so it is used after the scope
        fp.start();
        on_exit fp.stop();
        assertEq(1, started.size(), "the polling thread was started with the host's start_thread");

        # a poller created outside a scope does not use it
        IdleFilePoller fp2(dir.path);
        fp2.start();
        on_exit fp2.stop();
        assertEq(1, started.size(), "outside a scope the host's start_thread is not used");
    }

    #! a restricted Program that loads the module first: the module declares THREAD_CONTROL, and in a scope it uses the
    #! host's start_thread (qorus#867)
    /** The module's requirement is set when it is first loaded, so the restricted Program must load it first: the
        check runs in a child process whose main Program does not load the module
    */
    private restrictedCapabilityTest() {
        TmpDir dir("FilePollerRestricted-");
        string script = dir.path + "/restricted.q";
        File f();
        f.open2(script, O_CREAT | O_TRUNC | O_WRONLY);
        f.write(RestrictedScript);
        f.close();
        string qore_bin = TestInterpreter::qore_interpreter();
        string module_dir = get_script_dir() + "/../../../../qlib"
            + (ENV.QORE_MODULE_DIR ? ":" + ENV.QORE_MODULE_DIR : "");
        string out = backquote(sprintf("QORE_MODULE_DIR=%s %s -b %s %s 2>&1", module_dir, qore_bin, script,
            dir.path));
        # the result lines; the loader can warn of modules that the restricted Program loads from source
        list<string> lines = select out.split("\n"), $1 =~ /^(no-)?scope: /;
        # the module declares the THREAD_CONTROL domain, so a restricted Program that loads it first needs no option
        assertEq("no-scope: created", lines[0], "without a scope, the poller is created without the option: " + out);
        # in a scope, the poller takes the capability, whose guard runs the module's code
        assertEq("scope: started 1", lines[1], "the poller started its thread with the host's start_thread: " + out);
        assertRegex("(^|\n)stopped\n", out, "the poller stopped");
    }

    private {
        #! a host whose restricted Program loads FilePoller first and creates a poller in and out of a scope
        const RestrictedScript = "%new-style
%require-types
%strict-args
Program p(PO_NEW_STYLE | PO_REQUIRE_TYPES | PO_STRICT_ARGS | PO_NO_THREAD_CONTROL);
p.loadModule(\"FilePoller\");
p.parse(\"class RestrictedPoller inherits FilePoller::FilePoller {
    constructor(string dir, *hash<auto> opts)
        : FilePoller::FilePoller(dir, \\\".*\\\", {\\\"poll_interval\\\": 1} + opts) {}
    singleFileEvent(hash<FilePoller::FilePollerFileEventInfo> event) {}
}
object sub make(string dir) { return new RestrictedPoller(dir); }\", \"restricted\");
string dir = ARGV[0];
try {
    p.callFunction(\"make\", dir);
    printf(\"no-scope: created\\n\");
} catch (hash<ExceptionInfo> ex) {
    printf(\"no-scope: %s\\n\", ex.err);
}
Queue started();
object fp;
{
    ThreadCapabilityScope scope({\"start_thread\": int sub (code c) {
        started.push(True);
        return background c();
    }});
    fp = p.callFunction(\"make\", dir);
}
try {
    fp.start();
    fp.stop();
    printf(\"scope: started %d\\n\", started.size());
} catch (hash<ExceptionInfo> ex) {
    printf(\"scope: %s, started %d\\n\", ex.err, started.size());
}
# a failed start leaves the poller stopped
fp.stop();
printf(\"stopped\\n\");
";
    }

    private dateExamples() {
        hash<auto> sample = FilePollerFileEventInfoDataType.getExampleValue();
        foreach string field in (("atime", "mtime", "ctime")) {
            assertEq(2000-01-01T00:00:00Z, sample{field});
            assertEq(0, sample{field}.getUtcOffset());
        }
        assertEq(sample, new FilePollerFileEventInfoDataType().getExampleValue(),
            "independent event type construction preserves example identity");
    }

    private filePollerTest() {
        string dir = tmp_location() + DirSep + get_random_string();
        mkdir(dir);
        *string cwd = getcwd();
        chdir(dir);
        on_exit
            rmdir(dir);
        # restore the working directory before the directory is removed, so later test cases have one
        on_exit if (cwd) {
            chdir(cwd);
        }

        File f();
        map f.open2($1, O_CREAT|O_TRUNC|O_WRONLY), Files;
        on_exit map unlink($1), Files;

        MyFilePoller fp(dir);
        fp.runOnce();
        fp.stop();
        assertEq(Files, fp.fl);
    }

    # issue #6400: an observer that refuses a file event leaves the file in place, and polling continues, so the file
    # is handled again on the next poll, once the observer accepts it; the other files of the poll that were not
    # handled yet are handled then too
    private observerRefusalTest() {
        TmpDir dir("FilePollerRefusal-");
        list<string> paths = map dir.path + DirSep + $1, ("a-refused.txt", "b-later.txt");
        File f();
        foreach string path in (paths) {
            f.open2(path, O_CREAT | O_TRUNC | O_WRONLY);
            f.close();
        }

        Logger logger("test", LoggerLevel::getLevelInfo());
        CapturingAppender capture();
        logger.addAppender(capture);

        # refuses the first two events, and accepts the others, removing their files
        RefusingObserver observer(2, True);
        FileDelayedPollerDataProvider fp({
            "path": dir.path,
            # the default sort is by name, ascending, so the first file is handled first
            "poll_interval": 1,
        });
        fp.setLogger(logger);
        fp.registerObserver(observer);
        on_exit fp.stopEvents();
        fp.observersReady();

        observer.waitAccepted(capture, 2);
        fp.stopEvents();

        # the first file was delivered again after each refusal (polling went on), and the second file, which was not
        # handled in the polls where the first one was refused, was delivered once after it
        assertEq(("a-refused.txt", "a-refused.txt", "a-refused.txt", "b-later.txt"), observer.getReceived());
        map assertFalse(is_file($1), "the accepting observer removed " + $1), paths;
        assertRegex("event handler for a file in .* failed: .*REFUSED: .*the file is kept", capture.getLog());
    }

    # a file list error is not a refusal: it stops polling, as before
    private listErrorStopsTest() {
        string dir = tmp_location() + DirSep + "FilePollerListError-" + get_random_string();
        mkdir(dir);

        MessageCollector msgs();
        MyFilePoller fp(dir, {
            "poll_interval": 1,
            "log_info": sub (string msg) { msgs.add(msg); },
        });
        rmdir(dir);
        fp.start();
        on_exit fp.stopNoWait();

        assertRegex("^cannot get file list from ", msgs.waitForMatch("^cannot get file list from "));
        msgs.waitForMatch("^polling finished$");
        fp.waitStop();
    }

    private filePollerDataProviderTest() {
        Logger logger();
        {
            LoggerLevel level;
            if (m_options.verbose > 3) {
                level = LoggerLevel::getLevelDebug();
            } else if (m_options.verbose > 2) {
                level = LoggerLevel::getLevelInfo();
            } else {
                level = LoggerLevel::getLevelError();
            }
            logger = new Logger("test", level);
        }
        logger.addAppender(new StdoutAppender());

        {
            FilesystemConnection fc("x", "x", "file:///tmp");
            AbstractDataProvider prov = fc.getDataProvider("filepoller");
            assertEq("filepoller", prov.getName());
        }

        TmpDir dir("FilePollerDataProvider-");

        MyObserver observer();
        FileDelayedPollerDataProvider fp({
            "path": dir.path,
            "poll_interval": 1,
        });
        fp.setLogger(logger);
        fp.registerObserver(observer);

        File f();
        map f.open2(dir.path + "/" + $1, O_CREAT|O_TRUNC|O_WRONLY), Files;
        on_exit map unlink($1), dir.path + "/" + Files;

        fp.observersReady();

        observer.wait();
        assertEq("file1", observer.h.file1.name);
        assertEq("file2", observer.h.file2.name);
        assertEq("file3", observer.h.file3.name);
        assertTrue(True);
    }
}

class MyObserver inherits Observer {
    public {
        hash<string, hash<auto>> h();
    }

    private {
        Mutex m();
        Condition cond();
    }

    update(string event_id, hash<auto> data_) {
        h{data_.name} = data_;
        if (h.size() == 3) {
            m.lock();
            on_exit m.unlock();

            cond.broadcast();
        }
    }

    wait() {
        date start = now_us();

        m.lock();
        on_exit m.unlock();

        while (h.size() != 3) {
            cond.wait(m, 1s);
            if ((now_us() - start) > 5s) {
                throw "ERROR", "no files in timeout";
            }
        }
    }
}

#! An observer that refuses a number of events by throwing, and then accepts the next one
class RefusingObserver inherits Observer {
    public {
        #! how long to wait for the accepted event; only a guard against a hang
        const EventTimeout = 30s;
    }

    private {
        #! the number of events to refuse
        int refusals;
        #! remove the file when the event is accepted
        bool remove_file;
        #! the number of events received
        int attempts = 0;
        #! the names of the files of the events received, in order
        list<string> received();
        #! the number of events accepted
        int accepted = 0;
        Mutex m();
        Condition cond();
    }

    constructor(int refusals, bool remove_file = False) {
        self.refusals = refusals;
        self.remove_file = remove_file;
    }

    update(string event_id, hash<auto> data_) {
        m.lock();
        on_exit m.unlock();

        received += data_.name;
        if (++attempts <= refusals) {
            throw "REFUSED", sprintf("event %d refused", attempts);
        }
        if (remove_file && data_.filepath) {
            unlink(data_.filepath);
        }
        ++accepted;
        cond.broadcast();
    }

    list<string> getReceived() {
        m.lock();
        on_exit m.unlock();

        return received;
    }

    #! Waits until \a count events have been accepted
    /** @throw ERROR the events were not accepted in @ref EventTimeout; the poller's log is included in the exception
    */
    waitAccepted(CapturingAppender capture, int count) {
        int start = clock_get_monotonic_us();

        m.lock();
        on_exit m.unlock();

        while (accepted < count) {
            int left_ms = EventTimeout.durationMilliseconds() - (clock_get_monotonic_us() - start) / 1000;
            if (left_ms <= 0) {
                throw "ERROR", sprintf("%d of %d events accepted in %y after %d event(s): %y; poller log:\n%s",
                    accepted, count, EventTimeout, attempts, received, capture.getLog());
            }
            cond.wait(m, left_ms);
        }
    }
}

#! Collects log messages from a poller log callback so that they can be matched deterministically
class MessageCollector {
    public {
        #! how long to wait for a matching message; only a guard against a hang
        const DefaultTimeout = 30s;
    }

    private {
        list<string> msgs();
        Mutex m();
        Condition cond();
    }

    #! Stores a message and wakes any waiter
    add(string msg) {
        m.lock();
        on_exit m.unlock();

        msgs += msg;
        cond.broadcast();
    }

    #! Waits for a message matching \a pattern and returns it
    /** @throw MESSAGE-TIMEOUT no matching message was collected in \a to
    */
    string waitForMatch(string pattern, timeout to = DefaultTimeout) {
        int start = clock_get_monotonic_us();

        m.lock();
        on_exit m.unlock();

        while (True) {
            foreach string msg in (msgs) {
                if (regex(msg, pattern)) {
                    return msg;
                }
            }
            int elapsed_ms = (clock_get_monotonic_us() - start) / 1000;
            if (elapsed_ms >= to) {
                throw "MESSAGE-TIMEOUT", sprintf("no message matching %y received in %dms; messages: %y", pattern,
                    to, msgs);
            }
            cond.wait(m, to - elapsed_ms);
        }
    }
}

#! An appender that stores all log messages in memory
class CapturingAppender inherits LoggerAppenderWithLayout {
    private {
        list<string> lines();
        Mutex m();
    }

    constructor() : LoggerAppenderWithLayout("capture",
            new LoggerLayoutPattern("%d{YYYY-MM-DD HH:mm:SS.xx} T%t [%p]: %m%n")) {
        open();
    }

    processEventImpl(int type, auto params) {
        if (type == LoggerAppender::EVENT_LOG) {
            m.lock();
            on_exit m.unlock();
            lines += params.toString();
        }
    }

    #! Returns all captured log messages as a single string
    string getLog() {
        m.lock();
        on_exit m.unlock();

        return lines ? lines.join("") : "<no log messages>";
    }
}
