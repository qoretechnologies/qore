#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - directory polling with stat() of new files in temp dirs, file-event dates and observers
# Copyright 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires FsUtil
%requires DataProvider
%requires ConnectionProvider
%requires FilePoller

%exec-class FilePollerTest

class MyFilePoller inherits FilePoller {
    public {
        list fl = ();
    }

    constructor(string dir) : FilePoller(dir, ".*") {
    }

    singleFileEvent(hash h) {
        fl += h.name;
    }
}

#! a poller that ignores its events
class IdleFilePoller inherits FilePoller {
    constructor(string dir) : FilePoller(dir, ".*", {"poll_interval": 1}) {
    }

    singleFileEvent(hash<FilePollerFileEventInfo> event) {
    }
}

public class FilePollerTest inherits QUnit::Test {
    public {
    }

    private {
        const Files = (
            "file1",
            "file2",
            "file3",
        );
    }

    constructor() : Test("FilePoller", "1.0") {
        addTestCase("FilePoller", \filePollerTest());
        addTestCase("FilePollerDataProvider", \filePollerDataProviderTest());
        addTestCase("stable file-event date examples", \dateExamples());
        addTestCase("start_thread from the thread's capability", \capabilityTest());
        addTestCase("start_thread from the thread's capability in a restricted Program", \restrictedCapabilityTest());

        # Return for compatibility with test harness that checks return value
        set_return_value(main());
    }

    #! without the option, a poller created in a host's capability scope starts its thread with the host's
    #! start_thread (qorus#867)
    private capabilityTest() {
        TmpDir dir("FilePollerCapability-");
        Queue started();
        FilePoller fp;
        {
            ThreadCapabilityScope scope({"start_thread": int sub (code<nothing()> c) {
                started.push(True);
                return background c();
            }});
            fp = new IdleFilePoller(dir.path);
        }
        # the capability is taken when the poller is created, so it is used after the scope
        fp.start();
        on_exit fp.stop();
        assertEq(1, started.size(), "the polling thread was started with the host's start_thread");

        # a poller created outside a scope does not use it
        IdleFilePoller fp2(dir.path);
        fp2.start();
        on_exit fp2.stop();
        assertEq(1, started.size(), "outside a scope the host's start_thread is not used");
    }

    #! a restricted Program that loads the module first: the module declares THREAD_CONTROL, and in a scope it uses the
    #! host's start_thread (qorus#867)
    /** The module's requirement is set when it is first loaded, so the restricted Program must load it first: the
        check runs in a child process whose main Program does not load the module
    */
    private restrictedCapabilityTest() {
        TmpDir dir("FilePollerRestricted-");
        string script = dir.path + "/restricted.q";
        File f();
        f.open2(script, O_CREAT | O_TRUNC | O_WRONLY);
        f.write(RestrictedScript);
        f.close();
        string qore_bin = ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        string module_dir = get_script_dir() + "/../../../../qlib"
            + (ENV.QORE_MODULE_DIR ? ":" + ENV.QORE_MODULE_DIR : "");
        string out = backquote(sprintf("QORE_MODULE_DIR=%s %s -b %s %s 2>&1", module_dir, qore_bin, script,
            dir.path));
        # the result lines; the loader can warn of modules that the restricted Program loads from source
        list<string> lines = select out.split("\n"), $1 =~ /^(no-)?scope: /;
        # the module declares the THREAD_CONTROL domain, so a restricted Program that loads it first needs no option
        assertEq("no-scope: created", lines[0], "without a scope, the poller is created without the option: " + out);
        # in a scope, the poller takes the capability, whose guard runs the module's code
        assertEq("scope: started 1", lines[1], "the poller started its thread with the host's start_thread: " + out);
        assertRegex("(^|\n)stopped\n", out, "the poller stopped");
    }

    private {
        #! a host whose restricted Program loads FilePoller first and creates a poller in and out of a scope
        const RestrictedScript = "%new-style
%require-types
%strict-args
Program p(PO_NEW_STYLE | PO_REQUIRE_TYPES | PO_STRICT_ARGS | PO_NO_THREAD_CONTROL);
p.loadModule(\"FilePoller\");
p.parse(\"class RestrictedPoller inherits FilePoller::FilePoller {
    constructor(string dir, *hash<auto> opts)
        : FilePoller::FilePoller(dir, \\\".*\\\", {\\\"poll_interval\\\": 1} + opts) {}
    singleFileEvent(hash<FilePoller::FilePollerFileEventInfo> event) {}
}
object sub make(string dir) { return new RestrictedPoller(dir); }\", \"restricted\");
string dir = ARGV[0];
try {
    p.callFunction(\"make\", dir);
    printf(\"no-scope: created\\n\");
} catch (hash<ExceptionInfo> ex) {
    printf(\"no-scope: %s\\n\", ex.err);
}
Queue started();
object fp;
{
    ThreadCapabilityScope scope({\"start_thread\": int sub (code c) {
        started.push(True);
        return background c();
    }});
    fp = p.callFunction(\"make\", dir);
}
try {
    fp.start();
    fp.stop();
    printf(\"scope: started %d\\n\", started.size());
} catch (hash<ExceptionInfo> ex) {
    printf(\"scope: %s, started %d\\n\", ex.err, started.size());
}
# a failed start leaves the poller stopped
fp.stop();
printf(\"stopped\\n\");
";
    }

    private dateExamples() {
        hash<auto> sample = FilePollerFileEventInfoDataType.getExampleValue();
        foreach string field in (("atime", "mtime", "ctime")) {
            assertEq(2000-01-01T00:00:00Z, sample{field});
            assertEq(0, sample{field}.getUtcOffset());
        }
        assertEq(sample, new FilePollerFileEventInfoDataType().getExampleValue(),
            "independent event type construction preserves example identity");
    }

    private filePollerTest() {
        string dir = tmp_location() + DirSep + get_random_string();
        mkdir(dir);
        *string cwd = getcwd();
        chdir(dir);
        on_exit
            rmdir(dir);
        # restore the working directory before the directory is removed, so later test cases have one
        on_exit if (cwd) {
            chdir(cwd);
        }

        File f();
        map f.open2($1, O_CREAT|O_TRUNC|O_WRONLY), Files;
        on_exit map unlink($1), Files;

        MyFilePoller fp(dir);
        fp.runOnce();
        fp.stop();
        assertEq(Files, fp.fl);
    }

    private filePollerDataProviderTest() {
        Logger logger();
        {
            LoggerLevel level;
            if (m_options.verbose > 3) {
                level = LoggerLevel::getLevelDebug();
            } else if (m_options.verbose > 2) {
                level = LoggerLevel::getLevelInfo();
            } else {
                level = LoggerLevel::getLevelError();
            }
            logger = new Logger("test", level);
        }
        logger.addAppender(new StdoutAppender());

        {
            FilesystemConnection fc("x", "x", "file:///tmp");
            AbstractDataProvider prov = fc.getDataProvider("filepoller");
            assertEq("filepoller", prov.getName());
        }

        TmpDir dir("FilePollerDataProvider-");

        MyObserver observer();
        FileDelayedPollerDataProvider fp({
            "path": dir.path,
            "poll_interval": 1,
        });
        fp.setLogger(logger);
        fp.registerObserver(observer);

        File f();
        map f.open2(dir.path + "/" + $1, O_CREAT|O_TRUNC|O_WRONLY), Files;
        on_exit map unlink($1), dir.path + "/" + Files;

        fp.observersReady();

        observer.wait();
        assertEq("file1", observer.h.file1.name);
        assertEq("file2", observer.h.file2.name);
        assertEq("file3", observer.h.file3.name);
        assertTrue(True);
    }
}

class MyObserver inherits Observer {
    public {
        hash<string, hash<auto>> h();
    }

    private {
        Mutex m();
        Condition cond();
    }

    update(string event_id, hash<auto> data_) {
        h{data_.name} = data_;
        if (h.size() == 3) {
            m.lock();
            on_exit m.unlock();

            cond.broadcast();
        }
    }

    wait() {
        date start = now_us();

        m.lock();
        on_exit m.unlock();

        while (h.size() != 3) {
            cond.wait(m, 1s);
            if ((now_us() - start) > 5s) {
                throw "ERROR", "no files in timeout";
            }
        }
    }
}
