#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/QoreLlmTypes.qm
%requires ../../../../qlib/QoreLlmUtils
%requires ../../../../qlib/OpenAiRestClient.qm
%requires ../../../../qlib/GroqRestClient.qm

%exec-class GroqRestClientTest

public class GroqRestClientTest inherits QUnit::Test {
    constructor() : Test("GroqRestClient Test", "1.0") {
        addTestCase("connection scheme registered",        \connectionSchemeTest());
        addTestCase("factory registered + lazy-loadable",  \factoryTest());
        addTestCase("provider applies default URL",        \defaultUrlTest());
        addTestCase("provider preserves explicit URL",     \explicitUrlTest());
        addTestCase("factory getInfo advertises capabilities",
            \getInfoTest());
        addTestCase("default chat-completions path is OpenAI shape",
            \chatPathTest());
        addTestCase("REST client options apply Bearer mapping",
            \restOptionsTest());
        addTestCase("Groq mode is distinct from Grok mode",
            \distinctModesTest());
        set_return_value(main());
    }

    private connectionSchemeTest() {
        hash<ConnectionSchemeInfo> info =
            ConnectionProvider::ConnectionSchemeCache::getScheme("groq");
        assertEq("Groq REST Connection", info.display_name);
        assertTrue(info.schemes.groq);
        assertEq("apikey", info.required_options);
    }

    private factoryTest() {
        QoreLlmUtils::AbstractLlmProviderFactory f =
            QoreLlmUtils::LlmProviderRegistry::getFactoryEx("groq");
        assertEq("groq", f.getMode());
        assertEq("Groq LPU inference (OpenAI-compatible)", f.getDisplayName());
        assertEq("GroqRestClient", f.getInfo().module_name);
    }

    private defaultUrlTest() {
        GroqRestClient::GroqLlmProvider p(
            <QoreLlmUtils::LlmBackendConfig>{
                "model": "llama-3.3-70b-versatile",
                "api_key": "test-key",
            });
        assertEq("groq", p.getMode());
        assertEq(GroqRestClient::GroqLlmProvider::DefaultUrl, p.getConfig().url);
    }

    private explicitUrlTest() {
        GroqRestClient::GroqLlmProvider p(
            <QoreLlmUtils::LlmBackendConfig>{
                "url": "https://custom.example.com",
                "model": "llama-3.3-70b-versatile",
                "api_key": "k",
            });
        assertEq("https://custom.example.com", p.getConfig().url);
    }

    private getInfoTest() {
        QoreLlmUtils::AbstractLlmProviderFactory f =
            QoreLlmUtils::LlmProviderRegistry::getFactoryEx("groq");
        hash<QoreLlmUtils::LlmProviderInfo> info = f.getInfo();
        assertTrue(info.supports_streaming);
        assertTrue(info.supports_tools);
        assertTrue(info.supports_structured_output);
        assertTrue(info.supports_multimodal);
    }

    private chatPathTest() {
        GroqRestClient::GroqLlmProvider p(
            <QoreLlmUtils::LlmBackendConfig>{
                "model": "llama-3.3-70b-versatile",
                "api_key": "k",
            });
        # OpenAI-compatible default — Groq does NOT override the path
        # (the /openai prefix lives on the URL, not the path)
        assertEq("/v1/chat/completions", p.getChatCompletionsPath());
    }

    private restOptionsTest() {
        hash<auto> opts = GroqRestClient::GroqRestClientBase::getOptions({
            "apikey": "my-key",
        });
        # apikey is remapped to token for Bearer header
        assertEq("my-key", opts.token);
        assertEq(NOTHING, opts.apikey);
        # URL + api defaults applied
        assertEq("https://api.groq.com/openai", opts.url);
        assertEq("v1", opts.api);
        assertEq("/v1", opts.default_path);
    }

    private distinctModesTest() {
        # ensure Groq and Grok don't collide — they're independent modes
        GroqRestClient::GroqLlmProviderFactory groq_factory();
        assertEq("groq", groq_factory.getMode());
        # mode string must NOT collide with xAI Grok mode
        assertNeq("grok", groq_factory.getMode());
    }
}
