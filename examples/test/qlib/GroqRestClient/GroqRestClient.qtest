#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/QoreLlmTypes.qm
%requires ../../../../qlib/QoreLlmUtils
%requires ../../../../qlib/OpenAiRestClient.qm
%requires ../../../../qlib/GroqRestClient.qm

%requires ../../../../qlib/HttpServer.qm
%requires json

%exec-class GroqRestClientTest

class GroqPingHandler inherits AbstractHttpRequestHandler {
    private {
        Mutex lock();
        hash<auto> request;
    }
    hash handleRequest(hash cx, hash hdr, *data body) {
        AutoLock al(lock);
        request = hdr;
        return makeResponse(hdr.authorization == "Bearer test-key" ? 200 : 401,
            hdr.authorization == "Bearer test-key" ? "[]" : "{\"error\":\"Unauthorized\"}",
            {"Content-Type": MimeTypeJson});
    }
    hash<auto> getRequest() {
        AutoLock al(lock);
        return request;
    }
}

class SyncGroqConnection inherits GroqRestClient::GroqRestConnection {
    constructor(string url, hash<auto> options)
            : GroqRestConnection("sync-test", "test", url, {}, options) {
    }
    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        throw "CONNECTION-ASYNC-UNSUPPORTED", "exercise synchronous ping";
    }
}



public class GroqRestClientTest inherits QUnit::Test {
    constructor() : Test("GroqRestClient Test", "1.0") {
        addTestCase("connection scheme registered",        \connectionSchemeTest());
        addTestCase("factory registered + lazy-loadable",  \factoryTest());
        addTestCase("provider applies default URL",        \defaultUrlTest());
        addTestCase("provider preserves explicit URL",     \explicitUrlTest());
        addTestCase("factory getInfo advertises capabilities",
            \getInfoTest());
        addTestCase("default chat-completions path is OpenAI shape",
            \chatPathTest());
        addTestCase("REST client options apply Bearer mapping",
            \restOptionsTest());
        addTestCase("Groq mode is distinct from Grok mode",
            \distinctModesTest());
        addTestCase("sync GroqRestClient connection path includes /openai",
            \syncConnectionPathTest());
        addTestCase("automatic connection URL and app identity", \connectionConfigTest());
        addTestCase("sync and async pings verify authentication", \pingTest());
        if (ENV.GROQ_LIVE) {
            addTestCase("live valid and invalid authentication", \livePingTest());
        }
        set_return_value(main());
    }

    private connectionConfigTest() {
        GroqRestClient::GroqRestConnection conn({
            "name": "test", "desc": "automatic connection", "url": "groq://localhost",
            "opts": {"apikey": "test-key"},
        });
        assertEq("Groq", conn.getAppName());
        assertEq("Groq", conn.getInfo().app);
        assertEq("https://api.groq.com", conn.getConnectionOptions().url);
        assertEq("json", conn.getConnectionOptions().data);
        assertTrue(GroqRestClient::GroqRestConnection::ConnectionScheme.options.apikey.sensitive);
        assertThrows("CONNECTION-OPTION-ERROR", sub () {
            new GroqRestClient::GroqRestConnection("missing", "missing credentials");
        });
        assertEq("v1", GroqRestClient::GroqRestConnection::ConnectionScheme.options.api.allowed_values[0].value);
        GroqRestClient::GroqRestConnection legacy("legacy", "old automatic URL", "groq://localhost", {},
            {"apikey": "test-key"});
        *hash<auto> updated;
        legacy.setUpdateOptionsCode(sub (hash<auto> options) { updated = options; });
        assertEq({"url": GroqRestClient::GroqRestConnection::DefaultUrl}, updated);
        legacy.setUpdateOptionsCode(NOTHING);
        updated = NOTHING;
        conn.setUpdateOptionsCode(sub (hash<auto> options) { updated = options; });
        assertNothing(updated);
        conn.setUpdateOptionsCode(NOTHING);
    }

    private pingTest() {
        HttpServer http(<HttpServerOptionInfo>{"logger": new Logger("test", LoggerLevel::getLevelWarn())});
        on_exit delete http;
        int port = http.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        GroqPingHandler handler();
        http.setDefaultHandler("ping", handler);
        string url = sprintf("http://127.0.0.1:%d", port);
        foreach bool sync in (False, True) {
            foreach string key in ("test-key", "invalid-key") {
                hash<auto> opts = {"apikey": key, "http_version": "1.1"};
                GroqRestClient::GroqRestConnection conn = sync
                    ? new SyncGroqConnection(url, opts)
                    : new GroqRestClient::GroqRestConnection("test", "test", url, {}, opts);
                if (key == "test-key") {
                    assertTrue(conn.ping(True).ok);
                } else {
                    assertPingFailure(conn);
                }
                assertEq("openai/v1/models", handler.getRequest().path);
                assertEq("GET", handler.getRequest().method);
                assertEq("Bearer " + key, handler.getRequest().authorization);
            }
        }
        GroqRestClient::GroqRestClient client({"url": url, "apikey": "test-key"});
        assertTrue(client.isConnected());
        GroqRestClient::GroqRestClient deferred({"url": url, "apikey": "test-key"}, True);
        assertFalse(deferred.isConnected());
        deferred.get("models");
        assertTrue(deferred.isConnected());
        client.get("models");
        assertEq("openai/v1/models", handler.getRequest().path);
        assertEq("Bearer test-key", handler.getRequest().authorization);
    }

    private assertPingFailure(GroqRestClient::GroqRestConnection conn) {
        *hash<ExceptionInfo> error;
        try {
            conn.ping(True);
        } catch (hash<ExceptionInfo> ex) {
            error = ex;
        }
        assertTrue(exists error);
        assertRegex("^(REST-PING-ERROR|REST-RESPONSE-ERROR|HTTP-CLIENT-RECEIVE-ERROR)$", error.err);
        assertRegex("401", error.desc);
    }

    private livePingTest() {
        GroqRestClient::GroqRestConnection conn("live", "live authentication",
            GroqRestClient::GroqRestConnection::DefaultUrl, {}, {"apikey": ENV.GROQ_APIKEY});
        assertTrue(conn.ping(True).ok);
        GroqRestClient::GroqRestConnection invalid("invalid", "negative authentication",
            GroqRestClient::GroqRestConnection::DefaultUrl, {}, {"apikey": "invalid-qore-audit-key"});
        assertPingFailure(invalid);
    }

    private connectionSchemeTest() {
        hash<ConnectionSchemeInfo> info =
            ConnectionProvider::ConnectionSchemeCache::getScheme("groq");
        assertEq("Groq REST Connection", info.display_name);
        assertTrue(info.schemes.groq);
        assertEq("apikey", info.required_options);
    }

    private factoryTest() {
        QoreLlmUtils::AbstractLlmProviderFactory f =
            QoreLlmUtils::LlmProviderRegistry::getFactoryEx("groq");
        assertEq("groq", f.getMode());
        assertEq("Groq LPU inference (OpenAI-compatible)", f.getDisplayName());
        assertEq("GroqRestClient", f.getInfo().module_name);
    }

    private defaultUrlTest() {
        GroqRestClient::GroqLlmProvider p(
            <QoreLlmUtils::LlmBackendConfig>{
                "model": "test-model",
                "api_key": "test-key",
            });
        assertEq("groq", p.getMode());
        assertEq(GroqRestClient::GroqLlmProvider::DefaultUrl, p.getConfig().url);
    }

    private explicitUrlTest() {
        GroqRestClient::GroqLlmProvider p(
            <QoreLlmUtils::LlmBackendConfig>{
                "url": "https://custom.example.com",
                "model": "test-model",
                "api_key": "k",
            });
        assertEq("https://custom.example.com", p.getConfig().url);
    }

    private getInfoTest() {
        QoreLlmUtils::AbstractLlmProviderFactory f =
            QoreLlmUtils::LlmProviderRegistry::getFactoryEx("groq");
        hash<QoreLlmUtils::LlmProviderInfo> info = f.getInfo();
        assertTrue(info.supports_streaming);
        assertTrue(info.supports_tools);
        assertTrue(info.supports_structured_output);
        assertTrue(info.supports_multimodal);
    }

    private chatPathTest() {
        GroqRestClient::GroqLlmProvider p(
            <QoreLlmUtils::LlmBackendConfig>{
                "model": "test-model",
                "api_key": "k",
            });
        # OpenAI-compatible default — Groq does NOT override the path
        # (the /openai prefix lives on the URL, not the path)
        assertEq("/v1/chat/completions", p.getChatCompletionsPath());
    }

    private restOptionsTest() {
        hash<auto> opts = GroqRestClient::GroqRestClientBase::getOptions({
            "apikey": "my-key",
        });
        # apikey is remapped to token for Bearer header
        assertEq("my-key", opts.token);
        assertEq(NOTHING, opts.apikey);
        # URL + api defaults applied — /openai now lives on default_path,
        # not on the URL, so HTTPClient applies it for relative paths
        # like the ping `models` -> /openai/v1/models.
        assertEq("https://api.groq.com", opts.url);
        assertEq("v1", opts.api);
        assertEq("/openai/v1", opts.default_path);

        # overriding the api version threads through to default_path
        hash<auto> opts2 = GroqRestClient::GroqRestClientBase::getOptions({
            "apikey": "k",
            "api": "v2",
        });
        assertEq("/openai/v2", opts2.default_path);

        # legacy api values that already include the "openai/" path prefix
        # must not double it in default_path
        hash<auto> opts3 = GroqRestClient::GroqRestClientBase::getOptions({
            "apikey": "k",
            "api": "openai/v1",
        });
        assertEq("/openai/v1", opts3.default_path);
    }

    private syncConnectionPathTest() {
        # The bug we're guarding against: sync GroqRestClient used to call
        # setConnectionPath("v1") in its constructor, which overwrote the
        # /openai prefix and made pings hit /v1/models -> 404.  After the
        # fix the /openai prefix lives on default_path and HTTPClient
        # promotes it onto connection.path, so the resolved request path
        # for `models` is /openai/v1/models.
        GroqRestClient::GroqRestClient rc({"apikey": "k"}, True);
        # connection path must include both /openai and the api version
        assertEq("/openai/v1", rc.getConnectionPath());
        # async client must produce the same connection path
        GroqRestClient::GroqRestClientIo io({"apikey": "k"});
        assertEq("/openai/v1", io.getConnectionPath());
    }

    private distinctModesTest() {
        # ensure Groq and Grok don't collide — they're independent modes
        GroqRestClient::GroqLlmProviderFactory groq_factory();
        assertEq("groq", groq_factory.getMode());
        # mode string must NOT collide with xAI Grok mode
        assertNeq("grok", groq_factory.getMode());
    }
}
