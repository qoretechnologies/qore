    #! App API snippet CRUD: create -> get -> update -> list -> delete
    integrationSnippetCrudTests() {
        checkJson();
        checkCredentials();

        CustomerIoDataProvider::CustomerIoDataProvider provider = createIntegrationProvider();

        string snippet_name = sprintf("qore_test_snippet_%s", testSuffix);
        testSnippetName = snippet_name;

        # create-snippet
        {
            AbstractDataProvider dp = provider.getChildProvider("create-snippet");
            auto result = dp.doRequest({
                "name": snippet_name,
                "value": "<p>Hello from Qore test!</p>",
            });
            assertTrue(True);
            if (m_options.verbose) {
                printf("create-snippet: OK - %s\n", snippet_name);
            }
        }

        # get-snippet
        {
            AbstractDataProvider dp = provider.getChildProvider("get-snippet");
            auto result = dp.doRequest({
                "snippet_name": snippet_name,
            });
            # Verify snippet data persistence
            if (result.name) {
                assertEq(snippet_name, result.name);
            }
            if (result.value) {
                assertEq("<p>Hello from Qore test!</p>", result.value);
            }
            if (m_options.verbose) {
                printf("get-snippet: OK\n");
            }
        }

        # update-snippet
        {
            AbstractDataProvider dp = provider.getChildProvider("update-snippet");
            auto result = dp.doRequest({
                "snippet_name": snippet_name,
                "value": "<p>Updated by Qore test!</p>",
            });
            assertTrue(True);
            if (m_options.verbose) {
                printf("update-snippet: OK\n");
            }
        }

        # Verify update persisted
        {
            AbstractDataProvider dp = provider.getChildProvider("get-snippet");
            auto result = dp.doRequest({
                "snippet_name": snippet_name,
            });
            if (result.value) {
                assertEq("<p>Updated by Qore test!</p>", result.value);
            }
            if (m_options.verbose) {
                printf("get-snippet (verify update): OK - value: %y\n", result.value);
            }
        }

        # list-snippets (verify our snippet appears)
        {
            AbstractDataProvider dp = provider.getChildProvider("snippets");
            AbstractDataProviderRecordIterator i = dp.searchRecords();
            assertTrue(True);
            if (m_options.verbose) {
                printf("list-snippets (after create): OK\n");
            }
        }

        # delete-snippet
        {
            AbstractDataProvider dp = provider.getChildProvider("delete-snippet");
            auto result = dp.doRequest({
                "snippet_name": snippet_name,
            });
            assertTrue(True);
            if (m_options.verbose) {
                printf("delete-snippet: OK\n");
            }
            remove testSnippetName;
        }
    }

    #! App API collection CRUD: create -> get -> update -> list -> delete
    integrationCollectionCrudTests() {
        checkJson();
        checkCredentials();

        CustomerIoDataProvider::CustomerIoDataProvider provider = createIntegrationProvider();

        string coll_name = sprintf("qore_test_collection_%s", testSuffix);

        # create-collection
        *int collection_id;
        {
            AbstractDataProvider dp = provider.getChildProvider("create-collection");
            auto result = dp.doRequest({
                "name": coll_name,
                "data": (
                    {"product": "Widget A", "price": 10},
                    {"product": "Widget B", "price": 20},
                ),
            });
            assertTrue(True);
            if (result.id) {
                collection_id = result.id;
                testCollectionId = collection_id;
            }
            if (m_options.verbose) {
                printf("create-collection: OK - %s (ID: %y)\n", coll_name, collection_id);
            }
        }

        if (!collection_id) {
            if (m_options.verbose) {
                printf("Skipping remaining collection tests - no collection ID returned\n");
            }
            return;
        }

        # get-collection
        {
            AbstractDataProvider dp = provider.getChildProvider("get-collection");
            auto result = dp.doRequest({
                "collection_id": collection_id,
            });
            # Verify collection data
            if (result.name) {
                assertEq(coll_name, result.name);
            }
            if (m_options.verbose) {
                printf("get-collection: OK\n");
            }
        }

        # update-collection
        {
            AbstractDataProvider dp = provider.getChildProvider("update-collection");
            auto result = dp.doRequest({
                "collection_id": collection_id,
                "name": coll_name + "_updated",
                "data": (
                    {"product": "Widget C", "price": 30},
                ),
            });
            assertTrue(True);
            if (m_options.verbose) {
                printf("update-collection: OK\n");
            }
        }

        # list-collections (verify our collection appears)
        {
            AbstractDataProvider dp = provider.getChildProvider("collections");
            AbstractDataProviderRecordIterator i = dp.searchRecords();
            assertTrue(True);
            if (m_options.verbose) {
                printf("list-collections (after create): OK\n");
            }
        }

        # delete-collection
        {
            AbstractDataProvider dp = provider.getChildProvider("delete-collection");
            auto result = dp.doRequest({
                "collection_id": collection_id,
            });
            assertTrue(True);
            if (m_options.verbose) {
                printf("delete-collection: OK\n");
            }
            remove testCollectionId;
        }
    }

    #! Final cleanup - delete any resources that weren't cleaned up due to test failures
    integrationCleanup() {
        checkJson();
        if (!client) {
            return;
        }

        CustomerIoDataProvider::CustomerIoDataProvider provider = createIntegrationProvider();

        # Clean up test customer
        if (testCustomerId) {
            try {
                AbstractDataProvider dp = provider.getChildProvider("delete-customer");
                dp.doRequest({"customer_id": testCustomerId});
                if (m_options.verbose) {
                    printf("Cleanup: deleted test customer %s\n", testCustomerId);
                }
            } catch (hash<ExceptionInfo> ex) {
                if (m_options.verbose) {
                    printf("Cleanup: failed to delete customer %s: %s\n", testCustomerId, ex.desc);
                }
            }
            remove testCustomerId;
        }

        # Clean up test snippet
        if (testSnippetName) {
            try {
                AbstractDataProvider dp = provider.getChildProvider("delete-snippet");
                dp.doRequest({"snippet_name": testSnippetName});
                if (m_options.verbose) {
                    printf("Cleanup: deleted test snippet %s\n", testSnippetName);
                }
            } catch (hash<ExceptionInfo> ex) {
                if (m_options.verbose) {
                    printf("Cleanup: failed to delete snippet %s: %s\n", testSnippetName, ex.desc);
                }
            }
            remove testSnippetName;
        }

        # Clean up test collection
        if (testCollectionId) {
            try {
                AbstractDataProvider dp = provider.getChildProvider("delete-collection");
                dp.doRequest({"collection_id": testCollectionId});
                if (m_options.verbose) {
                    printf("Cleanup: deleted test collection %d\n", testCollectionId);
                }
            } catch (hash<ExceptionInfo> ex) {
                if (m_options.verbose) {
                    printf("Cleanup: failed to delete collection %d: %s\n", testCollectionId, ex.desc);
                }
            }
            remove testCollectionId;
        }

        assertTrue(True);
    }
}
