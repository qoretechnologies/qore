    #! Track API customer lifecycle: create -> update -> suppress -> unsuppress -> delete
    integrationTrackCustomerLifecycleTests() {
        checkJson();
        checkCredentials();

        CustomerIoDataProvider::CustomerIoDataProvider provider = createIntegrationProvider();
        string cust_id = sprintf("qore-test-%s", testSuffix);
        testCustomerId = cust_id;

        # create-update-customer (create)
        string test_email = sprintf("%s@test.example.com", cust_id);
        {
            AbstractDataProvider dp = provider.getChildProvider("create-update-customer");
            auto result = dp.doRequest({
                "customer_id": cust_id,
                "email": test_email,
                "created_at": get_epoch_seconds(now()),
                "attributes": {
                    "first_name": "Qore",
                    "last_name": "Test",
                    "plan": "free",
                },
            });
            # Track API returns 200 on success
            assertTrue(True);
            if (m_options.verbose) {
                printf("create-update-customer (create): OK - %s\n", cust_id);
            }
        }

        # Verify customer was created (App API)
        {
            # Brief delay for Track API -> App API propagation
            sleep(2s);
            try {
                AbstractDataProvider dp = provider.getChildProvider("get-person");
                auto result = dp.doRequest({
                    "customer_id": cust_id,
                });
                # Verify the customer has the expected email
                if (result.email) {
                    assertEq(test_email, result.email);
                }
                if (m_options.verbose) {
                    printf("get-person (verify create): OK - email: %y\n", result.email);
                }
            } catch (hash<ExceptionInfo> ex) {
                # App API may take time to sync, log but don't fail
                if (m_options.verbose) {
                    printf("get-person (verify create): skipped - %s\n", ex.desc);
                }
            }
        }

        # create-update-customer (update attributes)
        {
            AbstractDataProvider dp = provider.getChildProvider("create-update-customer");
            auto result = dp.doRequest({
                "customer_id": cust_id,
                "attributes": {
                    "plan": "pro",
                    "updated_by": "qore-test",
                },
            });
            assertTrue(True);
            if (m_options.verbose) {
                printf("create-update-customer (update): OK\n");
            }
        }

        # suppress-customer
        {
            AbstractDataProvider dp = provider.getChildProvider("suppress-customer");
            auto result = dp.doRequest({
                "customer_id": cust_id,
            });
            assertTrue(True);
            if (m_options.verbose) {
                printf("suppress-customer: OK\n");
            }
        }

        # unsuppress-customer
        {
            AbstractDataProvider dp = provider.getChildProvider("unsuppress-customer");
            auto result = dp.doRequest({
                "customer_id": cust_id,
            });
            assertTrue(True);
            if (m_options.verbose) {
                printf("unsuppress-customer: OK\n");
            }
        }

        # delete-customer
        {
            AbstractDataProvider dp = provider.getChildProvider("delete-customer");
            auto result = dp.doRequest({
                "customer_id": cust_id,
            });
            assertTrue(True);
            if (m_options.verbose) {
                printf("delete-customer: OK\n");
            }
            remove testCustomerId;
        }
    }

    #! Track API event tracking: track-event, track-anonymous-event, track-page-view
    integrationTrackEventTests() {
        checkJson();
        checkCredentials();

        CustomerIoDataProvider::CustomerIoDataProvider provider = createIntegrationProvider();

        # Create a temporary customer for event tracking
        string cust_id = sprintf("qore-evt-test-%s", testSuffix);
        testCustomerId = cust_id;

        {
            AbstractDataProvider dp = provider.getChildProvider("create-update-customer");
            dp.doRequest({
                "customer_id": cust_id,
                "email": sprintf("%s@test.example.com", cust_id),
            });
        }

        # track-event
        {
            AbstractDataProvider dp = provider.getChildProvider("track-event");
            auto result = dp.doRequest({
                "customer_id": cust_id,
                "name": "qore_test_purchase",
                "data": {
                    "product": "Widget",
                    "price": 29.99,
                    "currency": "USD",
                },
            });
            assertTrue(True);
            if (m_options.verbose) {
                printf("track-event: OK\n");
            }
        }

        # track-page-view
        {
            AbstractDataProvider dp = provider.getChildProvider("track-page-view");
            auto result = dp.doRequest({
                "customer_id": cust_id,
                "url": "https://example.com/products/widget",
                "data": {
                    "referrer": "https://example.com/",
                },
            });
            assertTrue(True);
            if (m_options.verbose) {
                printf("track-page-view: OK\n");
            }
        }

        # track-anonymous-event
        {
            AbstractDataProvider dp = provider.getChildProvider("track-anonymous-event");
            auto result = dp.doRequest({
                "name": "qore_anonymous_test",
                "data": {
                    "page": "/landing",
                    "test": True,
                },
            });
            assertTrue(True);
            if (m_options.verbose) {
                printf("track-anonymous-event: OK\n");
            }
        }

        # Cleanup customer
        {
            AbstractDataProvider dp = provider.getChildProvider("delete-customer");
            dp.doRequest({"customer_id": cust_id});
            remove testCustomerId;
        }
    }

