%modern

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/DataProvider
%requires ../../../../qlib/ConnectionProvider
%requires ../../../../qlib/RestClient.qm
%requires ../../../../qlib/Mime.qm

%try-module json
%define NoJson
%endtry

%requires ../../../../qlib/CustomerIoRestClient.qm
%requires ../../../../qlib/CustomerIoDataProvider

%exec-class CustomerIoDataProviderTest

public class CustomerIoDataProviderTest inherits QUnit::Test {
    private {
        #! Customer.io REST client for integration tests
        *CustomerIoRestClient::CustomerIoRestClient client;

        #! Logger for verbose output
        Logger logger;

        #! Custom command-line options
        const MyOpts = Opts + {
            "appapikey": "a,app-api-key=s",
            "siteid": "s,site-id=s",
            "trackingapikey": "t,tracking-api-key=s",
            "region": "r,region=s",
        };

        #! Test customer ID created during tests (for cleanup)
        *string testCustomerId;

        #! Test snippet name created during tests (for cleanup)
        *string testSnippetName;

        #! Test collection ID created during tests (for cleanup)
        *int testCollectionId;

        #! Test unique suffix for this test run
        string testSuffix;

        #! Stored credentials for provider construction
        *string storedAppApiKey;
        *string storedSiteId;
        *string storedTrackingApiKey;
        *string storedRegion;
    }

    constructor() : Test("CustomerIoDataProvider Test", "1.0", \ARGV, MyOpts) {
        logger = new Logger("test", LoggerLevel::getLevelInfo());
        testSuffix = sprintf("%d", clock_getmicros());

        # Unit tests (always run, no credentials needed)
        addTestCase("sanity tests", \sanityTests());
        addTestCase("factory tests", \factoryTests());
        addTestCase("metadata tests", \metadataTests());
        addTestCase("child provider tests", \childProviderTests());
        addTestCase("data type tests", \dataTypeTests());
        addTestCase("negative tests", \negativeTests());
        addTestCase("connection tests", \connectionTests());
        addTestCase("action catalog tests", \actionCatalogTests());

        # Integration tests (require credentials)
        addTestCase("integration: App API read actions", \integrationAppApiReadTests());
        addTestCase("integration: Track API customer lifecycle", \integrationTrackCustomerLifecycleTests());
        addTestCase("integration: Track API event tracking", \integrationTrackEventTests());
        addTestCase("integration: Track API device management", \integrationTrackDeviceTests());
        addTestCase("integration: Track API object lifecycle", \integrationTrackObjectTests());
        addTestCase("integration: App API snippet CRUD", \integrationSnippetCrudTests());
        # NOTE: collection CRUD test removed — requires premium Customer.io plan
        addTestCase("integration: cleanup", \integrationCleanup());

        # Try to set up connection for integration tests
        try {
            setupConnection();
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("Connection setup failed: %s: %s\n", ex.err, ex.desc);
            }
        }

        set_return_value(main());
    }

    #! Sets up the Customer.io client for integration tests
    private setupConnection() {
        *string app_api_key = m_options.appapikey ?? ENV.CUSTOMERIO_APP_API_KEY;
        *string site_id = m_options.siteid ?? ENV.CUSTOMERIO_SITE_ID;
        *string tracking_api_key = m_options.trackingapikey ?? ENV.CUSTOMERIO_TRACKING_API_KEY;
        *string region = m_options.region ?? ENV.CUSTOMERIO_REGION ?? "us";
        if (!app_api_key || !site_id || !tracking_api_key) {
            if (m_options.verbose) {
                printf("No API credentials provided (use -a/-s/-t options or CUSTOMERIO_APP_API_KEY/"
                    "CUSTOMERIO_SITE_ID/CUSTOMERIO_TRACKING_API_KEY env vars)\n");
            }
            return;
        }
        # Store credentials for provider construction
        storedAppApiKey = app_api_key;
        storedSiteId = site_id;
        storedTrackingApiKey = tracking_api_key;
        storedRegion = region;

        hash<auto> opts = {
            "app_api_key": app_api_key,
            "site_id": site_id,
            "tracking_api_key": tracking_api_key,
            "region": region,
        };
        client = new CustomerIoRestClient::CustomerIoRestClient(opts);
    }

    #! Creates a CustomerIoDataProvider with full credentials (including Track API)
    private CustomerIoDataProvider::CustomerIoDataProvider createIntegrationProvider() {
        return new CustomerIoDataProvider::CustomerIoDataProvider({
            "app_api_key": storedAppApiKey,
            "site_id": storedSiteId,
            "tracking_api_key": storedTrackingApiKey,
            "region": storedRegion,
        });
    }

    #! Check if json module is available
    private checkJson() {
%ifdef NoJson
        testSkip("no json module present");
%endif
    }

    #! Skip if no credentials
    private checkCredentials() {
        if (!client) {
            testSkip("no Customer.io credentials provided");
        }
    }

    #! Creates a CustomerIoDataProvider for unit tests
    private *CustomerIoDataProvider::CustomerIoDataProvider tryCreateProvider() {
        try {
            return new CustomerIoDataProvider::CustomerIoDataProvider({
                "app_api_key": "x",
                "site_id": "y",
                "tracking_api_key": "z",
            });
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "SOCKET-CONNECT-ERROR" || ex.err == "SOCKET-SSL-ERROR"
                    || ex.err == "QOREADDRINFO-GETINFO-ERROR") {
                testSkip(sprintf("cannot connect to Customer.io API: %s", ex.desc));
            }
            rethrow;
        }
    }

    # ========== UNIT TESTS ==========

    #! Basic sanity tests - provider instantiation
    sanityTests() {
        checkJson();
        *CustomerIoDataProvider::CustomerIoDataProvider provider = tryCreateProvider();
        if (!provider) {
            return;
        }

        assertEq("customerio", provider.getName());
        assertTrue(provider.getInfo().supports_children);
        assertTrue(provider.getInfo().children_can_support_apis);
        assertTrue(provider.getInfo().children_can_support_records);
        assertTrue(provider.getInfo().children_can_support_observers);
    }

    #! Factory tests
    factoryTests() {
        checkJson();

        AbstractDataProviderFactory factory = DataProvider::getFactory("customerio");
        assertEq("customerio", factory.getInfo().name);
        assertTrue(factory.getInfo().children_can_support_apis);
        assertTrue(factory.getInfo().children_can_support_records);

        # Verify factory constructor options
        hash<auto> factoryOpts = factory.getInfo().provider_info.constructor_options;
        assertTrue(factoryOpts.hasKey("app_api_key"));
        assertTrue(factoryOpts.hasKey("site_id"));
        assertTrue(factoryOpts.hasKey("tracking_api_key"));
        assertTrue(factoryOpts.hasKey("customeriorestclient"));
        assertTrue(factoryOpts.hasKey("customeriorestclient_options"));
        assertTrue(factoryOpts.hasKey("region"));
    }

    #! Metadata tests
    metadataTests() {
        checkJson();
        *CustomerIoDataProvider::CustomerIoDataProvider provider = tryCreateProvider();
        if (!provider) {
            return;
        }

        list<string> children = provider.getChildProviderNames();
        assertTrue(children.val());

        # Collection providers (DPAT_FIND)
        assertTrue(children.contains("people"));
        assertTrue(children.contains("segments"));
        assertTrue(children.contains("campaigns"));
        assertTrue(children.contains("broadcasts"));
        assertTrue(children.contains("collections"));
        assertTrue(children.contains("snippets"));
        assertTrue(children.contains("messages"));
        assertTrue(children.contains("activities"));
        assertTrue(children.contains("newsletters"));

        # App API action providers
        assertTrue(children.contains("get-person"));
        assertTrue(children.contains("get-segment"));
        assertTrue(children.contains("get-segment-people"));
        assertTrue(children.contains("get-campaign"));
        assertTrue(children.contains("get-campaign-metrics"));
        assertTrue(children.contains("get-campaign-actions"));
        assertTrue(children.contains("get-broadcast"));
        assertTrue(children.contains("trigger-broadcast"));
        assertTrue(children.contains("send-transactional-email"));
        assertTrue(children.contains("send-transactional-push"));
        assertTrue(children.contains("get-collection"));
        assertTrue(children.contains("create-collection"));
        assertTrue(children.contains("update-collection"));
        assertTrue(children.contains("delete-collection"));
        assertTrue(children.contains("get-snippet"));
        assertTrue(children.contains("create-snippet"));
        assertTrue(children.contains("update-snippet"));
        assertTrue(children.contains("delete-snippet"));
        assertTrue(children.contains("create-export"));
        assertTrue(children.contains("get-export-status"));
        assertTrue(children.contains("download-export"));
        assertTrue(children.contains("get-message"));
        assertTrue(children.contains("get-newsletter"));

        # Track API action providers
        assertTrue(children.contains("create-update-customer"));
        assertTrue(children.contains("delete-customer"));
        assertTrue(children.contains("suppress-customer"));
        assertTrue(children.contains("unsuppress-customer"));
        assertTrue(children.contains("merge-customers"));
        assertTrue(children.contains("track-event"));
        assertTrue(children.contains("track-anonymous-event"));
        assertTrue(children.contains("track-page-view"));
        assertTrue(children.contains("add-device"));
        assertTrue(children.contains("delete-device"));
        assertTrue(children.contains("create-update-object"));
        assertTrue(children.contains("delete-object"));
        assertTrue(children.contains("add-relationships"));
        assertTrue(children.contains("delete-relationships"));

        # Events container
        assertTrue(children.contains("events"));
    }

    #! Child provider tests
    childProviderTests() {
        checkJson();
        *CustomerIoDataProvider::CustomerIoDataProvider provider = tryCreateProvider();
        if (!provider) {
            return;
        }

        # Test DPAT_FIND providers have correct info
        AbstractDataProvider people = provider.getChildProvider("people");
        assertEq("people", people.getName());
        hash<DataProviderInfo> info = people.getInfo();
        assertTrue(info.supports_read);
        assertTrue(info.supports_native_search);
        assertTrue(info.has_record);
        assertTrue(info.search_options.val());

        # Test DPAT_API providers have correct info
        AbstractDataProvider getPerson = provider.getChildProvider("get-person");
        assertEq("get-person", getPerson.getName());
        assertTrue(getPerson.getInfo().supports_request);

        AbstractDataProvider createCustomer = provider.getChildProvider("create-update-customer");
        assertEq("create-update-customer", createCustomer.getName());
        assertTrue(createCustomer.getInfo().supports_request);

        # Test events container
        AbstractDataProvider events = provider.getChildProvider("events");
        assertEq("events", events.getName());
        assertTrue(events.getInfo().supports_children);
        assertTrue(events.getInfo().children_can_support_observers);

        # Verify all 21 event children
        list<string> eventChildren = events.getChildProviderNames();
        assertTrue(eventChildren.contains(CustomerIoDataProvider::EVENT_EMAIL_SENT));
        assertTrue(eventChildren.contains(CustomerIoDataProvider::EVENT_EMAIL_DELIVERED));
        assertTrue(eventChildren.contains(CustomerIoDataProvider::EVENT_EMAIL_OPENED));
        assertTrue(eventChildren.contains(CustomerIoDataProvider::EVENT_EMAIL_CLICKED));
        assertTrue(eventChildren.contains(CustomerIoDataProvider::EVENT_EMAIL_BOUNCED));
        assertTrue(eventChildren.contains(CustomerIoDataProvider::EVENT_EMAIL_DROPPED));
        assertTrue(eventChildren.contains(CustomerIoDataProvider::EVENT_EMAIL_SPAMMED));
        assertTrue(eventChildren.contains(CustomerIoDataProvider::EVENT_EMAIL_UNSUBSCRIBED));
        assertTrue(eventChildren.contains(CustomerIoDataProvider::EVENT_SMS_SENT));
        assertTrue(eventChildren.contains(CustomerIoDataProvider::EVENT_SMS_DELIVERED));
        assertTrue(eventChildren.contains(CustomerIoDataProvider::EVENT_SMS_FAILED));
        assertTrue(eventChildren.contains(CustomerIoDataProvider::EVENT_SMS_CLICKED));
        assertTrue(eventChildren.contains(CustomerIoDataProvider::EVENT_PUSH_SENT));
        assertTrue(eventChildren.contains(CustomerIoDataProvider::EVENT_PUSH_DELIVERED));
        assertTrue(eventChildren.contains(CustomerIoDataProvider::EVENT_PUSH_OPENED));
        assertTrue(eventChildren.contains(CustomerIoDataProvider::EVENT_PUSH_FAILED));
        assertTrue(eventChildren.contains(CustomerIoDataProvider::EVENT_SLACK_SENT));
        assertTrue(eventChildren.contains(CustomerIoDataProvider::EVENT_SLACK_CLICKED));
        assertTrue(eventChildren.contains(CustomerIoDataProvider::EVENT_SLACK_FAILED));
        assertTrue(eventChildren.contains(CustomerIoDataProvider::EVENT_SUBSCRIBED));
        assertTrue(eventChildren.contains(CustomerIoDataProvider::EVENT_UNSUBSCRIBED));
        assertEq(21, eventChildren.size());
    }

    #! Data type tests
    dataTypeTests() {
        checkJson();

        # Person
        CustomerIoDataProvider::CustomerIoPersonDataType personType();
        *hash<string, AbstractDataField> fields = personType.getFields();
        assertTrue(fields.hasKey("id"));
        assertTrue(fields.hasKey("email"));
        assertTrue(fields.hasKey("cio_id"));
        assertTrue(fields.hasKey("created_at"));
        assertTrue(fields.hasKey("attributes"));
        assertTrue(fields.hasKey("unsubscribed"));

        # Segment
        CustomerIoDataProvider::CustomerIoSegmentDataType segmentType();
        fields = segmentType.getFields();
        assertTrue(fields.hasKey("id"));
        assertTrue(fields.hasKey("name"));
        assertTrue(fields.hasKey("state"));

        # Campaign
        CustomerIoDataProvider::CustomerIoCampaignDataType campaignType();
        fields = campaignType.getFields();
        assertTrue(fields.hasKey("id"));
        assertTrue(fields.hasKey("name"));
        assertTrue(fields.hasKey("active"));
        assertTrue(fields.hasKey("state"));

        # Broadcast
        CustomerIoDataProvider::CustomerIoBroadcastDataType broadcastType();
        fields = broadcastType.getFields();
        assertTrue(fields.hasKey("id"));
        assertTrue(fields.hasKey("name"));

        # Collection
        CustomerIoDataProvider::CustomerIoCollectionDataType collectionType();
        fields = collectionType.getFields();
        assertTrue(fields.hasKey("id"));
        assertTrue(fields.hasKey("name"));
        assertTrue(fields.hasKey("data_type"));

        # Snippet
        CustomerIoDataProvider::CustomerIoSnippetDataType snippetType();
        fields = snippetType.getFields();
        assertTrue(fields.hasKey("name"));
        assertTrue(fields.hasKey("value"));

        # Message
        CustomerIoDataProvider::CustomerIoMessageDataType messageType();
        fields = messageType.getFields();
        assertTrue(fields.hasKey("id"));
        assertTrue(fields.hasKey("metric"));
        assertTrue(fields.hasKey("recipient"));

        # Activity
        CustomerIoDataProvider::CustomerIoActivityDataType activityType();
        fields = activityType.getFields();
        assertTrue(fields.hasKey("id"));
        assertTrue(fields.hasKey("type"));
        assertTrue(fields.hasKey("timestamp"));

        # Newsletter
        CustomerIoDataProvider::CustomerIoNewsletterDataType newsletterType();
        fields = newsletterType.getFields();
        assertTrue(fields.hasKey("id"));
        assertTrue(fields.hasKey("name"));

        # Object
        CustomerIoDataProvider::CustomerIoObjectDataType objectType();
        fields = objectType.getFields();
        assertTrue(fields.hasKey("object_type_id"));
        assertTrue(fields.hasKey("object_id"));
        assertTrue(fields.hasKey("attributes"));

        # Webhook event
        CustomerIoDataProvider::CustomerIoWebhookEventDataType eventType();
        fields = eventType.getFields();
        assertTrue(fields.hasKey("event_id"));
        assertTrue(fields.hasKey("metric"));
        assertTrue(fields.hasKey("customer_id"));
        assertTrue(fields.hasKey("email_address"));
        assertTrue(fields.hasKey("campaign_id"));
        assertTrue(fields.hasKey("delivery_id"));
        assertTrue(fields.hasKey("link_url"));
        assertTrue(fields.hasKey("bounce_type"));
        assertTrue(fields.hasKey("reason"));
    }

    #! Negative tests
    negativeTests() {
        checkJson();
        *CustomerIoDataProvider::CustomerIoDataProvider provider = tryCreateProvider();
        if (!provider) {
            return;
        }

        # Non-existent child
        assertThrows("INVALID-CHILD-PROVIDER", sub() {
            provider.getChildProviderEx("nonexistent");
        });

        # Non-existent event child
        AbstractDataProvider events = provider.getChildProvider("events");
        assertThrows("INVALID-CHILD-PROVIDER", sub() {
            events.getChildProviderEx("invalid-event-type");
        });

        # Invalid region
        assertThrows("CUSTOMERIO-ERROR", sub() {
            new CustomerIoRestClient::CustomerIoRestClient({"app_api_key": "x", "region": "invalid"});
        });
    }

    #! Connection tests
    connectionTests() {
        checkJson();

        hash<ConnectionSchemeInfo> scheme = ConnectionSchemeCache::getScheme("customerio");
        assertEq("Customer.io REST Connection", scheme.display_name);
        assertTrue(scheme.auto_url);
        assertEq("app_api_key,site_id,tracking_api_key", scheme.required_options);

        # Verify options
        assertTrue(scheme.options.hasKey("app_api_key"));
        assertTrue(scheme.options.hasKey("site_id"));
        assertTrue(scheme.options.hasKey("tracking_api_key"));
        assertTrue(scheme.options.hasKey("region"));
        assertTrue(scheme.options."app_api_key".sensitive);
        assertTrue(scheme.options."site_id".sensitive);
        assertTrue(scheme.options."tracking_api_key".sensitive);

        # Region allowed values
        assertTrue(scheme.options.region.allowed_values.val());
        assertEq(2, scheme.options.region.allowed_values.size());

        # Connection data provider support
        CustomerIoRestClient::CustomerIoRestConnection conn("test", "test connection",
            "customerio://api.customer.io", {},
            {"app_api_key": "x", "site_id": "y", "tracking_api_key": "z"});
        assertTrue(conn.hasDataProvider());
        assertEq("CustomerIo", conn.getAppName());
        assertEq("customerio", conn.getType());
    }

    #! Action catalog tests - verify all 67 actions registered
    actionCatalogTests() {
        checkJson();

        # Verify app registration
        *hash<auto> app = DataProviderActionCatalog::getApp(CustomerIoDataProvider::AppName);
        assertTrue(app.val());
        assertEq("Customer.io", app.display_name);
        assertEq("customerio", app.scheme);

        *list<hash<DataProviderActionInfo>> actions = DataProviderActionCatalog::getActions(
            CustomerIoDataProvider::AppName);
        assertTrue(actions.size() > 0);

        list<string> actionNames = map $1.action, actions;

        # DPAT_FIND actions (9)
        assertTrue(actionNames.contains("list-people"));
        assertTrue(actionNames.contains("list-segments"));
        assertTrue(actionNames.contains("list-campaigns"));
        assertTrue(actionNames.contains("list-broadcasts"));
        assertTrue(actionNames.contains("list-collections"));
        assertTrue(actionNames.contains("list-snippets"));
        assertTrue(actionNames.contains("list-deliveries"));
        assertTrue(actionNames.contains("list-activities"));
        assertTrue(actionNames.contains("list-newsletters"));

        # App API DPAT_API actions (23)
        assertTrue(actionNames.contains("get-person"));
        assertTrue(actionNames.contains("get-segment"));
        assertTrue(actionNames.contains("get-segment-people"));
        assertTrue(actionNames.contains("get-campaign"));
        assertTrue(actionNames.contains("get-campaign-metrics"));
        assertTrue(actionNames.contains("get-campaign-actions"));
        assertTrue(actionNames.contains("get-broadcast"));
        assertTrue(actionNames.contains("trigger-broadcast"));
        assertTrue(actionNames.contains("send-transactional-email"));
        assertTrue(actionNames.contains("send-transactional-push"));
        assertTrue(actionNames.contains("get-collection"));
        assertTrue(actionNames.contains("create-collection"));
        assertTrue(actionNames.contains("update-collection"));
        assertTrue(actionNames.contains("delete-collection"));
        assertTrue(actionNames.contains("get-snippet"));
        assertTrue(actionNames.contains("create-snippet"));
        assertTrue(actionNames.contains("update-snippet"));
        assertTrue(actionNames.contains("delete-snippet"));
        assertTrue(actionNames.contains("create-export"));
        assertTrue(actionNames.contains("get-export-status"));
        assertTrue(actionNames.contains("download-export"));
        assertTrue(actionNames.contains("get-message"));
        assertTrue(actionNames.contains("get-newsletter"));

        # Track API DPAT_API actions (14)
        assertTrue(actionNames.contains("create-update-customer"));
        assertTrue(actionNames.contains("delete-customer"));
        assertTrue(actionNames.contains("suppress-customer"));
        assertTrue(actionNames.contains("unsuppress-customer"));
        assertTrue(actionNames.contains("merge-customers"));
        assertTrue(actionNames.contains("track-event"));
        assertTrue(actionNames.contains("track-anonymous-event"));
        assertTrue(actionNames.contains("track-page-view"));
        assertTrue(actionNames.contains("add-device"));
        assertTrue(actionNames.contains("delete-device"));
        assertTrue(actionNames.contains("create-update-object"));
        assertTrue(actionNames.contains("delete-object"));
        assertTrue(actionNames.contains("add-relationships"));
        assertTrue(actionNames.contains("delete-relationships"));

        # DPAT_EVENT trigger actions (21)
        assertTrue(actionNames.contains("watch-email-sent") || actionNames.contains(CustomerIoDataProvider::EVENT_EMAIL_SENT));
        assertTrue(actionNames.contains("watch-email-delivered") || actionNames.contains(CustomerIoDataProvider::EVENT_EMAIL_DELIVERED));
        assertTrue(actionNames.contains("watch-sms-sent") || actionNames.contains(CustomerIoDataProvider::EVENT_SMS_SENT));
        assertTrue(actionNames.contains("watch-push-sent") || actionNames.contains(CustomerIoDataProvider::EVENT_PUSH_SENT));
        assertTrue(actionNames.contains("watch-slack-sent") || actionNames.contains(CustomerIoDataProvider::EVENT_SLACK_SENT));
        assertTrue(actionNames.contains("watch-subscribed") || actionNames.contains(CustomerIoDataProvider::EVENT_SUBSCRIBED));
        assertTrue(actionNames.contains("watch-unsubscribed") || actionNames.contains(CustomerIoDataProvider::EVENT_UNSUBSCRIBED));
    }

    # ========== INTEGRATION TESTS ==========

    #! App API read actions (list/get endpoints)
    integrationAppApiReadTests() {
        checkJson();
        checkCredentials();

        CustomerIoDataProvider::CustomerIoDataProvider provider = createIntegrationProvider();

        # list-activities
        {
            AbstractDataProvider dp = provider.getChildProvider("activities");
            AbstractDataProviderRecordIterator i = dp.searchRecords();
            # Verify iterator is valid and works (may return 0 records)
            int count = 0;
            while (i.next()) {
                ++count;
            }
            assertTrue(count >= 0);
            if (m_options.verbose) {
                printf("list-activities: OK (%d records)\n", count);
            }
        }

        # list-segments
        {
            AbstractDataProvider dp = provider.getChildProvider("segments");
            AbstractDataProviderRecordIterator i = dp.searchRecords();
