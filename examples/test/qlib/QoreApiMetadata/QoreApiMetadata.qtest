        addTestCase("ast: hashdecl extraction", \testAstHashdeclExtraction());
        addTestCase("ast: enum extraction", \testAstEnumExtraction());
        addTestCase("ast: namespace hierarchy", \testAstNamespaceHierarchy());
        addTestCase("ast: doc comments on members", \testAstDocComments());
        addTestCase("ast: multiple classes", \testAstMultipleClasses());
        addTestCase("ast: empty source", \testAstEmptySource());
        addTestCase("reflection: builtin class", \testReflectionBuiltinClass());
        addTestCase("reflection: builtin functions", \testReflectionBuiltinFunctions());
        addTestCase("reflection: namespace hierarchy", \testReflectionNamespaceHierarchy());
        addTestCase("reflection: method variants", \testReflectionMethodVariants());
        addTestCase("reflection: typed hashes", \testReflectionTypedHashes());
        addTestCase("reflection: no documentation", \testReflectionNoDocs());
