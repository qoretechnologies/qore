%modern

%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/QoreApiMetadata

%exec-class QoreApiMetadataTest

class QoreApiMetadataTest inherits QUnit::Test {
    constructor() : QUnit::Test("QoreApiMetadata", "1.0") {
        addTestCase("hashdecl defaults", \testHashdeclDefaults());
        addTestCase("doc comment: block comment basic", \testBlockCommentBasic());
        addTestCase("doc comment: line comment basic", \testLineCommentBasic());
        addTestCase("doc comment: hash comment basic", \testHashCommentBasic());
        addTestCase("doc comment: @param tag", \testParamTag());
        addTestCase("doc comment: @return/@returns/@retval", \testReturnTags());
        addTestCase("doc comment: @throw/@throws/@exception", \testThrowTags());
        addTestCase("doc comment: @since tag", \testSinceTag());
        addTestCase("doc comment: @see tag", \testSeeTag());
        addTestCase("doc comment: @deprecated tag", \testDeprecatedTag());
        addTestCase("doc comment: @note and @warning", \testNoteWarningTags());
        addTestCase("doc comment: @brief tag", \testBriefTag());
        addTestCase("doc comment: @code/@endcode blocks", \testCodeBlocks());
        addTestCase("doc comment: continuation lines", \testContinuationLines());
        addTestCase("doc comment: paragraph breaks", \testParagraphBreaks());
        addTestCase("doc comment: multiple params", \testMultipleParams());
        addTestCase("doc comment: mixed tags", \testMixedTags());
        addTestCase("doc comment: empty and whitespace", \testEmptyComments());
        addTestCase("doc comment: multiple throws", \testMultipleThrows());
