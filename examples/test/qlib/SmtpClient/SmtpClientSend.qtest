    private {
        Socket listener();
        int port;
        #! Collected protocol exchange for verification
        list<string> received_commands = ();
        #! The message body received via DATA
        *string received_body;
        #! Signals server thread completion
        Counter done(1);
        #! Error from server thread
        *string server_error;
        #! Whether to require AUTH
        bool require_auth;
        #! SASL mechanisms advertised in the EHLO reply
        string auth_mechanisms = "PLAIN LOGIN";
        #! If True, reject bearer auth with a 334 challenge followed by 535
        bool reject_bearer = False;
        #! Number of EHLO commands received
        int ehlo_count = 0;
        #! The base64 payload of the last bearer AUTH command received
        *string bearer_payload;
        #! The mechanism of the last bearer AUTH command received
        *string bearer_mechanism;
        #! If True, advertise STARTTLS and upgrade the connection when asked
        bool offer_starttls = False;
        #! If True, only advertise the SASL mechanisms once the connection is secure
        bool auth_after_tls = False;
        #! True once the connection has been upgraded to TLS
        bool secure = False;
    }

    constructor(bool require_auth = True) {
        self.require_auth = require_auth;
        listener.bind("localhost:0");
        listener.listen(1);
        port = listener.getSocketInfo().port;
    }

    #! Sets the SASL mechanism list advertised in the EHLO reply
    setAuthMechanisms(string mechanisms) {
        auth_mechanisms = mechanisms;
    }

    #! Makes bearer authentication fail the way real servers do (334 challenge, then 535)
    setRejectBearer(bool reject = True) {
        reject_bearer = reject;
    }

    #! Advertises STARTTLS and upgrades the connection when the client asks
    /** @param auth_after_tls if True, advertise the SASL mechanisms only on the secure connection, as
        most real servers do; this is what makes the RFC 3207 §4.2 re-EHLO observable
    */
    setStartTls(bool offer, bool auth_after_tls = False) {
        offer_starttls = offer;
        self.auth_after_tls = auth_after_tls;
    }

    bool isSecure() {
        return secure;
    }

    int getEhloCount() {
        return ehlo_count;
    }

    *string getBearerPayload() {
        return bearer_payload;
    }

    *string getBearerMechanism() {
        return bearer_mechanism;
    }

    #! Returns the decoded SASL payload of the last bearer AUTH command
    *string getDecodedBearerPayload() {
        if (!bearer_payload.val()) {
            return;
        }
        return parse_base64_string_to_string(bearer_payload);
    }

    int getPort() {
        return port;
    }

    #! Start the mock server in a background thread
    start() {
        background acceptAndServe();
    }

    #! Wait for the server thread to finish
    wait(timeout to = 30s) {
        done.waitForZero(to);
    }

    list<string> getReceivedCommands() {
        return received_commands;
    }

    *string getReceivedBody() {
        return received_body;
    }

    *string getServerError() {
        return server_error;
    }

    private acceptAndServe() {
        on_exit done.dec();
        try {
            Socket client = listener.accept(15s);
            serveClient(client);
        } catch (hash<ExceptionInfo> ex) {
            server_error = sprintf("%s: %s", ex.err, ex.desc);
        }
    }

    #! Read a line from the socket (up to \n)
    private string readLine(Socket client, timeout to = 10s) {
        string str = "";
        while (True) {
            int c = client.recvu1(to);
            str += chr(c);
            if (c == 10) {  # \n
                break;
            }
        }
        return str;
    }

    private serveClient(Socket client) {
        # Send greeting
        client.send("220 mock.smtp.test ESMTP MockServer\r\n");

        while (True) {
            string line = readLine(client);
            trim line;
            received_commands += line;

            if (line =~ /^EHLO /i) {
                ++ehlo_count;
                client.send("250-mock.smtp.test Hello\r\n");
                if (offer_starttls && !secure) {
                    client.send("250-STARTTLS\r\n");
                }
                # real servers commonly withhold their SASL mechanisms until the connection is
                # secure, which is precisely why RFC 3207 requires the client to re-issue EHLO
                if (!auth_after_tls || secure) {
                    client.send(sprintf("250-AUTH %s\r\n", auth_mechanisms));
                }
                client.send("250 OK\r\n");
            } else if (line =~ /^HELO /i) {
                client.send("250 mock.smtp.test Hello\r\n");
            } else if (line =~ /^STARTTLS$/i) {
                client.send("220 2.0.0 Ready to start TLS\r\n");
                client.setCertificate(CertPem);
                client.setPrivateKey(KeyPem);
                client.upgradeServerToSSL(15s);
                secure = True;
            } else if (line =~ /^AUTH (XOAUTH2|OAUTHBEARER) /i) {
                (bearer_mechanism, bearer_payload) = (line =~ x/^AUTH (\S+) (\S+)$/i);
                if (reject_bearer) {
                    # real servers answer a failed bearer login with a 334 challenge carrying a
                    # base64 JSON error, and only report the failure after the client sends CRLF
                    client.send("334 eyJzdGF0dXMiOiI0MDEiLCJzY2hlbWVzIjoiQmVhcmVyIn0=\r\n");
                    string empty = readLine(client);
                    received_commands += sprintf("<challenge-response:%d bytes>", empty.size());
                    client.send("535 5.7.8 Username and Password not accepted\r\n");
                } else if (require_auth) {
                    client.send("235 2.7.0 Authentication successful\r\n");
                } else {
                    client.send("503 5.5.1 Error: authentication not enabled\r\n");
                }
            } else if (line =~ /^AUTH PLAIN/i) {
                if (require_auth) {
                    client.send("235 2.7.0 Authentication successful\r\n");
                } else {
                    client.send("503 5.5.1 Error: authentication not enabled\r\n");
                }
            } else if (line =~ /^MAIL FROM:/i) {
                client.send("250 2.1.0 OK\r\n");
            } else if (line =~ /^RCPT TO:/i) {
                client.send("250 2.1.5 OK\r\n");
            } else if (line =~ /^DATA$/i) {
                client.send("354 End data with <CR><LF>.<CR><LF>\r\n");
                # Read message body until lone dot
                string body = "";
                while (True) {
                    string bline = readLine(client);
                    if (bline == ".\r\n") {
                        break;
                    }
                    # Dot-unstuffing
                    if (bline =~ /^\.\./) {
                        bline = bline.substr(1);
                    }
                    body += bline;
                }
                received_body = body;
                client.send("250 2.0.0 OK id=test-msg-001\r\n");
            } else if (line =~ /^QUIT$/i) {
                client.send("221 2.0.0 Bye\r\n");
                break;
            } else {
                client.send(sprintf("500 5.5.2 Error: command not recognized: %s\r\n", line));
            }
        }
    }
}

public class SmtpClientSendTest inherits QUnit::Test {
    constructor() : Test("SmtpClientSendTest", "1.0", \ARGV) {
        addTestCase("basic send with auth", \testBasicSendWithAuth());
        addTestCase("blocking sendMessage with auth", \testBlockingSendMessageWithAuth());
        addTestCase("blocking connect then sendMessage", \testBlockingConnectThenSendMessage());
        addTestCase("send with multiple recipients", \testMultipleRecipients());
        addTestCase("send poll operation API", \testSendPollOperationApi());
        addTestCase("send with no recipients error", \testNoRecipientsError());
        addTestCase("XOAUTH2 send", \testXoauth2Send());
        addTestCase("OAUTHBEARER selection and send", \testOauthBearerSend());
        addTestCase("forced auth mechanism", \testForcedAuthMechanism());
        addTestCase("bearer auth failure handling", \testBearerAuthFailure());
        addTestCase("auth credential validation", \testAuthCredentialValidation());
        addTestCase("token refresh on an existing client", \testTokenRefresh());
        addTestCase("connection token option", \testConnectionTokenOption());
        addTestCase("re-EHLO after STARTTLS", \testReEhloAfterStartTls());
        set_return_value(main());
    }

    #! Builds a bearer-token client against the mock server
    private SmtpClient makeTokenClient(MockSmtpServer server, string token = "test-token",
            *string mechanism) {
        hash<auto> opts = {
            "username": "testuser@test.com",
            "token": token,
        };
        if (mechanism.val()) {
            opts.auth_mechanism = mechanism;
        }
        return new SmtpClient(sprintf("esmtp://localhost:%d", server.getPort()), opts);
    }

    private MailMessage::Message makeMessage() {
        MailMessage::Message msg("sender@test.com", "Test Subject");
        msg.addTO("recipient@test.com");
        msg.setBody("Hello, World!");
        return msg;
    }

    #! A server advertising XOAUTH2 must receive a correctly-framed SASL XOAUTH2 command
    testXoauth2Send() {
        MockSmtpServer server(True);
        server.setAuthMechanisms("PLAIN LOGIN XOAUTH2");
        server.start();
        on_exit server.wait();

        SmtpClient smtp = makeTokenClient(server);
        SmtpSendPollOperation op(smtp, makeMessage());
        runPollOp(op);

        assertTrue(op.goalReached(), "goal reached");
        assertEq("XOAUTH2", server.getBearerMechanism(), "XOAUTH2 selected from the capability list");

        # RFC-defined payload: user=<user>^Aauth=Bearer <token>^A^A
        string decoded = server.getDecodedBearerPayload();
        assertEq(sprintf("user=testuser@test.com%sauth=Bearer test-token%s%s", chr(1), chr(1), chr(1)),
            decoded, "XOAUTH2 payload framed correctly");
        assertNothing(server.getServerError(), "no server errors");

        # no AUTH PLAIN must be sent when a token is configured
        foreach string cmd in (server.getReceivedCommands()) {
            assertNRegex("^(?i)AUTH PLAIN", cmd, "no AUTH PLAIN sent for a token login");
        }
    }

    #! A server advertising only OAUTHBEARER must receive a SASL OAUTHBEARER command
    testOauthBearerSend() {
        MockSmtpServer server(True);
        server.setAuthMechanisms("PLAIN OAUTHBEARER");
        server.start();
        on_exit server.wait();

        SmtpClient smtp = makeTokenClient(server);
        SmtpSendPollOperation op(smtp, makeMessage());
        runPollOp(op);

        assertTrue(op.goalReached(), "goal reached");
        assertEq("OAUTHBEARER", server.getBearerMechanism(),
            "OAUTHBEARER selected when XOAUTH2 is not advertised");

        # RFC 7628: n,a=<user>,^Ahost=<host>^Aport=<port>^Aauth=Bearer <token>^A^A
        string decoded = server.getDecodedBearerPayload();
        assertRegex("^n,a=testuser@test\\.com,", decoded, "GS2 header present");
        assertRegex("host=localhost", decoded, "host channel binding present");
        assertRegex(sprintf("port=%d", server.getPort()), decoded, "port channel binding present");
        assertRegex("auth=Bearer test-token", decoded, "bearer token present");
        assertNothing(server.getServerError(), "no server errors");
    }

    #! Forcing a mechanism must override what the server advertises
    testForcedAuthMechanism() {
        # the server advertises XOAUTH2 only, but OAUTHBEARER is forced
        MockSmtpServer server(True);
        server.setAuthMechanisms("PLAIN XOAUTH2");
        server.start();
        on_exit server.wait();

        SmtpClient smtp = makeTokenClient(server, "test-token", "OAUTHBEARER");
        assertEq("OAUTHBEARER", smtp.getAuthMechanism(), "mechanism recorded on the client");
        SmtpSendPollOperation op(smtp, makeMessage());
        runPollOp(op);

        assertEq("OAUTHBEARER", server.getBearerMechanism(),
            "forced mechanism overrides the advertised list");
        assertNothing(server.getServerError(), "no server errors");
    }

    #! A 334 challenge must be answered with an empty line so the real error surfaces
    testBearerAuthFailure() {
        MockSmtpServer server(True);
        server.setAuthMechanisms("PLAIN XOAUTH2");
        server.setRejectBearer(True);
        server.start();
        on_exit server.wait();

        SmtpClient smtp = makeTokenClient(server, "expired-token");
        SmtpSendPollOperation op(smtp, makeMessage());

        # the 334 challenge is not an error code, so without explicit handling this would be
        # mistaken for success; the real 535 must surface instead
        assertThrows("SMTP-SEND-ERROR", "535",
            sub () { runPollOp(op); }, NOTHING,
            "bearer failure surfaces the server's 535, not the 334 challenge");

        # the client must have answered the challenge with a bare CRLF
        bool answered = False;
        foreach string cmd in (server.getReceivedCommands()) {
            if (cmd =~ /^<challenge-response:/) {
                answered = True;
                assertEq("<challenge-response:2 bytes>", cmd,
                    "challenge answered with a bare CRLF");
            }
        }
        assertTrue(answered, "challenge response sent");
        assertNothing(server.getServerError(), "no server errors");
    }

    #! Conflicting or incomplete credentials must be rejected up front
    testAuthCredentialValidation() {
        string url = "esmtp://localhost:2525";

        assertThrows("SMTPCLIENT-INVALID-AUTHENTICATION", "both a password and a token",
            sub () {
                new SmtpClient(url, {"username": "u", "password": "p", "token": "t"});
            }, NOTHING, "password and token conflict rejected");

        assertThrows("SMTPCLIENT-INVALID-AUTHENTICATION", "without a username",
            sub () { new SmtpClient(url, {"token": "t"}); },
            NOTHING, "token without username rejected");

        assertThrows("SMTPCLIENT-INVALID-AUTHENTICATION", "already carries a username and password",
            sub () {
                new SmtpClient("esmtp://u:p@localhost:2525", {"token": "t"});
            }, NOTHING, "token plus URL credentials rejected");

        assertThrows("SMTPCLIENT-INVALID-AUTHENTICATION", "unknown auth_mechanism",
            sub () {
                new SmtpClient(url, {"username": "u", "token": "t", "auth_mechanism": "SCRAM-SHA-1"});
            }, NOTHING, "unknown mechanism rejected");

        assertThrows("SMTPCLIENT-INVALID-AUTHENTICATION", "requires an OAuth2 bearer token",
            sub () {
                SmtpClient sc(url, {"username": "u", "password": "p", "auth_mechanism": "XOAUTH2"});
                SmtpClient::getAuthInfo(sc.getInfo());
            }, NOTHING, "forced bearer mechanism without a token rejected");

        assertThrows("SMTPCLIENT-INVALID-AUTHENTICATION", "cannot be used with an OAuth2 bearer token",
            sub () {
                SmtpClient sc(url, {"username": "u", "token": "t", "auth_mechanism": "PLAIN"});
                SmtpClient::getAuthInfo(sc.getInfo());
            }, NOTHING, "forced PLAIN with a token rejected");

        # mechanism names are accepted case-insensitively
        SmtpClient sc(url, {"username": "u", "token": "t", "auth_mechanism": "xoauth2"});
        assertEq("XOAUTH2", sc.getAuthMechanism(), "mechanism name normalized to upper case");
        SmtpClient sc2(url, {"username": "u", "token": "t", "auth_mechanism": "AUTO"});
        assertEq("auto", sc2.getAuthMechanism(), "auto normalized to lower case");
    }

    #! Access tokens expire; a refreshed token must be used by the next operation
    testTokenRefresh() {
        MockSmtpServer server(True);
        server.setAuthMechanisms("PLAIN XOAUTH2");
        server.start();
        on_exit server.wait();

        SmtpClient smtp = makeTokenClient(server, "old-token");
        assertEq("old-token", smtp.getToken(), "initial token set");
        smtp.setToken("fresh-token");
        assertEq("fresh-token", smtp.getToken(), "token refreshed");

        SmtpSendPollOperation op(smtp, makeMessage());
        runPollOp(op);
        assertRegex("auth=Bearer fresh-token", server.getDecodedBearerPayload(),
            "refreshed token used on the wire");

        # setUserPass and setToken are mutually exclusive
        smtp.setUserPass("u", "p");
        assertNothing(smtp.getToken(), "setUserPass clears the token");
        assertThrows("SMTPCLIENT-INVALID-AUTHENTICATION", "without a username",
            sub () {
                SmtpClient bare("esmtp://localhost:2525", {});
                bare.setToken("t");
            }, NOTHING, "setToken without a username rejected");
    }

    #! The token connection option must reach the client
    testConnectionTokenOption() {
        SmtpConnection conn("test", "test", "esmtp://localhost:2525", {}, {
            "username": "user@test.com",
            "token": "conn-token",
            "auth_mechanism": "XOAUTH2",
        });
        SmtpClient client = conn.get(False);
        assertEq("conn-token", client.getToken(), "token option reached the client");
        assertEq("XOAUTH2", client.getAuthMechanism(), "auth_mechanism option reached the client");

        hash<auto> info = client.getInfo();
        assertEq("conn-token", info.token, "token exposed in getInfo()");
        hash<SmtpAuthInfo> ai = SmtpClient::getAuthInfo(info);
        assertTrue(ai.do_auth, "authentication configured");
        assertTrue(ai.use_bearer, "bearer mechanism selected");
        assertEq("XOAUTH2", ai.mechanism, "mechanism reported");

        # the scheme must advertise both new options
        hash<auto> scheme_opts = SmtpConnection::ConnectionScheme.options;
        assertTrue(scheme_opts.token.sensitive, "token option marked sensitive");
        assertTrue(exists scheme_opts.auth_mechanism, "auth_mechanism option present");
        assertEq(4, scheme_opts.auth_mechanism.allowed_values.size(), "all mechanisms listed");

        # combining a token with URL credentials must be reported, not silently dropped
        SmtpConnection conn2("test2", "test2", "esmtp://u:p@localhost:2525", {}, {
            "token": "conn-token",
        });
        assertThrows("SMTPCLIENT-INVALID-AUTHENTICATION", "already carries a username and password",
            sub () { conn2.get(False); }, NOTHING,
            "token plus URL credentials reported through the connection");
    }

    #! RFC 3207 §4.2: the pre-TLS capability list must be discarded and EHLO re-issued
    testReEhloAfterStartTls() {
        # the server advertises XOAUTH2 only on the secure connection, so a client that kept the
        # pre-TLS capability list would never see it and would fall back to the wrong mechanism
        MockSmtpServer server(True);
        server.setStartTls(True, True);
        server.setAuthMechanisms("PLAIN XOAUTH2");
        server.start();
        on_exit server.wait();

        SmtpClient smtp = makeTokenClient(server);
        SmtpSendPollOperation op(smtp, makeMessage());
        runPollOp(op);

        assertTrue(op.goalReached(), "send completed over the upgraded connection");
        assertTrue(server.isSecure(), "connection was upgraded to TLS");
        assertEq(2, server.getEhloCount(), "EHLO re-issued after STARTTLS");

        # the mechanism must come from the post-TLS capability list
        assertEq("XOAUTH2", server.getBearerMechanism(),
            "XOAUTH2 selected from the post-STARTTLS capability list");
        assertNothing(server.getServerError(), "no server errors");

        # STARTTLS must appear between the two EHLO commands
        list<string> cmds = server.getReceivedCommands();
        int first_ehlo = -1;
        int starttls = -1;
        int second_ehlo = -1;
        foreach string cmd in (cmds) {
            if (cmd =~ /^EHLO /i) {
                if (first_ehlo < 0) {
                    first_ehlo = $#;
                } else if (second_ehlo < 0) {
                    second_ehlo = $#;
                }
            } else if (cmd =~ /^STARTTLS$/i) {
                starttls = $#;
            }
        }
        assertTrue(first_ehlo >= 0, "first EHLO sent");
        assertTrue(starttls > first_ehlo, "STARTTLS sent after the first EHLO");
        assertTrue(second_ehlo > starttls, "second EHLO sent after STARTTLS");
    }

    #! Test basic SMTP send with a single recipient via SmtpSendPollOperation
    testBasicSendWithAuth() {
        MockSmtpServer server(True);
        server.start();
        on_exit server.wait();

        SmtpClient smtp(sprintf("esmtp://testuser:testpass@localhost:%d", server.getPort()));

        MailMessage::Message msg("sender@test.com", "Test Subject");
        msg.addTO("recipient@test.com");
        msg.setBody("Hello, World!");

        SmtpSendPollOperation op(smtp, msg);
        assertEq("send", op.getGoal(), "goal is 'send'");
        assertFalse(op.goalReached(), "goal not reached initially");

        # Submit to the global AsyncIoController and wait for completion
        runPollOp(op);

        assertTrue(op.goalReached(), "goal reached after pipeline completes");
        assertEq("complete", op.getState(), "state is 'complete' after success");

        # Verify the mock server received the expected commands
        list<string> cmds = server.getReceivedCommands();
        assertTrue(cmds.size() >= 5, "server received at least 5 commands");

        # Check command sequence
        bool has_auth = False;
        bool has_mail_from = False;
        bool has_rcpt_to = False;
        bool has_data = False;
        bool has_quit = False;
        foreach string cmd in (cmds) {
            if (cmd =~ /^AUTH PLAIN/i) {
                has_auth = True;
            } else if (cmd =~ /^MAIL FROM:.*sender@test\.com/i) {
                has_mail_from = True;
            } else if (cmd =~ /^RCPT TO:.*recipient@test\.com/i) {
                has_rcpt_to = True;
            } else if (cmd =~ /^DATA$/i) {
                has_data = True;
            } else if (cmd =~ /^QUIT$/i) {
                has_quit = True;
            }
        }
        assertTrue(has_auth, "AUTH PLAIN sent");
        assertTrue(has_mail_from, "MAIL FROM sent");
        assertTrue(has_rcpt_to, "RCPT TO sent");
        assertTrue(has_data, "DATA sent");
        assertTrue(has_quit, "QUIT sent");

        # Verify message body was received
        *string body = server.getReceivedBody();
        assertTrue(body.val(), "message body received");
        assertTrue(body =~ /Hello, World!/, "message body contains expected text");

        # Check no server errors
        assertNothing(server.getServerError(), "no server errors");
    }

    #! Test blocking SmtpClient::sendMessage via AsyncIoController-backed poll operation
    testBlockingSendMessageWithAuth() {
        MockSmtpServer server(True);
        server.start();
        on_exit server.wait();

        SmtpClient smtp(sprintf("esmtp://testuser:testpass@localhost:%d", server.getPort()));

        MailMessage::Message msg("sender@test.com", "Blocking Test");
        msg.addTO("recipient@test.com");
        msg.setBody("Hello from blocking sendMessage");

        hash<auto> reply = smtp.sendMessage(msg);
        assertEq(250, reply.EHLO.code, "EHLO reply returned");
        assertEq(250, reply.RCPT{"recipient@test.com"}.code, "RCPT reply returned");
        assertEq(250, reply.MSGID.code, "message acceptance reply returned");
        assertEq(221, reply.QUIT.code, "QUIT reply returned");

        list<string> cmds = server.getReceivedCommands();
        assertTrue(cmds.contains("DATA"), "DATA command sent");
        assertTrue(cmds.contains("QUIT"), "QUIT command sent");
        assertNothing(server.getServerError(), "no server errors");
    }

    #! Test blocking SmtpClient::connect via AsyncIoController-backed ping operation on the client's socket
    testBlockingConnectThenSendMessage() {
        MockSmtpServer server(True);
        server.start();
        on_exit server.wait();

        SmtpClient smtp(sprintf("esmtp://testuser:testpass@localhost:%d", server.getPort()));
        smtp.connect();
        assertTrue(smtp.isConnected(), "client connected");

        MailMessage::Message msg("sender@test.com", "Connected Send");
        msg.addTO("recipient@test.com");
        msg.setBody("Hello after explicit connect");

        hash<auto> reply = smtp.sendMessage(msg);
        assertEq(250, reply.EHLO.code, "EHLO reply preserved after connect");
        assertEq(250, reply.RCPT{"recipient@test.com"}.code, "RCPT reply returned");
        assertEq(221, reply.QUIT.code, "QUIT reply returned");

        list<string> cmds = server.getReceivedCommands();
        int auth_count = 0;
        foreach string cmd in (cmds) {
            if (cmd =~ /^AUTH PLAIN/i) {
                ++auth_count;
            }
        }
        assertEq(1, auth_count, "AUTH sent only during connect");
        assertTrue(cmds.contains("DATA"), "DATA command sent");
        assertTrue(cmds.contains("QUIT"), "QUIT command sent");
        assertNothing(server.getServerError(), "no server errors");
    }

    #! Test SMTP send with multiple To/CC/BCC recipients
    testMultipleRecipients() {
        MockSmtpServer server(True);
        server.start();
        on_exit server.wait();

        SmtpClient smtp(sprintf("esmtp://testuser:testpass@localhost:%d", server.getPort()));

        MailMessage::Message msg("sender@test.com", "Multi-recipient test");
        msg.addTO("to1@test.com");
        msg.addTO("to2@test.com");
        msg.addCC("cc1@test.com");
        msg.addBCC("bcc1@test.com");
        msg.setBody("Test body");

        SmtpSendPollOperation op(smtp, msg);
        runPollOp(op);

        assertTrue(op.goalReached(), "goal reached for multi-recipient send");

        # Verify all recipients got RCPT TO commands
        list<string> cmds = server.getReceivedCommands();
        int rcpt_count = 0;
        foreach string cmd in (cmds) {
            if (cmd =~ /^RCPT TO:/i) {
                ++rcpt_count;
            }
        }
        assertEq(4, rcpt_count, "4 RCPT TO commands sent (2 TO + 1 CC + 1 BCC)");

        assertNothing(server.getServerError(), "no server errors");
    }

    #! Test SmtpSendPollOperation API shape
    testSendPollOperationApi() {
        SmtpClient smtp("smtp://user:pass@localhost:9999");

        MailMessage::Message msg("sender@test.com", "API test");
        msg.addTO("recipient@test.com");
        msg.setBody("test");

        SmtpSendPollOperation op(smtp, msg);
        assertEq("send", op.getGoal(), "goal is 'send'");
        assertFalse(op.goalReached(), "not reached before execution");
        assertEq("SmtpSendPollOperation", op.className(), "class name correct");

        # Abort should be callable
        op.abort();
        assertTrue(True, "abort() callable");
    }

    #! Test that constructing with no recipients throws
    testNoRecipientsError() {
        SmtpClient smtp("smtp://user:pass@localhost:9999");

        MailMessage::Message msg("sender@test.com", "No recipients");
        msg.setBody("test");

        assertThrows("MESSAGE-ERROR", sub () {
            SmtpSendPollOperation op(smtp, msg);
        }, NOTHING, "no recipients throws MESSAGE-ERROR");
    }

    #! Execute a poll operation through the global AsyncIoController and block until done
    private runPollOp(Qore::AbstractPollOperation op, timeout to = 30s) {
        # First continuePoll gives us the socket for the submit info
        *hash<SocketPollInfo> pi = op.continuePoll();
        if (!pi) {
            # Pipeline completed synchronously (unlikely but possible)
            return;
        }

        hash<SocketPollResultInfo> result = AsyncIoController::exec(<SocketPollOperationInfo>{
            "sock": pi.socket,
            "spop": op,
            "owner": "smtp-send-test",
            "to": to,
        });
        if (result.ex) {
            throw result.ex.err, result.ex.desc;
        }
    }
}
