#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Logger
%requires Mime
%requires MailMessage
%requires DataProvider
%requires ConnectionProvider
%requires SmtpClient
%requires QUnit

%exec-class SmtpClientSendTest

#! Mock SMTP server that accepts a complete send sequence and records the exchange
