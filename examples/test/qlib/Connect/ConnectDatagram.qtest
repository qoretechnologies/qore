    Tests for Connect RPC datagram support (QUIC datagrams, RFC 9221/9297).

    Unit tests exercise framing, constants, content-type parsing, handler
    registration, reflection, and DataProvider integration.

    Integration tests exercise the full datagram flow through HttpServer
    with HTTP/3 (QUIC): fire-and-forget, bidirectional exchange, error
    handling, and HTTP/2 fallback rejection.
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"

%requires HttpServer
%requires Logger
%requires Mime
%requires yaml
%requires DataStreamUtil
%requires Connect
%requires ConnectDataProvider
%requires QUnit

%requires json

%requires HttpClientIo

%requires HttpServerAsyncIo

%exec-class ConnectDatagramTest

class ConnectDatagramTest inherits QUnit::Test {
    private {
        *Logger m_logger;
        *HttpServer m_http;
        int m_port;
        bool m_h3_available = False;

        # Fire-and-forget synchronization
        Counter m_ff_counter(1);
        *auto m_ff_msg;

        # Bidi handler error test
        Counter m_bidi_error_counter(1);
        bool m_bidi_error_handler_called = False;

