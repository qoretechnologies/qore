#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires HttpServer
%requires Connect
%requires yaml

%exec-class ConnectHandlerCredentialsTest

#! a hang guard only, never a timing assertion
const HangGuard = 20s;

#! The handler of a Connect method gets the request metadata without the credentials of the request when its code is
#! restricted (qore#7303)
/** Whether restricted code registered the method, or trusted code registered a handler of restricted code; a handler
    of trusted code gets the metadata as before.  The other request header fields are kept
*/
class ConnectHandlerCredentialsTest inherits QUnit::Test {
    public {
        #! the tenant's handler: returns what it saw in the metadata
        const TenantSource = "%modern
%requires Connect
code sub get_handler() {
    return auto sub (auto request, hash<auto> metadata) {
        return {\"auth\": exists metadata.authorization, \"cookie\": exists metadata.cookie,
            \"custom\": metadata.\"x-custom\"};
    };
}
nothing sub register(Connect::ConnectHandler handler) {
    handler.registerUnary(\"Svc\", \"Meta\", get_handler());
}
";
    }

    constructor() : QUnit::Test("Connect: the credentials of a request for the handler of a method", "1.0", \ARGV) {
        addTestCase("a method that restricted code registered", \restrictedRegistrantTest());
        addTestCase("a handler of restricted code that trusted code registered", \restrictedHandlerTest());
        addTestCase("a handler of trusted code", \trustedTest());
        set_return_value(main());
    }

    #! returns the tenant's Program, restricted by the default sandbox
    private Program getTenant() {
        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        p.setSandboxManager(new SandboxManager());
        p.parse(TenantSource, "tenant");
        return p;
    }

    #! calls the method of the handler with credentials; returns what the method's handler saw
    private hash<auto> call(Connect::ConnectHandler handler) {
        HttpServer server(<HttpServerOptionInfo>{});
        on_exit server.stop();
        server.setDefaultHandler("connect", handler);
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        server.waitForAsyncIo();
        Socket c();
        c.connect("127.0.0.1:" + port, HangGuard);
        on_exit c.close();
        string body = "{}";
        c.send(sprintf("POST /Svc/Meta HTTP/1.1\r\nHost: localhost\r\nContent-Type: application/yaml\r\n"
            "Content-Length: %d\r\nAuthorization: Bearer secret\r\nCookie: session=secret\r\nX-Custom: kept\r\n\r\n%s",
            body.size(), body));
        hash<auto> h = c.readHTTPHeader(HangGuard);
        assertEq(200, h.status_code, "the call is answered");
        return parse_yaml(c.recv(h."content-length".toInt(), HangGuard));
    }

    restrictedRegistrantTest() {
        Program p = getTenant();
        Connect::ConnectHandler handler();
        p.callFunction("register", handler);
        assertEq({"auth": False, "cookie": False, "custom": "kept"}, call(handler));
    }

    restrictedHandlerTest() {
        Program p = getTenant();
        Connect::ConnectHandler handler();
        handler.registerUnary("Svc", "Meta", p.callFunction("get_handler"));
        assertEq({"auth": False, "cookie": False, "custom": "kept"}, call(handler));
    }

    trustedTest() {
        Connect::ConnectHandler handler();
        handler.registerUnary("Svc", "Meta", auto sub (auto request, hash<auto> metadata) {
            return {"auth": exists metadata.authorization, "cookie": exists metadata.cookie,
                "custom": metadata."x-custom"};
        });
        assertEq({"auth": True, "cookie": True, "custom": "kept"}, call(handler));
    }
}
