    constructor() : Test("Connect streaming test", "1.0") {
%ifdef NoHttpClientIo
        printf("SKIP: HttpClientIo module not available\n");
        return;
%else
%ifdef NoHttpServerAsyncIo
        printf("SKIP: HttpServerAsyncIo module not available\n");
        return;
%else
        # HTTP/2 streaming tests
        addTestCase("H2 unary", \testH2Unary());
        addTestCase("H2 server-streaming", \testH2ServerStream());
        addTestCase("H2 client-streaming", \testH2ClientStream());
        addTestCase("H2 bidi-streaming", \testH2BidiStream());
        addTestCase("H2 server-streaming error", \testH2ServerStreamError());
        addTestCase("H2 empty server stream", \testH2EmptyServerStream());
        addTestCase("H2 large server stream", \testH2LargeServerStream());

        # HTTP/3 streaming tests
        addTestCase("H3 unary", \testH3Unary());
        addTestCase("H3 server-streaming", \testH3ServerStream());
        addTestCase("H3 client-streaming", \testH3ClientStream());
        addTestCase("H3 bidi-streaming", \testH3BidiStream());
        addTestCase("H3 server-streaming error", \testH3ServerStreamError());
        addTestCase("H3 empty server stream", \testH3EmptyServerStream());
        addTestCase("H3 large server stream", \testH3LargeServerStream());

        # Compression streaming tests
        addTestCase("H2 compressed server-streaming gzip", \testH2CompressedServerStreamGzip());
        addTestCase("H2 compressed server-streaming deflate",
            \testH2CompressedServerStreamDeflate());
        addTestCase("H2 compressed client-streaming", \testH2CompressedClientStream());
        addTestCase("H2 compressed bidi-streaming", \testH2CompressedBidiStream());
        addTestCase("H3 compressed server-streaming gzip", \testH3CompressedServerStreamGzip());
        addTestCase("H3 compressed client-streaming", \testH3CompressedClientStream());

        # Concurrent/stress streaming tests
        addTestCase("H2 concurrent server-streaming", \testH2ConcurrentServerStream());
        addTestCase("H2 concurrent mixed streaming", \testH2ConcurrentMixedStream());
        addTestCase("H3 concurrent server-streaming", \testH3ConcurrentServerStream());
        addTestCase("H3 concurrent mixed streaming", \testH3ConcurrentMixedStream());
        addTestCase("H2 stress server-streaming", \testH2StressServerStream());
        addTestCase("H3 stress server-streaming", \testH3StressServerStream());
%endif
%endif

        mLogger = new Logger("connect-streaming", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            mLogger.addAppender(new TestAppender());
        }

        createServer();
        on_exit {
            delete mServer;
        }

        set_return_value(main());
    }

    private createServer() {
        mServer = new HttpServer(<HttpServerOptionInfo>{
            "logger": mLogger,
            "debug": True,
            "quic_headers_only": True,
        });

        Connect::ConnectHandler handler();
        handler.setDebug(m_options.verbose > 2);

        # --- Unary: echo ---
        handler.registerUnary("Test", "Echo",
            auto sub (auto request, hash<auto> metadata) {
                return request;
            });

        # --- Server-streaming: sends N numbered messages ---
        handler.registerServerStream("Test", "Numbers",
            sub (auto request, Connect::ConnectServerStream stream, hash<auto> metadata) {
                int count = request.count ?? 5;
                for (int i = 0; i < count; ++i) {
                    stream.write({"index": i, "value": sprintf("msg-%d", i)});
                }
            });

        # --- Server-streaming: sends large messages ---
        handler.registerServerStream("Test", "LargeNumbers",
            sub (auto request, Connect::ConnectServerStream stream, hash<auto> metadata) {
                int count = request.count ?? 3;
                string big = strmul("X", 10000);
                for (int i = 0; i < count; ++i) {
                    stream.write({"index": i, "data": big});
                }
            });

        # --- Server-streaming: sends 0 messages (empty stream) ---
        handler.registerServerStream("Test", "Empty",
            sub (auto request, Connect::ConnectServerStream stream, hash<auto> metadata) {
                # No writes — just return
            });

        # --- Server-streaming: handler throws ---
        handler.registerServerStream("Test", "StreamError",
            sub (auto request, Connect::ConnectServerStream stream, hash<auto> metadata) {
                stream.write({"index": 0, "value": "before-error"});
                throw "HANDLER-ERROR", "deliberate test error";
            });

        # --- Client-streaming: aggregates all messages ---
        handler.registerClientStream("Test", "Aggregate",
            auto sub (Connect::ConnectServerStream stream, hash<auto> metadata) {
                list<string> items();
                while (*auto msg = stream.read()) {
                    items += msg.name;
                }
                return {"count": items.size(), "names": items};
            });

        # --- Bidi: echoes each message with a prefix ---
        handler.registerBidiStream("Test", "BidiEcho",
            sub (Connect::ConnectServerStream stream, hash<auto> metadata) {
                while (*auto msg = stream.read()) {
                    stream.write({"reply": "echo:" + msg.text});
                }
            });

        mServer.setHandler("connect", "", NOTHING, handler);
        mServer.setDefaultHandler("connect", handler);

        mServer.waitForAsyncIo();

        try {
            hash<auto> info = mServer.addListener(<HttpListenerOptionInfo>{
                "service": 0,
                "cert": new SSLCertificate(CertPem),
                "key": new SSLPrivateKey(KeyPem),
                "enable_h3": True,
            });
            mPort = info.port;
            mH3Available = True;
        } catch (hash<ExceptionInfo> ex) {
            # enable_h3 may fail if QUIC not compiled in; try without
            hash<auto> info = mServer.addListener(<HttpListenerOptionInfo>{
                "service": 0,
                "cert": new SSLCertificate(CertPem),
                "key": new SSLPrivateKey(KeyPem),
            });
            mPort = info.port;
        }

        mServer.waitForAsyncIo();
    }

    private HttpClientIo::HttpClientConnectionManager createMgr(string protocol) {
        return new HttpClientIo::HttpClientConnectionManager(
            <HttpClientIo::HttpClientConnectionManagerOptions>{
                "protocol": protocol,
                "accept_all_certs": True,
                "logger": mLogger,
                "request_timeout": 30s,
                "connect_timeout": 15s,
            },
        );
    }

    private string url() {
        return sprintf("https://127.0.0.1:%d", mPort);
    }

    # ---- Helpers: build streaming request body and parse streaming response ----

    #! Encode a single request as a streaming body (one data frame + end-of-stream)
    private binary frameRequest(auto request) {
        return Connect::ConnectHelper::frameMessage(mCodec.serialize(request));
    }

    #! Encode multiple messages as a streaming body (data frames only, no end-stream marker)
    private binary frameMessages(list<auto> messages) {
        binary body = binary();
        for (int i = 0; i < messages.size(); ++i) {
            body += Connect::ConnectHelper::frameMessage(mCodec.serialize(messages[i]));
        }
        return body;
    }

    #! Parse a streaming response into data messages and end-stream info
    /** @param body the raw response body
        @param encoding optional compression encoding for decompressing compressed frames
    */
    private hash<auto> parseStreamResponse(binary body, *string encoding) {
        list<hash<Connect::ConnectFrameInfo>> frames =
            Connect::ConnectHelper::unframeMessages(body);
        list<auto> messages();
        *hash<Connect::ConnectEndStreamInfo> end_info;
        for (int i = 0; i < frames.size(); ++i) {
            if (frames[i].flags & Connect::CONNECT_FLAG_END_STREAM) {
                end_info = Connect::ConnectHelper::parseEndStream(frames[i].data);
            } else {
                binary frame_data = frames[i].data;
                if ((frames[i].flags & Connect::CONNECT_FLAG_COMPRESSED) && encoding) {
                    frame_data = Connect::ConnectCompression::decompress(frame_data,
                        encoding);
                }
                messages += mCodec.deserialize(frame_data);
            }
        }
        return {
            "messages": messages,
            "end_info": end_info,
        };
    }

    private hash<auto> streamHeaders() {
        return Connect::ConnectHelper::buildStreamRequestHeaders("yaml");
    }

    private binary respBody(hash<auto> resp) {
        if (resp.body.typeCode() == NT_BINARY) {
            return resp.body;
        }
        return binary(resp.body);
    }

    # ---- HTTP/2 Tests ----

    testH2Unary() {
        Connect::ConnectClient client(url(), NOTHING,
            <Connect::ConnectClientOptions>{"protocol": "h2", "accept_all_certs": True});
        on_exit client.shutdown();

        auto response = client.call("Test", "Echo", {"message": "hello", "count": 42});
        assertEq("hello", response.message, "H2 unary echo: message");
        assertEq(42, response.count, "H2 unary echo: count");
    }

    testH2ServerStream() {
        HttpClientIo::HttpClientConnectionManager mgr = createMgr("h2");
        on_exit delete mgr;

        hash<auto> resp = mgr.request(url(), "POST", "/Test/Numbers",
            streamHeaders(), frameRequest({"count": 5}));
        assertEq(200, resp.status_code, "H2 server-stream: status");
        hash<auto> parsed = parseStreamResponse(respBody(resp));
        assertEq(5, parsed.messages.size(), "H2 server-stream: message count");
        for (int i = 0; i < 5; ++i) {
            assertEq(i, parsed.messages[i].index,
                sprintf("H2 server-stream: index %d", i));
            assertEq(sprintf("msg-%d", i), parsed.messages[i].value,
                sprintf("H2 server-stream: value %d", i));
        }
        assertTrue(exists parsed.end_info, "H2 server-stream: has end-stream");
        assertFalse(exists parsed.end_info.error, "H2 server-stream: no error");
    }

    testH2ClientStream() {
        HttpClientIo::HttpClientConnectionManager mgr = createMgr("h2");
        on_exit delete mgr;

        # Send 3 framed messages as the request body
        binary body = frameMessages((
            {"name": "alice"},
            {"name": "bob"},
            {"name": "charlie"},
        ));
        hash<auto> resp = mgr.request(url(), "POST", "/Test/Aggregate",
            streamHeaders(), body);
        assertEq(200, resp.status_code, "H2 client-stream: status");
        hash<auto> parsed = parseStreamResponse(respBody(resp));
        # Server sends one response frame + end-stream
        assertEq(1, parsed.messages.size(), "H2 client-stream: one response");
        assertEq(3, parsed.messages[0].count, "H2 client-stream: count");
        assertEq(("alice", "bob", "charlie"), parsed.messages[0].names,
            "H2 client-stream: names");
        assertFalse(exists parsed.end_info.error, "H2 client-stream: no error");
    }

    testH2BidiStream() {
        HttpClientIo::HttpClientConnectionManager mgr = createMgr("h2");
        on_exit delete mgr;

        binary body = frameMessages((
            {"text": "hello"},
            {"text": "world"},
            {"text": "test"},
        ));
        hash<auto> resp = mgr.request(url(), "POST", "/Test/BidiEcho",
            streamHeaders(), body);
        assertEq(200, resp.status_code, "H2 bidi: status");
        hash<auto> parsed = parseStreamResponse(respBody(resp));
        assertEq(3, parsed.messages.size(), "H2 bidi: reply count");
        assertEq("echo:hello", parsed.messages[0].reply, "H2 bidi: reply 0");
        assertEq("echo:world", parsed.messages[1].reply, "H2 bidi: reply 1");
        assertEq("echo:test", parsed.messages[2].reply, "H2 bidi: reply 2");
        assertFalse(exists parsed.end_info.error, "H2 bidi: no error");
    }

    testH2ServerStreamError() {
        HttpClientIo::HttpClientConnectionManager mgr = createMgr("h2");
        on_exit delete mgr;

        hash<auto> resp = mgr.request(url(), "POST", "/Test/StreamError",
            streamHeaders(), frameRequest({}));
        assertEq(200, resp.status_code, "H2 stream-error: status");
        hash<auto> parsed = parseStreamResponse(respBody(resp));
        assertEq(1, parsed.messages.size(), "H2 stream-error: one msg before error");
        assertEq("before-error", parsed.messages[0].value,
            "H2 stream-error: message value");
        assertTrue(exists parsed.end_info.error, "H2 stream-error: has error");
        assertEq(Connect::CONNECT_ERROR_INTERNAL, parsed.end_info.error.code,
            "H2 stream-error: error code");
        assertTrue(parsed.end_info.error.message.find("deliberate test error") >= 0,
            "H2 stream-error: error message");
    }

    testH2EmptyServerStream() {
        HttpClientIo::HttpClientConnectionManager mgr = createMgr("h2");
        on_exit delete mgr;

        hash<auto> resp = mgr.request(url(), "POST", "/Test/Empty",
            streamHeaders(), frameRequest({}));
        assertEq(200, resp.status_code, "H2 empty-stream: status");
        hash<auto> parsed = parseStreamResponse(respBody(resp));
        assertEq(0, parsed.messages.size(), "H2 empty-stream: zero messages");
        assertFalse(exists parsed.end_info.error, "H2 empty-stream: no error");
    }

    testH2LargeServerStream() {
        HttpClientIo::HttpClientConnectionManager mgr = createMgr("h2");
        on_exit delete mgr;

        hash<auto> resp = mgr.request(url(), "POST", "/Test/LargeNumbers",
            streamHeaders(), frameRequest({"count": 3}));
        assertEq(200, resp.status_code, "H2 large-stream: status");
        hash<auto> parsed = parseStreamResponse(respBody(resp));
        assertEq(3, parsed.messages.size(), "H2 large-stream: message count");
        for (int i = 0; i < 3; ++i) {
            assertEq(i, parsed.messages[i].index,
                sprintf("H2 large-stream: index %d", i));
            assertEq(10000, parsed.messages[i].data.size(),
                sprintf("H2 large-stream: data size %d", i));
        }
        assertFalse(exists parsed.end_info.error, "H2 large-stream: no error");
    }

    # ---- HTTP/3 Tests ----

    testH3Unary() {
        if (!mH3Available) {
            testSkip("HTTP/3 not available");
        }
        HttpClientIo::HttpClientConnectionManager mgr = createMgr("h3");
        on_exit delete mgr;

        hash<auto> resp = mgr.request(url(), "POST", "/Test/Echo",
            {"content-type": "application/yaml"}, mCodec.serialize({"message": "hello", "count": 42}));
        assertEq(200, resp.status_code, "H3 unary: status");
        auto response = mCodec.deserialize(binary(resp.body));
        assertEq("hello", response.message, "H3 unary echo: message");
        assertEq(42, response.count, "H3 unary echo: count");
    }

    testH3ServerStream() {
        if (!mH3Available) {
            testSkip("HTTP/3 not available");
        }
        HttpClientIo::HttpClientConnectionManager mgr = createMgr("h3");
        on_exit delete mgr;

        hash<auto> resp = mgr.request(url(), "POST", "/Test/Numbers",
            streamHeaders(), frameRequest({"count": 5}));
        assertEq(200, resp.status_code, "H3 server-stream: status");
        hash<auto> parsed = parseStreamResponse(respBody(resp));
        assertEq(5, parsed.messages.size(), "H3 server-stream: message count");
        for (int i = 0; i < 5; ++i) {
            assertEq(i, parsed.messages[i].index,
                sprintf("H3 server-stream: index %d", i));
            assertEq(sprintf("msg-%d", i), parsed.messages[i].value,
                sprintf("H3 server-stream: value %d", i));
        }
        assertTrue(exists parsed.end_info, "H3 server-stream: has end-stream");
        assertFalse(exists parsed.end_info.error, "H3 server-stream: no error");
    }

    testH3ClientStream() {
        if (!mH3Available) {
            testSkip("HTTP/3 not available");
        }
        HttpClientIo::HttpClientConnectionManager mgr = createMgr("h3");
        on_exit delete mgr;

        binary body = frameMessages((
            {"name": "alice"},
            {"name": "bob"},
            {"name": "charlie"},
        ));
        hash<auto> resp = mgr.request(url(), "POST", "/Test/Aggregate",
            streamHeaders(), body);
        assertEq(200, resp.status_code, "H3 client-stream: status");
        hash<auto> parsed = parseStreamResponse(respBody(resp));
        assertEq(1, parsed.messages.size(), "H3 client-stream: one response");
        assertEq(3, parsed.messages[0].count, "H3 client-stream: count");
        assertEq(("alice", "bob", "charlie"), parsed.messages[0].names,
            "H3 client-stream: names");
        assertFalse(exists parsed.end_info.error, "H3 client-stream: no error");
    }

    testH3BidiStream() {
        if (!mH3Available) {
            testSkip("HTTP/3 not available");
        }
        HttpClientIo::HttpClientConnectionManager mgr = createMgr("h3");
        on_exit delete mgr;

        binary body = frameMessages((
            {"text": "hello"},
            {"text": "world"},
            {"text": "test"},
        ));
        hash<auto> resp = mgr.request(url(), "POST", "/Test/BidiEcho",
            streamHeaders(), body);
        assertEq(200, resp.status_code, "H3 bidi: status");
        hash<auto> parsed = parseStreamResponse(respBody(resp));
        assertEq(3, parsed.messages.size(), "H3 bidi: reply count");
        assertEq("echo:hello", parsed.messages[0].reply, "H3 bidi: reply 0");
        assertEq("echo:world", parsed.messages[1].reply, "H3 bidi: reply 1");
        assertEq("echo:test", parsed.messages[2].reply, "H3 bidi: reply 2");
        assertFalse(exists parsed.end_info.error, "H3 bidi: no error");
    }

    testH3ServerStreamError() {
        if (!mH3Available) {
            testSkip("HTTP/3 not available");
        }
        HttpClientIo::HttpClientConnectionManager mgr = createMgr("h3");
        on_exit delete mgr;

        hash<auto> resp = mgr.request(url(), "POST", "/Test/StreamError",
            streamHeaders(), frameRequest({}));
        assertEq(200, resp.status_code, "H3 stream-error: status");
        hash<auto> parsed = parseStreamResponse(respBody(resp));
        assertEq(1, parsed.messages.size(), "H3 stream-error: one msg before error");
        assertEq("before-error", parsed.messages[0].value,
            "H3 stream-error: message value");
        assertTrue(exists parsed.end_info.error, "H3 stream-error: has error");
        assertEq(Connect::CONNECT_ERROR_INTERNAL, parsed.end_info.error.code,
            "H3 stream-error: error code");
        assertTrue(parsed.end_info.error.message.find("deliberate test error") >= 0,
            "H3 stream-error: error message");
    }

