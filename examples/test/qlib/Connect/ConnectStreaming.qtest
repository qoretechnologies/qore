    Tests for Connect RPC streaming over HTTP/2 and HTTP/3.

    Exercises the server-side response sending paths:
    - HTTP/2: sendHttp2StreamData() + flushHttp2()
    - HTTP/3: submitQuicStreamData() + waitForQuicStreamDrain()

    Uses raw HTTP requests (HttpClientConnectionManager.request()) so we
    don't depend on client-side streaming support.  This sends a complete
    request and receives the full response — the server-side streaming
    code (ConnectHandler + ConnectServerStream) is what's under test.
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"

%requires HttpServer
%requires HttpServerUtil
%requires Logger
%requires Mime
%requires yaml
%requires Connect
%requires QUnit

%requires HttpClientIo

%requires HttpServerAsyncIo

%exec-class ConnectStreamingTest

class ConnectStreamingTest inherits QUnit::Test {
    private {
        #! Maximum retries for transient QUIC connection errors in concurrent tests
        /** QUIC handshakes over UDP can stall on resource-constrained CI runners
            (K8s CPU throttling, UDP packet loss on loopback). Retrying avoids
            flaky failures while still catching real regressions.
        */
        const ConcurrentRetries = 2;

        *Logger mLogger;
        *HttpServer mServer;
        int mPort;
        bool mH3Available = False;
        Connect::YamlConnectCodec mCodec();

