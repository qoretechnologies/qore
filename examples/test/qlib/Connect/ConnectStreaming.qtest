    testH3LargeServerStream() {
        if (!mH3Available) {
            testSkip("HTTP/3 not available");
        }
        HttpClientIo::HttpClientConnectionManager mgr = createMgr("h3");
        on_exit delete mgr;

        hash<auto> resp = mgr.request(url(), "POST", "/Test/LargeNumbers",
