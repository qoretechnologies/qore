#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%allow-injection

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Logger
%requires DataProvider
%requires MewsRestClient
%requires SwaggerDataProvider
%requires MewsRestDataProvider

%exec-class MewsRestClientDataProviderTest

public class MewsRestClientDataProviderTest inherits QUnit::Test {
    private {
        MewsRestConnection mrc;
        MewsRestDataProvider mews;
        Logger logger;

        # command-line options
        const MyOpts = Opts + {
            "conn": "c,connection=s",
        };

        const OptionColumn = 22;

        #! Errors reported when an I/O wait on the external service times out
        /** The asynchronous REST path waits on a Future, so a demo service that stops answering
            surfaces as \c FUTURE-TIMEOUT rather than as a transport error that
            @ref QUnit::Test::isConnectionError() "isConnectionError()" recognizes.
        */
        const IoTimeoutErrors = {
            "FUTURE-TIMEOUT": True,
            "HTTPCLIENT-TIMEOUT": True,
            "SOCKET-TIMEOUT": True,
        };
    }

    constructor() : Test("MewsRestClientDataProvider Test", "1.0", \ARGV, MyOpts) {
        addTestCase("test", \mainTest());
        addTestCase("action", \actionTest());
        addTestCase("date range", \dateRangeTest());

        try {
            setupConnection();
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose > 2) {
                printf("%s\n", get_exception_string(ex));
            } else if (m_options.verbose) {
                printf("%s: %s\n", ex.err, ex.desc);
            }
        }

        # Return for compatibility with test harness that checks return value.
        set_return_value(main());
    }

    setUp() {
        Logger logger("test", m_options.verbose > 3 ? LoggerLevel::getLevelDebug() : LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }
        if (mews) {
            mews.setLogger(logger);
        }
    }

    mainTest() {
        if (!mews) {
            testSkip("no connection");
        }

        assertEq("mewsrest", mews.getName());

        AbstractDataProvider orderitems = mews.getChildProviderPath("tables/orderitems");
        assertEq("orderitems", orderitems.getName());

        # test retrieving a single order items
        hash<DataProviderExpression> where_cond = <DataProviderExpression>{
            "exp": DP_SEARCH_OP_GE,
            "args": (
                <DataProviderFieldReference>{"field": "ClosedUtc"},
                now() - 7D,
            ),
        };
        *hash<auto> rec;
        try {
            rec = orderitems.searchSingleRecord(where_cond, {"limit": 1});
            # rec may be NOTHING if no order items exist in the demo environment
            if (rec) {
                assertEq(Type::Hash, rec.type());
            }

            AbstractDataProviderBulkRecordInterface i = orderitems.searchRecordsBulk(1000, where_cond, {"limit": 1});
            *hash<auto> q = i.getValue();
            if (q) {
                assertEq(Type::List, q.firstValue().type());
                assertEq(1, q.firstValue().lsize());
            }
            assertNothing(i.getValue());
        } catch (hash<ExceptionInfo> ex) {
            # skips the test case if the external service is unavailable
            checkExternalError(ex);
            rethrow;
        }
    }

    actionTest() {
        if (!mews) {
            testSkip("no connection");
        }

        try {
            hash<DataProviderActionInfo> action = DataProviderActionCatalog::getAppAction("Mews", "get-order-items");
            AbstractDataProvider prov = mews.getChildProviderPath(action.path[1..]);
            assertEq("orderitems", prov.getName());

            *hash<auto> rec = prov.searchSingleRecord({"ClosedUtcStart": now() - 7D}, {"limit": 1});
            # rec may be NOTHING if no records exist in the demo environment
            if (rec) {
                assertEq(Type::Hash, rec.type());
            }

            action = DataProviderActionCatalog::getAppAction("Mews", "get-payments");
            prov = mews.getChildProviderPath(action.path[1..]);
            assertEq("payments", prov.getName());

            rec = prov.searchSingleRecord({"ClosedUtcStart": now() - 7D}, {"limit": 1});
            # rec may be NOTHING if no payments exist in the demo environment
            if (rec) {
                assertEq(Type::Hash, rec.type());
            }

            action = DataProviderActionCatalog::getAppAction("Mews", "get-customers");
            prov = mews.getChildProviderPath(action.path[1..]);
            assertEq("customers", prov.getName());

            *list<auto> recs = map $1, prov.searchRecords({"CreatedUtcStart": now() - 7D}, {
                "limit": 2,
            });
            # recs may be empty or have fewer than 2 records in demo environment
            # assertLe(bound, actual) asserts actual <= bound
            assertLe(2, recs.size());
        } catch (hash<ExceptionInfo> ex) {
            # skips the test case if the external service is unavailable
            checkExternalError(ex);
            rethrow;
        }
    }

    #! Verifies that an open-ended date range stays inside the Mews interval limit
    /** The %Mews API rejects intervals longer than a fixed 92 days
        (<tt>400 Bad Request: The interval must not exceed 3M1D</tt>).  When only one bound of a date range
        is given, @ref MewsRestDataProvider::MewsRestTableDataProvider "MewsRestTableDataProvider" fills in
        the other one with its maximum search delta, which must therefore be an absolute duration; a
        calendar-based delta (ex: \c 3M) is wall-clock preserving in %Qore, so it yields 92 days + 1 hour
        whenever the range crosses a DST fall-back transition, and the server rejects the request.

        The start date below carries its own DST-observing time zone, so a calendar-based delta would
        cross the 2025-10-26 transition and fail no matter which time zone the test is run in.
    */
    dateRangeTest() {
        if (!mews) {
            testSkip("no connection");
        }

        try {
            AbstractDataProvider orderitems = mews.getChildProviderPath("tables/orderitems");

            TimeZone tz("Europe/Prague");
            date start = tz.date("20250801090000");

            # the end bound is filled in automatically here and must produce the same result as an
            # explicit in-range end bound covering the same window
            *hash<auto> rec = orderitems.searchSingleRecord({"ClosedUtcStart": start}, {"limit": 1});
            *hash<auto> expected = orderitems.searchSingleRecord({
                "ClosedUtcStart": start,
                "ClosedUtcEnd": start + 2160h,
            }, {"limit": 1});
            assertEq(expected, rec);
        } catch (hash<ExceptionInfo> ex) {
            # skips the test case if the external service is unavailable
            checkExternalError(ex);
            rethrow;
        }
    }

    #! Skips the running test case if the exception indicates that the external service is unavailable
    /** Returns normally for any other error, in which case the caller must rethrow, so that genuine
        failures (ex: a malformed request rejected with \c 400 Bad Request) are always reported.

        @note this cannot rethrow itself; \c rethrow is only allowed directly in a catch block
    */
    private checkExternalError(hash<ExceptionInfo> ex) {
        if (QUnit::Test::isConnectionError(ex)) {
            delete mews;
            testSkip(sprintf("connection error: %s: %s", ex.err, ex.desc));
        }
        # an I/O wait that expires means the external service did not answer in time; this is an
        # availability failure of the dependency, not a defect in the code under test
        if (IoTimeoutErrors{ex.err}) {
            delete mews;
            testSkip(sprintf("external service I/O timeout: %s: %s", ex.err, ex.desc));
        }
        *softint status_code = getHttpStatusCode(ex);
        if (status_code == 429 || status_code == 408) {
            delete mews;
            testSkip("rate limited: HTTP " + status_code);
        }
        if (status_code && status_code >= 500) {
            delete mews;
            testSkip("external service unavailable: HTTP " + status_code);
        }
    }

    #! Extracts the HTTP status code from an exception, if available
    /** The status code may be present in the exception argument (when the original
        HTTP response hash is preserved) or only in the exception description; e.g.
        \c HTTP-CLIENT-RECEIVE-ERROR formats it as "HTTP status code <code> received",
        and the SwaggerDataProvider layer can replace the original response-hash
        argument with an empty info hash, leaving the description as the only signal.
    */
    private *softint getHttpStatusCode(hash<ExceptionInfo> ex) {
        *softint status_code = ex.arg.status_code ?? ex.arg."response-code"
            ?? ex.arg."response-headers".status_code;
        if (!status_code) {
            # matches both "HTTP status code 429 received" and "status_code: 429"
            status_code = (ex.desc =~ x/status[_ ]code:? ([0-9]+)/)[0];
        }
        if (!status_code) {
            # last-resort fallback: any bare 4xx/5xx code in the description
            status_code = (ex.desc =~ x/\b([45][0-9][0-9])\b/)[0];
        }
        return status_code;
    }

    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-c,--conn=ARG", "set Mews connection name", OptionColumn);
    }

    private error(string fmt) {
        throw "OPTION-ERROR", sprintf("%s: ERROR: %s", get_script_name(), vsprintf(fmt, argv));
    }

    private setupConnection() {
        *string conn_name = m_options.conn ?? ENV.MEWS_CONNECTION;
        try {
            if (conn_name.val()) {
                AbstractConnection conn = get_connection(conn_name);
                if (!(conn instanceof MewsRestConnection)) {
                    error("connection %y is type %y; expecting \"MewsRestConnection\"", conn_name, conn.className());
                }
                mrc = conn;
            } else {
                mrc = new MewsRestConnection({
                    "url": "https://api.mews-demo.com",
                    "name": "demo",
                    "desc": "Connection to demo environment",
                    "opts": {
                        "access_token": "C66EF7B239D24632943D115EDE9CB810-EA00F8FD8294692C940F6B5A8F9453D",
                        "client_token": "E0D439EE522F44368DC78E1BFB03710C-D24FB11DBE31D4621C4817E028D9E1D",
                    },
                });
            }

            mews = new MewsRestDataProvider(mrc.get());
        } catch (hash<ExceptionInfo> ex) {
            if (IoTimeoutErrors{ex.err}) {
                delete mews;
            }
            *softint status_code = getHttpStatusCode(ex);
            if (status_code == 429 || status_code == 408) {
                delete mews;
            }
            if (status_code && status_code >= 500) {
                delete mews;
            }
            rethrow;
        }
    }
}
