#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%allow-injection

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Logger
%requires ConnectionProvider
%requires DataProvider
%requires AwsTextractRestClient
%requires AwsTextractDataProvider

%exec-class AwsTextractDataProviderTest

class FakeAwsTextractClient inherits AwsTextractRestClient::AwsTextractRestClientIo {
    public {
        string last_path;
        *hash<auto> last_body;
        *hash<auto> last_headers;
        hash<auto> response;
    }
    constructor() : AwsTextractRestClient::AwsTextractRestClientIo(
            {"aws_region": "us-east-1",
             "aws_keyid": "AKIA", "aws_secret": "x"}) {
    }

    hash<RestClient::RestResponseInfo> restPost(string path, auto body, *hash<auto> hdr) {
        last_path = path;
        last_body = body;
        last_headers = hdr;
        return cast<hash<RestClient::RestResponseInfo>>(response);
    }
    string getSafeUrl() { return "https://textract.us-east-1.amazonaws.com"; }
}

public class AwsTextractDataProviderTest inherits QUnit::Test {
    public {
        const MyOpts = Opts + {
            "conn": "c,connection=s",
        };

        const OptionColumn = 22;

        const Actions = ("analyze-document", "analyze-expense", "analyze-id", "create-adapter",
            "create-adapter-version", "delete-adapter", "delete-adapter-version", "detect-document-text",
            "get-adapter", "get-adapter-version", "get-document-analysis", "get-document-text-detection",
            "get-expense-analysis", "get-lending-analysis", "get-lending-analysis-summary", "list-adapter-versions",
            "list-adapters", "list-tags-for-resource", "start-document-analysis", "start-document-text-detection",
            "start-expense-analysis", "start-lending-analysis", "tag-resource", "untag-resource", "update-adapter",
            "make-api-call");
    }

    private {
        *string conn_name;
    }

    constructor() : Test("AwsTextractDataProvider Test", "1.0", \ARGV, MyOpts) {
        conn_name = m_options.conn ?? ENV.AWS_TEXTRACT_CONNECTION;

        addTestCase("factory + app + exact complete inventory", \registrationTest());
        addTestCase("detect-document-text builds Document.Bytes from document_bytes",
            \detectBytesTest());
        addTestCase("detect-document-text builds Document.S3Object from s3_bucket + s3_name",
            \detectS3Test());
        addTestCase("detect-document-text sets X-Amz-Target header",
            \detectAmzTargetTest());
        addTestCase("analyze-document forwards feature_types into FeatureTypes",
            \analyzeFeatureTypesTest());
        addTestCase("analyze-document forwards queries when QUERIES requested",
            \analyzeQueriesTest());
        addTestCase("buildDocument raises when no source given",
            \noSourceTest());
        addTestCase("app declares Documents AppGroup",   \documentsAppGroupTest());

        # Opt-in: three synthetic single-page calls incur the account's normal AWS charges.
        if (conn_name || ENV.AWS_TEXTRACT_LIVE) {
            addTestCase("live: readable OCR, queries, and expense analysis",
                \liveTextractTest());
        }
        set_return_value(main());
    }

    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-c,--connection=ARG",
            "set the AWS Textract connection name; without it (and without "
            "the AWS_TEXTRACT_CONNECTION env var) the live test is skipped",
            OptionColumn);
    }

    private registrationTest() {
        DataProvider::AbstractDataProviderFactory f =
            DataProvider::DataProvider::getFactory("aws-textract");
        assertEq("aws-textract", f.getInfo().name);

        hash<DataProviderAppInfo> app =
            DataProvider::DataProviderActionCatalog::getApp("AwsTextract");
        assertEq("AwsTextract", app.name);
        assertEq("aws-textract", app.scheme);

        list<hash<DataProviderActionInfo>> actions = DataProviderActionCatalog::getActionsEx("AwsTextract");
        assertEq(sort(Actions), sort(map $1.action, actions));
        AwsTextractActions::registerNativeActions();
        assertEq(sort(Actions), sort(map $1.action, DataProviderActionCatalog::getActionsEx("AwsTextract")));
        assertEq((), DataProviderActionCatalog::getInitializationFailures(("AwsTextract",)));
        list<hash<DataProviderDiscoveryExpectedIdentityInfo>> expected =
            (<DataProviderDiscoveryExpectedIdentityInfo>{"app": "AwsTextract"},)
            + (map <DataProviderDiscoveryExpectedIdentityInfo>{"app": "AwsTextract", "action": $1}, Actions);
        DataProviderDiscoverySession session = DataProviderActionCatalog::beginDiscovery(expected, ("AwsTextract",));
        DataProviderActionCatalog::collectDiscoveryExpectedInventory(session);
        DataProviderQualifiedDiscovery qualified = DataProviderActionCatalog::sealDiscovery(session);
        assertTrue(qualified.getReport().complete);
        assertEq((), qualified.getReport().failures);
        DataProviderActionCatalog::discardQualifiedDiscovery(qualified);
        expected += <DataProviderDiscoveryExpectedIdentityInfo>{"app": "AwsTextract", "action": "missing-fixture"};
        session = DataProviderActionCatalog::beginDiscovery(expected, ("AwsTextract",));
        assertThrows("DATA-PROVIDER-DISCOVERY-ERROR", sub () { DataProviderActionCatalog::sealDiscovery(session); });
    }

    private detectBytesTest() {
        FakeAwsTextractClient fake();
        fake.response = <RestClient::RestResponseInfo>{
            "body": {"DocumentMetadata": {"Pages": 1}, "Blocks": ()},
        };
        AwsTextractDataProvider::AwsTextractDetectDocumentTextDataProvider prov(fake);
        prov.doRequest({"document_bytes": binary("FAKE-PNG")});
        assertEq("/", fake.last_path);
        assertEq(make_base64_string(binary("FAKE-PNG")), fake.last_body.Document.Bytes);
        # No S3Object set when bytes were supplied
        assertEq(NOTHING, fake.last_body.Document.S3Object);
    }

    private detectS3Test() {
        FakeAwsTextractClient fake();
        fake.response = <RestClient::RestResponseInfo>{
            "body": {"DocumentMetadata": {"Pages": 1}, "Blocks": ()},
        };
        AwsTextractDataProvider::AwsTextractDetectDocumentTextDataProvider prov(fake);
        prov.doRequest({
            "s3_bucket":  "my-bucket",
            "s3_name":    "docs/invoice.pdf",
            "s3_version": "v42",
        });
        assertEq("my-bucket",         fake.last_body.Document.S3Object.Bucket);
        assertEq("docs/invoice.pdf",  fake.last_body.Document.S3Object.Name);
        assertEq("v42",               fake.last_body.Document.S3Object.Version);
        # No Bytes set when S3 was supplied
        assertEq(NOTHING, fake.last_body.Document.Bytes);
    }

    private detectAmzTargetTest() {
        FakeAwsTextractClient fake();
        fake.response = <RestClient::RestResponseInfo>{
            "body": {"DocumentMetadata": {"Pages": 1}, "Blocks": ()},
        };
        AwsTextractDataProvider::AwsTextractDetectDocumentTextDataProvider prov(fake);
        prov.doRequest({"document_bytes": binary("x")});
        assertEq("Textract.DetectDocumentText", fake.last_headers."X-Amz-Target");
        assertEq("application/x-amz-json-1.1",  fake.last_headers."Content-Type");
    }

    private analyzeFeatureTypesTest() {
        FakeAwsTextractClient fake();
        fake.response = <RestClient::RestResponseInfo>{
            "body": {"DocumentMetadata": {"Pages": 1}, "Blocks": ()},
        };
        AwsTextractDataProvider::AwsTextractAnalyzeDocumentDataProvider prov(fake);
        prov.doRequest({
            "document_bytes": binary("x"),
            "feature_types":  ("TABLES", "FORMS"),
        });
        assertEq("Textract.AnalyzeDocument", fake.last_headers."X-Amz-Target");
        assertEq(("TABLES", "FORMS"), fake.last_body.FeatureTypes);
        # No QueriesConfig when queries weren't supplied
        assertEq(NOTHING, fake.last_body.QueriesConfig);
    }

    private analyzeQueriesTest() {
        FakeAwsTextractClient fake();
        fake.response = <RestClient::RestResponseInfo>{
            "body": {"DocumentMetadata": {"Pages": 1}, "Blocks": ()},
        };
        AwsTextractDataProvider::AwsTextractAnalyzeDocumentDataProvider prov(fake);
        prov.doRequest({
            "document_bytes": binary("x"),
            "feature_types":  ("QUERIES",),
            "queries":        ({"Text": "What is the invoice total?",
                                "Alias": "total"},),
        });
        assertEq(("QUERIES",), fake.last_body.FeatureTypes);
        assertEq("What is the invoice total?",
            fake.last_body.QueriesConfig.Queries[0].Text);
        assertEq("total", fake.last_body.QueriesConfig.Queries[0].Alias);
    }

    private noSourceTest() {
        FakeAwsTextractClient fake();
        AwsTextractDataProvider::AwsTextractDetectDocumentTextDataProvider prov(fake);
        assertThrows("AWS-TEXTRACT-CONFIG-ERROR", sub () {
            prov.doRequest({});
        });
    }

    private documentsAppGroupTest() {
        hash<DataProviderAppInfo> app =
            DataProvider::DataProviderActionCatalog::getApp("AwsTextract");
        assertTrue(inlist(DataProvider::AppGroup::AiLlm,     app.groups));
        assertTrue(inlist(DataProvider::AppGroup::Documents, app.groups));
    }

    #! Exercises Textract's live `DetectDocumentText` action via SigV4
    /** Verifies the wire format and actual text in an original synthetic invoice. */
    private liveTextractTest() {
        AbstractDataProvider prov;
        if (conn_name) {
            AbstractConnection conn = get_connection(conn_name);
            assertTrue(conn.ping(True).ok);
            prov = conn.getDataProvider();
        } else {
            prov = new AwsTextractDataProvider::AwsTextractDataProvider({});
        }
        binary document = File::readBinaryFile(get_script_dir() + "/synthetic-invoice.pdf");
        hash<auto> result = prov.getChildProvider("detect-document-text").doRequest({"document_bytes": document});
        string text = (map $1.Text ?? "", result.Blocks).join(" ");
        assertTrue(index(text, "QORE TEXTRACT TEST INVOICE") >= 0);
        assertTrue(index(text, "12.34") >= 0);
        assertEq(1, result.DocumentMetadata.Pages);
        result = prov.getChildProvider("analyze-document").doRequest({
            "document_bytes": document, "feature_types": ("QUERIES",),
            "queries": ({"Text": "What is the total?", "Alias": "total"},),
        });
        list<hash<auto>> answers = select result.Blocks, $1.BlockType == "QUERY_RESULT";
        assertTrue(answers.size() > 0);
        assertTrue(index((map $1.Text ?? "", answers).join(" "), "12.34") >= 0);
        result = prov.getChildProvider("analyze-expense").doRequest({"Document": {"Bytes": document}});
        assertEq(1, result.ExpenseDocuments.size());
        list<hash<auto>> totals = select result.ExpenseDocuments[0].SummaryFields, $1.Type.Text == "TOTAL";
        assertTrue(totals.size() > 0);
        assertTrue(index(totals[0].ValueDetection.Text, "12.34") >= 0);
    }
}
