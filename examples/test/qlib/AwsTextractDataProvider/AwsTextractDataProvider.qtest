#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%allow-injection

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/ConnectionProvider
%requires ../../../../qlib/DataProvider
%requires ../../../../qlib/AwsTextractRestClient.qm
%requires ../../../../qlib/AwsTextractDataProvider

%exec-class AwsTextractDataProviderTest

class FakeAwsTextractClient inherits AwsTextractRestClient::AwsTextractRestClientIo {
    public {
        string last_path;
        *hash<auto> last_body;
        *hash<auto> last_headers;
        hash<auto> response;
    }
    constructor() : AwsTextractRestClient::AwsTextractRestClientIo(
            {"aws_region": "us-east-1",
             "aws_keyid": "AKIA", "aws_secret": "x"}) {
    }

    hash<RestClient::RestResponseInfo> restPost(string path, auto body, *hash<auto> hdr) {
        last_path = path;
        last_body = body;
        last_headers = hdr;
        return cast<hash<RestClient::RestResponseInfo>>(response);
    }
    string getSafeUrl() { return "https://textract.us-east-1.amazonaws.com"; }
}

public class AwsTextractDataProviderTest inherits QUnit::Test {
    public {
        const MyOpts = Opts + {
            "conn": "c,connection=s",
        };

        const OptionColumn = 22;

        #! Tiny inline PNG (1x1 transparent pixel) — sufficient to elicit a
        #! valid Textract response with a PAGE block but no detected words.
        #! Keeps cost minimal (1 page = $0.0015 on the regular tier).
        const TinyPng = parse_base64_string(
            "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAj"
            "CB0C8AAAAASUVORK5CYII=");
    }

    private {
        *string conn_name;
    }

    constructor() : Test("AwsTextractDataProvider Test", "1.0", \ARGV, MyOpts) {
        conn_name = m_options.conn ?? ENV.AWS_TEXTRACT_CONNECTION;

        addTestCase("factory + app + 2 actions registered", \registrationTest());
        addTestCase("detect-document-text builds Document.Bytes from document_bytes",
            \detectBytesTest());
        addTestCase("detect-document-text builds Document.S3Object from s3_bucket + s3_name",
            \detectS3Test());
        addTestCase("detect-document-text sets X-Amz-Target header",
            \detectAmzTargetTest());
        addTestCase("analyze-document forwards feature_types into FeatureTypes",
            \analyzeFeatureTypesTest());
        addTestCase("analyze-document forwards queries when QUERIES requested",
            \analyzeQueriesTest());
        addTestCase("buildDocument raises when no source given",
            \noSourceTest());
        addTestCase("app declares Documents AppGroup",   \documentsAppGroupTest());

        # Live tests require a real AWS connection with Textract permissions
        # (cost: 1 page on regular tier ≈ $0.0015 per run — fits inside the
        # 3-month / 1k-page free tier indefinitely while testing)
        if (conn_name) {
            addTestCase("live: ping + detect-document-text",
                \liveTextractTest());
        }
        set_return_value(main());
    }

    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-c,--connection=ARG",
            "set the AWS Textract connection name; without it (and without "
            "the AWS_TEXTRACT_CONNECTION env var) the live test is skipped",
            OptionColumn);
    }

    private registrationTest() {
        DataProvider::AbstractDataProviderFactory f =
            DataProvider::DataProvider::getFactory("aws-textract");
        assertEq("aws-textract", f.getInfo().name);

        hash<DataProviderAppInfo> app =
            DataProvider::DataProviderActionCatalog::getApp("AwsTextract");
        assertEq("AwsTextract", app.name);
        assertEq("aws-textract", app.scheme);

        # filter out the framework-injected make-api-call action (covered by
        # GenericApiCallAutoInjection.qtest in RestClientDataProvider)
        list<hash<DataProviderActionInfo>> actions = select
            DataProvider::DataProviderActionCatalog::getActions("AwsTextract"),
            $1.action != AbstractDataProvider::GenericApiCallActionName;
        assertEq(2, actions.size());

        list<string> action_codes = sort(map $1.action, actions);
        assertEq(("analyze-document", "detect-document-text"), action_codes);
    }

    private detectBytesTest() {
        FakeAwsTextractClient fake();
        fake.response = <RestClient::RestResponseInfo>{
            "body": {"DocumentMetadata": {"Pages": 1}, "Blocks": ()},
        };
        AwsTextractDataProvider::AwsTextractDetectDocumentTextDataProvider prov(fake);
        prov.doRequest({"document_bytes": binary("FAKE-PNG")});
        assertEq("/", fake.last_path);
        assertEq(binary("FAKE-PNG"), fake.last_body.Document.Bytes);
        # No S3Object set when bytes were supplied
        assertEq(NOTHING, fake.last_body.Document.S3Object);
    }

    private detectS3Test() {
        FakeAwsTextractClient fake();
        fake.response = <RestClient::RestResponseInfo>{
            "body": {"DocumentMetadata": {"Pages": 1}, "Blocks": ()},
        };
        AwsTextractDataProvider::AwsTextractDetectDocumentTextDataProvider prov(fake);
        prov.doRequest({
            "s3_bucket":  "my-bucket",
            "s3_name":    "docs/invoice.pdf",
            "s3_version": "v42",
        });
        assertEq("my-bucket",         fake.last_body.Document.S3Object.Bucket);
        assertEq("docs/invoice.pdf",  fake.last_body.Document.S3Object.Name);
        assertEq("v42",               fake.last_body.Document.S3Object.Version);
        # No Bytes set when S3 was supplied
        assertEq(NOTHING, fake.last_body.Document.Bytes);
    }

    private detectAmzTargetTest() {
        FakeAwsTextractClient fake();
        fake.response = <RestClient::RestResponseInfo>{
            "body": {"DocumentMetadata": {"Pages": 1}, "Blocks": ()},
        };
        AwsTextractDataProvider::AwsTextractDetectDocumentTextDataProvider prov(fake);
        prov.doRequest({"document_bytes": binary("x")});
        assertEq("Textract.DetectDocumentText", fake.last_headers."X-Amz-Target");
        assertEq("application/x-amz-json-1.1",  fake.last_headers."Content-Type");
    }

    private analyzeFeatureTypesTest() {
        FakeAwsTextractClient fake();
        fake.response = <RestClient::RestResponseInfo>{
            "body": {"DocumentMetadata": {"Pages": 1}, "Blocks": ()},
        };
        AwsTextractDataProvider::AwsTextractAnalyzeDocumentDataProvider prov(fake);
        prov.doRequest({
            "document_bytes": binary("x"),
            "feature_types":  ("TABLES", "FORMS"),
        });
        assertEq("Textract.AnalyzeDocument", fake.last_headers."X-Amz-Target");
        assertEq(("TABLES", "FORMS"), fake.last_body.FeatureTypes);
        # No QueriesConfig when queries weren't supplied
        assertEq(NOTHING, fake.last_body.QueriesConfig);
    }

    private analyzeQueriesTest() {
        FakeAwsTextractClient fake();
        fake.response = <RestClient::RestResponseInfo>{
            "body": {"DocumentMetadata": {"Pages": 1}, "Blocks": ()},
        };
        AwsTextractDataProvider::AwsTextractAnalyzeDocumentDataProvider prov(fake);
        prov.doRequest({
            "document_bytes": binary("x"),
            "feature_types":  ("QUERIES",),
            "queries":        ({"Text": "What is the invoice total?",
                                "Alias": "total"},),
        });
        assertEq(("QUERIES",), fake.last_body.FeatureTypes);
        assertEq("What is the invoice total?",
            fake.last_body.QueriesConfig.Queries[0].Text);
        assertEq("total", fake.last_body.QueriesConfig.Queries[0].Alias);
    }

    private noSourceTest() {
        FakeAwsTextractClient fake();
        AwsTextractDataProvider::AwsTextractDetectDocumentTextDataProvider prov(fake);
        assertThrows("AWS-TEXTRACT-CONFIG-ERROR", sub () {
            prov.doRequest({});
        });
    }

    private documentsAppGroupTest() {
        hash<DataProviderAppInfo> app =
            DataProvider::DataProviderActionCatalog::getApp("AwsTextract");
        assertTrue(inlist(DataProvider::AppGroup::AiLlm,     app.groups));
        assertTrue(inlist(DataProvider::AppGroup::Documents, app.groups));
    }

    #! Exercises Textract's live `DetectDocumentText` action via SigV4
    /** Verifies the actual wire format against AWS Textract's production
        endpoint.  Cost: ~$0.0015 per page (free-tier eligible).
    */
    private liveTextractTest() {
        AbstractConnection conn = get_connection(conn_name);
        hash<auto> ping = conn.ping(True);
        assertTrue(ping.ok, sprintf("AWS Textract connection ping failed: %s",
            ping.info ?? "no info"));

        AbstractDataProvider prov = conn.getDataProvider();
        AbstractDataProvider dt = prov.getChildProvider("detect-document-text");
        auto result = dt.doRequest({"document_bytes": TinyPng});

        # Even on a blank pixel, Textract returns at least a PAGE block
        assertTrue(result.Blocks.size() >= 1,
            "Textract returned at least one Block");
        # First block is conventionally a PAGE
        assertEq("PAGE", result.Blocks[0].BlockType,
            "first Block is PAGE");
        assertTrue(result.DocumentMetadata.Pages >= 1,
            "Textract reported >= 1 page");
    }
}
