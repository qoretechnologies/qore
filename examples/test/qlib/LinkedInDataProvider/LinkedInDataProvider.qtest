%exec-class LinkedInDataProviderTest

#! One recorded request
hashdecl RecordedRequest {
    string method;
    string path;
    auto body;
    *hash<auto> headers;
    #! True if the request went out on the raw (no-codec) path
    bool raw;
}

#! A LinkedIn REST client that records requests instead of making them
/** Responses are taken from a queue so that a multi-step flow -- the two-step image upload, the
    multi-part video upload -- can be driven exactly as LinkedIn would drive it.  When the queue is
    empty \c default_response is used.
*/
class FakeLinkedInRestClientIo inherits LinkedInRestClient::LinkedInRestClientIo {
    public {
        #! Every request made, in order
        list<hash<RecordedRequest>> requests = ();

        #! Queued responses, consumed in order
        list<hash<auto>> responses = ();

        #! Used when the response queue is empty
        hash<auto> default_response = {"body": {}, "headers": {}};
    }

    constructor(*hash<auto> opts) : LinkedInRestClientIo({
        "oauth2_client_id": "test-id",
        "oauth2_client_secret": "test-secret",
        "oauth2_redirect_url": "https://example.com/oauth2-callback",
        # a static token stands in for a completed authorization-code flow, so that constructing the
        # client does not try to authorize against LinkedIn
        "token": "test-token",
    } + (opts ?? {})) {
    }

    #! Returns the request at the given index
    hash<RecordedRequest> req(int i) {
        if (i >= requests.size()) {
            throw "TEST-ERROR", sprintf("request %d requested but only %d were recorded", i,
                requests.size());
        }
        return requests[i];
    }

    #! Returns the most recent request
    hash<RecordedRequest> last() {
        if (!requests) {
            throw "TEST-ERROR", "no requests were recorded";
        }
        return requests[requests.size() - 1];
    }

    #! Queues a response
    push_response(hash<auto> resp) {
        push responses, resp;
    }

    #! Queues the userinfo response that resolves the member URN
    push_userinfo(string id = "ABC123") {
        push_response({"body": {"sub": id}});
    }

    reset() {
        requests = ();
        responses = ();
    }

    private hash<RestClient::RestResponseInfo> record(string method, string path, auto body,
            *hash<auto> hdr, bool raw) {
        push requests, <RecordedRequest>{
            "method": method,
            "path": path,
            "body": body,
            "headers": hdr,
            "raw": raw,
        };
        hash<auto> resp = responses ? shift responses : default_response;
        # a queued response may ask for a transport-level failure, which is how the I/O retry set is
        # driven -- those errors carry no HTTP status at all
        if (resp.throw_err) {
            throw resp.throw_err, "simulated transport failure";
        }
        # a queued response may ask for an error, which is how LinkedIn's error envelopes are driven
        # through the real error handling
        if (resp.throw_status) {
            throw "REST-RESPONSE-ERROR", sprintf("HTTP %d response received", resp.throw_status),
                <RestClient::RestResponseInfo>{
                    "status_code": resp.throw_status,
                    "headers": resp.headers ?? {},
                    "body": resp.body,
                    "request_path": path,
                };
        }
        return <RestClient::RestResponseInfo>{
            "status_code": resp.status_code ?? 200,
            "body": resp.body,
            "headers": resp.headers ?? {},
        };
    }

    hash<RestClient::RestResponseInfo> restGet(string path, *hash<auto> hdr) {
        return record("GET", path, NOTHING, hdr, False);
    }

    hash<RestClient::RestResponseInfo> restPost(string path, auto body, *hash<auto> hdr) {
        return record("POST", path, body, hdr, False);
    }

    hash<RestClient::RestResponseInfo> restPut(string path, auto body, *hash<auto> hdr) {
        return record("PUT", path, body, hdr, False);
    }

    hash<RestClient::RestResponseInfo> restPatch(string path, auto body, *hash<auto> hdr) {
        return record("PATCH", path, body, hdr, False);
    }

    hash<RestClient::RestResponseInfo> restDel(string path, auto body, *hash<auto> hdr) {
        return record("DELETE", path, body, hdr, False);
    }

    hash<RestClient::RestResponseInfo> restDoRequest(string method, string path, auto body,
            *hash<auto> hdr) {
        return record(method, path, body, hdr, False);
    }

    hash<RestClient::RestResponseInfo> restDoRawRequest(string method, string path, *data body,
            *hash<auto> hdr) {
        return record(method, path, body, hdr, True);
    }
}

#! A client for LinkedIn's media upload hosts that records uploads instead of making them
class FakeUploadClient inherits RestClientIo::RestClientIo {
    public {
        #! Every upload made, in order
        list<hash<RecordedRequest>> uploads = ();

        #! The origins the provider bound a client to, in order
        list<string> origins = ();

        #! Queued responses, consumed in order
        list<hash<auto>> responses = ();

        #! Used when the response queue is empty
        hash<auto> default_response = {"headers": {"etag": "\"part-etag\""}};
    }

    constructor() : RestClientIo({"url": "https://www.linkedin.com"}) {
    }

    push_response(hash<auto> resp) {
        push responses, resp;
    }

    hash<RestClient::RestResponseInfo> restDoRawRequest(string method, string path, *data body,
            *hash<auto> hdr) {
        push uploads, <RecordedRequest>{
            "method": method,
            "path": path,
            "body": body,
            "headers": hdr,
            "raw": True,
        };
        hash<auto> resp = responses ? shift responses : default_response;
        return <RestClient::RestResponseInfo>{
            "status_code": resp.status_code ?? 200,
            "body": resp.body,
            "headers": resp.headers ?? {},
        };
    }
}

# The media upload host is reached with a client of its own -- a RestClientIo request resolves its
# path against the client's own URL, so an upload URL on www.linkedin.com cannot go through the
# api.linkedin.com client.  Subclassing is how the test substitutes that second client; the factory
# method is deliberately not part of the module's public API.
#! Exposes the generic-call client factory, which is deliberately not public API
class TestGenericCallProvider inherits LinkedInDataProvider::LinkedInGetCurrentUserDataProvider {
    constructor(LinkedInRestClient::LinkedInRestClientIo rest) : LinkedInGetCurrentUserDataProvider(rest) {}
    *object genericCallClient() {
        return getRestClientForGenericCallImpl();
    }
}

class TestUploadImageDataProvider inherits LinkedInDataProvider::LinkedInUploadImageDataProvider {
    public { FakeUploadClient upload; }
    constructor(LinkedInRestClient::LinkedInRestClientIo rest, FakeUploadClient upload)
            : LinkedInUploadImageDataProvider(rest) { self.upload = upload; }
    private RestClientIo::RestClientIo getUploadClient(string origin) {
        push upload.origins, origin;
        return upload;
    }
}

