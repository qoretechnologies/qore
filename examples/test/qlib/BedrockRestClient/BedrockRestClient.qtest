#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Logger
%requires Mime
%requires HttpServerUtil
%requires HttpServer
%requires HttpServerAsyncIo
%requires QoreLlmTypes
%requires QoreRagTypes
%requires QoreLlmUtils
%requires AwsRestClient
%requires AwsEventStream
%requires BedrockRestClient
%requires BedrockDataProvider

%requires json

%exec-class BedrockTest

class FakeBedrockHandler inherits AbstractHttpRequestHandler {
    public {
        string last_path = "";
        *hash<auto> last_body;
        string last_authorization = "";
        hash<auto> last_headers;
        string last_raw_body;
        # default canned response for /model/.../converse
        hash<auto> converse_response = {
            "output": {
                "message": {
                    "role": "assistant",
                    "content": ({"text": "Hello from Bedrock"},),
                },
            },
            "stopReason": "end_turn",
            "usage": {
                "inputTokens": 12,
                "outputTokens": 5,
                "totalTokens": 17,
            },
        };
        # default canned response for /model/.../invoke (Titan embed)
        hash<auto> embed_response = {
            "embedding": (0.1, 0.2, 0.3, 0.4),
            "inputTextTokenCount": 3,
        };
    }

    hash handleRequest(hash cx, hash hdr, *data body) {
        last_path = cx.raw_path;
        last_authorization = hdr."authorization" ?? "";
        last_headers = hdr;
        last_headers."content-type" = hdr."_qore_orig_content_type" ?? hdr."content-type";
        string body_str = body
            ? (body.typeCode() == NT_BINARY ? body.toString("UTF-8") : body)
            : "";
        last_raw_body = body_str;
        try {
            last_body = parse_json(body_str);
        } catch () {
            last_body = NOTHING;
        }
        # Route by path
        if (last_path =~ /\/converse$/) {
            return makeResponse({"Content-Type": MimeTypeJson}, 200,
                make_json(converse_response));
        }
        if (last_path =~ /\/converse-stream$/) {
            binary frames = event("messageStart", {"role": "assistant"});
            int index = 0;
            foreach hash<auto> block in (converse_response.output.message.content) {
                if (exists block.text) {
                    frames += event("contentBlockDelta", {"contentBlockIndex": index,
                        "delta": {"text": block.text.substr(0, 3)}});
                    frames += event("contentBlockDelta", {"contentBlockIndex": index,
                        "delta": {"text": block.text.substr(3)}});
                } else if (block.toolUse) {
                    frames += event("contentBlockStart", {"contentBlockIndex": index,
                        "start": {"toolUse": block.toolUse - "input"}});
                    string args = make_json(block.toolUse.input);
                    frames += event("contentBlockDelta", {"contentBlockIndex": index,
                        "delta": {"toolUse": {"input": args.substr(0, 3)}}});
                    frames += event("contentBlockDelta", {"contentBlockIndex": index,
                        "delta": {"toolUse": {"input": args.substr(3)}}});
                }
                frames += event("contentBlockStop", {"contentBlockIndex": index++});
            }
            frames += event("messageStop", {"stopReason": converse_response.stopReason});
            frames += event("metadata", {"usage": converse_response.usage});
            return makeResponse({"Content-Type": "application/vnd.amazon.eventstream"}, 200, frames);
        }
        if (last_path =~ /\/invoke$/) {
            return makeResponse({"Content-Type": MimeTypeJson}, 200,
                make_json(embed_response));
        }
        if (last_path == "/foundation-models") {
            if (last_authorization !~ /Credential=AKIA-TEST\//) {
                return makeResponse({"Content-Type": MimeTypeJson}, 403,
                    make_json({"message": "invalid fixture credential"}));
            }
            return makeResponse({"Content-Type": MimeTypeJson}, 200,
                make_json({"modelSummaries": ()}));
        }
        return makeResponse(404, "unknown bedrock path: " + last_path);
    }

    private static binary event(string name, hash<auto> value) {
        return AwsEventStreamEncoder::encode({":message-type": "event", ":event-type": name,
            ":content-type": MimeTypeJson}, binary(make_json(value)));
    }
}

class TestBedrockRestConnection inherits BedrockRestClient::BedrockRestConnection {
    private {
        int port;
        string access_key;
    }

    constructor(int port, string access_key = "AKIA-TEST")
            : BedrockRestConnection("bedrock-test", "Bedrock test connection", NOTHING, {}, {
                "aws_region": "us-east-1",
                "aws_keyid": access_key,
                "aws_secret": "test-secret",
            }) {
        self.port = port;
        self.access_key = access_key;
    }

    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        return new AwsRestClient::AwsRestClientIo({
            "url": "http://localhost:" + port,
            "aws_region": "us-east-1",
            "aws_service": "bedrock",
            "aws_keyid": access_key,
            "aws_secret": "test-secret",
            "aws_imds_disabled": True,
        });
    }
}

public class BedrockTest inherits QUnit::Test {
    private {
        HttpServer bedrock_http;
        int bedrock_port;
        FakeBedrockHandler handler;
    }

    constructor() : Test("Bedrock Test", "1.0") {
        addTestCase("factory registered + getInfo",       \factoryTest());
        addTestCase("Converse chat round-trip",           \converseChatTest());
        addTestCase("Converse tool_use round-trip",       \converseToolUseTest());
        addTestCase("Converse complete() helper",         \completeTest());
        addTestCase("chatStream delivers native incremental events", \chatStreamTest());
        addTestCase("streamed tool calls are collected", \chatStreamToolUseTest());
        addTestCase("SigV4 authorization header is signed", \sigV4Test());
        addTestCase("missing region throws at construction", \missingRegionTest());
        addTestCase("Titan embedder round-trip",          \titanEmbedderTest());
        addTestCase("Bedrock connection metadata and provider", \connectionTest());
        addTestCase("Bedrock connection authenticated ping", \connectionPingTest());

        if (ENV.BEDROCK_LIVE) {
            addTestCase("live: valid and invalid connection authentication",
                \liveConnectionPingTest());
        }

        try {
            setupFakeServer();
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("setup error: %s\n", get_exception_string(ex));
            }
        }
        set_return_value(main());
    }

    private setupFakeServer() {
        Logger logger("test", LoggerLevel::getLevelInfo());
        bedrock_http = new HttpServer(<HttpServerOptionInfo>{"logger": logger});
        handler = new FakeBedrockHandler();
        bedrock_http.setDefaultHandler("bedrock", handler);
        bedrock_port = bedrock_http.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
    }

    globalTearDown() {
        delete bedrock_http;
    }

    static checkJson(Test test) {
    }

    private factoryTest() {
        QoreLlmUtils::AbstractLlmProviderFactory f =
            QoreLlmUtils::LlmProviderRegistry::getFactoryEx("bedrock");
        assertEq("bedrock", f.getMode());
        hash<QoreLlmUtils::LlmProviderInfo> info = f.getInfo();
        assertEq("BedrockRestClient", info.module_name);
        assertTrue(info.supports_tools);
        assertTrue(info.supports_multimodal);
    }

    private converseChatTest() {
        BedrockTest::checkJson(self);
        if (!bedrock_http) {
            testSkip("no fake server");
        }
        BedrockRestClient::BedrockLlmProvider p = newProvider();
        hash<QoreLlmUtils::ChatResponse> r = p.chat((
            <QoreLlmUtils::ChatMessage>{"role": "user", "content": "ping"},
        ));
        assertEq("Hello from Bedrock", r.content);
        assertEq("end_turn", r.stop_reason);
        assertEq(12, r.usage.prompt_tokens);
        assertEq(5,  r.usage.completion_tokens);
        assertEq(17, r.usage.total_tokens);
        # verify the request body shape sent to Bedrock
        assertEq(1, handler.last_body.messages.size());
        assertEq("user", handler.last_body.messages[0].role);
        assertEq("ping", handler.last_body.messages[0].content[0].text);
        # path includes URL-encoded model ID
        assertTrue(handler.last_path =~ /\/model\/anthropic\..*\/converse$/,
            sprintf("expected /model/anthropic.../converse, got %y", handler.last_path));
    }

    private converseToolUseTest() {
        BedrockTest::checkJson(self);
        if (!bedrock_http) {
            testSkip("no fake server");
        }
        # toolUse response — save+restore so subsequent tests see the default text shape
        hash<auto> saved_response = handler.converse_response;
        on_exit handler.converse_response = saved_response;
        handler.converse_response = {
            "output": {
                "message": {
                    "role": "assistant",
                    "content": ({
                        "toolUse": {
                            "toolUseId": "tooluse_abc",
                            "name": "get_weather",
                            "input": {"city": "London"},
                        },
                    },),
                },
            },
            "stopReason": "tool_use",
            "usage": {"inputTokens": 10, "outputTokens": 20, "totalTokens": 30},
        };
        BedrockRestClient::BedrockLlmProvider p = newProvider();
        hash<QoreLlmUtils::ChatResponse> r = p.chat((
            <QoreLlmUtils::ChatMessage>{"role": "user", "content": "weather?"},
        ), (
            <QoreLlmUtils::ToolDefinition>{
                "name": "get_weather",
                "description": "weather lookup",
                "parameters": {
                    "type": "object",
                    "properties": {"city": {"type": "string"}},
                },
            },
        ));
        assertEq("tool_use", r.stop_reason);
        assertEq(1, r.tool_calls.size());
        assertEq("tooluse_abc",   r.tool_calls[0].id);
        assertEq("get_weather",   r.tool_calls[0].name);
        assertEq("London",        r.tool_calls[0].arguments.city);
        # verify tool config was sent in the request
        assertEq(1, handler.last_body.toolConfig.tools.size());
        assertEq("get_weather",
            handler.last_body.toolConfig.tools[0].toolSpec.name);
    }

    private completeTest() {
        BedrockTest::checkJson(self);
        if (!bedrock_http) {
            testSkip("no fake server");
        }
        BedrockRestClient::BedrockLlmProvider p = newProvider();
        hash<QoreLlmUtils::LlmCompletionResult> r = p.complete(
            "You are a helper.", "Say hi.");
        assertEq("Hello from Bedrock", r.content);
        # system prompt routed to Bedrock 'system' block
        assertEq("You are a helper.", handler.last_body.system[0].text);
    }

    private chatStreamTest() {
        BedrockTest::checkJson(self);
        if (!bedrock_http) {
            testSkip("no fake server");
        }
        BedrockRestClient::BedrockLlmProvider p = newProvider();
        list<hash<QoreLlmUtils::ChatStreamEvent>> events = ();
        p.chatStream((
            <QoreLlmUtils::ChatMessage>{"role": "user", "content": "stream"},
        ), sub (hash<QoreLlmUtils::ChatStreamEvent> e) {
            push events, e;
        });
        assertEq(7, events.size(), "native events and one final completion are delivered");
        assertEq("Hel", events[1].delta);
        assertEq("lo from Bedrock", events[2].delta);
        assertEq(1, (select events, $1.done).size());
        assertTrue(events[-1].done);
        assertEq("end_turn", events[4].raw.messageStop.stopReason);
        assertTrue(handler.last_path =~ /\/converse-stream$/);

        # stream consumers read the stop reason and usage from the event
        QoreLlmUtils::LlmBackend backend = newBackend();
        hash<QoreLlmUtils::ChatResponse> r = backend.chatStreamCollect((
            <QoreLlmUtils::ChatMessage>{"role": "user", "content": "stream"},
        ));
        assertEq("Hello from Bedrock", r.content);
        assertEq("end_turn", r.stop_reason);
        assertEq(17, r.usage.total_tokens);
        hash<auto> resp = backend.chatCompletionsStream({
            "messages": ({"role": "user", "content": "stream"},),
        }, sub (hash<auto> chunk) {});
        assertEq("Hello from Bedrock", resp.choices[0].message.content);
        assertEq("stop", resp.choices[0].finish_reason);
    }

    private chatStreamToolUseTest() {
        BedrockTest::checkJson(self);
        if (!bedrock_http) {
            testSkip("no fake server");
        }
        hash<auto> saved = handler.converse_response;
        on_exit handler.converse_response = saved;
        handler.converse_response = {
            "output": {
                "message": {
                    "role": "assistant",
                    "content": (
                        {"text": "Checking."},
                        {"toolUse": {"toolUseId": "tu-1", "name": "lookup", "input": {"key": "a"}}},
                        {"toolUse": {"toolUseId": "tu-2", "name": "lookup", "input": {"key": "b"}}},
                    ),
                },
            },
            "stopReason": "tool_use",
            "usage": {"inputTokens": 12, "outputTokens": 9, "totalTokens": 21},
        };
        QoreLlmUtils::LlmBackend backend = newBackend();
        list<hash<QoreLlmUtils::ToolDefinition>> tools = (
            <QoreLlmUtils::ToolDefinition>{
                "name": "lookup",
                "parameters": {"type": "object", "properties": {"key": {"type": "string"}}},
            },
        );
        hash<QoreLlmUtils::ChatResponse> r = backend.chatStreamCollect((
            <QoreLlmUtils::ChatMessage>{"role": "user", "content": "look up a and b"},
        ), NOTHING, tools);
        assertEq("tool_use", r.stop_reason);
        assertEq("Checking.", r.content);
        assertEq(2, r.tool_calls.size(), "each tool call is collected exactly once");
        assertEq("tu-1", r.tool_calls[0].id);
        assertEq({"key": "a"}, r.tool_calls[0].arguments);
        assertEq("tu-2", r.tool_calls[1].id);
        assertEq({"key": "b"}, r.tool_calls[1].arguments);

        hash<auto> resp = backend.chatCompletionsStream({
            "messages": ({"role": "user", "content": "look up a and b"},),
            "tools": ({
                "type": "function",
                "function": {
                    "name": "lookup",
                    "parameters": {"type": "object", "properties": {"key": {"type": "string"}}},
                },
            },),
        }, sub (hash<auto> chunk) {});
        assertEq("tool_calls", resp.choices[0].finish_reason);
        assertEq(2, resp.choices[0].message.tool_calls.size());
        assertEq("{\"key\":\"b\"}", resp.choices[0].message.tool_calls[1]."function".arguments);
    }

    private sigV4Test() {
        BedrockTest::checkJson(self);
        if (!bedrock_http) {
            testSkip("no fake server");
        }
        BedrockRestClient::BedrockLlmProvider p = newProvider();
        p.chat((<QoreLlmUtils::ChatMessage>{"role": "user", "content": "x"},));
        # the request must have been SigV4-signed; AWS4-HMAC-SHA256 in Authorization
        assertTrue(handler.last_authorization =~ /^AWS4-HMAC-SHA256/,
            sprintf("expected SigV4 authorization header, got %y",
                handler.last_authorization));
        # scope must include the bedrock service
        assertTrue(handler.last_authorization =~ /\/bedrock\/aws4_request/,
            "Authorization scope must mention 'bedrock' service");
        assertSignature();
    }

    #! Recomputes SigV4 from the actual wire request, independently of the client signer
    private assertSignature(string secret = "test-secret") {
        assertEq(MimeTypeJson, handler.last_headers."content-type",
            "Bedrock model endpoints receive the exact application/json media type");
        assertEq(MimeTypeJson, handler.last_headers.accept,
            "Bedrock model endpoints receive a single JSON Accept media type");
        list<string> signature_parts = handler.last_authorization.split("SignedHeaders=")[1]
            .split(", Signature=");
        string signed_headers = signature_parts[0];
        string headers = "";
        foreach string name in (signed_headers.split(";")) {
            headers += name + ":" + regex_subst(trim(handler.last_headers{name}), " +", " ", RE_Global) + "\n";
        }
        string canonical = "POST\n" + encode_url(handler.last_path, False) + "\n\n" + headers + "\n"
            + signed_headers + "\n" + digest(CRYPTO_DIGEST_SHA256, handler.last_raw_body).toHex();
        string timestamp = handler.last_headers."x-amz-date";
        string day = substr(timestamp, 0, 8);
        string scope = day + "/us-east-1/bedrock/aws4_request";
        string to_sign = "AWS4-HMAC-SHA256\n" + timestamp + "\n" + scope + "\n"
            + digest(CRYPTO_DIGEST_SHA256, canonical).toHex();
        binary key = hmac(CRYPTO_DIGEST_SHA256, day, "AWS4" + secret);
        foreach string component in ("us-east-1", "bedrock", "aws4_request") {
            key = hmac(CRYPTO_DIGEST_SHA256, component, key);
        }
        assertEq(hmac(CRYPTO_DIGEST_SHA256, to_sign, key).toHex(), signature_parts[1],
            "SigV4 matches the encoded model ID and JSON bytes sent on the wire");
    }

    private missingRegionTest() {
        BedrockTest::checkJson(self);
        # snapshot env; ensure no region is leaking in
        *string saved_r = getenv("AWS_REGION");
        *string saved_dr = getenv("AWS_DEFAULT_REGION");
        unsetenv("AWS_REGION");
        unsetenv("AWS_DEFAULT_REGION");
        on_exit {
            saved_r.val()  ? setenv("AWS_REGION", saved_r)          : unsetenv("AWS_REGION");
            saved_dr.val() ? setenv("AWS_DEFAULT_REGION", saved_dr) : unsetenv("AWS_DEFAULT_REGION");
        }
        assertThrows("LLM-CONFIG-ERROR", sub () {
            new BedrockRestClient::BedrockLlmProvider(<QoreLlmUtils::LlmBackendConfig>{
                "model": "anthropic.claude-3-5-sonnet-20240620-v1:0",
                "provider_options": {"aws_keyid": "k", "aws_secret": "s"},
            });
        });
    }

    private titanEmbedderTest() {
        BedrockTest::checkJson(self);
        if (!bedrock_http) {
            testSkip("no fake server");
        }
        QoreRagUtils::AbstractEmbedderFactory f =
            QoreRagUtils::RagProviderRegistry::getEmbedderFactoryEx("bedrock");
        assertEq("bedrock", f.getType());
        QoreRagUtils::AbstractEmbedder emb = f.create(<QoreRagUtils::EmbedderConfig>{
            "backend": "bedrock",
            "model": "amazon.titan-embed-text-v2:0",
            "url": "http://localhost:" + bedrock_port,
            "options": {
                "aws_region": "us-east-1",
                "aws_keyid": "k",
                "aws_secret": "s",
                "aws_imds_disabled": True,
            },
        });
        list<float> v = emb.encode("hello world");
        assertEq((0.1, 0.2, 0.3, 0.4), v);
        assertEq(4, emb.getDimension());
        # request body: Titan-shaped
        assertEq("hello world", handler.last_body.inputText);
        assertSignature("s");
    }

    private connectionTest() {
        BedrockTest::checkJson(self);
        BedrockRestClient::BedrockRestConnection conn("bedrock-test",
            "test", "", NOTHING, {
                "aws_region": "eu-west-1",
                "aws_keyid": "k",
                "aws_secret": "s",
            });
        assertEq("bedrock", conn.getType());
        assertEq("AWSBedrock", conn.getAppName());
        assertTrue(conn.hasDataProvider());
        assertEq("bedrock://bedrock-runtime.eu-west-1.amazonaws.com",
            conn.getInfo().url);
        assertEq("https://bedrock.eu-west-1.amazonaws.com",
            BedrockRestClient::BedrockRestConnection::getControlPlaneUrl(
                "https://bedrock-runtime.eu-west-1.amazonaws.com"));

        hash<ConnectionSchemeInfo> scheme =
            BedrockRestClient::BedrockRestConnection::ConnectionScheme;
        assertTrue(scheme.auto_url);
        assertEq("bedrock", scheme.base_scheme_map.https);
        assertEq("aws_region", scheme.required_options);
        assertTrue(scheme.options.aws_keyid.sensitive);
        assertTrue(scheme.options.aws_secret.sensitive);
        assertTrue(scheme.options.aws_token.sensitive);
        assertTrue(scheme.options.aws_external_id.sensitive);
        assertEq("us-east-1", scheme.options.aws_region.default_value);
        assertEq("BedrockRestClient",
            ConnectionSchemeCache::SchemeMap.bedrock);

        TestBedrockRestConnection test_conn(bedrock_port);
        AbstractDataProvider provider = test_conn.getDataProvider();
        assertEq("bedrock", provider.getName());
        assertTrue(inlist("converse", provider.getChildProviderNames()));
    }

    private connectionPingTest() {
        BedrockTest::checkJson(self);
        if (!bedrock_http) {
            testSkip("no fake server");
        }
        TestBedrockRestConnection valid(bedrock_port);
        hash<PingInfo> ping = valid.ping(True);
        assertTrue(ping.ok);
        assertEq("/foundation-models", handler.last_path);
        assertTrue(handler.last_authorization =~ /Credential=AKIA-TEST\//);

        TestBedrockRestConnection invalid(bedrock_port, "AKIA-INVALID");
        assertThrows("REST-RESPONSE-ERROR", sub () { invalid.ping(True); });
        hash<PingInfo> failed = invalid.ping(False);
        assertFalse(failed.ok);
    }

    private liveConnectionPingTest() {
        string region = getenv("AWS_REGION") ?? getenv("AWS_DEFAULT_REGION")
            ?? "us-east-1";
        BedrockRestClient::BedrockRestConnection valid("bedrock-live",
            "Bedrock live connection", NOTHING, {}, {"aws_region": region});
        hash<PingInfo> ping = valid.ping(True);
        assertTrue(ping.ok, ping.info);

        BedrockRestClient::BedrockRestConnection invalid("bedrock-invalid",
            "Bedrock invalid connection", NOTHING, {}, {
                "aws_region": region,
                "aws_keyid": "AKIAINVALID0000000000",
                "aws_secret": "invalid-secret",
            });
        hash<PingInfo> failed = invalid.ping(False);
        assertFalse(failed.ok, "invalid AWS credentials must fail the ping");
    }

    private QoreLlmUtils::LlmBackend newBackend() {
        return new QoreLlmUtils::LlmBackend(
            <QoreLlmUtils::LlmBackendConfig>{
                "mode": "bedrock",
                "model": "anthropic.claude-3-5-sonnet-20240620-v1:0",
                "url": "http://localhost:" + bedrock_port,
                "provider_options": {
                    "aws_region": "us-east-1",
                    "aws_keyid": "AKIA-TEST",
                    "aws_secret": "test-secret",
                    "aws_imds_disabled": True,
                },
            });
    }

    private BedrockRestClient::BedrockLlmProvider newProvider() {
        return new BedrockRestClient::BedrockLlmProvider(
            <QoreLlmUtils::LlmBackendConfig>{
                "model": "anthropic.claude-3-5-sonnet-20240620-v1:0",
                "url": "http://localhost:" + bedrock_port,
                "provider_options": {
                    "aws_region": "us-east-1",
                    "aws_keyid": "AKIA-TEST",
                    "aws_secret": "test-secret",
                    "aws_imds_disabled": True,
                },
            });
    }
}
