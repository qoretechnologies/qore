        hash<auto> result = createVoice.doRequest({
            "name": "My Custom Voice",
        });

        assertEq("POST", fake.last_method);
        assertEq(True, fake.last_path =~ /v1\/voices\/add/, "path contains v1/voices/add");
        assertEq("new-voice-id", result.voice_id, "result has correct voice_id");
        assertEq(True, exists fake.last_multipart_body, "multipart body was sent");
