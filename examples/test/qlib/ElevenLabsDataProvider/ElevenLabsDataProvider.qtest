    testAddPronunciationRules() {
        fake.response_body = {
            "id": "dict-123",
            "version_id": "ver-456",
            "version_rules_num": 3,
        };

        AbstractDataProvider addRules = dp.getChildProvider("add-pronunciation-rules");
        assertEq(True, exists addRules, "add-pronunciation-rules provider exists");

        # Verify request type has expected fields
        *AbstractDataProviderType reqType = addRules.getRequestType();
        *hash<string, AbstractDataField> fields = reqType.getFields();
        assertEq(True, fields.hasKey("dictionary_id"), "has dictionary_id field");
        assertEq(True, fields.hasKey("rules"), "has rules field");

        hash<auto> result = addRules.doRequest({
            "dictionary_id": "dict-123",
            "rules": (
                {
                    "type": "alias",
                    "string_to_replace": "tomato",
                    "alias": "toh-mah-toh",
                },
            ),
        });

        assertEq("POST", fake.last_method);
        assertEq(True, fake.last_path =~ /pronunciation-dictionaries\/dict-123\/add-rules/,
            "path contains dictionary_id/add-rules");
        assertEq("dict-123", result.id, "result has correct id");
        assertEq("ver-456", result.version_id, "result has correct version_id");
        assertEq(3, result.version_rules_num, "result has correct version_rules_num");
    }

    testConnectionScheme() {
        # Verify connection scheme structure
        hash<auto> scheme = ElevenLabsRestClient::ElevenLabsRestConnection::ConnectionScheme;
        assertEq(True, scheme.options.hasKey("apikey"), "connection scheme has apikey option");
        assertEq("apikey", scheme.required_options, "apikey is required");
        assertEq(True, scheme.options.hasKey("region"), "connection scheme has region option");
        assertEq(True, scheme.auto_url, "connection scheme has auto_url");
        assertEq(True, scheme.schemes.hasKey("elevenlabs"), "connection scheme has elevenlabs scheme");

        # Verify getConfig builds correct URL for default region (us)
        ElevenLabsRestClient::ElevenLabsRestConnection us_conn("test-us", "test", NOTHING, {},
            {"apikey": "test-key"});
        assertEq(True, us_conn.getUrl() =~ /api\.elevenlabs\.io/, "US region uses default URL");

        # Verify getConfig builds correct URL for EU region
        ElevenLabsRestClient::ElevenLabsRestConnection eu_conn("test-eu", "test", NOTHING, {},
            {"apikey": "test-key", "region": "eu"});
        assertEq(True, eu_conn.getUrl() =~ /api\.eu\.residency\.elevenlabs\.io/,
            "EU region uses EU URL");
    }

    testIntegration() {
        # Integration tests run only when ELEVENLABS_API_KEY is set
        *string api_key = ENV.ELEVENLABS_API_KEY;
        if (!api_key) {
            testSkip("set ELEVENLABS_API_KEY to run integration tests");
        }

        ElevenLabsDataProvider::ElevenLabsDataProvider real_dp({"apikey": api_key});

        # Test list-models: verify real API returns model data with expected fields
        {
            AbstractDataProvider models = real_dp.getChildProvider("models");
            hash<auto> result = models.doRequest({});
            assertEq(True, result.models.size() > 0, "API returns at least one model");
            hash<auto> model = result.models[0];
            assertEq(True, exists model.model_id, "model has model_id");
            assertEq(True, exists model.name, "model has name");
        }

        # Test list-voices: verify real API returns voice data with expected fields
        {
            AbstractDataProvider voices = real_dp.getChildProvider("voices");
            hash<auto> result = voices.doRequest({"page_size": 5});
            assertEq(True, result.voices.size() > 0, "API returns at least one voice");
            hash<auto> voice = result.voices[0];
            assertEq(True, exists voice.voice_id, "voice has voice_id");
            assertEq(True, exists voice.name, "voice has name");

            # Test get-voice with a real voice_id
            string voice_id = voice.voice_id;
            AbstractDataProvider getVoice = real_dp.getChildProvider("get-voice");
            hash<auto> voice_detail = getVoice.doRequest({"voice_id": voice_id});
            assertEq(voice_id, voice_detail.voice_id, "get-voice returns correct voice_id");
            assertEq(True, exists voice_detail.name, "get-voice returns name");
        }

        # Test list-history: verify pagination works and field values
        {
            AbstractDataProvider history = real_dp.getChildProvider("history");
            hash<auto> result = history.doRequest({"page_size": 1});
            assertEq(True, exists result.has_more, "history response has has_more field");
            if (result.history.size() > 0) {
                hash<auto> item = result.history[0];
                assertEq(True, exists item.history_item_id, "history item has history_item_id");
                assertEq(True, exists item.state, "history item has state");
            }
        }

        # Test list-dubbing: verify API returns dubbing projects and get-dubbing-audio
        {
            AbstractDataProvider listDubbing = real_dp.getChildProvider("list-dubbing");
            hash<auto> result = listDubbing.doRequest({"page_size": 5});
            assertEq(True, exists result.has_more, "list-dubbing response has has_more field");
            if (result.dubs.size() > 0) {
                hash<auto> dub = result.dubs[0];
                assertEq(True, exists dub.dubbing_id, "dubbing project has dubbing_id");

                # Test get-dubbing-audio if there's a dubbed project with target languages
                if (dub.status == "dubbed" && dub.target_languages.size() > 0) {
                    AbstractDataProvider getDubAudio = real_dp.getChildProvider("get-dubbing-audio");
                    hash<auto> audio_result = getDubAudio.doRequest({
                        "dubbing_id": dub.dubbing_id,
                        "language_code": dub.target_languages[0],
                    });
                    assertEq(True, exists audio_result.audio, "get-dubbing-audio returns audio");
                    assertEq(True, audio_result.audio.size() > 0,
                        "get-dubbing-audio audio is not empty");
                }
            }
        }

        # Test speech-to-text with a simple audio sample
        {
            AbstractDataProvider stt = real_dp.getChildProvider("speech-to-text");
            # Generate a small TTS audio first to use as input
            AbstractDataProvider tts = real_dp.getChildProvider("text-to-speech");
            *list<string> voice_ids;
            {
                AbstractDataProvider voices = real_dp.getChildProvider("voices");
                hash<auto> vr = voices.doRequest({"page_size": 1});
                if (vr.voices.size() > 0) {
                    voice_ids = map $1.voice_id, vr.voices;
                }
            }
            if (voice_ids) {
                hash<auto> tts_result = tts.doRequest({
                    "voice_id": voice_ids[0],
                    "text": "Hello world",
                });
                assertEq(True, exists tts_result.audio, "TTS returns audio");
                assertEq(True, tts_result.audio.size() > 0, "TTS audio is not empty");

                # Now transcribe the generated audio
                hash<auto> stt_result = stt.doRequest({
                    "audio": tts_result.audio,
                });
                assertEq(True, exists stt_result.text, "STT returns text");
                assertEq(True, stt_result.text.size() > 0, "STT text is not empty");
            }
        }

        # Test voice CRUD round-trip: create -> get -> edit -> delete
        {
            AbstractDataProvider createVoice = real_dp.getChildProvider("create-voice");
            string test_name = "QoreTest-" + string(now_us());
            try {
                hash<auto> create_result = createVoice.doRequest({
                    "name": test_name,
                    "description": "Automated test voice",
                });
                assertEq(True, exists create_result.voice_id, "create-voice returns voice_id");
                string new_voice_id = create_result.voice_id;

                on_exit {
                    # Clean up: delete the test voice
                    AbstractDataProvider delVoice = real_dp.getChildProvider("delete-voice");
                    delVoice.doRequest({"voice_id": new_voice_id});
                }

                # Verify with get-voice
                AbstractDataProvider getVoice = real_dp.getChildProvider("get-voice");
                hash<auto> voice_detail = getVoice.doRequest({"voice_id": new_voice_id});
                assertEq(new_voice_id, voice_detail.voice_id, "get-voice returns created voice_id");
                assertEq(test_name, voice_detail.name, "get-voice returns correct name");

                # Edit the voice
                string updated_name = test_name + "-updated";
                AbstractDataProvider editVoice = real_dp.getChildProvider("edit-voice");
                editVoice.doRequest({
                    "voice_id": new_voice_id,
                    "name": updated_name,
                });

                # Verify edit persisted
                voice_detail = getVoice.doRequest({"voice_id": new_voice_id});
                assertEq(updated_name, voice_detail.name, "edit-voice name persisted");
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err == "ELEVENLABS-API-ERROR") {
                    testSkip("voice CRUD requires paid plan: " + ex.desc);
                } else {
                    rethrow;
                }
            }
        }

        # Test pronunciation dictionary CRUD round-trip: create -> get -> delete (via list verification)
        {
            AbstractDataProvider createDict = real_dp.getChildProvider("create-pronunciation-dictionary");
            string test_dict_name = "QoreTest-" + string(now_us());
            hash<auto> create_result = createDict.doRequest({
                "name": test_dict_name,
                "description": "Automated test dictionary",
            });
            assertEq(True, exists create_result.id, "create-pronunciation-dictionary returns id");
            assertEq(test_dict_name, create_result.name,
                "create-pronunciation-dictionary returns correct name");

            # Verify with get-pronunciation-dictionary
            AbstractDataProvider getDict = real_dp.getChildProvider("get-pronunciation-dictionary");
            hash<auto> dict_detail = getDict.doRequest({"dictionary_id": create_result.id});
            assertEq(create_result.id, dict_detail.id, "get returns created dictionary id");
            assertEq(test_dict_name, dict_detail.name, "get returns correct name");
            assertEq("Automated test dictionary", dict_detail.description,
                "get returns correct description");
        }

        # Test connection ping
        {
            ElevenLabsRestClient::ElevenLabsRestConnection conn("test", "test", NOTHING, {},
                {"apikey": api_key});
            hash<auto> ping_result = conn.ping(True);
            assertEq("ok", ping_result.ok, "connection ping succeeds");
        }
    }
}
