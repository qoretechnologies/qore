    }

    testGetDubbingAudio() {
        fake.response_body = binary("fake dubbed audio");
        fake.response_content_type = "audio/mpeg";

        AbstractDataProvider getDubAudio = dp.getChildProvider("get-dubbing-audio");
        assertEq(True, exists getDubAudio, "get-dubbing-audio provider exists");

        # Verify request type has expected fields
        *AbstractDataProviderType reqType = getDubAudio.getRequestType();
        *hash<string, AbstractDataField> fields = reqType.getFields();
        assertEq(True, fields.hasKey("dubbing_id"), "has dubbing_id field");
        assertEq(True, fields.hasKey("language_code"), "has language_code field");

        hash<auto> result = getDubAudio.doRequest({
            "dubbing_id": "dub-123",
            "language_code": "es",
        });

        assertEq("GET", fake.last_method);
        assertEq(True, fake.last_path =~ /v1\/dubbing\/dub-123\/audio\/es/,
            "path contains dubbing_id and language_code");
        assertEq(True, exists result.audio, "result has audio");
        assertEq("audio/mpeg", result.content_type, "result has correct content_type");
    }

