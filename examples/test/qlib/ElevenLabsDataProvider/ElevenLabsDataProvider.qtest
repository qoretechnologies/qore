#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%allow-injection

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/DataProvider
%requires ../../../../qlib/RestClientIo.qm
%requires ../../../../qlib/ElevenLabsRestClient.qm
%requires ../../../../qlib/ElevenLabsDataProvider

%requires json

%exec-class ElevenLabsDataProviderTest

#! Fake RestClientIo for unit testing
class FakeElevenLabsRestClient inherits RestClientIo::RestClientIo {
    public {
        *hash<auto> last_request;
        string last_method;
        string last_path;
        auto response_body;
        string response_content_type = "application/json";
        #! Raw multipart body from doMultipartPost calls
        *data last_multipart_body;
    }

    constructor() : RestClientIo({"url": "https://api.elevenlabs.io", "data": "json"}) {
    }

    HttpClientIo::HttpClientConnectionManager getConnectionManager() {
        return new FakeConnectionManager(self);
    }

    hash<RestClient::RestResponseInfo> restDoRequest(string method, string path, auto body,
            *hash<auto> hdr) {
        last_method = method;
        last_path = path;
        last_request = body;
        return <RestClient::RestResponseInfo>{
            "status_code": 200,
            "body": response_body,
            "content_type": response_content_type,
            "headers": {},
        };
    }

    hash<RestClient::RestResponseInfo> restGet(string path, *hash<auto> hdr) {
        return restDoRequest("GET", path, NOTHING, hdr);
    }

    hash<RestClient::RestResponseInfo> restPost(string path, auto body, *hash<auto> hdr) {
        return restDoRequest("POST", path, body, hdr);
    }

    hash<RestClient::RestResponseInfo> restPut(string path, auto body, *hash<auto> hdr) {
        return restDoRequest("PUT", path, body, hdr);
    }

    hash<RestClient::RestResponseInfo> restDel(string path, auto body, *hash<auto> hdr) {
        return restDoRequest("DELETE", path, body, hdr);
    }
}

#! Fake connection manager for unit testing multipart requests
class FakeConnectionManager inherits HttpClientIo::HttpClientConnectionManager {
    public {
        #! Reference to the parent fake client for recording requests
        FakeElevenLabsRestClient fake_client;
    }

    constructor(FakeElevenLabsRestClient client) {
        fake_client = client;
    }

    hash<auto> request(string url, string method, string path, *hash<auto> hdr, *data body) {
        fake_client.last_method = method;
        fake_client.last_path = path;
        fake_client.last_multipart_body = body;
        return {
            "status_code": 200,
            "body": fake_client.response_body,
            "headers": {
                "content-type": fake_client.response_content_type,
            },
        };
    }
}

class ElevenLabsDataProviderTest inherits QUnit::Test {
    private {
        FakeElevenLabsRestClient fake;
        ElevenLabsDataProvider::ElevenLabsDataProvider dp;
    }

    constructor() : Test("ElevenLabsDataProvider", "1.0") {
        addTestCase("test provider structure", \testProviderStructure());
        addTestCase("test data types", \testDataTypes());
        addTestCase("test text-to-speech", \testTextToSpeech());
        addTestCase("test speech-to-speech", \testSpeechToSpeech());
        addTestCase("test speech-to-text", \testSpeechToText());
        addTestCase("test text-to-sound-effects", \testTextToSoundEffects());
        addTestCase("test audio-isolation", \testAudioIsolation());
        addTestCase("test list voices", \testListVoices());
        addTestCase("test get voice", \testGetVoice());
        addTestCase("test create voice", \testCreateVoice());
        addTestCase("test edit voice", \testEditVoice());
        addTestCase("test delete voice", \testDeleteVoice());
        addTestCase("test list models", \testListModels());
        addTestCase("test list history", \testListHistory());
        addTestCase("test get history item", \testGetHistoryItem());
        addTestCase("test delete history item", \testDeleteHistoryItem());
        addTestCase("test get history audio", \testGetHistoryAudio());
        addTestCase("test create dubbing", \testCreateDubbing());
        addTestCase("test get dubbing", \testGetDubbing());
        addTestCase("test delete dubbing", \testDeleteDubbing());
        addTestCase("test list dubbing", \testListDubbing());
        addTestCase("test get dubbing audio", \testGetDubbingAudio());
        addTestCase("test voice design", \testVoiceDesign());
        addTestCase("test create pronunciation dictionary", \testCreatePronunciationDictionary());
        addTestCase("test list pronunciation dictionaries", \testListPronunciationDictionaries());
        addTestCase("test get pronunciation dictionary", \testGetPronunciationDictionary());
        addTestCase("test add pronunciation rules", \testAddPronunciationRules());
        addTestCase("test connection scheme", \testConnectionScheme());
        addTestCase("integration test", \testIntegration());

        set_return_value(main());
    }

    setUp() {
        fake = new FakeElevenLabsRestClient();
        dp = new ElevenLabsDataProvider::ElevenLabsDataProvider(fake);
    }

    testProviderStructure() {
        # Verify root provider has expected children
        *list<string> children = dp.getChildProviderNames();
        assertEq(True, children.size() > 0, "provider has children");

        # Check all children exist
        list<string> expected_children = (
            "add-pronunciation-rules", "audio-isolation", "create-dubbing",
            "create-pronunciation-dictionary",
            "create-voice", "delete-dubbing", "delete-history-item", "delete-voice",
            "edit-voice", "get-dubbing", "get-dubbing-audio", "get-history-audio",
            "get-history-item", "get-pronunciation-dictionary", "get-voice", "history",
            "list-dubbing", "list-pronunciation-dictionaries", "models",
            "speech-to-speech", "speech-to-text", "text-to-sound-effects",
            "text-to-speech", "voice-design", "voices",
        );
        foreach string child in (expected_children) {
            assertEq(True, children.contains(child), sprintf("has %s child", child));
        }

        # Verify provider info
        hash<DataProviderInfo> info = dp.getInfo();
        assertEq("elevenlabs", info.name);
        assertEq(True, info.supports_children);
        assertEq(True, info.children_can_support_apis);
    }

    testDataTypes() {
        # Test VoiceSettingsType
        auto vst = new ElevenLabsDataProvider::ElevenLabsVoiceSettingsType();
        *hash<string, AbstractDataField> vst_fields = vst.getFields();
        assertEq(True, vst_fields.hasKey("stability"), "VoiceSettingsType has stability");
        assertEq(True, vst_fields.hasKey("similarity_boost"), "VoiceSettingsType has similarity_boost");
        assertEq(True, vst_fields.hasKey("style"), "VoiceSettingsType has style");
        assertEq(True, vst_fields.hasKey("use_speaker_boost"), "VoiceSettingsType has use_speaker_boost");
        assertEq(True, vst_fields.hasKey("speed"), "VoiceSettingsType has speed");

        # Test AudioResponseType
        *hash<string, AbstractDataField> art_fields = ElevenLabsDataProvider::AudioResponseType.getFields();
        assertEq(True, art_fields.hasKey("audio"), "AudioResponseType has audio");
        assertEq(True, art_fields.hasKey("content_type"), "AudioResponseType has content_type");

        # Test VoiceSummaryDataType
        auto vsdt = new ElevenLabsDataProvider::ElevenLabsVoiceSummaryDataType();
        *hash<string, AbstractDataField> vsdt_fields = vsdt.getFields();
        assertEq(True, vsdt_fields.hasKey("voice_id"), "VoiceSummaryDataType has voice_id");
        assertEq(True, vsdt_fields.hasKey("name"), "VoiceSummaryDataType has name");
        assertEq(True, vsdt_fields.hasKey("category"), "VoiceSummaryDataType has category");

        # Test ModelDataType
        auto mdt = new ElevenLabsDataProvider::ElevenLabsModelDataType();
        *hash<string, AbstractDataField> mdt_fields = mdt.getFields();
        assertEq(True, mdt_fields.hasKey("model_id"), "ModelDataType has model_id");
        assertEq(True, mdt_fields.hasKey("name"), "ModelDataType has name");
        assertEq(True, mdt_fields.hasKey("can_do_text_to_speech"), "ModelDataType has can_do_text_to_speech");
        assertEq(True, mdt_fields.hasKey("languages"), "ModelDataType has languages");

        # Test LanguageDataType
        auto ldt = new ElevenLabsDataProvider::ElevenLabsLanguageDataType();
        *hash<string, AbstractDataField> ldt_fields = ldt.getFields();
        assertEq(True, ldt_fields.hasKey("language_id"), "LanguageDataType has language_id");
        assertEq(True, ldt_fields.hasKey("name"), "LanguageDataType has name");

        # Test VoiceSampleDataType
        auto vsampdt = new ElevenLabsDataProvider::ElevenLabsVoiceSampleDataType();
        *hash<string, AbstractDataField> vsampdt_fields = vsampdt.getFields();
        assertEq(True, vsampdt_fields.hasKey("sample_id"), "VoiceSampleDataType has sample_id");
        assertEq(True, vsampdt_fields.hasKey("file_name"), "VoiceSampleDataType has file_name");
        assertEq(True, vsampdt_fields.hasKey("mime_type"), "VoiceSampleDataType has mime_type");
        assertEq(True, vsampdt_fields.hasKey("size_bytes"), "VoiceSampleDataType has size_bytes");
        assertEq(True, vsampdt_fields.hasKey("duration_secs"), "VoiceSampleDataType has duration_secs");

        # Test VoicePreviewDataType
        auto vpdt = new ElevenLabsDataProvider::ElevenLabsVoicePreviewDataType();
        *hash<string, AbstractDataField> vpdt_fields = vpdt.getFields();
        assertEq(True, vpdt_fields.hasKey("generated_voice_id"), "VoicePreviewDataType has generated_voice_id");
        assertEq(True, vpdt_fields.hasKey("audio_base_64"), "VoicePreviewDataType has audio_base_64");
        assertEq(True, vpdt_fields.hasKey("media_type"), "VoicePreviewDataType has media_type");
        assertEq(True, vpdt_fields.hasKey("duration_secs"), "VoicePreviewDataType has duration_secs");

        # Test WordTimingDataType
        auto wtdt = new ElevenLabsDataProvider::ElevenLabsWordTimingDataType();
        *hash<string, AbstractDataField> wtdt_fields = wtdt.getFields();
        assertEq(True, wtdt_fields.hasKey("text"), "WordTimingDataType has text");
        assertEq(True, wtdt_fields.hasKey("start"), "WordTimingDataType has start");
        assertEq(True, wtdt_fields.hasKey("end"), "WordTimingDataType has end");
        assertEq(True, wtdt_fields.hasKey("speaker_id"), "WordTimingDataType has speaker_id");

        # Test HistoryItemDataType
        auto hidt = new ElevenLabsDataProvider::ElevenLabsHistoryItemDataType();
        *hash<string, AbstractDataField> hidt_fields = hidt.getFields();
        assertEq(True, hidt_fields.hasKey("history_item_id"), "HistoryItemDataType has history_item_id");
        assertEq(True, hidt_fields.hasKey("voice_id"), "HistoryItemDataType has voice_id");
        assertEq(True, hidt_fields.hasKey("voice_name"), "HistoryItemDataType has voice_name");
        assertEq(True, hidt_fields.hasKey("text"), "HistoryItemDataType has text");
        assertEq(True, hidt_fields.hasKey("state"), "HistoryItemDataType has state");

        # Test PronunciationDictionarySummaryDataType
        auto pdst = new ElevenLabsDataProvider::ElevenLabsPronunciationDictionarySummaryDataType();
        *hash<string, AbstractDataField> pdst_fields = pdst.getFields();
        assertEq(True, pdst_fields.hasKey("id"), "PronunciationDictionarySummaryDataType has id");
        assertEq(True, pdst_fields.hasKey("name"), "PronunciationDictionarySummaryDataType has name");
        assertEq(True, pdst_fields.hasKey("description"), "PronunciationDictionarySummaryDataType has description");

        # Test PronunciationDictionaryLocatorType
        auto pdlt = new ElevenLabsDataProvider::ElevenLabsPronunciationDictionaryLocatorType();
        *hash<string, AbstractDataField> pdlt_fields = pdlt.getFields();
        assertEq(True, pdlt_fields.hasKey("pronunciation_dictionary_id"),
            "PronunciationDictionaryLocatorType has pronunciation_dictionary_id");
        assertEq(True, pdlt_fields.hasKey("version_id"),
            "PronunciationDictionaryLocatorType has version_id");

        # Test PronunciationRuleType
        auto prt = new ElevenLabsDataProvider::ElevenLabsPronunciationRuleType();
        *hash<string, AbstractDataField> prt_fields = prt.getFields();
        assertEq(True, prt_fields.hasKey("type"), "PronunciationRuleType has type");
        assertEq(True, prt_fields.hasKey("string_to_replace"), "PronunciationRuleType has string_to_replace");
        assertEq(True, prt_fields.hasKey("alias"), "PronunciationRuleType has alias");
        assertEq(True, prt_fields.hasKey("phoneme"), "PronunciationRuleType has phoneme");
        assertEq(True, prt_fields.hasKey("alphabet"), "PronunciationRuleType has alphabet");
    }

    testTextToSpeech() {
        fake.response_body = binary("fake audio data");
        fake.response_content_type = "audio/mpeg";

        AbstractDataProvider tts = dp.getChildProvider("text-to-speech");
        assertEq(True, exists tts, "text-to-speech provider exists");

        # Verify request type has expected fields
        *AbstractDataProviderType reqType = tts.getRequestType();
        assertEq(True, exists reqType, "request type exists");
        *hash<string, AbstractDataField> fields = reqType.getFields();
        assertEq(True, fields.hasKey("voice_id"), "has voice_id field");
        assertEq(True, fields.hasKey("text"), "has text field");
        assertEq(True, fields.hasKey("model_id"), "has model_id field");
        assertEq(True, fields.hasKey("output_format"), "has output_format field");
        assertEq(True, fields.hasKey("voice_settings"), "has voice_settings field");
        assertEq(True, fields.hasKey("speed"), "has speed field");
        assertEq(True, fields.hasKey("previous_text"), "has previous_text field");
        assertEq(True, fields.hasKey("next_text"), "has next_text field");
        assertEq(True, fields.hasKey("apply_text_normalization"), "has apply_text_normalization field");
        assertEq(True, fields.hasKey("pronunciation_dictionary_locators"),
            "has pronunciation_dictionary_locators field");

        # Make a request
        hash<auto> result = tts.doRequest({
            "voice_id": "test-voice-id",
            "text": "Hello, world!",
        });

        assertEq("POST", fake.last_method);
        assertEq(True, fake.last_path =~ /text-to-speech\/test-voice-id/, "path contains voice_id");
        # doRawPost sends JSON through the connection manager, so check the raw body
        assertEq(True, exists fake.last_multipart_body, "raw body was sent");
        hash<auto> sent = parse_json(binary_to_string(fake.last_multipart_body));
        assertEq("Hello, world!", sent.text);
        assertEq(True, exists result.audio, "result has audio");
        assertEq("audio/mpeg", result.content_type, "result has correct content_type");
    }

    testSpeechToSpeech() {
        fake.response_body = binary("fake converted audio");
        fake.response_content_type = "audio/mpeg";

        AbstractDataProvider sts = dp.getChildProvider("speech-to-speech");
        assertEq(True, exists sts, "speech-to-speech provider exists");

        # Verify request type has file_format field
        *AbstractDataProviderType stsReqType = sts.getRequestType();
        *hash<string, AbstractDataField> stsFields = stsReqType.getFields();
        assertEq(True, stsFields.hasKey("file_format"), "STS has file_format field");

        hash<auto> result = sts.doRequest({
            "voice_id": "test-voice-id",
            "audio": binary("fake audio input"),
        });

        assertEq("POST", fake.last_method);
        assertEq(True, fake.last_path =~ /speech-to-speech\/test-voice-id/, "path contains voice_id");
        assertEq(True, exists result.audio, "result has audio");
        # Verify multipart body was sent
        assertEq(True, exists fake.last_multipart_body, "multipart body was sent");
    }

    testSpeechToText() {
        # Response comes through connection manager as binary JSON
        fake.response_body = binary(make_json({
            "text": "Hello, world!",
            "language_code": "en",
            "language_probability": 0.99,
        }));

        AbstractDataProvider stt = dp.getChildProvider("speech-to-text");
        assertEq(True, exists stt, "speech-to-text provider exists");

        hash<auto> result = stt.doRequest({
            "audio": binary("fake audio"),
        });

        # Verify request type has new fields
        *AbstractDataProviderType sttReqType = stt.getRequestType();
        *hash<string, AbstractDataField> sttFields = sttReqType.getFields();
        assertEq(True, sttFields.hasKey("num_speakers"), "STT has num_speakers field");
        assertEq(True, sttFields.hasKey("file_format"), "STT has file_format field");

        assertEq("POST", fake.last_method);
        assertEq(True, fake.last_path =~ /speech-to-text/, "path contains speech-to-text");
        assertEq("Hello, world!", result.text, "result has correct text");
        assertEq("en", result.language_code, "result has correct language_code");
        # Verify multipart body was sent (contains the 'file' field, not 'audio')
        assertEq(True, exists fake.last_multipart_body, "multipart body was sent");
    }

    testTextToSoundEffects() {
        fake.response_body = binary("fake sound effect");
        fake.response_content_type = "audio/mpeg";

        AbstractDataProvider sfx = dp.getChildProvider("text-to-sound-effects");
