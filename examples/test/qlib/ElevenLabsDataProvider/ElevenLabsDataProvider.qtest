        assertEq("POST", fake.last_method);
        assertEq(True, fake.last_path =~ /audio-isolation/, "path contains audio-isolation");
        assertEq(True, exists result.audio, "result has audio");
        assertEq(True, exists fake.last_multipart_body, "multipart body was sent");
    }

    testListVoices() {
        fake.response_body = {
            "voices": (
                {
                    "voice_id": "v1",
                    "name": "Test Voice",
                    "category": "premade",
                },
            ),
            "has_more": False,
        };

        AbstractDataProvider voices = dp.getChildProvider("voices");
        assertEq(True, exists voices, "voices provider exists");

        hash<auto> result = voices.doRequest({});

        assertEq("GET", fake.last_method);
        assertEq(True, fake.last_path =~ /v2\/voices/, "path uses v2/voices");
        assertEq(1, result.voices.size(), "result has one voice");
        assertEq("v1", result.voices[0].voice_id, "voice has correct voice_id");
    }

    testGetVoice() {
        fake.response_body = {
            "voice_id": "test-id",
            "name": "Test Voice",
            "category": "premade",
            "samples": (
                {
                    "sample_id": "s1",
                    "file_name": "sample.mp3",
                    "mime_type": "audio/mpeg",
                    "size_bytes": 1024,
                },
            ),
            "settings": {
                "stability": 0.5,
                "similarity_boost": 0.75,
            },
        };

        AbstractDataProvider getVoice = dp.getChildProvider("get-voice");
        assertEq(True, exists getVoice, "get-voice provider exists");

        # Verify response type has typed samples and settings fields
        *AbstractDataProviderType respType = getVoice.getResponseType();
        *hash<string, AbstractDataField> resp_fields = respType.getFields();
        assertEq(True, resp_fields.hasKey("samples"), "response has samples field");
        assertEq(True, resp_fields.hasKey("settings"), "response has settings field");

        hash<auto> result = getVoice.doRequest({
            "voice_id": "test-id",
        });

        assertEq("GET", fake.last_method);
        assertEq(True, fake.last_path =~ /v1\/voices\/test-id/, "path contains voice_id");
        assertEq("Test Voice", result.name, "result has correct name");
