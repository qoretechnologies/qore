    testCreateDubbing() {
        fake.response_body = binary(make_json({
            "dubbing_id": "dub-123",
            "expected_duration_sec": 30.0,
        }));

        AbstractDataProvider dubbing = dp.getChildProvider("create-dubbing");
        assertEq(True, exists dubbing, "create-dubbing provider exists");

        hash<auto> result = dubbing.doRequest({
            "name": "Test Dubbing",
            "source_lang": "en",
            "target_lang": "es",
        });

        # Verify request type has new dubbing fields
        *AbstractDataProviderType dubReqType = dubbing.getRequestType();
        *hash<string, AbstractDataField> dubFields = dubReqType.getFields();
        assertEq(True, dubFields.hasKey("start_time"), "dubbing has start_time field");
        assertEq(True, dubFields.hasKey("end_time"), "dubbing has end_time field");
        assertEq(True, dubFields.hasKey("use_profanity_filter"), "dubbing has use_profanity_filter field");

        assertEq("POST", fake.last_method);
        assertEq(True, fake.last_path =~ /v1\/dubbing/, "path contains v1/dubbing");
        assertEq("dub-123", result.dubbing_id, "result has correct dubbing_id");
        assertEq(True, exists fake.last_multipart_body, "multipart body was sent");
    }

