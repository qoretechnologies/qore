#!/usr/bin/env qore

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/FsUtil.qm
%requires ../../../../qlib/QUnit.qm

%new-style
%require-types
%enable-all-warnings

%exec-class PathExistsTest

public class PathExistsTest inherits QUnit::Test {

    constructor() : Test ("PathExistsTest", "1.0") {
        addTestCase("Basic path_exists test", \test_basic());
        addTestCase("Symlink tests", \test_symlinks());
        addTestCase("Edge cases", \test_edge_cases());
        set_return_value(main());
    }

    test_basic() {
        # Create a temporary directory
        string tmp_dir = make_tmp_dir();
        on_exit remove_tree(tmp_dir);

        assertTrue(path_exists(tmp_dir));
        assertFalse(path_exists(join_paths(tmp_dir, "non-existent.txt")));

        # Create a file
        hash<TmpFileHash> tmp_file = make_tmp_file(NOTHING, NOTHING, tmp_dir);
        tmp_file.file.close();
        assertTrue(path_exists(tmp_file.path));

        # Remove the file
        unlink(tmp_file.path);
        assertFalse(path_exists(tmp_file.path));
    }

    test_symlinks() {
        string tmp_dir = make_tmp_dir();
        on_exit remove_tree(tmp_dir);

        # Create a file
        hash<TmpFileHash> tmp_file = make_tmp_file(NOTHING, NOTHING, tmp_dir);
        tmp_file.file.close();

        # Create a link to that file
        string tmp_link = join_paths(tmp_dir, "link");
        symlink(tmp_file.path, tmp_link);
        assertTrue(path_exists(tmp_link));
        assertTrue(path_exists(tmp_link, True));  # follow_symlinks

        # Remove the file (but keep the link - now a dangling symlink)
        unlink(tmp_file.path);
        assertFalse(path_exists(tmp_file.path));
        assertTrue(path_exists(tmp_link));  # Link itself exists
        assertFalse(path_exists(tmp_link, True));  # But target doesn't

        # Remove the link
        unlink(tmp_link);
        assertFalse(path_exists(tmp_link));
    }

    test_edge_cases() {
        # Root directory should exist
        assertTrue(path_exists("/"));
        assertTrue(path_exists("/tmp"));

        # Non-existent paths
        assertFalse(path_exists("/nonexistent_path_12345"));
        assertFalse(path_exists(""));

        # Current directory
        assertTrue(path_exists("."));
        assertTrue(path_exists(".."));
    }
}
