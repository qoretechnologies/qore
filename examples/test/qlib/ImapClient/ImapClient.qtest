#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires Mime
%requires MailMessage
%requires ConnectionProvider
%requires ImapClient
%requires QUnit

%exec-class ImapClientTest

#! Mock IMAP4rev1 server driving the client through complete command sequences
class MockImapServer {
