#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%allow-injection

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/DataProvider
%requires ../../../../qlib/AwsRestClientDataProvider

%try-module json
%define NoJson
%endtry

%exec-class AwsRestClientDataProviderTest

public class AwsRestClientDataProviderTest inherits QUnit::Test {
    constructor() : Test("AwsRestClientDataProvider Test", "1.0") {
        addTestCase("test", \httpClientDataProviderTest());

        # Return for compatibility with test harness that checks return value.
        set_return_value(main());
    }

    private checkModule() {
%ifdef NoJson
        testSkip("no json module");
%endif
    }

    httpClientDataProviderTest() {
        checkModule();
        # missing required AWS options must be reported precisely
        assertThrows("AWSRESTCLIENT-ERROR", "missing required option",
            sub () { AwsRestClientDataProvider parent({"url": "http://localhost:1"}); });

        # with required options supplied, construction succeeds and the object
        # is wired up to an AwsRestClientIo (no connect is attempted until a
        # request is issued)
        hash<auto> opts = {
            "url": "http://localhost:1",
            "aws_keyid": "test",
            "aws_secret": "test",
            "aws_region": "us-east-1",
            "aws_service": "iam",
        };
        {
            AwsRestClientDataProvider parent(opts);
            assertEq("rest", parent.getName());
        }
        assertEq("call", (new AwsRestClientCallDataProvider(opts)).getName());
        assertEq("delete", (new AwsRestClientDeleteDataProvider(opts)).getName());
        assertEq("get", (new AwsRestClientGetDataProvider(opts)).getName());
        assertEq("head", (new AwsRestClientHeadDataProvider(opts)).getName());
        assertEq("options", (new AwsRestClientOptionsDataProvider(opts)).getName());
        assertEq("post", (new AwsRestClientPostDataProvider(opts)).getName());
        assertEq("put", (new AwsRestClientPutDataProvider(opts)).getName());
        assertEq("patch", (new AwsRestClientPatchDataProvider(opts)).getName());
    }
}
