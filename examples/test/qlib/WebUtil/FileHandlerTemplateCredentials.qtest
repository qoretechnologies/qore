#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires FsUtil
%requires HttpServer
%requires HttpServerUtil
%requires WebUtil

%exec-class FileHandlerTemplateCredentialsTest

#! a hang guard only, never a timing assertion
const HangGuard = 20s;

#! Template code that is restricted gets the request context without the credentials of the request (qore#7303)
/** A template of a FileHandler of trusted code whose Program setup code is of a %Program that a sandbox that does not
    trust its code governs, or whose template Program is governed so, gets the context argument without the
    credentials of the request, with the keys of the handler; a template without setup code, or with trusted setup
    code, gets the request as the server has it
*/
class FileHandlerTemplateCredentialsTest inherits QUnit::Test {
    public {
        #! the template: renders what of the credentials of the request it saw
        const Template = "authorization={{ sprintf(\"%y\", exists $ctx.hdr.authorization) }} "
            "cookie={{ sprintf(\"%y\", exists $ctx.hdr.cookie) }} "
            "cx.auth={{ sprintf(\"%y\", exists $ctx.auth) }} "
            "logger={{ sprintf(\"%y\", $ctx.hasKey(\"logger\")) }} "
            "listener={{ sprintf(\"%y\", $ctx.hasKey(\"listener\")) }} "
            "resource_path={{ sprintf(\"%y\", $ctx.resource_path) }} "
            "url_root={{ sprintf(\"%y\", exists $ctx.url_root) }}";

        #! what restricted template code gets
        const Filtered = "authorization=False cookie=False cx.auth=False logger=False listener=False "
            "resource_path=\"t.qhtml\" url_root=True";

        #! what trusted template code gets
        const Raw = "authorization=True cookie=True cx.auth=True logger=True listener=False "
            "resource_path=\"t.qhtml\" url_root=True";

        #! the tenant's Program setup code
        const TenantSource = "%modern
code sub get_setup() {
    return sub (Program p) {};
}
";
    }

    private {
        TmpDir dir();
    }

    constructor() : Test("FileHandlerTemplateCredentialsTest", "1.0", \ARGV) {
        addTestCase("restricted Program setup code", \restrictedSetupTest());
        addTestCase("a restricted template Program", \restrictedProgramTest());
        addTestCase("trusted Program setup code", \trustedSetupTest());
        addTestCase("no Program setup code", \noSetupTest());
        set_return_value(main());
    }

    globalSetUp() {
        File f();
        f.open2(dir.path + DirSep + "t.qhtml", O_CREAT | O_WRONLY | O_TRUNC);
        f.write(Template);
        f.close();
    }

    #! returns the tenant's Program with the given sandbox
    private Program getTenant(*SandboxManager sm) {
        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        if (sm) {
            p.setSandboxManager(sm);
        }
        p.parse(TenantSource, "tenant");
        return p;
    }

    #! requests the template with credentials; returns the body
    private string request(FileHandler handler) {
        HttpServer server(<HttpServerOptionInfo>{});
        on_exit server.stop();
        server.setDefaultHandler("files", handler);
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        server.waitForAsyncIo();
        Socket c();
        c.connect("127.0.0.1:" + port, HangGuard);
        on_exit c.close();
        c.send("GET /t.qhtml HTTP/1.1\r\nHost: localhost\r\nAuthorization: Bearer secret\r\n"
            "Cookie: session=secret\r\n\r\n");
        hash<auto> h = c.readHTTPHeader(HangGuard);
        assertEq(200, h.status_code, "the template is rendered");
        return c.recv(h."content-length".toInt(), HangGuard);
    }

    restrictedSetupTest() {
        # the default sandbox does not trust its code
        Program p = getTenant(new SandboxManager());
        FileHandler h(dir.path, "/", {"psetup": p.callFunction("get_setup")});
        assertEq(Filtered, request(h), "restricted setup code");
    }

    restrictedProgramTest() {
        # trusted setup code that puts the template Program in a sandbox that does not trust its code
        FileHandler h(dir.path, "/", {"psetup": sub (Program p) { p.setSandboxManager(new SandboxManager()); }});
        assertEq(Filtered, request(h), "a restricted template Program");
    }

    trustedSetupTest() {
        # the Program is kept for its code
        Program p = getTenant();
        FileHandler h(dir.path, "/", {"psetup": p.callFunction("get_setup")});
        assertEq(Raw, request(h), "trusted setup code");
    }

    noSetupTest() {
        FileHandler h(dir.path, "/");
        assertEq(Raw, request(h), "no setup code");
    }
}
