#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/ConnectionProvider
%requires ../../../../qlib/QoreRagTypes.qm
%requires ../../../../qlib/QoreRagUtils
%requires ../../../../qlib/MongoDbDataProvider

%exec-class MongoAtlasVectorStoreTest

public class MongoAtlasVectorStoreTest inherits QUnit::Test {
    public {
        const MyOpts = Opts + {
            "conn": "c,connection=s",
        };

        const OptionColumn = 22;
    }

    private {
        *string conn_name;
    }

    constructor() : Test("MongoAtlasVectorStore Test", "1.0", \ARGV, MyOpts) {
        conn_name = m_options.conn ?? ENV.MONGODB_ATLAS_CONNECTION;

        addTestCase("factory registered + lazy-loadable",   \factoryTest());
        addTestCase("constructor validates required config", \constructorValidationTest());
        addTestCase("constructor accepts full config",       \constructorOkTest());
        addTestCase("vector-search action wired into collection ChildMap",
            \childMapTest());

        # Live test requires a real MongoDB Atlas connection AND
        # `MONGODB_ATLAS_COLLECTION`, `MONGODB_ATLAS_DATABASE`, and
        # `MONGODB_ATLAS_INDEX_NAME` env vars naming an existing
        # collection with a configured Atlas Vector Search index.
        # Cost: MongoDB Atlas M0 free-tier eligible if the index is
        # configured.
        if (conn_name) {
            addTestCase("live: ping + vector-search (existing collection + "
                "index)", \liveMongoAtlasTest());
        }
        set_return_value(main());
    }

    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-c,--connection=ARG",
            "set the MongoDB Atlas connection name; without it (and without "
            "the MONGODB_ATLAS_CONNECTION env var) the live test is "
            "skipped.  Also requires MONGODB_ATLAS_COLLECTION, "
            "MONGODB_ATLAS_DATABASE, and MONGODB_ATLAS_INDEX_NAME naming "
            "an existing collection with an Atlas Vector Search index.",
            OptionColumn);
    }

    private factoryTest() {
        QoreRagUtils::AbstractVectorStoreFactory f =
            QoreRagUtils::RagProviderRegistry::getVectorStoreFactoryEx("mongo-atlas");
        assertEq("mongo-atlas", f.getType());
        assertEq("MongoDB Atlas Vector Search", f.getDisplayName());
        assertEq("MongoDbDataProvider", f.getInfo().module_name);
    }

    private constructorValidationTest() {
        # missing collection
        assertThrows("VECTOR-STORE-CONFIG-ERROR", sub () {
            new QoreRagUtils::MongoAtlasVectorStore(<QoreRagUtils::VectorStoreConfig>{
                "backend": "mongo-atlas",
                "url": "mongodb://localhost:27017",
                "options": {"database": "test", "index_name": "idx"},
            });
        });
        # missing url
        assertThrows("VECTOR-STORE-CONFIG-ERROR", sub () {
            new QoreRagUtils::MongoAtlasVectorStore(<QoreRagUtils::VectorStoreConfig>{
                "backend": "mongo-atlas",
                "collection": "embeddings",
                "options": {"database": "test", "index_name": "idx"},
            });
        });
        # missing database
        assertThrows("VECTOR-STORE-CONFIG-ERROR", sub () {
            new QoreRagUtils::MongoAtlasVectorStore(<QoreRagUtils::VectorStoreConfig>{
                "backend": "mongo-atlas",
                "collection": "embeddings",
                "url": "mongodb://localhost:27017",
                "options": {"index_name": "idx"},
            });
        });
        # missing index_name
        assertThrows("VECTOR-STORE-CONFIG-ERROR", sub () {
            new QoreRagUtils::MongoAtlasVectorStore(<QoreRagUtils::VectorStoreConfig>{
                "backend": "mongo-atlas",
                "collection": "embeddings",
                "url": "mongodb://localhost:27017",
                "options": {"database": "test"},
            });
        });
    }

    private constructorOkTest() {
        QoreRagUtils::MongoAtlasVectorStore store(<QoreRagUtils::VectorStoreConfig>{
            "backend": "mongo-atlas",
            "collection": "embeddings",
            "url": "mongodb://localhost:27017/test",
            "options": {
                "database": "test",
                "index_name": "embeddings_vector_idx",
                "embedding_path": "vec",
                "dimension": 1536,
            },
        });
        # constructor lazy-defers client creation; getCollection works
        assertEq("embeddings", store.getCollection());
        # dimension supplied in config, no probe needed
        assertEq(1536, store.getDimension());
    }

    private childMapTest() {
        # MongoDbCollectionDataProvider's ChildMap should have a "vector-search"
        # entry pointing at MongoDbVectorSearchDataProvider — exercise by class
        # lookup since instantiation requires a real MongoCollection
        Class vs_cls = Class::forName(
            "MongoDbDataProvider::MongoDbVectorSearchDataProvider");
        assertEq("MongoDbVectorSearchDataProvider", vs_cls.getName());

        # Request-type class is constructable
        MongoDbDataProvider::MongoDbVectorSearchRequestDataType t();
        assertTrue(t instanceof DataProvider::HashDataType);
    }

    #! Exercises MongoAtlasVectorStore against a real Atlas cluster
    /** Verifies the actual wire format against MongoDB Atlas — including
        the `$vectorSearch` aggregation stage and the configured Atlas
        Vector Search index.  Requires a connection name AND env vars
        naming an existing collection + database + index_name.  The
        query embedding dimension is derived from the collection's
        stored vectors via `getDimension()`; the test sends a zero-vector
        of that length and asserts the response shape, not content.

        Cost: MongoDB Atlas M0 free-tier eligible if the vector index
        is configured.
    */
    private liveMongoAtlasTest() {
        *string coll = ENV.MONGODB_ATLAS_COLLECTION;
        *string db_name = ENV.MONGODB_ATLAS_DATABASE;
        *string idx_name = ENV.MONGODB_ATLAS_INDEX_NAME;
        if (!coll.val() || !db_name.val() || !idx_name.val()) {
            testSkip("MONGODB_ATLAS_COLLECTION, MONGODB_ATLAS_DATABASE, and "
                "MONGODB_ATLAS_INDEX_NAME env vars must all be set for the "
                "live test");
        }

        AbstractConnection conn = get_connection(conn_name);
        hash<auto> ping = conn.ping(True);
        assertTrue(ping.ok, sprintf("MongoDB Atlas connection ping failed: %s",
            ping.info ?? "no info"));

        QoreRagUtils::MongoAtlasVectorStore store(
            <QoreRagUtils::VectorStoreConfig>{
                "backend":    "mongo-atlas",
                "collection": coll,
                "url":        conn.getUrl(),
                "options":    {
                    "database":   db_name,
                    "index_name": idx_name,
                },
            });
        # Probe stored-vector dimension from the collection — Atlas
        # rejects $vectorSearch queries whose vector length does not
        # match the index dimension
        int dim = store.getDimension();
        assertTrue(dim > 0, "MongoAtlas getDimension() probed a dimension");

        list<float> query = map 0.0, xrange(dim);
        list<hash<QoreRagUtils::VectorSearchResult>> hits =
            store.search(query, 1);
        # Atlas may return zero hits if the collection is empty;
        # verify the result is a (possibly empty) list — i.e. the
        # `$vectorSearch` stage was accepted by the server
        assertTrue(hits.typeCode() == NT_LIST,
            "MongoAtlas vector-search returned a list");
    }
}
