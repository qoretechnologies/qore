#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Qorize.qm
%requires ../../../../qlib/SqlUtil
%requires ../../../../qlib/Schema
%requires ../../../../qlib/SchemaReverse.qm

%try-module yaml
%define NoYaml
%endtry

%try-module json
%define NoJson
%endtry

%exec-class Main

#
# NOTE: SchemaReverse automatically creates hashes and strings. So the reference
#       (REF_...) constants must be more strict than in user code.
#       Ex: if there is something like string or list, list should be used:
#       ("columns" : ("id",), "unique" : True))...
#
our hash REF_TABLE;
our hash REF_SCHEMA;

class Main inherits QUnit::Test {
    private {
        const LOCAL_OPTS = Opts + (
            "connstr": "c,conn=s",
        );

        Datasource m_ds;
        Database m_db;
    }

    constructor() : QUnit::Test("SchemaReverseTest", "1.0", \ARGV, LOCAL_OPTS) {
        addTestCase("schema reverse - table", \testSchemaReverseTable());
        addTestCase("schema reverse - tables", \testSchemaReverseTables());
        addTestCase("schema reverse - sequence", \testSchemaReverseSequence());
        addTestCase("schema reverse - sequences", \testSchemaReverseSequences());
        addTestCase("schema reverse - toYaml", \testSchemaReverseToYaml());
        addTestCase("schema reverse - toJson", \testSchemaReverseToJson());
        addTestCase("schema reverse - full toQore", \testSchemaReverseFullToQore());

        set_return_value(main());
    }

    private globalMakeSchema(string method) {
        if (!m_ds)
            return;
        on_exit m_ds.commit();
        list<auto> sql = call_object_method(m_db, method, REF_SCHEMA);
        ListIterator it(sql);
        while (it.next()) {
            m_ds.exec(it.getValue());
        }
    }

    globalSetUp() {
        try {
            if (!m_options.connstr) {
                m_options.connstr = ENV.QORE_DB_CONNSTR
                    ? ENV.QORE_DB_CONNSTR
                    : (ENV.QORE_DB_CONNSTR_ORACLE
                        ? ENV.QORE_DB_CONNSTR_ORACLE
                        : ENV.QORE_DB_CONNSTR_PGSQL);
            }

            m_ds = new Datasource(m_options.connstr);
            m_ds.open();
            m_db = new Database(m_ds);
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose)
                printf("%s: %s\n", ex.err, ex.desc);
            delete m_ds;
            return;
        }

        REF_TABLE = (
            "columns" : (
                "id" : c_number(C_NOT_NULL, "comment for id"),
                "foo" : c_varchar(10, C_NULL, "comment for foo"),
                "bar" : c_date(C_NOT_NULL, "comment for bar"),
            ),
            "indexes" : ( "schema_reverse_ix1" : ("columns" : ("id",), "unique" : True)),
        );
        # named types data
        if (m_ds.getDriverName() == "oracle") {
            REF_TABLE.columns.loc_col = ( "driver" : ( "oracle" : ("native_type" : "sdo_geometry", "notnull" : False )));
        }

        REF_SCHEMA = (
            "sequences" : (
                "schema_reverse_seq" : hash(),
            ),
            "tables" : (
                "schema_reverse_t1" : REF_TABLE,
            ),
        );

        globalMakeSchema("getAlignSql");
    }

    globalTearDown() {
        globalMakeSchema("getDropSchemaSql");
    }

    testSchemaReverseTable() {
        if (!m_ds)
            testSkip("no DB connection");

        TableReverse r(m_ds, "schema_reverse_t1");
        hash q = r.toQore();
        assertEq(REF_TABLE, q, "TableReverse::toQore()");
    }

    testSchemaReverseTables() {
        if (!m_ds)
            testSkip("no DB connection");

        TablesReverse r(m_ds, "schema_reverse_t1");
        hash q = r.toQore();
        assertEq(REF_SCHEMA.tables, q, "TableReverse::toQore()");
    }

    testSchemaReverseSequence() {
        if (!m_ds)
            testSkip("no DB connection");

        SequenceReverse r(m_ds, "schema_reverse_seq");
        hash q = r.toQore();
        assertEq(REF_SCHEMA.sequences.schema_reverse_seq, q, "SequenceReverse::toQore()");
    }

    testSchemaReverseSequences() {
        if (!m_ds) {
            testSkip("no DB connection");
        }

        SequencesReverse r(m_ds, "schema_reverse_seq");
        hash q = r.toQore();
        assertEq(REF_SCHEMA.sequences, q, "SequencesReverse::toQore()");
    }

    testSchemaReverseToYaml() {
%ifdef NoYaml
        testSkip("yaml module not available");
%else
        if (!m_ds) {
            testSkip("no DB connection");
        }

        SchemaReverse rev(m_ds, "TestSchema");
        string yaml_output = rev.toYaml();
        assertTrue(yaml_output.size() > 0, "toYaml() returns non-empty string");
        assertTrue(yaml_output.contains("schema_reverse_t1"), "YAML contains table name");
        assertTrue(yaml_output.contains("schema_reverse_seq"), "YAML contains sequence name");

        # Verify it's parseable YAML
        auto parsed = parse_yaml(yaml_output);
        assertEq("hash", parsed.type(), "parsed YAML is a hash");
        assertTrue(parsed.hasKey("schema"), "parsed YAML has 'schema' key");
        assertEq("TestSchema", parsed.schema.name, "schema name matches");

        # TableReverse toYaml
        TableReverse tr(m_ds, "schema_reverse_t1");
        string table_yaml = tr.toYaml();
        assertTrue(table_yaml.size() > 0, "TableReverse.toYaml() returns non-empty");
        auto parsed_table = parse_yaml(table_yaml);
        assertEq("hash", parsed_table.type(), "parsed table YAML is a hash");
        assertTrue(parsed_table.hasKey("columns"), "table YAML has columns");
%endif
    }

    testSchemaReverseToJson() {
%ifdef NoJson
        testSkip("json module not available");
%else
        if (!m_ds) {
            testSkip("no DB connection");
        }

        SchemaReverse rev(m_ds, "TestSchema");
        string json_output = rev.toJson();
        assertTrue(json_output.size() > 0, "toJson() returns non-empty string");
        assertTrue(json_output.contains("schema_reverse_t1"), "JSON contains table name");

        # Verify it's parseable JSON
        auto parsed = parse_json(json_output);
        assertEq("hash", parsed.type(), "parsed JSON is a hash");
        assertTrue(parsed.hasKey("schema"), "parsed JSON has 'schema' key");
        assertEq("TestSchema", parsed.schema.name, "schema name matches");
%endif
    }

    testSchemaReverseFullToQore() {
        if (!m_ds) {
            testSkip("no DB connection");
        }

        SchemaReverse rev(m_ds, "TestSchema");
        hash<auto> qore_data = rev.toQore();

        # Verify structure
        assertTrue(qore_data.hasKey("schema"), "toQore has schema");
        assertTrue(qore_data.hasKey("tables"), "toQore has tables");
        assertTrue(qore_data.hasKey("sequences"), "toQore has sequences");
        assertEq("TestSchema", qore_data.schema.name, "schema name");
        assertTrue(qore_data.tables.hasKey("schema_reverse_t1"), "tables has test table");
        assertTrue(qore_data.sequences.hasKey("schema_reverse_seq"), "sequences has test seq");

        # Verify table columns match
        hash<auto> table_data = qore_data.tables.schema_reverse_t1;
        assertTrue(table_data.hasKey("columns"), "table has columns");
        assertTrue(table_data.columns.hasKey("id"), "table has id column");
        assertTrue(table_data.columns.hasKey("foo"), "table has foo column");
        assertTrue(table_data.columns.hasKey("bar"), "table has bar column");
    }
} # class Main
