#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-parallel: serial - it reverses the whole shared Oracle and FreeTDS test schemas

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires Qorize
%requires SqlUtil
%requires Schema
%requires SchemaReverse

%requires yaml

%requires json

# a run on PostgreSQL has its own schema
%requires ../SqlUtil/PgsqlTestIsolation.qm
# the test runs against every database connection that is configured
%requires ../../DbTestConnections.qm
%requires ../SqlUtil/MysqlTestIsolation.qm

%exec-class Main

#! the tables and sequences that a connection's test cases create and reverse, and the connection
class SchemaReverseContext {
    public {
        #! the connection
        hash<DbTestConnection> conn;

        #! the open connection, or @ref nothing if it could not be opened
        *Datasource ds;

        #! the reason the connection's test cases are skipped, if it is not open
        string skip_reason = "the connection is not open";

        #! the schema that is created: a table and a sequence
        /** SchemaReverse creates hashes and strings, so the reference values must be more strict than in user
            code: a list where a string would do in user code, as in <tt>("columns": ("id",), "unique": True)</tt>
        */
        hash<auto> ref_schema;

        #! the description that TableReverse gives for the table: its description, but for what the server makes
        #! of its columns
        hash<auto> ref_table_reverse;

        #! the error that creating the schema raised, if any
        *hash<ExceptionInfo> setup_error;
    }

    constructor(hash<DbTestConnection> conn) {
        self.conn = conn;
    }

    #! returns the name of the connection's test case
    string name(string test) {
        return sprintf("%s (%s): %s", conn.label, conn.driver ?? "unknown driver", test);
    }
}

#! tests SchemaReverse against every database connection that is configured (see DbTestConnections)
class Main inherits QUnit::Test {
    private {
        const LOCAL_OPTS = Opts + (
            "connstr": "c,conn=s",
        );

        #! the drivers whose reverse output the test knows
        const Drivers = ("oracle", "pgsql", "mysql");

        #! the test's connections
        list<SchemaReverseContext> contexts = ();
    }

    constructor() : QUnit::Test("SchemaReverseTest", "1.0", \ARGV, LOCAL_OPTS) {
        contexts = map new SchemaReverseContext($1), DbTestConnections::get(m_options.connstr);
        if (!contexts) {
            addTestCase("schema reverse", sub () { testSkip("no DB connection"); });
        }
        foreach SchemaReverseContext ctx in (contexts) {
            addTestCase(ctx.name("schema reverse - table"), \testSchemaReverseTable(), ctx);
            addTestCase(ctx.name("schema reverse - tables"), \testSchemaReverseTables(), ctx);
            addTestCase(ctx.name("schema reverse - sequence"), \testSchemaReverseSequence(), ctx);
            addTestCase(ctx.name("schema reverse - sequences"), \testSchemaReverseSequences(), ctx);
            addTestCase(ctx.name("schema reverse - toYaml"), \testSchemaReverseToYaml(), ctx);
            addTestCase(ctx.name("schema reverse - toJson"), \testSchemaReverseToJson(), ctx);
            addTestCase(ctx.name("schema reverse - full toQore"), \testSchemaReverseFullToQore(), ctx);
            addTestCase(ctx.name("schema reverse - filtered toQore"), \testSchemaReverseFilteredToQore(), ctx);
        }

        set_return_value(main());
    }

    private static makeSchema(SchemaReverseContext ctx, string method) {
        if (!ctx.ds) {
            return;
        }
        on_exit ctx.ds.commit();
        Database db(ctx.ds);
        list<auto> sql = call_object_method(db, method, ctx.ref_schema);
        map ctx.ds.exec($1), sql;
    }

    globalSetUp() {
        # on PostgreSQL, every connection of the run uses the run's own schema; this is set up before any
        # connection is opened
        map PgsqlRunSchema::setup($1.conn.connstr, "SchemaReverse"), contexts;
        # on MySQL, the run's own database
        foreach SchemaReverseContext ctx in (contexts) {
            ctx.conn.connstr = MysqlRunDatabase::getConnectionString(ctx.conn.connstr, "SchemaReverse");
        }
        map setUpContext($1), contexts;
    }

    #! opens the connection and creates its schema; the connection's test cases are skipped if it fails
    private setUpContext(SchemaReverseContext ctx) {
        if (!inlist(ctx.conn.driver, Drivers)) {
            ctx.skip_reason = sprintf("the expected reverse output of driver %y is not known", ctx.conn.driver);
            return;
        }
        try {
            Datasource ds(ctx.conn.connstr);
            ds.open();
            ctx.ds = ds;
        } catch (hash<ExceptionInfo> ex) {
            ctx.skip_reason = sprintf("cannot open the connection: %s: %s", ex.err, ex.desc);
            if (m_options.verbose) {
                printf("%s: %s\n", ctx.conn.label, ctx.skip_reason);
            }
            return;
        }

        string drv = ctx.ds.getDriverName();
        # the columns are added one by one, so that the hash takes a column description of any type, as a literal
        # of column descriptions would take only GenericColumnInfo hashes
        hash<auto> columns = {};
        columns.id = c_number(C_NOT_NULL, "comment for id");
        columns.foo = c_varchar(10, C_NULL, "comment for foo");
        columns.bar = c_date(C_NOT_NULL, "comment for bar");
        hash<auto> ref_table = (
            "columns" : columns,
            "indexes" : ( "schema_reverse_ix1" : ("columns" : ("id",), "unique" : True)),
        );
        # named types data
        if (drv == "oracle") {
            ref_table.columns.loc_col = ( "driver" : ( "oracle" : ("native_type" : "sdo_geometry", "notnull" : False )));
        }
        ctx.ref_table_reverse = ref_table;
        if (drv == "pgsql" || drv == "mysql") {
            # an integer column is a bigint, which TableReverse gives with its native type, and with its comment
            ref_table.columns.cnt = {"qore_type": Type::Int, "notnull": True, "comment": "comment for cnt"};
            ctx.ref_table_reverse.columns.cnt = {
                "driver": {drv: {"native_type": "bigint", "notnull": True}},
                "comment": "comment for cnt",
            };
        }
        if (drv == "mysql") {
            # MySQL has no numeric without a precision: a numeric column without one is decimal(10,0)
            ctx.ref_table_reverse.columns.id.size = 10;
            # MySQL has no date type with a time, as Oracle has: a date column is a timestamp; the c_date() native
            # types are for Oracle and PostgreSQL only
            ctx.ref_table_reverse.columns.bar = c_timestamp(C_NOT_NULL, "comment for bar");
        }

        ctx.ref_schema = (
            "sequences" : (
                "schema_reverse_seq" : hash(),
            ),
            "tables" : (
                "schema_reverse_t1" : ref_table,
            ),
        );

        try {
            makeSchema(ctx, "getAlignSql");
        } catch (hash<ExceptionInfo> ex) {
            # the connection's test cases fail with the error
            ctx.setup_error = ex;
        }
    }

    globalTearDown() {
        foreach SchemaReverseContext ctx in (contexts) {
            try {
                makeSchema(ctx, "getDropSchemaSql");
            } catch (hash<ExceptionInfo> ex) {
                printf("WARNING: %s: cannot drop the test schema: %s: %s\n", ctx.conn.label, ex.err, ex.desc);
            }
        }
        # drop the run's schema on PostgreSQL
        PgsqlRunSchema::teardown();
        MysqlRunDatabase::teardown();
    }

    #! skips the test case if the connection is not open; fails it if its schema could not be created
    private checkContext(SchemaReverseContext ctx) {
        if (!ctx.ds) {
            testSkip(ctx.skip_reason);
        }
        if (*hash<ExceptionInfo> ex = ctx.setup_error) {
            throw ex.err, sprintf("the test schema could not be created: %s", ex.desc), ex.arg;
        }
    }

    testSchemaReverseTable(SchemaReverseContext ctx) {
        checkContext(ctx);

        TableReverse r(ctx.ds, "schema_reverse_t1");
        hash q = r.toQore();
        assertEq(ctx.ref_table_reverse, q, "TableReverse::toQore()");
    }

    testSchemaReverseTables(SchemaReverseContext ctx) {
        checkContext(ctx);

        # the mask is anchored: another schema of the search_path can have a table of this name, listed as
        # "<schema>.schema_reverse_t1"
        TablesReverse r(ctx.ds, "^schema_reverse_t1$");
        hash q = r.toQore();
        assertEq({"schema_reverse_t1": ctx.ref_table_reverse}, q, "TableReverse::toQore()");
    }

    testSchemaReverseSequence(SchemaReverseContext ctx) {
        checkContext(ctx);

        SequenceReverse r(ctx.ds, "schema_reverse_seq");
        hash q = r.toQore();
        assertEq(ctx.ref_schema.sequences.schema_reverse_seq, q, "SequenceReverse::toQore()");
    }

    testSchemaReverseSequences(SchemaReverseContext ctx) {
        checkContext(ctx);

        # the mask is anchored: another schema of the search_path can have a sequence of this name, listed as
        # "<schema>.schema_reverse_seq"
        SequencesReverse r(ctx.ds, "^schema_reverse_seq$");
        hash q = r.toQore();
        assertEq(ctx.ref_schema.sequences, q, "SequencesReverse::toQore()");
    }

    testSchemaReverseToYaml(SchemaReverseContext ctx) {
        checkContext(ctx);

        SchemaReverse rev(ctx.ds, "TestSchema");
        string yaml_output = rev.toYaml();
        assertTrue(yaml_output.size() > 0, "toYaml() returns non-empty string");
        assertTrue(yaml_output.contains("schema_reverse_t1"), "YAML contains table name");
        assertTrue(yaml_output.contains("schema_reverse_seq"), "YAML contains sequence name");

        # Verify it's parseable YAML
        auto parsed = parse_yaml(yaml_output);
        assertEq("hash", parsed.type(), "parsed YAML is a hash");
        assertTrue(parsed.hasKey("schema"), "parsed YAML has 'schema' key");
        assertEq("TestSchema", parsed.schema.name, "schema name matches");

        # TableReverse toYaml
        TableReverse tr(ctx.ds, "schema_reverse_t1");
        string table_yaml = tr.toYaml();
        assertTrue(table_yaml.size() > 0, "TableReverse.toYaml() returns non-empty");
        auto parsed_table = parse_yaml(table_yaml);
        assertEq("hash", parsed_table.type(), "parsed table YAML is a hash");
        assertTrue(parsed_table.hasKey("columns"), "table YAML has columns");
    }

    testSchemaReverseToJson(SchemaReverseContext ctx) {
        checkContext(ctx);

        SchemaReverse rev(ctx.ds, "TestSchema");
        string json_output = rev.toJson();
        assertTrue(json_output.size() > 0, "toJson() returns non-empty string");
        assertTrue(json_output.contains("schema_reverse_t1"), "JSON contains table name");

        # Verify it's parseable JSON
        auto parsed = parse_json(json_output);
        assertEq("hash", parsed.type(), "parsed JSON is a hash");
        assertTrue(parsed.hasKey("schema"), "parsed JSON has 'schema' key");
        assertEq("TestSchema", parsed.schema.name, "schema name matches");
    }

    testSchemaReverseFullToQore(SchemaReverseContext ctx) {
        checkContext(ctx);

        SchemaReverse rev(ctx.ds, "TestSchema");
        hash<auto> qore_data = rev.toQore();

        # Verify structure
        assertTrue(qore_data.hasKey("schema"), "toQore has schema");
        assertTrue(qore_data.hasKey("tables"), "toQore has tables");
        assertTrue(qore_data.hasKey("sequences"), "toQore has sequences");
        assertEq("TestSchema", qore_data.schema.name, "schema name");
        assertTrue(qore_data.tables.hasKey("schema_reverse_t1"), "tables has test table");
        assertTrue(qore_data.sequences.hasKey("schema_reverse_seq"), "sequences has test seq");

        # Verify table columns match
        hash<auto> table_data = qore_data.tables.schema_reverse_t1;
        assertTrue(table_data.hasKey("columns"), "table has columns");
        assertTrue(table_data.columns.hasKey("id"), "table has id column");
        assertTrue(table_data.columns.hasKey("foo"), "table has foo column");
        assertTrue(table_data.columns.hasKey("bar"), "table has bar column");
    }

    testSchemaReverseFilteredToQore(SchemaReverseContext ctx) {
        checkContext(ctx);

        SchemaReverse rev(ctx.ds, "TestSchema");

        # filtering to a single object type yields a complete data-schema document with only that type
        hash<auto> only_tables = rev.toQore({"tables": ".*"});
        assertTrue(only_tables.hasKey("schema"), "filtered export keeps schema metadata");
        assertTrue(only_tables.hasKey("tables"), "filtered export includes the requested object type");
        assertFalse(only_tables.hasKey("sequences"), "filtered export omits unrequested object types");
        assertTrue(only_tables.tables.hasKey("schema_reverse_t1"), "filtered tables include the test table");

        # an object-name mask restricts which objects of that type are exported
        hash<auto> masked = rev.toQore({"sequences": "schema_reverse_seq"});
        assertFalse(masked.hasKey("tables"), "mask export omits tables");
        assertTrue(masked.sequences.hasKey("schema_reverse_seq"), "mask export includes the matching sequence");

        # an empty filter is equivalent to a full export
        assertEq(rev.toQore().tables, rev.toQore({}).tables, "empty filter equals a full export");
    }
} # class Main
