%modern
%enable-all-warnings

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/SshCredentialProvider

%exec-class SshCredentialProviderTest

class TestHostKeyStore inherits SshCredentialProvider::AbstractSshHostKeyStore {
    private hash<SshCredentialProvider::SshHostKeyDecisionInfo> makeDecision(
            enum<SshCredentialProvider::SshHostKeyDecision> decision,
            hash<SshCredentialProvider::SshPublicKeyInfo> observed_key) {
        return <SshCredentialProvider::SshHostKeyDecisionInfo>{
            "decision": decision,
            "observed_key": observed_key,
        };
    }

    private hash<SshCredentialProvider::SshHostKeyDecisionInfo> verifyHostKeyImpl(
            hash<SshCredentialProvider::SshProviderContext> ctxt,
            hash<SshCredentialProvider::SshPublicKeyInfo> observed_key) {
        return makeDecision(SshCredentialProvider::SshHostKeyDecision::Matched, observed_key);
    }

    private hash<SshCredentialProvider::SshHostKeyDecisionInfo> acceptHostKeyIfAbsentImpl(
            hash<SshCredentialProvider::SshProviderContext> ctxt,
            hash<SshCredentialProvider::SshPublicKeyInfo> observed_key) {
        return makeDecision(SshCredentialProvider::SshHostKeyDecision::Added, observed_key);
    }

    private hash<SshCredentialProvider::SshHostKeyDecisionInfo> approveHostKeyImpl(
            hash<SshCredentialProvider::SshProviderContext> ctxt,
            hash<SshCredentialProvider::SshPublicKeyInfo> expected_observed_key,
            hash<SshCredentialProvider::SshHostKeyRecord> record) {
        return makeDecision(SshCredentialProvider::SshHostKeyDecision::AcceptedSession, expected_observed_key);
    }
}

public class SshCredentialProviderTest inherits QUnit::Test {
    constructor() : Test("SshCredentialProvider", "1.0") {
        addTestCase("string-backed enums and exception names", \testEnums());
        addTestCase("host normalization", \testHostNormalization());
        addTestCase("filesystem client identity provider", \testFilesystemClientIdentityProvider());
        addTestCase("filesystem server host-key provider", \testFilesystemServerHostKeyProvider());
        addTestCase("host-key store dispatch", \testHostKeyStoreDispatch());
        addTestCase("provider registry", \testProviderRegistry());

        set_return_value(main());
    }

    private hash<SshCredentialProvider::SshProviderContext> makeContext(
            enum<SshCredentialProvider::SshProviderPurpose> purpose
                = SshCredentialProvider::SshProviderPurpose::HostKeyVerify) {
        int now = clock_getnanos();
        return <SshCredentialProvider::SshProviderContext>{
            "purpose": purpose,
            "connection_name": "test-connection",
            "original_host": "Example.COM.",
            "normalized_host": SshCredentialProvider::normalize_ssh_host("Example.COM."),
            "port": 22,
            "username": "test-user",
            "host_key_policy": "reject",
            "client_auth_order": SshCredentialProvider::SshClientAuthOrder::ExplicitFirst,
            "client_identity_fallback_policy": SshCredentialProvider::SshClientIdentityFallbackPolicy::Disabled,
            "deadline_ns": now + 1000000000,
            "remaining_ns": 1000000000,
            "opaque_context": {"opaque": True},
        };
    }

    private hash<SshCredentialProvider::SshPublicKeyInfo> makePublicKeyInfo() {
        return <SshCredentialProvider::SshPublicKeyInfo>{
            "algorithm": "ssh-ed25519",
            "openssh_public_key": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAITest",
            "sha256_fingerprint": "SHA256:test",
            "source_kind": "transport",
        };
    }

    testEnums() {
        string decision = SshCredentialProvider::SshHostKeyDecision::AcceptedSession;
        assertEq("accepted-session", decision);

        assertEq(SshCredentialProvider::SshHostKeyDecision::InvalidResponse,
            SshCredentialProvider::SshHostKeyDecisionMap{"invalid-response"});
        assertEq("SSH2-HOSTKEY-UNKNOWN", SshCredentialProvider::get_host_key_decision_exception_name(
            SshCredentialProvider::SshHostKeyDecision::Unknown));
        assertEq("SSH-HOSTKEY-PROVIDER-ERROR", SshCredentialProvider::get_host_key_decision_exception_name(
            SshCredentialProvider::SshHostKeyDecision::ProviderError, "SSH"));
        assertEq(NOTHING, SshCredentialProvider::get_host_key_decision_exception_name(
            SshCredentialProvider::SshHostKeyDecision::Matched));
        assertEq(NOTHING, SshCredentialProvider::get_host_key_decision_exception_name(
            SshCredentialProvider::SshHostKeyDecision::Added));
        assertEq(NOTHING, SshCredentialProvider::get_host_key_decision_exception_name(
            SshCredentialProvider::SshHostKeyDecision::AcceptedSession));

        assertThrows("RUNTIME-CAST-ERROR", sub () {
            enum<SshCredentialProvider::SshHostKeyDecision> invalid =
                cast<enum<SshCredentialProvider::SshHostKeyDecision>>("invalid");
            assertEq(SshCredentialProvider::SshHostKeyDecision::Unknown, invalid);
        });
    }

    testHostNormalization() {
        assertEq("example.com", SshCredentialProvider::normalize_ssh_host("Example.COM."));
        assertEq("example.com.", SshCredentialProvider::normalize_ssh_host("Example.COM.."));
        assertEq("täst.example", SshCredentialProvider::normalize_ssh_host("Täst.EXAMPLE."));
        assertEq("example.com", SshCredentialProvider::format_known_hosts_host("Example.COM.", 22));
        assertEq("[example.com]:2222", SshCredentialProvider::format_known_hosts_host("Example.COM.", 2222));
        assertEq("[2001:db8::1]:22", SshCredentialProvider::format_known_hosts_host("2001:DB8::1", 22));
    }

    testFilesystemClientIdentityProvider() {
        SshCredentialProvider::FilesystemSshClientIdentityProvider provider(
            ("/tmp/test-id-ed25519", "/tmp/test-id-rsa"), True, True);
        list<hash<SshCredentialProvider::SshClientIdentityCandidate>> candidates =
            provider.getClientIdentityCandidates(makeContext(SshCredentialProvider::SshProviderPurpose::ClientIdentity));

        assertEq(3, candidates.size());
        assertEq(SshCredentialProvider::SshClientIdentityCandidateKind::Agent, candidates[0].kind);
        assertEq(True, candidates[0].optional);
        assertEq("ssh-agent", candidates[0].comment);
        assertEq(SshCredentialProvider::SshClientIdentityCandidateKind::File, candidates[1].kind);
        assertEq("/tmp/test-id-ed25519", candidates[1].path);
        assertEq(SshCredentialProvider::SshClientIdentityCandidateKind::File, candidates[2].kind);
        assertEq("/tmp/test-id-rsa", candidates[2].path);
        assertEq(NOTHING, provider.getPrivateKeyMaterial(makeContext(), candidates[0]));

        any string_ctxt = {
            "purpose": "client-identity",
            "original_host": "Example.COM.",
            "normalized_host": "example.com",
            "port": 22,
            "username": "test-user",
            "host_key_policy": "reject",
            "client_auth_order": "explicit-first",
            "client_identity_fallback_policy": "disabled",
            "deadline_ns": clock_getnanos() + 1000000000,
            "remaining_ns": 1000000000,
        };
        list<hash<SshCredentialProvider::SshClientIdentityCandidate>> string_candidates =
            provider.getClientIdentityCandidates(string_ctxt);
        assertEq(3, string_candidates.size(), "string-backed context values must be accepted at binary-module boundaries");
    }

    testFilesystemServerHostKeyProvider() {
        SshCredentialProvider::FilesystemSshServerHostKeyProvider provider(
            ("/tmp/ssh_host_ed25519_key", "/tmp/ssh_host_rsa_key"), "server-key-passphrase");
        list<hash<SshCredentialProvider::SshPrivateKeyMaterial>> server_keys =
            provider.getServerHostKeyMaterial(makeContext(SshCredentialProvider::SshProviderPurpose::ServerHostKey));

        assertEq(2, server_keys.size());
        assertEq(SshCredentialProvider::SshPrivateKeyMaterialKind::File, server_keys[0].kind);
        assertEq("/tmp/ssh_host_ed25519_key", server_keys[0].path);
        assertEq("server-key-passphrase", server_keys[0].passphrase_ref);
        assertEq("file", server_keys[0].source_kind);
        assertEq("/tmp/ssh_host_rsa_key", server_keys[1].path);
    }

    testHostKeyStoreDispatch() {
        TestHostKeyStore store();
        hash<SshCredentialProvider::SshPublicKeyInfo> observed_key = makePublicKeyInfo();
        hash<SshCredentialProvider::SshProviderContext> ctxt = makeContext();

        assertEq(SshCredentialProvider::SshHostKeyDecision::Matched,
            store.verifyHostKey(ctxt, observed_key).decision);
        assertEq(SshCredentialProvider::SshHostKeyDecision::Added,
            store.acceptHostKeyIfAbsent(ctxt, observed_key).decision);

        hash<SshCredentialProvider::SshHostKeyRecord> record = <SshCredentialProvider::SshHostKeyRecord>{
            "host": "example.com",
            "port": 22,
            "normalized_host": "example.com",
            "key_info": observed_key,
            "policy": "manual",
        };
        assertEq(SshCredentialProvider::SshHostKeyDecision::AcceptedSession,
            store.approveHostKey(ctxt, observed_key, record).decision);
    }

    testProviderRegistry() {
        string suffix = get_random_string();
        string client_name = "client-" + suffix;
        string server_name = "server-" + suffix;
        string store_name = "store-" + suffix;
        SshCredentialProvider::FilesystemSshClientIdentityProvider client_provider((), True);
        SshCredentialProvider::FilesystemSshServerHostKeyProvider server_provider(("/tmp/key",));
        TestHostKeyStore store();

        on_exit {
            SshCredentialProvider::SshCredentialProviderRegistry::deregisterClientIdentityProvider(client_name);
            SshCredentialProvider::SshCredentialProviderRegistry::deregisterServerHostKeyProvider(server_name);
            SshCredentialProvider::SshCredentialProviderRegistry::deregisterHostKeyStore(store_name);
        }

        SshCredentialProvider::SshCredentialProviderRegistry::registerClientIdentityProvider(client_name,
            client_provider);
        assertTrue(inlist(client_name,
            SshCredentialProvider::SshCredentialProviderRegistry::listClientIdentityProviders()));
        assertTrue(SshCredentialProvider::SshCredentialProviderRegistry::getClientIdentityProvider(client_name)
            != NOTHING);
        assertThrows("SSH-CREDENTIAL-PROVIDER-REGISTRY-ERROR",
            \SshCredentialProvider::SshCredentialProviderRegistry::registerClientIdentityProvider(),
            (client_name, client_provider));
        SshCredentialProvider::SshCredentialProviderRegistry::registerClientIdentityProvider(client_name,
            client_provider, True);

        SshCredentialProvider::SshCredentialProviderRegistry::registerServerHostKeyProvider(server_name,
            server_provider);
        assertTrue(inlist(server_name,
            SshCredentialProvider::SshCredentialProviderRegistry::listServerHostKeyProviders()));
        assertTrue(SshCredentialProvider::SshCredentialProviderRegistry::getServerHostKeyProvider(server_name)
            != NOTHING);

        SshCredentialProvider::SshCredentialProviderRegistry::registerHostKeyStore(store_name, store);
        assertTrue(inlist(store_name, SshCredentialProvider::SshCredentialProviderRegistry::listHostKeyStores()));
        assertTrue(SshCredentialProvider::SshCredentialProviderRegistry::getHostKeyStore(store_name) != NOTHING);

        assertThrows("SSH-CREDENTIAL-PROVIDER-REGISTRY-ERROR",
            \SshCredentialProvider::SshCredentialProviderRegistry::registerHostKeyStore(),
            ("bad name", store));

        assertTrue(SshCredentialProvider::SshCredentialProviderRegistry::deregisterClientIdentityProvider(client_name)
            != NOTHING);
        assertFalse(inlist(client_name,
            SshCredentialProvider::SshCredentialProviderRegistry::listClientIdentityProviders()));
    }
}
