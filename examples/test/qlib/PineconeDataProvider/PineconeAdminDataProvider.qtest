%modern
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires RestSchemaActions
%requires RestClientIo
%requires json
%requires PineconeDataProvider
%exec-class PineconeAdminProviderTest

class PineconeAdminLog {
    public {
        list<hash<auto>> requests = ();
        list<hash<auto>> responses = ();
    }
}
class PineconeAdminClient inherits PineconeAdminRestClientIo {
    public {
        static PineconeAdminLog log = new PineconeAdminLog();
    }
    constructor(hash<auto> opts, *HttpClientIo::HttpClientConnectionManager mgr) : PineconeAdminRestClientIo(opts, mgr) {
    }
    #! Schema dispatch now supplies an explicit target; retain this mock's response recorder.
    hash<RestClient::RestResponseInfo> restDoRawRequestTarget(string method,
            hash<RestClient::RestRequestTarget> target, *data body, *hash<auto> hdr) {
        return restDoRawRequest(method, target.path, body, hdr);
    }

    hash<RestClient::RestResponseInfo> restDoRawRequest(string method, string path, *data body,
            *hash<auto> headers) {
        PineconeAdminClient::log.requests += {"url": getUrl().toString(), "path": path, "method": method,
            "body": body ? parse_json(body) : NOTHING, "headers": getDefaultHeaders()};
        if (!PineconeAdminClient::log.responses) {
            throw "TEST-ERROR", sprintf("unexpected request %s %s", method, path);
        }
        return <RestClient::RestResponseInfo>{"status_code": 200,
            "body": shift PineconeAdminClient::log.responses, "headers": {}};
    }
}

class PineconeAdminProviderTest inherits QUnit::Test {
    constructor() : Test("Pinecone Admin actions", "1.0") {
        addTestCase("32 operations, typed forms, references and sensitive results", \manifestTest());
        addTestCase("project and API key request payloads", \requestTest());
        addTestCase("API key reference data enumerates projects", \referenceTest());
        addTestCase("reference partitions reject invalid declarations and cycles", \referenceErrorsTest());
        if (ENV.PINECONE_ADMIN_LIVE_TEST && (ENV.PINECONE_ADMIN_CONNECTION
                || (ENV.PINECONE_CLIENT_ID && ENV.PINECONE_CLIENT_SECRET))) {
            addTestCase("live: authenticate and create/delete an isolated project", \liveTest());
        }
        set_return_value(main());
    }
    private PineconeAdminDataProvider root(list<hash<auto>> responses) {
        PineconeAdminClient::log.requests = ();
        PineconeAdminClient::log.responses = responses;
        return new PineconeAdminDataProvider(new PineconeAdminClient({"token": "test-token",
            "oauth2_client_id": "test-client", "oauth2_client_secret": "test-secret"}));
    }
    private manifestTest() {
        assertEq("pinecone-admin", DataProvider::getFactory("pinecone-admin").getInfo().name);
        hash<DataProviderAppInfo> app = DataProviderActionCatalog::getApp("PineconeAdmin");
        assertEq("pinecone-admin", app.scheme);
        assertEq("Pinecone Admin", app.display_name);
        RestSchemaActionSet aset = PineconeSchema::getAdminActionSet();
        assertEq(32, aset.getActionNames().size());
        assertEq(32, PineconeSchema::AdminProvenance.source_operations);
        assertEq((), RestSchemaDrift::compare(aset, PineconeSchema::getAdminSchema()));
        PineconeAdminDataProvider p = root(());
        foreach hash<DataProviderActionInfo> a in (aset.getActionInfoList("PineconeAdmin")) {
            assertEq(DPAT_API, a.action_code);
            assertTrue(a.display_name.val());
            assertTrue(a.short_desc.val() && a.short_desc.size() < 80);
            assertTrue(a.desc.val());
            assertNothing(a.cls);
            # an output type built on first use is published by the callback the definition carries
            if (aset.getOperationEx(a.action).getResponseType()) {
                assertTrue(exists a.output_type || exists a.get_output_type);
            } else {
                assertNothing(a.output_type);
                assertNothing(a.get_output_type);
            }
            AbstractDataProvider child = p.getChildProviderEx(a.action);
            assertTrue(child.getInfo().supports_request);
            assertNothing(a.options."X-Pinecone-Api-Version");
            foreach hash<ActionOptionInfo> o in (a.options.iterator()) {
                assertTrue(o.display_name.val());
                assertTrue(o.desc.val());
            }
        }
        hash<DataProviderActionInfo> create = aset.getActionInfo("PineconeAdmin", "create-api-key");
        assertEq(6, create.options.roles.element_allowed_values.size());
        assertTrue(create.get_output_type().getFields().value.getAttributes().sensitive);
        foreach string action in (("create-service-account", "rotate-service-account-secret")) {
            assertTrue(aset.getOperationEx(action).getResponseType().getFields().client_secret.getAttributes().sensitive);
        }
        assertTrue(aset.getOperationEx("get-service-account").getResponseType().getFields().client_id.getAttributes().sensitive);
        assertEq("pinecone-admin-api-keys", aset.getActionInfo("PineconeAdmin", "delete-api-key").options.api_key_id.ref_data);
        assertThrows("CONSTRUCTOR-ERROR", sub () { new PineconeAdminDataProvider({"oauth2_client_id": "x"}); });
    }
    private requestTest() {
        string project = "11111111-1111-4111-8111-111111111111";
        string key = "22222222-2222-4222-8222-222222222222";
        PineconeAdminDataProvider p = root(({"id": project, "name": "Automation"},
            {"key": {"id": key}, "value": "test-issued-key"}, {}, {}));
        assertEq(project, p.getChildProviderEx("create-project").doRequest({"name": "Automation"}).id);
        assertEq("test-issued-key", p.getChildProviderEx("create-api-key").doRequest({
            "project_id": project, "name": "reader", "roles": ("DataPlaneViewer",)}).value);
        p.getChildProviderEx("delete-api-key").doRequest({"api_key_id": key});
        p.getChildProviderEx("delete-project").doRequest({"project_id": project});
        list<hash<auto>> calls = PineconeAdminClient::log.requests;
        assertEq("/admin/projects", calls[0].path);
        assertEq({"name": "Automation"}, calls[0].body);
        assertEq("/admin/projects/" + project + "/api-keys", calls[1].path);
        assertEq(("DataPlaneViewer",), calls[1].body.roles);
        assertEq("/admin/api-keys/" + key, calls[2].path);
        assertEq("DELETE", calls[3].method);
        assertEq(PineconeRestClientBase::ApiVersion, calls[0].headers."X-Pinecone-Api-Version");
        assertNothing(calls[0].headers."Api-Key");
    }
    private referenceTest() {
        string first = "11111111-1111-4111-8111-111111111111";
        string second = "22222222-2222-4222-8222-222222222222";
        PineconeAdminDataProvider p = root((
            {"data": ({"id": first, "name": "Team A"}, {"id": second, "name": "Team B"})},
            {"data": ({"id": "k1", "name": "Read A"},)}, {"data": ({"id": "k2", "name": "Read B"},)},
        ));
        list<hash<AllowedValueInfo>> values = p.getChildProviderEx("delete-api-key").getReferenceData("pinecone-admin-api-keys");
        assertEq(("k1", "k2"), (map $1.value, values));
        assertEq(("Read A", "Read B"), (map $1.display_name, values));
        assertEq("/admin/projects/" + first + "/api-keys", PineconeAdminClient::log.requests[1].path);
        assertEq("/admin/projects/" + second + "/api-keys", PineconeAdminClient::log.requests[2].path);
        p = root(({"data": ()},));
        assertNothing(p.getChildProviderEx("delete-api-key").getReferenceData("pinecone-admin-api-keys"));
        assertEq(1, PineconeAdminClient::log.requests.size());
    }
    private referenceErrorsTest() {
        foreach hash<auto> changes in (({"reference_option": "missing"}, {"options_reference": "absent"},
                {"options_reference": "pinecone-admin-api-keys"}, {"reference_option": NOTHING},
                {"option_sets": ({"project_id": "p"},)})) {
            hash<string, hash<RestSchemaReferenceDataInfo>> refs = PineconeAdminManifest::ReferenceData;
            refs."pinecone-admin-api-keys" = cast<hash<RestSchemaReferenceDataInfo>>(
                refs."pinecone-admin-api-keys" + changes);
            assertThrows("REST-SCHEMA-ACTION-ERROR", sub () {
                new RestSchemaActionSet(PineconeSchema::getAdminSchema(), PineconeAdminManifest::Manifest, refs);
            });
        }
    }
    private liveTest() {
        AbstractConnection c = ENV.PINECONE_ADMIN_CONNECTION ? get_connection(ENV.PINECONE_ADMIN_CONNECTION)
            : new PineconeAdminRestConnection("pinecone-admin-live", "Admin integration test",
                PineconeAdminRestConnection::DefaultUrl, {}, {"oauth2_client_id": ENV.PINECONE_CLIENT_ID,
                    "oauth2_client_secret": ENV.PINECONE_CLIENT_SECRET});
        assertTrue(c.ping(True).ok);
        PineconeAdminRestConnection bad("pinecone-admin-invalid", "negative Admin ping",
            PineconeAdminRestConnection::DefaultUrl, {}, {"oauth2_client_id": "qore-invalid-client",
                "oauth2_client_secret": "qore-invalid-secret"});
        assertFalse(bad.ping().ok);
        AbstractDataProvider p = c.getDataProvider();
        hash<auto> project = p.getChildProviderEx("create-project").doRequest({
            "name": sprintf("qore-admin-test-%d", now_us().getEpochMicroseconds())});
        on_exit p.getChildProviderEx("delete-project").doRequest({"project_id": project.id});
        assertEq(project.id, p.getChildProviderEx("get-project").doRequest({"project_id": project.id}).id);
    }
}
