#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%allow-injection

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Logger
%requires ConnectionProvider
%requires DataProvider
%requires PineconeDataProvider

%exec-class PineconeDataProviderTest

class FakePineconeRestClientIo inherits RestClientIo::RestClientIo {
    public {
        string last_method;
        string last_path;
        hash<auto> response_body;
    }
    constructor() : RestClientIo({"url": "https://api.pinecone.io"}) {}

    hash<RestClient::RestResponseInfo> restGet(string path, *hash<auto> hdr) {
        last_method = "GET";
        last_path = path;
        return <RestClient::RestResponseInfo>{"body": response_body};
    }
    string getSafeUrl() { return "https://api.pinecone.io"; }
}

public class PineconeDataProviderTest inherits QUnit::Test {
    public {
        const MyOpts = Opts + {
            "conn": "c,connection=s",
        };

        const OptionColumn = 22;
    }

    private {
        *string conn_name;
    }

    constructor() : Test("PineconeDataProvider Test", "1.0", \ARGV, MyOpts) {
        conn_name = m_options.conn ?? ENV.PINECONE_CONNECTION;

        addTestCase("factory + app + action registered", \registrationTest());
        addTestCase("list-indexes hits the right control-plane endpoint",
            \listIndexesTest());

        # Live test requires a real Pinecone connection AND a
        # `PINECONE_INDEX` env var naming an existing index in the
        # account.  The PineconeDataProvider currently exposes a
        # control-plane `list-indexes` action; the live test verifies
        # that the named index actually shows up in the response.
        # Cost: Pinecone serverless: 1 query — free-tier eligible.
        if (conn_name) {
            addTestCase("live: ping + list-indexes (verifies existing index)",
                \livePineconeTest());
        }
        set_return_value(main());
    }

    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-c,--connection=ARG",
            "set the Pinecone connection name; without it (and without the "
            "PINECONE_CONNECTION env var) the live test is skipped.  Also "
            "requires PINECONE_INDEX naming an existing index in the "
            "account.",
            OptionColumn);
    }

    private registrationTest() {
        DataProvider::AbstractDataProviderFactory f =
            DataProvider::DataProvider::getFactory("pinecone");
        assertEq("pinecone", f.getInfo().name);
        hash<DataProviderAppInfo> app =
            DataProvider::DataProviderActionCatalog::getApp("Pinecone");
        assertEq("Pinecone", app.name);
        assertEq("pinecone", app.scheme);
        # filter out the framework-injected make-api-call action (covered by
        # GenericApiCallAutoInjection.qtest in RestClientDataProvider)
        list<hash<DataProviderActionInfo>> actions = select
            DataProvider::DataProviderActionCatalog::getActions("Pinecone"),
            $1.action != AbstractDataProvider::GenericApiCallActionName;
        assertEq(1, actions.size());
        assertEq("list-indexes", actions[0].action);
    }

    private listIndexesTest() {
        FakePineconeRestClientIo fake();
        fake.response_body = {
            "indexes": (
                {"name": "demo-1", "dimension": 1024, "metric": "cosine",
                 "host": "demo-1-abc.svc.us-east-1.pinecone.io"},
                {"name": "demo-2", "dimension": 768, "metric": "dotproduct",
                 "host": "demo-2-xyz.svc.us-east-1.pinecone.io"},
            ),
        };
        PineconeDataProvider::PineconeListIndexesDataProvider prov(fake);
        auto resp = prov.doRequest(NOTHING);
        assertEq("GET", fake.last_method);
        assertEq("/indexes", fake.last_path);
        assertEq(2, resp.indexes.size());
        assertEq("demo-1", resp.indexes[0].name);
        assertEq(1024, resp.indexes[0].dimension);
    }

    #! Exercises Pinecone's live `/indexes` control-plane endpoint
    /** Verifies the actual wire format against Pinecone's control-plane
        API.  Requires both a connection name AND a `PINECONE_INDEX` env
        var naming an existing index; the test asserts that the named
        index appears in the list.

        Cost: Pinecone serverless: 1 query — free-tier eligible.
    */
    private livePineconeTest() {
        *string index_name = ENV.PINECONE_INDEX;
        if (!index_name.val()) {
            testSkip("PINECONE_INDEX env var must name an existing Pinecone "
                "index in the account");
        }

        AbstractConnection conn = get_connection(conn_name);
        hash<auto> ping = conn.ping(True);
        assertTrue(ping.ok, sprintf("Pinecone connection ping failed: %s",
            ping.info ?? "no info"));

        AbstractDataProvider prov = conn.getDataProvider();
        AbstractDataProvider li = prov.getChildProvider("list-indexes");
        auto resp = li.doRequest(NOTHING);
        assertTrue(exists resp.indexes,
            "Pinecone list-indexes returned an indexes field");
        # Find the named index in the response — wire-format check
        bool found = False;
        foreach hash<auto> idx in (resp.indexes ?? ()) {
            if (idx.name == index_name) {
                found = True;
                break;
            }
        }
        assertTrue(found, sprintf("PINECONE_INDEX %y was found in the "
            "account's list-indexes response", index_name));
    }
}
