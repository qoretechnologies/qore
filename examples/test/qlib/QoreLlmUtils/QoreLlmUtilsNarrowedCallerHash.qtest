#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
#
# Copyright 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires QoreLlmUtils

%exec-class QoreLlmUtilsNarrowedCallerHashTest

#! Option and configuration hashes whose values all have the same type
/** A hash literal whose values all have the same type, such as \c {"apikey": "..."}, has a narrowed type (here
    \c hash<string, string>); the library must still be able to add values of other types to its own copy and report
    the real problem with the configuration.  No request is sent: connections and clients are only created
*/
class QoreLlmUtilsNarrowedCallerHashTest inherits QUnit::Test {
    constructor() : Test("QoreLlmUtilsNarrowedCallerHashTest", "1.0", \ARGV) {
        addTestCase("verifier defaults with only boolean values", \verifierDefaults());
        set_return_value(main());
    }

    #! Returns the hash with its runtime type, as a caller's literal arrives in a library function
    static hash<auto> mk(hash<auto> h) {
        return h;
    }

    verifierDefaults() {
        # the defaults are a hash<string, bool>, which cannot take the float score of the call's options
        assertEq("hash<string, bool>", mk({"require_sources": True}).fullType());
        LlmBackend backend(<LlmBackendConfig>{
            "mode": "callback",
            "api_callback": hash<auto> sub (string method, string path, hash<auto> body) {
                throw "UNEXPECTED-CALL", "no request is made without sources";
            },
        });
        GroundedAnswerVerifier verifier(backend, {"require_sources": True});
        # without sources no request is made; the merged options decide the result
        hash<GroundingVerificationResult> result = verifier.verify("an answer", (), {"min_grounding_score": 0.5});
        assertFalse(result.passed);
        assertEq(("no authorized sources were supplied",), result.unsupported_claims);
        assertEq(("source-required",), result.missing_citations);
    }
}
