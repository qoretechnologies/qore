                push stream_bodies, body;
                dcb({
                    "id": "callback-malformed-stream-1",
                    "object": "chat.completion.chunk",
                    "model": "callback-model",
                    "choices": ({
                        "index": 0,
                        "delta": {},
                        "finish_reason": "MALFORMED_FUNCTION_CALL",
                    },),
                    "usage": {
                        "prompt_tokens": 80,
                        "completion_tokens": 0,
                        "total_tokens": 80,
                    },
                    "provider_diagnostics": {
                        "wire_protocol": "gemini_generate_content",
                        "wire_stream_event_count": 1,
                        "wire_function_call_count_max": 0,
                        "wire_function_call_observed": False,
                    },
                });
            },
        });

        list<hash<auto>> chunks = ();
        hash<auto> rv = llm.chatCompletionsStream({
            "model": "callback-model",
            "messages": (
                {"role": "system", "content": "Call the supplied tool."},
                {"role": "user", "content": "Ask one clarification."},
            ),
            "tools": ({
                "type": "function",
                "function": {
                    "name": "first_question",
                    "description": "Return the first clarification question",
                    "parameters": {
                        "type": "object",
                        "properties": {
                            "question": {"type": "string"},
                        },
                        "required": ("question",),
                    },
                },
            },),
            "tool_choice": {
                "type": "function",
                "function": {"name": "first_question"},
            },
            "max_tokens": 256,
            "reasoning_token_budget": 128,
        }, sub (hash<auto> chunk) {
            push chunks, chunk;
        });

        assertEq(1, stream_calls,
            "the malformed response uses the streaming callback first");
        assertEq(1, sync_calls,
            "the malformed streaming response receives one JSON retry");
        assertEq(256, stream_bodies[0].max_tokens,
            "the original stream preserves its output budget");
        assertEq(128, stream_bodies[0].reasoning_token_budget,
            "the original stream preserves its reasoning budget");
        assertEq(2048, sync_bodies[0].max_tokens,
            "the streaming schema retry receives the output floor");
        assertEq(0, sync_bodies[0].reasoning_token_budget,
            "the streaming schema retry disables hidden reasoning");
        assertEq(1, chunks.size(),
            "only the original terminal streaming chunk is forwarded");
        assertFalse(rv.choices[0].message.content.val(),
            "truncated streaming retry text is not returned as success");
        assertEq(NT_NOTHING, rv.choices[0].message.tool_calls.typeCode(),
            "a failed streaming retry does not fabricate a tool call");
        assertEq("MALFORMED_FUNCTION_CALL", rv.choices[0].finish_reason,
            "the original streaming protocol failure remains explicit");
        assertFalse(rv.provider_diagnostics.forced_tool_retry
                .returned_retry_response,
            "stream diagnostics record that the failed retry was not returned");
        assertFalse(rv.provider_diagnostics.forced_tool_retry
                .recovered_tool_call,
            "stream diagnostics record that no tool call was recovered");
        assertEq("length", rv.provider_diagnostics.forced_tool_retry
                .retry_finish_reason,
            "stream diagnostics preserve the failed retry finish reason");
        assertTrue(rv.provider_diagnostics.tool_protocol.streaming,
            "tool diagnostics identify the streaming path");
    }

    geminiOpenAiRequiredToolMalformedRetryTest() {
        checkGeminiModule();
        installGeminiHandler({
            "/v1beta/models/gemini-2.5-flash:generateContent": {
                "sequence": (
                    {
                        "code": 200,
                        "body": {
                            "responseId": "gemini-malformed-required-1",
                            "candidates": ({
                                "finishReason": "MALFORMED_FUNCTION_CALL",
                                "finishMessage": "Malformed function call: "
                                    "print(default_api.select_action(...))",
                                "content": {"parts": ()},
                            },),
                            "usageMetadata": {
                                "promptTokenCount": 120,
                                "candidatesTokenCount": 0,
                                "totalTokenCount": 120,
                            },
                        },
                    },
                    {
                        "code": 200,
                        "body": {
                            "responseId": "gemini-malformed-required-retry-1",
                            "candidates": ({
                                "finishReason": "STOP",
                                "content": {
                                    "parts": ({
                                        "functionCall": {
                                            "name": "select_action",
                                            "args": {
                                                "operation": "revise",
                                                "reason": "retry fixed",
                                            },
                                        },
                                    },),
                                },
                            },),
                            "usageMetadata": {
                                "promptTokenCount": 135,
                                "candidatesTokenCount": 4,
                                "totalTokenCount": 139,
                            },
                        },
                    },
                ),
            },
        });

        LlmBackend llm = makeGeminiBackend();
        hash<auto> rv = llm.chatCompletions({
            "model": "gemini-2.5-flash",
            "messages": (
                {"role": "system", "content": "Choose one action."},
                {"role": "user", "content": "Continue design mode."},
            ),
            "tools": ({
                "type": "function",
                "function": {
                    "name": "select_action",
                    "description": "Select the next design action",
                    "parameters": {
                        "type": "object",
                        "properties": {
                            "operation": {"type": "string"},
                            "reason": {"type": "string"},
                        },
                        "required": ("operation",),
                    },
                },
            }, {
                "type": "function",
                "function": {
                    "name": "record_note",
                    "description": "Record a note",
                    "parameters": {
                        "type": "object",
                        "properties": {"text": {"type": "string"}},
                        "required": ("text",),
                    },
                },
            },),
            "tool_choice": "required",
        });

        assertEq(2, gemini_handler.requests.size(),
            "malformed required-tool response is retried once");
        assertEq("ANY", gemini_handler.requests[1]
                .body.toolConfig.functionCallingConfig.mode,
            "retry preserves required tool mode");
        assertEq("tool_calls", rv.choices[0].finish_reason,
            "retry functionCall is normalized to OpenAI tool_calls");
        assertEq("select_action",
            rv.choices[0].message.tool_calls[0].function.name,
            "retry preserves returned tool name");
        hash<auto> args = parse_json(
            rv.choices[0].message.tool_calls[0].function.arguments);
        assertEq("revise", args.operation,
            "retry function arguments are serialized");
    }

    geminiOpenAiToolTurnsFacadeTest() {
        checkGeminiModule();
        installGeminiHandler({
            "/v1beta/models/gemini-2.5-flash:generateContent": {
                "code": 200,
                "body": {
                    "candidates": ({
                        "finishReason": "STOP",
                        "content": {"parts": ({"text": "used tool"},)},
                    },),
                    "usageMetadata": {"totalTokenCount": 5},
                },
            },
        });

        LlmBackend llm = makeGeminiBackend();
        hash<auto> rv = llm.chatCompletions({
            "messages": (
                {"role": "user", "content": "lookup customer"},
                {
                    "role": "assistant",
                    "tool_calls": ({
                        "id": "call-1",
                        "type": "function",
                        "function": {
                            "name": "lookup",
                            "arguments": "{\"key\":\"customer\"}",
                        },
                    }, {
                        "id": "call-2",
                        "type": "function",
                        "function": {
                            "name": "lookup_order",
                            "arguments": "{\"key\":\"order\"}",
                        },
                    },),
                },
                {
                    "role": "tool",
                    "tool_call_id": "call-1",
                    "content": "{\"ok\":true}",
                },
                {
                    "role": "tool",
                    "tool_call_id": "call-2",
                    "content": "{\"ok\":false}",
                },
            ),
        });

        assertEq("used tool", rv.choices[0].message.content,
            "facade returns normalized assistant text");
        assertEq("model", gemini_handler.requests[0].body.contents[1].role,
            "assistant tool call is represented as model content");
        assertEq("lookup",
            gemini_handler.requests[0].body.contents[1].parts[0].functionCall.name,
            "assistant function call name converted");
        assertEq("customer",
            gemini_handler.requests[0].body.contents[1].parts[0].functionCall.args.key,
            "assistant function call JSON arguments parsed");
        assertEq("lookup",
            gemini_handler.requests[0].body.contents[2].parts[0].functionResponse.name,
            "tool result name converted");
        assertEq(True,
            gemini_handler.requests[0].body.contents[2].parts[0].functionResponse.response.ok,
            "tool result JSON parsed");
        assertEq(2,
            gemini_handler.requests[0].body.contents[2].parts.size(),
            "parallel tool results share one Gemini user turn");
        assertEq("lookup_order",
            gemini_handler.requests[0].body.contents[2].parts[1].functionResponse.name,
            "a missing result name is recovered from its tool-call id");
        assertEq(False,
            gemini_handler.requests[0].body.contents[2].parts[1].functionResponse.response.ok,
            "grouping preserves each parallel result payload");
    }

    anthropicOpenAiFacadeCacheAndFileTest() {
        checkGeminiModule();
        installGeminiHandler({
            "/v1/messages": {
                "code": 200,
                "body": {
                    "id": "msg-cache-file-test",
                    "model": "claude-test",
                    "role": "assistant",
                    "content": ({"type": "text", "text": "ok"},),
                    "stop_reason": "end_turn",
                    "usage": {"input_tokens": 3, "output_tokens": 1},
                },
            },
        });

        LlmBackend llm(<LlmBackendConfig>{
            "mode": "anthropic",
            "url": "http://localhost:" + port,
            "model": "claude-test",
            "api_key": "anthropic-test-key",
        });
        list<hash<auto>> system_content = ({
            "type": "text",
            "text": "cached rules",
            "cache_control": {"type": "ephemeral"},
        },);
        list<hash<auto>> user_content = ({
            "type": "text",
            "text": "read the PDF",
        },);
        user_content += {
            "type": "file",
            "file": {
                "filename": "invoice.pdf",
                "file_data": "data:application/pdf;base64,"
                    + make_base64_string(binary("%PDF-test")),
            },
        };
        hash<auto> rv = llm.chatCompletions({
            "messages": (
                {
                    "role": "system",
                    "content": system_content,
                },
                {
                    "role": "user",
                    "content": user_content,
                },
            ),
            "tools": ({
                "type": "function",
                "function": {
                    "name": "answer",
                    "description": "answer",
                    "parameters": {
                        "type": "object",
                        "properties": {"ok": {"type": "boolean"}},
                    },
                },
                "cache_control": {"type": "ephemeral"},
            },),
        });

        assertEq("ok", rv.choices[0].message.content,
            "Anthropic response is normalized to OpenAI content");
        hash<auto> body = gemini_handler.requests[0].body;
        assertEq("ephemeral", body.system[0].cache_control.type,
            "system cache_control marker reaches Anthropic request");
        assertEq("ephemeral", body.tools[0].cache_control.type,
            "tool cache_control marker reaches Anthropic request");
        assertEq("document", body.messages[0].content[1].type,
            "OpenAI file block is translated to Anthropic document");
        assertEq("application/pdf",
            body.messages[0].content[1].source.media_type,
            "document MIME type is preserved");
    }

    anthropicReasoningControlsTest() {
        checkGeminiModule();
        hash<auto> reply = {
            "code": 200,
            "body": {
                "id": "msg-reasoning-controls",
                "model": "claude-test",
                "role": "assistant",
                "content": ({"type": "text", "text": "ok"},),
                "stop_reason": "end_turn",
                "usage": {"input_tokens": 3, "output_tokens": 1},
            },
        };
        installGeminiHandler({"/v1/messages": reply});

        LlmBackend llm(<LlmBackendConfig>{
            "mode": "anthropic",
            "url": "http://localhost:" + port,
            "model": "claude-test",
            "api_key": "anthropic-test-key",
        });
        list<hash<ChatMessage>> msgs = (
            <ChatMessage>{"role": "user", "content": "hi"},
        );

        # no reasoning preference -> no reasoning control on the wire, so
        # the model's own default applies and existing callers are unaffected
        llm.chat(msgs);
        hash<auto> body = gemini_handler.requests[0].body;
        assertFalse(body.hasKey("thinking"),
            "no thinking control is sent when the caller expressed none");
        assertFalse(body.hasKey("output_config"));

        # disable_reasoning -> thinking disabled
        installGeminiHandler({"/v1/messages": reply});
        llm.chat(msgs, NOTHING, <LlmRequestOptions>{
            "disable_reasoning": True,
        });
        body = gemini_handler.requests[0].body;
        assertEq("disabled", body.thinking.type,
            "disable_reasoning turns Anthropic thinking off");
        assertFalse(body.hasKey("output_config"));

        # reasoning_effort -> adaptive thinking at the requested effort
        installGeminiHandler({"/v1/messages": reply});
        llm.chat(msgs, NOTHING, <LlmRequestOptions>{
            "reasoning_effort": "xhigh",
        });
        body = gemini_handler.requests[0].body;
        assertEq("adaptive", body.thinking.type,
            "reasoning_effort selects adaptive thinking");
        assertEq("xhigh", body.output_config.effort,
            "reasoning_effort maps to output_config.effort");

        # a numeric reasoning budget is NOT mapped: Anthropic removed
        # thinking budget_tokens with Opus 4.7 and rejects it with HTTP 400
        installGeminiHandler({"/v1/messages": reply});
        llm.chat(msgs, NOTHING, <LlmRequestOptions>{
            "reasoning_token_budget": 8000,
        });
        body = gemini_handler.requests[0].body;
        assertFalse(body.hasKey("thinking"),
            "reasoning_token_budget is not mapped to a thinking budget");
        assertFalse(exists body.budget_tokens,
            "budget_tokens never reaches the Anthropic request");
    }

    anthropicReasoningBlockRoundTripTest() {
        checkGeminiModule();
        hash<auto> thinking_block = {
            "type": "thinking",
            "thinking": "considering the options",
            "signature": "sig-abc123",
        };
        installGeminiHandler({
            "/v1/messages": {
                "code": 200,
                "body": {
                    "id": "msg-reasoning-roundtrip",
                    "model": "claude-test",
                    "role": "assistant",
                    "content": (
                        thinking_block,
                        {"type": "text", "text": "let me check"},
                        {
                            "type": "tool_use",
                            "id": "toolu_1",
                            "name": "answer",
                            "input": {"ok": True},
                        },
                    ),
                    "stop_reason": "tool_use",
                    "usage": {"input_tokens": 3, "output_tokens": 4},
                },
            },
        });

        LlmBackend llm(<LlmBackendConfig>{
            "mode": "anthropic",
            "url": "http://localhost:" + port,
            "model": "claude-test",
            "api_key": "anthropic-test-key",
        });
        hash<ChatResponse> rv = llm.chat((
            <ChatMessage>{"role": "user", "content": "hi"},
        ));

        # the thinking block is surfaced rather than dropped
        assertEq(1, rv.reasoning_blocks.size(),
            "the thinking block is captured on the response");
        assertEq(thinking_block, rv.reasoning_blocks[0],
            "the thinking block is carried verbatim");
        assertEq("let me check", rv.content,
            "text content is still extracted alongside reasoning");
        assertEq("toolu_1", rv.tool_calls[0].id);

        # replaying the assistant turn puts the block back, first, unchanged
        installGeminiHandler({
            "/v1/messages": {
                "code": 200,
                "body": {
                    "id": "msg-reasoning-roundtrip-2",
                    "model": "claude-test",
                    "role": "assistant",
                    "content": ({"type": "text", "text": "done"},),
                    "stop_reason": "end_turn",
                    "usage": {"input_tokens": 5, "output_tokens": 1},
                },
            },
        });
        llm.chat((
            <ChatMessage>{"role": "user", "content": "hi"},
            <ChatMessage>{
                "role": "assistant",
                "content": rv.content,
                "tool_calls": rv.tool_calls,
                "reasoning_blocks": rv.reasoning_blocks,
            },
            <ChatMessage>{
                "role": "tool",
                "tool_call_id": "toolu_1",
                "content": "42",
            },
        ));
        list<auto> replayed =
            gemini_handler.requests[0].body.messages[1].content;
        assertEq("thinking", replayed[0].type,
            "the thinking block leads the replayed assistant turn");
        assertEq(thinking_block, replayed[0],
            "the replayed thinking block is byte-identical, so the "
            "signature the API verifies survives the round trip");
        assertEq("text", replayed[1].type);
        assertEq("tool_use", replayed[2].type);
    }

    anthropicReasoningBlockOpenAiFacadeTest() {
        checkGeminiModule();
        hash<auto> thinking_block = {
            "type": "thinking",
            "thinking": "weighing the tool options",
            "signature": "sig-facade-1",
        };
        installGeminiHandler({
            "/v1/messages": {
                "code": 200,
                "body": {
                    "id": "msg-facade-reasoning",
                    "model": "claude-test",
                    "role": "assistant",
                    "content": (
                        thinking_block,
                        {
                            "type": "tool_use",
                            "id": "toolu_facade",
                            "name": "answer",
                            "input": {"ok": True},
                        },
                    ),
                    "stop_reason": "tool_use",
                    "usage": {"input_tokens": 3, "output_tokens": 4},
                },
            },
        });

        LlmBackend llm(<LlmBackendConfig>{
            "mode": "anthropic",
            "url": "http://localhost:" + port,
            "model": "claude-test",
            "api_key": "anthropic-test-key",
        });
        hash<auto> rv = llm.chatCompletions({
            "messages": ({"role": "user", "content": "hi"},),
        });

        # the OpenAI-shaped facade is the neutral conversation format, so
        # the blocks have to survive it or a caller replaying the turn
        # through chatCompletions() loses them
        hash<auto> assistant_msg = rv.choices[0].message;
        assertEq(1, assistant_msg.reasoning_blocks.size(),
            "reasoning blocks reach the OpenAI-shaped assistant message");
        assertEq(thinking_block, assistant_msg.reasoning_blocks[0]);

        # replay that exact assistant message back through the facade
        installGeminiHandler({
            "/v1/messages": {
                "code": 200,
                "body": {
                    "id": "msg-facade-reasoning-2",
                    "model": "claude-test",
                    "role": "assistant",
                    "content": ({"type": "text", "text": "done"},),
                    "stop_reason": "end_turn",
                    "usage": {"input_tokens": 5, "output_tokens": 1},
                },
            },
        });
        llm.chatCompletions({
            "messages": (
                {"role": "user", "content": "hi"},
                assistant_msg,
                {
                    "role": "tool",
                    "tool_call_id": "toolu_facade",
                    "content": "42",
                },
            ),
        });
        list<auto> replayed =
            gemini_handler.requests[0].body.messages[1].content;
        assertEq(thinking_block, replayed[0],
            "the facade round trip replays the thinking block verbatim");
    }

    hashdeclDefaultsTest() {
        hash<LlmBackendConfig> config(<LlmBackendConfig>{"mode": "http", "url": "http://x"});
        assertEq(4096, config.max_tokens);
        assertEq(0.0, config.temperature);
        assertEq(10000, config.connect_timeout_ms);
        assertEq(120000, config.timeout_ms);
        assertEq("2023-06-01", config.anthropic_version);
    }

    registryFactoryLookupTest() {
        AbstractLlmProviderFactory cb = LlmProviderRegistry::getFactoryEx("callback");
        assertEq("callback", cb.getMode());
        hash<LlmProviderInfo> info = cb.getInfo();
        assertEq("callback", info.mode);
        assertTrue(info.supports_tools);
        assertFalse(info.prefers_narrow_tool_catalogue,
            "callback provider has no narrow-tool preference by default");
        assertEq(0, info.preferred_max_tool_count,
            "callback provider has no tool-count cap by default");
        assertFalse(info.prefers_single_tool_dispatch,
            "callback provider has no single-dispatch preference by default");

        AbstractLlmProviderFactory gemini =
            LlmProviderRegistry::getFactoryEx("gemini");
        hash<LlmProviderInfo> gemini_info = gemini.getInfo();
        assertTrue(gemini_info.prefers_narrow_tool_catalogue,
            "Gemini provider advertises narrow tool-catalogue preference");
        assertEq(8, gemini_info.preferred_max_tool_count,
            "Gemini provider advertises a conservative tool-count cap");
        assertTrue(gemini_info.prefers_single_tool_dispatch,
            "Gemini provider advertises single dispatch tool preference");
        assertTrue(gemini_info.prefers_stringified_tool_payloads,
            "Gemini provider advertises stringified payload preference");
    }

    registryRegisterDeregisterTest() {
        FakeLlmProviderFactory fake();
        LlmProviderRegistry::registerFactory(fake);
        on_exit LlmProviderRegistry::deregisterFactory("test-fake");
        AbstractLlmProviderFactory looked_up = LlmProviderRegistry::getFactoryEx("test-fake");
        assertEq("test-fake", looked_up.getMode());
        assertTrue(inlist("test-fake", LlmProviderRegistry::knownProviderModes()));
    }

    registryDuplicateRejectedTest() {
        FakeLlmProviderFactory fake();
        LlmProviderRegistry::registerFactory(fake);
        on_exit LlmProviderRegistry::deregisterFactory("test-fake");
        assertThrows("LLM-CONFIG-ERROR", "already been registered",
            sub () { LlmProviderRegistry::registerFactory(new FakeLlmProviderFactory()); });
    }

    registryUnknownModeTest() {
        assertThrows("LLM-CONFIG-ERROR", "is unknown",
            sub () { LlmProviderRegistry::getFactoryEx("no-such-mode-xyz"); });
    }

    promptSecretProtectRestoreTest() {
        string raw_secret = "qore-test-secret-value-12345";
        string text = "crea una conexión con contraseña:=" + raw_secret;
        *hash<auto> placeholders = PromptSecretProtector::protectText(\text);
        assertTrue(placeholders.val());
        assertFalse(text.find(raw_secret) >= 0);
        assertTrue(text.find("<credential-1>") >= 0);
        assertEq(raw_secret, placeholders."<credential-1>");

        string context_text = PromptSecretProtector::buildSystemContext(placeholders);
        assertTrue(context_text.find("<credential-1>") >= 0);
        assertFalse(context_text.find(raw_secret) >= 0);
        assertTrue(context_text.find("qore.llm.protected_values.v1") >= 0);
        assertTrue(context_text.find("\"forbidden_uses\"") >= 0);

        hash<auto> args = {
            "options": {"apikey": "<credential-1>"},
            "list": ("<credential-1>", "plain"),
        };
        hash<auto> restored = cast<hash>(
            PromptSecretProtector::restorePlaceholders(args, placeholders));
        assertEq(raw_secret, restored.options.apikey);
        assertEq(raw_secret, restored.list[0]);
    }

    promptSecretRedactNestedTest() {
        string raw_secret = "qore-test-secret-value-24680";
        string text = "認証情報:=\"" + raw_secret + "\"";
        *hash<auto> placeholders = PromptSecretProtector::protectText(\text);
        hash<auto> value = {
            "options": {"apikey": "<credential-1>"},
            "nested": ({"token": "<credential-1>"},),
        };
        hash<auto> redacted = cast<hash>(
            PromptSecretProtector::redactPlaceholders(value, placeholders));
        assertEq("<redacted>", redacted.options.apikey);
        assertEq("<redacted>", redacted.nested[0].token);
        assertFalse(sprintf("%y", redacted).find(raw_secret) >= 0);
    }

    promptSecretRedactProtectedValuesTest() {
        string raw_secret = "qore-test-secret-value-67890";
        string text = "apikey=" + raw_secret;
        *hash<auto> placeholders = PromptSecretProtector::protectText(\text);
        hash<auto> value = {
            "message": "tool failed with apikey=" + raw_secret,
            "args": {"apikey": raw_secret, "note": "<credential-1>"},
        };
        hash<auto> redacted = cast<hash>(
            PromptSecretProtector::redactProtectedValues(value, placeholders));
        assertFalse(sprintf("%y", redacted).find(raw_secret) >= 0);
        assertEq("<redacted>", redacted.args.apikey);
        assertEq("<redacted>", redacted.args.note);
        assertTrue(redacted.message.find("<redacted>") >= 0);
    }

    promptSecretRedactSensitiveValueTest() {
        hash<auto> value = {
            "apikey": "secret-value-12345",
            "nested": {
                "plain": "heslo:=secret-value-67890",
                "url": "https://example.com",
                "url_with_auth": "https://user:secret-value-99999@example.com/path",
            },
            "svalue": "secret-value-54321",
            "secreto": "ordinary-cognate-value",
            "Segreto": "ordinary-case-distinct-value",
        };
        hash<auto> redacted = cast<hash>(
            PromptSecretProtector::redactSensitiveValue(value));
        assertEq("<redacted>", redacted.apikey);
        assertEq("<redacted>", redacted.svalue);
        assertFalse(redacted.nested.plain.find("secret-value-67890") >= 0);
        assertEq("https://example.com", redacted.nested.url);
        assertEq("https://user:<redacted>@example.com/path",
            redacted.nested.url_with_auth);
        assertEq("ordinary-cognate-value", redacted.secreto);
        assertEq("ordinary-case-distinct-value", redacted.Segreto);
        assertFalse(PromptSecretProtector::isSensitiveKey("SeCrEt"));
        assertFalse(PromptSecretProtector::isSensitiveKey("secreto"));
        assertFalse(PromptSecretProtector::isSensitiveKey("segreto"));
        assertFalse(PromptSecretProtector::isSensitiveKey("tajomstvo"));
        assertFalse(PromptSecretProtector::isSensitiveKey("hemmelig"));
        assertTrue(PromptSecretProtector::isSensitiveKey("secret"));

        string ordinary = "Il segreto industriale resta una descrizione";
        assertEq(ordinary,
            PromptSecretProtector::redactSensitiveString(ordinary));
    }

    promptSecretProtectedValueLimitTest() {
        string text;
        for (int i = 0; i < 65; ++i) {
            text += sprintf("password=value-%06d; ", i);
        }
        assertThrows("LLM-SECRET-PROTECTION-ERROR",
            "max_protected_values", sub () {
                PromptSecretProtector::protectText(\text);
            });
        assertEq("<redacted>",
            PromptSecretProtector::redactSensitiveString(text));
    }

    # --- qorus#230 helpers: qoreParamsToJsonSchema / sanitizeLlmToolName ---
    # The four helpers in JsonSchema.qc are the abstraction-layer fix for
    # qorus#230 (tool-enabled chats failing with provider HTTP 400 because
    # Qore param descriptors were shipped raw as JSON Schema and tool names
    # contained provider-invalid characters).  Tests cover the load-bearing
    # behaviours so future regressions are caught at the helper boundary
    # rather than as opaque 502s at chat time.

    qoreTypeNameToJsonSchemaScalarTest() {
        assertEq({"type": "string"}, QoreLlmUtils::qoreTypeNameToJsonSchema("string"));
        assertEq({"type": "integer"}, QoreLlmUtils::qoreTypeNameToJsonSchema("int"));
        assertEq({"type": "number"}, QoreLlmUtils::qoreTypeNameToJsonSchema("float"));
        assertEq({"type": "boolean"}, QoreLlmUtils::qoreTypeNameToJsonSchema("bool"));
        assertEq({"type": "string", "format": "date-time"},
            QoreLlmUtils::qoreTypeNameToJsonSchema("date"));
        assertEq({"type": "object"}, QoreLlmUtils::qoreTypeNameToJsonSchema("hash"));
        # Nullable: leading `*` → `nullable: True`, base type otherwise unchanged
        assertEq({"type": "string", "nullable": True},
            QoreLlmUtils::qoreTypeNameToJsonSchema("*string"));
        assertEq({"type": "integer", "nullable": True},
            QoreLlmUtils::qoreTypeNameToJsonSchema("*int"));
        # No type info → permissive default
        assertEq({"type": "string"}, QoreLlmUtils::qoreTypeNameToJsonSchema(NOTHING));
    }

    qoreTypeNameToJsonSchemaListTest() {
        assertEq({"type": "array", "items": {"type": "string"}},
            QoreLlmUtils::qoreTypeNameToJsonSchema("list<string>"));
        assertEq({"type": "array", "items": {"type": "integer"}},
            QoreLlmUtils::qoreTypeNameToJsonSchema("list<int>"));
        assertEq({"type": "array", "items": {"type": "string"}, "nullable": True},
            QoreLlmUtils::qoreTypeNameToJsonSchema("*list<string>"));
        # Bare list: items must still be set (Gemini rejects arrays
        # without items).  qoreTypeNameToJsonSchema defaults to string.
        assertEq({"type": "array", "items": {"type": "string"}},
            QoreLlmUtils::qoreTypeNameToJsonSchema("list"));
    }

    qoreTypeNameToJsonSchemaSoftTest() {
        assertEq({"type": "string"}, QoreLlmUtils::qoreTypeNameToJsonSchema("softstring"));
        assertEq({"type": "integer"}, QoreLlmUtils::qoreTypeNameToJsonSchema("softint"));
        assertEq({"type": "boolean", "nullable": True},
            QoreLlmUtils::qoreTypeNameToJsonSchema("*softbool"));
    }

    qoreParamDescriptorTest() {
        hash<auto> prop = QoreLlmUtils::qoreParamDescriptorToJsonSchemaProperty({
            "type": "*string",
            "description": "City name",
            "allowed_values": ("metric", "imperial"),
            "default_value": "metric",
        });
        assertEq("string", prop.type);
        assertEq(True, prop.nullable);
        assertEq("City name", prop.description);
        assertEq(("metric", "imperial"), prop{"enum"});
        assertEq("metric", prop{"default"});
        # `desc` and `short_desc` are accepted as description fallbacks
        hash<auto> p2 = QoreLlmUtils::qoreParamDescriptorToJsonSchemaProperty({
            "type": "int",
            "desc": "fallback description",
        });
        assertEq("fallback description", p2.description);
        hash<auto> p3 = QoreLlmUtils::qoreParamDescriptorToJsonSchemaProperty({
            "type": "int",
            "short_desc": "short fallback",
        });
        assertEq("short fallback", p3.description);
    }

    qoreParamsToJsonSchemaObjectTest() {
        hash<auto> schema = QoreLlmUtils::qoreParamsToJsonSchema({
            "city": {
                "type": "string",
                "required": True,
                "description": "City",
            },
            "units": {
                "type": "*string",
                "allowed_values": ("metric", "imperial"),
                "default_value": "metric",
            },
        });
        assertEq("object", schema.type);
        assertEq("string", schema.properties.city.type);
        assertEq("City", schema.properties.city.description);
        # `required: true` on a descriptor lifts the property name into
        # the parent-level `required` array — per-property required is
        # NOT a JSON Schema field and is dropped.
        assertEq(("city",), schema.required);
        assertEq("string", schema.properties.units.type);
        assertEq(True, schema.properties.units.nullable);
        assertEq(("metric", "imperial"), schema.properties.units{"enum"});
        # Empty params → minimal object schema with no `required` key
        hash<auto> empty = QoreLlmUtils::qoreParamsToJsonSchema(NOTHING);
        assertEq("object", empty.type);
        assertEq({}, empty.properties);
        assertFalse(empty.hasKey("required"));
    }

    qoreParamsToJsonSchemaDropsExtraFieldsTest() {
        # Qonsole descriptors carry `positional`, `position`, and other
        # Qore-CLI metadata that are not part of JSON Schema and would
        # cause provider HTTP 400 if they reached the wire.  The helper
        # must drop them silently.
        hash<auto> schema = QoreLlmUtils::qoreParamsToJsonSchema({
            "path": {
                "type": "string",
                "required": True,
                "positional": True,
                "position": 0,
            },
        });
        hash<auto> prop = schema.properties.path;
        assertFalse(prop.hasKey("positional"));
        assertFalse(prop.hasKey("position"));
        assertFalse(prop.hasKey("required"));
        assertEq(("path",), schema.required);
    }

    sanitizeLlmToolNamePassthroughTest() {
        # Already-valid names round-trip unchanged so callers' lookup
        # tables keyed by the raw name keep working.
        assertEq("status", QoreLlmUtils::sanitizeLlmToolName("status"));
        assertEq("system_status",
            QoreLlmUtils::sanitizeLlmToolName("status", "system_"));
        assertEq("AppName-action",
            QoreLlmUtils::sanitizeLlmToolName("AppName-action"));
        assertEq("a_b_c", QoreLlmUtils::sanitizeLlmToolName("a_b_c"));
    }

    sanitizeLlmToolNameInvalidCharsTest() {
        # Invalid characters are replaced with underscore; any
        # transformation appends a deterministic 8-hex MD5 suffix.
        string r1 = QoreLlmUtils::sanitizeLlmToolName("GET /api/v9/foo", "rest_");
        assertRegex("^rest_GET__api_v9_foo_[0-9a-f]{8}$", r1);
        # Deterministic: same input produces same output
        assertEq(r1, QoreLlmUtils::sanitizeLlmToolName("GET /api/v9/foo", "rest_"));
        # Dots become underscores too
        string r2 = QoreLlmUtils::sanitizeLlmToolName("foo.bar.baz");
        assertRegex("^foo_bar_baz_[0-9a-f]{8}$", r2);
    }

    sanitizeLlmToolNameCollisionTest() {
        # Two distinct raw names that share a long prefix past the 55-char
        # boundary must NOT collapse to the same sanitized output — the
        # MD5 hash suffix disambiguates them.
        string a = QoreLlmUtils::sanitizeLlmToolName(
            "get-workflows-{id_or_name}-stepinfo-{id_or_name}-config-{name}-value",
            "rest_");
        string b = QoreLlmUtils::sanitizeLlmToolName(
            "get-workflows-{id_or_name}-stepinfo-{id_or_name}-config-{name}-default",
            "rest_");
        assertNeq(a, b);
        # Both fit within the 64-char OpenAI ceiling
        assertTrue(a.size() <= 64);
        assertTrue(b.size() <= 64);
    }

    sanitizeLlmToolNameLeadingCharTest() {
        # First char must be a letter or underscore — digits and
        # leading hyphens get an underscore prepended.
        string r1 = QoreLlmUtils::sanitizeLlmToolName("123tool");
        assertRegex("^_123tool", r1);
        # And the result is suffix-hashed because the input was
        # transformed (prepend != input)
        assertRegex("^_123tool_[0-9a-f]{8}$", r1);
    }

    sanitizeLlmToolNameLengthCapTest() {
        # 200-character input must be truncated to fit 64 chars total,
        # including the 9-char `_xxxxxxxx` suffix.
        string raw = strmul("a", 200);
        string out = QoreLlmUtils::sanitizeLlmToolName(raw);
        assertEq(64, out.size());
        # And ends in the deterministic hash suffix
        assertRegex("_[0-9a-f]{8}$", out);
    }

    # --- qorus#231: CallbackLlmProvider.chatStream ---
    # CallbackLlmProvider gained streaming support so the agent strategy's
    # streaming loop has a callback-mode provider it can drive end-to-end
    # (matters for Qorus, whose AI gateway uses callback mode).  These
    # tests pin: real streaming forwards deltas + terminal, empty/role-only
    # chunks are suppressed, the fallback path emits one delta + done from
    # a sync chat(), upstream throws wrap as LLM-ERROR, tool-call deltas
    # are surfaced via event.raw, and the malformed-provider safety net
    # fires a terminal done so caller accumulators never deadlock.

    private list<hash<auto>> driveCallbackChatStream(
            *code<nothing(string, string, hash<auto>, code<nothing(hash<auto>)>)>
                stream_cb,
            *code<hash<auto>(string, string, hash<auto>)> sync_cb) {
        list<hash<auto>> seen = ();
        QoreLlmUtils::LlmBackend b(<QoreLlmUtils::LlmBackendConfig>{
            "mode": "callback",
            "api_callback": sync_cb,
            "api_stream_callback": stream_cb,
        });
        b.chatStream(
            (<QoreLlmUtils::ChatMessage>{"role": "user", "content": "x"},),
            sub (hash<QoreLlmUtils::ChatStreamEvent> e) {
                push seen, {
                    "delta": e.delta,
                    "done": e.done,
                    "raw_finish": e.raw.choices[0].finish_reason,
                    "raw_tool_calls": e.raw.choices[0].delta.tool_calls,
                };
            });
        return seen;
    }

    callbackChatStreamRealPathTest() {
        code<nothing(string, string, hash<auto>, code<nothing(hash<auto>)>)>
                stream_cb =
            sub (string m, string p, hash<auto> body, code<nothing(hash<auto>)> dcb) {
                # Assert the stream-enabled body shape reaches the callback
                assertEq(True, body.stream);
                assertEq(True, body.stream_options.include_usage);
                dcb({"object": "chat.completion.chunk",
                    "choices": ({"index": 0,
                        "delta": {"content": "hel"},
                        "finish_reason": NOTHING},)});
                dcb({"object": "chat.completion.chunk",
                    "choices": ({"index": 0,
                        "delta": {"content": "lo"},
                        "finish_reason": NOTHING},)});
                dcb({"object": "chat.completion.chunk",
                    "choices": ({"index": 0,
                        "delta": {},
                        "finish_reason": "stop"},),
                    "usage": {"total_tokens": 12}});
            };
        list<hash<auto>> seen = driveCallbackChatStream(stream_cb,
            hash<auto> sub (string m, string p, hash<auto> body) { return {}; });
        assertEq(3, seen.size(), "three events: two content + terminal");
        assertEq("hel", seen[0].delta);
        assertFalse(seen[0].done);
        assertEq("lo", seen[1].delta);
        assertFalse(seen[1].done);
        assertEq(True, seen[2].done, "terminal event");
        assertEq("stop", seen[2].raw_finish);
    }

    callbackNestedChatCompletionsStreamNoReentryTest() {
        int inner_stream_calls = 0;
        int forwarded_chunks = 0;

        QoreLlmUtils::LlmBackend inner(<QoreLlmUtils::LlmBackendConfig>{
            "mode": "callback",
            "api_callback": hash<auto> sub (string m, string p,
                    hash<auto> body) {
                return {};
            },
            "api_stream_callback": sub (string m, string p, hash<auto> body,
                    code<nothing(hash<auto>)> dcb) {
                ++inner_stream_calls;
                dcb({
                    "id": "nested-1",
                    "object": "chat.completion.chunk",
                    "model": "mock-model",
                    "choices": ({
                        "index": 0,
                        "delta": {"role": "assistant", "content": "nested"},
                        "finish_reason": NOTHING,
                    },),
                });
                dcb({
                    "id": "nested-1",
                    "object": "chat.completion.chunk",
                    "model": "mock-model",
                    "choices": ({
                        "index": 0,
                        "delta": {},
                        "finish_reason": "stop",
                    },),
                    "usage": {
                        "prompt_tokens": 1,
                        "completion_tokens": 1,
                        "total_tokens": 2,
                    },
                });
            },
        });

        QoreLlmUtils::LlmBackend outer(<QoreLlmUtils::LlmBackendConfig>{
            "mode": "callback",
            "api_callback": hash<auto> sub (string m, string p,
                    hash<auto> body) {
                return {};
            },
            "api_stream_callback": sub (string m, string p, hash<auto> body,
                    code<nothing(hash<auto>)> dcb) {
                inner.chatCompletionsStream(body, sub (hash<auto> chunk) {
                    ++forwarded_chunks;
                    if (forwarded_chunks > 2) {
                        throw "STREAM-REENTRY-ERROR",
                            "nested callback stream recursively re-entered";
                    }
                    dcb(chunk);
                });
            },
        });

        list<hash<auto>> seen = ();
        outer.chatStream(
            (<QoreLlmUtils::ChatMessage>{"role": "user", "content": "x"},),
            sub (hash<QoreLlmUtils::ChatStreamEvent> e) {
                push seen, {
                    "delta": e.delta,
                    "done": e.done,
                    "raw_finish": e.raw.choices[0].finish_reason,
                    "raw_usage": e.raw.usage,
                };
            });
        assertEq(1, inner_stream_calls);
        assertEq(2, forwarded_chunks);
        assertEq(2, seen.size());
        assertEq("nested", seen[0].delta);
        assertFalse(seen[0].done);
        assertEq(True, seen[1].done);
        assertEq("stop", seen[1].raw_finish);
        assertEq(2, seen[1].raw_usage.total_tokens);
    }

    callbackChatStreamSuppressesEmptyChunksTest() {
        # OpenAI commonly emits a leading chunk with `delta: {"role":
        # "assistant"}` and no content / no finish_reason.  These must be
        # suppressed — they carry no actionable signal for the agent loop
        # and would just be noise on the caller's event stream.
        code<nothing(string, string, hash<auto>, code<nothing(hash<auto>)>)>
                stream_cb =
            sub (string m, string p, hash<auto> body, code<nothing(hash<auto>)> dcb) {
                dcb({"object": "chat.completion.chunk",
                    "choices": ({"index": 0,
                        "delta": {"role": "assistant"},
                        "finish_reason": NOTHING},)});
                dcb({"object": "chat.completion.chunk",
                    "choices": ({"index": 0,
                        "delta": {"content": "real"},
                        "finish_reason": NOTHING},)});
                dcb({"object": "chat.completion.chunk",
                    "choices": ({"index": 0,
                        "delta": {},
                        "finish_reason": "stop"},)});
            };
        list<hash<auto>> seen = driveCallbackChatStream(stream_cb,
            hash<auto> sub (string m, string p, hash<auto> body) { return {}; });
        # Two events: the "real" content chunk + the terminal.  The
        # leading role-only chunk MUST be suppressed.
        assertEq(2, seen.size(),
            "leading role-only chunk must be suppressed: " + sprintf("%y", seen));
        assertEq("real", seen[0].delta);
        assertEq(True, seen[1].done);
    }

    callbackChatStreamFallbackTest() {
        # No api_stream_callback set — provider falls back to chat() and
        # synthesizes one content delta + a terminal done so the caller's
        # accumulator terminates the same way it would for a streaming
        # provider.
        list<hash<auto>> seen = ();
        QoreLlmUtils::LlmBackend b(<QoreLlmUtils::LlmBackendConfig>{
            "mode": "callback",
            "api_callback": hash<auto> sub (string m, string p, hash<auto> body) {
                return {
                    "choices": ({"message": {"role": "assistant",
                            "content": "fallback-content"},
                        "finish_reason": "stop"},),
                    "usage": {"total_tokens": 8},
                };
            },
        });
        b.chatStream(
            (<QoreLlmUtils::ChatMessage>{"role": "user", "content": "hi"},),
            sub (hash<QoreLlmUtils::ChatStreamEvent> e) {
                push seen, {"delta": e.delta, "done": e.done,
                    "raw_finish": e.raw.choices[0].finish_reason,
                    "raw_usage": e.raw.usage};
            });
        assertEq(2, seen.size());
        assertEq("fallback-content", seen[0].delta);
        assertFalse(seen[0].done);
        assertEq(True, seen[1].done);
        assertEq("stop", seen[1].raw_finish);
        assertEq(8, seen[1].raw_usage.total_tokens);
    }

    callbackChatStreamErrorWrappingTest() {
        # Upstream throws → CallbackLlmProvider wraps it as LLM-ERROR with
        # the original exception preserved in arg (matches chat()'s
        # contract so error sanitizers downstream can introspect both).
        code<nothing(string, string, hash<auto>, code<nothing(hash<auto>)>)>
                stream_cb =
            sub (string m, string p, hash<auto> body, code<nothing(hash<auto>)> dcb) {
                throw "UPSTREAM-ERROR", "simulated upstream failure";
            };
        assertThrows("LLM-ERROR", "callback chat stream failed",
            sub () {
                driveCallbackChatStream(stream_cb,
                    hash<auto> sub (string m, string p, hash<auto> body) {
                        return {};
                    });
            });
    }

    callbackChatStreamToolCallDeltasTest() {
        # Tool-call deltas (OpenAI streaming convention) come as multiple
        # chunks, each carrying a partial function name or partial
        # arguments JSON.  The provider must forward these via event.raw
        # so the agent-strategy accumulator can rebuild the complete
        # tool_call.  event.delta stays empty for tool-call-only chunks.
        code<nothing(string, string, hash<auto>, code<nothing(hash<auto>)>)>
                stream_cb =
            sub (string m, string p, hash<auto> body, code<nothing(hash<auto>)> dcb) {
                dcb({"object": "chat.completion.chunk",
                    "choices": ({"index": 0,
                        "delta": {"tool_calls": ({"index": 0,
                            "id": "call_abc",
                            "function": {"name": "get_weather"}},)},
                        "finish_reason": NOTHING},)});
                dcb({"object": "chat.completion.chunk",
                    "choices": ({"index": 0,
                        "delta": {"tool_calls": ({"index": 0,
                            "function": {"arguments": "{\"city\""}},)},
                        "finish_reason": NOTHING},)});
                dcb({"object": "chat.completion.chunk",
                    "choices": ({"index": 0,
                        "delta": {},
                        "finish_reason": "tool_calls"},)});
            };
        list<hash<auto>> seen = driveCallbackChatStream(stream_cb,
            hash<auto> sub (string m, string p, hash<auto> body) { return {}; });
        assertEq(3, seen.size(), "two tool-call delta chunks + terminal");
        # First two events have no content delta but do carry tool_calls
        # on event.raw
        assertFalse(seen[0].delta.val(),
            "tool-call-only chunk does not surface as content delta");
        assertEq(NT_LIST, seen[0].raw_tool_calls.typeCode(),
            "tool_calls survive on event.raw");
        assertEq("call_abc", seen[0].raw_tool_calls[0].id);
        # Terminal carries the tool_calls finish_reason
        assertEq(True, seen[2].done);
        assertEq("tool_calls", seen[2].raw_finish);
    }

    callbackChatStreamSafetyNetDoneTest() {
        # Malformed providers may close the stream without an
        # OpenAI-style finish_reason chunk.  The provider must still fire
        # a terminal done event so the caller's accumulator can finalize.
        code<nothing(string, string, hash<auto>, code<nothing(hash<auto>)>)>
                stream_cb =
            sub (string m, string p, hash<auto> body, code<nothing(hash<auto>)> dcb) {
                dcb({"object": "chat.completion.chunk",
                    "choices": ({"index": 0,
                        "delta": {"content": "no-terminal-from-me"},
                        "finish_reason": NOTHING},)});
                # provider returns without ever emitting a terminal chunk
            };
        list<hash<auto>> seen = driveCallbackChatStream(stream_cb,
            hash<auto> sub (string m, string p, hash<auto> body) { return {}; });
        assertEq(2, seen.size(),
            "content delta + safety-net terminal done");
        assertEq("no-terminal-from-me", seen[0].delta);
        assertEq(True, seen[1].done,
            "provider must synthesize a terminal done event");
    }
}
