    globalSetUp() {
        Logger logger("test", LoggerLevel::getLevelWarn());
        hash<HttpServerOptionInfo> http_opts = <HttpServerOptionInfo>{
            "logger": logger,
            "debug": False,
        };
        http = new HttpServer(http_opts);
        port = http.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
    }

    globalTearDown() {
        delete http;
    }

    private checkGeminiModule() {
    }

    private installGeminiHandler(hash<string, hash<auto>> responses) {
        if (gemini_handler) {
            http.removeHandler("gemini-llm");
        }
        gemini_handler = new FakeGeminiLlmHandler(responses);
        http.setHandler("gemini-llm", "/", MimeTypeJson, gemini_handler);
    }

    private LlmBackend makeGeminiBackend(*string model) {
        return new LlmBackend(<LlmBackendConfig>{
            "mode": "gemini",
            "url": "http://localhost:" + port,
            "model": model ?? "gemini-2.5-flash",
            "api_key": "gemini-test-key",
            "max_tokens": 512,
            "temperature": 0.0,
        });
    }

    private QoreLlmUtils::LlmBackend makeStaticCompletionBackend(
            string content) {
        return new QoreLlmUtils::LlmBackend(<QoreLlmUtils::LlmBackendConfig>{
            "mode": "callback",
            "model": "test-model",
            "api_callback": hash<auto> sub (string method, string path,
                    hash<auto> body) {
                return {
                    "choices": (
                        {
                            "message": {"content": content},
                            "finish_reason": "stop",
                        },
                    ),
                    "usage": {"total_tokens": 7},
                };
            },
        });
    }

    # ===================== Config Validation Tests =====================

    configInvalidModeTest() {
        assertThrows("LLM-CONFIG-ERROR", "is unknown",
            sub () {
                LlmBackend llm(<LlmBackendConfig>{"mode": "invalid"});
            }
        );
    }

    configHttpNoUrlTest() {
        assertThrows("LLM-CONFIG-ERROR", "url is required",
            sub () {
                LlmBackend llm(<LlmBackendConfig>{"mode": "http"});
            }
        );
    }

    configAnthropicNoUrlTest() {
        assertThrows("LLM-CONFIG-ERROR", "url is required",
            sub () {
                LlmBackend llm(<LlmBackendConfig>{"mode": "anthropic"});
            }
        );
    }

    configValidHttpTest() {
        LlmBackend llm(<LlmBackendConfig>{
            "mode": "http",
            "url": "http://localhost:8080",
            "model": "gpt-4o",
            "api_key": "test-key",
        });
        assertEq("http", llm.getMode());
        assertEq("gpt-4o", llm.getModel());
    }

    configValidAnthropicTest() {
        LlmBackend llm(<LlmBackendConfig>{
            "mode": "anthropic",
            "url": "https://api.anthropic.com",
            "model": "claude-sonnet-4-20250514",
            "api_key": "test-key",
        });
        assertEq("anthropic", llm.getMode());
        assertEq("claude-sonnet-4-20250514", llm.getModel());
    }

    configValidGeminiTest() {
        LlmBackend llm(<LlmBackendConfig>{
            "mode": "gemini",
            "model": "gemini-2.5-flash",
            "api_key": "test-key",
        });
        assertEq("gemini", llm.getMode());
        assertEq("gemini-2.5-flash", llm.getModel());
    }

    configGeminiNoApiKeyTest() {
        assertThrows("LLM-CONFIG-ERROR", "api_key is required",
            sub () {
                LlmBackend llm(<LlmBackendConfig>{"mode": "gemini"});
            }
        );
    }

    configValidCallbackTest() {
        LlmBackend llm(<LlmBackendConfig>{
            "mode": "callback", "api_callback": hash<auto> sub (string m, string p, hash<auto> b) { return {}; },
            "model": "my-model",
        });
        assertEq("callback", llm.getMode());
        assertEq("my-model", llm.getModel());
    }

    configDefaultsTest() {
        # Callback mode doesn't need url, so we can test defaults
        LlmBackend llm(<LlmBackendConfig>{"mode": "callback", "api_callback": hash<auto> sub (string m, string p, hash<auto> b) { return {}; }});
        assertEq("callback", llm.getMode());
        assertEq(NOTHING, llm.getModel());
    }

    gettersTest() {
        LlmBackend llm(<LlmBackendConfig>{
            "mode": "http",
            "url": "http://localhost:8080",
            "model": "test-model",
        });
        assertEq("http", llm.getMode());
        assertEq("test-model", llm.getModel());

        # Test with no model
        LlmBackend llm2(<LlmBackendConfig>{
            "mode": "http",
            "url": "http://localhost:8080",
        });
        assertEq(NOTHING, llm2.getModel());
    }

    callbackNoCallbackTest() {
        # Callback mode without api_callback should fail at construction
        assertThrows("LLM-CONFIG-ERROR", "api_callback is required",
            sub () {
                new LlmBackend(<LlmBackendConfig>{"mode": "callback"});
            }
        );
    }

    callbackDispatchOptionsTest() {
        list<hash<auto>> calls = ();
        LlmBackend llm(<LlmBackendConfig>{
            "mode": "callback",
            "model": "default-model",
            "callback_method": "PUT",
            "callback_path": "ai/v1/chat/completions",
            "api_callback": hash<auto> sub (string m, string p, hash<auto> b) {
                push calls, {"method": m, "path": p, "body": b};
                return {
                    "choices": ({"message": {"content": "ok"}, "finish_reason": "stop"},),
                    "usage": {"total_tokens": 1},
                };
            },
        });

        hash<LlmCompletionResult> complete_rv = llm.complete("system", "prompt");
        hash<ChatResponse> chat_rv = llm.chat((
            <ChatMessage>{"role": "user", "content": "hello"},
        ));

        assertEq("ok", complete_rv.content);
        assertEq("ok", chat_rv.content);
        assertEq(2, calls.size());
        assertEq("PUT", calls[0].method);
        assertEq("ai/v1/chat/completions", calls[0].path);
        assertEq("default-model", calls[0].body.model);
        assertEq("PUT", calls[1].method);
        assertEq("ai/v1/chat/completions", calls[1].path);
        assertEq("hello", calls[1].body.messages[0].content);
    }

    telemetryUsageNormalizerTest() {
        hash<LlmTokenUsage> usage = LlmTelemetry::normalizeUsage({
            "prompt_tokens": 10,
            "completion_tokens": 5,
            "prompt_tokens_details": {"cached_tokens": 3},
            "completion_tokens_details": {"reasoning_tokens": 2},
        });
        assertEq(10, usage.input_tokens);
        assertEq(5, usage.output_tokens);
        assertEq(17, usage.total_tokens);
        assertEq(3, usage.cached_input_tokens);
        assertEq(2, usage.reasoning_tokens);

        hash<LlmTokenUsage> gemini_usage = LlmTelemetry::normalizeUsage({
            "promptTokenCount": 11,
            "candidatesTokenCount": 7,
            "totalTokenCount": 18,
            "cachedContentTokenCount": 4,
        });
        assertEq(11, gemini_usage.input_tokens);
        assertEq(7, gemini_usage.output_tokens);
        assertEq(18, gemini_usage.total_tokens);
        assertEq(4, gemini_usage.cached_input_tokens);
    }

    telemetryCallbackChatTest() {
        list<hash<LlmTelemetryEvent>> events = ();
        LlmBackend llm(<LlmBackendConfig>{
            "mode": "callback",
            "model": "default-model",
            "telemetry_context": {"trace_id": "trace-1"},
            "telemetry_observer": <LlmTelemetryObserver>{
                "event_callback": sub (hash<LlmTelemetryEvent> event) {
                    push events, event;
                },
            },
            "api_callback": hash<auto> sub (string m, string p, hash<auto> b) {
                return {
                    "id": "resp-1",
                    "model": "provider-model",
                    "choices": ({"message": {"content": "ok"},
                        "finish_reason": "stop"},),
                    "usage": {"prompt_tokens": 3,
                        "completion_tokens": 4, "total_tokens": 7},
                };
            },
        });

        hash<ChatResponse> rv = llm.chat((
            <ChatMessage>{"role": "user", "content": "hello"},
        ));
        assertEq("ok", rv.content);
        assertEq(2, events.size());
        assertEq("start", events[0].type);
        assertEq("chat", events[0].operation);
        assertEq("callback", events[0].provider_mode);
        assertEq("trace-1", events[0].telemetry_context.trace_id);
        assertEq(1, events[0].request.message_count);
        assertEq(5, events[0].request.text_bytes);

        assertEq("end", events[1].type);
        assertEq("ok", events[1].status);
        assertEq("end_turn", events[1].stop_reason);
        assertEq("resp-1", events[1].response_id);
        assertEq("provider-model", events[1].model);
        assertEq(3, events[1].usage.input_tokens);
        assertEq(4, events[1].usage.output_tokens);
        assertEq(7, events[1].usage.total_tokens);
    }

    telemetryObserverFailureIsolationTest() {
        LlmBackend llm(<LlmBackendConfig>{
            "mode": "callback",
            "telemetry_observer": <LlmTelemetryObserver>{
                "event_callback": sub (hash<LlmTelemetryEvent> event) {
                    throw "OBSERVER-ERROR", "ignored";
                },
            },
            "api_callback": hash<auto> sub (string m, string p, hash<auto> b) {
                return {
                    "choices": ({"message": {"content": "still-ok"},
                        "finish_reason": "stop"},),
                    "usage": {"total_tokens": 1},
                };
            },
        });
        hash<ChatResponse> rv = llm.chat((
            <ChatMessage>{"role": "user", "content": "hello"},
        ));
        assertEq("still-ok", rv.content);
    }

    requestOptionsOverrideModelTest() {
        hash<auto> captured;
        LlmBackend llm(<LlmBackendConfig>{
            "mode": "callback",
            "model": "default-model",
            "api_callback": hash<auto> sub (string m, string p, hash<auto> b) {
                captured = b;
                return {
                    "choices": ({"message": {"content": "ok"}, "finish_reason": "stop"},),
                    "usage": {},
                };
            },
        });
        hash<ChatResponse> rv = llm.chat((
            <ChatMessage>{"role": "user", "content": "hello"},
        ), NOTHING, <LlmRequestOptions>{
            "model": "cheap-task-model",
            "max_output_tokens": 321,
            "reasoning_token_budget": 111,
            "temperature": 0.2,
            "body_options": {"reasoning_effort": "low"},
        });
        assertEq("ok", rv.content);
        assertEq("cheap-task-model", captured.model);
        assertEq(321, captured.max_tokens);
        assertEq(111, captured.reasoning_token_budget);
        assertEq(0.2, captured.temperature);
        assertEq("low", captured.reasoning_effort);
    }

    structuredRepairJsonTextTest() {
        checkGeminiModule();
        hash<LlmStructuredRepairResult> repaired =
            LlmStructuredRepair::parseJsonObject(
                "<think>hidden reasoning</think>```json\n"
                "{\"ok\":true,\"items\":[1]}\n``` trailing text");

        assertTrue(repaired.valid, "balanced JSON prefix is parsed");
        assertTrue(repaired.repaired, "prefix parsing is reported as repair");
        assertEq("json-balanced-prefix", repaired.repair_kind,
            "repair type is exposed");
        hash<auto> value = cast<hash>(repaired.value);
        assertEq(True, value.ok, "object fields are preserved");
        assertEq(1, value.items[0], "array values are preserved");

        hash<LlmStructuredRepairResult> invalid =
            LlmStructuredRepair::parseJsonObject("{\"ok\":");
        assertFalse(invalid.valid, "invalid JSON is rejected");
        assertEq("invalid-json", invalid.error_code,
            "parse errors have a stable code");
        assertTrue(invalid.failure_fingerprint.find("invalid-json:") == 0,
            "parse errors have a stable fingerprint prefix");
    }

    structuredRepairEmbeddedJsonTextTest() {
        checkGeminiModule();
        hash<LlmStructuredRepairResult> repaired =
            LlmStructuredRepair::parseJsonObject(
                "Here is the corrected tool payload:\n"
                "{\"ok\": True, \"items\": [1]}\n"
                "Use this exact JSON.");

        assertTrue(repaired.valid,
            "prose-wrapped JSON object is extracted and parsed");
        assertTrue(repaired.repaired,
            "embedded object extraction is reported as a repair");
        assertEq("json-python-literals-embedded", repaired.repair_kind,
            "repair kind identifies literal normalization plus extraction");
        hash<auto> value = cast<hash>(repaired.value);
        assertEq(True, value.ok,
            "Python literal is normalized inside embedded JSON");
        assertEq(1, value.items[0],
            "embedded array member is preserved");

        hash<LlmStructuredRepairResult> array_repaired =
            LlmStructuredRepair::parseJsonArray(
                "Candidates:\n[{\"key\":\"a\"}]\nDone.");
        assertTrue(array_repaired.valid,
            "prose-wrapped JSON array is extracted and parsed");
        assertEq("json-balanced-embedded", array_repaired.repair_kind,
            "array extraction exposes the generic embedded repair kind");
        list<auto> array_value = cast<list>(array_repaired.value);
        assertEq("a", array_value[0].key,
            "embedded array object is preserved");
    }

    structuredRepairPythonLiteralJsonTest() {
        checkGeminiModule();
        hash<LlmStructuredRepairResult> repaired =
            LlmStructuredRepair::parseJsonObject(
                "{\"ok\": True, \"skip\": False, \"value\": None, "
                "\"text\": \"True False None\"}");

        assertTrue(repaired.valid,
            "Python-style JSON literals are normalized outside strings");
        assertTrue(repaired.repaired,
            "literal normalization is reported as a repair");
        assertEq("json-python-literals", repaired.repair_kind,
            "repair kind identifies Python literal normalization");
        hash<auto> value = cast<hash>(repaired.value);
        assertEq(True, value.ok, "True became JSON true");
        assertEq(False, value.skip, "False became JSON false");
        assertEq(NOTHING, value.value, "None became JSON null");
        assertEq("True False None", value.text,
            "string contents are not rewritten");
    }

    structuredRepairBalancedCompletionTest() {
        checkGeminiModule();
        hash<LlmStructuredRepairResult> repaired =
            LlmStructuredRepair::parseJsonObject(
                "{\"interface\":{\"key\":\"iface-1\",\"items\":[1,2]}");

        assertTrue(repaired.valid,
            "missing trailing object close braces are repaired");
        assertTrue(repaired.repaired,
            "balanced completion is reported as a repair");
        assertEq("json-balanced-completion", repaired.repair_kind,
            "repair type identifies appended delimiters");
        hash<auto> value = cast<hash>(repaired.value);
        assertEq("iface-1", value.interface.key,
            "nested object survived balanced completion");
        assertEq(2, value.interface.items[1],
            "nested array survived balanced completion");

        hash<LlmStructuredRepairResult> invalid =
            LlmStructuredRepair::parseJsonObject(
                "{\"interface\":{\"key\":\"unterminated}");
        assertFalse(invalid.valid,
            "unterminated strings are not guessed/repaired");
    }

    structuredRepairSchemaCoercionTest() {
        checkGeminiModule();
        hash<auto> schema = {
            "type": "object",
            "properties": {
                "payload": {
                    "type": "object",
                    "properties": {
                        "ids": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {"value": {"type": "string"}},
                            },
                        },
                    },
                },
                "steps": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "payload": {
                                "type": "object",
                                "properties": {"key": {"type": "string"}},
                            },
                        },
                    },
                },
            },
        };
        hash<auto> raw = {
            "payload": "{\"ids\":[{\"value\":\"req-15\"}]}",
            "steps": "[{\"operation\":\"revise_interface\","
                "\"payload\":\"{\\\"key\\\":\\\"iface-fsm\\\"}\"}]",
        };

        hash<LlmStructuredRepairResult> repaired =
            LlmStructuredRepair::coerceBySchema(raw, schema);
        assertTrue(repaired.valid, "schema coercion succeeds");
        assertTrue(repaired.repaired, "schema coercion reports repair");
        assertEq("schema-json-string", repaired.repair_kind,
            "schema repair type is exposed");
        hash<auto> value = cast<hash>(repaired.value);
        assertEq("req-15", value.payload.ids[0].value,
            "stringified object fields are parsed");
        assertEq("iface-fsm", value.steps[0].payload.key,
            "stringified arrays and nested objects are parsed");
    }

    requestClassifierSemanticPolicyTest() {
        QoreLlmUtils::LlmBackend backend = makeStaticCompletionBackend(
            "{\"allowed\":false,\"detected_language\":\"cs\","
            "\"domain\":\"creative-writing\",\"task_category\":\"story\","
            "\"confidence\":0.92,\"blocked_category\":\"creative-writing\","
            "\"reason_code\":\"blocked-task-category\","
            "\"reason\":\"creative writing is outside the supplied policy\"}");
        QoreLlmUtils::LlmRequestClassifier classifier(backend, {
            "policy_label": "ops-only",
            "allowed_domains": ("operations",),
            "blocked_task_categories": ("creative-writing",),
        });

        hash<QoreLlmUtils::LlmRequestClassification> r =
            classifier.classify("napiš mi povídku");
        assertFalse(r.allowed);
        assertEq("cs", r.detected_language);
        assertEq("creative-writing", r.blocked_category);
        assertEq("blocked-task-category", r.reason_code);
        assertTrue(r.confidence > 0.9);
        assertEq(7, r.usage.total_tokens);

        # The structured-output schema must be a bare JSON Schema object:
        # it must NOT carry a top-level "name" (or other dialect metadata),
        # which providers with a strict OpenAPI Schema subset (Gemini)
        # reject with INVALID_ARGUMENT.  The schema label belongs on the
        # request wrapper, not inside the schema.
        hash<auto> output_schema =
            QoreLlmUtils::LlmRequestClassifier::getOutputSchema();
        assertEq("object", output_schema.type);
        assertFalse(output_schema.hasKey("name"),
            "classifier output schema carries no top-level 'name' metadata");
        assertTrue(output_schema.properties.hasKey("allowed"),
            "classifier output schema declares the 'allowed' verdict field");
        assertTrue(inlist("allowed", output_schema.required),
            "classifier output schema requires the 'allowed' verdict field");
    }

    actionIntentClassifierBudgetTest() {
        hash<auto> captured;
        QoreLlmUtils::LlmBackend backend(<QoreLlmUtils::LlmBackendConfig>{
            "mode": "callback",
            "model": "test-model",
            "api_callback": hash<auto> sub (string m, string p,
                    hash<auto> body) {
                captured = body;
                return {
                    "choices": ({
                        "message": {"content": "INTENT: read-only"},
                        "finish_reason": "stop",
                    },),
                    "usage": {"total_tokens": 3},
                };
            },
        });
        QoreLlmUtils::ActionIntentClassifier classifier(backend);
        *string intent = classifier.classify("how do I create a workflow?");
        assertEq("read-only", intent,
            "classifier parses the INTENT label");
        # Intent classification disables hidden reasoning so a thinking model
        # cannot drain the output budget and return empty content.
        assertEq(0, captured.reasoning_token_budget,
            "action-intent classifier disables the reasoning/thinking budget");
    }

    requestClassifierBlockListModeTest() {
        # Capture the request body the classifier dispatches so we can assert
        # (1) block-list mode selects a default-allow system prompt, and
        # (2) classification disables the hidden-reasoning budget so a
        # "thinking" model cannot starve the small JSON output budget.
        hash<auto> captured_allow;
        QoreLlmUtils::LlmBackend allow_backend(
            <QoreLlmUtils::LlmBackendConfig>{
                "mode": "callback",
                "model": "test-model",
                "api_callback": hash<auto> sub (string m, string p,
                        hash<auto> body) {
                    captured_allow = body;
                    return {
                        "choices": ({
                            "message": {"content":
                                "{\"allowed\":true,\"detected_language\":"
                                "\"en\",\"domain\":\"qorus\",\"task_category\":"
                                "\"operations\",\"confidence\":0.95,"
                                "\"reason_code\":\"classified\",\"reason\":"
                                "\"in scope\"}"},
                            "finish_reason": "stop",
                        },),
                        "usage": {"total_tokens": 9},
                    };
                },
            });
        QoreLlmUtils::LlmRequestClassifier allow_classifier(allow_backend, {
            "policy_label": "qonsole-qorus-qore-only",
            "default_decision": "allow",
            "blocked_task_categories": ("creative-writing",),
        });
        hash<QoreLlmUtils::LlmRequestClassification> ra =
            allow_classifier.classify("how many qogs are there?");
        assertTrue(ra.allowed, "block-list mode allows an in-scope request");
        assertEq("system", captured_allow.messages[0].role);
        assertTrue(captured_allow.messages[0].content =~ /ALLOWED by default/,
            "block-list mode uses a default-allow system prompt");
        assertEq(0, captured_allow.reasoning_token_budget,
            "classifier disables the reasoning/thinking budget");

        # The default (allow-list) mode keeps the stricter "allowed only when"
        # semantics for callers that want a positive-match policy.
        hash<auto> captured_block;
        QoreLlmUtils::LlmBackend block_backend(
            <QoreLlmUtils::LlmBackendConfig>{
                "mode": "callback",
                "model": "test-model",
                "api_callback": hash<auto> sub (string m, string p,
                        hash<auto> body) {
                    captured_block = body;
                    return {
                        "choices": ({
                            "message": {"content":
                                "{\"allowed\":false,\"detected_language\":"
                                "\"en\",\"domain\":\"unknown\","
                                "\"task_category\":\"unknown\","
                                "\"confidence\":0.4,\"reason_code\":"
                                "\"classification-uncertain\",\"reason\":"
                                "\"unclear\"}"},
                            "finish_reason": "stop",
                        },),
                        "usage": {"total_tokens": 9},
                    };
                },
            });
        QoreLlmUtils::LlmRequestClassifier block_classifier(block_backend, {
            "policy_label": "ops-only",
            "allowed_domains": ("operations",),
        });
        block_classifier.classify("hello");
        assertTrue(captured_block.messages[0].content =~ /allowed only when/,
            "default mode keeps allow-list semantics");
    }

    citationValidatorTest() {
        list<hash<QoreLlmUtils::LlmSourceRef>> sources = (
            <QoreLlmUtils::LlmSourceRef>{
                "source_id": "qorus-docs",
                "title": "Qorus docs",
                "snippet": "Qorus workflows coordinate jobs and services.",
            },
        );
        hash<QoreLlmUtils::CitationValidationResult> ok =
            QoreLlmUtils::CitationValidator::validate(
                "Qorus workflows coordinate jobs [source:qorus-docs].",
                sources, {"require_citations": True});
        assertTrue(ok.passed);
        assertEq(("qorus-docs",), ok.cited_source_ids);
        assertEq(1.0, ok.citation_coverage);

        hash<QoreLlmUtils::CitationValidationResult> missing =
            QoreLlmUtils::CitationValidator::validate(
                "Qorus workflows coordinate jobs.", sources,
                {"require_citations": True});
        assertFalse(missing.passed);
        assertEq(("citation-required",), missing.missing_citations);
    }

    groundedAnswerVerifierTest() {
        QoreLlmUtils::LlmBackend backend = makeStaticCompletionBackend(
            "{\"grounded\":true,\"grounding_score\":0.88,"
            "\"supported_claims\":[\"Qorus workflows coordinate jobs\"],"
            "\"unsupported_claims\":[],\"missing_citations\":[],"
            "\"reason\":\"supported by source\"}");
        QoreLlmUtils::GroundedAnswerVerifier verifier(backend, {
            "require_sources": True,
            "require_citations": True,
            "min_grounding_score": 0.75,
        });
        list<hash<QoreLlmUtils::LlmSourceRef>> sources =
            QoreLlmUtils::GroundedAnswerVerifier::buildSourceBundle((
                {
                    "source_id": "qorus-docs",
                    "title": "Qorus docs",
                    "snippet": "Qorus workflows coordinate jobs and services.",
                },
            ));

        hash<QoreLlmUtils::GroundingVerificationResult> r =
            verifier.verify("Qorus workflows coordinate jobs [source:qorus-docs].",
                sources);
        assertTrue(r.passed);
        assertEq(0.88, r.grounding_score);
        assertEq(1.0, r.citation_coverage);
        assertEq(7, r.usage.total_tokens);

        # Grounding verification disables hidden reasoning so a thinking model
        # cannot starve the (small) JSON output budget and truncate the verdict
        # to empty/unparseable JSON.  Capture the dispatched body to confirm.
        hash<auto> captured;
        QoreLlmUtils::LlmBackend cap_backend(<QoreLlmUtils::LlmBackendConfig>{
            "mode": "callback",
            "model": "test-model",
            "api_callback": hash<auto> sub (string m, string p,
                    hash<auto> body) {
                captured = body;
                return {
                    "choices": ({
                        "message": {"content":
                            "{\"grounded\":true,\"grounding_score\":0.9,"
                            "\"supported_claims\":[],\"unsupported_claims\":[],"
                            "\"missing_citations\":[],\"reason\":\"ok\"}"},
                        "finish_reason": "stop",
                    },),
                    "usage": {"total_tokens": 5},
                };
            },
        });
        QoreLlmUtils::GroundedAnswerVerifier cap_verifier(cap_backend, {
            "require_sources": True,
            "require_citations": False,
            "min_grounding_score": 0.5,
        });
        cap_verifier.verify("Qorus has three services.", sources);
        assertEq(0, captured.reasoning_token_budget,
            "grounding verifier disables the reasoning/thinking budget");
        hash<auto> gschema =
            QoreLlmUtils::GroundedAnswerVerifier::getOutputSchema();
        assertFalse(gschema.hasKey("name"),
            "grounding output schema carries no top-level 'name' metadata");
    }

    geminiChatRequestAndTextResponseTest() {
        checkGeminiModule();
        installGeminiHandler({
            "/v1beta/models/gemini-2.5-pro:generateContent": {
                "code": 200,
                "body": {
                    "responseId": "gemini-chat-1",
                    "candidates": ({
                        "finishReason": "STOP",
                        "content": {
                            "parts": ({"text": "done"},),
                        },
                    },),
                    "usageMetadata": {
                        "promptTokenCount": 7,
                        "candidatesTokenCount": 3,
                        "totalTokenCount": 15,
                        "cachedContentTokenCount": 4,
                        "thoughtsTokenCount": 5,
                    },
                },
            },
        });

        LlmBackend llm = makeGeminiBackend();
        hash<ChatResponse> rv = llm.chat((
            <ChatMessage>{"role": "system", "content": "be precise"},
            <ChatMessage>{
                "role": "user",
                "content_parts": (
                    <ContentPart>{"type": "text", "text": "inspect"},
                    <ContentPart>{
                        "type": "image",
                        "data": parse_base64_string("aW1n"),
                        "mime_type": "image/png",
                    },
                ),
            },
        ), (
            <ToolDefinition>{
                "name": "lookup",
                "description": "lookup data",
                "parameters": {
                    "type": "object",
                    "properties": {"key": {"type": "string"}},
                },
            },
        ), <LlmRequestOptions>{
            "model": "gemini-2.5-pro",
            "max_output_tokens": 128,
            "reasoning_token_budget": 64,
            "temperature": 0.2,
        });

        assertEq("done", rv.content);
        assertEq("end_turn", rv.stop_reason);
        assertEq(15, rv.usage.total_tokens);
        assertEq(4, rv.usage.cache_read_input_tokens,
            "Gemini cached input tokens are normalized for cost accounting");
        assertEq(4, rv.usage.cached_content_token_count,
            "Gemini native cached token count is preserved");
        assertEq(5, rv.usage.reasoning_tokens,
            "Gemini thinking tokens are normalized as reasoning tokens");
        assertEq(1, gemini_handler.requests.size());
        assertEq("/v1beta/models/gemini-2.5-pro:generateContent",
            gemini_handler.requests[0].path);
        assertEq("POST", gemini_handler.requests[0].method);
        assertEq("gemini-test-key", gemini_handler.requests[0].api_key);
        assertEq("be precise",
            gemini_handler.requests[0].body.systemInstruction.parts[0].text);
        assertEq("inspect",
            gemini_handler.requests[0].body.contents[0].parts[0].text);
        assertEq("image/png",
            gemini_handler.requests[0].body.contents[0].parts[1].inlineData.mimeType);
        assertEq("aW1n",
            gemini_handler.requests[0].body.contents[0].parts[1].inlineData.data);
        assertEq(128,
            gemini_handler.requests[0].body.generationConfig.maxOutputTokens);
        assertEq(0.2,
            gemini_handler.requests[0].body.generationConfig.temperature);
        assertEq(64,
            gemini_handler.requests[0].body.generationConfig.thinkingConfig.thinkingBudget);
        assertEq("lookup",
            gemini_handler.requests[0].body.tools[0].functionDeclarations[0].name);
    }

    providerPerCallRetryBudgetTest() {
        checkGeminiModule();
        hash<auto> success = {
            "code": 200,
            "body": {
                "responseId": "gemini-retry-budget",
                "candidates": ({
                    "finishReason": "STOP",
                    "content": {"parts": ({"text": "retried"},)},
                },),
                "usageMetadata": {"totalTokenCount": 3},
            },
        };
        hash<auto> unavailable = {
            "code": 503,
            "body": {
                "error": {
                    "status": "UNAVAILABLE",
                    "message": "retry test",
                },
            },
        };
        hash<auto> request = {
            "messages": ({"role": "user", "content": "test retries"},),
        };

        installGeminiHandler({
            "/v1beta/models/gemini-2.5-flash:generateContent":
                {"sequence": (unavailable, success)},
        });
        LlmBackend no_retry = makeGeminiBackend();
        assertThrows("LLM-ERROR", "request to", sub () {
            no_retry.chatCompletions(request + {"max_retries": 0});
        });
        assertEq(1, gemini_handler.requests.size(),
            "zero retries makes only the initial provider request");
        assertFalse(gemini_handler.requests[0].body.hasKey("max_retries"),
            "the facade retry extension is not sent in the native body");

        installGeminiHandler({
            "/v1beta/models/gemini-2.5-flash:generateContent":
                {"sequence": (unavailable, success)},
        });
        LlmBackend one_retry = makeGeminiBackend();
        hash<auto> recovered = one_retry.chatCompletions(
            request + {"max_retries": 1});
        assertEq(2, gemini_handler.requests.size(),
            "one retry permits exactly two provider requests");
        assertEq("retried", recovered.choices[0].message.content,
            "the per-call retry returns the successful second response");

        installGeminiHandler({
            "/v1beta/models/gemini-2.5-flash:generateContent":
                {"sequence": (unavailable, success)},
        });
        LlmBackend configured_default(<LlmBackendConfig>{
            "mode": "gemini",
            "url": "http://localhost:" + port,
            "model": "gemini-2.5-flash",
            "api_key": "gemini-test-key",
            "max_retries": 1,
            "retry_delay_ms": 1,
        });
        configured_default.chatCompletions(request);
        assertEq(2, gemini_handler.requests.size(),
            "omitting the override retains the backend retry default");
    }

    geminiToolCallResponseTest() {
        checkGeminiModule();
        installGeminiHandler({
            "/v1beta/models/gemini-2.5-flash:generateContent": {
                "code": 200,
                "body": {
                    "candidates": ({
                        "finishReason": "STOP",
                        "content": {
                            "parts": ({
                                "functionCall": {
                                    "name": "lookup",
                                    "args": {"key": "customer"},
                                },
                            },),
                        },
                    },),
                    "usageMetadata": {"totalTokenCount": 4},
                },
            },
        });

        LlmBackend llm = makeGeminiBackend();
        hash<ChatResponse> rv = llm.chat((
            <ChatMessage>{"role": "user", "content": "lookup customer"},
        ), (
            <ToolDefinition>{"name": "lookup"},
        ));

        assertEq("tool_use", rv.stop_reason);
        assertEq("lookup", rv.tool_calls[0].name);
        assertEq("customer", rv.tool_calls[0].arguments.key);
        assertEq("/v1beta/models/gemini-2.5-flash:generateContent",
            gemini_handler.requests[0].path);
        assertEq("lookup customer",
            gemini_handler.requests[0].body.contents[0].parts[0].text);
        assertEq("gemini_generate_content",
            rv.provider_diagnostics.wire_protocol,
            "diagnostics identify the provider wire protocol");
        assertEq(1, rv.provider_diagnostics.wire_candidate_count,
            "diagnostics count provider candidates");
        assertEq(1, rv.provider_diagnostics.wire_part_count,
            "diagnostics count provider response parts");
        assertEq(1, rv.provider_diagnostics.wire_function_call_count,
            "diagnostics observe provider-native function calls");
        assertTrue(rv.provider_diagnostics.wire_function_call_observed,
            "diagnostics distinguish provider emission from normalization");
        assertFalse(rv.provider_diagnostics.wire_text_observed,
            "tool-only provider responses are identified without content");
    }

    #! Gemini 3.x rejects a replayed function call that lost its reasoning signature
    /** The signature arrives as a sibling of `functionCall` on the response part and must be echoed
        back verbatim on the `functionCall` part of the follow-up request, or the API answers
        HTTP 400 "Function call is missing a thought_signature in functionCall parts".  It has to
        survive the round trip through the backend's neutral OpenAI-shaped conversation format.
    */
    geminiToolCallThoughtSignatureTest() {
        checkGeminiModule();
        installGeminiHandler({
            "/v1beta/models/gemini-2.5-flash:generateContent": {
                "sequence": ({
                    "code": 200,
                    "body": {
                        "candidates": ({
                            "finishReason": "STOP",
                            "content": {
                                "parts": ({
                                    "thoughtSignature": "sig-abc-123",
                                    "functionCall": {
                                        "name": "lookup",
                                        "args": {"key": "customer"},
                                    },
                                }, {
                                    "thoughtSignature": "sig-def-456",
                                    "functionCall": {
                                        "name": "lookup",
                                        "args": {"key": "order"},
                                    },
                                },),
                            },
                        },),
                        "usageMetadata": {"totalTokenCount": 4},
                    },
                }, {
                    "code": 200,
                    "body": {
                        "candidates": ({
                            "finishReason": "STOP",
                            "content": {"parts": ({"text": "done"},)},
                        },),
                        "usageMetadata": {"totalTokenCount": 6},
                    },
                }),
            },
        });

        LlmBackend llm = makeGeminiBackend();
        hash<ChatResponse> rv = llm.chat((
            <ChatMessage>{"role": "user", "content": "lookup customer"},
        ), (
            <ToolDefinition>{"name": "lookup"},
        ));

        assertEq("tool_use", rv.stop_reason);
        assertEq("sig-abc-123", rv.tool_calls[0].thought_signature,
            "the reasoning signature is parsed from the response part");
        assertEq("sig-def-456", rv.tool_calls[1].thought_signature,
            "each function call carries its own reasoning signature");

        # replay the tool calls with their results, exactly as an agent loop does
        hash<ChatResponse> rv2 = llm.chat((
            <ChatMessage>{"role": "user", "content": "lookup customer"},
            <ChatMessage>{
                "role": "assistant",
                "tool_calls": rv.tool_calls,
            },
            <ChatMessage>{
                "role": "tool",
                "name": "lookup",
                "tool_call_id": rv.tool_calls[0].id,
                "content": "{\"result\":\"ok\"}",
            },
            <ChatMessage>{
                "role": "tool",
                "name": "lookup",
                "tool_call_id": rv.tool_calls[1].id,
                "content": "{\"result\":\"order-ok\"}",
            },
        ), (
            <ToolDefinition>{"name": "lookup"},
        ));
        assertEq("done", rv2.content);

        list<auto> replayed =
            gemini_handler.requests[1].body.contents[1].parts;
        assertEq("lookup", replayed[0].functionCall.name,
            "the assistant turn replays the function call");
        assertEq("sig-abc-123", replayed[0].thoughtSignature,
            "the replayed function call carries its reasoning signature back");
        assertEq("sig-def-456", replayed[1].thoughtSignature,
            "every replayed function call carries its own signature back");
        assertEq(3, gemini_handler.requests[1].body.contents.size(),
            "parallel tool results form one follow-up user turn");
        list<auto> responses =
            gemini_handler.requests[1].body.contents[2].parts;
        assertEq(2, responses.size(),
            "parallel function calls have the same number of responses");
        assertEq("lookup", responses[0].functionResponse.name,
            "the first response preserves its function name");
        assertEq("lookup", responses[1].functionResponse.name,
            "the second response preserves its function name");
        assertEq("order-ok",
            responses[1].functionResponse.response.result,
            "the second response remains distinct in the grouped turn");
    }

    #! A STREAMED Gemini tool call must keep its reasoning signature exactly like a non-streamed one
    /** The streaming path assembles tool calls through the OpenAI stream-state harvest
        (getOpenAiToolCallDeltas()) instead of parseChatResponse(); before the fix the harvest
        dropped the part's \c thoughtSignature, so every streamed tool call poisoned the
        conversation and the follow-up request was rejected with HTTP 400 "Function call is
        missing a thought_signature in functionCall parts".
    */
    geminiStreamedToolCallThoughtSignatureTest() {
        checkGeminiModule();
        # harvest a raw streamed chunk exactly as chatCompletionsStream() does
        object provider = create_object("GeminiLlmProvider",
            <LlmBackendConfig>{
                "mode": "gemini",
                "url": "http://localhost:" + port,
                "model": "gemini-2.5-flash",
                "api_key": "gemini-test-key",
            });
        hash<auto> state = {
            "id": NOTHING,
            "model": "gemini-2.5-flash",
            "content": "",
            "tool_calls": (),
            "finish_reason": NOTHING,
            "usage": NOTHING,
        };
        hash<auto> raw_chunk = {
            "candidates": ({
                "content": {
                    "parts": ({
                        "thoughtSignature": "sig-stream-abc",
                        "functionCall": {
                            "name": "lookup",
                            "args": {"key": "customer"},
                        },
                    }, {
                        "thoughtSignature": "sig-stream-def",
                        "functionCall": {
                            "name": "lookup",
                            "args": {"key": "order"},
                        },
                    },),
                },
            },),
        };
        provider.updateOpenAiStreamStateFromRaw(\state, raw_chunk);
        list<hash<auto>> streamed = provider.getOpenAiToolCallDeltas(\state,
            raw_chunk);

        assertEq(2, streamed.size(),
            "the streamed harvest assembles both tool calls");
        assertEq("sig-stream-abc", streamed[0].thought_signature,
            "streamed tool-call deltas carry the reasoning signature");
        assertEq("sig-stream-def", streamed[1].thought_signature,
            "every streamed delta carries its own reasoning signature");
        assertEq("sig-stream-abc", state.tool_calls[0].thought_signature,
            "the accumulated stream state keeps the first call's signature");
        assertEq("sig-stream-def", state.tool_calls[1].thought_signature,
            "the accumulated stream state keeps every call's own signature");
        assertEq("lookup", state.tool_calls[0]."function".name,
            "the harvest still produces the OpenAI tool-call shape");
        assertEq(1, state.provider_diagnostics.wire_stream_event_count,
            "stream diagnostics count provider events");
        assertEq(2,
            state.provider_diagnostics.wire_function_call_count_max,
            "stream diagnostics retain the maximum native call count");
        assertTrue(state.provider_diagnostics.wire_function_call_observed,
            "stream diagnostics retain native call observation");
        assertFalse(state.provider_diagnostics.hasKey("content"),
            "stream diagnostics do not retain generated content");
        # a part without a signature must not create the key at all
        hash<auto> plain_state = {"tool_calls": ()};
        provider.getOpenAiToolCallDeltas(\plain_state, {
            "candidates": ({
                "content": {
                    "parts": ({
                        "functionCall": {"name": "lookup", "args": {}},
                    },),
                },
            },),
        });
        assertFalse(plain_state.tool_calls[0].hasKey("thought_signature"),
            "a signature-less part yields a tool call without the key");

        # replay the harvested tool calls through the OpenAI facade exactly as
        # an agent loop does and verify the signatures reach the wire again
        installGeminiHandler({
            "/v1beta/models/gemini-2.5-flash:generateContent": {
                "code": 200,
                "body": {
                    "candidates": ({
                        "finishReason": "STOP",
                        "content": {"parts": ({"text": "done"},)},
                    },),
                    "usageMetadata": {"totalTokenCount": 6},
                },
            },
        });
        LlmBackend llm = makeGeminiBackend();
        hash<auto> rv = llm.chatCompletions({
            "messages": (
                {"role": "user", "content": "lookup customer"},
                {"role": "assistant", "tool_calls": state.tool_calls},
                {
                    "role": "tool",
                    "name": "lookup",
                    "tool_call_id": state.tool_calls[0].id,
                    "content": "{\"result\":\"ok\"}",
                },
                {
                    "role": "tool",
                    "name": "lookup",
                    "tool_call_id": state.tool_calls[1].id,
                    "content": "{\"result\":\"order-ok\"}",
                },
            ),
            "tools": ({
                "type": "function",
                "function": {"name": "lookup"},
            },),
        });
        assertEq("done", rv.choices[0].message.content);

        list<auto> replayed =
            gemini_handler.requests[0].body.contents[1].parts;
        assertEq("sig-stream-abc", replayed[0].thoughtSignature,
            "the replayed streamed call carries its reasoning signature back");
        assertEq("sig-stream-def", replayed[1].thoughtSignature,
            "every replayed streamed call carries its own signature back");
        assertEq(2,
            gemini_handler.requests[0].body.contents[2].parts.size(),
            "streamed parallel calls replay all responses in one user turn");
    }

    geminiOpenAiChatCompletionsFacadeTest() {
        checkGeminiModule();
        installGeminiHandler({
            "/v1beta/models/gemini-2.5-pro:generateContent": {
                "code": 200,
                "body": {
                    "responseId": "gemini-openai-1",
                    "candidates": ({
                        "finishReason": "STOP",
                        "content": {
                            "parts": (
                                {"text": "done"},
                                {
                                    "functionCall": {
                                        "name": "lookup",
                                        "args": {"key": "customer"},
                                    },
                                },
                            ),
                        },
                    },),
                    "usageMetadata": {
                        "promptTokenCount": 9,
                        "candidatesTokenCount": 4,
                        "totalTokenCount": 13,
                    },
                },
            },
        });

        LlmBackend llm = makeGeminiBackend();
        hash<auto> rv = llm.chatCompletions({
            "model": "gemini-2.5-pro",
            "messages": (
                {"role": "system", "content": "be concise"},
                {
                    "role": "user",
                    "content": (
                        {"type": "text", "text": "inspect this"},
                        {
                            "type": "image_url",
                            "image_url": {
                                "url": "data:image/png;base64,aW1n",
                            },
                        },
                    ),
                },
            ),
            "max_completion_tokens": 256,
            "temperature": 0.1,
            "generationConfig": {
                "thinkingConfig": {"thinkingBudget": 32},
            },
            "response_format": {
                "type": "json_schema",
                "json_schema": {
                    "schema": {
                        "type": "object",
                        "additionalProperties": False,
                        "properties": {
                            "ok": {"type": "boolean"},
                            "meta": {
                                "type": "object",
                                "additionalProperties": False,
                                "properties": {"source": {"type": "string"}},
                            },
                        },
                    },
                },
            },
            "tools": ({
                "type": "function",
                "function": {
                    "name": "lookup",
                    "description": "lookup data",
                    "parameters": {
                        "type": "object",
                        "additionalProperties": False,
                        "properties": {
                            "key": {"type": "string"},
                            "meta": {
                                "type": "object",
                                "additionalProperties": False,
                                "properties": {"source": {"type": "string"}},
                            },
                        },
                    },
                },
            },),
            "tool_choice": {
                "type": "function",
                "function": {"name": "lookup"},
            },
        });

        assertEq("gemini-openai-1", rv.id,
            "Gemini responseId is exposed as OpenAI id");
        assertEq("gemini-2.5-pro", rv.model,
            "requested model is exposed in OpenAI response");
        assertEq("done", rv.choices[0].message.content,
            "text content is normalized");
        assertEq("tool_calls", rv.choices[0].finish_reason,
            "Gemini function call maps to OpenAI tool_calls finish reason");
        assertEq("lookup",
            rv.choices[0].message.tool_calls[0].function.name,
            "function call name is normalized");
        assertEq("{\"key\":\"customer\"}",
            rv.choices[0].message.tool_calls[0].function.arguments,
            "function call arguments are serialized");
        assertEq(13, rv.usage.total_tokens,
            "Gemini usage is normalized");

        assertEq("be concise",
            gemini_handler.requests[0].body.systemInstruction.parts[0].text,
            "system message moved to Gemini systemInstruction");
        assertEq("inspect this",
            gemini_handler.requests[0].body.contents[0].parts[0].text,
            "OpenAI user text block converted");
        assertEq("image/png",
            gemini_handler.requests[0].body.contents[0].parts[1].inlineData.mimeType,
            "OpenAI image URL MIME type converted");
        assertEq("aW1n",
            gemini_handler.requests[0].body.contents[0].parts[1].inlineData.data,
            "OpenAI image URL payload converted");
        assertEq(256,
            gemini_handler.requests[0].body.generationConfig.maxOutputTokens,
            "max_completion_tokens maps to maxOutputTokens");
        assertEq(0.1,
            gemini_handler.requests[0].body.generationConfig.temperature,
            "temperature maps to generationConfig");
        assertEq(32,
            gemini_handler.requests[0].body.generationConfig.thinkingConfig.thinkingBudget,
            "provider generationConfig is preserved");
        assertEq("application/json",
            gemini_handler.requests[0].body.generationConfig.responseMimeType,
            "json_schema response format maps to Gemini JSON mode");
        assertFalse(gemini_handler.requests[0].body.generationConfig
                .responseSchema.hasKey("additionalProperties"),
            "Gemini response schema strips unsupported additionalProperties");
        assertFalse(gemini_handler.requests[0].body.generationConfig
                .responseSchema.properties.meta.hasKey(
                "additionalProperties"),
            "Gemini response schema strips nested additionalProperties");
        assertEq("lookup",
            gemini_handler.requests[0].body.tools[0].functionDeclarations[0].name,
            "OpenAI function tool declaration converted");
        assertFalse(gemini_handler.requests[0].body.tools[0]
                .functionDeclarations[0].parameters.hasKey(
                "additionalProperties"),
            "Gemini tool schema strips unsupported additionalProperties");
        assertFalse(gemini_handler.requests[0].body.tools[0]
                .functionDeclarations[0].parameters.properties.meta.hasKey(
                "additionalProperties"),
            "Gemini tool schema strips nested additionalProperties");
        assertEq("ANY",
            gemini_handler.requests[0].body.toolConfig.functionCallingConfig.mode,
            "named tool choice forces function calling");
        assertEq("lookup",
            gemini_handler.requests[0].body.toolConfig.functionCallingConfig.allowedFunctionNames[0],
            "named tool choice limits the allowed function");
    }

    geminiSchemaCompositionSanitizerTest() {
        checkGeminiModule();
        installGeminiHandler({
            "/v1beta/models/gemini-2.5-flash:generateContent": {
                "code": 200,
                "body": {
                    "candidates": ({
                        "finishReason": "STOP",
                        "content": {
                            "parts": ({
                                "functionCall": {
                                    "name": "design_propose_plan",
                                    "args": {"steps": ()},
                                },
                            },),
                        },
                    },),
                    "usageMetadata": {"totalTokenCount": 11},
                },
            },
        });

        LlmBackend llm = makeGeminiBackend();
        llm.chatCompletions({
            "model": "gemini-2.5-flash",
            "messages": ({"role": "user", "content": "make a plan"},),
            "tools": ({
                "type": "function",
                "function": {
                    "name": "design_propose_plan",
                    "description": "Create a plan",
                    "parameters": {
                        "type": "object",
                        "additionalProperties": False,
                        "properties": {
                            "steps": {
                                "type": "array",
                                "maxItems": 8,
                                "items": {
                                    "type": "object",
                                    "anyOf": (
                                        {
                                            "type": "object",
                                            "additionalProperties": False,
                                            "properties": {
                                                "operation": {
                                                    "type": "string",
                                                    "enum": ("set_business",),
                                                },
                                                "payload": {
                                                    "type": "object",
                                                    "properties": {
                                                        "business": {
                                                            "type": "object",
                                                            "additionalProperties": False,
                                                            "properties": {
                                                                "business_category": {
                                                                    "type": "string",
                                                                    "minLength": 3,
                                                                },
                                                            },
                                                            "required": ("business_category",),
                                                        },
                                                    },
                                                    "required": ("business",),
                                                },
                                                "rationale": {
                                                    "type": "string",
                                                    "minLength": 12,
                                                },
                                                "target_summary": {"type": "string"},
                                            },
                                            "required": ("operation", "payload",
                                                "rationale", "target_summary"),
                                        },
                                        {
                                            "type": "object",
                                            "additionalProperties": False,
                                            "properties": {
                                                "operation": {
                                                    "type": "string",
                                                    "enum": ("add_interface",),
                                                },
                                                "payload": {
                                                    "type": "object",
                                                    "properties": {
                                                        "interface": {
                                                            "type": "object",
                                                            "properties": {
                                                                "key": {"type": "string"},
                                                            },
                                                            "required": ("key",),
                                                        },
                                                    },
                                                    "required": ("interface",),
                                                },
                                                "rationale": {
                                                    "type": "string",
                                                    "minLength": 12,
                                                },
                                                "target_summary": {"type": "string"},
                                            },
                                            "required": ("operation", "payload",
                                                "rationale", "target_summary"),
                                        },
                                    ),
                                },
                            },
                        },
                        "required": ("steps",),
                    },
                },
            }, {
                    "type": "function",
                    "function": {
                        "name": "qonsole_design_agent_turn",
                        "description": "Apply one design action",
                        "parameters": {
                            "type": "object",
                            "properties": {
                                "operation": {
                                    "type": "string",
                                    "description": "operation to apply",
                                    "enum": ("add_interface",
                                        "revise_interface"),
                                },
                                "payload": {
                                    "type": "object",
                                    "description": "operation payload",
                                    "properties": {
                                        "interface": {
                                            "type": "object",
                                            "properties": {
                                                "key": {"type": "string"},
                                                "config": {
                                                    "type": "object",
                                                    "properties": {
                                                        "definition": {
                                                            "type": "object",
                                                            "properties": {
                                                                "tables": {
                                                                    "type": "object",
                                                                },
                                                            },
                                                        },
                                                    },
                                                },
                                            },
                                            "required": ("key",),
                                        },
                                        "test": {
                                            "type": "object",
                                            "properties": {
                                                "key": {"type": "string"},
                                            },
                                        },
                                    },
                                },
                                "rationale": {
                                    "type": "string",
                                    "description": "reason for the operation",
                                },
                            },
                            "required": ("operation", "payload",
                                "rationale"),
                        },
                    },
                },
            ),
            "tool_choice": {
                "type": "function",
                "function": {"name": "design_propose_plan"},
            },
        });

        hash<auto> params = gemini_handler.requests[0].body.tools[0]
            .functionDeclarations[0].parameters;
        hash<auto> steps = params.properties.steps;
        assertFalse(params.hasKey("additionalProperties"),
            "Gemini root tool schema strips additionalProperties");
        assertFalse(steps.hasKey("maxItems"),
            "Gemini tool schema strips array length constraints");
        hash<auto> item = steps.items;
        assertFalse(item.hasKey("anyOf"),
            "Gemini tool schema flattens anyOf alternatives");
        assertFalse(item.hasKey("properties"),
            "Gemini compact tool schema flattens nested array item "
            "object detail");

        hash<auto> turn_params = gemini_handler.requests[0].body.tools[0]
            .functionDeclarations[1].parameters;
        assertTrue(turn_params.properties.hasKey("payload"),
            "single-dispatch payload argument name is preserved");
        assertFalse(turn_params.properties.payload.hasKey("properties"),
            "single-dispatch payload detail is flattened");
        assertEq("operation payload",
            turn_params.properties.payload.description,
            "Gemini compact tool schema preserves payload guidance");
        assertEq(("operation", "payload", "rationale"),
            turn_params.required,
            "Gemini compact tool schema preserves required payload field");
        assertTrue(turn_params.properties.hasKey("operation"),
            "single-dispatch operation argument name is preserved");
        assertFalse(turn_params.properties.operation.hasKey("enum"),
            "Gemini compact tool schema strips enum constraints");
    }

    geminiSchemaMetadataKeywordSanitizerTest() {
        # A structured-output schema carrying stray JSON-Schema dialect and
        # labelling metadata at the schema level, plus properties whose
        # names collide with stripped schema keywords.  Gemini's
        # responseSchema rejects the metadata keywords with HTTP 400
        # "Unknown name", but property names must survive verbatim.
        hash<auto> schema = {
            "type": "object",
            "name": "request_classification",
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "urn:example:rc",
            "$defs": {"Unused": {"type": "string"}},
            "properties": {
                "name": {"type": "string", "format": "uuid"},
                "format": {"type": "string", "minLength": 2},
                "allowed": {"type": "boolean"},
            },
            "required": ("name", "allowed"),
        };
        hash<auto> rv = GeminiBodyShape::sanitizeSchema(schema);

        assertFalse(rv.hasKey("name"),
            "stray top-level schema 'name' label is stripped");
        assertFalse(rv.hasKey("$schema"),
            "JSON-Schema '$schema' dialect keyword is stripped");
        assertFalse(rv.hasKey("$id"), "'$id' metadata keyword is stripped");
        assertFalse(rv.hasKey("$defs"), "'$defs' metadata keyword is stripped");
        assertTrue(rv.properties.hasKey("name"),
            "a property literally named 'name' is preserved");
        assertTrue(rv.properties.hasKey("format"),
            "a property literally named 'format' is preserved");
        assertTrue(rv.properties.hasKey("allowed"),
            "other declared properties are preserved");
        assertFalse(rv.properties.name.hasKey("format"),
            "the 'format' keyword inside a property schema is still stripped");
        assertFalse(rv.properties.format.hasKey("minLength"),
            "the 'minLength' keyword inside a property schema is still stripped");
        assertEq(("name", "allowed"), rv.required,
            "the required field list is preserved");

        # Empty properties map (a no-argument tool's "properties": {}) must
        # sanitize to a valid empty map, not crash — sanitizeSchemaPropertyMap
        # builds its result in a typed hash<auto> whose return would throw
        # RUNTIME-TYPE-ERROR if left unassigned on the empty-loop path.
        hash<auto> noargs = GeminiBodyShape::sanitizeSchema(
            {"type": "object", "properties": {}});
        assertEq("object", noargs.type);
        assertEq({}, noargs.properties,
            "empty properties sanitizes to an empty map");
        hash<auto> noargs_compact = GeminiBodyShape::sanitizeSchema(
            {"type": "object", "properties": {}}, True);
        assertEq({}, noargs_compact.properties,
            "empty properties sanitizes to an empty map in compact mode");
    }

    geminiResponseSchemaMetadataIntegrationTest() {
        checkGeminiModule();
        installGeminiHandler({
            "/v1beta/models/gemini-2.5-flash:generateContent": {
                "code": 200,
                "body": {
                    "candidates": ({
                        "finishReason": "STOP",
                        "content": {
                            "parts": ({"text": "{\"allowed\":true}"},),
                        },
                    },),
                    "usageMetadata": {"totalTokenCount": 5},
                },
            },
        });

        LlmBackend llm = makeGeminiBackend();
        # The OpenAI structured-output facade carries the schema label both
        # on the wrapper (response_format.json_schema.name, valid) and, as
        # callers like LlmRequestClassifier historically did, as a stray
        # top-level "name" inside the schema itself (invalid for Gemini).
        llm.chatCompletions({
            "model": "gemini-2.5-flash",
            "messages": ({"role": "user", "content": "classify"},),
            "response_format": {
                "type": "json_schema",
                "json_schema": {
                    "name": "request_classification",
                    "strict": True,
                    "schema": {
                        "type": "object",
                        "name": "request_classification",
                        "properties": {
                            "name": {"type": "string"},
                            "allowed": {"type": "boolean"},
                        },
                        "required": ("allowed",),
                    },
                },
            },
        });

        hash<auto> gc = gemini_handler.requests[0].body.generationConfig;
        assertEq("application/json", gc.responseMimeType,
            "structured output sets the JSON response mime type");
        assertFalse(gc.responseSchema.hasKey("name"),
            "responseSchema drops the stray top-level 'name' Gemini rejects");
        assertTrue(gc.responseSchema.properties.hasKey("name"),
            "responseSchema preserves a property literally named 'name'");
        assertTrue(gc.responseSchema.properties.hasKey("allowed"),
            "responseSchema preserves other declared properties");
        assertEq(("allowed",), gc.responseSchema.required,
            "responseSchema preserves the required field list");
    }

    geminiOpenAiToolArgumentSchemaCoercionTest() {
        checkGeminiModule();
        installGeminiHandler({
            "/v1beta/models/gemini-2.5-flash:generateContent": {
                "code": 200,
                "body": {
                    "candidates": ({
                        "finishReason": "STOP",
                        "content": {
                            "parts": ({
                                "functionCall": {
                                    "name": "select_design_action",
                                    "args": {
                                        "operation": "propose_plan",
                                        "payload": make_json({
                                            "key": "plan-req-15",
                                            "interface": {
                                                "satisfied_requirements": (
                                                    "req-15",
                                                ),
                                            },
                                        }),
                                        "steps": make_json(({
                                            "operation": "revise_interface",
                                            "payload": {
                                                "key": "iface-fsm-req-15",
                                            },
                                        },)),
                                    },
                                },
                            },),
                        },
                    },),
                    "usageMetadata": {"totalTokenCount": 8},
                },
            },
        });

        LlmBackend llm = makeGeminiBackend();
        hash<auto> rv = llm.chatCompletions({
            "messages": ({"role": "user", "content": "continue"},),
            "tools": ({
                "type": "function",
                "function": {
                    "name": "select_design_action",
                    "description": "Select the next design action",
                    "parameters": {
                        "type": "object",
                        "properties": {
                            "operation": {"type": "string"},
                            "payload": {
                                "type": "object",
                                "properties": {
                                    "key": {"type": "string"},
                                    "interface": {
                                        "type": "object",
                                        "properties": {
                                            "satisfied_requirements": {
                                                "type": "array",
                                                "items": {"type": "string"},
                                            },
                                        },
                                    },
                                },
                            },
                            "steps": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "operation": {"type": "string"},
                                        "payload": {
                                            "type": "object",
                                            "properties": {
                                                "key": {"type": "string"},
                                            },
                                        },
                                    },
                                },
                            },
                        },
                    },
                },
            },),
            "tool_choice": {
                "type": "function",
                "function": {"name": "select_design_action"},
            },
        });

        assertEq("tool_calls", rv.choices[0].finish_reason,
            "Gemini function call is exposed as a tool call");
        hash<auto> args = parse_json(
            rv.choices[0].message.tool_calls[0].function.arguments);
        assertEq("plan-req-15", args.payload.key,
            "stringified payload object is coerced to JSON");
        assertEq("req-15", args.payload.interface.satisfied_requirements[0],
            "nested arrays in stringified payload survive");
        assertEq("iface-fsm-req-15", args.steps[0].payload.key,
            "stringified steps array is coerced to JSON");
    }

    geminiOpenAiAbstractTokenBudgetFacadeTest() {
        checkGeminiModule();
        installGeminiHandler({
            "/v1beta/models/gemini-2.5-flash:generateContent": {
                "code": 200,
                "body": {
                    "candidates": ({
                        "finishReason": "STOP",
                        "content": {"parts": ({"text": "{\"ok\":true}"},)},
                    },),
                    "usageMetadata": {"totalTokenCount": 12},
                },
            },
        });

        LlmBackend llm = makeGeminiBackend();
        hash<auto> rv = llm.chatCompletions({
            "messages": (
                {"role": "user", "content": "extract"},
            ),
            "max_output_tokens": 16384,
            "reasoning_token_budget": 1024,
            "temperature": 0.0,
            "response_format": {
                "type": "json_schema",
                "json_schema": {
                    "schema": {
                        "type": "object",
                        "properties": {"ok": {"type": "boolean"}},
                    },
                },
            },
        });

        assertEq("{\"ok\":true}", rv.choices[0].message.content,
            "Gemini response content is normalized");
        assertEq(16384,
            gemini_handler.requests[0].body.generationConfig.maxOutputTokens,
            "abstract max_output_tokens maps to Gemini maxOutputTokens");
        assertEq(1024,
            gemini_handler.requests[0].body.generationConfig
                .thinkingConfig.thinkingBudget,
            "abstract reasoning_token_budget maps to Gemini thinkingBudget");
        assertEq("application/json",
            gemini_handler.requests[0].body.generationConfig.responseMimeType,
            "structured output still maps to Gemini JSON mode");
    }

    openAiReasoningModelTokenBudgetTest() {
        installGeminiHandler({
            "/v1/chat/completions": {
                "code": 200,
                "body": {
                    "choices": ({
                        "message": {"role": "assistant", "content": "ok"},
                        "finish_reason": "stop",
                    },),
                    "usage": {},
                },
            },
        });

        LlmBackend llm(<LlmBackendConfig>{
            "mode": "http",
            "url": "http://localhost:" + port,
            "model": "gpt-5.5",
            "api_key": "openai-test-key",
        });
        hash<ChatResponse> rv = llm.chat((
            <ChatMessage>{"role": "user", "content": "hello"},
        ), NOTHING, <LlmRequestOptions>{"max_output_tokens": 8192});

        assertEq("ok", rv.content);
        hash<auto> body = gemini_handler.requests[0].body;
        assertEq(8192, body.max_completion_tokens,
            "OpenAI reasoning models receive max_completion_tokens");
        assertFalse(body.hasKey("max_tokens"),
            "OpenAI reasoning models must not receive max_tokens");
    }

    geminiOpenAiForcedToolJsonTextTest() {
        checkGeminiModule();
        installGeminiHandler({
            "/v1beta/models/gemini-2.5-flash:generateContent": {
                "code": 200,
                "body": {
                    "responseId": "gemini-forced-json-tool-1",
                    "candidates": ({
                        "finishReason": "STOP",
                        "content": {
                            "parts": ({
                                "text": "```json\n" + make_json({
                                    "atomic_requirements": (
                                        {"text": "Reconcile orders hourly"},
                                    ),
                                    "open_questions": (
                                        {"question": "Which SLA applies?"},
                                    ),
                                    "assumptions": (),
                                    "target_scope": {
                                        "in": ("EMEA operations",),
                                        "out": (),
                                    },
                                }) + "\n```",
                            },),
                        },
                    },),
                    "usageMetadata": {"totalTokenCount": 17},
                },
            },
        });

        LlmBackend llm = makeGeminiBackend();
        hash<auto> rv = llm.chatCompletions({
            "model": "gemini-2.5-flash",
            "messages": (
                {
                    "role": "system",
                    "content": "Return the structured decomposition.",
                },
                {
                    "role": "user",
                    "content": "Decompose the supply-chain prose.",
                },
            ),
            "tools": ({
                "type": "function",
                "function": {
                    "name": "qonsole_design_decompose_requirement",
                    "description": "Return a structured decomposition",
                    "parameters": {
                        "type": "object",
                        "additionalProperties": False,
                        "properties": {
                            "atomic_requirements": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "additionalProperties": False,
                                    "properties": {
                                        "text": {"type": "string"},
                                    },
                                    "required": ("text",),
                                },
                            },
                            "open_questions": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "additionalProperties": False,
                                    "properties": {
                                        "question": {"type": "string"},
                                    },
                                    "required": ("question",),
                                },
                            },
                            "target_scope": {
                                "type": "object",
                                "additionalProperties": False,
                                "properties": {
                                    "in": {
                                        "type": "array",
                                        "items": {"type": "string"},
                                    },
                                    "out": {
                                        "type": "array",
                                        "items": {"type": "string"},
                                    },
                                },
                            },
                        },
                        "required": ("atomic_requirements",),
                    },
                },
            },),
            "tool_choice": {
                "type": "function",
                "function": {"name": "qonsole_design_decompose_requirement"},
            },
        });

        assertEq("tool_calls", rv.choices[0].finish_reason,
            "forced JSON text is normalized to tool-call finish_reason");
        assertEq("qonsole_design_decompose_requirement",
            rv.choices[0].message.tool_calls[0].function.name,
            "forced tool name is preserved");
        hash<auto> args = parse_json(
            rv.choices[0].message.tool_calls[0].function.arguments);
        assertEq("Reconcile orders hourly",
            args.atomic_requirements[0].text,
            "JSON text is exposed as tool arguments");
        assertEq("Which SLA applies?",
            args.open_questions[0].question,
            "nested arrays survive the normalization");
        assertEq("ANY",
            gemini_handler.requests[0].body.toolConfig.functionCallingConfig.mode,
            "the provider still receives forced function-calling config");
        assertFalse(gemini_handler.requests[0].body.tools[0]
                .functionDeclarations[0].parameters.hasKey(
                "additionalProperties"),
            "Gemini tool schema sanitization still happens in provider code");
    }

    geminiOpenAiMalformedForcedToolRetryTest() {
        checkGeminiModule();
        installGeminiHandler({
            "/v1beta/models/gemini-2.5-flash:generateContent": {
                "sequence": (
                    {
                        "code": 200,
                        "body": {
                            "responseId": "gemini-malformed-tool-1",
                            "candidates": ({
                                "finishReason": "MALFORMED_FUNCTION_CALL",
                                "content": {"parts": ()},
                            },),
                            "usageMetadata": {
                                "promptTokenCount": 100,
                                "candidatesTokenCount": 0,
                                "totalTokenCount": 100,
                            },
                        },
                    },
                    {
                        "code": 200,
                        "body": {
                            "responseId": "gemini-malformed-tool-retry-1",
                            "candidates": ({
                                "finishReason": "STOP",
                                "content": {
                                    "parts": ({
                                        "text": make_json({
                                            "atomic_requirements": (
                                                {"text": "Gate payments"},
                                            ),
                                        }),
                                    },),
                                },
                            },),
                            "usageMetadata": {"totalTokenCount": 7},
                        },
                    },
                ),
            },
        });

        LlmBackend llm = makeGeminiBackend();
        hash<auto> rv = llm.chatCompletions({
            "model": "gemini-2.5-flash",
            "messages": (
                {
                    "role": "system",
                    "content": "Call the supplied tool.",
                },
                {
                    "role": "user",
                    "content": "Decompose the requirement.",
                },
            ),
            "tools": ({
                "type": "function",
                "function": {
                    "name": "qonsole_design_decompose_requirement",
                    "description": "Return a structured decomposition",
                    "parameters": {
                        "type": "object",
                        "additionalProperties": False,
                        "properties": {
                            "atomic_requirements": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "additionalProperties": False,
                                    "properties": {
                                        "text": {"type": "string"},
                                    },
                                    "required": ("text",),
                                },
                            },
                        },
                        "required": ("atomic_requirements",),
                    },
                },
            },),
            "tool_choice": {
                "type": "function",
                "function": {"name": "qonsole_design_decompose_requirement"},
            },
        });

        assertEq(2, gemini_handler.requests.size(),
            "malformed forced tool call is retried once");
        assertEq("ANY", gemini_handler.requests[0]
                .body.toolConfig.functionCallingConfig.mode,
            "initial request uses forced function calling");
        assertFalse(gemini_handler.requests[1].body.hasKey("toolConfig"),
            "retry removes function-calling config");
        assertFalse(gemini_handler.requests[1].body.hasKey("tools"),
            "retry uses JSON schema mode instead of tools");
        assertEq("application/json",
            gemini_handler.requests[1].body.generationConfig.responseMimeType,
            "retry asks provider for structured JSON");
        assertEq("tool_calls", rv.choices[0].finish_reason,
            "retry response is normalized to OpenAI tool_calls");
        assertEq(True,
            rv.provider_diagnostics.forced_tool_retry.attempted,
            "successful forced-tool JSON retry records diagnostics");
        assertEq(True,
            rv.provider_diagnostics.forced_tool_retry.recovered_tool_call,
            "successful forced-tool JSON retry records recovery");
        assertEq("MALFORMED_FUNCTION_CALL",
            rv.provider_diagnostics.forced_tool_retry.original_finish_reason,
            "forced-tool retry diagnostics preserve the original finish reason");
        assertEq("tool_calls",
            rv.provider_diagnostics.forced_tool_retry.retry_finish_reason,
            "forced-tool retry diagnostics preserve the OpenAI retry finish "
            "reason after tool-call synthesis");
        assertEq("STOP",
            rv.provider_diagnostics.forced_tool_retry
                .retry_provider_diagnostics.finish_reason,
            "forced-tool retry diagnostics preserve the native provider "
            "retry finish reason");
        hash<auto> args = parse_json(
            rv.choices[0].message.tool_calls[0].function.arguments);
        assertEq("Gate payments", args.atomic_requirements[0].text,
            "retry JSON content becomes the forced tool arguments");
    }

    geminiOpenAiMalformedForcedToolRetryContentTest() {
        checkGeminiModule();
        installGeminiHandler({
            "/v1beta/models/gemini-2.5-flash:generateContent": {
                "sequence": (
                    {
                        "code": 200,
                        "body": {
                            "responseId": "gemini-malformed-tool-plain-1",
                            "candidates": ({
                                "finishReason": "MALFORMED_FUNCTION_CALL",
                                "finishMessage": "Malformed function call: "
                                    "call:default_api",
                                "content": {"parts": ()},
                            },),
                            "usageMetadata": {
                                "promptTokenCount": 80,
                                "candidatesTokenCount": 0,
                                "totalTokenCount": 80,
                            },
                        },
                    },
                    {
                        "code": 200,
                        "body": {
                            "responseId": "gemini-malformed-tool-plain-retry-1",
                            "candidates": ({
                                "finishReason": "MAX_TOKENS",
                                "content": {
                                    "parts": ({
                                        "text": "{\"question\":\"決済",
                                    },),
                                },
                            },),
                            "usageMetadata": {
                                "promptTokenCount": 736,
                                "thoughtsTokenCount": 242,
                                "candidatesTokenCount": 10,
                                "totalTokenCount": 988,
                            },
                        },
                    },
                ),
            },
        });

        LlmBackend llm = makeGeminiBackend();
        hash<auto> rv = llm.chatCompletions({
            "model": "gemini-2.5-flash",
            "messages": (
                {"role": "system", "content": "Call the supplied tool."},
                {"role": "user", "content": "Ask one clarification."},
            ),
            "tools": ({
                "type": "function",
                "function": {
                    "name": "first_question",
                    "description": "Return the first clarification question",
                    "parameters": {
                        "type": "object",
                        "additionalProperties": False,
                        "properties": {
                            "question": {"type": "string"},
                        },
                        "required": ("question",),
                    },
                },
            },),
            "tool_choice": {
                "type": "function",
                "function": {"name": "first_question"},
            },
            "max_output_tokens": 256,
            "reasoning_token_budget": 128,
            "generationConfig": {
                "maxOutputTokens": 128,
                "thinkingConfig": {"thinkingBudget": 64},
            },
        });

        assertEq(2, gemini_handler.requests.size(),
            "malformed forced tool call with truncated retry content is retried");
        assertEq(128,
            gemini_handler.requests[0].body.generationConfig.maxOutputTokens,
            "the initial request preserves the explicit provider budget");
        assertEq(64, gemini_handler.requests[0].body.generationConfig
                .thinkingConfig.thinkingBudget,
            "the initial request preserves the explicit thinking budget");
        assertEq(2048,
            gemini_handler.requests[1].body.generationConfig.maxOutputTokens,
            "the schema retry receives an independent visible-output floor");
        assertEq(0, gemini_handler.requests[1].body.generationConfig
                .thinkingConfig.thinkingBudget,
            "the schema retry disables hidden reasoning");
        assertFalse(rv.choices[0].message.content.val(),
            "truncated retry content is not returned as a successful response");
        assertEq(NT_NOTHING, rv.choices[0].message.tool_calls.typeCode(),
            "a failed schema retry does not fabricate a tool call");
        assertEq("MALFORMED_FUNCTION_CALL", rv.choices[0].finish_reason,
            "the original protocol failure remains explicit");
        assertEq(False,
            rv.provider_diagnostics.forced_tool_retry.recovered_tool_call,
            "truncated retry diagnostics record that no call was recovered");
        assertEq(False,
            rv.provider_diagnostics.forced_tool_retry.returned_retry_response,
            "truncated retry diagnostics record that it was not returned");
        assertEq("MALFORMED_FUNCTION_CALL",
            rv.provider_diagnostics.forced_tool_retry.original_finish_reason,
            "truncated retry diagnostics preserve the original finish reason");
        assertEq("length",
            rv.provider_diagnostics.forced_tool_retry.retry_finish_reason,
            "truncated retry diagnostics preserve the normalized finish reason");
        assertEq("MAX_TOKENS", rv.provider_diagnostics.forced_tool_retry
                .retry_provider_diagnostics.finish_reason,
            "truncated retry diagnostics preserve the native finish reason");
    }

    geminiOpenAiRequiredToolEmptyRetryTest() {
        checkGeminiModule();
        installGeminiHandler({
            "/v1beta/models/gemini-2.5-flash:generateContent": {
                "sequence": (
                    {
                        "code": 200,
                        "body": {
                            "responseId": "gemini-empty-required-tool-1",
                            "candidates": ({
                                "finishReason": "STOP",
                                "content": {"parts": ()},
                            },),
                            "usageMetadata": {
                                "promptTokenCount": 120,
                                "candidatesTokenCount": 3,
                                "totalTokenCount": 123,
                            },
                        },
                    },
                    {
                        "code": 200,
                        "body": {
                            "responseId": "gemini-empty-required-tool-retry-1",
                            "candidates": ({
                                "finishReason": "STOP",
                                "content": {
                                    "parts": ({
                                        "functionCall": {
                                            "name": "select_action",
                                            "args": {
                                                "operation": "no_action",
                                                "reason": "complete",
                                            },
                                        },
                                    },),
                                },
                            },),
                            "usageMetadata": {
                                "promptTokenCount": 135,
                                "candidatesTokenCount": 4,
                                "totalTokenCount": 139,
                            },
                        },
                    },
                ),
            },
        });

        LlmBackend llm = makeGeminiBackend();
        hash<auto> rv = llm.chatCompletions({
            "model": "gemini-2.5-flash",
            "messages": (
                {"role": "system", "content": "Choose one action."},
                {"role": "user", "content": "Continue design mode."},
            ),
            "tools": ({
                "type": "function",
                "function": {
                    "name": "select_action",
                    "description": "Select the next design action",
                    "parameters": {
                        "type": "object",
                        "properties": {
                            "operation": {"type": "string"},
                            "reason": {"type": "string"},
                        },
                        "required": ("operation",),
                    },
                },
            }, {
                "type": "function",
                "function": {
                    "name": "record_note",
                    "description": "Record a note",
                    "parameters": {
                        "type": "object",
                        "properties": {"text": {"type": "string"}},
                        "required": ("text",),
                    },
                },
            },),
            "tool_choice": "required",
        });

        assertEq(2, gemini_handler.requests.size(),
            "empty required-tool response is retried once");
        assertEq("ANY", gemini_handler.requests[0]
                .body.toolConfig.functionCallingConfig.mode,
            "initial request requires some tool");
        assertEq("ANY", gemini_handler.requests[1]
                .body.toolConfig.functionCallingConfig.mode,
            "retry preserves required tool mode");
        assertEq("select_action", gemini_handler.requests[1].body.tools[0]
                .functionDeclarations[0].name,
            "retry keeps tool declarations available");
        assertEq("tool_calls", rv.choices[0].finish_reason,
            "retry functionCall is normalized to OpenAI tool_calls");
        assertEq("select_action",
            rv.choices[0].message.tool_calls[0].function.name,
            "retry preserves returned tool name");
        hash<auto> args = parse_json(
            rv.choices[0].message.tool_calls[0].function.arguments);
        assertEq("no_action", args.operation,
            "retry function arguments are serialized");
        assertEq("STOP", rv.provider_diagnostics.finish_reason,
            "OpenAI facade exposes provider finish diagnostics");
        assertEq("qore.llm.tool_protocol.v1",
            rv.provider_diagnostics.tool_protocol.contract_version,
            "tool diagnostics expose a versioned content-free contract");
        assertEq("required",
            rv.provider_diagnostics.tool_protocol.request_tool_choice_code,
            "tool diagnostics retain the closed request choice code");
        assertEq(2,
            rv.provider_diagnostics.tool_protocol.request_tool_count,
            "tool diagnostics retain the request tool count");
        assertEq("ANY",
            rv.provider_diagnostics.tool_protocol.native_function_calling_mode,
            "tool diagnostics prove the native required mode translation");
        assertEq(1,
            rv.provider_diagnostics.tool_protocol.normalized_tool_call_count,
            "tool diagnostics count normalized calls");
        assertEq(1, rv.provider_diagnostics.wire_function_call_count,
            "provider diagnostics prove the retry emitted a native call");
        assertTrue(rv.provider_diagnostics.wire_function_call_observed,
            "provider diagnostics distinguish emission from normalization");
        assertEq("required_tool_no_output",
            rv.provider_diagnostics.forced_tool_retry.reason,
            "multi-tool retry diagnostics retain the recovery reason");
        assertTrue(rv.provider_diagnostics.forced_tool_retry.attempted,
            "multi-tool retry diagnostics record the attempt");
        assertTrue(rv.provider_diagnostics.forced_tool_retry.recovered_tool_call,
            "multi-tool retry diagnostics record recovery");
    }

    geminiOpenAiSingleRequiredToolEmptyJsonRetryTest() {
        checkGeminiModule();
        installGeminiHandler({
            "/v1beta/models/gemini-2.5-flash:generateContent": {
                "sequence": (
                    {
                        "code": 200,
                        "body": {
                            "responseId": "gemini-single-required-empty-1",
                            "candidates": ({
                                "finishReason": "STOP",
                                "content": {"parts": ()},
                            },),
                            "usageMetadata": {
                                "promptTokenCount": 120,
                                "candidatesTokenCount": 0,
                                "totalTokenCount": 120,
                            },
                        },
                    },
                    {
                        "code": 200,
                        "body": {
                            "responseId": "gemini-single-required-json-1",
                            "candidates": ({
                                "finishReason": "STOP",
                                "content": {
                                    "parts": ({
                                        "text": make_json({
                                            "operation": "revise",
                                            "reason": "single tool JSON retry",
                                        }),
                                    },),
                                },
                            },),
                            "usageMetadata": {
                                "promptTokenCount": 135,
                                "candidatesTokenCount": 7,
                                "totalTokenCount": 142,
                            },
                        },
                    },
                ),
            },
        });

        LlmBackend llm = makeGeminiBackend();
        hash<auto> rv = llm.chatCompletions({
            "model": "gemini-2.5-flash",
            "messages": (
                {"role": "system", "content": "Choose one action."},
                {"role": "user", "content": "Continue design mode."},
            ),
            "tools": ({
                "type": "function",
                "function": {
                    "name": "select_action",
                    "description": "Select the next design action",
                    "parameters": {
                        "type": "object",
                        "properties": {
                            "operation": {"type": "string"},
                            "reason": {"type": "string"},
                        },
                        "required": ("operation",),
                    },
                },
            },),
            "tool_choice": "required",
        });

        assertEq(2, gemini_handler.requests.size(),
            "single required-tool empty response is retried once");
        assertEq("ANY", gemini_handler.requests[0]
                .body.toolConfig.functionCallingConfig.mode,
            "initial request requires the single available tool");
        assertFalse(gemini_handler.requests[1].body.hasKey("toolConfig"),
            "single-tool required retry removes native tool choice");
        assertFalse(gemini_handler.requests[1].body.hasKey("tools"),
            "single-tool required retry uses JSON schema mode");
        assertEq("application/json",
            gemini_handler.requests[1].body.generationConfig.responseMimeType,
            "single-tool required retry requests structured JSON");
        assertEq("tool_calls", rv.choices[0].finish_reason,
            "JSON retry response is synthesized to a tool call");
        assertEq("required_tool_no_output",
            rv.provider_diagnostics.forced_tool_retry.reason,
            "diagnostics record why the JSON retry was attempted");
        assertEq(True,
            rv.provider_diagnostics.forced_tool_retry.recovered_tool_call,
            "diagnostics record successful single-tool recovery");
        assertEq("required",
            rv.provider_diagnostics.tool_protocol.request_tool_choice_code,
            "single-tool diagnostics retain required request mode");
        assertEq(1, rv.provider_diagnostics.tool_protocol.request_tool_count,
            "single-tool diagnostics retain request tool count");
        assertEq("ANY",
            rv.provider_diagnostics.tool_protocol.native_function_calling_mode,
            "single-tool diagnostics retain initial native mode");
        assertEq(1,
            rv.provider_diagnostics.tool_protocol.normalized_tool_call_count,
            "single-tool JSON recovery is visible after normalization");
        hash<auto> args = parse_json(
            rv.choices[0].message.tool_calls[0].function.arguments);
        assertEq("revise", args.operation,
            "JSON retry arguments are serialized as the required tool call");
    }

    callbackOpenAiStreamSingleRequiredToolEmptyJsonRetryTest() {
        int stream_calls = 0;
        int sync_calls = 0;
        list<hash<auto>> stream_bodies = ();
        list<hash<auto>> sync_bodies = ();

        LlmBackend llm(<LlmBackendConfig>{
            "mode": "callback",
            "model": "callback-model",
            "api_callback": hash<auto> sub (string m, string p,
                    hash<auto> body) {
                ++sync_calls;
                push sync_bodies, body;
                return {
                    "id": "callback-required-json-retry-1",
                    "model": "callback-model",
                    "choices": ({
                        "message": {
                            "role": "assistant",
                            "content": make_json({
                                "operation": "revise",
                                "reason": "stream JSON retry",
                            }),
                        },
                        "finish_reason": "stop",
                    },),
                    "usage": {
                        "prompt_tokens": 20,
                        "completion_tokens": 5,
                        "total_tokens": 25,
                    },
                };
            },
            "api_stream_callback": sub (string m, string p, hash<auto> body,
                    code<nothing(hash<auto>)> dcb) {
                ++stream_calls;
                push stream_bodies, body;
                dcb({
                    "id": "callback-required-empty-stream-1",
                    "object": "chat.completion.chunk",
                    "model": "callback-model",
                    "choices": ({
                        "index": 0,
                        "delta": {},
                        "finish_reason": "stop",
                    },),
                    "usage": {
                        "prompt_tokens": 10,
                        "completion_tokens": 0,
                        "total_tokens": 10,
                    },
                    "provider_diagnostics": {
                        "wire_protocol": "gemini_generate_content",
                        "wire_stream_event_count": 1,
                        "wire_function_call_count_max": 0,
                        "wire_function_call_observed": False,
                    },
                });
            },
        });

        list<hash<auto>> chunks = ();
        hash<auto> rv = llm.chatCompletionsStream({
            "model": "callback-model",
            "messages": (
                {"role": "system", "content": "Choose one action."},
                {"role": "user", "content": "Continue design mode."},
            ),
            "tools": ({
                "type": "function",
                "function": {
                    "name": "select_action",
                    "description": "Select the next design action",
                    "parameters": {
                        "type": "object",
                        "properties": {
                            "operation": {"type": "string"},
                            "reason": {"type": "string"},
                        },
                        "required": ("operation",),
                    },
                },
            },),
            "tool_choice": "required",
        }, sub (hash<auto> chunk) {
            push chunks, chunk;
        });

        assertEq(1, stream_calls,
            "streaming facade uses the streaming callback first");
        assertEq(1, sync_calls,
            "empty required streaming result is retried once synchronously");
        assertEq("required", stream_bodies[0].tool_choice,
            "initial stream request preserves required tool mode");
        assertEq(1, stream_bodies[0].tools.size(),
            "initial stream request includes the single tool");
        assertFalse(sync_bodies[0].hasKey("tool_choice"),
            "JSON retry removes callback tool choice");
        assertFalse(sync_bodies[0].hasKey("tools"),
            "JSON retry removes callback tools");
        assertEq("json_schema", sync_bodies[0].response_format.type,
            "callback chat retry receives the output schema");
        assertEq(1, chunks.size(),
            "only the original streamed terminal chunk is forwarded");
        assertEq("tool_calls", rv.choices[0].finish_reason,
            "streaming JSON retry is synthesized to a tool call");
        assertEq("required_tool_no_output",
            rv.provider_diagnostics.forced_tool_retry.reason,
            "streaming diagnostics record required-tool retry");
        assertTrue(rv.provider_diagnostics.tool_protocol.streaming,
            "tool diagnostics identify the streaming path");
        assertEq("required",
            rv.provider_diagnostics.tool_protocol.request_tool_choice_code,
            "stream diagnostics retain required request mode");
        assertEq(1, rv.provider_diagnostics.tool_protocol.request_tool_count,
            "stream diagnostics retain request tool count");
        assertEq(1,
            rv.provider_diagnostics.tool_protocol.normalized_tool_call_count,
            "stream diagnostics count the recovered normalized call");
        hash<auto> original_provider = rv.provider_diagnostics
            .forced_tool_retry.original_provider_diagnostics;
        assertEq("gemini_generate_content", original_provider.wire_protocol,
            "callback streaming preserves original provider diagnostics");
        assertEq(1, original_provider.wire_stream_event_count,
            "callback streaming preserves original provider event counts");
        assertFalse(original_provider.wire_function_call_observed,
            "callback streaming preserves original native no-call evidence");
        hash<auto> args = parse_json(
            rv.choices[0].message.tool_calls[0].function.arguments);
        assertEq("stream JSON retry", args.reason,
            "streaming JSON retry arguments are serialized");
    }

    callbackOpenAiStreamMalformedForcedToolRetryContentTest() {
        int stream_calls = 0;
        int sync_calls = 0;
        list<hash<auto>> stream_bodies = ();
        list<hash<auto>> sync_bodies = ();

