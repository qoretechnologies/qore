        addTestCase("LlmStructuredRepair extracts prose-wrapped JSON text",
            \structuredRepairEmbeddedJsonTextTest());
        addTestCase("LlmStructuredRepair normalizes Python JSON literals",
            \structuredRepairPythonLiteralJsonTest());
        addTestCase("LlmStructuredRepair completes truncated JSON text",
