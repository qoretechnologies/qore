    MIT License
*/

%modern
%requires ../../../../qlib/QoreLlmUtils
%requires Util
%requires QUnit

%exec-class QoreLlmUtilsTest

public class QoreLlmUtilsTest inherits QUnit::Test {
    constructor() : Test("QoreLlmUtilsTest", "1.0") {
        addTestCase("LlmBackend config validation - invalid mode", \configInvalidModeTest());
        addTestCase("LlmBackend config validation - http requires url", \configHttpNoUrlTest());
        addTestCase("LlmBackend config validation - anthropic requires url",
            \configAnthropicNoUrlTest());
        addTestCase("LlmBackend config - valid http mode", \configValidHttpTest());
        addTestCase("LlmBackend config - valid anthropic mode", \configValidAnthropicTest());
        addTestCase("LlmBackend config - valid gemini mode", \configValidGeminiTest());
        addTestCase("LlmBackend config validation - gemini requires api_key",
            \configGeminiNoApiKeyTest());
        addTestCase("LlmBackend config - valid callback mode", \configValidCallbackTest());
        addTestCase("LlmBackend config - defaults", \configDefaultsTest());
        addTestCase("LlmBackend getMode/getModel", \gettersTest());
        addTestCase("LlmBackend callback mode - missing callback", \callbackNoCallbackTest());
        addTestCase("LlmBackend request options override model",
            \requestOptionsOverrideModelTest());
        addTestCase("LlmBackendConfig hashdecl defaults", \hashdeclDefaultsTest());
        addTestCase("PromptSecretProtector protects and restores credentials",
            \promptSecretProtectRestoreTest());
        addTestCase("PromptSecretProtector redacts nested values",
            \promptSecretRedactNestedTest());
        addTestCase("PromptSecretProtector redacts restored values",
            \promptSecretRedactProtectedValuesTest());
        addTestCase("PromptSecretProtector redacts sensitive keys and text",
            \promptSecretRedactSensitiveValueTest());
        set_return_value(main());
    }

    # ===================== Config Validation Tests =====================

    configInvalidModeTest() {
        assertThrows("LLM-CONFIG-ERROR", "invalid mode",
            sub () {
                LlmBackend llm(<LlmBackendConfig>{"mode": "invalid"});
            }
        );
    }

    configHttpNoUrlTest() {
        assertThrows("LLM-CONFIG-ERROR", "url is required",
            sub () {
                LlmBackend llm(<LlmBackendConfig>{"mode": "http"});
            }
        );
    }

    configAnthropicNoUrlTest() {
        assertThrows("LLM-CONFIG-ERROR", "url is required",
            sub () {
                LlmBackend llm(<LlmBackendConfig>{"mode": "anthropic"});
            }
        );
    }

    configValidHttpTest() {
        LlmBackend llm(<LlmBackendConfig>{
            "mode": "http",
            "url": "http://localhost:8080",
            "model": "gpt-4o",
            "api_key": "test-key",
        });
        assertEq("http", llm.getMode());
        assertEq("gpt-4o", llm.getModel());
    }

    configValidAnthropicTest() {
        LlmBackend llm(<LlmBackendConfig>{
            "mode": "anthropic",
            "url": "https://api.anthropic.com",
            "model": "claude-sonnet-4-20250514",
            "api_key": "test-key",
        });
        assertEq("anthropic", llm.getMode());
        assertEq("claude-sonnet-4-20250514", llm.getModel());
    }

    configValidGeminiTest() {
        LlmBackend llm(<LlmBackendConfig>{
            "mode": "gemini",
            "model": "gemini-2.5-flash",
            "api_key": "test-key",
        });
        assertEq("gemini", llm.getMode());
        assertEq("gemini-2.5-flash", llm.getModel());
    }

    configGeminiNoApiKeyTest() {
        assertThrows("LLM-CONFIG-ERROR", "api_key is required",
            sub () {
                LlmBackend llm(<LlmBackendConfig>{"mode": "gemini"});
            }
        );
    }

    configValidCallbackTest() {
        LlmBackend llm(<LlmBackendConfig>{
            "mode": "callback", "api_callback": hash<auto> sub (string m, string p, hash<auto> b) { return {}; },
            "model": "my-model",
        });
        assertEq("callback", llm.getMode());
        assertEq("my-model", llm.getModel());
    }

    configDefaultsTest() {
        # Callback mode doesn't need url, so we can test defaults
        LlmBackend llm(<LlmBackendConfig>{"mode": "callback", "api_callback": hash<auto> sub (string m, string p, hash<auto> b) { return {}; }});
        assertEq("callback", llm.getMode());
        assertEq(NOTHING, llm.getModel());
    }

    gettersTest() {
        LlmBackend llm(<LlmBackendConfig>{
            "mode": "http",
            "url": "http://localhost:8080",
            "model": "test-model",
        });
        assertEq("http", llm.getMode());
        assertEq("test-model", llm.getModel());

        # Test with no model
        LlmBackend llm2(<LlmBackendConfig>{
            "mode": "http",
            "url": "http://localhost:8080",
        });
        assertEq(NOTHING, llm2.getModel());
    }

    callbackNoCallbackTest() {
        # Callback mode without api_callback should fail at construction
        assertThrows("LLM-CONFIG-ERROR", "api_callback is required",
            sub () {
                new LlmBackend(<LlmBackendConfig>{"mode": "callback"});
            }
        );
    }

    requestOptionsOverrideModelTest() {
        hash<auto> captured;
        LlmBackend llm(<LlmBackendConfig>{
            "mode": "callback",
            "model": "default-model",
            "api_callback": hash<auto> sub (string m, string p, hash<auto> b) {
                captured = b;
                return {
                    "choices": ({"message": {"content": "ok"}, "finish_reason": "stop"},),
                    "usage": {},
                };
            },
        });
        hash<ChatResponse> rv = llm.chat((
            <ChatMessage>{"role": "user", "content": "hello"},
        ), NOTHING, <LlmRequestOptions>{
            "model": "cheap-task-model",
            "temperature": 0.2,
            "body_options": {"reasoning_effort": "low"},
        });
        assertEq("ok", rv.content);
        assertEq("cheap-task-model", captured.model);
        assertEq(0.2, captured.temperature);
        assertEq("low", captured.reasoning_effort);
    }

    hashdeclDefaultsTest() {
        hash<LlmBackendConfig> config(<LlmBackendConfig>{"mode": "http", "url": "http://x"});
        assertEq(4096, config.max_tokens);
        assertEq(0.0, config.temperature);
        assertEq(10000, config.connect_timeout_ms);
        assertEq(120000, config.timeout_ms);
        assertEq("2023-06-01", config.anthropic_version);
    }

    promptSecretProtectRestoreTest() {
        string raw_secret = "qore-test-secret-value-12345";
        string text = "create a connection using API key " + raw_secret;
        *hash<auto> placeholders = PromptSecretProtector::protectText(\text);
        assertTrue(placeholders.val());
        assertFalse(text.find(raw_secret) >= 0);
        assertTrue(text.find("<credential-1>") >= 0);
        assertEq(raw_secret, placeholders."<credential-1>");

        string context_text = PromptSecretProtector::buildSystemContext(placeholders);
        assertTrue(context_text.find("<credential-1>") >= 0);
        assertFalse(context_text.find(raw_secret) >= 0);

        hash<auto> args = {
            "options": {"apikey": "<credential-1>"},
            "list": ("<credential-1>", "plain"),
        };
        hash<auto> restored = cast<hash<auto>>(
            PromptSecretProtector::restorePlaceholders(args, placeholders));
        assertEq(raw_secret, restored.options.apikey);
        assertEq(raw_secret, restored.list[0]);
    }

    promptSecretRedactNestedTest() {
        string raw_secret = "qore-test-secret-value-24680";
        string text = "API key " + raw_secret;
        *hash<auto> placeholders = PromptSecretProtector::protectText(\text);
        hash<auto> value = {
            "options": {"apikey": "<credential-1>"},
            "nested": ({"token": "<credential-1>"},),
        };
        hash<auto> redacted = cast<hash<auto>>(
            PromptSecretProtector::redactPlaceholders(value, placeholders));
        assertEq("<redacted>", redacted.options.apikey);
        assertEq("<redacted>", redacted.nested[0].token);
        assertFalse(sprintf("%y", redacted).find(raw_secret) >= 0);
    }

    promptSecretRedactProtectedValuesTest() {
        string raw_secret = "qore-test-secret-value-67890";
        string text = "create using api key " + raw_secret;
        *hash<auto> placeholders = PromptSecretProtector::protectText(\text);
        hash<auto> value = {
            "message": "tool failed with apikey=" + raw_secret,
            "args": {"apikey": raw_secret, "note": "<credential-1>"},
        };
        hash<auto> redacted = cast<hash<auto>>(
            PromptSecretProtector::redactProtectedValues(value, placeholders));
        assertFalse(sprintf("%y", redacted).find(raw_secret) >= 0);
        assertEq("<redacted>", redacted.args.apikey);
        assertEq("<redacted>", redacted.args.note);
        assertTrue(redacted.message.find("<redacted>") >= 0);
    }

    promptSecretRedactSensitiveValueTest() {
        hash<auto> value = {
            "apikey": "secret-value-12345",
            "nested": {
                "plain": "use api key secret-value-67890",
                "url": "https://example.com",
                "url_with_auth": "https://user:secret-value-99999@example.com/path",
            },
            "svalue": "secret-value-54321",
        };
        hash<auto> redacted = cast<hash<auto>>(
            PromptSecretProtector::redactSensitiveValue(value));
        assertEq("<redacted>", redacted.apikey);
        assertEq("<redacted>", redacted.svalue);
        assertFalse(redacted.nested.plain.find("secret-value-67890") >= 0);
        assertEq("https://example.com", redacted.nested.url);
        assertEq("https://user:<redacted>@example.com/path",
            redacted.nested.url_with_auth);
    }
}
