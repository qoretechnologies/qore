class FakeGeminiLlmHandler inherits AbstractHttpRequestHandler {
    public {
        list<hash<auto>> requests = ();
        hash<string, hash<auto>> responses;
        hash<string, int> response_index;
        Mutex m();
    }

    constructor(hash<string, hash<auto>> responses) {
        self.responses = responses;
    }

    hash handleRequest(hash cx, hash hdr, *data body) {
        m.lock();
        on_exit m.unlock();
        hash<auto> parsed = body.val() ? parse_json(body) : {};
        push requests, {
            "path": cx.raw_path,
            "method": hdr.method,
            "api_key": hdr."x-goog-api-key",
            "body": parsed,
        };
        *hash<auto> resp = responses{cx.raw_path};
        if (!resp) {
            return makeResponse(404,
                "{\"error\":{\"status\":\"NOT_FOUND\",\"message\":\"Not Found\"}}",
                {"Content-Type": MimeTypeJson});
        }
        if (resp.sequence.typeCode() == NT_LIST) {
            int idx = response_index{cx.raw_path} ?? 0;
            response_index{cx.raw_path} = idx + 1;
            list<auto> seq = cast<list>(resp.sequence);
            if (idx < seq.size() && seq[idx].typeCode() == NT_HASH) {
                resp = cast<hash>(seq[idx]);
            }
        }
        int code = resp.code ?? 200;
        string out = resp.body.typeCode() == NT_STRING
            ? resp.body : make_json(resp.body);
        return makeResponse(code, out, {"Content-Type": MimeTypeJson});
    }
}

class FakeLlmProvider inherits QoreLlmUtils::AbstractLlmProvider {
    constructor(hash<LlmBackendConfig> config) : AbstractLlmProvider(config) {
    }

    string getMode() {
        return "test-fake";
    }

    hash<QoreLlmUtils::LlmCompletionResult> complete(string system_prompt,
            string user_prompt, *hash<auto> output_schema,
            *hash<QoreLlmUtils::LlmRequestOptions> opts) {
        return <QoreLlmUtils::LlmCompletionResult>{"content": "ok", "usage": {}};
    }

    hash<QoreLlmUtils::ChatResponse> chat(list<hash<QoreLlmUtils::ChatMessage>> messages,
            *list<hash<QoreLlmUtils::ToolDefinition>> tools,
            *hash<QoreLlmUtils::LlmRequestOptions> opts) {
        return <QoreLlmUtils::ChatResponse>{"stop_reason": "end_turn", "usage": {}};
    }
}

class FakeLlmProviderFactory inherits QoreLlmUtils::AbstractLlmProviderFactory {
    string getMode() {
        return "test-fake";
    }

    string getDisplayName() {
        return "fake test provider";
    }

    QoreLlmUtils::AbstractLlmProvider create(hash<LlmBackendConfig> config) {
        return new FakeLlmProvider(config);
    }
}

