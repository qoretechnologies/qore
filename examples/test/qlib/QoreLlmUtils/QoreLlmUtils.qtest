%modern
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Logger
%requires Mime
%requires HttpServerUtil
%requires HttpServerAsyncIo
%requires HttpServer
%requires RestClient
%requires RestClientIo
%requires GeminiRestClient
%requires QoreLlmUtils
%requires Util
%requires QUnit

%try-module json
%define NoJson
%endtry

%exec-class QoreLlmUtilsTest

class FakeGeminiLlmHandler inherits AbstractHttpRequestHandler {
    public {
        list<hash<auto>> requests = ();
        hash<string, hash<auto>> responses;
        Mutex m();
    }

    constructor(hash<string, hash<auto>> responses) {
        self.responses = responses;
    }

    hash handleRequest(hash cx, hash hdr, *data body) {
        m.lock();
        on_exit m.unlock();
        hash<auto> parsed = body.val() ? parse_json(body) : {};
        push requests, {
            "path": cx.raw_path,
            "method": hdr.method,
            "api_key": hdr."x-goog-api-key",
            "body": parsed,
        };
        *hash<auto> resp = responses{cx.raw_path};
        if (!resp) {
            return makeResponse(404,
                "{\"error\":{\"status\":\"NOT_FOUND\",\"message\":\"Not Found\"}}",
                {"Content-Type": MimeTypeJson});
        }
        int code = resp.code ?? 200;
        string out = resp.body.typeCode() == NT_STRING
            ? resp.body : make_json(resp.body);
        return makeResponse(code, out, {"Content-Type": MimeTypeJson});
    }
}

public class QoreLlmUtilsTest inherits QUnit::Test {
    private {
        HttpServer http;
        int port;
        FakeGeminiLlmHandler gemini_handler;
    }

    constructor() : Test("QoreLlmUtilsTest", "1.0") {
        addTestCase("LlmBackend config validation - invalid mode", \configInvalidModeTest());
        addTestCase("LlmBackend config validation - http requires url", \configHttpNoUrlTest());
        addTestCase("LlmBackend config validation - anthropic requires url",
            \configAnthropicNoUrlTest());
        addTestCase("LlmBackend config - valid http mode", \configValidHttpTest());
        addTestCase("LlmBackend config - valid anthropic mode", \configValidAnthropicTest());
        addTestCase("LlmBackend config - valid gemini mode", \configValidGeminiTest());
        addTestCase("LlmBackend config validation - gemini requires api_key",
            \configGeminiNoApiKeyTest());
        addTestCase("LlmBackend config - valid callback mode", \configValidCallbackTest());
        addTestCase("LlmBackend config - defaults", \configDefaultsTest());
        addTestCase("LlmBackend getMode/getModel", \gettersTest());
        addTestCase("LlmBackend callback mode - missing callback", \callbackNoCallbackTest());
        addTestCase("LlmBackend callback mode - dispatch options",
            \callbackDispatchOptionsTest());
        addTestCase("LlmBackend request options override model",
            \requestOptionsOverrideModelTest());
        addTestCase("LlmBackend gemini chat request and text response",
            \geminiChatRequestAndTextResponseTest());
        addTestCase("LlmBackend gemini tool call response",
            \geminiToolCallResponseTest());
        addTestCase("LlmBackend OpenAI chat facade routes Gemini requests",
            \geminiOpenAiChatCompletionsFacadeTest());
        addTestCase("LlmBackend OpenAI chat facade converts tool turns",
            \geminiOpenAiToolTurnsFacadeTest());
        addTestCase("LlmBackendConfig hashdecl defaults", \hashdeclDefaultsTest());
        addTestCase("PromptSecretProtector protects and restores credentials",
            \promptSecretProtectRestoreTest());
        addTestCase("PromptSecretProtector redacts nested values",
            \promptSecretRedactNestedTest());
        addTestCase("PromptSecretProtector redacts restored values",
            \promptSecretRedactProtectedValuesTest());
        addTestCase("PromptSecretProtector redacts sensitive keys and text",
            \promptSecretRedactSensitiveValueTest());
        set_return_value(main());
    }

    globalSetUp() {
        Logger logger("test", LoggerLevel::getLevelWarn());
        hash<HttpServerOptionInfo> http_opts = <HttpServerOptionInfo>{
            "logger": logger,
            "debug": False,
        };
        http = new HttpServer(http_opts);
        port = http.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
    }

    globalTearDown() {
        delete http;
    }

    private checkGeminiModule() {
%ifdef NoJson
        testSkip("no json module");
%endif
    }

    private installGeminiHandler(hash<string, hash<auto>> responses) {
        if (gemini_handler) {
            http.removeHandler("gemini-llm");
        }
        gemini_handler = new FakeGeminiLlmHandler(responses);
        http.setHandler("gemini-llm", "/", MimeTypeJson, gemini_handler);
    }

    private LlmBackend makeGeminiBackend(*string model) {
        return new LlmBackend(<LlmBackendConfig>{
            "mode": "gemini",
            "url": "http://localhost:" + port,
            "model": model ?? "gemini-2.5-flash",
            "api_key": "gemini-test-key",
            "max_tokens": 512,
            "temperature": 0.0,
        });
    }

    # ===================== Config Validation Tests =====================

    configInvalidModeTest() {
        assertThrows("LLM-CONFIG-ERROR", "invalid mode",
            sub () {
                LlmBackend llm(<LlmBackendConfig>{"mode": "invalid"});
            }
        );
    }

    configHttpNoUrlTest() {
        assertThrows("LLM-CONFIG-ERROR", "url is required",
            sub () {
                LlmBackend llm(<LlmBackendConfig>{"mode": "http"});
            }
        );
    }

    configAnthropicNoUrlTest() {
        assertThrows("LLM-CONFIG-ERROR", "url is required",
            sub () {
                LlmBackend llm(<LlmBackendConfig>{"mode": "anthropic"});
            }
        );
    }

    configValidHttpTest() {
        LlmBackend llm(<LlmBackendConfig>{
            "mode": "http",
            "url": "http://localhost:8080",
            "model": "gpt-4o",
            "api_key": "test-key",
        });
        assertEq("http", llm.getMode());
        assertEq("gpt-4o", llm.getModel());
    }

    configValidAnthropicTest() {
        LlmBackend llm(<LlmBackendConfig>{
            "mode": "anthropic",
            "url": "https://api.anthropic.com",
            "model": "claude-sonnet-4-20250514",
            "api_key": "test-key",
        });
        assertEq("anthropic", llm.getMode());
        assertEq("claude-sonnet-4-20250514", llm.getModel());
    }

    configValidGeminiTest() {
        LlmBackend llm(<LlmBackendConfig>{
            "mode": "gemini",
            "model": "gemini-2.5-flash",
            "api_key": "test-key",
        });
        assertEq("gemini", llm.getMode());
        assertEq("gemini-2.5-flash", llm.getModel());
    }

    configGeminiNoApiKeyTest() {
        assertThrows("LLM-CONFIG-ERROR", "api_key is required",
            sub () {
                LlmBackend llm(<LlmBackendConfig>{"mode": "gemini"});
            }
        );
    }

    configValidCallbackTest() {
        LlmBackend llm(<LlmBackendConfig>{
            "mode": "callback", "api_callback": hash<auto> sub (string m, string p, hash<auto> b) { return {}; },
            "model": "my-model",
        });
        assertEq("callback", llm.getMode());
        assertEq("my-model", llm.getModel());
    }

    configDefaultsTest() {
        # Callback mode doesn't need url, so we can test defaults
        LlmBackend llm(<LlmBackendConfig>{"mode": "callback", "api_callback": hash<auto> sub (string m, string p, hash<auto> b) { return {}; }});
        assertEq("callback", llm.getMode());
        assertEq(NOTHING, llm.getModel());
    }

    gettersTest() {
        LlmBackend llm(<LlmBackendConfig>{
            "mode": "http",
            "url": "http://localhost:8080",
            "model": "test-model",
        });
        assertEq("http", llm.getMode());
        assertEq("test-model", llm.getModel());

        # Test with no model
        LlmBackend llm2(<LlmBackendConfig>{
            "mode": "http",
            "url": "http://localhost:8080",
        });
        assertEq(NOTHING, llm2.getModel());
    }

    callbackNoCallbackTest() {
        # Callback mode without api_callback should fail at construction
        assertThrows("LLM-CONFIG-ERROR", "api_callback is required",
            sub () {
                new LlmBackend(<LlmBackendConfig>{"mode": "callback"});
            }
        );
    }

    callbackDispatchOptionsTest() {
        list<hash<auto>> calls = ();
        LlmBackend llm(<LlmBackendConfig>{
            "mode": "callback",
            "model": "default-model",
            "callback_method": "PUT",
            "callback_path": "ai/v1/chat/completions",
            "api_callback": hash<auto> sub (string m, string p, hash<auto> b) {
                push calls, {"method": m, "path": p, "body": b};
                return {
                    "choices": ({"message": {"content": "ok"}, "finish_reason": "stop"},),
                    "usage": {"total_tokens": 1},
                };
            },
        });

        hash<LlmCompletionResult> complete_rv = llm.complete("system", "prompt");
        hash<ChatResponse> chat_rv = llm.chat((
            <ChatMessage>{"role": "user", "content": "hello"},
        ));

        assertEq("ok", complete_rv.content);
        assertEq("ok", chat_rv.content);
        assertEq(2, calls.size());
        assertEq("PUT", calls[0].method);
        assertEq("ai/v1/chat/completions", calls[0].path);
        assertEq("default-model", calls[0].body.model);
        assertEq("PUT", calls[1].method);
        assertEq("ai/v1/chat/completions", calls[1].path);
        assertEq("hello", calls[1].body.messages[0].content);
    }

    requestOptionsOverrideModelTest() {
        hash<auto> captured;
        LlmBackend llm(<LlmBackendConfig>{
            "mode": "callback",
            "model": "default-model",
            "api_callback": hash<auto> sub (string m, string p, hash<auto> b) {
                captured = b;
                return {
                    "choices": ({"message": {"content": "ok"}, "finish_reason": "stop"},),
                    "usage": {},
                };
            },
        });
        hash<ChatResponse> rv = llm.chat((
            <ChatMessage>{"role": "user", "content": "hello"},
        ), NOTHING, <LlmRequestOptions>{
            "model": "cheap-task-model",
            "temperature": 0.2,
            "body_options": {"reasoning_effort": "low"},
        });
        assertEq("ok", rv.content);
        assertEq("cheap-task-model", captured.model);
        assertEq(0.2, captured.temperature);
        assertEq("low", captured.reasoning_effort);
    }

    geminiChatRequestAndTextResponseTest() {
        checkGeminiModule();
        installGeminiHandler({
            "/v1beta/models/gemini-2.5-pro:generateContent": {
                "code": 200,
                "body": {
                    "responseId": "gemini-chat-1",
                    "candidates": ({
                        "finishReason": "STOP",
                        "content": {
                            "parts": ({"text": "done"},),
                        },
                    },),
                    "usageMetadata": {
                        "promptTokenCount": 7,
                        "candidatesTokenCount": 3,
                        "totalTokenCount": 10,
                    },
                },
            },
        });

        LlmBackend llm = makeGeminiBackend();
        hash<ChatResponse> rv = llm.chat((
            <ChatMessage>{"role": "system", "content": "be precise"},
            <ChatMessage>{
                "role": "user",
                "content_parts": (
                    <ContentPart>{"type": "text", "text": "inspect"},
                    <ContentPart>{
                        "type": "image",
                        "data": parse_base64_string("aW1n"),
                        "mime_type": "image/png",
                    },
                ),
            },
        ), (
            <ToolDefinition>{
                "name": "lookup",
                "description": "lookup data",
                "parameters": {
                    "type": "object",
                    "properties": {"key": {"type": "string"}},
                },
            },
        ), <LlmRequestOptions>{
            "model": "gemini-2.5-pro",
            "max_tokens": 128,
            "temperature": 0.2,
            "body_options": {
                "generationConfig": {
                    "thinkingConfig": {"thinkingBudget": 64},
                },
            },
        });

        assertEq("done", rv.content);
        assertEq("end_turn", rv.stop_reason);
        assertEq(10, rv.usage.total_tokens);
        assertEq(1, gemini_handler.requests.size());
        assertEq("/v1beta/models/gemini-2.5-pro:generateContent",
            gemini_handler.requests[0].path);
        assertEq("POST", gemini_handler.requests[0].method);
        assertEq("gemini-test-key", gemini_handler.requests[0].api_key);
        assertEq("be precise",
            gemini_handler.requests[0].body.systemInstruction.parts[0].text);
        assertEq("inspect",
            gemini_handler.requests[0].body.contents[0].parts[0].text);
        assertEq("image/png",
            gemini_handler.requests[0].body.contents[0].parts[1].inlineData.mimeType);
        assertEq("aW1n",
            gemini_handler.requests[0].body.contents[0].parts[1].inlineData.data);
        assertEq(128,
            gemini_handler.requests[0].body.generationConfig.maxOutputTokens);
        assertEq(0.2,
            gemini_handler.requests[0].body.generationConfig.temperature);
        assertEq(64,
            gemini_handler.requests[0].body.generationConfig.thinkingConfig.thinkingBudget);
        assertEq("lookup",
            gemini_handler.requests[0].body.tools[0].functionDeclarations[0].name);
    }

    geminiToolCallResponseTest() {
        checkGeminiModule();
        installGeminiHandler({
            "/v1beta/models/gemini-2.5-flash:generateContent": {
                "code": 200,
                "body": {
                    "candidates": ({
                        "finishReason": "STOP",
                        "content": {
                            "parts": ({
                                "functionCall": {
                                    "name": "lookup",
                                    "args": {"key": "customer"},
                                },
                            },),
                        },
                    },),
                    "usageMetadata": {"totalTokenCount": 4},
                },
            },
        });

        LlmBackend llm = makeGeminiBackend();
        hash<ChatResponse> rv = llm.chat((
            <ChatMessage>{"role": "user", "content": "lookup customer"},
        ), (
            <ToolDefinition>{"name": "lookup"},
        ));

        assertEq("tool_use", rv.stop_reason);
        assertEq("lookup", rv.tool_calls[0].name);
        assertEq("customer", rv.tool_calls[0].arguments.key);
        assertEq("/v1beta/models/gemini-2.5-flash:generateContent",
            gemini_handler.requests[0].path);
        assertEq("lookup customer",
            gemini_handler.requests[0].body.contents[0].parts[0].text);
    }

    geminiOpenAiChatCompletionsFacadeTest() {
        checkGeminiModule();
        installGeminiHandler({
            "/v1beta/models/gemini-2.5-pro:generateContent": {
                "code": 200,
                "body": {
                    "responseId": "gemini-openai-1",
                    "candidates": ({
                        "finishReason": "STOP",
                        "content": {
                            "parts": (
                                {"text": "done"},
                                {
                                    "functionCall": {
                                        "name": "lookup",
                                        "args": {"key": "customer"},
                                    },
                                },
                            ),
                        },
                    },),
                    "usageMetadata": {
                        "promptTokenCount": 9,
                        "candidatesTokenCount": 4,
                        "totalTokenCount": 13,
                    },
                },
            },
        });

        LlmBackend llm = makeGeminiBackend();
        hash<auto> rv = llm.chatCompletions({
            "model": "gemini-2.5-pro",
            "messages": (
                {"role": "system", "content": "be concise"},
                {
                    "role": "user",
                    "content": (
                        {"type": "text", "text": "inspect this"},
                        {
                            "type": "image_url",
                            "image_url": {
                                "url": "data:image/png;base64,aW1n",
                            },
                        },
                    ),
                },
            ),
            "max_completion_tokens": 256,
            "temperature": 0.1,
            "generationConfig": {
                "thinkingConfig": {"thinkingBudget": 32},
            },
            "response_format": {
                "type": "json_schema",
                "json_schema": {
                    "schema": {
                        "type": "object",
                        "properties": {"ok": {"type": "boolean"}},
                    },
                },
            },
            "tools": ({
                "type": "function",
                "function": {
                    "name": "lookup",
                    "description": "lookup data",
                    "parameters": {
                        "type": "object",
                        "properties": {"key": {"type": "string"}},
                    },
                },
            },),
            "tool_choice": {
                "type": "function",
                "function": {"name": "lookup"},
            },
        });

        assertEq("gemini-openai-1", rv.id,
            "Gemini responseId is exposed as OpenAI id");
        assertEq("gemini-2.5-pro", rv.model,
            "requested model is exposed in OpenAI response");
        assertEq("done", rv.choices[0].message.content,
            "text content is normalized");
        assertEq("tool_calls", rv.choices[0].finish_reason,
            "Gemini function call maps to OpenAI tool_calls finish reason");
        assertEq("lookup",
            rv.choices[0].message.tool_calls[0].function.name,
            "function call name is normalized");
        assertEq("{\"key\":\"customer\"}",
            rv.choices[0].message.tool_calls[0].function.arguments,
            "function call arguments are serialized");
        assertEq(13, rv.usage.total_tokens,
            "Gemini usage is normalized");

        assertEq("be concise",
            gemini_handler.requests[0].body.systemInstruction.parts[0].text,
            "system message moved to Gemini systemInstruction");
        assertEq("inspect this",
            gemini_handler.requests[0].body.contents[0].parts[0].text,
            "OpenAI user text block converted");
        assertEq("image/png",
            gemini_handler.requests[0].body.contents[0].parts[1].inlineData.mimeType,
            "OpenAI image URL MIME type converted");
        assertEq("aW1n",
            gemini_handler.requests[0].body.contents[0].parts[1].inlineData.data,
            "OpenAI image URL payload converted");
        assertEq(256,
            gemini_handler.requests[0].body.generationConfig.maxOutputTokens,
            "max_completion_tokens maps to maxOutputTokens");
        assertEq(0.1,
            gemini_handler.requests[0].body.generationConfig.temperature,
            "temperature maps to generationConfig");
        assertEq(32,
            gemini_handler.requests[0].body.generationConfig.thinkingConfig.thinkingBudget,
            "provider generationConfig is preserved");
        assertEq("application/json",
            gemini_handler.requests[0].body.generationConfig.responseMimeType,
            "json_schema response format maps to Gemini JSON mode");
        assertEq("lookup",
            gemini_handler.requests[0].body.tools[0].functionDeclarations[0].name,
            "OpenAI function tool declaration converted");
        assertEq("ANY",
            gemini_handler.requests[0].body.toolConfig.functionCallingConfig.mode,
            "named tool choice forces function calling");
        assertEq("lookup",
            gemini_handler.requests[0].body.toolConfig.functionCallingConfig.allowedFunctionNames[0],
            "named tool choice limits the allowed function");
    }

    geminiOpenAiToolTurnsFacadeTest() {
        checkGeminiModule();
        installGeminiHandler({
            "/v1beta/models/gemini-2.5-flash:generateContent": {
                "code": 200,
                "body": {
                    "candidates": ({
                        "finishReason": "STOP",
                        "content": {"parts": ({"text": "used tool"},)},
                    },),
                    "usageMetadata": {"totalTokenCount": 5},
                },
            },
        });

        LlmBackend llm = makeGeminiBackend();
        hash<auto> rv = llm.chatCompletions({
            "messages": (
                {"role": "user", "content": "lookup customer"},
                {
                    "role": "assistant",
                    "tool_calls": ({
                        "id": "call-1",
                        "type": "function",
                        "function": {
                            "name": "lookup",
                            "arguments": "{\"key\":\"customer\"}",
                        },
                    },),
                },
                {
                    "role": "tool",
                    "tool_call_id": "call-1",
                    "name": "lookup",
                    "content": "{\"ok\":true}",
                },
            ),
        });

        assertEq("used tool", rv.choices[0].message.content,
            "facade returns normalized assistant text");
        assertEq("model", gemini_handler.requests[0].body.contents[1].role,
            "assistant tool call is represented as model content");
        assertEq("lookup",
            gemini_handler.requests[0].body.contents[1].parts[0].functionCall.name,
            "assistant function call name converted");
        assertEq("customer",
            gemini_handler.requests[0].body.contents[1].parts[0].functionCall.args.key,
            "assistant function call JSON arguments parsed");
        assertEq("lookup",
            gemini_handler.requests[0].body.contents[2].parts[0].functionResponse.name,
            "tool result name converted");
        assertEq(True,
            gemini_handler.requests[0].body.contents[2].parts[0].functionResponse.response.ok,
            "tool result JSON parsed");
    }

    hashdeclDefaultsTest() {
        hash<LlmBackendConfig> config(<LlmBackendConfig>{"mode": "http", "url": "http://x"});
        assertEq(4096, config.max_tokens);
        assertEq(0.0, config.temperature);
        assertEq(10000, config.connect_timeout_ms);
        assertEq(120000, config.timeout_ms);
        assertEq("2023-06-01", config.anthropic_version);
    }

    promptSecretProtectRestoreTest() {
        string raw_secret = "qore-test-secret-value-12345";
        string text = "create a connection using API key " + raw_secret;
        *hash<auto> placeholders = PromptSecretProtector::protectText(\text);
        assertTrue(placeholders.val());
        assertFalse(text.find(raw_secret) >= 0);
        assertTrue(text.find("<credential-1>") >= 0);
        assertEq(raw_secret, placeholders."<credential-1>");

        string context_text = PromptSecretProtector::buildSystemContext(placeholders);
        assertTrue(context_text.find("<credential-1>") >= 0);
        assertFalse(context_text.find(raw_secret) >= 0);

        hash<auto> args = {
            "options": {"apikey": "<credential-1>"},
            "list": ("<credential-1>", "plain"),
        };
        hash<auto> restored = cast<hash<auto>>(
            PromptSecretProtector::restorePlaceholders(args, placeholders));
        assertEq(raw_secret, restored.options.apikey);
        assertEq(raw_secret, restored.list[0]);
    }

    promptSecretRedactNestedTest() {
        string raw_secret = "qore-test-secret-value-24680";
        string text = "API key " + raw_secret;
        *hash<auto> placeholders = PromptSecretProtector::protectText(\text);
        hash<auto> value = {
            "options": {"apikey": "<credential-1>"},
            "nested": ({"token": "<credential-1>"},),
        };
        hash<auto> redacted = cast<hash<auto>>(
            PromptSecretProtector::redactPlaceholders(value, placeholders));
        assertEq("<redacted>", redacted.options.apikey);
        assertEq("<redacted>", redacted.nested[0].token);
        assertFalse(sprintf("%y", redacted).find(raw_secret) >= 0);
    }

    promptSecretRedactProtectedValuesTest() {
        string raw_secret = "qore-test-secret-value-67890";
        string text = "create using api key " + raw_secret;
        *hash<auto> placeholders = PromptSecretProtector::protectText(\text);
        hash<auto> value = {
            "message": "tool failed with apikey=" + raw_secret,
            "args": {"apikey": raw_secret, "note": "<credential-1>"},
        };
        hash<auto> redacted = cast<hash<auto>>(
            PromptSecretProtector::redactProtectedValues(value, placeholders));
        assertFalse(sprintf("%y", redacted).find(raw_secret) >= 0);
        assertEq("<redacted>", redacted.args.apikey);
        assertEq("<redacted>", redacted.args.note);
        assertTrue(redacted.message.find("<redacted>") >= 0);
    }

    promptSecretRedactSensitiveValueTest() {
        hash<auto> value = {
            "apikey": "secret-value-12345",
            "nested": {
                "plain": "use api key secret-value-67890",
                "url": "https://example.com",
                "url_with_auth": "https://user:secret-value-99999@example.com/path",
            },
            "svalue": "secret-value-54321",
        };
        hash<auto> redacted = cast<hash<auto>>(
            PromptSecretProtector::redactSensitiveValue(value));
        assertEq("<redacted>", redacted.apikey);
        assertEq("<redacted>", redacted.svalue);
        assertFalse(redacted.nested.plain.find("secret-value-67890") >= 0);
        assertEq("https://example.com", redacted.nested.url);
        assertEq("https://user:<redacted>@example.com/path",
            redacted.nested.url_with_auth);
    }
}
