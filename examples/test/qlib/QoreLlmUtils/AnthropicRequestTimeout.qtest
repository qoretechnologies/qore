#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
#
# Anthropic's chat and completion requests honour the request's own timeout (LlmRequestOptions::timeout_ms), not
# only the client's (LlmBackendConfig::timeout_ms, 120 s by default): a long requirement decomposition with a
# 900 s request timeout was cut off after 120 s.  A local server accepts the connection and never answers.

%modern
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires json
%requires QUnit
%requires QoreLlmTypes
%requires QoreLlmUtils
%requires AnthropicRestClient
%exec-class AnthropicRequestTimeoutTest

public class AnthropicRequestTimeoutTest inherits QUnit::Test {
    private {
        Socket server();
        int port;
        Counter stop(1);
        Counter acceptor(1);
        list<Socket> accepted = ();
    }

    constructor() : Test("AnthropicRequestTimeoutTest", "1.0") {
        server.bind("127.0.0.1:0", True);
        server.listen();
        port = server.getSocketInfo().port;
        # accept and hold every connection without answering; the accept call is woken by a connection at the end
        background sub () {
            on_exit acceptor.dec();
            while (True) {
                *Socket s;
                try {
                    s = server.accept(3600s);
                } catch (hash<ExceptionInfo> ex) {
                    break;
                }
                if (!stop.getCount()) {
                    break;
                }
                accepted += s;
            }
        }();
        addTestCase("chat honours the request timeout", \chatTest());
        addTestCase("complete honours the request timeout", \completeTest());
        set_return_value(main());
        stop.dec();
        Socket wake();
        wake.connect(sprintf("127.0.0.1:%d", port), 5s);
        acceptor.waitForZero();
    }

    private AnthropicRestClient::AnthropicLlmProvider provider() {
        return new AnthropicRestClient::AnthropicLlmProvider(<QoreLlmUtils::LlmBackendConfig>{
            "mode": "anthropic",
            "url": sprintf("http://127.0.0.1:%d", port),
            "model": "claude-opus-4-8",
            "api_key": "test",
            "max_retries": 0,
            # longer than any test run: only the request's own timeout can end the request
            "timeout_ms": 3600000,
        });
    }

    chatTest() {
        AnthropicRestClient::AnthropicLlmProvider p = provider();
        assertThrows("LLM-ERROR", \p.chat(),
            ((<QoreLlmUtils::ChatMessage>{"role": "user", "content": "go"},), NOTHING,
            <QoreLlmUtils::LlmRequestOptions>{"timeout_ms": 500, "max_retries": 0}));
    }

    completeTest() {
        AnthropicRestClient::AnthropicLlmProvider p = provider();
        assertThrows("LLM-ERROR", \p.complete(), ("rules", "go", NOTHING,
            <QoreLlmUtils::LlmRequestOptions>{"timeout_ms": 500, "max_retries": 0}));
    }
}
