%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/ConnectionProvider
%requires ../../../../qlib/DataProvider
%requires ../../../../qlib/QoreRagTypes.qm
%requires ../../../../qlib/QoreRagUtils
%requires ../../../../qlib/JinaRestClient.qm

%requires ../../../../qlib/HttpServer.qm
%requires ../../../../qlib/HttpServerUtil.qm

%exec-class JinaRestClientTest

#! Records requests and simulates Jina's HTTP 200 key-check responses
class FakeJinaKeyHandler inherits AbstractHttpRequestHandler {
    private {
        Mutex m();
        string response = "[]";
        int status = 200;
        hash<auto> request;
    }

    setResponse(string response, int status = 200) {
        AutoLock al(m);
        self.response = response;
        self.status = status;
    }

    hash<auto> getRequest() {
        AutoLock al(m);
        return request;
    }

    hash handleRequest(hash cx, hash hdr, *data body) {
        AutoLock al(m);
        request = hdr;
        return makeResponse(status, response, {"Content-Type": MimeTypeJson});
    }
}

#! Exercises the synchronous fallback as well as the usual async client
class SyncJinaConnection inherits JinaRestClient::JinaRestConnection {
    constructor(string url, hash<auto> options)
            : JinaRestConnection("sync-test", "test", url, {}, options) {
    }

    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        throw "CONNECTION-ASYNC-UNSUPPORTED", "exercise synchronous ping";
    }
}

#! Records when a polling operation releases its originating connection
class LifetimeJinaConnection inherits JinaRestClient::JinaRestConnection {
    private {
        *Counter destroyed;
    }

    constructor(string url, Counter destroyed)
            : JinaRestConnection("lifetime-test", "test", url, {},
                {"apikey": "trial-key", "http_version": "1.1"}) {
        self.destroyed = destroyed;
    }

    destructor() {
        if (destroyed) {
            destroyed.dec();
        }
    }
}

public class JinaRestClientTest inherits QUnit::Test {
    public {
        #! command-line options; use -c/--connection to run the live tests
        const MyOpts = Opts + {
            "conn": "c,connection=s",
        };

        const OptionColumn = 22;
    }

    private {
        #! name of a live Jina AI connection, if given
        *string conn_name;
        HttpServer http;
        FakeJinaKeyHandler key_handler;
        int port;
    }

    constructor() : Test("JinaRestClient Test", "1.0", \ARGV, MyOpts) {
        conn_name = m_options.conn ?? ENV.JINA_CONNECTION;

        addTestCase("connection scheme registered",     \connectionSchemeTest());
        addTestCase("embedder factory registered",      \embedderFactoryTest());
        addTestCase("reranker factory registered",      \rerankerFactoryTest());
        addTestCase("embedder requires api_key",        \embedderConfigTest());
        addTestCase("reranker requires api_key",        \rerankerConfigTest());
        addTestCase("REST client options apply Bearer mapping",
            \restOptionsTest());
        addTestCase("connection accepts both model options and rejects unknown ones",
            \connectionOptionsTest());
        addTestCase("live: ping + embed + rerank with the connection's models",
            \liveConnectionTest());
        addTestCase("ping verifies keys on all transports", \pingTest());
        addTestCase("polling pings retain their originating connection", \pollLifetimeTest());
        addTestCase("ping rejects malformed responses and HTTP errors", \pingFailureTest());
        addTestCase("stored connection migration and required secrets", \connectionMigrationTest());
        if (ENV.JINAAI_APIKEY) {
            addTestCase("live valid and invalid API key pings", \livePingTest());
        }
        set_return_value(main());
    }

    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-c,--connection=ARG",
            "set the Jina AI connection name; without it (and without the "
            "JINA_CONNECTION env var) the live test is skipped",
            OptionColumn);
    }

    private connectionSchemeTest() {
        hash<ConnectionSchemeInfo> info =
            ConnectionProvider::ConnectionSchemeCache::getScheme("jina");
        assertEq("Jina AI REST Connection", info.display_name);
        assertTrue(info.schemes.jina);
        assertEq("apikey", info.required_options);
        assertEq("/v1/batches?limit=1", info.options.ping_path.default_value);
        assertEq("GET", info.options.ping_method.default_value);

        # the connection serves both /embeddings and /rerank; the two model
        # families are distinct and are configured independently
        hash<ConnectionOptionInfo> emb = info.options."embedding-model";
        assertEq("Embedding Model", emb.display_name);
        assertEq("string", emb.type);
        assertEq("jina-embeddings-v3", emb.default_value);
        assertEq(JinaRestClient::JinaRestClientBase::DefaultEmbeddingModel,
            emb.default_value);

        hash<ConnectionOptionInfo> rr = info.options."rerank-model";
        assertEq("Reranking Model", rr.display_name);
        assertEq("string", rr.type);
        assertEq("jina-reranker-v2-base-multilingual", rr.default_value);
        assertEq(JinaRestClient::JinaRestClientBase::DefaultRerankModel,
            rr.default_value);
        assertNeq(emb.default_value, rr.default_value);
    }

    private embedderFactoryTest() {
        QoreRagUtils::AbstractEmbedderFactory ef =
            QoreRagUtils::RagProviderRegistry::getEmbedderFactoryEx("jina");
        assertEq("jina", ef.getType());
        assertEq("Jina AI embeddings", ef.getDisplayName());
    }

    private rerankerFactoryTest() {
        QoreRagUtils::AbstractRerankerFactory rf =
            QoreRagUtils::RagProviderRegistry::getRerankerFactoryEx("jina");
        assertEq("jina", rf.getType());
        assertEq("Jina AI rerank", rf.getDisplayName());
    }

    private embedderConfigTest() {
        assertThrows("EMBEDDER-CONFIG-ERROR", sub () {
            new QoreRagUtils::JinaEmbedder(<QoreRagUtils::EmbedderConfig>{
                "backend": "jina",
                "model": "jina-embeddings-v3",
            });
        });
        QoreRagUtils::JinaEmbedder e(<QoreRagUtils::EmbedderConfig>{
            "backend": "jina",
            "api_key": "k",
        });
        assertEq("jina-embeddings-v3", e.getModel());
    }

    private rerankerConfigTest() {
        assertThrows("RERANKER-CONFIG-ERROR", sub () {
            new QoreRagUtils::JinaReranker(<QoreRagUtils::RerankerConfig>{
                "backend": "jina",
                "model": "jina-reranker-v2-base-multilingual",
            });
        });
        QoreRagUtils::JinaReranker r(<QoreRagUtils::RerankerConfig>{
            "backend": "jina",
            "api_key": "k",
        });
        assertEq("jina-reranker-v2-base-multilingual", r.getModel());
    }

    private restOptionsTest() {
        hash<auto> opts = JinaRestClient::JinaRestClientBase::getOptions({
            "apikey": "my-key",
            "embedding-model": "jina-embeddings-v2-base-en",
            "rerank-model": "jina-colbert-v2",
        });
        assertEq("my-key", opts.token);
        assertEq(NOTHING, opts.apikey);
        assertEq("https://api.jina.ai", opts.url);
        assertEq("v1", opts.api);
        assertEq("/v1", opts.default_path);
        # connection-level metadata must not leak into REST client options
        assertEq(NOTHING, opts{"embedding-model"});
        assertEq(NOTHING, opts{"rerank-model"});
    }

    private connectionOptionsTest() {
        JinaRestClient::JinaRestConnection conn("jina-test", "test connection",
            JinaRestClient::JinaRestConnection::DefaultUrl, {}, {
                "apikey": "my-key",
                "embedding-model": "jina-embeddings-v2-base-en",
                "rerank-model": "jina-colbert-v2",
            });
        assertEq("jina", conn.getType());
        # getRealOptions() reports the configured connection option values
        assertEq("jina-embeddings-v2-base-en",
            conn.getRealOptions(){"embedding-model"});
        assertEq("jina-colbert-v2", conn.getRealOptions(){"rerank-model"});
        # a client must still be constructible with the connection-only options present
        object client = conn.get(False);
        assertTrue(client instanceof JinaRestClient::JinaRestClient);

        assertThrows("CONNECTION-OPTION-ERROR", sub () {
            new JinaRestClient::JinaRestConnection("jina-bad", "test",
                JinaRestClient::JinaRestConnection::DefaultUrl, {}, {
                    "apikey": "my-key",
                    "reranking_model": "jina-colbert-v2",
                });
        });
    }

    #! exercises a real Jina AI connection end to end: ping, embed, rerank
    /** the embedding and reranking models come from the connection's
        \c embedding-model and \c rerank-model options, falling back to the
        scheme defaults when the connection does not set them
    */
    private liveConnectionTest() {
        if (!conn_name && !ENV.JINAAI_APIKEY) {
            testSkip("no Jina AI connection given; use -c/--connection or set "
                "JINA_CONNECTION");
        }
        AbstractConnection conn = conn_name ? get_connection(conn_name)
            : new JinaRestClient::JinaRestConnection("live-jina", "live test",
                JinaRestClient::JinaRestConnection::DefaultUrl, {}, {"apikey": ENV.JINAAI_APIKEY});
        hash<PingInfo> ping = conn.ping(True);
        assertTrue(ping.ok, sprintf("connection %y ping failed: %s", conn_name,
            ping.info ?? "no info"));

        *hash<auto> copts = conn.getRealOptions();
        string emb_model = copts{"embedding-model"}
            ?? JinaRestClient::JinaRestClientBase::DefaultEmbeddingModel;
        string rr_model = copts{"rerank-model"}
            ?? JinaRestClient::JinaRestClientBase::DefaultRerankModel;

        AbstractDataProvider prov = conn.getDataProvider();
        AbstractDataProvider emb = prov.getChildProvider("create-embeddings");
        hash<auto> eresp = emb.doRequest({
            "model": emb_model,
            "input": ("What is machine learning?",),
        });
        assertEq(1, eresp.data.lsize(), "one embedding per input text");
        assertEq(0, eresp.data[0]."index");
        assertTrue(eresp.data[0].embedding.lsize() > 0, "embedding vector is non-empty");

        AbstractDataProvider rrk = prov.getChildProvider("rerank");
        hash<auto> rresp = rrk.doRequest({
            "model": rr_model,
            "query": "What is machine learning?",
            "documents": (
                "Machine learning is a branch of AI focused on data-driven learning.",
                "The stock market closed higher today.",
            ),
            "top_n": 2,
        });
        assertEq(2, rresp.results.lsize());
        assertTrue(rresp.results[0].relevance_score >= rresp.results[1].relevance_score,
            "results sorted by relevance descending");
        assertEq(0, rresp.results[0]."index",
            "the machine-learning document ranks above the unrelated one");
    }
    globalSetUp() {
        Logger logger("test", LoggerLevel::getLevelWarn());
        http = new HttpServer(<HttpServerOptionInfo>{"logger": logger, "debug": False});
        port = http.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        key_handler = new FakeJinaKeyHandler();
        http.setHandler("key", "/v1/batches", MimeTypeJson, key_handler);
    }

    globalTearDown() {
        delete http;
    }

    private JinaRestClient::JinaRestConnection makeConnection() {
        return new JinaRestClient::JinaRestConnection("ping-test", "test",
            sprintf("http://127.0.0.1:%d", port), {}, {"apikey": "trial-key", "http_version": "1.1"});
    }

    #! Drives the public polling API using socket readiness, with a single bounded deadline
    private drivePing(AbstractPollOperation op) {
        on_exit op.abort();
        date deadline = now_us() + 15s;
        while (!op.goalReached()) {
            *hash<SocketPollInfo> info = op.continuePoll();
            if (info) {
                timeout remaining = deadline - now_us();
                assertTrue(remaining > 0, "ping completes before deadline");
                assertTrue(exists Socket::poll((info,), remaining), "ping socket becomes ready");
            }
        }
    }

    private runPing(int transport) {
        if (transport == 0) {
            makeConnection().ping(True);
        } else if (transport == 1) {
            drivePing(makeConnection().startPollConnect());
        } else if (transport == 2) {
            SyncJinaConnection conn(sprintf("http://127.0.0.1:%d", port),
                {"apikey": "trial-key", "http_version": "1.1"});
            conn.ping(True);
        } else {
            JinaRestClient::JinaRestConnection conn = makeConnection();
            drivePing(new RestClient::RestPingPollOperation(conn, conn.get(False), conn.getRealOptions()));
        }
    }

    #! The caller receives only the operation; the connection leaves this scope.
    private AbstractPollOperation makeLifetimePing(bool async, Counter destroyed) {
        LifetimeJinaConnection conn(sprintf("http://127.0.0.1:%d", port), destroyed);
        if (async) {
            return conn.startPollConnect();
        }
        return new RestClient::RestPingPollOperation(conn, conn.get(False), conn.getRealOptions());
    }

    private pollLifetimeTest() {
        foreach bool async in (False, True) {
            # Exercise success, an HTTP authentication error, and early abort.
            for (int outcome = 0; outcome < 3; ++outcome) {
                key_handler.setResponse("[]", outcome == 1 ? 401 : 200);
                Counter destroyed(1);
                *AbstractPollOperation op = makeLifetimePing(async, destroyed);
                on_exit {
                    if (op) {
                        op.abort();
                        delete op;
                    }
                }
                string case_info = sprintf("async=%y outcome=%d", async, outcome);
                assertEq(1, destroyed.getCount(), case_info + ": operation retains the connection");
                if (outcome == 0) {
                    drivePing(op);
                    assertTrue(op.goalReached(), case_info + ": ping completed");
                } else if (outcome == 1) {
                    *hash<ExceptionInfo> error;
                    try {
                        drivePing(op);
                    } catch (hash<ExceptionInfo> ex) {
                        error = ex;
                    }
                    assertTrue(exists error, case_info + ": HTTP error propagated");
                    assertRegex("^(REST-PING-ERROR|REST-RESPONSE-ERROR|HTTP-CLIENT-RECEIVE-ERROR)$",
                        error.err, sprintf("%s: %Y", case_info, error));
                } else {
                    op.abort();
                    assertFalse(op.goalReached(), case_info + ": aborted ping did not succeed");
                }
                assertEq(1, destroyed.getCount(), case_info + ": connection lives until operation disposal");
                delete op;
                assertEq(0, destroyed.waitForZero(5s), case_info + ": disposing operation releases connection");
            }
        }
        key_handler.setResponse("[]");
    }

    private pingTest() {
        key_handler.setResponse("[]");
        for (int transport = 0; transport < 4; ++transport) {
            runPing(transport);
            hash<auto> request = key_handler.getRequest();
            assertEq("GET", request.method);
            assertEq("v1/batches?limit=1", request.path, sprintf("transport %d", transport));
            assertEq("Bearer trial-key", request.authorization);
        }
    }

    private pingFailureTest() {
        foreach string response in ("{\"valid\":false}", "{}", "{\"valid\":\"true\"}",
                "{\"valid\":1}", "null", "not JSON") {
            key_handler.setResponse(response);
            for (int transport = 0; transport < 4; ++transport) {
                *hash<ExceptionInfo> error;
                try {
                    runPing(transport);
                } catch (hash<ExceptionInfo> ex) {
                    error = ex;
                }
                assertTrue(exists error, "invalid ping must fail");
                assertRegex("^(REST-PING-ERROR|REST-RESPONSE-ERROR|DESERIALIZATION-ERROR|JSON-PARSE-ERROR)$", error.err,
                    sprintf("response %y transport %d: %Y", response, transport, error));
            }
        }
        foreach int status in (401, 429, 500) {
            key_handler.setResponse("[]", status);
            for (int transport = 0; transport < 4; ++transport) {
                *hash<ExceptionInfo> error;
                try {
                    runPing(transport);
                } catch (hash<ExceptionInfo> ex) {
                    error = ex;
                }
                assertTrue(exists error, "invalid ping must fail");
                assertRegex("^(REST-PING-ERROR|REST-RESPONSE-ERROR|HTTP-CLIENT-RECEIVE-ERROR)$", error.err,
                    sprintf("HTTP %d transport %d: %Y", status, transport, error));
            }
        }
        key_handler.setResponse("[]");
        assertTrue(makeConnection().ping(True).ok, "a new successful ping recovers from failure");
    }

    private connectionMigrationTest() {
        foreach string path in ("models", "/models", "/v1/models") {
            JinaRestClient::JinaRestConnection conn({
                "name": "saved-jina", "desc": "saved connection", "url": "jina://localhost",
                "opts": {"apikey": "key", "ping_method": "GET", "ping_path": path},
            });
            assertEq("JinaAi", conn.getAppName());
            assertEq("JinaAi", conn.getInfo().app);
            assertEq("GET", conn.getRealOptions().ping_method);
            assertEq("/v1/batches?limit=1", conn.getRealOptions().ping_path);
        }
        assertTrue(JinaRestClient::JinaRestConnection::ConnectionScheme.options.apikey.sensitive);
        assertThrows("CONNECTION-OPTION-ERROR", sub () {
            new JinaRestClient::JinaRestConnection("missing", "test");
        });
    }

    private livePingTest() {
        if (!ENV.JINAAI_APIKEY) {
            testSkip("set JINAAI_APIKEY to run live authentication checks");
        }
        JinaRestClient::JinaRestConnection conn("live-jina", "live trial key",
            JinaRestClient::JinaRestConnection::DefaultUrl, {}, {"apikey": ENV.JINAAI_APIKEY});
        assertTrue(conn.ping(True).ok);
        drivePing(conn.startPollConnect());
        JinaRestClient::JinaRestConnection invalid("invalid-jina", "invalid key",
            JinaRestClient::JinaRestConnection::DefaultUrl, {}, {"apikey": "invalid-qore-test-key"});
        *hash<ExceptionInfo> error;
        try {
            invalid.ping(True);
        } catch (hash<ExceptionInfo> ex) {
            error = ex;
        }
        assertTrue(exists error, "an invalid key must fail the normal ping");
        assertEq("REST-RESPONSE-ERROR", error.err);
        assertEq(401, error.arg.status_code);
        error = NOTHING;
        try {
            drivePing(invalid.startPollConnect());
        } catch (hash<ExceptionInfo> ex) {
            error = ex;
        }
        assertTrue(exists error, "an invalid key must fail the polling transport ping");
        assertRegex("^(REST-PING-ERROR|REST-RESPONSE-ERROR)$", error.err);
    }


}
