%require-types
%enable-all-warnings
%new-style
%strict-args

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/DataProvider
%requires ../../../../qlib/ConnectionProvider
%requires ../../../../qlib/RestClient.qm

%try-module json
%define NoJson
%endtry

%requires ../../../../qlib/ZohoBooksRestClient.qm
%requires ../../../../qlib/ZohoBooksDataProvider

%exec-class ZohoBooksDataProviderTest

public class ZohoBooksDataProviderTest inherits QUnit::Test {
    private {
        #! Zoho Books REST client for integration tests
        *ZohoBooksRestClient::ZohoBooksRestClient client;

        #! Logger for verbose output
        Logger logger;

        #! Custom command-line options
        const MyOpts = Opts + {
            "client_id": "i,client-id=s",
            "client_secret": "s,client-secret=s",
            "refresh_token": "r,refresh-token=s",
            "org_id": "o,org-id=s",
            "subdomain": "S,subdomain=s",
            "domain": "D,domain=s",
            "conn": "c,connection=s",
        };

        #! Test customer ID (created during test)
        *string testCustomerId;

        #! Test invoice ID (created during test)
        *string testInvoiceId;

        #! Test item ID (created during test)
        *string testItemId;
    }

    constructor() : Test("ZohoBooksDataProvider Test", "1.0", \ARGV, MyOpts) {
        logger = new Logger("test", LoggerLevel::getLevelInfo());

        # Unit tests (always run, no credentials needed)
        addTestCase("sanity tests", \sanityTests());
        addTestCase("factory tests", \factoryTests());
        addTestCase("metadata tests", \metadataTests());
        addTestCase("child provider tests", \childProviderTests());
        addTestCase("data type tests", \dataTypeTests());
        addTestCase("negative tests", \negativeTests());
        addTestCase("corner case tests", \cornerCaseTests());
        addTestCase("connection tests", \connectionTests());
        addTestCase("action catalog tests", \actionCatalogTests());

        # Integration tests (require Zoho Books credentials)
        addTestCase("integration tests", \integrationTests());

        # Polling trigger tests (require credentials)
        addTestCase("polling trigger tests", \pollingTriggerTests());

        # Try to set up connection for integration tests
        try {
            setupConnection();
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("Connection setup failed: %s: %s\n", ex.err, ex.desc);
            }
        }

        set_return_value(main());
    }

    #! Sets up the Zoho Books client for integration tests
    private setupConnection() {
        *string client_id = m_options.client_id ?? ENV.ZOHOBOOKS_CLIENT_ID;
        *string client_secret = m_options.client_secret ?? ENV.ZOHOBOOKS_CLIENT_SECRET;
        *string refresh_token = m_options.refresh_token ?? ENV.ZOHOBOOKS_REFRESH_TOKEN;
        *string org_id = m_options.org_id ?? ENV.ZOHOBOOKS_ORGANIZATION_ID;

        if (!client_id || !client_secret || !refresh_token || !org_id) {
            if (m_options.verbose) {
                printf("Missing Zoho Books credentials. Required:\n");
                printf("  - ZOHOBOOKS_CLIENT_ID or -i option\n");
                printf("  - ZOHOBOOKS_CLIENT_SECRET or -s option\n");
                printf("  - ZOHOBOOKS_REFRESH_TOKEN or -r option\n");
                printf("  - ZOHOBOOKS_ORGANIZATION_ID or -o option\n");
            }
            return;
        }

        hash<auto> opts = {
            "oauth2_client_id": client_id,
            "oauth2_client_secret": client_secret,
            "oauth2_refresh_token": refresh_token,
            "organization_id": org_id,
            "subdomain": m_options.subdomain ?? ENV.ZOHOBOOKS_SUBDOMAIN ?? "zoho",
            "domain": m_options.domain ?? ENV.ZOHOBOOKS_DOMAIN ?? ".com",
        };

        client = new ZohoBooksRestClient::ZohoBooksRestClient(opts);
    }

    #! Check if json module is available
    private checkJson() {
%ifdef NoJson
        testSkip("no json module present");
%endif
    }

    #! Basic sanity tests - provider instantiation
    sanityTests() {
        checkJson();
        # Test creating provider with fake credentials via zohobooksrestclient_options
        # Note: This may fail with OAuth2 errors since Zoho requires authorization_code grant
        try {
            ZohoBooksDataProvider::ZohoBooksDataProvider prov({
                "subdomain": "zoho",
                "domain": ".com",
                "zohobooksrestclient_options": {
                    "oauth2_client_id": "fake-client-id",
                    "oauth2_client_secret": "fake-client-secret",
                },
            });
            assertEq("zohobooks", prov.getName());
            assertTrue(prov.getDesc().val());
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "OAUTH2-ERROR") {
                testSkip("OAuth2 requires manual authorization - skipping sanity tests");
            }
            rethrow;
        }
    }

    #! Factory tests - verify factory registration
    factoryTests() {
        checkJson();
        # Verify factory is registered
        AbstractDataProviderFactory factory = DataProvider::getFactory("zohobooks");
        assertEq("zohobooks", factory.getInfo().name);
        assertEq("Zoho Books data provider factory", factory.getInfo().desc);
        assertTrue(factory.getInfo().children_can_support_apis);
        assertTrue(factory.getInfo().children_can_support_records);
        assertTrue(factory.getInfo().children_can_support_observers);

        # Verify factory can create provider with options
        hash<auto> factoryOpts = factory.getInfo().provider_info.constructor_options;
        assertTrue(factoryOpts.hasKey("zohobooksrestclient"));
    }

    #! Metadata tests - verify provider info structure
    metadataTests() {
        checkJson();
        try {
            ZohoBooksDataProvider::ZohoBooksDataProvider prov({
                "subdomain": "zoho",
                "domain": ".com",
                "zohobooksrestclient_options": {
                    "oauth2_client_id": "x",
                    "oauth2_client_secret": "x",
                },
            });
            hash<DataProviderInfo> info = prov.getInfo();

            assertTrue(info.supports_children);
            assertTrue(info.children_can_support_apis);
            assertTrue(info.children_can_support_records);
            assertTrue(info.children_can_support_observers);
            assertEq("ZohoBooksDataProvider", info.type);

            # Check constructor options
            assertTrue(info.constructor_options.hasKey("zohobooksrestclient"));
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "OAUTH2-ERROR") {
                testSkip("OAuth2 requires manual authorization - skipping metadata tests");
            }
            rethrow;
        }
    }

    #! Child provider tests - verify hierarchy
    childProviderTests() {
        checkJson();
        ZohoBooksDataProvider::ZohoBooksDataProvider prov;
        try {
            prov = new ZohoBooksDataProvider::ZohoBooksDataProvider({
                "subdomain": "zoho",
                "domain": ".com",
                "zohobooksrestclient_options": {
                    "oauth2_client_id": "x",
                    "oauth2_client_secret": "x",
                },
            });
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "OAUTH2-ERROR") {
                testSkip("OAuth2 requires manual authorization - skipping child provider tests");
            }
            rethrow;
        }

        # Check child provider names
        list<string> children = prov.getChildProviderNames();

        # Verify CRUD providers exist
        assertTrue(children.contains("invoices"));
        assertTrue(children.contains("bills"));
        assertTrue(children.contains("contacts"));
        assertTrue(children.contains("expenses"));
        assertTrue(children.contains("items"));
        assertTrue(children.contains("estimates"));
        assertTrue(children.contains("salesorders"));
        assertTrue(children.contains("purchaseorders"));

        # Verify action providers exist
        assertTrue(children.contains("create-invoice"));
        assertTrue(children.contains("update-invoice"));
        assertTrue(children.contains("delete-invoice"));
        assertTrue(children.contains("get-invoice"));
        assertTrue(children.contains("email-invoice"));

        assertTrue(children.contains("create-bill"));
        assertTrue(children.contains("update-bill"));
        assertTrue(children.contains("delete-bill"));
        assertTrue(children.contains("get-bill"));

        assertTrue(children.contains("create-payment"));
        assertTrue(children.contains("update-payment"));
        assertTrue(children.contains("delete-payment"));
        assertTrue(children.contains("get-payment"));

        assertTrue(children.contains("create-contact"));
        assertTrue(children.contains("update-contact"));

        assertTrue(children.contains("create-expense"));
        assertTrue(children.contains("update-expense"));

        assertTrue(children.contains("create-item"));

        assertTrue(children.contains("create-estimate"));
        assertTrue(children.contains("update-estimate"));

        assertTrue(children.contains("create-salesorder"));
        assertTrue(children.contains("update-salesorder"));
        assertTrue(children.contains("delete-salesorder"));

        # Verify events provider exists
        assertTrue(children.contains("events"));

        # Check invoices child provider
        AbstractDataProvider invoices = prov.getChildProvider("invoices");
        assertEq("invoices", invoices.getName());
        hash<DataProviderInfo> invoicesInfo = invoices.getInfo();
        assertTrue(invoicesInfo.supports_read);
        assertTrue(invoicesInfo.supports_native_search);
        assertTrue(invoicesInfo.has_record);

        # Check bills child provider
        AbstractDataProvider bills = prov.getChildProvider("bills");
        assertEq("bills", bills.getName());
        hash<DataProviderInfo> billsInfo = bills.getInfo();
        assertTrue(billsInfo.supports_read);
        assertTrue(billsInfo.supports_native_search);

        # Check contacts child provider
        AbstractDataProvider contacts = prov.getChildProvider("contacts");
        assertEq("contacts", contacts.getName());
        hash<DataProviderInfo> contactsInfo = contacts.getInfo();
        assertTrue(contactsInfo.supports_read);
        assertTrue(contactsInfo.supports_native_search);

        # Check events child provider
        AbstractDataProvider events = prov.getChildProvider("events");
        assertEq("events", events.getName());
        hash<DataProviderInfo> eventsInfo = events.getInfo();
        assertTrue(eventsInfo.supports_children);

        # Check events child providers (triggers)
        list<string> eventChildren = events.getChildProviderNames();
        assertTrue(eventChildren.contains("new-invoice"));
        assertTrue(eventChildren.contains("new-bill"));
        assertTrue(eventChildren.contains("new-payment"));
        assertTrue(eventChildren.contains("new-customer"));
        assertTrue(eventChildren.contains("new-expense"));
        assertTrue(eventChildren.contains("new-salesorder"));
        assertTrue(eventChildren.contains("new-estimate"));
        assertTrue(eventChildren.contains("new-item"));
        assertTrue(eventChildren.contains("new-purchaseorder"));
        assertTrue(eventChildren.contains("new-vendor"));

        # Verify event providers have correct info
        AbstractDataProvider newInvoiceEvent = events.getChildProvider("new-invoice");
        assertEq("new-invoice", newInvoiceEvent.getName());
        hash<DataProviderInfo> newInvoiceInfo = newInvoiceEvent.getInfo();
        assertTrue(newInvoiceInfo.supports_observable);
    }

    #! Data type tests - verify record type definitions
    dataTypeTests() {
        checkJson();
        # Test invoice data type
        ZohoBooksDataProvider::ZohoBooksInvoiceDataType invoiceType();
        hash<string, AbstractDataField> invoiceFields = invoiceType.getFields();
        assertTrue(invoiceFields.hasKey("invoice_id"));
        assertTrue(invoiceFields.hasKey("customer_id"));
        assertTrue(invoiceFields.hasKey("customer_name"));
        assertTrue(invoiceFields.hasKey("invoice_number"));
        assertTrue(invoiceFields.hasKey("date"));
        assertTrue(invoiceFields.hasKey("due_date"));
        assertTrue(invoiceFields.hasKey("total"));
        assertTrue(invoiceFields.hasKey("balance"));
        assertTrue(invoiceFields.hasKey("status"));
        assertTrue(invoiceFields.hasKey("line_items"));
        assertTrue(invoiceFields.hasKey("currency_code"));
        assertTrue(invoiceFields.hasKey("created_time"));

        # Verify example_value exists for key fields (auto-generated from type/description)
        assertTrue(invoiceFields.invoice_id.getExampleValue().val());
        assertTrue(invoiceFields.invoice_number.getExampleValue().val());

        # Test line item data type
        ZohoBooksDataProvider::ZohoBooksLineItemDataType lineItemType();
        hash<string, AbstractDataField> lineItemFields = lineItemType.getFields();
        assertTrue(lineItemFields.hasKey("line_item_id"));
        assertTrue(lineItemFields.hasKey("item_id"));
        assertTrue(lineItemFields.hasKey("name"));
        assertTrue(lineItemFields.hasKey("description"));
        assertTrue(lineItemFields.hasKey("quantity"));
        assertTrue(lineItemFields.hasKey("rate"));
        assertTrue(lineItemFields.hasKey("item_total"));
        assertTrue(lineItemFields.hasKey("unit"));
        assertTrue(lineItemFields.hasKey("discount"));
        assertTrue(lineItemFields.hasKey("tax_id"));

        # Test create invoice request data type
        ZohoBooksDataProvider::ZohoBooksCreateInvoiceRequestDataType createInvoiceType();
        hash<string, AbstractDataField> createInvoiceFields = createInvoiceType.getFields();
        assertTrue(createInvoiceFields.hasKey("customer_id"));
        assertTrue(createInvoiceFields.hasKey("date"));
        assertTrue(createInvoiceFields.hasKey("due_date"));
        assertTrue(createInvoiceFields.hasKey("line_items"));
        assertTrue(createInvoiceFields.hasKey("invoice_number"));
        assertTrue(createInvoiceFields.hasKey("reference_number"));
        assertTrue(createInvoiceFields.hasKey("notes"));
        assertTrue(createInvoiceFields.hasKey("terms"));
        assertTrue(createInvoiceFields.hasKey("discount"));
    }

    #! Negative tests - test error handling and invalid inputs
    negativeTests() {
        checkJson();
        ZohoBooksDataProvider::ZohoBooksDataProvider prov;
        try {
            prov = new ZohoBooksDataProvider::ZohoBooksDataProvider({
                "subdomain": "zoho",
                "domain": ".com",
                "zohobooksrestclient_options": {
                    "oauth2_client_id": "invalid",
                    "oauth2_client_secret": "invalid",
                },
            });
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "OAUTH2-ERROR") {
                testSkip("OAuth2 requires manual authorization - skipping negative tests");
            }
            rethrow;
        }

        # Test getting non-existent child provider
        assertThrows("INVALID-CHILD-PROVIDER", sub() {
            prov.getChildProviderEx("nonexistent");
        });

        # Test invalid child in events provider
        AbstractDataProvider events = prov.getChildProvider("events");
        assertThrows("INVALID-CHILD-PROVIDER", sub() {
            events.getChildProviderEx("invalid-event");
        });

        # Test invalid subdomain
        assertThrows("ZOHOBOOKS-ERROR", sub() {
            new ZohoBooksRestClient::ZohoBooksRestClient({
                "oauth2_client_id": "x",
                "oauth2_client_secret": "x",
                "subdomain": "invalid",
                "domain": ".com",
            });
        });

        # Test invalid domain
        assertThrows("ZOHOBOOKS-ERROR", sub() {
            new ZohoBooksRestClient::ZohoBooksRestClient({
                "oauth2_client_id": "x",
                "oauth2_client_secret": "x",
                "subdomain": "zoho",
                "domain": ".invalid",
            });
        });
    }

    #! Corner case tests - edge cases and boundary conditions
    cornerCaseTests() {
        checkJson();
        # Test with different subdomains
        ZohoBooksRestClient::ZohoBooksRestClient clientZoho({
            "oauth2_client_id": "x",
            "oauth2_client_secret": "x",
            "subdomain": "zoho",
            "domain": ".com",
        }, True);
        assertEq("https://www.zohoapis.com/books/v3", clientZoho.getURL());
        assertEq("zoho", clientZoho.getSubdomain());
        assertEq(".com", clientZoho.getDomain());

        ZohoBooksRestClient::ZohoBooksRestClient clientZohoCloud({
            "oauth2_client_id": "x",
            "oauth2_client_secret": "x",
            "subdomain": "zohocloud",
            "domain": ".com",
        }, True);
        assertEq("https://www.zohoapis.com/books/v3", clientZohoCloud.getURL());
        assertEq("zohocloud", clientZohoCloud.getSubdomain());

        # Test with different domains
        ZohoBooksRestClient::ZohoBooksRestClient clientEU({
            "oauth2_client_id": "x",
            "oauth2_client_secret": "x",
            "subdomain": "zoho",
            "domain": ".eu",
        }, True);
        assertEq("https://www.zohoapis.eu/books/v3", clientEU.getURL());
        assertEq(".eu", clientEU.getDomain());

        ZohoBooksRestClient::ZohoBooksRestClient clientIN({
            "oauth2_client_id": "x",
            "oauth2_client_secret": "x",
            "subdomain": "zoho",
            "domain": ".in",
        }, True);
        assertEq("https://www.zohoapis.in/books/v3", clientIN.getURL());

        ZohoBooksRestClient::ZohoBooksRestClient clientAU({
            "oauth2_client_id": "x",
            "oauth2_client_secret": "x",
            "subdomain": "zoho",
            "domain": ".com.au",
        }, True);
        assertEq("https://www.zohoapis.com.au/books/v3", clientAU.getURL());

        ZohoBooksRestClient::ZohoBooksRestClient clientCA({
            "oauth2_client_id": "x",
            "oauth2_client_secret": "x",
            "subdomain": "zoho",
            "domain": ".ca",
        }, True);
        assertEq("https://www.zohoapis.ca/books/v3", clientCA.getURL());

        ZohoBooksRestClient::ZohoBooksRestClient clientSA({
            "oauth2_client_id": "x",
            "oauth2_client_secret": "x",
            "subdomain": "zoho",
            "domain": ".sa",
        }, True);
        assertEq("https://www.zohoapis.sa/books/v3", clientSA.getURL());

        ZohoBooksRestClient::ZohoBooksRestClient clientJP({
            "oauth2_client_id": "x",
            "oauth2_client_secret": "x",
            "subdomain": "zoho",
            "domain": ".jp",
        }, True);
        assertEq("https://www.zohoapis.jp/books/v3", clientJP.getURL());

        # Test default subdomain and domain
        ZohoBooksRestClient::ZohoBooksRestClient clientDefault({
            "oauth2_client_id": "x",
            "oauth2_client_secret": "x",
        }, True);
        assertEq("https://www.zohoapis.com/books/v3", clientDefault.getURL());
        assertEq("zoho", clientDefault.getSubdomain());
        assertEq(".com", clientDefault.getDomain());

        # Test organization_id handling
        ZohoBooksRestClient::ZohoBooksRestClient clientWithOrg({
            "oauth2_client_id": "x",
            "oauth2_client_secret": "x",
            "organization_id": "12345",
        }, True);
        assertEq("12345", clientWithOrg.getOrganizationId());

        # Test setOrganizationId
        clientWithOrg.setOrganizationId("67890");
        assertEq("67890", clientWithOrg.getOrganizationId());
    }

    #! Connection tests - verify connection scheme registration
    connectionTests() {
        checkJson();
        # Verify connection scheme is registered
        hash<ConnectionSchemeInfo> scheme = ConnectionSchemeCache::getScheme("zohobooks");
        assertEq("Zoho Books REST Connection", scheme.display_name);
        assertTrue(scheme.short_desc.val());
        assertTrue(scheme.desc.val());

        # Verify required options
        assertEq("subdomain,domain", scheme.required_options);
        assertTrue(scheme.options.hasKey("subdomain"));
        assertTrue(scheme.options.hasKey("domain"));
        assertTrue(scheme.options.hasKey("oauth2_client_id"));
        assertTrue(scheme.options.hasKey("oauth2_client_secret"));
        assertTrue(scheme.options.hasKey("oauth2_refresh_token"));
        # Note: organization_id is NOT a connection option - it's an action-level option with ref_data

        # Check subdomain option
        assertEq("zoho", scheme.options.subdomain.default_value);
        assertTrue(scheme.options.subdomain.preselected);
        assertTrue(scheme.options.subdomain.allowed_values.size() == 2);

        # Check domain option
        assertEq(".com", scheme.options.domain.default_value);
        assertTrue(scheme.options.domain.preselected);
        assertTrue(scheme.options.domain.allowed_values.size() == 7);

        # Verify connection can create data provider
        ZohoBooksRestClient::ZohoBooksRestConnection conn("test", "test connection",
            "zohobooks://www.zohoapis.com", {}, {
                "oauth2_client_id": "x",
                "oauth2_client_secret": "x",
                "subdomain": "zoho",
                "domain": ".com",
            });
        assertTrue(conn.hasDataProvider());
        assertEq("ZohoBooks", conn.getAppName());
        assertEq("zohobooks", conn.getType());
    }

    #! Action catalog tests - verify all actions are registered
    actionCatalogTests() {
        checkJson();
        # Get all actions for the Zoho Books app
        *list<hash<DataProviderActionInfo>> actions = DataProviderActionCatalog::getActions(
            ZohoBooksDataProvider::AppName);
        assertTrue(actions.size() > 0);

        # Verify action count (26 CRUD + 10 triggers = 36)
        assertEq(36, actions.size());

        # Get action names
        list<string> actionNames = map $1.action, actions;

        # Verify invoice actions
        assertTrue(actionNames.contains("create-invoice"));
        assertTrue(actionNames.contains("update-invoice"));
        assertTrue(actionNames.contains("delete-invoice"));
        assertTrue(actionNames.contains("get-invoice"));
        assertTrue(actionNames.contains("list-invoices"));
        assertTrue(actionNames.contains("email-invoice"));

        # Verify bill actions
        assertTrue(actionNames.contains("create-bill"));
        assertTrue(actionNames.contains("update-bill"));
        assertTrue(actionNames.contains("delete-bill"));
        assertTrue(actionNames.contains("get-bill"));
        assertTrue(actionNames.contains("list-bills"));

        # Verify payment actions
        assertTrue(actionNames.contains("create-payment"));
        assertTrue(actionNames.contains("update-payment"));
        assertTrue(actionNames.contains("delete-payment"));
        assertTrue(actionNames.contains("get-payment"));

        # Verify contact actions
        assertTrue(actionNames.contains("create-contact"));
        assertTrue(actionNames.contains("update-contact"));
        assertTrue(actionNames.contains("list-contacts"));

        # Verify expense actions
        assertTrue(actionNames.contains("create-expense"));
        assertTrue(actionNames.contains("update-expense"));

        # Verify item actions
        assertTrue(actionNames.contains("create-item"));

        # Verify estimate actions
        assertTrue(actionNames.contains("create-estimate"));
        assertTrue(actionNames.contains("update-estimate"));

        # Verify sales order actions
        assertTrue(actionNames.contains("create-salesorder"));
        assertTrue(actionNames.contains("update-salesorder"));
        assertTrue(actionNames.contains("delete-salesorder"));

        # Verify trigger actions
        assertTrue(actionNames.contains(ZohoBooksDataProvider::EVENT_NEW_INVOICE));
        assertTrue(actionNames.contains(ZohoBooksDataProvider::EVENT_NEW_BILL));
        assertTrue(actionNames.contains(ZohoBooksDataProvider::EVENT_NEW_PAYMENT));
        assertTrue(actionNames.contains(ZohoBooksDataProvider::EVENT_NEW_CUSTOMER));
        assertTrue(actionNames.contains(ZohoBooksDataProvider::EVENT_NEW_EXPENSE));
        assertTrue(actionNames.contains(ZohoBooksDataProvider::EVENT_NEW_SALESORDER));
        assertTrue(actionNames.contains(ZohoBooksDataProvider::EVENT_NEW_ESTIMATE));
        assertTrue(actionNames.contains(ZohoBooksDataProvider::EVENT_NEW_ITEM));
        assertTrue(actionNames.contains(ZohoBooksDataProvider::EVENT_NEW_PURCHASEORDER));
        assertTrue(actionNames.contains(ZohoBooksDataProvider::EVENT_NEW_VENDOR));

        # Verify create-invoice action has ref_data for customers
        *hash<DataProviderActionInfo> createInvoiceAction = DataProviderActionCatalog::getAppAction(
            ZohoBooksDataProvider::AppName, "create-invoice");
        assertTrue(exists createInvoiceAction, "create-invoice action should exist");
        assertTrue(createInvoiceAction.options.customer_id.ref_data == "customers");

        # Verify event actions have correct action_code
        *hash<DataProviderActionInfo> newInvoiceAction = DataProviderActionCatalog::getAppAction(
            ZohoBooksDataProvider::AppName, ZohoBooksDataProvider::EVENT_NEW_INVOICE);
        assertTrue(exists newInvoiceAction, "new-invoice action should exist");
        assertEq(DPAT_EVENT, newInvoiceAction.action_code);
        assertEq(ZohoBooksDataProvider::EVENT_NEW_INVOICE, newInvoiceAction.action_val);
    }

    #! Integration tests - require Zoho Books credentials
    integrationTests() {
        checkJson();
        if (!client) {
            testSkip("No Zoho Books credentials provided (use -i, -s, -r, -o options or env vars)");
            return;
        }

        # Test API connectivity
        testApiConnectivity();

        # Test reference data
        testReferenceData();

        # Test contacts/customers provider
        testContactsProvider();

        # Test items provider
        testItemsProvider();

        # Test invoices provider (requires customer and item)
        if (testCustomerId && testItemId) {
            testInvoicesProvider();
        }

        # Test data integrity
        if (testCustomerId && testItemId) {
            testInvoiceDataIntegrity();
        }

        # Test bills provider
        testBillsProvider();

        # Test estimates provider
        if (testCustomerId) {
            testEstimatesProvider();
        }

        # Test sales orders provider
        if (testCustomerId && testItemId) {
            testSalesOrdersProvider();
        }

        # Cleanup test data
        cleanup();
    }

    #! Test API connectivity
    private testApiConnectivity() {
        if (m_options.verbose) {
