    #! Test contacts/customers provider
    private testContactsProvider() {
        if (m_options.verbose) {
            printf("\n--- Testing Contacts Provider ---\n");
        }

        ZohoBooksDataProvider::ZohoBooksDataProvider prov(client);

        # List existing contacts
        AbstractDataProvider contactsProvider = prov.getChildProvider("contacts");
        list<hash<auto>> contacts = map $1, contactsProvider.searchRecords(NOTHING, {"contact_type": "customer"});

        if (m_options.verbose) {
            printf("Found %d customer contacts\n", contacts.size());
        }

        # Create a test customer
        AbstractDataProvider createContactProvider = prov.getChildProvider("create-contact");
        string testName = sprintf("Test Customer %s", now_us().format("YYYYMMDDHHmmss"));

        try {
            hash<auto> newContact = createContactProvider.doRequest({
                "contact_name": testName,
                "contact_type": "customer",
                "email": "test@example.com",
            });

            if (newContact.contact_id) {
                testCustomerId = newContact.contact_id;
                assertTrue(testCustomerId.val(), "Customer should be created with an ID");
                if (m_options.verbose) {
                    printf("Created test customer: %s (%s)\n", testName, testCustomerId);
                }

                # Verify the customer was created by fetching it
                list<hash<auto>> updatedContacts = map $1, contactsProvider.searchRecords(
                    NOTHING, {"contact_type": "customer"});
                bool found = False;
                foreach hash<auto> contact in (updatedContacts) {
                    if (contact.contact_id == testCustomerId) {
                        found = True;
                        assertEq(testName, contact.contact_name);
                        break;
                    }
                }
                assertTrue(found, "Created customer should be found in contact list");
            }
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("Create contact failed: %s: %s\n", ex.err, ex.desc);
            }
        }

        if (m_options.verbose) {
            printf("--- Contacts Provider tests completed ---\n");
        }
    }

