    #! Cleanup test data
    private cleanup() {
        if (m_options.verbose) {
            printf("\n--- Cleanup ---\n");
        }

        ZohoBooksDataProvider::ZohoBooksDataProvider prov(client);

        # Delete test invoice
        if (testInvoiceId) {
            try {
                AbstractDataProvider deleteInvoiceProvider = prov.getChildProvider("delete-invoice");
                deleteInvoiceProvider.doRequest({"invoice_id": testInvoiceId});
                if (m_options.verbose) {
                    printf("Deleted test invoice: %s\n", testInvoiceId);
                }
            } catch (hash<ExceptionInfo> ex) {
                if (m_options.verbose) {
                    printf("Failed to delete invoice: %s\n", ex.desc);
                }
            }
        }

        # Mark test customer inactive (contacts can't be deleted in Zoho Books)
        if (testCustomerId) {
            try {
                AbstractDataProvider updateContactProvider = prov.getChildProvider("update-contact");
                updateContactProvider.doRequest({
                    "contact_id": testCustomerId,
                    "status": "inactive",
                });
                if (m_options.verbose) {
                    printf("Marked test customer inactive: %s\n", testCustomerId);
                }
            } catch (hash<ExceptionInfo> ex) {
                if (m_options.verbose) {
                    printf("Failed to update customer: %s\n", ex.desc);
                }
            }
        }

        if (m_options.verbose) {
            printf("--- Cleanup completed ---\n");
        }
    }

    #! Polling trigger tests - test polling-based triggers
    pollingTriggerTests() {
        checkJson();
        if (!client) {
            testSkip("No Zoho Books credentials provided");
            return;
        }

        if (m_options.verbose) {
            printf("\n--- Testing Polling Trigger Providers ---\n");
        }

        # ============================================
        # Test New Invoice Event Provider
        # ============================================
        if (m_options.verbose) {
            printf("\nTesting ZohoBooksNewInvoiceWatchDataProvider...\n");
        }

        # Test event provider instantiation
        ZohoBooksDataProvider::ZohoBooksNewInvoiceWatchDataProvider invoiceEventProv(client, {
            "poll_interval": 60,
        });
        assertEq("new-invoice", invoiceEventProv.getName());

        # Verify provider metadata
        hash<DataProviderInfo> invoiceEventInfo = invoiceEventProv.getInfo();
        assertTrue(invoiceEventInfo.supports_observable);
        assertEq("ZohoBooksNewInvoiceWatchDataProvider", invoiceEventInfo.type);

        if (m_options.verbose) {
            printf("  Provider name: %s\n", invoiceEventProv.getName());
            printf("  Supports observable: %s\n", invoiceEventInfo.supports_observable);
        }

        # ============================================
        # Test New Bill Event Provider
        # ============================================
        if (m_options.verbose) {
            printf("\nTesting ZohoBooksNewBillWatchDataProvider...\n");
        }

        ZohoBooksDataProvider::ZohoBooksNewBillWatchDataProvider billEventProv(client, {
            "poll_interval": 60,
        });
        assertEq("new-bill", billEventProv.getName());
        assertTrue(billEventProv.getInfo().supports_observable);

        # ============================================
        # Test New Payment Event Provider
        # ============================================
        if (m_options.verbose) {
            printf("\nTesting ZohoBooksNewPaymentWatchDataProvider...\n");
        }

        ZohoBooksDataProvider::ZohoBooksNewPaymentWatchDataProvider paymentEventProv(client, {
            "poll_interval": 60,
        });
        assertEq("new-payment", paymentEventProv.getName());
        assertTrue(paymentEventProv.getInfo().supports_observable);

        # ============================================
        # Test New Customer Event Provider
        # ============================================
        if (m_options.verbose) {
            printf("\nTesting ZohoBooksNewCustomerWatchDataProvider...\n");
        }

        ZohoBooksDataProvider::ZohoBooksNewCustomerWatchDataProvider customerEventProv(client, {
            "poll_interval": 60,
        });
        assertEq("new-customer", customerEventProv.getName());
        assertTrue(customerEventProv.getInfo().supports_observable);

        # ============================================
        # Test New Expense Event Provider
        # ============================================
        if (m_options.verbose) {
            printf("\nTesting ZohoBooksNewExpenseWatchDataProvider...\n");
        }

        ZohoBooksDataProvider::ZohoBooksNewExpenseWatchDataProvider expenseEventProv(client, {
            "poll_interval": 60,
        });
        assertEq("new-expense", expenseEventProv.getName());
        assertTrue(expenseEventProv.getInfo().supports_observable);

        # ============================================
        # Test All Remaining Event Providers
        # ============================================
        if (m_options.verbose) {
            printf("\nTesting remaining event providers...\n");
        }

        ZohoBooksDataProvider::ZohoBooksNewSalesOrderWatchDataProvider salesOrderEventProv(client, {});
        assertEq("new-salesorder", salesOrderEventProv.getName());
        assertTrue(salesOrderEventProv.getInfo().supports_observable);

        ZohoBooksDataProvider::ZohoBooksNewEstimateWatchDataProvider estimateEventProv(client, {});
        assertEq("new-estimate", estimateEventProv.getName());
        assertTrue(estimateEventProv.getInfo().supports_observable);

        ZohoBooksDataProvider::ZohoBooksNewItemWatchDataProvider itemEventProv(client, {});
        assertEq("new-item", itemEventProv.getName());
        assertTrue(itemEventProv.getInfo().supports_observable);

        ZohoBooksDataProvider::ZohoBooksNewPurchaseOrderWatchDataProvider purchaseOrderEventProv(client, {});
        assertEq("new-purchaseorder", purchaseOrderEventProv.getName());
        assertTrue(purchaseOrderEventProv.getInfo().supports_observable);

        ZohoBooksDataProvider::ZohoBooksNewVendorWatchDataProvider vendorEventProv(client, {});
        assertEq("new-vendor", vendorEventProv.getName());
        assertTrue(vendorEventProv.getInfo().supports_observable);

        # ============================================
        # Test Observer Registration
        # ============================================
        if (m_options.verbose) {
            printf("\nTesting observer registration...\n");
        }

        TestObserver observer();
        invoiceEventProv.registerObserver(observer);

        # Note: We don't actually start polling in tests as it would make API calls
        # The observer registration test verifies the mechanism works

        if (m_options.verbose) {
            printf("  Observer registered successfully\n");
        }

        if (m_options.verbose) {
            printf("\n--- Polling Trigger tests completed ---\n");
        }
    }
}

#! Test observer for polling events
class TestObserver inherits Observer {
    public {
        list<hash<auto>> events = ();
    }

    update(string event_id, hash<auto> data) {
        events += {"event_id": event_id, "data": data};
    }
}
