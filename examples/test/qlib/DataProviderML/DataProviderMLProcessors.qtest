    # ===================== Integration Tests =====================

    integrationFactory() {
        # check that the factory is registered
        DataProvider::AbstractDataProviderFactory factory =
            DataProvider::DataProvider::getFactory("ml-processors");
        assertTrue(exists factory);
        hash<DataProviderFactoryInfo> info = factory.getInfo();
        assertEq("ml-processors", info.name);
    }

    integrationNavigation() {
        DataProviderML::MLProcessorsDataProvider provider();
        *list<string> children = provider.getChildProviderNames();
        assertTrue(exists children);
        assertTrue(children.contains("isolation-forest"));
        assertTrue(children.contains("dbscan-clustering"));
        assertTrue(children.contains("kmeans-clustering"));
        assertTrue(children.contains("pca"));
        assertTrue(children.contains("holt-winters"));
        assertTrue(children.contains("seasonal-decomposition"));
        assertTrue(children.contains("linear-regression"));
        assertTrue(children.contains("lof"));
        assertTrue(children.contains("gmm"));
        assertTrue(children.contains("standard-scaler"));
        assertTrue(children.contains("min-max-scaler"));
        assertTrue(children.contains("imputer"));
        assertTrue(children.contains("classification-metrics"));
        assertTrue(children.contains("regression-metrics"));
        assertTrue(children.contains("clustering-metrics"));
        assertTrue(children.contains("logistic-regression"));
        assertTrue(children.contains("knn-classification"));
        assertTrue(children.contains("knn-regression"));
        assertTrue(children.contains("decision-tree-classification"));
        assertTrue(children.contains("decision-tree-regression"));
        assertTrue(children.contains("random-forest-classification"));
        assertTrue(children.contains("random-forest-regression"));
        assertTrue(children.contains("gbt-classification"));
        assertTrue(children.contains("gbt-regression"));
        assertTrue(children.contains("rolling-stats"));
        assertTrue(children.contains("ewma"));
        assertTrue(children.contains("data-profile"));
        assertTrue(children.contains("schema-validation"));
        assertTrue(children.contains("text-normalize"));
        assertTrue(children.contains("tokenize"));
        assertTrue(children.contains("chunk-text"));
        assertTrue(children.contains("embed-text"));
        assertTrue(children.contains("extract-structured"));
        assertTrue(children.contains("rerank-text"));
        assertTrue(children.contains("semantic-chunk-text"));
        assertTrue(children.contains("guardrail-filter"));
        assertTrue(children.contains("guardrail-transform"));
        assertTrue(children.contains("ocr"));
        assertTrue(children.contains("pdf-ocr"));
        assertTrue(children.contains("document-ocr"));
        assertTrue(children.contains("vision-extraction"));

        hash<ML::MLCapabilities> caps = ML::ml_get_capabilities();
        int expected_count = 41;
        if (caps.has_onnx) {
            assertTrue(children.contains("onnx-model"));
            ++expected_count;
        }
        if (children.contains("registry-model")) {
            ++expected_count;
        }
        assertEq(expected_count, children.lsize());

        # check that each child can be retrieved
        foreach string name in (children) {
            *DataProvider::AbstractDataProvider child = provider.getChildProvider(name);
            assertTrue(exists child, sprintf("child '%s' should exist", name));
        }
    }

    integrationOutputTypes() {
        # verify each processor has an output type
        DataProviderML::QoreIsolationForestProcessor iforest({"fields": "x", "window_size": 10});
        assertTrue(exists iforest.getPipelineProcessorOutputType());

        DataProviderML::QoreDBSCANClusteringProcessor dbscan(
            {"fields": "x", "window_size": 10, "epsilon": 1.0});
        assertTrue(exists dbscan.getPipelineProcessorOutputType());

        DataProviderML::QoreKMeansProcessor kmeans(
            {"fields": "x", "window_size": 10, "k": 2});
        assertTrue(exists kmeans.getPipelineProcessorOutputType());

        DataProviderML::QorePCAProcessor pca({"fields": "x,y", "window_size": 10});
        assertTrue(exists pca.getPipelineProcessorOutputType());

        DataProviderML::QoreHoltWintersProcessor hw(
            {"fields": "x", "window_size": 100, "period": 4});
        assertTrue(exists hw.getPipelineProcessorOutputType());

        DataProviderML::QoreSeasonalDecompositionProcessor sd(
            {"fields": "x", "window_size": 24, "period": 4});
        assertTrue(exists sd.getPipelineProcessorOutputType());

        DataProviderML::QoreLinearRegressionProcessor lr(
            {"fields": "x", "target_field": "y", "window_size": 10});
        assertTrue(exists lr.getPipelineProcessorOutputType());

        DataProviderML::QoreLOFProcessor lof({"fields": "x,y", "window_size": 10, "k": 5});
        assertTrue(exists lof.getPipelineProcessorOutputType());

        DataProviderML::QoreGMMProcessor gmm(
            {"fields": "x", "window_size": 10, "n_components": 2});
        assertTrue(exists gmm.getPipelineProcessorOutputType());

        DataProviderML::QoreStandardScalerProcessor stdscaler(
            {"fields": "x,y", "window_size": 10});
        assertTrue(exists stdscaler.getPipelineProcessorOutputType());

        DataProviderML::QoreMinMaxScalerProcessor mmscaler(
            {"fields": "x,y", "window_size": 10});
        assertTrue(exists mmscaler.getPipelineProcessorOutputType());

        DataProviderML::QoreImputerProcessor imputer(
            {"fields": "x,y", "window_size": 10});
        assertTrue(exists imputer.getPipelineProcessorOutputType());

        DataProviderML::QoreClassificationMetricsProcessor clsm(
            {"predicted_field": "pred", "true_field": "actual", "window_size": 10});
        assertTrue(exists clsm.getPipelineProcessorOutputType());

        DataProviderML::QoreRegressionMetricsProcessor regm(
            {"predicted_field": "pred", "true_field": "actual", "window_size": 10});
        assertTrue(exists regm.getPipelineProcessorOutputType());

        DataProviderML::QoreClusteringMetricsProcessor clusm(
            {"fields": "x,y", "cluster_field": "c", "window_size": 10});
        assertTrue(exists clusm.getPipelineProcessorOutputType());

        # rolling-stats and ewma return NOTHING for output type (dynamic output)
        DataProviderML::QoreRollingStatsProcessor rstats(
            {"fields": "x,y", "window_size": 5});
        assertFalse(exists rstats.getPipelineProcessorOutputType());

        DataProviderML::QoreEWMAProcessor ewma(
            {"fields": "x,y", "alpha": 0.3});
        assertFalse(exists ewma.getPipelineProcessorOutputType());

        DataProviderML::QoreDataProfileProcessor dprof(
            {"fields": "x,y", "window_size": 10});
        assertTrue(exists dprof.getPipelineProcessorOutputType());

        # schema-validation returns NOTHING for output type (dynamic output)
        DataProviderML::QoreSchemaValidationProcessor sval({
            "schema": {"x": {"type": "int"}},
        });
        assertFalse(exists sval.getPipelineProcessorOutputType());

        if (ML::ml_get_capabilities().has_onnx) {
            DataProviderML::QoreOnnxModelProcessor onnx({
                "model_path": getTestModelPath(),
                "fields": "x",
                "window_size": 5,
            });
            assertTrue(exists onnx.getPipelineProcessorOutputType());
        }
    }

    # ===================== DataProfile Tests =====================

    dataProfileBasicProfiling() {
        DataProviderML::QoreDataProfileProcessor proc({
            "fields": "name,age",
            "window_size": 5,
        });

        list<auto> results;
        list<hash<auto>> data = (
            {"name": "Alice", "age": 30},
            {"name": "Bob", "age": 25},
            {"name": "Charlie", "age": 35},
            {"name": "Diana", "age": 28},
            {"name": "Eve", "age": 32},
        );
        foreach hash<auto> rec in (data) {
            *auto r = proc.processRecord(rec);
            DataProviderMLProcessorsTest::collectResult(\results, r);
        }

        # should emit 2 events (one per field) when window fills
        assertEq(2, results.lsize());

        # find name profile
        hash<auto> name_profile;
        hash<auto> age_profile;
        foreach auto event in (results) {
            if (event.field_name == "name") {
                name_profile = event;
            } else if (event.field_name == "age") {
                age_profile = event;
            }
        }

        assertEq("data-profile", name_profile.event_type);
        assertEq(5, name_profile.count);
        assertEq(0, name_profile.missing_count);
        assertEq(0.0, name_profile.missing_rate);
        assertEq("string", name_profile.type);
        assertEq(5, name_profile.cardinality);

        assertEq("data-profile", age_profile.event_type);
        assertEq(5, age_profile.count);
        assertEq("integer", age_profile.type);
        assertTrue(exists age_profile.min);
        assertTrue(exists age_profile.max);
        assertTrue(exists age_profile.mean);
        assertTrue(exists age_profile.std);
    }

    dataProfileMissingValues() {
        DataProviderML::QoreDataProfileProcessor proc({
            "fields": "value",
            "window_size": 4,
        });

        list<auto> results;
        list<hash<auto>> data = (
            {"value": 10},
            {"value": NOTHING},
            {"value": 30},
            {"value": NOTHING},
        );
        foreach hash<auto> rec in (data) {
            *auto r = proc.processRecord(rec);
            DataProviderMLProcessorsTest::collectResult(\results, r);
        }

        assertEq(1, results.lsize());
        assertEq(2, results[0].missing_count);
        assertFloat(0.5, results[0].missing_rate, 0.001);
    }

    dataProfileNumericStats() {
        DataProviderML::QoreDataProfileProcessor proc({
            "fields": "value",
            "window_size": 5,
        });

        list<auto> results;
        # values: 10, 20, 30, 40, 50 => mean=30, min=10, max=50
        list<hash<auto>> data = (
            {"value": 10.0},
            {"value": 20.0},
            {"value": 30.0},
            {"value": 40.0},
            {"value": 50.0},
        );
        foreach hash<auto> rec in (data) {
            *auto r = proc.processRecord(rec);
            DataProviderMLProcessorsTest::collectResult(\results, r);
        }

        assertEq(1, results.lsize());
        hash<auto> profile = results[0];
        assertFloat(10.0, profile.min, 0.001);
        assertFloat(50.0, profile.max, 0.001);
        assertFloat(30.0, profile.mean, 0.001);
        # std dev of (10,20,30,40,50) = sqrt(200) ~= 14.142
        assertFloat(14.142, profile.std, 0.1);
        assertEq(5, profile.cardinality);
        assertEq(0, profile.missing_count);
    }

    dataProfileOutlierDetection() {
        DataProviderML::QoreDataProfileProcessor proc({
            "fields": "value",
            "window_size": 12,
        });

        list<auto> results;
        # 10 normal values around 100, then 2 extreme outliers
        list<hash<auto>> data = (
            {"value": 100.0},
            {"value": 101.0},
            {"value": 99.0},
            {"value": 102.0},
            {"value": 98.0},
            {"value": 100.5},
            {"value": 99.5},
            {"value": 101.5},
            {"value": 98.5},
            {"value": 100.0},
            {"value": 500.0},   # outlier
            {"value": -200.0},  # outlier
        );
        foreach hash<auto> rec in (data) {
            *auto r = proc.processRecord(rec);
            DataProviderMLProcessorsTest::collectResult(\results, r);
        }

        assertEq(1, results.lsize());
        hash<auto> profile = results[0];
        assertTrue(exists profile.outlier_count);
        assertTrue(profile.outlier_count >= 2,
            sprintf("expected at least 2 outliers, got %d", profile.outlier_count));
    }

    dataProfileBufferColumnsShape() {
        DataProviderML::QoreDataProfileProcessor proc({
            "fields": ("value", "category", "missing"),
            "window_size": 4,
        });

        ColumnarResult columns = ColumnarResult::fromColumnHash({
            "id": new buffer<int64>((1, 2, 3, 4, 5)),
            "value": new buffer<float64>((10.0, 20.0, 30.0, 40.0, 50.0)),
            "category": ("a", "b", "a", "c", "d"),
        });

        auto result = proc.processRecordsShape(columns, DataProviderShape::BufferColumns);
        assertEq(DataProviderShape::BufferColumns, AbstractDataProcessor::detectShape(result),
            "data-profile should preserve BufferColumns output for complete windows");
        assertEq(3, AbstractDataProcessor::shapeRecordCount(result, DataProviderShape::BufferColumns));

        hash<auto> profiles = AbstractDataProcessor::convertShape(
            result, DataProviderShape::BufferColumns, DataProviderShape::HashOfLists)[0];
        assertEq(("value", "category", "missing"), profiles.field_name);
        assertEq((4, 4, 4), profiles.count);
        assertEq((0, 0, 4), profiles.missing_count);
        assertEq(("float", "string", "unknown"), profiles.type);
        assertEq((4, 3, 0), profiles.cardinality);
        assertFloat(25.0, profiles.mean[0], 0.001);

        *list<auto> flushed = proc.flushRecords();
        assertTrue(exists flushed);
        assertEq(3, flushed.lsize());
        assertEq(1, flushed[0].count);
        assertEq(50.0, flushed[0].min);
        assertEq(1, flushed[2].missing_count);
    }

    dataProfileFlushPartial() {
        DataProviderML::QoreDataProfileProcessor proc({
            "fields": "x",
            "window_size": 10,
        });

        # send 3 records (less than window)
        for (int i = 0; i < 3; ++i) {
            proc.processRecord({"x": i * 1.0});
        }

        # flush should emit events for the 3 buffered records
        *list<auto> flushed = proc.flushRecords();
        assertTrue(exists flushed);
        assertEq(1, flushed.lsize());  # one event per field
        assertEq(3, flushed[0].count);
    }

    dataProfileNotConfigured() {
        DataProviderML::QoreDataProfileProcessor proc();
        assertThrows("PROCESSOR-ERROR", sub() {
            proc.processRecord({"x": 1.0});
        });
    }

    dataProfileCapabilities() {
        DataProviderML::QoreDataProfileProcessor proc();
        assertEq(DPC_AGGREGATE, proc.getProcessorCapabilities());
        hash<DataProviderInfo> info = proc.getInfo();
        assertEq("QoreDataProfileProcessor", info{"type"});
        assertTrue(info.supports_pipeline_processor);
    }

    dataProfileConstructorValidation() {
        # missing required field
        assertThrows("CONSTRUCTOR-ERROR", sub() {
            new DataProviderML::QoreDataProfileProcessor({
                "fields": "x",
            });
        });
        # invalid window_size
        assertThrows("CONSTRUCTOR-ERROR", sub() {
            new DataProviderML::QoreDataProfileProcessor({
                "fields": "x",
                "window_size": 0,
            });
        });
        # empty fields
        assertThrows("CONSTRUCTOR-ERROR", sub() {
            new DataProviderML::QoreDataProfileProcessor({
                "fields": " , ",
                "window_size": 10,
            });
        });
    }

    # ===================== TextNormalize Tests =====================

    textNormalizeDataFrameShape() {
%ifdef NoDataFrame
        testSkip("dataframe module not available");
        return;
%endif
        DataProviderML::QoreTextNormalizeProcessor proc({
            "text_field": "body",
            "operations": ("strip_html", "collapse_whitespace", "lowercase"),
        });

        DataFrame::DataFrame df({
            "id": (1, 2),
            "body": ("<b>Hello</b>   WORLD", "Enterprise   AI"),
        });

        auto result = proc.processRecordsShape(df, DataProviderShape::DataFrameBlock);
        assertEq(DataProviderShape::DataFrameBlock, AbstractDataProcessor::detectShape(result),
            "text-normalize should preserve DataFrameBlock output");
        assertEq(2, AbstractDataProcessor::shapeRecordCount(result, DataProviderShape::DataFrameBlock));
        assertEq(("hello world", "enterprise ai"), result.getColumn("body_normalized"));
    }

    textNormalizeBufferColumnsShape() {
        DataProviderML::QoreTextNormalizeProcessor proc({
            "text_field": "body",
            "operations": ("strip_html", "collapse_whitespace", "lowercase"),
        });

        ColumnarResult columns = ColumnarResult::fromColumnHash({
            "id": new buffer<int64>((1, 2)),
            "body": ("<b>Hello</b>   WORLD", "Enterprise   AI"),
        });

        auto result = proc.processRecordsShape(columns, DataProviderShape::BufferColumns);
        assertEq(DataProviderShape::BufferColumns, AbstractDataProcessor::detectShape(result),
            "text-normalize should preserve BufferColumns output");
        assertEq(2, AbstractDataProcessor::shapeRecordCount(result, DataProviderShape::BufferColumns));
        assertEq(("hello world", "enterprise ai"), result.getColumn("body_normalized").toList());
    }

    # ===================== SchemaValidation Tests =====================

    schemaValidTypeCheck() {
        DataProviderML::QoreSchemaValidationProcessor proc({
            "schema": {
                "age": {"type": "int"},
                "name": {"type": "string"},
            },
            "on_violation": "enrich",
        });

        # valid record
        auto r1 = proc.processRecord({"age": 25, "name": "Alice"});
        assertTrue(r1._is_valid);
        assertEq(0, r1._validation_errors.lsize());

        # invalid type
        auto r2 = proc.processRecord({"age": "not a number", "name": "Bob"});
        assertFalse(r2._is_valid);
        assertTrue(r2._validation_errors.lsize() > 0);
        assertTrue(r2._validation_errors[0].find("expected type int") >= 0);
    }

    schemaValidRequiredFields() {
        DataProviderML::QoreSchemaValidationProcessor proc({
            "schema": {
                "name": {"type": "string", "required": True},
                "email": {"type": "string", "required": True},
            },
            "on_violation": "enrich",
        });

        # missing required field
        auto r1 = proc.processRecord({"name": "Alice"});
        assertFalse(r1._is_valid);
        assertTrue(r1._validation_errors.lsize() > 0);
        assertTrue(r1._validation_errors[0].find("required but missing") >= 0);

        # null required field
        auto r2 = proc.processRecord({"name": "Bob", "email": NOTHING});
        assertFalse(r2._is_valid);

        # all present
        auto r3 = proc.processRecord({"name": "Charlie", "email": "charlie@test.com"});
        assertTrue(r3._is_valid);
    }

    schemaValidRangeCheck() {
        DataProviderML::QoreSchemaValidationProcessor proc({
            "schema": {
                "score": {"type": "float", "min": 0.0, "max": 100.0},
            },
            "on_violation": "enrich",
        });

        # within range
        auto r1 = proc.processRecord({"score": 50.0});
        assertTrue(r1._is_valid);

        # below minimum
        auto r2 = proc.processRecord({"score": -5.0});
        assertFalse(r2._is_valid);
        assertTrue(r2._validation_errors[0].find("below minimum") >= 0);

        # above maximum
        auto r3 = proc.processRecord({"score": 150.0});
        assertFalse(r3._is_valid);
        assertTrue(r3._validation_errors[0].find("exceeds maximum") >= 0);
    }

    schemaValidAllowedValues() {
        DataProviderML::QoreSchemaValidationProcessor proc({
            "schema": {
                "status": {"type": "string", "allowed_values": ("active", "inactive", "pending")},
            },
            "on_violation": "enrich",
        });

        # allowed value
        auto r1 = proc.processRecord({"status": "active"});
        assertTrue(r1._is_valid);

        # disallowed value
        auto r2 = proc.processRecord({"status": "deleted"});
        assertFalse(r2._is_valid);
        assertTrue(r2._validation_errors[0].find("not in allowed values") >= 0);
    }

    schemaValidStringLength() {
        DataProviderML::QoreSchemaValidationProcessor proc({
            "schema": {
                "code": {"type": "string", "min_length": 2, "max_length": 5},
            },
            "on_violation": "enrich",
        });

        # valid length
        auto r1 = proc.processRecord({"code": "ABC"});
        assertTrue(r1._is_valid);

        # too short
        auto r2 = proc.processRecord({"code": "A"});
        assertFalse(r2._is_valid);
        assertTrue(r2._validation_errors[0].find("below minimum length") >= 0);

        # too long
        auto r3 = proc.processRecord({"code": "ABCDEF"});
        assertFalse(r3._is_valid);
        assertTrue(r3._validation_errors[0].find("exceeds maximum length") >= 0);
    }

    schemaValidEnrichMode() {
        DataProviderML::QoreSchemaValidationProcessor proc({
            "schema": {
                "value": {"type": "int", "required": True},
            },
            "on_violation": "enrich",
        });

        # valid record gets enriched with _is_valid=True
        auto r1 = proc.processRecord({"value": 42});
        assertTrue(r1._is_valid);
        assertTrue(r1.hasKey("_validation_errors"));
        assertEq(0, r1._validation_errors.lsize());
        assertEq(42, r1.value);

        # invalid record also passes through but with errors
        auto r2 = proc.processRecord({"value": "not an int"});
        assertFalse(r2._is_valid);
        assertTrue(r2._validation_errors.lsize() > 0);
        assertEq("not an int", r2.value);
    }

    schemaValidDropMode() {
        DataProviderML::QoreSchemaValidationProcessor proc({
            "schema": {
                "value": {"type": "int", "required": True},
            },
            "on_violation": "drop",
        });

        # valid record passes through
        auto r1 = proc.processRecord({"value": 42});
        assertTrue(exists r1);

        # invalid record is dropped (returns NOTHING)
        auto r2 = proc.processRecord({"value": "not an int"});
        assertFalse(exists r2);

        # missing required field is dropped
        auto r3 = proc.processRecord({});
        assertFalse(exists r3);
    }

    schemaValidThrowMode() {
        DataProviderML::QoreSchemaValidationProcessor proc({
            "schema": {
                "value": {"type": "int", "required": True},
            },
            "on_violation": "throw",
        });

        # valid record passes through without exception
        auto r1 = proc.processRecord({"value": 42});
        assertTrue(exists r1);

        # invalid record throws exception
        assertThrows("VALIDATION-ERROR", sub() {
            proc.processRecord({"value": "not an int"});
        });

        # missing required field throws exception
        assertThrows("VALIDATION-ERROR", sub() {
            proc.processRecord({});
        });
    }

    schemaValidDataFrameEnrichShape() {
%ifdef NoDataFrame
        testSkip("dataframe module not available");
        return;
%endif
        DataProviderML::QoreSchemaValidationProcessor proc({
            "schema": {
                "age": {"type": "int", "min": 18},
                "status": {"allowed_values": ("active", "pending")},
            },
            "on_violation": "enrich",
        });

        DataFrame::DataFrame df({
            "id": (1, 2),
            "age": (20, 15),
            "status": ("active", "blocked"),
        });

        auto result = proc.processRecordsShape(df, DataProviderShape::DataFrameBlock);
        assertEq(DataProviderShape::DataFrameBlock, AbstractDataProcessor::detectShape(result),
            "schema-validation enrich should preserve DataFrameBlock output");
        assertEq(2, AbstractDataProcessor::shapeRecordCount(result, DataProviderShape::DataFrameBlock));
        assertEq((True, False), result.getColumn("_is_valid"));

        list<auto> errors = result.getColumn("_validation_errors");
        assertEq(0, errors[0].lsize());
        assertTrue(errors[1].lsize() >= 2,
            "invalid row should include range and allowed-value violations");
    }

    schemaValidBufferColumnsDropShape() {
        DataProviderML::QoreSchemaValidationProcessor proc({
            "schema": {
                "age": {"type": "int", "min": 18},
                "status": {"allowed_values": ("active", "pending")},
            },
            "on_violation": "drop",
        });

        ColumnarResult columns = ColumnarResult::fromColumnHash({
            "id": new buffer<int64>((1, 2, 3)),
            "age": new buffer<int64>((20, 15, 30)),
            "status": ("active", "blocked", "pending"),
        });

        auto result = proc.processRecordsShape(columns, DataProviderShape::BufferColumns);
        assertEq(DataProviderShape::BufferColumns, AbstractDataProcessor::detectShape(result),
            "schema-validation drop should preserve BufferColumns output");
        assertEq(2, AbstractDataProcessor::shapeRecordCount(result, DataProviderShape::BufferColumns));
        assertEq((1, 3), result.getColumn("id").toList());
        assertEq(("active", "pending"), result.getColumn("status").toList());
    }

    schemaValidNotConfigured() {
        DataProviderML::QoreSchemaValidationProcessor proc();
        assertThrows("PROCESSOR-ERROR", sub() {
            proc.processRecord({"x": 1});
        });
    }

    schemaValidCapabilities() {
        DataProviderML::QoreSchemaValidationProcessor proc();
        assertEq(DPC_TRANSFORM, proc.getProcessorCapabilities());
        hash<DataProviderInfo> info = proc.getInfo();
        assertEq("QoreSchemaValidationProcessor", info{"type"});
        assertTrue(info.supports_pipeline_processor);
    }

    schemaValidConstructorValidation() {
        # missing required schema
        assertThrows("CONSTRUCTOR-ERROR", sub() {
            new DataProviderML::QoreSchemaValidationProcessor({
                "schema": {},
            });
        });
    }

    private assertFloat(float expected, auto actual, float tolerance) {
        float diff = abs(expected - actual.toFloat());
        assertTrue(diff < tolerance,
            sprintf("expected %f, got %f (diff=%f, tolerance=%f)", expected, actual, diff,
                tolerance));
    }
}
