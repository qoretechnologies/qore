            "description": "test ONNX package for true multi-input mapped inference",
            "execution_config": <ML::OnnxSessionConfig>{"providers": ()},
        });

        DataProviderML::QoreRegistryModelProcessor proc({
            "registry_path": dir,
            "model_name": "multi-input-onnx",
            "version": vid,
            "input_map": {"A": "a", "B": "b"},
            "window_size": 10,
            "output_mode": "columns",
        });

        DataFrame::DataFrame df({
            "a": new buffer<float32>((1.0, 2.0, 3.0)),
            "b": new buffer<float32>((0.5, 1.0, 1.5)),
        });
        auto result = proc.processRecordsShape(df, DataProviderShape::DataFrameBlock);
        assertEq(DataProviderShape::DataFrameBlock, AbstractDataProcessor::detectShape(result));
        assertEq(3, AbstractDataProcessor::shapeRecordCount(result, DataProviderShape::DataFrameBlock));
        assertEq(("Y",), result.columnNames());
        assertEq("buffer<float32>", result.getColumnBuffer("Y").fullType());

        list<auto> outputs = result.getColumn("Y");
        assertFloat(6.0, outputs[0], 1e-5);
        assertFloat(12.0, outputs[1], 1e-5);
        assertFloat(18.0, outputs[2], 1e-5);
%endif
    }

    registryModelOnnxInputMapRowOutput() {
        if (skipOnnx()) {
            return;
        }

        string dir = tmp_location() + DirSep + "reg_model_onnx_input_map_row_test_"
            + get_random_bytes(4).toHex();
        mkdir_ex(dir, 0755, True);
        on_exit {
            DataProviderMLProcessorsTest::cleanupDir(dir);
        }

        string package_dir = dir + DirSep + "linear_onnx";
        mkdir_ex(package_dir, 0755, True);
        File f();
        f.open(package_dir + DirSep + "model.onnx", O_CREAT | O_WRONLY | O_TRUNC, 0644);
        f.write(ReadOnlyFile::readBinaryFile(getTestModelPath()));

        QoreModelRegistry::ModelRegistry registry({"path": dir});
        string vid = registry.registerPackage(package_dir, {
            "name": "linear-onnx-input-map-row",
            "description": "test ONNX package for mapped row inference",
            "execution_config": <ML::OnnxSessionConfig>{"providers": ()},
        });

        DataProviderML::QoreRegistryModelProcessor proc({
            "registry_path": dir,
            "model_name": "linear-onnx-input-map-row",
            "version": vid,
            "input_map": {"X": "x"},
            "window_size": 3,
        });

        list<auto> results;
        for (int i = 0; i < 3; ++i) {
            DataProviderMLProcessorsTest::collectResult(\results,
                proc.processRecord({"x": (i + 1).toFloat()}));
        }

        assertEq(3, results.lsize());
        assertEq(1.0, results[0].record_values.x);
        assertFloat(3.0, results[0].prediction.Y, 1e-5);
        assertFloat(7.0, results[2].prediction.Y, 1e-5);
    }

    tokenizeRegistryTokenizer() {
