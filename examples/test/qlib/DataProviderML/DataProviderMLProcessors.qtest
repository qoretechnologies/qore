    registryModelOnnxDeviceBindingAdapter() {
        if (skipOnnx()) {
            return;
        }

        # Build a device-binding session (CPU output memory works without a real
        # accelerator) and wrap it in a registry adapter whose manifest enables
        # device binding.  The adapter must bind device outputs and surface
        # truthful host/device transfer diagnostics.
        ML::OnnxModel model(getTestModelPath(), <ML::OnnxSessionConfig>{
            "providers": (),
            "device_binding": <ML::OnnxDeviceBindingConfig>{
                "enabled": True,
                "default_output_device": "cpu",
            },
        });

        hash<QoreModelRegistry::ModelVersionInfo> manifest = <QoreModelRegistry::ModelVersionInfo>{
            "version_id": "v-device-1",
            "name": "linear-device",
            "algorithm": "onnx",
            "created": "2026-01-01T00:00:00Z",
            "file_size": 0,
            "format": "onnx",
            "runtime": "onnxruntime",
            "execution": <QoreModelRegistry::ModelExecutionInfo>{
                "runtime": "onnxruntime",
                "local_executable": True,
                "device_binding": {
                    "enabled": True,
                    "default_output_device": "cpu",
                },
            },
        };

        QoreModelRegistry::ModelExecutableAdapter adapter(model, manifest);
        assertTrue(adapter.isOnnx(), "adapter should report ONNX runtime");

        ML::Tensor input(((1.0,), (2.0,), (3.0,)), NOTHING, "float32");
        hash<auto> outputs = adapter.runTensors({"X": input});
        assertTrue(outputs.Y instanceof ML::Tensor, "device-binding adapter run should return a tensor output");

        hash<auto> diag = adapter.getProviderDiagnostics();
        assertTrue(diag.hasKey("device_binding"), "adapter diagnostics must include a device_binding block");
        assertTrue(diag.device_binding.enabled, "adapter must report device binding enabled from the manifest");
        assertEq(True, diag.device_binding.policy.enabled,
            "adapter should surface the manifest device-binding policy");
        assertTrue(diag.device_binding.transfers.host_outputs >= 1,
            "CPU device-binding adapter outputs should be host outputs");
        assertEq(0, diag.device_binding.transfers.device_outputs,
            "CPU output binding must not produce device outputs");
    }

