    # ===================== ONNX Model Tests =====================

    private string getTestModelPath() {
        string dir = get_script_dir();
        # Navigate from examples/test/qlib/DataProviderML/ to modules/ml/test/data/
        string path = dir + "/../../../../modules/ml/test/data/test_linear.onnx";
        if (!is_file(path)) {
            path = "modules/ml/test/data/test_linear.onnx";
        }
        return path;
    }

    private bool skipOnnx() {
        hash<ML::MLCapabilities> caps = ML::ml_get_capabilities();
        if (!caps.has_onnx) {
            testSkip("ONNX Runtime not available");
            return True;
        }
        string path = getTestModelPath();
        if (!is_file(path)) {
            testSkip("test ONNX model not found at: " + path);
            return True;
        }
        return False;
    }

    onnxModelBasicInference() {
        if (skipOnnx()) {
            return;
        }
        DataProviderML::QoreOnnxModelProcessor proc({
            "model_path": getTestModelPath(),
            "fields": "x",
            "window_size": 5,
        });

        # Test model: y = 2*x + 1
        list<hash<auto>> records = (
            {"x": 1.0},
            {"x": 2.0},
            {"x": 3.0},
            {"x": 4.0},
            {"x": 5.0},
        );

        list<auto> results;
        foreach hash<auto> rec in (records) {
            DataProviderMLProcessorsTest::collectResult(\results, proc.processRecord(rec));
        }

        # Window of 5 → should emit 5 results
        assertEq(5, results.lsize());

        # Check first result
        assertEq("onnx-model", results[0].event_type);
        assertTrue(results[0].hasKey("model_path"));
        assertTrue(results[0].hasKey("record_values"));
        assertTrue(results[0].hasKey("model_output"));
        assertEq(1.0, results[0].record_values.x);
        # y = 2*1 + 1 = 3.0
        assertTrue(results[0].model_output.hasKey("Y"));
        float y0 = results[0].model_output.Y;
        assertTrue(abs(3.0 - y0) < 0.01, sprintf("expected ~3.0, got %f", y0));

        # Check last result: y = 2*5 + 1 = 11.0
        float y4 = results[4].model_output.Y;
        assertTrue(abs(11.0 - y4) < 0.01, sprintf("expected ~11.0, got %f", y4));

        # Check middle values
        for (int i = 0; i < 5; ++i) {
            float expected = 2.0 * (i + 1).toFloat() + 1.0;
            float actual = results[i].model_output.Y;
            assertTrue(abs(expected - actual) < 0.01,
                sprintf("record %d: expected %f, got %f", i, expected, actual));
        }
    }

    onnxModelFlushPartial() {
        if (skipOnnx()) {
            return;
        }
        DataProviderML::QoreOnnxModelProcessor proc({
            "model_path": getTestModelPath(),
            "fields": "x",
            "window_size": 10,
        });

        # Add 3 records (less than window)
        list<auto> results;
        for (int i = 0; i < 3; ++i) {
            DataProviderMLProcessorsTest::collectResult(\results,
                proc.processRecord({"x": (i + 1).toFloat()}));
        }
        assertEq(0, results.lsize());

        # Flush should process remaining
        DataProviderMLProcessorsTest::collectResult(\results, proc.flushRecords());
        assertEq(3, results.lsize());
    }

    onnxModelCapabilities() {
        if (skipOnnx()) {
            return;
        }
        DataProviderML::QoreOnnxModelProcessor proc();
        assertEq(DPC_AGGREGATE, proc.getProcessorCapabilities());
        hash<DataProviderInfo> info = proc.getInfo();
        assertTrue(info.supports_pipeline_processor);
    }

    onnxModelConstructorValidation() {
        if (skipOnnx()) {
            return;
        }
        # Missing fields
        assertThrows("CONSTRUCTOR-ERROR", sub() {
            new DataProviderML::QoreOnnxModelProcessor({
                "model_path": getTestModelPath(),
                "fields": "",
                "window_size": 5,
            });
        });
        # Invalid window_size
        assertThrows("CONSTRUCTOR-ERROR", sub() {
            new DataProviderML::QoreOnnxModelProcessor({
                "model_path": getTestModelPath(),
                "fields": "x",
                "window_size": 0,
            });
        });
        # Non-existent model
        assertThrows("ML-ONNX-ERROR", sub() {
            new DataProviderML::QoreOnnxModelProcessor({
                "model_path": "/nonexistent/model.onnx",
                "fields": "x",
                "window_size": 5,
            });
        });
    }

    # ===================== StandardScaler Tests =====================

    stdScalerBasicWindow() {
        DataProviderML::QoreStandardScalerProcessor proc({
            "fields": "x,y",
            "window_size": 5,
        });

        list<auto> results;
        # Feed 5 records to fill the window
        list<hash<auto>> data = (
            {"x": 1.0, "y": 10.0},
            {"x": 2.0, "y": 20.0},
            {"x": 3.0, "y": 30.0},
            {"x": 4.0, "y": 40.0},
            {"x": 5.0, "y": 50.0},
        );
        foreach hash<auto> rec in (data) {
            collectResult(\results, proc.processRecord(rec));
        }
        # Should get 5 events when window is full
        assertEq(5, results.lsize());
        assertEq("standard-scaler", results[0].event_type);
        assertTrue(exists results[0].scaled_values);
        assertTrue(exists results[0].record_values);
        # Middle point (mean) should have scaled values near 0
        assertFloat(0.0, results[2].scaled_values.x, 0.01);
        assertFloat(0.0, results[2].scaled_values.y, 0.01);
    }

    stdScalerSubsequentWindows() {
        DataProviderML::QoreStandardScalerProcessor proc({
            "fields": "x",
            "window_size": 3,
        });

        # First window: fits the scaler
        list<auto> results;
        foreach hash<auto> rec in (({"x": 1.0}, {"x": 2.0}, {"x": 3.0})) {
            collectResult(\results, proc.processRecord(rec));
        }
        assertEq(3, results.lsize());

        # Second window: uses the already-fitted scaler
        list<auto> results2;
        foreach hash<auto> rec in (({"x": 1.0}, {"x": 2.0}, {"x": 3.0})) {
            collectResult(\results2, proc.processRecord(rec));
        }
        assertEq(3, results2.lsize());
        # Results should be same as first window (same data, same scaler)
        assertFloat(results[0].scaled_values.x, results2[0].scaled_values.x, 1e-10);
    }

    stdScalerCapabilities() {
        DataProviderML::QoreStandardScalerProcessor proc();
        hash<DataProviderInfo> info = proc.getInfo();
        assertEq("QoreStandardScalerProcessor", info.type);
        assertTrue(info.supports_pipeline_processor);
    }

    # ===================== MinMaxScaler Tests =====================

    mmScalerBasicWindow() {
        DataProviderML::QoreMinMaxScalerProcessor proc({
            "fields": "x",
            "window_size": 3,
        });

        list<auto> results;
        foreach hash<auto> rec in (({"x": 0.0}, {"x": 5.0}, {"x": 10.0})) {
            collectResult(\results, proc.processRecord(rec));
        }
        assertEq(3, results.lsize());
        assertEq("min-max-scaler", results[0].event_type);
        # min → 0.0, mid → 0.5, max → 1.0
        assertFloat(0.0, results[0].scaled_values.x, 1e-10);
        assertFloat(0.5, results[1].scaled_values.x, 1e-10);
        assertFloat(1.0, results[2].scaled_values.x, 1e-10);
    }

