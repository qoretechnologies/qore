    # ===================== LinearRegression Tests =====================

    lrBasicPrediction() {
        DataProviderML::QoreLinearRegressionProcessor proc({
            "fields": "x",
            "target_field": "y",
            "window_size": 5,
        });

        # y = 2*x + 1
        list<hash<auto>> data = (
            {"x": 1.0, "y": 3.0},
            {"x": 2.0, "y": 5.0},
            {"x": 3.0, "y": 7.0},
            {"x": 4.0, "y": 9.0},
            {"x": 5.0, "y": 11.0},
        );

        list<auto> results;
        foreach hash<auto> rec in (data) {
            *auto r = proc.processRecord(rec);
            DataProviderMLProcessorsTest::collectResult(\results, r);
        }

        assertEq(5, results.lsize());
        foreach auto event in (results) {
            assertEq("linear-regression", event.event_type);
            assertTrue(event.hasKey("prediction"));
            assertTrue(event.hasKey("actual"));
            assertTrue(event.hasKey("residual"));
            assertTrue(event.hasKey("r_squared"));
            assertTrue(event.hasKey("coefficients"));
            assertTrue(event.hasKey("intercept"));
            assertTrue(event.hasKey("record_values"));
            # R-squared should be very high for perfect linear data
            assertTrue(event.r_squared > 0.99,
                sprintf("R-squared should be > 0.99; got %f", event.r_squared));
        }
    }

