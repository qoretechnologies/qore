            new DataProviderML::QoreOnnxModelProcessor({
                "model_path": "/nonexistent/model.onnx",
                "fields": "x",
                "window_size": 5,
            });
        });
    }

    # ===================== StandardScaler Tests =====================

    stdScalerBasicWindow() {
        DataProviderML::QoreStandardScalerProcessor proc({
            "fields": "x,y",
            "window_size": 5,
        });

        list<auto> results;
        # Feed 5 records to fill the window
        list<hash<auto>> data = (
            {"x": 1.0, "y": 10.0},
            {"x": 2.0, "y": 20.0},
            {"x": 3.0, "y": 30.0},
            {"x": 4.0, "y": 40.0},
            {"x": 5.0, "y": 50.0},
        );
        foreach hash<auto> rec in (data) {
            collectResult(\results, proc.processRecord(rec));
        }
        # Should get 5 events when window is full
        assertEq(5, results.lsize());
        assertEq("standard-scaler", results[0].event_type);
        assertTrue(exists results[0].scaled_values);
        assertTrue(exists results[0].record_values);
        # Middle point (mean) should have scaled values near 0
        assertFloat(0.0, results[2].scaled_values.x, 0.01);
        assertFloat(0.0, results[2].scaled_values.y, 0.01);
    }

    stdScalerSubsequentWindows() {
        DataProviderML::QoreStandardScalerProcessor proc({
            "fields": "x",
            "window_size": 3,
        });

        # First window: fits the scaler
        list<auto> results;
        foreach hash<auto> rec in (({"x": 1.0}, {"x": 2.0}, {"x": 3.0})) {
            collectResult(\results, proc.processRecord(rec));
        }
        assertEq(3, results.lsize());

        # Second window: uses the already-fitted scaler
        list<auto> results2;
        foreach hash<auto> rec in (({"x": 1.0}, {"x": 2.0}, {"x": 3.0})) {
            collectResult(\results2, proc.processRecord(rec));
        }
        assertEq(3, results2.lsize());
        # Results should be same as first window (same data, same scaler)
        assertFloat(results[0].scaled_values.x, results2[0].scaled_values.x, 1e-10);
    }

    stdScalerCapabilities() {
        DataProviderML::QoreStandardScalerProcessor proc();
        hash<DataProviderInfo> info = proc.getInfo();
        assertEq("QoreStandardScalerProcessor", info.type);
        assertTrue(info.supports_pipeline_processor);
        assertTrue(proc.supportsBulkApi());
        assertTrue(proc.supportsInputShape(DataProviderShape::DataFrameBlock));
        assertTrue(proc.supportsInputShape(DataProviderShape::BufferColumns));
        assertTrue(proc.supportsOutputShape(DataProviderShape::DataFrameBlock));
        assertTrue(proc.supportsOutputShape(DataProviderShape::BufferColumns));
        assertTrue(proc.supportsOutputShape(DataProviderShape::HashOfLists));
    }

    stdScalerDataFrameShape() {
%ifdef NoDataFrame
        testSkip("dataframe module not available");
        return;
%endif
        DataProviderML::QoreStandardScalerProcessor proc({
            "fields": "x,y",
            "window_size": 3,
        });

        DataFrame::DataFrame df({
            "x": (1.0, 2.0, 3.0),
            "y": (10.0, 20.0, 30.0),
        });
        auto result = proc.processRecordsShape(df, DataProviderShape::DataFrameBlock);
        assertEq(DataProviderShape::DataFrameBlock, AbstractDataProcessor::detectShape(result));
        assertEq(3, AbstractDataProcessor::shapeRecordCount(result, DataProviderShape::DataFrameBlock));
        assertEq(("standard-scaler", "standard-scaler", "standard-scaler"), result.getColumn("event_type"));
        assertFloat(0.0, result.getColumn("scaled_values")[1].x, 0.01);
        assertFloat(0.0, result.getColumn("scaled_values")[1].y, 0.01);
    }

    stdScalerBufferColumnsShape() {
        DataProviderML::QoreStandardScalerProcessor proc({
            "fields": "x,y",
            "window_size": 3,
        });

        auto columns = ColumnarResult::fromColumnHash({
            "x": new buffer<float64>((1.0, 2.0, 3.0)),
            "y": new buffer<float64>((10.0, 20.0, 30.0)),
        });
        auto result = proc.processRecordsShape(columns, DataProviderShape::BufferColumns);
        assertEq(DataProviderShape::BufferColumns, AbstractDataProcessor::detectShape(result));
        assertEq(3, AbstractDataProcessor::shapeRecordCount(result, DataProviderShape::BufferColumns));
        assertEq((1.0, 2.0, 3.0), map $1.x, result.getColumn("record_values"));
        assertFloat(0.0, result.getColumn("scaled_values")[1].x, 0.01);
    }

    stdScalerBufferColumnsDataFrameInputFields() {
%ifdef NoDataFrame
        testSkip("dataframe module not available");
        return;
%endif
        DataProviderML::QoreStandardScalerProcessor proc({
            "fields": "x,y",
            "window_size": 3,
            "output_mode": "dataframe",
        });

        auto columns = ColumnarResult::fromColumnHash({
            "x": new buffer<float64>((1.0, 2.0, 3.0)),
            "y": new buffer<float64>((10.0, 20.0, 30.0)),
        });
        auto result = proc.processRecordsShape(columns, DataProviderShape::BufferColumns);
        assertEq(DataProviderShape::DataFrameBlock, AbstractDataProcessor::detectShape(result));
        assertEq((1.0, 2.0, 3.0), result.getColumn("x"));
        assertEq((10.0, 20.0, 30.0), result.getColumn("y"));
        assertTrue(result.columnNames().contains("scaled_x"));
        assertEq("buffer<float64>", result.getColumnBuffer("scaled_x").fullType());
    }

    stdScalerBufferColumnsFlushShape() {
        DataProviderML::QoreStandardScalerProcessor proc({
            "fields": "x,y",
            "window_size": 5,
        });

        auto columns = ColumnarResult::fromColumnHash({
            "x": new buffer<float64>((1.0, 2.0, 3.0)),
            "y": new buffer<float64>((10.0, 20.0, 30.0)),
        });
        assertNothing(proc.processRecordsShape(columns, DataProviderShape::BufferColumns));
        *list<auto> blocks = proc.flushAndCollect();
        assertEq(1, blocks.lsize());
        assertEq(DataProviderShape::BufferColumns, AbstractDataProcessor::detectShape(blocks[0]));
        assertEq(3, AbstractDataProcessor::shapeRecordCount(blocks[0], DataProviderShape::BufferColumns));
        assertEq(("standard-scaler", "standard-scaler", "standard-scaler"),
            blocks[0].getColumn("event_type").toList());
    }

    # ===================== MinMaxScaler Tests =====================

    mmScalerBasicWindow() {
        DataProviderML::QoreMinMaxScalerProcessor proc({
            "fields": "x",
            "window_size": 3,
        });

        list<auto> results;
        foreach hash<auto> rec in (({"x": 0.0}, {"x": 5.0}, {"x": 10.0})) {
            collectResult(\results, proc.processRecord(rec));
        }
        assertEq(3, results.lsize());
        assertEq("min-max-scaler", results[0].event_type);
        # min → 0.0, mid → 0.5, max → 1.0
        assertFloat(0.0, results[0].scaled_values.x, 1e-10);
        assertFloat(0.5, results[1].scaled_values.x, 1e-10);
        assertFloat(1.0, results[2].scaled_values.x, 1e-10);
    }

    mmScalerCustomRange() {
        DataProviderML::QoreMinMaxScalerProcessor proc({
            "fields": "x",
            "window_size": 3,
            "feature_min": -1.0,
            "feature_max": 1.0,
        });

        list<auto> results;
        foreach hash<auto> rec in (({"x": 0.0}, {"x": 5.0}, {"x": 10.0})) {
            collectResult(\results, proc.processRecord(rec));
        }
        assertEq(3, results.lsize());
        assertFloat(-1.0, results[0].scaled_values.x, 1e-10);
        assertFloat(0.0, results[1].scaled_values.x, 1e-10);
        assertFloat(1.0, results[2].scaled_values.x, 1e-10);
    }

    mmScalerCapabilities() {
        DataProviderML::QoreMinMaxScalerProcessor proc();
        hash<DataProviderInfo> info = proc.getInfo();
