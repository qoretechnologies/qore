    # ===================== Integration Tests =====================

    integrationFactory() {
        # check that the factory is registered
        DataProvider::AbstractDataProviderFactory factory =
            DataProvider::DataProvider::getFactory("ml-processors");
        assertTrue(exists factory);
        hash<DataProviderFactoryInfo> info = factory.getInfo();
        assertEq("ml-processors", info.name);
    }

    integrationNavigation() {
        DataProviderML::MLProcessorsDataProvider provider();
        *list<string> children = provider.getChildProviderNames();
        assertTrue(exists children);
        assertTrue(children.contains("isolation-forest"));
        assertTrue(children.contains("dbscan-clustering"));
        assertTrue(children.contains("kmeans-clustering"));
        assertTrue(children.contains("pca"));
        assertTrue(children.contains("holt-winters"));
        assertTrue(children.contains("seasonal-decomposition"));
        assertTrue(children.contains("linear-regression"));
        assertTrue(children.contains("lof"));
        assertTrue(children.contains("gmm"));
        assertTrue(children.contains("standard-scaler"));
        assertTrue(children.contains("min-max-scaler"));
        assertTrue(children.contains("imputer"));
        assertTrue(children.contains("classification-metrics"));
        assertTrue(children.contains("regression-metrics"));
        assertTrue(children.contains("clustering-metrics"));
        assertTrue(children.contains("logistic-regression"));
        assertTrue(children.contains("knn-classification"));
        assertTrue(children.contains("knn-regression"));

        hash<ML::MLCapabilities> caps = ML::ml_get_capabilities();
        int expected_count = 18;
        if (caps.has_onnx) {
            assertTrue(children.contains("onnx-model"));
            ++expected_count;
        }
        if (children.contains("registry-model")) {
            ++expected_count;
        }
        assertEq(expected_count, children.lsize());

        # check that each child can be retrieved
        foreach string name in (children) {
            *DataProvider::AbstractDataProvider child = provider.getChildProvider(name);
            assertTrue(exists child, sprintf("child '%s' should exist", name));
        }
    }

    integrationOutputTypes() {
        # verify each processor has an output type
        DataProviderML::QoreIsolationForestProcessor iforest({"fields": "x", "window_size": 10});
        assertTrue(exists iforest.getPipelineProcessorOutputType());

        DataProviderML::QoreDBSCANClusteringProcessor dbscan(
            {"fields": "x", "window_size": 10, "epsilon": 1.0});
        assertTrue(exists dbscan.getPipelineProcessorOutputType());

        DataProviderML::QoreKMeansProcessor kmeans(
            {"fields": "x", "window_size": 10, "k": 2});
        assertTrue(exists kmeans.getPipelineProcessorOutputType());

        DataProviderML::QorePCAProcessor pca({"fields": "x,y", "window_size": 10});
        assertTrue(exists pca.getPipelineProcessorOutputType());

        DataProviderML::QoreHoltWintersProcessor hw(
            {"fields": "x", "window_size": 100, "period": 4});
        assertTrue(exists hw.getPipelineProcessorOutputType());

        DataProviderML::QoreSeasonalDecompositionProcessor sd(
            {"fields": "x", "window_size": 24, "period": 4});
        assertTrue(exists sd.getPipelineProcessorOutputType());

        DataProviderML::QoreLinearRegressionProcessor lr(
            {"fields": "x", "target_field": "y", "window_size": 10});
        assertTrue(exists lr.getPipelineProcessorOutputType());

        DataProviderML::QoreLOFProcessor lof({"fields": "x,y", "window_size": 10, "k": 5});
        assertTrue(exists lof.getPipelineProcessorOutputType());

        DataProviderML::QoreGMMProcessor gmm(
            {"fields": "x", "window_size": 10, "n_components": 2});
        assertTrue(exists gmm.getPipelineProcessorOutputType());

        DataProviderML::QoreStandardScalerProcessor stdscaler(
            {"fields": "x,y", "window_size": 10});
        assertTrue(exists stdscaler.getPipelineProcessorOutputType());

        DataProviderML::QoreMinMaxScalerProcessor mmscaler(
            {"fields": "x,y", "window_size": 10});
        assertTrue(exists mmscaler.getPipelineProcessorOutputType());

        DataProviderML::QoreImputerProcessor imputer(
            {"fields": "x,y", "window_size": 10});
        assertTrue(exists imputer.getPipelineProcessorOutputType());

        DataProviderML::QoreClassificationMetricsProcessor clsm(
            {"predicted_field": "pred", "true_field": "actual", "window_size": 10});
        assertTrue(exists clsm.getPipelineProcessorOutputType());

        DataProviderML::QoreRegressionMetricsProcessor regm(
            {"predicted_field": "pred", "true_field": "actual", "window_size": 10});
        assertTrue(exists regm.getPipelineProcessorOutputType());

        DataProviderML::QoreClusteringMetricsProcessor clusm(
            {"fields": "x,y", "cluster_field": "c", "window_size": 10});
        assertTrue(exists clusm.getPipelineProcessorOutputType());

        if (ML::ml_get_capabilities().has_onnx) {
            DataProviderML::QoreOnnxModelProcessor onnx({
                "model_path": getTestModelPath(),
                "fields": "x",
                "window_size": 5,
            });
            assertTrue(exists onnx.getPipelineProcessorOutputType());
        }
    }

    private assertFloat(float expected, auto actual, float tolerance) {
        float diff = abs(expected - actual.toFloat());
        assertTrue(diff < tolerance,
            sprintf("expected %f, got %f (diff=%f, tolerance=%f)", expected, actual, diff,
                tolerance));
    }
}
