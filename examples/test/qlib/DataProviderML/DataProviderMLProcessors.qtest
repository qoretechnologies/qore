    embedTextDataFrameOnnxShape() {
%ifdef NoDataFrame
        testSkip("dataframe module not available");
        return;
%endif
        if (skipTokenEmbeddingOnnx()) {
            return;
        }

        DataProviderML::QoreEmbedTextProcessor proc({
            "text_field": "body",
            "window_size": 32,
            "embedding_mode": "onnx",
            "embedding_model_path": getTokenEmbeddingModelPath(),
            "tokenizer_config_path": getTokenizerConfigPath(),
            "onnx_session_config": <ML::OnnxSessionConfig>{"providers": ()},
            "max_tokens": 8,
        });

        DataFrame::DataFrame df({
            "id": (1, 2),
            "body": ("hello world", "enterprise ai"),
        });

        auto result = proc.processRecordsShape(df, DataProviderShape::DataFrameBlock);
        assertEq(DataProviderShape::DataFrameBlock, AbstractDataProcessor::detectShape(result),
            "embed-text should preserve DataFrameBlock output");
        assertEq(2, AbstractDataProcessor::shapeRecordCount(result, DataProviderShape::DataFrameBlock));
        assertEq((1, 2), result.getColumn("id"));

        list<auto> embeddings = result.getColumn("embedding");
        assertEq(2, embeddings.lsize());
        assertEq(2, embeddings[0].lsize());
        assertTrue(abs(sqrt(embeddings[0][0] * embeddings[0][0]
                + embeddings[0][1] * embeddings[0][1]) - 1.0) < 1e-5,
            "embedding vectors should be normalized");
    }

