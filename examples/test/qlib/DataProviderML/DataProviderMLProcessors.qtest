        ML::Tensor labels = result.label;
        assertEq((3,), labels.getShape());
        assertEq((0, 1, 2), labels.getBuffer().toList());

        ML::Tensor probabilities = result.probabilities;
        assertEq((3, 3), probabilities.getShape());
        assertEq("buffer<float32>", probabilities.getBuffer().fullType());
%endif
    }

