            new DataProviderML::QoreLOFProcessor({
                "fields": "x",
                "window_size": 10,
                "k": 20,
            });
        });
    }

    # ===================== GMM Tests =====================

    gmmBasicClustering() {
        DataProviderML::QoreGMMProcessor proc({
            "fields": "x,y",
            "window_size": 8,
            "n_components": 2,
        });

        # Two clusters
        list<hash<auto>> data = (
            {"x": 0.0, "y": 0.0},
            {"x": 0.1, "y": 0.1},
            {"x": 0.2, "y": 0.0},
            {"x": 0.0, "y": 0.2},
            {"x": 10.0, "y": 10.0},
            {"x": 10.1, "y": 10.1},
            {"x": 10.2, "y": 10.0},
            {"x": 10.0, "y": 10.2},
        );

        list<auto> results;
        foreach hash<auto> rec in (data) {
            *auto r = proc.processRecord(rec);
            DataProviderMLProcessorsTest::collectResult(\results, r);
        }

        assertEq(8, results.lsize());
        foreach auto event in (results) {
            assertEq("gmm", event.event_type);
            assertTrue(event.hasKey("cluster"));
            assertTrue(event.hasKey("max_probability"));
            assertTrue(event.hasKey("probabilities"));
            assertEq(2, event.probabilities.lsize());
            assertTrue(event.hasKey("record_values"));
        }

        # first 4 should be in one cluster, last 4 in another
        int c0 = results[0].cluster;
        int c1 = results[4].cluster;
        assertTrue(c0 != c1, "two groups should have different clusters");
    }

    gmmFlushPartial() {
        DataProviderML::QoreGMMProcessor proc({
            "fields": "x,y",
            "window_size": 20,
            "n_components": 2,
        });

        for (int i = 0; i < 5; ++i) {
            proc.processRecord({"x": i * 1.0, "y": i * 2.0});
        }

        *list<auto> flushed = proc.flushRecords();
        assertTrue(exists flushed);
        assertEq(5, flushed.lsize());
    }

    gmmCapabilities() {
        DataProviderML::QoreGMMProcessor proc();
        assertEq(DPC_AGGREGATE, proc.getProcessorCapabilities());
    }

    gmmConstructorValidation() {
        # missing required field
        assertThrows("CONSTRUCTOR-ERROR", sub() {
            new DataProviderML::QoreGMMProcessor({
                "fields": "x",
                "window_size": 10,
            });
        });
        # invalid n_components
        assertThrows("CONSTRUCTOR-ERROR", sub() {
            new DataProviderML::QoreGMMProcessor({
                "fields": "x",
                "window_size": 10,
                "n_components": 0,
            });
        });
        # invalid window_size
        assertThrows("CONSTRUCTOR-ERROR", sub() {
            new DataProviderML::QoreGMMProcessor({
                "fields": "x",
                "window_size": 1,
                "n_components": 2,
            });
        });
        # window_size < n_components
        assertThrows("CONSTRUCTOR-ERROR", "must be >= n_components", sub() {
            new DataProviderML::QoreGMMProcessor({
                "fields": "x",
                "window_size": 3,
                "n_components": 5,
            });
        });
    }

