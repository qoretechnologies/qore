        list<auto> p1 = result.getColumnBuffer("probabilities_1").toList();
        list<auto> p2 = result.getColumnBuffer("probabilities_2").toList();
        for (int i = 0; i < 3; ++i) {
            assertFloat(1.0, p0[i].toFloat() + p1[i].toFloat() + p2[i].toFloat(), 1e-5);
        }
