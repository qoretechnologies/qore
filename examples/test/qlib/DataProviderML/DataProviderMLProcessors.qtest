            "window_size": 3,
            "output_mode": "tensor",
        });

        DataFrame::DataFrame df({
            "sepal_length": new buffer<float32>((5.1, 7.0, 6.3)),
            "sepal_width": new buffer<float32>((3.5, 3.2, 3.3)),
