    registryModelOnnxSequenceClassificationPlanOutput() {
%ifdef NoDataFrame
        testSkip("dataframe module not available");
%else
        if (skipSklearnOnnx()) {
            return;
        }

        string dir = tmp_location() + DirSep + "reg_model_onnx_sequence_class_test_"
            + get_random_bytes(4).toHex();
        mkdir_ex(dir, 0755, True);
        on_exit {
            DataProviderMLProcessorsTest::cleanupDir(dir);
        }

        string package_dir = dir + DirSep + "sklearn_onnx";
        mkdir_ex(package_dir, 0755, True);
        File f();
        f.open(package_dir + DirSep + "model.onnx", O_CREAT | O_WRONLY | O_TRUNC, 0644);
        f.write(ReadOnlyFile::readBinaryFile(getSklearnModelPath()));

        QoreModelRegistry::ModelRegistry registry({"path": dir});
        string vid = registry.registerPackage(package_dir, {
            "name": "sklearn-onnx-sequence-class",
            "description": "test ONNX package with sequence classification execution plan",
            "task": "sequence-classification",
            "execution_plan": {
                "type": "onnx/sequence-classification",
            },
            "execution_config": <ML::OnnxSessionConfig>{"providers": ()},
        });

        DataProviderML::QoreRegistryModelProcessor proc({
            "registry_path": dir,
            "model_name": "sklearn-onnx-sequence-class",
            "version": vid,
            "fields": ("sepal_length", "sepal_width", "petal_length", "petal_width"),
            "window_size": 3,
        });

        list<auto> results;
        foreach hash<auto> rec in (
                {"sepal_length": 5.1, "sepal_width": 3.5, "petal_length": 1.4, "petal_width": 0.2},
                {"sepal_length": 7.0, "sepal_width": 3.2, "petal_length": 4.7, "petal_width": 1.4},
                {"sepal_length": 6.3, "sepal_width": 3.3, "petal_length": 6.0, "petal_width": 2.5}) {
            DataProviderMLProcessorsTest::collectResult(\results, proc.processRecord(rec));
        }

        assertEq(3, results.size(), "classification task should emit one event per record");
        assertEq("sequence-classification", results[0].prediction.task);
        assertEq("classification", results[0].prediction.kind);
        assertEq(0, results[0].prediction.label);
        assertTrue(results[0].prediction.hasKey("scores"));
        assertTrue(results[0].prediction.raw_outputs.hasKey("label"));
        assertTrue(results[0].prediction.raw_outputs.hasKey("probabilities"));
%endif
    }

    registryModelOnnxCausalLmPlanOutput() {
        if (skipOnnx()) {
            return;
        }

        string dir = tmp_location() + DirSep + "reg_model_onnx_causal_lm_test_"
            + get_random_bytes(4).toHex();
        mkdir_ex(dir, 0755, True);
        on_exit {
            DataProviderMLProcessorsTest::cleanupDir(dir);
        }

        string vid = DataProviderMLProcessorsTest::createCausalLmRegistryPackage(
            dir, "tiny-causal-lm");

        QoreModelRegistry::ModelRegistry registry({"path": dir});
        hash<QoreModelRegistry::ModelVersionInfo> manifest =
            registry.getVersionManifest("tiny-causal-lm", vid);
        assertEq("causal-lm", manifest.execution.task);
        assertEq("onnx/causal-lm", manifest.execution.plan.type);

        DataProviderML::QoreRegistryModelProcessor proc({
            "registry_path": dir,
            "model_name": "tiny-causal-lm",
            "version": vid,
            "window_size": 1,
        });

        list<auto> results;
        DataProviderMLProcessorsTest::collectResult(\results,
            proc.processRecord({"prompt": "hello world"}));

        assertEq(1, results.size(), "causal-lm task should emit one event per prompt");
        assertEq("causal-lm", results[0].prediction.task);
        assertEq("text-generation", results[0].prediction.kind);
        assertEq("hello world", results[0].prediction.prompt);
        assertEq((4, 4), results[0].prediction.generated_token_ids);
        assertEq(2, results[0].prediction.generated_token_count);
        assertEq("length", results[0].prediction.finish_reason);
        assertTrue(results[0].prediction.text.find("hello") >= 0,
            "generated text should decode token ID 4 through the registry tokenizer");
        assertTrue(results[0].prediction.kv_cache.supported,
            "causal-lm execution should support present-to-past KV-cache reuse when tensor names match");
        assertTrue(results[0].prediction.kv_cache.enabled,
            "causal-lm execution should enable KV-cache reuse when requested and supported");
        assertTrue(results[0].prediction.kv_cache.requested,
            "KV-cache execution plan metadata should be reported in the output");
        assertEq(("logits", "present.0"), results[0].prediction.kv_cache.selected_outputs,
            "causal-lm should request logits and present tensors when KV-cache reuse is enabled");
        assertEq("present.0", results[0].prediction.kv_cache.input_output_map{"past_key_values.0"},
            "KV-cache metadata should expose the past-input to present-output mapping");
        assertEq((1, 1, 8), results[0].prediction.last_outputs.logits.shape);
        assertEq((1, 1, 1, 2), results[0].prediction.last_outputs{"present.0"}.shape,
            "present cache outputs should be materialized for reuse on the next decode step");
    }

    registryModelOnnxCausalLmColumnOutput() {
        if (skipOnnx()) {
            return;
        }

        string dir = tmp_location() + DirSep + "reg_model_onnx_causal_lm_columns_test_"
            + get_random_bytes(4).toHex();
        mkdir_ex(dir, 0755, True);
        on_exit {
            DataProviderMLProcessorsTest::cleanupDir(dir);
        }

        string vid = DataProviderMLProcessorsTest::createCausalLmRegistryPackage(
            dir, "tiny-causal-lm-columns");

        DataProviderML::QoreRegistryModelProcessor proc({
            "registry_path": dir,
            "model_name": "tiny-causal-lm-columns",
            "version": vid,
            "window_size": 2,
            "output_mode": "columns",
            "include_input_fields": True,
        });

        ColumnarResult columns = ColumnarResult::fromColumnHash({
            "prompt": ("hello world", "enterprise ai"),
        });

        auto result = proc.processRecordsShape(columns, DataProviderShape::BufferColumns);
        assertEq(DataProviderShape::BufferColumns, AbstractDataProcessor::detectShape(result),
            "causal-lm compact output should preserve BufferColumns shape");
        assertEq(2, AbstractDataProcessor::shapeRecordCount(result, DataProviderShape::BufferColumns));
        assertEq(("hello world", "enterprise ai"), result.getColumn("prompt").toList());

        list<auto> texts = result.getColumn("generated_text").toList();
        assertEq(2, texts.lsize());
        foreach string text in (texts) {
            assertTrue(text.find("hello") >= 0,
                sprintf("generated compact text should decode token ID 4; got %y", text));
        }

        list<auto> token_ids = result.getColumn("generated_token_ids");
        assertEq((4, 4), token_ids[0]);
        assertEq((4, 4), token_ids[1]);
        assertEq((2, 2), result.getColumn("generated_token_count").toList());
        assertEq(("length", "length"), result.getColumn("finish_reason").toList());
        assertFalse(result.columnNames().contains("prediction"),
            "compact causal-lm output should not materialize per-row prediction hashes");
    }

