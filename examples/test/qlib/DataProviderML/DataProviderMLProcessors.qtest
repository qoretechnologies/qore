    rerankTextDataFrameOnnxShape() {
%ifdef NoDataFrame
        testSkip("dataframe module not available");
        return;
%endif
        if (skipTokenRerankerOnnx()) {
            return;
        }

        DataProviderML::QoreRerankerProcessor proc({
            "query_field": "query",
            "passage_field": "passage",
            "top_k": 2,
            "reranker_mode": "onnx",
            "reranker_model_path": getTokenRerankerModelPath(),
            "tokenizer_config_path": getTokenizerConfigPath(),
            "onnx_session_config": <ML::OnnxSessionConfig>{"providers": ()},
            "max_length": 24,
        });

        DataFrame::DataFrame df({
            "id": (1, 2, 3),
            "query": ("machine learning", "machine learning", "machine learning"),
            "passage": ("machine learning systems", "weather forecast", "enterprise ai search"),
        });

        auto result = proc.processRecordsShape(df, DataProviderShape::DataFrameBlock);
        assertEq(DataProviderShape::DataFrameBlock, AbstractDataProcessor::detectShape(result),
            "rerank-text should preserve DataFrameBlock output");
        assertEq(2, AbstractDataProcessor::shapeRecordCount(result, DataProviderShape::DataFrameBlock));
        assertEq((1, 2), result.getColumn("reranker_rank"));

        list<auto> scores = result.getColumn("reranker_score");
        assertEq(2, scores.lsize());
        foreach float score in (scores) {
            assertTrue(score > 0.0 && score <= 1.0,
                sprintf("reranker score should be in (0, 1]; got %f", score));
        }
        assertEq(2, result.getColumn("id").lsize());
        assertEq(2, result.getColumn("passage").lsize());
    }

