    #! Collects a processor result into a results list, handling both single and list returns
    static collectResult(reference<list<auto>> results, auto r) {
        if (exists r) {
            if (r.typeCode() == NT_LIST) {
                results += r;
            } else {
                push results, r;
            }
        }
    }

    static writeTextFile(string path, string data) {
        File f();
        f.open(path, O_CREAT | O_WRONLY | O_TRUNC, 0644);
        f.write(data);
    }

    static writeBinaryFile(string path, binary data) {
        File f();
        f.open(path, O_CREAT | O_WRONLY | O_TRUNC, 0644);
        f.write(data);
    }

    static cleanupDir(string dir) {
        if (!is_dir(dir)) {
            return;
        }
        Dir d();
        d.chdir(dir);
        foreach string subdir in (d.listDirs()) {
            DataProviderMLProcessorsTest::cleanupDir(dir + DirSep + subdir);
        }
        foreach string f in (d.listFiles()) {
            unlink(dir + DirSep + f);
        }
        rmdir(dir);
    }

    static string minimalTokenizerJson() {
        return "{\"model\":{\"type\":\"WordPiece\",\"vocab\":{\"[PAD]\":0,"
            "\"[UNK]\":1,\"[CLS]\":2,\"[SEP]\":3,\"hello\":4,\"world\":5,"
            "\"enterprise\":6,\"ai\":7},\"unk_token\":\"[UNK]\","
            "\"continuing_subword_prefix\":\"##\"},\"added_tokens\":["
            "{\"id\":0,\"content\":\"[PAD]\",\"special\":true},"
            "{\"id\":1,\"content\":\"[UNK]\",\"special\":true},"
            "{\"id\":2,\"content\":\"[CLS]\",\"special\":true},"
            "{\"id\":3,\"content\":\"[SEP]\",\"special\":true}],"
            "\"post_processor\":{\"type\":\"BertProcessing\",\"sep\":[\"[SEP]\",3],"
            "\"cls\":[\"[CLS]\",2]},\"decoder\":{\"type\":\"WordPiece\","
            "\"prefix\":\"##\",\"cleanup\":true}}";
    }

    static string createTokenizerRegistryPackage(string dir, string model_name) {
        string package_dir = dir + DirSep + model_name + "_pkg";
        mkdir_ex(package_dir, 0755, True);
        DataProviderMLProcessorsTest::writeTextFile(package_dir + DirSep + "tokenizer.json",
            DataProviderMLProcessorsTest::minimalTokenizerJson());
        DataProviderMLProcessorsTest::writeTextFile(package_dir + DirSep + "tokenizer_config.json",
            "{\"model_max_length\":128,\"chat_template\":\"{{ messages }}\"}");
        QoreModelRegistry::ModelRegistry registry({"path": dir});
        return registry.registerPackage(package_dir, {"name": model_name});
    }

    static string createTokenOnnxRegistryPackage(string dir, string model_name,
            string model_path, string task, *hash<auto> execution_plan) {
        string package_dir = dir + DirSep + model_name + "_pkg";
        mkdir_ex(package_dir, 0755, True);
        DataProviderMLProcessorsTest::writeBinaryFile(package_dir + DirSep + "model.onnx",
            ReadOnlyFile::readBinaryFile(model_path));
        DataProviderMLProcessorsTest::writeTextFile(package_dir + DirSep + "tokenizer.json",
            DataProviderMLProcessorsTest::minimalTokenizerJson());
        DataProviderMLProcessorsTest::writeTextFile(package_dir + DirSep + "tokenizer_config.json",
            "{\"model_max_length\":128}");
        QoreModelRegistry::ModelRegistry registry({"path": dir});
        hash<auto> options = {
            "name": model_name,
            "task": task,
            "execution_config": <ML::OnnxSessionConfig>{"providers": ()},
        };
        if (execution_plan) {
            options.execution_plan = execution_plan;
        }
        return registry.registerPackage(package_dir, options);
    }

    static hash<auto> makeDynamicInt64SequenceInput(string name) {
        return {
            "name": name,
            "type": {
                "tensor_type": {
                    "elem_type": QoreOnnxExport::ONNX_INT64,
                    "shape": {
                        "dim": (
                            {"dim_value": 1},
                            {"dim_param": "S"},
                        ),
                    },
                },
            },
        };
    }

    static hash<auto> makeDynamicFloatCacheInput(string name) {
        return {
            "name": name,
            "type": {
                "tensor_type": {
                    "elem_type": QoreOnnxExport::ONNX_FLOAT,
                    "shape": {
                        "dim": (
                            {"dim_value": 1},
                            {"dim_value": 1},
                            {"dim_param": "past_sequence_length"},
                            {"dim_value": 2},
                        ),
                    },
                },
            },
        };
    }

    static hash<auto> makeStaticFloatTensorOutput(string name, list<softint> dims) {
        list<hash<auto>> shape_dims;
        foreach int dim in (dims) {
            push shape_dims, {"dim_value": dim};
        }
        return {
            "name": name,
            "type": {
                "tensor_type": {
                    "elem_type": QoreOnnxExport::ONNX_FLOAT,
                    "shape": {
                        "dim": shape_dims,
                    },
                },
            },
        };
    }

    static binary makeTinyCausalLmOnnx() {
        # The highest logit is token ID 4 ("hello" in minimalTokenizerJson()).
        hash<auto> logits = QoreOnnxExport::OnnxGraphBuilder::makeTensorFloat(
            "constant_logits", (1, 1, 8), (0.0, 0.1, 0.2, 0.3, 9.0, 0.4, 0.5, 0.6));
        hash<auto> unused_cache = QoreOnnxExport::OnnxGraphBuilder::makeTensorFloat(
            "constant_present", (1, 1, 1, 2), (1.0, 2.0));
        list<hash<auto>> logits_attrs = ({
            "name": "value",
            "type": QoreOnnxExport::ONNX_ATTR_TENSOR,
            "t": logits,
        },);
        list<hash<auto>> cache_attrs = ({
            "name": "value",
            "type": QoreOnnxExport::ONNX_ATTR_TENSOR,
            "t": unused_cache,
        },);
        hash<auto> model_hash = QoreOnnxExport::OnnxGraphBuilder::buildModel(
            "tiny-causal-lm",
            (QoreOnnxExport::OnnxGraphBuilder::makeNode("Constant", (), ("logits",), logits_attrs),
                QoreOnnxExport::OnnxGraphBuilder::makeNode("Constant", (), ("present.0",), cache_attrs)),
            (DataProviderMLProcessorsTest::makeDynamicInt64SequenceInput("input_ids"),
                DataProviderMLProcessorsTest::makeDynamicInt64SequenceInput("attention_mask"),
                DataProviderMLProcessorsTest::makeDynamicFloatCacheInput("past_key_values.0")),
            (DataProviderMLProcessorsTest::makeStaticFloatTensorOutput("logits", (1, 1, 8)),
                DataProviderMLProcessorsTest::makeStaticFloatTensorOutput("present.0", (1, 1, 1, 2))),
            ());
        return QoreOnnxExport::OnnxGraphBuilder::serialize(model_hash);
    }

    static string createCausalLmRegistryPackage(string dir, string model_name) {
        string package_dir = dir + DirSep + model_name + "_pkg";
        mkdir_ex(package_dir, 0755, True);
        DataProviderMLProcessorsTest::writeBinaryFile(package_dir + DirSep + "model.onnx",
            DataProviderMLProcessorsTest::makeTinyCausalLmOnnx());
        DataProviderMLProcessorsTest::writeTextFile(package_dir + DirSep + "tokenizer.json",
            DataProviderMLProcessorsTest::minimalTokenizerJson());
        DataProviderMLProcessorsTest::writeTextFile(package_dir + DirSep + "tokenizer_config.json",
            "{\"model_max_length\":128}");
        QoreModelRegistry::ModelRegistry registry({"path": dir});
        return registry.registerPackage(package_dir, {
            "name": model_name,
            "task": "causal-lm",
            "execution_plan": {
                "type": "onnx/causal-lm",
                "prompt_field": "prompt",
                "input_ids_name": "input_ids",
                "attention_mask_name": "attention_mask",
                "logits_output_name": "logits",
                "max_new_tokens": 2,
                "stop_token_ids": (3,),
                "kv_cache": {
                    "enabled": True,
                    "past_key_prefix": "past_key_values",
                },
            },
            "execution_config": <ML::OnnxSessionConfig>{"providers": ()},
        });
    }

    # ===================== IsolationForest Tests =====================

    iforestBasicWindow() {
        DataProviderML::QoreIsolationForestProcessor proc({
            "fields": "x,y",
            "window_size": 10,
            "n_trees": 50,
            "sample_size": 8,
            "threshold": 0.5,
        });

        # send 10 records (fills window)
        list<auto> results;
        for (int i = 0; i < 10; ++i) {
            *auto r = proc.processRecord({"x": i * 1.0, "y": i * 2.0});
            DataProviderMLProcessorsTest::collectResult(\results, r);
        }

        # should emit 10 events when window fills
        assertEq(10, results.lsize());
        foreach auto event in (results) {
            assertEq("isolation-forest", event.event_type);
            assertTrue(event.anomaly_score >= 0.0);
            assertTrue(event.anomaly_score <= 1.0);
            assertTrue(event.hasKey("is_anomaly"));
            assertTrue(event.hasKey("average_path_length"));
            assertTrue(event.hasKey("record_values"));
        }
    }

    iforestAnomalyDetection() {
        DataProviderML::QoreIsolationForestProcessor proc({
            "fields": "x,y",
            "window_size": 20,
            "n_trees": 100,
            "sample_size": 16,
            "threshold": 0.6,
        });

        # fill a window with mostly normal data and one outlier
        list<auto> results;
        for (int i = 0; i < 19; ++i) {
            *auto r = proc.processRecord({"x": 5.0 + (i % 5) * 0.1, "y": 5.0 + (i % 5) * 0.1});
            DataProviderMLProcessorsTest::collectResult(\results, r);
        }
        # 20th record is an outlier
        *auto r = proc.processRecord({"x": 100.0, "y": 100.0});
        DataProviderMLProcessorsTest::collectResult(\results, r);

        assertEq(20, results.lsize());

        # the outlier (last record) should have a higher anomaly score than normal records
        float outlier_score = results[19].anomaly_score;
        float normal_score = results[0].anomaly_score;
        assertTrue(outlier_score > normal_score,
            sprintf("outlier score (%f) should be > normal score (%f)",
                outlier_score, normal_score));
    }

    iforestFlushPartial() {
        DataProviderML::QoreIsolationForestProcessor proc({
            "fields": "x,y",
            "window_size": 20,
            "n_trees": 10,
        });

        # send 5 records (less than window)
        for (int i = 0; i < 5; ++i) {
            proc.processRecord({"x": i * 1.0, "y": i * 2.0});
        }

        # flush should emit events for the 5 buffered records
        *list<auto> flushed = proc.flushRecords();
        assertTrue(exists flushed);
        assertEq(5, flushed.lsize());
    }

    iforestDataFrameFlushShape() {
%ifdef NoDataFrame
        testSkip("dataframe module not available");
        return;
%endif
        DataProviderML::QoreIsolationForestProcessor proc({
            "fields": "x,y",
            "window_size": 10,
            "n_trees": 10,
            "sample_size": 3,
        });

        DataFrame::DataFrame df({
            "x": (0.0, 1.0, 2.0),
            "y": (0.0, 1.0, 2.0),
        });
        assertNothing(proc.processRecordsShape(df, DataProviderShape::DataFrameBlock));
        *list<auto> blocks = proc.flushAndCollect();
        assertEq(1, blocks.lsize());
        assertEq(DataProviderShape::DataFrameBlock, AbstractDataProcessor::detectShape(blocks[0]));
        assertEq(3, AbstractDataProcessor::shapeRecordCount(blocks[0], DataProviderShape::DataFrameBlock));
        assertEq(("isolation-forest", "isolation-forest", "isolation-forest"),
            blocks[0].getColumn("event_type"));
    }

    iforestNotConfigured() {
        DataProviderML::QoreIsolationForestProcessor proc();
        assertThrows("PROCESSOR-ERROR", sub() {
            proc.processRecord({"x": 1.0});
        });
    }

    iforestCapabilities() {
        DataProviderML::QoreIsolationForestProcessor proc();
        assertEq(DPC_AGGREGATE, proc.getProcessorCapabilities());
        hash<DataProviderInfo> info = proc.getInfo();
        assertEq("QoreIsolationForestProcessor", info{"type"});
        assertTrue(info.supports_pipeline_processor);
    }

    iforestConstructorValidation() {
        # missing required field
        assertThrows("CONSTRUCTOR-ERROR", sub() {
            new DataProviderML::QoreIsolationForestProcessor({
                "fields": "x",
            });
        });
        # invalid window_size
        assertThrows("CONSTRUCTOR-ERROR", sub() {
            new DataProviderML::QoreIsolationForestProcessor({
                "fields": "x",
                "window_size": 1,
            });
        });
        # empty fields
        assertThrows("CONSTRUCTOR-ERROR", sub() {
            new DataProviderML::QoreIsolationForestProcessor({
                "fields": " , ",
                "window_size": 10,
            });
        });
    }

    # ===================== DBSCAN Tests =====================

    dbscanBasicClustering() {
        DataProviderML::QoreDBSCANClusteringProcessor proc({
            "fields": "x,y",
            "window_size": 8,
            "epsilon": 2.0,
            "min_points": 2,
        });

        # Two clusters: around (0,0) and (10,10)
        list<hash<auto>> data = (
            {"x": 0.0, "y": 0.0},
            {"x": 0.5, "y": 0.5},
            {"x": 0.3, "y": -0.2},
            {"x": -0.4, "y": 0.3},
            {"x": 10.0, "y": 10.0},
            {"x": 10.5, "y": 10.5},
            {"x": 10.2, "y": 9.8},
            {"x": 9.7, "y": 10.3},
        );

        list<auto> results;
        foreach hash<auto> rec in (data) {
            *auto r = proc.processRecord(rec);
            DataProviderMLProcessorsTest::collectResult(\results, r);
        }

        assertEq(8, results.lsize());

        # first 4 should be in one cluster
        int c0 = results[0].cluster;
        assertEq(c0, results[1].cluster);
        assertEq(c0, results[2].cluster);
        assertEq(c0, results[3].cluster);

        # last 4 should be in another cluster
        int c1 = results[4].cluster;
        assertEq(c1, results[5].cluster);
        assertEq(c1, results[6].cluster);
        assertEq(c1, results[7].cluster);

        assertTrue(c0 != c1, "clusters should have different labels");

        foreach auto event in (results) {
            assertEq("dbscan-clustering", event.event_type);
            assertTrue(event.hasKey("is_core"));
            assertTrue(event.hasKey("neighbor_count"));
            assertTrue(event.hasKey("record_values"));
        }
    }

    dbscanNoiseDetection() {
        DataProviderML::QoreDBSCANClusteringProcessor proc({
            "fields": "x,y",
            "window_size": 5,
            "epsilon": 1.0,
            "min_points": 3,
        });

        # 4 dense points + 1 isolated
        list<hash<auto>> data = (
            {"x": 0.0, "y": 0.0},
            {"x": 0.3, "y": 0.3},
            {"x": 0.1, "y": 0.5},
            {"x": -0.2, "y": 0.4},
            {"x": 100.0, "y": 100.0},
        );

        list<auto> results;
        foreach hash<auto> rec in (data) {
            *auto r = proc.processRecord(rec);
            DataProviderMLProcessorsTest::collectResult(\results, r);
        }

        assertEq(5, results.lsize());
        assertTrue(results[0].cluster >= 0, "dense points should be in a cluster");
        assertEq(-1, results[4].cluster, "isolated point should be noise");
    }

