    embedTextDataFrameOnnxColumnOutput() {
%ifdef NoDataFrame
        testSkip("dataframe module not available");
        return;
%endif
        if (skipTokenEmbeddingOnnx()) {
            return;
        }

        DataProviderML::QoreEmbedTextProcessor proc({
            "text_field": "body",
            "window_size": 32,
            "embedding_mode": "onnx",
            "embedding_model_path": getTokenEmbeddingModelPath(),
            "tokenizer_config_path": getTokenizerConfigPath(),
            "onnx_session_config": <ML::OnnxSessionConfig>{"providers": ()},
            "max_tokens": 8,
            "output_mode": "columns",
        });

        DataFrame::DataFrame df({
            "id": (1, 2),
            "body": ("hello world", "enterprise ai"),
        });

        auto result = proc.processRecordsShape(df, DataProviderShape::DataFrameBlock);
        assertEq(DataProviderShape::DataFrameBlock, AbstractDataProcessor::detectShape(result),
            "embed-text dense columns should preserve DataFrameBlock output");
        assertTrue(result.columnNames().contains("embedding_0"));
        assertTrue(result.columnNames().contains("embedding_1"));
        assertFalse(result.columnNames().contains("embedding"),
            "dense column output should not also materialize nested vector column");
        assertEq("buffer<float32>", result.getColumnBuffer("embedding_0").fullType());
        assertEq("buffer<float32>", result.getColumnBuffer("embedding_1").fullType());

        list<float> c0 = result.getColumnBuffer("embedding_0").toList();
        list<float> c1 = result.getColumnBuffer("embedding_1").toList();
        assertEq(2, c0.lsize());
        assertTrue(abs(sqrt(c0[0] * c0[0] + c1[0] * c1[0]) - 1.0) < 1e-5,
            "flat embedding columns should be normalized");
    }

