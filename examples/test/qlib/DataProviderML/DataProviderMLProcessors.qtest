            "token count should be produced from registry tokenizer artifact");
    }

    tokenizeDataFrameShape() {
%ifdef NoDataFrame
        testSkip("dataframe module not available");
        return;
%endif
        if (skipTokenizerFixture()) {
            return;
        }

        DataProviderML::QoreTokenizeProcessor proc({
            "text_field": "body",
            "tokenizer_config_path": getTokenizerConfigPath(),
            "add_special_tokens": False,
        });

        DataFrame::DataFrame df({
            "id": (1, 2),
            "body": ("hello world", "enterprise ai"),
        });

        auto result = proc.processRecordsShape(df, DataProviderShape::DataFrameBlock);
        assertEq(DataProviderShape::DataFrameBlock, AbstractDataProcessor::detectShape(result),
            "tokenize should preserve DataFrameBlock output");
        assertEq(2, AbstractDataProcessor::shapeRecordCount(result, DataProviderShape::DataFrameBlock));
        assertEq((1, 2), result.getColumn("id"));

        list<int> counts = result.getColumn("body_token_count");
        assertEq(2, counts.lsize());
        foreach int count in (counts) {
            assertTrue(count > 0, "token count should be positive for non-empty text");
        }
    }

