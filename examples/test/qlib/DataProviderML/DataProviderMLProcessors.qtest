        assertEq((3,), metrics.sample_count);
    }

    clusterMetricsBasic() {
        DataProviderML::QoreClusteringMetricsProcessor proc({
            "fields": "x,y",
            "cluster_field": "cluster",
            "window_size": 6,
        });

        list<auto> results;
        list<hash<auto>> data = (
            {"x": 0.0, "y": 0.0, "cluster": 0},
            {"x": 0.1, "y": 0.0, "cluster": 0},
            {"x": 0.0, "y": 0.1, "cluster": 0},
            {"x": 10.0, "y": 10.0, "cluster": 1},
            {"x": 10.1, "y": 10.0, "cluster": 1},
            {"x": 10.0, "y": 10.1, "cluster": 1},
        );
        foreach hash<auto> rec in (data) {
            collectResult(\results, proc.processRecord(rec));
        }
        assertEq(1, results.size());
        assertEq("clustering-metrics", results[0].event_type);
        assertTrue(results[0].silhouette_score > 0.9);
        assertEq(2, results[0].n_clusters);
        assertEq(6, results[0].sample_count);
    }

    clusterMetricsBufferColumnsShape() {
        DataProviderML::QoreClusteringMetricsProcessor proc({
            "fields": "x,y",
            "cluster_field": "cluster",
            "window_size": 6,
        });

        ColumnarResult columns = ColumnarResult::fromColumnHash({
            "x": new buffer<float64>((0.0, 0.1, 0.0, 10.0, 10.1, 10.0)),
            "y": new buffer<float64>((0.0, 0.0, 0.1, 10.0, 10.0, 10.1)),
            "cluster": new buffer<int64>((0, 0, 0, 1, 1, 1)),
        });

        auto result = proc.processRecordsShape(columns, DataProviderShape::BufferColumns);
        assertEq(DataProviderShape::BufferColumns, AbstractDataProcessor::detectShape(result));
        assertEq(1, AbstractDataProcessor::shapeRecordCount(result, DataProviderShape::BufferColumns));

        hash<auto> metrics = AbstractDataProcessor::convertShape(
            result, DataProviderShape::BufferColumns, DataProviderShape::HashOfLists)[0];
        assertEq(("clustering-metrics",), metrics.event_type);
        assertTrue(metrics.silhouette_score[0] > 0.9);
        assertEq((2,), metrics.n_clusters);
        assertEq((6,), metrics.sample_count);
    }

    # ===================== RollingStats Tests =====================

    rollingStatsBasicEnrichment() {
        DataProviderML::QoreRollingStatsProcessor proc({
            "fields": "temperature",
            "window_size": 3,
            "statistics": ("mean", "min", "max"),
        });

        list<auto> results;
        # record 1: window = [10.0]
        *auto r = proc.processRecord({"temperature": 10.0, "label": "a"});
        assertEq(True, exists r);
        push results, r;

        # record 2: window = [10.0, 20.0]
        r = proc.processRecord({"temperature": 20.0, "label": "b"});
        assertEq(True, exists r);
        push results, r;

        # record 3: window = [10.0, 20.0, 30.0]
        r = proc.processRecord({"temperature": 30.0, "label": "c"});
        assertEq(True, exists r);
        push results, r;

        # verify original fields are preserved
        assertEq("a", results[0].label);
        assertEq("b", results[1].label);
        assertEq("c", results[2].label);
        assertEq(10.0, results[0].temperature);
        assertEq(20.0, results[1].temperature);
        assertEq(30.0, results[2].temperature);

        # verify computed stats
        # record 1: window = [10] -> mean=10, min=10, max=10
        assertFloat(10.0, results[0].temperature_mean, 0.001);
        assertFloat(10.0, results[0].temperature_min, 0.001);
        assertFloat(10.0, results[0].temperature_max, 0.001);

        # record 2: window = [10, 20] -> mean=15, min=10, max=20
        assertFloat(15.0, results[1].temperature_mean, 0.001);
        assertFloat(10.0, results[1].temperature_min, 0.001);
        assertFloat(20.0, results[1].temperature_max, 0.001);

        # record 3: window = [10, 20, 30] -> mean=20, min=10, max=30
        assertFloat(20.0, results[2].temperature_mean, 0.001);
        assertFloat(10.0, results[2].temperature_min, 0.001);
        assertFloat(30.0, results[2].temperature_max, 0.001);
    }

    rollingStatsAllStatistics() {
        DataProviderML::QoreRollingStatsProcessor proc({
            "fields": "x",
            "window_size": 3,
            "statistics": ("mean", "std", "min", "max", "sum"),
        });

        # fill window: [2.0, 4.0, 6.0]
        proc.processRecord({"x": 2.0});
        proc.processRecord({"x": 4.0});
        hash<auto> r = proc.processRecord({"x": 6.0});

        # mean = (2+4+6)/3 = 4.0
        assertFloat(4.0, r.x_mean, 0.001);
        # std = sqrt(((2-4)^2 + (4-4)^2 + (6-4)^2) / 3) = sqrt(8/3) ~ 1.633
        assertFloat(1.633, r.x_std, 0.01);
        # min = 2.0
        assertFloat(2.0, r.x_min, 0.001);
        # max = 6.0
        assertFloat(6.0, r.x_max, 0.001);
        # sum = 12.0
        assertFloat(12.0, r.x_sum, 0.001);
    }

    rollingStatsWindowSliding() {
        DataProviderML::QoreRollingStatsProcessor proc({
            "fields": "val",
            "window_size": 3,
            "statistics": ("mean",),
        });

        # fill window: [10]
        hash<auto> r1 = proc.processRecord({"val": 10.0});
        assertFloat(10.0, r1.val_mean, 0.001);

        # window: [10, 20]
        hash<auto> r2 = proc.processRecord({"val": 20.0});
        assertFloat(15.0, r2.val_mean, 0.001);

        # window: [10, 20, 30]
        hash<auto> r3 = proc.processRecord({"val": 30.0});
        assertFloat(20.0, r3.val_mean, 0.001);

        # window slides: [20, 30, 40] (10 dropped)
        hash<auto> r4 = proc.processRecord({"val": 40.0});
        assertFloat(30.0, r4.val_mean, 0.001);

        # window slides: [30, 40, 50] (20 dropped)
        hash<auto> r5 = proc.processRecord({"val": 50.0});
        assertFloat(40.0, r5.val_mean, 0.001);
    }

    rollingStatsDefaultStatistics() {
        # when no statistics option is given, defaults to mean
        DataProviderML::QoreRollingStatsProcessor proc({
            "fields": "x",
            "window_size": 2,
        });

        proc.processRecord({"x": 10.0});
        hash<auto> r = proc.processRecord({"x": 20.0});

        # should have x_mean but not x_std, x_min, x_max, x_sum
        assertTrue(r.hasKey("x_mean"));
        assertFloat(15.0, r.x_mean, 0.001);
        assertFalse(r.hasKey("x_std"));
        assertFalse(r.hasKey("x_min"));
        assertFalse(r.hasKey("x_max"));
        assertFalse(r.hasKey("x_sum"));
    }

    rollingStatsBufferColumnsShape() {
        DataProviderML::QoreRollingStatsProcessor proc({
            "fields": "temperature",
            "window_size": 2,
            "statistics": ("mean", "std", "min", "max", "sum"),
        });

        auto columns = ColumnarResult::fromColumnHash({
            "temperature": new buffer<float64>((10.0, 20.0, 30.0)),
            "label": ("a", "b", "c"),
        });
        auto result = proc.processRecordsShape(columns, DataProviderShape::BufferColumns);
        assertEq(DataProviderShape::BufferColumns, AbstractDataProcessor::detectShape(result));
        assertEq(3, AbstractDataProcessor::shapeRecordCount(result, DataProviderShape::BufferColumns));
        assertEq(("a", "b", "c"), result.getColumn("label").toList());
        assertEq((10.0, 20.0, 30.0), result.getColumn("temperature").toList());
        assertEq("buffer<float64>", result.getColumn("temperature_mean").fullType());
        assertEq("buffer<float64>", result.getColumn("temperature_std").fullType());

        assertFloat(10.0, result.getColumn("temperature_mean")[0], 0.001);
        assertFloat(15.0, result.getColumn("temperature_mean")[1], 0.001);
        assertFloat(25.0, result.getColumn("temperature_mean")[2], 0.001);
        assertFloat(0.0, result.getColumn("temperature_std")[0], 0.001);
        assertFloat(5.0, result.getColumn("temperature_std")[1], 0.001);
        assertFloat(5.0, result.getColumn("temperature_std")[2], 0.001);
        assertFloat(20.0, result.getColumn("temperature_min")[2], 0.001);
        assertFloat(30.0, result.getColumn("temperature_max")[2], 0.001);
        assertFloat(50.0, result.getColumn("temperature_sum")[2], 0.001);

        auto next = ColumnarResult::fromColumnHash({
            "temperature": new buffer<float64>((40.0,)),
            "label": ("d",),
        });
        auto next_result = proc.processRecordsShape(next, DataProviderShape::BufferColumns);
        assertEq(DataProviderShape::BufferColumns, AbstractDataProcessor::detectShape(next_result));
        assertFloat(35.0, next_result.getColumn("temperature_mean")[0], 0.001);
        assertFloat(70.0, next_result.getColumn("temperature_sum")[0], 0.001);
    }

    rollingStatsNotConfigured() {
        DataProviderML::QoreRollingStatsProcessor proc();
        assertThrows("PROCESSOR-ERROR", \proc.processRecord(), {"x": 1.0});
    }

    rollingStatsCapabilities() {
        DataProviderML::QoreRollingStatsProcessor proc();
        hash<DataProvider::DataProviderInfo> info = proc.getInfo();
        assertEq("QoreRollingStatsProcessor", info.type);
        assertEq(DPC_TRANSFORM, info.processor_capabilities);
        assertEq(True, info.supports_pipeline_processor);
    }

    rollingStatsConstructorValidation() {
        # missing fields
        assertThrows("CONSTRUCTOR-ERROR", sub () {
            new DataProviderML::QoreRollingStatsProcessor({"window_size": 5});
        });

        # missing window_size
        assertThrows("CONSTRUCTOR-ERROR", sub () {
            new DataProviderML::QoreRollingStatsProcessor({"fields": "x"});
        });

        # window_size < 1
        assertThrows("CONSTRUCTOR-ERROR", sub () {
            new DataProviderML::QoreRollingStatsProcessor({
                "fields": "x",
                "window_size": 0,
            });
        });

        # empty fields
        assertThrows("CONSTRUCTOR-ERROR", sub () {
            new DataProviderML::QoreRollingStatsProcessor({
                "fields": "",
                "window_size": 5,
            });
        });
    }

    # ===================== EWMA Tests =====================

    ewmaBasicSmoothing() {
        DataProviderML::QoreEWMAProcessor proc({
            "fields": "temperature",
            "alpha": 0.5,
        });

        # record 1: ewma = 10.0 (initialized to first value)
        hash<auto> r1 = proc.processRecord({"temperature": 10.0, "label": "a"});
        assertEq("a", r1.label);
        assertEq(10.0, r1.temperature);
        assertFloat(10.0, r1.temperature_ewma, 0.001);

        # record 2: ewma = 0.5 * 20 + 0.5 * 10 = 15.0
        hash<auto> r2 = proc.processRecord({"temperature": 20.0, "label": "b"});
        assertEq("b", r2.label);
        assertFloat(15.0, r2.temperature_ewma, 0.001);

        # record 3: ewma = 0.5 * 30 + 0.5 * 15 = 22.5
        hash<auto> r3 = proc.processRecord({"temperature": 30.0, "label": "c"});
        assertFloat(22.5, r3.temperature_ewma, 0.001);
    }

    ewmaMultipleFields() {
        DataProviderML::QoreEWMAProcessor proc({
            "fields": "x,y",
            "alpha": 0.3,
        });

        # record 1: both initialized
        hash<auto> r1 = proc.processRecord({"x": 100.0, "y": 50.0});
        assertFloat(100.0, r1.x_ewma, 0.001);
        assertFloat(50.0, r1.y_ewma, 0.001);

        # record 2: x_ewma = 0.3*200 + 0.7*100 = 130
        #           y_ewma = 0.3*0 + 0.7*50 = 35
        hash<auto> r2 = proc.processRecord({"x": 200.0, "y": 0.0});
        assertFloat(130.0, r2.x_ewma, 0.001);
        assertFloat(35.0, r2.y_ewma, 0.001);
    }

    ewmaHighAlpha() {
        # with alpha=0.9, EWMA should closely track the raw signal
        DataProviderML::QoreEWMAProcessor proc({
            "fields": "val",
            "alpha": 0.9,
        });

        proc.processRecord({"val": 0.0});
        hash<auto> r = proc.processRecord({"val": 100.0});
        # ewma = 0.9 * 100 + 0.1 * 0 = 90.0
        assertFloat(90.0, r.val_ewma, 0.001);
    }

    ewmaLowAlpha() {
        # with alpha=0.1, EWMA should change slowly
        DataProviderML::QoreEWMAProcessor proc({
            "fields": "val",
            "alpha": 0.1,
        });

        proc.processRecord({"val": 0.0});
        hash<auto> r = proc.processRecord({"val": 100.0});
        # ewma = 0.1 * 100 + 0.9 * 0 = 10.0
        assertFloat(10.0, r.val_ewma, 0.001);
    }

    ewmaBufferColumnsShape() {
        DataProviderML::QoreEWMAProcessor proc({
            "fields": "temperature",
            "alpha": 0.5,
        });

        auto columns = ColumnarResult::fromColumnHash({
            "temperature": new buffer<float64>((10.0, 20.0, 30.0)),
            "label": ("a", "b", "c"),
        });
        auto result = proc.processRecordsShape(columns, DataProviderShape::BufferColumns);
        assertEq(DataProviderShape::BufferColumns, AbstractDataProcessor::detectShape(result));
        assertEq(3, AbstractDataProcessor::shapeRecordCount(result, DataProviderShape::BufferColumns));
        assertEq(("a", "b", "c"), result.getColumn("label").toList());
        assertEq((10.0, 20.0, 30.0), result.getColumn("temperature").toList());
        assertEq("buffer<float64>", result.getColumn("temperature_ewma").fullType());
        assertFloat(10.0, result.getColumn("temperature_ewma")[0], 0.001);
        assertFloat(15.0, result.getColumn("temperature_ewma")[1], 0.001);
        assertFloat(22.5, result.getColumn("temperature_ewma")[2], 0.001);

        auto next = ColumnarResult::fromColumnHash({
            "temperature": new buffer<float64>((40.0,)),
            "label": ("d",),
        });
        auto next_result = proc.processRecordsShape(next, DataProviderShape::BufferColumns);
        assertEq(DataProviderShape::BufferColumns, AbstractDataProcessor::detectShape(next_result));
        assertFloat(31.25, next_result.getColumn("temperature_ewma")[0], 0.001);
    }

    ewmaNotConfigured() {
        DataProviderML::QoreEWMAProcessor proc();
        assertThrows("PROCESSOR-ERROR", \proc.processRecord(), {"x": 1.0});
    }

    ewmaCapabilities() {
        DataProviderML::QoreEWMAProcessor proc();
        hash<DataProvider::DataProviderInfo> info = proc.getInfo();
        assertEq("QoreEWMAProcessor", info.type);
        assertEq(DPC_TRANSFORM, info.processor_capabilities);
        assertEq(True, info.supports_pipeline_processor);
    }

    ewmaConstructorValidation() {
        # missing fields
        assertThrows("CONSTRUCTOR-ERROR", sub () {
            new DataProviderML::QoreEWMAProcessor({"alpha": 0.5});
        });

        # missing alpha
        assertThrows("CONSTRUCTOR-ERROR", sub () {
            new DataProviderML::QoreEWMAProcessor({"fields": "x"});
        });

        # alpha = 0 (out of range)
        assertThrows("CONSTRUCTOR-ERROR", sub () {
            new DataProviderML::QoreEWMAProcessor({
                "fields": "x",
                "alpha": 0.0,
            });
        });

        # alpha > 1 (out of range)
        assertThrows("CONSTRUCTOR-ERROR", sub () {
            new DataProviderML::QoreEWMAProcessor({
                "fields": "x",
                "alpha": 1.5,
            });
        });

        # alpha = 1.0 (edge case - should work)
        DataProviderML::QoreEWMAProcessor proc({
            "fields": "x",
            "alpha": 1.0,
        });
        hash<auto> r1 = proc.processRecord({"x": 10.0});
        assertFloat(10.0, r1.x_ewma, 0.001);
        hash<auto> r2 = proc.processRecord({"x": 20.0});
        # with alpha=1.0: ewma = 1.0 * 20 + 0.0 * 10 = 20.0
        assertFloat(20.0, r2.x_ewma, 0.001);

        # empty fields
        assertThrows("CONSTRUCTOR-ERROR", sub () {
            new DataProviderML::QoreEWMAProcessor({
                "fields": "",
                "alpha": 0.5,
            });
        });
    }

    # ===================== RegistryModel Tests =====================

    registryModelFieldParsing() {
        # Create a temp registry with a simple KMeans model
        string dir = tmp_location() + DirSep + "reg_model_test_" + get_random_bytes(4).toHex();
        mkdir_ex(dir, 0755, True);
        on_exit {
            DataProviderMLProcessorsTest::cleanupDir(dir);
        }

        # Create and register a model
        ML::KMeans km({"k": 2, "seed": 42});
        km.fitMatrix(((1.0, 1.0), (1.1, 1.1), (5.0, 5.0), (5.1, 5.1)));

        QoreModelRegistry::ModelRegistry registry({"path": dir});
        registry.register(km, {
            "name": "test_km",
            "description": "test",
        });

        # Verify the registry-model processor is accessible via the factory
        auto factory = DataProvider::DataProvider::getFactory("ml-processors");
        auto provider = factory.create({});
        list<string> children = provider.getChildProviderNames();
        assertTrue(children.contains("registry-model"),
            "registry-model processor should be available");

        # Test parseFieldList by verifying comma-separated fields string
        # works when processed through the DataProvider options infrastructure
        list<string> parsed = DataProvider::AbstractDataProvider::parseFieldList("x, y");
        assertEq(("x", "y"), parsed);

        # Also test list input
        list<string> parsed2 = DataProvider::AbstractDataProvider::parseFieldList(("a,b", "c"));
        assertEq(("a", "b", "c"), parsed2);

        # Verify the field parsing is used correctly in the processor constructor
        # by checking that it matches the pattern used by all other processors
        list<string> parsed3 = DataProvider::AbstractDataProvider::parseFieldList("feature_1, feature_2, target");
        assertEq(3, parsed3.size());
        assertEq("feature_1", parsed3[0]);
        assertEq("feature_2", parsed3[1]);
        assertEq("target", parsed3[2]);
    }

    registryModelOnnxPackageInference() {
        if (skipOnnx()) {
            return;
        }

        string dir = tmp_location() + DirSep + "reg_model_onnx_test_" + get_random_bytes(4).toHex();
        mkdir_ex(dir, 0755, True);
        on_exit {
            DataProviderMLProcessorsTest::cleanupDir(dir);
        }

        string package_dir = dir + DirSep + "linear_onnx";
        mkdir_ex(package_dir, 0755, True);
        File f();
        f.open(package_dir + DirSep + "model.onnx", O_CREAT | O_WRONLY | O_TRUNC, 0644);
        f.write(ReadOnlyFile::readBinaryFile(getTestModelPath()));

        FsUtil::TmpFile prefix("dpml-registry-onnx-profile-", "");
        *string profile_path;
        on_exit {
            if (profile_path.val() && is_file(profile_path)) {
                unlink(profile_path);
            }
        }

        QoreModelRegistry::ModelRegistry registry({"path": dir});
        string vid = registry.registerPackage(package_dir, {
            "name": "linear-onnx",
            "description": "test ONNX package",
            "execution_config": <ML::OnnxSessionConfig>{
                "providers": (),
                "profile_file_prefix": prefix.path,
            },
        });

        DataProviderML::QoreRegistryModelProcessor proc({
            "registry_path": dir,
            "model_name": "linear-onnx",
            "version": vid,
            "fields": "x",
            "window_size": 3,
            "include_diagnostics": True,
        });

        list<auto> results;
        foreach hash<auto> rec in (({"x": 1.0}, {"x": 2.0}, {"x": 3.0})) {
            DataProviderMLProcessorsTest::collectResult(\results, proc.processRecord(rec));
        }

        assertEq(3, results.size(), "registry ONNX processor should emit one event per record");
        assertEq("registry-model", results[0].event_type);
        assertEq("linear-onnx", results[0].model_name);
        assertEq(vid, results[0].version_id);
        assertTrue(results[0].execution_provider.val(),
            "registry ONNX events should include the active execution provider");
        assertEq("onnxruntime", results[0].provider_diagnostics.runtime,
            "registry ONNX events should include provider diagnostics");
        assertTrue(results[0].inference_stats.run_count >= 1,
            "registry ONNX diagnostic events should include inference counters");
        assertTrue(results[0].prediction.hasKey("Y"), "ONNX output should be returned as prediction hash");
        assertTrue(abs(3.0 - results[0].prediction.Y.toFloat()) < 0.01,
            sprintf("expected first ONNX prediction ~3.0, got %y", results[0].prediction.Y));
        assertTrue(abs(7.0 - results[2].prediction.Y.toFloat()) < 0.01,
            sprintf("expected third ONNX prediction ~7.0, got %y", results[2].prediction.Y));

        hash<auto> diag = proc.getDiagnostics(True);
        profile_path = diag.profile_path;
        assertEq("onnxruntime", diag.runtime);
        assertEq("linear-onnx", diag.model_name);
        assertEq(vid, diag.version_id);
        assertTrue(diag.inference_stats.run_count >= 1);
        assertTrue(profile_path.val(), "registry ONNX profiling should return a profile path");
        assertTrue(is_file(profile_path), "registry ONNX profile file should exist");
        assertTrue(diag.profile_summary.operator_names.contains("Gemm"),
            "registry ONNX profile summary should include the test model operator");
    }

    registryModelOnnxRegressionPlanOutput() {
