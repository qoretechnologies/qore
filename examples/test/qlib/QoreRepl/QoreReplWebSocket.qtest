%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires Logger

%requires json

%requires HttpServerUtil
%requires HttpServerAsyncIo
%requires HttpServer
%requires WebSocketClient
%requires QoreRepl
%requires AsyncApi

%exec-class QoreReplWebSocketTest

public class QoreReplWebSocketTest inherits QUnit::Test {
    public {
        HttpServer server;
        QoreReplWebSocketHandler wsHandler;
        Logger logger;
        int port;
    }

    private checkModule() {
    }

    constructor() : Test("QoreReplWebSocketTest", "1.0") {
        # Set up SIGUSR1 handler to dump thread stacks and I/O controller state
        @debug {
            set_signal_handler(SIGUSR1, sub (int sig) {
                printf("=== SIGUSR1 Thread Stacks ===\n%Y\n=== End Thread Stacks ===\n",
                    get_all_thread_call_stacks());
                printf("=== Controller cache_size=%d running=%y ===\n",
                    Qore::AsyncIoController::getCacheSize(),
                    Qore::AsyncIoController::running());
            });
        }

        addTestCase("Handler options", \testHandlerOptions());
        addTestCase("Session connection", \testSessionConnection());
        addTestCase("Eval simple expression", \testEvalSimple());
        addTestCase("Eval with error", \testEvalError());
        addTestCase("Multi-line input", \testMultiLine());
        addTestCase("Commands", \testCommands());
        addTestCase("Ping/Pong", \testPingPong());
        addTestCase("Authentication callback", \testAuthCallback());
        addTestCase("Max connections", \testMaxConnections());
        addTestCase("Thread messages", \testThreadMessages());
        addTestCase("Activity subscription", \testActivity());
        addTestCase("AsyncAPI schema", \testAsyncApiSchema());

        # Setup logger
        logger = new Logger("test", m_options.verbose > 3 ? LoggerLevel::LevelDebug : LoggerLevel::LevelInfo);
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }

        # Create handler
        wsHandler = new QoreReplWebSocketHandler(NOTHING, {
            "logger": logger,
        });

        # Create server
        hash<HttpServerOptionInfo> http_opts = <HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        };
        server = new HttpServer(http_opts);
        server.setHandler("repl", "/ws/repl", NOTHING, wsHandler);
        port = server.addListener(<HttpListenerOptionInfo>{"node": "localhost", "service": 0}).port;
        on_exit {
            server.stop();
            delete server;
            delete wsHandler;
        }

        set_return_value(main());
    }

    testHandlerOptions() {
        checkModule();
        # Test default values
        QoreReplWebSocketHandler h();
        assertEq(0, h.getMaxConnections(), "Default max connections should be 0");
        assertFalse(exists h.getReplOptions(), "Default REPL options should be NOTHING");

        # Test setting options
        h.setMaxConnections(5);
        assertEq(5, h.getMaxConnections(), "Max connections should be 5");

        h.setReplOptions({"parse_options": PO_NEW_STYLE});
        assertTrue(exists h.getReplOptions(), "REPL options should be set");

        # Test invalid options
        assertThrows("WEBSOCKETHANDLER-OPTION-ERROR", sub () {
            new QoreReplWebSocketHandler(NOTHING, {"auth_callback": "not a code"});
        });

        assertThrows("WEBSOCKETHANDLER-OPTION-ERROR", sub () {
            new QoreReplWebSocketHandler(NOTHING, {"max_connections": -1});
        });
    }

    testSessionConnection() {
        checkModule();
        Queue msgs();
        WebSocketClient wsc(sub (*data msg) { msgs.push(msg); }, {
            "url": "ws://localhost:" + port + "/ws/repl",
            "logger": logger,
        });

        wsc.connect();
        assertTrue(wsc.isOpen(), "Connection should be open");

        # Wait for session message
        string raw = msgs.get(5s);
        hash<auto> session_msg = parse_json(raw);
        assertEq("session", session_msg.type, "First message should be session");
        assertTrue(exists session_msg.sessionId, "Session should have ID");
        assertEq("1.0", session_msg.version, "Session version should be 1.0");
        assertTrue(exists session_msg.qoreVersion, "Session should have Qore version");

        # Wait for prompt
        raw = msgs.get(5s);
        hash<auto> prompt_msg = parse_json(raw);
        assertEq("prompt", prompt_msg.type, "Should receive prompt");
        assertEq("qore> ", prompt_msg.value, "Default prompt");
        assertFalse(prompt_msg.needsMoreInput, "Should not need more input");

        wsc.disconnect();
    }

    testEvalSimple() {
        checkModule();
        Queue msgs();
        WebSocketClient wsc(sub (*data msg) { msgs.push(msg); }, {
            "url": "ws://localhost:" + port + "/ws/repl",
            "logger": logger,
        });

        wsc.connect();
        # Consume session and initial prompt
        msgs.get(5s);  # session
        msgs.get(5s);  # prompt

        # Send eval request - use a variable declaration that returns a value
        wsc.send(make_json({"type": "eval", "id": "req1", "code": "our int x = 42"}));

        # Should get result and prompt (order may vary under load)
        *hash<auto> result_msg;
        bool got_prompt = False;
        for (int i = 0; i < 4 && (!result_msg || !got_prompt); ++i) {
            string raw = msgs.get(5s);
            hash<auto> msg = parse_json(raw);
            if (msg.type == "result") {
                result_msg = msg;
            } else if (msg.type == "prompt") {
                got_prompt = True;
            }
        }
        assertTrue(exists result_msg, "Should receive result");
        assertEq("req1", result_msg.id, "Should have correlation ID");
        assertTrue(exists result_msg.duration, "Should have duration");
        assertTrue(got_prompt, "Should receive prompt");

        wsc.disconnect();
    }

    testEvalError() {
        checkModule();
        Queue msgs();
        WebSocketClient wsc(sub (*data msg) { msgs.push(msg); }, {
            "url": "ws://localhost:" + port + "/ws/repl",
            "logger": logger,
        });

        wsc.connect();
        msgs.get(5s);  # session
        msgs.get(5s);  # prompt

        # Small delay to ensure connection is fully ready
        usleep(50ms);

        # Send code that throws
        wsc.send(make_json({"type": "eval", "id": "err1", "code": "throw 'TEST', 'test error'"}));

        # Wait for error response with longer timeout; ignore non-error messages
        *hash<auto> error_msg;
        date start = now_us();
        while (!error_msg) {
            *string raw;
            try {
                raw = msgs.get(5s);
            } catch (hash<ExceptionInfo> ex) {
                # Queue timeout
            }
            if (exists raw) {
                hash<auto> msg = parse_json(raw);
                if (msg.type == "error") {
                    error_msg = msg;
                    break;
                }
            }
            if ((now_us() - start) > 20s) {
                break;
            }
        }
        assertTrue(exists error_msg, "Should receive error message");
        assertEq("error", error_msg.type, "Should receive error");
        assertEq("err1", error_msg.id, "Should have correlation ID");
        assertEq("TEST", error_msg.error, "Should have error code");
        assertRegex("test error", error_msg.description, "Should have description");

        wsc.disconnect();
    }

    testMultiLine() {
        checkModule();
        Queue msgs();
        WebSocketClient wsc(sub (*data msg) { msgs.push(msg); }, {
            "url": "ws://localhost:" + port + "/ws/repl",
            "logger": logger,
        });

        wsc.connect();
        msgs.get(5s);  # session
        msgs.get(5s);  # prompt

        # Send incomplete code
        wsc.send(make_json({"type": "eval", "code": "if (True) {"}));

        # Should get continuation prompt
        string raw = msgs.get(5s);
        hash<auto> prompt_msg = parse_json(raw);
        assertEq("prompt", prompt_msg.type, "Should receive prompt");
        assertEq("    > ", prompt_msg.value, "Should show continuation prompt");
        assertTrue(prompt_msg.needsMoreInput, "Should need more input");

        # Complete the statement
        wsc.send(make_json({"type": "eval", "code": "}"}));

        # Should get result and normal prompt (order may vary under load)
        bool got_result = False;
        bool got_prompt = False;
        for (int i = 0; i < 4 && (!got_result || !got_prompt); ++i) {
            raw = msgs.get(5s);
            hash<auto> msg = parse_json(raw);
            if (msg.type == "result") {
                got_result = True;
            } else if (msg.type == "prompt" && !msg.needsMoreInput) {
                assertEq("qore> ", msg.value, "Should return to normal prompt");
                got_prompt = True;
            }
        }
        assertTrue(got_result, "Should receive result");
        assertTrue(got_prompt, "Should receive normal prompt");

        wsc.disconnect();
    }

    testCommands() {
        checkModule();
        Queue msgs();
        WebSocketClient wsc(sub (*data msg) { msgs.push(msg); }, {
            "url": "ws://localhost:" + port + "/ws/repl",
            "logger": logger,
        });

        wsc.connect();
        msgs.get(5s);  # session
        msgs.get(5s);  # prompt

        # Test /help command
        wsc.send(make_json({"type": "command", "command": "/help"}));

        # Server may send prompt before or after the result under load
        *hash<auto> help_result;
        for (int i = 0; i < 3 && !help_result; ++i) {
            string raw = msgs.get(5s);
            hash<auto> msg = parse_json(raw);
            if (msg.type == "result") {
                help_result = msg;
            }
        }
        assertTrue(exists help_result, "Should receive result");
        assertRegex("Commands:", help_result.value, "Help should mention commands");

        # Test unknown command — server may send prompt before or after the error
        wsc.send(make_json({"type": "command", "command": "/unknown"}));

        *hash<auto> error_msg;
        for (int i = 0; i < 3; ++i) {
            string raw = msgs.get(5s);
            hash<auto> msg = parse_json(raw);
            if (msg.type == "error") {
                error_msg = msg;
                break;
            }
        }
        assertTrue(exists error_msg, "Expected error message for unknown command");
        assertEq("error", error_msg.type, "Unknown command should return error");
        assertRegex("Unknown command", error_msg.description, "Should mention unknown command");

        wsc.disconnect();
    }

    testPingPong() {
        checkModule();
        Queue msgs();
        WebSocketClient wsc(sub (*data msg) { msgs.push(msg); }, {
            "url": "ws://localhost:" + port + "/ws/repl",
            "logger": logger,
        });

        wsc.connect();
        msgs.get(5s);  # session
        msgs.get(5s);  # prompt

        # Send ping
        wsc.send(make_json({"type": "ping", "id": "ping1"}));

        string raw = msgs.get(5s);
        hash<auto> pong_msg = parse_json(raw);
        assertEq("pong", pong_msg.type, "Should receive pong");
        assertEq("ping1", pong_msg.id, "Should have correlation ID");

        wsc.disconnect();
    }

    testAuthCallback() {
        checkModule();
        # Create handler with auth callback
        QoreReplWebSocketHandler authHandler(NOTHING, {
            "logger": logger,
            "auth_callback": bool sub (hash<auto> cx, hash<auto> hdr) {
                return hdr."x-api-key" == "secret123";
            },
        });

        hash<HttpListenerOptionInfo> linfo = <HttpListenerOptionInfo>{"node": "localhost", "service": 0};
        int authPort = server.addListener(linfo).port;
        server.setHandler("auth-repl", "/ws/auth-repl", NOTHING, authHandler);

        # Try without auth header - should fail
        bool connected = False;
        try {
            WebSocketClient badClient(sub (*data msg) {}, {
                "url": "ws://localhost:" + authPort + "/ws/auth-repl",
                "logger": logger,
            });
            badClient.connect();
            connected = badClient.isOpen();
            if (connected) badClient.disconnect();
        } catch (hash<ExceptionInfo> ex) {
            # Expected - connection should fail
        }
        assertFalse(connected, "Connection without auth should fail");

        # Try with correct auth header - should succeed
        Queue msgs();
        WebSocketClient goodClient(sub (*data msg) { msgs.push(msg); }, {
            "url": "ws://localhost:" + authPort + "/ws/auth-repl",
            "logger": logger,
        });
        goodClient.connect({"hdr": {"X-API-Key": "secret123"}});
        assertTrue(goodClient.isOpen(), "Connection with auth should succeed");

        # Should receive session message
        string raw = msgs.get(5s);
        hash<auto> session_msg = parse_json(raw);
        assertEq("session", session_msg.type, "Should receive session");

        goodClient.disconnect();
    }

    testMaxConnections() {
        checkModule();
        # Create handler with max 1 connection
        QoreReplWebSocketHandler limitHandler(NOTHING, {
            "logger": logger,
            "max_connections": 1,
        });

        hash<HttpListenerOptionInfo> linfo = <HttpListenerOptionInfo>{"node": "localhost", "service": 0};
        int limitPort = server.addListener(linfo).port;
        server.setHandler("limit-repl", "/ws/limit-repl", NOTHING, limitHandler);

        # First connection should succeed
        Queue msgs1();
        WebSocketClient client1(sub (*data msg) { msgs1.push(msg); }, {
            "url": "ws://localhost:" + limitPort + "/ws/limit-repl",
            "logger": logger,
        });
        client1.connect();
        assertTrue(client1.isOpen(), "First connection should succeed");
        msgs1.get(5s);  # session

        # Second connection should fail with 503
        bool got_error = False;
        try {
            WebSocketClient client2(sub (*data msg) {}, {
                "url": "ws://localhost:" + limitPort + "/ws/limit-repl",
                "logger": logger,
            });
            client2.connect();
            if (client2.isOpen()) client2.disconnect();
        } catch (hash<ExceptionInfo> ex) {
            # Expected - should get HTTP 503
            got_error = True;
            assertEq("WEBSOCKET-ERROR", ex.err, "Should get WebSocket error");
        }
        assertTrue(got_error, "Second connection should fail with error when max reached");

        # Close first, then third should succeed
        client1.disconnect();
        # Wait for the server to detect the disconnect and decrement
        # the connection count via async I/O close handling
        int wait_ms = 0;
        while (limitHandler.getConnectionCount() > 0 && wait_ms < 5000) {
            usleep(50ms);
            wait_ms += 50;
        }
        assertEq(0, limitHandler.getConnectionCount(),
            "connection count should be 0 after disconnect");

        Queue msgs3();
        WebSocketClient client3(sub (*data msg) { msgs3.push(msg); }, {
            "url": "ws://localhost:" + limitPort + "/ws/limit-repl",
            "logger": logger,
        });
        client3.connect();
        assertTrue(client3.isOpen(), "Connection after disconnect should succeed");
        client3.disconnect();
    }

    #! connects a client and consumes the session and prompt messages; returns the client
    private WebSocketClient connectClient(Queue msgs) {
        WebSocketClient wsc(sub (*data msg) { msgs.push(msg); }, {
            "url": "ws://localhost:" + port + "/ws/repl",
            "logger": logger,
        });
        wsc.connect();
        assertEq("session", parse_json(msgs.get(5s)).type);
        assertEq("prompt", parse_json(msgs.get(5s)).type);
        return wsc;
    }

    #! returns the messages up to the first with the given type for which the predicate is true, and that one
    private list<hash<auto>> until(Queue msgs, string type, *code<bool(hash<auto>)> predicate) {
        list<hash<auto>> rv();
        while (True) {
            hash<auto> msg = parse_json(msgs.get(60s));
            rv += msg;
            if (msg.type == type && (!predicate || predicate(msg))) {
                return rv;
            }
        }
    }

    testThreadMessages() {
        checkModule();
        Queue msgs();
        WebSocketClient wsc = connectClient(msgs);
        on_exit wsc.disconnect();

        wsc.send(make_json({"type": "eval", "id": "t1", "code": "background sub () { throw \"WS-ERROR\", "
            "\"ws error\"; }();"}));
        list<hash<auto>> l = until(msgs, "thread", bool sub (hash<auto> msg) { return msg.event == "finished"; });
        list<hash<auto>> threads = (map $1, l, $1.type == "thread");
        assertEq(("started", "finished"), (map $1.event, threads));
        hash<auto> start = threads[0];
        hash<auto> end = threads[1];
        assertEq(start.tid, end.tid);
        assertEq(start.threadId, end.threadId);
        assertEq(1, start.running);
        assertEq("qore/" + start.tid, start.name);
        assertEq(("Thread " + start.tid + " started",), start.notices);
        assertEq(0, end.running);
        assertEq("EXCEPTION", end.outcome);
        assertEq("WS-ERROR", end.error.err);
        assertEq("ws error", end.error.desc);
        assertTrue(end.durationMs >= 0);
        assertRegex("^Thread " + end.tid + " failed: WS-ERROR: ws error", end.notices[0]);
        # activity messages are not sent without a subscription
        assertEq((), (map $1, l, $1.type == "activity") ?? ());
    }

    testActivity() {
        checkModule();
        Queue msgs();
        WebSocketClient wsc = connectClient(msgs);
        on_exit wsc.disconnect();

        wsc.send(make_json({"type": "subscribe", "id": "s1", "activity": "yes"}));
        hash<auto> err = until(msgs, "error").last();
        assertEq("s1", err.id);
        assertEq("INVALID-PARAMETER", err.error);

        wsc.send(make_json({"type": "subscribe", "id": "s2", "activity": True}));
        hash<auto> subscribed = until(msgs, "subscribed").last();
        assertEq("s2", subscribed.id);
        assertTrue(subscribed.activity);

        wsc.send(make_json({"type": "eval", "id": "e1", "code": "1 + 1"}));
        # the evaluation makes the Program active and idle again
        list<hash<auto>> l = until(msgs, "activity", bool sub (hash<auto> msg) { return msg.idle; });
        list<hash<auto>> activity = (map $1, l, $1.type == "activity");
        assertFalse(activity[0].idle);
        assertEq(0, activity[0].running);
        assertTrue(activity.last().idle);

        wsc.send(make_json({"type": "subscribe", "id": "s3", "activity": False}));
        subscribed = until(msgs, "subscribed").last();
        assertFalse(subscribed.activity);
    }

    testAsyncApiSchema() {
        # the schema describes the messages of the protocol, including the asynchronous ones
        AsyncApi3Schema schema = AsyncApi3Loader::fromFile(get_script_dir() + "/../../../../qlib/QoreRepl/"
            "QoreReplApi.asyncapi.yaml");
        hash<auto> messages = schema.channels.repl.messages;
        foreach string name in (("subscribeRequest", "subscribedResponse", "threadEvent", "activityEvent",
                "programReplacedEvent")) {
            assertTrue(exists messages{name}, name);
        }
        foreach string op in (("sendSubscribe", "receiveSubscribed", "receiveThread", "receiveActivity",
                "receiveProgramReplaced")) {
            assertTrue(exists schema.operations{op}, op);
        }
    }
}
