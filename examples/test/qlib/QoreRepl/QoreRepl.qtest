    #! Test basic PO_ALLOW_REPARSE functionality
    testAllowReparseBasic() {
        Program pgm(PO_NEW_STYLE | PO_ALLOW_REPARSE, True);
        assertTrue((pgm.getParseOptions() & PO_ALLOW_REPARSE) != 0,
            "PO_ALLOW_REPARSE should be set");

        pgm.parse("our int x = 1;", "test1");
        pgm.run();
        assertEq(1, pgm.getGlobalVariable("x"), "First parse should set x=1");

        pgm.parse("our int y = x + 10;", "test2");
        pgm.run();
        assertEq(11, pgm.getGlobalVariable("y"), "Second parse should set y=11");

        # Test function definition (use 'sub' keyword for top-level functions)
        pgm.parse("int sub double(int n) { return n * 2; }", "test3");
        pgm.run();
        pgm.parse("our int doubled = double(11);", "test4");
        pgm.run();
        assertEq(22, pgm.getGlobalVariable("doubled"), "Function should work");
    }

    #! Test negative cases - parsing without PO_ALLOW_REPARSE should fail
    testAllowReparseNegative() {
        Program pgm(PO_NEW_STYLE, True);
        assertTrue((pgm.getParseOptions() & PO_ALLOW_REPARSE) == 0,
            "PO_ALLOW_REPARSE should NOT be set");

        pgm.parse("our int x = 1;", "test1");
        pgm.run();
        assertEq(1, pgm.getGlobalVariable("x"), "First parse should succeed");

        bool caught = False;
        try {
            pgm.parse("our int y = 2;", "test2");
        } catch (hash<ExceptionInfo> ex) {
            caught = True;
            assertEq("PARSE-ERROR", ex.err, "Should get PARSE-ERROR");
        }
        assertTrue(caught, "Second parse without PO_ALLOW_REPARSE should throw");
    }

    #! Test thread safety - parsing should be blocked when threads are active
    testAllowReparseThreadSafety() {
        Program pgm(PO_NEW_STYLE | PO_ALLOW_REPARSE, True);

        pgm.parse("
            our bool stop = False;
            sub worker() { while (!stop) usleep(10ms); }
        ", "setup");
        pgm.run();

        pgm.parse("background worker();", "start");
        pgm.run();

        # Wait for thread to start
        while (pgm.getThreadCount() == 0) usleep(10ms);
        assertTrue(pgm.getThreadCount() > 0, "Thread should be running");

        # Parsing while thread is active should fail
        bool caught = False;
        try {
            pgm.parse("our int x = 1;", "fail");
        } catch (hash<ExceptionInfo> ex) {
            caught = True;
            assertEq("PARSE-ERROR", ex.err, "Should get PARSE-ERROR");
        }
        assertTrue(caught, "Parse with active thread should throw");

        # Stop the thread
        pgm.setGlobalVarValue("stop", True);
        while (pgm.getThreadCount() > 0) usleep(10ms);
        assertEq(0, pgm.getThreadCount(), "Thread should have stopped");

        # Parsing after thread stops should succeed
        pgm.parse("our int ok = 42;", "after");
        pgm.run();
        assertEq(42, pgm.getGlobalVariable("ok"), "Parse should succeed after thread stops");
    }

    #! Test local variables in REPL mode
    testAllowReparseLocalVars() {
        Program pgm(PO_NEW_STYLE | PO_ALLOW_REPARSE, True);

        # First parse with a local variable
        pgm.parse("int x = 5;", "test1");
        pgm.run();

        # Second parse with another local variable that uses the first
        pgm.parse("int y = x + 10;", "test2");
        pgm.run();

        # Third parse to verify the variables are accessible
        pgm.parse("our int result = x + y;", "test3");
        pgm.run();
        assertEq(20, pgm.getGlobalVariable("result"), "Local variables should persist: x=5, y=15, result=20");

        # Test class instantiation with local variables
        pgm.parse("class C { public { int val; } constructor(int v) { val = v; }}", "class");
        pgm.run();

        pgm.parse("C obj(42);", "obj");
        pgm.run();

        pgm.parse("our int objVal = obj.val;", "getVal");
        pgm.run();
        assertEq(42, pgm.getGlobalVariable("objVal"), "Object local variable should work");
    }

    #! Test basic QoreRepl functionality
    testQoreReplBasic() {
        QoreRepl repl();

        *hash<auto> result = repl.eval("1 + 1");
        assertTrue(exists result, "Should return result");
        assertTrue(!result.error, "Should not have error");

        result = repl.eval("our int x = 10");
        assertTrue(exists result, "Should return result");
        assertTrue(!result.error, "Should not have error");
        assertEq(10, repl.getProgram().getGlobalVariable("x"), "x should be 10");

        result = repl.eval("int sub square(int n) { return n * n; }");
        assertTrue(exists result, "Should return result");
        assertTrue(!result.error, "Should not have error");

        result = repl.eval("our int sq = square(5)");
        assertTrue(!result.error, "Function call should succeed");
        assertEq(25, repl.getProgram().getGlobalVariable("sq"), "square(5) = 25");

        assertEq("qore> ", repl.getPrompt(), "Default prompt");
        assertFalse(repl.needsMoreInput(), "Should not need more input");
    }

    #! Test /help command
    testCommandHelp() {
        QoreRepl repl();

        *hash<auto> result = repl.eval("/help");
        assertTrue(exists result, "Should return result");
        assertFalse(exists result.error, "Should not have error");
        assertTrue(exists result.value, "Should have value");
        assertRegex("Commands:", result.value, "Help should mention Commands");
        assertRegex("/quit", result.value, "Help should mention /quit");
        assertRegex("/vars", result.value, "Help should mention /vars");
        # Check for new commands in help
        assertRegex("/functions", result.value, "Help should mention /functions");
        assertRegex("/classes", result.value, "Help should mention /classes");
        assertRegex("/constants", result.value, "Help should mention /constants");
        assertRegex("/namespaces", result.value, "Help should mention /namespaces");
        assertRegex("/modules", result.value, "Help should mention /modules");
        assertRegex("/type", result.value, "Help should mention /type");
        assertRegex("/describe", result.value, "Help should mention /describe");
        assertRegex("/history", result.value, "Help should mention /history");
        assertRegex("/timing", result.value, "Help should mention /timing");
        assertRegex("/pwd", result.value, "Help should mention /pwd");
        assertRegex("/cd", result.value, "Help should mention /cd");
        assertRegex("/save", result.value, "Help should mention /save");

        # Test /? alias
        result = repl.eval("/?");
        assertTrue(exists result.value, "/?  should also return help");
    }

    #! Test /vars command
    testCommandVars() {
        QoreRepl repl();

        # Initially - may have inherited system variables (ARGV, ENV, etc.)
        *hash<auto> result = repl.eval("/vars");
        assertTrue(exists result, "Should return result");
        assertFalse(exists result.error, "Should not have error");
        assertTrue(exists result.value, "/vars should return output");

        # Add a user variable
        repl.eval("our int x = 42");
        result = repl.eval("/vars");
        assertRegex("x", result.value, "Should show x variable");
        assertRegex("42", result.value, "Should show x value");

        # Add more variables
        repl.eval("our string name = 'test'");
        result = repl.eval("/vars");
        assertRegex("x", result.value, "Should still show x");
        assertRegex("name", result.value, "Should show name variable");
    }

    #! Test /reset command
    testCommandReset() {
        QoreRepl repl();

        # Set up some state
        repl.eval("our int x = 100");
        assertEq(100, repl.getProgram().getGlobalVariable("x"), "x should be 100");

        # Reset
        *hash<auto> result = repl.eval("/reset");
        assertTrue(exists result, "Should return result");
        assertFalse(exists result.error, "Should not have error");
        assertRegex("reset", result.value.lwr(), "Should confirm reset");

        # User-defined variable should be gone
        # Note: System variables like ARGV, ENV may still exist after reset
        *hash<auto> vars = repl.eval("/vars");
        assertFalse(exists vars.error, "/vars should not error after reset");
        # x should no longer be in the output
        assertFalse(vars.value =~ /\bx\b/, "Variable x should be cleared after reset");
    }

    #! Test /clear command
    testCommandClear() {
        QoreRepl repl();

        # Start a multi-line input
        *hash<auto> result = repl.eval("if (True) {");
        assertFalse(exists result, "Should need more input");
        assertTrue(repl.needsMoreInput(), "Should be in multi-line mode");
        assertEq("    > ", repl.getPrompt(), "Should show continuation prompt");

        # Clear the pending input
        result = repl.eval("/clear");
        assertTrue(exists result, "Should return result");
        assertFalse(exists result.error, "Should not have error");
        assertFalse(repl.needsMoreInput(), "Should no longer need more input");
        assertEq("qore> ", repl.getPrompt(), "Should show normal prompt");
    }

    #! Test /quit, /exit, /q commands
    testCommandQuit() {
        QoreRepl repl();

        # Test /quit
        *hash<auto> result = repl.eval("/quit");
        assertTrue(exists result, "Should return result");
        assertTrue(result.exit, "/quit should set exit flag");

        # Test /exit
        repl.reset();
        result = repl.eval("/exit");
        assertTrue(result.exit, "/exit should set exit flag");

        # Test /q
        repl.reset();
        result = repl.eval("/q");
        assertTrue(result.exit, "/q should set exit flag");
    }

    #! Test unknown command
    testCommandUnknown() {
        QoreRepl repl();

        *hash<auto> result = repl.eval("/unknown");
        assertTrue(exists result, "Should return result");
        assertTrue(exists result.error, "Should have error");
        assertEq("REPL-ERROR", result.error.err, "Should be REPL-ERROR");
        assertRegex("Unknown command", result.error.desc, "Should mention unknown command");
    }

    #! Test /functions command
    testCommandFunctions() {
        QoreRepl repl();

        # Initially no user functions
        *hash<auto> result = repl.eval("/functions");
        assertTrue(exists result, "Should return result");
        assertFalse(exists result.error, "Should not have error");
        assertRegex("No user-defined functions", result.value, "Should indicate no functions");

        # Define a function
        repl.eval("sub myFunc() { return 42; }");
        result = repl.eval("/functions");
        assertRegex("myFunc", result.value, "Should show myFunc");

        # Test /funcs alias
        result = repl.eval("/funcs");
        assertRegex("myFunc", result.value, "/funcs should also work");

        # Define another function
        repl.eval("int sub addTwo(int n) { return n + 2; }");
        result = repl.eval("/functions");
        assertRegex("myFunc", result.value, "Should still show myFunc");
        assertRegex("addTwo", result.value, "Should show addTwo");
    }

    #! Test /classes command
    testCommandClasses() {
        QoreRepl repl();

        # Initially no user classes
        *hash<auto> result = repl.eval("/classes");
        assertTrue(exists result, "Should return result");
        assertFalse(exists result.error, "Should not have error");
        assertRegex("No user-defined classes", result.value, "Should indicate no classes");

        # Define a class (must use public block for members in REPL mode)
        repl.eval("class MyClass { public { int val = 0; } }");
        result = repl.eval("/classes");
        assertFalse(exists result.error, "/classes should not error");
        assertRegex("MyClass", result.value, "Should show MyClass");

        # Define another class
        repl.eval("class AnotherClass { public { string name; } }");
        result = repl.eval("/classes");
        assertFalse(exists result.error, "/classes should not error");
        assertRegex("MyClass", result.value, "Should still show MyClass");
        assertRegex("AnotherClass", result.value, "Should show AnotherClass");
    }

    #! Test /constants command
    testCommandConstants() {
        QoreRepl repl();

        # Initially no user constants
        *hash<auto> result = repl.eval("/constants");
        assertTrue(exists result, "Should return result");
        assertFalse(exists result.error, "Should not have error");
        assertRegex("No user-defined constants", result.value, "Should indicate no constants");

        # Define a constant
        repl.eval("const MY_CONST = 100;");
        result = repl.eval("/constants");
        assertRegex("MY_CONST", result.value, "Should show MY_CONST");

        # Test /consts alias
        result = repl.eval("/consts");
        assertRegex("MY_CONST", result.value, "/consts should also work");

        # Define another constant
        repl.eval("const ANOTHER_CONST = 'hello';");
        result = repl.eval("/constants");
        assertRegex("MY_CONST", result.value, "Should still show MY_CONST");
        assertRegex("ANOTHER_CONST", result.value, "Should show ANOTHER_CONST");
    }

    #! Test /namespaces command
    testCommandNamespaces() {
        QoreRepl repl();

        # Should at least show Qore namespace
        *hash<auto> result = repl.eval("/namespaces");
        assertTrue(exists result, "Should return result");
        assertFalse(exists result.error, "Should not have error");
        assertRegex("Qore", result.value, "Should show Qore namespace");

        # Test /ns alias
        result = repl.eval("/ns");
        assertRegex("Qore", result.value, "/ns should also work");
    }

    #! Test /modules command
    testCommandModules() {
        QoreRepl repl();

        # Should show some modules (at least DGC which is always loaded)
        *hash<auto> result = repl.eval("/modules");
        assertTrue(exists result, "Should return result");
        assertFalse(exists result.error, "Should not have error");
        assertTrue(exists result.value, "Should have value");
        # DGC (deterministic garbage collector) is typically always present
        assertRegex("Loaded modules:", result.value, "Should show loaded modules header");
    }

    #! Test /type command
    testCommandType() {
        QoreRepl repl();

        # Test with integer - reflection shows "int" not "integer"
        *hash<auto> result = repl.eval("/type 42");
        assertTrue(exists result, "Should return result");
        assertFalse(exists result.error, "Should not have error");
        assertRegex("int", result.value, "Should show int type");

        # Test with string
        result = repl.eval("/type 'hello'");
        assertFalse(exists result.error, "Should not have error");
        assertRegex("string", result.value, "Should show string type");

        # Test with list - shows full type like list<int>
        result = repl.eval("/type (1, 2, 3)");
        assertFalse(exists result.error, "Should not have error");
        assertRegex("list", result.value, "Should show list type");

        # Test with hash
        result = repl.eval("/type ('a': 1)");
        assertFalse(exists result.error, "Should not have error");
        assertRegex("hash", result.value, "Should show hash type");

        # Test with variable
        repl.eval("our float f = 3.14;");
        result = repl.eval("/type f");
        assertFalse(exists result.error, "Should not have error");
        assertRegex("float", result.value, "Should show float type");

        # Test with expression - reflection shows "int" not "integer"
        result = repl.eval("/type 1 + 2");
        assertFalse(exists result.error, "Should not have error");
        assertRegex("int", result.value, "Should show int type for expression");

        # Test error case - no argument
        result = repl.eval("/type");
        assertTrue(exists result.error, "Should have error without argument");
        assertEq("REPL-ERROR", result.error.err, "Should be REPL-ERROR");
    }

    #! Test /describe command
    testCommandDescribe() {
        QoreRepl repl();

        # Define a class to describe
        repl.eval("class TestClass { public { int x; string name; } int getX() { return x; } }");

        *hash<auto> result = repl.eval("/describe TestClass");
        assertTrue(exists result, "Should return result");
        assertFalse(exists result.error, "Should not have error");
        assertRegex("Class:", result.value, "Should show Class label");
        assertRegex("TestClass", result.value, "Should show class name");
        assertRegex("Members:", result.value, "Should show members");
        assertRegex("Methods:", result.value, "Should show methods");
        assertRegex("getX", result.value, "Should show getX method");

        # Define a function to describe
        repl.eval("string sub greet(string name) { return 'Hello ' + name; }");
        result = repl.eval("/describe greet");
        assertFalse(exists result.error, "Should not have error");
        assertRegex("Function:", result.value, "Should show Function label");
        assertRegex("greet", result.value, "Should show function name");

        # Describe a namespace
        result = repl.eval("/describe Qore");
        assertFalse(exists result.error, "Should not have error");
        assertRegex("Namespace:", result.value, "Should show Namespace label");

        # Describe an enum (should show all values, not be listed as namespace)
        result = repl.eval("/describe HTTP2Mode");
        assertFalse(exists result.error, "Should not have error");
        assertRegex("Enum:", result.value, "Should show Enum label (not Namespace)");
        assertRegex("Base type:", result.value, "Should show base type");
        assertRegex("Values:", result.value, "Should show Values section");
        assertRegex("Disabled", result.value, "Should show Disabled enum value");
        assertRegex("Auto", result.value, "Should show Auto enum value");

        # Test error case - symbol not found
        result = repl.eval("/describe NonExistent");
        assertTrue(exists result.error, "Should have error for non-existent symbol");
        assertEq("REPL-ERROR", result.error.err, "Should be REPL-ERROR");
        assertRegex("not found", result.error.desc, "Should mention symbol not found");

        # Test error case - no argument
        result = repl.eval("/describe");
        assertTrue(exists result.error, "Should have error without argument");
        assertEq("REPL-ERROR", result.error.err, "Should be REPL-ERROR");
    }

    #! Test /history command
    testCommandHistory() {
        QoreRepl repl();

        # Initially empty history
        *hash<auto> result = repl.eval("/history");
        # The /history command itself gets added to history
        assertTrue(exists result, "Should return result");
        assertFalse(exists result.error, "Should not have error");

        # Add some commands
        repl.eval("1 + 1");
        repl.eval("our int x = 42;");
        repl.eval("/vars");

        result = repl.eval("/history");
        assertFalse(exists result.error, "Should not have error");
        assertRegex("1 \\+ 1", result.value, "Should show first command in history");
        assertRegex("x = 42", result.value, "Should show variable definition in history");
        assertRegex("/vars", result.value, "Should show /vars command in history");
    }

    #! Test abbreviated commands
    testAbbreviatedCommands() {
        QoreRepl repl();

        # Test unambiguous abbreviation - /desc for /describe
        *hash<auto> result = repl.eval("/desc Mutex");
        assertFalse(exists result.error, "/desc should resolve to /describe");
        assertRegex("Class:", result.value, "Should show class description");
        assertRegex("Mutex", result.value, "Should describe Mutex");

        # Test unambiguous abbreviation - /his for /history
        result = repl.eval("/his");
        assertFalse(exists result.error, "/his should resolve to /history");
        assertRegex("history", result.value.lwr(), "Should show command history");

        # Test unambiguous abbreviation - /he for /help
        result = repl.eval("/he");
        assertFalse(exists result.error, "/he should resolve to /help");
        assertRegex("Commands:", result.value, "Should show help text");

        # Test unambiguous abbreviation - /ti for /timing
        result = repl.eval("/ti");
        assertFalse(exists result.error, "/ti should resolve to /timing");
        assertRegex("enabled", result.value, "Should toggle timing");

        # Test unambiguous abbreviation - /ty for /type
        result = repl.eval("/ty 42");
        assertFalse(exists result.error, "/ty should resolve to /type");
        assertRegex("int", result.value, "Should show integer type");

        # Test ambiguous abbreviation - /c matches multiple commands
        result = repl.eval("/c");
        assertTrue(exists result.error, "/c should be ambiguous");
        assertEq("REPL-ERROR", result.error.err, "Should be REPL-ERROR");
        assertRegex("Ambiguous", result.error.desc, "Should mention ambiguous");
        assertRegex("/clear", result.error.desc, "Should list /clear option");
        assertRegex("/classes", result.error.desc, "Should list /classes option");
        assertRegex("/cd", result.error.desc, "Should list /cd option");

        # Test ambiguous abbreviation - /cl matches /clear and /classes
        result = repl.eval("/cl");
        assertTrue(exists result.error, "/cl should be ambiguous");
        assertRegex("Ambiguous", result.error.desc, "Should mention ambiguous");
        assertRegex("/clear", result.error.desc, "Should list /clear");
        assertRegex("/classes", result.error.desc, "Should list /classes");

        # Test that exact short aliases still work
        result = repl.eval("/ns");
        assertFalse(exists result.error, "/ns exact alias should work");
        assertRegex("Namespace", result.value, "Should show namespaces");

        result = repl.eval("/funcs");
        assertFalse(exists result.error, "/funcs exact alias should work");

        result = repl.eval("/?");
        assertFalse(exists result.error, "/? exact alias should work");
        assertRegex("Commands:", result.value, "Should show help text");
    }

    #! Test /timing command
    testCommandTiming() {
        QoreRepl repl();

        # Enable timing
        *hash<auto> result = repl.eval("/timing");
        assertTrue(exists result, "Should return result");
        assertFalse(exists result.error, "Should not have error");
        assertRegex("enabled", result.value, "Should indicate timing enabled");

        # Execute something and check for timing in result
        result = repl.eval("1 + 1");
        assertFalse(exists result.error, "Should not have error");
        assertTrue(exists result.timing, "Should have timing field when enabled");
        assertTrue(result.timing.typeCode() == NT_DATE, "Timing should be a date/time value");

        # Disable timing
        result = repl.eval("/timing");
        assertRegex("disabled", result.value, "Should indicate timing disabled");

        # Execute again and verify no timing
        result = repl.eval("2 + 2");
        assertFalse(exists result.timing, "Should not have timing field when disabled");
    }

    #! Test /pwd and /cd commands
    testCommandPwdCd() {
        QoreRepl repl();

        # Get current directory
        string original_dir = getcwd();

        # Test /pwd
        *hash<auto> result = repl.eval("/pwd");
        assertTrue(exists result, "Should return result");
        assertFalse(exists result.error, "Should not have error");
        assertEq(original_dir, result.value, "Should show current directory");

        # Test /cd to /tmp
        result = repl.eval("/cd /tmp");
        assertFalse(exists result.error, "Should not have error");
        assertRegex("/tmp", result.value, "Should confirm change to /tmp");

        # Verify with /pwd
        result = repl.eval("/pwd");
        assertRegex("/tmp", result.value, "pwd should show /tmp");

        # Change back to original directory
        repl.eval("/cd " + original_dir);

        # Test error case - invalid directory (use a clearly non-existent path)
        result = repl.eval("/cd /this_path_does_not_exist_12345");
        # chdir should fail on non-existent directories
        if (exists result.error) {
            assertTrue(True, "chdir correctly returned error for invalid directory");
        } else {
            # If no error, verify we didn't actually change to that directory
            result = repl.eval("/pwd");
            assertFalse(result.value =~ /this_path_does_not_exist/, "Should not have changed to invalid directory");
        }

        # Test error case - no argument
        result = repl.eval("/cd");
        assertTrue(exists result.error, "Should have error without argument");
        assertEq("REPL-ERROR", result.error.err, "Should be REPL-ERROR");
    }

    #! Test /save command
    testCommandSave() {
        QoreRepl repl();

        # Create some history
        repl.eval("our int x = 1;");
        repl.eval("our int y = 2;");
        repl.eval("sub testFunc() { return x + y; }");
        repl.eval("/vars");  # This command should NOT be saved (starts with /)

        # Save to temp file
        string temp_file = tmp_location() + "/repl_test_" + string(getpid()) + ".q";
        *hash<auto> result = repl.eval("/save " + temp_file);
        assertTrue(exists result, "Should return result");
        assertFalse(exists result.error, "Should not have error");
        assertRegex("saved", result.value.lwr(), "Should confirm save");

        # Read and verify saved content
        string saved = ReadOnlyFile::readTextFile(temp_file);
        assertRegex("our int x = 1", saved, "Should contain x definition");
        assertRegex("our int y = 2", saved, "Should contain y definition");
        assertRegex("sub testFunc", saved, "Should contain function definition");
        assertFalse(saved =~ /\/vars/, "Should NOT contain /vars command");

        # Clean up
        unlink(temp_file);

        # Test error case - no argument
        result = repl.eval("/save");
        assertTrue(exists result.error, "Should have error without argument");
        assertEq("REPL-ERROR", result.error.err, "Should be REPL-ERROR");
    }

    #! Test sandboxed REPL with filesystem restrictions
    testSandboxFilesystem() {
        # Create a sandboxed REPL with no filesystem access
        QoreRepl repl({"parse_options": PO_NEW_STYLE | PO_NO_FILESYSTEM});

        # /pwd should be disabled
        *hash<auto> result = repl.eval("/pwd");
        assertTrue(exists result.error, "/pwd should error in sandboxed mode");
        assertEq("REPL-ERROR", result.error.err, "Should be REPL-ERROR");
        assertRegex("PO_NO_FILESYSTEM", result.error.desc, "Should mention PO_NO_FILESYSTEM");

        # /cd should be disabled
        result = repl.eval("/cd /tmp");
        assertTrue(exists result.error, "/cd should error in sandboxed mode");
        assertRegex("PO_NO_FILESYSTEM", result.error.desc, "Should mention PO_NO_FILESYSTEM");

        # /load should be disabled
        result = repl.eval("/load /tmp/test.q");
        assertTrue(exists result.error, "/load should error in sandboxed mode");
        assertRegex("PO_NO_FILESYSTEM", result.error.desc, "Should mention PO_NO_FILESYSTEM");

        # /save should be disabled
        result = repl.eval("/save /tmp/test.q");
        assertTrue(exists result.error, "/save should error in sandboxed mode");
        assertRegex("PO_NO_FILESYSTEM", result.error.desc, "Should mention PO_NO_FILESYSTEM");

        # Other commands should still work
        result = repl.eval("/help");
        assertFalse(exists result.error, "/help should work in sandboxed mode");

        result = repl.eval("our int x = 1 + 1");
        assertFalse(exists result.error, "Expressions should work in sandboxed mode");
        assertEq(2, repl.getProgram().getGlobalVariable("x"), "1 + 1 = 2");

        result = repl.eval("/vars");
        assertFalse(exists result.error, "/vars should work in sandboxed mode");
        assertRegex("x", result.value, "Should show x variable");
    }

    #! Test sandboxed REPL with network restrictions
    testSandboxNetwork() {
        # Create a sandboxed REPL with no network access
        QoreRepl repl({"parse_options": PO_NEW_STYLE | PO_NO_NETWORK});

        # Basic operations should still work
        *hash<auto> result = repl.eval("1 + 1");
        assertFalse(exists result.error, "Expressions should work");
        assertEq(2, result.value, "1 + 1 = 2");

        # Filesystem commands should still work (not restricted)
        result = repl.eval("/pwd");
        assertFalse(exists result.error, "/pwd should work without PO_NO_FILESYSTEM");

        # Network operations should fail at runtime
        result = repl.eval("our Socket s()");
        # This may or may not error at parse time depending on how PO_NO_NETWORK works
        # The key is that the REPL itself handles it gracefully
        assertTrue(True, "REPL handles network restrictions gracefully");
    }

    #! Test sandboxed REPL with custom parse options
    testSandboxCustomOptions() {
        # Create a fully sandboxed REPL
        QoreRepl repl({
            "parse_options": PO_NEW_STYLE | PO_NO_FILESYSTEM | PO_NO_NETWORK
                          | PO_NO_EXTERNAL_PROCESS | PO_NO_PROCESS_CONTROL
        });

        # Basic REPL functionality should work
        *hash<auto> result = repl.eval("our int x = 42");
        assertFalse(exists result.error, "Variable declaration should work");

        result = repl.eval("/vars");
        assertFalse(exists result.error, "/vars should work");
        assertRegex("x", result.value, "Should show x variable");

        result = repl.eval("sub double(int n) { return n * 2; }");
        assertFalse(exists result.error, "Function definition should work");

        result = repl.eval("/functions");
        assertFalse(exists result.error, "/functions should work");
        assertRegex("double", result.value, "Should show double function");

        result = repl.eval("double(x)");
        assertFalse(exists result.error, "Function call should work");
        assertEq(84, result.value, "double(42) = 84");

        # Introspection should work
        result = repl.eval("/type 'hello'");
        assertFalse(exists result.error, "/type should work");
        assertRegex("string", result.value, "Should show string type");

        # Filesystem commands should be disabled
        result = repl.eval("/pwd");
        assertTrue(exists result.error, "/pwd should be disabled");

        # Timing should work
        result = repl.eval("/timing");
        assertFalse(exists result.error, "/timing should work");
        assertRegex("enabled", result.value, "Should enable timing");
    }

    #! Test multi-line block statement
    testMultiLineBlock() {
        QoreRepl repl();

        # Start if block
        *hash<auto> result = repl.eval("if (True) {");
        assertFalse(exists result, "Should need more input after opening brace");
        assertTrue(repl.needsMoreInput(), "Should need more input");

        # Add body
        result = repl.eval("    our int x = 1;");
        assertFalse(exists result, "Should still need more input");

        # Close block
        result = repl.eval("}");
        assertTrue(exists result, "Should complete after closing brace");
        assertFalse(exists result.error, "Should not have error");
        assertEq(1, repl.getProgram().getGlobalVariable("x"), "Block should have executed");
    }

    #! Test multi-line function definition
    testMultiLineFunction() {
        QoreRepl repl();

        # Start function
        *hash<auto> result = repl.eval("int sub add(int a, int b) {");
        assertFalse(exists result, "Should need more input");

        # Add body
        result = repl.eval("    return a + b;");
        assertFalse(exists result, "Should still need more input");

        # Close function
        result = repl.eval("}");
        assertTrue(exists result, "Should complete");
        assertFalse(exists result.error, "Should not have error");

        # Use the function
        result = repl.eval("our int sum = add(3, 4)");
        assertFalse(exists result.error, "Function call should succeed");
        assertEq(7, repl.getProgram().getGlobalVariable("sum"), "add(3, 4) = 7");
    }

    #! Test multi-line class definition
    testMultiLineClass() {
        QoreRepl repl();

        # Start class
        *hash<auto> result = repl.eval("class Counter {");
        assertFalse(exists result, "Should need more input");

        result = repl.eval("    private { int count = 0; }");
        assertFalse(exists result, "Should need more input");

        result = repl.eval("    int inc() { return ++count; }");
        assertFalse(exists result, "Should need more input");

        result = repl.eval("}");
        assertTrue(exists result, "Should complete");
        assertFalse(exists result.error, "Should not have error");

        # Use the class
        result = repl.eval("our Counter c()");
        assertFalse(exists result.error, "Should create instance");

        result = repl.eval("our int n = c.inc()");
        assertFalse(exists result.error, "Should call method");
        assertEq(1, repl.getProgram().getGlobalVariable("n"), "c.inc() should return 1");
    }

    #! Test deeply nested blocks
    testNestedBlocks() {
        QoreRepl repl();

        # Nested if blocks
        *hash<auto> result = repl.eval("if (True) {");
        assertFalse(exists result, "Should need more input");

        result = repl.eval("    if (True) {");
        assertFalse(exists result, "Should need more input");

        result = repl.eval("        our int deep = 42;");
        assertFalse(exists result, "Should need more input");

        result = repl.eval("    }");
        assertFalse(exists result, "Should still need more input (outer block open)");

        result = repl.eval("}");
        assertTrue(exists result, "Should complete after all braces closed");
        assertFalse(exists result.error, "Should not have error");
        assertEq(42, repl.getProgram().getGlobalVariable("deep"), "Nested block should execute");
    }

    #! Test trailing operators indicate continuation
    testTrailingOperators() {
        QoreRepl repl();

        # Trailing comma
        *hash<auto> result = repl.eval("our list<auto> l = (1,");
        assertFalse(exists result, "Trailing comma should need more input");

        result = repl.eval("2, 3)");
        assertTrue(exists result, "Should complete");
        assertFalse(exists result.error, "Should not have error");

        # Trailing plus
        result = repl.eval("our int x = 1 +");
        assertFalse(exists result, "Trailing + should need more input");

        result = repl.eval("2");
        assertTrue(exists result, "Should complete");
        assertFalse(exists result.error, "Should not have error");
        assertEq(3, repl.getProgram().getGlobalVariable("x"), "1 + 2 = 3");
    }

    #! Test parse error handling
    testParseError() {
        QoreRepl repl();

        # Syntax error - use a clearly invalid expression
        *hash<auto> result = repl.eval("our int x = @#$");
        assertTrue(exists result, "Should return result");
        assertTrue(exists result.error, "Should have error");
        # Could be PARSE-EXCEPTION or PARSE-ERROR depending on the error
        assertTrue(result.error.err =~ /PARSE/, "Should be a parse error");
    }

    #! Test runtime exception handling
    testRuntimeError() {
        QoreRepl repl();

        # Runtime exception
        *hash<auto> result = repl.eval("throw 'TEST-ERROR', 'test exception'");
        assertTrue(exists result, "Should return result");
        assertTrue(exists result.error, "Should have error");
        assertEq("TEST-ERROR", result.error.err, "Should be TEST-ERROR");
        assertRegex("test exception", result.error.desc, "Should contain exception message");
    }

    #! Test result formatting for different types
    testResultFormatting() {
        # Integer
        assertEq("42", QoreRepl::formatValue(42), "Integer formatting");

        # Float
        assertRegex("3\\.14", QoreRepl::formatValue(3.14), "Float formatting");

        # String - returned as-is without quotes
        assertEq("hello", QoreRepl::formatValue("hello"), "String formatting");

        # Boolean
        assertEq("True", QoreRepl::formatValue(True), "Boolean True formatting");
        assertEq("False", QoreRepl::formatValue(False), "Boolean False formatting");

        # NOTHING
        assertEq("", QoreRepl::formatValue(NOTHING), "NOTHING formatting");

        # List - formatted with %Y
        string listFmt = QoreRepl::formatValue((1, 2, 3));
        assertRegex("1", listFmt, "List should contain 1");
        assertRegex("2", listFmt, "List should contain 2");

        # Hash - formatted with %Y
        string hashFmt = QoreRepl::formatValue({"a": 1, "b": 2});
        assertRegex("a", hashFmt, "Hash should contain key a");
        assertRegex("b", hashFmt, "Hash should contain key b");
    }

    #! Test state persistence across multiple evals
    testStatePersistence() {
        QoreRepl repl();

        # Define variable
        repl.eval("our int counter = 0");
        assertEq(0, repl.getProgram().getGlobalVariable("counter"), "Initial counter");

        # Modify in loop - use while loop for simplicity
        repl.eval("{ int i = 0; while (i < 5) { counter++; i++; } }");
        assertEq(5, repl.getProgram().getGlobalVariable("counter"), "Counter after loop");

        # Define and use function
        repl.eval("int sub getCounter() { return counter; }");
        repl.eval("our int val = getCounter()");
        assertEq(5, repl.getProgram().getGlobalVariable("val"), "Function should access variable");

        # Modify via function
        repl.eval("sub incCounter() { counter++; }");
        repl.eval("incCounter()");
        assertEq(6, repl.getProgram().getGlobalVariable("counter"), "Counter after incCounter");
    }

    #! Test that state persists across exceptions and program can continue after conditional throws
    testExceptionHandling() {
        Program pgm(PO_NEW_STYLE | PO_ALLOW_REPARSE, True);

        # Parse initial setup with conditional throw flag
        pgm.parse("our int x = 1; our bool doThrow = True;", "setup1");
        pgm.run();
        assertEq(1, pgm.getGlobalVariable("x"), "x should be 1");

        # Add a conditional throw statement that we can disable
        pgm.parse("if (doThrow) throw 'TEST', 'error';", "throws");
        try {
            pgm.run();
        } catch (hash<ExceptionInfo> ex) {
            assertEq("TEST", ex.err, "Should get TEST exception");
        }

        # Disable the throw and verify program is still usable
        pgm.setGlobalVarValue("doThrow", False);
        pgm.parse("our int y = 2;", "after");
        pgm.run();
        assertEq(2, pgm.getGlobalVariable("y"), "y should be 2 after recovery");
    }

    #! Test /load command with active threads
    testLoadWithActiveThreads() {
        QoreRepl repl();

        # Start a background thread
        repl.eval("our bool stop = False;");
        repl.eval("sub worker() { while (!stop) usleep(10ms); }");
        repl.eval("background worker();");

        # Wait for thread to start
        Program pgm = repl.getProgram();
        while (pgm.getThreadCount() == 0) usleep(10ms);
        assertTrue(pgm.getThreadCount() > 0, "Thread should be running");

        # Try to /load a file - should fail with helpful message
        *hash<auto> result = repl.eval("/load /nonexistent/file.q");
        assertTrue(exists result, "Should return result");
        assertTrue(exists result.error, "Should have error");
        assertEq("REPL-ERROR", result.error.err, "Should be REPL-ERROR");
        assertRegex("background threads", result.error.desc, "Should mention background threads");

        # Stop the thread
        repl.getProgram().setGlobalVarValue("stop", True);
        while (pgm.getThreadCount() > 0) usleep(10ms);
    }

    #! Test negative max_connections validation
    testMaxConnectionsValidation() {
        QoreReplWebSocketHandler handler();

        # Valid values should work
        handler.setMaxConnections(0);  # Unlimited
        assertEq(0, handler.getMaxConnections(), "0 should work (unlimited)");

        handler.setMaxConnections(10);
        assertEq(10, handler.getMaxConnections(), "Positive values should work");

        # Negative should throw
        bool caught = False;
        try {
            handler.setMaxConnections(-1);
        } catch (hash<ExceptionInfo> ex) {
            caught = True;
            assertEq("INVALID-ARGUMENT", ex.err, "Should get INVALID-ARGUMENT");
            assertRegex("non-negative", ex.desc, "Should mention non-negative");
        }
        assertTrue(caught, "Negative max_connections should throw");
    }

    #! Test behavior after parse failure
    /** Note: Parse failures in PO_ALLOW_REPARSE mode can roll back previously
        committed state. This test documents the current behavior. */
    testParseFailureBehavior() {
        QoreRepl repl();

        # Set up some state
        repl.eval("our int x = 42;");
        assertEq(42, repl.getProgram().getGlobalVariable("x"), "x should be 42");

        # Try a parse error - clearly invalid syntax
        *hash<auto> result = repl.eval("our int y = @invalid;");
        assertTrue(exists result.error, "Should have error");
        assertTrue(result.error.err =~ /PARSE/, "Should be a parse error");

        # Verify that x is still defined after parse failure
        # parseRollback now preserves previously committed state
        assertEq(42, repl.getProgram().getGlobalVariable("x"),
            "x should still be 42 after parse failure");

        # Can continue using the REPL after parse error
        result = repl.eval("our int z = x + 1;");
        assertFalse(exists result.error, "Should be able to continue after parse error");
        assertEq(43, repl.getProgram().getGlobalVariable("z"), "z should be 43");
    }

    #! Test that rollback preserves all types: variables, functions, classes, constants
    testRollbackPreservesAllTypes() {
        QoreRepl repl();

        # Define a global variable
        repl.eval("our int testVar = 100;");
        assertEq(100, repl.getProgram().getGlobalVariable("testVar"), "testVar should be 100");

        # Define a function (use 'sub' keyword for top-level functions)
        repl.eval("int sub addNumbers(int a, int b) { return a + b; }");
        repl.eval("our int funcResult = addNumbers(3, 7);");
        assertEq(10, repl.getProgram().getGlobalVariable("funcResult"), "funcResult should be 10");

        # Define a class (note: using block syntax for private section in REPL mode)
        repl.eval("class TestCounter { private { int n = 0; } int inc() { return ++n; } int get() { return n; } }");
        repl.eval("our TestCounter counter();");
        repl.eval("our int c1 = counter.inc();");
        assertEq(1, repl.getProgram().getGlobalVariable("c1"), "c1 should be 1");

        # Define a constant
        repl.eval("const MY_CONST = 42;");
        repl.eval("our int constVal = MY_CONST;");
        assertEq(42, repl.getProgram().getGlobalVariable("constVal"), "constVal should be 42");

        # Now cause a parse error
        *hash<auto> result = repl.eval("this is @#$ invalid syntax");
        assertTrue(exists result.error, "Should have parse error");

        # Verify all previously defined items still work
        assertEq(100, repl.getProgram().getGlobalVariable("testVar"), "testVar should still be 100 after rollback");

        # Function should still work
        repl.eval("our int funcResult2 = addNumbers(20, 30);");
        assertEq(50, repl.getProgram().getGlobalVariable("funcResult2"), "Function should still work after rollback");

        # Class instance should still work with preserved state
        repl.eval("our int c2 = counter.inc();");
        assertEq(2, repl.getProgram().getGlobalVariable("c2"), "Class instance should preserve state after rollback");

        # Constant should still be accessible
        repl.eval("our int constVal2 = MY_CONST + 1;");
        assertEq(43, repl.getProgram().getGlobalVariable("constVal2"), "Constant should still work after rollback");

        # Can define new items after rollback
        repl.eval("our string newVar = 'created after rollback';");
        assertEq("created after rollback", repl.getProgram().getGlobalVariable("newVar"), "Should be able to create new vars after rollback");
    }

    #! Test rollback with hashdecl definitions
    testRollbackPreservesHashdecl() {
        QoreRepl repl();

        # Define a hashdecl
        repl.eval("hashdecl MyRecord { int id; string name; }");
        repl.eval("our hash<MyRecord> rec = <MyRecord>{\"id\": 1, \"name\": \"test\"};");
        assertEq(1, repl.getProgram().getGlobalVariable("rec").id, "rec.id should be 1");
        assertEq("test", repl.getProgram().getGlobalVariable("rec").name, "rec.name should be 'test'");

        # Cause a parse error
        *hash<auto> result = repl.eval("invalid @#$ syntax here");
        assertTrue(exists result.error, "Should have parse error");

        # Hashdecl should still work after rollback
        repl.eval("our hash<MyRecord> rec2 = <MyRecord>{\"id\": 2, \"name\": \"after rollback\"};");
        assertEq(2, repl.getProgram().getGlobalVariable("rec2").id, "rec2.id should be 2");
        assertEq("after rollback", repl.getProgram().getGlobalVariable("rec2").name, "rec2.name should be correct");

        # Can create more hashdecls after rollback
        repl.eval("hashdecl MyRecord2 { int x; int y; }");
        repl.eval("our hash<MyRecord2> point = <MyRecord2>{\"x\": 10, \"y\": 20};");
        assertEq(10, repl.getProgram().getGlobalVariable("point").x, "point.x should be 10");
    }

    #! Test multiple consecutive rollbacks
    testMultipleConsecutiveRollbacks() {
        QoreRepl repl();

        # Initial setup
        repl.eval("our int a = 1;");
        repl.eval("our int b = 2;");
        repl.eval("our int c = 3;");

        # First rollback
        *hash<auto> result = repl.eval("bad @#$ syntax 1");
        assertTrue(exists result.error, "Should have error 1");

        # Verify state preserved
        assertEq(1, repl.getProgram().getGlobalVariable("a"), "a should be 1 after rollback 1");
        assertEq(2, repl.getProgram().getGlobalVariable("b"), "b should be 2 after rollback 1");
        assertEq(3, repl.getProgram().getGlobalVariable("c"), "c should be 3 after rollback 1");

        # Add more state
        repl.eval("our int d = 4;");

        # Second rollback
        result = repl.eval("bad @#$ syntax 2");
        assertTrue(exists result.error, "Should have error 2");

        # Verify all state preserved
        assertEq(1, repl.getProgram().getGlobalVariable("a"), "a should be 1 after rollback 2");
        assertEq(2, repl.getProgram().getGlobalVariable("b"), "b should be 2 after rollback 2");
        assertEq(3, repl.getProgram().getGlobalVariable("c"), "c should be 3 after rollback 2");
        assertEq(4, repl.getProgram().getGlobalVariable("d"), "d should be 4 after rollback 2");

        # Third rollback
        result = repl.eval("bad @#$ syntax 3");
        assertTrue(exists result.error, "Should have error 3");

        # All state should still be preserved
        assertEq(1, repl.getProgram().getGlobalVariable("a"), "a should be 1 after rollback 3");
        assertEq(4, repl.getProgram().getGlobalVariable("d"), "d should be 4 after rollback 3");

        # Can still add more state
        repl.eval("our int e = a + b + c + d;");
        assertEq(10, repl.getProgram().getGlobalVariable("e"), "e should be 10");
    }

    #! Test repeated rollback cycles for memory stability
    testRepeatedRollbackCycles() {
        QoreRepl repl();

        # Setup initial state
        repl.eval("our int counter = 0;");
        repl.eval("sub increment() { counter++; }");

        # Run many rollback cycles
        int cycles = 50;
        for (int i = 0; i < cycles; i++) {
            # Successful operation
            repl.eval("increment();");

            # Failed parse (triggers rollback)
            *hash<auto> result = repl.eval("invalid @#$ " + string(i));
            assertTrue(exists result.error, sprintf("Should have error in cycle %d", i));
        }

        # Counter should have been incremented 'cycles' times
        assertEq(cycles, repl.getProgram().getGlobalVariable("counter"),
            sprintf("counter should be %d after %d cycles", cycles, cycles));

        # Function should still work
        repl.eval("increment();");
        assertEq(cycles + 1, repl.getProgram().getGlobalVariable("counter"),
            "counter should be incremented after cycles");
    }

    #! Test rollback when error occurs mid-parse with multiple declarations
    testPartialParseRollback() {
        QoreRepl repl();

        # Setup
        repl.eval("our int existing = 100;");
        assertEq(100, repl.getProgram().getGlobalVariable("existing"), "existing should be 100");

        # Try to parse code with error in the middle
        # The first declaration might be parsed before the error is detected
        *hash<auto> result = repl.eval("our int newVar1 = 1; our int badVar = @invalid; our int newVar2 = 2;");
        assertTrue(exists result.error, "Should have parse error");

        # Original variable should be preserved
        assertEq(100, repl.getProgram().getGlobalVariable("existing"), "existing should still be 100");

        # newVar1 should NOT exist (rollback should remove pending items)
        auto val = repl.getProgram().getGlobalVariable("newVar1");
        assertTrue(val === NOTHING, "newVar1 should not exist after rollback");

        # Can continue normally
        repl.eval("our int afterError = existing + 50;");
        assertEq(150, repl.getProgram().getGlobalVariable("afterError"), "afterError should be 150");
    }

    #! Test rollback preserves functions
    /** Note: Function overloading across separate parse cycles is not supported in REPL mode.
        This test verifies that existing functions survive rollback. */
    testRollbackPreservesFunctionVariants() {
        QoreRepl repl();

        # Define several different functions (use 'sub' keyword)
        repl.eval("string sub describeInt(int n) { return sprintf('int: %d', n); }");
        repl.eval("our string r1 = describeInt(42);");
        assertEq("int: 42", repl.getProgram().getGlobalVariable("r1"), "r1 should be 'int: 42'");

        repl.eval("string sub describeStr(string s) { return sprintf('string: %s', s); }");
        repl.eval("our string r2 = describeStr('hello');");
        assertEq("string: hello", repl.getProgram().getGlobalVariable("r2"), "r2 should be 'string: hello'");

        repl.eval("string sub describeBoth(int n, string s) { return sprintf('%d-%s', n, s); }");
        repl.eval("our string r3 = describeBoth(99, 'test');");
        assertEq("99-test", repl.getProgram().getGlobalVariable("r3"), "r3 should be '99-test'");

        # Cause rollback
        *hash<auto> result = repl.eval("invalid @#$ syntax");
        assertTrue(exists result.error, "Should have error");

        # All functions should still work after rollback
        repl.eval("our string r4 = describeInt(100);");
        assertEq("int: 100", repl.getProgram().getGlobalVariable("r4"), "describeInt should still work");

        repl.eval("our string r5 = describeStr('world');");
        assertEq("string: world", repl.getProgram().getGlobalVariable("r5"), "describeStr should still work");

        repl.eval("our string r6 = describeBoth(1, 'abc');");
        assertEq("1-abc", repl.getProgram().getGlobalVariable("r6"), "describeBoth should still work");

        # Can define new functions after rollback
        repl.eval("float sub multiply(float a, float b) { return a * b; }");
        repl.eval("our float r7 = multiply(3.0, 4.0);");
        assertEq(12.0, repl.getProgram().getGlobalVariable("r7"), "New function should work after rollback");
    }

    #! Test rollback with class inheritance
    testRollbackPreservesClassHierarchy() {
        QoreRepl repl();

        # Define base class
        repl.eval("class Animal { string speak() { return 'generic sound'; } }");

        # Define derived class
        repl.eval("class Dog inherits Animal { string speak() { return 'woof'; } }");
        repl.eval("class Cat inherits Animal { string speak() { return 'meow'; } }");

        # Create instances
        repl.eval("our Animal a();");
        repl.eval("our Dog d();");
        repl.eval("our Cat c();");

        # Verify they work
        repl.eval("our string s1 = a.speak();");
        repl.eval("our string s2 = d.speak();");
        repl.eval("our string s3 = c.speak();");
        assertEq("generic sound", repl.getProgram().getGlobalVariable("s1"), "Animal should speak");
        assertEq("woof", repl.getProgram().getGlobalVariable("s2"), "Dog should woof");
        assertEq("meow", repl.getProgram().getGlobalVariable("s3"), "Cat should meow");

        # Cause rollback
        *hash<auto> result = repl.eval("invalid @#$ syntax");
        assertTrue(exists result.error, "Should have error");

        # All classes should still work
        repl.eval("our string s4 = d.speak();");
        assertEq("woof", repl.getProgram().getGlobalVariable("s4"), "Dog should still woof after rollback");

        # Can create new instances
        repl.eval("our Cat c2();");
        repl.eval("our string s5 = c2.speak();");
        assertEq("meow", repl.getProgram().getGlobalVariable("s5"), "New Cat instance should work");

        # Can add new derived class
        repl.eval("class Bird inherits Animal { string speak() { return 'chirp'; } }");
        repl.eval("our Bird b();");
        repl.eval("our string s6 = b.speak();");
        assertEq("chirp", repl.getProgram().getGlobalVariable("s6"), "Bird should chirp");
    }

    #! Test rollback with closures and references
    testRollbackPreservesClosures() {
        QoreRepl repl();

        # Create a closure factory (use 'sub' keyword)
        repl.eval("code sub makeCounter(int start) { int n = start; return int sub() { return n++; }; }");

        # Create a counter
        repl.eval("our code counter1 = makeCounter(10);");
        repl.eval("our int v1 = counter1();");
        repl.eval("our int v2 = counter1();");
        assertEq(10, repl.getProgram().getGlobalVariable("v1"), "v1 should be 10");
        assertEq(11, repl.getProgram().getGlobalVariable("v2"), "v2 should be 11");

        # Cause rollback
        *hash<auto> result = repl.eval("invalid @#$ syntax");
        assertTrue(exists result.error, "Should have error");

        # Counter should still work and preserve its state
        repl.eval("our int v3 = counter1();");
        assertEq(12, repl.getProgram().getGlobalVariable("v3"), "Counter should preserve state after rollback");

        # Can create new counters
        repl.eval("our code counter2 = makeCounter(100);");
        repl.eval("our int v4 = counter2();");
        assertEq(100, repl.getProgram().getGlobalVariable("v4"), "New counter should work");
    }

    #! Stress test with many types and operations
    testRollbackStressTest() {
        QoreRepl repl();

        # Create many variables
        for (int i = 0; i < 20; i++) {
            repl.eval(sprintf("our int var%d = %d;", i, i * 10));
        }

        # Create several functions (use 'sub' keyword)
        for (int i = 0; i < 5; i++) {
            repl.eval(sprintf("int sub func%d(int x) { return x + %d; }", i, i));
        }

        # Create several classes (use public block for member declaration in REPL mode)
        for (int i = 0; i < 5; i++) {
            repl.eval(sprintf("class Class%d { public { int val = %d; } int getVal() { return val; } }", i, i * 100));
        }

        # Run multiple rollback cycles
        for (int cycle = 0; cycle < 10; cycle++) {
            # Verify some random items still work
            repl.eval("our int checkVar = var5 + var10;");
            assertEq(150, repl.getProgram().getGlobalVariable("checkVar"),
                sprintf("Variables should work in cycle %d", cycle));

            repl.eval("our int checkFunc = func2(100);");
            assertEq(102, repl.getProgram().getGlobalVariable("checkFunc"),
                sprintf("Functions should work in cycle %d", cycle));

            repl.eval("our Class3 checkObj();");
            repl.eval("our int checkClass = checkObj.getVal();");
            assertEq(300, repl.getProgram().getGlobalVariable("checkClass"),
                sprintf("Classes should work in cycle %d", cycle));

            # Cause a rollback
            *hash<auto> result = repl.eval(sprintf("syntax error @#$ cycle %d", cycle));
            assertTrue(exists result.error, sprintf("Should have error in cycle %d", cycle));
        }

        # Final verification - everything should still work
        assertEq(0, repl.getProgram().getGlobalVariable("var0"), "var0 should be 0");
        assertEq(190, repl.getProgram().getGlobalVariable("var19"), "var19 should be 190");

        repl.eval("our int finalFunc = func4(1000);");
        assertEq(1004, repl.getProgram().getGlobalVariable("finalFunc"), "func4 should still work");

        repl.eval("our Class0 finalObj();");
        repl.eval("our int finalClass = finalObj.getVal();");
        assertEq(0, repl.getProgram().getGlobalVariable("finalClass"), "Class0 should still work");
    }

    #! Test calculateIndentLevel basic cases
    testCalculateIndentLevelBasic() {
        # Open if block -> indent 1
        assertEq(1, QoreCodeFormat::CodeFormatter::calculateIndentLevel("if (True) {"),
            "open if block should be indent 1");

        # Open class body -> indent 1
        assertEq(1, QoreCodeFormat::CodeFormatter::calculateIndentLevel("class Foo {"),
            "open class body should be indent 1");

        # Open enum -> indent 1
        assertEq(1, QoreCodeFormat::CodeFormatter::calculateIndentLevel("enum Color {"),
            "open enum should be indent 1");

        # Hash literal -> indent 1
        assertEq(1, QoreCodeFormat::CodeFormatter::calculateIndentLevel("hash<auto> h = {"),
            "open hash literal should be indent 1");

        # Complete expression -> indent 0
        assertEq(0, QoreCodeFormat::CodeFormatter::calculateIndentLevel("1 + 1"),
            "complete expression should be indent 0");

        # Empty string -> indent 0
        assertEq(0, QoreCodeFormat::CodeFormatter::calculateIndentLevel(""),
            "empty string should be indent 0");
    }

    #! Test calculateIndentLevel namespace exclusion
    testCalculateIndentLevelNamespace() {
        # Namespace body should NOT create indent (Qore convention: left-justified)
        assertEq(0, QoreCodeFormat::CodeFormatter::calculateIndentLevel("namespace Foo {"),
            "namespace should be indent 0");

        # Namespace with nested class should only indent for class
        assertEq(1, QoreCodeFormat::CodeFormatter::calculateIndentLevel("namespace Foo {\nclass Bar {"),
            "namespace + class should be indent 1");
    }

    #! Test calculateIndentLevel switch/case handling
    testCalculateIndentLevelSwitch() {
        # Switch body -> indent 1
        assertEq(1, QoreCodeFormat::CodeFormatter::calculateIndentLevel("switch (x) {"),
            "switch body should be indent 1");

        # Switch + case -> indent 2 (switch body + case body)
        assertEq(2, QoreCodeFormat::CodeFormatter::calculateIndentLevel("switch (x) {\n    case 1:"),
            "switch + case should be indent 2");

        # Switch + default -> indent 2
        assertEq(2, QoreCodeFormat::CodeFormatter::calculateIndentLevel("switch (x) {\n    default:"),
            "switch + default should be indent 2");
    }

    #! Test calculateIndentLevel with nested and closed blocks
    testCalculateIndentLevelNested() {
        # Closed block -> indent 0
        assertEq(0, QoreCodeFormat::CodeFormatter::calculateIndentLevel("if (True) {\n}"),
            "closed block should be indent 0");

        # Nested open blocks -> indent 2
        assertEq(2, QoreCodeFormat::CodeFormatter::calculateIndentLevel("if (True) {\n    if (True) {"),
            "nested open blocks should be indent 2");

        # Inner closed, outer open -> indent 1
        assertEq(1, QoreCodeFormat::CodeFormatter::calculateIndentLevel("if (True) {\n    if (True) {\n    }"),
            "inner closed outer open should be indent 1");

        # Both closed -> indent 0
        assertEq(0, QoreCodeFormat::CodeFormatter::calculateIndentLevel("if (True) {\n    if (True) {\n    }\n}"),
            "both closed should be indent 0");

        # Class with method -> indent 2
        assertEq(2, QoreCodeFormat::CodeFormatter::calculateIndentLevel("class Foo {\n    int getX() {"),
            "class + method body should be indent 2");
    }

    #! Test calculateIndentLevelFallback directly
    testCalculateIndentLevelFallback() {
        # Simple brace counting
        assertEq(1, QoreCodeFormat::CodeFormatter::calculateIndentLevelFallback("{"),
            "single open brace");
        assertEq(2, QoreCodeFormat::CodeFormatter::calculateIndentLevelFallback("{{"),
            "double open brace");
        assertEq(0, QoreCodeFormat::CodeFormatter::calculateIndentLevelFallback("{}"),
            "balanced braces");
        assertEq(0, QoreCodeFormat::CodeFormatter::calculateIndentLevelFallback(""),
            "empty string");

        # Braces inside strings should not be counted
        assertEq(0, QoreCodeFormat::CodeFormatter::calculateIndentLevelFallback("string s = \"{\""),
            "brace in double-quoted string");
        assertEq(0, QoreCodeFormat::CodeFormatter::calculateIndentLevelFallback("string s = '{'"),
            "brace in single-quoted string");

        # Braces in comments should not be counted
        assertEq(0, QoreCodeFormat::CodeFormatter::calculateIndentLevelFallback("# {"),
            "brace in line comment");
        assertEq(0, QoreCodeFormat::CodeFormatter::calculateIndentLevelFallback("/* { */"),
            "brace in block comment");

        # Negative depth clamps to 0
        assertEq(0, QoreCodeFormat::CodeFormatter::calculateIndentLevelFallback("}"),
            "extra close brace clamps to 0");
    }

    #! Test QoreRepl.getIndentLevel() integration
    testGetIndentLevel() {
        QoreRepl repl();

        # Initially indent level should be 0
        assertEq(0, repl.getIndentLevel(), "initial indent level should be 0");

        # Start a block -> indent 1
        *hash<auto> result = repl.eval("if (True) {");
        assertFalse(exists result, "should need more input");
        assertEq(1, repl.getIndentLevel(), "after open block, indent should be 1");

        # Nested block -> indent 2
        result = repl.eval("    if (True) {");
        assertFalse(exists result, "should still need more input");
        assertEq(2, repl.getIndentLevel(), "after nested block, indent should be 2");

        # Close inner block -> indent 1
        result = repl.eval("    }");
        assertFalse(exists result, "outer block still open");
        assertEq(1, repl.getIndentLevel(), "after closing inner, indent should be 1");

        # Close outer block -> completes, indent resets to 0
        result = repl.eval("}");
        assertTrue(exists result, "should complete");
        assertEq(0, repl.getIndentLevel(), "after completing, indent should be 0");

        # Test reset clears indent level
        repl.eval("class Foo {");
        assertEq(1, repl.getIndentLevel(), "class body indent should be 1");
        repl.reset();
        assertEq(0, repl.getIndentLevel(), "reset should clear indent level");

        # Test class with method
        repl.eval("class Foo {");
        assertEq(1, repl.getIndentLevel(), "class body indent");
        repl.eval("    int getX() {");
        assertEq(2, repl.getIndentLevel(), "class + method body indent");
        repl.eval("        return 1;");
        assertEq(2, repl.getIndentLevel(), "still in method body");
        repl.eval("    }");
        assertEq(1, repl.getIndentLevel(), "back to class body");
        result = repl.eval("}");
        assertTrue(exists result, "class complete");
        assertEq(0, repl.getIndentLevel(), "class done");
    }

    #! Test command completion functionality
    testCommandCompletion() {
        QoreRepl repl();

        # Test completion for /h - should match /help and /history
        softlist<string> completions = repl.getCompletions("/h");
        assertTrue(completions.size() >= 2, "Should have at least 2 completions for /h");
        assertTrue(inlist("/help", completions), "/help should be in completions");
        assertTrue(inlist("/history", completions), "/history should be in completions");

        # Test completion for /qu - should match /quit
        completions = repl.getCompletions("/qu");
        assertTrue(inlist("/quit", completions), "/quit should be in completions");

        # Test completion for /var - should match /vars
        completions = repl.getCompletions("/var");
        assertTrue(inlist("/vars", completions), "/vars should be in completions");

        # Test completion for /func - should match /functions and /funcs
        completions = repl.getCompletions("/func");
        assertTrue(completions.size() >= 2, "Should have at least 2 completions for /func");
        assertTrue(inlist("/functions", completions), "/functions should be in completions");
        assertTrue(inlist("/funcs", completions), "/funcs should be in completions");

        # Test completion for /cl - should match /clear and /classes
        completions = repl.getCompletions("/cl");
        assertTrue(inlist("/clear", completions), "/clear should be in completions");
        assertTrue(inlist("/classes", completions), "/classes should be in completions");

        # Test completion for non-command (doesn't start with /) - should return empty
        completions = repl.getCompletions("1 + 1");
        assertEq(0, completions.size(), "Non-command should have no completions");

        # Test completion for unknown command prefix - should return empty
        completions = repl.getCompletions("/xyz");
        assertEq(0, completions.size(), "Unknown command prefix should have no completions");

        # Test exact match - /help
        completions = repl.getCompletions("/help");
        assertTrue(inlist("/help", completions), "/help should match itself");

        # Test case-insensitive completion (matches command execution behavior)
        completions = repl.getCompletions("/H");
        assertTrue(inlist("/help", completions), "/H should match /help (case-insensitive)");
        assertTrue(inlist("/history", completions), "/H should match /history (case-insensitive)");

        completions = repl.getCompletions("/HELP");
        assertTrue(inlist("/help", completions), "/HELP should match /help (case-insensitive)");

        completions = repl.getCompletions("/Desc");
        assertTrue(inlist("/describe", completions), "/Desc should match /describe (case-insensitive)");

        # Command with argument: /describe M should return identifier completions
        completions = repl.getCompletions("/describe M");
        assertTrue(completions.size() > 0, "'/describe M' should return argument completions");
        bool has_mutex = False;
        foreach string c in (completions) {
            if (c =~ /Mutex/) {
                has_mutex = True;
                break;
            }
        }
        assertTrue(has_mutex, "'/describe M' should include 'Mutex' in argument completions");
    }

    #! Test history file path initialization
    testHistoryFilePath() {
        # Test with explicit history_file option
        string temp_history = tmp_location() + "/test_repl_history_" + string(getpid());
        QoreRepl repl({"history_file": temp_history});
        # Note: We can't directly verify the history_file member since it's private,
        # but we test that the option is accepted without error
        assertTrue(True, "REPL with explicit history_file should create successfully");

        # Test with sandboxed mode (no filesystem) - history should be disabled
        QoreRepl sandboxed_repl({"parse_options": PO_NEW_STYLE | PO_NO_FILESYSTEM});
        # Should not fail even though filesystem is restricted
        assertTrue(True, "Sandboxed REPL should create successfully without history file");

        # Test default REPL (no options) - should use default history file
        QoreRepl default_repl();
        assertTrue(True, "Default REPL should create successfully with default history");
    }

    #! Test completion context extraction
    testContextExtraction() {
        QoreRepl repl();

        # Empty input -> CC_NONE
        hash<auto> ctx = repl.extractCompletionContext("");
        assertEq(0, ctx.kind, "empty input should be CC_NONE");

        # Whitespace only -> CC_NONE
        ctx = repl.extractCompletionContext("   ");
        assertEq(0, ctx.kind, "whitespace should be CC_NONE");

        # Command
        ctx = repl.extractCompletionContext("/he");
        assertEq(5, ctx.kind, "'/he' should be CC_COMMAND");
        assertEq("/he", ctx.prefix, "command prefix should be '/he'");

        # Bare identifier
        ctx = repl.extractCompletionContext("pri");
        assertEq(1, ctx.kind, "'pri' should be CC_IDENTIFIER");
        assertEq("pri", ctx.prefix, "prefix should be 'pri'");
        assertEq("", ctx.line_before, "line_before should be empty");

        # Identifier with code before
        ctx = repl.extractCompletionContext("int x = my");
        assertEq(1, ctx.kind, "'int x = my' should be CC_IDENTIFIER");
        assertEq("my", ctx.prefix, "prefix should be 'my'");
        assertEq("int x = ", ctx.line_before, "line_before should be 'int x = '");

        # New with prefix
        ctx = repl.extractCompletionContext("new My");
        assertEq(2, ctx.kind, "'new My' should be CC_NEW");
        assertEq("My", ctx.prefix, "prefix should be 'My'");

        # New without prefix
        ctx = repl.extractCompletionContext("new ");
        assertEq(2, ctx.kind, "'new ' should be CC_NEW");
        assertEq("", ctx.prefix, "prefix should be empty for 'new '");

        # Dot with prefix
        ctx = repl.extractCompletionContext("obj.get");
        assertEq(3, ctx.kind, "'obj.get' should be CC_DOT");
        assertEq("obj", ctx.target, "target should be 'obj'");
        assertEq("get", ctx.prefix, "prefix should be 'get'");

        # Dot without prefix
        ctx = repl.extractCompletionContext("obj.");
        assertEq(3, ctx.kind, "'obj.' should be CC_DOT");
        assertEq("obj", ctx.target, "target should be 'obj'");
        assertEq("", ctx.prefix, "prefix should be empty for 'obj.'");

        # Scope with prefix
        ctx = repl.extractCompletionContext("Qore::Thread::M");
        assertEq(4, ctx.kind, "'Qore::Thread::M' should be CC_SCOPE");
        assertEq("Qore::Thread", ctx.target, "target should be 'Qore::Thread'");
        assertEq("M", ctx.prefix, "prefix should be 'M'");

        # Scope without prefix
        ctx = repl.extractCompletionContext("Mutex::");
        assertEq(4, ctx.kind, "'Mutex::' should be CC_SCOPE");
        assertEq("Mutex", ctx.target, "target should be 'Mutex'");
        assertEq("", ctx.prefix, "prefix should be empty for 'Mutex::'");

        # Command with argument: /describe M should be CC_IDENTIFIER (not CC_COMMAND)
        ctx = repl.extractCompletionContext("/describe M");
        assertEq(1, ctx.kind, "'/describe M' should be CC_IDENTIFIER for argument");
        assertEq("M", ctx.prefix, "prefix should be 'M' for '/describe M'");

        # Command without argument: /desc should still be CC_COMMAND
        ctx = repl.extractCompletionContext("/desc");
        assertEq(5, ctx.kind, "'/desc' should be CC_COMMAND");
    }

    #! Test identifier completion
    testIdentifierCompletion() {
        QoreRepl repl();

        # Keywords: "for" should include "foreach" and "for"
        softlist<string> completions = repl.getCompletions("for");
        assertTrue(inlist("foreach", completions), "'for' should complete to 'foreach'");
        assertTrue(inlist("for", completions), "'for' should complete to 'for'");

        # Built-in functions: "prin" should include "printf"
        completions = repl.getCompletions("prin");
        bool has_printf = False;
        foreach string c in (completions) {
            if (c =~ /printf/) {
                has_printf = True;
                break;
            }
        }
        assertTrue(has_printf, "'prin' should include a printf match");

        # User function: after defining myFunc, "myF" should include "myFunc"
        repl.eval("sub myFunc() { return 42; }");
        completions = repl.getCompletions("myF");
        bool has_myFunc = False;
        foreach string c in (completions) {
            if (c =~ /myFunc/) {
                has_myFunc = True;
                break;
            }
        }
        assertTrue(has_myFunc, "'myF' should include 'myFunc'");

        # User class: after defining Foo, "Fo" should include "Foo"
        repl.eval("class Foo { public { int val; } }");
        completions = repl.getCompletions("Fo");
        bool has_Foo = False;
        foreach string c in (completions) {
            if (c =~ /Foo/) {
                has_Foo = True;
                break;
            }
        }
        assertTrue(has_Foo, "'Fo' should include 'Foo'");

        # Global variable: after defining myVar, "myV" should include "myVar"
        repl.eval("our int myVar = 1;");
        completions = repl.getCompletions("myV");
        bool has_myVar = False;
        foreach string c in (completions) {
            if (c =~ /myVar/) {
                has_myVar = True;
                break;
            }
        }
        assertTrue(has_myVar, "'myV' should include 'myVar'");

        # No match: "xyz_nothing" should be empty
        completions = repl.getCompletions("xyz_nothing");
        assertEq(0, completions.size(), "'xyz_nothing' should have no completions");

        # Full-line: "int x = pri" should include "int x = printf"
        completions = repl.getCompletions("int x = prin");
        bool has_fullline_printf = False;
        foreach string c in (completions) {
            if (c =~ /^int x = .*printf/) {
                has_fullline_printf = True;
                break;
            }
        }
        assertTrue(has_fullline_printf, "'int x = prin' should include full-line printf match");
    }

    #! Test "new" completion
    testNewCompletion() {
        QoreRepl repl();

        # "new Mut" should include "new Mutex"
        softlist<string> completions = repl.getCompletions("new Mut");
        bool has_mutex = False;
        foreach string c in (completions) {
            if (c =~ /new Mutex/) {
                has_mutex = True;
                break;
            }
        }
        assertTrue(has_mutex, "'new Mut' should include 'new Mutex'");

        # "new " with empty prefix should return classes
        completions = repl.getCompletions("new ");
        assertTrue(completions.size() > 0, "'new ' should return available classes");
    }

    #! Test dot-completion
    testDotCompletion() {
        QoreRepl repl();

        # Create a Mutex instance as a global variable
        repl.eval("our Mutex m();");

        # "m." should include method completions
        softlist<string> completions = repl.getCompletions("m.");
        assertTrue(completions.size() > 0, "'m.' should return method completions for Mutex");
        bool has_lock = False;
        foreach string c in (completions) {
            if (c =~ /lock/) {
                has_lock = True;
                break;
            }
        }
        assertTrue(has_lock, "'m.' should include 'lock(' method");

        # "m.lo" should filter to lock-related methods
        completions = repl.getCompletions("m.lo");
        assertTrue(completions.size() > 0, "'m.lo' should return filtered completions");

        # Unknown variable should return empty
        completions = repl.getCompletions("unknown_var.");
        assertEq(0, completions.size(), "unknown variable dot-completion should be empty");
    }

    #! Test scope completion
    testScopeCompletion() {
        QoreRepl repl();

        # "Qore::" should include Qore namespace members
        softlist<string> completions = repl.getCompletions("Qore::");
        assertTrue(completions.size() > 0, "'Qore::' should return namespace members");

        # Define an enum and test "Color::"
        repl.eval("enum Color { Red = 0, Green = 1, Blue = 2 }");
        completions = repl.getCompletions("Color::");
        bool has_red = False;
        bool has_green = False;
        foreach string c in (completions) {
            if (c =~ /Red/) {
                has_red = True;
            }
            if (c =~ /Green/) {
                has_green = True;
            }
        }
        assertTrue(has_red, "'Color::' should include 'Red'");
        assertTrue(has_green, "'Color::' should include 'Green'");

        # "Color::R" should filter to Red
        completions = repl.getCompletions("Color::R");
        has_red = False;
        foreach string c in (completions) {
            if (c =~ /Red/) {
                has_red = True;
                break;
            }
        }
        assertTrue(has_red, "'Color::R' should include 'Red'");
    }

    #! Test completion edge cases
    testCompletionEdgeCases() {
        QoreRepl repl();

        # Internal names (__repl_expr_*) should be excluded
        repl.eval("1 + 1");  # Creates __repl_expr_1__
        softlist<string> completions = repl.getCompletions("__repl");
        assertEq(0, completions.size(), "internal __repl_expr names should be excluded");

        # Completion after /reset should work (empty program)
        repl.eval("/reset");
        completions = repl.getCompletions("for");
        assertTrue(completions.size() > 0, "completion should work after /reset");
        assertTrue(inlist("foreach", completions), "'for' should still complete to 'foreach' after reset");

        # Short prefix (1 char) should not include keywords (noise reduction)
        completions = repl.getCompletions("i");
        # Should have classes/functions matching 'i' but NOT keywords
        bool has_if_keyword = inlist("if", completions);
        assertFalse(has_if_keyword, "1-char prefix should not include keywords");

        # 2-char prefix should include keywords
        completions = repl.getCompletions("if");
        assertTrue(inlist("if", completions), "2-char prefix should include keywords");
    }

    #! Test case-sensitive completion matching
    testCompletionCaseSensitivity() {
        QoreRepl repl();

        # "new M" should only return classes starting with uppercase M
        softlist<string> completions = repl.getCompletions("new M");
        foreach string c in (completions) {
            # Each completion should be "new <ClassName>" where ClassName starts with M
            string suffix = c.substr(4);  # Remove "new " prefix
            assertTrue(suffix[0] == "M",
                sprintf("'new M' completion '%s' should start with uppercase M", c));
        }
        assertTrue(completions.size() > 0, "'new M' should return at least one class");

        # "new m" should not match Mutex (uppercase)
        completions = repl.getCompletions("new m");
        bool has_Mutex = False;
        foreach string c in (completions) {
            if (c =~ /Mutex/) {
                has_Mutex = True;
                break;
            }
        }
        assertFalse(has_Mutex, "'new m' should NOT match 'Mutex' (case-sensitive)");

        # "Prin" should not match "printf" (lowercase)
        completions = repl.getCompletions("Prin");
        bool has_printf = False;
        foreach string c in (completions) {
            if (c =~ /^printf$/) {
                has_printf = True;
                break;
            }
        }
        assertFalse(has_printf, "'Prin' should NOT match 'printf' (case-sensitive)");

        # "prin" should match "printf" (same case)
        completions = repl.getCompletions("prin");
        has_printf = False;
        foreach string c in (completions) {
            if (c =~ /printf/) {
                has_printf = True;
                break;
            }
        }
        assertTrue(has_printf, "'prin' should match 'printf' (same case)");

        # REPL commands should remain case-insensitive: "/H" matches "/help"
        completions = repl.getCompletions("/H");
        bool has_help = False;
        foreach string c in (completions) {
            if (c =~ /help/) {
                has_help = True;
                break;
            }
        }
        assertTrue(has_help, "REPL commands should be case-insensitive: '/H' matches '/help'");

        # Scope completion: "Color::r" should NOT match "Red" (different case)
        repl.eval("enum Color { Red = 0, Green = 1, Blue = 2 }");
        completions = repl.getCompletions("Color::r");
        bool has_Red = False;
        foreach string c in (completions) {
            if (c =~ /Red/) {
                has_Red = True;
                break;
            }
        }
        assertFalse(has_Red, "'Color::r' should NOT match 'Red' (case-sensitive)");

        # "Color::R" should match "Red"
        completions = repl.getCompletions("Color::R");
        has_Red = False;
        foreach string c in (completions) {
            if (c =~ /Red/) {
                has_Red = True;
                break;
            }
        }
        assertTrue(has_Red, "'Color::R' should match 'Red' (same case)");
    }

    #! Test word-level completion for linenoise (computeWordStart + stripping)
    testLinenoiseWordLevel() {
        QoreRepl repl();

        # computeWordStart: break chars " =+-/\\*?\"'`&<>:;|@{([])}";
        # "new M" → word starts at 4 (after space)
        assertEq(4, QoreRepl::computeWordStart("new M"));
        # "m.get" → no break chars, word starts at 0
        assertEq(0, QoreRepl::computeWordStart("m.get"));
        # "Qore::M" → : is a break char, word starts at 6 (after second :)
        assertEq(6, QoreRepl::computeWordStart("Qore::M"));
        # "/h" → / is a break char, word starts at 1
        assertEq(1, QoreRepl::computeWordStart("/h"));
        # "int x = prin" → space before 'p', word starts at 8
        assertEq(8, QoreRepl::computeWordStart("int x = prin"));
        # "" → word starts at 0
        assertEq(0, QoreRepl::computeWordStart(""));
        # "M" → word starts at 0 (no break chars)
        assertEq(0, QoreRepl::computeWordStart("M"));
        # "HTTP2Mode::" → : is a break char, word starts at 11
        assertEq(11, QoreRepl::computeWordStart("HTTP2Mode::"));
        # "HTTP2Mode::A" → word starts at 11
        assertEq(11, QoreRepl::computeWordStart("HTTP2Mode::A"));

        # getCompletions returns full-line results (for programmatic callers)
        softlist<string> full = repl.getCompletions("new Mut");
        bool has_full_mutex = False;
        foreach string c in (full) {
            if (c == "new Mutex(") {
                has_full_mutex = True;
                break;
            }
        }
        assertTrue(has_full_mutex, "getCompletions('new Mut') should return 'new Mutex'");

        # getCompletions returns only classes for "new" context
        foreach string c in (full) {
            assertTrue(c.startsWith("new "), sprintf("new context completion '%s' should start with 'new '", c));
        }
    }

    #! Test getCompletionDetails returns structured items
    testGetCompletionDetails() {
        QoreRepl repl();

        # Identifier details
        list<hash<CompletionItem>> items = repl.getCompletionDetails("prin");
        assertTrue(items.size() > 0, "'prin' should return completion details");
        # Check structure of first item
        hash<CompletionItem> first = items[0];
        assertTrue(exists first.label, "item should have label");
        assertTrue(exists first.kind, "item should have kind");

        # Command details - /h matches /help and /history
        items = repl.getCompletionDetails("/h");
        assertTrue(items.size() >= 2, "'/h' should return at least 2 command items");
        bool found_help = False;
        foreach hash<CompletionItem> item in (items) {
            if (item.label == "/help") {
                found_help = True;
                assertEq("keyword", item.kind, "/help kind should be 'keyword'");
            }
        }
        assertTrue(found_help, "should find /help in command details");

        # New details
        items = repl.getCompletionDetails("new Mut");
        assertTrue(items.size() > 0, "'new Mut' should return class details");
        bool found_mutex = False;
        foreach hash<CompletionItem> item in (items) {
            if (item.label == "Mutex") {
                found_mutex = True;
                assertEq("class", item.kind, "Mutex kind should be 'class'");
                assertTrue(item.isCallable, "Mutex should be callable (constructor)");
            }
        }
        assertTrue(found_mutex, "should find Mutex in new details");

        # Scope details
        items = repl.getCompletionDetails("Qore::");
        assertTrue(items.size() > 0, "'Qore::' should return scope details");

        # Dot details with Mutex global
        repl.eval("our Mutex m();");
        items = repl.getCompletionDetails("m.");
        assertTrue(items.size() > 0, "'m.' should return dot details");
        bool found_method = False;
        foreach hash<CompletionItem> item in (items) {
            if (item.kind == "method") {
                found_method = True;
                assertTrue(item.isCallable, "methods should be callable");
                break;
            }
        }
        assertTrue(found_method, "should find methods in dot details");
    }

    #! Test WebSocket completion integration
    testWebSocketCompletion() {
        # Test via action session
        QoreReplActionSession session();
        list<hash<auto>> events = session.handleAction("repl-complete", {
            "input": "prin",
            "id": "test-1",
        });
        assertEq(1, events.size(), "should return 1 event");
        assertEq("repl-completion", events[0].event, "event should be repl-completion");
        assertEq("test-1", events[0].data.request_id, "request_id should be preserved");
        assertTrue(events[0].data.items.size() > 0, "should have completion items");

        # Test missing input parameter
        bool caught = False;
        try {
            session.handleAction("repl-complete", {});
        } catch (hash<ExceptionInfo> ex) {
            caught = True;
            assertEq("MISSING-PARAMETER", ex.err, "should get MISSING-PARAMETER");
        }
        assertTrue(caught, "missing input should throw");
    }

    #! Test run() integration via subprocess
    testRunIntegration() {
        # Create a simple REPL script that evaluates some commands and exits
        string script = "%modern
%requires QoreRepl
# Use stdin/stdout for a simple test
QoreRepl repl({'history_file': NOTHING});

# Simulate input - we can't use run() directly in test because it reads stdin
# Instead, test that run() method exists and basic REPL works
*hash<auto> result = repl.eval('1 + 1');
if (result.value != 2) {
    exit(1);
}

result = repl.eval('/help');
if (!result.value) {
    exit(2);
}

# Test completion functionality
softlist<string> completions = repl.getCompletions('/he');
if (!inlist('/help', completions)) {
    exit(3);
}

printf('OK');
";
        string temp_script = tmp_location() + "/test_repl_run_" + string(getpid()) + ".q";
        {
            File f();
            f.open2(temp_script, O_CREAT | O_WRONLY | O_TRUNC);
            f.write(script);
        }

        # Run the script with qore using backquote
        # Pass QORE_MODULE_DIR to subprocess so it can find the QoreRepl module
        # Quote paths properly to handle spaces and special characters
        *string module_dir = ENV.QORE_MODULE_DIR;
        string cmd;
        # Shell-escape paths by replacing ' with '\'' and wrapping in single quotes
        string escaped_script = "'" + replace(temp_script, "'", "'\\''") + "'";
        if (module_dir) {
            string escaped_module_dir = "'" + replace(module_dir, "'", "'\\''") + "'";
            cmd = sprintf("QORE_MODULE_DIR=%s qore %s 2>&1", escaped_module_dir, escaped_script);
        } else {
            cmd = sprintf("qore %s 2>&1", escaped_script);
        }
        string output = backquote(cmd);
        assertRegex("OK", output, "REPL test script should output OK");

        # Clean up
        unlink(temp_script);
    }

    # ==================== Auto-promote tests ====================

    testAutoPromoteTyped() {
        QoreRepl::QoreRepl repl();

        # int x = 5 should be auto-promoted to global
        *hash<auto> result = repl.eval("int x = 5");
        assertTrue(exists result, "typed int should return result");
        assertTrue(!result.error, "typed int should not error: " + (result.error.desc ?? ""));
        assertEq(5, repl.getProgram().getGlobalVariable("x"), "x should be 5");

        # string s = "hello" should be auto-promoted
        result = repl.eval("string s = \"hello\"");
        assertTrue(!result.error, "typed string should not error: " + (result.error.desc ?? ""));
        assertEq("hello", repl.getProgram().getGlobalVariable("s"), "s should be 'hello'");

        # *int nullable should be auto-promoted
        result = repl.eval("*int nullable_val");
        assertTrue(!result.error, "nullable typed should not error: " + (result.error.desc ?? ""));

        # hash<auto> h should be auto-promoted
        result = repl.eval("hash<auto> h = {\"a\": 1}");
        assertTrue(!result.error, "hash<auto> should not error: " + (result.error.desc ?? ""));

        # Already has 'our' — should not double-prefix
        result = repl.eval("our float f = 3.14");
        assertTrue(!result.error, "our float should not error: " + (result.error.desc ?? ""));

        # Already has 'my' — should not be promoted
        result = repl.eval("my int local_only = 99");
        assertTrue(!result.error, "my int should not error: " + (result.error.desc ?? ""));
    }

    testAutoPromoteClassInstance() {
        QoreRepl::QoreRepl repl();

        # Mutex m() should be auto-promoted — class name starts uppercase
        *hash<auto> result = repl.eval("Mutex m()");
        assertTrue(!result.error, "Mutex m() should not error: " + (result.error.desc ?? ""));
        # Verify the variable is accessible
        auto val = repl.getProgram().getGlobalVariable("m");
        assertTrue(exists val, "m should exist as global");
        assertEq("Mutex", val.className(), "m should be a Mutex");

        # Counter c(1) should be auto-promoted
        result = repl.eval("Counter c(1)");
        assertTrue(!result.error, "Counter c(1) should not error: " + (result.error.desc ?? ""));
        auto cval = repl.getProgram().getGlobalVariable("c");
        assertTrue(exists cval, "c should exist as global");
    }

    testAutoPromoteSkipFunctions() {
        QoreRepl::QoreRepl repl();

        # "int sub foo() { return 1; }" should NOT be promoted (second word is 'sub')
        *hash<auto> result = repl.eval("int sub foo() { return 1; }");
        assertTrue(!result.error, "function def should not error: " + (result.error.desc ?? ""));

        # "string sub bar(int n) { return string(n); }" should NOT be promoted
        result = repl.eval("string sub bar(int n) { return string(n); }");
        assertTrue(!result.error, "function def with args should not error: " + (result.error.desc ?? ""));

        # Verify the functions work
        result = repl.eval("foo()");
        assertTrue(!result.error, "foo() should not error");
        assertEq(1, result.value, "foo() should return 1");

        result = repl.eval("bar(42)");
        assertTrue(!result.error, "bar(42) should not error");
        assertEq("42", result.value, "bar(42) should return '42'");

        # Control flow (if, while, etc.) should NOT be promoted
        result = repl.eval("if (True) {}");
        assertTrue(!result.error, "if statement should not error");

        # Class names starting with uppercase as variable name should NOT be promoted
        # e.g., "Mutex Foo" would have uppercase var name — should not promote
        # (though this isn't valid Qore anyway, the logic should not promote it)
    }

    # ==================== Static method completion tests ====================

    testStaticMethodCompletion() {
        QoreRepl::QoreRepl repl();

        # TimeZone:: should show static methods
        list<string> completions = repl.getCompletions("TimeZone::");
        assertTrue(completions.size() > 0, "TimeZone:: should have completions");

        # Check for known static methods
        bool has_get = False;
        foreach string c in (completions) {
            if (c =~ /get\(/) {
                has_get = True;
            }
        }
        assertTrue(has_get, "TimeZone:: should include get( method");

        # Mutex:: should show static methods (if any) or constants
        completions = repl.getCompletions("Mutex::");
        # Mutex doesn't have static methods — may be empty, that's fine
    }

    # ==================== Class scope suffix tests ====================

    testClassScopeSuffix() {
        QoreRepl::QoreRepl repl();

        # Completing "Mutex" in identifier context should offer both Mutex and Mutex::
        list<string> completions = repl.getCompletions("Mutex");
        bool has_plain = False;
        bool has_scope = False;
        foreach string c in (completions) {
            if (c == "Mutex::") {
                has_scope = True;
            } else if (c == "Mutex") {
                has_plain = True;
            }
        }
        # Both Mutex (bare class name) and Mutex:: (scope) should be offered
        assertTrue(has_scope, "Mutex should offer Mutex:: variant");
        assertTrue(has_plain, "Mutex should offer Mutex variant");

        # Completing "TimeZone" should offer TimeZone::
        completions = repl.getCompletions("TimeZone");
        has_scope = False;
        foreach string c in (completions) {
            if (c == "TimeZone::") {
                has_scope = True;
            }
        }
        assertTrue(has_scope, "TimeZone should offer TimeZone:: variant");
    }

    # ==================== No-arg callable trailing ) tests ====================

    testNoArgCallableTrailingParen() {
        QoreRepl::QoreRepl repl();

        # Create a Mutex so we can test its methods
        repl.eval("Mutex m()");

        # m.lock has two variants (no-arg and timeout arg) so should get "("
        list<string> completions = repl.getCompletions("m.lock");
        bool has_lock_open = False;
        foreach string c in (completions) {
            if (c == "m.lock(") {
                has_lock_open = True;
            }
        }
        assertTrue(has_lock_open, "m.lock should complete as m.lock( (multi-variant)");

        # m.unlock has only one no-arg variant → should get "()"
        completions = repl.getCompletions("m.unlock");
        bool has_unlock_closed = False;
        foreach string c in (completions) {
            if (c == "m.unlock()") {
                has_unlock_closed = True;
            }
        }
        assertTrue(has_unlock_closed, "m.unlock should complete as m.unlock() (no-arg)");

        # m.trylock has only one no-arg variant → should get "()"
        completions = repl.getCompletions("m.trylock");
        bool has_trylock_closed = False;
        foreach string c in (completions) {
            if (c == "m.trylock()") {
                has_trylock_closed = True;
            }
        }
        assertTrue(has_trylock_closed, "m.trylock should complete as m.trylock() (no-arg)");

        # get_module_hash should complete with () since it takes no args
        completions = repl.getCompletions("get_module_ha");
        bool has_gmh_closed = False;
        foreach string c in (completions) {
            if (c == "get_module_hash()") {
                has_gmh_closed = True;
            }
        }
        assertTrue(has_gmh_closed, "get_module_hash should complete as get_module_hash()");

        # printf should complete with ( since it takes args
        completions = repl.getCompletions("printf");
        bool has_printf_open = False;
        foreach string c in (completions) {
            if (c == "printf(") {
                has_printf_open = True;
            }
        }
        assertTrue(has_printf_open, "printf should complete as printf( (has args)");
    }

    # ==================== Hints callback tests ====================

    testFunctionSignatureHints() {
        QoreRepl::QoreRepl repl();

        # Test getHintText directly via the REPL
        # We can't call the private getHintText directly, so we test via
        # the hintsForInput method indirectly through the public API

        # Define a function with known signature
        repl.eval("int sub add(int a, int b) { return a + b; }");

        # Test that the hints callback doesn't crash for various inputs
        # (We can't directly test the linenoise rendering, but we verify
        # the REPL loads without errors with the hints callback set)
        *hash<auto> result = repl.eval("add(1, 2)");
        assertTrue(!result.error, "add() call should not error");
        assertEq(3, result.value, "add(1, 2) should return 3");
    }

    testCallArgAfterParen() {
        QoreRepl::QoreRepl repl();

        # Define a variable so we have something to complete
        repl.eval("our int testCallVar = 42;");

        # TAB after "(" should return completions (CC_CALL dispatches to identifier completion)
        softlist<string> completions = repl.getCompletions("printf(");
        assertTrue(completions.size() > 0, "completions after ( should not be empty");

        # Should include global variable
        bool found = False;
        foreach string c in (completions) {
            if (c.find("testCallVar") >= 0) {
                found = True;
                break;
            }
        }
        assertTrue(found, "scope variable should appear as arg candidate after (");
    }

    testCallArgAfterComma() {
        QoreRepl::QoreRepl repl();

        repl.eval("our int testCommaVar = 99;");

        # TAB after "," should return completions
        softlist<string> completions = repl.getCompletions("printf(\"%d\", ");
        assertTrue(completions.size() > 0, "completions after , should not be empty");

        # Should include global variable
        bool found = False;
        foreach string c in (completions) {
            if (c.find("testCommaVar") >= 0) {
                found = True;
                break;
            }
        }
        assertTrue(found, "scope variable should appear as arg candidate after ,");
    }

    testCallArgPartial() {
        QoreRepl::QoreRepl repl();

        repl.eval("our int testPartialVar = 7;");

        # Partial arg "test" after ( should return completions via CC_IDENTIFIER
        softlist<string> completions = repl.getCompletions("printf(testP");
        bool found = False;
        foreach string c in (completions) {
            if (c.find("testPartialVar") >= 0) {
                found = True;
                break;
            }
        }
        assertTrue(found, "partial arg should complete to scope variable");
    }

    testCodeVariableHints() {
        QoreRepl::QoreRepl repl();

        # Define a typed code variable
        repl.eval("our code<int(string, int)> myFunc = int sub (string s, int n) { return n; };");

        # getHints should show the parameter types
        *string hint = repl.getHints("myFunc(");
        assertTrue(exists hint, "hint should exist for typed code variable");
        assertTrue(hint.find("string") >= 0, "hint should contain 'string' parameter type");
        assertTrue(hint.find("int") >= 0, "hint should contain 'int' parameter type");
    }

    testCodeVariableHintsBareCode() {
        QoreRepl::QoreRepl repl();

        # Define a bare code variable (untyped)
        repl.eval("our code myCb = sub () {};");

        # getHints should return a hint indicating unknown signature
        *string hint = repl.getHints("myCb(");
        assertTrue(exists hint, "hint should exist for bare code variable");
        assertTrue(hint.find("unknown") >= 0, "hint should indicate signature is unknown");
    }

    testParseOptionsNoFilesystem() {
        QoreRepl::QoreRepl repl({
            "parse_options": PO_NEW_STYLE | PO_NO_FILESYSTEM,
        });

        # "File" class has QDOM_FILESYSTEM domain — should be filtered
        softlist<string> completions = repl.getCompletions("new Fil");
        bool has_file = False;
        foreach string c in (completions) {
            if (c =~ /\bFile\b/) {
                has_file = True;
                break;
            }
        }
        assertFalse(has_file, "'File' class should be filtered with PO_NO_FILESYSTEM");

        # "Mutex" has no filesystem domain — should still appear
        completions = repl.getCompletions("new Mut");
        bool has_mutex = False;
        foreach string c in (completions) {
            if (c =~ /Mutex/) {
                has_mutex = True;
                break;
            }
        }
        assertTrue(has_mutex, "'Mutex' should still appear with PO_NO_FILESYSTEM");
    }

    testParseOptionsNoThreadControl() {
        QoreRepl::QoreRepl repl({
            "parse_options": PO_NEW_STYLE | PO_NO_THREAD_CONTROL,
        });

        # "background" keyword should be filtered
        softlist<string> completions = repl.getCompletions("ba");
        bool has_background = False;
        foreach string c in (completions) {
            if (c =~ /\bbackground\b/) {
                has_background = True;
                break;
            }
        }
        assertFalse(has_background,
            "'background' keyword should be filtered with PO_NO_THREAD_CONTROL");

        # "save_thread_data" function has QDOM_THREAD_CONTROL — should be filtered
        completions = repl.getCompletions("save_thread_");
        bool has_save_thread = False;
        foreach string c in (completions) {
            if (c =~ /save_thread_data/) {
                has_save_thread = True;
                break;
            }
        }
        assertFalse(has_save_thread,
            "'save_thread_data' should be filtered with PO_NO_THREAD_CONTROL");
    }

    testParseOptionsModernFilterNoop() {
        QoreRepl::QoreRepl repl({
            "parse_options": PO_MODERN,
        });

        # "trim" has a RUNTIME_NOOP variant (the no-arg variant) but also non-noop variants
        # It should NOT be completely filtered out
        softlist<string> completions = repl.getCompletions("trim");
        bool has_trim = False;
        foreach string c in (completions) {
            if (c =~ /\btrim\b/) {
                has_trim = True;
                break;
            }
        }
        assertTrue(has_trim, "'trim' should still appear (has non-noop variants)");

        # "printf" has a NOOP variant (not RUNTIME_NOOP) and a non-noop variant — should appear
        completions = repl.getCompletions("printf");
        bool has_printf = False;
        foreach string c in (completions) {
            if (c =~ /\bprintf\b/) {
                has_printf = True;
                break;
            }
        }
        assertTrue(has_printf, "'printf' should appear (has non-RUNTIME_NOOP variants)");

        # Verify domain filtering still works with PO_MODERN
        # "File" has QDOM_FILESYSTEM domain — PO_MODERN doesn't restrict filesystem,
        # so it should still appear
        completions = repl.getCompletions("new Fil");
        bool has_file = False;
        foreach string c in (completions) {
            if (c =~ /\bFile\b/) {
                has_file = True;
                break;
            }
        }
        assertTrue(has_file, "'File' should appear with PO_MODERN (no filesystem restriction)");
    }
}

