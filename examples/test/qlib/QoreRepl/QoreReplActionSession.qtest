%modern

%requires ../../../../qlib/QUnit.qm
%requires reflection
%requires ../../../../qlib/QoreRepl

%exec-class QoreReplActionSessionTest

class QoreReplActionSessionTest inherits QUnit::Test {
    constructor() : QUnit::Test("QoreReplActionSession", "1.0") {
        addTestCase("repl-eval returns result and prompt", \testEval());
        addTestCase("repl-command returns prompt", \testCommand());
        addTestCase("repl-interrupt returns error", \testInterrupt());
        addTestCase("repl-close returns exit", \testClose());

        set_return_value(main());
    }

    private QoreRepl::QoreReplActionSession newSession() {
        return new QoreRepl::QoreReplActionSession();
    }

    private *hash<auto> findEvent(list<hash<auto>> events, string name) {
        foreach hash<auto> evt in (events) {
            if (evt.event == name) {
                return evt;
            }
        }
        return NOTHING;
    }

    testEval() {
        QoreRepl::QoreReplActionSession session = newSession();
        list<hash<auto>> events = session.handleAction("repl-eval", {
            "code": "1 + 1",
        });
        *hash<auto> result_evt = findEvent(events, "repl-result");
        *hash<auto> prompt_evt = findEvent(events, "repl-prompt");
        assertTrue(result_evt ? True : False, "Should include result event");
        assertEq("2", result_evt.data.value, "Result should be formatted");
        assertTrue(prompt_evt ? True : False, "Should include prompt event");
        assertTrue(prompt_evt.data.value.val(), "Prompt should have value");
    }

    testCommand() {
        QoreRepl::QoreReplActionSession session = newSession();
        list<hash<auto>> events = session.handleAction("repl-command", {
            "command": "vars",
        });
        *hash<auto> prompt_evt = findEvent(events, "repl-prompt");
        assertTrue(prompt_evt ? True : False, "Should include prompt event");
    }

    testInterrupt() {
        QoreRepl::QoreReplActionSession session = newSession();
        list<hash<auto>> events = session.handleAction("repl-interrupt", {});
        *hash<auto> err_evt = findEvent(events, "repl-error");
        assertTrue(err_evt ? True : False, "Should include error event");
        assertEq("NOT-IMPLEMENTED", err_evt.data.code, "Should report not implemented");
    }

    testClose() {
        QoreRepl::QoreReplActionSession session = newSession();
        list<hash<auto>> events = session.handleAction("repl-close", {});
        *hash<auto> exit_evt = findEvent(events, "repl-exit");
        assertTrue(exit_evt ? True : False, "Should include exit event");
        assertEq("user_request", exit_evt.data.reason, "Exit reason should be user_request");
    }
}
