#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires DataProvider
%requires CsvUtil

%exec-class CsvEncodingTest

#! Tests that CSV records read in any character encoding are keyed by the header names in UTF-8
/** Hash keys are stored in the default character encoding (UTF-8); header names read from a file in another
    encoding must give the same keys as the UTF-8 names, so that records can be accessed by the names, and the
    \c "fields" and \c "headers" options given in UTF-8 match the headers of the file.
*/
public class CsvEncodingTest inherits QUnit::Test {
    public {
        #! Czech and German header names; every character exists in ISO-8859-2 and WINDOWS-1250
        const CzechHeaders = ("Bestätigung", "Plzeň", "Množství");

        #! German header names; every character exists in ISO-8859-1 and WINDOWS-1252
        const GermanHeaders = ("Bestätigung", "Größe", "Menge");

        #! the encodings in which each set of headers can be written
        const Cases = (
            {"encoding": "ISO-8859-2", "headers": CzechHeaders},
            {"encoding": "WINDOWS-1250", "headers": CzechHeaders},
            {"encoding": "ISO-8859-1", "headers": GermanHeaders},
            {"encoding": "WINDOWS-1252", "headers": GermanHeaders},
            {"encoding": "UTF-8", "headers": CzechHeaders},
            {"encoding": "UTF-16LE", "headers": CzechHeaders},
            {"encoding": "UTF-16BE", "headers": CzechHeaders},
            # encodings created on the fly
            {"encoding": "UTF-32LE", "headers": CzechHeaders},
            {"encoding": "UTF-32BE", "headers": CzechHeaders},
            {"encoding": "UTF-32", "headers": CzechHeaders},
            {"encoding": "UCS-2LE", "headers": CzechHeaders},
        );

        #! the headers of the data with typed fields
        const TypedHeaders = ("qty", "price", "amount", "active", "date", "day", "stamp", "opt");

        #! the data with typed fields
        const TypedRows = (
            ("5", "1.5", "1.25", "true", "2024-01-02", "02.01.2024", "20240102T030405", ""),
            ("-12", "-2.25e3", "100.5", "0", "2026-10-08T12:30:45", "31.12.2025", "2025-06-30 23:59:59", "7"),
        );

        #! the field types of the data with typed fields
        const TypedFields = {
            "qty": "int",
            "price": "float",
            "amount": "number",
            "active": "bool",
            "date": "date",
            "day": {"type": "date", "format": "DD.MM.YYYY"},
            "stamp": {"type": "date", "timezone": "UTC"},
            "opt": "*int",
        };

        #! the records of the data with typed fields
        const TypedRecords = (
            {"qty": 5, "price": 1.5, "amount": 1.25n, "active": True, "date": 2024-01-02, "day": 2024-01-02,
                "stamp": 2024-01-02T03:04:05Z, "opt": NOTHING},
            {"qty": -12, "price": -2250.0, "amount": 100.5n, "active": False, "date": 2026-10-08T12:30:45,
                "day": 2025-12-31, "stamp": 2025-06-30T23:59:59Z, "opt": 7},
        );

        #! the headers of the data with numbers in a continental European format
        const FormatHeaders = ("n", "f", "i");

        #! the data with numbers in a continental European format
        const FormatRows = (
            ("1.234,5", "1.234,5", "1.234"),
            ("-7,25", "-7,25", "-7"),
        );

        #! the field types of the data with numbers in a continental European format
        const FormatFields = {"n": "number", "f": "float", "i": "int"};

        #! the records of the data with numbers in a continental European format
        const FormatRecords = (
            {"n": 1234.5n, "f": 1234.5, "i": 1234},
            {"n": -7.25n, "f": -7.25, "i": -7},
        );

        #! the encodings of the data with typed fields, with the byte order mark written before the data, if any
        const TypedCases = (
            {"encoding": "ISO-8859-2"},
            {"encoding": "WINDOWS-1252"},
            {"encoding": "UTF-8"},
            {"encoding": "UTF-16LE"},
            {"encoding": "UTF-16BE"},
            {"encoding": "UTF-16LE", "bom": <fffe>},
            {"encoding": "UTF-16BE", "bom": <feff>},
            {"encoding": "UTF-16", "data_encoding": "UTF-16LE", "bom": <fffe>},
            {"encoding": "UTF-16", "data_encoding": "UTF-16BE", "bom": <feff>},
            {"encoding": "UTF-16", "data_encoding": "UTF-16BE"},
            {"encoding": "UTF-32LE"},
            {"encoding": "UTF-32BE"},
            {"encoding": "UTF-32", "data_encoding": "UTF-32LE", "bom": <fffe0000>},
            {"encoding": "UTF-32", "data_encoding": "UTF-32BE", "bom": <0000feff>},
            {"encoding": "UTF-32", "data_encoding": "UTF-32BE"},
            {"encoding": "UCS-2BE"},
        );

        #! an EBCDIC code page, used if iconv supports it
        const Ebcdic = "IBM1140";

        #! the data rows
        const Rows = (
            ("ja", "Brno", "5"),
            ("nein", "Praha", "12"),
        );
    }

    private {
        string dir;
    }

    constructor() : Test("CsvEncodingTest", "1.0") {
        addTestCase("header-derived keys", \headerKeys());
        addTestCase("the fields option", \fieldsOption());
        addTestCase("the headers option", \headersOption());
        addTestCase("the record type", \recordType());
        addTestCase("data providers", \dataProviders());
        addTestCase("UTF-16 byte order marks", \utf16ByteOrderMarks());
        addTestCase("generic UTF-16", \genericUtf16());
        addTestCase("typed fields", \typedFields());
        addTestCase("EBCDIC", \ebcdic());
        set_return_value(main());
    }

    globalSetUp() {
        dir = tmp_location() + DirSep + "csv-encoding-" + get_random_string(8);
        mkdir(dir);
    }

    globalTearDown() {
        if (dir && is_dir(dir)) {
            Dir d();
            d.chdir(dir);
            foreach string f in (d.listFiles() ?? ()) {
                unlink(dir + DirSep + f);
            }
            rmdir(dir);
        }
    }

    headerKeys() {
        foreach hash<auto> c in (Cases) {
            binary data = encode(c.headers, c.encoding);
            string label = c.encoding;
            hash<auto> opts = {"separator": ";", "header_names": True};
            checkRecords(c.headers, read(new CsvIterator(new BinaryInputStream(data), c.encoding, opts)),
                label + " CsvIterator");
            string path = writeFile("headers.csv", data);
            checkRecords(c.headers, read(new CsvFileIterator(path, opts + {"encoding": c.encoding})),
                label + " CsvFileIterator");
            checkRecords(c.headers, read(new CsvIterator(new FileInputStream(path), c.encoding, opts)),
                label + " file stream");
            checkRecords(c.headers, read(new CsvDataIterator(binary_to_string(data, c.encoding), opts)),
                label + " CsvDataIterator");
            # the headers are given in the encoding of the file
            CsvIterator i(new BinaryInputStream(data), c.encoding, opts);
            assertTrue(i.next(), label);
            assertEq(c.headers, map convert_encoding($1, "UTF-8"), i.getHeaders(), label + " headers");
        }
    }

    fieldsOption() {
        foreach hash<auto> c in (Cases) {
            binary data = encode(c.headers, c.encoding);
            string label = c.encoding;
            # the fields are named in UTF-8; the last field is converted to an integer
            string type = "int";
            list<int> qty = (5, 12);
            hash<auto> opts = {
                "separator": ";",
                "header_names": True,
                "fields": {
                    c.headers[0]: "string",
                    c.headers[1]: "string",
                    c.headers[2]: type,
                },
            };
            list<hash<auto>> records = read(new CsvIterator(new BinaryInputStream(data), c.encoding, opts));
            checkRecords(c.headers, records, label + " fields");
            assertEq(qty, map $1{c.headers[2]}, records, label + " typed field");
            records = read(new CsvFileIterator(writeFile("fields.csv", data), opts + {"encoding": c.encoding}));
            assertEq(qty, map $1{c.headers[2]}, records, label + " CsvFileIterator typed field");
            # a field renamed from a header in UTF-8
            opts.fields = {"qty": {"type": type, "header": c.headers[2]}};
            records = read(new CsvIterator(new BinaryInputStream(data), c.encoding, opts));
            assertEq(qty, map $1.qty, records, label + " renamed field");
            assertEq((c.headers[0], c.headers[1], "qty"), keys records[0], label + " renamed field keys");
        }
    }

    headersOption() {
        foreach hash<auto> c in (Cases) {
            # the data has no header line; the headers are given in UTF-8
            binary data = encode(c.headers, c.encoding, False);
            string label = c.encoding;
            hash<auto> opts = {"separator": ";", "headers": c.headers};
            checkRecords(c.headers, read(new CsvIterator(new BinaryInputStream(data), c.encoding, opts)),
                label + " headers");
            opts.fields = {c.headers[2]: "int"};
            list<hash<auto>> records = read(new CsvIterator(new BinaryInputStream(data), c.encoding, opts));
            assertEq((5, 12), map $1{c.headers[2]}, records, label + " headers and fields");
        }
    }

    recordType() {
        foreach hash<auto> c in (Cases) {
            binary data = encode(c.headers, c.encoding);
            string label = c.encoding;
            hash<auto> opts = {"separator": ";", "header_names": True, "fields": {c.headers[2]: "int"}};
            CsvIterator i(new BinaryInputStream(data), c.encoding, opts);
            # the headers are read with the first record
            assertTrue(i.next(), label);
            checkKeys(c.headers, keys i.getRecordType(), label + " iterator record type");
            CsvReadDataProvider dp(opts + {"data": data, "encoding": c.encoding});
            hash<auto> record_type = dp.getRecordType();
            checkKeys(c.headers, keys record_type, label + " provider record type");
            # the type of the field named in UTF-8 in the "fields" option
            assertEq("*softint", record_type{c.headers[2]}.getType().getName(), label + " typed field");
        }
    }

    dataProviders() {
        foreach hash<auto> c in (Cases) {
            binary data = encode(c.headers, c.encoding);
            string label = c.encoding;
            hash<auto> opts = {"separator": ";", "header_names": True, "encoding": c.encoding};
            string path = writeFile("provider.csv", data);
            checkRecords(c.headers, search(new CsvReadDataProvider(path, opts)), label + " path");
            checkRecords(c.headers, search(new CsvReadDataProvider(opts + {"path": path})), label + " path option");
            checkRecords(c.headers, search(new CsvReadDataProvider(new BinaryInputStream(data), opts)),
                label + " stream");
            checkRecords(c.headers, search(new CsvReadDataProvider(opts + {"stream": new BinaryInputStream(data)})),
                label + " stream option");
            checkRecords(c.headers, search(new CsvReadDataProvider(opts + {"data": data})), label + " binary data");
            checkRecords(c.headers, search(new CsvReadDataProvider(opts - "encoding"
                + {"data": binary_to_string(data, c.encoding)})), label + " string data");
            # a search by a header name in UTF-8
            list<hash<auto>> records = search(new CsvReadDataProvider(opts + {"data": data}),
                {c.headers[1]: "Praha"});
            assertEq(1, records.size(), label + " search");
            assertEq("nein", records[0]{c.headers[0]}, label + " search result");
        }
    }

    utf16ByteOrderMarks() {
        foreach hash<auto> c in ({"encoding": "UTF-16LE", "bom": <fffe>}, {"encoding": "UTF-16BE", "bom": <feff>}) {
            binary data = c.bom + encode(CzechHeaders, c.encoding);
            string label = c.encoding + " with a byte order mark";
            hash<auto> opts = {"separator": ";", "header_names": True};
            checkRecords(CzechHeaders, read(new CsvIterator(new BinaryInputStream(data), c.encoding, opts)), label);
            checkRecords(CzechHeaders, read(new CsvFileIterator(writeFile("bom.csv", data),
                opts + {"encoding": c.encoding})), label + " CsvFileIterator");
            checkRecords(CzechHeaders, search(new CsvReadDataProvider(opts + {"data": data, "encoding": c.encoding})),
                label + " CsvReadDataProvider");
        }
    }

    genericUtf16() {
        # the byte order of the generic "UTF-16" encoding is given by the byte order mark at the start of the data
        hash<auto> opts = {"separator": ";", "header_names": True};
        foreach hash<auto> c in ({"encoding": "UTF-16LE", "bom": <fffe>}, {"encoding": "UTF-16BE", "bom": <feff>}) {
            binary data = c.bom + encode(CzechHeaders, c.encoding);
            string label = "UTF-16 with a " + c.encoding + " byte order mark";
            checkRecords(CzechHeaders, read(new CsvIterator(new BinaryInputStream(data), "UTF-16", opts)), label);
            checkRecords(CzechHeaders, read(new CsvIterator(new BinaryInputStream(data), "UTF-16",
                opts + {"eol": "\n"})), label + " and an explicit eol");
            checkRecords(CzechHeaders, read(new CsvFileIterator(writeFile("utf16.csv", data),
                opts + {"encoding": "UTF-16"})), label + " CsvFileIterator");
            checkRecords(CzechHeaders, search(new CsvReadDataProvider(opts + {"data": data, "encoding": "UTF-16"})),
                label + " CsvReadDataProvider");
            CsvIterator i(new BinaryInputStream(data), "UTF-16", opts);
            assertTrue(i.next(), label);
            assertEq(c.encoding, i.getHeaders()[0].encoding(), label + " header encoding");
        }
        # without a byte order mark, UTF-16 is big-endian
        binary data = encode(CzechHeaders, "UTF-16BE");
        checkRecords(CzechHeaders, read(new CsvIterator(new BinaryInputStream(data), "UTF-16", opts)),
            "UTF-16 without a byte order mark");
    }

    typedFields() {
        # int, float, number, bool, and date fields are converted from data in every encoding, including the
        # encodings that are not ASCII-compatible
        foreach hash<auto> c in (TypedCases) {
            string label = sprintf("%s%s", c.encoding, c.bom ? " with a byte order mark" : "");
            checkTyped(c, label, TypedHeaders, TypedRows, TypedRecords, {"fields": TypedFields});
            checkTyped(c, label + " number format", FormatHeaders, FormatRows, FormatRecords,
                {"fields": FormatFields, "number_format": ".,"});
        }
    }

    ebcdic() {
        try {
            if (convert_encoding("A", Ebcdic).toBinary() != <c1>) {
                testSkip(Ebcdic + " is not an EBCDIC code page in iconv on this platform");
            }
        } catch (hash<ExceptionInfo> ex) {
            testSkip(Ebcdic + " is not supported by iconv on this platform");
        }
        # the separators, quotes, and line ends of a CSV file in EBCDIC are not ASCII bytes
        binary data = encode(GermanHeaders, Ebcdic);
        hash<auto> opts = {"separator": ";", "header_names": True};
        checkRecords(GermanHeaders, read(new CsvIterator(new BinaryInputStream(data), Ebcdic, opts)), "CsvIterator");
        checkRecords(GermanHeaders, read(new CsvFileIterator(writeFile("ebcdic.csv", data),
            opts + {"encoding": Ebcdic})), "CsvFileIterator");
        checkRecords(GermanHeaders, search(new CsvReadDataProvider(opts + {"data": data, "encoding": Ebcdic})),
            "CsvReadDataProvider");
        checkTyped({"encoding": Ebcdic}, Ebcdic, TypedHeaders, TypedRows, TypedRecords, {"fields": TypedFields});
    }

    #! Checks the records read from data with typed fields in the given encoding
    private checkTyped(hash<auto> c, string label, list<string> headers, list<list<string>> rows,
            list<hash<auto>> expected, hash<auto> field_opts) {
        string text = (foldl $1 + ";" + $2, headers) + "\n";
        foreach list<string> row in (rows) {
            text += (foldl $1 + ";" + $2, row) + "\n";
        }
        binary data = (c.bom ?? binary()) + convert_encoding(text, c.data_encoding ?? c.encoding).toBinary();
        hash<auto> opts = {"separator": ";", "header_names": True} + field_opts;
        assertEq(expected, read(new CsvIterator(new BinaryInputStream(data), c.encoding, opts)), label + " CsvIterator");
        assertEq(expected, read(new CsvFileIterator(writeFile("typed.csv", data), opts + {"encoding": c.encoding})),
            label + " CsvFileIterator");
        assertEq(expected, search(new CsvReadDataProvider(opts + {"data": data, "encoding": c.encoding})),
            label + " CsvReadDataProvider");
        # a string with a byte order mark is not valid CSV data
        if (!c.bom) {
            assertEq(expected, read(new CsvDataIterator(binary_to_string(data, c.encoding), opts)),
                label + " CsvDataIterator");
        }
    }

    #! Checks that the records have the expected keys and values
    private checkRecords(list<string> headers, list<hash<auto>> records, string label) {
        assertEq(Rows.size(), records.size(), label + " record count");
        foreach hash<auto> rec in (records) {
            checkKeys(headers, keys rec, label);
            list<auto> row = Rows[$#];
            foreach string h in (headers) {
                # each record can be accessed by the header names in UTF-8
                assertTrue(rec.hasKey(h), sprintf("%s: %y", label, h));
                assertEq(row[$#], string(rec{h}), sprintf("%s: %y value", label, h));
            }
        }
    }

    #! Checks that the keys are the expected UTF-8 names
    private checkKeys(list<string> expected, *list<auto> actual, string label) {
        assertEq(expected, actual, label + " keys");
        foreach string k in (actual) {
            assertEq("UTF-8", k.encoding(), label + " key encoding");
            # the bytes are compared, so that a key in another encoding with the same characters is not equal
            assertEq(binary(expected[$#]), binary(k), sprintf("%s: %y bytes", label, k));
        }
    }

    #! Returns the CSV text with the given headers in the given encoding
    private static binary encode(list<string> headers, string encoding, bool with_headers = True) {
        string text = with_headers ? (foldl $1 + ";" + $2, headers) + "\n" : "";
        foreach list<auto> row in (Rows) {
            text += (foldl $1 + ";" + $2, row) + "\n";
        }
        return convert_encoding(text, encoding).toBinary();
    }

    #! Writes a file in the test directory and returns its path
    private string writeFile(string name, binary data) {
        string path = dir + DirSep + name;
        File f();
        f.open2(path, O_CREAT | O_TRUNC | O_WRONLY);
        f.write(data);
        f.close();
        return path;
    }

    #! Returns the records of an iterator
    private static list<hash<auto>> read(AbstractCsvIterator i) {
        list<hash<auto>> rv = ();
        while (i.next()) {
            rv += i.getValue();
        }
        return rv;
    }

    #! Returns the records of a data provider
    private static list<hash<auto>> search(CsvReadDataProvider dp, *hash<auto> where_cond) {
        return map $1, dp.searchRecords(where_cond);
    }
}
