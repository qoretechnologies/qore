%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/QoreLlmTypes.qm
%requires ../../../../qlib/QoreLlmUtils
%requires ../../../../qlib/QoreRagTypes.qm
%requires ../../../../qlib/QoreRagUtils
%requires ../../../../qlib/OpenAiRestClient.qm
%requires ../../../../qlib/MistralRestClient.qm

%requires ../../../../qlib/HttpServer.qm
%requires ../../../../qlib/HttpServerUtil.qm
%requires json

%exec-class MistralRestClientTest

#! Local authenticated endpoint for deterministic transport and ping tests
class MistralPingHandler inherits AbstractHttpRequestHandler {
    private {
        Mutex m();
        hash<auto> request;
    }

    hash<auto> getRequest() {
        AutoLock al(m);
        return request;
    }

    hash handleRequest(hash cx, hash hdr, *data body) {
        AutoLock al(m);
        request = hdr;
        bool valid = hdr.authorization == "Bearer test-key";
        return makeResponse(valid ? 200 : 401,
            make_json(valid ? {"object": "list", "data": ()} : {"message": "Unauthorized"}),
            {"Content-Type": MimeTypeJson});
    }
}

#! Exercises the synchronous connection ping fallback
class SyncMistralConnection inherits MistralRestClient::MistralRestConnection {
    constructor(string url, hash<auto> options)
            : MistralRestConnection("sync", "test", url, {}, options) {
    }

    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        throw "CONNECTION-ASYNC-UNSUPPORTED", "exercise synchronous ping";
    }
}

public class MistralRestClientTest inherits QUnit::Test {
    constructor() : Test("MistralRestClient Test", "1.0") {
        addTestCase("connection scheme registered",       \connectionSchemeTest());
        addTestCase("LLM factory registered",             \llmFactoryTest());
        addTestCase("Embedder factory registered",        \embedderFactoryTest());
        addTestCase("LLM provider applies default URL",   \defaultUrlTest());
        addTestCase("default chat path is OpenAI shape",  \chatPathTest());
        addTestCase("REST client options apply Bearer mapping",
            \restOptionsTest());
        addTestCase("embedder requires api_key",          \embedderConfigTest());
        addTestCase("connection fixes auto URL and publishes app metadata", \connectionConfigTest());
        addTestCase("connection validates required and finite options", \connectionValidationTest());
        addTestCase("sync and async pings authenticate with the versioned models endpoint", \pingTest());
        if (ENV.MISTRALAI_APIKEY) {
            addTestCase("live: valid and invalid API keys", \livePingTest());
        }
        addTestCase("model-specific reasoning capabilities", \reasoningCapabilitiesTest());
        set_return_value(main());
    }

    private reasoningCapabilitiesTest() {
        foreach string model in (("mistral-large-4", "mistral-large-4-0", "mistral-medium-3-5",
                "mistral-medium-3.5", "mistral-medium-2604", "mistral-medium-latest", "mistral-medium",
                "mistral-small-2603", "mistral-small-latest", "magistral-small-latest")) {
            assertEq(("none", "high"), MistralRestClientBase::getModelReasoningEfforts(model));
        }
        foreach string model in (("mistral-large-2512", "mistral-large-latest")) {
            assertEq((), MistralRestClientBase::getModelReasoningEfforts(model));
        }
        foreach string model in (("unknown-model", "zai-glm-5-3", "mistral-large-4 ", "MISTRAL-LARGE-4")) {
            assertNothing(MistralRestClientBase::getModelReasoningEfforts(model));
        }
    }

    private connectionSchemeTest() {
        hash<ConnectionSchemeInfo> info =
            ConnectionProvider::ConnectionSchemeCache::getScheme("mistral");
        assertEq("Mistral AI REST Connection", info.display_name);
        assertTrue(info.schemes.mistral);
        assertEq("apikey", info.required_options);
    }

    private llmFactoryTest() {
        QoreLlmUtils::AbstractLlmProviderFactory f =
            QoreLlmUtils::LlmProviderRegistry::getFactoryEx("mistral");
        assertEq("mistral", f.getMode());
        assertEq("Mistral AI chat completions", f.getDisplayName());
        assertEq("MistralRestClient", f.getInfo().module_name);
    }

    private embedderFactoryTest() {
        QoreRagUtils::AbstractEmbedderFactory ef =
            QoreRagUtils::RagProviderRegistry::getEmbedderFactoryEx("mistral");
        assertEq("mistral", ef.getType());
        assertEq("Mistral AI embeddings", ef.getDisplayName());
    }

    private defaultUrlTest() {
        MistralRestClient::MistralLlmProvider p(
            <QoreLlmUtils::LlmBackendConfig>{
                "model": "mistral-large-latest",
                "api_key": "test-key",
            });
        assertEq("mistral", p.getMode());
        assertEq(MistralRestClient::MistralLlmProvider::DefaultUrl,
            p.getConfig().url);
    }

    private chatPathTest() {
        MistralRestClient::MistralLlmProvider p(
            <QoreLlmUtils::LlmBackendConfig>{
                "model": "mistral-large-latest",
                "api_key": "k",
            });
        assertEq("/v1/chat/completions", p.getChatCompletionsPath());
    }

    private restOptionsTest() {
        hash<auto> opts = MistralRestClient::MistralRestClientBase::getOptions({
            "apikey": "my-key",
        });
        assertEq("my-key", opts.token);
        assertEq(NOTHING, opts.apikey);
        assertEq("https://api.mistral.ai", opts.url);
        assertEq("v1", opts.api);
        assertEq("/v1", opts.default_path);
    }

    private embedderConfigTest() {
        assertThrows("EMBEDDER-CONFIG-ERROR", sub () {
            new QoreRagUtils::MistralEmbedder(<QoreRagUtils::EmbedderConfig>{
                "backend": "mistral",
            });
        });
        QoreRagUtils::MistralEmbedder e(<QoreRagUtils::EmbedderConfig>{
            "backend": "mistral",
            "api_key": "k",
        });
        assertEq("mistral-embed", e.getModel());
    }
    private connectionConfigTest() {
        foreach string url in ("mistral://localhost", "mistral://api.mistral.ai") {
            MistralRestClient::MistralRestConnection conn({
                "name": "test", "desc": "test", "url": url, "opts": {"apikey": "test-key"},
            });
            assertEq("https://api.mistral.ai", conn.getConnectionOptions().url);
            assertEq("MistralAi", conn.getAppName());
            assertEq("MistralAi", conn.getInfo().app);
        }
        MistralRestClient::MistralRestConnection saved("saved", "test", "mistral://localhost", {},
            {"apikey": "test-key"});
        *hash<auto> updated;
        saved.setUpdateOptionsCode(sub (hash<auto> options) { updated = options; });
        assertEq({"url": "mistral://api.mistral.ai"}, updated);
        saved.setUpdateOptionsCode(NOTHING);
    }

    private connectionValidationTest() {
        assertTrue(MistralRestClient::MistralRestConnection::ConnectionScheme.options.apikey.sensitive);
        assertThrows("CONNECTION-OPTION-ERROR", sub () {
            new MistralRestClient::MistralRestConnection("missing", "test");
        });
        assertThrows("CONNECTION-OPTION-ERROR", sub () {
            new MistralRestClient::MistralRestConnection("invalid", "test",
                MistralRestClient::MistralRestConnection::DefaultUrl, {},
                {"apikey": "test-key", "api": "v99"});
        });
    }

    private pingTest() {
        Logger logger("mistral-test", LoggerLevel::getLevelWarn());
        HttpServer server(<HttpServerOptionInfo>{"logger": logger});
        on_exit delete server;
        int port = server.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        MistralPingHandler handler();
        server.setHandler("models", "/v1/models", NOTHING, handler);
        string url = sprintf("http://127.0.0.1:%d", port);
        foreach string api in ("v1", "v2") {
            foreach bool sync in (False, True) {
                hash<auto> opts = {"apikey": "test-key", "api": api, "http_version": "1.1"};
                AbstractConnection conn = sync
                    ? new SyncMistralConnection(url, opts)
                    : new MistralRestClient::MistralRestConnection("async", "test", url, {}, opts);
                assertTrue(conn.ping(True).ok);
                assertEq("GET", handler.getRequest().method);
                assertEq("v1/models", handler.getRequest().path);
                assertEq("Bearer test-key", handler.getRequest().authorization);
                opts.apikey = "invalid-key";
                AbstractConnection invalid = sync
                    ? new SyncMistralConnection(url, opts)
                    : new MistralRestClient::MistralRestConnection("invalid", "test", url, {}, opts);
                assertThrows(sync ? "HTTP-CLIENT-RECEIVE-ERROR" : "REST-RESPONSE-ERROR",
                    sub () { invalid.ping(True); });
            }
        }
    }

    private livePingTest() {
        MistralRestClient::MistralRestConnection conn("live-mistral", "test",
            MistralRestClient::MistralRestConnection::DefaultUrl, {}, {"apikey": ENV.MISTRALAI_APIKEY});
        assertTrue(conn.ping(True).ok);
        hash<auto> response = conn.get().get("models").body;
        assertTrue(response.data.lsize() > 0);
        assertTrue(response.data[0].id.val());
        MistralRestClient::MistralRestConnection invalid("invalid-mistral", "test",
            MistralRestClient::MistralRestConnection::DefaultUrl, {}, {"apikey": "invalid-qore-test-key"});
        assertThrows("REST-RESPONSE-ERROR", sub () { invalid.ping(True); });
    }

}
