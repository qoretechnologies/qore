    constructor() : Test("SseStreamNotifyNoErrorTest", "1.0", ARGV) {
        addTestCase("H2 SSE stream open when the client closes its connection", \testHttp2ClientClose());
        addTestCase("H2 SSE stream open when the server stops", \testHttp2ServerStop());
        addTestCase("H3 SSE stream open when the client closes its connection", \testHttp3ClientClose());
        addTestCase("H3 SSE stream open when the server stops", \testHttp3ServerStop());
        addTestCase("HTTPClient H2 SSE stream open when the client closes its connection",
            \testHTTPClientHttp2ClientClose());
        addTestCase("HTTPClient H2 SSE stream open when the server stops", \testHTTPClientHttp2ServerStop());
        addTestCase("HTTPClient H3 SSE stream open when the client closes its connection",
            \testHTTPClientHttp3ClientClose());
        addTestCase("HTTPClient H3 SSE stream open when the server stops", \testHTTPClientHttp3ServerStop());
        set_return_value(main());
    }

    globalSetUp() {
        controller_logger = new Logger::Logger("sse-notify-controller", LoggerLevel::getLevelError());
        controller_logger.addAppender(appender);
        AsyncIoController::setLogger(controller_logger);
    }

    globalTearDown() {
        AsyncIoController::setLogger(NOTHING);
    }

    testHttp2ClientClose() {
        runCase("H2", "h2", False);
    }

    testHttp2ServerStop() {
        runCase("H2", "h2", True);
    }

    testHttp3ClientClose() {
        runCase("H3", "h3", False);
    }

    testHttp3ServerStop() {
        runCase("H3", "h3", True);
    }

    testHTTPClientHttp2ClientClose() {
        runHTTPClientCase("HTTPClient H2", "h2", False);
    }

    testHTTPClientHttp2ServerStop() {
        runHTTPClientCase("HTTPClient H2", "h2", True);
    }

    testHTTPClientHttp3ClientClose() {
        runHTTPClientCase("HTTPClient H3", "h3", False);
    }

    testHTTPClientHttp3ServerStop() {
        runHTTPClientCase("HTTPClient H3", "h3", True);
    }

    #! Starts a server with an SSE handler and a TLS listener for the protocol given
    /** The server's logger is the test's logger: a running server sets its logger on the controller, which logs the
        errors of its callbacks with it

        @param handler the SSE handler
        @param proto \c "h2" or \c "h3"
        @param port the port of the listener

        @return the server
    */
    private HttpServer::HttpServer startServer(RecordingSseHandler handler, string proto, reference<int> port) {
        HttpServer::HttpServer server(<HttpServerOptionInfo>{
            "logger": controller_logger,
            "debug": True,
        });
        try {
            server.setDefaultHandler("sse", handler);
            hash<HttpListenerOptionInfo> listener_opts = <HttpListenerOptionInfo>{
                "node": "127.0.0.1",
                "service": 0,
                "cert": new SSLCertificate(CertPem),
                "key": new SSLPrivateKey(KeyPem),
            };
            if (proto == "h2") {
                listener_opts.http_version = "2.0";
            } else {
                listener_opts.enable_h3 = True;
            }
            port = server.addListener(listener_opts).port;
            server.waitForAsyncIo();
        } catch (hash<ExceptionInfo> ex) {
            server.stop();
            delete server;
            rethrow;
        }
        return server;
    }

    #! Checks that no callback of the controller reported an error
    /** The notifications of a connection's failed streams are dispatched when the step of the connection that failed
        them is done; the callbacks queued until then have run when flushCallbacks() returns
    */
    private checkNoCallbackError(string label) {
        AsyncIoController::flushCallbacks();
        assertEq((), appender.takeErrors(), label);
    }

    #! Reads an event of an SSE stream with HTTPClient, ends the connection with the stream open and checks the
    #! controller's errors
    /** HTTPClient's HTTP/2 and HTTP/3 connections are poll operations without stream listeners
        (\c Http2ClientPollOperationBase, \c Http3ClientPollOperationBase)

        @param label the label of the assertions
        @param proto \c "h2" or \c "h3"
        @param server_stop if @ref True, the server ends the connection; otherwise the client closes it
    */
    private runHTTPClientCase(string label, string proto, bool server_stop) {
        RecordingSseHandler handler();
        int port;
        *HttpServer::HttpServer server = startServer(handler, proto, \port);
        on_exit {
            if (server) {
                server.stop();
                delete server;
            }
        }

        *HTTPClient hc = new HTTPClient({
            "url": sprintf("https://127.0.0.1:%d", port),
            "http_version": proto == "h2" ? "2.0" : "3.0",
            "error_passthru": True,
        });
        on_exit {
            if (hc) {
                delete hc;
            }
        }
        hash<auto> info;
        hash<auto> resp = hc.sendAndStream("GET", "/", NOTHING, {"Accept": "text/event-stream"}, \info);
        assertEq(200, resp.status_code, label + ": stream status");

        assertEq(0, handler.registered.waitForZero(SseTestTimeout), label + ": the connection registers");
        handler.last_conn.send(<SseMessageInfo>{
            "event": "one",
            "data": "hello",
        });
        *hash<SseMessageInfo> evt;
        # comment events (the readiness of the stream) are skipped
        while (True) {
            evt = hc.readServerSentEvent(SseTestTimeout);
            if (!evt || exists evt.event || exists evt.data) {
                break;
            }
        }
        assertEq("one", evt.event, label + ": event name");
        assertEq("hello", evt.data, label + ": event data");

        # the connection ends with the stream open
        if (server_stop) {
            server.stop();
            delete server;
            *hash<SseMessageInfo> last;
            try {
                last = hc.readServerSentEvent(SseTestTimeout);
            } catch (hash<ExceptionInfo> ex) {
                # the failure of the stream is raised to its reader
                assertRegex("^HTTP[23]-", ex.err, label + ": stream failure");
            }
            assertNothing(last, label + ": no event after the end of the connection");
            # checked while the client still exists: the close of a client discards the callbacks queued for it
            checkNoCallbackError(label + ": no callback error after the server stops");
        }
        delete hc;
        checkNoCallbackError(label + ": no callback error after the client is deleted");
    }

    #! Reads an event of an SSE stream, ends the connection with the stream open and checks the controller's errors
    /** The connections of a connection manager are poll operations with stream listeners
        (\c HttpClientIo::Http2ClientPollOperation, \c HttpClientIo::Http3ClientPollOperation)

        @param label the label of the assertions
        @param proto the protocol of the connection manager
        @param server_stop if @ref True, the server ends the connection; otherwise the client closes it
    */
    private runCase(string label, string proto, bool server_stop) {
        RecordingSseHandler handler();
        int port;
        *HttpServer::HttpServer server = startServer(handler, proto, \port);
        on_exit {
            if (server) {
                server.stop();
                delete server;
            }
        }

        *HttpClientIo::HttpClientConnectionManager mgr = new HttpClientIo::HttpClientConnectionManager(
            <HttpClientIo::HttpClientConnectionManagerOptions>{
                "protocol": proto,
                "accept_all_certs": True,
                "request_timeout": 10s,
                "connect_timeout": 5s,
            });
        on_exit {
            if (mgr) {
                delete mgr;
            }
        }

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireAndStartStreaming(
            sprintf("https://127.0.0.1:%d/", port), "GET", "/", {"Accept": "text/event-stream"});
        HttpClientStreamingIo::SseStreamReader reader(stream);

        assertEq(0, handler.registered.waitForZero(SseTestTimeout), label + ": the connection registers");
        handler.last_conn.send(<SseMessageInfo>{
            "event": "one",
            "data": "hello",
        });
        *hash<SseMessageInfo> evt = reader.readEvent(SseTestTimeout);
        assertEq("one", evt.event, label + ": event name");
        assertEq("hello", evt.data, label + ": event data");

        # the connection ends with the stream open
        if (server_stop) {
            server.stop();
            delete server;
            # the stream ends for the client without another event: the end of the connection fails it
            *hash<SseMessageInfo> last;
            try {
                last = reader.readEvent(SseTestTimeout);
            } catch (hash<ExceptionInfo> ex) {
                # the failure of the stream is raised to its reader
                assertEq("SSE-STREAM-ERROR", ex.err, label + ": stream failure");
            }
            assertNothing(last, label + ": no event after the end of the connection");
            checkNoCallbackError(label + ": no callback error after the server stops");
        }
        delete mgr;
        checkNoCallbackError(label + ": no callback error after the client is deleted");
    }
}
