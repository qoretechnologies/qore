    constructor() : Test("SseAllProtocolsTest", "1.0") {
        addTestCase("H1 SSE events flow end-to-end", \testHttp1Sse());
        addTestCase("H2 SSE events flow end-to-end", \testHttp2Sse());
        addTestCase("H3 SSE events flow end-to-end", \testHttp3Sse());
        addTestCase("H1 SSE observable receives parsed events", \testHttp1SseObservable());
        addTestCase("H2 SSE observable receives parsed events and close",
            \testHttp2SseObservable());
        addTestCase("H3 SSE observable receives parsed events and close",
            \testHttp3SseObservable());
        addTestCase("H1 SSE observable receives heartbeat keep-alive",
            \testHttp1SseHeartbeat());
        addTestCase("H2 SSE observable receives heartbeat keep-alive",
            \testHttp2SseHeartbeat());
        addTestCase("H3 SSE observable receives heartbeat keep-alive",
            \testHttp3SseHeartbeat());
        addTestCase("H3 SSE survives QUIC idle timeout without app data",
            \testHttp3SseSurvivesQuicIdleTimeout());
        addTestCase("H2 callback-drained SSE readiness streams complete",
            \testHttp2CallbackDrainedSse());
        addTestCase("H3 callback-drained SSE readiness streams complete",
            \testHttp3CallbackDrainedSse());
        addTestCase("H3 callback-drained SSE readiness streams complete on separate connections",
            \testHttp3CallbackDrainedSseSeparateConnections());
        addTestCase("H3 callback-drained SSE completes after delayed second stream",
            \testHttp3CallbackDrainedDelayedSecondStream());
        addTestCase("H3 callback-drained SSE survives interleaved H3 requests",
            \testHttp3CallbackDrainedSseWithInterleavedRequests());
        addTestCase("H2 callback-drained SSE immediate ready completes",
            \testHttp2CallbackDrainedImmediateReadySse());
        addTestCase("H3 callback-drained SSE immediate ready completes",
            \testHttp3CallbackDrainedImmediateReadySse());
        addTestCase("H2 RestClientIo SSE immediate ready completes",
            \testHttp2RestClientIoImmediateReadySse());
        addTestCase("H3 RestClientIo SSE immediate ready completes",
            \testHttp3RestClientIoImmediateReadySse());
        addTestCase("H1 SSE connection is deregistered when the peer disconnects",
            \testHttp1SseDeregisterOnDisconnect());
        addTestCase("H2 SSE connection is deregistered when the peer disconnects",
            \testHttp2SseDeregisterOnDisconnect());
        addTestCase("H3 SSE connection is deregistered when the peer disconnects",
            \testHttp3SseDeregisterOnDisconnect());
        addTestCase("H2 SSE connection is deregistered when only the stream is reset",
            \testHttp2SseDeregisterOnStreamReset());
        addTestCase("H3 SSE connection is deregistered when only the stream is reset",
            \testHttp3SseDeregisterOnStreamReset());
        addTestCase("H2 SSE stream reset before the close notifier registers is not lost",
            \testHttp2SseDeregisterOnStreamResetBeforeListener());
        addTestCase("H3 SSE stream reset before the close notifier registers is not lost",
            \testHttp3SseDeregisterOnStreamResetBeforeListener());
        set_return_value(main());
    }

    globalSetUp() {
        mLogger = new Logger("sse-all-protocols", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            mLogger.addAppender(new StdoutAppender());
        }

        server = new HttpServer(<HttpServerOptionInfo>{
            "logger": mLogger,
            "debug": True,
        });
        server.setDefaultHandler("sse", handler);
        server.setHandler("heartbeat-sse", "/heartbeat", NOTHING, heartbeat_handler);
        server.setHandler("callback-sse", "/callback", NOTHING, callback_handler);
        server.setHandler("ping", "/ping", NOTHING, new PingHandler());
        server.waitForAsyncIo();

        # H1 plaintext listener
        h1_port = server.addListener(<HttpListenerOptionInfo>{
            "service": 0,
        }).port;

        # H2 over TLS (ALPN)
        h2_port = server.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
            "http_version": "2.0",
        }).port;

        # H3 over QUIC
        h3_port = server.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
            "enable_h3": True,
        }).port;

        server.waitForAsyncIo();
    }

    globalTearDown() {
        if (server) {
            server.stop();
            delete server;
        }
    }

    #! Reset per-test state on the shared handler
    private resetHandler() {
        handler.reset();
    }

    #! Drives one end-to-end SSE round trip: connect, push, read, assert
    private runSseFlow(string label, HttpClientIo::HttpClientConnectionManager mgr, string url) {
        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireAndStartStreaming(
            url, "GET", "/", {"Accept": "text/event-stream"});
        on_exit stream.cancel();

        HttpClientStreamingIo::SseStreamReader reader(stream);

        # The handler registers the connection in connectionRegisteredImpl(),
        # so wait for that before pushing events.
        assertEq(0, handler.registered.waitForZero(SseTestTimeout),
            label + ": connection should register on server");

        # Push two events from the server, from a different thread than the
        # client read loop so we actually exercise the cross-thread wake
        # path rather than an accidental synchronous delivery.
        handler.last_conn.send(<SseMessageInfo>{
            "event": "one",
            "data": "hello",
        });
        handler.last_conn.send(<SseMessageInfo>{
            "event": "two",
            "data": "world",
        });

        *hash<SseMessageInfo> evt1 = reader.readEvent(SseTestTimeout);
        assertEq(True, exists evt1, label + ": first event received");
        assertEq("one", evt1.event, label + ": first event name");
        assertEq("hello", evt1.data, label + ": first event data");

        *hash<SseMessageInfo> evt2 = reader.readEvent(SseTestTimeout);
        assertEq(True, exists evt2, label + ": second event received");
        assertEq("two", evt2.event, label + ": second event name");
        assertEq("world", evt2.data, label + ": second event data");
    }

    private runSseObservableFlow(string label, HttpClientIo::HttpClientConnectionManager mgr,
            string url, bool close_after_send) {
        HttpClientStreamingIo::SseObservable obs(mgr, url, "GET", "/");
        on_exit obs.stopEvents();

        RecordingSseObserver observer();
        obs.registerObserver(observer);
        obs.observersReady();

        assertEq(0, handler.registered.waitForZero(SseTestTimeout),
            label + ": observable connection should register on server");

        handler.last_conn.send(<SseMessageInfo>{
            "event": "ready",
            "data": "payload",
        });
        if (close_after_send) {
            handler.last_conn.getAsyncSseConnection().close();
        }

        int expected = close_after_send ? 3 : 2;
        assertTrue(observer.waitForCount(expected, SseTestTimeout),
            sprintf("%s: observable received expected events; events=%s",
                label, observer.describeEvents()));

        assertEq(HttpClientStreamingIo::EVENT_SSE_CONNECTED,
            observer.events[0].event_id, label + ": connected event");

        list<hash<auto>> data_events = (
            select observer.events,
            $1.event_id == HttpClientStreamingIo::EVENT_SSE_DATA
        );
        assertEq(1, data_events.size(), label + ": one parsed data event");
        assertEq("ready", data_events[0].data.event, label + ": parsed event name");
        assertEq("payload", data_events[0].data.data, label + ": parsed event data");

        if (close_after_send) {
            assertEq(HttpClientStreamingIo::EVENT_SSE_CLOSED,
                observer.events[observer.events.size() - 1].event_id, label + ": closed event");
        }
    }

    private runSseHeartbeatFlow(string label, HttpClientIo::HttpClientConnectionManager mgr,
            string url) {
        heartbeat_handler.reset();

        HttpClientStreamingIo::SseObservable obs(mgr, url, "GET", "/heartbeat",
            NOTHING, NOTHING, {
                "idle_timeout": 5s,
                "emit_heartbeat": True,
            });
        on_exit obs.stopEvents();

        RecordingSseObserver observer();
        obs.registerObserver(observer);
        obs.observersReady();

        assertEq(0, heartbeat_handler.registered.waitForZero(SseTestTimeout),
            label + ": heartbeat connection should register on server");

        assertTrue(observer.waitForHeartbeat(5s),
            sprintf("%s: observable received heartbeat; events=%s",
                label, observer.describeEvents()));

        heartbeat_handler.last_conn.stop();
    }

    private runCallbackDrainedSseFlow(string label, HttpClientIo::HttpClientConnectionManager mgr,
            string url) {
        callback_handler.reset(2);

        HttpClientStreamingIo::SseObservable obs1(mgr, url, "GET", "/callback");
        on_exit obs1.stopEvents();
        RecordingSseObserver observer1();
        obs1.registerObserver(observer1);
        obs1.observersReady();

        assertTrue(observer1.waitForDataEvent("progress", SseTestTimeout),
            sprintf("%s: first stream receives initial progress; events=%s actions=%s",
                label, observer1.describeEvents(), callback_handler.describeActions()));

        HttpClientStreamingIo::SseObservable obs2(mgr, url, "GET", "/callback");
        on_exit obs2.stopEvents();
        RecordingSseObserver observer2();
        obs2.registerObserver(observer2);
        obs2.observersReady();

        assertEq(0, callback_handler.registered.waitForZero(SseTestTimeout),
            label + ": both callback streams should register");
        assertTrue(observer2.waitForDataEvent("progress", SseTestTimeout),
            sprintf("%s: second stream receives initial progress; events=%s actions=%s",
                label, observer2.describeEvents(), callback_handler.describeActions()));
        assertEq(0, callback_handler.waitForDrainersWaitingForReady(SseTestTimeout),
            label + ": callback streams should be waiting for ready");

        callback_handler.markReady();

        assertTrue(observer1.waitForDataEvent("ready", SseTestTimeout),
            sprintf("%s: first stream receives terminal ready event; events=%s actions=%s",
                label, observer1.describeEvents(), callback_handler.describeActions()));
        assertTrue(observer2.waitForDataEvent("ready", SseTestTimeout),
            sprintf("%s: second stream receives terminal ready event; events=%s actions=%s",
                label, observer2.describeEvents(), callback_handler.describeActions()));

        assertTrue(observer1.waitForCount(4, SseTestTimeout),
            label + ": first stream receives closed event");
        assertEq(HttpClientStreamingIo::EVENT_SSE_CLOSED,
            observer1.events[observer1.events.size() - 1].event_id,
            label + ": first stream closes after ready");

        assertTrue(observer2.waitForCount(4, SseTestTimeout),
            label + ": second stream receives closed event");
        assertEq(HttpClientStreamingIo::EVENT_SSE_CLOSED,
            observer2.events[observer2.events.size() - 1].event_id,
            label + ": second stream closes after ready");
    }

    private runCallbackDrainedSseFlowSeparateManagers(string label,
            HttpClientIo::HttpClientConnectionManager mgr1,
            HttpClientIo::HttpClientConnectionManager mgr2, string url) {
        callback_handler.reset(2);

        HttpClientStreamingIo::SseObservable obs1(mgr1, url, "GET", "/callback");
        on_exit obs1.stopEvents();
        RecordingSseObserver observer1();
        obs1.registerObserver(observer1);
        obs1.observersReady();

        assertTrue(observer1.waitForDataEvent("progress", SseTestTimeout),
            label + ": first stream receives initial progress");

        HttpClientStreamingIo::SseObservable obs2(mgr2, url, "GET", "/callback");
        on_exit obs2.stopEvents();
        RecordingSseObserver observer2();
        obs2.registerObserver(observer2);
        obs2.observersReady();

        assertEq(0, callback_handler.registered.waitForZero(SseTestTimeout),
            label + ": both callback streams should register");
        assertTrue(observer2.waitForDataEvent("progress", SseTestTimeout),
            label + ": second stream receives initial progress");
        assertEq(0, callback_handler.waitForDrainersWaitingForReady(SseTestTimeout),
            label + ": callback streams should be waiting for ready");

        callback_handler.markReady();

        assertTrue(observer1.waitForDataEvent("ready", SseTestTimeout),
            sprintf("%s: first stream receives terminal ready event; events=%s actions=%s",
                label, observer1.describeEvents(), callback_handler.describeActions()));
        assertTrue(observer2.waitForDataEvent("ready", SseTestTimeout),
            sprintf("%s: second stream receives terminal ready event; events=%s actions=%s",
                label, observer2.describeEvents(), callback_handler.describeActions()));

        assertTrue(observer1.waitForCount(4, SseTestTimeout),
            label + ": first stream receives closed event");
        assertEq(HttpClientStreamingIo::EVENT_SSE_CLOSED,
            observer1.events[observer1.events.size() - 1].event_id,
            label + ": first stream closes after ready");

        assertTrue(observer2.waitForCount(4, SseTestTimeout),
            label + ": second stream receives closed event");
        assertEq(HttpClientStreamingIo::EVENT_SSE_CLOSED,
            observer2.events[observer2.events.size() - 1].event_id,
            label + ": second stream closes after ready");
    }

    private runCallbackDrainedDelayedSecondStreamFlow(string label, string url) {
        callback_handler.resetWithTick(2, 1000);

        HttpClientIo::HttpClientConnectionManager mgr1(
            <HttpClientIo::HttpClientConnectionManagerOptions>{
                "protocol": "h3",
                "accept_all_certs": True,
                "request_timeout": 20s,
                "connect_timeout": 5s,
            });
        on_exit delete mgr1;
        HttpClientIo::HttpClientConnectionManager mgr2(
            <HttpClientIo::HttpClientConnectionManagerOptions>{
                "protocol": "h3",
                "accept_all_certs": True,
                "request_timeout": 20s,
                "connect_timeout": 5s,
            });
        on_exit delete mgr2;

        HttpClientStreamingIo::SseObservable obs1(mgr1, url, "GET", "/callback");
        on_exit obs1.stopEvents();
        RecordingSseObserver observer1();
        obs1.registerObserver(observer1);
        obs1.observersReady();

        assertTrue(observer1.waitForDataEventCount("progress", 7, SseTestTimeout),
            label + ": first stream receives repeated progress before second stream");

        HttpClientStreamingIo::SseObservable obs2(mgr2, url, "GET", "/callback");
        on_exit obs2.stopEvents();
        RecordingSseObserver observer2();
        obs2.registerObserver(observer2);
        obs2.observersReady();

        assertEq(0, callback_handler.registered.waitForZero(SseTestTimeout),
            label + ": both callback streams should register");
        assertTrue(observer2.waitForDataEvent("progress", SseTestTimeout),
            label + ": second stream receives initial progress");
        assertEq(0, callback_handler.waitForDrainersWaitingForReady(SseTestTimeout),
            label + ": callback streams should be waiting for ready");

        for (int i = 0; i < 3; ++i) {
            HttpClientIo::HttpClientConnectionManager ping_mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
                    "protocol": "h3",
                    "accept_all_certs": True,
                    "request_timeout": 10s,
                    "connect_timeout": 5s,
                });
            hash<auto> resp = ping_mgr.request(url, "GET", "/ping");
            assertEq(200, resp.status_code,
                sprintf("%s: interleaved ping %d should return 200", label, i));
            delete ping_mgr;
        }

        callback_handler.markReady();

        assertTrue(observer1.waitForDataEvent("ready", SseTestTimeout),
            sprintf("%s: first stream receives terminal ready event; events=%s actions=%s",
                label, observer1.describeEvents(), callback_handler.describeActions()));
        assertTrue(observer2.waitForDataEvent("ready", SseTestTimeout),
            sprintf("%s: second stream receives terminal ready event; events=%s actions=%s",
                label, observer2.describeEvents(), callback_handler.describeActions()));

        assertTrue(observer1.waitForCount(10, SseTestTimeout),
            label + ": first stream receives closed event");
        assertEq(HttpClientStreamingIo::EVENT_SSE_CLOSED,
            observer1.events[observer1.events.size() - 1].event_id,
            label + ": first stream closes after delayed ready");

        assertTrue(observer2.waitForCount(4, SseTestTimeout),
            label + ": second stream receives closed event");
        assertEq(HttpClientStreamingIo::EVENT_SSE_CLOSED,
            observer2.events[observer2.events.size() - 1].event_id,
            label + ": second stream closes after ready");
    }

    private runCallbackDrainedSseWithInterleavedRequests(string label, string url) {
        callback_handler.reset(1);

        HttpClientIo::HttpClientConnectionManager sse_mgr(
            <HttpClientIo::HttpClientConnectionManagerOptions>{
                "protocol": "h3",
                "accept_all_certs": True,
                "request_timeout": 20s,
                "connect_timeout": 5s,
            });
        on_exit delete sse_mgr;

        HttpClientStreamingIo::SseObservable obs(sse_mgr, url, "GET", "/callback");
        on_exit obs.stopEvents();
        RecordingSseObserver observer();
        obs.registerObserver(observer);
        obs.observersReady();

        assertEq(0, callback_handler.registered.waitForZero(SseTestTimeout),
            label + ": callback stream should register");
        assertTrue(observer.waitForDataEvent("progress", SseTestTimeout),
            label + ": stream receives initial progress");
        assertEq(0, callback_handler.waitForDrainersWaitingForReady(SseTestTimeout),
            label + ": callback stream should be waiting for ready");

        # These requests use separate H3 connections/sessions on the same
        # listener while the SSE stream is waiting.  This covers the case where
        # one shared UDP listener poll operation must keep servicing an older
        # long-lived stream after newer H3 sessions complete ordinary requests.
        for (int i = 0; i < 3; ++i) {
            HttpClientIo::HttpClientConnectionManager ping_mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
                    "protocol": "h3",
                    "accept_all_certs": True,
                    "request_timeout": 10s,
                    "connect_timeout": 5s,
                });
            hash<auto> resp = ping_mgr.request(url, "GET", "/ping");
            assertEq(200, resp.status_code,
                sprintf("%s: interleaved ping %d should return 200", label, i));
            delete ping_mgr;
        }

        callback_handler.markReady();

        assertTrue(observer.waitForDataEvent("ready", SseTestTimeout),
            sprintf("%s: stream receives terminal ready event after interleaved requests; events=%s actions=%s",
                label, observer.describeEvents(), callback_handler.describeActions()));
        assertTrue(observer.waitForCount(4, SseTestTimeout),
            label + ": stream receives closed event after interleaved requests");
        assertEq(HttpClientStreamingIo::EVENT_SSE_CLOSED,
            observer.events[observer.events.size() - 1].event_id,
            label + ": stream closes after ready");
    }

    private runCallbackDrainedImmediateReadySseFlow(string label,
            HttpClientIo::HttpClientConnectionManager mgr, string url) {
        callback_handler.reset(1);
        callback_handler.markReady();

        HttpClientStreamingIo::SseObservable obs(mgr, url, "GET", "/callback");
        on_exit obs.stopEvents();
        RecordingSseObserver observer();
        obs.registerObserver(observer);
        obs.observersReady();

        assertEq(0, callback_handler.registered.waitForZero(SseTestTimeout),
            label + ": callback stream should register");
        assertTrue(observer.waitForDataEvent("ready", SseTestTimeout),
            sprintf("%s: stream receives immediate terminal ready event; events=%s actions=%s",
                label, observer.describeEvents(), callback_handler.describeActions()));

        assertTrue(observer.waitForCount(3, SseTestTimeout),
            label + ": stream receives closed event");
        assertEq(HttpClientStreamingIo::EVENT_SSE_CLOSED,
            observer.events[observer.events.size() - 1].event_id,
            label + ": stream closes after immediate ready");
    }

    private runRestClientIoImmediateReadySseFlow(string label, string protocol,
            string url) {
        callback_handler.reset(1);
        callback_handler.markReady();

        RestClientIo rest({
            "url": url,
            "protocol": protocol,
            "accept_all_certs": True,
            "request_timeout": 15s,
            "connect_timeout": 5s,
        });
        on_exit rest.close();

        HttpClientStreamingIo::SseObservable obs = rest.restObserveSse("GET",
            "/callback", NOTHING, NOTHING, {
                "serialization": "none",
                "timeout": 15s,
                "idle_timeout": 15s,
            });
        on_exit obs.stopEvents();

        RecordingSseObserver observer();
        obs.registerObserver(observer);
        obs.observersReady();

        assertEq(0, callback_handler.registered.waitForZero(SseTestTimeout),
            label + ": callback stream should register");
        assertTrue(observer.waitForDataEvent("ready", SseTestTimeout),
            sprintf("%s: stream receives immediate terminal ready event; events=%s actions=%s",
                label, observer.describeEvents(), callback_handler.describeActions()));
        assertTrue(observer.waitForCount(3, SseTestTimeout),
            label + ": stream receives closed event");
        assertEq(HttpClientStreamingIo::EVENT_SSE_CLOSED,
            observer.events[observer.events.size() - 1].event_id,
            label + ": stream closes after immediate ready");
    }

