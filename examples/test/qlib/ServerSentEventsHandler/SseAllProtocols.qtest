    End-to-end Server-Sent Events regression coverage for all three HTTP
    transports.  Each case goes through the real
    @ref ServerSentEventHandler::ServerSentEventHandler setup path
    (including the @ref HttpServer::HttpServer response dispatch), connects a
    client, has the server push events after connection registration, and
    asserts the client receives them within a short timeout.  A regression
    in any of the three per-protocol wake paths will stall the \c readEvent()
    call and fail the test.
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Mime
%requires Logger
%requires HttpServerUtil
%requires AsyncSocketIo
%requires HttpServerAsyncIo
%requires HttpServer
%requires ServerSentEventHandler
%requires HttpClientIo
%requires HttpClientStreamingIo

%exec-class SseAllProtocolsTest

#! Minimal SSE handler that records connections so the test can push events
class RecordingSseHandler inherits ServerSentEventHandler::ServerSentEventHandler {
    public {
        #! Counter signalled when a new connection registers
        Counter registered(1);

        #! Most-recently-registered connection (so the test can push events)
        *ServerSentEventHandler::ServerSentEventConnection last_conn;
    }

    # "data": "none" — SSE payloads are already-formed strings, no re-serialization
    constructor() : ServerSentEventHandler::ServerSentEventHandler({"data": "none"}) {
    }

    connectionRegisteredImpl(ServerSentEventHandler::ServerSentEventConnection conn) {
        last_conn = conn;
        registered.dec();
    }
}

class SseAllProtocolsTest inherits Test {
    private {
        *Logger::Logger mLogger;
        HttpServer::HttpServer server;
        RecordingSseHandler handler();
        int h1_port;
        int h2_port;
        int h3_port;

        # Reused throughout: self-signed cert + key good enough for loopback TLS
        const CertPem = "-----BEGIN CERTIFICATE-----
