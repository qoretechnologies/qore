    testHttp3SseDeregisterOnStreamResetBeforeListener() {
        runSseDeregisterOnStreamResetBeforeListenerFlow(
            "H3 SSE stream-reset-before-listener deregister", "h3",
            sprintf("https://127.0.0.1:%d", h3_port));
    }
}
