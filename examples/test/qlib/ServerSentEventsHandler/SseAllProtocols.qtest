    testHttp3CallbackDrainedImmediateReadySse() {
        HttpClientIo::HttpClientConnectionManager mgr(
            <HttpClientIo::HttpClientConnectionManagerOptions>{
                "protocol": "h3",
                "accept_all_certs": True,
                "request_timeout": 15s,
                "connect_timeout": 5s,
            });
        on_exit delete mgr;
        runCallbackDrainedImmediateReadySseFlow("H3 callback-drained immediate ready", mgr,
            sprintf("https://127.0.0.1:%d", h3_port));
    }

    testHttp2RestClientIoImmediateReadySse() {
        runRestClientIoImmediateReadySseFlow("H2 RestClientIo immediate ready", "h2",
            sprintf("https://127.0.0.1:%d", h2_port));
    }

    testHttp3RestClientIoImmediateReadySse() {
        runRestClientIoImmediateReadySseFlow("H3 RestClientIo immediate ready", "h3",
            sprintf("https://127.0.0.1:%d", h3_port));
    }

    #! Asserts that dropping the client deregisters the SSE connection on the server
    /** Regression coverage for multiplexed transports: HTTP/2 and HTTP/3 carry many streams on
        one connection, so neither a socket close nor a failed write reports the death of a
        single SSE response stream.  Before the transport-level close notification existed, the
        H1 case below passed and both multiplexed cases leaked the registration forever — the
        server kept the entry, kept writing heartbeats into a dead stream, and never ran the
        connection-closed hooks.
    */
    private runSseDeregisterOnDisconnectFlow(string label, string proto, string url) {
        handler.reset();
        HttpClientIo::HttpClientConnectionManager mgr = makeManager(proto);

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireAndStartStreaming(
            url, "GET", "/", {"Accept": "text/event-stream"});

        assertEq(0, handler.registered.waitForZero(SseTestTimeout),
            label + ": connection should register on server");
        assertEq(1, handler.getConnectionIds().size(), label + ": one registered connection");

        # drop the client entirely: the transport goes away under the SSE stream
        stream.cancel();
        delete mgr;

        assertEq(0, handler.deregistered.waitForZero(SseTestTimeout),
            label + ": connection should be deregistered after the peer disconnects");
        assertEq((), handler.getConnectionIds() ?? (),
            label + ": no connections remain registered");
    }

    #! Asserts that resetting only the SSE stream deregisters it, leaving the connection usable
    /** A pooled multiplexed client cancels the SSE stream and keeps the connection for other
        requests.  The connection-close path cannot see that, so this exercises the per-stream
        peer-reset notification specifically; the ping afterwards proves the connection really
        did stay up, so the deregistration came from the stream reset and not from a connection
        teardown.
    */
    private runSseDeregisterOnStreamResetFlow(string label, string proto, string url) {
        handler.reset();
        HttpClientIo::HttpClientConnectionManager mgr = makeManager(proto);
        on_exit delete mgr;

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireAndStartStreaming(
            url, "GET", "/", {"Accept": "text/event-stream"});

        assertEq(0, handler.registered.waitForZero(SseTestTimeout),
            label + ": connection should register on server");

        # cancel ONLY the SSE stream; the connection stays up and in use
        stream.cancel();

        hash<auto> resp = mgr.request(url, "GET", "/ping");
        assertEq(200, resp.status_code, label + ": connection still serves other requests");

        assertEq(0, handler.deregistered.waitForZero(SseTestTimeout),
            label + ": connection should be deregistered after the stream is reset");
        assertEq((), handler.getConnectionIds() ?? (),
            label + ": no connections remain registered");
    }

    #! Asserts that a peer stream reset arriving before the close notifier registers is not lost
    /** Same outcome as @ref runSseDeregisterOnStreamResetFlow(), but with the setup race won by
        the peer instead of left to chance.  On a multiplexed transport the SSE response stream
        learns that its peer went away only from a one-shot transport notification: the reset
        event is drained from the transport when it is processed, and a reset stream produces no
        further events.  @ref HttpServer::HttpServer registers the per-stream close notifier one
        step after the handler registers the connection, so a reset landing in that window used
        to be discarded and the connection stayed registered forever (a 30 s
        \c waitForZero() timeout here, not a slow deregistration).

        The gate parks the SSE setup thread inside \c connectionRegisteredImpl(), i.e. before the
        notifier is registered.  The \c /ping round trip is the barrier that makes this
        deterministic rather than timing-dependent: both transports process frames of one
        connection in order, so a completed \c /ping response proves the server already handled
        the reset for the SSE stream.  Only then is setup released, which registers the notifier
        strictly after the reset was processed — the exact ordering that used to lose it.

        @note This does not replace @ref runSseDeregisterOnStreamResetFlow(): that covers the
        common ordering where the notifier is registered first.
    */
    private runSseDeregisterOnStreamResetBeforeListenerFlow(string label, string proto,
            string url) {
        handler.reset();
        handler.armSetupGate();
        # never leave the parked setup thread stranded, even if an assertion throws
        on_exit handler.releaseSetupGate();

        HttpClientIo::HttpClientConnectionManager mgr = makeManager(proto);
        on_exit delete mgr;

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireAndStartStreaming(
            url, "GET", "/", {"Accept": "text/event-stream"});

        assertEq(0, handler.registered.waitForZero(SseTestTimeout),
            label + ": connection should register on server");

        # the setup thread is parked, so no close notifier is registered for this stream yet
        stream.cancel();

        hash<auto> resp = mgr.request(url, "GET", "/ping");
        assertEq(200, resp.status_code, label + ": connection still serves other requests");

        # the /ping response proves the reset has been processed; now let setup finish
        handler.releaseSetupGate();

        assertEq(0, handler.deregistered.waitForZero(SseTestTimeout),
            label + ": a close notifier registered after the reset must still deregister the "
            "connection");
        assertEq((), handler.getConnectionIds() ?? (),
            label + ": no connections remain registered");
    }

    #! Creates a connection manager pinned to the given protocol
    private HttpClientIo::HttpClientConnectionManager makeManager(string proto) {
        hash<HttpClientIo::HttpClientConnectionManagerOptions> opts =
            <HttpClientIo::HttpClientConnectionManagerOptions>{
                "accept_all_certs": True,
                "request_timeout": 20s,
                "connect_timeout": 5s,
            };
        if (proto != "h1") {
            opts.protocol = proto;
        }
        return new HttpClientIo::HttpClientConnectionManager(opts);
    }

    testHttp1SseDeregisterOnDisconnect() {
        runSseDeregisterOnDisconnectFlow("H1 SSE deregister", "h1",
            sprintf("http://127.0.0.1:%d", h1_port));
    }

