    testHttp2SseDeregisterOnStreamResetBeforeListener() {
        runSseDeregisterOnStreamResetBeforeListenerFlow(
            "H2 SSE stream-reset-before-listener deregister", "h2",
            sprintf("https://127.0.0.1:%d", h2_port));
