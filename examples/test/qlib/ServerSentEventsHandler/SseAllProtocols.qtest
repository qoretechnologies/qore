    THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
    IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
    FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
    AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
    LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
    FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
    DEALINGS IN THE SOFTWARE.

    End-to-end Server-Sent Events regression coverage for all three HTTP
    transports.  Each case goes through the real
    @ref ServerSentEventHandler::ServerSentEventHandler setup path
    (including the @ref HttpServer::HttpServer response dispatch), connects a
    client, has the server push events after connection registration, and
    asserts the client receives them within a short timeout.  A regression
    in any of the three per-protocol wake paths will stall the \c readEvent()
    call and fail the test.
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Mime
%requires Logger
%requires HttpServerUtil
%requires AsyncSocketIo
%requires HttpServerAsyncIo
%requires HttpServer
%requires ServerSentEventHandler
%requires HttpClientIo
%requires HttpClientStreamingIo
%requires RestClientIo

%exec-class SseAllProtocolsTest

#! Maximum time for protocol events to arrive in this end-to-end test.  The
#! H2/H3 paths are intentionally covered under valgrind as well, where normal
#! protocol handshakes and scheduler handoffs can exceed short wall-clock
#! deadlines without indicating a missed wakeup.
const SseTestTimeout = 30s;

#! Minimal SSE handler that records connections so the test can push events
class RecordingSseHandler inherits ServerSentEventHandler::ServerSentEventHandler {
    public {
        #! Counter signalled when a new connection registers
        Counter registered(1);

        #! Counter signalled when a connection is deregistered
        Counter deregistered(1);

        #! Most-recently-registered connection (so the test can push events)
        *ServerSentEventHandler::ServerSentEventConnection last_conn;
    }

    private {
        #! When armed, parks the SSE setup thread at the end of connectionRegisteredImpl()
        *Counter setup_gate;

        #! Guards @ref setup_gate so releaseSetupGate() is idempotent
        Mutex gate_lock();
    }

    # "data": "none" — SSE payloads are already-formed strings, no re-serialization
    constructor() : ServerSentEventHandler::ServerSentEventHandler({"data": "none"}) {
    }

    reset() {
        registered = new Counter(1);
        deregistered = new Counter(1);
        last_conn = NOTHING;
        AutoLock al(gate_lock);
        setup_gate = NOTHING;
    }

    #! Arms the setup gate so the next SSE setup parks until releaseSetupGate() is called
    /** @ref HttpServer::HttpServer registers the multiplexed per-stream peer-close notifier
        one step after this handler registers the connection, so parking here lets a test put
        a peer stream reset deterministically inside that window.
    */
    armSetupGate() {
        AutoLock al(gate_lock);
        setup_gate = new Counter(1);
    }

    #! Releases a gate armed by @ref armSetupGate(); idempotent and safe if never armed
    releaseSetupGate() {
        AutoLock al(gate_lock);
        if (setup_gate && setup_gate.getCount() > 0) {
            setup_gate.dec();
        }
    }

    connectionRegisteredImpl(ServerSentEventHandler::ServerSentEventConnection conn) {
        last_conn = conn;
        registered.dec();
        *Counter gate;
        {
            AutoLock al(gate_lock);
            gate = setup_gate;
        }
        if (gate) {
            gate.waitForZero(SseTestTimeout);
        }
    }

    deregisterConnectionImpl(ServerSentEventHandler::ServerSentEventConnection conn) {
        deregistered.dec();
    }
}

#! SSE handler with a short heartbeat interval for keep-alive coverage
class HeartbeatSseHandler inherits ServerSentEventHandler::ServerSentEventHandler {
    public {
        Counter registered(1);
        *ServerSentEventHandler::ServerSentEventConnection last_conn;
    }

    constructor() : ServerSentEventHandler::ServerSentEventHandler({"data": "none"}) {
        setHeartbeat(1);
    }

    reset() {
        registered = new Counter(1);
        last_conn = NOTHING;
    }

    connectionRegisteredImpl(ServerSentEventHandler::ServerSentEventConnection conn) {
        last_conn = conn;
        registered.dec();
    }
}

class RecordingSseObserver inherits DataProvider::Observer {
    public {
        list<hash<auto>> events = ();
        Mutex m();
        Condition cond();
    }

    update(string event_id, hash<auto> data_) {
        AutoLock al(m);
        push events, {
            "event_id": event_id,
            "data": data_,
        };
        cond.broadcast();
    }

    bool waitForCount(int count, timeout t = SseTestTimeout) {
        AutoLock al(m);
        date end_time = now_us() + t;
        while (events.size() < count) {
            date remaining = end_time - now_us();
            if (remaining <= 0us) {
                return False;
            }
            cond.wait(m, remaining);
        }
        return True;
    }

    bool waitForDataEvent(string event_name, timeout t = SseTestTimeout) {
        AutoLock al(m);
        date end_time = now_us() + t;
        while (True) {
            foreach hash<auto> evt in (events) {
                if (evt.event_id == HttpClientStreamingIo::EVENT_SSE_DATA
                        && evt.data.event == event_name) {
                    return True;
                }
            }

            date remaining = end_time - now_us();
            if (remaining <= 0us) {
                return False;
            }
            cond.wait(m, remaining);
        }
    }

    bool waitForDataEventCount(string event_name, int count, timeout t = SseTestTimeout) {
        AutoLock al(m);
        date end_time = now_us() + t;
        while (True) {
            int found = 0;
            foreach hash<auto> evt in (events) {
                if (evt.event_id == HttpClientStreamingIo::EVENT_SSE_DATA
                        && evt.data.event == event_name) {
                    ++found;
                }
            }
            if (found >= count) {
                return True;
            }

            date remaining = end_time - now_us();
            if (remaining <= 0us) {
                return False;
            }
            cond.wait(m, remaining);
        }
    }

    bool waitForHeartbeat(timeout t = SseTestTimeout) {
        AutoLock al(m);
        date end_time = now_us() + t;
        while (True) {
            foreach hash<auto> evt in (events) {
                if (evt.event_id == HttpClientStreamingIo::EVENT_SSE_HEARTBEAT
                        && evt.data.comment == "hb") {
                    return True;
                }
            }

            date remaining = end_time - now_us();
            if (remaining <= 0us) {
                return False;
            }
            cond.wait(m, remaining);
        }
    }

    string describeEvents() {
        AutoLock al(m);
        return sprintf("%y", events);
    }
}

#! SSE handler that mirrors Qorus' REST callback-drainer path
class CallbackSseHandler inherits HttpServer::AbstractHttpSocketHandler {
    public {
        Counter registered(1);
    }

    private {
        Mutex callbacks_lock();
        hash<string, code<*string()>> callbacks;
        Mutex state_lock();
        Condition state_cond();
        Counter drainers_waiting_for_ready(0);
        list<string> actions = ();
        bool ready = False;
        int generation = 0;
        int tick_ms = 10000;
    }

    constructor() : HttpServer::AbstractHttpSocketHandler() {
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data b) {
        callbacks_lock.lock();
        {
            on_exit callbacks_lock.unlock();
            callbacks{string(cx.id)} = makeCallback();
        }
        registered.dec();
        return <HttpResponseInfo>{
            "code": 200,
            "hdr": {
                "Cache-Control": "no-cache",
                "Connection": "Keep-Alive",
                "Content-Type": MimeTypeSse,
            },
        };
    }

    reset(int expected_connections) {
        resetWithTick(expected_connections, 10000);
    }

    resetWithTick(int expected_connections, int tick_ms) {
        callbacks_lock.lock();
        {
            on_exit callbacks_lock.unlock();
            callbacks = {};
        }
        state_lock.lock();
        {
            on_exit state_lock.unlock();
            ready = False;
            ++generation;
            self.tick_ms = tick_ms;
            actions = ();
        }
        registered = new Counter(expected_connections);
        drainers_waiting_for_ready = new Counter(expected_connections);
    }

    int waitForDrainersWaitingForReady(timeout t = SseTestTimeout) {
        return drainers_waiting_for_ready.waitForZero(t);
    }

    string describeActions() {
        AutoLock al(state_lock);
        return sprintf("%y", actions);
    }

    private recordAction(string action) {
        AutoLock al(state_lock);
        push actions, action;
    }

    markReady() {
        state_lock.lock();
        {
            on_exit state_lock.unlock();
            ready = True;
            ++generation;
            push actions, "mark-ready";
            state_cond.broadcast();
        }
    }

    private static string makeEvent(string event_name, string data) {
        return sprintf("event: %s\ndata: %s\n\n", event_name, data);
    }

    private code<*string()> makeCallback() {
        bool done = False;
        bool have_emitted = False;
        bool wait_registered = False;
        int last_generation = -1;
        Counter ready_wait_counter = drainers_waiting_for_ready;

        return *string sub () {
            while (True) {
                if (done) {
                    return NOTHING;
                }

                state_lock.lock();
                {
                    on_exit state_lock.unlock();
                    if (ready) {
                        done = True;
                        return CallbackSseHandler::makeEvent("ready", "ready");
                    }

                    if (!have_emitted) {
                        have_emitted = True;
                        last_generation = generation;
                        return CallbackSseHandler::makeEvent("progress", "waiting");
                    }

                    date deadline = now_us() + milliseconds(tick_ms);
                    if (!wait_registered) {
                        wait_registered = True;
                        ready_wait_counter.dec();
                    }
                    while (!ready && generation == last_generation) {
                        date remaining = deadline - now_us();
                        if (remaining <= 0us) {
                            break;
                        }
                        state_cond.wait(state_lock, remaining);
                    }

                    if (ready) {
                        done = True;
                        return CallbackSseHandler::makeEvent("ready", "ready");
                    }

                    last_generation = generation;
                    return CallbackSseHandler::makeEvent("progress", "waiting");
                }
            }
        };
    }

    private *code<*string()> takeCallback(string cid) {
        *list<string> match = (cid =~ x/^([^:]+)(?::.*)?$/);
        string key = match[0] ?? cid;
        callbacks_lock.lock();
        on_exit callbacks_lock.unlock();
        return remove callbacks{key};
    }

    private static startDrainer(string cid, code<*string()> cb,
            code<nothing(string)> queueChunk, code<nothing()> closeStream,
            code<nothing()> abortStream) {
        background sub () {
            bool aborted = False;
            try {
                while (True) {
                    *string chunk = cb();
                    if (!exists chunk) {
                        break;
                    }
                    queueChunk(chunk);
                }
            } catch (hash<ExceptionInfo> ex) {
                aborted = True;
                abortStream();
            }

            if (!aborted) {
                closeStream();
            }
        }();
    }

    HttpServerAsyncIo::HttpSseStreamPollOperation setupAsyncSseConnection(
            Socket sock, hash<auto> cx, hash<auto> hdr, string cid) {
        HttpServerAsyncIo::HttpSseStreamPollOperation poll_op(sock);
        *code<*string()> cb = takeCallback(cid);
        if (cb) {
            CallbackSseHandler::startDrainer(cid, cb,
                sub (string chunk) {
                    self.recordAction("h1 queue " + chunk);
                    poll_op.queueRawString(chunk);
                },
                sub () {
                    self.recordAction("h1 close");
                    poll_op.abort();
                },
                sub () {
                    self.recordAction("h1 abort");
                    poll_op.abort();
                });
        }
        return poll_op;
    }

    HttpServerAsyncIo::Http2SseStream setupAsyncSseConnectionHttp2(
            Socket sock, hash<auto> cx, hash<auto> hdr, string cid,
            int stream_id, *code<nothing()> wake_callback) {
        HttpServerAsyncIo::Http2SseStream sse_stream(sock, stream_id,
            wake_callback, True);
        *code<*string()> cb = takeCallback(cid);
        if (cb) {
            CallbackSseHandler::startDrainer(cid, cb,
                sub (string chunk) {
                    self.recordAction("h2 queue " + chunk);
                    sse_stream.queueRawString(chunk);
                },
                sub () {
                    self.recordAction("h2 close");
                    sse_stream.close();
                },
                sub () {
                    self.recordAction("h2 abort");
                    sse_stream.abort();
                });
        }
        return sse_stream;
    }

    HttpServerAsyncIo::Http3SseStream setupAsyncSseConnectionHttp3(
            Socket sock, hash<auto> cx, hash<auto> hdr, string cid,
            int session_id, int stream_id, *code<nothing()> wake_callback) {
        HttpServerAsyncIo::Http3SseStream sse_stream(sock, session_id,
            stream_id, wake_callback, True);
        *code<*string()> cb = takeCallback(cid);
        if (cb) {
            CallbackSseHandler::startDrainer(cid, cb,
                sub (string chunk) {
                    self.recordAction("h3 queue " + chunk);
                    sse_stream.queueRawString(chunk);
                },
                sub () {
                    self.recordAction("h3 close");
                    sse_stream.close();
                },
                sub () {
                    self.recordAction("h3 abort");
                    sse_stream.abort();
                });
        }
        return sse_stream;
    }

    private bool startImpl(softstring lid, hash<auto> cx, hash<auto> hdr,
            Socket s) {
        throw "CALLBACK-SSE-SYNC-UNSUPPORTED",
            "CallbackSseHandler only supports async SSE setup";
    }
}

#! Plain handler used to interleave normal HTTP/3 requests while an SSE stream waits
class PingHandler inherits HttpServer::AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return <HttpResponseInfo>{
            "code": 200,
            "hdr": {
                "Content-Type": MimeTypeText,
            },
            "body": "pong",
        };
    }
}

