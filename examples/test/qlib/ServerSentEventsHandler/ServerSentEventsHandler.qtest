#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires MapperUtil
%requires Logger
%requires DataProvider
%requires ConnectionProvider
%requires QUnit
%requires Mime
%requires HttpServerUtil
%requires HttpServerAsyncIo
%requires HttpServer
%requires ServerSentEventClient
%requires ServerSentEventHandler

%requires json

%exec-class Main

class MySseHandler inherits ServerSentEventHandler {
    constructor(*HttpServer::AbstractAuthenticator auth, *hash<auto> opts) : ServerSentEventHandler(auth, opts) {
    }
}

#! a connection that reports an over-limit outbound queue, so the max_queue_size drop path can be tested
#! deterministically without depending on TCP buffer / drain timing
class OverflowSseConnection inherits ServerSentEventHandler::ServerSentEventConnection {
    constructor(ServerSentEventHandler::ServerSentEventHandler handler, Socket sock, hash<auto> cx, hash<auto> hdr,
            string cid) : ServerSentEventHandler::ServerSentEventConnection(handler, sock, cx, hdr, cid) {
    }

    int getQueueSize() {
        return 1000000;
    }
}

class OverflowSseHandler inherits ServerSentEventHandler::ServerSentEventHandler {
    constructor(*hash<auto> opts) : ServerSentEventHandler::ServerSentEventHandler(opts) {
    }

    ServerSentEventHandler::ServerSentEventConnection getConnectionImpl(Socket sock, hash<auto> cx, hash<auto> hdr,
            string cid) {
        return new OverflowSseConnection(self, sock, cx, hdr, cid);
    }
}

public class Main inherits QUnit::Test {
    public {
        HttpServer http;
        ServerSentEventHandler sse;
        Logger logger;
        int port;
    }

    constructor() : Test("ServerSentEventsHandlerTest", "1.0") {
        @debug {
            set_signal_handler(SIGUSR1, sub (int sig) {
                printf("=== SIGUSR1 Thread Stacks ===\n%Y\n", get_all_thread_call_stacks());
            });
        }
        addTestCase("SSE response status", \sseResponseStatusTest());
        addTestCase("main test", \mainTest());
        addTestCase("SSE client disconnect deregisters connection", \sseClientDisconnectDeregistersTest());
        addTestCase("SSE deterministic shutdown", \sseDeterministicShutdownTest());
        addTestCase("SSE multiple connections shutdown", \sseMultipleConnectionsShutdownTest());
        addTestCase("SSE shutdown during data delivery", \sseShutdownDuringDataTest());
        addTestCase("SSE max_queue_size drops slow client", \sseMaxQueueSizeDropsTest());

        logger = new Logger("test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }
        sse = new ServerSentEventHandler({
            "logger": logger,
        });
        hash<HttpServerOptionInfo> http_opts = <HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        };
        http = new HttpServer(http_opts);
        on_exit http.stop();
        http.setHandler("sse-handler", "", NOTHING, sse);
        http.setDefaultHandler("sse-handler", sse);
        port = http.addListener(<HttpListenerOptionInfo>{"service": 0}).port;

        # Return for compatibility with test harness that checks return value.
        set_return_value(main());
    }

    checkModule() {
    }

    mainTest() {
        checkModule();

        ServerSentEventClient client({
            "url": "sse://localhost:" + port,
        });

        MyObserver observer();
        client.registerObserver(observer);
        client.observersReady();

        # Wait for the server to register the connection before sending
        # (the client may report connected before the server has registered it)
        # Use more retries for slow CI environments
        int retries = 0;
        while (!sse.getConnectionIds() && retries < 100) {
            usleep(100ms);
            ++retries;
        }
        if (!sse.getConnectionIds()) {
            throw "TEST-ERROR", "Server did not register connection in time";
        }

        # Wait for the connected event to ensure the client is fully ready to receive events
        observer.waitForConnected();

        # Brief delay to ensure the server's I/O loop has started polling the queue.
        # The connection is registered in doNewConnection() BEFORE the I/O loop starts,
        # so getConnectionIds() becoming non-empty doesn't guarantee the loop is running.
        # NOTE: A more deterministic approach would require modifying the handler to send
        # a signal when the I/O loop starts, but this adds unnecessary complexity for tests.
        usleep(100ms);

        string str = get_random_string(50);
        hash<SseMessageInfo> event = <SseMessageInfo>{
            "event": "event",
            "data": str,
            "id": 1,
        };
        sse.sendAll(event);

        hash<SseMessageInfo> event0 = observer.wait();
        assertEq(event, event0);
    }

    sseResponseStatusTest() {
        checkModule();

        Socket s();
        s.connect("localhost:" + port);
        on_exit s.close();
        s.send("GET / HTTP/1.1\r\nHost: localhost\r\nAccept: " + MimeTypeSse + "\r\n\r\n");
        hash<auto> rh = s.readHTTPHeader();
        assertEq(200, rh.status_code);
        string ct = rh."content-type" ?? rh."Content-Type";
        assertTrue(ct && ct.lwr().startsWith(MimeTypeSse), "SSE Content-Type expected");
    }

    sseClientDisconnectDeregistersTest() {
        checkModule();

        ServerSentEventHandler test_sse({"logger": logger});
        hash<HttpServerOptionInfo> test_opts = <HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        };
        HttpServer test_http(test_opts);
        on_exit test_http.stop();
        test_http.setHandler("sse-handler", "", NOTHING, test_sse);
        test_http.setDefaultHandler("sse-handler", test_sse);
        int test_port = test_http.addListener(<HttpListenerOptionInfo>{"service": 0}).port;

        ServerSentEventClient client({"url": "sse://localhost:" + test_port});
        MyObserver observer();
        client.registerObserver(observer);
        client.observersReady();

        int retries = 0;
        while (!test_sse.getConnectionIds() && retries < 100) {
            usleep(50ms);
            ++retries;
        }
        assertEq(1, test_sse.getConnectionIds().size(), "SSE connection should be registered");
        observer.waitForConnected();

        client.disconnect();

        retries = 0;
        while (test_sse.getConnectionIds().size() > 0 && retries < 100) {
            usleep(50ms);
            ++retries;
        }
        assertEq(0, test_sse.getConnectionIds().size(),
            "SSE connection should be deregistered after client disconnect");
    }

    #! Verifies that stop() completes deterministically with an active SSE connection.
    #! Before the stopStreaming() fix, the handler pool's stopWait() would block
    #! indefinitely because the SSE handler's polling loop was never signaled to stop.
    sseDeterministicShutdownTest() {
        checkModule();

        # Create a dedicated server for this test (separate from the shared one)
        ServerSentEventHandler test_sse({"logger": logger});
        hash<HttpServerOptionInfo> test_opts = <HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        };
        HttpServer test_http(test_opts);
        on_exit test_http.stop();
        test_http.setHandler("sse-handler", "", NOTHING, test_sse);
        test_http.setDefaultHandler("sse-handler", test_sse);
        int test_port = test_http.addListener(<HttpListenerOptionInfo>{"service": 0}).port;

        # Establish an SSE connection
        ServerSentEventClient client({"url": "sse://localhost:" + test_port});
        on_exit delete client;
        MyObserver observer();
        client.registerObserver(observer);
        client.observersReady();

        # Wait for the server to register the connection
        int retries = 0;
        while (!test_sse.getConnectionIds() && retries < 100) {
            usleep(100ms);
            ++retries;
        }
        assertTrue(test_sse.getConnectionIds().size() > 0, "SSE connection should be registered");
        observer.waitForConnected();

        # Brief delay so the handler's polling loop is running
        usleep(250ms);

        # Stop the server in a background thread with a timeout guard;
        # before the fix this would hang indefinitely
        Queue stopped();
        background sub () {
            test_http.stop();
            stopped.push(True);
        }();
        assertTrue(stopped.get(10s) != NOTHING,
            "server.stop() should complete deterministically with active SSE connection");
    }

    #! Verifies deterministic shutdown with multiple concurrent SSE connections.
    sseMultipleConnectionsShutdownTest() {
        checkModule();

        ServerSentEventHandler test_sse({"logger": logger});
        hash<HttpServerOptionInfo> test_opts = <HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        };
        HttpServer test_http(test_opts);
        on_exit test_http.stop();
        test_http.setHandler("sse-handler", "", NOTHING, test_sse);
        test_http.setDefaultHandler("sse-handler", test_sse);
        int test_port = test_http.addListener(<HttpListenerOptionInfo>{"service": 0}).port;

        # Establish multiple SSE connections
        int num_clients = 3;
        list<ServerSentEventClient> clients;
        on_exit delete clients;
        list<MyObserver> observers;
        for (int i = 0; i < num_clients; ++i) {
            MyObserver obs();
            ServerSentEventClient c({"url": "sse://localhost:" + test_port});
            c.registerObserver(obs);
            c.observersReady();
            clients += c;
            observers += obs;
        }

        # Wait for all connections to be registered
        int retries = 0;
        while (test_sse.getConnectionIds().size() < num_clients && retries < 100) {
            usleep(100ms);
            ++retries;
        }
        assertEq(num_clients, test_sse.getConnectionIds().size(),
            "all SSE connections should be registered");

        # Wait for all clients to be connected
        foreach MyObserver obs in (observers) {
            obs.waitForConnected();
        }
        usleep(250ms);

        # Stop the server — all SSE handlers must exit deterministically
        Queue stopped();
        background sub () {
            test_http.stop();
            stopped.push(True);
        }();
        assertTrue(stopped.get(10s) != NOTHING,
            "server.stop() should complete with multiple SSE connections");
    }

    #! Verifies that stop() works cleanly when an SSE handler is actively sending data.
    sseShutdownDuringDataTest() {
        checkModule();

        ServerSentEventHandler test_sse({"logger": logger});
        hash<HttpServerOptionInfo> test_opts = <HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        };
        HttpServer test_http(test_opts);
        on_exit test_http.stop();
        test_http.setHandler("sse-handler", "", NOTHING, test_sse);
        test_http.setDefaultHandler("sse-handler", test_sse);
        int test_port = test_http.addListener(<HttpListenerOptionInfo>{"service": 0}).port;

        # Establish an SSE connection
        ServerSentEventClient client({"url": "sse://localhost:" + test_port});
        on_exit delete client;
        MyObserver observer();
        client.registerObserver(observer);
        client.observersReady();

        # Wait for connection registration
        int retries = 0;
        while (!test_sse.getConnectionIds() && retries < 100) {
            usleep(100ms);
            ++retries;
        }
        assertTrue(test_sse.getConnectionIds().size() > 0, "SSE connection should be registered");
        observer.waitForConnected();
        usleep(250ms);

        # Start sending data in a background thread while stopping the server
        bool stop_sender = False;
        Counter sender_done(1);
        on_exit {
            stop_sender = True;
            sender_done.waitForZero(5s);
        }
        background sub () {
            on_exit sender_done.dec();
            int seq = 0;
            while (!stop_sender) {
                try {
                    test_sse.sendAll(<SseMessageInfo>{
                        "event": "tick",
                        "data": string(++seq),
                    });
                } catch () {
                    break;
                }
                usleep(50ms);
            }
        }();

        # Give the sender a moment to start
        usleep(100ms);

        # Stop the server while data is being sent
        Queue stopped();
        background sub () {
            test_http.stop();
            stopped.push(True);
        }();
        assertTrue(stopped.get(10s) != NOTHING,
            "server.stop() should complete while SSE data is being sent");
    }

    #! a slow/non-reading client whose outbound queue exceeds max_queue_size is dropped to protect server memory
    sseMaxQueueSizeDropsTest() {
        checkModule();
        # control: with no limit (0) the over-queue connection is NOT dropped
        assertFalse(runMaxQueueScenario(0), "with no limit, the over-queue connection stays registered");
        # with the limit set, the over-limit connection IS dropped on the next send
        assertTrue(runMaxQueueScenario(5), "with max_queue_size set, the over-limit connection is dropped");
    }

    #! sets up a handler whose connections always report an over-limit queue; sends once and returns True if the
    #! connection was dropped (deregistered), False if it stayed registered
    private bool runMaxQueueScenario(int mqs) {
        OverflowSseHandler h({"logger": logger, "max_queue_size": mqs});
        HttpServer hs(<HttpServerOptionInfo>{"logger": logger, "debug": True});
        on_exit hs.stop();
        hs.setHandler("sse-handler", "", NOTHING, h);
        hs.setDefaultHandler("sse-handler", h);
        int p = hs.addListener(<HttpListenerOptionInfo>{"service": 0}).port;

        # connect a raw SSE client and wait for server-side registration
        Socket s();
        s.connect("localhost:" + p);
        on_exit s.close();
        s.send("GET / HTTP/1.1\r\nHost: localhost\r\nAccept: " + MimeTypeSse + "\r\n\r\n");
        assertEq(200, s.readHTTPHeader().status_code);

        int retries = 0;
        while (!h.getConnectionIds() && retries < 100) {
            usleep(100ms);
            ++retries;
        }
        if (!h.getConnectionIds()) {
            throw "TEST-ERROR", "connection not registered in time";
        }

        # one send: the connection reports an over-limit queue, so a configured limit drops it here
        h.sendAll(<SseMessageInfo>{"data": "x"});

        if (!mqs) {
            # no limit: nothing tears the connection down, so it is still registered immediately after the send
            return !h.getConnectionIds();
        }
        # limit set: the dropped connection's stream is aborted and the async I/O controller deregisters it
        # (bounded wait, matching this test's registration-wait pattern)
        retries = 0;
        while (h.getConnectionIds() && retries < 100) {
            usleep(100ms);
            ++retries;
        }
        return !h.getConnectionIds();
    }
}

class MyObserver inherits Observer {
    public {
        list<hash<auto>> l();
    }

    private {
        Mutex m();
        Condition cond();
        int waiting;
    }

    update(string event_id, hash<auto> data_) {
        m.lock();
        on_exit m.unlock();

        l += {
            "id": event_id,
            "data": data_,
        };

        if (waiting) {
            cond.broadcast();
        }
    }

    hash<SseMessageInfo> wait() {
        date start = now_us();

        m.lock();
        on_exit m.unlock();

        while (True) {
            ++waiting;
            cond.wait(m, 1s);
            --waiting;
            date d = now_us() - start;
            if (d > 10s) {
                throw "ERROR", sprintf("no matching data received in timeout; l: %y", l);
            }
            foreach hash<auto> h in (l) {
                if (h.id == EVENT_SSE_DATA) {
                    return h."data";
                }
            }
        }
    }

    # Wait for the connected event to ensure the client is fully ready
    waitForConnected() {
        date start = now_us();

        m.lock();
        on_exit m.unlock();

        while (True) {
            foreach hash<auto> h in (l) {
                if (h.id == EVENT_SSE_CONNECTED) {
                    return;
                }
            }
            date d = now_us() - start;
            if (d > 10s) {
                throw "ERROR", sprintf("connected event not received in timeout; l: %y", l);
            }
            ++waiting;
            cond.wait(m, 1s);
            --waiting;
        }
    }

    clear() {
        m.lock();
        on_exit m.unlock();

        remove l;
    }
}
