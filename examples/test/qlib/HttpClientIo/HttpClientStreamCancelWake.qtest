    Tests that HttpClientStreamHandle::cancel() promptly wakes a reader
    blocked in data_channel.recv() on H2 and H3 streams — and that an
    H3 reader which calls readData() again after end_stream sees the
    channel closed (via action->complete()) rather than blocking.
*/

%modern

%requires ../../../../qlib/HttpServerUtil.qm
%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Mime.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/AsyncSocketIo
%requires ../../../../qlib/HttpServerAsyncIo
%requires ../../../../qlib/HttpServer.qm
%requires ../../../../qlib/HttpClientIo

%exec-class HttpClientStreamCancelWakeTest

