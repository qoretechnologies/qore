#! Handler that blocks until the test releases it — used to keep the client's
#! stream pending so the client's reader stays parked in data_channel.recv().
#! Using a Counter (not sleep/usleep) so the handler thread exits immediately
#! on teardown instead of waiting out a fixed delay.
class HangingStreamHandler inherits AbstractHttpRequestHandler {
    private {
        Counter m_stop;
    }

    constructor() {
        m_stop = new Counter(1);
    }

    signalStop() {
        m_stop.dec();
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        # Block until the test releases us.  The client never sees a response
        # header, so its data_channel stays empty and readData() blocks in
        # recv().  Cancel from the client side should close the channel and
        # wake the reader without needing this handler to return.
        m_stop.waitForZero(60s);
        return makeResponse(200, "never-reached",
            {"Content-Type": "text/plain"});
    }
}

#! Handler that returns a small complete response — used to test that
#! readData() after end_stream returns cleanly instead of blocking.
class CompleteResponseHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, "hello",
            {"Content-Type": "text/plain"});
    }
}

public class HttpClientStreamCancelWakeTest inherits QUnit::Test {
    private {
        #! Max time to wait for the reader to wake after cancel() — well
        #! under the 30s request_timeout.  If the channel close propagates
        #! correctly the reader wakes in single-digit milliseconds.
        const WakeUpBound = 5s;
    }

    constructor() : Test("HttpClientStreamCancelWakeTest", "1.0") {
        addTestCase("H2 cancel wakes reader", \h2CancelWakesReader());
        addTestCase("H3 cancel wakes reader", \h3CancelWakesReader());
        addTestCase("H3 readData after end_stream returns cleanly",
            \h3ReadAfterEndStream());
        set_return_value(main());
    }

    #! Runs one cancel-wake scenario against an HTTPS listener of the given
    #! protocol.  Returns the elapsed time from cancel submission to the
    #! background reader returning.
    private date runCancelWake(string protocol) {
        Logger logger("test",
            m_options.verbose > 2
                ? LoggerLevel::getLevelDebug()
                : LoggerLevel::getLevelInfo());

        HangingStreamHandler handler();
        HttpServer server(<HttpServerOptionInfo>{"logger": logger, "debug": True});
        server.setDefaultHandler("hang", handler);
        server.waitForAsyncIo();
        hash<auto> info = server.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
            "enable_h3": True,
        });
        server.waitForAsyncIo();
        # Release the handler thread before the server teardown so shutdown
        # doesn't wait on the handler pool.
        on_exit {
            handler.signalStop();
            delete server;
        }

        string url = sprintf("https://127.0.0.1:%d", info.port);

        HttpClientIo::HttpClientConnectionManager mgr(
            <HttpClientIo::HttpClientConnectionManagerOptions>{
                "protocol": protocol,
                "accept_all_certs": True,
                "logger": logger,
                "request_timeout": 30s,
                "connect_timeout": 15s,
            });
        on_exit delete mgr;

        HttpClientIo::HttpClientStreamHandle sh =
            mgr.acquireAndStartStreaming(url, "GET", "/", NOTHING, False);

        # Background reader — will block in data_channel.recv() because the
        # server's HangingInputStream never yields data.
        Counter reader_done(1);
        date reader_elapsed;
        background sub () {
            date start = now_us();
            try {
                sh.readData(30s);
            } catch (hash<ExceptionInfo> ex) {
                # Expected — HTTPCLIENT-STREAM-CLOSED or similar when the
                # channel closes.  We only care about wake latency here.
            }
            reader_elapsed = now_us() - start;
            reader_done.dec();
        }();

        # Give the reader time to enter recv() before cancelling.  This is
        # deterministic because the handler never produces output, so the
        # channel stays empty until we cancel.
        usleep(500ms);
        sh.cancel();

        # Reader must return — if the channel wake is broken, this waits
        # out the full 30s request_timeout.
        reader_done.waitForZero(35s);
        return reader_elapsed;
    }

    h2CancelWakesReader() {
        date elapsed = runCancelWake("h2");
        assertTrue(elapsed < WakeUpBound,
            sprintf("H2 reader woke within %y (actual: %y)", WakeUpBound, elapsed));
    }

    h3CancelWakesReader() {
        date elapsed = runCancelWake("h3");
        assertTrue(elapsed < WakeUpBound,
            sprintf("H3 reader woke within %y (actual: %y)", WakeUpBound, elapsed));
    }

    #! After end_stream arrives normally, the ChannelAction::complete() call
    #! must close the data channel so a subsequent readData() does not
    #! block forever.  Without the H3 action->complete() fix, this test
    #! hangs until the 5s readData timeout.
    h3ReadAfterEndStream() {
        Logger logger("test",
            m_options.verbose > 2
                ? LoggerLevel::getLevelDebug()
                : LoggerLevel::getLevelInfo());

        HttpServer server(<HttpServerOptionInfo>{"logger": logger, "debug": True});
        server.setDefaultHandler("ok", new CompleteResponseHandler());
        server.waitForAsyncIo();
        hash<auto> info = server.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
            "enable_h3": True,
        });
        server.waitForAsyncIo();
        on_exit delete server;

        string url = sprintf("https://127.0.0.1:%d", info.port);
        HttpClientIo::HttpClientConnectionManager mgr(
            <HttpClientIo::HttpClientConnectionManagerOptions>{
                "protocol": "h3",
                "accept_all_certs": True,
                "logger": logger,
                "request_timeout": 30s,
                "connect_timeout": 15s,
            });
        on_exit delete mgr;

        HttpClientIo::HttpClientStreamHandle sh =
            mgr.acquireAndStartStreaming(url, "GET", "/", NOTHING, False);

        # Drain until we see end_stream
        bool saw_end_stream = False;
        for (int i = 0; i < 20; ++i) {
            auto rv = sh.readData(5s);
            if (rv.typeCode() == NT_HASH && rv.end_stream) {
                saw_end_stream = True;
                break;
            }
        }
        assertTrue(saw_end_stream, "reader observed end_stream");

        # One more readData() — the channel should be closed by
        # action->complete(), so this must NOT block the full 5s.
        # If H-D is unfixed, recv waits out the timeout and returns NOTHING.
        date start = now_us();
        try {
            sh.readData(5s);
        } catch (hash<ExceptionInfo> ex) {
            # HTTPCLIENT-STREAM-CLOSED is acceptable.
        }
        date elapsed = now_us() - start;
        assertTrue(elapsed < 2s,
            sprintf("readData after end_stream returned within 2s (actual: %y)",
                elapsed));
    }
}
