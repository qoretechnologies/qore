    HTTP/1.1 fallback for HTTPS endpoints that do not negotiate HTTP/2 via ALPN.

    Some TLS servers complete the handshake but never negotiate ALPN at all
    (Salesforce's OAuth2 token endpoint is one), so the happy-eyeballs race
    loses both legs: HTTP/3 has no QUIC listener and HTTP/2 gets a null ALPN
    result.  HTTP/1.1 is then the only protocol the endpoint speaks, and these
    tests pin down when the client is allowed to conclude that — and, just as
    importantly, when it is not.
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/HttpServerUtil.qm
%requires ../../../../qlib/HttpServer.qm
%requires ../../../../qlib/HttpClientIo
%requires ../../TestCertificates.qm

%exec-class HttpClientIoAlpnFallbackTest

#! Handler for the HTTP/2-capable reference server
class SimpleGetHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, "OK", {"Content-Type": "text/plain"});
    }
}

#! Advertises QUIC on an unavailable UDP port while serving requests over HTTP/2
class AltSvcGetHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, "OK", {"Content-Type": "text/plain", "Alt-Svc": "h3=\":1\""});
    }
}

#! Exposes protocol decisions under the same locks used by production callers
class AltSvcTestManager inherits HttpClientIo::HttpClientConnectionManager {
    constructor(*hash<HttpClientIo::HttpClientConnectionManagerOptions> opts)
            : HttpClientIo::HttpClientConnectionManager(opts) {
    }

    advertise(string url, string header) {
        checkAltSvc(url, {"headers": {"alt-svc": header}});
    }

    seed(string url, string protocol, date age) {
        hash<UrlInfo> info = parse_url(url);
        string key = sprintf("%s:%d", info.host, info.port ?? 443);
        AutoWriteLock al(pool_lock);
        cacheProtocol(key, protocol);
        h3_probe_times{key} = now_us() - age;
        if (protocol == "h1") {
            h1_probe_times{key} = now_us() - age;
        }
    }

    string selectProtocol(string url) {
        hash<UrlInfo> info = parse_url(url);
        info.port = info.port ?? 443;
        AutoWriteLock al(pool_lock);
        return resolveProtocol(info, sprintf("%s:%d", info.host, info.port));
    }

    *string cached(string url) {
        hash<UrlInfo> info = parse_url(url);
        AutoReadLock al(pool_lock);
        return protocol_cache{sprintf("%s:%d", info.host, info.port ?? 443)};
    }

    disconnect() {
        AutoWriteLock al(pool_lock);
        foreach auto conns in (pool.iterator()) {
            foreach HttpClientIo::HttpClientConnection conn in (conns) {
                conn.close();
            }
        }
        pool = {};
    }

    int probePort(string url) {
        hash<UrlInfo> info = parse_url(url);
        info.port = info.port ?? 443;
        return prepareH3Probe(info, sprintf("%s:%d", info.host, info.port)).port;
    }
}

#! A raw TLS server with configurable ALPN behavior that speaks only HTTP/1.1
/** With @c alpn set to @ref NOTHING the accepted socket never gets any ALPN
    protocol list, so OpenSSL's selection callback answers
    \c SSL_TLSEXT_ERR_NOACK and the client's negotiated protocol is null — the
    exact behavior of the HTTPS endpoints this fallback exists for.

    Every response carries \c "Connection: close", so each request needs a fresh
    TCP connection and @ref getConnectionCount() is a direct measure of how many
    connection attempts the client's protocol selection made.
*/
class AlpnTestServer {
    public {
        #! Timeout for reading a request header from an accepted connection
        const RequestTimeout = 10s;
    }

    private {
        Socket listener();
        int port;

        #! ALPN protocols to offer; NOTHING means ALPN is not negotiated at all
        *softlist<string> alpn;

        #! Guards the counters and the stopping flag
        Mutex m();
        int connection_count = 0;
        int request_count = 0;
        bool stopping = False;

        #! Accept loop + one counter tick per in-flight connection handler
        Counter running(1);
        Counter handlers();
    }

    constructor(string cert_pem, string key_pem, *softlist<string> alpn) {
        self.alpn = alpn;
        listener.setCertificate(new SSLCertificate(cert_pem));
        listener.setPrivateKey(new SSLPrivateKey(key_pem));
        listener.bind("localhost:0", True);
        listener.listen();
        port = listener.getPort();
        background serve();
    }

    destructor() {
        stop();
    }

    string getUrl() {
        return "https://localhost:" + port;
    }

    #! Returns the number of TCP connections accepted so far
    int getConnectionCount() {
        AutoLock al(m);
        return connection_count;
    }

    #! Returns the number of HTTP/1.1 requests served so far
    int getRequestCount() {
        AutoLock al(m);
        return request_count;
    }

    #! Resets both counters
    reset() {
        AutoLock al(m);
        connection_count = 0;
        request_count = 0;
    }

    #! Stops the accept loop and waits for all connection handlers to finish
    /** The accept loop is unblocked with a throwaway connection rather than a
        timed wait, so teardown is deterministic.
    */
    stop() {
        {
            AutoLock al(m);
            if (stopping) {
                return;
            }
            stopping = True;
        }
        try {
            Socket s();
            s.connect("localhost:" + port);
            s.close();
        } catch (hash<ExceptionInfo> ex) {
            # the accept loop has already exited
        }
        running.waitForZero();
        handlers.waitForZero();
        try { listener.close(); } catch () {}
    }

    private serve() {
        on_exit running.dec();
        while (True) {
            Socket client;
            try {
                client = listener.accept();
            } catch (hash<ExceptionInfo> ex) {
                break;
            }
            {
                AutoLock al(m);
                if (stopping) {
                    break;
                }
                ++connection_count;
            }
            handlers.inc();
            background handleConnection(client);
        }
    }

    private handleConnection(Socket client) {
        on_exit handlers.dec();
        try {
            client.setNoDelay(True);
            if (alpn) {
                client.setAlpnProtocols(alpn);
            }
            client.upgradeServerToSSL();

            # An HTTP/2 client closes the connection here (null ALPN), so this
            # read failing is an expected outcome, not a test failure.
            client.readHTTPHeader(RequestTimeout);
            {
                AutoLock al(m);
                ++request_count;
            }
            string body = "OK";
            client.send(sprintf("HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\n"
                "Content-Length: %d\r\nConnection: close\r\n\r\n%s", body.size(), body));
        } catch (hash<ExceptionInfo> ex) {
            # peer went away or refused the negotiated protocol
        }
        try { client.close(); } catch () {}
    }
}

class HttpClientIoAlpnFallbackTest inherits QUnit::Test {
    private {
        Logger mLogger;

        #! HTTP/2-capable reference server (negotiates h2 via ALPN)
        HttpServer mServer;
        string mH2Url;
        *int mQuicPort;

        const CertPem = TestCertificates::CertPem;

        const KeyPem = TestCertificates::KeyPem;
    }

    constructor() : Test("HttpClientIoAlpnFallbackTest", "1.0") {
        addTestCase("alpn refusal falls back to HTTP/1.1", \alpnRefusalFallsBackToHttp1Test());
        addTestCase("alpn refusal is cached", \alpnRefusalIsCachedTest());
        addTestCase("explicit h2 is not downgraded", \explicitHttp2IsNotDowngradedTest());
        addTestCase("explicit h1 skips the h2 probe", \explicitHttp1SkipsProbeTest());
        addTestCase("only a definitive refusal pins h1", \definitiveRefusalRuleTest());
        addTestCase("h2-capable server keeps using h2", \h2CapableServerKeepsUsingH2Test());
        addTestCase("the h1 fallback is per host", \fallbackIsPerHostTest());
        addTestCase("Alt-Svc preserves negotiated protocols and cooldowns", \altSvcSelectionTest());
        addTestCase("Alt-Svc validates and applies alternate UDP ports", \altSvcPortTest());
        addTestCase("sync responses preserve working h2 connections", \altSvcSyncPoolTest());
        addTestCase("async responses preserve working h2 connections", \altSvcAsyncPoolTest());
        addTestCase("sync race uses the advertised QUIC port", \altSvcSyncRaceTest());
        addTestCase("async race uses the advertised QUIC port", \altSvcAsyncRaceTest());
        set_return_value(main());
    }

    globalSetUp() {
        LoggerLevel level = m_options.verbose > 2
            ? LoggerLevel::getLevelDebug()
            : LoggerLevel::getLevelInfo();
        mLogger = new Logger("alpn-fallback-test", level);
        if (m_options.verbose > 1) {
            mLogger.addAppender(new StdoutAppender());
        }

        mServer = new HttpServer(<HttpServerOptionInfo>{
            "logger": mLogger,
            "debug": True,
        });
        mServer.setHandler("simple", "/simple", NOTHING, new SimpleGetHandler());
        mServer.setHandler("alt-svc", "/alt-svc", NOTHING, new AltSvcGetHandler());
        int ssl_port = mServer.addListener(<HttpListenerOptionInfo>{
            "service": 0, "enable_h3": False,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        }).port;
        mH2Url = "https://127.0.0.1:" + ssl_port;
        try {
            mQuicPort = mServer.addQuicListener(<HttpListenerOptionInfo>{
                "cert": new SSLCertificate(CertPem),
                "key": new SSLPrivateKey(KeyPem),
            }).port;
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "QUIC-NOT-SUPPORTED") {
                rethrow;
            }
        }
        mServer.waitForAsyncIo();
    }

    globalTearDown() {
        if (mServer) {
            mServer.stop();
        }
    }

    altSvcSelectionTest() {
        AltSvcTestManager mgr();
        string url = "https://example.com:443";
        mgr.advertise(url, "h3=\":443\"");
        assertEq(NOTHING, mgr.cached(url), "advertisements cannot claim a successful handshake");
        assertEq("happy-eyeballs", mgr.selectProtocol(url));
        foreach string protocol in (("h1", "h2")) {
            mgr.seed(url, protocol, 0s);
            mgr.advertise(url, "h3=\":8443\"");
            assertEq(protocol, mgr.cached(url), "keep the negotiated result");
            assertEq(protocol, mgr.selectProtocol(url), "advertisement must not reset the cooldown");
            mgr.seed(url, protocol, 60m);
            mgr.advertise(url, "h3=\":8443\"");
            assertEq("happy-eyeballs", mgr.selectProtocol(url), "expired cache races both protocols");
        }
        AltSvcTestManager proxied(<HttpClientIo::HttpClientConnectionManagerOptions>{
            "proxy_url": "http://localhost:8080",
        });
        proxied.advertise(url, "h3=\":8443\"");
        assertEq("h2", proxied.selectProtocol(url), "proxy connections do not attempt QUIC");
        assertEq(443, proxied.probePort(url), "proxy ignores alternate UDP ports");
        mgr.seed(url, "h3", 0s);
        assertEq("happy-eyeballs", mgr.selectProtocol(url), "new connections recheck QUIC reachability");
        foreach string protocol in (("h1", "h2", "h3")) {
            AltSvcTestManager forced(<HttpClientIo::HttpClientConnectionManagerOptions>{"protocol": protocol});
            forced.advertise(url, "h3=\":8443\"");
            assertEq(protocol, forced.selectProtocol(url), "explicit selection is respected");
            assertEq(NOTHING, forced.cached(url));
        }
    }

    altSvcPortTest() {
        string url = "https://example.com:443";
        AltSvcTestManager mgr();
        foreach string header in (("h3=\"other.example:8443\"", "h3=\":0\"", "h3=\":65536\"", "garbage")) {
            mgr.advertise(url, header);
            assertEq(443, mgr.probePort(url), "invalid or cross-host alternatives are ignored");
        }
        mgr.advertise(url, "h2=\":443\", h3=\":8443\"");
        assertEq(8443, mgr.probePort(url), "QUIC uses the advertised UDP port");
        mgr.advertise(url, "h3=\"example.com:443\"");
        assertEq(443, mgr.probePort(url), "same-port advertisement clears stale alternate port");
        mgr.advertise("https://[::1]:443", "h3=\"[::1]:8443\"");
        assertEq(8443, mgr.probePort("https://[::1]:443"), "IPv6 same-host alternative");
        mgr.advertise("http://example.com:80", "h3=\":8443\"");
        assertEq(80, mgr.probePort("http://example.com:80"), "plain HTTP ignores advertisements");
    }

    altSvcSyncRaceTest() {
        altSvcRaceTest(False);
    }

    altSvcAsyncRaceTest() {
        altSvcRaceTest(True);
    }

    private altSvcRaceTest(bool use_async) {
        if (!mQuicPort) {
            testSkip("QUIC is not supported by this build");
        }
        AltSvcTestManager mgr(<HttpClientIo::HttpClientConnectionManagerOptions>{"accept_all_certs": True, "connect_timeout": 2s, "request_timeout": 5s});
        mgr.seed(mH2Url, "h2", 60m);
        mgr.advertise(mH2Url, sprintf("h3=\":%d\"", mQuicPort));
        connectAndRequest(mgr, use_async);
        assertEq("h3", mgr.cached(mH2Url), "ready QUIC on the alternate port wins the reprobe");
        mgr.disconnect();
        mgr.advertise(mH2Url, "h3=\":1\"");
        connectAndRequest(mgr, use_async);
        assertEq("h2", mgr.cached(mH2Url), "a previous H3 win cannot pin an unreachable QUIC endpoint");
    }

    private connectAndRequest(AltSvcTestManager mgr, bool use_async) {
        if (use_async) {
            *HttpClientIo::HttpClientConnection conn;
            *EventNotifier n = mgr.acquireConnectionAsync(mH2Url, \conn);
            date deadline = now_us() + 5s;
            while (n) {
                assertTrue(now_us() < deadline, "asynchronous race completes within its deadline");
                mgr.getController().waitForNotifier(n, 5s, 5s);
                n.acknowledge();
                delete n;
                n = mgr.acquireConnectionAsync(mH2Url, \conn);
            }
            assertTrue(conn.isReady(), "only a ready connection wins");
        }
        assertEq(200, mgr.request(mH2Url, "GET", "/simple").status_code);
    }

    altSvcSyncPoolTest() {
        altSvcPoolTest(False);
    }

    altSvcAsyncPoolTest() {
        altSvcPoolTest(True);
    }

    private altSvcPoolTest(bool use_async) {
        AltSvcTestManager mgr(<HttpClientIo::HttpClientConnectionManagerOptions>{"accept_all_certs": True, "connect_timeout": 2s, "request_timeout": 5s});
        for (int i = 0; i < 3; ++i) {
            hash<auto> resp = use_async
                ? mgr.requestAsync(mH2Url, "GET", "/alt-svc").get(5s)
                : mgr.request(mH2Url, "GET", "/alt-svc");
            assertEq(200, resp.status_code);
            assertEq("h2", mgr.cached(mH2Url), "only the ready H2 winner is cached");
            hash<auto> stats = mgr.getStats();
            assertEq(1, stats.total_connections, "reuse the winning connection despite Alt-Svc");
            assertEq(1, stats.total_usable_connections, "advertisement does not drain the connection");
        }
    }

    #! Returns a manager with the given protocol option
    private HttpClientIo::HttpClientConnectionManager getManager(*string protocol) {
        hash<HttpClientIo::HttpClientConnectionManagerOptions> opts = <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "logger": mLogger,
        };
        if (protocol) {
            opts.protocol = protocol;
        }
        return new HttpClientIo::HttpClientConnectionManager(opts);
    }

    #! A server that ignores ALPN must still be reachable over HTTP/1.1
    /** The request is served by a raw HTTP/1.1 server, so a 200 with the
        expected body is itself proof that the client spoke HTTP/1.1: an HTTP/2
        connection preface would never have been parsed as a request line.
    */
    alpnRefusalFallsBackToHttp1Test() {
        AlpnTestServer server(CertPem, KeyPem);
        on_exit server.stop();

        {
            HttpClientIo::HttpClientConnectionManager mgr = getManager();
            HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(server.getUrl());
            hash<auto> resp = stream.request("GET", "/");
            assertEq(200, resp.status_code, "request to a non-ALPN server succeeds");
            assertEq("OK", resp.body, "response served over HTTP/1.1");
        }

        assertEq(1, server.getRequestCount(), "exactly one HTTP request reached the server");
        # one connection for the H2 candidate (refused via ALPN) and one for the
        # HTTP/1.1 fallback; the H3 candidate is UDP and never reaches the listener
        assertEq(2, server.getConnectionCount(), "h2 attempt plus the h1 fallback");
    }

    #! The refusal is remembered, so later connections go straight to HTTP/1.1
    alpnRefusalIsCachedTest() {
        AlpnTestServer server(CertPem, KeyPem);
        on_exit server.stop();

        {
            HttpClientIo::HttpClientConnectionManager mgr = getManager();
            for (int i = 0; i < 3; ++i) {
                HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(server.getUrl());
                hash<auto> resp = stream.request("GET", "/");
                assertEq(200, resp.status_code, sprintf("request %d succeeds", i + 1));
            }
        }

        assertEq(3, server.getRequestCount(), "all three requests reached the server");
        # request 1 probes H2 and falls back (2 connections); requests 2 and 3
        # read the cached fallback and connect once each.  Every response closes
        # the connection, so none of them can be served from the pool.
        assertEq(4, server.getConnectionCount(), "the h2 probe is not repeated per request");
    }

    #! An explicitly configured protocol must never be silently downgraded
    explicitHttp2IsNotDowngradedTest() {
        AlpnTestServer server(CertPem, KeyPem);
        on_exit server.stop();

        {
            HttpClientIo::HttpClientConnectionManager mgr = getManager("h2");
            assertThrows("HTTPCLIENT-CONNECT-ERROR", "HTTP2-ALPN-ERROR",
                sub () {
                    HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(server.getUrl());
                    stream.request("GET", "/");
                }, NOTHING, "forced h2 against a non-ALPN server fails");
        }

        assertEq(0, server.getRequestCount(), "forced h2 never falls back to HTTP/1.1");
        assertGt(0, server.getConnectionCount(), "the h2 attempt reached the server");
    }

    #! Forcing h1 connects directly, with no HTTP/2 probe at all
    explicitHttp1SkipsProbeTest() {
        AlpnTestServer server(CertPem, KeyPem);
        on_exit server.stop();

        {
            HttpClientIo::HttpClientConnectionManager mgr = getManager("h1");
            HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(server.getUrl());
            hash<auto> resp = stream.request("GET", "/");
            assertEq(200, resp.status_code, "forced h1 request succeeds");
        }

        assertEq(1, server.getRequestCount(), "one request served");
        assertEq(1, server.getConnectionCount(), "no h2 probe when h1 is forced");
    }

    #! Only a definitive ALPN refusal may be treated as "this host cannot do HTTP/2"
    /** The HTTP/1.1 fallback is cached per host, so the rule that decides when
        to cache it has to reject every error that describes the attempt rather
        than the endpoint.  \c HTTP2-ABORT in particular is what a deliberately
        closed connection reports — including the losing leg of a happy-eyeballs
        race that HTTP/3 has just won, which must never pin the host to HTTP/1.1.
    */
    definitiveRefusalRuleTest() {
        assertTrue(HttpClientIo::HttpClientConnectionManager::isDefinitiveH2AlpnRefusal({
            "err": "HTTP2-ALPN-ERROR",
            "desc": "HTTP/2 not negotiated via ALPN: got null",
        }), "a null ALPN result is definitive");

        list<string> transient_errors = (
            "HTTP2-ABORT",
            "HTTP2-EMPTY-READ",
            "HTTP2-CONNECTION-CLOSED",
            "HTTP2-CONNECT-ERROR",
            "HTTP2-ERROR",
            "HTTPCLIENT-CONNECT-ERROR",
            "SOCKET-CONNECT-ERROR",
        );
        foreach string err in (transient_errors) {
            assertFalse(HttpClientIo::HttpClientConnectionManager::isDefinitiveH2AlpnRefusal({"err": err}),
                sprintf("%s must not pin the host to HTTP/1.1", err));
        }

        assertFalse(HttpClientIo::HttpClientConnectionManager::isDefinitiveH2AlpnRefusal(NOTHING),
            "a missing error hash is not a refusal");
        assertFalse(HttpClientIo::HttpClientConnectionManager::isDefinitiveH2AlpnRefusal({}),
            "an empty error hash is not a refusal");
    }

    #! A server that does negotiate h2 must keep getting h2 on every request
    h2CapableServerKeepsUsingH2Test() {
        HttpClientIo::HttpClientConnectionManager mgr = getManager();

        for (int i = 0; i < 3; ++i) {
            HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(mH2Url);
            hash<auto> resp = stream.request("GET", "/simple");
            assertEq(200, resp.status_code, sprintf("h2 request %d succeeds", i + 1));

            list<hash<HttpClientConnectionInfo>> info = mgr.getConnectionInfo(mH2Url);
            assertGt(0, info.size(), sprintf("request %d has a pooled connection", i + 1));
            foreach hash<HttpClientConnectionInfo> ci in (info) {
                assertNeq("h1", ci.protocol,
                    sprintf("request %d must not be downgraded to HTTP/1.1", i + 1));
            }
        }
    }

    #! The fallback is remembered per host:port, not globally
    fallbackIsPerHostTest() {
        AlpnTestServer server(CertPem, KeyPem);
        on_exit server.stop();

        HttpClientIo::HttpClientConnectionManager mgr = getManager();

        # fall back to HTTP/1.1 for the non-ALPN host
        HttpClientIo::HttpClientStreamHandle s1 = mgr.acquireStream(server.getUrl());
        assertEq(200, s1.request("GET", "/").status_code, "non-ALPN host served over HTTP/1.1");

        # the ALPN-capable host on the same manager is unaffected
        HttpClientIo::HttpClientStreamHandle s2 = mgr.acquireStream(mH2Url);
        assertEq(200, s2.request("GET", "/simple").status_code, "h2 host still reachable");

        list<hash<HttpClientConnectionInfo>> info = mgr.getConnectionInfo(mH2Url);
        assertGt(0, info.size(), "h2 host has a pooled connection");
        foreach hash<HttpClientConnectionInfo> ci in (info) {
            assertNeq("h1", ci.protocol, "another host's fallback must not downgrade this one");
        }
    }
}
