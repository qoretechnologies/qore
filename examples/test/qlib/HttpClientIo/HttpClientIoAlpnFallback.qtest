    HTTP/1.1 fallback for HTTPS endpoints that do not negotiate HTTP/2 via ALPN.

    Some TLS servers complete the handshake but never negotiate ALPN at all
    (Salesforce's OAuth2 token endpoint is one), so the happy-eyeballs race
    loses both legs: HTTP/3 has no QUIC listener and HTTP/2 gets a null ALPN
    result.  HTTP/1.1 is then the only protocol the endpoint speaks, and these
    tests pin down when the client is allowed to conclude that — and, just as
    importantly, when it is not.
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Logger
%requires HttpServerUtil
%requires HttpServer
%requires HttpClientIo

%exec-class HttpClientIoAlpnFallbackTest

#! Handler for the HTTP/2-capable reference server
class SimpleGetHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, "OK", {"Content-Type": "text/plain"});
    }
}

#! A raw TLS server with configurable ALPN behavior that speaks only HTTP/1.1
/** With @c alpn set to @ref NOTHING the accepted socket never gets any ALPN
    protocol list, so OpenSSL's selection callback answers
    \c SSL_TLSEXT_ERR_NOACK and the client's negotiated protocol is null — the
    exact behavior of the HTTPS endpoints this fallback exists for.

    Every response carries \c "Connection: close", so each request needs a fresh
    TCP connection and @ref getConnectionCount() is a direct measure of how many
    connection attempts the client's protocol selection made.
*/
class AlpnTestServer {
    public {
        #! Timeout for reading a request header from an accepted connection
        const RequestTimeout = 10s;
    }

    private {
        Socket listener();
        int port;

        #! ALPN protocols to offer; NOTHING means ALPN is not negotiated at all
        *softlist<string> alpn;

        #! Guards the counters and the stopping flag
        Mutex m();
        int connection_count = 0;
        int request_count = 0;
        bool stopping = False;

        #! Accept loop + one counter tick per in-flight connection handler
        Counter running(1);
        Counter handlers();
    }

    constructor(string cert_pem, string key_pem, *softlist<string> alpn) {
        self.alpn = alpn;
        listener.setCertificate(new SSLCertificate(cert_pem));
        listener.setPrivateKey(new SSLPrivateKey(key_pem));
        listener.bind("localhost:0", True);
        listener.listen();
        port = listener.getPort();
        background serve();
    }

    destructor() {
        stop();
    }

    string getUrl() {
        return "https://localhost:" + port;
    }

    #! Returns the number of TCP connections accepted so far
    int getConnectionCount() {
        AutoLock al(m);
        return connection_count;
    }

    #! Returns the number of HTTP/1.1 requests served so far
    int getRequestCount() {
        AutoLock al(m);
        return request_count;
    }

    #! Resets both counters
    reset() {
        AutoLock al(m);
        connection_count = 0;
        request_count = 0;
    }

    #! Stops the accept loop and waits for all connection handlers to finish
    /** The accept loop is unblocked with a throwaway connection rather than a
        timed wait, so teardown is deterministic.
    */
    stop() {
        {
            AutoLock al(m);
            if (stopping) {
                return;
            }
            stopping = True;
        }
        try {
            Socket s();
            s.connect("localhost:" + port);
            s.close();
        } catch (hash<ExceptionInfo> ex) {
            # the accept loop has already exited
        }
        running.waitForZero();
        handlers.waitForZero();
        try { listener.close(); } catch () {}
    }

    private serve() {
        on_exit running.dec();
        while (True) {
            Socket client;
            try {
                client = listener.accept();
            } catch (hash<ExceptionInfo> ex) {
                break;
            }
            {
                AutoLock al(m);
                if (stopping) {
                    break;
                }
                ++connection_count;
            }
            handlers.inc();
            background handleConnection(client);
        }
    }

    private handleConnection(Socket client) {
        on_exit handlers.dec();
        try {
            client.setNoDelay(True);
            if (alpn) {
                client.setAlpnProtocols(alpn);
            }
            client.upgradeServerToSSL();

            # An HTTP/2 client closes the connection here (null ALPN), so this
            # read failing is an expected outcome, not a test failure.
            client.readHTTPHeader(RequestTimeout);
            {
                AutoLock al(m);
                ++request_count;
            }
            string body = "OK";
            client.send(sprintf("HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\n"
                "Content-Length: %d\r\nConnection: close\r\n\r\n%s", body.size(), body));
        } catch (hash<ExceptionInfo> ex) {
            # peer went away or refused the negotiated protocol
        }
        try { client.close(); } catch () {}
    }
}

