    constructor() : Test("HttpClientIoAlpnFallbackTest", "1.0") {
        addTestCase("alpn refusal falls back to HTTP/1.1", \alpnRefusalFallsBackToHttp1Test());
        addTestCase("alpn refusal is cached", \alpnRefusalIsCachedTest());
        addTestCase("explicit h2 is not downgraded", \explicitHttp2IsNotDowngradedTest());
        addTestCase("explicit h1 skips the h2 probe", \explicitHttp1SkipsProbeTest());
        addTestCase("only a definitive refusal pins h1", \definitiveRefusalRuleTest());
        addTestCase("h2-capable server keeps using h2", \h2CapableServerKeepsUsingH2Test());
        addTestCase("the h1 fallback is per host", \fallbackIsPerHostTest());
        set_return_value(main());
    }

    globalSetUp() {
        LoggerLevel level = m_options.verbose > 2
            ? LoggerLevel::getLevelDebug()
            : LoggerLevel::getLevelInfo();
        mLogger = new Logger("alpn-fallback-test", level);
        if (m_options.verbose > 1) {
            mLogger.addAppender(new StdoutAppender());
        }

        mServer = new HttpServer(<HttpServerOptionInfo>{
            "logger": mLogger,
            "debug": True,
        });
        mServer.setHandler("simple", "/simple", NOTHING, new SimpleGetHandler());
        int ssl_port = mServer.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        }).port;
        mH2Url = "https://127.0.0.1:" + ssl_port;
        mServer.waitForAsyncIo();
    }

    globalTearDown() {
        if (mServer) {
            mServer.stop();
        }
    }

    #! Returns a manager with the given protocol option
    private HttpClientConnectionManager getManager(*string protocol) {
        hash<HttpClientConnectionManagerOptions> opts = <HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "logger": mLogger,
        };
        if (protocol) {
            opts.protocol = protocol;
        }
        return new HttpClientConnectionManager(opts);
    }

    #! A server that ignores ALPN must still be reachable over HTTP/1.1
    /** The request is served by a raw HTTP/1.1 server, so a 200 with the
        expected body is itself proof that the client spoke HTTP/1.1: an HTTP/2
        connection preface would never have been parsed as a request line.
    */
    alpnRefusalFallsBackToHttp1Test() {
        AlpnTestServer server(CertPem, KeyPem);
        on_exit server.stop();

        {
            HttpClientConnectionManager mgr = getManager();
            HttpClientStreamHandle stream = mgr.acquireStream(server.getUrl());
            hash<auto> resp = stream.request("GET", "/");
            assertEq(200, resp.status_code, "request to a non-ALPN server succeeds");
            assertEq("OK", resp.body, "response served over HTTP/1.1");
        }

        assertEq(1, server.getRequestCount(), "exactly one HTTP request reached the server");
        # one connection for the H2 candidate (refused via ALPN) and one for the
        # HTTP/1.1 fallback; the H3 candidate is UDP and never reaches the listener
        assertEq(2, server.getConnectionCount(), "h2 attempt plus the h1 fallback");
    }

    #! The refusal is remembered, so later connections go straight to HTTP/1.1
    alpnRefusalIsCachedTest() {
        AlpnTestServer server(CertPem, KeyPem);
        on_exit server.stop();

        {
            HttpClientConnectionManager mgr = getManager();
            for (int i = 0; i < 3; ++i) {
                HttpClientStreamHandle stream = mgr.acquireStream(server.getUrl());
                hash<auto> resp = stream.request("GET", "/");
                assertEq(200, resp.status_code, sprintf("request %d succeeds", i + 1));
            }
        }

        assertEq(3, server.getRequestCount(), "all three requests reached the server");
        # request 1 probes H2 and falls back (2 connections); requests 2 and 3
        # read the cached fallback and connect once each.  Every response closes
        # the connection, so none of them can be served from the pool.
        assertEq(4, server.getConnectionCount(), "the h2 probe is not repeated per request");
    }

    #! An explicitly configured protocol must never be silently downgraded
    explicitHttp2IsNotDowngradedTest() {
        AlpnTestServer server(CertPem, KeyPem);
        on_exit server.stop();

        {
            HttpClientConnectionManager mgr = getManager("h2");
            assertThrows("HTTPCLIENT-CONNECT-ERROR", "HTTP2-ALPN-ERROR",
                sub () {
                    HttpClientStreamHandle stream = mgr.acquireStream(server.getUrl());
                    stream.request("GET", "/");
                }, NOTHING, "forced h2 against a non-ALPN server fails");
        }

        assertEq(0, server.getRequestCount(), "forced h2 never falls back to HTTP/1.1");
        assertGt(0, server.getConnectionCount(), "the h2 attempt reached the server");
    }

    #! Forcing h1 connects directly, with no HTTP/2 probe at all
    explicitHttp1SkipsProbeTest() {
        AlpnTestServer server(CertPem, KeyPem);
        on_exit server.stop();

        {
            HttpClientConnectionManager mgr = getManager("h1");
            HttpClientStreamHandle stream = mgr.acquireStream(server.getUrl());
            hash<auto> resp = stream.request("GET", "/");
            assertEq(200, resp.status_code, "forced h1 request succeeds");
        }

        assertEq(1, server.getRequestCount(), "one request served");
        assertEq(1, server.getConnectionCount(), "no h2 probe when h1 is forced");
    }

    #! Only a definitive ALPN refusal may be treated as "this host cannot do HTTP/2"
    /** The HTTP/1.1 fallback is cached per host, so the rule that decides when
        to cache it has to reject every error that describes the attempt rather
        than the endpoint.  \c HTTP2-ABORT in particular is what a deliberately
        closed connection reports — including the losing leg of a happy-eyeballs
        race that HTTP/3 has just won, which must never pin the host to HTTP/1.1.
    */
    definitiveRefusalRuleTest() {
        assertTrue(HttpClientConnectionManager::isDefinitiveH2AlpnRefusal({
            "err": "HTTP2-ALPN-ERROR",
            "desc": "HTTP/2 not negotiated via ALPN: got null",
        }), "a null ALPN result is definitive");

        list<string> transient_errors = (
            "HTTP2-ABORT",
            "HTTP2-EMPTY-READ",
            "HTTP2-CONNECTION-CLOSED",
            "HTTP2-CONNECT-ERROR",
            "HTTP2-ERROR",
            "HTTPCLIENT-CONNECT-ERROR",
            "SOCKET-CONNECT-ERROR",
        );
        foreach string err in (transient_errors) {
            assertFalse(HttpClientConnectionManager::isDefinitiveH2AlpnRefusal({"err": err}),
                sprintf("%s must not pin the host to HTTP/1.1", err));
        }

        assertFalse(HttpClientConnectionManager::isDefinitiveH2AlpnRefusal(NOTHING),
            "a missing error hash is not a refusal");
        assertFalse(HttpClientConnectionManager::isDefinitiveH2AlpnRefusal({}),
            "an empty error hash is not a refusal");
    }

    #! A server that does negotiate h2 must keep getting h2 on every request
    h2CapableServerKeepsUsingH2Test() {
        HttpClientConnectionManager mgr = getManager();

        for (int i = 0; i < 3; ++i) {
            HttpClientStreamHandle stream = mgr.acquireStream(mH2Url);
            hash<auto> resp = stream.request("GET", "/simple");
            assertEq(200, resp.status_code, sprintf("h2 request %d succeeds", i + 1));

            list<hash<HttpClientConnectionInfo>> info = mgr.getConnectionInfo(mH2Url);
            assertGt(0, info.size(), sprintf("request %d has a pooled connection", i + 1));
            foreach hash<HttpClientConnectionInfo> ci in (info) {
                assertNeq("h1", ci.protocol,
                    sprintf("request %d must not be downgraded to HTTP/1.1", i + 1));
            }
        }
    }

    #! The fallback is remembered per host:port, not globally
    fallbackIsPerHostTest() {
        AlpnTestServer server(CertPem, KeyPem);
        on_exit server.stop();

        HttpClientConnectionManager mgr = getManager();

        # fall back to HTTP/1.1 for the non-ALPN host
        HttpClientStreamHandle s1 = mgr.acquireStream(server.getUrl());
        assertEq(200, s1.request("GET", "/").status_code, "non-ALPN host served over HTTP/1.1");

        # the ALPN-capable host on the same manager is unaffected
        HttpClientStreamHandle s2 = mgr.acquireStream(mH2Url);
        assertEq(200, s2.request("GET", "/simple").status_code, "h2 host still reachable");

        list<hash<HttpClientConnectionInfo>> info = mgr.getConnectionInfo(mH2Url);
        assertGt(0, info.size(), "h2 host has a pooled connection");
        foreach hash<HttpClientConnectionInfo> ci in (info) {
            assertNeq("h1", ci.protocol, "another host's fallback must not downgrade this one");
        }
    }
}
