#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires Util
%requires Mime
%requires Logger
%requires HttpServerUtil
%requires HttpServer
%requires HttpClientIo

%exec-class HttpClientResponseStreamTest

class StreamTestHandler inherits AbstractHttpRequestHandler {
    public {
        #! the body served; larger than any buffer and not a multiple of common chunk sizes
        const Body = get_random_bytes(1024 * 1024 + 7);

        #! a body that compresses well
        const TextBody = binary(strmul("stream test data ", 100000));

        #! released by the test to let /slow send its body
        Queue slow_release();
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        string path = cx.raw_path;
        switch (path) {
            case "/file":
                return makeResponse(200, Body, {"Content-Type": MimeTypeOctetStream});
            case "/chunked": {
                int offset = 0;
                return <HttpResponseInfo>{
                    "code": 200,
                    "hdr": {"Content-Type": MimeTypeOctetStream},
                    "send_callback": *binary sub () {
                        if (offset >= Body.size()) {
                            return;
                        }
                        binary rv = Body.substr(offset, 65531);
                        offset += rv.size();
                        return rv;
                    },
                };
            }
            case "/gzip":
            case "/gzip-truncated": {
                binary encoded = gzip(TextBody);
                if (path == "/gzip-truncated") {
                    encoded = encoded.substr(0, encoded.size() / 2);
                }
                hash<HttpResponseInfo> rv = makeResponse(200, encoded, {
                    "Content-Type": MimeTypeOctetStream,
                    "Content-Encoding": "gzip",
                });
                rv.no_content_encoding = True;
                return rv;
            }
            case "/redirect":
                return makeResponse(302, "", {"Location": "/file"});
            case "/redirect-abs":
                return makeResponse(301, "", {"Location": sprintf("%s://%s/redirect", cx.ssl ? "https" : "http",
                    hdr.host)});
            case "/redirect-loop":
                return makeResponse(307, "", {"Location": "/redirect-loop"});
            case "/range": {
                *list<*string> m = (hdr.range =~ x/^bytes=([0-9]+)-$/);
                if (!m) {
                    return makeResponse(200, Body, {"Content-Type": MimeTypeOctetStream});
                }
                int first = m[0].toInt();
                return makeResponse(206, Body.substr(first), {
                    "Content-Type": MimeTypeOctetStream,
                    "Content-Range": sprintf("bytes %d-%d/%d", first, Body.size() - 1, Body.size()),
                });
            }
            case "/empty":
                return makeResponse(204, "");
            case "/slow": {
                # the first chunk is sent with the headers; the second one when the test releases it
                int calls = 0;
                return <HttpResponseInfo>{
                    "code": 200,
                    "hdr": {"Content-Type": MimeTypeOctetStream},
                    "send_callback": *binary sub () {
                        switch (++calls) {
                            case 1: return binary("early");
                            case 2: slow_release.get(); return binary("late");
                        }
                    },
                };
            }
        }
        return makeResponse(404, "not found", {"Content-Type": MimeTypeText});
    }
}

#! runs code when a stream handle logs that it is cancelling its stream
/** The stream handle logs this after it has set its state to cancelled and before the cancellation is sent to the
    connection, which is where the cancellation reaches a reader waiting for data
*/
class CancelHookLogger inherits Logger {
    private {
        Mutex hook_lock();
        #! called once, in the thread that cancels the stream handle
        *code on_cancel;
    }

    constructor() : Logger("cancel-hook", LoggerLevel::getLevelDebug()) {
    }

    setOnCancel(code c) {
        AutoLock al(hook_lock);
        on_cancel = c;
    }

    log(int level, string message, ...) {
        if (message !~ /cancelling stream/) {
            return;
        }
        *code c;
        {
            AutoLock al(hook_lock);
            c = remove on_cancel;
        }
        if (c) {
            c();
        }
    }
}

#! a connection manager whose stream handles run hooks around their reads
class HookedManager inherits HttpClientConnectionManager {
    private {
        Mutex m();
        #! called once, before a stream handle reads
        *code before_read;
        #! called once, when a stream handle returns an error from a read
        *code after_error;
    }

    constructor(hash<HttpClientConnectionManagerOptions> opts) : HttpClientConnectionManager(opts) {
    }

    HttpClientStreamHandle acquireAndStartStreaming(string url, string method, string path, *hash<auto> headers,
            bool body_streaming = False, *data body) {
        return new HookedStreamHandle(self, HttpClientConnectionManager::acquireAndStartStreaming(url, method, path,
            headers, body_streaming, body));
    }

    setBeforeRead(code c) {
        AutoLock al(m);
        before_read = c;
    }

    setAfterError(code c) {
        AutoLock al(m);
        after_error = c;
    }

    runBeforeRead() {
        *code c;
        {
            AutoLock al(m);
            c = remove before_read;
        }
        if (c) {
            c();
        }
    }

    runAfterError() {
        *code c;
        {
            AutoLock al(m);
            c = remove after_error;
        }
        if (c) {
            c();
        }
    }
}

#! a stream handle that runs the hooks of its manager around the reads of the stream handle it wraps
class HookedStreamHandle inherits HttpClientStreamHandle {
    private {
        HookedManager mgr;
        HttpClientStreamHandle sh;
    }

    constructor(HookedManager mgr, HttpClientStreamHandle sh) : HttpClientStreamHandle(sh.getConnection()) {
        self.mgr = mgr;
        self.sh = sh;
    }

    auto readData(*timeout timeout_ms) {
        mgr.runBeforeRead();
        auto rv = sh.readData(timeout_ms);
        if (rv.typeCode() == NT_HASH && rv.error) {
            mgr.runAfterError();
        }
        return rv;
    }

    cancel() {
        sh.cancel();
    }

    *hash<auto> getResponse() {
        return sh.getResponse();
    }

    int getInactiveTime(date since) {
        return sh.getInactiveTime(since);
    }

    hash<auto> submitAsyncImpl(string method, string path, *hash<auto> headers, *data body) {
        throw "UNSUPPORTED", "not used by the test";
    }

    hash<auto> submitAsyncWithNotifierImpl(string method, string path, *hash<auto> headers, *data body,
            EventNotifier notifier) {
        throw "UNSUPPORTED", "not used by the test";
    }
}

#! a server that serves one connection with a scripted response and then closes it
class RawServer {
    public {
        #! the response header of a chunked body
        const ChunkedHeader = "HTTP/1.1 200 OK\r\nContent-Type: application/octet-stream\r\n"
            "Transfer-Encoding: chunked\r\n\r\n";
    }

    private {
        Socket listener();
        #! data to send, or a Queue to wait on before the next step
        list<auto> steps;
        Counter done(1);
    }

    constructor(list<auto> steps) {
        self.steps = steps;
        listener.bind("127.0.0.1:0", True);
        listener.listen();
        background serve();
    }

    destructor() {
        done.waitForZero();
    }

    #! returns a response header with a Content-Length
    static string getLengthHeader(int len) {
        return sprintf("HTTP/1.1 200 OK\r\nContent-Type: application/octet-stream\r\nContent-Length: %d\r\n\r\n",
            len);
    }

    string getUrl() {
        return sprintf("http://127.0.0.1:%d", listener.getSocketInfo().port);
    }

    private serve() {
        on_exit done.dec();
        # the client connects as soon as the test has started; the limits only end a failing test
        Socket s = listener.accept(30s);
        string req = "";
        while (req !~ /\r\n\r\n/) {
            req += s.recv(-1, 30s);
        }
        try {
            foreach auto step in (steps) {
                if (step instanceof Queue) {
                    step.get(30s);
                } else {
                    s.send(step);
                }
            }
        } catch (hash<ExceptionInfo> ex) {
            # the client failed; the test reports it with its assertions
        }
        s.close();
    }
}

public class HttpClientResponseStreamTest inherits QUnit::Test {
    private {
        HttpServer server;
        StreamTestHandler handler();
        #! protocol -> base URL
        hash<string, string> urls;
    }

    constructor() : Test("HttpClientResponseStreamTest", "1.0") {
        addTestCase("bodies", \bodyTest());
        addTestCase("decoding", \decodeTest());
        addTestCase("redirects", \redirectTest());
        addTestCase("ranges and status codes", \rangeTest());
        addTestCase("timeouts and cancellation", \timeoutTest());
        addTestCase("cancellation while a read starts", \cancelRaceTest());
        addTestCase("errors", \errorTest());
        addTestCase("body data delivered as it is received", \lengthReceiveTest());
        addTestCase("chunk data delivered as it is received", \chunkReceiveTest());
        addTestCase("connection closed in a body", \closedBodyTest());
        addTestCase("chunk framing", \chunkFramingTest());
        set_return_value(main());
    }

    globalSetUp() {
        string certs = ReadOnlyFile::readTextFile(get_script_dir()
            + "/../../qore/classes/HTTPClient/HttpClientTlsVerify.qtest");
        SSLCertificate cert((certs =~ x/const GoodCert = "([^"]+)"/)[0]);
        SSLPrivateKey key((certs =~ x/const GoodKey = "([^"]+)"/)[0]);
        server = new HttpServer(<HttpServerOptionInfo>{"logger": new Logger("stream", LoggerLevel::getLevelInfo())});
        server.setDefaultHandler("stream", handler);
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        int tls_port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0, "cert": cert,
            "key": key}).port;
        server.waitForAsyncIo();
        int quic_port = server.addQuicListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "cert": cert,
            "key": key}).port;
        server.waitForAsyncIo();
        urls = {
            "h1": sprintf("http://127.0.0.1:%d", port),
            "h2": sprintf("https://127.0.0.1:%d", tls_port),
            "h3": sprintf("https://127.0.0.1:%d", quic_port),
        };
    }

    globalTearDown() {
        server.stop();
    }

    private HttpClientConnectionManager getManager(string protocol, *hash<auto> opts) {
        return new HttpClientConnectionManager(getManagerOptions(protocol, opts));
    }

    private hash<HttpClientConnectionManagerOptions> getManagerOptions(string protocol, *hash<auto> opts) {
        return cast<hash<HttpClientConnectionManagerOptions>>({
            "protocol": protocol,
            "accept_all_certs": True,
            # bodies are tested as sent; the server would otherwise compress them
            "accept_encoding": "",
        } + opts);
    }

    #! reads the whole body of the stream
    private binary readAll(HttpClientResponseStream stream) {
        binary rv = binary();
        while (*binary chunk = stream.read(30s)) {
            rv += chunk;
        }
        # the end of the body is returned again
        assertEq(NOTHING, stream.read());
        return rv;
    }

    bodyTest() {
        foreach hash<auto> i in (urls.pairIterator()) {
            HttpClientConnectionManager mgr = getManager(i.key);
            on_exit mgr.closeAll();
            foreach string path in ("/file", "/chunked") {
                string msg = i.key + " " + path;
                HttpClientResponseStream stream = mgr.openStream(i.value + path);
                assertEq(200, stream.getStatusCode(), msg);
                assertEq(i.key, stream.getProtocol(), msg);
                assertEq(i.value + path, stream.getEffectiveUrl(), msg);
                assertEq((), stream.getRedirects(), msg);
                assertEq(MimeTypeOctetStream, stream.getHeaderValue("Content-Type"), msg);
                assertEq(StreamTestHandler::Body, readAll(stream), msg);
                assertEq(StreamTestHandler::Body.size(), stream.getReceivedSize(), msg);
                assertFalse(stream.isDecoded(), msg);
            }
        }
    }

    decodeTest() {
        foreach hash<auto> i in (urls.pairIterator()) {
            HttpClientConnectionManager mgr = getManager(i.key);
            on_exit mgr.closeAll();
            string msg = i.key;
            HttpClientResponseStream stream = mgr.openStream(i.value + "/gzip");
            assertTrue(stream.isDecoded(), msg);
            assertEq(StreamTestHandler::TextBody, readAll(stream), msg);
            # the size received is the size of the compressed body
            assertEq(gzip(StreamTestHandler::TextBody).size(), stream.getReceivedSize(), msg);
            assertEq(stream.getContentLength(), stream.getReceivedSize(), msg);

            # the body as sent
            stream = mgr.openStream(i.value + "/gzip", NOTHING, <HttpClientOpenStreamOptions>{"decode": False});
            assertFalse(stream.isDecoded(), msg);
            assertEq(StreamTestHandler::TextBody, gunzip_to_binary(readAll(stream)), msg);

            # a truncated compressed body is an error
            stream = mgr.openStream(i.value + "/gzip-truncated");
            assertThrows("ZLIB-ERROR", \readAll(), stream, msg + " truncated");
        }
    }

    redirectTest() {
        foreach hash<auto> i in (urls.pairIterator()) {
            HttpClientConnectionManager mgr = getManager(i.key);
            on_exit mgr.closeAll();
            string msg = i.key;
            HttpClientResponseStream stream = mgr.openStream(i.value + "/redirect-abs");
            assertEq(200, stream.getStatusCode(), msg);
            assertEq(i.value + "/file", stream.getEffectiveUrl(), msg);
            list<hash<HttpRedirectInfo>> redirects = stream.getRedirects();
            assertEq((301, 302), (map $1.status_code, redirects), msg);
            assertEq(i.value + "/redirect", redirects[0].target_url, msg);
            assertEq(StreamTestHandler::Body, readAll(stream), msg);

            assertThrows("HTTP-CLIENT-MAXIMUM-REDIRECTS-EXCEEDED", "maximum redirects", \mgr.openStream(), i.value + "/redirect-loop",
                msg);

            # redirects are returned with redirect_passthru
            HttpClientConnectionManager pt = getManager(i.key, {"redirect_passthru": True});
            on_exit pt.closeAll();
            stream = pt.openStream(i.value + "/redirect");
            assertEq(302, stream.getStatusCode(), msg);
            assertEq("/file", stream.getHeaderValue("location"), msg);
            readAll(stream);
        }
    }

    rangeTest() {
        foreach hash<auto> i in (urls.pairIterator()) {
            HttpClientConnectionManager mgr = getManager(i.key);
            on_exit mgr.closeAll();
            string msg = i.key;
            int first = 500000;
            HttpClientResponseStream stream = mgr.openStream(i.value + "/range", {"Range": sprintf("bytes=%d-",
                first)});
            assertEq(206, stream.getStatusCode(), msg);
            assertEq(<HttpContentRangeInfo>{"first": first, "last": StreamTestHandler::Body.size() - 1,
                "total": StreamTestHandler::Body.size()}, stream.getContentRange(), msg);
            assertEq(StreamTestHandler::Body.substr(first), readAll(stream), msg);

            # no range
            stream = mgr.openStream(i.value + "/file");
            assertEq(NOTHING, stream.getContentRange(), msg);
            stream.cancel();

            stream = mgr.openStream(i.value + "/empty");
            assertEq(204, stream.getStatusCode(), msg);
            assertEq(binary(), readAll(stream), msg);

            # error responses are returned with their body
            stream = mgr.openStream(i.value + "/missing");
            assertEq(404, stream.getStatusCode(), msg);
            assertEq(binary("not found"), readAll(stream), msg);
        }
    }

    timeoutTest() {
        foreach hash<auto> i in (urls.pairIterator()) {
            HttpClientConnectionManager mgr = getManager(i.key);
            on_exit mgr.closeAll();
            string msg = i.key;
            HttpClientResponseStream stream = mgr.openStream(i.value + "/slow");
            assertEq(200, stream.getStatusCode(), msg);
            assertEq(binary("early"), stream.read(30s), msg);
            assertThrows("HTTPCLIENT-TIMEOUT", \stream.read(), 50ms, msg);
            # the stream can still be read
            handler.slow_release.push(True);
            assertEq(binary("late"), readAll(stream), msg);

            # a cancelled stream is not taken for a complete one
            stream = mgr.openStream(i.value + "/file");
            stream.cancel();
            assertThrows("HTTPCLIENT-CANCELLED", \stream.read(), NOTHING, msg);
            assertThrows("HTTPCLIENT-CANCELLED", \stream.read(), NOTHING, msg);
            # a stream cancelled while a thread waits for data
            stream = mgr.openStream(i.value + "/slow");
            assertEq(binary("early"), stream.read(30s), msg);
            # the second chunk is only released after the read, so the stream is cancelled before or while the reader
            # waits for it, with the same result
            background sub () {
                stream.cancel();
            }();
            assertThrows("HTTPCLIENT-CANCELLED", \stream.read(), 30s, msg);
            handler.slow_release.push(True);
            # a stream that was read completely is not affected
            stream = mgr.openStream(i.value + "/file");
            readAll(stream);
            stream.cancel();
            assertEq(NOTHING, stream.read(), msg);
            # the manager can still be used
            stream = mgr.openStream(i.value + "/file");
            assertEq(StreamTestHandler::Body, readAll(stream), msg);
        }
    }

    #! a read that has passed the stream's own cancellation check when the stream is cancelled
    /** The stream handle sets its state to cancelled before the cancellation reaches its connection; a read in
        between fails in the stream handle, which must be reported as the cancellation
    */
    cancelRaceTest() {
        foreach hash<auto> i in (urls.pairIterator()) {
            string msg = i.key;
            CancelHookLogger logger();
            HookedManager mgr(getManagerOptions(i.key, {"logger": logger}));
            on_exit mgr.closeAll();
            HttpClientResponseStream stream = mgr.openStream(i.value + "/slow");
            # the server sends the rest of the body when the test is done
            on_exit handler.slow_release.push(True);
            assertEq(binary("early"), stream.read(30s), msg);

            # pushed when the stream handle is being cancelled
            Queue cancelling();
            # pushed when the read is done
            Queue read_done();
            # the stream is cancelled in another thread when the read reaches the stream handle; the read continues
            # when the stream handle has been set to cancelled
            mgr.setBeforeRead(sub () {
                background sub () {
                    # the read continues in any case once the cancellation is done
                    on_exit cancelling.push(True);
                    stream.cancel();
                }();
                cancelling.get();
            });
            # the cancellation continues when the read is done
            logger.setOnCancel(sub () {
                cancelling.push(True);
                read_done.get();
            });
            *hash<ExceptionInfo> err;
            try {
                stream.read(30s);
            } catch (hash<ExceptionInfo> ex) {
                err = ex;
            }
            read_done.push(True);
            assertEq("HTTPCLIENT-CANCELLED", err.err, sprintf("%s: %s: %s", msg, err.err, err.desc));
            # the result does not change
            assertThrows("HTTPCLIENT-CANCELLED", \stream.read(), NOTHING, msg);
        }
    }

    #! errors that end a body
    errorTest() {
        # the connection is closed in the middle of the body
        {
            RawServer server((RawServer::ChunkedHeader + "5\r\nearly\r\n",));
            HookedManager mgr(getManagerOptions("h1"));
            on_exit mgr.closeAll();
            HttpClientResponseStream stream = mgr.openStream(server.getUrl() + "/truncated");
            assertEq(200, stream.getStatusCode());
            assertEq(binary("early"), stream.read(30s));
            # the stream is cancelled after the stream handle has reported the error; the error is reported, as it
            # ended the stream before the cancellation
            mgr.setAfterError(sub () {
                stream.cancel();
            });
            *hash<ExceptionInfo> err;
            try {
                stream.read(30s);
            } catch (hash<ExceptionInfo> ex) {
                err = ex;
            }
            assertEq("HTTPCLIENT-RECEIVE-ERROR", err.err, sprintf("%s: %s", err.err, err.desc));
            # the cause is the error of the connection
            assertEq(Type::String, err.arg.err.type());
            assertFalse(err.arg.err =~ /CANCELLED/, err.arg.err);
            # the error is raised again; the body is not taken for a complete one
            assertThrows("HTTPCLIENT-RECEIVE-ERROR", \stream.read(), NOTHING);
            stream.cancel();
            assertThrows("HTTPCLIENT-RECEIVE-ERROR", \stream.read(), NOTHING);
        }

        # an error before any read
        {
            RawServer server((RawServer::ChunkedHeader + "5\r\nearly\r\n",));
            HttpClientConnectionManager mgr = getManager("h1");
            on_exit mgr.closeAll();
            HttpClientResponseStream stream = mgr.openStream(server.getUrl() + "/truncated");
            assertEq(binary("early"), stream.read(30s));
            assertThrows("HTTPCLIENT-RECEIVE-ERROR", \stream.read(), 30s);
            assertThrows("HTTPCLIENT-RECEIVE-ERROR", \stream.read(), NOTHING);
        }
    }
    #! HTTP/1.1 body data with a Content-Length is delivered as it is received
    lengthReceiveTest() {
        {
            Queue release();
            RawServer server((RawServer::getLengthHeader(10), "early", release, "-late"));
            HttpClientConnectionManager mgr = getManager("h1");
            on_exit mgr.closeAll();
            HttpClientResponseStream stream = mgr.openStream(server.getUrl() + "/length");
            assertEq(binary("early"), stream.read(30s));
            release.push(True);
            assertEq(binary("-late"), readAll(stream));
        }
    }

    #! HTTP/1.1 chunk data is delivered as it is received
    chunkReceiveTest() {
        # the declared size of a chunk is not allocated before its data is received
        {
            Queue release();
            RawServer server((RawServer::ChunkedHeader + "10000000000\r\nearly", release));
            HttpClientConnectionManager mgr = getManager("h1");
            on_exit mgr.closeAll();
            HttpClientResponseStream stream = mgr.openStream(server.getUrl() + "/chunk");
            on_exit release.push(True);
            assertEq(binary("early"), stream.read(30s));
        }

        # a chunk sent in parts
        {
            Queue release();
            RawServer server((RawServer::ChunkedHeader + "a\r\nearly", release, "-late\r\n0\r\n\r\n"));
            HttpClientConnectionManager mgr = getManager("h1");
            on_exit mgr.closeAll();
            HttpClientResponseStream stream = mgr.openStream(server.getUrl() + "/chunk");
            assertEq(binary("early"), stream.read(30s));
            release.push(True);
            assertEq(binary("-late"), readAll(stream));
        }
    }

    #! a connection closed in the middle of an HTTP/1.1 body with a Content-Length
    closedBodyTest() {
        {
            RawServer server((RawServer::getLengthHeader(10) + "early",));
            HttpClientConnectionManager mgr = getManager("h1");
            on_exit mgr.closeAll();
            HttpClientResponseStream stream = mgr.openStream(server.getUrl() + "/length");
            assertEq(binary("early"), stream.read(30s));
            *hash<ExceptionInfo> err;
            try {
                stream.read(30s);
            } catch (hash<ExceptionInfo> ex) {
                err = ex;
            }
            assertEq("HTTPCLIENT-RECEIVE-ERROR", err.err, sprintf("%s: %s", err.err, err.desc));
            assertEq("SOCKET-CLOSED", err.arg.err);
            assertRegex("after 5 of 10 bytes", err.arg.desc);
        }
    }

    #! the data of an HTTP/1.1 chunk must be followed by CRLF
    chunkFramingTest() {
        {
            RawServer server((RawServer::ChunkedHeader + "5\r\nearlyXX0\r\n\r\n",));
            HttpClientConnectionManager mgr = getManager("h1");
            on_exit mgr.closeAll();
            HttpClientResponseStream stream = mgr.openStream(server.getUrl() + "/chunk");
            assertEq(binary("early"), stream.read(30s));
            *hash<ExceptionInfo> err;
            try {
                stream.read(30s);
            } catch (hash<ExceptionInfo> ex) {
                err = ex;
            }
            assertEq("HTTPCLIENT-RECEIVE-ERROR", err.err, sprintf("%s: %s", err.err, err.desc));
            assertRegex("not followed by CRLF", err.arg.desc);
        }
        # also in a body that is received whole
        {
            RawServer server((RawServer::ChunkedHeader + "5\r\nearlyXX0\r\n\r\n",));
            HttpClientConnectionManager mgr = getManager("h1", {"max_request_retries": 0});
            on_exit mgr.closeAll();
            *hash<ExceptionInfo> err;
            try {
                mgr.request(server.getUrl(), "GET", "/chunk");
            } catch (hash<ExceptionInfo> ex) {
                err = ex;
            }
            assertEq(Type::String, err.err.type(), "no error");
            assertRegex("not followed by CRLF", err.desc);
        }
    }
}
