%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires HttpServerAsyncIo
%requires HttpServer
%requires ServerSentEventHandler
%requires DataProvider
%requires ConnectionProvider
%requires RestSchemaValidator
%requires Swagger
%requires OpenApi3
%requires RestClient
%requires HttpClientIo
%requires HttpClientStreamingIo
%requires RestClientIo
%requires Mime
%requires Logger
%requires QUnit

%exec-class SseRestClientIoTest

class TestSseHandler inherits ServerSentEventHandler {
    constructor() : ServerSentEventHandler() {
    }

    connectionRegisteredImpl(ServerSentEventConnection conn) {
        conn.send(<SseMessageInfo>{
            "event": "hello",
            "data": "world",
        });
    }
}

class TestCommentThenDataSseHandler inherits ServerSentEventHandler {
    constructor() : ServerSentEventHandler() {
    }

    connectionRegisteredImpl(ServerSentEventConnection conn) {
        conn.send(<SseMessageInfo>{
            "comment": "hb",
        });
        conn.send(<SseMessageInfo>{
            "event": "after-comment",
            "data": "payload",
        });
    }
}

class TestSseErrorHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(400,
            "{\"error\":{\"message\":\"bad SSE request\",\"type\":\"invalid_request\"}}",
            {"Content-Type": "application/json"});
    }
}

class TestObserver inherits DataProvider::Observer {
    public {
        list<hash<auto>> events = ();
        Mutex m();
        Condition cond();
        int expected_count;
    }

    constructor(int expected_count) {
        self.expected_count = expected_count;
    }

    update(string event_id, hash<auto> data) {
        AutoLock al(m);
        push events, {
            "event_id": event_id,
            "data": data,
        };
        cond.broadcast();
    }

    bool waitForEvents(timeout t = 10s) {
        AutoLock al(m);
        date end_time = now_us() + t;
        while (events.size() < expected_count) {
            date remaining = end_time - now_us();
            if (remaining <= 0us) {
                return False;
            }
            cond.wait(m, remaining);
        }
        return True;
    }
}

#! Captures async I/O controller log messages
class ControllerLogCapture inherits LoggerInterfaceBase {
    private {
        list<string> messages();
        Mutex mtx();
    }

    logArgs(int level, string message, *softlist<auto> args) {
        string formatted = args ? vsprintf(message, args) : message;
        AutoLock al(mtx);
        push messages, formatted;
    }

    bool isEnabledFor(int level) {
        return True;
    }

    #! Returns the number of connections the connection manager submitted to the controller
    int countConnectionSubmits() {
        AutoLock al(mtx);
        return (select messages, $1 =~ /submit: operation 'HttpClientConnectionManager:/).size();
    }
}

class SseRestClientIoTest inherits Test {
    private {
        HttpServer server;
        int port;
        TestSseHandler handler();
        TestCommentThenDataSseHandler comment_handler();
    }

    constructor() : Test("SseRestClientIoTest", "1.0") {
        addTestCase("restSseReader receives events", \testRestSseReader());
        addTestCase("restSseReader multiple events", \testRestSseReaderMultiple());
        addTestCase("restSseStream callback", \testRestSseStream());
        addTestCase("restSseStream callback stop", \testRestSseStreamStop());
        addTestCase("restSseReader skips comment-only keepalives",
            \testRestSseReaderSkipsComments());
        addTestCase("restSseReader returns NOTHING at close-delimited EOF",
            \testRestSseReaderCloseDelimitedEof());
        addTestCase("restSseReader throws HTTP response errors",
            \testRestSseReaderThrowsResponseError());
        addTestCase("restSseReader separates CRLF-delimited events",
            \testRestSseReaderCrlfFraming());
        addTestCase("restSseReader rejects a successful response that is not an event stream",
            \testRestSseReaderRejectsNonSseResponse());
        addTestCase("restSseReader reports an error response sent as an event stream",
            \testRestSseReaderErrorWithSseContentType());
        addTestCase("restObserveSse receives events", \testRestObserveSse());
        addTestCase("restObserveSse reports a refused connection", \testRestObserveSseConnectionRefused());
        addTestCase("HttpSseStreamPollOperation heartbeat defaults on",
            \testPollOperationHeartbeatDefault());
        set_return_value(main());
    }

    globalSetUp() {
        Logger logger("test", LoggerLevel::getLevelInfo());
        server = new HttpServer(<HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
            "enable_h3": False,
        });
        server.setDefaultHandler("sse", handler);
        server.setHandler("sse-comment", "/comment", NOTHING, comment_handler);
        server.setHandler("sse-error", "/error", NOTHING, new TestSseErrorHandler());
        port = server.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
    }

    globalTearDown() {
        if (server) {
            server.stop();
            delete server;
        }
    }

    testRestSseReader() {
        RestClientIo rest({"url": sprintf("http://localhost:%d", port)});

        SseStreamReader reader = rest.restSseReader("GET", "/sse");

        *hash<SseMessageInfo> evt = reader.readEvent(5s);
        assertTrue(exists evt, "SSE event received via restSseReader");
        assertEq("hello", evt.event);
        assertEq("\"world\"", evt.data);

        # Timeout — no more events
        *hash<SseMessageInfo> evt2 = reader.readEvent(500ms);
        assertEq(NOTHING, evt2, "timeout returns NOTHING");
        assertFalse(reader.isDone(), "a timeout does not end the stream");
    }

    testRestSseReaderMultiple() {
        RestClientIo rest({"url": sprintf("http://localhost:%d", port)});

        SseStreamReader reader = rest.restSseReader("GET", "/sse");

        # Read initial hello event
        *hash<SseMessageInfo> evt1 = reader.readEvent(5s);
        assertTrue(exists evt1, "first event received");
        assertEq("hello", evt1.event);

        # Push a second event from server
        handler.sendAll(<SseMessageInfo>{
            "event": "update",
            "data": "payload-123",
        });

        *hash<SseMessageInfo> evt2 = reader.readEvent(5s);
        assertTrue(exists evt2, "second event received");
        assertEq("update", evt2.event);
        assertEq("\"payload-123\"", evt2.data);
    }

    testRestSseStream() {
        RestClientIo rest({"url": sprintf("http://localhost:%d", port)});

        list<hash<SseMessageInfo>> events();

        # Use the reader pattern to ensure we're connected before sending
        # the second event from the server
        SseStreamReader reader = rest.restSseReader("GET", "/sse");
        # Read the initial hello event to confirm connection is registered
        *hash<SseMessageInfo> hello = reader.readEvent(5s);
        @assert(hello);
        events += hello;

        # Now push a second event — the connection is definitely registered
        handler.sendAll(<SseMessageInfo>{
            "event": "bg-event",
            "data": "bg-data",
        });

        *hash<SseMessageInfo> evt2 = reader.readEvent(5s);
        if (evt2) {
            events += evt2;
        }

        assertEq(2, events.size(), "callback received 2 events");
        assertEq("hello", events[0].event);
        assertEq("bg-event", events[1].event);
    }

    testRestSseStreamStop() {
        RestClientIo rest({"url": sprintf("http://localhost:%d", port)});

        int count = 0;
        rest.restSseStream("GET", "/sse", bool sub(hash<SseMessageInfo> evt) {
            count++;
            return False;  # stop immediately
        }, NOTHING, NOTHING, 5s);

        assertEq(1, count, "callback stopped after first event");
    }

    testRestSseReaderSkipsComments() {
        RestClientIo rest({"url": sprintf("http://localhost:%d", port)});

        SseStreamReader reader = rest.restSseReader("GET", "/comment");
        on_exit reader.cancel();

        *hash<SseMessageInfo> evt = reader.readEvent(5s);
        assertTrue(exists evt, "data event received after comment-only frame");
        assertEq("after-comment", evt.event, "comment-only frame skipped");
        assertEq("\"payload\"", evt.data, "data payload preserved");
    }

    testRestSseReaderCloseDelimitedEof() {
        Socket listener();
        listener.bind("127.0.0.1:0");
        listener.listen();
        on_exit listener.close();

        int lport = listener.getSocketInfo().port;

        background sub () {
            Socket conn = listener.accept(5s);
            on_exit conn.close();

            hash<auto> req = conn.readHTTPHeader(5s);
            if (req."content-length") {
                conn.recv(req."content-length", 5s);
            }

            conn.send("HTTP/1.1 200 OK\r\n"
                "Content-Type: text/event-stream\r\n"
                "Connection: close\r\n"
                "\r\n");
            conn.send("data: {\"id\":\"one\",\"object\":\"chat.completion.chunk\"}\n\n");
            conn.send("data: [DONE]\n\n");
        }();

        RestClientIo rest({
            "url": sprintf("http://127.0.0.1:%d", lport),
            "data": "json",
            "connect_timeout": 2s,
            "timeout": 5s,
            "protocol": "h1",
            "allow_any_response": True,
        });
        on_exit rest.close();

        SseStreamReader reader = rest.restSseReader("POST", "/sse",
            {"Content-Type": "application/json"}, "{}");
        on_exit {
            try {
                reader.cancel();
            } catch () {
            }
        }

        *hash<SseMessageInfo> evt1 = reader.readEvent(5s);
        assertTrue(exists evt1, "first close-delimited SSE event received");
        assertEq("{\"id\":\"one\",\"object\":\"chat.completion.chunk\"}", evt1.data);
        assertEq(False, reader.isDone(), "reader remains open before EOF");

        *hash<SseMessageInfo> evt2 = reader.readEvent(5s);
        assertTrue(exists evt2, "DONE SSE event received");
        assertEq("[DONE]", evt2.data);
        assertEq(False, reader.isDone(), "reader remains open before close notification");

        *hash<SseMessageInfo> evt3 = reader.readEvent(5s);
        assertEq(NOTHING, evt3, "close-delimited EOF returns NOTHING");
        assertEq(True, reader.isDone(), "reader is done after close-delimited EOF");
    }

    testRestSseReaderThrowsResponseError() {
        RestClientIo rest({
            "url": sprintf("http://localhost:%d", port),
            "data": "json",
        });

        try {
            rest.restSseReader("GET", "/error");
            fail("restSseReader should throw REST-RESPONSE-ERROR on HTTP error response");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("REST-RESPONSE-ERROR", ex.err);
            assertEq(400, ex.arg.status_code);
            assertEq("GET", ex.arg.request_method);
            assertEq("/error", ex.arg.request_path);
            if (ex.arg.body.typeCode() == NT_HASH) {
                assertEq("bad SSE request", ex.arg.body.error.message);
                assertEq("invalid_request", ex.arg.body.error."type");
            } else {
                assertTrue(string(ex.arg.body).find("bad SSE request") >= 0,
                    "raw error body is preserved");
            }
        }
    }

    #! Serves one HTTP/1.1 request on a new listener with the given raw response and closes the connection
    private Socket serveRawResponse(string response, reference<int> lport) {
        Socket listener();
        listener.bind("127.0.0.1:0");
        listener.listen();
        lport = listener.getSocketInfo().port;
        background sub () {
            try {
                Socket conn = listener.accept(5s);
                on_exit conn.close();
                hash<auto> req = conn.readHTTPHeader(5s);
                if (req."content-length") {
                    conn.recv(req."content-length", 5s);
                }
                conn.send(response);
            } catch (hash<ExceptionInfo> ex) {
                # the test fails on the client side
            }
        }();
        return listener;
    }

    private RestClientIo rawClient(int lport) {
        return new RestClientIo({
            "url": sprintf("http://127.0.0.1:%d", lport),
            "data": "json",
            "connect_timeout": 2s,
            "timeout": 5s,
            "protocol": "h1",
        });
    }

    #! Regression: Gemini and Vertex AI delimit events with CRLF; the reader merged them into one event
    testRestSseReaderCrlfFraming() {
        int lport;
        Socket listener = serveRawResponse("HTTP/1.1 200 OK\r\n"
            "Content-Type: text/event-stream; charset=UTF-8\r\n"
            "Connection: close\r\n"
            "\r\n"
            "data: {\"n\":1}\r\n\r\n"
            "data: {\"n\":2}\r\n\r\n", \lport);
        on_exit listener.close();
        RestClientIo rest = rawClient(lport);
        on_exit rest.close();

        SseStreamReader reader = rest.restSseReader("POST", "/sse", {"Content-Type": "application/json"}, "{}");
        on_exit reader.cancel();
        *hash<SseMessageInfo> evt = reader.readEvent(5s);
        assertEq("{\"n\":1}", evt.data, "the first CRLF-delimited event is delivered alone");
        evt = reader.readEvent(5s);
        assertEq("{\"n\":2}", evt.data, "the second CRLF-delimited event is delivered alone");
        assertNothing(reader.readEvent(5s), "the stream ends after the last event");
        assertTrue(reader.isDone(), "the reader is done at the end of the stream");
    }

    #! Regression: a successful response that is not an event stream was read as a stream without events
    testRestSseReaderRejectsNonSseResponse() {
        string body = "{\"ok\":true}";
        int lport;
        Socket listener = serveRawResponse(sprintf("HTTP/1.1 200 OK\r\n"
            "Content-Type: application/json\r\n"
            "Content-Length: %d\r\n"
            "Connection: close\r\n"
            "\r\n%s", body.size(), body), \lport);
        on_exit listener.close();
        RestClientIo rest = rawClient(lport);
        on_exit rest.close();

        try {
            rest.restSseReader("POST", "/sse", {"Content-Type": "application/json"}, "{}");
            fail("restSseReader must reject a response that is not an event stream");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("REST-RESPONSE-ERROR", ex.err, ex.desc);
            assertRegex("Content-Type \"application/json\"", ex.desc);
            assertEq(200, ex.arg.status_code);
            assertEq(body, ex.arg.body.typeCode() == NT_BINARY ? ex.arg.body.toString() : ex.arg.body);
        }
    }

    #! Regression: an error body sent with the event-stream Content-Type (as Vertex AI does) raised
    #! DESERIALIZATION-ERROR, hiding the HTTP status
    testRestSseReaderErrorWithSseContentType() {
        string body = "{\"error\":{\"code\":404,\"message\":\"model not found\"}}";
        int lport;
        Socket listener = serveRawResponse(sprintf("HTTP/1.1 404 Not Found\r\n"
            "Content-Type: text/event-stream\r\n"
            "Content-Length: %d\r\n"
            "Connection: close\r\n"
            "\r\n%s", body.size(), body), \lport);
        on_exit listener.close();
        RestClientIo rest = rawClient(lport);
        on_exit rest.close();

        try {
            rest.restSseReader("POST", "/sse", {"Content-Type": "application/json"}, "{}");
            fail("restSseReader must raise an error response");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("REST-RESPONSE-ERROR", ex.err, ex.desc);
            assertEq("HTTP 404 response received", ex.desc);
            assertEq(404, ex.arg.status_code);
            string raw_body = ex.arg.body.typeCode() == NT_BINARY ? ex.arg.body.toString() : ex.arg.body;
            assertEq(body, raw_body, "the raw error body is preserved");
        }
    }

    testRestObserveSse() {
        RestClientIo rest({
            "url": sprintf("http://localhost:%d", port),
            "data": "json",
        });
        on_exit rest.close();

        HttpClientStreamingIo::SseObservable obs = rest.restObserveSse("GET",
            "/sse", NOTHING, NOTHING, {"serialization": "none"});
        TestObserver observer(2);
        obs.registerObserver(observer);
        obs.observersReady();
        on_exit obs.stopEvents();

        assertTrue(observer.waitForEvents(10s), "RestClientIo observable received events");
        assertEq(HttpClientStreamingIo::EVENT_SSE_CONNECTED, observer.events[0].event_id);
        assertEq(HttpClientStreamingIo::EVENT_SSE_DATA, observer.events[1].event_id);
        assertEq("hello", observer.events[1].data.event);
        assertEq("\"world\"", observer.events[1].data.data);
    }

    #! Regression: a refused connection closes the observable with the connection error
    /** The startup operation used to start another connection on every wake without noticing that the one it
        waited for had closed: observers received no event at all until the observable was stopped, while
        thousands of connections were attempted.
    */
    testRestObserveSseConnectionRefused() {
        # reserve a port and release it again, so nothing listens on it: a socket kept bound without listening
        # is refused promptly on Linux, but on Darwin the connection only fails when it times out
        int port;
        {
            Socket probe();
            probe.bindINET("127.0.0.1", 0, True);
            port = probe.getSocketInfo().port;
            probe.close();
        }
        assertGt(0, port, "an ephemeral port was reserved");
        HttpClientConnectionManager mgr(<HttpClientConnectionManagerOptions>{"max_request_retries": 1});
        on_exit mgr.closeAll();
        RestClientIo rest({
            "url": sprintf("http://127.0.0.1:%d", port),
        }, mgr);

        ControllerLogCapture cap();
        AsyncIoController::setLogger(cap);
        on_exit AsyncIoController::setLogger(NOTHING);

        HttpClientStreamingIo::SseObservable obs = rest.restObserveSse("GET", "/sse");
        TestObserver observer(1);
        obs.registerObserver(observer);
        obs.observersReady();
        on_exit obs.stopEvents();

        assertTrue(observer.waitForEvents(30s), "the observable reported the failed startup");
        hash<auto> evt = observer.events[0];
        assertEq(HttpClientStreamingIo::EVENT_SSE_CLOSED, evt.event_id);
        assertEq("startup-error", evt.data.reason);
        assertEq("HTTPCLIENT-CONNECT-ERROR", evt.data.error.err);
        assertRegex("Connection refused", evt.data.error.desc, sprintf("%s: %s", evt.data.error.err,
            evt.data.error.desc));
        assertEq(2, cap.countConnectionSubmits(), "one connection attempt and one retry");
    }

    testPollOperationHeartbeatDefault() {
        Socket listener();
        listener.bindINET("localhost", 0, True, AF_INET, SOCK_STREAM);
        listener.listen();
        on_exit listener.close();

        int lport = listener.getSocketInfo().port;
        Socket client();
        client.connect("localhost:" + lport, 5s);
        on_exit client.close();

        Socket server_sock = listener.accept(5s);
        on_exit server_sock.close();

        HttpServerAsyncIo::HttpSseStreamPollOperation op(server_sock);

        *hash<SocketPollInfo> poll_info = op.continuePoll();
        assertTrue(exists poll_info, "open SSE poll operation returns poll info");
        assertEq(HttpServerAsyncIo::DefaultSseHeartbeatIntervalMs,
            poll_info.poll_timeout_ms, "heartbeat is enabled by default");

        op.setHeartbeat(0);
        *hash<SocketPollInfo> disabled_info = op.continuePoll();
        assertTrue(exists disabled_info, "open SSE poll operation still waits for notifier");
        assertEq(NOTHING, disabled_info.poll_timeout_ms,
            "heartbeat can be disabled explicitly");
    }
}
