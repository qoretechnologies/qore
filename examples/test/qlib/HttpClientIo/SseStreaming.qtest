%modern
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Mime
%requires Logger
%requires QUnit
%requires HttpServerUtil
%requires AsyncSocketIo
%requires HttpClientIo
%requires HttpClientStreamingIo
%requires HttpServerAsyncIo
%requires HttpServer
%requires ServerSentEventHandler

%exec-class SseStreamingTest

class TestSseHandler inherits ServerSentEventHandler {
    constructor() : ServerSentEventHandler() {
    }

    connectionRegisteredImpl(ServerSentEventConnection conn) {
        # Send an initial event upon registration
        conn.send(<SseMessageInfo>{
            "event": "hello",
            "data": "world",
        });
    }
}

class CallbackSseResponseHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        setPersistent(True);
        list<string> chunks = (
            "data: one\n\n",
            "data: [DONE]\n\n",
        );

        return <HttpResponseInfo>{
            "code": 200,
            "hdr": {
                "Cache-Control": "no-cache",
                "Content-Type": MimeTypeSse + "; charset=utf-8",
            },
            "send_callback": *string sub () {
                if (!chunks) {
                    setPersistent(False);
                    return NOTHING;
                }
                return shift chunks;
            },
        };
    }
}

class ClosingSseHandler inherits ServerSentEventHandler {
    constructor() : ServerSentEventHandler() {
    }

    connectionRegisteredImpl(ServerSentEventConnection conn) {
        conn.send(<SseMessageInfo>{
            "event": "done",
            "data": "complete",
        });

        HttpServerAsyncIo::AbstractSseConnection sse_conn = conn.getAsyncSseConnection();
        sse_conn.close();
    }
}

class SseStreamingTest inherits Test {
    private {
        HttpServer server;
        int port;
        TestSseHandler handler();
        CallbackSseResponseHandler callback_handler();
        ClosingSseHandler closing_handler();
    }

    constructor() : Test("SseStreamingTest", "1.0") {
        addTestCase("SSE streaming receives events", \testSseReceivesEvents());
        addTestCase("H1 SSE response has deterministic framing", \testH1SseResponseFraming());
        addTestCase("H1 SSE callback response is chunked", \testH1SseCallbackResponseIsChunked());
        addTestCase("H1 SSE graceful close drains before disconnect", \testH1SseGracefulClose());
        addTestCase("SSE streaming multiple events", \testSseMultipleEvents());
        addTestCase("SSE streaming notifier wakes on events", \testSseNotifierEvents());
        set_return_value(main());
    }

    globalSetUp() {
        Logger logger("test", LoggerLevel::getLevelInfo());
        hash<HttpServerOptionInfo> http_opts = <HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        };
        server = new HttpServer(http_opts);
        server.setDefaultHandler("sse", handler);
        server.setHandler("callback-sse", "/callback-sse", NOTHING, callback_handler);
        server.setHandler("close-sse", "/close-sse", NOTHING, closing_handler);
        port = server.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
    }

    globalTearDown() {
        if (server) {
            server.stop();
            delete server;
        }
    }

    testSseReceivesEvents() {
        string url = sprintf("http://localhost:%d/sse", port);
        HttpClientIo::HttpClientConnectionManager mgr();

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireAndStartStreaming(
            url, "GET", "/sse", {"Accept": "text/event-stream"});

        HttpClientStreamingIo::SseStreamReader reader(stream);

        # The server sends a "hello" event during connection registration
        *hash<SseMessageInfo> evt = reader.readEvent(5s);
        assertEq(True, exists evt, "SSE event received");
        assertEq("hello", evt.event);
        assertEq("\"world\"", evt.data);

        # No more events — should timeout, NOT get end_stream
        *hash<SseMessageInfo> evt2 = reader.readEvent(500ms);
        assertEq(NOTHING, evt2, "no more events (timeout)");
        assertEq(False, reader.isDone(), "stream still open after timeout");

        stream.cancel();
    }

    private hash<auto> sendRawSseRequest(Socket sock, string path) {
        sock.connect("127.0.0.1:" + port, 5s);
        hash<auto> send_info;
        sock.sendHTTPMessage("GET", path, "1.1", {
            "Host": sprintf("127.0.0.1:%d", port),
            "Accept": MimeTypeSse,
        }, NOTHING, \send_info);
        return sock.readHTTPHeader(5s);
    }

    private assertValidH1SseFraming(hash<auto> hdr, string label) {
        assertEq(200, hdr.status_code, label + " status");
        assertTrue(string(hdr."content-type").lwr().startsWith(MimeTypeSse),
            label + " content type");

        bool has_chunked = hdr."transfer-encoding"
            && string(hdr."transfer-encoding").lwr() =~ /chunked/;
        bool has_length = hdr."content-length".val();
        bool says_close = hdr.connection && string(hdr.connection).lwr() =~ /close/;
        assertTrue(has_chunked || has_length || says_close,
            label + " must use chunked, Content-Length, or Connection: close framing");
    }

    testH1SseResponseFraming() {
        Socket sock();
        on_exit sock.close();

        hash<auto> hdr = sendRawSseRequest(sock, "/sse");
        assertValidH1SseFraming(hdr, "dedicated H1 SSE");
        assertEq("close", string(hdr.connection).lwr(),
            "dedicated H1 SSE without length or chunking advertises close");
    }

    testH1SseCallbackResponseIsChunked() {
        Socket sock();
        on_exit sock.close();

        hash<auto> hdr = sendRawSseRequest(sock, "/callback-sse");
        assertValidH1SseFraming(hdr, "callback H1 SSE");
        assertTrue(hdr."transfer-encoding"
                && string(hdr."transfer-encoding").lwr() =~ /chunked/,
            "callback H1 SSE uses chunked transfer encoding");

        hash<auto> chunked = sock.readHTTPChunkedBody(5s);
        string body = chunked.body.typeCode() == NT_BINARY
            ? chunked.body.toString() : chunked.body;
        assertTrue(body =~ /data:\s*\[DONE\]/, "callback H1 SSE body includes DONE event");
    }

    testH1SseGracefulClose() {
        string url = sprintf("http://localhost:%d/close-sse", port);
        HttpClientIo::HttpClientConnectionManager mgr();

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireAndStartStreaming(
            url, "GET", "/close-sse", {"Accept": "text/event-stream"});
        on_exit {
            try {
                stream.cancel();
            } catch (hash<ExceptionInfo> ex) {
            }
        }

        HttpClientStreamingIo::SseStreamReader reader(stream);

        *hash<SseMessageInfo> evt = reader.readEvent(5s);
        assertTrue(exists evt, "close SSE event received");
        assertEq("done", evt.event);
        assertEq("\"complete\"", evt.data);

        *hash<SseMessageInfo> eof = reader.readEvent(5s);
        assertEq(NOTHING, eof, "graceful SSE close returns EOF");
        assertEq(True, reader.isDone(), "reader is done after graceful close");
    }

    testSseMultipleEvents() {
        string url = sprintf("http://localhost:%d/sse", port);
        HttpClientIo::HttpClientConnectionManager mgr();

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireAndStartStreaming(
            url, "GET", "/sse", {"Accept": "text/event-stream"});

        HttpClientStreamingIo::SseStreamReader reader(stream);

        # Read the initial hello event
        *hash<SseMessageInfo> evt1 = reader.readEvent(5s);
        assertEq(True, exists evt1, "first SSE event received");
        assertEq("hello", evt1.event);

        # Send a second event from the server
        handler.sendAll(<SseMessageInfo>{
            "event": "update",
            "data": "test-data",
        });

        # Read the second event
        *hash<SseMessageInfo> evt2 = reader.readEvent(5s);
        assertEq(True, exists evt2, "second SSE event received");
        assertEq("update", evt2.event);
        assertEq("\"test-data\"", evt2.data);

        stream.cancel();
    }

    private hash<auto> waitForNotifiedEvent(Queue queue, EventNotifier notifier, EventLoop loop, string name) {
        *list<hash<EventPollInfo>> events = loop.poll(5s);
        assertTrue(exists events, name + " notifier fired");

        notifier.acknowledge();

        auto item = queue.tryGet();
        assertTrue(exists item, name + " queue item available");
        assertTrue(exists item.value, name + " queue item is not end-of-stream");
        assertEq(NT_HASH, item.value.typeCode(), name + " queue item is an SSE hash");
        return cast<hash>(item.value);
    }

    testSseNotifierEvents() {
        string url = sprintf("http://localhost:%d/sse", port);
        HttpClientIo::HttpClientConnectionManager mgr();

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(url);
        hash<auto> info = stream.startSseStreamingWithNotifier(
            "GET", "/sse", {"Accept": "text/event-stream"}, NOTHING);
        Queue queue = info.queue;
        EventNotifier notifier = info.notifier;

        EventLoop loop();
        loop.add(notifier, SOCK_POLLIN);

        on_exit {
            try {
                loop.del(notifier);
            } catch (hash<ExceptionInfo> ex) {
            }
            try {
                stream.cancel();
            } catch (hash<ExceptionInfo> ex) {
            }
        }

        hash<auto> evt1 = waitForNotifiedEvent(queue, notifier, loop, "initial SSE event");
        assertEq("hello", evt1.event);
        assertEq("\"world\"", evt1.data);

        handler.sendAll(<SseMessageInfo>{
            "event": "update",
            "data": "notify",
        });

        hash<auto> evt2 = waitForNotifiedEvent(queue, notifier, loop, "update SSE event");
        assertEq("update", evt2.event);
        assertEq("\"notify\"", evt2.data);
    }
}
