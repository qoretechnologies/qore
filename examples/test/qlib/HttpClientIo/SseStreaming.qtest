%modern
%requires HttpServer
%requires HttpServerAsyncIo
%requires ServerSentEventHandler
%requires HttpClientIo
%requires HttpClientStreamingIo
%requires Mime
%requires Logger
%requires QUnit

%exec-class SseStreamingTest

class TestSseHandler inherits ServerSentEventHandler {
    constructor() : ServerSentEventHandler() {
    }

    connectionRegisteredImpl(ServerSentEventConnection conn) {
        # Send an initial event upon registration
        conn.send(<SseMessageInfo>{
            "event": "hello",
            "data": "world",
        });
    }
}

class SseStreamingTest inherits Test {
    private {
        HttpServer server;
        int port;
        TestSseHandler handler();
    }

    constructor() : Test("SseStreamingTest", "1.0") {
        addTestCase("SSE streaming receives events", \testSseReceivesEvents());
        addTestCase("SSE streaming multiple events", \testSseMultipleEvents());
        set_return_value(main());
    }

    globalSetUp() {
        Logger logger("test", LoggerLevel::getLevelInfo());
        hash<HttpServerOptionInfo> http_opts = <HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        };
        server = new HttpServer(http_opts);
        server.setDefaultHandler("sse", handler);
        port = server.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
    }

    globalTearDown() {
        if (server) {
            server.stop();
            delete server;
        }
    }

    testSseReceivesEvents() {
        string url = sprintf("http://localhost:%d/sse", port);
        HttpClientIo::HttpClientConnectionManager mgr();

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireAndStartStreaming(
            url, "GET", "/sse", {"Accept": "text/event-stream"});

        HttpClientStreamingIo::SseStreamReader reader(stream);

        # The server sends a "hello" event during connection registration
        *hash<SseMessageInfo> evt = reader.readEvent(5s);
        assertEq(True, exists evt, "SSE event received");
        assertEq("hello", evt.event);
        assertEq("\"world\"", evt.data);

        # No more events — should timeout, NOT get end_stream
        *hash<SseMessageInfo> evt2 = reader.readEvent(500ms);
        assertEq(NOTHING, evt2, "no more events (timeout)");
        assertEq(False, reader.isDone(), "stream still open after timeout");

        stream.cancel();
    }

    testSseMultipleEvents() {
        string url = sprintf("http://localhost:%d/sse", port);
        HttpClientIo::HttpClientConnectionManager mgr();

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireAndStartStreaming(
            url, "GET", "/sse", {"Accept": "text/event-stream"});

        HttpClientStreamingIo::SseStreamReader reader(stream);

        # Read the initial hello event
        *hash<SseMessageInfo> evt1 = reader.readEvent(5s);
        assertEq(True, exists evt1, "first SSE event received");
        assertEq("hello", evt1.event);

        # Send a second event from the server
        handler.sendAll(<SseMessageInfo>{
            "event": "update",
            "data": "test-data",
        });

        # Read the second event
        *hash<SseMessageInfo> evt2 = reader.readEvent(5s);
        assertEq(True, exists evt2, "second SSE event received");
        assertEq("update", evt2.event);
        assertEq("\"test-data\"", evt2.data);

        stream.cancel();
    }
}
