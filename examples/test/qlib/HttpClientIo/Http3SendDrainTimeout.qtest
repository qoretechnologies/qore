#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - HTTP/3 (QUIC) client streaming requests and their flow control

/*  Http3SendDrainTimeout.qtest Copyright 2026 Qore Technologies, s.r.o.

    Permission is hereby granted, free of charge, to any person obtaining a
    copy of this software and associated documentation files (the "Software"),
    to deal in the Software without restriction, including without limitation
    the rights to use, copy, modify, merge, publish, distribute, sublicense,
    and/or sell copies of the Software, and to permit persons to whom the
    Software is furnished to do so, subject to the following conditions:

    The above copyright notice and this permission notice shall be included in
    all copies or substantial portions of the Software.

    THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
    IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
    FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
    AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
    LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
    FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
    DEALINGS IN THE SOFTWARE.

    The HTTP/3 client waited for a full stream send buffer to drain with a fixed bound of 200 retries of 50 ms, a
    hidden 10 s timeout, whatever the request timeout: a loaded host that drained a large request slowly failed it,
    and a short request timeout did not bound the wait.  A send now waits, woken when the buffer drains, for at most
    the request timeout.  The client's own stream is held back from the transport with a debug hook, as when the
    server grants no credit: the second large send waits for the request timeout (5 s) and raises; without the fix it
    raised only after the 10 s, with another message.
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Logger
%requires HttpServerUtil
%requires HttpServer
%requires HttpClientIo
%requires ../../TestCertificates.qm

%exec-class Http3SendDrainTimeoutTest

#! larger than the staged data's limit (1 MiB)
const Size = 3 * 1024 * 1024;

#! a hang guard only, never a timing assertion
const HangGuard = 60s;

#! Answers a request once its body is complete (never, in this test)
class BodyHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, "ok");
    }
}

class Http3SendDrainTimeoutTest inherits QUnit::Test {
    constructor() : QUnit::Test("Http3SendDrainTimeout", "1.0") {
        addTestCase("HTTP/3: a send that waits for a full send buffer is bounded by the request timeout",
            \testDrainTimeout());
        set_return_value(main());
    }

    testDrainTimeout() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("the library is not built with debugging");
        }
        HttpServer server(<HttpServerOptionInfo>{"logger": new Logger("test", LoggerLevel::getLevelInfo())});
        on_exit server.stop();
        server.setDefaultHandler("body", new BodyHandler());
        int port = server.addListener(<HttpListenerOptionInfo>{
            "node": "127.0.0.1",
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
            "enable_h3": True,
        }).port;
        server.waitForAsyncIo();

        HttpClientConnectionManager mgr(<HttpClientConnectionManagerOptions>{
            "protocol": "h3",
            "accept_all_certs": True,
            # the send waits for the stream's send buffer at most the request timeout, which also bounds the QUIC
            # handshake: long enough for a loaded host
            "request_timeout": 5s,
            "connect_timeout": HangGuard,
        });
        on_exit delete mgr;
        HttpClientStreamHandle stream = mgr.acquireStream(sprintf("https://127.0.0.1:%d/", port));
        on_exit {
            try {
                stream.cancel();
            } catch () {
            }
        }
        stream.startStreaming("POST", "/", {"Content-Type": "application/octet-stream"}, True);
        assertEq("h3", stream.getConnection().getProtocol(), "the request uses HTTP/3");
        # the client's staged data for the stream is held back from the transport, as when the server grants no
        # credit
        call_function("dbg_quic_hold_stream_data", cast<Http3ClientConnection>(stream.getConnection()).getSessionId(),
            stream.getStreamId());
        on_exit call_function("dbg_quic_release_stream_data");
        # the first chunk is staged; the second one finds the staged data over its limit
        stream.sendData(binary(strmul("a", Size)));
        assertThrows("HTTP3-FLOW-CONTROL", "did not drain within 5000 ms", \stream.sendData(),
            binary(strmul("b", Size)));
    }
}
