-----END PRIVATE KEY-----";
    }

    constructor() : QUnit::Test("HttpClientIoAutoAlpnHttp11Test", "1.0") {
        addTestCase("auto: a server that only negotiates http/1.1 is reached over HTTP/1.1", \testAuto());
        addTestCase("h2: a server that only negotiates http/1.1 refuses the connection", \testH2());
        set_return_value(main());
    }

%ifdef NoProcess
    testAuto() {
        testSkip("the process module is not available");
    }

    testH2() {
        testSkip("the process module is not available");
    }
%else
    testAuto() {
        hash<auto> h = startServer();
        on_exit stopServer(h.process);
        HttpClientIo::HttpClientConnectionManager mgr = getManager("auto");
        on_exit mgr.closeAll();
        hash<auto> resp = mgr.request("https://127.0.0.1:" + h.port, "GET", "/");
        assertEq(200, resp.status_code);
        assertEq("http/1.1 ok", resp.body);
        assertEq("1.1", resp.http_version, "the connection uses HTTP/1.1");
    }

    testH2() {
        hash<auto> h = startServer();
        on_exit stopServer(h.process);
        HttpClientIo::HttpClientConnectionManager mgr = getManager("h2");
        on_exit mgr.closeAll();
        string err;
        try {
            mgr.request("https://127.0.0.1:" + h.port, "GET", "/");
            err = "connected";
        } catch (hash<ExceptionInfo> ex) {
            err = sprintf("%s: %s", ex.err, ex.desc);
        }
        assertRegex("^HTTPCLIENT-CONNECT-ERROR: .*no application protocol", err,
            "an explicit HTTP/2 selection offers h2 only");
    }

    private HttpClientIo::HttpClientConnectionManager getManager(string protocol) {
        return new HttpClientIo::HttpClientConnectionManager(<HttpClientIo::HttpClientConnectionManagerOptions>{
            "protocol": protocol,
            "accept_all_certs": True,
            "connect_timeout": 10s,
            "request_timeout": 10s,
        });
    }

    #! starts the node server that only negotiates http/1.1; skips the test if node is not available
    private hash<auto> startServer() {
        string node_bin = ENV.NODE_BIN ?? "node";
        if (system(node_bin + " -v > /dev/null 2>&1")) {
            testSkip("node is not available");
        }
        TmpDir dir("http11-only-tls-");
        foreach hash<auto> i in ({"cert.pem": CertPem, "key.pem": KeyPem}.pairIterator()) {
            File f();
            f.open2(dir.path + "/" + i.key, O_CREAT | O_TRUNC | O_WRONLY);
            f.write(i.value);
            f.close();
        }
        Process p(node_bin, (get_script_dir() + "/http11-only-tls-server.js", dir.path + "/cert.pem",
            dir.path + "/key.pem"));
        on_error stopServer(p);
        string line = "";
        while (line !~ /\n/) {
            *string s = p.readStdout(1024, 60s);
            if (!exists s) {
                throw "TEST-ERROR", sprintf("the node server did not start: %s", p.readStderr(4096, 0) ?? "");
            }
            line += s;
        }
        *string port = (line =~ x/READY ([0-9]+)/)[0];
        if (!exists port) {
            throw "TEST-ERROR", "the node server reported no port: " + line;
        }
        # the server must refuse a client that offers only "h2" with the no_application_protocol alert, as nginx does;
        # a node without ALPNCallback (before 18.18) completes the handshake without ALPN instead, which a client
        # without the fix also handles, so the test would prove nothing
        Socket probe();
        probe.setAlpnProtocols(("h2",));
        probe.acceptAllCertificates(True);
        bool refused;
        try {
            probe.connectSSL("127.0.0.1:" + port, 10s);
            probe.close();
        } catch (hash<ExceptionInfo> ex) {
            refused = ex.desc =~ /no application protocol/;
        }
        if (!refused) {
            stopServer(p);
            testSkip(sprintf("node %s does not refuse a client without http/1.1 with no_application_protocol (node "
                ">= 18.18 is needed)", trim(`node -v`)));
        }
        # the certificate files are read at startup
        return {"process": p, "port": port};
    }

    private stopServer(Process p) {
        if (p.running()) {
            p.terminate();
        }
        p.wait();
    }
%endif
}
