%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires FsUtil
%requires HttpClientIo

%try-module process >= 2.2
%define NoProcess
%endtry

%exec-class HttpClientIoAutoAlpnHttp11Test

#! issue #5671: with an automatic protocol selection, a TLS server without HTTP/2 is reached over HTTP/1.1
/** The TCP leg of the automatic protocol selection offered only ALPN "h2"; a TLS server that does not do HTTP/2 and
    is strict about ALPN (nginx on an "ssl" listener without "http2 on") refused the handshake with a
    no_application_protocol alert, which gave no HTTP/1.1 attempt.  The leg now offers "h2" and "http/1.1", and a
    server that selects HTTP/1.1 is used over HTTP/1.1; an explicit HTTP/2 selection still offers "h2" only.
*/
class HttpClientIoAutoAlpnHttp11Test inherits QUnit::Test {
    private {
        const CertPem = "-----BEGIN CERTIFICATE-----
MIIDCTCCAfGgAwIBAgIUahuuRGDlubXWYmiPhjVeT66vtNYwDQYJKoZIhvcNAQEL
