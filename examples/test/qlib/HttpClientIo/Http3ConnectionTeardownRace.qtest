#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - HTTP/3 (QUIC) client connection attempt torn down while another thread reads its error

# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit

%exec-class Http3ConnectionTeardownRaceTest

#! The error of an HTTP/3 client connection is read safely while its connection attempt is torn down (issue #6453)
/** A thread that reads the error of a connection whose attempt is still in its handshake takes the attempt's poll
    operation with a reference of its own, so that the teardown of the attempt by another thread (here a close of the
    connection) does not release the operation while it is used.  The C++ test holds the reading thread with the
    "teardown-read" hold point of debug builds after it took the operation, closes the connection and then lets the
    reading thread use the operation.
*/
class Http3ConnectionTeardownRaceTest inherits QUnit::Test {
    constructor() : Test("HTTP/3 connection teardown race test", "1.0") {
        addTestCase("the error is read while the connection attempt is torn down", \errorReadTest());
        set_return_value(main());
    }

    errorReadTest() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("needs a debug build of the library (dbg_run_h3_connection_teardown_read_test())");
        }
        hash<auto> res = call_function("dbg_run_h3_connection_teardown_read_test");
        if (res.skip) {
            testSkip(res.skip);
        }
        assertGt(0, res.test_count, "the C++ test ran");
        assertEq(0, res.fail_count, sprintf("C++ test: %d/%d passed, %d failed", res.pass_count, res.test_count,
            res.fail_count));
    }
}
