#! Hands the test each response stream that the server sets up, so that the test writes to it directly
class PushHandler inherits ServerSentEventHandler::ServerSentEventHandler {
    public {
        #! receives {proto, sock, stream_id, session_id, wake} for each stream
        Queue streams();
    }

    constructor() : ServerSentEventHandler::ServerSentEventHandler({"data": "none", "heartbeat": 0}) {
    }

    HttpServerAsyncIo::Http2SseStream setupAsyncSseConnectionHttp2(Socket sock, hash<auto> cx, hash<auto> hdr,
            string cid, int stream_id, *code<nothing()> wake_callback) {
        HttpServerAsyncIo::Http2SseStream rv = ServerSentEventHandler::setupAsyncSseConnectionHttp2(sock, cx, hdr,
            cid, stream_id, wake_callback);
        streams.push({"proto": "h2", "sock": sock, "stream_id": stream_id, "wake": wake_callback});
        return rv;
    }

    HttpServerAsyncIo::Http3SseStream setupAsyncSseConnectionHttp3(Socket sock, hash<auto> cx, hash<auto> hdr,
            string cid, int session_id, int stream_id, *code<nothing()> wake_callback) {
        HttpServerAsyncIo::Http3SseStream rv = ServerSentEventHandler::setupAsyncSseConnectionHttp3(sock, cx, hdr,
            cid, session_id, stream_id, wake_callback);
        streams.push({"proto": "h3", "sock": sock, "session_id": session_id, "stream_id": stream_id,
            "wake": wake_callback});
        return rv;
    }
}

#! Answers with a body returned whole
class PlainHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, binary(strmul("p", PlainSize)), {"Content-Type": "application/octet-stream"});
    }
}

#! Writes to a response stream from the server side
class Writer {
    private {
        hash<auto> st;
    }

    constructor(hash<auto> st) {
        self.st = st;
    }

    #! Writes data; returns False if the stream's send buffer is full
    bool write(data d) {
        if (st.proto == "h2") {
            try {
                st.sock.sendHttp2StreamData(st.stream_id, binary(d), False);
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err == "HTTP2-FLOW-CONTROL") {
                    return False;
                }
                rethrow;
            }
        } else if (st.sock.submitQuicStreamData(st.session_id, st.stream_id, d, False) == 1) {
            return False;
        }
        if (st.wake) {
            st.wake();
        }
        return True;
    }

    #! Writes data, waiting for the client to take data whenever the buffer is full (a hang guard only)
    writeAll(data d) {
        int waits = 0;
        while (!write(d)) {
            if (st.wake) {
                st.wake();
            }
            int rc = st.proto == "h2"
                ? st.sock.waitForHttp2StreamDrain(st.stream_id, 1s)
                : st.sock.waitForQuicStreamDrain(st.session_id, st.stream_id, 1s);
            if (rc && ++waits > HangGuard.durationSeconds()) {
                throw "TEST-ERROR", "the client took no data within the hang guard";
            }
            if (!rc) {
                waits = 0;
            }
        }
    }

    #! Writes until the stream's send buffer is full; returns the bytes written, or -1 if MaxBytes were written
    int writeUntilFull() {
        binary chunk = binary(strmul("x", ChunkSize));
        int taken = 0;
        while (taken < MaxBytes) {
            if (!write(chunk)) {
                return taken;
            }
            taken += ChunkSize;
        }
        return -1;
    }

    #! Ends the stream
    end() {
        if (st.proto == "h2") {
            st.sock.sendHttp2StreamData(st.stream_id, NOTHING, True);
        } else {
            st.sock.submitQuicStreamData(st.session_id, st.stream_id, "", True);
        }
        if (st.wake) {
            st.wake();
        }
    }
}

#! Reads a stream to its end on a thread of its own
class BodyReader {
    public {
        int bytes = 0;
        *hash<ExceptionInfo> err;
        Counter done(1);
    }

    constructor(HttpClientIo::HttpClientStreamHandle stream) {
        background sub () {
            on_exit done.dec();
            try {
                while (True) {
                    auto v = stream.readData(HangGuard);
                    if (!exists v) {
                        throw "TEST-ERROR", "no data within the hang guard";
                    }
                    if (v.typeCode() == NT_HASH) {
                        if (v.end_stream) {
                            break;
                        }
                        if (v.error) {
                            throw "TEST-ERROR", sprintf("stream error: %y", v);
                        }
                        continue;
                    }
                    bytes += v.size();
                }
            } catch (hash<ExceptionInfo> ex) {
                err = ex;
            }
        }();
    }

    int wait() {
        return done.waitForZero(HangGuard);
    }
}

class ClientReceiveCreditTest inherits QUnit::Test {
    private {
        HttpServer server;
        PushHandler handler();
        int tls_port;
    }

    constructor() : Test("ClientReceiveCreditTest", "1.0") {
        foreach string proto in (("h2", "h3")) {
            addTestCase(proto + ": every byte consumed is credited while the stream is open", \testCreditAccounting(),
                proto);
        }
        addTestCase("h2: oversized responses do not pin the connection", \testOversizedResponses());
        foreach string proto in (("h2", "h3")) {
            addTestCase(proto + ": a client that does not read is bounded, and then reads everything",
                \testNonReadingThenDrain(), proto);
            addTestCase(proto + ": a stream that is not read does not hold up the other streams",
                \testOneStreamNotRead(), proto);
            addTestCase(proto + ": streams reset with data in flight do not pin the connection",
                \testResetInFlight(), proto);
            addTestCase(proto + ": large downloads through every read path", \testReadPaths(), proto);
            addTestCase(proto + ": a stream's channel outlives its session", \testChannelOutlivesSession(),
                proto);
        }
        addTestCase("h2: HTTPClient streaming (receive callback) gets every byte", \testHttpClientRecvCallback());
        set_return_value(main());
    }

    globalSetUp() {
        Logger logger("client-receive-credit", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }
        server = new HttpServer(<HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        });
        server.setDefaultHandler("push", handler);
        server.setHandler("plain", "^/?plain", NOTHING, new PlainHandler());
        server.waitForAsyncIo();
        tls_port = server.addListener(<HttpListenerOptionInfo>{
            "node": "127.0.0.1",
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
            "enable_h3": True,
        }).port;
        server.waitForAsyncIo();
    }

    globalTearDown() {
        if (server) {
            server.stop();
            delete server;
        }
    }

    private HttpClientIo::HttpClientConnectionManager getMgr(string proto) {
        return new HttpClientIo::HttpClientConnectionManager(<HttpClientIo::HttpClientConnectionManagerOptions>{
            "protocol": proto,
            "accept_all_certs": True,
            "request_timeout": HangGuard,
            "connect_timeout": HangGuard,
        });
    }

    private string getUrl() {
        return sprintf("https://127.0.0.1:%d/", tls_port);
    }

    #! Opens a streaming response and returns its handle and its server-side stream
    private hash<auto> openStream(HttpClientIo::HttpClientConnectionManager mgr) {
        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireAndStartStreaming(getUrl(), "GET", "/",
            {"Accept": "text/event-stream"});
        return {"stream": stream, "writer": new Writer(handler.streams.get(HangGuard))};
    }

    testNonReadingThenDrain(string proto) {
        HttpClientIo::HttpClientConnectionManager mgr = getMgr(proto);
        on_exit delete mgr;
        hash<auto> s = openStream(mgr);
        Writer w = s.writer;
        # the client takes nothing: its stream credit runs out, and the server's send buffer fills
        int taken = w.writeUntilFull();
        assertGt(0, taken + 1, sprintf("the server's buffer is full before %d bytes", MaxBytes));
        # the client holds the data it received without granting its stream credit, at most the stream's window
        if (Option::HAVE_LIBRARY_DEBUGGING) {
            hash<auto> stats = call_function("dbg_http_stream_credit_stats");
            int outstanding = stats.deferred - stats.credited - stats.settled;
            assertGt(0, outstanding, "the client holds unread data without granting its stream credit");
            assertLt(MaxWindow + 1, outstanding, "the data held for the client is bounded by the stream window");
        }
        # the client reads now: everything arrives, including what the server writes from now on
        BodyReader r(s.stream);
        w.writeAll(binary(strmul("y", 4 * 1024 * 1024)));
        w.end();
        assertEq(0, r.wait(), "the reader ended");
        assertNothing(r.err);
        assertEq(taken + 4 * 1024 * 1024, r.bytes, "every byte arrives");
    }

    testOneStreamNotRead(string proto) {
        HttpClientIo::HttpClientConnectionManager mgr = getMgr(proto);
        on_exit delete mgr;
        hash<auto> idle = openStream(mgr);
        on_exit idle.stream.cancel();
        # the stream that is not read is full
        assertGt(0, idle.writer.writeUntilFull() + 1, "the stream that is not read is full");
        # the other streams of the connection complete
        foreach int i in (xrange(3)) {
            hash<auto> s = openStream(mgr);
            BodyReader r(s.stream);
            s.writer.writeAll(binary(strmul("z", 2 * 1024 * 1024)));
            s.writer.end();
            assertEq(0, r.wait(), sprintf("stream %d ended", i));
            assertNothing(r.err);
            assertEq(2 * 1024 * 1024, r.bytes, sprintf("stream %d gets every byte", i));
        }
    }

    testResetInFlight(string proto) {
        HttpClientIo::HttpClientConnectionManager mgr = getMgr(proto);
        on_exit delete mgr;
        foreach int i in (xrange(5)) {
            hash<auto> s = openStream(mgr);
            # data in flight when the client resets the stream
            s.writer.write(binary(strmul("r", ChunkSize)));
            s.stream.cancel();
            # a response returned whole on the same connection still arrives
            hash<auto> resp = mgr.request(getUrl(), "GET", "/plain", NOTHING, NOTHING, HangGuard, False);
            assertEq(PlainSize, resp.body.size(), sprintf("round %d: the response arrives whole", i));
        }
    }

    testReadPaths(string proto) {
        HttpClientIo::HttpClientConnectionManager mgr = getMgr(proto);
        on_exit delete mgr;
        # a body returned whole
        assertEq(PlainSize, mgr.request(getUrl(), "GET", "/plain", NOTHING, NOTHING, HangGuard, False).body.size(),
            "a body returned whole");
        # SseStreamReader (readData())
        {
            hash<auto> s = openStream(mgr);
            HttpClientStreamingIo::SseStreamReader reader(s.stream);
            string payload = strmul("e", 65536);
            int events = proto == "h3" ? 400 : 64;
            Counter written(1);
            *hash<ExceptionInfo> write_err;
            background sub () {
                on_exit written.dec();
                try {
                    foreach int i in (xrange(events)) {
                        s.writer.writeAll(sprintf("id: %d\ndata: %s\n\n", i, payload));
                    }
                    s.writer.end();
                } catch (hash<ExceptionInfo> ex) {
                    write_err = ex;
                }
            }();
            int n = 0;
            while (*hash<SseMessageInfo> e = reader.readEvent(HangGuard)) {
                assertEq(string(n), e.id);
                ++n;
            }
            assertEq(events, n, "SseStreamReader gets every event");
            assertEq(0, written.waitForZero(HangGuard));
            assertNothing(write_err, "the server wrote every event");
        }
        # the parsed events of a Queue (SSE state installed on the stream)
        {
            HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(getUrl());
            Queue q = stream.startSseStreaming("GET", "/", {"Accept": "text/event-stream"});
            Writer w(handler.streams.get(HangGuard));
            string payload = strmul("q", 65536);
            int events = proto == "h3" ? 400 : 64;
            Counter written(1);
            *hash<ExceptionInfo> write_err;
            background sub () {
                on_exit written.dec();
                try {
                    foreach int i in (xrange(events)) {
                        w.writeAll(sprintf("id: %d\ndata: %s\n\n", i, payload));
                    }
                    w.end();
                } catch (hash<ExceptionInfo> ex) {
                    write_err = ex;
                }
            }();
            int n = 0;
            while (True) {
                auto e = q.get(HangGuard);
                if (!e || e.hasKey("err")) {
                    break;
                }
                assertEq(string(n), e.id);
                ++n;
            }
            assertEq(events, n, "the event Queue gets every event");
            assertEq(0, written.waitForZero(HangGuard));
            assertNothing(write_err, "the server wrote every event");
            stream.cancel();
        }
    }

    testHttpClientRecvCallback() {
        HTTPClient hc({"url": getUrl()});
        hc.setHttp2Mode("required");
        int size = 4 * 1024 * 1024;
        Counter written(1);
        *hash<ExceptionInfo> write_err;
        background sub () {
            on_exit written.dec();
            try {
                Writer w(handler.streams.get(HangGuard));
                w.writeAll(binary(strmul("c", size)));
                w.end();
            } catch (hash<ExceptionInfo> ex) {
                write_err = ex;
            }
        }();
        int bytes = 0;
        hc.sendWithRecvCallback(sub (hash<auto> h) {
            if (h.data) {
                bytes += h.data.size();
            }
        }, NOTHING, "GET", "/", {"Accept": "text/event-stream"}, HangGuard);
        assertEq(0, written.waitForZero(HangGuard));
        assertNothing(write_err, "the server wrote everything");
        assertEq(size, bytes, "the receive callback gets every byte");
    }

    testChannelOutlivesSession(string proto) {
        HttpClientIo::HttpClientConnectionManager mgr = getMgr(proto);
        hash<auto> s = openStream(mgr);
        s.writer.writeAll(binary(strmul("o", 256 * 1024)));
        # the session ends with data unread in the stream's channel
        delete mgr;
        # the channel is read after its session is gone, and then released
        int bytes = 0;
        while (True) {
            auto v;
            try {
                v = s.stream.readData(HangGuard);
            } catch (hash<ExceptionInfo> ex) {
                break;
            }
            if (!exists v || v.typeCode() == NT_HASH) {
                break;
            }
            bytes += v.size();
        }
        assertGe(bytes, 256 * 1024, "the data read after the session ended is at most what was written");
        remove s;
    }

    testCreditAccounting(string proto) {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("the credit accounting is only in debug builds");
        }
        HttpClientIo::HttpClientConnectionManager mgr = getMgr(proto);
        on_exit delete mgr;
        hash<auto> s = openStream(mgr);
        hash<auto> before = call_function("dbg_http_stream_credit_stats");
        # more than the stream's window (64 KiB on HTTP/2, 16 MiB on HTTP/3): lost credit stalls the stream
        int size = 24 * 1024 * 1024;
        Counter written(1);
        *hash<ExceptionInfo> write_err;
        background sub () {
            on_exit written.dec();
            try {
                s.writer.writeAll(binary(strmul("a", size)));
            } catch (hash<ExceptionInfo> ex) {
                write_err = ex;
            }
        }();
        # every byte is read while the stream is still open
        int bytes = 0;
        while (bytes < size) {
            auto v = s.stream.readData(HangGuard);
            if (!exists v) {
                break;
            }
            if (v.typeCode() == NT_HASH) {
                # the response headers, or the end of the stream
                if (v.end_stream || v.error) {
                    break;
                }
                continue;
            }
            bytes += v.size();
        }
        assertEq(size, bytes, "every byte arrives");
        assertEq(0, written.waitForZero(HangGuard));
        assertNothing(write_err);
        hash<auto> after = call_function("dbg_http_stream_credit_stats");
        int deferred = after.deferred - before.deferred;
        assertEq(size, deferred, "the stream credit of every byte was deferred");
        assertEq(deferred, after.credited - before.credited, "every byte consumed was credited");
        assertEq(0, after.settled - before.settled, "nothing was left to settle");
        s.writer.end();
    }

    testOversizedResponses() {
        HttpClientIo::HttpClientConnectionManager mgr(<HttpClientIo::HttpClientConnectionManagerOptions>{
            "protocol": "h2",
            "accept_all_certs": True,
            "request_timeout": HangGuard,
            "connect_timeout": HangGuard,
            "max_response_body_size": 4096,
        });
        on_exit delete mgr;
        # the discarded data of each oversized response is credited, so the connection never pins
        foreach int i in (xrange(8)) {
            *string err;
            try {
                mgr.request(getUrl(), "GET", "/plain", NOTHING, NOTHING, HangGuard, False);
            } catch (hash<ExceptionInfo> ex) {
                err = ex.err;
            }
            assertRegex("TOO-LARGE", err ?? "", sprintf("round %d: the oversized response is refused", i));
        }
    }
}
