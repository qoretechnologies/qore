%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires Util
%requires Mime
%requires Logger
%requires HttpServerUtil
%requires HttpServer
%requires HttpClientIo
%requires RestClientIo

%exec-class HttpClientIoRaceTest

class TestHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, "reached", {"Content-Type": MimeTypeText});
    }
}

#! The race of HTTP/3 and HTTP/2 of automatic protocol selection ends early only on a success
/** When one protocol fails, the race waits for the other one's own outcome.  The server here receives HTTP/3 only:
    the test holds the TCP port of the same number with a socket that is bound and does not listen, so that the
    connections of HTTP/2 are refused at once.  Ports are assigned per protocol, so another process (a test run in
    parallel) can hold that TCP port first (qore#7461): the test does not retry; the server has a certificate of its
    own, which the client of the case that reaches the server trusts alone, so that HTTP/2 fails also against another
    server, at its TLS handshake, instead of reaching it, and the case whose client refuses every certificate, which
    can tell a refusal over HTTP/3 from one over HTTP/2 only when HTTP/2 is refused at once, is skipped then.  The
    client's first QUIC
    flight of datagrams is dropped (\c QORE_QUIC_TEST_DROP_CLIENT_DATAGRAMS, DEBUG builds only), so the HTTP/3
    handshake cannot complete before its retransmission timer fires, long after HTTP/2 has started and failed.
*/
public class HttpClientIoRaceTest inherits QUnit::Test {
    public {
        #! the client APIs tested
        const Apis = ("REST", "REST async", "HTTP", "HTTP async");

        #! A certificate of the test's server that no other test uses: a server of another process cannot complete a
        #! TLS handshake that the client verifies against it alone (qore#7461)
        /** Self-signed (CA:TRUE), CN localhost, SAN DNS:localhost, IP 127.0.0.1 and ::1, valid from 2025 to 2125
        */
        const CertPem = "-----BEGIN CERTIFICATE-----
MIIDOjCCAiKgAwIBAgIUatGJPG/+xMHJGu2gicX0OkUQMyUwDQYJKoZIhvcNAQEL
BQAwFDESMBAGA1UEAwwJbG9jYWxob3N0MCAXDTI1MDEwMTAwMDAwMFoYDzIxMjUw
MTAxMDAwMDAwWjAUMRIwEAYDVQQDDAlsb2NhbGhvc3QwggEiMA0GCSqGSIb3DQEB
AQUAA4IBDwAwggEKAoIBAQDI5hgn++FfmntEs+oNXrTF0pOQ3+WlMpxgVf4MgzLr
