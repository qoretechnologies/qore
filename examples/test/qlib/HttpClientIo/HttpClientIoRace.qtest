GUMQUcCluzVGzQ4wDwYDVR0TAQH/BAUwAwEB/zAsBgNVHREEJTAjgglsb2NhbGhv
c3SHBH8AAAGHEAAAAAAAAAAAAAAAAAAAAAEwDQYJKoZIhvcNAQELBQADggEBACy+
w0w7GnIS2mYbOvsILLQ4IGqOhd9JvEDh509Gdwbgdm4W4mvuVXdeXOAJM3jkdYJ+
noEm87bsQnLsdSRr3osGxSjT2NZZN+cRXpILkM+KFCz2jMx2qNdf+nDOunzJehOb
TOjXgWTgTbaiV9dXS8F08qdBWONk5+/PB3L8xDji7eTCey1RfVPuzpXzrQfBxpnB
XqhHpsSrIGQouXGZzOX+N39F0CNwstyTuRkjSbbhgpCgCRvTpHMgxBzzVeKUy+ow
K1AGkHu4zMGUOBo4PvfG2EroRMSH1Thx3l061oNXWmaRyioNQebltIBHxBwyo0F9
9QsATdOZaWvHz1kbdfk=
-----END CERTIFICATE-----
";

        #! the private key of @ref CertPem
        const KeyPem = "-----BEGIN PRIVATE KEY-----
MIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQDI5hgn++FfmntE
s+oNXrTF0pOQ3+WlMpxgVf4MgzLrQtxxzoWHSAQ12LP4svkqbyWcI9FRFFlvOdQj
ft2byZwm+6M6ZK2kh0IeOdvNZ6Q2B+FkiCNIBRGuZLVbzjyDPnnGEpaV/ZDBJoo6
yV+Hgt19FMAS+Fi07ONndMEr679DHgTgE/8H9ZUvNqwicAHkxdQ2sr57LdZ2U3pa
CFLslcQdVMxTRswePxbI3nkpBymLrvFTDwobk6HBSzQPXgVRueiIuwpTLy23qdn3
0UpfZPyNpfbxCHrJnoYXL1kmHOKGCigYo8bjc/FjmRmIupFzehj1HAfNOyKYQ5NA
3UaBf2ZLAgMBAAECggEAM4kzMS6gRhIvBRTSOdPNs+GtEUEefB5blyr4HOWbLlbc
jiVYg7epvNZ2dJoU6RnSIBfgHliGCM5g6SomV0yEzktHODeTg91ezLoy9KJdsa6b
11pFEriaLI6RJ5fkVha0zmb+UkPV2na0hxgZdX3Qq8Gi9DrZJrCONX/x/f5f9itM
3odcsdBH1r4rOWhOW2fZKSFnkx3pyMorzHCfdXx/eOBQ5i0/9zLghAEfRv5bW2r4
wOPdPgaraBAs7ZDvZ/qi9Fe120TIUl5BtdvAagnzw//rKN02RNStyLnGjvnjHuIf
e/L13IJxJImZqn6HWgXTZTDNXCGGnk72JlYTBxD0AQKBgQDmf+i00fz0aYtavsGJ
