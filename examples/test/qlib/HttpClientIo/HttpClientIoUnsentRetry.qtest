#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

# Copyright (C) 2026 Qore Technologies, s.r.o.

# A request that HttpClientIo does not send, because the pooled keep-alive connection that it took was closed by the
# server just before the request was written, is sent again on a new connection whatever its method (qore#7278).
# The check that precedes the send of a request on a keep-alive connection finds the server's close (EOF), or the
# response that the server sent as it closed the idle connection (a 408), and the request is never written: nothing
# reached the server, so a POST is as safe to send again as a GET.  Before, only an idempotent request was sent
# again, and a POST failed with HTTP1-CONNECTION-CLOSED.  This happened, for example, to a connection that finished
# connecting after its request's deadline, which was pooled unused and closed by the server after its idle timeout.
#
# The same holds on a pooled connection that never carried a request, where the server's 408 before the first
# request was HTTP1-UNEXPECTED-DATA, which was not sent again even for a GET (qore#7345); on a connection created for
# the request, the same data is a protocol problem, and the request is not sent again.
#
# The server closes the connection at the point of the request with a debug hook (dbg_http1_answer_at()), so that
# the order of the close and the check is deterministic.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires HttpClientIo

%exec-class HttpClientIoUnsentRetryTest

#! a hang guard only, never a timing assertion
const Timeout = 10s;

#! A fake HTTP/1.1 server: the first connection answers one request with keep-alive and is then handed to the test;
#! each further connection answers its requests with keep-alive
class FakeServer {
    public {
        #! the server-side socket of the first connection, after it answered its request
        Queue first_conn();
        #! the path of each request received, with the number of its connection
        Queue requests();
    }

    private {
        Socket listener();
        int port;
        Counter running();
        int conn_count = 0;
        bool stopped;
        #! True if the first connection is handed to the test as soon as it is accepted, before any request
        bool hand_over_at_accept;
    }

    constructor(bool hand_over_at_accept = False) {
        self.hand_over_at_accept = hand_over_at_accept;
        listener.bind("127.0.0.1:0");
        listener.listen();
        port = listener.getSocketInfo().port;
        running.inc();
        background acceptLoop();
    }

    int getPort() {
        return port;
    }

    int getConnectionCount() {
        return conn_count;
    }

    stop() {
        stopped = True;
        listener.close();
        running.waitForZero();
    }

    private acceptLoop() {
        on_exit running.dec();
        while (!stopped) {
            *Socket s;
            try {
                s = listener.accept(Timeout);
            } catch (hash<ExceptionInfo> ex) {
                # the listener was closed by stop()
                break;
            }
            if (!s) {
                continue;
            }
            int n = ++conn_count;
            running.inc();
            background serve(s, n);
        }
    }

    private serve(Socket s, int n) {
        on_exit running.dec();
        bool handed_over;
        on_exit if (!handed_over) {
            s.close();
        }
        if (n == 1 && hand_over_at_accept) {
            handed_over = True;
            first_conn.push(s);
            return;
        }
        while (True) {
            hash<auto> h;
            try {
                h = s.readHTTPHeader(Timeout);
            } catch () {
                return;
            }
            if (!h.method) {
                return;
            }
            int cl = int(h."content-length");
            if (cl > 0) {
                s.recvBinary(cl, Timeout);
            }
            requests.push(sprintf("%d %s", n, h.path));
            s.send("HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: keep-alive\r\n\r\nok");
            if (n == 1) {
                # the first connection is handed to the test, which has it closed at the point of the next request
                handed_over = True;
                first_conn.push(s);
                return;
            }
        }
    }
}

class HttpClientIoUnsentRetryTest inherits QUnit::Test {
    constructor() : QUnit::Test("HttpClientIoUnsentRetry", "1.0") {
        foreach string method in (("POST", "PATCH", "GET")) {
            addTestCase(sprintf("%s: the server closes the pooled connection before the request is sent", method),
                \testUnsent(), (method, ""));
            addTestCase(sprintf("%s: the server answers 408 and closes the pooled connection before the request is "
                "sent", method), \testUnsent(),
                (method, "HTTP/1.1 408 Request Timeout\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"));
        }
        addTestCase("POST: the server closes the connection after the request was sent: it is not sent again",
            \testSentNotRetried());
        foreach string method in (("POST", "GET")) {
            addTestCase(sprintf("%s: a pooled connection that never carried a request gets a 408 before the request "
                "is sent", method), \testPooledUnused(), method);
        }
        addTestCase("unexpected data before the request on a connection created for it is not a reason to send the "
            "request again", \testFreshUnexpectedData());
        set_return_value(main());
    }

    setUp() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("the library is not built with debugging");
        }
    }

    #! the request is sent again on a new connection, and it reaches the server once
    testUnsent(string method, string response) {
        FakeServer server();
        on_exit server.stop();
        HttpClientConnectionManager mgr(<HttpClientConnectionManagerOptions>{"protocol": "h1"});
        on_exit delete mgr;
        string url = sprintf("http://127.0.0.1:%d", server.getPort());

        # a GET has no body
        *string body = method == "GET" ? NOTHING : "one";
        *hash<auto> hdrs = method == "GET" ? NOTHING : {"Content-Type": "text/plain"};
        hash<auto> first = mgr.request(url, method, "/first", hdrs, body, Timeout);
        assertEq(200, first.status_code, "the first request is answered");
        assertEq("1 /first", server.requests.get(Timeout), "the first request reached the first connection");

        # the server closes the pooled connection at the check that precedes the send of the next request
        Counter reached(1);
        # the test keeps the server's socket: the destructor of the Socket object would close it
        Socket peer = server.first_conn.get(Timeout);
        on_exit peer.close();
        call_function("dbg_http1_answer_at", "idle-check", reached, peer, response);
        bool armed = True;
        on_exit if (armed) {
            call_function("dbg_http1_send_failure_result");
        }

        hash<auto> second;
        *hash<ExceptionInfo> err;
        try {
            second = mgr.request(url, method, "/second", hdrs, method == "GET" ? NOTHING : "two", Timeout);
        } catch (hash<ExceptionInfo> ex) {
            err = ex;
        }
        armed = False;
        hash<auto> hook_result = call_function("dbg_http1_send_failure_result");
        assertEq(0, reached.getCount(), "the server closed the connection at the check before the send");
        if (err) {
            fail(sprintf("the request was not sent again: %s: %s (arg: %y; hook: %y)", err.err, err.desc, err.arg, hook_result));
        }
        assertEq(200, second.status_code, "the request is answered on a new connection");
        assertEq("ok", second.body, "the response body");
        # the request reached the server once, on the second connection: it was not sent on the closed one
        assertEq("2 /second", server.requests.get(Timeout), "the request reached the new connection");
        assertEq(0, server.requests.size(), "the request reached the server once");
        assertEq(2, server.getConnectionCount(), "a new connection was made for the request");
    }

    #! a POST that was written before the server closed the connection may have been processed: it is not sent again
    testSentNotRetried() {
        FakeServer server();
        on_exit server.stop();
        HttpClientConnectionManager mgr(<HttpClientConnectionManagerOptions>{"protocol": "h1"});
        on_exit delete mgr;
        string url = sprintf("http://127.0.0.1:%d", server.getPort());

        hash<auto> first = mgr.request(url, "POST", "/first", {"Content-Type": "text/plain"}, "one", Timeout);
        assertEq(200, first.status_code, "the first request is answered");
        assertEq("1 /first", server.requests.get(Timeout), "the first request reached the first connection");

        # the server closes the connection once the request has been written
        Counter reached(1);
        Socket peer = server.first_conn.get(Timeout);
        on_exit peer.close();
        call_function("dbg_http1_answer_at", "after-sent", reached, peer, "");
        bool armed = True;
        on_exit if (armed) {
            call_function("dbg_http1_send_failure_result");
        }

        *hash<ExceptionInfo> err;
        try {
            mgr.request(url, "POST", "/second", {"Content-Type": "text/plain"}, "two", Timeout);
        } catch (hash<ExceptionInfo> ex) {
            err = ex;
        }
        armed = False;
        call_function("dbg_http1_send_failure_result");
        assertEq(0, reached.getCount(), "the server closed the connection after the request was written");
        assertEq("HTTP1-CONNECTION-CLOSED", err.err, "the request fails with the connection's error");
        assertFalse(err.arg.typeCode() == NT_HASH && err.arg.request_sent === False,
            "the error does not say that the request was not sent");
        assertEq(1, server.getConnectionCount(), "the request was not sent again on a new connection");
        assertEq(0, server.requests.size(), "no further request reached the server");
    }

    #! a pooled connection that never carried a request, which the server answers with a 408 as it closes it before
    #! the request is sent: the request is sent again on a new connection whatever its method (qore#7345)
    testPooledUnused(string method) {
        FakeServer server(True);
        on_exit server.stop();
        HttpClientConnectionManager mgr(<HttpClientConnectionManagerOptions>{"protocol": "h1"});
        on_exit delete mgr;
        string url = sprintf("http://127.0.0.1:%d", server.getPort());

        # a request that fails after its connection was made and before it was written leaves the connection in the
        # pool, unused
        assertThrows("HTTP-HEADER-ERROR", \mgr.request(), (url, "GET", "/bad", {"X-Bad": "a\r\nb"}, NOTHING,
            Timeout), "the first request fails before it is written");
        Socket peer = server.first_conn.get(Timeout);
        on_exit peer.close();

        Counter reached(1);
        call_function("dbg_http1_answer_at", "idle-check", reached, peer,
            "HTTP/1.1 408 Request Timeout\r\nContent-Length: 0\r\nConnection: close\r\n\r\n");
        bool armed = True;
        on_exit if (armed) {
            call_function("dbg_http1_send_failure_result");
        }

        *string body = method == "GET" ? NOTHING : "two";
        *hash<auto> hdrs = method == "GET" ? NOTHING : {"Content-Type": "text/plain"};
        hash<auto> second;
        *hash<ExceptionInfo> err;
        try {
            second = mgr.request(url, method, "/second", hdrs, body, Timeout);
        } catch (hash<ExceptionInfo> ex) {
            err = ex;
        }
        armed = False;
        hash<auto> hook_result = call_function("dbg_http1_send_failure_result");
        assertEq(0, reached.getCount(), "the server answered at the check before the send");
        if (err) {
            fail(sprintf("the request was not sent again: %s: %s (arg: %y; hook: %y)", err.err, err.desc, err.arg,
                hook_result));
        }
        assertEq(200, second.status_code, "the request is answered on a new connection");
        assertEq("2 /second", server.requests.get(Timeout), "the request reached the new connection");
        assertEq(0, server.requests.size(), "the request reached the server once");
        assertEq(2, server.getConnectionCount(), "a new connection was made for the request");
    }

    #! the same error on a connection created for the request (no stream taken from the pool): the request is not
    #! sent again, whatever its method, while a closed connection's error with the same inputs is
    testFreshUnexpectedData() {
        HttpClientConnectionManager mgr(<HttpClientConnectionManagerOptions>{"protocol": "h1"});
        on_exit delete mgr;
        string url = "http://127.0.0.1:1";
        foreach string method in (("GET", "POST")) {
            hash<HttpClientResendInfo> state();
            hash<ExceptionInfo> ex = <ExceptionInfo>{
                "err": "HTTP1-UNEXPECTED-DATA",
                "desc": "server sent unexpected data on idle keep-alive connection before request",
                "arg": {"request_sent": False},
            };
            assertFalse(mgr.resendRequest(url, method, NOTHING, ex, \state),
                method + ": unexpected data without a pooled connection is not a reason to send the request again");
            assertEq(0, state.retries, method + ": no attempt counted");

            # control: a closed connection's error with the same inputs is
            ex.err = "HTTP1-CONNECTION-CLOSED";
            assertTrue(mgr.resendRequest(url, method, NOTHING, ex, \state),
                method + ": a closed connection's error is a reason to send the request again");
        }
    }
}
