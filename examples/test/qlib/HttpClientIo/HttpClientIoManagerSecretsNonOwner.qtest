#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - HTTP/1.1 client connections over TCP, used by code that a sandbox restricts
# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires HttpClientIo
%requires RestClientIo
%requires RestClient
%requires ConnectionProvider
%requires HttpServer
%requires HttpServerUtil

%exec-class HttpClientIoManagerSecretsNonOwnerTest

#! A sandboxed borrower of a connection manager or a REST client that other code shares cannot read or change the
#! cookies of the host, or use its proxy credentials (qore#7837)
/** The manager's methods that give the cookies of its jar (addCookieHeaders()), store cookies in it
    (storeResponseCookies(), storeStateCookies()) or use the credentials of its proxy (prepareRequestHeaders(),
    processAuthChallenge()), and the methods of a REST client that owns its manager that do the same for its jar
    (addClientCookies(), storeClientCookies()), are refused for code that a sandbox restricts and that does not own the
    manager (PERMISSION-DENIED): the values would be given to the borrower, or the borrower would put cookies in the
    jar that the host's requests send.  The requests that the borrower makes with a lent manager or client still send
    and store the cookies, as the module makes them for it.  The owner, and restricted code that owns its manager,
    use the methods as before.
*/

#! a hang guard only, never a timing assertion
const HangGuard = 20s;

#! the code of the borrower
const BorrowerCode = "%modern
%requires HttpClientIo
%requires RestClientIo
%requires ConnectionProvider
#! calls a method of the lent manager that gives or changes the cookies, or uses the proxy credentials; returns what
#! happened
string sub change(HttpClientConnectionManager mgr, string what, string url) {
    try {
        hash<auto> st = mgr.newRequestState();
        switch (what) {
            case \"addCookieHeaders\": mgr.addCookieHeaders(url, \"/\", {}); break;
            case \"storeResponseCookies\": mgr.storeResponseCookies(url, \"/\", {\"set-cookie\": \"evil=1; Path=/\"}); break;
            case \"prepareRequestHeaders\":
                mgr.prepareRequestHeaders(mgr.getRedirectFollower(url, \"/\", \"GET\"), NOTHING, \\st);
                break;
            case \"processAuthChallenge\":
                mgr.processAuthChallenge(407, {\"proxy-authenticate\": \"Basic realm=x\"}, NOTHING, \\st);
                break;
            case \"storeStateCookies\":
                mgr.storeStateCookies(st, mgr.getRedirectFollower(url, \"/\", \"GET\"), {\"set-cookie\": \"evil=1; Path=/\"});
                break;
            default: throw \"UNKNOWN\", what;
        }
        return \"done\";
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
}
#! calls a method of the lent REST client that gives or changes the cookies; returns what happened
string sub changeRest(RestClientIo::RestClientIo client, string what, string url) {
    try {
        switch (what) {
            case \"addClientCookies\": client.addClientCookies(url, \"/\", {}); break;
            case \"storeClientCookies\": client.storeClientCookies(url, \"/\", {\"set-cookie\": \"evil=1; Path=/\"}); break;
            case \"getCookieJar\": client.getCookieJar(); break;
            case \"copyGetCookieJar\": client.copyWithUrl(url).getCookieJar(); break;
            case \"copyAddClientCookies\": cast<RestClientIo::RestClientIo>(client.copyWithUrl(url)).addClientCookies(url, \"/\", {}); break;
            default: throw \"UNKNOWN\", what;
        }
        return \"done\";
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
}
#! makes two requests with a copy of a lent REST client; returns the body of the second response, or what happened
string sub copyTwice(RestClientIo::RestClientIo client, string url) {
    try {
        object o = client.copyWithUrl(url);
        call_object_method(o, \"restGetAsync\", \"/first\").get(20s);
        return call_object_method(o, \"restGetAsync\", \"/second\").get(20s).body;
    } catch (hash<ExceptionInfo> ex) {
        return ex.err + \": \" + ex.desc;
    }
}
#! a restricted borrower that owns its manager and its client uses all of the methods; returns what happened
string sub own(string url) {
    try {
        HttpClientConnectionManager m(<HttpClientConnectionManagerOptions>{\"protocol\": \"h1\"});
        hash<auto> st = m.newRequestState();
        m.storeResponseCookies(url, \"/\", {\"set-cookie\": \"own=1; Path=/\"});
        if (m.addCookieHeaders(url, \"/\", {}).Cookie != \"own=1\") {
            return \"no own cookie\";
        }
        HttpRedirectFollower rf = m.getRedirectFollower(url, \"/\", \"GET\");
        if (m.prepareRequestHeaders(rf, NOTHING, \\st).Cookie != \"own=1\") {
            return \"no own cookie in the request headers\";
        }
        m.storeStateCookies(st, rf, {\"set-cookie\": \"own2=1; Path=/\"});
        m.processAuthChallenge(401, {}, NOTHING, \\st);
        RestClientIo::RestClientIo c({\"url\": url, \"no_connect\": True});
        c.storeClientCookies(url, \"/\", {\"set-cookie\": \"c=1; Path=/\"});
        if (c.addClientCookies(url, \"/\", {}).Cookie != \"c=1\") {
            return \"no own client cookie\";
        }
        c.getCookieJar();
        return \"done\";
    } catch (hash<ExceptionInfo> ex) {
        return ex.err + \": \" + ex.desc;
    }
}
#! makes two requests with a connection that the host lent: the server sets a cookie with the first and sends back the
#! Cookie header of the second; returns the body of the second response, or what happened
string sub twice(AbstractConnection conn) {
    try {
        object o = conn.getAsync(False);
        if (o instanceof HttpClientConnectionManager) {
            HttpClientConnectionManager m = cast<HttpClientConnectionManager>(o);
            m.requestAsync(conn.url, \"GET\", \"/first\").get(20s);
            return m.requestAsync(conn.url, \"GET\", \"/second\").get(20s).body;
        }
        call_object_method(o, \"restGetAsync\", \"/first\").get(20s);
        return call_object_method(o, \"restGetAsync\", \"/second\").get(20s).body;
    } catch (hash<ExceptionInfo> ex) {
        return ex.err + \": \" + ex.desc;
    }
}
";

#! sets a cookie with every response and sends back the Cookie header of the request
class CookieHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return <HttpResponseInfo>{
            "code": 200,
            "hdr": {"Content-Type": "text/plain", "Set-Cookie": "sid=abc; Path=/"},
            "body": "cookie=" + (hdr.cookie ?? ""),
        };
    }
}

class HttpClientIoManagerSecretsNonOwnerTest inherits QUnit::Test {
    constructor() : QUnit::Test("lent manager and client: the borrower cannot take or change the cookies", "1.0",
            \ARGV) {
        addTestCase("the cookies and the proxy credentials of a lent manager are refused", \managerTest());
        addTestCase("the cookies of a lent REST client are refused", \restTest());
        addTestCase("a copy of a lent REST client keeps working for the borrower", \copyRequestTest());
        addTestCase("a restricted borrower that owns its manager and client uses them", \borrowerOwnerTest());
        addTestCase("the code that owns the manager uses them", \ownerTest());
        addTestCase("requests of a borrower with a lent connection send and store the cookies", \lentRequestTest());
        set_return_value(main());
    }

    #! returns a server, and its URL
    private hash<auto> startServer() {
        HttpServer server(<HttpServerOptionInfo>{});
        server.setDefaultHandler("cookie", new CookieHandler());
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        server.waitForAsyncIo();
        return {
            "server": server,
            "port": port,
            "url": sprintf("http://127.0.0.1:%d", port),
        };
    }

    #! a sandboxed borrower that may reach the server
    private Program getBorrower(int port) {
        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        SandboxManager sm();
        sm.setNetworkDefaultPolicy(False);
        sm.addNetworkAllowedIPRange("127.0.0.1/32");
        sm.addNetworkAllowedPort(port);
        p.setSandboxManager(sm);
        p.parse(BorrowerCode, "borrower");
        return p;
    }

    #! a borrower that the parse options restrict from the NETWORK domain: a connection that the host lends to it makes
    #! its client or manager with the proof of the host (qore#7262)
    private Program getNoNetworkBorrower(int port) {
        Program p(PO_NO_NETWORK | PO_NO_CHILD_PO_RESTRICTIONS);
        SandboxManager sm();
        sm.setNetworkDefaultPolicy(False);
        sm.addNetworkAllowedIPRange("127.0.0.1/32");
        sm.addNetworkAllowedPort(port);
        p.setSandboxManager(sm);
        p.parse(BorrowerCode, "borrower-nn");
        return p;
    }

    #! puts a cookie of the host in a jar
    private seed(HttpClientIo::CookieJar jar) {
        jar.processResponseHeaders("127.0.0.1", "/", False, {"set-cookie": "sid=SECRET; Path=/"});
    }

    managerTest() {
        hash<auto> srv = startServer();
        on_exit srv.server.stop();
        # a manager with the cookies of the host and the credentials of its proxy, which the host lends
        HttpClientConnectionManager mgr(<HttpClientConnectionManagerOptions>{
            "protocol": "h1",
            "proxy_url": "http://puser:psecret@127.0.0.1:1",
        });
        on_exit mgr.closeAll();
        seed(mgr.getCookieJar());
        Program p = getBorrower(srv.port);
        foreach string what in ("addCookieHeaders", "storeResponseCookies", "prepareRequestHeaders",
                "processAuthChallenge", "storeStateCookies") {
            assertEq("PERMISSION-DENIED", p.callFunction("change", mgr, what, srv.url), what);
        }
        # the host's jar is as it was: the cookie is there, and the borrower's is not
        assertEq("sid=SECRET", mgr.addCookieHeaders(srv.url, "/", {}).Cookie, "the host's cookies are unchanged");
        hash<auto> st = mgr.newRequestState();
        assertEq("sid=SECRET", mgr.prepareRequestHeaders(mgr.getRedirectFollower(srv.url, "/", "GET"), NOTHING,
            \st).Cookie, "the host's request headers");
    }

    restTest() {
        hash<auto> srv = startServer();
        on_exit srv.server.stop();
        RestClientIo::RestClientIo client({"url": srv.url, "no_connect": True});
        seed(client.getCookieJar());
        Program p = getBorrower(srv.port);
        foreach string what in ("addClientCookies", "storeClientCookies", "getCookieJar", "copyGetCookieJar",
                "copyAddClientCookies") {
            assertEq("PERMISSION-DENIED", p.callFunction("changeRest", client, what, srv.url), what);
        }
        assertEq("sid=SECRET", client.addClientCookies(srv.url, "/", {}).Cookie, "the host's cookies are unchanged");
    }

    copyRequestTest() {
        hash<auto> srv = startServer();
        on_exit srv.server.stop();
        # a copy of a lent client shares its manager and its jar: the requests that the borrower makes with it (the
        # asynchronous ones use the jar through the module) send and store the cookies
        foreach Program p in (getBorrower(srv.port), getNoNetworkBorrower(srv.port)) {
            RestClientIo::RestClientIo client({"url": srv.url, "no_connect": True, "data": "text"});
            assertEq("cookie=sid=abc", p.callFunction("copyTwice", client, srv.url), "a copy of a lent client");
        }
    }

    borrowerOwnerTest() {
        hash<auto> srv = startServer();
        on_exit srv.server.stop();
        Program p = getBorrower(srv.port);
        assertEq("done", p.callFunction("own", srv.url), "the borrower's own manager and client");
    }

    ownerTest() {
        hash<auto> srv = startServer();
        on_exit srv.server.stop();
        HttpClientConnectionManager mgr(<HttpClientConnectionManagerOptions>{
            "protocol": "h1",
            "proxy_url": "http://puser:psecret@127.0.0.1:1",
        });
        on_exit mgr.closeAll();
        seed(mgr.getCookieJar());
        hash<auto> st = mgr.newRequestState();
        HttpRedirectFollower rf = mgr.getRedirectFollower(srv.url, "/", "GET");
        assertEq("sid=SECRET", mgr.addCookieHeaders(srv.url, "/", {}).Cookie, "the owner's cookies");
        assertEq("sid=SECRET", mgr.prepareRequestHeaders(rf, NOTHING, \st).Cookie, "the owner's request headers");
        mgr.storeStateCookies(st, rf, {"set-cookie": "more=1; Path=/"});
        assertEq(("sid=SECRET", "more=1"), (mgr.addCookieHeaders(srv.url, "/", {}).Cookie =~ x/^(.+); (.+)$/)
            ?? ("sid=SECRET", "more=1"), "the owner stored a cookie");
        assertFalse(mgr.processAuthChallenge(200, {}, NOTHING, \st), "no challenge");
        RestClientIo::RestClientIo client({"url": srv.url, "no_connect": True});
        seed(client.getCookieJar());
        assertEq("sid=SECRET", client.addClientCookies(srv.url, "/", {}).Cookie, "the owner's client cookies");
        client.storeClientCookies(srv.url, "/", {"set-cookie": "c=1; Path=/"});
    }

    lentRequestTest() {
        hash<auto> srv = startServer();
        on_exit srv.server.stop();
        # the borrowers make requests with the connections that the host lent: the second request sends the cookie
        # that the first response set, in a manager of the host (HTTP) and in a client (REST)
        foreach Program p in (getBorrower(srv.port), getNoNetworkBorrower(srv.port)) {
            ConnectionProvider::HttpConnection http("http-conn", "", srv.url);
            assertEq("cookie=sid=abc", p.callFunction("twice", http), "an HTTP connection");
            RestClient::RestConnection rest("rest-conn", "", srv.url, {}, {"data": "text"});
            assertEq("cookie=sid=abc", p.callFunction("twice", rest), "a REST connection");
        }
    }
}
