#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - HTTP/2 client streaming requests over TLS and their flow control

/*  Http2SendDrainTimeout.qtest Copyright 2026 Qore Technologies, s.r.o.

    Permission is hereby granted, free of charge, to any person obtaining a
    copy of this software and associated documentation files (the "Software"),
    to deal in the Software without restriction, including without limitation
    the rights to use, copy, modify, merge, publish, distribute, sublicense,
    and/or sell copies of the Software, and to permit persons to whom the
    Software is furnished to do so, subject to the following conditions:

    The above copyright notice and this permission notice shall be included in
    all copies or substantial portions of the Software.

    THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
    IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
    FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
    AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
    LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
    FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
    DEALINGS IN THE SOFTWARE.

    The HTTP/2 client waited for a full stream send buffer to drain for the request timeout counted from the start of
    the wait, whatever the peer did meanwhile: a large request that a slow or loaded peer took made the wait exceed
    the timeout while the peer was taking the data, and failed (issue #6968; HTTP/2 had the same design).  The wait
    now ends after a period of the timeout in which the connection took no more of the stream's buffered data
    (Socket::getHttp2StreamTakenBytes()).  The server's handler never reads the request body, so that it grants no
    flow-control credit after the first window: the second large send waits for the request timeout (5 s) and
    raises.  A debug hook simulates a peer that takes a little of the data during the first period of the wait (by
    the reads of the count, with no clock involved): the send goes on into a second period and raises only after
    it, at least 1.5 times the timeout after it started; with a deadline counted from the start it raised at the end
    of the first period.
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Logger
%requires HttpServerUtil
%requires HttpServer
%requires HttpClientIo
%requires ../../TestCertificates.qm

%exec-class Http2SendDrainTimeoutTest

#! larger than the staged data's limit (1 MiB)
const Size = 3 * 1024 * 1024;

#! the size of the data that flows in the case that counts the bytes taken
const Small = 1000;

#! the request timeout of the case that simulates a peer taking the data, in milliseconds: the period of the wait
const PeriodMs = 3000;

#! a hang guard only, never a timing assertion
const HangGuard = 60s;

#! Answers a request once its body is complete (never, in this test)
class BodyHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, "ok");
    }
}

class Http2SendDrainTimeoutTest inherits QUnit::Test {
    constructor() : QUnit::Test("Http2SendDrainTimeout", "1.0") {
        addTestCase("HTTP/2: a send that waits for a full send buffer is bounded by the request timeout",
            \testDrainTimeout());
        addTestCase("HTTP/2: a send that waits for a full send buffer that the peer is draining is not cut off by "
            "the request timeout", \testDrainProgress());
        addTestCase("HTTP/2: the byte count taken from a stream", \testTakenBytes());
        set_return_value(main());
    }

    #! The server, the connection manager and the streaming request of a test case
    private hash<auto> startRequest(timeout request_timeout) {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("the library is not built with debugging");
        }
        HttpServer server(<HttpServerOptionInfo>{"logger": new Logger("test", LoggerLevel::getLevelInfo())});
        server.setDefaultHandler("body", new BodyHandler());
        int port = server.addListener(<HttpListenerOptionInfo>{
            "node": "127.0.0.1",
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
            "http_version": "2.0",
        }).port;
        server.waitForAsyncIo();

        HttpClientConnectionManager mgr(<HttpClientConnectionManagerOptions>{
            "protocol": "h2",
            "accept_all_certs": True,
            # the send waits for the stream's send buffer at most the request timeout, which also bounds the TLS
            # handshake: long enough for a loaded host
            "request_timeout": request_timeout,
            "connect_timeout": HangGuard,
        });
        HttpClientStreamHandle stream = mgr.acquireStream(sprintf("https://127.0.0.1:%d/", port));
        stream.startStreaming("POST", "/", {"Content-Type": "application/octet-stream"}, True);
        assertEq("h2", stream.getConnection().getProtocol(), "the request uses HTTP/2");
        return {"server": server, "mgr": mgr, "stream": stream};
    }

    #! Ends the request, the connection manager and the server of a test case
    private endRequest(hash<auto> ctx) {
        try {
            ctx.stream.cancel();
        } catch () {
        }
        delete ctx.mgr;
        ctx.server.stop();
    }

    testDrainTimeout() {
        hash<auto> ctx = startRequest(5s);
        on_exit endRequest(ctx);
        HttpClientStreamHandle stream = ctx.stream;
        # the stream's buffered data is held back from the transport, as when the server grants no credit
        call_function("dbg_http2_hold_stream_data", stream.getStreamId());
        on_exit call_function("dbg_http2_release_stream_data");
        # the first chunk is staged; the second one finds the staged data over its limit
        stream.sendData(binary(strmul("a", Size)));
        assertThrows("HTTP2-FLOW-CONTROL", "did not drain within 5000 ms", \stream.sendData(),
            binary(strmul("b", Size)));
    }

    testTakenBytes() {
        # no HTTP/2 session
        Socket plain();
        assertThrows("HTTP2-ERROR", "no HTTP/2 session", \plain.getHttp2StreamTakenBytes(), 1);
        assertThrows("HTTP2-ERROR", "invalid stream_id", \plain.getHttp2StreamTakenBytes(), -1);

        hash<auto> ctx = startRequest(5s);
        on_exit endRequest(ctx);
        HttpClientStreamHandle stream = ctx.stream;
        Socket sock = cast<Http2ClientConnection>(stream.getConnection()).getSocket();
        int sid = stream.getStreamId();
        assertEq(-1, sock.getHttp2StreamTakenBytes(sid + 4000), "a stream that does not exist");
        # data that flows is counted: the wait ends when it was written to the connection
        stream.sendData(binary(strmul("a", Small)));
        assertEq(0, sock.waitForHttp2StreamFlushed(sid, HangGuard), "the data was written");
        int taken = sock.getHttp2StreamTakenBytes(sid);
        assertEq(Small, taken, "all the data was taken");
        # data held back is not taken, and the count never decreases
        call_function("dbg_http2_hold_stream_data", sid);
        on_exit call_function("dbg_http2_release_stream_data");
        stream.sendData(binary(strmul("b", Size)));
        assertEq(taken, sock.getHttp2StreamTakenBytes(sid), "nothing is taken while the data is held");
    }

    testDrainProgress() {
        hash<auto> ctx = startRequest(PeriodMs);
        on_exit endRequest(ctx);
        HttpClientStreamHandle stream = ctx.stream;
        call_function("dbg_http2_hold_stream_data", stream.getStreamId());
        on_exit call_function("dbg_http2_release_stream_data");
        on_exit call_function("dbg_http2_simulate_stream_progress", stream.getStreamId(), 0);
        stream.sendData(binary(strmul("a", Size)));
        # the peer acknowledges data in the first period of the wait (the read at its start and the read at its end),
        # and nothing in the second
        call_function("dbg_http2_simulate_stream_progress", stream.getStreamId(), 2);
        int start = clock_get_monotonic_us();
        assertThrows("HTTP2-FLOW-CONTROL", "peer granted no credit", \stream.sendData(),
            binary(strmul("b", Size)));
        # the wait went on after the first period: a total deadline raised at its end (the lower bound is the
        # assertion; a loaded host only takes longer)
        int elapsed_ms = (clock_get_monotonic_us() - start) / 1000;
        assertTrue(elapsed_ms >= PeriodMs * 3 / 2, sprintf("the send was not cut off at the end of the first period "
            "(raised after %d ms)", elapsed_ms));
    }
}
