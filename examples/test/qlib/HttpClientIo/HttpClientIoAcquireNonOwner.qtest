#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - pooled HTTP/1.1 and HTTP/2 client connections over TCP and TLS, closed and leased by other code
# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires HttpClientIo
%requires RestClientIo
%requires HttpServer
%requires HttpServerUtil

%exec-class HttpClientIoAcquireNonOwnerTest

#! A sandboxed borrower of a connection manager that other code shares gets no pooled connection from
#! acquireConnectionAsync() (qore#7813)
/** @ref HttpClientIo::HttpClientConnectionManager::acquireConnectionAsync() gives the caller the pooled connection that
    it found, to track it for failure detection.  The pool lends that connection to the host's requests, so the
    connection of a borrower that does not own the manager must not be given to it: closing it or leasing it would end
    the host's request in flight, which qore#7570 stops for the other entry points.  The borrower's own requests
    (\c requestAsync(), which the module makes with the connection internally) and the code that owns the manager
    work as before.  The host's request is held by the server while the borrower acts, so the test fails without any
    timing: the host's request must complete with its response, on the connection that it reused.
*/

#! a hang guard only, never a timing assertion
const HangGuard = 20s;

