#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - pooled HTTP/1.1 and HTTP/2 client connections over TCP and TLS, closed and leased by other code
# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires HttpClientIo
%requires RestClientIo
%requires JsonRpcClientIo
%requires HttpServer
%requires HttpServerUtil

%exec-class HttpClientIoManagerStateNonOwnerTest

#! A sandboxed borrower of a connection manager that other code shares cannot change the state of its connections
#! (qore#7828)
/** The manager's methods that close all of its connections, remove idle ones, migrate them, tear down a race of
    another caller's, or give out its I/O controller are refused for code that a sandbox restricts and that does not own
    the manager (PERMISSION-DENIED), as the methods that lease, pin or acquire a connection are (qore#7570, qore#7813):
    the host's requests, and every other caller's, use the manager.  The borrower's own requests (a REST client over
    the lent manager, which submits its operations to the I/O controller through the manager) work as before, and the
    code that owns the manager calls them all.  The host's request is held by the server while the borrower acts, so the
    test fails without any timing: the host's request must complete with its response, and the manager must still
    serve requests afterwards.
*/

#! a hang guard only, never a timing assertion
const HangGuard = 20s;

