#! the code of the borrower
const BorrowerCode = "%modern
%requires HttpClientIo
%requires RestClientIo
#! makes an async REST request with a client that shares the lent manager; returns the status code or the error
string sub restRequest(HttpClientConnectionManager mgr, string url, string path) {
    try {
        RestClientIo rc({\"url\": url, \"data\": \"text\"}, mgr);
        return \"\" + rc.restGetAsync(path).get(20s).status_code;
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
}
#! makes a request with the lent manager; returns the status code or the error
string sub request(HttpClientConnectionManager mgr, string url, string path) {
    try {
        return \"\" + mgr.requestAsync(url, \"GET\", path).get(20s).status_code;
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
}
#! a restricted borrower that owns its manager and its REST client uses all of the methods; returns what happened
string sub own(string url) {
    try {
        HttpClientConnectionManager m(<HttpClientConnectionManagerOptions>{\"protocol\": \"auto\", \"accept_all_certs\": True});
        m.requestAsync(url, \"GET\", \"/ok\").get(20s);
        m.cleanupIdleConnections();
        m.abandonAsyncHEForUrl(url);
        m.abandonAsyncHEByKey(HttpClientConnectionManager::getPoolKey(parse_url(url)));
        m.getController();
        m.closeAll();
        RestClientIo rc({\"url\": url, \"data\": \"text\"});
        rc.restGetAsync(\"/ok\").get(20s);
        # the client closes its own manager when it is deleted
        delete rc;
        return \"done\";
    } catch (hash<ExceptionInfo> ex) {
        return ex.err + \": \" + ex.desc;
    }
}
#! takes the only reference of a client that the host created (it owns the client's manager) and deletes it; returns
#! what happened
string sub consume(code get) {
    try {
        *object c = get();
        # the destructor of the client closes the manager's connections, which restricted code that does not own the
        # manager may not do
        c = NOTHING;
        return \"done\";
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
}
#! submits an operation with the owner and the key of a connection manager; returns what happened
string sub submitReserved(HttpClientConnectionManager mgr, string owner, *string key) {
    try {
        hash<auto> h = {\"owner\": owner};
        if (key) {
            h.key = key;
        }
        mgr.submitPollOperation(cast<hash<SocketPollOperationInfo>>(h));
        return \"done\";
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
}
#! calls a state-changing method of the lent manager; returns what happened
string sub change(HttpClientConnectionManager mgr, string url, string what) {
    try {
        switch (what) {
            case \"closeAll\": mgr.closeAll(); break;
            case \"cleanupIdleConnections\": mgr.cleanupIdleConnections(); break;
            case \"migrateAll\": mgr.migrateAll(); break;
            case \"abandonAsyncHEForUrl\": mgr.abandonAsyncHEForUrl(url); break;
            case \"abandonAsyncHEByKey\": mgr.abandonAsyncHEByKey(HttpClientConnectionManager::getPoolKey(parse_url(url))); break;
            case \"getController\": mgr.getController(); break;
            default: throw \"UNKNOWN\", what;
        }
        return \"done\";
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
}
";

#! answers each request with 200; a request for /hold waits until the test releases it
class HoldHandler inherits AbstractHttpRequestHandler {
    public {
        Queue held();
        Queue release();
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        if (cx.url.path == "hold") {
            held.push(True);
            release.get(HangGuard);
        }
        return <HttpResponseInfo>{"code": 200, "hdr": {"Content-Type": "text/plain"}, "body": "ok " + cx.url.path};
    }
}
class HttpClientIoManagerStateNonOwnerTest inherits QUnit::Test {
    constructor() : QUnit::Test("lent manager: the borrower cannot change the state of its connections", "1.0", \ARGV) {
        addTestCase("HTTP/1.1: the state-changing methods are refused", \h1Test());
        addTestCase("HTTP/2: the state-changing methods are refused", \h2Test());
        addTestCase("a client that the borrower deletes does not throw from its destructor", \destructorTest());
        addTestCase("an operation submitted with the owner of a manager is refused", \reservedOwnerTest());
        addTestCase("a restricted borrower that owns its manager calls them", \borrowerOwnerTest());
        addTestCase("the code that owns the manager calls them", \ownerTest());
        set_return_value(main());
    }

    #! returns a server, its handler and its URL
    private hash<auto> startServer(bool tls) {
        HoldHandler handler();
        HttpServer server(<HttpServerOptionInfo>{});
        server.setDefaultHandler("hold", handler);
        int port = tls
            ? server.addListener(<HttpListenerOptionInfo>{
                "node": "127.0.0.1",
                "service": 0,
                "cert": new SSLCertificate(CertPem),
                "key": new SSLPrivateKey(KeyPem),
                "http_version": "2.0",
            }).port
            : server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        server.waitForAsyncIo();
        return {
            "server": server,
            "handler": handler,
            "port": port,
            "url": sprintf("%s://127.0.0.1:%d", tls ? "https" : "http", port),
        };
    }

    #! a manager that the host creates and lends
    private HttpClientConnectionManager getManager(string protocol) {
        return new HttpClientConnectionManager(<HttpClientConnectionManagerOptions>{
            "protocol": protocol,
            "accept_all_certs": True,
            "max_request_retries": 0,
            "request_timeout": HangGuard,
        });
    }

    #! a sandboxed borrower that may reach the server
    private Program getBorrower(int port) {
        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        SandboxManager sm();
        sm.setNetworkDefaultPolicy(False);
        sm.addNetworkAllowedIPRange("127.0.0.1/32");
        sm.addNetworkAllowedPort(port);
        p.setSandboxManager(sm);
        p.parse(BorrowerCode, "borrower");
        return p;
    }

    #! a request of the host; returns the status code, the ID of its connection and the body
    private list<auto> hostRequest(HttpClientConnectionManager mgr, string url, string path) {
        HttpClientStreamHandle sh = mgr.acquireStream(url);
        hash<auto> r = sh.submitAsync("GET", path);
        hash<auto> resp = r.future.get(HangGuard);
        return (resp.status_code, sh.getConnection().getConnectionId(), resp.body);
    }

    #! the host's request /hold is held by the server while the borrower calls the method
    private auto changeWhileHostRequestHeld(hash<auto> srv, HttpClientConnectionManager mgr, Program p, string what,
            reference<string> result) {
        Queue done();
        background sub () {
            try {
                done.push(hostRequest(mgr, srv.url, "/hold"));
            } catch (hash<ExceptionInfo> ex) {
                done.push(ex.err);
            }
        }();
        # the server has the host's request, or the request ended without reaching it
        if (!srv.handler.held.get(HangGuard)) {
            fail(sprintf("the host's request did not reach the server: %y", done.get(0)));
        }
        on_exit srv.handler.release.push(True);
        result = p.callFunction("change", mgr, srv.url, what);
        srv.handler.release.push(True);
        return done.get(HangGuard);
    }

    private changeTest(bool tls, string protocol) {
        foreach string what in ("closeAll", "cleanupIdleConnections", "migrateAll", "abandonAsyncHEForUrl",
                "abandonAsyncHEByKey", "getController") {
            hash<auto> srv = startServer(tls);
            on_exit srv.server.stop();
            HttpClientConnectionManager mgr = getManager(protocol);
            on_exit mgr.closeAll();
            Program p = getBorrower(srv.port);

            # the borrower's own requests work, also with a REST client that submits to the manager's controller
            assertEq("200", p.callFunction("request", mgr, srv.url, "/ok"), protocol + ": the borrower's request");
            assertEq("200", p.callFunction("restRequest", mgr, srv.url, "/ok"),
                protocol + ": the borrower's async REST request");
            string result;
            auto r = changeWhileHostRequestHeld(srv, mgr, p, what, \result);
            assertTrue(r.typeCode() == NT_LIST, sprintf("%s %s: the host's request completes (%y)", protocol, what, r));
            if (r.typeCode() == NT_LIST) {
                assertEq(200, r[0], sprintf("%s %s: the host's request", protocol, what));
                assertEq("ok hold", r[2], sprintf("%s %s: the host's response", protocol, what));
            }
            assertEq("PERMISSION-DENIED", result, sprintf("%s %s: the borrower's call is refused", protocol, what));
            # the manager still serves the host and the borrower
            assertEq(200, hostRequest(mgr, srv.url, "/after")[0],
                sprintf("%s %s: the host's request after the borrower's call", protocol, what));
            assertEq("200", p.callFunction("request", mgr, srv.url, "/again"),
                sprintf("%s %s: the borrower's request after its call", protocol, what));
        }
    }

    h1Test() {
        changeTest(False, "h1");
    }

    h2Test() {
        changeTest(True, "h2");
    }

    destructorTest() {
        hash<auto> srv = startServer(False);
        on_exit srv.server.stop();
        Program p = getBorrower(srv.port);
        # the client is the host's (it owns its manager); the borrower takes its only reference and deletes it
        *object client = new JsonRpcClientIo(srv.url);
        code get = object sub () { return remove client; };
        assertEq("done", p.callFunction("consume", get), "the destructor of the client does not throw");
    }

    reservedOwnerTest() {
        hash<auto> srv = startServer(False);
        on_exit srv.server.stop();
        HttpClientConnectionManager mgr = getManager("h1");
        on_exit mgr.closeAll();
        Program p = getBorrower(srv.port);
        # the owner of the manager that the borrower can derive, and a key of one of its connections
        string owner = sprintf("HttpClientConnectionManager:1:%s", mgr.uniqueHash());
        assertEq("PERMISSION-DENIED", p.callFunction("submitReserved", mgr, owner), "the owner of a manager");
        assertEq("PERMISSION-DENIED", p.callFunction("submitReserved", mgr, "mine", owner + ":conn:1"),
            "the key of a connection of a manager");
        # an owner of the borrower's own is not refused by this check (the operation is incomplete: another error)
        assertNeq("PERMISSION-DENIED", p.callFunction("submitReserved", mgr, "borrower:1"), "an owner of its own");
    }

    borrowerOwnerTest() {
        foreach hash<auto> c in ({"tls": False, "protocol": "h1"}, {"tls": True, "protocol": "h2"}) {
            hash<auto> srv = startServer(c.tls);
            on_exit srv.server.stop();
            Program p = getBorrower(srv.port);
            # the manager is the borrower's own, so the checks that protect the manager of another do not apply
            assertEq("done", p.callFunction("own", srv.url), c.protocol + ": the borrower's own manager and client");
        }
    }

    ownerTest() {
        foreach hash<auto> c in ({"tls": False, "protocol": "h1"}, {"tls": True, "protocol": "h2"}) {
            hash<auto> srv = startServer(c.tls);
            on_exit srv.server.stop();
            # the code that owns the manager is not restricted
            HttpClientConnectionManager mgr = getManager(c.protocol);
            assertEq(200, hostRequest(mgr, srv.url, "/ok")[0], c.protocol + ": the owner's request");
            mgr.cleanupIdleConnections();
            mgr.abandonAsyncHEForUrl(srv.url);
            mgr.abandonAsyncHEByKey(HttpClientConnectionManager::getPoolKey(parse_url(srv.url)));
            assertTrue(exists mgr.getController(), c.protocol + ": the owner gets the controller");
            assertEq(200, hostRequest(mgr, srv.url, "/again")[0], c.protocol + ": the owner's request after them");
            mgr.closeAll();
            assertThrows("HTTPCLIENT-SHUTDOWN", \hostRequest(), (mgr, srv.url, "/after-close"));
        }
    }
}
