#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - pooled HTTP/1.1 and HTTP/2 client connections over TCP and TLS, and the sockets taken over
# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires HttpClientIo
%requires HttpServer
%requires HttpServerUtil

%exec-class HttpClientIoLentPooledSocketTest

#! A sandboxed borrower of a connection manager that other code shares cannot take over a pooled connection that the
#! other code reuses (qore#7544)
/** Sandboxed code that does not own the manager gets the socket of an HTTP/1.1 connection only for its own switched
    stream (qore#7500), or for an idle connection, which is then out of the pool for good: the other code's later
    requests use other connections.  It is refused the socket of a connection that another request is using, the
    socket of an HTTP/2 connection, whose streams are other code's too, and the socket of a connection's poll
    operation.  Code that owns the manager is not restricted.
*/

#! a hang guard only, never a timing assertion
const HangGuard = 20s;

