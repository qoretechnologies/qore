#! the code of the borrower
const BorrowerCode = "%modern
%requires HttpClientIo
%requires reflection
our HttpClientConnection conn;
our *Socket sock;
our *HttpClientStreamHandle upgrade_sh;
our *hash<auto> upgrade_req;
#! makes a request with the manager and keeps its connection; returns the status code
int sub request(HttpClientConnectionManager mgr, string url, string path) {
    HttpClientStreamHandle sh = mgr.acquireStream(url);
    hash<auto> r = sh.submitAsync(\"GET\", path);
    int status = r.future.get(20s).status_code;
    conn = sh.getConnection();
    return status;
}
#! takes the socket of the kept connection, directly or from its poll operation; returns \"taken\" or the error
string sub take(string how) {
    try {
        sock = how == \"poll\" ? conn.getPollOperation().getSocket() : conn.getSocket();
        return \"taken\";
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
}
#! writes to the taken socket, which corrupts the next exchange of a request on its connection
string sub write() {
    sock.send(\"GET /junk HTTP/1.1\\r\\nHost: x\\r\\n\\r\\n\");
    return \"written\";
}
#! puts the taken connection back into the pool with the connection's public methods
string sub repool() {
    try {
        conn.releaseStreamReservation();
        conn.setLeased(False);
        return \"done\";
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
}
#! calls the builtin getSocket() of the poll operation's class through reflection
string sub reflect(string cls) {
    try {
        sock = Class::forName(cls).getMethod(\"getSocket\").call(conn.getPollOperation());
        return \"taken\";
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
}
#! cuts the connection off from its poll operation, or sets another one
string sub cut(string how) {
    try {
        HttpClientPollOperation op = conn.getPollOperation();
        if (how == \"clear\") {
            call_object_method(op, \"clearConnection\");
        } else {
            call_object_method(op, \"setConnection\", conn);
        }
        return \"done\";
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
}
#! submits a request that asks for a protocol upgrade, which the server holds
nothing sub upgrade(HttpClientConnectionManager mgr, string url) {
    upgrade_sh = mgr.acquireStream(url);
    upgrade_req = upgrade_sh.submitAsync(\"GET\", \"/hold\", {\"Upgrade\": \"websocket\", \"Connection\": \"Upgrade\"});
    conn = upgrade_sh.getConnection();
}
#! returns the status code of the response of the upgrade request
int sub upgradeStatus() {
    int rv = upgrade_req.future.get(20s).status_code;
    remove upgrade_req;
    remove upgrade_sh;
    return rv;
}
our *object stolen;
#! a poll operation of the borrower's own class: keeps a token that it is given
class KeepingOp inherits HttpClientPollOperation {
    Socket getSocket() { return new Socket(); }
    Socket getSocketFor(object a) { stolen = a; return new Socket(); }
    cancelRequest(int sid) {}
    string getGoal() { return \"x\"; }
    string getState() { return \"x\"; }
    bool goalReached() { return True; }
    *hash<SocketPollInfo> continuePoll() { return NOTHING; }
}
#! a connection of the borrower's own class with that poll operation
class KeepingConn inherits HttpClientConnection {
    public { KeepingOp op = new KeepingOp(); }
    constructor() : HttpClientConnection({\"host\": \"x\", \"port\": 1}, 1s, NOTHING, 1, NOTHING) {}
    string getProtocol() { return \"h1\"; }
    HttpClientPollOperation getPollOperation() { return op; }
    Socket getSocket() { return new Socket(); }
    int submitRequestImpl(string m, string p, *hash<auto> h, *data b, Promise pr) { return 0; }
    int submitRequestWithNotifierImpl(string m, string p, *hash<auto> h, *data b, Promise pr, EventNotifier n) { return 0; }
    cancelRequestImpl(int sid) {}
    closeImpl(*timeout t) {}
}
#! tries to get the module's token through a connection of its own class, and the kept connection's socket with it
string sub steal() {
    try {
        KeepingConn kc();
        kc.close();
        kc.notifyPendingData();
        if (!stolen) {
            return \"no token\";
        }
        sock = conn.getPollOperation().getSocketFor(stolen);
        return \"taken\";
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
}
#! a connection of the borrower's own class that returns the poll operation of the kept connection as its own
class CuttingConn inherits HttpClientConnection {
    public { HttpClientPollOperation op; }
    constructor(HttpClientPollOperation op) : HttpClientConnection({\"host\": \"x\", \"port\": 1}, 1s, NOTHING, 1,
            NOTHING) {
        self.op = op;
    }
    string getProtocol() { return \"h1\"; }
    HttpClientPollOperation getPollOperation() { return op; }
    Socket getSocket() { return new Socket(); }
    int submitRequestImpl(string m, string p, *hash<auto> h, *data b, Promise pr) { return 0; }
    int submitRequestWithNotifierImpl(string m, string p, *hash<auto> h, *data b, Promise pr, EventNotifier n) { return 0; }
    cancelRequestImpl(int sid) {}
    closeImpl(*timeout t) {}
}
#! closes a connection of its own class that returns the kept connection's poll operation; returns what the poll
#! operation's accessor then says
string sub cutThrough() {
    CuttingConn cc(conn.getPollOperation());
    cc.close();
    try {
        conn.getPollOperation().getSocket();
        return \"taken\";
    } catch (hash<ExceptionInfo> ex) {
        return ex.desc;
    }
}
our *HttpClientConnectionManager own_mgr;
#! pins a connection of a manager of its own in the lent manager
string sub pin(HttpClientConnectionManager lent, string url) {
    own_mgr = new HttpClientConnectionManager(<HttpClientConnectionManagerOptions>{
        \"protocol\": \"h1\", \"accept_all_certs\": True, \"request_timeout\": 20s,
    });
    on_exit own_mgr.closeAll();
    try {
        request(own_mgr, url, \"/ok\");
        lent.pinConnection(conn);
        return \"pinned\";
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
}
#! returns the kept connection
HttpClientConnection sub getConn() {
    return conn;
}
#! returns the ID of the kept connection
int sub connId() {
    return conn.getConnectionId();
}
#! makes a manager of its own, a request with it, and takes the socket of its connection
string sub own(string url, string protocol) {
    HttpClientConnectionManager m(<HttpClientConnectionManagerOptions>{
        \"protocol\": protocol,
        \"accept_all_certs\": True,
        \"request_timeout\": 20s,
    });
    on_exit m.closeAll();
    request(m, url, \"/ok\");
    string rv = take(\"conn\");
    remove sock;
    remove conn;
    return rv;
}
";

#! answers each request with 200; a request for /hold waits until the test releases it
class HoldHandler inherits AbstractHttpRequestHandler {
    public {
        Queue held();
        Queue release();
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        if (cx.url.path == "hold") {
            held.push(True);
            release.get(HangGuard);
        }
        return <HttpResponseInfo>{"code": 200, "body": "ok " + cx.url.path};
    }
}

class HttpClientIoLentPooledSocketTest inherits QUnit::Test {
    constructor() : QUnit::Test("lent manager: pooled connection sockets", "1.0", \ARGV) {
        addTestCase("HTTP/1.1: an idle connection is taken out of the pool", \idleTest());
        addTestCase("HTTP/1.1: the socket of a connection in use is refused", \inUseTest());
        addTestCase("HTTP/2: the socket of a connection is refused", \http2Test());
        addTestCase("the code that owns the manager takes its sockets", \ownerTest());
        addTestCase("HTTP/1.1: a taken connection cannot be put back into the pool", \repoolTest());
        addTestCase("HTTP/1.1: an upgrade request answered without a switch leaves its taken connection out of the pool",
            \upgradeNoSwitchTest());
        addTestCase("the builtin socket accessor of a poll operation is refused through reflection", \reflectionTest());
        addTestCase("the connection of a poll operation is not cut off or replaced by other code", \cutTest());
        addTestCase("the module's token is not given to a poll operation of a borrower's class", \tokenTest());
        addTestCase("a borrower cannot pin a connection in a lent manager", \pinTest());
        addTestCase("HTTP/1.1: a leased connection is not taken", \leasedTest());
        addTestCase("another connection does not cut a poll operation off from its connection", \cutThroughTest());
        set_return_value(main());
    }

    #! returns a server, its handler and its URL
    private hash<auto> startServer(bool tls) {
        HoldHandler handler();
        HttpServer server(<HttpServerOptionInfo>{});
        server.setDefaultHandler("hold", handler);
        hash<auto> lopts = {"node": "127.0.0.1", "service": 0};
        if (tls) {
            lopts += {
                "cert": new SSLCertificate(CertPem),
                "key": new SSLPrivateKey(KeyPem),
                "http_version": "2.0",
            };
        }
        int port = server.addListener(cast<hash<HttpListenerOptionInfo>>(lopts)).port;
        server.waitForAsyncIo();
        return {
            "server": server,
            "handler": handler,
            "port": port,
            "url": sprintf("%s://127.0.0.1:%d", tls ? "https" : "http", port),
        };
    }

    #! a manager that the host creates and lends
    private HttpClientConnectionManager getManager(string protocol) {
        return new HttpClientConnectionManager(<HttpClientConnectionManagerOptions>{
            "protocol": protocol,
            "accept_all_certs": True,
            "max_request_retries": 0,
            "request_timeout": HangGuard,
        });
    }

    #! a sandboxed borrower that may reach the server
    private Program getBorrower(int port) {
        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        SandboxManager sm();
        sm.setNetworkDefaultPolicy(False);
        sm.addNetworkAllowedIPRange("127.0.0.1/32");
        sm.addNetworkAllowedPort(port);
        p.setSandboxManager(sm);
        p.parse(BorrowerCode, "borrower");
        return p;
    }

    #! a request of the host; returns the status code and the ID of its connection
    private list<auto> hostRequest(HttpClientConnectionManager mgr, string url, string path) {
        HttpClientStreamHandle sh = mgr.acquireStream(url);
        hash<auto> r = sh.submitAsync("GET", path);
        hash<auto> resp = r.future.get(HangGuard);
        return (resp.status_code, sh.getConnection().getConnectionId(), resp.body);
    }

    idleTest() {
        hash<auto> srv = startServer(False);
        on_exit srv.server.stop();
        HttpClientConnectionManager mgr = getManager("h1");
        on_exit mgr.closeAll();
        Program p = getBorrower(srv.port);

        assertEq(200, p.callFunction("request", mgr, srv.url, "/ok"), "the borrower's request");
        int borrowed = p.callFunction("connId");
        # the connection is idle in the pool: the borrower takes it over, and it is no longer the pool's
        assertEq("taken", p.callFunction("take", "conn"), "the socket of an idle connection");
        assertEq("written", p.callFunction("write"), "the borrower uses the socket");
        list<auto> r = hostRequest(mgr, srv.url, "/after");
        assertEq(200, r[0], "the host's request after the take-over");
        assertEq("ok after", r[2], "the host's response");
        assertNeq(borrowed, r[1], "the host's request uses another connection");
        p.callFunction("take", "conn");
        assertEq("taken", p.callFunction("take", "conn"), "the taker gets the socket again");
    }

    inUseTest() {
        hash<auto> srv = startServer(False);
        on_exit srv.server.stop();
        HttpClientConnectionManager mgr = getManager("h1");
        on_exit mgr.closeAll();
        Program p = getBorrower(srv.port);

        assertEq(200, p.callFunction("request", mgr, srv.url, "/ok"), "the borrower's request");
        int borrowed = p.callFunction("connId");
        # the host's request reuses the connection, and is held by the server
        Queue done();
        background sub () {
            try {
                done.push(hostRequest(mgr, srv.url, "/hold"));
            } catch (hash<ExceptionInfo> ex) {
                done.push(ex.err);
            }
        }();
        # the server has the host's request, or the request ended without reaching it
        if (!srv.handler.held.get(HangGuard)) {
            fail(sprintf("the host's request did not reach the server: %y", done.get(0)));
        }
        on_exit srv.handler.release.push(True);
        assertEq("PERMISSION-DENIED", p.callFunction("take", "conn"), "the socket of a connection in use");
        assertEq("PERMISSION-DENIED", p.callFunction("take", "poll"), "the socket of its poll operation");
        srv.handler.release.push(True);
        list<auto> r = done.get(HangGuard);
        assertEq(200, r[0], "the host's request");
        assertEq("ok hold", r[2], "the host's response");
        assertEq(borrowed, r[1], "the host's request reused the connection");
    }

    http2Test() {
        hash<auto> srv = startServer(True);
        on_exit srv.server.stop();
        HttpClientConnectionManager mgr = getManager("h2");
        on_exit mgr.closeAll();
        Program p = getBorrower(srv.port);

        assertEq(200, p.callFunction("request", mgr, srv.url, "/ok"), "the borrower's request");
        assertEq("PERMISSION-DENIED", p.callFunction("take", "conn"), "the socket of an HTTP/2 connection");
        assertEq("PERMISSION-DENIED", p.callFunction("take", "poll"), "the socket of its poll operation");
        list<auto> r = hostRequest(mgr, srv.url, "/after");
        assertEq(200, r[0], "the host's request");
    }

    ownerTest() {
        foreach hash<auto> c in ({"tls": False, "protocol": "h1"}, {"tls": True, "protocol": "h2"}) {
            hash<auto> srv = startServer(c.tls);
            on_exit srv.server.stop();
            Program p = getBorrower(srv.port);
            assertEq("taken", p.callFunction("own", srv.url, c.protocol), c.protocol + ": a manager of its own");
            # the host owns the manager that it creates
            HttpClientConnectionManager mgr = getManager(c.protocol);
            on_exit mgr.closeAll();
            HttpClientStreamHandle sh = mgr.acquireStream(srv.url);
            sh.submitAsync("GET", "/ok").future.get(HangGuard);
            assertEq("Socket", sh.getConnection().getSocket().className(), c.protocol + ": the host's socket");
        }
    }

    repoolTest() {
        hash<auto> srv = startServer(False);
        on_exit srv.server.stop();
        HttpClientConnectionManager mgr = getManager("h1");
        on_exit mgr.closeAll();
        Program p = getBorrower(srv.port);
        assertEq(200, p.callFunction("request", mgr, srv.url, "/ok"), "the borrower's request");
        int borrowed = p.callFunction("connId");
        assertEq("taken", p.callFunction("take", "conn"), "the socket of an idle connection");
        assertEq("done", p.callFunction("repool"), "the public methods of the connection can be called");
        list<auto> r = hostRequest(mgr, srv.url, "/after");
        assertEq(200, r[0], "the host's request");
        assertNeq(borrowed, r[1], "the taken connection is not given to the host's request");
    }

    upgradeNoSwitchTest() {
        hash<auto> srv = startServer(False);
        on_exit srv.server.stop();
        HttpClientConnectionManager mgr = getManager("h1");
        on_exit mgr.closeAll();
        Program p = getBorrower(srv.port);
        p.callFunction("upgrade", mgr, srv.url);
        srv.handler.held.get(HangGuard);
        int borrowed = p.callFunction("connId");
        # the socket of its own upgrade request, while the request is active
        assertEq("taken", p.callFunction("take", "conn"), "the socket of the borrower's own upgrade request");
        srv.handler.release.push(True);
        assertEq(200, p.callFunction("upgradeStatus"), "the server does not switch the protocol");
        list<auto> r = hostRequest(mgr, srv.url, "/after");
        assertEq(200, r[0], "the host's request");
        assertNeq(borrowed, r[1], "the connection whose socket was taken is not given to the host's request");
    }

    reflectionTest() {
        hash<auto> srv = startServer(False);
        on_exit srv.server.stop();
        HttpClientConnectionManager mgr = getManager("h1");
        on_exit mgr.closeAll();
        Program p = getBorrower(srv.port);
        assertEq(200, p.callFunction("request", mgr, srv.url, "/ok"), "the borrower's request");
        assertEq("REFLECTION-ACCESS-ERROR", p.callFunction("reflect", "Http1ClientPollOperationBase"),
            "the builtin accessor of the poll operation's base class");
    }

    cutTest() {
        hash<auto> srv = startServer(False);
        on_exit srv.server.stop();
        HttpClientConnectionManager mgr = getManager("h1");
        on_exit mgr.closeAll();
        Program p = getBorrower(srv.port);
        assertEq(200, p.callFunction("request", mgr, srv.url, "/ok"), "the borrower's request");
        assertNeq("done", p.callFunction("cut", "clear"), "clearConnection() needs the module's token");
        assertNeq("done", p.callFunction("cut", "set"), "setConnection() is private");
        list<auto> r = hostRequest(mgr, srv.url, "/after");
        assertEq(200, r[0], "the connection still serves requests");
    }

    tokenTest() {
        hash<auto> srv = startServer(False);
        on_exit srv.server.stop();
        HttpClientConnectionManager mgr = getManager("h1");
        on_exit mgr.closeAll();
        Program p = getBorrower(srv.port);
        assertEq(200, p.callFunction("request", mgr, srv.url, "/ok"), "the borrower's request");
        assertEq("no token", p.callFunction("steal"), "a poll operation of the borrower's class gets no token");
    }

    pinTest() {
        hash<auto> srv = startServer(False);
        on_exit srv.server.stop();
        HttpClientConnectionManager mgr = getManager("h1");
        on_exit mgr.closeAll();
        Program p = getBorrower(srv.port);
        assertEq("PERMISSION-DENIED", p.callFunction("pin", mgr, srv.url), "the borrower cannot pin a connection");
        list<auto> r = hostRequest(mgr, srv.url, "/after");
        assertEq(200, r[0], "the host's request uses the manager's own connection");
    }

    leasedTest() {
        hash<auto> srv = startServer(False);
        on_exit srv.server.stop();
        HttpClientConnectionManager mgr = getManager("h1");
        on_exit mgr.closeAll();
        Program p = getBorrower(srv.port);
        assertEq(200, p.callFunction("request", mgr, srv.url, "/ok"), "the borrower's request");
        # the host leases the idle connection for a session of its own
        HttpClientConnection c = p.callFunction("getConn");
        c.setLeased(True);
        on_exit c.setLeased(False);
        assertEq("PERMISSION-DENIED", p.callFunction("take", "conn"), "a leased connection is not taken");
    }

    cutThroughTest() {
        hash<auto> srv = startServer(False);
        on_exit srv.server.stop();
        HttpClientConnectionManager mgr = getManager("h1");
        on_exit mgr.closeAll();
        Program p = getBorrower(srv.port);
        assertEq(200, p.callFunction("request", mgr, srv.url, "/ok"), "the borrower's request");
        # the host's request uses the connection while the borrower tries to cut it off from its poll operation
        Queue done();
        background sub () {
            try {
                done.push(hostRequest(mgr, srv.url, "/hold")[0]);
            } catch (hash<ExceptionInfo> ex) {
                done.push(ex.err);
            }
        }();
        srv.handler.held.get(HangGuard);
        string desc = p.callFunction("cutThrough");
        srv.handler.release.push(True);
        assertEq(200, done.get(HangGuard), "the host's request");
        assertRegex("while another request uses it", desc, "the poll operation still has its connection");
    }
}
