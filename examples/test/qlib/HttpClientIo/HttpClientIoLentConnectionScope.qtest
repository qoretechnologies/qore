#! the code of the borrower
const BorrowerCode = "%modern
%requires HttpClientIo
our HttpClientConnectionView conn;
our HttpClientStreamHandle kept;
our bool during;
#! makes a request with the manager and keeps the view of its connection; returns the status code
int sub request(HttpClientConnectionManager mgr, string url, string path) {
    HttpClientStreamHandle sh = mgr.acquireStream(url);
    kept = sh;
    conn = sh.getConnectionView();
    hash<auto> r = sh.submitAsync(\"GET\", path);
    # the view works while the borrower's request is active
    during = conn.isActive() && conn.isReady() && conn.getProtocol() != \"\";
    int status = r.future.get(20s).status_code;
    return status;
}
#! True if the view worked during the borrower's request
bool sub viewDuringRequest() {
    return during;
}
#! the ID of the kept connection
int sub connId() {
    return conn.getConnectionId();
}
#! acts on the kept connection after the borrower's request ended; returns what happened
string sub act(string what) {
    try {
        switch (what) {
            case \"close\": conn.close(); break;
            case \"cancel\": conn.cancelRequest(1); break;
            case \"cancel3\": conn.cancelRequest(3); break;
            case \"direct\": kept.getConnection().close(); break;
            default: throw \"UNKNOWN\", what;
        }
        return \"done\";
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
}
";

#! answers each request with 200; a request for /hold waits until the test releases it
class HoldHandler inherits AbstractHttpRequestHandler {
    public {
        Queue held();
        Queue release();
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        if (cx.url.path == "hold") {
            held.push(True);
            release.get(HangGuard);
        }
        return <HttpResponseInfo>{"code": 200, "body": "ok " + cx.url.path};
    }
}

class HttpClientIoLentConnectionScopeTest inherits QUnit::Test {
    constructor() : QUnit::Test("lent manager: the borrower acts on a connection for its own request only", "1.0",
            \ARGV) {
        addTestCase("HTTP/1.1: closing or changing the pool state of the kept connection", \h1Test());
        addTestCase("HTTP/2: closing, cancelling and changing the pool state of the kept connection", \h2Test());
        addTestCase("the code that owns the manager acts on its connections", \ownerTest());
        set_return_value(main());
    }

    #! returns a server, its handler and its URL
    private hash<auto> startServer(bool tls) {
        HoldHandler handler();
        HttpServer server(<HttpServerOptionInfo>{});
        server.setDefaultHandler("hold", handler);
        int port = tls
            ? server.addListener(<HttpListenerOptionInfo>{
                "node": "127.0.0.1",
                "service": 0,
                "cert": new SSLCertificate(CertPem),
                "key": new SSLPrivateKey(KeyPem),
                "http_version": "2.0",
            }).port
            : server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        server.waitForAsyncIo();
        return {
            "server": server,
            "handler": handler,
            "port": port,
            "url": sprintf("%s://127.0.0.1:%d", tls ? "https" : "http", port),
        };
    }

    #! a manager that the host creates and lends
    private HttpClientConnectionManager getManager(string protocol) {
        return new HttpClientConnectionManager(<HttpClientConnectionManagerOptions>{
            "protocol": protocol,
            "accept_all_certs": True,
            "max_request_retries": 0,
            "request_timeout": HangGuard,
        });
    }

    #! a sandboxed borrower that may reach the server
    private Program getBorrower(int port) {
        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        SandboxManager sm();
        sm.setNetworkDefaultPolicy(False);
        sm.addNetworkAllowedIPRange("127.0.0.1/32");
        sm.addNetworkAllowedPort(port);
        p.setSandboxManager(sm);
        p.parse(BorrowerCode, "borrower");
        return p;
    }

    #! a request of the host; returns the status code, the ID of its connection and the body
    private list<auto> hostRequest(HttpClientConnectionManager mgr, string url, string path) {
        HttpClientStreamHandle sh = mgr.acquireStream(url);
        hash<auto> r = sh.submitAsync("GET", path);
        hash<auto> resp = r.future.get(HangGuard);
        return (resp.status_code, sh.getConnection().getConnectionId(), resp.body);
    }

    #! the host's request /hold is held by the server while the borrower acts on its kept connection
    /** @return the result of the host's request: (status, connection ID, body), or the error
    */
    private auto actWhileHostRequestHeld(hash<auto> srv, HttpClientConnectionManager mgr, Program p, string what,
            reference<string> result) {
        Queue done();
        background sub () {
            try {
                done.push(hostRequest(mgr, srv.url, "/hold"));
            } catch (hash<ExceptionInfo> ex) {
                done.push(ex.err);
            }
        }();
        # the server has the host's request, or the request ended without reaching it
        if (!srv.handler.held.get(HangGuard)) {
            fail(sprintf("the host's request did not reach the server: %y", done.get(0)));
        }
        on_exit srv.handler.release.push(True);
        result = p.callFunction("act", what);
        srv.handler.release.push(True);
        return done.get(HangGuard);
    }

    private scopeTest(bool tls, string protocol, softlist<string> actions) {
        foreach string what in (actions) {
            hash<auto> srv = startServer(tls);
            on_exit srv.server.stop();
            HttpClientConnectionManager mgr = getManager(protocol);
            on_exit mgr.closeAll();
            Program p = getBorrower(srv.port);

            assertEq(200, p.callFunction("request", mgr, srv.url, "/ok"), "the borrower's request");
            assertTrue(p.callFunction("viewDuringRequest"), protocol + ": the view works during the request");
            int borrowed = p.callFunction("connId");
            # the host's request reuses the connection
            string result;
            auto r = actWhileHostRequestHeld(srv, mgr, p, what, \result);
            assertTrue(r.typeCode() == NT_LIST,
                sprintf("%s %s: the host's request completes (%y)", protocol, what, r));
            if (r.typeCode() == NT_LIST) {
                assertEq(200, r[0], sprintf("%s %s: the host's request", protocol, what));
                assertEq("ok hold", r[2], sprintf("%s %s: the host's response", protocol, what));
                assertEq(borrowed, r[1], sprintf("%s %s: the host's request used the kept connection", protocol, what));
            }
            assertEq("PERMISSION-DENIED", result, sprintf("%s %s: the borrower's call is refused", protocol, what));
            # the pool still hands the connection out
            list<auto> after = hostRequest(mgr, srv.url, "/after");
            assertEq(200, after[0], sprintf("%s %s: the host's request after the borrower's call", protocol, what));
        }
    }

    h1Test() {
        scopeTest(False, "h1", ("close", "direct"));
    }

    h2Test() {
        scopeTest(True, "h2", ("close", "cancel", "cancel3", "direct"));
    }

    ownerTest() {
        foreach hash<auto> c in ({"tls": False, "protocol": "h1"}, {"tls": True, "protocol": "h2"}) {
            hash<auto> srv = startServer(c.tls);
            on_exit srv.server.stop();
            # the code that owns the manager is not restricted
            HttpClientConnectionManager mgr = getManager(c.protocol);
            on_exit mgr.closeAll();
            HttpClientStreamHandle sh = mgr.acquireStream(srv.url);
            hash<auto> r = sh.submitAsync("GET", "/ok");
            assertEq(200, r.future.get(HangGuard).status_code, c.protocol + ": the host's request");
            # the view of the code that owns the manager is never ended
            HttpClientConnectionView view = sh.getConnectionView();
            assertTrue(view.isActive(), c.protocol + ": the owner's view is active after its request");
            assertTrue(view.isReady(), c.protocol + ": the owner's view works after its request");
            HttpClientConnection conn = sh.getConnection();
            conn.close();
            assertEq(200, hostRequest(mgr, srv.url, "/again")[0], c.protocol + ": the owner closed its connection");
        }
    }
}
