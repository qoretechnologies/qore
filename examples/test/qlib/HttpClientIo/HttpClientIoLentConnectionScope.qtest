#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - pooled HTTP/1.1 and HTTP/2 client connections over TCP and TLS, closed and cancelled by other code
# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires HttpClientIo
%requires HttpServer
%requires HttpServerUtil

%exec-class HttpClientIoLentConnectionScopeTest

#! A sandboxed borrower of a connection manager that other code shares acts on a pooled connection only for its own
#! request (qore#7570)
/** The borrower keeps the connection of its request after the request has ended.  The pool gives that connection to
    the host's later requests, so the borrower's public calls on it (closing it, changing its pool state, cancelling a
    stream of it) must not reach them: a borrower that does not own the manager acts on a connection only while its
    own request is active on it.  The host's request is held by the server while the borrower acts, so the test fails
    without any timing: the host's request must complete with its response, on the connection that it reused.
*/

#! a hang guard only, never a timing assertion
const HangGuard = 20s;

