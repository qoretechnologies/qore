#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - getaddrinfo() order of localhost (::1 first) and HTTP/3 fallback to the IPv4 address
# test-loopback: localhost - the fallback from ::1 to 127.0.0.1 of the name localhost is tested; the port number of the IPv4-only QUIC listener is held on ::1, where the system refuses the datagrams
# Copyright 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires Util
%requires Mime
%requires Logger
%requires HttpServerUtil
%requires HttpServer
%requires HttpClientIo
%requires ../../RefusedQuicPort.qm

%exec-class Http3FamilyFallbackTest

class FallbackHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, "reached", {"Content-Type": MimeTypeText});
    }
}

#! HTTP/3 connections to a host whose name resolves to addresses in both families, when the server only receives
#! datagrams in one of them
public class Http3FamilyFallbackTest inherits QUnit::Test {
    private {
        HttpServer server;
        #! a QUIC listener on IPv4 only
        int port;
        #! holds the port number of the QUIC listener on ::1, where the system refuses the datagrams
        *RefusedUdpPort v6_hold;
    }

    #! the number of tries to find a port number that is free on both loopback addresses
    const MaxBindAttempts = 20;

    constructor() : Test("Http3FamilyFallbackTest", "1.0") {
        addTestCase("HttpClientIo family fallback", \httpClientIoTest());
        addTestCase("HTTPClient family fallback", \httpClientTest());
        addTestCase("no family reachable", \unreachableTest());
        set_return_value(main());
    }

    globalSetUp() {
        server = new HttpServer(<HttpServerOptionInfo>{"logger": new Logger("h3-family",
            LoggerLevel::getLevelInfo())});
        server.setDefaultHandler("fallback", new FallbackHandler());
        server.waitForAsyncIo();
        port = addIpv4QuicListener(<HttpListenerOptionInfo>{
            "node": "127.0.0.1",
            "cert": new SSLCertificate(ReadOnlyFile::readTextFile(get_script_dir() + "/../../qore/classes/HTTPClient/"
                "HttpClientTlsVerify.qtest") =~ x/const GoodCert = "([^"]+)"/[0]),
            "key": new SSLPrivateKey(ReadOnlyFile::readTextFile(get_script_dir() + "/../../qore/classes/HTTPClient/"
                "HttpClientTlsVerify.qtest") =~ x/const GoodKey = "([^"]+)"/[0]),
        });
        server.waitForAsyncIo();
    }

    globalTearDown() {
        if (server) {
            server.stop();
        }
        if (v6_hold) {
            v6_hold.close();
        }
    }

    #! adds the QUIC listener on 127.0.0.1 at a port number that the test holds on ::1, and returns the port
    /** "localhost" resolves to ::1 first: the connection in IPv6 fails as at a port where nothing is bound, as the
        system refuses the datagrams there, and no server of a test running beside this one can be bound to the port
        number on ::1 while the test holds it (qore#7469)
    */
    private int addIpv4QuicListener(hash<HttpListenerOptionInfo> opts) {
        for (int attempt = 1; ; ++attempt) {
            RefusedUdpPort hold;
            try {
                hold = new RefusedUdpPort("::1", AF_INET6);
            } catch (hash<ExceptionInfo> ex) {
                # without IPv6 on the loopback interface, no server can listen on ::1
                return server.addQuicListener(opts).port;
            }
            try {
                int p = server.addQuicListener(opts, hold.port).port;
                v6_hold = hold;
                return p;
            } catch (hash<ExceptionInfo> ex) {
                hold.close();
                # the port number is in use on 127.0.0.1: another one is tried
                if (ex.desc !~ /in use/i || attempt == MaxBindAttempts) {
                    rethrow;
                }
            }
        }
    }

    #! returns True if "localhost" resolves to an IPv6 address first, which the test needs
    private bool checkDualStack() {
        list<hash<auto>> addrs = getaddrinfo("localhost", NOTHING, AF_UNSPEC, 0);
        hash<string, bool> families = map {$1.family: True}, addrs;
        if (addrs[0].family != AF_INET6 || !families{AF_INET}) {
            testSkip("\"localhost\" does not resolve to an IPv6 address and then to an IPv4 address here");
            return False;
        }
        return True;
    }

    httpClientIoTest() {
        if (!checkDualStack()) {
            return;
        }
        HttpClientIo::HttpClientConnectionManager mgr(<HttpClientIo::HttpClientConnectionManagerOptions>{
            "protocol": "h3",
            "accept_all_certs": True,
        });
        on_exit mgr.closeAll();
        hash<auto> resp = mgr.request(sprintf("https://localhost:%d", port), "GET", "/");
        assertEq(200, resp.status_code);
        assertEq("reached", resp.body);
    }

    httpClientTest() {
        if (!checkDualStack()) {
            return;
        }
        HTTPClient hc({"url": sprintf("https://localhost:%d", port), "http_version": "3.0", "timeout": 20s});
        hc.acceptAllCertificates();
        assertEq("reached", hc.get("/"));
    }

    unreachableTest() {
        # every connection attempt fails on this port in both families: the error of an attempt is reported; the port
        # is held by the test, so no other test's server can answer on it (issue #6461)
        QuicVersionRefuser refuser();
        on_exit refuser.stop();
        int free_port = refuser.port;
        HttpClientIo::HttpClientConnectionManager mgr(<HttpClientIo::HttpClientConnectionManagerOptions>{
            "protocol": "h3",
            "accept_all_certs": True,
            "max_request_retries": 1,
        });
        on_exit mgr.closeAll();
        assertThrows("HTTPCLIENT-CONNECT-ERROR", \mgr.request(), (sprintf("https://localhost:%d", free_port), "GET",
            "/"));
    }
}
