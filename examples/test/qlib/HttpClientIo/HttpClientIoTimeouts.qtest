%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires Logger
%requires Mime
%requires HttpServerUtil
%requires HttpServer
%requires HttpClientIo
%requires RestClient
%requires RestClientIo
%requires FileLocationHandler
%requires ../../TestCertificates.qm

%exec-class HttpClientIoTimeoutsTest

#! Answers "/stall" once the stall counter is zero, and everything else at once
class StallHandler inherits AbstractHttpRequestHandler {
    public {
        #! "/stall" requests wait until this counter is zero
        Counter stall(1);
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        if (cx.raw_path == "/stall") {
            stall.waitForZero(60s);
        }
        return makeResponse({"Content-Type": "text/plain"}, 200, binary("done"));
    }
}

#! An HTTP/1.1 server that sends a response body one octet at a time
class TrickleServer {
    public {
        #! The number of body octets
        const Size = 8;
        #! The delay between two octets
        const Delay = 150ms;
    }

    private {
        Socket listener();
        int port;
        Counter running(1);
    }

    constructor() {
        listener.bindINET("127.0.0.1", 0, True);
        listener.listen();
        port = listener.getSocketInfo().port;
        background serve();
    }

    int getPort() {
        return port;
    }

    stop() {
        listener.shutdown();
        listener.close();
        running.waitForZero();
    }

    private serve() {
        on_exit running.dec();
        while (True) {
            Socket peer;
            try {
                peer = listener.accept();
            } catch (hash<ExceptionInfo> ex) {
                # the listener was closed
                return;
            }
            background trickle(peer);
        }
    }

    private trickle(Socket peer) {
        on_exit peer.close();
        try {
            peer.readHTTPHeader(10s);
            peer.send(sprintf("HTTP/1.1 200 OK\r\nContent-Type: application/octet-stream\r\nContent-Length: %d\r\n"
                "Connection: close\r\n\r\n", Size));
            for (int i = 0; i < Size; ++i) {
                # the response is slow on purpose: it takes longer than the inactivity timeout of the tests, but
                # never stops sending for as long
                usleep(Delay);
                peer.send(binary("x"));
            }
        } catch (hash<ExceptionInfo> ex) {
            # the client closed the connection
        }
    }
}

public class HttpClientIoTimeoutsTest inherits QUnit::Test {
    public {
        const CertPem = TestCertificates::CertPem;

        const KeyPem = TestCertificates::KeyPem;
    }

    public {
        #! the inactivity timeout of the clients that a stalled response times out
        /** A request that receives its response with the same client must not time out, also on a loaded machine,
            where a thread can wait for a CPU for hundreds of milliseconds; a stalled response times out with any
            inactivity timeout, as it is answered only when the test ends.
        */
        const IoTimeout = 2s;
    }

    private {
        HttpServer server;
        StallHandler handler();
        #! started by globalSetUp() and stopped by globalTearDown(), so a run that runs no test (--list) has no thread
        #! left that keeps the program from exiting
        *TrickleServer trickle;
        hash<string, string> urls;
        *int quic_port;
    }

    constructor() : Test("HttpClientIoTimeoutsTest", "1.0") {
        addTestCase("no overall deadline", \testNoDeadline());
        addTestCase("inactivity timeout of a stalled response", \testStall());
        addTestCase("inactivity timeout of a slow response", \testTrickle());
        addTestCase("RestClientIo", \testRestClientIo());
        set_return_value(main());
    }

    globalSetUp() {
        trickle = new TrickleServer();
        server = new HttpServer(<HttpServerOptionInfo>{
            "logger": new Logger("server", LoggerLevel::getLevelError()),
        });
        server.setDefaultHandler("stall", handler);
        urls.h1 = sprintf("http://127.0.0.1:%d", server.addListener(<HttpListenerOptionInfo>{
            "node": "127.0.0.1",
            "service": 0,
        }).port);
        urls.h2 = sprintf("https://localhost:%d", server.addListener(<HttpListenerOptionInfo>{
            "node": "localhost",
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        }).port);
        server.waitForAsyncIo();
        try {
            quic_port = server.addQuicListener(<HttpListenerOptionInfo>{
                "cert": new SSLCertificate(CertPem),
                "key": new SSLPrivateKey(KeyPem),
            }).port;
            server.waitForAsyncIo();
            # the QUIC listener is bound to an IPv4 address
            urls.h3 = sprintf("https://127.0.0.1:%d", quic_port);
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("no HTTP/3 listener: %s: %s\n", ex.err, ex.desc);
            }
        }
    }

    globalTearDown() {
        handler.stall.dec();
        if (trickle) {
            trickle.stop();
        }
        if (server) {
            server.stop();
        }
    }

    testNoDeadline() {
        # a request timeout of 0 means no deadline; it used to fail every request at once
        foreach hash<auto> i in (urls.pairIterator()) {
            HttpClientConnectionManager mgr(<HttpClientConnectionManagerOptions>{
                "protocol": i.key,
                "request_timeout": 0,
            });
            on_exit mgr.closeAll();
            # the first request waits for a new connection: its connection wait has no deadline either
            HttpClientResponseStream s = mgr.openStream(i.value + "/x");
            assertEq(200, s.getStatusCode(), i.key);
            s.cancel();
            assertEq("done", mgr.request(i.value, "GET", "/x").body, i.key);
            assertEq("done", mgr.requestAsync(i.value, "GET", "/x").get(30s).body, i.key);
            assertEq("done", runPoller(new HttpClientRequestPollOperation(mgr, i.value + "/x")).body, i.key);
            # a stream read without a timeout waits for data
            HttpClientStreamHandle sh = mgr.acquireAndStartStreaming(i.value, "GET", "/x", NOTHING, False);
            on_exit sh.cancel();
            auto first = sh.readData();
            assertTrue(exists first, i.key);

            # a location handler bound to the manager has no deadline either
            AbstractFileLocationHandler h = FileLocationHandler::getHttpHandlerForClient(mgr, i.value);
            assertEq("done", h.getTextFile(i.key =~ /1/ ? "http" : "https", "/x"), i.key);
        }
    }

    testStall() {
        # each protocol's requests are made one after the other on its own connection manager; the protocols run in
        # parallel, as they share nothing but the server, so their inactivity timeouts elapse at the same time
        hash<string, hash<auto>> results = runPerProtocol(\stallSteps());
        foreach string k in (keys urls) {
            hash<auto> r = results{k};
            assertThrows("HTTPCLIENT-TIMEOUT", "io_timeout", \HttpClientIoTimeoutsTest::replay(), r.request, k);
            assertThrows("HTTPCLIENT-TIMEOUT", "io_timeout", \HttpClientIoTimeoutsTest::replay(), r.async, k);
            assertThrows("HTTPCLIENT-TIMEOUT", "io_timeout", \HttpClientIoTimeoutsTest::replay(), r.poller, k);
            assertThrows("HTTPCLIENT-TIMEOUT", "io_timeout", \HttpClientIoTimeoutsTest::replay(), r.stream, k);
            # each timeout is the inactivity timeout, not another deadline
            assertLt(20s, r.elapsed, k);
            # a request that receives its response is not affected
            assertEq("done", HttpClientIoTimeoutsTest::replay(r.done), k);
            # the overall deadline applies as well
            assertThrows("HTTPCLIENT-TIMEOUT", "timed out", \HttpClientIoTimeoutsTest::replay(), r.both, k);
        }
    }

    #! Makes the requests of testStall() for one protocol and returns their outcomes
    private hash<auto> stallSteps(string proto, string url) {
        hash<auto> r;
        HttpClientConnectionManager mgr(<HttpClientConnectionManagerOptions>{
            "protocol": proto,
            "request_timeout": 0,
            "io_timeout": IoTimeout,
            "max_request_retries": 0,
        });
        on_exit mgr.closeAll();
        date start = now_us();
        r.request = record(auto sub () { return mgr.request(url, "GET", "/stall"); });
        HttpCancellableFuture f = mgr.requestAsync(url, "GET", "/stall");
        r.async = record(auto sub () { return f.get(30s); });
        r.poller = record(auto sub () { return runPoller(new HttpClientRequestPollOperation(mgr, url + "/stall")); });
        r.stream = record(auto sub () { return mgr.openStream(url + "/stall"); });
        r.elapsed = now_us() - start;
        r.done = record(auto sub () { return mgr.request(url, "GET", "/x").body; });
        HttpClientConnectionManager both(<HttpClientConnectionManagerOptions>{
            "protocol": proto,
            "request_timeout": 300ms,
            "io_timeout": 60s,
            "max_request_retries": 0,
        });
        on_exit both.closeAll();
        r.both = record(auto sub () { return both.request(url, "GET", "/stall"); });
        return r;
    }

    testTrickle() {
        string url = sprintf("http://127.0.0.1:%d", trickle.getPort());
        # the response takes longer than the inactivity timeout, but data keeps arriving
        HttpClientConnectionManager mgr(<HttpClientConnectionManagerOptions>{
            "protocol": "h1",
            "request_timeout": 0,
            "io_timeout": TrickleServer::Delay * 4,
        });
        on_exit mgr.closeAll();
        assertEq(TrickleServer::Size, mgr.request(url, "GET", "/").body.size());
        assertEq(TrickleServer::Size, mgr.requestAsync(url, "GET", "/").get(30s).body.size());
        assertEq(TrickleServer::Size, runPoller(new HttpClientRequestPollOperation(mgr, url + "/")).body.size());
        # an overall deadline shorter than the transfer fails it
        HttpClientConnectionManager short(<HttpClientConnectionManagerOptions>{
            "protocol": "h1",
            "request_timeout": TrickleServer::Delay * 2,
            "max_request_retries": 0,
        });
        on_exit short.closeAll();
        assertThrows("HTTPCLIENT-TIMEOUT", "timed out", \short.request(), (url, "GET", "/"));
    }

    testRestClientIo() {
        # the protocols run in parallel, as in testStall()
        hash<string, hash<auto>> results = runPerProtocol(\restSteps());
        foreach string k in (keys urls) {
            hash<auto> r = results{k};
            assertEq(IoTimeout.durationMilliseconds(), r.io_timeout, k);
            assertThrows("HTTPCLIENT-TIMEOUT", "io_timeout", \HttpClientIoTimeoutsTest::replay(), r.get, k);
            assertThrows("HTTPCLIENT-TIMEOUT", "io_timeout", \HttpClientIoTimeoutsTest::replay(), r.async, k);
            assertEq("done", HttpClientIoTimeoutsTest::replay(r.done), k);

            # a connection manager without a request deadline
            assertEq(0, r.nodl_timeout, k);
            assertEq("done", HttpClientIoTimeoutsTest::replay(r.nodl_get), k);
            assertEq("done", HttpClientIoTimeoutsTest::replay(r.nodl_async), k);
        }
    }

    #! Makes the requests of testRestClientIo() for one protocol and returns their outcomes
    private hash<auto> restSteps(string proto, string url) {
        hash<auto> r;
        RestClientIo rest({
            "url": url,
            "protocol": proto,
            "data": "text",
            "io_timeout": IoTimeout,
            "max_request_retries": 0,
        });
        on_exit rest.close();
        r.io_timeout = rest.getConnectionManager().getIoTimeout();
        r.get = record(auto sub () { return rest.restGet("/stall"); });
        RestFuture f = rest.restGetAsync("/stall");
        r.async = record(auto sub () { return f.get(); });
        r.done = record(auto sub () { return rest.restGet("/x").body; });

        HttpClientConnectionManager mgr(<HttpClientConnectionManagerOptions>{
            "protocol": proto,
            "request_timeout": 0,
        });
        on_exit mgr.closeAll();
        RestClientIo nodl({"url": url, "data": "text"}, mgr);
        on_exit nodl.close();
        r.nodl_timeout = nodl.getTimeout();
        r.nodl_get = record(auto sub () { return nodl.restGet("/x").body; });
        r.nodl_async = record(auto sub () { return nodl.restGetAsync("/x").get().body; });
        return r;
    }

    #! Runs the steps for each protocol in its own thread, all at the same time, and returns their outcomes by protocol
    /** An error raised by the steps themselves, outside of a recorded call, is raised here
    */
    private hash<string, hash<auto>> runPerProtocol(code steps) {
        Queue q();
        foreach hash<auto> i in (urls.pairIterator()) {
            background runSteps(q, steps, i.key, i.value);
        }
        hash<string, hash<auto>> rv;
        *hash<ExceptionInfo> err;
        for (int n = urls.size(); n; --n) {
            hash<auto> h = q.get();
            if (h.ex && !err) {
                err = h.ex;
            }
            rv{h.proto} = h.result;
        }
        if (err) {
            # the argument is the exception raised by the thread, with its call stack
            throw err.err, err.desc, err;
        }
        return rv;
    }

    #! Runs the steps for one protocol and pushes their outcome, or the error that they raised, on the queue
    private runSteps(Queue q, code steps, string proto, string url) {
        try {
            q.push({"proto": proto, "result": steps(proto, url)});
        } catch (hash<ExceptionInfo> ex) {
            q.push({"proto": proto, "ex": ex});
        }
    }

    #! Returns the outcome of a call: its return value, or the exception it raised
    static hash<auto> record(code c) {
        try {
            return {"rv": c()};
        } catch (hash<ExceptionInfo> ex) {
            return {"ex": ex};
        }
    }

    #! Returns the return value of a recorded call, or raises the exception it raised
    /** The exception has the error and description of the recorded one; as it is raised again on another thread,
        its argument is the recorded exception, with its call stack, and the recorded argument in its \c arg key
    */
    static auto replay(hash<auto> outcome) {
        if (outcome.ex) {
            throw outcome.ex.err, outcome.ex.desc, outcome.ex;
        }
        return outcome.rv;
    }

    static auto runPoller(AbstractPollOperation op) {
        date deadline = now_us() + 30s;
        while (!op.goalReached()) {
            *hash<SocketPollInfo> pi = op.continuePoll();
            if (op.goalReached()) {
                break;
            }
            int remaining = (deadline - now_us()).durationMilliseconds();
            if (remaining <= 0) {
                op.abort();
                throw "TEST-TIMEOUT", sprintf("poll operation %y did not complete", op.getGoal());
            }
            if (pi) {
                Socket::poll((pi,), remaining);
            }
        }
        return op.getOutput();
    }
}
