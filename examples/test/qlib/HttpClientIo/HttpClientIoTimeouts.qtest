    private {
        HttpServer server;
        StallHandler handler();
        TrickleServer trickle();
        hash<string, string> urls;
        *int quic_port;
    }

    constructor() : Test("HttpClientIoTimeoutsTest", "1.0") {
        addTestCase("no overall deadline", \testNoDeadline());
        addTestCase("inactivity timeout of a stalled response", \testStall());
        addTestCase("inactivity timeout of a slow response", \testTrickle());
        addTestCase("RestClientIo", \testRestClientIo());
        set_return_value(main());
    }

    globalSetUp() {
        server = new HttpServer(<HttpServerOptionInfo>{
            "logger": new Logger("server", LoggerLevel::getLevelError()),
        });
        server.setDefaultHandler("stall", handler);
        urls.h1 = sprintf("http://127.0.0.1:%d", server.addListener(<HttpListenerOptionInfo>{
            "node": "127.0.0.1",
            "service": 0,
        }).port);
        urls.h2 = sprintf("https://localhost:%d", server.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        }).port);
        server.waitForAsyncIo();
        try {
            quic_port = server.addQuicListener(<HttpListenerOptionInfo>{
                "cert": new SSLCertificate(CertPem),
                "key": new SSLPrivateKey(KeyPem),
            }).port;
            server.waitForAsyncIo();
            # the QUIC listener is bound to an IPv4 address
            urls.h3 = sprintf("https://127.0.0.1:%d", quic_port);
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("no HTTP/3 listener: %s: %s\n", ex.err, ex.desc);
            }
        }
    }

    globalTearDown() {
        handler.stall.dec();
        trickle.stop();
        if (server) {
            server.stop();
        }
    }

    testNoDeadline() {
        # a request timeout of 0 means no deadline; it used to fail every request at once
        foreach hash<auto> i in (urls.pairIterator()) {
            HttpClientConnectionManager mgr(<HttpClientConnectionManagerOptions>{
                "protocol": i.key,
                "request_timeout": 0,
            });
            on_exit mgr.closeAll();
            # the first request waits for a new connection: its connection wait has no deadline either
            HttpClientResponseStream s = mgr.openStream(i.value + "/x");
            assertEq(200, s.getStatusCode(), i.key);
            s.cancel();
            assertEq("done", mgr.request(i.value, "GET", "/x").body, i.key);
            assertEq("done", mgr.requestAsync(i.value, "GET", "/x").get(30s).body, i.key);
            assertEq("done", runPoller(new HttpClientRequestPollOperation(mgr, i.value + "/x")).body, i.key);
            # a stream read without a timeout waits for data
            HttpClientStreamHandle sh = mgr.acquireAndStartStreaming(i.value, "GET", "/x", NOTHING, False);
            on_exit sh.cancel();
            auto first = sh.readData();
            assertTrue(exists first, i.key);

            # a location handler bound to the manager has no deadline either
            AbstractFileLocationHandler h = FileLocationHandler::getHttpHandlerForClient(mgr, i.value);
            assertEq("done", h.getTextFile(i.key =~ /1/ ? "http" : "https", "/x"), i.key);
        }
    }

    testStall() {
        foreach hash<auto> i in (urls.pairIterator()) {
            HttpClientConnectionManager mgr(<HttpClientConnectionManagerOptions>{
                "protocol": i.key,
                "request_timeout": 0,
                "io_timeout": 300ms,
                "max_request_retries": 0,
            });
            on_exit mgr.closeAll();
            date start = now_us();
            assertThrows("HTTPCLIENT-TIMEOUT", "io_timeout", \mgr.request(), (i.value, "GET", "/stall"), i.key);
            HttpCancellableFuture f = mgr.requestAsync(i.value, "GET", "/stall");
            assertThrows("HTTPCLIENT-TIMEOUT", "io_timeout", \f.get(), 30s, i.key);
            assertThrows("HTTPCLIENT-TIMEOUT", "io_timeout", \runPoller(),
                new HttpClientRequestPollOperation(mgr, i.value + "/stall"), i.key);
            assertThrows("HTTPCLIENT-TIMEOUT", "io_timeout", \mgr.openStream(), i.value + "/stall", i.key);
            # each timeout is the inactivity timeout, not another deadline
            assertLt(20s, now_us() - start, i.key);
            # a request that receives its response is not affected
            assertEq("done", mgr.request(i.value, "GET", "/x").body, i.key);
            # the overall deadline applies as well
            HttpClientConnectionManager both(<HttpClientConnectionManagerOptions>{
                "protocol": i.key,
                "request_timeout": 300ms,
                "io_timeout": 60s,
                "max_request_retries": 0,
            });
            on_exit both.closeAll();
            assertThrows("HTTPCLIENT-TIMEOUT", "timed out", \both.request(), (i.value, "GET", "/stall"), i.key);
        }
    }

    testTrickle() {
        string url = sprintf("http://127.0.0.1:%d", trickle.getPort());
        # the response takes longer than the inactivity timeout, but data keeps arriving
        HttpClientConnectionManager mgr(<HttpClientConnectionManagerOptions>{
            "protocol": "h1",
            "request_timeout": 0,
            "io_timeout": TrickleServer::Delay * 4,
        });
        on_exit mgr.closeAll();
        assertEq(TrickleServer::Size, mgr.request(url, "GET", "/").body.size());
        assertEq(TrickleServer::Size, mgr.requestAsync(url, "GET", "/").get(30s).body.size());
        assertEq(TrickleServer::Size, runPoller(new HttpClientRequestPollOperation(mgr, url + "/")).body.size());
        # an overall deadline shorter than the transfer fails it
        HttpClientConnectionManager short(<HttpClientConnectionManagerOptions>{
            "protocol": "h1",
            "request_timeout": TrickleServer::Delay * 2,
            "max_request_retries": 0,
        });
        on_exit short.closeAll();
        assertThrows("HTTPCLIENT-TIMEOUT", "timed out", \short.request(), (url, "GET", "/"));
    }

    testRestClientIo() {
        foreach hash<auto> i in (urls.pairIterator()) {
            RestClientIo rest({
                "url": i.value,
                "protocol": i.key,
                "data": "text",
                "io_timeout": 300ms,
                "max_request_retries": 0,
            });
            on_exit rest.close();
            assertEq(300, rest.getConnectionManager().getIoTimeout(), i.key);
            assertThrows("HTTPCLIENT-TIMEOUT", "io_timeout", \rest.restGet(), "/stall", i.key);
            RestFuture f = rest.restGetAsync("/stall");
            assertThrows("HTTPCLIENT-TIMEOUT", "io_timeout", \f.get(), NOTHING, i.key);
            assertEq("done", rest.restGet("/x").body, i.key);

            # a connection manager without a request deadline
            HttpClientConnectionManager mgr(<HttpClientConnectionManagerOptions>{
                "protocol": i.key,
                "request_timeout": 0,
            });
            on_exit mgr.closeAll();
            RestClientIo nodl({"url": i.value, "data": "text"}, mgr);
            on_exit nodl.close();
            assertEq(0, nodl.getTimeout(), i.key);
            assertEq("done", nodl.restGet("/x").body, i.key);
            assertEq("done", nodl.restGetAsync("/x").get().body, i.key);
        }
    }

    static auto runPoller(AbstractPollOperation op) {
        date deadline = now_us() + 30s;
        while (!op.goalReached()) {
            *hash<SocketPollInfo> pi = op.continuePoll();
            if (op.goalReached()) {
                break;
            }
            int remaining = (deadline - now_us()).durationMilliseconds();
            if (remaining <= 0) {
                op.abort();
                throw "TEST-TIMEOUT", sprintf("poll operation %y did not complete", op.getGoal());
            }
            if (pi) {
                Socket::poll((pi,), remaining);
            }
        }
        return op.getOutput();
    }
}
