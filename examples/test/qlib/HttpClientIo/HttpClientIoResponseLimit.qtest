    HttpClientIo and RestClientIo response bodies: decoding the content encoding of responses returned whole, and
    the max_response_body_size option limiting them as received and as decoded, over HTTP/1.1, HTTP/2, and HTTP/3
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires Mime
%requires Logger
%requires HttpServerUtil
%requires HttpServer
%requires HttpClientIo
%requires RestClientIo
%requires RestClient
%requires json
%requires ../../TestCertificates.qm

%exec-class HttpClientIoResponseLimitTest

#! Returns responses selected by the path:
#! - /json/<coding>: a JSON document compressed with the given coding (or "identity")
#! - /sized/<n>: an uncompressed body of n bytes with a Content-Length
#! - /chunked/<n>: an uncompressed body of n bytes with chunked transfer encoding
#! - /bomb/<n>: a gzip body that decompresses to n bytes
class TestHandler inherits AbstractHttpRequestHandler {
    public {
        const Encoders = {
            "gzip": \gzip(),
            "x-gzip": \gzip(),
            "deflate": \compress(),
            "bzip2": \bzip2(),
            "br": \brotli(),
            "zstd": \zstd(),
        };

        const Document = {"name": "value", "list": (1, 2, 3)};
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        list<string> parts = hdr.path.split("/");
        string arg = parts.last();
        switch (parts[0]) {
            case "json": {
                binary data = binary(make_json(Document));
                hash<auto> rhdr = {"Content-Type": MimeTypeJson};
                if (arg != "identity") {
                    data = Encoders{arg}(data);
                    rhdr."Content-Encoding" = arg;
                }
                return <HttpResponseInfo>{"code": 200, "hdr": rhdr, "body": data};
            }
            case "sized":
                # random bytes do not compress, so the server does not compress them itself
                return <HttpResponseInfo>{
                    "code": 200,
                    "hdr": {"Content-Type": MimeTypeOctetStream},
                    "body": get_random_bytes(arg.toInt()),
                };
            case "chunked":
                return <HttpResponseInfo>{
                    "code": 200,
                    "hdr": {"Content-Type": MimeTypeOctetStream, "Transfer-Encoding": "chunked"},
                    "chunked_body": new BinaryInputStream(get_random_bytes(arg.toInt())),
                };
            case "bomb":
                return <HttpResponseInfo>{
                    "code": 200,
                    "hdr": {"Content-Type": MimeTypeOctetStream, "Content-Encoding": "gzip"},
                    "body": gzip(binary(strmul("x", arg.toInt()))),
                };
        }
        return <HttpResponseInfo>{"code": 404, "hdr": {"Content-Type": MimeTypeText}, "body": "not found"};
    }
}

class HttpClientIoResponseLimitTest inherits QUnit::Test {
    private {
        # the maximum response body size of the tests
        const Limit = 4096;

        const CertPem = TestCertificates::CertPem;

        const KeyPem = TestCertificates::KeyPem;

        HttpServer server;
        int port;
        int tls_port;
    }

    constructor() : Test("HttpClientIoResponseLimitTest", "1.0") {
        addTestCase("decoding", \decodingTest());
        addTestCase("futures", \futureTest());
        addTestCase("limits over HTTP/1.1", \http1Test());
        addTestCase("limits over HTTP/2", \http2Test());
        addTestCase("limits over HTTP/3", \http3Test());
        addTestCase("RestClientIo", \restClientIoTest());
        addTestCase("connection option", \connectionTest());
        set_return_value(main());
    }

    globalSetUp() {
        server = new HttpServer(<HttpServerOptionInfo>{
            "logger": new Logger("server", LoggerLevel::getLevelError()),
        });
        TestHandler handler();
        server.setHandler("test", "", NOTHING, handler);
        server.setDefaultHandler("test", handler);
        port = server.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        tls_port = server.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        }).port;
        server.waitForAsyncIo();
    }

    globalTearDown() {
        delete server;
    }

    private HttpClientConnectionManager getManager(int max_size = Limit, *hash<auto> opts) {
        hash<HttpClientConnectionManagerOptions> mgr_opts({
            "max_response_body_size": max_size,
            "request_timeout": 30s,
            "ssl_verify_mode": SSL_VERIFY_NONE,
            # the limits are tested with bodies as sent; the server would otherwise compress them
            "accept_encoding": "",
        });
        if (opts.protocol) {
            mgr_opts.protocol = opts.protocol;
        }
        return new HttpClientConnectionManager(mgr_opts);
    }

    private string getUrl() {
        return "http://localhost:" + port;
    }

    decodingTest() {
        HttpClientConnectionManager mgr = getManager(0);
        foreach string coding in (("identity",) + keys TestHandler::Encoders) {
            hash<auto> resp = mgr.request(getUrl(), "GET", "/json/" + coding);
            assertEq(200, resp.status_code, coding);
            # the body is decoded and converted to a string for the JSON type
            assertEq(TestHandler::Document, parse_json(resp.body), coding);
            # the header is kept, as with HTTPClient
            if (coding != "identity") {
                assertEq(coding, resp.headers."content-encoding", coding);
            }
        }
        # a body that is not compressed is not changed
        assertEq(100, mgr.request(getUrl(), "GET", "/sized/100").body.size());
    }

    futureTest() {
        HttpClientConnectionManager mgr = getManager(0);
        # the future of an async request decodes the response once, when it is resolved
        auto f = mgr.requestAsync(getUrl(), "GET", "/json/br");
        hash<auto> resp = f.get(30s);
        assertEq(TestHandler::Document, parse_json(resp.body));
        assertEq(resp, f.get(30s));

        # the future of a stream handle submission
        HttpClientStreamHandle stream = mgr.acquireStream(getUrl());
        hash<auto> result = stream.submitAsync("GET", "/json/zstd");
        assertEq(TestHandler::Document, parse_json(result.future.get(30s).body));

        # the decoded size is limited when the future is resolved
        mgr = getManager();
        f = mgr.requestAsync(getUrl(), "GET", "/bomb/" + (Limit * 16));
        assertThrows("HTTP-CLIENT-RESPONSE-BODY-TOO-LARGE", "decoded response body exceeds the maximum response body "
            "size of " + Limit, \f.get(), 30s);
    }

    # checks the limits with the given URL and options
    private checkLimits(string url, *hash<auto> opts, string label) {
        HttpClientConnectionManager mgr = getManager(Limit, opts);
        assertEq(Limit, mgr.request(url, "GET", "/sized/" + Limit).body.size(), label);
        # a body over the limit fails as it is received
        assertThrows("HTTP-CLIENT-RESPONSE-BODY-TOO-LARGE", NOTHING, \mgr.request(),
            (url, "GET", "/sized/" + (Limit * 64)), label + " sized");
        # a compressed body is limited as it is decoded
        assertThrows("HTTP-CLIENT-RESPONSE-BODY-TOO-LARGE", "decoded response body", \mgr.request(),
            (url, "GET", "/bomb/" + (Limit * 16)), label + " bomb");
        # the manager is still usable
        assertEq(10, mgr.request(url, "GET", "/sized/10").body.size(), label);
        # without a limit
        assertEq(Limit * 64, getManager(0, opts).request(url, "GET", "/sized/" + (Limit * 64)).body.size(), label);
    }

    http1Test() {
        checkLimits(getUrl(), NOTHING, "HTTP/1.1");
        HttpClientConnectionManager mgr = getManager();
        assertThrows("HTTP-CLIENT-RESPONSE-BODY-TOO-LARGE", NOTHING, \mgr.request(),
            (getUrl(), "GET", "/chunked/" + (Limit * 64)));
    }

    http2Test() {
        checkLimits("https://localhost:" + tls_port, {"protocol": "h2"}, "HTTP/2");
    }

    http3Test() {
        # HTTP/3 is used only if the server's QUIC listener was created
        HttpClientConnectionManager mgr = getManager(0, {"protocol": "h3"});
        try {
            mgr.request("https://localhost:" + tls_port, "GET", "/sized/1");
        } catch (hash<ExceptionInfo> ex) {
            testSkip(sprintf("HTTP/3 is not available: %s: %s", ex.err, ex.desc));
        }
        checkLimits("https://localhost:" + tls_port, {"protocol": "h3"}, "HTTP/3");
    }

    restClientIoTest() {
        # a compressed JSON response is decoded and deserialized
        foreach string coding in (keys TestHandler::Encoders) {
            RestClientIo rest({"url": getUrl()});
            assertEq(TestHandler::Document, rest.restGet("/json/" + coding).body, coding);
            assertEq(TestHandler::Document, rest.restDoRequestAsync("GET", "/json/" + coding).get().body, coding);
        }

        # the option limits the response body
        RestClientIo rest({"url": getUrl(), "max_response_body_size": Limit});
        assertThrows("HTTP-CLIENT-RESPONSE-BODY-TOO-LARGE", NOTHING, \rest.restGet(), "/sized/" + (Limit * 64));
        assertThrows("HTTP-CLIENT-RESPONSE-BODY-TOO-LARGE", NOTHING, \rest.restGet(), "/bomb/" + (Limit * 16));
        assertEq(TestHandler::Document, rest.restGet("/json/gzip").body);
    }

    connectionTest() {
        RestConnection conn("test", "test", getUrl(), NOTHING, {"max_response_body_size": Limit});
        # the synchronous client
        RestClient rest = conn.get(False);
        assertEq(Limit, rest.getMaxResponseBodySize());
        assertThrows("HTTP-CLIENT-RESPONSE-BODY-TOO-LARGE", NOTHING, \rest.get(), "/sized/" + (Limit * 64));
        # the asynchronous client
        RestClientIo rest_io = conn.getAsync(False);
        assertThrows("HTTP-CLIENT-RESPONSE-BODY-TOO-LARGE", NOTHING, \rest_io.restGet(), "/sized/" + (Limit * 64));
        assertEq(10, rest_io.restGet("/sized/10").body.size());
    }
}
