#! the code of the borrower
const BorrowerCode = "%modern
%requires HttpClientIo
%requires ConnectionProvider
#! the top-level code of a parsed Program is not run, so the global has no initial value
our hash<auto> state;
#! calls a state-changing or secret-giving method of the lent manager; returns what happened
string sub change(HttpClientConnectionManager mgr, string what) {
    try {
        switch (what) {
            case \"setLogger\": mgr.setLogger(); break;
            case \"setFirstConnectionCallback\": mgr.setFirstConnectionCallback(sub () { ++state.called; }); break;
            case \"setConnectTimeout\": mgr.setConnectTimeout(1ms); break;
            case \"setRequestTimeout\": mgr.setRequestTimeout(1ms); break;
            case \"getCookieJar\": mgr.getCookieJar(); break;
            case \"getProxyAuthenticator\": mgr.getProxyAuthenticator(); break;
            case \"processProxyConnectFailure\": mgr.processProxyConnectFailure(\"http://127.0.0.1\", {}); break;
            default: throw \"UNKNOWN\", what;
        }
        return \"done\";
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
}
#! the number of calls of the callback that the borrower set
int sub getCalled() {
    return state.called ?? 0;
}
#! gets an async connection object from a connection that the host lent; returns what happened
string sub getAsyncOnly(AbstractConnection conn) {
    try {
        return conn.getAsync(False).className();
    } catch (hash<ExceptionInfo> ex) {
        return ex.err + \": \" + ex.desc;
    }
}
#! a restricted borrower that owns its manager uses all of the methods; returns what happened
string sub own(string url) {
    try {
        HttpClientConnectionManager m(<HttpClientConnectionManagerOptions>{\"protocol\": \"auto\", \"accept_all_certs\": True});
        m.setLogger();
        m.setFirstConnectionCallback(sub () { ++state.called; });
        m.setConnectTimeout(5s);
        m.setRequestTimeout(5s);
        m.getCookieJar();
        m.getProxyAuthenticator();
        m.processProxyConnectFailure(url, {});
        m.requestAsync(url, \"GET\", \"/ok\").get(20s);
        m.closeAll();
        return \"done\";
    } catch (hash<ExceptionInfo> ex) {
        return ex.err + \": \" + ex.desc;
    }
}
#! gets an async connection object from a connection that the host lent, makes a request with it; returns what
#! happened
string sub getAsyncOf(AbstractConnection conn, string url) {
    try {
        object o = conn.getAsync(False);
        if (o instanceof HttpClientConnectionManager) {
            cast<HttpClientConnectionManager>(o).requestAsync(url, \"GET\", \"/ok\").get(20s);
        } else {
            call_object_method(o, \"restGetAsync\", \"/ok\").get(20s);
        }
        return o.className();
    } catch (hash<ExceptionInfo> ex) {
        return ex.err + \": \" + ex.desc;
    }
}
";

#! answers each request with 200; a request for /hold waits until the test releases it
class HoldHandler inherits AbstractHttpRequestHandler {
    public {
        Queue held();
        Queue release();
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        if (cx.url.path == "hold") {
            held.push(True);
            release.get(HangGuard);
        }
        return <HttpResponseInfo>{"code": 200, "hdr": {"Content-Type": "text/plain"}, "body": "ok " + cx.url.path};
    }
}
class HttpClientIoManagerConfigNonOwnerTest inherits QUnit::Test {
    constructor() : QUnit::Test("lent manager: the borrower cannot change its options or take its secrets", "1.0",
            \ARGV) {
        addTestCase("the options, the logger, the callback and the secrets are refused", \refusedTest());
        addTestCase("a restricted borrower that owns its manager uses them", \borrowerOwnerTest());
        addTestCase("the code that owns the manager uses them", \ownerTest());
        addTestCase("connections that the host lends give the borrower an async object", \connectionProviderTest());
        set_return_value(main());
    }

    #! returns a server, its handler and its URL
    private hash<auto> startServer() {
        HoldHandler handler();
        HttpServer server(<HttpServerOptionInfo>{});
        server.setDefaultHandler("hold", handler);
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        server.waitForAsyncIo();
        return {
            "server": server,
            "handler": handler,
            "port": port,
            "url": sprintf("http://127.0.0.1:%d", port),
        };
    }

    #! a manager that the host creates and lends
    private HttpClientConnectionManager getManager() {
        return new HttpClientConnectionManager(<HttpClientConnectionManagerOptions>{
            "protocol": "h1",
            "max_request_retries": 0,
            "connect_timeout": 7s,
            "request_timeout": HangGuard,
        });
    }

    #! a sandboxed borrower that may reach the server
    private Program getBorrower(int port) {
        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        SandboxManager sm();
        sm.setNetworkDefaultPolicy(False);
        sm.addNetworkAllowedIPRange("127.0.0.1/32");
        sm.addNetworkAllowedPort(port);
        p.setSandboxManager(sm);
        p.parse(BorrowerCode, "borrower");
        return p;
    }

    #! a borrower that the parse options restrict from the NETWORK domain: a connection that the host lends to it makes
    #! its client or manager with the proof of the host (qore#7262)
    private Program getNoNetworkBorrower() {
        Program p(PO_NO_NETWORK | PO_NO_CHILD_PO_RESTRICTIONS);
        SandboxManager sm();
        p.setSandboxManager(sm);
        p.parse(BorrowerCode, "borrower-nn");
        return p;
    }

    refusedTest() {
        hash<auto> srv = startServer();
        on_exit srv.server.stop();
        HttpClientConnectionManager mgr = getManager();
        on_exit mgr.closeAll();
        Program p = getBorrower(srv.port);
        foreach string what in ("setLogger", "setFirstConnectionCallback", "setConnectTimeout", "setRequestTimeout",
                "getCookieJar", "getProxyAuthenticator", "processProxyConnectFailure") {
            assertEq("PERMISSION-DENIED", p.callFunction("change", mgr, what), what);
        }
        # the options of the host are unchanged
        assertEq(7000, mgr.getConnectTimeout(), "the connect timeout of the host");
        assertEq(get_duration_milliseconds(HangGuard), mgr.getRequestTimeout(), "the request timeout of the host");
        # the host's first connection does not run the borrower's callback
        HttpClientStreamHandle sh = mgr.acquireStream(srv.url);
        assertEq(200, sh.submitAsync("GET", "/ok").future.get(HangGuard).status_code, "the host's request");
        assertEq(0, p.callFunction("getCalled"), "the callback of the borrower was not called");
    }

    borrowerOwnerTest() {
        hash<auto> srv = startServer();
        on_exit srv.server.stop();
        Program p = getBorrower(srv.port);
        assertEq("done", p.callFunction("own", srv.url), "the borrower's own manager");
    }

    ownerTest() {
        hash<auto> srv = startServer();
        on_exit srv.server.stop();
        HttpClientConnectionManager mgr = getManager();
        on_exit mgr.closeAll();
        mgr.setLogger();
        int called = 0;
        mgr.setFirstConnectionCallback(sub () { ++called; });
        mgr.setConnectTimeout(9s);
        mgr.setRequestTimeout(HangGuard);
        assertEq(9000, mgr.getConnectTimeout(), "the owner's connect timeout");
        mgr.getCookieJar();
        mgr.getProxyAuthenticator();
        HttpClientStreamHandle sh = mgr.acquireStream(srv.url);
        assertEq(200, sh.submitAsync("GET", "/ok").future.get(HangGuard).status_code, "the owner's request");
        assertEq(1, called, "the owner's callback was called by the first connection");
    }

    connectionProviderTest() {
        hash<auto> srv = startServer();
        on_exit srv.server.stop();
        Program p = getBorrower(srv.port);
        # a connection of the host that is lent to restricted code: its getAsync() makes the manager or the client for
        # the borrower with the proof of the host, and sets the callback that marks the connection up
        ConnectionProvider::HttpConnection http("http-conn", "", srv.url);
        assertEq("HttpClientConnectionManager", p.callFunction("getAsyncOf", http, srv.url), "an HTTP connection");
        # the first connection of the object marked the connection up with the callback that getAsync() set
        assertTrue(http.up, "the HTTP connection is up");
        RestClient::RestConnection rest("rest-conn", "", srv.url, {}, {"data": "text"});
        assertEq("RestClientIo", p.callFunction("getAsyncOf", rest, srv.url), "a REST connection");
        assertTrue(rest.up, "the REST connection is up");

        # the same for a borrower that the parse options restrict from the network: getAsync() gives it the client or
        # the manager of the host's proof, which does not mean that it can use it: it sets the callback with it
        Program nn = getNoNetworkBorrower();
        ConnectionProvider::HttpConnection http2("http-conn-2", "", srv.url);
        assertEq("HttpClientConnectionManager", nn.callFunction("getAsyncOnly", http2),
            "an HTTP connection of a borrower that is restricted from the network");
        RestClient::RestConnection rest2("rest-conn-2", "", srv.url, {}, {"data": "text"});
        assertEq("RestClientIo", nn.callFunction("getAsyncOnly", rest2),
            "a REST connection of a borrower that is restricted from the network");
    }
}
