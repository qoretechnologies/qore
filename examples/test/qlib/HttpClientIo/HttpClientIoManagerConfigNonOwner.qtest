#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - pooled HTTP/1.1 and HTTP/2 client connections over TCP and TLS, closed and leased by other code
# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires HttpClientIo
%requires RestClientIo
%requires RestClient
%requires ConnectionProvider
%requires HttpServer
%requires HttpServerUtil

%exec-class HttpClientIoManagerConfigNonOwnerTest

#! A sandboxed borrower of a connection manager that other code shares cannot change its options, logger and callback, or
#! take its cookie jar and proxy credentials (qore#7830)
/** The manager's methods that set its logger, its first connection callback and its timeouts, or that give its cookie
    jar and its proxy authenticator, or that change the proxy authentication, are refused for code that a sandbox
    restricts and that does not own the manager (PERMISSION-DENIED), as the methods that lease, pin, acquire or close
    connections are (qore#7570, qore#7813, qore#7828): the host's requests use them, the logger would receive the host's
    log messages, the callback would run on the host's connections, and the cookies and the proxy credentials are the
    host's secrets.  The restricted code that owns its manager, the owner, and the connections that restricted code
    that was lent them gets an object from with getAsync() work as before.
*/

#! a hang guard only, never a timing assertion
const HangGuard = 20s;

