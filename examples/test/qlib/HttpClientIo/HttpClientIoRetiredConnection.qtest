    FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
    DEALINGS IN THE SOFTWARE.

    A connection that the server closes is retired by the connection manager while the manager is held by the
    request that is running; the retired connection, its poll operation, and the manager it refers back to must be
    collected.  The connection was taken out of the manager's pool while the manager's scan was deferred, and the
    garbage cycle that was left was never rechecked, so the manager, all of its connections, and everything they
    referenced leaked.
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires Mime
%requires Logger
%requires HttpServerUtil
%requires HttpServer
%requires HttpClientIo

%exec-class HttpClientIoRetiredConnectionTest

#! Returns a small body; with "/close" the server closes the connection after the response
class TestHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        hash<auto> rhdr = {"Content-Type": MimeTypeText};
        if (hdr.path == "close") {
            rhdr.Connection = "close";
        }
        return <HttpResponseInfo>{"code": 200, "hdr": rhdr, "body": "ok"};
    }
}

#! A connection manager that reports its destruction
class ObservedManager inherits HttpClientConnectionManager {
    public {
        static Queue destroyed();
    }

    constructor() : HttpClientConnectionManager(<HttpClientConnectionManagerOptions>{}) {
    }

    destructor() {
        destroyed.push(True);
    }
}

public class HttpClientIoRetiredConnectionTest inherits QUnit::Test {
    private {
        HttpServer server;
        string url;
    }

    constructor() : Test("HttpClientIoRetiredConnectionTest", "1.0") {
        addTestCase("retired connection is collected", \retiredConnectionTest());
        set_return_value(main());
    }

    globalSetUp() {
        server = new HttpServer(<HttpServerOptionInfo>{
            "logger": new Logger("server", LoggerLevel::getLevelError()),
        });
        TestHandler handler();
        server.setHandler("test", "", NOTHING, handler);
        server.setDefaultHandler("test", handler);
        url = "http://localhost:" + server.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
    }

    globalTearDown() {
        delete server;
    }

    retiredConnectionTest() {
        {
            ObservedManager mgr();
            # the server closes this connection, which the manager retires
            assertEq("ok", mgr.request(url, "GET", "/close").body);
            # the next request needs a new connection
            assertEq("ok", mgr.request(url, "GET", "/other").body);
            # the connections in the pool are closed, so that only the retired connection could keep the manager
            # alive
            mgr.closeAll();
        }
        # the manager is destroyed when its last reference is released, which can be on the worker thread that
        # handles the close; its retired connection, which refers back to it, must not keep it alive
        assertEq(True, ObservedManager::destroyed.get(30s));
    }
}
