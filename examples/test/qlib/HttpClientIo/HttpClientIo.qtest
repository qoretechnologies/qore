%modern


%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Mime
%requires Logger
%requires HttpServerUtil
%requires HttpServer
%requires HttpClientIo
%requires AsyncSocketIo

%exec-class HttpClientIoTest

#! Simple handler for GET requests
class SimpleGetHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, "OK", {"Content-Type": "text/plain"});
    }
}

#! Handler that responds with "Connection: close" to force peer-initiated close
#! after the response.  Used by the EOF-close / pool-removal investigation test
#! to verify that server-initiated connection close causes the H1 client to
#! remove the connection from the pool without any new idle-timeout logic.
class CloseConnectionHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, "OK", {
            "Content-Type": "text/plain",
            "Connection": "close",
        });
    }
}

#! Handler that returns a large response body
class LargeResponseHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        int size = 1000;
        *list<*string> m = (hdr.path =~ x/large\/(\d+)/);
        if (m) {
            size = int(m[0]);
        }
        return makeResponse(200, strmul("X", size), {"Content-Type": "text/plain"});
    }
}

#! Echo handler that returns the request body and method
class EchoHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        string resp_body = sprintf("method=%s path=%s", hdr.method, hdr.path);
        if (body) {
            if (body.typeCode() == NT_BINARY) {
                resp_body += sprintf(" body_size=%d body=%s", body.size(), body.toString());
            } else {
                resp_body += sprintf(" body_size=%d body=%s", body.length(), body);
            }
        }
        return makeResponse(200, resp_body, {"Content-Type": "text/plain"});
    }
}

#! Handler that delays before responding
class SlowHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        int delay_ms = 100;
        *list<*string> m = (hdr.path =~ x/slow\/(\d+)/);
        if (m) {
            delay_ms = int(m[0]);
        }
        usleep(delay_ms * 1000);
        return makeResponse(200, sprintf("delayed %d ms", delay_ms), {"Content-Type": "text/plain"});
    }
}

#! Handler that returns an error
class ErrorHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        int code = 500;
        *list<*string> m = (hdr.path =~ x/error\/(\d+)/);
        if (m) {
            code = int(m[0]);
        }
        return makeResponse(code, sprintf("Error %d", code), {"Content-Type": "text/plain"});
    }
}

#! Handler that returns a streaming InputStream response
class StreamingHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        # Build a payload in 3 chunks: "chunk1|chunk2|chunk3"
        string payload = "chunk1|chunk2|chunk3";
        return <HttpResponseInfo>{
            "code": 200,
            "body": new StringInputStream(payload),
            "hdr": {
                "Content-Type": "text/plain",
                "Content-Length": string(payload.size()),
            },
        };
    }
}

#! Handler that supports HTTP/2 bidirectional streaming
/** Overrides the 5-arg handleRequest to get direct socket access for
    incremental body reading and response streaming.
*/
class BidiEchoHandler inherits AbstractHttpRequestHandler {
    bool wantsBodyStreaming(hash<auto> cx, hash<auto> hdr) {
        return hdr."content-type" == "application/x-bidi-test";
    }

    hash<HttpResponseInfo> handleRequest(HttpListenerInterface listener,
            Socket s, hash<auto> cx, hash<auto> hdr, *data body) {
        if (!cx."header-info".body_streaming) {
            return makeResponse(200, body ?? "no body");
        }
        int stream_id = cx."header-info".stream_id;
        *code<nothing()> io_wake = cx."header-info".io_wake;
        *code<nothing(Queue)> register_body_queue = cx."header-info".register_body_queue;

        # Send response headers (no END_STREAM yet) via the async write path.
        # The I/O thread flushes via io_wake() — no handler-thread H2 lock hold.
        s.submitHttp2StreamingResponseHeaders(stream_id, 200,
            {"content-type": "application/octet-stream"});
        if (io_wake) {
            io_wake();
        }

        # Drain inbound DATA via the I/O thread's Queue (NOTHING sentinel
        # signals END_STREAM) and echo each chunk back as a DATA frame.
        Queue body_queue(-1);
        register_body_queue(body_queue);
        while (True) {
            auto chunk;
            try {
                chunk = body_queue.get(5s);
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err == "QUEUE-TIMEOUT") {
                    break;
                }
                rethrow;
            }
            if (!(chunk instanceof binary)) {
                break;
            }
            s.sendHttp2StreamData(stream_id, chunk);
            if (io_wake) {
                io_wake();
            }
        }
        # Send END_STREAM on response
        s.sendHttp2StreamData(stream_id, NOTHING, True);
        if (io_wake) {
            io_wake();
        }

        # Mark response as sent — framework will call setDedicatedExternal()
        cx."response-sent" = True;
        return <HttpResponseInfo>{"code": 200, "body": ""};
    }
}

#! Handler that tracks received notifications via a Counter (decrements toward zero)
class NotificationTrackingHandler inherits AbstractHttpRequestHandler {
    private {
        Counter cnt;
    }

    constructor(Counter cnt) {
        self.cnt = cnt;
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        cnt.dec();
        return makeResponse(202, "", {"Content-Type": "text/plain"});
    }
}

#! Raw-socket HTTP/1.1 server that echoes each chunked request-body chunk back
#! as a response chunk *immediately* — before the request body ends.
/** This is genuine full-duplex chunked transfer: the server sends the response
    status line + headers as soon as the request headers arrive, then for every
    request-body chunk it receives it writes a response-body chunk back right
    away.  A half-duplex client (which only starts reading the response after
    it has half-closed the request body) can never observe the reply and will
    hang — this server is the acceptance gate for restored HTTP/1.1 full-duplex
    streaming.
*/
class FullDuplexEchoRawServer {
    public {
        #! Marker written as the final response chunk before the 0-terminator
        const FinalMarker = "SERVER-DONE";
    }

    private {
        Socket listener();
        int port;
        Counter done(1);
        *string server_error;
    }

    constructor() {
        listener.bind("localhost:0");
        listener.listen(1);
        port = listener.getSocketInfo().port;
    }

    int getPort() {
        return port;
    }

    string getUrl() {
        return sprintf("http://localhost:%d", port);
    }

    start() {
        background acceptAndServe();
    }

    wait(timeout to = 30s) {
        done.waitForZero(to);
    }

    *string getServerError() {
        return server_error;
    }

    #! Reads a single CRLF-terminated line (returned without the trailing CRLF)
    private string readLine(Socket client, timeout to = 15s) {
        string str = "";
        while (True) {
            int c = client.recvu1(to);
            if (c == 10) {  # LF
                break;
            }
            if (c != 13) {  # skip CR
                str += chr(c);
            }
        }
        return str;
    }

    private acceptAndServe() {
        on_exit done.dec();
        try {
            Socket client = listener.accept(15s);
            serveClient(client);
            client.close();
        } catch (hash<ExceptionInfo> ex) {
            server_error = sprintf("%s: %s", ex.err, ex.desc);
        }
    }

    private serveClient(Socket client) {
        # Read the request header block (request line + headers) up to the
        # blank line.  We deliberately do NOT read the request body first.
        while (True) {
            string line = readLine(client);
            if (line == "") {
                break;
            }
        }

        # Send response status + headers immediately (chunked, still open).
        client.send("HTTP/1.1 200 OK\r\n"
            "Content-Type: application/octet-stream\r\n"
            "Transfer-Encoding: chunked\r\n"
            "\r\n");

        # Echo each request-body chunk back as a response chunk as soon as it
        # arrives — full-duplex, before the client half-closes the request.
        while (True) {
            string size_line = readLine(client);
            trim size_line;
            int chunk_size = size_line.toInt(16);
            if (chunk_size == 0) {
                # Terminal chunk: consume the trailing CRLF line, then send a
                # final marker chunk and close the response body.
                readLine(client);  # empty line after "0"
                sendChunk(client, FinalMarker);
                client.send("0\r\n\r\n");
                break;
            }
            binary chunk = client.recvBinary(chunk_size, 15s);
            client.recvBinary(2, 15s);  # trailing CRLF after chunk data
            # Echo it straight back as a response chunk (mid-request reply).
            sendChunk(client, chunk);
        }
    }

    private sendChunk(Socket client, data payload) {
        binary b = payload instanceof binary ? payload : binary(payload);
        client.send(sprintf("%x\r\n", b.size()));
        client.send(b);
        client.send("\r\n");
    }
}

