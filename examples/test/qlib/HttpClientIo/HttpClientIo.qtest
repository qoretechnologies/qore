            "non-controller mode request should timeout");
    }

    # ---- Concurrent closeAll Test ----

    testCloseAllDuringRequests() {
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h2",
            "logger": mLogger,
        });

        # Start several concurrent slow requests via background threads
        Counter counter(3);
        list<hash<auto>> results = ();
        Mutex results_lock();

        code make_request = sub () {
            hash<auto> result;
            try {
                hash<auto> resp = mgr.request(mSslUrl, "GET", "/slow/3000", NOTHING, NOTHING, 10s);
                result = {"status": "ok", "code": resp.status_code};
            } catch (hash<ExceptionInfo> ex) {
                result = {"status": "error", "err": ex.err};
            }
            {
                AutoLock al(results_lock);
                push results, result;
            }
            counter.dec();
        };

        background make_request();
        background make_request();
        background make_request();

        # Give threads a moment to start and submit requests
        usleep(200000);

        # Close all connections while requests are in flight
        mgr.closeAll();

        # Wait for all threads to complete
        int rc = counter.waitForZero(15s);
        assertEq(0, rc, "all background threads should complete");
        assertEq(3, results.size(), "should have 3 results");

        # Each thread should have either completed or gotten an error — no hangs
        foreach hash<auto> r in (results) {
            assertTrue(r.status == "ok" || r.status == "error",
                sprintf("thread result should be ok or error, got: %y", r));
        }
    }

    # ---- Pool Creates Second Connection Test ----

    testPoolCreatesSecondConnection() {
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h2",
            "max_connections_per_host": 2,
            "max_streams_per_connection": 1,
            "logger": mLogger,
        });

        # Use concurrent mgr.request() calls from background threads.
        # Each call acquires a stream and submits; with max_streams=1,
        # the second request should get a second connection.
        Counter counter(2);
        bool signaled1 = False;
        bool signaled2 = False;
        *hash<auto> resp1;
        *hash<auto> resp2;

        background sub () {
            try {
                resp1 = mgr.request(mSslUrl, "GET", "/slow/500");
            } catch (hash<ExceptionInfo> ex) {
                resp1 = {"status_code": -1, "err": ex.err, "desc": ex.desc};
            }
            if (!signaled1) {
                signaled1 = True;
                counter.dec();
            }
        }();

        # Small delay so first request starts first and occupies the first connection
        usleep(100000);

        background sub () {
            try {
                resp2 = mgr.request(mSslUrl, "GET", "/slow/500");
            } catch (hash<ExceptionInfo> ex) {
                resp2 = {"status_code": -1, "err": ex.err, "desc": ex.desc};
            }
            if (!signaled2) {
                signaled2 = True;
                counter.dec();
            }
        }();

        int rc = counter.waitForZero(15s);
        assertEq(0, rc, "both requests should complete");

        # Both should have succeeded (on separate connections since max_streams=1)
        assertEq(200, resp1.status_code,
            sprintf("first request should succeed: %y", resp1));
        assertEq(200, resp2.status_code,
            sprintf("second request should succeed: %y", resp2));

        # Verify 2 connections were created
        hash<auto> stats = mgr.getStats();
        assertEq(2, stats.total_connections,
            "pool should have created 2 connections (max_streams=1)");
    }

    # ---- Cancel Callback Verification ----

    testCancelCallbackInvoked() {
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h2",
            "logger": mLogger,
        });

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(mSslUrl);
        HttpClientIo::HttpClientConnection conn = stream.getConnection();

        # Wait for connection to become ready
        assertTrue(conn.waitForReady(30s), "connection should become ready");

        # Submit async request to slow handler
        hash<auto> result = stream.submitAsync("GET", "/slow/5000");

        # Cancel — the PromiseAction's executeError fires with cancellation error
        stream.cancel();

        # Verify the Future was rejected with a cancellation error
        assertTrue(result.future.isDone(), "cancelled Future should be done");
        assertTrue(result.future.isError(), "cancelled Future should be error");
        try {
            result.future.get(0);
            assertTrue(False, "should have thrown");
        } catch (hash<ExceptionInfo> ex) {
            assertTrue(ex.err == "HTTP2-CANCELLED"
                || ex.err == "HTTP3-CANCELLED"
                || ex.err == "HTTPCLIENT-CANCELLED",
                sprintf("expected cancellation error, got: %y", ex.err));
        }
    }

    # ---- Connection Draining Test ----

    testConnectionDraining() {
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h2",
            "max_connections_per_host": 2,
            "logger": mLogger,
        });

        # Make a request to establish a connection
        hash<auto> resp = mgr.request(mSslUrl, "GET", "/simple");
        assertEq(200, resp.status_code, "initial request");

        hash<auto> stats = mgr.getStats();
        assertEq(1, stats.total_connections, "one connection exists");
        assertEq(1, stats.total_usable_connections, "one usable connection exists");

        # Get the connection and set it to draining
        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(mSslUrl);
        HttpClientIo::HttpClientConnection conn = stream.getConnection();
        conn.setDraining();

        assertTrue(conn.isDraining(), "connection should be draining");

        # Next acquireStream should create a new connection (draining is skipped)
        HttpClientIo::HttpClientStreamHandle stream2 = mgr.acquireStream(mSslUrl);
        hash<auto> resp2 = stream2.request("GET", "/simple");
        assertEq(200, resp2.status_code, "request on new connection");

        stats = mgr.getStats();
        assertEq(2, stats.total_connections, "second connection created because first is draining");
        assertEq(1, stats.total_usable_connections, "only the non-draining connection is usable");
    }

    # ---- Bidi Streaming Race Condition Tests ----

    testH2BidiSendAfterServerClose() {
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h2",
            "logger": mLogger,
        });
        on_exit {
            mgr.closeAll();
        }

        # Run multiple iterations to exercise the race window between stream
        # removal from callbacks and state transition to Complete
        for (int i = 0; i < 20; ++i) {
            HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(mSslUrl);
            HttpClientIo::Http2ClientStreamHandle h2stream =
                cast<HttpClientIo::Http2ClientStreamHandle>(stream);

            # Start bidirectional streaming (body_streaming=True keeps client send side open)
            h2stream.startStreaming("POST", "/simple", NOTHING, True);

            # Send END_STREAM immediately — the server's body buffering loop needs this
            # before it can dispatch to the handler. This tests the race window between
            # stream removal from callbacks and state transition to Complete.
            try {
                h2stream.sendData(binary(), True);
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err == "HTTP2-STREAM-ERROR") {
                    fail(sprintf("iteration %d: HTTP2-STREAM-ERROR on send: %s - "
                        "race condition between stream removal and state update",
                        i, ex.desc));
                }
                # HTTPCLIENT-STATE-ERROR is acceptable (state already Complete)
            }

            # Read the server's response and end_stream marker
            date end_time = now_us() + 10s;
            while (now_us() < end_time) {
                auto data = h2stream.readData(5s);
                if (!exists data) {
                    continue;
                }
                if (data.typeCode() == NT_HASH && data.end_stream) {
                    break;
                }
                if (data.typeCode() == NT_HASH && data.error) {
                    break;
                }
            }

            assertTrue(h2stream.isDone(), sprintf("iteration %d: stream should be done", i));
        }
    }

    testH2BidiEchoStreaming() {
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h2",
            "logger": mLogger,
        });
        on_exit {
            mgr.closeAll();
        }

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(mSslUrl);
        HttpClientIo::Http2ClientStreamHandle h2stream =
            cast<HttpClientIo::Http2ClientStreamHandle>(stream);

        # Start bidirectional streaming with the bidi-test content type
        h2stream.startStreaming("POST", "/bidi",
            {"content-type": "application/x-bidi-test"}, True);

        # Send 3 chunks and collect echoed data
        list<binary> sent_chunks = ();
        binary all_received = binary();

        for (int i = 0; i < 3; ++i) {
            binary chunk = binary(sprintf("chunk-%d", i));
            sent_chunks += chunk;
            h2stream.sendData(chunk);
        }
        # Send END_STREAM to signal end of request body
        h2stream.sendData(binary(), True);

        # Read all echoed data until end_stream
        date end_time = now_us() + 10s;
        bool got_end_stream = False;
        while (now_us() < end_time) {
            auto rdata = h2stream.readData(5s);
            if (!exists rdata) {
                continue;
            }
            if (rdata.typeCode() == NT_HASH) {
                if (rdata.end_stream) {
                    got_end_stream = True;
                    break;
                }
                if (rdata.error) {
                    fail(sprintf("unexpected error: %y", rdata));
                    break;
                }
            } else if (rdata.typeCode() == NT_BINARY) {
                all_received += rdata;
            }
        }

        assertTrue(got_end_stream, "server should send END_STREAM");
        assertTrue(h2stream.isDone(), "stream should be done");

        # Verify all sent data was echoed back
        binary all_sent = binary();
        map all_sent += $1, sent_chunks;
        assertEq(all_sent, all_received, "echoed data should match sent data");
    }

    #! Verifies HTTP/1.1 chunked-transfer request-body streaming.
    /** The H1 conn-mgr forces protocol "h1".  startStreaming is called
        with body_streaming=True; the request goes out with
        Transfer-Encoding: chunked and the body is fed via sendData()
        in chunks.  The server's EchoHandler reads the full chunked
        body and echoes it back; the client reads the response via
        readData() until end_stream.

        Proves that the previously-stubbed sendData() path (which
        threw HTTP1-STREAMING-ERROR before this fix) now works for
        DataStream-style chunked-body protocols.

        @since %Qore 3.0
    */
    testH1BidiStreamingChunkedEcho() {
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "protocol": "h1",
            "logger": mLogger,
        });
        on_exit mgr.closeAll();

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(mHttpUrl);
        HttpClientIo::Http1ClientStreamHandle h1stream =
            cast<HttpClientIo::Http1ClientStreamHandle>(stream);

        # Start chunked-body streaming POST to the EchoHandler
        h1stream.startStreaming("POST", "/echo",
            {"content-type": "application/octet-stream"},
            True);  # body_streaming=True

        # Send 3 distinct chunks
        list<binary> sent_chunks = (binary("alpha-"), binary("beta--"), binary("gamma!"));
        binary expected_payload = binary();
        foreach binary chunk in (sent_chunks) {
            h1stream.sendData(chunk);
            expected_payload += chunk;
        }
        # Half-close the request body
        h1stream.sendData(binary(), True);

        # Drain the response
        binary received_body = binary();
        bool got_end_stream = False;
        date deadline = now_us() + 10s;
        while (now_us() < deadline) {
            auto rdata = h1stream.readData(2s);
            if (!exists rdata) {
                continue;
            }
            if (rdata.typeCode() == NT_HASH) {
                if (rdata.error) {
                    fail(sprintf("unexpected error frame: %y", rdata));
                    break;
                }
                if (rdata.end_stream) {
                    got_end_stream = True;
                    break;
                }
            } else if (rdata.typeCode() == NT_BINARY) {
                received_body += rdata;
            } else if (rdata.typeCode() == NT_STRING) {
                received_body += binary(rdata);
            }
        }
        assertTrue(got_end_stream, "must receive end_stream from server");

        # EchoHandler echoes "method=POST path=<...>echo body_size=N body=<payload>".
        # The exact prefix shape is owned by EchoHandler — assert that the
        # full chunked payload (18 bytes from the three sent chunks) made it
        # server-side intact and was echoed back unchanged.
        string body_text = received_body.toString();
        assertEq(True, body_text =~ /method=POST/,
            sprintf("response method mismatch: %y", body_text));
        assertEq(True, body_text =~ /body_size=18/,
            sprintf("server saw wrong body size: %y", body_text));
        assertEq(True, body_text =~ /body=alpha-beta--gamma!$/,
            sprintf("echoed payload mismatch: %y", body_text));
    }

    #! Verifies HTTP/1.1 full-duplex chunked streaming (read-your-writes).
    /** Regression test for the Qore 3 HttpClientIo rewrite, which made the
        HTTP/1.1 client poll op half-duplex: it would not read the response
        until the chunked request body was fully sent (writesDone), deadlocking
        any protocol that needs a mid-request reply (Qorus DataStream /
        RemoteSqlSession).

        Drives a genuine full-duplex server (@ref FullDuplexEchoRawServer) that
        echoes each request-body chunk back as a response chunk immediately.
        The client sends a chunk, then — WITHOUT calling writesDone() — reads
        the echoed reply.  Before the fix this hangs (readData times out);
        after the fix the reply arrives while the request body is still open.

        @since %Qore 3.0
    */
    testH1FullDuplexStreaming() {
        FullDuplexEchoRawServer server();
        server.start();
        on_exit server.wait();

        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "protocol": "h1",
            "logger": mLogger,
        });
        on_exit mgr.closeAll();

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(server.getUrl());
        HttpClientIo::Http1ClientStreamHandle h1stream =
            cast<HttpClientIo::Http1ClientStreamHandle>(stream);

        # Start chunked-body streaming; the request body stays open (no writesDone yet)
        h1stream.startStreaming("POST", "/fullduplex",
            {"content-type": "application/x-fullduplex"}, True);  # body_streaming=True

        # Send two request chunks, reading the mid-request reply after each one
        # WITHOUT half-closing the request body.  This is the full-duplex proof.
        list<binary> sent = (binary("first-command-frame"), binary("second-command-frame"));
        foreach binary chunk in (sent) {
            h1stream.sendData(chunk);
            *binary reply = readBodyUntil(h1stream, chunk, 10s);
            assertEq(chunk, reply,
                sprintf("must receive the echoed reply for %y while the request "
                    "body is still open (full-duplex)", chunk.toString()));
        }

        # Now half-close the request body; the server sends its final marker + end_stream
        h1stream.sendData(binary(), True);

        *binary marker = readBodyUntil(h1stream, binary(FullDuplexEchoRawServer::FinalMarker), 10s);
        assertEq(FullDuplexEchoRawServer::FinalMarker, marker.toString(),
            "must receive the server's final marker chunk after writesDone");

        # Drain to end_stream
        bool got_end_stream = False;
        date deadline = now_us() + 10s;
        while (now_us() < deadline) {
            auto rdata = h1stream.readData(1s);
            if (!exists rdata) {
                continue;
            }
            if (rdata.typeCode() == NT_HASH && rdata.end_stream) {
                got_end_stream = True;
                break;
            }
        }
        assertTrue(got_end_stream, "must receive end_stream after the response completes");

        assertNothing(server.getServerError());
    }

    #! Reads streaming body frames until the accumulated body equals @a needle,
    #! then returns the matching bytes; returns NOTHING on timeout.
    private *binary readBodyUntil(HttpClientIo::Http1ClientStreamHandle h1stream,
            binary needle, timeout total) {
        binary acc = binary();
        date deadline = now_us() + total;
        while (now_us() < deadline) {
            auto rdata = h1stream.readData(500ms);
            if (!exists rdata) {
                continue;
            }
            switch (rdata.typeCode()) {
                case NT_BINARY:
                    acc += rdata;
                    break;
                case NT_STRING:
                    acc += binary(rdata);
                    break;
                case NT_HASH:
                    if (rdata.error) {
                        throw "FULL-DUPLEX-ERROR", sprintf("unexpected error frame: %y", rdata);
                    }
                    # headers-only / end_stream frames carry no body — ignore
                    break;
            }
            if (acc == needle) {
                return acc;
            }
        }
        return NOTHING;
    }

    #! Calling sendData() on a stream that wasn't started with body_streaming=True
    #! must raise HTTPCLIENT-STATE-ERROR.
    testH1BidiSendDataWithoutBodyStreaming() {
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "protocol": "h1",
            "logger": mLogger,
        });
        on_exit mgr.closeAll();

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(mHttpUrl);
        HttpClientIo::Http1ClientStreamHandle h1stream =
            cast<HttpClientIo::Http1ClientStreamHandle>(stream);

        # Response-only streaming (default body_streaming=False)
        h1stream.startStreaming("GET", "/streaming");
        assertThrows("HTTPCLIENT-STATE-ERROR", "body_streaming",
            sub () { h1stream.sendData(binary("X")); });

        # half-close on non-body-streaming is a no-op (idempotent)
        h1stream.sendData(binary(), True);
    }

    #! Calling startStreaming(body_streaming=True) with a non-empty body
    #! must raise HTTPCLIENT-STATE-ERROR (body bytes must come from sendData).
    testH1BidiStreamingBodyConflictRejected() {
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "protocol": "h1",
            "logger": mLogger,
        });
        on_exit mgr.closeAll();

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(mHttpUrl);
        HttpClientIo::Http1ClientStreamHandle h1stream =
            cast<HttpClientIo::Http1ClientStreamHandle>(stream);

        assertThrows("HTTPCLIENT-STATE-ERROR", "body_streaming=True is incompatible",
            sub () {
                h1stream.startStreaming("POST", "/echo", NOTHING, True, "non-empty");
            });
    }

    testH3StreamingBasic() {
        if (!mQuicUrl) {
            testSkip("QUIC not available");
        }

        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h3",
            "connect_timeout": 10s,
            "request_timeout": 30s,
            "logger": mLogger,
        });
        on_exit mgr.closeAll();

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(mQuicUrl);
        assertTrue(stream instanceof HttpClientIo::Http3ClientStreamHandle,
            "H3 stream should be Http3ClientStreamHandle");

        HttpClientIo::Http3ClientStreamHandle h3stream =
            cast<HttpClientIo::Http3ClientStreamHandle>(stream);

        int stream_id = h3stream.startStreaming("GET", "/streaming",
            {"accept": "text/plain"});
        assertTrue(stream_id >= 0, "streaming stream_id should be >= 0");

        # Read all body data — same pattern as H2 streaming tests
        # readData() returns: binary (body), hash with end_stream (done), NOTHING (timeout)
        binary received = binary();
        date end_time = now_us() + 30s;
        while (now_us() < end_time) {
            auto data = h3stream.readData(5s);
            if (!exists data) {
                continue;  # timeout, retry
            }
            if (data.typeCode() == NT_HASH && data.end_stream) {
                break;  # stream complete — same sentinel as H2
            }
            if (data.typeCode() == NT_HASH && data.error) {
                fail(sprintf("streaming error: %y", data.error));
                break;
            }
            if (data.typeCode() == NT_BINARY) {
                received += data;
            }
        }

        assertTrue(h3stream.isDone(), "stream should be done after reading all data");
        assertEq("chunk1|chunk2|chunk3", received.toString(),
            "should receive full streaming payload");
    }

    testH3BidiStreaming() {
        if (!mQuicUrl) {
            testSkip("QUIC not available");
        }

        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h3",
            "connect_timeout": 10s,
            "request_timeout": 30s,
            "logger": mLogger,
        });
        on_exit mgr.closeAll();

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(mQuicUrl);
        assertTrue(stream instanceof HttpClientIo::Http3ClientStreamHandle,
            "H3 stream should be Http3ClientStreamHandle");

        HttpClientIo::Http3ClientStreamHandle h3stream =
            cast<HttpClientIo::Http3ClientStreamHandle>(stream);

        # Start bidirectional streaming (HEADERS without END_STREAM)
        int stream_id = h3stream.startStreaming("POST", "/echo",
            {"content-type": "application/octet-stream"}, True);
        assertTrue(stream_id >= 0, "bidi stream_id should be >= 0");

        # Send body data incrementally
        h3stream.sendData(binary("hello "));
        h3stream.sendData(binary("world"));
        h3stream.writesDone();  # close write side (END_STREAM)

        # Read response — server echoes the body
        binary received = binary();
        date end_time = now_us() + 30s;
        while (now_us() < end_time) {
            auto data = h3stream.readData(5s);
            if (!exists data) {
                continue;  # timeout, retry
            }
            if (data.typeCode() == NT_HASH && data.end_stream) {
                break;  # stream complete
            }
            if (data.typeCode() == NT_HASH && data.error) {
                fail(sprintf("bidi streaming error: %y", data.error));
                break;
            }
            if (data.typeCode() == NT_BINARY) {
                received += data;
            }
        }

        assertTrue(h3stream.isDone(), "bidi stream should be done after reading all data");
        # EchoHandler responds with "method=POST path=/echo body_size=11 body=hello world"
        string resp = received.toString();
        assertTrue(resp =~ /body=hello world/, sprintf("echoed response should contain body: %y", resp));
    }

    testH3StreamingStateErrors() {
        if (!mQuicUrl) {
            testSkip("QUIC not available");
        }

        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h3",
            "connect_timeout": 10s,
            "request_timeout": 10s,
            "logger": mLogger,
        });
        on_exit mgr.closeAll();

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(mQuicUrl);
        HttpClientIo::Http3ClientStreamHandle h3stream =
            cast<HttpClientIo::Http3ClientStreamHandle>(stream);

        # readData before startStreaming should throw
        assertThrows("HTTPCLIENT-STATE-ERROR", sub() { h3stream.readData(1s); });
        # sendData before startStreaming should throw
        assertThrows("HTTPCLIENT-STATE-ERROR", sub() { h3stream.sendData(binary("test")); });

        h3stream.startStreaming("GET", "/streaming");
        assertThrows("HTTPCLIENT-STATE-ERROR", "request write side is closed",
            \h3stream.sendData(), (binary("data"),),
            "sendData should reject response-only streaming requests");
        h3stream.writesDone();

        date end_time = now_us() + 10s;
        while (now_us() < end_time && !h3stream.isDone()) {
            auto data = h3stream.readData(1s);
            if (exists data && data.typeCode() == NT_HASH && data.end_stream) {
                break;
            }
        }
    }

    testH3CallbackOrdering() {
        if (!mQuicUrl) {
            testSkip("QUIC not available");
        }

        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h3",
            "connect_timeout": 10s,
            "request_timeout": 10s,
            "logger": mLogger,
        });
        on_exit mgr.closeAll();

        # Run multiple requests to exercise the callback ordering fix.
        # Before the fix, the stream was removed from callbacks before the
        # callback was invoked, creating a window where the stream handle's
        # state could be inconsistent. After the fix, removal happens after
        # the callback completes.
        for (int i = 0; i < 20; ++i) {
            hash<auto> resp = mgr.request(mQuicUrl, "GET", "/simple");
            assertEq(200, resp.status_code,
                sprintf("iteration %d: H3 response should be 200", i));
        }
    }

    testSubmitAsyncNonBlockingDeferred() {
        # Test that submitAsyncNonBlocking works when the connection isn't ready yet
        # (the deferred callWhenReady path)
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "logger": mLogger,
        });
        on_exit mgr.closeAll();

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(mSslUrl);
        hash<auto> result = stream.submitAsync("GET", "/simple");
        Future f = result.future;

        hash<auto> resp = f.get(15s);
        assertTrue(exists resp, "should have response");
        assertEq(200, resp.status_code, "async Future request should return 200");
    }

    #! Helper: creates a dedicated test server with handlers and an SSL listener
    /** Returns the server object and the HTTPS URL.
        The server has \c protect_last_listener disabled so we can stop the listener.
    */
    private hash<auto> createDedicatedServer() {
        hash<HttpServerOptionInfo> opts = <HttpServerOptionInfo>{
            "logger": mLogger,
            "debug": True,
        };
        HttpServer server(opts);
        server.setHandler("simple", "/simple", NOTHING, new SimpleGetHandler());
        server.setHandler("echo", "/echo", NOTHING, new EchoHandler());
        int port = server.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        }).port;
        server.waitForAsyncIo();
        return {
            "server": server,
            "port": port,
            "url": "https://127.0.0.1:" + port,
        };
    }

    #! Tests that the connection manager recovers from a stale HTTP/2 connection
    /** Scenario:
        1. Make a request (establishes a pooled H2 connection)
        2. Kill the server (closes all server-side sockets → client gets FIN/RST)
        3. Make another request → should succeed via retry (not time out)
    */
    testH2StaleConnectionRecovery() {
        # Create a dedicated server for this test
        hash<auto> srv = createDedicatedServer();
        HttpServer server = srv.server;
        string url = srv.url;
        int port = srv.port;

        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h2",
            "request_timeout": 5s,
            "connect_timeout": 5s,
            "logger": mLogger,
        });
        on_exit mgr.closeAll();

        # Step 1: Make a successful request to establish pooled connection
        hash<auto> resp = mgr.request(url, "GET", "/simple");
        assertEq(200, resp.status_code, "H2 stale: initial request succeeds");

        # Verify connection is pooled
        hash<auto> stats = mgr.getStats();
        assertGt(0, stats.total_connections, "H2 stale: connection pooled");

        # Step 2: Kill the server — closes all connections, sends FIN/RST
        delete server;

        # Step 3: Create a new server on the same port
        hash<HttpServerOptionInfo> new_opts = <HttpServerOptionInfo>{
            "logger": mLogger,
            "debug": True,
        };
        HttpServer new_server(new_opts);
        on_exit delete new_server;
        new_server.setHandler("simple", "/simple", NOTHING, new SimpleGetHandler());
        new_server.setHandler("echo", "/echo", NOTHING, new EchoHandler());
        int new_port = new_server.addListener(<HttpListenerOptionInfo>{
            "service": port,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        }).port;
        assertEq(port, new_port, "H2 stale: new server bound to same port");
        new_server.waitForAsyncIo();

        # Step 4: Request via same manager — should detect stale connection and retry
        resp = mgr.request(url, "GET", "/simple");
        assertEq(200, resp.status_code, "H2 stale: recovery request succeeds");
    }

    #! Tests stale connection recovery for HTTP/1.1
    testH1StaleConnectionRecovery() {
        # Create a dedicated server for this test (plain HTTP for H1)
        hash<HttpServerOptionInfo> opts = <HttpServerOptionInfo>{
            "logger": mLogger,
            "debug": True,
        };
        HttpServer server(opts);
        server.setHandler("simple", "/simple", NOTHING, new SimpleGetHandler());
        int port = server.addListener(<HttpListenerOptionInfo>{
            "service": 0,
        }).port;
        string url = "http://127.0.0.1:" + port;
        server.waitForAsyncIo();

        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "protocol": "h1",
            "request_timeout": 5s,
            "connect_timeout": 5s,
            "logger": mLogger,
        });
        on_exit mgr.closeAll();

        # Step 1: Make a successful request to establish pooled connection
        hash<auto> resp = mgr.request(url, "GET", "/simple");
        assertEq(200, resp.status_code, "H1 stale: initial request succeeds");

        # Verify connection is pooled
        hash<auto> stats = mgr.getStats();
        assertGt(0, stats.total_connections, "H1 stale: connection pooled");

        # Step 2: Kill the server
        delete server;
        usleep(100ms);

        # Step 3: Create a new server on the same port
        HttpServer new_server(<HttpServerOptionInfo>{
            "logger": mLogger,
            "debug": True,
        });
        on_exit delete new_server;
        new_server.setHandler("simple", "/simple", NOTHING, new SimpleGetHandler());
        int new_port = new_server.addListener(<HttpListenerOptionInfo>{
            "service": port,
        }).port;
        assertEq(port, new_port, "H1 stale: new server bound to same port");
        new_server.waitForAsyncIo();

        # Step 4: Request via same manager — should detect stale and retry
        resp = mgr.request(url, "GET", "/simple");
        assertEq(200, resp.status_code, "H1 stale: recovery request succeeds");
    }

    #! Tests stale connection recovery for HTTP/3
    testH3StaleConnectionRecovery() {
        if (!mQuicUrl) {
            testSkip("QUIC not available");
        }

        # Create a dedicated server with QUIC
        hash<HttpServerOptionInfo> opts = <HttpServerOptionInfo>{
            "logger": mLogger,
            "debug": True,
        };
        HttpServer server(opts);
        server.setHandler("simple", "/simple", NOTHING, new SimpleGetHandler());
        # Need an HTTPS listener too (for the server to function)
        server.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        });
        *int quic_port;
        *string quic_url;
        try {
            quic_port = server.addQuicListener(<HttpListenerOptionInfo>{
                "cert": new SSLCertificate(CertPem),
                "key": new SSLPrivateKey(KeyPem),
            }).port;
            quic_url = "https://127.0.0.1:" + quic_port;
        } catch (hash<ExceptionInfo> ex) {
            testSkip("QUIC listener not available: " + ex.desc);
        }
        server.waitForAsyncIo();

        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h3",
            "request_timeout": 5s,
            "connect_timeout": 5s,
            "logger": mLogger,
        });
        on_exit mgr.closeAll();

        # Step 1: Make a successful request
        hash<auto> resp = mgr.request(quic_url, "GET", "/simple");
        assertEq(200, resp.status_code, "H3 stale: initial request succeeds");

        # Step 2: Kill the server
        delete server;
        usleep(200ms);

        # Step 3: Create a new server with QUIC on same port
        HttpServer new_server(<HttpServerOptionInfo>{
            "logger": mLogger,
            "debug": True,
        });
        on_exit delete new_server;
        new_server.setHandler("simple", "/simple", NOTHING, new SimpleGetHandler());
        new_server.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        });
        *int new_quic_port;
        try {
            new_quic_port = new_server.addQuicListener(<HttpListenerOptionInfo>{
                "cert": new SSLCertificate(CertPem),
                "key": new SSLPrivateKey(KeyPem),
            }, quic_port).port;
        } catch (hash<ExceptionInfo> ex) {
            testSkip("QUIC listener not available for restart: " + ex.desc);
        }
        assertEq(quic_port, new_quic_port, "H3 stale: new QUIC on same port");
        new_server.waitForAsyncIo();

        # Step 4: Request via same manager
        resp = mgr.request(quic_url, "GET", "/simple");
        assertEq(200, resp.status_code, "H3 stale: recovery request succeeds");
    }

    #! Tests the "notification on close" pattern: submit async notifications while
    #! a long-running request is in-flight, flush to wire, then close immediately.
    #! Verifies that the server receives all notifications.
    testH3AsyncFlushBeforeClose() {
        if (!mQuicUrl) {
            testSkip("QUIC not available");
        }

        # Track requests received by the server (starts at 3, dec'd toward zero)
        Counter notification_count(3);

        mServer.setHandler("notif", "/notif", NOTHING,
            new NotificationTrackingHandler(notification_count));

        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h3",
            "connect_timeout": 10s,
            "request_timeout": 30s,
            "logger": mLogger,
        });

        # Step 0: Warm up the connection synchronously so the H/3 handshake is
        # complete by the time we start submitting concurrent work.  A fixed
        # sleep is not deterministic on slow CI runners (Tart VM macOS hosts
        # saw the background request lose the ALPN race against the
        # notifications), so issue a small known-good request and only then
        # kick off the long-running and notification traffic.
        mgr.request(mQuicUrl, "GET", "/echo");

        # Step 1: Start a long-running request in background
        Counter bg_done(1);
        background sub() {
            on_exit bg_done.dec();
            try {
                mgr.request(mQuicUrl, "GET", "/slow/3000");
            } catch () {
                # Connection closed during request — expected
            }
        }();

        # Step 2: Submit 3 async notifications on the same (now-pooled) connection
        for (int i = 0; i < 3; ++i) {
            string body = sprintf("{\"id\":%d,\"msg\":\"cancel\"}", i);
            hash<auto> result = mgr.submitRequestAsync(mQuicUrl, "POST", "/notif",
                {"Content-Type": "application/json"}, body);

            # Flush to wire deterministically
            result.stream.getConnection().flushPendingWrites();
        }

        # Step 3: Close immediately — no response wait
        mgr.closeAll();

        # Step 4: Verify all 3 notifications were received by the server
        # Counter started at 3, each notification decrements — wait for zero
        notification_count.waitForZero(5s);

        assertEq(0, notification_count.getCount(),
            "server should receive all 3 notifications");

        # Cleanup background thread
        bg_done.waitForZero(10s);
    }
}
