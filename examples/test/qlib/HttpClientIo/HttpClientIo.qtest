                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "logger": mLogger,
        });

        # Manager always has the global controller (autostop=True)
        assertTrue(exists mgr.getController(), "global controller exists");

        on_exit {
            mgr.closeAll();
        }

        hash<auto> stats = mgr.getStats();
        assertEq(0, stats.total_connections, "initial connections");
    }

    testControllerModeBasicRequest() {
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h2",
            "logger": mLogger,
        });

        on_exit {
            mgr.closeAll();
        }

        hash<auto> response = mgr.request(mSslUrl, "GET", "/simple");
        assertEq(200, response.status_code, "controller mode GET /simple status code");
        assertEq("OK", response.body, "controller mode GET /simple body");
    }

    testControllerModeConcurrent() {
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h2",
            "logger": mLogger,
        });

        on_exit {
            mgr.closeAll();
        }

        list<HttpClientIo::HttpClientStreamHandle> streams = ();
        for (int i = 0; i < 5; i++) {
            push streams, mgr.acquireStream(mSslUrl);
        }

        Counter counter(5);
        Mutex resp_lock();
        list<hash<auto>> responses = ();

        for (int i = 0; i < 5; i++) {
            HttpClientIo::HttpClientStreamHandle stream = streams[i];
            string path = sprintf("/simple?idx=%d", i);
            background sub () {
                on_exit counter.dec();
                try {
                    hash<auto> resp = stream.request("GET", path);
                    {
                        AutoLock al(resp_lock);
                        push responses, resp;
                    }
                } catch (hash<ExceptionInfo> ex) {
                    AutoLock al(resp_lock);
                    push responses, {"error": ex.err, "desc": ex.desc};
                }
            }();
        }

        if (counter.waitForZero(30s)) {
            fail(sprintf("controller concurrent: %d requests did not complete",
                counter.getCount()));
        }

        assertEq(5, responses.size(), "controller concurrent: all 5 responses");
        foreach hash<auto> resp in (responses) {
            if (resp.hasKey("error")) {
                fail(sprintf("controller concurrent: %s: %s", resp.error, resp.desc));
            }
            assertEq(200, resp.status_code, "controller concurrent request status code");
        }
    }

    testControllerModeCallback() {
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h2",
            "logger": mLogger,
        });

        on_exit {
            mgr.closeAll();
        }

        # Use Future-based API instead of callback
        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(mSslUrl);
        hash<auto> result = stream.submitAsync("GET", "/simple");
        hash<auto> resp = result.future.get(30s);

