    # ---- State Tests ----

    testStreamStateTransitions() {
        list<int> states = (
            HttpClientIo::HttpClientStreamState::Pending,
            HttpClientIo::HttpClientStreamState::Open,
            HttpClientIo::HttpClientStreamState::HeadersReceived,
            HttpClientIo::HttpClientStreamState::ReceivingBody,
            HttpClientIo::HttpClientStreamState::Complete,
            HttpClientIo::HttpClientStreamState::Cancelled,
            HttpClientIo::HttpClientStreamState::Error,
        );

        # All states should be unique
        hash<string, bool> seen;
        foreach int state in (states) {
            string key = string(state);
            assertFalse(seen{key} ?? False, sprintf("stream state %d should be unique", state));
            seen{key} = True;
        }
        assertEq(7, seen.size(), "should have 7 unique stream states");

        # Terminal states are >= 4
        assertTrue(HttpClientIo::HttpClientStreamState::Complete >= 4, "Complete is terminal");
        assertTrue(HttpClientIo::HttpClientStreamState::Cancelled >= 4, "Cancelled is terminal");
        assertTrue(HttpClientIo::HttpClientStreamState::Error >= 4, "Error is terminal");
    }

    testConnectionStateTransitions() {
        list<int> states = (
            HttpClientIo::HttpClientConnectionState::Connecting,
            HttpClientIo::HttpClientConnectionState::Ready,
            HttpClientIo::HttpClientConnectionState::Draining,
            HttpClientIo::HttpClientConnectionState::Closed,
        );

        hash<string, bool> seen;
        foreach int state in (states) {
            string key = string(state);
            assertFalse(seen{key} ?? False, sprintf("conn state %d should be unique", state));
            seen{key} = True;
        }
        assertEq(4, seen.size(), "should have 4 unique connection states");
    }

    # ---- C++ Layer Tests ----

    #! Test Socket::submitHttp2Request with missing required headers
    testSubmitHttp2RequestMissingHeaders() {
        Socket sock();
        if (!sock.hasCallableMethod("startPollHttp2ClientMultiplex")) {
            testSkip("Socket::startPollHttp2ClientMultiplex() not available - rebuild qore required");
            return;
        }

        sock.connect("localhost:" + mSslPort);
        sock.setAlpnProtocols(("h2",));
        sock.upgradeClientToSSL(30s);

        AbstractPollOperation poll_op = sock.startPollHttp2ClientMultiplex();

        date start = now_us();
        date timeout = 10s;
        while (True) {
            string state = poll_op.getState();
            if (state == "reading-frames") {
                break;
            }
            if (state == "closed") {
                testSkip("HTTP/2 connection closed during establishment");
                return;
            }
            if (now_us() - start > timeout) {
                testSkip("HTTP/2 connection establishment timed out");
                return;
            }
            *hash<SocketPollInfo> info = poll_op.continuePoll();
            if (info) {
                Socket::poll((info,), 1s);
            }
        }

        # Missing headers entirely
        assertThrows("HTTP2-ERROR", ":method.*missing",
            sub () { sock.submitHttp2Request({}); },
            NOTHING, "submitHttp2Request with empty headers should throw");

        # Without :method
        assertThrows("HTTP2-ERROR", ":method.*missing",
            sub () {
                sock.submitHttp2Request({
                    ":path": "/test",
                    ":scheme": "https",
                    ":authority": "localhost",
                });
            },
            NOTHING, "submitHttp2Request without :method should throw");

        # Without :path
        assertThrows("HTTP2-ERROR", ":path.*missing",
            sub () {
                sock.submitHttp2Request({
                    ":method": "GET",
                    ":scheme": "https",
                    ":authority": "localhost",
                });
            },
            NOTHING, "submitHttp2Request without :path should throw");

        # Empty :method
        assertThrows("HTTP2-ERROR", ":method.*missing",
            sub () {
                sock.submitHttp2Request({
                    ":method": "",
                    ":path": "/test",
                    ":scheme": "https",
                    ":authority": "localhost",
                });
            },
            NOTHING, "submitHttp2Request with empty :method should throw");

        # Empty :path
        assertThrows("HTTP2-ERROR", ":path.*missing",
            sub () {
                sock.submitHttp2Request({
                    ":method": "GET",
                    ":path": "",
                    ":scheme": "https",
                    ":authority": "localhost",
                });
            },
            NOTHING, "submitHttp2Request with empty :path should throw");

        # Valid headers should succeed
        int stream_id = sock.submitHttp2Request({
            ":method": "GET",
            ":path": "/simple",
            ":scheme": "https",
            ":authority": "localhost:" + mSslPort,
        });
        assertTrue(stream_id > 0, "valid submitHttp2Request should return positive stream ID");
    }

    # ---- End-to-End Tests via Unified API (forced H2) ----

    testUnifiedBasicGet() {
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h2",
            "logger": mLogger,
        });

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(mSslUrl);
        hash<auto> response = stream.request("GET", "/simple");

        assertEq(200, response.status_code, "unified GET /simple status code");
        assertEq("OK", response.body, "unified GET /simple body");
    }

    testUnifiedPostWithBody() {
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h2",
            "logger": mLogger,
        });

        # String body
        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(mSslUrl);
        hash<auto> response = stream.request("POST", "/echo", NOTHING, "test-body-content");
        assertEq(200, response.status_code, "unified POST status code");
        assertRegex("method=POST", response.body, "unified POST method in response");
        assertRegex("body=test-body-content", response.body, "unified POST body in response");

        # Binary body
        stream = mgr.acquireStream(mSslUrl);
        response = stream.request("POST", "/echo", {"content-type": "application/octet-stream"}, <48656c6c6f>);
        assertEq(200, response.status_code, "unified POST binary status code");
        assertRegex("body=Hello", response.body, "unified POST binary body content");
    }

