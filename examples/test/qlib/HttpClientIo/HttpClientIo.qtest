    # ---- Connection Failure Tests ----

    testConnectionFailureUnreachable() {
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h2",
            "connect_timeout": 2s,
            "request_timeout": 3s,
            "logger": mLogger,
        });

        # Try to connect to a port that nothing is listening on
        bool got_error = False;
        try {
            mgr.request("https://localhost:1", "GET", "/simple");
        } catch (hash<ExceptionInfo> ex) {
            got_error = True;
            # Should get a connect error or timeout
            assertTrue(ex.err == "HTTPCLIENT-CONNECT-ERROR"
                || ex.err == "HTTPCLIENT-TIMEOUT"
                || ex.err == "SOCKET-CONNECT-ERROR",
                sprintf("expected connect/timeout error, got: %s: %s", ex.err, ex.desc));
        }
        assertTrue(got_error, "connection to unreachable host should throw");

        # Pool should have no live connections after failure
        hash<auto> stats = mgr.getStats();
        # The failed connection may or may not be in the pool depending on timing,
        # but no active streams should remain
        assertEq(0, stats.total_active_streams, "no active streams after failure");
    }

