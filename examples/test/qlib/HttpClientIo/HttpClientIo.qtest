    testUnifiedConcurrentRequests() {
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h2",
            "max_connections_per_host": 1,
            "logger": mLogger,
        });

        list<HttpClientIo::HttpClientStreamHandle> streams = ();
        for (int i = 0; i < 5; i++) {
            push streams, mgr.acquireStream(mSslUrl);
        }

        Counter counter(5);
        list<hash<auto>> responses = ();
        Mutex resp_lock();

        for (int i = 0; i < 5; i++) {
            HttpClientIo::HttpClientStreamHandle stream = streams[i];
            string path = sprintf("/simple?idx=%d", i);
            background sub () {
                on_exit counter.dec();
                try {
                    hash<auto> resp = stream.request("GET", path);
                    {
                        AutoLock al(resp_lock);
                        push responses, resp;
                    }
                } catch (hash<ExceptionInfo> ex) {
                    AutoLock al(resp_lock);
                    push responses, {"error": ex.err, "desc": ex.desc};
                }
            }();
        }

        int remaining = counter.waitForZero(30s);
        if (remaining > 0) {
            fail(sprintf("%d requests did not complete within timeout", remaining));
        }

        assertEq(5, responses.size(), "all 5 concurrent responses received");
        foreach hash<auto> resp in (responses) {
            if (resp.hasKey("error")) {
                fail(sprintf("concurrent request failed: %s: %s", resp.error, resp.desc));
            }
            assertEq(200, resp.status_code, "concurrent request status code");
        }

        hash<auto> stats = mgr.getStats();
        assertEq(1, stats.total_connections, "should have 1 multiplexed connection");
    }

    testUnifiedConnectionPooling() {
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h2",
            "max_connections_per_host": 3,
            "logger": mLogger,
        });

        for (int i = 0; i < 5; i++) {
            HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(mSslUrl);
            hash<auto> response = stream.request("GET", "/simple");
            assertEq(200, response.status_code, sprintf("pooling request %d status", i));
        }

        hash<auto> stats = mgr.getStats();
        assertTrue(stats.total_connections <= 3, "should reuse connections (max 3)");
        assertTrue(stats.total_connections >= 1, "should have at least 1 connection");
    }

    testUnifiedAsyncCallback() {
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h2",
            "logger": mLogger,
        });

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(mSslUrl);
        HttpClientIo::HttpClientConnection conn = stream.getConnection();

        assertTrue(conn.waitForReady(30s), "connection should become ready");

        Counter counter(1);
        *hash<auto> callback_response;
        *hash<auto> callback_error;

        stream.submitAsync("GET", "/simple", NOTHING, NOTHING,
            sub (hash<auto> resp, *hash<auto> err) {
                callback_response = resp;
                callback_error = err;
                counter.dec();
            });

        counter.waitForZero(30s);

        assertEq(0, counter.getCount(), "async callback should complete");
        assertNothing(callback_error, "async callback should not have error");
        assertEq(200, callback_response.status_code, "async callback status code");
    }

