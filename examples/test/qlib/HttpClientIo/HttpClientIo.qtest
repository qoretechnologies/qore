    # ---- Protocol Selection Tests ----

    testProtocolSelectionConstants() {
        # Verify protocol selection-related constants exist
        assertEq(5m, HttpClientIo::HttpClientConnectionManager::H3_REPROBE_INTERVAL,
            "H3 reprobe interval");
    }

    testConnectionErrorClassification() {
        assertTrue(HttpClientIo::HttpClientConnectionManager::isConnectionErrorStatic(
            "HTTP3-CONNECTION-CLOSED"), "HTTP3 close must be retried before wrapping");
        # The H3 close error is split into three subcodes by cause; all
        # three must classify as retry-eligible like the legacy umbrella.
        assertTrue(HttpClientIo::HttpClientConnectionManager::isConnectionErrorStatic(
            "HTTP3-IDLE-CLOSE"), "HTTP3 idle close must be retried before wrapping");
        assertTrue(HttpClientIo::HttpClientConnectionManager::isConnectionErrorStatic(
            "HTTP3-LOCAL-CLOSE"), "HTTP3 local close must be retried before wrapping");
        assertTrue(HttpClientIo::HttpClientConnectionManager::isConnectionErrorStatic(
            "HTTP3-PEER-CLOSE"), "HTTP3 peer close must be retried before wrapping");
        assertTrue(HttpClientIo::HttpClientConnectionManager::isConnectionErrorStatic(
            "HTTP3-READ-ERROR"), "HTTP3 read errors must be retried before wrapping");
        assertFalse(HttpClientIo::HttpClientConnectionManager::isConnectionErrorStatic(
            "HTTPCLIENT-REQUEST-ERROR"), "wrapped request errors are not transport retry signals");
    }

    # ---- State Tests ----

    testStreamStateTransitions() {
        list<int> states = (
            HttpClientIo::HttpClientStreamState::Pending,
            HttpClientIo::HttpClientStreamState::Open,
            HttpClientIo::HttpClientStreamState::HeadersReceived,
            HttpClientIo::HttpClientStreamState::ReceivingBody,
            HttpClientIo::HttpClientStreamState::Complete,
            HttpClientIo::HttpClientStreamState::Cancelled,
            HttpClientIo::HttpClientStreamState::Error,
        );

        # All states should be unique
        hash<string, bool> seen;
        foreach int state in (states) {
            string key = string(state);
            assertFalse(seen{key} ?? False, sprintf("stream state %d should be unique", state));
            seen{key} = True;
        }
        assertEq(7, seen.size(), "should have 7 unique stream states");

        # Terminal states are >= 4
        assertTrue(HttpClientIo::HttpClientStreamState::Complete >= 4, "Complete is terminal");
        assertTrue(HttpClientIo::HttpClientStreamState::Cancelled >= 4, "Cancelled is terminal");
        assertTrue(HttpClientIo::HttpClientStreamState::Error >= 4, "Error is terminal");
    }

    #! Verifies the H2/H3 readData() coalesced headers+body split decision.
    /** The HTTP/2 and HTTP/3 transports can deliver the response HEADERS and
        the first DATA frame in a single channel event (when the server sends
        them in one packet).  readData() must then deliver the response metadata
        as a standalone hash and defer the body, so consumers that validate the
        response from the return value — notably the WebSocket extended-CONNECT
        handshake — see the response hash and not a raw body value.  This tests
        the shared decision helper directly so the contract is verified
        deterministically, independent of network packet timing.
    */
    testCoalescedDeferredBody() {
        # The WebSocket extended-CONNECT case: 200 + headers + first body chunk,
        # no end_stream (the tunnel stays open).  Must defer the body so the
        # response hash is delivered first.
        binary welcome = binary("registered-welcome");
        auto body = HttpClientIo::HttpClientStreamHandle::getCoalescedDeferredBody(
            {"status_code": 200, "headers": {":status": "200"}, "body": welcome}, True);
        assertEq(welcome, body, "coalesced 200+body (no end_stream) defers the binary body");

        # Streamed bodies may be strings, not just binaries — the deferred value
        # must preserve the type (regression: a *binary-typed slot raised
        # RUNTIME-TYPE-ERROR on a string body).
        auto sbody = HttpClientIo::HttpClientStreamHandle::getCoalescedDeferredBody(
            {"status_code": 200, "headers": {}, "body": "text-frame"}, True);
        assertEq("text-frame", sbody, "coalesced response defers a string body unchanged");

        # A fully-coalesced final response (headers+body+end_stream) must NOT be
        # split — the original body-then-end_stream order is required so
        # streaming consumers see the body before the completion signal
        # (regression: splitting here lost the body for bidi/echo responses).
        assertNothing(HttpClientIo::HttpClientStreamHandle::getCoalescedDeferredBody(
            {"status_code": 200, "headers": {}, "body": binary("x"), "end_stream": True}, True),
            "coalesced response WITH end_stream is not split");

        # A mid-stream body chunk carries a persisted status_code but is not the
        # first response event — it must be returned normally, not deferred
        # (regression: gating on status_code alone deferred every chunk).
        assertNothing(HttpClientIo::HttpClientStreamHandle::getCoalescedDeferredBody(
            {"status_code": 200, "body": binary("chunk2")}, False),
            "mid-stream body chunk (not first response) is not deferred");

        # A headers-only response event (no body) is delivered as-is, not split.
        assertNothing(HttpClientIo::HttpClientStreamHandle::getCoalescedDeferredBody(
            {"status_code": 200, "headers": {":status": "200"}}, True),
            "headers-only response event is not split");

        # A pure body event with no response metadata is delivered normally.
        assertNothing(HttpClientIo::HttpClientStreamHandle::getCoalescedDeferredBody(
            {"body": binary("data")}, True),
            "body-only event with no metadata is not split");
    }

    testConnectionStateTransitions() {
        list<int> states = (
            HttpClientIo::HttpClientConnectionState::Connecting,
            HttpClientIo::HttpClientConnectionState::Ready,
            HttpClientIo::HttpClientConnectionState::Draining,
            HttpClientIo::HttpClientConnectionState::Closed,
        );

        hash<string, bool> seen;
        foreach int state in (states) {
            string key = string(state);
            assertFalse(seen{key} ?? False, sprintf("conn state %d should be unique", state));
            seen{key} = True;
        }
        assertEq(4, seen.size(), "should have 4 unique connection states");
    }

    # ---- C++ Layer Tests ----

    #! Test Socket::submitHttp2Request with missing required headers
    testSubmitHttp2RequestMissingHeaders() {
        Socket sock();
        if (!sock.hasCallableMethod("startPollHttp2ClientMultiplex")) {
            testSkip("Socket::startPollHttp2ClientMultiplex() not available - rebuild qore required");
            return;
        }

        sock.connect("localhost:" + mSslPort);
        sock.setAlpnProtocols(("h2",));
        try {
            sock.upgradeClientToSSL(30s);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "SOCKET-SSL-ERROR") {
                testSkip("SSL handshake failed (transient): " + ex.desc);
                return;
            }
            rethrow;
        }

        AbstractPollOperation poll_op = sock.startPollHttp2ClientMultiplex();

        date start = now_us();
        date timeout = 10s;
        while (True) {
            string state = poll_op.getState();
            if (state == "reading-frames") {
                break;
            }
            if (state == "closed") {
                testSkip("HTTP/2 connection closed during establishment");
                return;
            }
            if (now_us() - start > timeout) {
                testSkip("HTTP/2 connection establishment timed out");
                return;
            }
            *hash<SocketPollInfo> info = poll_op.continuePoll();
            if (info) {
                Socket::poll((info,), 1s);
            }
        }

        # Missing headers entirely
        assertThrows("HTTP2-ERROR", ":method.*missing",
            sub () { sock.submitHttp2Request({}); },
            NOTHING, "submitHttp2Request with empty headers should throw");

        # Without :method
        assertThrows("HTTP2-ERROR", ":method.*missing",
            sub () {
                sock.submitHttp2Request({
                    ":path": "/test",
                    ":scheme": "https",
                    ":authority": "localhost",
                });
            },
            NOTHING, "submitHttp2Request without :method should throw");

        # Without :path
        assertThrows("HTTP2-ERROR", ":path.*missing",
            sub () {
                sock.submitHttp2Request({
                    ":method": "GET",
                    ":scheme": "https",
                    ":authority": "localhost",
                });
            },
            NOTHING, "submitHttp2Request without :path should throw");

        # Empty :method
        assertThrows("HTTP2-ERROR", ":method.*missing",
            sub () {
                sock.submitHttp2Request({
                    ":method": "",
                    ":path": "/test",
                    ":scheme": "https",
                    ":authority": "localhost",
                });
            },
            NOTHING, "submitHttp2Request with empty :method should throw");

        # Empty :path
        assertThrows("HTTP2-ERROR", ":path.*missing",
            sub () {
                sock.submitHttp2Request({
                    ":method": "GET",
                    ":path": "",
                    ":scheme": "https",
                    ":authority": "localhost",
                });
            },
            NOTHING, "submitHttp2Request with empty :path should throw");

        # Valid headers should succeed
        int stream_id = sock.submitHttp2Request({
            ":method": "GET",
            ":path": "/simple",
            ":scheme": "https",
            ":authority": "localhost:" + mSslPort,
        });
        assertTrue(stream_id > 0, "valid submitHttp2Request should return positive stream ID");
    }

    # ---- End-to-End Tests via Unified API (forced H2) ----

    testUnifiedBasicGet() {
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h2",
            "logger": mLogger,
        });

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(mSslUrl);
        hash<auto> response = stream.request("GET", "/simple");

        assertEq(200, response.status_code, "unified GET /simple status code");
        assertEq("OK", response.body, "unified GET /simple body");
    }

    testUnifiedPostWithBody() {
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h2",
            "logger": mLogger,
        });

        # String body
        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(mSslUrl);
        hash<auto> response = stream.request("POST", "/echo", NOTHING, "test-body-content");
        assertEq(200, response.status_code, "unified POST status code");
        assertRegex("method=POST", response.body, "unified POST method in response");
        assertRegex("body=test-body-content", response.body, "unified POST body in response");

        # Binary body
        stream = mgr.acquireStream(mSslUrl);
        response = stream.request("POST", "/echo", {"content-type": "application/octet-stream"}, <48656c6c6f>);
        assertEq(200, response.status_code, "unified POST binary status code");
        assertRegex("body=Hello", response.body, "unified POST binary body content");
    }

    testUnifiedErrorResponse() {
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h2",
            "logger": mLogger,
        });

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(mSslUrl);
        hash<auto> response = stream.request("GET", "/error/404");
        assertEq(404, response.status_code, "unified GET /error/404 status code");
        assertEq("Error 404", response.body, "unified GET /error/404 body");

        stream = mgr.acquireStream(mSslUrl);
        response = stream.request("GET", "/error/500");
        assertEq(500, response.status_code, "unified GET /error/500 status code");
    }

    testUnifiedLargeResponse() {
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h2",
            "logger": mLogger,
        });

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(mSslUrl);
        hash<auto> response = stream.request("GET", "/large/50000");
        assertEq(200, response.status_code, "unified large response status code");
        assertEq(50000, response.body.size(), "unified large response body size");
        assertTrue(response.body =~ /^X+$/, "unified large response body content");
    }

    testUnifiedConcurrentRequests() {
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h2",
            "max_connections_per_host": 1,
            "logger": mLogger,
        });

        list<HttpClientIo::HttpClientStreamHandle> streams = ();
        for (int i = 0; i < 5; i++) {
            push streams, mgr.acquireStream(mSslUrl);
        }

        Counter counter(5);
        list<hash<auto>> responses = ();
        Mutex resp_lock();

        for (int i = 0; i < 5; i++) {
            HttpClientIo::HttpClientStreamHandle stream = streams[i];
            string path = sprintf("/simple?idx=%d", i);
            background sub () {
                on_exit counter.dec();
                try {
                    hash<auto> resp = stream.request("GET", path);
                    {
                        AutoLock al(resp_lock);
                        push responses, resp;
                    }
                } catch (hash<ExceptionInfo> ex) {
                    AutoLock al(resp_lock);
                    push responses, {"error": ex.err, "desc": ex.desc};
                }
            }();
        }

        int remaining = counter.waitForZero(30s);
        if (remaining > 0) {
            fail(sprintf("%d requests did not complete within timeout", remaining));
        }

        assertEq(5, responses.size(), "all 5 concurrent responses received");
        foreach hash<auto> resp in (responses) {
            if (resp.hasKey("error")) {
                fail(sprintf("concurrent request failed: %s: %s", resp.error, resp.desc));
            }
            assertEq(200, resp.status_code, "concurrent request status code");
        }

        hash<auto> stats = mgr.getStats();
        assertEq(1, stats.total_connections, "should have 1 multiplexed connection");
    }

    testUnifiedConnectionPooling() {
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h2",
            "max_connections_per_host": 3,
            "logger": mLogger,
        });

        for (int i = 0; i < 5; i++) {
            HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(mSslUrl);
            hash<auto> response = stream.request("GET", "/simple");
            assertEq(200, response.status_code, sprintf("pooling request %d status", i));
        }

        hash<auto> stats = mgr.getStats();
        assertTrue(stats.total_connections <= 3, "should reuse connections (max 3)");
        assertTrue(stats.total_connections >= 1, "should have at least 1 connection");
    }

    testUnifiedAsyncCallback() {
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h2",
            "logger": mLogger,
        });

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(mSslUrl);
        HttpClientIo::HttpClientConnection conn = stream.getConnection();

        assertTrue(conn.waitForReady(30s), "connection should become ready");

        hash<auto> result = stream.submitAsync("GET", "/simple");
        Future f = result.future;
        hash<auto> resp = f.get(30s);

        assertEq(200, resp.status_code, "async Future status code");
        assertTrue(resp.body.val(), "async Future should have body");
    }

