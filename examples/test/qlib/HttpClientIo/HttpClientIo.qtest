    constructor() : Test("HttpClientIoTest", "1.0") {
        # Module and definition tests
        addTestCase("module load test", \testModuleLoad());
        addTestCase("unified hashdecl and enum definitions", \testUnifiedDefinitions());
        addTestCase("unified connection manager creation", \testUnifiedConnectionManagerCreation());

        # Unified manager basic functionality
        addTestCase("unified manager stats", \testUnifiedManagerStats());

        # Negative tests
        addTestCase("invalid URL handling", \testInvalidUrl());
        addTestCase("unified manager shutdown", \testUnifiedManagerShutdown());
        addTestCase("H3 requires HTTPS", \testH3RequiresHttps());
        addTestCase("close all is idempotent", \testCloseAllIdempotent());
        addTestCase("cleanup idle no connections", \testCleanupIdleNoConnections());
        addTestCase("migrateAll with no connections", \testMigrateAllNoConnections());

        # Protocol selection tests
        addTestCase("protocol selection constants", \testProtocolSelectionConstants());

        # State tests
        addTestCase("stream state transitions", \testStreamStateTransitions());
        addTestCase("connection state transitions", \testConnectionStateTransitions());

        # C++ layer tests
        addTestCase("submitHttp2Request missing headers", \testSubmitHttp2RequestMissingHeaders());

        # End-to-end tests via unified API (forced H2 protocol)
        addTestCase("unified basic GET request", \testUnifiedBasicGet());
        addTestCase("unified POST request with body", \testUnifiedPostWithBody());
        addTestCase("unified error response", \testUnifiedErrorResponse());
        addTestCase("unified large response", \testUnifiedLargeResponse());
        addTestCase("unified concurrent multiplexed", \testUnifiedConcurrentRequests());
        addTestCase("unified connection pooling", \testUnifiedConnectionPooling());
        addTestCase("unified async callback", \testUnifiedAsyncCallback());

        # Controller mode tests
        addTestCase("controller mode setup", \testControllerModeSetup());
        addTestCase("controller mode basic request", \testControllerModeBasicRequest());
        addTestCase("controller mode concurrent", \testControllerModeConcurrent());
        addTestCase("controller mode callback", \testControllerModeCallback());
        addTestCase("controller mode timeout", \testControllerModeTimeout());

        # Auto protocol selection (against HTTP/2-only server)
        addTestCase("auto protocol fallback to H2", \testAutoProtocolFallback());

        # H3 end-to-end tests
        addTestCase("H3 end-to-end basic request", \testH3EndToEndBasic());
        addTestCase("H3 end-to-end concurrent", \testH3EndToEndConcurrent());

        # Streaming tests (HTTP/2 only)
        addTestCase("H2 streaming basic", \testH2StreamingBasic());
        addTestCase("H2 streaming state error", \testH2StreamingStateError());

        # Cancellation tests
        addTestCase("stream cancel before response", \testStreamCancelBeforeResponse());
        addTestCase("stream cancel after completion", \testStreamCancelAfterCompletion());

        # Capacity and idle cleanup tests
        addTestCase("capacity error", \testCapacityError());
        addTestCase("cleanup idle with connections", \testCleanupIdleWithConnections());

        # Additional coverage tests
        addTestCase("invalid protocol option", \testInvalidProtocolOption());
        addTestCase("invalid max connections option", \testInvalidMaxConnectionsOption());
        addTestCase("invalid max streams option", \testInvalidMaxStreamsOption());
        addTestCase("double startStreaming error", \testDoubleStartStreaming());
        addTestCase("getConnectionInfo", \testGetConnectionInfo());
        addTestCase("stream cancel during readiness", \testStreamCancelDuringReadiness());
        addTestCase("connection reuse", \testConnectionReuse());
        addTestCase("readData not in streaming mode", \testH2StreamingReadDataNotInStreamingMode());
        addTestCase("sendData not in streaming mode", \testH2StreamingSendDataNotInStreamingMode());

        # Connection failure and timeout tests
        addTestCase("connection failure unreachable", \testConnectionFailureUnreachable());
        addTestCase("non-controller mode timeout", \testNonControllerModeTimeout());

        # Concurrent closeAll test
        addTestCase("closeAll during requests", \testCloseAllDuringRequests());

        # Pool scaling test
        addTestCase("pool creates second connection", \testPoolCreatesSecondConnection());

        # Cancel callback verification
        addTestCase("cancel callback invoked", \testCancelCallbackInvoked());

        # Connection draining test
        addTestCase("connection draining", \testConnectionDraining());

        # Bidi streaming: sendData after server END_STREAM must not throw HTTP2-STREAM-ERROR
        addTestCase("H2 bidi streaming send after server close", \testH2BidiSendAfterServerClose());

        # Bidi streaming: echo test with BidiEchoHandler
        addTestCase("H2 bidi echo streaming", \testH2BidiEchoStreaming());

        # HTTP/3 streaming tests
        addTestCase("H3 streaming basic", \testH3StreamingBasic());
        addTestCase("H3 bidi streaming", \testH3BidiStreaming());
        addTestCase("H3 streaming state errors", \testH3StreamingStateErrors());

        # HTTP/3 callback ordering (stream removal after callback)
        addTestCase("H3 callback ordering", \testH3CallbackOrdering());

        set_return_value(main());
    }

    globalSetUp() {
        mLogger = new Logger("httpclientio-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            mLogger.addAppender(new StdoutAppender());
        }

        hash<HttpServerOptionInfo> opts = <HttpServerOptionInfo>{
            "logger": mLogger,
            "debug": True,
            "async_mode": True,
        };
        mServer = new HttpServer(opts);

        # Register handlers
        mServer.setHandler("simple", "/simple", NOTHING, new SimpleGetHandler());
        mServer.setHandler("large", "/large", NOTHING, new LargeResponseHandler());
        mServer.setHandler("echo", "/echo", NOTHING, new EchoHandler());
        mServer.setHandler("slow", "/slow", NOTHING, new SlowHandler());
        mServer.setHandler("error", "/error", NOTHING, new ErrorHandler());
        mServer.setHandler("streaming", "/streaming", NOTHING, new StreamingHandler());
        mServer.setHandler("bidi", "/bidi", NOTHING, new BidiEchoHandler());

        # Add HTTPS listener
        mSslPort = mServer.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        }).port;
        mSslUrl = "https://127.0.0.1:" + mSslPort;

        # Add QUIC listener for HTTP/3 tests
        try {
            mQuicPort = mServer.addQuicListener(<HttpListenerOptionInfo>{
                "cert": new SSLCertificate(CertPem),
                "key": new SSLPrivateKey(KeyPem),
            }).port;
            mQuicUrl = "https://127.0.0.1:" + mQuicPort;
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose > 0) {
                printf("QUIC listener not available: %s: %s\n", ex.err, ex.desc);
            }
        }

        mServer.waitForAsyncIo();

        if (m_options.verbose > 1) {
            printf("HTTPS test server on port %d\n", mSslPort);
            if (mQuicPort) {
                printf("QUIC test server on port %d\n", mQuicPort);
            }
        }
    }

    globalTearDown() {
        delete mServer;
    }

    # ---- Module and Type Tests ----

    testModuleLoad() {
        assertEq("HttpClientConnectionManager",
            get_class_name(new HttpClientIo::HttpClientConnectionManager()),
            "HttpClientIo module loaded");
    }

    testUnifiedDefinitions() {
        # Unified stream state enums
        assertEq(0, HttpClientIo::HttpClientStreamState::Pending, "unified stream state Pending");
        assertEq(1, HttpClientIo::HttpClientStreamState::Open, "unified stream state Open");
        assertEq(2, HttpClientIo::HttpClientStreamState::HeadersReceived, "unified stream state HeadersReceived");
        assertEq(3, HttpClientIo::HttpClientStreamState::ReceivingBody, "unified stream state ReceivingBody");
        assertEq(4, HttpClientIo::HttpClientStreamState::Complete, "unified stream state Complete");
        assertEq(5, HttpClientIo::HttpClientStreamState::Cancelled, "unified stream state Cancelled");
        assertEq(6, HttpClientIo::HttpClientStreamState::Error, "unified stream state Error");

        # Unified connection state enums
        assertEq(0, HttpClientIo::HttpClientConnectionState::Connecting, "unified conn state Connecting");
        assertEq(1, HttpClientIo::HttpClientConnectionState::Ready, "unified conn state Ready");
        assertEq(2, HttpClientIo::HttpClientConnectionState::Draining, "unified conn state Draining");
        assertEq(3, HttpClientIo::HttpClientConnectionState::Closed, "unified conn state Closed");

        # Unified constants
        assertEq(0, HttpClientIo::DefaultMaxConnectionsPerHost, "unified default max connections per host");
        assertEq(0, HttpClientIo::DefaultMaxStreamsPerConnection, "unified default max streams per connection");
        assertTrue(HttpClientIo::DefaultConnectionIdleTimeout > 0, "unified default idle timeout > 0");
        assertTrue(HttpClientIo::DefaultConnectTimeout > 0, "unified default connect timeout > 0");
        assertTrue(HttpClientIo::DefaultRequestTimeout > 0, "unified default request timeout > 0");

        # Unified manager options hashdecl
        hash<HttpClientIo::HttpClientConnectionManagerOptions> mgr_opts =
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "max_connections_per_host": 4,
            "max_streams_per_connection": 50,
            "idle_timeout": 30s,
            "connect_timeout": 15s,
            "request_timeout": 45s,
            "accept_all_certs": True,
            "protocol": "h2",
        };
        assertEq(4, mgr_opts.max_connections_per_host, "unified mgr opts max_connections_per_host");
        assertEq(50, mgr_opts.max_streams_per_connection, "unified mgr opts max_streams_per_connection");
        assertEq(30000, int(mgr_opts.idle_timeout), "unified mgr opts idle_timeout");
        assertEq(15000, int(mgr_opts.connect_timeout), "unified mgr opts connect_timeout");
        assertEq(45000, int(mgr_opts.request_timeout), "unified mgr opts request_timeout");
        assertEq(True, mgr_opts.accept_all_certs, "unified mgr opts accept_all_certs");
        assertEq("h2", mgr_opts.protocol, "unified mgr opts protocol");

        # Default protocol is "auto"
        hash<HttpClientIo::HttpClientConnectionManagerOptions> default_opts =
                <HttpClientIo::HttpClientConnectionManagerOptions>{};
        assertEq("auto", default_opts.protocol, "default protocol is auto");

        # Unified request options hashdecl
        hash<HttpClientIo::HttpClientRequestOptions> req_opts =
                <HttpClientIo::HttpClientRequestOptions>{
            "timeout": 5s,
            "priority_weight": 128,
        };
        assertEq(5000, int(req_opts.timeout), "unified req opts timeout");
        assertEq(128, req_opts.priority_weight, "unified req opts priority_weight");

        # Unified response info hashdecl
        hash<HttpClientIo::HttpClientResponseInfo> resp = <HttpClientIo::HttpClientResponseInfo>{
            "status_code": 200,
            "headers": {"content-type": "text/plain"},
            "body": "test",
            "stream_id": 1,
            "protocol": "h2",
        };
        assertEq(200, resp.status_code, "unified resp status_code");
        assertEq("text/plain", resp.headers."content-type", "unified resp headers");
        assertEq("test", resp.body, "unified resp body");
        assertEq(1, resp.stream_id, "unified resp stream_id");
        assertEq("h2", resp.protocol, "unified resp protocol");

        # Unified error info hashdecl
        hash<HttpClientIo::HttpClientErrorInfo> err = <HttpClientIo::HttpClientErrorInfo>{
            "err": "HTTP-ERROR",
            "desc": "test error",
            "stream_id": 3,
            "h2_error_code": 1,
        };
        assertEq("HTTP-ERROR", err.err, "unified err err");
        assertEq("test error", err.desc, "unified err desc");
        assertEq(3, err.stream_id, "unified err stream_id");
        assertEq(1, err.h2_error_code, "unified err h2_error_code");

        # Unified connection info hashdecl
        hash<HttpClientIo::HttpClientConnectionInfo> conn_info =
                <HttpClientIo::HttpClientConnectionInfo>{
            "host": "example.com",
            "port": 443,
            "active_streams": 5,
            "max_concurrent_streams": 100,
            "connection_id": 1,
            "protocol": "h2",
            "ssl": True,
        };
        conn_info.state = HttpClientIo::HttpClientConnectionState::Ready;
        assertEq("example.com", conn_info.host, "unified conn_info host");
        assertEq(443, conn_info.port, "unified conn_info port");
        assertEq(HttpClientIo::HttpClientConnectionState::Ready, conn_info.state, "unified conn_info state");
        assertEq(5, conn_info.active_streams, "unified conn_info active_streams");
        assertEq(100, conn_info.max_concurrent_streams, "unified conn_info max_concurrent_streams");
        assertEq(1, conn_info.connection_id, "unified conn_info connection_id");
        assertEq("h2", conn_info.protocol, "unified conn_info protocol");
        assertEq(True, conn_info.ssl, "unified conn_info ssl");
    }

    testUnifiedConnectionManagerCreation() {
        # Default options
        HttpClientIo::HttpClientConnectionManager mgr1();
        hash<auto> stats1 = mgr1.getStats();
        assertEq(0, stats1.total_connections, "default unified mgr initial connections");
        assertEq(0, stats1.total_active_streams, "default unified mgr initial streams");
        assertEq(0, stats1.hosts, "default unified mgr initial hosts");
        assertEq("auto", stats1.protocol, "default unified mgr protocol is auto");

        # Custom options with forced H2
        HttpClientIo::HttpClientConnectionManager mgr2(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "max_connections_per_host": 4,
            "max_streams_per_connection": 50,
            "protocol": "h2",
            "logger": mLogger,
        });
        hash<auto> stats2 = mgr2.getStats();
        assertEq(0, stats2.total_connections, "custom unified mgr initial connections");
        assertEq("h2", stats2.protocol, "custom unified mgr protocol is h2");

        # H3 forced options
        HttpClientIo::HttpClientConnectionManager mgr3(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "protocol": "h3",
        });
        hash<auto> stats3 = mgr3.getStats();
        assertEq("h3", stats3.protocol, "h3 unified mgr protocol");

        # With SSL options
        HttpClientIo::HttpClientConnectionManager mgr4(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "ssl_verify_mode": 0,
        });
        hash<auto> stats4 = mgr4.getStats();
        assertEq(0, stats4.total_connections, "ssl unified mgr initial connections");
    }

    # ---- Basic Functionality Tests ----

    testUnifiedManagerStats() {
        HttpClientIo::HttpClientConnectionManager mgr();
        hash<auto> stats = mgr.getStats();
        assertEq(0, stats.total_connections, "initial total_connections");
        assertEq(0, stats.total_active_streams, "initial total_active_streams");
        assertEq(0, stats.hosts, "initial hosts");
