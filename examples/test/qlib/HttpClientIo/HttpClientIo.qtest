    testControllerModeTimeout() {
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h2",
            "logger": mLogger,
        });

        on_exit {
            mgr.closeAll();
        }

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(mSslUrl);
        bool timed_out = False;
        try {
            # /slow/5000 waits 5 seconds, we timeout after 500ms
            stream.request("GET", "/slow/5000", NOTHING, NOTHING, 500ms);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "HTTPCLIENT-TIMEOUT") {
                timed_out = True;
            }
        }
        assertTrue(timed_out, "controller mode: request should timeout");
    }

    # ---- Auto Protocol Selection Tests ----

    testAutoProtocolFallback() {
        # With auto protocol, the manager will try H3 first then fall back to H2 if needed.
        # Against our test server (which supports both protocols), H3 may succeed.
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "auto",
            "logger": mLogger,
        });

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(mSslUrl);
        hash<auto> response = stream.request("GET", "/simple");
        assertEq(200, response.status_code, "auto protocol GET /simple status code");

        # Body may be string (H2) or binary (H3) depending on which protocol was selected
        string body_str;
        if (response.body.typeCode() == NT_BINARY) {
            body_str = response.body.toString();
        } else {
            body_str = response.body;
        }
        assertEq("OK", body_str, "auto protocol GET /simple body");

        # Verify connection was created
        hash<auto> stats = mgr.getStats();
        assertTrue(stats.total_connections >= 1, "auto protocol created at least one connection");

        # Test second request uses cached protocol (reuses connection)
        stream = mgr.acquireStream(mSslUrl);
        response = stream.request("GET", "/simple");
        assertEq(200, response.status_code, "auto protocol cached request status code");
    }

    #! Drives acquireConnectionAsync()'s re-entrant loop the way the
    #! connection-monitor ping op does: poll the returned per-call notifier via
    #! the controller, then re-enter.  Returns the resolved connection.
    /** The TEST thread blocking on the controller notifier here mirrors the
        ping op's controller-submitted SPS_CONNECTING poll — it does NOT mean
        acquireConnectionAsync() itself blocks the caller (see
        @ref testAsyncHeNonBlockingAndSyncParity()).
    */
    private HttpClientIo::HttpClientConnection driveAsyncConnect(
            HttpClientIo::HttpClientConnectionManager mgr, string url, timeout to) {
        *HttpClientIo::HttpClientConnection cout;
        *EventNotifier n = mgr.acquireConnectionAsync(url, \cout);
        int iters = 0;
        while (n) {
            assertTrue(++iters < 200, "async connect converged");
            mgr.getController().waitForNotifier(n, to, to + 30s);
            n.acknowledge();
            delete n;
            n = mgr.acquireConnectionAsync(url, \cout);
        }
        assertTrue(exists cout, "resolved connection returned via conn_out");
        return cout;
    }

    testAsyncHeConnectsH2() {
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "ssl_verify_mode": 0,
            "protocol": "auto",
            "logger": mLogger,
        });
        on_exit delete mgr;

        # The async happy-eyeballs race resolves to whichever protocol the test
        # server wins with (it supports both H3 and H2 — see
        # testAutoProtocolFallback), caching the winner via the shared
        # heCommitWinner().
        HttpClientIo::HttpClientConnection conn = driveAsyncConnect(mgr, mSslUrl, 15s);
        assertTrue(conn.isReady(), "async HE connection ready");
        assertTrue(inlist(conn.getProtocol(), ("h2", "h3")),
            sprintf("async HE resolved to a raced protocol (got %y)",
                conn.getProtocol()));

        # The winner was pool-inserted: a synchronous request reuses it
        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(mSslUrl);
        hash<auto> response = stream.request("GET", "/simple");
        assertEq(200, response.status_code,
            "request over async-HE-established H2 connection");

        # Protocol now cached: a fresh async acquire resolves with no race
        # (live pooled connection reused immediately, notifier NOTHING)
        *HttpClientIo::HttpClientConnection cout2;
        *EventNotifier n2 = mgr.acquireConnectionAsync(mSslUrl, \cout2);
        assertNothing(n2, "cached-protocol async acquire reuses pooled conn");
        assertTrue(exists cout2 && cout2.isReady(), "reused pooled H2 connection");
    }

    testAsyncHeH3WinsStagger() {
        if (!mQuicPort) {
            testSkip("QUIC listener not available — the stagger->H2 transition "
                "is covered by testAsyncHeConnectsH2()");
        }
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "ssl_verify_mode": 0,
            "protocol": "auto",
            "logger": mLogger,
        });
        on_exit delete mgr;

        # mQuicUrl has a working H3/QUIC listener: H3 should win the race
        # (preferred), the H2 loser is closed, and "h3" is cached.
        HttpClientIo::HttpClientConnection conn = driveAsyncConnect(mgr, mQuicUrl, 15s);
        assertTrue(conn.isReady(), "async HE (QUIC) connection ready");
        assertEq("h3", conn.getProtocol(), "async HE resolved to H3 (preferred)");
    }

    #! The happy-eyeballs terminal connect error must report BOTH raced legs.
    /** Regression for the confusing production message
        "could not connect to <host>:<port>: QUIC handshake did not complete
        within the configured connect_timeout": the old formatter used
        "h2_err.desc ?? h3_err.desc", so whenever the H2 (TCP) leg's error hash
        carried no "desc" the message fell through to the H3/QUIC text alone —
        making a total-endpoint outage look QUIC-specific and hiding that TCP had
        also been tried and had also failed.

        Exercises the pure formatter HttpClientConnectionManager::heBuildConnectErrorDesc()
        directly (no network, fully deterministic) across every leg combination,
        including the exact production shape (H3 has a desc, H2 has only an err
        code).
    */
    testHeConnectErrorMessageReportsBothLegs() {
        string key = "192.168.16.30:8092";

        # Production shape: H3 timed out with a desc, H2 failed with only an err
        # code (no desc).  The old code showed ONLY the QUIC line; the new code
        # must surface both, labelled, so the TCP failure is visible.
        hash<auto> h3_err = {
            "err": "HTTP3-TIMEOUT",
            "desc": "QUIC handshake did not complete within the configured connect_timeout",
        };
        hash<auto> h2_err = {"err": "SOCKET-SSL-ERROR"};
        string desc = HttpClientIo::HttpClientConnectionManager::heBuildConnectErrorDesc(
            h3_err, h2_err, key);
        assertRegex("could not connect to " + key, desc, "message names the endpoint");
        assertRegex("H3/QUIC: QUIC handshake did not complete", desc,
            "message surfaces the H3/QUIC reason");
        assertRegex("H2/TCP: SOCKET-SSL-ERROR", desc,
            "message surfaces the H2/TCP reason even when it has no desc "
            "(the historical hidden-TCP-failure bug)");

        # Both legs carry a desc: both must appear.
        string both = HttpClientIo::HttpClientConnectionManager::heBuildConnectErrorDesc(
            {"err": "HTTP3-TIMEOUT", "desc": "quic timed out"},
            {"err": "SOCKET-CONNECT-ERROR", "desc": "tcp refused"}, key);
        assertRegex("H3/QUIC: quic timed out", both, "both-desc: H3 reason present");
        assertRegex("H2/TCP: tcp refused", both, "both-desc: H2 reason present");

        # Fast-fail shape: H3 still pending (no error recorded) — only the H2/TCP
        # leg is reported, and no bogus H3 line is emitted.
        string h2only = HttpClientIo::HttpClientConnectionManager::heBuildConnectErrorDesc(
            NOTHING, {"err": "SOCKET-CONNECT-ERROR", "desc": "connection refused"}, key);
        assertRegex("H2/TCP: connection refused", h2only, "fast-fail: H2 reason present");
        assertEq(-1, h2only.find("H3/QUIC"), "fast-fail: no spurious H3/QUIC leg reported");

        # Degenerate shape: neither leg recorded an error — a bare, non-crashing
        # message with no dangling ": ".
        string neither = HttpClientIo::HttpClientConnectionManager::heBuildConnectErrorDesc(
            NOTHING, NOTHING, key);
        assertEq("could not connect to " + key, neither,
            "no-error case: bare message with no trailing separator");
    }

    testAsyncHeConnectRefusedFastFail() {
        # A port nothing listens on → TCP RST (ECONNREFUSED).  The async race's
        # H2 (TCP) attempt fails fast with SOCKET-CONNECT-ERROR; the shared
        # heH2FastFail()/heThrowConnectError() must propagate it WITHOUT waiting
        # connect_timeout (identical to the synchronous race's fast-fail).
        #
        # Pick a free port, then hold ONLY a UDP socket on it for the duration of
        # the test.  Rationale (root cause of a macOS-only flake): simply closing
        # a bound socket leaves the port free to be re-bound between here and the
        # race's connect attempts.  The most dangerous re-binder is the manager's
        # own H3/QUIC client, which auto-binds an ephemeral UDP port from the same
        # pool the freed port came from; on BSD/macOS that recently-freed port is
        # reused readily, so the H3 leg could bind it and loopback-self-deliver
        # instead of failing — making the happy-eyeballs race resolve to a bogus
        # "ready" winner and the assertion below see no exception.  Holding the
        # UDP port closes that hole (H3 cannot self-bind/reuse it and our socket
        # absorbs its datagrams) while leaving the TCP port truly closed so H2
        # still gets an immediate RST → fast SOCKET-CONNECT-ERROR.  We must NOT
        # hold a (bound, non-listening) TCP socket: macOS drops the SYN instead
        # of sending RST, which turns the fast-fail into a ~8s SYN-retransmit
        # timeout.
        Socket tmp();
        tmp.bind("127.0.0.1:0");
        int bad_port = tmp.getSocketInfo().port;
        delete tmp;
        Socket udp_hold();
        udp_hold.bindINET("127.0.0.1", string(bad_port), False, AF_INET, SOCK_DGRAM);
        on_exit delete udp_hold;
        string refused = "https://127.0.0.1:" + bad_port;

        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "ssl_verify_mode": 0,
            "protocol": "auto",
            "connect_timeout": 20s,
            "logger": mLogger,
        });
        on_exit delete mgr;

        date t0 = now_us();
        try {
            driveAsyncConnect(mgr, refused, 20s);
            assertTrue(False, "connect to refused port must throw");
        } catch (hash<ExceptionInfo> ex) {
            date elapsed = now_us() - t0;
            assertRegex("CONNECT-ERROR|SOCKET-CONNECT-ERROR", ex.err,
                "async HE refused error type");
            assertTrue(elapsed < 10s,
                sprintf("async HE fast-fail took %y, expected << connect_timeout 20s",
                    elapsed));
        }
    }

    testAsyncHeNonBlockingAndSyncParity() {
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "ssl_verify_mode": 0,
            "protocol": "auto",
            "logger": mLogger,
        });
        on_exit delete mgr;

        # Every acquireConnectionAsync() call must return promptly without
        # parking the calling thread (the whole point of V2): time each call.
        *HttpClientIo::HttpClientConnection cout;
        date c0 = now_us();
        *EventNotifier n = mgr.acquireConnectionAsync(mSslUrl, \cout);
        assertTrue(now_us() - c0 < 3s,
            "initial acquireConnectionAsync did not block the caller");
        int iters = 0;
        while (n) {
            assertTrue(++iters < 200, "async connect converged");
            mgr.getController().waitForNotifier(n, 15s, 45s);
            n.acknowledge();
            delete n;
            date c1 = now_us();
            n = mgr.acquireConnectionAsync(mSslUrl, \cout);
            assertTrue(now_us() - c1 < 3s,
                "acquireConnectionAsync re-entry did not block the caller");
        }
        assertTrue(cout.isReady() && inlist(cout.getProtocol(), ("h2", "h3")),
            sprintf("async HE resolved to a ready raced connection (got %y)",
                exists cout ? cout.getProtocol() : NOTHING));

        # Sync happy-eyeballs path remains unaffected: a normal synchronous
        # acquireStream() to a fresh key still establishes and works.
        HttpClientIo::HttpClientConnectionManager smgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "ssl_verify_mode": 0,
            "protocol": "auto",
            "logger": mLogger,
        });
        on_exit delete smgr;
        HttpClientIo::HttpClientStreamHandle s = smgr.acquireStream(mSslUrl);
        hash<auto> r = s.request("GET", "/simple");
        assertEq(200, r.status_code, "sync happy-eyeballs request unaffected");
    }

    testAutoProtocolPlainHttp() {
        # Bug: protocol "auto" on plain HTTP (non-TLS) must use HTTP/1.1, not attempt
        # HTTP/2 prior knowledge (h2c) which fails against HTTP/1.1-only servers.
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "protocol": "auto",
            "logger": mLogger,
        });

        # Basic GET via plain HTTP with auto protocol
        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(mHttpUrl);
        hash<auto> response = stream.request("GET", "/simple");
        assertEq(200, response.status_code, "auto plain HTTP GET /simple status code");
        assertEq("OK", response.body, "auto plain HTTP GET /simple body");

        # Verify the connection used HTTP/1.1 (not HTTP/2)
        hash<auto> stats = mgr.getStats();
        assertTrue(stats.total_connections >= 1, "auto plain HTTP created at least one connection");

        # POST with body via plain HTTP
        stream = mgr.acquireStream(mHttpUrl);
        response = stream.request("POST", "/echo", NOTHING, "plain-http-body");
        assertEq(200, response.status_code, "auto plain HTTP POST status code");
        assertRegex("body=plain-http-body", response.body, "auto plain HTTP POST body in response");

        # Second request reuses cached connection
        stream = mgr.acquireStream(mHttpUrl);
        response = stream.request("GET", "/simple");
        assertEq(200, response.status_code, "auto plain HTTP reuse request status code");
    }

    # ---- H3 End-to-End Tests ----

    testH3EndToEndBasic() {
        if (!mQuicUrl) {
            testSkip("QUIC listener not available");
        }

        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h3",
            "logger": mLogger,
        });

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(mQuicUrl);
        hash<auto> response = stream.request("GET", "/simple");
        assertEq(200, response.status_code, "H3 GET /simple status code");
        # H3 bodies are binary
        string body_str = response.body.typeCode() == NT_BINARY
            ? response.body.toString() : response.body;
        assertEq("OK", body_str, "H3 GET /simple body");

        # POST with body
        stream = mgr.acquireStream(mQuicUrl);
        response = stream.request("POST", "/echo", NOTHING, "h3-body");
        assertEq(200, response.status_code, "H3 POST status code");
        body_str = response.body.typeCode() == NT_BINARY
            ? response.body.toString() : response.body;
        assertRegex("body=h3-body", body_str, "H3 POST body in response");

        # Error response
        stream = mgr.acquireStream(mQuicUrl);
        response = stream.request("GET", "/error/404");
        assertEq(404, response.status_code, "H3 error status code");

        mgr.closeAll();
    }

    testH3EndToEndConcurrent() {
        if (!mQuicUrl) {
            testSkip("QUIC listener not available");
        }

        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h3",
            "max_connections_per_host": 1,
            "logger": mLogger,
        });
        on_exit mgr.closeAll();

        list<HttpClientIo::HttpClientStreamHandle> streams = ();
        for (int i = 0; i < 3; i++) {
            push streams, mgr.acquireStream(mQuicUrl);
        }

        Counter counter(3);
        list<hash<auto>> responses = ();
        Mutex resp_lock();

        for (int i = 0; i < 3; i++) {
            HttpClientIo::HttpClientStreamHandle stream = streams[i];
            string path = sprintf("/simple?idx=%d", i);
            background sub () {
                on_exit counter.dec();
                try {
                    hash<auto> resp = stream.request("GET", path);
                    {
                        AutoLock al(resp_lock);
                        push responses, resp;
                    }
                } catch (hash<ExceptionInfo> ex) {
                    AutoLock al(resp_lock);
                    push responses, {"error": ex.err, "desc": ex.desc};
                }
            }();
        }

        # Outer timeout must exceed the default request timeout (60s) to let threads
        # fail gracefully with their own timeout rather than the barrier expiring first
        int rc = counter.waitForZero(90s);
        if (rc != 0) {
            int completed = responses.size();
            int pending = 3 - completed;
            # Dump debug info for diagnosis
            {
                AutoLock al(resp_lock);
                stderr.printf("H3 CONCURRENT FAIL: %d/%d requests pending (waitForZero rc=%d)\n",
                    pending, 3, rc);
                foreach hash<auto> resp in (responses) {
                    if (resp.hasKey("error")) {
                        stderr.printf("  response error: %s: %s\n", resp.error, resp.desc);
                    } else {
                        stderr.printf("  response ok: status=%d\n", resp.status_code);
                    }
                }
            }
            fail(sprintf("H3 concurrent: %d/%d requests did not complete (timeout)", pending, 3));
        }

        assertEq(3, responses.size(), "H3 concurrent: all 3 responses received");
        foreach hash<auto> resp in (responses) {
            if (resp.hasKey("error")) {
                fail(sprintf("H3 concurrent request failed: %s: %s", resp.error, resp.desc));
            }
            assertEq(200, resp.status_code, "H3 concurrent request status code");
        }
    }

    # ---- Streaming Tests (HTTP/2 only) ----

    testH2StreamingBasic() {
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h2",
            "logger": mLogger,
        });
        on_exit {
            mgr.closeAll();
        }

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(mSslUrl);
        assertTrue(stream instanceof HttpClientIo::Http2ClientStreamHandle,
            "H2 stream should be Http2ClientStreamHandle");

        HttpClientIo::Http2ClientStreamHandle h2stream =
            cast<HttpClientIo::Http2ClientStreamHandle>(stream);

        int stream_id = h2stream.startStreaming("GET", "/streaming",
            {"accept": "text/plain"});
        assertTrue(stream_id > 0, "streaming stream_id should be positive");

        # Read all data from the streaming response
        string received = "";
        date end_time = now_us() + 30s;
        while (now_us() < end_time) {
            auto data = h2stream.readData(5s);
            if (!exists data) {
                continue;
            }
            if (data.typeCode() == NT_HASH && data.end_stream) {
                break;
            }
            if (data.typeCode() == NT_HASH && data.error) {
                fail(sprintf("streaming error: %y", data.error));
                break;
            }
            if (data.typeCode() == NT_BINARY) {
                received += data.toString();
            } else if (data.typeCode() == NT_STRING) {
                received += data;
            }
        }

        assertEq("chunk1|chunk2|chunk3", received, "streaming received full payload");
        assertTrue(h2stream.isDone(), "streaming should be done");
    }

    testH2StreamingStateError() {
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h2",
            "logger": mLogger,
        });
        on_exit {
            mgr.closeAll();
        }

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(mSslUrl);
        HttpClientIo::Http2ClientStreamHandle h2stream =
            cast<HttpClientIo::Http2ClientStreamHandle>(stream);

        # readData before startStreaming should throw
        assertThrows("HTTPCLIENT-STATE-ERROR", "not in streaming mode",
            \h2stream.readData(), (1s,),
            "readData before streaming should throw");

        # sendData before startStreaming should throw
        assertThrows("HTTPCLIENT-STATE-ERROR", "not in streaming mode",
            \h2stream.sendData(), ("data",),
            "sendData before streaming should throw");

        h2stream.startStreaming("GET", "/streaming");
        assertThrows("HTTPCLIENT-STATE-ERROR", "request write side is closed",
            \h2stream.sendData(), (binary("data"),),
            "sendData should reject response-only streaming requests");
        h2stream.writesDone();

        # startStreaming and read to completion so we don't leave an orphaned stream
        date end_time = now_us() + 10s;
        while (now_us() < end_time && !h2stream.isDone()) {
            auto data = h2stream.readData(1s);
            if (exists data && data.typeCode() == NT_HASH && data.end_stream) {
                break;
            }
        }
    }

    # ---- Cancellation Tests ----

    testStreamCancelBeforeResponse() {
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h2",
            "logger": mLogger,
        });

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(mSslUrl);
        HttpClientIo::HttpClientConnection conn = stream.getConnection();

        # Wait for connection to become ready
        assertTrue(conn.waitForReady(30s), "connection should become ready");

        # Submit async request to slow handler (takes 2s)
        stream.submitAsync("GET", "/slow/2000");

        # Cancel immediately before response arrives — the Future will be
        # rejected with HTTP3-CANCELLED via the PromiseAction
        stream.cancel();

        # Verify state — stream is done (either Cancelled or Error depending on
        # whether the callback fired and set Error via handleResponse)
        assertTrue(stream.isDone(), "cancelled stream should be done");
        HttpClientIo::HttpClientStreamState final_state = stream.getState();
        assertTrue(final_state == HttpClientIo::HttpClientStreamState::Cancelled
            || final_state == HttpClientIo::HttpClientStreamState::Error,
            sprintf("stream should be in Cancelled or Error state, got: %y", final_state));
    }

    testStreamCancelAfterCompletion() {
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h2",
            "logger": mLogger,
        });

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(mSslUrl);
        hash<auto> response = stream.request("GET", "/simple");
        assertEq(200, response.status_code, "request completed successfully");

        # Cancel after completion should be a no-op (no exception)
        stream.cancel();
        assertTrue(stream.isDone(), "stream should still be done after cancel");
    }

    # ---- Capacity and Idle Cleanup Tests ----

    testCapacityError() {
        # Create manager with very tight limits: 1 connection, 1 stream max
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h2",
            "max_connections_per_host": 1,
            "max_streams_per_connection": 1,
            "logger": mLogger,
        });

        # Acquire first stream and start a slow request in the background
        HttpClientIo::HttpClientStreamHandle stream1 = mgr.acquireStream(mSslUrl);
        HttpClientIo::HttpClientConnection conn = stream1.getConnection();
        assertTrue(conn.waitForReady(30s), "connection should become ready");

        hash<auto> result = stream1.submitAsync("GET", "/slow/3000");

        # Now the single connection has 1 active stream (at its max of 1),
        # and we're at the connection limit (1). Acquiring another stream should fail.
        assertThrows("HTTPCLIENT-CAPACITY-ERROR", \mgr.acquireStream(), (mSslUrl,),
            "should throw capacity error when all connections at stream limit");

        # Wait for the slow request to complete (controller drives I/O)
        result.future.get(10s);
    }

    testCleanupIdleWithConnections() {
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h2",
            "idle_timeout": 0s,  # Zero timeout: any past last_activity is idle
            "logger": mLogger,
        });

        # Create a connection by making a request
        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(mSslUrl);
        hash<auto> response = stream.request("GET", "/simple");
        assertEq(200, response.status_code, "initial request succeeded");

        hash<auto> stats = mgr.getStats();
        assertTrue(stats.total_connections >= 1, "should have at least 1 connection");

        # Cleanup should remove idle connections (last_activity < now_us() is always
        # true since the request completed in the past)
        mgr.cleanupIdleConnections();

        stats = mgr.getStats();
        assertEq(0, stats.total_connections, "idle connections should be cleaned up");
    }

    #! Investigation: does the *existing* peer-close path remove the
    #! connection from the pool via handleConnectionResult(), without any new
    #! Fix B logic?  This is the baseline we need working before Fix B's
    #! HTTP1-IDLE-TIMEOUT path can work — both paths rely on the same chain:
    #!   setError / h1_state=CLOSED -> continuePoll returns nullptr ->
    #!   controller dispatches onComplete -> handleCompletion ->
    #!   handleConnectionResult -> removeConnectionFromPool.
    #!
    #! If this test fails, there's a pre-existing gap in close-detection and
    #! Fix B's failures are the same root cause, not new bugs.  If this test
    #! passes, Fix B's IDLE-TIMEOUT path diverges from the working pattern and
    #! I need to diff them.
    testH1ConnectionCloseRemovesFromPool() {
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "protocol": "h1",
            "logger": mLogger,
        });
        on_exit mgr.closeAll();

        # /close handler returns "Connection: close" — H1 server-initiated close
        # after the response.  dispatchResponse() sees connection_close=true
        # and transitions h1_state to CLOSED; controller calls onComplete;
        # handleConnectionResult should remove from the pool.
        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(mHttpUrl);
        hash<auto> response = stream.request("GET", "/close");
        assertEq(200, response.status_code, "initial H1 request succeeded");

        # handleConnectionResult runs on a worker thread dispatched by the
        # I/O controller — it races with the return from stream.request().
        # Poll the stats with a retry loop instead of sleeping for a fixed
        # duration so the test is neither flaky nor unnecessarily slow.
        int total_connections = waitForPoolToBeEmpty(mgr, 3s);
        assertEq(0, total_connections,
            "connection should be removed from pool after Connection:close");
    }

    #! Poll mgr.getStats().total_connections until it reaches 0 or the
    #! deadline elapses.  Returns the final count (0 on success, >0 on
    #! timeout).  Used by tests that rely on async worker dispatch to
    #! remove closed connections from the pool.
    private int waitForPoolToBeEmpty(HttpClientIo::HttpClientConnectionManager mgr,
            timeout max_wait) {
        date deadline = now_us() + max_wait;
        int total_connections;
        while (True) {
            total_connections = mgr.getStats().total_connections;
            if (!total_connections || now_us() >= deadline) {
                return total_connections;
            }
            usleep(10ms);
        }
    }

    #! Verifies the nginx-style proactive idle-timeout on H1 connections.
    /** The poll operation's handleIdle() arms a deadline when the connection
        enters the idle sub-state with no pending request.  When the deadline
        elapses, handleIdle() closes the connection proactively with an
        HTTP1-IDLE-TIMEOUT error, the controller removes it from the pool,
        and the next request creates a fresh connection.

        This test sets idle_timeout to 500ms and verifies:
          - after a request, total_connections >= 1
          - after sleeping idle_timeout * 3, total_connections == 0
          - a subsequent request succeeds (new connection is created)
    */
    testH1ProactiveIdleTimeout() {
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "protocol": "h1",
            "idle_timeout": 500ms,
            "logger": mLogger,
        });
        on_exit mgr.closeAll();

        # Initial request creates a pooled H1 connection
        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(mHttpUrl);
        hash<auto> response = stream.request("GET", "/simple");
        assertEq(200, response.status_code, "initial H1 request succeeded");

        hash<auto> stats = mgr.getStats();
        assertTrue(stats.total_connections >= 1,
            "should have at least 1 H1 connection after initial request");

        # The I/O thread wakes via the controller's poll_timeout_ms hint when
        # the idle deadline elapses, handleIdle fires HTTP1-IDLE-TIMEOUT, the
        # connection is closed, and handleConnectionResult removes it from
        # the pool on a dispatcher worker thread.  Poll with a retry loop
        # to avoid a racy fixed sleep.
        int total_connections = waitForPoolToBeEmpty(mgr, 3s);
        assertEq(0, total_connections,
            "pool should be empty after proactive idle timeout");

        # Subsequent request must still succeed by creating a fresh connection
        stream = mgr.acquireStream(mHttpUrl);
        response = stream.request("GET", "/simple");
        assertEq(200, response.status_code,
            "request after idle-timeout eviction should create a new connection");
    }

    #! Verifies the nginx-style proactive idle-timeout on H2 connections.
    /** Same semantics as testH1ProactiveIdleTimeout() but over HTTPS/H2.
        The H2 poll operation's handleReading() applies applyIdleTimeout()
        on the post-drain return path; when active_stream_count is 0 for
        longer than idle_timeout, it closes the connection with
        HTTP2-IDLE-TIMEOUT.
    */
    testH2ProactiveIdleTimeout() {
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h2",
            "idle_timeout": 500ms,
            "logger": mLogger,
        });
        on_exit mgr.closeAll();

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(mSslUrl);
        hash<auto> response = stream.request("GET", "/simple");
        assertEq(200, response.status_code, "initial H2 request succeeded");

        hash<auto> stats = mgr.getStats();
        assertTrue(stats.total_connections >= 1,
            "should have at least 1 H2 connection after initial request");

        int total_connections = waitForPoolToBeEmpty(mgr, 3s);
        assertEq(0, total_connections,
            "pool should be empty after proactive H2 idle timeout");

        stream = mgr.acquireStream(mSslUrl);
        response = stream.request("GET", "/simple");
        assertEq(200, response.status_code,
            "H2 request after idle-timeout eviction should create a new connection");
    }

    #! Verifies max_age (born-at TTL) eviction at pool checkout.
    /** Sets idle_timeout long (so the proactive idle close does NOT fire
        during the test) and max_age short.  After sleeping past max_age,
        the second acquireStream must NOT reuse the now-too-old connection
        — it gets a different connection ID.

        The Qore conn-mgr's reuse loop evicts connections that fail
        isConnectionAlive() in the same pass (via evictConnections), so
        total_connections stays at 1: the old too-old connection is
        replaced, not added to.  The proof is the connection ID change.
    */
    testMaxAgeEvictionAtCheckout() {
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "protocol": "h1",
            # Long idle_timeout so neither the proactive idle close nor
            # maybeCleanupIdle fires during the test window.
            "idle_timeout": 60s,
            "max_age": 500ms,
            "logger": mLogger,
        });
        on_exit mgr.closeAll();

        HttpClientIo::HttpClientStreamHandle s1 = mgr.acquireStream(mHttpUrl);
        hash<auto> r1 = s1.request("GET", "/simple");
        assertEq(200, r1.status_code);
        int id1 = s1.getConnection().getConnectionId();

        # Sleep past max_age but well within idle_timeout
        usleep(700ms);

        HttpClientIo::HttpClientStreamHandle s2 = mgr.acquireStream(mHttpUrl);
        hash<auto> r2 = s2.request("GET", "/simple");
        assertEq(200, r2.status_code);
        int id2 = s2.getConnection().getConnectionId();

        assertNeq(id1, id2,
            "after sleeping past max_age, the next request must run on a "
            "different connection (max-age-expired connection evicted "
            "from reuse)");
    }

    #! Verifies max_age=0 (default) does not change reuse behaviour.
    testMaxAgeDisabledReusesConnection() {
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "protocol": "h1",
            "idle_timeout": 60s,
            # max_age omitted → defaults to 0s (disabled)
            "logger": mLogger,
        });
        on_exit mgr.closeAll();

        HttpClientIo::HttpClientStreamHandle s1 = mgr.acquireStream(mHttpUrl);
        s1.request("GET", "/simple");
        int id1 = s1.getConnection().getConnectionId();
        usleep(700ms);
        HttpClientIo::HttpClientStreamHandle s2 = mgr.acquireStream(mHttpUrl);
        s2.request("GET", "/simple");
        int id2 = s2.getConnection().getConnectionId();
        assertEq(id1, id2,
            "with max_age disabled, the second request must reuse the "
            "first connection");
    }

