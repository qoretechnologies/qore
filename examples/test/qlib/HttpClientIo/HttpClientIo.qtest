    testDoubleStartStreaming() {
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h2",
            "logger": mLogger,
        });

        auto stream = mgr.acquireStream(mSslUrl);
        assertEq(True, stream instanceof HttpClientIo::Http2ClientStreamHandle,
            "should be Http2ClientStreamHandle");
        HttpClientIo::Http2ClientStreamHandle h2stream =
            cast<HttpClientIo::Http2ClientStreamHandle>(stream);

        # Start streaming
        h2stream.startStreaming("GET", "/streaming", {"accept": "text/event-stream"});

        # Second startStreaming should throw (stream already in use)
        assertThrows("HTTPCLIENT-STATE-ERROR",
            \h2stream.startStreaming(), ("GET", "/streaming"),
            "double startStreaming should throw");

        # Read to completion to clean up
        while (True) {
            auto data = h2stream.readData(5s);
            if (!exists data) {
                break;
            }
            if (data.typeCode() == NT_HASH && data.end_stream) {
                break;
            }
        }
    }

    testGetConnectionInfo() {
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h2",
            "logger": mLogger,
        });

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(mSslUrl);
        HttpClientIo::HttpClientConnection conn = stream.getConnection();

        # Wait for connection to become ready
        assertTrue(conn.waitForReady(30s), "connection should become ready");

        hash<HttpClientIo::HttpClientConnectionInfo> info = conn.getConnectionInfo();
        assertEq("127.0.0.1", info.host, "host should be 127.0.0.1");
        assertEq(mSslPort, info.port, "port should match");
        assertEq(HttpClientIo::HttpClientConnectionState::Ready, info.state,
            "state should be Ready");
        assertEq("h2", info.protocol, "protocol should be h2");
        assertTrue(info.ssl, "ssl should be True");
        assertTrue(info.connection_id > 0, "connection_id should be positive");
        assertEq(0, info.active_streams, "no active streams yet");
    }

    testStreamCancelDuringReadiness() {
        # Test that cancel() before request submission is handled correctly
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h2",
            "logger": mLogger,
        });

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(mSslUrl);

        # Cancel immediately (before any request is submitted)
        stream.cancel();
        assertEq(HttpClientIo::HttpClientStreamState::Cancelled, stream.getState(),
            "stream should be in Cancelled state");

        # Trying to submit after cancel should throw (state is Cancelled, not Pending)
        assertThrows("HTTPCLIENT-STATE-ERROR",
            \stream.request(), ("GET", "/simple"),
            "request after cancel should throw");
    }

