    testControllerModeTimeout() {
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h2",
            "logger": mLogger,
        });

        on_exit {
            mgr.closeAll();
        }

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(mSslUrl);
        bool timed_out = False;
        try {
            # /slow/5000 waits 5 seconds, we timeout after 500ms
            stream.request("GET", "/slow/5000", NOTHING, NOTHING, 500ms);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "HTTPCLIENT-TIMEOUT") {
                timed_out = True;
            }
        }
        assertTrue(timed_out, "controller mode: request should timeout");
    }

    # ---- Auto Protocol Selection Tests ----

    testAutoProtocolFallback() {
        # With auto protocol, the manager will try H3 first then fall back to H2 if needed.
        # Against our test server (which supports both protocols), H3 may succeed.
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "auto",
            "logger": mLogger,
        });

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(mSslUrl);
        hash<auto> response = stream.request("GET", "/simple");
        assertEq(200, response.status_code, "auto protocol GET /simple status code");

        # Body may be string (H2) or binary (H3) depending on which protocol was selected
        string body_str;
        if (response.body.typeCode() == NT_BINARY) {
            body_str = response.body.toString();
        } else {
            body_str = response.body;
        }
        assertEq("OK", body_str, "auto protocol GET /simple body");

        # Verify connection was created
        hash<auto> stats = mgr.getStats();
        assertTrue(stats.total_connections >= 1, "auto protocol created at least one connection");

        # Test second request uses cached protocol (reuses connection)
        stream = mgr.acquireStream(mSslUrl);
        response = stream.request("GET", "/simple");
        assertEq(200, response.status_code, "auto protocol cached request status code");
    }

    # ---- H3 End-to-End Tests ----

    testH3EndToEndBasic() {
        if (!mQuicUrl) {
            testSkip("QUIC listener not available");
        }

        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h3",
            "logger": mLogger,
        });

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(mQuicUrl);
        hash<auto> response = stream.request("GET", "/simple");
        assertEq(200, response.status_code, "H3 GET /simple status code");
        # H3 bodies are binary
        string body_str = response.body.typeCode() == NT_BINARY
            ? response.body.toString() : response.body;
        assertEq("OK", body_str, "H3 GET /simple body");

        # POST with body
        stream = mgr.acquireStream(mQuicUrl);
        response = stream.request("POST", "/echo", NOTHING, "h3-body");
        assertEq(200, response.status_code, "H3 POST status code");
        body_str = response.body.typeCode() == NT_BINARY
            ? response.body.toString() : response.body;
        assertRegex("body=h3-body", body_str, "H3 POST body in response");

        # Error response
        stream = mgr.acquireStream(mQuicUrl);
        response = stream.request("GET", "/error/404");
        assertEq(404, response.status_code, "H3 error status code");
    }

    testH3EndToEndConcurrent() {
        if (!mQuicUrl) {
            testSkip("QUIC listener not available");
        }

        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h3",
            "max_connections_per_host": 1,
            "logger": mLogger,
        });

        list<HttpClientIo::HttpClientStreamHandle> streams = ();
        for (int i = 0; i < 3; i++) {
            push streams, mgr.acquireStream(mQuicUrl);
        }

        Counter counter(3);
        list<hash<auto>> responses = ();
        Mutex resp_lock();

        for (int i = 0; i < 3; i++) {
            HttpClientIo::HttpClientStreamHandle stream = streams[i];
            string path = sprintf("/simple?idx=%d", i);
            background sub () {
                on_exit counter.dec();
                try {
                    hash<auto> resp = stream.request("GET", path);
                    {
                        AutoLock al(resp_lock);
                        push responses, resp;
                    }
                } catch (hash<ExceptionInfo> ex) {
                    AutoLock al(resp_lock);
                    push responses, {"error": ex.err, "desc": ex.desc};
                }
            }();
        }

        int remaining = counter.waitForZero(30s);
        if (remaining > 0) {
            # Dump debug info for diagnosis
            {
                AutoLock al(resp_lock);
                stderr.printf("H3 CONCURRENT FAIL: %d remaining, %d responses collected\n",
                    remaining, responses.size());
                foreach hash<auto> resp in (responses) {
                    if (resp.hasKey("error")) {
                        stderr.printf("  response error: %s: %s\n", resp.error, resp.desc);
                    } else {
                        stderr.printf("  response ok: status=%d\n", resp.status_code);
                    }
                }
            }
            # Dump connection info
            try {
                hash<auto> info = mgr.getConnectionInfo();
                stderr.printf("  connection info: %y\n", info);
            } catch () {}
            mgr.closeAll();
            fail(sprintf("H3 concurrent: %d requests did not complete", remaining));
        }
        on_exit mgr.closeAll();

        assertEq(3, responses.size(), "H3 concurrent: all 3 responses received");
        foreach hash<auto> resp in (responses) {
            if (resp.hasKey("error")) {
                fail(sprintf("H3 concurrent request failed: %s: %s", resp.error, resp.desc));
            }
            assertEq(200, resp.status_code, "H3 concurrent request status code");
        }
    }

    # ---- Streaming Tests (HTTP/2 only) ----

    testH2StreamingBasic() {
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h2",
            "logger": mLogger,
        });
        on_exit {
            mgr.closeAll();
        }

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(mSslUrl);
        assertTrue(stream instanceof HttpClientIo::Http2ClientStreamHandle,
            "H2 stream should be Http2ClientStreamHandle");

        HttpClientIo::Http2ClientStreamHandle h2stream =
            cast<HttpClientIo::Http2ClientStreamHandle>(stream);

        int stream_id = h2stream.startStreaming("GET", "/streaming",
            {"accept": "text/plain"});
        assertTrue(stream_id > 0, "streaming stream_id should be positive");

        # Read all data from the streaming response
        string received = "";
        date end_time = now_us() + 30s;
        while (now_us() < end_time) {
            auto data = h2stream.readData(5s);
            if (!exists data) {
                continue;
            }
            if (data.typeCode() == NT_HASH && data.end_stream) {
                break;
            }
            if (data.typeCode() == NT_HASH && data.error) {
                fail(sprintf("streaming error: %y", data.error));
                break;
            }
            if (data.typeCode() == NT_BINARY) {
                received += data.toString();
            } else if (data.typeCode() == NT_STRING) {
                received += data;
            }
        }

        assertEq("chunk1|chunk2|chunk3", received, "streaming received full payload");
        assertTrue(h2stream.isDone(), "streaming should be done");
    }

    testH2StreamingStateError() {
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h2",
            "logger": mLogger,
        });
        on_exit {
            mgr.closeAll();
        }

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(mSslUrl);
        HttpClientIo::Http2ClientStreamHandle h2stream =
            cast<HttpClientIo::Http2ClientStreamHandle>(stream);

        # readData before startStreaming should throw
        assertThrows("HTTPCLIENT-STATE-ERROR", "not in streaming mode",
            \h2stream.readData(), (1s,),
            "readData before streaming should throw");

        # sendData before startStreaming should throw
        assertThrows("HTTPCLIENT-STATE-ERROR", "not in streaming mode",
            \h2stream.sendData(), ("data",),
            "sendData before streaming should throw");

        # startStreaming and read to completion so we don't leave an orphaned stream
        h2stream.startStreaming("GET", "/streaming");
        date end_time = now_us() + 10s;
        while (now_us() < end_time && !h2stream.isDone()) {
            auto data = h2stream.readData(1s);
            if (exists data && data.typeCode() == NT_HASH && data.end_stream) {
                break;
            }
        }
    }

    # ---- Cancellation Tests ----

    testStreamCancelBeforeResponse() {
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h2",
            "logger": mLogger,
        });

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(mSslUrl);
        HttpClientIo::HttpClientConnection conn = stream.getConnection();

        # Wait for connection to become ready
        assertTrue(conn.waitForReady(30s), "connection should become ready");

        # Submit async request to slow handler (takes 2s)
        Counter counter(1);
        *hash<auto> callback_response;
        *hash<auto> callback_error;

        stream.submitAsync("GET", "/slow/2000", NOTHING, NOTHING,
            sub (hash<auto> resp, *hash<auto> err) {
                callback_response = resp;
                callback_error = err;
                counter.dec();
            });

        # Cancel immediately before response arrives — this synchronously fires
        # the cancellation callback via cancelRequest(), which calls handleResponse()
        # with an error, transitioning state from Cancelled to Error
        stream.cancel();

        # Verify state — stream is done (either Cancelled or Error depending on
        # whether the callback fired and set Error via handleResponse)
        assertTrue(stream.isDone(), "cancelled stream should be done");
        HttpClientIo::HttpClientStreamState final_state = stream.getState();
        assertTrue(final_state == HttpClientIo::HttpClientStreamState::Cancelled
            || final_state == HttpClientIo::HttpClientStreamState::Error,
            sprintf("stream should be in Cancelled or Error state, got: %y", final_state));
    }

    testStreamCancelAfterCompletion() {
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h2",
            "logger": mLogger,
        });

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(mSslUrl);
        hash<auto> response = stream.request("GET", "/simple");
        assertEq(200, response.status_code, "request completed successfully");

        # Cancel after completion should be a no-op (no exception)
        stream.cancel();
        assertTrue(stream.isDone(), "stream should still be done after cancel");
    }

    # ---- Capacity and Idle Cleanup Tests ----

    testCapacityError() {
        # Create manager with very tight limits: 1 connection, 1 stream max
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h2",
            "max_connections_per_host": 1,
            "max_streams_per_connection": 1,
            "logger": mLogger,
        });

        # Acquire first stream and start a slow request in the background
        HttpClientIo::HttpClientStreamHandle stream1 = mgr.acquireStream(mSslUrl);
        HttpClientIo::HttpClientConnection conn = stream1.getConnection();
        assertTrue(conn.waitForReady(30s), "connection should become ready");

        Counter counter(1);
        stream1.submitAsync("GET", "/slow/3000", NOTHING, NOTHING,
            sub (hash<auto> resp, *hash<auto> err) {
                counter.dec();
            });

        # Now the single connection has 1 active stream (at its max of 1),
        # and we're at the connection limit (1). Acquiring another stream should fail.
        assertThrows("HTTPCLIENT-CAPACITY-ERROR", \mgr.acquireStream(), (mSslUrl,),
            "should throw capacity error when all connections at stream limit");

        # Wait for the slow request to complete (controller drives I/O)
        counter.waitForZero(10s);
    }

    testCleanupIdleWithConnections() {
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h2",
            "idle_timeout": 0s,  # Zero timeout: any past last_activity is idle
            "logger": mLogger,
        });

        # Create a connection by making a request
        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(mSslUrl);
        hash<auto> response = stream.request("GET", "/simple");
        assertEq(200, response.status_code, "initial request succeeded");

        hash<auto> stats = mgr.getStats();
        assertTrue(stats.total_connections >= 1, "should have at least 1 connection");

        # Cleanup should remove idle connections (last_activity < now_us() is always
        # true since the request completed in the past)
        mgr.cleanupIdleConnections();

        stats = mgr.getStats();
        assertEq(0, stats.total_connections, "idle connections should be cleaned up");
    }

