        const Variants = ("plain", "gzip", "chunked");

        HttpServer server;
        RawServer raw_server;
        int port;
        int tls_port;
    }

    constructor() : Test("HttpBodyCharsetTest", "1.0") {
        addTestCase("HTTPClient over HTTP/1.1", \httpClientHttp1Test());
        addTestCase("HTTPClient over HTTP/2", \httpClientHttp2Test());
        addTestCase("HTTPClient receive callback", \httpClientRecvCallbackTest());
        addTestCase("HTTPClient poll operation", \httpClientPollTest());
        addTestCase("HttpClientIo over HTTP/1.1", \httpClientIoHttp1Test());
        addTestCase("HttpClientIo over HTTP/2", \httpClientIoHttp2Test());
        addTestCase("HttpClientIo stream handle", \httpClientIoStreamTest());
        addTestCase("HttpClientIo octets", \httpClientIoOctetsTest());
        addTestCase("HttpClientIo text decoding", \decodeResponseTextTest());
        addTestCase("no Content-Type", \noContentTypeTest());
        addTestCase("RestClient", \restClientTest());
        addTestCase("RestClientIo", \restClientIoTest());
        addTestCase("RestClientIo raw body", \restClientIoRawBodyTest());
        addTestCase("assumed encoding", \assumedEncodingTest());
        set_return_value(main());
    }

    globalSetUp() {
        server = new HttpServer(<HttpServerOptionInfo>{
            "logger": new Logger("server", LoggerLevel::getLevelError()),
        });
        TestHandler handler();
        server.setHandler("test", "", NOTHING, handler);
        server.setDefaultHandler("test", handler);
        port = server.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        tls_port = server.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        }).port;
        server.waitForAsyncIo();
        raw_server = new RawServer();
    }

    globalTearDown() {
        raw_server.stop();
        delete server;
    }

    # checks a decoded body against the expected result of the case
    private checkBody(auto body, hash<CharsetCase> c, string label) {
        if (c.encoding) {
            assertEq(NT_STRING, body.typeCode(), label);
            assertEq(c.encoding, body.encoding(), label);
            assertEq(c.text, convert_encoding(body, "UTF-8"), label);
        } else {
            assertEq(NT_BINARY, body.typeCode(), label);
            assertEq(c.body, body, label);
        }
    }

    # checks all cases and variants with the given function returning the body for a path; the cases without a
    # Content-Type are checked only with the raw server
    private checkAll(code get_body, string label, bool raw = False) {
        foreach string name in (keys TestHandler::Cases) {
            hash<CharsetCase> c = TestHandler::Cases{name};
            if (!raw && !c.content_type) {
                continue;
            }
            foreach string variant in (Variants) {
                string path = sprintf("/%s/%s", name, variant);
                checkBody(get_body(path), c, sprintf("%s %s", label, path));
            }
        }
    }

    private string getRawUrl() {
        return "http://127.0.0.1:" + raw_server.port;
    }

    private string getUrl() {
        return "http://localhost:" + port;
    }

    private string getTlsUrl() {
        return "https://localhost:" + tls_port;
    }

    private HTTPClient getHttpClient(string url, *hash<auto> opts) {
        return new HTTPClient({
            "url": url,
            "ssl_verify_cert": False,
            "timeout": 30s,
        } + opts);
    }

    httpClientHttp1Test() {
        HTTPClient hc = getHttpClient(getUrl(), {"http_version": "1.1"});
        checkAll(auto sub (string path) { return hc.send(NOTHING, "GET", path).body; }, "HTTPClient h1");
        assertEq("HTTP/1.1", hc.getHttpVersion());
    }

    httpClientHttp2Test() {
        HTTPClient hc = getHttpClient(getTlsUrl(), {"http_version": "2.0"});
        hc.setHttp3Mode("disabled");
        checkAll(auto sub (string path) { return hc.send(NOTHING, "GET", path).body; }, "HTTPClient h2");
        assertTrue(hc.isHttp2Active());
    }

    httpClientRecvCallbackTest() {
        foreach hash<auto> i in ({"url": getUrl(), "opts": {"http_version": "1.1"}, "label": "h1"},
                {"url": getTlsUrl(), "opts": {"http_version": "2.0"}, "label": "h2"}) {
            HTTPClient hc = getHttpClient(i.url, i.opts);
            hc.setHttp3Mode("disabled");
            checkAll(auto sub (string path) {
                auto body;
                code recv = sub (hash<auto> msg) {
                    if (exists msg."data") {
                        body = exists body ? body + msg."data" : msg."data";
                    }
                };
                hc.sendWithRecvCallback(recv, NOTHING, "GET", path);
                return body;
            }, "HTTPClient recv callback " + i.label);
        }
    }

    httpClientPollTest() {
        HTTPClient hc = getHttpClient(getUrl(), {"http_version": "1.1"});
        checkAll(auto sub (string path) {
            AbstractPollOperation op = hc.startPollSendRecv("GET", path);
            date deadline = now_us() + 30s;
            while (*hash<SocketPollInfo> info = op.continuePoll()) {
                if (now_us() > deadline) {
                    throw "TIMEOUT", sprintf("GET %s did not complete", path);
                }
                Socket::poll((info,), deadline - now_us());
            }
            assertTrue(op.goalReached());
            return op.getOutput()."response-body";
        }, "HTTPClient poll");
    }

    # the cases without a Content-Type, and all others, over HTTP/1.1 from a server that does not add a type
    noContentTypeTest() {
        HTTPClient hc = getHttpClient(getRawUrl(), {"http_version": "1.1"});
        checkAll(auto sub (string path) { return hc.send(NOTHING, "GET", path).body; }, "HTTPClient raw", True);
        checkAll(auto sub (string path) {
            auto body;
            code recv = sub (hash<auto> msg) {
                if (exists msg."data") {
                    body = exists body ? body + msg."data" : msg."data";
                }
            };
            hc.sendWithRecvCallback(recv, NOTHING, "GET", path);
            return body;
        }, "HTTPClient recv callback raw", True);
        checkAll(auto sub (string path) {
            AbstractPollOperation op = hc.startPollSendRecv("GET", path);
            while (*hash<SocketPollInfo> info = op.continuePoll()) {
                Socket::poll((info,), 30s);
            }
            return op.getOutput()."response-body";
        }, "HTTPClient poll raw", True);

        HttpClientConnectionManager mgr = getManager({"protocol": "h1"});
        checkAll(auto sub (string path) { return mgr.request(getRawUrl(), "GET", path).body; }, "HttpClientIo raw",
            True);

        # the assumed encoding applies to text without a type
        hc.setAssumedEncoding("ISO-8859-15");
        string body = hc.send(NOTHING, "GET", "/none-text/gzip").body;
        assertEq("ISO-8859-15", body.encoding());
        mgr = getManager({"protocol": "h1", "assume_encoding": "ISO-8859-15"});
        body = mgr.request(getRawUrl(), "GET", "/none-text/chunked").body;
        assertEq("ISO-8859-15", body.encoding());
        # binary data is not affected
        assertEq(TestHandler::Cases."none-binary".body, mgr.request(getRawUrl(), "GET", "/none-binary/plain").body);
    }

    private HttpClientConnectionManager getManager(*hash<auto> opts) {
        return new HttpClientConnectionManager(cast<hash<HttpClientConnectionManagerOptions>>({
            "request_timeout": 30s,
            "ssl_verify_mode": SSL_VERIFY_NONE,
        } + opts));
    }

    httpClientIoHttp1Test() {
        HttpClientConnectionManager mgr = getManager({"protocol": "h1"});
        checkAll(auto sub (string path) { return mgr.request(getUrl(), "GET", path).body; }, "HttpClientIo h1");
        checkAll(auto sub (string path) { return mgr.requestAsync(getUrl(), "GET", path).get(30s).body; },
            "HttpClientIo h1 future");
    }

    httpClientIoHttp2Test() {
        HttpClientConnectionManager mgr = getManager({"protocol": "h2"});
        checkAll(auto sub (string path) {
            hash<auto> resp = mgr.request(getTlsUrl(), "GET", path);
            assertEq("h2", resp.protocol, path);
            return resp.body;
        }, "HttpClientIo h2");
    }

    httpClientIoStreamTest() {
        foreach hash<auto> i in ({"url": getUrl(), "protocol": "h1"},
                {"url": getTlsUrl(), "protocol": "h2"}) {
            HttpClientConnectionManager mgr = getManager({"protocol": i.protocol});
            # a stream handle carries one request
            checkAll(auto sub (string path) {
                HttpClientStreamHandle stream = mgr.acquireStream(i.url);
                return stream.submitAsync("GET", path).future.get(30s).body;
            }, "HttpClientIo stream " + i.protocol);
        }
    }

    # checks all cases and variants with the given function returning a response body as octets: the body as sent,
    # after any content encoding is decoded, including any byte order mark
    private checkOctets(code get_body, string label, bool raw = False) {
        foreach string name in (keys TestHandler::Cases) {
            hash<CharsetCase> c = TestHandler::Cases{name};
            if (!raw && !c.content_type) {
                continue;
            }
            foreach string variant in (Variants) {
                string path = sprintf("/%s/%s", name, variant);
                auto body = get_body(path);
                assertEq(NT_BINARY, body.typeCode(), sprintf("%s %s", label, path));
                assertEq(c.body, body, sprintf("%s %s", label, path));
            }
        }
    }

    # a request for the octets of the body receives them unchanged over each protocol and API, and the default
    # still decodes text
    httpClientIoOctetsTest() {
        foreach hash<auto> i in ({"url": getUrl(), "protocol": "h1"}, {"url": getTlsUrl(), "protocol": "h2"},
                {"url": getRawUrl(), "protocol": "h1", "raw": True}) {
            string label = i.protocol + (i.raw ? " raw" : "");
            HttpClientConnectionManager mgr = getManager({"protocol": i.protocol});
            checkOctets(auto sub (string path) {
                hash<auto> resp = mgr.request(i.url, "GET", path, NOTHING, NOTHING, NOTHING, False);
                assertEq(i.protocol, resp.protocol, path);
                return resp.body;
            }, "request octets " + label, i.raw);
            checkOctets(auto sub (string path) {
                return mgr.requestAsync(i.url, "GET", path, NOTHING, NOTHING, False).get(30s).body;
            }, "requestAsync octets " + label, i.raw);
            checkOctets(auto sub (string path) {
                return mgr.submitRequestAsync(i.url, "GET", path, NOTHING, NOTHING, False).future.get(30s).body;
            }, "submitRequestAsync octets " + label, i.raw);
            checkOctets(auto sub (string path) {
                HttpClientStreamHandle stream = mgr.acquireStream(i.url);
                assertTrue(stream.getDecodeText());
                stream.setDecodeText(False);
                assertFalse(stream.getDecodeText());
                return stream.submitAsync("GET", path).future.get(30s).body;
            }, "stream octets " + label, i.raw);
            # the octets decode to the text that a request decoding text returns
            checkAll(auto sub (string path) {
                hash<auto> resp = mgr.request(i.url, "GET", path, NOTHING, NOTHING, NOTHING, False);
                return HttpClientStreamHandle::decodeResponseText(resp).body;
            }, "decoded octets " + label, i.raw);
            # the same manager and connections still decode text by default
            checkAll(auto sub (string path) { return mgr.request(i.url, "GET", path).body; }, "default " + label,
                i.raw);
        }
    }

    # the text decoding of a response whose body has been received as octets
    decodeResponseTextTest() {
        # a character encoding sent as the content encoding of the body is its charset, as with HTTPClient
        hash<auto> resp = HttpClientStreamHandle::decodeResponseText({
            "headers": {"content-encoding": "iso-8859-2"},
            "body": <b1>,
        });
        assertEq("ISO-8859-2", resp.body.encoding());
        assertEq("ą", convert_encoding(resp.body, "UTF-8"));
        # a charset parameter takes precedence
        resp = HttpClientStreamHandle::decodeResponseText({
            "headers": {"content-type": "text/plain;charset=utf-8", "content-encoding": "iso-8859-2"},
            "body": <c3a4>,
        });
        assertEq("ä", resp.body);
        # the last Content-Type of a header sent more than once is used
        resp = HttpClientStreamHandle::decodeResponseText({
            "headers": {"content-type": ("image/png", "text/plain;charset=utf-8")},
            "body": <c3a4>,
        });
        assertEq("ä", resp.body);
        # the assumed encoding applies to text without a declaration
        resp = HttpClientStreamHandle::decodeResponseText({
            "headers": {"content-type": "text/plain"},
            "body": <a4>,
        }, "ISO-8859-15");
        assertEq("€", convert_encoding(resp.body, "UTF-8"));
        # binary data, an empty body, and a string body are not changed
        assertEq(<89504e47>, HttpClientStreamHandle::decodeResponseText({
            "headers": {"content-type": "image/png"},
            "body": <89504e47>,
        }).body);
        assertEq(binary(), HttpClientStreamHandle::decodeResponseText({"headers": {}, "body": binary()}).body);
        assertEq("text", HttpClientStreamHandle::decodeResponseText({"headers": {}, "body": "text"}).body);
        # normalizeResponseBody() decompresses the body and keeps its octets when text is not decoded
        resp = HttpClientStreamHandle::normalizeResponseBody({
            "headers": {"content-type": "text/plain", "content-encoding": "gzip"},
            "body": gzip(<efbbbfc3a4>),
        }, 0, "ISO-8859-1", False);
        assertEq(<efbbbfc3a4>, resp.body);
        assertEq("text/plain", resp.content_type);
    }

    # the cases that REST clients return as decoded, without deserializing them to other values
    private list<string> getRestCases() {
        return select keys TestHandler::Cases, TestHandler::Cases{$1}.content_type =~ /^(text\/plain|application\/octet-stream)/;
    }

    private checkRest(code get_body, string label) {
        foreach string name in (getRestCases()) {
            hash<CharsetCase> c = TestHandler::Cases{name};
            foreach string variant in (Variants) {
                string path = sprintf("/%s/%s", name, variant);
                checkBody(get_body(path), c, sprintf("%s %s", label, path));
            }
        }
        # JSON is deserialized from UTF-8 regardless of the charset parameter
        foreach string name in ("json", "json-charset") {
            foreach string variant in (Variants) {
                string path = sprintf("/%s/%s", name, variant);
                assertEq({"a": "ä"}, get_body(path), sprintf("%s %s", label, path));
            }
        }
%ifndef NoYaml
        # YAML is deserialized from its actual encoding, including one given by a byte order mark
        foreach string name in ("yaml", "yaml-bom") {
            foreach string variant in (Variants) {
                string path = sprintf("/%s/%s", name, variant);
                assertEq({"a": "ä"}, get_body(path), sprintf("%s %s", label, path));
            }
        }
%endif
    }

    restClientTest() {
        foreach hash<auto> i in ({"url": getUrl(), "label": "h1"}, {"url": getTlsUrl(), "label": "h2"}) {
            RestClient rest({"url": i.url, "ssl_verify_cert": False, "http3_mode": "disabled"});
            checkRest(auto sub (string path) { return rest.get(path).body; }, "RestClient " + i.label);
            # the response body size limit reads the body through a different path
            rest = new RestClient({"url": i.url, "ssl_verify_cert": False, "http3_mode": "disabled",
                "max_response_body_size": 1024});
            checkRest(auto sub (string path) { return rest.get(path).body; }, "RestClient limited " + i.label);
        }
    }

    restClientIoTest() {
        foreach hash<auto> i in ({"url": getUrl(), "protocol": "h1"}, {"url": getTlsUrl(), "protocol": "h2"}) {
            RestClientIo rest({"url": i.url, "protocol": i.protocol, "ssl_verify_mode": SSL_VERIFY_NONE});
            checkRest(auto sub (string path) { return rest.restGet(path).body; }, "RestClientIo " + i.protocol);
        }
    }

    # the raw response body of RestClientIo is the octets received, after any content encoding is decoded, while the
    # body is decoded and deserialized
    restClientIoRawBodyTest() {
        foreach hash<auto> i in ({"url": getUrl(), "protocol": "h1"}, {"url": getTlsUrl(), "protocol": "h2"}) {
            RestClientIo rest({"url": i.url, "protocol": i.protocol, "ssl_verify_mode": SSL_VERIFY_NONE});
            list<string> names = getRestCases() + ("json", "json-charset");
%ifndef NoYaml
            names += ("yaml", "yaml-bom");
%endif
            foreach string name in (names) {
                hash<CharsetCase> c = TestHandler::Cases{name};
                foreach string variant in (Variants) {
                    string path = sprintf("/%s/%s", name, variant);
                    string label = sprintf("RestClientIo %s %s", i.protocol, path);
                    hash<auto> resp = rest.restGet(path);
                    assertEq(c.body, resp.response_body_raw, label);
                    if (name =~ /^(json|yaml)/) {
                        assertEq({"a": "ä"}, resp.body, label);
                    } else {
                        checkBody(resp.body, c, label);
                    }
                    # the asynchronous request path keeps the octets as well
                    resp = rest.restDoRequestAsync("GET", path).get(30s);
                    assertEq(c.body, resp.response_body_raw, label + " async");
                }
            }
        }
    }

    # a client's assumed encoding applies to text without an encoding declaration, and to nothing else
    assumedEncodingTest() {
        const string Assumed = "ISO-8859-15";
        # the cases that use the assumed encoding
        hash<string, bool> uses_assumed = map {$1: True}, ("text", "html");
        code check = sub (code get_body, string label) {
            foreach string name in (keys TestHandler::Cases) {
                hash<CharsetCase> c = TestHandler::Cases{name};
                if (!c.content_type) {
                    continue;
                }
                if (uses_assumed{name}) {
                    c.encoding = Assumed;
                    c.text = convert_encoding(force_encoding(c.body.toString(), Assumed), "UTF-8");
                }
                foreach string variant in (Variants) {
                    string path = sprintf("/%s/%s", name, variant);
                    checkBody(get_body(path), c, sprintf("%s %s", label, path));
                }
            }
        };

        HTTPClient hc = getHttpClient(getUrl(), {"assume_encoding": Assumed});
        assertEq(Assumed, hc.getAssumedEncoding());
        check(auto sub (string path) { return hc.send(NOTHING, "GET", path).body; }, "HTTPClient option");
        hc = getHttpClient(getTlsUrl(), {"http_version": "2.0"});
        hc.setHttp3Mode("disabled");
        hc.setAssumedEncoding(Assumed);
        check(auto sub (string path) { return hc.send(NOTHING, "GET", path).body; }, "HTTPClient h2 set");

        foreach hash<auto> i in ({"url": getUrl(), "protocol": "h1"}, {"url": getTlsUrl(), "protocol": "h2"}) {
            HttpClientConnectionManager mgr = getManager({"protocol": i.protocol, "assume_encoding": Assumed});
            check(auto sub (string path) { return mgr.request(i.url, "GET", path).body; },
                "HttpClientIo " + i.protocol);

            RestClientIo rest({"url": i.url, "protocol": i.protocol, "ssl_verify_mode": SSL_VERIFY_NONE,
                "assume_encoding": Assumed});
            assertEq(Assumed, rest.getAssumedEncoding());
            hash<CharsetCase> c = TestHandler::Cases.text;
            string body = rest.restGet("/text/plain").body;
            assertEq(Assumed, body.encoding(), "RestClientIo " + i.protocol);
            assertEq(convert_encoding(force_encoding(c.body.toString(), Assumed), "UTF-8"),
                convert_encoding(body, "UTF-8"), "RestClientIo " + i.protocol);
        }

        RestClient rest({"url": getUrl(), "assume_encoding": Assumed});
        string body = rest.get("/text/gzip").body;
        assertEq(Assumed, body.encoding());
    }
}
