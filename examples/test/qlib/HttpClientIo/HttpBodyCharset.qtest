    The character encoding of HTTP response bodies: every client applies the same rules (see
    get_http_body_encoding()) to whole, compressed, and chunked responses, over HTTP/1.1 and HTTP/2, and honors its
    assumed encoding for text that does not declare one
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires Mime
%requires Logger
%requires HttpServerUtil
%requires HttpServer
%requires HttpClientIo
%requires RestClientIo
%requires RestClient
%requires json

%try-module yaml
%define NoYaml
%endtry

%exec-class HttpBodyCharsetTest

#! the expected decoding of a response body
hashdecl CharsetCase {
    #! the Content-Type of the response, if any
    *string content_type;
    #! the body octets
    binary body;
    #! the encoding of the decoded string, or no value if the body is returned as binary data
    *string encoding;
    #! the decoded text in UTF-8, for text bodies
    *string text;
}

#! Returns the response body of the case named in the path: /<case>/<variant>, where the variant is:
#! - plain: the body with a Content-Length
#! - gzip: the body compressed with gzip
#! - chunked: the body with chunked transfer encoding
class TestHandler inherits AbstractHttpRequestHandler {
    public {
        const Cases = {
            # other text: a BOM, the charset parameter, else the assumed encoding
            "text": <CharsetCase>{"content_type": "text/plain", "body": <e4f6fc>, "encoding": "ISO-8859-1",
                "text": "äöü"},
            "text-charset": <CharsetCase>{"content_type": "text/plain;charset=utf-8", "body": <c3a4>,
                "encoding": "UTF-8", "text": "ä"},
            "text-bom": <CharsetCase>{"content_type": "text/plain", "body": <efbbbfc3a4>, "encoding": "UTF-8",
                "text": "ä"},
            "text-utf16": <CharsetCase>{"content_type": "text/plain;charset=iso-8859-1", "body": <fffee400>,
                "encoding": "UTF-16LE", "text": "ä"},
            "custom-charset": <CharsetCase>{"content_type": "application/x-test;charset=iso-8859-2", "body": <b1>,
                "encoding": "ISO-8859-2", "text": "ą"},
            # JSON is always UTF-8
            "json": <CharsetCase>{"content_type": "application/json", "body": <7b2261223a22c3a4227d>,
                "encoding": "UTF-8", "text": "{\"a\":\"ä\"}"},
            "json-charset": <CharsetCase>{"content_type": "application/json;charset=iso-8859-1",
                "body": <efbbbf7b2261223a22c3a4227d>, "encoding": "UTF-8", "text": "{\"a\":\"ä\"}"},
            "yaml": <CharsetCase>{"content_type": "application/yaml;charset=iso-8859-1", "body": <613a20c3a4>,
                "encoding": "UTF-8", "text": "a: ä"},
            # a byte order mark selects the encoding of YAML
            "yaml-bom": <CharsetCase>{"content_type": "application/yaml", "body": <fffe61003a002000e400>,
                "encoding": "UTF-16LE", "text": "a: ä"},
            # XML: the declaration, else UTF-8
            "xml-declaration": <CharsetCase>{"content_type": "application/xml",
                "body": <3c3f786d6c2076657273696f6e3d22312e302220656e636f64696e673d2269736f2d383835392d32223f3e3c613eb13c2f613e>,
                "encoding": "ISO-8859-2", "text": "<?xml version=\"1.0\" encoding=\"iso-8859-2\"?><a>ą</a>"},
            "xml": <CharsetCase>{"content_type": "text/xml", "body": <3c613ec3a43c2f613e>, "encoding": "UTF-8",
                "text": "<a>ä</a>"},
            # HTML: a meta element, else the assumed encoding
            "html-meta": <CharsetCase>{"content_type": "text/html",
                "body": <3c6d65746120636861727365743d2277696e646f77732d31323532223e80>, "encoding": "WINDOWS-1252",
                "text": "<meta charset=\"windows-1252\">€"},
            "html": <CharsetCase>{"content_type": "text/html", "body": <3c703ee4>, "encoding": "ISO-8859-1",
                "text": "<p>ä"},
            # CSS: an @charset rule, else UTF-8
            "css-rule": <CharsetCase>{"content_type": "text/css",
                "body": <4063686172736574202269736f2d383835392d3135223ba4>, "encoding": "ISO-8859-15",
                "text": "@charset \"iso-8859-15\";€"},
            "javascript": <CharsetCase>{"content_type": "text/javascript", "body": <2f2fc3a4>, "encoding": "UTF-8",
                "text": "//ä"},
            # binary types, with or without a charset parameter
            "octet": <CharsetCase>{"content_type": "application/octet-stream;charset=utf-8", "body": <c3a4>},
            "image": <CharsetCase>{"content_type": "image/png", "body": <89504e47>},
            # no Content-Type: the data decides
            "none-text": <CharsetCase>{"body": <e4f6fc>, "encoding": "ISO-8859-1", "text": "äöü"},
            "none-binary": <CharsetCase>{"body": <000102c3a4>},
        };
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        list<string> parts = hdr.path.split("/");
        *hash<CharsetCase> c = Cases{parts[0]};
        if (!c) {
            return <HttpResponseInfo>{"code": 404, "hdr": {"Content-Type": MimeTypeText}, "body": "not found"};
        }
        hash<auto> rhdr;
        if (c.content_type) {
            rhdr."Content-Type" = c.content_type;
        }
        switch (parts[1]) {
            case "gzip":
                rhdr."Content-Encoding" = "gzip";
                return <HttpResponseInfo>{"code": 200, "hdr": rhdr, "body": gzip(c.body)};
            case "chunked":
                rhdr."Transfer-Encoding" = "chunked";
                return <HttpResponseInfo>{"code": 200, "hdr": rhdr, "chunked_body": new BinaryInputStream(c.body)};
        }
        return <HttpResponseInfo>{"code": 200, "hdr": rhdr, "body": c.body};
    }
}

#! A minimal HTTP/1.1 server serving the cases of TestHandler, including the responses without a Content-Type that
#! HttpServer cannot send, as it adds a default type to any response body without one
class RawServer {
    public {
        int port;
    }

    private {
        Socket listener();
        Counter running(1);
        bool stopping;
    }

    constructor() {
        listener.bind("127.0.0.1:0", True);
        listener.listen();
        port = listener.getSocketInfo().port;
        background run();
    }

    stop() {
        stopping = True;
        # wake the accept call
        Socket s();
        s.connect("127.0.0.1:" + port, 30s);
        running.waitForZero();
        listener.close();
    }

    private run() {
        on_exit running.dec();
        while (True) {
            Socket s = listener.accept();
            if (stopping) {
                break;
            }
            try {
                serve(s);
            } catch (hash<ExceptionInfo> ex) {
                # the client reports any failure
            }
            s.close();
        }
    }

    # serves one request on the connection, which is closed afterwards
    private serve(Socket s) {
        hash<auto> req = s.readHTTPHeader(30s);
        list<string> parts = req.path.substr(1).split("/");
        hash<CharsetCase> c = TestHandler::Cases{parts[0]};
        string hdr = "HTTP/1.1 200 OK\r\nConnection: close\r\n";
        if (c.content_type) {
            hdr += sprintf("Content-Type: %s\r\n", c.content_type);
        }
        binary body;
        switch (parts[1]) {
            case "gzip":
                hdr += "Content-Encoding: gzip\r\n";
                body = gzip(c.body);
                break;
            case "chunked":
                hdr += "Transfer-Encoding: chunked\r\n";
                body = binary(sprintf("%x\r\n", c.body.size())) + c.body + binary("\r\n0\r\n\r\n");
                break;
            default:
                body = c.body;
                break;
        }
        if (parts[1] != "chunked") {
            hdr += sprintf("Content-Length: %d\r\n", body.size());
        }
        s.send(binary(hdr + "\r\n") + body);
    }
}

