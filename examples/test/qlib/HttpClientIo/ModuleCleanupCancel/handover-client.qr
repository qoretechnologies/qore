#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# the onComplete() of an operation that the module cleanup counts takes a handle of its work and releases it twice
# ("twice"), or never ("never"), in which case the cleanup waits for it until the grace period after its deadline and
# then leaves the modules as they are (qore#7239)

%requires AaHandover

Holder::start(ARGV[0]);
printf("started\n");
