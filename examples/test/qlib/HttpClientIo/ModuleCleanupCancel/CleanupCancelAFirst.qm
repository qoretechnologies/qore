%modern

module CleanupCancelAFirst {
    version = "1.0";
    desc = "cancels another module's operation from a destructor run by the module cleanup";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
}

#! the namespace of the module; its name sorts before CleanupCancelStep, so its data is cleared first
public namespace CleanupCancelAFirst {
#! cancels the other module's operation when the module cleanup deletes it
public class CrossCanceller {
    private {
        string owner;
        Queue completed;
    }

    constructor(string owner, Queue completed) {
        self.owner = owner;
        self.completed = completed;
    }

    destructor() {
        # the other module's Program has not been cleaned up: the cancel waits for the step, whose result is sent
        # with the context of the worker that made the step
        AsyncIoController::cancelByOwner(owner);
        call_function("dbg_async_io_release_held_step_results");
        auto canceled;
        try {
            canceled = completed.get(20s);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "QUEUE-TIMEOUT") {
                rethrow;
            }
        }
        printf("result received: %y\n", canceled === True);
        flush();
        AsyncIoController::flushCallbacksByOwner(owner);
    }
}

#! keeps the canceller until the modules are deleted
public class CrossHolder {
    public {
        static *CrossCanceller canceller;
    }

    static arm(string owner, Queue completed) {
        canceller = new CrossCanceller(owner, completed);
    }
}
}
