%modern

%requires HttpClientIo

module CleanupCancelHolder {
    version = "1.0";
    desc = "keeps an HTTP client connection manager with an open connection until the modules are deleted";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
}

#! the namespace of the module
public namespace CleanupCancelHolder {
#! keeps the manager in a static variable, which the module cleanup deletes after it has closed the modules' Programs
public class Holder {
    public {
        #! the manager, deleted with the module's data
        static *HttpClientConnectionManager mgr;
    }

    #! makes a request with a new manager that the module keeps, so that its connection stays open; returns the status
    static int get(string url, string protocol) {
        mgr = new HttpClientConnectionManager(<HttpClientConnectionManagerOptions>{
            "protocol": protocol,
            "accept_all_certs": True,
            "connect_timeout": 10s,
            "request_timeout": 20s,
        });
        return mgr.request(url, "GET", "/").status_code;
    }
}
}
