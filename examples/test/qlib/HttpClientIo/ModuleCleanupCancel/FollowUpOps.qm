# -*- mode: qore; indent-tabs-mode: nil -*-

# Copyright (C) 2026 Qore Technologies, s.r.o.

# the operations of CleanupFollowUp.qm, in a module of their own: the module cleanup deletes the data of
# CleanupFollowUp first (its destructors run before this module's Program is torn down), as a module that keeps a
# connection of a library module does; see ModuleCleanupCancel.qtest (qore#7027)

%modern

module FollowUpOps {
    version = "1.0";
    desc = "the operations of the module cleanup follow-up test";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
}

public namespace FollowUpOps {
#! an operation that never reaches its goal, or that reaches it in its first step (\a done)
public class FollowUpOperation inherits AbstractPollOperation<auto> {
    private {
        EventNotifier notifier;
        string label;
        bool done;
        bool reached = False;
        #! True: its onComplete() submits the operation again (a reader that re-arms itself)
        bool resubmit;
    }

    constructor(EventNotifier notifier, string label, bool done = False, bool resubmit = False) {
        self.notifier = notifier;
        self.label = label;
        self.done = done;
        self.resubmit = resubmit;
    }

    string getGoal() {
        return "done";
    }

    string getState() {
        return reached ? "done" : "pending";
    }

    bool goalReached() {
        return reached;
    }

    *hash<SocketPollInfo> continuePoll() {
        if (done) {
            reached = True;
            return NOTHING;
        }
        # waits for data that does not come
        return <SocketPollInfo>{"socket": notifier, "events": SOCK_POLLIN};
    }

    onComplete(hash<SocketPollResultInfo> result) {
        printf("%s onComplete: canceled: %y\n", label, result.canceled);
        flush();
        if (resubmit) {
            try {
                submit_operation(notifier, label, False, True, -1s);
                printf("%s resubmitted\n", label);
            } catch (hash<ExceptionInfo> ex) {
                printf("%s resubmit refused: %s\n", label, ex.err);
            }
            flush();
        }
    }
}

#! writes when the module cleanup deletes the data of this module, which comes after the data of CleanupFollowUp
#! and the drain that waits for its work
class ClearMarker {
    destructor() {
        printf("follow-up ops cleared\n");
        flush();
    }
}

#! the data of this module
class Data {
    public {
        static ClearMarker marker();
    }
}

#! submits an operation
public sub submit_operation(EventNotifier notifier, string label, bool done, bool resubmit, timeout to) {
    AsyncIoController::submit(<SocketPollOperationInfo>{
        "sock": notifier,
        "spop": new FollowUpOperation(notifier, label, done, resubmit),
        "owner": "module-cleanup-follow-up-" + label,
        "to": to,
    });
}
}
