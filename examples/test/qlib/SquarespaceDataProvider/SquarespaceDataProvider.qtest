    #! Integration test: Store pages ref_data
    private testStorePageRefData(SquarespaceDataProvider::SquarespaceDataProvider prov) {
        if (m_options.verbose) {
            printf("Testing store pages ref_data...\n");
        }

        AbstractDataProvider products = prov.getChildProvider("products");
        *hash<string, bool> refTypes = products.getSupportedReferenceData();

        assertTrue(refTypes.hasKey("store_pages"), "Products should support store_pages ref_data");
        assertTrue(refTypes.hasKey("products"), "Products should support products ref_data");

        *list<hash<AllowedValueInfo>> storePages = products.getReferenceData("store_pages");
        assertTrue(storePages.val(), "Store pages ref_data should return results");
        assertTrue(storePages.size() > 0, "Should have at least one store page");

        hash<AllowedValueInfo> firstPage = storePages[0];
        assertTrue(firstPage.value.val(), "Store page should have a value (ID)");
        assertTrue(firstPage.display_name.val(), "Store page should have a display name");

        if (m_options.verbose) {
            foreach hash<AllowedValueInfo> page in (storePages) {
                printf("  Store page: %s (ID: %s)\n", page.display_name, page.value);
            }
        }
    }

    #! Cleanup: delete test product
    private cleanup(SquarespaceDataProvider::SquarespaceDataProvider prov) {
        if (!testProductId) {
            return;
        }

        if (m_options.verbose) {
            printf("Cleaning up: deleting test product %s...\n", testProductId);
        }

        try {
            AbstractDataProvider deleteAction = prov.getChildProvider("products")
                .getChildProvider("delete");
            deleteAction.doRequest({
                "product_id": testProductId,
            });
            if (m_options.verbose) {
                printf("  Deleted test product successfully\n");
            }
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("  Warning: cleanup failed: %s: %s\n", ex.err, ex.desc);
            }
        }
    }
}
