#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

# Copyright (C) 2026 Qore Technologies, s.r.o.

# Tests valid Swagger 2.0 constructs found in vendor schemas: paths that differ only by a trailing slash, and
# enumerations with array and object values

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires json
%requires yaml

%requires QUnit
%requires DataProvider
%requires RestSchemaValidator
%requires Swagger
%requires SwaggerDataProvider

%exec-class SwaggerVendorSchemasTest

class SwaggerVendorSchemasTest inherits QUnit::Test {
    constructor() : Test("SwaggerVendorSchemasTest", "1.0", \ARGV) {
        addTestCase("trailing slash paths", \trailingSlashPaths());
        addTestCase("trailing slash fallback", \trailingSlashFallback());
        addTestCase("path operation hash prefixes", \pathOperationHashPrefixes());
        addTestCase("trailing slash data provider", \trailingSlashDataProvider());
        addTestCase("duplicate template paths", \duplicateTemplatePaths());
        addTestCase("array enumeration values", \arrayEnumValues());
        addTestCase("object enumeration values", \objectEnumValues());
        addTestCase("scalar value of a structured enumeration", \scalarValueOfStructuredEnum());
        addTestCase("multiple path parameters", \multiplePathParameters());
        addTestCase("object parameter outside the body", \objectNonBodyParameter());
        addTestCase("undeclared required property", \undeclaredRequiredProperty());
        addTestCase("undeclared required property in a composition", \undeclaredRequiredComposition());
        set_return_value(main());
    }

    #! returns a Swagger 2.0 schema with the given paths and options
    private static SwaggerSchema getSchema(hash<auto> paths, *hash<auto> extra, *int parse_flags) {
        hash<auto> h = {
            "swagger": "2.0",
            "info": {"title": "vendor", "version": "1"},
            "basePath": "/v1",
            "paths": paths,
        } + extra;
        return SwaggerLoader::fromString(make_json(h), NOTHING, exists parse_flags
            ? {"parse_flags": parse_flags}
            : NOTHING);
    }

    #! returns a GET operation with the given operation ID and parameters
    private static hash<auto> getOp(string id, *list<auto> params) {
        hash<auto> rv = {
            "operationId": id,
            "responses": {"200": {"description": "ok"}},
        };
        if (params) {
            rv.parameters = params;
        }
        return rv;
    }

    #! returns the operation ID that matches the given method and URI path
    private static *string getOpId(SwaggerSchema s, string method, string path) {
        return s.paths.match(path).getOperation(method, path).operationId;
    }

    #! Pipedrive's "/oauth/token" and "/oauth/token/" are two operations
    trailingSlashPaths() {
        SwaggerSchema s = getSchema({
            "/oauth/token": {"post": getOp("get-tokens")},
            "/oauth/token/": {"post": getOp("refresh-tokens")},
            "/": {"get": getOp("root")},
        });
        assertEq({"oauth/token": ("post",), "oauth/token/": ("post",), "": ("get",)},
            s.getPathOperationHash());
        assertEq("get-tokens", getOpId(s, "post", "/oauth/token"));
        assertEq("refresh-tokens", getOpId(s, "post", "/oauth/token/"));
        assertEq("refresh-tokens", getOpId(s, "post", "/oauth/token/?a=1"));
        assertEq("root", getOpId(s, "get", "/"));
        assertEq("refresh-tokens", s.paths.tryMatch("/oauth/token/").getOperation("post", "/oauth/token/")
            .operationId);

        # a server matches an incoming request to the operation of its own path
        hash<auto> hdr;
        hash<RestRequestServerInfo> req = s.parseRequest("POST", "/v1/oauth/token/", NOTHING, \hdr);
        assertEq("/oauth/token/", req.path);
        assertEq("refresh-tokens", getOpId(s, "post", req.path));
    }

    #! a URI path that differs from the only declared path by a trailing slash still matches it
    trailingSlashFallback() {
        SwaggerSchema s = getSchema({
            "/a": {"get": getOp("a")},
            "/b/": {"get": getOp("b-slash")},
            "/x": {"get": getOp("x")},
            "/x/{id}": {"get": getOp("x-id", ({"name": "id", "in": "path", "required": True, "type": "string"},))},
        });
        assertEq("a", getOpId(s, "get", "/a"));
        assertEq("a", getOpId(s, "get", "/a/"));
        assertEq("b-slash", getOpId(s, "get", "/b/"));
        assertEq("b-slash", getOpId(s, "get", "/b"));
        # an empty last segment is a trailing slash, not a value of the template
        assertEq("x", getOpId(s, "get", "/x/"));
        assertEq("x-id", getOpId(s, "get", "/x/1"));
        assertThrows("SCHEMA-VALIDATION-ERROR", \s.paths.match(), "/c/");
        assertThrows("SCHEMA-VALIDATION-ERROR", \s.paths.match(), "/a/b");
    }

    #! each path of the operation hash is its own, whatever the order of the paths in the document
    pathOperationHashPrefixes() {
        SwaggerSchema s = getSchema({
            "/a/b": {"get": getOp("a-b")},
            "/a": {"post": getOp("a")},
            "/a/b/c/": {"put": getOp("a-b-c-slash")},
        });
        assertEq({"a/b": ("get",), "a": ("post",), "a/b/c/": ("put",)}, s.getPathOperationHash());
    }

    #! the operation of a path with a trailing slash is the child of an empty segment
    trailingSlashDataProvider() {
        SwaggerSchema s = getSchema({
            "/oauth/token": {"post": getOp("get-tokens")},
            "/oauth/token/": {"post": getOp("refresh-tokens")},
            "/dir/": {"get": getOp("dir")},
            "/dir//sub": {"get": getOp("dir-sub")},
        });
        SwaggerDataProvider dp(s);
        AbstractDataProvider token = dp.getChildProviderPath("oauth/token");
        assertEq(("", "POST"), token.getChildProviderNames());
        AbstractDataProvider slash = token.getChildProviderEx("");
        assertEq("", slash.getName());
        assertEq(("POST",), slash.getChildProviderNames());

        SwaggerRequestDataProvider req = cast<SwaggerRequestDataProvider>(dp.getChildProviderPath("oauth/token/POST"));
        assertEq("get-tokens", req.op.operationId);
        assertEq("/oauth/token", req.uri_path);
        req = cast<SwaggerRequestDataProvider>(dp.getChildProviderPath("oauth/token//POST"));
        assertEq("refresh-tokens", req.op.operationId);
        assertEq("/oauth/token/", req.uri_path);

        # a segment after an empty one keeps it
        req = cast<SwaggerRequestDataProvider>(dp.getChildProviderPath("dir//sub/GET"));
        assertEq("dir-sub", req.op.operationId);
        assertEq("/dir//sub", req.uri_path);
        req = cast<SwaggerRequestDataProvider>(dp.getChildProviderPath("dir//GET"));
        assertEq("dir", req.op.operationId);
        assertEq("/dir/", req.uri_path);
    }

    #! two templates of the same path are still the same path
    duplicateTemplatePaths() {
        assertThrows("INVALID-PATH-COMPONENT", "Cannot terminate path", \SwaggerVendorSchemasTest::getSchema(), ({
            "/x/{id}/": {"get": getOp("a", ({"name": "id", "in": "path", "required": True, "type": "string"},))},
            "/x/{other}/": {"get": getOp("b", ({"name": "other", "in": "path", "required": True,
                "type": "string"},))},
        },));
    }

    #! Mailchimp's "action" query parameter: an array whose enumeration values are arrays
    arrayEnumValues() {
        SwaggerSchema s = getSchema({
            "/activity": {"get": getOp("activity", ({
                "name": "action",
                "in": "query",
                "type": "array",
                "items": {"type": "string"},
                "collectionFormat": "csv",
                "enum": (("abuse",), ("bounce",), ("click", "open")),
            },))},
        });
        hash<auto> hdr;
        # an array is valid when it is equal to one of the values
        hash<RestRequestServerInfo> req = s.parseRequest("GET", "/v1/activity?action=abuse", NOTHING, \hdr);
        assertEq(("abuse",), req.query.action);
        req = s.parseRequest("GET", "/v1/activity?action=click,open", NOTHING, \hdr);
        assertEq(("click", "open"), req.query.action);
        assertThrows("SCHEMA-VALIDATION-ERROR", "does not fit the enumerated values", \s.parseRequest(),
            ("GET", "/v1/activity?action=abuse,click", NOTHING, \hdr));
        assertThrows("SCHEMA-VALIDATION-ERROR", "does not fit the enumerated values", \s.parseRequest(),
            ("GET", "/v1/activity?action=open,click", NOTHING, \hdr));
        # the client validates the request it sends
        assertThrows("SCHEMA-VALIDATION-ERROR", "does not fit the enumerated values", \s.processRequest(),
            ("GET", "/activity?action=sent", NOTHING, {}));

        # the operation can be browsed and its request type built
        SwaggerDataProvider dp(s);
        AbstractDataProvider op = dp.getChildProviderPath("activity/GET");
        AbstractDataField action = op.getRequestType().getField("query").getType().getField("action");
        assertEq(NT_LIST, action.getType().getBaseTypeCode());
    }

    #! an object whose enumeration values are objects
    objectEnumValues() {
        SwaggerSchema s = getSchema({
            "/settings": {"post": getOp("settings", ({
                "name": "body",
                "in": "body",
                "schema": {
                    "type": "object",
                    "properties": {
                        "mode": {
                            "type": "object",
                            "additionalProperties": True,
                            "enum": ({"level": 1}, {"level": 2, "fast": True}),
                        },
                        "tags": {
                            "type": "array",
                            "items": {"type": "string"},
                            "enum": (("a",), ("a", "b")),
                        },
                    },
                },
            },))},
        }, {"consumes": ("application/json",)});
        hash<auto> hdr = {"content-type": "application/json"};
        hash<RestRequestServerInfo> req = s.parseRequest("POST", "/v1/settings",
            make_json({"mode": {"fast": True, "level": 2}}), \hdr);
        assertEq({"fast": True, "level": 2}, req.body.mode);
        assertThrows("SCHEMA-VALIDATION-ERROR", "does not fit the enumerated values", \s.parseRequest(),
            ("POST", "/v1/settings", make_json({"mode": {"level": 3}}), \hdr));
        # numbers are equal by value, as in JSON
        req = s.parseRequest("POST", "/v1/settings", "{\"mode\": {\"level\": 1.0}}", \hdr);
        assertEq(NT_FLOAT, req.body.mode.level.typeCode());
        assertEq(1.0, req.body.mode.level);
        # an array property is compared with its array values
        req = s.parseRequest("POST", "/v1/settings", make_json({"tags": ("a", "b")}), \hdr);
        assertEq(("a", "b"), req.body.tags);
        assertThrows("SCHEMA-VALIDATION-ERROR", "does not fit the enumerated values", \s.parseRequest(),
            ("POST", "/v1/settings", make_json({"tags": ("b", "a")}), \hdr));

        # the values are the allowed values of the fields
        SwaggerDataProvider dp(s);
        AbstractDataProvider op = dp.getChildProviderPath("settings/POST");
        HashDataType body = cast<HashDataType>(op.getRequestType().getField("body").getType());
        assertEq(({"level": 1}, {"level": 2, "fast": True}), map $1.value, body.getField("mode").getAllowedValues());
        assertEq((("a",), ("a", "b")), map $1.value, body.getField("tags").getAllowedValues());
    }

    #! each path parameter of an operation with several of them has its own value
    multiplePathParameters() {
        list<hash<auto>> params = (
            {"name": "list_id", "in": "path", "required": True, "type": "string"},
            {"name": "n", "in": "path", "required": True, "type": "integer"},
        );
        SwaggerSchema s = getSchema({
            "/lists/{list_id}/members/{n}/activity": {"get": getOp("activity", params)},
        });
        hash<auto> hdr;
        hash<RestRequestServerInfo> req = s.parseRequest("GET", "/v1/lists/a%20b/members/42/activity", NOTHING,
            \hdr);
        assertEq({"list_id": "a b", "n": 42}, req.path_args);
        # the path without the trailing slash matches it
        req = s.parseRequest("GET", "/v1/lists/x/members/7/activity/", NOTHING, \hdr);
        assertEq({"list_id": "x", "n": 7}, req.path_args);
        # a path parameter that the operation does not define is refused
        SwaggerSchema bad = getSchema({
            "/lists/{list_id}/members/{m}": {"get": getOp("bad", params)},
        });
        assertThrows("SCHEMA-VALIDATION-ERROR", "No path parameter \"m\"", \bad.parseRequest(),
            ("GET", "/v1/lists/x/members/1", NOTHING, \hdr));

        # the client validates the request it sends
        hash<RestRequestClientInfo> info = s.processRequest("GET", "/lists/1/members/2/activity", NOTHING, {});
        assertEq("/v1/lists/1/members/2/activity", info.uri_path);
        info = s.processRequest("GET", "/lists/a%20b/members/3/activity/", NOTHING, {});
        assertEq("/v1/lists/a%20b/members/3/activity/", info.uri_path);
    }

    #! Trello's "fields" query parameter: Swagger 2.0 allows "object" only for a body parameter
    objectNonBodyParameter() {
        hash<auto> paths = {
            "/boards": {"get": getOp("boards", ({"name": "fields", "in": "query", "type": "object"},))},
        };
        # refused by default, with the error naming the parse option that accepts it
        assertThrows("INVALID-FIELD-VALUE", "LM_ACCEPT_QUERY_OBJECTS.*\"lax_parsing\".*\"swagger_lax_parsing\"",
            \SwaggerVendorSchemasTest::getSchema(), (paths,));
        assertThrows("INVALID-FIELD-VALUE", "invalid parameter type value passed: \"object\"",
            \SwaggerVendorSchemasTest::getSchema(), (paths,));
        # the parse option accepts it
        SwaggerSchema s = getSchema(paths, NOTHING, LM_ACCEPT_QUERY_OBJECTS);
        assertEq({"boards": ("get",)}, s.getPathOperationHash());
        # as does the lax parsing option of the data provider
        SwaggerDataProvider dp({"schema": make_json({
            "swagger": "2.0",
            "info": {"title": "vendor", "version": "1"},
            "paths": paths,
        }), "lax_parsing": True});
        assertEq(("boards",), dp.getChildProviderNames());

        # another invalid type is refused without naming the option, which would not accept it
        hash<auto> bad = {
            "/boards": {"get": getOp("boards", ({"name": "fields", "in": "query", "type": "map"},))},
        };
        *string desc;
        try {
            getSchema(bad);
        } catch (hash<ExceptionInfo> ex) {
            desc = ex.err + ": " + ex.desc;
        }
        assertRegex("^INVALID-FIELD-VALUE: .*invalid parameter type value passed: \"map\"", desc);
        assertNRegex("LM_ACCEPT_QUERY_OBJECTS", desc);
    }

    #! Pipedrive's PUT /subscriptions/installment/{id}: the body requires "id", which it does not declare
    undeclaredRequiredProperty() {
        SwaggerSchema s = getSchema({
            "/installment": {"put": getOp("update", ({
                "name": "body",
                "in": "body",
                "schema": {
                    "type": "object",
                    "properties": {
                        "payments": {"type": "array", "items": {"type": "object"}},
                    },
                    "required": ("id", "payments"),
                },
            },))},
        }, {"consumes": ("application/json",)});
        hash<auto> hdr = {"content-type": "application/json"};
        # the property is required and accepts any value
        hash<RestRequestServerInfo> req = s.parseRequest("PUT", "/v1/installment",
            make_json({"id": 5, "payments": ()}), \hdr);
        assertEq(5, req.body.id);
        req = s.parseRequest("PUT", "/v1/installment", make_json({"id": {"x": "y"}, "payments": ()}), \hdr);
        assertEq({"x": "y"}, req.body.id);
        assertThrows("SCHEMA-VALIDATION-ERROR", "missing required properties.*id", \s.parseRequest(),
            ("PUT", "/v1/installment", make_json({"payments": ()}), \hdr));

        # it is a required field of type "any"
        SwaggerDataProvider dp(s);
        HashDataType body = cast<HashDataType>(dp.getChildProviderPath("installment/PUT").getRequestType()
            .getField("body").getType());
        AbstractDataField id = body.getField("id");
        # a field of type "any" accepts no value, so its attributes say that it is required
        assertEq({"preselected": True, "required": True}, id.getConfigInfo().attr);
        assertEq("any", id.getType().getName());
        assertNothing(body.getField("payments").getConfigInfo().attr);
        assertEq(("payments", "id"), keys body.getFields());

        # additional properties accept it without a property of its own
        SwaggerSchema open = getSchema({}, {"definitions": {"Open": {
            "type": "object",
            "properties": {"a": {"type": "string"}},
            "additionalProperties": {"type": "integer"},
            "required": ("b",),
        }}});
        assertEq(("a",), keys open.definitions.Open.properties);
        assertEq(0, open.definitions.Open.undeclared_required.size());

        # when additional properties are forbidden, no value can have the property
        assertThrows("INVALID-FIELD-VALUE", "\"additionalProperties\" is false, so no value can have them: "
            "\\[\"b\"\\]", \SwaggerVendorSchemasTest::getSchema(), ({}, {"definitions": {"Closed": {
                "type": "object",
                "properties": {"a": {"type": "string"}},
                "additionalProperties": False,
                "required": ("b",),
            }}}));
    }

    #! a property that a composed schema declares replaces one that only a "required" list gave
    undeclaredRequiredComposition() {
        hash<auto> definitions = {
            # requires "b", which it does not declare
            "A": {"type": "object", "properties": {"a": {"type": "string"}}, "required": ("a", "b")},
            # declares "b"
            "C": {"type": "object", "properties": {"b": {"type": "integer"}}},
            "AC": {"allOf": ({"$ref": "#/definitions/A"}, {"$ref": "#/definitions/C"})},
            "CA": {"allOf": ({"$ref": "#/definitions/C"}, {"$ref": "#/definitions/A"})},
            # declares "b" itself
            "OwnB": {
                "type": "object",
                "properties": {"b": {"type": "boolean"}},
                "allOf": ({"$ref": "#/definitions/A"},),
            },
        };
        SwaggerSchema s = getSchema({}, {"definitions": definitions});
        assertEq({"b": True}, s.definitions.A.undeclared_required);
        assertEq("any", s.definitions.A.properties.b.type);
        foreach string n in ("AC", "CA") {
            SchemaObject so = s.definitions{n};
            assertEq("integer", so.properties.b.type, n);
            assertEq(0, so.undeclared_required.size(), n);
        }
        assertEq("boolean", s.definitions.OwnB.properties.b.type);
        assertEq(0, s.definitions.OwnB.undeclared_required.size());
    }

    #! a scalar is never equal to an array or object value of an enumeration
    scalarValueOfStructuredEnum() {
        SwaggerSchema s = getSchema({
            "/odd": {"get": getOp("odd", ({
                "name": "v",
                "in": "query",
                "type": "string",
                "enum": (("a",), "b"),
            },))},
        });
        hash<auto> hdr;
        hash<RestRequestServerInfo> req = s.parseRequest("GET", "/v1/odd?v=b", NOTHING, \hdr);
        assertEq("b", req.query.v);
        assertThrows("SCHEMA-VALIDATION-ERROR", "does not fit the enumerated values", \s.parseRequest(),
            ("GET", "/v1/odd?v=a", NOTHING, \hdr));
    }
}
