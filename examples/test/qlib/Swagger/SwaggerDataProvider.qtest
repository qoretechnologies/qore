#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

# try importing JSON and YAML modules
%requires json
%try-module yaml
%define NoYaml
%endtry

%ifdef NoYaml
# Stub function when yaml module is not available
auto sub make_yaml(auto val) { throw "YAML-ERROR", "the yaml module is required for this test"; }
%endif

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires Mime
%requires QUnit
%requires FsUtil
%requires Logger
%requires DataProvider
%requires HttpServerUtil
%requires HttpServer
%requires RestSchemaValidator
%requires Swagger
%requires ConnectionProvider
%requires RestClient
%requires AsyncSocketIo
%requires HttpClientIo
%requires RestClientIo
%requires SwaggerDataProvider

%exec-class SwaggerDataProviderTest

#! Test handler that always responds with HTTP 429 to simulate rate limiting
class RateLimitHandler inherits AbstractHttpRequestHandler {
    hash<auto> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(429, make_json({"message": "Too Many Requests"}), {"Content-Type": MimeTypeJson});
    }
}

public class SwaggerDataProviderTest inherits QUnit::Test {
    constructor() : Test("SwaggerDataProviderTest", "1.0") {
        addTestCase("compat test", \compatTest());
        addTestCase("swagger data provider test", \testSwaggerDataProvider());
        addTestCase("error arg preservation test", \errorArgPreservationTest());
        set_return_value(main());
    }

    checkModules() {
%ifdef NoYaml
        testSkip("no yaml module");
%endif
    }

    compatTest() {
        checkModules();
        hash<auto> schema = {
            "swagger": "2.0",
            "info": {
                "title": "test",
                "version": "1.0"
            },
            "paths": {
                "/api/query-object": {
                    "get": {
                        "responses": {
                            "200": {
                                "description": "success",
                                "schema": {
                                    "type": "string",
                                }
                            },
                        },
                        "produces": (MimeTypeJson,),
                        "parameters": (
                            {
                                "in": "query",
                                "name": "obj",
                                "type": "object",
                            },
                        )
                    },
                },
            },
        };

        TmpFile file("swagger-data-provider-test-", "yaml");
        file.file.write(make_yaml(schema));
        SwaggerDataProvider prov({
            "schema": file.path,
            "lax_parsing": True,
        });
        assertEq("test", prov.getName());

        {
            AbstractDataProvider p0 = prov.getChildProviderPath("api/query-object/GET");
            AbstractDataProviderType req = p0.getRequestType();
            AbstractDataField q = req.getField("query");
            assertEq(NT_HASH, q.getType().getBaseTypeCode());
            assertEq(NT_HASH, q.getType().getField("obj").getType().getBaseTypeCode());

            hash<auto> obj = {
                "a": 1,
                "b": 2,
            };
            auto v = req.acceptsValue({
                "query": {
                    "obj": obj,
                },
            });
            assertEq(obj, v.query.obj);
        }
    }

    #! Verifies that a transient HTTP error from the REST layer preserves the
    #! original response context (status code) in the exception argument.
    /** SwaggerRequestDataProvider::doRequestIntern() catches and rethrows REST
        errors; it must not replace the original response-hash argument (which
        carries the real status code) with its empty local \c info hash, or
        callers can no longer detect transient conditions such as HTTP 429.
    */
    errorArgPreservationTest() {
        checkModules();

        Logger logger("test", m_options.verbose > 2
            ? LoggerLevel::getLevelInfo() : LoggerLevel::getLevelFatal());
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }

        HttpServer http(<HttpServerOptionInfo>{"logger": logger});
        on_exit http.stop();
        RateLimitHandler handler();
        http.setDefaultHandler("rate-limit", handler);
        int port = http.addListener(<HttpListenerOptionInfo>{"service": 0}).port;

        SwaggerDataProvider provider({
            "schema": get_script_dir() + "/PetStore.swagger.yaml",
            "url": sprintf("http://127.0.0.1:%d", port),
        });
        AbstractDataProvider p0 = provider.getChildProviderPath("pet/findByStatus/GET");
        try {
            # "pending" is a valid enum value, so the request passes client-side
            # validation and reaches the server, which responds with 429
            p0.doRequest({"query": {"status": ("pending",)}});
            fail("expected an HTTP error exception");
        } catch (hash<ExceptionInfo> ex) {
            # the REST layer raises HTTP-CLIENT-RECEIVE-ERROR or REST-RESPONSE-ERROR
            # for the 429; either way the status code must survive the rethrow
            assertTrue(ex.err == "HTTP-CLIENT-RECEIVE-ERROR" || ex.err == "REST-RESPONSE-ERROR",
                sprintf("unexpected error %y: %s", ex.err, ex.desc));
            # the original response context must survive the rethrow in
            # SwaggerRequestDataProvider::doRequestIntern() (it must not be
            # replaced with the empty local "info" hash)
            assertEq(429, ex.arg.status_code ?? ex.arg."response-code");
            assertRegex("429", ex.desc);
        }
    }

    testSwaggerDataProvider() {
        checkModules();

        bool set = AbstractDataProvider::setDynamicValueCallbacks(
            bool sub (auto uri_path) { return uri_path =~ /\$/; },
            auto sub (auto uri_path) { uri_path =~ s/\$id/1/; return uri_path; });
        assertTrue(set);
        assertFalse(AbstractDataProvider::setDynamicValueCallbacks());

        hash<auto> opts = {
            "schema": get_script_dir() + "/PetStore.swagger.yaml",
        };
        SwaggerDataProvider provider(opts);
        assertEq("Swagger Petstore", provider.getName());

        {
            AbstractDataProvider p0 = provider.getChildProviderPath("pet/findByStatus/GET");
            object sp0 = cast<object>(p0);
            assertEq("GET", sp0.getOperation().method);
            AbstractDataProviderType req = p0.getRequestType();
            assertEq(NT_HASH, req.getField("query").getType().getBaseTypeCode());
            AbstractDataProviderType resp = p0.getResponseType();
            AbstractDataProviderType type = resp.getField("body").getType().getElementType();
            assertEq("*softint", type.getFieldType("id").getName());
            assertEq("softstring", type.getFieldType("name").getName());
            assertEq(("id", "category", "name", "photoUrls", "tags", "status"), keys type.getFields());

            # Note: doRequest() actually connects to external API, so check manually
            # to handle connection errors gracefully in CI
            try {
                p0.doRequest({"query": {"status": ("x",)}});
                fail("expected SCHEMA-VALIDATION-ERROR exception");
            } catch (hash<ExceptionInfo> ex) {
                if (QUnit::Test::isConnectionError(ex) || ex.err == "SOCKET-CONNECT-ERROR" || ex.err == "SOCKET-SSL-ERROR"
                        || ex.err == "QOREADDRINFO-GETINFO-ERROR" || ex.err == "SOCKET-TIMEOUT" || ex.err == "HTTPCLIENT-NEGOTIATE-TIMEOUT" || ex.err == "HTTPCLIENT-TIMEOUT") {
                    # Skip - external API is unavailable
                } else if (ex.err == "SCHEMA-VALIDATION-ERROR") {
                    assertTrue(ex.desc =~ /enumerated values.*x/);
                } else {
                    rethrow;
                }
            }

            SwaggerDataProvider prov0 = Serializable::deserialize(provider.serialize());
            p0 = prov0.getChildProviderPath("pet/findByStatus/GET");
            req = p0.getRequestType();
            assertEq(NT_HASH, req.getField("query").getType().getBaseTypeCode());
            resp = p0.getResponseType();
            type = resp.getField("body").getType().getElementType();
            assertEq("*softint", type.getFieldType("id").getName());
            assertEq("softstring", type.getFieldType("name").getName());
            assertEq(("id", "category", "name", "photoUrls", "tags", "status"), keys type.getFields());

            # the following call depends on the public "pet shop" example Swagger server
            #assertEq(Type::List, p0.doRequest({"query": {"status": ("pending")}}).body.type());
        }

        {
            AbstractDataProvider p0 = provider.getChildProviderPath("pet/$id/POST");
            assertEq("POST", p0.getInfo().name);
            AbstractDataProviderType req = p0.getRequestType();
            assertEq(NT_HASH, req.getField("formData").getType().getBaseTypeCode());
        }

        opts.schema = File::readTextFile(opts.schema);
        provider = new SwaggerDataProvider(opts);
        {
            AbstractDataProvider p0 = provider.getChildProviderPath("pet/findByStatus/GET");
            AbstractDataProviderType req = p0.getRequestType();
            assertEq(NT_HASH, req.getField("query").getType().getBaseTypeCode());
        }

        {
            SwaggerDataProviderFactory factory();
            hash<DataProviderFactoryInfo> info = factory.getInfo();
            assertTrue(info.api_management);
            assertEq(("rest",), info.api_profiles);
        }
    }
}
