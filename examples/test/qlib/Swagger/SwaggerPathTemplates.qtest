#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
#
# The path templates of a Swagger schema are checked and compiled when the schema is loaded, so that a template that
# is not valid is an error of the schema and not of each request (qore#6603).

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires json
%requires QUnit
%requires Swagger

%exec-class SwaggerPathTemplatesTest

class SwaggerPathTemplatesTest inherits QUnit::Test {
    constructor() : Test("Swagger path templates", "1.0") {
        addTestCase("parameter extraction", \parametersTest());
        addTestCase("templates that are not valid", \invalidTest());
        addTestCase("deserialized schema", \deserializedTest());
        set_return_value(main());
    }

    private static hash<auto> pathDef(list<string> params) {
        return {"get": {
            "parameters": (map ("name": $1, "in": "path", "required": True, "type": "string"), params) ?? (),
            "responses": {"200": {"description": "ok"}},
        }};
    }

    private static SwaggerSchema load(hash<string, hash<auto>> paths, *hash<auto> opts) {
        return SwaggerLoader::fromString(make_json({
            "swagger": "2.0",
            "info": {"title": "templates", "version": "1"},
            "paths": paths,
        }), True, opts);
    }

    private SwaggerSchema validSchema() {
        return SwaggerPathTemplatesTest::load({
            "/items/{id}.json": SwaggerPathTemplatesTest::pathDef(("id",)),
            "/a+b/{x}(y)/{z}": SwaggerPathTemplatesTest::pathDef(("x", "z")),
        });
    }

    private checkSchema(SwaggerSchema s, string label) {
        hash<auto> hdr;
        assertEq({"id": "5"}, s.parseRequest("GET", "/items/5.json", NOTHING, \hdr).path_args, label);
        # the characters of the template other than its parameters match themselves
        assertEq({"x": "1", "z": "2"}, s.parseRequest("GET", "/a+b/1(y)/2", NOTHING, \hdr).path_args, label);
        assertThrows("SCHEMA-VALIDATION-ERROR", \s.parseRequest(), ("GET", "/aab/1(y)/2", NOTHING, \hdr), label);
        assertThrows("SCHEMA-VALIDATION-ERROR", \s.parseRequest(), ("GET", "/a+b/1y/2", NOTHING, \hdr), label);
    }

    parametersTest() {
        checkSchema(validSchema(), "loaded");
    }

    invalidTest() {
        hash<string, hash<auto>> paths = {
            "/items/{id}.json": SwaggerPathTemplatesTest::pathDef(("id",)),
            "/bad/{b": SwaggerPathTemplatesTest::pathDef(()),
        };
        # an unterminated parameter is an error when the schema is loaded
        assertThrows("INVALID-PATH-COMPONENT", "Invalid path template \"/bad/{b\"",
            \SwaggerPathTemplatesTest::load(), (paths,));
        assertThrows("INVALID-PATH-COMPONENT", \SwaggerPathTemplatesTest::load(),
            ({"/x/{}": SwaggerPathTemplatesTest::pathDef(())},));
        # with LM_IGNORE_INVALID_PATHS, the path is left out and the others are served
        SwaggerSchema s = SwaggerPathTemplatesTest::load(paths, {"parse_flags": LM_IGNORE_INVALID_PATHS});
        assertEq(("items/{id}.json",), keys s.getPathOperationHash());
        hash<auto> hdr;
        assertEq({"id": "5"}, s.parseRequest("GET", "/items/5.json", NOTHING, \hdr).path_args);
        assertThrows("SCHEMA-VALIDATION-ERROR", \s.parseRequest(), ("GET", "/bad/x", NOTHING, \hdr));
    }

    deserializedTest() {
        # the compiled patterns are not serialized; a deserialized schema compiles them when they are used
        SwaggerSchema s = Serializable::deserialize(validSchema().serialize());
        checkSchema(s, "deserialized");
    }
}
