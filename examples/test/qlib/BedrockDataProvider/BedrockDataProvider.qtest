#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Logger
%requires Mime
%requires HttpServerUtil
%requires HttpServer
%requires HttpServerAsyncIo
%requires ConnectionProvider
%requires DataProvider
%requires RestClientIo
%requires AwsRestClient
%requires BedrockRestClient
%requires BedrockDataProvider

%requires json

%exec-class BedrockDataProviderTest

class FakeBedrockHandler inherits AbstractHttpRequestHandler {
    public {
        string last_path = "";
        *hash<auto> last_body;
    }
    hash handleRequest(hash cx, hash hdr, *data body) {
        last_path = cx.raw_path;
        string body_str = body ? (body.typeCode() == NT_BINARY
            ? body.toString("UTF-8") : body) : "";
        try { last_body = parse_json(body_str); } catch () {}
        if (last_path =~ /\/converse$/) {
            return makeResponse({"Content-Type": MimeTypeJson}, 200, make_json({
                "output": {"message": {"role": "assistant",
                    "content": ({"text": "Hello from Bedrock DP"},)}},
                "stopReason": "end_turn",
                "usage": {"inputTokens": 4, "outputTokens": 5, "totalTokens": 9},
            }));
        }
        if (last_path =~ /\/invoke$/) {
            return makeResponse({"Content-Type": MimeTypeJson}, 200, make_json({
                "embedding": (0.1, 0.2, 0.3, 0.4),
                "inputTextTokenCount": 3,
            }));
        }
        return makeResponse(404, "unknown bedrock path: " + last_path);
    }
}

public class BedrockDataProviderTest inherits QUnit::Test {
    public {
        const MyOpts = Opts + {
            "conn": "c,connection=s",
        };

        const OptionColumn = 22;
    }

    private {
        HttpServer http;
        int port;
        FakeBedrockHandler handler;
        *string conn_name;
    }

    constructor() : Test("BedrockDataProvider Test", "1.0", \ARGV, MyOpts) {
        conn_name = m_options.conn ?? ENV.BEDROCK_CONNECTION;

        addTestCase("factory registered + provider info", \factoryTest());
        addTestCase("app registered with logo + group",   \appTest());
        addTestCase("converse + embed actions registered", \actionsTest());
        addTestCase("Converse action end-to-end",         \converseTest());
        addTestCase("Embed action end-to-end",            \embedTest());
        addTestCase("child providers discoverable",       \childrenTest());

        try { setupFakeServer(); }
        catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("setup error: %s\n", get_exception_string(ex));
            }
        }

        # Live test requires a real AWS Bedrock connection.
        # Cost: 1 token-bounded request on Claude 3.5 Haiku (~$0.001 per run).
        if (conn_name) {
            addTestCase("live: ping + converse (Claude Haiku)",
                \liveBedrockTest());
        }
        set_return_value(main());
    }

    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-c,--connection=ARG",
            "set the AWS Bedrock connection name; without it (and without "
            "the BEDROCK_CONNECTION env var) the live test is skipped",
            OptionColumn);
    }

    #! Exercises Bedrock's live Converse endpoint with a token-bounded request.
    /** Verifies the actual wire format against AWS Bedrock's production
        Converse API, including AWS SigV4 auth, model-id URL routing, and the
        response shape.  Cost: 1 token-bounded request on Claude 3.5 Haiku
        (~$0.001 per run).
    */
    private liveBedrockTest() {
        AbstractConnection conn = get_connection(conn_name);
        hash<auto> ping = conn.ping(True);
        assertTrue(ping.ok, sprintf("Bedrock connection ping failed: %s",
            ping.info ?? "no info"));

        AbstractDataProvider prov = conn.getDataProvider();
        AbstractDataProvider cv = prov.getChildProvider("converse");
        auto resp = cv.doRequest({
            "modelId": "anthropic.claude-3-5-haiku-20241022-v1:0",
            "messages": ({"role": "user", "content": ({"text": "Say hi in one word."},)},),
            "inferenceConfig": {"maxTokens": 16, "temperature": 0.0},
        });
        assertTrue(resp.output.message.content[0].text.val(),
            "Bedrock returned assistant text");
        assertTrue(resp.usage.totalTokens > 0,
            "Bedrock reported a positive total-token count");
    }

    static checkJson(Test test) {
    }

    private setupFakeServer() {
        Logger logger("test", LoggerLevel::getLevelInfo());
        http = new HttpServer(<HttpServerOptionInfo>{"logger": logger});
        handler = new FakeBedrockHandler();
        http.setDefaultHandler("bedrock", handler);
        port = http.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
    }

    globalTearDown() {
        delete http;
    }

    private factoryTest() {
        AbstractDataProviderFactory f = DataProvider::getFactoryEx("bedrock");
        assertEq("bedrock", f.getName());
        hash<DataProviderInfo> pi = f.getProviderInfo();
        assertTrue(pi.supports_children);
    }

    private appTest() {
        hash<DataProviderAppInfo> app =
            DataProviderActionCatalog::getApp(BedrockDataProvider::AppName);
        assertEq("AWS Bedrock", app.display_name);
        assertEq("bedrock", app.scheme);
        assertEq("bedrock-logo.svg", app.logo_file_name);
        assertEq(MimeTypeSvg, app.logo_mime_type);
        assertTrue(app.logo.val(), "logo content was loaded from the SVG file");
        assertTrue(inlist(DataProvider::AppGroup::AiLlm, app.groups));
    }

    private actionsTest() {
        list<hash<DataProviderActionInfo>> actions =
            DataProviderActionCatalog::getActionsEx(BedrockDataProvider::AppName);
        list<string> action_names = map $1.action, actions;
        assertTrue(inlist("converse", action_names));
        assertTrue(inlist("embed", action_names));

        hash<DataProviderActionInfo> conv =
            DataProviderActionCatalog::getAppActionEx(BedrockDataProvider::AppName, "converse");
        assertEq(DPAT_API, conv.action_code);
        assertEq("/converse", conv.path);
        foreach string action_name in (("converse", "embed")) {
            hash<DataProviderActionInfo> action = DataProviderActionCatalog::getAppActionEx(
                BedrockDataProvider::AppName, action_name);
            assertEq(NT_BOOLEAN, action.mutates_state.typeCode(),
                action_name + " publishes a typed mutation effect");
            assertFalse(DataProviderActionCatalog::actionMutatesState(action),
                action_name + " is pure inference by its producer contract");
        }
    }

    private converseTest() {
        BedrockDataProviderTest::checkJson(self);
        if (!http) {
            testSkip("no fake server");
        }
        AwsRestClient::AwsRestClientIo rest(buildRestOpts());
        BedrockConverseDataProvider prov(rest);
        auto resp = prov.doRequest({
            "modelId": "anthropic.claude-3-5-sonnet-20240620-v1:0",
            "messages": (
                {"role": "user", "content": ({"text": "hi"},)},
            ),
            "inferenceConfig": {"maxTokens": 64, "temperature": 0.0},
        });
        assertEq("Hello from Bedrock DP", resp.output.message.content[0].text);
        assertEq("end_turn", resp.stopReason);
        assertEq(9, resp.usage.totalTokens);
        # verify path got URL-encoded model ID
        assertTrue(handler.last_path =~ /\/model\/anthropic\..*\/converse$/,
            sprintf("expected /model/anthropic.../converse, got %y", handler.last_path));
        # body shape
        assertEq("user", handler.last_body.messages[0].role);
    }

    private embedTest() {
        BedrockDataProviderTest::checkJson(self);
        if (!http) {
            testSkip("no fake server");
        }
        AwsRestClient::AwsRestClientIo rest(buildRestOpts());
        BedrockEmbedDataProvider prov(rest);
        auto resp = prov.doRequest({
            "modelId": "amazon.titan-embed-text-v2:0",
            "inputText": "hello world",
        });
        assertEq((0.1, 0.2, 0.3, 0.4), resp.embedding);
        # Titan body shape
        assertEq("hello world", handler.last_body.inputText);
    }

    private childrenTest() {
        BedrockDataProviderTest::checkJson(self);
        if (!http) {
            testSkip("no fake server");
        }
        AwsRestClient::AwsRestClientIo rest(buildRestOpts());
        BedrockDataProvider::BedrockDataProvider root(rest);
        list<string> names = root.getChildProviderNames();
        assertTrue(inlist("converse", names));
        assertTrue(inlist("embed", names));
        AbstractDataProvider conv = root.getChildProviderEx("converse");
        assertEq("converse", conv.getName());
    }

    private hash<auto> buildRestOpts() {
        return {
            "url": "http://localhost:" + port,
            "aws_region": "us-east-1",
            "aws_service": "bedrock",
            "aws_keyid": "AKIA-TEST",
            "aws_secret": "test-secret",
            "aws_imds_disabled": True,
        };
    }
}
