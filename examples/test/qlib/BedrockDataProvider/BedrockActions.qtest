class BedrockActionFixtureClient inherits RestClientIo::RestClientIo {
    public {
        string method;
        string path;
        *data raw;
        *hash<auto> last_headers;
        auto response = {};
        int requests = 0;
    }

    constructor() : RestClientIo({"url": "https://bedrock-runtime.us-east-1.amazonaws.com",
            "data_type": "auto", "headers": {"accept": "application/json"}}) {
    }

    RestClient::AbstractRestClient copyWithUrl(string url) {
        return self;
    }

    hash<RestClient::RestResponseInfo> restDoRawRequest(string method, string path, *data body,
            *hash<auto> hdr) {
        self.method = method;
        self.path = path;
        raw = body;
        last_headers = hdr;
        ++requests;
        return <RestClient::RestResponseInfo>{"status_code": 200, "body": response};
    }

    hash<RestClient::RestResponseInfo> restDoRequest(string method, string path, auto body,
            *hash<auto> hdr) {
        self.method = method;
        self.path = path;
        last_headers = hdr;
        ++requests;
        return <RestClient::RestResponseInfo>{"status_code": 200, "body": response};
    }
}

