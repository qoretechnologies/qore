#!/usr/bin/env qore
# Copyright 2026 Qore Technologies, s.r.o. SPDX-License-Identifier: MIT
%modern
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires StabilityAiDataProvider
%requires HttpServer
%requires HttpServerUtil
%exec-class StabilityCompatibilityTest

const Png = parse_base64_string("");

class CompatibilityHandler inherits AbstractHttpRequestHandler {
    public { hash<auto> last; }
    hash handleRequest(hash cx, hash hdr, *data body) {
        last = {"path": cx.raw_path, "headers": hdr, "body": body.toString("ISO-8859-1")};
        return makeResponse({"Content-Type": "image/png", "Seed": "0", "Finish-Reason": "SUCCESS"}, 200, Png);
    }
}

class StabilityCompatibilityTest inherits QUnit::Test {
    private {
        HttpServer server;
        CompatibilityHandler handler();
        StabilityAiRestClientIo client;
    }
    constructor() : Test("Stability AI compatible generation", "1.1") {
        addTestCase("prebuilt client needs no redundant API key", \constructorsTest());
        addTestCase("default and overridden families send actual multipart", \generationTest());
        server = new HttpServer(<HttpServerOptionInfo>{"logger": new Logger::Logger("5422-compat", Logger::LoggerLevel::ERROR)});
        server.setDefaultHandler("fixture", handler);
        client = new StabilityAiRestClientIo({"apikey": "compatibility-key",
            "url": sprintf("http://127.0.0.1:%d", server.addListener(<HttpListenerOptionInfo>{"service": 0}).port)});
        set_return_value(main());
    }
    globalTearDown() { delete server; }
    private constructorsTest() {
        foreach auto root in ((new StabilityAiDataProvider::StabilityAiDataProvider(client),
                new StabilityAiDataProvider::StabilityAiDataProvider({"restclient": client}))) {
            assertEq("generate-image", root.getChildProvider("generate-image").getName());
            assertTrue(inlist("wait-for-audio", map $1.name, root.getChildProviderSummaryInfo()));
        }
    }
    private generationTest() {
        StabilityAiGenerateImageDataProvider provider(client);
        auto fields = provider.getRequestType().getFields();
        assertEq(("model=sd3",), fields.sd3_model.getAttributes().depends_on);
        assertEq(("model=sd3",), fields.mode.getAttributes().depends_on);
        assertEq(("model",), fields.image.getAttributes().depends_on);
        assertEq(("image",), fields.strength.getAttributes().depends_on);
        foreach hash<auto> request in (({"prompt": "blue mug", "aspect_ratio": "5:4"},
                {"prompt": "blue mug", "model": "ultra", "image": Png, "strength": 0},
                {"prompt": "blue mug", "model": "sd3", "sd3_model": "sd3.5-flash", "seed": 0},
                {"prompt": "blue mug", "model": "core", "negative_prompt": "", "aspect_ratio": "4:5"})) {
            auto response = provider.doRequest(request);
            assertEq("/v2beta/stable-image/generate/" + (request.model ?? "ultra"), handler.last.path);
            assertTrue(handler.last.headers."content-type" =~ /^multipart\/form-data;.*boundary=/);
            assertEq("Bearer compatibility-key", handler.last.headers.authorization);
            assertEq(Png, response.image);
            assertEq("image/png", response.content_type);
            assertEq("0", response.seed);
            assertEq("SUCCESS", response.finish_reason);
            auto restored = Serializable::deserialize(provider.getResponseType().serialize());
            assertEq(response, restored.acceptsValue(response));
            if (request.model == "sd3") {
                assertTrue(handler.last.body.find("\r\n\r\nsd3.5-flash\r\n") >= 0);
                assertEq(-1, handler.last.body.find("\r\n\r\nsd3\r\n"));
            }
        }
    }
}
