%modern
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires QoreMediaUtils
%requires StabilityAiRestClient
%exec-class StabilityRegistryTest

# Authentication.qtest and MediaWire.qtest exercise real HTTP. This test owns registry integration.
class StabilityRegistryTest inherits QUnit::Test {
    constructor() : Test("Stability AI registry integration", "1.1") {
        addTestCase("media backend factory preserves configuration", \factoryTest());
        addTestCase("invalid model fails before network I/O", \invalidTest());
        set_return_value(main());
    }
    private factoryTest() {
        auto factory = QoreMediaUtils::MediaProviderRegistry::getImageGeneratorFactoryEx("stability-ai");
        assertEq("StabilityAiRestClient", factory.getInfo().module_name);
        auto generator = factory.create(<QoreMediaUtils::ImageGeneratorConfig>{
            "backend": "stability-ai", "api_key": "fixture", "model": "core"});
        assertEq("stability-ai", generator.getMode());
        assertEq("core", generator.getModel());
    }
    private invalidTest() {
        assertThrows("MEDIA-CONFIG-ERROR", sub () {
            QoreMediaUtils::MediaProviderRegistry::createImageGenerator(<QoreMediaUtils::ImageGeneratorConfig>{
                "backend": "stability-ai", "api_key": "fixture", "model": "retired-model"});
        });
    }
}
