#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires RestClientIo
%requires QoreRagTypes
%requires QoreRagUtils
%requires json
%requires OpenSearchDataProvider
%requires MilvusRestClient
%requires ChromaRestClient
%requires WeaviateRestClient

%try-module pgsql
%define NoPgsql
%endtry

# Conformance of AbstractVectorStore::countByFilter(), deleteByFilter() and summarizeBy() (issue #5576).
#
# One scenario runs against every store that has a backend available:
#   - the in-memory reference store (always)
#   - Qdrant        (QDRANT_URL, for example http://127.0.0.1:6333; a temporary collection is created)
#   - pgvector      (QORE_DB_CONNSTR_PGSQL or PGVECTOR_DB_CONNSTR; a temporary table is created)
#   - MongoDB       (MONGODB_URL; records are scoped by a random payload value)
#   - OpenSearch    (OPENSEARCH_URL, for example http://127.0.0.1:9200; a temporary index is created)
#   - Milvus        (MILVUS_URL, for example http://127.0.0.1:19530; a temporary collection is created)
#   - Chroma        (CHROMA_URL, for example http://127.0.0.1:8000; a temporary collection is created)
#   - Weaviate      (WEAVIATE_URL, for example http://127.0.0.1:8080; a temporary class is created)
# Stores without a backend are covered by the mocked-transport tests next to each module.

%exec-class VectorStoreConformanceTest

#! Reference implementation: the behavior every store must match
class ReferenceVectorStore inherits QoreRagUtils::AbstractVectorStore {
    private {
        hash<string, hash<auto>> records = {};
    }

    upsert(list<hash<QoreRagUtils::VectorRecord>> recs) {
        foreach hash<QoreRagUtils::VectorRecord> r in (recs) {
            records{r.id} = {"id": r.id, "payload": r.payload ?? {}};
        }
    }

    deleteByIds(list<string> ids) {
        foreach string id in (ids) {
            remove records{id};
        }
    }

    list<hash<QoreRagUtils::VectorSearchResult>> search(list<float> query_vector, int k, *hash<auto> filter) {
        return ();
    }

    string getCollection() { return "reference"; }
    int getDimension() { return 3; }

    private list<hash<auto>> matching(*hash<auto> filter) {
        list<hash<auto>> rv = ();
        foreach hash<auto> r in (records.values()) {
            bool ok = True;
            foreach string key in (keys (filter.payload_eq ?? {})) {
                if (!exists r.payload{key} || r.payload{key} != filter.payload_eq{key}) {
                    ok = False;
                    break;
                }
            }
            if (ok) {
                push rv, r;
            }
        }
        return rv;
    }

    int countByFilter(*hash<auto> filter) {
        return matching(filter).size();
    }

    int deleteByFilter(hash<auto> filter) {
        QoreRagUtils::AbstractVectorStore::requireFilterCriteria(filter.payload_eq instanceof hash
            && filter.payload_eq.size() > 0);
        list<hash<auto>> hits = matching(filter);
        foreach hash<auto> r in (hits) {
            remove records{r.id};
        }
        return hits.size();
    }

    list<hash<QoreRagUtils::VectorFieldSummary>> summarizeBy(string field, *hash<auto> filter,
            *string timestamp_field) {
        hash<string, hash<auto>> groups = {};
        foreach hash<auto> r in (matching(filter)) {
            QoreRagUtils::AbstractVectorStore::addToSummary(\groups, r.payload{field},
                timestamp_field ? r.payload{timestamp_field} : NOTHING);
        }
        return QoreRagUtils::AbstractVectorStore::finishSummary(groups);
    }
}

public class VectorStoreConformanceTest inherits QUnit::Test {
    constructor() : Test("VectorStore conformance", "1.0", \ARGV) {
        addTestCase("in-memory reference store", \referenceTest());
        if (ENV.QDRANT_URL.val()) {
            addTestCase("Qdrant", \qdrantTest());
        }
        if ((ENV.PGVECTOR_DB_CONNSTR ?? ENV.QORE_DB_CONNSTR_PGSQL).val()) {
            addTestCase("pgvector", \pgvectorTest());
        }
        if (ENV.MONGODB_URL.val()) {
            addTestCase("MongoDB", \mongoTest());
        }
        if (ENV.OPENSEARCH_URL.val()) {
            addTestCase("OpenSearch", \opensearchTest());
        }
        if (ENV.MILVUS_URL.val()) {
            addTestCase("Milvus", \milvusTest());
        }
        if (ENV.CHROMA_URL.val()) {
            addTestCase("Chroma", \chromaTest());
        }
        if (ENV.WEAVIATE_URL.val()) {
            addTestCase("Weaviate", \weaviateTest());
        }
        set_return_value(main());
    }

    referenceTest() {
        runScenario(new ReferenceVectorStore(), "ref-" + get_random_string(6));
    }

    qdrantTest() {
        string name = "conformance_" + get_random_string(8).lwr();
        RestClientIo::RestClientIo rest({"url": ENV.QDRANT_URL, "data": "json"});
        try {
            rest.restGet("/collections");
        } catch (hash<ExceptionInfo> ex) {
            testSkip(sprintf("Qdrant is not reachable at %y: %s", ENV.QDRANT_URL, ex.desc));
        }
        rest.restPut("/collections/" + name, {"vectors": {"size": 3, "distance": "Cosine"}});
        on_exit {
            try {
                rest.restDel("/collections/" + name);
            } catch () {
            }
        }
        QoreRagUtils::AbstractVectorStore store = QoreRagUtils::RagProviderRegistry::createVectorStore(
            <QoreRagUtils::VectorStoreConfig>{
                "backend": "qdrant",
                "collection": name,
                "url": ENV.QDRANT_URL,
                "options": {"dimension": 3},
            });
        runScenario(store, "qd-" + get_random_string(6));
    }

    opensearchTest() {
        string name = "conformance_" + get_random_string(8).lwr();
        RestClientIo::RestClientIo rest({"url": ENV.OPENSEARCH_URL, "data": "json"});
        try {
            rest.restGet("/");
        } catch (hash<ExceptionInfo> ex) {
            testSkip(sprintf("OpenSearch is not reachable at %y: %s", ENV.OPENSEARCH_URL, ex.desc));
        }
        rest.restPut("/" + name, {
            "settings": {"index": {"knn": True}},
            # payload_eq is an exact term match, so the string payload fields must be keyword fields
            "mappings": {"properties": {
                "embedding": {"type": "knn_vector", "dimension": 3},
                "scope": {"type": "keyword"},
                "k": {"type": "keyword"},
            }},
        });
        on_exit {
            try {
                rest.restDel("/" + name);
            } catch () {
            }
        }
        QoreRagUtils::AbstractVectorStore store = QoreRagUtils::RagProviderRegistry::createVectorStore(
            <QoreRagUtils::VectorStoreConfig>{
                "backend": "opensearch",
                "collection": name,
                "url": ENV.OPENSEARCH_URL,
                "options": {"dimension": 3, "refresh": "true"},
            });
        runScenario(store, "os-" + get_random_string(6));
    }

    milvusTest() {
        string name = "conformance_" + get_random_string(8).lwr();
        string token = ENV.MILVUS_TOKEN ?? "root:Milvus";
        RestClientIo::RestClientIo rest({"url": ENV.MILVUS_URL, "data": "json",
            "headers": {"Authorization": "Bearer " + token}});
        # Milvus reports errors in the response body with a 200 status
        code check = sub (hash<auto> response, string what) {
            if (response.body.code != 0) {
                throw "MILVUS-TEST-ERROR", sprintf("%s failed: %y", what, response.body);
            }
        };
        try {
            check(rest.restPost("/v2/vectordb/collections/list", {}), "listing collections");
        } catch (hash<ExceptionInfo> ex) {
            testSkip(sprintf("Milvus is not reachable at %y: %s", ENV.MILVUS_URL, ex.desc));
        }
        # a quick-setup collection: VarChar primary key "id", COSINE vector field "vector", dynamic fields on, loaded
        check(rest.restPost("/v2/vectordb/collections/create", {
            "collectionName": name,
            "dimension": 3,
            "metricType": "COSINE",
            "idType": "VarChar",
            "autoID": False,
            "primaryFieldName": "id",
            "vectorFieldName": "vector",
            # Strong consistency: Milvus REST reads see the collection's level, and the scenario reads right after writes
            "params": {"max_length": 64, "enableDynamicField": True, "consistencyLevel": "Strong"},
        }), "creating the collection");
        on_exit {
            try {
                rest.restPost("/v2/vectordb/collections/drop", {"collectionName": name});
            } catch () {
            }
        }
        QoreRagUtils::AbstractVectorStore store = QoreRagUtils::RagProviderRegistry::createVectorStore(
            <QoreRagUtils::VectorStoreConfig>{
                "backend": "milvus",
                "collection": name,
                "url": ENV.MILVUS_URL,
                "options": {"api_key": token, "dimension": 3},
            });
        runScenario(store, "mv-" + get_random_string(6));
    }

    chromaTest() {
        string name = "conformance_" + get_random_string(8).lwr();
        RestClientIo::RestClientIo rest({"url": ENV.CHROMA_URL, "data": "json"});
        string base = "/api/v2/tenants/default_tenant/databases/default_database/collections";
        string id;
        try {
            rest.restGet("/api/v2/heartbeat");
        } catch (hash<ExceptionInfo> ex) {
            testSkip(sprintf("Chroma is not reachable at %y: %s", ENV.CHROMA_URL, ex.desc));
        }
        # the store addresses a collection by its UUID, which Chroma assigns
        id = rest.restPost(base, {"name": name, "configuration": {"hnsw": {"space": "cosine"}}}).body.id;
        on_exit {
            try {
                rest.restDel(base + "/" + id);
            } catch () {
            }
        }
        QoreRagUtils::AbstractVectorStore store = QoreRagUtils::RagProviderRegistry::createVectorStore(
            <QoreRagUtils::VectorStoreConfig>{
                "backend": "chroma",
                "collection": id,
                "url": ENV.CHROMA_URL,
                "options": {"dimension": 3},
            });
        runScenario(store, "ch-" + get_random_string(6));
    }

    weaviateTest() {
        # Weaviate class names start with an uppercase letter
        string name = "Conformance" + get_random_string(8).lwr();
        RestClientIo::RestClientIo rest({"url": ENV.WEAVIATE_URL, "data": "json"});
        try {
            rest.restGet("/v1/.well-known/ready");
        } catch (hash<ExceptionInfo> ex) {
            testSkip(sprintf("Weaviate is not reachable at %y: %s", ENV.WEAVIATE_URL, ex.desc));
        }
        rest.restPost("/v1/schema", {
            "class": name,
            "vectorizer": "none",
            "properties": (
                {"name": "scope", "dataType": ("text",)},
                {"name": "k", "dataType": ("text",)},
                {"name": "t", "dataType": ("text",)},
            ),
        });
        on_exit {
            try {
                rest.restDel("/v1/schema/" + name);
            } catch () {
            }
        }
        QoreRagUtils::AbstractVectorStore store = QoreRagUtils::RagProviderRegistry::createVectorStore(
            <QoreRagUtils::VectorStoreConfig>{
                "backend": "weaviate",
                "collection": name,
                "url": ENV.WEAVIATE_URL,
                "options": {"dimension": 3},
            });
        # Weaviate object ids must be UUIDs
        runScenario(store, "wv-" + get_random_string(6), (
            "5e4d1a10-0000-4000-8000-000000000001",
            "5e4d1a10-0000-4000-8000-000000000002",
            "5e4d1a10-0000-4000-8000-000000000003",
            "5e4d1a10-0000-4000-8000-000000000004",
        ));
    }

    pgvectorTest() {
%ifdef NoPgsql
        testSkip("no pgsql module");
%endif
        Datasource ds((ENV.PGVECTOR_DB_CONNSTR ?? ENV.QORE_DB_CONNSTR_PGSQL));
        on_exit ds.close();
        try {
            ds.exec("CREATE EXTENSION IF NOT EXISTS vector");
            ds.commit();
        } catch (hash<ExceptionInfo> ex) {
            on_error ds.rollback();
            testSkip("pgvector is not available: " + ex.desc);
        }
        string table = "conformance_" + get_random_string(8).lwr();
        ds.exec(sprintf("CREATE TABLE %s (id text PRIMARY KEY, embedding vector(3), payload jsonb)", table));
        ds.commit();
        on_exit {
            ds.exec("DROP TABLE IF EXISTS " + table);
            ds.commit();
        }
        QoreRagUtils::AbstractVectorStore store = new QoreRagUtils::PgVectorRagProvider(<QoreRagUtils::VectorStoreConfig>{
            "backend": "pgvector",
            "collection": table,
            "options": {"datasource": ds, "dimension": 3},
        });
        runScenario(store, "pg-" + get_random_string(6));
    }

    mongoTest() {
        QoreRagUtils::AbstractVectorStore store = QoreRagUtils::RagProviderRegistry::createVectorStore(
            <QoreRagUtils::VectorStoreConfig>{
                "backend": "mongo-atlas",
                "collection": "qore_rag_conformance",
                "url": ENV.MONGODB_URL,
                "options": {"database": "qore_rag_test", "index_name": "unused"},
            });
        try {
            store.countByFilter();
        } catch (hash<ExceptionInfo> ex) {
            testSkip(sprintf("MongoDB is not reachable at %y: %s", ENV.MONGODB_URL, ex.desc));
        }
        string scope = "mongo-" + get_random_string(6);
        on_exit {
            try {
                store.deleteByFilter({"payload_eq": {"scope": scope}});
            } catch () {
            }
        }
        runScenario(store, scope);
    }

    #! The scenario every store must satisfy; \a scope isolates this run's records from any others in the store
    /** \a ids are the four record ids to use, for stores that require a particular id format
    */
    private runScenario(QoreRagUtils::AbstractVectorStore store, string scope,
            list<string> ids = ("1", "2", "3", "4")) {
        @assert(ids.size() == 4);
        store.upsert((
            <QoreRagUtils::VectorRecord>{"id": ids[0], "vector": (1.0, 0.0, 0.0),
                "payload": {"k": "a", "scope": scope, "t": "2026-11-01T10:00:00"}},
            <QoreRagUtils::VectorRecord>{"id": ids[1], "vector": (0.0, 1.0, 0.0),
                "payload": {"k": "b", "scope": scope, "t": "2026-11-02T10:00:00"}},
            <QoreRagUtils::VectorRecord>{"id": ids[2], "vector": (0.0, 0.0, 1.0),
                "payload": {"k": "b", "scope": scope, "t": "2026-11-03T10:00:00"}},
            <QoreRagUtils::VectorRecord>{"id": ids[3], "vector": (1.0, 1.0, 0.0), "payload": {"scope": scope}},
        ));
        hash<auto> mine = {"payload_eq": {"scope": scope}};

        # no filter is valid: it covers every record, including the ones seeded here
        assertTrue(store.countByFilter() >= 4, "countByFilter() without a filter counts every record");
        assertTrue(store.countByFilter({}) >= 4, "an empty filter counts every record");
        int total;
        foreach hash<QoreRagUtils::VectorFieldSummary> g in (store.summarizeBy("scope")) {
            total += g.count;
        }
        assertTrue(total >= 4, "summarizeBy() without a filter covers every record");
        assertEq(4, (select store.summarizeBy("scope"), $1.value == scope)[0].count);

        # counting
        assertEq(4, store.countByFilter(mine));
        assertEq(2, store.countByFilter({"payload_eq": {"scope": scope, "k": "b"}}));
        assertEq(0, store.countByFilter({"payload_eq": {"scope": scope + "-none"}}));

        # summary: ordered by descending count; the group without the field sorts last among equal counts
        list<hash<QoreRagUtils::VectorFieldSummary>> groups = store.summarizeBy("k", mine, "t");
        assertEq(("b", "a", NOTHING), map $1.value, groups);
        assertEq((2, 1, 1), map $1.count, groups);
        assertEq(2026-11-03T10:00:00, groups[0].last_write);
        assertEq(2026-11-01T10:00:00, groups[1].last_write);
        assertFalse(exists groups[2].last_write);
        # without a timestamp field there is no last_write
        groups = store.summarizeBy("k", mine);
        assertEq((2, 1, 1), map $1.count, groups);
        assertFalse(exists groups[0].last_write);
        # nothing matches
        assertEq((), store.summarizeBy("k", {"payload_eq": {"scope": scope + "-none"}}));

        # deletion: counts what it removed, leaves the rest, and is idempotent
        assertEq(2, store.deleteByFilter({"payload_eq": {"scope": scope, "k": "b"}}));
        assertEq(2, store.countByFilter(mine));
        assertEq(0, store.deleteByFilter({"payload_eq": {"scope": scope, "k": "b"}}));

        # a filter that selects everything is refused, and removes nothing
        foreach hash<auto> bad in (({}, {"payload_eq": {}})) {
            assertThrows("VECTOR-STORE-FILTER-ERROR", \store.deleteByFilter(), bad);
        }
        assertEq(2, store.countByFilter(mine), "a refused delete removes nothing");

        assertEq(2, store.deleteByFilter(mine));
        assertEq(0, store.countByFilter(mine));
    }
}
