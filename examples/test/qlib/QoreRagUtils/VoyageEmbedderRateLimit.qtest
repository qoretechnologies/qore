#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# VoyageEmbedderRateLimit.qtest Copyright 2026 Qore Technologies, s.r.o. — MIT License

%modern
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires RestClientIo
%requires QoreRagTypes
%requires HttpServer
%requires HttpServerAsyncIo
%requires VoyageRestClient
%requires VoyageDataProvider
%requires json

%exec-class VoyageEmbedderRateLimitTest

#! Fake Voyage embeddings endpoint driven by a per-test script
/** Every input "t<N>" is answered with the vector (N, 0.5); the data items are returned in reverse order
    so the client must restore the input order from their indexes.
*/
class FakeVoyageHandler inherits AbstractHttpRequestHandler {
    public {
        #! Releases a stalled response
        Channel release(100);
    }

    private {
        Mutex m();
        #! Scripted responses for the next requests; an empty script answers success
        list<hash<auto>> script = ();
        #! A response repeated after the script is exhausted
        *hash<auto> repeat;
        list<hash<auto>> requests = ();
    }

    setScript(list<hash<auto>> responses, *hash<auto> repeat) {
        AutoLock al(m);
        script = responses;
        self.repeat = repeat;
        requests = ();
    }

    list<hash<auto>> getRequests() {
        AutoLock al(m);
        return requests;
    }

    hash handleRequest(hash cx, hash hdr, *data body) {
        hash<auto> req = body ? parse_json(body) : {};
        *hash<auto> step;
        {
            AutoLock al(m);
            push requests, {
                "path": cx.raw_path,
                # the client port identifies the connection
                "cid": cx."peer-info".port,
                "input": req.input,
                "body": req,
                "auth": hdr.authorization,
            };
            step = script ? shift script : repeat;
        }
        if (step.stall) {
            # hold the response until the test releases it, as a connection that delivers nothing would
            release.recv(step.stall);
        }
        if (step.close) {
            list<hash<auto>> data = map ("index": $1, "embedding": (float(0), 0.5)), xrange(req.input.size());
            return makeResponse(200, make_json({"data": data}), {"Content-Type": MimeTypeJson,
                "Connection": "close"});
        }
        if (step.status) {
            return makeResponse(step.status, make_json(step.body ?? {"detail": "scripted failure"}),
                {"Content-Type": MimeTypeJson} + (step.headers ?? {}));
        }
        if (cx.raw_path =~ /rerank$/) {
            list<hash<auto>> ranked = ();
            for (int i = 0; i < req.documents.size(); ++i) {
                push ranked, {"index": i, "relevance_score": 1.0 - i * 0.1, "document": req.documents[i]};
            }
            return makeResponse(200, make_json({"data": ranked, "usage": {"total_tokens": 11}}),
                {"Content-Type": MimeTypeJson});
        }
        list<hash<auto>> data = ();
        int tokens = 0;
        for (int i = req.input.size() - 1; i >= 0; --i) {
            string text = req.input[i];
            float n = (text =~ /^t[0-9]+$/) ? float(text.substr(1)) : -1.0;
            push data, {"index": i, "embedding": (n, 0.5)};
            tokens += text.size() / 4 + 1;
        }
        return makeResponse(200, make_json({"data": data, "usage": {"total_tokens": tokens}}),
            {"Content-Type": MimeTypeJson});
    }
}

#! Virtual time for a rate limiter: the limiter's clock moves only when the limiter asks to wait
/** Every wait the limiter asks for is pushed to @ref events with its length in ms and the waiting thread's ID.  By
    default a wait advances the clock by its length and returns at once, so the limiter decides exactly as after a
    real wait of that length, without waiting.  A blocking instance leaves the clock unchanged and has the limiter
    wait until it is woken by a settled request or a block, or until its thread is cancelled.

    Test threads push their outcomes to @ref events as well, so a test reads everything in the order it happened,
    without sleeps or timeouts.
*/
class VirtualTime {
    public {
        #! The limiter's time in microseconds; far from any monotonic time, so a deadline taken from another clock
        #! is far off and fails the test
        int now_us = 1000000000000000;
        #! Waits (\c wait in ms and \c tid) and thread outcomes (\c outcome), in order
        Queue events();
    }

    private {
        bool block;
    }

    constructor(EmbedderRateLimiter limiter, bool block = False) {
        self.block = block;
        limiter.setClock(int sub () { return now_us; });
        limiter.setWaiter(bool sub (int ms) {
            events.push({"wait": ms, "tid": gettid()});
            if (!self.block) {
                now_us += ms * 1000;
            }
            return self.block;
        });
    }

    #! Lets every later wait pass virtual time and wakes the waiters, so no thread is left waiting after a test
    release(EmbedderRateLimiter limiter) {
        block = False;
        # settling an unknown ticket only wakes the waiters
        limiter.settle(-1);
    }

    #! Returns the lengths of the waits recorded so far, in ms; any other event fails the test
    list<int> takeWaits() {
        list<int> rv = ();
        while (events.size()) {
            hash<auto> event = events.get();
            if (!exists event.wait) {
                throw "UNEXPECTED-EVENT", sprintf("expected a wait; got %y", event);
            }
            push rv, event.wait;
        }
        return rv;
    }
}

#! A limiter that records when it admits each request, as it decides it
class RecordingRateLimiter inherits EmbedderRateLimiter {
    public {
        #! the admission instants, in the limiter's clock, in admission order
        Queue admissions();
    }

    constructor(*int requests_per_window, *int tokens_per_window, int window_ms = 60000)
            : EmbedderRateLimiter(requests_per_window, tokens_per_window, window_ms) {
    }

    private admitted(hash<EmbedderRateLimitTicket> ticket) {
        admissions.push(ticket.admitted_us);
    }

    #! Returns the recorded admission instants
    list<int> getAdmissions() {
        list<int> rv = ();
        while (admissions.size()) {
            push rv, admissions.get();
        }
        return rv;
    }
}

#! Voyage embedder with a test limiter
class TestVoyageEmbedder inherits VoyageEmbedder {
    private {
        *EmbedderRateLimiter test_limiter;
    }

    constructor(hash<EmbedderConfig> config, *EmbedderRateLimiter limiter) : VoyageEmbedder(config) {
        test_limiter = limiter;
    }

    private EmbedderRateLimiter getRateLimiter() {
        return test_limiter ?? VoyageEmbedder::getRateLimiter();
    }
}

#! Voyage reranker with a test limiter
class TestVoyageReranker inherits VoyageReranker {
    private {
        EmbedderRateLimiter test_limiter;
    }

    constructor(hash<RerankerConfig> config, EmbedderRateLimiter limiter) : VoyageReranker(config) {
        test_limiter = limiter;
    }

    private EmbedderRateLimiter getRateLimiter() {
        return test_limiter;
    }
}

#! Recording limiter without jitter, so rate-limit waits are exact
class ExactLimiter inherits RecordingRateLimiter {
    constructor(*int requests, *int tokens, int window_ms = 60000) : RecordingRateLimiter(requests, tokens, window_ms) {
    }

    private int jitter(int limit_ms) {
        return 0;
    }
}

class VoyageEmbedderRateLimitTest inherits QUnit::Test {
    private {
        HttpServer http;
        int port;
        FakeVoyageHandler handler;
        int key_seq = 0;
    }

    constructor() : Test("VoyageEmbedderRateLimitTest", "1.0") {
        addTestCase("limiter: request limit spaces concurrent admissions", \testLimiterRequestSpacing());
        addTestCase("limiter: token limit waits and settling frees capacity", \testLimiterTokens());
        addTestCase("limiter: block delays admission", \testLimiterBlock());
        addTestCase("limiter: deadline fails at once when nothing can free capacity",
            \testLimiterDeadline());
        addTestCase("limiter: invalid limits are rejected", \testLimiterConfig());
        addTestCase("limiter: cancellation interrupts an admission wait", \testLimiterCancel());
        addTestCase("limiter: shared per key", \testSharedRegistry());
        addTestCase("packing: input limit keeps order", \testPackInputs());
        addTestCase("packing: token limit and oversized input", \testPackTokens());
        addTestCase("packing: failed request names its inputs", \testAttribution());
        addTestCase("packing: preferred batch size", \testPreferredBatchSize());
        addTestCase("rate limit: concurrent embedders are spaced by the shared limiter",
            \testEmbedderSpacing());
        addTestCase("rate limit: 429 with Retry-After is retried after the delay", \testRetryAfter());
        addTestCase("rate limit: 429 without Retry-After backs off exponentially", \testBackoff());
        addTestCase("rate limit: exhausted retries raise EMBEDDER-RATE-LIMIT-ERROR", \testExhausted());
        addTestCase("rate limit: Retry-After beyond the budget fails at once", \testBudget());
        addTestCase("rate limit: cancellation interrupts the backoff wait", \testCancelBackoff());
        addTestCase("rate limit: defaults and configured limits", \testLimits());
        addTestCase("rate limit: transient failures are still retried", \testTransientRetry());
        addTestCase("dimension: learned once per process", \testSharedDimension());
        addTestCase("connection: rate limit options", \testConnectionOptions());
        addTestCase("limiter call: observer sees retries and long waits", \testCallObserver());
        addTestCase("embedder: packs its own requests; waits reach the telemetry observer",
            \testPacksAndWaitTelemetry());
        addTestCase("reranker: shares a rerank bucket and retries 429 like the embedder", \testReranker());
        addTestCase("reranker: exhausted retries raise RERANKER-RATE-LIMIT-ERROR", \testRerankerExhausted());
        addTestCase("data provider: embeddings share the embedder's limiter and 429 policy",
            \testDataProvider());
        addTestCase("data provider: exhausted rerank retries raise RERANKER-RATE-LIMIT-ERROR",
            \testDataProviderExhausted());
        addTestCase("ping: counted by the limiter and never waits long", \testPing());
        addTestCase("ping: a 429 is not retried and blocks the account", \testPing429());
        addTestCase("attempt cap: a stalled attempt is retried within the budget", \testStalledAttempt());
        addTestCase("attempt cap: the default is derived from the budget and the request size",
            \testAttemptDefaults());
        addTestCase("shared client: embedders of one account use one connection", \testSharedConnection());
        addTestCase("shared client: a closed connection is replaced", \testReplacedConnection());
        addTestCase("shared client: another API key gets its own client", \testSharedClientKeys());
        set_return_value(main());
    }

    globalSetUp() {
        Logger logger("voyage-rate-limit-test", LoggerLevel::getLevelWarn());
        http = new HttpServer(<HttpServerOptionInfo>{"logger": logger});
        handler = new FakeVoyageHandler();
        http.setDefaultHandler("voyage", handler);
        port = http.addListener(<HttpListenerOptionInfo>{"node": "localhost", "service": 0}).port;
    }

    globalTearDown() {
        delete http;
    }

    #! Each embedder gets its own API key, so the shared limiters of different tests never interact
    private hash<EmbedderConfig> config(*hash<auto> extra) {
        return cast<hash<EmbedderConfig>>(<EmbedderConfig>{
            "backend": "voyage",
            "url": "http://localhost:" + port,
            "model": "voyage-4-lite",
            "api_key": sprintf("key-%d-%d", getpid(), ++key_seq),
            "retry_max_delay": 0,
        } + (extra ?? {}));
    }

    #! Gives the process-wide limiter of an account, request kind and model virtual time, before any client uses it
    private VirtualTime sharedVirtualTime(string key, string model, *int requests_per_minute,
            string kind = VoyageRestClient::VoyageRestClientBase::RateLimitEmbed) {
        return new VirtualTime(VoyageRestClient::VoyageRestClientBase::getRateLimiter(kind, "http://localhost:" + port,
            key, model, requests_per_minute));
    }

    private list<string> inputs(int count, int offset = 0) {
        return map sprintf("t%d", $1), xrange(offset, offset + count);
    }

    private assertOrdered(list<list<float>> vectors, int count) {
        assertEq(count, vectors.size());
        for (int i = 0; i < count; ++i) {
            if (vectors[i][0] != float(i)) {
                fail(sprintf("vector %d is for input %y", i, vectors[i][0]));
            }
        }
    }

    #! Returns admission instants relative to a start time
    private list<int> since(int t0, list<int> times) {
        return map $1 - t0, times;
    }

    testLimiterRequestSpacing() {
        # the instants at which the limiter admits the requests, in virtual time: a waiting thread advances the clock
        # by exactly the wait the limiter asked for, so the instants do not depend on how the threads are scheduled
        RecordingRateLimiter limiter(2, NOTHING, 300);
        VirtualTime vt(limiter);
        int t0 = vt.now_us;
        Counter done(5);
        for (int i = 0; i < 5; ++i) {
            background sub () {
                on_exit done.dec();
                int id = limiter.admit(1, t0 + 5000000);
                limiter.settle(id, 1);
            }();
        }
        done.waitForZero();
        assertEq((0, 0, 300000, 300000, 600000), since(t0, limiter.getAdmissions()),
            "two admissions per window; each later one waited for the window");
        assertEq((300, 300), vt.takeWaits(), "the limiter waited exactly until the window had room");
    }

    testLimiterTokens() {
        # a blocking virtual clock: the waiter waits until it is woken, and no virtual time passes
        RecordingRateLimiter limiter(NOTHING, 100, 60000);
        VirtualTime vt(limiter, True);
        # a failed check must not leave the waiting thread blocked
        on_exit vt.release(limiter);
        int t0 = vt.now_us;
        int first = limiter.admit(80, t0 + 1000000);
        background sub () {
            try {
                int id = limiter.admit(50, t0 + 5000000);
                limiter.settle(id, 50);
                vt.events.push({"outcome": "admitted"});
            } catch (hash<ExceptionInfo> ex) {
                vt.events.push({"outcome": ex.err});
            }
        }();
        # the window is full until the first request leaves it in a minute, after the waiter's deadline; the first
        # request is in flight, so the waiter waits until its deadline for it to settle
        assertEq(5000, vt.events.get().wait, "the waiter waits for the request in flight");
        # the provider reported less usage than the estimate, which frees the window for the waiter
        limiter.settle(first, 10);
        assertEq("admitted", vt.events.get().outcome);
        assertEq((0, 0), since(t0, limiter.getAdmissions()),
            "settled usage admitted the waiter at once, long before the window expired");
        assertEq(t0, vt.now_us);
        assertEq({"requests": 2, "tokens": 60}, limiter.usage());

        # a request larger than the token limit is admitted alone, once the window is empty
        RecordingRateLimiter small(NOTHING, 10, 200);
        VirtualTime svt(small);
        t0 = svt.now_us;
        small.settle(small.admit(5, t0 + 1000000), 5);
        small.settle(small.admit(50, t0 + 2000000));
        assertEq((0, 200000), since(t0, small.getAdmissions()), "an oversized request waits for an empty window");
        assertEq((200,), svt.takeWaits());
    }

    testLimiterBlock() {
        RecordingRateLimiter limiter(100, NOTHING, 60000);
        VirtualTime vt(limiter);
        int t0 = vt.now_us;
        limiter.block(300);
        limiter.settle(limiter.admit(1, t0 + 2000000));
        assertEq((300000,), since(t0, limiter.getAdmissions()), "a block holds admission for its duration");
        assertEq((300,), vt.takeWaits());
        # an earlier block does not shorten a later one
        t0 = vt.now_us;
        limiter.block(300);
        limiter.block(10);
        limiter.settle(limiter.admit(1, t0 + 2000000));
        assertEq((300000,), since(t0, limiter.getAdmissions()));
        assertEq((300,), vt.takeWaits());
    }

    testLimiterDeadline() {
        EmbedderRateLimiter limiter(1, NOTHING, 60000);
        VirtualTime vt(limiter);
        int t0 = vt.now_us;
        limiter.settle(limiter.admit(1, t0 + 1000000));
        try {
            limiter.admit(1, t0 + 5000000);
            fail("expected EMBEDDER-RATE-LIMIT-ERROR");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("EMBEDDER-RATE-LIMIT-ERROR", ex.err);
            assertEq("rate_limit_wait_deadline", ex.arg.reason_code);
            assertTrue(ex.arg.retryable);
            assertEq(60000, ex.arg.wait_ms, "the window has room again in a minute");
        }
        assertEq((), vt.takeWaits(), "nothing in flight: no wait before failing");
        assertEq(t0, vt.now_us);

        # with a request in flight, the waiter waits until its deadline for it to settle
        EmbedderRateLimiter busy(1, NOTHING, 60000);
        VirtualTime bvt(busy);
        t0 = bvt.now_us;
        busy.admit(1, t0 + 1000000);
        assertThrows("EMBEDDER-RATE-LIMIT-ERROR", \busy.admit(), (1, t0 + 200000));
        assertEq((200,), bvt.takeWaits(), "the waiter waited until its deadline");
    }

    testLimiterConfig() {
        assertThrows("EMBEDDER-RATE-LIMIT-CONFIG-ERROR", sub () { new EmbedderRateLimiter(-1); });
        assertThrows("EMBEDDER-RATE-LIMIT-CONFIG-ERROR", sub () { new EmbedderRateLimiter(1, -1); });
        assertThrows("EMBEDDER-RATE-LIMIT-CONFIG-ERROR", sub () { new EmbedderRateLimiter(1, 1, 0); });
        EmbedderRateLimiter limiter(0, 0);
        assertEq({"requests": NOTHING, "tokens": NOTHING}, limiter.getLimits(), "zero means unlimited");
        assertThrows("EMBEDDER-CONFIG-ERROR", sub () {
            new VoyageEmbedder(config({"requests_per_minute": -1}));
        });
        assertThrows("EMBEDDER-CONFIG-ERROR", sub () {
            new VoyageEmbedder(config({"rate_limit_timeout": 0}));
        });
    }

    testLimiterCancel() {
        EmbedderRateLimiter limiter(2, NOTHING, 60000);
        # a blocking virtual clock: the wait ends only when the waiter is woken or cancelled
        VirtualTime vt(limiter, True);
        # a failed check must not leave the waiting thread blocked
        on_exit vt.release(limiter);
        int t0 = vt.now_us;
        limiter.settle(limiter.admit(1, t0 + 1000000));
        # keep a request in flight so the waiter waits instead of failing at once
        limiter.admit(1, t0 + 1000000);
        background sub () {
            try {
                limiter.admit(1, t0 + 50000000);
                vt.events.push({"outcome": "admitted"});
            } catch (hash<ExceptionInfo> ex) {
                clear_thread_cancel();
                vt.events.push({"outcome": ex.err});
            }
        }();
        hash<auto> wait = vt.events.get();
        assertEq(50000, wait.wait, "the waiter waits until its deadline");
        cancel_thread(wait.tid);
        assertEq("THREAD-CANCELLED", vt.events.get().outcome, "cancellation ended the wait");
        assertEq(t0, vt.now_us);
        assertEq(0, vt.events.size(), "the cancelled thread did not wait again");
    }

    testSharedRegistry() {
        string key = sprintf("test|%d|shared", getpid());
        EmbedderRateLimiter a = EmbedderRateLimiter::getShared(key, 10, 100);
        EmbedderRateLimiter b = EmbedderRateLimiter::getShared(key, 20, 200);
        assertTrue(a == b, "one limiter per key");
        assertEq({"requests": 20, "tokens": 200}, a.getLimits(), "the latest configuration applies");
        assertFalse(a == EmbedderRateLimiter::getShared(key + "|other", 10, 100));
        # a client without a configuration of its own does not override configured limits
        EmbedderRateLimiter::getShared(key, 1900, 15200000, False);
        assertEq({"requests": 20, "tokens": 200}, a.getLimits());
    }

    testPackInputs() {
        handler.setScript(());
        VoyageEmbedder emb(config());
        assertOrdered(emb.encodeDocuments(inputs(2500)), 2500);
        list<hash<auto>> requests = handler.getRequests();
        assertEq((1000, 1000, 500), map $1.input.size(), requests);
        assertEq(inputs(1000, 1000), requests[1].input, "requests carry consecutive inputs");
        assertEq("document", requests[2].body.input_type);
    }

    testPackTokens() {
        handler.setScript(());
        # voyage-4-large: 120,000 tokens per request; an input is estimated at its byte length
        VoyageEmbedder emb(config({"model": "voyage-4-large"}));
        assertEq(120000, emb.getMaxTokensPerRequest());
        list<string> texts = map sprintf("t%d", $1) + strmul(" ", 1000 - sprintf("t%d", $1).size()), xrange(0, 300);
        list<list<float>> vectors = emb.encodeBatch(texts);
        assertEq(300, vectors.size());
        list<hash<auto>> requests = handler.getRequests();
        assertEq((120, 120, 60), map $1.input.size(), requests);

        # an input larger than the request limit is sent alone, between its neighbors
        handler.setScript(());
        texts = ("t0", "t1" + strmul(" ", 130000), "t2");
        vectors = emb.encodeBatch(texts);
        assertEq(3, vectors.size());
        assertEq((1, 1, 1), map $1.input.size(), handler.getRequests());

        # a configured token counter replaces the byte estimate
        handler.setScript(());
        emb.setTokenCounter(new FixedTokenCounter(60000));
        emb.encodeBatch(inputs(5));
        assertEq((2, 2, 1), map $1.input.size(), handler.getRequests());
    }

    testAttribution() {
        handler.setScript(({}, {"status": 503}));
        VoyageEmbedder emb(config({"max_retries": 0}));
        try {
            emb.encodeBatch(inputs(1500));
            fail("expected a request failure");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("REST-RESPONSE-ERROR", ex.err);
            assertEq(503, ex.arg.status_code);
            assertEq(1000, ex.arg.input_offset);
            assertEq(500, ex.arg.input_count);
        }
        # a malformed response names its request's inputs as well
        handler.setScript(({"status": 200, "body": {"data": ()}},));
        try {
            emb.encodeBatch(inputs(2));
            fail("expected EMBEDDER-RESPONSE-ERROR");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("EMBEDDER-RESPONSE-ERROR", ex.err);
            assertEq(0, ex.arg.input_offset);
            assertEq(2, ex.arg.input_count);
        }
    }

    testPreferredBatchSize() {
        assertEq(1000, new VoyageEmbedder(config()).getPreferredBatchSize());
    }

    testEmbedderSpacing() {
        handler.setScript(());
        # two requests per 400ms window, shared by independently created embedders
        RecordingRateLimiter limiter(2, NOTHING, 400);
        VirtualTime vt(limiter);
        int t0 = vt.now_us;
        hash<EmbedderConfig> cfg = config();
        Counter done(6);
        Queue errors();
        for (int i = 0; i < 6; ++i) {
            background sub () {
                on_exit done.dec();
                try {
                    TestVoyageEmbedder emb(cfg, limiter);
                    emb.encodeQuery("t0");
                } catch (hash<ExceptionInfo> ex) {
                    errors.push(get_exception_string(ex));
                }
            }();
        }
        done.waitForZero();
        assertEq(0, errors.size(), errors.size() ? errors.get() : "");
        # every request reached the server, each after the limiter admitted it; the limiter's own admission instants
        # in virtual time show the spacing exactly
        assertEq(6, handler.getRequests().size());
        assertEq((0, 0, 400000, 400000, 800000, 800000), since(t0, limiter.getAdmissions()),
            "each later request waited for the window");
        assertEq((400, 400), vt.takeWaits());
    }

    testRetryAfter() {
        handler.setScript(({"status": 429, "headers": {"Retry-After": "1"}},));
        list<hash<RagTelemetryEvent>> events = ();
        RecordingRateLimiter limiter(NOTHING, NOTHING);
        VirtualTime vt(limiter);
        int t0 = vt.now_us;
        TestVoyageEmbedder emb(config({"telemetry_observer": <RagTelemetryObserver>{
            "event_callback": sub (hash<RagTelemetryEvent> event) { push events, event; },
        }}), limiter);
        assertOrdered(emb.encodeBatch(inputs(3)), 3);
        list<hash<auto>> requests = handler.getRequests();
        assertEq(2, requests.size());
        assertEq(requests[0].input, requests[1].input, "the same inputs are sent again");
        assertEq(1, events.size());
        assertEq(429, events[0].error.status_code);
        # Retry-After plus up to 10% jitter
        int delay_ms = events[0].attributes.retry_delay_ms;
        assertGe(1000, delay_ms);
        assertLe(1100, delay_ms);
        assertEq((delay_ms,), vt.takeWaits(), "Retry-After was honored");
        assertEq((0, delay_ms * 1000), since(t0, limiter.getAdmissions()));
    }

    testBackoff() {
        handler.setScript(({"status": 429}, {"status": 429}));
        ExactLimiter limiter(100, NOTHING);
        VirtualTime vt(limiter);
        int t0 = vt.now_us;
        TestVoyageEmbedder emb(config(), limiter);
        assertOrdered(emb.encodeBatch(inputs(1)), 1);
        assertEq(3, handler.getRequests().size());
        # without jitter: half of 1s, then half of 2s
        assertEq((500, 1000), vt.takeWaits());
        assertEq((0, 500000, 1500000), since(t0, limiter.getAdmissions()));
    }

    testExhausted() {
        handler.setScript((), {"status": 429, "headers": {"Retry-After": "0"},
            "body": {"detail": "You have exceeded your project's Requests Per Minute (RPM) rate limit"}});
        VoyageEmbedder emb(config({"rate_limit_max_retries": 2}));
        try {
            emb.encodeBatch(inputs(2));
            fail("expected EMBEDDER-RATE-LIMIT-ERROR");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("EMBEDDER-RATE-LIMIT-ERROR", ex.err);
            assertEq("provider_rate_limited", ex.arg.reason_code);
            assertEq(429, ex.arg.status_code);
            assertEq(3, ex.arg.attempts);
            assertEq(0, ex.arg.input_offset);
            assertEq(2, ex.arg.input_count);
            assertEq("voyage-4-lite", ex.arg.model);
            assertRegex("Requests Per Minute", ex.arg.body.detail);
        }
        assertEq(3, handler.getRequests().size(), "the initial attempt and two retries");
        handler.setScript(());
    }

    testBudget() {
        handler.setScript(({"status": 429, "headers": {"Retry-After": "60"}},));
        RecordingRateLimiter limiter(NOTHING, NOTHING);
        VirtualTime vt(limiter);
        int t0 = vt.now_us;
        TestVoyageEmbedder emb(config({"rate_limit_timeout": 2s}), limiter);
        *hash<ExceptionInfo> err;
        try {
            emb.encodeBatch(inputs(1));
        } catch (hash<ExceptionInfo> ex) {
            err = ex;
        }
        assertEq((), vt.takeWaits(), "a delay beyond the budget is not waited");
        assertEq(t0, vt.now_us);
        assertEq(1, handler.getRequests().size());
        assertEq("EMBEDDER-RATE-LIMIT-ERROR", err.err);
        assertEq("provider_rate_limited", err.arg.reason_code);
        assertEq(1, err.arg.attempts);
        assertEq(60000, err.arg.retry_after_ms);

        # a positive per-call timeout further limits the budget
        handler.setScript(({"status": 429, "headers": {"Retry-After": "3"}},));
        RecordingRateLimiter timed(NOTHING, NOTHING);
        VirtualTime tvt(timed);
        emb = new TestVoyageEmbedder(config(), timed);
        remove err;
        try {
            emb.encodeBatch(inputs(1), {"timeout": 1s});
        } catch (hash<ExceptionInfo> ex) {
            err = ex;
        }
        assertEq((), tvt.takeWaits(), "a delay beyond the per-call timeout is not waited");
        assertEq(1, handler.getRequests().size());
        assertEq("EMBEDDER-RATE-LIMIT-ERROR", err.err);
        assertEq("provider_rate_limited", err.arg.reason_code);
        assertEq(3000, err.arg.retry_after_ms);
    }

    testCancelBackoff() {
        handler.setScript(({"status": 429, "headers": {"Retry-After": "30"}},));
        ExactLimiter limiter(NOTHING, NOTHING);
        # a blocking virtual clock: the wait ends only when the waiter is woken or cancelled
        VirtualTime vt(limiter, True);
        # a failed check must not leave the waiting thread blocked
        on_exit vt.release(limiter);
        int t0 = vt.now_us;
        TestVoyageEmbedder emb(config(), limiter);
        background sub () {
            try {
                emb.encodeBatch(inputs(1));
                vt.events.push({"outcome": "completed"});
            } catch (hash<ExceptionInfo> ex) {
                clear_thread_cancel();
                vt.events.push({"outcome": ex.err});
            }
        }();
        hash<auto> wait = vt.events.get();
        assertEq(30000, wait.wait, "the rejected request waits for Retry-After");
        assertEq(1, handler.getRequests().size(), "the first request reached the server");
        cancel_thread(wait.tid);
        assertEq("THREAD-CANCELLED", vt.events.get().outcome, "cancellation ended the 30s wait");
        assertEq(t0, vt.now_us);
        assertEq(0, vt.events.size(), "the cancelled request did not wait again");
        assertEq(1, handler.getRequests().size());
    }

    testLimits() {
        assertEq({"requests_per_minute": 1900, "tokens_per_minute": 15200000},
            new VoyageEmbedder(config()).getRateLimits());
        assertEq({"requests_per_minute": 1900, "tokens_per_minute": 7600000},
            new VoyageEmbedder(config({"model": "voyage-4"})).getRateLimits());
        assertEq({"requests_per_minute": 1900, "tokens_per_minute": 2850000},
            new VoyageEmbedder(config({"model": "voyage-unknown"})).getRateLimits());
        assertEq({"requests_per_minute": 500, "tokens_per_minute": 1000},
            new VoyageEmbedder(config({"requests_per_minute": 500, "tokens_per_minute": 1000}))
                .getRateLimits());
        assertEq(320000, new VoyageEmbedder(config({"model": "voyage-4"})).getMaxTokensPerRequest());
        assertEq(1000000, new VoyageEmbedder(config()).getMaxTokensPerRequest());
        assertEq(120000, new VoyageEmbedder(config({"model": "voyage-unknown"})).getMaxTokensPerRequest());

        # the configured limit paces real requests: one per window
        handler.setScript(());
        hash<EmbedderConfig> cfg = config({"requests_per_minute": 1});
        VirtualTime vt = sharedVirtualTime(cfg.api_key, cfg.model, 1);
        VoyageEmbedder emb(cfg);
        emb.encodeBatch(inputs(1));
        assertThrows("EMBEDDER-RATE-LIMIT-ERROR", \emb.encodeBatch(), (inputs(1), {"rate_limit_timeout": 100ms}));
        assertThrows("EMBEDDER-RATE-LIMIT-ERROR", sub () {
            new VoyageEmbedder(cfg).encodeBatch(inputs(1), {"rate_limit_timeout": 100ms});
        }, NOTHING, "another embedder with the same key shares the limit");
        assertEq((), vt.takeWaits(), "a full window that cannot free up before the deadline is not waited for");
        assertEq(1, handler.getRequests().size());
    }

    testTransientRetry() {
        handler.setScript(({"status": 503},));
        VoyageEmbedder emb(config());
        assertOrdered(emb.encodeBatch(inputs(2)), 2);
        assertEq(2, handler.getRequests().size());
    }

    testSharedDimension() {
        handler.setScript(());
        hash<EmbedderConfig> cfg = config({"model": "voyage-3.5"});
        assertEq(2, new VoyageEmbedder(cfg).getDimension());
        assertEq(1, handler.getRequests().size());
        assertEq(2, new VoyageEmbedder(cfg).getDimension(), "a new embedder reuses the learned dimension");
        assertEq(1, handler.getRequests().size());
        assertFalse(exists handler.getRequests()[0].body.output_dimension,
            "an unconfigured dimension is not sent");
    }

    testConnectionOptions() {
        hash<ConnectionSchemeInfo> info = ConnectionSchemeCache::getScheme("voyage");
        assertEq("int", info.options."requests-per-minute".type);
        assertEq("int", info.options."tokens-per-minute".type);
        hash<auto> opts = VoyageRestClient::VoyageRestClientBase::getOptions({
            "apikey": "k",
            "requests-per-minute": 100,
            "tokens-per-minute": 1000,
        });
        assertFalse(exists opts."requests-per-minute");
        assertFalse(exists opts."tokens-per-minute");
        VoyageRestClient::VoyageRestConnection conn("voyage", "test", "voyage://api.voyageai.com", {}, {
            "apikey": "k",
            "requests-per-minute": 100,
            "tokens-per-minute": 1000,
        });
        assertEq(100, conn.getRealOptions()."requests-per-minute");
    }

    #! A Voyage connection to the fake server
    private VoyageRestClient::VoyageRestConnection connection(string key, *hash<auto> extra) {
        return new VoyageRestClient::VoyageRestConnection("voyage-ping", "test", "http://localhost:" + port, {},
            {"apikey": key} + (extra ?? {}));
    }

    testCallObserver() {
        ExactLimiter limiter(1, NOTHING, 1500);
        VirtualTime vt(limiter);
        list<hash<RateLimitEventInfo>> events = ();
        code observer = sub (hash<RateLimitEventInfo> event) { push events, event; };
        int calls = 0;
        hash<auto> rv = limiter.call(<RateLimitedCallInfo>{"tokens": 1,
                "deadline_us": limiter.getClockUs() + 10000000, "observer": observer},
            hash<auto> sub () {
                if (!calls++) {
                    throw "REST-RESPONSE-ERROR", "too many", {"status_code": 429, "headers": {"retry-after": "0"}};
                }
                return {"ok": True};
            });
        assertTrue(rv.ok);
        # the retry is admitted only when the one-request window has room again: a long wait
        assertEq(("retry", "wait"), map $1.type, events);
        assertEq(429, events[0].status_code);
        assertEq(0, events[0].retry_after_ms);
        assertEq(1500, events[1].delay_ms, "the retry waited for the window");
        assertEq(1, events[1].attempt);
        assertEq((1500,), vt.takeWaits());

        # other failures propagate unchanged and are not retried
        calls = 0;
        assertThrows("REST-RESPONSE-ERROR", sub () {
            limiter.call(<RateLimitedCallInfo>{"deadline_us": limiter.getClockUs() + 10000000},
                auto sub () { ++calls; throw "REST-RESPONSE-ERROR", "bad", {"status_code": 400}; });
        });
        assertEq(1, calls);
    }

    testPacksAndWaitTelemetry() {
        handler.setScript(());
        assertTrue(new VoyageEmbedder(config()).packsRequests());
        list<hash<RagTelemetryEvent>> events = ();
        hash<EmbedderConfig> cfg = config({"telemetry_observer": <RagTelemetryObserver>{
            "event_callback": sub (hash<RagTelemetryEvent> event) { push events, event; },
        }});
        ExactLimiter limiter(1, NOTHING, 1200);
        VirtualTime vt(limiter);
        TestVoyageEmbedder emb(cfg, limiter);
        emb.encodeBatch(inputs(1));
        emb.encodeBatch(inputs(1));
        assertEq(1, events.size(), "the second request waited more than a second for the window");
        assertEq("wait", events[0].type);
        assertTrue(events[0].attributes.rate_limited);
        assertEq(1200, events[0].attributes.rate_limit_wait_ms);
        assertEq((1200,), vt.takeWaits());
    }

    private hash<RerankerConfig> rerankConfig(*hash<auto> extra) {
        return cast<hash<RerankerConfig>>(<RerankerConfig>{
            "backend": "voyage",
            "url": "http://localhost:" + port,
            "model": "rerank-2.5-lite",
            "api_key": sprintf("rerank-key-%d-%d", getpid(), ++key_seq),
        } + (extra ?? {}));
    }

    testReranker() {
        hash<RerankerConfig> cfg = rerankConfig({"requests_per_minute": 1});
        VirtualTime rvt = sharedVirtualTime(cfg.api_key, cfg.model, 1,
            VoyageRestClient::VoyageRestClientBase::RateLimitRerank);
        VoyageReranker rr(cfg);
        assertEq({"requests_per_minute": 1, "tokens_per_minute": 3800000}, rr.getRateLimits());
        assertEq({"requests_per_minute": 1900, "tokens_per_minute": 1900000},
            new VoyageReranker(rerankConfig({"model": "rerank-2.5"})).getRateLimits());
        handler.setScript(());
        assertEq(2, rr.rerank("q", ("a", "b"), 2).size());
        # the reranker's bucket is full; another reranker of the same account and model shares it
        assertThrows("RERANKER-RATE-LIMIT-ERROR", sub () {
            new VoyageReranker(cfg).rerank("q", ("a",), 1, {"rate_limit_timeout": 100ms});
        });
        assertEq((), rvt.takeWaits(), "the full bucket is not waited for");
        # embeddings of the same account are limited separately
        VoyageEmbedder emb(config({"api_key": cfg.api_key, "requests_per_minute": 1}));
        emb.encodeBatch(inputs(1));
        assertEq(("/v1/rerank", "/v1/embeddings"), map $1.path, handler.getRequests());

        # a 429 with Retry-After is retried after the stated delay and reported to the observer
        handler.setScript(({"status": 429, "headers": {"Retry-After": "1"}},));
        list<hash<RagTelemetryEvent>> events = ();
        RecordingRateLimiter limiter(NOTHING, NOTHING);
        VirtualTime vt(limiter);
        int t0 = vt.now_us;
        TestVoyageReranker retried(rerankConfig({"telemetry_observer": <RagTelemetryObserver>{
            "event_callback": sub (hash<RagTelemetryEvent> event) { push events, event; },
        }}), limiter);
        hash<RerankOutcome> outcome = retried.rerankEx("q", ("a", "b", "c"), 3);
        assertEq(3, outcome.results.size());
        assertEq(11, outcome.usage.total_tokens);
        assertEq(2, handler.getRequests().size());
        assertEq(1, events.size());
        assertEq("rerank", events[0].operation);
        assertEq(429, events[0].error.status_code);
        assertTrue(events[0].attributes.rate_limited);
        # Retry-After plus up to 10% jitter
        int delay_ms = events[0].attributes.retry_delay_ms;
        assertGe(1000, delay_ms);
        assertLe(1100, delay_ms);
        assertEq((delay_ms,), vt.takeWaits(), "Retry-After was honored");
        assertEq((0, delay_ms * 1000), since(t0, limiter.getAdmissions()));
    }

    testRerankerExhausted() {
        handler.setScript((), {"status": 429, "headers": {"Retry-After": "0"}});
        VoyageReranker rr(rerankConfig({"rate_limit_max_retries": 1}));
        try {
            rr.rerank("q", ("a",), 1);
            fail("expected RERANKER-RATE-LIMIT-ERROR");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("RERANKER-RATE-LIMIT-ERROR", ex.err);
            assertEq("provider_rate_limited", ex.arg.reason_code);
            assertEq(2, ex.arg.attempts);
            assertEq("rerank-2.5-lite", ex.arg.model);
        }
        assertEq(2, handler.getRequests().size());
        handler.setScript(());
    }

    private AbstractDataProvider dataProvider(string key, string child) {
        VoyageRestClient::VoyageRestClientIo rest({"url": "http://localhost:" + port, "apikey": key});
        return new VoyageDataProvider::VoyageDataProvider(rest).getChildProvider(child);
    }

    testDataProvider() {
        string key = sprintf("dp-key-%d-%d", getpid(), ++key_seq);
        VirtualTime vt = sharedVirtualTime(key, "voyage-4-lite");
        int t0 = vt.now_us;
        # the data provider and an embedder of the same account and model share one limiter: a Retry-After
        # the embedder received holds the data provider too
        handler.setScript(({"status": 429, "headers": {"Retry-After": "120"}},));
        VoyageEmbedder emb(config({"api_key": key}));
        assertThrows("EMBEDDER-RATE-LIMIT-ERROR", \emb.encodeBatch(), (inputs(1),));
        handler.setScript(());
        try {
            dataProvider(key, "create-embeddings").doRequest({"model": "voyage-4-lite", "input": ("t0",)});
            fail("expected the shared window to be full");
        } catch (hash<ExceptionInfo> ex) {
            # nothing is in flight, so the data provider fails at once rather than waiting a minute
            assertEq("EMBEDDER-RATE-LIMIT-ERROR", ex.err);
            assertEq("rate_limit_wait_deadline", ex.arg.reason_code);
        }
        assertEq((), vt.takeWaits(), "neither the embedder nor the data provider waited");
        assertEq(t0, vt.now_us);
        assertEq(0, handler.getRequests().size());

        # a 429 is retried after Retry-After, through the limiter
        string other = sprintf("dp-key-%d-%d", getpid(), ++key_seq);
        VirtualTime ovt = sharedVirtualTime(other, "voyage-4-lite");
        handler.setScript(({"status": 429, "headers": {"Retry-After": "1"}},));
        hash<auto> resp = dataProvider(other, "create-embeddings").doRequest({"model": "voyage-4-lite",
            "input": ("t0", "t1")});
        assertEq(2, resp.data.size());
        assertEq(2, handler.getRequests().size());
        # Retry-After plus up to 10% jitter
        list<int> waits = ovt.takeWaits();
        assertEq(1, waits.size(), "the retry waited once");
        assertGe(1000, waits[0], "Retry-After was honored");
        assertLe(1100, waits[0]);

        # transient failures are retried by the shared transient policy
        handler.setScript(({"status": 503},));
        resp = dataProvider(other, "create-embeddings").doRequest({"model": "voyage-4-lite", "input": ("t0",)});
        assertEq(1, resp.data.size());
        assertEq(2, handler.getRequests().size());
    }

    testDataProviderExhausted() {
        handler.setScript((), {"status": 429, "headers": {"Retry-After": "60"}});
        string key = sprintf("dp-key-%d-%d", getpid(), ++key_seq);
        VirtualTime vt = sharedVirtualTime(key, "rerank-2.5-lite", NOTHING,
            VoyageRestClient::VoyageRestClientBase::RateLimitRerank);
        try {
            dataProvider(key, "rerank").doRequest({"model": "rerank-2.5-lite", "query": "q",
                "documents": ("a", "b")});
            fail("expected RERANKER-RATE-LIMIT-ERROR");
        } catch (hash<ExceptionInfo> ex) {
            # Retry-After 60s does not fit the request's 60s budget after the first attempt
            assertEq("RERANKER-RATE-LIMIT-ERROR", ex.err);
            assertEq("provider_rate_limited", ex.arg.reason_code);
            assertEq(1, ex.arg.attempts);
        }
        assertEq((), vt.takeWaits(), "a delay beyond the budget is not waited");
        assertEq(1, handler.getRequests().size());
        handler.setScript(());
    }

    testPing() {
        handler.setScript(());
        string key = sprintf("ping-key-%d-%d", getpid(), ++key_seq);
        VirtualTime vt = sharedVirtualTime(key, VoyageRestClient::VoyageRestClientBase::DefaultEmbeddingModel, 1);
        int t0 = vt.now_us;
        VoyageRestClient::VoyageRestConnection conn = connection(key, {"requests-per-minute": 1});
        hash<PingInfo> ok = conn.ping();
        assertTrue(ok.ok, ok.info);
        assertEq("/v1/embeddings", handler.getRequests()[0].path);
        # the ping used the account's only request this minute: an embedder of the same account waits
        VoyageEmbedder same_account(config({"api_key": key}));
        assertThrows("EMBEDDER-RATE-LIMIT-ERROR", \same_account.encodeBatch(),
            (inputs(1), {"rate_limit_timeout": 100ms}));
        # and the next ping fails promptly as rate limited instead of blocking the monitor
        hash<PingInfo> limited = conn.ping();
        assertFalse(limited.ok);
        assertRegex("VOYAGE-RATE-LIMITED", limited.info);
        assertEq((), vt.takeWaits(), "the rate-limited ping did not wait");
        # the polling monitor's ping never waits
        assertThrows("VOYAGE-RATE-LIMITED", sub () { conn.startPollConnect(); });
        assertEq((), vt.takeWaits(), "the polling ping did not wait");
        assertEq(t0, vt.now_us);
        assertEq(1, handler.getRequests().size(), "no rate-limited ping reached the server");

        # a ping that is not an embeddings request is not limited
        VoyageRestClient::VoyageRestConnection plain = connection(key, {"requests-per-minute": 1,
            "ping_path": "models", "ping_method": "GET"});
        hash<PingInfo> plain_info = plain.ping();
        assertTrue(plain_info.ok, plain_info.info);
        assertEq(2, handler.getRequests().size());
    }

    testPing429() {
        handler.setScript(({"status": 429, "headers": {"Retry-After": "30"}},));
        string key = sprintf("ping-key-%d-%d", getpid(), ++key_seq);
        VirtualTime vt = sharedVirtualTime(key, VoyageRestClient::VoyageRestClientBase::DefaultEmbeddingModel);
        int t0 = vt.now_us;
        VoyageRestClient::VoyageRestConnection conn = connection(key);
        hash<PingInfo> info = conn.ping();
        assertFalse(info.ok);
        assertRegex("VOYAGE-RATE-LIMITED", info.info);
        assertEq((), vt.takeWaits(), "the ping is not retried");
        assertEq(1, handler.getRequests().size());
        # the 429 blocks every client of the account: an embedder fails at once instead of sending
        handler.setScript(());
        VoyageEmbedder same_account(config({"api_key": key}));
        try {
            same_account.encodeBatch(inputs(1), {"rate_limit_timeout": 1s});
            fail("expected EMBEDDER-RATE-LIMIT-ERROR");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("EMBEDDER-RATE-LIMIT-ERROR", ex.err);
            assertEq("rate_limit_wait_deadline", ex.arg.reason_code);
            # the block is Retry-After plus up to 10% jitter
            assertGe(30000, ex.arg.wait_ms);
            assertLe(33000, ex.arg.wait_ms);
        }
        assertEq((), vt.takeWaits(), "the blocked embedder did not wait");
        assertEq(t0, vt.now_us);
        assertEq(0, handler.getRequests().size());
    }

    testStalledAttempt() {
        # retry_timeout 9s: a query attempt is limited to 3s, so the stalled first attempt leaves time for two
        # more
        handler.setScript(({"stall": 20s},));
        on_exit {
            handler.release.send(True);
            handler.setScript(());
        }
        VoyageEmbedder emb(config({"retry_timeout": 9s}));
        int t0 = clock_get_monotonic_us();
        assertOrdered(emb.encodeBatch(inputs(1)), 1);
        # a socket timeout never ends early, so this lower bound holds however loaded the machine is
        assertGe(3000, (clock_get_monotonic_us() - t0) / 1000, "the first attempt was given its limit");
        # the retry policy retries only within its budget, so a second request shows that the stalled attempt was
        # limited to less than the budget (testAttemptDefaults() checks the limit itself)
        assertEq(2, handler.getRequests().size(), "the stalled attempt was retried before the budget expired");

        # an explicit attempt limit equal to the budget leaves no time to retry a stall
        handler.setScript(({"stall": 20s},));
        VoyageEmbedder whole(config({"retry_timeout": 2s, "attempt_timeout": 2s}));
        assertThrows("HTTPCLIENT-TIMEOUT", \whole.encodeBatch(), (inputs(1),));
        assertEq(1, handler.getRequests().size());
    }

    testAttemptDefaults() {
        assertEq(10000, AbstractEmbedder::defaultAttemptTimeoutMs(60000, 1));
        assertEq(3000, AbstractEmbedder::defaultAttemptTimeoutMs(9000, 32));
        assertEq(15000, AbstractEmbedder::defaultAttemptTimeoutMs(30000, 33), "a large batch gets half");
        assertEq(3000, AbstractEmbedder::defaultAttemptTimeoutMs(3000, 1), "a short budget is not split");
        assertEq(200, AbstractEmbedder::defaultAttemptTimeoutMs(200, 1));
        RestClientIo::RestRetryPolicy p(<RestClientIo::RestRetryOptions>{"retry_timeout": 5s, "attempt_timeout": 1s});
        list<int> given = ();
        try {
            p.execute(hash<auto> sub (int ms) {
                given += ms;
                throw "HTTPCLIENT-TIMEOUT", "stalled";
            });
        } catch (hash<ExceptionInfo> ex) {
            assertEq("HTTPCLIENT-TIMEOUT", ex.err);
        }
        assertGt(1, given.size(), "a timed-out attempt is retried");
        assertEq(1000, given[0], "each attempt gets the attempt limit, not the remaining budget");
        assertThrows("REST-RETRY-OPTION-ERROR", sub () {
            new RestClientIo::RestRetryPolicy(<RestClientIo::RestRetryOptions>{"attempt_timeout": -1});
        });
    }

    testSharedConnection() {
        handler.setScript(());
        hash<EmbedderConfig> cfg = config();
        for (int i = 0; i < 5; ++i) {
            # a new embedder per query, as Qorus creates
            new VoyageEmbedder(cfg).encodeQuery("t" + i);
        }
        # the reranker of the same account shares the client as well
        new VoyageReranker(<RerankerConfig>{"url": cfg.url, "api_key": cfg.api_key}).rerank("q", ("a",), 1);
        list<hash<auto>> requests = handler.getRequests();
        assertEq(6, requests.size());
        assertEq(1, (map {$1.cid: True}, requests).size(), "one connection for every embedder and the reranker");
    }

    testReplacedConnection() {
        handler.setScript(({"close": True},));
        hash<EmbedderConfig> cfg = config();
        new VoyageEmbedder(cfg).encodeQuery("t0");
        new VoyageEmbedder(cfg).encodeQuery("t1");
        new VoyageEmbedder(cfg).encodeQuery("t2");
        list<hash<auto>> requests = handler.getRequests();
        assertEq(3, requests.size());
        assertEq(2, (map {$1.cid: True}, requests).size(), "the closed connection was replaced once");
    }

    testSharedClientKeys() {
        int before = VoyageRestClient::VoyageRestClientBase::getSharedClientCount();
        hash<EmbedderConfig> cfg = config();
        VoyageRestClient::VoyageRestClientIo a = VoyageRestClient::VoyageRestClientBase::getSharedClient(cfg.url,
            cfg.api_key);
        assertTrue(a == VoyageRestClient::VoyageRestClientBase::getSharedClient(cfg.url, cfg.api_key));
        assertFalse(a == VoyageRestClient::VoyageRestClientBase::getSharedClient(cfg.url, cfg.api_key + "-rotated"),
            "a changed API key is a different account");
        assertFalse(a == VoyageRestClient::VoyageRestClientBase::getSharedClient(cfg.url, cfg.api_key, 5s),
            "a different default timeout is a different client");
        assertGe(before + 3, VoyageRestClient::VoyageRestClientBase::getSharedClientCount());
    }
}

#! Counts every input as a fixed number of tokens
class FixedTokenCounter {
    private {
        int tokens;
    }

    constructor(int tokens) {
        self.tokens = tokens;
    }

    int countTokens(string text) {
        return tokens;
    }
}
