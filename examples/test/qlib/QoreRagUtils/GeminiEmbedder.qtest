%modern
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Logger
%requires Mime
%requires HttpServerUtil
%requires HttpServerAsyncIo
%requires HttpServer
%requires RestClient
%requires RestClientIo
%requires GeminiRestClient
%requires QoreRagUtils
%requires QUnit

%try-module json
%define NoJson
%endtry

%exec-class GeminiEmbedderTest

class FakeGeminiEmbeddingHandler inherits AbstractHttpRequestHandler {
    public {
        list<hash<auto>> requests = ();
        hash<string, hash<auto>> responses;
        Mutex m();
    }

    constructor(hash<string, hash<auto>> responses) {
        self.responses = responses;
    }

    hash handleRequest(hash cx, hash hdr, *data body) {
        m.lock();
        on_exit m.unlock();
        hash<auto> parsed = body.val() ? parse_json(body) : {};
        push requests, {
            "path": cx.raw_path,
            "method": hdr.method,
            "api_key": hdr."x-goog-api-key",
            "body": parsed,
        };
        *hash<auto> resp = responses{cx.raw_path};
        if (!resp) {
            return makeResponse(404,
                "{\"error\":{\"status\":\"NOT_FOUND\",\"message\":\"Not Found\"}}",
                {"Content-Type": MimeTypeJson});
        }
        int code = resp.code ?? 200;
        string out = resp.body.typeCode() == NT_STRING
            ? resp.body : make_json(resp.body);
        return makeResponse(code, out, {"Content-Type": MimeTypeJson});
    }
}

class GeminiEmbedderTest inherits QUnit::Test {
    private {
        HttpServer http;
        int port;
        FakeGeminiEmbeddingHandler handler;
    }

    constructor() : Test("GeminiEmbedderTest", "1.0") {
        addTestCase("batchEmbedContents request and response",
            \testBatchEmbedContents());
        addTestCase("dimension and taskType forwarded",
            \testDimensionAndTaskTypeForwarded());
        addTestCase("permanent model error classified",
            \testPermanentModelErrorClassified());
        addTestCase("vector count mismatch throws",
            \testVectorCountMismatch());
        set_return_value(main());
    }

    globalSetUp() {
        Logger logger("test", LoggerLevel::getLevelWarn());
        hash<HttpServerOptionInfo> http_opts = <HttpServerOptionInfo>{
            "logger": logger,
            "debug": False,
        };
        http = new HttpServer(http_opts);
        port = http.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
    }

    globalTearDown() {
        delete http;
    }

    private checkModule() {
%ifdef NoJson
        testSkip("no json module");
%endif
    }

    private installHandler(hash<string, hash<auto>> responses) {
        if (handler) {
            http.removeHandler("gemini");
        }
        handler = new FakeGeminiEmbeddingHandler(responses);
        http.setHandler("gemini", "/", MimeTypeJson, handler);
    }

    private GeminiEmbedder makeEmbedder(*hash<auto> extra) {
        hash<EmbedderConfig> cfg = <EmbedderConfig>{
            "backend": "gemini",
            "url": "http://localhost:" + port,
            "api_key": "secret-key",
        };
        if (extra) {
            cfg += extra;
        }
        return new GeminiEmbedder(cfg);
    }

    testBatchEmbedContents() {
        checkModule();
        installHandler({
            "/v1beta/models/gemini-embedding-001:batchEmbedContents": {
                "code": 200,
                "body": {
                    "embeddings": (
                        {"values": (1.0, 2.0, 3.0)},
                        {"values": (4.0, 5.0, 6.0)},
                    ),
                },
            },
        });
        GeminiEmbedder emb = makeEmbedder();
        list<list<float>> rv = emb.encodeBatch(("hello", "world"));
        assertEq(2, rv.size());
        assertEq((1.0, 2.0, 3.0), rv[0]);
        assertEq((4.0, 5.0, 6.0), rv[1]);
        assertEq(3, emb.getDimension());
        assertEq(1, handler.requests.size());
        assertEq("POST", handler.requests[0].method);
        assertEq("secret-key", handler.requests[0].api_key);
        assertEq("models/gemini-embedding-001",
            handler.requests[0].body.requests[0].model);
        assertEq("hello",
            handler.requests[0].body.requests[0].content.parts[0].text);
    }

    testDimensionAndTaskTypeForwarded() {
        checkModule();
        installHandler({
            "/v1beta/models/gemini-embedding-001:batchEmbedContents": {
                "code": 200,
                "body": {"embeddings": ({"values": (1.0, 2.0)},)},
            },
        });
        GeminiEmbedder emb = makeEmbedder({
            "dimension": 2,
            "options": {"taskType": "SEMANTIC_SIMILARITY"},
        });
        emb.encodeBatch(("x",));
        assertEq(2, handler.requests[0].body.requests[0].outputDimensionality);
        assertEq("SEMANTIC_SIMILARITY",
            handler.requests[0].body.requests[0].taskType);
    }

    testPermanentModelErrorClassified() {
        checkModule();
        installHandler({
            "/v1beta/models/gemini-embedding-001:batchEmbedContents": {
                "code": 404,
                "body": {
                    "error": {
                        "status": "NOT_FOUND",
                        "message": "models/gemini-embedding-001 is not found",
                    },
                },
            },
        });
        GeminiEmbedder emb = makeEmbedder();
        try {
            emb.encodeBatch(("hello",));
            fail("expected EMBEDDER-MODEL-CONFIG-ERROR");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("EMBEDDER-MODEL-CONFIG-ERROR", ex.err);
            assertEq("gemini", ex.arg.backend);
            assertEq("gemini-embedding-001", ex.arg.model);
            assertEq(404, ex.arg.status_code);
            assertEq("REST-RESPONSE-ERROR", ex.arg.original_err);
        }
    }

    testVectorCountMismatch() {
        checkModule();
        installHandler({
            "/v1beta/models/gemini-embedding-001:batchEmbedContents": {
                "code": 200,
                "body": {"embeddings": ({"values": (1.0,)},)},
            },
        });
        GeminiEmbedder emb = makeEmbedder();
        try {
            emb.encodeBatch(("a", "b"));
            fail("expected EMBEDDER-RESPONSE-ERROR");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("EMBEDDER-RESPONSE-ERROR", ex.err);
            assertRegex("returned 1 embeddings for 2 input texts", ex.desc);
        }
    }
}
