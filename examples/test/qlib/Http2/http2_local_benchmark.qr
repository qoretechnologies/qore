#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%disable-warning unreferenced-variable

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/Mime.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/HttpServerUtil.qm
%requires ../../../../qlib/HttpServer.qm

%exec-class Http2LocalBenchmark

#! HTTP/2 vs HTTP/1.1 Local Performance Benchmark
/** Runs benchmarks against a local HttpServer to eliminate network variability.
    Compares:
    - Sequential request throughput
    - Connection reuse efficiency
    - Multiplexing benefits
    - Large body transfers

    @since Qore 2.2
*/
public class Http2LocalBenchmark {
    public {
        const DefaultIterations = 100;
        const DefaultConcurrent = 10;

        # HTTP/2 test certificate and key (from Http2.qtest)
