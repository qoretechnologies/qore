    private {
        int iterations;
        int concurrent;
        bool verbose = False;
        HttpServer server;
        string server_url;
    }

    constructor() {
        processArgs();
        startServer();
        on_exit stopServer();
        runBenchmarks();
    }

    private processArgs() {
        iterations = (shift ARGV ?? string(DefaultIterations)).toInt();
        concurrent = (shift ARGV ?? string(DefaultConcurrent)).toInt();
        string arg3 = shift ARGV ?? "";
        if (arg3 == "-v") {
            verbose = True;
        }
        string arg4 = shift ARGV ?? "";
        if (arg4 == "-v") {
            verbose = True;
        }

        printf("=== HTTP/2 vs HTTP/1.1 Local Benchmark ===\n\n");
        printf("Iterations: %d\n", iterations);
        printf("Concurrent: %d\n", concurrent);
        printf("\n");
    }

    private startServer() {
        Logger logger("test", LoggerLevel::getLevelInfo());

        server = new HttpServer(<HttpServerOptionInfo>{
            "logger": logger,
        });

        # Create SSL certificate and key objects
        SSLCertificate cert(CertPem);
        SSLPrivateKey key(KeyPem);

        # Add HTTPS listener (HTTP/2 is auto-negotiated via ALPN with default settings)
        hash<auto> linfo = server.addListener(<HttpListenerOptionInfo>{
            "node": "localhost",
            "service": 0,  # Auto-assign port
            "cert": cert,
            "key": key,
        });
        int port = linfo.port;
        server_url = "https://localhost:" + port;

        # Add handlers
        BenchmarkHandler benchmark_handler();
        BytesHandler bytes_handler();
        server.setHandler("benchmark", "/", MimeTypeJson, benchmark_handler);
        server.setHandler("bytes", "/bytes", MimeTypeOctetStream, bytes_handler);
        server.setDefaultHandler("benchmark", benchmark_handler);

        printf("Local server started at %s\n\n", server_url);
    }

    private stopServer() {
        server.stop();
    }

    private runBenchmarks() {
        # Test 1: Sequential requests
        benchmarkSequential();

        # Test 2: Connection reuse
        benchmarkConnectionReuse();

        # Test 3: Concurrent requests (single HTTP/2 connection)
        benchmarkConcurrent();

        # Test 4: Large body
        benchmarkLargeBody();

        # Test 5: Multi-connection throughput (handler thread contention)
        benchmarkMultiConnectionThroughput();

        printf("=== Benchmark Complete ===\n");
    }

    private benchmarkSequential() {
        printf("Test 1: Sequential Requests (First Request + Subsequent)\n");
        printf("  Making %d sequential requests...\n", iterations);

        # HTTP/1.1
        try {
            HTTPClient h1({
                "url": server_url,
                "http_version": "1.1",
                "timeout": 30s,
            });
            h1.acceptAllCertificates(True);

            list<float> latencies = ();
            date total_start = now_us();
            for (int i = 0; i < iterations; ++i) {
                date start = now_us();
                h1.send("", "GET", "/", NOTHING, True);
                float lat = (now_us() - start).durationMicroseconds() / 1000.0;
                latencies += lat;
            }
            float total = (now_us() - total_start).durationMicroseconds() / 1000.0;

            printf("  HTTP/1.1:\n");
            printLatencyStats(latencies);
            printf("    Total: %.1f ms (%.0f req/s)\n", total, iterations * 1000.0 / total);
        } catch (hash<ExceptionInfo> ex) {
            printf("  HTTP/1.1: FAILED (%s: %s)\n", ex.err, ex.desc);
        }

        # HTTP/2
        try {
            HTTPClient h2({
                "url": server_url,
                "http_version": "2.0",
                "timeout": 30s,
            });
            h2.acceptAllCertificates(True);

            list<float> latencies = ();
            date total_start = now_us();
            for (int i = 0; i < iterations; ++i) {
                date start = now_us();
                h2.send("", "GET", "/", NOTHING, True);
                float lat = (now_us() - start).durationMicroseconds() / 1000.0;
                latencies += lat;
            }
            float total = (now_us() - total_start).durationMicroseconds() / 1000.0;

            printf("  HTTP/2:\n");
            printLatencyStats(latencies);
            printf("    Total: %.1f ms (%.0f req/s)\n", total, iterations * 1000.0 / total);
            printf("    HTTP/2 active: %s\n", h2.isHttp2Active() ? "yes" : "no");
        } catch (hash<ExceptionInfo> ex) {
            printf("  HTTP/2: FAILED (%s: %s)\n", ex.err, ex.desc);
        }

        printf("\n");
    }

    private benchmarkConnectionReuse() {
        printf("Test 2: Connection Establishment vs Reuse\n");

        int connect_iterations = min(iterations, 20);

        # HTTP/1.1 - New connection each time
        list<float> h1_new = ();
        for (int i = 0; i < connect_iterations; ++i) {
            try {
                date start = now_us();
                HTTPClient h1({
                    "url": server_url,
                    "http_version": "1.1",
                    "timeout": 30s,
                });
                h1.acceptAllCertificates(True);
                h1.send("", "GET", "/", NOTHING, True);
                float lat = (now_us() - start).durationMicroseconds() / 1000.0;
                h1_new += lat;
            } catch () {}
        }

        # HTTP/2 - New connection each time
        list<float> h2_new = ();
        for (int i = 0; i < connect_iterations; ++i) {
            try {
                date start = now_us();
                HTTPClient h2({
                    "url": server_url,
                    "http_version": "2.0",
                    "timeout": 30s,
                });
                h2.acceptAllCertificates(True);
                h2.send("", "GET", "/", NOTHING, True);
                float lat = (now_us() - start).durationMicroseconds() / 1000.0;
                h2_new += lat;
            } catch () {}
        }

        printf("  New connection + request (%d iterations):\n", connect_iterations);
        if (h1_new.size() > 0) {
            printf("    HTTP/1.1: Avg %.2f ms\n", listAvg(h1_new));
        }
        if (h2_new.size() > 0) {
            printf("    HTTP/2:   Avg %.2f ms\n", listAvg(h2_new));
        }

        # Reused connection
        try {
            HTTPClient h1({
                "url": server_url,
                "http_version": "1.1",
                "timeout": 30s,
            });
            h1.acceptAllCertificates(True);
            h1.send("", "GET", "/", NOTHING, True);  # Establish connection

            list<float> h1_reuse = ();
            for (int i = 0; i < connect_iterations; ++i) {
                date start = now_us();
                h1.send("", "GET", "/", NOTHING, True);
                float lat = (now_us() - start).durationMicroseconds() / 1000.0;
                h1_reuse += lat;
            }
            printf("  Reused connection (%d iterations):\n", connect_iterations);
            printf("    HTTP/1.1: Avg %.2f ms\n", listAvg(h1_reuse));
        } catch () {}

        try {
            HTTPClient h2({
                "url": server_url,
                "http_version": "2.0",
                "timeout": 30s,
            });
            h2.acceptAllCertificates(True);
            h2.send("", "GET", "/", NOTHING, True);  # Establish connection

            list<float> h2_reuse = ();
            for (int i = 0; i < connect_iterations; ++i) {
                date start = now_us();
                h2.send("", "GET", "/", NOTHING, True);
                float lat = (now_us() - start).durationMicroseconds() / 1000.0;
                h2_reuse += lat;
            }
            printf("    HTTP/2:   Avg %.2f ms\n", listAvg(h2_reuse));
        } catch () {}

        printf("\n");
    }

    private benchmarkConcurrent() {
        printf("Test 3: Concurrent Requests\n");
        printf("  Making %d concurrent requests...\n", concurrent);

        # HTTP/1.1 - multiple connections
        try {
            date start = now_us();
            Counter cnt(concurrent);
            list<float> latencies = ();
            Mutex m();

            for (int i = 0; i < concurrent; ++i) {
                background sub() {
                    on_exit cnt.dec();
                    try {
                        HTTPClient h1({
                            "url": server_url,
                            "http_version": "1.1",
                            "timeout": 30s,
                        });
                        h1.acceptAllCertificates(True);
                        date req_start = now_us();
                        h1.send("", "GET", "/", NOTHING, True);
                        float lat = (now_us() - req_start).durationMicroseconds() / 1000.0;
                        m.lock();
                        on_exit m.unlock();
                        latencies += lat;
                    } catch () {}
                }();
            }
            cnt.waitForZero();
            float total = (now_us() - start).durationMicroseconds() / 1000.0;

            printf("  HTTP/1.1 (%d separate connections):\n", concurrent);
            printLatencyStats(latencies);
            printf("    Total: %.1f ms\n", total);
        } catch (hash<ExceptionInfo> ex) {
            printf("  HTTP/1.1: FAILED (%s: %s)\n", ex.err, ex.desc);
        }

        # HTTP/2 - single connection, multiplexed
        try {
            HTTPClient h2({
                "url": server_url,
                "http_version": "2.0",
                "timeout": 30s,
            });
            h2.acceptAllCertificates(True);
            h2.send("", "GET", "/", NOTHING, True);  # Establish connection

            date start = now_us();
            Counter cnt(concurrent);
            list<float> latencies = ();
            Mutex m();

            for (int i = 0; i < concurrent; ++i) {
                background sub() {
                    on_exit cnt.dec();
                    try {
                        date req_start = now_us();
                        h2.send("", "GET", "/", NOTHING, True);
                        float lat = (now_us() - req_start).durationMicroseconds() / 1000.0;
                        m.lock();
                        on_exit m.unlock();
                        latencies += lat;
                    } catch () {}
                }();
            }
            cnt.waitForZero();
            float total = (now_us() - start).durationMicroseconds() / 1000.0;

            printf("  HTTP/2 (single connection, multiplexed):\n");
            printLatencyStats(latencies);
            printf("    Total: %.1f ms\n", total);
            printf("    HTTP/2 active: %s\n", h2.isHttp2Active() ? "yes" : "no");
        } catch (hash<ExceptionInfo> ex) {
            printf("  HTTP/2: FAILED (%s: %s)\n", ex.err, ex.desc);
        }

        printf("\n");
    }

    private benchmarkLargeBody() {
        printf("Test 4: Large Body Transfer\n");

        int body_size = 1024 * 1024;  # 1 MB
        int download_iterations = min(iterations, 10);
        printf("  Requesting %d KB of data (%d times)...\n", body_size / 1024, download_iterations);

        # HTTP/1.1
        try {
            HTTPClient h1({
                "url": server_url,
                "http_version": "1.1",
                "timeout": 60s,
            });
            h1.acceptAllCertificates(True);

            list<float> latencies = ();
            for (int i = 0; i < download_iterations; ++i) {
                date start = now_us();
                hash<auto> resp = h1.send("", "GET", "/bytes/" + body_size, NOTHING, True);
                float lat = (now_us() - start).durationMicroseconds() / 1000.0;
                latencies += lat;
            }

            printf("  HTTP/1.1:\n");
            printLatencyStats(latencies);
            float avg = listAvg(latencies);
            printf("    Throughput: %.1f MB/s\n", (body_size / 1048576.0) / (avg / 1000.0));
        } catch (hash<ExceptionInfo> ex) {
            printf("  HTTP/1.1: FAILED (%s: %s)\n", ex.err, ex.desc);
        }

        # HTTP/2
        try {
            HTTPClient h2({
                "url": server_url,
                "http_version": "2.0",
                "timeout": 60s,
            });
            h2.acceptAllCertificates(True);

            list<float> latencies = ();
            for (int i = 0; i < download_iterations; ++i) {
                date start = now_us();
                hash<auto> resp = h2.send("", "GET", "/bytes/" + body_size, NOTHING, True);
                float lat = (now_us() - start).durationMicroseconds() / 1000.0;
                latencies += lat;
            }

            printf("  HTTP/2:\n");
            printLatencyStats(latencies);
            float avg = listAvg(latencies);
            printf("    Throughput: %.1f MB/s\n", (body_size / 1048576.0) / (avg / 1000.0));
            printf("    HTTP/2 active: %s\n", h2.isHttp2Active() ? "yes" : "no");
        } catch (hash<ExceptionInfo> ex) {
            printf("  HTTP/2: FAILED (%s: %s)\n", ex.err, ex.desc);
        }

        printf("\n");
    }

    private benchmarkMultiConnectionThroughput() {
        printf("Test 5: Multi-Connection Throughput (handler thread contention)\n");
        int num_connections = concurrent;
        int reqs_per_conn = min(iterations, 50);
        printf("  %d connections x %d requests each = %d total requests\n",
            num_connections, reqs_per_conn, num_connections * reqs_per_conn);

        # HTTP/1.1 - multiple connections, each making sequential requests
        try {
            date start = now_us();
            Counter cnt(num_connections);
            int success_count = 0;
            Mutex m();

            for (int i = 0; i < num_connections; ++i) {
                background sub() {
                    on_exit cnt.dec();
                    try {
                        HTTPClient h1({
                            "url": server_url,
                            "http_version": "1.1",
                            "timeout": 30s,
                        });
                        h1.acceptAllCertificates(True);
                        for (int j = 0; j < reqs_per_conn; ++j) {
                            h1.send("", "GET", "/", NOTHING, True);
                            m.lock();
                            on_exit m.unlock();
                            ++success_count;
                        }
                    } catch () {}
                }();
            }
            cnt.waitForZero();
            float total = (now_us() - start).durationMicroseconds() / 1000.0;
            float rps = success_count * 1000.0 / total;

            printf("  HTTP/1.1 (%d connections):\n", num_connections);
            printf("    Total: %.1f ms, %d requests, %.0f req/s\n", total, success_count, rps);
        } catch (hash<ExceptionInfo> ex) {
            printf("  HTTP/1.1: FAILED (%s: %s)\n", ex.err, ex.desc);
        }

        # HTTP/2 - multiple separate connections, each making sequential requests
        # This is the scenario where async send frees handler threads to serve other connections
        try {
            date start = now_us();
            Counter cnt(num_connections);
            int success_count = 0;
            Mutex m();

            for (int i = 0; i < num_connections; ++i) {
                background sub() {
                    on_exit cnt.dec();
                    try {
                        HTTPClient h2({
                            "url": server_url,
                            "http_version": "2.0",
                            "timeout": 30s,
                        });
                        h2.acceptAllCertificates(True);
                        for (int j = 0; j < reqs_per_conn; ++j) {
                            h2.send("", "GET", "/", NOTHING, True);
                            m.lock();
                            on_exit m.unlock();
                            ++success_count;
                        }
                    } catch () {}
                }();
            }
            cnt.waitForZero();
            float total = (now_us() - start).durationMicroseconds() / 1000.0;
            float rps = success_count * 1000.0 / total;

            printf("  HTTP/2 (%d separate connections):\n", num_connections);
            printf("    Total: %.1f ms, %d requests, %.0f req/s\n", total, success_count, rps);
        } catch (hash<ExceptionInfo> ex) {
            printf("  HTTP/2: FAILED (%s: %s)\n", ex.err, ex.desc);
        }

        printf("\n");
    }

    private printLatencyStats(list<float> latencies) {
        if (latencies.size() == 0) {
            printf("    No data\n");
            return;
        }

        float sum = 0;
        float min_lat = latencies[0];
        float max_lat = latencies[0];
        foreach float lat in (latencies) {
            sum += lat;
            if (lat < min_lat) min_lat = lat;
            if (lat > max_lat) max_lat = lat;
        }
        float avg = sum / latencies.size();

        list<float> sorted = sort(latencies);
        int p99_idx = max(0, (sorted.size() * 99 / 100) - 1);
        float p99 = sorted[p99_idx];

        printf("    Avg: %.2f ms, Min: %.2f ms, Max: %.2f ms, P99: %.2f ms\n",
            avg, min_lat, max_lat, p99);
    }

    private float listAvg(list<float> values) {
        if (values.size() == 0) return 0.0;
        float sum = 0;
        foreach float v in (values) {
            sum += v;
        }
        return sum / values.size();
    }
}

#! Simple handler that returns a JSON response
class BenchmarkHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, "{\"status\":\"ok\"}", MimeTypeJson);
    }
}

#! Handler that returns a specified number of random bytes
class BytesHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        # Get size from path: /bytes/1234
        *string size_str = (cx.url.path =~ x/\/bytes\/(\d+)/)[0];
        int size = size_str ? size_str.toInt() : 1024;

        # Generate binary data
        binary data = binary();
        int chunk_size = 64 * 1024;  # Generate in 64KB chunks for efficiency
        while (data.size() < size) {
            int remaining = size - data.size();
            int to_gen = min(remaining, chunk_size);
            # Use a simple pattern instead of truly random data
            string chunk = strmul("X", to_gen);
            data += binary(chunk);
        }

        return makeResponse(200, data, {"Content-Type": MimeTypeOctetStream});
    }
}
