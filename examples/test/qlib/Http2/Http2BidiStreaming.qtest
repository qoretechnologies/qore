    constructor() : Test("Http2BidiStreamingTest", "1.0") {
        # Phase 3.2: Basic bidi data exchange
        addTestCase("sendHttp2Connect + bidi echo", \testBidiEcho());
        addTestCase("bidi echo large payload", \testBidiEchoLargePayload());

        # Phase 3.3: Stream close during body send
        addTestCase("stream close during body send", \testStreamCloseDuringBodySend());

        # Phase 3.4: Flow control under backpressure
        addTestCase("flow control backpressure", \testFlowControlBackpressure());

        # Phase 1.3: Throughput benchmark
        addTestCase("streaming throughput", \testStreamingThroughput());

        set_return_value(main());
    }

    globalSetUp() {
        mLogger = new Logger("h2-bidi-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            mLogger.addAppender(new StdoutAppender());
        }

        hash<HttpServerOptionInfo> opts = <HttpServerOptionInfo>{
            "logger": mLogger,
            "debug": True,
        };
        mServer = new HttpServer(opts);

        # Register handlers
        mServer.setHandler("bidi", "/bidi", NOTHING, new BidiEchoHandler());
        mServer.setHandler("early-close", "/early-close", NOTHING, new EarlyCloseHandler());
        mServer.setHandler("slow", "/slow", NOTHING, new SlowReaderHandler());

        # Add HTTPS listener (forces HTTP/2 via ALPN)
        mSslPort = mServer.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        }).port;

        if (m_options.verbose > 1) {
            printf("HTTPS test server on port %d\n", mSslPort);
        }
    }

    globalTearDown() {
        delete mServer;
    }

    private HTTPClient getClient(*hash<auto> extra_opts) {
        hash<auto> opts = {
            "url": sprintf("https://127.0.0.1:%d", mSslPort),
            "http_version": "2",
            "timeout": 30s,
        } + (extra_opts ?? {});
        HTTPClient client(opts);
        client.acceptAllCertificates(True);
        client.connect();
        @assert(client.isHttp2Active());
        return client;
    }

    #! Read all available stream data until the stream is closed or timeout
    private binary readAllStreamData(HTTPClient client, int stream_id, timeout max_wait = 10s) {
        binary result = binary();
        date deadline = now_us() + max_wait;
        while (now_us() < deadline) {
            *binary chunk = client.readHttp2StreamData(stream_id, 2000);
            if (chunk) {
                result += chunk;
            }
            # Stop as soon as the server has sent END_STREAM
            if (client.isHttp2StreamClosed(stream_id)) {
                break;
            }
        }
        return result;
    }

    # ---- Phase 3.2: Basic bidi data exchange ----

    testBidiEcho() {
        HTTPClient client = getClient();

        # CONNECT with :protocol=websocket to trigger dedicated socket path
        hash<auto> resp = client.sendHttp2Connect("/bidi", NOTHING, "bidi-stream");

        assertEq(200, resp.status_code, "CONNECT should succeed");
        int stream_id = resp.stream_id;
        assertTrue(stream_id > 0, "stream_id should be positive");

        # Send 3 small payloads
        list<binary> sent = ();
        for (int i = 0; i < 3; i++) {
            binary chunk = binary(sprintf("hello-%d", i));
            sent += chunk;
            client.sendHttp2StreamData(stream_id, chunk);
        }
        # Signal end of client data
        client.sendHttp2StreamData(stream_id, NOTHING, True);

        # Read echoed data
        binary all_received = readAllStreamData(client, stream_id);

        # Verify all sent data was echoed back
        binary all_sent = binary();
        map all_sent += $1, sent;
        assertEq(all_sent, all_received, "echoed data matches");
    }

    testBidiEchoLargePayload() {
        HTTPClient client = getClient();

        hash<auto> resp = client.sendHttp2Connect("/bidi", NOTHING, "bidi-stream");

        assertEq(200, resp.status_code);
        int stream_id = resp.stream_id;

        # Send 1MB payload in 16KB chunks (matching HTTP/2 default frame size)
        int total_size = 1024 * 1024;
        int chunk_size = 16384;
        binary all_sent = binary();

        int offset = 0;
        while (offset < total_size) {
            int this_size = chunk_size;
            if (offset + this_size > total_size) {
                this_size = total_size - offset;
            }
            binary chunk = binary(strmul("X", this_size));
            all_sent += chunk;
            client.sendHttp2StreamData(stream_id, chunk);
            offset += this_size;
        }
        client.sendHttp2StreamData(stream_id, NOTHING, True);

        # Read all echoed data
        binary all_received = readAllStreamData(client, stream_id, 30s);
        assertEq(total_size, all_received.size(), "large payload: correct size echoed");
        assertEq(all_sent, all_received, "large payload: data matches");
    }

    # ---- Phase 3.3: Stream close during body send ----

    testStreamCloseDuringBodySend() {
        HTTPClient client = getClient();

        hash<auto> resp = client.sendHttp2Connect("/early-close", NOTHING, "bidi-stream");

        assertEq(200, resp.status_code, "CONNECT should succeed");
        int stream_id = resp.stream_id;

        # Send multiple blocks — server reads first block then closes stream
        bool got_stream_end = False;
        bool send_completed = True;
        for (int i = 0; i < 100; i++) {
            try {
                binary chunk = binary(strmul("Y", 4096));
                client.sendHttp2StreamData(stream_id, chunk, False, 5000);
            } catch (hash<ExceptionInfo> ex) {
                if (inlist(ex.err, ("HTTP2-STREAM-RESET", "HTTP2-ERROR",
                        "HTTP2-FLOW-CONTROL"))) {
                    got_stream_end = True;
                    send_completed = False;
                    break;
                }
                rethrow;
            }
        }

        if (send_completed) {
            client.sendHttp2StreamData(stream_id, NOTHING, True);
        }

        # Read server response data
        binary resp_data = readAllStreamData(client, stream_id, 10s);
        assertTrue(got_stream_end || resp_data.size() > 0,
            "client should detect stream end or receive server response");
    }

    # ---- Phase 3.4: Flow control under backpressure ----

    testFlowControlBackpressure() {
        HTTPClient client = getClient();

        hash<auto> resp = client.sendHttp2Connect("/slow", NOTHING, "bidi-stream");

        assertEq(200, resp.status_code);
        int stream_id = resp.stream_id;

        # Send a significant amount of data that will create backpressure
        int total_sent = 0;
        int target = 256 * 1024;  # 256KB
        int chunk_size = 8192;

        while (total_sent < target) {
            int this_size = chunk_size;
            if (total_sent + this_size > target) {
                this_size = target - total_sent;
            }
            binary chunk = binary(strmul("Z", this_size));
            client.sendHttp2StreamData(stream_id, chunk, False, 30000);
            total_sent += this_size;
        }
        client.sendHttp2StreamData(stream_id, NOTHING, True);

        # Read response — server sends total bytes received
        binary resp_data = readAllStreamData(client, stream_id, 30s);
        string resp_str = resp_data.toString("utf-8");
        int total_received = int(resp_str);

        assertEq(target, total_received,
            "all data should be received despite backpressure");
    }

    # ---- Phase 1.3: Throughput benchmark ----

    testStreamingThroughput() {
        HTTPClient client = getClient();

        hash<auto> resp = client.sendHttp2Connect("/bidi", NOTHING, "bidi-stream");

        assertEq(200, resp.status_code);
        int stream_id = resp.stream_id;

        # Send 1000 small blocks, verify all data is echoed correctly
        int num_blocks = 1000;
        int block_size = 64;
        binary all_sent = binary();

        date start = now_us();
        for (int i = 0; i < num_blocks; i++) {
            binary chunk = binary(strmul(chr(65 + (i % 26)), block_size));
            all_sent += chunk;
            client.sendHttp2StreamData(stream_id, chunk);
        }
        client.sendHttp2StreamData(stream_id, NOTHING, True);

        # Read all echoed data
        binary all_received = readAllStreamData(client, stream_id, 30s);
        date elapsed = now_us() - start;

        assertEq(num_blocks * block_size, all_received.size(),
            "throughput: all data echoed");
        assertEq(all_sent, all_received, "throughput: data integrity");

        if (m_options.verbose > 0) {
            float elapsed_ms = get_duration_microseconds(elapsed) / 1000.0;
            float throughput_mbps = (num_blocks * block_size * 2.0)
                / (elapsed_ms / 1000.0) / (1024.0 * 1024.0);
            printf("  Throughput: %d blocks x %d bytes in %.1f ms "
                "(%.2f MB/s bidirectional)\n",
                num_blocks, block_size, elapsed_ms, throughput_mbps);
        }
    }
}
