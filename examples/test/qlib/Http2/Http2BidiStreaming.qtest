    HTTP/2 Bidirectional Streaming Tests — exercises the low-level HTTPClient
    bidi APIs: sendHttp2Connect, sendHttp2StreamData, readHttp2StreamData.

    Uses extended CONNECT (RFC 8441) with a generic :protocol value to trigger the
    HttpServer's dedicated socket handler path for bidirectional communication.

    Covers Phase 1.3 (throughput benchmark) and Phase 3 (bidi streaming) of
    the bidi-streaming-master-plan.
*/

%modern

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Mime.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/HttpServerUtil.qm
%requires ../../../../qlib/HttpServer.qm

%exec-class Http2BidiStreamingTest

#! Bidirectional echo handler using extended CONNECT (RFC 8441)
/** Accepts any extended CONNECT, then echoes raw data back.
    Uses AbstractHttpSocketHandler which combines request handler with
    the socket handler interface needed for dedicated connections.

    In async I/O mode, the handler reads data from a Queue (populated by the
    I/O controller) instead of doing direct socket I/O.  Sending still uses
    Socket::sendHttp2StreamData() which is thread-safe via the C++ mutex.
*/
class BidiEchoHandler inherits AbstractHttpSocketHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        # Accept any extended CONNECT protocol
        if (is_extended_connect(cx, hdr)) {
            return <HttpResponseInfo>{
                "code": 200,
                "streaming": True,
            };
        }
        return makeResponse(400, "expected extended CONNECT");
    }

    private bool startImpl(softstring lid, hash<auto> cx, hash<auto> hdr, Socket s) {
        Queue stream_data_queue = cx."header-info".stream_data_queue;
        code send = cx."header-info".send_stream_data;

        # Echo loop: read from Queue, write via send wrapper
        while (True) {
            auto chunk = stream_data_queue.get(10s);
            if (!exists chunk) {
                break;
            }
            send(chunk);
        }

        # Send END_STREAM
        send(NOTHING, True);

        return False;  # not externally managed
    }
}

#! Handler that accepts CONNECT, reads first block, then closes the stream
class EarlyCloseHandler inherits AbstractHttpSocketHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        if (is_extended_connect(cx, hdr)) {
            return <HttpResponseInfo>{
                "code": 200,
                "streaming": True,
            };
        }
        return makeResponse(400, "expected extended CONNECT");
    }

    private bool startImpl(softstring lid, hash<auto> cx, hash<auto> hdr, Socket s) {
        Queue stream_data_queue = cx."header-info".stream_data_queue;
        code send = cx."header-info".send_stream_data;

        # Read the first block only (discard)
        stream_data_queue.get(5s);

        # Send error data, then close the stream
        send(binary("ERROR: rejected"), True);

        return False;
    }
}

#! Slow reader handler — reads with delays to create backpressure
class SlowReaderHandler inherits AbstractHttpSocketHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        if (is_extended_connect(cx, hdr)) {
            return <HttpResponseInfo>{
                "code": 200,
                "streaming": True,
            };
        }
        return makeResponse(400, "expected extended CONNECT");
    }

    private bool startImpl(softstring lid, hash<auto> cx, hash<auto> hdr, Socket s) {
        Queue stream_data_queue = cx."header-info".stream_data_queue;
        code send = cx."header-info".send_stream_data;

        # Read all data slowly (simulates backpressure)
        int total_read = 0;
        while (True) {
            auto chunk = stream_data_queue.get(10s);
            if (!exists chunk) {
                # NOTHING sentinel = stream closed
                break;
            }
            total_read += chunk.size();
            usleep(1000);  # 1ms delay per chunk
        }

        # Send total bytes received as response
        send(binary(sprintf("%d", total_read)), True);

        return False;
    }
}

