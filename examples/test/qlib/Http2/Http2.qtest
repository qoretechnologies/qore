            *string err;
            if (log_path && is_file(log_path)) {
                err = ReadOnlyFile::readTextFile(log_path);
                unlink(log_path);
            } else {
                err = sprintf("node abort client failed with rc %d", rc);
            }
            return {"ok": False, "error": err};
        }

        if (log_path && is_file(log_path)) {
            unlink(log_path);
        }
        return {"ok": True};
    }

    private hash<auto> runCurlHttp2WebSocketConnect(int port, string path, string key) {
        string log_path = tmp_location() + DirSep + "http2-ws-curl-" + getpid() + ".log";
        string url = sprintf("https://localhost:%d%s", port, path);
        string cmd = sprintf("curl --http2 -k -s -D %s -o /dev/null -X CONNECT "
            + "-H ':protocol: websocket' -H 'Sec-WebSocket-Key: %s' -H 'Sec-WebSocket-Version: 13' %s",
            log_path, key, url);
        int rc = system(cmd);
        string headers = is_file(log_path) ? ReadOnlyFile::readTextFile(log_path) : "";
        if (log_path && is_file(log_path)) {
            unlink(log_path);
        }
        return {
            "rc": rc,
            "headers": headers,
        };
    }

    private hash<auto> runGoHttp2WebSocketClient(string go_bin, int port, string path) {
        string src_dir = get_script_dir() + DirSep + "go-http2-ws-client";
        if (!is_dir(src_dir)) {
            return {"ok": False, "skip": True, "error": "go client source directory missing"};
        }

        string bin_path = tmp_location() + DirSep + "go-http2-ws-client-" + getpid();
        string log_path = tmp_location() + DirSep + "go-http2-ws-client-" + getpid() + ".log";
        string build_cmd = sprintf("cd %s && %s build -o %s . > %s 2>&1",
            src_dir, go_bin, bin_path, log_path);
        int build_rc = system(build_cmd);
        if (build_rc != 0) {
            *string err = is_file(log_path) ? ReadOnlyFile::readTextFile(log_path) : "go build failed";
            if (log_path && is_file(log_path)) {
                unlink(log_path);
            }
            # Skip if dependencies cannot be resolved in this environment
            if ((new Regex(GO_HTTP2_WS_SKIP_RE)).match(err)) {
                return {"ok": False, "skip": True, "error": err};
            }
            return {"ok": False, "error": err};
        }

        string run_cmd = sprintf("%s -host localhost -port %d -path %s > %s 2>&1",
            bin_path, port, path, log_path);
        int rc = system(run_cmd);
        *string err;
        if (rc != 0 && log_path && is_file(log_path)) {
            err = ReadOnlyFile::readTextFile(log_path);
        }
        if (bin_path && is_file(bin_path)) {
            unlink(bin_path);
        }
        if (log_path && is_file(log_path)) {
            unlink(log_path);
        }
        if (rc != 0) {
            return {"ok": False, "error": err ?? sprintf("go client failed with rc %d", rc)};
        }
        return {"ok": True};
    }

    private hash<auto> runNghttp2Http2WebSocketClient(string cxx_bin, string pkg_config_bin, int port, string path) {
        string src_dir = get_script_dir() + DirSep + "nghttp2-ws-client";
        string src_path = src_dir + DirSep + "nghttp2-ws-client.cpp";
        if (!is_file(src_path)) {
            return {"ok": False, "skip": True, "error": "nghttp2 client source missing"};
        }

        string bin_path = tmp_location() + DirSep + "nghttp2-ws-client-" + getpid();
        string log_path = tmp_location() + DirSep + "nghttp2-ws-client-" + getpid() + ".log";
        string pkg_path = tmp_location() + DirSep + "nghttp2-ws-client-" + getpid() + ".pkg";
        string pkg_cmd = sprintf("%s --cflags --libs libnghttp2 > %s 2>/dev/null",
            pkg_config_bin, pkg_path);
        int pkg_rc = system(pkg_cmd);
        string pkg_flags = (pkg_rc == 0 && is_file(pkg_path)) ? trim(ReadOnlyFile::readTextFile(pkg_path)) : "";
        if (pkg_path && is_file(pkg_path)) {
            unlink(pkg_path);
        }
        if (pkg_rc != 0 || !pkg_flags) {
            return {"ok": False, "skip": True, "error": "libnghttp2 pkg-config not available"};
        }

        string build_cmd = sprintf("%s -std=c++17 -O2 -Wall -Wextra -o %s %s %s -lssl -lcrypto > %s 2>&1",
            cxx_bin, bin_path, src_path, pkg_flags, log_path);
        int build_rc = system(build_cmd);
        if (build_rc != 0) {
            *string err = is_file(log_path) ? ReadOnlyFile::readTextFile(log_path) : "compile failed";
            if (log_path && is_file(log_path)) {
                unlink(log_path);
            }
            if ((new Regex(NGHTTP2_WS_COMPILE_SKIP_RE, RE_Caseless)).match(err)) {
                return {"ok": False, "skip": True, "error": err};
            }
            return {"ok": False, "error": err};
        }

        string run_cmd = sprintf("%s -host localhost -port %d -path %s > %s 2>&1",
            bin_path, port, path, log_path);
        int rc = system(run_cmd);
        *string err;
        if (rc != 0 && log_path && is_file(log_path)) {
            err = ReadOnlyFile::readTextFile(log_path);
        }
        if (bin_path && is_file(bin_path)) {
            unlink(bin_path);
        }
        if (log_path && is_file(log_path)) {
            unlink(log_path);
        }
        if (rc != 0) {
            return {"ok": False, "error": err ?? sprintf("nghttp2 client failed with rc %d", rc)};
        }
        return {"ok": True};
    }

    testHttp2WebSocketClientServer() {
        # Skip complex WebSocket/HTTP2 tests on Alpine - they can hang
        if (skip_complex_tests) {
            testSkip("Skipping complex WebSocket/HTTP2 test on Alpine");
            return;
        }

        # Test WebSocketClient connecting to HttpServer over HTTP/2
        # This tests the RFC 8441 WebSocket handshake over HTTP/2
        #
        # This test verifies the HTTP/2 WebSocket handshake and message exchange.

        # Create a simple WebSocket handler that sends a welcome message
        Counter cnt(1);
        Queue msg_queue();
        *string server_error;

        # Create HTTP server with HTTP/2 and WebSocket support
        EchoWebSocketHandler ws_handler(cnt);
        Logger logger("test", LoggerLevel::getLevelDebug());
        hash<HttpServerOptionInfo> http_opts = <HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        };
        HttpServer server(http_opts);
        try {
            server.setHandler("websocket", "/ws", MimeTypeText, ws_handler);
            server.setDefaultHandler("websocket", ws_handler);

            # Create SSL cert and key objects
            SSLCertificate cert(CertPem);
            SSLPrivateKey key(KeyPem);

            hash<auto> linfo = server.addListener(<HttpListenerOptionInfo>{
                "node": "localhost",
                "service": 0,  # Auto-assign port
                "cert": cert,
                "key": key,
                "http_version": "2.0",  # Enable HTTP/2
            });
            int port = linfo.port;
            server.waitForAsyncIo();

            # Create WebSocket client and connect over HTTP/2
            # Use ssl_verify_cert: False to accept self-signed certificate
            # Use http_version: "2.0" to enable HTTP/2 mode
            WebSocketClient::WebSocketClient ws_client(sub (data msg) {
                msg_queue.push(msg.toString());
            }, {
                "url": "wss://localhost:" + port + "/ws",
                "ssl_verify_cert": False,
                "http_version": "2.0",  # Force HTTP/2 mode
            });

            # Connect and wait for welcome message
            ws_client.connect();

            # Wait for welcome message (sent by server in registered() callback)
            # Use Queue.get() with timeout to wait for the message
            *string welcome_msg;
            try {
                welcome_msg = msg_queue.get(10s);
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != "QUEUE-TIMEOUT") {
                    rethrow;
                }
            }

            # Verify we received the welcome message
            assertTrue(exists welcome_msg, "should receive welcome message");
            if (exists welcome_msg) {
                assertEq("welcome", welcome_msg, "welcome message should be 'welcome'");
            }

            # Verify HTTP/2 was used for the WebSocket connection
            assertTrue(ws_client.isHttp2(), "WebSocket should be over HTTP/2");

            # Test bidirectional communication: send message and receive echo
            ws_client.send("test-echo");
            *string echo_msg;
            try {
                echo_msg = msg_queue.get(10s);
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != "QUEUE-TIMEOUT") {
                    rethrow;
                }
            }
            assertTrue(exists echo_msg, "should receive echo message");
            if (exists echo_msg) {
                assertEq("test-echo", echo_msg, "echo message should be 'test-echo'");
            }

            # Close the connection
            ws_client.disconnect();

            # Wait for server to see the disconnect
            cnt.waitForZero(5s);

        } catch (hash<ExceptionInfo> ex) {
            server_error = sprintf("%s: %s", ex.err, ex.desc);
        }
        server.stop();

        assertNothing(server_error, sprintf("server error: %s", server_error ?? "none"));
    }

