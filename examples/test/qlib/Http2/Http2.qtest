    testHttp2WebSocketExternalClientAbort() {
        # Skip complex WebSocket/HTTP2 tests on Alpine - they can hang
        if (skip_complex_tests) {
            testSkip("Skipping complex WebSocket/HTTP2 test on Alpine");
            return;
        }

        *string node_bin = getNodeBin();
        if (!node_bin) {
            testSkip("No HTTP/2-capable external client available (node)");
            return;
        }

        Counter cnt(1);
        *string server_error;
        EchoWebSocketHandler ws_handler(cnt);
        string log_path = tmp_location() + DirSep + "http2-ws-server-" + getpid() + ".log";
        Logger logger("test", LoggerLevel::getLevelDebug());
        LoggerAppenderFile la("http2-ws", new LoggerLayoutPattern("%m"), log_path);
        logger.addAppender(la);
        hash<HttpServerOptionInfo> http_opts = <HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        };
        HttpServer server(http_opts);
        try {
            server.setHandler("websocket", "/ws", MimeTypeText, ws_handler);
            server.setDefaultHandler("websocket", ws_handler);

            SSLCertificate cert(CertPem);
            SSLPrivateKey key(KeyPem);

            hash<auto> linfo = server.addListener(<HttpListenerOptionInfo>{
                "node": "localhost",
                "service": 0,
                "cert": cert,
                "key": key,
                "http_version": "2.0",
            });
            int port = linfo.port;
            string path = "/ws";
            server.waitForAsyncIo();

            hash<auto> node_res = runNodeHttp2WebSocketAbortClient(node_bin, port, path);
            if (!node_res.ok) {
                server_error = sprintf("node HTTP/2 WebSocket abort client failed: %s",
                    node_res.error ?? "unknown");
            }
        } catch (hash<ExceptionInfo> ex) {
            server_error = sprintf("%s: %s", ex.err, ex.desc);
        }
        server.stop();

        if (!server_error && log_path && is_file(log_path)) {
            string log_data = ReadOnlyFile::readTextFile(log_path);
            if (log_data.find("HTTP2-ERROR: no HTTP/2 session active") >= 0) {
                server_error = "HTTP/2 session inactive error logged during abort close";
            } else if (log_data.find("error in HTTP/2 WebSocket handler") >= 0) {
                server_error = "HTTP/2 WebSocket handler error logged during abort close";
            }
        }
        if (log_path && is_file(log_path)) {
            unlink(log_path);
        }

        assertNothing(server_error, sprintf("server error: %s", server_error ?? "none"));
    }

