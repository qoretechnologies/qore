#! Returns a serialized HTTP/2 frame
binary sub h2_frame(int type, int flags, int sid, binary payload) {
    return parse_hex_string(sprintf("%06x%02x%02x%08x", payload.size(), type, flags, sid)) + payload;
}

#! Returns one byte
binary sub b1(int b) {
    return parse_hex_string(sprintf("%02x", b));
}

#! Records the socket and stream of each HTTP/2 SSE stream so that the test can write to it directly
class RecordingHandler inherits ServerSentEventHandler::ServerSentEventHandler {
    private {
        Mutex rm();
        Condition rc();
        *hash<auto> last;
    }

    constructor() : ServerSentEventHandler::ServerSentEventHandler({"data": "none", "heartbeat": 0}) {
    }

    HttpServerAsyncIo::Http2SseStream setupAsyncSseConnectionHttp2(Socket sock, hash<auto> cx, hash<auto> hdr,
            string cid, int stream_id, *code<nothing()> wake_callback) {
        HttpServerAsyncIo::Http2SseStream rv = ServerSentEventHandler::setupAsyncSseConnectionHttp2(sock, cx, hdr,
            cid, stream_id, wake_callback);
        AutoLock al(rm);
        last = {"sock": sock, "stream_id": stream_id};
        rc.broadcast();
        return rv;
    }

    #! Returns the socket and stream ID of the next HTTP/2 SSE stream
    hash<auto> waitStream() {
        date deadline = now_us() + HangGuard;
        AutoLock al(rm);
        while (!last) {
            if (now_us() >= deadline) {
                throw "TEST-ERROR", "the HTTP/2 SSE stream was not set up";
            }
            rc.wait(rm, deadline - now_us());
        }
        return remove last;
    }
}

#! Answers with a body of the given size
class BigHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, binary(strmul("b", BigBody)), {"Content-Type": "application/octet-stream"});
    }
}

class Http2SendBufferBoundTest inherits QUnit::Test {
    private {
        HttpServer server;
        RecordingHandler handler();
        int h2c_port;
        int tls_port;
    }

    constructor() : Test("Http2SendBufferBoundTest", "1.0") {
        addTestCase("the output held for a peer that does not read is bounded whatever window it grants",
            \testNonReadingPeer(), False);
        addTestCase("the output held for a TLS peer that does not read is bounded whatever window it grants",
            \testNonReadingPeer(), True);
        addTestCase("a response larger than the high-water mark reaches a reading client", \testLargeResponse());
        set_return_value(main());
    }

    globalSetUp() {
        Logger logger("http2-send-buffer-bound", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }
        server = new HttpServer(<HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        });
        server.setDefaultHandler("sse", handler);
        server.setHandler("big", "^/?big", NOTHING, new BigHandler());
        server.waitForAsyncIo();
        h2c_port = server.addListener(<HttpListenerOptionInfo>{
            "node": "127.0.0.1",
            "service": 0,
            "http_version": "h2c",
        }).port;
        tls_port = server.addListener(<HttpListenerOptionInfo>{
            "node": "127.0.0.1",
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
            "http_version": "2.0",
            "enable_h3": False,
        }).port;
        server.waitForAsyncIo();
    }

    globalTearDown() {
        if (server) {
            server.stop();
            delete server;
        }
    }

    #! The server writes to a peer that grants the largest window and never reads: the data that the stream can
    #! take is bounded, and the stream reports a full buffer, before MaxBytes have been taken
    testNonReadingPeer(bool tls) {
        Socket s();
        if (tls) {
            s.setAlpnProtocols(("h2",));
            s.connectSSL(sprintf("127.0.0.1:%d", tls_port), HangGuard);
        } else {
            s.connect(sprintf("127.0.0.1:%d", h2c_port), HangGuard);
        }
        on_exit s.close();
        # SETTINGS_INITIAL_WINDOW_SIZE (0x4) = 2^31-1, and the connection window raised to 2^31-1 as well
        binary settings = h2_frame(4, 0, 0, <00047fffffff>);
        binary conn_window = h2_frame(8, 0, 0, parse_hex_string(sprintf("%08x", 0x7fffffff - 65535)));
        # GET / with accept: text/event-stream (:scheme http or https: static index 6 or 7); no dynamic table and no
        # Huffman coding
        binary block = (tls ? <8287> : <8286>) + <04> + b1(1) + binary("/") + <01> + b1(9) + binary("localhost")
            + <00> + b1(6) + binary("accept") + b1(17) + binary("text/event-stream");
        s.send(binary("PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n") + settings + conn_window + h2_frame(1, 0x5, 1, block));

        hash<auto> st = handler.waitStream();
        Socket sock = st.sock;
        int stream_id = st.stream_id;
        binary chunk = binary(strmul("x", ChunkSize));
        int taken = 0;
        *string err;
        while (taken < MaxBytes) {
            try {
                sock.sendHttp2StreamData(stream_id, chunk, False);
            } catch (hash<ExceptionInfo> ex) {
                err = ex.err;
                break;
            }
            taken += ChunkSize;
        }
        assertEq("HTTP2-FLOW-CONTROL", err, sprintf("the stream reports a full buffer (after %d bytes)", taken));
        assertLt(MaxBytes, taken, "the data held for the peer is bounded");
        try {
            sock.resetHttp2Stream(stream_id);
        } catch (hash<ExceptionInfo> ex) {
        }
    }

    #! A response many times the high-water mark is written in rounds to a client that reads it
    testLargeResponse() {
        HttpClientIo::HttpClientConnectionManager mgr(<HttpClientIo::HttpClientConnectionManagerOptions>{
            "protocol": "h2",
            "accept_all_certs": True,
            "request_timeout": HangGuard,
            "connect_timeout": HangGuard,
        });
        on_exit delete mgr;
        hash<auto> resp = mgr.request(sprintf("https://127.0.0.1:%d/", tls_port), "GET", "/big", NOTHING, NOTHING,
            HangGuard, False);
        assertEq(200, resp.status_code);
        assertEq(BigBody, resp.body.size(), "the whole body arrives");
    }
}
