#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires ../../../../qlib/QUnit.qm
%requires json
%requires ../../TestCertificates.qm

%exec-class Http2IntegrationTest

#! HTTP/2 Integration Tests - End-to-End client-server tests
public class Http2IntegrationTest inherits QUnit::Test {
    public {
        # Test SSL certificate (self-signed for testing)
        const CertPem = TestCertificates::CertPem;

        const KeyPem = TestCertificates::KeyPem;

        # Port for test server (0 = auto-assign)
        int server_port = 0;
    }

    constructor() : Test("Http2IntegrationTest", "1.0") {
        addTestCase("HTTP/2 client-server basic GET", \testBasicGet());
        addTestCase("HTTP/2 client-server POST with body", \testPostWithBody());
        addTestCase("HTTP/2 multiple sequential requests", \testSequentialRequests());
        addTestCase("HTTP/2 large body transfer", \testLargeBody());
        addTestCase("HTTP/2 headers preservation", \testHeadersPreservation());
        addTestCase("HTTP/2 error status codes", \testErrorStatusCodes());
        addTestCase("HTTP/2 connection persistence external", \testConnectionPersistenceExternal());

        set_return_value(main());
    }

    #! Makes a request to the external test server; a failure of the server skips the test case
    /** The external server is a dependency of these tests, so its failures are not failures of the client;
        assertions are always made outside of this method, so a failed assertion is never reported as a skip

        @param client the client
        @param body the request body, if any
        @param method the request method
        @param path the request path
        @param hdr the request headers, if any
        @param error_status the error status the request asks the server to return, if any

        @note A server error is only the status the request asked for; any other 5xx is the external server
        failing rather than answering, which is not a failure of the client.  Checking only a boolean "an error
        was requested" cannot tell those apart, so a request for \c /status/500 answered with \c 502 by an
        overloaded httpbin.org used to be reported as the client returning the wrong status.
    */
    private hash<auto> sendExternal(HTTPClient client, *data body, string method, string path, *hash<auto> hdr,
            *int error_status) {
        hash<auto> resp;
        try {
            resp = client.send(body, method, path, hdr, True);
        } catch (hash<ExceptionInfo> ex) {
            testSkip(sprintf("External server unavailable: %s: %s", ex.err, ex.desc));
        }
        if (resp.status_code >= 500 && resp.status_code != error_status) {
            testSkip(sprintf("External server unavailable: %s %s returned status %d", method, path,
                resp.status_code));
        }
        return resp;
    }

    #! Returns a client for the external test server
    private HTTPClient getExternalClient(*hash<auto> opts) {
        HTTPClient client({
            "url": "https://httpbin.org",
            "http_version": "auto",
            "timeout": 30s,
        } + opts);
        client.acceptAllCertificates(True);
        return client;
    }

    #! Test basic GET request over HTTP/2
    testBasicGet() {
        HTTPClient client = getExternalClient();
        hash<auto> resp = sendExternal(client, NOTHING, "GET", "/get");
        assertTrue(client.isHttp2Active(), "HTTP/2 should be active");
        assertEq(200, resp.status_code, "Status should be 200");
        assertEq(Type::String, resp.body.type(), "Body should be string");
    }

    #! Test POST request with JSON body
    testPostWithBody() {
        HTTPClient client = getExternalClient();
        string json_body = '{"test": "data", "number": 42}';
        hash<auto> resp = sendExternal(client, json_body, "POST", "/post", {"Content-Type": "application/json"});
        assertTrue(client.isHttp2Active(), "HTTP/2 should be active");
        assertEq(200, resp.status_code, "Status should be 200");
        assertEq(Type::String, resp.body.type(), "Body should be string");
        # httpbin echoes the request body
        assertEq({"test": "data", "number": 42}, parse_json(resp.body).json);
    }

    #! Test multiple sequential requests on same connection
    testSequentialRequests() {
        HTTPClient client = getExternalClient();
        hash<auto> resp1 = sendExternal(client, NOTHING, "GET", "/get");
        assertTrue(client.isHttp2Active(), "HTTP/2 should be active after first request");
        # the next requests reuse the connection
        hash<auto> resp2 = sendExternal(client, NOTHING, "GET", "/headers");
        assertTrue(client.isHttp2Active(), "HTTP/2 should remain active");
        hash<auto> resp3 = sendExternal(client, NOTHING, "GET", "/ip");
        assertTrue(client.isHttp2Active(), "HTTP/2 should remain active");
        assertEq(200, resp1.status_code);
        assertEq(200, resp2.status_code);
        assertEq(200, resp3.status_code);
    }

    #! Test large body transfer
    testLargeBody() {
        HTTPClient client = getExternalClient({"timeout": 60s});
        # 10KB of random bytes; HTTPClient::send() returns the body as a string, whose size is its byte count
        # (random bytes are not valid text, so the character count is meaningless)
        hash<auto> resp = sendExternal(client, NOTHING, "GET", "/bytes/10240");
        assertTrue(client.isHttp2Active(), "HTTP/2 should be active");
        assertEq(200, resp.status_code, "Status should be 200");
        assertEq(10240, resp.body.size(), "Body should be 10KB");
    }

    #! Test custom headers are preserved through HTTP/2
    testHeadersPreservation() {
        HTTPClient client = getExternalClient();
        hash<auto> resp = sendExternal(client, NOTHING, "GET", "/headers", {
            "X-Custom-Header": "test-value-123",
            "X-Another-Header": "another-value",
        });
        assertTrue(client.isHttp2Active(), "HTTP/2 should be active");
        assertEq(200, resp.status_code, "Status should be 200");
        # httpbin echoes the request headers
        hash<auto> echoed = parse_json(resp.body).headers;
        assertEq("test-value-123", echoed."X-Custom-Header");
        assertEq("another-value", echoed."X-Another-Header");
    }

    #! Test error status codes are properly returned
    testErrorStatusCodes() {
        HTTPClient client = getExternalClient({"error_passthru": True});
        hash<auto> resp = sendExternal(client, NOTHING, "GET", "/status/404");
        assertTrue(client.isHttp2Active(), "HTTP/2 should be active");
        assertEq(404, resp.status_code, "Status should be 404");
        resp = sendExternal(client, NOTHING, "GET", "/status/500", NOTHING, 500);
        assertTrue(client.isHttp2Active(), "HTTP/2 should remain active");
        assertEq(500, resp.status_code, "Status should be 500");
    }

    #! Test HTTP/2 connection persistence with multiple request types
    testConnectionPersistenceExternal() {
        HTTPClient client = getExternalClient({"error_passthru": True});
        foreach list<string> req in (("GET", "/get"), ("POST", "/post"), ("PUT", "/put"), ("DELETE", "/delete")) {
            hash<auto> resp = sendExternal(client, req[0] == "POST" ? "test data" : NOTHING, req[0], req[1]);
            assertTrue(client.isHttp2Active(), "HTTP/2 active after " + req[0]);
            assertEq(200, resp.status_code, req[0]);
        }
        # the connection still uses HTTP/2
        sendExternal(client, NOTHING, "GET", "/get");
        assertTrue(client.isHttp2Active(), "HTTP/2 still active at end");
    }
}
