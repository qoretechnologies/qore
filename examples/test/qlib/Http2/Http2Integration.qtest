    constructor() : Test("Http2IntegrationTest", "1.0") {
        addTestCase("HTTP/2 client-server basic GET", \testBasicGet());
        addTestCase("HTTP/2 client-server POST with body", \testPostWithBody());
        addTestCase("HTTP/2 multiple sequential requests", \testSequentialRequests());
        addTestCase("HTTP/2 large body transfer", \testLargeBody());
        addTestCase("HTTP/2 headers preservation", \testHeadersPreservation());
        addTestCase("HTTP/2 error status codes", \testErrorStatusCodes());
        addTestCase("HTTP/2 connection persistence external", \testConnectionPersistenceExternal());

        set_return_value(main());
    }

    #! Test basic GET request over HTTP/2
    testBasicGet() {
        # Use external HTTP/2 server for reliable testing
        HTTPClient client({
            "url": "https://httpbin.org",
            "http_version": "auto",
            "timeout": 30s,
        });
        client.acceptAllCertificates(True);

        try {
            hash<auto> resp = client.send("", "GET", "/get", NOTHING, True);
            assertTrue(client.isHttp2Active(), "HTTP/2 should be active");
            assertEq(200, resp.status_code, "Status should be 200");
            assertTrue(resp.body.typeCode() == NT_STRING, "Body should be string");
        } catch (hash<ExceptionInfo> ex) {
            testSkip(sprintf("External server unavailable: %s", ex.desc));
        }
    }

    #! Test POST request with JSON body
    testPostWithBody() {
        HTTPClient client({
            "url": "https://httpbin.org",
            "http_version": "auto",
            "timeout": 30s,
        });
        client.acceptAllCertificates(True);

        try {
            string json_body = '{"test": "data", "number": 42}';
            hash<auto> resp = client.send(json_body, "POST", "/post", {
                "Content-Type": "application/json",
            }, True);

            assertTrue(client.isHttp2Active(), "HTTP/2 should be active");
            assertEq(200, resp.status_code, "Status should be 200");

            # Verify body was returned
            assertTrue(resp.body.typeCode() == NT_STRING, "Body should be string");
        } catch (hash<ExceptionInfo> ex) {
            testSkip(sprintf("External server unavailable: %s", ex.desc));
        }
    }

    #! Test multiple sequential requests on same connection
    testSequentialRequests() {
        HTTPClient client({
            "url": "https://httpbin.org",
            "http_version": "auto",
            "timeout": 30s,
        });
        client.acceptAllCertificates(True);

        try {
            # First request
            hash<auto> resp1 = client.send("", "GET", "/get", NOTHING, True);
            assertTrue(client.isHttp2Active(), "HTTP/2 should be active after first request");

            # Second request - should reuse connection
            hash<auto> resp2 = client.send("", "GET", "/headers", NOTHING, True);
            assertTrue(client.isHttp2Active(), "HTTP/2 should remain active");

            # Third request
            hash<auto> resp3 = client.send("", "GET", "/ip", NOTHING, True);
            assertTrue(client.isHttp2Active(), "HTTP/2 should remain active");

            # All requests should succeed
            assertEq(200, resp1.status_code);
            assertEq(200, resp2.status_code);
            assertEq(200, resp3.status_code);
        } catch (hash<ExceptionInfo> ex) {
            testSkip(sprintf("External server unavailable: %s", ex.desc));
        }
    }

    #! Test large body transfer
    testLargeBody() {
        HTTPClient client({
            "url": "https://httpbin.org",
            "http_version": "auto",
            "timeout": 60s,
        });
        client.acceptAllCertificates(True);

        try {
            # Request 10KB of random bytes
            hash<auto> resp = client.send("", "GET", "/bytes/10240", NOTHING, True);

            assertTrue(client.isHttp2Active(), "HTTP/2 should be active");
            assertEq(200, resp.status_code, "Status should be 200");
            # Body might be binary or string depending on content-type
            int body_size;
            if (resp.body.typeCode() == NT_BINARY) {
                body_size = resp.body.size();
            } else if (resp.body.typeCode() == NT_STRING) {
                body_size = resp.body.length();
            } else {
                body_size = 0;
            }
            assertEq(10240, body_size, "Body should be 10KB");
        } catch (hash<ExceptionInfo> ex) {
            testSkip(sprintf("External server unavailable: %s", ex.desc));
        }
    }

    #! Test custom headers are preserved through HTTP/2
    testHeadersPreservation() {
        HTTPClient client({
            "url": "https://httpbin.org",
            "http_version": "auto",
            "timeout": 30s,
        });
        client.acceptAllCertificates(True);

        try {
            hash<auto> resp = client.send("", "GET", "/headers", {
                "X-Custom-Header": "test-value-123",
                "X-Another-Header": "another-value",
            }, True);

            assertTrue(client.isHttp2Active(), "HTTP/2 should be active");
            assertEq(200, resp.status_code, "Status should be 200");

            # httpbin echoes headers back in JSON response
            assertTrue(resp.body.typeCode() == NT_STRING, "Body should be string");
        } catch (hash<ExceptionInfo> ex) {
            testSkip(sprintf("External server unavailable: %s", ex.desc));
        }
    }

    #! Test error status codes are properly returned
    testErrorStatusCodes() {
        HTTPClient client({
            "url": "https://httpbin.org",
            "http_version": "auto",
            "timeout": 30s,
            "error_passthru": True,
        });
        client.acceptAllCertificates(True);

        try {
            # Request a 404 status
            hash<auto> resp = client.send("", "GET", "/status/404", NOTHING, True);
            assertTrue(client.isHttp2Active(), "HTTP/2 should be active");
            assertEq(404, resp.status_code, "Status should be 404");

            # Request a 500 status
            resp = client.send("", "GET", "/status/500", NOTHING, True);
            assertTrue(client.isHttp2Active(), "HTTP/2 should remain active");
            assertEq(500, resp.status_code, "Status should be 500");
        } catch (hash<ExceptionInfo> ex) {
            testSkip(sprintf("External server unavailable: %s", ex.desc));
        }
    }

    #! Test HTTP/2 connection persistence with multiple request types
    testConnectionPersistenceExternal() {
        HTTPClient client({
            "url": "https://httpbin.org",
            "http_version": "auto",
            "timeout": 30s,
            "error_passthru": True,
        });
        client.acceptAllCertificates(True);

        try {
            # Mix of different request types
            hash<auto> resp;

            resp = client.send("", "GET", "/get", NOTHING, True);
            assertTrue(client.isHttp2Active(), "HTTP/2 active after GET");
            assertEq(200, resp.status_code);

            resp = client.send("test data", "POST", "/post", NOTHING, True);
            assertTrue(client.isHttp2Active(), "HTTP/2 active after POST");
            assertEq(200, resp.status_code);

            resp = client.send("", "PUT", "/put", NOTHING, True);
            assertTrue(client.isHttp2Active(), "HTTP/2 active after PUT");
            assertEq(200, resp.status_code);

            resp = client.send("", "DELETE", "/delete", NOTHING, True);
            assertTrue(client.isHttp2Active(), "HTTP/2 active after DELETE");
            assertEq(200, resp.status_code);

            # Verify connection is still using HTTP/2
            resp = client.send("", "GET", "/get", NOTHING, True);
            assertTrue(client.isHttp2Active(), "HTTP/2 still active at end");
        } catch (hash<ExceptionInfo> ex) {
            testSkip(sprintf("External server unavailable: %s", ex.desc));
        }
    }
}
