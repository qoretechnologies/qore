#!/usr/bin/env qore

# -*- mode: qore; indent-tabs-mode: nil -*-
#
# Comprehensive memory test for HTTP/2 support
# Run with: valgrind --leak-check=full --show-leak-kinds=all qore valgrind_test.qr
