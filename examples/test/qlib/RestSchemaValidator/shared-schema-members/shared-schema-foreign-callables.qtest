#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes and in programs compiled with qcc

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires ../../../TestInterpreter.qm
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class SharedSchemaUndoTest

#! Regression test for qore#6843: Python and Java code that calls the code of a tenant back
/** Trusted code passes a callback of a tenant (a sandboxed Program) to a Python callable and to a Java function, which
    call it, also in a loop for the JIT: the callback asks a shared OpenAPI 3 schema for types and fields of its own and
    runs a type build, and the schema's caches stay as they were, and the build is refused.  The test is skipped if the
    python or the jni module cannot be loaded.

    SharedSchemaForeignCallables.q checks these; its output must be the one in SharedSchemaForeignCallables.expected in
    every execution mode, and in programs compiled with qcc -O0 and -O3.
*/
class SharedSchemaUndoTest inherits QUnit::Test {
    private {
        string qore_bin = TestInterpreter::qore_interpreter();
        string fixture = get_script_dir() + "/SharedSchemaForeignCallables.q";
        string expected = ReadOnlyFile::readTextFile(get_script_dir() + "/SharedSchemaForeignCallables.expected");
    }

    constructor() : QUnit::Test("shared schema foreign callables", "1.0", \ARGV) {
        foreach string mode in (ExecModeHarness::ExecModes) {
            string execution_mode = mode;
            addTestCase("execution mode " + mode, sub () {
                # the checks run in child Programs and in the library modules, whose code (the catalog worker that
                # builds the lazy values) chooses its own execution, so the native compilation is not checked
                check(ExecModeHarness::run(command(execution_mode), ExecModeHarness::NativeCheck::None));
            });
        }
        # no IR tier case: the library modules' own code (the catalog worker) is compiled to native code there too
        addTestCase("qcc -O0", sub () { checkQcc(0); });
        addTestCase("qcc -O3", sub () { checkQcc(3); });

        set_return_value(main());
    }

    private string command(string mode) {
        return sprintf("%s --enable-debug --exec-mode=%s %s", shellQuote(qore_bin), mode, shellQuote(fixture));
    }

    #! compiles the fixture with qcc and compares the output of the program
    private checkQcc(int opt) {
        string qcc_bin = ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }
        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        string program = dir + "/shared-schema-foreign-callables";
        string output = backquote(sprintf("%s -O%d -o %s %s 2>&1", shellQuote(qcc_bin), opt, shellQuote(program),
            shellQuote(fixture)));
        assertTrue(is_file(program), "the fixture compiled: " + output);
        # the output of the fixture only: a library module that the program loads from source because its binary
        # module was built for another Qore library warns on stderr
        check(backquote(shellQuote(program) + " 2>/dev/null"));
    }

    #! compares the output of the fixture, without the notice of the JVM about JAVA_TOOL_OPTIONS on stderr, or skips the
    #! case if the fixture could not load the python or the jni module
    private check(string output) {
        output = regex_subst(output, "^Picked up JAVA_TOOL_OPTIONS[^\n]*\n", "", RE_MultiLine | RE_Global);
        if (output == "SKIP\n") {
            testSkip("the python or the jni module cannot be loaded");
        }
        assertEq(expected, output);
    }

    private static string shellQuote(string value) {
        return "'" + replace(value, "'", "'\\''") + "'";
    }
}
