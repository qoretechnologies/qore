%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Mime
%requires DataProvider
%requires ConnectionProvider
%requires RestClientIo
%requires GoogleRestClient
%requires GoogleDriveDataProvider

%exec-class GoogleDriveDataProviderTest

public class GoogleDriveDataProviderTest inherits QUnit::Test {
    public {
        #! the application name
        const App = GoogleDriveDataProvider::AppName;

        #! the action the framework injects into every app served by a REST connection
        const FrameworkAction = "make-api-call";

        #! command-line options
        const MyOpts = Opts + {
            "conn": "c,connection=s",
        };

        #! Width of the option column in the usage text
        const OptionColumn = 22;

        #! How many times the live change-feed test looks for its change before giving up
        /** Drive's change feed is eventually consistent, so a change is not guaranteed to be visible the
            instant the write that caused it returns
        */
        const LiveChangeFeedAttempts = 10;

        #! How long the live change-feed test waits between attempts
        const LiveChangeFeedInterval = 2s;

        #! connection options sufficient to construct a connection without contacting Google
        const TestConnOptions = {
            "oauth2_client_id": "test-id",
            "oauth2_client_secret": "test-secret",
            "oauth2_redirect_url": "https://localhost:8011/oauth2-callback",
            "token": "test-token",
            "token_type": "Bearer",
        };
    }

    constructor() : Test("GoogleDriveDataProvider Test", "1.0", \ARGV, MyOpts) {
        addTestCase("connection", \connectionTest());
        addTestCase("action catalog", \actionCatalogTest());
        addTestCase("file API registration", \fileApiTest());
        addTestCase("shared drive support", \sharedDriveTest());
        addTestCase("event providers", \eventProviderTest());
        addTestCase("change classification", \changeClassificationTest());
        addTestCase("live connection", \liveConnectionTest());
        addTestCase("live shared drives", \liveSharedDriveTest());
        addTestCase("live change feed", \liveChangeFeedTest());
        addTestCase("live file lifecycle", \liveFileLifecycleTest());
        addTestCase("live folder operations", \liveFolderOperationsTest());

        set_return_value(main());
    }

    connectionTest() {
        *hash<ConnectionSchemeInfo> scheme = ConnectionSchemeCache::getScheme("gdrive");
        assertTrue(exists scheme, "the gdrive scheme is registered");
        # the narrower scope reaches only files the application created, and is the better default for a new
        # deployment; both must be offered, or changing the scope later forces a re-consent cycle
        assertEq(("drive", "drive-file"), (map $1.value, scheme.options.api_profile.allowed_values));
        assertEq("drive", scheme.options.api_profile.default_value);

        GoogleDriveRestConnection conn("gdrive-test", "test connection",
            GoogleDriveRestConnection::DefaultConnectionUrl, {}, TestConnOptions);
        assertEq("gdrive", conn.getType());
        assertEq(App, conn.getAppName());
        assertEq(True, conn.hasDataProvider());
        # an application connection leaves file locations to its application's file API rather than claiming
        # native support: Drive addresses a file by an opaque ID and needs "?alt=media", which a bare GET on the
        # location path would not produce
        assertEq(False, conn.supportsFileLocations());

        assertEq("gdrive", (new GoogleDriveDataProviderFactory()).getName());
    }

    actionCatalogTest() {
        hash<DataProviderAppInfo> app = DataProviderActionCatalog::getAppEx(App);
        assertEq("GoogleDrive", app.name);
        assertEq("gdrive", app.scheme);
        assertEq(MimeTypeSvg, app.logo_mime_type);
        assertTrue(app.logo.val(), "the logo was loaded from its file");

        # the root provider is built directly from an unconnected client, so that every action's own request
        # type can be compared against the options the catalog advertises for it
        GoogleRestClientIo client(TestConnOptions + {"api_profile": "drive"});
        on_exit client.close();
        GoogleDriveDataProvider::GoogleDriveDataProvider root(client);

        hash<string, bool> children = map {$1: True},
            keys GoogleDriveDataProvider::GoogleDriveDataProvider::DefaultChildMap;
        hash<string, bool> seen;
        int actions = 0;
        foreach hash<DataProviderActionInfo> action in (DataProviderActionCatalog::getActionsEx(App)) {
            if (action.action == FrameworkAction) {
                continue;
            }
            ++actions;
            string path = action.path;
            path =~ s/^\///;
            # the first segment must name a root child; an action path that does not resolve leaves the
            # action's provider null: reference data returns nothing and doRequest() is never reached, with no
            # error anywhere
            string root_child = (path =~ x/^([^\/]+)/)[0];
            seen{root_child} = True;
            assertTrue(children{root_child}, sprintf("action %y path %y resolves through the root ChildMap",
                action.action, action.path));
            assertTrue(exists action.output_type, sprintf("action %y has an output type", action.action));
            assertTrue(action.short_desc.length() < 80, sprintf("action %y short_desc is under 80 chars",
                action.action));

            # ... and the whole path must resolve, not just its first segment: an event action addresses a
            # provider nested under the events container
            *AbstractDataProvider dp = root.getChildProviderPath(path);
            assertTrue(exists dp, sprintf("action %y has a child provider", action.action));

            if (action.action_code == DPAT_EVENT) {
                # the event name the action advertises must be one the provider actually raises, or a trigger
                # configured from the catalog waits for an event that never arrives
                assertTrue(dp.getInfo().supports_observable,
                    sprintf("event action %y has an observable provider", action.action));
                assertTrue(exists dp.getEventTypes(){action.action_val},
                    sprintf("event action %y action_val %y is an event the provider raises", action.action,
                        action.action_val));
                continue;
            }

            # an action whose request type has fields must advertise options for them, or it renders with no
            # form fields and cannot be used
            *AbstractDataProviderType rt = dp.getRequestType();
            int fields = rt ? rt.getFields().size() : 0;
            assertEq(fields > 0, action.options.size() > 0,
                sprintf("action %y advertises options if and only if its request type has fields (%d fields, "
                    "%d options)", action.action, fields, action.options.size()));
        }
        assertEq((), keys (children - (keys seen)), "every child has a registered action");

        # download-file and export-file close the gap that made Drive unusable as a file location: the
        # TypeScript application returned metadata only, with no way to retrieve a file's bytes at all
        assertTrue(exists DataProviderActionCatalog::getAppAction(App, "download-file"));
        assertTrue(exists DataProviderActionCatalog::getAppAction(App, "export-file"));
        hash<DataProviderActionInfo> ex = DataProviderActionCatalog::getAppActionEx(App, "export-file");
        assertTrue(ex.options.mime_type.allowed_values.size() > 0,
            "the export formats are declared as allowed values rather than described in prose");
    }

    fileApiTest() {
        *hash<DataProviderFileApiInfo> fapi = DataProviderActionCatalog::getAppFileApi(App);
        assertTrue(exists fapi, "the app registers a file API for conn:// locations");
        # Drive addresses a file by an immutable ID, and addresses a new file by parent folder plus name
        assertEq(True, fapi.path_is_id);
        assertEq(True, fapi.write_path_is_parent);

        # the declared actions and options must exist, or the file API silently fails at use time
        hash<DataProviderActionInfo> read = DataProviderActionCatalog::getAppActionEx(App, fapi.read_action);
        assertTrue(exists read.options{fapi.read_path_option}, "the read path option exists on the read action");
        hash<DataProviderActionInfo> write = DataProviderActionCatalog::getAppActionEx(App, fapi.write_action);
        assertTrue(exists write.options{fapi.write_path_option},
            "the write path option exists on the write action");
        assertTrue(exists write.options{fapi.write_data_option},
            "the write data option exists on the write action");
        # write_path_is_parent requires the file format, since no other format carries a filename
        assertEq(DPFW_FILE, fapi.write_data_format);
    }
    #! Shared-drive (Team Drive) support must reach every request that addresses a file
    /** Without \c supportsAllDrives a business account cannot see shared-drive content at all, and the API
        answers as though the item did not exist -- so the failure is indistinguishable from a missing file.
        The parameter is therefore added centrally rather than at each call site, and this checks that the
        central rule covers the endpoints it must and leaves the others alone.
    */
    sharedDriveTest() {
        # every Drive endpoint that addresses a file, a permission, or a change carries the parameter
        foreach string path in (("/drive/v3/files", "/drive/v3/files/abc",
                "/drive/v3/files/abc/permissions", "/drive/v3/changes", "/upload/drive/v3/files")) {
            assertRegex("supportsAllDrives=true",
                GoogleDriveDataProviderBase::addSharedDriveSupport(path),
                sprintf("%y carries shared drive support", path));
        }
        # the existing query string is preserved rather than replaced
        assertEq("/drive/v3/files?fields=id&supportsAllDrives=true",
            GoogleDriveDataProviderBase::addSharedDriveSupport("/drive/v3/files?fields=id"));
        # a caller that set the parameter itself is left alone, rather than having it sent twice
        assertEq("/drive/v3/files?supportsAllDrives=false",
            GoogleDriveDataProviderBase::addSharedDriveSupport("/drive/v3/files?supportsAllDrives=false"));
        # the shared-drive collection endpoint itself takes no such parameter
        assertEq("/drive/v3/drives", GoogleDriveDataProviderBase::addSharedDriveSupport("/drive/v3/drives"));
        assertEq("/drive/v3/about", GoogleDriveDataProviderBase::addSharedDriveSupport("/drive/v3/about"));

        # a listing needs more than "supportsAllDrives": without "includeItemsFromAllDrives" shared-drive
        # content never appears in the results, whatever the account can reach
        assertEq("&includeItemsFromAllDrives=true", GoogleDriveListFilesDataProvider::getSharedDriveQuery({}));
        assertEq("", GoogleDriveListFilesDataProvider::getSharedDriveQuery({"include_shared_drives": False}));
        # naming a shared drive selects that collection, since Drive rejects "corpora=drive" without a "driveId"
        assertEq("&includeItemsFromAllDrives=true&driveId=d1&corpora=drive",
            GoogleDriveListFilesDataProvider::getSharedDriveQuery({"drive_id": "d1"}));
        assertEq("&includeItemsFromAllDrives=true&corpora=allDrives",
            GoogleDriveListFilesDataProvider::getSharedDriveQuery({"corpora": "allDrives"}));
        # ... and an explicit collection is not overridden by the presence of a drive ID
        assertEq("&includeItemsFromAllDrives=true&driveId=d1&corpora=allDrives",
            GoogleDriveListFilesDataProvider::getSharedDriveQuery({
                "drive_id": "d1",
                "corpora": "allDrives",
            }));
        # asking for one shared drive without saying which one is reported here rather than as an API error
        assertThrows("GOOGLE-DRIVE-ERROR", "drive_id",
            \GoogleDriveListFilesDataProvider::getSharedDriveQuery(), ({"corpora": "drive"},));

        # the shared drive picker must be offered, or a business user has no way to choose one
        GoogleRestClientIo client(TestConnOptions + {"api_profile": "drive"});
        on_exit client.close();
        GoogleDriveDataProvider::GoogleDriveDataProvider root(client);
        assertEq(True, root.getSupportedReferenceData().shared_drives);
        hash<DataProviderActionInfo> list = DataProviderActionCatalog::getAppActionEx(App, "list-files");
        assertEq("shared_drives", list.options.drive_id.ref_data);
        assertTrue(list.options.corpora.allowed_values.size() > 0,
            "the collections to search are declared as allowed values rather than described in prose");

        # renaming had no action at all: move-file only changes a file's parents and replace-file only its
        # content, so a name could not be changed through this module
        hash<DataProviderActionInfo> rename = DataProviderActionCatalog::getAppActionEx(App, "rename-file");
        assertEq(DPAT_API, rename.action_code);
        assertEq(True, rename.options.name.required);
        assertEq("files", rename.options.file_id.ref_data);
    }

    #! The module must offer triggers, not only actions
    /** The TypeScript application being replaced had triggers for new files and new folders; a module that is
        100% DPAT_API is a functional regression against it however complete its action list is.
    */
    eventProviderTest() {
        GoogleRestClientIo client(TestConnOptions + {"api_profile": "drive"});
        on_exit client.close();
        GoogleDriveDataProvider::GoogleDriveDataProvider root(client);

        AbstractDataProvider events = root.getChildProviderEx("events");
        assertEq("events", events.getName());
        assertTrue(events.getInfo().children_can_support_observers,
            "the events container advertises observable children");
        assertEq(("new-file", "new-folder"), events.getChildProviderNames());
        assertEq(2, events.getChildProviderSummaryInfo().size(), "every event child has summary info");

        foreach string name in (("new-file", "new-folder")) {
            AbstractDataProvider w = events.getChildProviderEx(name);
            assertEq(name, w.getName());
            assertTrue(w.getInfo().supports_observable, sprintf("%y is observable", name));
            hash<string, hash<DataProviderMessageInfo>> types = w.getEventTypes();
            assertEq((name,), keys types, sprintf("%y raises the event it is named for", name));
            assertTrue(types{name}.desc.val(), sprintf("%y describes its event", name));

            # example data must be produced without a working connection: the form that shows a trigger's
            # output fields is rendered before any credentials are exercised
            auto ex = w.getExampleEventData(name);
            assertEq(NT_HASH, ex.typeCode(), sprintf("%y provides example event data", name));
            # ... and it must match the declared type, or the field list the user maps against is wrong
            foreach string f in (keys types{name}.type.getFields()) {
                assertTrue(ex.hasKey(f), sprintf("%y example data has the declared field %y", name, f));
            }
            # the two watches must not produce the same example, or the folder trigger shows a file
            assertEq(name == "new-folder", ex.is_folder,
                sprintf("%y example data is %sa folder", name, name == "new-folder" ? "" : "not "));
        }

        # a shared drive keeps its own change feed, so the drive selects the feed and a change to it must
        # start a new cursor rather than resume against a different drive
        GoogleDriveWatchNewFileDataProvider w1(client, {});
        GoogleDriveWatchNewFileDataProvider w2(client, {"drive_id": "d1"});
        assertNeq(w1.getWatchStreamIdentity(), w2.getWatchStreamIdentity(),
            "watching a shared drive is a different feed");
        # ... and so must a folder filter, since a cursor established under one has already passed over what
        # the other would have wanted
        GoogleDriveWatchNewFileDataProvider w3(client, {"folder_id": "f1"});
        assertNeq(w1.getWatchStreamIdentity(), w3.getWatchStreamIdentity(),
            "filtering to a folder is a different feed");
        # ... while the poll interval only changes how often the same feed is read
        GoogleDriveWatchNewFileDataProvider w4(client, {"poll_interval": 300});
        assertEq(w1.getWatchStreamIdentity(), w4.getWatchStreamIdentity(),
            "tuning the poll interval does not discard the cursor");
        assertEq(300, w4.getPollIntervalSeconds());
        assertEq(MinPollInterval, (new GoogleDriveWatchNewFileDataProvider(client,
            {"poll_interval": 1})).getPollIntervalSeconds());

        # the file and folder watches read the same feed, so their cursors must not be shared
        GoogleDriveWatchNewFolderDataProvider wf(client, {});
        assertNeq(w1.getWatchStreamIdentity(), wf.getWatchStreamIdentity(),
            "the file and folder watches keep separate cursors");
    }

    #! Telling a creation from a modification is the whole difficulty of a "new file" trigger on a change feed
    /** Drive's `changes.list` reports creations and modifications alike, and a change entry carries nothing
        that says which it is.  Against the live feed an ordinary working day produces changes to files
        created years earlier, so without this rule `new-file` would fire on every edit in the drive.
    */
    changeClassificationTest() {
        date cursor = 2026-06-01T00:00:00Z;

        hash<auto> new_file = {
            "fileId": "f1",
            "removed": False,
            "file": {
                "id": "f1",
                "name": "new.txt",
                "mimeType": "text/plain",
                "createdTime": "2026-06-02T10:00:00Z",
                "parents": ("folder1",),
                "trashed": False,
            },
        };
        # a file created after the cursor was established is new
        *hash<auto> m = GoogleDriveWatchDataProviderBase::matchChange(new_file, False, cursor);
        assertTrue(exists m, "a file created after the cursor is reported");
        assertEq("new.txt", m.name);
        assertEq(False, m.is_folder);

        # ... but the same change seen by the folder watch is not a folder
        assertEq(NOTHING, GoogleDriveWatchDataProviderBase::matchChange(new_file, True, cursor),
            "a file is not reported as a new folder");

        # a file created before the cursor and merely edited since is a modification, not a creation; this is
        # the case that dominates a real change feed
        hash<auto> edited = new_file;
        edited.file.createdTime = "2024-02-07T14:54:18Z";
        assertEq(NOTHING, GoogleDriveWatchDataProviderBase::matchChange(edited, False, cursor),
            "an edit to a pre-existing file is not reported as a new file");

        # a removal carries no file resource at all
        assertEq(NOTHING, GoogleDriveWatchDataProviderBase::matchChange({
            "fileId": "f1",
            "removed": True,
        }, False, cursor), "a removal is not reported");

        # a trashed file is a deletion as far as a user is concerned
        hash<auto> trashed = new_file;
        trashed.file.trashed = True;
        assertEq(NOTHING, GoogleDriveWatchDataProviderBase::matchChange(trashed, False, cursor),
            "a trashed file is not reported as new");

        # a new folder is reported by the folder watch and not by the file watch
        hash<auto> new_folder = new_file;
        new_folder.file.mimeType = FolderMimeType;
        new_folder.file.name = "New Folder";
        m = GoogleDriveWatchDataProviderBase::matchChange(new_folder, True, cursor);
        assertTrue(exists m, "a folder created after the cursor is reported by the folder watch");
        assertEq(True, m.is_folder);
        assertEq(NOTHING, GoogleDriveWatchDataProviderBase::matchChange(new_folder, False, cursor),
            "a folder is not reported as a new file");

        # the folder filter is applied here, since Drive cannot narrow the change feed at the server
        assertTrue(exists GoogleDriveWatchDataProviderBase::matchChange(new_file, False, cursor, "folder1"),
            "an item in the watched folder is reported");
        assertEq(NOTHING,
            GoogleDriveWatchDataProviderBase::matchChange(new_file, False, cursor, "other-folder"),
            "an item outside the watched folder is not reported");

        # before the cursor is established nothing is filtered out by age, since there is no age to compare to
        assertTrue(exists GoogleDriveWatchDataProviderBase::matchChange(edited, False),
            "with no cursor yet, age does not exclude an item");
    }

    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-c,--connection=ARG", "set connection name for functional tests", OptionColumn);
    }

    #! Returns the connection named on the command line, or skips the test
    private *AbstractConnection getConnection() {
        *string conn_name = m_options.conn ?? ENV.GOOGLE_DRIVE_CONNECTION;
        if (!conn_name.val()) {
            testSkip("no connection specified; use -c,--connection=ARG or set GOOGLE_DRIVE_CONNECTION");
            return;
        }
        AbstractConnection conn = get_connection(conn_name);
        if (conn.getType() != "gdrive") {
            throw "OPTION-ERROR", sprintf("connection %y is type %y; expecting \"gdrive\"", conn_name,
                conn.getType());
        }
        return conn;
    }

    #! Exercises the connection against the live service
    liveConnectionTest() {
        *AbstractConnection conn = getConnection();
        if (!conn) {
            return;
        }

        hash<auto> ping = conn.ping(True);
        assertEq(True, ping.ok, sprintf("ping succeeded: %s", ping.info));

        AbstractDataProvider dp = conn.getDataProvider().getChildProvider("list-files");
        hash<auto> resp = dp.doRequest({});
        assertEq(NT_LIST, resp.files.typeCode(), "list-files returned a list");
        if (m_options.verbose > 0) {
            printf("list-files: %d files\n", resp.files.size());
            foreach auto e in (resp.files) {
                printf("  %y\n", e.name);
            }
        }
    }

    #! Exercises shared-drive addressing against the live service
    /** The account under test may own no shared drives at all, which is the normal case for a personal
        account; the point of the test is that the shared-drive parameters are accepted and that the picker
        resolves, not that any particular drive exists.
    */
    liveSharedDriveTest() {
        *AbstractConnection conn = getConnection();
        if (!conn) {
            return;
        }
        AbstractDataProvider prov = conn.getDataProvider();

        # the picker must resolve rather than raising; an account with no shared drives yields an empty list
        *list<hash<AllowedValueInfo>> drives = prov.getReferenceData("shared_drives");
        assertEq(NT_LIST, drives.typeCode(), "the shared drive picker resolves");
        if (m_options.verbose > 0) {
            printf("shared drives: %d\n", drives.size());
            foreach hash<AllowedValueInfo> d in (drives) {
                printf("  %y (%y)\n", d.display_name, d.value);
            }
        }

        # Drive must accept the whole shared-drive parameter set; a rejected parameter is a 400, which is how
        # this would fail if the combination were wrong
        AbstractDataProvider dp = prov.getChildProvider("list-files");
        hash<auto> resp = dp.doRequest({
            "corpora": "allDrives",
            "include_shared_drives": True,
            "page_size": 5,
        });
        assertEq(NT_LIST, resp.files.typeCode(), "a listing across every drive is accepted");

        # each named shared drive must actually be listable through the same action
        foreach hash<AllowedValueInfo> d in (drives) {
            hash<auto> dresp = dp.doRequest({
                "drive_id": d.value,
                "page_size": 5,
            });
            assertEq(NT_LIST, dresp.files.typeCode(), sprintf("shared drive %y is listable", d.display_name));
        }
    }

    #! Creates, renames, reads back, and removes a file on the live service
    /** This writes to the account under test; exclude it with \c --exclude="live file lifecycle" when that is
        not wanted.  The file is created in the trash-recoverable state and removed outright on exit.
    */
    #! Proves the change feed end to end: a file created now is seen, and classified as new
    /** The offline test covers the classification rule against constructed entries; this covers the part that
        only the live service can answer -- that a file created through this module actually turns up in
        `changes.list` after the token taken just before it, carrying the `createdTime` the rule depends on.

        This writes to the account under test; exclude it with `--exclude="live change feed"`.

        @note The retry is not a poll for convenience: Drive's change feed is eventually consistent, so a
        change is not guaranteed to be visible the instant the write returns.  There is no deterministic
        signal to wait on, so the budget is bounded and exceeding it fails the test rather than passing it
        quietly.
    */
    liveChangeFeedTest() {
        *AbstractConnection conn = getConnection();
        if (!conn) {
            return;
        }
        AbstractDataProvider prov = conn.getDataProvider();
        AbstractDataProvider call = prov.getChildProviderEx("__call__");

        # take the cursor first, so the file created below is unambiguously after it
        date cursor = now_us();
        hash<auto> start = call.doRequest({
            "method": "GET",
            "path": "/drive/v3/changes/startPageToken?supportsAllDrives=true",
        });
        string token = start.body.startPageToken;
        assertTrue(token.val(), "the change feed supplied a start page token");

        string name = sprintf("qore-watch-test-%d.txt", now_us().durationMicroseconds());
        hash<auto> created = prov.getChildProviderEx("create-text-file").doRequest({
            "name": name,
            "content": "created by the Qore GoogleDriveDataProvider watch test",
        });
        assertEq(name, created.name);
        on_exit {
            prov.getChildProviderEx("delete-file").doRequest({
                "file_id": created.id,
                "permanently_delete": True,
            });
        }

        string fields = "nextPageToken,newStartPageToken,changes(fileId,removed,time,changeType,file("
            + GoogleDriveDataProviderBase::getFileFields() + "))";
        *hash<auto> found;
        int attempts;
        while (!found && ++attempts <= LiveChangeFeedAttempts) {
            string page = token;
            while (True) {
                hash<auto> resp = call.doRequest({
                    "method": "GET",
                    "path": sprintf("/drive/v3/changes?pageToken=%s&pageSize=100&includeRemoved=true"
                        "&includeItemsFromAllDrives=true&supportsAllDrives=true&fields=%s",
                        encode_url(page, True), encode_url(fields, True)),
                });
                foreach hash<auto> change in (resp.body.changes) {
                    if (change.fileId != created.id) {
                        continue;
                    }
                    # the classification rule must call this new: it was created after the cursor
                    found = GoogleDriveWatchDataProviderBase::matchChange(change, False, cursor);
                }
                if (!resp.body.nextPageToken.val()) {
                    break;
                }
                page = resp.body.nextPageToken;
            }
            if (!found && attempts < LiveChangeFeedAttempts) {
                usleep(LiveChangeFeedInterval);
            }
        }

        assertTrue(exists found, sprintf("the newly created file appeared in the change feed and was "
            "classified as new (after %d attempt%s)", attempts, attempts == 1 ? "" : "s"));
        assertEq(name, found.name, "the change carries the file created");
        assertEq(False, found.is_folder, "the change is classified as a file rather than a folder");
        # the folder watch must not claim the same change
        assertEq(NOTHING, GoogleDriveWatchDataProviderBase::matchChange({
            "fileId": created.id,
            "removed": False,
            "file": {"id": created.id, "name": name, "mimeType": "text/plain", "trashed": False},
        }, True, cursor), "the folder watch does not claim a new file");
    }

    liveFileLifecycleTest() {
        *AbstractConnection conn = getConnection();
        if (!conn) {
            return;
        }
        AbstractDataProvider prov = conn.getDataProvider();
        string name = sprintf("qore-test-%d.txt", now_us().durationMicroseconds());
        string content = "created by the Qore GoogleDriveDataProvider test suite";

        hash<auto> created = prov.getChildProvider("create-text-file").doRequest({
            "name": name,
            "content": content,
        });
        assertEq(name, created.name, "the file was created with the requested name");
        assertTrue(created.id.val(), "the new file has an ID");
        on_exit {
            prov.getChildProvider("delete-file").doRequest({
                "file_id": created.id,
                "permanently_delete": True,
            });
        }

        # renaming is the gap this closes: neither move-file nor replace-file can change a name
        string new_name = name + ".renamed";
        hash<auto> renamed = prov.getChildProvider("rename-file").doRequest({
            "file_id": created.id,
            "name": new_name,
            "description": "renamed by the Qore test suite",
        });
        assertEq(new_name, renamed.name, "rename-file returned the new name");
        assertEq(created.id, renamed.id, "the file keeps its ID across a rename");

        # ... and the new name must be what the service actually holds, not just what the response echoed
        hash<auto> meta = prov.getChildProvider("get-file").doRequest({"file_id": created.id});
        assertEq(new_name, meta.name, "the new name is persisted");
        assertEq("renamed by the Qore test suite", meta.description, "the new description is persisted");

        hash<auto> downloaded = prov.getChildProvider("download-file").doRequest({"file_id": created.id});
        assertEq(content, parse_base64_string(downloaded.content).toString(),
            "the content read back matches the content written");
    }

    #! Exercises the folder-scoped operations, which a type-narrowing defect had made unusable
    /** Regression: `create-folder`, `upload-file`, and `create-text-file` each built their request body as a
        `hash<auto>` literal whose values were all strings, which narrows to `hash<string, string>` at
        runtime -- so assigning the `parents` list raised `RUNTIME-TYPE-ERROR` and **every one of these
        operations failed whenever a folder was named**.  Only the no-folder path had been exercised.

        This writes to the account under test; exclude it with `--exclude="live folder operations"`.
    */
    liveFolderOperationsTest() {
        *AbstractConnection conn = getConnection();
        if (!conn) {
            return;
        }
        AbstractDataProvider prov = conn.getDataProvider();
        string stamp = sprintf("%d", now_us().durationMicroseconds());

        hash<auto> parent = prov.getChildProviderEx("create-folder").doRequest({
            "name": "qore-test-parent-" + stamp,
        });
        assertTrue(parent.id.val(), "the parent folder was created");
        on_exit {
            # removing the parent removes everything created inside it
            prov.getChildProviderEx("delete-file").doRequest({
                "file_id": parent.id,
                "permanently_delete": True,
            });
        }

        # a folder created inside another folder: the "parents" list is what used to fail
        hash<auto> child = prov.getChildProviderEx("create-folder").doRequest({
            "name": "qore-test-child-" + stamp,
            "parent_folder_id": parent.id,
        });
        assertEq(True, child.is_folder, "the child is a folder");
        assertTrue(inlist(parent.id, child.parents), "the child folder is held by the parent");

        # a text file created inside a folder
        hash<auto> text = prov.getChildProviderEx("create-text-file").doRequest({
            "name": "in-folder-" + stamp + ".txt",
            "content": "written into a folder by the Qore test suite",
            "folder_id": parent.id,
        });
        assertTrue(inlist(parent.id, text.parents), "the text file is held by the folder it named");

        # an uploaded file inside a folder, with a description as well
        hash<auto> uploaded = prov.getChildProviderEx("upload-file").doRequest({
            "file": {
                "name": "uploaded-" + stamp + ".txt",
                "content": make_base64_string(binary("uploaded into a folder by the Qore test suite")),
                "mime_type": "text/plain",
            },
            "folder_id": parent.id,
            "description": "uploaded by the Qore test suite",
        });
        assertTrue(inlist(parent.id, uploaded.parents), "the uploaded file is held by the folder it named");
        assertEq("uploaded by the Qore test suite", uploaded.description);

        # ... and the folder really holds what was put in it
        hash<auto> listing = prov.getChildProviderEx("list-files").doRequest({"folder_id": parent.id});
        hash<string, bool> names = map {$1.name: True}, listing.files;
        assertTrue(names{"qore-test-child-" + stamp}, "the listing shows the child folder");
        assertTrue(names{"in-folder-" + stamp + ".txt"}, "the listing shows the text file");
        assertTrue(names{"uploaded-" + stamp + ".txt"}, "the listing shows the uploaded file");
    }
}
