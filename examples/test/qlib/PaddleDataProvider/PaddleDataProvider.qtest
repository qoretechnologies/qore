%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires DataProvider
%requires ConnectionProvider
%requires PaddleDataProvider
%requires PaddleRestClient
%requires RestClientIo

%requires json
%requires yaml

%exec-class PaddleDataProviderTest

#! A recorded outgoing request
hashdecl RecordedRequest {
    string method;
    string path;
    auto body;
    *hash<auto> headers;
}

#! A Paddle REST client that records requests instead of making them
class FakePaddleRestClient inherits PaddleRestClient::PaddleRestClientIo {
    public {
        #! Every request made, in order
        list<hash<RecordedRequest>> requests = ();

        #! Queued responses, consumed in order
        list<hash<auto>> responses = ();

        #! Used when the response queue is empty
        hash<auto> default_response = {"body": {}, "headers": {}};
    }

    constructor() : PaddleRestClientIo({"token": "pdl_sdbx_apikey_fake", "instance_type": "sandbox-api"}) {
    }

    push_response(hash<auto> resp) {
        push responses, resp;
    }

    reset() {
        requests = ();
        responses = ();
    }

    hash<RecordedRequest> last() {
        if (!requests) {
            throw "TEST-ERROR", "no requests were recorded";
        }
        return requests[requests.size() - 1];
    }

    hash<RestClient::RestResponseInfo> restGet(string path, *hash<auto> hdr) {
        return record("GET", path, NOTHING, hdr);
    }

    hash<RestClient::RestResponseInfo> restPost(string path, auto body, *hash<auto> hdr) {
        return record("POST", path, body, hdr);
    }

    hash<RestClient::RestResponseInfo> restPut(string path, auto body, *hash<auto> hdr) {
        return record("PUT", path, body, hdr);
    }

    hash<RestClient::RestResponseInfo> restPatch(string path, auto body, *hash<auto> hdr) {
        return record("PATCH", path, body, hdr);
    }

    hash<RestClient::RestResponseInfo> restDel(string path, auto body, *hash<auto> hdr) {
        return record("DELETE", path, body, hdr);
    }

    hash<RestClient::RestResponseInfo> restDoRequest(string method, string path, auto body, *hash<auto> hdr) {
        return record(method, path, body, hdr);
    }

    hash<RestClient::RestResponseInfo> restDoRawRequest(string method, string path, *data body,
            *hash<auto> hdr) {
        return record(method, path, body, hdr);
    }

    private hash<RestClient::RestResponseInfo> record(string method, string path, auto body, *hash<auto> hdr) {
        push requests, <RecordedRequest>{
            "method": method,
            "path": path,
            "body": body,
            "headers": hdr,
        };
        hash<auto> resp = responses ? shift responses : default_response;
        if (resp.throw_status) {
            throw "REST-RESPONSE-ERROR", sprintf("HTTP %d response received", resp.throw_status),
                <RestClient::RestResponseInfo>{
                    "status_code": resp.throw_status,
                    "headers": resp.headers ?? {},
                    "body": resp.body,
                    "request_path": path,
                };
        }
        return <RestClient::RestResponseInfo>{
            "status_code": resp.status_code ?? 200,
            "body": resp.body,
            "headers": resp.headers ?? {},
        };
    }
}

#! An event provider that records what it would report, so deliveries can be driven directly
class TestPaddleEventProvider inherits PaddleDataProvider::PaddleTransactionCompletedEventDataProvider {
    public {
        #! Events the provider reported to its observers
        list<auto> notified = ();
    }

    constructor(*PaddleRestClient::PaddleRestClientIo rest)
            : PaddleTransactionCompletedEventDataProvider(rest) {
    }

    #! Sets the signing secret, standing in for registering the destination with Paddle
    setSecret(string secret) {
        webhook_secret = secret;
    }

    reset() {
        notified = ();
    }

    #! Returns a Paddle-Signature header value for the given body
    string sign(string body, date ts, *string secret) {
        int t = get_epoch_seconds(ts);
        return sprintf("ts=%d;h1=%s", t, DataProvider::WebhookSignature::sign(secret ?? webhook_secret,
            sprintf("%d:%s", t, body)));
    }

    #! Delivers a signed payload and returns the event that was reported, if any
    *hash<auto> deliver(string body, string sig_header, date ts) {
        reset();
        deliverRaw({"body": body, "hdr": {"Paddle-Signature": sig_header}});
        return notified ? notified[0] : NOTHING;
    }

    #! Delivers a raw request as the webhook infrastructure would
    deliverRaw(hash<auto> request) {
        handleWebhookEvent(request);
    }

    #! Registers the destination, so the failure path can be driven directly
    doRegister(string url) {
        registerNotificationSetting(url);
    }

    #! Records what would have been reported to observers
    notifyObservers(string event_id, hash<auto> data) {
        notified += data;
    }
}

public class PaddleDataProviderTest inherits QUnit::Test {
    public {
        #! The operations the application is intended to export
        /** These are the operations behind the 24 actions the TypeScript application this module replaces
            exported.  \c "PATCH /products/{product_id}" backs two actions -- the general update and the
            narrowed archive -- so there are 23 operations for 24 actions.
        */
        const ExpectedOperations = (
            "GET /customers",
            "POST /customers",
            "GET /customers/{customer_id}",
            "PATCH /customers/{customer_id}",
            "POST /customers/{customer_id}/auth-token",
            "GET /customers/{customer_id}/credit-balances",
            "GET /prices",
            "POST /prices",
            "GET /prices/{price_id}",
            "PATCH /prices/{price_id}",
            "GET /products",
            "POST /products",
            "GET /products/{product_id}",
            "PATCH /products/{product_id}",
            "GET /reports",
            "POST /reports",
            "GET /reports/{report_id}",
            "GET /reports/{report_id}/download-url",
            "GET /subscriptions",
            "GET /subscriptions/{subscription_id}",
            "GET /transactions",
            "POST /transactions",
            "GET /transactions/{transaction_id}",
        );

        #! The action IDs the TypeScript application exported, which must be preserved
        /** Action identity is what existing workflows call, so the replacement keeps the IDs rather than
            restyling them.
        */
        const ExpectedActions = (
            "archive_product", "create_customer", "create_price", "create_product", "create_report",
            "create_transaction", "get_customer", "get_customer_auth_token", "get_price", "get_product",
            "get_report", "get_report_file", "get_subscription", "get_transaction",
            "list_customer_credit_balances", "list_customers", "list_prices", "list_products",
            "list_reports", "list_subscriptions", "list_transactions", "update_customer", "update_price",
            "update_product",
        );

        #! Actions whose output is the whole list envelope, because paging needs \c meta.pagination
        const EnvelopeActions = {
            "list_customers": True,
            "list_prices": True,
            "list_products": True,
            "list_reports": True,
            "list_subscriptions": True,
            "list_transactions": True,
        };

        #! The five polling triggers of the TypeScript application, and the events that replace them
        const ReplacedPollingTriggers = {
            "customer.created": "new-customer",
            "product.created": "new-product",
            "subscription.created": "new-subscription",
            "transaction.created": "new-transaction",
            "report.created": "new-report",
        };

        #! command-line options
        const MyOpts = Opts + {
            "conn": "c,connection=s",
            "write": "W,write-tests",
        };

        #! Width of the option column in the usage text
        const OptionColumn = 26;
    }

    private {
        RestSchemaActionSet aset;
        list<hash<DataProviderActionInfo>> actions;
    }

    constructor() : Test("PaddleDataProviderTest", "1.0", \ARGV, MyOpts) {
        aset = PaddleSchema::getActionSet();
        actions = aset.getActionInfoList(PaddleDataProvider::AppName);

        addTestCase("schema provenance", \provenanceTest());
        addTestCase("exported operations", \exportedOperationsTest());
        addTestCase("action presentation", \actionPresentationTest());
        addTestCase("action paths resolve", \actionPathTest());
        addTestCase("narrowed archive variant", \archiveVariantTest());
        addTestCase("reference data", \referenceDataTest());
        addTestCase("request reconstruction", \requestReconstructionTest());
        addTestCase("response contract", \responseContractTest());
        addTestCase("option types", \optionTypeTest());
        addTestCase("no timestamp codecs", \noCodecTest());
        addTestCase("connection", \connectionTest());
        addTestCase("instance type decides the URL", \instanceTypeTest());
        addTestCase("data provider construction", \constructionTest());
        addTestCase("webhook events", \webhookEventTest());
        addTestCase("webhook delivery verification", \webhookVerificationTest());
        addTestCase("webhook destination lifecycle", \webhookLifecycleTest());
        addTestCase("schema drift", \driftReportTest());
        # live tests; each skips unless a connection is named
        addTestCase("live listings", \liveListingTest());
        addTestCase("live single entities", \liveSingleEntityTest());
        addTestCase("live error handling", \liveErrorTest());
        addTestCase("live catalog round trip", \liveCatalogRoundTripTest());
        addTestCase("live webhook destination", \liveWebhookTest());

        set_return_value(main());
    }

    #! Prints the extra options this suite accepts
    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-c,--connection=ARG", "set connection name for live tests", OptionColumn);
        printOption("-W,--write-tests", "enable live tests that create and archive objects", OptionColumn);
    }

    provenanceTest() {
        # the vendored schema has to be the revision the manifest was reviewed against; recording the
        # upstream checksum is what makes an update a reviewed step rather than a silent substitution
        hash<PaddleSchemaProvenanceInfo> p = PaddleSchema::Provenance;
        assertRegex("^[0-9a-f]{64}$", p.source_sha256);
        assertRegex("PaddleHQ/paddle-openapi", p.source_url);
        assertTrue(p.imported >= p.source_updated, "the import cannot predate the upstream revision");
        assertEq(70, p.source_paths);
        assertEq(99, p.source_operations);
        assertEq(519, p.source_schemas);
        assertEq(56, p.source_webhooks);

        OpenApi3Schema schema = PaddleSchema::getSchema();
        assertTrue(schema.is31OrLater(), "Paddle publishes an OpenAPI 3.1 description");
        assertEq("Paddle API", schema.info.title);

        # Paddle lists sandbox FIRST in its servers array, so a client that adopted the schema's first
        # server would silently talk to sandbox in production; the connection derives the URL instead
        assertRegex("sandbox", schema.getTargetUrl(), "the schema's own target URL is the sandbox one");
        assertEq("https://api.paddle.com", PaddleRestClientBase::getUrlForInstanceType("api"));
    }

    exportedOperationsTest() {
        # the manifest is the application's own list of what it exports; an endpoint appearing in a future
        # schema must not become a public action until it is added there
        list<string> ops = sort(map sprintf("%s %s", $1.method.upr(), $1.path), PaddleManifest::Manifest);
        assertEq(sort(ExpectedOperations + ("PATCH /products/{product_id}",)), ops);
        assertEq(24, PaddleManifest::Manifest.size());
        assertEq(23, (keys (map {sprintf("%s %s", $1.method.upr(), $1.path): True},
            PaddleManifest::Manifest)).size());

        # action identity is preserved across the replacement, because it is what workflows call
        assertEq(ExpectedActions, sort(aset.getActionNames()));

        # every entry resolves against the vendored schema, and the operationId is checked for drift
        foreach hash<RestSchemaActionInfo> info in (PaddleManifest::Manifest) {
            RestSchemaActionOperation op = aset.getOperationEx(info.action);
            assertEq(info.method.upr(), op.getMethod());
            assertEq(info.path, op.getPath());
            assertTrue(info.operation_id.val(), sprintf("action %y pins an operationId", info.action));
        }
    }

    actionPresentationTest() {
        assertEq(ExpectedActions.size(), actions.size(), "every manifest action is registered");

        hash<string, bool> groups = {};
        foreach hash<DataProviderActionInfo> action in (actions) {
            string a = action.action;
            assertEq(PaddleDataProvider::AppName, action.app, sprintf("%y names the application", a));
            assertTrue(action.display_name.val(), sprintf("%y has a display name", a));
            assertTrue(action.short_desc.val(), sprintf("%y has a short description", a));
            assertTrue(action.desc.val(), sprintf("%y has a description", a));
            # a description that merely repeats the name teaches a user nothing
            assertTrue(action.desc.size() > action.display_name.size() + 40,
                sprintf("%y has a substantive description", a));
            assertTrue(action.groups.val(), sprintf("%y is in a group", a));
            map groups{$1} = True, action.groups;
        }
        assertEq(("Customers", "Prices", "Products", "Reports", "Subscriptions", "Transactions"),
            sort(keys groups));
    }

    actionPathTest() {
        # every registered action path is resolved against the root provider's child tree; a path that does
        # not resolve leaves dropdowns silently empty and execution broken
        PaddleDataProvider dp(new FakePaddleRestClient());
        foreach hash<DataProviderActionInfo> action in (actions) {
            AbstractDataProvider prov = dp;
            foreach string part in (action.path.split("/")) {
                if (!part.val()) {
                    continue;
                }
                prov = prov.getChildProviderEx(part);
            }
            assertTrue(exists prov, sprintf("action path %y resolves", action.path));
        }
    }

    archiveVariantTest() {
        # "archive_product" and "update_product" are the same operation: the archive action is the update
        # narrowed to one job, which the manifest declares rather than smuggling past the duplicate guard
        *hash<RestSchemaActionInfo> archive = (map $1, PaddleManifest::Manifest,
            $1.action == "archive_product")[0];
        assertEq("update_product", archive.variant_of);

        RestSchemaActionOperation op = aset.getOperationEx("archive_product");
        RestSchemaActionOperation base = aset.getOperationEx("update_product");
        assertEq(base.getMethod(), op.getMethod());
        assertEq(base.getPath(), op.getPath());

        # the archive action offers only what it needs; everything else the update offers is dropped
        assertEq(("product_id", "status"), sort(keys op.getRequestFields()));
        assertTrue(base.getRequestFields().size() > op.getRequestFields().size(),
            "the general update action offers more than the narrowed archive");

        # and it archives: supplying only the product ID must still send the fixed status
        hash<auto> wire = op.unflatten({"product_id": "pro_1", "status": "archived"});
        assertEq("archived", wire.req.body.status);
        assertEq("pro_1", wire.path_vars.product_id);

        # the status option carries the value that makes the action what it is, so supplying nothing but
        # the product ID still archives
        assertEq("archived", op.getRequestFields().status.getDefaultValue());
        assertTrue(op.getRequestFields().status.getAttributes().required);
    }

    referenceDataTest() {
        # each dropdown is produced by a listing action from this same manifest, so a dropdown can never
        # drift away from an endpoint the application actually exports
        hash<string, bool> exported = map {$1: True}, aset.getActionNames();
        foreach hash<RestSchemaReferenceDataInfo> rd in (PaddleManifest::ReferenceData.iterator()) {
            assertTrue(exported{rd.action}, sprintf("reference data %y is produced by an exported action",
                rd.name));
            # Paddle wraps a listing in "data", so records are never at the top level
            assertEq(("data",), rd.records_path);
            assertEq("id", rd.value_field);
            # Paddle's maximum page size, so filling a dropdown is one request rather than a walk
            assertEq(PaddleManifest::MaxPerPage, rd.options.per_page);
        }

        # an identifier usually comes from a previous workflow step, and a narrowly scoped key may not be
        # able to list the values at all, so every dropdown must also accept a value supplied directly
        int checked = 0;
        foreach hash<RestSchemaActionInfo> info in (PaddleManifest::Manifest) {
            foreach hash<auto> i in ((info.fields ?? {}).pairIterator()) {
                if (i.value.ref_data.val() || i.value.element_ref_data.val()) {
                    assertTrue(i.value.supports_custom_values,
                        sprintf("action %y option %y allows a value to be supplied directly", info.action,
                            i.key));
                    ++checked;
                }
            }
        }
        assertTrue(checked >= 15, "the application offers dropdowns on its identifier options");
    }

    requestReconstructionTest() {
        # flattening is only useful if it is lossless: what a user supplies as flat options has to rebuild
        # the exact transport request
        RestSchemaActionOperation op = aset.getOperationEx("list_customers");
        hash<auto> wire = op.unflatten({
            "search": "sam",
            "status": ("active",),
            "per_page": 50,
            "skip_count": "true",
        });
        assertEq("sam", wire.req.query.search);
        assertEq(("active",), wire.req.query.status);
        assertEq(50, wire.req.query.per_page);
        # the header option is renamed for presentation, but goes out under Paddle's own header name
        assertEq("true", wire.req.header."Skip-Count");
        assertNothing(wire.req.header.skip_count);
        assertEq({}, wire.path_vars);

        # a path variable lands in the path, not the query
        RestSchemaActionOperation get_customer = aset.getOperationEx("get_customer");
        hash<auto> gwire = get_customer.unflatten({"customer_id": "ctm_1"});
        assertEq("ctm_1", gwire.path_vars.customer_id);
        assertEq({}, gwire.req);

        # a body property lands in the body, and a path variable alongside it still goes to the path
        RestSchemaActionOperation update = aset.getOperationEx("update_customer");
        hash<auto> uwire = update.unflatten({"customer_id": "ctm_1", "email": "a@example.com"});
        assertEq("ctm_1", uwire.path_vars.customer_id);
        assertEq("a@example.com", uwire.req.body.email);

        # a "oneOf" request body has no properties to lift, so the action takes the body whole
        RestSchemaActionOperation report = aset.getOperationEx("create_report");
        assertEq(("body",), keys report.getRequestFields());
        hash<auto> rwire = report.unflatten({"body": {"type": "transactions"}});
        assertEq({"type": "transactions"}, rwire.req.body);

        # an option the action does not have is an error rather than a silently dropped value
        assertThrows("REST-SCHEMA-ACTION-ERROR", "has no option", \op.unflatten(), ({"nope": 1},));
    }

    responseContractTest() {
        # a listing returns Paddle's envelope whole, because meta.pagination carries the cursor without
        # which the next page cannot be fetched
        foreach string action in (keys EnvelopeActions) {
            *AbstractDataProviderType t = aset.getOperationEx(action).getResponseType();
            assertTrue(exists t, sprintf("%y publishes an output type", action));
            assertEq(("data", "meta"), sort(keys t.getFields()),
                sprintf("%y returns the list envelope", action));
            assertTrue(t.getFields().meta.getType().getFields().pagination.val(),
                sprintf("%y carries pagination", action));
        }

        # a single-entity action returns the entity: its "meta" holds only a request ID, so there is
        # nothing worth keeping
        foreach string action in (("get_customer", "create_customer", "update_customer", "get_product",
            "create_product", "update_product", "archive_product", "get_price", "create_price",
            "update_price", "get_subscription", "get_transaction", "create_transaction", "get_report",
            "create_report", "get_report_file", "get_customer_auth_token")) {
            *AbstractDataProviderType t = aset.getOperationEx(action).getResponseType();
            assertTrue(exists t, sprintf("%y publishes an output type", action));
            assertFalse(exists t.getFields().meta, sprintf("%y unwraps the envelope", action));
        }

        # the credit-balance listing is not paginated, so it unwraps too
        *AbstractDataProviderType cb = aset.getOperationEx("list_customer_credit_balances").getResponseType();
        assertFalse(exists cb.getFields().meta);
    }

    optionTypeTest() {
        # the schema's types have to survive into the action options, or every option becomes "any" and
        # the form is useless
        RestSchemaActionOperation create = aset.getOperationEx("create_customer");
        hash<string, AbstractDataField> fields = create.getRequestFields();
        # "email" is a one-member "allOf" around a scalar $ref, the standard way to attach a description
        assertEq("email", fields.email.getType().getName());
        assertTrue(fields.email.isMandatory(), "Paddle requires an email address to create a customer");
        # "name" is anyOf [Name, null], the OpenAPI 3.1 nullability idiom
        assertEq("*softstring", fields.name.getType().getName());
        assertFalse(fields.name.isMandatory());

        RestSchemaActionOperation price = aset.getOperationEx("create_price");
        hash<string, AbstractDataField> pfields = price.getRequestFields();
        assertEq("softstring", pfields.product_id.getType().getName());
        assertTrue(pfields.product_id.isMandatory());
        assertTrue(pfields.description.isMandatory());

        # no action option may be left unconstrained
        foreach string action in (aset.getActionNames()) {
            foreach hash<auto> i in ((aset.getOperationEx(action).getRequestFields() ?? {}).pairIterator()) {
                string name = i.value.getType().getName();
                assertNeq("any", name, sprintf("action %y option %y carries a type", action, i.key));
                assertNeq("*any", name, sprintf("action %y option %y carries a type", action, i.key));
            }
        }
    }

    noCodecTest() {
        # Paddle's timestamps are RFC 3339 strings, not epoch counts, so nothing needs converting; a codec
        # here would mean a conversion nobody asked for
        foreach hash<RestSchemaActionInfo> info in (PaddleManifest::Manifest) {
            foreach hash<auto> i in ((info.fields ?? {}).pairIterator()) {
                assertNothing(i.value.codec, sprintf("action %y option %y needs no codec", info.action,
                    i.key));
            }
        }
    }

    connectionTest() {
        # the live connection this replaces must be reproducible with the same options, so that the flag
        # day is a scheme change and nothing else
        hash<ConnectionSchemeInfo> scheme = PaddleRestConnection::ConnectionScheme;
        assertEq("token", scheme.required_options, "Paddle has no OAuth2 flow, so the key is all there is");
        assertTrue(scheme.options.token.sensitive, "an API key is a credential");
        assertTrue(exists scheme.options.instance_type);
        assertEq(PaddleRestClientBase::DefaultInstanceType, scheme.options.instance_type.default_value);
        assertEq("json", scheme.options."data".default_value);
        assertEq("Bearer", scheme.options.token_type.default_value);
        assertEq("GET", scheme.options.ping_method.default_value);
        # listing event types needs no permissions at all, so a ping succeeds for any valid key however
        # narrowly it is scoped
        assertEq("/event-types", scheme.options.ping_path.default_value);
        assertEq(("api", "sandbox-api"), map $1.value, scheme.options.instance_type.allowed_values);

        PaddleRestConnection conn("paddle-test", "test", "paddle://sandbox-api.paddle.com", {},
            {"token": "pdl_sdbx_apikey_x", "instance_type": "sandbox-api"});
        assertEq("paddle", conn.getType());
        # a connection that does not name its application is never associated with it
        assertEq("Paddle", conn.getAppName());
        assertTrue(conn.hasDataProvider());
    }

    instanceTypeTest() {
        assertEq("https://api.paddle.com", PaddleRestClientBase::getUrlForInstanceType("api"));
        assertEq("https://sandbox-api.paddle.com",
            PaddleRestClientBase::getUrlForInstanceType("sandbox-api"));
        assertThrows("PADDLE-INSTANCE-TYPE-ERROR", "is unknown",
            \PaddleRestClientBase::getUrlForInstanceType(), ("production",));

        # the environment is the connection's defining property, so a stored URL that disagrees with it
        # must not decide where requests go -- in either direction
        PaddleRestConnection sbx({"name": "s", "url": "paddle://api.paddle.com",
            "opts": {"token": "x", "instance_type": "sandbox-api"}});
        assertEq("paddle://sandbox-api.paddle.com", sbx.getUrl());
        PaddleRestConnection prod({"name": "p", "url": "paddle://sandbox-api.paddle.com",
            "opts": {"token": "x", "instance_type": "api"}});
        assertEq("paddle://api.paddle.com", prod.getUrl());
        # ... and the URL is not passed on to the client, which derives it from the option
        assertFalse(exists sbx.getConnectionOptions().url);

        # production is the default, matching the application this replaces
        PaddleRestConnection dflt({"name": "d", "opts": {"token": "x"}});
        assertEq("paddle://api.paddle.com", dflt.getUrl());
        assertEq("https://api.paddle.com", PaddleRestClientBase::getOptions({"token": "x"}).url);

        # an explicit URL is honoured, but the instance type is still validated rather than ignored
        assertEq("https://example.com", PaddleRestClientBase::getOptions({"url": "https://example.com",
            "instance_type": "api"}).url);
        assertThrows("PADDLE-INSTANCE-TYPE-ERROR", "is unknown", \PaddleRestClientBase::getOptions(),
            ({"url": "https://example.com", "instance_type": "nope"},));
    }

    constructionTest() {
        # the data provider accepts only options it declares; the whole connection option hash would
        # otherwise be handed to a client that does not accept it
        PaddleDataProvider dp({"token": "pdl_sdbx_apikey_x", "instance_type": "sandbox-api"});
        assertEq("paddle", dp.getName());
        assertThrows("CONSTRUCTOR-ERROR", "unknown option", sub () {
            new PaddleDataProvider({"nope": 1});
        });

        # constructed from a client, every action resolves as a child
        PaddleDataProvider fromrest(new FakePaddleRestClient());
        hash<string, bool> children = map {$1: True}, fromrest.getChildProviderNames();
        foreach string action in (ExpectedActions) {
            assertTrue(exists children{action}, sprintf("action %y resolves as a child provider", action));
        }
        assertTrue(exists children{PaddleDataProvider::EventsChildName});
        # a client also makes the framework's generic API-call child available, for an endpoint the
        # manifest does not export
        assertTrue(exists children{"__call__"});
        assertEq(ExpectedActions.size() + 2, children.size(), "and nothing else");
        assertThrows("INVALID-CHILD-PROVIDER", \fromrest.getChildProviderEx(), ("no_such_action",));
    }

    webhookEventTest() {
        assertEq(16, PaddleEvents.size());

        # the event types have to be types Paddle actually sends; the vendored schema carries the enum, so
        # an upstream rename fails here rather than at run time when nothing is ever delivered
        OpenApi3Schema schema = PaddleSchema::getSchema();
        OpenApi3::SchemaObject event_names = schema.components.schemas.EventTypeName;
        assertEq(56, event_names.enumValues.size());

        PaddleEventsDataProvider events(NOTHING);
        hash<string, bool> seen = {};
        foreach hash<PaddleEventRegistrationInfo> event in (PaddleEvents) {
            assertTrue(event_names.enumValues{event.event_type},
                sprintf("%y is an event type Paddle declares", event.event_type));
            assertFalse(exists seen{event.event_type}, sprintf("%y is registered once", event.event_type));
            seen{event.event_type} = True;

            AbstractDataProvider prov = events.getChildProviderEx(event.event);
            assertEq(event.event, prov.getName());
            assertTrue(prov.getInfo().supports_observable);
        }

        # each of the five polling triggers the TypeScript application ran is replaced by a real event
        foreach hash<auto> i in (ReplacedPollingTriggers.pairIterator()) {
            assertTrue(exists seen{i.key}, sprintf("the %y trigger is replaced by the %y event", i.value,
                i.key));
        }

        assertThrows("INVALID-CHILD-PROVIDER", \events.getChildProviderEx(), ("no-such-event",));
    }

    webhookVerificationTest() {
        # a notification destination is a URL anyone can post to: unverified, it would accept a forged
        # "transaction.completed", which is enough to provision a paid plan nobody paid for
        TestPaddleEventProvider ep();
        ep.setSecret("pdl_ntfset_test_secret");

        string body = "{\"event_id\":\"evt_1\",\"event_type\":\"transaction.completed\","
            "\"data\":{\"id\":\"txn_1\"}}";
        date ts = now_us();

        # a correctly signed delivery is accepted
        assertEq("evt_1", ep.deliver(body, ep.sign(body, ts), ts).event_id);

        # a forged delivery signed with a different secret is dropped
        assertNothing(ep.deliver(body, ep.sign(body, ts, "pdl_ntfset_attacker"), ts));

        # so is one whose body was altered after signing
        assertNothing(ep.deliver(body + " ", ep.sign(body, ts), ts));

        # a captured delivery replayed beyond the tolerance is dropped
        date old = ts - 10m;
        assertNothing(ep.deliver(body, ep.sign(body, old), old));

        # a delivery with no signature header at all is dropped
        assertNothing(ep.deliverRaw({"body": body, "hdr": {}}));

        # ... as is one whose header carries no usable values
        assertNothing(ep.deliverRaw({"body": body, "hdr": {"Paddle-Signature": "garbage"}}));

        # Paddle separates the pairs with ";" where Stripe uses ","; a comma-separated header must not
        # parse into usable values, or the separator would not matter and this would be untested
        int t = get_epoch_seconds(ts);
        string comma = sprintf("ts=%d,h1=%s", t, DataProvider::WebhookSignature::sign(
            "pdl_ntfset_test_secret", sprintf("%d:%s", t, body)));
        ep.reset();
        ep.deliverRaw({"body": body, "hdr": {"Paddle-Signature": comma}});
        assertEq((), ep.notified, "a comma-separated header is not Paddle's format");

        # a delivery that arrives already parsed cannot be verified, because the signature covers the
        # bytes as sent; it is dropped rather than accepted unchecked
        assertNothing(ep.deliverRaw({
            "body": parse_json(body),
            "hdr": {"Paddle-Signature": ep.sign(body, ts)},
        }));

        # nothing is accepted before the destination has been registered and a secret is known
        TestPaddleEventProvider unregistered();
        assertNothing(unregistered.deliver(body, "ts=1;h1=deadbeef", ts));

        # a signed delivery of some other event type is not reported by this provider
        string other = "{\"event_id\":\"evt_2\",\"event_type\":\"transaction.created\"}";
        ep.reset();
        ep.deliverRaw({"body": other, "hdr": {"Paddle-Signature": ep.sign(other, ts)}});
        assertEq((), ep.notified);

        # the header name is matched without regard to case, as HTTP header names are case-insensitive
        ep.reset();
        ep.deliverRaw({"body": body, "hdr": {"PADDLE-SIGNATURE": ep.sign(body, ts)}});
        assertEq(1, ep.notified.size());
    }

    webhookLifecycleTest() {
        # the separator is a parameter because services disagree on it; both forms have to work
        hash<string, list<string>> paddle = DataProvider::WebhookSignature::parseKeyValueHeader(
            "ts=1614556800;h1=aaa;h1=bbb", ";");
        assertEq("1614556800", paddle.ts[0]);
        assertEq(("aaa", "bbb"), paddle.h1);
        hash<string, list<string>> stripe = DataProvider::WebhookSignature::parseKeyValueHeader(
            "t=1614556800,v1=aaa,v1=bbb");
        assertEq("1614556800", stripe.t[0]);
        assertEq(("aaa", "bbb"), stripe.v1);

        # a destination without a signing secret cannot verify anything, so registration fails rather
        # than leaving an endpoint that accepts whatever it is sent
        TestPaddleEventProvider no_client();
        assertThrows("PADDLE-WEBHOOK-ERROR", "no REST client is available", sub () {
            no_client.doRegister("https://example.com/hook");
        });

        FakePaddleRestClient rest();
        rest.push_response({"body": {"data": {"id": "ntfset_1"}}});
        TestPaddleEventProvider ep(rest);
        assertThrows("PADDLE-WEBHOOK-ERROR", "no signing secret", sub () {
            ep.doRegister("https://example.com/hook");
        });
        assertEq("POST", rest.last().method);
        assertEq("/notification-settings", rest.last().path);
        assertEq("url", rest.last().body.type);
        assertEq(("transaction.completed",), rest.last().body.subscribed_events);
    }

    driftReportTest() {
        # the manifest and the vendored schema must agree; drift is what an update has to surface
        list<hash<RestSchemaDriftInfo>> drift = RestSchemaDrift::compare(aset, PaddleSchema::getSchema());
        assertEq((), drift, "the manifest and the vendored schema agree");
    }

    #! Returns a client for the connection named on the command line, or skips the test
    /** Works either side of the flag day.  A native \c "paddle" connection is used directly; a connection
        still serving the TypeScript application is used by seeding a native client from its stored
        credentials, which is how this application can be verified against a real account before the
        TypeScript one is removed.
    */
    private *PaddleRestClientIo getLiveClient() {
        *string conn_name = m_options.conn ?? ENV.PADDLE_CONNECTION;
        if (!conn_name.val()) {
            testSkip("no connection specified; use -c,--connection=ARG or set PADDLE_CONNECTION");
            return;
        }
        AbstractConnection conn = get_connection(conn_name);
        if (conn.getType() == "paddle") {
            return cast<PaddleRestClientIo>(conn.getAsync());
        }
        hash<auto> opts = conn.getInfo({"with_passwords": True}).opts;
        if (!opts.token.val()) {
            throw "OPTION-ERROR", sprintf("connection %y is type %y and has no stored token to seed a "
                "native client with; use a native \"paddle\" connection, or one still serving the "
                "TypeScript application", conn_name, conn.getType());
        }
        return new PaddleRestClientIo({
            "token": opts.token,
            "instance_type": opts.instance_type ?? PaddleRestClientBase::DefaultInstanceType,
        });
    }

    liveListingTest() {
        *PaddleRestClientIo rest = getLiveClient();
        if (!rest) {
            return;
        }
        PaddleDataProvider dp(rest);

        # every listing returns Paddle's envelope, and the pagination block is what makes paging possible
        foreach string action in (sort(keys EnvelopeActions)) {
            hash<auto> res = dp.getChildProviderEx(action).doRequest({"per_page": 2});
            assertEq(("data", "meta"), sort(keys res), sprintf("%y returns the envelope", action));
            assertEq(NT_LIST, res.data.typeCode(), sprintf("%y returns a list of records", action));
            assertTrue(res.meta.request_id.val(), sprintf("%y reports a request ID", action));
            assertEq(NT_BOOLEAN, res.meta.pagination.has_more.typeCode(),
                sprintf("%y reports whether another page exists", action));
            assertTrue(res.data.size() <= 2, sprintf("%y honours per_page", action));
        }

        # the option that asks Paddle to skip the count query has to reach the service as a header rather
        # than a query argument, which is what the offline reconstruction test pins down.  Paddle documents
        # answering with an estimated total of -1, but does not always do so -- a small collection comes
        # back counted either way -- so what is asserted here is that sending it is accepted and still
        # yields a usable page, not what Paddle chooses to put in the count
        hash<auto> skipped = dp.getChildProviderEx("list_customers").doRequest({
            "per_page": 1,
            "skip_count": "true",
        });
        assertEq(NT_INT, skipped.meta.pagination.estimated_total.typeCode());
        assertEq(NT_LIST, skipped.data.typeCode());
    }

    liveSingleEntityTest() {
        *PaddleRestClientIo rest = getLiveClient();
        if (!rest) {
            return;
        }
        PaddleDataProvider dp(rest);

        hash<auto> customers = dp.getChildProviderEx("list_customers").doRequest({"per_page": 1});
        if (!customers.data) {
            testSkip("the account has no customers to read back");
            return;
        }
        string customer_id = customers.data[0].id;

        # a single-entity action returns the entity itself, not the envelope
        auto customer = dp.getChildProviderEx("get_customer").doRequest({"customer_id": customer_id});
        assertEq(NT_HASH, customer.typeCode());
        assertEq(customer_id, customer.id);
        assertFalse(exists customer.meta, "the single-entity envelope is unwrapped");
        # the REST API returns snake_case; the SDK the TypeScript application used returned camelCase
        assertTrue(exists customer.created_at, "Paddle's REST API names this created_at");
        assertFalse(exists customer.createdAt);
        # ... and RFC 3339 strings rather than epoch counts, which is why no codec is needed
        assertRegex("^[0-9]{4}-[0-9]{2}-[0-9]{2}T", customer.created_at);

        # the credit-balance listing is not paginated, so it unwraps to the list itself
        auto balances = dp.getChildProviderEx("list_customer_credit_balances").doRequest({
            "customer_id": customer_id,
        });
        assertEq(NT_LIST, balances.typeCode());
    }

    liveErrorTest() {
        *PaddleRestClientIo rest = getLiveClient();
        if (!rest) {
            return;
        }
        PaddleDataProvider dp(rest);

        # an unknown ID must fail loudly rather than return an empty result that reads as "no such data"
        assertThrows("REST-RESPONSE-ERROR", sub () {
            dp.getChildProviderEx("get_customer").doRequest({"customer_id": "ctm_00000000000000000000000000"});
        });

        # a credential must never be echoed back in an exception
        try {
            dp.getChildProviderEx("get_product").doRequest({"product_id": "pro_00000000000000000000000000"});
            fail("retrieving a non-existent product must fail");
        } catch (hash<ExceptionInfo> ex) {
            string dump = sprintf("%s %s %y", ex.err, ex.desc, ex.arg);
            assertFalse(dump =~ /pdl_(live|sdbx)_apikey_/, "the API key does not appear in the exception");
        }
    }

    liveCatalogRoundTripTest() {
        *PaddleRestClientIo rest = getLiveClient();
        if (!rest) {
            return;
        }
        if (!m_options.write) {
            testSkip("write tests not enabled; use -W,--write-tests");
            return;
        }
        PaddleDataProvider dp(rest);

        string tag = "qore-paddle-qtest-" + get_random_string(8);

        # create a product, price it, change it, and retire both.  Paddle has no delete operation for a
        # catalog object, so archiving is the only cleanup there is
        auto product = dp.getChildProviderEx("create_product").doRequest({
            "name": tag,
            "tax_category": "standard",
            "description": "created by PaddleDataProvider.qtest",
            "custom_data": {"qore_test": tag},
        });
        assertRegex("^pro_", product.id);
        assertEq("active", product.status);
        assertEq(tag, product.name);
        assertEq(tag, product.custom_data.qore_test);

        on_exit {
            # archive whatever was created, even if an assertion above failed
            try {
                dp.getChildProviderEx("archive_product").doRequest({"product_id": product.id});
            } catch (hash<ExceptionInfo> ex) {
                printf("WARNING: could not archive test product %y: %s\n", product.id,
                    get_exception_string(ex));
            }
        }

        auto price = dp.getChildProviderEx("create_price").doRequest({
            "product_id": product.id,
            "description": tag + " monthly",
            "unit_price": {"amount": "1000", "currency_code": "USD"},
            "billing_cycle": {"interval": "month", "frequency": 1},
        });
        assertRegex("^pri_", price.id);
        assertEq(product.id, price.product_id);
        # amounts are strings in the currency's smallest unit, so nothing is lost to floating point
        assertEq("1000", price.unit_price.amount);
        assertEq("USD", price.unit_price.currency_code);

        auto updated = dp.getChildProviderEx("update_product").doRequest({
            "product_id": product.id,
            "description": "updated by PaddleDataProvider.qtest",
        });
        assertEq("updated by PaddleDataProvider.qtest", updated.description);
        assertEq("active", updated.status, "an update that does not touch the status leaves it alone");

        auto archived_price = dp.getChildProviderEx("update_price").doRequest({
            "price_id": price.id,
            "status": "archived",
        });
        assertEq("archived", archived_price.status);

        # the narrowed variant archives with nothing but the product ID
        auto archived = dp.getChildProviderEx("archive_product").doRequest({"product_id": product.id});
        assertEq("archived", archived.status);

        # an archived product is still readable, but no longer listed
        auto readback = dp.getChildProviderEx("get_product").doRequest({"product_id": product.id});
        assertEq("archived", readback.status);
        hash<auto> active = dp.getChildProviderEx("list_products").doRequest({
            "per_page": PaddleManifest::MaxPerPage,
            "status": ("active",),
        });
        assertEq((), (select active.data, $1.id == product.id),
            "an archived product is not returned by the active listing");
    }

    liveWebhookTest() {
        *PaddleRestClientIo rest = getLiveClient();
        if (!rest) {
            return;
        }
        if (!m_options.write) {
            testSkip("write tests not enabled; use -W,--write-tests");
            return;
        }

        # the destination lifecycle is real API, not manual setup: this is what an event subscription
        # does when it starts and stops
        hash<auto> resp = rest.restPost("/notification-settings", {
            "description": "PaddleDataProvider.qtest",
            "type": "url",
            "destination": "https://example.com/qore-paddle-qtest",
            "subscribed_events": ("transaction.completed",),
        });
        hash<auto> setting = resp.body.data;
        assertRegex("^ntfset_", setting.id);

        bool deleted = False;
        on_exit {
            if (!deleted) {
                try {
                    rest.restDel("/notification-settings/" + setting.id);
                } catch (hash<ExceptionInfo> ex) {
                    printf("WARNING: could not delete test notification destination %y: %s\n", setting.id,
                        get_exception_string(ex));
                }
            }
        }

        # without the signing secret nothing that arrives could be verified
        assertRegex("^pdl_ntfset_", setting.endpoint_secret_key);
        assertEq("transaction.completed", setting.subscribed_events[0].name);

        # a delivery signed with the secret Paddle actually issued must verify, which is what proves the
        # scheme here matches Paddle's rather than merely being self-consistent
        string body = "{\"event_type\":\"transaction.completed\"}";
        int ts = get_epoch_seconds(now_us());
        string signed = sprintf("%d:%s", ts, body);
        string header = sprintf("ts=%d;h1=%s", ts,
            DataProvider::WebhookSignature::sign(setting.endpoint_secret_key, signed));
        hash<string, list<string>> parts = DataProvider::WebhookSignature::parseKeyValueHeader(header, ";");
        assertTrue(DataProvider::WebhookSignature::verify(<DataProvider::WebhookSignatureInfo>{
            "secret": setting.endpoint_secret_key,
            "payload": signed,
            "signatures": parts.h1,
            "timestamp": gmtime(parts.ts[0].toInt()),
            "tolerance": 5m,
        }));

        rest.restDel("/notification-settings/" + setting.id);
        deleted = True;
        assertThrows("REST-RESPONSE-ERROR", sub () {
            rest.restGet("/notification-settings/" + setting.id);
        });
    }
}
