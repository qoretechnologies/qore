#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
#
# Copyright 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires ../../TestInterpreter.qm
%requires ../../ExecModeHarness.qm

%exec-class ConnectionProviderRestrictedCallerTest

#! Code that may not receive the host's secrets gets no connection of the host from the connection provider modules
/** Sandboxed code and code restricted from external information get, from the ConnectionProvider functions and from
    DataProvider::tryLoadProviderForConnectionFromEnv(), only the connections of a connection provider module that
    declares that it resolves names for the calling code; a lookup of any other connection fails as for an unknown
    name, and the lists leave such connections out.  Trusted code gets every connection, also for restricted code
    with a capability or a policy barrier, while restricted code that such a grant calls back does not.

    The provider modules read the environment that the process started with, so the checks are in
    restricted-caller/restricted-caller-worker.qr, which is run in each execution mode in an environment that names
    the test's provider modules
*/
public class ConnectionProviderRestrictedCallerTest inherits QUnit::Test {
    #! the environment variables passed on to the worker
    const PassedEnv = ("PATH", "HOME", "QORE_INCLUDE_DIR");

    #! the callers of the worker
    const Callers = ("trusted", "sbx-a", "sbx-b", "noext");

    #! the URL of the host's connection, with its password
    const HostUrl = "rchost://hostuser:host-secret@host.invalid";

    public {
        #! the result of every lookup of every caller
        const Expected = {
            "trusted.conn-host": HostUrl,
            "trusted.conn-scoped": "rcscoped://none:secret-none@none.invalid",
            "trusted.conn-unknown": "CONNECTION-ERROR",
            "trusted.url-host": HostUrl,
            "trusted.url-literal": "lit://u:p@h",
            "trusted.list": "rc-host,rc-scoped",
            "trusted.hash-host-pw": "host-secret",
            "trusted.hash-scoped-pw": "secret-none",
            "trusted.dp-host": "rc-host",
            "trusted.dp-scoped": "rc-scoped",
            # trusted code gets the host's connection, so its lookup does not fail
            "trusted.oracle": "differs",
            "trusted.leak": "none",
            "trusted.grant-cap": HostUrl,
            "trusted.grant-callback": HostUrl,
            "trusted.grant-barrier": HostUrl,
        } + ConnectionProviderRestrictedCallerTest::restricted("sbx-a", "tenant-a")
          + ConnectionProviderRestrictedCallerTest::restricted("sbx-b", "tenant-b")
          + ConnectionProviderRestrictedCallerTest::restricted("noext", "none");
    }

    private {
        string qore_bin;
        string libqore_dir;
    }

    constructor() : Test("ConnectionProviderRestrictedCaller", "1.0", \ARGV) {
        qore_bin = TestInterpreter::qore_interpreter();
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        addTestCase("connection lookups of restricted code in each execution mode", \testExecModes());
        set_return_value(main());
    }

    #! the results of a caller that may not receive the host's secrets, whose own connections are the owner's
    static hash<auto> restricted(string caller, string owner) {
        string own = sprintf("rcscoped://%s:secret-%s@%s.invalid", owner, owner, owner);
        return {
            caller + ".conn-host": "CONNECTION-ERROR",
            caller + ".conn-scoped": own,
            caller + ".conn-unknown": "CONNECTION-ERROR",
            caller + ".url-host": "CONNECTION-ERROR",
            caller + ".url-literal": "lit://u:p@h",
            caller + ".list": "rc-scoped",
            caller + ".hash-host-pw": "none",
            caller + ".hash-scoped-pw": "secret-" + owner,
            caller + ".dp-host": "none",
            caller + ".dp-scoped": "rc-scoped",
            caller + ".oracle": "same",
            caller + ".leak": "none",
            # a capability of trusted code lends it
            caller + ".grant-cap": HostUrl,
            # restricted code that a grant calls back gets nothing
            caller + ".grant-callback": "CONNECTION-ERROR",
            # trusted code that a restricted caller calls lends it with a policy barrier
            caller + ".grant-barrier": HostUrl,
        };
    }

    testExecModes() {
        string dir = get_script_dir() + DirSep + "restricted-caller";
        # the provider modules are found by name, with the test's own modules first
        string module_dir = dir + PathSep + (ENV.QORE_MODULE_DIR ?? (get_script_dir() + "/../../../../qlib"));
        # only the variables needed to run qore are passed on, and the module path; no other QORE_* variable is
        # passed on: they can hold credentials or name other provider modules
        list<string> pass = (
            sprintf("QORE_MODULE_DIR=%s", quote(module_dir)),
            "QORE_CONNECTION_PROVIDERS=RcHostConnectionProvider" + PathSep + "RcScopedConnectionProvider",
            "QORE_DATA_PROVIDERS=RcHostConnectionProvider",
        );
        foreach string var in (PassedEnv) {
            # live-provider-optin: PassedEnv names the search path and qore's own directories, no credentials
            if (exists ENV{var}) {
                # live-provider-optin: PassedEnv names the search path and qore's own directories, no credentials
                pass += sprintf("%s=%s", var, quote(ENV{var}));
            }
        }
        foreach string mode in (ExecModeHarness::ExecModes) {
            hash<string, string> results = {};
            # the lookups of every caller, then the data provider lookups of each caller in a process of its own
            # (see the worker's DpProbes)
            foreach *string arg in ((NOTHING,) + (map "dp:" + $1, Callers)) {
                string out = ExecModeHarness::run(sprintf("env -i %s LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s %s -b "
                    "--enable-debug --exec-mode=%s %s %s", pass.join(" "), quote(libqore_dir), quote(libqore_dir),
                    quote(qore_bin), mode, quote(dir + DirSep + "restricted-caller-worker.qr"), arg ?? ""),
                    ExecModeHarness::NativeCheck::None);
                foreach string line in (out.split("\n")) {
                    *list<*string> parts = (line =~ x/^([-a-z]+\.[-a-z]+)=(.*)$/);
                    if (parts) {
                        results{parts[0]} = parts[1];
                    } else if (line.val()) {
                        fail(sprintf("%s %s: unexpected worker output: %y", mode, arg ?? "", out));
                    }
                }
            }
            foreach hash<auto> i in (Expected.pairIterator()) {
                assertEq(i.value, results{i.key}, sprintf("%s: %s", mode, i.key));
            }
            assertEq(Expected.size(), results.size(), mode + ": result count");
        }
    }

    #! quotes a value for the shell
    private static string quote(string str) {
        return "'" + replace(str, "'", "'\\''") + "'";
    }
}
