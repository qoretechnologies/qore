%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires Util
%requires Logger
%requires HttpServer
%requires HttpServerUtil
%requires ConnectionProvider
%requires RestClient
%requires UrlDownloader
%requires FileLocationHandler
%requires HttpClientIo
%requires JsonRpcClientIo
%requires YamlRpcClientIo
%requires McpClient
%requires Pop3Client
%requires JsonLd
%requires EmpathicBuildingDataProvider

%exec-class CredentialMessagesTest

#! Captures the messages logged
class CredentialMessagesAppender inherits LoggerAppenderWithLayout {
    private {
        Mutex m();
        list<string> messages = ();
    }

    constructor() : LoggerAppenderWithLayout("capture", new LoggerLayoutPattern("%m")) {
        open();
    }

    processEventImpl(int type, auto params) {
        if (type == LoggerAppender::EVENT_LOG) {
            AutoLock al(m);
            push messages, params.toString();
        }
    }

    list<string> getMessages() {
        AutoLock al(m);
        return messages;
    }
}

#! Answers every request with an error: 500 for RPC paths, 401 for login and token paths
class CredentialMessagesHandler inherits AbstractHttpRequestHandler {
    hash<auto> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        if (cx.raw_path =~ /(token|login)/) {
            return makeResponse({"Content-Type": "application/json"}, 401, "{\"error\": \"invalid_client\"}");
        }
        return makeResponse(500, "server error");
    }
}

#! Messages, exceptions and log lines that are built from a URL or option that can hold a credential do not contain it
class CredentialMessagesTest inherits QUnit::Test {
    private {
        string secret = "conn-secret-" + get_random_string(16);
        HttpServer server;
        int port;
        #! a port on which nothing listens
        int closed_port;
    }

    constructor() : QUnit::Test("CredentialMessages", "1.0", \ARGV) {
        addTestCase("connections", \connectionTest());
        addTestCase("HTTP connection URLs and logs", \httpConnectionTest());
        addTestCase("downloads", \downloadTest());
        addTestCase("FTP file locations", \ftpLocationTest());
        addTestCase("HTTP client connection manager", \connectionManagerTest());
        addTestCase("JSON-RPC and YAML-RPC clients", \rpcTest());
        addTestCase("MCP client log", \mcpTest());
        addTestCase("POP3 URLs", \pop3Test());
        addTestCase("JSON-LD loader", \jsonLdTest());
        addTestCase("OAuth2 token request log", \oauth2Test());
        addTestCase("Haltian login log", \haltianTest());
        set_return_value(main());
    }

    globalSetUp() {
        server = new HttpServer(<HttpServerOptionInfo>{
            "logger": new Logger("credential-messages", LoggerLevel::getLevelError()),
        });
        server.setDefaultHandler("fixture", new CredentialMessagesHandler());
        port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        Socket s();
        s.bind("127.0.0.1:0");
        closed_port = s.getSocketInfo().port;
        s.close();
    }

    globalTearDown() {
        if (server) {
            server.stop();
        }
    }

    #! Returns a logger that captures its messages in the appender
    private static Logger getLogger(CredentialMessagesAppender appender) {
        Logger logger("capture", LoggerLevel::getLevelDebug());
        logger.addAppender(appender);
        return logger;
    }

    #! Asserts that a message does not contain the secret and masks it
    private assertMasked(string msg, *string label) {
        assertEq(-1, msg.find(secret), label ?? msg);
        assertRegex("<masked>", msg, label ?? msg);
    }

    #! Asserts that no message contains the secret
    private assertNoSecret(list<string> messages, *string label) {
        assertEq((), (select messages, $1.find(secret) >= 0), label);
    }

    #! Returns the exception that a call raises
    private static hash<ExceptionInfo> getException(code c, *list<auto> args) {
        try {
            call_function_args(c, args);
        } catch (hash<ExceptionInfo> ex) {
            return ex;
        }
        throw "TEST-ERROR", "the call did not raise an exception";
    }

    connectionTest() {
        # an invalid connection
        InvalidConnection conn("orders", "an invalid connection", "https://user:" + secret + "@orders.example/api",
            {"error": "the connection scheme is not supported"});
        hash<ExceptionInfo> ex = getException(\conn.get());
        assertEq("INVALID-CONNECTION", ex.err);
        assertMasked(ex.desc);
        assertRegex("https://user:<masked>@orders.example/api", ex.desc);
        # a URL with control characters
        ex = getException(sub () { InvalidConnection c("orders", "", "https://user:" + secret + "@orders.ex\x01ample/");
            delete c; });
        assertEq("CONNECTION-URL-ERROR", ex.err);
        assertMasked(ex.desc);
    }

    httpConnectionTest() {
        # an unsupported scheme (a URL with user information always has a host)
        hash<ExceptionInfo> ex = getException(\HttpClientIoPollOperation::splitUrl(), ("ftp://user:" + secret
            + "@host/x",));
        assertEq("HTTP-CLIENT-URL-ERROR", ex.err);
        assertMasked(ex.desc);

        # the start of an asynchronous ping and request is logged with the URL of the connection
        CredentialMessagesAppender appender();
        Logger logger = getLogger(appender);
        string base_url = sprintf("http://user:%s@127.0.0.1:%d/api", secret, closed_port);
        HttpPingPollOperation ping(base_url, "GET", "/ping", NOTHING, NOTHING, NOTHING, logger);
        HttpRequestPollOperation req(base_url, "GET", "/orders", NOTHING, NOTHING, NOTHING, logger);
        list<string> messages = appender.getMessages();
        assertEq(1, (select messages, $1 =~ /async ping start: .*url="http:\/\/user:<masked>@127.0.0.1/).size(),
            sprintf("%y", messages));
        assertEq(1, (select messages, $1 =~ /HttpRequest async start: .*url="http:\/\/user:<masked>@127.0.0.1/).size(),
            sprintf("%y", messages));
        assertNoSecret(messages);
        delete ping;
        delete req;
    }

    downloadTest() {
        UrlDownloader downloader();
        hash<ExceptionInfo> ex = getException(\downloader.download(), ("http://user:" + secret + "@/file.csv",));
        assertEq(-1, ex.desc.find(secret), ex.desc);
        # the connection fails
        ex = getException(\downloader.download(), (sprintf("http://user:%s@127.0.0.1:%d/orders.csv", secret,
            closed_port),));
        assertMasked(ex.desc);
    }

    ftpLocationTest() {
        foreach string location in ("ftp://user:" + secret + "@ftp.example/", "sftp://user:" + secret + "@sftp.example/",
                "nosuchscheme://user:" + secret + "@host/file.csv") {
            hash<ExceptionInfo> ex = getException(\FileLocationHandler::getBinaryFileFromLocation(), (location,));
            assertEq(-1, ex.desc.find(secret), ex.desc);
        }
        hash<ExceptionInfo> ex = getException(\FileLocationHandler::getBinaryFileFromLocation(),
            ("ftp://user:" + secret + "@ftp.example/",));
        assertEq("LOCATION-ERROR", ex.err);
        assertMasked(ex.desc);
    }

    connectionManagerTest() {
        HttpClientConnectionManager mgr();
        hash<ExceptionInfo> ex = getException(\mgr.leaseConnection(), ("http://user:" + secret + "@[bad",));
        assertEq("HTTPCLIENT-URL-ERROR", ex.err);
        assertMasked(ex.desc);
        ex = getException(\mgr.leaseConnection(), ("http://user:" + secret + "@/x",));
        assertEq("HTTPCLIENT-URL-ERROR", ex.err);
        assertEq(-1, ex.desc.find(secret), ex.desc);
    }

    rpcTest() {
        string url = sprintf("http://user:%s@127.0.0.1:%d/rpc", secret, port);
        JsonRpcClientIo json(url);
        hash<ExceptionInfo> ex = getException(\json.call(), ("orders.list",));
        assertEq("JSONRPCCLIENTIO-HTTP-ERROR", ex.err);
        assertMasked(ex.desc);
        YamlRpcClientIo yaml(url);
        ex = getException(\yaml.call(), ("orders.list",));
        assertEq("YAMLRPCCLIENTIO-HTTP-ERROR", ex.err);
        assertMasked(ex.desc);
    }

    mcpTest() {
        CredentialMessagesAppender appender();
        McpClient client(sprintf("http://user:%s@127.0.0.1:%d/mcp", secret, closed_port),
            {"logger": getLogger(appender)});
        list<string> messages = appender.getMessages();
        assertEq(1, (select messages, $1 =~ /^McpClient created for URL: http:\/\/user:<masked>@/).size(),
            sprintf("%y", messages));
        assertNoSecret(messages);
        delete client;
    }

    pop3Test() {
        hash<ExceptionInfo> ex = getException(sub () { Pop3Client c("pop3://:" + secret + "@pop.example"); delete c; });
        assertEq("POP3-URL-ERROR", ex.err);
        assertMasked(ex.desc);
    }

    jsonLdTest() {
        HttpJsonLdDocumentLoader loader();
        hash<ExceptionInfo> ex = getException(\loader.loadDocument(), ("ftp://user:" + secret + "@host/doc.jsonld",));
        assertMasked(ex.desc);
    }

    oauth2Test() {
        CredentialMessagesAppender appender();
        hash<ExceptionInfo> ex = getException(sub () {
            RestClient rc({
                "url": sprintf("http://127.0.0.1:%d/api", port),
                "oauth2_grant_type": "client_credentials",
                "oauth2_token_url": sprintf("http://127.0.0.1:%d/token", port),
                "oauth2_client_id": "orders-client",
                "oauth2_client_secret": secret,
                "logger": CredentialMessagesTest::getLogger(appender),
            });
            delete rc;
        });
        list<string> messages = appender.getMessages();
        assertEq(1, (select messages, $1 =~ /^OAuth2: POST to .* failed: /).size(), sprintf("%y", messages));
        assertNoSecret(messages, "the token request is logged without the client secret");
    }

    haltianTest() {
        CredentialMessagesAppender appender();
        hash<ExceptionInfo> ex = getException(sub () {
            EmpathicBuildingRestClient rc({
                "url": sprintf("http://127.0.0.1:%d/", port),
                "username": "facility@example.com",
                "password": secret,
                "logger": CredentialMessagesTest::getLogger(appender),
            });
            delete rc;
        });
        list<string> messages = appender.getMessages();
        assertEq(1, (select messages, $1 =~ /^Haltian: POST to .* failed: /).size(), sprintf("%y", messages));
        assertNoSecret(messages, "the login request is logged without the password");
    }
}
