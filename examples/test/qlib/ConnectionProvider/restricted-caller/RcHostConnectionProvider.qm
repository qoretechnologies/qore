%modern

%requires ConnectionProvider

module RcHostConnectionProvider {
    version = "1.0";
    desc = "a connection provider module of the host, for the restricted-caller tests";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
}

#! the data provider of a test connection; its name is the connection's
class RcHostDataProvider inherits AbstractDataProvider {
    private {
        string name;
    }

    constructor(string name) {
        self.name = name;
    }

    string getName() {
        return name;
    }

    private hash<DataProviderInfo> getStaticInfoImpl() {
        return <DataProviderInfo>{"type": "RcHostDataProvider"};
    }
}

#! a connection of the host, with the host's password in its URL; its clients use no functional domain
class RcHostConnection inherits AbstractConnection {
    constructor() : AbstractConnection({
        "name": "rc-host",
        "desc": "a connection of the host",
        "url": "rchost://hostuser:host-secret@host.invalid",
    }) {
    }

    string getType() {
        return "rchost";
    }

    bool hasDataProvider() {
        return True;
    }

    AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        return new RcHostDataProvider(name);
    }

    final private int getConnectionDomainsImpl() {
        return 0;
    }

    private object getImpl(bool connect = True, *hash<auto> rtopts) {
        return new Mutex();
    }
}

#! the functions of a connection provider module; there is no declaration that it resolves names for the caller
public namespace RcHostConnectionProvider {
    public ConnectionProvider::AbstractConnection sub get_mod_connection(string str) {
        if (str != "rc-host") {
            throw "RC-UNKNOWN", sprintf("unknown connection %y", str);
        }
        return new RcHostConnection();
    }

    public *hash<string, ConnectionProvider::AbstractConnection> sub get_mod_connections() {
        return {"rc-host": new RcHostConnection()};
    }
}
