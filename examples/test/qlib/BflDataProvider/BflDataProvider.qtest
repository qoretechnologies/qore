#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%allow-injection

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Logger
%requires ConnectionProvider
%requires DataProvider
%requires QoreAsyncJobUtils
%requires QoreMediaUtils
%requires BflRestClient
%requires BflDataProvider

%exec-class BflDataProviderTest

class FakeBflClient inherits BflRestClient::BflRestClientIo {
    public {
        list<hash<auto>> calls = ();
    }
    constructor() : BflRestClient::BflRestClientIo(
            {"apikey": "k", "url": "https://api.bfl.ai"}) {
        setSleeper(nothing sub (timeout t) {});
    }
    hash<RestClient::RestResponseInfo> restPost(string path, auto body, *hash<auto> hdr) {
        push calls, {"method": "POST", "path": path, "body": body};
        return <RestClient::RestResponseInfo>{
            "body": {"id": "job-1", "polling_url": "/v1/get_result?id=job-1"},
        };
    }
    hash<RestClient::RestResponseInfo> restGet(string path, *hash<auto> hdr) {
        push calls, {"method": "GET", "path": path};
        return <RestClient::RestResponseInfo>{
            "body": {
                "id":     "job-1",
                "status": "Ready",
                "result": {"sample": "https://cdn.bfl.ai/job-1.jpeg", "seed": 99},
            },
        };
    }
    string getSafeUrl() { return "https://api.bfl.ai"; }
}

public class BflDataProviderTest inherits QUnit::Test {
    public {
        const MyOpts = Opts + {
            "conn": "c,connection=s",
        };

        const OptionColumn = 22;
    }

    private {
        *string conn_name;
    }

    constructor() : Test("BflDataProvider Test", "1.0", \ARGV, MyOpts) {
        conn_name = m_options.conn ?? ENV.BFL_CONNECTION;

        addTestCase("factory + app + action registered", \registrationTest());
        addTestCase("generate-image submits to the right endpoint",
            \endpointTest());
        addTestCase("response surfaces Ready status + sample URL",
            \responseTest());
        addTestCase("unknown model raises BFL-CONFIG-ERROR",
            \unknownModelTest());
        addTestCase("app declares DesignCreative AppGroup",
            \designCreativeTest());

        # Live test requires a real BFL connection.
        # Cost: ~$0.025 per image on `flux-dev` (the cheapest model).
        if (conn_name) {
            addTestCase("live: ping + generate-image (flux-dev)",
                \liveBflTest());
        }
        set_return_value(main());
    }

    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-c,--connection=ARG",
            "set the Black Forest Labs connection name; without it (and "
            "without the BFL_CONNECTION env var) the live test is skipped",
            OptionColumn);
    }

    private registrationTest() {
        DataProvider::AbstractDataProviderFactory f =
            DataProvider::DataProvider::getFactory("bfl");
        assertEq("bfl", f.getInfo().name);

        hash<DataProviderAppInfo> app =
            DataProvider::DataProviderActionCatalog::getApp("BlackForestLabs");
        assertEq("BlackForestLabs", app.name);
        assertEq("bfl", app.scheme);

        # filter out the framework-injected make-api-call action (covered by
        # GenericApiCallAutoInjection.qtest in RestClientDataProvider)
        list<hash<DataProviderActionInfo>> actions = select
            DataProvider::DataProviderActionCatalog::getActions("BlackForestLabs"),
            $1.action != AbstractDataProvider::GenericApiCallActionName;
        assertEq(1, actions.size());
        assertEq("generate-image", actions[0].action);
    }

    private endpointTest() {
        FakeBflClient fake();
        BflDataProvider::BflGenerateImageDataProvider prov(fake);
        prov.doRequest({"prompt": "a sunset", "model": "flux-pro-1.1-ultra"});
        # Submit goes to the ultra endpoint
        hash<auto> submit = fake.calls[0];
        assertEq("/v1/flux-pro-1.1-ultra", submit.path);
        assertEq("a sunset", submit.body.prompt);
        # model is stripped from body (used to select endpoint)
        assertEq(NOTHING, submit.body.model);
    }

    private responseTest() {
        FakeBflClient fake();
        BflDataProvider::BflGenerateImageDataProvider prov(fake);
        auto r = prov.doRequest({"prompt": "x"});
        assertEq("Ready", r.status);
        assertEq("https://cdn.bfl.ai/job-1.jpeg", r.result.sample);
    }

    private unknownModelTest() {
        # The DataProvider framework rejects unknown models via the
        # allowed_values constraint on the model field before doRequest()
        # runs, so the user sees a typed RUNTIME-TYPE-ERROR rather than
        # the deeper BFL-CONFIG-ERROR.  Both shapes indicate the same
        # thing — bad model identifier.
        FakeBflClient fake();
        BflDataProvider::BflGenerateImageDataProvider prov(fake);
        assertThrows("RUNTIME-TYPE-ERROR", sub () {
            prov.doRequest({"prompt": "x", "model": "not-a-real-model-xyz"});
        });
    }

    private designCreativeTest() {
        hash<DataProviderAppInfo> app =
            DataProvider::DataProviderActionCatalog::getApp("BlackForestLabs");
        assertTrue(inlist(DataProvider::AppGroup::AiLlm,          app.groups));
        assertTrue(inlist(DataProvider::AppGroup::DesignCreative, app.groups));
    }

    #! Exercises BFL's live `/v1/flux-dev` submit-then-poll lifecycle
    /** Verifies the actual wire format against BFL's production endpoint —
        including the polling_url header parsing, async poll until `Ready`,
        and CDN-URL response shape.  Cost: ~$0.025 per image on `flux-dev`
        (BFL's cheapest model).
    */
    private liveBflTest() {
        AbstractConnection conn = get_connection(conn_name);
        hash<auto> ping = conn.ping(True);
        assertTrue(ping.ok, sprintf("BFL connection ping failed: %s",
            ping.info ?? "no info"));

        AbstractDataProvider prov = conn.getDataProvider();
        AbstractDataProvider gi = prov.getChildProvider("generate-image");
        auto result = gi.doRequest({
            "prompt":      "a single red apple on a white background",
            "model":       "flux-dev",   # cheapest tier
            "aspect_ratio": "1:1",
        });
        assertEq("Ready", result.status,
            "BFL job reached Ready status");
        assertTrue(result.result.sample.val()
                && result.result.sample =~ /^https?:\/\//,
            "BFL returned a CDN URL");
    }
}
