#!/usr/bin/env qore
# Copyright 2026 Qore Technologies, s.r.o. SPDX-License-Identifier: MIT
%modern
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires BflDataProvider
%requires json
%exec-class BflCatalogTest

class BflCatalogTest inherits QUnit::Test {
    public {
        # Independent reviewed inventory, including the framework generic action.
        const Actions = ("generate-image", "generate-video", "get-routed-result", "wait-for-result",
            "download-result", "make-api-call", "get-finetune", "list-finetunes", "delete-finetune", "get-credits",
            "get-result", "start-flux-pro-1-1", "start-flux-dev", "start-flux-pro-1-1-ultra", "start-fill",
            "start-expand", "start-finetuned-fill", "start-finetuned-ultra", "start-flux-2-flex",
            "start-flux-2-klein-9b", "start-flux-2-klein-9b-preview", "start-flux-2-klein-4b", "start-flux-2-max",
            "start-flux-2-pro-preview", "start-flux-2-pro", "start-video", "start-video-upscale", "start-video-edit",
            "start-outpaint", "start-try-on-v1", "start-try-on-v2", "start-erase", "start-deblur",
            "start-flux-kontext-max", "start-flux-kontext-pro", "report-license-usage", "start-flux-pro",
            "start-lora-4b", "start-lora-9b", "start-lora-9b-kv", "start-lora-9b-kv-bf16",
            "start-lora-base-4b", "start-lora-base-9b");
    }
    constructor() : Test("Black Forest Labs independent catalog", "1.0") {
        addTestCase("complete registration and reachable typed actions", \inventoryTest());
        addTestCase("recursive static presentation and repeated type serialization", \presentationTest());
        addTestCase("qualified discovery rejects a missing action even with no diagnostics", \qualificationTest());
        set_return_value(main());
    }
    private inventoryTest() {
        BflRestClientIo client({"apikey": "offline-catalog", "url": "http://127.0.0.1:1"});
        BflDataProvider::BflDataProvider root({"restclient": client});
        auto generator = root.getChildProvider("generate-image");
        auto legacy = generator.getRequestTypeWithOptions({"model": "flux-pro-1.1"}).getFields();
        auto klein = generator.getRequestTypeWithOptions({"model": "flux-2-klein-4b"}).getFields();
        assertTrue(legacy.hasKey("image_prompt"));
        assertFalse(legacy.hasKey("input_image"));
        assertTrue(klein.hasKey("input_image"));
        assertFalse(klein.hasKey("image_prompt"));
        assertFalse(klein.hasKey("webhook_url"));
        assertEq(64, klein.width.getType().acceptsValue(64));
        for (int pass = 0; pass < 2; ++pass) {
            auto actions = DataProviderActionCatalog::getActionsEx("BlackForestLabs");
            assertEq(sort(Actions), sort(map $1.action, actions));
            assertEq(0, DataProviderActionCatalog::getInitializationFailures(("BlackForestLabs",)).size());
            foreach hash<auto> action in (actions) {
                assertTrue(action.display_name.val().toBool(), action.action);
                assertTrue(action.short_desc.val().toBool() && action.short_desc.size() < 80, action.action);
                assertTrue(action.desc.val().toBool(), action.action);
                assertNothing(action.cls);
                assertTrue(action.output_type instanceof AbstractDataProviderType);
                assertTrue(action.path.val().toBool());
                auto provider = root.getChildProvider(action.path.substr(1));
                assertTrue(provider instanceof AbstractDataProvider, action.path);
                assertTrue(provider.getResponseType() instanceof AbstractDataProviderType);
                assertTrue(action.options.val().toBool() || inlist(action.action, ("get-credits", "list-finetunes")));
            }
        }
    }
    private presentationTest() {
        auto app = DataProviderActionCatalog::getApp("BlackForestLabs");
        auto actions = DataProviderActionCatalog::getActionsEx("BlackForestLabs");
        auto first = DataProviderPresentation::buildSourceCatalogs(app, actions);
        assertTrue(first{"data-provider.QmxhY2tGb3Jlc3RMYWJz"}.locales.root.messages.size() > 1000);
        assertEq(first, DataProviderPresentation::buildSourceCatalogs(app, actions));
        foreach hash<auto> action in (actions) {
            foreach AbstractDataProviderType original in ((action.output_type,) + (map $1.type, action.options.iterator())) {
                AbstractDataProviderType type = original;
                for (int pass = 0; pass < 3; ++pass) {
                    type = Serializable::deserialize(type.serialize());
                    assertEq(sort(keys original.getFields()), sort(keys type.getFields()));
                }
            }
        }
        auto type = BflApi::getActionSet().getOperationEx("get-finetune").getResponseType().getFields().finetune_details.getType();
        auto object = {"value": {"value": "literal"}, "enabled": False, "count": 0};
        assertEq(object, type.acceptsValue(object));
        type = Serializable::deserialize(type.serialize());
        assertEq(object, type.acceptsValue(object));
        auto keyframes = BflApi::getActionSet().getOperationEx("start-video").getRequestFields().keyframes.getType();
        for (int pass = 0; pass < 3; ++pass) {
            keyframes = Serializable::deserialize(keyframes.serialize());
            assertEq((0.0, "https://example.org/image.png"), keyframes.acceptsValue((0.0, "https://example.org/image.png")));
        }
    }
    private qualificationTest() {
        list<hash<DataProviderDiscoveryExpectedIdentityInfo>> expected = (<DataProviderDiscoveryExpectedIdentityInfo>{"app": "BlackForestLabs"},)
            + (map <DataProviderDiscoveryExpectedIdentityInfo>{"app": "BlackForestLabs", "action": $1}, Actions);
        auto session = DataProviderActionCatalog::beginDiscovery(expected, ("BlackForestLabs",));
        DataProviderActionCatalog::collectDiscoveryExpectedInventory(session);
        auto qualified = DataProviderActionCatalog::sealDiscovery(session);
        assertTrue(qualified.getReport().complete);
        assertEq(0, qualified.getReport().failures.size());
        DataProviderActionCatalog::discardQualifiedDiscovery(qualified);
        session = DataProviderActionCatalog::beginDiscovery(expected + <DataProviderDiscoveryExpectedIdentityInfo>{
            "app": "BlackForestLabs", "action": "deliberately-missing"}, ("BlackForestLabs",));
        assertThrows("DATA-PROVIDER-DISCOVERY-ERROR", sub () { DataProviderActionCatalog::sealDiscovery(session); });
    }
}
