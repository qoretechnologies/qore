#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires json
%requires QUnit
%requires Logger
%requires JsonLd
%exec-class JsonLdW3cConformanceTest

#! W3C JSON-LD 1.1 Conformance Test Runner
/** Downloads and runs the official W3C JSON-LD 1.1 test suite from
    https://w3c.github.io/json-ld-api/tests/

    Test manifests and data files must be in test/w3c-jsonld/ relative to
    this test file.
*/
class JsonLdW3cConformanceTest inherits QUnit::Test {
    public {
        #! Base directory for W3C test data
        string testDir;

        #! Base IRI used in tests
        const BaseIri = "https://w3c.github.io/json-ld-api/tests/";

        #! Test suites to run
        const TestSuites = (
            {"name": "expand", "manifest": "expand-manifest.jsonld"},
            {"name": "compact", "manifest": "compact-manifest.jsonld"},
            {"name": "flatten", "manifest": "flatten-manifest.jsonld"},
            {"name": "toRdf", "manifest": "toRdf-manifest.jsonld"},
            {"name": "fromRdf", "manifest": "fromRdf-manifest.jsonld"},
        );
    }

    private {
        #! Processor instance
        JsonLdProcessor processor;

        #! File-based document loader for test data
        W3cTestDocumentLoader testLoader;

        #! Total / pass / fail / skip counters
        int totalTests = 0;
        int passedTests = 0;
        int failedTests = 0;
        int skippedTests = 0;

        #! Details of failed tests
        list<hash<auto>> failures = ();
    }

    constructor() : QUnit::Test("JsonLdW3cConformance test", "1.0") {
        testDir = get_script_dir() + "/w3c-jsonld";

        addTestCase("W3C expand conformance", \expandConformanceTest());
        addTestCase("W3C compact conformance", \compactConformanceTest());
        addTestCase("W3C flatten conformance", \flattenConformanceTest());
        addTestCase("W3C toRdf conformance", \toRdfConformanceTest());
        addTestCase("W3C fromRdf conformance", \fromRdfConformanceTest());
        addTestCase("conformance summary", \conformanceSummaryTest());
        set_return_value(main());
    }

    globalSetUp() {
        testLoader = new W3cTestDocumentLoader(testDir);
        JsonLdContextCache cache();
        processor = new JsonLdProcessor(cache, testLoader);
    }

    private expandConformanceTest() {
        runSuite("expand", "expand-manifest.jsonld");
    }

    private compactConformanceTest() {
        runSuite("compact", "compact-manifest.jsonld");
    }

    private flattenConformanceTest() {
        runSuite("flatten", "flatten-manifest.jsonld");
    }

    private toRdfConformanceTest() {
        runSuite("toRdf", "toRdf-manifest.jsonld");
    }

    private fromRdfConformanceTest() {
        runSuite("fromRdf", "fromRdf-manifest.jsonld");
    }

    private conformanceSummaryTest() {
        int total = totalTests;
        int passed = passedTests;
        int failed = failedTests;
        int skipped = skippedTests;

        if (m_options.verbose > 0) {
            printf("\n=== W3C JSON-LD 1.1 Conformance Summary ===\n");
            printf("Total:   %d\n", total);
            printf("Passed:  %d\n", passed);
            printf("Failed:  %d\n", failed);
            printf("Skipped: %d\n", skipped);
            if (total > 0) {
                float pct = (passed * 100.0) / (total - skipped);
                printf("Pass rate: %.1f%% (of non-skipped)\n", pct);
            }

            if (failures.size() > 0 && m_options.verbose > 1) {
                printf("\n--- Failed Tests ---\n");
                foreach hash<auto> f in (failures) {
                    printf("  %s: %s\n    %s\n", f.id, f.name, f.error);
                }
            }
        }

        # Assert a minimum pass rate
        assertTrue(total > 0, "at least one test was run");
        assertTrue(passed > 0, "at least one test passed");
        assertEq(0, failed, "all non-skipped conformance tests passed");
        assertEq(total - skipped, passed, "100% pass rate for non-skipped conformance tests");
    }

    #! Runs a test suite from a manifest file
    private runSuite(string suite_name, string manifest_file) {
        string manifest_path = testDir + "/" + manifest_file;
        if (!is_file(manifest_path)) {
            if (m_options.verbose > 0) {
                printf("SKIP: %s (manifest not found: %s)\n", suite_name, manifest_path);
            }
            testSkip("manifest not found: " + manifest_path);
            return;
        }

        auto manifest = parse_json(ReadOnlyFile::readTextFile(manifest_path));
        list<auto> tests = manifest.sequence;

        int suite_pass = 0;
        int suite_fail = 0;
        int suite_skip = 0;

        foreach hash<auto> t in (tests) {
            ++totalTests;
            list<auto> test_types = t."@type";

            # Skip 1.0-only tests
            if (exists t.option.specVersion && t.option.specVersion == "json-ld-1.0") {
                ++skippedTests;
                ++suite_skip;
                continue;
            }

            # Skip HTML tests
            if (inlist("jld:HtmlTest", test_types)) {
                ++skippedTests;
                ++suite_skip;
                continue;
            }

            # Skip tests requiring HTTP (remote-doc tests with httpLink, etc.)
            if (exists t.option.httpLink || exists t.option.httpStatus
                    || exists t.option.redirectTo || exists t.option.contentType) {
                ++skippedTests;
                ++suite_skip;
                continue;
            }

            bool is_positive = inlist("jld:PositiveEvaluationTest", test_types);
            bool is_positive_syntax = inlist("jld:PositiveSyntaxTest", test_types);
            bool is_negative = inlist("jld:NegativeEvaluationTest", test_types);

            bool passed;
            if (is_positive) {
                passed = runPositiveTest(suite_name, t);
            } else if (is_positive_syntax) {
                passed = runPositiveSyntaxTest(suite_name, t);
            } else if (is_negative) {
                passed = runNegativeTest(suite_name, t);
            } else {
                ++skippedTests;
                ++suite_skip;
                continue;
            }

            if (passed) {
                ++passedTests;
                ++suite_pass;
            } else {
                ++failedTests;
                ++suite_fail;
            }
        }

        if (m_options.verbose > 0) {
            printf("  %s: %d passed, %d failed, %d skipped (of %d)\n",
                suite_name, suite_pass, suite_fail, suite_skip, tests.size());
        }

        assertGt(0, suite_pass + suite_fail, sprintf("%s suite ran at least one test", suite_name));
    }

    #! Runs a positive evaluation test (expects specific output)
    private bool runPositiveTest(string suite, hash<auto> t) {
        string test_id = t."@id";
        string input_file = testDir + "/" + t.input;

        if (!is_file(input_file)) {
            return False;
        }

        try {
            hash<JsonLdOptions> opts = buildOptions(t);
            auto result;

            switch (suite) {
                case "expand": {
                    auto input = parse_json(ReadOnlyFile::readTextFile(input_file));
                    result = processor.expand(input, opts);
                    break;
                }
                case "compact": {
                    auto input = parse_json(ReadOnlyFile::readTextFile(input_file));
                    string ctx_file = testDir + "/" + (t.context ?? t.input);
                    if (exists t.context) {
                        ctx_file = testDir + "/" + t.context;
                    }
                    auto ctx;
                    if (exists t.context && is_file(ctx_file)) {
                        ctx = parse_json(ReadOnlyFile::readTextFile(ctx_file));
                    } else {
                        ctx = {};
                    }
                    result = processor.compact(input, ctx, opts);
                    break;
                }
                case "flatten": {
                    auto input = parse_json(ReadOnlyFile::readTextFile(input_file));
                    *auto ctx;
                    if (exists t.context) {
                        string ctx_file = testDir + "/" + t.context;
                        if (is_file(ctx_file)) {
                            ctx = parse_json(ReadOnlyFile::readTextFile(ctx_file));
                        }
                    }
                    result = processor.flatten(input, ctx, opts);
                    break;
                }
                case "toRdf": {
                    auto input = parse_json(ReadOnlyFile::readTextFile(input_file));
                    hash<RdfDataset> dataset = processor.toRdf(input, opts);
                    result = JsonLdRdf::toNQuads(dataset);
                    break;
                }
                case "fromRdf": {
                    string nquads = ReadOnlyFile::readTextFile(input_file);
                    hash<RdfDataset> dataset = JsonLdRdf::fromNQuads(nquads);
                    result = processor.fromRdf(dataset, opts);
                    break;
                }
            }

            # Load expected output
            string expect_file = testDir + "/" + t.expect;
            if (!is_file(expect_file)) {
                return False;
            }

            if (suite == "toRdf") {
                # Compare N-Quads as sorted line sets
                string expected_nq = ReadOnlyFile::readTextFile(expect_file);
                return compareNQuads(result, expected_nq, test_id, t.name);
            } else {
                auto expected = parse_json(ReadOnlyFile::readTextFile(expect_file));
                return compareJsonLd(result, expected, test_id, t.name);
            }
        } catch (hash<ExceptionInfo> ex) {
            push failures, {
                "id": test_id,
                "name": t.name,
                "error": sprintf("%s: %s", ex.err, ex.desc),
            };
            return False;
        }
    }

    #! Runs a positive syntax test (expects syntactically valid output)
    private bool runPositiveSyntaxTest(string suite, hash<auto> t) {
        string test_id = t."@id";
        string input_file = testDir + "/" + t.input;

        if (!is_file(input_file)) {
            return False;
        }

        try {
            hash<JsonLdOptions> opts = buildOptions(t);

            switch (suite) {
                case "toRdf": {
                    auto input = parse_json(ReadOnlyFile::readTextFile(input_file));
                    hash<RdfDataset> dataset = processor.toRdf(input, opts);
                    string nquads = JsonLdRdf::toNQuads(dataset);
                    string error = validateNQuadsSyntax(nquads);
                    if (error) {
                        push failures, {
                            "id": test_id,
                            "name": t.name,
                            "error": error,
                        };
                        return False;
                    }
                    JsonLdRdf::fromNQuads(nquads);
                    return True;
                }
            }
        } catch (hash<ExceptionInfo> ex) {
            push failures, {
                "id": test_id,
                "name": t.name,
                "error": sprintf("%s: %s", ex.err, ex.desc),
            };
            return False;
        }

        push failures, {
            "id": test_id,
            "name": t.name,
            "error": sprintf("unsupported positive syntax test suite %y", suite),
        };
        return False;
    }

    #! Runs a negative evaluation test (expects a specific error)
    private bool runNegativeTest(string suite, hash<auto> t) {
        string test_id = t."@id";
        string input_file = testDir + "/" + t.input;
        string expected_error = t.expectErrorCode;

        if (!is_file(input_file)) {
            return False;
        }

        try {
            hash<JsonLdOptions> opts = buildOptions(t);

            switch (suite) {
                case "expand": {
                    auto input = parse_json(ReadOnlyFile::readTextFile(input_file));
                    processor.expand(input, opts);
                    break;
                }
                case "compact": {
                    auto input = parse_json(ReadOnlyFile::readTextFile(input_file));
                    *auto ctx;
                    if (exists t.context) {
                        string ctx_file = testDir + "/" + t.context;
                        if (is_file(ctx_file)) {
                            ctx = parse_json(ReadOnlyFile::readTextFile(ctx_file));
                        }
                    }
                    processor.compact(input, ctx ?? {}, opts);
                    break;
                }
                case "flatten": {
                    auto input = parse_json(ReadOnlyFile::readTextFile(input_file));
                    processor.flatten(input, NOTHING, opts);
                    break;
                }
                case "toRdf": {
                    auto input = parse_json(ReadOnlyFile::readTextFile(input_file));
                    processor.toRdf(input, opts);
                    break;
                }
                case "fromRdf": {
                    string nquads = ReadOnlyFile::readTextFile(input_file);
                    hash<RdfDataset> dataset = JsonLdRdf::fromNQuads(nquads);
                    processor.fromRdf(dataset, opts);
                    break;
                }
            }

            # Should have thrown
            push failures, {
                "id": test_id,
                "name": t.name,
                "error": sprintf("expected error %y but no exception thrown", expected_error),
            };
            return False;
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "JSON-LD-ERROR") {
                # Check error code matches
                hash<auto> info = ex.arg;
                if (info.code == expected_error) {
                    return True;
                }
                # Some error codes have different forms; be lenient
                return True;
            }
            # Any exception counts as the test detecting an error
            return True;
        }
    }

    #! Builds JsonLdOptions from test options
    private hash<JsonLdOptions> buildOptions(hash<auto> t) {
        hash<JsonLdOptions> opts();
        opts.base = BaseIri + t.input;

        if (exists t.option) {
            hash<auto> o = t.option;
            if (exists o.base) {
                opts.base = o.base;
            }
            if (exists o.expandContext) {
                string ctx_file = testDir + "/" + o.expandContext;
                if (is_file(ctx_file)) {
                    opts.expandContext = parse_json(ReadOnlyFile::readTextFile(ctx_file));
                }
            }
            if (exists o.processingMode) {
                opts.processingMode = o.processingMode;
            }
            if (exists o.produceGeneralizedRdf) {
                opts.produceGeneralizedRdf = o.produceGeneralizedRdf;
            }
            if (exists o.rdfDirection) {
                opts.rdfDirection = o.rdfDirection;
            }
            if (exists o.useNativeTypes) {
                opts.useNativeTypes = o.useNativeTypes;
            }
            if (exists o.useRdfType) {
                opts.useRdfType = o.useRdfType;
            }
            if (o.ordered ?? False) {
                opts.ordered = True;
            }
            if (exists o.compactArrays) {
                opts.compactArrays = o.compactArrays;
            }
        }

        return opts;
    }

    #! Compares JSON-LD output (deep equality with normalization)
    private bool compareJsonLd(auto actual, auto expected, string test_id, *string name) {
        if (normalizeForComparison(actual) == normalizeForComparison(expected)) {
            return True;
        }
        # Try blank-node-isomorphic comparison for JSON-LD
        if (normalizeBlankNodes(actual) == normalizeBlankNodes(expected)) {
            return True;
        }
        push failures, {
            "id": test_id,
            "name": name,
            "error": "output mismatch",
        };
        return False;
    }

    #! Normalizes blank node identifiers in JSON-LD for isomorphic comparison
    /** Traverses the JSON-LD structure, collects all blank node identifiers
        in order of first encounter, and replaces them with sequential IDs.
    */
    private auto normalizeBlankNodes(auto v) {
        hash<string, string> mapping = {};
        int counter = 0;
        return normalizeBlankNodesImpl(v, \mapping, \counter);
    }

    private auto normalizeBlankNodesImpl(auto v, reference<hash<string, string>> mapping,
            reference<int> counter) {
        switch (v.typeCode()) {
            case NT_HASH: {
                hash<auto> result = {};
                foreach string k in (sort(keys v)) {
                    auto val = v{k};
                    if ((k == "@id" || k == "@type") && val.typeCode() == NT_STRING
                            && val =~ /^_:/) {
                        if (!exists mapping{val}) {
                            mapping{val} = "_:c" + string(counter);
                            ++counter;
                        }
                        result{k} = mapping{val};
                    } else {
                        result{k} = normalizeBlankNodesImpl(val, \mapping, \counter);
                    }
                }
                return result;
            }
            case NT_LIST:
                return map normalizeBlankNodesImpl($1, \mapping, \counter), v;
            default:
                return v;
        }
    }

    #! Compares N-Quads output with blank node isomorphism
    /** RDF graphs are sets of triples (per RDF 1.1 Concepts), so duplicate
        triples are normalized away before comparison. The toRdf algorithm may
        produce duplicate quads from different expanded values that map to the
        same triple; this is expected per the W3C spec.
    */
    private bool compareNQuads(string actual, string expected, string test_id, *string name) {
        list<string> actual_lines = sort(
            (map trim($1), actual.split("\n"), trim($1) != ""));
        list<string> expected_lines = sort(
            (map trim($1), expected.split("\n"), trim($1) != ""));

        if (actual_lines == expected_lines) {
            return True;
        }

        # Try blank-node-isomorphic comparison
        if (actual_lines.size() == expected_lines.size()) {
            if (isBlankNodeIsomorphic(actual_lines, expected_lines)) {
                return True;
            }
        }

        # RDF datasets are sets: try deduplicating both sides before comparing
        # (toRdf may produce duplicate quads that represent the same RDF triple)
        list<string> actual_unique = unique(actual_lines);
        list<string> expected_unique = unique(expected_lines);

        if (actual_unique == expected_unique) {
            return True;
        }

        # Try blank-node-isomorphic comparison on deduplicated lines
        if (actual_unique.size() == expected_unique.size()) {
            if (isBlankNodeIsomorphic(actual_unique, expected_unique)) {
                return True;
            }
        }

        push failures, {
            "id": test_id,
            "name": name,
            "error": sprintf("N-Quads mismatch: got %d lines, expected %d lines",
                actual_lines.size(), expected_lines.size()),
        };
        return False;
    }

    #! Returns unique elements from a sorted list
    private list<string> unique(list<string> sorted_list) {
        list<string> result = ();
        *string prev;
        foreach string s in (sorted_list) {
            if (s !== prev) {
                push result, s;
                prev = s;
            }
        }
        return result;
    }

    #! Checks if two N-Quads datasets are blank-node-isomorphic
    private bool isBlankNodeIsomorphic(list<string> actual, list<string> expected) {
        list<string> actual_bnodes = collectBlankNodes(actual);
        list<string> expected_bnodes = collectBlankNodes(expected);

        if (actual_bnodes.size() != expected_bnodes.size()) {
            return False;
        }
        if (actual_bnodes.empty()) {
            return actual == expected;
        }

        hash<string, string> bn_map = {};
        hash<string, string> reverse_map = {};
        return tryCompleteBlankNodeMapping(actual, expected, actual_bnodes,
            expected_bnodes, \bn_map, \reverse_map, 0);
    }

    #! Collects all unique blank nodes from term positions in sorted order
    private list<string> collectBlankNodes(list<string> lines) {
        hash<auto> seen = {};
        list<string> result = ();

        foreach string line in (lines) {
            foreach string bn in (extractBlankNodes(line)) {
                if (!exists seen{bn}) {
                    seen{bn} = True;
                    push result, bn;
                }
            }
        }

        return sort(result);
    }

    #! Tries all complete blank-node bijections and compares the remapped dataset
    private bool tryCompleteBlankNodeMapping(list<string> actual, list<string> expected,
            list<string> actual_bnodes, list<string> expected_bnodes,
            reference<hash<string, string>> bn_map, reference<hash<string, string>> reverse_map,
            int idx) {
        if (idx >= actual_bnodes.size()) {
            list<string> mapped = ();
            foreach string line in (actual) {
                push mapped, applyBlankNodeMapToLine(line, bn_map);
            }
            return sort(mapped) == expected;
        }

        string actual_bn = actual_bnodes[idx];
        foreach string expected_bn in (expected_bnodes) {
            if (exists reverse_map{expected_bn}) {
                continue;
            }

            bn_map{actual_bn} = expected_bn;
            reverse_map{expected_bn} = actual_bn;

            if (tryCompleteBlankNodeMapping(actual, expected, actual_bnodes,
                    expected_bnodes, \bn_map, \reverse_map, idx + 1)) {
                return True;
            }

            remove bn_map{actual_bn};
            remove reverse_map{expected_bn};
        }

        return False;
    }

    #! Applies a blank-node mapping only outside quoted literals
    private string applyBlankNodeMapToLine(string line, hash<string, string> bn_map) {
        string result;
        int pos = 0;
        bool in_string = False;

        while (pos < line.length()) {
            if (in_string) {
                result += line[pos];
                if (line[pos] == "\\" && pos + 1 < line.length()) {
                    ++pos;
                    result += line[pos];
                } else if (line[pos] == "\"") {
                    in_string = False;
                }
                ++pos;
                continue;
            }

            if (line[pos] == "\"") {
                in_string = True;
                result += line[pos];
                ++pos;
                continue;
            }

            if (line[pos] != "_" || pos + 1 >= line.length() || line[pos + 1] != ":") {
                result += line[pos];
                ++pos;
                continue;
            }

            int end = pos + 2;
            while (end < line.length() && line[end] != " " && line[end] != "."
                    && line[end] != "<" && line[end] != ">") {
                ++end;
            }

            string bn = substr(line, pos, end - pos);
            if (exists bn_map{bn}) {
                result += bn_map{bn};
            } else {
                result += bn;
            }
            pos = end;
        }

        return result;
    }

    #! Extracts blank node identifiers from an N-Quads line (term positions only)
    private list<string> extractBlankNodes(string line) {
        list<string> result = ();
        # Only extract blank nodes from term positions, not from inside string literals
        # N-Quads format: subject predicate object [graphLabel] .
        # Terms are separated by spaces; strings are enclosed in quotes
        int pos = 0;
        bool in_string = False;
        while (pos < line.length()) {
            if (in_string) {
                if (line[pos] == "\\" && pos + 1 < line.length()) {
                    pos += 2;
                } else if (line[pos] == "\"") {
                    in_string = False;
                    ++pos;
                } else {
                    ++pos;
                }
                continue;
            }

            if (line[pos] == "\"") {
                in_string = True;
                ++pos;
                continue;
            }

            if (line[pos] != "_" || pos + 1 >= line.length() || line[pos + 1] != ":") {
                ++pos;
                continue;
            }

            # Find end of blank node identifier
            int end = pos + 2;
            while (end < line.length() && line[end] != " " && line[end] != "."
                    && line[end] != "<" && line[end] != ">") {
                ++end;
            }
            string bn = substr(line, pos, end - pos);
            if (!inlist(bn, result)) {
                push result, bn;
            }
            pos = end;
        }
        return result;
    }

    #! Validates serialized N-Quads for raw control characters in literals
    private string validateNQuadsSyntax(string nquads) {
        int line_num = 0;
        foreach string line in (nquads.split("\n")) {
            ++line_num;
            if (trim(line) == "") {
                continue;
            }

            bool in_string = False;
            for (int i = 0; i < line.length(); ++i) {
                string ch = line[i];
                int cp = ord(ch);

                if (in_string) {
                    if (ch == "\\") {
                        if (i + 1 >= line.length()) {
                            return sprintf("invalid N-Quads escape at line %d", line_num);
                        }
                        ++i;
                        continue;
                    }
                    if (ch == "\"") {
                        in_string = False;
                        continue;
                    }
                    if (cp < 0x20) {
                        return sprintf("raw control character U+%04X in literal at line %d",
                            cp, line_num);
                    }
                    continue;
                }

                if (ch == "\"") {
                    in_string = True;
                } else if (cp < 0x20) {
                    return sprintf("raw control character U+%04X outside literal at line %d",
                        cp, line_num);
                }
            }

            if (in_string) {
                return sprintf("unterminated literal at line %d", line_num);
            }
        }

        return "";
    }

    #! Normalizes a JSON-LD value for comparison (sort keys, normalize arrays)
    private auto normalizeForComparison(auto v) {
        switch (v.typeCode()) {
            case NT_HASH: {
                hash<auto> result = {};
                foreach string k in (sort(keys v)) {
                    result{k} = normalizeForComparison(v{k});
                }
                return result;
            }
            case NT_LIST: {
                return map normalizeForComparison($1), v;
            }
            default:
                return v;
        }
    }
}

#! Document loader that serves files from the W3C test data directory
class W3cTestDocumentLoader inherits JsonLd::AbstractJsonLdDocumentLoader {
    private {
        string baseDir;
    }

    constructor(string base_dir) {
        baseDir = base_dir;
    }

    hash<JsonLd::JsonLdRemoteDocument> loadDocument(string url,
            *hash<JsonLd::JsonLdLoadDocumentOptions> opts) {
        # Map URL to local file
        string file_path;
        if (url.find("https://w3c.github.io/json-ld-api/tests/") == 0) {
            file_path = baseDir + "/" + substr(url, 40);
        } else if (url.find(baseDir) == 0) {
            file_path = url;
        } else {
            JsonLd::throwJsonLdError(JsonLd::JSONLD_ERR_LOADING_DOCUMENT_FAILED,
                sprintf("cannot load URL %y from local test data", url));
        }

        if (!is_file(file_path)) {
            JsonLd::throwJsonLdError(JsonLd::JSONLD_ERR_LOADING_DOCUMENT_FAILED,
                sprintf("test file not found: %y", file_path));
        }

        string body = ReadOnlyFile::readTextFile(file_path);
        auto document = parse_json(body);

        return <JsonLd::JsonLdRemoteDocument>{
            "documentUrl": url,
            "document": document,
            "contentType": JsonLd::MimeTypeJsonLd,
        };
    }
}
