#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%allow-injection

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Logger
%requires DataProvider
%requires ConnectionProvider
%requires RestClient
%requires RestClientIo
%requires GoogleRestClient
%requires GoogleDataProvider
%requires GmailDataProvider

%exec-class GmailDataProviderTest

#! Gmail watch provider exposing its cursor for deterministic persistence tests
class TestGmailMessageWatchDataProvider inherits GmailMessageWatchDataProvider {
    constructor(GoogleRestClient::GoogleRestClientIo rest, *hash<auto> options)
            : GmailMessageWatchDataProvider(rest, options) {
    }

    int getPollEpoch() { return poll_epoch; }
    list<string> getLastMessageIds() { return keys last_msg; }
    advance(int epoch, string message_id) { commitCheckpoint(epoch, message_id); }
}

public class GmailDataProviderTest inherits QUnit::Test {
    private {
        GmailBaseDataProvider gdp;

        # command-line options
        const MyOpts = Opts + {
            "conn": "c,connection=s",
        };

        const OptionColumn = 22;
    }

    constructor() : Test("GmailDataProviderTest Test", "1.0", \ARGV, MyOpts) {
        addTestCase("gmail test", \gmailTest());
        addTestCase("gmail watch poll interval from data context", \gmailWatchPollIntervalFromDataContextTest());
        addTestCase("gmail watch poll interval default", \gmailWatchPollIntervalDefaultTest());
        addTestCase("gmail message clearing actions", \gmailMessageClearingActionTest());
        addTestCase("gmail attachment events address their source message",
            \gmailAttachmentEventSourceMessageTest());
        addTestCase("gmail watch checkpoint semantics", \gmailWatchCheckpointTest());

        try {
            setupConnection();
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose > 2) {
                printf("%s\n", get_exception_string(ex));
            } else if (m_options.verbose) {
                printf("%s: %s\n", ex.err, ex.desc);
            }
        }

        # Return for compatibility with test harness that checks return value.
        set_return_value(main());
    }

    gmailTest() {
        if (!gdp) {
            testSkip("no connection");
        }

        assertEq("gmail", gdp.getName());
    }

    gmailWatchPollIntervalFromDataContextTest() {
        hash<auto!> opts = {
            "api_profile": "gmail",
            "url": "https://example.com",
            "oauth2_client_id": "test",
            "oauth2_client_secret": "test",
            "oauth2_redirect_url": "https://localhost",
            "token": "test",
        };
        GoogleRestClientIo rest(opts);
        {
            DataProviderDataContextHelper dc({
                "poll_interval": 30,
            });
            GmailMessageWatchDataProvider provider = new GmailMessageWatchDataProvider(rest, (
                "q": "in:inbox",
            ));
            assertEq(30, provider.getPollIntervalSeconds());
        }
    }

    gmailWatchPollIntervalDefaultTest() {
        hash<auto!> opts = {
            "api_profile": "gmail",
            "url": "https://example.com",
            "oauth2_client_id": "test",
            "oauth2_client_secret": "test",
            "oauth2_redirect_url": "https://localhost",
            "token": "test",
        };
        GoogleRestClientIo rest(opts);
        GmailMessageWatchDataProvider provider = new GmailMessageWatchDataProvider(rest, (
            "q": "in:inbox",
        ));
        assertEq(120, provider.getPollIntervalSeconds());
    }

    #! A consumer must be able to clear a source message once it has processed it
    /** Deleting from the watch itself destroys the message as soon as its event is raised, whether or not
        the consumer went on to succeed, so a safe pattern needs first-class actions that take the message
        ID the event carries.
    */
    gmailMessageClearingActionTest() {
        hash<DataProviderActionInfo> trash = DataProviderActionCatalog::getAppAction(
            GmailDataProvider::AppName, "trash-message"
        );
        assertEq("/messages/trash", trash.path);
        assertEq(DPAT_API, trash.action_code);
        assertEq(True, trash.options.hasKey("id"), "the trash action takes a message ID");
        assertTrue(trash.options.id.required, "the message ID is required");

        hash<DataProviderActionInfo> del = DataProviderActionCatalog::getAppAction(
            GmailDataProvider::AppName, "delete-message"
        );
        assertEq("/messages/delete", del.path);
        assertEq(DPAT_API, del.action_code);
        assertEq(True, del.options.hasKey("id"), "the delete action takes a message ID");
        assertTrue(del.options.id.required, "the message ID is required");
        # the Gmail API returns no content for a permanent delete
        assertEq(NOTHING, del.get_output_type);

        # the watch options must say that their deletion is not gated on consumer success
        hash<DataProviderActionInfo> watch = DataProviderActionCatalog::getAppAction(
            GmailDataProvider::AppName, "watch"
        );
        assertTrue(watch.options.delete_messages.desc.find("consumer") >= 0,
            "the watch deletion option describes what happens to a failing consumer");
        hash<DataProviderActionInfo> watch_att = DataProviderActionCatalog::getAppAction(
            GmailDataProvider::AppName, "watch-attachment"
        );
        assertTrue(watch_att.options.delete_messages.desc.find("consumer") >= 0,
            "the attachment watch deletion option describes the same");
    }

    #! Every attachment event must identify the message it came from
    gmailAttachmentEventSourceMessageTest() {
        assertTrue(GmailAttachmentEventDataType.getFields().hasKey("message_id"),
            "an attachment event declares the ID of its source message");
        assertEq("*string", GmailAttachmentEventDataType.getFields().message_id.getType().getName(),
            "the source message ID is optional so a future producer cannot break the watch loop");
    }

    gmailWatchCheckpointTest() {
        hash<auto!> opts = {
            "api_profile": "gmail",
            "url": "https://example.com",
            "oauth2_client_id": "test",
            "oauth2_client_secret": "test",
            "oauth2_redirect_url": "https://localhost",
            "token": "test",
        };
        GoogleRestClientIo rest(opts);
        TestGmailMessageWatchDataProvider provider(rest, ("q": "in:inbox"));

        hash<auto> saved;
        provider.setCheckpointPersistence({
            "version": 1,
            "poll_epoch": 100,
            "last_message_ids": ("a", "b"),
        }, sub (hash<auto> checkpoint) {
            saved = checkpoint;
        });
        assertEq(100, provider.getPollEpoch(), "Gmail epoch restored");
        assertEq(("a", "b"), sort(provider.getLastMessageIds()), "same-second message IDs restored");

        provider.advance(101, "c");
        assertEq(101, saved.poll_epoch, "advanced Gmail epoch persisted");
        assertEq(1, saved.version, "Gmail checkpoint format version persisted");
        assertEq(("c",), saved.last_message_ids, "message IDs reset for a newer second");

        TestGmailMessageWatchDataProvider failing(rest, ("q": "in:inbox"));
        failing.setCheckpointPersistence({
            "version": 1,
            "poll_epoch": 200,
            "last_message_ids": (),
        }, sub (hash<auto> checkpoint) {
            throw "TEST-PERSISTENCE-ERROR", "checkpoint was not stored";
        });
        assertThrows("TEST-PERSISTENCE-ERROR", sub () {
            failing.advance(201, "x");
        });
        assertEq(200, failing.getPollEpoch(), "failed persistence does not advance the in-memory cursor");
        assertEq((), failing.getLastMessageIds(),
            "failed persistence does not change the IDs at a newer checkpoint second");
        assertThrows("TEST-PERSISTENCE-ERROR", sub () {
            failing.advance(200, "x");
        });
        assertEq((), failing.getLastMessageIds(),
            "failed persistence does not change the IDs at the current checkpoint second");

        TestGmailMessageWatchDataProvider invalid(rest, ("q": "in:inbox"));
        assertThrows("WATCH-CHECKPOINT-ERROR", sub () {
            invalid.setCheckpointPersistence({
                "version": 1,
                "poll_epoch": -1,
                "last_message_ids": (),
            }, sub (hash<auto> checkpoint) {
                # no-op
            });
        });
        assertThrows("WATCH-CHECKPOINT-ERROR", sub () {
            provider.advance(-1, "x");
        });
        assertThrows("WATCH-CHECKPOINT-ERROR", sub () {
            provider.advance(102, "");
        });
    }

    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-c,--connection=ARG", "set connection name", OptionColumn);
    }

    private error(string fmt) {
        throw "OPTION-ERROR", sprintf("%s: ERROR: %s", get_script_name(), vsprintf(fmt, argv));
    }

    private setupConnection() {
        *string conn_name = m_options.conn ?? ENV.GMAIL_CONNECTION;
        if (!conn_name.val()) {
            return;
        }

        AbstractConnection conn = get_connection(conn_name);
        if (!(conn instanceof GmailRestConnection)) {
            error("connection %y is type %y; expecting \"GmailRestConnection\"", conn_name, conn.className());
        }
        gdp = conn.getDataProvider();
    }
}
