#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit

%exec-class SSLTest

public class SSLTest inherits QUnit::Test {
    private {
        const cert_pem = "-----BEGIN CERTIFICATE-----
