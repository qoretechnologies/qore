xV32Q8020wjuFTOsOA==
-----END CERTIFICATE-----";

        # certificate signature (literal binary value); the certificate is valid until 2126 (see
        # test-certificate-expiry.qtest)
        const cert_sig = <>;

        const key_pem = "-----BEGIN RSA PRIVATE KEY-----
Proc-Type: 4,ENCRYPTED
DEK-Info: BF-CBC,C73CE02812F598E4

TTpTQq7DR2GUFrpjMVh1QzQDNp2lut/tEJlcPlX0qo7JxS8vm3N4+9Wmq3GCGdGZ
