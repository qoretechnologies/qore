#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-platform: macos - binds of the paired QUIC/UDP listener of an HTTP/3 listener and their system errors

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires Logger
%requires HttpServerUtil
%requires HttpServer
%requires ../../TestCertificates.qm

%exec-class HttpServerH3BindFailureTest

#! A server whose paired QUIC listeners fail to bind a given number of times (qore#7420)
class FailingQuicServer inherits HttpServer {
    public {
        #! the number of binds of paired QUIC listeners that fail before they succeed
        int fails;
        #! the system error number of the failures
        *int err_no;
        #! fails the first bind after a real bind succeeded, with \a err_no, and no other
        bool fail_after_bound;
        #! the number of binds of paired QUIC listeners so far
        int binds;
        #! the ports of the QUIC binds tried
        list<int> ports = ();
        #! the ports of the real binds that failed because the port was in use, such as by another test (qore#7743)
        list<int> in_use_ports = ();
        #! the next real bind finds its port held by a UDP socket of the test
        bool hold_next;
    }

    private {
        #! a real bind succeeded
        bool bound;
    }

    constructor(hash<HttpServerOptionInfo> opts, int fails, *int err_no = EADDRINUSE) : HttpServer(opts) {
        self.fails = fails;
        self.err_no = err_no;
    }

    hash<auto> addQuicListener(hash<HttpListenerOptionInfo> opts, int port = 0) {
        push ports, port;
        ++binds;
        if (fail_after_bound) {
            if (bound) {
                fail_after_bound = False;
                throw "SOCKET-BIND-ERROR", sprintf("forced failure of the bind on UDP port %d", port), err_no;
            }
            return realBind(opts, port);
        }
        if (fails > 0) {
            --fails;
            # the error of a bind, with its system error number as a bind gives it
            throw "SOCKET-BIND-ERROR", sprintf("forced failure of the bind on UDP port %d", port), err_no;
        }
        return realBind(opts, port);
    }

    #! Binds the QUIC listener; records the port if it is in use
    private hash<auto> realBind(hash<HttpListenerOptionInfo> opts, int port) {
        *Socket holder;
        on_exit if (holder) {
            holder.close();
        }
        try {
            if (hold_next) {
                hold_next = False;
                # the port is in use: a UDP socket of the test holds it on the address of the bind; if something else
                # holds it already, the bind of this socket fails as the bind of the listener would
                holder = new Socket();
                holder.bindINET(opts.node, port, False, opts.family, SOCK_DGRAM);
            }
            hash<auto> rv = HttpServer::addQuicListener(opts, port);
            bound = True;
            return rv;
        } catch (hash<ExceptionInfo> ex) {
            if (ex.arg === EADDRINUSE) {
                push in_use_ports, port;
            }
            rethrow;
        }
    }

    #! Adds listeners on the given resolved addresses, as a listener on a host name with several addresses does
    list<hash<auto>> addResolved(hash<HttpListenerOptionInfo> info, list<auto> addresses) {
        return addINETListenersInternResolved(info, addresses);
    }
}

#! Records the calls of the stop notification of listeners
class StopRecorder {
    public {
        list<string> names = ();
    }

    private {
        Mutex lck();
    }

    code<nothing(string)> getCallback() {
        return sub (string name) {
            AutoLock al(lck);
            push names, name;
        };
    }
}

#! Records the log messages of a server
class LogRecorder inherits LoggerAppenderWithLayout {
    public {
        list<string> msgs = ();
    }

    private {
        Mutex lck();
    }

    constructor() : LoggerAppenderWithLayout("recorder", new LoggerLayoutPattern("%m")) {
        open();
    }

    processEventImpl(int type, auto params) {
        if (type == EVENT_LOG) {
            AutoLock al(lck);
            push msgs, params;
        }
    }

    list<string> get(string rx) {
        AutoLock al(lck);
        return select msgs, regex($1, rx);
    }
}

class HttpServerH3BindFailureTest inherits QUnit::Test {
    private {
        #! the most adds of a listener whose last attempt is the first real bind (each one a port in use is very rare)
        const MaxRounds = 10;
    }

    constructor() : QUnit::Test("HttpServerH3BindFailure", "1.0") {
        addTestCase("a random-port listener whose QUIC binds all fail is not added", \allFailTest());
        addTestCase("a random-port listener is created again until its QUIC bind succeeds", \retryTest());
        addTestCase("a failed listener leaves the count of running listeners unchanged", \runningCountTest());
        addTestCase("a random-port bind that fails with another error is not retried", \otherErrorTest());
        addTestCase("an explicit-port listener whose QUIC bind fails is not added", \explicitPortTest());
        addTestCase("a failed add on several addresses stops the listeners it started", \multiAddressRollbackTest());
        addTestCase("the stop notification is called only for listeners that started", \stopNotificationTest());
        addTestCase("the failure of a real bind has its system error number", \realBindErrnoTest());
        addTestCase("a random port that is in use at the last attempt fails the add", \lastAttemptInUseTest());
        set_return_value(main());
    }

    #! Returns the options of an HTTP/3 listener on localhost on \a service
    private hash<HttpListenerOptionInfo> h3Options(softstring service = "0") {
        return <HttpListenerOptionInfo>{
            "node": "localhost",
            "service": service,
            "cert": new SSLCertificate(TestCertificates::CertPem),
            "key": new SSLPrivateKey(TestCertificates::KeyPem),
            "enable_h3": True,
        };
    }

    #! Returns a server whose QUIC binds fail \a fails times with \a err_no, and its log recorder
    private hash<auto> getServer(int fails, *int err_no = EADDRINUSE) {
        LogRecorder rec();
        Logger logger("h3-bind-failure", LoggerLevel::getLevelInfo());
        logger.addAppender(rec);
        FailingQuicServer srv(<HttpServerOptionInfo>{"logger": logger}, fails, err_no);
        return {"srv": srv, "rec": rec};
    }

    #! Adds a listener on a new server whose first 9 QUIC binds fail, so that the tenth and last attempt binds it
    /** Returns the server, its log recorder and the listener: {"srv": FailingQuicServer, "rec": LogRecorder,
        "li": hash<auto>}.

        The bind of the tenth attempt is real: when its port is in use, such as by another test that runs at the same
        time, the attempts are exhausted and the listener is not added; that is checked, and the add is made again with
        a new server, as the server takes a fresh random port for an attempt for the same reason (qore#7743)
    */
    private hash<auto> addOnLastAttempt(hash<HttpListenerOptionInfo> info) {
        for (int round = 1; round <= MaxRounds; ++round) {
            hash<auto> s = getServer(9);
            FailingQuicServer srv = s.srv;
            try {
                hash<auto> li = srv.addListener(info);
                return {"srv": srv, "rec": s.rec, "li": li};
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != "HTTPSERVER-H3-BIND-ERROR" || srv.ports.size() != 10
                    || srv.in_use_ports != (srv.ports.last(),) || round == MaxRounds) {
                    delete srv;
                    rethrow;
                }
                # the port of the last attempt was in use: the add failed after all of its attempts and kept nothing
                assertRegex("in 10 attempt", ex.desc);
                assertRegex(sprintf("\\(errno %d\\)$", EADDRINUSE), ex.arg.attempts.last());
                assertEq({}, srv.getListeners(), "no listener was kept");
                delete srv;
            }
        }
        throw "TEST-ERROR", "not reached";
    }

    #! Adds a listener on an explicit \a port, which was free a moment ago; another program can take it before the
    #! listener binds it: then NOTHING is returned (the TCP bind failed) and the caller tries another port
    private *hash<ExceptionInfo> addOnPort(HttpServer srv, hash<HttpListenerOptionInfo> opts) {
        try {
            srv.addListener(opts);
            assertTrue(False, "the listener was added");
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "HTTPLISTENER-BIND-ERROR" || ex.err == "SOCKET-BIND-ERROR") {
                return;
            }
            return ex;
        }
    }

    allFailTest() {
        hash<auto> s = getServer(100);
        FailingQuicServer srv = s.srv;
        on_exit delete srv;
        LogRecorder rec = s.rec;

        hash<ExceptionInfo> ex;
        try {
            # all-interfaces: none; h3Options() listens on "node": "localhost" (the scanner does not follow the helper)
            srv.addListener(h3Options());
            assertTrue(False, "the listener was added");
        } catch (hash<ExceptionInfo> ex0) {
            ex = ex0;
        }
        assertEq("HTTPSERVER-H3-BIND-ERROR", ex.err);
        assertRegex("in 10 attempt", ex.desc);
        # every attempt was a listener of its own on a fresh port, and its failure is given with its errno
        assertEq(10, srv.ports.size(), "10 attempts");
        assertEq(10, ex.arg.attempts.size());
        for (int i = 0; i < 10; ++i) {
            assertRegex(sprintf("^attempt %d/10 on port %d: SOCKET-BIND-ERROR: .* \\(errno %d\\)$", i + 1,
                srv.ports[i], EADDRINUSE), ex.arg.attempts[i]);
        }
        assertEq(9, rec.get("retrying with a fresh random port").size(), "each retry is logged");
        assertEq(1, rec.get("ERROR: failed to bind the paired QUIC listener").size(), "the failure is logged");
        # no listener is left: neither the TCP listener of an attempt nor anything paired with it
        assertEq({}, srv.getListeners(), "no listener was kept");
        assertEq(0, srv.getRunningListenerCount(), "no listener is running");
    }

    runningCountTest() {
        hash<auto> s = getServer(100);
        FailingQuicServer srv = s.srv;
        on_exit delete srv;

        # a listener that runs: plain HTTP on a random port
        srv.addListener(<HttpListenerOptionInfo>{"node": "localhost", "service": 0});
        assertEq(1, srv.getRunningListenerCount());
        # all-interfaces: none; h3Options() listens on "node": "localhost" (the scanner does not follow the helper)
        assertThrows("HTTPSERVER-H3-BIND-ERROR", \srv.addListener(), h3Options());
        assertEq(10, srv.ports.size(), "10 attempts");
        # the failed attempts took away nothing of the count of the listener that runs, so that stop() waits for it
        assertEq(1, srv.getRunningListenerCount(), "the count of running listeners is unchanged");
        assertEq(1, srv.getListeners().size());
        srv.stop();
        assertEq(0, srv.getRunningListenerCount());
    }

    otherErrorTest() {
        # an error that a fresh port does not change, such as an address family that the system does not support
        hash<auto> s = getServer(100, EAFNOSUPPORT);
        FailingQuicServer srv = s.srv;
        on_exit delete srv;
        LogRecorder rec = s.rec;

        hash<ExceptionInfo> ex;
        try {
            # all-interfaces: none; h3Options() listens on "node": "localhost" (the scanner does not follow the helper)
            srv.addListener(h3Options());
            assertTrue(False, "the listener was added");
        } catch (hash<ExceptionInfo> ex0) {
            ex = ex0;
        }
        assertEq("HTTPSERVER-H3-BIND-ERROR", ex.err);
        assertRegex("in 1 attempt", ex.desc);
        assertEq(1, srv.ports.size(), "one attempt");
        assertRegex(sprintf("\\(errno %d\\)$", EAFNOSUPPORT), ex.arg.attempts[0]);
        assertEq((), rec.get("retrying with a fresh random port"), "no retry");
        assertEq({}, srv.getListeners(), "no listener was kept");
    }

    retryTest() {
        # all-interfaces: none; h3Options() listens on "node": "localhost" (the scanner does not follow the helper)
        hash<auto> s = addOnLastAttempt(h3Options());
        FailingQuicServer srv = s.srv;
        on_exit delete srv;
        LogRecorder rec = s.rec;
        hash<auto> li = s.li;
        assertEq(10, srv.ports.size(), "the tenth attempt was bound");
        assertEq(srv.ports.last(), li.port, "the listener is on the port of the last attempt");
        assertEq(9, rec.get("retrying with a fresh random port").size());
        # the TCP listener and its paired QUIC listener are both on the final port
        list<hash<auto>> listeners = srv.getListeners().values();
        assertEq(2, listeners.size());
        assertEq((li.port, li.port), (map $1.port, listeners));
    }

    explicitPortTest() {
        hash<auto> s = getServer(1000);
        FailingQuicServer srv = s.srv;
        on_exit delete srv;

        *hash<ExceptionInfo> ex;
        int port;
        for (int i = 0; i < 20 && !ex; ++i) {
            # a port that was free a moment ago; an explicit port is not changed, so there is one attempt only
            Socket probe();
            probe.bindINET("localhost", "0", True);
            port = probe.getSocketInfo().port;
            probe.close();
            srv.ports = ();
            ex = addOnPort(srv, h3Options(port));
        }
        if (!ex) {
            testSkip("no free port could be bound");
        }
        assertEq("HTTPSERVER-H3-BIND-ERROR", ex.err);
        assertRegex(sprintf("on requested port %d", port), ex.desc);
        assertEq((port,), srv.ports, "one attempt on the requested port");
        assertEq(1, ex.arg.attempts.size());
        assertEq({}, srv.getListeners(), "no listener was kept");
        assertEq(0, srv.getRunningListenerCount(), "no listener is running");
    }

    realBindErrnoTest() {
        HttpServer srv();
        on_exit delete srv;

        *hash<ExceptionInfo> ex;
        for (int i = 0; i < 20 && !ex; ++i) {
            # a UDP socket holds a port on the address that the listener binds; the TCP port of the same number is
            # free a moment ago
            Socket udp();
            on_exit udp.close();
            udp.bindINET("localhost", "0", False, AF_UNSPEC, SOCK_DGRAM);
            hash<auto> info = udp.getSocketInfo();
            Socket tcp();
            try {
                tcp.bindINET(info.address, info.port, True, info.family);
                tcp.close();
            } catch (hash<ExceptionInfo> ex0) {
                continue;
            }
            hash<HttpListenerOptionInfo> opts = h3Options(info.port);
            opts.node = info.address;
            ex = addOnPort(srv, opts);
        }
        if (!ex) {
            testSkip("no port is free for TCP and held for UDP");
        }
        assertEq("HTTPSERVER-H3-BIND-ERROR", ex.err);
        assertEq(1, ex.arg.attempts.size());
        assertRegex(sprintf("\\(errno %d\\)$", EADDRINUSE), ex.arg.attempts[0], "the system error of the bind");
        assertEq({}, srv.getListeners(), "no listener was kept");
    }

    multiAddressRollbackTest() {
        hash<auto> s = getServer(0, EAFNOSUPPORT);
        FailingQuicServer srv = s.srv;
        on_exit delete srv;
        # the bind of the second listener's QUIC listener fails, with an error that is not retried
        srv.fail_after_bound = True;
        StopRecorder stops();

        hash<HttpListenerOptionInfo> info = h3Options();
        info.stopc = stops.getCallback();
        info.name = "multi";
        # two addresses of one host name (the same loopback address twice, each on a random port of its own)
        list<hash<auto>> addresses = (
            {"address": "127.0.0.1", "address_desc": "ipv4(127.0.0.1)", "port": 0, "family": AF_INET},
            {"address": "127.0.0.1", "address_desc": "ipv4(127.0.0.1)", "port": 0, "family": AF_INET},
        );
        assertThrows("HTTPSERVER-H3-BIND-ERROR", \srv.addResolved(), (info, addresses));
        # a port of the first address that was in use was tried again with a fresh one
        assertEq(2 + srv.in_use_ports.size(), srv.binds, "both addresses were tried");
        # the listener started for the first address was stopped: no listener is left running
        assertEq({}, srv.getListeners(), "no listener was kept");
        assertEq(0, srv.getRunningListenerCount(), "no listener is running");
        # its stop was notified once, with its name; the listener of the second address never started
        assertEq(1, stops.names.size(), "one stop notification");
        assertRegex("^multi-[0-9]+$", stops.names[0], "the stop of the listener of the first address was notified");
    }

    stopNotificationTest() {
        StopRecorder stops();

        hash<HttpListenerOptionInfo> info = h3Options();
        info.stopc = stops.getCallback();
        # all-interfaces: none; h3Options() listens on "node": "localhost" (the scanner does not follow the helper)
        FailingQuicServer srv = addOnLastAttempt(info).srv;
        on_exit delete srv;
        assertEq(10, srv.ports.size(), "the tenth attempt was bound");
        # the nine listeners that were created and stopped again because their QUIC listener could not be bound did
        # not start: their stop is not notified
        assertEq((), stops.names, "no stop notification for the failed attempts");
        srv.stop();
        assertEq(1, stops.names.size(), "the listener that started notified its stop once");
    }

    lastAttemptInUseTest() {
        hash<auto> s = getServer(9);
        FailingQuicServer srv = s.srv;
        on_exit delete srv;
        # the bind of the tenth attempt, the first real one, finds its port in use
        srv.hold_next = True;

        hash<ExceptionInfo> ex;
        try {
            # all-interfaces: none; h3Options() listens on "node": "localhost" (the scanner does not follow the helper)
            srv.addListener(h3Options());
            assertTrue(False, "the listener was added");
        } catch (hash<ExceptionInfo> ex0) {
            ex = ex0;
        }
        assertEq("HTTPSERVER-H3-BIND-ERROR", ex.err);
        assertRegex("in 10 attempt", ex.desc);
        assertEq(10, srv.ports.size(), "10 attempts");
        assertEq((srv.ports.last(),), srv.in_use_ports, "the port of the last attempt was in use");
        assertRegex(sprintf("^attempt 10/10 on port %d: SOCKET-BIND-ERROR: .*Address already in use.* \\(errno %d\\)$",
            srv.ports.last(), EADDRINUSE), ex.arg.attempts.last(), "the system error of the real bind");
        assertEq({}, srv.getListeners(), "no listener was kept");
        assertEq(0, srv.getRunningListenerCount(), "no listener is running");
    }
}
