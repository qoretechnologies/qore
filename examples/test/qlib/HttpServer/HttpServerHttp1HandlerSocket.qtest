%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires HttpServer
%requires HttpServerUtil
%requires HttpServerAsyncIo
%requires HttpClientIo
%requires RestHandler
%requires WebSocketHandler
%requires WebSocketClient
%requires DataStreamUtil
%requires DataStreamRequestHandler
%requires DataStreamClient
%requires Mime
%requires yaml
%requires ../../TestCertificates.qm

%exec-class HttpServerHttp1HandlerSocketTest

#! a hang guard only, never a timing assertion
const HangGuard = 20s;

#! Returns "ok" or the error of the call
string sub try_it(code c) {
    try {
        c();
        return "ok";
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
}

#! Returns the classes of the sockets in a value, its hashes and its lists; an object is not entered
list<string> sub find_sockets(auto v) {
    list<string> rv = ();
    switch (v.typeCode()) {
        case NT_HASH:
            foreach auto e in (v.values()) {
                rv += find_sockets(e);
            }
            break;
        case NT_LIST:
            foreach auto e in (v) {
                rv += find_sockets(e);
            }
            break;
        case NT_OBJECT:
            if (v instanceof Socket) {
                rv += v.className();
            }
            break;
    }
    return rv;
}

#! Tries the socket of its request in the way that its path names; answers with the results, one "key=value" a line
class ProbeHandler inherits AbstractHttpRequestHandler {
    public {
        #! the socket of a request that the "keep" path keeps
        Queue kept();
    }

    hash<HttpResponseInfo> handleRequest(HttpListenerInterface listener, Socket s, hash<auto> cx, hash<auto> hdr,
            *data body) {
        hash<string, string> r;
        switch (hdr.path) {
            case "header": {
                # the next request on the connection
                r.header = try_it(sub () { s.readHTTPHeader(1s); });
                r.header_string = try_it(sub () { s.readHTTPHeaderString(1s); });
                break;
            }
            case "recv": {
                # the server read the request's body: no data, also with a request after it on the connection
                r.recv = sprintf("%y", s.recv(0, 1s));
                r.recv_size = sprintf("%y", s.recv(16, 1s));
                r.recv_binary = string(s.recvBinary(16, 1s).size());
                r.recvi4 = try_it(sub () { s.recvi4(1s); });
                r.body = sprintf("%y", body);
                break;
            }
            case "close": {
                r.shutdown = try_it(sub () { s.shutdown(); });
                r.close = try_it(sub () { s.close(); });
                r.shutdown_write = try_it(sub () { s.shutdownWrite(); });
                r.open = sprintf("%y", s.isOpen());
                break;
            }
            case "chunked": {
                # a chunked body is read by its chunks only, once
                r.pending = sprintf("%y", s.pendingHttpChunkedBody());
                r.recv = try_it(sub () { s.recv(1, 1s); });
                hash<auto> chunked = s.readHTTPChunkedBody(HangGuard);
                r.body = sprintf("%y", chunked.body);
                r.again = try_it(sub () { s.readHTTPChunkedBody(1s); });
                r.after = sprintf("%y", s.recv(0, 1s));
                r.pending_after = sprintf("%y", s.pendingHttpChunkedBody());
                break;
            }
            case "chunked-callback": {
                list<string> chunks;
                s.readHTTPChunkedBodyWithCallback(sub (hash<auto> v) {
                    if (v.data) {
                        chunks += v.data;
                    }
                }, HangGuard);
                r.body = chunks.join("");
                r.again = try_it(sub () { s.readHTTPChunkedBodyBinaryWithCallback(sub (hash<auto> v) {}, 1s); });
                break;
            }
            case "other": {
                r.connect = try_it(sub () { s.connect("localhost:1", 1s); });
                r.bind = try_it(sub () { s.bind(0); });
                r.listen = try_it(sub () { s.listen(); });
                r.accept = try_it(sub () { s.accept(1s); });
                r.upgrade = try_it(sub () { s.upgradeServerToSSL(1s); });
                r.fd = try_it(sub () { s.getPollableDescriptor(); });
                r.timeout = try_it(sub () { s.setRecvTimeout(1s); });
                r.copy = try_it(sub () { s.copy(); });
                r.peer = s.getPeerInfo(False).address;
                # another socket than the handler's own is not aborted
                r.abort_other = try_it(sub () { http_abort_connection(new Socket()); });
                r.socket = s.getSocketInfo(False).address;
                r.encoding = s.getEncoding();
                r.http2 = sprintf("%y", s.isHttp2());
                break;
            }
            case "keep": {
                kept.push(s);
                r.kept = "yes";
                break;
            }
            case "stale": {
                # the socket of an earlier request on the connection
                Socket old = kept.get(HangGuard);
                r.send = try_it(sub () { old.send("HTTP/1.1 200 OK\r\nContent-Length: 6\r\n\r\nFORGED"); });
                r.recv = try_it(sub () { old.recv(0, 1s); });
                r.abort = try_it(sub () { http_abort_connection(old); });
                r.open = sprintf("%y", old.isOpen());
                break;
            }
            case "proto": {
                return makeResponse(200, sprintf("http2=%y", cx."header-info".http2 ?? False));
            }
            case "abort-stream": {
                # the socket of an HTTP/2 request ends the request's own stream
                http_abort_connection(s);
                return makeResponse(200, "not sent");
            }
            case "context": {
                # the socket of the request is the only one that its handler gets
                r.sockets = find_sockets({"cx": cx, "hdr": hdr}).join(",");
                r.own = s.className();
                break;
            }
            case "self": {
                # the handler sends its own response, once
                s.sendHTTPResponse(200, "OK", "1.1", {"Content-Type": "text/plain"}, "sent by the handler");
                string again = try_it(sub () { s.sendHTTPResponse(200, "OK", "1.1", {}, "FORGED"); });
                string raw = try_it(sub () { s.send("FORGED"); });
                if (again == "ok" || raw == "ok") {
                    throw "TEST-ERROR", sprintf("a second response was sent: %y %y", again, raw);
                }
                return <HttpResponseInfo>{"code": 200, "reply_sent": True};
            }
            default: {
                return makeResponse(200, sprintf("served %s", hdr.path));
            }
        }
        return makeResponse(200, (map $1.key + "=" + $1.value, r.pairIterator()).join("\n"));
    }
}

#! Holds its request until the test releases it
class HoldHandler inherits AbstractHttpRequestHandler {
    public {
        Queue entered();
        Queue release();
    }

    hash<HttpResponseInfo> handleRequest(HttpListenerInterface listener, Socket s, hash<auto> cx, hash<auto> hdr,
            *data body) {
        entered.push(True);
        release.get(HangGuard);
        return makeResponse(200, "held");
    }
}

#! Reports how the body of its request arrived and what its socket gives
class StreamBodyRequest inherits AbstractStreamRequest {
    private {
        int ctor_size;
        int parts;
        int bytes;
        int recv_size;
    }

    constructor(HttpListenerInterface listener, AbstractHttpRequestHandler handler, Socket s, hash<auto> cx,
            hash<auto> hdr, auto body) : AbstractStreamRequest(listener, handler, s, cx, hdr, body) {
        ctor_size = body.size();
        recv_size = s.recvBinary(16, 1s).size();
    }

    private nothing recvImpl(hash<auto> v) {
        if (v.data) {
            ++parts;
            bytes += v.data.size();
        }
    }

    private auto sendImpl() {
    }

    private hash<HttpResponseInfo> getResponseHeaderMessageImpl() {
        return <HttpResponseInfo>{
            "code": 200,
            "body": sprintf("ctor=%d\nparts=%d\nbytes=%d\nrecv=%d", ctor_size, parts, bytes, recv_size),
        };
    }
}

#! A stream handler
class StreamBodyHandler inherits AbstractHttpRequestHandler {
    constructor() : AbstractHttpRequestHandler(NOTHING, True) {
    }

    private AbstractStreamRequest getStreamRequestImpl(HttpListenerInterface listener, Socket s, hash<auto> cx,
            hash<auto> hdr, *data body) {
        return new StreamBodyRequest(listener, self, s, cx, hdr, body);
    }
}

#! Reports the sockets that the application code of a WebSocket connection gets
class ScanWebSocketHandler inherits WebSocketHandler {
    public {
        Queue scans();
    }

    WebSocketConnection getConnectionImpl(hash<auto> cx, hash<auto> hdr, string cid) {
        scans.push({"sockets": find_sockets({"cx": cx, "hdr": hdr}), "version": hdr.http_version});
        return WebSocketHandler::getConnectionImpl(cx, hdr, cid);
    }
}

#! Forwards to the server's target; keeps the information of each request as the server gives it to its target
class RecordingTarget inherits HttpServerAsyncIo::HttpAsyncTarget {
    public {
        Queue requests();
    }

    private {
        HttpServerAsyncIo::HttpAsyncTarget target;
    }

    constructor(HttpServerAsyncIo::HttpAsyncTarget target) {
        self.target = target;
    }

    hash<HttpServerAsyncIo::HttpRequestResultInfo> onHttpRequest(hash<HttpServerAsyncIo::HttpConnectionInfo> info) {
        requests.push(info);
        return target.onHttpRequest(info);
    }

    onIdleTimeout(Socket sock, *HttpListenerInterface listener, hash<auto> cx) {
        target.onIdleTimeout(sock, listener, cx);
    }

    onError(Socket sock, hash<ExceptionInfo> ex, *HttpListenerInterface listener, *hash<auto> cx) {
        target.onError(sock, ex, listener, cx);
    }

    onSseDisconnect(Socket sock, *HttpListenerInterface listener, hash<auto> cx) {
        target.onSseDisconnect(sock, listener, cx);
    }

    onWebSocketFrame(Socket sock, hash<HttpServerAsyncIo::WebSocketFrameInfo> frame,
            *HttpListenerInterface listener, hash<auto> cx) {
        target.onWebSocketFrame(sock, frame, listener, cx);
    }

    onWebSocketClose(Socket sock, int code, string reason, *HttpListenerInterface listener, hash<auto> cx) {
        target.onWebSocketClose(sock, code, reason, listener, cx);
    }

    onPersistentRequestEnd(hash<HttpServerAsyncIo::HttpConnectionInfo> info) {
        target.onPersistentRequestEnd(info);
    }

    *hash<HttpServerAsyncIo::HttpRequestResultInfo> tryInlineRequest(
            hash<HttpServerAsyncIo::HttpConnectionInfo> info) {
        return target.tryInlineRequest(info);
    }

    *hash<HttpServerAsyncIo::HttpRequestResultInfo> prepareHttpRequest(
            hash<HttpServerAsyncIo::HttpConnectionInfo> info) {
        return target.prepareHttpRequest(info);
    }

    cancelPreparedHttpRequest(hash<HttpServerAsyncIo::HttpConnectionInfo> info) {
        target.cancelPreparedHttpRequest(info);
    }

    auto saveDispatchContext() {
        return target.saveDispatchContext();
    }

    restoreDispatchContext(auto save_data) {
        target.restoreDispatchContext(save_data);
    }
}

#! A server whose target keeps the information of each request, as a framework's target does to abort a request
class RecordingServer inherits HttpServer {
    public {
        RecordingTarget recording;
    }

    constructor() : HttpServer(<HttpServerOptionInfo>{}) {
        recording = new RecordingTarget(asyncTarget);
        asyncTarget = recording;
    }
}

#! The REST class of the DataStream records of the test, with its stream handler
class EchoRestClass inherits AbstractRestClass {
    private {
        code get_handler;
    }

    constructor(code get_handler) {
        self.get_handler = get_handler;
    }

    string name() {
        return "echo";
    }

    AbstractRestStreamRequestHandler streamPost(hash<auto> cx, *hash<auto> ah) {
        return get_handler(cx, ah);
    }
}

#! The handlers of HTTP/1.1 requests get a socket that acts on the connection for their own request only (qore#7305)
/** The server keeps the connection's socket: the handler's socket cannot read the next request on the connection,
    nor read past the request's own body, nor shut the connection down or close it; it sends the request's own
    response, once, and ends when the handler's code returns.  A DataStream handler streams through it, also one of
    a sandboxed Program
*/
class HttpServerHttp1HandlerSocketTest inherits QUnit::Test {
    public {
        #! a sandboxed tenant's DataStream handler
        const TenantSource = "%modern
%requires HttpServer
%requires HttpServerUtil
%requires RestHandler
%requires DataStreamUtil
%requires DataStreamRequestHandler

class TenantEchoHandler inherits AbstractDataStreamRequestHandler {
    private {
        list<auto> records = ();
        int sent = 0;
        string probe;
    }

    constructor(hash<auto> cx, *hash<auto> ah) : AbstractDataStreamRequestHandler(cx, ah) {
        probe = probe_socket(cx);
    }

    private nothing recvDataImpl(auto data) {
        records += data;
    }

    private auto sendDataImpl() {
        if (sent < records.size()) {
            return records[sent++];
        }
        if (sent++ == records.size()) {
            return {\"probe\": probe, \"version\": cx.hdr.http_version};
        }
    }
}

string sub probe_socket(hash<auto> cx) {
    try {
        cx.socketobject.readHTTPHeader(1s);
        return \"read\";
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
}

AbstractRestStreamRequestHandler sub get_handler(hash<auto> cx, *hash<auto> ah) {
    return new TenantEchoHandler(cx, ah);
}

string sub try_it(code c) {
    try {
        c();
        return \"ok\";
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
}

#! tries to abort the connection of its request, or holds its request until the test releases it
class TenantHttpHandler inherits AbstractHttpRequestHandler {
    private {
        Queue entered;
        Queue release;
    }

    constructor(Queue entered, Queue release) {
        self.entered = entered;
        self.release = release;
    }

    hash<HttpResponseInfo> handleRequest(HttpListenerInterface listener, Socket s, hash<auto> cx, hash<auto> hdr,
            *data body) {
        switch (hdr.path) {
            case \"abort\":
                return makeResponse(200, sprintf(\"function=%s\\nmethod=%s\",
                    try_it(sub () { http_abort_connection(s); }),
                    try_it(sub () { call_object_method(s, \"abortConnection\"); })));
            case \"hold\":
                entered.push(True);
                release.get(20s);
                return makeResponse(200, \"held\");
        }
        return makeResponse(200, \"served \" + hdr.path);
    }
}

AbstractHttpRequestHandler sub get_http_handler(Queue entered, Queue release) {
    return new TenantHttpHandler(entered, release);
}

#! runs code for the tenant, as a framework does on a thread that serves the tenant's request
nothing sub run_code(code c) {
    c();
}
";
    }

    private {
        HttpServer server;
        ProbeHandler probe();
        int port;
    }

    constructor() : QUnit::Test("HTTP/1.1 handler socket", "1.0", \ARGV) {
        server = new HttpServer(<HttpServerOptionInfo>{});
        server.setHandler("probe", "", NOTHING, probe);
        server.setHandler("stream", "^stream", NOTHING, new StreamBodyHandler());
        server.setDefaultHandler("probe", probe);
        port = server.addListener(<HttpListenerOptionInfo>{"node": "localhost", "service": 0}).port;
        server.waitForAsyncIo();

        addTestCase("the next request is not read", \nextRequestTest());
        addTestCase("no data past the body", \recvTest());
        addTestCase("a body split across reads", \splitBodyTest());
        addTestCase("the connection is not closed", \closeTest());
        addTestCase("a chunked body", \chunkedTest());
        addTestCase("a chunked body read with a callback", \chunkedCallbackTest());
        addTestCase("other methods", \otherTest());
        addTestCase("the socket ends with its request", \staleTest());
        addTestCase("the handler's own response", \selfResponseTest());
        addTestCase("DataStream", \dataStreamTest());
        addTestCase("DataStream of a sandboxed handler", \sandboxedDataStreamTest());
        addTestCase("the request context", \contextTest());
        addTestCase("a Content-Length body to a stream handler", \streamBodyTest());
        addTestCase("sandboxed code cannot abort the connection", \sandboxedAbortTest());
        addTestCase("the server's target aborts a request", \targetAbortTest());
        addTestCase("WebSocket", \webSocketTest());
        addTestCase("the abort of an HTTP/2 request's stream", \streamAbortTest(), "h2");
        addTestCase("the abort of an HTTP/3 request's stream", \streamAbortTest(), "h3");
        set_return_value(main());
        delete server;
    }

    #! the next request is unreachable through the handler's socket, and is then served
    nextRequestTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("GET /header HTTP/1.1\r\nHost: localhost\r\n\r\n"
            "GET /second HTTP/1.1\r\nHost: localhost\r\nX-Token: next-request\r\n\r\n");
        hash<auto> r = parse(readResponse(c));
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.header);
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.header_string);
        assertEq("served second", readResponse(c), "the next request is served");
    }

    #! reads past the request's body give no data
    recvTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("POST /recv HTTP/1.1\r\nHost: localhost\r\nContent-Type: text/plain\r\nContent-Length: 4\r\n\r\nbody"
            "GET /second HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> r = parse(readResponse(c));
        assertEq("\"\"", r.recv);
        assertEq("\"\"", r.recv_size);
        assertEq("0", r.recv_binary);
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.recvi4);
        assertEq("\"body\"", r.body, "the handler gets the request's body");
        assertEq("served second", readResponse(c), "the next request is served");
    }

    #! a body sent in two parts is read by the server; the handler's socket gives no data
    splitBodyTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("POST /recv HTTP/1.1\r\nHost: localhost\r\nContent-Type: text/plain\r\nContent-Length: 8\r\n\r\nfirs");
        c.send("t ok");
        hash<auto> r = parse(readResponse(c));
        assertEq("\"first ok\"", r.body);
        assertEq("\"\"", r.recv);
        assertEq("\"\"", r.recv_size);
    }

    #! the handler's socket cannot shut the connection down or close it
    closeTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("GET /close HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> r = parse(readResponse(c));
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.shutdown);
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.close);
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.shutdown_write);
        assertEq("True", r.open);
        c.send("GET /after HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq("served after", readResponse(c), "the connection serves the next request");
    }

    #! a chunked body is read by its chunks, once, up to its end
    chunkedTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("POST /chunked HTTP/1.1\r\nHost: localhost\r\nContent-Type: text/plain\r\n"
            "Transfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n6\r\n world\r\n0\r\n\r\n"
            "GET /second HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> r = parse(readResponse(c));
        assertEq("True", r.pending);
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.recv, "a chunked body is not read by its bytes");
        assertEq("\"hello world\"", r.body);
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.again, "the chunked body is read once");
        assertEq("\"\"", r.after);
        assertEq("False", r.pending_after);
        assertEq("served second", readResponse(c), "the next request is served");
    }

    #! a chunked body read with a callback
    chunkedCallbackTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("POST /chunked-callback HTTP/1.1\r\nHost: localhost\r\nContent-Type: text/plain\r\n"
            "Transfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n3\r\ndef\r\n0\r\n\r\n"
            "GET /second HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> r = parse(readResponse(c));
        assertEq("abcdef", r.body);
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.again);
        assertEq("served second", readResponse(c), "the next request is served");
    }

    #! the methods that would act on the connection otherwise are refused; its information is given
    otherTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("GET /other HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> r = parse(readResponse(c));
        foreach string k in (("connect", "bind", "listen", "accept", "upgrade", "fd", "timeout", "copy",
                "abort_other")) {
            assertEq("HTTP-HANDLER-SOCKET-ERROR", r{k}, k);
        }
        assertEq(c.getSocketInfo(False).address, r.peer, "the peer's address");
        assertEq(c.getPeerInfo(False).address, r.socket, "the connection's address");
        assertEq("False", r.http2);
        assertTrue(r.encoding.val());
        c.send("GET /after HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq("served after", readResponse(c), "the connection serves the next request");
    }

    #! the socket of a request ends when the handler returns: it cannot send into a later response
    staleTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("GET /keep HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq({"kept": "yes"}, parse(readResponse(c)));
        c.send("GET /stale HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> r = parse(readResponse(c));
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.send);
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.recv);
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.abort, "the ended socket does not abort the connection");
        assertEq("False", r.open);
        c.send("GET /after HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq("served after", readResponse(c), "the connection serves the next request");
    }

    #! the handler sends one response of its own
    selfResponseTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("GET /self HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq("sent by the handler", readResponse(c));
        c.send("GET /after HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq("served after", readResponse(c), "the connection serves the next request");
    }

    #! a DataStream handler streams through the socket of its HTTP/1.1 request
    dataStreamTest() {
        list<auto> rv = dataStreamIntern(auto sub (hash<auto> cx, *hash<auto> ah) { return new EchoHandler(cx, ah); },
            "echo");
        assertEq({"probe": "HTTP-HANDLER-SOCKET-ERROR", "version": "1.1"}, rv.last(), "the handler's socket");
    }

    #! a DataStream handler of a sandboxed Program streams through the socket of its HTTP/1.1 request, which
    #! refuses to read the next request
    sandboxedDataStreamTest() {
        Program p = getTenantProgram();
        list<auto> rv = dataStreamIntern(auto sub (hash<auto> cx, *hash<auto> ah) {
            return p.callFunction("get_handler", cx, ah);
        }, "tenant");
        assertEq({"probe": "HTTP-HANDLER-SOCKET-ERROR", "version": "1.1"}, rv.last(),
            "the sandboxed handler's socket");
    }

    private list<auto> dataStreamIntern(code get_handler, string name) {
        RestHandler rest();
        rest.addClass(new EchoRestClass(get_handler));
        server.setHandler(name, "^echo", NOTHING, rest);
        on_exit server.removeHandler(name);

        list<auto> records = ({"a": 1}, {"b": "two"}, {"c": (3, 4)});
        int i = 0;
        list<auto> received = ();
        DataStreamClient client({"url": "http://localhost:" + port, "http_version": "1.1", "timeout": HangGuard,
            "protocol": "datastream"});
        hash<auto> info;
        client.sendRecvDataStream(auto sub () { return i < records.size() ? records[i++] : NOTHING; },
            sub (auto v) { received += v; }, sub (*string err) { if (err) { throw "TEST-ERROR", err; } },
            "POST", "/echo", HangGuard, \info);
        assertEq(records, received[0..2], "the records are echoed");
        assertEq(4, received.size(), "the records and the handler's probe");
        return received;
    }

    #! the request context and header of an HTTP/1.1 request have no socket; the handler's socket is the request's
    contextTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("GET /context HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> r = parse(readResponse(c));
        assertEq("", r.sockets, "no socket in the request context or header");
        assertEq("Http1HandlerSocket", r.own, "the handler's socket is its request's");
    }

    #! the server reads a body with a Content-Length before a stream request starts, which gets it whole, in its
    #! constructor and in one part (as before qore#7305; see qore#7308); the socket of the request gives no data
    streamBodyTest() {
        Socket c = connect();
        on_exit c.close();
        # larger than twice the read buffer of the server
        int size = 1024 * 1024;
        c.send(sprintf("POST /stream HTTP/1.1\r\nHost: localhost\r\nContent-Type: application/octet-stream\r\n"
            "Content-Length: %d\r\n\r\n", size));
        c.send(strmul("x", size).toBinary());
        c.send("GET /second HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> r = parse(readResponse(c));
        assertEq(string(size), r.ctor, "the stream request gets the body whole");
        assertEq("1", r.parts, "the body is received in one part");
        assertEq(string(size), r.bytes);
        assertEq("0", r.recv, "the socket of the request gives no data");
        assertEq("served second", readResponse(c), "the next request is served");
    }

    #! a sandboxed handler cannot abort the connection of its request, which then serves the next request
    sandboxedAbortTest() {
        Program p = getTenantProgram();
        Queue entered();
        Queue release();
        server.setHandler("tenant", "^abort", NOTHING, p.callFunction("get_http_handler", entered, release));
        on_exit server.removeHandler("tenant");
        Socket c = connect();
        on_exit c.close();
        c.send("GET /abort HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> r = parse(readResponse(c));
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.function);
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.method);
        c.send("GET /after HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq("served after", readResponse(c), "the connection serves the next request");
    }

    #! the server's target gets the connection's own socket with the information of a request, and aborts a
    #! request of a sandboxed handler with it, also when the abort runs for the tenant
    targetAbortTest() {
        Program p = getTenantProgram();
        Queue entered();
        Queue release();
        RecordingServer srv();
        on_exit delete srv;
        srv.setHandler("tenant", "", NOTHING, p.callFunction("get_http_handler", entered, release));
        srv.setDefaultHandler("tenant", p.callFunction("get_http_handler", entered, release));
        int srv_port = srv.addListener(<HttpListenerOptionInfo>{"node": "localhost", "service": 0}).port;
        srv.waitForAsyncIo();

        Socket c();
        c.connect("localhost:" + srv_port, HangGuard);
        on_exit c.close();
        c.send("GET /hold HTTP/1.1\r\nHost: localhost\r\n\r\n");
        entered.get(HangGuard);
        hash<HttpServerAsyncIo::HttpConnectionInfo> info = srv.recording.requests.get(HangGuard);
        assertEq("Socket", info.sock.className(), "the target gets the connection's own socket");
        assertThrows("HTTP-HANDLER-SOCKET-ERROR", \http_abort_connection(), info.sock,
            "the connection's own socket is not a handler's");
        assertThrows("HTTP-HANDLER-SOCKET-ERROR", \http_abort_connection(), c, "a client socket is not a handler's");
        assertEq(c.getSocketInfo(False).port, info.sock.getPeerInfo(False).port, "the request's connection");
        # the abort of a framework's drain (HTTP/1.1: the connection is closed), run on behalf of the tenant
        Socket sock = info.sock;
        p.callFunction("run_code", sub () { sock.close(); });
        assertThrows("SOCKET-CLOSED", \c.readHTTPHeader(), HangGuard, "the client sees the connection closed");
        release.push(True);

        # the server serves another connection
        Socket c2();
        c2.connect("localhost:" + srv_port, HangGuard);
        on_exit c2.close();
        c2.send("GET /next HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq("served next", readResponse(c2));
    }

    #! the application code of an HTTP/1.1 WebSocket connection gets no socket
    webSocketTest() {
        HttpServer srv(<HttpServerOptionInfo>{});
        on_exit delete srv;
        ScanWebSocketHandler ws();
        srv.setHandler("ws", "^ws", NOTHING, ws);
        int srv_port = srv.addListener(<HttpListenerOptionInfo>{"node": "localhost", "service": 0}).port;
        srv.waitForAsyncIo();
        WebSocketClient wsc(sub (*data msg) {}, {"url": "ws://localhost:" + srv_port + "/ws"});
        wsc.connect();
        on_exit wsc.disconnect();
        hash<auto> scan = ws.scans.get(HangGuard);
        assertEq((), scan.sockets, "no socket in the request context or header of the connection");
        assertEq("1.1", scan.version);
    }

    #! http_abort_connection() ends the stream of an HTTP/2 or HTTP/3 request; another request of the same connection
    #! in progress completes
    streamAbortTest(string protocol) {
        HttpServer srv(<HttpServerOptionInfo>{});
        on_exit delete srv;
        HoldHandler hold();
        # a held request ends before the server is deleted, also when the test fails
        on_exit hold.release.push(True);
        srv.setHandler("hold", "^hold", NOTHING, hold);
        srv.setHandler("probe", "", NOTHING, probe);
        srv.setDefaultHandler("probe", probe);
        int tls_port = srv.addListener(<HttpListenerOptionInfo>{
            "node": "localhost",
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
            "http_version": "auto",
        }).port;
        srv.waitForAsyncIo();

        HttpClientConnectionManager mgr(<HttpClientConnectionManagerOptions>{
            "protocol": protocol,
            "accept_all_certs": True,
            "request_timeout": HangGuard,
            "connect_timeout": HangGuard,
        });
        on_exit delete mgr;
        string url = sprintf("https://localhost:%d/", tls_port);
        # another request of the same connection, in progress while the handler aborts its own stream
        Queue other_result();
        background sub () {
            try {
                other_result.push(mgr.request(url, "GET", "/hold").body);
            } catch (hash<ExceptionInfo> ex) {
                other_result.push(ex.err);
            }
        }();
        hold.entered.get(HangGuard);
        assertEq("http2=" + (protocol == "h2" ? "True" : "False"), mgr.request(url, "GET", "/proto").body,
            "the probe's request");
        *hash<ExceptionInfo> err;
        try {
            mgr.request(url, "GET", "/abort-stream");
        } catch (hash<ExceptionInfo> ex) {
            err = ex;
        }
        assertEq(Type::Hash, err.type(), "the request's stream is ended without its response");
        hold.release.push(True);
        assertEq("held", other_result.get(HangGuard), "the other request of the connection completes");
        assertEq(protocol == "h2" ? "http2=True" : "http2=False", mgr.request(url, "GET", "/proto").body,
            "the next request is served");
    }

    #! Returns a sandboxed Program with the tenant's handlers
    private Program getTenantProgram() {
        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        p.parse(TenantSource, "tenant");
        SandboxManager sm();
        sm.setNetworkDefaultPolicy(True);
        p.setSandboxManager(sm);
        return p;
    }

    private Socket connect() {
        Socket c();
        c.connect("localhost:" + port, HangGuard);
        return c;
    }

    #! reads a response with a Content-Length and returns its body
    private static string readResponse(Socket c) {
        hash<auto> h = c.readHTTPHeader(HangGuard);
        int len = h."content-length".toInt();
        return len ? c.recv(len, HangGuard) : "";
    }

    #! parses the "key=value" lines of a probe's response
    private static hash<auto> parse(string body) {
        hash<auto> r;
        foreach string line in (body.split("\n")) {
            (*string k, *string v) = (line =~ x/^([^=]+)=(.*)$/s);
            if (exists k) {
                r{k} = v ?? "";
            }
        }
        return r;
    }
}

#! Echoes the DataStream records of its request
class EchoHandler inherits AbstractDataStreamRequestHandler {
    private {
        list<auto> records = ();
        int sent = 0;
        string probe;
    }

    constructor(hash<auto> cx, *hash<auto> ah) : AbstractDataStreamRequestHandler(cx, ah) {
        probe = try_it(sub () { cx.socketobject.readHTTPHeader(1s); });
    }

    private nothing recvDataImpl(auto data) {
        records += data;
    }

    private auto sendDataImpl() {
        if (sent < records.size()) {
            return records[sent++];
        }
        if (sent++ == records.size()) {
            return {"probe": probe, "version": cx.hdr.http_version};
        }
    }
}
