        self.results = results;
    }

    start(HttpServerAsyncIo::AbstractSseConnection conn) {
        results.push(\"source \" + get_poll_ops(NOTHING, conn));
        conn.queueEvent(\"source\", \"from the source\");
    }

    stop() {
    }
}

#! describes the poll operations and sockets that the objects of an event stream give
string sub get_poll_ops(*object op, *HttpServerAsyncIo::AbstractSseConnection sse_conn) {
    *object op2;
    if (sse_conn instanceof HttpServerAsyncIo::Http1SseConnection) {
        op2 = cast<HttpServerAsyncIo::Http1SseConnection>(sse_conn).getPollOperation();
    }
    *object s = op ? cast<HttpServerAsyncIo::HttpSseStreamPollOperation>(op).getSocket() : NOTHING;
    *object s2 = op2 ? cast<HttpServerAsyncIo::HttpSseStreamPollOperation>(op2).getSocket() : NOTHING;
    return sprintf(\"op=%s op2=%s sock=%s sock2=%s\", op ? op.className() : \"none\", op2 ? op2.className() : \"none\",
        s ? s.className() : \"none\", s2 ? s2.className() : \"none\");
}

