#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - HTTP/1.1 connections and their sockets, HTTP/2 over TLS and HTTP/3 (QUIC) streams, and sandboxed HTTP handlers
