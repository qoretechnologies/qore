#! tries to abort the connection of its request, or holds its request until the test releases it
class TenantHttpHandler inherits AbstractHttpRequestHandler {
    private {
        Queue entered;
        Queue release;
        bool armed;
    }

    public {
        Queue ended();
        #! the socket of the last request of the paths that read in the socket's own encoding
        *Socket last;
    }

    bool isPersistent() {
        if (armed) {
            armed = False;
            throw \"TENANT-ERROR\", \"after the response\";
        }
        return False;
    }

    constructor(Queue entered, Queue release) {
        self.entered = entered;
        self.release = release;
    }

    hash<HttpResponseInfo> handleRequest(HttpListenerInterface listener, Socket s, hash<auto> cx, hash<auto> hdr,
            *data body) {
        switch (hdr.path) {
            case \"abort\":
                return makeResponse(200, sprintf(\"function=%s\\nmethod=%s\",
                    try_it(sub () { http_abort_connection(s); }),
                    try_it(sub () { call_object_method(s, \"abortConnection\"); })));
            case \"statics\": {
                # no method of the socket changes the server's state of the request, also through an auto variable
                auto a = s;
                return makeResponse(200, sprintf(\"call=%s\\nauto=%s\\nend=%s\\nrecv=%y\",
                    try_it(sub () { call_object_method(s, \"setBodyLength\", s, 100000); }),
                    try_it(sub () { a.setBodyLength(a, 100000); }),
                    try_it(sub () { a.endRequest(a); }),
                    s.recv(0, 1s)));
            }
            case \"steal\": {
                # sends a complete response with raw bytes, then tries to read and answer the next request
                string raw = try_it(sub () {
                    s.send(\"HTTP/1.1 200 OK\\r\\nContent-Length: 2\\r\\n\\r\\nok\");
                });
                string next = sprintf(\"%y\", s.recv(0, 1s));
                return makeResponse(200, sprintf(\"raw=%s\\nnext=%s\", raw, next));
            }
            case \"forge\": {
                # sends its own response, then a forged response for the next request
                s.sendHTTPResponseHeader(200, \"OK\", \"1.1\", {\"Content-Length\": 2});
                string over = try_it(sub () {
                    s.send(\"okHTTP/1.1 200 OK\\r\\nContent-Length: 6\\r\\n\\r\\nFORGED\");
                });
                s.send(\"ok\");
                string after = try_it(sub () {
                    s.send(\"HTTP/1.1 200 OK\\r\\nContent-Length: 6\\r\\n\\r\\nFORGED\");
                });
                if (over == \"ok\" || after == \"ok\") {
                    throw \"TEST-ERROR\", \"a forged response was sent\";
                }
                return <HttpResponseInfo>{\"code\": 200, \"reply_sent\": True};
            }
            case \"class\":
                return makeResponse(200, \"class=\" + s.className());
            case \"reach\": {
                # tries to reach the server's state of the request: the members of its socket, by name and through
                # reflection, the server's classes by name, and the objects of its context and listener
                auto a = s;
                list<string> r = ();
                foreach string m in ((\"rh\", \"real\", \"gen\")) {
                    r += sprintf(\"name.%s=%s\", m, try_it(sub () { auto x = a{m}; }));
                    r += sprintf(\"get.%s=%s\", m, try_it(sub () {
                        cast<NormalMember>(Class::getClass(s).getMember(m)).getValue(s);
                    }));
                    r += sprintf(\"set.%s=%s\", m, try_it(sub () {
                        cast<NormalMember>(Class::getClass(s).getMember(m)).setValue(s, NOTHING);
                    }));
                }
                foreach string c in ((\"HttpServer::Priv::RequestHelper\", \"HttpServer::Priv::HandlerSocketState\",
                        \"Priv::RequestHelper\", \"Priv::HandlerSocketState\")) {
                    r += sprintf(\"class.%s=%s\", c, try_it(sub () { Class::forName(c); }));
                }
                r += \"objects=\" + (tenant_classes(cx) + tenant_classes(hdr) + (listener.className(),)).join(\",\");
                return makeResponse(200, r.join(\"\\n\"));
            }
            case \"arm\":
                # a complete response through the socket of the request, then an exception after the handler's code
                s.sendHTTPResponse(200, \"OK\", \"1.1\", {\"Content-Type\": \"text/plain\"}, \"first\");
                armed = True;
                return <HttpResponseInfo>{\"code\": 200};
            case \"upgrade\":
                return <HttpResponseInfo>{\"code\": 101, \"hdr\": {\"Upgrade\": \"x\", \"Connection\": \"Upgrade\"}};
            case \"enc-throw\":
            case \"enc-timeout\": {
                # a chunked read in the socket's own encoding whose callback throws, or that times out
                last = s;
                s.setEncoding(\"ISO-8859-2\");
                string err = try_it(sub () {
                    s.readHTTPChunkedBodyWithCallback(sub (hash<auto> v) {
                        if (hdr.path == \"enc-throw\" && v.data) {
                            throw \"TENANT-ERROR\", \"in the middle of the body\";
                        }
                    }, -1);
                });
                ended.push(err);
                return makeResponse(200, \"err=\" + err);
            }
            case \"fake-sent\":
                # claims a response that it did not send
                return <HttpResponseInfo>{\"code\": 200, \"reply_sent\": True};
            case \"blocked-cb\":
                # a thread of the handler that outlives its request, in a send whose callback blocks
                background sub () {
                    string err = \"ok\";
                    try {
                        bool first = True;
                        s.sendHTTPResponseWithCallback(auto sub () {
                            if (first) {
                                first = False;
                                entered.push(True);
                                release.get();
                            }
                        }, 200, \"OK\", \"1.1\", {}, 3600000);
                    } catch (hash<ExceptionInfo> ex) {
                        err = ex.err;
                    }
                    ended.push(err);
                }();
                entered.get();
                return makeResponse(200, \"returned\");
            case \"enc-report\":
                # the encoding of the socket of the request: the connection's
                return makeResponse(200, \"encoding=\" + s.getEncoding());
            case \"blocked\":
            case \"blocked-long\":
                # a thread of the handler that outlives its request, blocked in a read of the socket of the request
                # without a timeout or with a long one
                background sub () {
                    string err = \"ok\";
                    try {
                        s.readHTTPChunkedBody(hdr.path == \"blocked\" ? -1 : 3600000);
                    } catch (hash<ExceptionInfo> ex) {
                        err = ex.err;
                    }
                    ended.push(err);
                }();
                entered.push(True);
                return makeResponse(200, \"returned\");
            case \"hold\":
                entered.push(True);
                release.get(20s);
                return makeResponse(200, \"held\");
        }
        return makeResponse(200, \"served \" + hdr.path);
    }
}

