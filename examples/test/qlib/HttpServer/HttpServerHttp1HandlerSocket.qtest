#! an event stream handler that answers its request with a response of its own, then reads the next request
class TenantSseHandler inherits ServerSentEventHandler::ServerSentEventHandler {
    public {
        Queue results();
    }

    constructor() : ServerSentEventHandler::ServerSentEventHandler({\"heartbeat\": 0}) {
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data b) {
        hash<HttpResponseInfo> rv = ServerSentEventHandler::ServerSentEventHandler::handleRequest(cx, hdr, b);
        if (hdr.path == \"events-framed\") {
            # framing fields and a connection option in other cases than the server's
            rv.hdr += {\"Content-Length\": \"5\", \"transfer-ENCODING\": \"chunked\", \"CONNECTION\": \"keep-alive\"};
        }
        return rv;
    }

    #! the socket that the connection is made with is the only socket that the handler gets for the stream
    ServerSentEventConnection getConnectionImpl(Socket sock, hash<auto> cx, hash<auto> hdr, string cid) {
        try {
            sock.send(\"HTTP/1.1 200 OK\\r\\nContent-Length: 2\\r\\n\\r\\nOK\");
            results.push(sprintf(\"%y\", sock.recv(-1, 1s)));
        } catch (hash<ExceptionInfo> ex) {
            results.push(ex.err);
        }
        return ServerSentEventHandler::ServerSentEventHandler::getConnectionImpl(sock, cx, hdr, cid);
    }
}

AbstractHttpRequestHandler sub get_sse_handler() {
    return new TenantSseHandler();
}

#! an event stream handler that looks for the connection's socket in what its connection and its event source get
#! (qore#7376)
class TenantSseSocketHandler inherits ServerSentEventHandler::ServerSentEventHandler {
    public {
        Queue results();
        Queue conns();
    }

    constructor() : ServerSentEventHandler::ServerSentEventHandler({\"heartbeat\": 0}) {
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data b) {
        hash<HttpResponseInfo> rv = ServerSentEventHandler::ServerSentEventHandler::handleRequest(cx, hdr, b);
        if (hdr.path == \"events-source\") {
            rv.sse_source = new TenantSseSource(results);
        }
        return rv;
    }

    HttpServerAsyncIo::HttpSseStreamPollOperation setupAsyncSseConnection(Socket sock, hash<auto> cx,
            hash<auto> hdr, string cid) {
        results.push(\"setup=\" + sock.className());
        return ServerSentEventHandler::ServerSentEventHandler::setupAsyncSseConnection(sock, cx, hdr, cid);
    }

    ServerSentEventConnection getConnectionImpl(Socket sock, hash<auto> cx, hash<auto> hdr, string cid) {
        results.push(\"conn=\" + sock.className());
        return ServerSentEventHandler::ServerSentEventHandler::getConnectionImpl(sock, cx, hdr, cid);
    }

    connectionRegisteredImpl(ServerSentEventConnection conn) {
        results.push(\"registered \" + get_poll_ops(conn.getAsyncPollOp(), conn.getAsyncSseConnection()));
        if (conn.hdr.path == \"events-throw\") {
            throw \"TENANT-ERROR\", \"the hook fails after the connection was registered\";
        }
        conns.push(conn);
    }

    deregisterConnectionImpl(ServerSentEventConnection conn) {
        if (conn.hdr.path == \"events-throw\") {
            results.push(\"deregistered\");
        }
    }
}

