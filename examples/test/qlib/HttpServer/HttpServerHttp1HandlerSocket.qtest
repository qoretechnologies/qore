}

#! a socket handler that is not a WebSocketHandler and declares the method that sets up the connection of a handler
#! that gets the socket of its request, to get what the server gives it (qore#7476)
class TenantFakeWsHandler inherits AbstractHttpSocketHandler {
    public {
        Queue results();
    }

    hash<HttpResponseInfo> handleRequest(HttpListenerInterface listener, Socket s, hash<auto> cx, hash<auto> hdr,
            *data body) {
        return <HttpResponseInfo>{
            \"code\": 101,
            \"hdr\": {
                \"Upgrade\": \"websocket\",
                \"Connection\": \"Upgrade\",
            },
        };
    }

    bool startAsyncWebSocketForRequest(softstring lid, hash<auto> cx, hash<auto> hdr, Socket s, auto op) {
        list<string> got = ();
        got += \"class=\" + op.className();
        foreach string m in ((\"getSocket\", \"getPollOperation\", \"getOutput\", \"continuePoll\")) {
            try {
                auto v = call_object_method(op, m);
                got += m + \"=\" + (v.typeCode() == NT_OBJECT ? v.className() : v.type());
            } catch (hash<ExceptionInfo> ex) {
                got += m + \"=\" + ex.err;
            }
        }
        try {
            got += \"op=\" + op.op.className();
        } catch (hash<ExceptionInfo> ex) {
            got += \"op=\" + ex.err;
        }
        try {
            got += \"get.op=\" + cast<NormalMember>(Class::getClass(op).getMember(\"op\")).getValue(op).className();
        } catch (hash<ExceptionInfo> ex) {
            got += \"get.op=\" + ex.err;
        }
        try {
            cast<NormalMember>(Class::getClass(op).getMember(\"op\")).setValue(op, NOTHING);
            got += \"set.op=ok\";
        } catch (hash<ExceptionInfo> ex) {
            got += \"set.op=\" + ex.err;
        }
        results.push(got.join(\" \"));
        return False;
    }

    private bool startImpl(softstring lid, hash<auto> cx, hash<auto> hdr, Socket s) {
        results.push(\"startImpl\");
        return False;
    }
}

