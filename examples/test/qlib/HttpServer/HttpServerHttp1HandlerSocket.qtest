#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - HTTP/1.1 connections and their sockets, HTTP/2 over TLS and HTTP/3 (QUIC) streams, and sandboxed HTTP handlers
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires HttpServer
%requires HttpServerUtil
%requires HttpServerAsyncIo
%requires HttpClientIo
%requires RestHandler
%requires WebSocketHandler
%requires WebSocketClient
%requires ServerSentEventHandler
%requires DataStreamUtil
%requires DataStreamRequestHandler
%requires DataStreamClient
%requires Mime
%requires Logger
%requires RestSchemaValidator
%requires yaml
%requires ../../TestCertificates.qm

%exec-class HttpServerHttp1HandlerSocketTest

#! a hang guard only, never a timing assertion
const HangGuard = 20s;

#! Returns "ok" or the error of the call
string sub try_it(code c) {
    try {
        c();
        return "ok";
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
}

#! Returns the classes of the sockets in a value, its hashes and its lists; an object is not entered
list<string> sub find_sockets(auto v) {
    list<string> rv = ();
    switch (v.typeCode()) {
        case NT_HASH:
            foreach auto e in (v.values()) {
                rv += find_sockets(e);
            }
            break;
        case NT_LIST:
            foreach auto e in (v) {
                rv += find_sockets(e);
            }
            break;
        case NT_OBJECT:
            if (v instanceof Socket) {
                rv += v.className();
            }
            break;
    }
    return rv;
}

#! Tries the socket of its request in the way that its path names; answers with the results, one "key=value" a line
class ProbeHandler inherits AbstractHttpRequestHandler {
    public {
        #! the socket of a request that the "keep" path keeps
        Queue kept();
    }

    #! a trusted handler that asks for the socket of its request, as a base class of handlers whose subclasses pass
    #! it to code that is not trusted does
    constructor() {
        setHandlerSocketView();
    }

    hash<HttpResponseInfo> handleRequest(HttpListenerInterface listener, Socket s, hash<auto> cx, hash<auto> hdr,
            *data body) {
        hash<string, string> r;
        switch (hdr.path) {
            case "header": {
                # the next request on the connection
                r.header = try_it(sub () { s.readHTTPHeader(1s); });
                r.header_string = try_it(sub () { s.readHTTPHeaderString(1s); });
                break;
            }
            case "recv": {
                # the server read the request's body: no data, also with a request after it on the connection
                r.recv = sprintf("%y", s.recv(0, 1s));
                r.recv_size = sprintf("%y", s.recv(16, 1s));
                r.recv_binary = string(s.recvBinary(16, 1s).size());
                r.recvi4 = try_it(sub () { s.recvi4(1s); });
                r.body = sprintf("%y", body);
                break;
            }
            case "close": {
                r.shutdown = try_it(sub () { s.shutdown(); });
                r.close = try_it(sub () { s.close(); });
                r.shutdown_write = try_it(sub () { s.shutdownWrite(); });
                r.open = sprintf("%y", s.isOpen());
                break;
            }
            case "chunked": {
                # a chunked body is read by its chunks only, once
                r.pending = sprintf("%y", s.pendingHttpChunkedBody());
                r.recv = try_it(sub () { s.recv(1, 1s); });
                hash<auto> chunked = s.readHTTPChunkedBody(HangGuard);
                r.body = sprintf("%y", chunked.body);
                r.again = try_it(sub () { s.readHTTPChunkedBody(1s); });
                r.after = sprintf("%y", s.recv(0, 1s));
                r.pending_after = sprintf("%y", s.pendingHttpChunkedBody());
                break;
            }
            case "chunked-callback": {
                list<string> chunks;
                s.readHTTPChunkedBodyWithCallback(sub (hash<auto> v) {
                    if (v.data) {
                        chunks += v.data;
                    }
                }, HangGuard);
                r.body = chunks.join("");
                r.again = try_it(sub () { s.readHTTPChunkedBodyBinaryWithCallback(sub (hash<auto> v) {}, 1s); });
                break;
            }
            case "other": {
                r.connect = try_it(sub () { s.connect("localhost:1", 1s); });
                r.bind = try_it(sub () { s.bind(0); });
                r.listen = try_it(sub () { s.listen(); });
                r.accept = try_it(sub () { s.accept(1s); });
                r.upgrade = try_it(sub () { s.upgradeServerToSSL(1s); });
                r.fd = try_it(sub () { s.getPollableDescriptor(); });
                r.timeout = try_it(sub () { s.setRecvTimeout(1s); });
                r.timeout_value = string(s.getRecvTimeout());
                r.copy = try_it(sub () { s.copy(); });
                r.peer = s.getPeerInfo(False).address;
                # another socket than the handler's own is not aborted
                r.abort_other = try_it(sub () { http_abort_connection(new Socket()); });
                r.socket = s.getSocketInfo(False).address;
                r.encoding = s.getEncoding();
                r.http2 = sprintf("%y", s.isHttp2());
                break;
            }
            case "keep": {
                kept.push(s);
                r.kept = "yes";
                break;
            }
            case "stale": {
                # the socket of an earlier request on the connection
                Socket old = kept.get(HangGuard);
                r.send = try_it(sub () { old.send("HTTP/1.1 200 OK\r\nContent-Length: 6\r\n\r\nFORGED"); });
                r.recv = try_it(sub () { old.recv(0, 1s); });
                r.abort = try_it(sub () { http_abort_connection(old); });
                r.open = sprintf("%y", old.isOpen());
                break;
            }
            case "framing": {
                # the framing of a response header that the socket refuses; nothing is sent
                list<hash<auto>> bad = (
                    {"Content-Length": 2, "content-length": 2},
                    {"Content-Length": (2, 2)},
                    {"Content-Length": "2x"},
                    {"Content-Length": -1},
                    {"Content-Length": 2, "Transfer-Encoding": "chunked"},
                    {"Transfer-Encoding": "gzip"},
                    {"Content-Type": "text/plain"},
                );
                int i = 0;
                foreach hash<auto> h in (bad) {
                    r{"bad" + i++} = try_it(sub () { s.sendHTTPResponseHeader(200, "OK", "1.1", h); });
                }
                r.full_te = try_it(sub () {
                    s.sendHTTPResponse(200, "OK", "1.1", {"Transfer-Encoding": "chunked"}, "x");
                });
                r.raw_first = try_it(sub () { s.send("HTTP/1.1 200 OK\r\nContent-Length: 6\r\n\r\nFORGED"); });
                r.upgrade = try_it(sub () { s.sendHTTPResponseHeader(101, "Switching Protocols", "1.1", {}); });
                r.from_stream = try_it(sub () { s.sendFromInputStream(new BinaryInputStream(binary("x")), 1); });
                break;
            }
            case "length": {
                # a response with a Content-Length that the handler sends in parts; no more than its length
                s.sendHTTPResponseHeader(200, "OK", "1.1", {"Content-Length": 10, "Content-Type": "text/plain"});
                s.send("01234");
                string over = try_it(sub () { s.send("56789XHTTP/1.1 200 OK\r\nContent-Length: 6\r\n\r\nFORGED"); });
                s.send("56789");
                string after = try_it(sub () { s.send("HTTP/1.1 200 OK\r\nContent-Length: 6\r\n\r\nFORGED"); });
                string again = try_it(sub () { s.sendHTTPResponse(200, "OK", "1.1", {}, "FORGED"); });
                if (over == "ok" || after == "ok" || again == "ok") {
                    throw "TEST-ERROR", sprintf("a send past the response: %y %y %y", over, after, again);
                }
                return <HttpResponseInfo>{"code": 200, "reply_sent": True};
            }
            case "chunked-response": {
                # a chunked response that the handler sends after its header; raw bytes are refused
                s.sendHTTPResponseHeader(200, "OK", "1.1", {"Transfer-Encoding": "chunked"});
                string raw = try_it(sub () { s.send("5\r\nFORGE\r\n"); });
                s.sendHTTPChunkedBodyFromInputStream(new BinaryInputStream(binary("chunked " + raw)));
                string after = try_it(sub () { s.sendHTTPChunkedBodyTrailer(); });
                if (after == "ok") {
                    throw "TEST-ERROR", "a second end of the chunked body";
                }
                return <HttpResponseInfo>{"code": 200, "reply_sent": True};
            }
            case "unmarked": {
                # the handler sends its response and returns another one without reply_sent: the server sends no
                # second response
                s.sendHTTPResponse(200, "OK", "1.1", {"Content-Type": "text/plain"}, "the handler's");
                return makeResponse(200, "SECOND");
            }
            case "incomplete": {
                # the handler sends a part of its response: the server closes the connection after it
                s.sendHTTPResponseHeader(200, "OK", "1.1", {"Content-Length": 10});
                s.send("012");
                return <HttpResponseInfo>{"code": 200, "reply_sent": True};
            }
            case "interim": {
                # interim responses before the final response, which the server sends
                s.sendHTTPResponseHeader(103, "Early Hints", "1.1", {"Link": "</a.css>; rel=preload"});
                s.sendHTTPResponse(100, "Continue", "1.1", {}, "");
                return makeResponse(200, "final");
            }
            case "interim-own": {
                # interim responses before the final response, which the handler sends
                s.sendHTTPResponse(103, "Early Hints", "1.1", {"Link": "</a.css>; rel=preload"}, "");
                s.sendHTTPResponse(200, "OK", "1.1", {"Content-Type": "text/plain"}, "final");
                return <HttpResponseInfo>{"code": 200, "reply_sent": True};
            }
            case "head": {
                # the response to a HEAD request has no body; its header is the complete response
                r.full = try_it(sub () { s.sendHTTPResponse(200, "OK", "1.1", {}, "FORGED"); });
                s.sendHTTPResponseHeader(200, "OK", "1.1", {"Content-Length": 7});
                string after = try_it(sub () { s.send("FORGED!"); });
                if (r.full == "ok" || after == "ok") {
                    throw "TEST-ERROR", sprintf("a body in the response to a HEAD request: %y %y", r.full, after);
                }
                return <HttpResponseInfo>{"code": 200, "reply_sent": True};
            }
            case "http10": {
                # an HTTP/1.0 request gets no chunked response and no interim response
                r.chunked = try_it(sub () {
                    s.sendHTTPResponseHeader(200, "OK", "1.1", {"Transfer-Encoding": "chunked"});
                });
                r.callback = try_it(sub () {
                    s.sendHTTPResponseWithCallback(sub () {}, 200, "OK", "1.1", {});
                });
                r.interim = try_it(sub () { s.sendHTTPResponseHeader(100, "Continue", "1.1", {}); });
                break;
            }
            case "encoding": {
                # the socket's encoding is its own: the connection's does not change
                r.before = s.getEncoding();
                s.setEncoding("ISO-8859-2");
                r.after = s.getEncoding();
                break;
            }
            case "statics": {
                # no method of the socket changes the server's state of the request
                r.set_body = try_it(sub () { call_object_method(s, "setBodyLength", s, 100000); });
                r.end = try_it(sub () { call_object_method(s, "endRequest", s); });
                r.start = try_it(sub () { call_object_method(s, "h1Start", False, False); });
                r.take = try_it(sub () { call_object_method(s, "takeBody", 100000); });
                r.recv = sprintf("%y", s.recv(0, 1s));
                break;
            }
            case "proto": {
                return makeResponse(200, sprintf("http2=%y", cx."header-info".http2 ?? False));
            }
            case "stream-statics": {
                # no method of the socket of an HTTP/2 or HTTP/3 request changes the server's state of the request
                return makeResponse(200, sprintf("mark=%s has=%s",
                    try_it(sub () { call_object_method(s, "markResponseStarted", s); }),
                    try_it(sub () { call_object_method(s, "hasResponseStarted", s); })));
            }
            case "abort-stream": {
                # the socket of an HTTP/2 request ends the request's own stream
                http_abort_connection(s);
                return makeResponse(200, "not sent");
            }
            case "context": {
                # the socket of the request is the only one that its handler gets
                r.sockets = find_sockets({"cx": cx, "hdr": hdr}).join(",");
                r.own = s.className();
                break;
            }
            case "self": {
                # the handler sends its own response, once
                s.sendHTTPResponse(200, "OK", "1.1", {"Content-Type": "text/plain"}, "sent by the handler");
                string again = try_it(sub () { s.sendHTTPResponse(200, "OK", "1.1", {}, "FORGED"); });
                string raw = try_it(sub () { s.send("FORGED"); });
                if (again == "ok" || raw == "ok") {
                    throw "TEST-ERROR", sprintf("a second response was sent: %y %y", again, raw);
                }
                return <HttpResponseInfo>{"code": 200, "reply_sent": True};
            }
            default: {
                return makeResponse(200, sprintf("served %s", hdr.path));
            }
        }
        return makeResponse(200, (map $1.key + "=" + $1.value, r.pairIterator()).join("\n"));
    }
}

#! A trusted handler that does not ask for the socket of its request: it gets the connection's socket
class PlainHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(HttpListenerInterface listener, Socket s, hash<auto> cx, hash<auto> hdr,
            *data body) {
        return makeResponse(200, "class=" + s.className());
    }
}

#! Holds its request until the test releases it
class HoldHandler inherits AbstractHttpRequestHandler {
    public {
        Queue entered();
        Queue release();
    }

    hash<HttpResponseInfo> handleRequest(HttpListenerInterface listener, Socket s, hash<auto> cx, hash<auto> hdr,
            *data body) {
        entered.push(True);
        release.get(HangGuard);
        return makeResponse(200, "held");
    }
}

#! Reports how the body of its request arrived and what its socket gives
class StreamBodyRequest inherits AbstractStreamRequest {
    private {
        int ctor_size;
        int parts;
        int bytes;
        *Queue grabbed;
    }

    constructor(HttpListenerInterface listener, AbstractHttpRequestHandler handler, Socket s, hash<auto> cx,
            hash<auto> hdr, auto body, *Queue grabbed) : AbstractStreamRequest(listener, handler, s, cx, hdr, body) {
        ctor_size = body.size();
        self.grabbed = grabbed;
    }

    private nothing recvImpl(hash<auto> v) {
        if (v.data) {
            if (grabbed && !parts) {
                # the handler reads far more than the rest of the body through the socket of its request
                grabbed.push(s.recvBinary(100 * 1024 * 1024, HangGuard).size());
            }
            ++parts;
            bytes += v.data.size();
        }
    }

    private auto sendImpl() {
    }

    private hash<HttpResponseInfo> getResponseHeaderMessageImpl() {
        # after the body, the socket of the request gives no data, also with a request after it on the connection
        int recv_size = s.recvBinary(16, 1s).size();
        return <HttpResponseInfo>{
            "code": 200,
            "body": sprintf("ctor=%d\nparts=%d\nbytes=%d\nrecv=%d", ctor_size, parts, bytes, recv_size),
        };
    }
}

#! A stream handler that wants a body with a Content-Length as a stream (qore#7308)
class StreamBodyHandler inherits AbstractHttpRequestHandler {
    public {
        #! the size that a request of the "stream-grab" path read through its socket
        Queue grabbed();
    }

    constructor() : AbstractHttpRequestHandler(NOTHING, True) {
        setHandlerSocketView();
    }

    bool wantsBodyStreaming(hash<auto> cx, hash<auto> hdr) {
        return True;
    }

    private AbstractStreamRequest getStreamRequestImpl(HttpListenerInterface listener, Socket s, hash<auto> cx,
            hash<auto> hdr, *data body) {
        return new StreamBodyRequest(listener, self, s, cx, hdr, body, hdr.path == "stream-grab" ? grabbed : NOTHING);
    }
}

#! hands each registered event stream to the test
class RegisteringSseHandler inherits ServerSentEventHandler::ServerSentEventHandler {
    public {
        Queue registered();
    }

    constructor() : ServerSentEventHandler::ServerSentEventHandler({"heartbeat": 0}) {
    }

    connectionRegisteredImpl(ServerSentEventHandler::ServerSentEventConnection conn) {
        registered.push(conn);
    }
}

#! Reports the sockets that the application code of a WebSocket connection gets
class ScanWebSocketHandler inherits WebSocketHandler {
    public {
        Queue scans();
    }

    WebSocketConnection getConnectionImpl(hash<auto> cx, hash<auto> hdr, string cid) {
        scans.push({"sockets": find_sockets({"cx": cx, "hdr": hdr}), "version": hdr.http_version});
        return WebSocketHandler::getConnectionImpl(cx, hdr, cid);
    }
}

#! Forwards to the server's target; keeps the information of each request as the server gives it to its target
class RecordingTarget inherits HttpServerAsyncIo::HttpAsyncTarget {
    public {
        Queue requests();
    }

    private {
        HttpServerAsyncIo::HttpAsyncTarget target;
    }

    constructor(HttpServerAsyncIo::HttpAsyncTarget target) {
        self.target = target;
    }

    hash<HttpServerAsyncIo::HttpRequestResultInfo> onHttpRequest(hash<HttpServerAsyncIo::HttpConnectionInfo> info) {
        requests.push(info);
        return target.onHttpRequest(info);
    }

    onIdleTimeout(Socket sock, *HttpListenerInterface listener, hash<auto> cx) {
        target.onIdleTimeout(sock, listener, cx);
    }

    onError(Socket sock, hash<ExceptionInfo> ex, *HttpListenerInterface listener, *hash<auto> cx) {
        target.onError(sock, ex, listener, cx);
    }

    onSseDisconnect(Socket sock, *HttpListenerInterface listener, hash<auto> cx) {
        target.onSseDisconnect(sock, listener, cx);
    }

    onWebSocketFrame(Socket sock, hash<HttpServerAsyncIo::WebSocketFrameInfo> frame,
            *HttpListenerInterface listener, hash<auto> cx) {
        target.onWebSocketFrame(sock, frame, listener, cx);
    }

    onWebSocketClose(Socket sock, int code, string reason, *HttpListenerInterface listener, hash<auto> cx) {
        target.onWebSocketClose(sock, code, reason, listener, cx);
    }

    onPersistentRequestEnd(hash<HttpServerAsyncIo::HttpConnectionInfo> info) {
        target.onPersistentRequestEnd(info);
    }

    *hash<HttpServerAsyncIo::HttpRequestResultInfo> tryInlineRequest(
            hash<HttpServerAsyncIo::HttpConnectionInfo> info) {
        return target.tryInlineRequest(info);
    }

    *hash<HttpServerAsyncIo::HttpRequestResultInfo> prepareHttpRequest(
            hash<HttpServerAsyncIo::HttpConnectionInfo> info) {
        return target.prepareHttpRequest(info);
    }

    cancelPreparedHttpRequest(hash<HttpServerAsyncIo::HttpConnectionInfo> info) {
        target.cancelPreparedHttpRequest(info);
    }

    auto saveDispatchContext() {
        return target.saveDispatchContext();
    }

    restoreDispatchContext(auto save_data) {
        target.restoreDispatchContext(save_data);
    }
}

#! A server whose target keeps the information of each request, as a framework's target does to abort a request
class RecordingServer inherits HttpServer {
    public {
        RecordingTarget recording;
    }

    constructor() : HttpServer(<HttpServerOptionInfo>{}) {
        recording = new RecordingTarget(asyncTarget);
        asyncTarget = recording;
    }
}

#! Echoes the DataStream records of its request, with a timeout of its stream (qore#7305 review)
class TimeoutEchoHandler inherits EchoHandler {
    constructor(hash<auto> cx, *hash<auto> ah) : EchoHandler(cx, ah) {
        setTimeout(20s);
    }
}

#! answers with 401 before its handler gets the request; keeps the request's body reader
class EarlyAnswerHandler inherits StreamBodyHandler {
    public {
        Queue readers();
    }

    *hash<HttpResponseInfo> authenticateRequest(HttpListenerInterface listener, hash<auto> hdr, reference<hash> cx) {
        readers.push(cx."header-info".body_reader);
        return <HttpResponseInfo>{"code": 401, "body": "refused"};
    }
}

#! The REST class of the DataStream records of the test, with its stream handler
class EchoRestClass inherits AbstractRestClass {
    private {
        code get_handler;
    }

    constructor(code get_handler) {
        self.get_handler = get_handler;
    }

    string name() {
        return "echo";
    }

    AbstractRestStreamRequestHandler streamPost(hash<auto> cx, *hash<auto> ah) {
        return get_handler(cx, ah);
    }
}

#! The handlers of HTTP/1.1 requests get a socket that acts on the connection for their own request only (qore#7305)
/** The server keeps the connection's socket: the handler's socket cannot read the next request on the connection,
    nor read past the request's own body, nor shut the connection down or close it; it sends the request's own
    response, once, and ends when the handler's code returns.  A DataStream handler streams through it, also one of
    a sandboxed Program
*/
class HttpServerHttp1HandlerSocketTest inherits QUnit::Test {
    public {
        #! a sandboxed tenant's DataStream handler
        const TenantSource = "%modern
%requires HttpServer
%requires HttpServerUtil
%requires RestHandler
%requires DataStreamUtil
%requires DataStreamRequestHandler

class TenantEchoHandler inherits AbstractDataStreamRequestHandler {
    private {
        list<auto> records = ();
        int sent = 0;
        string probe;
    }

    constructor(hash<auto> cx, *hash<auto> ah) : AbstractDataStreamRequestHandler(cx, ah) {
        probe = probe_socket(cx);
    }

    private nothing recvDataImpl(auto data) {
        records += data;
    }

    private auto sendDataImpl() {
        if (sent < records.size()) {
            return records[sent++];
        }
        if (sent++ == records.size()) {
            return {\"probe\": probe, \"version\": cx.hdr.http_version};
        }
    }
}

string sub probe_socket(hash<auto> cx) {
    try {
        cx.socketobject.readHTTPHeader(1s);
        return \"read\";
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
}

AbstractRestStreamRequestHandler sub get_handler(hash<auto> cx, *hash<auto> ah) {
    return new TenantEchoHandler(cx, ah);
}

string sub try_it(code c) {
    try {
        c();
        return \"ok\";
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
}

#! tries to abort the connection of its request, or holds its request until the test releases it
class TenantHttpHandler inherits AbstractHttpRequestHandler {
    private {
        Queue entered;
        Queue release;
    }

    constructor(Queue entered, Queue release) {
        self.entered = entered;
        self.release = release;
    }

    hash<HttpResponseInfo> handleRequest(HttpListenerInterface listener, Socket s, hash<auto> cx, hash<auto> hdr,
            *data body) {
        switch (hdr.path) {
            case \"abort\":
                return makeResponse(200, sprintf(\"function=%s\\nmethod=%s\",
                    try_it(sub () { http_abort_connection(s); }),
                    try_it(sub () { call_object_method(s, \"abortConnection\"); })));
            case \"statics\": {
                # no method of the socket changes the server's state of the request, also through an auto variable
                auto a = s;
                return makeResponse(200, sprintf(\"call=%s\\nauto=%s\\nend=%s\\nrecv=%y\",
                    try_it(sub () { call_object_method(s, \"setBodyLength\", s, 100000); }),
                    try_it(sub () { a.setBodyLength(a, 100000); }),
                    try_it(sub () { a.endRequest(a); }),
                    s.recv(0, 1s)));
            }
            case \"steal\": {
                # sends a complete response with raw bytes, then tries to read and answer the next request
                string raw = try_it(sub () {
                    s.send(\"HTTP/1.1 200 OK\\r\\nContent-Length: 2\\r\\n\\r\\nok\");
                });
                string next = sprintf(\"%y\", s.recv(0, 1s));
                return makeResponse(200, sprintf(\"raw=%s\\nnext=%s\", raw, next));
            }
            case \"forge\": {
                # sends its own response, then a forged response for the next request
                s.sendHTTPResponseHeader(200, \"OK\", \"1.1\", {\"Content-Length\": 2});
                string over = try_it(sub () {
                    s.send(\"okHTTP/1.1 200 OK\\r\\nContent-Length: 6\\r\\n\\r\\nFORGED\");
                });
                s.send(\"ok\");
                string after = try_it(sub () {
                    s.send(\"HTTP/1.1 200 OK\\r\\nContent-Length: 6\\r\\n\\r\\nFORGED\");
                });
                if (over == \"ok\" || after == \"ok\") {
                    throw \"TEST-ERROR\", \"a forged response was sent\";
                }
                return <HttpResponseInfo>{\"code\": 200, \"reply_sent\": True};
            }
            case \"class\":
                return makeResponse(200, \"class=\" + s.className());
            case \"hold\":
                entered.push(True);
                release.get(20s);
                return makeResponse(200, \"held\");
        }
        return makeResponse(200, \"served \" + hdr.path);
    }
}

AbstractHttpRequestHandler sub get_http_handler(Queue entered, Queue release) {
    return new TenantHttpHandler(entered, release);
}

#! runs code for the tenant, as a framework does on a thread that serves the tenant's request
nothing sub run_code(code c) {
    c();
}
";
    }

    private {
        HttpServer server;
        ProbeHandler probe();
        StreamBodyHandler stream_handler();
        int port;
    }

    constructor() : QUnit::Test("HTTP/1.1 handler socket", "1.0", \ARGV) {
        server = new HttpServer(<HttpServerOptionInfo>{});
        server.setHandler("probe", "", NOTHING, probe);
        server.setHandler("stream", "^stream", NOTHING, stream_handler);
        server.setDefaultHandler("probe", probe);
        port = server.addListener(<HttpListenerOptionInfo>{"node": "localhost", "service": 0}).port;
        server.waitForAsyncIo();

        addTestCase("the next request is not read", \nextRequestTest());
        addTestCase("no data past the body", \recvTest());
        addTestCase("a body split across reads", \splitBodyTest());
        addTestCase("the connection is not closed", \closeTest());
        addTestCase("a chunked body", \chunkedTest());
        addTestCase("a chunked body read with a callback", \chunkedCallbackTest());
        addTestCase("other methods", \otherTest());
        addTestCase("the socket ends with its request", \staleTest());
        addTestCase("the handler's own response", \selfResponseTest());
        addTestCase("DataStream", \dataStreamTest());
        addTestCase("DataStream of a sandboxed handler", \sandboxedDataStreamTest());
        addTestCase("the request context", \contextTest());
        addTestCase("a Content-Length body to a stream handler", \streamBodyTest(), DefaultBodyStreamThreshold * 2);
        addTestCase("a Content-Length body read before the dispatch to a stream handler", \streamBodyTest(),
            DefaultBodyStreamThreshold / 2);
        addTestCase("a stream handler reads no more than its body", \streamGrabTest());
        addTestCase("sandboxed code cannot abort the connection", \sandboxedAbortTest());
        addTestCase("the server's target aborts a request", \targetAbortTest());
        addTestCase("WebSocket", \webSocketTest());
        addTestCase("the framing of a response that the handler sends", \framingTest());
        addTestCase("a response with a Content-Length in parts", \lengthResponseTest());
        addTestCase("a chunked response", \chunkedResponseTest());
        addTestCase("a response that the handler sent is not sent again", \unmarkedResponseTest());
        addTestCase("an incomplete response closes the connection", \incompleteResponseTest());
        addTestCase("interim responses", \interimTest());
        addTestCase("the response to a HEAD request", \headTest());
        addTestCase("an HTTP/1.0 request", \http10Test());
        addTestCase("the socket's encoding is its own", \encodingTest());
        addTestCase("no method changes the server's state", \staticsTest());
        addTestCase("sandboxed code changes no server state", \sandboxedStaticsTest());
        addTestCase("sandboxed code cannot read or answer the next request", \sandboxedStealTest());
        addTestCase("sandboxed code cannot forge a response", \sandboxedForgeTest());
        addTestCase("a REST stream with a timeout", \restTimeoutTest());
        addTestCase("the socket ends when the request is answered early", \earlyAnswerTest());
        addTestCase("an HTTP/1.1 event stream ends with its connection", \sseTest());
        addTestCase("the handlers that get the socket of their request", \whichHandlersTest());
        addTestCase("the base classes that give the socket to other code ask for it", \baseClassesTest());
        addTestCase("a kept socket does not keep the server", \keptSocketTest());
        addTestCase("the abort of an HTTP/2 request's stream", \streamAbortTest(), "h2");
        addTestCase("the abort of an HTTP/3 request's stream", \streamAbortTest(), "h3");
        set_return_value(main());
        delete server;
    }

    #! the next request is unreachable through the handler's socket, and is then served
    nextRequestTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("GET /header HTTP/1.1\r\nHost: localhost\r\n\r\n"
            "GET /second HTTP/1.1\r\nHost: localhost\r\nX-Token: next-request\r\n\r\n");
        hash<auto> r = parse(readResponse(c));
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.header);
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.header_string);
        assertEq("served second", readResponse(c), "the next request is served");
    }

    #! reads past the request's body give no data
    recvTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("POST /recv HTTP/1.1\r\nHost: localhost\r\nContent-Type: text/plain\r\nContent-Length: 4\r\n\r\nbody"
            "GET /second HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> r = parse(readResponse(c));
        assertEq("\"\"", r.recv);
        assertEq("\"\"", r.recv_size);
        assertEq("0", r.recv_binary);
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.recvi4);
        assertEq("\"body\"", r.body, "the handler gets the request's body");
        assertEq("served second", readResponse(c), "the next request is served");
    }

    #! a body sent in two parts is read by the server; the handler's socket gives no data
    splitBodyTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("POST /recv HTTP/1.1\r\nHost: localhost\r\nContent-Type: text/plain\r\nContent-Length: 8\r\n\r\nfirs");
        c.send("t ok");
        hash<auto> r = parse(readResponse(c));
        assertEq("\"first ok\"", r.body);
        assertEq("\"\"", r.recv);
        assertEq("\"\"", r.recv_size);
    }

    #! the handler's socket cannot shut the connection down or close it
    closeTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("GET /close HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> r = parse(readResponse(c));
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.shutdown);
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.close);
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.shutdown_write);
        assertEq("True", r.open);
        c.send("GET /after HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq("served after", readResponse(c), "the connection serves the next request");
    }

    #! a chunked body is read by its chunks, once, up to its end
    chunkedTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("POST /chunked HTTP/1.1\r\nHost: localhost\r\nContent-Type: text/plain\r\n"
            "Transfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n6\r\n world\r\n0\r\n\r\n"
            "GET /second HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> r = parse(readResponse(c));
        assertEq("True", r.pending);
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.recv, "a chunked body is not read by its bytes");
        assertEq("\"hello world\"", r.body);
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.again, "the chunked body is read once");
        assertEq("\"\"", r.after);
        assertEq("False", r.pending_after);
        assertEq("served second", readResponse(c), "the next request is served");
    }

    #! a chunked body read with a callback
    chunkedCallbackTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("POST /chunked-callback HTTP/1.1\r\nHost: localhost\r\nContent-Type: text/plain\r\n"
            "Transfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n3\r\ndef\r\n0\r\n\r\n"
            "GET /second HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> r = parse(readResponse(c));
        assertEq("abcdef", r.body);
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.again);
        assertEq("served second", readResponse(c), "the next request is served");
    }

    #! the methods that would act on the connection otherwise are refused; its information is given
    otherTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("GET /other HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> r = parse(readResponse(c));
        foreach string k in (("connect", "bind", "listen", "accept", "upgrade", "fd", "copy", "abort_other")) {
            assertEq("HTTP-HANDLER-SOCKET-ERROR", r{k}, k);
        }
        assertEq(c.getSocketInfo(False).address, r.peer, "the peer's address");
        assertEq(c.getPeerInfo(False).address, r.socket, "the connection's address");
        assertEq("False", r.http2);
        assertEq("ok", r.timeout, "the socket's own timeout is set");
        assertEq("1000", r.timeout_value, "the socket's own timeout");
        assertTrue(r.encoding.val());
        c.send("GET /after HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq("served after", readResponse(c), "the connection serves the next request");
    }

    #! the socket of a request ends when the handler returns: it cannot send into a later response
    staleTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("GET /keep HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq({"kept": "yes"}, parse(readResponse(c)));
        c.send("GET /stale HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> r = parse(readResponse(c));
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.send);
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.recv);
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.abort, "the ended socket does not abort the connection");
        assertEq("False", r.open);
        c.send("GET /after HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq("served after", readResponse(c), "the connection serves the next request");
    }

    #! the handler sends one response of its own
    selfResponseTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("GET /self HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq("sent by the handler", readResponse(c));
        c.send("GET /after HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq("served after", readResponse(c), "the connection serves the next request");
    }

    #! a DataStream handler streams through the socket of its HTTP/1.1 request
    dataStreamTest() {
        list<auto> rv = dataStreamIntern(auto sub (hash<auto> cx, *hash<auto> ah) { return new EchoHandler(cx, ah); },
            "echo");
        assertEq({"probe": "HTTP-HANDLER-SOCKET-ERROR", "version": "1.1"}, rv.last(), "the handler's socket");
    }

    #! a DataStream handler of a sandboxed Program streams through the socket of its HTTP/1.1 request, which
    #! refuses to read the next request
    sandboxedDataStreamTest() {
        Program p = getTenantProgram();
        list<auto> rv = dataStreamIntern(auto sub (hash<auto> cx, *hash<auto> ah) {
            return p.callFunction("get_handler", cx, ah);
        }, "tenant");
        assertEq({"probe": "HTTP-HANDLER-SOCKET-ERROR", "version": "1.1"}, rv.last(),
            "the sandboxed handler's socket");
    }

    private list<auto> dataStreamIntern(code get_handler, string name) {
        # RestHandler asks for the socket of its requests itself
        RestHandler rest();
        rest.addClass(new EchoRestClass(get_handler));
        server.setHandler(name, "^echo", NOTHING, rest);
        on_exit server.removeHandler(name);

        list<auto> records = ({"a": 1}, {"b": "two"}, {"c": (3, 4)});
        int i = 0;
        list<auto> received = ();
        DataStreamClient client({"url": "http://localhost:" + port, "http_version": "1.1", "timeout": HangGuard,
            "protocol": "datastream"});
        hash<auto> info;
        client.sendRecvDataStream(auto sub () { return i < records.size() ? records[i++] : NOTHING; },
            sub (auto v) { received += v; }, sub (*string err) { if (err) { throw "TEST-ERROR", err; } },
            "POST", "/echo", HangGuard, \info);
        assertEq(records, received[0..2], "the records are echoed");
        assertEq(4, received.size(), "the records and the handler's probe");
        return received;
    }

    #! the request context and header of an HTTP/1.1 request have no socket; the handler's socket is the request's
    contextTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("GET /context HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> r = parse(readResponse(c));
        assertEq("", r.sockets, "no socket in the request context or header");
        assertEq("Http1HandlerSocket", r.own, "the handler's socket is its request's");
    }

    #! a stream handler that wants a body with a Content-Length as a stream gets it in parts, each byte once, read
    #! through the socket of its request for the part that the server did not read before the dispatch (qore#7308);
    #! the socket gives no data after the body
    streamBodyTest(int size) {
        Socket c = connect();
        on_exit c.close();
        c.send(sprintf("POST /stream HTTP/1.1\r\nHost: localhost\r\nContent-Type: application/octet-stream\r\n"
            "Content-Length: %d\r\n\r\n", size));
        c.send(strmul("x", size).toBinary());
        c.send("GET /second HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> r = parse(readResponse(c));
        assertEq("0", r.ctor, "no body in the constructor");
        assertEq(string((size + BodyStreamPartSize - 1) / BodyStreamPartSize), r.parts, "the body in parts");
        assertEq(string(size), r.bytes, "each byte once");
        assertEq("0", r.recv, "the socket of the request gives no data after the body");
        assertEq("served second", readResponse(c), "the next request is served");
    }

    #! a read through the socket of the request gives no more than the rest of its body, never the next request
    streamGrabTest() {
        int size = DefaultBodyStreamThreshold * 2;
        Socket c = connect();
        on_exit c.close();
        c.send(sprintf("POST /stream-grab HTTP/1.1\r\nHost: localhost\r\nContent-Type: application/octet-stream\r\n"
            "Content-Length: %d\r\n\r\n", size));
        c.send(strmul("x", size).toBinary());
        c.send("GET /second HTTP/1.1\r\nHost: localhost\r\n\r\n");
        # the first part was given by the server's reader; the handler read the rest of the body
        assertEq(size - BodyStreamPartSize, stream_handler.grabbed.get(HangGuard), "the rest of the body only");
    }

    #! a sandboxed handler cannot abort the connection of its request, which then serves the next request
    sandboxedAbortTest() {
        Program p = getTenantProgram();
        Queue entered();
        Queue release();
        server.setHandler("tenant", "^abort", NOTHING, p.callFunction("get_http_handler", entered, release));
        on_exit server.removeHandler("tenant");
        Socket c = connect();
        on_exit c.close();
        c.send("GET /abort HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> r = parse(readResponse(c));
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.function);
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.method);
        c.send("GET /after HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq("served after", readResponse(c), "the connection serves the next request");
    }

    #! the server's target gets the connection's own socket with the information of a request, and aborts a
    #! request of a sandboxed handler with it, also when the abort runs for the tenant
    targetAbortTest() {
        Program p = getTenantProgram();
        Queue entered();
        Queue release();
        RecordingServer srv();
        on_exit delete srv;
        srv.setHandler("tenant", "", NOTHING, p.callFunction("get_http_handler", entered, release));
        srv.setDefaultHandler("tenant", p.callFunction("get_http_handler", entered, release));
        int srv_port = srv.addListener(<HttpListenerOptionInfo>{"node": "localhost", "service": 0}).port;
        srv.waitForAsyncIo();

        Socket c();
        c.connect("localhost:" + srv_port, HangGuard);
        on_exit c.close();
        c.send("GET /hold HTTP/1.1\r\nHost: localhost\r\n\r\n");
        entered.get(HangGuard);
        hash<HttpServerAsyncIo::HttpConnectionInfo> info = srv.recording.requests.get(HangGuard);
        assertEq("Socket", info.sock.className(), "the target gets the connection's own socket");
        assertThrows("HTTP-HANDLER-SOCKET-ERROR", \http_abort_connection(), info.sock,
            "the connection's own socket is not a handler's");
        assertThrows("HTTP-HANDLER-SOCKET-ERROR", \http_abort_connection(), c, "a client socket is not a handler's");
        assertEq(c.getSocketInfo(False).port, info.sock.getPeerInfo(False).port, "the request's connection");
        # the abort of a framework's drain (HTTP/1.1: the connection is closed), run on behalf of the tenant
        Socket sock = info.sock;
        p.callFunction("run_code", sub () { sock.close(); });
        assertThrows("SOCKET-CLOSED", \c.readHTTPHeader(), HangGuard, "the client sees the connection closed");
        release.push(True);

        # the server serves another connection
        Socket c2();
        c2.connect("localhost:" + srv_port, HangGuard);
        on_exit c2.close();
        c2.send("GET /next HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq("served next", readResponse(c2));
    }

    #! the application code of an HTTP/1.1 WebSocket connection gets no socket
    webSocketTest() {
        HttpServer srv(<HttpServerOptionInfo>{});
        on_exit delete srv;
        ScanWebSocketHandler ws();
        srv.setHandler("ws", "^ws", NOTHING, ws);
        int srv_port = srv.addListener(<HttpListenerOptionInfo>{"node": "localhost", "service": 0}).port;
        srv.waitForAsyncIo();
        WebSocketClient wsc(sub (*data msg) {}, {"url": "ws://localhost:" + srv_port + "/ws"});
        wsc.connect();
        on_exit wsc.disconnect();
        hash<auto> scan = ws.scans.get(HangGuard);
        assertEq((), scan.sockets, "no socket in the request context or header of the connection");
        assertEq("1.1", scan.version);
    }

    #! http_abort_connection() ends the stream of an HTTP/2 or HTTP/3 request; another request of the same connection
    #! in progress completes
    streamAbortTest(string protocol) {
        HttpServer srv(<HttpServerOptionInfo>{});
        on_exit delete srv;
        HoldHandler hold();
        # a held request ends before the server is deleted, also when the test fails
        on_exit hold.release.push(True);
        srv.setHandler("hold", "^hold", NOTHING, hold);
        srv.setHandler("probe", "", NOTHING, probe);
        srv.setDefaultHandler("probe", probe);
        int tls_port = srv.addListener(<HttpListenerOptionInfo>{
            "node": "localhost",
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
            "http_version": "auto",
        }).port;
        srv.waitForAsyncIo();

        HttpClientConnectionManager mgr(<HttpClientConnectionManagerOptions>{
            "protocol": protocol,
            "accept_all_certs": True,
            "request_timeout": HangGuard,
            "connect_timeout": HangGuard,
        });
        on_exit delete mgr;
        string url = sprintf("https://localhost:%d/", tls_port);
        # another request of the same connection, in progress while the handler aborts its own stream
        Queue other_result();
        background sub () {
            try {
                other_result.push(mgr.request(url, "GET", "/hold").body);
            } catch (hash<ExceptionInfo> ex) {
                other_result.push(ex.err);
            }
        }();
        hold.entered.get(HangGuard);
        assertEq("http2=" + (protocol == "h2" ? "True" : "False"), mgr.request(url, "GET", "/proto").body,
            "the probe's request");
        assertEq("mark=METHOD-DOES-NOT-EXIST has=METHOD-DOES-NOT-EXIST",
            mgr.request(url, "GET", "/stream-statics").body, "no method changes the server's state of the request");
        *hash<ExceptionInfo> err;
        try {
            mgr.request(url, "GET", "/abort-stream");
        } catch (hash<ExceptionInfo> ex) {
            err = ex;
        }
        assertEq(Type::Hash, err.type(), "the request's stream is ended without its response");
        hold.release.push(True);
        assertEq("held", other_result.get(HangGuard), "the other request of the connection completes");
        assertEq(protocol == "h2" ? "http2=True" : "http2=False", mgr.request(url, "GET", "/proto").body,
            "the next request is served");
    }

    #! the socket refuses a response header without valid framing, a framing field in a complete response, raw bytes
    #! before a header, a protocol switch, and a send whose length is not known
    framingTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("GET /framing HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> r = parse(readResponse(c));
        foreach string k in (("bad0", "bad1", "bad2", "bad3", "bad4", "bad5", "bad6", "full_te", "raw_first",
                "upgrade", "from_stream")) {
            assertEq("HTTP-HANDLER-SOCKET-ERROR", r{k}, k);
        }
        c.send("GET /after HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq("served after", readResponse(c), "the connection serves the next request");
    }

    #! the bytes of a response with a Content-Length are counted: a send past it is refused
    lengthResponseTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("GET /length HTTP/1.1\r\nHost: localhost\r\n\r\nGET /after HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq("0123456789", readResponse(c));
        assertEq("served after", readResponse(c), "the next request is served");
    }

    #! a chunked response is sent with the socket's chunked framing only
    chunkedResponseTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("GET /chunked-response HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> h = c.readHTTPHeader(HangGuard);
        assertEq("chunked", h."transfer-encoding");
        assertEq("chunked HTTP-HANDLER-SOCKET-ERROR", c.readHTTPChunkedBody(HangGuard).body);
        c.send("GET /after HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq("served after", readResponse(c), "the connection serves the next request");
    }

    #! a response that the handler sent is not followed by the one that it returns
    unmarkedResponseTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("GET /unmarked HTTP/1.1\r\nHost: localhost\r\n\r\nGET /after HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq("the handler's", readResponse(c));
        assertEq("served after", readResponse(c), "the next response is the next request's");
    }

    #! a response that the handler did not complete closes the connection
    incompleteResponseTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("GET /incomplete HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> h = c.readHTTPHeader(HangGuard);
        assertEq("10", h."content-length");
        assertEq("012", c.recv(3, HangGuard));
        assertThrows("SOCKET-CLOSED", \c.recv(), (1, HangGuard), "the connection is closed");
    }

    #! interim responses come before the final response, which the server sends
    interimTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("GET /interim HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> h = c.readHTTPHeader(HangGuard);
        assertEq(103, h.status_code);
        h = c.readHTTPHeader(HangGuard);
        assertEq(100, h.status_code);
        h = c.readHTTPHeader(HangGuard);
        assertEq(200, h.status_code);
        assertEq("final", c.recv(h."content-length".toInt(), HangGuard));

        # the handler sends the final response after an interim one
        c.send("GET /interim-own HTTP/1.1\r\nHost: localhost\r\n\r\n");
        h = c.readHTTPHeader(HangGuard);
        assertEq(103, h.status_code);
        assertEq(NOTHING, h."content-length", "no Content-Length in an interim response");
        h = c.readHTTPHeader(HangGuard);
        assertEq(200, h.status_code);
        assertEq("final", c.recv(h."content-length".toInt(), HangGuard));
    }

    #! the response to a HEAD request is its header
    headTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("HEAD /head HTTP/1.1\r\nHost: localhost\r\n\r\nGET /after HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> h = c.readHTTPHeader(HangGuard);
        assertEq(200, h.status_code);
        assertEq("7", h."content-length");
        assertEq("served after", readResponse(c), "the next response is the next request's");
    }

    #! an HTTP/1.0 request gets no chunked or interim response
    http10Test() {
        Socket c = connect();
        on_exit c.close();
        c.send("GET /http10 HTTP/1.0\r\nHost: localhost\r\n\r\n");
        hash<auto> r = parse(readResponse(c));
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.chunked);
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.callback);
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.interim);
    }

    #! the encoding that a handler sets on its socket does not change the connection's
    encodingTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("GET /encoding HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> r1 = parse(readResponse(c));
        assertEq("ISO-8859-2", r1.after);
        c.send("GET /encoding HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> r2 = parse(readResponse(c));
        assertEq(r1.before, r2.before, "the next request's socket has the connection's encoding");
    }

    #! the socket has no method that changes the server's state of the request
    staticsTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("GET /statics HTTP/1.1\r\nHost: localhost\r\n\r\nGET /victim HTTP/1.1\r\nHost: localhost\r\n"
            "Authorization: Basic dmljdGltOnB3\r\n\r\n");
        hash<auto> r = parse(readResponse(c));
        foreach string k in (("set_body", "end", "start", "take")) {
            assertNeq("ok", r{k}, k);
        }
        assertEq("\"\"", r.recv, "no data past the body");
        assertEq("served victim", readResponse(c), "the next request is served");
    }

    #! a sandboxed handler changes no server state through its socket, by name or through an auto variable
    sandboxedStaticsTest() {
        hash<auto> r = tenantRequest("GET /statics HTTP/1.1\r\nHost: localhost\r\n\r\nGET /victim HTTP/1.1\r\n"
            "Host: localhost\r\nAuthorization: Basic dmljdGltOnB3\r\n\r\n", True);
        assertNeq("ok", r.call);
        assertNeq("ok", r.auto);
        assertNeq("ok", r.end);
        assertEq("\"\"", r.recv, "no data past the body");
        assertEq("served victim", r.next, "the next request is served");
    }

    #! a sandboxed handler cannot send a raw response and then read or answer the next request (keep-alive)
    sandboxedStealTest() {
        hash<auto> r = tenantRequest("GET /steal HTTP/1.1\r\nHost: localhost\r\n\r\n", False,
            "GET /victim HTTP/1.1\r\nHost: localhost\r\nAuthorization: Basic dmljdGltOnB3\r\n\r\n");
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.raw, "a raw response is refused");
        assertEq("\"\"", r.next, "no data past the body");
        assertEq("served victim", r.next_response, "the next request is the server's");
    }

    #! a sandboxed handler cannot forge a response for the next request, pipelined or not
    sandboxedForgeTest() {
        foreach bool pipelined in ((True, False)) {
            Program p = getTenantProgram();
            Queue entered();
            Queue release();
            server.setHandler("tenant", "^forge", NOTHING, p.callFunction("get_http_handler", entered, release));
            on_exit server.removeHandler("tenant");
            Socket c = connect();
            on_exit c.close();
            string next = "GET /victim HTTP/1.1\r\nHost: localhost\r\n\r\n";
            c.send("GET /forge HTTP/1.1\r\nHost: localhost\r\n\r\n" + (pipelined ? next : ""));
            assertEq("ok", readResponse(c), "the handler's own response");
            if (!pipelined) {
                c.send(next);
            }
            assertEq("served victim", readResponse(c), "the next response is the next request's");
        }
    }

    #! a REST stream handler with a timeout streams over HTTP/1.1
    restTimeoutTest() {
        list<auto> rv = dataStreamIntern(auto sub (hash<auto> cx, *hash<auto> ah) {
            return new TimeoutEchoHandler(cx, ah);
        }, "echo-timeout");
        assertEq({"probe": "HTTP-HANDLER-SOCKET-ERROR", "version": "1.1"}, rv.last(), "the handler's socket");
    }

    #! the socket ends when the request is answered before its handler gets it
    earlyAnswerTest() {
        EarlyAnswerHandler early();
        server.setHandler("early", "^early", NOTHING, early);
        on_exit server.removeHandler("early");
        int size = DefaultBodyStreamThreshold * 2;
        Socket c = connect();
        on_exit c.close();
        c.send(sprintf("POST /early HTTP/1.1\r\nHost: localhost\r\nContent-Type: application/octet-stream\r\n"
            "Content-Length: %d\r\n\r\n", size));
        c.send(strmul("x", size).toBinary());
        hash<auto> h = c.readHTTPHeader(HangGuard);
        assertEq(401, h.status_code);
        Http1BodyReader reader = early.readers.get(HangGuard);
        # the request was answered: its reader's socket is ended
        assertThrows("HTTP-HANDLER-SOCKET-ERROR", \reader.read(), 1s, "the reader of an answered request");
    }

    #! an HTTP/1.1 event stream, which its handler gets the connection's socket for, ends with its connection: the
    #! connection serves no other request, as a WebSocket connection
    sseTest() {
        HttpServer srv(<HttpServerOptionInfo>{});
        on_exit delete srv;
        RegisteringSseHandler sse();
        srv.setHandler("sse", "^events", NOTHING, sse);
        srv.setHandler("probe", "^after", NOTHING, probe);
        int srv_port = srv.addListener(<HttpListenerOptionInfo>{"node": "localhost", "service": 0}).port;
        srv.waitForAsyncIo();

        Socket c();
        c.connect("localhost:" + srv_port, HangGuard);
        on_exit c.close();
        # a request after the event stream's request on the connection
        c.send("GET /events HTTP/1.1\r\nHost: localhost\r\nAccept: text/event-stream\r\n\r\n"
            "GET /after HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> hdr = c.readHTTPHeader(HangGuard);
        assertEq(200, hdr.status_code);
        assertEq("close", hdr.connection, "the response ends with the connection");
        ServerSentEventConnection conn = sse.registered.get(HangGuard);
        conn.send(<SseMessageInfo>{"event": "end", "data": "done"});
        string stream = "";
        while (stream.find("event: end") < 0) {
            stream += c.recv(-1, HangGuard);
        }
        conn.stop();
        # the stream ends when the server closes the connection; the next request is not answered
        while (True) {
            try {
                string d = c.recv(-1, HangGuard);
                if (!d.size()) {
                    break;
                }
                stream += d;
            } catch (hash<ExceptionInfo> ex) {
                break;
            }
        }
        assertTrue(stream.find("event: end") >= 0, "the event: " + stream);
        assertEq(-1, stream.find("served after"), "no response to the next request: " + stream);
    }

    #! a handler declared by sandboxed code gets the socket of its request without asking for it, a trusted handler
    #! that asked for it gets it, another trusted handler gets the connection's socket; the decision cannot be
    #! changed by a subclass
    whichHandlersTest() {
        Program p = getTenantProgram();
        Queue entered();
        Queue release();
        server.setHandler("tenant", "^class", NOTHING, p.callFunction("get_http_handler", entered, release));
        on_exit server.removeHandler("tenant");
        server.setHandler("plain", "^plain", NOTHING, new PlainHandler());
        on_exit server.removeHandler("plain");
        Socket c = connect();
        on_exit c.close();
        c.send("GET /class HTTP/1.1\r\nHost: localhost\r\n\r\nGET /plain HTTP/1.1\r\nHost: localhost\r\n\r\n"
            "GET /elsewhere HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq({"class": "Http1HandlerSocket"}, parse(readResponse(c)), "a sandboxed handler, without asking");
        assertEq({"class": "Socket"}, parse(readResponse(c)), "a trusted handler that did not ask");
        c.send("GET /context HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq("served elsewhere", readResponse(c));
        assertEq("Http1HandlerSocket", parse(readResponse(c)).own, "a trusted handler that asked");

        # a subclass cannot change the decision
        Program q(PO_NO_CHILD_PO_RESTRICTIONS);
        assertThrows("PARSE-EXCEPTION", sub () {
            q.parse("%modern
%requires HttpServer
%requires HttpServerUtil
class NoView inherits AbstractHttpRequestHandler {
    bool needsHandlerSocketView() {
        return False;
    }
}
", "override");
        }, NOTHING, "the decision is final");
    }

    #! every base class of the repository that gives the socket of a request to other code, which can be code that is
    #! not trusted, asks for the socket of the request in each of its constructors (qore#7305): RestHandler gives it to
    #! its REST classes and their stream handlers (cx.socketobject); Qorus's AbstractServiceHttpHandler is checked in
    #! Qorus
    baseClassesTest() {
        Logger logger("rest");
        foreach RestHandler rest in ((new RestHandler(), new RestHandler(NOTHING, new NullRestSchemaValidator()),
                new RestHandler(logger, NOTHING), new RestHandler(logger, NOTHING, new NullRestSchemaValidator()))) {
            assertTrue(rest.needsHandlerSocketView(), "RestHandler");
        }
        assertFalse(new PlainHandler().needsHandlerSocketView(), "a trusted handler that does not ask");
    }

    #! a socket that a handler keeps after its request does not keep the server's objects of the request, whose end
    #! the server waits for when it is destroyed
    keptSocketTest() {
        ProbeHandler keeper();
        HttpServer srv(<HttpServerOptionInfo>{});
        srv.setHandler("probe", "", NOTHING, keeper);
        srv.setDefaultHandler("probe", keeper);
        int srv_port = srv.addListener(<HttpListenerOptionInfo>{"node": "localhost", "service": 0}).port;
        srv.waitForAsyncIo();
        {
            Socket c();
            c.connect("localhost:" + srv_port, HangGuard);
            on_exit c.close();
            c.send("GET /keep HTTP/1.1\r\nHost: localhost\r\n\r\n");
            assertEq({"kept": "yes"}, parse(readResponse(c)));
        }
        Socket kept = keeper.kept.get(HangGuard);
        # the server is destroyed while the handler still has the socket of its request
        Counter destroyed(1);
        background sub () {
            on_exit destroyed.dec();
            delete srv;
        }();
        assertEq(0, destroyed.waitForZero(HangGuard), "the server is destroyed");
        assertFalse(kept.isOpen(), "the kept socket is ended");
    }

    #! Sends requests to the tenant's HTTP handler and returns its first response's results, with the next response
    private hash<auto> tenantRequest(string req, bool pipelined, *string next) {
        Program p = getTenantProgram();
        Queue entered();
        Queue release();
        server.setHandler("tenant", "^(statics|steal)", NOTHING, p.callFunction("get_http_handler", entered, release));
        on_exit server.removeHandler("tenant");
        Socket c = connect();
        on_exit c.close();
        c.send(req);
        hash<auto> r = parse(readResponse(c));
        if (next) {
            c.send(next);
            r.next_response = readResponse(c);
        } else if (pipelined) {
            r.next = readResponse(c);
        }
        return r;
    }

    #! Returns a sandboxed Program with the tenant's handlers
    private Program getTenantProgram() {
        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        p.parse(TenantSource, "tenant");
        SandboxManager sm();
        sm.setNetworkDefaultPolicy(True);
        p.setSandboxManager(sm);
        return p;
    }

    private Socket connect() {
        Socket c();
        c.connect("localhost:" + port, HangGuard);
        return c;
    }

    #! reads a response with a Content-Length and returns its body
    private static string readResponse(Socket c) {
        hash<auto> h = c.readHTTPHeader(HangGuard);
        int len = h."content-length".toInt();
        return len ? c.recv(len, HangGuard) : "";
    }

    #! parses the "key=value" lines of a probe's response
    private static hash<auto> parse(string body) {
        hash<auto> r;
        foreach string line in (body.split("\n")) {
            (*string k, *string v) = (line =~ x/^([^=]+)=(.*)$/s);
            if (exists k) {
                r{k} = v ?? "";
            }
        }
        return r;
    }
}

#! Echoes the DataStream records of its request
class EchoHandler inherits AbstractDataStreamRequestHandler {
    private {
        list<auto> records = ();
        int sent = 0;
        string probe;
    }

    constructor(hash<auto> cx, *hash<auto> ah) : AbstractDataStreamRequestHandler(cx, ah) {
        probe = try_it(sub () { cx.socketobject.readHTTPHeader(1s); });
    }

    private nothing recvDataImpl(auto data) {
        records += data;
    }

    private auto sendDataImpl() {
        if (sent < records.size()) {
            return records[sent++];
        }
        if (sent++ == records.size()) {
            return {"probe": probe, "version": cx.hdr.http_version};
        }
    }
}
