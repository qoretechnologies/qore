#! runs code for the tenant, as a framework does on a thread that serves the tenant's request
nothing sub run_code(code c) {
    c();
}
";
    }

    private {
        HttpServer server;
        ProbeHandler probe();
        StreamBodyHandler stream_handler();
        int port;
    }

    constructor() : QUnit::Test("HTTP/1.1 handler socket", "1.0", \ARGV) {
        server = new HttpServer(<HttpServerOptionInfo>{});
        server.setHandler("probe", "", NOTHING, probe);
        server.setHandler("stream", "^stream", NOTHING, stream_handler);
        server.setDefaultHandler("probe", probe);
        port = server.addListener(<HttpListenerOptionInfo>{"node": "localhost", "service": 0}).port;
        server.waitForAsyncIo();

        addTestCase("the next request is not read", \nextRequestTest());
        addTestCase("no data past the body", \recvTest());
        addTestCase("a body split across reads", \splitBodyTest());
        addTestCase("the connection is not closed", \closeTest());
        addTestCase("a chunked body", \chunkedTest());
        addTestCase("a chunked body read with a callback", \chunkedCallbackTest());
        addTestCase("a chunked body in the socket's own encoding", \chunkedEncodingTest());
        addTestCase("sandboxed code's own encoding ends with each read", \sandboxedEncodingRestoreTest());
        addTestCase("a RestHandler with a REST class of a sandboxed Program", \restTenantClassTest());
        addTestCase("a send whose callback does not return", \blockedCallbackTest());
        addTestCase("a REST class of a sandboxed Program on the dispatch path", \restDispatchTest());
        addTestCase("reply_sent without a response", \fakeSentTest());
        addTestCase("other methods", \otherTest());
        addTestCase("the socket ends with its request", \staleTest());
        addTestCase("the handler's own response", \selfResponseTest());
        addTestCase("DataStream", \dataStreamTest());
        addTestCase("DataStream of a sandboxed handler", \sandboxedDataStreamTest());
        addTestCase("the request context", \contextTest());
        addTestCase("a Content-Length body to a stream handler", \streamBodyTest(), DefaultBodyStreamThreshold * 2);
        addTestCase("a Content-Length body read before the dispatch to a stream handler", \streamBodyTest(),
            DefaultBodyStreamThreshold / 2);
        addTestCase("a stream handler reads no more than its body", \streamGrabTest());
        addTestCase("sandboxed code cannot abort the connection", \sandboxedAbortTest());
        addTestCase("a handler of trusted code under a permissive sandbox gets the connection's socket",
            \permissiveHandlerTest());
        addTestCase("a REST class of trusted code under a permissive sandbox gets the connection's socket",
            \permissiveRestClassTest());
        addTestCase("trusted code under a permissive sandbox aborts the connection", \permissiveAbortTest());
        addTestCase("the server's target aborts a request", \targetAbortTest());
        addTestCase("WebSocket", \webSocketTest());
        addTestCase("the framing of a response that the handler sends", \framingTest());
        addTestCase("a response with a Content-Length in parts", \lengthResponseTest());
        addTestCase("a chunked response", \chunkedResponseTest());
        addTestCase("a response that the handler sent is not sent again", \unmarkedResponseTest());
        addTestCase("an incomplete response closes the connection", \incompleteResponseTest());
        addTestCase("interim responses", \interimTest());
        addTestCase("the response to a HEAD request", \headTest());
        addTestCase("an HTTP/1.0 request", \http10Test());
        addTestCase("the socket's encoding is its own", \encodingTest());
        addTestCase("no method changes the server's state", \staticsTest());
        addTestCase("sandboxed code changes no server state", \sandboxedStaticsTest());
        addTestCase("sandboxed code cannot read or answer the next request", \sandboxedStealTest());
        addTestCase("sandboxed code cannot forge a response", \sandboxedForgeTest());
        addTestCase("a REST stream with a timeout", \restTimeoutTest());
        addTestCase("the socket ends when the request is answered early", \earlyAnswerTest());
        addTestCase("an HTTP/1.1 event stream ends with its connection", \sseTest());
        addTestCase("the handlers that get the socket of their request", \whichHandlersTest());
        addTestCase("a trusted RestHandler asks for the socket of its requests only when told", \baseClassesTest());
        addTestCase("a kept socket does not keep the server", \keptSocketTest());
        addTestCase("an exception after the handler's response sends no other response", \sentThenThrowTest());
        addTestCase("a handler made before its Program was sandboxed", \earlyHandlerTest());
        addTestCase("a read of a thread that outlives its request", \blockedReadTest());
        addTestCase("a response without a body has no framing", \bodilessFramingTest());
        addTestCase("a protocol switch only for a request that asks for one", \upgradeTest());
        addTestCase("sandboxed code cannot reach the server's state of its request", \sandboxedReachTest());
        addTestCase("an event stream of a sandboxed handler", \sandboxedSseTest());
        addTestCase("an event stream of a sandboxed handler gets no connection socket", \sandboxedSseNoSocketTest());
        addTestCase("a WebSocket connection of a sandboxed handler gets no connection socket",
            \sandboxedWebSocketNoSocketTest());
        addTestCase("the abort of an HTTP/2 request's stream", \streamAbortTest(), "h2");
        addTestCase("the abort of an HTTP/3 request's stream", \streamAbortTest(), "h3");
        set_return_value(main());
        delete server;
    }

    #! the next request is unreachable through the handler's socket, and is then served
    nextRequestTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("GET /header HTTP/1.1\r\nHost: localhost\r\n\r\n"
            "GET /second HTTP/1.1\r\nHost: localhost\r\nX-Token: next-request\r\n\r\n");
        hash<auto> r = parse(readResponse(c));
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.header);
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.header_string);
        assertEq("served second", readResponse(c), "the next request is served");
    }

    #! reads past the request's body give no data
    recvTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("POST /recv HTTP/1.1\r\nHost: localhost\r\nContent-Type: text/plain\r\nContent-Length: 4\r\n\r\nbody"
            "GET /second HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> r = parse(readResponse(c));
        assertEq("\"\"", r.recv);
        assertEq("\"\"", r.recv_size);
        assertEq("0", r.recv_binary);
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.recvi4);
        assertEq("\"body\"", r.body, "the handler gets the request's body");
        assertEq("served second", readResponse(c), "the next request is served");
    }

    #! a body sent in two parts is read by the server; the handler's socket gives no data
    splitBodyTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("POST /recv HTTP/1.1\r\nHost: localhost\r\nContent-Type: text/plain\r\nContent-Length: 8\r\n\r\nfirs");
        c.send("t ok");
        hash<auto> r = parse(readResponse(c));
        assertEq("\"first ok\"", r.body);
        assertEq("\"\"", r.recv);
        assertEq("\"\"", r.recv_size);
    }

    #! the handler's socket cannot shut the connection down or close it
    closeTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("GET /close HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> r = parse(readResponse(c));
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.shutdown);
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.close);
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.shutdown_write);
        assertEq("True", r.open);
        c.send("GET /after HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq("served after", readResponse(c), "the connection serves the next request");
    }

    #! a chunked body is read by its chunks, once, up to its end
    chunkedTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("POST /chunked HTTP/1.1\r\nHost: localhost\r\nContent-Type: text/plain\r\n"
            "Transfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n6\r\n world\r\n0\r\n\r\n"
            "GET /second HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> r = parse(readResponse(c));
        assertEq("True", r.pending);
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.recv, "a chunked body is not read by its bytes");
        assertEq("\"hello world\"", r.body);
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.again, "the chunked body is read once");
        assertEq("\"\"", r.after);
        assertEq("False", r.pending_after);
        assertEq("served second", readResponse(c), "the next request is served");
    }

    #! a chunked body read with a callback
    chunkedCallbackTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("POST /chunked-callback HTTP/1.1\r\nHost: localhost\r\nContent-Type: text/plain\r\n"
            "Transfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n3\r\ndef\r\n0\r\n\r\n"
            "GET /second HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> r = parse(readResponse(c));
        assertEq("abcdef", r.body);
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.again);
        assertEq("served second", readResponse(c), "the next request is served");
    }

    #! a chunked body is read in the socket's own encoding, by its chunks and whole, and the next request's socket has
    #! the connection's encoding
    chunkedEncodingTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("GET /encoding HTTP/1.1\r\nHost: localhost\r\n\r\n");
        string conn_enc = parse(readResponse(c)).before;
        assertNeq("ISO-8859-2", conn_enc);
        foreach string path in (("chunked-enc", "chunked-enc-body")) {
            # "x", c with caron in ISO-8859-2 (0xe8), "y"
            c.send(binary("POST /" + path + " HTTP/1.1\r\nHost: localhost\r\nContent-Type: text/plain\r\n"
                "Transfer-Encoding: chunked\r\n\r\n2\r\nx") + <e8> + binary("\r\n1\r\ny\r\n0\r\n\r\n"));
            hash<auto> r = parse(readResponse(c));
            assertEq("ISO-8859-2", r.encoding, path + ": the body's encoding");
            assertEq("True", r.match, path + ": the body is decoded in the socket's encoding");
            c.send("GET /encoding HTTP/1.1\r\nHost: localhost\r\n\r\n");
            assertEq(conn_enc, parse(readResponse(c)).before, path + ": the connection keeps its encoding");
        }
    }

    #! the methods that would act on the connection otherwise are refused; its information is given
    otherTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("GET /other HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> r = parse(readResponse(c));
        foreach string k in (("connect", "bind", "listen", "accept", "upgrade", "fd", "copy", "abort_other")) {
            assertEq("HTTP-HANDLER-SOCKET-ERROR", r{k}, k);
        }
        assertEq(c.getSocketInfo(False).address, r.peer, "the peer's address");
        assertEq(c.getPeerInfo(False).address, r.socket, "the connection's address");
        assertEq("False", r.http2);
        assertEq("ok", r.timeout, "the socket's own timeout is set");
        assertEq("1000", r.timeout_value, "the socket's own timeout");
        assertTrue(r.encoding.val());
        c.send("GET /after HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq("served after", readResponse(c), "the connection serves the next request");
    }

    #! the socket of a request ends when the handler returns: it cannot send into a later response
    staleTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("GET /keep HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq({"kept": "yes"}, parse(readResponse(c)));
        c.send("GET /stale HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> r = parse(readResponse(c));
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.send);
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.recv);
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.abort, "the ended socket does not abort the connection");
        assertEq("False", r.open);
        c.send("GET /after HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq("served after", readResponse(c), "the connection serves the next request");
    }

    #! the handler sends one response of its own
    selfResponseTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("GET /self HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq("sent by the handler", readResponse(c));
        c.send("GET /after HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq("served after", readResponse(c), "the connection serves the next request");
    }

    #! a DataStream handler of a trusted RestHandler that asked for the socket of its requests streams through the
    #! socket of its HTTP/1.1 request
    dataStreamTest() {
        list<auto> rv = dataStreamIntern(getRestHandler(auto sub (hash<auto> cx, *hash<auto> ah) {
            return new EchoHandler(cx, ah);
        }), "echo");
        assertEq({"probe": "HTTP-HANDLER-SOCKET-ERROR", "version": "1.1"}, rv.last(), "the handler's socket");
    }

    #! a RestHandler declared by a sandboxed Program, which does not ask for it, gets the socket of its HTTP/1.1
    #! request, which refuses to read the next request, and its DataStream handler streams through it
    sandboxedDataStreamTest() {
        Program p = getTenantProgram();
        RestHandler rest = p.callFunction("get_rest_handler");
        assertTrue(rest.needsHandlerSocketView(), "a RestHandler of a sandboxed Program");
        list<auto> rv = dataStreamIntern(rest, "tenant");
        assertEq({"probe": "HTTP-HANDLER-SOCKET-ERROR", "version": "1.1"}, rv.last(),
            "the sandboxed handler's socket");
    }

    #! Returns a trusted RestHandler that asked for the socket of its requests, with the REST class of the test
    private RestHandler getRestHandler(code get_handler) {
        RestHandler rest();
        rest.setHandlerSocketView();
        rest.addClass(new EchoRestClass(get_handler));
        return rest;
    }

    private list<auto> dataStreamIntern(RestHandler rest, string name) {
        server.setHandler(name, "^echo", NOTHING, rest);
        on_exit server.removeHandler(name);

        list<auto> records = ({"a": 1}, {"b": "two"}, {"c": (3, 4)});
        int i = 0;
        list<auto> received = ();
        DataStreamClient client({"url": "http://localhost:" + port, "http_version": "1.1", "timeout": HangGuard,
            "protocol": "datastream"});
        hash<auto> info;
        client.sendRecvDataStream(auto sub () { return i < records.size() ? records[i++] : NOTHING; },
            sub (auto v) { received += v; }, sub (*string err) { if (err) { throw "TEST-ERROR", err; } },
            "POST", "/echo", HangGuard, \info);
        assertEq(records, received[0..2], "the records are echoed");
        assertEq(4, received.size(), "the records and the handler's probe");
        return received;
    }

    #! the request context and header of an HTTP/1.1 request have no socket; the handler's socket is the request's
    contextTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("GET /context HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> r = parse(readResponse(c));
        assertEq("", r.sockets, "no socket in the request context or header");
        assertEq("Http1HandlerSocket", r.own, "the handler's socket is its request's");
    }

    #! a stream handler that wants a body with a Content-Length as a stream gets it in parts, each byte once, read
    #! through the socket of its request for the part that the server did not read before the dispatch (qore#7308);
    #! the socket gives no data after the body
    streamBodyTest(int size) {
        Socket c = connect();
        on_exit c.close();
        c.send(sprintf("POST /stream HTTP/1.1\r\nHost: localhost\r\nContent-Type: application/octet-stream\r\n"
            "Content-Length: %d\r\n\r\n", size));
        c.send(strmul("x", size).toBinary());
        c.send("GET /second HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> r = parse(readResponse(c));
        assertEq("0", r.ctor, "no body in the constructor");
        assertEq(string((size + BodyStreamPartSize - 1) / BodyStreamPartSize), r.parts, "the body in parts");
        assertEq(string(size), r.bytes, "each byte once");
        assertEq("0", r.recv, "the socket of the request gives no data after the body");
        assertEq("served second", readResponse(c), "the next request is served");
    }

    #! a read through the socket of the request gives no more than the rest of its body, never the next request
    streamGrabTest() {
        int size = DefaultBodyStreamThreshold * 2;
        Socket c = connect();
        on_exit c.close();
        c.send(sprintf("POST /stream-grab HTTP/1.1\r\nHost: localhost\r\nContent-Type: application/octet-stream\r\n"
            "Content-Length: %d\r\n\r\n", size));
        c.send(strmul("x", size).toBinary());
        c.send("GET /second HTTP/1.1\r\nHost: localhost\r\n\r\n");
        # the first part was given by the server's reader; the handler read the rest of the body
        assertEq(size - BodyStreamPartSize, stream_handler.grabbed.get(HangGuard), "the rest of the body only");
    }

    #! a sandboxed handler cannot abort the connection of its request, which then serves the next request
    #! a handler declared by code that a sandbox governs only for its policy, and that may use uncontrolled APIs, is
    #! trusted: it gets the connection's socket, as any trusted handler (qore#7577)
    permissiveHandlerTest() {
        Program p = getTenantProgram(True);
        AbstractHttpRequestHandler h = p.callFunction("get_http_handler", new Queue(), new Queue());
        assertTrue(SandboxManager::isFromSandboxedProgram(h), "a sandbox governs the handler's Program");
        assertFalse(SandboxManager::isFromRestrictedProgram(h), "the Program is not restricted");
        assertFalse(h.needsHandlerSocketView(), "the handler gets the connection's socket");
        server.setHandler("trusted-permissive", "^class", NOTHING, h);
        on_exit server.removeHandler("trusted-permissive");
        Socket c = connect();
        on_exit c.close();
        c.send("GET /class HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq("class=Socket", readResponse(c), "the connection's socket");
        c.send("GET /after HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq("served after", readResponse(c), "the connection serves the next request");

        # the same handler under a restricting sandbox gets a socket of its request
        Program r = getTenantProgram();
        AbstractHttpRequestHandler rh = r.callFunction("get_http_handler", new Queue(), new Queue());
        assertTrue(rh.needsHandlerSocketView(), "a handler of restricted code");
        server.setHandler("restricted", "^class", NOTHING, rh);
        on_exit server.removeHandler("restricted");
        server.removeHandler("trusted-permissive");
        Socket c2 = connect();
        on_exit c2.close();
        c2.send("GET /class HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq("class=Http1HandlerSocket", readResponse(c2), "a socket of the request");
    }

    #! a RestHandler whose REST class is of a Program that a sandbox governs only for its policy, and that may use
    #! uncontrolled APIs, gives the class the connection's socket and is not refused (qore#7577)
    permissiveRestClassTest() {
        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        p.parse(TenantSource, "tenant");
        RestHandler rest = p.callFunction("get_class_rest_handler");
        SandboxManager sm();
        sm.setNetworkDefaultPolicy(True);
        sm.setUncontrolledApiPolicy(True);
        p.setSandboxManager(sm);
        assertFalse(rest.needsHandlerSocketView(), "the RestHandler runs only code of a trusted Program");
        server.setHandler("rest-permissive", "^sockclass", NOTHING, rest);
        on_exit server.removeHandler("rest-permissive");
        Socket c = connect();
        on_exit c.close();
        c.send("GET /sockclass HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq("\"Socket\"", readResponse(c), "the REST class gets the connection's socket");
        c.send("GET /victim HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq("served victim", readResponse(c), "the connection serves the next request");
    }

    #! trusted code under a permissive sandbox can abort the connection with the socket of its request (qore#7577)
    permissiveAbortTest() {
        Program p = getTenantProgram(True);
        AbstractHttpRequestHandler h = p.callFunction("get_http_handler", new Queue(), new Queue());
        # a socket of the request, which the handler asked for
        h.setHandlerSocketView();
        server.setHandler("trusted-permissive", "^abort", NOTHING, h);
        on_exit server.removeHandler("trusted-permissive");
        Socket c = connect();
        on_exit c.close();
        c.send("GET /abort HTTP/1.1\r\nHost: localhost\r\n\r\n");
        # the connection is aborted: no response, and the server closes it
        string got;
        try {
            got = c.recv(-1, HangGuard);
        } catch (hash<ExceptionInfo> ex) {
            got = ex.err;
        }
        assertEq(-1, got.find("HTTP/1.1"), "no response: " + got);
    }

    sandboxedAbortTest() {
        Program p = getTenantProgram();
        Queue entered();
        Queue release();
        server.setHandler("tenant", "^abort", NOTHING, p.callFunction("get_http_handler", entered, release));
        on_exit server.removeHandler("tenant");
        Socket c = connect();
        on_exit c.close();
        c.send("GET /abort HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> r = parse(readResponse(c));
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.function);
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.method);
        c.send("GET /after HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq("served after", readResponse(c), "the connection serves the next request");
    }

    #! the server's target gets the connection's own socket with the information of a request, and aborts a
    #! request of a sandboxed handler with it, also when the abort runs for the tenant
    targetAbortTest() {
        Program p = getTenantProgram();
        Queue entered();
        Queue release();
        RecordingServer srv();
        on_exit delete srv;
        srv.setHandler("tenant", "", NOTHING, p.callFunction("get_http_handler", entered, release));
        srv.setDefaultHandler("tenant", p.callFunction("get_http_handler", entered, release));
        int srv_port = srv.addListener(<HttpListenerOptionInfo>{"node": "localhost", "service": 0}).port;
        srv.waitForAsyncIo();

        Socket c();
        c.connect("localhost:" + srv_port, HangGuard);
        on_exit c.close();
        c.send("GET /hold HTTP/1.1\r\nHost: localhost\r\n\r\n");
        entered.get(HangGuard);
        hash<HttpServerAsyncIo::HttpConnectionInfo> info = srv.recording.requests.get(HangGuard);
        assertEq("Socket", info.sock.className(), "the target gets the connection's own socket");
        assertThrows("HTTP-HANDLER-SOCKET-ERROR", \http_abort_connection(), info.sock,
            "the connection's own socket is not a handler's");
        assertThrows("HTTP-HANDLER-SOCKET-ERROR", \http_abort_connection(), c, "a client socket is not a handler's");
        assertEq(c.getSocketInfo(False).port, info.sock.getPeerInfo(False).port, "the request's connection");
        # the abort of a framework's drain (HTTP/1.1: the connection is closed), run on behalf of the tenant: the target
        # is the server's, and has the server's alias of the connection's socket (qore#7338)
        Socket sock = info.sock;
        p.callFunction("run_code", sub () { sock.close(); });
        assertThrows("SOCKET-CLOSED", \c.readHTTPHeader(), HangGuard, "the client sees the connection closed");
        release.push(True);

        # the server serves another connection
        Socket c2();
        c2.connect("localhost:" + srv_port, HangGuard);
        on_exit c2.close();
        c2.send("GET /next HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq("served next", readResponse(c2));
    }

    #! the application code of an HTTP/1.1 WebSocket connection gets no socket
    webSocketTest() {
        HttpServer srv(<HttpServerOptionInfo>{});
        on_exit delete srv;
        ScanWebSocketHandler ws();
        srv.setHandler("ws", "^ws", NOTHING, ws);
        int srv_port = srv.addListener(<HttpListenerOptionInfo>{"node": "localhost", "service": 0}).port;
        srv.waitForAsyncIo();
        WebSocketClient wsc(sub (*data msg) {}, {"url": "ws://localhost:" + srv_port + "/ws"});
        wsc.connect();
        on_exit wsc.disconnect();
        hash<auto> scan = ws.scans.get(HangGuard);
        assertEq((), scan.sockets, "no socket in the request context or header of the connection");
        assertEq("1.1", scan.version);
    }

    #! http_abort_connection() ends the stream of an HTTP/2 or HTTP/3 request; another request of the same connection
    #! in progress completes
    streamAbortTest(string protocol) {
        HttpServer srv(<HttpServerOptionInfo>{});
        on_exit delete srv;
        HoldHandler hold();
        # a held request ends before the server is deleted, also when the test fails
        on_exit hold.release.push(True);
        srv.setHandler("hold", "^hold", NOTHING, hold);
        srv.setHandler("probe", "", NOTHING, probe);
        srv.setDefaultHandler("probe", probe);
        int tls_port = srv.addListener(<HttpListenerOptionInfo>{
            "node": "localhost",
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
            "http_version": "auto",
        }).port;
        srv.waitForAsyncIo();

        HttpClientConnectionManager mgr(<HttpClientConnectionManagerOptions>{
            "protocol": protocol,
            "accept_all_certs": True,
            "request_timeout": HangGuard,
            "connect_timeout": HangGuard,
        });
        on_exit delete mgr;
        string url = sprintf("https://localhost:%d/", tls_port);
        # another request of the same connection, in progress while the handler aborts its own stream
        Queue other_result();
        background sub () {
            try {
                other_result.push(mgr.request(url, "GET", "/hold").body);
            } catch (hash<ExceptionInfo> ex) {
                other_result.push(ex.err);
            }
        }();
        hold.entered.get(HangGuard);
        assertEq("http2=" + (protocol == "h2" ? "True" : "False"), mgr.request(url, "GET", "/proto").body,
            "the probe's request");
        assertEq("mark=METHOD-DOES-NOT-EXIST has=METHOD-DOES-NOT-EXIST",
            mgr.request(url, "GET", "/stream-statics").body, "no method changes the server's state of the request");
        *hash<ExceptionInfo> err;
        try {
            mgr.request(url, "GET", "/abort-stream");
        } catch (hash<ExceptionInfo> ex) {
            err = ex;
        }
        assertEq(Type::Hash, err.type(), "the request's stream is ended without its response");
        hold.release.push(True);
        assertEq("held", other_result.get(HangGuard), "the other request of the connection completes");
        assertEq(protocol == "h2" ? "http2=True" : "http2=False", mgr.request(url, "GET", "/proto").body,
            "the next request is served");
    }

    #! the socket refuses a response header without valid framing, a framing field in a complete response, raw bytes
    #! before a header, a protocol switch, and a send whose length is not known
    framingTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("GET /framing HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> r = parse(readResponse(c));
        foreach string k in (("bad0", "bad1", "bad2", "bad3", "bad4", "bad5", "bad6", "full_te", "raw_first",
                "upgrade", "from_stream")) {
            assertEq("HTTP-HANDLER-SOCKET-ERROR", r{k}, k);
        }
        c.send("GET /after HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq("served after", readResponse(c), "the connection serves the next request");
    }

    #! the bytes of a response with a Content-Length are counted: a send past it is refused
    lengthResponseTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("GET /length HTTP/1.1\r\nHost: localhost\r\n\r\nGET /after HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq("0123456789", readResponse(c));
        assertEq("served after", readResponse(c), "the next request is served");
    }

    #! a chunked response is sent with the socket's chunked framing only
    chunkedResponseTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("GET /chunked-response HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> h = c.readHTTPHeader(HangGuard);
        assertEq("chunked", h."transfer-encoding");
        assertEq("chunked HTTP-HANDLER-SOCKET-ERROR", c.readHTTPChunkedBody(HangGuard).body);
        c.send("GET /after HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq("served after", readResponse(c), "the connection serves the next request");
    }

    #! a response that the handler sent is not followed by the one that it returns
    unmarkedResponseTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("GET /unmarked HTTP/1.1\r\nHost: localhost\r\n\r\nGET /after HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq("the handler's", readResponse(c));
        assertEq("served after", readResponse(c), "the next response is the next request's");
    }

    #! a response that the handler did not complete closes the connection
    incompleteResponseTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("GET /incomplete HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> h = c.readHTTPHeader(HangGuard);
        assertEq("10", h."content-length");
        assertEq("012", c.recv(3, HangGuard));
        assertThrows("SOCKET-CLOSED", \c.recv(), (1, HangGuard), "the connection is closed");
    }

    #! interim responses come before the final response, which the server sends
    interimTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("GET /interim HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> h = c.readHTTPHeader(HangGuard);
        assertEq(103, h.status_code);
        h = c.readHTTPHeader(HangGuard);
        assertEq(100, h.status_code);
        h = c.readHTTPHeader(HangGuard);
        assertEq(200, h.status_code);
        assertEq("final", c.recv(h."content-length".toInt(), HangGuard));

        # the handler sends the final response after an interim one
        c.send("GET /interim-own HTTP/1.1\r\nHost: localhost\r\n\r\n");
        h = c.readHTTPHeader(HangGuard);
        assertEq(103, h.status_code);
        assertEq(NOTHING, h."content-length", "no Content-Length in an interim response");
        h = c.readHTTPHeader(HangGuard);
        assertEq(200, h.status_code);
        assertEq("final", c.recv(h."content-length".toInt(), HangGuard));
    }

    #! the response to a HEAD request is its header
    headTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("HEAD /head HTTP/1.1\r\nHost: localhost\r\n\r\nGET /after HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> h = c.readHTTPHeader(HangGuard);
        assertEq(200, h.status_code);
        assertEq("7", h."content-length");
        assertEq("served after", readResponse(c), "the next response is the next request's");
    }

    #! an HTTP/1.0 request gets no chunked or interim response
    http10Test() {
        Socket c = connect();
        on_exit c.close();
        c.send("GET /http10 HTTP/1.0\r\nHost: localhost\r\n\r\n");
        hash<auto> r = parse(readResponse(c));
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.chunked);
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.callback);
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.interim);
    }

    #! the encoding that a handler sets on its socket does not change the connection's
    encodingTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("GET /encoding HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> r1 = parse(readResponse(c));
        assertEq("ISO-8859-2", r1.after);
        c.send("GET /encoding HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> r2 = parse(readResponse(c));
        assertEq(r1.before, r2.before, "the next request's socket has the connection's encoding");
    }

    #! the socket has no method that changes the server's state of the request
    staticsTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("GET /statics HTTP/1.1\r\nHost: localhost\r\n\r\nGET /victim HTTP/1.1\r\nHost: localhost\r\n"
            "Authorization: Basic dmljdGltOnB3\r\n\r\n");
        hash<auto> r = parse(readResponse(c));
        foreach string k in (("set_body", "end", "start", "take")) {
            assertNeq("ok", r{k}, k);
        }
        assertEq("\"\"", r.recv, "no data past the body");
        assertEq("served victim", readResponse(c), "the next request is served");
    }

    #! a sandboxed handler changes no server state through its socket, by name or through an auto variable
    sandboxedStaticsTest() {
        hash<auto> r = tenantRequest("GET /statics HTTP/1.1\r\nHost: localhost\r\n\r\nGET /victim HTTP/1.1\r\n"
            "Host: localhost\r\nAuthorization: Basic dmljdGltOnB3\r\n\r\n", True);
        assertNeq("ok", r.call);
        assertNeq("ok", r.auto);
        assertNeq("ok", r.end);
        assertEq("\"\"", r.recv, "no data past the body");
        assertEq("served victim", r.next, "the next request is served");
    }

    #! a sandboxed handler cannot send a raw response and then read or answer the next request (keep-alive)
    sandboxedStealTest() {
        hash<auto> r = tenantRequest("GET /steal HTTP/1.1\r\nHost: localhost\r\n\r\n", False,
            "GET /victim HTTP/1.1\r\nHost: localhost\r\nAuthorization: Basic dmljdGltOnB3\r\n\r\n");
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.raw, "a raw response is refused");
        assertEq("\"\"", r.next, "no data past the body");
        assertEq("served victim", r.next_response, "the next request is the server's");
    }

    #! a sandboxed handler cannot forge a response for the next request, pipelined or not
    sandboxedForgeTest() {
        foreach bool pipelined in ((True, False)) {
            Program p = getTenantProgram();
            Queue entered();
            Queue release();
            server.setHandler("tenant", "^forge", NOTHING, p.callFunction("get_http_handler", entered, release));
            on_exit server.removeHandler("tenant");
            Socket c = connect();
            on_exit c.close();
            string next = "GET /victim HTTP/1.1\r\nHost: localhost\r\n\r\n";
            c.send("GET /forge HTTP/1.1\r\nHost: localhost\r\n\r\n" + (pipelined ? next : ""));
            assertEq("ok", readResponse(c), "the handler's own response");
            if (!pipelined) {
                c.send(next);
            }
            assertEq("served victim", readResponse(c), "the next response is the next request's");
        }
    }

    #! a REST stream handler with a timeout streams over HTTP/1.1
    restTimeoutTest() {
        list<auto> rv = dataStreamIntern(getRestHandler(auto sub (hash<auto> cx, *hash<auto> ah) {
            return new TimeoutEchoHandler(cx, ah);
        }), "echo-timeout");
        assertEq({"probe": "HTTP-HANDLER-SOCKET-ERROR", "version": "1.1"}, rv.last(), "the handler's socket");
    }

    #! the socket ends when the request is answered before its handler gets it
    earlyAnswerTest() {
        EarlyAnswerHandler early();
        server.setHandler("early", "^early", NOTHING, early);
        on_exit server.removeHandler("early");
        int size = DefaultBodyStreamThreshold * 2;
        Socket c = connect();
        on_exit c.close();
        c.send(sprintf("POST /early HTTP/1.1\r\nHost: localhost\r\nContent-Type: application/octet-stream\r\n"
            "Content-Length: %d\r\n\r\n", size));
        c.send(strmul("x", size).toBinary());
        hash<auto> h = c.readHTTPHeader(HangGuard);
        assertEq(401, h.status_code);
        Http1BodyReader reader = early.readers.get(HangGuard);
        # the request was answered: its reader's socket is ended
        assertThrows("HTTP-HANDLER-SOCKET-ERROR", \reader.read(), 1s, "the reader of an answered request");
    }

    #! an HTTP/1.1 event stream, which its handler gets the connection's socket for, ends with its connection: the
    #! connection serves no other request, as a WebSocket connection
    sseTest() {
        HttpServer srv(<HttpServerOptionInfo>{});
        on_exit delete srv;
        RegisteringSseHandler sse();
        srv.setHandler("sse", "^events", NOTHING, sse);
        srv.setHandler("probe", "^after", NOTHING, probe);
        int srv_port = srv.addListener(<HttpListenerOptionInfo>{"node": "localhost", "service": 0}).port;
        srv.waitForAsyncIo();

        Socket c();
        c.connect("localhost:" + srv_port, HangGuard);
        on_exit c.close();
        # a request after the event stream's request on the connection
        c.send("GET /events HTTP/1.1\r\nHost: localhost\r\nAccept: text/event-stream\r\n\r\n"
            "GET /after HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> hdr = c.readHTTPHeader(HangGuard);
        assertEq(200, hdr.status_code);
        assertEq("close", hdr.connection, "the response ends with the connection");
        ServerSentEventConnection conn = sse.registered.get(HangGuard);
        conn.send(<SseMessageInfo>{"event": "end", "data": "done"});
        string stream = "";
        while (stream.find("event: end") < 0) {
            stream += c.recv(-1, HangGuard);
        }
        conn.stop();
        # the stream ends when the server closes the connection; the next request is not answered
        while (True) {
            try {
                string d = c.recv(-1, HangGuard);
                if (!d.size()) {
                    break;
                }
                stream += d;
            } catch (hash<ExceptionInfo> ex) {
                break;
            }
        }
        assertTrue(stream.find("event: end") >= 0, "the event: " + stream);
        assertEq(-1, stream.find("served after"), "no response to the next request: " + stream);
    }

    #! a handler declared by sandboxed code gets the socket of its request without asking for it, a trusted handler
    #! that asked for it gets it, another trusted handler gets the connection's socket; the decision cannot be
    #! changed by a subclass
    whichHandlersTest() {
        Program p = getTenantProgram();
        Queue entered();
        Queue release();
        server.setHandler("tenant", "^class", NOTHING, p.callFunction("get_http_handler", entered, release));
        on_exit server.removeHandler("tenant");
        server.setHandler("plain", "^plain", NOTHING, new PlainHandler());
        on_exit server.removeHandler("plain");
        Socket c = connect();
        on_exit c.close();
        c.send("GET /class HTTP/1.1\r\nHost: localhost\r\n\r\nGET /plain HTTP/1.1\r\nHost: localhost\r\n\r\n"
            "GET /elsewhere HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq({"class": "Http1HandlerSocket"}, parse(readResponse(c)), "a sandboxed handler, without asking");
        assertEq({"class": "Socket"}, parse(readResponse(c)), "a trusted handler that did not ask");
        c.send("GET /context HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq("served elsewhere", readResponse(c));
        assertEq("Http1HandlerSocket", parse(readResponse(c)).own, "a trusted handler that asked");

        # a subclass cannot change the decision
        Program q(PO_NO_CHILD_PO_RESTRICTIONS);
        assertThrows("PARSE-EXCEPTION", sub () {
            q.parse("%modern
%requires HttpServer
%requires HttpServerUtil
class NoView inherits AbstractHttpRequestHandler {
    bool needsHandlerSocketView() {
        return False;
    }
}
", "override");
        }, NOTHING, "the decision is final");
    }

    #! a trusted RestHandler does not ask for the socket of its requests (it gets the connection's socket, at no cost),
    #! from any of its constructors, until it asks with setHandlerSocketView(); one declared by sandboxed code gets it
    #! (see sandboxedDataStreamTest())
    baseClassesTest() {
        Logger logger("rest");
        foreach RestHandler rest in ((new RestHandler(), new RestHandler(NOTHING, new NullRestSchemaValidator()),
                new RestHandler(logger, NOTHING), new RestHandler(logger, NOTHING, new NullRestSchemaValidator()))) {
            assertFalse(rest.needsHandlerSocketView(), "a trusted RestHandler");
            rest.setHandlerSocketView();
            assertTrue(rest.needsHandlerSocketView(), "a trusted RestHandler that asked");
        }
        assertFalse(new PlainHandler().needsHandlerSocketView(), "a trusted handler that does not ask");
    }

    #! a socket that a handler keeps after its request does not keep the server's objects of the request, whose end
    #! the server waits for when it is destroyed
    keptSocketTest() {
        ProbeHandler keeper();
        HttpServer srv(<HttpServerOptionInfo>{});
        srv.setHandler("probe", "", NOTHING, keeper);
        srv.setDefaultHandler("probe", keeper);
        int srv_port = srv.addListener(<HttpListenerOptionInfo>{"node": "localhost", "service": 0}).port;
        srv.waitForAsyncIo();
        {
            Socket c();
            c.connect("localhost:" + srv_port, HangGuard);
            on_exit c.close();
            c.send("GET /keep HTTP/1.1\r\nHost: localhost\r\n\r\n");
            assertEq({"kept": "yes"}, parse(readResponse(c)));
        }
        Socket kept = keeper.kept.get(HangGuard);
        # the server is destroyed while the handler still has the socket of its request
        Counter destroyed(1);
        background sub () {
            on_exit destroyed.dec();
            delete srv;
        }();
        assertEq(0, destroyed.waitForZero(HangGuard), "the server is destroyed");
        assertFalse(kept.isOpen(), "the kept socket is ended");
    }

    #! a sandboxed handler's response is not followed by another response when the handler's code raises an exception
    #! after it: the next request is served
    sentThenThrowTest() {
        Program p = getTenantProgram();
        Queue entered();
        Queue release();
        server.setHandler("tenant", "^arm", NOTHING, p.callFunction("get_http_handler", entered, release));
        on_exit server.removeHandler("tenant");
        Socket c = connect();
        on_exit c.close();
        c.send("GET /arm HTTP/1.1\r\nHost: localhost\r\n\r\nGET /victim HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq("first", readResponse(c), "the handler's response");
        # the connection is closed after the exception: no other response is sent for the first request, and the
        # next request is not answered with one
        string next;
        try {
            next = readResponse(c);
        } catch (hash<ExceptionInfo> ex) {
            next = ex.err;
        }
        assertEq("SOCKET-CLOSED", next, "the connection is closed");
    }

    #! a handler that a sandboxed Program made when it was parsed, or before it was sandboxed, gets the socket of its
    #! request
    earlyHandlerTest() {
        # made by a static initializer when the Program is parsed, before it is sandboxed
        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        p.parse(TenantSource, "early");
        SandboxManager sm();
        sm.setNetworkDefaultPolicy(True);
        p.setSandboxManager(sm);
        AbstractHttpRequestHandler early = p.callFunction("get_early_handler");
        assertTrue(early.needsHandlerSocketView(), "made at parse time");

        # made before the Program was sandboxed, which happens after the handler was registered
        Program q(PO_NO_CHILD_PO_RESTRICTIONS);
        q.parse(TenantSource, "late");
        Queue entered();
        Queue release();
        AbstractHttpRequestHandler before = q.callFunction("get_http_handler", entered, release);
        server.setHandler("early", "^early", NOTHING, early);
        on_exit server.removeHandler("early");
        server.setHandler("before", "^class", NOTHING, before);
        on_exit server.removeHandler("before");
        q.setSandboxManager(sm);
        assertTrue(before.needsHandlerSocketView(), "made before the Program was sandboxed");

        Socket c = connect();
        on_exit c.close();
        c.send("GET /early HTTP/1.1\r\nHost: localhost\r\n\r\nGET /class HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq("class=Http1HandlerSocket", readResponse(c), "the handler made at parse time");
        assertEq("class=Http1HandlerSocket", readResponse(c), "the handler registered before its Program was sandboxed");
    }

    #! a read of the socket of a request in a thread of the handler that outlives the request holds the server at most
    #! for the longest timeout of the socket (the server's handler_socket_max_timeout option), also for a read without
    #! a timeout or with a longer one: the read times out, the connection is closed, and the server serves other
    #! connections
    blockedReadTest() {
        assertThrows("HTTP-SERVER-INIT-ERROR", sub () {
            HttpServer bad(<HttpServerOptionInfo>{"handler_socket_max_timeout": -1});
        });
        Program p = getTenantProgram();
        Queue entered();
        Queue release();
        AbstractHttpRequestHandler handler = p.callFunction("get_http_handler", entered, release);
        HttpServer srv(<HttpServerOptionInfo>{"handler_socket_max_timeout": 1s});
        on_exit delete srv;
        srv.setHandler("tenant", "^(blocked|class)", NOTHING, handler);
        int srv_port = srv.addListener(<HttpListenerOptionInfo>{"node": "localhost", "service": 0}).port;
        srv.waitForAsyncIo();

        foreach string path in (("blocked", "blocked-long")) {
            Socket c();
            c.connect("localhost:" + srv_port, HangGuard);
            on_exit c.close();
            # a chunked body that never ends
            c.send("POST /" + path + " HTTP/1.1\r\nHost: localhost\r\nTransfer-Encoding: chunked\r\n\r\n"
                "3\r\nabc\r\n");
            entered.get(HangGuard);
            # the response is sent (the read had not started), or the connection is closed, without waiting for the
            # read
            string r;
            try {
                hash<auto> rh = c.readHTTPHeader(HangGuard);
                r = c.recv(rh."content-length".toInt(), HangGuard);
            } catch (hash<ExceptionInfo> ex) {
                r = "closed";
            }
            assertTrue(r == "returned" || r == "closed", path + ": the request ends: " + r);
            # the thread's read ends at the longest timeout of the socket (SOCKET-TIMEOUT), or when the end of the
            # request, which waits for it as long, closes the connection's socket (READ-HTTP-CHUNK-ERROR, or another
            # SOCKET-* error): both take the same time from the start of the read and the end of the request, so that
            # either can come first
            string err = cast<object>(handler).ended.get(HangGuard);
            assertTrue(err =~ /^SOCKET-/ || err == "READ-HTTP-CHUNK-ERROR" || err == "HTTP-HANDLER-SOCKET-ERROR",
                path + ": the read ends: " + err);
            assertNeq("ok", err, path + ": the read reads no body that the client did not send");

            Socket c2();
            c2.connect("localhost:" + srv_port, HangGuard);
            on_exit c2.close();
            c2.send("GET /class HTTP/1.1\r\nHost: localhost\r\n\r\n");
            assertEq("class=Http1HandlerSocket", readResponse(c2), path + ": the server serves another connection");
        }
    }

    #! a chunked read of a sandboxed handler in the socket's own encoding gives the connection's socket that encoding
    #! for the read only: also when the read's callback throws in the middle of the body and when the read times out
    #! (at the server's handler_socket_max_timeout), the next request's socket has the connection's encoding
    sandboxedEncodingRestoreTest() {
        Program p = getTenantProgram();
        Queue entered();
        Queue release();
        AbstractHttpRequestHandler handler = p.callFunction("get_http_handler", entered, release);
        HttpServer srv(<HttpServerOptionInfo>{"handler_socket_max_timeout": 1s});
        on_exit delete srv;
        srv.setHandler("tenant", "^enc-", NOTHING, handler);
        int srv_port = srv.addListener(<HttpListenerOptionInfo>{"node": "localhost", "service": 0}).port;
        srv.waitForAsyncIo();

        string conn_enc;
        {
            Socket c();
            c.connect("localhost:" + srv_port, HangGuard);
            on_exit c.close();
            c.send("GET /enc-report HTTP/1.1\r\nHost: localhost\r\n\r\n");
            conn_enc = parse(readResponse(c)).encoding;
        }
        assertNeq("ISO-8859-2", conn_enc);

        # the callback throws in the middle of the body; the read times out in the middle of the body (the client
        # sends the rest of the body after it)
        foreach string path in (("enc-throw", "enc-timeout")) {
            Socket c();
            c.connect("localhost:" + srv_port, HangGuard);
            on_exit c.close();
            c.send("POST /" + path + " HTTP/1.1\r\nHost: localhost\r\nTransfer-Encoding: chunked\r\n\r\n"
                "1\r\na\r\n" + (path == "enc-throw" ? "1\r\nb\r\n0\r\n\r\n" : ""));
            string err = cast<object>(handler).ended.get(HangGuard);
            assertEq(path == "enc-throw" ? "TENANT-ERROR" : "SOCKET-TIMEOUT", err, path + ": the read's error");
            # the connection's own socket has its encoding again
            Socket view = cast<object>(handler).last;
            Socket real = cast<NormalMember>(Class::getClass(view).getMember("real")).getValue(view);
            assertEq(conn_enc, real.getEncoding(), path + ": the connection's socket has its encoding again");
            if (path == "enc-timeout") {
                c.send("1\r\nb\r\n0\r\n\r\n");
            }
            # the rest of the body is not read as the next request: the connection closes after the response
            hash<auto> h = c.readHTTPHeader(HangGuard);
            assertEq("err=" + err, c.recv(h."content-length".toInt(), HangGuard), path);
            assertEq("close", h.connection.lwr(), path + ": the connection closes");
            c.send("GET /enc-report HTTP/1.1\r\nHost: localhost\r\n\r\n");
            string rest = "";
            try {
                rest = c.recv(-1, HangGuard).toString();
            } catch (hash<ExceptionInfo> ex) {
                rest = ex.err;
            }
            assertFalse(rest =~ /HTTP\/1.1 [0-9]/, path + ": no response to a request after the body: " + rest);
        }
    }

    #! a RestHandler (a class of a module) that the tenant's code made before its Program was sandboxed, with the
    #! tenant's REST class, gets the socket of its request: the Program of the REST class is sandboxed; as does a
    #! trusted RestHandler to which a REST class of a sandboxed Program is added after it was registered
    restTenantClassTest() {
        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        p.parse(TenantSource, "tenant");
        RestHandler early = p.callFunction("get_class_rest_handler");
        SandboxManager sm();
        sm.setNetworkDefaultPolicy(True);
        p.setSandboxManager(sm);
        assertFalse(SandboxManager::isFromSandboxedProgram(early), "the RestHandler's class is the module's");
        assertTrue(early.needsHandlerSocketView(), "the RestHandler runs code of a sandboxed Program");

        RestHandler trusted();
        assertFalse(trusted.needsHandlerSocketView(), "a trusted RestHandler without classes of sandboxed code");

        foreach hash<auto> i in (({"name": "early", "rest": early}, {"name": "late", "rest": trusted})) {
            server.setHandler("rest-" + i.name, "^sockclass", NOTHING, i.rest);
            on_exit server.removeHandler("rest-" + i.name);
            if (i.name == "late") {
                # added after the handler was registered
                trusted.addClass(p.callFunction("get_class_rest"));
            }
            Socket c = connect();
            on_exit c.close();
            c.send("GET /sockclass HTTP/1.1\r\nHost: localhost\r\n\r\nGET /victim HTTP/1.1\r\nHost: localhost\r\n"
                "Authorization: Basic dmljdGltOnB3\r\n\r\n");
            assertEq("\"Http1HandlerSocket\"", readResponse(c), i.name + ": the REST class's socket");
            assertEq("served victim", readResponse(c), i.name + ": the next request is the server's");
        }
    }

    #! a trusted RestHandler that has the connection's socket does not hand the request to a REST class of a sandboxed
    #! Program anywhere on its dispatch path: below a trusted container class, returned by a trusted class's
    #! subClassImpl(), or added by the tenant after the server decided the socket of the request; the request is
    #! refused and the connection closed
    restDispatchTest() {
        Program p = getTenantProgram();

        # below a trusted container class
        RestHandler nested();
        ContainerRestClass cont();
        cont.addClass(p.callFunction("get_class_rest"));
        nested.addClass(cont);
        assertFalse(nested.needsHandlerSocketView(), "only the container is hosted at the top level");
        restRefused(nested, "/c/sockclass", "below a trusted container class");

        # returned by a trusted class's subClassImpl()
        RestHandler dynamic();
        dynamic.addClass(new DynamicRestClass(auto sub () { return p.callFunction("get_class_rest"); }));
        restRefused(dynamic, "/d/sockclass", "returned by subClassImpl()");

        # added by the tenant between the server's decision and the dispatch
        GateAuthenticator gate();
        RestHandler late(gate);
        restRefused(late, "/sockclass", "added after the server's decision", sub () {
            p.callFunction("add_class_rest", late);
        }, gate);
    }

    private restRefused(RestHandler rest, string path, string what, *code mid, *GateAuthenticator gate) {
        server.setHandler("rest-dispatch", "^(c|d|sockclass)", NOTHING, rest);
        on_exit server.removeHandler("rest-dispatch");
        Socket c = connect();
        on_exit c.close();
        if (gate) {
            gate.armed = True;
        }
        c.send("GET " + path + " HTTP/1.1\r\nHost: localhost\r\n\r\nGET /victim HTTP/1.1\r\nHost: localhost\r\n"
            "Authorization: Basic dmljdGltOnB3\r\n\r\n");
        if (gate) {
            gate.at.get(HangGuard);
            mid();
            gate.go.push(True);
        }
        hash<auto> h = c.readHTTPHeader(HangGuard);
        string body = c.recv(h."content-length".toInt(), HangGuard);
        assertEq(500, h.status_code, what + ": refused: " + body);
        assertRegex("refused", body, what);
        assertEq("close", h.connection.lwr(), what + ": the connection closes");
        string rest_data = "";
        while (True) {
            try {
                binary b = c.recvBinary(-1, HangGuard);
                if (!b) {
                    break;
                }
                rest_data += b.toString();
            } catch (hash<ExceptionInfo> ex) {
                break;
            }
        }
        assertTrue(rest_data !~ /HTTP\/1.1 [0-9]/, what + ": the next request is not answered: " + rest_data);
    }

    #! a send of a thread of the handler that outlives its request, whose callback does not return, holds the server
    #! at most for the longest timeout of the socket: the connection is shut down and closed, and the send fails
    blockedCallbackTest() {
        Program p = getTenantProgram();
        Queue entered();
        Queue release();
        AbstractHttpRequestHandler handler = p.callFunction("get_http_handler", entered, release);
        HttpServer srv(<HttpServerOptionInfo>{"handler_socket_max_timeout": 1s});
        on_exit delete srv;
        srv.setHandler("tenant", "^(blocked-cb|class)", NOTHING, handler);
        int srv_port = srv.addListener(<HttpListenerOptionInfo>{"node": "localhost", "service": 0}).port;
        srv.waitForAsyncIo();
        Socket c();
        c.connect("localhost:" + srv_port, HangGuard);
        on_exit c.close();
        c.send("GET /blocked-cb HTTP/1.1\r\nHost: localhost\r\n\r\n");
        # the connection ends without waiting for the callback (the test releases it only afterwards)
        string rest = "";
        string end;
        while (True) {
            try {
                binary b = c.recvBinary(-1, HangGuard);
                if (!b) {
                    end = "closed";
                    break;
                }
                rest += b.toString();
            } catch (hash<ExceptionInfo> ex) {
                end = ex.err;
                break;
            }
        }
        assertNeq("SOCKET-TIMEOUT", end, "the connection ends: " + rest);
        assertTrue(rest !~ /returned/, "no response after the incomplete one: " + rest);
        release.push(True);
        assertNeq("ok", cast<object>(handler).ended.get(HangGuard), "the send fails");
        Socket c2();
        c2.connect("localhost:" + srv_port, HangGuard);
        on_exit c2.close();
        c2.send("GET /class HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq("class=Http1HandlerSocket", readResponse(c2), "the server serves another connection");
    }

    #! a handler that returns reply_sent without sending a response through the socket of its request gets the
    #! server's error response, and the connection closes
    fakeSentTest() {
        Program p = getTenantProgram();
        Queue entered();
        Queue release();
        server.setHandler("tenant", "^fake-sent", NOTHING, p.callFunction("get_http_handler", entered, release));
        on_exit server.removeHandler("tenant");
        Socket c = connect();
        on_exit c.close();
        c.send("GET /fake-sent HTTP/1.1\r\nHost: localhost\r\n\r\nGET /victim HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> h = c.readHTTPHeader(HangGuard);
        assertEq(500, h.status_code, "no response was sent");
        assertEq("close", h.connection.lwr());
        assertEq("the handler sent no response", c.recv(h."content-length".toInt(), HangGuard));
        string rest;
        try {
            rest = c.recv(-1, HangGuard).toString();
        } catch (hash<ExceptionInfo> ex) {
            rest = ex.err;
        }
        assertTrue(rest !~ /HTTP\/1.1 [0-9]/, "the next request is not answered as the first: " + rest);
    }

    #! a response without a body (HEAD, 204, 304) has no Transfer-Encoding, and a 204 or 304 response no
    #! Content-Length but 0
    bodilessFramingTest() {
        Socket c = connect();
        on_exit c.close();
        c.send("GET /bodiless HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> h = c.readHTTPHeader(HangGuard);
        assertEq(204, h.status_code);
        c.send("HEAD /bodiless-head HTTP/1.1\r\nHost: localhost\r\n\r\nGET /after HTTP/1.1\r\nHost: localhost\r\n\r\n");
        h = c.readHTTPHeader(HangGuard);
        assertEq(200, h.status_code);
        assertEq(NOTHING, h."transfer-encoding");
        assertEq("served after", readResponse(c));
        hash<auto> r = probe.results.get(HangGuard);
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.te_204, "a 204 response with chunked framing");
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.cl_304, "a 304 response with a Content-Length");
        assertEq("ok", r.cl0_204, "a 204 response with a Content-Length of 0");
        r = probe.results.get(HangGuard);
        assertEq("HTTP-HANDLER-SOCKET-ERROR", r.te_head, "the response to a HEAD request with chunked framing");
    }

    #! a socket handler cannot switch the protocol of a request that does not ask for it
    upgradeTest() {
        Program p = getTenantProgram();
        server.setHandler("tenant", "^switch", NOTHING, p.callFunction("get_socket_handler"));
        on_exit server.removeHandler("tenant");
        Socket c = connect();
        on_exit c.close();
        c.send("GET /switch HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> h = c.readHTTPHeader(HangGuard);
        assertEq(500, h.status_code, "no protocol switch for a request that does not ask for one");
        assertEq("the request does not ask for a protocol upgrade", c.recv(h."content-length".toInt(), HangGuard));
    }

    #! a sandboxed handler cannot reach the server's state of its request: not through the members of its socket, by
    #! name or through reflection, nor through the server's classes by name or the objects that it gets
    sandboxedReachTest() {
        Program p = getTenantProgram();
        Queue entered();
        Queue release();
        server.setHandler("tenant", "^reach", NOTHING, p.callFunction("get_http_handler", entered, release));
        on_exit server.removeHandler("tenant");
        Socket c = connect();
        on_exit c.close();
        c.send("GET /reach HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> r = parse(readResponse(c));
        foreach string m in (("rh", "real", "gen")) {
            assertNeq("ok", r{"name." + m}, "member " + m + " by name");
            assertEq("REFLECTION-ACCESS-ERROR", r{"get." + m}, "member " + m + " read through reflection");
            assertEq("REFLECTION-ACCESS-ERROR", r{"set." + m}, "member " + m + " written through reflection");
        }
        foreach string cls in (("HttpServer::Priv::RequestHelper", "HttpServer::Priv::HandlerSocketState",
                "Priv::RequestHelper", "Priv::HandlerSocketState")) {
            assertNeq("ok", r{"class." + cls}, "class " + cls + " by name");
        }
        list<string> objs = r.objects.split(",");
        assertTrue(objs.size() > 1, "the context, the header and the listener have objects: " + r.objects);
        foreach string cls in (objs) {
            assertFalse(cls == "RequestHelper" || cls == "HandlerSocketState" || cls == "HttpListener",
                "the handler gets no object of the server's state: " + cls);
        }
        # the server serves the next request on the connection
        c.send("GET /victim HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq("served victim", readResponse(c));
    }

    #! the server sends the header of a sandboxed handler's event stream, with Connection: close, before the handler
    #! gets the connection's socket, and only for a request that accepts an event stream
    sandboxedSseTest() {
        Program p = getTenantProgram();
        AbstractHttpRequestHandler sse = p.callFunction("get_sse_handler");
        HttpServer srv(<HttpServerOptionInfo>{});
        on_exit delete srv;
        srv.setHandler("sse", "^events", NOTHING, sse);
        int srv_port = srv.addListener(<HttpListenerOptionInfo>{"node": "localhost", "service": 0}).port;
        srv.waitForAsyncIo();

        # a request that does not accept an event stream
        {
            Socket c();
            c.connect("localhost:" + srv_port, HangGuard);
            on_exit c.close();
            c.send("GET /events HTTP/1.1\r\nHost: localhost\r\n\r\n");
            hash<auto> h = c.readHTTPHeader(HangGuard);
            assertEq(406, h.status_code, "an event stream for a request that does not accept one");
        }

        # the handler's own response comes after the server's header, and the client sends no next request
        Socket c();
        c.connect("localhost:" + srv_port, HangGuard);
        on_exit c.close();
        c.send("GET /events HTTP/1.1\r\nHost: localhost\r\nAccept: text/event-stream\r\n\r\n");
        hash<auto> h = c.readHTTPHeader(HangGuard);
        assertEq(200, h.status_code);
        assertEq("text/event-stream", h."content-type", "the server's header comes first");
        assertEq("close", h.connection, "the stream ends with the connection");
        # the handler's attempt to read a next request finds none: the client sends none on the stream's connection
        string read = cast<object>(sse).results.get(HangGuard);
        # nothing is read: the socket of the request, which ended, raises an error, or no data comes (qore#7376)
        assertTrue(read == "\"\"" || read !~ /^"/, "no next request to read: " + read);

        # the handler's framing fields and connection option, in any case, are not in the server's header
        Socket c3();
        c3.connect("localhost:" + srv_port, HangGuard);
        on_exit c3.close();
        c3.send("GET /events-framed HTTP/1.1\r\nHost: localhost\r\nAccept: text/event-stream\r\n\r\n");
        h = c3.readHTTPHeader(HangGuard);
        assertEq(200, h.status_code);
        assertEq(NOTHING, h."content-length", "no Content-Length");
        assertEq(NOTHING, h."transfer-encoding", "no Transfer-Encoding");
        assertEq("close", h.connection, "only the server's Connection field");
        cast<object>(sse).results.get(HangGuard);
    }

    #! the server sets up the HTTP/1.1 event stream of a handler that gets the socket of its request without giving
    #! it, its connection or its event source the connection's socket or the stream's poll operation; the events
    #! still reach the client (qore#7376)
    sandboxedSseNoSocketTest() {
        Program p = getTenantProgram();
        object sse = p.callFunction("get_sse_socket_handler");
        HttpServer srv(<HttpServerOptionInfo>{});
        on_exit delete srv;
        srv.setHandler("sse", "^events", NOTHING, cast<AbstractHttpRequestHandler>(sse));
        int srv_port = srv.addListener(<HttpListenerOptionInfo>{"node": "localhost", "service": 0}).port;
        srv.waitForAsyncIo();

        # the handler's connection
        {
            Socket c();
            c.connect("localhost:" + srv_port, HangGuard);
            on_exit c.close();
            c.send("GET /events HTTP/1.1\r\nHost: localhost\r\nAccept: text/event-stream\r\n\r\n");
            hash<auto> h = c.readHTTPHeader(HangGuard);
            assertEq(200, h.status_code);
            assertEq("close", h.connection, "the stream ends with the connection");
            assertEq("conn=Http1HandlerSocket", sse.results.get(HangGuard),
                "the connection is made with the socket of the request, and the handler's setup is not called");
            assertEq("registered op=none op2=none sock=none sock2=none", sse.results.get(HangGuard),
                "no poll operation and no socket from the connection");
            ServerSentEventConnection conn = sse.conns.get(HangGuard);
            conn.send(<SseMessageInfo>{"event": "end", "data": "done"});
            string stream = "";
            while (stream.find("event: end") < 0) {
                stream += c.recv(-1, HangGuard);
            }
            # the handler serializes the data as JSON
            assertTrue(stream.find("data: \"done\"") >= 0, "the event reaches the client: " + stream);
            conn.stop();
        }

        # the handler's event source
        {
            Socket c();
            c.connect("localhost:" + srv_port, HangGuard);
            on_exit c.close();
            c.send("GET /events-source HTTP/1.1\r\nHost: localhost\r\nAccept: text/event-stream\r\n\r\n");
            hash<auto> h = c.readHTTPHeader(HangGuard);
            assertEq(200, h.status_code);
            list<string> got = (sse.results.get(HangGuard), sse.results.get(HangGuard), sse.results.get(HangGuard));
            assertEq(("conn=Http1HandlerSocket", "registered op=none op2=none sock=none sock2=none",
                "source op=none op2=none sock=none sock2=none"), got,
                "no poll operation and no socket from the connection or the event source's stream");
            string stream = "";
            while (stream.find("from the source") < 0) {
                stream += c.recv(-1, HangGuard);
            }
            assertTrue(stream.find("event: source") >= 0, "the source's event reaches the client: " + stream);
            sse.conns.get(HangGuard).stop();
        }
        assertEq(0, sse.results.size(), "nothing else was recorded");

        # a socket handler that cannot set up a stream without the connection's socket gets no stream: the
        # connection is closed after the server's header, and the handler's own setup is not called
        object raw = p.callFunction("get_raw_sse_handler");
        srv.setHandler("raw", "^raw", NOTHING, cast<AbstractHttpRequestHandler>(raw));
        {
            Socket c();
            c.connect("localhost:" + srv_port, HangGuard);
            on_exit c.close();
            c.send("GET /raw HTTP/1.1\r\nHost: localhost\r\nAccept: text/event-stream\r\n\r\n");
            hash<auto> h = c.readHTTPHeader(HangGuard);
            assertEq(200, h.status_code, "the server's header of the stream");
            assertEq("", readToClose(c), "the connection is closed with no stream and no other response");
            assertEq(0, raw.results.size(), "the handler's own setup with a socket is not called");
        }

        # a hook of the handler that fails after the connection was registered: the connection is deregistered and
        # closed, and no other response follows the server's header
        {
            Socket c();
            c.connect("localhost:" + srv_port, HangGuard);
            on_exit c.close();
            c.send("GET /events-throw HTTP/1.1\r\nHost: localhost\r\nAccept: text/event-stream\r\n\r\n");
            hash<auto> h = c.readHTTPHeader(HangGuard);
            assertEq(200, h.status_code, "the server's header of the stream");
            assertEq("", readToClose(c), "the connection is closed with no stream and no other response");
            list<string> got = (sse.results.get(HangGuard), sse.results.get(HangGuard), sse.results.get(HangGuard));
            assertEq(("conn=Http1HandlerSocket", "registered op=none op2=none sock=none sock2=none", "deregistered"),
                got, "the connection that the handler registered is deregistered");
        }

        # a handler that is not a socket handler: its event source gets a stream that gives no poll operation
        object source = p.callFunction("get_source_handler");
        srv.setHandler("source", "^source", NOTHING, cast<AbstractHttpRequestHandler>(source));
        {
            Socket c();
            c.connect("localhost:" + srv_port, HangGuard);
            on_exit c.close();
            c.send("GET /source HTTP/1.1\r\nHost: localhost\r\nAccept: text/event-stream\r\n\r\n");
            hash<auto> h = c.readHTTPHeader(HangGuard);
            assertEq(200, h.status_code);
            assertEq("source op=none op2=none sock=none sock2=none", source.results.get(HangGuard),
                "no poll operation and no socket from the event source's stream");
            string stream = "";
            while (stream.find("from the source") < 0) {
                stream += c.recv(-1, HangGuard);
            }
            assertTrue(stream.find("event: source") >= 0, "the source's event reaches the client: " + stream);
        }

        # code of a subclass cannot take the poll operation from a stream that gives none
        Program q(PO_NO_CHILD_PO_RESTRICTIONS);
        *hash<ExceptionInfo> err;
        try {
            q.parse("%modern
%requires HttpServerAsyncIo
class Peek inherits HttpServerAsyncIo::Http1SseConnection {
    static *object peek(HttpServerAsyncIo::Http1SseConnection c) {
        return c.poll_op;
    }
}
", "peek");
        } catch (hash<ExceptionInfo> ex) {
            err = ex;
        }
        assertEq("PARSE-EXCEPTION", err.err, "a subclass cannot access the poll operation");
        assertRegex("poll_op", err.desc ?? "", "the error is the access to the poll operation");
    }

    #! the HTTP/1.1 WebSocket connection of a sandboxed handler gets the socket of its request, never the connection's
    #! socket or poll operation; a socket handler that cannot set up its connection without them gets none (qore#7476)
    sandboxedWebSocketNoSocketTest() {
        Program p = getTenantProgram();
        object ws = p.callFunction("get_ws_handler");
        HttpServer srv(<HttpServerOptionInfo>{});
        on_exit delete srv;
        srv.setHandler("ws", "^ws", NOTHING, cast<AbstractHttpRequestHandler>(ws));
        int srv_port = srv.addListener(<HttpListenerOptionInfo>{"node": "localhost", "service": 0}).port;
        srv.waitForAsyncIo();

        # the handler's connection: messages are echoed, and neither the handler nor its connection gets the
        # connection's socket or poll operation
        {
            Queue msgs();
            WebSocketClient wsc(sub (*data msg) { if (exists msg) { msgs.push(msg); } },
                {"url": "ws://localhost:" + srv_port + "/ws"});
            wsc.connect();
            on_exit wsc.disconnect();
            assertEq("start sock=Http1HandlerSocket ctx=", ws.results.get(HangGuard),
                "the handler gets the socket of the request, and no poll operation or socket in the context");
            assertEq("registered sock=Http1HandlerSocket get.op=REFLECTION-ACCESS-ERROR", ws.results.get(HangGuard),
                "the connection gets the socket of the request, and cannot read its poll operation by reflection");
            wsc.send("hello");
            assertEq("hello", msgs.get(HangGuard), "the connection's messages are echoed");
        }

        # a socket handler that takes over the connection with the socket it is given gets no connection: the
        # request is answered with an error before any protocol switch, and the handler's start is not called
        srv.setHandler("raw", "^switch", NOTHING, cast<AbstractHttpRequestHandler>(p.callFunction(
            "get_socket_handler")));
        {
            Socket c();
            c.connect("localhost:" + srv_port, HangGuard);
            on_exit c.close();
            c.send("GET /switch HTTP/1.1\r\nHost: localhost\r\nUpgrade: x\r\nConnection: Upgrade\r\n\r\n");
            hash<auto> h = c.readHTTPHeader(HangGuard);
            assertEq(500, h.status_code, "no protocol switch without a setup that keeps the connection's socket");
            string body = c.recv(h."content-length".toInt(), HangGuard);
            assertRegex("startAsyncWebSocketForRequest", body, "the error names the missing setup");
            assertEq("", readToClose(c), "the handler did not get the connection");
        }

        # a socket handler of another class that declares the method that sets up the connection gets a handle that
        # gives neither the poll operation nor the connection's socket
        object fake = p.callFunction("get_fake_ws_handler");
        srv.setHandler("fake", "^fake", NOTHING, cast<AbstractHttpRequestHandler>(fake));
        {
            Socket c();
            c.connect("localhost:" + srv_port, HangGuard);
            on_exit c.close();
            c.send("GET /fake HTTP/1.1\r\nHost: localhost\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n\r\n");
            hash<auto> h = c.readHTTPHeader(HangGuard);
            assertEq(101, h.status_code);
            assertEq("class=HttpWebSocketPollOperationHandle getSocket=METHOD-DOES-NOT-EXIST "
                "getPollOperation=METHOD-DOES-NOT-EXIST getOutput=METHOD-DOES-NOT-EXIST "
                "continuePoll=METHOD-DOES-NOT-EXIST op=PRIVATE-MEMBER get.op=REFLECTION-ACCESS-ERROR "
                "set.op=REFLECTION-ACCESS-ERROR", fake.results.get(HangGuard),
                "the handle gives no poll operation and no socket");
            assertEq(0, fake.results.size(), "the handler's startImpl() is not called");
        }

        # code of a subclass cannot take the poll operation from a connection
        Program q(PO_NO_CHILD_PO_RESTRICTIONS);
        *hash<ExceptionInfo> err;
        try {
            q.parse("%modern
%requires WebSocketHandler
class Peek inherits WebSocketHandler::WebSocketConnection {
    constructor(WebSocketHandler::WebSocketHandler h) : WebSocketHandler::WebSocketConnection(h) {
    }
    static *object peek(WebSocketHandler::WebSocketConnection c) {
        return c.async_ws_poll_op;
    }
}
", "peek");
        } catch (hash<ExceptionInfo> ex) {
            err = ex;
        }
        assertEq("PARSE-EXCEPTION", err.err, "a subclass cannot access the poll operation of a connection");
        assertRegex("async_ws_poll_op", err.desc ?? "", "the error is the access to the poll operation");
    }

    #! Reads a connection until the peer closes it and returns what was read; a read timeout is a failure
    private string readToClose(Socket c) {
        string rv = "";
        while (True) {
            string d;
            try {
                d = c.recv(-1, HangGuard);
            } catch (hash<ExceptionInfo> ex) {
                assertFalse(ex.err == "SOCKET-TIMEOUT", "the connection is closed: " + ex.err);
                break;
            }
            if (!d.size()) {
                break;
            }
            rv += d;
        }
        return rv;
    }

    #! Sends requests to the tenant's HTTP handler and returns its first response's results, with the next response
    private hash<auto> tenantRequest(string req, bool pipelined, *string next) {
        Program p = getTenantProgram();
        Queue entered();
        Queue release();
        server.setHandler("tenant", "^(statics|steal)", NOTHING, p.callFunction("get_http_handler", entered, release));
        on_exit server.removeHandler("tenant");
        Socket c = connect();
        on_exit c.close();
        c.send(req);
        hash<auto> r = parse(readResponse(c));
        if (next) {
            c.send(next);
            r.next_response = readResponse(c);
        } else if (pipelined) {
            r.next = readResponse(c);
        }
        return r;
    }

    #! Returns a sandboxed Program with the tenant's handlers
    #! returns a sandboxed Program with the tenant's code; a permissive sandbox allows uncontrolled APIs: the host
    #! trusts its code and governs it only for its policy (qore#7577)
    private Program getTenantProgram(bool permissive = False) {
        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        SandboxManager sm();
        sm.setNetworkDefaultPolicy(True);
        if (permissive) {
            sm.setUncontrolledApiPolicy(True);
        }
        p.setSandboxManager(sm);
        p.parse(TenantSource, "tenant");
        return p;
    }

    private Socket connect() {
        Socket c();
        c.connect("localhost:" + port, HangGuard);
        return c;
    }

    #! reads a response with a Content-Length and returns its body
    private static string readResponse(Socket c) {
        hash<auto> h = c.readHTTPHeader(HangGuard);
        int len = h."content-length".toInt();
        return len ? c.recv(len, HangGuard) : "";
    }

    #! parses the "key=value" lines of a probe's response
    private static hash<auto> parse(string body) {
        hash<auto> r;
        foreach string line in (body.split("\n")) {
            (*string k, *string v) = (line =~ x/^([^=]+)=(.*)$/s);
            if (exists k) {
                r{k} = v ?? "";
            }
        }
        return r;
    }
}

#! Echoes the DataStream records of its request
class EchoHandler inherits AbstractDataStreamRequestHandler {
    private {
        list<auto> records = ();
        int sent = 0;
        string probe;
    }

    constructor(hash<auto> cx, *hash<auto> ah) : AbstractDataStreamRequestHandler(cx, ah) {
        probe = try_it(sub () { cx.socketobject.readHTTPHeader(1s); });
    }

    private nothing recvDataImpl(auto data) {
        records += data;
    }

    private auto sendDataImpl() {
        if (sent < records.size()) {
            return records[sent++];
        }
        if (sent++ == records.size()) {
            return {"probe": probe, "version": cx.hdr.http_version};
        }
    }
}
