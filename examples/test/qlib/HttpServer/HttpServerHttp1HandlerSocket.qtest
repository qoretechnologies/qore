#! a WebSocket connection that echoes its messages and reports the socket it got (qore#7476)
class TenantWsConnection inherits WebSocketConnection {
    private {
        Queue results;
    }

    constructor(WebSocketHandler handler, Queue results) : WebSocketConnection(handler) {
        self.results = results;
    }

    registered() {
        string r = \"registered sock=\" + getSocket().className();
        try {
            auto v = cast<NormalMember>(Class::forName(\"WebSocketHandler::WebSocketConnection\")
                .getMember(\"async_ws_poll_op\")).getValue(self);
            r += \" get.op=\" + (v.typeCode() == NT_OBJECT ? v.className() : v.type());
        } catch (hash<ExceptionInfo> ex) {
            r += \" get.op=\" + ex.err;
        }
        results.push(r);
    }

    gotMessage(string msg) {
        send(msg);
    }
}

#! a WebSocket handler that looks for the connection's socket and poll operation in what it gets (qore#7476)
class TenantWsHandler inherits WebSocketHandler {
    public {
        Queue results();
    }

    constructor() : WebSocketHandler() {
    }

    WebSocketConnection getConnectionImpl(hash<auto> cx, hash<auto> hdr, string cid) {
        return new TenantWsConnection(self, results);
    }

    private bool startImpl(softstring lid, hash<auto> cx, hash<auto> hdr, Socket sock) {
        results.push(sprintf(\"start sock=%s ctx=%s\", sock.className(), (select tenant_classes(cx),
            $1 =~ /PollOperation/ || $1 == \"Socket\").join(\",\")));
        return WebSocketHandler::startImpl(lid, cx, hdr, sock);
    }
}

