#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

# Copyright 2026 Qore Technologies, s.r.o.

# HttpServer's http_fields_at_top_level option (qore#6851): the header hash of a request gives its fields under
# "headers", and also at its top level unless the option is False.  HttpServer and the handler modules read the fields
# from "headers", and from the top level of a header hash built by user code that has no "headers" key, so the server
# works end to end in every mode:
# - "top-level": the option True (the default): the fields under "headers" and at the top level
# - "headers": the option False: the fields only under "headers"
# - "hand-built": the option False, and each handler is given a hash built as user code builds one: the fields at its
#   top level, without a "headers" key

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires Util
%requires Mime
%requires Logger
%requires HttpUtil
%requires HttpServerUtil
%requires HttpServerAsyncIo
%requires HttpServer
%requires RestHandler
%requires WebSocketUtil
%requires WebSocketHandler
%requires WebSocketClient
%requires ServerSentEventHandler
%requires json
%requires ../../TestCertificates.qm

%exec-class HttpServerFieldsAtTopLevelTest

#! Returns the header hash of a request as user code builds one: the fields at its top level, without "headers"
hash<auto> sub flatten_header(hash<auto> hdr) {
    hash<auto> rv = hdr - ("headers", "trailers");
    foreach hash<auto> i in (http_get_fields(hdr).pairIterator()) {
        if (!HttpReservedFieldNames{i.key}) {
            rv{i.key} = i.value;
        }
    }
    return rv;
}

#! Records each request: its header hash, body, trailers and user, and what the handler reads from the header hash
class EchoHandler inherits AbstractHttpRequestHandler {
    public {
        Queue requests();
    }

    constructor(*AbstractAuthenticator auth) : AbstractHttpRequestHandler(auth) {
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        requests.push({
            "hdr": hdr,
            "body": body,
            "trailers": cx.trailers,
            "user": cx.user,
            "content-type": http_get_field(hdr, "content-type"),
            "x-test": http_get_field(hdr, "x-test"),
        });
        return <HttpResponseInfo>{"code": 200, "body": "ok", "hdr": {"Content-Type": MimeTypeText}};
    }
}

#! Gives EchoHandler the header hash of the request as user code builds one
class FlatEchoHandler inherits EchoHandler {
    constructor(*AbstractAuthenticator auth) : EchoHandler(auth) {
    }

    hash<HttpResponseInfo> handleRequest(HttpListenerInterface listener, Socket s, hash<auto> cx, hash<auto> hdr,
            *data body) {
        hash<auto> flat = flatten_header(hdr);
        cx.hdr = flat;
        # the chunked body is read by AbstractHttpRequestHandler::getMessageBody() with the hand-built hash
        return EchoHandler::handleRequest(listener, s, cx, flat, body);
    }
}

#! Authenticates the user "user" with the password "pass" (Basic)
class TestAuthenticator inherits AbstractAuthenticator {
    bool requiresAuthentication() {
        return True;
    }

    authenticate(reference<hash<auto>> cx, string user, string pass = "") {
        if (user != "user" || pass != "pass") {
            throw "AUTHENTICATION-ERROR", "invalid user or password";
        }
        cx.user = user;
    }

    authenticateByIP(reference<hash<auto>> cx, string ip, reference<bool> authenticated) {
        throw "AUTHENTICATION-ERROR", "no authentication by IP";
    }
}

#! A listener for calling an authenticator directly
class TestListener inherits HttpListenerInterface {
    log(string fmt, ...) {
    }

    logError(string fmt, ...) {
    }

    addUserThreadContext(hash<auto> uctx) {
    }

    auto removeUserThreadContext(*string k) {
    }
}

class TestRestObject inherits AbstractRestClass {
    string name() {
        return "obj";
    }

    hash<HttpHandlerResponseInfo> get(hash<auto> cx, *hash<auto> ah) {
        return RestHandler::makeResponse(200, {"text": strmul("text ", 400), "a": 1});
    }

    hash<HttpHandlerResponseInfo> post(hash<auto> cx, *hash<auto> ah) {
        return RestHandler::makeResponse(200, {"received": ah});
    }
}

class TestRestHandler inherits RestHandler {
    constructor() {
        addClass(new TestRestObject());
    }
}

#! Gives RestHandler the header hash of the request as user code builds one
class FlatRestHandler inherits TestRestHandler {
    hash<HttpResponseInfo> handleRequest(HttpListenerInterface listener, Socket s, hash<auto> cx, hash<auto> hdr,
            *data b) {
        hash<auto> flat = flatten_header(hdr);
        cx.hdr = flat;
        return TestRestHandler::handleRequest(listener, s, cx, flat, b);
    }
}

class EchoWsConnection inherits WebSocketConnection {
    constructor(WebSocketHandler handler) : WebSocketConnection(handler) {
    }

    gotMessage(string msg) {
        send("echo: " + msg);
    }
}

class EchoWsHandler inherits WebSocketHandler {
    constructor() : WebSocketHandler(NOTHING) {
    }

    WebSocketConnection getConnectionImpl(hash<auto> cx, hash<auto> hdr, string cid) {
        return new EchoWsConnection(self);
    }
}

#! Gives WebSocketHandler the header hash of the request as user code builds one
class FlatWsHandler inherits EchoWsHandler {
    hash<auto> handleRequest(hash<auto> cx, hash<auto> hdr, *data b) {
        hash<auto> flat = flatten_header(hdr);
        cx.hdr = flat;
        return EchoWsHandler::handleRequest(cx, flat, b);
    }
}

#! Records the event ID that each connection asks to replay events from (the Last-Event-ID field)
class ReplaySseHandler inherits ServerSentEventHandler {
    public {
        Queue replays();
    }

    constructor() : ServerSentEventHandler(NOTHING, {}) {
    }

    private replayEventsSince(ServerSentEventConnection conn, auto id) {
        replays.push(id);
    }
}

#! Gives ServerSentEventHandler the header hash of the request as user code builds one
class FlatSseHandler inherits ReplaySseHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data b) {
        return ReplaySseHandler::handleRequest(cx + {"hdr": flatten_header(hdr)}, flatten_header(hdr), b);
    }

    HttpServerAsyncIo::HttpSseStreamPollOperation setupAsyncSseConnection(Socket sock, hash<auto> cx,
            hash<auto> hdr, string cid) {
        hash<auto> flat = flatten_header(hdr);
        return ReplaySseHandler::setupAsyncSseConnection(sock, cx + {"hdr": flat}, flat, cid);
    }
}

public class HttpServerFieldsAtTopLevelTest inherits QUnit::Test {
    public {
        #! the modes; see the description at the top of the file
        const Modes = ("top-level", "headers", "hand-built");

        const Timeout = 30s;
    }

    private {
        Logger logger;
    }

    constructor() : Test("HttpServerFieldsAtTopLevel", "1.0", \ARGV) {
        logger = new Logger("fields-test", LoggerLevel::getLevelError());

        addTestCase("http_get_field() and http_set_field()", \fieldFunctions());
        addTestCase("the placement of the request fields", \fieldPlacement());
        addTestCase("a chunked request body", \chunkedBody());
        addTestCase("Content-Length, Content-Type and Content-Encoding", \contentFields());
        addTestCase("REST dispatch and content negotiation", \restHandler());
        addTestCase("a WebSocket upgrade", \webSocket());
        addTestCase("server-sent events", \serverSentEvents());
        addTestCase("authentication", \authentication());
        set_return_value(main());
    }

    fieldFunctions() {
        # a request header hash as the server gives it with the fields at the top level, and without
        hash<auto> top = {"method": "GET", "path": "x", "accept": "a/b", "headers": {"accept": "a/b", "method": "M"}};
        hash<auto> only = {"method": "GET", "path": "x", "headers": {"accept": "a/b", "method": "M"}};
        # a hash built by user code
        hash<auto> flat = {"method": "GET", "path": "x", "accept": "a/b"};
        foreach hash<auto> h in ((top, only, flat)) {
            assertEq("a/b", http_get_field(h, "accept"), "a field");
            assertEq(NOTHING, http_get_field(h, "x-none"), "no field");
            assertEq(NOTHING, http_get_field(h, "path"), "a key of the message is never a field");
        }
        assertEq("M", http_get_field(top, "method"), "a field named Method is under headers");
        assertEq("M", http_get_field(only, "method"), "a field named Method is under headers");
        # a hash with a "headers" key gives its fields from there only, as http_get_fields() does: a value at the top
        # level is not a field of the message
        hash<auto> mixed = {"method": "GET", "headers": {"accept": "a/b"}, "x-top": "1"};
        assertEq(NOTHING, http_get_field(mixed, "x-top"), "the top level is not read when there is a headers key");
        assertEq({"accept": "a/b"}, http_get_fields(mixed), "the same fields as http_get_field() gives");
        assertEq({"accept": "a/b", "method": "M"}, http_get_fields(only), "the fields");
        assertEq({"accept": "a/b"}, http_get_fields(flat), "the fields of a hash built by user code");
        assertEq({}, http_get_fields(NOTHING), "no message");

        # a field set in a hash with the fields at the top level is set in both places
        http_set_field(\top, "content-type", "text/plain");
        assertEq("text/plain", top.headers."content-type");
        assertEq("text/plain", top."content-type");
        # a field set in a hash with the fields only under headers is set there only
        http_set_field(\only, "content-type", "text/plain");
        assertEq("text/plain", only.headers."content-type");
        assertFalse(only.hasKey("content-type"));
        # a field set in a hash built by user code is set at its top level, except one named like a key of the
        # message
        http_set_field(\flat, "content-type", "text/plain");
        assertEq("text/plain", flat."content-type");
        assertFalse(flat.hasKey("headers"));
        http_set_field(\flat, "path", "/f");
        assertEq("x", flat.path, "the key of the message is not replaced");
        assertEq("/f", http_get_field(flat, "path"));
    }

    #! returns the handler of a mode
    private EchoHandler echoHandler(string mode, *AbstractAuthenticator auth) {
        return mode == "hand-built" ? new FlatEchoHandler(auth) : new EchoHandler(auth);
    }

    #! returns a server with the option of the mode; the handler is the default handler
    private HttpServer startServer(string mode, AbstractHttpRequestHandler handler) {
        HttpServer hs(<HttpServerOptionInfo>{
            "logger": logger,
            "http_fields_at_top_level": mode == "top-level",
        });
        hs.setHandler("handler", "", NOTHING, handler);
        hs.setDefaultHandler("handler", handler);
        return hs;
    }

    #! adds a plain HTTP/1.1 listener and returns its port
    private int addPlainListener(HttpServer hs) {
        int port = hs.addListener(<HttpListenerOptionInfo>{"node": "localhost", "service": 0}).port;
        hs.waitForAsyncIo();
        return port;
    }

    #! adds an HTTP/2 listener with TLS and returns its port
    private int addTlsListener(HttpServer hs) {
        int port = hs.addListener(<HttpListenerOptionInfo>{
            "node": "localhost",
            "service": 0,
            "cert": new SSLCertificate(TestCertificates::CertPem),
            "key": new SSLPrivateKey(TestCertificates::KeyPem),
            "http_version": "2.0",
            "enable_h3": False,
        }).port;
        hs.waitForAsyncIo();
        return port;
    }

    #! sends a request on a new connection and returns the response header and the body
    private hash<auto> rawRequest(int port, data req) {
        Socket s();
        s.connect("localhost:" + port, Timeout);
        on_exit s.close();
        s.send(req);
        hash<auto> rh = s.readHTTPHeader(Timeout);
        *binary body;
        if (http_get_field(rh, "transfer-encoding") == "chunked") {
            body = s.readHTTPChunkedBodyBinary(Timeout).body;
        } else if (int len = int(http_get_field(rh, "content-length"))) {
            body = s.recvBinary(len, Timeout);
        }
        return {"hdr": rh, "body": body};
    }

    #! checks the header hash that a handler is given in a mode
    private checkHeader(string mode, string proto, hash<auto> req) {
        string label = sprintf("%s %s", mode, proto);
        hash<auto> hdr = req.hdr;
        assertEq("1", req."x-test", label + ": the handler reads the field");
        assertEq("text/plain", req."content-type", label + ": the content type without its charset parameter");
        assertEq("text/plain;charset=utf-8", hdr."_qore_orig_content_type", label + ": the content type received");
        switch (mode) {
            case "top-level":
                assertEq("1", hdr.headers."x-test", label + ": the field under headers");
                assertEq("1", hdr."x-test", label + ": the field at the top level");
                assertEq("text/plain", hdr.headers."content-type", label + ": the content type under headers");
                assertEq("text/plain", hdr."content-type", label + ": the content type at the top level");
                assertTrue(exists hdr.host, label + ": Host at the top level");
                break;
            case "headers":
                assertEq("1", hdr.headers."x-test", label + ": the field under headers");
                assertFalse(hdr.hasKey("x-test"), label + ": no field at the top level");
                assertEq("text/plain", hdr.headers."content-type", label + ": the content type under headers");
                assertFalse(hdr.hasKey("content-type"), label + ": no content type at the top level");
                assertFalse(hdr.hasKey("host"), label + ": no Host at the top level");
                assertTrue(exists hdr.headers.host, label + ": Host under headers");
                break;
            case "hand-built":
                assertFalse(hdr.hasKey("headers"), label + ": the hand-built hash has no headers key");
                assertEq("1", hdr."x-test", label + ": the field at the top level");
                break;
        }
        assertEq("data", req.body, label + ": the body");
    }

    fieldPlacement() {
        foreach string mode in (Modes) {
            EchoHandler handler = echoHandler(mode);
            HttpServer hs = startServer(mode, handler);
            on_exit hs.stop();

            # HTTP/1.1
            int port = addPlainListener(hs);
            hash<auto> resp = rawRequest(port, "POST /x HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n"
                "Content-Type: text/plain;charset=utf-8\r\nX-Test: 1\r\nContent-Length: 4\r\n\r\ndata");
            assertEq(200, resp.hdr.status_code, mode + ": HTTP/1.1 request answered");
            checkHeader(mode, "HTTP/1.1", handler.requests.get(Timeout));

            # HTTP/2: the option is taken by the sockets accepted from the listener
            port = addTlsListener(hs);
            HTTPClient hc({"url": sprintf("https://localhost:%d", port), "ssl_verify_cert": False,
                "http_version": "2.0", "timeout": Timeout});
            hc.connect();
            assertEq("HTTP/2", hc.getHttpVersion(), mode + ": HTTP/2 is negotiated");
            hash<auto> rv = hc.send("data", "POST", "/x", {"Content-Type": "text/plain;charset=utf-8",
                "X-Test": "1"});
            assertEq(200, rv.status_code, mode + ": HTTP/2 request answered");
            checkHeader(mode, "HTTP/2", handler.requests.get(Timeout));
            hc.disconnect();

            # HTTP/3: the option is set on the QUIC listener
            int h3_port;
            try {
                h3_port = hs.addQuicListener(<HttpListenerOptionInfo>{
                    "node": "localhost",
                    "cert": new SSLCertificate(TestCertificates::CertPem),
                    "key": new SSLPrivateKey(TestCertificates::KeyPem),
                }).port;
            } catch (hash<ExceptionInfo> ex) {
                printf("%s: QUIC listener not available: %s: %s; HTTP/3 not checked\n", mode, ex.err, ex.desc);
                continue;
            }
            hs.waitForAsyncIo();
            HTTPClient h3({"url": sprintf("https://localhost:%d", h3_port), "ssl_verify_cert": False,
                "http_version": "3", "timeout": Timeout});
            h3.connect();
            if (h3.getHttpVersion() != "HTTP/3") {
                printf("%s: HTTP/3 not negotiated (%y); HTTP/3 not checked\n", mode, h3.getHttpVersion());
                continue;
            }
            rv = h3.send("data", "POST", "/x", {"Content-Type": "text/plain;charset=utf-8", "X-Test": "1"});
            assertEq(200, rv.status_code, mode + ": HTTP/3 request answered");
            checkHeader(mode, "HTTP/3", handler.requests.get(Timeout));
            h3.disconnect();
        }
    }

    chunkedBody() {
        foreach string mode in (Modes) {
            EchoHandler handler = echoHandler(mode);
            HttpServer hs = startServer(mode, handler);
            on_exit hs.stop();
            int port = addPlainListener(hs);

            # a text body: the Transfer-Encoding field is what tells the server that the body is chunked
            hash<auto> resp = rawRequest(port, "POST /x HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n"
                "Content-Type: text/plain;charset=utf-8\r\nTransfer-Encoding: chunked\r\n\r\n"
                "6\r\nh\xc3\xa9llo\r\n6\r\n world\r\n0\r\nX-Trailer: t\r\n\r\n");
            assertEq(200, resp.hdr.status_code, mode + ": answered");
            hash<auto> req = handler.requests.get(Timeout);
            assertEq("héllo world", req.body, mode + ": the chunked body is read and decoded");
            assertEq({"x-trailer": "t"}, req.trailers, mode + ": the trailer fields");

            # a compressed chunked body
            binary gz = gzip("compressed chunked");
            string hex = sprintf("%x", gz.size());
            resp = rawRequest(port, binary("POST /x HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n"
                "Content-Type: text/plain\r\nContent-Encoding: gzip\r\nTransfer-Encoding: chunked\r\n\r\n"
                + hex + "\r\n") + gz + binary("\r\n0\r\n\r\n"));
            assertEq(200, resp.hdr.status_code, mode + ": answered");
            req = handler.requests.get(Timeout);
            assertEq("compressed chunked", req.body, mode + ": the compressed chunked body is decompressed");
        }
    }

    contentFields() {
        foreach string mode in (Modes) {
            EchoHandler handler = echoHandler(mode);
            HttpServer hs = startServer(mode, handler);
            on_exit hs.stop();
            int port = addPlainListener(hs);

            # Content-Length and the charset of Content-Type
            binary latin1 = binary(convert_encoding("déjà vu", "ISO-8859-1"));
            hash<auto> resp = rawRequest(port, binary(sprintf("POST /x HTTP/1.1\r\nHost: localhost\r\n"
                "Connection: close\r\nContent-Type: text/plain;charset=iso-8859-1\r\nContent-Length: %d\r\n\r\n",
                latin1.size())) + latin1);
            assertEq(200, resp.hdr.status_code, mode + ": answered");
            hash<auto> req = handler.requests.get(Timeout);
            assertEq("déjà vu", req.body, mode + ": the body is read and decoded with the charset of Content-Type");
            assertEq("text/plain", req."content-type", mode + ": the content type");

            # a binary body
            resp = rawRequest(port, binary("POST /x HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n"
                "Content-Type: application/octet-stream\r\nContent-Length: 3\r\n\r\n") + <010203>);
            assertEq(200, resp.hdr.status_code, mode + ": answered");
            req = handler.requests.get(Timeout);
            assertEq(<010203>, req.body, mode + ": an octet-stream body is binary");

            # a compressed body
            binary gz = gzip("compressed body");
            resp = rawRequest(port, binary(sprintf("POST /x HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n"
                "Content-Type: text/plain;charset=utf-8\r\nContent-Encoding: gzip\r\nContent-Length: %d\r\n\r\n",
                gz.size())) + gz);
            assertEq(200, resp.hdr.status_code, mode + ": answered");
            req = handler.requests.get(Timeout);
            assertEq("compressed body", req.body, mode + ": the compressed body is decompressed");

            # an invalid Content-Length is refused
            resp = rawRequest(port, "POST /x HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n"
                "Content-Length: x1\r\n\r\n");
            assertEq(400, resp.hdr.status_code, mode + ": an invalid Content-Length is refused");
        }
    }

    restHandler() {
        foreach string mode in (Modes) {
            TestRestHandler handler = mode == "hand-built" ? new FlatRestHandler() : new TestRestHandler();
            HttpServer hs = startServer(mode, handler);
            on_exit hs.stop();
            int port = addPlainListener(hs);

            # Accept selects the serialization of the response, and Accept-Encoding its compression
            hash<auto> resp = rawRequest(port, "GET /obj HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n"
                "Accept: application/json\r\nAccept-Encoding: gzip\r\n\r\n");
            assertEq(200, resp.hdr.status_code, mode + ": GET answered");
            assertRegex("^application/json", http_get_field(resp.hdr, "content-type"), mode + ": JSON");
            assertEq("gzip", http_get_field(resp.hdr, "content-encoding"), mode + ": compressed");
            assertEq(1, parse_json(gunzip_to_string(resp.body)).a, mode + ": the response");

            resp = rawRequest(port, "GET /obj HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n"
                "Accept: application/x-yaml\r\n\r\n");
            assertEq(200, resp.hdr.status_code, mode + ": GET answered");
            assertRegex("yaml", http_get_field(resp.hdr, "content-type"), mode + ": YAML");
            assertNothing(http_get_field(resp.hdr, "content-encoding"), mode + ": not compressed");

            # the body is deserialized according to its Content-Type
            string json = make_json({"k": "v"});
            resp = rawRequest(port, sprintf("POST /obj HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n"
                "Accept: application/json\r\nContent-Type: application/json\r\nContent-Length: %d\r\n\r\n%s",
                json.size(), json));
            assertEq(200, resp.hdr.status_code, mode + ": POST answered");
            assertEq({"received": {"k": "v"}}, parse_json(resp.body.toString()), mode + ": the request body");
        }
    }

    webSocket() {
        foreach string mode in (Modes) {
            EchoWsHandler handler = mode == "hand-built" ? new FlatWsHandler() : new EchoWsHandler();
            HttpServer hs = startServer(mode, handler);
            on_exit hs.stop();

            foreach bool h2 in ((False, True)) {
                string label = sprintf("%s %s", mode, h2 ? "HTTP/2" : "HTTP/1.1");
                int port = h2 ? addTlsListener(hs) : addPlainListener(hs);
                Queue msgs();
                hash<auto> opts = {
                    "url": (h2 ? "wss" : "ws") + "://localhost:" + port,
                    "logger": logger,
                    "timeout": 30000,
                };
                if (h2) {
                    opts += {"http_version": "2.0", "ssl_verify_cert": False};
                }
                WebSocketClient wsc(sub (*data msg) {
                    if (exists msg) {
                        msgs.push(msg);
                    }
                }, opts);
                # the upgrade reads Sec-WebSocket-Key (HTTP/1.1) and the :protocol of the extended CONNECT (HTTP/2)
                wsc.connect();
                on_exit {
                    try {
                        wsc.disconnect();
                    } catch () {
                    }
                }
                wsc.send("hello");
                assertEq("echo: hello", msgs.get(Timeout), label + ": the WebSocket connection works");
            }
        }
    }

    serverSentEvents() {
        foreach string mode in (Modes) {
            ReplaySseHandler handler = mode == "hand-built" ? new FlatSseHandler() : new ReplaySseHandler();
            HttpServer hs = startServer(mode, handler);
            on_exit hs.stop();
            int port = addPlainListener(hs);

            Socket s();
            s.connect("localhost:" + port, Timeout);
            on_exit s.close();
            s.send("GET / HTTP/1.1\r\nHost: localhost\r\nAccept: " + MimeTypeSse + "\r\nLast-Event-ID: 42\r\n\r\n");
            hash<auto> rh = s.readHTTPHeader(Timeout);
            assertEq(200, rh.status_code, mode + ": the event stream is started");
            assertRegex("^" + MimeTypeSse, http_get_field(rh, "content-type"), mode + ": an event stream");
            assertEq("42", handler.replays.get(Timeout), mode + ": the events are replayed from Last-Event-ID");
        }
    }

    authentication() {
        foreach string mode in (Modes) {
            EchoHandler handler = echoHandler(mode, new TestAuthenticator());
            HttpServer hs = startServer(mode, handler);
            on_exit hs.stop();
            int port = addPlainListener(hs);

            hash<auto> resp = rawRequest(port, "GET /x HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n"
                "Authorization: Basic " + make_base64_string("user:pass") + "\r\n\r\n");
            assertEq(200, resp.hdr.status_code, mode + ": authenticated");
            assertEq("user", handler.requests.get(Timeout).user, mode + ": the user");

            resp = rawRequest(port, "GET /x HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n"
                "Authorization: Basic " + make_base64_string("user:wrong") + "\r\n\r\n");
            assertEq(401, resp.hdr.status_code, mode + ": not authenticated with a wrong password");
            resp = rawRequest(port, "GET /x HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n");
            assertEq(401, resp.hdr.status_code, mode + ": not authenticated without credentials");
        }

        # the authenticator reads the Authorization field of a header hash in every form
        TestAuthenticator auth();
        TestListener listener();
        string authorization = "Basic " + make_base64_string("user:pass");
        foreach hash<auto> hdr in (({"method": "GET", "headers": {"authorization": authorization}},
                {"method": "GET", "authorization": authorization, "headers": {"authorization": authorization}},
                {"method": "GET", "authorization": authorization})) {
            # the context is built key by key, so that it is not narrowed to the type of a literal
            hash<auto> cx = {};
            cx."peer-info" = {"address": "127.0.0.1", "address_desc": "127.0.0.1"};
            assertNothing(auth.authenticateRequest(listener, hdr, \cx), "authenticated");
            assertEq("user", cx.user);
        }
    }
}
