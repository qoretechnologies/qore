#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-exec-mode: children - the server whose read fails runs in a child process in the default mode

/*
    Copyright (C) 2026 Qore Technologies, s.r.o., all rights reserved

    Permission is hereby granted, free of charge, to any person obtaining a
    copy of this software and associated documentation files (the "Software"),
    to deal in the Software without restriction, including without limitation
    the rights to use, copy, modify, merge, publish, distribute, sublicense,
    and/or sell copies of the Software, and to permit persons to whom the
    Software is furnished to do so, subject to the following conditions:

    The above copyright notice and this permission notice shall be included in
    all copies or substantial portions of the Software.

    THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
    IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
    FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
    AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
    LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
    FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
    DEALINGS IN THE SOFTWARE.

    A body read whose buffer cannot grow fails the request (issue 7417): the buffer of a read grows as the data
    arrives, up to the size announced by the peer; when no more memory can be allocated for it, the read raises an
    exception, the connection is closed, and the server keeps serving other connections.  The server runs in a child
    process whose address space is limited once it is running, so that the buffer cannot grow far: the size of the
    address space of a process that has just started varies by gigabytes with the timing of its threads (each one that
    allocates memory can reserve an arena of its own), so the limit is set from that of the running server and not from
    that of another run (qore#7744).
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires FsUtil
%requires QUnit
%requires ../../TestInterpreter.qm

%exec-class HttpServerRecvGrowFailureTest

class HttpServerRecvGrowFailureTest inherits QUnit::Test {
    private {
        #! the room in kilobytes left in the address space of the server for the data of the request
        const Room = 512 * 1024;

        #! the most data sent for the body, in megabytes: far more than the room
        const MaxSendMb = 2048;
    }

    private:internal {
        #! the number of requests whose body read failed so far
        int failed_reads = 0;
    }

    constructor() : Test("HttpServerRecvGrowFailureTest", "1.0") {
        addTestCase("a body read whose buffer cannot grow fails the request", \growFailureTest());
        set_return_value(main());
    }

    growFailureTest() {
        if (PlatformOS != "Linux") {
            testSkip("the size of the address space of the server is read from /proc");
        }

        string qore = TestInterpreter::qore_interpreter();
        string script = get_script_dir() + DirSep + "HttpServerRecvGrowFailureServer.q";

        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        # the server's exit code is written to "rc" when it ends; it allocates from one arena: glibc reserves an
        # arena of 64 MiB of address space (and twice that while it aligns it) for each thread that allocates memory
        # beside another, so the threads that the server starts once it is limited would take the room of the data of
        # the request, and fail to start or to allocate memory instead of its read (musl has no such arenas)
        backquote(sprintf("(sh -c 'echo $$ > %s; MALLOC_ARENA_MAX=1; export MALLOC_ARENA_MAX; exec \"$0\" \"$1\"' "
            "%s %s > %s 2> %s < /dev/null; echo $? > %s) > /dev/null 2>&1 &", quote(dir + "/pid"), quote(qore),
            quote(script), quote(dir + "/out"), quote(dir + "/err"), quote(dir + "/rc")));
        on_exit {
            # the server is ended if it is still running
            if (!waitForExit(dir, 0s)) {
                *string pid = readFile(dir + "/pid");
                if (pid) {
                    system("kill -9 " + trim(pid) + " 2> /dev/null");
                }
                waitForExit(dir, 30s);
            }
        }

        int port = getPort(dir);
        int pid = trim(readFile(dir + "/pid")).toInt();

        # a body with a Content-Length, and a chunk, announced larger than any memory
        checkRequest(dir, pid, port, "Content-Length", "POST /body HTTP/1.1\r\nHost: localhost\r\n"
            "Content-Length: 999999999999999999\r\n\r\n");
        checkRequest(dir, pid, port, "chunked", "POST /body HTTP/1.1\r\nHost: localhost\r\n"
            "Transfer-Encoding: chunked\r\n\r\n7ffffffffffffffd\r\n");
        # a chunked body of chunks of 1 MiB, larger than the memory
        checkRequest(dir, pid, port, "chunks", "POST /body HTTP/1.1\r\nHost: localhost\r\n"
            "Transfer-Encoding: chunked\r\n\r\n", "100000\r\n", "\r\n");
        # the same, read by the handler as a string
        checkRequest(dir, pid, port, "string chunks", "POST /string HTTP/1.1\r\nHost: localhost\r\n"
            "Transfer-Encoding: chunked\r\n\r\n", "100000\r\n", "\r\n");

        # the server ends normally
        get(port, "quit");
        assertTrue(waitForExit(dir, 30s), "the server ends");
        assertEq("0", trim(readFile(dir + "/rc") ?? ""), "the exit code of the server: "
            + (readFile(dir + "/err") ?? ""));
    }

    #! sends the header of a request whose body is larger than any memory, and its data until the server closes the
    #! connection; checks that the read failed with an exception, and that the server serves another connection
    /** The address space of the server is limited only while the body is sent: the limit is its size then and the
        room for the data, so that what the server holds from an earlier request does not take the room; and the
        request that checks the error, which the server serves while the memory of the failed read may not be freed
        yet, is sent once the limit is lifted (qore#7775).
    */
    private checkRequest(string dir, int pid, int port, string label, string header, string before = "",
            string after = "") {
        limitAddressSpace(pid);
        bool limited = True;
        on_exit if (limited) {
            unlimitAddressSpace(pid);
        }
        Socket c();
        c.connect("127.0.0.1:" + port, 10s);
        on_exit c.close();
        c.send(header);
        binary block = binary(before + strmul("x", 1024 * 1024) + after);
        int sent = 0;
        *string send_error;
        while (sent < MaxSendMb) {
            try {
                c.send(block, 30s);
            } catch (hash<ExceptionInfo> ex) {
                send_error = ex.err;
                break;
            }
            ++sent;
        }
        if (!send_error) {
            # the server stopped keeping the body (it may discard the rest of the data before it closes the
            # connection): it answers with an error and closes the connection
            hash<auto> hdr = c.readHTTPHeader(30s);
            assertEq(500, hdr.status_code, label);
            assertEq("close", hdr.connection, label);
        }
        # the server is still running
        assertNothing(readFile(dir + "/rc"), sprintf("%s: the server is running: %s%s", label,
            readFile(dir + "/out") ?? "", readFile(dir + "/err") ?? ""));
        unlimitAddressSpace(pid);
        limited = False;

        # the server serves another connection, and the read raised an exception; the server logs it after it has
        # shut the connection down, so it may not have logged it yet: it answers once it has
        assertEq("SOCKET-RECV-ERROR", get(port, "error/" + ++failed_reads, 90s), label);
    }

    #! limits the address space of the running server to its size now and the room for the data of a request
    private limitAddressSpace(int pid) {
        string status = ReadOnlyFile::readTextFile(sprintf("/proc/%d/status", pid));
        *string vm = (status =~ x/VmSize:\s+([0-9]+)/)[0];
        if (!vm) {
            throw "TEST-ERROR", sprintf("the size of the address space of the server is not in its status: %s", status);
        }
        int limit = (vm.toInt() + Room) * 1024;
        # prlimit is in util-linux (util-linux-misc on Alpine)
        int rc;
        # the soft limit only, which the kernel enforces: a hard limit could not be raised again without privileges
        string output = backquote(sprintf("prlimit --pid %d --as=%d:unlimited 2>&1", pid, limit), \rc);
        if (rc) {
            throw "TEST-ERROR", sprintf("the address space of the server could not be limited: %s", output);
        }
        # the limit is in force before the requests are sent
        string limits = ReadOnlyFile::readTextFile(sprintf("/proc/%d/limits", pid));
        assertRegex(sprintf("Max address space\\s+%d\\s+unlimited\\s+bytes", limit), limits,
            "the address space of the server is limited");
    }

    #! lifts the limit of the address space of the server
    private unlimitAddressSpace(int pid) {
        int rc;
        string output = backquote(sprintf("prlimit --pid %d --as=unlimited 2>&1", pid), \rc);
        if (rc) {
            throw "TEST-ERROR", sprintf("the limit of the address space of the server could not be lifted: %s", output);
        }
    }

    #! returns the port of the server, which it writes once it is running
    private int getPort(string dir) {
        date end = now_us() + 60s;
        while (now_us() < end) {
            *string out = readFile(dir + "/out");
            *string port = (out =~ x/port ([0-9]+)/)[0];
            if (port) {
                return port.toInt();
            }
            if (exists readFile(dir + "/rc")) {
                break;
            }
            usleep(50ms);
        }
        throw "TEST-ERROR", sprintf("the server did not start: %s", readFile(dir + "/err") ?? "");
    }

    #! returns the body of the response to a GET request on a new connection
    private string get(int port, string path, timeout timeout = 30s) {
        Socket c();
        c.connect("127.0.0.1:" + port, 10s);
        on_exit c.close();
        c.send(sprintf("GET /%s HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n", path));
        hash<auto> hdr = c.readHTTPHeader(timeout);
        assertEq(200, hdr.status_code, path);
        return c.recv(hdr."content-length".toInt(), 30s);
    }

    #! returns True if the server has ended within the given time
    private bool waitForExit(string dir, date timeout) {
        date end = now_us() + timeout;
        while (True) {
            if (exists readFile(dir + "/rc")) {
                return True;
            }
            if (now_us() >= end) {
                return False;
            }
            usleep(50ms);
        }
    }

    #! returns the content of a file, or nothing if it does not exist or is empty
    private static *string readFile(string path) {
        try {
            string s = ReadOnlyFile::readTextFile(path);
            if (s.val()) {
                return s;
            }
        } catch (hash<ExceptionInfo> ex) {
        }
    }

    #! quotes a string for the shell
    private static string quote(string str) {
        return "'" + replace(str, "'", "'\\''") + "'";
    }
}
