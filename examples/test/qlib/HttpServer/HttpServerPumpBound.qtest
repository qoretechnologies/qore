#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# HttpServerPumpBound.qtest Copyright (C) 2026 Qore Technologies, s.r.o.
#
# test-platform: macos - HTTP/2 and HTTP/3 connections and the I/O-thread pump of response bodies
# An HTTP/2 or HTTP/3 response body that the I/O thread sends from an InputStream is ended (RST_STREAM, RESET_STREAM)
# when its client takes
# less than the listener's minimum rate, instead of holding the stream until the client gives up
# (qoretechnologies/qore#7280).  The client's withheld flow-control credit is simulated by holding the stream's data.

%modern
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires HttpServerUtil
%requires HttpServer
%requires HttpClientIo
%requires ../../TestCertificates.qm
%requires ../../RawHttp2TestClient.qm
%requires ../../TestCpuTime.qm
%requires FsUtil

%exec-class HttpServerPumpBoundTest

#! the client's own timeout, far longer than the bound
const ClientTimeout = 60s;

#! responds with a body from a C++ InputStream, which the I/O thread sends, on a stream whose data is held
class HeldBodyHandler inherits AbstractHttpRequestHandler {
    public {
        #! reports that the stream is held
        Queue held();
        #! True to hold the stream's data
        bool hold = True;
        #! the size of the body
        int body_size = 16 * 1024 * 1024;
        #! a file to send instead, if set
        *string file_path;
        #! the body to send, if made in advance (making a large one is slow under valgrind)
        *binary body_data;
        #! the monotonic time in microseconds when the last response was returned
        int response_us;
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        if (hold && cx.raw_path != "/healthy") {
            hash<auto> hi = cx."header-info";
            if (hi.http3) {
                call_function("dbg_quic_hold_stream_data", hi.session_id, hi.stream_id);
            } else {
                call_function("dbg_http2_hold_stream_data", hi.stream_id);
            }
        }
        # far more than the stream's send buffer
        InputStream is = file_path
            ? new FileInputStream(file_path)
            : new BinaryInputStream(body_data ?? binary(strmul("x", body_size)));
        response_us = clock_get_monotonic_us();
        held.push(True);
        return makeResponse(200, is, {"Content-Type": "application/octet-stream"});
    }
}

class HttpServerPumpBoundTest inherits QUnit::Test {
    constructor() : QUnit::Test("HttpServerPumpBound", "1.0") {
        foreach bool http3 in ((False, True)) {
            string v = http3 ? "HTTP/3" : "HTTP/2";
            addTestCase(v + ": a pumped body whose client takes too little is reset", \testBelowRate(), http3);
            addTestCase(v + ": a pumped body whose client takes the data arrives complete", \testHealthy(), http3);
            addTestCase(v + ": a pipe body whose writer pauses longer than the window is not reset",
                \testPipePauses(), http3);
        }
        addTestCase("HTTP/2: a connection reused after a reset serves healthy bodies", \testReuseAfterReset());
        addTestCase("HTTP/2: a client that stops reading the socket is reset (memory body)",
            \testClientStopsReading(), False);
        addTestCase("HTTP/2: a client that stops reading the socket is reset (file body)",
            \testClientStopsReading(), True);
        set_return_value(main());
    }

    #! starts the server; @p min_rate is the listener's minimum send rate
    private hash<auto> startServer(HeldBodyHandler h, int min_rate = 1048576) {
        HttpServer hs(<HttpServerOptionInfo>{});
        hs.setDefaultHandler("held", h);
        hs.waitForAsyncIo();
        int port = hs.addListener(<HttpListenerOptionInfo>{
            "node": "127.0.0.1",
            "service": 0,
            "cert": new SSLCertificate(TestCertificates::CertPem),
            "key": new SSLPrivateKey(TestCertificates::KeyPem),
            "enable_h3": True,
            "stream_send_min_rate": min_rate,
            "stream_send_min_rate_window": 1s,
        }).port;
        hs.waitForAsyncIo();
        return {"server": hs, "port": port};
    }

    #! sends the request; returns the response or raises the client's error
    private hash<auto> get(int port, bool http3) {
        if (http3) {
            HttpClientIo::HttpClientConnectionManager mgr(<HttpClientIo::HttpClientConnectionManagerOptions>{
                "protocol": "h3",
                "accept_all_certs": True,
                "request_timeout": ClientTimeout,
                "connect_timeout": 15s,
            });
            on_exit delete mgr;
            hash<auto> r = mgr.request("https://127.0.0.1:" + port, "GET", "/", NOTHING, NOTHING);
            return {"status_code": r.status_code, "body": r.body};
        }
        HTTPClient c({"url": "https://127.0.0.1:" + port, "ssl_verify_cert": False, "http_version": "2.0",
            "timeout": ClientTimeout});
        on_exit c.disconnect();
        return c.send(NOTHING, "GET", "/", NOTHING, False);
    }

    testBelowRate(bool http3) {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("requires a debug build");
        }
        HeldBodyHandler h();
        # made in advance: making it in the handler is slow under valgrind
        h.body_data = binary(strmul("x", h.body_size));
        hash<auto> setup = startServer(h);
        # at the end: the release of the data, then the stop of the server
        on_exit setup.server.stop();
        on_exit call_function(http3 ? "dbg_quic_release_stream_data" : "dbg_http2_release_stream_data");
        *string err;
        try {
            get(setup.port, http3);
        } catch (hash<ExceptionInfo> ex) {
            err = ex.err + ": " + ex.desc;
        }
        assertEq(True, h.held.get(5s), "the stream was held");
        # from the response, when the bound's measurement of the body starts
        int ms = (clock_get_monotonic_us() - h.response_us) / 1000;
        assertRegex("RESET|CANCEL", err ?? "no error", "the body was reset");
        assertGe(900, ms, "after a whole window");
        assertLt(30000, ms, "long before the client's own timeout");
    }

    #! a reset ends the measurement: the later bodies on the connection are not charged for the reset one
    testReuseAfterReset() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("requires a debug build");
        }
        HeldBodyHandler h();
        # a minimum rate far below what the client takes, also under valgrind: only the held body, which takes nothing,
        # is reset
        hash<auto> setup = startServer(h, 65536);
        on_exit setup.server.stop();
        on_exit call_function("dbg_http2_release_stream_data");
        HTTPClient c({"url": "https://127.0.0.1:" + setup.port, "ssl_verify_cert": False, "http_version": "2.0",
            "timeout": ClientTimeout});
        on_exit c.disconnect();
        *string err;
        try {
            c.send(NOTHING, "GET", "/held", NOTHING, False);
        } catch (hash<ExceptionInfo> ex) {
            err = ex.err + ": " + ex.desc;
        }
        assertRegex("RESET|CANCEL", err ?? "no error", "the held body was reset");
        for (int i = 0; i < 4; ++i) {
            hash<auto> resp = c.send(NOTHING, "GET", "/healthy", NOTHING, False);
            assertEq(16 * 1024 * 1024, resp.body.size(), sprintf("healthy body %d on the same connection", i + 1));
        }
    }

    #! a body that waits for its source does not wait for its client: the source's pauses are not charged to it
    testPipePauses(bool http3) {
        HeldBodyHandler h();
        h.hold = False;
        TmpDir dir("pump-bound-");
        h.file_path = dir.path + "/body";
        if (mkfifo(h.file_path)) {
            testSkip("mkfifo: " + strerror());
        }
        hash<auto> setup = startServer(h);
        on_exit setup.server.stop();

        # 3 chunks with pauses of 2.5 times the window between them; the client takes each chunk at once
        const int ChunkSize = 64 * 1024;
        Counter done(1);
        Queue writer_errors();
        string path = h.file_path;
        background sub () {
            on_exit done.dec();
            try {
                File f();
                f.open2(path, O_WRONLY);
                for (int i = 0; i < 3; ++i) {
                    if (i) {
                        usleep(2500ms);
                    }
                    f.write(binary(strmul(chr(ord("a") + i), ChunkSize)));
                }
                f.close();
            } catch (hash<ExceptionInfo> ex) {
                writer_errors.push(get_exception_string(ex));
            }
        }();
        # if the request fails, the writer can wait for a reader or for room in the pipe: a reader of the test's own
        # takes the rest of the data, so that the writer ends
        on_exit {
            if (done.waitForZero(1ms)) {
                try {
                    File r();
                    r.open2(path, O_RDONLY);
                    while (r.readBinary(65536)) {
                    }
                } catch (hash<ExceptionInfo> ex) {
                }
                done.waitForZero(30s);
            }
        }

        hash<auto> r = get(setup.port, http3);
        assertEq(200, r.status_code);
        assertEq(3 * ChunkSize, (r.body ?? binary()).size(), "the whole body arrived");
        assertEq(0, done.waitForZero(30s), "the writer ended");
        assertEq(0, writer_errors.size(), writer_errors.size() ? writer_errors.get() : "");
    }

    #! a client that does not read leaves the server's socket unwritable; the bound is checked all the same
    /** The client grants the largest windows, so that the server waits for the socket rather than for the client's
        credit
    */
    testClientStopsReading(bool file) {
        HeldBodyHandler h();
        h.hold = False;
        TmpDir dir("pump-bound-");
        # a body far larger than the socket buffers
        if (file) {
            # a sparse file
            h.file_path = dir.path + "/body";
            File f();
            f.open2(h.file_path, O_CREAT | O_WRONLY | O_TRUNC);
            f.setPos(4 * 1024 * 1024 * 1024 - 1);
            f.write(<00>);
            f.close();
        } else {
            h.body_data = binary(strmul("x", 256 * 1024 * 1024));
        }
        hash<auto> setup = startServer(h);
        on_exit setup.server.stop();
        RawHttp2Client c(setup.port);
        on_exit c.close();
        int stream_id = c.get("/");
        assertEq(True, h.held.get(30s), "the request was received");
        # far longer than the bound allows: the window and the largest step at the minimum rate
        hash<string, int> cpu_start = TestCpuTime::cpuSnapshot();
        usleep(15s);
        float cpu_used = TestCpuTime::cpuTimeSince(cpu_start);
        # neither the wake-ups of the bound nor the reset make the server run continuously while the client does not
        # read (qoretechnologies/qore#7641)
        # the wake-ups of the bound cost a few hundredths of a second (under 0.4 s under valgrind); continuous runs cost
        # the whole wait
        assertLt(1.5, cpu_used, sprintf("the server used %.2f s of CPU time while the client did not read for 15 s",
            cpu_used));
        # the data that the socket took, then the reset
        hash<RawHttp2StreamResult> r = c.readStream(stream_id, 60s);
        # the body is ended by the bound while the data that the client does not take fills the connection's send
        # buffer, which the server collects no frames into until it is written: the stream's RST_STREAM is never
        # written, and the connection is ended after the next window (qoretechnologies/qore#7653)
        assertTrue(r.closed, sprintf("the connection was ended while the client did not read (%d bytes taken, "
            "ended: %y)", r.data_bytes, r.ended));
        assertEq(NOTHING, r.reset_code, "no RST_STREAM was written");
        assertFalse(r.ended, "the body did not end normally");
    }

    testHealthy(bool http3) {
        HeldBodyHandler h();
        h.hold = False;
        # a minimum rate far below what the client takes, also under valgrind (about 0.7 MiB/s): the client is not reset
        hash<auto> setup = startServer(h, 65536);
        on_exit setup.server.stop();
        hash<auto> resp = get(setup.port, http3);
        assertEq(200, resp.status_code);
        assertEq(16 * 1024 * 1024, resp.body.size(), "the whole body arrived");
    }
}
