    LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
    FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
    DEALINGS IN THE SOFTWARE.

    HTTP/3 dead-peer detection tests.

    A QUIC peer that dies without a close handshake (SIGKILL, crash, network
    drop, laptop sleep) sends nothing at all — QUIC runs over UDP, so there is
    no RST and silence is the only signal.  The QUIC idle timeout is the only
    mechanism that can detect this, and its close must reach the owner of every
    stream on the dead session, or that owner's handler thread parks forever
    (one leaked thread per dead client, and HttpServer::waitStop() then blocks
    forever on shutdown).

    These tests kill a real client process with SIGKILL — nothing else
    reproduces a peer that stops answering without a single farewell packet.

    In a library-debug build the QUIC timers run on the debug-only QUIC test
    clock (dbg_quic_advance_clock()): instead of waiting for the idle timeout,
    the tests advance the clock of the connections of this process past it,
    and a live peer is kept alive across the idle windows while the clock
    advances in small steps, each processed before the next.  The QUIC timers
    then decide the outcome as with the real clock, without waiting for it;
    the packets that the connections received are counted
    (dbg_quic_packets_received()).
    In other builds the tests wait for the real clock.
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Mime
%requires Logger
%requires HttpServerUtil
%requires AsyncSocketIo
%requires HttpServerAsyncIo
%requires HttpServer
%requires WebSocketUtil
%requires WebSocketHandler
%requires WebSocketClient
%requires HttpClientIo

%exec-class HttpServerQuicDeadPeerTest

#! The control connection to a live client in a child process (see HttpServerQuicDeadPeerTest::startLiveChild())
/** Each step of the QUIC test clocks of both processes starts when each process has read the datagrams that the
    other sent and has processed them: the server's process waits for the datagrams that the child reports to have
    sent, and the child for those that the server's process has sent to it, until a round exchanges no datagram;
    then both clocks are advanced.
*/
class LiveChild {
    private {
        Socket ctl;
        Counter exited;
        bool stopped;
    }

    constructor(Socket ctl, Counter exited) {
        self.ctl = ctl;
        self.exited = exited;
    }

    #! The child's totals: {"sent": datagrams sent to the server, "received": datagrams received from it}
    hash<auto> getTotals() {
        ctl.sendi8(4);
        return {"sent": ctl.recvi8(30s), "received": ctl.recvi8(30s)};
    }

    #! Advances the QUIC test clocks of both processes by @p ms once both have read what the other sent
    step(string child_addr, int ms) {
        *int last_sent;
        *int last_child_sent;
        while (True) {
            # the datagrams received by this process are processed
            call_function("dbg_quic_advance_clock", 0);
            int sent = call_function("dbg_quic_datagram_totals").sent_to{child_addr} ?? 0;
            ctl.sendi8(1);
            ctl.sendi8(sent);
            int child_sent = ctl.recvi8(60s);
            ctl.recvi8(60s);
            if (!call_function("dbg_quic_wait_received_from", child_addr, child_sent, 30s)) {
                throw "LIVE-CHILD-ERROR", sprintf("%d datagrams from the child were not received", child_sent);
            }
            if (sent == last_sent && child_sent == last_child_sent) {
                break;
            }
            last_sent = sent;
            last_child_sent = child_sent;
        }
        ctl.sendi8(2);
        ctl.sendi8(ms);
        ctl.recvi8(60s);
        ctl.recvi8(60s);
        call_function("dbg_quic_advance_clock", ms);
    }

    #! Has the child send a message and returns True if the child received its echo from the server
    bool echo() {
        ctl.sendi8(3);
        return ctl.recvi8(60s) == 1;
    }

    #! Ends the child process and waits for it to exit
    stop() {
        if (stopped) {
            return;
        }
        stopped = True;
        try {
            ctl.sendi8(0);
        } catch () {
        }
        exited.waitForZero();
        ctl.close();
    }
}

#! WebSocket connection that signals its lifecycle to the test
class DeadPeerWsConnection inherits WebSocketConnection {
    public {
        Queue connected_signal;
        Queue closed_signal;
    }

    constructor(WebSocketHandler handler, Queue connected_signal, Queue closed_signal)
            : WebSocketConnection(handler) {
        self.connected_signal = connected_signal;
        self.closed_signal = closed_signal;
    }

    registered() {
        connected_signal.push("connected");
    }

    gotMessage(string msg) {
        send(msg);
    }

    #! Fires when the handler thread detects the connection is gone
    connectionClosed() {
        closed_signal.push("closed");
    }
}

class DeadPeerWsHandler inherits WebSocketHandler {
    public {
        Queue connected_signal();
        Queue closed_signal();
    }

    constructor(*hash<auto> opts) : WebSocketHandler(NOTHING, opts) {
    }

    WebSocketConnection getConnectionImpl(hash<auto> cx, hash<auto> hdr, string cid) {
        return new DeadPeerWsConnection(self, connected_signal, closed_signal);
    }

    logError(string fmt) {}
    logInfo(string fmt) {}
    logDebug(string fmt) {}
    logWarn(string fmt) {}
}

#! SSE handler that streams to a peer that has died
/** Pushes far more than the 1 MiB bound of the data staged for an SSE stream once the test has killed the peer:
    queueing never waits for the peer (qore#5792), so the producer is never parked on the full buffer; the dead peer
    is dropped with \c SSE-CLIENT-OVERFLOW as soon as the data staged for it would exceed the bound, without waiting
    for the QUIC idle close.
*/
class DeadPeerSseHandler inherits AbstractHttpRequestHandler {
    public {
        Queue connected_signal();
        #! Receives the error code that ended the producer loop, or "no-error"
        Queue producer_done();
        #! The producer starts when this reaches zero (once the test has killed the peer)
        Counter go(1);
    }

    hash<HttpResponseInfo> handleRequest(HttpListenerInterface listener, Socket s,
            hash<auto> cx, hash<auto> hdr, *data body) {
        if (hdr.method != "GET" || !cx."header-info".http3) {
            return makeResponse(404, "Not Found", {"Content-Type": MimeTypeText});
        }

        int session_id = cx."header-info".session_id;
        int stream_id = cx."header-info".stream_id;

        *code<nothing()> wake;
        *AsyncSocketIo::AsyncSocketIoController ctrl = cx.async_ctrl;
        if (ctrl) {
            wake = sub () { ctrl.wakeSocket(s); };
        }

        Http3SseStream sse_stream(s, session_id, stream_id, wake);
        sse_stream.sendHeaders();
        connected_signal.push("connected");

        # 64 KB per event: fills the 1 MiB stream bound quickly, as the dead peer
        # takes nothing
        string payload = strmul("x", 65536);
        string err = "no-error";
        try {
            # a hang guard only: the test releases the producer once the peer is dead
            go.waitForZero(60s);
            # Bounded so a bug cannot hang the suite forever: at 64 KB each,
            # this is ~128 MB, far beyond the buffer, so a live peer never
            # exhausts it before the test's assertions run.
            for (int i = 0; i < 2000; ++i) {
                sse_stream.queueEvent(NOTHING, payload);
            }
        } catch (hash<ExceptionInfo> ex) {
            err = ex.err;
        }
        producer_done.push(err);

        return cast<hash<HttpResponseInfo>>({
            "code": 200,
            "reply_sent": True,
            "streaming": True,
            "stream_type": "sse",
        });
    }
}

#! Answers only after staying completely silent for \c delay_secs
/** Models a slow upstream (an LLM completion call, for example): the peer
    sends NO application data at all while it computes, so nothing but the
    QUIC keep-alive can hold the session open.
*/
class SilentSlowHandler inherits AbstractHttpRequestHandler {
    public {
        int delay_secs;
        Queue request_started();
        #! with the QUIC test clock, the handler answers when this counter is zero instead of after delay_secs
        *Counter release;
    }

    constructor(int n_delay_secs, *Counter release) : AbstractHttpRequestHandler() {
        delay_secs = n_delay_secs;
        self.release = release;
    }

    hash<HttpResponseInfo> handleRequest(HttpListenerInterface listener, Socket s,
            hash<auto> cx, hash<auto> hdr, *data body) {
        request_started.push("started");
        # deliberately blocking and silent: no headers, no body, no trailers
        if (release) {
            release.waitForZero();
        } else {
            sleep(delay_secs);
        }
        return makeResponse(200, "slow-ok", {"Content-Type": MimeTypeText});
    }
}

class HttpServerQuicDeadPeerTest inherits Test {
    private {
        *Logger mLogger;

        #! QUIC idle timeout for this process, in milliseconds
        /** Applies to every session created here (client and server alike, since
            the child client process inherits the environment).  A dead peer is
            therefore detected at ~idle + idle/2 (the keepalive PING restarts our
            idle timer exactly once — RFC 9000 Section 10.1), i.e. ~15s.

            Long enough that a live peer under load still answers inside the
            window; short enough to keep the test quick.
        */
        const IdleTimeoutMs = 10000;

        #! Upper bound for the transport to reap a dead peer (~15s expected)
        const ReapTimeout = 60s;

        #! Idle window a live peer must survive — three full idle timeouts
        const LivePeerWait = 30s;

        #! The step of the QUIC test clock while a live peer is kept alive
        /** Each step is processed before the next (dbg_quic_advance_clock() processes the packets received first),
            so the connections see the time pass in small steps, as with the real clock: a large step would give an
            RTT sample as large as itself to an acknowledgement sent after it, which would raise the loss detection,
            keep-alive and idle timers by as much
        */
        const ClockStepMs = 500;

        #! WebSocket heartbeat interval used by these tests
        /** The WebSocketHandler's own heartbeat (WebSocketStreamProcessor's
            MaxMissedHeartbeats rule) is a second, application-level line of
            defence against a dead H2/H3 peer.  It is set far beyond the test's
            lifetime here so it cannot mask the transport path under test: if
            these tests pass, the QUIC idle close alone reaped the handler.
        */
        const NoHeartbeat = 3600;

        # Self-signed test certificate
        const CertPem = "-----BEGIN CERTIFICATE-----
MIIDCTCCAfGgAwIBAgIUahuuRGDlubXWYmiPhjVeT66vtNYwDQYJKoZIhvcNAQEL
