-----END PRIVATE KEY-----";

        #! Path of the qore interpreter used to spawn the victim client
        *string qore_exe;

        #! Temporary files created for child client processes
        list<string> tmp_files();

        #! True if the QUIC timers run on the debug-only QUIC test clock
        bool virtual_clock = Option::HAVE_LIBRARY_DEBUGGING;

        #! Counters that reach zero when the client processes exit, by pid file path
        hash<string, Counter> client_exited;
    }

    constructor() : Test("HttpServerQuicDeadPeerTest", "1.0") {
        # Must be set before any QUIC session is created: the value is read from
        # the real process environment per session when transport parameters are
        # built, and the child client process inherits it.  setenv() is required
        # here — assigning to ENV only mutates Qore's snapshot hash and would
        # reach neither libqore's getenv() nor the child.
        setenv("QORE_QUIC_IDLE_TIMEOUT_MS", IdleTimeoutMs);

        qore_exe = ENV.QORE_EXECUTABLE ?? ENV.QORE_BINARY ?? QORE_ARGV[0];

        addTestCase("HTTP/3 WebSocket dead peer is reaped by the QUIC idle close",
            \testH3WsDeadPeerReaped());
        addTestCase("HTTP/3 SSE dead peer is dropped at the stream's bound",
            \testH3SseDeadPeerReaped());
        addTestCase("HTTP/3 WebSocket live peer survives the idle window",
            \testH3WsLivePeerNotReaped());
        addTestCase("HTTP/3 WebSocket live peer in another process survives the idle window",
            \testH3WsLiveChildNotReaped());
        addTestCase("HTTP/3 request survives a server silent past the idle window",
            \testH3SlowSilentResponseNotIdleClosed());

        set_return_value(main());
    }

    globalSetUp() {
        mLogger = new Logger("quic-dead-peer-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            mLogger.addAppender(new StdoutAppender());
        }
    }

    globalTearDown() {
        foreach string path in (tmp_files) {
            try {
                unlink(path);
            } catch () {
            }
        }
    }

    #! Creates an HTTP/3-enabled server with the given handler bound to all paths
    private hash<auto> setupServer(AbstractHttpRequestHandler handler) {
        HttpServer server(<HttpServerOptionInfo>{
            "logger": mLogger,
            "debug": True,
        });
        server.setHandler("handler", "", NOTHING, handler);
        server.setDefaultHandler("handler", handler);
        server.waitForAsyncIo();

        hash<auto> h3info = server.addListener(<HttpListenerOptionInfo>{
            "node": "127.0.0.1",
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
            "enable_h3": True,
        });
        server.waitForAsyncIo();

        return {"server": server, "port": h3info.port};
    }

    #! Reads the pid the child recorded before connecting
    /** The child writes its pid before it makes any request, so the file is
        guaranteed complete by the time the server reports the connection — no
        polling for readiness.
    */
    private int readClientPid(string pid_path) {
        return File::readTextFile(pid_path).toInt();
    }

    #! Skips the calling test unless a real dead peer can be staged here
    /** Every assertion in this file is bound to the QUIC idle timeout.  On the wall clock, under valgrind's 20-50x
        slowdown a live peer cannot answer keepalive PINGs inside a 10s idle window, so the transport would
        (correctly) close healthy sessions and the results would be meaningless; the QUIC test clock of a debug build
        only advances when the connections have processed what they were sent, so the test runs under valgrind there.
    */
    private checkDeadPeerSupported() {
        if (!qore_exe.val()) {
            testSkip("no qore interpreter path available to spawn a client process");
        }
        if (!virtual_clock && is_file("/proc/self/maps")) {
            *string maps = ReadOnlyFile::readTextFile("/proc/self/maps");
            if (maps =~ /valgrind|vgpreload/) {
                testSkip("QUIC idle timeouts are wall-clock; incompatible with valgrind");
            }
        }
    }

    #! A dead HTTP/3 WebSocket peer must be reaped by the QUIC idle close alone
    testH3WsDeadPeerReaped() {
        checkDeadPeerSupported();

        DeadPeerWsHandler ws_handler({"heartbeat": NoHeartbeat});
        hash<auto> setup = setupServer(ws_handler);
        HttpServer server = setup.server;
        on_exit {
            server.stop();
            delete server;
        }

        string pid_path = startWsClient(setup.port);
        on_exit killClient(pid_path);

        # Deterministic: the server's own registered() hook reports the connection
        assertEq("connected", ws_handler.connected_signal.get(30s),
            "server-side WebSocket handler started");

        int pid = readClientPid(pid_path);
        assertGt(0, pid, "client process recorded its pid");

        # SIGKILL: the client vanishes without a close frame and without a QUIC
        # CONNECTION_CLOSE — the server will never hear from it again
        kill(pid, SIGKILL);
        date start = now_us();
        # past the idle timeout of the server's connection, which then sees no packet from the dead peer
        advanceClockPastIdle(pid_path);

        assertEq("closed", ws_handler.closed_signal.get(ReapTimeout),
            "QUIC idle close reaped the dead peer's WebSocket handler");

        # The heartbeat is pinned an hour out, so nothing but the transport could
        # have done this; assert the timing anyway to keep that guarantee honest.
        date elapsed = now_us() - start;
        assertLt(seconds(NoHeartbeat), elapsed,
            sprintf("handler was reaped by the transport in %y, not by a heartbeat",
                elapsed));
    }

    #! A dead HTTP/3 SSE peer is dropped as soon as the data staged for it would exceed the stream's bound
    testH3SseDeadPeerReaped() {
        checkDeadPeerSupported();

        DeadPeerSseHandler sse_handler();
        hash<auto> setup = setupServer(sse_handler);
        HttpServer server = setup.server;
        on_exit {
            server.stop();
            delete server;
        }

        string pid_path = startSseClient(setup.port);
        on_exit killClient(pid_path);

        assertEq("connected", sse_handler.connected_signal.get(30s),
            "server-side SSE producer started");

        int pid = readClientPid(pid_path);
        assertGt(0, pid, "client process recorded its pid");

        kill(pid, SIGKILL);
        # the producer starts once the peer is dead: it is never parked on the full buffer, and the dead peer is
        # dropped without waiting for the QUIC idle close (qore#5792)
        sse_handler.go.dec();
        assertEq("SSE-CLIENT-OVERFLOW", sse_handler.producer_done.get(ReapTimeout),
            "the dead SSE peer was dropped when its data reached the stream's bound");
    }

    #! A live peer must not be reaped: keepalive PINGs hold the session open
    /** The client runs in this process, so that its connection runs on the same QUIC clock as the server's
    */
    testH3WsLivePeerNotReaped() {
        checkDeadPeerSupported();

        DeadPeerWsHandler ws_handler({"heartbeat": NoHeartbeat});
        hash<auto> setup = setupServer(ws_handler);
        HttpServer server = setup.server;
        on_exit {
            server.stop();
            delete server;
        }

        Queue echoes();
        WebSocketClient wsc(sub (*data msg) {
            if (exists msg) {
                echoes.push(msg);
            }
        }, {
            "url": "wss://127.0.0.1:" + setup.port,
            "http3_mode": "required",
            "ssl_verify_cert": False,
        });
        wsc.connect();
        on_exit wsc.disconnect();

        assertEq("connected", ws_handler.connected_signal.get(30s),
            "server-side WebSocket handler started");

        # Stay idle across three idle windows without exchanging any application
        # data.  The QUIC keepalive must hold the session open; mis-firing the
        # idle close here would tear down a healthy connection, which is the
        # regression risk of this fix.
        if (virtual_clock) {
            # the clock advances in small steps across the idle windows: the keep-alive PINGs of both ends, and their
            # acknowledgements, hold the session open
            hash<auto> rx = call_function("dbg_quic_packets_received");
            advanceClockInSteps(LivePeerWait.durationMilliseconds());
            hash<auto> rx_after = call_function("dbg_quic_packets_received");
            # a PING every half idle timeout at least: more than one per end over three idle timeouts
            assertGt(rx.client + 1, rx_after.client, "the client received keep-alive packets");
            assertGt(rx.server + 1, rx_after.server, "the server received keep-alive packets");
            assertEq(0, ws_handler.closed_signal.size(), "live peer's WebSocket handler was not reaped");
        } else {
            bool timed_out = False;
            try {
                ws_handler.closed_signal.get(LivePeerWait);
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != "QUEUE-TIMEOUT") {
                    rethrow;
                }
                timed_out = True;
            }
            assertTrue(timed_out, "live peer's WebSocket handler was not reaped");
        }
        # the connection still carries messages
        wsc.send("ping-after-idle");
        assertEq("ping-after-idle", echoes.get(30s), "the live connection still works after the idle windows");
    }

    #! A live peer in another process must not be reaped: keepalive PINGs hold the session open
    /** The client runs in a child process, as a peer of a server does; its QUIC test clock is advanced with the
        server's in lockstep over a control connection (see LiveChild), each step after both processes have read the
        datagrams that the other sent (dbg_quic_datagram_totals(), dbg_quic_wait_received_from()).  Only a debug build
        has the QUIC test clock; the in-process case covers the wall clock.
    */
    testH3WsLiveChildNotReaped() {
        checkDeadPeerSupported();
        if (!virtual_clock) {
            testSkip("the QUIC test clock of the child process is only available in a debug build; the in-process "
                "case covers the wall clock");
        }

        DeadPeerWsHandler ws_handler({"heartbeat": NoHeartbeat});
        hash<auto> setup = setupServer(ws_handler);
        HttpServer server = setup.server;
        on_exit {
            server.stop();
            delete server;
        }

        # the datagrams of the process are counted from now on; the child's address is the one that appears
        call_function("dbg_quic_count_datagrams");
        hash<string, bool> peers_before = map {$1: True}, keys call_function("dbg_quic_datagram_totals")
            .received_from;

        LiveChild child = startLiveChild(setup.port);
        on_exit child.stop();

        assertEq("connected", ws_handler.connected_signal.get(30s), "server-side WebSocket handler started");
        *list<string> new_peers = select keys call_function("dbg_quic_datagram_totals").received_from,
            !peers_before{$1};
        assertEq(1, new_peers.size(), "the child is the only new peer of the server");
        string child_addr = new_peers[0];

        hash<auto> rx = child.getTotals();
        int server_rx = call_function("dbg_quic_datagram_totals").received_from{child_addr};
        for (int elapsed = 0; elapsed < LivePeerWait.durationMilliseconds(); elapsed += ClockStepMs) {
            child.step(child_addr, ClockStepMs);
        }
        hash<auto> rx_after = child.getTotals();
        # a PING every half idle timeout at least: more than one per end over three idle timeouts
        assertGt(rx.received + 1, rx_after.received, "the child received keep-alive packets");
        assertGt(server_rx + 1, call_function("dbg_quic_datagram_totals").received_from{child_addr},
            "the server received keep-alive packets");
        assertEq(0, ws_handler.closed_signal.size(), "the live child's WebSocket handler was not reaped");
        # the connection still carries messages
        assertTrue(child.echo(), "the live connection still works after the idle windows");
    }

    #! A silent slow upstream must not idle-close the caller's H3 session
    /** An async H3 request whose peer sends NOTHING for several idle windows
        must still complete: the QUIC keep-alive is the only thing holding the
        session open, and an idle close here surfaces to callers as
        @c HTTP3-IDLE-CLOSE "before any response data arrived".

        In a DEBUG build, the test-only
        @c QORE_QUIC_TEST_DISABLE_SERVER_KEEPALIVE switch disables keep-alive
        only on the Qore SERVER.  This models a third-party peer which does not
        originate keep-alive traffic independently and makes the case
        discriminate the client timer path: only client PINGs and the server's
        replies to them can keep the connection alive.  In a non-DEBUG build
        the switch is ignored, so the case remains useful as a slow-response
        smoke test but does not discriminate which peer drove the keep-alive.

        The delay spans more than two idle windows.
    */
    testH3SlowSilentResponseNotIdleClosed() {
        checkDeadPeerSupported();

        # Model a peer which ACKs client traffic but does not originate its own
        # keep-alive traffic.
        # This hook is intentionally server-only so the client remains under test.
        setenv("QORE_QUIC_TEST_DISABLE_SERVER_KEEPALIVE", "1");
        on_exit unsetenv("QORE_QUIC_TEST_DISABLE_SERVER_KEEPALIVE");

        # IdleTimeoutMs is 10s, so keep-alive fires at ~5s; stay silent well
        # past two full idle windows
        int delay_secs = (IdleTimeoutMs / 1000) * 5 / 2;
        # with the QUIC test clock, the handler answers when the test releases it, after the clock has advanced by
        # delay_secs
        *Counter release = virtual_clock ? new Counter(1) : NOTHING;
        on_exit if (release && release.getCount()) {
            release.dec();
        }
        SilentSlowHandler handler(delay_secs, release);
        hash<auto> setup = setupServer(handler);
        HttpServer server = setup.server;
        on_exit {
            server.stop();
            delete server;
        }

        # The ASYNC client is the one under test: it parks the request on the
        # async I/O controller, which only wakes on a deadline the poll-info
        # hash asks for.  The synchronous HTTPClient drives its own poll loop
        # and therefore cannot see this defect at all.
        HttpClientIo::HttpClientConnectionManager mgr(
            <HttpClientIo::HttpClientConnectionManagerOptions>{
                "protocol": "h3",
                "logger": mLogger,
                # must exceed the handler's silence, or the operation-level
                # timeout would mask the idle close under test
                "request_timeout": seconds(delay_secs + 60),
                "connect_timeout": 30s,
            },
        );
        on_exit {
            try {
                mgr.closeAll();
            } catch () {
            }
        }

        hash<auto> resp;
        try {
            if (virtual_clock) {
                resp = requestOnVirtualClock(mgr, "https://127.0.0.1:" + setup.port, handler, release, delay_secs);
            } else {
                resp = mgr.request("https://127.0.0.1:" + setup.port, "GET", "/slow");
            }
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "HTTP3-IDLE-CLOSE") {
                fail(sprintf("the QUIC session idle-closed while waiting for a "
                    "silent slow response; the keep-alive timer was not being "
                    "driven: %s: %s", ex.err, ex.desc));
            }
            rethrow;
        }
        assertEq(200, int(resp.status_code),
            "a response arriving after more than two idle windows of peer "
                "silence is received");
        assertEq("started", handler.request_started.get(1s),
            "the slow handler actually ran");
    }

    #! Advances the QUIC test clock past the idle timeout once the killed client has exited (with the QUIC test clock)
    /** Three idle timeouts: a dead peer is detected at about idle + idle/2 (see IdleTimeoutMs).  The client process
        has exited first, so that every packet it sent is already in the server's socket buffer, where the advance
        processes it on the current clock; a packet processed after the advance would give the server an RTT sample as
        large as the advance, and raise its idle timeout (at least 3 PTOs) by as much
    */
    private advanceClockPastIdle(string pid_path) {
        if (virtual_clock) {
            client_exited{pid_path}.waitForZero();
            call_function("dbg_quic_advance_clock", IdleTimeoutMs * 3);
        }
    }

    #! Advances the QUIC test clock by @p ms milliseconds in steps of ClockStepMs
    private advanceClockInSteps(int ms) {
        for (int elapsed = 0; elapsed < ms; elapsed += ClockStepMs) {
            call_function("dbg_quic_advance_clock", ClockStepMs);
        }
    }

    #! Makes the request of testH3SlowSilentResponseNotIdleClosed() while the QUIC test clock advances by delay_secs
    /** The request runs in a thread; once the handler has the request, the clock advances by delay_secs in small
        steps, and then the handler is released.

        @return the response; an error of the request is raised
    */
    private hash<auto> requestOnVirtualClock(HttpClientIo::HttpClientConnectionManager mgr, string url,
            SilentSlowHandler handler, Counter release, int delay_secs) {
        Queue result();
        background sendRequest(mgr, url, result);
        on_exit if (release.getCount()) {
            release.dec();
        }
        assertEq("started", handler.request_started.get(30s), "the slow handler received the request");
        hash<auto> rx = call_function("dbg_quic_packets_received");
        advanceClockInSteps(delay_secs * 1000);
        # the server sends no keep-alive of its own: the client's PINGs reached it
        assertGt(rx.server + 1, call_function("dbg_quic_packets_received").server,
            "the server received the client's keep-alive packets");
        # put the start signal back for the assertion of the test case
        handler.request_started.push("started");
        release.dec();
        hash<auto> h = result.get(60s);
        if (h.ex) {
            throw h.ex.err, h.ex.desc, h.ex.arg;
        }
        return h.resp;
    }

    #! Makes the request in its own thread and pushes the response or the error on @p result
    private sendRequest(HttpClientIo::HttpClientConnectionManager mgr, string url, Queue result) {
        try {
            result.push({"resp": mgr.request(url, "GET", "/slow")});
        } catch (hash<ExceptionInfo> ex) {
            result.push({"ex": ex});
        }
    }

    #! Starts the victim WebSocket client and returns its pid file path
    private string startWsClient(int port) {
        string pid_path = newTmpPath("pid");
        string script = sprintf("%%modern
%%prepend-module-path \"%s\"
%%requires WebSocketUtil
%%requires WebSocketClient

File f();
f.open2(%y, O_CREAT | O_WRONLY | O_TRUNC);
f.write(sprintf(\"%%d\", getpid()));
f.close();

WebSocketClient wsc(sub (*data msg) {}, {
    \"url\": \"wss://127.0.0.1:%d\",
    \"http3_mode\": \"required\",
    \"ssl_verify_cert\": False,
});
wsc.connect();
sleep(600s);
", get_module_path(), pid_path, port);
        client_exited{pid_path} = startClientScript(script);
        return pid_path;
    }

    #! Starts a live WebSocket client in a child process, which advances its QUIC test clock on command
    private LiveChild startLiveChild(int port) {
        Socket listener();
        listener.bindINET("127.0.0.1", "0", False, AF_INET);
        listener.listen();
        on_exit listener.close();
        string script = sprintf("%%modern
%%prepend-module-path \"%s\"
%%requires WebSocketUtil
%%requires WebSocketClient

const Server = \"127.0.0.1:%d\";
# the datagrams of the process are counted from its start, as the server counts those it receives from it
call_function(\"dbg_quic_count_datagrams\");
Socket ctl();
ctl.connect(\"127.0.0.1:%d\", 30s);
# each command and answer is small: without TCP_NODELAY, Nagle's algorithm and the delayed ACK of the peer make
# each one wait
ctl.setNoDelay(True);
Queue echoes();
WebSocketClient wsc(sub (*data msg) {
    if (exists msg) {
        echoes.push(msg);
    }
}, {
    \"url\": \"wss://\" + Server,
    \"http3_mode\": \"required\",
    \"ssl_verify_cert\": False,
});
wsc.connect();
ctl.sendi8(0);
sub totals(Socket ctl) {
    hash<auto> t = call_function(\"dbg_quic_datagram_totals\");
    ctl.sendi8(t.sent_to{Server} ?? 0);
    ctl.sendi8(t.received_from{Server} ?? 0);
}
while (True) {
    int cmd = ctl.recvi8(600s);
    switch (cmd) {
        # sync: waits for the datagrams that the server sent, processes them and gives the totals
        case 1: {
            int n = ctl.recvi8(30s);
            if (!call_function(\"dbg_quic_wait_received_from\", Server, n, 30s)) {
                throw \"LIVE-CHILD-ERROR\", sprintf(\"%%d datagrams from the server were not received\", n);
            }
            call_function(\"dbg_quic_advance_clock\", 0);
            totals(ctl);
            break;
        }
        # advances the clock
        case 2: {
            call_function(\"dbg_quic_advance_clock\", ctl.recvi8(30s));
            totals(ctl);
            break;
        }
        # sends a message and waits for its echo
        case 3: {
            wsc.send(\"ping-after-idle\");
            *string echo;
            try {
                echo = echoes.get(30s);
            } catch () {
            }
            ctl.sendi8(echo == \"ping-after-idle\" ? 1 : 0);
            break;
        }
        case 4:
            totals(ctl);
            break;
        default:
            wsc.disconnect();
            exit(0);
    }
}
", get_module_path(), port, listener.getSocketInfo().port);
        Counter exited = startClientScript(script);
        Socket ctl = listener.accept(30s);
        # each command and answer is small: without TCP_NODELAY, Nagle's algorithm and the delayed ACK of the peer
        # make each one wait
        ctl.setNoDelay(True);
        # the child has connected to the server
        assertEq(0, ctl.recvi8(30s), "the child connected");
        return new LiveChild(ctl, exited);
    }

    #! Starts the victim SSE client and returns its pid file path
    private string startSseClient(int port) {
        string pid_path = newTmpPath("pid");
        string script = sprintf("%%modern
%%prepend-module-path \"%s\"
%%requires HttpClientIo

File f();
f.open2(%y, O_CREAT | O_WRONLY | O_TRUNC);
f.write(sprintf(\"%%d\", getpid()));
f.close();

HttpClientIo::HttpClientConnectionManager mgr(
    <HttpClientIo::HttpClientConnectionManagerOptions>{
        \"protocol\": \"h3\",
        \"accept_all_certs\": True,
        \"request_timeout\": 600s,
        \"connect_timeout\": 15s,
    },
);
# Never returns: the handler streams until the peer is killed
mgr.request(\"https://127.0.0.1:%d\", \"GET\", \"/sse\");
sleep(600s);
", get_module_path(), pid_path, port);
        client_exited{pid_path} = startClientScript(script);
        return pid_path;
    }

    #! Writes @a script to a temp file and runs it in a child qore process
    /** @return a Counter that reaches zero when the child process has exited
    */
    private Counter startClientScript(string script) {
        string script_path = newTmpPath("qr");
        File f();
        f.open2(script_path, O_CREAT | O_WRONLY | O_TRUNC);
        f.write(script);
        f.close();

        # system() blocks until the child exits (i.e. until it is SIGKILLed), so
        # it must run on its own thread
        Counter exited(1);
        background runClient(script_path, exited);
        return exited;
    }

    #! Runs the client script and decrements @p exited when the child process has exited
    private runClient(string script_path, Counter exited) {
        on_exit exited.dec();
        try {
            system(sprintf("%s %s", qore_exe, script_path));
        } catch () {
        }
    }

    private string newTmpPath(string ext) {
        string path = sprintf("%s%squic-dead-peer-%d-%d.%s", tmp_location(), DirSep,
            getpid(), tmp_files.size(), ext);
        tmp_files += path;
        return path;
    }

    #! Best-effort cleanup of a child that may already be dead
    private killClient(string pid_path) {
        try {
            int pid = readClientPid(pid_path);
            if (pid > 0) {
                kill(pid, SIGKILL);
            }
        } catch () {
        }
    }

    #! Returns the qlib directory this test loads its modules from
    private string get_module_path() {
        return normalize_dir(get_script_dir() + "/../../../../qlib");
    }
}
