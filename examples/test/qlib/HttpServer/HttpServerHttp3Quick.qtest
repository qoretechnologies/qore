printf("=== Quick HTTP/3 Performance Measurement ===\n");

# Create server
HttpServer server = new HttpServer();
server.setHandler("test", "/test", NOTHING, new SimpleHandler());
server.waitForAsyncIo();

# Add QUIC listener
hash<auto> h3info = server.addQuicListener(<HttpListenerOptionInfo>{
    "cert": new SSLCertificate(CertPem),
    "key": new SSLPrivateKey(KeyPem),
});

string url = sprintf("https://127.0.0.1:%d", h3info.port);
printf("Server listening on %s\n", url);

# Create client
HttpClientIo::HttpClientConnectionManager mgr = new HttpClientConnectionManager();

# Warmup
printf("Warmup (3 requests)...\n");
for (int i = 0; i < 3; i++) {
    try {
        mgr.request(url, "GET", "/test");
    } catch (hash<ExceptionInfo> ex) {
        printf("  Warmup error: %s\n", ex.desc);
    }
}

# Benchmark: 20 sequential requests
printf("\nBenchmark: 20 sequential requests\n");
date start = now_us();
int success = 0;
int errors = 0;

for (int i = 0; i < 20; i++) {
    try {
        hash<auto> resp = mgr.request(url, "GET", "/test");
        if (resp.status_code == 200) {
            success++;
        } else {
            errors++;
        }
    } catch (hash<ExceptionInfo> ex) {
        errors++;
        if (i < 3) {
            printf("  Request %d error: %s\n", i, ex.desc);
        }
    }
}

date elapsed = now_us() - start;
float seconds = elapsed.toFloat() / 1000000.0;

# Prevent division by zero if test runs too fast
float req_per_sec = seconds > 0 ? (success + errors) / seconds : -1;
printf("Results: %d success, %d errors in %.3f seconds", success, errors, seconds);
if (req_per_sec > 0) {
    printf(" (%.1f req/sec)\n", req_per_sec);
} else {
    printf(" (< 1 microsecond)\n");
}

mgr.closeAll();
server.stop();
