#! captures the server's lingering close log messages
class LingeringCloseCapture inherits LoggerAppenderWithLayout {
    public {
        #! receives each lingering close log message
        Queue messages();
    }

    constructor() : LoggerAppenderWithLayout("capture", new LoggerLayoutPattern("%m")) {
        open();
    }

    processEventImpl(int type, auto params) {
        if (type == EVENT_LOG && params =~ /lingering close of/) {
            messages.push(params);
        }
    }
}

#! answers every request with a body naming its path; the path "close" asks for the connection to be closed
class PathHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        hash<HttpResponseInfo> rv = makeResponse(200, "path " + hdr.path, {"Content-Type": "text/plain"});
        # the path is given without its leading slash
        if (hdr.path == "close") {
            rv.close = True;
        }
        return rv;
    }
}

#! makes the connection persistent with a request ending in "start"; a request ending in "end" ends the session
class PersistentHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        if (hdr.path =~ /start$/) {
            setPersistent(True);
            return makeResponse(200, "started", {"Content-Type": "text/plain"});
        }
        return makeResponse(200, isPersistent() ? "persistent" : "not persistent", {"Content-Type": "text/plain"});
    }

    bool isPersistentSessionEndRequest(hash<auto> hdr) {
        return hdr.path =~ /end$/;
    }
}

class HttpServerLingeringCloseTest inherits QUnit::Test {
    private {
        LingeringCloseCapture capture();
        HttpServer server;
        int port;
        int ssl_port;

        #! a server that waits only briefly for the client to close
        HttpServer short_server;
        int short_port;
    }

    constructor() : Test("HttpServerLingeringCloseTest", "1.0") {
        addTestCase("unread HTTP/2 connection preface", \http2PrefaceTest());
        addTestCase("handler closes the connection with a pipelined request unread", \pipelinedRequestTest());
        addTestCase("Connection: close with nothing unread", \nothingUnreadTest());
        addTestCase("client that does not close its side", \clientDoesNotCloseTest());
        addTestCase("TLS", \tlsTest());
        addTestCase("persistent connection: the first request has the close option", \persistentFirstRequestTest());
        addTestCase("persistent connection: a later request has the close option", \persistentLaterRequestTest());
        addTestCase("persistent connection: the session end request has the close option",
            \persistentSessionEndTest());
        set_return_value(main());
    }

    globalSetUp() {
        Logger logger("lingering-close-test", LoggerLevel::getLevelDebug());
        logger.addAppender(capture);
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }
        server = new HttpServer(<HttpServerOptionInfo>{
            "logger": logger,
            "enable_h3": False,
        });
        server.setDefaultHandler("path", new PathHandler());
        server.setHandler("persist", "/persist", NOTHING, new PersistentHandler(), NOTHING, False);
        port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        ssl_port = server.addListener(<HttpListenerOptionInfo>{
            "node": "127.0.0.1",
            "service": 0,
            "cert": new SSLCertificate(TestCert),
            "key": new SSLPrivateKey(TestCert),
        }).port;

        short_server = new HttpServer(<HttpServerOptionInfo>{
            "logger": logger,
            "enable_h3": False,
            "lingering_close_timeout": 250ms,
        });
        short_server.setDefaultHandler("path", new PathHandler());
        short_port = short_server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        server.waitForAsyncIo();
        short_server.waitForAsyncIo();
    }

    globalTearDown() {
        delete server;
        delete short_server;
    }

    #! the case that failed on macOS CI: an HTTP/1 server answers an HTTP/2 client's connection preface with 501
    http2PrefaceTest() {
        Socket s = connect(port);
        on_exit s.close();

        # the header ends after "PRI * HTTP/2.0\r\n\r\n"; the rest of the preface is never read
        binary junk = binary(strmul("j", 65536));
        s.send(binary("PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n") + junk);
        hash<auto> resp = readResponse(s);
        assertEq(501, resp.status_code, "the preface is answered with 501");
        assertThrows("SOCKET-CLOSED", \s.recv(), (1, 10s), "the response is followed by the end of the stream");
        # the server still receives, so data sent now does not make it reset the connection
        s.send(junk);
        s.close();

        hash<auto> info = getLingeringClose();
        assertEq(6 + 2 * junk.size(), info.discarded, "all unread data was discarded");
        assertTrue(info.peer_closed, "the connection ended when the client closed it");
    }

    pipelinedRequestTest() {
        Socket s = connect(port);
        on_exit s.close();

        string second = "GET /second HTTP/1.1\r\nHost: localhost\r\n\r\n";
        s.send("GET /close HTTP/1.1\r\nHost: localhost\r\n\r\n" + second);
        hash<auto> resp = readResponse(s);
        assertEq(200, resp.status_code);
        assertEq("path close", resp.body, "the first request was answered");
        assertThrows("SOCKET-CLOSED", \s.recv(), (1, 10s), "the pipelined request is not answered");
        s.close();

        hash<auto> info = getLingeringClose();
        assertEq(second.size(), info.discarded, "the pipelined request was discarded");
        assertTrue(info.peer_closed, "the connection ended when the client closed it");
    }

    nothingUnreadTest() {
        Socket s = connect(port);
        on_exit s.close();

        s.send("GET /done HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n");
        hash<auto> resp = readResponse(s);
        assertEq("path done", resp.body);
        assertThrows("SOCKET-CLOSED", \s.recv(), (1, 10s), "the response is followed by the end of the stream");
        s.close();

        hash<auto> info = getLingeringClose();
        assertEq(0, info.discarded, "there was nothing to discard");
        assertTrue(info.peer_closed, "the connection ended when the client closed it");
    }

    #! the server stops waiting after its lingering close timeout
    clientDoesNotCloseTest() {
        Socket s = connect(short_port);
        on_exit s.close();

        s.send("GET /close HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> resp = readResponse(s);
        assertEq("path close", resp.body);
        assertThrows("SOCKET-CLOSED", \s.recv(), (1, 10s), "the response is followed by the end of the stream");

        # the client keeps its side open; the server closes when its timeout expires
        string msg = capture.messages.get(30s);
        assertRegex("lingering close of .* ended: SOCKET-TIMEOUT", msg, "the wait ended with the timeout");
    }

    tlsTest() {
        Socket s();
        s.connectSSL(sprintf("127.0.0.1:%d", ssl_port), 10s);
        on_exit s.close();

        s.send("GET /close HTTP/1.1\r\nHost: localhost\r\n\r\n" + strmul("t", 16384));
        hash<auto> resp = readResponse(s);
        assertEq("path close", resp.body, "the response is read");
        assertThrows("SOCKET-CLOSED", \s.recv(), (1, 10s), "the response is followed by the end of the TLS stream");
        s.close();

        hash<auto> info = getLingeringClose();
        # the unread record, as encrypted on the wire, and the client's closing alert
        assertGt(16384, info.discarded, "the unread data was discarded");
        assertTrue(info.peer_closed, "the connection ended when the client closed it");
    }

    #! the response to the request that makes the connection persistent is also its last one
    persistentFirstRequestTest() {
        Socket s = connect(port);
        on_exit s.close();

        string pipelined = "GET /second HTTP/1.1\r\nHost: localhost\r\n\r\n";
        s.send("GET /persist/start HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n" + pipelined);
        assertEq("started", readResponse(s).body);
        assertThrows("SOCKET-CLOSED", \s.recv(), (1, 10s), "the response is followed by the end of the stream");
        s.close();

        hash<auto> info = getLingeringClose();
        assertEq(pipelined.size(), info.discarded, "the pipelined request was discarded");
        assertTrue(info.peer_closed, "the connection ended when the client closed it");
    }

    #! a request on the persistent connection's dedicated thread closes the connection
    persistentLaterRequestTest() {
        Socket s = connect(port);
        on_exit s.close();

        s.send("GET /persist/start HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq("started", readResponse(s).body);
        s.send("GET /persist/next HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq("persistent", readResponse(s).body);

        string pipelined = "GET /second HTTP/1.1\r\nHost: localhost\r\n\r\n";
        s.send("GET /persist/last HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n" + pipelined);
        assertEq("persistent", readResponse(s).body);
        assertThrows("SOCKET-CLOSED", \s.recv(), (1, 10s), "the response is followed by the end of the stream");
        s.close();

        hash<auto> info = getLingeringClose();
        assertEq(pipelined.size(), info.discarded, "the pipelined request was discarded");
        assertTrue(info.peer_closed, "the connection ended when the client closed it");
    }

    #! the request that ends the persistent session also closes the connection
    persistentSessionEndTest() {
        Socket s = connect(port);
        on_exit s.close();

        s.send("GET /persist/start HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertEq("started", readResponse(s).body);

        string pipelined = "GET /second HTTP/1.1\r\nHost: localhost\r\n\r\n";
        s.send("GET /persist/end HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n" + pipelined);
        assertEq("OK", readResponse(s).body, "the session end request is answered");
        assertThrows("SOCKET-CLOSED", \s.recv(), (1, 10s), "the response is followed by the end of the stream");
        s.close();

        hash<auto> info = getLingeringClose();
        assertEq(pipelined.size(), info.discarded, "the pipelined request was discarded");
        assertTrue(info.peer_closed, "the connection ended when the client closed it");
    }

    #! returns the next completed lingering close logged by the server
    private hash<auto> getLingeringClose() {
        string msg = capture.messages.get(30s);
        *list<string> m = (msg =~ x/complete: discarded ([0-9]+) bytes?; peer closed: (True|False); discard limit reached: (True|False)/);
        assertEq(3, m.size(), sprintf("the lingering close completed: %y", msg));
        return {
            "discarded": m[0].toInt(),
            "peer_closed": m[1] == "True",
            "max_discard_reached": m[2] == "True",
        };
    }

    private Socket connect(int p) {
        Socket s();
        s.connect(sprintf("127.0.0.1:%d", p), 10s);
        return s;
    }

    #! reads a response with a Content-Length
    private hash<auto> readResponse(Socket s) {
        hash<auto> hdr = s.readHTTPHeader(10s);
        int len = hdr."content-length".toInt();
        return {
            "status_code": hdr.status_code,
            "body": len ? s.recv(len, 10s) : "",
        };
    }
}
