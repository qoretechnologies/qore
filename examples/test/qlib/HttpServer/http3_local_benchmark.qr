#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

# http3_local_benchmark.qr - HTTP/3 vs HTTP/2 vs HTTP/1.1 Local Performance Benchmark
# Copyright 2026 Qore Technologies, s.r.o.

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/Mime.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/HttpServerUtil.qm
%requires ../../../../qlib/AsyncSocketIo
%requires ../../../../qlib/HttpServerAsyncIo
%requires ../../../../qlib/HttpServer.qm
%requires ../../../../qlib/HttpClientIo

%exec-class Http3LocalBenchmark

#! HTTP/3 vs HTTP/2 vs HTTP/1.1 Local Performance Benchmark
/** Runs benchmarks against a local HttpServer to measure protocol-level performance.
    Compares:
    - Sequential request throughput (req/s)
    - Connection establishment overhead
    - Concurrent request throughput (multiplexing)
    - Large body transfer throughput (MB/s)
    - Latency distribution (P50/P95/P99)
    - curl --http3 external reference

    Usage:
      qore http3_local_benchmark.qr [iterations] [concurrent] [-v]

    @since Qore 2.2
*/
public class Http3LocalBenchmark {
    public {
        const DefaultIterations = 100;
        const DefaultConcurrent = 10;

        # Self-signed test certificate (RSA 2048-bit, CN=localhost, valid 10 years)
        const CertPem = "-----BEGIN CERTIFICATE-----
