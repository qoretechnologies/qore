    CallbackInputStream and HTTP/2 streaming tests

    Comprehensive test suite for CallbackInputStream, HTTP/2 chunked streaming
    via AbstractStreamRequest, HTTP/1.x chunked transfer-encoding regression,
    content encoding opt-out via needsContentEncoding(), and REST stream
    handler integration through AbstractRestStreamRequestHandler.
*/

%modern

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Mime.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/HttpServerUtil.qm
%requires ../../../../qlib/HttpServerAsyncIo
%requires ../../../../qlib/HttpServer.qm
%requires ../../../../qlib/RestSchemaValidator.qm
%requires ../../../../qlib/RestHandler.qm
%requires ../../../../qlib/RestClient.qm

%exec-class HttpServerStreamCallbackTest

# ---------------------------------------------------------------------------
# Stream request classes
# ---------------------------------------------------------------------------

#! Chunked stream request returning 3 string chunks
class ChunkedStreamRequest inherits AbstractStreamRequest {
    private {
        list<string> chunks;
        int idx = 0;
    }

    constructor(HttpListenerInterface listener, AbstractHttpRequestHandler handler, Socket s, hash<auto> cx,
            hash<auto> hdr, *data body, list<string> chunks)
            : AbstractStreamRequest(listener, handler, s, cx, hdr, body) {
        self.chunks = chunks;
    }

    private hash<HttpResponseInfo> getResponseHeaderMessageImpl() {
        return <HttpResponseInfo>{
            "code": 200,
            "hdr": {
                "Transfer-Encoding": "chunked",
                "Content-Type": "text/plain",
            },
        };
    }

    private auto sendImpl() {
        if (idx >= chunks.size()) {
            return;
        }
        return chunks[idx++];
    }
}

#! Handler that streams 3 string chunks
class ChunkedStreamHandler inherits AbstractHttpRequestHandler {
    constructor() : AbstractHttpRequestHandler(NOTHING, True) {
    }

    private AbstractStreamRequest getStreamRequestImpl(HttpListenerInterface listener, Socket s, hash<auto> cx,
            hash<auto> hdr, *data body) {
        return new ChunkedStreamRequest(listener, self, s, cx, hdr, body,
            ("chunk-1-", "chunk-2-", "chunk-3"));
    }
}

#! Chunked stream request returning binary chunks
class BinaryChunkedStreamRequest inherits AbstractStreamRequest {
    private {
        list<binary> chunks;
        int idx = 0;
    }

    constructor(HttpListenerInterface listener, AbstractHttpRequestHandler handler, Socket s, hash<auto> cx,
            hash<auto> hdr, *data body, list<binary> chunks)
            : AbstractStreamRequest(listener, handler, s, cx, hdr, body) {
        self.chunks = chunks;
    }

    private hash<HttpResponseInfo> getResponseHeaderMessageImpl() {
        return <HttpResponseInfo>{
            "code": 200,
            "hdr": {
                "Transfer-Encoding": "chunked",
                "Content-Type": "application/octet-stream",
            },
        };
    }

    private auto sendImpl() {
        if (idx >= chunks.size()) {
            return;
        }
        return chunks[idx++];
    }
}

#! Handler that streams binary chunks
class BinaryChunkedStreamHandler inherits AbstractHttpRequestHandler {
    constructor() : AbstractHttpRequestHandler(NOTHING, True) {
    }

    private AbstractStreamRequest getStreamRequestImpl(HttpListenerInterface listener, Socket s, hash<auto> cx,
            hash<auto> hdr, *data body) {
        return new BinaryChunkedStreamRequest(listener, self, s, cx, hdr, body,
            (<bead>, <cafe>, <f00d>));
    }
}

#! Chunked stream request returning 10 chunks of 64KB data
class LargeStreamRequest inherits AbstractStreamRequest {
    private {
        int idx = 0;
        int num_chunks = 10;
        int chunk_size = 65536;
    }

    constructor(HttpListenerInterface listener, AbstractHttpRequestHandler handler, Socket s, hash<auto> cx,
            hash<auto> hdr, *data body)
            : AbstractStreamRequest(listener, handler, s, cx, hdr, body) {
    }

    private hash<HttpResponseInfo> getResponseHeaderMessageImpl() {
        return <HttpResponseInfo>{
            "code": 200,
            "hdr": {
                "Transfer-Encoding": "chunked",
                "Content-Type": "application/octet-stream",
            },
        };
    }

    private auto sendImpl() {
        if (idx >= num_chunks) {
            return;
        }
        idx += 1;
        return strmul("L", chunk_size);
    }
}

#! Handler that streams 10 chunks of 64KB
class LargeStreamHandler inherits AbstractHttpRequestHandler {
    constructor() : AbstractHttpRequestHandler(NOTHING, True) {
    }

    private AbstractStreamRequest getStreamRequestImpl(HttpListenerInterface listener, Socket s, hash<auto> cx,
            hash<auto> hdr, *data body) {
        return new LargeStreamRequest(listener, self, s, cx, hdr, body);
    }
}

#! Chunked stream request that returns NOTHING immediately (empty stream)
class EmptyStreamRequest inherits AbstractStreamRequest {
    constructor(HttpListenerInterface listener, AbstractHttpRequestHandler handler, Socket s, hash<auto> cx,
            hash<auto> hdr, *data body)
            : AbstractStreamRequest(listener, handler, s, cx, hdr, body) {
    }

    private hash<HttpResponseInfo> getResponseHeaderMessageImpl() {
        return <HttpResponseInfo>{
            "code": 200,
            "hdr": {
                "Transfer-Encoding": "chunked",
                "Content-Type": "text/plain",
            },
        };
    }

    private auto sendImpl() {
        return;
    }
}

#! Handler that streams an empty body
class EmptyStreamHandler inherits AbstractHttpRequestHandler {
    constructor() : AbstractHttpRequestHandler(NOTHING, True) {
    }

    private AbstractStreamRequest getStreamRequestImpl(HttpListenerInterface listener, Socket s, hash<auto> cx,
            hash<auto> hdr, *data body) {
        return new EmptyStreamRequest(listener, self, s, cx, hdr, body);
    }
}

#! Chunked stream request that throws an exception after 2 chunks
class ErrorStreamRequest inherits AbstractStreamRequest {
    private {
        int idx = 0;
    }

    constructor(HttpListenerInterface listener, AbstractHttpRequestHandler handler, Socket s, hash<auto> cx,
            hash<auto> hdr, *data body)
            : AbstractStreamRequest(listener, handler, s, cx, hdr, body) {
    }

    private hash<HttpResponseInfo> getResponseHeaderMessageImpl() {
        return <HttpResponseInfo>{
            "code": 200,
            "hdr": {
                "Transfer-Encoding": "chunked",
                "Content-Type": "text/plain",
            },
        };
    }

    private auto sendImpl() {
        if (idx >= 2) {
            throw "STREAM-ERROR", "simulated mid-stream error after 2 chunks";
        }
        return sprintf("err-chunk-%d-", idx++);
    }
}

#! Handler that errors mid-stream
class ErrorStreamHandler inherits AbstractHttpRequestHandler {
    constructor() : AbstractHttpRequestHandler(NOTHING, True) {
    }

    private AbstractStreamRequest getStreamRequestImpl(HttpListenerInterface listener, Socket s, hash<auto> cx,
            hash<auto> hdr, *data body) {
        return new ErrorStreamRequest(listener, self, s, cx, hdr, body);
    }
}

#! Stream request that opts out of content encoding
class NoEncodingStreamRequest inherits AbstractStreamRequest {
    private {
        list<string> chunks;
        int idx = 0;
    }

    constructor(HttpListenerInterface listener, AbstractHttpRequestHandler handler, Socket s, hash<auto> cx,
            hash<auto> hdr, *data body, list<string> chunks)
            : AbstractStreamRequest(listener, handler, s, cx, hdr, body) {
        self.chunks = chunks;
    }

    #! Override to opt out of server-applied content encoding
    bool needsContentEncoding() {
        return False;
    }

    private hash<HttpResponseInfo> getResponseHeaderMessageImpl() {
        return <HttpResponseInfo>{
            "code": 200,
            "hdr": {
                "Transfer-Encoding": "chunked",
                "Content-Type": "text/plain",
            },
        };
    }

    private auto sendImpl() {
        if (idx >= chunks.size()) {
            return;
        }
        return chunks[idx++];
    }
}

#! Handler whose stream request opts out of content encoding
class NoEncodingStreamHandler inherits AbstractHttpRequestHandler {
    constructor() : AbstractHttpRequestHandler(NOTHING, True) {
    }

    private AbstractStreamRequest getStreamRequestImpl(HttpListenerInterface listener, Socket s, hash<auto> cx,
            hash<auto> hdr, *data body) {
        return new NoEncodingStreamRequest(listener, self, s, cx, hdr, body,
            ("no-enc-1-", "no-enc-2-", "no-enc-3"));
    }
}

# ---------------------------------------------------------------------------
# Persistent stream handler classes
# ---------------------------------------------------------------------------

#! Tracks persistent connection close notifications
class PersistentClosedTracker {
    private {
        Mutex mtx();
        Condition cond();
        int closed_count = 0;
    }

    #! Called by notifyClosed callback
    persistentClosed() {
        mtx.lock();
        on_exit mtx.unlock();
        closed_count++;
        cond.broadcast();
    }

    #! Waits until at least one close notification is received
    bool waitForClosed(timeout max_wait = 5s) {
        date deadline = now_us() + max_wait;
        mtx.lock();
        on_exit mtx.unlock();
        while (closed_count == 0) {
            timeout remaining = deadline - now_us();
            if (remaining <= 0) {
                return False;
            }
            cond.wait(mtx, remaining);
        }
        return True;
    }

    int getClosedCount() {
        mtx.lock();
        on_exit mtx.unlock();
        return closed_count;
    }

    reset() {
        mtx.lock();
        on_exit mtx.unlock();
        closed_count = 0;
    }
}

#! Handler that supports persistent mode with stream (send_callback) responses
/** Uses send_callback in handleRequest to return chunked data, combined with
    setPersistent for thread affinity. This tests the combination of persistence
    and streaming that is used by DataStream handlers in production.
*/
class PersistentStreamHandler inherits AbstractHttpRequestHandler {
    private {
        PersistentClosedTracker tracker;
    }

    constructor(PersistentClosedTracker tracker) : AbstractHttpRequestHandler() {
        self.tracker = tracker;
    }

    #! Creates a send_callback closure from a chunk list
    static code makeSendCallback(list<string> chunks) {
        int idx = 0;
        return auto sub() {
            if (idx >= chunks.size()) {
                return;
            }
            return chunks[idx++];
        };
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        string path = hdr.path;
        int tid = gettid();
        hash<auto> thdr = {"X-Thread-Id": string(tid)};

        if (path =~ /\/start$/) {
            setPersistent(True);
            notifyClosed(\tracker.persistentClosed());
            return makeResponse(thdr, 200, "started");
        } else if (path =~ /\/end$/) {
            setPersistent(False);
            return makeResponse(thdr, 200, "ended");
        } else if (path =~ /\/simple$/) {
            return makeResponse(thdr, 200, "simple-ok");
        } else if (path =~ /\/no-enc-stream/) {
            # DataStream-style: send_callback with no_content_encoding
            return <HttpResponseInfo>{
                "code": 200,
                "body": NOTHING,
                "hdr": thdr + {
                    "Transfer-Encoding": "chunked",
                    "Content-Type": "text/plain",
                },
                "send_callback": PersistentStreamHandler::makeSendCallback(("ds-1-", "ds-2-", "ds-3")),
                "no_content_encoding": True,
            };
        } else if (path =~ /\/normal-stream/) {
            # Normal chunked stream via send_callback
            return <HttpResponseInfo>{
                "code": 200,
                "body": NOTHING,
                "hdr": thdr + {
                    "Transfer-Encoding": "chunked",
                    "Content-Type": "text/plain",
                },
                "send_callback": PersistentStreamHandler::makeSendCallback(("chunk-1-", "chunk-2-", "chunk-3")),
            };
        }

        return makeResponse(thdr, 404, "not found");
    }
}

# ---------------------------------------------------------------------------
# REST stream handler classes
# ---------------------------------------------------------------------------

#! REST stream request handler for integration tests
class TestRestStreamRequestHandler inherits RestHandler::AbstractRestStreamRequestHandler {
    private {
        list<string> chunks;
        int idx = 0;
    }

    constructor(hash<auto> cx, *hash<auto> ah, list<string> chunks)
            : AbstractRestStreamRequestHandler(cx, ah) {
        self.chunks = chunks;
    }

    hash<auto> getResponseHeaderMessageImpl() {
        return {
            "code": 200,
            "raw_response": True,
            "hdr": {
                "Transfer-Encoding": "chunked",
                "Content-Type": "text/plain",
            },
        };
    }

    nothing recvImpl(hash<auto> v) {
        # no-op: we are only sending
    }

    auto sendImpl() {
        if (idx >= chunks.size()) {
            return;
        }
        return chunks[idx++];
    }
}

#! REST stream request handler that opts out of content encoding
class TestRestNoEncodingStreamHandler inherits RestHandler::AbstractRestStreamRequestHandler {
    private {
        list<string> chunks;
        int idx = 0;
    }

    constructor(hash<auto> cx, *hash<auto> ah, list<string> chunks)
            : AbstractRestStreamRequestHandler(cx, ah) {
        self.chunks = chunks;
    }

    bool needsContentEncoding() {
        return False;
    }

    hash<auto> getResponseHeaderMessageImpl() {
        return {
            "code": 200,
            "raw_response": True,
            "hdr": {
                "Transfer-Encoding": "chunked",
                "Content-Type": "text/plain",
            },
        };
    }

    nothing recvImpl(hash<auto> v) {
    }

    auto sendImpl() {
        if (idx >= chunks.size()) {
            return;
        }
        return chunks[idx++];
    }
}

#! REST class that creates stream request handlers for GET
class TestRestStreamClass inherits RestHandler::AbstractRestClass {
    string name() {
        return "stream-test";
    }

    RestHandler::AbstractRestStreamRequestHandler streamGet(hash<auto> cx, *hash<auto> ah) {
        return new TestRestStreamRequestHandler(cx, ah, ("rest-chunk-1-", "rest-chunk-2-", "rest-chunk-3"));
    }
}

#! REST class that creates stream request handlers with no content encoding
class TestRestNoEncodingClass inherits RestHandler::AbstractRestClass {
    string name() {
        return "stream-no-enc";
    }

    RestHandler::AbstractRestStreamRequestHandler streamGet(hash<auto> cx, *hash<auto> ah) {
        return new TestRestNoEncodingStreamHandler(cx, ah,
            ("rest-no-enc-1-", "rest-no-enc-2-", "rest-no-enc-3"));
    }
}

#! REST handler with stream classes registered, mounted at /rest-stream
class TestRestRootHandler inherits RestHandler::RestHandler {
    constructor() : RestHandler::RestHandler() {
        addClass(new TestRestStreamClass());
        addClass(new TestRestNoEncodingClass());
    }

    #! Strip the /rest-stream prefix from paths so REST dispatch works correctly
    removeRootPath(reference<string> path) {
        path = regex_subst(path, "^/?rest-stream/?", "");
    }
}

#! Simple helper class used as an owner reference for CallbackInputStream unit tests
class CallbackOwner {
    private {
        list<auto> chunks;
        int idx = 0;
    }

    constructor(list<auto> chunks) {
        self.chunks = chunks;
    }

    *data nextChunk() {
        if (idx >= chunks.size()) {
            return;
        }
        return chunks[idx++];
    }

    resetIndex() {
        idx = 0;
    }
}

#! Owner that throws after n chunks (for error propagation tests)
class ErrorCallbackOwner {
    private {
        list<auto> chunks;
        int idx = 0;
        int error_after;
    }

    constructor(list<auto> chunks, int error_after) {
        self.chunks = chunks;
        self.error_after = error_after;
    }

    *data nextChunk() {
        if (idx >= error_after) {
            throw "CB-ERROR", sprintf("callback error on chunk %d", idx);
        }
        if (idx >= chunks.size()) {
            return;
        }
        return chunks[idx++];
    }
}

