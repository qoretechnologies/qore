    constructor() : Test("HttpServerAsyncHttp2IoUringTest", "1.0") {
        addTestCase("basic file streaming", \testBasicFileStream());
        addTestCase("small file streaming", \testSmallFileStream());
        addTestCase("large file streaming (10MB)", \testLargeFileStream());
        addTestCase("concurrent file streams", \testConcurrentFileStreams());
        addTestCase("mixed file and memory streams", \testMixedStreams());
        addTestCase("sequential file streams on same connection", \testSequentialFileStreams());
        addTestCase("file streaming does not block non-streaming requests", \testFileStreamWithPing());

        set_return_value(main());
    }

    globalSetUp() {
        Logger logger("iouring-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }

        hash<HttpServerOptionInfo> opts = <HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
            "async_mode": True,
        };
        mServer = new HttpServer(opts);

        mTmpDir = tmp_location() + "/iouring-test-" + getpid();
        mkdir(mTmpDir);

        mServer.setHandler("file-stream", "/file-stream", NOTHING, new FileStreamHandler(mTmpDir));
        mServer.setHandler("mem-stream", "/mem-stream", NOTHING, new MemoryStreamHandler());
        mServer.setHandler("ping", "/ping", NOTHING, new PingHandler());

        mSslPort = mServer.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        }).port;
        mSslUrl = "https://localhost:" + mSslPort;

        mServer.waitForAsyncIo();

        if (m_options.verbose > 1) {
            printf("HTTPS io_uring test server on port %d\n", mSslPort);
        }
    }

    globalTearDown() {
        delete mServer;
        # Clean up temp files
        *list<string> files = glob(mTmpDir + "/*");
        if (files) {
            for (int i = 0; i < files.size(); ++i) {
                unlink(files[i]);
            }
        }
        rmdir(mTmpDir);
    }

    private RestClient getClient(timeout timeout_ms = 30000) {
        return new RestClient({
            "url": mSslUrl,
            "ssl_verify_cert": False,
            "http_version": "2",
            "timeout": timeout_ms,
            "connect_timeout": timeout_ms,
        });
    }

    #! Helper to verify response body
    private verifyBody(hash<auto> resp, int expected_size, string expected_char, string desc) {
        assertEq(200, resp.status_code, desc + " status");
        string body_str;
        if (resp.body.typeCode() == NT_BINARY) {
            body_str = resp.body.toString();
        } else {
            body_str = resp.body;
        }
        assertEq(expected_size, body_str.length(), desc + " size");
        assertEq(strmul(expected_char, expected_size), body_str, desc + " content");
    }

    testBasicFileStream() {
        RestClient rc = getClient();

        # Capture io_uring stats before the request (debug builds only)
        *hash<auto> stats_before = get_io_uring_debug_stats();

        # 64KB — exercises at least one full io_uring read buffer
        int size = 65536;
        hash<auto> resp = rc.get("/file-stream/" + size);
        verifyBody(resp, size, "F", "basic 64KB file stream");

        # Verify io_uring was actually exercised (debug builds on Linux with io_uring)
        *hash<auto> stats_after = get_io_uring_debug_stats();
        if (stats_before && stats_after) {
            assertTrue(stats_after.submits > stats_before.submits,
                sprintf("io_uring submits increased (%d -> %d)",
                    stats_before.submits, stats_after.submits));
            assertTrue(stats_after.completions > stats_before.completions,
                sprintf("io_uring completions increased (%d -> %d)",
                    stats_before.completions, stats_after.completions));
        }
    }

    testSmallFileStream() {
        RestClient rc = getClient();

        # 100 bytes — smaller than the io_uring buffer, single read
        int size = 100;
        hash<auto> resp = rc.get("/file-stream/" + size);
        verifyBody(resp, size, "F", "small file stream");
    }

    testLargeFileStream() {
        RestClient rc = getClient(60000);

        *hash<auto> stats_before = get_io_uring_debug_stats();

        # 10MB — requires many io_uring reads to complete
        int size = 10 * 1024 * 1024;
        hash<auto> resp = rc.get("/file-stream/" + size);
        assertEq(200, resp.status_code, "large file stream status");
        int body_size;
        if (resp.body.typeCode() == NT_BINARY) {
            body_size = resp.body.size();
        } else {
            body_size = resp.body.length();
        }
        assertEq(size, body_size, "large file stream body size");

        # Verify content integrity — check first and last 1KB
        string body_str;
        if (resp.body.typeCode() == NT_BINARY) {
            body_str = resp.body.toString();
        } else {
            body_str = resp.body;
        }
        assertEq(strmul("F", 1024), substr(body_str, 0, 1024), "large file first 1KB");
        assertEq(strmul("F", 1024), substr(body_str, size - 1024), "large file last 1KB");

        # 10MB with 64KB reads = at least 160 io_uring submits/completions
        *hash<auto> stats_after = get_io_uring_debug_stats();
        if (stats_before && stats_after) {
            int submit_delta = stats_after.submits - stats_before.submits;
            assertTrue(submit_delta >= 100,
                sprintf("10MB file required many io_uring reads (%d submits)", submit_delta));
        }
    }

    testConcurrentFileStreams() {
        # Use multiple concurrent requests on the same HTTP/2 connection
        # to exercise io_uring handling of multiple in-flight file reads
        RestClient rc = getClient(30000);

        int size1 = 32768;
        int size2 = 65536;
        int size3 = 16384;

        Counter cnt(3);
        list<hash<auto>> results();
        Mutex mtx();

        background sub() {
            on_exit cnt.dec();
            try {
                hash<auto> resp = rc.get("/file-stream/" + size1);
                {
                    mtx.lock();
                    on_exit mtx.unlock();
                    results += resp;
                }
            } catch (hash<ExceptionInfo> ex) {
                {
                    mtx.lock();
                    on_exit mtx.unlock();
                    results += {"status_code": -1, "error": ex.err + ": " + ex.desc};
                }
            }
        }();

        background sub() {
            on_exit cnt.dec();
            try {
                hash<auto> resp = rc.get("/file-stream/" + size2);
                {
                    mtx.lock();
                    on_exit mtx.unlock();
                    results += resp;
                }
            } catch (hash<ExceptionInfo> ex) {
                {
                    mtx.lock();
                    on_exit mtx.unlock();
                    results += {"status_code": -1, "error": ex.err + ": " + ex.desc};
                }
            }
        }();

        background sub() {
            on_exit cnt.dec();
            try {
                hash<auto> resp = rc.get("/file-stream/" + size3);
                {
                    mtx.lock();
                    on_exit mtx.unlock();
                    results += resp;
                }
            } catch (hash<ExceptionInfo> ex) {
                {
                    mtx.lock();
                    on_exit mtx.unlock();
                    results += {"status_code": -1, "error": ex.err + ": " + ex.desc};
                }
            }
        }();

        int rc_val = cnt.waitForZero(30s);
        assertEq(0, rc_val, "concurrent streams completed");
        assertEq(3, results.size(), "got 3 results");

        # All requests should succeed
        for (int i = 0; i < results.size(); ++i) {
            assertEq(200, results[i].status_code,
                sprintf("concurrent stream %d status (error: %s)", i, results[i].error ?? "none"));
        }

        # Verify sizes — sort results by body size to match
        list<int> body_sizes();
        for (int i = 0; i < results.size(); ++i) {
            if (results[i].body.typeCode() == NT_BINARY) {
                body_sizes += results[i].body.size();
            } else {
                body_sizes += results[i].body.length();
            }
        }
        body_sizes = sort(body_sizes);
        assertEq((size3, size1, size2), body_sizes, "concurrent stream body sizes");
    }

    testMixedStreams() {
        # Test that file-backed streams and memory-backed streams work
        # correctly when mixed on the same HTTP/2 connection
        RestClient rc = getClient(30000);

        int file_size = 32768;
        int mem_size = 16384;

        Counter cnt(2);
        list<hash<auto>> results();
        Mutex mtx();

        background sub() {
            on_exit cnt.dec();
            try {
                hash<auto> resp = rc.get("/file-stream/" + file_size);
                {
                    mtx.lock();
                    on_exit mtx.unlock();
                    results += resp + {"type": "file"};
                }
            } catch (hash<ExceptionInfo> ex) {
                {
                    mtx.lock();
                    on_exit mtx.unlock();
                    results += {"status_code": -1, "type": "file", "error": ex.err + ": " + ex.desc};
                }
            }
        }();

        background sub() {
            on_exit cnt.dec();
            try {
                hash<auto> resp = rc.get("/mem-stream/" + mem_size);
                {
                    mtx.lock();
                    on_exit mtx.unlock();
                    results += resp + {"type": "mem"};
                }
            } catch (hash<ExceptionInfo> ex) {
                {
                    mtx.lock();
                    on_exit mtx.unlock();
                    results += {"status_code": -1, "type": "mem", "error": ex.err + ": " + ex.desc};
                }
            }
        }();

        int rc_val = cnt.waitForZero(30s);
        assertEq(0, rc_val, "mixed streams completed");
        assertEq(2, results.size(), "got 2 mixed results");

        # Both should succeed
        for (int i = 0; i < results.size(); ++i) {
            assertEq(200, results[i].status_code,
                sprintf("mixed stream %s status (error: %s)",
                    results[i].type, results[i].error ?? "none"));
        }

        # Verify each response's content
        for (int i = 0; i < results.size(); ++i) {
            string body_str;
            if (results[i].body.typeCode() == NT_BINARY) {
                body_str = results[i].body.toString();
            } else {
                body_str = results[i].body;
            }
            if (results[i].type == "file") {
                assertEq(file_size, body_str.length(), "file stream size in mixed test");
                assertEq(strmul("F", file_size), body_str, "file stream content in mixed test");
            } else {
                assertEq(mem_size, body_str.length(), "mem stream size in mixed test");
                assertEq(strmul("M", mem_size), body_str, "mem stream content in mixed test");
            }
        }
    }

    testSequentialFileStreams() {
        RestClient rc = getClient(30000);

        # Send multiple sequential requests on the same HTTP/2 connection
        list<int> sizes = (1024, 32768, 65536, 4096);

        for (int i = 0; i < sizes.size(); ++i) {
            hash<auto> resp = rc.get("/file-stream/" + sizes[i]);
            verifyBody(resp, sizes[i], "F", sprintf("sequential request %d (%d bytes)", i, sizes[i]));
        }
    }

    testFileStreamWithPing() {
        # This test verifies that a large file-backed streaming response
        # does not block non-streaming (immediate) requests on the same
        # HTTP/2 connection. With io_uring, file reads are truly async
        # and the I/O thread remains free to handle other streams.
        RestClient rc = getClient(60000);

        *hash<auto> stats_before = get_io_uring_debug_stats();

        int file_size = 5 * 1024 * 1024;  # 5MB — takes multiple io_uring reads

        Counter cnt(2);
        hash<auto> file_result;
        hash<auto> ping_result;
        Mutex mtx();

        # Start a large file stream request in a background thread
        background sub() {
            on_exit cnt.dec();
            try {
                hash<auto> resp = rc.get("/file-stream/" + file_size);
                {
                    mtx.lock();
                    on_exit mtx.unlock();
                    file_result = resp;
                }
            } catch (hash<ExceptionInfo> ex) {
                {
                    mtx.lock();
                    on_exit mtx.unlock();
                    file_result = {"status_code": -1, "error": ex.err + ": " + ex.desc};
                }
            }
        }();

        # Send a non-streaming ping request concurrently on the same HTTP/2 connection.
        # If the I/O thread were blocked by file reads, this would stall until the
        # file stream completes. With io_uring (or non-blocking fallback), it should
        # complete promptly while the file stream is still in progress.
        background sub() {
            on_exit cnt.dec();
            try {
                hash<auto> resp = rc.get("/ping");
                {
                    mtx.lock();
                    on_exit mtx.unlock();
                    ping_result = resp;
                }
            } catch (hash<ExceptionInfo> ex) {
                {
                    mtx.lock();
                    on_exit mtx.unlock();
                    ping_result = {"status_code": -1, "error": ex.err + ": " + ex.desc};
                }
            }
        }();

        int rc_val = cnt.waitForZero(60s);
        assertEq(0, rc_val, "file+ping streams completed");

        # Verify ping response
        assertEq(200, ping_result.status_code,
            sprintf("ping status (error: %s)", ping_result.error ?? "none"));
        string ping_body;
        if (ping_result.body.typeCode() == NT_BINARY) {
            ping_body = ping_result.body.toString();
        } else {
            ping_body = ping_result.body;
        }
        assertEq("pong", ping_body, "ping response body");

        # Verify file stream response
        assertEq(200, file_result.status_code,
            sprintf("file stream status (error: %s)", file_result.error ?? "none"));
        int body_size;
        if (file_result.body.typeCode() == NT_BINARY) {
            body_size = file_result.body.size();
        } else {
            body_size = file_result.body.length();
        }
        assertEq(file_size, body_size, "file stream body size");

        # Verify file content integrity — check first and last 1KB
        string body_str;
        if (file_result.body.typeCode() == NT_BINARY) {
            body_str = file_result.body.toString();
        } else {
            body_str = file_result.body;
        }
        assertEq(strmul("F", 1024), substr(body_str, 0, 1024), "file+ping: first 1KB");
        assertEq(strmul("F", 1024), substr(body_str, file_size - 1024), "file+ping: last 1KB");

        # Verify io_uring was exercised for the file stream
        *hash<auto> stats_after = get_io_uring_debug_stats();
        if (stats_before && stats_after) {
            int submit_delta = stats_after.submits - stats_before.submits;
            assertTrue(submit_delta > 0,
                sprintf("io_uring was exercised during file+ping test (%d submits)", submit_delta));
        }
    }
}
