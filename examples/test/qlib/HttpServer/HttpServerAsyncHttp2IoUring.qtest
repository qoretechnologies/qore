    FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
    DEALINGS IN THE SOFTWARE.

    Tests for io_uring-backed async file I/O over HTTP/2 streaming responses.

    On Linux with io_uring support, FileInputStream-backed responses use truly
    async kernel reads via io_uring instead of blocking reads in the event loop.
    On other platforms or when io_uring is unavailable, the existing blocking
    read path is used transparently.

    Test cases:
    1. Basic file streaming — serve temp file, verify complete delivery
    2. Concurrent file streams — multiple file-backed streams on same HTTP/2 connection
    3. Large file — 10MB+ file, verify offset tracking and multiple io_uring reads
    4. Mixed streams — simultaneous file-backed and memory-backed streams
    5. Small file — ensures single-read files work correctly
    6. Sequential file streams — same connection, sequential requests
*/

%modern

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Mime.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/HttpServerUtil.qm
%requires ../../../../qlib/HttpServerAsyncIo
%requires ../../../../qlib/HttpServer.qm
%requires ../../../../qlib/RestClient.qm

%exec-class HttpServerAsyncHttp2IoUringTest

#! Handler that returns a FileInputStream for a temp file of the requested size
class FileStreamHandler inherits AbstractHttpRequestHandler {
    private {
        string dir;
    }

    constructor(string dir) {
        self.dir = dir;
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        int size = 8192;
        *list<*string> m = (hdr.path =~ x/file-stream\/(\d+)/);
        if (m) {
            size = int(m[0]);
        }
        # Write a temp file and return a FileInputStream for it
        string path = dir + "/iouring-test-" + gettid() + "-" + clock_getmicros() + ".dat";
        {
            FileOutputStream fos(path);
            # Write in chunks to avoid huge memory alloc
            string chunk = strmul("F", min(size, 4096));
            int written = 0;
            while (written < size) {
                int to_write = min(chunk.length(), size - written);
                if (to_write < chunk.length()) {
                    fos.write(binary(substr(chunk, 0, to_write)));
                } else {
                    fos.write(binary(chunk));
                }
                written += to_write;
            }
            fos.close();
        }
        return makeResponse(200, new FileInputStream(path), {
            "Content-Type": "application/octet-stream",
        });
    }
}

#! Handler that returns a BinaryInputStream (memory-backed, no file I/O)
class MemoryStreamHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        int size = 8192;
        *list<*string> m = (hdr.path =~ x/mem-stream\/(\d+)/);
        if (m) {
            size = int(m[0]);
        }
        return makeResponse(200, new BinaryInputStream(binary(strmul("M", size))), {
            "Content-Type": "application/octet-stream",
        });
    }
}

#! Simple non-streaming handler — returns an immediate response with no InputStream
class PingHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, "pong", {"Content-Type": "text/plain"});
    }
}

