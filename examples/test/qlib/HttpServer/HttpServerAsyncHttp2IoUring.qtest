    constructor() : Test("HttpServerAsyncHttp2IoUringTest", "1.0") {
        addTestCase("basic file streaming", \testBasicFileStream());
        addTestCase("small file streaming", \testSmallFileStream());
        addTestCase("large file streaming (10MB)", \testLargeFileStream());
        addTestCase("concurrent file streams", \testConcurrentFileStreams());
        addTestCase("mixed file and memory streams", \testMixedStreams());
        addTestCase("sequential file streams on same connection", \testSequentialFileStreams());
        addTestCase("file streaming does not block non-streaming requests", \testFileStreamWithPing());

        # Stress tests
        addTestCase("stress: rapid connect/disconnect with in-flight streams",
            \testStressRapidConnectDisconnect());
        addTestCase("stress: many concurrent file streams (SQ saturation)",
            \testStressConcurrentFileStreams());
        addTestCase("stress: many concurrent connections with file streams",
            \testStressConcurrentConnections());
        addTestCase("stress: sustained file streaming throughput",
            \testStressSustainedThroughput());
        addTestCase("stress: rapid sequential file streams (connection reuse)",
            \testStressRapidSequentialStreams());

        set_return_value(main());
    }

    globalSetUp() {
        Logger logger("iouring-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }

        hash<HttpServerOptionInfo> opts = <HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        };
        mServer = new HttpServer(opts);

        mTmpDir = tmp_location() + "/iouring-test-" + getpid();
        mkdir(mTmpDir);

        mServer.setHandler("file-stream", "/file-stream", NOTHING, new FileStreamHandler(mTmpDir));
        mServer.setHandler("mem-stream", "/mem-stream", NOTHING, new MemoryStreamHandler());
        mServer.setHandler("ping", "/ping", NOTHING, new PingHandler());

        mSslPort = mServer.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        }).port;
        mSslUrl = "https://localhost:" + mSslPort;

        mServer.waitForAsyncIo();

        if (m_options.verbose > 1) {
            printf("HTTPS io_uring test server on port %d\n", mSslPort);
        }
    }

    globalTearDown() {
        delete mServer;
        # Clean up temp files
        *list<string> files = glob(mTmpDir + "/*");
        if (files) {
            for (int i = 0; i < files.size(); ++i) {
                unlink(files[i]);
            }
        }
        rmdir(mTmpDir);
    }

    private RestClient getClient(timeout timeout_ms = 30000) {
        return new RestClient({
            "url": mSslUrl,
            "ssl_verify_cert": False,
            "http_version": "2",
            "timeout": timeout_ms,
            "connect_timeout": timeout_ms,
        });
    }

    #! Helper to verify response body
    private verifyBody(hash<auto> resp, int expected_size, string expected_char, string desc) {
        assertEq(200, resp.status_code, desc + " status");
        string body_str;
        if (resp.body.typeCode() == NT_BINARY) {
            body_str = resp.body.toString();
        } else {
            body_str = resp.body;
        }
        assertEq(expected_size, body_str.length(), desc + " size");
        assertEq(strmul(expected_char, expected_size), body_str, desc + " content");
    }

    testBasicFileStream() {
        RestClient rc = getClient();

        # Capture io_uring stats before the request (debug builds only)
        *hash<auto> stats_before = get_io_uring_debug_stats();

        # 64KB — exercises at least one full io_uring read buffer
        int size = 65536;
        hash<auto> resp = rc.get("/file-stream/" + size);
        verifyBody(resp, size, "F", "basic 64KB file stream");

        # Verify io_uring was actually exercised (debug builds on Linux with io_uring)
        *hash<auto> stats_after = get_io_uring_debug_stats();
        if (stats_before && stats_after) {
            assertTrue(stats_after.submits > stats_before.submits,
                sprintf("io_uring submits increased (%d -> %d)",
                    stats_before.submits, stats_after.submits));
            assertTrue(stats_after.completions > stats_before.completions,
                sprintf("io_uring completions increased (%d -> %d)",
                    stats_before.completions, stats_after.completions));
        }
    }

    testSmallFileStream() {
        RestClient rc = getClient();

        # 100 bytes — smaller than the io_uring buffer, single read
        int size = 100;
        hash<auto> resp = rc.get("/file-stream/" + size);
        verifyBody(resp, size, "F", "small file stream");
    }

    testLargeFileStream() {
        RestClient rc = getClient(60000);

        *hash<auto> stats_before = get_io_uring_debug_stats();

        # 10MB — requires many io_uring reads to complete
        int size = 10 * 1024 * 1024;
        hash<auto> resp = rc.get("/file-stream/" + size);
        assertEq(200, resp.status_code, "large file stream status");
        int body_size;
        if (resp.body.typeCode() == NT_BINARY) {
            body_size = resp.body.size();
        } else {
            body_size = resp.body.length();
        }
        assertEq(size, body_size, "large file stream body size");

        # Verify content integrity — check first and last 1KB
        string body_str;
        if (resp.body.typeCode() == NT_BINARY) {
            body_str = resp.body.toString();
        } else {
            body_str = resp.body;
        }
        assertEq(strmul("F", 1024), substr(body_str, 0, 1024), "large file first 1KB");
        assertEq(strmul("F", 1024), substr(body_str, size - 1024), "large file last 1KB");

        # 10MB with 64KB reads = at least 160 io_uring submits/completions
        *hash<auto> stats_after = get_io_uring_debug_stats();
        if (stats_before && stats_after) {
            int submit_delta = stats_after.submits - stats_before.submits;
            assertTrue(submit_delta >= 100,
                sprintf("10MB file required many io_uring reads (%d submits)", submit_delta));
        }
    }

    testConcurrentFileStreams() {
        # Use multiple concurrent requests on the same HTTP/2 connection
        # to exercise io_uring handling of multiple in-flight file reads
        RestClient rc = getClient(30000);

        int size1 = 32768;
        int size2 = 65536;
        int size3 = 16384;

        Counter cnt(3);
        list<hash<auto>> results();
        Mutex mtx();

        background sub() {
            on_exit cnt.dec();
            try {
                hash<auto> resp = rc.get("/file-stream/" + size1);
                {
                    mtx.lock();
                    on_exit mtx.unlock();
                    results += resp;
                }
            } catch (hash<ExceptionInfo> ex) {
                {
                    mtx.lock();
                    on_exit mtx.unlock();
                    results += {"status_code": -1, "error": ex.err + ": " + ex.desc};
                }
            }
        }();

        background sub() {
            on_exit cnt.dec();
            try {
                hash<auto> resp = rc.get("/file-stream/" + size2);
                {
                    mtx.lock();
                    on_exit mtx.unlock();
                    results += resp;
                }
            } catch (hash<ExceptionInfo> ex) {
                {
                    mtx.lock();
                    on_exit mtx.unlock();
                    results += {"status_code": -1, "error": ex.err + ": " + ex.desc};
                }
            }
        }();

        background sub() {
            on_exit cnt.dec();
            try {
                hash<auto> resp = rc.get("/file-stream/" + size3);
                {
                    mtx.lock();
                    on_exit mtx.unlock();
                    results += resp;
                }
            } catch (hash<ExceptionInfo> ex) {
                {
                    mtx.lock();
                    on_exit mtx.unlock();
                    results += {"status_code": -1, "error": ex.err + ": " + ex.desc};
                }
            }
        }();

        int rc_val = cnt.waitForZero(30s);
        assertEq(0, rc_val, "concurrent streams completed");
        assertEq(3, results.size(), "got 3 results");

        # All requests should succeed
        for (int i = 0; i < results.size(); ++i) {
            assertEq(200, results[i].status_code,
                sprintf("concurrent stream %d status (error: %s)", i, results[i].error ?? "none"));
        }

        # Verify sizes — sort results by body size to match
        list<int> body_sizes();
        for (int i = 0; i < results.size(); ++i) {
            if (results[i].body.typeCode() == NT_BINARY) {
                body_sizes += results[i].body.size();
            } else {
                body_sizes += results[i].body.length();
            }
        }
        body_sizes = sort(body_sizes);
        assertEq((size3, size1, size2), body_sizes, "concurrent stream body sizes");
    }

    testMixedStreams() {
        # Test that file-backed streams and memory-backed streams work
        # correctly when mixed on the same HTTP/2 connection
        RestClient rc = getClient(30000);

        int file_size = 32768;
        int mem_size = 16384;

        Counter cnt(2);
        list<hash<auto>> results();
        Mutex mtx();

        background sub() {
            on_exit cnt.dec();
            try {
                hash<auto> resp = rc.get("/file-stream/" + file_size);
                {
                    mtx.lock();
                    on_exit mtx.unlock();
                    results += resp + {"type": "file"};
                }
            } catch (hash<ExceptionInfo> ex) {
                {
                    mtx.lock();
                    on_exit mtx.unlock();
                    results += {"status_code": -1, "type": "file", "error": ex.err + ": " + ex.desc};
                }
            }
        }();

        background sub() {
            on_exit cnt.dec();
            try {
                hash<auto> resp = rc.get("/mem-stream/" + mem_size);
                {
                    mtx.lock();
                    on_exit mtx.unlock();
                    results += resp + {"type": "mem"};
                }
            } catch (hash<ExceptionInfo> ex) {
                {
                    mtx.lock();
                    on_exit mtx.unlock();
                    results += {"status_code": -1, "type": "mem", "error": ex.err + ": " + ex.desc};
                }
            }
        }();

        int rc_val = cnt.waitForZero(30s);
        assertEq(0, rc_val, "mixed streams completed");
        assertEq(2, results.size(), "got 2 mixed results");

        # Both should succeed
        for (int i = 0; i < results.size(); ++i) {
            assertEq(200, results[i].status_code,
                sprintf("mixed stream %s status (error: %s)",
                    results[i].type, results[i].error ?? "none"));
        }

        # Verify each response's content
        for (int i = 0; i < results.size(); ++i) {
            string body_str;
            if (results[i].body.typeCode() == NT_BINARY) {
                body_str = results[i].body.toString();
            } else {
                body_str = results[i].body;
            }
            if (results[i].type == "file") {
                assertEq(file_size, body_str.length(), "file stream size in mixed test");
                assertEq(strmul("F", file_size), body_str, "file stream content in mixed test");
            } else {
                assertEq(mem_size, body_str.length(), "mem stream size in mixed test");
                assertEq(strmul("M", mem_size), body_str, "mem stream content in mixed test");
            }
        }
    }

    testSequentialFileStreams() {
        RestClient rc = getClient(30000);

        # Send multiple sequential requests on the same HTTP/2 connection
        list<int> sizes = (1024, 32768, 65536, 4096);

        for (int i = 0; i < sizes.size(); ++i) {
            hash<auto> resp = rc.get("/file-stream/" + sizes[i]);
            verifyBody(resp, sizes[i], "F", sprintf("sequential request %d (%d bytes)", i, sizes[i]));
        }
    }

    # ---- Stress Tests ----

    #! Stress test: rapid connect/disconnect while file streams may be in-flight.
    #! Validates that weak_ptr expiration in processCompletions() works correctly —
    #! no crashes or use-after-free when Http2Session is destroyed during io_uring reads.
    testStressRapidConnectDisconnect() {
        # Probe to detect valgrind — a single request under valgrind is very slow
        date probe_start = now_us();
        {
            RestClient rc = getClient(30000);
            hash<auto> resp = rc.get("/file-stream/1024");
            assertEq(200, resp.status_code, "probe request succeeded");
        }
        date probe_elapsed = now_us() - probe_start;
        int cycles = probe_elapsed > 2s ? 5 : 50;

        int successes = 0;
        int errors = 0;
        # Use a large file so io_uring reads are likely still in-flight when we disconnect
        int file_size = 512 * 1024;  # 512KB

        for (int i = 0; i < cycles; ++i) {
            try {
                RestClient rc = getClient(10000);
                # Start the request — this initiates io_uring reads on the server
                hash<auto> resp = rc.get("/file-stream/" + file_size);
                # If we got a complete response, that's fine — verify it
                if (resp.status_code == 200) {
                    int body_size;
                    if (resp.body.typeCode() == NT_BINARY) {
                        body_size = resp.body.size();
                    } else {
                        body_size = resp.body.length();
                    }
                    assertEq(file_size, body_size,
                        sprintf("cycle %d body size", i));
                    successes++;
                }
            } catch (hash<ExceptionInfo> ex) {
                # Connection errors are expected — the point is no crashes
                errors++;
                if (m_options.verbose > 1) {
                    printf("cycle %d error (expected): %s: %s\n", i, ex.err, ex.desc);
                }
            }
            # RestClient goes out of scope here → connection dropped →
            # server-side Http2Session destroyed while io_uring reads may be pending
        }

        assertTrue(successes > 0,
            sprintf("at least some requests completed (%d/%d)", successes, cycles));

        if (m_options.verbose) {
            printf("rapid connect/disconnect: %d successes, %d errors in %d cycles\n",
                successes, errors, cycles);
        }

        # Verify no pending io_uring operations leaked
        *hash<auto> stats = get_io_uring_debug_stats();
        if (stats) {
            assertTrue(stats.completions > 0,
                sprintf("io_uring completions occurred (%d)", stats.completions));
        }
    }

    #! Stress test: many concurrent file streams on a single HTTP/2 connection.
    #! Exercises io_uring submission queue handling (SQ full → retry on next iteration)
    #! and concurrent PendingRead tracking.
    testStressConcurrentFileStreams() {
        RestClient rc = getClient(60000);

        # Probe for valgrind
        date probe_start = now_us();
        hash<auto> probe = rc.get("/file-stream/1024");
        assertEq(200, probe.status_code, "probe request succeeded");
        date probe_elapsed = now_us() - probe_start;
        int num_streams = probe_elapsed > 1s ? 5 : 15;

        Counter cnt(num_streams);
        list<hash<auto>> results();
        Mutex mtx();

        # Launch many concurrent file stream requests on the same connection
        for (int i = 0; i < num_streams; ++i) {
            int idx = i;
            # Vary sizes to exercise different io_uring read patterns
            int size = 32768 + (i * 16384);  # 32KB to 32KB + N*16KB
            background sub() {
                on_exit cnt.dec();
                try {
                    hash<auto> resp = rc.get("/file-stream/" + size);
                    int body_size;
                    if (resp.body.typeCode() == NT_BINARY) {
                        body_size = resp.body.size();
                    } else {
                        body_size = resp.body.length();
                    }
                    {
                        mtx.lock();
                        on_exit mtx.unlock();
                        results += {
                            "idx": idx,
                            "status_code": resp.status_code,
                            "expected_size": size,
                            "actual_size": body_size,
                        };
                    }
                } catch (hash<ExceptionInfo> ex) {
                    {
                        mtx.lock();
                        on_exit mtx.unlock();
                        results += {
                            "idx": idx,
                            "status_code": -1,
                            "error": ex.err + ": " + ex.desc,
                        };
                    }
                }
            }();
        }

        int rc_val = cnt.waitForZero(60s);
        assertEq(0, rc_val, "all concurrent streams completed");
        assertEq(num_streams, results.size(), "got results for all streams");

        int successes = 0;
        foreach hash<auto> r in (results) {
            if (r.status_code == 200) {
                assertEq(r.expected_size, r.actual_size,
                    sprintf("stream %d body size", r.idx));
                successes++;
            } else if (m_options.verbose > 1) {
                printf("stream %d failed: %s\n", r.idx, r.error ?? "status " + r.status_code);
            }
        }
        assertEq(num_streams, successes,
            sprintf("all %d concurrent file streams succeeded", num_streams));

        if (m_options.verbose) {
            printf("concurrent file streams: %d/%d succeeded\n", successes, num_streams);
        }
    }

    #! Stress test: multiple independent connections each requesting file streams.
    #! Stresses the I/O thread handling multiple sessions' io_uring operations
    #! concurrently and validates session-level isolation in processCompletions().
    testStressConcurrentConnections() {
        # Probe for valgrind
        date probe_start = now_us();
        {
            RestClient rc = getClient(30000);
            hash<auto> probe = rc.get("/file-stream/1024");
            assertEq(200, probe.status_code, "probe request succeeded");
        }
        date probe_elapsed = now_us() - probe_start;
        int num_connections = probe_elapsed > 1s ? 3 : 8;
        int requests_per_conn = probe_elapsed > 1s ? 2 : 5;
        int total = num_connections * requests_per_conn;

        Counter cnt(total);
        list<hash<auto>> results();
        Mutex mtx();
        int file_size = 65536;  # 64KB per request

        for (int c = 0; c < num_connections; ++c) {
            int conn_idx = c;
            # Each iteration gets its own RestClient → separate HTTP/2 connection
            background sub() {
                RestClient rc = getClient(60000);
                for (int r = 0; r < requests_per_conn; ++r) {
                    on_exit cnt.dec();
                    int req_idx = r;
                    try {
                        hash<auto> resp = rc.get("/file-stream/" + file_size);
                        int body_size;
                        if (resp.body.typeCode() == NT_BINARY) {
                            body_size = resp.body.size();
                        } else {
                            body_size = resp.body.length();
                        }
                        {
                            mtx.lock();
                            on_exit mtx.unlock();
                            results += {
                                "conn": conn_idx,
                                "req": req_idx,
                                "status_code": resp.status_code,
                                "body_size": body_size,
                            };
                        }
                    } catch (hash<ExceptionInfo> ex) {
                        {
                            mtx.lock();
                            on_exit mtx.unlock();
                            results += {
                                "conn": conn_idx,
                                "req": req_idx,
                                "status_code": -1,
                                "error": ex.err + ": " + ex.desc,
                            };
                        }
                    }
                }
            }();
        }

        int rc_val = cnt.waitForZero(60s);
        assertEq(0, rc_val, "all concurrent connection requests completed");
        assertEq(total, results.size(), "got results for all requests");

        int successes = 0;
        foreach hash<auto> r in (results) {
            if (r.status_code == 200) {
                assertEq(file_size, r.body_size,
                    sprintf("conn %d req %d body size", r.conn, r.req));
                successes++;
            } else if (m_options.verbose > 1) {
                printf("conn %d req %d failed: %s\n", r.conn, r.req,
                    r.error ?? "status " + r.status_code);
            }
        }
        assertEq(total, successes,
            sprintf("all %d concurrent connection requests succeeded", total));

        if (m_options.verbose) {
            printf("concurrent connections: %d/%d succeeded (%d connections x %d requests)\n",
                successes, total, num_connections, requests_per_conn);
        }
    }

    #! Stress test: sustained file streaming throughput over a time window.
    #! Measures throughput and verifies no resource leaks or degradation under
    #! sustained io_uring load.
    testStressSustainedThroughput() {
        RestClient rc = getClient(30000);

        # Probe to calibrate — detect valgrind
        date probe_start = now_us();
        hash<auto> probe = rc.get("/file-stream/8192");
        assertEq(200, probe.status_code, "probe request succeeded");
        date probe_elapsed = now_us() - probe_start;

        # 5s under normal conditions, 2s under valgrind
        timeout duration = probe_elapsed > 1s ? 2s : 5s;

        *hash<auto> stats_before = get_io_uring_debug_stats();

        int file_size = 65536;  # 64KB per request
        int count = 0;
        int total_bytes = 0;
        int errors = 0;
        date start_time = now_us();
        date end_time = start_time + duration;

        while (now_us() < end_time) {
            try {
                hash<auto> resp = rc.get("/file-stream/" + file_size);
                if (resp.status_code == 200) {
                    count++;
                    int body_size;
                    if (resp.body.typeCode() == NT_BINARY) {
                        body_size = resp.body.size();
                    } else {
                        body_size = resp.body.length();
                    }
                    total_bytes += body_size;
                    assertEq(file_size, body_size,
                        sprintf("sustained request %d body size", count));
                } else {
                    errors++;
                }
            } catch (hash<ExceptionInfo> ex) {
                errors++;
                if (m_options.verbose > 1) {
                    printf("sustained throughput error: %s: %s\n", ex.err, ex.desc);
                }
            }
        }

        # Under valgrind, we may get very few requests
        if (count < 3) {
            testSkip(sprintf("likely under valgrind: only %d requests completed", count));
            return;
        }

        assertEq(0, errors, "no errors during sustained throughput");
        assertTrue(count > 0, sprintf("throughput > 0: %d requests", count));

        *hash<auto> stats_after = get_io_uring_debug_stats();
        if (stats_before && stats_after) {
            int submit_delta = stats_after.submits - stats_before.submits;
            assertTrue(submit_delta > 0,
                sprintf("io_uring exercised during sustained test (%d submits)", submit_delta));
        }

        if (m_options.verbose) {
            date actual_elapsed = now_us() - start_time;
            float elapsed_sec = float(get_duration_microseconds(actual_elapsed)) / 1000000.0;
            float mb_sec = (float(total_bytes) / (1024.0 * 1024.0)) / elapsed_sec;
            printf("sustained throughput: %d requests in %.1fs (%.1f req/s, %.2f MB/s)\n",
                count, elapsed_sec, float(count) / elapsed_sec, mb_sec);
        }
    }

    #! Stress test: many rapid sequential file stream requests on the same connection.
    #! Verifies that io_uring state is properly cleaned up between requests and
    #! no stale PendingRead entries accumulate.
    testStressRapidSequentialStreams() {
        RestClient rc = getClient(30000);

        # Probe for valgrind
        date probe_start = now_us();
        hash<auto> probe = rc.get("/file-stream/1024");
        assertEq(200, probe.status_code, "probe request succeeded");
        date probe_elapsed = now_us() - probe_start;
        int count = probe_elapsed > 1s ? 10 : 50;

        *hash<auto> stats_before = get_io_uring_debug_stats();

        list<int> sizes = (4096, 16384, 32768, 65536, 8192);
        int successes = 0;

        for (int i = 0; i < count; ++i) {
            int size = sizes[i % sizes.size()];
            hash<auto> resp = rc.get("/file-stream/" + size);
            verifyBody(resp, size, "F",
                sprintf("rapid sequential %d (%d bytes)", i, size));
            successes++;
        }

        assertEq(count, successes,
            sprintf("all %d rapid sequential requests succeeded", count));

        # Verify io_uring was exercised and no pending operations leaked
        *hash<auto> stats_after = get_io_uring_debug_stats();
        if (stats_before && stats_after) {
            int submit_delta = stats_after.submits - stats_before.submits;
            assertTrue(submit_delta > 0,
                sprintf("io_uring exercised during sequential test (%d submits)", submit_delta));
            int completion_delta = stats_after.completions - stats_before.completions;
            # All submits should have completed
            assertEq(submit_delta, completion_delta,
                sprintf("all io_uring submits completed (%d submits, %d completions)",
                    submit_delta, completion_delta));
        }

        if (m_options.verbose) {
            printf("rapid sequential streams: %d/%d succeeded\n", successes, count);
        }
    }

    testFileStreamWithPing() {
        # This test verifies that a large file-backed streaming response
        # does not block non-streaming (immediate) requests on the same
        # HTTP/2 connection. With io_uring, file reads are truly async
        # and the I/O thread remains free to handle other streams.
        RestClient rc = getClient(60000);

        *hash<auto> stats_before = get_io_uring_debug_stats();

        int file_size = 5 * 1024 * 1024;  # 5MB — takes multiple io_uring reads

        Counter cnt(2);
        hash<auto> file_result;
        hash<auto> ping_result;
        Mutex mtx();

        # Start a large file stream request in a background thread
        background sub() {
            on_exit cnt.dec();
            try {
                hash<auto> resp = rc.get("/file-stream/" + file_size);
                {
                    mtx.lock();
                    on_exit mtx.unlock();
                    file_result = resp;
                }
            } catch (hash<ExceptionInfo> ex) {
                {
                    mtx.lock();
                    on_exit mtx.unlock();
                    file_result = {"status_code": -1, "error": ex.err + ": " + ex.desc};
                }
            }
        }();

        # Send a non-streaming ping request concurrently on the same HTTP/2 connection.
        # If the I/O thread were blocked by file reads, this would stall until the
        # file stream completes. With io_uring (or non-blocking fallback), it should
        # complete promptly while the file stream is still in progress.
        background sub() {
            on_exit cnt.dec();
            try {
                hash<auto> resp = rc.get("/ping");
                {
                    mtx.lock();
                    on_exit mtx.unlock();
                    ping_result = resp;
                }
            } catch (hash<ExceptionInfo> ex) {
                {
                    mtx.lock();
                    on_exit mtx.unlock();
                    ping_result = {"status_code": -1, "error": ex.err + ": " + ex.desc};
                }
            }
        }();

        int rc_val = cnt.waitForZero(60s);
        assertEq(0, rc_val, "file+ping streams completed");

        # Verify ping response
        assertEq(200, ping_result.status_code,
            sprintf("ping status (error: %s)", ping_result.error ?? "none"));
        string ping_body;
        if (ping_result.body.typeCode() == NT_BINARY) {
            ping_body = ping_result.body.toString();
        } else {
            ping_body = ping_result.body;
        }
        assertEq("pong", ping_body, "ping response body");

        # Verify file stream response
        assertEq(200, file_result.status_code,
            sprintf("file stream status (error: %s)", file_result.error ?? "none"));
        int body_size;
        if (file_result.body.typeCode() == NT_BINARY) {
            body_size = file_result.body.size();
        } else {
            body_size = file_result.body.length();
        }
        assertEq(file_size, body_size, "file stream body size");

        # Verify file content integrity — check first and last 1KB
        string body_str;
        if (file_result.body.typeCode() == NT_BINARY) {
            body_str = file_result.body.toString();
        } else {
            body_str = file_result.body;
        }
        assertEq(strmul("F", 1024), substr(body_str, 0, 1024), "file+ping: first 1KB");
        assertEq(strmul("F", 1024), substr(body_str, file_size - 1024), "file+ping: last 1KB");

        # Verify io_uring was exercised for the file stream
        *hash<auto> stats_after = get_io_uring_debug_stats();
        if (stats_before && stats_after) {
            int submit_delta = stats_after.submits - stats_before.submits;
            assertTrue(submit_delta > 0,
                sprintf("io_uring was exercised during file+ping test (%d submits)", submit_delta));
        }
    }
}
