    QUIC/HTTP/3 mutual TLS (mTLS) tests - exercises server-side client
    certificate verification for QUIC listeners.

    Tests cover:
    - Server with get_remote_certs: True + client with cert → cert extracted
    - Server with get_remote_certs: True + client without cert → no cert, request still works
    - Server with SSL_VERIFY_FAIL_IF_NO_PEER_CERT + client without cert → handshake failure
    - Client certificate subject verification
*/

%modern

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Mime.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/HttpServerUtil.qm
%requires ../../../../qlib/AsyncSocketIo
%requires ../../../../qlib/HttpServerAsyncIo
%requires ../../../../qlib/HttpServer.qm
%requires ../../../../qlib/HttpClientIo

%try-module json >= 1.5
%define NoJson
%endtry

%exec-class HttpServerQuicMtlsTest

#! Handler that reports client certificate info in the response
class MtlsHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        hash<auto> result;
        result.has_client_cert = exists cx."client-cert";
        if (cx."client-cert") {
            # Extract certificate subject info
            hash<auto> cert_info = cx."client-cert".getInfo();
            result.subject = cert_info.subject;
            result.issuer = cert_info.issuer;
        }
        return makeResponse(200, make_json(result), {"Content-Type": MimeTypeJson});
    }
}

