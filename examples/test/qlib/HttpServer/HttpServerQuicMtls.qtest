    constructor() : Test("HttpServerQuicMtlsTest", "1.0") {
        # Set up SIGUSR1 handler to dump thread stacks for debugging hangs
        @debug {
            set_signal_handler(SIGUSR1, sub (int sig) {
                printf("=== SIGUSR1 Thread Stacks ===\n%Y\n=== End Thread Stacks ===\n",
                    get_all_thread_call_stacks());
            });
        }

%ifdef NoJson
        printf("json module not available, skipping mTLS tests\n");
%else
        addTestCase("mTLS with client cert", \testMtlsWithClientCert());
        addTestCase("get_remote_certs without client cert", \testGetRemoteCertsNoClientCert());
        addTestCase("SSL_VERIFY_FAIL_IF_NO_PEER_CERT rejects", \testVerifyFailIfNoPeerCert());
        addTestCase("client cert subject info", \testClientCertSubjectInfo());
%endif

        set_return_value(main());
    }

    globalSetUp() {
        mLogger = new Logger("quic-mtls-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            mLogger.addAppender(new StdoutAppender());
        }
    }

    globalTearDown() {
        delete mServer;
    }

    private hash<auto> createMtlsServer(hash<auto> extra_opts = {}) {
        HttpServer server(<HttpServerOptionInfo>{
            "logger": mLogger,
            "debug": True,
            "async_mode": True,
        });

        server.setHandler("mtls", "/mtls", NOTHING, new MtlsHandler());
        server.waitForAsyncIo();

        hash<HttpListenerOptionInfo> listener_opts = <HttpListenerOptionInfo>{
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        };
        # Apply extra options
        if (extra_opts.get_remote_certs) {
            listener_opts.get_remote_certs = extra_opts.get_remote_certs;
        }
        if (extra_opts.ssl_verify_flags) {
            listener_opts.ssl_verify_flags = extra_opts.ssl_verify_flags;
        }

        hash<auto> h3info = server.addQuicListener(listener_opts);
        return {"server": server, "port": h3info.port};
    }

    #! Test mTLS with client certificate — server should see the client cert
    testMtlsWithClientCert() {
        hash<auto> setup = createMtlsServer({
            "get_remote_certs": True,
        });
        HttpServer server = setup.server;
        int quic_port = setup.port;
        on_exit delete server;

        # Create client with certificate for mTLS
        HttpClientIo::HttpClientConnectionManager mgr(<HttpClientIo::HttpClientConnectionManagerOptions>{
            "protocol": "h3",
            "accept_all_certs": True,
            "client_cert": new SSLCertificate(CertPem),
            "client_pk": new SSLPrivateKey(KeyPem),
            "logger": mLogger,
        });
        on_exit mgr.closeAll();

        hash<auto> resp = mgr.request(sprintf("https://127.0.0.1:%d", quic_port), "GET", "/mtls");
        assertEq(200, resp.status_code, "mTLS request should succeed");

        hash<auto> body = parse_json(binary_to_string(resp.body));
        assertTrue(body.has_client_cert, "server should have captured client certificate");
    }

    #! Test get_remote_certs without client cert — request should still succeed
    testGetRemoteCertsNoClientCert() {
        hash<auto> setup = createMtlsServer({
            "get_remote_certs": True,
        });
        HttpServer server = setup.server;
        int quic_port = setup.port;
        on_exit delete server;

        # Create client WITHOUT certificate — SSL_VERIFY_PEER alone should not
        # require a client cert (only requests it)
        HttpClientIo::HttpClientConnectionManager mgr(<HttpClientIo::HttpClientConnectionManagerOptions>{
            "protocol": "h3",
            "accept_all_certs": True,
            "logger": mLogger,
        });
        on_exit mgr.closeAll();

        hash<auto> resp = mgr.request(sprintf("https://127.0.0.1:%d", quic_port), "GET", "/mtls");
        assertEq(200, resp.status_code, "request without client cert should succeed with SSL_VERIFY_PEER");

        hash<auto> body = parse_json(binary_to_string(resp.body));
        assertFalse(body.has_client_cert, "server should NOT have a client certificate");
    }

    #! Test SSL_VERIFY_FAIL_IF_NO_PEER_CERT — client without cert should fail
    testVerifyFailIfNoPeerCert() {
        hash<auto> setup = createMtlsServer({
            "ssl_verify_flags": SSL_VERIFY_PEER | SSL_VERIFY_FAIL_IF_NO_PEER_CERT,
            "get_remote_certs": True,
        });
        HttpServer server = setup.server;
        int quic_port = setup.port;
        on_exit delete server;

        # Create client WITHOUT certificate — handshake should fail because
        # SSL_VERIFY_FAIL_IF_NO_PEER_CERT requires a client cert
        HttpClientIo::HttpClientConnectionManager mgr(<HttpClientIo::HttpClientConnectionManagerOptions>{
            "protocol": "h3",
            "accept_all_certs": True,
            "logger": mLogger,
        });
        on_exit mgr.closeAll();

        bool caught_exception = False;
        try {
            mgr.request(sprintf("https://127.0.0.1:%d", quic_port), "GET", "/mtls");
        } catch (hash<ExceptionInfo> ex) {
            caught_exception = True;
            # The connection should fail due to TLS handshake error
            @debug(printf("Expected exception: %s: %s\n", ex.err, ex.desc));
        }
        assertTrue(caught_exception, "request without client cert should fail when FAIL_IF_NO_PEER_CERT is set");
    }

    #! Test client certificate subject information
    testClientCertSubjectInfo() {
        hash<auto> setup = createMtlsServer({
            "get_remote_certs": True,
        });
        HttpServer server = setup.server;
        int quic_port = setup.port;
        on_exit delete server;

        # Create client with certificate
        HttpClientIo::HttpClientConnectionManager mgr(<HttpClientIo::HttpClientConnectionManagerOptions>{
            "protocol": "h3",
            "accept_all_certs": True,
            "client_cert": new SSLCertificate(CertPem),
            "client_pk": new SSLPrivateKey(KeyPem),
            "logger": mLogger,
        });
        on_exit mgr.closeAll();

        hash<auto> resp = mgr.request(sprintf("https://127.0.0.1:%d", quic_port), "GET", "/mtls");
        assertEq(200, resp.status_code, "mTLS request should succeed");

        hash<auto> body = parse_json(binary_to_string(resp.body));
        assertTrue(body.has_client_cert, "server should have captured client certificate");
        # Verify the certificate subject contains "localhost" CN (from our self-signed cert)
        # getInfo().subject returns a hash like {"CN": "localhost"}
        assertEq("localhost", body.subject.commonName, "client cert CN should be 'localhost'");
    }
}
