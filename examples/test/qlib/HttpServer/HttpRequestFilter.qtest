    constructor() : QUnit::Test("HttpRequestFilter", "1.0") {
        addTestCase("the filter and its options", \filterTest());
        addTestCase("the trailer fields", \trailerTest());
        addTestCase("the code that serves a stream request gets the filtered request", \factoryTest());
        addTestCase("trusted code gets the request as before", \trustedTest());
        addTestCase("a stream handler of a sandboxed Program", \tenantStreamTest());
        addTestCase("the raw request is handed to the first stream request only", \handoffTest());
        addTestCase("nested dispatches and a failing factory", \nestingTest());
        addTestCase("a stream request created otherwise uses what it is given", \fallbackTest());
        addTestCase("the REST classes get the filtered request", \restTest());
        addTestCase("HTTP/1.1: a chunked body with a credential trailer", \chunkedTest());
        addTestCase("HTTP/2: concurrent streams each get their own raw request", \http2Test());
        addTestCase("sandboxed code", \sandboxTest());
        set_return_value(main());
    }

    #! a raw request context with the server's objects and a body given through a body reader
    static hash<auto> rawContext(int id, *string body) {
        hash<auto> cx = {
            "id": id,
            "orig_path": "/stream",
            "raw_path": "/stream?token=secret",
            "url": {"path": "stream?token=secret", "username": "user", "password": "pass"},
            "socket": "the listener's socket",
            "socket-info": {"fd": 1},
            "uctx": {"a": 1},
            "auth": "Basic dGVzdDp0ZXN0",
            "sock_key": "key",
            "user": "test",
            "peer-info": {"address": "127.0.0.1", "port": 1, "familystr": "ipv4"},
            "header-info": {
                "headers-raw": {"Authorization": "Basic dGVzdDp0ZXN0", "Accept": "*/*"},
                "request-uri": "/stream?token=secret",
            },
            "trailers": {"authorization": "Bearer trailer", "x-checksum": "1"},
        };
        if (body) {
            cx."header-info".body_reader = new Http1BodyReader(new Socket(), body.size(), binary(body));
        }
        return cx;
    }

    static hash<auto> header() {
        return {
            "method": "POST",
            "path": "stream?token=secret",
            "authorization": "Basic dGVzdDp0ZXN0",
            "proxy-authorization": "Basic cHJveHk=",
            "cookie": "session=secret",
            "content-length": "5",
            "headers": {"Authorization": "Basic dGVzdDp0ZXN0", "Cookie": "session=secret"},
        };
    }

    filterTest() {
        # no options: every credential is withheld
        hash<HttpFilteredRequestInfo> f = AbstractStreamRequest::filterRequest(rawContext(1), header());
        assertEq(("auth", "sock_key", "socket", "socket-info", "uctx"), sort(keys (rawContext(1) - keys f.cx)));
        assertEq(("address", "familystr", "port"), sort(keys f.cx."peer-info"));
        assertFalse(f.hdr.hasKey("authorization"));
        assertFalse(f.hdr.hasKey("proxy-authorization"));
        assertFalse(f.hdr.hasKey("cookie"));
        assertEq({}, f.hdr.headers);
        assertEq({"Accept": "*/*"}, f.cx."header-info"."headers-raw");
        assertFalse(f.cx.url.hasKey("username"));
        assertFalse(f.cx.url.hasKey("password"));
        assertTrue(inlist("url-userinfo", f.withheld));
        assertTrue(inlist("authorization", f.withheld));
        # the platform's query parameter
        f = AbstractStreamRequest::filterRequest(rawContext(1), header(),
            <HttpRequestFilterOptions>{"platform_query_params": "token"});
        assertEq("/stream", f.cx.raw_path);
        assertEq("/stream", f.cx."header-info"."request-uri");
        assertEq("stream", f.hdr.path);
        assertTrue(inlist("query:token", f.withheld));
        # the platform's own header field
        hash<auto> h = header() + {"x-api-key": "secret"};
        f = AbstractStreamRequest::filterRequest(rawContext(1), h, <HttpRequestFilterOptions>{"platform_headers": "X-Api-Key"});
        assertFalse(f.hdr.hasKey("x-api-key"));
        # a handler that authenticates its own endpoint opts in to Authorization; never to the others
        f = AbstractStreamRequest::filterRequest(rawContext(1), header(), <HttpRequestFilterOptions>{
            "platform_authenticated": False,
            "own_headers": ("Authorization", "Cookie"),
        });
        assertEq("Basic dGVzdDp0ZXN0", f.hdr.authorization);
        assertFalse(f.hdr.hasKey("cookie"));
        # not when the platform authenticated the request
        f = AbstractStreamRequest::filterRequest(rawContext(1), header(), <HttpRequestFilterOptions>{
            "platform_authenticated": True,
            "own_headers": "authorization",
        });
        assertFalse(f.hdr.hasKey("authorization"));
    }

    trailerTest() {
        hash<HttpFilteredRequestInfo> f = AbstractStreamRequest::filterRequest(rawContext(1), header());
        assertEq({"x-checksum": "1"}, f.cx.trailers);
        assertEq({"x-checksum": "1"}, AbstractStreamRequest::filterTrailers({"Authorization": "x", "Cookie": "y",
            "x-checksum": "1"}));
        assertNothing(AbstractStreamRequest::filterTrailers());
    }

    factoryTest() {
        TestStreamHandler h();
        RecordRequest r = call(h, "one", 1);
        assertEq({
            "authorization": False,
            "cookie": False,
            "trailer authorization": False,
            "server objects": (),
            "body_reader": False,
        }, h.factory_seen);
        assertEq({"authorization": False, "cookie": False, "server objects": (), "body_reader": False}, r.seen);
        # the stream request itself read the body through the body reader of the raw request
        assertEq(5, r.size);
    }

    trustedTest() {
        # a trusted handler that does not ask for the filter: the factory gets the request as the server made it
        TestStreamHandler h(False);
        RecordRequest r = call(h, "one", 1);
        assertEq(sort(keys rawContext(1, "hello")), sort(h.factory_keys));
        assertTrue(h.factory_seen.authorization);
        assertTrue(h.factory_seen.cookie);
        assertEq(("auth", "sock_key", "socket", "socket-info", "uctx"), sort(h.factory_seen."server objects"));
        assertTrue(r.seen.authorization);
        assertEq(5, r.size);
    }

    tenantStreamTest() {
        Program p(TenantOpts);
        p.setSandboxManager(new SandboxManager());
        p.parse(Tenant, "tenant");
        object h = p.callFunction("stream_handler");
        # the tenant's handler gets no socket of a connection; a handler socket view
        hash<auto> rv = h.handleRequest(new TestListener(), new Socket(), rawContext(1, "hello"), header(), NOTHING);
        hash<auto> result = parse_json(rv.body);
        assertEq({"authorization": False, "cookie": False, "server objects": ()}, h.factory_seen);
        assertEq({"authorization": False, "cookie": False, "server objects": ()}, result.seen);
        assertEq(5, result.size, "the stream request read its body through the raw request");
        # through the server, HTTP/1.1 chunked, with a credential trailer
        HttpServer server(<HttpServerOptionInfo>{"logger": new Logger("server", LoggerLevel::getLevelError())});
        on_exit server.stop();
        server.setHandler("tenant", "^tenant", NOTHING, p.callFunction("stream_handler"));
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        Socket s();
        s.connect("127.0.0.1:" + port);
        on_exit s.close();
        s.send("POST /tenant HTTP/1.1\r\nHost: x\r\nContent-Type: text/plain\r\nAuthorization: Basic dGVzdDp0ZXN0\r\n"
            "Transfer-Encoding: chunked\r\nTrailer: Authorization, X-Checksum\r\n\r\n"
            "5\r\nhello\r\n0\r\nAuthorization: Bearer trailer\r\nX-Checksum: 1\r\n\r\n");
        hash<auto> resp = s.readHTTPHeader(10s);
        assertEq(200, resp.status_code);
        string body = resp."transfer-encoding" == "chunked"
            ? s.readHTTPChunkedBody(10s).body
            : s.recv(resp."content-length".toInt(), 10s);
        result = parse_json(body);
        assertEq(5, result.size);
        assertEq("1", result.trailers."x-checksum");
        assertFalse(result.trailers.hasKey("authorization"));
        assertFalse(result.seen.authorization);
    }

    handoffTest() {
        # the first stream request created gets the raw request; a second one created for the same request does not
        TestStreamHandler h();
        call(h, "second", 1);
        # the second one, which the factory returned, falls back to the filtered request: it gets no body
        assertEq(0, h.made[1].size, "the second one");
        # the first one, which the factory did not return, took the raw request
        h.made[0].handleRequest();
        assertEq(5, h.made[0].size, "the first one");
        h = new TestStreamHandler();
        call(h, "first", 1);
        assertEq(5, h.made[0].size);
    }

    nestingTest() {
        # a nested dispatch on the thread has its own handoff; the outer one is handed after it ends
        TestStreamHandler outer();
        outer.mode = "nested";
        outer.inner = new TestStreamHandler();
        # the inner request's body reader is in its own context
        call(outer, "nested", 1);
        assertEq(5, outer.made[0].size, "the outer stream request");
        # a factory that fails ends its handoff: a stream request created afterwards on the thread for the same
        # request does not get it
        TestStreamHandler h();
        assertThrows("TEST-ERROR", \HttpRequestFilterTest::call(), (h, "throw", 7));
        RecordRequest r(new TestListener(), h, new Socket(), rawContext(7) - "header-info", header(), NOTHING);
        r.handleRequest();
        assertEq(0, r.size);
    }

    fallbackTest() {
        # created without a dispatch, the stream request uses its arguments as they are
        TestStreamHandler h();
        RecordRequest r(new TestListener(), h, new Socket(), rawContext(3, "hello"), header(), NOTHING);
        r.handleRequest();
        assertEq(5, r.size);
        assertTrue(r.seen.authorization);
    }

    #! sends a GET request for the REST class to the handler directly
    static hash<auto> restCall(RestHandler rest, string cls) {
        hash<auto> rv = rest.handleRequest(new TestListener(), new Socket(), rawContext(1) + {"url": {"path": cls},
            "orig_path": "/" + cls, "raw_path": "/" + cls}, header() + {"method": "GET", "path": cls,
            "accept": MimeTypeJson}, NOTHING);
        return {"code": rv.code} + parse_json(rv.body);
    }

    restTest() {
        Program p(TenantOpts);
        p.setSandboxManager(new SandboxManager());
        p.parse(Tenant, "tenant");
        # a trusted REST handler with a trusted and a tenant's REST class
        AddingRestHandler rest();
        rest.addClass(p.callFunction("rest_class"));
        # the trusted REST class gets the request as the server made it
        hash<auto> rv = restCall(rest, "probe");
        assertEq(200, rv.code);
        assertTrue(rv.authorization);
        assertTrue(rv.cookie);
        assertEq(("auth", "sock_key", "socket", "socket-info", "uctx"), sort(rv."server objects"));
        assertEq("by the handler", rv.added);
        # the tenant's REST class gets it filtered, with the keys that the handler names
        rv = restCall(rest, "tenant");
        assertEq({"code": 200, "authorization": False, "cookie": False, "server objects": (),
            "added": "by the handler"}, rv);
        # with the handler's opt-in, the trusted REST class gets it filtered as well
        rest.setFilterRequests();
        rv = restCall(rest, "probe");
        assertEq({"code": 200, "authorization": False, "cookie": False, "server objects": (),
            "added": "by the handler"}, rv);
    }

    chunkedTest() {
        TestStreamHandler h();
        HttpServer server(<HttpServerOptionInfo>{"logger": new Logger("server", LoggerLevel::getLevelError())});
        on_exit server.stop();
        server.setHandler("stream", "^stream", NOTHING, h);
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        Socket s();
        s.connect("127.0.0.1:" + port);
        on_exit s.close();
        s.send("POST /stream HTTP/1.1\r\nHost: x\r\nContent-Type: text/plain\r\nAuthorization: Basic dGVzdDp0ZXN0\r\n"
            "Transfer-Encoding: chunked\r\nTrailer: Authorization, X-Checksum\r\n\r\n"
            "5\r\nhello\r\n0\r\nAuthorization: Bearer trailer\r\nX-Checksum: 1\r\n\r\n");
        hash<auto> resp = s.readHTTPHeader(10s);
        assertEq(200, resp.status_code);
        string body = resp."transfer-encoding" == "chunked"
            ? s.readHTTPChunkedBody(10s).body
            : s.recv(resp."content-length".toInt(), 10s);
        hash<auto> rv = parse_json(body);
        assertEq(5, rv.size);
        assertEq("1", rv.trailers."x-checksum");
        assertFalse(rv.trailers.hasKey("authorization"));
        assertFalse(rv.seen.authorization);
        assertFalse(h.factory_seen.authorization);
    }

    http2Test() {
        http2Intern(new TestStreamHandler(), "a trusted handler that asks for the filter");
        Program p(TenantOpts);
        p.setSandboxManager(new SandboxManager());
        p.parse(Tenant, "tenant");
        http2Intern(p.callFunction("stream_handler"), "a handler of a sandboxed Program");
    }

    private http2Intern(AbstractHttpRequestHandler h, string label) {
        HttpServer server(<HttpServerOptionInfo>{"logger": new Logger("server", LoggerLevel::getLevelError())});
        on_exit delete server;
        server.setHandler("stream", "^stream", NOTHING, h);
        int port = server.addListener(<HttpListenerOptionInfo>{
            "node": "127.0.0.1",
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
            "enable_h3": False,
        }).port;
        server.waitForAsyncIo();
        string url = sprintf("https://127.0.0.1:%d", port);
        HttpClientIo::HttpClientConnectionManager mgr(<HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": "h2",
            "max_connections_per_host": 1,
        });
        on_exit delete mgr;
        list<HttpClientIo::HttpClientStreamHandle> streams = (mgr.acquireStream(url), mgr.acquireStream(url));
        hash<string, string> results = {};
        Counter done(2);
        foreach int i in (0, 1) {
            int n = i;
            HttpClientIo::HttpClientStreamHandle stream = streams[n];
            background sub () {
                on_exit done.dec();
                try {
                    hash<auto> resp = stream.request("POST", "/stream", {
                        "Content-Type": MimeTypeText,
                        "Authorization": "Bearer stream-" + n,
                    }, strmul("x", n + 3), 30s);
                    results{n} = resp.body.typeCode() == NT_BINARY ? binary_to_string(resp.body) : resp.body;
                } catch (hash<ExceptionInfo> ex) {
                    results{n} = sprintf("%s: %s", ex.err, ex.desc);
                }
            }();
        }
        assertEq(0, done.waitForZero(60s), label + ": both requests end");
        foreach int i in (0, 1) {
            hash<auto> rv = parse_json(results{i});
            # each stream request read the body of its own stream
            assertEq(i + 3, rv.size, sprintf("%s: stream %d", label, i));
            assertFalse(rv.seen.authorization, sprintf("%s: stream %d", label, i));
            assertEq((), rv.seen."server objects", sprintf("%s: stream %d", label, i));
        }
    }

    sandboxTest() {
        Program p(TenantOpts);
        p.setSandboxManager(new SandboxManager());
        p.parse(Tenant, "tenant");
        # the opt-ins refuse sandboxed callers
        assertEq("REQUEST-ERROR", p.callFunction("set_credentials", new TestStreamHandler()));
        assertEq("REST-ERROR", p.callFunction("set_keys", new RestHandler()));
        assertEq("REQUEST-ERROR", p.callFunction("stop_filter", new TestStreamHandler()));
        # the handoff cannot be named or reached
        assertNeq("OK", p.callFunction("reflect"));
        assertEq(0, p.callFunction("reflect_all"));
        foreach hash<auto> i in ({
            "http_request_handoffs": "auto sub f() { return http_request_handoffs; }",
            "HttpRequestHandoff": "auto sub f() { return HttpRequestHandoff::take({}, {}); }",
            "raw_cx": "class T inherits HttpServer::AbstractStreamRequest { auto f() { return raw_cx; } }",
        }.pairIterator()) {
            Program t(TenantOpts);
            t.setSandboxManager(new SandboxManager());
            t.loadModule("HttpServerUtil");
            assertThrows("PARSE-EXCEPTION", i.key, \t.parse(), (i.value, i.key), i.key);
        }
    }

    #! calls the handler directly with a request whose body is given through the body reader of the raw request
    static RecordRequest call(TestStreamHandler h, string mode, int id) {
        h.mode = mode;
        if (h.inner) {
            h.inner.mode = "one";
        }
        h.handleRequest(new TestListener(), new Socket(), HttpRequestFilterTest::rawContext(id, "hello"),
            HttpRequestFilterTest::header(), NOTHING);
        return h.made[0];
    }
}
