    FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
    DEALINGS IN THE SOFTWARE.

    The code that serves a stream request and the REST classes of a REST handler get the request without the objects
    of the server and the credentials of the request (AbstractStreamRequest::filterRequest(), qore#6843) when a
    sandbox governs them, and trusted code when its handler asks for it (setFilterRequests()); trusted code gets the
    request as before otherwise; the stream request itself serves the request with the raw request, which the
    request handler hands to the first stream request created for the request only, and which no other code reaches
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires Mime
%requires HttpServerUtil
%requires HttpServer
%requires RestHandler
%requires HttpClientIo
%requires json
%requires reflection

%exec-class HttpRequestFilterTest

#! a listener for the direct calls of a handler
class TestListener inherits HttpListenerInterface {
    log(string fmt, ...) {
    }

    logError(string fmt, ...) {
    }

    addUserThreadContext(hash<auto> uctx) {
    }

    auto removeUserThreadContext(*string k) {
    }
}

#! a stream request that reports what its subclass code gets: the size of the body, the trailers and its context
class RecordRequest inherits AbstractStreamRequest {
    public {
        int size = 0;
        *hash<auto> trailers;
        hash<auto> seen;
    }

    constructor(HttpListenerInterface listener, AbstractHttpRequestHandler handler, Socket s, hash<auto> cx,
            hash<auto> hdr, auto body) : AbstractStreamRequest(listener, handler, s, cx, hdr, body) {
        seen = {
            "authorization": hdr.hasKey("authorization") || cx.hdr.hasKey("authorization"),
            "cookie": hdr.hasKey("cookie"),
            "server objects": (map $1, ("socket", "socket-info", "uctx", "auth", "logger", "sock_key"),
                cx.hasKey($1)) ?? (),
            "body_reader": cx."header-info".hasKey("body_reader"),
        };
    }

    private nothing recvImpl(hash<auto> v) {
        if (exists v.data) {
            size += v.data.size();
        } else if (v.hdr) {
            trailers = v.hdr;
        }
    }

    private hash<HttpResponseInfo> getResponseHeaderMessageImpl() {
        return <HttpResponseInfo>{
            "code": 200,
            "hdr": {"Content-Type": MimeTypeJson},
            "body": make_json({"size": size, "trailers": trailers, "seen": seen}),
        };
    }
}

#! a stream request handler whose factory does what the test asks for
class TestStreamHandler inherits AbstractHttpRequestHandler {
    public {
        #! what the factory got
        hash<auto> factory_seen;
        #! the keys of the request context that the factory got
        list<string> factory_keys = ();
        #! the stream requests that the factory created
        list<RecordRequest> made = ();
        #! the factory's mode: "one", "second", "first", "throw", "nested"
        string mode = "one";
        #! the handler that a nested dispatch calls
        *TestStreamHandler inner;
    }

    constructor(bool filter = True) : AbstractHttpRequestHandler(NOTHING, True) {
        if (filter) {
            setFilterRequests();
        }
    }

    bool wantsBodyStreaming(hash<auto> cx, hash<auto> hdr) {
        return True;
    }

    private AbstractStreamRequest getStreamRequestImpl(HttpListenerInterface listener, Socket s, hash<auto> cx,
            hash<auto> hdr, *data body) {
        factory_keys = keys cx;
        factory_seen = {
            "authorization": hdr.hasKey("authorization"),
            "cookie": hdr.hasKey("cookie"),
            "trailer authorization": cx.trailers.hasKey("authorization"),
            "server objects": (map $1, ("socket", "socket-info", "uctx", "auth", "logger", "sock_key"),
                cx.hasKey($1)) ?? (),
            "body_reader": cx."header-info".hasKey("body_reader"),
        };
        switch (mode) {
            case "throw":
                throw "TEST-ERROR", "the factory fails";
            case "nested":
                # a handler dispatches another request on the thread before it creates its own stream request
                inner.handleRequest(listener, new Socket(), HttpRequestFilterTest::rawContext(2), HttpRequestFilterTest::header(),
                    NOTHING);
                break;
        }
        RecordRequest a(listener, self, s, cx, hdr, body);
        made += a;
        if (mode == "second" || mode == "first") {
            RecordRequest b(listener, self, s, cx, hdr, body);
            made += b;
            return mode == "second" ? b : a;
        }
        return a;
    }
}

#! a REST class that reports what it gets
class ProbeRestClass inherits AbstractRestClass {
    string name() {
        return "probe";
    }

    hash<HttpHandlerResponseInfo> get(hash<auto> cx, *hash<auto> ah) {
        return RestHandler::makeResponse(200, {
            "authorization": cx.hdr.hasKey("authorization"),
            "cookie": cx.hdr.hasKey("cookie"),
            "server objects": (map $1, ("socket", "socket-info", "uctx", "auth", "logger", "sock_key"),
                cx.hasKey($1)) ?? (),
            "added": cx.added,
        });
    }
}

#! a REST handler that adds a key to the request context for its REST classes
class AddingRestHandler inherits RestHandler {
    constructor() {
        addClass(new ProbeRestClass());
        setRestContextKeys("added");
    }

    hash<HttpResponseInfo> handleRequest(HttpListenerInterface listener, Socket s, hash<auto> cx,
            hash<auto> hdr, *data b) {
        cx.added = "by the handler";
        return RestHandler::handleRequest(listener, s, cx, hdr, b);
    }
}

const TenantOpts = PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES;

const Tenant = "%requires HttpServerUtil
%requires RestHandler
%requires reflection
%requires json

string sub attempt(code c) {
    try {
        c();
        return 'OK';
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
}

#! a stream request of the tenant, which reports what it gets
class TenantRequest inherits AbstractStreamRequest {
    private:internal {
        int size = 0;
        *hash<auto> trailers;
        hash<auto> seen;
    }

    constructor(HttpListenerInterface listener, AbstractHttpRequestHandler handler, Socket s, hash<auto> cx,
            hash<auto> hdr, auto body) : AbstractStreamRequest(listener, handler, s, cx, hdr, body) {
        seen = {
            'authorization': hdr.hasKey('authorization'),
            'cookie': hdr.hasKey('cookie'),
            'server objects': (map $1, ('socket', 'socket-info', 'uctx', 'auth', 'logger', 'sock_key'),
                cx.hasKey($1)) ?? (),
        };
    }

    private nothing recvImpl(hash<auto> v) {
        if (exists v.data) {
            size += v.data.size();
        } else if (v.hdr) {
            trailers = v.hdr;
        }
    }

    private hash<HttpResponseInfo> getResponseHeaderMessageImpl() {
        return <HttpResponseInfo>{
            'code': 200,
            'hdr': {'Content-Type': 'application/json'},
            'body': make_json({'size': size, 'trailers': trailers, 'seen': seen}),
        };
    }
}

#! a stream request handler of the tenant: its factory reports what it gets
class TenantStreamHandler inherits AbstractHttpRequestHandler {
    public {
        hash<auto> factory_seen;
    }

    constructor() : AbstractHttpRequestHandler(NOTHING, True) {
    }

    private AbstractStreamRequest getStreamRequestImpl(HttpListenerInterface listener, Socket s, hash<auto> cx,
            hash<auto> hdr, *data body) {
        factory_seen = {
            'authorization': hdr.hasKey('authorization'),
            'cookie': hdr.hasKey('cookie'),
            'server objects': (map $1, ('socket', 'socket-info', 'uctx', 'auth', 'logger', 'sock_key'),
                cx.hasKey($1)) ?? (),
        };
        return new TenantRequest(listener, self, s, cx, hdr, body);
    }
}

#! a REST class of the tenant that reports what it gets
class TenantRestClass inherits AbstractRestClass {
    string name() {
        return 'tenant';
    }

    hash<HttpHandlerResponseInfo> get(hash<auto> cx, *hash<auto> ah) {
        return RestHandler::makeResponse(200, {
            'authorization': cx.hdr.hasKey('authorization'),
            'cookie': cx.hdr.hasKey('cookie'),
            'server objects': (map $1, ('socket', 'socket-info', 'uctx', 'auth', 'logger', 'sock_key'),
                cx.hasKey($1)) ?? (),
            'added': cx.added,
        });
    }
}

AbstractHttpRequestHandler sub stream_handler() {
    return new TenantStreamHandler();
}

AbstractRestClass sub rest_class() {
    return new TenantRestClass();
}

string sub set_credentials(AbstractHttpRequestHandler h) {
    return attempt(sub () { h.setRequestCredentialHeaders('authorization'); });
}

string sub set_keys(RestHandler h) {
    return attempt(sub () { h.setRestContextKeys('socket'); });
}

string sub stop_filter(AbstractHttpRequestHandler h) {
    return attempt(sub () { h.setFilterRequests(False); });
}

string sub reflect() {
    return attempt(sub () {
        Reflection::GlobalVar v = Reflection::GlobalVar::forName('http_request_handoffs');
        v.getValue();
    });
}

int sub reflect_all() {
    return Reflection::GlobalVar::findAllRegex('handoff').size();
}
";

