    and/or sell copies of the Software, and to permit persons to whom the
    Software is furnished to do so, subject to the following conditions:

    The above copyright notice and this permission notice shall be included in
    all copies or substantial portions of the Software.

    THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
    IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
    FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
    AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
    LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
    FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
    DEALINGS IN THE SOFTWARE.

    The code that serves a stream request and the REST classes of a REST handler get the request without the objects
    of the server and the credentials of the request (AbstractStreamRequest::filterRequest(), qore#6843) when a
    sandbox that does not trust their code governs them (SandboxManager::isRestricted(),
    SandboxManager::isFromRestrictedProgram()), with the platform's authorization context that the authenticator
    declares, and trusted code when its handler asks for it (setFilterRequests()); trusted code, also trusted code
    that a sandbox governs only to interrupt or limit it, gets the request as before otherwise; the stream request
    itself serves the request with the raw request, which the request handler (or the HTTP server) hands to the first
    stream request created for the request only, and which no other code reaches
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires Mime
%requires HttpServerUtil
%requires HttpServer
%requires RestHandler
%requires HttpClientIo
%requires json
%requires reflection

%exec-class HttpRequestFilterTest

#! a listener for the direct calls of a handler
class TestListener inherits HttpListenerInterface {
    log(string fmt, ...) {
    }

    logError(string fmt, ...) {
    }

    addUserThreadContext(hash<auto> uctx) {
    }

    auto removeUserThreadContext(*string k) {
    }
}

#! a stream request that reports what its subclass code gets: the size of the body, the trailers and its context
class RecordRequest inherits AbstractStreamRequest {
    public {
        int size = 0;
        *hash<auto> trailers;
        hash<auto> seen;
    }

    constructor(HttpListenerInterface listener, AbstractHttpRequestHandler handler, Socket s, hash<auto> cx,
            hash<auto> hdr, auto body) : AbstractStreamRequest(listener, handler, s, cx, hdr, body) {
        seen = {
            "authorization": hdr.hasKey("authorization") || cx.hdr.hasKey("authorization"),
            "cookie": hdr.hasKey("cookie"),
            "server objects": (map $1, ("socket", "socket-info", "uctx", "auth", "logger", "sock_key"),
                cx.hasKey($1)) ?? (),
            "body_reader": cx."header-info".hasKey("body_reader"),
        };
    }

    private nothing recvImpl(hash<auto> v) {
        if (exists v.data) {
            size += v.data.size();
        } else if (v.hdr) {
            trailers = v.hdr;
        }
    }

    private hash<HttpResponseInfo> getResponseHeaderMessageImpl() {
        return <HttpResponseInfo>{
            "code": 200,
            "hdr": {"Content-Type": MimeTypeJson},
            "body": make_json({"size": size, "trailers": trailers, "seen": seen}),
        };
    }
}

#! a stream request handler whose factory does what the test asks for
class TestStreamHandler inherits AbstractHttpRequestHandler {
    public {
        #! what the factory got
        hash<auto> factory_seen;
        #! the keys of the request context that the factory got
        list<string> factory_keys = ();
        #! the stream requests that the factory created
        list<RecordRequest> made = ();
        #! the factory's mode: "one", "second", "first", "throw", "nested"
        string mode = "one";
        #! the handler that a nested dispatch calls
        *TestStreamHandler inner;
    }

    constructor(bool filter = True) : AbstractHttpRequestHandler(NOTHING, True) {
        if (filter) {
            setFilterRequests();
        }
    }

    bool wantsBodyStreaming(hash<auto> cx, hash<auto> hdr) {
        return True;
    }

    private AbstractStreamRequest getStreamRequestImpl(HttpListenerInterface listener, Socket s, hash<auto> cx,
            hash<auto> hdr, *data body) {
        factory_keys = keys cx;
        factory_seen = {
            "authorization": hdr.hasKey("authorization"),
            "cookie": hdr.hasKey("cookie"),
            "trailer authorization": cx.trailers.hasKey("authorization"),
            "server objects": (map $1, ("socket", "socket-info", "uctx", "auth", "logger", "sock_key"),
                cx.hasKey($1)) ?? (),
            "body_reader": cx."header-info".hasKey("body_reader"),
        };
        switch (mode) {
            case "throw":
                throw "TEST-ERROR", "the factory fails";
            case "nested":
                # a handler dispatches another request on the thread before it creates its own stream request
                inner.handleRequest(listener, new Socket(), HttpRequestFilterTest::rawContext(2), HttpRequestFilterTest::header(),
                    NOTHING);
                break;
        }
        RecordRequest a(listener, self, s, cx, hdr, body);
        made += a;
        if (mode == "second" || mode == "first") {
            RecordRequest b(listener, self, s, cx, hdr, body);
            made += b;
            return mode == "second" ? b : a;
        }
        return a;
    }
}

#! a REST class that reports what it gets
class ProbeRestClass inherits AbstractRestClass {
    string name() {
        return "probe";
    }

    hash<HttpHandlerResponseInfo> get(hash<auto> cx, *hash<auto> ah) {
        return RestHandler::makeResponse(200, {
            "authorization": cx.hdr.hasKey("authorization"),
            "cookie": cx.hdr.hasKey("cookie"),
            "server objects": (map $1, ("socket", "socket-info", "uctx", "auth", "logger", "sock_key"),
                cx.hasKey($1)) ?? (),
            "added": cx.added,
        });
    }
}

#! a REST handler that adds a key to the request context for its REST classes
class AddingRestHandler inherits RestHandler {
    constructor() {
        addClass(new ProbeRestClass());
        setRestContextKeys("added");
    }

    hash<HttpResponseInfo> handleRequest(HttpListenerInterface listener, Socket s, hash<auto> cx,
            hash<auto> hdr, *data b) {
        cx.added = "by the handler";
        return RestHandler::handleRequest(listener, s, cx, hdr, b);
    }
}

#! a trusted authenticator that declares the keys of the platform's authorization context
class TrustedAuth inherits AbstractAuthenticator {
    *list<string> getPlatformContextKeys() {
        return ("group_namespace", "sandboxed", "user_flags", "socket", "obj", "nested", "listed", "plain");
    }
}

#! a trusted stream handler whose factory calls the given code, and that can run the code of another object
class DelegatingHandler inherits AbstractHttpRequestHandler {
    private {
        code make;
        *object hosted;
    }

    constructor(code make, *object hosted, bool filter = False) : AbstractHttpRequestHandler(NOTHING, True) {
        self.make = make;
        if (hosted) {
            self.hosted = hosted;
            setHostsCode();
        }
        if (filter) {
            setFilterRequests();
        }
    }

    private list<object> hostedObjects() {
        return hosted ? (hosted,) : ();
    }

    private AbstractStreamRequest getStreamRequestImpl(HttpListenerInterface listener, Socket s, hash<auto> cx,
            hash<auto> hdr, *data body) {
        return make(listener, self, s, cx, hdr, body);
    }
}

const TenantOpts = PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES;

const Tenant = "%requires HttpServerUtil
%requires RestHandler
%requires reflection
%requires json

string sub attempt(code c) {
    try {
        c();
        return 'OK';
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
}

#! a stream request of the tenant, which reports what it gets
class TenantRequest inherits AbstractStreamRequest {
    private:internal {
        int size = 0;
        *hash<auto> trailers;
        hash<auto> seen;
    }

    constructor(HttpListenerInterface listener, AbstractHttpRequestHandler handler, Socket s, hash<auto> cx,
            hash<auto> hdr, auto body) : AbstractStreamRequest(listener, handler, s, cx, hdr, body) {
        seen = {
            'authorization': hdr.hasKey('authorization'),
            'cookie': hdr.hasKey('cookie'),
            'server objects': (map $1, ('socket', 'socket-info', 'uctx', 'auth', 'logger', 'sock_key'),
                cx.hasKey($1)) ?? (),
        };
    }

    private nothing recvImpl(hash<auto> v) {
        if (exists v.data) {
            size += v.data.size();
        } else if (v.hdr) {
            trailers = v.hdr;
        }
    }

    private hash<HttpResponseInfo> getResponseHeaderMessageImpl() {
        return <HttpResponseInfo>{
            'code': 200,
            'hdr': {'Content-Type': 'application/json'},
            'body': make_json({'size': size, 'trailers': trailers, 'seen': seen}),
        };
    }
}

#! a stream request handler of the tenant: its factory reports what it gets
class TenantStreamHandler inherits AbstractHttpRequestHandler {
    public {
        hash<auto> factory_seen;
        hash<auto> platform_seen;
    }

    constructor(*AbstractAuthenticator auth) : AbstractHttpRequestHandler(auth, True) {
    }

    private AbstractStreamRequest getStreamRequestImpl(HttpListenerInterface listener, Socket s, hash<auto> cx,
            hash<auto> hdr, *data body) {
        platform_seen = cx{'group_namespace', 'sandboxed', 'user_flags', 'plain'} + {
            'socket': cx.hasKey('socket'),
            'obj': cx.hasKey('obj'),
            'nested': cx.hasKey('nested'),
            'listed': cx.hasKey('listed'),
        };
        factory_seen = {
            'authorization': hdr.hasKey('authorization'),
            'cookie': hdr.hasKey('cookie'),
            'server objects': (map $1, ('socket', 'socket-info', 'uctx', 'auth', 'logger', 'sock_key'),
                cx.hasKey($1)) ?? (),
        };
        return new TenantRequest(listener, self, s, cx, hdr, body);
    }
}

#! a REST class of the tenant that reports what it gets
class TenantRestClass inherits AbstractRestClass {
    string name() {
        return 'tenant';
    }

    hash<HttpHandlerResponseInfo> get(hash<auto> cx, *hash<auto> ah) {
        return RestHandler::makeResponse(200, {
            'authorization': cx.hdr.hasKey('authorization'),
            'cookie': cx.hdr.hasKey('cookie'),
            'server objects': (map $1, ('socket', 'socket-info', 'uctx', 'auth', 'logger', 'sock_key'),
                cx.hasKey($1)) ?? (),
            'added': cx.added,
        });
    }
}

#! a REST class of the tenant that reports the platform's authorization context that it gets
class TenantPlatformRestClass inherits AbstractRestClass {
    string name() {
        return 'platform';
    }

    hash<HttpHandlerResponseInfo> get(hash<auto> cx, *hash<auto> ah) {
        return RestHandler::makeResponse(200, cx{'group_namespace', 'sandboxed', 'user_flags', 'plain'} + {
            'socket': cx.hasKey('socket'),
            'obj': cx.hasKey('obj'),
            'nested': cx.hasKey('nested'),
            'listed': cx.hasKey('listed'),
        });
    }
}

#! an authenticator of the tenant: the keys that it declares are not kept
class TenantAuth inherits AbstractAuthenticator {
    *list<string> getPlatformContextKeys() {
        return ('group_namespace', 'sandboxed', 'user_flags');
    }
}

AbstractHttpRequestHandler sub stream_handler() {
    return new TenantStreamHandler();
}

AbstractHttpRequestHandler sub stream_handler_auth(AbstractAuthenticator auth) {
    return new TenantStreamHandler(auth);
}

AbstractAuthenticator sub tenant_auth() {
    return new TenantAuth();
}

AbstractRestClass sub platform_class() {
    return new TenantPlatformRestClass();
}

AbstractStreamRequest sub make_request(HttpListenerInterface listener, AbstractHttpRequestHandler handler, Socket s,
        hash<auto> cx, hash<auto> hdr, auto body) {
    return new TenantRequest(listener, handler, s, cx, hdr, body);
}

bool sub restricted() {
    return SandboxManager::isRestricted();
}

bool sub sandboxed() {
    return SandboxManager::isSandboxed();
}

bool sub child_restricted() {
    # a Program that this code creates, with a sandbox of its own that allows everything
    SandboxManager sm();
    sm.setFilesystemDefaultPolicy(True);
    sm.setNetworkDefaultPolicy(True);
    sm.setUncontrolledApiPolicy(True);
    Program c(PO_NEW_STYLE);
    c.setSandboxManager(sm);
    c.parse('class C {} object sub mk() { return new C(); }', 'child');
    return SandboxManager::isFromRestrictedProgram(c.callFunction('mk'));
}

string sub push_raw() {
    return attempt(sub () { AbstractHttpRequestHandler::pushRawRequest({'id': 1}, {'method': 'GET'}); });
}

AbstractRestClass sub rest_class() {
    return new TenantRestClass();
}

string sub set_credentials(AbstractHttpRequestHandler h) {
    return attempt(sub () { h.setRequestCredentialHeaders('authorization'); });
}

string sub set_keys(RestHandler h) {
    return attempt(sub () { h.setRestContextKeys('socket'); });
}

string sub stop_filter(AbstractHttpRequestHandler h) {
    return attempt(sub () { h.setFilterRequests(False); });
}

string sub reflect() {
    return attempt(sub () {
        Reflection::GlobalVar v = Reflection::GlobalVar::forName('http_request_handoffs');
        v.getValue();
    });
}

int sub reflect_all() {
    return Reflection::GlobalVar::findAllRegex('handoff').size();
}
";

