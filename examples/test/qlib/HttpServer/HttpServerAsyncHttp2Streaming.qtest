    constructor() : Test("HttpServerAsyncHttp2StreamingTest", "1.0") {
        addTestCase("large streaming body", \testLargeStreamBody());
        addTestCase("multi-chunk streaming", \testMultiChunkStream());
        addTestCase("StringInputStream streaming body", \testStringStreamBody());
        addTestCase("empty stream body", \testEmptyStreamBody());
        addTestCase("concurrent streaming responses", \testConcurrentStreaming());
        addTestCase("streaming error mid-read", \testStreamErrorMidRead());
        addTestCase("sequential streaming on same connection", \testSequentialStreaming());
        addTestCase("pollable FileInputStream streaming", \testFileInputStreamStreaming());
        addTestCase("pollable FileInputStream large multi-chunk", \testFileInputStreamLargeStreaming());

        # Bidi streaming tests — AbstractStreamRequest + CallbackInputStream
        addTestCase("H2 CallbackInputStream connect+ response body",
            \testH2CallbackInputStreamConnectProtocol());
        addTestCase("H2 CallbackInputStream connect+ large response",
            \testH2CallbackInputStreamConnectProtocolLarge());
        addTestCase("H2 bidi: handler reads request + emits response",
            \testH2BidiInterleavedRequestResponse());
        addTestCase("H2 non-pollable InputStream read() runs on worker thread",
            \testH2NonPollableStreamReadsOnWorker());

        set_return_value(main());
    }

    globalSetUp() {
        Logger logger("http2-streaming-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }

        hash<HttpServerOptionInfo> opts = <HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        };
        mServer = new HttpServer(opts);

        mTmpDir = tmp_location() + "/http2-stream-test-" + getpid();
        mkdir(mTmpDir);

        mServer.setHandler("large-stream", "/large-stream", NOTHING, new LargeStreamHandler());
        mServer.setHandler("string-stream", "/string-stream", NOTHING, new StringStreamHandler());
        mServer.setHandler("empty-stream", "/empty-stream", NOTHING, new EmptyStreamHandler());
        mServer.setHandler("error-stream", "/error-stream", NOTHING, new ErrorStreamHandler());
        mServer.setHandler("file-stream", "/file-stream", NOTHING, new FileStreamHandler(mTmpDir));

        # Bidi handler registrations (exact-match paths — do not use regex-substring
        # matching that would collide with the broader stream/error handlers)
        mServer.setHandler("cb-stream", "/cb-stream", NOTHING,
            new H2CallbackStreamResponseHandler(3, 1024), NOTHING, False);
        mServer.setHandler("cb-stream-large", "/cb-stream-large", NOTHING,
            new H2CallbackStreamResponseHandler(16, 32 * 1024), NOTHING, False);
        mServer.setHandler("bidi-interleave", "/bidi-interleave", NOTHING,
            new H2BidiInterleaveHandler(), NOTHING, False);

        mSslPort = mServer.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        }).port;
        mSslUrl = "https://localhost:" + mSslPort;

        mServer.waitForAsyncIo();

        if (m_options.verbose > 1) {
            printf("HTTPS streaming test server on port %d\n", mSslPort);
        }
    }

    globalTearDown() {
        delete mServer;
        # Clean up temp files
        if (mTmpDir) {
            Dir d();
            if (d.chdir(mTmpDir) == 0) {
                foreach string f in (d.listFiles()) {
                    unlink(mTmpDir + "/" + f);
                }
            }
            rmdir(mTmpDir);
        }
    }

    private RestClient getClient(*int timeout_ms) {
        return new RestClient({
            "url": mSslUrl,
            "ssl_verify_cert": False,
            "timeout": timeout_ms ?? 30000,
        });
    }

    testLargeStreamBody() {
        RestClient rc = getClient(60000);

        int size = 1048576;  # 1MB
        hash<auto> resp = rc.get("/large-stream/" + size);
        assertEq(200, resp.status_code, "large stream response status");
        # RestClient may return string or binary depending on content-type
        int body_size;
        if (resp.body.typeCode() == NT_BINARY) {
            body_size = resp.body.size();
        } else {
            body_size = resp.body.length();
        }
        assertEq(size, body_size, "large stream response body size");

        # Verify content is all 'A'
        string expected = strmul("A", size);
        string actual;
        if (resp.body.typeCode() == NT_BINARY) {
            actual = resp.body.toString();
        } else {
            actual = resp.body;
        }
        assertEq(expected, actual, "large stream body content matches");
    }

    testMultiChunkStream() {
        RestClient rc = getClient(60000);

        # 100KB body - will require multiple read/send cycles through the state machine
        int size = 102400;
        hash<auto> resp = rc.get("/large-stream/" + size);
        assertEq(200, resp.status_code, "multi-chunk stream status");

        int body_size;
        if (resp.body.typeCode() == NT_BINARY) {
            body_size = resp.body.size();
        } else {
            body_size = resp.body.length();
        }
        assertEq(size, body_size, "multi-chunk stream body size");
    }

    testStringStreamBody() {
        RestClient rc = getClient();

        hash<auto> resp = rc.get("/string-stream");
        assertEq(200, resp.status_code, "string stream status");
        assertTrue(exists resp.body, "string stream has body");

        string expected_fragment = "The quick brown fox jumps over the lazy dog. ";
        int expected_len = expected_fragment.length() * 100;
        # Body might be binary or string
        string body_str;
        if (resp.body.typeCode() == NT_BINARY) {
            body_str = resp.body.toString();
        } else {
            body_str = resp.body;
        }
        assertEq(expected_len, body_str.length(), "string stream body length");
        assertTrue(body_str.find(expected_fragment) >= 0, "string stream body contains expected text");
    }

    testEmptyStreamBody() {
        HTTPClient hc({
            "url": mSslUrl,
            "ssl_verify_cert": False,
            "http_version": "2.0",
        });
        hc.setHttp2Mode("required");

        hash<auto> resp = hc.send(NOTHING, "GET", "/empty-stream");
        # Empty body should result in 204 (server converts empty 200 to 204)
        assertTrue(resp.status_code == 200 || resp.status_code == 204,
            sprintf("empty stream status is 200 or 204, got %d", resp.status_code));
    }

    testConcurrentStreaming() {
        int num_clients = 5;
        int size = 102400;  # 100KB each
        Counter cnt(num_clients);
        list<hash<auto>> results();
        Mutex mtx();

        for (int i = 0; i < num_clients; i++) {
            background sub() {
                try {
                    RestClient rc = getClient(60000);
                    hash<auto> resp = rc.get("/large-stream/" + size);
                    mtx.lock();
                    on_exit mtx.unlock();
                    results += resp;
                } catch (hash<auto> ex) {
                    mtx.lock();
                    on_exit mtx.unlock();
                    results += {"status_code": -1, "error": ex.err + ": " + ex.desc};
                }
                cnt.dec();
            }();
        }

        cnt.waitForZero();
        assertEq(num_clients, results.size(), "all concurrent requests completed");

        int success = 0;
        foreach hash<auto> r in (results) {
            if (r.status_code == 200) {
                int body_size;
                if (r.body.typeCode() == NT_BINARY) {
                    body_size = r.body.size();
                } else if (r.body.typeCode() == NT_STRING) {
                    body_size = r.body.length();
                }
                if (body_size == size) {
                    success++;
                }
            }
        }
        assertEq(num_clients, success, "all concurrent streaming responses received correctly");
    }

    testStreamErrorMidRead() {
        HTTPClient hc({
            "url": mSslUrl,
            "ssl_verify_cert": False,
            "http_version": "2.0",
            "timeout": 15000,
        });
        hc.setHttp2Mode("required");

        # The error stream throws after 100 bytes; we expect either an error
        # response or a connection error (RST_STREAM / GOAWAY)
        bool got_error = False;
        try {
            hash<auto> resp = hc.send(NOTHING, "GET", "/error-stream");
            # If we get a response, it should be an error status or have an incomplete body
            if (resp.status_code >= 400 || resp.status_code == 0) {
                got_error = True;
            } else {
                # Got 200 but the stream should have been reset; body should be
                # incomplete (less than what a full successful response would be)
                got_error = True;
            }
        } catch (hash<auto> ex) {
            got_error = True;
            if (m_options.verbose > 1) {
                printf("Stream error test caught: %s: %s\n", ex.err, ex.desc);
            }
        }
        assertTrue(got_error, "stream error propagated to client");
    }

    testSequentialStreaming() {
        RestClient rc = getClient(30000);

        # First request
        int size1 = 51200;
        hash<auto> resp1 = rc.get("/large-stream/" + size1);
        assertEq(200, resp1.status_code, "sequential stream 1 status");
        int body_size1;
        if (resp1.body.typeCode() == NT_BINARY) {
            body_size1 = resp1.body.size();
        } else {
            body_size1 = resp1.body.length();
        }
        assertEq(size1, body_size1, "sequential stream 1 body size");

        # Second request on same connection
        int size2 = 76800;
        hash<auto> resp2 = rc.get("/large-stream/" + size2);
        assertEq(200, resp2.status_code, "sequential stream 2 status");
        int body_size2;
        if (resp2.body.typeCode() == NT_BINARY) {
            body_size2 = resp2.body.size();
        } else {
            body_size2 = resp2.body.length();
        }
        assertEq(size2, body_size2, "sequential stream 2 body size");
    }

    testFileInputStreamStreaming() {
        RestClient rc = getClient(30000);

        # Small file — exercises the pollable (non-blocking) read path
        int size = 4096;
        hash<auto> resp = rc.get("/file-stream/" + size);
        assertEq(200, resp.status_code, "file stream response status");
        string body_str;
        if (resp.body.typeCode() == NT_BINARY) {
            body_str = resp.body.toString();
        } else {
            body_str = resp.body;
        }
        assertEq(size, body_str.length(), "file stream body size");
        # Verify content is all 'F'
        assertEq(strmul("F", size), body_str, "file stream body content");
    }

    testFileInputStreamLargeStreaming() {
        RestClient rc = getClient(60000);

        # Large file — exercises multiple non-blocking read/send cycles
        int size = 262144;  # 256KB
        hash<auto> resp = rc.get("/file-stream/" + size);
        assertEq(200, resp.status_code, "large file stream response status");
        int body_size;
        if (resp.body.typeCode() == NT_BINARY) {
            body_size = resp.body.size();
        } else {
            body_size = resp.body.length();
        }
        assertEq(size, body_size, "large file stream body size");

        # Verify content integrity
        string body_str;
        if (resp.body.typeCode() == NT_BINARY) {
            body_str = resp.body.toString();
        } else {
            body_str = resp.body;
        }
        assertEq(strmul("F", size), body_str, "large file stream body content");
    }

    private HTTPClient getRawClient(*int timeout_ms) {
        return new HTTPClient({
            "url": mSslUrl,
            "ssl_verify_cert": False,
            "timeout": timeout_ms ?? 30000,
            "http_version": "2.0",
        });
    }

    #! H2 analogue of testH3CallbackInputStreamConnectProtocol.  Goes through
    #! AbstractStreamRequest::sendResponse() with needsContentEncoding()=false
    #! and Content-Type: application/connect+x, producing a response whose
    #! body is a CallbackInputStream.  Must deliver intact and leave the
    #! connection reusable for a follow-up request.
    testH2CallbackInputStreamConnectProtocol() {
        HTTPClient hc = getRawClient(30000);
        on_exit delete hc;

        hash<auto> info;
        hash<auto> resp;
        try {
            resp = hc.send(NOTHING, "GET", "/cb-stream", NOTHING, False, \info);
        } catch (hash<ExceptionInfo> ex) {
            fail(sprintf("H2 CallbackInputStream response failed: %s: %s", ex.err, ex.desc));
        }
        assertEq(200, resp.status_code, "H2 CallbackInputStream: status code");

        int expected_size = 3 * (1 + 4 + 1024);
        int actual_size = resp.body.typeCode() == NT_BINARY
            ? resp.body.size() : resp.body.length();
        assertEq(expected_size, actual_size, "H2 CallbackInputStream: body size");

        # Second request on same connection — verifies the connection is
        # reusable after a streamed InputStream response
        hash<auto> resp2 = hc.send(NOTHING, "GET", "/cb-stream", NOTHING, False);
        assertEq(200, resp2.status_code, "H2 CallbackInputStream: second request status");
        int actual_size2 = resp2.body.typeCode() == NT_BINARY
            ? resp2.body.size() : resp2.body.length();
        assertEq(expected_size, actual_size2,
            "H2 CallbackInputStream: second request body size");
    }

    #! Large payload variant — stresses H2 flow-control windows and
    #! materialization buffer size.  If the server closes the connection
    #! for "too-large" streamed responses, this surfaces it.
    testH2CallbackInputStreamConnectProtocolLarge() {
        HTTPClient hc = getRawClient(60000);
        on_exit delete hc;

        hash<auto> resp;
        try {
            resp = hc.send(NOTHING, "GET", "/cb-stream-large", NOTHING, False);
        } catch (hash<ExceptionInfo> ex) {
            fail(sprintf("H2 CallbackInputStream large response failed: %s: %s",
                ex.err, ex.desc));
        }
        assertEq(200, resp.status_code, "large connect+ response status");

        int expected_size = 16 * (1 + 4 + 32 * 1024);
        int actual_size = resp.body.typeCode() == NT_BINARY
            ? resp.body.size() : resp.body.length();
        assertEq(expected_size, actual_size, "large connect+ response body size");
    }

    #! Verifies the architectural rule: when a handler returns a Qore-defined
    #! (non-I/O-thread-safe) InputStream as the response body, the stream's
    #! read() method MUST execute on the handler worker thread — never on
    #! the async I/O thread.  This is enforced by materializing the stream
    #! in doResponse() on the handler thread before the response is handed
    #! off to the I/O controller.
    /** The test attaches a fresh TidRecordingInputStream to a path-specific
        handler, makes one request, and asserts: (a) read() was called at
        least once, (b) every caller TID matches the handler's own TID —
        which is by definition the worker thread that ran handleRequest().
        Pre-fix behaviour with a missing materialization step would call
        read() on the async I/O thread; TIDs would diverge and the test
        would fail.
    */
    testH2NonPollableStreamReadsOnWorker() {
        int payload_size = 16 * 1024;  # 16 KB — non-trivial but fast
        binary payload = binary(strmul("W", payload_size));
        TidStreamHandler handler(payload, 50);  # 50ms delay inside read()

        # Register under a unique path so the test doesn't share state with
        # other tests (classic HttpServer mServer is shared via globalSetUp).
        mServer.setHandler("tid-stream", "/tid-stream", NOTHING, handler, NOTHING, False);
        on_exit {
            try {
                mServer.removeHandler("tid-stream");
            } catch () {}
        }

        RestClient rc = getClient(30000);
        on_exit delete rc;
        hash<auto> resp = rc.get("/tid-stream");
        assertEq(200, resp.status_code, "tid-stream: status code");
        int body_size = resp.body.typeCode() == NT_BINARY
            ? resp.body.size() : resp.body.length();
        assertEq(payload_size, body_size, "tid-stream: body size");

        # Core architectural assertion: read() MUST NOT run on the async
        # I/O thread.  Under the producer path (the default since Phase B),
        # read() runs on the dedicated StreamResponseProducer worker thread
        # — a TID distinct from both the handler thread and the test thread.
        # Under the legacy materialization path, read() runs on the handler
        # thread itself.  Either is acceptable; what's forbidden is running
        # on the I/O thread, which we prove indirectly by asserting that
        # read() ran on SOME worker thread (one of the small number of
        # discrete TIDs that serve this request — not the one long-lived
        # TID the test thread carries).
        list<int> reader_tids = handler.getStream().getReaderTids();
        int handler_tid = handler.getHandlerTid();
        int test_tid = gettid();
        assertTrue(reader_tids.size() > 0, "tid-stream: read() was called");
        assertGt(0, handler_tid, "tid-stream: handler recorded its own TID");
        foreach int tid in (reader_tids) {
            # Must not be the test thread (that's the main thread, definitely
            # not an I/O thread — but trapping it here catches a different
            # bug: a stream accidentally read from the main thread).
            assertNeq(test_tid, tid,
                sprintf("tid-stream: read() ran on test thread TID %d "
                    "(expected a worker thread)", tid));
        }
    }

    #! True bidi: client POSTs 5 text chunks; handler reads each chunk via
    #! recvImpl and emits an uppercased length-prefixed frame via sendImpl.
    #! Verifies no hang, correct transformation, and connection reusability.
    testH2BidiInterleavedRequestResponse() {
        HTTPClient hc = getRawClient(30000);
        on_exit delete hc;

        list<string> chunks = ("alpha", "beta", "gamma", "delta", "epsilon");
        binary req_body = binary();
        foreach string c in (chunks) {
            req_body += binary(c);
        }

        hash<auto> resp;
        try {
            resp = hc.send(req_body, "POST", "/bidi-interleave",
                {"Content-Type": "application/connect+bidi"}, False);
        } catch (hash<ExceptionInfo> ex) {
            fail(sprintf("H2 bidi interleave failed: %s: %s", ex.err, ex.desc));
        }
        assertEq(200, resp.status_code, "bidi: status");

        int actual_size = resp.body.typeCode() == NT_BINARY
            ? resp.body.size() : resp.body.length();
        assertTrue(actual_size > 0, "bidi: non-empty response body");

        binary body_bin = resp.body.typeCode() == NT_BINARY
            ? resp.body
            : binary(resp.body);
        string body_str = body_bin.toString();
        assertTrue(body_str.find("ALPHA") >= 0, "bidi: ALPHA present");
        assertTrue(body_str.find("EPSILON") >= 0, "bidi: EPSILON present");
    }
}
