#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

/*
    Copyright (C) 2026 Qore Technologies, s.r.o., all rights reserved

    HTTP/2 streaming response tests - exercises InputStream-based streaming
    responses through the async I/O controller with HTTP/2.
*/

%modern

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Mime.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/HttpServerUtil.qm
%requires ../../../../qlib/HttpServerAsyncIo
%requires ../../../../qlib/HttpServer.qm
%requires ../../../../qlib/RestClient.qm

%exec-class HttpServerAsyncHttp2StreamingTest

#! Handler that returns a large BinaryInputStream body
class LargeStreamHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        int size = 1024;
        *list<*string> m = (hdr.path =~ x/large-stream\/(\d+)/);
        if (m) {
            size = int(m[0]);
        }
        # Create repeating pattern so we can verify content
        return makeResponse(200, new BinaryInputStream(binary(strmul("A", size))), {
            "Content-Type": "application/octet-stream",
        });
    }
}

#! Handler that returns a StringInputStream body
class StringStreamHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        string text = strmul("The quick brown fox jumps over the lazy dog. ", 100);
        return makeResponse(200, new StringInputStream(text), {
            "Content-Type": "text/plain; charset=utf-8",
        });
    }
}

#! Handler that returns an empty BinaryInputStream
class EmptyStreamHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, new BinaryInputStream(binary()), {
            "Content-Type": "application/octet-stream",
        });
    }
}

#! Custom InputStream that throws after N bytes
class ErrorAfterNBytesInputStream inherits InputStream {
    private {
        int remaining;
        int total;
    }

    constructor(int n) {
        remaining = n;
        total = n;
    }

    *binary read(int limit) {
        if (remaining <= 0) {
            throw "STREAM-ERROR", sprintf("intentional error after %d bytes", total);
        }
        int to_read = min(limit, remaining);
        remaining -= to_read;
        if (remaining <= 0) {
            # Return last bytes then next read will throw
            binary data = binary(strmul("E", to_read));
            remaining = -1;
            return data;
        }
        return binary(strmul("E", to_read));
    }

    int peek() {
        return remaining > 0 ? ord("E") : -1;
    }
}

#! Handler that returns a FileInputStream (pollable) body
class FileStreamHandler inherits AbstractHttpRequestHandler {
    private {
        string dir;
    }

    constructor(string dir) {
        self.dir = dir;
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        int size = 8192;
        *list<*string> m = (hdr.path =~ x/file-stream\/(\d+)/);
        if (m) {
            size = int(m[0]);
        }
        # Write a temp file and return a FileInputStream for it
        string path = dir + "/http2-stream-" + gettid() + ".dat";
        {
            FileOutputStream fos(path);
            # Write in chunks to avoid huge memory alloc
            string chunk = strmul("F", min(size, 4096));
            int written = 0;
            while (written < size) {
                int to_write = min(chunk.length(), size - written);
                if (to_write < chunk.length()) {
                    fos.write(binary(substr(chunk, 0, to_write)));
                } else {
                    fos.write(binary(chunk));
                }
                written += to_write;
            }
            fos.close();
        }
        return makeResponse(200, new FileInputStream(path), {
            "Content-Type": "application/octet-stream",
        });
    }
}

#! Handler that returns a stream that errors after N bytes
class ErrorStreamHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, new ErrorAfterNBytesInputStream(100), {
            "Content-Type": "application/octet-stream",
        });
    }
}

#! Non-I/O-thread-safe InputStream that records every TID that calls
#! read().  Used to verify the architectural rule: blocking reads on
#! non-pollable Qore-defined InputStreams MUST happen on a worker thread,
#! NEVER on the async I/O thread.
/** Qore-defined InputStream subclasses default to isIoThreadSafe()=false,
    so this stream exercises the server's materialization path.  We
    record all reader TIDs and assert none of them match the server's
    known I/O-controller thread TIDs.
*/
class TidRecordingInputStream inherits InputStream {
    public {
        Mutex m_lock();
        list<int> m_reader_tids();
        binary m_payload;
        bool m_done = False;
        int m_delay_ms = 0;
    }

    constructor(binary payload, int delay_ms = 0) {
        m_payload = payload;
        m_delay_ms = delay_ms;
    }

    *binary read(int limit) {
        {
            AutoLock al(m_lock);
            m_reader_tids += gettid();
        }
        if (m_done) {
            return NOTHING;
        }
        if (m_delay_ms > 0) {
            usleep(m_delay_ms * 1000);
        }
        m_done = True;
        return m_payload;
    }

    int peek() {
        return m_done ? -1 : (m_payload.size() > 0 ? m_payload[0] : -1);
    }

    list<int> getReaderTids() {
        AutoLock al(m_lock);
        return m_reader_tids;
    }
}

#! Handler that returns a TidRecordingInputStream so the test can verify
#! read() was called from the handler worker thread, not the I/O thread.
/** The stream is constructed inside handleRequest() so its thread
    affinity is set to the handler worker thread (not the main test
    thread).  The stream itself is exposed back to the test via a
    Counter-guarded handoff so the test can retrieve the reader-TID list
    after the response completes.
*/
class TidStreamHandler inherits AbstractHttpRequestHandler {
    public {
        Mutex m_lock();
        Counter m_done(1);
        TidRecordingInputStream m_stream;
        int m_handler_tid = 0;
        binary m_payload;
        int m_delay_ms;
    }

    constructor(binary payload, int delay_ms = 0) {
        m_payload = payload;
        m_delay_ms = delay_ms;
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        # Construct the stream inside the handler so its thread affinity
        # is the current worker thread — any read() on a different thread
        # would raise STREAM-THREAD-ERROR, surfacing an I/O-thread violation.
        TidRecordingInputStream local_stream(m_payload, m_delay_ms);
        {
            AutoLock al(m_lock);
            m_stream = local_stream;
            m_handler_tid = gettid();
        }
        return makeResponse(200, local_stream, {
            "Content-Type": "application/octet-stream",
        });
    }

    TidRecordingInputStream getStream() {
        AutoLock al(m_lock);
        return m_stream;
    }

    int getHandlerTid() {
        AutoLock al(m_lock);
        return m_handler_tid;
    }
}

#! AbstractStreamRequest subclass for the H2 connect+ CallbackInputStream
#! response path.  Mirrors the H3 ConnectStreamRequest in
#! HttpServerH3Streaming.qtest; the server-side code path differs
#! (submitHttp2StreamingResponseWithStream vs submitQuicStreamingResponseWithStream)
#! but the handler contract is identical.
class H2ConnectStreamRequest inherits AbstractStreamRequest {
    private {
        int chunk_count;
        int chunk_size;
        int emitted = 0;
    }

    constructor(HttpListenerInterface listener, AbstractHttpRequestHandler handler, Socket s,
            hash<auto> cx, hash<auto> hdr, auto body, int chunk_count, int chunk_size)
            : AbstractStreamRequest(listener, handler, s, cx, hdr, body) {
        self.chunk_count = chunk_count;
        self.chunk_size = chunk_size;
    }

    bool needsContentEncoding() {
        return False;
    }

    private hash<HttpHandlerResponseInfo> getResponseHeaderMessageImpl() {
        return <HttpHandlerResponseInfo>{
            "code": 200,
            "hdr": {
                "Content-Type": "application/connect+x",
                "Transfer-Encoding": "chunked",
            },
        };
    }

    private nothing recvImpl(hash<auto> v) {}

    private auto sendImpl() {
        if (emitted >= chunk_count) {
            return NOTHING;
        }
        int sz = chunk_size;
        binary header = <01>
            + binary(chr((sz >> 24) & 0xff))
            + binary(chr((sz >> 16) & 0xff))
            + binary(chr((sz >> 8) & 0xff))
            + binary(chr(sz & 0xff));
        binary frame = header + binary(strmul(chr(ord("A") + emitted), sz));
        emitted++;
        return frame;
    }
}

#! H2 handler wiring H2ConnectStreamRequest into the streaming pipeline.
class H2CallbackStreamResponseHandler inherits AbstractHttpRequestHandler {
    private {
        int chunk_count;
        int chunk_size;
    }

    constructor(int chunk_count = 3, int chunk_size = 1024)
            : AbstractHttpRequestHandler(NOTHING, True) {
        self.chunk_count = chunk_count;
        self.chunk_size = chunk_size;
    }

    private AbstractStreamRequest getStreamRequestImpl(HttpListenerInterface listener, Socket s,
            hash<auto> cx, hash<auto> hdr, *data body) {
        return new H2ConnectStreamRequest(listener, self, s, cx, hdr, body,
            chunk_count, chunk_size);
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(500, "unexpected for stream handler",
            {"Content-Type": "text/plain"});
    }
}

#! AbstractStreamRequest subclass for H2 true-bidi.  Reads request body
#! chunks via recvImpl and emits one length-prefixed uppercased frame
#! per received chunk via sendImpl.
class H2BidiInterleaveStreamRequest inherits AbstractStreamRequest {
    private {
        Queue m_recv_queue();
    }

    constructor(HttpListenerInterface listener, AbstractHttpRequestHandler handler, Socket s,
            hash<auto> cx, hash<auto> hdr, auto body)
            : AbstractStreamRequest(listener, handler, s, cx, hdr, body) {
    }

    bool needsContentEncoding() {
        return False;
    }

    private hash<HttpHandlerResponseInfo> getResponseHeaderMessageImpl() {
        return <HttpHandlerResponseInfo>{
            "code": 200,
            "hdr": {
                "Content-Type": "application/connect+bidi",
                "Transfer-Encoding": "chunked",
            },
        };
    }

    private nothing recvImpl(hash<auto> v) {
        if (!exists v.data || (v.hasKey("hdr") && !exists v.hdr)) {
            m_recv_queue.push(NOTHING);
            return;
        }
        m_recv_queue.push(v.data);
    }

    private auto sendImpl() {
        *binary chunk = m_recv_queue.get(30s);
        if (!exists chunk) {
            return NOTHING;
        }
        binary upper = binary();
        for (int i = 0; i < chunk.size(); ++i) {
            int c = chunk[i];
            if (c >= ord("a") && c <= ord("z")) {
                c -= 32;
            }
            upper += binary(chr(c));
        }
        int sz = upper.size();
        binary header = <02>
            + binary(chr((sz >> 24) & 0xff))
            + binary(chr((sz >> 16) & 0xff))
            + binary(chr((sz >> 8) & 0xff))
            + binary(chr(sz & 0xff));
        return header + upper;
    }
}

class H2BidiInterleaveHandler inherits AbstractHttpRequestHandler {
    constructor() : AbstractHttpRequestHandler(NOTHING, True) {}

    private AbstractStreamRequest getStreamRequestImpl(HttpListenerInterface listener, Socket s,
            hash<auto> cx, hash<auto> hdr, *data body) {
        return new H2BidiInterleaveStreamRequest(listener, self, s, cx, hdr, body);
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(500, "unexpected for stream handler",
            {"Content-Type": "text/plain"});
    }
}

