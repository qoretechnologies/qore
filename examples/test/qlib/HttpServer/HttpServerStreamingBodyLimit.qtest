Do+Sl1gfqlpgpszQaOMjR4M=
-----END PRIVATE KEY-----";
    }

    private {
        Logger logger;

        # server with a request body limit
        HttpServer server;
        # TLS listener with its own limit
        string listener_url;
        # TLS listener without its own limit
        string server_url;
        # plain HTTP listener with its own limit
        string plain_url;

        # server without any limit
        HttpServer unlimited_server;
        string unlimited_url;

        # the HTTP versions that can be negotiated
        hash<string, bool> versions;
    }

    constructor() : Test("HttpServerStreamingBodyLimitTest", "1.0") {
        addTestCase("HTTP/2 listener limit", \http2ListenerLimitTest());
        addTestCase("HTTP/2 server limit", \http2ServerLimitTest());
        addTestCase("HTTP/2 no limit", \http2NoLimitTest());
        addTestCase("HTTP/3 listener limit", \http3ListenerLimitTest());
        addTestCase("HTTP/3 server limit", \http3ServerLimitTest());
        addTestCase("HTTP/3 no limit", \http3NoLimitTest());
        addTestCase("buffered HTTP/1.1 request", \http1Test());
        addTestCase("setMaxRequestBodySize() applies to the next request", \setterTest());
        set_return_value(main());
    }

    globalSetUp() {
        logger = new Logger("streaming-body-limit-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }

        server = new HttpServer(<HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
            "max_request_body_size": ServerLimit,
        });
        server.setHandler("limit", "/limit", NOTHING, new LimitReportingHandler());
        listener_url = "https://localhost:" + addTlsListener(server, ListenerLimit);
        server_url = "https://localhost:" + addTlsListener(server);
        plain_url = "http://localhost:" + server.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "max_request_body_size": ListenerLimit,
        }).port;
        server.waitForAsyncIo();

        unlimited_server = new HttpServer(<HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        });
        unlimited_server.setHandler("limit", "/limit", NOTHING, new LimitReportingHandler());
        unlimited_url = "https://localhost:" + addTlsListener(unlimited_server);
        unlimited_server.waitForAsyncIo();

        foreach string version in ("2", "3") {
            HTTPClient c({"url": listener_url, "ssl_verify_cert": False, "http_version": version, "timeout": 30s});
            on_exit c.disconnect();
            try {
                c.connect();
            } catch (hash<ExceptionInfo> ex) {
                continue;
            }
            if (c.getHttpVersion() == "HTTP/" + version) {
                versions{version} = True;
            }
        }
    }

    globalTearDown() {
        delete server;
        delete unlimited_server;
    }

    private static int addTlsListener(HttpServer srv, *int limit) {
        hash<HttpListenerOptionInfo> opts = <HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        };
        if (limit) {
            opts.max_request_body_size = limit;
        }
        return srv.addListener(opts).port;
    }

    private checkVersion(string version) {
        if (!versions{version}) {
            testSkip(sprintf("HTTP/%s cannot be negotiated", version));
        }
    }

    # sends a PUT request and returns the response
    private hash<auto> put(string target, *string version, int size) {
        hash<auto> opts = {"url": target, "timeout": 30s, "ssl_verify_cert": False};
        if (version) {
            opts.http_version = version;
        }
        HTTPClient c(opts);
        on_exit c.disconnect();
        c.setErrorPassthru(True);
        hash<auto> resp = c.send(binary(strmul("x", size)), "PUT", "/limit", {"Content-Type": MimeTypeOctetStream});
        if (version) {
            assertEq("HTTP/" + version, c.getHttpVersion());
        }
        return resp;
    }

    # asserts that the handler receives the given limit in a streaming request and enforces it
    private assertStreamingLimit(string target, string version, int limit) {
        checkVersion(version);
        # a body within the limit is streamed to the handler in full
        int size = limit ?: ServerLimit * 4;
        hash<auto> resp = put(target, version, size);
        assertEq(200, resp.status_code, resp.body);
        assertEq(sprintf("limit=%d streaming=yes size=%d", limit, size), resp.body);
        # a request without a body
        resp = put(target, version, 0);
        assertEq(200, resp.status_code, resp.body);
        assertRegex(sprintf("^limit=%d streaming=(yes|no) size=0$", limit), resp.body);
        if (!limit) {
            return;
        }
        # an oversized body read as it arrives is rejected by the handler; the server alone limits only the data
        # buffered ahead of the handler
        try {
            resp = put(target, version, limit * 12);
            assertEq(413, resp.status_code, resp.body);
        } catch (hash<ExceptionInfo> ex) {
            # HTTP/3: the server may cancel the request stream after the response instead of reading the rest
            assertEq("3", version, sprintf("%s: %s", ex.err, ex.desc));
        }
    }

    http2ListenerLimitTest() {
        assertStreamingLimit(listener_url, "2", ListenerLimit);
    }

    http2ServerLimitTest() {
        assertStreamingLimit(server_url, "2", ServerLimit);
    }

    http2NoLimitTest() {
        assertStreamingLimit(unlimited_url, "2", 0);
    }

    http3ListenerLimitTest() {
        assertStreamingLimit(listener_url, "3", ListenerLimit);
    }

    http3ServerLimitTest() {
        assertStreamingLimit(server_url, "3", ServerLimit);
    }

    http3NoLimitTest() {
        assertStreamingLimit(unlimited_url, "3", 0);
    }

    http1Test() {
        # a buffered request also receives the limit
        hash<auto> resp = put(plain_url, NOTHING, 100);
        assertEq(200, resp.status_code, resp.body);
        assertEq(sprintf("limit=%d streaming=no size=100", ListenerLimit), resp.body);
        resp = put(server_url, "1.1", 100);
        assertEq(200, resp.status_code, resp.body);
        assertEq(sprintf("limit=%d streaming=no size=100", ServerLimit), resp.body);
        resp = put(unlimited_url, "1.1", 100);
        assertEq(200, resp.status_code, resp.body);
        assertEq("limit=0 streaming=no size=100", resp.body);
        # the server enforces the limit on a buffered body before the handler is called
        resp = put(plain_url, NOTHING, ListenerLimit + 1);
        assertEq(413, resp.status_code);
    }

    setterTest() {
        HttpServer srv(<HttpServerOptionInfo>{"logger": logger, "debug": True});
        on_exit delete srv;
        srv.setHandler("limit", "/limit", NOTHING, new LimitReportingHandler());
        string tls_url = "https://localhost:" + addTlsListener(srv);
        string own_url = "https://localhost:" + addTlsListener(srv, ListenerLimit);
        srv.waitForAsyncIo();

        list<string> test_versions = ("1.1",) + keys versions;
        foreach string version in (test_versions) {
            hash<auto> resp = put(tls_url, version, 10);
            assertRegex("^limit=0 ", resp.body, "HTTP/" + version);
        }
        srv.setMaxRequestBodySize(ChangedLimit);
        foreach string version in (test_versions) {
            hash<auto> resp = put(tls_url, version, 10);
            assertRegex(sprintf("^limit=%d ", ChangedLimit), resp.body, "HTTP/" + version);
            # a listener limit takes precedence
            resp = put(own_url, version, 10);
            assertRegex(sprintf("^limit=%d ", ListenerLimit), resp.body, "HTTP/" + version);
        }
        srv.setMaxRequestBodySize(0);
        foreach string version in (test_versions) {
            hash<auto> resp = put(tls_url, version, 10);
            assertRegex("^limit=0 ", resp.body, "HTTP/" + version);
        }
    }
}
