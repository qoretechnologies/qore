#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
#
# The response headers of HttpServer, exactly: their names with their case, their values (the Content-Type with its
# charset) and their order, as sent on the wire by synchronous and asynchronous HTTP/1.1 listeners and over HTTP/2.
# The cases cover a response whose Content-Type the server sets, handler headers with canonical and other-case names
# (which replace the server's configured headers and the managed fields), the server's configured headers, the
# response to a HEAD request, error responses returned by a handler, the error response to an invalid handler response,
# the response of the server when no handler matches, and responses that close the connection; also configured
# headers that a subclass changes after the server's constructor (with canonical names and with names of managed
# fields in another case), configured headers changed while the server serves requests, handler headers in another
# case that replace such configured headers or the Alt-Svc field of a listener (#5966), and configured headers whose
# values all have one type.  The order of the header fields is that of the hash the server builds, and the tests pin it
# so that it does not change (#5759): the expected values were taken from the server before #5759, except those of the
# #5966 cases, where a handler's field replaces a configured field in another case: the configured field is removed and
# the handler's field is in the place it has in the handler's headers, as when the headers are merged.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires Mime
%requires Logger
%requires HttpServerUtil
%requires HttpServer
%requires ../../TestCertificates.qm

%exec-class HttpServerReplyHeadersTest

class ReplyHeadersHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        switch ((hdr.path =~ x/^h\/(.*)$/)[0]) {
            # no headers: the server sets the Content-Type
            case "default":
                return makeResponse(200, "<p>ok</p>");
            # binary data: application/octet-stream without a charset
            case "binary":
                return makeResponse(200, <00e4>);
            # canonical names, a Content-Type without a charset, and a configured header replaced
            case "typed":
                return makeResponse(200, "ok", {"Content-Type": MimeTypeText, "X-Handler": "h", "X-Instance": "h"});
            # managed fields and a configured header with names in another case
            case "lower":
                return makeResponse(200, "ok", {
                    "content-type": MimeTypeText + ";charset=utf-8",
                    "x-handler": "h",
                    "server": "custom-server",
                    "x-powered-by": "handler",
                    "x-instance": "h",
                });
            # the headers that the servers of the subclasses add, with names in another case
            case "replace-lower":
                return makeResponse(200, "ok", {
                    "Content-Type": MimeTypeText,
                    "x-frame-options": "DENY",
                    "x-late": "h",
                });
            # the Alt-Svc field of the listener with a name in another case
            case "alt-svc":
                return makeResponse(200, "ok", {"Content-Type": MimeTypeText, "alt-svc": "clear"});
            # a handler that closes the connection
            case "close":
                hash<HttpResponseInfo> rv = makeResponse(200, "ok", {"Content-Type": MimeTypeText});
                rv.close = True;
                return rv;
            # a handler that sends its own Connection header
            case "connection":
                return makeResponse(200, "ok", {"Content-Type": MimeTypeText, "Connection": "close"});
            # an empty body: 204 without a Content-Type
            case "empty":
                return makeResponse(200, "", {"X-Handler": "h"});
            # error responses
            case "error":
                return makeResponse(404, "missing", {"X-Handler": "h"});
            case "error-typed":
                return makeResponse(409, "conflict", {"content-type": MimeTypeText, "X-Handler": "h"});
            case "error-default":
                return <HttpResponseInfo>{"code": 400};
            case "redirect":
                return makeResponse(302, "", {"Location": "/default"});
            # an invalid response: 500
            case "invalid":
                return <HttpResponseInfo>{"code": 999, "body": "x"};
        }
        return makeResponse(404, "not found");
    }
}

#! a server whose subclass changes the configured headers after the server's constructor, with canonical names
class CanonicalSubclassServer inherits HttpServer {
    constructor(hash<HttpServerOptionInfo> opts) : HttpServer(opts) {
        hdr += {"Server": "sub-server", "X-Frame-Options": "SAMEORIGIN"};
        remove hdr."X-Powered-By";
    }
}

#! a server whose subclass changes the configured headers after the server's constructor, with names of fields
#! managed by the server in another case
class LowerCaseSubclassServer inherits HttpServer {
    constructor(hash<HttpServerOptionInfo> opts) : HttpServer(opts) {
        hdr += {"server": "sub-server", "x-frame-options": "SAMEORIGIN"};
    }
}

#! a server whose configured headers are changed while it serves requests
class ChangingSubclassServer inherits HttpServer {
    constructor(hash<HttpServerOptionInfo> opts) : HttpServer(opts) {
    }

    setConfiguredHeader(string name, string value) {
        hdr{name} = value;
    }

    setConfiguredHeaders(hash<auto> h) {
        hdr = h;
    }
}

