                "HEAD /h/default": (
                    "HTTP/1.1 200 OK",
                    "X-Powered-By: Qore/<version>",
                    "Server: sub-server",
                    "x-frame-options: SAMEORIGIN",
                    "Content-Type: text/html;charset=utf-8",
                    "Content-Length: 9",
                    "Date: <date>",
                    "Connection: Keep-Alive",
                ),
            },
        };
        # the header lines of the responses before and after the configured headers are changed
        const ExpectedChanged = {
            "before": {
                "GET /h/default": (
                    "HTTP/1.1 200 OK",
                    "X-Powered-By: Qore/<version>",
                    "Date: <date>",
                    "Connection: Keep-Alive",
                    "Server: Qore-HTTP-Server/<server-version>",
                    "Content-Type: text/html;charset=utf-8",
                    "Content-Length: 9",
                ),
            },
            "after": {
                "GET /h/default": (
                    "HTTP/1.1 200 OK",
                    "X-Powered-By: Qore/<version>",
                    "Server: late-server",
                    "X-Late: 1",
                    "Date: <date>",
                    "Connection: Keep-Alive",
                    "Content-Type: text/html;charset=utf-8",
                    "Content-Length: 9",
                ),
                "GET /h/typed": (
                    "HTTP/1.1 200 OK",
                    "X-Powered-By: Qore/<version>",
                    "Server: late-server",
                    "X-Late: 1",
                    "Content-Type: text/plain;charset=utf-8",
                    "X-Handler: h",
                    "X-Instance: h",
                    "Date: <date>",
                    "Connection: Keep-Alive",
                    "Content-Length: 2",
                ),
                "GET /h/lower": (
                    "HTTP/1.1 200 OK",
                    "X-Late: 1",
                    "Content-Type: text/plain;charset=utf-8",
                    "x-handler: h",
                    "Server: custom-server",
                    "x-powered-by: handler",
                    "x-instance: h",
                    "Date: <date>",
                    "Connection: Keep-Alive",
                    "Content-Length: 2",
                ),
                "GET /h/error": (
                    "HTTP/1.1 404 Not Found",
                    "X-Powered-By: Qore/<version>",
                    "Server: late-server",
                    "X-Late: 1",
                    "X-Handler: h",
                    "Date: <date>",
                    "Connection: Keep-Alive",
                    "Content-Type: text/html;charset=utf-8",
                    "Content-Length: 7",
                ),
                "GET /none": (
                    "HTTP/1.1 501 Not Implemented",
                    "X-Powered-By: Qore/<version>",
                    "Server: late-server",
                    "X-Late: 1",
                    "Date: <date>",
                    "Connection: Keep-Alive",
                    "Content-Type: text/html;charset=utf-8",
                    "Content-Length: <n>",
                ),
                "HEAD /h/default": (
                    "HTTP/1.1 200 OK",
                    "X-Powered-By: Qore/<version>",
                    "Server: late-server",
                    "X-Late: 1",
                    "Content-Type: text/html;charset=utf-8",
                    "Content-Length: 9",
                    "Date: <date>",
                    "Connection: Keep-Alive",
                ),
            },
        };
        # the header lines of the responses of a server whose configured headers are a hash<string, int>
        const ExpectedNarrowed = {
            "GET /h/default": (
                "HTTP/1.1 200 OK",
                "X-Instance: 1",
                "X-Count: 2",
                "Date: <date>",
                "Connection: Keep-Alive",
                "Server: Qore-HTTP-Server/<server-version>",
                "Content-Type: text/html;charset=utf-8",
                "Content-Length: 9",
            ),
            "GET /h/typed": (
                "HTTP/1.1 200 OK",
                "X-Count: 2",
                "Content-Type: text/plain;charset=utf-8",
                "X-Handler: h",
                "X-Instance: h",
                "Date: <date>",
                "Connection: Keep-Alive",
                "Server: Qore-HTTP-Server/<server-version>",
                "Content-Length: 2",
            ),
            "GET /h/lower": (
                "HTTP/1.1 200 OK",
                "X-Count: 2",
                "Content-Type: text/plain;charset=utf-8",
                "x-handler: h",
                "Server: custom-server",
                "x-powered-by: handler",
                "x-instance: h",
                "Date: <date>",
                "Connection: Keep-Alive",
                "Content-Length: 2",
            ),
            "GET /h/error": (
                "HTTP/1.1 404 Not Found",
                "X-Instance: 1",
                "X-Count: 2",
                "X-Handler: h",
                "Date: <date>",
                "Connection: Keep-Alive",
                "Server: Qore-HTTP-Server/<server-version>",
                "Content-Type: text/html;charset=utf-8",
                "Content-Length: 7",
            ),
            "GET /none": (
                "HTTP/1.1 501 Not Implemented",
                "X-Instance: 1",
                "X-Count: 2",
                "Date: <date>",
                "Connection: Keep-Alive",
                "Server: Qore-HTTP-Server/<server-version>",
                "Content-Type: text/html;charset=utf-8",
                "Content-Length: <n>",
            ),
            "HEAD /h/default": (
                "HTTP/1.1 200 OK",
                "X-Instance: 1",
                "X-Count: 2",
                "Content-Type: text/html;charset=utf-8",
                "Content-Length: 9",
                "Date: <date>",
                "Connection: Keep-Alive",
                "Server: Qore-HTTP-Server/<server-version>",
            ),
        };

        HttpServer server;
        int sync_port;
        int async_port;
        int h2_port;
    }

    constructor() : Test("HttpServerReplyHeadersTest", "1.0") {
        addTestCase("HTTP/1.1 async listener", \asyncH1Test());
        addTestCase("HTTP/1.1 sync listener", \syncH1Test());
        addTestCase("HTTP/1.1 TLS listener", \tlsH1Test());
        addTestCase("HTTP/1.1 keep-alive", \keepAliveTest());
        addTestCase("HTTP/2", \h2Test());
        addTestCase("configured headers of a subclass", \subclassTest());
        addTestCase("handler headers replace the configured headers of a subclass", \subclassReplaceTest());
        addTestCase("configured headers changed while serving", \changedHeadersTest());
        addTestCase("configured headers with values of one type", \narrowedHeadersTest());
        set_return_value(main());
    }

    globalSetUp() {
        # the configured headers have a canonical name and a name of a field that is not configured otherwise
        server = new HttpServer(<HttpServerOptionInfo>{
            "logger": new Logger("server", LoggerLevel::getLevelError()),
            "hdr": {"X-Powered-By": "Qore/" + Qore::VersionString, "X-Instance": "srv"},
        });
        ReplyHeadersHandler handler();
        server.setHandler("h", "^h/", NOTHING, handler);
        sync_port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0, "sync": True}).port;
        async_port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        h2_port = server.addListener(<HttpListenerOptionInfo>{
            "node": "127.0.0.1",
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        }).port;
        server.waitForAsyncIo();
    }

    globalTearDown() {
        delete server;
    }

    asyncH1Test() {
        checkH1(async_port, "async");
    }

    syncH1Test() {
        checkH1(sync_port, "sync");
    }

    # the TLS listener has the Alt-Svc header of its HTTP/3 listener
    tlsH1Test() {
        checkH1(h2_port, "tls", True);
        # a handler's Alt-Svc field in another case replaces the listener's and takes the place of the handler's field
        Socket s();
        s.connect(sprintf("127.0.0.1:%d", h2_port), 30s);
        on_exit s.close();
        s.upgradeClientToSSL(30s);
        list<string> l = getHeaderLines(s, "GET /h/alt-svc", "tls alt-svc");
        assertEq(("Alt-Svc: clear",), (select l, $1 =~ /^alt-svc:/i), "tls alt-svc");
        assertEq(("HTTP/1.1 200 OK", "X-Powered-By: Qore/<version>", "X-Instance: srv",
            "Content-Type: text/plain;charset=utf-8", "Alt-Svc: clear"), l[0..4], "tls alt-svc order");
    }

    # several requests on one connection have the same headers as the first one
    keepAliveTest() {
        foreach int port in (async_port, sync_port) {
            Socket s();
            s.connect(sprintf("127.0.0.1:%d", port), 30s);
            on_exit s.close();
            for (int i = 0; i < 3; ++i) {
                foreach string req in ("GET /h/default", "GET /h/typed", "GET /h/lower", "GET /h/error") {
                    string label = sprintf("%d %s #%d", port, req, i);
                    list<string> l = getHeaderLines(s, req, label);
                    assertEq(ExpectedH1{req}, l, label);
                }
            }
        }
    }

    h2Test() {
        HTTPClient hc({
            "url": sprintf("https://127.0.0.1:%d", h2_port),
            "http_version": "2.0",
            "ssl_verify_cert": False,
            "timeout": 30s,
            "error_passthru": True,
        });
        hc.setHttp3Mode("disabled");
        for (int i = 0; i < 2; ++i) {
            foreach hash<auto> e in (ExpectedH2.pairIterator()) {
                (string method, string path) = e.key.split(" ");
                string label = sprintf("h2 %s #%d", e.key, i);
                hash<auto> info;
                hc.send(NOTHING, method, path, NOTHING, False, \info);
                list<string> lines = map sprintf("%s: %s", $1.key, $1.value), info."response-headers".pairIterator(),
                    $1.key !~ /^:/ && !inlist($1.key, ("status_code", "status_message", "http_version", "body"));
                assertEq(e.value, normalize(lines, label, path), label);
            }
        }
        assertTrue(hc.isHttp2Active());
    }

    # the requests checked with the servers of the subclasses
    const SubclassRequests = ("GET /h/default", "GET /h/typed", "GET /h/lower", "GET /h/error", "GET /none",
        "HEAD /h/default");

    # serves the requests with the given server and returns the header lines of the responses
    private hash<string, list<string>> serve(HttpServer srv, string label, list<string> reqs = SubclassRequests) {
        srv.setHandler("h", "^h/", NOTHING, new ReplyHeadersHandler());
        int port = srv.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        srv.waitForAsyncIo();
        hash<string, list<string>> rv = {};
        foreach string req in (reqs) {
            Socket s();
            s.connect(sprintf("127.0.0.1:%d", port), 30s);
            on_exit s.close();
            rv{req} = getHeaderLines(s, req, label + " " + req);
        }
        return rv;
    }

    private checkServed(hash<auto> expected, hash<string, list<string>> actual, string label) {
        foreach hash<auto> e in (expected.pairIterator()) {
            assertEq(e.value, actual{e.key}, label + " " + e.key);
        }
        assertEq(keys expected, keys actual, label);
    }

    subclassTest() {
        foreach string label in ("canonical", "lower-case") {
            HttpServer srv = label == "canonical"
                ? new CanonicalSubclassServer(<HttpServerOptionInfo>{
                    "logger": new Logger("server", LoggerLevel::getLevelError()),
                })
                : new LowerCaseSubclassServer(<HttpServerOptionInfo>{
                    "logger": new Logger("server", LoggerLevel::getLevelError()),
                });
            on_exit delete srv;
            checkServed(ExpectedSubclass{label}, serve(srv, label), label);
        }
    }

    # a handler's header replaces a configured header of the same name in another case when the configured headers
    # were added by a subclass after the server's constructor or changed while the server serves requests (#5966)
    subclassReplaceTest() {
        {
            CanonicalSubclassServer srv(<HttpServerOptionInfo>{
                "logger": new Logger("server", LoggerLevel::getLevelError()),
            });
            on_exit delete srv;
            list<string> l = serve(srv, "canonical", ("GET /h/replace-lower",))."GET /h/replace-lower";
            assertEq(("x-frame-options: DENY",), (select l, $1 =~ /^x-frame-options:/i), "canonical subclass");
            assertEq((
                "HTTP/1.1 200 OK",
                "Server: sub-server",
                "Content-Type: text/plain;charset=utf-8",
                "x-frame-options: DENY",
                "x-late: h",
                "Date: <date>",
                "Connection: Keep-Alive",
                "Content-Length: 2",
            ), l, "canonical subclass order");
        }
        {
            ChangingSubclassServer srv(<HttpServerOptionInfo>{
                "logger": new Logger("server", LoggerLevel::getLevelError()),
            });
            on_exit delete srv;
            list<string> l = serve(srv, "before change", ("GET /h/replace-lower",))."GET /h/replace-lower";
            assertEq(("x-late: h",), (select l, $1 =~ /^x-late:/i), "before change");
            # configured headers added while the server serves requests
            int port = srv.getListeners().firstValue().port;
            foreach string name in ("X-Late", "X-Frame-Options") {
                srv.setConfiguredHeader(name, "configured");
                Socket s();
                s.connect(sprintf("127.0.0.1:%d", port), 30s);
                on_exit s.close();
                l = getHeaderLines(s, "GET /h/replace-lower", "after " + name);
                assertEq(("x-late: h",), (select l, $1 =~ /^x-late:/i), "x-late after " + name);
                assertEq(("x-frame-options: DENY",), (select l, $1 =~ /^x-frame-options:/i),
                    "x-frame-options after " + name);
            }
            # the configured headers in another order are sent in that order, and a configured header that is
            # removed is no longer sent, nor replaced
            code get_lines = list<string> sub (string label) {
                Socket s();
                s.connect(sprintf("127.0.0.1:%d", port), 30s);
                on_exit s.close();
                return getHeaderLines(s, "GET /h/default", label);
            };
            srv.setConfiguredHeaders({"X-A": "a", "X-B": "b"});
            assertEq(("X-A: a", "X-B: b"), (select get_lines("a b"), $1 =~ /^x-[ab]:/i), "a b");
            srv.setConfiguredHeaders({"X-B": "b", "X-A": "a"});
            assertEq(("X-B: b", "X-A: a"), (select get_lines("b a"), $1 =~ /^x-[ab]:/i), "b a");
            srv.setConfiguredHeaders({"X-B": "b"});
            assertEq(("X-B: b",), (select get_lines("b"), $1 =~ /^x-[ab]:/i), "b");
            Socket s();
            s.connect(sprintf("127.0.0.1:%d", port), 30s);
            on_exit s.close();
            l = getHeaderLines(s, "GET /h/replace-lower", "removed");
            assertEq(("x-frame-options: DENY",), (select l, $1 =~ /^x-frame-options:/i), "x-frame-options removed");
            assertEq(("x-late: h",), (select l, $1 =~ /^x-late:/i), "x-late removed");
        }
    }

    changedHeadersTest() {
        ChangingSubclassServer srv(<HttpServerOptionInfo>{"logger": new Logger("server", LoggerLevel::getLevelError())});
        on_exit delete srv;
        checkServed(ExpectedChanged.before, serve(srv, "before", ("GET /h/default",)), "before");
        # requests after the change have the changed headers: a field managed by the server in another case, and
        # another one
        srv.setConfiguredHeader("server", "late-server");
        srv.setConfiguredHeader("X-Late", "1");
        hash<string, list<string>> actual;
        int port = srv.getListeners().firstValue().port;
        foreach string req in (SubclassRequests) {
            Socket s();
            s.connect(sprintf("127.0.0.1:%d", port), 30s);
            on_exit s.close();
            actual{req} = getHeaderLines(s, req, "after " + req);
        }
        checkServed(ExpectedChanged.after, actual, "after");
    }

    narrowedHeadersTest() {
        # the configured headers are a hash<string, int>
        HttpServer srv(<HttpServerOptionInfo>{
            "logger": new Logger("server", LoggerLevel::getLevelError()),
            "hdr": {"X-Instance": 1, "X-Count": 2},
        });
        on_exit delete srv;
        checkServed(ExpectedNarrowed, serve(srv, "narrowed"), "narrowed");
    }

    private checkH1(int port, string label_prefix, bool tls = False) {
        foreach hash<auto> e in (ExpectedH1.pairIterator()) {
            string label = sprintf("%s %s", label_prefix, e.key);
            Socket s();
            s.connect(sprintf("127.0.0.1:%d", port), 30s);
            on_exit s.close();
            if (tls) {
                s.upgradeClientToSSL(30s);
            }
            list<string> l = getHeaderLines(s, e.key, label);
            assertEq(tls ? ExpectedH1Tls{e.key} : e.value, l, label);
        }
    }

    # sends the request and returns the header lines of the response, normalized; the message body is read
    private list<string> getHeaderLines(Socket s, string req, string label) {
        (string method, string path) = req.split(" ");
        s.send(sprintf("%s %s HTTP/1.1\r\nHost: localhost\r\n\r\n", method, path));
        string data = "";
        int end;
        while ((end = data.find("\r\n\r\n")) < 0) {
            data += s.recv(0, 30s);
        }
        list<string> lines = data.substr(0, end).split("\r\n");
        string rest = data.substr(end + 4);
        # read the message body, so that the next response on the connection starts with its status line
        *string cl;
        foreach string line in (lines) {
            if (*list<*string> m = (line =~ x/^Content-Length: ([0-9]+)$/i)) {
                cl = m[0];
            }
        }
        if (method != "HEAD" && cl) {
            int len = cl.toInt();
            while (rest.size() < len) {
                rest += s.recv(0, 30s);
            }
        }
        return normalize(lines, label, path);
    }

    # the length of a message that the server generates (an error message with the response of a handler, or an
    # HTML page) is not compared, as it changes with the text
    const GeneratedMessagePaths = {"/h/invalid": True, "/none": True, "/h/error-default": True};

    private list<string> normalize(list<string> lines, string label, string path) {
        string server_version = HttpServer::HttpServerString;
        lines = map normalizeLine($1, server_version, label), lines;
        if (GeneratedMessagePaths{path}) {
            lines = map regex_subst($1, "^(content-length): [0-9]+$", "$1: <n>", RE_Caseless), lines;
        }
        return lines;
    }

    private string normalizeLine(string line, string server_string, string label) {
        if (*list<*string> m = (line =~ x/^(date): (.*)$/i)) {
            assertRegex(DateRegex, m[1], label);
            return m[0] + ": <date>";
        }
        line = regex_subst(line, "^(alt-svc: h3=\":)[0-9]+", "$1<port>", RE_Caseless);
        line = replace(line, server_string, "Qore-HTTP-Server/<server-version>");
        return replace(line, "Qore/" + Qore::VersionString, "Qore/<version>");
    }
}
