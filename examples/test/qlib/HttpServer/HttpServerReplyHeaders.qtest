        const DateRegex = "^[A-Z][a-z]{2}, [0-9]{2} [A-Z][a-z]{2} [0-9]{4} [0-9]{2}:[0-9]{2}:[0-9]{2} GMT$";

        # request (method path) -> the header lines of the HTTP/1.1 response in the order sent; "<date>" stands for
