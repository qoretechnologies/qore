%exec-class HttpServerTest

# we explicitly test deprecated behavior
%disable-warning deprecated

class AltHandler inherits AbstractHttpRequestHandler {
    hash handleRequest(hash cx, hash hdr, *data body) {
        return makeResponse(201, "a1, " + hdr.method + ", " + hdr.path + ", " + cx.raw_path);
    }
}

class SimpleStringHandler inherits AbstractHttpRequestHandler {
    private { string mString; }
    constructor (string str) { mString = str; }
    hash handleRequest(hash cx, hash hdr, *data body) {
        return makeResponse(200, mString);
    }
}

class ReqHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        string rpath = hdr.path;
        if (rpath =~ /^test400\//) {
            return make400("test400");
        } else if (rpath =~ /^test500\//) {
            return AbstractHttpRequestHandler::makeResponse(500, <74657374>);
        } else if (rpath =~ /^test501\//) {
            return make501("test501");
        } else if (rpath =~ /^nonexistingcode/) {
            return makeResponse(723, "test");
        } else if (rpath =~ /^test102\//) {
            return makeResponse(102, "test");
        } else if (rpath =~ /^test204\//) {
            return makeResponse(204, "test");
        } else if (rpath =~ /^test304\//) {
            return makeResponse(304, "test");
        } else if (rpath =~ /^test200nobody\//) {
            return <HttpResponseInfo>{"code": 200};
        } else if (rpath =~ /^test200empty\//) {
            return makeResponse(200, "");
        } else if (rpath =~ /^test400close\//) {
            return makeResponse(400, new StringInputStream("test"), {"Connection": "close"});
        } else if (rpath =~ /^gzip-plain\//) {
            string msg = "gzip-ok";
            binary gz = AbstractHttpRequestHandler::encodeBody("gzip", msg);
            return makeResponse(200, gz, {
                "Content-Type": "text/plain; charset=utf-8",
                "Content-Encoding": "gzip",
            });
        } else if (rpath =~ /^gzip-chunked\//) {
            string msg = "gzip-chunked";
            binary gz = AbstractHttpRequestHandler::encodeBody("gzip", msg);
            return makeResponse(200, new BinaryInputStream(gz), {
                "Content-Type": "text/plain; charset=utf-8",
                "Content-Encoding": "gzip",
            });
        } else if (rpath =~ /^fileupload/) {
            string boundary = (hdr."_qore_orig_content_type" =~ x/boundary="?(.+)"?/i)[0];
            hash<MessageInfo> h = MultiPartMessage::parseBody(boundary, body, True);
            #printf("h: %N\n", h);
            return makeResponse(200, new BinaryInputStream(h.part[1].body), {"Content-Type": h.part[1].hdr."content-type"});
        } else if (*list<*string> m = (rpath =~ x/largeresponse\/(\d+)/)) {
            # Return a response of specified size for testing large HTTP/2 transfers
            int size = int(m[0]);
            string data = strmul("X", size);
            return makeResponse(200, data, {"Content-Type": "text/plain"});
        } else if (rpath =~ /^echo-body/) {
            # Echo back the request body for testing large POST bodies
            return makeResponse(200, body, {"Content-Type": "application/octet-stream"});
        }

        if (hdr.method == "POST") {
            return makeResponse(200, "POST, " + body + ", " + rpath + ", " + cx.raw_path);
        } else {
            return makeResponse(200, hdr.method + ", " + rpath + ", " + cx.raw_path);
        }
    }
}

class SlowHandler inherits AbstractHttpRequestHandler {
    private {
        Queue started;
        date delay;
    }

    constructor(Queue started, date delay) {
        self.started = started;
        self.delay = delay;
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        started.push(True);
        sleep(delay);
        return makeResponse(200, "OK");
    }
}

# WebSocket connection for async mode tests
class TestWsConnection inherits WebSocketConnection {
    constructor(WebSocketHandler handler) : WebSocketConnection(handler) {
    }

    gotMessage(string msg) {
        send("ECHO:" + msg);
    }
}

# WebSocket handler for async mode tests
class TestWsHandler inherits WebSocketHandler {
    constructor(*hash<auto> opts) : WebSocketHandler(NOTHING, opts) {
    }

    WebSocketConnection getConnectionImpl(hash<auto> cx, hash<auto> hdr, string cid) {
        return new TestWsConnection(self);
    }
}

# WebSocket handler with token authentication for testing 401 rejection
class AuthenticatingWsHandler inherits WebSocketHandler {
    public {
        const ValidToken = "valid-test-token";
    }

    constructor(*hash<auto> opts) : WebSocketHandler(NOTHING, opts) {
    }

    # Authenticate request - check for valid token in Authorization header
    *hash<HttpResponseInfo> authenticateRequest(HttpListenerInterface listener, hash<auto> hdr,
            reference<hash<auto>> cx) {
        # Check for token in Authorization header (Bearer token)
        *string auth = hdr.authorization;
        *string token;
        if (auth && auth.lwr().startsWith("bearer ")) {
            token = auth.substr(7);
        }
        if (!token || token != ValidToken) {
            return <HttpResponseInfo>{
                "code": 401,
                "body": "Unauthorized: Invalid or missing token",
            };
        }
        return NOTHING;  # Authentication successful
    }

    WebSocketConnection getConnectionImpl(hash<auto> cx, hash<auto> hdr, string cid) {
        return new TestWsConnection(self);
    }
}

class ThrowOnceListener inherits HttpListener {
    private {
        bool throw_next = True;
    }

    constructor(HttpServer server, code<nothing(...)> handleRequest, int id, Sequence ss,
            *hash<HttpListenerOptionInfo> opts) : HttpListener(server, handleRequest, id, ss, opts) {
    }

    hash<auto> getContextTemplate(hash<auto> info) {
        if (throw_next) {
            throw_next = False;
            throw "TEST-LISTENER-ERROR", "getContextTemplate failure";
        }
        return HttpListener::getContextTemplate(info);
    }
}

class ThrowOnceServer inherits HttpServer {
    constructor(hash<HttpServerOptionInfo> opts) : HttpServer(opts) {
    }

    private HttpListener getListener(HttpServer server, int id, hash<HttpListenerOptionInfo> info) {
        return new ThrowOnceListener(server, \handleRequest(), id, seqSessions, info);
    }
}

