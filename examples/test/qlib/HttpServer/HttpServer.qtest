    asyncModeInlineHandlerTest() {
        # Use a small, fixed handler thread pool so we can exhaust it
        int pool_size = 2;
        Logger logger("async-inline-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }
        hash<HttpServerOptionInfo> opts = <HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
            "max_handler_threads": pool_size,
        };
        HttpServer server(opts);
        on_exit server.stop();

        # Register an inline handler at /inline
        InlineTestHandler inline_handler();
        server.setHandler("inline-handler", "/inline", MimeTypeText, inline_handler);

        # Register a regular (non-inline) handler at /regular
        SimpleStringHandler regular_handler("regular-response");
        server.setHandler("regular-handler", "/regular", MimeTypeText, regular_handler);

        # Register a slow handler to exhaust the thread pool
        Queue slow_started();
        Counter slow_done(pool_size);
        SlowHandler slow_handler(slow_started, 10s);
        server.setHandler("slow-handler", "/slow", MimeTypeHtml, slow_handler);
        server.setDefaultHandler("slow-handler", slow_handler);

        int test_port = server.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        assertTrue(server.waitForAsyncIo(5s), "async I/O should be ready");

        # Test 1: Basic inline handler response
        {
            HTTPClient client({"url": "http://localhost:" + test_port, "timeout": 5s});
            client.connect();
            on_exit client.disconnect();
            hash<auto> resp = client.send(NOTHING, "GET", "/inline");
            assertEq(200, resp.status_code, "inline handler status code");
            assertEq("inline-ok", resp.body, "inline handler body");
            assertEq("inline-value", resp."x-inline-header", "inline handler custom header");
        }

        # Test 2: Inline handler works on keep-alive connections
        {
            HTTPClient client({"url": "http://localhost:" + test_port, "timeout": 5s});
            client.connect();
            on_exit client.disconnect();
            # First request
            hash<auto> resp1 = client.send(NOTHING, "GET", "/inline");
            assertEq(200, resp1.status_code, "inline keep-alive first request");
            assertEq("inline-ok", resp1.body, "inline keep-alive first body");
            # Second request on same connection (keep-alive)
            hash<auto> resp2 = client.send(NOTHING, "GET", "/inline");
            assertEq(200, resp2.status_code, "inline keep-alive second request");
            assertEq("inline-ok", resp2.body, "inline keep-alive second body");
        }

        # Test 3: Non-inline handler still works alongside inline handler
        {
            HTTPClient client({"url": "http://localhost:" + test_port, "timeout": 5s});
            client.connect();
            on_exit client.disconnect();
            hash<auto> resp = client.send(NOTHING, "GET", "/regular");
            assertEq(200, resp.status_code, "regular handler still works");
            assertEq("regular-response", resp.body, "regular handler body");
        }

        # Test 4: Inline handler works when thread pool is exhausted
        # This is the key proof that inline handlers bypass the pool.
        # We exhaust the pool with slow requests, then verify the inline
        # handler still responds.
        {
            # Exhaust the handler thread pool with slow requests
            for (int i = 0; i < pool_size; i++) {
                background sub () {
                    on_exit slow_done.dec();
                    try {
                        HTTPClient client({
                            "url": "http://localhost:" + test_port,
                            "timeout": 15s,
                        });
                        client.connect();
                        client.get("/slow");
                        client.disconnect();
                    } catch () {
                        # Ignore errors on shutdown
                    }
                }();
            }

            # Wait for all slow handlers to start (proves pool is fully occupied)
            for (int i = 0; i < pool_size; i++) {
                auto val = slow_started.get(5s);
                assertTrue(val != NOTHING, "slow handler " + string(i) + " started");
            }

            # Now the thread pool is fully occupied. Inline handler should still work
            # because it runs on the I/O thread, not the pool.
            HTTPClient inline_client({
                "url": "http://localhost:" + test_port,
                "timeout": 5s,
            });
            inline_client.connect();
            on_exit inline_client.disconnect();
            hash<auto> resp = inline_client.send(NOTHING, "GET", "/inline");
            assertEq(200, resp.status_code, "inline handler works with exhausted pool");
            assertEq("inline-ok", resp.body, "inline handler body with exhausted pool");
        }

        # Wait for the background slow requests to finish before teardown. Otherwise the
        # test races server.stop() against in-flight handler threads and can wedge CI.
        assertEq(0, slow_done.waitForZero(15s), "slow requests should finish before teardown");
    }

    #! Verifies that requests with a body fall back to the thread pool even when
    #! the handler supports inline processing, and that keep-alive stays in sync.
    asyncModeInlineBodyTest() {
        Logger logger("async-inline-body-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }
        hash<HttpServerOptionInfo> opts = <HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        };
        HttpServer server(opts);
        on_exit server.stop();

        InlineTestHandler inline_handler();
        server.setHandler("inline-handler", "/inline", MimeTypeText, inline_handler);

        int test_port = server.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        assertTrue(server.waitForAsyncIo(5s), "async I/O should be ready");

        HTTPClient client({"url": "http://localhost:" + test_port, "timeout": 5s});
        client.connect();
        on_exit client.disconnect();

        # Send a POST with a body to the inline handler.  The framework must
        # fall back to the thread-pool path (processNativeRequest) which reads
        # the body, so the next header parse on the same keep-alive connection
        # is not corrupted.
        hash<auto> resp1 = client.send("hello body", "POST", "/inline",
            {"Content-Type": "text/plain"});
        # POST with body goes through the normal (non-inline) handleRequest()
        # which returns "non-inline-response"
        assertEq(200, resp1.status_code, "POST with body status");
        assertEq("non-inline-response", resp1.body, "POST with body falls back to full path");

        # Second request on the same keep-alive connection must succeed —
        # proves the body bytes were consumed and the socket is in sync.
        hash<auto> resp2 = client.send(NOTHING, "GET", "/inline");
        assertEq(200, resp2.status_code, "GET after POST status");
        assertEq("inline-ok", resp2.body, "keep-alive intact after body request");
    }

    #! Verifies HTTP/2 keep-alive behaviour after the do_close refactor
    #! (consolidated lock scopes in handleHttp2RequestResult).
    asyncModeHttp2KeepAliveTest() {
        # Create a dedicated async-mode HTTPS server for this test
        Logger logger("async-h2-keepalive-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }
        hash<HttpServerOptionInfo> opts = <HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        };
        HttpServer server(opts);
        on_exit server.stop();

        SimpleStringHandler handler("h2-ok");
        server.setHandler("h2-handler", "/h2", MimeTypeText, handler);
        server.setDefaultHandler("h2-handler", handler);

        hash<auto> linfo = server.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        });
        assertTrue(server.waitForAsyncIo(5s), "async I/O ready");

        HTTPClient h2client({
            "url": "https://localhost:" + linfo.port,
            "timeout": 10s,
            "ssl_verify_cert": False,
            "http_version": "auto",
        });
        if (!h2client.isHttp2Enabled()) {
            testSkip("HTTP/2 not compiled in");
            return;
        }
        h2client.connect();
        on_exit h2client.disconnect();

        # Multiple keep-alive requests on a single HTTP/2 connection.
        # This exercises the consolidated lock scope in handleHttp2RequestResult():
        # each request must transition back to keep-alive without the socket being
        # closed by an uninitialised do_close flag.
        for (int i = 1; i <= 10; i++) {
            string resp = h2client.get("/h2");
            assertEq("h2-ok", resp, sprintf("HTTP/2 keep-alive request %d", i));
        }
        assertTrue(h2client.isHttp2Active(), "HTTP/2 still active after keep-alive burst");
    }

    #! Helper: read an HTTP response from a raw socket using protocol-aware methods
    private hash<auto> readRawHttpResponse(Socket sock, timeout to = 5s) {
        hash<auto> hdr = sock.readHTTPHeader(to);
        string body = "";
        if (hdr."content-length") {
            body = sock.recv(hdr."content-length".toInt(), to);
        }
        hdr.body = body;
        return hdr;
    }

    #! Verifies that async-mode connections are closed after the idle TTL expires.
    #! This tests the fix that changed timeout from -1s (infinite) to
    #! milliseconds(ttl) + DefaultIoOperationTimeout for KeepAlive and
    #! SendAndReadHeader states.
    asyncModeIdleTimeoutTest() {
        Logger logger("async-idle-timeout-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }
        hash<HttpServerOptionInfo> opts = <HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        };
        HttpServer server(opts);
        on_exit server.stop();

        server.setHandler("my-handler", "", MimeTypeHtml, new ReqHandler());
        server.setDefaultHandler("my-handler", new ReqHandler());
        int test_port = server.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        assertTrue(server.waitForAsyncIo(5s), "async I/O should be ready");

        # Set a short TTL so the test doesn't take too long
        date orig_ttl = server.getTtl();
        server.setTtl(200ms);
        on_exit server.setTtl(orig_ttl);

        # Open a connection and make a request to establish keep-alive
        Socket sock();
        sock.connect("localhost:" + test_port);
        sock.send("GET /idle-test HTTP/1.1\r\nHost: localhost\r\n\r\n");
        # Read the full HTTP response (header + body) using protocol-aware methods
        hash<auto> resp = readRawHttpResponse(sock);
        assertEq(200, resp.status_code, "should be 200 OK");

        # Now sit idle past the TTL — the server should close the connection
        # Wait for TTL + safety margin
        usleep(500ms);

        # Try to send another request — should fail because server closed the connection
        bool closed = False;
        try {
            sock.send("GET /idle-test2 HTTP/1.1\r\nHost: localhost\r\n\r\n");
            readRawHttpResponse(sock, 1s);
            # If we got a valid response, connection wasn't closed
        } catch (hash<ExceptionInfo> ex) {
            # Socket errors indicate the server closed the connection
            if (ex.err == "SOCKET-SEND-ERROR" || ex.err == "SOCKET-CLOSED"
                    || ex.err == "SOCKET-NOT-OPEN" || ex.err == "SOCKET-RECV-ERROR"
                    || ex.err == "SOCKET-TIMEOUT" || ex.err == "SOCKET-HTTP-ERROR") {
                closed = True;
            } else {
                rethrow;
            }
        }
        assertTrue(closed, "idle connection should be closed by server after TTL");

        # Verify the server is still operational
        HTTPClient client({"url": "http://localhost:" + test_port, "timeout": 5s});
        client.connect();
        on_exit client.disconnect();
        assertEq("GET, afteridle, /afteridle", client.get("/afteridle"));
    }

    #! Verifies that the inline request path respects the Connection: close header
    #! on HTTP/1.1 requests.
    asyncModeInlineConnectionCloseTest() {
        Logger logger("async-inline-close-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }
        hash<HttpServerOptionInfo> opts = <HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        };
        HttpServer server(opts);
        on_exit server.stop();

        InlineTestHandler inline_handler();
        server.setHandler("inline-handler", "/inline", MimeTypeText, inline_handler);
        server.setDefaultHandler("inline-handler", inline_handler);
        int test_port = server.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        assertTrue(server.waitForAsyncIo(5s), "async I/O should be ready");

        # Test: HTTP/1.1 with Connection: close — server should close connection after response
        {
            Socket sock();
            sock.connect("localhost:" + test_port);
            sock.send("GET /inline HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n");
            # Read the HTTP response properly
            hash<auto> resp = readRawHttpResponse(sock);
            assertEq(200, resp.status_code, "inline response should be 200");
            assertEq("inline-ok", resp.body, "inline response should contain body");

            # The server should close the connection — verify by trying to read more
            bool closed = False;
            try {
                sock.readHTTPHeader(1s);
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err == "SOCKET-CLOSED" || ex.err == "SOCKET-TIMEOUT"
                        || ex.err == "SOCKET-NOT-OPEN" || ex.err == "SOCKET-RECV-ERROR"
                        || ex.err == "SOCKET-HTTP-ERROR") {
                    closed = True;
                } else {
                    rethrow;
                }
            }
            assertTrue(closed, "Connection: close should cause server to close connection");
        }

        # Control test: HTTP/1.1 without Connection: close — connection stays open (keep-alive)
        {
            Socket sock();
            sock.connect("localhost:" + test_port);
            sock.send("GET /inline HTTP/1.1\r\nHost: localhost\r\n\r\n");
            hash<auto> resp = readRawHttpResponse(sock);
            assertEq(200, resp.status_code, "response should be 200");

            # Send a second request on the same connection — should work
            sock.send("GET /inline HTTP/1.1\r\nHost: localhost\r\n\r\n");
            hash<auto> resp2 = readRawHttpResponse(sock);
            assertEq(200, resp2.status_code, "keep-alive: second response should be 200");
            assertEq("inline-ok", resp2.body, "keep-alive: second response body");
            sock.close();
        }

        # Verify server is still operational
        HTTPClient client({"url": "http://localhost:" + test_port, "timeout": 5s});
        client.connect();
        on_exit client.disconnect();
        hash<auto> resp = client.send(NOTHING, "GET", "/inline");
        assertEq(200, resp.status_code, "server still operational");
    }

    #! Verifies that the inline request path closes the connection for HTTP/1.0
    #! requests (which default to close unless Connection: Keep-Alive is sent).
    asyncModeInlineHttp10CloseTest() {
        Logger logger("async-inline-http10-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }
        hash<HttpServerOptionInfo> opts = <HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        };
        HttpServer server(opts);
        on_exit server.stop();

        InlineTestHandler inline_handler();
        server.setHandler("inline-handler", "/inline", MimeTypeText, inline_handler);
        server.setDefaultHandler("inline-handler", inline_handler);
        int test_port = server.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        assertTrue(server.waitForAsyncIo(5s), "async I/O should be ready");

        # Test: HTTP/1.0 request without Connection: Keep-Alive — should close
        {
            Socket sock();
            sock.connect("localhost:" + test_port);
            sock.send("GET /inline HTTP/1.0\r\nHost: localhost\r\n\r\n");
            # Read the HTTP response properly
            hash<auto> resp = readRawHttpResponse(sock);
            assertEq(200, resp.status_code, "HTTP/1.0 inline response should be 200");
            assertEq("inline-ok", resp.body, "HTTP/1.0 inline response should contain body");

            # Server should close the connection for HTTP/1.0
            bool closed = False;
            try {
                sock.readHTTPHeader(1s);
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err == "SOCKET-CLOSED" || ex.err == "SOCKET-TIMEOUT"
                        || ex.err == "SOCKET-NOT-OPEN" || ex.err == "SOCKET-RECV-ERROR"
                        || ex.err == "SOCKET-HTTP-ERROR") {
                    closed = True;
                } else {
                    rethrow;
                }
            }
            assertTrue(closed, "HTTP/1.0 should cause server to close connection by default");
        }

        # Verify server is still operational
        HTTPClient client({"url": "http://localhost:" + test_port, "timeout": 5s});
        client.connect();
        on_exit client.disconnect();
        hash<auto> resp = client.send(NOTHING, "GET", "/inline");
        assertEq(200, resp.status_code, "server still operational after HTTP/1.0");
    }

    #! Verifies that stop() completes deterministically with an active WebSocket connection.
    #! Before the stopStreaming() fix, the handler pool's stopWait() would block indefinitely
    #! because the WebSocket handler task's polling loop was never signaled to stop.
    asyncModeWebSocketShutdownTest() {
        Logger logger("async-ws-shutdown-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }
        hash<HttpServerOptionInfo> opts = <HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        };
        HttpServer server(opts);
        on_exit server.stop();
        TestWsHandler ws_handler();
        server.setHandler("ws-handler", "", NOTHING, ws_handler);
        server.setDefaultHandler("ws-handler", ws_handler);
        int test_port = server.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        assertTrue(server.waitForAsyncIo(5s), "async I/O should be ready");

        # Establish a WebSocket connection
        WebSocketClient ws_client(sub (*data msg) {}, {"url": "ws://localhost:" + test_port});
        on_exit { try { ws_client.disconnect(); } catch () {} }
        ws_client.connect();

        # Brief delay to ensure the handler's startImpl loop is running
        usleep(250ms);

        # Stop the server in a background thread with a timeout guard;
        # before the fix this would hang indefinitely
        Queue stopped();
        background sub () {
            server.stop();
            stopped.push(True);
        }();
        assertTrue(stopped.get(10s) != NOTHING, "server.stop() should complete deterministically");
    }

    #! Verifies deterministic shutdown with multiple concurrent WebSocket connections.
    asyncModeMultipleWebSocketShutdownTest() {
        Logger logger("async-multi-ws-shutdown-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }
        hash<HttpServerOptionInfo> opts = <HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        };
        HttpServer server(opts);
        on_exit server.stop();
        TestWsHandler ws_handler();
        server.setHandler("ws-handler", "", NOTHING, ws_handler);
        server.setDefaultHandler("ws-handler", ws_handler);
        int test_port = server.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        assertTrue(server.waitForAsyncIo(5s), "async I/O should be ready");

        # Establish multiple WebSocket connections
        int num_clients = 5;
        list<WebSocketClient> clients;
        on_exit {
            foreach WebSocketClient ws in (clients) {
                try { ws.disconnect(); } catch () {}
            }
        }
        for (int i = 0; i < num_clients; ++i) {
            WebSocketClient ws(sub (*data msg) {}, {"url": "ws://localhost:" + test_port});
            ws.connect();
            clients += ws;
        }
        assertEq(num_clients, clients.size(), "all clients should be connected");

        # Brief delay to ensure all handler loops are running
        usleep(250ms);

        # Stop the server — all WebSocket handlers must exit deterministically
        Queue stopped();
        background sub () {
            server.stop();
            stopped.push(True);
        }();
        assertTrue(stopped.get(10s) != NOTHING,
            "server.stop() should complete with multiple WebSocket connections");
    }

    #! Verifies deterministic shutdown with a mix of WebSocket and regular HTTP connections.
    asyncModeMixedStreamingShutdownTest() {
        Logger logger("async-mixed-shutdown-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }
        hash<HttpServerOptionInfo> opts = <HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        };
        HttpServer server(opts);
        on_exit server.stop();
        TestWsHandler ws_handler();
        server.setHandler("ws-handler", "/ws", NOTHING, ws_handler);
        server.setHandler("http-handler", "/http", MimeTypeHtml, new ReqHandler());
        server.setDefaultHandler("ws-handler", ws_handler);
        int test_port = server.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        assertTrue(server.waitForAsyncIo(5s), "async I/O should be ready");

        # Start a WebSocket connection (streaming)
        WebSocketClient ws_client(sub (*data msg) {}, {"url": "ws://localhost:" + test_port});
        on_exit { try { ws_client.disconnect(); } catch () {} }
        ws_client.connect();

        # Make regular HTTP requests concurrently to ensure mixed workload
        Counter http_done(3);
        for (int i = 0; i < 3; ++i) {
            background sub () {
                on_exit http_done.dec();
                try {
                    HTTPClient hclient({"url": "http://localhost:" + test_port, "timeout": 5s});
                    hclient.connect();
                    hclient.get("/http/test");
                    hclient.disconnect();
                } catch () {}
            }();
        }
        http_done.waitForZero(5s);

        # Brief delay to ensure the WebSocket handler loop is running
        usleep(250ms);

        # Stop the server — both streaming and regular connections must clean up
        Queue stopped();
        background sub () {
            server.stop();
            stopped.push(True);
        }();
        assertTrue(stopped.get(10s) != NOTHING,
            "server.stop() should complete with mixed streaming and HTTP connections");
    }

    #! Test that accept operations are properly replenished after cancellation
    /** This test verifies the fix for accept starvation where canceled accept
        operations would drain the accept pool without replenishment, causing
        the server to stop accepting new connections.
    */
    asyncModeAcceptReplenishmentTest() {
        Logger logger("async-accept-replenish-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }
        hash<HttpServerOptionInfo> opts = <HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        };
        HttpServer server(opts);
        on_exit server.stop();

        # Set up a simple handler
        server.setDefaultHandler("test-handler", new ReqHandler());

        # Add and remove listeners repeatedly to trigger accept operation cancellations
        # This exercises the accept replenishment path
        list<hash<auto>> listener_info = ();
        for (int i = 0; i < 5; ++i) {
            hash<auto> info = server.addListener(<HttpListenerOptionInfo>{"service": 0});
            listener_info += info;
            # Make a request to ensure the listener is working
            HTTPClient client({"url": "http://localhost:" + info.port, "timeout": 2s});
            client.connect();
            assertEq("GET, test, /test", client.get("/test"));
            client.disconnect();
        }

        # Stop all listeners (this cancels accept operations)
        foreach hash<auto> info in (listener_info) {
            server.stopListenerID(info.id);
        }

        # Add a new listener - this should work if accept replenishment is correct
        int final_port = server.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        assertTrue(server.waitForAsyncIo(5s), "async I/O should be ready after listener churn");

        # Make multiple concurrent requests to verify accept operations are working
        Counter done(10);
        bool all_success = True;
        for (int i = 0; i < 10; ++i) {
            background sub () {
                on_exit done.dec();
                try {
                    HTTPClient client({"url": "http://localhost:" + final_port, "timeout": 5s});
                    client.connect();
                    string result = client.get("/test");
                    if (result != "GET, test, /test") {
                        all_success = False;
                    }
                    client.disconnect();
                } catch (hash<ExceptionInfo> ex) {
                    if (m_options.verbose > 1) {
                        printf("Request failed: %s: %s\n", ex.err, ex.desc);
                    }
                    all_success = False;
                }
            }();
        }
        done.waitForZero(10s);
        assertEq(0, done.getCount(), "all concurrent requests should complete");
        assertTrue(all_success, "all requests should succeed after listener add/remove cycles");
    }

    /** This test verifies that the AsyncSocketIoController cache is properly cleaned up
        when connections close. This is the fix for the CLOSE-WAIT socket leak bug where
        poll operations stayed in the cache even after connections were closed, preventing
        Socket objects from being destroyed and their destructors (which call close()) from
        running.
    */
    asyncModeCacheCleanupTest() {
        Logger logger("async-cache-cleanup-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }
        hash<HttpServerOptionInfo> opts = <HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        };
        HttpServer server(opts);
        on_exit server.stop();

        # Set up a simple handler
        server.setDefaultHandler("test-handler", new ReqHandler());

        # Add listener
        int test_port = server.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        assertTrue(server.waitForAsyncIo(5s), "async I/O should be ready");

        # Get baseline cache size (should just be accept operations)
        int baseline_cache_size = server.getHttpAsyncIo().getTotalCacheSize();
        if (m_options.verbose > 1) {
            printf("Baseline cache size: %d\n", baseline_cache_size);
        }

        # Test 1: HTTP/1.1 connections - create many connections, close them, verify cleanup
        {
            int num_connections = 20;
            list<HTTPClient> clients = ();

            # Create many connections
            for (int i = 0; i < num_connections; ++i) {
                HTTPClient client({"url": "http://localhost:" + test_port, "timeout": 2s});
                client.connect();
                assertEq("GET, test, /test", client.get("/test"));
                clients += client;
            }

            # Verify cache has grown (connections are active); the async I/O
            # system may not have registered all connections yet, so allow a
            # brief window for the cache to update
            int active_cache_size;
            int retries = 0;
            while (True) {
                active_cache_size = server.getHttpAsyncIo().getTotalCacheSize();
                if (active_cache_size > baseline_cache_size || retries >= 20) {
                    break;
                }
                usleep(50ms);
                ++retries;
            }
            if (m_options.verbose > 1) {
                printf("Active cache size with %d connections: %d (after %d retries)\n",
                    num_connections, active_cache_size, retries);
            }
            assertTrue(active_cache_size > baseline_cache_size,
                "cache should grow when connections are active");

            # Close all connections - this should trigger cache cleanup
            map $1.disconnect(), clients;
            delete clients;

            # Wait for the async I/O system to process disconnects and clean
            # up cache entries
            int final_cache_size;
            int cleanup_retries = 0;
            while (True) {
                final_cache_size = server.getHttpAsyncIo().getTotalCacheSize();
                if (final_cache_size <= baseline_cache_size || cleanup_retries >= 100) {
                    break;
                }
                usleep(50ms);
                ++cleanup_retries;
            }
            if (m_options.verbose > 1) {
                printf("Cache cleanup took %d retries (%d ms)\n",
                    cleanup_retries, cleanup_retries * 50);
            }
            if (m_options.verbose > 1) {
                printf("Final cache size after disconnect: %d\n", final_cache_size);
            }
            assertEq(baseline_cache_size, final_cache_size,
                "cache should return to baseline after all connections close");

            # Verify we can still make new connections (cache is clean)
            HTTPClient verify_client({"url": "http://localhost:" + test_port, "timeout": 2s});
            verify_client.connect();
            assertEq("GET, test2, /test2", verify_client.get("/test2"));
            verify_client.disconnect();
        }

        # Test 2: HTTP/2 connections - same test with HTTP/2 over SSL
        {
            # Create HTTPS listener for HTTP/2
            hash<auto> ssl_info = server.addListener(<HttpListenerOptionInfo>{
                "service": 0,
                "cert": new SSLCertificate(CertPem),
                "key": new SSLPrivateKey(KeyPem),
            });
            int ssl_port = ssl_info.port;

            # Get baseline after adding SSL listener (includes accept ops for both listeners)
            int h2_baseline = server.getHttpAsyncIo().getTotalCacheSize();
            if (m_options.verbose > 1) {
                printf("HTTP/2 baseline cache size: %d\n", h2_baseline);
            }

            int num_connections = 20;
            list<HTTPClient> clients = ();

            # Create many HTTP/2 connections (HTTP/2 is negotiated via ALPN over SSL)
            for (int i = 0; i < num_connections; ++i) {
                HTTPClient client({"url": "https://localhost:" + ssl_port, "timeout": 2s,
                    "ssl_verify_cert": False, "http2": True});
                client.connect();
                assertEq("GET, test, /test", client.get("/test"));
                clients += client;
            }

            # Verify cache has grown (HTTP/2 connections are active); allow a
            # brief window for the async I/O system to register them
            int h2_active;
            int retries = 0;
            while (True) {
                h2_active = server.getHttpAsyncIo().getTotalCacheSize();
                if (h2_active > h2_baseline || retries >= 20) {
                    break;
                }
                usleep(50ms);
                ++retries;
            }
            if (m_options.verbose > 1) {
                printf("HTTP/2 active cache size with %d connections: %d (after %d retries)\n",
                    num_connections, h2_active, retries);
            }
            assertTrue(h2_active > h2_baseline,
                "cache should grow when HTTP/2 connections are active");

            # Close all connections - this should trigger cache cleanup for HTTP/2
            map $1.disconnect(), clients;
            delete clients;

            # Wait for the async I/O system to process disconnects and clean
            # up cache entries
            int h2_final;
            int h2_cleanup_retries = 0;
            while (True) {
                h2_final = server.getHttpAsyncIo().getTotalCacheSize();
                if (h2_final <= h2_baseline || h2_cleanup_retries >= 100) {
                    break;
                }
                usleep(50ms);
                ++h2_cleanup_retries;
            }
            if (m_options.verbose > 1) {
                printf("HTTP/2 cache cleanup took %d retries (%d ms)\n",
                    h2_cleanup_retries, h2_cleanup_retries * 50);
            }
            if (m_options.verbose > 1) {
                printf("HTTP/2 final cache size after disconnect: %d\n", h2_final);
            }
            assertEq(h2_baseline, h2_final,
                "cache should return to baseline after all HTTP/2 connections close");

            # Verify we can still make new HTTP/2 connections (cache is clean)
            HTTPClient verify_client({"url": "https://localhost:" + ssl_port, "timeout": 2s,
                "ssl_verify_cert": False, "http2": True});
            verify_client.connect();
            assertEq("GET, test2, /test2", verify_client.get("/test2"));
            verify_client.disconnect();

            server.stopListenerID(ssl_info.id);
        }
    }

    /** Test that server handles bad SSL handshakes without blocking I/O thread.
        Simulates clients that connect and close immediately during SSL handshake,
        which previously caused getPeerInfo() to block the I/O thread.
    */
    asyncModeBadSslHandshakeTest() {
        Logger logger("async-bad-ssl-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }
        hash<HttpServerOptionInfo> opts = <HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        };
        HttpServer server(opts);
        on_exit server.stop();

        server.setDefaultHandler("test-handler", new ReqHandler());

        # Create HTTPS listener
        hash<auto> ssl_info = server.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        });
        int ssl_port = ssl_info.port;
        assertTrue(server.waitForAsyncIo(5s), "async I/O should be ready");

        # Test 1: Client connects and immediately closes (before SSL handshake)
        {
            Socket sock();
            sock.connect("localhost:" + ssl_port);
            sock.close();  # Close immediately - server will see EOF during SSL_accept
            usleep(100ms);  # Give server time to process
        }

        # Test 2: Multiple rapid connect/close cycles
        for (int i = 0; i < 10; ++i) {
            Socket sock();
            sock.connect("localhost:" + ssl_port);
            sock.close();
        }
        usleep(500ms);  # Give server time to process all

        # Critical: Verify server is still responsive (I/O thread not blocked)
        HTTPClient verify_client({"url": "https://localhost:" + ssl_port,
            "timeout": 2s, "ssl_verify_cert": False});
        verify_client.connect();
        assertEq("GET, test, /test", verify_client.get("/test"),
            "server should still be responsive after bad SSL handshakes");
        verify_client.disconnect();

        # Verify cache is clean (no leaked operations from bad handshakes)
        int cache_size = server.getHttpAsyncIo().getTotalCacheSize();
        if (m_options.verbose > 1) {
            printf("Cache size after bad SSL handshakes: %d\n", cache_size);
        }
        # Cache should be small (just accept operations), not grown from leaked connections
        # With multiple I/O threads (QORE_IO_THREADS), each thread has its own accept ops
        assertTrue(cache_size < 40, "cache should not leak from bad SSL handshakes");
    }

    /** Test that I/O thread never blocks on getPeerInfo() calls.
        Verifies the fix: getPeerInfo(host_lookup=False) and defensive checks.
    */
    asyncModeIoThreadNonBlockingTest() {
        Logger logger("async-io-nonblock-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }
        hash<HttpServerOptionInfo> opts = <HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        };
        HttpServer server(opts);
        on_exit server.stop();

        server.setDefaultHandler("test-handler", new ReqHandler());

        # Test both HTTP and HTTPS
        int http_port = server.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        hash<auto> ssl_info = server.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        });
        int https_port = ssl_info.port;
        assertTrue(server.waitForAsyncIo(5s), "async I/O should be ready");

        # Create many concurrent connections that close at various stages
        Counter done(20);
        bool all_completed = True;
        date start = now_us();

        for (int i = 0; i < 20; ++i) {
            background sub () {
                on_exit done.dec();
                try {
                    if (i % 2 == 0) {
                        # HTTP connections
                        HTTPClient client({"url": "http://localhost:" + http_port, "timeout": 2s});
                        client.connect();
                        client.get("/test");
                        client.disconnect();
                    } else {
                        # HTTPS connections
                        HTTPClient client({"url": "https://localhost:" + https_port,
                            "timeout": 2s, "ssl_verify_cert": False});
                        client.connect();
                        client.get("/test");
                        client.disconnect();
                    }
                } catch (hash<ExceptionInfo> ex) {
                    if (m_options.verbose > 1) {
                        printf("Connection failed (expected for some): %s\n", ex.err);
                    }
                    all_completed = False;
                }
            }();
        }

        # Critical: All requests should complete quickly (not blocked on getPeerInfo)
        done.waitForZero(10s);
        assertEq(0, done.getCount(), "all concurrent requests should complete");

        date elapsed = now_us() - start;
        if (m_options.verbose > 1) {
            printf("Elapsed time for 20 concurrent connections: %y\n", elapsed);
        }

        # Should complete in under 5 seconds (previously could take 20s+ if blocking)
        assertTrue(elapsed < 5s, "I/O thread should not block - requests should be fast");

        # Verify server still responsive
        HTTPClient verify({"url": "http://localhost:" + http_port, "timeout": 2s});
        verify.connect();
        assertEq("GET, final, /final", verify.get("/final"));
        verify.disconnect();
    }

    #! Tests that RestClientIo recovers when an HTTP/1.1 server closes a keep-alive
    #! connection after N requests (the "hoppy:30000" scenario).
    #!
    #! A raw socket server serves max_requests HTTP/1.1 responses with keep-alive,
    #! then closes the connection.  The client must detect the EOF and reconnect
    #! transparently — not busy-loop until timeout.
    asyncModeH1KeepAliveServerCloseTest() {
        # Tests that RestClientIo (HttpClientIo) recovers when an HTTP/1.1 server
        # closes a keep-alive connection.  Three scenarios:
        #   1. Server closes after N requests (immediate next request)
        #   2. Server closes during client idle (delayed close, like uvicorn)
        #   3. Rapid-fire requests across multiple server close cycles
        #
        # The client must detect EOF and reconnect transparently.  Recovery must
        # be fast (< 3s per stale detect), not wait the full request timeout.

        bool server_stop = False;
        int max_requests_per_conn = 3;

        # Raw HTTP/1.1 server that closes after max_requests_per_conn
        Socket listener();
        listener.bind("localhost:0");
        listener.listen();
        int port = listener.getSocketInfo().port;

        Counter serverDone(1);
        background sub () {
            on_exit serverDone.dec();
            try {
                while (!server_stop) {
                    *Socket client = listener.accept(500ms);
                    if (!client) {
                        continue;
                    }
                    # Handle each accepted connection in a background thread so
                    # an abandoned keep-alive connection (scenario 1 leftover)
                    # doesn't block acceptance of new connections (scenario 2)
                    background sub (Socket client) {
                        for (int req = 0; req < max_requests_per_conn; ++req) {
                            *hash<auto> hdr;
                            try {
                                hdr = client.readHTTPHeader(2s);
                            } catch () {
                                break;
                            }
                            if (!hdr) {
                                break;
                            }
                            string body = sprintf("{\"n\": %d}", req);
                            string resp = sprintf(
                                "HTTP/1.1 200 OK\r\n"
                                "Content-Type: application/json\r\n"
                                "Content-Length: %d\r\n"
                                "Connection: keep-alive\r\n"
                                "\r\n"
                                "%s", body.size(), body);
                            client.send(resp);
                        }
                        client.close();
                    }(client);
                }
            } catch () {
                # ignore errors on shutdown
            }
        }();

        on_exit {
            server_stop = True;
            listener.close();
            serverDone.waitForZero(3s);
        }

        # --- Scenario 1: immediate requests across server close ---
        {
            RestClientIo rc({
                "url": "http://localhost:" + port,
                "data": "json",
                "connect_timeout": 2s,
                "timeout": 2s,
            });
            int total = max_requests_per_conn + 2;
            int ok = 0;
            for (int i = 0; i < total; ++i) {
                try {
                    rc.restGet("/health");
                    ++ok;
                } catch (hash<ExceptionInfo> ex) {
                    if (m_options.verbose > 1) {
                        printf("scenario1 req %d: %s: %s\n", i, ex.err, ex.desc);
                    }
                    assertNeq("HTTPCLIENT-TIMEOUT", ex.err,
                        sprintf("scenario1 req %d must not timeout", i));
                }
            }
            assertEq(total, ok, "scenario1: all requests should succeed");
        }

        # --- Scenario 2: idle gap triggers server close, then request ---
        {
            RestClientIo rc({
                "url": "http://localhost:" + port,
                "data": "json",
                "connect_timeout": 2s,
                "timeout": 2s,
            });
            # First request establishes connection
            rc.restGet("/health");

            # Sleep long enough for the server to close (the raw server closes
            # immediately after max_requests, so a new request after even a short
            # sleep hits a fresh connection from the pool or triggers reconnect)
            # Send max_requests to exhaust, then sleep, then send again
            for (int i = 1; i < max_requests_per_conn; ++i) {
                rc.restGet("/health");
            }
            # Server closes now; sleep to let FIN arrive
            usleep(200ms);

            # This request must detect the closed connection and reconnect
            date start = now_us();
            try {
                rc.restGet("/health");
            } catch (hash<ExceptionInfo> ex) {
                assertNeq("HTTPCLIENT-TIMEOUT", ex.err,
                    "scenario2: post-close request must not timeout");
            }
            # Recovery should be fast — under 10s (stale detect timeout + reconnect)
            date elapsed = now_us() - start;
            assertTrue(elapsed < 10s,
                sprintf("scenario2: recovery took %y, expected < 10s", elapsed));
        }

        # --- Scenario 3: server delays close (TCP FIN race) ---
        # The server closes 500ms AFTER the last response.  The client sends the
        # next request during that window — the request goes out on a connection
        # that the server is about to close.  The client must detect the stale
        # connection (via recv EOF or timeout) and reconnect within the stale
        # detect window, not wait the full request timeout.
        {
            bool srv3_stop = False;
            Socket srv3_listener();
            srv3_listener.bind("localhost:0");
            srv3_listener.listen();
            int srv3_port = srv3_listener.getSocketInfo().port;

            Counter srv3Done(1);
            background sub () {
                on_exit srv3Done.dec();
                try {
                    while (!srv3_stop) {
                        *Socket client = srv3_listener.accept(500ms);
                        if (!client) {
                            continue;
                        }
                        # Serve one request, then delay close by 500ms
                        *hash<auto> hdr;
                        try {
                            hdr = client.readHTTPHeader(2s);
                        } catch () {
                            client.close();
                            continue;
                        }
                        if (!hdr) {
                            client.close();
                            continue;
                        }
                        string body = "{\"ok\": true}";
                        string resp = sprintf(
                            "HTTP/1.1 200 OK\r\n"
                            "Content-Type: application/json\r\n"
                            "Content-Length: %d\r\n"
                            "Connection: keep-alive\r\n"
                            "\r\n"
                            "%s", body.size(), body);
                        client.send(resp);
                        # Delayed close — simulates uvicorn keep-alive timeout
                        usleep(500ms);
                        client.close();
                    }
                } catch () {}
            }();

            on_exit {
                srv3_stop = True;
                srv3_listener.close();
                srv3Done.waitForZero(3s);
            }

            RestClientIo rc({
                "url": "http://localhost:" + srv3_port,
                "data": "json",
                "connect_timeout": 2s,
                "timeout": 2s,
            });

            # First request succeeds
            rc.restGet("/health");

            # Second request sent immediately — races with the delayed close.
            # Must succeed (reconnect if needed) within 3s, not the full timeout.
            date start = now_us();
            try {
                rc.restGet("/health");
            } catch (hash<ExceptionInfo> ex) {
                if (m_options.verbose > 1) {
                    printf("scenario3: %s: %s\n", ex.err, ex.desc);
                }
                assertNeq("HTTPCLIENT-TIMEOUT", ex.err,
                    "scenario3: request during delayed close must not timeout");
            }
            date elapsed = now_us() - start;
            assertTrue(elapsed < 10s,
                sprintf("scenario3: recovery took %y, expected < 10s", elapsed));
        }

        # --- Scenario 4: server stops responding (no FIN, no RST) ---
        # Simulates the worst case: the server accepts the connection, responds
        # to the first request, then goes silent.  The client sends a second
        # request but gets no response and no close notification.  The stale
        # detect timer (2s poll_timeout_ms) should fire and the client should
        # retry on a new connection within 10s (generous for resource-constrained CI).
        {
            bool srv4_stop = False;
            Socket srv4_listener();
            srv4_listener.bind("localhost:0");
            srv4_listener.listen();
            int srv4_port = srv4_listener.getSocketInfo().port;

            Counter srv4Done(1);
            *Socket srv4_stalled_client;
            background sub () {
                on_exit srv4Done.dec();
                try {
                    int conn_num = 0;
                    while (!srv4_stop) {
                        *Socket client = srv4_listener.accept(500ms);
                        if (!client) {
                            continue;
                        }
                        ++conn_num;
                        if (conn_num == 1) {
                            # First connection: respond to first request, then stall
                            *hash<auto> hdr = client.readHTTPHeader(2s);
                            if (hdr) {
                                string body = "{\"ok\": true}";
                                string resp = sprintf(
                                    "HTTP/1.1 200 OK\r\n"
                                    "Content-Type: application/json\r\n"
                                    "Content-Length: %d\r\n"
                                    "Connection: keep-alive\r\n"
                                    "\r\n"
                                    "%s", body.size(), body);
                                client.send(resp);
                            }
                            # Hold the socket open (no close, no FIN) —
                            # srv4_stalled_client keeps the reference alive so
                            # the socket stays open without blocking the accept loop
                            srv4_stalled_client = client;
                        } else {
                            # Subsequent connections: respond normally
                            while (!srv4_stop) {
                                *hash<auto> hdr;
                                try {
                                    hdr = client.readHTTPHeader(1s);
                                } catch () {
                                    break;
                                }
                                if (!hdr) {
                                    break;
                                }
                                string body = "{\"ok\": true}";
                                string resp = sprintf(
                                    "HTTP/1.1 200 OK\r\n"
                                    "Content-Type: application/json\r\n"
                                    "Content-Length: %d\r\n"
                                    "Connection: keep-alive\r\n"
                                    "\r\n"
                                    "%s", body.size(), body);
                                client.send(resp);
                            }
                            client.close();
                        }
                    }
                } catch () {}
            }();

            on_exit {
                srv4_stop = True;
                srv4_listener.close();
                srv4Done.waitForZero(5s);
            }

            RestClientIo rc({
                "url": "http://localhost:" + srv4_port,
                "data": "json",
                "connect_timeout": 5s,
                "timeout": 15s,
            });

            # First request succeeds
            rc.restGet("/health");

            # Second request: server stalls (no response, no close on conn 1).
            # The stale detect timer should fire within 500ms, the client
            # detects the dead connection and retries on a fresh connection
            # (conn 2) which the server handles normally.
            date start = now_us();
            bool recovered = False;
            try {
                rc.restGet("/health");
                recovered = True;
            } catch (hash<ExceptionInfo> ex) {
                if (m_options.verbose > 1) {
                    printf("scenario4: %s: %s\n", ex.err, ex.desc);
                }
            }
            date elapsed = now_us() - start;
            assertTrue(recovered, "scenario4: retry on fresh connection must succeed");
            assertTrue(elapsed < 10s,
                sprintf("scenario4: took %y, expected < 10s", elapsed));
        }
    }

    #! Tests that connecting to an unreachable port fails fast, not hangs
    /** Regression test: setError()/abort() must call setClosed() on the
        connection priv so waitForReady() returns immediately.  Without this,
        connection-refused errors hang forever because the connection state
        never transitions from CONNECTING.
    */
    asyncModeConnectionRefusedTest() {
        # Use a port with nothing listening — kernel returns ECONNREFUSED
        # immediately.  With async I/O, the poll op detects the error and
        # the client must propagate it within the connect timeout.
        {
            date start = now_us();
            try {
                RestClientIo rc({
                    "url": "http://localhost:59999",
                    "connect_timeout": 10s,
                    "timeout": 10s,
                });
                rc.restGet("/test");
                assertTrue(False, "connection to closed port must throw");
            } catch (hash<ExceptionInfo> ex) {
                date elapsed = now_us() - start;
                # Must fail fast (< 5s), not wait the full connect timeout
                assertTrue(elapsed < 5s,
                    sprintf("connection refused took %y, expected < 5s", elapsed));
                # Must be a connect error, not a timeout
                assertRegex("CONNECT-ERROR|SOCKET-CONNECT-ERROR",
                    ex.err, "connection refused error type");
            }
        }

        # Test with HTTPS to verify SSL path also handles connection refused
        {
            date start = now_us();
            try {
                RestClientIo rc({
                    "url": "https://localhost:59999",
                    "connect_timeout": 10s,
                    "timeout": 10s,
                });
                rc.restGet("/test");
                assertTrue(False, "SSL connection to closed port must throw");
            } catch (hash<ExceptionInfo> ex) {
                date elapsed = now_us() - start;
                assertTrue(elapsed < 5s,
                    sprintf("SSL connection refused took %y, expected < 5s", elapsed));
            }
        }
    }
}

#! Test handler that supports persistent connections
class PersistentTestHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        string path = hdr.path;
        int tid = gettid();

        if (path =~ /start$/) {
            # Start persistent mode
            setPersistent(True);
            return makeResponse({"x-thread-id": string(tid)}, 200, "started");
        } else if (path =~ /continue$/) {
            # Continue in persistent mode (verify we're persistent)
            if (!isPersistent()) {
                return makeResponse({"x-thread-id": string(tid)}, 500, "not persistent");
            }
            return makeResponse({"x-thread-id": string(tid)}, 200, "continued");
        } else if (path =~ /end$/) {
            # End persistent mode
            setPersistent(False);
            return makeResponse({"x-thread-id": string(tid)}, 200, "ended");
        } else if (path =~ /error$/) {
            # Trigger an error
            throw "TEST-ERROR", "Intentional test error";
        } else if (path =~ /normal$/) {
            # Non-persistent request
            return makeResponse({"x-thread-id": string(tid)}, 200, "normal");
        }

        return makeResponse({"x-thread-id": string(tid)}, 404, "not found");
    }
}

#! Test handler that supports inline processing in the I/O thread
class InlineTestHandler inherits AbstractHttpRequestHandler {
    #! Returns True — this handler can run inline in the I/O thread
    bool canHandleInline(hash<auto> cx, hash<auto> hdr) {
        return True;
    }

    #! Lightweight inline response — no context setup needed
    hash<HttpResponseInfo> handleInlineRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse({"x-inline-header": "inline-value"}, 200, "inline-ok");
    }

    #! Full handleRequest (should not be called when inline path is used)
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, "non-inline-response");
    }
}
