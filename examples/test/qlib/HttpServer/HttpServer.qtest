        assertEq("ok", resp.body);
    }

    asyncModeStopInFlightTest() {
        hash<HttpServerOptionInfo> opts = <HttpServerOptionInfo>{
            "logger": new Logger("async-stop-inflight", LoggerLevel::getLevelInfo()),
            "debug": True,
        };
        HttpServer server(opts);
        Queue started();
        SlowHandler handler(started, 2s);
        server.setHandler("slow-handler", "", MimeTypeHtml, handler);
        server.setDefaultHandler("slow-handler", handler);
        int port = server.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        assertTrue(server.waitForAsyncIo(5s), "async I/O should be ready");

        background sub () {
            try {
                HTTPClient client({"url": "http://localhost:" + port, "timeout": 10s});
                client.connect();
                client.get("/slow");
                client.disconnect();
            } catch () {
                # Ignore errors if shutdown closes the socket early.
            }
        }();

        assertTrue(started.get(5s) != NOTHING, "handler should start before shutdown");

        Queue stopped();
        background sub () {
            server.stop();
            stopped.push(True);
        }();
        assertTrue(stopped.get(5s) != NOTHING, "server.stop should finish without delay");
    }

