    routingTest() {
        assertEq("/route", mClient.get("/route"));
        assertEq("/route", mClient.get("/route/something"));
        assertEq("/route/a", mClient.get("/route/a"));
        assertEq("/route/a", mClient.get("/route/a/something"));
        assertEq("/route/a/c", mClient.get("/route/a/c"));
        assertEq("/route/a/c", mClient.get("/route/a/c/something"));
        assertEq("/route/b", mClient.get("/route/b"));
        assertEq("/route/b", mClient.get("/route/b/something"));
    }

    testStatusCodes() {
        code c = sub() { mClient.get("/test400/"); };
        testAssertion("400", c, NOTHING, new QUnit::TestResultExceptionRegexp("HTTP-CLIENT-RECEIVE-ERROR", "status code 400 received"));
        c = sub() { mClient.get("/test500/abc"); };
        testAssertion("500", c, NOTHING, new QUnit::TestResultExceptionRegexp("HTTP-CLIENT-RECEIVE-ERROR", "status code 500 received"));
        c = sub() { mClient.get("/test501/xyz"); };
        testAssertion("501", c, NOTHING, new QUnit::TestResultExceptionRegexp("HTTP-CLIENT-RECEIVE-ERROR", "status code 501 received"));
        c = sub() { mClient.get("/nonexistingcode/abc"); };
        testAssertion("non-existing status code", c, NOTHING, new QUnit::TestResultExceptionRegexp("HTTP-CLIENT-RECEIVE-ERROR", "status code 500 received"));
    }

    misc() {
        assertEq(("method": "path", "params": ("a": "1", "b": "2")), parse_uri_query("path?a=1;b=2"));
        assertEq(("method": "path", "params": ("a": "1", "b": True)), parse_uri_query("path?a=1;b"));
    }

    private multipartFormDataBinaryFileTest() {
        MultiPartFormDataMessage msg();
        msg.addPart(BinImage, "image0.png", {"Content-Type": MimeTypePng});
        msg.addPart(BinImage, "image1.png", {"Content-Type": MimeTypePng});
        hash<MessageInfo> h = msg.getMsgAndHeaders();
        hash<auto> info;
        binary img = binary(mClient.post("/fileupload", h.body, h.hdr, \info));
        assertEq(200, info."response-headers".status_code);
        assertEq(MimeTypePng, info."response-headers"."content-type");
        assertEq(BinImage, img);
        assertEq("chunked", info."response-headers"."transfer-encoding");
    }

    asyncModeBasicTest() {
        # Verify async mode is enabled
        assertTrue(mAsyncServer.getAsyncMode());
        assertFalse(mServer.getAsyncMode());

        # Create client with short timeout to ensure async operations don't block indefinitely
        HTTPClient client({"url": asyncUrl, "timeout": 5s});
        client.connect();
        on_exit client.disconnect();

        # Test basic GET request
        assertEq("GET, abc, /abc", client.get("/abc"));

        # Test GET with different paths
        assertEq("GET, abc/test/1/5/t, /abc/test/1/5/t", client.get("/abc/test/1/5/t"));

        # Test POST request
        hash resp = client.send("dx123", "POST", "/abc");
        assertEq(200, resp.status_code);
        assertEq("POST, dx123, abc, /abc", resp.body);
    }

    asyncModeKeepAliveTest() {
        # Test keep-alive connections work with async mode
        # Make multiple requests on the same connection with short timeout
        HTTPClient client({"url": asyncUrl, "timeout": 5s});
        client.connect();
        on_exit client.disconnect();

        # First request
        assertEq("GET, test1, /test1", client.get("/test1"));
        # Second request on same connection (keep-alive)
        assertEq("GET, test2, /test2", client.get("/test2"));
        # Third request
        assertEq("GET, test3, /test3", client.get("/test3"));

        # Test with POST as well
        hash resp = client.send("body1", "POST", "/post1");
        assertEq(200, resp.status_code);
        assertEq("POST, body1, post1, /post1", resp.body);

        # Another request after POST
        assertEq("GET, final, /final", client.get("/final"));
    }

    asyncModeConcurrentTest() {
        # Test concurrent connections with async mode
        # Each worker makes a single request on a new connection to test concurrent accept
        int numConnections = 5;

        Counter cnt(numConnections);

        for (int i = 0; i < numConnections; ++i) {
            # Use short timeout (5s) to ensure async operations don't block indefinitely
            background asyncConcurrentWorker(i, cnt, 5s);
        }

        # Wait for all workers to complete (10s overall timeout)
        # waitForZero returns remaining count (0 on success)
        assertEq(0, cnt.waitForZero(10s));
    }

    private asyncConcurrentWorker(int workerId, Counter cnt, date testTimeout) {
        on_exit cnt.dec();

        try {
            # Each worker creates a new connection for each request
            # This tests concurrent accept and request handling without relying on keep-alive
            HTTPClient client({"url": asyncUrl, "timeout": testTimeout});
            client.connect();
            on_exit client.disconnect();

            string path = sprintf("/worker%d", workerId);
            string expected = sprintf("GET, worker%d, %s", workerId, path);
            string result = client.get(path);
            if (result != expected) {
                throw "ASSERTION-ERROR", sprintf("Worker %d failed: expected %y, got %y",
                    workerId, expected, result);
            }
        } catch (hash<ExceptionInfo> ex) {
            printf("Worker %d failed: %s: %s\n", workerId, ex.err, ex.desc);
            rethrow;
        }
    }

    asyncModeHttpsTest() {
        # Verify the async I/O controller is running
        assertTrue(mAsyncServer.getGlobalAsyncCtrl().running(), "globalAsyncCtrl should be running");

        # Debug: check listener SSL detection
        hash<auto> info = mAsyncServer.getGlobalAsyncCtrl().getInfo();
        if (m_options.verbose > 2) {
            printf("DEBUG: globalAsyncCtrl info: %N\n", info);
        }

        # Test HTTPS connections with async mode
        HTTPClient client({
            "url": asyncSslUrl,
            "timeout": 5s,
            "ssl_verify_cert": False,  # Self-signed cert
        });
        client.connect();
        on_exit client.disconnect();

        # Test basic GET request over HTTPS
        assertEq("GET, secure, /secure", client.get("/secure"));

        # Test POST over HTTPS
        hash resp = client.send("secure-data", "POST", "/secure-post");
        assertEq(200, resp.status_code);
        assertEq("POST, secure-data, secure-post, /secure-post", resp.body);

        # Test keep-alive over HTTPS
        assertEq("GET, test1, /test1", client.get("/test1"));
        assertEq("GET, test2, /test2", client.get("/test2"));
    }

    asyncModeErrorResponsesTest() {
        # Test error responses (4xx, 5xx) with async mode
        # Use error_passthru to get error responses without exceptions
        HTTPClient client({"url": asyncUrl, "timeout": 5s, "error_passthru": True});
        client.connect();
        on_exit client.disconnect();

        # Test 400 Bad Request
        hash resp = client.send(NOTHING, "GET", "/test400/path");
        assertEq(400, resp.status_code);

        # Test 500 Internal Server Error
        resp = client.send(NOTHING, "GET", "/test500/path");
        assertEq(500, resp.status_code);

        # Test 501 Not Implemented
        resp = client.send(NOTHING, "GET", "/test501/path");
        assertEq(501, resp.status_code);

        # Test 204 No Content
        resp = client.send(NOTHING, "GET", "/test204/path");
        assertEq(204, resp.status_code);

        # Test 304 Not Modified
        resp = client.send(NOTHING, "GET", "/test304/path");
        assertEq(304, resp.status_code);

        # Connection should still work after errors
        assertEq("GET, aftererror, /aftererror", client.get("/aftererror"));
    }

    asyncModeConnectionCloseTest() {
        # Test client disconnect scenarios with async mode

        # Test 1: Client closes connection immediately after sending request
        {
            Socket sock();
            sock.connect("localhost:" + asyncPort);
            sock.send("GET /disconnect HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n");
            # Read response (server should handle gracefully)
            try {
                *string resp = sock.recv(1024, 1s);
                # If we get a response, it should be valid HTTP
                if (resp) {
                    assertTrue(resp =~ /^HTTP\/1\.[01] [0-9]{3}/);
                }
            } catch (hash<ExceptionInfo> ex) {
                # Timeout or closed connection is OK
                assertTrue(ex.err == "SOCKET-TIMEOUT" || ex.err == "SOCKET-CLOSED");
            }
            sock.close();
        }

        # Test 2: Verify server still works after abrupt client disconnect
        {
            HTTPClient client({"url": asyncUrl, "timeout": 5s});
            client.connect();
            on_exit client.disconnect();
            assertEq("GET, afterdisconnect, /afterdisconnect", client.get("/afterdisconnect"));
        }

        # Test 3: Multiple rapid connect/disconnect cycles
        for (int i = 0; i < 5; ++i) {
            Socket sock();
            sock.connect("localhost:" + asyncPort);
            sock.send("GET /rapid" + i + " HTTP/1.1\r\nHost: localhost\r\n\r\n");
            sock.close();  # Close immediately
        }

        # Verify server still responsive
        {
            HTTPClient client({"url": asyncUrl, "timeout": 5s});
            client.connect();
            on_exit client.disconnect();
            assertEq("GET, stillworks, /stillworks", client.get("/stillworks"));
        }
    }

    asyncModeWebSocketTest() {
        # Test WebSocket protocol upgrade with async mode
        Counter msgReceived(1);
        string receivedMsg;

        code callback = sub (*data msg) {
            if (msg.typeCode() == NT_STRING) {
                receivedMsg = msg;
                msgReceived.dec();
            }
        };

        # Connect WebSocket client to async server
        string wsUrl = "ws://localhost:" + asyncPort + "/ws";
        WebSocketClient wsc(callback, {"url": wsUrl, "timeout": 5s});
        wsc.connect();
        on_exit wsc.disconnect();

        # Send a message and wait for echo
        wsc.send("hello");
        assertEq(0, msgReceived.waitForZero(5s));
        assertEq("ECHO:hello", receivedMsg);

        # Send another message
        msgReceived.inc();
        wsc.send("world");
        assertEq(0, msgReceived.waitForZero(5s));
        assertEq("ECHO:world", receivedMsg);
    }

    asyncModeWebSocketSslTest() {
        # Test WebSocket protocol upgrade with async mode over SSL (wss://)
        # This test uses HTTP/2 by default (via ALPN)
        Counter msgReceived(1);
        string receivedMsg;

        code callback = sub (*data msg) {
            if (msg.typeCode() == NT_STRING) {
                receivedMsg = msg;
                msgReceived.dec();
            }
        };

        # Connect WebSocket client to async SSL server (wss://)
        string wssUrl = "wss://localhost:" + asyncSslPort + "/ws";
        WebSocketClient wsc(callback, {
            "url": wssUrl,
            "timeout": 10s,
            "ssl_verify_cert": False,  # Self-signed cert
        });
        wsc.connect();
        on_exit wsc.disconnect();

        # Verify we're using HTTP/2 (default behavior)
        assertTrue(wsc.isHttp2(), "WebSocket should use HTTP/2 by default over SSL");

        # Send a message and wait for echo
        wsc.send("hello-ssl");
        assertEq(0, msgReceived.waitForZero(5s));
        assertEq("ECHO:hello-ssl", receivedMsg);

        # Send another message
        msgReceived.inc();
        wsc.send("world-ssl");
        assertEq(0, msgReceived.waitForZero(5s));
        assertEq("ECHO:world-ssl", receivedMsg);
    }

    asyncModeWebSocketSslHttp1Test() {
        # Test WebSocket protocol upgrade with async mode over SSL using HTTP/1.1
        # This explicitly disables HTTP/2 to test the HTTP/1.1 upgrade path
        Counter msgReceived(1);
        string receivedMsg;

        code callback = sub (*data msg) {
            if (msg.typeCode() == NT_STRING) {
                receivedMsg = msg;
                msgReceived.dec();
            }
        };

        # Connect WebSocket client to async SSL server (wss://) with HTTP/2 disabled
        string wssUrl = "wss://localhost:" + asyncSslPort + "/ws";
        WebSocketClient wsc(callback, {
            "url": wssUrl,
            "timeout": 10s,
            "ssl_verify_cert": False,  # Self-signed cert
            "http_version": "1.1",  # Force HTTP/1.1 - disables HTTP/2 ALPN negotiation
        });
        wsc.connect();
        on_exit wsc.disconnect();

        # Verify we're NOT using HTTP/2
        assertFalse(wsc.isHttp2(), "WebSocket should use HTTP/1.1 when HTTP/2 is disabled");

        # Send a message and wait for echo
        wsc.send("hello-ssl-http1");
        assertEq(0, msgReceived.waitForZero(5s));
        assertEq("ECHO:hello-ssl-http1", receivedMsg);

        # Send another message
        msgReceived.inc();
        wsc.send("world-ssl-http1");
        assertEq(0, msgReceived.waitForZero(5s));
        assertEq("ECHO:world-ssl-http1", receivedMsg);
    }

    asyncModeWebSocket401ThenSuccessTest() {
        # Test WebSocket connection rejection with 401 followed by successful connection
        # This tests the scenario where a wss:// connection is rejected, then another succeeds
        # Uses HTTP/2 via ALPN (default for wss://)

        # Create a separate async server with authenticating WebSocket handler
        Logger authLogger("auth-ws-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            authLogger.addAppender(new StdoutAppender());
        }
        hash<HttpServerOptionInfo> auth_opts = <HttpServerOptionInfo>{
            "logger": authLogger,
            "debug": True,
            "async_mode": True,
        };
        HttpServer authServer(auth_opts);
        on_exit authServer.stop();

        # Add authenticating WebSocket handler
        AuthenticatingWsHandler authWsHandler({"logger": authLogger});
        authServer.setHandler("auth-ws", "/ws", NOTHING, authWsHandler);

        # Add HTTPS listener
        int authSslPort = authServer.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        }).port;

        # Wait for async I/O to start
        sleep(100ms);

        # First attempt: Connect WITHOUT valid token - should get 401
        string wssUrlNoToken = "wss://localhost:" + authSslPort + "/ws";
        bool gotRejection = False;
        try {
            WebSocketClient wscBad(sub (*data msg) {}, {
                "url": wssUrlNoToken,
                "timeout": 10s,
                "ssl_verify_cert": False,
            });
            wscBad.connect();
            # If we get here, connection succeeded when it shouldn't have
            wscBad.disconnect();
            assertFalse(True, "Connection without token should have been rejected with 401");
        } catch (hash<ExceptionInfo> ex) {
            # Expected - should get an error due to 401 rejection
            # HTTP/2 WebSocket uses CONNECT method which gives HTTP2-CONNECT-ERROR on rejection
            gotRejection = True;
            if (m_options.verbose > 2) {
                printf("Got expected error on 401 rejection: %s: %s\n", ex.err, ex.desc);
            }
            # Verify the error mentions 401 or is a WebSocket/HTTP2 error
            assertTrue(ex.desc.regex("401") || ex.desc.regex("[Uu]nauthorized") ||
                ex.err == "WEBSOCKET-ERROR" || ex.err == "HTTP-CLIENT-RECEIVE-ERROR" ||
                ex.err == "HTTP2-CONNECT-ERROR",
                sprintf("Error should be related to 401 rejection, got: %s: %s", ex.err, ex.desc));
        }
        assertTrue(gotRejection, "First connection without token should be rejected");

        # Second attempt: Connect WITH valid token - should succeed
        Counter msgReceived(1);
        string receivedMsg;
        code callback = sub (*data msg) {
            if (msg.typeCode() == NT_STRING) {
                receivedMsg = msg;
                msgReceived.dec();
            }
        };

        string wssUrl = "wss://localhost:" + authSslPort + "/ws";
        WebSocketClient wscGood(callback, {
            "url": wssUrl,
            "timeout": 10s,
            "ssl_verify_cert": False,
        });
        wscGood.connect({
            "hdr": {
                "Authorization": "Bearer " + AuthenticatingWsHandler::ValidToken,
            },
        });
        on_exit wscGood.disconnect();

        # Verify connection is using HTTP/2
        assertTrue(wscGood.isHttp2(), "WebSocket with valid token should use HTTP/2 over SSL");

        # Send a message and verify echo
        wscGood.send("authenticated-message");
        assertEq(0, msgReceived.waitForZero(5s), "Should receive echo message");
        assertEq("ECHO:authenticated-message", receivedMsg);
    }

    asyncModePersistentHandlerTest() {
        # Test that persistent handlers in async mode get thread affinity
        # Set up server with persistent handler
        Logger persistLogger("persist-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            persistLogger.addAppender(new StdoutAppender());
        }
        hash<HttpServerOptionInfo> persist_opts = <HttpServerOptionInfo>{
            "logger": persistLogger,
            "debug": True,
            "async_mode": True,
        };
        HttpServer persistServer(persist_opts);
        on_exit persistServer.stop();

        PersistentTestHandler handler();
        persistServer.setHandler("persistent", "/persistent", MimeTypeHtml, handler);
        persistServer.setDefaultHandler("persistent", handler);
        int persistPort = persistServer.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        string persistUrl = "http://localhost:" + persistPort;

        # Create client with keep-alive
        HTTPClient client({"url": persistUrl, "timeout": 10s});
        client.connect();
        on_exit client.disconnect();

        # First request - starts persistent mode
        hash<auto> resp1 = client.send("start", "POST", "/persistent/start");
        assertEq(200, resp1.status_code);
        assertEq("started", resp1.body);
        int tid1 = resp1."x-thread-id".toInt();
        assertTrue(tid1 > 0, "Thread ID should be positive");

        # Second request - should be on same thread (thread affinity)
        hash<auto> resp2 = client.send("continue", "POST", "/persistent/continue");
        assertEq(200, resp2.status_code);
        assertEq("continued", resp2.body);
        int tid2 = resp2."x-thread-id".toInt();
        assertEq(tid1, tid2, "Persistent requests should be handled by same thread");

        # Third request - still on same thread
        hash<auto> resp3 = client.send("more", "POST", "/persistent/continue");
        assertEq(200, resp3.status_code);
        int tid3 = resp3."x-thread-id".toInt();
        assertEq(tid1, tid3, "All persistent requests should be on same thread");

        # End persistent mode
        hash<auto> resp4 = client.send("end", "POST", "/persistent/end");
        assertEq(200, resp4.status_code);
        assertEq("ended", resp4.body);
    }

    asyncModePersistentToNonPersistentTest() {
        # Test transition from persistent to non-persistent mode
        Logger transLogger("trans-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            transLogger.addAppender(new StdoutAppender());
        }
        hash<HttpServerOptionInfo> trans_opts = <HttpServerOptionInfo>{
            "logger": transLogger,
            "debug": True,
            "async_mode": True,
        };
        HttpServer transServer(trans_opts);
        on_exit transServer.stop();

        PersistentTestHandler handler();
        transServer.setHandler("persistent", "/persistent", MimeTypeHtml, handler);
        transServer.setDefaultHandler("persistent", handler);
        int transPort = transServer.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        string transUrl = "http://localhost:" + transPort;

        HTTPClient client({"url": transUrl, "timeout": 10s});
        client.connect();
        on_exit client.disconnect();

        # Start persistent mode
        hash<auto> resp1 = client.send("start", "POST", "/persistent/start");
        assertEq(200, resp1.status_code);

        # End persistent mode
        hash<auto> resp2 = client.send("end", "POST", "/persistent/end");
        assertEq(200, resp2.status_code);
        assertEq("ended", resp2.body);

        # Next request after persistence ended - may be on different thread
        # (this tests that connection returns to async I/O)
        hash<auto> resp3 = client.send("normal", "POST", "/persistent/normal");
        assertEq(200, resp3.status_code);
        # We don't assert thread ID here as it may or may not be the same
    }

    asyncModePersistentConnectionCloseTest() {
        # Test that connection close during persistent mode is handled correctly
        Logger closeLogger("close-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            closeLogger.addAppender(new StdoutAppender());
        }
        hash<HttpServerOptionInfo> close_opts = <HttpServerOptionInfo>{
            "logger": closeLogger,
            "debug": True,
            "async_mode": True,
        };
        HttpServer closeServer(close_opts);
        on_exit closeServer.stop();

        PersistentTestHandler handler();
        closeServer.setHandler("persistent", "/persistent", MimeTypeHtml, handler);
        closeServer.setDefaultHandler("persistent", handler);
        int closePort = closeServer.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        string closeUrl = "http://localhost:" + closePort;

        {
            HTTPClient client({"url": closeUrl, "timeout": 10s});
            client.connect();

            # Start persistent mode
            hash<auto> resp1 = client.send("start", "POST", "/persistent/start");
            assertEq(200, resp1.status_code);

            # Close connection without ending persistence
            client.disconnect();
        }

        # Server should handle the abrupt disconnect gracefully
        # Try connecting again to verify server is still working
        {
            HTTPClient client2({"url": closeUrl, "timeout": 10s});
            client2.connect();
            on_exit client2.disconnect();

            hash<auto> resp = client2.send("normal", "POST", "/persistent/normal");
            assertEq(200, resp.status_code);
        }
    }

    asyncModePersistentErrorTest() {
        # Test error handling during persistent connection
        Logger errLogger("err-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            errLogger.addAppender(new StdoutAppender());
        }
        hash<HttpServerOptionInfo> err_opts = <HttpServerOptionInfo>{
            "logger": errLogger,
            "debug": True,
            "async_mode": True,
        };
        HttpServer errServer(err_opts);
        on_exit errServer.stop();

        PersistentTestHandler handler();
        errServer.setHandler("persistent", "/persistent", MimeTypeHtml, handler);
        errServer.setDefaultHandler("persistent", handler);
        int errPort = errServer.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        string errUrl = "http://localhost:" + errPort;

        HTTPClient client({"url": errUrl, "timeout": 10s});
        client.connect();
        on_exit client.disconnect();

        # Start persistent mode
        hash<auto> resp1 = client.send("start", "POST", "/persistent/start");
        assertEq(200, resp1.status_code);

        # Request that triggers an error - HTTPClient throws on 500 responses
        # The server closes the connection on errors during persistent mode
        try {
            hash<auto> resp2 = client.send("error", "POST", "/persistent/error");
            assertEq(500, resp2.status_code);
        } catch (hash<ExceptionInfo> ex) {
            # HTTPClient throws HTTP-CLIENT-RECEIVE-ERROR on 500 status
            assertEq("HTTP-CLIENT-RECEIVE-ERROR", ex.err);
            assertEq(500, ex.arg.status_code);
        }

        # Verify server is still accepting connections
        HTTPClient client2({"url": errUrl, "timeout": 10s});
        client2.connect();
        on_exit client2.disconnect();

        hash<auto> resp3 = client2.send("normal", "POST", "/persistent/normal");
        assertEq(200, resp3.status_code);
    }

    asyncModePersistentConcurrentTest() {
        # Test multiple concurrent persistent connections
        Logger concLogger("conc-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            concLogger.addAppender(new StdoutAppender());
        }
        hash<HttpServerOptionInfo> conc_opts = <HttpServerOptionInfo>{
            "logger": concLogger,
            "debug": True,
            "async_mode": True,
        };
        HttpServer concServer(conc_opts);
        on_exit concServer.stop();

        PersistentTestHandler handler();
        concServer.setHandler("persistent", "/persistent", MimeTypeHtml, handler);
        concServer.setDefaultHandler("persistent", handler);
        int concPort = concServer.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        string concUrl = "http://localhost:" + concPort;

        # Create multiple clients
        list<HTTPClient> clients = ();
        list<int> threadIds = ();

        for (int i = 0; i < 3; i++) {
            HTTPClient client({"url": concUrl, "timeout": 10s});
            client.connect();
            push clients, client;

            # Start persistent mode for each client
            hash<auto> resp = client.send("start", "POST", "/persistent/start");
            assertEq(200, resp.status_code);
            push threadIds, resp."x-thread-id".toInt();
        }

        # Each client should have its own thread (thread affinity)
        # Verify by making more requests
        for (int i = 0; i < 3; i++) {
            hash<auto> resp = clients[i].send("continue", "POST", "/persistent/continue");
            assertEq(200, resp.status_code);
            int currentTid = resp."x-thread-id".toInt();
            assertEq(threadIds[i], currentTid, sprintf("Client %d should maintain thread affinity", i));
        }

        # Different clients may or may not have different thread IDs depending on timing
        # The important thing is that each client maintains its OWN thread affinity

        # Clean up
        for (int i = 0; i < 3; i++) {
            hash<auto> resp = clients[i].send("end", "POST", "/persistent/end");
            assertEq(200, resp.status_code);
            clients[i].disconnect();
        }
    }

    asyncModeNonPersistentTest() {
        # Negative test: verify non-persistent requests work normally in async mode
        Logger npLogger("np-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            npLogger.addAppender(new StdoutAppender());
        }
        hash<HttpServerOptionInfo> np_opts = <HttpServerOptionInfo>{
            "logger": npLogger,
            "debug": True,
            "async_mode": True,
        };
        HttpServer npServer(np_opts);
        on_exit npServer.stop();

        PersistentTestHandler handler();
        npServer.setHandler("persistent", "/persistent", MimeTypeHtml, handler);
        npServer.setDefaultHandler("persistent", handler);
        int npPort = npServer.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        string npUrl = "http://localhost:" + npPort;

        HTTPClient client({"url": npUrl, "timeout": 10s});
        client.connect();
        on_exit client.disconnect();

        # Make multiple non-persistent requests
        # These should NOT trigger synchronous mode
        for (int i = 0; i < 5; i++) {
            hash<auto> resp = client.send("normal", "POST", "/persistent/normal");
            assertEq(200, resp.status_code);
            assertEq("normal", resp.body);
        }
    }

    asyncModePersistentWithSyncServerTest() {
        # Test that sync mode server still works with persistent handlers
        # (This verifies we didn't break sync mode)
        Logger syncLogger("sync-persist-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            syncLogger.addAppender(new StdoutAppender());
        }
        hash<HttpServerOptionInfo> sync_opts = <HttpServerOptionInfo>{
            "logger": syncLogger,
            "debug": True,
            "async_mode": False,  # Sync mode
        };
        HttpServer syncServer(sync_opts);
        on_exit syncServer.stop();

        PersistentTestHandler handler();
        syncServer.setHandler("persistent", "/persistent", MimeTypeHtml, handler);
        syncServer.setDefaultHandler("persistent", handler);
        int syncPort = syncServer.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        string syncUrl = "http://localhost:" + syncPort;

        HTTPClient client({"url": syncUrl, "timeout": 10s});
        client.connect();
        on_exit client.disconnect();

        # Start persistent mode
        hash<auto> resp1 = client.send("start", "POST", "/persistent/start");
        assertEq(200, resp1.status_code);
        int tid1 = resp1."x-thread-id".toInt();

        # Continue in persistent mode
        hash<auto> resp2 = client.send("continue", "POST", "/persistent/continue");
        assertEq(200, resp2.status_code);
        int tid2 = resp2."x-thread-id".toInt();

        # In sync mode, requests should also be on the same thread
        assertEq(tid1, tid2, "Sync mode persistent requests should be on same thread");

        # End persistent mode
        hash<auto> resp3 = client.send("end", "POST", "/persistent/end");
        assertEq(200, resp3.status_code);
    }

    asyncModeHttp2Test() {
        # Test HTTP/2 support in async mode
        # This test requires:
        # 1. HTTPClient with HTTP/2 enabled
        # 2. HTTPS connection (HTTP/2 requires TLS for ALPN)

        # Create HTTPClient with HTTP/2 auto mode
        HTTPClient h2client({
            "url": asyncSslUrl,
            "timeout": 10s,
            "ssl_verify_cert": False,  # Self-signed cert
            "http_version": "auto",    # Enable HTTP/2 if available
        });

        # Check if HTTP/2 mode is supported
        if (!h2client.isHttp2Enabled()) {
            testSkip("HTTP/2 not compiled in");
            return;
        }

        # Verify HTTP/2 mode settings
        assertEq("auto", h2client.getHttp2Mode());
        assertTrue(h2client.isHttp2Enabled());

        # Connect and make request
        h2client.connect();
        on_exit h2client.disconnect();

        # Make a request - protocol negotiation happens during TLS handshake
        string resp = h2client.get("/http2-test");

        # Check what HTTP version was negotiated
        string version = h2client.getHttpVersion();

        # The response should be successful regardless of protocol
        assertEq("GET, http2-test, /http2-test", resp);

        # Log which protocol was used
        if (m_options.verbose > 0) {
            printf("HTTP/2 test: negotiated version = %s, isHttp2Active = %y\n",
                version, h2client.isHttp2Active());
        }

        # Test that response-uri is set correctly for HTTP/2 responses
        # This is needed for tools like 'rest -l' that display the response status line
        {
            hash<auto> info;
            h2client.send(NOTHING, "GET", "/http2-test", NOTHING, False, \info);
            # Verify response-uri is set in the format "HTTP/2 <code> <message>"
            assertTrue(info."response-uri".val(), "response-uri should be set for HTTP/2");
            assertRegex("^HTTP/2 200", info."response-uri", "response-uri should start with HTTP/2 200");
            if (m_options.verbose > 0) {
                printf("HTTP/2 response-uri: %y\n", info."response-uri");
            }
        }

        # Test keep-alive with multiple requests (verifies HTTP/2 connection state preservation)
        # This is critical for browser compatibility - browsers reuse HTTP/2 connections
        for (int i = 1; i <= 5; i++) {
            string path = sprintf("/test%d", i);
            string expected = sprintf("GET, test%d, %s", i, path);
            assertEq(expected, h2client.get(path));
        }

        # Verify HTTP/2 is still active after multiple requests
        assertTrue(h2client.isHttp2Active());

        # Test larger payloads - this exercises the HTTP/2 DATA frame handling with substantial data
        # These sizes are chosen to test different scenarios:
        # - 50KB: moderate size
        # - 100KB: larger response
        # - 500KB: tests flow control and multiple DATA frames
        list<int> sizes = (50000, 100000, 500000);
        for (int i = 0; i < sizes.size(); i++) {
            int size = sizes[i];
            hash<auto> large_resp = h2client.send(NOTHING, "GET", "/largeresponse/" + size, NOTHING, True);
            assertEq(200, large_resp.status_code);
            assertEq(size, large_resp.body.size());
            # Verify HTTP/2 connection is still active after large transfer
            assertTrue(h2client.isHttp2Active());
        }

        # Test HTTP/2 compression - this was a bug where Accept-Encoding wasn't being parsed for HTTP/2
        # The server should compress responses > 1KB when Accept-Encoding is provided
        {
            # Create a new HTTP/2 client that doesn't auto-decompress
            HTTPClient h2compress({
                "url": asyncSslUrl,
                "timeout": 10s,
                "ssl_verify_cert": False,
                "http_version": "2",
            });
            h2compress.connect();
            on_exit h2compress.disconnect();

            # Request a 5KB response (well above the 1KB compression threshold)
            # Send explicit Accept-Encoding header
            hash<auto> hdr = {
                "Accept-Encoding": "gzip, deflate, br",
            };
            hash<auto> info;
            h2compress.send(NOTHING, "GET", "/largeresponse/5000", hdr, False, \info);
            # Verify the response was compressed (Content-Encoding should be set)
            # Note: HTTPClient auto-decompresses, so we check the original response headers
            *string content_encoding = info."response-headers"."content-encoding"
                ?? info."response-headers"."Content-Encoding";
            if (m_options.verbose > 0) {
                printf("HTTP/2 compression test: Content-Encoding = %y\n", content_encoding);
            }
            assertTrue(content_encoding.val(), "HTTP/2 response should be compressed");
        }

        # Test POST request
        hash<auto> postResp = h2client.send("http2-data", "POST", "/http2-post");
        assertEq(200, postResp.status_code);
        assertEq("POST, http2-data, http2-post, /http2-post", postResp.body);

        # Test HTTP/2 POST with large request bodies
        # This exercises HTTP/2 DATA frame handling for request bodies
        # These sizes test different scenarios:
        # - 50KB: moderate size, multiple DATA frames
        # - 100KB: larger request body
        # - 500KB: tests flow control with large uploads
        list<int> post_sizes = (50000, 100000, 500000);
        for (int j = 0; j < post_sizes.size(); j++) {
            int post_size = post_sizes[j];
            string large_body = strmul("X", post_size);
            hash<auto> post_resp = h2client.send(large_body, "POST", "/echo-body");
            assertEq(200, post_resp.status_code, sprintf("HTTP/2 POST %d bytes should succeed", post_size));
            assertEq(post_size, post_resp.body.size(), sprintf("HTTP/2 POST %d bytes - response body size", post_size));
            assertEq(large_body, post_resp.body, sprintf("HTTP/2 POST %d bytes - body content", post_size));
            # Verify HTTP/2 connection is still active after large upload
            assertTrue(h2client.isHttp2Active(), sprintf("HTTP/2 active after %d byte POST", post_size));
        }

        # Test HTTP/2 disabled mode
        HTTPClient h1client({
            "url": asyncSslUrl,
            "timeout": 10s,
            "ssl_verify_cert": False,
            "http_version": "1.1",    # Force HTTP/1.1
        });

        if (h1client.isHttp2Enabled()) {
            # If HTTP/2 is compiled in, "1.1" mode should disable it
            assertEq("disabled", h1client.getHttp2Mode());
            assertFalse(h1client.isHttp2Enabled());
        }

        h1client.connect();
        on_exit h1client.disconnect();

        # This should work with HTTP/1.1
        assertEq("GET, h1test, /h1test", h1client.get("/h1test"));
        assertFalse(h1client.isHttp2Active());

        # Test set_global_http2_mode("disabled") - server should not offer HTTP/2
        {
            # Save original mode
            string orig_mode = get_global_http2_mode();
            on_exit set_global_http2_mode(orig_mode);

            # Disable HTTP/2 globally
            set_global_http2_mode("disabled");
            assertEq("disabled", get_global_http2_mode());

            # Create a new HTTPS listener that will be affected by the global mode
            # The async server's listeners are cached, so we need a new one to test
            hash<auto> linfo = mAsyncServer.addListener(<HttpListenerOptionInfo>{
                "service": 0,
                "cert": new SSLCertificate(CertPem),
                "key": new SSLPrivateKey(KeyPem),
            });
            on_exit mAsyncServer.stopListenerID(linfo.id);

            string disabledUrl = "https://localhost:" + linfo.port;

            # Create an HTTP/2 client and try to connect - it should fall back to HTTP/1.1
            # because the server won't offer HTTP/2 via ALPN
            HTTPClient h2disabled({
                "url": disabledUrl,
                "timeout": 10s,
                "ssl_verify_cert": False,
                "http_version": "2",    # Client wants HTTP/2
            });
            h2disabled.connect();
            on_exit h2disabled.disconnect();

            # The client should fall back to HTTP/1.1 because server doesn't offer HTTP/2
            assertFalse(h2disabled.isHttp2Active(), "HTTP/2 should not be active when globally disabled");

            # Request should still work via HTTP/1.1
            assertEq("GET, h2disabled, /h2disabled", h2disabled.get("/h2disabled"));
        }
    }

}

#! Test handler that supports persistent connections
class PersistentTestHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        string path = hdr.path;
        int tid = gettid();

        if (path =~ /start$/) {
            # Start persistent mode
            setPersistent(True);
            return makeResponse({"x-thread-id": string(tid)}, 200, "started");
        } else if (path =~ /continue$/) {
            # Continue in persistent mode (verify we're persistent)
            if (!isPersistent()) {
                return makeResponse({"x-thread-id": string(tid)}, 500, "not persistent");
            }
            return makeResponse({"x-thread-id": string(tid)}, 200, "continued");
        } else if (path =~ /end$/) {
            # End persistent mode
            setPersistent(False);
            return makeResponse({"x-thread-id": string(tid)}, 200, "ended");
        } else if (path =~ /error$/) {
            # Trigger an error
            throw "TEST-ERROR", "Intentional test error";
        } else if (path =~ /normal$/) {
            # Non-persistent request
            return makeResponse({"x-thread-id": string(tid)}, 200, "normal");
        }

        return makeResponse({"x-thread-id": string(tid)}, 404, "not found");
    }
}

