    FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
    DEALINGS IN THE SOFTWARE.

    Tests for non-blocking InputStream streaming responses across HTTP/1.x,
    HTTP/2, and HTTP/3.

    Tests cover:
    - HTTP/1.x: InputStream response with Content-Length (fused keep-alive path)
    - HTTP/1.x: InputStream response with Content-Length (close path)
    - HTTP/1.x: multiple sequential keep-alive requests with InputStream response
    - HTTP/2: InputStream streaming response (no Content-Length required)
    - HTTP/2: concurrent multiplexed InputStream responses
    - HTTP/3: InputStream streaming response
    - HTTP/3: concurrent multiplexed InputStream responses
*/

%modern

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Mime.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/HttpServerUtil.qm
%requires ../../../../qlib/AsyncSocketIo
%requires ../../../../qlib/HttpServerAsyncIo
%requires ../../../../qlib/HttpServer.qm
%requires ../../../../qlib/Http3ClientIo

%exec-class HttpServerAsyncStreamingResponseTest

#! Size of the large payload (>2MB to trigger InputStream response path)
const LargePayloadSize = 3 * 1024 * 1024;  # 3 MB

#! Size of a small payload for regression testing
const SmallPayloadSize = 1024;  # 1 KB

#! Generates a deterministic binary payload of the given size
binary sub generatePayload(int size) {
    # Use strmul to create a single repeating character string, then convert to binary
    return binary(strmul("X", size));
}

#! Handler that returns a large InputStream with Content-Length
#! (triggers the new non-blocking poll operation path for HTTP/1.x)
class LargeStreamHandler inherits AbstractHttpRequestHandler {
    private {
        binary payload;
    }

    constructor(binary payload) {
        self.payload = payload;
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        # Return InputStream in body field with explicit Content-Length
        # This triggers the non-blocking InputStream poll path for HTTP/1.x
        # and the I/O-thread InputStream path for HTTP/2 and HTTP/3
        return <HttpResponseInfo>{
            "code": 200,
            "body": new BinaryInputStream(payload),
            "hdr": {
                "Content-Type": "application/octet-stream",
                "Content-Length": string(payload.size()),
            },
        };
    }
}

#! Handler that returns a large InputStream via chunked transfer encoding (no Content-Length)
class LargeChunkedHandler inherits AbstractHttpRequestHandler {
    private {
        binary payload;
    }

    constructor(binary payload) {
        self.payload = payload;
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, new BinaryInputStream(payload), {
            "Content-Type": "application/octet-stream",
        });
    }
}

#! InputStream that returns fewer bytes than expected, then EOF
class ShortInputStream inherits InputStream {
    private {
        int remaining;
    }

    constructor(int actual_bytes) {
        remaining = actual_bytes;
    }

    int read(binary buf, int limit) {
        if (remaining <= 0) {
            return 0;
        }
        int to_read = min(limit, remaining);
        # Fill with 'S' bytes
        binary data = binary(strmul("S", to_read));
        buf += data;
        remaining -= to_read;
        return to_read;
    }

    int peek() {
        return remaining > 0 ? ord("S") : -1;
    }
}

#! Handler that claims Content-Length of 10000 but InputStream only provides 100 bytes
class ShortStreamHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        # Content-Length says 10000 but stream will EOF after 100 bytes
        return <HttpResponseInfo>{
            "code": 200,
            "body": new BinaryInputStream(binary(strmul("S", 100))),
            "hdr": {
                "Content-Type": "application/octet-stream",
                "Content-Length": "10000",
            },
        };
    }
}

#! Handler where Content-Length exactly matches InputStream size (boundary test)
class ExactStreamHandler inherits AbstractHttpRequestHandler {
    private {
        binary payload;
    }

    constructor(binary payload) {
        self.payload = payload;
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return <HttpResponseInfo>{
            "code": 200,
            "body": new BinaryInputStream(payload),
            "hdr": {
                "Content-Type": "application/octet-stream",
                "Content-Length": string(payload.size()),
            },
        };
    }
}

#! Handler that returns a small in-memory response
class SmallHandler inherits AbstractHttpRequestHandler {
    private {
        binary payload;
    }

    constructor(binary payload) {
        self.payload = payload;
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, payload, {
            "Content-Type": "application/octet-stream",
            "Content-Length": string(payload.size()),
        });
    }
}

