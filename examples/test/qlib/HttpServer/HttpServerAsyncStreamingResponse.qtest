    constructor() : Test("HttpServerAsyncStreamingResponseTest", "1.0") {
        @debug {
            set_signal_handler(SIGUSR1, sub (int sig) {
                printf("=== SIGUSR1 Thread Stacks ===\n%Y\n=== End Thread Stacks ===\n",
                    get_all_thread_call_stacks());
            });
        }

        # Generate payloads once
        mLargePayload = generatePayload(LargePayloadSize);
        mSmallPayload = generatePayload(SmallPayloadSize);

        addTestCase("HTTP/1.x small in-memory response (regression)", \testH1SmallResponse());
        addTestCase("HTTP/1.x large InputStream response with Content-Length", \testH1LargeStreamResponse());
        addTestCase("HTTP/1.x sequential keep-alive InputStream responses", \testH1SequentialKeepAlive());
        addTestCase("HTTP/2 large InputStream response", \testH2LargeStreamResponse());
        addTestCase("HTTP/2 concurrent multiplexed InputStream responses", \testH2ConcurrentStreams());
        addTestCase("HTTP/1.x short InputStream Content-Length mismatch", \testH1ShortStream());
        addTestCase("HTTP/2 short InputStream Content-Length mismatch", \testH2ShortStream());
        addTestCase("HTTP/1.x exact Content-Length boundary", \testH1ExactStream());
        addTestCase("HTTP/3 small in-memory response", \testH3SmallResponse());
        addTestCase("HTTP/3 large InputStream response", \testH3LargeStreamResponse());
        addTestCase("HTTP/3 concurrent multiplexed InputStream responses", \testH3ConcurrentStreams());

        set_return_value(main());
    }

    globalSetUp() {
        mLogger = new Logger("async-streaming-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            mLogger.addAppender(new StdoutAppender());
        }
    }

    #! Creates a new async HTTP server with TLS and the streaming response handler
    private hash<auto> createServer(*hash<auto> opts) {
        HttpServer server(<HttpServerOptionInfo>{
            "logger": mLogger,
            "debug": True,
            "async_mode": True,
        });
        server.setHandler("large", "/large", NOTHING, new LargeStreamHandler(mLargePayload));
        server.setHandler("large-chunked", "/large-chunked", NOTHING, new LargeChunkedHandler(mLargePayload));
        server.setHandler("small", "/small", NOTHING, new SmallHandler(mSmallPayload));
        server.setHandler("short-stream", "/short-stream", NOTHING, new ShortStreamHandler());
        server.setHandler("exact-stream", "/exact-stream", NOTHING, new ExactStreamHandler(mSmallPayload));
        server.waitForAsyncIo();

        # Add H2-only TLS listener
        hash<auto> h2info = server.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
            "enable_h3": opts.enable_h3 ?? False,
        });
        server.waitForAsyncIo();

        return {
            "server": server,
            "port": h2info.port,
        };
    }

    #! Creates an HTTP/2 client connected to the given port
    private HTTPClient createH2Client(int port) {
        HTTPClient client({
            "url": sprintf("https://localhost:%d", port),
            "ssl_verify_cert": False,
        });
        return client;
    }

    #! Creates an HTTP/3 client connection manager
    private Http3ClientIo::Http3ClientConnectionManager createH3Manager() {
        return new Http3ClientIo::Http3ClientConnectionManager(
            <Http3ClientIo::Http3ClientConnectionManagerOptions>{
                "logger": mLogger,
                "request_timeout": 30s,
                "connect_timeout": 15s,
            },
        );
    }

    # ---- HTTP/1.x Tests ----

    #! Regression: small response should still work with in-memory path
    testH1SmallResponse() {
        hash<auto> setup = createServer();
        HttpServer server = setup.server;
        on_exit delete server;

        HTTPClient client({
            "url": sprintf("https://localhost:%d", setup.port),
            "ssl_verify_cert": False,
            "http_version": "1.1",
        });
        on_exit client.disconnect();

        hash<auto> resp = client.send(NOTHING, "GET", "/small");
        assertEq(200, resp.status_code, "H1 small response status");
        binary resp_body;
        if (resp.body.typeCode() == NT_BINARY) {
            resp_body = resp.body;
        } else {
            resp_body = binary(resp.body);
        }
        assertEq(mSmallPayload.size(), resp_body.size(), "H1 small response body size");
        assertEq(mSmallPayload, resp_body, "H1 small response body content");
    }

    #! Large InputStream response via the new non-blocking poll operation (with Content-Length)
    testH1LargeStreamResponse() {
        hash<auto> setup = createServer();
        HttpServer server = setup.server;
        on_exit delete server;

        HTTPClient client({
            "url": sprintf("https://localhost:%d", setup.port),
            "ssl_verify_cert": False,
            "http_version": "1.1",
        });
        on_exit client.disconnect();

        date start = now_us();
        hash<auto> resp = client.send(NOTHING, "GET", "/large");
        mLargeTransferTime = now_us() - start;

        assertEq(200, resp.status_code, "H1 large stream response status");
        binary resp_body;
        if (resp.body.typeCode() == NT_BINARY) {
            resp_body = resp.body;
        } else {
            resp_body = binary(resp.body);
        }
        assertEq(LargePayloadSize, resp_body.size(), "H1 large stream response body size");
        assertEq(mLargePayload, resp_body, "H1 large stream response body matches");

        # Verify Content-Length was set (not chunked)
        assertEq(string(LargePayloadSize), resp."content-length",
            "H1 large stream response has Content-Length");
    }

    #! Sequential keep-alive requests: verifies the fused path (send stream + idle + read header)
    testH1SequentialKeepAlive() {
        if (mLargeTransferTime > 30s) {
            testSkip(sprintf("skipping 3x 3MB sequential transfers (single transfer: %y)", mLargeTransferTime));
        }
        hash<auto> setup = createServer();
        HttpServer server = setup.server;
        on_exit delete server;

        HTTPClient client({
            "url": sprintf("https://localhost:%d", setup.port),
            "ssl_verify_cert": False,
            "http_version": "1.1",
        });
        on_exit client.disconnect();

        # Send 3 sequential requests on the same keep-alive connection
        for (int i = 0; i < 3; i++) {
            hash<auto> resp = client.send(NOTHING, "GET", "/large");
            assertEq(200, resp.status_code,
                sprintf("H1 keep-alive request %d status", i + 1));
            binary resp_body;
            if (resp.body.typeCode() == NT_BINARY) {
                resp_body = resp.body;
            } else {
                resp_body = binary(resp.body);
            }
            assertEq(LargePayloadSize, resp_body.size(),
                sprintf("H1 keep-alive request %d body size", i + 1));
            assertEq(mLargePayload, resp_body,
                sprintf("H1 keep-alive request %d body matches", i + 1));
        }
    }

    # ---- Content-Length Mismatch Tests ----

    #! HTTP/1.x: InputStream provides fewer bytes than Content-Length → error or truncated
    testH1ShortStream() {
        hash<auto> setup = createServer();
        HttpServer server = setup.server;
        on_exit delete server;

        HTTPClient client({
            "url": sprintf("https://localhost:%d", setup.port),
            "ssl_verify_cert": False,
            "timeout": 10000,
        });

        # The server handler claims Content-Length: 10000 but InputStream only has 100 bytes
        # The server should detect the mismatch and the client should get an error
        bool got_error = False;
        try {
            hash<auto> resp = client.send(NOTHING, "GET", "/short-stream");
            # If we get a response, the body should be shorter than Content-Length
            # (connection may be closed early due to the server-side error)
            *binary resp_body;
            if (resp.body.typeCode() == NT_BINARY) {
                resp_body = resp.body;
            } else if (resp.body.typeCode() == NT_STRING) {
                resp_body = binary(resp.body);
            }
            if (!resp_body || resp_body.size() < 10000) {
                got_error = True;
            }
        } catch (hash<ExceptionInfo> ex) {
            got_error = True;
            if (m_options.verbose > 1) {
                printf("H1 short stream caught: %s: %s\n", ex.err, ex.desc);
            }
            # The server detects the mismatch; the client sees a socket/HTTP read error
            # because the server closes the connection after detecting the Content-Length
            # vs actual bytes mismatch
            assertRegex("SOCKET|HTTP", ex.err,
                "H1 short stream: expected socket/HTTP error");
        }
        assertTrue(got_error, "H1 short stream: Content-Length mismatch detected");
    }

    #! HTTP/2: InputStream provides fewer bytes than Content-Length → error propagated
    testH2ShortStream() {
        hash<auto> setup = createServer();
        HttpServer server = setup.server;
        on_exit delete server;

        HTTPClient client({
            "url": sprintf("https://localhost:%d", setup.port),
            "ssl_verify_cert": False,
            "http_version": "2.0",
            "timeout": 10000,
        });

        # The server handler claims Content-Length: 10000 but InputStream only has 100 bytes
        # HTTP/2 should propagate this as a stream error (RST_STREAM or incomplete response)
        bool got_error = False;
        try {
            hash<auto> resp = client.send(NOTHING, "GET", "/short-stream");
            *binary resp_body;
            if (resp.body.typeCode() == NT_BINARY) {
                resp_body = resp.body;
            } else if (resp.body.typeCode() == NT_STRING) {
                resp_body = binary(resp.body);
            }
            if (!resp_body || resp_body.size() < 10000) {
                got_error = True;
            }
        } catch (hash<ExceptionInfo> ex) {
            got_error = True;
            if (m_options.verbose > 1) {
                printf("H2 short stream caught: %s: %s\n", ex.err, ex.desc);
            }
            # HTTP/2: the server detects the InputStream EOF and resets the stream;
            # the client sees an HTTP2 stream error or socket error
            assertRegex("HTTP2|SOCKET|HTTP", ex.err,
                "H2 short stream: expected HTTP2/socket error");
        }
        assertTrue(got_error, "H2 short stream: Content-Length mismatch detected");
    }

    #! HTTP/1.x: InputStream provides exactly Content-Length bytes → success
    testH1ExactStream() {
        hash<auto> setup = createServer();
        HttpServer server = setup.server;
        on_exit delete server;

        HTTPClient client({
            "url": sprintf("https://localhost:%d", setup.port),
            "ssl_verify_cert": False,
            "timeout": 10000,
        });

        # Content-Length exactly matches InputStream size — should succeed
        hash<auto> resp = client.send(NOTHING, "GET", "/exact-stream");
        assertEq(200, resp.status_code);
        binary resp_body;
        if (resp.body.typeCode() == NT_BINARY) {
            resp_body = resp.body;
        } else if (resp.body.typeCode() == NT_STRING) {
            resp_body = binary(resp.body);
        }
        assertEq(mSmallPayload.size(), resp_body.size(),
            "exact stream: received full Content-Length payload");
        assertEq(mSmallPayload, resp_body,
            "exact stream: payload integrity");
    }

    # ---- HTTP/2 Tests ----

    #! Large InputStream response over HTTP/2
    testH2LargeStreamResponse() {
        if (mLargeTransferTime > 60s) {
            testSkip(sprintf("skipping 3MB H2 transfer (H1 transfer: %y)", mLargeTransferTime));
        }
        hash<auto> setup = createServer();
        HttpServer server = setup.server;
        on_exit delete server;

        HTTPClient client = createH2Client(setup.port);
        on_exit client.disconnect();

        hash<auto> resp = client.send(NOTHING, "GET", "/large");
        assertEq(200, resp.status_code, "H2 large stream response status");
        binary resp_body;
        if (resp.body.typeCode() == NT_BINARY) {
            resp_body = resp.body;
        } else {
            resp_body = binary(resp.body);
        }
        assertEq(LargePayloadSize, resp_body.size(), "H2 large stream response body size");
        assertEq(mLargePayload, resp_body, "H2 large stream response body matches");
    }

    #! Multiple concurrent requests over HTTP/2 (multiplexed streams)
    testH2ConcurrentStreams() {
        # Under valgrind (~20-50x slowdown), 4 concurrent 3MB transfers exceed
        # the 300s HTTP/2 protocol timeout
        if (mLargeTransferTime > 30s) {
            testSkip(sprintf("skipping 4x 3MB concurrent H2 transfers (single transfer: %y)", mLargeTransferTime));
        }
        hash<auto> setup = createServer();
        HttpServer server = setup.server;
        on_exit delete server;

        int num_requests = 4;
        Counter cnt(num_requests);
        Mutex m();
        list<hash<auto>> results = ();

        for (int i = 0; i < num_requests; i++) {
            int idx = i;
            background sub() {
                on_exit cnt.dec();
                try {
                    # Each thread creates its own HTTP/2 connection
                    HTTPClient client = createH2Client(setup.port);
                    on_exit client.disconnect();

                    hash<auto> resp = client.send(NOTHING, "GET", "/large");
                    binary resp_body;
                    if (resp.body.typeCode() == NT_BINARY) {
                        resp_body = resp.body;
                    } else {
                        resp_body = binary(resp.body);
                    }
                    m.lock();
                    on_exit m.unlock();
                    push results, {
                        "idx": idx,
                        "status": resp.status_code,
                        "size": resp_body.size(),
                        "match": resp_body == mLargePayload,
                    };
                } catch (hash<ExceptionInfo> ex) {
                    m.lock();
                    on_exit m.unlock();
                    push results, {
                        "idx": idx,
                        "error": sprintf("%s: %s", ex.err, ex.desc),
                    };
                }
            }();
        }
        cnt.waitForZero();

        assertEq(num_requests, results.size(), "H2 concurrent: all requests completed");
        for (int i = 0; i < results.size(); i++) {
            hash<auto> r = results[i];
            if (r.error) {
                assertTrue(False, sprintf("H2 concurrent request %d failed: %s", r.idx, r.error));
                continue;
            }
            assertEq(200, r.status, sprintf("H2 concurrent request %d status", r.idx));
            assertEq(LargePayloadSize, r.size, sprintf("H2 concurrent request %d body size", r.idx));
            assertTrue(r.match, sprintf("H2 concurrent request %d body matches", r.idx));
        }
    }

    # ---- HTTP/3 Tests ----

    #! Large InputStream response over HTTP/3
    testH3SmallResponse() {
        hash<auto> setup = createServer({"enable_h3": True});
        HttpServer server = setup.server;
        on_exit delete server;

        Http3ClientIo::Http3ClientConnectionManager mgr = createH3Manager();
        on_exit delete mgr;

        string url = sprintf("https://127.0.0.1:%d", setup.port);
        hash<auto> resp = mgr.request(url, "GET", "/small");
        assertEq(200, resp.status_code, "H3 small response status");
        binary resp_body;
        if (resp.body.typeCode() == NT_BINARY) {
            resp_body = resp.body;
        } else {
            resp_body = binary(resp.body);
        }
        assertEq(SmallPayloadSize, resp_body.size(), "H3 small response body size");
    }

    testH3LargeStreamResponse() {
        if (mLargeTransferTime > 60s) {
            testSkip(sprintf("skipping 3MB H3 transfer (H1 transfer: %y)", mLargeTransferTime));
        }
        hash<auto> setup = createServer({"enable_h3": True});
        HttpServer server = setup.server;
        on_exit delete server;

        Http3ClientIo::Http3ClientConnectionManager mgr = createH3Manager();
        on_exit delete mgr;

        string url = sprintf("https://127.0.0.1:%d", setup.port);
        hash<auto> resp = mgr.request(url, "GET", "/large");
        assertEq(200, resp.status_code, "H3 large stream response status");
        binary resp_body;
        if (resp.body.typeCode() == NT_BINARY) {
            resp_body = resp.body;
        } else {
            resp_body = binary(resp.body);
        }
        assertEq(LargePayloadSize, resp_body.size(), "H3 large stream response body size");
        assertEq(mLargePayload, resp_body, "H3 large stream response body matches");
    }

    #! Multiple concurrent HTTP/3 requests
    testH3ConcurrentStreams() {
        if (mLargeTransferTime > 30s) {
            testSkip(sprintf("skipping 4x 3MB concurrent H3 transfers (single transfer: %y)", mLargeTransferTime));
        }
        hash<auto> setup = createServer({"enable_h3": True});
        HttpServer server = setup.server;
        on_exit delete server;

        int num_requests = 4;
        Counter cnt(num_requests);
        Mutex m();
        list<hash<auto>> results = ();
        string url = sprintf("https://127.0.0.1:%d", setup.port);

        for (int i = 0; i < num_requests; i++) {
            int idx = i;
            background sub() {
                on_exit cnt.dec();
                try {
                    Http3ClientIo::Http3ClientConnectionManager mgr = createH3Manager();
                    on_exit delete mgr;

                    hash<auto> resp = mgr.request(url, "GET", "/large");
                    binary resp_body;
                    if (resp.body.typeCode() == NT_BINARY) {
                        resp_body = resp.body;
                    } else {
                        resp_body = binary(resp.body);
                    }
                    m.lock();
                    on_exit m.unlock();
                    push results, {
                        "idx": idx,
                        "status": resp.status_code,
                        "size": resp_body.size(),
                        "match": resp_body == mLargePayload,
                    };
                } catch (hash<ExceptionInfo> ex) {
                    m.lock();
                    on_exit m.unlock();
                    push results, {
                        "idx": idx,
                        "error": sprintf("%s: %s", ex.err, ex.desc),
                    };
                }
            }();
        }
        cnt.waitForZero();

        assertEq(num_requests, results.size(), "H3 concurrent: all requests completed");
        for (int i = 0; i < results.size(); i++) {
            hash<auto> r = results[i];
            if (r.error) {
                assertTrue(False, sprintf("H3 concurrent request %d failed: %s", r.idx, r.error));
                continue;
            }
            assertEq(200, r.status, sprintf("H3 concurrent request %d status", r.idx));
            assertEq(LargePayloadSize, r.size, sprintf("H3 concurrent request %d body size", r.idx));
            assertTrue(r.match, sprintf("H3 concurrent request %d body matches", r.idx));
        }
    }
}
