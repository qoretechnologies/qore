#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - threads, listener sockets, WebSocket connections and the destruction of a server in the thread of one of its requests

/*
    Copyright (C) 2026 Qore Technologies, s.r.o., all rights reserved

    Permission is hereby granted, free of charge, to any person obtaining a
    copy of this software and associated documentation files (the "Software"),
    to deal in the Software without restriction, including without limitation
    the rights to use, copy, modify, merge, publish, distribute, sublicense,
    and/or sell copies of the Software, and to permit persons to whom the
    Software is furnished to do so, subject to the following conditions:

    The above copyright notice and this permission notice shall be included in
    all copies or substantial portions of the Software.

    THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
    IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
    FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
    AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
    LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
    FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
    DEALINGS IN THE SOFTWARE.


    A request holds its server while it runs (qore#7509): a server whose last reference the program releases while
    requests run is destroyed when the last of them ends, in that request's thread.  A call of an object whose
    destructor runs in another thread is refused (OBJECT-ALREADY-DELETED), so a request that ran while the destructor
    ran in the thread that released the server could not call the server: its handler was not called, the methods
    that a subclass of the server reimplements (log(), maskData(), getTtl()) were not called for it, and its client
    got no response.  A request that released the last reference itself destroyed the server as soon as its handler
    returned, before the server logged the response.

    A connection that a request handed to a handler for its whole life (a WebSocket connection) does not hold the
    server: the program's release of the server destroys it, which closes the connection, as before.
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires HttpServerUtil
%requires HttpServer
%requires HttpServerAsyncIo
%requires WebSocketUtil
%requires WebSocketHandler
%requires WebSocketClient

%exec-class HttpServerRequestHoldsServerTest

#! Upper bound for any wait that a regression turns into a hang
const HangTimeout = 30s;

#! A server that reports its destruction and the calls of the methods that it reimplements
class TestServer inherits HttpServer {
    private {
        #! receives a hash for each event: "event" (the name of the event), "tid" and, for a log message, "msg"
        Queue test_events;
    }

    constructor(Queue test_events) : HttpServer(<HttpServerOptionInfo>{}) {
        self.test_events = test_events;
    }

    destructor() {
        test_events.push({"event": "destroyed", "tid": gettid()});
    }

    bool isLogInfoEnabled() {
        return True;
    }

    log(string fmt, ...) {
        test_events.push({"event": "log", "tid": gettid(), "msg": vsprintf(fmt, argv)});
    }

    string maskData(string msg) {
        test_events.push({"event": "maskData", "tid": gettid()});
        return msg;
    }

    date getTtl() {
        test_events.push({"event": "getTtl", "tid": gettid()});
        return HttpServer::getTtl();
    }
}

#! Holds the only strong reference to a server
class ServerHolder {
    public {
        *HttpServer server;
    }
}

#! Answers each request with 200; releases the server of the holder first if one is given
class OkHandler inherits AbstractHttpRequestHandler {
    private {
        *ServerHolder holder;
    }

    constructor(*ServerHolder holder) {
        self.holder = holder;
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        if (holder) {
            # the last reference to the server
            remove holder.server;
        }
        return makeResponse(200, "ok", {"Content-Type": "text/plain"});
    }
}

#! Echoes each message of a WebSocket connection
class EchoConnection inherits WebSocketConnection {
    constructor(WebSocketHandler handler) : WebSocketConnection(handler) {
    }

    gotMessage(string msg) {
        send(msg);
    }
}

class EchoHandler inherits WebSocketHandler {
    WebSocketConnection getConnectionImpl(hash<auto> cx, hash<auto> hdr, string cid, *hash<auto> conn) {
        return new EchoConnection(self);
    }
}

class HttpServerRequestHoldsServerTest inherits QUnit::Test {
    private {
        #! the number of requests in flight when the program releases the server
        const NumRequests = 3;
    }

    constructor() : Test("HttpServerRequestHoldsServerTest", "1.0") {
        addTestCase("a server released while requests run is destroyed after the last of them, which all call it",
            \inFlightTest());
        addTestCase("a request that releases the last reference to its server destroys it when it ends",
            \releaseInRequestTest());
        addTestCase("an open WebSocket connection does not hold its server", \webSocketTest());
        set_return_value(main());
    }

    inFlightTest() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("needs a debug build of the library for HttpListener::dbgSetRequestHook()");
        }
        Queue events();
        *TestServer server = new TestServer(events);
        server.setHandler("ok", "", NOTHING, new OkHandler());
        server.setDefaultHandler("ok", new OkHandler());
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        server.waitForAsyncIo();

        # each request waits in the request hook until its gate is released
        list<Counter> gates = map new Counter(1), xrange(NumRequests);
        on_exit map $1.dec(), gates, $1.getCount();
        Queue free_gates();
        map free_gates.push($1), gates;
        # receives a hash for each request that has started: "tid" and "gate"
        Queue started();
        # called by name: the method exists only in a debug build of the library
        call_static_method("HttpServer::HttpListener", "dbgSetRequestHook", sub (HttpListener l) {
            Counter gate = free_gates.get(HangTimeout);
            started.push({"tid": gettid(), "gate": gate});
            gate.waitForZero();
        });
        on_exit call_static_method("HttpServer::HttpListener", "dbgSetRequestHook");

        # receives the result of each request: its status code, or the error that ended it
        Queue results();
        Counter clients_done();
        on_exit clients_done.waitForZero(HangTimeout);
        map request(port, results, clients_done), xrange(NumRequests);
        list<hash<auto>> requests = map started.get(HangTimeout), xrange(NumRequests);

        # the program releases the server in another thread while the requests run
        Queue handoff();
        handoff.push(remove server);
        background sub () {
            {
                *TestServer s = handoff.get();
                remove s;
            }
            events.push({"event": "released", "tid": gettid()});
        }();
        hash<auto> ev = getLifeEvent(events);
        assertEq("released", ev.event, "the requests hold the server: the release does not destroy it");

        # the requests end one at a time; all but the last are answered by the live server
        list<hash<auto>> calls = ();
        foreach hash<auto> req in (requests[0..NumRequests - 2]) {
            req.gate.dec();
            assertEq(200, results.get(HangTimeout), "the request is answered");
        }
        # the last request destroys the server when it ends, in its own thread
        requests[NumRequests - 1].gate.dec();
        ev = getLifeEvent(events, \calls);
        assertEq("destroyed", ev.event, "the server is destroyed when the last request ends");
        assertEq(requests[NumRequests - 1].tid, ev.tid, "the last request's thread destroys the server");
        # the last request's client gets the end of its connection (the server's stop closes it) or a response
        results.get(HangTimeout);
        assertEq(0, clients_done.waitForZero(HangTimeout), "the clients' requests end");

        # each request called the methods of the server that its subclass reimplements, as long as it ran
        foreach hash<auto> req in (requests) {
            list<hash<auto>> req_calls = select calls, $1.tid == req.tid;
            assertTrue((select req_calls, $1.event == "maskData").size() > 0, "maskData() is called for the request");
            assertTrue((select req_calls, $1.event == "log" && $1.msg =~ /GET \/?req /).size() > 0,
                "log() logs the request");
            assertTrue((select req_calls, $1.event == "log" && $1.msg =~ /HTTP\/1\.1 200 /).size() > 0,
                "log() logs the response");
            assertTrue((select req_calls, $1.event == "getTtl").size() > 0, "getTtl() is called for the response");
        }
        # the events after the destruction are the messages that the stop of HttpServer's destructor logs (the
        # destructor of the subclass runs first); the server is destroyed once
        list<hash<auto>> after = map events.get(), xrange(events.size());
        assertEq((), (select after, $1.event != "log"), "the server is destroyed once");
    }

    releaseInRequestTest() {
        Queue events();
        ServerHolder holder();
        holder.server = new TestServer(events);
        holder.server.setHandler("ok", "", NOTHING, new OkHandler(holder));
        holder.server.setDefaultHandler("ok", new OkHandler(holder));
        int port = holder.server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        holder.server.waitForAsyncIo();

        Queue results();
        Counter clients_done();
        request(port, results, clients_done);
        list<hash<auto>> calls = ();
        hash<auto> ev = getLifeEvent(events, \calls);
        assertEq("destroyed", ev.event, "the server is destroyed");
        assertNothing(holder.server, "the request released the server");
        # the request's thread destroys the server once the request has used it for the last time: after its response
        # has been logged
        list<hash<auto>> request_logs = select calls, $1.event == "log" && $1.msg =~ /GET \/?req /;
        assertEq(1, request_logs.size(), "the request is logged");
        int tid = request_logs[0].tid;
        assertEq(tid, ev.tid, "the request's thread destroys the server");
        assertTrue((select calls, $1.tid == tid && $1.event == "log" && $1.msg =~ /HTTP\/1\.1 200 /).size() > 0,
            "the response is logged before the server is destroyed");
        assertTrue((select calls, $1.tid == tid && $1.event == "getTtl").size() > 0,
            "getTtl() is called for the response before the server is destroyed");
        results.get(HangTimeout);
        assertEq(0, clients_done.waitForZero(HangTimeout), "the client's request ends");
    }

    webSocketTest() {
        Queue events();
        *TestServer server = new TestServer(events);
        server.setHandler("ws", "", NOTHING, new EchoHandler());
        server.setDefaultHandler("ws", new EchoHandler());
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        server.waitForAsyncIo();

        Queue received();
        WebSocketClient wsc(sub (*data msg) {
            if (exists msg) {
                received.push(msg);
            } else {
                # in the order of the server's events
                events.push({"event": "closed", "tid": gettid()});
            }
        }, {"url": "ws://127.0.0.1:" + port});
        on_exit wsc.disconnect();
        wsc.connect();
        wsc.send("hello");
        assertEq("hello", received.get(HangTimeout), "the server echoes the message");

        # the open connection does not hold the server: the release destroys it, which closes the connection; the
        # server is destroyed here, or by the end of the request that opened the connection if that request, which
        # holds the server until it ends, has not ended yet
        remove server;
        hash<auto> ev = getLifeEvent(events);
        assertEq("destroyed", ev.event, "the server is destroyed while the WebSocket connection is open");
        assertEq("closed", getLifeEvent(events).event, "the destruction closes the WebSocket connection");
    }

    #! Returns the next event that is not a call of a reimplemented method (a release, a destruction or a close)
    /** The calls before it are added to \a calls
    */
    private hash<auto> getLifeEvent(Queue events, *reference<list<hash<auto>>> calls) {
        while (True) {
            hash<auto> ev = events.get(HangTimeout);
            if (ev.event == "released" || ev.event == "destroyed" || ev.event == "closed") {
                return ev;
            }
            if (exists calls) {
                calls += ev;
            }
        }
    }

    #! Sends a GET request in another thread; its status code, or the error that ended it, is pushed on results
    private request(int port, Queue results, Counter clients_done) {
        clients_done.inc();
        background sub () {
            on_exit clients_done.dec();
            try {
                Socket s();
                s.connect("127.0.0.1:" + port, HangTimeout);
                s.send("GET /req HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n");
                hash<auto> hdr = s.readHTTPHeader(HangTimeout);
                results.push(hdr.status_code);
            } catch (hash<ExceptionInfo> ex) {
                results.push(ex.err);
            }
        }();
    }
}
