#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - threads, listener sockets, TLS, HTTP/2 and HTTP/3 connections, WebSocket connections and the destruction of a server in the thread of one of its requests

/*
