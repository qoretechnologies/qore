    constructor() : Test("HttpServerInteractiveStreamTest", "1.0") {
        addTestCase("interactive read-your-writes HTTP/2", \testInteractiveH2());
        addTestCase("interactive read-your-writes HTTP/3", \testInteractiveH3());
        set_return_value(main());
    }

    globalSetUp() {
        mLogger = new Logger("interactive-stream-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            mLogger.addAppender(new StdoutAppender());
        }

        mServer = new HttpServer(<HttpServerOptionInfo>{
            "logger": mLogger,
            "debug": True,
            "quic_headers_only": True,
        });
        mServer.setHandler("session", "/session", NOTHING, new SessionStreamHandler(), NOTHING, False);
        mServer.waitForAsyncIo();

        mPort = mServer.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
            "enable_h3": True,
        }).port;
        mServer.waitForAsyncIo();

        if (m_options.verbose > 1) {
            printf("interactive stream test server on port %d\n", mPort);
        }
    }

    globalTearDown() {
        delete mServer;
    }

    private HttpClientIo::HttpClientConnectionManager getManager(string protocol) {
        return new HttpClientIo::HttpClientConnectionManager(
            <HttpClientIo::HttpClientConnectionManagerOptions>{
                "protocol": protocol,
                "accept_all_certs": True,
                "logger": mLogger,
                "request_timeout": 30s,
                "connect_timeout": 15s,
            },
        );
    }

    #! reads one complete length-prefixed reply frame from the stream
    private hash<auto> readReply(HttpClientIo::HttpClientStreamHandle stream) {
        binary buf = binary();
        date deadline = now_us() + 20s;
        while (now_us() < deadline) {
            auto data = stream.readData(5s);
            if (!exists data) {
                continue;
            }
            if (data.typeCode() == NT_HASH) {
                if (data.end_stream) {
                    throw "STREAM-CLOSED", "stream closed before a complete reply frame arrived";
                }
                if (data.error) {
                    throw "STREAM-ERROR", sprintf("stream error: %y", data.error);
                }
                continue;
            }
            buf += data.typeCode() == NT_BINARY ? data : binary(data);
            if (buf.size() >= 4) {
                int sz = (buf[0] << 24) | (buf[1] << 16) | (buf[2] << 8) | buf[3];
                if (buf.size() >= 4 + sz) {
                    return parse_yaml(buf.substr(4, sz).toString("utf-8"));
                }
            }
        }
        throw "STREAM-TIMEOUT", "timed out waiting for a reply frame";
    }

    #! drives an interactive read-your-writes session over the given protocol
    private doInteractiveSession(string protocol) {
        HttpClientIo::HttpClientConnectionManager mgr = getManager(protocol);
        on_exit delete mgr;

        string url = sprintf("https://127.0.0.1:%d", mPort);
        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(url);
        assertTrue(stream.supportsStreaming(), protocol + ": stream supports streaming");

        # open one bidirectional stream; keep the request body half open (body_streaming = True)
        stream.startStreaming("POST", "/session", {"Content-Type": "application/connect+yaml"}, True);

        # insert row 1, then select — the select must see the uncommitted insert
        stream.sendData(frame_encode({"cmd": "insert", "row": {"id": 1}}));
        hash<auto> a1 = readReply(stream);
        assertEq("ok", a1.status, protocol + ": insert 1 acknowledged");
        assertEq(1, a1.n, protocol + ": session has 1 row after first insert");

        stream.sendData(frame_encode({"cmd": "select"}));
        hash<auto> s1 = readReply(stream);
        assertEq(1, s1.rows.size(), protocol + ": in-session select sees the uncommitted insert");
        assertEq(1, s1.rows[0].id, protocol + ": select returned the inserted row");

        # insert row 2, then select again — must now see both rows (read-your-writes)
        stream.sendData(frame_encode({"cmd": "insert", "row": {"id": 2}}));
        hash<auto> a2 = readReply(stream);
        assertEq(2, a2.n, protocol + ": session has 2 rows after second insert");

        stream.sendData(frame_encode({"cmd": "select"}));
        hash<auto> s2 = readReply(stream);
        assertEq(2, s2.rows.size(), protocol + ": second select sees both uncommitted inserts");
        assertEq((1, 2), (map $1.id, s2.rows), protocol + ": both inserted rows visible in order");

        # half-close the request side; the handler flushes end-of-stream and completes
        stream.writesDone();

        # drain to end_stream so the stream finalizes cleanly
        date deadline = now_us() + 10s;
        while (now_us() < deadline) {
            auto data = stream.readData(2s);
            if (data.typeCode() == NT_HASH && data.end_stream) {
                break;
            }
        }
    }

    testInteractiveH2() {
        if (!HaveYaml) {
            testSkip("the yaml module is required for this test");
        }
        doInteractiveSession("h2");
    }

    testInteractiveH3() {
        if (!HaveYaml) {
            testSkip("the yaml module is required for this test");
        }
        doInteractiveSession("h3");
    }
}
