    Interactive bidirectional stream tests (issue #5351).

    Exercises the opt-in AbstractStreamRequest::wantsInteractiveStreaming() path: a body-streaming
    handler that interleaves read -> reply on a single HTTP/2 or HTTP/3 stream, so the client can do
    send-op -> read-result -> send-op (interactive read-your-writes within one session).

    The handler holds in-memory session state for the stream lifetime; a "select" op must see the
    rows added by prior "insert" ops on the SAME stream — proving the reply for one op is produced
    and delivered before the client sends the next op (which the legacy recv-all-then-send model
    cannot do).
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Mime
%requires Logger
%requires HttpServerUtil
%requires HttpServer
%requires HttpClientIo

%try-module yaml
%define NoYaml
%endtry

%ifdef NoYaml
# Stub functions when the yaml module is not available; tests skip in this case
const HaveYaml = False;
auto sub make_yaml(auto val) { throw "YAML-ERROR", "the yaml module is required for this test"; }
auto sub parse_yaml(auto val) { throw "YAML-ERROR", "the yaml module is required for this test"; }
%else
const HaveYaml = True;
%endif

%exec-class HttpServerInteractiveStreamTest

#! length-prefixed YAML frame: 4-byte big-endian length + UTF-8 YAML payload
binary sub frame_encode(hash<auto> msg) {
    binary payload = binary(make_yaml(msg));
    int sz = payload.size();
    return binary(chr((sz >> 24) & 0xff))
        + binary(chr((sz >> 16) & 0xff))
        + binary(chr((sz >> 8) & 0xff))
        + binary(chr(sz & 0xff))
        + payload;
}

#! interactive session stream request: opt-in interleaved read -> reply on one H2/H3 stream
/** Holds session state (rows) for the stream lifetime.  Each inbound op is processed in
    recvImpl() (which queues exactly one reply frame); sendImpl() returns that reply, so the
    framework's interactive loop writes a reply per op.  A "select" sees all prior "insert"s.
*/
class SessionStreamRequest inherits HttpServer::AbstractStreamRequest {
    private {
        #! reframing buffer for inbound bytes (DATA frames are not message-aligned)
        binary m_inbuf = binary();
        #! session state: inserted rows (uncommitted, visible to in-session selects)
        list<auto> m_rows = ();
        #! pending reply frames produced by recvImpl(), drained by sendImpl()
        Queue m_replies();
    }

    constructor(HttpServer::HttpListenerInterface listener, HttpServer::AbstractHttpRequestHandler handler,
            Qore::Socket s, hash<auto> cx, hash<auto> hdr, auto body)
            : HttpServer::AbstractStreamRequest(listener, handler, s, cx, hdr, body) {
    }

    #! opt in to the interactive bidirectional path on HTTP/2 and HTTP/3
    bool wantsInteractiveStreaming() {
        return True;
    }

    #! self-describing frames — no extra content encoding
    bool needsContentEncoding() {
        return False;
    }

    private hash<HttpServer::HttpHandlerResponseInfo> getResponseHeaderMessageImpl() {
        return <HttpServer::HttpHandlerResponseInfo>{
            "code": 200,
            "hdr": {"Content-Type": "application/connect+yaml"},
        };
    }

    #! process each inbound op; queue exactly one reply frame per op
    private nothing recvImpl(hash<auto> v) {
        if (!exists v.data) {
            # end-of-data marker ({"hdr": NOTHING}) — nothing to do
            return;
        }
        m_inbuf += v.data.typeCode() == NT_BINARY ? v.data : binary(v.data);
        # extract and process all complete length-prefixed frames
        while (m_inbuf.size() >= 4) {
            int sz = (m_inbuf[0] << 24) | (m_inbuf[1] << 16) | (m_inbuf[2] << 8) | m_inbuf[3];
            if (m_inbuf.size() < 4 + sz) {
                break;  # incomplete frame — wait for more bytes
            }
            binary payload = m_inbuf.substr(4, sz);
            m_inbuf = m_inbuf.substr(4 + sz);
            hash<auto> op = parse_yaml(payload.toString("utf-8"));
            hash<auto> reply;
            switch (op.cmd) {
                case "insert":
                    m_rows += op.row;
                    reply = {"status": "ok", "n": m_rows.size()};
                    break;
                case "select":
                    reply = {"status": "ok", "rows": m_rows};
                    break;
                default:
                    reply = {"status": "error", "err": sprintf("unknown cmd %y", op.cmd)};
                    break;
            }
            m_replies.push(frame_encode(reply));
        }
    }

    #! return the next queued reply frame for the current op, or NOTHING when none remain
    private auto sendImpl() {
        if (m_replies.empty()) {
            return NOTHING;
        }
        return m_replies.get();
    }
}

#! handler wiring the interactive session stream request
class SessionStreamHandler inherits HttpServer::AbstractHttpRequestHandler {
    constructor() : AbstractHttpRequestHandler(NOTHING, True) {}

    bool wantsBodyStreaming(hash<auto> cx, hash<auto> hdr) {
        return True;
    }

    private HttpServer::AbstractStreamRequest getStreamRequestImpl(
            HttpServer::HttpListenerInterface listener, Qore::Socket s, hash<auto> cx, hash<auto> hdr,
            *data body) {
        return new SessionStreamRequest(listener, self, s, cx, hdr, body);
    }

    hash<HttpServer::HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(500, "unexpected non-streaming dispatch for interactive session handler");
    }
}

