/g5l2ZjftRO2yAdYhP4Sbcws88pP+cr64tWDI6qK6tlGXI93EyfCVT1FSX5CC1aq
Do+Sl1gfqlpgpszQaOMjR4M=
-----END PRIVATE KEY-----";

        # path -> the Content-Type expected; "text/html" is followed by the charset of the response
        const Expected = {
            "string": "text/html",
            "binary": MimeTypeOctetStream,
            "binary-stream": MimeTypeOctetStream,
            "string-stream": "text/html",
            "callback": NOTHING,
            # a charset is not added to the type of binary data
            "typed-binary": MimeTypeOctetStream,
            "typed-string": MimeTypeText,
        };

        HttpServer server;
        # listener label -> URL
        hash<string, string> urls;
    }

    constructor() : Test("HttpServerDefaultContentTypeTest", "1.0") {
        addTestCase("successful responses", \successTest());
        addTestCase("error responses", \errorTest());
        addTestCase("response text encoding", \textEncodingTest());
        set_return_value(main());
    }

    globalSetUp() {
        server = new HttpServer(<HttpServerOptionInfo>{
            "logger": new Logger("server", LoggerLevel::getLevelError()),
        });
        TestHandler handler();
        server.setHandler("test", "", NOTHING, handler);
        server.setDefaultHandler("test", handler);
        urls."sync h1" = "http://localhost:" + server.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "sync": True,
        }).port;
        urls."async h1" = "http://localhost:" + server.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        urls.h2 = "https://localhost:" + server.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        }).port;
        server.waitForAsyncIo();
    }

    globalTearDown() {
        delete server;
    }

    private check(int code) {
        foreach hash<auto> i in (urls.pairIterator()) {
            HTTPClient hc({
                "url": i.value,
                "http_version": i.key == "h2" ? "2.0" : "1.1",
                "ssl_verify_cert": False,
                "timeout": 30s,
                "error_passthru": True,
            });
            hc.setHttp3Mode("disabled");
            foreach hash<auto> e in (Expected.pairIterator()) {
                string label = sprintf("%s %s %d", i.key, e.key, code);
                hash<auto> info;
                hash<auto> resp = hc.send(NOTHING, "GET", sprintf("/%s/%d", e.key, code), NOTHING, False, \info);
                assertEq(code, resp.status_code, label);
                auto ct = info."response-headers"."content-type";
                if (!e.value) {
                    assertNothing(ct, label);
                } else if (e.value == "text/html") {
                    assertRegex("^text/html;\\s*charset=", ct, label);
                } else if (e.value == MimeTypeOctetStream) {
                    # no charset for binary data
                    assertEq(MimeTypeOctetStream, ct, label);
                } else {
                    assertRegex("^" + e.value, ct, label);
                }
                # the body is returned as it was sent: binary data is not text
                if (e.value == MimeTypeOctetStream) {
                    assertEq(<00e4>, resp.body, label);
                } else if (e.value) {
                    assertEq("ä", (resp.body =~ x/(ä)/)[0], label);
                }
            }
            if (i.key == "h2") {
                assertTrue(hc.isHttp2Active());
            }
        }
    }

    # text is sent in the character encoding that the response declares, whatever the encoding of the string or
    # stream, and whatever encoding the client accepts
    textEncodingTest() {
        foreach hash<auto> i in (urls.pairIterator()) {
            HTTPClient hc({
                "url": i.value,
                "http_version": i.key == "h2" ? "2.0" : "1.1",
                "ssl_verify_cert": False,
                "timeout": 30s,
            });
            hc.setHttp3Mode("disabled");
            foreach *string accept in (NOTHING, "iso-8859-1", "utf-8") {
                *hash<auto> hdr = accept ? {"Accept-Charset": accept} : NOTHING;
                foreach string path in ("latin1-string", "utf8-string", "utf8-stream", "latin1-stream",
                        "declared-utf16", "declared-utf16-stream") {
                    string label = sprintf("%s %s %y", i.key, path, accept);
                    hash<auto> info;
                    hash<auto> resp = hc.send(NOTHING, "GET", "/" + path, hdr, False, \info);
                    assertEq(200, resp.status_code, label);
                    string ct = info."response-headers"."content-type";
                    if (path =~ /^declared/) {
                        assertEq("text/plain;charset=utf-16le", ct, label);
                    }
                    # the client decodes the body in the declared encoding, so the text is only right if the
                    # octets are in that encoding
                    assertEq("äöü", convert_encoding(resp.body, "UTF-8"), label);
                }
            }
        }
    }

    successTest() {
        check(200);
    }

    errorTest() {
        check(400);
    }
}
