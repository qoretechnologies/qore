    HttpServer responses without a Content-Type: a string body is text/html in the response encoding, binary data
    is application/octet-stream without a charset, and a body produced by a send_callback has no Content-Type, over
    synchronous and asynchronous HTTP/1.1 listeners and HTTP/2, for successful and error responses
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires Mime
%requires Logger
%requires HttpServerUtil
%requires HttpServer

%exec-class HttpServerDefaultContentTypeTest

class TestHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        list<string> parts = hdr.path.split("/");
        int code = parts[1] ? parts[1].toInt() : 200;
        switch (parts[0]) {
            case "string":
                return <HttpResponseInfo>{"code": code, "body": "<p>ä</p>"};
            case "binary":
                return <HttpResponseInfo>{"code": code, "body": <00e4>};
            case "binary-stream":
                return <HttpResponseInfo>{"code": code, "chunked_body": new BinaryInputStream(<00e4>)};
            case "string-stream":
                return <HttpResponseInfo>{"code": code, "chunked_body": new StringInputStream("ä")};
            case "callback": {
                bool sent;
                return <HttpResponseInfo>{
                    "code": code,
                    "send_callback": *data sub () {
                        if (sent) {
                            return;
                        }
                        sent = True;
                        return <00e4>;
                    },
                };
            }
            # text in different encodings, which is sent in the encoding the response declares
            case "latin1-string":
                return <HttpResponseInfo>{"code": code, "body": convert_encoding("äöü", "ISO-8859-1")};
            case "utf8-string":
                return <HttpResponseInfo>{"code": code, "body": "äöü"};
            case "utf8-stream":
                return <HttpResponseInfo>{"code": code, "chunked_body": new StringInputStream("äöü")};
            case "latin1-stream":
                return <HttpResponseInfo>{
                    "code": code,
                    "chunked_body": new StringInputStream(convert_encoding("äöü", "ISO-8859-1")),
                };
            case "declared-utf16":
                return <HttpResponseInfo>{
                    "code": code,
                    "hdr": {"Content-Type": "text/plain;charset=utf-16le"},
                    "body": "äöü",
                };
            case "declared-utf16-stream":
                return <HttpResponseInfo>{
                    "code": code,
                    "hdr": {"Content-Type": "text/plain;charset=utf-16le"},
                    "chunked_body": new StringInputStream("äöü"),
                };
            case "typed-binary":
                return <HttpResponseInfo>{
                    "code": code,
                    "hdr": {"Content-Type": MimeTypeOctetStream},
                    "body": <00e4>,
                };
            case "typed-string":
                return <HttpResponseInfo>{
                    "code": code,
                    "hdr": {"Content-Type": MimeTypeText},
                    "body": "ä",
                };
        }
        return <HttpResponseInfo>{"code": 404, "hdr": {"Content-Type": MimeTypeText}, "body": "not found"};
    }
}

