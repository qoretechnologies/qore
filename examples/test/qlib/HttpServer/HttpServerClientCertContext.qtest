#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - TLS client certificates over HTTP/1.1, HTTP/2 and HTTP/3 (QUIC)
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires HttpServer
%requires HttpServerUtil
%requires FsUtil
%requires ../../TestCertificates.qm

%exec-class HttpServerClientCertContextTest

#! a hang guard only, never a timing assertion
const HangGuard = 30s;

#! Reports what the request context gives about the peer, and what the socket of its request gives
class PeerHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(HttpListenerInterface listener, Socket s, hash<auto> cx, hash<auto> hdr,
            *data body) {
        *SSLCertificate cert = cx."client-cert";
        return makeResponse(200, sprintf("cert=%s peer=%s", cert ? cert.getSignature().toHex() : "none",
            cx."peer-info".address ?? "none"));
    }
}

#! The handlers of HTTP/1.1, HTTP/2 and HTTP/3 requests get the client's certificate and the peer's address in the
#! request context (qore#7214, qore#7261)
/** The socket of an HTTP/2 or HTTP/3 request is the handler's own, not connected: the request context gives the
    peer's information (\c cx."peer-info") and its certificate (\c cx."client-cert"), for every protocol
*/
class HttpServerClientCertContextTest inherits QUnit::Test {
    constructor() : QUnit::Test("client certificate in the request context", "1.0", \ARGV) {
        addTestCase("HTTP/1.1", \certTest(), "1.1");
        addTestCase("HTTP/2", \certTest(), "2.0");
        addTestCase("HTTP/3", \certTest(), "3.0");
        foreach string ver in (("1.1", "2.0", "3.0")) {
            string pv = "HTTP/" + (ver == "2.0" ? "2" : (ver == "3.0" ? "3" : ver));
            addTestCase(pv + " required certificate", \requiredCertTest(),
                (ver, SSL_VERIFY_PEER | SSL_VERIFY_FAIL_IF_NO_PEER_CERT));
            # get_remote_certs adds SSL_VERIFY_PEER to the flags of the listener
            addTestCase(pv + " required certificate without SSL_VERIFY_PEER", \requiredCertTest(),
                (ver, SSL_VERIFY_FAIL_IF_NO_PEER_CERT));
            addTestCase(pv + " untrusted certificate", \untrustedCertTest(), ver);
        }
        addTestCase("listener info", \listenerInfoTest());
        set_return_value(main());
    }

    certTest(string http_version) {
        HttpServer server(<HttpServerOptionInfo>{});
        on_exit delete server;
        int port = startListener(server);

        TmpDir tmp();
        string r = get(port, http_version, writeClientPem(tmp));
        string expected = sprintf("cert=%s peer=", new SSLCertificate(CertPem).getSignature().toHex());
        assertEq(expected, r.substr(0, expected.size()), "the context gives the client's certificate");
        assertRegex("peer=(127\\.0\\.0\\.1|::1)$", r, "the context gives the peer's address");
    }

    #! the listener's verify flags apply to the QUIC listener paired with it as to its TCP listener (qore#7261)
    requiredCertTest(string http_version, int ssl_verify_flags) {
        HttpServer server(<HttpServerOptionInfo>{});
        on_exit delete server;
        int port = startListener(server, ssl_verify_flags);

        TmpDir tmp();
        string expected = sprintf("cert=%s peer=", new SSLCertificate(CertPem).getSignature().toHex());
        string r = get(port, http_version, writeClientPem(tmp));
        assertEq(expected, r.substr(0, expected.size()), "a client with a certificate is served");

        assertRefused(port, http_version, NOTHING, "a client without a certificate is refused");
    }

    #! with ssl_accept_all_certs False, the listener and the QUIC listener paired with it refuse a client certificate
    #! that they cannot verify (qore#7261)
    untrustedCertTest(string http_version) {
        HttpServer server(<HttpServerOptionInfo>{});
        on_exit delete server;
        int port = startListener(server, SSL_VERIFY_NONE, False);

        TmpDir tmp();
        # the client's certificate is self-signed
        assertRefused(port, http_version, writeClientPem(tmp), "an untrusted client certificate is refused");

        string r = get(port, http_version);
        assertEq("cert=none peer=", r.substr(0, 15), "a client without a certificate is served");
    }

    #! the info of the QUIC listener gives the client certificate options that it applies (qore#7261)
    listenerInfoTest() {
        foreach bool accept_all in ((True, False)) {
            HttpServer server(<HttpServerOptionInfo>{});
            on_exit delete server;
            startListener(server, SSL_VERIFY_NONE, accept_all);
            # the listener added with HttpServer::addQuicListener() directly
            int qid = server.addQuicListener(<HttpListenerOptionInfo>{
                "name": "direct",
                "node": "localhost",
                "cert": new SSLCertificate(CertPem),
                "key": new SSLPrivateKey(KeyPem),
                "get_remote_certs": True,
                "ssl_accept_all_certs": accept_all,
            }).id;

            hash<string, hash<auto>> info = server.getListeners();
            # the TCP listener, the QUIC listener paired with it and the one added directly
            assertEq(3, info.size());
            foreach hash<auto> i in (info.iterator()) {
                assertEq(accept_all, i.ssl_accept_all_certs, sprintf("%s: ssl_accept_all_certs", i.name));
                assertTrue(i.get_remote_certs, sprintf("%s: get_remote_certs", i.name));
            }
            assertEq(accept_all, info{qid}.ssl_accept_all_certs, "the direct QUIC listener's ssl_accept_all_certs");
        }
    }

    private assertRefused(int port, string http_version, *string path, string msg) {
        # the server's TLS alert ends the handshake or the connection: the error depends on the protocol and on whether
        # the alert arrives before or after the request is sent, but it is never a timeout or a response
        *string err;
        *string r;
        try {
            r = get(port, http_version, path);
        } catch (hash<ExceptionInfo> ex) {
            err = ex.err;
        }
        assertEq(Type::String, err.type(), sprintf("%s (response: %y)", msg, r));
        assertFalse(err =~ /TIMEOUT/, "the refusal is not a timeout");
    }

    private int startListener(HttpServer server, int ssl_verify_flags = SSL_VERIFY_NONE, bool accept_all = True) {
        server.setHandler("peer", "^peer", NOTHING, new PeerHandler());
        int port = server.addListener(<HttpListenerOptionInfo>{
            "node": "localhost",
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
            "http_version": "auto",
            "get_remote_certs": True,
            "ssl_verify_flags": ssl_verify_flags,
            "ssl_accept_all_certs": accept_all,
        }).port;
        server.waitForAsyncIo();
        return port;
    }

    private static string writeClientPem(TmpDir tmp) {
        string path = tmp.path + "/client.pem";
        File f();
        f.open2(path, O_CREAT | O_WRONLY | O_TRUNC);
        f.write(CertPem + "\n" + KeyPem + "\n");
        f.close();
        return path;
    }

    private static string get(int port, string http_version, *string path) {
        hash<auto> opts = {
            "url": "https://localhost:" + port,
            "http_version": http_version,
            "ssl_verify_cert": False,
            "timeout": HangGuard,
        };
        if (path) {
            opts += {"ssl_cert_path": path, "ssl_key_path": path};
        }
        HTTPClient hc(opts);
        on_exit hc.disconnect();
        return hc.get("/peer");
    }
}
