    constructor() : QUnit::Test("HttpServerStreamPeerResetTest", "1.0") {
        addTestCase("H2 readData(0) non-blocking drain",   \testH2DrainNonBlocking());
        addTestCase("H3 readData(0) non-blocking drain",   \testH3DrainNonBlocking());
        addTestCase("H2 peer-reset raises typed exception",\testH2PeerResetTyped());
        addTestCase("H3 peer-reset raises typed exception",\testH3PeerResetTyped());
        set_return_value(main());
    }

    globalSetUp() {
        mLogger = new Logger("stream-peer-reset", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            mLogger.addAppender(new StdoutAppender());
        }
    }

    #! Builds an HttpServer with H2 and H3 listeners + drain and reject handlers.
    private hash<auto> makeServer() {
        HttpServer server(<HttpServerOptionInfo>{
            "logger": mLogger,
            "debug": True,
            "quic_headers_only": True,
        });

        DrainHandler drain();
        RejectHandler reject();
        server.setHandler("drain", "/drain", NOTHING, drain);
        server.setHandler("reject", "/reject", NOTHING, reject);

        int h2_port = server.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        }).port;

        *int h3_port;
        try {
            h3_port = server.addQuicListener(<HttpListenerOptionInfo>{
                "cert": new SSLCertificate(CertPem),
                "key": new SSLPrivateKey(KeyPem),
            }).port;
        } catch (hash<ExceptionInfo> ex) {
            # QUIC unavailable — H3 tests will skip
        }
        server.waitForAsyncIo();
        return {
            "server": server,
            "drain": drain,
            "reject": reject,
            "h2_url": "https://127.0.0.1:" + h2_port,
            "h3_url": h3_port ? ("https://127.0.0.1:" + h3_port) : NOTHING,
        };
    }

    private HttpClientIo::HttpClientConnectionManager makeMgr(string proto) {
        return new HttpClientIo::HttpClientConnectionManager(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": proto,
            "connect_timeout": 10s,
            "request_timeout": 30s,
            "logger": mLogger,
        });
    }

    #! readData(0) must be a non-blocking peek — the core regression this
    #! test guards against is Channel::recv(0) blocking forever (the
    #! DataStreamClientIo.sendDSv1Stream drain bug).  Starts a bidi stream,
    #! calls readData(0) before any data arrives, and asserts it returns
    #! within 1s (the semantic contract is "fast"; 1s is a generous ceiling).
    private drainNonBlockingImpl(string proto) {
        hash<auto> setup = makeServer();
        HttpServer server = setup.server;
        on_exit delete server;

        *string url = proto == "h3" ? setup.h3_url : setup.h2_url;
        if (!exists url) {
            testSkip(sprintf("%s not available", proto));
        }

        HttpClientIo::HttpClientConnectionManager mgr = makeMgr(proto);
        on_exit delete mgr;

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(url);
        stream.startStreaming("POST", "/drain",
            {"content-type": "application/octet-stream"}, True);

        date t0 = now_us();
        try {
            stream.readData(0);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "HTTPCLIENT-STREAM-CLOSED") {
                rethrow;
            }
        }
        date t1 = now_us();
        int elapsed_ms = (t1 - t0).durationMilliseconds();
        assertTrue(elapsed_ms < 1000,
            sprintf("%s readData(0) must be non-blocking (elapsed=%dms)", proto, elapsed_ms));

        # Abandon the stream; the server-side handler may still be waiting
        # for body data but tearing the manager down in on_exit cleans it up.
    }

    #! Shared peer-reset body for H2 and H3.  Keep sending after the server
    #! has returned 400 + closed the stream; the typed reset exception must
    #! fire within a bounded number of iterations.
    private peerResetImpl(string proto, string expected_err) {
        hash<auto> setup = makeServer();
        HttpServer server = setup.server;
        on_exit delete server;

        *string url = proto == "h3" ? setup.h3_url : setup.h2_url;
        if (!exists url) {
            testSkip(sprintf("%s not available", proto));
        }

        HttpClientIo::HttpClientConnectionManager mgr = makeMgr(proto);
        on_exit delete mgr;

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(url);
        stream.startStreaming("POST", "/reject",
            {"content-type": "application/octet-stream"}, True);

        *string err;
        # Up to ~100 iterations × 100 ms = 10 s worst case — long enough for
        # H2 RST_STREAM / H3 STOP_SENDING to propagate to the client, short
        # enough that a genuine regression hangs noticeably.
        for (int i = 0; i < 100; ++i) {
            try {
                stream.sendData(binary("x"));
            } catch (hash<ExceptionInfo> ex) {
                err = ex.err;
                break;
            }
            # give the I/O thread time to deliver the reset
            usleep(100ms);
        }

        assertEq(expected_err, err,
            sprintf("%s peer reset surfaces typed exception", proto));
    }

    testH2DrainNonBlocking() {
        drainNonBlockingImpl("h2");
    }

    testH3DrainNonBlocking() {
        drainNonBlockingImpl("h3");
    }

    testH2PeerResetTyped() {
        peerResetImpl("h2", "HTTP2-STREAM-RESET");
    }

    testH3PeerResetTyped() {
        peerResetImpl("h3", "QUIC-STREAM-RESET");
    }
}
