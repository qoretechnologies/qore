#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

/*
    Regression tests for peer-reset propagation on H2 and H3 client streams.

    When the server rejects a streaming request mid-body (e.g. by replying
    early with 4xx and resetting the stream), the client's next sendData()
    must raise a *typed* exception:
      - HTTP2-STREAM-RESET  for HTTP/2
      - QUIC-STREAM-RESET   for HTTP/3

    This must hold both while the stream is still tracked in the session
    state AND after the close callback has already erased it — callers
    racing the close must see the typed reset, not the generic
    "stream N not found" error.  It holds whether the response was read
    first or not, and every later send raises the reset again.

    The tests wait for the client to have processed the reset with a
    request on the same connection that the server answers only after the
    reset: frames on a connection are processed in order.

    Also covers readData(0) non-blocking drain semantics (the caller is
    polling for server-initiated reset/early response without blocking).
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Mime
%requires Logger
%requires HttpServerUtil
%requires AsyncSocketIo
%requires HttpServerAsyncIo
%requires HttpServer
%requires HttpClientIo

%exec-class HttpServerStreamPeerResetTest

#! Handler that rejects a body-streaming POST by explicitly resetting the
#! stream mid-upload.  This forces the peer (client) to observe a
#! RST_STREAM (H2) / RESET_STREAM (H3) — the condition under which the
#! client's next sendData() must surface a typed reset error.
class RejectHandler inherits HttpServer::AbstractHttpRequestHandler {
    bool wantsBodyStreaming(hash<auto> cx, hash<auto> hdr) {
        return True;
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        *Socket sock = cx."header-info".sock;
        int stream_id = cx."header-info".stream_id;
        bool http3 = cx."header-info".http3 ?? False;
        *int session_id = cx."header-info".session_id;
        *code<nothing()> io_wake = cx."header-info".io_wake;
        # Reset the stream directly so the peer sees a RESET/STOP_SENDING
        # rather than a clean FIN + 400 response.
        if (sock) {
            if (http3 && exists session_id) {
                try {
                    sock.resetQuicStream(session_id, stream_id);
                } catch () {}
            } else {
                try {
                    sock.resetHttp2Stream(stream_id);
                    if (io_wake) {
                        io_wake();
                    }
                } catch () {}
            }
        }
        return HttpServer::AbstractHttpRequestHandler::makeResponse(400,
            "rejected", {"Content-Type": MimeTypeText});
    }
}

#! Handler that resets a body-streaming request
/** It reports the reset on @ref reset_queue, so @ref AfterResetHandler answers only after it.  On HTTP/3, the reset
    is STOP_SENDING alone, and the handler answers only when the test lets it: the stream stays open until then, so
    the client records the reset only from the STOP_SENDING itself.  On HTTP/2, RST_STREAM closes the stream in both
    directions at once, and the handler returns at once: the HTTP/2 server runs the handlers of a connection one after
    the other.
*/
class ResetAndHoldHandler inherits HttpServer::AbstractHttpRequestHandler {
    public {
        Queue reset_queue();
        Queue release_queue();
    }

    bool wantsBodyStreaming(hash<auto> cx, hash<auto> hdr) {
        return True;
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        Socket sock = cx."header-info".sock;
        int stream_id = cx."header-info".stream_id;
        if (cx."header-info".http3) {
            sock.resetQuicStream(cx."header-info".session_id, stream_id);
            reset_queue.push(True);
            release_queue.get(60s);
        } else {
            sock.resetHttp2Stream(stream_id);
            *code<nothing()> io_wake = cx."header-info".io_wake;
            if (io_wake) {
                io_wake();
            }
            reset_queue.push(True);
        }
        return HttpServer::AbstractHttpRequestHandler::makeResponse(400, "rejected",
            {"Content-Type": MimeTypeText});
    }
}

#! Handler that answers once a ResetAndHoldHandler has reset its stream
class AfterResetHandler inherits HttpServer::AbstractHttpRequestHandler {
    private {
        ResetAndHoldHandler reset_hold;
    }

    constructor(ResetAndHoldHandler reset_hold) {
        self.reset_hold = reset_hold;
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        reset_hold.reset_queue.get(30s);
        return HttpServer::AbstractHttpRequestHandler::makeResponse(200, "after-reset",
            {"Content-Type": MimeTypeText});
    }
}

#! Handler that answers a body-streaming request without reading its body.
#! Once the response is sent, the HTTP/2 server closes the stream with
#! RST_STREAM(NO_ERROR), because the client has not finished its request
#! (RFC 9113 section 8.1).
class EarlyHandler inherits HttpServer::AbstractHttpRequestHandler {
    bool wantsBodyStreaming(hash<auto> cx, hash<auto> hdr) {
        return True;
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return HttpServer::AbstractHttpRequestHandler::makeResponse(200, "early",
            {"Content-Type": MimeTypeText});
    }
}

#! Handler that answers a body-streaming request without reading its body
#! and reports when the response has been sent.  On HTTP/3, the server stops
#! reading the request with STOP_SENDING(H3_NO_ERROR) when the handler is done
#! (RFC 9114 section 4.1.2); the stream can only close, and the response is
#! only reported as sent, after that, because until then the stream's receive
#! side is open.
class SignalingEarlyHandler inherits HttpServer::AbstractHttpRequestHandler {
    public {
        Queue sent_queue();
    }

    bool wantsBodyStreaming(hash<auto> cx, hash<auto> hdr) {
        return True;
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        hash<HttpResponseInfo> rv = HttpServer::AbstractHttpRequestHandler::makeResponse(200, "early",
            {"Content-Type": MimeTypeText});
        rv.after_send = sub (hash<auto> cx, bool sent) {
            sent_queue.push(sent);
        };
        return rv;
    }
}

#! Handler that answers once the response of a SignalingEarlyHandler has been reported as sent
/** A client that waits for this response keeps reading the connection, so it processes the STOP_SENDING of the early
    response and answers it with RESET_STREAM, which lets the server close that stream and report the response as
    sent; once this response has been received, the client has therefore processed the STOP_SENDING.
*/
class WaitForSentHandler inherits HttpServer::AbstractHttpRequestHandler {
    private {
        SignalingEarlyHandler early;
    }

    constructor(SignalingEarlyHandler early) {
        self.early = early;
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        bool sent = early.sent_queue.get(30s);
        return HttpServer::AbstractHttpRequestHandler::makeResponse(200, sent ? "sent" : "not sent",
            {"Content-Type": MimeTypeText});
    }
}

#! Handler that answers a plain request.
class OkHandler inherits HttpServer::AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return HttpServer::AbstractHttpRequestHandler::makeResponse(200, "ok",
            {"Content-Type": MimeTypeText});
    }
}

#! Handler that reads the body incrementally (sanity case).
class DrainHandler inherits HttpServer::AbstractHttpRequestHandler {
    public {
        int bytes_received;
    }

    bool wantsBodyStreaming(hash<auto> cx, hash<auto> hdr) {
        return True;
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        bool body_streaming = cx."header-info".body_streaming ?? False;
        bool headers_end_stream = cx."header-info".headers_end_stream ?? False;
        *Socket sock = cx."header-info".sock;
        int session_id = cx."header-info".session_id;
        int stream_id = cx."header-info".stream_id;
        binary accumulated = binary();
        if (body_streaming && !headers_end_stream && sock) {
            if (cx."header-info".http3) {
                while (True) {
                    *binary chunk = sock.readQuicStreamDataBlock(session_id, stream_id, 5s);
                    if (!exists chunk) {
                        break;
                    }
                    accumulated += chunk;
                }
            } else {
                # Drive HTTP/2 inbound DATA via register_body_queue (the I/O
                # thread pushes binary chunks to the Queue and a NOTHING
                # sentinel on END_STREAM).
                code<nothing(Queue)> register_body_queue
                    = cx."header-info".register_body_queue;
                Queue body_queue(-1);
                register_body_queue(body_queue);
                while (True) {
                    auto chunk;
                    try {
                        chunk = body_queue.get(5s);
                    } catch (hash<ExceptionInfo> ex) {
                        if (ex.err == "QUEUE-TIMEOUT") {
                            break;
                        }
                        rethrow;
                    }
                    if (!(chunk instanceof binary)) {
                        break;
                    }
                    accumulated += chunk;
                }
            }
        } else if (body.typeCode() == NT_BINARY) {
            accumulated = body;
        } else if (body.typeCode() == NT_STRING) {
            accumulated = binary(body);
        }
        bytes_received = accumulated.size();
        return HttpServer::AbstractHttpRequestHandler::makeResponse(200,
            sprintf("received=%d", bytes_received),
            {"Content-Type": MimeTypeText});
    }
}

