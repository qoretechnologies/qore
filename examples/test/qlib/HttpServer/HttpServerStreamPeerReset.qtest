    constructor() : QUnit::Test("HttpServerStreamPeerResetTest", "1.0") {
        addTestCase("H2 readData(0) non-blocking drain",   \testH2DrainNonBlocking());
        addTestCase("H3 readData(0) non-blocking drain",   \testH3DrainNonBlocking());
        addTestCase("H2 peer-reset raises typed exception",\testH2PeerResetTyped());
        addTestCase("H3 peer-reset raises typed exception",\testH3PeerResetTyped());
        addTestCase("H2 peer-reset before the response is read", \testH2PeerResetBeforeRead());
        addTestCase("H3 peer-reset before the response is read", \testH3PeerResetBeforeRead());
        addTestCase("H2 send after RST_STREAM(NO_ERROR)",  \testH2SendAfterEarlyResponse());
        addTestCase("H3 send after STOP_SENDING(H3_NO_ERROR)", \testH3SendAfterEarlyResponse());
        set_return_value(main());
    }

    globalSetUp() {
        mLogger = new Logger("stream-peer-reset", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            mLogger.addAppender(new StdoutAppender());
        }
    }

    #! Builds an HttpServer with H2 and H3 listeners + drain and reject handlers.
    private hash<auto> makeServer() {
        HttpServer server(<HttpServerOptionInfo>{
            "logger": mLogger,
            "debug": True,
            "quic_headers_only": True,
        });

        DrainHandler drain();
        RejectHandler reject();
        EarlyHandler early();
        SignalingEarlyHandler signaling_early();
        ResetAndHoldHandler reset_hold();
        OkHandler ok();
        server.setHandler("drain", "/drain", NOTHING, drain);
        server.setHandler("reject", "/reject", NOTHING, reject);
        server.setHandler("early", "/early", NOTHING, early);
        server.setHandler("sent-signal", "/sent-signal", NOTHING, signaling_early);
        server.setHandler("wait-for-sent", "/wait-for-sent", NOTHING, new WaitForSentHandler(signaling_early));
        server.setHandler("ok", "/ok", NOTHING, ok);
        server.setHandler("reset-hold", "/reset-hold", NOTHING, reset_hold);
        server.setHandler("after-reset", "/after-reset", NOTHING, new AfterResetHandler(reset_hold));

        int h2_port = server.addListener(<HttpListenerOptionInfo>{
            "node": "127.0.0.1",
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        }).port;

        *int h3_port;
        try {
            h3_port = server.addQuicListener(<HttpListenerOptionInfo>{
                "cert": new SSLCertificate(CertPem),
                "key": new SSLPrivateKey(KeyPem),
            }).port;
        } catch (hash<ExceptionInfo> ex) {
            # QUIC unavailable — H3 tests will skip
        }
        server.waitForAsyncIo();
        return {
            "server": server,
            "drain": drain,
            "reject": reject,
            "signaling_early": signaling_early,
            "reset_hold": reset_hold,
            "h2_url": "https://127.0.0.1:" + h2_port,
            "h3_url": h3_port ? ("https://127.0.0.1:" + h3_port) : NOTHING,
        };
    }

    private HttpClientIo::HttpClientConnectionManager makeMgr(string proto) {
        return new HttpClientIo::HttpClientConnectionManager(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": proto,
            "connect_timeout": 10s,
            "request_timeout": 30s,
            "logger": mLogger,
        });
    }

    #! readData(0) must be a non-blocking peek — the core regression this
    #! test guards against is Channel::recv(0) blocking forever (the
    #! DataStreamClientIo.sendDSv1Stream drain bug).  Starts a bidi stream,
    #! calls readData(0) before any data arrives, and asserts it returns
    #! within 1s (the semantic contract is "fast"; 1s is a generous ceiling).
    private drainNonBlockingImpl(string proto) {
        hash<auto> setup = makeServer();
        HttpServer server = setup.server;
        on_exit delete server;

        *string url = proto == "h3" ? setup.h3_url : setup.h2_url;
        if (!exists url) {
            testSkip(sprintf("%s not available", proto));
        }

        HttpClientIo::HttpClientConnectionManager mgr = makeMgr(proto);
        on_exit delete mgr;

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(url);
        stream.startStreaming("POST", "/drain",
            {"content-type": "application/octet-stream"}, True);

        date t0 = now_us();
        try {
            stream.readData(0);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "HTTPCLIENT-STREAM-CLOSED") {
                rethrow;
            }
        }
        date t1 = now_us();
        int elapsed_ms = (t1 - t0).durationMilliseconds();
        assertTrue(elapsed_ms < 1000,
            sprintf("%s readData(0) must be non-blocking (elapsed=%dms)", proto, elapsed_ms));

        # Abandon the stream; the server-side handler may still be waiting
        # for body data but tearing the manager down in on_exit cleans it up.
    }

    #! Shared peer-reset body for H2 and H3: the server resets the stream and
    #! answers 400; the client reads the response to its end, and then every
    #! send raises the typed reset: the result of a send does not depend on
    #! whether the response was read first.
    private peerResetImpl(string proto, string expected_err) {
        hash<auto> setup = makeServer();
        HttpServer server = setup.server;
        on_exit delete server;

        *string url = proto == "h3" ? setup.h3_url : setup.h2_url;
        if (!exists url) {
            testSkip(sprintf("%s not available", proto));
        }

        HttpClientIo::HttpClientConnectionManager mgr = makeMgr(proto);
        on_exit delete mgr;

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(url);
        stream.startStreaming("POST", "/reject",
            {"content-type": "application/octet-stream"}, True);

        # HTTP/2 reports the reset as the stream's error; on HTTP/3 the server
        # stopped reading with an error and sent its complete 400 response,
        # which the client reads after the STOP_SENDING that precedes it
        while (True) {
            auto ev = stream.readData(HangGuard);
            if (!exists ev) {
                throw "TIMEOUT", sprintf("%s: no stream event within %y", proto, HangGuard);
            }
            if (ev.typeCode() == NT_HASH && (ev.end_stream || ev.error)) {
                break;
            }
        }

        assertThrows(expected_err, \stream.sendData(), binary("x"),
            sprintf("%s peer reset surfaces typed exception", proto));
        # every later send reports the reset again
        assertThrows(expected_err, \stream.sendData(), binary("x"),
            sprintf("%s second send after the reset", proto));
        assertThrows(expected_err, \stream.writesDone(), NOTHING,
            sprintf("%s half-close after the reset", proto));
    }

    #! The server resets the stream and holds its response; once a later
    #! request on the same connection, which the server answers after the
    #! reset, has its response, the client has processed the reset, and every
    #! send raises the typed reset although the handle read nothing.  On
    #! HTTP/3 the reset is STOP_SENDING alone and the stream stays open, so
    #! the client must record the reset from the STOP_SENDING frame itself.
    private peerResetBeforeReadImpl(string proto, string expected_err) {
        hash<auto> setup = makeServer();
        HttpServer server = setup.server;
        on_exit delete server;

        *string url = proto == "h3" ? setup.h3_url : setup.h2_url;
        if (!exists url) {
            testSkip(sprintf("%s not available", proto));
        }

        HttpClientIo::HttpClientConnectionManager mgr = makeMgr(proto);
        on_exit delete mgr;

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(url);
        stream.startStreaming("POST", "/reset-hold",
            {"content-type": "application/octet-stream"}, True);
        # the held handler answers when the test is done
        on_exit setup.reset_hold.release_queue.push(True);

        HttpClientIo::HttpClientStreamHandle stream2 = mgr.acquireStream(url);
        assertEq(stream.getConnection(), stream2.getConnection(), "second request uses the same connection");
        hash<auto> resp2 = stream2.request("GET", "/after-reset");
        assertEq(200, resp2.status_code, sprintf("%y", resp2.body));
        assertEq(HttpClientIo::HttpClientStreamState::Open, stream.getState(), "the handle read nothing");

        assertThrows(expected_err, \stream.sendData(), binary("x"),
            sprintf("%s peer reset surfaces typed exception", proto));
        # every later send reports the reset again
        assertThrows(expected_err, \stream.sendData(), binary("x"),
            sprintf("%s second send after the reset", proto));
        assertThrows(expected_err, \stream.writesDone(), NOTHING,
            sprintf("%s half-close after the reset", proto));
    }

    #! The server answers a body-streaming request without reading the body
    #! and then closes the stream with RST_STREAM(NO_ERROR).  A half-close by
    #! the client after that is a no-op, sending data raises
    #! HTTPCLIENT-STREAM-CLOSED, and the response is intact.
    testH2SendAfterEarlyResponse() {
        hash<auto> setup = makeServer();
        HttpServer server = setup.server;
        on_exit delete server;

        HttpClientIo::HttpClientConnectionManager mgr = makeMgr("h2");
        on_exit delete mgr;

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(setup.h2_url);
        int sid = stream.startStreaming("POST", "/early",
            {"content-type": "application/octet-stream"}, True);

        # END_STREAM always arrives as an event of its own on a streaming
        # request, so the handle is not in a terminal state after this read;
        # the first event carries the headers, and also the body when the
        # whole response was processed in one poll cycle
        auto first = stream.readData();
        assertEq(NT_HASH, first.typeCode());
        assertEq(200, first.status_code);
        assertNothing(first.end_stream);
        HttpClientIo::HttpClientStreamState open_state = stream.getState();
        assertTrue(open_state == HttpClientIo::HttpClientStreamState::HeadersReceived
            || open_state == HttpClientIo::HttpClientStreamState::ReceivingBody,
            sprintf("state after the first event: %y", open_state));

        # The server writes the complete response and the RST_STREAM(NO_ERROR)
        # that follows it in one flush, which is before it can receive a
        # later request on the same connection; frames on a connection are
        # processed in order, so once a later request on the connection has
        # completed, the client has processed the stream's close
        HttpClientIo::HttpClientStreamHandle stream2 = mgr.acquireStream(setup.h2_url);
        assertEq(stream.getConnection(), stream2.getConnection(), "second request uses the same connection");
        hash<auto> resp2 = stream2.request("GET", "/ok");
        assertEq(200, resp2.status_code, sprintf("%y", resp2.body));
        # the handle has not seen END_STREAM yet, so its sends reach the session
        assertEq(open_state, stream.getState());

        # a half-close on a stream the server has closed is a no-op, as with
        # any closed stream
        stream.sendData(binary(), True);
        stream.writesDone();

        # sending data raises a classified error at both levels
        assertThrows("HTTPCLIENT-STREAM-CLOSED", \stream.sendData(), binary("x"));
        assertThrows("HTTPCLIENT-STREAM-CLOSED", \stream.sendData(), (binary("x"), True));
        HttpClientIo::Http2ClientConnection conn = cast<HttpClientIo::Http2ClientConnection>(
            stream.getConnection());
        assertThrows("HTTP2-STREAM-CLOSED", \conn.sendStreamData(), (sid, binary("x")));
        assertThrows("HTTP2-STREAM-CLOSED", \conn.sendStreamData(), (sid, binary(), False));
        # the empty half-close is a no-op at the connection level too
        conn.sendStreamData(sid, binary(), True);

        # a stream ID that was never used is still an unknown stream
        assertThrows("HTTP2-ERROR", "stream .* not found", \conn.sendStreamData(), (sid + 1000, binary(), True));

        # the response is not discarded (RFC 9113 section 8.1)
        binary body;
        while (True) {
            auto chunk = stream.readData();
            if (chunk.typeCode() == NT_HASH) {
                if (chunk.end_stream) {
                    break;
                }
                assertNothing(chunk.error);
                continue;
            }
            body += binary(chunk);
        }
        assertEq("early", body.toString());
        assertEq(HttpClientIo::HttpClientStreamState::Complete, stream.getState());

        # the connection is still usable
        HttpClientIo::HttpClientStreamHandle stream3 = mgr.acquireStream(setup.h2_url);
        hash<auto> resp3 = stream3.request("GET", "/ok");
        assertEq(200, resp3.status_code);
        assertEq("ok", resp3.body.typeCode() == NT_BINARY ? resp3.body.toString() : resp3.body);
    }

    #! The server answers a body-streaming request without reading the body
    #! and asks the client to stop sending with STOP_SENDING(H3_NO_ERROR)
    #! (RFC 9114 section 4.1.2).  A half-close by the client after that is a
    #! no-op, sending data raises HTTPCLIENT-STREAM-CLOSED, and the response is
    #! intact.
    testH3SendAfterEarlyResponse() {
        hash<auto> setup = makeServer();
        HttpServer server = setup.server;
        on_exit delete server;
        if (!exists setup.h3_url) {
            testSkip("h3 not available");
        }

        HttpClientIo::HttpClientConnectionManager mgr = makeMgr("h3");
        on_exit delete mgr;

        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(setup.h3_url);
        int sid = stream.startStreaming("POST", "/sent-signal",
            {"content-type": "application/octet-stream"}, True);

        # The response is reported as sent only once the server has closed the
        # stream, which needs the client's RESET_STREAM answering the server's
        # STOP_SENDING; a client connection reads packets only while it has a
        # request in progress, so the server answers a second request on the
        # same connection only once the response has been reported as sent,
        # and when the client has the second response, it has processed the
        # STOP_SENDING
        HttpClientIo::HttpClientStreamHandle stream2 = mgr.acquireStream(setup.h3_url);
        assertEq(stream.getConnection(), stream2.getConnection(), "second request uses the same connection");
        hash<auto> resp2 = stream2.request("GET", "/wait-for-sent");
        assertEq(200, resp2.status_code, sprintf("%y", resp2.body));
        assertEq("sent", resp2.body.typeCode() == NT_BINARY ? resp2.body.toString() : resp2.body,
            "the early response was sent");
        # the handle has not read the response, so its sends reach the session
        assertEq(HttpClientIo::HttpClientStreamState::Open, stream.getState());

        # sending data raises a classified error at both levels
        assertThrows("HTTPCLIENT-STREAM-CLOSED", \stream.sendData(), binary("x"));
        assertThrows("HTTPCLIENT-STREAM-CLOSED", \stream.sendData(), (binary("x"), True));
        HttpClientIo::Http3ClientConnection conn = cast<HttpClientIo::Http3ClientConnection>(
            stream.getConnection());
        assertThrows("QUIC-STREAM-CLOSED", \conn.sendStreamData(), (sid, binary("x")));
        assertThrows("QUIC-STREAM-CLOSED", \conn.sendStreamData(), (sid, binary(), False));
        # an empty half-close on a stream the server has stopped reading is a
        # no-op at the connection level and on the handle
        conn.sendStreamData(sid, binary(), True);
        stream.writesDone();

        # a stream ID that was never used is still an unknown stream
        assertThrows("QUIC-HTTP3-ERROR", \conn.sendStreamData(), (sid + 1000, binary(), True));

        # the response is not discarded (RFC 9114 section 4.1.2)
        binary body;
        while (True) {
            auto chunk = stream.readData();
            if (chunk.typeCode() == NT_HASH) {
                if (chunk.end_stream) {
                    break;
                }
                assertNothing(chunk.error);
                continue;
            }
            body += binary(chunk);
        }
        assertEq(200, stream.getResponse().status_code);
        assertEq("early", body.toString());
        assertEq(HttpClientIo::HttpClientStreamState::Complete, stream.getState());

        # the connection is still usable
        HttpClientIo::HttpClientStreamHandle stream3 = mgr.acquireStream(setup.h3_url);
        hash<auto> resp3 = stream3.request("GET", "/ok");
        assertEq(200, resp3.status_code);
        assertEq("ok", resp3.body.typeCode() == NT_BINARY ? resp3.body.toString() : resp3.body);
    }

    testH2DrainNonBlocking() {
        drainNonBlockingImpl("h2");
    }

    testH3DrainNonBlocking() {
        drainNonBlockingImpl("h3");
    }

    testH2PeerResetTyped() {
        peerResetImpl("h2", "HTTP2-STREAM-RESET");
    }

    testH3PeerResetTyped() {
        peerResetImpl("h3", "QUIC-STREAM-RESET");
    }

    testH2PeerResetBeforeRead() {
        peerResetBeforeReadImpl("h2", "HTTP2-STREAM-RESET");
    }

    testH3PeerResetBeforeRead() {
        peerResetBeforeReadImpl("h3", "QUIC-STREAM-RESET");
    }
}
