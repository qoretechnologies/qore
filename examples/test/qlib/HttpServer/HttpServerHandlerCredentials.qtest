#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires HttpServer
%requires HttpServerUtil

%exec-class HttpServerHandlerCredentialsTest

#! a hang guard only, never a timing assertion
const HangGuard = 20s;

#! The handler of a request gets it without the credentials of the request when its code is restricted (qore#7303)
/** The server calls a handler whose class is of a Program that a sandbox that does not trust its code governs (or
    that asks for it) with the request without the server's objects and the credentials of the request: its
    handleRequest(), and the handleRequest(cx, hdr, body) that the base class calls; a trusted handler, and the handler
    of a Program whose sandbox trusts its code, get the request as the server has it
*/
class HttpServerHandlerCredentialsTest inherits QUnit::Test {
    public {
        #! the tenant's handlers: each returns what it saw of the credentials of the request
        const TenantSource = "%modern
%requires HttpServer
%requires HttpServerUtil
string sub seen(hash<auto> cx, hash<auto> hdr) {
    return sprintf(\"authorization=%y cookie=%y cx.auth=%y cx.hdr.authorization=%y client-cert=%y\",
        exists hdr.authorization, exists hdr.cookie, exists cx.auth, exists cx.hdr.authorization,
        cx.hasKey(\"client-cert\"));
}
# overrides the top-level handleRequest()
class FullHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(HttpListenerInterface listener, Socket s, hash<auto> cx, hash<auto> hdr,
            *data body) {
        return <HttpResponseInfo>{\"code\": 200, \"body\": seen(cx, hdr)};
    }
}
# implements the handleRequest() that the base class calls
class SimpleHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return <HttpResponseInfo>{\"code\": 200, \"body\": seen(cx, hdr)};
    }
}
AbstractHttpRequestHandler sub get_handler(string name) {
    return name == \"full\" ? new FullHandler() : new SimpleHandler();
}
";
        const Filtered = "authorization=False cookie=False cx.auth=False cx.hdr.authorization=False client-cert=False";
    }

    constructor() : QUnit::Test("HTTP server: the credentials of a request for its handler", "1.0", \ARGV) {
        addTestCase("a handler of restricted code", \restrictedTest());
        addTestCase("a handler of a sandbox that trusts its code", \permissiveTest());
        addTestCase("a trusted handler", \trustedTest());
        set_return_value(main());
    }

    #! returns the tenant's Program with the given sandbox
    private Program getTenant(*SandboxManager sm) {
        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        if (sm) {
            p.setSandboxManager(sm);
        }
        p.parse(TenantSource, "tenant");
        return p;
    }

    #! sends a request with credentials to a server with the handler; returns what the handler saw
    private string request(AbstractHttpRequestHandler handler) {
        HttpServer server(<HttpServerOptionInfo>{});
        on_exit server.stop();
        server.setDefaultHandler("h", handler);
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        server.waitForAsyncIo();
        Socket c();
        c.connect("127.0.0.1:" + port, HangGuard);
        on_exit c.close();
        c.send("GET /x HTTP/1.1\r\nHost: localhost\r\nAuthorization: Bearer secret\r\nCookie: session=secret\r\n\r\n");
        hash<auto> h = c.readHTTPHeader(HangGuard);
        assertEq(200, h.status_code, "the request is served");
        return c.recv(h."content-length".toInt(), HangGuard);
    }

    restrictedTest() {
        # the default sandbox does not trust its code
        Program p = getTenant(new SandboxManager());
        foreach string name in ("full", "simple") {
            assertEq(Filtered, request(p.callFunction("get_handler", name)), name);
        }
    }

    permissiveTest() {
        SandboxManager sm();
        sm.setFilesystemDefaultPolicy(True);
        sm.setNetworkDefaultPolicy(True);
        sm.setUncontrolledApiPolicy(True);
        Program p = getTenant(sm);
        foreach string name in ("full", "simple") {
            string seen = request(p.callFunction("get_handler", name));
            assertRegex("^authorization=True cookie=True cx.auth=True cx.hdr.authorization=True", seen, name);
        }
    }

    trustedTest() {
        Program p = getTenant();
        foreach string name in ("full", "simple") {
            string seen = request(p.callFunction("get_handler", name));
            assertRegex("^authorization=True cookie=True cx.auth=True cx.hdr.authorization=True", seen, name);
        }
    }
}
