#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires HttpServer
%requires HttpServerUtil

%exec-class HttpServerHandlerCredentialsTest

#! a hang guard only, never a timing assertion
const HangGuard = 20s;

#! The handler of a request gets it without the credentials of the request when its code is restricted (qore#7303)
/** The server calls a handler whose class is of a Program that a sandbox that does not trust its code governs (or
    that asks for it) with the request without the server's objects and the credentials of the request: its
    handleRequest(), and the handleRequest(cx, hdr, body) that the base class calls; a trusted handler, and the handler
    of a Program whose sandbox trusts its code, get the request as the server has it
*/
#! a trusted authenticator: consumes Basic credentials and adds a platform key to the request context
class TrustedAuthenticator inherits AbstractAuthenticator {
    public {
        list<string> seen;
    }

    *list<string> getPlatformContextKeys() {
        return ("platform_user",);
    }

    bool requiresAuthentication() {
        return True;
    }

    authenticate(reference<hash<auto>> cx, string user, string pass = "") {
        push seen, "credentials";
        if (user != "alice" || pass != "pw") {
            throw "AUTHENTICATION-ERROR", "invalid credentials";
        }
        cx.user = user;
        cx.platform_user = user;
        # a credential of the platform, which is not among its platform context keys
        cx.platform_token = "token-" + user;
    }

    authenticateByIP(reference<hash<auto>> cx, string ip, reference<bool> authenticated) {
        push seen, "no credentials";
        authenticated = False;
    }
}

class HttpServerHandlerCredentialsTest inherits QUnit::Test {
    public {
        #! the tenant's handlers: each returns what it saw of the credentials of the request
        const TenantSource = "%modern
%requires HttpServer
%requires HttpServerUtil
string sub seen(hash<auto> cx, hash<auto> hdr) {
    return sprintf(\"authorization=%y cookie=%y cx.auth=%y cx.hdr.authorization=%y client-cert=%y logger=%y \"
        \"listener=%y peer-info-future=%y socket=%y\", exists hdr.authorization, exists hdr.cookie,
        exists cx.auth, exists cx.hdr.authorization, cx.hasKey(\"client-cert\"), cx.hasKey(\"logger\"),
        cx.hasKey(\"listener\"), cx.hasKey(\"peer-info-future\"), cx.hasKey(\"socket\"));
}
our hash<string, string> hooks;
# records what each of its methods that the server calls saw
class HooksHandler inherits AbstractHttpRequestHandler {
    *hash<HttpResponseInfo> preprocessRequest(HttpListenerInterface listener, reference<hash<auto>> hdr,
            reference<hash<auto>> cx) {
        hooks.preprocess = seen(cx, hdr);
    }
    *hash<HttpResponseInfo> authenticateRequest(HttpListenerInterface listener, hash<auto> hdr,
            reference<hash<auto>> cx) {
        hooks.authenticate = seen(cx, hdr);
        hooks.authenticate_token = sprintf(\"%y\", cx.platform_token);
        if (hdr.path =~ /throw/) {
            throw \"TENANT-ERROR\", \"the tenant's authentication fails\";
        }
        return AbstractHttpRequestHandler::authenticateRequest(listener, hdr, \\cx);
    }
    hash<HttpResponseInfo> handleExpectHeader(hash<auto> cx, hash<auto> hdr) {
        hooks.expect = seen(cx, hdr);
        return AbstractHttpRequestHandler::handleExpectHeader(cx, hdr);
    }
    bool canHandleInline(hash<auto> cx, hash<auto> hdr) {
        if (hdr.path =~ /inline/) {
            hooks.can_inline = seen(cx, hdr);
            return True;
        }
        return False;
    }
    hash<HttpResponseInfo> handleInlineRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        hooks.inline = seen(cx, hdr);
        return <HttpResponseInfo>{\"code\": 200, \"body\": seen(cx, hdr)};
    }
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        hooks.request = seen(cx, hdr);
        return <HttpResponseInfo>{\"code\": 200, \"body\": sprintf(\"%s user=%y token=%y\", seen(cx, hdr), cx.platform_user,
            cx.platform_token)};
    }
}
# the tenant's own authenticator: records whether it got credentials
class TenantAuthenticator inherits AbstractAuthenticator {
    bool requiresAuthentication() {
        return True;
    }
    authenticate(reference<hash<auto>> cx, string user, string pass = \"\") {
        hooks.tenant_auth = \"credentials\";
    }
    authenticateByIP(reference<hash<auto>> cx, string ip, reference<bool> authenticated) {
        hooks.tenant_auth = \"no credentials\";
        authenticated = True;
    }
}
# a subclass of the host's authenticator: the tenant's code
class TenantSubAuthenticator inherits TrustedAuthenticator {
}
# an authenticator of the tenant that claims the platform's token as a platform key
class TokenClaimingAuthenticator inherits AbstractAuthenticator {
    *list<string> getPlatformContextKeys() {
        return (\"platform_token\",);
    }
}
AbstractAuthenticator sub get_token_claimer() {
    return new TokenClaimingAuthenticator();
}
AbstractHttpRequestHandler sub get_hooks_handler(*string auth) {
    HooksHandler h();
    switch (auth) {
        case \"tenant\": h.auth = new TenantAuthenticator(); break;
        case \"tenant-sub\": h.auth = new TenantSubAuthenticator(); break;
    }
    return h;
}
# a persistent handler: records what its end-of-session check saw
class PersistentHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        if (hdr.path =~ /start$/) {
            setPersistent(True);
        }
        return <HttpResponseInfo>{\"code\": 200, \"body\": \"ok\"};
    }
    bool isPersistentSessionEndRequest(hash<auto> hdr) {
        hooks.persistent_end = sprintf(\"authorization=%y cookie=%y\", exists hdr.authorization, exists hdr.cookie);
        return hdr.path =~ /end$/;
    }
}
AbstractHttpRequestHandler sub get_persistent_handler() {
    return new PersistentHandler();
}
class StubListener inherits HttpListenerInterface {
    nothing addUserThreadContext(hash<auto> uctx) {}
    auto removeUserThreadContext(*string k) {}
    nothing log(string fmt, ...) {}
    nothing logError(string fmt, ...) {}
}
# authenticates a request with credentials of its own with the handler's authenticateRestrictedRequest(); then returns
# what the handler's authenticateRequest() does with a request without credentials of the same connection
hash<auto> sub try_mark(AbstractHttpRequestHandler h) {
    StubListener l();
    hash<auto> cx = {};
    cx.id = 7;
    *hash<auto> changes;
    *hash<auto> ah = h.authenticateRestrictedRequest(l, {\"authorization\": \"Basic \" + make_base64_string(\"alice:pw\")},
        \\cx, \\changes);
    hash<auto> cx2 = {};
    cx2.id = 7;
    *hash<auto> ah2 = h.authenticateRequest(l, {}, \\cx2);
    return {\"code1\": ah.code, \"code\": ah2.code, \"user2\": cx2.user};
}
hash<string, string> sub get_hooks() {
    return remove hooks;
}
# overrides the top-level handleRequest()
class FullHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(HttpListenerInterface listener, Socket s, hash<auto> cx, hash<auto> hdr,
            *data body) {
        return <HttpResponseInfo>{\"code\": 200, \"body\": seen(cx, hdr)};
    }
}
# implements the handleRequest() that the base class calls
class SimpleHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return <HttpResponseInfo>{\"code\": 200, \"body\": seen(cx, hdr)};
    }
}
# tries to read and change the listener's user thread context, the host's data
class UctxHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(HttpListenerInterface listener, Socket s, hash<auto> cx, hash<auto> hdr,
            *data body) {
        string rv;
        try {
            listener.addUserThreadContext({\"tenant\": True});
            rv = \"add=ok\";
        } catch (hash<ExceptionInfo> ex) {
            rv = \"add=\" + ex.err;
        }
        try {
            listener.removeUserThreadContext(\"tenant\");
            rv += \" remove=ok\";
        } catch (hash<ExceptionInfo> ex) {
            rv += \" remove=\" + ex.err;
        }
        return <HttpResponseInfo>{\"code\": 200, \"body\": rv};
    }
}
# drops the handler's trusted authenticator in its own authenticateRequest(), after the platform authenticated the
# request with it, and returns what it saw (qore#7303)
class AuthDroppingHandler inherits AbstractHttpRequestHandler {
    *hash<HttpResponseInfo> authenticateRequest(HttpListenerInterface listener, hash<auto> hdr,
            reference<hash<auto>> cx) {
        auth = NOTHING;
        return AbstractHttpRequestHandler::authenticateRequest(listener, hdr, \\cx);
    }
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return <HttpResponseInfo>{\"code\": 200, \"body\": sprintf(\"%s user=%y platform_user=%y\", seen(cx, hdr),
            cx.user, cx.platform_user)};
    }
}
AbstractHttpRequestHandler sub get_handler(string name) {
    switch (name) {
        case \"drop-auth\": return new AuthDroppingHandler();
        case \"full\": return new FullHandler();
        case \"uctx\": return new UctxHandler();
    }
    return new SimpleHandler();
}
";
        #! what a handler of restricted code sees: no credentials and no objects of the server, but its own socket
        const Filtered = "authorization=False cookie=False cx.auth=False cx.hdr.authorization=False client-cert=False "
            "logger=False listener=False peer-info-future=False socket=True";
    }

    constructor() : QUnit::Test("HTTP server: the credentials of a request for its handler", "1.0", \ARGV) {
        addTestCase("a handler of restricted code", \restrictedTest());
        addTestCase("a handler of a sandbox that trusts its code", \permissiveTest());
        addTestCase("a trusted handler", \trustedTest());
        addTestCase("the methods of a handler of restricted code", \hooksTest());
        addTestCase("a trusted authenticator of a handler of restricted code", \platformAuthTest());
        addTestCase("an authenticator of restricted code", \tenantAuthTest());
        addTestCase("no mark of an authenticated request outlives its authentication", \keepMarkTest());
        addTestCase("the context keys that a trusted authenticator changes", \changedKeysTest());
        addTestCase("the end-of-session check of a persistent handler of restricted code", \persistentEndTest());
        addTestCase("the objects of the server are withheld from a handler of restricted code", \serverObjectsTest());
        addTestCase("a handler of restricted code uses its own user thread context", \uctxTest());
        addTestCase("a handler of restricted code that drops its trusted authenticator", \dropAuthTest());
        addTestCase("the authenticator of a request is read once", \swapAuthTest());
        set_return_value(main());
    }

    #! returns the tenant's Program with the given sandbox
    private Program getTenant(*SandboxManager sm) {
        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        if (sm) {
            p.setSandboxManager(sm);
        }
        p.importClass("TrustedAuthenticator");
        p.parse(TenantSource, "tenant");
        return p;
    }

    #! sends a request with the given credentials to the handler; returns the status code and the body
    private list<auto> send(AbstractHttpRequestHandler handler, string path, string authorization,
            *string expect_body) {
        HttpServer server(<HttpServerOptionInfo>{});
        on_exit server.stop();
        server.setDefaultHandler("h", handler);
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        server.waitForAsyncIo();
        Socket c();
        c.connect("127.0.0.1:" + port, HangGuard);
        on_exit c.close();
        if (expect_body) {
            c.send(sprintf("POST %s HTTP/1.1\r\nHost: localhost\r\nAuthorization: %s\r\nCookie: session=secret\r\n"
                "Expect: 100-continue\r\nContent-Length: %d\r\n\r\n", path, authorization, expect_body.size()));
            hash<auto> cont = c.readHTTPHeader(HangGuard);
            assertEq(100, cont.status_code, "100-continue");
            c.send(expect_body);
        } else {
            c.send(sprintf("GET %s HTTP/1.1\r\nHost: localhost\r\nAuthorization: %s\r\nCookie: session=secret\r\n\r\n",
                path, authorization));
        }
        hash<auto> h = c.readHTTPHeader(HangGuard);
        *string body = h."content-length".toInt() ? c.recv(h."content-length".toInt(), HangGuard) : NOTHING;
        return (h.status_code, body);
    }

    #! sends a request with credentials to a server with the handler; returns what the handler saw
    private string request(AbstractHttpRequestHandler handler) {
        HttpServer server(<HttpServerOptionInfo>{});
        on_exit server.stop();
        server.setDefaultHandler("h", handler);
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        server.waitForAsyncIo();
        Socket c();
        c.connect("127.0.0.1:" + port, HangGuard);
        on_exit c.close();
        c.send("GET /x HTTP/1.1\r\nHost: localhost\r\nAuthorization: Bearer secret\r\nCookie: session=secret\r\n\r\n");
        hash<auto> h = c.readHTTPHeader(HangGuard);
        assertEq(200, h.status_code, "the request is served");
        return c.recv(h."content-length".toInt(), HangGuard);
    }

    restrictedTest() {
        # the default sandbox does not trust its code
        Program p = getTenant(new SandboxManager());
        foreach string name in ("full", "simple") {
            assertEq(Filtered, request(p.callFunction("get_handler", name)), name);
        }
    }

    permissiveTest() {
        SandboxManager sm();
        sm.setFilesystemDefaultPolicy(True);
        sm.setNetworkDefaultPolicy(True);
        sm.setUncontrolledApiPolicy(True);
        Program p = getTenant(sm);
        foreach string name in ("full", "simple") {
            string seen = request(p.callFunction("get_handler", name));
            assertRegex("^authorization=True cookie=True cx.auth=True cx.hdr.authorization=True", seen, name);
            # the keys that the server sets on this path (no TLS: no client certificate)
            assertRegex(" logger=True .* socket=True$", seen, name + ": the server's context");
        }
    }

    trustedTest() {
        Program p = getTenant();
        foreach string name in ("full", "simple") {
            string seen = request(p.callFunction("get_handler", name));
            assertRegex("^authorization=True cookie=True cx.auth=True cx.hdr.authorization=True", seen, name);
            # the keys that the server sets on this path (no TLS: no client certificate)
            assertRegex(" logger=True .* socket=True$", seen, name + ": the server's context");
        }
    }

    hooksTest() {
        Program p = getTenant(new SandboxManager());
        AbstractHttpRequestHandler h = p.callFunction("get_hooks_handler");
        list<auto> r = send(h, "/x", "Bearer secret", "body");
        assertEq(200, r[0], "the request is served");
        hash<string, string> hooks = p.callFunction("get_hooks");
        foreach string hook in ("preprocess", "authenticate", "expect", "request") {
            assertEq(Filtered, hooks{hook}, hook);
        }
        r = send(h, "/inline", "Bearer secret");
        assertEq(200, r[0], "the inline request is served");
        hooks = p.callFunction("get_hooks");
        foreach string hook in ("can_inline", "inline") {
            assertEq(Filtered, hooks{hook}, hook);
        }
    }

    platformAuthTest() {
        Program p = getTenant(new SandboxManager());
        AbstractHttpRequestHandler h = p.callFunction("get_hooks_handler");
        TrustedAuthenticator auth();
        h.auth = auth;
        string basic = "Basic " + make_base64_string("alice:pw");
        list<auto> r = send(h, "/x", basic);
        assertEq(200, r[0], "the trusted authenticator authenticates the request");
        assertEq(("credentials",), auth.seen, "the trusted authenticator got the credentials");
        assertEq(Filtered + " user=\"alice\" token=null", r[1], "the handler gets its platform key, not the "
            "credentials or the platform's token");
        hash<string, string> hooks = p.callFunction("get_hooks");
        assertEq(Filtered, hooks.authenticate, "the handler's own authenticateRequest()");
        assertEq("null", hooks.authenticate_token, "no platform token in authenticateRequest()");
        auth.seen = ();
        r = send(h, "/x", "Basic " + make_base64_string("alice:wrong"));
        assertEq(401, r[0], "invalid credentials");
        # the handler's own authentication fails: the platform's authentication of the request ends with it
        r = send(h, "/throw", basic);
        assertEq(501, r[0], "the handler's authentication error");
        r = send(h, "/x", "Basic " + make_base64_string("alice:wrong"));
        assertEq(401, r[0], "invalid credentials after the error: no stale platform authentication");
    }

    tenantAuthTest() {
        Program p = getTenant(new SandboxManager());
        # the tenant's own authenticator gets no credentials
        list<auto> r = send(p.callFunction("get_hooks_handler", "tenant"), "/x",
            "Basic " + make_base64_string("alice:pw"));
        assertEq(200, r[0], "the tenant's authenticator accepts the request");
        assertEq("no credentials", p.callFunction("get_hooks").tenant_auth, "the tenant's authenticator");
        # a subclass of the trusted authenticator that the tenant declares is the tenant's code
        r = send(p.callFunction("get_hooks_handler", "tenant-sub"), "/x", "Basic " + make_base64_string("alice:pw"));
        assertEq(401, r[0], "the tenant's subclass of the trusted authenticator gets no credentials");
    }

    keepMarkTest() {
        Program p = getTenant(new SandboxManager());
        # a handler of the host with the trusted authenticator: it authenticates the filtered request itself
        SimpleHostHandler h();
        h.auth = new TrustedAuthenticator();
        hash<auto> r = p.callFunction("try_mark", h);
        assertEq(401, r.code1, "a handler of a trusted class authenticates the request without credentials itself");
        assertEq(401, r.code, "the trusted handler still authenticates its requests");
        assertNothing(r.user2);
        # a handler of the tenant with the trusted authenticator: no mark outlives the call
        AbstractHttpRequestHandler th = p.callFunction("get_hooks_handler");
        th.auth = new TrustedAuthenticator();
        r = p.callFunction("try_mark", th);
        assertNothing(r.code1, "the request with the tenant's own credentials is authenticated");
        assertEq(401, r.code, "no mark of the earlier request skips the authentication of a later call");
        assertNothing(r.user2);
        # a request to the trusted handler through the server is still authenticated
        list<auto> rv = send(h, "/x", "Basic " + make_base64_string("alice:wrong"));
        assertEq(401, rv[0], "the server's request to the trusted handler is authenticated");
    }

    #! The filter of the request after its authentication uses the authenticator that authenticated it: a handler of
    #! restricted code that drops it does not get the credential that it consumed (qore#7303)
    dropAuthTest() {
        Program p = getTenant(new SandboxManager());
        AbstractHttpRequestHandler h = p.callFunction("get_handler", "drop-auth");
        TrustedAuthenticator auth();
        h.auth = auth;
        # trusted code cannot opt in to a credential for a handler of restricted code
        assertThrows("REQUEST-ERROR", \h.setRequestCredentialHeaders(), "authorization");
        list<auto> r = send(h, "/x", "Basic " + make_base64_string("alice:pw"));
        assertEq(200, r[0], "the trusted authenticator authenticates the request");
        assertEq(("credentials",), auth.seen, "the trusted authenticator got the credentials");
        # the request is filtered as for the authenticator that authenticated it: its platform key is given, the
        # credentials that it consumed are not
        assertEq(Filtered + " user=\"alice\" platform_user=\"alice\"", r[1], "the handler's code");
    }

    #! The authenticator that authenticates the request of a handler of restricted code is read once: the handler's
    #! authenticator changed while the request is authenticated (by a thread of the tenant, which this test
    #! simulates in the trusted authenticator) is not used for the rest of the request (qore#7303)
    swapAuthTest() {
        Program p = getTenant(new SandboxManager());
        AbstractHttpRequestHandler h = p.callFunction("get_hooks_handler");
        SwappingAuthenticator auth(h, p.callFunction("get_token_claimer"));
        h.auth = auth;
        list<auto> r = send(h, "/x", "Basic " + make_base64_string("alice:pw"));
        assertEq(200, r[0], "the trusted authenticator authenticates the request");
        assertEq(Filtered + " user=\"alice\" token=null", r[1], "the handler gets the platform key of the "
            "authenticator that authenticated the request, not the platform's token");
    }

    uctxTest() {
        # its own user thread context, which the server keeps apart for each handler (qore#6847)
        assertEq("add=ok remove=ok", request(getTenant(new SandboxManager()).callFunction("get_handler", "uctx")),
            "restricted");
        assertEq("add=ok remove=ok", request(getTenant().callFunction("get_handler", "uctx")), "trusted");
    }

    serverObjectsTest() {
        SimpleHostHandler h();
        hash<auto> cx = {
            "logger": new Mutex(),
            "listener": new Mutex(),
            "peer-info-future": "future",
            "client-cert": "cert",
            "uctx": {"host": "data"},
            "socket": "127.0.0.1:1",
            "socket-info": {"port": 1},
            "sock_key": "key",
            "user": "alice",
        };
        # the handler's trusted authenticator changed the handler's own user thread context
        hash<HttpFilteredRequestInfo> f = h.withholdCredentialsForDispatch(cx, {}, {"changed": {"uctx": {"a": 0}}});
        foreach string key in ("logger", "listener", "peer-info-future", "client-cert") {
            assertFalse(f.cx.hasKey(key), key);
        }
        # the handler's own user thread context (qore#6847), from before the authentication
        assertEq({"a": 0}, f.cx.uctx);
        # the handler's own request
        assertEq("127.0.0.1:1", f.cx.socket);
        assertEq({"port": 1}, f.cx."socket-info");
        assertEq("key", f.cx.sock_key);
        assertEq("alice", f.cx.user);
    }

    changedKeysTest() {
        SimpleHostHandler h();
        hash<auto> cx = {"auth": "Basic x", "token": "secret", "session": {"a": 1}, "user": "alice"};
        hash<HttpFilteredRequestInfo> f = h.withholdCredentialsForDispatch(cx, {"authorization": "Basic x"},
            {"added": ("token",), "changed": {"session": {"a": 0}}});
        assertFalse(f.cx.hasKey("token"), "an added key is withheld");
        assertEq({"a": 0}, f.cx.session, "a changed key has its value from before the authentication");
        assertEq("alice", f.cx.user);
        assertFalse(f.cx.hasKey("auth"));
        assertFalse(f.hdr.hasKey("authorization"));
        # the raw Authorization value is not given back as a value from before the authentication
        f = h.withholdCredentialsForDispatch(cx, {}, {"changed": {"auth": "Basic raw"}});
        assertFalse(f.cx.hasKey("auth"), "a changed raw Authorization value is not restored");
    }

    persistentEndTest() {
        Program p = getTenant(new SandboxManager());
        AbstractHttpRequestHandler h = p.callFunction("get_persistent_handler");
        HttpServer server(<HttpServerOptionInfo>{});
        on_exit server.stop();
        server.setDefaultHandler("h", h);
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        server.waitForAsyncIo();
        Socket c();
        c.connect("127.0.0.1:" + port, HangGuard);
        on_exit c.close();
        c.send("GET /start HTTP/1.1\r\nHost: localhost\r\n\r\n");
        hash<auto> r = c.readHTTPHeader(HangGuard);
        assertEq(200, r.status_code, "the session starts");
        c.recv(r."content-length".toInt(), HangGuard);
        # the next request of the session, with credentials, ends it
        c.send("GET /end HTTP/1.1\r\nHost: localhost\r\nAuthorization: Bearer secret\r\nCookie: session=secret\r\n\r\n");
        r = c.readHTTPHeader(HangGuard);
        assertEq(200, r.status_code, "the session ends");
        assertEq("authorization=False cookie=False", p.callFunction("get_hooks").persistent_end,
            "the end-of-session check gets no credentials");
    }
}

#! the trusted authenticator, which replaces the handler's authenticator while it authenticates a request
class SwappingAuthenticator inherits TrustedAuthenticator {
    private {
        AbstractHttpRequestHandler handler;
        AbstractAuthenticator replacement;
    }

    constructor(AbstractHttpRequestHandler handler, AbstractAuthenticator replacement) {
        self.handler = handler;
        self.replacement = replacement;
    }

    authenticate(reference<hash<auto>> cx, string user, string pass = "") {
        TrustedAuthenticator::authenticate(\cx, user, pass);
        handler.auth = replacement;
    }
}

#! a handler of the host
class SimpleHostHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return <HttpResponseInfo>{"code": 200, "body": "host"};
    }
}
