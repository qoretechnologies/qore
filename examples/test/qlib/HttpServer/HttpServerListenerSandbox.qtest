    HttpServer listeners created for sandboxed code are governed by the sandbox: the listener is created in a task
    run by a thread pool in the HttpServer module's Program, which has no sandbox of its own when the module was
    loaded by trusted code
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires HttpServerUtil
%requires HttpServer

%exec-class HttpServerListenerSandboxTest

#! a trusted handler that answers a plain request
class PlainHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return <HttpResponseInfo>{"code": 200, "body": "plain"};
    }
}

#! a trusted stream request that answers with the size of the body that it read
class SizeRequest inherits AbstractStreamRequest {
    private {
        int size = 0;
    }

    constructor(HttpListenerInterface listener, AbstractHttpRequestHandler handler, Socket s, hash<auto> cx,
            hash<auto> hdr, auto body) : AbstractStreamRequest(listener, handler, s, cx, hdr, body) {
    }

    private nothing recvImpl(hash<auto> v) {
        if (exists v.data) {
            size += v.data.size();
        }
    }

    private hash<HttpResponseInfo> getResponseHeaderMessageImpl() {
        return <HttpResponseInfo>{"code": 200, "body": sprintf("stream %d", size)};
    }
}

#! a trusted stream handler
class SizeHandler inherits AbstractHttpRequestHandler {
    constructor() : AbstractHttpRequestHandler(NOTHING, True) {
    }

    private AbstractStreamRequest getStreamRequestImpl(HttpListenerInterface listener, Socket s, hash<auto> cx,
            hash<auto> hdr, *data body) {
        return new SizeRequest(listener, self, s, cx, hdr, body);
    }
}

public class HttpServerListenerSandboxTest inherits QUnit::Test {
    constructor() : QUnit::Test("HttpServerListenerSandbox", "1.0") {
        addTestCase("listeners are governed by the caller's sandbox", \listenerSandboxTest());
        addTestCase("a listener that sandboxed code added serves the requests of trusted handlers",
            \sandboxedListenerServesTest());
        set_return_value(main());
    }

    #! Adds a listener in a sandboxed Program and returns the error, if any
    private *hash<ExceptionInfo> addListener(Program p, HttpServer server, string bind) {
        return p.callFunction("add_listener", server, bind, <HttpListenerOptionInfo>{});
    }

    sandboxedListenerServesTest() {
        # a sandbox that does not trust its code (it refuses uncontrolled APIs), which allows the loopback network
        SandboxManager sm();
        sm.setNetworkDefaultPolicy(True);

        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        p.setSandboxManager(sm);
        p.parse("%modern
int sub add_listener(object server, hash<auto> info) {
    return server.addListener(info).port;
}
", "http-listener-serves");

        HttpServer server(sub (string msg) {}, sub (string msg) {});
        on_exit server.stop();
        server.setHandler("plain", "^plain", NOTHING, new PlainHandler());
        server.setHandler("stream", "^stream", NOTHING, new SizeHandler());
        int port = p.callFunction("add_listener", server, <HttpListenerOptionInfo>{"node": "127.0.0.1",
            "service": 0});
        server.waitForAsyncIo();

        HTTPClient client({"url": "http://127.0.0.1:" + port});
        on_exit client.disconnect();
        hash<auto> info;
        # a plain request to a trusted handler
        hash<auto> resp = client.send(NOTHING, "GET", "/plain", NOTHING, False, \info);
        assertEq(200, resp.status_code);
        assertEq("plain", resp.body);
        # a request to a trusted stream handler
        resp = client.send("hello", "POST", "/stream", {"Content-Type": "text/plain"}, False, \info);
        assertEq(200, resp.status_code);
        assertEq("stream 5", resp.body);
    }

    listenerSandboxTest() {
        # a sandbox that denies the IPv4 wildcard address, which can always be bound without a sandbox, and the
        # loopback addresses, which can still be bound but not connected to
        SandboxManager sm();
        sm.setNetworkDefaultPolicy(True);
        sm.addNetworkDeniedIPRange("0.0.0.0/32");
        sm.blockLocalhost();

        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        p.setSandboxManager(sm);
        p.parse("%modern
*hash<ExceptionInfo> sub add_listener(object server, string bind, hash<auto> info) {
    try {
        server.addListeners(bind, info);
    } catch (hash<ExceptionInfo> ex) {
        return ex;
    }
}
", "http-listener-sandbox");

        HttpServer server(sub (string msg) {}, sub (string msg) {});
        on_exit server.stop();

        # the listener's bind to a denied address is denied
        *hash<ExceptionInfo> ex = addListener(p, server, "0.0.0.0:0");
        assertEq("NETWORK-ACCESS-DENIED", ex.err, "a listener on a denied address is denied");
        assertEq(0, server.getListeners().size(), "no listener is created on a denied address");

        # a loopback listener is allowed
        assertEq(NOTHING, addListener(p, server, "127.0.0.1:0"), "a listener on a loopback address is allowed");
        assertEq(1, server.getListeners().size(), "the loopback listener is created");

        # without a sandbox, the same address can be bound
        # all-interfaces: an unsandboxed listener may bind the wildcard address
        server.addListeners("0.0.0.0:0", <HttpListenerOptionInfo>{});
        assertEq(2, server.getListeners().size(), "an unsandboxed listener on the wildcard address is created");
    }
}
