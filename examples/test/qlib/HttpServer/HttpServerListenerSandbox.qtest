    DEALINGS IN THE SOFTWARE.

    HttpServer listeners created for sandboxed code are governed by the sandbox: the listener is created in a task
    run by a thread pool in the HttpServer module's Program, which has no sandbox of its own when the module was
    loaded by trusted code
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires HttpServerUtil
%requires HttpServer
%requires HttpClientIo

%exec-class HttpServerListenerSandboxTest

#! a trusted handler that answers a plain request
class PlainHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return <HttpResponseInfo>{"code": 200, "body": "plain"};
    }
}

#! a trusted stream request that answers with the size of the body that it read
class SizeRequest inherits AbstractStreamRequest {
    private {
        int size = 0;
    }

    constructor(HttpListenerInterface listener, AbstractHttpRequestHandler handler, Socket s, hash<auto> cx,
            hash<auto> hdr, auto body) : AbstractStreamRequest(listener, handler, s, cx, hdr, body) {
    }

    private nothing recvImpl(hash<auto> v) {
        if (exists v.data) {
            size += v.data.size();
        }
    }

    private hash<HttpResponseInfo> getResponseHeaderMessageImpl() {
        return <HttpResponseInfo>{"code": 200, "body": sprintf("stream %d", size)};
    }
}

#! a trusted stream handler
class SizeHandler inherits AbstractHttpRequestHandler {
    public {
        #! the class of the socket that the code serving the last request got
        *string socket_class;
    }

    constructor() : AbstractHttpRequestHandler(NOTHING, True) {
    }

    private AbstractStreamRequest getStreamRequestImpl(HttpListenerInterface listener, Socket s, hash<auto> cx,
            hash<auto> hdr, *data body) {
        socket_class = s.className();
        return new SizeRequest(listener, self, s, cx, hdr, body);
    }
}

