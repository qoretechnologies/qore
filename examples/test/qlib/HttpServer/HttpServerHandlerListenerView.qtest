#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - HTTP/2 and HTTP/3 (QUIC) WebSocket connections and sandboxed HTTP handlers
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires HttpServer
%requires HttpServerUtil
%requires WebSocketHandler
%requires WebSocketClient
%requires ../../TestCertificates.qm

%exec-class HttpServerHandlerListenerViewTest

#! a hang guard only, never a timing assertion; longer than the bound of a persistent session's close (60 s)
const HangGuard = 90s;

#! A listener that tells the test whether a connection is registered as a dedicated connection
class DedicatedListener inherits HttpListener {
    constructor(HttpServer server, code<nothing(...)> handleRequest, int id, Sequence ss,
            *hash<HttpListenerOptionInfo> opts) : HttpListener(server, handleRequest, id, ss, opts) {
    }

    bool hasDedicated(softstring id) {
        m.lock();
        on_exit m.unlock();
        return exists shh{id};
    }
}

#! A server whose listeners are DedicatedListener objects
class DedicatedServer inherits HttpServer {
    public {
        *DedicatedListener last;
    }

    constructor(hash<HttpServerOptionInfo> opts) : HttpServer(opts) {
    }

    private HttpListener getListener(HttpServer server, int id, hash<HttpListenerOptionInfo> info) {
        return last = new DedicatedListener(server, \handleRequest(), id, seqSessions, info);
    }
}

#! Records the listener objects that the methods of a handler get for one request
class MethodsHandler inherits AbstractHttpRequestHandler {
    public {
        Queue q();
        hash<auto> got;
    }

    *hash<HttpResponseInfo> preprocessRequest(HttpListenerInterface listener, reference<hash<auto>> hdr,
            reference<hash<auto>> cx) {
        got.preprocess = listener;
        return AbstractHttpRequestHandler::preprocessRequest(listener, \hdr, \cx);
    }

    *hash<HttpResponseInfo> authenticateRequest(HttpListenerInterface listener, hash<auto> hdr,
            reference<hash<auto>> cx) {
        got.authenticate = listener;
        return AbstractHttpRequestHandler::authenticateRequest(listener, hdr, \cx);
    }

    int getMaxDecodedBodySize(*HttpListenerInterface listener) {
        got.decoded = listener;
        return AbstractHttpRequestHandler::getMaxDecodedBodySize(listener);
    }

    hash<HttpResponseInfo> handleRequest(HttpListenerInterface listener, Socket s, hash<auto> cx, hash<auto> hdr,
            *data body) {
        got.handle = listener;
        q.push(remove got);
        return makeResponse(200, "ok");
    }
}

#! Records the listener object of the context of each WebSocket connection
class ViewWsHandler inherits WebSocketHandler {
    public {
        Queue q();
    }

    WebSocketConnection getConnectionImpl(hash<auto> cx, hash<auto> hdr, string cid) {
        q.push({
            "proto": cx."header-info".http3 ? "h3" : (cx."header-info".http2 ? "h2" : "h1"),
            "listener": cx.listener,
        });
        return new WebSocketConnection(self);
    }
}

#! A trusted handler with a persistent session: keeps the listener object and reports the end of its session
class PersistHandler inherits AbstractHttpRequestHandler {
    public {
        *HttpListenerInterface kept;
        Queue closed();
    }

    hash<HttpResponseInfo> handleRequest(HttpListenerInterface listener, Socket s, hash<auto> cx, hash<auto> hdr,
            *data body) {
        kept = listener;
        if (hdr.path =~ /start$/) {
            Queue q = closed;
            notifyClosed(sub () {
                q.push(True);
            });
            setPersistent(True);
            return makeResponse({"x-key": cx.sock_key, "x-tid": string(gettid())}, 200, "started");
        }
        return makeResponse({"x-tid": string(gettid())}, 200, isPersistent() ? "continued" : "not persistent");
    }
}

#! A trusted handler that answers the requests that follow a tenant's on the same connection
class OtherHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(HttpListenerInterface listener, Socket s, hash<auto> cx, hash<auto> hdr,
            *data body) {
        return makeResponse(200, "other");
    }
}

#! A trusted handler with a persistent session whose cleanup is held until the test releases it
class HeldCloseHandler inherits AbstractHttpRequestHandler {
    public {
        *HttpListenerInterface kept;
        Counter release(1);
        Queue closing();
    }

    hash<HttpResponseInfo> handleRequest(HttpListenerInterface listener, Socket s, hash<auto> cx, hash<auto> hdr,
            *data body) {
        kept = listener;
        Counter c = release;
        Queue q = closing;
        notifyClosed(sub () {
            q.push(True);
            c.waitForZero(HangGuard);
        });
        setPersistent(True);
        return makeResponse({"x-key": cx.sock_key}, 200, "started");
    }
}

#! An object of the interface that no server gave
class ForgedListener inherits HttpListenerInterface {
    log(string fmt, ...) {
    }
    logError(string fmt, ...) {
    }
    addUserThreadContext(hash<auto> uctx) {
    }
    auto removeUserThreadContext(*string k) {
    }
}

#! A trusted handler: keeps the listener object of one request and uses it in a later one, also on another thread
class KeepingHandler inherits AbstractHttpRequestHandler {
    public {
        *HttpListenerInterface kept;
        Queue results();
    }

    hash<HttpResponseInfo> handleRequest(HttpListenerInterface listener, Socket s, hash<auto> cx, hash<auto> hdr,
            *data body) {
        if (!kept) {
            kept = listener;
            return makeResponse(200, "kept");
        }
        hash<auto> r = {
            "same": kept === listener,
            "iface": listener instanceof HttpListenerInterface,
            "encoding": listener.getDefaultTextEncoding(),
        };
        # the user thread context added through the object is the one that the server keeps for this thread (in
        # the thread data of the module, which also gives it to the request contexts), and is removed through it
        listener.addUserThreadContext({"k6921": "v"});
        r.uctx_added = listener.removeUserThreadContext("k6921");
        r.uctx_removed = !exists listener.removeUserThreadContext("k6921");
        # the kept object works on another thread
        Queue q();
        HttpListenerInterface k = kept;
        background sub () {
            try {
                q.push(k.getMaxDecodedBodySize());
            } catch (hash<ExceptionInfo> ex) {
                q.push(ex.err);
            }
        }();
        r.other_thread = q.get(10s);
        results.push(r);
        return makeResponse(200, "ok");
    }
}

#! the handler objects of a listener's requests and connections do not give the listener itself (qore#6921)
/** A handler gets the listener of its request as an @ref HttpServer::HttpListenerInterface "HttpListenerInterface";
    the object that it gets has only the methods of that interface, so that the code of a handler, which may be
    sandboxed and serve one of the listeners of a shared server, cannot reach the listener's other methods or those
    of its socket, whatever type it casts the object to and however it calls its methods.  Before the change, a
    handler got the listener itself.
*/
class HttpServerHandlerListenerViewTest inherits QUnit::Test {
    public {
        #! a sandboxed tenant's handler: each attempt gives "ok" or the code of the exception raised
        const TenantSource = "%modern
%requires HttpServer
%requires HttpServerUtil

string sub try_it(code c) {
    try {
        c();
        return \"ok\";
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
}

class TenantHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(HttpListenerInterface listener, Socket s, hash<auto> cx, hash<auto> hdr,
            *data body) {
        hash<string, string> r = {
            \"cast\": try_it(sub () { HttpListener l = cast<HttpListener>(listener); }),
            \"call_object_method\": try_it(sub () { call_object_method(listener, \"getSslPrivateKey\"); }),
            \"string_name\": try_it(sub () {
                string m = \"getSslCertificate\";
                call_object_method_args(listener, m);
            }),
            \"call_reference\": try_it(sub () {
                auto l = listener;
                code c = \\l.getDedicatedSocketHandlers();
                c();
            }),
            \"socket\": try_it(sub () { call_object_method(listener, \"getSocketInfo\"); }),
            \"remove_other\": try_it(sub () { listener.removeExternalDedicatedSocket(1000000); }),
            \"iface\": listener instanceof HttpListenerInterface ? \"yes\" : \"no\",
            \"encoding\": listener.getDefaultTextEncoding(),
        };
        return makeResponse(200, (map $1.key + \"=\" + $1.value, r.pairIterator()).join(\"\\n\"));
    }
}

AbstractHttpRequestHandler sub get_handler() {
    return new TenantHandler();
}
";

        #! a tenant's handler that tries to close, take over or end another connection's persistent session
        const TenantPersistSource = "%modern
%requires HttpServer
%requires HttpServerUtil

string sub try_it(code c) {
    try {
        c();
        return \"ok\";
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
}

class TenantPersistProbe inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(HttpListenerInterface listener, Socket s, hash<auto> cx, hash<auto> hdr,
            *data body) {
        string key = hdr.\"x-key\";
        string r;
        if (hdr.path =~ /close1$/) {
            r = try_it(sub () { listener.signalPersistentSessionClose(key); });
        } else if (hdr.path =~ /close2$/) {
            r = try_it(sub () { call_object_method(listener, \"signalPersistentSessionClose\", key, self); });
        } else if (hdr.path =~ /register$/) {
            r = try_it(sub () { cx.\"header-info\".register_persistent_queue(key, new Queue()); });
        } else if (hdr.path =~ /deregister$/) {
            r = try_it(sub () { cx.\"header-info\".deregister_persistent_queue(key); });
        }
        return makeResponse(200, r);
    }
}

AbstractHttpRequestHandler sub get_handler() {
    return new TenantPersistProbe();
}
";

        #! a tenant's handler that registers a queue on its own connection's key, then reports what it received
        const TenantOwnKeySource = "%modern
%requires HttpServer
%requires HttpServerUtil

class OwnKeyProbe inherits AbstractHttpRequestHandler {
    private {
        Queue q();
    }

    hash<HttpResponseInfo> handleRequest(HttpListenerInterface listener, Socket s, hash<auto> cx, hash<auto> hdr,
            *data body) {
        if (hdr.path =~ /check$/) {
            return makeResponse(200, string(q.size()));
        }
        string r = sprintf(\"register=%y deregister=%y \", exists cx.\"header-info\".register_persistent_queue,
            exists cx.\"header-info\".deregister_persistent_queue);
        try {
            cx.\"header-info\".register_persistent_queue(cx.sock_key, q);
            r += \"ok\";
        } catch (hash<ExceptionInfo> ex) {
            r += ex.err;
        }
        return makeResponse(200, r);
    }
}

AbstractHttpRequestHandler sub get_handler() {
    return new OwnKeyProbe();
}
";

        #! a tenant's code that reads the member of a listener object through reflection
        const TenantReflectionSource = "%modern
%requires reflection
%requires HttpServer

string sub read_member(object o) {
    try {
        Class c = Class::getClass(o);
        NormalMember m = cast<NormalMember>(c.getMember(\"listener\"));
        m.getValue(o);
        return \"ok\";
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
}
";

        #! a tenant's look-alike of the listener object's class, with its name and signature, whose methods read and
        #! write the member of the object that the tenant was given; in the tenant's root namespace and in a namespace
        #! of the same name as the real class's (qore#7036)
        const TenantLookAlikeSource = "%modern
%requires HttpServer

our *object target;
our *string result;

class HttpListenerHandlerView inherits HttpServer::HttpListenerInterface {
    private:internal {
        *HttpListener listener;
    }

    constructor(HttpListener listener) {
        self.listener = listener;
    }

    log(string fmt, ...) {
    }

    logError(string fmt, ...) {
    }

    logResponse(hash<auto> cx, hash<auto> rv) {
    }

    removeExternalDedicatedSocket(softstring id) {
        # the attack on the object that the tenant was given: a write of its member
        try {
            ::target.listener = NOTHING;
            ::result = \"ok\";
        } catch (hash<ExceptionInfo> ex) {
            ::result = ex.err;
        }
    }

    removeExternalDedicatedSocket(softstring id, HttpServer::AbstractHttpSocketHandlerInterface handler) {
    }

    int getMaxDecodedBodySize() {
        return 0;
    }

    string getDefaultTextEncoding() {
        # the attack on the object that the tenant was given: a read of its member
        try {
            auto v = ::target.listener;
            return v ? v.className() : \"empty\";
        } catch (hash<ExceptionInfo> ex) {
            return ex.err;
        }
    }

    *hash<auto> getDefaultResponseHeaders() {
    }

    addUserThreadContext(hash<auto> uctx) {
    }

    auto removeUserThreadContext(*string k) {
    }

    signalPersistentSessionClose(softstring uh) {
    }

    signalPersistentSessionClose(softstring uh, HttpServer::AbstractHttpRequestHandler handler) {
    }
}

namespace HttpServer {
    class HttpListenerHandlerView inherits HttpServer::HttpListenerInterface {
        private:internal {
            *HttpListener listener;
        }

        constructor(HttpListener listener) {
            self.listener = listener;
        }

        log(string fmt, ...) {
        }

        logError(string fmt, ...) {
        }

        logResponse(hash<auto> cx, hash<auto> rv) {
        }

        removeExternalDedicatedSocket(softstring id) {
            # the attack on the object that the tenant was given: a write of its member
            try {
                ::target.listener = NOTHING;
                ::result = \"ok\";
            } catch (hash<ExceptionInfo> ex) {
                ::result = ex.err;
            }
        }

        removeExternalDedicatedSocket(softstring id, HttpServer::AbstractHttpSocketHandlerInterface handler) {
        }

        int getMaxDecodedBodySize() {
            return 0;
        }

        string getDefaultTextEncoding() {
            # the attack on the object that the tenant was given: a read of its member
            try {
                auto v = ::target.listener;
                return v ? v.className() : \"empty\";
            } catch (hash<ExceptionInfo> ex) {
                return ex.err;
            }
        }

        *hash<auto> getDefaultResponseHeaders() {
        }

        addUserThreadContext(hash<auto> uctx) {
        }

        auto removeUserThreadContext(*string k) {
        }

        signalPersistentSessionClose(softstring uh) {
        }

        signalPersistentSessionClose(softstring uh, HttpServer::AbstractHttpRequestHandler handler) {
        }
    }
}

hash<string, string> sub probe(object o) {
    target = o;
    HttpListener l(new HttpServer(<HttpServerOptionInfo>{}), sub () {}, 0, new Sequence(),
        <HttpListenerOptionInfo>{\"name\": \"look-alike\", \"no_bind\": True});
    hash<string, string> r;
    ::HttpListenerHandlerView root(l);
    r.root_read = root.getDefaultTextEncoding();
    root.removeExternalDedicatedSocket(\"x\");
    r.root_write = result;
    HttpServer::HttpListenerHandlerView ns(l);
    r.ns_read = ns.getDefaultTextEncoding();
    ns.removeExternalDedicatedSocket(\"x\");
    r.ns_write = result;
    return r;
}
";

        #! a tenant's socket handler: tries to remove its connection with another handler, then ends it as its own
        const TenantSocketSource = "%modern
%requires HttpServer
%requires HttpServerUtil
%requires WebSocketHandler

#! a socket handler of a sandboxed Program gets a 101 connection only as a WebSocketHandler, which sets it up without
#! the connection's socket (qore#7476); its startImpl() takes the connection over instead
class TenantSocketHandler inherits WebSocketHandler {
    private {
        Queue to_host;
        Queue from_host;
    }

    constructor(Queue to_host, Queue from_host) : WebSocketHandler() {
        self.to_host = to_host;
        self.from_host = from_host;
    }

    private bool startImpl(softstring lid, hash<auto> cx, hash<auto> hdr, Socket s) {
        string other;
        try {
            cx.listener.removeExternalDedicatedSocket(cx.id, new TenantSocketHandler(to_host, from_host));
            other = \"ok\";
        } catch (hash<ExceptionInfo> ex) {
            other = ex.err;
        }
        to_host.push({\"cid\": cx.id, \"other\": other});
        from_host.get();
        code c = setExternallyManaged(lid, cx, s);
        try {
            c();
            to_host.push(\"ok\");
        } catch (hash<ExceptionInfo> ex) {
            to_host.push(ex.err);
        }
        return True;
    }
}

AbstractHttpSocketHandler sub get_handler(Queue to_host, Queue from_host) {
    return new TenantSocketHandler(to_host, from_host);
}
";
    }

    constructor() : QUnit::Test("HttpServer handler listener view", "1.0", \ARGV) {
        addTestCase("a sandboxed handler cannot reach the listener", \sandboxedTest());
        addTestCase("a trusted handler keeps the object of its listener", \trustedTest());
        addTestCase("every method of a handler gets the object", \methodsTest());
        addTestCase("the context of a WebSocket connection gives the object", \webSocketTest());
        addTestCase("the server takes only the objects of its own listeners", \sendHttpErrorTest());
        addTestCase("a handler closes, takes over and ends only its own persistent session", \persistentTest());
        addTestCase("a sandboxed socket handler removes only its own connection", \dedicatedTest());
        addTestCase("HTTP/1.1: a handler cannot take over the requests of its own connection", \ownKeyTest(), "1.1");
        addTestCase("HTTP/2: a handler cannot take over the requests of its own connection", \ownKeyTest(), "2.0");
        addTestCase("HTTP/3: a handler cannot take over the requests of its own connection", \ownKeyTest(), "3.0");
        addTestCase("the wait for the cleanup of a closed persistent session is bounded", \closeBoundTest());
        addTestCase("sandboxed code cannot read the listener of the object through reflection", \reflectionTest());
        addTestCase("a sandboxed look-alike of the object's class cannot read or write its listener",
            \lookAlikeTest());
        set_return_value(main());
    }

    sandboxedTest() {
        Program tenant(PO_NO_CHILD_PO_RESTRICTIONS);
        tenant.parse(TenantSource, "tenant");
        SandboxManager sm();
        sm.setNetworkDefaultPolicy(True);
        tenant.setSandboxManager(sm);
        AbstractHttpRequestHandler handler = tenant.callFunction("get_handler");

        hash<string, string> r = getResult(handler);
        r.encoding = r.encoding.upr();
        # in one comparison, so that a failure shows every attempt
        assertEq({
            # the object is not the listener: no cast to HttpListener
            "cast": "RUNTIME-CAST-ERROR",
            # nor any of its other methods or those of its socket, however they are called
            "call_object_method": "METHOD-DOES-NOT-EXIST",
            "string_name": "METHOD-DOES-NOT-EXIST",
            "call_reference": "OBJECT-METHOD-REFERENCE-ERROR",
            "socket": "METHOD-DOES-NOT-EXIST",
            # sandboxed code can remove only the connection of its own handler
            "remove_other": "HTTPLISTENER-ACCESS-ERROR",
            # the methods of the interface work
            "iface": "yes",
            "encoding": "ISO-8859-1",
        }, r);
    }

    trustedTest() {
        KeepingHandler handler();
        HttpServer server(<HttpServerOptionInfo>{});
        server.setHandler("keep", "", NOTHING, handler);
        server.setDefaultHandler("keep", handler);
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        server.waitForAsyncIo();
        HTTPClient hc({"url": "http://127.0.0.1:" + port, "timeout": 10s});
        assertEq("kept", hc.get("/"));
        # a later request, on another connection
        hc.disconnect();
        assertEq("ok", hc.get("/"));
        hash<auto> r = handler.results.get(10s);
        assertTrue(r.same, "the object of a later request is the same");
        assertTrue(r.iface, "the object is an HttpListenerInterface");
        assertEq("ISO-8859-1", r.encoding.upr());
        assertEq("v", r.uctx_added);
        assertTrue(r.uctx_removed);
        assertEq(DefaultMaxDecodedBodySize, r.other_thread, "the kept object works on another thread");

        # once the listener is gone, the kept object does nothing and gives the defaults of the interface
        HttpListenerInterface k = handler.kept;
        delete server;
        k.log("after the listener %s", "is gone");
        k.logError("after the listener %s", "is gone");
        assertEq("ISO-8859-1", k.getDefaultTextEncoding());
        assertEq(DefaultMaxDecodedBodySize, k.getMaxDecodedBodySize());
        assertEq(NOTHING, k.getDefaultResponseHeaders());
        k.signalPersistentSessionClose("io-0");
    }

    methodsTest() {
        MethodsHandler handler();
        HttpServer server(<HttpServerOptionInfo>{});
        on_exit delete server;
        server.setHandler("m", "", NOTHING, handler);
        server.setDefaultHandler("m", handler);
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        server.waitForAsyncIo();
        HTTPClient hc({"url": "http://127.0.0.1:" + port, "timeout": 10s});
        # a compressed body, so that the handler is asked for its maximum decoded size
        hc.send(gzip("body"), "POST", "/", {"Content-Encoding": "gzip"});
        hash<auto> got = handler.q.get(10s);
        assertEq(("authenticate", "decoded", "handle", "preprocess"), sort(keys got));
        foreach hash<auto> i in (got.pairIterator()) {
            assertTrue(i.value instanceof HttpListenerInterface, i.key);
            assertFalse(i.value instanceof HttpListener, i.key + ": not the listener");
            assertTrue(i.value === got.handle, i.key + ": the same object");
        }
    }

    webSocketTest() {
        ViewWsHandler handler();
        HttpServer server(<HttpServerOptionInfo>{});
        on_exit delete server;
        server.setDefaultHandler("ws", handler);
        int port = server.addListener(<HttpListenerOptionInfo>{
            "node": "127.0.0.1",
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
            "http_version": "auto",
        }).port;
        server.waitForAsyncIo();
        # HTTP/1.1 upgrade, HTTP/2 and HTTP/3 extended CONNECT
        foreach string v in (("1.1", "2.0", "3.0")) {
            WebSocketClient wsc(sub (*data msg) {}, {
                "url": sprintf("wss://127.0.0.1:%d", port),
                "http_version": v,
                "ssl_verify_cert": False,
                "timeout": HangGuard,
            });
            wsc.connect();
            on_exit wsc.disconnect();
            hash<auto> r = handler.q.get(HangGuard);
            string proto = {"1.1": "h1", "2.0": "h2", "3.0": "h3"}{v};
            assertEq(proto, r.proto);
            assertTrue(r.listener instanceof HttpListenerInterface, proto);
            assertFalse(r.listener instanceof HttpListener, proto + ": not the listener");
        }
    }

    sendHttpErrorTest() {
        KeepingHandler handler();
        HttpServer server(<HttpServerOptionInfo>{});
        on_exit delete server;
        server.setDefaultHandler("keep", handler);
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        server.waitForAsyncIo();
        HTTPClient hc({"url": "http://127.0.0.1:" + port, "timeout": 10s});
        hc.get("/");
        HttpListenerInterface view = handler.kept;

        HttpServer other(<HttpServerOptionInfo>{});
        on_exit delete other;
        # the object of another server's listener, and one that no server gave
        assertThrows("INVALID-LISTENER-ERROR", \other.sendHttpError(), (view, {}, new Socket(), 500, "x", NOTHING,
            NOTHING, NOTHING, False));
        assertThrows("INVALID-LISTENER-ERROR", \server.sendHttpError(), (new ForgedListener(), {}, new Socket(),
            500, "x", NOTHING, NOTHING, NOTHING, False));
    }

    persistentTest() {
        Program tenant = getTenantProgram(TenantPersistSource);
        AbstractHttpRequestHandler probe = tenant.callFunction("get_handler");
        PersistHandler owner();
        HttpServer server(<HttpServerOptionInfo>{});
        on_exit delete server;
        server.setHandler("p", "/p", NOTHING, owner);
        server.setHandler("t", "/t", NOTHING, probe);
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        server.waitForAsyncIo();
        string url = "http://127.0.0.1:" + port;

        # the owner's persistent session, on its own connection
        HTTPClient oc({"url": url, "timeout": 10s});
        oc.connect();
        on_exit oc.disconnect();
        hash<auto> start = oc.send(NOTHING, "GET", "/p/start");
        string key = start."x-key";
        string tid = start."x-tid";

        # the tenant's handler, on another connection of the same listener
        HTTPClient tc({"url": url, "timeout": 10s});
        hash<string, string> r;
        foreach string op in (("close1", "close2", "register", "deregister")) {
            r{op} = tc.send(NOTHING, "GET", "/t/" + op, {"x-key": key}).body;
        }
        assertEq({
            # the variant without the handler is refused to sandboxed code
            "close1": "HTTPLISTENER-ACCESS-ERROR",
            # with its own handler, it does not close a session that another handler registered
            "close2": "ok",
            # the closures that register and deregister persistent queues are not in its request's header information
            "register": "PSEUDO-METHOD-DOES-NOT-EXIST",
            "deregister": "PSEUDO-METHOD-DOES-NOT-EXIST",
        }, r);
        # the owner's session is still the owner's: its next request reaches its thread
        hash<auto> next;
        try {
            next = oc.send(NOTHING, "GET", "/p/continue");
        } catch (hash<ExceptionInfo> ex) {
            fail(sprintf("the owner's request did not reach it: %s: %s", ex.err, ex.desc));
        }
        assertEq("continued", next.body);
        assertEq(tid, next."x-tid", "the owner's session thread");
        assertEq(0, owner.closed.size(), "the session was not closed");
        # the owner closes its own session
        owner.kept.signalPersistentSessionClose(key, owner);
        assertTrue(owner.closed.get(HangGuard), "the owner's session is closed");
    }

    dedicatedTest() {
        Program tenant = getTenantProgram(TenantSocketSource);
        Queue to_host();
        Queue from_host();
        AbstractHttpSocketHandler handler = tenant.callFunction("get_handler", to_host, from_host);
        DedicatedServer server(<HttpServerOptionInfo>{});
        on_exit delete server;
        server.setDefaultHandler("s", handler);
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        server.waitForAsyncIo();

        Socket s();
        s.connect("127.0.0.1:" + port);
        on_exit s.close();
        s.send("GET /s HTTP/1.1\r\nHost: localhost\r\nConnection: Upgrade\r\nUpgrade: websocket\r\n"
            "Sec-WebSocket-Key: " + get_random_string(16).toBase64() + "\r\nSec-WebSocket-Version: 13\r\n\r\n");
        hash<auto> resp = s.readHTTPHeader(HangGuard);
        assertEq(101, resp.status_code);

        hash<auto> step = to_host.get(HangGuard);
        assertEq("ok", step.other);
        assertTrue(server.last.hasDedicated(step.cid), "another handler does not remove the connection");
        from_host.push(True);
        # the handler ends its own connection through setExternallyManaged() (no false refusal): the closure removes
        # it, and the socket of the request that the handler got refuses to shut the connection down, which the
        # server closes (qore#7476)
        assertEq("HTTP-HANDLER-SOCKET-ERROR", to_host.get(HangGuard));
        assertFalse(server.last.hasDedicated(step.cid), "the handler removed its own connection");
    }

    #! The registration of the review's PoC on the handler's own key: the closures are not in the handler's header
    #! information, and the next request on the connection reaches its own handler
    ownKeyTest(string http_version) {
        Program tenant = getTenantProgram(TenantOwnKeySource);
        AbstractHttpRequestHandler probe = tenant.callFunction("get_handler");
        HttpServer server(<HttpServerOptionInfo>{});
        on_exit delete server;
        server.setHandler("probe", "^probe", NOTHING, probe);
        server.setHandler("other", "^other", NOTHING, new OtherHandler());
        int port = server.addListener(<HttpListenerOptionInfo>{
            "node": "127.0.0.1",
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
            "http_version": "auto",
        }).port;
        server.waitForAsyncIo();
        HTTPClient hc({
            "url": "https://127.0.0.1:" + port,
            "http_version": http_version,
            "ssl_verify_cert": False,
            "timeout": 10s,
        });
        on_exit hc.disconnect();
        assertEq("register=False deregister=False PSEUDO-METHOD-DOES-NOT-EXIST", hc.get("/probe/grab"));
        # the next request on the same connection, for another handler, reaches it
        string next;
        try {
            next = hc.get("/other/next");
        } catch (hash<ExceptionInfo> ex) {
            fail(sprintf("the next request did not reach its handler: %s: %s", ex.err, ex.desc));
        }
        assertEq("other", next);
        assertEq("0", hc.get("/probe/check"), "the tenant's queue received nothing");
    }

    #! The owner's close returns although the session's cleanup does not complete
    closeBoundTest() {
        HeldCloseHandler owner();
        HttpServer server(<HttpServerOptionInfo>{});
        on_exit delete server;
        server.setDefaultHandler("h", owner);
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        server.waitForAsyncIo();
        HTTPClient hc({"url": "http://127.0.0.1:" + port, "timeout": 10s});
        hc.connect();
        on_exit hc.disconnect();
        string key = hc.send(NOTHING, "GET", "/start")."x-key";
        on_exit owner.release.dec();
        Queue done();
        background sub () {
            owner.kept.signalPersistentSessionClose(key, owner);
            done.push(True);
        }();
        # the session's cleanup has started and is held: the close returns at the end of its bound only
        assertTrue(owner.closing.get(HangGuard));
        assertTrue(done.get(2 * HangGuard), "the close returned while the cleanup was held");
    }

    reflectionTest() {
        KeepingHandler handler();
        HttpServer server(<HttpServerOptionInfo>{});
        on_exit delete server;
        server.setDefaultHandler("keep", handler);
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        server.waitForAsyncIo();
        HTTPClient hc({"url": "http://127.0.0.1:" + port, "timeout": 10s});
        hc.get("/");
        Program tenant = getTenantProgram(TenantReflectionSource);
        assertNeq("ok", tenant.callFunction("read_member", handler.kept));
    }

    #! A class of a tenant with the name and members of the listener object's class has no access to its members
    /** This needs the core to give private access only to the class itself, not to a class with the same name and
        signature (qore#7036)
    */
    lookAlikeTest() {
        KeepingHandler handler();
        HttpServer server(<HttpServerOptionInfo>{});
        on_exit delete server;
        server.setDefaultHandler("keep", handler);
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        server.waitForAsyncIo();
        HTTPClient hc({"url": "http://127.0.0.1:" + port, "timeout": 10s});
        hc.get("/");
        Program tenant = getTenantProgram(TenantLookAlikeSource);
        hash<string, string> r = tenant.callFunction("probe", handler.kept);
        # every attempt is refused: none reads the listener, and the write does not succeed
        foreach hash<auto> i in (r.pairIterator()) {
            string what = sprintf("%s (all: %y)", i.key, r);
            assertNeq("HttpListener", i.value, what + ": the listener is not read");
            assertNeq("ok", i.value, what + ": the member is not written");
            assertNeq("empty", i.value, what + ": the member is not reached");
        }
    }

    #! Returns a sandboxed Program with the given source
    private Program getTenantProgram(string source) {
        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        p.parse(source, "tenant");
        SandboxManager sm();
        sm.setNetworkDefaultPolicy(True);
        p.setSandboxManager(sm);
        return p;
    }

    #! runs one request with the given handler and returns what it found
    private hash<string, string> getResult(AbstractHttpRequestHandler handler) {
        HttpServer server(<HttpServerOptionInfo>{});
        on_exit delete server;
        server.setHandler("tenant", "", NOTHING, handler);
        server.setDefaultHandler("tenant", handler);
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        server.waitForAsyncIo();
        HTTPClient hc({"url": "http://127.0.0.1:" + port, "timeout": 10s});
        string body = hc.get("/");
        hash<string, string> r;
        foreach string line in (body.split("\n")) {
            (*string k, *string v) = (line =~ x/^([^=]+)=(.*)$/);
            r{k} = v ?? "";
        }
        return r;
    }
}
