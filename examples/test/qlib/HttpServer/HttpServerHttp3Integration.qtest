    HTTP/3 module-level integration tests - exercises HttpServer + HttpClientIo
    end-to-end over QUIC/HTTP/3.

    Tests cover:
    - Basic round-trip (GET, POST, status codes, headers, large bodies)
    - Connection and stream management (reuse, stats, cleanup, shutdown)
    - HTTP/3-specific validation (metadata, handler transparency)
    - Error handling (timeout, 404, server shutdown)
*/

%modern

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Mime.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/HttpServerUtil.qm
%requires ../../../../qlib/AsyncSocketIo
%requires ../../../../qlib/HttpServerAsyncIo
%requires ../../../../qlib/HttpServer.qm
%requires ../../../../qlib/HttpClientIo

%exec-class HttpServerHttp3IntegrationTest

#! Simple handler for basic GET tests
class SimpleHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, "Hello World", {"Content-Type": "text/plain"});
    }
}

#! Echo handler that returns the request body
class EchoHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, body ?? "", {
            "Content-Type": hdr."content-type" ?? "application/octet-stream",
        });
    }
}

#! Handler that returns a configurable status code from the path
class StatusCodeHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        int code = 200;
        *list<*string> m = (hdr.path =~ x/status\/(\d+)/);
        if (m) {
            code = int(m[0]);
        }
        return makeResponse(code, sprintf("Status: %d", code), {"Content-Type": "text/plain"});
    }
}

#! Handler that returns a large response body based on path size
class LargeResponseHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        int size = 1000;
        *list<*string> m = (hdr.path =~ x/large\/(\d+)/);
        if (m) {
            size = int(m[0]);
        }
        string response_body = strmul("X", size);
        return makeResponse(200, response_body, {"Content-Type": "text/plain"});
    }
}

#! Handler that echoes request headers back in the response body
class HeaderEchoHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        # Return selected headers in the response
        hash<auto> echoed;
        foreach string key in (keys hdr) {
            if (key.startsWith("x-custom-")) {
                echoed{key} = hdr{key};
            }
        }
        return makeResponse(200, sprintf("%Y", echoed), {"Content-Type": "text/plain"});
    }
}

#! Handler that returns an empty body with HTTP 200
class EmptyHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, "", {"Content-Type": "text/plain"});
    }
}

#! Handler that returns request body as binary unchanged
class BinaryHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, body ?? binary(), {
            "Content-Type": "application/octet-stream",
        });
    }
}

#! Handler that injects a fake Alt-Svc header pointing to a non-QUIC port
class FakeAltSvcHandler inherits AbstractHttpRequestHandler {
    private {
        int m_fake_port;
    }

    constructor(int fake_port) {
        m_fake_port = fake_port;
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, "Hello World", {
            "Content-Type": "text/plain",
            "Alt-Svc": sprintf("h3=\":%d\"; ma=3600", m_fake_port),
        });
    }
}

#! Handler that reports HTTP/3 metadata from the request context
/** @note HttpServer strips the leading '/' from hdr.path before dispatching to handlers;
    the original path is available in cx.orig_path.  This is consistent across HTTP/1.x,
    HTTP/2, and HTTP/3.
*/
#! Handler that echoes all request headers (including forbidden ones if they arrive)
class AllHeaderEchoHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        # Echo every non-pseudo header in a simple key=value format
        string result = "";
        foreach string key in (keys hdr) {
            if (key == "method" || key == "path" || key == "http_version") {
                continue;
            }
            result += sprintf("%s=%s\n", key, hdr{key});
        }
        return makeResponse(200, result, {"Content-Type": "text/plain"});
    }
}

#! Handler that intentionally injects RFC 9114 prohibited headers into the response
/** These headers should be stripped by the HTTP/3 layer (QuicSession::submitResponse)
    before they reach the wire.
*/
class ProhibitedHeaderResponseHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, "ok", {
            "Content-Type": "text/plain",
            # RFC 9114 Section 4.2 prohibited headers:
            "Connection": "keep-alive",
            "Keep-Alive": "timeout=5",
            "Proxy-Connection": "keep-alive",
            "Transfer-Encoding": "chunked",
            "Upgrade": "websocket",
            # Valid headers that should pass through:
            "X-Custom-Valid": "should-arrive",
        });
    }
}

class MetadataHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        # Use a simple key=value format that's easy to parse without external modules
        string result = sprintf("method=%s\npath=%s\norig_path=%s\nhttp_version=%s\nhttp3=%s\n",
            hdr.method, hdr.path, cx.orig_path, hdr.http_version,
            cx."header-info".http3 ? "true" : "false");
        return makeResponse(200, result, {"Content-Type": "text/plain"});
    }
}

