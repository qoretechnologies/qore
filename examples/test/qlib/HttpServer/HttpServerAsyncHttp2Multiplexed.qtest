    HTTP/2 multiplexed streaming test - verifies that WebSocket (RFC 8441),
    InputStream streaming, and regular HTTP/2 request/response all coexist
    on a single HTTP/2 server.
*/

%modern

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Mime.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/HttpServerUtil.qm
%requires ../../../../qlib/HttpServerAsyncIo
%requires ../../../../qlib/HttpServer.qm
%requires ../../../../qlib/RestClient.qm
%requires ../../../../qlib/WebSocketUtil.qm
%requires ../../../../qlib/WebSocketHandler.qm
%requires ../../../../qlib/WebSocketClient.qm

%try-module json
%define NoJson
%endtry

%exec-class HttpServerAsyncHttp2MultiplexedTest

#! Simple handler for regular HTTP/2 GET requests
class SimpleGetHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, "OK", {"Content-Type": "text/plain"});
    }
}

#! Handler that returns a large response body
class LargeResponseHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        int size = 1000;
        *list<*string> m = (hdr.path =~ x/large\/(\d+)/);
        if (m) {
            size = int(m[0]);
        }
        return makeResponse(200, strmul("X", size), {"Content-Type": "text/plain"});
    }
}

#! Handler that returns a BinaryInputStream body (streaming)
class StreamHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        int size = 8192;
        *list<*string> m = (hdr.path =~ x/stream\/(\d+)/);
        if (m) {
            size = int(m[0]);
        }
        return makeResponse(200, new BinaryInputStream(binary(strmul("S", size))), {
            "Content-Type": "application/octet-stream",
        });
    }
}

#! Handler that delays before responding
class SlowHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        int delay_ms = 200;
        *list<*string> m = (hdr.path =~ x/slow\/(\d+)/);
        if (m) {
            delay_ms = int(m[0]);
        }
        usleep(delay_ms * 1000);
        return makeResponse(200, sprintf("delayed %d ms", delay_ms), {"Content-Type": "text/plain"});
    }
}

#! Echo handler that returns the request body and method
class EchoHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        string resp_body = sprintf("method=%s", hdr.method);
        if (body) {
            if (body.typeCode() == NT_BINARY) {
                resp_body += sprintf(" body_size=%d body=%s", body.size(), body.toString());
            } else {
                resp_body += sprintf(" body_size=%d body=%s", body.length(), body);
            }
        }
        return makeResponse(200, resp_body, {"Content-Type": "text/plain"});
    }
}

#! Handler that always throws an exception
class ErrorHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        throw "TEST-ERROR", "intentional handler error for testing";
    }
}

#! WebSocket connection that echoes messages back
class EchoWsConnection inherits WebSocketConnection {
    constructor(WebSocketHandler handler) : WebSocketConnection(handler) {
    }

    gotMessage(string msg) {
        send("ECHO:" + msg);
    }

    gotMessage(binary msg) {
        send(msg);
    }
}

#! WebSocket handler for multiplexed testing
class MultiplexedWsHandler inherits WebSocketHandler {
    public {
        bool debug = False;
    }

    WebSocketConnection getConnectionImpl(hash<auto> cx, hash<auto> hdr, string cid) {
        return new EchoWsConnection(self);
    }

    logError(string fmt) {
        if (debug) {
            vprintf("WS ERROR: " + fmt + "\n", argv);
        }
    }

    logInfo(string fmt) {
        if (debug) {
            vprintf("WS INFO: " + fmt + "\n", argv);
        }
    }

    logDebug(string fmt) {
        if (debug) {
            vprintf("WS DEBUG: " + fmt + "\n", argv);
        }
    }
}

