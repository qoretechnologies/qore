#! Returns responses with multi-valued and non-string headers, and echoes the request cookies
class MultiValueHandler inherits AbstractHttpRequestHandler {
    public {
        #! The response headers sent
        const ResponseHeaders = {
            "Content-Type": MimeTypeText,
            "Set-Cookie": ("a=1; Path=/", "b=2, c=3"),
            "X-Int": 5,
            "X-Float": 1.5,
            "X-Bool": True,
            "X-Number": 2.25n,
            "X-List": ("x", 7),
            "X-Single": "single",
        };
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        if (cx.raw_path =~ /^\/case/) {
            return getCaseResponse(cx.raw_path);
        }
        string cookie = hdr.cookie.typeCode() == NT_LIST ? hdr.cookie.join("; ") : (hdr.cookie ?? "");
        hash<auto> headers = ResponseHeaders + {"X-Request-Cookie": cookie};
        if (cx.raw_path == "/stream") {
            # a streamed response body uses the streaming response header path
            return <HttpResponseInfo>{
                "code": 200,
                "body": new BinaryInputStream(binary("streamed body")),
                "hdr": headers,
            };
        }
        return makeResponse(headers, 200, binary("body"));
    }

    #! Returns a response whose headers have non-canonical names for fields that the server also sets
    private hash<HttpResponseInfo> getCaseResponse(string path) {
        hash<auto> headers = {
            "content-type": "application/octet-stream",
            "server": "case-server",
            "date": "Mon, 01 Jan 2001 00:00:00 GMT",
            # replaces the server's configured "X-Shared" header
            "x-shared": "handler",
        };
        switch (path) {
            case "/case-stream":
                return <HttpResponseInfo>{
                    "code": 200,
                    "body": new BinaryInputStream(binary("case body")),
                    "hdr": headers,
                };
            case "/case-error":
                return <HttpResponseInfo>{
                    "code": 404,
                    "body": binary("case body"),
                    "hdr": headers,
                };
        }
        return makeResponse(headers, 200, binary("case body"));
    }
}

public class HttpServerMultiValueHeadersTest inherits QUnit::Test {
    public {
        #! the server options; the configured headers have one header that handlers replace
        const ServerOptions = <HttpServerOptionInfo>{
            "hdr": {
                "X-Powered-By": "test",
                "X-Shared": "server",
                # a configured header with a non-canonical name for a field the server sets
                "server": "configured-server",
            },
        };
    }

    constructor() : Test("HttpServer multi-value headers test", "1.0") {
        addTestCase("HTTP/1.1", \http1Test());
        addTestCase("HTTP/2", \http2Test());
        addTestCase("HTTP/3", \http3Test());
        addTestCase("canonical header names", \canonicalNamesTest());
        set_return_value(main());
    }

    http1Test() {
        HttpServer server(ServerOptions);
        on_exit server.stop();
        server.setDefaultHandler("mv", new MultiValueHandler());
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        checkClient(new HTTPClient({"url": sprintf("http://127.0.0.1:%d", port), "error_passthru": True}), "1.1");
    }

    http2Test() {
        HttpServer server(ServerOptions);
        on_exit server.stop();
        server.setDefaultHandler("mv", new MultiValueHandler());
        int port = server.addListener(<HttpListenerOptionInfo>{
            "node": "127.0.0.1",
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
            "http_version": "2.0",
            "enable_h3": False,
        }).port;
        server.waitForAsyncIo();
        checkClient(new HTTPClient({"url": sprintf("https://127.0.0.1:%d", port), "ssl_verify_cert": False,
            "http_version": "2.0", "error_passthru": True}), "2");
    }

    http3Test() {
        HttpServer server(ServerOptions);
        on_exit server.stop();
        server.setDefaultHandler("mv", new MultiValueHandler());
        server.waitForAsyncIo();
        int port;
        try {
            port = server.addQuicListener(<HttpListenerOptionInfo>{
                "node": "127.0.0.1",
                "cert": new SSLCertificate(CertPem),
                "key": new SSLPrivateKey(KeyPem),
            }).port;
        } catch (hash<ExceptionInfo> ex) {
            testSkip(sprintf("QUIC listener not available: %s: %s", ex.err, ex.desc));
        }
        server.waitForAsyncIo();
        HTTPClient hc({"url": sprintf("https://127.0.0.1:%d", port), "ssl_verify_cert": False,
            "http_version": "3", "error_passthru": True});
        hc.connect();
        if (hc.getHttpVersion() != "HTTP/3") {
            testSkip(sprintf("HTTP/3 not negotiated (got %y)", hc.getHttpVersion()));
        }
        checkClient(hc, "3");
    }

    canonicalNamesTest() {
        assertNothing(http_canonicalize_reply_header_names());
        assertEq({}, http_canonicalize_reply_header_names({}));
        hash<auto> canonical = {"Content-Type": "a", "TE": "trailers", "x-other": "b"};
        assertEq(canonical, http_canonicalize_reply_header_names(canonical));
        # every managed name is converted, whatever its case
        foreach string name in (HttpServerManagedHeaderNames) {
            assertEq({name: "v"}, http_canonicalize_reply_header_names({name.lwr(): "v"}), name);
            assertEq({name: "v"}, http_canonicalize_reply_header_names({name.upr(): "v"}), name);
        }
        # other names and all values are kept as given
        assertEq({"Content-Type": ("a", "b"), "x-Other": 1, "Set-Cookie": "c"},
            http_canonicalize_reply_header_names({"content-TYPE": ("a", "b"), "x-Other": 1, "Set-Cookie": "c"}));
        # the last key for a field determines its value; the order of the other keys is kept
        hash<auto> h = http_canonicalize_reply_header_names({"Date": "1", "x-a": "a", "date": "2", "DATE": "3"});
        assertEq({"Date": "3", "x-a": "a"}, h);
        assertEq(("Date", "x-a"), keys h);
        # the managed names are unique and canonical
        assertEq(HttpServerManagedHeaderNames.size(), (map {$1.lwr(): True}, HttpServerManagedHeaderNames).size());
    }

    private hash<auto> doRequest(HTTPClient hc, string api, string path, *hash<auto> req_headers, string msg) {
        if (api == "sync") {
            hash<auto> info;
            hash<auto> resp = hc.send(NOTHING, "GET", path, req_headers, False, \info);
            return {
                "status": resp.status_code,
                "raw": info."response-headers-raw",
                "flat": resp - "body",
                "body": resp.body.typeCode() == NT_BINARY ? resp.body : binary(resp.body),
            };
        }
        AbstractPollOperation op = hc.startPollSendRecv("GET", path, NOTHING, req_headers);
        date deadline = now_us() + 30s;
        while (!op.goalReached()) {
            *hash<SocketPollInfo> pi = op.continuePoll();
            if (pi) {
                int remaining = (deadline - now_us()).durationMilliseconds();
                if (remaining <= 0) {
                    op.abort();
                    throw "TEST-TIMEOUT", msg;
                }
                Socket::poll((pi,), remaining);
            }
        }
        hash<auto> out = op.getOutput();
        return {
            "status": out.code,
            "raw": out.info."response-headers-raw",
            "flat": out.info."response-headers",
            "body": out."response-body".typeCode() == NT_BINARY
                ? out."response-body"
                : binary(out."response-body"),
        };
    }

    private checkClient(HTTPClient hc, string version) {
        foreach string path in (("/case", "/case-stream", "/case-error")) {
            foreach string api in (("sync", "async")) {
                string msg = sprintf("HTTP/%s %s %s", version, path, api);
                hash<auto> r = doRequest(hc, api, path, NOTHING, msg);
                assertEq(path == "/case-error" ? 404 : 200, r.status, msg);
                assertEq(binary("case body"), r.body, msg);
                # each field is received once, with the value of the handler
                hash<auto> h = map {$1.key.lwr(): $1.value}, r.raw.pairIterator();
                assertEq(r.raw.size(), h.size(), msg);
                assertEq("application/octet-stream", h."content-type", msg);
                assertEq("application/octet-stream", r.flat."content-type", msg);
                assertEq("case-server", h.server, msg);
                assertEq("handler", h."x-shared", msg);
                assertEq("test", h."x-powered-by", msg);
                # the server sets the date of every response
                assertEq(Type::String, h.date.type(), msg);
                assertRegex("GMT$", h.date, msg);
            }
        }

        foreach string path in (("/plain", "/stream")) {
            foreach string api in (("sync", "async")) {
                string msg = sprintf("HTTP/%s %s %s", version, path, api);
                # a request header with two values is sent as two fields
                hash<auto> r = doRequest(hc, api, path, {"Cookie": ("c1=v1", "c2=v2")}, msg);
                *hash<auto> flat = r.flat;
                assertEq(binary(path == "/stream" ? "streamed body" : "body"), r.body, msg);
                hash<auto> h = map {$1.key.lwr(): $1.value}, r.raw.pairIterator();
                # configured headers without a handler value are sent; a configured header replaces the server's
                # default even if its name is not canonical
                assertEq("server", h."x-shared", msg);
                assertEq("configured-server", h.server, msg);
                assertEq(MimeTypeText, h."content-type", msg);
                assertEq(("a=1; Path=/", "b=2, c=3"), h."set-cookie", msg);
                assertEq(("a=1; Path=/", "b=2, c=3"), flat."set-cookie", msg);
                assertEq("5", h."x-int", msg);
                assertEq("1.500000", h."x-float", msg);
                assertEq("1", h."x-bool", msg);
                assertEq("2.25", h."x-number", msg);
                assertEq(("x", "7"), h."x-list", msg);
                assertEq("single", h."x-single", msg);
                # both request cookie values arrived
                assertEq("c1=v1; c2=v2", h."x-request-cookie", msg);
            }
        }
    }
}
