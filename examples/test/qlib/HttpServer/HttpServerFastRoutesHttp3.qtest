#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires Util
%requires HttpServerUtil
%requires AsyncSocketIo
%requires HttpServerAsyncIo
%requires HttpServer
%requires HttpClientIo
%requires ../../TestCertificates.qm

%exec-class HttpServerFastRoutesHttp3Test

#! the handler: answers with "handler", or with "same" for /normal, and counts the requests that reach it
class Http3RouteTestHandler inherits AbstractHttpRequestHandler {
    public {
        static Counter calls = new Counter();
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        Http3RouteTestHandler::calls.inc();
        if (cx.raw_path == "/normal-empty") {
            return <HttpResponseInfo>{"code": 200};
        }
        return <HttpResponseInfo>{
            "code": 200,
            "body": cx.raw_path == "/normal" ? "same" : "handler",
            "hdr": {"Content-Type": "text/plain"},
        };
    }
}

#! Tests the HTTP server fast routes over HTTP/3: the request is answered when its HEADERS frame arrives, on the async
#! I/O thread, and never reaches a handler (see design/http-server-fast-routes.md, phase 3)
class HttpServerFastRoutesHttp3Test inherits QUnit::Test {
    private {
        HttpServer hs;
        string url;
        HttpClientIo::HttpClientConnectionManager mgr;
    }

    constructor() : QUnit::Test("HttpServerFastRoutesHttp3Test", "1.0", \ARGV) {
        addTestCase("a route answers over HTTP/3", \testBasic());
        addTestCase("the response is that of the handler", \testParity());
        addTestCase("cells, slots and fallbacks", \testRulesAndFallbacks());
        addTestCase("a large response", \testLarge());
        addTestCase("concurrent requests", \testConcurrent());
        addTestCase("routes created after the listener", \testRoutesAfterListener());
        set_return_value(main());
    }

    globalSetUp() {
        hs = new HttpServer();
        hs.setDefaultHandler("handler", new Http3RouteTestHandler());
        hs.waitForAsyncIo();
        # a route before the listener, so that the sessions of the listener have the routes from the start
        hs.addFastRoute("/first", {"public": True, "response": textResponse(200, "first")});
        hash<auto> info = hs.addQuicListener(<HttpListenerOptionInfo>{
            "cert": new SSLCertificate(TestCertificates::CertPem),
            "key": new SSLPrivateKey(TestCertificates::KeyPem),
        });
        url = sprintf("https://127.0.0.1:%d", info.port);
        mgr = new HttpClientIo::HttpClientConnectionManager();
    }

    globalTearDown() {
        mgr.closeAll();
        hs.stop();
        delete hs;
    }

    private static hash<auto> textResponse(int code, string body) {
        return {"code": code, "body": body, "content_type": "text/plain"};
    }

    private hash<auto> get(string path) {
        return mgr.request(url, "GET", path);
    }

    private static hash<auto> stable(hash<auto> hdr) {
        return hdr - ("date", "alt-svc");
    }

    testBasic() {
        hs.addFastRoute("/ping", {"public": True, "response": textResponse(200, "pong")});
        on_exit hs.removeFastRoute("/ping");

        int calls = Http3RouteTestHandler::calls.getCount();
        hash<auto> r = get("/ping");
        assertEq(200, r.status_code);
        assertEq("pong", r.body);
        assertEq("h3", r.protocol);
        for (int i = 0; i < 30; ++i) {
            assertEq("pong", get("/ping").body);
        }
        assertEq(calls, Http3RouteTestHandler::calls.getCount(), "the handler was not called");
        assertEq(31, hs.getFastRouteInfo().routes{"/ping"});

        # other requests on the same connection are answered by the handler
        assertEq("handler", get("/other").body);
        assertEq("pong", get("/ping").body);
        # the query string is not part of the route; an exact match only
        assertEq("pong", get("/ping?a=1&b=2").body);
        assertEq("handler", get("/ping/").body);
        # removing the route: the handler answers
        assertTrue(hs.removeFastRoute("/ping"));
        assertEq("handler", get("/ping").body);
        # the route that existed before the listener
        assertEq("first", get("/first").body);
    }

    testParity() {
        hs.addFastRoute("/fast", {"public": True, "response": textResponse(200, "same")});
        hs.addFastRoute("/fast-empty", {"public": True, "response": {"code": 200}});
        hs.addFastRoute("/fast-hdr", {"public": True, "response": {"code": 200, "body": "same",
            "content_type": "text/plain", "hdr": {"X-Custom": "v1"}}});
        on_exit {
            hs.removeFastRoute("/fast");
            hs.removeFastRoute("/fast-empty");
            hs.removeFastRoute("/fast-hdr");
        }

        hash<auto> normal = get("/normal");
        hash<auto> fast = get("/fast");
        assertEq("same", normal.body);
        assertEq("same", fast.body);
        assertEq(normal.status_code, fast.status_code);
        assertEq(sort(keys stable(normal.headers)), sort(keys stable(fast.headers)), "the same header names");
        foreach string name in (keys stable(normal.headers)) {
            assertEq(normal.headers{name}, stable(fast.headers){name}, "header " + name);
        }
        assertTrue(exists fast.headers.date, "the response has a date header");
        assertTrue(fast.headers."x-powered-by" =~ /^Qore\//, "the server's headers are added");

        # a 200 response without a body is a 204 response, as for the handler
        hash<auto> n2 = get("/normal-empty");
        hash<auto> f2 = get("/fast-empty");
        assertEq(204, n2.status_code);
        assertEq(204, f2.status_code);
        assertEq(sort(keys stable(n2.headers)), sort(keys stable(f2.headers)), "the same header names, 204");

        assertEq("v1", get("/fast-hdr").headers."x-custom");
    }

    testRulesAndFallbacks() {
        FastCell ready(1, 10s);
        hs.addFastRoute("/state", {
            "public": True,
            "rules": (
                {"cell": ready, "op": "==", "value": 1, "response": textResponse(200, "ready")},
                {"cell": ready, "op": "==", "value": 0, "response": textResponse(503, "starting")},
            ),
        });
        FastResponseSlot slot(10s);
        hs.addFastRoute("/slot", {"public": True, "response": slot});
        hs.addFastRoute("/post", {"public": True, "response": textResponse(200, "fast")});
        on_exit {
            hs.removeFastRoute("/state");
            hs.removeFastRoute("/slot");
            hs.removeFastRoute("/post");
        }

        hash<auto> r = get("/state");
        assertEq((200, "ready"), (r.status_code, r.body));
        ready.set(0);
        r = get("/state");
        assertEq((503, "starting"), (r.status_code, r.body));

        # an empty slot: the handler answers; a slot with a response: the route
        assertEq("handler", get("/slot").body);
        slot.set({"code": 200, "body": "one", "content_type": "text/plain"});
        assertEq("one", get("/slot").body);
        slot.set({"code": 200, "body": "two", "content_type": "text/plain"});
        assertEq("two", get("/slot").body);

        # a stale cell and a stale slot take the normal path
        qore_test_advance_fast_clock(11000);
        assertEq("handler", get("/state").body);
        assertEq("handler", get("/slot").body);
        ready.touch();
        slot.set({"code": 200, "body": "three", "content_type": "text/plain"});
        r = get("/state");
        assertEq((503, "starting"), (r.status_code, r.body), "a cell that is touched is current again");
        assertEq("three", get("/slot").body);

        # a request with a body is not answered by a route
        hash<auto> p = mgr.request(url, "POST", "/post", NOTHING, "x");
        assertEq("handler", p.body, "POST takes the normal path");
    }

    testLarge() {
        # the response cap of a fast route is 64 KiB: use the largest body that fits, which needs several packets
        string body = strmul("0123456789abcdef", 3900);
        hs.addFastRoute("/large", {"public": True, "response": textResponse(200, body)});
        on_exit hs.removeFastRoute("/large");
        for (int i = 0; i < 5; ++i) {
            hash<auto> r = get("/large");
            assertEq(body.size(), r.body.size());
            assertEq(body, r.body);
        }
        assertEq("handler", get("/other").body, "the connection is still usable");
    }

    testConcurrent() {
        hs.addFastRoute("/c", {"public": True, "response": textResponse(200, "fast")});
        on_exit hs.removeFastRoute("/c");
        int calls = Http3RouteTestHandler::calls.getCount();
        Counter done(6);
        Queue errors();
        for (int t = 0; t < 6; ++t) {
            background sub () {
                on_exit done.dec();
                try {
                    for (int i = 0; i < 30; ++i) {
                        string path = i % 3 ? "/c" : "/other";
                        string expected = i % 3 ? "fast" : "handler";
                        string got = get(path).body;
                        if (got != expected) {
                            errors.push(sprintf("%s: expected %y, got %y", path, expected, got));
                        }
                    }
                } catch (hash<ExceptionInfo> ex) {
                    errors.push(sprintf("%s: %s", ex.err, ex.desc));
                }
            }();
        }
        done.waitForZero(120s);
        assertEq(0, errors.size(), "no wrong or failed response: " + (errors.size() ? errors.get() : ""));
        assertEq(6 * 10, Http3RouteTestHandler::calls.getCount() - calls,
            "only the requests for /other reached the handler");
    }

    testRoutesAfterListener() {
        # a server whose first route is added after the QUIC listener: the listener's socket is given the routes then
        HttpServer hs2();
        on_exit {
            hs2.stop();
        }
        hs2.setDefaultHandler("handler", new Http3RouteTestHandler());
        hs2.waitForAsyncIo();
        hash<auto> info = hs2.addQuicListener(<HttpListenerOptionInfo>{
            "cert": new SSLCertificate(TestCertificates::CertPem),
            "key": new SSLPrivateKey(TestCertificates::KeyPem),
        });
        string url2 = sprintf("https://127.0.0.1:%d", info.port);
        HttpClientIo::HttpClientConnectionManager mgr2();
        on_exit mgr2.closeAll();

        # no routes yet: the handler answers
        assertEq("handler", mgr2.request(url2, "GET", "/late").body);
        hs2.addFastRoute("/late", {"public": True, "response": textResponse(200, "fast")});
        # a new connection (a session created after the routes) is answered by the route
        HttpClientIo::HttpClientConnectionManager mgr3();
        on_exit mgr3.closeAll();
        assertEq("fast", mgr3.request(url2, "GET", "/late").body);
        # and a route added to the table later applies to its sessions
        hs2.addFastRoute("/later", {"public": True, "response": textResponse(200, "fast2")});
        assertEq("fast2", mgr3.request(url2, "GET", "/later").body);
    }
}
