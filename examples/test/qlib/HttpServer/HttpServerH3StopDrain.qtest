#! a handler that blocks until it is released on the "block" path, and answers at once on any other path
class DrainHandler inherits AbstractHttpRequestHandler {
    public {
        #! receives the path of each blocking request as it enters the handler
        Queue entered();

        #! blocking requests return when this reaches zero
        Counter release(1);
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        if (hdr.path == "block") {
            entered.push(hdr.path);
            release.waitForZero();
            return makeResponse(200, "released", {"Content-Type": "text/plain"});
        }
        return makeResponse(200, "ok", {"Content-Type": "text/plain"});
    }

    #! releases every blocked request; safe to call more than once
    releaseAll() {
        if (release.getCount()) {
            release.dec();
        }
    }
}

#! records the server's drain log messages and pushes them to a Queue
class DrainLogAppender inherits LoggerAppenderWithLayout {
    public {
        Queue messages();
    }

    private {
        Mutex lck();
        list<string> all = ();
    }

    constructor() : LoggerAppenderWithLayout("drain-log", new LoggerLayoutPattern("%m")) {
        open();
    }

    processEventImpl(int type, auto params) {
        if (type == EVENT_LOG && params =~ /drain/) {
            {
                AutoLock al(lck);
                all += params;
            }
            messages.push(params);
        }
    }

    #! waits for a message matching the given pattern and returns it
    string waitFor(string pattern) {
        while (True) {
            string msg = messages.get(30s);
            if (msg.regex(pattern)) {
                return msg;
            }
        }
    }

    #! returns True if a message matching the given pattern was logged
    bool seen(string pattern) {
        AutoLock al(lck);
        return boolean(select all, $1.regex(pattern));
    }
}

class HttpServerH3StopDrainTest inherits QUnit::Test {
    constructor() : Test("HttpServerH3StopDrainTest", "1.0") {
        addTestCase("stop() answers an HTTP/3 request in progress and ends when the session closes",
            \testInFlightRequestFinishes());
        set_return_value(main());
    }

    testInFlightRequestFinishes() {
        DrainHandler handler();
        DrainLogAppender appender();
        Logger logger("h3-stop-drain-test", LoggerLevel::getLevelInfo());
        logger.addAppender(appender);
        HttpServer server(<HttpServerOptionInfo>{
            "logger": logger,
            # a drain timeout that a correct drain never reaches
            "drain_timeout": 60s,
        });
        on_exit {
            handler.releaseAll();
            server.stopImmediate();
        }
        server.setHandler("drain", "", NOTHING, handler);
        server.setDefaultHandler("drain", handler);
        server.waitForAsyncIo();
        int port = server.addQuicListener(<HttpListenerOptionInfo>{
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        }).port;
        string url = "https://127.0.0.1:" + port;

        HttpClientIo::HttpClientConnectionManager mgr(<HttpClientIo::HttpClientConnectionManagerOptions>{
            "protocol": "h3",
            "logger": new Logger("h3-stop-drain-client", LoggerLevel::getLevelError()),
            "request_timeout": 30s,
            "connect_timeout": 10s,
        });
        on_exit mgr.closeAll();

        Queue responses();
        background sub () {
            try {
                responses.push(mgr.request(url, "GET", "/block"));
            } catch (hash<ExceptionInfo> ex) {
                responses.push(ex);
            }
        }();
        assertEq("block", handler.entered.get(30s), "the request reaches the handler");

        Counter stopped(1);
        background sub () {
            on_exit stopped.dec();
            server.stop();
        }();
        appender.waitFor("drain started");
        assertEq(1, stopped.getCount(), "stop() waits for the request in progress");

        handler.releaseAll();
        hash<auto> resp = responses.get(30s);
        assertEq(200, resp.status_code, sprintf("the request in progress is answered: %y", resp));
        assertEq("released", resp.body);

        assertEq(0, stopped.waitForZero(30s), "stop() ends when the session is closed");
        assertFalse(appender.seen("did not finish"), "the drain did not time out");
    }
}
