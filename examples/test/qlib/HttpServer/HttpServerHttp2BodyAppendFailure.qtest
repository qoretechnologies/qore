-----END PRIVATE KEY-----";

        #! the size of each part of the body that is sent
        const PartSize = 16 * 1024;

        #! the size over which the buffer of a binary value cannot grow
        const Limit = 4 * 1024 * 1024;

        #! the most attempts of a request
        const MaxAttempts = 5;
    }

    constructor() : Test("HttpServerHttp2BodyAppendFailureTest", "1.0") {
        addTestCase("an HTTP/2 request body whose memory cannot be allocated fails the request", \appendFailureTest());
        set_return_value(main());
    }

    appendFailureTest() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("dbg_fail_binary_reserve_over() is only in debug builds of the library");
        }

        RequestErrorCapture capture();
        Logger logger("test", LoggerLevel::getLevelError());
        logger.addAppender(capture);
        HttpServer server(<HttpServerOptionInfo>{
            "logger": logger,
        });
        on_exit delete server;
        server.setDefaultHandler("size", new BodySizeHandler());
        int port = server.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "node": "127.0.0.1",
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
            "enable_h3": False,
        }).port;
        server.waitForAsyncIo();

        # a body that the server can collect
        hash<auto> r = send(port, 2 * Limit);
        assertEq(200, r.resp.status_code);
        assertEq(sprintf("served %d", 2 * Limit), r.resp.body);

        # the body cannot grow over the limit
        {
            call_function("dbg_fail_binary_reserve_over", Limit);
            on_exit call_function("dbg_fail_binary_reserve_over", 0);
            r = send(port, 4 * Limit, capture);
        }
        # the request is not served with the part of the body that the server collected
        if (r.resp) {
            assertEq(500, r.resp.status_code, sprintf("response: %y", r.resp.body));
        } else {
            assertTrue(exists r.ex, "the request failed");
        }
        assertEq(("SOCKET-RECV-ERROR",), r.errors);

        # the server keeps serving
        r = send(port, PartSize);
        assertEq(200, r.resp.status_code);
        assertEq(sprintf("served %d", PartSize), r.resp.body);
    }

    #! sends a request with a body of the given size over HTTP/2
    /** The HTTP/2 client refuses the data of the send callback with HTTP2-FLOW-CONTROL when more than 1 MiB of it
        waits for the server (as a server that reads slowly under load can make it), so the request is sent again on
        a new connection when that happens before the server logged an error.

        @return a hash with the response in \c resp, or the exception in \c ex, and the errors that the server logged
        in \c errors
    */
    private hash<auto> send(int port, int size, *RequestErrorCapture capture) {
        binary block = binary(strmul("x", PartSize));
        for (int attempt = 1; True; ++attempt) {
            HTTPClient client({
                "url": sprintf("https://127.0.0.1:%d", port),
                "ssl_verify_cert": False,
                "timeout": 60s,
            });
            on_exit client.disconnect();
            int sent = 0;
            code send_cb = *binary sub () {
                if (sent == size) {
                    return;
                }
                sent += PartSize;
                return block;
            };
            hash<auto> rv;
            try {
                rv.resp = client.sendWithSendCallback(send_cb, "POST", "/body",
                    {"Content-Type": "application/octet-stream"});
                if (rv.resp.body.typeCode() == NT_BINARY) {
                    rv.resp.body = binary_to_string(rv.resp.body);
                }
            } catch (hash<ExceptionInfo> ex) {
                rv.ex = ex;
            }
            # the errors that the server logged when the request ended
            if (capture) {
                date end = now_us() + 10s;
                bool failed = rv.ex || rv.resp.status_code != 200;
                while (!(rv.errors = capture.takeErrors()) && failed && now_us() < end) {
                    usleep(10ms);
                }
            }
            if (!rv.errors && rv.ex.err == "HTTP2-FLOW-CONTROL" && attempt < MaxAttempts) {
                continue;
            }
            return rv;
        }
    }
}
