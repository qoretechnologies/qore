    An HTTP/2 request body that the server collects for a handler, whose memory cannot be allocated, fails the
    request: the handler is not given the part of the body that was collected, the request is answered with an error
    on its stream, and the server keeps serving.  The allocation is made to fail by dbg_fail_binary_reserve_over()
    (debug builds of the library only).
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Logger
%requires HttpServerUtil
%requires HttpServer

%exec-class HttpServerHttp2BodyAppendFailureTest

#! keeps the errors of the requests that the server logs
class RequestErrorCapture inherits LoggerAppenderWithLayout {
    private {
        list<string> errors = ();
        Mutex lck();
    }

    constructor() : LoggerAppenderWithLayout("capture", new LoggerLayoutPattern("%m")) {
        open();
    }

    processEventImpl(int type, auto params) {
        if (type == EVENT_LOG) {
            *string err = (params =~ x/(SOCKET-RECV-ERROR): the memory for /)[0];
            if (err) {
                AutoLock al(lck);
                errors += err;
            }
        }
    }

    #! returns the errors logged since the last call
    list<string> takeErrors() {
        AutoLock al(lck);
        on_exit errors = ();
        return errors;
    }
}

#! answers a request with the size of the body that the server collected for it
class BodySizeHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(HttpListenerInterface listener, Socket s, hash<auto> cx, hash<auto> hdr,
            *data body) {
        return makeResponse(200, sprintf("served %d", body.size()), {"Content-Type": "text/plain"});
    }
}

