%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Mime
%requires Logger
%requires HttpServerUtil
%requires AsyncSocketIo
%requires HttpServerAsyncIo
%requires HttpServer
%requires HttpClientIo
%requires WebSocketUtil
%requires WebSocketHandler
%requires WebSocketClient

%exec-class HttpServerExtConnectNonSocketTest

#! a handler that is not a socket handler and answers every request with an ordinary 200 response with a body, as a
#! catch-all handler serving a web UI page does
class PlainPageHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(HttpListenerInterface listener, Socket s, hash<auto> cx, hash<auto> hdr,
            *data body) {
        return <HttpResponseInfo>{
            "code": 200,
            "body": "<html><body>index</body></html>",
            "hdr": {"Content-Type": MimeTypeHtml},
        };
    }
}

class EchoWsConnection inherits WebSocketConnection {
    constructor(WebSocketHandler handler) : WebSocketConnection(handler) {
    }

    gotMessage(string msg) {
        send(msg);
    }
}

class EchoWsHandler inherits WebSocketHandler {
    WebSocketConnection getConnectionImpl(hash<auto> cx, hash<auto> hdr, string cid) {
        return new EchoWsConnection(self);
    }
}

#! issue #5667: an extended CONNECT that a handler which is not a socket handler answers with an ordinary 2xx response
#! is refused with 501
/** Any 2xx response to an HTTP/2 or HTTP/3 extended CONNECT (RFC 8441, RFC 9220) establishes the tunnel.  The server
    sent the 200 response of a plain handler (with its body and the end of the stream) as it was, so a WebSocket
    client took it as an accepted connection; the server now answers 501, as it already did for a streaming response
    from a handler that is not a socket handler.  A real WebSocket handler is not affected.
*/
