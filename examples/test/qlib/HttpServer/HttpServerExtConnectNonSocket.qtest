    constructor() : Test("HttpServerExtConnectNonSocketTest", "1.0") {
        addTestCase("HTTP/2 extended CONNECT to a plain handler is refused", sub () { testPlain("2.0"); });
        addTestCase("HTTP/3 extended CONNECT to a plain handler is refused", sub () { testPlain("3.0"); });
        addTestCase("a WebSocket client reports the refusal over HTTP/2", \testPlainWebSocketClient());
        addTestCase("HTTP/2 extended CONNECT to a WebSocket handler is accepted", sub () { testWebSocket("2.0"); });
        addTestCase("HTTP/3 extended CONNECT to a WebSocket handler is accepted", sub () { testWebSocket("3.0"); });
        set_return_value(main());
    }

    globalSetUp() {
        logger = new Logger("ext-connect-non-socket-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }
    }

    #! creates a TLS server with HTTP/3 enabled: a WebSocket handler at /ws and a plain handler for every other path
    private hash<auto> setupServer() {
        HttpServer server(<HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        });
        server.setHandler("ws", "^ws", NOTHING, new EchoWsHandler());
        server.setHandler("plain", "", NOTHING, new PlainPageHandler());
        server.setDefaultHandler("plain", new PlainPageHandler());
        server.waitForAsyncIo();
        hash<auto> info = server.addListener(<HttpListenerOptionInfo>{
            "node": "127.0.0.1",
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
            "enable_h3": True,
        });
        server.waitForAsyncIo();
        return {"server": server, "port": info.port};
    }

    private WebSocketClient getClient(int port, string path, string http_version, code cb) {
        return new WebSocketClient(cb, {
            "url": sprintf("wss://127.0.0.1:%d/%s", port, path),
            "logger": logger,
            "http_version": http_version,
            "ssl_verify_cert": False,
            "timeout": 10s,
            "connect_timeout": 10s,
        });
    }

    #! an extended CONNECT to a path that the plain handler serves gets 501, not 200
    /** The request is made on a stream of HttpClientIo directly, and the status is read from the response that the
        stream received, so that the server's answer is checked whatever a WebSocket client does with it.
    */
    private testPlain(string http_version) {
        hash<auto> setup = setupServer();
        HttpServer server = setup.server;
        on_exit {
            server.stop();
        }
        HttpClientIo::HttpClientConnectionManager mgr(<HttpClientIo::HttpClientConnectionManagerOptions>{
            "protocol": http_version == "3.0" ? "h3" : "h2",
            "logger": logger,
            "request_timeout": 10s,
            "connect_timeout": 10s,
            "accept_all_certs": True,
            "max_connections_per_host": 1,
        });
        on_exit {
            mgr.closeAll();
        }
        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(sprintf("https://127.0.0.1:%d/ui/page",
            setup.port));
        assertEq(http_version == "3.0" ? "Http3ClientStreamHandle" : "Http2ClientStreamHandle", stream.className(),
            http_version + ": the stream has the requested protocol");
        stream.startStreaming("CONNECT", "/ui/page", {
            ":protocol": "websocket",
            "Sec-WebSocket-Key": get_random_string(16).toBase64(),
            "Sec-WebSocket-Version": "13",
        }, True);
        on_exit {
            stream.cancel();
        }
        # the first event carries the response headers, possibly with the body and the end of the stream
        stream.readData(10s);
        *hash<auto> resp = stream.getResponse();
        assertEq(501, resp.status_code, http_version + ": the CONNECT is refused");
    }

    #! with an explicitly requested HTTP/2, a WebSocket client reports the refusal
    private testPlainWebSocketClient() {
        hash<auto> setup = setupServer();
        HttpServer server = setup.server;
        on_exit {
            server.stop();
        }
        WebSocketClient wsc = getClient(setup.port, "ui/page", "2.0", sub (*data msg) {});
        on_exit {
            try {
                wsc.disconnect();
            } catch () {
            }
        }
        string err;
        try {
            wsc.connect();
            err = "connected";
        } catch (hash<ExceptionInfo> ex) {
            err = sprintf("%s: %s", ex.err, ex.desc);
        }
        assertRegex("^WEBSOCKET-ERROR: HTTP/2 .* returned status code '501'", err, "the client reports the refusal");
    }

    #! an extended CONNECT to the WebSocket handler is accepted, and a message makes the round trip
    private testWebSocket(string http_version) {
        hash<auto> setup = setupServer();
        HttpServer server = setup.server;
        on_exit {
            server.stop();
        }
        Queue q();
        WebSocketClient wsc = getClient(setup.port, "ws", http_version, sub (*data msg) {
            if (exists msg) {
                q.push(msg);
            }
        });
        on_exit {
            try {
                wsc.disconnect();
            } catch () {
            }
        }
        wsc.connect();
        wsc.send("hello");
        assertEq("hello", q.get(10s), http_version + ": echo over the tunnel");
    }
}
