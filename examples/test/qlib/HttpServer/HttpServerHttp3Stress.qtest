    constructor() : Test("HttpServerHttp3StressTest", "1.0") {
        # Set up SIGUSR1 handler to dump thread stacks for debugging hangs
        @debug {
            set_signal_handler(SIGUSR1, sub (int sig) {
                printf("=== SIGUSR1 Thread Stacks ===\n%Y\n=== End Thread Stacks ===\n",
                    get_all_thread_call_stacks());
            });
        }

        # Group 1: Throughput
        addTestCase("sustained throughput", \testSustainedThroughput());
        addTestCase("large body throughput", \testLargeBodyThroughput());

        # Group 2: Concurrency
        addTestCase("concurrent requests", \testConcurrentRequests());
        addTestCase("concurrent connections", \testConcurrentConnections());
        addTestCase("mixed concurrent workload", \testMixedConcurrentWorkload());

        # Group 3: Scalability
        addTestCase("many sequential requests", \testManySequentialRequests());
        addTestCase("increasing body sizes", \testIncreasingBodySizes());

        # Group 4: Reliability
        addTestCase("repeated connect/disconnect", \testRepeatedConnectDisconnect());
        addTestCase("back-to-back requests", \testBackToBackRequests());

        set_return_value(main());
    }

    globalSetUp() {
        mLogger = new Logger("http3-stress-test",
            m_options.verbose > 2 ? LoggerLevel::getLevelDebug() : LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            mLogger.addAppender(new StdoutAppender());
        }

        # Create HTTP server with async mode
        mServer = new HttpServer(<HttpServerOptionInfo>{
            "logger": mLogger,
            "debug": True,
            "async_mode": True,
        });

        # Register handlers
        mServer.setHandler("simple", "/hello", NOTHING, new SimpleHandler());
        mServer.setHandler("echo", "/echo", NOTHING, new EchoHandler());
        mServer.setHandler("status", "/status", NOTHING, new StatusCodeHandler());
        mServer.setHandler("large", "/large", NOTHING, new LargeResponseHandler());

        # Wait for async I/O to be ready
        mServer.waitForAsyncIo();

        # Add QUIC/HTTP/3 listener
        hash<auto> h3info = mServer.addQuicListener(<HttpListenerOptionInfo>{
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        });
        mH3Port = h3info.port;
        mH3Url = "https://127.0.0.1:" + mH3Port;

        if (m_options.verbose > 1) {
            printf("HTTP/3 stress test server started on UDP port %d\n", mH3Port);
        }
    }

    globalTearDown() {
        delete mServer;
    }

    #! Creates a new Http3ClientConnectionManager for independent test usage
    private HttpClientIo::HttpClientConnectionManager newManager(*timeout req_timeout) {
        return new HttpClientIo::HttpClientConnectionManager(
            <HttpClientIo::HttpClientConnectionManagerOptions>{
                "protocol": "h3",
                "logger": mLogger,
                "request_timeout": req_timeout ?? 30s,
                "connect_timeout": 15s,
            },
        );
    }

    # ---- Group 1: Throughput ----

    testSustainedThroughput() {
        auto mgr = newManager();
        on_exit mgr.closeAll();

        # Duration: 5s is a reasonable CI default; valgrind runs are auto-detected
        # via low throughput (testSkip if < 500 requests)
        date end_time = now_us() + 5s;
        int count = 0;
        int errors = 0;

        while (now_us() < end_time) {
            try {
                hash<auto> resp = mgr.request(mH3Url, "GET", "/hello");
                if (resp.status_code == 200) {
                    count++;
                } else {
                    errors++;
                }
            } catch (hash<ExceptionInfo> ex) {
                errors++;
                if (m_options.verbose > 1) {
                    printf("throughput error: %s: %s\n", ex.err, ex.desc);
                }
            }
        }

        # Under valgrind, count may be very low
        if (count < 10) {
            testSkip(sprintf("likely under valgrind: only %d requests in 5s", count));
            return;
        }

        assertEq(0, errors, "no errors during sustained throughput");
        assertTrue(count > 0, sprintf("throughput > 0: %d requests in 5s", count));

        if (m_options.verbose) {
            printf("sustained throughput: %d requests in 5s (%.1f req/s)\n",
                count, count / 5.0);
        }
    }

    testLargeBodyThroughput() {
        auto mgr = newManager();
        on_exit mgr.closeAll();

        int body_size = 10000;  # 10KB per response
        date end_time = now_us() + 5s;
        int count = 0;
        int total_bytes = 0;
        int errors = 0;

        while (now_us() < end_time) {
            try {
                hash<auto> resp = mgr.request(mH3Url, "GET",
                    sprintf("/large/%d", body_size));
                if (resp.status_code == 200) {
                    count++;
                    string body_str = resp.body.typeCode() == NT_BINARY
                        ? resp.body.toString("UTF-8") : resp.body;
                    total_bytes += body_str.size();
                } else {
                    errors++;
                }
            } catch (hash<ExceptionInfo> ex) {
                errors++;
                if (m_options.verbose > 1) {
                    printf("large body throughput error: %s: %s\n", ex.err, ex.desc);
                }
            }
        }

        if (count < 5) {
            testSkip(sprintf("likely under valgrind: only %d requests in 5s", count));
            return;
        }

        assertEq(0, errors, "no errors during large body throughput");
        assertTrue(count > 0, sprintf("throughput > 0: %d requests in 5s", count));

        if (m_options.verbose) {
            float mb_sec = (float(total_bytes) / (1024.0 * 1024.0)) / 5.0;
            printf("large body throughput: %d requests in 5s (%.1f req/s, %.2f MB/s)\n",
                count, count / 5.0, mb_sec);
        }
    }

    # ---- Group 2: Concurrency ----

    testConcurrentRequests() {
        auto mgr = newManager(60s);
        on_exit mgr.closeAll();

        int n = 20;
        Counter done(n);
        list<hash<auto>> results();
        Mutex m();

        for (int i = 0; i < n; i++) {
            int idx = i;
            background sub() {
                on_exit done.dec();
                try {
                    hash<auto> resp = mgr.request(mH3Url, "GET", "/hello");
                    string body_str = resp.body.typeCode() == NT_BINARY
                        ? resp.body.toString("UTF-8") : resp.body;
                    {
                        AutoLock al(m);
                        push results, {
                            "idx": idx,
                            "status": resp.status_code,
                            "body": body_str,
                            "success": True,
                        };
                    }
                } catch (hash<ExceptionInfo> ex) {
                    {
                        AutoLock al(m);
                        push results, {
                            "idx": idx,
                            "error": ex.err + ": " + ex.desc,
                            "success": False,
                        };
                    }
                }
            }();
        }

        assertEq(0, done.waitForZero(60s), "all concurrent requests completed");
        assertEq(n, results.size(), "got results for all requests");

        int successes = 0;
        foreach hash<auto> r in (results) {
            if (r.success) {
                successes++;
                assertEq(200, r.status, sprintf("request %d should return 200", r.idx));
                assertEq("Hello World", r.body,
                    sprintf("request %d body should match", r.idx));
            } else if (m_options.verbose) {
                printf("concurrent request %d failed: %s\n", r.idx, r.error);
            }
        }
        assertEq(n, successes, "all concurrent requests should succeed");

        if (m_options.verbose) {
            printf("concurrent requests: %d/%d succeeded\n", successes, n);
        }
    }

    testConcurrentConnections() {
        # Test multiple independent connections used sequentially.
        # Each manager gets its own QUIC connection; requests are fired
        # concurrently within each connection, then the next connection
        # is tested. This validates that multiple connections can be
        # established and used independently on the shared I/O controller.
        #
        # NOTE: concurrent I/O across multiple QUIC connections is a known
        # limitation — the I/O controller's single thread favors one
        # connection's UDP socket events over others. A future multi-thread
        # I/O controller will lift this restriction.
        int num_managers = 3;
        int requests_per_manager = 10;
        int total_successes = 0;

        for (int i = 0; i < num_managers; i++) {
            auto mgr = newManager(60s);
            on_exit mgr.closeAll();

            Counter done(requests_per_manager);
            list<hash<auto>> results();
            Mutex m();

            for (int j = 0; j < requests_per_manager; j++) {
                int mgr_idx = i;
                int req_idx = j;
                background sub() {
                    on_exit done.dec();
                    try {
                        hash<auto> resp = mgr.request(mH3Url, "GET", "/hello");
                        string body_str = resp.body.typeCode() == NT_BINARY
                            ? resp.body.toString("UTF-8") : resp.body;
                        {
                            AutoLock al(m);
                            push results, {
                                "mgr": mgr_idx,
                                "req": req_idx,
                                "status": resp.status_code,
                                "body": body_str,
                                "success": True,
                            };
                        }
                    } catch (hash<ExceptionInfo> ex) {
                        {
                            AutoLock al(m);
                            push results, {
                                "mgr": mgr_idx,
                                "req": req_idx,
                                "error": ex.err + ": " + ex.desc,
                                "success": False,
                            };
                        }
                    }
                }();
            }

            assertEq(0, done.waitForZero(60s),
                sprintf("mgr %d: all requests completed", i));
            assertEq(requests_per_manager, results.size(),
                sprintf("mgr %d: got results for all requests", i));

            foreach hash<auto> r in (results) {
                if (r.success) {
                    total_successes++;
                    assertEq(200, r.status,
                        sprintf("mgr %d req %d should return 200", r.mgr, r.req));
                    assertEq("Hello World", r.body,
                        sprintf("mgr %d req %d body should match", r.mgr, r.req));
                } else if (m_options.verbose) {
                    printf("concurrent connection mgr %d req %d failed: %s\n",
                        r.mgr, r.req, r.error);
                }
            }
        }

        int total = num_managers * requests_per_manager;
        assertEq(total, total_successes,
            "all concurrent connection requests should succeed");

        if (m_options.verbose) {
            printf("concurrent connections: %d/%d succeeded (%d managers)\n",
                total_successes, total, num_managers);
        }
    }

    testMixedConcurrentWorkload() {
        auto mgr = newManager(60s);
        on_exit mgr.closeAll();

        # Define mixed workload: different methods, paths, and body sizes
        list<hash<auto>> workload = ();
        for (int i = 0; i < 5; i++) {
            push workload, {"method": "GET", "path": "/hello", "expected_status": 200};
        }
        for (int i = 0; i < 5; i++) {
            push workload, {"method": "POST", "path": "/echo",
                "body": strmul("Z", 1024), "expected_status": 200,
                "headers": {"content-type": "text/plain"}};
        }
        for (int i = 0; i < 5; i++) {
            push workload, {"method": "GET", "path": "/large/50000", "expected_status": 200};
        }
        for (int i = 0; i < 5; i++) {
            push workload, {"method": "GET", "path": "/status/201", "expected_status": 201};
        }

        int n = workload.size();
        Counter done(n);
        list<hash<auto>> results();
        Mutex m();

        for (int i = 0; i < n; i++) {
            hash<auto> work = workload[i];
            int idx = i;
            background sub() {
                on_exit done.dec();
                try {
                    hash<auto> resp = mgr.request(mH3Url, work.method, work.path,
                        work.headers, work.body);
                    {
                        AutoLock al(m);
                        push results, {
                            "idx": idx,
                            "status": resp.status_code,
                            "expected": work.expected_status,
                            "success": True,
                        };
                    }
                } catch (hash<ExceptionInfo> ex) {
                    {
                        AutoLock al(m);
                        push results, {
                            "idx": idx,
                            "error": ex.err + ": " + ex.desc,
                            "success": False,
                        };
                    }
                }
            }();
        }

        assertEq(0, done.waitForZero(60s), "all mixed workload requests completed");
        assertEq(n, results.size(), "got results for all mixed requests");

        int successes = 0;
        foreach hash<auto> r in (results) {
            if (r.success) {
                successes++;
                assertEq(r.expected, r.status,
                    sprintf("mixed request %d should return %d", r.idx, r.expected));
            } else if (m_options.verbose) {
                printf("mixed request %d failed: %s\n", r.idx, r.error);
            }
        }
        assertEq(n, successes, "all mixed workload requests should succeed");

        if (m_options.verbose) {
            printf("mixed concurrent workload: %d/%d succeeded\n", successes, n);
        }
    }

    # ---- Group 3: Scalability ----

    testManySequentialRequests() {
        auto mgr = newManager();
        on_exit mgr.closeAll();

        # Determine count based on environment (valgrind vs normal)
        date probe_start = now_us();
        hash<auto> probe = mgr.request(mH3Url, "GET", "/hello");
        assertEq(200, probe.status_code, "probe request should succeed");
        date probe_elapsed = now_us() - probe_start;

        # If probe takes > 500ms, likely under valgrind; use fewer iterations
        int count = probe_elapsed > 500ms ? 10 : 100;

        int successes = 0;
        for (int i = 0; i < count; i++) {
            hash<auto> resp = mgr.request(mH3Url, "GET", "/hello");
            if (resp.status_code == 200) {
                successes++;
            }
        }

        assertEq(count, successes,
            sprintf("all %d sequential requests should succeed", count));

        # Verify connection reuse
        hash<auto> stats = mgr.getStats();
        string key = sprintf("127.0.0.1:%d", mH3Port);
        if (stats.per_host.hasKey(key)) {
            assertEq(1, stats.per_host{key}.connections,
                "should reuse single connection for all sequential requests");
        }

        if (m_options.verbose) {
            printf("many sequential requests: %d/%d succeeded\n", successes, count);
        }
    }

    testIncreasingBodySizes() {
        auto mgr = newManager();
        on_exit mgr.closeAll();

        list<int> sizes = (100, 1000, 10000, 50000, 100000, 500000);

        foreach int size in (sizes) {
            hash<auto> resp = mgr.request(mH3Url, "GET",
                sprintf("/large/%d", size));
            assertEq(200, resp.status_code,
                sprintf("large/%d should return 200", size));
            string body_str = resp.body.typeCode() == NT_BINARY
                ? resp.body.toString("UTF-8") : resp.body;
            assertEq(size, body_str.size(),
                sprintf("response for /large/%d should be %d bytes", size, size));
            # Verify content
            assertEq(strmul("X", size), body_str,
                sprintf("response for /large/%d content should match", size));

            if (m_options.verbose > 1) {
                printf("increasing body sizes: %d bytes OK\n", size);
            }
        }

        if (m_options.verbose) {
            printf("increasing body sizes: all %d sizes verified\n", sizes.size());
        }
    }

    # ---- Group 4: Reliability ----

    testRepeatedConnectDisconnect() {
        int cycles = 10;

        for (int i = 0; i < cycles; i++) {
            auto mgr = newManager();
            on_exit mgr.closeAll();
            hash<auto> resp = mgr.request(mH3Url, "GET", "/hello");
            assertEq(200, resp.status_code,
                sprintf("cycle %d should return 200", i));
            string body_str = resp.body.typeCode() == NT_BINARY
                ? resp.body.toString("UTF-8") : resp.body;
            assertEq("Hello World", body_str,
                sprintf("cycle %d body should match", i));
            mgr.closeAll();

            if (m_options.verbose > 1) {
                printf("connect/disconnect cycle %d: OK\n", i);
            }
        }

        if (m_options.verbose) {
            printf("repeated connect/disconnect: %d cycles OK\n", cycles);
        }
    }

    testBackToBackRequests() {
        auto mgr = newManager();
        on_exit mgr.closeAll();

        # Determine count based on environment
        date probe_start = now_us();
        hash<auto> probe = mgr.request(mH3Url, "GET", "/hello");
        assertEq(200, probe.status_code, "probe request should succeed");
        date probe_elapsed = now_us() - probe_start;

        int count = probe_elapsed > 500ms ? 10 : 50;

        int successes = 0;
        for (int i = 0; i < count; i++) {
            # Zero delay between requests
            hash<auto> resp = mgr.request(mH3Url, "GET", "/hello");
            if (resp.status_code == 200) {
                successes++;
            }
        }

        assertEq(count, successes,
            sprintf("all %d back-to-back requests should succeed", count));

        if (m_options.verbose) {
            printf("back-to-back requests: %d/%d succeeded\n", successes, count);
        }
    }
}
