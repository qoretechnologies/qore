#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/HttpServer.qm
%requires ../../../../qlib/Mime.qm
%exec-class HttpServerRequestEncodingTest

class RequestEncodingHandler inherits HttpServer::AbstractHttpRequestHandler {
    public {
        Queue requests();
    }
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        requests.push({"body": body, "context_encoding": cx.char_encoding, "content_type": hdr."_qore_orig_content_type",
            "body_encoding": body.typeCode() == NT_STRING ? get_encoding(cast<string>(body)) : NOTHING});
        return <HttpResponseInfo>{"code": 200, "body": "ok"};
    }
}

#! Returns a body in the charset and with the Content-Type given in the request's X-Enc and X-Ct headers
class ResponseCharsetHandler inherits HttpServer::AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        # a binary body is sent as-is, so the server adds no charset of its own
        return <HttpResponseInfo>{
            "code": 200,
            "body": binary(convert_encoding(ResponseValue, hdr."x-enc")),
            "hdr": {"Content-Type": hdr."x-ct"},
        };
    }
}

const ResponseValue = "é\r\n \t";

class HttpServerRequestEncodingTest inherits QUnit::Test {
    constructor() : Test("HttpServer request encoding", "1.0") {
        addTestCase("Buffered request strings retain the declared character encoding", \encoding());
        addTestCase("A request charset is parsed per RFC 9110", \requestCharsetSyntax());
        addTestCase("A response charset is parsed per RFC 9110", \responseCharsetSyntax());
        addTestCase("HTTP protocol fields do not inherit a previous body charset", \headers());
        addTestCase("Binary request bodies retain their original bytes", \binaryBodies());
        addTestCase("Multipart request bodies keep every part's bytes", \multipartBodies());
        set_return_value(main());
    }
    private encoding() {
        HttpServer server();
        on_exit server.stop();
        RequestEncodingHandler handler();
        server.setDefaultHandler("encoding", handler);
        int port = server.addListener(0).port;
        HTTPClient client({"url": sprintf("http://127.0.0.1:%d/", port), "timeout": 30000});
        string value = "é\r\n \t";
        foreach string encoding in ("UTF-8", "ISO-8859-1", "UTF-16LE", "UTF-16BE") {
            string encoded = convert_encoding(value, encoding);
            assertEq("ok", client.post("/", binary(encoded), {"Content-Type": "text/plain; charset=" + encoding}));
            hash<auto> received = handler.requests.pop(30000);
            assertEq(encoding, received.context_encoding, "header parser recognizes the advertised encoding");
            assertEq(encoding, received.body_encoding, "buffered bytes inherit the request encoding");
            assertEq(value, received.body);
        }
    }
    #! quoted-string values, whitespace, parameter-name case, and a ';' or "charset=" in another parameter
    /** The encoding name itself is asserted: glibc's iconv ignores the quotes of a quoted name, so a conversion
        alone would hide a mistagged string there, while musl fails it.
    */
    private requestCharsetSyntax() {
        HttpServer server();
        on_exit server.stop();
        RequestEncodingHandler handler();
        server.setDefaultHandler("encoding", handler);
        int port = server.addListener(0).port;
        HTTPClient client({"url": sprintf("http://127.0.0.1:%d/", port), "timeout": 30000});
        string value = "é\r\n \t";
        foreach hash<auto> i in (
                {"ct": 'text/xml;charset="UTF-8"', "enc": "UTF-8"},
                {"ct": 'text/xml; charset = "iso-8859-1"', "enc": "ISO-8859-1"},
                {"ct": 'text/xml; Charset="UTF-16LE"; action="urn:a;b"', "enc": "UTF-16LE"},
                {"ct": 'text/xml; action="charset=UTF-16LE"; charset=UTF-16BE', "enc": "UTF-16BE"},
            ) {
            assertEq("ok", client.post("/", binary(convert_encoding(value, i.enc)), {"Content-Type": i.ct}));
            hash<auto> received = handler.requests.pop(30000);
            # the client adds no second charset to a Content-Type that already declares one
            assertEq(i.ct, received.content_type, i.ct);
            assertEq(i.enc, received.context_encoding, i.ct);
            assertEq(i.enc, received.body_encoding, i.ct);
            assertEq(value, received.body, i.ct);
        }
    }

    #! the same syntax in a response, read by the synchronous and the poll client APIs
    private responseCharsetSyntax() {
        HttpServer server();
        on_exit server.stop();
        server.setDefaultHandler("charset", new ResponseCharsetHandler());
        int port = server.addListener(0).port;
        HTTPClient client({"url": sprintf("http://127.0.0.1:%d/", port), "timeout": 30000});
        foreach hash<auto> i in (
                {"ct": 'text/plain;charset="ISO-8859-1"', "enc": "ISO-8859-1", "bct": "text/plain"},
                {"ct": 'text/plain; Charset = "UTF-16LE"; x="a;b"', "enc": "UTF-16LE", "bct": "text/plain"},
                {"ct": 'text/plain; x="charset=UTF-8"; charset=UTF-16BE', "enc": "UTF-16BE", "bct": "text/plain"},
            ) {
            hash<auto> req_hdr = {"X-Enc": i.enc, "X-Ct": i.ct};

            hash<auto> info;
            string body = client.get("/", req_hdr, \info);
            assertEq(i.enc, body.encoding(), i.ct);
            assertEq(ResponseValue, body, i.ct);
            assertEq(i.enc, info.charset, i.ct);
            assertEq(i.bct, info."body-content-type", i.ct);

            AbstractPollOperation op = client.startPollSendRecv("GET", "/", NOTHING, req_hdr);
            while (*hash<SocketPollInfo> pi = op.continuePoll()) {
                Socket::poll((pi,), 30s);
            }
            hash<auto> out = op.getOutput();
            assertEq(i.enc, out."response-body".encoding(), i.ct + " (poll)");
            assertEq(ResponseValue, out."response-body", i.ct + " (poll)");
        }
    }

    private headers() {
        Socket listener();
        listener.bind("127.0.0.1:0");
        listener.listen();
        on_exit listener.close();
        Socket sender();
        sender.connect(sprintf("127.0.0.1:%d", listener.getSocketInfo().port), 5000);
        on_exit sender.close();
        Socket receiver = listener.accept(5000);
        on_exit receiver.close();
        foreach string encoding in ("UTF-8", "ISO-8859-1", "UTF-16LE", "UTF-16BE") {
            foreach bool response in (False, True) {
                receiver.setEncoding(encoding);
                sender.send(binary((response ? "HTTP/1.1 200 OK" : "POST /records HTTP/1.1")
                    + "\r\nContent-Type: text/plain; charset=UTF-16LE\r\nContent-Length: 0\r\n\r\n"), 5000);
                hash<auto> info;
                hash<auto> headers = receiver.readHTTPHeader(5000, \info);
                assertEq("1.1", headers.http_version);
                assertEq("UTF-8", get_encoding(headers.http_version));
                assertEq("UTF-16LE", receiver.getEncoding());
                if (response) {
                    assertEq(200, headers.status_code);
                } else {
                    assertEq("/records", headers.path);
                    assertEq("UTF-8", get_encoding(headers.path));
                    assertFalse(info.close, "HTTP/1.1 remains persistent after a wide-encoded body");
                }
            }
        }
        receiver.setEncoding("UTF-16BE");
        sender.send(binary("invalid\r\n\r\n"), 5000);
        assertThrows("SOCKET-HTTP-ERROR", \receiver.readHTTPHeader(), (5000,));
        sender.send(binary("GET /recovered HTTP/1.1\r\nContent-Length: 0\r\n\r\n"), 5000);
        assertEq("/recovered", receiver.readHTTPHeader(5000).path);
    }

    #! A multipart body is a container of parts, each carrying its own encoding.
    /** The request's charset does not describe the container's octets, so labeling them with it makes
        the first conversion of the message transcode binary parts: a 0xff byte read as Latin-1 becomes
        0xc3 0xbf in UTF-8, and the file a client uploaded arrives one byte longer than it was sent.
        The container is therefore handed to the handler as bytes, like any other binary content type.
    */
    private multipartBodies() {
        HttpServer server();
        on_exit server.stop();
        RequestEncodingHandler handler();
        server.setDefaultHandler("encoding", handler);
        int port = server.addListener(0).port;
        HTTPClient client({"url": sprintf("http://127.0.0.1:%d/", port), "timeout": 30000});

        binary file = <00017fff52494646>;
        MultiPartFormDataMessage msg();
        msg.addPart(file, "file", "invoice.wav", "audio/wav");
        msg.addPart("en", "language");
        hash<MessageInfo> mi = msg.getMsgAndHeaders();

        assertEq("ok", client.send(mi.body, "POST", "/", mi.hdr).body.toString());
        hash<auto> received = handler.requests.pop(30000);
        assertEq(NOTHING, received.body_encoding, "the container is not labeled with the request charset");

        hash<string, hash<FormDataMessageInfo>> parts =
            MultiPartFormDataMessage::parseMessage(mi.hdr."Content-Type", received.body.toString());
        assertEq(file, parts.file.body, "a binary part arrives byte for byte");
        assertEq("invoice.wav", parts.file.filename);
        assertEq("en", parts.language.body, "a text part beside it still decodes");
    }

    private binaryBodies() {
        HttpServer server();
        on_exit server.stop();
        RequestEncodingHandler handler();
        server.setDefaultHandler("encoding", handler);
        int port = server.addListener(0).port;
        HTTPClient client({"url": sprintf("http://127.0.0.1:%d/", port), "timeout": 30000});
        foreach binary value in (<00ff0d0a>, <3c0078003e00>, <003c0078003e>) {
            assertEq("ok", client.post("/", value, {"Content-Type": "application/octet-stream"}));
            hash<auto> received = handler.requests.pop(30000);
            assertEq(value, received.body);
            assertEq(NOTHING, received.body_encoding);
        }
    }

}
