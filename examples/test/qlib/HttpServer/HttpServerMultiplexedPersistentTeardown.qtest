#! Handler that opts into a (connection-scoped) persistent session on /persist.
/** Simulates a handler that pins a thread-local resource (e.g. an open DB
    transaction): it acquires a "resource" and calls setPersistent(True) on the
    /persist request.  On a multiplexed transport (HTTP/2, HTTP/3) the framework
    must NOT park a dedicated thread for such a session — it must release the
    handler immediately after the response and tear down its context, firing
    persistentClosed() exactly once so the resource cannot leak.  The handler
    records every acquire/release through a shared, mutex-guarded counter and a
    Queue so the test can assert teardown deterministically and verify no leak.
*/
class PersistentResourceHandler inherits AbstractHttpRequestHandler {
    public {
        #! signalled (one "closed" entry) every time persistentClosed() fires
        Queue teardown();
    }

    private {
        Mutex lck();
        #! number of currently-held resources (must return to 0 — no leak)
        int held = 0;
        #! total resources ever acquired (sanity)
        int acquired = 0;
    }

    #! number of resources currently held (0 == nothing leaked)
    int currentlyHeld() {
        AutoLock al(lck);
        return held;
    }

    #! total resources acquired over the test
    int totalAcquired() {
        AutoLock al(lck);
        return acquired;
    }

    #! the framework teardown hook — release the thread-local resource here
    nothing persistentClosed() {
        AbstractHttpRequestHandler::persistentClosed();
        {
            AutoLock al(lck);
            --held;
        }
        teardown.push("closed");
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        hash<auto> rhdr = {"Content-Type": MimeTypeText};
        if (hdr.path =~ /persist/) {
            # acquire a thread-pinned resource and pin the thread to the session
            {
                AutoLock al(lck);
                ++held;
                ++acquired;
            }
            setPersistent(True);
            return AbstractHttpRequestHandler::makeResponse(rhdr, 200, "persistent");
        }
        return AbstractHttpRequestHandler::makeResponse(rhdr, 200, "ok");
    }
}

class HttpServerMultiplexedPersistentTeardownTest inherits QUnit::Test {
    private {
        HttpServer m_http;
        PersistentResourceHandler m_handler;
        int m_quic_port;
        bool m_quic_available = False;
        int m_tls_port;
        bool m_tls_available = False;
    }

    constructor() : Test("HttpServerMultiplexedPersistentTeardownTest", "1.0") {
        Logger logger("test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }

        m_http = new HttpServer(<HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        });
        m_http.waitForAsyncIo();

        m_handler = new PersistentResourceHandler();
        m_http.setHandler("persistent", "/", MimeTypeText, m_handler);
        m_http.setDefaultHandler("persistent", m_handler);

        # HTTP/3 (QUIC) listener
        try {
            hash<auto> quic_info = m_http.addQuicListener(<HttpListenerOptionInfo>{
                "cert": new SSLCertificate(CertPem),
                "key": new SSLPrivateKey(KeyPem),
            });
            m_quic_port = quic_info.port;
            m_quic_available = True;
        } catch (hash<ExceptionInfo> ex) {
            printf("QUIC listener failed: %s: %s\n", ex.err, ex.desc);
        }

        # HTTP/2 (TLS+ALPN) listener
        try {
            hash<auto> tls_info = m_http.addListener(<HttpListenerOptionInfo>{
                "service": "0",
                "node": "127.0.0.1",
                "family": AF_INET,
                "cert": new SSLCertificate(CertPem),
                "key": new SSLPrivateKey(KeyPem),
            });
            m_tls_port = tls_info.port;
            m_tls_available = True;
        } catch (hash<ExceptionInfo> ex) {
            printf("TLS listener failed: %s: %s\n", ex.err, ex.desc);
        }

        if (m_quic_available) {
            addTestCase("H3 persistent session not parked", \testH3NotParked());
            addTestCase("H3 sessions repeat without leak", \testH3RepeatsNoLeak());
            addTestCase("H3 server destroy is clean", \testH3ServerStop());
        } else {
            printf("SKIP: QUIC not available\n");
        }
        if (m_tls_available) {
            addTestCase("H2 persistent session not parked", \testH2NotParked());
            addTestCase("H2 sessions repeat without leak", \testH2RepeatsNoLeak());
            addTestCase("H2 server destroy is clean", \testH2ServerStop());
        }

        set_return_value(main());

        delete m_http;
    }

    private RestClientIo getClient(string http_version, int port, timeout request_timeout = 5s) {
        return new RestClientIo({
            "url": sprintf("https://127.0.0.1:%d", port),
            "data": "text",
            "accept_all_certs": True,
            "http_version": http_version,
            "timeout": request_timeout,
            "connect_timeout": 5s,
        });
    }

    #! Drain any teardown signals left over from a previous test case
    private drainTeardown() {
        while (!m_handler.teardown.empty()) {
            m_handler.teardown.get();
        }
    }

    #! A multiplexed handler that opts into persistence is torn down promptly and
    #! exactly once WITHOUT any stream reset, idle TTL, or connection close — the
    #! core anti-leak guarantee.  On the connection-scoped (H1) model this would
    #! stay parked until one of those events; here the resource is released
    #! immediately after the response.
    private doNotParked(string http_version, int port) {
        drainTeardown();
        int held_before = m_handler.currentlyHeld();

        RestClientIo rc = getClient(http_version, port);
        on_exit delete rc;

        hash<auto> resp = rc.restGet("/persist");
        assertEq(200, resp.status_code, "persistent session response received");

        # teardown must fire deterministically (no parked thread waiting for a
        # reset / TTL / connection close) — a blocking wait on the signal, not a
        # poll.  If the old connection-scoped parking were still in effect this
        # get() would block until the 30s timeout.
        auto sig = m_handler.teardown.get(30s);
        assertEq("closed", sig, "multiplexed persistent session torn down without a stream reset");
        # the thread-local resource is released — net zero held
        assertEq(held_before, m_handler.currentlyHeld(),
            "thread-pinned resource released on teardown (no leak)");
        # and the connection is still usable for ordinary requests
        assertEq(200, rc.restGet("/normal").status_code,
            "connection still usable after session teardown");
    }

    #! Many persistent sessions over reused connections each tear down; no
    #! resource leaks and the listener stays healthy.
    private doRepeatsNoLeak(string http_version, int port) {
        drainTeardown();
        int held_before = m_handler.currentlyHeld();
        int acquired_before = m_handler.totalAcquired();

        # one client, reused connection (pooled/multiplexed): the H1 leak scenario
        RestClientIo rc = getClient(http_version, port);
        on_exit delete rc;

        int N = 5;
        for (int i = 0; i < N; ++i) {
            assertEq(200, rc.restGet("/persist").status_code,
                sprintf("session %d established", i));
            assertEq("closed", m_handler.teardown.get(30s),
                sprintf("session %d torn down", i));
        }

        assertEq(acquired_before + N, m_handler.totalAcquired(),
            "every session acquired its resource");
        assertEq(held_before, m_handler.currentlyHeld(),
            "no resource leaked across repeated sessions on a reused connection");

        # listener is healthy: a normal request completes promptly
        date start = now_us();
        assertEq(200, rc.restGet("/normal").status_code, "server healthy after repeated sessions");
        assertTrue(now_us() - start < 5s, "normal request completed promptly");
    }

    #! Destroying the server is clean whether or not a session was just active —
    #! no crash, and any session in flight has already been torn down (no parked
    #! thread pinned by a live close-delivery binding).  Regression guard for the
    #! poll-operation abort() path.
    private doServerStop(string http_version, string proto) {
        Logger logger("test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }
        HttpServer http(<HttpServerOptionInfo>{"logger": logger, "debug": True});
        http.waitForAsyncIo();
        PersistentResourceHandler handler();
        http.setHandler("persistent", "/", MimeTypeText, handler);
        http.setDefaultHandler("persistent", handler);
        int port;
        if (proto == "h3") {
            port = http.addQuicListener(<HttpListenerOptionInfo>{
                "cert": new SSLCertificate(CertPem),
                "key": new SSLPrivateKey(KeyPem),
            }).port;
        } else {
            port = http.addListener(<HttpListenerOptionInfo>{
                "service": "0",
                "node": "127.0.0.1",
                "family": AF_INET,
                "cert": new SSLCertificate(CertPem),
                "key": new SSLPrivateKey(KeyPem),
            }).port;
        }

        RestClientIo rc = getClient(http_version, port);
        on_exit delete rc;

        assertEq(200, rc.restGet("/persist").status_code, "session established before server destroy");
        # teardown already happened (not parked); resource released
        assertEq("closed", handler.teardown.get(30s), "session torn down before server destroy");
        assertEq(0, handler.currentlyHeld(), "no resource held at server destroy");

        # destroy the server with the (now idle) multiplexed connection still open
        delete http;
        # no crash == pass; one explicit assertion so the case is not an identity test
        assertEq(0, handler.currentlyHeld(), "server destroyed cleanly with no leaked resource");
    }

    testH2NotParked() {
        doNotParked("2.0", m_tls_port);
    }

    testH2RepeatsNoLeak() {
        doRepeatsNoLeak("2.0", m_tls_port);
    }

    testH2ServerStop() {
        doServerStop("2.0", "h2");
    }

    testH3NotParked() {
        doNotParked("auto", m_quic_port);
    }

    testH3RepeatsNoLeak() {
        doRepeatsNoLeak("auto", m_quic_port);
    }

    testH3ServerStop() {
        doServerStop("auto", "h3");
    }
}
