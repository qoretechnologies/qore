#! Persistent handler that pins its dedicated thread for the connection lifetime.
/** Mirrors the multiplexed persistent contract used by thread-pinned resources
    (e.g. an open DB transaction): keepPersistentConnectionDedicated() keeps the
    dedicated thread bound across requests, and a queue filter routes only the
    "/persist" path to it so an abandoned request on another path goes to the
    pool (leaving the dedicated thread genuinely parked).  persistentClosed() —
    the server's teardown hook — pushes to a Queue so the test can wait
    deterministically for teardown.
*/
class KeepDedicatedHandler inherits AbstractHttpRequestHandler {
    public {
        Queue teardown();
    }

    bool keepPersistentConnectionDedicated() {
        return True;
    }

    *code<bool(hash<auto>)> getPersistentQueueFilter() {
        # only the persistent path is routed to the dedicated thread, so an
        # abandoned request on "/slow" is handled by the pool and the dedicated
        # thread stays parked in its queue
        return bool sub (hash<auto> hdr) {
            return hdr.path =~ /persist/;
        };
    }

    nothing persistentClosed() {
        AbstractHttpRequestHandler::persistentClosed();
        teardown.push("closed");
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        hash<auto> rhdr = {"Content-Type": MimeTypeText};
        if (hdr.path =~ /persist/) {
            setPersistent(True);
            return AbstractHttpRequestHandler::makeResponse(rhdr, 200, "persistent");
        }
        if (hdr.path =~ /slow/) {
            # never respond within the client timeout window; the client aborts
            # the stream, which the server must turn into a persistent-session
            # teardown.  Bounded so the server can still shut down.
            sleep(8);
            return AbstractHttpRequestHandler::makeResponse(rhdr, 200, "slow");
        }
        return AbstractHttpRequestHandler::makeResponse(rhdr, 200, "ok");
    }
}

class HttpServerMultiplexedPersistentTeardownTest inherits QUnit::Test {
    private {
        HttpServer m_http;
        KeepDedicatedHandler m_handler;
        int m_quic_port;
        bool m_quic_available = False;
        int m_tls_port;
        bool m_tls_available = False;
    }

    constructor() : Test("HttpServerMultiplexedPersistentTeardownTest", "1.0") {
        Logger logger("test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }

        m_http = new HttpServer(<HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        });
        m_http.waitForAsyncIo();

        m_handler = new KeepDedicatedHandler();
        m_http.setHandler("persistent", "/", MimeTypeText, m_handler);
        m_http.setDefaultHandler("persistent", m_handler);

        # HTTP/3 (QUIC) listener
        try {
            hash<auto> quic_info = m_http.addQuicListener(<HttpListenerOptionInfo>{
                "cert": new SSLCertificate(CertPem),
                "key": new SSLPrivateKey(KeyPem),
            });
            m_quic_port = quic_info.port;
            m_quic_available = True;
        } catch (hash<ExceptionInfo> ex) {
            printf("QUIC listener failed: %s: %s\n", ex.err, ex.desc);
        }

        # HTTP/2 (TLS+ALPN) listener
        try {
            hash<auto> tls_info = m_http.addListener(<HttpListenerOptionInfo>{
                "service": "0",
                "node": "127.0.0.1",
                "family": AF_INET,
                "cert": new SSLCertificate(CertPem),
                "key": new SSLPrivateKey(KeyPem),
            });
            m_tls_port = tls_info.port;
            m_tls_available = True;
        } catch (hash<ExceptionInfo> ex) {
            printf("TLS listener failed: %s: %s\n", ex.err, ex.desc);
        }

        if (m_quic_available) {
            addTestCase("H3 persistent teardown on stream reset", \testH3TeardownOnStreamReset());
            addTestCase("H3 persistent teardown repeats and recovers", \testH3TeardownRepeatsAndRecovers());
        } else {
            printf("SKIP: QUIC not available\n");
        }
        if (m_tls_available) {
            addTestCase("H2 persistent teardown on stream reset", \testH2TeardownOnStreamReset());
            addTestCase("H2 persistent teardown repeats and recovers", \testH2TeardownRepeatsAndRecovers());
        }

        set_return_value(main());

        delete m_http;
    }

    private RestClientIo getClient(string http_version, int port, timeout request_timeout = 3s) {
        return new RestClientIo({
            "url": sprintf("https://127.0.0.1:%d", port),
            "data": "text",
            "accept_all_certs": True,
            "http_version": http_version,
            "timeout": request_timeout,
            "connect_timeout": 5s,
        });
    }

    #! Drain any teardown signals left over from a previous test case
    private drainTeardown() {
        while (!m_handler.teardown.empty()) {
            m_handler.teardown.get();
        }
    }

    #! Open a persistent session on a fresh multiplexed client, then abandon a
    #! request on the same connection so the client resets the stream; returns
    #! the client.
    /** The parked dedicated thread holds the persistent session; the abandoned
        "/slow" request (routed to the pool, not the dedicated thread) is reset by
        the client on timeout while the multiplexed connection stays open.
    */
    private RestClientIo openAndAbandonPersistentSession(string http_version, int port) {
        RestClientIo rc = getClient(http_version, port);

        hash<auto> resp = rc.restGet("/persist");
        assertEq(200, resp.status_code, "persistent session established");

        bool aborted = False;
        try {
            rc.restGet("/slow");
        } catch (hash<ExceptionInfo> ex) {
            aborted = True;
            if (m_options.verbose > 1) {
                printf("  abandon error (expected): %s: %s\n", ex.err, ex.desc);
            }
        }
        assertTrue(aborted, "slow request on persistent connection was aborted by the client");
        return rc;
    }

    #! A peer stream reset (timed-out request) on a still-open multiplexed
    #! connection tears down the parked persistent session.
    private doTeardownOnStreamReset(string http_version, int port) {
        drainTeardown();

        RestClientIo rc = openAndAbandonPersistentSession(http_version, port);
        on_exit delete rc;

        # the server must tear down the parked persistent session in response to
        # the abandon — deterministic wait on the teardown signal, not a poll.
        auto sig = m_handler.teardown.get(30s);
        assertEq("closed", sig, "parked persistent session torn down after client abandon");
    }

    #! The teardown rail fires for every abandoned session and the listener stays
    #! healthy afterwards (no wedge, no leaked dedicated thread blocking new work).
    private doTeardownRepeatsAndRecovers(string http_version, int port) {
        drainTeardown();

        # two independent persistent sessions, each abandoned, each must tear down
        RestClientIo rc1 = openAndAbandonPersistentSession(http_version, port);
        on_exit delete rc1;
        assertEq("closed", m_handler.teardown.get(30s), "first session torn down");

        RestClientIo rc2 = openAndAbandonPersistentSession(http_version, port);
        on_exit delete rc2;
        assertEq("closed", m_handler.teardown.get(30s), "second session torn down");

        # the server is still healthy: a normal request on a fresh connection
        # completes promptly (the teardowns did not wedge the listener)
        RestClientIo rc3 = getClient(http_version, port, 5s);
        on_exit delete rc3;
        date start = now_us();
        hash<auto> resp = rc3.restGet("/normal");
        assertEq(200, resp.status_code, "server healthy after persistent teardowns");
        assertTrue(now_us() - start < 5s, "normal request completed promptly after teardowns");
    }

    testH3TeardownOnStreamReset() {
        doTeardownOnStreamReset("auto", m_quic_port);
    }

    testH3TeardownRepeatsAndRecovers() {
        doTeardownRepeatsAndRecovers("auto", m_quic_port);
    }

    testH2TeardownOnStreamReset() {
        doTeardownOnStreamReset("2.0", m_tls_port);
    }

    testH2TeardownRepeatsAndRecovers() {
        doTeardownRepeatsAndRecovers("2.0", m_tls_port);
    }
}
