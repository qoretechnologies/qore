# Verifies that a persistent dedicated-thread handler session bound to a
# multiplexed connection (HTTP/2 and HTTP/3 / QUIC) is torn down deterministically
# when the client abandons the exchange via a peer stream reset (a timed-out
# request: RST_STREAM on H2, STOP_SENDING/RESET_STREAM on H3) — even though
# disconnect() does not close a multiplexed connection.  Without the libqore
# lifecycle-delivery rail (issue #5339) the parked dedicated thread would only be
# released on full connection/listener close, leaking any thread-pinned resource
# it holds.

%modern

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/HttpServerUtil.qm
%requires ../../../../qlib/HttpServer.qm
%requires ../../../../qlib/RestClient.qm
%requires ../../../../qlib/RestClientIo.qm
%requires ../../../../qlib/HttpClientIo
%requires ../../../../qlib/Mime.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/QUnit.qm

%exec-class HttpServerMultiplexedPersistentTeardownTest

