-----END PRIVATE KEY-----";
    }

    private {
        AfterSendRecorder recorder();
        AfterSendHandler handler(recorder);
        AfterSendErrorCapture capture();
        HttpServer server;
        int port;
        int ssl_port;
        int h3_port;
        int id_seq = 0;
        #! results received while waiting for the result of another request: id -> result
        hash<string, hash<AfterSendResult>> received;
    }

    constructor() : Test("HttpServerAfterSendTest", "1.0") {
        addTestCase("HTTP/1.1 keep-alive", \h1KeepAliveTest());
        addTestCase("HTTP/1.1 connection close", \h1CloseTest());
        addTestCase("HTTP/1.0", \h10Test());
        addTestCase("HTTP/1.1 client has the response when the callback runs", \h1OrderTest());
        addTestCase("HTTP/1.1 client gone", \h1ClientGoneTest());
        addTestCase("callback exception", \callbackExceptionTest());
        addTestCase("responses that are not sent as given", \notSentTest());
        addTestCase("an invalid handler response is answered with one error response", \invalidResponseOnceTest());
        addTestCase("HTTP/1.1 persistent session", \h1PersistentTest());
        addTestCase("inline handler", \inlineTest());
        addTestCase("HTTP/2", \h2Test());
        addTestCase("HTTP/2 persistent session", \h2PersistentTest());
        addTestCase("HTTP/2 client gone", \h2ClientGoneTest());
        addTestCase("HTTP/3", \h3Test());
        addTestCase("HTTP/3 client gone", \h3ClientGoneTest());
        addTestCase("HTTP/2 connection closed before the response", \h2ConnectionClosedTest());
        addTestCase("HTTP/3 connection closed before the response", \h3ConnectionClosedTest());
        set_return_value(main());
    }

    globalSetUp() {
        Logger logger("after-send-test", LoggerLevel::getLevelInfo());
        logger.addAppender(capture);
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }
        server = new HttpServer(<HttpServerOptionInfo>{
            "logger": logger,
        });
        server.setHandler("after-send", "/as/", NOTHING, handler);
        server.setHandler("persistent", "/persist", NOTHING, new PersistentAfterSendHandler(recorder), NOTHING,
            False);
        server.setHandler("inline", "/inline", NOTHING, new InlineAfterSendHandler(recorder));
        port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        ssl_port = server.addListener(<HttpListenerOptionInfo>{
            "node": "127.0.0.1",
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        }).port;
        h3_port = server.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
            "enable_h3": True,
        }).port;
        server.waitForAsyncIo();
    }

    globalTearDown() {
        delete server;
    }

    tearDown() {
        # a callback is called exactly once: no result is left over after a test consumed the results it expected
        assertEq(0, recorder.results.size(), "no unexpected after_send callback calls");
        assertEq({}, received, "no unexpected after_send callback calls");
        received = {};
    }

    #! returns a new unique request ID
    private string getId(string name) {
        return sprintf("%s-%d", name, ++id_seq);
    }

    #! returns the after_send result for the given request
    /** Results for other requests are kept; a second result for a request is an error
    */
    private hash<AfterSendResult> getResult(string id) {
        while (!received{id}) {
            hash<AfterSendResult> rv = recorder.results.get(30s);
            if (received{rv.id}) {
                fail(sprintf("second after_send result for request %y: %y", rv.id, rv));
            }
            received{rv.id} = rv;
        }
        return remove received{id};
    }

    #! asserts that the response to the given request was reported as sent
    private assertSent(string id, string tld = "handler") {
        hash<AfterSendResult> rv = getResult(id);
        assertTrue(rv.sent, id + ": sent");
        assertEq(tld, rv.tld, id + ": the callback runs under the handler's thread-local data");
    }

    #! asserts that the response to the given request was reported as not sent
    private assertNotSent(string id) {
        hash<AfterSendResult> rv = getResult(id);
        assertFalse(rv.sent, id + ": not sent");
        assertEq("handler", rv.tld, id + ": the callback runs under the handler's thread-local data");
    }

    #! checks a response of the given case
    private checkResponse(string name, hash<auto> resp) {
        if (name == "error") {
            assertEq(404, resp.status_code, name);
        } else if (name == "empty") {
            assertEq(202, resp.status_code, name);
        } else {
            assertEq(200, resp.status_code, name);
        }
        if (name == "large") {
            assertEq(AfterSendHandler::LargeSize, resp.body.size(), name);
        } else if (exists Cases{name}) {
            assertEq(Cases{name}, resp.body.typeCode() == NT_BINARY ? resp.body.toString() : resp.body, name);
        }
    }

    #! returns a client for the plain listener
    private HTTPClient getH1Client(*string version) {
        HTTPClient hc({
            "url": "http://127.0.0.1:" + port,
            "http_version": version ?? "1.1",
            "timeout": 30s,
        });
        hc.setHttp2Mode("disabled");
        return hc;
    }

    #! returns a client for the TLS listener that requires HTTP/2
    private HTTPClient getH2Client(timeout timeout = 30s) {
        HTTPClient hc({
            "url": "https://127.0.0.1:" + ssl_port,
            "ssl_verify_cert": False,
            "http_version": "2.0",
            "timeout": timeout,
        });
        hc.setHttp2Mode("required");
        return hc;
    }

    #! sends a request with an ID; returns the response, also for an error status code
    private hash<auto> send(HTTPClient hc, string path, string id, *hash<auto> hdr) {
        try {
            return hc.send(NOTHING, "GET", path, hdr + {"x-id": id});
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "HTTP-CLIENT-RECEIVE-ERROR" && ex.arg.status_code) {
                return ex.arg;
            }
            rethrow;
        }
    }

    h1KeepAliveTest() {
        HTTPClient hc = getH1Client();
        foreach string name in (keys Cases) {
            string id = getId(name);
            hash<auto> resp = send(hc, "/as/" + name, id);
            checkResponse(name, resp);
            assertSent(id);
        }
    }

    h1CloseTest() {
        foreach string name in (keys Cases + ("close",)) {
            HTTPClient hc = getH1Client();
            string id = getId(name);
            hash<auto> resp = send(hc, "/as/" + name, id, {"Connection": "close"});
            if (name == "close") {
                assertEq(200, resp.status_code, name);
                assertEq(AfterSendHandler::Body, resp.body, name);
            } else {
                checkResponse(name, resp);
            }
            assertSent(id);
        }
    }

    h10Test() {
        # a streamed message body of unknown length is delimited by closing the connection
        foreach string name in (keys Cases) {
            HTTPClient hc = getH1Client("1.0");
            string id = getId(name);
            hash<auto> resp = send(hc, "/as/" + name, id);
            checkResponse(name, resp);
            assertSent(id);
        }
    }

    h1OrderTest() {
        Socket client();
        client.connect("127.0.0.1:" + port, 30s);
        on_exit client.close();
        # the callback reads the complete response from the client socket without waiting: it has been written
        handler.setOrderProbe(auto sub () {
            hash<auto> hdr = client.readHTTPHeader(0);
            return {
                "status_code": hdr.status_code,
                "body": client.recv(hdr."content-length".toInt(), 0),
            };
        });
        on_exit handler.setOrderProbe();
        string id = getId("order");
        client.send(sprintf("GET /as/order HTTP/1.1\r\nHost: 127.0.0.1\r\nx-id: %s\r\n\r\n", id));
        hash<AfterSendResult> rv = getResult(id);
        assertTrue(rv.sent);
        assertEq({"status_code": 200, "body": AfterSendHandler::Body}, rv.probe,
            "the client has the complete response when the callback runs");
    }

    h1ClientGoneTest() {
        string id = getId("wait");
        {
            Socket client();
            client.connect("127.0.0.1:" + port, 30s);
            client.send(sprintf("GET /as/wait HTTP/1.1\r\nHost: 127.0.0.1\r\nx-id: %s\r\n\r\n", id));
            handler.waitEntered();
            client.close();
        }
        handler.releaseWait();
        assertNotSent(id);
    }

    callbackExceptionTest() {
        HTTPClient hc = getH1Client();
        string id = getId("raise");
        hash<auto> resp = send(hc, "/as/raise", id);
        assertEq(200, resp.status_code);
        assertSent(id);
        string msg = capture.messages.get(30s);
        assertRegex("AFTER-SEND-TEST-ERROR", msg, "the callback's exception is logged");
        # the connection is not affected
        id = getId("small");
        resp = send(hc, "/as/small", id);
        assertEq(AfterSendHandler::Body, resp.body);
        assertSent(id);
    }

    notSentTest() {
        # the response is replaced by an error response
        foreach string name in ("invalid", "sse") {
            HTTPClient hc = getH1Client();
            string id = getId(name);
            hash<auto> resp = send(hc, "/as/" + name, id);
            assertEq(500, resp.status_code, name);
            assertNotSent(id);
        }
        # the handler sent the response itself on the HTTP/1.1 connection
        {
            HTTPClient hc = getH1Client();
            string id = getId("reply-sent");
            hash<auto> resp = send(hc, "/as/reply-sent", id);
            assertEq("self-reply", resp.body);
            assertSent(id);
        }
    }

    invalidResponseOnceTest() {
        Socket client();
        client.connect("127.0.0.1:" + port, 30s);
        on_exit client.close();
        string id = getId("invalid");
        client.send(sprintf("GET /as/invalid HTTP/1.1\r\nHost: 127.0.0.1\r\nx-id: %s\r\n\r\n", id));
        hash<auto> hdr = client.readHTTPHeader(30s);
        assertEq(500, hdr.status_code);
        assertEq("close", hdr.connection);
        client.recvBinary(hdr."content-length".toInt(), 30s);
        # the server closes the connection after the error response, which is the only response
        binary rest = binary();
        while (True) {
            binary b;
            try {
                b = client.recvBinary(-1, 30s);
            } catch (hash<ExceptionInfo> ex) {
                # the connection was closed
                break;
            }
            if (!b) {
                break;
            }
            rest += b;
        }
        assertEq(binary(), rest, "no data follows the error response");
        assertNotSent(id);
    }

    h1PersistentTest() {
        HTTPClient hc = getH1Client();
        # the first response is sent before the session loop, the following ones by the session's thread
        foreach string path in ("/persist/start", "/persist/next", "/persist/next") {
            string id = getId("persist");
            hash<auto> resp = send(hc, path, id);
            assertEq("persistent", resp.body, path);
            assertSent(id, "persistent");
        }
        string id = getId("persist");
        hash<auto> resp = send(hc, "/persist/end", id);
        assertEq(200, resp.status_code);
    }

    inlineTest() {
        HTTPClient hc = getH1Client();
        foreach int i in (xrange(2)) {
            string id = getId("inline");
            hash<auto> resp = send(hc, "/inline", id);
            assertEq("inline", resp.body);
            assertSent(id, "inline");
        }
    }

    h2Test() {
        HTTPClient hc = getH2Client();
        foreach string name in (keys Cases) {
            string id = getId(name);
            hash<auto> resp = send(hc, "/as/" + name, id);
            assertEq("2", resp.http_version, name + ": served on HTTP/2");
            checkResponse(name, resp);
            assertSent(id);
        }
    }

    h2PersistentTest() {
        # a persistent session on a multiplexed connection only lasts for the request
        HTTPClient hc = getH2Client();
        string id = getId("persist");
        hash<auto> resp = send(hc, "/persist/start", id);
        assertEq("2", resp.http_version);
        assertEq(200, resp.status_code);
        assertSent(id, "persistent");
    }

    h2ClientGoneTest() {
        string id = getId("wait");
        {
            HTTPClient hc = getH2Client(2s);
            # the client gives up waiting for the response and closes the connection
            try {
                send(hc, "/as/wait", id);
                fail("the request does not time out");
            } catch (hash<ExceptionInfo> ex) {
                # the request timed out
            }
            handler.waitEntered();
            hc.disconnect();
        }
        handler.releaseWait();
        assertNotSent(id);
    }

    #! returns a client for the HTTP/3 listener
    private HttpClientIo::HttpClientConnectionManager getH3Client(timeout timeout = 30s) {
        return new HttpClientIo::HttpClientConnectionManager(<HttpClientIo::HttpClientConnectionManagerOptions>{
            "protocol": "h3",
            "accept_all_certs": True,
            "request_timeout": timeout,
            "connect_timeout": 15s,
        });
    }

    h3Test() {
        HttpClientIo::HttpClientConnectionManager mgr = getH3Client();
        on_exit delete mgr;
        string url = "https://127.0.0.1:" + h3_port;
        foreach string name in (keys Cases) {
            string id = getId(name);
            hash<auto> resp = mgr.request(url, "GET", "/as/" + name, {"x-id": id});
            checkResponse(name, resp);
            assertSent(id);
        }
    }

    #! the client closes its connection while the handler runs, without resetting the request's stream
    /** The response's transmission is watched only after the connection has been closed.
    */
    private connectionClosedTest(string protocol, int port) {
        string id = getId("wait");
        HttpClientIo::HttpClientConnectionManager mgr(<HttpClientIo::HttpClientConnectionManagerOptions>{
            "protocol": protocol,
            "accept_all_certs": True,
            "request_timeout": 60s,
            "connect_timeout": 15s,
        });
        Counter done(1);
        background sub () {
            on_exit done.dec();
            try {
                mgr.request("https://127.0.0.1:" + port, "GET", "/as/wait", {"x-id": id});
            } catch (hash<ExceptionInfo> ex) {
                # the connection manager is deleted while the request is in progress
            }
        }();
        handler.waitEntered();
        delete mgr;
        done.waitForZero(30s);
        handler.releaseWait();
        assertNotSent(id);
    }

    h2ConnectionClosedTest() {
        connectionClosedTest("h2", ssl_port);
    }

    h3ConnectionClosedTest() {
        connectionClosedTest("h3", h3_port);
    }

    h3ClientGoneTest() {
        string id = getId("wait");
        {
            HttpClientIo::HttpClientConnectionManager mgr = getH3Client(2s);
            on_exit delete mgr;
            # the client gives up waiting for the response and closes the connection
            try {
                mgr.request("https://127.0.0.1:" + h3_port, "GET", "/as/wait", {"x-id": id});
                fail("the request does not time out");
            } catch (hash<ExceptionInfo> ex) {
                # the request timed out
            }
            handler.waitEntered();
        }
        handler.releaseWait();
        assertNotSent(id);
    }
}
