#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
#
# Verifies HttpResponseInfo::after_send: the callback is called exactly once, after the response has been
# completely sent (or with sent = False if it could not be sent), under the handler's thread-local data, for
# HTTP/1.x (keep-alive, close, HTTP/1.0, persistent sessions, inline handlers), HTTP/2 and HTTP/3, and for every
# form of message body.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Logger
%requires HttpServerUtil
%requires HttpServerAsyncIo
%requires HttpServer
%requires HttpClientIo

%exec-class HttpServerAfterSendTest

#! the transmission result reported to an after_send callback
hashdecl AfterSendResult {
    #! the request ID
    string id;
    #! the sent argument
    bool sent;
    #! the handler's thread-local data while the callback ran
    *string tld;
    #! the request context's handler name
    *string handler_name;
    #! the result of the request's probe, if any
    auto probe;
}

#! collects the results of after_send callbacks
class AfterSendRecorder {
    public {
        #! receives an AfterSendResult for each callback call
        Queue results();
    }

    #! returns an after_send callback for the given request ID
    /** @param id the request ID
        @param probe called in the callback; its return value is recorded
        @param fail if True, the callback throws an exception after recording its result
    */
    code<nothing(hash<auto>, bool)> getCallback(string id, *code probe, bool fail = False) {
        return sub (hash<auto> cx, bool sent) {
            results.push(<AfterSendResult>{
                "id": id,
                "sent": sent,
                "tld": get_thread_data("after_send_tld"),
                "handler_name": cx.handler_name,
                "probe": probe ? probe() : NOTHING,
            });
            if (fail) {
                throw "AFTER-SEND-TEST-ERROR", "the callback fails";
            }
        };
    }
}

#! a Qore-implemented InputStream, which only a Qore thread can read (not I/O-thread-safe)
class QoreBlockStream inherits InputStream {
    private {
        binary data;
        int pos = 0;
    }

    constructor(binary data) {
        self.data = data;
    }

    *binary read(int limit) {
        if (pos >= data.size()) {
            return;
        }
        binary rv = data.substr(pos, limit > 3 ? 3 : limit);
        pos += rv.size();
        return rv;
    }

    int peek() {
        return pos < data.size() ? data[pos] : -1;
    }
}

#! returns responses of every form, each with an after_send callback
class AfterSendHandler inherits AbstractHttpRequestHandler {
    public {
        const Body = "0123456789";
        const Chunks = ("01", "234", "56789");
        #! the size of the large response
        const LargeSize = 1024 * 1024;
        #! the size of the response to a client that has gone away; larger than any socket buffers
        const HugeSize = 16 * 1024 * 1024;
    }

    private {
        AfterSendRecorder recorder;
        #! the "wait" request pushes to this Queue when it is being handled
        Queue entered();
        #! the "wait" request returns its response when this Queue has an entry
        Queue release();
        #! the probe for the "order" request
        *code order_probe;
    }

    constructor(AfterSendRecorder recorder) {
        self.recorder = recorder;
    }

    #! sets the probe for the "order" request
    setOrderProbe(*code probe) {
        order_probe = probe;
    }

    #! waits until a "wait" request is being handled
    waitEntered() {
        entered.get(30s);
    }

    #! lets a "wait" request return its response
    releaseWait() {
        release.push(True);
    }

    *hash<auto> saveThreadLocalData() {
        save_thread_data({"after_send_tld": "handler"});
        return {};
    }

    restoreThreadLocalData(*hash<auto> data) {
        remove_thread_data("after_send_tld");
    }

    hash<HttpResponseInfo> handleRequest(HttpListenerInterface listener, Socket s, hash<auto> cx, hash<auto> hdr,
            *data body) {
        string name = (hdr.path =~ x/([^\/]+)$/)[0];
        string id = hdr."x-id" ?? name;
        code<nothing(hash<auto>, bool)> after_send = recorder.getCallback(id, name == "order" ? order_probe : NOTHING,
            name == "raise");
        binary b = binary(Body);
        switch (name) {
            case "small":
            case "order":
            case "raise":
                return <HttpResponseInfo>{"code": 200, "body": Body, "after_send": after_send};
            case "close":
                return <HttpResponseInfo>{"code": 200, "body": Body, "close": True, "after_send": after_send};
            case "empty":
                return <HttpResponseInfo>{"code": 202, "after_send": after_send};
            case "chunked":
                return <HttpResponseInfo>{"code": 200, "chunked_body": new BinaryInputStream(b),
                    "after_send": after_send};
            case "stream":
                return <HttpResponseInfo>{"code": 200, "body": new BinaryInputStream(b), "after_send": after_send};
            case "stream-length":
                return <HttpResponseInfo>{"code": 200, "body": new BinaryInputStream(b),
                    "hdr": {"Content-Length": b.size()}, "after_send": after_send};
            case "qore-stream":
                return <HttpResponseInfo>{"code": 200, "body": new QoreBlockStream(b), "after_send": after_send};
            case "callback": {
                list<string> l = Chunks;
                return <HttpResponseInfo>{"code": 200, "send_callback": auto sub () { return shift l; },
                    "after_send": after_send};
            }
            case "error":
                return <HttpResponseInfo>{"code": 404, "body": "not here", "after_send": after_send};
            case "large":
                return <HttpResponseInfo>{"code": 200, "body": strmul("x", LargeSize), "after_send": after_send};
            case "wait":
                entered.push(True);
                release.get(30s);
                return <HttpResponseInfo>{"code": 200, "body": strmul("x", HugeSize), "after_send": after_send};
            case "invalid":
                return <HttpResponseInfo>{"code": 999, "body": "invalid", "after_send": after_send};
            case "sse":
                # this handler cannot serve an SSE stream; the response is replaced by an error response
                return <HttpResponseInfo>{"code": 200, "hdr": {"Content-Type": MimeTypeSse},
                    "after_send": after_send};
            case "reply-sent":
                s.sendHTTPResponse(200, "OK", "1.1", {"Content-Type": MimeTypeText, "Connection": "close"},
                    "self-reply");
                return <HttpResponseInfo>{"code": 200, "reply_sent": True, "close": True, "after_send": after_send};
        }
        return <HttpResponseInfo>{"code": 404, "body": "unknown case"};
    }
}

#! makes the session persistent with a request ending in "start"; a request ending in "end" ends the session
class PersistentAfterSendHandler inherits AbstractHttpRequestHandler {
    private {
        AfterSendRecorder recorder;
    }

    constructor(AfterSendRecorder recorder) {
        self.recorder = recorder;
    }

    *hash<auto> saveThreadLocalData() {
        save_thread_data({"after_send_tld": "persistent"});
        return {};
    }

    restoreThreadLocalData(*hash<auto> data) {
        remove_thread_data("after_send_tld");
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        string id = hdr."x-id";
        if (hdr.path =~ /start$/) {
            setPersistent(True);
        }
        return <HttpResponseInfo>{
            "code": 200,
            "body": isPersistent() ? "persistent" : "not persistent",
            "after_send": recorder.getCallback(id),
        };
    }

    bool isPersistentSessionEndRequest(hash<auto> hdr) {
        return hdr.path =~ /end$/;
    }
}

#! answers requests inline, on the async I/O callback dispatcher
class InlineAfterSendHandler inherits AbstractHttpRequestHandler {
    private {
        AfterSendRecorder recorder;
    }

    constructor(AfterSendRecorder recorder) {
        self.recorder = recorder;
    }

    *hash<auto> saveThreadLocalData() {
        save_thread_data({"after_send_tld": "inline"});
        return {};
    }

    restoreThreadLocalData(*hash<auto> data) {
        remove_thread_data("after_send_tld");
    }

    bool canHandleInline(hash<auto> cx, hash<auto> hdr) {
        return True;
    }

    hash<HttpResponseInfo> handleInlineRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return <HttpResponseInfo>{"code": 200, "body": "inline", "after_send": recorder.getCallback(hdr."x-id")};
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return <HttpResponseInfo>{"code": 500, "body": "not handled inline"};
    }
}

#! collects the errors logged for failing after_send callbacks
class AfterSendErrorCapture inherits LoggerAppenderWithLayout {
    public {
        #! receives each after_send callback error message
        Queue messages();
    }

    constructor() : LoggerAppenderWithLayout("capture", new LoggerLayoutPattern("%m")) {
        open();
    }

    processEventImpl(int type, auto params) {
        if (type == EVENT_LOG && params =~ /error in after_send callback/) {
            messages.push(params);
        }
    }
}

