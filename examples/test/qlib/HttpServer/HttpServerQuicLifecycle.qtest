#! Handler that responds normally
class NormalHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return <HttpResponseInfo>{
            "code": 200,
            "body": make_json({"ok": True}),
            "hdr": {"Content-Type": MimeTypeJson},
        };
    }
}

#! Handler that delays response to trigger client timeout
class SilentHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        # Sleep longer than any reasonable client timeout but still bounded
        # so the test can shut down cleanly
        sleep(10);
        return <HttpResponseInfo>{
            "code": 200,
            "body": "{}",
        };
    }
}

class HttpServerQuicLifecycleTest inherits QUnit::Test {
    private {
        HttpServer m_http;
        int m_quic_port;
        bool m_quic_available = False;
    }

    constructor() : Test("HttpServerQuicLifecycleTest", "1.0") {
        @debug {
            set_signal_handler(SIGUSR1, sub (int sig) {
                printf("=== SIGUSR1 Thread Stacks ===\n%Y\n", get_all_thread_call_stacks());
            });
        }
        Logger logger("test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }

        m_http = new HttpServer(<HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        });
        m_http.waitForAsyncIo();

        m_http.setHandler("normal", "/normal", MimeTypeJson, new NormalHandler());
        m_http.setDefaultHandler("normal", new NormalHandler());

        # Add QUIC listener
        try {
            hash<auto> quic_info = m_http.addQuicListener(<HttpListenerOptionInfo>{
                "cert": new SSLCertificate(CertPem),
                "key": new SSLPrivateKey(KeyPem),
            });
            m_quic_port = quic_info.port;
            m_quic_available = True;
        } catch (hash<ExceptionInfo> ex) {
            printf("QUIC listener failed: %s: %s\n", ex.err, ex.desc);
        }

        if (m_quic_available) {
            addTestCase("H3 listener stop releases UDP port for rebind", \testListenerStopReleasesUdpPort());
            addTestCase("paired H3 listener stop releases UDP port for rebind",
                \testPairedListenerStopReleasesUdpPort());
            addTestCase("H3 normal request completes efficiently", \testNormalRequest());
            addTestCase("H3 request timeout on silent server", \testRequestTimeout());
            addTestCase("H3 connection reuse after error", \testConnectionReuseAfterError());
        } else {
            printf("SKIP: QUIC not available\n");
        }

        set_return_value(main());

        delete m_http;
    }

    private string getQuicUrl() {
        return sprintf("https://127.0.0.1:%d", m_quic_port);
    }

    #! Stopping a standalone H3 listener releases its UDP port
    testListenerStopReleasesUdpPort() {
        Logger logger("rebind", LoggerLevel::getLevelInfo());
        HttpServer http(<HttpServerOptionInfo>{
            "logger": logger,
        });
        http.waitForAsyncIo();
        on_exit delete http;

        hash<HttpListenerOptionInfo> opts = <HttpListenerOptionInfo>{
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
            "node": "127.0.0.1",
            "family": AF_INET,
        };

        hash<auto> first = http.addQuicListener(opts);
        int port = first.port;
        http.stopListenerID(first.id);

        hash<auto> second = http.addQuicListener(opts, port);
        assertEq(port, second.port, "H3 listener can rebind to the same UDP port after stop");
        http.stopListenerID(second.id);
    }

    #! Stopping a TLS listener also releases its paired H3 UDP port
    testPairedListenerStopReleasesUdpPort() {
        Logger logger("paired-rebind", LoggerLevel::getLevelInfo());
        HttpServer http(<HttpServerOptionInfo>{
            "logger": logger,
            "enable_h3": True,
        });
        http.waitForAsyncIo();
        on_exit delete http;

        hash<HttpListenerOptionInfo> opts = <HttpListenerOptionInfo>{
            "service": "0",
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
            "node": "127.0.0.1",
            "family": AF_INET,
        };

        hash<auto> first = http.addListener(opts);
        int port = first.port;
        http.stopListenerID(first.id);

        opts.service = string(port);
        hash<auto> second = http.addListener(opts);
        assertEq(port, second.port,
            "paired H3 listener can rebind to the same UDP port after TCP listener stop");
        http.stopListenerID(second.id);
    }

    #! Normal H3 request completes within reasonable time (no livelock)
    testNormalRequest() {
        RestClientIo rc({
            "url": getQuicUrl(),
            "data": "json",
            "accept_all_certs": True,
            "timeout": 10s,
            "connect_timeout": 5s,
        });

        date start = now_us();
        hash<auto> resp = rc.restGet("/normal");
        date elapsed = now_us() - start;

        assertEq(200, resp.status_code, "H3 request succeeds");
        assertTrue(resp.body.ok, "H3 response body correct");
        assertTrue(elapsed < 5s,
            sprintf("H3 request completed in %y (expected < 5s)", elapsed));
    }

    #! Client times out on silent server (no livelock, no busy-loop)
    testRequestTimeout() {
        # Use a separate server with the silent handler
        Logger logger("silent", LoggerLevel::getLevelInfo());
        HttpServer silent_http(<HttpServerOptionInfo>{
            "logger": logger,
        });
        silent_http.waitForAsyncIo();
        silent_http.setHandler("silent", "/silent", MimeTypeJson, new SilentHandler());
        silent_http.setDefaultHandler("silent", new SilentHandler());

        int silent_port;
        try {
            hash<auto> info = silent_http.addQuicListener(<HttpListenerOptionInfo>{
                "cert": new SSLCertificate(CertPem),
                "key": new SSLPrivateKey(KeyPem),
            });
            silent_port = info.port;
        } catch (hash<ExceptionInfo> ex) {
            testSkip("QUIC listener failed: " + ex.desc);
            return;
        }

        on_exit delete silent_http;

        RestClientIo rc({
            "url": sprintf("https://127.0.0.1:%d", silent_port),
            "data": "json",
            "accept_all_certs": True,
            "timeout": 3s,
            "connect_timeout": 3s,
        });

        date start = now_us();
        bool got_timeout = False;
        try {
            rc.restGet("/silent");
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err =~ /TIMEOUT/i || ex.err =~ /CLOSED/i || ex.err =~ /ERROR/i) {
                got_timeout = True;
            }
            if (m_options.verbose > 1) {
                printf("  timeout error: %s: %s\n", ex.err, ex.desc);
            }
        }
        date elapsed = now_us() - start;

        assertTrue(got_timeout, "silent server request timed out");
        # Must complete within 10s — if it takes longer, something is busy-looping
        assertTrue(elapsed < 10s,
            sprintf("timeout completed in %y (expected < 10s)", elapsed));
    }

    #! Connection reuse after stream error doesn't livelock
    testConnectionReuseAfterError() {
        RestClientIo rc({
            "url": getQuicUrl(),
            "data": "json",
            "accept_all_certs": True,
            "timeout": 5s,
            "connect_timeout": 5s,
        });

        # First request should succeed
        hash<auto> resp1 = rc.restGet("/normal");
        assertEq(200, resp1.status_code, "first request succeeds");

        # Second request to a non-existent path — server returns 404, not a stream error
        # but this exercises connection reuse
        hash<auto> resp2;
        try {
            resp2 = rc.restGet("/nonexistent");
        } catch (hash<ExceptionInfo> ex) {
            # 404 might be returned as an exception depending on RestClientIo config
            if (m_options.verbose > 1) {
                printf("  reuse error: %s: %s\n", ex.err, ex.desc);
            }
        }

        # Third request should succeed (either on same or new connection)
        date start = now_us();
        hash<auto> resp3 = rc.restGet("/normal");
        date elapsed = now_us() - start;

        assertEq(200, resp3.status_code, "third request succeeds after error");
        assertTrue(elapsed < 5s,
            sprintf("third request completed in %y (expected < 5s, no livelock)", elapsed));
    }
}
