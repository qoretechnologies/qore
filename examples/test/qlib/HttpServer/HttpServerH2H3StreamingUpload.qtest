    Client streaming request body tests for HTTP/2 (via HTTPClient).

    Tests cover:
    - sendWithSendCallback POST over HTTP/2 — verify body received
    - sendChunked (InputStream) POST over HTTP/2 — verify body received
    - Empty body via callback over HTTP/2 — verify immediate EOF
    - Callback exception mid-stream over HTTP/2 — verify graceful error handling
    - body_streaming resume: multiplexed GET succeeds while slow POST handler is processing
*/

%modern

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Mime.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/HttpServerUtil.qm
%requires ../../../../qlib/AsyncSocketIo
%requires ../../../../qlib/HttpServerAsyncIo
%requires ../../../../qlib/HttpServer.qm
%requires ../../../../qlib/HttpClientIo

%exec-class HttpServerH2H3StreamingUploadTest

#! Handler that echoes back the request body and reports its size
class EchoHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        string body_str = "";
        if (exists body) {
            if (body.typeCode() == NT_BINARY) {
                body_str = binary_to_string(body);
            } else if (body.typeCode() == NT_STRING) {
                body_str = body;
            }
        }
        return makeResponse(200, body_str, {"Content-Type": MimeTypeText});
    }
}

#! Handler that blocks after body reading to simulate a long-running request.
/** Uses Counter gates for deterministic synchronization with the test:
    - processing_gate: signals when the handler has received the body and is "processing"
    - release_gate: blocks the handler until the test releases it
*/
class SlowEchoHandler inherits AbstractHttpRequestHandler {
    private {
        Counter processing_gate(1);
        Counter release_gate(1);
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        # Signal that we've received the body and are now "processing"
        processing_gate.dec();
        # Block until the test releases us — simulates a long-running handler (e.g., bulk
        # object creation).  While blocked, the h2/h3 connection must remain alive for
        # PING, SETTINGS, WINDOW_UPDATE etc.
        release_gate.waitForZero(30s);
        string body_str = "";
        if (exists body) {
            if (body.typeCode() == NT_BINARY) {
                body_str = binary_to_string(body);
            } else if (body.typeCode() == NT_STRING) {
                body_str = body;
            }
        }
        return makeResponse(200, body_str, {"Content-Type": MimeTypeText});
    }

    #! Waits until the handler has started processing (body read complete)
    int waitForProcessing(timeout t = 10s) {
        return processing_gate.waitForZero(t);
    }

    #! Releases the handler so it can return a response
    release() {
        release_gate.dec();
    }
}

