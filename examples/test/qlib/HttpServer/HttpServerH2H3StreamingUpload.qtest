    constructor() : Test("HttpServerH2H3StreamingUploadTest", "1.0") {
        # Set up SIGUSR1 handler for debugging hangs
        @debug {
            set_signal_handler(SIGUSR1, sub (int sig) {
                printf("=== SIGUSR1 Thread Stacks ===\n%Y\n=== End Thread Stacks ===\n",
                    get_all_thread_call_stacks());
            });
        }

        addTestCase("sendWithSendCallback POST over HTTP/2", \testH2SendCallback());
        addTestCase("sendChunked InputStream POST over HTTP/2", \testH2InputStream());
        addTestCase("empty body via sendWithSendCallback over HTTP/2", \testH2EmptyCallback());
        addTestCase("callback exception over HTTP/2", \testH2CallbackException());
        addTestCase("H2 body_streaming resume enables multiplexing during slow handler",
            \testH2BodyStreamingResumeMultiplexing());
        addTestCase("H3 body_streaming resume enables multiplexing during slow handler",
            \testH3BodyStreamingResumeMultiplexing());

        set_return_value(main());
    }

    globalSetUp() {
        mLogger = new Logger("streaming-upload-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            mLogger.addAppender(new StdoutAppender());
        }
    }

    private hash<auto> createServer() {
        HttpServer server(<HttpServerOptionInfo>{
            "logger": mLogger,
            "debug": True,
        });
        server.setHandler("echo", "/echo", NOTHING, new EchoHandler());
        server.waitForAsyncIo();

        hash<auto> h2info = server.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
            "enable_h3": False,
        });
        server.waitForAsyncIo();

        return {"server": server, "h2_port": h2info.port};
    }

    #! Test sendWithSendCallback POST over HTTP/2
    testH2SendCallback() {
        hash<auto> setup = createServer();
        HttpServer server = setup.server;
        on_exit delete server;

        HTTPClient client({
            "url": sprintf("https://localhost:%d", setup.h2_port),
            "ssl_verify_cert": False,
        });
        on_exit client.disconnect();

        list<string> chunks = ("Hello", " ", "World", " via ", "HTTP/2!");
        int idx = 0;
        code send_cb = auto sub () {
            if (idx >= chunks.size()) {
                return NOTHING;
            }
            return chunks[idx++];
        };

        hash<auto> resp = client.sendWithSendCallback(send_cb, "POST", "/echo",
            {"Content-Type": MimeTypeText});
        assertEq(200, resp.status_code, "HTTP/2 send_callback POST should succeed");
        string resp_body = resp.body.typeCode() == NT_BINARY
            ? binary_to_string(resp.body) : resp.body;
        assertEq("Hello World via HTTP/2!", resp_body,
            "HTTP/2 send_callback body should be echoed back");
    }

    #! Test sendChunked with InputStream POST over HTTP/2
    testH2InputStream() {
        hash<auto> setup = createServer();
        HttpServer server = setup.server;
        on_exit delete server;

        HTTPClient client({
            "url": sprintf("https://localhost:%d", setup.h2_port),
            "ssl_verify_cert": False,
        });
        on_exit client.disconnect();

        string body_str = "InputStream body over HTTP/2";
        binary body_bin = binary(body_str);
        BinaryInputStream bis(body_bin);
        StringOutputStream sos();

        client.sendChunked(sos, bis, "POST", 4096, "/echo",
            {"Content-Type": MimeTypeText});
        string resp_body = sos.getData();
        assertEq(body_str, resp_body,
            "HTTP/2 InputStream body should be echoed back");
    }

    #! Test empty body via sendWithSendCallback over HTTP/2 (immediate EOF)
    testH2EmptyCallback() {
        hash<auto> setup = createServer();
        HttpServer server = setup.server;
        on_exit delete server;

        HTTPClient client({
            "url": sprintf("https://localhost:%d", setup.h2_port),
            "ssl_verify_cert": False,
        });
        on_exit client.disconnect();

        # Callback returns NOTHING immediately → empty body / EOF
        code send_cb = auto sub () { return NOTHING; };

        hash<auto> resp = client.sendWithSendCallback(send_cb, "POST", "/echo",
            {"Content-Type": MimeTypeText});
        # Empty body may result in 200 with empty body or 204 No Content
        assertTrue(resp.status_code == 200 || resp.status_code == 204,
            "HTTP/2 empty callback POST should succeed (got " + resp.status_code + ")");
        if (resp.status_code == 200) {
            string resp_body = resp.body.typeCode() == NT_BINARY
                ? binary_to_string(resp.body) : resp.body;
            assertTrue(!resp_body.val(), "HTTP/2 empty callback should produce empty body");
        }
    }

    #! Test callback exception mid-stream over HTTP/2
    testH2CallbackException() {
        hash<auto> setup = createServer();
        HttpServer server = setup.server;
        on_exit delete server;

        HTTPClient client({
            "url": sprintf("https://localhost:%d", setup.h2_port),
            "ssl_verify_cert": False,
        });
        on_exit client.disconnect();

        # Callback sends one chunk then throws
        int call_count = 0;
        code send_cb = auto sub () {
            if (call_count++ == 0) {
                return "partial data";
            }
            throw "TEST-CALLBACK-ERROR", "intentional error in send_callback";
        };

        bool caught = False;
        try {
            client.sendWithSendCallback(send_cb, "POST", "/echo",
                {"Content-Type": MimeTypeText});
        } catch (hash<ExceptionInfo> ex) {
            caught = True;
            @debug(printf("Expected callback exception: %s: %s\n", ex.err, ex.desc));
        }
        assertTrue(caught, "callback exception should propagate to caller");
    }

    #! Verify that multiplexed HTTP/2 requests work while a body_streaming handler is processing.
    testH2BodyStreamingResumeMultiplexing() {
        bodyStreamingResumeMultiplexingImpl("h2");
    }

    #! Same test over HTTP/3 (QUIC) — skipped if QUIC is not available.
    testH3BodyStreamingResumeMultiplexing() {
        bodyStreamingResumeMultiplexingImpl("h3");
    }

    #! Shared implementation for the body_streaming resume multiplexing test.
    /** Tests the fix where resume_body_streaming() is called from HttpServer after body
        reading completes, rather than after the handler returns.  Without this fix, the h2/h3
        poll operation stays paused during handler processing, stalling the connection (PING,
        SETTINGS, WINDOW_UPDATE cannot be processed) and blocking multiplexed requests.

        @param proto "h2" for HTTP/2, "h3" for HTTP/3 (QUIC)
    */
    private bodyStreamingResumeMultiplexingImpl(string proto) {
        SlowEchoHandler slow_handler();

        HttpServer server(<HttpServerOptionInfo>{
            "logger": mLogger,
            "debug": True,
        });
        on_exit delete server;

        server.setHandler("slow-echo", "/slow-echo", NOTHING, slow_handler);
        server.setHandler("echo", "/echo", NOTHING, new EchoHandler());
        server.waitForAsyncIo();

        string url;
        if (proto == "h3") {
            try {
                int port = server.addQuicListener(<HttpListenerOptionInfo>{
                    "cert": new SSLCertificate(CertPem),
                    "key": new SSLPrivateKey(KeyPem),
                }).port;
                url = sprintf("https://127.0.0.1:%d", port);
            } catch (hash<ExceptionInfo> ex) {
                testSkip(sprintf("QUIC listener not available: %s: %s", ex.err, ex.desc));
            }
        } else {
            int port = server.addListener(<HttpListenerOptionInfo>{
                "service": 0,
                "cert": new SSLCertificate(CertPem),
                "key": new SSLPrivateKey(KeyPem),
                "enable_h3": False,
            }).port;
            url = sprintf("https://localhost:%d", port);
        }
        server.waitForAsyncIo();

        # Use a single connection for multiplexing
        HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": proto,
            "max_connections_per_host": 1,
            "logger": mLogger,
        });
        on_exit delete mgr;

        # Acquire two streams on the same connection
        HttpClientIo::HttpClientStreamHandle slow_stream = mgr.acquireStream(url);
        HttpClientIo::HttpClientStreamHandle fast_stream = mgr.acquireStream(url);

        # Start the slow POST in a background thread — sends body via DATA frames,
        # triggering body_streaming on the server
        hash<auto> slow_result;
        *hash<ExceptionInfo> slow_error;
        Counter done(1);
        background sub () {
            on_exit done.dec();
            try {
                slow_result = slow_stream.request("POST", "/slow-echo",
                    {"Content-Type": MimeTypeText}, "test-body-data");
            } catch (hash<ExceptionInfo> ex) {
                slow_error = ex;
            }
        }();

        # Wait for the slow handler to start processing (body has been fully read by the
        # framework, and resume_body_streaming() has been called)
        int rc = slow_handler.waitForProcessing(10s);
        assertEq(0, rc, proto + " slow handler should start processing within timeout");

        # Now send a fast GET on the same connection — this exercises the fix:
        # the poll operation was resumed by resume_body_streaming() after body reading,
        # so the I/O thread can process new requests while the slow handler is blocked
        hash<auto> fast_result = fast_stream.request("GET", "/echo", NOTHING, NOTHING, 10s);
        assertTrue(fast_result.status_code == 200 || fast_result.status_code == 204,
            sprintf("%s multiplexed GET should succeed while slow handler is processing (got %d)",
                proto, fast_result.status_code));

        # Verify we used a single multiplexed connection
        hash<auto> stats = mgr.getStats();
        assertEq(1, stats.total_connections,
            proto + " should use 1 multiplexed connection, not separate connections");

        # Release the slow handler and verify it completes successfully
        slow_handler.release();
        int remaining = done.waitForZero(10s);
        assertEq(0, remaining, proto + " slow POST should complete after release");
        if (slow_error) {
            fail(sprintf("%s slow POST failed: %s: %s", proto, slow_error.err, slow_error.desc));
        }
        assertEq(200, slow_result.status_code, proto + " slow POST should return 200");
        # Verify the body was echoed back
        string resp_body;
        if (slow_result.body.typeCode() == NT_BINARY) {
            resp_body = binary_to_string(slow_result.body);
        } else {
            resp_body = slow_result.body;
        }
        assertEq("test-body-data", resp_body, proto + " slow POST body should be echoed back");
    }
}
