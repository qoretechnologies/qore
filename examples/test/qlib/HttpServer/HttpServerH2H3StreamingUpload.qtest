    Client streaming request body tests for HTTP/2 (via HTTPClient).

    Tests cover:
    - sendWithSendCallback POST over HTTP/2 — verify body received
    - sendChunked (InputStream) POST over HTTP/2 — verify body received
    - Empty body via callback over HTTP/2 — verify immediate EOF
    - Callback exception mid-stream over HTTP/2 — verify graceful error handling
*/

%modern

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Mime.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/HttpServerUtil.qm
%requires ../../../../qlib/AsyncSocketIo
%requires ../../../../qlib/HttpServerAsyncIo
%requires ../../../../qlib/HttpServer.qm

%exec-class HttpServerH2H3StreamingUploadTest

#! Handler that echoes back the request body and reports its size
class EchoHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        string body_str;
        if (body.typeCode() == NT_BINARY) {
            body_str = binary_to_string(body);
        } else if (body.typeCode() == NT_STRING) {
            body_str = body;
        }
        return makeResponse(200, body_str, {"Content-Type": MimeTypeText});
    }
}

