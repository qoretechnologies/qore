    Tests for the maximum size of a decompressed HTTP request body:
    - every supported Content-Encoding below, at, and above the limit
    - server, listener, and handler limits and the fallback to max_request_body_size and the default
    - Content-Length and chunked HTTP/1.1 requests, HTTP/2, and HTTP/3
    - a decompression bomb is rejected without expanding it
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Mime
%requires Logger
%requires HttpServerUtil
%requires HttpServerAsyncIo
%requires HttpServer

%exec-class HttpServerDecodedBodyLimitTest

#! returns the type and size of the request body it receives
class BodySizeHandler inherits AbstractHttpRequestHandler {
    constructor(bool to_string = False, int max_size = 0) {
        decompress_to_string = to_string;
        max_decoded_body_size = max_size;
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, sprintf("%s:%d", body.type(), body.size()), {"Content-Type": MimeTypeText});
    }
}

class HttpServerDecodedBodyLimitTest inherits QUnit::Test {
    private {
        # the decoded body limit of the server
        const Limit = 4096;

        # the decoded body limit of the handler that overrides the server
        const HandlerLimit = Limit * 4;

        # the decoded body limit of the listener that overrides the server
        const ListenerLimit = Limit / 2;

        # the maximum request body size of the server without a decoded body limit
        const RequestLimit = 8192;

        # the maximum request body size of the TLS listener
        const TlsRequestLimit = 8192;

        # the maximum request body size of the listeners with their own request body limit
        const ListenerRequestLimit = 2048;

        # the encoders for each supported content encoding
        const Encoders = {
            "gzip": binary sub (binary b) { return gzip(b); },
            "x-gzip": binary sub (binary b) { return gzip(b); },
            "deflate": binary sub (binary b) { return compress(b); },
            "x-deflate": binary sub (binary b) { return compress(b); },
            "bzip2": binary sub (binary b) { return bzip2(b); },
            "x-bzip2": binary sub (binary b) { return bzip2(b); },
            "br": binary sub (binary b) { return brotli(b); },
            "zstd": binary sub (binary b) { return zstd(b); },
        };

