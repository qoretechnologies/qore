-----END PRIVATE KEY-----";
    }

    private {
        Logger logger;

        # server with a decoded body limit
        HttpServer server;
        string url;
        string small_url;
        int tls_port;

        # server with only a request body limit
        HttpServer request_server;
        string request_url;

        # server without any limit, where the default applies
        HttpServer default_server;
        string default_url;

        # a listener of the server without any limit that sets a request body limit
        string default_request_url;

        # a listener of the server with a decoded body limit that sets a request body limit
        string request_listener_url;
    }

    constructor() : Test("HttpServerDecodedBodyLimitTest", "1.0") {
        addTestCase("every content encoding at the limit", \encodingTest());
        addTestCase("string decoding", \stringTest());
        addTestCase("handler limit", \handlerTest());
        addTestCase("listener limit", \listenerTest());
        addTestCase("request body size fallback", \requestBodySizeTest());
        addTestCase("default limit", \defaultLimitTest());
        addTestCase("server getter and setter", \setterTest());
        addTestCase("chunked HTTP/1.1 request", \chunkedTest());
        addTestCase("HTTP/2 request", \http2Test());
        addTestCase("HTTP/3 request", \http3Test());
        addTestCase("decodeBody()", \decodeBodyTest());
        set_return_value(main());
    }

    globalSetUp() {
        logger = new Logger("decoded-body-limit-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }

        server = new HttpServer(<HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
            "max_decoded_body_size": Limit,
        });
        server.setHandler("size", "/size", NOTHING, new BodySizeHandler());
        server.setHandler("string", "/string", NOTHING, new BodySizeHandler(True));
        server.setHandler("big", "/big", NOTHING, new BodySizeHandler(False, HandlerLimit));
        server.setHandler("unlimited", "/unlimited", NOTHING, new BodySizeHandler(False, -1));
        url = "http://localhost:" + server.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        small_url = "http://localhost:" + server.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "max_decoded_body_size": ListenerLimit,
        }).port;
        request_listener_url = "http://localhost:" + server.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "max_request_body_size": ListenerRequestLimit,
        }).port;
        tls_port = server.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
            "max_request_body_size": TlsRequestLimit,
        }).port;
        server.waitForAsyncIo();

        request_server = new HttpServer(<HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
            "max_request_body_size": RequestLimit,
        });
        request_server.setHandler("size", "/size", NOTHING, new BodySizeHandler());
        request_url = "http://localhost:" + request_server.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        request_server.waitForAsyncIo();

        default_server = new HttpServer(<HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        });
        default_server.setHandler("size", "/size", NOTHING, new BodySizeHandler());
        default_url = "http://localhost:" + default_server.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        default_request_url = "http://localhost:" + default_server.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "max_request_body_size": ListenerRequestLimit,
        }).port;
        default_server.waitForAsyncIo();
    }

    globalTearDown() {
        delete server;
        delete request_server;
        delete default_server;
    }

    # sends a POST request with an encoded body and returns the response
    private hash<auto> post(string target, string path, string enc, binary body, *hash<auto> opts) {
        HTTPClient c({"url": target, "timeout": 30s} + opts);
        on_exit c.disconnect();
        c.setErrorPassthru(True);
        return c.send(body, "POST", path, {"Content-Encoding": enc, "Content-Type": MimeTypeOctetStream});
    }

    # returns an uncompressed body of the given size
    private static binary makeBody(int size) {
        return binary(strmul("x", size));
    }

    # asserts that a body of the given decoded size is accepted
    private assertAccepted(string target, string path, string enc, int size, *hash<auto> opts) {
        hash<auto> resp = post(target, path, enc, Encoders{enc}(makeBody(size)), opts);
        assertEq(200, resp.status_code, sprintf("%s %s: %d bytes accepted", enc, path, size));
        assertEq("binary:" + size, resp.body, sprintf("%s %s: %d bytes decoded", enc, path, size));
    }

    # asserts that a body of the given decoded size is rejected with 413
    private assertRejected(string target, string path, string enc, int size, *hash<auto> opts) {
        hash<auto> resp = post(target, path, enc, Encoders{enc}(makeBody(size)), opts);
        assertEq(413, resp.status_code, sprintf("%s %s: %d bytes rejected", enc, path, size));
        assertRegex("exceeds the maximum decoded body size", resp.body,
            sprintf("%s %s: %d bytes rejected with the reason", enc, path, size));
    }

    encodingTest() {
        foreach string enc in (keys Encoders) {
            assertAccepted(url, "/size", enc, Limit - 1);
            assertAccepted(url, "/size", enc, Limit);
            assertRejected(url, "/size", enc, Limit + 1);
        }
    }

    stringTest() {
        hash<auto> resp = post(url, "/string", "gzip", gzip(makeBody(Limit)));
        assertEq(200, resp.status_code);
        assertEq("string:" + Limit, resp.body);
        resp = post(url, "/string", "gzip", gzip(makeBody(Limit + 1)));
        assertEq(413, resp.status_code);
    }

    handlerTest() {
        # a handler limit overrides the server limit
        assertAccepted(url, "/big", "gzip", HandlerLimit);
        assertRejected(url, "/big", "gzip", HandlerLimit + 1);
        # a negative handler limit means no limit
        assertAccepted(url, "/unlimited", "gzip", HandlerLimit * 4);
        # a handler limit also overrides the listener limit
        assertAccepted(small_url, "/big", "gzip", HandlerLimit);
    }

    listenerTest() {
        # a listener limit overrides the server limit
        assertAccepted(small_url, "/size", "zstd", ListenerLimit);
        assertRejected(small_url, "/size", "zstd", ListenerLimit + 1);
    }

    requestBodySizeTest() {
        # without a decoded body limit, the request body limit applies to the decoded body
        assertAccepted(request_url, "/size", "br", RequestLimit);
        assertRejected(request_url, "/size", "br", RequestLimit + 1);

        # the request body limit of a listener applies to the decoded body when no decoded body limit is set
        assertAccepted(default_request_url, "/size", "gzip", ListenerRequestLimit);
        assertRejected(default_request_url, "/size", "gzip", ListenerRequestLimit + 1);

        # a decoded body limit takes precedence over the request body limit of the listener: the limit of the
        # decoded body is the server's, although the compressed body is within the listener's request body limit
        assertLt(Limit, ListenerRequestLimit, "the server's decoded body limit is larger");
        assertAccepted(request_listener_url, "/size", "gzip", Limit);
        assertRejected(request_listener_url, "/size", "gzip", Limit + 1);
    }

    # returns gzip data that decompresses to the given number of spaces, without holding the decompressed data
    private static binary makeBomb(int size) {
        BinaryOutputStream bos();
        TransformOutputStream tos(bos, get_compressor(COMPRESSION_ALG_GZIP));
        binary chunk = binary(strmul(" ", 1024 * 1024));
        for (int i = 0; i < size / chunk.size(); ++i) {
            tos.write(chunk);
        }
        tos.close();
        return bos.getData();
    }

    defaultLimitTest() {
        assertEq(128 * 1024 * 1024, DefaultMaxDecodedBodySize);
        assertAccepted(default_url, "/size", "gzip", 1024 * 1024);
        # a bomb that expands beyond the default limit
        binary bomb = makeBomb(DefaultMaxDecodedBodySize + 1024 * 1024);
        assertLt(1024 * 1024, bomb.size(), "the bomb is small");
        hash<auto> resp = post(default_url, "/size", "gzip", bomb);
        assertEq(413, resp.status_code);
        assertRegex(sprintf("maximum decoded body size of %d bytes", DefaultMaxDecodedBodySize), resp.body);
    }

    setterTest() {
        HttpServer srv(<HttpServerOptionInfo>{"logger": logger});
        on_exit delete srv;
        assertEq(0, srv.getMaxDecodedBodySize());
        srv.setMaxDecodedBodySize(100);
        assertEq(100, srv.getMaxDecodedBodySize());
        srv.setHandler("size", "/size", NOTHING, new BodySizeHandler());
        string srv_url = "http://localhost:" + srv.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        srv.waitForAsyncIo();
        assertAccepted(srv_url, "/size", "deflate", 100);
        assertRejected(srv_url, "/size", "deflate", 101);
        # a negative server limit means no limit, even when the default would apply
        srv.setMaxDecodedBodySize(-1);
        assertAccepted(srv_url, "/size", "deflate", Limit * 8);

        # the handler's resolution of the limit
        BodySizeHandler handler();
        assertEq(DefaultMaxDecodedBodySize, handler.getMaxDecodedBodySize());
        handler.max_decoded_body_size = 10;
        assertEq(10, handler.getMaxDecodedBodySize());
    }

    # sends a POST request with an encoded body in chunks
    private hash<auto> postChunked(string target, string enc, binary body) {
        HTTPClient c({"url": target, "timeout": 30s});
        on_exit c.disconnect();
        c.setErrorPassthru(True);
        int offset = 0;
        code<*binary()> send_cb = *binary sub () {
            if (offset >= body.size()) {
                return;
            }
            binary chunk = body.substr(offset, 100);
            offset += chunk.size();
            return chunk;
        };
        return c.sendWithSendCallback(send_cb, "POST", "/size", {"Content-Encoding": enc,
            "Content-Type": MimeTypeOctetStream});
    }

    chunkedTest() {
        hash<auto> resp = postChunked(url, "gzip", gzip(makeBody(Limit)));
        assertEq(200, resp.status_code);
        assertEq("binary:" + Limit, resp.body);
        resp = postChunked(url, "gzip", gzip(makeBody(Limit + 1)));
        assertEq(413, resp.status_code);
    }

    http2Test() {
        string tls_url = "https://localhost:" + tls_port;
        hash<auto> opts = {"ssl_verify_cert": False, "http_version": "2"};
        {
            HTTPClient c({"url": tls_url} + opts);
            on_exit c.disconnect();
            c.setErrorPassthru(True);
            c.send(NOTHING, "GET", "/size");
            if (c.getHttpVersion() != "HTTP/2") {
                testSkip("HTTP/2 was not negotiated: " + c.getHttpVersion());
            }
        }
        foreach string enc in ("gzip", "br", "zstd") {
            assertAccepted(tls_url, "/size", enc, Limit, opts);
            assertRejected(tls_url, "/size", enc, Limit + 1, opts);
        }
    }

    http3Test() {
        string tls_url = "https://localhost:" + tls_port;
        hash<auto> opts = {"ssl_verify_cert": False, "http_version": "3"};
        {
            HTTPClient c({"url": tls_url} + opts);
            on_exit c.disconnect();
            try {
                c.connect();
            } catch (hash<ExceptionInfo> ex) {
                testSkip(sprintf("HTTP/3 is not available: %s: %s", ex.err, ex.desc));
            }
            if (c.getHttpVersion() != "HTTP/3") {
                testSkip("HTTP/3 was not negotiated: " + c.getHttpVersion());
            }
        }
        assertAccepted(tls_url, "/size", "gzip", Limit, opts);
        assertRejected(tls_url, "/size", "gzip", Limit + 1, opts);

        # the QUIC listener enforces the request body limit of its TCP listener
        bool rejected;
        try {
            HTTPClient c({"url": tls_url, "timeout": 30s} + opts);
            on_exit c.disconnect();
            c.setErrorPassthru(True);
            hash<auto> resp = c.send(makeBody(TlsRequestLimit + 1), "POST", "/size",
                {"Content-Type": MimeTypeOctetStream});
            rejected = resp.status_code == 413;
        } catch (hash<ExceptionInfo> ex) {
            # the server may cancel the request stream instead of answering it
            rejected = True;
        }
        assertTrue(rejected, "HTTP/3 request above the listener's request body limit is rejected");
    }

    decodeBodyTest() {
        binary body = gzip(makeBody(10));
        assertEq(makeBody(10), AbstractHttpRequestHandler::decodeBody("gzip", body));
        assertEq(makeBody(10), AbstractHttpRequestHandler::decodeBody("gzip", body, NOTHING, 10));
        assertEq(makeBody(10), AbstractHttpRequestHandler::decodeBody("gzip", body, NOTHING, -1));
        assertThrows("DECOMPRESSION-LIMIT-EXCEEDED", \AbstractHttpRequestHandler::decodeBody(), ("gzip", body,
            NOTHING, 9));
        assertThrows("HTTP-BODY-TOO-LARGE", "maximum decoded body size of 9 bytes",
            \AbstractHttpRequestHandler::decodeRequestBody(), ("gzip", body, NOTHING, 9));
        assertEq("xxxxxxxxxx", AbstractHttpRequestHandler::decodeRequestBody("gzip", body, "utf-8", -1));
        assertThrows("UNSUPPORTED-CONTENT-ENCODING", \AbstractHttpRequestHandler::decodeRequestBody(),
            ("compress", body, NOTHING, 10));
    }
}
