#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

/*
    Copyright (C) 2026 Qore Technologies, s.r.o., all rights reserved

    Tests for the StreamResponseProducer path — true incremental streaming
    response delivery without materialization.

    Response InputStream bodies whose isIoThreadSafe() == false are streamed
    chunk-by-chunk to the H2/H3 session's send buffer by a dedicated
    producer worker thread.  The I/O thread never calls read() on the
    stream; memory is bounded by the peer's flow-control window.

    Coverage (matches /home/david/.claude/plans/streaming-semantics-fix.md):
    - T1: Multi-GB synthesized response streams without exhausting memory
    - T2: Low TTFB — first bytes arrive before the handler finishes producing
    - T3: Backpressure — bounded memory when producer outpaces consumer
    - T4: Stream reset on read error — peer sees RST, not silent hang
    - T5: Concurrent streams — backpressure on one does not starve others
    - T6: Clean shutdown mid-stream — producer exits within bound
    - T8: read() runs on the producer worker thread (not I/O, not handler)
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Mime
%requires Logger
%requires HttpServerUtil
%requires AsyncSocketIo
%requires HttpServerAsyncIo
%requires HttpServer
%requires HttpClientIo
%requires RestClient

%exec-class HttpServerStreamProducerTest

#! Synthesizes a large payload on-the-fly without allocating the full size
class SyntheticLargeInputStream inherits InputStream {
    private {
        int total_size;
        int emitted = 0;
        int chunk_fill = ord("L");
    }

    constructor(int total_size) {
        self.total_size = total_size;
    }

    *binary read(int limit) {
        if (emitted >= total_size) {
            return NOTHING;
        }
        int to_emit = min(limit, total_size - emitted);
        binary chunk = binary(strmul(chr(chunk_fill), to_emit));
        emitted += to_emit;
        return chunk;
    }

    int peek() {
        return emitted >= total_size ? -1 : chunk_fill;
    }

    int getEmitted() {
        return emitted;
    }
}

#! Handler: returns a SyntheticLargeInputStream of the configured size
class LargeResponseHandler inherits AbstractHttpRequestHandler {
    private {
        int payload_size;
    }

    constructor(int payload_size) {
        self.payload_size = payload_size;
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, new SyntheticLargeInputStream(payload_size), {
            "Content-Type": "application/octet-stream",
        });
    }
}

#! Emits chunks on demand — test controls pacing via a per-chunk Counter
class PacedInputStream inherits InputStream {
    public {
        Mutex state_lock();
        int chunks_emitted = 0;
        int emitter_tid = 0;   # TID that ran read() most recently
    }

    private {
        list<binary> chunks;
        int idx = 0;
        Counter gate;   # decremented by the test to release the next chunk
    }

    #! @param chunks list of binary chunks to emit in order
    #! @param initial_permits how many chunks may emit before the test
    #!                         must call releaseChunk() to unblock the next
    constructor(list<binary> chunks, int initial_permits = 1) {
        self.chunks = chunks;
        # Chunks above initial_permits require a release() to proceed.
        gate = new Counter(chunks.size() - initial_permits);
        if (gate.getCount() < 0) {
            # More initial permits than chunks — no gating at all
            gate = new Counter(0);
        }
    }

    *binary read(int limit) {
        {
            AutoLock al(state_lock);
            emitter_tid = gettid();
        }
        if (idx >= chunks.size()) {
            return NOTHING;
        }
        if (idx >= getPermitCount()) {
            # Wait for the test to release another chunk
            gate.waitForZero(30s);
        }
        binary c = chunks[idx];
        ++idx;
        {
            AutoLock al(state_lock);
            chunks_emitted = idx;
        }
        return c;
    }

    int peek() {
        return idx >= chunks.size() ? -1
            : (chunks[idx].size() > 0 ? chunks[idx][0] : -1);
    }

    #! Releases one more chunk to the reader (test drives pacing)
    releaseChunk() {
        if (gate.getCount() > 0) {
            gate.dec();
        }
    }

    int getChunksEmitted() {
        AutoLock al(state_lock);
        return chunks_emitted;
    }

    int getEmitterTid() {
        AutoLock al(state_lock);
        return emitter_tid;
    }

    private int getPermitCount() {
        # (chunks.size() - gate_count) chunks may emit without a release
        return chunks.size() - gate.getCount();
    }
}

#! Handler: returns a PacedInputStream held by the test via a shared ref
class PacedResponseHandler inherits AbstractHttpRequestHandler {
    public {
        Mutex lock();
        *PacedInputStream m_stream;
        int handler_tid = 0;
    }

    private {
        list<binary> chunks;
        int initial_permits;
    }

    constructor(list<binary> chunks, int initial_permits = 1) {
        self.chunks = chunks;
        self.initial_permits = initial_permits;
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        PacedInputStream local = new PacedInputStream(chunks, initial_permits);
        {
            AutoLock al(lock);
            m_stream = local;
            handler_tid = gettid();
        }
        return makeResponse(200, local, {
            "Content-Type": "application/octet-stream",
        });
    }

    *PacedInputStream getStream() {
        AutoLock al(lock);
        return m_stream;
    }

    int getHandlerTid() {
        AutoLock al(lock);
        return handler_tid;
    }
}

#! InputStream that throws mid-stream after emitting a configurable prefix
class ErrorAfterInputStream inherits InputStream {
    private {
        binary prefix;
        bool emitted = False;
    }

    constructor(binary prefix) {
        self.prefix = prefix;
    }

    *binary read(int limit) {
        if (!emitted) {
            emitted = True;
            return prefix;
        }
        throw "TEST-READ-ERROR", "intentional read error for RST test";
    }

    int peek() {
        return emitted ? -1 : (prefix.size() > 0 ? prefix[0] : -1);
    }
}

class ErrorHandler inherits AbstractHttpRequestHandler {
    private { binary prefix; }
    constructor(binary prefix) { self.prefix = prefix; }
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, new ErrorAfterInputStream(prefix), {
            "Content-Type": "application/octet-stream",
        });
    }
}

