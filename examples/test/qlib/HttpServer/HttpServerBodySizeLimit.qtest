    constructor() : Test("HttpServerBodySizeLimitTest", "1.0") {
        # HTTP/1.1 Content-Length tests
        addTestCase("sync: Content-Length under limit succeeds",
            \syncContentLengthUnderLimitTest());
        addTestCase("sync: Content-Length at limit succeeds",
            \syncContentLengthAtLimitTest());
        addTestCase("sync: Content-Length over limit returns 413",
            \syncContentLengthOverLimitTest());
        addTestCase("sync: chunked body over limit returns error",
            \syncChunkedBodyOverLimitTest());
        addTestCase("sync: zero limit means unlimited",
            \syncZeroLimitUnlimitedTest());
        addTestCase("sync: different HTTP methods enforce limit",
            \syncDifferentMethodsTest());

        # HTTP/1.1 async mode tests
        addTestCase("async: Content-Length over limit returns 413",
            \asyncContentLengthOverLimitTest());
        addTestCase("async: Content-Length under limit succeeds",
            \asyncContentLengthUnderLimitTest());
        addTestCase("async: chunked body over limit returns error",
            \asyncChunkedBodyOverLimitTest());

        # HTTP/2 async tests
        addTestCase("async: HTTP/2 body over limit rejected",
            \asyncHttp2BodyOverLimitTest());
        addTestCase("async: HTTP/2 body under limit succeeds",
            \asyncHttp2BodyUnderLimitTest());
        addTestCase("async: HTTP/2 oversized bodies on one connection get 413",
            \asyncHttp2OversizedBodiesOneConnectionTest());
        addTestCase("async: HTTP/2 streaming handler gets the body-too-large error",
            \asyncHttp2StreamingHandlerLimitTest());
        addTestCase("async: HTTP/2 response before the complete request",
            \asyncHttp2EarlyResponseTest());

        # Server-level configuration tests
        addTestCase("server setMaxRequestBodySize",
            \serverSetMaxRequestBodySizeTest());

        # WebSocket message size limit tests
        addTestCase("WebSocket: message under limit succeeds",
            \wsMessageUnderLimitTest());
        addTestCase("WebSocket: message over limit closes connection",
            \wsMessageOverLimitTest());

        set_return_value(main());
    }

    globalSetUp() {
        mLogger = new Logger("body-size-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            mLogger.addAppender(new StdoutAppender());
        }

        # Server with body size limit
        hash<HttpServerOptionInfo> sync_opts = <HttpServerOptionInfo>{
            "logger": mLogger,
            "debug": True,
            "max_request_body_size": BodySizeLimit,
        };
        mSyncServer = new HttpServer(sync_opts);
        mSyncServer.setHandler("echo", "", NOTHING, new BodyEchoHandler());
        mSyncServer.setDefaultHandler("echo", new BodyEchoHandler());
        mSyncPort = mSyncServer.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        mSyncUrl = "http://localhost:" + mSyncPort;

        # Async server with body size limit
        hash<HttpServerOptionInfo> async_opts = <HttpServerOptionInfo>{
            "logger": mLogger,
            "debug": True,
            "max_request_body_size": BodySizeLimit,
        };
        mAsyncServer = new HttpServer(async_opts);
        mAsyncServer.setHandler("echo", "", NOTHING, new BodyEchoHandler());
        mAsyncServer.setDefaultHandler("echo", new BodyEchoHandler());
        mAsyncPort = mAsyncServer.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        mAsyncUrl = "http://localhost:" + mAsyncPort;

        # Add HTTPS listener for HTTP/2 testing
        mAsyncSslPort = mAsyncServer.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        }).port;
        mAsyncSslUrl = "https://localhost:" + mAsyncSslPort;

        # Add WebSocket handler with message size limit
        mWsHandler = new SizeLimitWsHandler({
            "logger": mLogger,
            "max_message_size": WsMessageSizeLimit,
        });
        mAsyncServer.setHandler("ws-handler", "/ws", NOTHING, mWsHandler);
        mAsyncServer.setHandler("stream-limit", "/stream-limit", NOTHING, mStreamingLimitHandler, NOTHING, False);

        mAsyncServer.waitForAsyncIo();

        # Unlimited server for comparison/zero-limit tests
        hash<HttpServerOptionInfo> unlimited_opts = <HttpServerOptionInfo>{
            "logger": mLogger,
            "debug": True,
        };
        mUnlimitedServer = new HttpServer(unlimited_opts);
        mUnlimitedServer.setHandler("echo", "", NOTHING, new BodyEchoHandler());
        mUnlimitedServer.setDefaultHandler("echo", new BodyEchoHandler());
        mUnlimitedServer.setHandler("early", "/early", NOTHING, new EarlyResponseHandler(), NOTHING, False);
        mUnlimitedPort = mUnlimitedServer.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        mUnlimitedUrl = "http://localhost:" + mUnlimitedPort;
        mUnlimitedSslUrl = "https://localhost:" + mUnlimitedServer.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        }).port;
        mUnlimitedServer.waitForAsyncIo();
    }

    globalTearDown() {
        delete mSyncServer;
        delete mAsyncServer;
        delete mUnlimitedServer;
    }

    private HTTPClient getSyncClient(*int timeout_ms) {
        HTTPClient c({"url": mSyncUrl, "timeout": timeout_ms ?? 5000});
        c.connect();
        return c;
    }

    private HTTPClient getAsyncClient(*int timeout_ms) {
        HTTPClient c({"url": mAsyncUrl, "timeout": timeout_ms ?? 5000});
        c.connect();
        return c;
    }

    #! returns a client for HTTP/2 tests; @p h2_only keeps it on HTTP/2 instead of following the server's Alt-Svc
    #! advertisement to HTTP/3 after the first response
    private HTTPClient getHttp2Client(*int timeout_ms, *string url, *bool h2_only) {
        HTTPClient c({
            "url": url ?? mAsyncSslUrl,
            "ssl_verify_cert": False,
            "timeout": timeout_ms ?? 10000,
        } + (h2_only ? {"http_version": "2.0"} : {}));
        c.connect();
        return c;
    }

    private HTTPClient getUnlimitedClient(*int timeout_ms) {
        HTTPClient c({"url": mUnlimitedUrl, "timeout": timeout_ms ?? 5000});
        c.connect();
        return c;
    }

    # ================================================================
    # Sync HTTP/1.1 Content-Length Tests
    # ================================================================

    #! POST with body smaller than limit should succeed
    syncContentLengthUnderLimitTest() {
        HTTPClient c = getSyncClient();
        on_exit c.disconnect();

        binary body = binary(strmul("A", BodySizeLimit - 1));
        c.setErrorPassthru(True);
        hash<auto> resp = c.send(body, "POST", "/echo", {"Content-Type": "application/octet-stream"});
        assertEq(200, resp.status_code, "body under limit should return 200");
        assertEq(BodySizeLimit - 1, resp.body.size(), "response body size should match request body size");
    }

    #! POST with body exactly at limit should succeed
    syncContentLengthAtLimitTest() {
        HTTPClient c = getSyncClient();
        on_exit c.disconnect();

        binary body = binary(strmul("B", BodySizeLimit));
        c.setErrorPassthru(True);
        hash<auto> resp = c.send(body, "POST", "/echo", {"Content-Type": "application/octet-stream"});
        assertEq(200, resp.status_code, "body at limit should return 200");
        assertEq(BodySizeLimit, resp.body.size(), "response body size should match request body size");
    }

    #! POST with body exceeding limit should return HTTP 413
    syncContentLengthOverLimitTest() {
        HTTPClient c = getSyncClient();
        on_exit c.disconnect();

        binary body = binary(strmul("C", BodySizeLimit + 1));
        c.setErrorPassthru(True);
        hash<auto> resp = c.send(body, "POST", "/echo", {"Content-Type": "application/octet-stream"});
        assertEq(413, resp.status_code, "body over limit should return 413");
    }

    #! Chunked transfer encoding body exceeding limit should return error
    syncChunkedBodyOverLimitTest() {
        # Use a raw socket to send a chunked body that exceeds the limit
        Socket s();
        s.connect("localhost:" + mSyncPort);
        on_exit s.close();

        # Send HTTP request with chunked encoding header
        hash<auto> info;
        s.sendHTTPMessage("POST", "/echo", "1.1", {
            "Host": "localhost:" + mSyncPort,
            "Transfer-Encoding": "chunked",
            "Content-Type": "application/octet-stream",
        }, NOTHING, \info);

        # Send chunks that exceed the body size limit
        # First chunk: 600 bytes
        string chunk1_data = strmul("D", 600);
        s.send(sprintf("%x\r\n", chunk1_data.size()) + chunk1_data + "\r\n");

        # Second chunk: 600 bytes (total exceeds 1024 limit)
        string chunk2_data = strmul("D", 600);
        bool got_error = False;
        try {
            s.send(sprintf("%x\r\n", chunk2_data.size()) + chunk2_data + "\r\n");
            # Send final chunk
            s.send("0\r\n\r\n");

            # Try to read the response
            hash<auto> rh = s.readHTTPHeader(5s);
            if (rh.status_code >= 400) {
                got_error = True;
            }
        } catch (hash<ExceptionInfo> ex) {
            # Connection closed by server - expected behavior
            got_error = True;
        }
        assertTrue(got_error, "chunked body over limit should return error or close connection");
    }

    #! Zero limit (unlimited server) should accept large bodies
    syncZeroLimitUnlimitedTest() {
        HTTPClient c = getUnlimitedClient();
        on_exit c.disconnect();

        # Send a body larger than BodySizeLimit — should succeed since limit is 0 (unlimited)
        binary body = binary(strmul("E", BodySizeLimit * 2));
        c.setErrorPassthru(True);
        hash<auto> resp = c.send(body, "POST", "/echo", {"Content-Type": "application/octet-stream"});
        assertEq(200, resp.status_code, "unlimited server should accept any body size");
        assertEq(BodySizeLimit * 2, resp.body.size(), "response body size should match request body size");
    }

    #! Body size limit should be enforced for PUT and PATCH methods too
    syncDifferentMethodsTest() {
        HTTPClient c = getSyncClient();
        on_exit c.disconnect();

        binary over_limit = binary(strmul("F", BodySizeLimit + 1));
        c.setErrorPassthru(True);

        # PUT should be rejected
        hash<auto> resp = c.send(over_limit, "PUT", "/echo", {"Content-Type": "application/octet-stream"});
        assertEq(413, resp.status_code, "PUT body over limit should return 413");

        # Need a new connection since the server closes after 413
        c.disconnect();
        c.connect();
        c.setErrorPassthru(True);

        # Small body should still succeed after rejection
        binary under_limit = binary(strmul("G", 100));
        resp = c.send(under_limit, "POST", "/echo", {"Content-Type": "application/octet-stream"});
        assertEq(200, resp.status_code, "small body should succeed after rejection");
    }

    # ================================================================
    # Async HTTP/1.1 Tests
    # ================================================================

    #! Async mode: Content-Length over limit returns 413
    asyncContentLengthOverLimitTest() {
        HTTPClient c = getAsyncClient();
        on_exit c.disconnect();

        binary body = binary(strmul("H", BodySizeLimit + 1));
        c.setErrorPassthru(True);
        hash<auto> resp = c.send(body, "POST", "/echo", {"Content-Type": "application/octet-stream"});
        assertEq(413, resp.status_code, "async: body over limit should return 413");
    }

    #! Async mode: Content-Length under limit succeeds
    asyncContentLengthUnderLimitTest() {
        HTTPClient c = getAsyncClient();
        on_exit c.disconnect();

        binary body = binary(strmul("I", BodySizeLimit - 1));
        c.setErrorPassthru(True);
        hash<auto> resp = c.send(body, "POST", "/echo", {"Content-Type": "application/octet-stream"});
        assertEq(200, resp.status_code, "async: body under limit should return 200");
        assertEq(BodySizeLimit - 1, resp.body.size(), "async: response body size should match request body size");
    }

    #! Async mode: Chunked body exceeding limit returns error
    asyncChunkedBodyOverLimitTest() {
        # Use a raw socket to send chunked body in async mode
        Socket s();
        s.connect("localhost:" + mAsyncPort);
        on_exit s.close();

        hash<auto> info;
        s.sendHTTPMessage("POST", "/echo", "1.1", {
            "Host": "localhost:" + mAsyncPort,
            "Transfer-Encoding": "chunked",
            "Content-Type": "application/octet-stream",
        }, NOTHING, \info);

        # Send chunks that exceed the limit
        string chunk1 = strmul("J", 600);
        s.send(sprintf("%x\r\n", chunk1.size()) + chunk1 + "\r\n");

        string chunk2 = strmul("J", 600);
        bool got_error = False;
        try {
            s.send(sprintf("%x\r\n", chunk2.size()) + chunk2 + "\r\n");
            s.send("0\r\n\r\n");

            hash<auto> rh = s.readHTTPHeader(5s);
            if (rh.status_code >= 400) {
                got_error = True;
            }
        } catch (hash<ExceptionInfo> ex) {
            got_error = True;
        }
        assertTrue(got_error, "async: chunked body over limit should return error or close connection");
    }

    # ================================================================
    # HTTP/2 Tests
    # ================================================================

    #! HTTP/2: a body over the limit is answered with 413
    asyncHttp2BodyOverLimitTest() {
        HTTPClient c = getHttp2Client();
        on_exit c.disconnect();

        c.setErrorPassthru(True);

        binary body = binary(strmul("K", BodySizeLimit + 1));
        hash<auto> resp = c.send(body, "POST", "/echo", {"Content-Type": "application/octet-stream"});
        assertEq(413, resp.status_code, "HTTP/2: body over limit should return 413");
        assertTrue(c.isHttp2Active(), "the request was sent with HTTP/2");
    }

    #! HTTP/2: bodies far over the limit are answered with 413, and the connection stays usable
    /** Each body is larger than the flow control window, so it arrives faster than the handler thread reads it; the
        server must answer every request with 413 instead of resetting the stream, and must ask the client to stop
        sending the rest of the body after the response, so the next request on the same connection works.
    */
    asyncHttp2OversizedBodiesOneConnectionTest() {
        HTTPClient c = getHttp2Client(30000, NOTHING, True);
        on_exit c.disconnect();

        c.setErrorPassthru(True);

        binary body = binary(strmul("M", 1024 * 1024));
        for (int i = 0; i < 3; ++i) {
            hash<auto> resp = c.send(body, "POST", "/echo", {"Content-Type": "application/octet-stream"});
            assertEq(413, resp.status_code, sprintf("request %d: body over limit returns 413", i));
            assertTrue(c.isHttp2Active(), sprintf("request %d: sent with HTTP/2", i));
        }

        binary small = binary(strmul("S", BodySizeLimit - 1));
        hash<auto> resp = c.send(small, "POST", "/echo", {"Content-Type": "application/octet-stream"});
        assertEq(200, resp.status_code, "a body under the limit on the same connection succeeds");
        assertEq(small, resp.body, "the body under the limit is echoed");
        assertTrue(c.isHttp2Active(), "the connection is still HTTP/2");
    }

    #! HTTP/2: a body-streaming handler gets an error, not the end of the body, when the body exceeds the limit
    asyncHttp2StreamingHandlerLimitTest() {
        HTTPClient c = getHttp2Client(30000, NOTHING, True);
        on_exit c.disconnect();

        c.setErrorPassthru(True);

        binary body = binary(strmul("T", 1024 * 1024));
        hash<auto> resp = c.send(body, "POST", "/stream-limit", {"Content-Type": "application/octet-stream"});
        assertEq(413, resp.status_code, "the streaming handler answers the oversized body with 413");
        assertTrue(c.isHttp2Active(), "the request was sent with HTTP/2");

        hash<auto> result = mStreamingLimitHandler.results.get(10s);
        assertEq("HTTP-BODY-TOO-LARGE", result.end.err, "the body ends with the body-too-large error");
        assertGt(BodySizeLimit, result.size, "the bytes buffered when the limit was exceeded are delivered first");
        assertLt(body.size(), result.size, "the rest of the body is discarded");

        # a body under the limit ends normally
        binary small = binary(strmul("U", BodySizeLimit - 1));
        resp = c.send(small, "POST", "/stream-limit", {"Content-Type": "application/octet-stream"});
        assertEq(200, resp.status_code, "a body under the limit is read to its end");
        assertEq(string(small.size()), resp.body, "the handler read the whole body");
        result = mStreamingLimitHandler.results.get(10s);
        assertNothing(result.end, "a complete body ends with NOTHING");
        assertEq(small.size(), result.size, "all bytes of the body were delivered");
    }

    #! HTTP/2: a response sent before the complete request reaches the client, and the connection stays usable
    /** The server has no body size limit, and the handler answers without reading the body, so the client is still
        sending when the response is complete; the server asks it to stop with RST_STREAM(NO_ERROR), which the
        client must not treat as an error (RFC 9113 section 8.1).
    */
    asyncHttp2EarlyResponseTest() {
        HTTPClient c = getHttp2Client(30000, mUnlimitedSslUrl, True);
        on_exit c.disconnect();

        c.setErrorPassthru(True);

        binary body = binary(strmul("E", 4 * 1024 * 1024));
        for (int i = 0; i < 3; ++i) {
            hash<auto> resp = c.send(body, "POST", "/early", {"Content-Type": "application/octet-stream"});
            assertEq(401, resp.status_code, sprintf("request %d: the early response is received", i));
            assertEq("early", resp.body, sprintf("request %d: the early response body is received", i));
            assertTrue(c.isHttp2Active(), sprintf("request %d: sent with HTTP/2", i));
        }

        hash<auto> resp = c.send(binary("x"), "POST", "/echo", {"Content-Type": "application/octet-stream"});
        assertEq(200, resp.status_code, "the connection is usable after the early responses");
        assertEq(binary("x"), resp.body, "the body is echoed");
    }

    #! HTTP/2: body under limit should succeed
    asyncHttp2BodyUnderLimitTest() {
        HTTPClient c = getHttp2Client();
        on_exit c.disconnect();

        c.setErrorPassthru(True);

        binary body = binary(strmul("L", BodySizeLimit - 1));
        hash<auto> resp = c.send(body, "POST", "/echo", {"Content-Type": "application/octet-stream"});
        assertEq(200, resp.status_code, "HTTP/2: body under limit should return 200");
        assertEq(BodySizeLimit - 1, resp.body.size(), "HTTP/2: response body size should match request body size");
    }

    # ================================================================
    # Server-level setMaxRequestBodySize Tests
    # ================================================================

    #! Test setMaxRequestBodySize() runtime configuration
    serverSetMaxRequestBodySizeTest() {
        # Create a server without initial limit
        Logger logger("runtime-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }
        hash<HttpServerOptionInfo> opts = <HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        };
        HttpServer srv(opts);
        on_exit delete srv;
        srv.setHandler("echo", "", NOTHING, new BodyEchoHandler());
        srv.setDefaultHandler("echo", new BodyEchoHandler());
        int port = srv.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        string url = "http://localhost:" + port;

        # Verify initial state: no limit
        assertEq(0, srv.getMaxRequestBodySize(), "initial max body size should be 0");

        # Large body should succeed with no limit
        {
            HTTPClient c({"url": url, "timeout": 5s});
            c.connect();
            on_exit c.disconnect();
            c.setErrorPassthru(True);

            binary body = binary(strmul("M", 2048));
            hash<auto> resp = c.send(body, "POST", "/echo", {"Content-Type": "application/octet-stream"});
            assertEq(200, resp.status_code, "no limit: large body should succeed");
        }

        # Set a body size limit at runtime
        srv.setMaxRequestBodySize(512);
        assertEq(512, srv.getMaxRequestBodySize(), "max body size should be 512 after set");

        # Large body should now be rejected
        {
            HTTPClient c({"url": url, "timeout": 5s});
            c.connect();
            on_exit c.disconnect();
            c.setErrorPassthru(True);

            binary body = binary(strmul("N", 513));
            hash<auto> resp = c.send(body, "POST", "/echo", {"Content-Type": "application/octet-stream"});
            assertEq(413, resp.status_code, "after setMaxRequestBodySize: body over limit returns 413");
        }

        # Small body should still succeed
        {
            HTTPClient c({"url": url, "timeout": 5s});
            c.connect();
            on_exit c.disconnect();
            c.setErrorPassthru(True);

            binary body = binary(strmul("O", 512));
            hash<auto> resp = c.send(body, "POST", "/echo", {"Content-Type": "application/octet-stream"});
            assertEq(200, resp.status_code, "after setMaxRequestBodySize: body at limit should succeed");
        }

        # Remove limit
        srv.setMaxRequestBodySize(0);
        assertEq(0, srv.getMaxRequestBodySize(), "max body size should be 0 after reset");

        # Large body should succeed again
        {
            HTTPClient c({"url": url, "timeout": 5s});
            c.connect();
            on_exit c.disconnect();
            c.setErrorPassthru(True);

            binary body = binary(strmul("P", 2048));
            hash<auto> resp = c.send(body, "POST", "/echo", {"Content-Type": "application/octet-stream"});
            assertEq(200, resp.status_code, "after removing limit: large body should succeed again");
        }
    }

    # ================================================================
    # WebSocket Message Size Limit Tests
    # ================================================================

    #! WebSocket: message smaller than limit should be received and echoed
    wsMessageUnderLimitTest() {
        Counter msg_cnt(1);
        *string received_msg;

        WebSocketClient wsc(sub (*data msg) {
            if (exists msg) {
                received_msg = msg.typeCode() == NT_BINARY ? msg.toString() : msg;
                if (msg_cnt.getCount()) {
                    msg_cnt.dec();
                }
            }
        }, {
            "url": "wss://localhost:" + mAsyncSslPort + "/ws",
            "logger": mLogger,
            "ssl_verify_cert": False,
            "timeout": 10s,
        });
        on_exit delete wsc;

        wsc.connect();

        # Send a small message (under limit)
        string small_msg = strmul("Q", WsMessageSizeLimit - 10);
        wsc.send(small_msg);

        # Wait for echo response
        msg_cnt.waitForZero(5s);
        assertEq("ECHO:" + small_msg, received_msg,
            "WebSocket: message under limit should be echoed");
    }

    #! WebSocket: oversized message should trigger close with code 1009
    wsMessageOverLimitTest() {
        *int close_code;

        # Use a raw socket to send the oversized WebSocket frame
        # WebSocketClient may not let us send oversized messages easily
        Socket s();
        s.connectSSL("localhost:" + mAsyncSslPort);

        # Perform WebSocket upgrade handshake
        string ws_key = get_random_string(16).toBase64();
        hash<auto> hdr = {
            "Host": "localhost:" + mAsyncSslPort,
            "Upgrade": "websocket",
            "Connection": "Upgrade",
            "Sec-WebSocket-Key": ws_key,
            "Sec-WebSocket-Version": "13",
        };

        hash<auto> info;
        s.sendHTTPMessage("GET", "/ws", "1.1", hdr, NOTHING, \info);
        hash<auto> rh = s.readHTTPHeader(5s);
        assertEq(101, rh.status_code, "WebSocket handshake should succeed");

        # Send an oversized text frame
        string large_msg = strmul("R", WsMessageSizeLimit + 100);
        s.send(ws_encode_message(large_msg, WSOP_Text, True));

        # Read the server's close frame response
        bool got_response = False;
        try {
            hash<WsMsgInfo> h = ws_read_message(s, 5s);
            if (h.op == WSOP_Close) {
                got_response = True;
                close_code = h.close;
            }
        } catch (hash<ExceptionInfo> ex) {
            # Connection may be closed
            got_response = True;
        }

        assertTrue(got_response, "WebSocket: server should respond to oversized message");
        if (exists close_code) {
            assertEq(WSCC_MessageTooBig, close_code,
                "WebSocket: close code should be 1009 (Message Too Big)");
        }
    }
}
