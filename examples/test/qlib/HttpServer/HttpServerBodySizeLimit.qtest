    Tests for HTTP request body size enforcement:
    - Content-Length pre-check (HTTP/1.1)
    - Chunked transfer encoding body size limit (HTTP/1.1)
    - HTTP/2 DATA frame body size limit
    - WebSocket message size limit
    - Server-level and listener-level configuration
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Mime
%requires Logger
%requires HttpServerUtil
%requires HttpServerAsyncIo
%requires HttpServer
%requires WebSocketUtil
%requires WebSocketHandler
%requires WebSocketClient

%exec-class HttpServerBodySizeLimitTest

#! Echo handler: returns request body as-is
class BodyEchoHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        if (body) {
            return makeResponse(200, body, {"Content-Type": "application/octet-stream"});
        }
        return makeResponse(200, "no-body", {"Content-Type": "text/plain"});
    }
}

#! HTTP/2 body-streaming handler that reads the body through the body queue and reports how the body ended
class StreamingLimitHandler inherits AbstractHttpRequestHandler {
    public {
        #! receives one hash per request: the byte count read and the value that ended the body
        Queue results();
    }

    bool wantsBodyStreaming(hash<auto> cx, hash<auto> hdr) {
        return True;
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        Queue body_queue(-1);
        cx."header-info".register_body_queue(body_queue);
        int size = 0;
        while (True) {
            auto chunk = body_queue.get(30s);
            if (!(chunk instanceof binary)) {
                results.push({"size": size, "end": chunk});
                if (chunk.typeCode() == NT_HASH) {
                    return makeResponse(413, chunk.desc);
                }
                return makeResponse(200, sprintf("%d", size));
            }
            size += chunk.size();
        }
    }
}

#! HTTP/2 body-streaming handler that answers without reading the request body
class EarlyResponseHandler inherits AbstractHttpRequestHandler {
    bool wantsBodyStreaming(hash<auto> cx, hash<auto> hdr) {
        return True;
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(401, "early", {"Content-Type": "text/plain"});
    }
}

#! WebSocket connection that echoes messages back
class EchoWsConnection inherits WebSocketConnection {
    constructor(WebSocketHandler handler) : WebSocketConnection(handler) {
    }

    gotMessage(string msg) {
        send("ECHO:" + msg);
    }

    gotMessage(binary msg) {
        send(msg);
    }
}

#! WebSocket handler for size limit tests
class SizeLimitWsHandler inherits WebSocketHandler {
    public {
        Queue errs();
    }

    constructor(*hash<auto> opts) : WebSocketHandler(NOTHING, opts) {
    }

    WebSocketConnection getConnectionImpl(hash<auto> cx, hash<auto> hdr, string cid) {
        return new EchoWsConnection(self);
    }

    logError(string fmt) {
        errs.push(vsprintf(fmt, argv));
        logArgs(LoggerLevel::ERROR, fmt, argv);
    }
}

class HttpServerBodySizeLimitTest inherits QUnit::Test {
    private {
        # Server with body size limit
        HttpServer mSyncServer;
        int mSyncPort;
        string mSyncUrl;

        # Async server with body size limit
        HttpServer mAsyncServer;
        int mAsyncPort;
        string mAsyncUrl;

        # Async HTTPS server for HTTP/2 tests
        int mAsyncSslPort;
        string mAsyncSslUrl;

        # WebSocket handler with message size limit
        SizeLimitWsHandler mWsHandler;

        # Server with no body size limit (for comparison)
        HttpServer mUnlimitedServer;
        int mUnlimitedPort;
        string mUnlimitedUrl;
        # HTTPS listener on the unlimited server for HTTP/2 tests
        string mUnlimitedSslUrl;

        # HTTP/2 body-streaming handler on the limited server
        StreamingLimitHandler mStreamingLimitHandler();

        Logger mLogger;

        # Body size limit for tests (1024 bytes)
        const BodySizeLimit = 1024;

        # WebSocket message size limit (512 bytes)
        const WsMessageSizeLimit = 512;

