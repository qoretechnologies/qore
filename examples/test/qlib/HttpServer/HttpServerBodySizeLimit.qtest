%modern

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Mime.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/HttpServerUtil.qm
%requires ../../../../qlib/HttpServerAsyncIo
%requires ../../../../qlib/HttpServer.qm
%requires ../../../../qlib/WebSocketUtil.qm
%requires ../../../../qlib/WebSocketHandler.qm
%requires ../../../../qlib/WebSocketClient.qm

%exec-class HttpServerBodySizeLimitTest

#! Echo handler: returns request body as-is
class BodyEchoHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        if (body) {
            return makeResponse(200, body, {"Content-Type": "application/octet-stream"});
        }
        return makeResponse(200, "no-body", {"Content-Type": "text/plain"});
    }
}

#! WebSocket connection that echoes messages back
class EchoWsConnection inherits WebSocketConnection {
    constructor(WebSocketHandler handler) : WebSocketConnection(handler) {
    }

    gotMessage(string msg) {
        send("ECHO:" + msg);
    }

    gotMessage(binary msg) {
        send(msg);
    }
}

#! WebSocket handler for size limit tests
class SizeLimitWsHandler inherits WebSocketHandler {
    public {
        Queue errs();
    }

    constructor(*hash<auto> opts) : WebSocketHandler(NOTHING, opts) {
    }

    WebSocketConnection getConnectionImpl(hash<auto> cx, hash<auto> hdr, string cid) {
        return new EchoWsConnection(self);
    }

    logError(string fmt) {
        errs.push(vsprintf(fmt, argv));
        logArgs(LoggerLevel::ERROR, fmt, argv);
    }
}

class HttpServerBodySizeLimitTest inherits QUnit::Test {
    private {
        # Server with body size limit
        HttpServer mSyncServer;
        int mSyncPort;
        string mSyncUrl;

        # Async server with body size limit
        HttpServer mAsyncServer;
        int mAsyncPort;
        string mAsyncUrl;

        # Async HTTPS server for HTTP/2 tests
        int mAsyncSslPort;
        string mAsyncSslUrl;

        # WebSocket handler with message size limit
        SizeLimitWsHandler mWsHandler;

        # Server with no body size limit (for comparison)
        HttpServer mUnlimitedServer;
        int mUnlimitedPort;
        string mUnlimitedUrl;

        Logger mLogger;

        # Body size limit for tests (1024 bytes)
        const BodySizeLimit = 1024;

        # WebSocket message size limit (512 bytes)
        const WsMessageSizeLimit = 512;

