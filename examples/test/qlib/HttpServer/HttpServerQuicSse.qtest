    SSE over HTTP/3 tests.

    Tests cover:
    - SSE connection over HTTP/3 — verify events received
    - Multiple SSE events over HTTP/3 — verify ordering
    - SSE with event types over HTTP/3
*/

%modern

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Mime.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/HttpServerUtil.qm
%requires ../../../../qlib/AsyncSocketIo
%requires ../../../../qlib/HttpServerAsyncIo
%requires ../../../../qlib/HttpServer.qm
%requires ../../../../qlib/Http3ClientIo

%exec-class HttpServerQuicSseTest

#! SSE handler that sends events directly via HTTP/3 QUIC streaming APIs
/** Overrides the 5-arg handleRequest() to get the socket for QUIC API access.
    For HTTP/3 requests, sends SSE headers and events directly via
    submitQuicResponseStreaming() and submitQuicStreamData(), then returns
    reply_sent + streaming to signal the controller.
*/
class SseHandler inherits AbstractHttpRequestHandler {
    private {
        #! Counter to signal when events have been sent
        Counter event_sent_counter;
    }

    constructor(Counter event_sent_counter) {
        self.event_sent_counter = event_sent_counter;
    }

    #! Override the 5-arg version to get the socket for HTTP/3 QUIC API access
    hash<HttpResponseInfo> handleRequest(HttpListenerInterface listener, Socket s,
            hash<auto> cx, hash<auto> hdr, *data body) {
        if (hdr.method == "GET" && hdr.path == "sse") {
            if (cx."header-info".http3) {
                return handleHttp3Sse(s, cx);
            }
            # For HTTP/2, return SSE response with content-type
            return makeResponse(200, "data: not-implemented\n\n",
                {"Content-Type": "text/event-stream"});
        }
        return makeResponse(404, "Not Found", {"Content-Type": MimeTypeText});
    }

    private hash<HttpResponseInfo> handleHttp3Sse(Socket s, hash<auto> cx) {
        int session_id = cx."header-info".session_id;
        int stream_id = cx."header-info".stream_id;

        # Get wake callback from the async I/O controller
        *code<nothing()> wake;
        *AsyncSocketIo::AsyncSocketIoController ctrl = cx.async_ctrl;
        if (ctrl) {
            wake = \ctrl.wake();
        }

        # Create HTTP/3 SSE stream using the listener socket
        Http3SseStream sse_stream(s, session_id, stream_id, wake);

        # Send response headers
        sse_stream.sendHeaders();

        # Send 3 test events
        sse_stream.sendEvent({"data": "event-1"});
        sse_stream.sendEvent({"type": "custom", "data": "event-2", "id": "2"});
        sse_stream.sendEvent({"data": "event-3"});

        # Close the stream (sends END_STREAM)
        sse_stream.close();

        # Signal that events were sent
        event_sent_counter.dec();

        # Return streaming + reply_sent — controller will just wake and continue
        return cast<hash<HttpResponseInfo>>({
            "code": 200,
            "reply_sent": True,
            "streaming": True,
            "stream_type": "sse",
        });
    }
}

