    constructor() : Test("HttpServerQuicSseTest", "1.0") {
        @debug {
            set_signal_handler(SIGUSR1, sub (int sig) {
                printf("=== SIGUSR1 Thread Stacks ===\n%Y\n=== End Thread Stacks ===\n",
                    get_all_thread_call_stacks());
            });
        }

        addTestCase("SSE events over HTTP/3", \testH3SseEvents());

        set_return_value(main());
    }

    globalSetUp() {
        mLogger = new Logger("quic-sse-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            mLogger.addAppender(new StdoutAppender());
        }
    }

    #! Test SSE events over HTTP/3
    testH3SseEvents() {
        Counter event_sent(1);
        SseHandler handler(event_sent);

        HttpServer server(<HttpServerOptionInfo>{
            "logger": mLogger,
            "debug": True,
            "async_mode": True,
        });
        on_exit delete server;

        server.setHandler("sse", "/sse", NOTHING, handler);
        server.waitForAsyncIo();

        hash<auto> h3info = server.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
            "enable_h3": True,
        });
        server.waitForAsyncIo();
        string h3_url = "https://localhost:" + h3info.port;

        # Use Http3ClientConnectionManager for HTTP/3 requests
        Http3ClientIo::Http3ClientConnectionManager mgr(
            <Http3ClientIo::Http3ClientConnectionManagerOptions>{
                "logger": mLogger,
                "request_timeout": 30s,
                "connect_timeout": 15s,
            },
        );
        on_exit delete mgr;

        # Make the SSE request over HTTP/3
        hash<auto> resp = mgr.request(h3_url, "GET", "/sse");

        # Wait for handler to finish sending events
        int rv = event_sent.waitForZero(30s);
        assertEq(0, rv, "handler should have completed sending SSE events");

        assertEq(200, resp.status_code, "SSE response should be 200 OK");

        # The response body should contain all 3 SSE events
        string body;
        if (resp.body.typeCode() == NT_BINARY) {
            body = binary_to_string(resp.body);
        } else {
            body = resp.body;
        }

        @debug(printf("SSE response body: %y\n", body));

        # Verify events are present in the response
        assertTrue(body.find("data: event-1") >= 0,
            "should contain first event");
        assertTrue(body.find("event: custom") >= 0,
            "should contain custom event type");
        assertTrue(body.find("data: event-2") >= 0,
            "should contain second event data");
        assertTrue(body.find("id: 2") >= 0,
            "should contain event ID");
        assertTrue(body.find("data: event-3") >= 0,
            "should contain third event");
    }
}
