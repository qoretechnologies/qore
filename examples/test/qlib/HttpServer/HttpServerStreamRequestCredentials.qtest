    constructor() : Test("HttpServerStreamRequestCredentials", "1.0") {
        addTestCase("concurrent HTTP/2 streams of one connection", \testConcurrentStreams(), "h2");
        addTestCase("concurrent HTTP/3 streams of one connection", \testConcurrentStreams(), "h3");
        addTestCase("filterRequest() options", \testFilterOptions());
        addTestCase("each request gets its own raw request only", \testLifetime());
        set_return_value(main());
    }

    testConcurrentStreams(string proto) {
        Program tenant(TenantOpts);
        tenant.setSandboxManager(new SandboxManager());
        tenant.parse("string sub seen(hash<auto> cx, hash<auto> hdr) {
    list<string> found = map $1, ('authorization', 'cookie'), hdr.hasKey($1) || cx.hdr.hasKey($1)
        || ((map $1.lwr(), keys cx.'header-info'.'headers-raw') ?? ()).contains($1);
    return found ? found.join(',') : 'none';
}", "tenant");

        TrustedStreamHandler handler(tenant, 2);
        HttpServer server(<HttpServerOptionInfo>{"debug": True});
        on_exit delete server;
        server.setHandler("stream", "/stream", NOTHING, handler);
        server.waitForAsyncIo();

        string url;
        if (proto == "h3") {
            try {
                int port = server.addQuicListener(<HttpListenerOptionInfo>{
                    "cert": new SSLCertificate(CertPem),
                    "key": new SSLPrivateKey(KeyPem),
                }).port;
                url = sprintf("https://127.0.0.1:%d", port);
            } catch (hash<ExceptionInfo> ex) {
                testSkip(sprintf("QUIC listener not available: %s: %s", ex.err, ex.desc));
            }
        } else {
            int port = server.addListener(<HttpListenerOptionInfo>{
                "node": "127.0.0.1",
                "service": 0,
                "cert": new SSLCertificate(CertPem),
                "key": new SSLPrivateKey(KeyPem),
                "enable_h3": False,
            }).port;
            url = sprintf("https://127.0.0.1:%d", port);
        }
        server.waitForAsyncIo();

        # one connection with two streams
        HttpClientIo::HttpClientConnectionManager mgr(<HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": proto,
            "max_connections_per_host": 1,
        });
        on_exit delete mgr;
        list<HttpClientIo::HttpClientStreamHandle> streams = (mgr.acquireStream(url), mgr.acquireStream(url));

        hash<string, string> results = {};
        Counter done(2);
        foreach int i in (0, 1) {
            # the values of this iteration for the closure
            int n = i;
            HttpClientIo::HttpClientStreamHandle stream = streams[n];
            string token = sprintf("Bearer stream-%d", n);
            background sub () {
                on_exit done.dec();
                try {
                    hash<auto> resp = stream.request("POST", "/stream", {
                        "Content-Type": MimeTypeText,
                        "Authorization": token,
                        "Cookie": "session=secret-" + n,
                    }, "body", 30s);
                    results{n} = resp.body.typeCode() == NT_BINARY ? binary_to_string(resp.body) : resp.body;
                } catch (hash<ExceptionInfo> ex) {
                    results{n} = sprintf("%s: %s", ex.err, ex.desc);
                }
            }();
        }
        assertEq(0, done.waitForZero(60s), proto + ": both requests end");
        if (m_options.verbose > 2) {
            printf("%s: %y\n", proto, results);
        }
        assertEq(1, mgr.getStats().total_connections, proto + ": the streams share one connection");
        # each stream's trusted code got its own raw request, and the tenant's code got no credential
        assertEq("raw=Bearer stream-0;tenant=none", results."0", proto + ": stream 0");
        assertEq("raw=Bearer stream-1;tenant=none", results."1", proto + ": stream 1");
    }

    testLifetime() {
        Program tenant(TenantOpts);
        tenant.setSandboxManager(new SandboxManager());
        tenant.loadModule("HttpServerUtil");
        tenant.parse(LifetimeTenant, "tenant");
        HttpServer server(<HttpServerOptionInfo>{"debug": True});
        on_exit delete server;
        server.setHandler("tenant", ".*", NOTHING, new TenantFactoryHandler(tenant));
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        server.waitForAsyncIo();

        # requests whose tenant code fails, a client that disconnects while the response is sent, and normal
        # requests in between: each request's code gets its own raw request only, on whichever thread serves it
        int n = 0;
        foreach string path in (("/normal", "/factory-error", "/normal", "/ctor-error", "/normal", "/send-error",
                "/normal")) {
            string auth = sprintf("Basic %s", make_base64_string(sprintf("user%d:pass", ++n)));
            HTTPClient client({"url": "http://127.0.0.1:" + port});
            on_exit client.disconnect();
            try {
                string body = client.send("body", "POST", path, {
                    "Authorization": auth,
                    "X-Expected-Authorization": auth,
                    "Cookie": "session=" + n,
                }).body;
                assertEq("/normal", path, "only the normal requests succeed");
                assertEq("request-key=False authorization=False cookie=False", body, path + " " + n);
            } catch (hash<ExceptionInfo> ex) {
                assertNeq("/normal", path, sprintf("%s %d: %s: %s: %y", path, n, ex.err, ex.desc, ex.arg.body));
            }
        }
        {
            Socket s();
            s.connect("127.0.0.1:" + port);
            s.send("POST /endless HTTP/1.1\r\nHost: x\r\nAuthorization: Basic dGVzdDp0ZXN0\r\n"
                "X-Expected-Authorization: Basic dGVzdDp0ZXN0\r\nContent-Length: 4\r\n\r\nbody");
            # the response has started
            s.recvBinary(1024, 10s);
            s.close();
        }
        # and a request after it
        {
            HTTPClient client({"url": "http://127.0.0.1:" + port});
            on_exit client.disconnect();
            assertEq("request-key=False authorization=False cookie=False", client.send("body", "POST", "/normal", {
                "Authorization": "Basic bGFzdDpsYXN0",
                "X-Expected-Authorization": "Basic bGFzdDpsYXN0",
            }).body, "after the disconnect");
        }
        # every request has ended: the server's stop waits for them
        server.stop();
    }

    testFilterOptions() {
        hash<auto> hdr = {
            "method": "GET",
            "path": "api/x?token=t1&a=1&ApiKey=k#frag",
            "Authorization": "Basic dGVzdDp0ZXN0",
            "cookie": "session=s",
            "proxy-authorization": "Basic cA==",
            "x-api-key": "secret",
            "accept": "*/*",
        };
        hash<auto> cx = {
            "id": 1,
            "hdr": hdr,
            "orig_path": "/api/x?token=t1&a=1",
            "raw_path": "/api/x?token=t1&a=1",
            "auth": "Basic dGVzdDp0ZXN0",
            "socket-info": {"fd": 3},
            "uctx": {"x": 1},
            "user": "u",
            "peer-info": {"address": "127.0.0.1", "address_desc": "localhost", "port": 1234, "family": 2,
                "familystr": "ipv4", "hostname": "h", "hostname_desc": "h"},
            "url": {"path": "http://user:pw@host/api/x?token=t1&a=1"},
            "header-info": {"request-uri": "http://user:pw@host/api/x?token=t1&a=1", "body": "b"},
        };

        # the default: every credential is withheld
        hash<HttpFilteredRequestInfo> f = AbstractStreamRequest::filterRequest(cx, hdr);
        # a header field that is not in the list of credentials is given unless the platform names it
        assertEq(("accept", "method", "path", "x-api-key"), sort(keys f.hdr));
        # the server's objects are withheld
        assertEq(("hdr", "header-info", "id", "orig_path", "peer-info", "raw_path", "url", "user"), sort(keys f.cx));
        assertEq(("address", "address_desc", "family", "familystr", "port"), sort(keys f.cx."peer-info"));
        assertEq("http://host/api/x?token=t1&a=1", f.cx.url.path);
        assertEq("http://host/api/x?token=t1&a=1", f.cx."header-info"."request-uri");
        assertEq(("authorization", "cookie", "proxy-authorization", "url-userinfo"), sort(f.withheld));

        # the platform's own credentials and query parameters
        f = AbstractStreamRequest::filterRequest(cx, hdr, <HttpRequestFilterOptions>{
            "platform_headers": "X-Api-Key",
            "platform_query_params": ("token", "apikey"),
        });
        assertEq(("accept", "method", "path"), sort(keys f.hdr));
        assertEq("api/x?a=1#frag", f.hdr.path);
        assertEq("/api/x?a=1", f.cx.orig_path);
        assertEq("/api/x?a=1", f.cx.raw_path);
        assertEq("http://host/api/x?a=1", f.cx.url.path);
        assertEq(("authorization", "cookie", "proxy-authorization", "query:apikey", "query:token", "url-userinfo",
            "x-api-key"), sort(f.withheld));

        # a handler's own Authorization only if the platform did not authenticate the request
        f = AbstractStreamRequest::filterRequest(cx, hdr, <HttpRequestFilterOptions>{
            "own_headers": ("authorization", "cookie", "x-api-key"),
        });
        assertFalse(f.hdr.hasKey("Authorization"), "platform authenticated");
        f = AbstractStreamRequest::filterRequest(cx, hdr, <HttpRequestFilterOptions>{
            "own_headers": ("Authorization", "cookie", "proxy-authorization"),
            "platform_authenticated": False,
        });
        assertEq("Basic dGVzdDp0ZXN0", f.hdr.Authorization);
        # the cookies and the proxy's credentials are withheld all the same
        assertFalse(f.hdr.hasKey("cookie"));
        assertFalse(f.hdr.hasKey("proxy-authorization"));
        # not one that the platform consumed
        f = AbstractStreamRequest::filterRequest(cx, hdr, <HttpRequestFilterOptions>{
            "own_headers": "authorization",
            "platform_headers": "authorization",
            "platform_authenticated": False,
        });
        assertFalse(f.hdr.hasKey("Authorization"), "consumed by the platform");
    }
}
