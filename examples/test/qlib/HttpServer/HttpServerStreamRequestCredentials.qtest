    Software is furnished to do so, subject to the following conditions:

    The above copyright notice and this permission notice shall be included in
    all copies or substantial portions of the Software.

    THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
    IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
    FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
    AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
    LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
    FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
    DEALINGS IN THE SOFTWARE.

    The code that serves a stream request gets the request without the credentials of the request, and the trusted
    code of the request handler gets the raw request of each request with getRawRequest(), also for the
    concurrent streams of one HTTP/2 or HTTP/3 connection, which share the connection's ID (qore#6843); and the
    options of AbstractStreamRequest::filterRequest()
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Mime
%requires Logger
%requires HttpServerUtil
%requires AsyncSocketIo
%requires HttpServerAsyncIo
%requires HttpServer
%requires HttpClientIo

%exec-class HttpServerStreamRequestCredentialsTest

#! the stream request of the trusted handler: its response gives what the trusted code and the tenant's code got
class ReportRequest inherits AbstractStreamRequest {
    private {
        string report;
        bool sent;
    }

    constructor(HttpListenerInterface listener, AbstractHttpRequestHandler handler, Socket s, hash<auto> cx,
            hash<auto> hdr, auto body, string report) : AbstractStreamRequest(listener, handler, s, cx, hdr, body) {
        self.report = report;
    }

    private hash<HttpResponseInfo> getResponseHeaderMessageImpl() {
        return <HttpResponseInfo>{
            "code": 200,
            "hdr": {"Content-Type": MimeTypeText},
            "body": report,
        };
    }
}

#! a stream handler of the host that hands each request to a tenant's code after a barrier of all the streams
class TrustedStreamHandler inherits AbstractHttpRequestHandler {
    private {
        Program tenant;
        Counter barrier;
    }

    constructor(Program tenant, int streams) : AbstractHttpRequestHandler(NOTHING, True) {
        self.tenant = tenant;
        barrier = new Counter(streams);
    }

    private AbstractStreamRequest getStreamRequestImpl(HttpListenerInterface listener, Socket s, hash<auto> cx,
            hash<auto> hdr, *data body) {
        # every stream is in this method at once before any of them reads its raw request
        barrier.dec();
        if (barrier.waitForZero(30s)) {
            throw "TEST-ERROR", "the streams did not reach the handler together";
        }
        hash<auto> raw = getRawRequest();
        string tenant_seen = tenant.callFunction("seen", cx, hdr);
        string report = sprintf("raw=%s;tenant=%s", raw.hdr.authorization ?? "-", tenant_seen);
        return new ReportRequest(listener, self, s, cx, hdr, body, report);
    }
}

#! a stream handler of the host that hands each request to a tenant's factory, which can fail
class TenantFactoryHandler inherits AbstractHttpRequestHandler {
    private {
        Program tenant;
    }

    constructor(Program tenant) : AbstractHttpRequestHandler(NOTHING, True) {
        self.tenant = tenant;
    }

    private AbstractStreamRequest getStreamRequestImpl(HttpListenerInterface listener, Socket s, hash<auto> cx,
            hash<auto> hdr, *data body) {
        # the trusted code gets the raw request of this request only
        if (getRawRequest().hdr.authorization != hdr."x-expected-authorization") {
            throw "TEST-ERROR", "the raw request is not the request being served";
        }
        return tenant.callFunction("make", listener, self, s, cx, hdr, body);
    }
}

#! the tenant's stream requests: the request path selects what it does
const LifetimeTenant = "
class TS inherits HttpServer::AbstractStreamRequest {
    private:internal {
        string mode;
        string key;
        int sent;
    }

    constructor(HttpServer::HttpListenerInterface listener, HttpServer::AbstractHttpRequestHandler handler,
            Qore::Socket s, hash<auto> cx, hash<auto> hdr, auto body)
            : HttpServer::AbstractStreamRequest(listener, handler, s, cx, hdr, body) {
        mode = cx.orig_path;
        # what the tenant got: no reference to the raw request, no credential
        key = sprintf('request-key=%y authorization=%y cookie=%y', cx.hasKey('request-key'),
            cx.hdr.hasKey('authorization'), cx.hdr.hasKey('cookie'));
        if (mode == '/ctor-error') {
            throw 'TENANT-ERROR', 'the constructor fails';
        }
    }

    private hash<HttpServer::HttpResponseInfo> getResponseHeaderMessageImpl() {
        return <HttpServer::HttpResponseInfo>{
            'code': 200,
            'hdr': {'Content-Type': 'text/plain', 'Transfer-Encoding': 'chunked'},
        };
    }

    private auto sendImpl() {
        if (mode == '/send-error') {
            throw 'TENANT-ERROR', 'sending fails';
        }
        # the response of a disconnected client never ends: the server ends it when it cannot send
        if (mode == '/endless') {
            ++sent;
            return strmul('x', 65536);
        }
        if (sent++) {
            return;
        }
        return key;
    }
}

HttpServer::AbstractStreamRequest sub make(HttpServer::HttpListenerInterface listener,
        HttpServer::AbstractHttpRequestHandler handler, Qore::Socket s, hash<auto> cx, hash<auto> hdr, auto body) {
    if (cx.orig_path == '/factory-error') {
        throw 'TENANT-ERROR', 'the factory fails';
    }
    return new TS(listener, handler, s, cx, hdr, body);
}
";

const TenantOpts = PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES | PO_STRONG_ENCAPSULATION;

