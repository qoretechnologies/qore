#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires HttpServer
%requires HttpServerUtil

%exec-class HttpServerFastRequestDifferentialTest

#! records what the normal parser made of a request
class RecordingHandler inherits AbstractHttpRequestHandler {
    public {
        Queue q();
    }

    hash<HttpResponseInfo> handleRequest(HttpListenerInterface listener, Socket s, hash<auto> cx, hash<auto> hdr,
            *data body) {
        if (cx.raw_path != "/warm") {
            q.push({"method": hdr.method, "path": cx.raw_path, "hdr": hdr});
        }
        return <HttpResponseInfo>{"code": 200, "body": "handler", "hdr": {"Content-Type": "text/plain"}};
    }
}

#! Differential test of the strict request parser of the HTTP server fast routes
/** A server with a fast route for \c /p and a server with the same handler and no routes receive the same bytes.
    The safety rule of the strict parser (see design/http-server-fast-routes.md, phase 1.5) is that it never accepts
    what the normal parser rejects or reads differently: whenever the route answers a request, the server without
    routes must accept the same bytes, with the same method and path and with headers that decide the same thing.
    The requests are a fixed list of corner cases and seeded random mutations of a valid request.  Each request is the
    second on its connection, and then the first one (the first request of a plain TCP connection is read by the same
    operation).  The requests to the server with the route are followed by the end of the client's stream (a
    half-close, Socket::shutdownWrite()), so a request that the server does not answer (an incomplete one, or one that
    waits for a body) ends with the server closing the connection instead of a wait for a timeout.
*/
class HttpServerFastRequestDifferentialTest inherits QUnit::Test {
    public {
        const Timeout = 30s;

        const Mutations = 400;
        const Seed = 20260101;
    }

    private {
        HttpServer fast_hs();
        HttpServer plain_hs();
        RecordingHandler fast_handler();
        RecordingHandler plain_handler();
        int fast_port;
        int plain_port;

        #! true if a request is sent as the second one of its connection (after a request for /warm), false for the
        #! first one
        bool second = True;
    }

    constructor() : QUnit::Test("HttpServerFastRequestDifferentialTest", "1.0", \ARGV) {
        addTestCase("fixed requests", \testFixed());
        addTestCase("random mutations", \testMutations());
        addTestCase("random mutations of a HEAD request", \testMutationsHead());
        addTestCase("fixed requests as the first request of a connection", \testFixedFirst());
        addTestCase("random mutations as the first request of a connection", \testMutationsFirst());
        set_return_value(main());
    }

    globalSetUp() {
        fast_hs.setDefaultHandler("handler", fast_handler);
        plain_hs.setDefaultHandler("handler", plain_handler);
        fast_hs.addFastRoute("/p", {"public": True, "response": {"code": 200, "body": "fast",
            "content_type": "text/plain"}});
        fast_port = fast_hs.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        plain_port = plain_hs.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
    }

    globalTearDown() {
        fast_hs.stop();
        plain_hs.stop();
    }

    #! sends raw bytes as the second request of a connection and returns the status code and body of the answer
    /** @param half_close if @ref True "True", the client's stream ends after the request (a half-close), so the server
        answers a complete request and closes the connection of a request that it cannot answer (an incomplete one, or
        one that waits for a body), which has the status 0, as one that the server answers by closing the connection
    */
    private hash<auto> exchange(int port, string raw, bool half_close) {
        Socket c();
        c.connect("127.0.0.1:" + port);
        on_exit c.close();
        hash<auto> h;
        if (second) {
            c.send("GET /warm HTTP/1.1\r\nHost: x\r\n\r\n");
            h = c.readHTTPHeader(Timeout);
            c.recv(h."content-length".toInt(), Timeout);
        }
        c.send(raw);
        if (half_close) {
            c.shutdownWrite();
        }
        try {
            h = c.readHTTPHeader(Timeout);
            int len = (h."content-length" ?? 0).toInt();
            # the response to a HEAD request has a Content-Length and no body
            bool head = raw.find("HEAD ") == 0;
            return {"status": h.status_code, "body": len && !head ? c.recv(len, Timeout) : "", "length": len,
                "head": head};
        } catch (hash<ExceptionInfo> ex) {
            # the connection was closed or reset by the server (a rejected or unanswered request)
            return {"status": 0, "body": ""};
        }
    }

    #! returns True if the route answered
    private bool isFast(hash<auto> response) {
        return response.status == 200 && (response.body == "fast" || (response.head && response.length == 4));
    }

    #! checks one request: if the route answers it, the normal path must read it the same way
    private bool check(string raw, string desc) {
        # a route answers only a request with a complete header; the server cannot answer one without the empty line, so
        # there is nothing to compare and nothing to wait for
        if (raw !~ /\r\n\r\n/) {
            return False;
        }
        if (!isFast(exchange(fast_port, raw, True))) {
            return False;
        }
        hash<auto> plain = exchange(plain_port, raw, False);
        assertTrue(plain.status == 200 && (plain.body == "handler" || plain.head),
            sprintf("%s: the route answered, but the normal path did not accept %y: %y", desc, raw, plain));
        hash<auto> rec = plain_handler.q.get(Timeout);
        assertEq(raw.find("HEAD ") == 0 ? "HEAD" : "GET", rec.method, desc);
        # the target is "/p" followed by an optional query string
        assertTrue(rec.path == "/p" || rec.path =~ /^\/p\?/, sprintf("%s: path %y of %y", desc, rec.path, raw));
        # the headers that decide the framing and the connection are read the same way
        hash<auto> h = rec.hdr;
        assertTrue(!exists h."content-length" || h."content-length" == "0" || h."content-length" == 0,
            sprintf("%s: content-length %y of %y", desc, h."content-length", raw));
        assertFalse(exists h."transfer-encoding", desc + ": transfer-encoding");
        assertFalse(exists h.expect, desc + ": expect");
        assertFalse(exists h.upgrade, desc + ": upgrade");
        assertTrue(!exists h.connection || h.connection =~ /^(keep-alive|close)$/i,
            sprintf("%s: connection %y of %y", desc, h.connection, raw));
        assertEq("1.1", h.http_version, desc);
        return True;
    }

    testFixedFirst() {
        second = False;
        on_exit second = True;
        testFixed();
    }

    testMutationsFirst() {
        second = False;
        on_exit second = True;
        testMutations();
    }

    testFixed() {
        const string Base = "GET /p HTTP/1.1\r\nHost: x\r\n\r\n";
        list<string> requests = (
            Base,
            "GET /p?a=1&b=2 HTTP/1.1\r\nHost: x\r\n\r\n",
            "GET /p HTTP/1.1\r\nHost: x\r\nConnection: keep-alive\r\n\r\n",
            "GET /p HTTP/1.1\r\nhost: x\r\nconnection: Keep-Alive\r\ncontent-length: 0\r\n\r\n",
            "GET /p HTTP/1.1\r\nHost: x\r\nAccept: */*\r\nUser-Agent: a b: c\r\nX-Empty:\r\n\r\n",
            "GET /p HTTP/1.1\r\nHost:   x  \r\n\r\n",
            "GET /p HTTP/1.1\r\nHost: x\r\nContent-Length: 0\r\n\r\n",
            # rejected by the strict parser, so the normal path answers them (the route may still answer some of
            # them through the parse of the normal parser, which the check below covers as well)
            "GET /p HTTP/1.0\r\nHost: x\r\n\r\n",
            "GET /p HTTP/1.1\r\n\r\n",
            "GET  /p HTTP/1.1\r\nHost: x\r\n\r\n",
            "GET /p  HTTP/1.1\r\nHost: x\r\n\r\n",
            "get /p HTTP/1.1\r\nHost: x\r\n\r\n",
            "GET /p HTTP/1.1\nHost: x\n\n",
            "GET /p HTTP/1.1\r\nHost: x\n\r\n",
            "GET /p HTTP/1.1\r\nHost : x\r\n\r\n",
            "GET /p HTTP/1.1\r\n Host: x\r\n\r\n",
            "GET /p HTTP/1.1\r\nHost: x\r\nX: a\r\n b\r\n\r\n",
            "GET /p HTTP/1.1\r\nHost: x\r\nX: a\x01b\r\n\r\n",
            "GET /p HTTP/1.1\r\nHost: x\r\nX: a\x00b\r\n\r\n",
            "GET /p HTTP/1.1\r\nHost: x\r\nX: \xc3\xa9\r\n\r\n",
            "GET /p HTTP/1.1\r\nHost: x\r\nHost: y\r\n\r\n",
            "GET /p HTTP/1.1\r\nHost: x\r\nContent-Length: 0\r\nContent-Length: 0\r\n\r\n",
            "GET /p HTTP/1.1\r\nHost: x\r\nContent-Length: 0\r\nContent-Length: 5\r\n\r\nabcde",
            "GET /p HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n\r\nabcde",
            "GET /p HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n",
            "GET /p HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: identity\r\nContent-Length: 0\r\n\r\n",
            "GET /p HTTP/1.1\r\nHost: x\r\nExpect: 100-continue\r\n\r\n",
            "GET /p HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n\r\n",
            "GET /p HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n",
            "GET /p HTTP/1.1\r\nHost: x\r\nConnection: keep-alive, Upgrade\r\n\r\n",
            "GET /p%20 HTTP/1.1\r\nHost: x\r\n\r\n",
            "GET /%70 HTTP/1.1\r\nHost: x\r\n\r\n",
            "GET /p#frag HTTP/1.1\r\nHost: x\r\n\r\n",
            "GET //p HTTP/1.1\r\nHost: x\r\n\r\n",
            "GET /p/ HTTP/1.1\r\nHost: x\r\n\r\n",
            "GET /P HTTP/1.1\r\nHost: x\r\n\r\n",
            "GET /p;a=b HTTP/1.1\r\nHost: x\r\n\r\n",
            "GET /p?q=%00 HTTP/1.1\r\nHost: x\r\n\r\n",
            "GET http://x/p HTTP/1.1\r\nHost: x\r\n\r\n",
            "GET * HTTP/1.1\r\nHost: x\r\n\r\n",
            "HEAD /p HTTP/1.1\r\nHost: x\r\n\r\n",
            "HEAD /p?a=1 HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n",
            "HEAD /p HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n\r\nabcde",
            "HEAD /p HTTP/1.0\r\nHost: x\r\n\r\n",
            "HEAD  /p HTTP/1.1\r\nHost: x\r\n\r\n",
            "HEAD /p HTTP/1.1\r\n\r\n",
            "head /p HTTP/1.1\r\nHost: x\r\n\r\n",
            "POST /p HTTP/1.1\r\nHost: x\r\nContent-Length: 0\r\n\r\n",
            "GET /p HTTP/1.1 \r\nHost: x\r\n\r\n",
            "GET /p HTTP/1.10\r\nHost: x\r\n\r\n",
            "GET /p HTTP/1.1\r\n\r\nHost: x\r\n\r\n",
        );
        int fast = 0;
        foreach string r in (requests) {
            if (check(r, sprintf("fixed #%d", $#))) {
                ++fast;
            }
        }
        # a Content-Length that is not exactly 0 but is read as a length by some parsers: the normal path waits for a body
        # that never comes (also without any route), so the route must not answer these, and they are not waited for
        foreach string r in (("+0", "00", "-1", "0x0", "00000", "1e0", "0,0")) {
            assertFalse(check(sprintf("GET /p HTTP/1.1\r\nHost: x\r\nContent-Length: %s\r\n\r\n", r),
                "non-canonical Content-Length " + r),
                "the route does not answer Content-Length " + r);
        }
        assertTrue(fast >= 7, "the valid requests are answered by the route");
        assertTrue(check(Base, "base"));
    }

    testMutationsHead() {
        testMutations("HEAD");
    }

    testMutations(string method = "GET") {
        srand(Seed);
        string Seed1 = method + " /p?c=d HTTP/1.1\r\nHost: example.org\r\nConnection: keep-alive\r\nContent-Length: 0\r\n"
            "Accept: */*\r\n\r\n";
        list<string> chars = ("\r", "\n", "\x00", "\x01", "\x7f", " ", "\t", ":", "%", "#", "?", "/", "p", "P", "0",
            "1", "\xc3\xa9", "\\", "\"", "<", ">");
        int fast = 0;
        for (int i = 0; i < Mutations; ++i) {
            string m = Seed1;
            int edits = 1 + (rand() % 3);
            for (int e = 0; e < edits; ++e) {
                int pos = rand() % m.size();
                switch (rand() % 4) {
                    case 0:
                        m = substr(m, 0, pos) + chars[rand() % chars.size()] + substr(m, pos + 1);
                        break;
                    case 1:
                        m = substr(m, 0, pos) + substr(m, pos + 1 + (rand() % 3));
                        break;
                    case 2:
                        m = substr(m, 0, pos) + chars[rand() % chars.size()] + substr(m, pos);
                        break;
                    default:
                        m = substr(m, 0, pos) + "\r\n" + substr(m, pos);
                        break;
                }
                if (!m.size()) {
                    break;
                }
            }
            if (check(m, sprintf("mutation #%d", i))) {
                ++fast;
            }
        }
        assertTrue(fast > 0, "some mutations are still valid requests that the route answers");
    }
}
