    constructor() : Test("HttpServerQuicWsTest", "1.0") {
        @debug {
            set_signal_handler(SIGUSR1, sub (int sig) {
                printf("=== SIGUSR1 Thread Stacks ===\n%Y\n=== End Thread Stacks ===\n",
                    get_all_thread_call_stacks());
            });
        }

        addTestCase("WebSocket text echo over HTTP/3", \testH3WsTextEcho());
        addTestCase("WebSocket binary echo over HTTP/3", \testH3WsBinaryEcho());
        addTestCase("WebSocket close handshake over HTTP/3", \testH3WsCloseHandshake());
        addTestCase("WebSocket multiple messages over HTTP/3", \testH3WsMultipleMessages());
        addTestCase("concurrent WebSocket streams over HTTP/3", \testH3WsConcurrentStreams());
        addTestCase("abnormal disconnect over HTTP/3", \testH3WsAbnormalDisconnect());
        addTestCase("large frame over HTTP/3", \testH3WsLargeFrame());

        set_return_value(main());
    }

    globalSetUp() {
        mLogger = new Logger("quic-ws-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            mLogger.addAppender(new StdoutAppender());
        }
    }

    #! Helper to create an HTTP/3 server with WebSocket handler
    private hash<auto> setupServer(EchoWsHandler ws_handler) {
        HttpServer server(<HttpServerOptionInfo>{
            "logger": mLogger,
            "debug": True,
            "async_mode": True,
        });

        server.setHandler("ws-handler", "", NOTHING, ws_handler);
        server.setDefaultHandler("ws-handler", ws_handler);
        server.waitForAsyncIo();

        hash<auto> h3info = server.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
            "enable_h3": True,
        });
        server.waitForAsyncIo();

        return {
            "server": server,
            "port": h3info.port,
            "url": "wss://localhost:" + h3info.port,
        };
    }

    #! Helper to create an HTTP/3 WebSocket client
    private WebSocketClient createH3Client(code cb, int port) {
        hash<auto> opts = {
            "url": "wss://localhost:" + port,
            "logger": mLogger,
            "http3_mode": "required",
            "ssl_verify_cert": False,
        };
        WebSocketClient wsc(cb, opts);
        wsc.connect();
        return wsc;
    }

    #! Test WebSocket text echo over HTTP/3
    testH3WsTextEcho() {
        EchoWsHandler ws_handler();
        if (m_options.verbose > 2) {
            ws_handler.debug_output = True;
        }

        hash<auto> setup = setupServer(ws_handler);
        HttpServer server = setup.server;
        on_exit {
            server.stop();
            delete server;
        }

        # Set up message tracking
        WaitGroup wg();
        wg.add();
        *data received_msg;

        code cb = sub (*data msg) {
            if (!exists msg) {
                return;
            }
            received_msg = msg;
            try { wg.done(); } catch () {}
        };

        WebSocketClient wsc = createH3Client(cb, setup.port);
        on_exit {
            try { wsc.disconnect(); } catch () {}
            delete wsc;
        }

        assertTrue(wsc.isHttp3(), "WebSocket should connect over HTTP/3");

        # Send a text message
        string test_msg = "Hello HTTP/3 WebSocket!";
        wsc.send(test_msg);

        # Wait for echo
        int rv = wg.wait(30s);
        assertEq(0, rv, "should receive echo within timeout");
        assertEq(test_msg, received_msg, "echoed message should match sent message");
    }

    #! Test WebSocket binary echo over HTTP/3
    testH3WsBinaryEcho() {
        EchoWsHandler ws_handler();
        if (m_options.verbose > 2) {
            ws_handler.debug_output = True;
        }

        hash<auto> setup = setupServer(ws_handler);
        HttpServer server = setup.server;
        on_exit {
            server.stop();
            delete server;
        }

        WaitGroup wg();
        wg.add();
        *data received_msg;

        code cb = sub (*data msg) {
            if (!exists msg) {
                return;
            }
            received_msg = msg;
            try { wg.done(); } catch () {}
        };

        WebSocketClient wsc = createH3Client(cb, setup.port);
        on_exit {
            try { wsc.disconnect(); } catch () {}
            delete wsc;
        }

        assertTrue(wsc.isHttp3(), "WebSocket should connect over HTTP/3");

        # Send a binary message
        binary test_data = binary("Binary payload over HTTP/3");
        wsc.send(test_data);

        # Wait for echo
        int rv = wg.wait(30s);
        assertEq(0, rv, "should receive echo within timeout");
        assertEq(test_data, received_msg, "echoed binary should match sent data");
    }

    #! Test WebSocket close handshake over HTTP/3
    testH3WsCloseHandshake() {
        EchoWsHandler ws_handler();
        if (m_options.verbose > 2) {
            ws_handler.debug_output = True;
        }

        hash<auto> setup = setupServer(ws_handler);
        HttpServer server = setup.server;
        on_exit {
            server.stop();
            delete server;
        }

        WaitGroup msg_wg();
        msg_wg.add();
        WaitGroup close_wg();
        close_wg.add();

        code cb = sub (*data msg) {
            if (!exists msg) {
                # Connection closed
                try { close_wg.done(); } catch () {}
                return;
            }
            try { msg_wg.done(); } catch () {}
        };

        WebSocketClient wsc = createH3Client(cb, setup.port);
        on_exit {
            try { wsc.disconnect(); } catch () {}
            delete wsc;
        }

        assertTrue(wsc.isHttp3(), "WebSocket should connect over HTTP/3");

        # Confirm connection works
        wsc.send("pre-close-test");
        int rv = msg_wg.wait(30s);
        assertEq(0, rv, "should receive echo before disconnect");

        # Disconnect cleanly
        wsc.disconnect();

        # The callback should be called with NOTHING to signal close
        rv = close_wg.wait(10s);
        assertEq(0, rv, "close callback should be triggered");
    }

    #! Test multiple messages over HTTP/3 WebSocket
    testH3WsMultipleMessages() {
        EchoWsHandler ws_handler();
        if (m_options.verbose > 2) {
            ws_handler.debug_output = True;
        }

        hash<auto> setup = setupServer(ws_handler);
        HttpServer server = setup.server;
        on_exit {
            server.stop();
            delete server;
        }

        int msg_count = 20;
        Mutex m();
        int received = 0;
        WaitGroup wg();
        wg.add();
        list<string> received_msgs();

        code cb = sub (*data msg) {
            if (!exists msg) {
                return;
            }
            m.lock();
            on_exit m.unlock();
            ++received;
            if (msg.typeCode() == NT_STRING) {
                received_msgs += msg;
            } else {
                received_msgs += msg.toString("UTF-8");
            }
            if (received >= msg_count) {
                try { wg.done(); } catch () {}
            }
        };

        WebSocketClient wsc = createH3Client(cb, setup.port);
        on_exit {
            try { wsc.disconnect(); } catch () {}
            delete wsc;
        }

        assertTrue(wsc.isHttp3(), "WebSocket should connect over HTTP/3");

        # Send multiple messages (alternating text and binary)
        for (int i = 0; i < msg_count; ++i) {
            string payload = sprintf("msg-%04d", i);
            if (i % 2 == 0) {
                wsc.send(payload);
            } else {
                wsc.send(binary(payload));
            }
        }

        # Wait for all echoes
        int rv = wg.wait(30s);
        assertEq(0, rv, "should receive all echoes within timeout");

        m.lock();
        on_exit m.unlock();
        assertEq(msg_count, received, sprintf("should receive all %d messages", msg_count));

        # Verify all messages present (order may vary due to async delivery)
        for (int i = 0; i < msg_count; ++i) {
            string expected = sprintf("msg-%04d", i);
            bool found = False;
            foreach string rmsg in (received_msgs) {
                if (rmsg == expected) {
                    found = True;
                    break;
                }
            }
            assertTrue(found, sprintf("message %y should be in received messages", expected));
        }
    }

    #! Test concurrent WebSocket streams on the same QUIC connection
    testH3WsConcurrentStreams() {
        EchoWsHandler ws_handler();
        if (m_options.verbose > 2) {
            ws_handler.debug_output = True;
        }

        hash<auto> setup = setupServer(ws_handler);
        HttpServer server = setup.server;
        on_exit {
            server.stop();
            delete server;
        }

        int stream_count = 3;
        int msgs_per_stream = 5;
        int total_msgs = stream_count * msgs_per_stream;

        # Per-stream tracking
        Mutex m();
        hash<string, list<string>> per_stream_received;
        Counter done(total_msgs);

        list<WebSocketClient> clients();
        on_exit {
            foreach WebSocketClient wsc in (clients) {
                try { wsc.disconnect(); } catch () {}
                delete wsc;
            }
        }

        # Create multiple concurrent WebSocket clients
        for (int s = 0; s < stream_count; ++s) {
            string stream_tag = sprintf("stream-%d", s);
            per_stream_received{stream_tag} = ();

            code cb = sub (*data msg) {
                if (!exists msg) {
                    return;
                }
                m.lock();
                on_exit m.unlock();
                string text = msg.typeCode() == NT_STRING ? msg : msg.toString("UTF-8");
                per_stream_received{stream_tag} += text;
                done.dec();
            };

            WebSocketClient wsc = createH3Client(cb, setup.port);
            assertTrue(wsc.isHttp3(), sprintf("%s should connect over HTTP/3", stream_tag));
            clients += wsc;
        }

        assertEq(stream_count, clients.size(), "all clients connected");

        # Send messages on all streams concurrently
        for (int i = 0; i < msgs_per_stream; ++i) {
            for (int s = 0; s < stream_count; ++s) {
                string payload = sprintf("stream-%d-msg-%d", s, i);
                clients[s].send(payload);
            }
        }

        # Wait for all echoes
        int rv = done.waitForZero(30s);
        assertEq(0, rv, "should receive all echoes from all streams within timeout");

        # Verify each stream received its own messages
        m.lock();
        on_exit m.unlock();
        for (int s = 0; s < stream_count; ++s) {
            string stream_tag = sprintf("stream-%d", s);
            list<string> msgs = per_stream_received{stream_tag};
            assertEq(msgs_per_stream, msgs.size(),
                sprintf("%s should receive %d messages", stream_tag, msgs_per_stream));
            for (int i = 0; i < msgs_per_stream; ++i) {
                string expected = sprintf("stream-%d-msg-%d", s, i);
                bool found = False;
                foreach string rmsg in (msgs) {
                    if (rmsg == expected) {
                        found = True;
                        break;
                    }
                }
                assertTrue(found, sprintf("%s should contain %y", stream_tag, expected));
            }
        }
    }

    #! Test abnormal disconnect (client drops without close frame)
    testH3WsAbnormalDisconnect() {
        EchoWsHandler ws_handler();
        if (m_options.verbose > 2) {
            ws_handler.debug_output = True;
        }

        hash<auto> setup = setupServer(ws_handler);
        HttpServer server = setup.server;
        on_exit {
            server.stop();
            delete server;
        }

        # Track that the server-side handler eventually cleans up
        WaitGroup msg_wg();
        msg_wg.add();

        code cb = sub (*data msg) {
            if (!exists msg) {
                return;
            }
            try { msg_wg.done(); } catch () {}
        };

        WebSocketClient wsc = createH3Client(cb, setup.port);
        assertTrue(wsc.isHttp3(), "WebSocket should connect over HTTP/3");

        # Confirm connection works
        wsc.send("pre-abort-test");
        int rv = msg_wg.wait(30s);
        assertEq(0, rv, "should receive echo before abort");

        # Force-delete the client without sending a close frame
        # This simulates abnormal disconnect (network drop, client crash)
        delete wsc;

        # Verify server is still operational — connect a new client and echo
        WaitGroup wg2();
        wg2.add();
        *data received2;

        code cb2 = sub (*data msg) {
            if (!exists msg) {
                return;
            }
            received2 = msg;
            try { wg2.done(); } catch () {}
        };

        WebSocketClient wsc2 = createH3Client(cb2, setup.port);
        on_exit {
            try { wsc2.disconnect(); } catch () {}
            delete wsc2;
        }

        assertTrue(wsc2.isHttp3(), "second client should connect over HTTP/3");
        wsc2.send("post-abort-test");
        rv = wg2.wait(30s);
        assertEq(0, rv, "server should still work after abnormal disconnect");
        assertEq("post-abort-test", received2, "echo should match after abnormal disconnect");
    }

    #! Test large frame with backpressure over HTTP/3
    testH3WsLargeFrame() {
        EchoWsHandler ws_handler();
        if (m_options.verbose > 2) {
            ws_handler.debug_output = True;
        }

        hash<auto> setup = setupServer(ws_handler);
        HttpServer server = setup.server;
        on_exit {
            server.stop();
            delete server;
        }

        WaitGroup wg();
        wg.add();
        *data received_msg;

        code cb = sub (*data msg) {
            if (!exists msg) {
                return;
            }
            received_msg = msg;
            try { wg.done(); } catch () {}
        };

        WebSocketClient wsc = createH3Client(cb, setup.port);
        on_exit {
            try { wsc.disconnect(); } catch () {}
            delete wsc;
        }

        assertTrue(wsc.isHttp3(), "WebSocket should connect over HTTP/3");

        # Send a 128KB binary message to exercise flow control / backpressure
        int large_size = 128 * 1024;
        binary large_data = binary();
        # Build deterministic payload
        string pattern = "ABCDEFGHIJKLMNOP";  # 16 bytes
        while (large_data.size() < large_size) {
            large_data += binary(pattern);
        }
        large_data = large_data.substr(0, large_size);
        assertEq(large_size, large_data.size(), "large payload should be exactly 128KB");

        wsc.send(large_data);

        # Wait for the large echo — use longer timeout for valgrind
        int rv = wg.wait(60s);
        assertEq(0, rv, "should receive large echo within timeout");
        assertEq(large_size, received_msg.size(), "echoed large message size should match");
        assertEq(large_data, received_msg, "echoed large message content should match");
    }
}
