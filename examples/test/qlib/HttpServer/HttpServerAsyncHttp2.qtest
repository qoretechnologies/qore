    constructor() : Test("HttpServerAsyncHttp2Test", "1.0") {
        addTestCase("basic HTTP/2 async response", \testBasicHttp2Response());
        addTestCase("HTTP/2 empty body returns 204", \testHttp2EmptyBodyBecomes204());
        addTestCase("HTTP/2 SOAP content-type body", \testSoapContentTypeHttp2());
        addTestCase("HTTP/2 gzip decoded body", \testGzipContentTypeHttp2());
        addTestCase("HTTP/2 gzip passthru body", \testGzipPassthruHttp2());
        addTestCase("HTTP/2 gzip multi-encoding body", \testGzipMultiEncodingHttp2());
        addTestCase("HTTP/2 unknown encoding body", \testUnknownEncodingHttp2());
        addTestCase("HTTP/2 gzip stream body", \testGzipStreamHttp2());
        addTestCase("HTTP/2 chunked stream body", \testHttp2ChunkedStreamBody());
        addTestCase("HTTP/2 error response headers", \testHttp2ErrorResponseHeaders());
        addTestCase("HTTP/2 missing response fallback", \testHttp2MissingResponseFallback());
        addTestCase("HTTP/2 header lowercase normalization", \testHttp2HeaderLowercase());
        addTestCase("HTTP/2 request header lowercase normalization", \testHttp2RequestHeaderLowercase());
        addTestCase("multiple separate connections", \testMultipleSeparateConnections());
        addTestCase("large HTTP/2 async response", \testLargeHttp2Response());
        addTestCase("large HTTP/2 FileInputStream streaming", \testLargeFileStreamResponse());
        addTestCase("concurrent HTTP/2 async responses", \testConcurrentHttp2Responses());
        addTestCase("HTTP/2 status message mapping", \testHttp2StatusMessage());
        # POST test has encoding issues - skip for now
        #addTestCase("HTTP/2 POST with large body", \testHttp2PostLargeBody());
        # These tests take too long
        #addTestCase("HTTP/2 concurrent with slow handler", \testHttp2ConcurrentWithSlowHandler());
        #addTestCase("HTTP/2 rapid sequential requests", \testHttp2RapidSequential());

        set_return_value(main());
    }

    globalSetUp() {
        # Create logger
        Logger logger("http2-async-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }

        # Create HTTP server with async mode enabled
        hash<HttpServerOptionInfo> opts = <HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
            "async_mode": True,
        };
        mServer = new HttpServer(opts);

        # Set up handlers
        mServer.setHandler("simple", "/simple", NOTHING, new SimpleHandler());
        mServer.setHandler("empty-body", "/empty-body", NOTHING, new EmptyBodyHandler());
        mServer.setHandler("header-case", "/header-case", NOTHING, new HeaderCaseHandler());
        mServer.setHandler("request-header-case", "/request-header-case", NOTHING,
            new RequestHeaderLowercaseHandler());
        mServer.setHandler("large", "/large", NOTHING, new LargeResponseHandler());
        mServer.setHandler("slow", "/slow", NOTHING, new SlowHandler());
        mServer.setHandler("echo", "/echo", NOTHING, new EchoHandler());
        mServer.setHandler("status", "/status", NOTHING, new StatusCodeHandler());
        mServer.setHandler("soap", "/soap", NOTHING, new SoapHandler());
        mServer.setHandler("gzip", "/gzip-plain", NOTHING, new GzipHandler());
        mServer.setHandler("gzip-stream", "/gzip-stream", NOTHING, new GzipStreamHandler());
        mServer.setHandler("gzip-multi", "/gzip-multi", NOTHING, new GzipMultiHandler());
        mServer.setHandler("unknown-encoding", "/unknown-encoding", NOTHING, new UnknownEncodingHandler());
        mServer.setHandler("chunked-stream", "/chunked-stream", NOTHING, new ChunkedStreamHandler());
        mServer.setHandler("empty-error", "/empty-error", NOTHING, new EmptyErrorHandler());
        mServer.setHandler("no-response", "/no-response", NOTHING, new NoResponseHandler());

        # Create temporary file for FileInputStream streaming test (2MB)
        mTempFile = tmp_location() + "/http2-stream-test-" + getpid() + "-" + get_random_string(8) + ".bin";
        {
            File f();
            f.open2(mTempFile, O_CREAT | O_WRONLY | O_TRUNC);
            # Write 2MB of known pattern data
            binary chunk = binary(strmul("ABCDEFGHIJKLMNOP", 4096));
            @assert(chunk.size() == 65536);
            for (int i = 0; i < 32; ++i) {
                f.write(chunk);
            }
        }
        mServer.setHandler("file-stream", "/file-stream", NOTHING,
            new FileStreamHandler(mTempFile));

        # Add HTTPS listener for HTTP/2 (HTTP/2 requires HTTPS via ALPN)
        mSslPort = mServer.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        }).port;
        mSslUrl = "https://localhost:" + mSslPort;

        # Wait for async I/O to be ready
        mServer.waitForAsyncIo();

        if (m_options.verbose > 1) {
            printf("HTTPS server started on port %d\n", mSslPort);
            printf("HTTP/2 mode: %s\n", get_global_http2_mode());
        }
    }

    globalTearDown() {
        delete mServer;
        if (mTempFile && is_file(mTempFile)) {
            unlink(mTempFile);
        }
    }

    #! Create a RestClient for HTTP/2 testing
    private RestClient getClient(*int timeout_ms) {
        return new RestClient({
            "url": mSslUrl,
            "ssl_verify_cert": False,  # Self-signed cert
            "timeout": timeout_ms ?? 30000,
        });
    }

    testBasicHttp2Response() {
        RestClient rc = getClient();

        hash<auto> resp = rc.get("/simple");
        assertEq(200, resp.status_code, "Basic HTTP/2 GET should return 200");
        assertEq("OK", resp.body, "Response body should be 'OK'");

        if (m_options.verbose > 1) {
            printf("Basic HTTP/2 response: OK (http_version: %y)\n", resp.http_version);
        }
    }

    testHttp2EmptyBodyBecomes204() {
        HTTPClient hc({
            "url": mSslUrl,
            "ssl_verify_cert": False,
            "http_version": "2.0",
        });
        hc.setHttp2Mode("required");

        hash<auto> resp = hc.send(NOTHING, "GET", "/empty-body");
        assertEq(204, resp.status_code, "HTTP/2 empty-body response should return 204");
        assertNothing(resp.body);
    }

    testHttp2ResponseHeadersNoHopByHop() {
        RestClient rc({
            "url": mSslUrl,
            "ssl_verify_cert": False,
            "timeout": 30000,
            "http_version": "2.0",
        });

        hash<auto> info;
        hash<auto> resp = rc.get("/simple", NOTHING, \info);
        assertEq(200, resp.status_code, "HTTP/2 response should return 200");

        if (!(resp.http_version == "HTTP/2" || resp.http_version == "2")) {
            testSkip(sprintf("HTTP/2 not negotiated (http_version: %y)", resp.http_version));
            return;
        }

        hash<auto> headers = info."response-headers" ?? {};
        hash<auto> headers_raw = info."response-headers-raw" ?? {};

        assertFalse(exists headers.connection, "HTTP/2 response must not include Connection");
        assertFalse(exists headers."keep-alive", "HTTP/2 response must not include Keep-Alive");
        assertFalse(exists headers."proxy-connection", "HTTP/2 response must not include Proxy-Connection");
        assertFalse(exists headers."transfer-encoding", "HTTP/2 response must not include Transfer-Encoding");
        assertFalse(exists headers.upgrade, "HTTP/2 response must not include Upgrade");
        assertFalse(exists headers.te, "HTTP/2 response must not include TE");

        assertFalse(exists headers_raw.Connection, "HTTP/2 raw response must not include Connection");
        assertFalse(exists headers_raw."Keep-Alive", "HTTP/2 raw response must not include Keep-Alive");
        assertFalse(exists headers_raw."Proxy-Connection", "HTTP/2 raw response must not include Proxy-Connection");
        assertFalse(exists headers_raw."Transfer-Encoding", "HTTP/2 raw response must not include Transfer-Encoding");
        assertFalse(exists headers_raw.Upgrade, "HTTP/2 raw response must not include Upgrade");
        assertFalse(exists headers_raw.TE, "HTTP/2 raw response must not include TE");
    }

    testHttp2HeaderLowercase() {
        RestClient rc({
            "url": mSslUrl,
            "ssl_verify_cert": False,
            "timeout": 30000,
            "http_version": "2.0",
        });

        hash<auto> info;
        hash<auto> resp = rc.get("/header-case", NOTHING, \info);
        assertEq(200, resp.status_code, "HTTP/2 response should return 200");

        if (!(resp.http_version == "HTTP/2" || resp.http_version == "2")) {
            testSkip(sprintf("HTTP/2 not negotiated (http_version: %y)", resp.http_version));
            return;
        }

        hash<auto> headers = info."response-headers" ?? {};
        hash<auto> headers_raw = info."response-headers-raw" ?? {};
        bool has_lower = exists headers."x-test-header" || exists headers_raw."x-test-header";
        bool has_upper = exists headers."X-Test-Header" || exists headers_raw."X-Test-Header";
        assertTrue(has_lower, "HTTP/2 response headers should be lowercase");
        assertFalse(has_upper, "HTTP/2 response headers should not preserve uppercase");
    }

    testHttp2RequestHeaderLowercase() {
        RestClient rc({
            "url": mSslUrl,
            "ssl_verify_cert": False,
            "timeout": 30000,
            "http_version": "2.0",
        });

        hash<auto> info;
        hash<auto> resp = rc.get("/request-header-case", {
            "X-Mixed-Case": "1",
        }, \info);
        assertEq(200, resp.status_code, "HTTP/2 request should return 200");

        if (!(resp.http_version == "HTTP/2" || resp.http_version == "2")) {
            testSkip(sprintf("HTTP/2 not negotiated (http_version: %y)", resp.http_version));
            return;
        }
    }

    testSoapContentTypeHttp2() {
        string xml = "<?xml version=\"1.0\"?><soap:Envelope><soap:Body>OK</soap:Body></soap:Envelope>";

