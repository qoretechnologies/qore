            }
        }
    }

    testConcurrentHttp2Responses() {
        # This is the main test for the bug - concurrent requests should all complete
        # without timeout, even when responses are being sent via HTTP/2
        int num_requests = 10;
        int timeout_ms = 30000;

        Counter cnt(num_requests);
        list<hash<auto>> results = ();
        Mutex m();

        for (int i = 0; i < num_requests; i++) {
            int idx = i;
            background sub() {
                on_exit cnt.dec();

                try {
                    RestClient rc = getClient(timeout_ms);
                    # Request varying sizes to create more realistic load
                    int size = 1000 + (idx * 1000);
                    hash<auto> resp = rc.get(sprintf("/large/%d", size));
                    m.lock();
                    on_exit m.unlock();
                    results += {
                        "idx": idx,
                        "status": resp.status_code,
                        "body_size": resp.body.size(),
                        "expected_size": size,
                        "success": True,
                    };
                } catch (hash<ExceptionInfo> ex) {
                    m.lock();
                    on_exit m.unlock();
                    results += {
                        "idx": idx,
                        "error": ex.err,
                        "desc": ex.desc,
                        "success": False,
                    };
                }
            }();
        }

        cnt.waitForZero();

        int success_count = 0;
        foreach hash<auto> r in (results) {
            if (r.success) {
                success_count++;
                assertEq(200, r.status, sprintf("Request %d should return 200", r.idx));
                assertEq(r.expected_size, r.body_size, sprintf("Request %d body size mismatch", r.idx));
            } else {
                if (m_options.verbose) {
                    printf("Request %d FAILED: %s: %s\n", r.idx, r.error, r.desc);
                }
            }
        }

        assertEq(num_requests, success_count, "All concurrent requests should succeed");

        if (m_options.verbose > 1) {
            printf("Concurrent HTTP/2 responses: %d/%d succeeded\n", success_count, num_requests);
        }
    }

    #! Tests that HTTP/2 responses have correct status_message mapping
    /** HTTP/2 only transmits status codes, not messages (unlike HTTP/1.x).
        The status_message must be synthesized from the status code on the client side.
        This test verifies that the mapping is complete for common status codes.
    */
    testHttp2StatusMessage() {
        RestClient rc = getClient();

        # Test various status codes and their expected messages
        # Note: Skip 3xx redirects as they require Location header and cause RestClient exceptions
        hash<string, int> status_tests = {
            "OK": 200,
            "Created": 201,
            "Accepted": 202,
            "No Content": 204,
            "Bad Request": 400,
            "Unauthorized": 401,
            "Forbidden": 403,
            "Not Found": 404,
            "Method Not Allowed": 405,
            "Conflict": 409,
            "Gone": 410,
            "Unprocessable Entity": 422,
            "Too Many Requests": 429,
            "Internal Server Error": 500,
            "Not Implemented": 501,
            "Bad Gateway": 502,
            "Service Unavailable": 503,
            "Gateway Timeout": 504,
        };

        foreach string expected_msg in (keys status_tests) {
            int code = status_tests{expected_msg};
            try {
                hash<auto> resp = rc.get(sprintf("/status/%d", code));
                assertEq(code, resp.status_code, sprintf("Status code for %d", code));
                assertEq(expected_msg, resp.status_message, sprintf("Status message for %d should be '%s'", code, expected_msg));

                if (m_options.verbose > 1) {
                    printf("HTTP/2 status %d: %s (http_version: %y)\n", code, resp.status_message, resp.http_version);
                }
            } catch (hash<ExceptionInfo> ex) {
                # Some status codes may throw exceptions (4xx, 5xx) - still check the response
                if (ex.arg.status_code) {
                    assertEq(code, ex.arg.status_code, sprintf("Status code for %d (from exception)", code));
                    assertEq(expected_msg, ex.arg.status_message, sprintf("Status message for %d should be '%s' (from exception)", code, expected_msg));

                    if (m_options.verbose > 1) {
                        printf("HTTP/2 status %d: %s (from exception, http_version: %y)\n", code, ex.arg.status_message, ex.arg.http_version);
                    }
                } else {
                    # Re-throw if not a REST response exception
                    rethrow;
                }
            }
        }

        if (m_options.verbose) {
            printf("HTTP/2 status message mapping: all %d status codes verified\n", status_tests.size());
        }
    }

    testHttp2PostLargeBody() {
        RestClient rc = getClient();

        # Test POST with various body sizes
        list<int> sizes = (1000, 10000, 100000);

        foreach int size in (sizes) {
            binary body = binary(strmul("Y", size));
            hash<auto> resp = rc.post("/echo", body, NOTHING, {"Content-Type": "application/octet-stream"});
            assertEq(200, resp.status_code, sprintf("HTTP/2 POST (%d bytes) should return 200", size));
            assertEq(size, resp.body.size(), sprintf("Echo response should be %d bytes", size));

            if (m_options.verbose > 1) {
                printf("Large POST (%d bytes): OK\n", size);
            }
        }
    }

    testHttp2ConcurrentWithSlowHandler() {
        # Test that slow handlers don't block other requests
        # This exercises the async I/O path where one response takes time
        int num_fast = 5;
        int num_slow = 2;
        int total = num_fast + num_slow;
        int timeout_ms = 30000;

        Counter cnt(total);
        list<hash<auto>> results = ();
        Mutex m();

        # Start slow requests first
        for (int i = 0; i < num_slow; i++) {
            int idx = i;
            background sub() {
                on_exit cnt.dec();

                try {
                    RestClient rc = getClient(timeout_ms);
                    date start = now_us();
                    hash<auto> resp = rc.get("/slow/500");  # 500ms delay
                    date elapsed = now_us() - start;
                    m.lock();
                    on_exit m.unlock();
                    results += {
                        "idx": idx,
                        "type": "slow",
                        "status": resp.status_code,
                        "elapsed_ms": elapsed.durationMilliseconds(),
                        "success": True,
                    };
                } catch (hash<ExceptionInfo> ex) {
                    m.lock();
                    on_exit m.unlock();
                    results += {
                        "idx": idx,
                        "type": "slow",
                        "error": ex.err,
                        "desc": ex.desc,
                        "success": False,
                    };
                }
            }();
        }

        # Wait a bit then start fast requests
        sleep(50ms);

        for (int i = 0; i < num_fast; i++) {
            int idx = num_slow + i;
            background sub() {
                on_exit cnt.dec();

                try {
                    RestClient rc = getClient(timeout_ms);
                    date start = now_us();
                    hash<auto> resp = rc.get("/simple");
                    date elapsed = now_us() - start;
                    m.lock();
                    on_exit m.unlock();
                    results += {
                        "idx": idx,
                        "type": "fast",
                        "status": resp.status_code,
                        "elapsed_ms": elapsed.durationMilliseconds(),
                        "success": True,
                    };
                } catch (hash<ExceptionInfo> ex) {
                    m.lock();
                    on_exit m.unlock();
                    results += {
                        "idx": idx,
                        "type": "fast",
                        "error": ex.err,
                        "desc": ex.desc,
                        "success": False,
                    };
                }
            }();
        }

        cnt.waitForZero();

        int success_count = 0;
        foreach hash<auto> r in (results) {
            if (r.success) {
                success_count++;
                assertEq(200, r.status, sprintf("Request %d (%s) should return 200", r.idx, r.type));
            } else {
                if (m_options.verbose) {
                    printf("Request %d (%s) FAILED: %s: %s\n", r.idx, r.type, r.error, r.desc);
                }
            }
        }

        assertEq(total, success_count, "All concurrent requests (slow + fast) should succeed");

        if (m_options.verbose > 1) {
            printf("Concurrent with slow handler: %d/%d succeeded\n", success_count, total);
        }
    }

    testHttp2RapidSequential() {
        # Test rapid sequential requests on the same connection
        # This mimics the oload behavior that was timing out
        int num_iterations = 5;

        for (int i = 0; i < num_iterations; i++) {
            RestClient rc = getClient();

            # GET request
            hash<auto> resp1 = rc.get("/simple");
            assertEq(200, resp1.status_code, sprintf("Iteration %d: GET should return 200", i));

            # POST request
            hash<auto> resp2 = rc.post("/echo", "test data", NOTHING, {"Content-Type": "text/plain"});
            assertEq(200, resp2.status_code, sprintf("Iteration %d: POST should return 200", i));

            # Large GET request
            hash<auto> resp3 = rc.get("/large/50000");
            assertEq(200, resp3.status_code, sprintf("Iteration %d: Large GET should return 200", i));
            assertEq(50000, resp3.body.size(), sprintf("Iteration %d: Large response size", i));

            if (m_options.verbose > 1) {
                printf("Iteration %d: 3 requests completed (http_version: %y)\n", i, resp1.http_version);
            }
        }

        if (m_options.verbose > 1) {
            printf("Rapid sequential HTTP/2 requests: OK\n");
        }
    }
}
