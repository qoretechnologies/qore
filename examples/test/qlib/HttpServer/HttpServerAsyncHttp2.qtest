    testHttp2ErrorResponseHeaders() {
        RestClient rc({
            "url": mSslUrl,
            "ssl_verify_cert": False,
            "timeout": 30000,
            "http_version": "2.0",
        });

        try {
            rc.get("/empty-error", NOTHING, NOTHING);
            assertTrue(False, "HTTP/2 error response should raise REST-RESPONSE-ERROR");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("REST-RESPONSE-ERROR", ex.err, "Expected REST-RESPONSE-ERROR for 404 response");
            hash<auto> info = ex.arg ?? {};
            assertEq(404, info.status_code, "HTTP/2 error response should return 404");
            if (info.http_version != "2" && info.http_version != "HTTP/2") {
                testSkip(sprintf("HTTP/2 not negotiated (http_version: %y)", info.http_version));
                return;
            }
            assertTrue(exists info."content-length",
                "HTTP/2 error responses should include Content-Length when body is buffered");
            hash<auto> headers = info."response-headers" ?? {};
            hash<auto> headers_raw = info."response-headers-raw" ?? {};
            assertFalse(exists headers.connection, "HTTP/2 error response must not include Connection");
            assertFalse(exists headers."keep-alive", "HTTP/2 error response must not include Keep-Alive");
            assertFalse(exists headers."proxy-connection", "HTTP/2 error response must not include Proxy-Connection");
            assertFalse(exists headers."transfer-encoding",
                "HTTP/2 error response must not include Transfer-Encoding");
            assertFalse(exists headers.upgrade, "HTTP/2 error response must not include Upgrade");
            assertFalse(exists headers.te, "HTTP/2 error response must not include TE");
            assertFalse(exists headers_raw.Connection, "HTTP/2 error response must not include Connection");
            assertFalse(exists headers_raw."Keep-Alive", "HTTP/2 error response must not include Keep-Alive");
            assertFalse(exists headers_raw."Proxy-Connection",
                "HTTP/2 error response must not include Proxy-Connection");
            assertFalse(exists headers_raw."Transfer-Encoding",
                "HTTP/2 error response must not include Transfer-Encoding");
            assertFalse(exists headers_raw.Upgrade, "HTTP/2 error response must not include Upgrade");
            assertFalse(exists headers_raw.TE, "HTTP/2 error response must not include TE");
        }
    }

    testHttp2MissingResponseFallback() {
        RestClient rc({
            "url": mSslUrl,
            "ssl_verify_cert": False,
            "timeout": 30000,
            "http_version": "2.0",
        });

        try {
            rc.get("/no-response", NOTHING, NOTHING);
            assertTrue(False, "HTTP/2 missing response should raise REST-RESPONSE-ERROR");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("REST-RESPONSE-ERROR", ex.err, "Expected REST-RESPONSE-ERROR for missing response");
            hash<auto> info = ex.arg ?? {};
            assertEq(500, info.status_code, "HTTP/2 missing response should return 500");
            if (info.http_version != "2" && info.http_version != "HTTP/2") {
                testSkip(sprintf("HTTP/2 not negotiated (http_version: %y)", info.http_version));
                return;
            }
        }
    }

    #! Tests multiple sequential requests from SEPARATE connections
    /** This is the key regression test for the bug where the listener stops accepting
        new connections after the first accept completes. Each request uses a new
        RestClient instance to force a new TCP connection/TLS handshake.
    */
    testMultipleSeparateConnections() {
        int num_connections = 5;

        for (int i = 0; i < num_connections; i++) {
            # Create a NEW client for each request - forces new connection
            RestClient rc = getClient(10000);
            on_exit delete rc;

            if (m_options.verbose > 1) {
                printf("Connection %d: making request...\n", i);
            }

            hash<auto> resp = rc.get("/simple");
            assertEq(200, resp.status_code, sprintf("Connection %d should return 200", i));
            assertEq("OK", resp.body, sprintf("Connection %d response should be 'OK'", i));

            if (m_options.verbose > 1) {
                printf("Connection %d: OK (http_version: %y)\n", i, resp.http_version);
            }
        }

        if (m_options.verbose) {
            printf("Multiple separate connections: %d requests from %d different connections succeeded\n",
                num_connections, num_connections);
        }
    }

    testLargeFileStreamResponse() {
        # Test the FileInputStream streaming path - this is the path used by Qorus
        # for serving static files like JS/CSS bundles.
        # The temp file is 2MB (32 x 64KB chunks of "ABCDEFGHIJKLMNOP" repeated)
        int expected_size = 2 * 1024 * 1024;

        RestClient rc = getClient(30000);
        hash<auto> resp = rc.get("/file-stream");
        assertEq(200, resp.status_code, "FileInputStream response should return 200");
        assertEq(expected_size, resp.body.size(),
            sprintf("FileInputStream response body should be %d bytes (got %d)", expected_size,
                resp.body.size()));

        if (m_options.verbose > 1) {
            printf("FileInputStream streaming response (%d bytes): OK\n", resp.body.size());
        }

        # Test concurrent file stream requests (exercises I/O loop with multiple active
        # InputStreams and client WINDOW_UPDATE timing)
        int num_requests = 3;
        Counter cnt(num_requests);
        list<hash<auto>> results = ();
        Mutex mtx();

        for (int i = 0; i < num_requests; ++i) {
            int idx = i;
            background sub() {
                on_exit cnt.dec();
                try {
                    RestClient rc2 = getClient(30000);
                    hash<auto> r = rc2.get("/file-stream");
                    mtx.lock();
                    on_exit mtx.unlock();
                    results += {"idx": idx, "status": r.status_code, "size": r.body.size(),
                        "success": True};
                } catch (hash<ExceptionInfo> ex) {
                    mtx.lock();
                    on_exit mtx.unlock();
                    results += {"idx": idx, "error": ex.err, "desc": ex.desc, "success": False};
                }
            }();
        }

        int wait_rc = cnt.waitForZero(60s);
        assertEq(0, wait_rc, "background file stream requests should complete within 60 seconds");

        foreach hash<auto> r in (results) {
            assertTrue(r.success, sprintf("Concurrent file stream request %d should succeed (error: %y: %y)",
                r.idx, r.error, r.desc));
            if (r.success) {
                assertEq(200, r.status, sprintf("Concurrent file stream request %d status", r.idx));
                assertEq(expected_size, r.size,
                    sprintf("Concurrent file stream request %d body size", r.idx));
            }
        }
    }

    testLargeHttp2Response() {
        RestClient rc = getClient();

        # Test various sizes
        list<int> sizes = (1000, 10000, 100000, 500000);

        foreach int size in (sizes) {
            hash<auto> resp = rc.get(sprintf("/large/%d", size));
            assertEq(200, resp.status_code, sprintf("Large HTTP/2 GET (%d bytes) should return 200", size));
            assertEq(size, resp.body.size(), sprintf("Response body should be %d bytes", size));

