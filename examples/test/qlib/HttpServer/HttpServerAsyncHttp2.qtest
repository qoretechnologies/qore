    HTTP/2 async response test - exercises the async I/O response path with HTTP/2

    This test verifies that HTTP/2 responses are sent correctly via the async
    I/O controller, especially under concurrent load. This is a regression test
    for the bug where HTTP/2 responses would timeout because the async I/O thread
    was blocked in a synchronous poll loop.
*/

%modern

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Mime.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/HttpServerUtil.qm
%requires ../../../../qlib/HttpServerAsyncIo
%requires ../../../../qlib/HttpServer.qm
%requires ../../../../qlib/RestClient.qm

%exec-class HttpServerAsyncHttp2Test

#! Handler that returns large responses
class LargeResponseHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        # Extract size from path: /large/<size>
        int size = 1000;  # default 1KB
        *list<*string> m = (hdr.path =~ x/large\/(\d+)/);
        if (m) {
            size = int(m[0]);
        }
        string response_body = strmul("X", size);
        return makeResponse(200, response_body, {"Content-Type": "text/plain"});
    }
}

#! Handler that returns large FileInputStream-based responses (pollable InputStream path)
class FileStreamHandler inherits AbstractHttpRequestHandler {
    public {
        string file_path;
    }

    constructor(string file_path) {
        self.file_path = file_path;
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        hash<StatInfo> info = hstat(file_path);
        return makeResponse(200, new FileInputStream(file_path), {
            "Content-Type": "application/octet-stream",
            "Content-Length": string(info.size),
        });
    }
}

#! Handler that delays before responding (simulates slow processing)
class SlowHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        # Delay for specified milliseconds (from path: /slow/<ms>)
        int delay_ms = 100;  # default 100ms
        *list<*string> m = (hdr.path =~ x/slow\/(\d+)/);
        if (m) {
            delay_ms = int(m[0]);
        }
        sleep(delay_ms);
        return makeResponse(200, sprintf("delayed %d ms", delay_ms), {"Content-Type": "text/plain"});
    }
}

#! Echo handler that returns the request body
class EchoHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, body ?? "", {
            "Content-Type": hdr."content-type" ?? "application/octet-stream",
        });
    }
}

#! Simple handler for basic tests
class SimpleHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, "OK", {"Content-Type": "text/plain"});
    }
}

#! Handler that returns an empty body with HTTP 200
class EmptyBodyHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, "", {"Content-Type": "text/plain"});
    }
}

#! Handler that returns a mixed-case header
class HeaderCaseHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, "OK", {
            "Content-Type": "text/plain",
            "X-Test-Header": "ok",
        });
    }
}

#! Handler that verifies request header names are lowercase
class RequestHeaderLowercaseHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        bool ok = True;
        foreach string key in (keys hdr) {
            if (key.startsWith(":")) {
                continue;
            }
            if (key != key.lwr()) {
                ok = False;
                break;
            }
        }
        return makeResponse(ok ? 200 : 400, ok ? "OK" : "BAD", {
            "Content-Type": "text/plain",
        });
    }
}

#! Handler that returns a configurable status code
class StatusCodeHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        # Extract status code from path: /status/<code>
        int code = 200;
        *list<*string> m = (hdr.path =~ x/status\/(\d+)/);
        if (m) {
            code = int(m[0]);
        }
        return makeResponse(code, sprintf("Response with status %d", code), {"Content-Type": "text/plain"});
    }
}

#! Handler that returns SOAP XML
class SoapHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        string xml = "<?xml version=\"1.0\"?><soap:Envelope><soap:Body>OK</soap:Body></soap:Envelope>";
        return makeResponse(200, xml, {"Content-Type": "application/soap+xml; charset=utf-8"});
    }
}

#! Handler that returns gzip-compressed text
class GzipHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        string msg = "gzip-ok";
        binary gz = AbstractHttpRequestHandler::encodeBody("gzip", msg);
        return makeResponse(200, gz, {
            "Content-Type": "text/plain; charset=utf-8",
            "Content-Encoding": "gzip",
        });
    }
}

#! Handler that returns gzip-compressed text via stream body
class GzipStreamHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        string msg = "gzip-stream";
        binary gz = AbstractHttpRequestHandler::encodeBody("gzip", msg);
        return makeResponse(200, new BinaryInputStream(gz), {
            "Content-Type": "text/plain; charset=utf-8",
            "Content-Encoding": "gzip",
        });
    }
}

#! Handler that returns gzip-compressed text with multiple encodings
class GzipMultiHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        string msg = "gzip-multi";
        binary gz = AbstractHttpRequestHandler::encodeBody("gzip", msg);
        return makeResponse(200, gz, {
            "Content-Type": "text/plain; charset=utf-8",
            "Content-Encoding": "gzip, br",
        });
    }
}

#! Handler that returns a body with an unknown content-encoding
class UnknownEncodingHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, "unknown-encoding", {
            "Content-Type": "text/plain; charset=utf-8",
            "Content-Encoding": "mystery",
        });
    }
}

#! Chunked stream request for HTTP/2 async response testing
class ChunkedStreamRequest inherits AbstractStreamRequest {
    private {
        list<string> chunks;
        int idx = 0;
        *hash<auto> respHdr;
    }

    constructor(HttpListenerInterface listener, AbstractHttpRequestHandler handler, Socket s, hash<auto> cx,
            hash<auto> hdr, *data body, list<string> chunks, *hash<auto> respHdr)
            : AbstractStreamRequest(listener, handler, s, cx, hdr, body) {
        self.chunks = chunks;
        self.respHdr = respHdr;
    }

    private hash<HttpResponseInfo> getResponseHeaderMessageImpl() {
        return <HttpResponseInfo>{
            "code": 200,
            "hdr": {
                "Transfer-Encoding": "chunked",
            } + respHdr,
        };
    }

    private auto sendImpl() {
        if (idx >= chunks.size()) {
            return;
        }
        string chunk = chunks[idx];
        idx += 1;
        return chunk;
    }
}

#! Handler that streams a chunked response via AbstractStreamRequest
class ChunkedStreamHandler inherits AbstractHttpRequestHandler {
    constructor() : AbstractHttpRequestHandler(NOTHING, True) {
    }

    private AbstractStreamRequest getStreamRequestImpl(HttpListenerInterface listener, Socket s, hash<auto> cx,
            hash<auto> hdr, *data body) {
        list<string> chunks = ("chunk-1-", "chunk-2-", "chunk-3");
        return new ChunkedStreamRequest(listener, self, s, cx, hdr, body, chunks, {
            "Content-Type": "text/plain",
        });
    }
}

#! Handler that returns an error without a body to trigger sendHttpError()
class EmptyErrorHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return <HttpResponseInfo>{
            "code": 404,
        };
    }
}

#! Handler that returns without sending a response (simulates a buggy handler)
class NoResponseHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return <HttpResponseInfo>{
            "code": 200,
            "reply_sent": True,
        };
    }
}

