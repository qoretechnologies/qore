        hash<auto> resp = hc.send(NOTHING, "GET", "/soap");
        assertEq(200, resp.status_code, "SOAP HTTP/2 GET should return 200");
        assertTrue(resp.body.typeCode() == NT_STRING, "SOAP body should be a string");
        assertEq(xml, resp.body, "SOAP body should match");
    }

