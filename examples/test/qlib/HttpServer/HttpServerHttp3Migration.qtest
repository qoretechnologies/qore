    and/or sell copies of the Software, and to permit persons to whom the
    Software is furnished to do so, subject to the following conditions:

    The above copyright notice and this permission notice shall be included in
    all copies or substantial portions of the Software.

    THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
    IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
    FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
    AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
    LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
    FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
    DEALINGS IN THE SOFTWARE.

    QUIC connection migration tests - exercises client-side active migration
    (RFC 9000 §9) end-to-end over QUIC/HTTP/3.

    Http3ClientConnection::migrate() returns once the I/O thread of the connection has made the migration, so every
    test checks that the connection has a new local port when it returns.

    Tests cover:
    - Client active migration (migrate then request)
    - Migration during streaming response (1MB body mid-stream)
    - Migration during large upload (1MB POST body mid-upload)
    - Multiple successive migrations (3x)
    - Many migrations / CID replenishment (10 migrations with requests)
    - Migration before handshake (negative test)
    - Idle connection migration
    - Concurrent streams (10) + migration
    - Http3ClientConnectionManager.migrateAll()
    - A migration that the QUIC layer refuses raises its error, and migrateAll() drains the connection
    - A migration that the I/O thread does not start in time is withdrawn (HTTP3-MIGRATION-TIMEOUT)
    - A migration requested before the connection closes raises HTTP3-CONNECTION-CLOSED
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Mime
%requires Logger
%requires HttpServerUtil
%requires AsyncSocketIo
%requires HttpServerAsyncIo
%requires HttpServer
%requires HttpClientIo
%requires ../../TestCertificates.qm

%exec-class HttpServerHttp3MigrationTest

#! Simple echo handler for migration tests
class MigrationEchoHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, body ?? "OK", {
            "Content-Type": hdr."content-type" ?? "text/plain",
            "X-Request-Path": hdr.path,
        });
    }
}

#! Handler that returns a large body for streaming tests
class MigrationLargeHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        int size = 100000;
        *list<*string> m = (hdr.path =~ x/large\/(\d+)/);
        if (m) {
            size = int(m[0]);
        }
        string response_body = strmul("M", size);
        return makeResponse(200, response_body, {"Content-Type": "text/plain"});
    }
}

class HttpServerHttp3MigrationTest inherits Test {
    private {
        HttpServer mServer;
        *Logger mLogger;
        int mH3Port;
        string mH3Url;
        AsyncSocketIo::AsyncSocketIoController mController(True);
    }

    public {
        const CertPem = TestCertificates::CertPem;

        const KeyPem = TestCertificates::KeyPem;
    }

    constructor() : Test("HttpServerHttp3MigrationTest", "1.0") {
        # Group 1: Client Active Migration
        addTestCase("client active migration", \testClientActiveMigration());
        addTestCase("migration during streaming response", \testMigrationDuringStreaming());
        addTestCase("migration during large upload", \testMigrationDuringUpload());
        addTestCase("multiple successive migrations", \testMultipleMigrations());
        addTestCase("idle connection migration", \testIdleMigration());
        addTestCase("concurrent streams + migration", \testConcurrentStreamsMigration());

        # Group 2: Connection Manager Migration
        addTestCase("migrateAll", \testMigrateAll());

        # Group 3: Negative Tests
        addTestCase("migration before handshake", \testMigrationBeforeHandshake());
        addTestCase("many migrations / CID replenishment", \testCidReplenishment());
        addTestCase("back-to-back migrations wait for a spare connection ID", \testBackToBackMigrations());
        addTestCase("a migration with no spare connection ID times out", \testRefusedMigration());
        addTestCase("migrateAll drains a connection that cannot be migrated", \testMigrateAllRefused());
        addTestCase("migration not started in time is withdrawn", \testMigrationTimeout());
        addTestCase("migration requested before the connection closes", \testMigrationConnectionClosed());

        set_return_value(main());
    }

    globalSetUp() {
        mLogger = new Logger("http3-migration-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            mLogger.addAppender(new StdoutAppender());
        }

        mServer = new HttpServer(<HttpServerOptionInfo>{
            "logger": mLogger,
            "debug": True,
        });

        mServer.setHandler("echo", "/echo", NOTHING, new MigrationEchoHandler());
        mServer.setHandler("large", "/large", NOTHING, new MigrationLargeHandler());

        mServer.waitForAsyncIo();

        hash<auto> h3info = mServer.addQuicListener(<HttpListenerOptionInfo>{
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        });
        mH3Port = h3info.port;
        mH3Url = "https://127.0.0.1:" + mH3Port;
    }

    globalTearDown() {
        try {
            mController.stop();
        } catch () {
            # Ignore shutdown errors
        }
        try {
            mServer.stopNoWait();
        } catch () {
            # Ignore shutdown errors
        }
    }

    #! Helper: register a connection with the shared AsyncSocketIoController
    private registerConnection(Http3ClientConnection conn) {
        conn.setControllerRef(mController);
        submitToController(conn);
    }

    #! Helper: submit a connection's poll operation to the controller
    private submitToController(HttpClientIo::HttpClientConnection conn) {
        HttpClientIo::HttpClientPollOperation op = conn.getPollOperation();
        Socket sock = conn.getSocket();

        mController.submit(<SocketPollOperationInfo>{
            "sock": sock,
            "spop": op,
            "owner": self.uniqueHash(),
            "to": -1s,
        });
    }

    #! Helper: create a single Http3ClientConnection and wait for it to become ready
    private Http3ClientConnection createReadyConnection() {
        hash<auto> url_info = {
            "host": "127.0.0.1",
            "port": mH3Port,
            "protocol": "https",
        };
        Http3ClientConnection conn(url_info, 15s, mLogger, HttpClientIo::DefaultMaxStreamsPerConnection,
            NOTHING, True);
        registerConnection(conn);
        assertTrue(conn.waitForReady(15s), "connection should become ready");
        return conn;
    }

    #! Helper: returns the local port of the UDP socket of a connection
    private static int getLocalPort(Http3ClientConnection conn) {
        return conn.getSocket().getSocketInfo().port;
    }

    #! Helper: migrates a connection and checks that it has a new local port when migrate() returns
    private migrateAndCheck(Http3ClientConnection conn, string what) {
        int old_port = getLocalPort(conn);
        assertTrue(conn.migrate(), what + ": migrate() returns True");
        assertNeq(old_port, getLocalPort(conn), what + ": the connection has a new local port");
    }

    #! Helper: do a sync request via Http3ClientConnection and return the response
    private hash<auto> doSyncRequest(Http3ClientConnection conn, string method, string path,
            *hash<auto> headers, *data body) {
        hash<auto> req = conn.submitRequest(method, path, headers, body);
        Future f = req.future;
        return f.get(15s);
    }

    #! Test: connect → request → migrate → request → verify both succeed
    testClientActiveMigration() {
        Http3ClientConnection conn = createReadyConnection();
        on_exit { try { conn.close(); } catch () {} }

        # Request before migration
        hash<auto> resp1 = doSyncRequest(conn, "GET", "/echo");
        assertEq(200, resp1.status_code, "pre-migration request succeeds");

        # Migrate
        migrateAndCheck(conn, "migration");

        # Request after migration
        hash<auto> resp2 = doSyncRequest(conn, "GET", "/echo");
        assertEq(200, resp2.status_code, "post-migration request succeeds");

        # Verify connection is still ready
        assertTrue(conn.isReady(), "connection still ready after migration");
    }

    #! Test: start large streaming response → migrate mid-stream → verify all data arrives
    testMigrationDuringStreaming() {
        Http3ClientConnection conn = createReadyConnection();
        on_exit { try { conn.close(); } catch () {} }

        # Pre-migration request to fully establish the connection
        hash<auto> pre = doSyncRequest(conn, "GET", "/echo");
        assertEq(200, pre.status_code, "pre-migration request succeeds");

        int body_size = 1000000;

        hash<auto> req = conn.submitRequest("GET", sprintf("/large/%d", body_size));
        Future f = req.future;

        # Migrate mid-stream — the request is in-flight via the controller
        migrateAndCheck(conn, "migration during streaming");

        # Wait for the Future to resolve; use 60s timeout because RFC 9000 §9.4
        # resets the congestion window after migration, and QUIC retransmission
        # of lost packets at slow-start rates can take significant time under
        # CI load
        hash<auto> result = f.get(60s);

        assertEq(200, result.status_code, "streaming response status after migration");
        # HTTP/3 response body comes as binary from the C++ layer
        string body_str = result.body.typeCode() == NT_BINARY ? binary_to_string(result.body) : result.body;
        assertEq(body_size, body_str.size(), "streaming response body size after migration");
        assertEq(strmul("M", body_size), body_str, "streaming response body content matches");
    }

    #! Test: migrate 3 times with I/O between each → verify final state consistent
    /** Performs successive migrations with a request between each to verify the new path is usable.  A migration
        does not wait for the validation of the previous path: ngtcp2 abandons a validation that is still running
        when the next migration is made.
    */
    testMultipleMigrations() {
        Http3ClientConnection conn = createReadyConnection();
        on_exit { try { conn.close(); } catch () {} }

        # Initial request to ensure the connection is fully established
        hash<auto> resp0 = doSyncRequest(conn, "GET", "/echo");
        assertEq(200, resp0.status_code, "initial request succeeds");

        for (int i = 0; i < 3; ++i) {
            migrateAndCheck(conn, sprintf("migration %d", i + 1));
            # Do a request to verify the connection works after this migration
            hash<auto> mid_resp = doSyncRequest(conn, "GET", "/echo");
            assertEq(200, mid_resp.status_code, sprintf("request after migration %d succeeds", i + 1));
        }

        # Verify connection still works with a POST body
        hash<auto> resp = doSyncRequest(conn, "POST", "/echo", NOTHING, "after-multiple-migrations");
        assertEq(200, resp.status_code, "request after multiple migrations succeeds");
        # HTTP/3 response body comes as binary from the C++ layer
        string body_str = resp.body.typeCode() == NT_BINARY ? binary_to_string(resp.body) : resp.body;
        assertEq("after-multiple-migrations", body_str,
            "response body correct after multiple migrations");
        assertTrue(conn.isReady(), "connection still ready after multiple migrations");
    }

    #! Test: migrate idle connection → verify keep-alive works on new path
    testIdleMigration() {
        Http3ClientConnection conn = createReadyConnection();
        on_exit { try { conn.close(); } catch () {} }

        # Do an initial request
        hash<auto> resp1 = doSyncRequest(conn, "GET", "/echo");
        assertEq(200, resp1.status_code, "initial request succeeds");

        # Migrate the idle connection; the next request is sent on the new path at once
        migrateAndCheck(conn, "idle migration");

        # Verify it still works
        hash<auto> resp2 = doSyncRequest(conn, "POST", "/echo", NOTHING, "after-idle-migration");
        assertEq(200, resp2.status_code, "request after idle migration succeeds");
        string body2 = resp2.body.typeCode() == NT_BINARY ? binary_to_string(resp2.body) : resp2.body;
        assertEq("after-idle-migration", body2, "response correct after idle migration");
    }

    #! Test: 10 in-flight requests → migrate → all complete successfully
    testConcurrentStreamsMigration() {
        Http3ClientConnection conn = createReadyConnection();
        on_exit { try { conn.close(); } catch () {} }

        # Pre-migration request to complete a full I/O cycle
        hash<auto> pre = doSyncRequest(conn, "GET", "/echo");
        assertEq(200, pre.status_code, "pre-migration request succeeds");

        int num_requests = 10;
        list<Future> futures;

        # Submit multiple concurrent requests
        for (int i = 0; i < num_requests; ++i) {
            string req_body = sprintf("concurrent-%d", i);
            hash<auto> req = conn.submitRequest("POST", "/echo", NOTHING, req_body);
            futures += req.future;
        }

        # Migrate while requests are in-flight (controller drives I/O)
        migrateAndCheck(conn, "migration with concurrent streams");

        # Wait for all Futures to resolve
        hash<string, hash<auto>> results;
        hash<string, hash<auto>> errors;
        for (int i = 0; i < num_requests; ++i) {
            string key = string(i);
            try {
                results{key} = futures[i].get(15s);
            } catch (hash<ExceptionInfo> ex) {
                errors{key} = ex;
            }
        }

        # Verify all requests succeeded
        assertEq(0, errors.size(), "no errors in concurrent requests after migration");
        assertEq(num_requests, results.size(), "all concurrent requests completed after migration");
        for (int i = 0; i < num_requests; ++i) {
            string key = string(i);
            assertEq(200, results{key}.status_code,
                sprintf("concurrent request %d status", i));
        }
    }

    #! Test: Http3ClientConnectionManager.migrateAll()
    testMigrateAll() {
        HttpClientIo::HttpClientConnectionManager mgr(
            <HttpClientIo::HttpClientConnectionManagerOptions>{
                "protocol": "h3",
                "logger": mLogger,
                "request_timeout": 15s,
                "connect_timeout": 15s,
            },
        );
        on_exit { try { mgr.closeAll(); } catch () {} }

        # Do a request to establish a connection
        hash<auto> resp1 = mgr.request(mH3Url, "GET", "/echo");
        assertEq(200, resp1.status_code, "initial request via manager succeeds");

        # Get stats to verify we have at least one connection
        hash<auto> stats = mgr.getStats();
        assertTrue(stats.total_connections > 0, "manager has connections before migration");

        # Migrate all connections
        int migrated = mgr.migrateAll();
        assertTrue(migrated > 0, "migrateAll migrated at least one connection");

        # Verify connections still work after migration
        hash<auto> resp2 = mgr.request(mH3Url, "POST", "/echo", NOTHING, "after-migrateAll");
        assertEq(200, resp2.status_code, "request after migrateAll succeeds");
        string body2 = resp2.body.typeCode() == NT_BINARY ? binary_to_string(resp2.body) : resp2.body;
        assertEq("after-migrateAll", body2, "response body correct after migrateAll");
    }

    #! Test: attempt migration during handshake → verify error
    testMigrationBeforeHandshake() {
        hash<auto> url_info = {
            "host": "127.0.0.1",
            "port": mH3Port,
            "protocol": "https",
        };
        Http3ClientConnection conn(url_info, 15s, mLogger, HttpClientIo::DefaultMaxStreamsPerConnection,
            NOTHING, True);
        on_exit { try { conn.close(); } catch () {} }

        # Do NOT drive to ready — attempt migration while still connecting
        assertThrows("HTTP3-STATE-ERROR", sub () {
            conn.migrate();
        }, NOTHING, "migration before handshake throws HTTP3-STATE-ERROR");
    }

    #! Test: many successive migrations → verify CID replenishment and connection stability
    /** Each migration uses a spare connection ID of the server and retires the ID of the path it leaves; the server
        replaces a retired ID one PTO after it learned of the retirement, and it keeps at most 8 IDs including the
        retired ones, so it provides fewer spare connection IDs than 10 within a PTO (see
        @ref testRefusedMigration()).  A migration that finds no spare ID waits for the replacement, so 10 migrations
        succeed with a request between them.
    */
    testCidReplenishment() {
        Http3ClientConnection conn = createReadyConnection();
        on_exit { try { conn.close(); } catch () {} }

        # Initial request to fully establish the connection
        hash<auto> resp0 = doSyncRequest(conn, "GET", "/echo");
        assertEq(200, resp0.status_code, "initial request succeeds");

        for (int i = 0; i < 10; ++i) {
            migrateAndCheck(conn, sprintf("migration %d", i + 1));
            # Verify connection works after each migration
            hash<auto> mid_resp = doSyncRequest(conn, "GET", "/echo");
            assertEq(200, mid_resp.status_code,
                sprintf("request after migration %d succeeds", i + 1));
        }
    }

    #! Test: migrations made one right after the other wait for the server's new connection IDs
    /** No request is made between the migrations, and they come faster than the server replaces the connection IDs
        they retire (one PTO after the retirement): the migrations after the 7th wait for a new ID, and all 10 move the
        connection to a new path
    */
    testBackToBackMigrations() {
        Http3ClientConnection conn = createReadyConnection();
        on_exit { try { conn.close(); } catch () {} }

        hash<auto> resp0 = doSyncRequest(conn, "GET", "/echo");
        assertEq(200, resp0.status_code, "initial request succeeds");

        for (int i = 0; i < 10; ++i) {
            migrateAndCheck(conn, sprintf("migration %d", i + 1));
        }
        hash<auto> resp = doSyncRequest(conn, "GET", "/echo");
        assertEq(200, resp.status_code, "the connection works on its last path");
    }

    #! Helper: starts a raw QUIC server; returns the context of the test
    /** The server reads the connection only while an operation of the test runs on its socket, so once it has
        answered a request it processes no packet of the client: it never replaces the spare connection IDs that
        the client's migrations use.
    */
    private hash<auto> startRawQuicServer() {
        Socket sock();
        sock.bindINET("127.0.0.1", "0", False, AF_INET, SOCK_DGRAM);
        sock.setCertificate(new SSLCertificate(CertPem));
        sock.setPrivateKey(new SSLPrivateKey(KeyPem));
        AsyncSocketIo::AsyncSocketIoController ctrl = AsyncSocketIo::getGlobalAsyncIoController();
        AbstractPollOperation accept_op = sock.startPollQuicAccept();
        string owner = sock.uniqueHash();
        return {
            "sock": sock,
            "ctrl": ctrl,
            "owner": owner,
            "accept_op": accept_op,
            "accept_q": ctrl.submit(<SocketPollOperationInfo>{
                "sock": sock,
                "spop": accept_op,
                "owner": owner,
                "to": 30s,
            }),
            "url": sprintf("https://127.0.0.1:%d", sock.getSocketInfo().port),
            "url_info": {
                "host": "127.0.0.1",
                "port": sock.getSocketInfo().port,
                "protocol": "https",
            },
        };
    }

    #! Helper: answers the next request on the raw QUIC server; the server reads nothing afterwards
    private answerRawQuicRequest(hash<auto> ctx) {
        hash<SocketPollResultInfo> result = ctx.accept_q.get(20000);
        if (result.ex) {
            throw result.ex.err, result.ex.desc, result.ex.arg;
        }
        hash<auto> req = ctx.accept_op.getOutput();
        AbstractPollOperation send_op = ctx.sock.startPollQuicSendResponse(req.session_id, req.stream_id, 200,
            {"content-type": "text/plain"}, "ok");
        result = ctx.ctrl.submit(<SocketPollOperationInfo>{
            "sock": ctx.sock,
            "spop": send_op,
            "owner": ctx.owner,
            "key": sprintf("send-%d-%d", req.session_id, req.stream_id),
            "to": 30s,
        }, True).get(20000);
        if (result.ex) {
            throw result.ex.err, result.ex.desc, result.ex.arg;
        }
    }

    #! Test: a migration for which the server provides no spare connection ID times out
    /** The raw server stops reading after its answer, so it provides no new connection IDs: the migrations use up
        the spare connection IDs it gave the client, and the next one waits for one until its timeout expires, and
        leaves the connection on its path.  The bound of the other migrations only guards against a hang.
    */
    testRefusedMigration() {
        hash<auto> ctx = startRawQuicServer();
        on_exit try { ctx.ctrl.cancelByOwner(ctx.owner); } catch () {}
        Http3ClientConnection conn(ctx.url_info, 15s, mLogger, HttpClientIo::DefaultMaxStreamsPerConnection,
            NOTHING, True);
        on_exit { try { conn.close(); } catch () {} }
        registerConnection(conn);
        assertTrue(conn.waitForReady(15s), "connection should become ready");

        Future f = conn.submitRequest("GET", "/first").future;
        answerRawQuicRequest(ctx);
        assertEq(200, f.get(15s).status_code, "the request is answered");

        # the client can use at most all but one of its active connection IDs (8, QUIC_ACTIVE_CONNECTION_ID_LIMIT)
        *hash<ExceptionInfo> refused;
        int migrated = 0;
        for (int i = 0; i < 8; ++i) {
            int old_port = getLocalPort(conn);
            try {
                conn.migrate(2s);
            } catch (hash<ExceptionInfo> ex) {
                refused = ex;
                assertEq(old_port, getLocalPort(conn), "a migration that times out leaves the connection on its path");
                break;
            }
            assertNeq(old_port, getLocalPort(conn), sprintf("migration %d: a new local port", i + 1));
            ++migrated;
        }
        assertGt(0, migrated, "the spare connection IDs are used");
        assertEq("HTTP3-MIGRATION-TIMEOUT", refused.err, sprintf("the migration times out: %y", refused));
        assertRegex("no spare connection ID became available", refused.desc);
    }

    #! Test: migrateAll() drains a connection that cannot be migrated
    testMigrateAllRefused() {
        hash<auto> ctx = startRawQuicServer();
        on_exit try { ctx.ctrl.cancelByOwner(ctx.owner); } catch () {}
        HttpClientIo::HttpClientConnectionManager mgr(<HttpClientIo::HttpClientConnectionManagerOptions>{
            "protocol": "h3",
            "logger": mLogger,
            "accept_all_certs": True,
            "request_timeout": 15s,
            "connect_timeout": 15s,
        });
        on_exit { try { mgr.closeAll(); } catch () {} }

        HttpCancellableFuture f = mgr.requestAsync(ctx.url, "GET", "/first");
        answerRawQuicRequest(ctx);
        assertEq(200, f.get(15s).status_code, "the request is answered");

        # each call migrates the connection until the server's spare connection IDs are used up; the bound of each
        # migration only guards against a hang, except for the last one, which times out
        int calls = 0;
        while (mgr.migrateAll(2s)) {
            ++calls;
            assertGt(calls, 8, "the spare connection IDs are used up");
        }
        hash<auto> host = mgr.getStats().per_host.firstValue();
        assertEq(1, host.draining, "the connection that cannot be migrated drains");
        assertEq(0, host.usable_connections, "the connection takes no new request");
    }

    #! Helper: creates a connection to the HTTP server that the test drives itself, until it is ready
    /** No I/O thread drives the connection: a step runs only when the test calls continuePoll()
    */
    private Http3ClientConnection createManuallyDrivenConnection() {
        Http3ClientConnection conn(<auto>{
            "host": "127.0.0.1",
            "port": mH3Port,
            "protocol": "https",
        }, 15s, mLogger, HttpClientIo::DefaultMaxStreamsPerConnection, NOTHING, True);
        HttpClientIo::HttpClientPollOperation op = conn.getPollOperation();
        while (!conn.isReady()) {
            *hash<SocketPollInfo> info = op.continuePoll();
            if (!info) {
                throw "CONNECT-ERROR", sprintf("the connection did not become ready: %y", op.getError());
            }
            # with a poll_timeout_ms hint, Socket::poll() returns when the hint expires, and the operation is
            # continued
            if (!Socket::poll((info,), 15s) && !exists info.poll_timeout_ms) {
                throw "POLL-TIMEOUT", sprintf("no socket event (events: %d) within 15s", info.events);
            }
        }
        return conn;
    }

    #! Test: a migration that the I/O thread does not start within the timeout is withdrawn
    testMigrationTimeout() {
        Http3ClientConnection conn = createManuallyDrivenConnection();
        on_exit { try { conn.close(); } catch () {} }

        # nothing drives the connection, so nothing can start the migration
        int old_port = getLocalPort(conn);
        assertThrows("HTTP3-MIGRATION-TIMEOUT", \conn.migrate(), 100ms);
        assertEq(old_port, getLocalPort(conn), "the connection was not migrated");

        # a step of the connection does not make the withdrawn migration
        HttpClientIo::HttpClientPollOperation op = conn.getPollOperation();
        op.continuePoll();
        assertEq(old_port, getLocalPort(conn), "the withdrawn migration is not made");
        assertTrue(conn.isReady());
    }

    #! Test: a migration requested before the connection closes raises HTTP3-CONNECTION-CLOSED
    testMigrationConnectionClosed() {
        Http3ClientConnection conn = createManuallyDrivenConnection();
        on_exit { try { conn.close(); } catch () {} }
        Http3ClientPollOperation op = cast<Http3ClientPollOperation>(conn.getPollOperation());

        int id = op.migrate();
        # the controller aborts the operation of a connection that closes
        op.abort();
        assertThrows("HTTP3-CONNECTION-CLOSED", \op.waitForMigration(), (id, 15s));
        # a closed connection takes no migration request
        assertThrows("HTTP3-CONNECTION-CLOSED", \op.requestMigration());
    }

    #! Test: client sends large POST body → migrate mid-upload → verify upload completes
    testMigrationDuringUpload() {
        Http3ClientConnection conn = createReadyConnection();
        on_exit { try { conn.close(); } catch () {} }

        # Pre-migration request to fully establish the connection
        hash<auto> pre = doSyncRequest(conn, "GET", "/echo");
        assertEq(200, pre.status_code, "pre-migration request succeeds");

        string upload_body = strmul("U", 1000000);

        hash<auto> req = conn.submitRequest("POST", "/echo", NOTHING, upload_body);
        Future f = req.future;

        # Migrate mid-upload — the request is in-flight via the controller
        assertTrue(conn.migrate(), "migration during upload succeeds");

        # Wait for the Future to resolve
        hash<auto> result = f.get(60s);

        assertEq(200, result.status_code, "upload response status after migration");
        # The echo handler echoes the body back
        string resp_body = result.body.typeCode() == NT_BINARY
            ? binary_to_string(result.body) : result.body;
        assertEq(upload_body.size(), resp_body.size(),
            "upload response body size matches after migration");
        assertEq(upload_body, resp_body, "upload response body content matches after migration");
    }
}
