#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - HTTP/1.1 response send progress on a backpressured TCP socket

%modern
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires HttpServer
%requires QUnit
%requires FsUtil
%requires Util
%exec-class HttpServerResponseSendProgressTest

class ProgressHandler inherits AbstractHttpRequestHandler {
    public {
        Queue sent();
        const Size = 16 * 1024 * 1024;
        #! the FIFO that the body of an /idle response is read from: the test writes it
        *string fifo;
        #! the size of each of the two parts of an /idle response
        const PartSize = 1024;
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        if (hdr.path =~ /ping$/) {
            return makeResponse(200, "ok");
        }
        if (hdr.path =~ /idle$/) {
            # the open waits for the test's writer, and the last byte can only be sent when the test has written it
            return makeResponse(200, new FileInputStream(fifo), {"Content-Length": PartSize * 2});
        }
        binary payload = binary(strmul("x", Size));
        if (hdr.path =~ /stream$/) {
            return makeResponse(200, new BinaryInputStream(payload), {"Content-Length": Size});
        }
        hash<HttpResponseInfo> response = makeResponse(200, payload, {"Content-Type": "application/octet-stream"});
        if (hdr.path =~ /stalled$/) {
            response.after_send = sub (hash<auto> cx, bool success) { sent.push(success); };
        }
        return response;
    }
}

class HttpServerResponseSendProgressTest inherits QUnit::Test {
    constructor() : QUnit::Test("HTTP/1.1 response send progress", "1.0", \ARGV) {
        addTestCase("a buffered response completes while the peer keeps reading", sub () { progress(False); });
        addTestCase("a streamed response leaves time for another request", sub () { progress(True); });
        addTestCase("the send bound renews with each progress and ends a stalled send", \boundSteps());
        addTestCase("a response times out when the peer stops reading", \stalled());
        addTestCase("the minimum rate bounds a progressing response", \belowRate());
        addTestCase("the keep-alive idle time starts after the last response byte", \idleAfterLastByte());
        addTestCase("an idle connection is closed once its idle time has passed", \idleExpires());
        set_return_value(main());
    }

    #! the client reads the whole response, which the server sends as the client's reads make room for it, and a
    #! streamed response's connection then serves another request
    /** The bound of the send by its progress is checked without a clock in boundSteps(); here the timeouts are only
        a safety net, so that the result does not depend on the load of the machine (qore#7835)
    */
    progress(bool stream) {
        HttpServer server(<HttpServerOptionInfo>{"io_operation_timeout": 60s, "ttl": 60s});
        on_exit server.stop();
        server.setDefaultHandler("large", new ProgressHandler());
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        Socket client();
        client.connect("127.0.0.1:" + port);
        on_exit client.close();
        client.send(sprintf("GET /%s HTTP/1.1\r\nHost: localhost\r\nConnection: %s\r\n\r\n",
            stream ? "stream" : "buffer", stream ? "keep-alive" : "close"));
        hash<auto> header = client.readHTTPHeader(60s);
        assertEq(ProgressHandler::Size, header."content-length".toInt());
        int total = 0;
        # the server sends a TCP window at a time, as the reads make room for it
        while (total < ProgressHandler::Size) {
            *binary chunk = client.recvBinary(min(256 * 1024, ProgressHandler::Size - total), 60s);
            if (!chunk) {
                break;
            }
            total += chunk.size();
        }
        assertEq(ProgressHandler::Size, total, "complete response body");
        if (stream) {
            client.send("GET /ping HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n");
            client.readHTTPHeader(60s);
            assertEq("ok", client.recv(2, 60s));
        }
    }

    #! the keep-alive idle time (ttl) starts after the last byte of a response, not when its send starts
    /** The response's last byte can only be sent when the test writes it to the FIFO that the body is read from; the
        clock of the idle deadlines is moved past twice the ttl while the response is being sent, so the connection
        serves another request only if the idle time starts after the last byte.  The clock is moved with
        dbg_http_idle_clock_offset() (debug builds), so the result does not depend on the load of the machine
        (qore#7855)
    */
    idleAfterLastByte() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("dbg_http_idle_clock_offset() is only in a debug build of the library");
        }
        string dir = make_tmp_dir("http-idle-clock");
        on_exit remove_tree(dir);
        ProgressHandler handler();
        handler.fifo = dir + "/body";
        mkfifo(handler.fifo);
        HttpServer server(<HttpServerOptionInfo>{"io_operation_timeout": 60s, "ttl": 60s});
        on_exit server.stop();
        on_exit call_function("dbg_http_idle_clock_offset", 0);
        server.setDefaultHandler("idle", handler);
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        Socket client();
        client.connect("127.0.0.1:" + port);
        on_exit client.close();
        client.send("GET /idle HTTP/1.1\r\nHost: localhost\r\nConnection: keep-alive\r\n\r\n");
        # the open waits for the handler to open the FIFO for reading
        File w();
        w.open2(handler.fifo, O_WRONLY);
        on_exit w.close();
        w.write(binary(strmul("a", ProgressHandler::PartSize)));
        hash<auto> header = client.readHTTPHeader(60s);
        assertEq(200, header.status_code);
        assertEq(ProgressHandler::PartSize * 2, header."content-length".toInt());
        assertEq(ProgressHandler::PartSize, recvAll(client, ProgressHandler::PartSize).size(), "first part");
        # the response is being sent: the server waits for the rest of the body; twice the ttl passes
        call_function("dbg_http_idle_clock_offset", 120s);
        w.write(binary(strmul("b", ProgressHandler::PartSize)));
        w.close();
        assertEq(binary(strmul("b", ProgressHandler::PartSize)), recvAll(client, ProgressHandler::PartSize),
            "last part");
        # the ttl starts after the last byte: the connection serves another request
        client.send("GET /ping HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n");
        assertEq(200, client.readHTTPHeader(60s).status_code);
        assertEq("ok", client.recv(2, 60s));
    }

    #! a connection that waits for the next request longer than the keep-alive idle time (ttl) is closed
    /** The negative counterpart of idleAfterLastByte(): the same clock, moved past the ttl after a response, ends the
        connection instead of letting it serve the next request (qore#7855)
    */
    idleExpires() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("dbg_http_idle_clock_offset() is only in a debug build of the library");
        }
        HttpServer server(<HttpServerOptionInfo>{"io_operation_timeout": 60s, "ttl": 60s});
        on_exit server.stop();
        on_exit call_function("dbg_http_idle_clock_offset", 0);
        server.setDefaultHandler("idle", new ProgressHandler());
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        Socket client();
        client.connect("127.0.0.1:" + port);
        on_exit client.close();
        client.send("GET /ping HTTP/1.1\r\nHost: localhost\r\nConnection: keep-alive\r\n\r\n");
        assertEq(200, client.readHTTPHeader(60s).status_code);
        assertEq("ok", client.recv(2, 60s));
        # the connection waits for the next request: its ttl passes
        call_function("dbg_http_idle_clock_offset", 120s);
        client.send("GET /ping HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n");
        # the server closes the connection without a response
        string rest;
        try {
            rest = client.recv(-1, 60s) ?? "";
        } catch (hash<ExceptionInfo> ex) {
            # a reset of the connection ends it as well
            rest = "";
        }
        assertEq("", rest, "no response after the idle time");
    }

    #! reads exactly the given number of bytes
    private binary recvAll(Socket client, int size) {
        binary rv = binary();
        while (rv.size() < size) {
            *binary chunk = client.recvBinary(size - rv.size(), 60s);
            if (!chunk) {
                break;
            }
            rv += chunk;
        }
        return rv;
    }

    #! the bound of an HTTP/1 response send by its progress, checked step by step without a socket or a clock
    /** The time of the whole send is many times the stall timeout, but each delivery comes within it, so every step
        renews the bound; without delivery, the send fails once the stall timeout has passed; a fused operation that
        waits for the next request is not measured.  The steps run with dbg_http_send_bound_steps() (debug builds), so
        the result does not depend on the load of the machine (qore#7835)
    */
    boundSteps() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("dbg_http_send_bound_steps() is only in a debug build of the library");
        }
        const int Stall = 750;
        # a delivery every 500 ms for 32 s
        list<hash<auto>> steps = ();
        int delivered = 0;
        int now = 0;
        for (int i = 0; i < 64; ++i) {
            delivered += 256 * 1024;
            now += 500;
            steps += {"delivered": delivered, "now": now};
        }
        # no delivery: still within the stall timeout, then past it
        steps += {"delivered": delivered, "now": now + Stall - 1};
        steps += {"delivered": delivered, "now": now + Stall};
        list<hash<auto>> r = call_function("dbg_http_send_bound_steps", Stall, 0, 300, steps);
        assertEq(66, r.size());
        assertEq(64, (select r[0..63], $1.result == "ok" && $1.renewed).size(),
            "each delivery renews the bound, for many times the stall timeout");
        assertEq(Stall / 2, r[63].wake, "the next check comes after half of the stall timeout");
        assertEq({"result": "ok", "wake": 1, "renewed": False}, r[64], "no delivery, within the stall timeout");
        assertEq("stalled", r[65].result, "no delivery for the stall timeout");

        # a fused operation waiting for the next request is not measured, and a new response starts a new bound
        r = call_function("dbg_http_send_bound_steps", Stall, 0, 300, (
            {"delivered": 1000, "now": 0},
            {"delivered": -1, "now": 5000},
            {"delivered": 0, "now": 10000},
            {"delivered": 0, "now": 10000 + Stall - 1},
        ));
        assertEq(("ok", "not-measured", "ok", "ok"), (map $1.result, r));
        assertEq((True, True, True, False), (map $1.renewed, r));

        # the minimum rate: a client that takes less than it fails; one that takes more does not
        list<hash<auto>> slow = ();
        list<hash<auto>> fast = ();
        for (int i = 1; i <= 40; ++i) {
            slow += {"delivered": i * 1024, "now": i * 100};
            fast += {"delivered": i * 1024 * 1024, "now": i * 100};
        }
        list<hash<auto>> slow_steps = call_function("dbg_http_send_bound_steps", 60000, 1024 * 1024, 300, slow);
        list<string> slow_results = map $1.result, slow_steps;
        assertTrue(slow_results.contains("below-rate"), sprintf("a slow client is below the rate: %y", slow_results));
        list<hash<auto>> fast_steps = call_function("dbg_http_send_bound_steps", 60000, 1024 * 1024, 300, fast);
        assertEq(40, (select fast_steps, $1.result == "ok").size(),
            "a fast client is not below the rate");
    }

    stalled() {
        HttpServer server(<HttpServerOptionInfo>{"io_operation_timeout": 750ms});
        on_exit server.stop();
        ProgressHandler handler();
        server.setDefaultHandler("large", handler);
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0,
            "stream_send_min_rate": 0}).port;
        Socket client();
        client.connect("127.0.0.1:" + port);
        on_exit client.close();
        client.send("GET /stalled HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n");
        client.readHTTPHeader(5s);
        # Leave the receive buffer full until the server reports the failed send.
        assertEq(False, handler.sent.get(10s));
    }

    belowRate() {
        HttpServer server(<HttpServerOptionInfo>{"io_operation_timeout": 15s});
        on_exit server.stop();
        server.setDefaultHandler("large", new ProgressHandler());
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0,
            "stream_send_min_rate": 128 * 1024 * 1024, "stream_send_min_rate_window": 300ms}).port;
        Socket client();
        client.connect("127.0.0.1:" + port);
        on_exit client.close();
        client.send("GET /buffer HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n");
        client.readHTTPHeader(5s);
        int total = 0;
        try {
            while (total < ProgressHandler::Size) {
                *binary part = client.recvBinary(256 * 1024, 5s);
                if (!part) {
                    break;
                }
                total += part.size();
                usleep(30000);
            }
        } catch (hash<ExceptionInfo> ex) {
            assertEq("SOCKET-CLOSED", ex.err);
        }
        assertTrue(total > 0 && total < ProgressHandler::Size, "the slow transfer ends early");
    }
}
