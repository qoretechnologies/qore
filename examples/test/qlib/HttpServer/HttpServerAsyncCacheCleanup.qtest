#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - async socket I/O, TLS and HTTP/2 connections of the HTTP server and their cleanup

# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires Logger
%requires HttpServerUtil
%requires AsyncSocketIo
%requires HttpServerAsyncIo
%requires HttpServer
%requires ../../TestCertificates.qm

%exec-class HttpServerAsyncCacheCleanupTest

/** The controller logs the end of an HTTP/1.x connection (\c "Connection closed: ...") and of an HTTP/2 connection
    (\c "HTTP/2 connection closed...", at the \c DEBUG level) in the callback that removes the connection and then
    cancels its operation (qore#6479)
*/
class ConnectionCloseAppender inherits LoggerAppenderWithLayout {
    private {
        #! the ends of HTTP/1.x connections
        Queue h1_closed();
        #! the ends of HTTP/2 connections
        Queue h2_closed();
    }

    constructor() : LoggerAppenderWithLayout("connection-close", new LoggerLayoutPattern("%m")) {
        open();
    }

    processEventImpl(int type, auto params) {
        if (type != EVENT_LOG) {
            return;
        }
        if (params =~ /^Connection closed: /) {
            h1_closed.push(params);
        } else if (params =~ /^HTTP\/2 connection closed/) {
            h2_closed.push(params);
        }
    }

    #! Waits for the given number of connections to end
    /** @param http2 True for HTTP/2 connections, False for HTTP/1.x connections
        @param count the number of connections
        @param max_wait a guard against a hang: the connections that end in the time are not checked

        @return the number of the connections that ended
    */
    int wait(bool http2, int count, timeout max_wait = 2m) {
        Queue q = http2 ? h2_closed : h1_closed;
        int ended = 0;
        try {
            while (ended < count) {
                q.get(max_wait);
                ++ended;
            }
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "QUEUE-TIMEOUT") {
                rethrow;
            }
        }
        return ended;
    }
}

#! answers each request with its method and path
class ReqHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, hdr.method + ", " + hdr.path + ", " + cx.raw_path);
    }
}

#! The async I/O cache returns to its size before connections were made once they have ended
/** The cache that the case measures is process-wide: the case runs in a process of its own, where no other server
    (such as the shared fixture of HttpServer.qtest, whose connections are made and ended between its cases) changes it
    while the case runs (qore#6713)
*/
class HttpServerAsyncCacheCleanupTest inherits QUnit::Test {
    public {
        const CertPem = TestCertificates::CertPem;
        const KeyPem = TestCertificates::KeyPem;
    }

    constructor() : QUnit::Test("HttpServerAsyncCacheCleanup", "1.0", \ARGV) {
        addTestCase("async mode cache cleanup", \asyncModeCacheCleanupTest());
        set_return_value(main());
    }

    /** This test verifies that the AsyncSocketIoController cache is properly cleaned up
        when connections close. This is the fix for the CLOSE-WAIT socket leak bug where
        poll operations stayed in the cache even after connections were closed, preventing
        Socket objects from being destroyed and their destructors (which call close()) from
        running.
    */
    asyncModeCacheCleanupTest() {
        # the DEBUG level for the end of an HTTP/2 connection
        Logger logger("async-cache-cleanup-test", LoggerLevel::getLevelDebug());
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }
        # the cache is checked when the server has handled the end of each connection, not after a time (qore#6479)
        ConnectionCloseAppender closes();
        logger.addAppender(closes);
        hash<HttpServerOptionInfo> opts = <HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        };
        HttpServer server(opts);
        on_exit server.stop();

        # Set up a simple handler
        server.setDefaultHandler("test-handler", new ReqHandler());

        # Add listener
        int test_port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        assertTrue(server.waitForAsyncIo(5s), "async I/O should be ready");

        # the listener's accept operations are submitted and its callbacks have run
        waitForAsyncCallbacks(server);

        # Get baseline cache size (should just be accept operations)
        int baseline_cache_size = server.getHttpAsyncIo().getTotalCacheSize();
        if (m_options.verbose > 1) {
            printf("Baseline cache size: %d\n", baseline_cache_size);
        }

        # Test 1: HTTP/1.1 connections - create many connections, close them, verify cleanup
        {
            int num_connections = 20;
            list<HTTPClient> clients = ();

            # Create many connections
            for (int i = 0; i < num_connections; ++i) {
                HTTPClient client({"url": "http://127.0.0.1:" + test_port, "timeout": 5s});
                client.connect();
                try {
                    assertEq("GET, test, /test", client.get("/test"));
                } catch (hash<ExceptionInfo> ex) {
                    printf("Connection %d/%d FAILED: %s: %s (port: %d)\n",
                        i, num_connections, ex.err, ex.desc, test_port);
                    printf("  test_port: %d\n", test_port);
                    printf("  globalAsyncCtrl cache: %d\n",
                        server.getHttpAsyncIo().getTotalCacheSize());
                    rethrow;
                }
                clients += client;
            }

            # Verify cache has grown (connections are active): the callbacks of the requests have resubmitted the
            # connections' operations
            waitForAsyncCallbacks(server);
            int active_cache_size = server.getHttpAsyncIo().getTotalCacheSize();
            if (m_options.verbose > 1) {
                printf("Active cache size with %d connections: %d\n", num_connections, active_cache_size);
            }
            assertTrue(active_cache_size > baseline_cache_size,
                "cache should grow when connections are active");

            # Close all connections - this should trigger cache cleanup
            map $1.disconnect(), clients;
            delete clients;

            # Wait until the server has handled the end of each connection and canceled its operation
            waitForConnectionsClosed(server, closes, False, num_connections);
            int final_cache_size = server.getHttpAsyncIo().getTotalCacheSize();
            if (m_options.verbose > 1) {
                printf("Final cache size after disconnect: %d\n", final_cache_size);
            }
            assertEq(baseline_cache_size, final_cache_size,
                "cache should return to baseline after all connections close");

            # Verify we can still make new connections (cache is clean)
            HTTPClient verify_client({"url": "http://127.0.0.1:" + test_port, "timeout": 2s});
            verify_client.connect();
            assertEq("GET, test2, /test2", verify_client.get("/test2"));
            verify_client.disconnect();
            # its end must not change the HTTP/2 cache sizes below
            waitForConnectionsClosed(server, closes, False, 1);
        }

        # Test 2: HTTP/2 connections - same test with HTTP/2 over SSL
        {
            # Create HTTPS listener for HTTP/2
            hash<auto> ssl_info = server.addListener(<HttpListenerOptionInfo>{
                "node": "127.0.0.1",
                "service": 0,
                "cert": new SSLCertificate(CertPem),
                "key": new SSLPrivateKey(KeyPem),
            });
            int ssl_port = ssl_info.port;

            # Get baseline after adding SSL listener (includes accept ops for both listeners)
            waitForAsyncCallbacks(server);
            int h2_baseline = server.getHttpAsyncIo().getTotalCacheSize();
            if (m_options.verbose > 1) {
                printf("HTTP/2 baseline cache size: %d\n", h2_baseline);
            }

            int num_connections = 20;
            list<HTTPClient> clients = ();

            # Create many HTTP/2 connections (HTTP/2 is negotiated via ALPN over SSL)
            for (int i = 0; i < num_connections; ++i) {
                HTTPClient client({"url": "https://127.0.0.1:" + ssl_port, "timeout": 2s,
                    "ssl_verify_cert": False, "http2": True});
                client.connect();
                assertEq("GET, test, /test", client.get("/test"));
                clients += client;
            }

            # Verify cache has grown (HTTP/2 connections are active)
            waitForAsyncCallbacks(server);
            int h2_active = server.getHttpAsyncIo().getTotalCacheSize();
            if (m_options.verbose > 1) {
                printf("HTTP/2 active cache size with %d connections: %d\n", num_connections, h2_active);
            }
            assertTrue(h2_active > h2_baseline,
                "cache should grow when HTTP/2 connections are active");

            # Close all connections - this should trigger cache cleanup for HTTP/2
            map $1.disconnect(), clients;
            delete clients;

            # Wait until the server has handled the end of each connection and canceled its operation
            waitForConnectionsClosed(server, closes, True, num_connections);
            int h2_final = server.getHttpAsyncIo().getTotalCacheSize();
            if (m_options.verbose > 1) {
                printf("HTTP/2 final cache size after disconnect: %d\n", h2_final);
            }
            assertEq(h2_baseline, h2_final,
                "cache should return to baseline after all HTTP/2 connections close");

            # Verify we can still make new HTTP/2 connections (cache is clean)
            HTTPClient verify_client({"url": "https://127.0.0.1:" + ssl_port, "timeout": 2s,
                "ssl_verify_cert": False, "http2": True});
            verify_client.connect();
            assertEq("GET, test2, /test2", verify_client.get("/test2"));
            verify_client.disconnect();

            server.stopListenerID(ssl_info.id);
        }
    }

    #! Waits until the callbacks of the async I/O controller have run and the I/O threads have handled what they submitted
    private waitForAsyncCallbacks(HttpServer server) {
        server.getGlobalAsyncCtrl().flushCallbacks();
        assertTrue(server.waitForAsyncIo(2m), "async I/O should process the submitted operations");
    }

    #! Waits until the server has handled the end of the given number of connections
    /** The callback that logs the end of a connection then cancels its operation: the operation is out of the cache
        when the callback has returned
    */
    private waitForConnectionsClosed(HttpServer server, ConnectionCloseAppender closes, bool http2, int count) {
        assertEq(count, closes.wait(http2, count), sprintf("the server should handle the end of %d HTTP/%s "
            "connection(s)", count, http2 ? "2" : "1.1"));
        waitForAsyncCallbacks(server);
    }
}
