        # request cases: Content-Type, body, and the expected description with the default text encoding
        const Cases = (
            {"ct": "text/plain", "body": <e4>, "expect": {"type": "string", "encoding": "ISO-8859-1", "text": "ä"}},
            {"ct": "text/plain;charset=utf-8", "body": <c3a4>,
                "expect": {"type": "string", "encoding": "UTF-8", "text": "ä"}},
            {"ct": "text/plain", "body": <efbbbfc3a4>,
                "expect": {"type": "string", "encoding": "UTF-8", "text": "ä"}},
            {"ct": "application/json;charset=iso-8859-1", "body": <7b2261223a22c3a4227d>,
                "expect": {"type": "string", "encoding": "UTF-8", "text": "{\"a\":\"ä\"}"}},
            {"ct": "text/html", "body": <3c6d65746120636861727365743d2277696e646f77732d31323532223e80>,
                "expect": {"type": "string", "encoding": "WINDOWS-1252", "text": "<meta charset=\"windows-1252\">€"}},
            {"ct": "application/xml",
                "body": <3c3f786d6c2076657273696f6e3d22312e302220656e636f64696e673d2269736f2d383835392d32223f3e3c613eb13c2f613e>,
                "expect": {"type": "string", "encoding": "ISO-8859-2",
                    "text": "<?xml version=\"1.0\" encoding=\"iso-8859-2\"?><a>ą</a>"}},
            {"ct": "application/octet-stream", "body": <e4f6fc>, "expect": {"type": "binary", "hex": "e4f6fc"}},
        );

        HttpServer server;
        # listener label -> URL
        hash<string, string> urls;
    }

    constructor() : Test("HttpServerRequestCharsetTest", "1.0") {
        addTestCase("request body decoding", \decodingTest());
        addTestCase("default text encoding", \defaultEncodingTest());
        set_return_value(main());
    }

    globalSetUp() {
        server = new HttpServer(<HttpServerOptionInfo>{
            "logger": new Logger("server", LoggerLevel::getLevelError()),
        });
        EchoHandler handler();
        server.setHandler("echo", "", NOTHING, handler);
        server.setDefaultHandler("echo", handler);
        urls."sync h1" = "http://localhost:" + server.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "sync": True,
        }).port;
        urls."async h1" = "http://localhost:" + server.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        urls.h2 = "https://localhost:" + server.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        }).port;
        server.waitForAsyncIo();
    }

    globalTearDown() {
        delete server;
    }

    # sends each case to each listener and checks the body the handler received
    private checkCases(list<hash<auto>> cases, string label) {
        foreach hash<auto> i in (urls.pairIterator()) {
            HTTPClient hc({
                "url": i.value,
                "http_version": i.key == "h2" ? "2.0" : "1.1",
                "ssl_verify_cert": False,
                "timeout": 30s,
            });
            hc.setHttp3Mode("disabled");
            foreach hash<auto> c in (cases) {
                hash<auto> resp = hc.send(c.body, "POST", "/", {"Content-Type": c.ct});
                assertEq(c.expect, parse_json(resp.body), sprintf("%s %s %s", label, i.key, c.ct));
            }
            if (i.key == "h2") {
                assertTrue(hc.isHttp2Active(), label);
            }
        }
    }

    decodingTest() {
        checkCases(Cases, "default");
    }

    # the default text encoding of the server is the assumed encoding: it applies to text without an encoding
    # declaration, and does not override a declared encoding or the encoding of a type such as JSON
    defaultEncodingTest() {
        server.setDefaultTextEncoding("ISO-8859-15");
        on_exit server.setDefaultTextEncoding("ISO-8859-1");
        list<hash<auto>> cases = map $1 + (
            $1.expect.encoding == "ISO-8859-1"
                ? {"expect": {"type": "string", "encoding": "ISO-8859-15", "text": convert_encoding(
                    force_encoding($1.body.toString(), "ISO-8859-15"), "UTF-8")}}
                : {}
            ), Cases;
        # the assumed encoding is used for the first case only
        assertEq("ISO-8859-15", cases[0].expect.encoding);
        assertEq(1, (select cases, $1.expect.encoding == "ISO-8859-15").size());
        cases += {"ct": "text/plain", "body": <a4>, "expect": {"type": "string", "encoding": "ISO-8859-15",
            "text": "€"}};
        checkCases(cases, "ISO-8859-15");
    }
}
