%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires Mime
%requires Logger
%requires HttpServerUtil
%requires HttpServer
%requires json

%exec-class HttpServerRequestCharsetTest

#! Returns a description of the request body as JSON
class EchoHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        hash<auto> rv;
        switch (body.typeCode()) {
            case NT_STRING:
                rv = {"type": "string", "encoding": body.encoding(), "text": convert_encoding(body, "UTF-8")};
                break;
            case NT_BINARY:
                rv = {"type": "binary", "hex": body.toHex()};
                break;
            default:
                rv = {"type": "none"};
                break;
        }
        return <HttpResponseInfo>{
            "code": 200,
            "hdr": {"Content-Type": MimeTypeJson},
            "body": binary(make_json(rv)),
        };
    }
}

