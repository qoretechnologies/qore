    THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
    IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
    FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
    AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
    LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
    FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
    DEALINGS IN THE SOFTWARE.

    A listener on all interfaces never starts on a port that another program uses for IPv4 on 0.0.0.0 or
    127.0.0.1, since that program, not the server, would receive the IPv4 clients of the port: a given port is
    refused, and a system-assigned port is one that no IPv4 socket uses.  The UDP socket of an HTTP/3 listener on all
    interfaces is refused such a port as well.

    The tests can run at the same time as other programs: a port is never released before the test binds it again,
    and the ports held at given numbers are bound without SO_REUSEADDR, so that none is a port that another program
    uses.
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires HttpServerUtil
%requires HttpServer
%requires ../../TestCertificates.qm

%exec-class HttpServerWildcardBindTest

class WildcardBindHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(HttpListenerInterface listener, Socket s, hash<auto> cx, hash<auto> hdr,
            *data body) {
        return <HttpResponseInfo>{"code": 200, "body": "server"};
    }
}

class HttpServerWildcardBindTest inherits QUnit::Test {
    public {
        #! the number of consecutive ports held for the system-assigned port test
        const HeldPorts = 64;

        #! the test certificate and its key
        const CertPem = TestCertificates::CertPem;
        const KeyPem = TestCertificates::KeyPem;
    }

    constructor() : Test("HttpServerWildcardBindTest", "1.0") {
        addTestCase("a given port that another listener holds for IPv4 is refused", \givenPortTest());
        addTestCase("a system-assigned port is one that no IPv4 listener holds", \systemPortTest());
        addTestCase("the HTTP/3 listener of a given port that a datagram socket holds for IPv4 is refused",
            \http3Test());
        set_return_value(main());
    }

    #! returns a listening TCP socket on the given IPv4 address and a system-assigned or given port
    private static Socket listener(string address, int port = 0) {
        Socket s();
        s.bindINET(address, port, True, AF_INET);
        s.listen();
        return s;
    }

    #! returns a listening TCP socket on the given IPv4 address and port that no other socket uses
    /** The socket does not reuse the address, so the bind is refused if any socket uses the port, also one on which
        only connections remain; with SO_REUSEADDR, macOS allows a bind of 127.0.0.1 on such a port.
    */
    private static Socket holder(string address, int port) {
        Socket s();
        s.bindINET(address, port, False, AF_INET);
        s.listen();
        return s;
    }

    #! returns the response body of a GET request from an IPv4 client of the port
    private static string get(int port) {
        Socket s();
        on_exit s.close();
        s.connect(sprintf("127.0.0.1:%d", port), 5s);
        s.send(sprintf("GET / HTTP/1.1\r\nHost: 127.0.0.1:%d\r\nConnection: close\r\n\r\n", port));
        hash<auto> hdr = s.readHTTPHeader(5s);
        return s.recv(hdr."content-length".toInt(), 5s);
    }

    givenPortTest() {
        foreach string holder in (("127.0.0.1", "0.0.0.0")) {
            Socket other = listener(holder);
            on_exit other.close();
            int port = other.getSocketInfo(False).port;
            HttpServer server();
            on_exit server.stop();
            server.setDefaultHandler("test", new WildcardBindHandler());
            # all-interfaces: tests the bind on all interfaces
            assertThrows("SOCKET-BIND-ERROR", strerror(EADDRINUSE), NOTHING, \server.addListener(), port,
                sprintf("addListener(%d) with the port held on %s", port, holder));
            # all-interfaces: tests the bind on all interfaces
            assertThrows("SOCKET-BIND-ERROR", strerror(EADDRINUSE), NOTHING, \server.addListener(),
                <HttpListenerOptionInfo>{"service": port},
                sprintf("a listener without a node on port %d held on %s", port, holder));
        }
    }

    systemPortTest() {
        # hold the ports after the next system-assigned port, alternately on 127.0.0.1 and on 0.0.0.0; a system that
        # assigns ports in sequence (macOS) would give the listener one of them if it did not avoid them.  These are
        # the ports that the system assigns next to concurrent programs too, so a port that another socket uses is
        # not held: its program's clients would reach the holder instead
        hash<string, Socket> held();
        on_exit map $1.close(), held.iterator();
        int first;
        {
            Socket probe = listener("127.0.0.1");
            first = probe.getSocketInfo(False).port;
            held{first} = probe;
        }
        for (int port = first + 1; port <= first + HeldPorts && port < 65536; ++port) {
            try {
                held{port} = holder((port % 2) ? "127.0.0.1" : "0.0.0.0", port);
            } catch (hash<ExceptionInfo> ex) {
                # a port in use by another program cannot be held, and is not given to the listener either
            }
        }
        assertGt(HeldPorts / 2, held.size(), "most of the ports after the next system-assigned port are held");
        HttpServer server();
        on_exit server.stop();
        server.setDefaultHandler("test", new WildcardBindHandler());
        int port = server.addListener(0).port;  # all-interfaces: tests the bind on all interfaces
        assertFalse(held.hasKey(port), sprintf("addListener(0) got port %d, which no IPv4 listener holds", port));
        assertEq("server", get(port), "an IPv4 client of the port reaches the server");
    }

    http3Test() {
        # a given port on which no socket listens for TCP, held for UDP on 0.0.0.0, the address that receives the
        # IPv4 datagrams of the port instead of the HTTP/3 listener on all interfaces.  A connection to a listener
        # that is then closed holds the TCP port, so that no other program can take it before the listener binds it
        # (a bind that reuses the address, as the listener's does, is allowed on a port that only connections use)
        Socket udp();
        on_exit udp.close();
        *Socket held_client;
        *Socket held_peer;
        on_exit {
            if (held_client) {
                held_client.close();
            }
            if (held_peer) {
                held_peer.close();
            }
        }
        int port;
        for (int attempt = 0; attempt < 16 && !port; ++attempt) {
            Socket probe = listener("127.0.0.1");
            int candidate = probe.getSocketInfo(False).port;
            Socket client();
            client.connect(sprintf("127.0.0.1:%d", candidate), 5s);
            Socket peer = probe.accept(5s);
            probe.close();
            try {
                # all-interfaces: the other program's socket on all interfaces
                udp.bindINET("0.0.0.0", candidate, False, AF_INET, SOCK_DGRAM);
                port = candidate;
                held_client = client;
                held_peer = peer;
            } catch (hash<ExceptionInfo> ex) {
                # the port is in use for UDP; try another one
                client.close();
                peer.close();
            }
        }
        assertGt(0, port, "a TCP port is held for UDP");
        HttpServer server();
        on_exit server.stop();
        server.setDefaultHandler("test", new WildcardBindHandler());
        # all-interfaces: tests the bind on all interfaces
        assertThrows("HTTPSERVER-H3-BIND-ERROR", \server.addListener(), <HttpListenerOptionInfo>{
            "service": port,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
            "enable_h3": True,
        }, sprintf("an HTTP/3 listener on all interfaces on port %d held for UDP on 0.0.0.0", port));
    }
}
