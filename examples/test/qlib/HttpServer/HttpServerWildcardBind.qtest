#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - wildcard TCP and UDP binds refused on ports held for IPv4 (dual-stack and SO_REUSEADDR)

/*
    Copyright (C) 2026 Qore Technologies, s.r.o., all rights reserved

    Permission is hereby granted, free of charge, to any person obtaining a
    copy of this software and associated documentation files (the "Software"),
    to deal in the Software without restriction, including without limitation
    the rights to use, copy, modify, merge, publish, distribute, sublicense,
    and/or sell copies of the Software, and to permit persons to whom the
    Software is furnished to do so, subject to the following conditions:

    The above copyright notice and this permission notice shall be included in
    all copies or substantial portions of the Software.

    THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
    IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
    FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
    AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
    LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
    FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
    DEALINGS IN THE SOFTWARE.

    A listener on all interfaces never starts on a port that another program uses for IPv4 on 0.0.0.0 or
    127.0.0.1, since that program, not the server, would receive the IPv4 clients of the port: a given port is
    refused, and a system-assigned port is one that no IPv4 socket uses.  The UDP socket of an HTTP/3 listener on all
    interfaces is refused such a port as well.

    The tests can run at the same time as other programs: a port is never released before the test binds it again,
    and the ports held at given numbers are bound without SO_REUSEADDR, so that none is a port that another program
    uses.
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires HttpServerUtil
%requires HttpServer
%requires ../../TestCertificates.qm
%requires ../../PortHolder.qm

%exec-class HttpServerWildcardBindTest

class WildcardBindHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(HttpListenerInterface listener, Socket s, hash<auto> cx, hash<auto> hdr,
            *data body) {
        return <HttpResponseInfo>{"code": 200, "body": "server"};
    }
}

class HttpServerWildcardBindTest inherits QUnit::Test {
    public {
        #! the number of free ports held after the next system-assigned port for the system-assigned port test
        const HeldPorts = 64;

        #! the test certificate and its key
        const CertPem = TestCertificates::CertPem;
        const KeyPem = TestCertificates::KeyPem;
    }

    constructor() : Test("HttpServerWildcardBindTest", "1.0") {
        addTestCase("a given port that another listener holds for IPv4 is refused", \givenPortTest());
        addTestCase("a system-assigned port is one that no IPv4 listener holds", \systemPortTest());
        addTestCase("the HTTP/3 listener of a given port that a datagram socket holds for IPv4 is refused",
            \http3Test());
        set_return_value(main());
    }

    #! returns a listening TCP socket on the given IPv4 address and a system-assigned or given port
    private static Socket listener(string address, int port = 0) {
        Socket s();
        s.bindINET(address, port, True, AF_INET);
        s.listen();
        return s;
    }

    #! returns the response body of a GET request from an IPv4 client of the port
    private static string get(int port) {
        Socket s();
        on_exit s.close();
        s.connect(sprintf("127.0.0.1:%d", port), 5s);
        s.send(sprintf("GET / HTTP/1.1\r\nHost: 127.0.0.1:%d\r\nConnection: close\r\n\r\n", port));
        hash<auto> hdr = s.readHTTPHeader(5s);
        return s.recv(hdr."content-length".toInt(), 5s);
    }

    givenPortTest() {
        foreach string holder in (("127.0.0.1", "0.0.0.0")) {
            Socket other = listener(holder);
            on_exit other.close();
            int port = other.getSocketInfo(False).port;
            HttpServer server();
            on_exit server.stop();
            server.setDefaultHandler("test", new WildcardBindHandler());
            # all-interfaces: tests the bind on all interfaces
            assertThrows("SOCKET-BIND-ERROR", strerror(EADDRINUSE), NOTHING, \server.addListener(), port,
                sprintf("addListener(%d) with the port held on %s", port, holder));
            # all-interfaces: tests the bind on all interfaces
            assertThrows("SOCKET-BIND-ERROR", strerror(EADDRINUSE), NOTHING, \server.addListener(),
                <HttpListenerOptionInfo>{"service": port},
                sprintf("a listener without a node on port %d held on %s", port, holder));
        }
    }

    systemPortTest() {
        # hold the next system-assigned port and the HeldPorts free ports after it, in the order of the system's
        # assignment; a system that assigns ports in sequence (macOS) would give the listener one of them if it did not
        # avoid them.  Concurrent programs, which take the ports that the system assigns next too, do not change how
        # many are held (see PortHolder::hold_next_free_ports())
        hash<string, Socket> held = PortHolder::hold_next_free_ports(HeldPorts);
        on_exit map $1.close(), held.iterator();
        assertEq(HeldPorts + 1, held.size(), sprintf("the next system-assigned port and the %d free ports after it "
            "are held (system-assigned ports: %y)", HeldPorts, PortHolder::ephemeral_range()));
        HttpServer server();
        on_exit server.stop();
        server.setDefaultHandler("test", new WildcardBindHandler());
        int port = server.addListener(0).port;  # all-interfaces: tests the bind on all interfaces
        assertFalse(held.hasKey(port), sprintf("addListener(0) got port %d, which no IPv4 listener holds", port));
        assertEq("server", get(port), "an IPv4 client of the port reaches the server");
    }

    http3Test() {
        # a given port on which no socket listens for TCP, held for UDP on 0.0.0.0, the address that receives the
        # IPv4 datagrams of the port instead of the HTTP/3 listener on all interfaces.  The port is one that the
        # system assigns to a listener on all interfaces of both address families, as the server's TCP listener is,
        # so that no other program uses it on any address when it is assigned (a port assigned for 127.0.0.1 can be
        # in use on ::1, where the server's listener could not bind it).  Connections to listeners that are then
        # closed hold the TCP port on ::1 and on 127.0.0.1, so that no other program can take it for either loopback
        # address before the listener binds it (a bind that reuses the address, as the listener's does, is allowed on
        # a port that only connections use)
        Socket udp();
        on_exit udp.close();
        list<Socket> held = ();
        on_exit map $1.close(), held;
        int port;
        *hash<ExceptionInfo> last_ex;
        for (int attempt = 0; attempt < 16 && !port; ++attempt) {
            list<Socket> conns = ();
            try {
                int candidate;
                Socket probe();
                bool ipv6;
                try {
                    # all-interfaces: a port free on every address of both families
                    probe.bindINET("::", 0, True, AF_INET6);
                    ipv6 = True;
                } catch (hash<ExceptionInfo> ex) {
                    # no IPv6: no socket can use the port for IPv6
                }
                if (ipv6) {
                    on_exit probe.close();
                    # a listen refused because the port is in use on an IPv6 address (macOS assigns a port that no
                    # IPv4 socket uses, and refuses the listen if a socket listens on ::1 on it) takes another port
                    probe.listen();
                    candidate = probe.getSocketInfo(False).port;
                    Socket client6();
                    bool connected6;
                    try {
                        client6.connect(sprintf("[::1]:%d", candidate), 5s);
                        connected6 = True;
                    } catch (hash<ExceptionInfo> ex) {
                        # no IPv6 loopback address: no socket can use the port on it
                    }
                    if (connected6) {
                        conns += (client6, probe.accept(5s));
                    }
                }
                Socket probe4 = listener("127.0.0.1", candidate);
                on_exit probe4.close();
                candidate = probe4.getSocketInfo(False).port;
                Socket client4();
                client4.connect(sprintf("127.0.0.1:%d", candidate), 5s);
                conns += (client4, probe4.accept(5s));
                # all-interfaces: the other program's socket on all interfaces
                udp.bindINET("0.0.0.0", candidate, False, AF_INET, SOCK_DGRAM);
                port = candidate;
                held = conns;
            } catch (hash<ExceptionInfo> ex) {
                # the port is in use on an IPv6 address, it was taken by another program for TCP on 127.0.0.1 after
                # the probe, or it is in use for UDP; try another one
                map $1.close(), conns;
                last_ex = ex;
            }
        }
        assertGt(0, port, sprintf("a TCP port is held for UDP (last error: %s)",
            last_ex ? get_exception_string(last_ex) : "none"));
        HttpServer server();
        on_exit server.stop();
        server.setDefaultHandler("test", new WildcardBindHandler());
        # all-interfaces: tests the bind on all interfaces
        assertThrows("HTTPSERVER-H3-BIND-ERROR", \server.addListener(), <HttpListenerOptionInfo>{
            "service": port,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
            "enable_h3": True,
        }, sprintf("an HTTP/3 listener on all interfaces on port %d held for UDP on 0.0.0.0", port));
    }
}
