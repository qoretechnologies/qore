        Logger logger;
        Events events();
        HttpServer server;
        string h2_url;
        *string h3_url;
    }

    constructor() : QUnit::Test("HttpServerTruncatedBodyTest", "1.0") {
        addTestCase("H2 streaming handler: client reset", \h2StreamingResetTest());
        addTestCase("H2 streaming handler: connection closed", \h2StreamingConnectionClosedTest());
        addTestCase("H2 streaming handler: complete body", \h2StreamingCompleteTest());
        addTestCase("H2 AbstractStreamRequest: client reset", \h2StreamRequestResetTest());
        addTestCase("H2 AbstractStreamRequest: complete body", \h2StreamRequestCompleteTest());
        addTestCase("H2 buffered body: client reset", \h2BufferedResetTest());
        addTestCase("H2 buffered body: complete body", \h2BufferedCompleteTest());
        addTestCase("H3 streaming handler: client reset", \h3StreamingResetTest());
        addTestCase("H3 streaming handler: complete body", \h3StreamingCompleteTest());
        addTestCase("H3 AbstractStreamRequest: client reset", \h3StreamRequestResetTest());
        addTestCase("H3 buffered body: client reset", \h3BufferedResetTest());
        set_return_value(main());
    }

    globalSetUp() {
        logger = new Logger("truncated-body", LoggerLevel::getLevelInfo());
        logger.addAppender(new ErrorAppender(events));
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }
        server = new HttpServer(<HttpServerOptionInfo>{
            "logger": logger,
            "quic_headers_only": True,
        });
        server.setHandler("streaming", "/streaming", NOTHING, new StreamingHandler(events));
        server.setHandler("buffered", "/buffered", NOTHING, new BufferedHandler(events));
        server.setHandler("recording", "/recording", NOTHING, new RecordingHandler(events));

        int h2_port = server.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        }).port;
        h2_url = "https://127.0.0.1:" + h2_port;
        try {
            h3_url = "https://127.0.0.1:" + server.addQuicListener(<HttpListenerOptionInfo>{
                "cert": new SSLCertificate(CertPem),
                "key": new SSLPrivateKey(KeyPem),
            }).port;
        } catch (hash<ExceptionInfo> ex) {
            # QUIC is not available; the HTTP/3 tests are skipped
        }
        server.waitForAsyncIo();
    }

    globalTearDown() {
        delete server;
    }

    setUp() {
        # discard the events of a test that failed before it read them
        while (events.q.size()) {
            events.q.get();
        }
    }

    h2StreamingResetTest() {
        streamingAbortTest("h2", False);
    }

    h2StreamingConnectionClosedTest() {
        streamingAbortTest("h2", True);
    }

    h2StreamingCompleteTest() {
        streamingCompleteTest("h2");
    }

    h2StreamRequestResetTest() {
        streamRequestResetTest("h2");
    }

    h2StreamRequestCompleteTest() {
        HttpClientIo::HttpClientConnectionManager mgr = makeMgr("h2");
        on_exit delete mgr;
        HttpClientIo::HttpClientStreamHandle stream = startUpload(mgr, "h2", "/recording");
        stream.sendData(makeData(PartSize), True);
        assertEq("data", events.get().event);
        assertEq({"event": "eod", "size": PartSize}, events.get());
        assertEq({"event": "responded", "size": PartSize}, events.get());
        assertEq(200, readStatus(stream));
    }

    h2BufferedResetTest() {
        bufferedResetTest("h2");
    }

    h2BufferedCompleteTest() {
        HttpClientIo::HttpClientConnectionManager mgr = makeMgr("h2");
        on_exit delete mgr;
        HttpClientIo::HttpClientStreamHandle stream = startUpload(mgr, "h2", "/buffered");
        assertEq("dispatched", events.get().event);
        stream.sendData(makeData(PartSize), True);
        assertEq({"event": "called", "size": PartSize}, events.get());
        assertEq(200, readStatus(stream));
    }

    h3StreamingResetTest() {
        streamingAbortTest("h3", False);
    }

    h3StreamingCompleteTest() {
        streamingCompleteTest("h3");
    }

    h3StreamRequestResetTest() {
        streamRequestResetTest("h3");
    }

    h3BufferedResetTest() {
        bufferedResetTest("h3");
    }

    #! the client resets the stream or closes the connection after a part of the body
    private streamingAbortTest(string proto, bool close_connection) {
        HttpClientIo::HttpClientConnectionManager mgr = makeMgr(proto);
        on_exit delete mgr;
        HttpClientIo::HttpClientStreamHandle stream = startUpload(mgr, proto, "/streaming");
        stream.sendData(makeData(PartSize));
        # the handler has received data of the body
        assertEq("data", events.get().event);
        abort(stream, close_connection);
        hash<auto> end = events.get();
        assertEq("end", end.event);
        # the error is raised after all the data received
        assertEq(PartSize, end.size);
        assertEq("HTTP-BODY-INCOMPLETE", end.err);
        # the server logs the handler's error
        assertEq("error", events.get().event);
    }

    private streamingCompleteTest(string proto) {
        HttpClientIo::HttpClientConnectionManager mgr = makeMgr(proto);
        on_exit delete mgr;
        HttpClientIo::HttpClientStreamHandle stream = startUpload(mgr, proto, "/streaming");
        stream.sendData(makeData(PartSize));
        assertEq("data", events.get().event);
        stream.sendData(makeData(PartSize), True);
        assertEq({"event": "end", "size": PartSize * 2}, events.get());
        assertEq(200, readStatus(stream));
    }

    #! an AbstractStreamRequest is not told that a body cut short ended, and makes no response
    private streamRequestResetTest(string proto) {
        HttpClientIo::HttpClientConnectionManager mgr = makeMgr(proto);
        on_exit delete mgr;
        HttpClientIo::HttpClientStreamHandle stream = startUpload(mgr, proto, "/recording");
        stream.sendData(makeData(PartSize));
        assertEq("data", events.get().event);
        stream.cancel();
        # the server logs the request's error; there is no "eod" or "responded" event
        hash<auto> ev = events.get();
        assertEq("error", ev.event, sprintf("%y", ev));
    }

    #! a handler whose body the server buffers is not called with a body cut short
    private bufferedResetTest(string proto) {
        HttpClientIo::HttpClientConnectionManager mgr = makeMgr(proto);
        on_exit delete mgr;
        HttpClientIo::HttpClientStreamHandle stream = startUpload(mgr, proto, "/buffered");
        assertEq("dispatched", events.get().event);
        stream.sendData(makeData(PartSize));
        stream.cancel();
        # the server logs the error; there is no "called" event
        hash<auto> ev = events.get();
        assertEq("error", ev.event, sprintf("%y", ev));
    }

    private abort(HttpClientIo::HttpClientStreamHandle stream, bool close_connection) {
        if (close_connection) {
            stream.getConnection().close();
        } else {
            stream.cancel();
        }
    }

    #! starts a streamed upload; skips the test if the protocol is not available
    private HttpClientIo::HttpClientStreamHandle startUpload(HttpClientIo::HttpClientConnectionManager mgr,
            string proto, string path) {
        *string url = proto == "h3" ? h3_url : h2_url;
        if (!url) {
            testSkip(sprintf("%s is not available", proto));
        }
        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(url);
        stream.startStreaming("POST", path, {"Content-Type": "application/octet-stream"}, True);
        return stream;
    }

    #! returns the status code of the response
    /** HTTP/3 can deliver the response headers with the body, so the status code is taken from the response
        information once the response is complete
    */
    private int readStatus(HttpClientIo::HttpClientStreamHandle stream) {
        while (True) {
            auto ev = stream.readData(20s);
            if (!exists ev) {
                throw "TEST-TIMEOUT", "timed out waiting for the response";
            }
            if (ev.typeCode() == NT_HASH && (ev.status_code || ev.end_stream)) {
                return stream.getResponse().status_code;
            }
        }
    }

    private HttpClientIo::HttpClientConnectionManager makeMgr(string proto) {
        return new HttpClientIo::HttpClientConnectionManager(<HttpClientIo::HttpClientConnectionManagerOptions>{
            "accept_all_certs": True,
            "protocol": proto,
            "connect_timeout": 10s,
            "request_timeout": 30s,
            "logger": logger,
        });
    }

    private static binary makeData(int size) {
        return binary(strmul("x", size));
    }
}
