    AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
    LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
    FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
    DEALINGS IN THE SOFTWARE.

    An HTTP/2 or HTTP/3 request body that ends before the client's END_STREAM (HTTP/2) or FIN (HTTP/3), because the
    client reset the stream or the connection was closed, is never taken for the complete body:
    - a handler that reads the body as it arrives gets an HTTP-BODY-INCOMPLETE error after the data received
    - an AbstractStreamRequest is not told that the body ended, and makes no response
    - a handler whose body the server buffers is not called
    A body ended by the client is delivered completely in each case.
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Logger
%requires HttpServerUtil
%requires AsyncSocketIo
%requires HttpServerAsyncIo
%requires HttpServer
%requires HttpClientIo

%exec-class HttpServerTruncatedBodyTest

#! the events of the handlers and of the server's error log
class Events {
    public {
        Queue q();
    }

    push(string event, *hash<auto> info) {
        q.push({"event": event} + info);
    }

    #! returns the next event
    hash<auto> get() {
        return q.get(20s);
    }
}

#! pushes the errors that the server logs about incomplete bodies to the events
class ErrorAppender inherits LoggerAppenderWithLayout {
    private {
        Events events;
    }

    constructor(Events events) : LoggerAppenderWithLayout("errors", new LoggerLayoutPattern("%m")) {
        self.events = events;
        open();
    }

    processEventImpl(int type, auto params) {
        if (type == EVENT_LOG && params =~ /HTTP-BODY-INCOMPLETE/) {
            events.push("error", {"msg": params});
        }
    }
}

#! reads the request body as it arrives, and reports the data and how the body ended
class StreamingHandler inherits AbstractHttpRequestHandler {
    private {
        Events events;
    }

    constructor(Events events) {
        self.events = events;
    }

    bool wantsBodyStreaming(hash<auto> cx, hash<auto> hdr) {
        return True;
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        int size = 0;
        try {
            if (cx."header-info".http3) {
                Socket sock = cx."header-info".sock;
                while (True) {
                    *binary chunk = sock.readQuicStreamDataBlock(cx."header-info".session_id,
                        cx."header-info".stream_id, 20s);
                    if (!chunk) {
                        break;
                    }
                    if (!size) {
                        events.push("data");
                    }
                    size += chunk.size();
                }
            } else {
                Queue body_queue(-1);
                cx."header-info".register_body_queue(body_queue);
                while (True) {
                    auto chunk = body_queue.get(20s);
                    if (chunk.typeCode() == NT_HASH) {
                        throw chunk.err, chunk.desc;
                    }
                    if (!exists chunk) {
                        break;
                    }
                    if (!size) {
                        events.push("data");
                    }
                    size += chunk.size();
                }
            }
        } catch (hash<ExceptionInfo> ex) {
            events.push("end", {"size": size, "err": ex.err});
            rethrow;
        }
        events.push("end", {"size": size});
        return makeResponse(200, sprintf("received %d bytes", size));
    }
}

#! a handler whose request body the server buffers; reports when the request is dispatched and when it is called
class BufferedHandler inherits AbstractHttpRequestHandler {
    private {
        Events events;
    }

    constructor(Events events) {
        self.events = events;
    }

    bool wantsBodyStreaming(hash<auto> cx, hash<auto> hdr) {
        # called when the request is dispatched, before the server reads the body
        events.push("dispatched");
        return False;
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        events.push("called", {"size": body.size()});
        return makeResponse(200, sprintf("received %d bytes", body.size()));
    }
}

#! an AbstractStreamRequest that reports the data received, the end of the body, and the response
class RecordingRequest inherits AbstractStreamRequest {
    private {
        Events events;
        int size = 0;
    }

    constructor(HttpListenerInterface listener, AbstractHttpRequestHandler handler, Socket s, hash<auto> cx,
            hash<auto> hdr, auto body, Events events) : AbstractStreamRequest(listener, handler, s, cx, hdr, body) {
        self.events = events;
    }

    private nothing recvImpl(hash<auto> v) {
        if (v.hasKey("data")) {
            if (!size) {
                events.push("data");
            }
            size += v.data.size();
        } else if (v.hasKey("hdr")) {
            events.push("eod", {"size": size});
        }
    }

    private hash<auto> getResponseHeaderMessageImpl() {
        events.push("responded", {"size": size});
        return {"code": 200, "body": sprintf("received %d bytes", size)};
    }
}

class RecordingHandler inherits AbstractHttpRequestHandler {
    private {
        Events events;
    }

    constructor(Events events) : AbstractHttpRequestHandler(NOTHING, True) {
        self.events = events;
    }

    bool wantsBodyStreaming(hash<auto> cx, hash<auto> hdr) {
        # the request object reads an HTTP/2 or HTTP/3 body as it arrives
        return True;
    }

    private AbstractStreamRequest getStreamRequestImpl(HttpListenerInterface listener, Socket s, hash<auto> cx,
            hash<auto> hdr, *data body) {
        return new RecordingRequest(listener, self, s, cx, hdr, body, events);
    }
}

