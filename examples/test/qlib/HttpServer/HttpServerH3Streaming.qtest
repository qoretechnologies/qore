    constructor() : Test("HttpServerH3StreamingTest", "1.0") {
        @debug {
            set_signal_handler(SIGUSR1, sub (int sig) {
                printf("=== SIGUSR1 Thread Stacks ===\n%Y\n=== End Thread Stacks ===\n",
                    get_all_thread_call_stacks());
            });
        }

        mPayload = generatePayload(TestPayloadSize);

        addTestCase("HTTP/3 unary POST (baseline)", \testH3UnaryPost());
        addTestCase("HTTP/3 server-streaming GET (baseline)", \testH3ServerStreaming());
        addTestCase("HTTP/3 client-streaming POST (headers-only)", \testH3ClientStreaming());
        addTestCase("HTTP/3 headers-end-stream GET (no body)", \testH3HeadersEndStream());
        addTestCase("HTTP/3 body_streaming flag detection", \testH3BodyStreamingFlag());
        addTestCase("HTTP/3 backward-compat body buffering", \testH3BackwardCompatBuffering());
        addTestCase("HTTP/3 timeout handling", \testH3Timeout());
        addTestCase("HTTP/3 oversized body (413)", \testH3OversizedBody());
        addTestCase("HTTP/3 concurrent streaming", \testH3ConcurrentStreaming());
        addTestCase("HTTP/3 shutdown during streaming", \testH3ShutdownDuringStreaming());
        addTestCase("HTTP/3 partial body read + early response", \testH3PartialBodyRead());
        addTestCase("HTTP/3 headers-only GET (no body read)", \testH3HeadersOnlyGetNoBodyRead());
        addTestCase("HTTP/3 bidirectional streaming (small)", \testH3BidiStreamingSmall());
        addTestCase("HTTP/3 bidirectional streaming (large)", \testH3BidiStreamingLarge());
        addTestCase("HTTP/3 bidirectional streaming concurrent", \testH3BidiConcurrent());
        addTestCase("HTTP/3 stream reset propagates as error", \testH3StreamResetError());
        addTestCase("HTTP/3 multi-stream server crash cleanup", \testH3MultiStreamServerCrash());

        # Bidi streaming tests — InputStream response bodies
        addTestCase("HTTP/3 CallbackInputStream connect+ response body",
            \testH3CallbackInputStreamConnectProtocol());
        addTestCase("HTTP/3 CallbackInputStream connect+ large response",
            \testH3CallbackInputStreamConnectProtocolLarge());
        addTestCase("HTTP/3 bidi: handler reads request + emits response",
            \testH3BidiInterleavedRequestResponse());

        set_return_value(main());
    }

    globalSetUp() {
        mLogger = new Logger("h3-streaming-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            mLogger.addAppender(new StdoutAppender());
        }
    }

    #! Creates a new async HTTP server with TLS and HTTP/3 + headers-only
    private hash<auto> createServer(*hash<auto> opts) {
        HttpServer server(<HttpServerOptionInfo>{
            "logger": mLogger,
            "debug": True,
            "quic_headers_only": opts.headers_only ?? False,
            "max_request_body_size": opts.max_request_body_size ?? 0,
        });

        StreamingBodyHandler streaming_handler(m_options.verbose);
        BidiEchoHandler bidi_handler(m_options.verbose);
        # Use exact-match paths (isregex=False) for the bidi handler to avoid
        # regex substring collision with the broader /echo handler
        server.setHandler("bidi-echo", "/bidi-echo", NOTHING, bidi_handler, NOTHING, False);
        server.setHandler("reset-stream", "/reset-stream", NOTHING,
            new ResetStreamHandler(), NOTHING, False);
        server.setHandler("echo", "/echo", NOTHING, new EchoHandler());
        server.setHandler("stream-response", "/stream-response", NOTHING,
            new StreamResponseHandler(mPayload));
        server.setHandler("streaming-body", "/streaming-body", NOTHING, streaming_handler);

        # Bidi-streaming handler registrations
        CallbackStreamResponseHandler cb_handler(opts.cb_chunk_count ?? 3, opts.cb_chunk_size ?? 1024);
        server.setHandler("cb-stream", "/cb-stream", NOTHING, cb_handler, NOTHING, False);
        BidiInterleaveHandler bidi_interleave_handler();
        server.setHandler("bidi-interleave", "/bidi-interleave", NOTHING, bidi_interleave_handler,
            NOTHING, False);

        # Add extra handlers if provided
        if (opts.extra_handlers) {
            HashIterator hi(opts.extra_handlers);
            while (hi.next()) {
                hash<auto> h = hi.getValue();
                server.setHandler(hi.getKey(), h.path, NOTHING, h.handler);
            }
        }

        server.waitForAsyncIo();

        hash<auto> h2info = server.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
            "enable_h3": True,
        });
        server.waitForAsyncIo();

        return {
            "server": server,
            "port": h2info.port,
            "streaming_handler": streaming_handler,
            "bidi_handler": bidi_handler,
        };
    }

    #! Creates an HTTP/3 client connection manager
    private HttpClientIo::HttpClientConnectionManager createH3Manager() {
        return new HttpClientIo::HttpClientConnectionManager(
            <HttpClientIo::HttpClientConnectionManagerOptions>{
                "protocol": "h3",
                "accept_all_certs": True,
                "logger": mLogger,
                "request_timeout": 30s,
                "connect_timeout": 15s,
            },
        );
    }

    # ---- Baseline Tests ----

    #! Unary POST: normal request/response (body buffered before dispatch)
    testH3UnaryPost() {
        hash<auto> setup = createServer();
        HttpServer server = setup.server;
        on_exit delete server;

        HttpClientIo::HttpClientConnectionManager mgr = createH3Manager();
        on_exit delete mgr;

        string url = sprintf("https://127.0.0.1:%d", setup.port);
        hash<auto> resp = mgr.request(url, "POST", "/echo",
            {"Content-Type": "application/octet-stream"}, mPayload);
        assertEq(200, resp.status_code, "H3 unary POST response status");
        binary resp_body;
        if (resp.body.typeCode() == NT_BINARY) {
            resp_body = resp.body;
        } else {
            resp_body = binary(resp.body);
        }
        assertEq(mPayload.size(), resp_body.size(), "H3 unary POST response body size");
        assertEq(mPayload, resp_body, "H3 unary POST response body content");
    }

    #! Server-streaming: GET → InputStream response
    testH3ServerStreaming() {
        hash<auto> setup = createServer();
        HttpServer server = setup.server;
        on_exit delete server;

        HttpClientIo::HttpClientConnectionManager mgr = createH3Manager();
        on_exit delete mgr;

        string url = sprintf("https://127.0.0.1:%d", setup.port);
        hash<auto> resp = mgr.request(url, "GET", "/stream-response");
        assertEq(200, resp.status_code, "H3 server-streaming response status");
        binary resp_body;
        if (resp.body.typeCode() == NT_BINARY) {
            resp_body = resp.body;
        } else {
            resp_body = binary(resp.body);
        }
        assertEq(TestPayloadSize, resp_body.size(), "H3 server-streaming response body size");
        assertEq(mPayload, resp_body, "H3 server-streaming response body content");
    }

    # ---- Headers-Only Dispatch Tests ----

    #! Client-streaming POST: handler reads body via readQuicStreamDataBlock()
    testH3ClientStreaming() {
        hash<auto> setup = createServer({"headers_only": True});
        HttpServer server = setup.server;
        StreamingBodyHandler handler = setup.streaming_handler;
        on_exit delete server;

        HttpClientIo::HttpClientConnectionManager mgr = createH3Manager();
        on_exit delete mgr;

        handler.clearRequests();

        string url = sprintf("https://127.0.0.1:%d", setup.port);
        hash<auto> resp = mgr.request(url, "POST", "/streaming-body",
            {"Content-Type": "application/octet-stream"}, mPayload);
        assertEq(200, resp.status_code, "H3 client-streaming response status");

        # Response body contains the size read by the handler
        string body_str = resp.body.typeCode() == NT_BINARY
            ? resp.body.toString() : string(resp.body);
        int body_size = int(body_str);
        assertEq(TestPayloadSize, body_size, "H3 client-streaming: handler read correct body size");

        # Verify the header indicates body_streaming was used
        assertEq("true", resp.headers."x-body-streaming",
            "H3 client-streaming: body_streaming header");
        assertEq("false", resp.headers."x-headers-end-stream",
            "H3 client-streaming: headers_end_stream header");

        # Verify handler's recorded data
        list<hash<auto>> requests = handler.getReceivedRequests();
        assertEq(1, requests.size(), "H3 client-streaming: one request received");
        assertTrue(requests[0].body_streaming, "H3 client-streaming: body_streaming flag set");
        assertFalse(requests[0].headers_end_stream,
            "H3 client-streaming: headers_end_stream flag not set");
        assertEq(TestPayloadSize, requests[0].body_size,
            "H3 client-streaming: handler accumulated correct body size");
        assertEq(mPayload, requests[0].body,
            "H3 client-streaming: handler accumulated correct body content");
    }

    #! Headers-end-stream: GET with no body (FIN on HEADERS frame)
    testH3HeadersEndStream() {
        hash<auto> setup = createServer({"headers_only": True});
        HttpServer server = setup.server;
        StreamingBodyHandler handler = setup.streaming_handler;
        on_exit delete server;

        HttpClientIo::HttpClientConnectionManager mgr = createH3Manager();
        on_exit delete mgr;

        handler.clearRequests();

        string url = sprintf("https://127.0.0.1:%d", setup.port);
        hash<auto> resp = mgr.request(url, "GET", "/streaming-body");
        assertEq(200, resp.status_code, "H3 headers-end-stream response status");

        # Verify headers_end_stream was detected
        assertEq("true", resp.headers."x-headers-end-stream",
            "H3 headers-end-stream: header flag set");

        # Verify handler's recorded data
        list<hash<auto>> requests = handler.getReceivedRequests();
        assertEq(1, requests.size(), "H3 headers-end-stream: one request received");
        assertTrue(requests[0].headers_end_stream,
            "H3 headers-end-stream: flag set in handler");
        assertEq(0, requests[0].body_size,
            "H3 headers-end-stream: no body data");
    }

    #! Verify body_streaming flag is correctly set based on headers-only mode
    testH3BodyStreamingFlag() {
        # With headers_only=True and a POST with body, body_streaming should be True
        hash<auto> setup = createServer({"headers_only": True});
        HttpServer server = setup.server;
        StreamingBodyHandler handler = setup.streaming_handler;
        on_exit delete server;

        HttpClientIo::HttpClientConnectionManager mgr = createH3Manager();
        on_exit delete mgr;

        handler.clearRequests();

        # POST with body → body_streaming=True, headers_end_stream=False
        string url = sprintf("https://127.0.0.1:%d", setup.port);
        hash<auto> resp1 = mgr.request(url, "POST", "/streaming-body",
            {"Content-Type": "text/plain"}, binary("hello"));
        assertEq(200, resp1.status_code, "body_streaming flag: POST status");

        list<hash<auto>> requests = handler.getReceivedRequests();
        assertEq(1, requests.size(), "body_streaming flag: POST request received");
        assertTrue(requests[0].body_streaming,
            "body_streaming flag: POST with body → body_streaming=True");
        assertFalse(requests[0].headers_end_stream,
            "body_streaming flag: POST with body → headers_end_stream=False");
    }

    #! Backward-compat: handler without wantsBodyStreaming() gets fully buffered body
    /** When headers_only=True is set on the server but the handler doesn't override
        wantsBodyStreaming(), the framework should automatically buffer the body via
        readQuicStreamDataBlock() before passing it to handleRequest().
    */
    testH3BackwardCompatBuffering() {
        # Create server with headers_only=True — the EchoHandler doesn't override
        # wantsBodyStreaming() so the framework will buffer the body automatically
        hash<auto> setup = createServer({"headers_only": True});
        HttpServer server = setup.server;
        on_exit delete server;

        HttpClientIo::HttpClientConnectionManager mgr = createH3Manager();
        on_exit delete mgr;

        string url = sprintf("https://127.0.0.1:%d", setup.port);
        hash<auto> resp = mgr.request(url, "POST", "/echo",
            {"Content-Type": "application/octet-stream"}, mPayload);
        assertEq(200, resp.status_code, "backward-compat: response status");

        # The EchoHandler echoes the body — verify the full body was buffered and passed
        binary resp_body;
        if (resp.body.typeCode() == NT_BINARY) {
            resp_body = resp.body;
        } else {
            resp_body = binary(resp.body);
        }
        assertEq(mPayload.size(), resp_body.size(), "backward-compat: response body size");
        assertEq(mPayload, resp_body, "backward-compat: response body content");
    }

    # ---- Negative/Edge-Case Tests ----

    #! Test 3.1: Timeout handling — handler exercises QUIC-STREAM-TIMEOUT path
    /** Tests timeout handling with a 1ms read timeout and a large payload.
        Uses a 512KB payload to increase the likelihood of flow control delays
        that cause the 1ms timeout to fire between data batches.

        On loopback, all data may still arrive in one batch (no timeout), so
        the test validates whichever path fires:
        - 408 with timeout: validates QUIC-STREAM-TIMEOUT exception handling
        - 200 with complete data: validates normal streaming read to completion

        @note A fully deterministic timeout test would require client-side streaming
        support (send headers, delay body) which HttpClientIo does not yet support.
    */
    testH3Timeout() {
        TimeoutHandler timeout_handler();

        # Use 512KB payload — larger payloads are more likely to trigger flow
        # control delays that cause the 1ms read timeout to fire
        binary large_payload = generatePayload(512 * 1024);

        hash<auto> setup = createServer({
            "headers_only": True,
            "extra_handlers": {
                "timeout": {
                    "path": "/timeout",
                    "handler": timeout_handler,
                },
            },
        });
        HttpServer server = setup.server;
        on_exit delete server;

        HttpClientIo::HttpClientConnectionManager mgr = createH3Manager();
        on_exit delete mgr;

        string url = sprintf("https://127.0.0.1:%d", setup.port);
        hash<auto> resp = mgr.request(url, "POST", "/timeout",
            {"Content-Type": "application/octet-stream"}, large_payload);

        string body_str = resp.body.typeCode() == NT_BINARY
            ? resp.body.toString() : string(resp.body);

        if (resp.status_code == 408) {
            # Timeout path: handler caught QUIC-STREAM-TIMEOUT and returned 408
            assertTrue(timeout_handler.wasTimeoutHit(), "timeout: handler recorded timeout");
            assertTrue(body_str =~ /^timeout:/, "timeout: response body format");
        } else {
            # Complete path: all data arrived before the 1ms timeout between chunks
            assertEq(200, resp.status_code, "timeout: response status");
            assertTrue(body_str =~ /^complete:/, "timeout: response body format");
            assertEq("complete:" + string(large_payload.size()), body_str,
                "timeout: all data received");
        }
    }

    #! Test 3.2: Oversized body — framework returns 413 via backward-compat buffering
    testH3OversizedBody() {
        hash<auto> setup = createServer({
            "headers_only": True,
            "max_request_body_size": 1024,
        });
        HttpServer server = setup.server;
        on_exit delete server;

        HttpClientIo::HttpClientConnectionManager mgr = createH3Manager();
        on_exit delete mgr;

        # Send 2048-byte body to EchoHandler (no wantsBodyStreaming) with 1024-byte limit
        binary oversized = binary(strmul("X", 2048));
        string url = sprintf("https://127.0.0.1:%d", setup.port);
        hash<auto> resp = mgr.request(url, "POST", "/echo",
            {"Content-Type": "application/octet-stream"}, oversized);
        assertEq(413, resp.status_code, "oversized body: response status 413");
    }

    #! Test 3.3: Concurrent streaming — multiple simultaneous POSTs
    testH3ConcurrentStreaming() {
        hash<auto> setup = createServer({"headers_only": True});
        HttpServer server = setup.server;
        StreamingBodyHandler handler = setup.streaming_handler;
        on_exit delete server;

        handler.clearRequests();

        int num_concurrent = 4;
        Counter cnt(num_concurrent);
        list<hash<auto>> results();
        Mutex results_lock();

        for (int i = 0; i < num_concurrent; ++i) {
            int idx = i;
            background sub () {
                try {
                    HttpClientIo::HttpClientConnectionManager mgr = createH3Manager();
                    on_exit delete mgr;

                    string url = sprintf("https://127.0.0.1:%d", setup.port);
                    hash<auto> resp = mgr.request(url, "POST", "/streaming-body",
                        {"Content-Type": "application/octet-stream"}, mPayload);
                    {
                        AutoLock al(results_lock);
                        results += {
                            "idx": idx,
                            "status_code": resp.status_code,
                            "body": resp.body,
                        };
                    }
                } catch (hash<ExceptionInfo> ex) {
                    {
                        AutoLock al(results_lock);
                        results += {
                            "idx": idx,
                            "error": sprintf("%s: %s", ex.err, ex.desc),
                        };
                    }
                }
                cnt.dec();
            }();
        }

        int rc = cnt.waitForZero(60s);
        assertEq(0, rc, "concurrent: all threads completed");

        # Check results
        assertEq(num_concurrent, results.size(), "concurrent: all results received");
        for (int i = 0; i < results.size(); ++i) {
            assertFalse(exists results[i].error,
                sprintf("concurrent[%d]: no error (got: %y)", results[i].idx, results[i].error));
            assertEq(200, results[i].status_code,
                sprintf("concurrent[%d]: status 200", results[i].idx));
            string body_str = results[i].body.typeCode() == NT_BINARY
                ? results[i].body.toString() : string(results[i].body);
            assertEq(string(TestPayloadSize), body_str,
                sprintf("concurrent[%d]: correct body size", results[i].idx));
        }
    }

    #! Test 3.4: Server shutdown during streaming — handler exits quickly
    /** Uses a ShutdownTestHandler with a Counter gate to deterministically wait
        for the handler to start reading before shutting down.  Uses a 4MB payload
        to ensure the handler is actively reading (not already finished) when
        server.stop() fires.
    */
    testH3ShutdownDuringStreaming() {
        ShutdownTestHandler shutdown_handler();
        hash<auto> setup = createServer({
            "headers_only": True,
            "extra_handlers": {
                "shutdown-test": {
                    "path": "/shutdown-test",
                    "handler": shutdown_handler,
                },
            },
        });
        HttpServer server = setup.server;
        on_exit delete server;

        # Use a 4MB payload — large enough that QUIC flow control ensures the handler
        # is still actively reading when server.stop() fires
        binary large_payload = generatePayload(4 * 1024 * 1024);

        # Start streaming POST in background with short request timeout
        Counter cnt(1);
        background sub () {
            try {
                HttpClientIo::HttpClientConnectionManager mgr =
                    new HttpClientIo::HttpClientConnectionManager(
                        <HttpClientIo::HttpClientConnectionManagerOptions>{
                            "protocol": "h3",
                            "accept_all_certs": True,
                            "logger": mLogger,
                            "request_timeout": 10s,
                            "connect_timeout": 10s,
                        },
                    );
                on_exit delete mgr;
                string url = sprintf("https://127.0.0.1:%d", setup.port);
                mgr.request(url, "POST", "/shutdown-test",
                    {"Content-Type": "application/octet-stream"}, large_payload);
            } catch (hash<ExceptionInfo> ex) {
                # Expected: connection error due to server shutdown
            }
            cnt.dec();
        }();

        # Wait for the handler to start reading (deterministic, no sleep)
        int gate_rc = shutdown_handler.waitForReading(15s);
        assertEq(0, gate_rc, "shutdown: handler entered read loop");

        # Measure shutdown time
        date start = now_us();
        server.stop();
        date elapsed = now_us() - start;
        int elapsed_ms = int(elapsed) * 1000 / 1000000;

        # Shutdown should be fast (< 5s), not 30s
        assertTrue(elapsed_ms < 5000,
            sprintf("shutdown: completed in %dms (expected < 5000ms)", elapsed_ms));

        # Wait for background thread to finish (client has 10s request timeout)
        int rc = cnt.waitForZero(15s);
        assertEq(0, rc, "shutdown: background thread completed");
    }

    #! Test 3.5: Partial body read + early response — handler reads one chunk, returns
    testH3PartialBodyRead() {
        PartialReadHandler partial_handler();
        hash<auto> setup = createServer({
            "headers_only": True,
            "extra_handlers": {
                "partial": {
                    "path": "/partial",
                    "handler": partial_handler,
                },
            },
        });
        HttpServer server = setup.server;
        on_exit delete server;

        HttpClientIo::HttpClientConnectionManager mgr = createH3Manager();
        on_exit delete mgr;

        string url = sprintf("https://127.0.0.1:%d", setup.port);
        hash<auto> resp = mgr.request(url, "POST", "/partial",
            {"Content-Type": "application/octet-stream"}, mPayload);

        assertEq(200, resp.status_code, "partial read: response status 200");
        string body_str = resp.body.typeCode() == NT_BINARY
            ? resp.body.toString() : string(resp.body);
        # Response should start with "partial:" and have a non-zero chunk size
        assertTrue(body_str =~ /^partial:/, "partial read: response format correct");
    }

    #! Test 3.6: Headers-only GET with no body — handler doesn't call readQuicStreamDataBlock
    testH3HeadersOnlyGetNoBodyRead() {
        hash<auto> setup = createServer({"headers_only": True});
        HttpServer server = setup.server;
        StreamingBodyHandler handler = setup.streaming_handler;
        on_exit delete server;

        HttpClientIo::HttpClientConnectionManager mgr = createH3Manager();
        on_exit delete mgr;

        handler.clearRequests();

        string url = sprintf("https://127.0.0.1:%d", setup.port);
        hash<auto> resp = mgr.request(url, "GET", "/streaming-body");
        assertEq(200, resp.status_code, "headers-only GET: response status");

        # Verify handler saw headers_end_stream=True and body_streaming=False (GET has no body)
        list<hash<auto>> requests = handler.getReceivedRequests();
        assertEq(1, requests.size(), "headers-only GET: one request received");
        assertTrue(requests[0].headers_end_stream,
            "headers-only GET: headers_end_stream=True");
        assertEq(0, requests[0].body_size, "headers-only GET: no body data");
    }

    #! Test 4.1: Bidirectional streaming — small payload
    /** Client sends a request body and receives the echo back. Verifies the
        full bidirectional flow: the server reads request body chunks via
        readQuicStreamDataBlock() and sends the echo as the response body.
    */
    testH3BidiStreamingSmall() {
        hash<auto> setup = createServer({"headers_only": True});
        HttpServer server = setup.server;
        BidiEchoHandler handler = setup.bidi_handler;
        on_exit delete server;

        HttpClientIo::HttpClientConnectionManager mgr = createH3Manager();
        on_exit delete mgr;

        handler.clearRequests();

        string url = sprintf("https://127.0.0.1:%d", setup.port);
        binary small_payload = binary("Hello, bidirectional world!");
        hash<auto> resp = mgr.request(url, "POST", "/bidi-echo",
            {"Content-Type": "application/octet-stream"}, small_payload);

        assertEq(200, resp.status_code, "bidi small: response status");
        binary resp_body = resp.body.typeCode() == NT_BINARY
            ? resp.body : binary(resp.body);
        assertEq(small_payload, resp_body, "bidi small: echoed body matches");
        assertEq(sprintf("%d", small_payload.size()), resp.headers."x-echo-size",
            "bidi small: X-Echo-Size header correct");

        list<hash<auto>> requests = handler.getReceivedRequests();
        assertEq(1, requests.size(), "bidi small: one request received");
        assertEq(small_payload.size(), requests[0].body_size,
            "bidi small: handler saw full body");
    }

    #! Test 4.2: Bidirectional streaming — large payload (exercises flow control)
    testH3BidiStreamingLarge() {
        hash<auto> setup = createServer({"headers_only": True});
        HttpServer server = setup.server;
        BidiEchoHandler handler = setup.bidi_handler;
        on_exit delete server;

        HttpClientIo::HttpClientConnectionManager mgr = createH3Manager();
        on_exit delete mgr;

        handler.clearRequests();

        string url = sprintf("https://127.0.0.1:%d", setup.port);
        hash<auto> resp = mgr.request(url, "POST", "/bidi-echo",
            {"Content-Type": "application/octet-stream"}, mPayload);

        assertEq(200, resp.status_code, "bidi large: response status");
        binary resp_body = resp.body.typeCode() == NT_BINARY
            ? resp.body : binary(resp.body);
        assertEq(mPayload.size(), resp_body.size(), "bidi large: echoed body size matches");
        assertEq(mPayload, resp_body, "bidi large: echoed body content matches");

        list<hash<auto>> requests = handler.getReceivedRequests();
        assertEq(1, requests.size(), "bidi large: one request received");
        assertEq(TestPayloadSize, requests[0].body_size,
            "bidi large: handler accumulated full payload");
    }

    #! Test 4.3: Concurrent bidirectional streams on one H3 connection
    /** Multiple bidi requests running concurrently on the same QUIC connection
        verify that stream multiplexing works and streams don't interfere.
    */
    testH3BidiConcurrent() {
        hash<auto> setup = createServer({"headers_only": True});
        HttpServer server = setup.server;
        BidiEchoHandler handler = setup.bidi_handler;
        on_exit delete server;

        HttpClientIo::HttpClientConnectionManager mgr = createH3Manager();
        on_exit delete mgr;

        handler.clearRequests();

        string url = sprintf("https://127.0.0.1:%d", setup.port);
        int NumStreams = 5;
        list<Counter> counters = ();
        hash<string, hash<auto>> results;
        Mutex results_lock();

        for (int i = 0; i < NumStreams; ++i) {
            Counter c(1);
            push counters, c;
            int idx = i;
            string key = sprintf("s%d", idx);
            background sub () {
                on_exit c.dec();
                try {
                    binary payload = binary(sprintf("stream-%d-payload", idx));
                    hash<auto> resp = mgr.request(url, "POST", "/bidi-echo",
                        {"Content-Type": "application/octet-stream"}, payload);
                    AutoLock al(results_lock);
                    results{key} = {"status": resp.status_code, "body": resp.body,
                                    "expected": payload};
                } catch (hash<ExceptionInfo> ex) {
                    AutoLock al(results_lock);
                    results{key} = {"error": ex.desc};
                }
            }();
        }

        # Wait for all to complete
        foreach Counter c in (counters) {
            c.waitForZero(30s);
        }

        # Verify all succeeded and got correct echo
        for (int i = 0; i < NumStreams; ++i) {
            string key = sprintf("s%d", i);
            assertEq(200, results{key}.status,
                sprintf("bidi concurrent: stream %d status", i));
            binary resp_body = results{key}.body.typeCode() == NT_BINARY
                ? results{key}.body : binary(results{key}.body);
            assertEq(results{key}.expected, resp_body,
                sprintf("bidi concurrent: stream %d echo matches", i));
        }

        list<hash<auto>> requests = handler.getReceivedRequests();
        assertEq(NumStreams, requests.size(),
            "bidi concurrent: all requests received");
    }

    #! Test 4.5: Multi-stream connection death must fail ALL pending streams
    /** When multiple H3 streams are in flight on the same connection and the
        server disappears (crashes / stops), ALL streams must fail cleanly —
        not hang waiting for individual responses.  Without proper multi-stream
        cleanup, N streams each wait for their own timeout, turning a single
        connection failure into N×timeout delays.
    */
    testH3MultiStreamServerCrash() {
        int concurrency = 3;
        # Create server with a slow handler that blocks all requests
        HttpServer server(<HttpServerOptionInfo>{
            "logger": mLogger,
            "debug": True,
            "quic_headers_only": True,
        });
        SlowHandler slow_handler(concurrency);
        server.setHandler("slow", "/slow", NOTHING, slow_handler, NOTHING, False);
        server.waitForAsyncIo();

        hash<auto> info = server.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
            "enable_h3": True,
        });
        server.waitForAsyncIo();
        string url = sprintf("https://127.0.0.1:%d", info.port);

        HttpClientIo::HttpClientConnectionManager mgr = createH3Manager();
        on_exit delete mgr;

        # Launch concurrent requests in background; each call blocks in the
        # handler's sleep(60).  Collect results in a hash keyed by stream id.
        list<Counter> done = ();
        hash<string, hash<auto>> results;
        Mutex results_lock();
        for (int i = 0; i < concurrency; ++i) {
            Counter c(1);
            push done, c;
            int idx = i;
            string key = sprintf("s%d", idx);
            background sub () {
                on_exit c.dec();
                date start = now_us();
                try {
                    hash<auto> resp = mgr.request(url, "POST", "/slow",
                        {"Content-Type": "application/octet-stream"},
                        binary(sprintf("payload-%d", idx)));
                    AutoLock al(results_lock);
                    results{key} = {"ok": True, "status": resp.status_code,
                                     "elapsed_us": (now_us() - start).durationMilliseconds()};
                } catch (hash<ExceptionInfo> ex) {
                    AutoLock al(results_lock);
                    results{key} = {"err": ex.err, "desc": ex.desc,
                                     "elapsed_us": (now_us() - start).durationMilliseconds()};
                }
            }();
        }

        # Wait for all requests to reach the handler (in flight)
        slow_handler.getReadyCounter().waitForZero(10s);

        # Now simulate server crash by stopping the server.  Release the
        # blocked handler threads first so server shutdown doesn't wait on
        # them — we're measuring client-side cleanup, not handler blocking.
        date crash_time = now_us();
        slow_handler.signalStop();
        delete server;

        # All pending client requests must fail cleanly within a reasonable
        # time window — NOT wait for individual per-stream timeouts
        foreach Counter c in (done) {
            c.waitForZero(20s);
        }
        int total_elapsed_ms = (now_us() - crash_time).durationMilliseconds();

        # Check results: all should have failed with an error, none succeeded
        int error_count = 0;
        int success_count = 0;
        for (int i = 0; i < concurrency; ++i) {
            string key = sprintf("s%d", i);
            if (results{key}.err) {
                ++error_count;
            } else if (results{key}.ok) {
                ++success_count;
            }
        }
        assertEq(concurrency, error_count,
            sprintf("multi-stream crash: all %d streams got an error (results: %y)",
                concurrency, results));
        assertEq(0, success_count,
            "multi-stream crash: no stream succeeded after server crash");

        # Cleanup time should be reasonable — under 15s for all streams combined.
        # Without multi-stream cleanup, each stream waits its own request_timeout
        # (typically 30-60s), so 3 streams would take 90-180s.
        assertTrue(total_elapsed_ms < 15000,
            sprintf("multi-stream crash: cleanup took %d ms (expected < 15000)",
                total_elapsed_ms));
    }

    #! Test 4.4: Stream reset from server must propagate as a client error
    /** When the server calls resetQuicStream(), the client must receive an
        error (HTTP3-STREAM-RESET or similar) — not an empty response body.
        The client application cannot distinguish "empty but valid" from
        "peer-reset" without this signal, leading to silent data loss.
    */
    testH3StreamResetError() {
        hash<auto> setup = createServer({"headers_only": True});
        HttpServer server = setup.server;
        on_exit delete server;

        HttpClientIo::HttpClientConnectionManager mgr = createH3Manager();
        on_exit delete mgr;

        string url = sprintf("https://127.0.0.1:%d", setup.port);
        bool got_error = False;
        string err_str;
        try {
            hash<auto> resp = mgr.request(url, "POST", "/reset-stream",
                {"Content-Type": "application/octet-stream"}, binary("test"));
            # Should NOT reach here — server reset the stream
            if (resp.body) {
                err_str = sprintf("got response body instead of error: %y", resp.body);
            } else {
                err_str = sprintf("got empty response (status %d) instead of error",
                    resp.status_code);
            }
        } catch (hash<ExceptionInfo> ex) {
            got_error = True;
            err_str = sprintf("%s: %s", ex.err, ex.desc);
            if (m_options.verbose > 1) {
                printf("  expected error: %s\n", err_str);
            }
        }
        assertTrue(got_error,
            sprintf("stream reset: client must get an error (got: %s)", err_str));
    }

    #! Reproducer for the Qorus H3 streaming-response failure:
    /** Handler returns HttpResponseInfo with:
        - body = new CallbackInputStream(...)           (non-I/O-thread-safe)
        - Content-Type = application/connect+x          (connect-protocol framing)

        On current code this triggers `HTTP3-CONNECTION-CLOSED` on the client
        during response read: the server closes the entire QUIC connection
        instead of delivering the response body.  After the fix the response
        must arrive intact and the connection must remain usable for a
        second request.
    */
    testH3CallbackInputStreamConnectProtocol() {
        int chunk_count = 3;
        int chunk_size = 1024;
        hash<auto> setup = createServer({
            "cb_chunk_count": chunk_count,
            "cb_chunk_size": chunk_size,
        });
        HttpServer server = setup.server;
        on_exit delete server;

        HttpClientIo::HttpClientConnectionManager mgr = createH3Manager();
        on_exit delete mgr;

        string url = sprintf("https://127.0.0.1:%d", setup.port);

        # Request 1 — must succeed (body is 3 × 1024-byte frames plus 5-byte
        # length/version prefix each = 3 × 1029 = 3087 bytes)
        hash<auto> resp;
        try {
            resp = mgr.request(url, "GET", "/cb-stream", NOTHING, NOTHING);
        } catch (hash<ExceptionInfo> ex) {
            fail(sprintf("H3 CallbackInputStream response failed (this is the Qorus bug): %s: %s",
                ex.err, ex.desc));
        }
        assertEq(200, resp.status_code, "H3 CallbackInputStream: status code");

        int expected_size = chunk_count * (1 + 4 + chunk_size);
        int actual_size = resp.body.typeCode() == NT_BINARY ? resp.body.size() : resp.body.length();
        assertEq(expected_size, actual_size,
            sprintf("H3 CallbackInputStream: body size (got %d, expected %d)",
                actual_size, expected_size));

        # Request 2 — connection must still be usable (it's pooled by the
        # connection manager).  If the server closed the QUIC connection at
        # the end of request 1 this will either fail or open a fresh
        # connection; either way the response must be delivered.
        hash<auto> resp2 = mgr.request(url, "GET", "/cb-stream", NOTHING, NOTHING);
        assertEq(200, resp2.status_code, "H3 CallbackInputStream: second request status");
        int actual_size2 = resp2.body.typeCode() == NT_BINARY ? resp2.body.size() : resp2.body.length();
        assertEq(expected_size, actual_size2,
            "H3 CallbackInputStream: second request body size");
    }

    #! Same as testH3CallbackInputStreamConnectProtocol but with larger
    #! payload to stress QUIC flow control + bigger materialization buffer.
    /** If the server closes the connection on large connect+ responses —
        e.g. due to exceeding max_stream_data and mishandling the error
        as CONNECTION_CLOSE instead of a per-stream error — this test
        surfaces it.
    */
    testH3CallbackInputStreamConnectProtocolLarge() {
        int chunk_count = 16;
        int chunk_size = 32 * 1024;   # 32 KB per frame × 16 = 512 KB
        hash<auto> setup = createServer({
            "cb_chunk_count": chunk_count,
            "cb_chunk_size": chunk_size,
        });
        HttpServer server = setup.server;
        on_exit delete server;

        HttpClientIo::HttpClientConnectionManager mgr = createH3Manager();
        on_exit delete mgr;

        string url = sprintf("https://127.0.0.1:%d", setup.port);
        hash<auto> resp;
        try {
            resp = mgr.request(url, "GET", "/cb-stream", NOTHING, NOTHING);
        } catch (hash<ExceptionInfo> ex) {
            fail(sprintf("H3 CallbackInputStream large response failed: %s: %s",
                ex.err, ex.desc));
        }
        assertEq(200, resp.status_code, "large connect+ response status");
        int expected_size = chunk_count * (1 + 4 + chunk_size);
        int actual_size = resp.body.typeCode() == NT_BINARY
            ? resp.body.size() : resp.body.length();
        assertEq(expected_size, actual_size, "large connect+ response body size");
    }

    #! True bidi: client posts 5 text chunks over time.  Handler reads
    #! each chunk via recvImpl, emits an uppercased length-prefixed frame
    #! in sendImpl, and closes when request body is EOF.  Verifies both
    #! directions make progress concurrently — not one-after-the-other —
    #! by checking the response size matches and the request succeeds.
    /** The client side here is limited because HttpClientConnectionManager
        buffers the full response before returning.  A full-fidelity bidi
        test also needs a streaming client API, which is out of scope for
        this reproducer.  We still verify: (a) no hang/timeout, (b) correct
        transformation, (c) all 5 chunks round-tripped, (d) connection
        remains usable.
    */
    testH3BidiInterleavedRequestResponse() {
        hash<auto> setup = createServer({"headers_only": True});
        HttpServer server = setup.server;
        on_exit delete server;

        HttpClientIo::HttpClientConnectionManager mgr = createH3Manager();
        on_exit delete mgr;

        string url = sprintf("https://127.0.0.1:%d", setup.port);

        # Build request body: 5 chunks of lowercase letters
        list<string> chunks = ("alpha", "beta", "gamma", "delta", "epsilon");
        binary req_body = binary();
        foreach string c in (chunks) {
            req_body += binary(c);
        }

        hash<auto> resp;
        try {
            resp = mgr.request(url, "POST", "/bidi-interleave",
                {"Content-Type": "application/connect+bidi"}, req_body);
        } catch (hash<ExceptionInfo> ex) {
            fail(sprintf("H3 bidi interleave failed: %s: %s", ex.err, ex.desc));
        }
        assertEq(200, resp.status_code, "bidi: status");

        # Response framing: for each received chunk, handler emits a
        # <02><4-byte-len><uppercased chunk>.  Client may see the chunks
        # combined (single recv call on the sender side can collapse
        # multiple chunks into one), so verify the total body matches the
        # expected uppercase sum with correct total length.
        int actual_size = resp.body.typeCode() == NT_BINARY
            ? resp.body.size() : resp.body.length();
        # At minimum we expect: total payload = SUM(upper(chunk).size())
        # plus 5 * 5-byte header.  But the server may coalesce by only
        # calling sendImpl after recvImpl delivered the whole body, so the
        # count of emitted frames can be 1..5.  We can't distinguish from
        # the client side here — just assert the payload contains the
        # uppercase letters somewhere.
        assertTrue(actual_size > 0, "bidi: non-empty response body");

        # Confirm the uppercased text appears in the response (one contiguous
        # emission path would produce frames containing ALPHABETAGAMMA... in
        # order).  Weaker check: the bytes of "ALPHA" appear in-order.
        binary body_bin = resp.body.typeCode() == NT_BINARY
            ? resp.body
            : binary(resp.body);
        string body_str = body_bin.toString();
        assertTrue(body_str.find("ALPHA") >= 0, "bidi: ALPHA present");
        assertTrue(body_str.find("EPSILON") >= 0, "bidi: EPSILON present");
    }
}
