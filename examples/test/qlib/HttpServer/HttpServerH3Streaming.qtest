    LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
    FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
    DEALINGS IN THE SOFTWARE.

    Tests for HTTP/3 bidirectional streaming support (headers-only dispatch).

    Tests cover:
    - Unary POST with body over HTTP/3 (baseline)
    - Server-streaming GET → response via InputStream (baseline)
    - Client-streaming POST with headers-only dispatch, handler reads body
      incrementally via readQuicStreamDataBlock()
    - Headers-end-stream: GET with no body (FIN on HEADERS frame)
    - body_streaming flag correctly set in header_info
    - Backward-compat: handler without wantsBodyStreaming() gets buffered body
*/

%modern

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Mime.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/HttpServerUtil.qm
%requires ../../../../qlib/AsyncSocketIo
%requires ../../../../qlib/HttpServerAsyncIo
%requires ../../../../qlib/HttpServer.qm
%requires ../../../../qlib/HttpClientIo

%exec-class HttpServerH3StreamingTest

#! Size of the test payload
const TestPayloadSize = 64 * 1024;  # 64 KB

#! Size of each chunk for streaming writes

#! Generates a deterministic binary payload of the given size
binary sub generatePayload(int size) {
    return binary(strmul("D", size));
}

#! Handler that echoes the POST body back in the response
class EchoHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, body ?? "", {
            "Content-Type": hdr."content-type" ?? "application/octet-stream",
        });
    }
}

#! Handler that returns a large InputStream response (server-streaming)
class StreamResponseHandler inherits AbstractHttpRequestHandler {
    private {
        binary payload;
    }

    constructor(binary payload) {
        self.payload = payload;
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return <HttpResponseInfo>{
            "code": 200,
            "body": new BinaryInputStream(payload),
            "hdr": {
                "Content-Type": "application/octet-stream",
                "Content-Length": string(payload.size()),
            },
        };
    }
}

#! Handler that reads body incrementally via readQuicStreamDataBlock()
/** Tests headers-only dispatch: the handler is invoked before the request body
    arrives, then reads body data incrementally using the socket-level
    readQuicStreamDataBlock() method.
*/
class StreamingBodyHandler inherits AbstractHttpRequestHandler {
    private {
        #! Received data stored for test verification
        Mutex data_lock();
        list<hash<auto>> received_requests();
        int verbose;
    }

    constructor(int verbose = 0) {
        self.verbose = verbose;
    }

    #! Opt in to body streaming so the framework doesn't buffer the body
    bool wantsBodyStreaming(hash<auto> cx, hash<auto> hdr) {
        return True;
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        int session_id = cx."header-info".session_id;
        int stream_id = cx."header-info".stream_id;
        bool body_streaming = cx."header-info".body_streaming ?? False;
        bool headers_end_stream = cx."header-info".headers_end_stream ?? False;
        *Socket sock = cx."header-info".sock;

        if (verbose > 2) {
            printf("StreamingBodyHandler: session=%d stream=%d body_streaming=%y "
                "headers_end_stream=%y sock=%y body_present=%y\n",
                session_id, stream_id, body_streaming, headers_end_stream,
                exists sock, exists body);
        }

        hash<auto> result = {
            "method": hdr.method,
            "path": hdr.path,
            "body_streaming": body_streaming,
            "headers_end_stream": headers_end_stream,
            "session_id": session_id,
            "stream_id": stream_id,
        };

        if (body_streaming && !headers_end_stream) {
            # Read body incrementally
            if (verbose > 2) { printf("StreamingBodyHandler: entering streaming read loop\n"); }
            binary accumulated_body = binary();
            while (True) {
                *binary chunk = sock.readQuicStreamDataBlock(session_id, stream_id, 10s);
                if (verbose > 2) { printf("StreamingBodyHandler: read chunk size=%y\n", chunk.size()); }
                if (!exists chunk) {
                    if (verbose > 2) { printf("StreamingBodyHandler: no more data, exiting loop\n"); }
                    # Stream complete (END_STREAM received)
                    break;
                }
                accumulated_body += chunk;
            }
            if (verbose > 2) { printf("StreamingBodyHandler: total accumulated=%d\n", accumulated_body.size()); }
            result.body_size = accumulated_body.size();
            result.body = accumulated_body;
        } else if (body) {
            # Non-streaming: body was provided directly
            result.body_size = body.size();
            result.body = body;
        } else {
            result.body_size = 0;
        }

        {
            AutoLock al(data_lock);
            received_requests += result;
        }

        # Return the body size in the response
        return makeResponse(200, sprintf("%d", result.body_size), {
            "Content-Type": "text/plain",
            "X-Body-Streaming": body_streaming ? "true" : "false",
            "X-Headers-End-Stream": headers_end_stream ? "true" : "false",
        });
    }

    #! Returns received requests for test verification
    list<hash<auto>> getReceivedRequests() {
        AutoLock al(data_lock);
        return received_requests;
    }

    #! Clears received requests
    clearRequests() {
        AutoLock al(data_lock);
        received_requests = ();
    }
}

#! Handler that reads request body incrementally and echoes each chunk in the
#! response via an InputStream — true bidirectional streaming over H3.
class BidiEchoHandler inherits AbstractHttpRequestHandler {
    private {
        Mutex data_lock();
        list<hash<auto>> received_requests();
        int verbose;
    }

    constructor(int verbose = 0) {
        self.verbose = verbose;
    }

    bool wantsBodyStreaming(hash<auto> cx, hash<auto> hdr) {
        return True;
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        int session_id = cx."header-info".session_id;
        int stream_id = cx."header-info".stream_id;
        *Socket sock = cx."header-info".sock;
        bool body_streaming = cx."header-info".body_streaming ?? False;

        # Read request body incrementally when body_streaming is enabled;
        # otherwise use the already-buffered body.  After reading, echo the
        # full accumulated body back in the response.
        binary accumulated_body;
        if (body_streaming && sock) {
            while (True) {
                *binary chunk = sock.readQuicStreamDataBlock(session_id, stream_id, 10s);
                if (!exists chunk) {
                    break;
                }
                accumulated_body += chunk;
            }
        } else if (body) {
            accumulated_body = binary(body);
        }

        {
            AutoLock al(data_lock);
            received_requests += {
                "session_id": session_id,
                "stream_id": stream_id,
                "body_streaming": body_streaming,
                "body_size": accumulated_body.size(),
                "body": accumulated_body,
            };
        }

        # Echo the accumulated body back as the response
        return makeResponse(200, accumulated_body, {
            "content-type": "application/octet-stream",
            "x-echo-size": sprintf("%d", accumulated_body.size()),
        });
    }

    list<hash<auto>> getReceivedRequests() {
        AutoLock al(data_lock);
        return received_requests;
    }

    clearRequests() {
        AutoLock al(data_lock);
        received_requests = ();
    }
}

#! Handler that blocks until signaled so concurrent client requests stay
#! pending while we tear down the server to simulate a crash.
class SlowHandler inherits AbstractHttpRequestHandler {
    private {
        Counter m_ready;       # decremented once per request reaching the handler
        Counter m_stop_signal; # handler exits as soon as this reaches 0
    }

    constructor(int concurrency) {
        m_ready = new Counter(concurrency);
        m_stop_signal = new Counter(1);
    }

    #! Reaches zero once all expected requests are in flight — the test
    #! uses this to know when to simulate a server crash.
    Counter getReadyCounter() {
        return m_ready;
    }

    #! Called by the test to release blocked handlers so shutdown completes
    #! immediately instead of waiting on a fixed sleep.
    signalStop() {
        m_stop_signal.dec();
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        m_ready.dec();
        # Wait until the test releases us (via signalStop).  Using a Counter
        # instead of sleep(N) means the handler thread exits immediately once
        # the test simulates the server crash — no fixed-duration delay.
        m_stop_signal.waitForZero(60s);
        return makeResponse(200, "never-reached", {"content-type": "text/plain"});
    }
}

#! Non-I/O-thread-safe InputStream that emits N binary chunks with a
#! Counter-gated delay between chunks.  Used to test that server-side
#! streaming delivers chunks incrementally (not by eager materialization)
#! and that slow non-pollable InputStream reads don't block the I/O thread.
/** Qore-defined InputStream subclasses default to isIoThreadSafe()=false,
    so this stream exercises the materialization/worker-drain path in the
    server.
*/
class GatedInputStream inherits InputStream {
    private {
        list<binary> m_chunks;
        int m_idx = 0;
        Counter m_gate;   # test decs this to release the next chunk
        Counter m_ready;  # decremented as each chunk is emitted
    }

    #! @param chunks the binary chunks to emit in order
    #! @param gated_after_first  if True, emit chunk 0 immediately then gate
    #!                            each subsequent chunk on the gate Counter
    constructor(list<binary> chunks, bool gated_after_first = True) {
        m_chunks = chunks;
        m_gate = new Counter(gated_after_first ? chunks.size() - 1 : 0);
        m_ready = new Counter(chunks.size());
    }

    #! release the next gated chunk
    releaseNext() {
        if (m_gate.getCount() > 0) {
            m_gate.dec();
        }
    }

    #! wait until N chunks have been emitted via read()
    int waitForEmitted(int n, timeout t = 10s) {
        while (m_ready.getCount() > m_chunks.size() - n) {
            if (m_ready.getCount() == 0) {
                break;
            }
            usleep(10ms);
        }
        return m_ready.getCount();
    }

    *binary read(int limit) {
        if (m_idx >= m_chunks.size()) {
            return NOTHING;
        }
        # After chunk 0, wait on the gate so the test can observe incremental
        # delivery.  Blocking here must be on a worker thread — if it's on
        # the I/O thread the whole connection stalls.
        if (m_idx > 0) {
            m_gate.waitForZero(30s);
        }
        binary chunk = m_chunks[m_idx];
        m_idx++;
        m_ready.dec();
        return chunk;
    }

    int peek() {
        if (m_idx >= m_chunks.size()) {
            return -1;
        }
        binary chunk = m_chunks[m_idx];
        return chunk.size() > 0 ? chunk[0] : -1;
    }
}

#! Non-I/O-thread-safe InputStream whose read() blocks on a Counter for
#! up to `block_ms` per chunk before emitting data.  Simulates a
#! network-backed non-pollable stream.  Used by the "I/O thread must not
#! be blocked by non-pollable reads" test.
class SlowNonPollableInputStream inherits InputStream {
    private {
        binary m_payload;
        int m_block_ms;
        bool m_first = True;
        bool m_eof = False;
    }

    constructor(binary payload, int block_ms) {
        m_payload = payload;
        m_block_ms = block_ms;
    }

    *binary read(int limit) {
        if (m_eof) {
            return NOTHING;
        }
        # First read returns all the payload after a block; subsequent reads
        # return EOF.  Blocking on a Counter.waitForZero with timeout is the
        # closest thing to a blocking network read we can simulate without
        # real I/O.  If this runs on the I/O thread, the whole connection
        # stalls.
        if (m_first) {
            m_first = False;
            Counter c(1);
            c.waitForZero(seconds(m_block_ms / 1000) + (m_block_ms % 1000) * 1ms);
            m_eof = True;
            return m_payload;
        }
        return NOTHING;
    }

    int peek() {
        return m_eof ? -1 : (m_payload.size() > 0 ? m_payload[0] : -1);
    }
}

#! AbstractStreamRequest subclass that replicates the Qorus DataStream
#! pipeline shape: needsContentEncoding() = false, response Content-Type is
#! `application/connect+x`, and `sendImpl()` emits framed records one at a
#! time until EOF.  AbstractStreamRequest::sendResponse() then wraps these
#! via CallbackInputStream with no_content_encoding = True — the exact
#! path that fails in Qorus.
class ConnectStreamRequest inherits AbstractStreamRequest {
    private {
        int chunk_count;
        int chunk_size;
        int emitted = 0;
    }

    constructor(HttpListenerInterface listener, AbstractHttpRequestHandler handler, Socket s,
            hash<auto> cx, hash<auto> hdr, auto body, int chunk_count, int chunk_size)
            : AbstractStreamRequest(listener, handler, s, cx, hdr, body) {
        self.chunk_count = chunk_count;
        self.chunk_size = chunk_size;
    }

    # DataStream-style: handler does its own per-record framing; server must
    # not apply Content-Encoding on top (would break framing).
    bool needsContentEncoding() {
        return False;
    }

    # Signal chunked streaming; sendImpl() is called repeatedly until NOTHING.
    private hash<HttpHandlerResponseInfo> getResponseHeaderMessageImpl() {
        return <HttpHandlerResponseInfo>{
            "code": 200,
            "hdr": {
                "Content-Type": "application/connect+x",
                "Transfer-Encoding": "chunked",
            },
        };
    }

    private nothing recvImpl(hash<auto> v) {
        # We don't read a body for this test — just ignore incoming chunks.
    }

    private auto sendImpl() {
        if (emitted >= chunk_count) {
            return NOTHING;
        }
        int sz = chunk_size;
        binary header = <01>
            + binary(chr((sz >> 24) & 0xff))
            + binary(chr((sz >> 16) & 0xff))
            + binary(chr((sz >> 8) & 0xff))
            + binary(chr(sz & 0xff));
        binary frame = header + binary(strmul(chr(ord("A") + emitted), sz));
        emitted++;
        return frame;
    }
}

#! AbstractStreamRequest subclass for true bidi streaming: recvImpl
#! accumulates the request body chunk-by-chunk, and sendImpl() emits a
#! transformed record per received chunk (uppercase), one at a time.
/** This exercises the full bidi path: handler reads request body
    incrementally while producing response chunks.  Both directions must
    make progress concurrently on the same HTTP/3 stream.
*/
class BidiInterleaveStreamRequest inherits AbstractStreamRequest {
    private {
        Queue m_recv_queue();   # receive side: producer = recvImpl; consumer = sendImpl
        bool m_recv_eof = False;
        int m_emitted = 0;
    }

    constructor(HttpListenerInterface listener, AbstractHttpRequestHandler handler, Socket s,
            hash<auto> cx, hash<auto> hdr, auto body)
            : AbstractStreamRequest(listener, handler, s, cx, hdr, body) {
    }

    bool needsContentEncoding() {
        return False;
    }

    private hash<HttpHandlerResponseInfo> getResponseHeaderMessageImpl() {
        return <HttpHandlerResponseInfo>{
            "code": 200,
            "hdr": {
                "Content-Type": "application/connect+bidi",
                "Transfer-Encoding": "chunked",
            },
        };
    }

    private nothing recvImpl(hash<auto> v) {
        if (!exists v.data || (v.hasKey("hdr") && !exists v.hdr)) {
            m_recv_queue.push(NOTHING);
            m_recv_eof = True;
            return;
        }
        m_recv_queue.push(v.data);
    }

    private auto sendImpl() {
        # Pull one chunk from recv queue and emit a length-prefixed,
        # uppercased copy.  NOTHING from the queue = EOF on the request side.
        *binary chunk = m_recv_queue.get(30s);
        if (!exists chunk) {
            return NOTHING;
        }
        # Uppercase transformation: works on raw bytes so the test can
        # verify a deterministic mapping.
        binary upper = binary();
        for (int i = 0; i < chunk.size(); ++i) {
            int c = chunk[i];
            if (c >= ord("a") && c <= ord("z")) {
                c -= 32;
            }
            upper += binary(chr(c));
        }
        int sz = upper.size();
        binary header = <02>
            + binary(chr((sz >> 24) & 0xff))
            + binary(chr((sz >> 16) & 0xff))
            + binary(chr((sz >> 8) & 0xff))
            + binary(chr(sz & 0xff));
        m_emitted++;
        return header + upper;
    }
}

#! Handler that wires the bidi stream request subclass.
class BidiInterleaveHandler inherits AbstractHttpRequestHandler {
    constructor() : AbstractHttpRequestHandler(NOTHING, True) {}

    private AbstractStreamRequest getStreamRequestImpl(HttpListenerInterface listener, Socket s,
            hash<auto> cx, hash<auto> hdr, *data body) {
        return new BidiInterleaveStreamRequest(listener, self, s, cx, hdr, body);
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(500, "unexpected for stream handler",
            {"Content-Type": "text/plain"});
    }
}

#! Handler wiring the ConnectStreamRequest subclass into the
#! AbstractStreamRequest pipeline.  Must pass `stream=True` to the base
#! constructor so HttpServer uses `getStreamRequestImpl()` instead of the
#! classic non-streaming path.
class CallbackStreamResponseHandler inherits AbstractHttpRequestHandler {
    private {
        int chunk_count;
        int chunk_size;
    }

    constructor(int chunk_count = 3, int chunk_size = 1024)
            : AbstractHttpRequestHandler(NOTHING, True) {
        self.chunk_count = chunk_count;
        self.chunk_size = chunk_size;
    }

    # Return a subclass so send()/recv() run through our sendImpl/recvImpl.
    private AbstractStreamRequest getStreamRequestImpl(HttpListenerInterface listener, Socket s,
            hash<auto> cx, hash<auto> hdr, *data body) {
        return new ConnectStreamRequest(listener, self, s, cx, hdr, body,
            chunk_count, chunk_size);
    }

    # Never called directly when stream=True, but required abstract override.
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(500, "not expected for streaming handler",
            {"Content-Type": "text/plain"});
    }
}

#! Handler that returns an InputStream which emits chunks incrementally
#! (gated by a Counter the test controls).  Used to verify that server
#! streaming delivers chunks as they're produced, not by eagerly materializing
#! the entire stream before sending.
class IncrementalStreamResponseHandler inherits AbstractHttpRequestHandler {
    public {
        GatedInputStream m_stream;
    }

    constructor(list<binary> chunks) {
        m_stream = new GatedInputStream(chunks, True);
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return <HttpResponseInfo>{
            "code": 200,
            "body": m_stream,
            "hdr": {
                "Content-Type": "application/octet-stream",
            },
        };
    }
}

#! Handler that returns a SlowNonPollableInputStream response body.  Used to
#! verify the I/O thread does not block while non-pollable reads run.
class SlowStreamResponseHandler inherits AbstractHttpRequestHandler {
    private {
        int block_ms;
        binary payload;
    }

    constructor(int block_ms = 2000, int size = 4096) {
        self.block_ms = block_ms;
        self.payload = binary(strmul("S", size));
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return <HttpResponseInfo>{
            "code": 200,
            "body": new SlowNonPollableInputStream(payload, block_ms),
            "hdr": {
                "Content-Type": "application/octet-stream",
            },
        };
    }
}

#! Handler that resets the stream instead of sending a response.
/** Tests that the client receives a proper error (not an empty response) when
    the server RSTs the QUIC stream via resetQuicStream().
*/
class ResetStreamHandler inherits AbstractHttpRequestHandler {
    bool wantsBodyStreaming(hash<auto> cx, hash<auto> hdr) {
        return True;
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        int session_id = cx."header-info".session_id;
        int stream_id = cx."header-info".stream_id;
        *Socket sock = cx."header-info".sock;

        # Explicitly cancel the stream so the client sees RESET_STREAM instead
        # of a normal response.  cancelQuicStream sends both RESET_STREAM and
        # STOP_SENDING frames to the peer.
        if (sock && session_id > 0) {
            try {
                sock.cancelQuicStream(session_id, stream_id);
            } catch (hash<ExceptionInfo> ex) {
                # ignore — stream may already be closed
            }
        }

        # Return a placeholder response — should not reach the client because
        # the stream was reset
        return makeResponse(200, "should-not-receive", {
            "content-type": "text/plain",
        });
    }
}

#! Handler that reads one chunk and responds immediately (partial body read)
class PartialReadHandler inherits AbstractHttpRequestHandler {
    bool wantsBodyStreaming(hash<auto> cx, hash<auto> hdr) {
        return True;
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        int session_id = cx."header-info".session_id;
        int stream_id = cx."header-info".stream_id;
        bool body_streaming = cx."header-info".body_streaming ?? False;
        *Socket sock = cx."header-info".sock;

        if (body_streaming && sock) {
            # Read just one chunk and return immediately without reading the rest
            try {
                *binary chunk = sock.readQuicStreamDataBlock(session_id, stream_id, 5s);
                int chunk_size = chunk ? chunk.size() : 0;
                return makeResponse(200, sprintf("partial:%d", chunk_size), {
                    "Content-Type": "text/plain",
                });
            } catch (hash<ExceptionInfo> ex) {
                return makeResponse(500, sprintf("error:%s:%s", ex.err, ex.desc), {
                    "Content-Type": "text/plain",
                });
            }
        }
        return makeResponse(200, "no-streaming", {"Content-Type": "text/plain"});
    }
}

#! Handler for shutdown test — blocks in readQuicStreamDataBlock() until session is closed
/** Uses a large payload (4MB) so the handler is still reading when server.stop() fires.
    Signals a gate after receiving the first data chunk to synchronize with the test.
*/
class ShutdownTestHandler inherits AbstractHttpRequestHandler {
    private {
        Counter reading_gate(1);
    }

    bool wantsBodyStreaming(hash<auto> cx, hash<auto> hdr) {
        return True;
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        int session_id = cx."header-info".session_id;
        int stream_id = cx."header-info".stream_id;
        bool body_streaming = cx."header-info".body_streaming ?? False;
        *Socket sock = cx."header-info".sock;

        if (body_streaming && sock) {
            # Signal that we're in the handler and actively reading
            reading_gate.dec();

            # Read body data — with a 4MB payload and QUIC flow control, the handler
            # will be blocked in readQuicStreamDataBlock() for many iterations.
            # server.stop() calls markClosed() which signals the per-stream CV,
            # causing readQuicStreamDataBlock() to raise QUIC-ERROR immediately.
            while (True) {
                try {
                    *binary chunk = sock.readQuicStreamDataBlock(session_id, stream_id, 30s);
                    if (!exists chunk) {
                        break;
                    }
                } catch (hash<ExceptionInfo> ex) {
                    # Expected: QUIC-ERROR from markClosed() during shutdown
                    break;
                }
            }
        }
        return makeResponse(200, "ok", {"Content-Type": "text/plain"});
    }

    #! Waits until the handler has started reading
    /** @return 0 on success, ETIMEDOUT on timeout
    */
    int waitForReading(timeout t = 10s) {
        return reading_gate.waitForZero(t);
    }
}

#! Handler that exercises timeout handling by reading with a tiny timeout after data
class TimeoutHandler inherits AbstractHttpRequestHandler {
    private {
        Mutex lock();
        bool timeout_hit = False;
    }

    bool wantsBodyStreaming(hash<auto> cx, hash<auto> hdr) {
        return True;
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        int session_id = cx."header-info".session_id;
        int stream_id = cx."header-info".stream_id;
        bool body_streaming = cx."header-info".body_streaming ?? False;
        *Socket sock = cx."header-info".sock;

        if (body_streaming && sock) {
            # Read all available data first
            binary accumulated = binary();
            while (True) {
                try {
                    # Use 1ms timeout — after reading all available data, this will timeout
                    *binary chunk = sock.readQuicStreamDataBlock(session_id, stream_id, 1ms);
                    if (!exists chunk) {
                        # Stream complete
                        break;
                    }
                    accumulated += chunk;
                } catch (hash<ExceptionInfo> ex) {
                    if (ex.err == "QUIC-STREAM-TIMEOUT") {
                        {
                            AutoLock al(lock);
                            timeout_hit = True;
                        }
                        # Got timeout — this is the expected path when not all data arrived yet
                        return makeResponse(408, sprintf("timeout:%d", accumulated.size()), {
                            "Content-Type": "text/plain",
                        });
                    }
                    rethrow;
                }
            }
            # Got all data without timeout (happens when data arrives in one batch on loopback)
            return makeResponse(200, sprintf("complete:%d", accumulated.size()), {
                "Content-Type": "text/plain",
            });
        }
        return makeResponse(200, "no-streaming", {"Content-Type": "text/plain"});
    }

    bool wasTimeoutHit() {
        AutoLock al(lock);
        return timeout_hit;
    }
}

