    Interactive DataStream (Connect) tests (issue #5351).

    Proves the opt-in AbstractDataStreamRequestHandler::wantsInteractiveStreaming() path: a Connect
    DataStream handler that interleaves read -> reply on a single HTTP/2 or HTTP/3 stream so a client
    can do send-op -> read-result -> send-op (interactive read-your-writes within one session).  A
    "select" op must see the rows added by prior "insert" ops on the SAME stream — the legacy
    recv-all-then-send model cannot do this.
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"

%requires HttpServer
%requires RestHandler
%requires HttpClientIo
%requires Logger
%requires Mime
%requires QUnit
%requires yaml
%requires DataStreamUtil
%requires DataStreamRequestHandler

%requires json

%exec-class DataStreamInteractiveTest

#! interactive Connect session handler: holds session rows for the stream lifetime
/** Each inbound op is processed in recvDataImpl() (which queues exactly one reply); sendDataImpl()
    returns that reply, so the interactive loop writes a reply per op.  A "select" sees all prior
    "insert"s on the same stream (read-your-writes).
*/
class SessionDataStreamHandler inherits DataStreamRequestHandler::AbstractDataStreamRequestHandler {
    private {
        list<auto> m_rows = ();
        Queue m_replies();
    }

    constructor(hash<auto> cx, *hash<auto> ah) : AbstractDataStreamRequestHandler(cx, ah) {
    }

    #! opt in to the interactive bidirectional path (Connect mode on HTTP/2 and HTTP/3)
    bool wantsInteractiveStreaming() {
        return connect_mode && isMultiplexedTransport();
    }

    private hash<auto> getResponseHeaderMessageImpl() {
        return {
            "code": 200,
            "hdr": {"Content-Type": "application/connect+yaml"},
        };
    }

    #! process each inbound op; queue exactly one reply per op
    private nothing recvDataImpl(auto data) {
        if (!exists data) {
            return;
        }
        hash<auto> op = data;
        hash<auto> reply;
        switch (op.cmd) {
            case "insert":
                m_rows += op.row;
                reply = {"status": "ok", "n": m_rows.size()};
                break;
            case "select":
                reply = {"status": "ok", "rows": m_rows};
                break;
            default:
                reply = {"status": "error", "err": sprintf("unknown cmd %y", op.cmd)};
                break;
        }
        m_replies.push(reply);
    }

    #! return the next queued reply for the current op, or NOTHING when none remain
    private auto sendDataImpl() {
        if (m_replies.empty()) {
            return NOTHING;
        }
        return m_replies.get();
    }
}

#! RestHandler wiring the interactive Connect session handler at POST <root>?action=session
class SessionRestHandler inherits RestHandler::RestHandler {
    constructor() : RestHandler(NOTHING) {
    }

    removeRootPath(reference<string> path) {
        path = regex_subst(path, "^/?session-rest", "");
    }

    bool wantsBodyStreaming(hash<auto> cx, hash<auto> hdr) {
        return RestHandler::wantsBodyStreaming(cx, hdr);
    }

    RestHandler::AbstractRestStreamRequestHandler streamPostSession(hash<auto> cx, *hash<auto> ah) {
        return new SessionDataStreamHandler(cx, ah);
    }
}

