    constructor() : Test("DataStreamInteractiveTest", "1.0") {
        addTestCase("interactive Connect read-your-writes HTTP/2", \testInteractiveH2());
        addTestCase("interactive Connect read-your-writes HTTP/3", \testInteractiveH3());
        set_return_value(main());
    }

    globalSetUp() {
        mLogger = new Logger("ds-interactive-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            mLogger.addAppender(new StdoutAppender());
        }

        mServer = new HttpServer(<HttpServerOptionInfo>{
            "logger": mLogger,
            "debug": True,
            "quic_headers_only": True,
        });
        mServer.setHandler("session-rest", "/session-rest", NOTHING, new SessionRestHandler(),
            NOTHING, False);
        mServer.waitForAsyncIo();

        mPort = mServer.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
            "enable_h3": True,
        }).port;
        mServer.waitForAsyncIo();
    }

    globalTearDown() {
        delete mServer;
    }

    private HttpClientIo::HttpClientConnectionManager getManager(string protocol) {
        return new HttpClientIo::HttpClientConnectionManager(
            <HttpClientIo::HttpClientConnectionManagerOptions>{
                "protocol": protocol,
                "accept_all_certs": True,
                "logger": mLogger,
                "request_timeout": 30s,
                "connect_timeout": 15s,
            },
        );
    }

    #! frames a Connect message (5-byte envelope + YAML payload)
    private binary frameOp(hash<auto> op) {
        return DataStreamUtil::connect_frame_message(binary(make_yaml(op)), 0);
    }

    #! reads one complete Connect reply frame (skipping any non-data frames) from the stream
    private hash<auto> readReply(HttpClientIo::HttpClientStreamHandle stream, reference<binary> buf) {
        date deadline = now_us() + 20s;
        while (now_us() < deadline) {
            # try to decode a complete frame already buffered
            while (buf.size() >= 5) {
                int fsz = DataStreamUtil::connect_next_frame_size(buf);
                if (fsz < 0 || buf.size() < fsz) {
                    break;
                }
                hash<auto> frame = DataStreamUtil::connect_unframe_message(buf);
                buf = buf.size() > fsz ? buf.substr(fsz) : binary();
                if (frame.flags & DataStreamUtil::CONNECT_FLAG_END_STREAM) {
                    throw "STREAM-CLOSED", "stream end-of-stream frame arrived before a data reply";
                }
                return parse_yaml(binary_to_string(frame.data, "utf-8"));
            }
            auto data = stream.readData(5s);
            if (!exists data) {
                continue;
            }
            if (data.typeCode() == NT_HASH) {
                if (data.end_stream) {
                    throw "STREAM-CLOSED", "stream closed before a complete reply frame arrived";
                }
                if (data.error) {
                    throw "STREAM-ERROR", sprintf("stream error: %y", data.error);
                }
                continue;
            }
            buf += data.typeCode() == NT_BINARY ? data : binary(data);
        }
        throw "STREAM-TIMEOUT", "timed out waiting for a reply frame";
    }

    private doInteractiveSession(string protocol) {
        HttpClientIo::HttpClientConnectionManager mgr = getManager(protocol);
        on_exit delete mgr;

        string url = sprintf("https://127.0.0.1:%d", mPort);
        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireStream(url);
        assertTrue(stream.supportsStreaming(), protocol + ": stream supports streaming");

        # open one bidirectional Connect stream (body half-open)
        stream.startStreaming("POST", "/session-rest?action=session",
            {"Content-Type": "application/connect+yaml"}, True);

        binary buf = binary();

        # insert row 1, then select — the select must see the uncommitted insert
        stream.sendData(frameOp({"cmd": "insert", "row": {"id": 1}}));
        hash<auto> a1 = readReply(stream, \buf);
        assertEq("ok", a1.status, protocol + ": insert 1 acknowledged");
        assertEq(1, a1.n, protocol + ": session has 1 row after first insert");

        stream.sendData(frameOp({"cmd": "select"}));
        hash<auto> s1 = readReply(stream, \buf);
        assertEq(1, s1.rows.size(), protocol + ": in-session select sees the uncommitted insert");
        assertEq(1, s1.rows[0].id, protocol + ": select returned the inserted row");

        # insert row 2, then select again — must now see both rows (read-your-writes)
        stream.sendData(frameOp({"cmd": "insert", "row": {"id": 2}}));
        hash<auto> a2 = readReply(stream, \buf);
        assertEq(2, a2.n, protocol + ": session has 2 rows after second insert");

        stream.sendData(frameOp({"cmd": "select"}));
        hash<auto> s2 = readReply(stream, \buf);
        assertEq(2, s2.rows.size(), protocol + ": second select sees both uncommitted inserts");
        assertEq((1, 2), (map $1.id, s2.rows), protocol + ": both inserted rows visible in order");

        # half-close the request side; the handler emits the EndStreamResponse frame and completes
        stream.writesDone();

        date deadline = now_us() + 10s;
        while (now_us() < deadline) {
            auto data = stream.readData(2s);
            if (data.typeCode() == NT_HASH && data.end_stream) {
                break;
            }
        }
    }

    testInteractiveH2() {
        doInteractiveSession("h2");
    }

    testInteractiveH3() {
        doInteractiveSession("h3");
    }
}
