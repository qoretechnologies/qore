%modern

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/DataProvider
%requires ../../../../qlib/ConnectionProvider
%requires ../../../../qlib/RestClient.qm

%try-module json
%define NoJson
%endtry

%requires ../../../../qlib/KeapRestClient.qm
%requires ../../../../qlib/KeapDataProvider

%exec-class KeapDataProviderTest

public class KeapDataProviderTest inherits QUnit::Test {
    private {
        #! Keap REST client for integration tests
        *KeapRestClient::KeapRestClient client;

        #! Logger for verbose output
        Logger logger;

        #! Custom command-line options
        const MyOpts = Opts + {
            "client_id": "i,client-id=s",
            "client_secret": "s,client-secret=s",
            "token": "t,token=s",
            "conn": "c,connection=s",
        };

        #! Test contact ID (created during test)
        *string testContactId;

        #! Test company ID (created during test)
        *string testCompanyId;

        #! Test tag ID (created during test)
        *string testTagId;
    }

    constructor() : Test("KeapDataProvider Test", "1.0", \ARGV, MyOpts) {
        logger = new Logger("test", LoggerLevel::getLevelInfo());

        # Unit tests (always run, no credentials needed)
        addTestCase("sanity tests", \sanityTests());
        addTestCase("factory tests", \factoryTests());
        addTestCase("metadata tests", \metadataTests());
        addTestCase("child provider tests", \childProviderTests());
        addTestCase("data type tests", \dataTypeTests());
        addTestCase("trigger example data tests", \triggerExampleDataTests());
        addTestCase("negative tests", \negativeTests());
        addTestCase("connection tests", \connectionTests());

        # Integration tests (require Keap credentials)
        addTestCase("integration tests", \integrationTests());

        # Try to set up connection for integration tests
        try {
            setupConnection();
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("Connection setup failed: %s: %s\n", ex.err, ex.desc);
            }
        }

        set_return_value(main());
    }

    #! Sets up the Keap client for integration tests
    private setupConnection() {
        # Try to use a connection from Qorus if specified
        *string conn_name = m_options.conn ?? ENV.KEAP_CONNECTION;
        if (conn_name) {
            AbstractConnection conn = get_connection(conn_name);
            if (conn instanceof KeapRestClient::KeapRestConnection) {
                client = (cast<KeapRestClient::KeapRestConnection>(conn)).get(True);
            }
            return;
        }

        # Try environment variables
        *string token = m_options.token ?? ENV.KEAP_TOKEN;
        *string client_id = m_options.client_id ?? ENV.KEAP_CLIENT_ID;
        *string client_secret = m_options.client_secret ?? ENV.KEAP_CLIENT_SECRET;
        *string refresh_token = ENV.KEAP_REFRESH_TOKEN;

        if (token) {
            client = new KeapRestClient::KeapRestClient({"token": token});
        } else if (client_id && client_secret && refresh_token) {
            client = new KeapRestClient::KeapRestClient({
                "oauth2_client_id": client_id,
                "oauth2_client_secret": client_secret,
                "oauth2_refresh_token": refresh_token,
            });
        }
    }

    #! Basic sanity tests
    sanityTests() {
        # Verify module loaded
        assertEq(True, True, "module loaded");

        # Verify constants
        assertEq("Keap", KeapDataProvider::AppName);
        assertEq(100, KeapDataProvider::DefaultPageSize);
        assertEq(60, KeapDataProvider::DefaultPollInterval);
        assertEq(30, KeapDataProvider::MinPollInterval);

        # Verify event constants
        assertEq("contact-added", KeapDataProvider::EVENT_CONTACT_ADDED);
        assertEq("contact-updated", KeapDataProvider::EVENT_CONTACT_UPDATED);
        assertEq("tag-applied", KeapDataProvider::EVENT_TAG_APPLIED);
        assertEq("opportunity-added", KeapDataProvider::EVENT_OPPORTUNITY_ADDED);
        assertEq("order-added", KeapDataProvider::EVENT_ORDER_ADDED);
        assertEq("task-created", KeapDataProvider::EVENT_TASK_CREATED);
        assertEq("note-added", KeapDataProvider::EVENT_NOTE_ADDED);
    }

    #! Factory tests
    factoryTests() {
        # Verify factory exists
        AbstractDataProviderFactory factory = DataProvider::getFactory("keap");
        assertEq(True, factory instanceof KeapDataProvider::KeapDataProviderFactory);

        # Verify factory info
        hash<DataProviderFactoryInfo> info = factory.getInfo();
        assertEq("keap", info.name);
        assertEq(True, info.children_can_support_apis);
        assertEq(True, info.children_can_support_records);
        assertEq(True, info.children_can_support_observers);
    }

    #! Metadata tests
    metadataTests() {
        # Verify action catalog app registration
        *hash<auto> app = DataProviderActionCatalog::getApp("Keap");
        assertEq(True, app.val(), "Keap app registered in action catalog");
        assertEq("Keap", app.display_name);
        assertEq("keaprest", app.scheme);

        # Verify some actions are registered
        list<hash<auto>> actions = DataProviderActionCatalog::getActions("Keap");
        assertEq(True, actions.size() > 40, "at least 40 actions registered");

        # Verify specific action
        bool found_create_contact = False;
        bool found_list_contacts = False;
        bool found_contact_added_event = False;
        foreach hash<auto> action in (actions) {
            if (action.action == "create-contact") {
                found_create_contact = True;
                assertEq(DPAT_API, action.action_code);
            }
            if (action.action == "list-contacts") {
                found_list_contacts = True;
                assertEq(DPAT_FIND, action.action_code);
            }
            if (action.action == "contact-added") {
                found_contact_added_event = True;
                assertEq(DPAT_EVENT, action.action_code);
            }
        }
        assertEq(True, found_create_contact, "create-contact action registered");
        assertEq(True, found_list_contacts, "list-contacts action registered");
        assertEq(True, found_contact_added_event, "contact-added event registered");
    }

    #! Child provider tests
    childProviderTests() {
        if (!client) {
            testSkip("no Keap credentials available");
        }

        KeapDataProvider::KeapDataProvider provider(client);

        # Verify child names
        *list<string> children = provider.getChildProviderNames();
        assertEq(True, children.size() >= 14, "at least 14 child providers");
        assertEq(True, inlist("contacts", children), "contacts child exists");
        assertEq(True, inlist("companies", children), "companies child exists");
        assertEq(True, inlist("opportunities", children), "opportunities child exists");
        assertEq(True, inlist("tags", children), "tags child exists");
        assertEq(True, inlist("events", children), "events child exists");
        assertEq(True, inlist("execute-api-call", children), "execute-api-call child exists");

        # Verify child providers can be created
        AbstractDataProvider contacts = provider.getChildProvider("contacts");
        assertEq(True, contacts instanceof KeapDataProvider::KeapContactsDataProvider);

        AbstractDataProvider events = provider.getChildProvider("events");
        assertEq(True, events instanceof KeapDataProvider::KeapEventsDataProvider);
    }

    #! Data type tests
    dataTypeTests() {
        # Test contact data type
        KeapDataProvider::KeapContactDataType contact_type();
        hash<auto> fields = contact_type.getFields();
        assertEq(True, fields.hasKey("id"), "contact type has id field");
        assertEq(True, fields.hasKey("email"), "contact type has email field");
        assertEq(True, fields.hasKey("given_name"), "contact type has given_name field");
        assertEq(True, fields.hasKey("family_name"), "contact type has family_name field");

        # Test company data type
        KeapDataProvider::KeapCompanyDataType company_type();
        hash<auto> cfields = company_type.getFields();
        assertEq(True, cfields.hasKey("id"), "company type has id field");
        assertEq(True, cfields.hasKey("company_name"), "company type has company_name field");

        # Test tag data type
        KeapDataProvider::KeapTagDataType tag_type();
        hash<auto> tfields = tag_type.getFields();
        assertEq(True, tfields.hasKey("id"), "tag type has id field");
        assertEq(True, tfields.hasKey("name"), "tag type has name field");
    }

    #! Trigger example data tests
    triggerExampleDataTests() {
        if (!client) {
            testSkip("no Keap credentials available");
        }

        KeapDataProvider::KeapDataProvider provider(client);
        AbstractDataProvider events = provider.getChildProvider("events");

        # Verify all event children exist
        *list<string> event_children = events.getChildProviderNames();
        assertEq(True, event_children.size() >= 7, "at least 7 event providers");

        # Verify each trigger can provide example data
        foreach string event_name in (event_children) {
            AbstractDataProvider trigger = events.getChildProvider(event_name);
            hash<string, hash<DataProviderMessageInfo>> event_types = trigger.getEventTypes();
            assertEq(True, event_types.size() > 0,
                sprintf("trigger %s has event types", event_name));

            foreach string event_type in (keys event_types) {
                auto example = trigger.getExampleEventData(event_type);
                assertEq(True, example instanceof hash,
                    sprintf("trigger %s returns hash example data for %s", event_name, event_type));
            }
        }
    }

    #! Negative tests
    negativeTests() {
        # Test invalid factory name returns NOTHING
        assertEq(NOTHING, DataProvider::getFactory("nonexistent_keap"),
            "nonexistent factory returns NOTHING");
    }

    #! Connection tests
    connectionTests() {
        # Verify connection scheme is registered
        assertEq(True, exists ConnectionSchemeCache::getScheme("keaprest"),
            "keaprest scheme registered");

        # Verify connection scheme info
        hash<auto> scheme = ConnectionSchemeCache::getScheme("keaprest");
        assertEq("Keap REST Connection", scheme.display_name);
    }

    #! Integration tests (require Keap credentials)
    integrationTests() {
        if (!client) {
            testSkip("no Keap credentials available");
        }

        KeapDataProvider::KeapDataProvider provider(client);

        # Test list contacts
        AbstractDataProvider contacts_dp = provider.getChildProvider("contacts");
        AbstractDataProviderRecordIterator iter = contacts_dp.searchRecords(NOTHING, {"limit": 5});
        list<hash<auto>> contacts = ();
        while (iter.next()) {
            contacts += iter.getValue();
        }
        assertEq(True, True, "contacts list succeeded");

        # Test create contact
        AbstractDataProvider create_dp = contacts_dp.getChildProvider("create");
        string test_email = "test_keapdp_" + now_us().getEpochSeconds() + "@example.com";
        hash<auto> new_contact = create_dp.doRequest({
            "given_name": "Test",
            "family_name": "KeapDP_" + now_us().toString(),
            "email": test_email,
        });
        assertEq(True, new_contact.id.val(), "contact created with ID");
        assertEq(test_email, new_contact.email, "create response includes email");
        testContactId = string(new_contact.id);

        on_exit {
            # Cleanup: delete test contact
            if (testContactId) {
                try {
                    AbstractDataProvider del_dp = contacts_dp.getChildProvider("delete");
                    del_dp.doRequest({"contact_id": testContactId});
                } catch (hash<ExceptionInfo> ex) {
                    if (m_options.verbose) {
                        printf("Cleanup failed (contact): %s: %s\n", ex.err, ex.desc);
                    }
                }
            }
        }

        # Test get contact by ID — verify email is returned
        AbstractDataProviderRecordIterator get_iter = contacts_dp.searchRecords(NOTHING,
            {"contact_id": testContactId});
        assertEq(True, get_iter.next(), "found created contact");
        hash<auto> found = get_iter.getValue();
        assertEq("Test", found.given_name);
        assertEq(test_email, found.email, "get contact returns email");

        # Test update contact
        AbstractDataProvider update_dp = contacts_dp.getChildProvider("update");
        hash<auto> updated = update_dp.doRequest({
            "contact_id": testContactId,
            "job_title": "QA Tester",
        });
        assertEq(True, updated.val(), "contact updated");
        assertEq("QA Tester", updated.job_title, "update response includes job_title");
        assertEq(test_email, updated.email, "update response includes email");

        # Verify persistence - re-fetch and check
        AbstractDataProviderRecordIterator verify_iter = contacts_dp.searchRecords(NOTHING,
            {"contact_id": testContactId});
        assertEq(True, verify_iter.next(), "found updated contact");
        hash<auto> verified = verify_iter.getValue();
        assertEq("QA Tester", verified.job_title, "job_title persisted");

        # Test list tags
        AbstractDataProvider tags_dp = provider.getChildProvider("tags");
        AbstractDataProviderRecordIterator tag_iter = tags_dp.searchRecords(NOTHING, {"limit": 5});
        list<hash<auto>> tags = ();
        while (tag_iter.next()) {
            tags += tag_iter.getValue();
        }
        assertEq(True, True, "tags list succeeded");

        # Test create tag
        AbstractDataProvider create_tag_dp = tags_dp.getChildProvider("create");
        hash<auto> new_tag = create_tag_dp.doRequest({
            "name": "Test_KeapDP_" + now_us().getEpochSeconds(),
            "description": "Test tag for KeapDataProvider integration test",
        });
        assertEq(True, new_tag.id.val(), "tag created with ID");
        testTagId = string(new_tag.id);

        on_exit {
            # Cleanup: delete test tag
            if (testTagId) {
                try {
                    AbstractDataProvider del_tag_dp = tags_dp.getChildProvider("delete");
                    del_tag_dp.doRequest({"tag_id": testTagId});
                } catch (hash<ExceptionInfo> ex) {
                    if (m_options.verbose) {
                        printf("Cleanup failed (tag): %s: %s\n", ex.err, ex.desc);
                    }
                }
            }
        }

        # Test apply tag to contact
        AbstractDataProvider apply_dp = tags_dp.getChildProvider("apply");
        hash<auto> apply_result = apply_dp.doRequest({
            "contact_id": testContactId,
            "tag_ids": (new_tag.id.toInt(),),
        });
        assertEq(True, True, "tag applied to contact");

        # Test remove tag from contact
        AbstractDataProvider remove_dp = tags_dp.getChildProvider("remove");
        hash<auto> remove_result = remove_dp.doRequest({
            "contact_id": testContactId,
            "tag_id": testTagId,
        });
        assertEq(True, True, "tag removed from contact");

        # Test execute-api-call
        AbstractDataProvider api_dp = provider.getChildProvider("execute-api-call");
        hash<auto> api_result = api_dp.doRequest({
            "method": "GET",
            "path": "contacts?limit=1",
        });
        assertEq(True, api_result instanceof hash, "execute-api-call returned hash");

        # Test list tasks
        AbstractDataProvider tasks_dp = provider.getChildProvider("tasks");
        AbstractDataProviderRecordIterator task_iter = tasks_dp.searchRecords(NOTHING, {"limit": 5});
        assertEq(True, True, "tasks list succeeded");

        # Test list products
        AbstractDataProvider products_dp = provider.getChildProvider("products");
        AbstractDataProviderRecordIterator prod_iter = products_dp.searchRecords(NOTHING, {"limit": 5});
        assertEq(True, True, "products list succeeded");
    }
}
