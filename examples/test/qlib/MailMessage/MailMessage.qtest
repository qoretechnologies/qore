%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires Mime
%requires MailMessage

%exec-class Main

public class Main inherits QUnit::Test {
    private {
        const Sender = "foo@bar.cz";
        const Subject = "foo bar";
        const To = "target@bar.cz";
    }

    constructor() : Test("MailMessageTest", "1.0") {
        addTestCase("Test serialize()", \testSerialize(), NOTHING);
        addTestCase("Test multipart type detection", \testMultipartTypeDetection(), NOTHING);
        addTestCase("Test getFrom bug fix", \testGetFromBugFix(), NOTHING);
        addTestCase("Test attachment handling", \testAttachmentHandling(), NOTHING);
        addTestCase("Test RFC 2231 filename encoding", \testRfc2231FilenameEncoding(), NOTHING);
        addTestCase("Test inline attachments", \testInlineAttachments(), NOTHING);
        addTestCase("Test Part and Attachment classes", \testPartAndAttachmentClasses(), NOTHING);
        addTestCase("Test deprecated encoding constants", \testDeprecatedEncodingConstants(), NOTHING);
        addTestCase("Test SMTP transparency and header line breaks", \testLineBreaks(), NOTHING);
        addTestCase("Test re-serialization of parsed messages", \testParsedRoundTrip(), NOTHING);
        addTestCase("Test read receipt header parsing", \testReadReceipt(), NOTHING);
        addTestCase("Test character encoding of serialized messages", \testEncoding(), NOTHING);
        addTestCase("Test names of unnamed attachments", \testUnnamedAttachmentNames(), NOTHING);
        addTestCase("Test the sender's display name", \testSenderDisplayName(), NOTHING);
        addTestCase("Test the From header of parsed messages", \testParsedFromHeader(), NOTHING);
        addTestCase("Test email addresses (issue #6066)", \testEmailAddresses(), NOTHING);
        addTestCase("Test address headers (issue #6066)", \testAddressHeaders(), NOTHING);
        addTestCase("Test addresses of parsed messages (issue #6066)", \testParsedAddresses(), NOTHING);
        addTestCase("Test header line endings and control characters (issue #6066)", \testHeaderEncoding(),
            NOTHING);
        addTestCase("Test address header round trips (issue #6066)", \testAddressRoundTrips(), NOTHING);
        addTestCase("Test address header folding (issue #6066)", \testAddressFolding(), NOTHING);
        addTestCase("Test long address headers (issue #6066)", \testLongAddressHeaders(), NOTHING);
        addTestCase("Test address headers written again unchanged (issue #6066)", \testStableRoundTrips(), NOTHING);
        addTestCase("Test text after non-ASCII addresses (issue #6066)", \testNonAsciiOffsets(), NOTHING);
        addTestCase("Test format characters and comments around addresses (issue #6066)",
            \testFormatCharsAndComments(), NOTHING);
        addTestCase("Test display names with format characters (issue #6066)", \testDisplayNameFormatChars(),
            NOTHING);
        addTestCase("Test addresses in quoted strings (issue #6066)", \testQuotedStringAddresses(), NOTHING);
        addTestCase("Test recipients of entries with several addresses (issue #6134)", \testListRecipients(),
            NOTHING);
        addTestCase("Test the time to get the recipients of long entries (issue #6134)", \testListRecipientsTime(),
            NOTHING);
        addTestCase("Test sender round trips (issue #6134)", \testSenderRoundTrips(), NOTHING);
        addTestCase("Test encoded word lookalikes (issue #6134)", \testEncodedWordLookalikes(), NOTHING);
        addTestCase("Test recipients with a separate display name (issue #6134)", \testNameAddressRecipients(),
            NOTHING);
        addTestCase("Test quoted local part duplicates (issue #6134)", \testQuotedLocalPartDuplicates(), NOTHING);
        addTestCase("Test multipart boundary (issue #6307)", \testBoundary(), NOTHING);

        set_return_value(main());
    }

    testSerialize() {
        {
            # issue #3275: test SMTP serialization
            Message msg(Sender, Subject);
            string body = "test\r\n.\r\n";
            msg.setBody(body);
            msg.addTO(To);

            string file = "119195|281522|230667|ATEAAT1Glasfaser_SCHWECHAT|LEASEDLINE|ERROR|Lease number already "
                "exists in EBS. The operation ABS (CREATE) is not the right one.";
            msg.attach("file.csv", MimeTypeText, file);
            string r = msg.serialize();
            on_error printf("%y\n", r);
            assertFalse(r =~ /^\.\r$/m);

            msg = new Message(r);
            assertEq((To,), msg.getTO());
            assertEq(Sender, msg.getFrom());
            assertEq(Subject, msg.getSubject());
            assertEq(body, msg.getBody());
            assertEq(file, msg.getAttachments()[0].getData());
        }

        {
            string body = "some body";

            Message msg(Sender, Subject);
            msg.setBody(body);

            msg.addTO(To);

            msg.attach("foo.txt", MimeTypeText, "lorem ipsum", ContentEncoding::Base64);
            string r = msg.serialize();

            string refstr = "From: foo@bar.cz\r
To: target@bar.cz\r
Subject: foo bar\r
MIME-Version: 1.0\r
Content-Type: multipart/mixed; boundary=\"MjAxNjAxMjIxMTQ4MDg\"\r
\r
This is a MIME multipart message\r
--MjAxNjAxMjIxMTQ4MDg\r
Content-Type: text/plain; charset=UTF-8\r
Content-Disposition: inline\r
Content-Transfer-Encoding: quoted-printable\r
\r
some body\r
--MjAxNjAxMjIxMTQ4MDg\r
Content-Type: text/plain; name=\"foo.txt\"; charset=UTF-8\r
Content-Disposition: attachment; filename=\"foo.txt\"\r
Content-Transfer-Encoding: base64\r
\r
bG9yZW0gaXBzdW0=\r
--MjAxNjAxMjIxMTQ4MDg--\r
";
            # get boundary from generated message
            string boundary = (r =~ x/boundary="([^"]+)"/)[0];
            r = replace(r, boundary, "MjAxNjAxMjIxMTQ4MDg");
            assertEq(refstr, r);
        }
        {
            Message msg(Sender, Subject);
            msg.setBody("body");
            msg.addTO(To);

            msg.attach("foo.txt", MimeTypeText, "lorem ipsum");
            string r = msg.serialize();

            string refstr = "From: foo@bar.cz\r
To: target@bar.cz\r
Subject: foo bar\r
MIME-Version: 1.0\r
Content-Type: multipart/mixed; boundary=\"MjAxNjAxMjIxMTQ4MDg\"\r
\r
This is a MIME multipart message\r
--MjAxNjAxMjIxMTQ4MDg\r
Content-Type: text/plain; charset=UTF-8\r
Content-Disposition: inline\r
Content-Transfer-Encoding: quoted-printable\r
\r
body\r
--MjAxNjAxMjIxMTQ4MDg\r
Content-Type: text/plain; name=\"foo.txt\"; charset=UTF-8\r
Content-Disposition: attachment; filename=\"foo.txt\"\r
Content-Transfer-Encoding: base64\r
\r
bG9yZW0gaXBzdW0=\r
--MjAxNjAxMjIxMTQ4MDg--\r
";

            # get boundary from generated message
            string boundary = (r =~ x/boundary="([^"]+)"/)[0];
            r = replace(r, boundary, "MjAxNjAxMjIxMTQ4MDg");
            assertEq(refstr.split("\r\n"), r.split("\r\n"));
            #assertEq(refstr, r);
        }
        {
            Message msg(Sender, Subject);
            msg.setBody("body");
            msg.addTO(To);

            msg.attach("foo.txt", MimeTypeText, "lorem ipsum", ContentEncoding::Default);
            string r = msg.serialize();

            string refstr = "From: foo@bar.cz\r
To: target@bar.cz\r
Subject: foo bar\r
MIME-Version: 1.0\r
Content-Type: multipart/mixed; boundary=\"MjAxNjAxMjIxMTQ4MDg\"\r
\r
This is a MIME multipart message\r
--MjAxNjAxMjIxMTQ4MDg\r
Content-Type: text/plain; charset=UTF-8\r
Content-Disposition: inline\r
Content-Transfer-Encoding: quoted-printable\r
\r
body\r
--MjAxNjAxMjIxMTQ4MDg\r
Content-Type: text/plain; name=\"foo.txt\"; charset=UTF-8\r
Content-Disposition: attachment; filename=\"foo.txt\"\r
Content-Transfer-Encoding: quoted-printable\r
\r
lorem ipsum\r
--MjAxNjAxMjIxMTQ4MDg--\r
";

            # get boundary from generated message
            string boundary = (r =~ x/boundary="([^"]+)"/)[0];
            r = replace(r, boundary, "MjAxNjAxMjIxMTQ4MDg");
            assertEq(refstr.split("\r\n"), r.split("\r\n"));
            #assertEq(refstr, r);
        }
        {
            # test issue #2360
            Message msg(Sender, Subject);
            msg.addBody("body");
            msg.addTO(To);
            string r = msg.serialize();
            assertRegex("Content-Transfer-Encoding: quoted-printable", r);
        }
    }

    testMultipartTypeDetection() {
        # Test non-multipart message
        {
            string simpleMsg = "From: foo@bar.cz\r\n"
                "To: target@bar.cz\r\n"
                "Subject: simple test\r\n"
                "MIME-Version: 1.0\r\n"
                "Content-Type: text/plain\r\n"
                "\r\n"
                "Hello world\r\n";

            Message msg(simpleMsg);
            assertFalse(msg.isMultipart(), "simple message is not multipart");
            assertNothing(msg.getMultipartType(), "simple message has no multipart type");
            assertFalse(msg.isSigned(), "simple message is not signed");
            assertFalse(msg.isEncrypted(), "simple message is not encrypted");
            assertFalse(msg.isDigest(), "simple message is not digest");

            hash<MailMessageInfo> info = msg.getInfo();
            assertFalse(info.is_multipart, "info.is_multipart is False");
            assertNothing(info.multipart_type, "info.multipart_type is nothing");
            assertFalse(info.is_signed, "info.is_signed is False");
            assertFalse(info.is_encrypted, "info.is_encrypted is False");
            assertFalse(info.is_digest, "info.is_digest is False");
        }

        # Test multipart/mixed message
        {
            string mixedMsg = "From: foo@bar.cz\r\n"
                "To: target@bar.cz\r\n"
                "Subject: mixed test\r\n"
                "MIME-Version: 1.0\r\n"
                "Content-Type: multipart/mixed; boundary=boundary123\r\n"
                "\r\n"
                "--boundary123\r\n"
                "Content-Type: text/plain\r\n"
                "\r\n"
                "Hello world\r\n"
                "--boundary123--\r\n";

            Message msg(mixedMsg);
            assertTrue(msg.isMultipart(), "mixed message is multipart");
            assertEq("mixed", msg.getMultipartType(), "mixed message has 'mixed' type");
            assertFalse(msg.isSigned(), "mixed message is not signed");
            assertFalse(msg.isEncrypted(), "mixed message is not encrypted");
            assertFalse(msg.isDigest(), "mixed message is not digest");

            hash<MailMessageInfo> info = msg.getInfo();
            assertTrue(info.is_multipart, "info.is_multipart is True");
            assertEq("mixed", info.multipart_type, "info.multipart_type is 'mixed'");
        }

        # Test multipart/alternative message
        {
            string altMsg = "From: foo@bar.cz\r\n"
                "To: target@bar.cz\r\n"
                "Subject: alternative test\r\n"
                "MIME-Version: 1.0\r\n"
                "Content-Type: multipart/alternative; boundary=altbound\r\n"
                "\r\n"
                "--altbound\r\n"
                "Content-Type: text/plain\r\n"
                "\r\n"
                "Plain text\r\n"
                "--altbound\r\n"
                "Content-Type: text/html\r\n"
                "\r\n"
                "<html><body>HTML</body></html>\r\n"
                "--altbound--\r\n";

            Message msg(altMsg);
            assertTrue(msg.isMultipart(), "alternative message is multipart");
            assertEq("alternative", msg.getMultipartType(), "alternative message has 'alternative' type");
            assertFalse(msg.isSigned(), "alternative message is not signed");
            assertFalse(msg.isEncrypted(), "alternative message is not encrypted");
            assertFalse(msg.isDigest(), "alternative message is not digest");
        }

        # Test multipart/signed message (RFC 1847)
        {
            string signedMsg = "From: foo@bar.cz\r\n"
                "To: target@bar.cz\r\n"
                "Subject: signed test\r\n"
                "MIME-Version: 1.0\r\n"
                "Content-Type: multipart/signed; boundary=sigbound; "
                    "micalg=sha-256; protocol=\"application/pkcs7-signature\"\r\n"
                "\r\n"
                "--sigbound\r\n"
                "Content-Type: text/plain\r\n"
                "\r\n"
                "Signed content\r\n"
                "--sigbound\r\n"
                "Content-Type: application/pkcs7-signature\r\n"
                "\r\n"
                "signature-data\r\n"
                "--sigbound--\r\n";

            Message msg(signedMsg);
            assertTrue(msg.isMultipart(), "signed message is multipart");
            assertEq("signed", msg.getMultipartType(), "signed message has 'signed' type");
            assertTrue(msg.isSigned(), "signed message isSigned() returns True");
            assertFalse(msg.isEncrypted(), "signed message is not encrypted");
            assertFalse(msg.isDigest(), "signed message is not digest");

            hash<MailMessageInfo> info = msg.getInfo();
            assertTrue(info.is_signed, "info.is_signed is True");
        }

        # Test multipart/encrypted message (RFC 1847)
        {
            string encMsg = "From: foo@bar.cz\r\n"
                "To: target@bar.cz\r\n"
                "Subject: encrypted test\r\n"
                "MIME-Version: 1.0\r\n"
                "Content-Type: multipart/encrypted; boundary=encbound; "
                    "protocol=\"application/pgp-encrypted\"\r\n"
                "\r\n"
                "--encbound\r\n"
                "Content-Type: application/pgp-encrypted\r\n"
                "\r\n"
                "Version: 1\r\n"
                "--encbound\r\n"
                "Content-Type: application/octet-stream\r\n"
                "\r\n"
                "encrypted-data\r\n"
                "--encbound--\r\n";

            Message msg(encMsg);
            assertTrue(msg.isMultipart(), "encrypted message is multipart");
            assertEq("encrypted", msg.getMultipartType(), "encrypted message has 'encrypted' type");
            assertFalse(msg.isSigned(), "encrypted message is not signed");
            assertTrue(msg.isEncrypted(), "encrypted message isEncrypted() returns True");
            assertFalse(msg.isDigest(), "encrypted message is not digest");

            hash<MailMessageInfo> info = msg.getInfo();
            assertTrue(info.is_encrypted, "info.is_encrypted is True");
        }

        # Test multipart/digest message (RFC 2046)
        {
            string digestMsg = "From: foo@bar.cz\r\n"
                "To: target@bar.cz\r\n"
                "Subject: digest test\r\n"
                "MIME-Version: 1.0\r\n"
                "Content-Type: multipart/digest; boundary=digestbound\r\n"
                "\r\n"
                "--digestbound\r\n"
                "Content-Type: message/rfc822\r\n"
                "\r\n"
                "From: user1@example.com\r\n"
                "Subject: Message 1\r\n"
                "\r\n"
                "First message\r\n"
                "--digestbound\r\n"
                "Content-Type: message/rfc822\r\n"
                "\r\n"
                "From: user2@example.com\r\n"
                "Subject: Message 2\r\n"
                "\r\n"
                "Second message\r\n"
                "--digestbound--\r\n";

            Message msg(digestMsg);
            assertTrue(msg.isMultipart(), "digest message is multipart");
            assertEq("digest", msg.getMultipartType(), "digest message has 'digest' type");
            assertFalse(msg.isSigned(), "digest message is not signed");
            assertFalse(msg.isEncrypted(), "digest message is not encrypted");
            assertTrue(msg.isDigest(), "digest message isDigest() returns True");

            hash<MailMessageInfo> info = msg.getInfo();
            assertTrue(info.is_digest, "info.is_digest is True");
        }

        # Test that roundtrip serialization preserves multipart status
        {
            Message msg(Sender, Subject);
            msg.setBody("body content");
            msg.addTO(To);
            msg.attach("file.txt", MimeTypeText, "attachment content");

            string serialized = msg.serialize();
            Message parsed(serialized);

            assertTrue(parsed.isMultipart(), "parsed message is multipart");
            assertEq("mixed", parsed.getMultipartType(), "parsed message has 'mixed' type");
        }
    }

    # Test that getFrom() returns the correct email address for messages created via constructor
    # This tests the fix for the bug where self.sender was not set in the constructor
    testGetFromBugFix() {
        # Test with simple email address
        {
            Message msg(Sender, Subject);
            msg.addTO(To);
            msg.setBody("test body");

            # getFrom() should return the sender's email address for SMTP MAIL FROM
            assertEq(Sender, msg.getFrom(), "getFrom() returns sender email for constructor-created message");
            # getSender() returns the display format
            assertEq(Sender, msg.getSender(), "getSender() returns sender email for simple address");
        }

        # Test with display name format "Name <email>"
        {
            string displaySender = "John Doe <john@example.com>";
            Message msg(displaySender, Subject);
            msg.addTO(To);
            msg.setBody("test body");

            # getFrom() should return just the email address
            assertEq("john@example.com", msg.getFrom(), "getFrom() extracts email from display format");
            # getSender() returns the full display format
            assertEq(displaySender, msg.getSender(), "getSender() returns the display format");
        }

        # Test that getFrom() is not empty after construction
        {
            Message msg(Sender, Subject);
            assertTrue(msg.getFrom().val(), "getFrom() is not empty after construction");
        }

        # Test that getRecipients() returns correct list for SMTP RCPT TO
        {
            Message msg(Sender, Subject);
            msg.addTO(To);
            msg.addTO("another@example.com");
            msg.addCC("cc@example.com");
            msg.setBody("test body");

            list<string> recipients = msg.getRecipients();
            assertTrue(recipients.contains(To), "getRecipients() contains TO address");
            assertTrue(recipients.contains("another@example.com"), "getRecipients() contains second TO address");
            assertTrue(recipients.contains("cc@example.com"), "getRecipients() contains CC address");
        }
    }

    # an attachment without a filename is named after its index in the list of parts that holds it, also in a nested
    # multipart part (qore#5690: the index is passed to the code that names it, as $# is unset in a called method)
    testUnnamedAttachmentNames() {
        string msg = "From: a@example.com\r\nTo: b@example.com\r\nSubject: t\r\nMIME-Version: 1.0\r\n"
            "Content-Type: multipart/mixed; boundary=\"OUT\"\r\n\r\n"
            "--OUT\r\nContent-Type: text/plain\r\n\r\nbody\r\n"
            "--OUT\r\nContent-Type: application/octet-stream\r\nContent-Disposition: attachment\r\n\r\nfirst\r\n"
            "--OUT\r\nContent-Type: application/octet-stream\r\nContent-Disposition: attachment\r\n\r\nsecond\r\n"
            "--OUT\r\nContent-Type: multipart/mixed; boundary=\"IN\"\r\n\r\n"
            "--IN\r\nContent-Type: text/plain\r\n\r\ninner body\r\n"
            "--IN\r\nContent-Type: application/octet-stream\r\nContent-Disposition: attachment\r\n\r\nthird\r\n"
            "--IN--\r\n"
            "--OUT--\r\n";
        Message parsed(msg);
        list<auto> names = map ($1.getName(), $1.getData().toString()), parsed.getAttachments();
        assertEq((("unnamed-attachment-1", "first"), ("unnamed-attachment-2", "second"),
            ("unnamed-attachment-1", "third")), names);
    }

    # Test comprehensive attachment handling
    testAttachmentHandling() {
        # Test binary attachment
        {
            Message msg(Sender, Subject);
            msg.setBody("Test body");
            msg.addTO(To);

            # Create a small binary "image" (PNG header bytes)
            binary png_data = <89504E470D0A1A0A0000000D49484452>;
            msg.attach("image.png", MimeTypePng, png_data, ContentEncoding::Base64);

            string serialized = msg.serialize();
            assertRegex("Content-Type: image/png", serialized);
            assertRegex("Content-Disposition: attachment", serialized);

            # Parse the message back
            Message parsed(serialized);
            list<Attachment> attachments = parsed.getAttachments();
            assertEq(1, attachments.size(), "parsed message has 1 attachment");
            assertEq("image.png", attachments[0].getName(), "attachment name preserved");
            assertEq(png_data, attachments[0].getData(), "binary data preserved");
        }

        # Test multiple attachments
        {
            Message msg(Sender, Subject);
            msg.setBody("Test body");
            msg.addTO(To);

            msg.attach("file1.txt", MimeTypeText, "Content 1");
            msg.attach("file2.txt", MimeTypeText, "Content 2");
            msg.attach("file3.txt", MimeTypeText, "Content 3");

            assertEq(3, msg.getAttachments().size(), "message has 3 attachments");

            string serialized = msg.serialize();
            Message parsed(serialized);

            list<Attachment> attachments = parsed.getAttachments();
            assertEq(3, attachments.size(), "parsed message has 3 attachments");
            assertEq("file1.txt", attachments[0].getName());
            assertEq("file2.txt", attachments[1].getName());
            assertEq("file3.txt", attachments[2].getName());
        }

        # Test attachment with quoted-printable encoding
        {
            Message msg(Sender, Subject);
            msg.setBody("Test body");
            msg.addTO(To);

            msg.attach("document.txt", MimeTypeText, "Line 1\r\nLine 2\r\nLine 3", ContentEncoding::QuotedPrintable);

            string serialized = msg.serialize();
            assertRegex("Content-Transfer-Encoding: quoted-printable", serialized);
        }

        # Test attachment with no encoding (ContentEncoding::None not allowed for attachments, should use ContentEncoding::Default)
        {
            Message msg(Sender, Subject);
            msg.setBody("Test body");
            msg.addTO(To);

            msg.attach("data.txt", MimeTypeText, "Simple text", ContentEncoding::Default);

            string serialized = msg.serialize();
            # ContentEncoding::Default for text should use quoted-printable
            assertRegex("Content-Transfer-Encoding: quoted-printable", serialized);
        }

        # Test empty attachment
        {
            Message msg(Sender, Subject);
            msg.setBody("Test body");
            msg.addTO(To);

            msg.attach("empty.txt", MimeTypeText, "");

            string serialized = msg.serialize();
            Message parsed(serialized);

            list<Attachment> attachments = parsed.getAttachments();
            assertEq(1, attachments.size(), "parsed message has 1 empty attachment");
            assertEq("", attachments[0].getData(), "empty attachment data");
        }

        # Test large attachment (simulated)
        {
            Message msg(Sender, Subject);
            msg.setBody("Test body");
            msg.addTO(To);

            # Create a larger text content
            string large_content = strmul("ABCDEFGHIJ", 1000);  # 10KB
            msg.attach("large.txt", MimeTypeText, large_content, ContentEncoding::Base64);

            string serialized = msg.serialize();
            Message parsed(serialized);

            list<Attachment> attachments = parsed.getAttachments();
            assertEq(1, attachments.size());
            assertEq(large_content, attachments[0].getData(), "large attachment data preserved");
        }
    }

    # Test RFC 2231 filename encoding/decoding for non-ASCII filenames
    testRfc2231FilenameEncoding() {
        # Test encode_mime_filename with ASCII filename
        {
            string filename = "simple.txt";
            string encoded = encode_mime_filename(filename);
            assertEq(filename, encoded, "ASCII filename not encoded");
        }

        # Test encode_mime_filename with non-ASCII filename
        {
            string filename = "文档.pdf";
            string encoded = encode_mime_filename(filename);
            assertTrue(encoded.regex("^utf-8''"), "non-ASCII filename RFC 2231 encoded");
            assertNeq(filename, encoded, "non-ASCII filename is different when encoded");
        }

        # Test decode_mime_filename with plain filename
        {
            string filename = "simple.txt";
            string decoded = decode_mime_filename(filename);
            assertEq(filename, decoded, "plain filename decoded unchanged");
        }

        # Test decode_mime_filename with RFC 2231 encoded filename
        {
            string encoded = "utf-8''%E6%96%87%E6%A1%A3.pdf";
            string decoded = decode_mime_filename(encoded);
            assertEq("文档.pdf", decoded, "RFC 2231 filename decoded correctly");
        }

        # Test roundtrip encoding/decoding
        {
            string original = "日本語ファイル.txt";
            string encoded = encode_mime_filename(original);
            string decoded = decode_mime_filename(encoded);
            assertEq(original, decoded, "RFC 2231 roundtrip preserves filename");
        }

        # Test sanitize_filename removes path separators
        {
            string filename = "../../../etc/passwd";
            string sanitized = sanitize_filename(filename);
            assertFalse(sanitized.regex("/"), "path separators removed");
            assertFalse(sanitized.regex("\\\\"), "backslash removed");
        }

        # Test sanitize_filename removes control characters
        {
            string filename = "file" + chr(0) + "name" + chr(0x1f) + ".txt";
            string sanitized = sanitize_filename(filename);
            assertEq(-1, sanitized.find(chr(0)), "null byte removed");
            assertEq(-1, sanitized.find(chr(0x1f)), "control character removed");
            assertEq("filename.txt", sanitized, "control characters stripped");
        }

        # Test sanitize_filename removes leading dots
        {
            string filename = "...hidden.txt";
            string sanitized = sanitize_filename(filename);
            assertFalse(sanitized.regex("^\\."), "leading dots removed");
            assertEq("hidden.txt", sanitized);
        }

        # Test sanitize_filename with empty result returns default
        {
            string filename = "///";
            string sanitized = sanitize_filename(filename);
            assertEq("attachment", sanitized, "empty sanitized filename returns default");
        }

        # Test sanitize_filename preserves UTF-8 multibyte characters
        {
            string filename = "文档报告.pdf";
            string sanitized = sanitize_filename(filename);
            assertEq(filename, sanitized, "UTF-8 Chinese characters preserved");
        }

        # Test sanitize_filename with Japanese characters
        {
            string filename = "日本語ファイル.txt";
            string sanitized = sanitize_filename(filename);
            assertEq(filename, sanitized, "UTF-8 Japanese characters preserved");
        }

        # Test sanitize_filename with mixed ASCII and UTF-8
        {
            string filename = "report_文档_2026.pdf";
            string sanitized = sanitize_filename(filename);
            assertEq(filename, sanitized, "mixed ASCII and UTF-8 preserved");
        }

        # Test sanitize_filename with UTF-8 and control chars
        {
            string filename = "报告" + chr(0) + "文件.txt";
            string sanitized = sanitize_filename(filename);
            assertEq("报告文件.txt", sanitized, "UTF-8 preserved, control chars removed");
        }

        # Test sanitize_filename with UTF-8 and path separators
        {
            string filename = "путь/файл.txt";
            string sanitized = sanitize_filename(filename);
            assertEq("путьфайл.txt", sanitized, "Cyrillic UTF-8 preserved, path separator removed");
        }

        # Test sanitize_filename with emoji (4-byte UTF-8)
        {
            string filename = "report_📊_2026.pdf";
            string sanitized = sanitize_filename(filename);
            assertEq(filename, sanitized, "emoji (4-byte UTF-8) preserved");
        }

        # Test RFC 2231 encoding in serialized message
        {
            Message msg(Sender, Subject);
            msg.setBody("test body");
            msg.addTO(To);

            # Attach a file with non-ASCII filename
            msg.attach("文档.pdf", MimeTypePdf, <255044462D>, ContentEncoding::Base64);

            string serialized = msg.serialize();

            # Verify RFC 2231 encoded filename appears in serialized output
            assertRegex("filename\\*=utf-8''", serialized, "RFC 2231 filename* parameter present");
            assertRegex("name\\*=utf-8''", serialized, "RFC 2231 name* parameter present");
        }

        # Test RFC 2231 roundtrip: serialize then parse
        {
            Message msg(Sender, Subject);
            msg.setBody("test body");
            msg.addTO(To);

            string original_filename = "日本語レポート.xlsx";
            msg.attach(original_filename, MimeTypeOctetStream, <DEADBEEF>, ContentEncoding::Base64);

            string serialized = msg.serialize();
            Message parsed(serialized);

            list<Attachment> attachments = parsed.getAttachments();
            assertEq(1, attachments.size(), "parsed message has attachment");
            assertEq(original_filename, attachments[0].getName(), "UTF-8 filename preserved through roundtrip");
        }

        # Test filenames with spaces and special characters
        {
            string filename = "my file (copy).txt";
            string encoded = encode_mime_filename(filename);
            # Spaces and parentheses should be percent-encoded
            assertTrue(encoded == filename || encoded.regex("%20") || encoded.regex("utf-8''"),
                "filename with spaces encoded");
        }
    }

    # Test inline attachments with Content-ID
    testInlineAttachments() {
        # Test creating inline attachment
        {
            Message msg(Sender, Subject);
            msg.setBody("<html><body><img src=\"cid:logo123\"></body></html>", ContentEncoding::QuotedPrintable, MimeTypeHtml);
            msg.addTO(To);

            binary logo_data = <89504E470D0A1A0A>;  # PNG header
            msg.attachInline("logo.png", MimeTypePng, logo_data, "logo123");

            list<Attachment> attachments = msg.getAttachments();
            assertEq(1, attachments.size());
            assertTrue(attachments[0].isInline(), "attachment is inline");
            assertEq("logo123", attachments[0].getContentId(), "Content-ID set correctly");

            string serialized = msg.serialize();
            assertRegex("Content-ID: <logo123>", serialized, "Content-ID header present");
        }

        # Test Attachment constructor with Content-ID
        {
            Attachment att("image.jpg", MimeTypeJpeg, <FFFFFFFFFFFF>, ContentEncoding::Base64, NOTHING, "img001");
            assertTrue(att.isInline(), "Attachment with cid is inline");
            assertEq("img001", att.getContentId(), "Content-ID from constructor");
        }

        # Test regular attachment is not inline
        {
            Attachment att("file.txt", MimeTypeText, "content");
            assertFalse(att.isInline(), "regular attachment is not inline");
            assertNothing(att.getContentId(), "no Content-ID for regular attachment");
        }

        # Test parsing message with Content-ID
        {
            string msgWithCid = "From: foo@bar.cz\r\n"
                "To: target@bar.cz\r\n"
                "Subject: inline test\r\n"
                "MIME-Version: 1.0\r\n"
                "Content-Type: multipart/mixed; boundary=bound123\r\n"
                "\r\n"
                "--bound123\r\n"
                "Content-Type: text/html\r\n"
                "\r\n"
                "<img src=\"cid:image001\">\r\n"
                "--bound123\r\n"
                "Content-Type: image/png\r\n"
                "Content-Disposition: attachment; filename=\"logo.png\"\r\n"
                "Content-ID: <image001>\r\n"
                "Content-Transfer-Encoding: base64\r\n"
                "\r\n"
                "iVBORw0KGgo=\r\n"
                "--bound123--\r\n";

            Message msg(msgWithCid);
            list<Attachment> attachments = msg.getAttachments();
            assertEq(1, attachments.size());
            assertEq("image001", attachments[0].getContentId(), "Content-ID parsed from message");
        }

        # Test multiple inline attachments
        {
            Message msg(Sender, Subject);
            msg.setBody("<html><img src=\"cid:img1\"><img src=\"cid:img2\"></html>", ContentEncoding::QuotedPrintable, MimeTypeHtml);
            msg.addTO(To);

            msg.attachInline("img1.png", MimeTypePng, <FF>, "img1");
            msg.attachInline("img2.png", MimeTypePng, <FF>, "img2");

            list<Attachment> attachments = msg.getAttachments();
            assertEq(2, attachments.size());
            assertTrue(attachments[0].isInline());
            assertTrue(attachments[1].isInline());
            assertEq("img1", attachments[0].getContentId());
            assertEq("img2", attachments[1].getContentId());
        }

        # Test inline attachment has filename in serialized output
        {
            Message msg(Sender, Subject);
            msg.setBody("<html><img src=\"cid:logo\"></html>", ContentEncoding::QuotedPrintable, MimeTypeHtml);
            msg.addTO(To);

            msg.attachInline("company_logo.png", MimeTypePng, <89504E470D0A1A0A>, "logo");

            string serialized = msg.serialize();

            # Verify inline disposition with filename
            assertRegex("Content-Disposition: inline", serialized, "inline disposition present");
            assertRegex("filename=", serialized, "filename parameter present for inline attachment");
            assertRegex("company_logo\\.png", serialized, "filename value correct");
            assertRegex("Content-ID: <logo>", serialized, "Content-ID header present");
        }

        # Test inline attachment roundtrip
        {
            Message msg(Sender, Subject);
            msg.setBody("<html><body><img src=\"cid:image123\"></body></html>", ContentEncoding::QuotedPrintable, MimeTypeHtml);
            msg.addTO(To);

            binary img_data = <89504E470D0A1A0ADEADBEEF>;
            msg.attachInline("test_image.png", MimeTypePng, img_data, "image123");

            # Serialize and parse
            string serialized = msg.serialize();
            Message parsed(serialized);

            # Verify inline attachment is returned by getAttachments()
            list<Attachment> attachments = parsed.getAttachments();
            assertEq(1, attachments.size(), "inline attachment returned by getAttachments()");
            assertEq("test_image.png", attachments[0].getName(), "inline attachment name preserved");
            assertEq("image123", attachments[0].getContentId(), "inline attachment Content-ID preserved");
            assertEq(img_data, attachments[0].getData(), "inline attachment data preserved");
            assertTrue(attachments[0].isInline(), "attachment recognized as inline after roundtrip");
        }

        # Test parsing message with Content-Disposition: inline and filename
        {
            string msgWithInline = "From: foo@bar.cz\r\n"
                "To: target@bar.cz\r\n"
                "Subject: inline test\r\n"
                "MIME-Version: 1.0\r\n"
                "Content-Type: multipart/mixed; boundary=bound456\r\n"
                "\r\n"
                "--bound456\r\n"
                "Content-Type: text/html\r\n"
                "\r\n"
                "<html><img src=\"cid:img001\"></html>\r\n"
                "--bound456\r\n"
                "Content-Type: image/png\r\n"
                "Content-Disposition: inline; filename=\"inline_image.png\"\r\n"
                "Content-ID: <img001>\r\n"
                "Content-Transfer-Encoding: base64\r\n"
                "\r\n"
                "iVBORw0KGgo=\r\n"
                "--bound456--\r\n";

            Message msg(msgWithInline);
            list<Attachment> attachments = msg.getAttachments();

            assertEq(1, attachments.size(), "inline attachment with filename parsed");
            assertEq("inline_image.png", attachments[0].getName(), "inline attachment filename parsed");
            assertEq("img001", attachments[0].getContentId(), "inline Content-ID parsed");
            assertTrue(attachments[0].isInline(), "attachment marked as inline");
        }

        # Test parsing message with Content-Disposition: inline and Content-ID but no filename
        {
            string msgInlineNoCid = "From: foo@bar.cz\r\n"
                "To: target@bar.cz\r\n"
                "Subject: inline no filename\r\n"
                "MIME-Version: 1.0\r\n"
                "Content-Type: multipart/mixed; boundary=bound789\r\n"
                "\r\n"
                "--bound789\r\n"
                "Content-Type: text/html\r\n"
                "\r\n"
                "<html><img src=\"cid:img002\"></html>\r\n"
                "--bound789\r\n"
                "Content-Type: image/jpeg\r\n"
                "Content-Disposition: inline\r\n"
                "Content-ID: <img002>\r\n"
                "Content-Transfer-Encoding: base64\r\n"
                "\r\n"
                "/9j/4AAQ\r\n"
                "--bound789--\r\n";

            Message msg(msgInlineNoCid);
            list<Attachment> attachments = msg.getAttachments();

            assertEq(1, attachments.size(), "inline attachment with only Content-ID parsed");
            assertEq("img002", attachments[0].getContentId(), "Content-ID parsed");
            assertTrue(attachments[0].isInline(), "attachment marked as inline from Content-ID");
        }

        # Test inline attachment with non-ASCII filename
        {
            Message msg(Sender, Subject);
            msg.setBody("<html><img src=\"cid:logo\"></html>", ContentEncoding::QuotedPrintable, MimeTypeHtml);
            msg.addTO(To);

            string utf8_filename = "公司标志.png";
            msg.attachInline(utf8_filename, MimeTypePng, <89504E470D0A1A0A>, "logo");

            string serialized = msg.serialize();

            # Should have RFC 2231 encoded filename for inline attachment
            assertRegex("filename\\*=utf-8''", serialized, "RFC 2231 filename for inline attachment");

            # Roundtrip test
            Message parsed(serialized);
            list<Attachment> attachments = parsed.getAttachments();
            assertEq(1, attachments.size());
            assertEq(utf8_filename, attachments[0].getName(), "UTF-8 inline filename preserved");
            assertTrue(attachments[0].isInline(), "inline status preserved");
        }

        # Test mixed regular and inline attachments
        {
            Message msg(Sender, Subject);
            msg.setBody("<html><img src=\"cid:img\">Text</html>", ContentEncoding::QuotedPrintable, MimeTypeHtml);
            msg.addTO(To);

            msg.attachInline("inline.png", MimeTypePng, <FF>, "img");
            msg.attach("regular.pdf", MimeTypePdf, <255044462D>);

            string serialized = msg.serialize();

            # Verify both types present
            assertRegex("Content-Disposition: inline", serialized, "inline disposition present");
            assertRegex("Content-Disposition: attachment", serialized, "attachment disposition present");

            # Roundtrip
            Message parsed(serialized);
            list<Attachment> attachments = parsed.getAttachments();
            assertEq(2, attachments.size(), "both attachments parsed");

            # Find inline and regular attachments
            bool found_inline = False;
            bool found_regular = False;
            for (int i = 0; i < attachments.size(); i++) {
                if (attachments[i].getName() == "inline.png") {
                    assertTrue(attachments[i].isInline(), "inline.png is inline");
                    assertEq("img", attachments[i].getContentId());
                    found_inline = True;
                } else if (attachments[i].getName() == "regular.pdf") {
                    assertFalse(attachments[i].isInline(), "regular.pdf is not inline");
                    found_regular = True;
                }
            }
            assertTrue(found_inline, "found inline attachment");
            assertTrue(found_regular, "found regular attachment");
        }
    }

    # Test Part and Attachment class methods
    testPartAndAttachmentClasses() {
        # Test Part getters
        {
            Part p("test.txt", MimeTypeText, "Hello World", ContentEncoding::QuotedPrintable);
            assertEq("test.txt", p.getName(), "Part.getName()");
            assertEq(MimeTypeText, p.getMime(), "Part.getMime()");
            assertEq("Hello World", p.getData(), "Part.getData()");
            assertEq(11, p.getSize(), "Part.getSize()");
            assertEq(ContentEncoding::QuotedPrintable, p.getTransferEncoding(), "Part.getTransferEncoding()");
            assertNothing(p.getContentId(), "Part.getContentId() when not set");
        }

        # Test Part with headers
        {
            hash<auto> hdr = {"X-Custom": "value", "content-id": "<part123>"};
            Part p("data.bin", MimeTypeOctetStream, <DEADBEEF>, ContentEncoding::Base64, hdr);
            hash<auto> headers = p.getHeaders();
            assertEq("value", headers."X-Custom", "custom header preserved");
            assertEq("part123", p.getContentId(), "Content-ID extracted from headers");
        }

        # Test Part.getInfo()
        {
            Part p("info.txt", MimeTypeText, "content", ContentEncoding::Base64);
            hash<auto> info = p.getInfo();
            assertEq("info.txt", info.name);
            assertEq(MimeTypeText, info.mime);
            assertEq("content", info.part_data);
            assertEq(ContentEncoding::Base64, info.transfer_encoding);
            assertEq(7, info.size);
            assertNothing(info.content_id);
        }

        # Test Attachment inherits Part methods
        {
            Attachment att("doc.pdf", MimeTypePdf, <25504446>, ContentEncoding::Base64);
            assertEq("doc.pdf", att.getName());
            assertEq(MimeTypePdf, att.getMime());
            assertEq(4, att.getSize());
            assertEq(ContentEncoding::Base64, att.getTransferEncoding());
            assertFalse(att.isInline());
        }

        # Test Attachment.getInfo()
        {
            Attachment att("file.txt", MimeTypeText, "test data", ContentEncoding::Base64, NOTHING, "cid123");
            hash<auto> info = att.getInfo();
            assertEq("file.txt", info.name);
            assertEq(MimeTypeText, info.mime);
            assertEq("test data", info.part_data);
            assertEq(ContentEncoding::Base64, info.transfer_encoding);
            assertEq(9, info.size);
            assertEq("cid123", info.content_id);
        }

        # Test binary data size
        {
            binary data = <0102030405060708090A>;
            Attachment att("binary.dat", MimeTypeOctetStream, data);
            assertEq(10, att.getSize(), "binary attachment size");
        }

        # Test empty data size
        {
            Attachment att("empty.txt", MimeTypeText, "");
            assertEq(0, att.getSize(), "empty attachment size");
        }

        # Test Attachment encoding validation
        {
            # ContentEncoding::Default should resolve to appropriate encoding
            Attachment att1("text.txt", MimeTypeText, "text content", ContentEncoding::Default);
            assertEq(ContentEncoding::QuotedPrintable, att1.getTransferEncoding(), "ContentEncoding::Default for text -> quoted-printable");

            Attachment att2("bin.dat", MimeTypeOctetStream, <DEADBEEF>, ContentEncoding::Default);
            assertEq(ContentEncoding::Base64, att2.getTransferEncoding(), "ContentEncoding::Default for binary -> base64");
        }

        # Test Message getInfo with attachments
        {
            Message msg(Sender, Subject);
            msg.setBody("body");
            msg.addTO(To);
            msg.attach("att1.txt", MimeTypeText, "content1");
            msg.attachInline("att2.png", MimeTypePng, <FF>, "cid2");

            hash<MailMessageInfo> info = msg.getInfo();
            assertEq(2, info.attachments.size());
            assertEq("att1.txt", info.attachments[0].name);
            assertEq("att2.png", info.attachments[1].name);
            assertEq("cid2", info.attachments[1].content_id);
        }
    }

    # Test backward-compatible deprecated encoding constants
    testDeprecatedEncodingConstants() {
        # Test that deprecated constants have the same values as the enum members
        assertEq(ContentEncoding::Default, EncDefault, "EncDefault matches ContentEncoding::Default");
        assertEq(ContentEncoding::None, EncNone, "EncNone matches ContentEncoding::None");
        assertEq(ContentEncoding::Base64, EncBase64, "EncBase64 matches ContentEncoding::Base64");
        assertEq(ContentEncoding::QuotedPrintable, EncQuotedPrintable,
            "EncQuotedPrintable matches ContentEncoding::QuotedPrintable");

        # Test that the string values are correct
        assertEq("default", EncDefault, "EncDefault is 'default'");
        assertEq("none", EncNone, "EncNone is 'none'");
        assertEq("base64", EncBase64, "EncBase64 is 'base64'");
        assertEq("quoted-printable", EncQuotedPrintable, "EncQuotedPrintable is 'quoted-printable'");

        # Test that deprecated constants work with the Encodings list
        assertTrue(inlist(EncDefault, Encodings), "EncDefault in Encodings list");
        assertTrue(inlist(EncNone, Encodings), "EncNone in Encodings list");
        assertTrue(inlist(EncBase64, Encodings), "EncBase64 in Encodings list");
        assertTrue(inlist(EncQuotedPrintable, Encodings), "EncQuotedPrintable in Encodings list");

        # Test that deprecated constants can be used in Message API calls
        {
            Message msg(Sender, Subject);
            msg.setBody("test body", EncDefault);
            msg.addTO(To);
            msg.attach("file.txt", MimeTypeText, "content", EncBase64);
            string serialized = msg.serialize();
            assertRegex("Content-Transfer-Encoding: base64", serialized,
                "EncBase64 works with attach()");
        }

        # Test that deprecated constants can be used with Attachment constructor
        {
            Attachment att("doc.pdf", MimeTypePdf, <25504446>, EncBase64);
            assertEq(ContentEncoding::Base64, att.getTransferEncoding(),
                "EncBase64 works with Attachment constructor");
        }
    }

    testLineBreaks() {
        # SMTP transparency
        assertEq("a\r\nb\r\nc\r\nd\r\n", Message::encodeSmtpData("a\nb\rc\r\nd"));
        assertEq("..a\r\n..\r\nb\r\n...c\r\n", Message::encodeSmtpData(".a\n.\nb\r..c"));
        assertEq("a\r\n", Message::encodeSmtpData("a\r\n"));
        assertEq("", Message::encodeSmtpData(""));

        # serialize() in SMTP mode adds a "." to every line that starts with "." and writes bare CR and LF as CRLF;
        # serializeRaw() does not change the body
        Message msg(Sender, Subject);
        msg.addTO(To);
        msg.setBody(".hello\n.\nbye", ContentEncoding::None);
        string raw = msg.serializeRaw();
        assertRegex("\r\n\r\n\\.hello\n\\.\nbye\r\n$", raw);
        assertEq(Message::encodeSmtpData(raw), msg.serialize());
        assertRegex("\r\n\r\n\\.\\.hello\r\n\\.\\.\r\nbye\r\n$", msg.serialize());
        # a message created with SMTP mode off is serialized as it is
        msg = new Message(Sender, Subject, False);
        msg.addTO(To);
        msg.setBody(".hello\r\nbye", ContentEncoding::None);
        assertEq(msg.serializeRaw(), msg.serialize());
        assertRegex("\r\n\\.hello\r\n", msg.serialize());

        # a header value with a line break is encoded; a header name with one, or a value that is not encoded, is
        # refused
        assertEq("X-Test: =?UTF-8?Q?a=0D=0AX-Injected:_1?=\r\n", Message::doHeaderValue("X-Test", "a\r\nX-Injected: 1"));
        assertThrows("HEADER-ERROR", "message header name \"X-Test\\\\x0d\\\\x0aX-Injected\" contains a line break",
            \Message::doHeaderValue(), ("X-Test\r\nX-Injected", "1"));
        assertThrows("HEADER-ERROR", "message header \"X-Test\" value .* contains a line break",
            \Message::doHeaderValue(), ("X-Test", "a\nb", "\r\n", False));
        assertEq("X-Test: a b\r\n", Message::doHeaderValue("X-Test", "a b", "\r\n", False));
        msg = new Message(Sender, Subject);
        msg.addTO(To);
        msg.setBody("body");
        msg.addHeader({"X-Test\nX-Injected": "1"});
        assertThrows("HEADER-ERROR", \msg.serializeRaw());
        assertThrows("HEADER-ERROR", \msg.serialize());

        # the address in angle brackets is the address, not text in the display name that looks like one
        assertEq("sender@example.com", Message::getEmailAddress("support@bank.example <sender@example.com>"));
        assertEq("sender@example.com", Message::getEmailAddress("\"x\" <sender@example.com> "));
        assertEq("sender@example.com", Message::getEmailAddress("sender@example.com"));
        assertNothing(Message::getEmailAddress("no address"));

        # a parsed message: getFrom() is the address, getSender() the From header
        Message parsed("From: Sender Name <sender@example.com>\r\nTo: to@example.com\r\nSubject: s\r\n\r\nbody\r\n");
        assertEq("sender@example.com", parsed.getFrom());
        assertEq("Sender Name <sender@example.com>", parsed.getSender());
        parsed = new Message("From: no address\r\nTo: to@example.com\r\nSubject: s\r\n\r\nbody\r\n");
        assertEq("", parsed.getFrom());
        assertEq("no address", parsed.getSender());

        # the headers given for an attachment are added to its part, except the generated ones; the Content-ID is
        # found in any case
        msg = new Message(Sender, Subject);
        msg.addTO(To);
        msg.setBody("body");
        msg.attach("a.txt", MimeTypeText, "data", ContentEncoding::Base64, {"X-Tag": "t1",
            "content-type": "x/ignored", "CONTENT-TRANSFER-ENCODING": "ignored", "Content-Length": 99});
        msg.attach(new Attachment("b.png", MimeTypePng, <89504e47>, ContentEncoding::Base64, {"Content-ID": "<cid1>"}));
        string ser = msg.serializeRaw();
        assertRegex("\r\nX-Tag: t1\r\n", ser);
        assertFalse(regex(ser, "x/ignored|: ignored|Content-Length: 99"));
        assertRegex("\r\nContent-ID: <cid1>\r\n", ser);
        assertEq(1, (ser =~ x/(Content-ID:)/g).size());
        assertEq("cid1", msg.getAttachments()[1].getContentId());
    }

    #! returns the content of a message that a round trip must keep; the MIME headers are generated again
    private static hash<auto> getContent(Message msg) {
        hash<auto> rv = {
            "from": msg.getFrom(),
            "sender": msg.getSender(),
            "to": msg.getTO(),
            "cc": msg.getCC(),
            "subject": msg.getSubject(),
            "body": msg.getBody(),
            "body_encoding": msg.getBodyTransferEncoding(),
            "important": msg.important(),
            "headers": {},
            "attachments": (),
            "parts": (),
        };
        foreach hash<auto> i in (msg.getHeaders().pairIterator()) {
            if (!inlist(i.key.lwr(), ("mime-version", "content-type", "content-transfer-encoding"))) {
                rv.headers{i.key} = i.value;
            }
        }
        foreach Attachment att in (msg.getAttachments()) {
            rv.attachments += {
                "name": att.getName(),
                "mime": att.getMime(),
                "data": att.getData(),
                "inline": att.isInline(),
                "content_id": att.getContentId(),
            };
        }
        foreach Part part in (msg.getParts()) {
            rv.parts += {"mime": part.getMime(), "data": part.getData()};
        }
        return rv;
    }

    #! returns the number of headers with the given name in a header block
    private static int countHeaders(string hdrs, string name) {
        string prefix = name.lwr() + ":";
        return (select hdrs.split("\r\n"), $1.lwr().substr(0, prefix.size()) == prefix).size();
    }

    #! parses a message, serializes and parses it again, and checks that the content is kept; returns the message
    private Message checkRoundTrip(string raw, string name) {
        Message m1(raw);
        string s1 = m1.serializeRaw();
        Message m2(s1);
        assertEq(getContent(m1), getContent(m2), name + ": parse -> serialize -> parse");
        # the second serialization is the same as the first, except for generated multipart boundaries
        string s2 = m2.serializeRaw();
        assertEq(stripBoundaries(s1), stripBoundaries(s2), name + ": serialized again");
        # no MIME header is written twice
        string hdrs = s1.substr(0, s1.find("\r\n\r\n"));
        foreach string h in (("MIME-Version", "Content-Type", "Content-Transfer-Encoding")) {
            assertTrue(countHeaders(hdrs, h) <= 1, name + ": one " + h + " header");
        }
        return m1;
    }

    #! replaces the multipart boundaries in a serialized message
    private static string stripBoundaries(string str) {
        int i = 0;
        foreach string b in (str =~ x/boundary="?([^";\r]+)"?/g) {
            str = replace(str, b, sprintf("BOUNDARY-%d", i++));
        }
        return str;
    }

    testParsedRoundTrip() {
        # a message with a quoted-printable body, as received
        string raw = "From: Sender Name <sender@example.com>\r\nTo: to@example.com\r\nSubject: test\r\n"
            "Date: Mon, 19 Oct 2026 10:00:00 +0200\r\nMessage-ID: <id1@example.com>\r\nMIME-Version: 1.0\r\n"
            "Content-Type: text/plain; charset=UTF-8\r\nContent-Transfer-Encoding: quoted-printable\r\n\r\n"
            "caf=C3=A9 =\r\nline\r\n.dot\r\n";
        Message msg = checkRoundTrip(raw, "quoted-printable");
        # the quoted-printable decoder gives the body Unix line breaks on Unix
        assertEq("café line\n.dot\n", replace(msg.getBody(), "\r\n", "\n"));
        assertEq(ContentEncoding::QuotedPrintable, msg.getBodyTransferEncoding());
        assertEq("Mon, 19 Oct 2026 10:00:00 +0200", msg.getHeaders().Date);

        # a message with a 7bit body and no MIME headers: written as it is
        raw = "From: sender@example.com\r\nTo: to@example.com\r\nSubject: plain\r\n\r\nline 1\r\nline 2\r\n";
        msg = checkRoundTrip(raw, "plain");
        assertEq(raw, msg.serializeRaw());

        # a 7bit MIME message: written as it is, with its MIME headers
        raw = "From: sender@example.com\r\nTo: to@example.com\r\nSubject: mime\r\nMIME-Version: 1.0\r\n"
            "Content-Type: text/html; charset=UTF-8\r\nContent-Transfer-Encoding: 7bit\r\n\r\n<p>hi</p>\r\n";
        msg = checkRoundTrip(raw, "7bit");
        assertEq(raw, msg.serializeRaw());

        # a message created to be sent, with attachments, including a text attachment that is not base64
        Message out(Sender, Subject);
        out.addTO(To);
        out.setBody("body text\r\n", ContentEncoding::QuotedPrintable, "text/plain");
        out.attach("a.txt", MimeTypeText, "attachment 1\r\n", ContentEncoding::QuotedPrintable,
            {"X-Tag": "t1"});
        out.attach("b.bin", MimeTypeOctetStream, <00010203>);
        out.attachInline("logo.png", MimeTypePng, <89504e47>, "logo1");
        msg = checkRoundTrip(out.serializeRaw(), "attachments");
        assertEq("body text\n", replace(msg.getBody(), "\r\n", "\n"));
        assertEq(("a.txt", "b.bin", "logo.png"), map $1.getName(), msg.getAttachments());
        assertEq("t1", msg.getAttachments()[0].getHeaders()."x-tag");
        # no preamble is taken as the body or as a part
        assertEq((), msg.getParts());

        # a received multipart/alternative message in multipart/mixed, with 7bit and 8bit parts and a part with no
        # Content-Type, which is text/plain
        raw = "From: Sender <sender@example.com>\r\nTo: to@example.com\r\nSubject: alternative\r\n"
            "MIME-Version: 1.0\r\nContent-Type: multipart/mixed; boundary=\"outer\"\r\n\r\n"
            "This is a multi-part message in MIME format.\r\n--outer\r\n"
            "Content-Type: multipart/alternative; boundary=\"inner\"\r\n\r\n"
            "--inner\r\nContent-Transfer-Encoding: 7bit\r\n\r\nplain text\r\n"
            "--inner\r\nContent-Type: text/html; charset=UTF-8\r\nContent-Transfer-Encoding: 8bit\r\n\r\n"
            "<p>café</p>\r\n--inner--\r\n"
            "--outer\r\nContent-Type: text/plain; name=\"notes.txt\"\r\nContent-Disposition: attachment; "
            "filename=\"notes.txt\"\r\nContent-Transfer-Encoding: 7bit\r\n\r\nnotes\r\n--outer--\r\n";
        msg = checkRoundTrip(raw, "alternative");
        assertEq("plain text", msg.getBody());
        assertEq(1, msg.getParts().size());
        assertEq("text/html", msg.getParts()[0].getMime());
        assertEq("<p>café</p>", msg.getParts()[0].getData());
        assertEq("notes.txt", msg.getAttachments()[0].getName());
        assertEq("notes", msg.getAttachments()[0].getData());

        # an alternative message without attachments
        raw = "From: sender@example.com\r\nTo: to@example.com\r\nSubject: alt\r\nMIME-Version: 1.0\r\n"
            "Content-Type: multipart/alternative; boundary=b1\r\n\r\n--b1\r\n"
            "Content-Type: text/plain; charset=UTF-8\r\n\r\nplain\r\n--b1\r\n"
            "Content-Type: text/html; charset=UTF-8\r\nContent-Transfer-Encoding: quoted-printable\r\n\r\n"
            "<b>html=3D</b>\r\n--b1--\r\n";
        msg = checkRoundTrip(raw, "alternative only");
        assertEq("plain", msg.getBody());
        assertEq("<b>html=</b>", msg.getParts()[0].getData());
    }

    testReadReceipt() {
        string raw = "From: sender@example.com\r\nTo: to@example.com\r\nSubject: receipt\r\n"
            "Disposition-Notification-To: sender@example.com\r\nX-Other: 1\r\n\r\nbody\r\n";
        Message msg(raw);
        # receiptDelivery() is the Disposition-Notification-To setting
        assertTrue(msg.receiptDelivery());
        # the header is a setting of the message, not one of its other headers
        assertEq({"X-Other": "1"}, msg.getHeaders());
        assertRegex("\r\nDisposition-Notification-To: sender@example.com\r\n", msg.serializeRaw());
    }

    testEncoding() {
        string body = convert_encoding("café\r\n.dot\r\n", "ISO-8859-1");
        # a body written as it is keeps the bytes of its encoding
        Message msg(Sender, Subject);
        msg.addTO(To);
        msg.setBody(body, ContentEncoding::None);
        msg.addHeader({"Content-Type": "text/plain; charset=ISO-8859-1"});
        string ser = msg.serializeRaw();
        assertEq("ISO-8859-1", get_encoding(ser));
        assertTrue(binary(ser).find(<e9>) >= 0, "the body is in ISO-8859-1");
        assertEq(-1, binary(ser).find(<c3a9>), "the body is not in UTF-8");
        # SMTP transparency keeps the bytes as well
        string data = msg.serialize();
        assertTrue(binary(data).find(binary(convert_encoding("café\r\n..dot\r\n", "ISO-8859-1"))) >= 0);
        assertEq(-1, binary(data).find(<c3a9>));
        string smtp = Message::encodeSmtpData(ser);
        assertEq(binary(data), binary(smtp));

        # a quoted-printable body is encoded from its bytes, and its charset is declared
        msg = new Message(Sender, Subject);
        msg.addTO(To);
        msg.setBody(body, ContentEncoding::QuotedPrintable, "text/plain");
        ser = msg.serializeRaw();
        assertRegex("Content-Type: text/plain; charset=ISO-8859-1\r\n", ser);
        assertRegex("caf=E9", ser);

        # in a multipart message, the inline body is written as it is with its charset
        msg = new Message(Sender, Subject);
        msg.addTO(To);
        msg.setBody(body, ContentEncoding::None, "text/plain");
        msg.attach("a.bin", MimeTypeOctetStream, <00>);
        ser = msg.serializeRaw();
        assertTrue(binary(ser).find(<e9>) >= 0);
        assertEq(-1, binary(ser).find(<c3a9>));
        assertRegex("charset=ISO-8859-1", ser);
        Message parsed(ser);
        assertEq(convert_encoding(body, "UTF-8"), convert_encoding(parsed.getBody(), "UTF-8"));
    }

    #! returns the From header line of a message created to be sent with the given sender
    private static string getFromHeader(string sender, bool encode = True) {
        Message msg(sender, Subject);
        msg.addTO(To);
        msg.setBody("body");
        return getFromLine(msg.getHeaderString("\r\n", encode));
    }

    #! returns the From header line, with its folded lines, from a header string
    private static string getFromLine(string hdr) {
        return (hdr =~ x/^(From: .*?\r\n)(?![ \t])/s)[0] ?? "";
    }

    # issue #6019: the sender's display name is written in the From header; the address is the envelope sender
    testSenderDisplayName() {
        # a display name in ASCII
        string sender = "Qorus Cloud <notifications@mail.qorus.cloud>";
        Message msg(sender, Subject);
        assertEq("notifications@mail.qorus.cloud", msg.getFrom());
        assertEq(sender, msg.getSender());
        assertEq("notifications@mail.qorus.cloud", msg.getInfo().sender);
        assertEq(sender, msg.getInfo().from);
        assertEq("From: Qorus Cloud <notifications@mail.qorus.cloud>\r\n", getFromHeader(sender));
        assertEq("From: Qorus Cloud <notifications@mail.qorus.cloud>\r\n", getFromHeader(sender, False));
        # extra white space is not kept
        assertEq("From: Qorus Cloud <notifications@mail.qorus.cloud>\r\n",
            getFromHeader("  Qorus Cloud   <notifications@mail.qorus.cloud>  "));
        # an encoded word given as the name is written as it is
        assertEq("From: =?UTF-8?Q?J=C3=B6rg?= <j@example.com>\r\n", getFromHeader("=?UTF-8?Q?J=C3=B6rg?= <j@example.com>"));

        # a display name that is not ASCII is an RFC 2047 encoded word; the address is not encoded
        sender = "Jörg Müller <j@example.com>";
        msg = new Message(sender, Subject);
        assertEq("j@example.com", msg.getFrom());
        assertEq(sender, msg.getSender());
        assertEq("From: " + mime_encode_header_word_b("Jörg Müller") + " <j@example.com>\r\n", getFromHeader(sender));
        # not encoded
        assertEq("From: Jörg Müller <j@example.com>\r\n", getFromHeader(sender, False));
        # with specials, the name is encoded as it is, without quotes
        assertEq("From: " + mime_encode_header_word_b("Müller, Jörg") + " <j@example.com>\r\n",
            getFromHeader("Müller, Jörg <j@example.com>"));
        assertEq("From: " + mime_encode_header_word_b("Müller, Jörg") + " <j@example.com>\r\n",
            getFromHeader("\"Müller, Jörg\" <j@example.com>"));
        assertEq("\"Müller, Jörg\" <j@example.com>", (new Message("Müller, Jörg <j@example.com>", Subject)).getSender());

        # a display name with specials is a quoted string (RFC 5322)
        assertEq("From: \"Doe, John\" <john@example.com>\r\n", getFromHeader("Doe, John <john@example.com>"));
        assertEq("From: \"Doe, John\" <john@example.com>\r\n", getFromHeader("\"Doe, John\" <john@example.com>"));
        assertEq("From: \"John Q. Public\" <john@example.com>\r\n", getFromHeader("John Q. Public <john@example.com>"));
        assertEq("From: \"Say \\\"Hi\\\" \\\\ bye\" <a@example.com>\r\n",
            getFromHeader("\"Say \\\"Hi\\\" \\\\ bye\" <a@example.com>"));
        # a quoted word in a name is a word of the name
        assertEq("From: Say Hi <a@example.com>\r\n", getFromHeader("Say \"Hi\" <a@example.com>"));
        assertEq("\"Doe, John\" <john@example.com>", (new Message("Doe, John <john@example.com>", Subject)).getSender());
        # a quoted name without specials is written without quotes
        assertEq("From: John Doe <john@example.com>\r\n", getFromHeader("\"John Doe\" <john@example.com>"));

        # a bare address, and an address in angle brackets alone, are written as the address
        assertEq("From: foo@bar.cz\r\n", getFromHeader("foo@bar.cz"));
        assertEq("foo@bar.cz", (new Message("foo@bar.cz", Subject)).getSender());
        assertEq("From: foo@bar.cz\r\n", getFromHeader("<foo@bar.cz>"));
        assertEq("From: foo@bar.cz\r\n", getFromHeader("\"\" <foo@bar.cz>"));
        msg = new Message("<foo@bar.cz>", Subject);
        assertEq("foo@bar.cz", msg.getSender());
        assertEq("foo@bar.cz", msg.getFrom());

        # white space in a name is collapsed, and a name of white space alone is no name
        foreach hash<auto> i in ({"in": "\"\" \"\" <j@x.com>", "out": "j@x.com"},
                {"in": "\"  \" <j@x.com>", "out": "j@x.com"},
                {"in": "\"  John  \" <j@x.com>", "out": "John <j@x.com>"},
                {"in": "\"John \t\r\n  Doe\" <j@x.com>", "out": "John Doe <j@x.com>"},
                {"in": "\"  Jörg  \" <j@x.com>", "out": "Jörg <j@x.com>"}) {
            msg = new Message(i."in", Subject);
            assertEq(i.out, msg.getSender(), i."in");
            assertEq("j@x.com", msg.getFrom(), i."in");
            # serialized, parsed and serialized again, the sender and the message are the same
            msg.addTO(To);
            msg.setBody("body");
            string ser = msg.serializeRaw();
            Message parsed(ser);
            assertEq(msg.getSender(), parsed.getSender(), i."in");
            assertEq(msg.getSender(), (new Message(parsed.serializeRaw())).getSender(), i."in");
            # a parsed From header is written again as it was parsed, with its encoded words (issue #6066)
            assertEq(ser, parsed.serializeRaw(), i."in");
        }

        # a line break in the name cannot end the header line: it is white space, in or outside quotes
        foreach string s in ("A\r\nBcc: victim@example.com <a@example.com>",
                "\"A\r\nBcc: victim@example.com\" <a@example.com>") {
            msg = new Message(s, Subject);
            assertEq("a@example.com", msg.getFrom());
            assertEq("\"A Bcc: victim@example.com\" <a@example.com>", msg.getSender());
            assertEq("From: \"A Bcc: victim@example.com\" <a@example.com>\r\n", getFromHeader(s));
            assertEq("From: \"A Bcc: victim@example.com\" <a@example.com>\r\n", getFromHeader(s, False));
        }

        # a display name of quoted strings and words is one name
        assertEq("\"John Q. Public\" <j@x.com>", (new Message("\"John Q.\" Public <j@x.com>", Subject)).getSender());
        assertEq("a b <j@x.com>", (new Message("\"a\" \"b\" <j@x.com>", Subject)).getSender());
        # text before the address that is not a display name (a list of mailboxes) is not taken as the name
        msg = new Message("John <j@x.com>, Other <o@x.com>", Subject);
        assertEq("o@x.com", msg.getFrom());
        assertEq("o@x.com", msg.getSender());
        assertEq("o@x.com", (new Message("j@x.com (no name), Other <o@x.com>", Subject)).getSender());
        assertEq("o@x.com", (new Message("j@x.com, Other <o@x.com>", Subject)).getSender());
        assertEq("o@x.com", (new Message("\"unterminated <o@x.com>", Subject)).getSender());
        # a name with a comma and no address before the address is a name, as in the module's example
        assertEq("\"Me, Myself, and I\" <me@email.com>", (new Message("Me, Myself, and I <me@email.com>", Subject)).getSender());
    }

    # issue #6019: the From header of a parsed message is written as it was parsed
    testParsedFromHeader() {
        foreach string from in ("John <j@x.com>, Other <o@x.com>", "j@x.com (no name), Other <o@x.com>",
                "\"John Q.\" Public <j@x.com>", "\"a\" \"b\" <j@x.com>", "\"Doe, John\" <j@x.com>",
                "Qorus Cloud <notifications@mail.qorus.cloud>", "<j@x.com>", "j@x.com") {
            Message parsed(sprintf("From: %s\r\nTo: to@example.com\r\nSubject: s\r\n\r\nbody\r\n", from));
            assertEq(from, parsed.getSender(), from);
            assertEq("From: " + from + "\r\n", getFromLine(parsed.getHeaderString()), from);
            Message reparsed(parsed.serializeRaw());
            assertEq(from, reparsed.getSender(), from);
            assertEq(parsed.getFrom(), reparsed.getFrom(), from);
        }
        # a list of mailboxes with non-ASCII names
        {
            string from = sprintf("%s <j@x.com>, %s <m@x.com>", mime_encode_header_word_b("Jörg"),
                mime_encode_header_word_b("Müller, Jörg"));
            Message parsed(sprintf("From: %s\r\nTo: to@example.com\r\nSubject: s\r\n\r\nbody\r\n", from));
            string decoded = "Jörg <j@x.com>, Müller, Jörg <m@x.com>";
            assertEq(decoded, parsed.getSender());
            # written as it was parsed, so that the comma in the encoded name does not separate mailboxes (#6066)
            assertEq("From: " + from + "\r\n", getFromLine(parsed.getHeaderString()));
            Message reparsed(parsed.serializeRaw());
            assertEq(decoded, reparsed.getSender());
            assertEq("m@x.com", reparsed.getFrom());
        }

        # the receipt headers have the display name too
        Message msg("Qorus Cloud <notifications@mail.qorus.cloud>", Subject);
        msg.addTO(To);
        msg.setBody("body");
        msg.receiptRead(True);
        msg.receiptDelivery(True);
        string hdr = msg.getHeaderString();
        assertRegex("\r\nReturn-Receipt-To: Qorus Cloud <notifications@mail\\.qorus\\.cloud>\r\n", hdr);
        assertRegex("\r\nDisposition-Notification-To: Qorus Cloud <notifications@mail\\.qorus\\.cloud>\r\n", hdr);

        # a serialized message is parsed with the display name, and a long encoded name is decoded again
        foreach string name in ("Qorus Cloud", "Jörg Müller", "Doe, John", strmul("Jörg Müller ", 10, 1)) {
            msg = new Message(sprintf("%s <j@example.com>", name), Subject);
            msg.addTO(To);
            msg.setBody("body");
            Message parsed(msg.serializeRaw());
            assertEq("j@example.com", parsed.getFrom(), name);
            assertEq(msg.getSender(), parsed.getSender(), name);
            # the From header of the parsed message is written as it was parsed, with its encoded words (#6066)
            string from_line = getFromLine(msg.getHeaderString());
            from_line =~ s/\r\n[ \t]+/ /g;
            assertEq(from_line, getFromLine(parsed.getHeaderString()), name);
            assertEq(msg.getSender(), (new Message(parsed.serializeRaw())).getSender(), name);
        }
    }
    #! returns the string with its folded lines unfolded, as a message is parsed
    private static string unfold(string str) {
        str =~ s/\r\n[ \t]+/ /g;
        return str;
    }

    #! returns the header lines with the given name, with their folded lines
    private static list<string> getHeaderLines(string hdr, string name) {
        list<string> l = (hdr =~ x/^([^ \t\r\n:]+: .*?\r\n)(?![ \t])/gms) ?? ();
        return cast<list<string>>(select l, $1.lwr().substr(0, name.size() + 2) == name.lwr() + ": ");
    }

    # issue #6066: email addresses are kept whole and can have non-ASCII characters
    testEmailAddresses() {
        # every atext character of RFC 5322 is part of the local part
        foreach string addr in ("J.O'B@x.com", "a+tag@x.com", "a=b@x.com", "x!#$%&'*+/=?^_`{|}~-y@x.com",
                "first.last@sub.example.com", "\"John Doe\"@x.com", "\"a\\\"b\"@x.com", "user@[192.0.2.1]",
                "jörg@müller.de", "用户@例子.广告", "a@b.com.") {
            assertEq(addr, Message::getEmailAddress(addr), addr);
            assertEq(addr, Message::getEmailAddress("Name <" + addr + ">"), addr);
            assertEq(addr, Message::getEmailAddress("\"Doe, John\" <" + addr + "> "), addr);
            assertTrue(Message::checkEmailAddress(addr), addr);
        }
        assertEq("J.O'B@x.com", Message::getEmailAddress("John <J.O'B@x.com>"));
        # the address alone, without the text before it
        assertEq("john@x.com", Message::getEmailAddress("John Doe john@x.com"));
        assertEq("j@x.com", Message::getEmailAddress("j@x.com (John)"));
        assertEq("j@x.com", Message::getEmailAddress("j@x.com, other@x.com"));
        # an address with a control character is not an address
        assertNothing(Message::getEmailAddress("<j\x01@x.com>"));
        assertEq("j@x.com", Message::getEmailAddress("j@x.com\r\nBcc: v@x.com"));
        assertNothing(Message::getEmailAddress("\"a\r\nb\"@x.com"));
        # an address in an encoded word is not an address
        assertNothing(Message::getEmailAddress("=?UTF-8?Q?=3Cj@x.com=3E?="));
        assertNothing(Message::getEmailAddress("=?UTF-8?Q?j@x.com?="));
        # text with a character that an encoded word cannot have (RFC 2047 section 5) is not an encoded word, and
        # is read as RFC 5322 reads it (issue #6134)
        assertEq("j@x.com", Message::getEmailAddress("=?utf-8?q?x_<j@x.com>?="));
        assertEq("=?UTF-8?Q?j@x.com_", Message::getEmailAddress("=?UTF-8?Q?j@x.com_(J=C3=B6rg)?="));
        assertEq("b@x.com", Message::getEmailAddress("=?UTF-8?Q?a,b@x.com?="));
        assertNothing(Message::getEmailAddress("=?utf-8?q?x_=3Cj@x.com=3E?="));
        assertEq("a@x.com", Message::getEmailAddress("=?UTF-8?Q?x_<j@x.com>?= <a@x.com>"));
        assertEq("a@x.com", Message::getEmailAddress("=?UTF-8?Q?j@x.com_?= a@x.com"));
        assertNothing(Message::getEmailAddress("no address"));

        # an address in quotes, brackets or braces (ex: CSV data), or followed by a URL query or path
        foreach string str in ("'j@x.com'", "\"j@x.com\"", "[j@x.com]", "{j@x.com}", " \"j@x.com\" ", "j@x.com/",
                "j@x.com?subject=hi", "<mailto:j@x.com>", "mailto:j@x.com", "John [j@x.com]", "\"John\" j@x.com",
                "name: j@x.com;", "(c) j@x.com", "j@x.com#x", "j@x.com&y") {
            assertEq("j@x.com", Message::getEmailAddress(str), str);
        }
        # text that is not an address
        foreach string str in ("abc@def@ghi.com", "j @x.com", "a@@b.com", "@x.com", "j@") {
            assertNothing(Message::getEmailAddress(str), str);
        }

        # Unicode white space and control and format characters are not part of an address, and are trimmed
        foreach string sp in ("\u00a0", "\u2028", "\u2029", "\u0085", "\u3000") {
            assertEq("a@x.com", Message::getEmailAddress("a@x.com" + sp), sprintf("%y", sp));
            assertEq("a@x.com", Message::getEmailAddress(sp + "a@x.com"), sprintf("%y", sp));
            assertEq("a@x.com", Message::getEmailAddress("Ann <a@x.com" + sp + ">"), sprintf("%y", sp));
            assertEq("b@x.com", Message::getEmailAddress("a" + sp + "b@x.com"), sprintf("%y", sp));
            # as with an ASCII space
            assertEq("b@x.com", Message::getEmailAddress("<a" + sp + "b@x.com>"), sprintf("%y", sp));
            assertFalse(Message::checkEmailAddress("<a" + sp + "@x.com>"), sprintf("%y", sp));
        }
        foreach string ch in ("\x01", "\x7f", "\u0080", "\u009f", "\u00ad", "\u200b", "\u200e") {
            assertFalse(Message::checkEmailAddress("a" + ch + "b@x.com" + ch), sprintf("%y", ch));
        }

        # the recipients and the sender are the whole addresses
        Message msg("Jörg <jörg@müller.de>", Subject);
        assertEq("jörg@müller.de", msg.getFrom());
        assertEq("Jörg <jörg@müller.de>", msg.getSender());
        msg.addTO("John <J.O'B@x.com>");
        msg.addCC("a+tag@x.com");
        msg.addBCC("\"Doe, Jane\" <\"jane doe\"@x.com>");
        assertEq(("J.O'B@x.com", "a+tag@x.com", "\"jane doe\"@x.com"), msg.getRecipients());
        assertEq(("John <J.O'B@x.com>",), msg.getTO());
    }

    # issue #6066: only the display names of the To, CC and BCC headers are encoded, never the addresses
    testAddressHeaders() {
        Message msg(Sender, Subject);
        msg.addTO("Jöhn <j@x.com>");
        msg.addTO("Jöhn <j@x.com>, \"Doe, Jörg\" <d@x.com>, plain@x.com, Ann <a@x.com>");
        msg.addCC("\"Doe, Jörg\" <d@x.com>");
        msg.addCC("Doe, Jörg <d@x.com>");
        msg.addBCC("Müller <m@x.com>");
        # an ASCII name with an internationalized address; the address is never encoded
        msg.addTO("John <jörg@müller.de>");
        msg.addTO("jörg@müller.de");
        msg.setBody("body");
        string hdr = msg.getHeaderString();
        string jb = mime_encode_header_word_b("Jöhn");
        string db = mime_encode_header_word_b("Doe, Jörg");
        assertEq((
            sprintf("To: %s <j@x.com>\r\n", jb),
            sprintf("To: %s <j@x.com>, %s <d@x.com>,\r\n plain@x.com, Ann <a@x.com>\r\n", jb, db),
            "To: John <jörg@müller.de>\r\n",
            "To: jörg@müller.de\r\n",
        ), getHeaderLines(hdr, "To"));
        assertEq((sprintf("CC: %s <d@x.com>\r\n", db), sprintf("CC: %s <d@x.com>\r\n", db)),
            getHeaderLines(hdr, "CC"));
        assertEq((sprintf("BCC: %s <m@x.com>\r\n", mime_encode_header_word_b("Müller")),), getHeaderLines(hdr, "BCC"));

        # the message is parsed with the same recipients
        Message parsed(msg.serializeRaw());
        assertEq(("Jöhn <j@x.com>", "Jöhn <j@x.com>, Doe, Jörg <d@x.com>, plain@x.com, Ann <a@x.com>",
            "John <jörg@müller.de>", "jörg@müller.de"), parsed.getTO());
        assertEq(("Doe, Jörg <d@x.com>", "Doe, Jörg <d@x.com>"), parsed.getCC());
        assertEq(msg.getRecipients(), parsed.getRecipients());
        # every address of an entry, once (issue #6134)
        assertEq(("j@x.com", "d@x.com", "plain@x.com", "a@x.com", "jörg@müller.de", "m@x.com"),
            parsed.getRecipients());
        # and written again as it was parsed (a folded header is parsed as one line)
        assertEq(unfold(msg.serializeRaw()), parsed.serializeRaw());

        # a value that is not a list of mailboxes has only its text encoded, not its address
        msg = new Message(Sender, Subject);
        msg.addTO("Jöhn j@x.com");
        msg.setBody("body");
        assertEq((sprintf("To: %s j@x.com\r\n", mime_encode_header_word_b("Jöhn")),),
            getHeaderLines(msg.getHeaderString(), "To"));

        # a line break in a display name or after an address cannot end the header line
        foreach string rcpt in ("Jöhn\r\nBcc: victim@x.com <j@x.com>", "\"Jöhn\r\nBcc: victim@x.com\" <j@x.com>",
                "j@x.com\r\nBcc: victim@x.com", "Jöhn <j@x.com>\r\nBcc: victim@x.com",
                "Jöhn <j@x.com>, \"a\r\nBcc: victim@x.com\" <a@x.com>") {
            msg = new Message(Sender, Subject);
            msg.addTO(rcpt);
            msg.setBody("body");
            hdr = msg.getHeaderString();
            assertNRegex("\r\nBcc:", hdr, rcpt);
            assertEq(1, getHeaderLines(hdr, "To").size(), rcpt);
            assertNRegex("victim", msg.getRecipients().join(","), rcpt);
            assertThrows("HEADER-ERROR", \msg.getHeaderString(), ("\r\n", False), rcpt);
        }
    }

    # issue #6066: the addresses of a parsed message are taken from the raw headers, and its address headers are
    # written again as they were parsed, or with only the display names encoded
    testParsedAddresses() {
        # an address in an encoded word is not the sender or a recipient
        string raw = "From: evil@y.com =?UTF-8?Q?=3Cj@x.com=3E?=\r\n"
            "To: other@y.com =?UTF-8?Q?=3Ct@x.com=3E?=\r\n"
            "CC: =?UTF-8?Q?c@x.com?=\r\n"
            "Subject: s\r\n\r\nbody\r\n";
        Message parsed(raw);
        assertEq("evil@y.com", parsed.getFrom());
        assertEq("evil@y.com <j@x.com>", parsed.getSender());
        assertEq(("other@y.com",), parsed.getRecipients());
        assertEq(("other@y.com <t@x.com>",), parsed.getTO());
        assertEq(raw, parsed.serializeRaw());

        # a raw non-ASCII From and To are written with only the display names encoded
        raw = "From: Jöhn <j@x.com>\r\n"
            "To: Jöhn <j@x.com>, \"Müller, Jörg\" <m@x.com>, plain@x.com\r\n"
            "CC: =?UTF-8?Q?J=C3=B6rg?= Müller <jm@x.com>\r\n"
            "Subject: s\r\n\r\nbody\r\n";
        parsed = new Message(raw);
        assertEq("j@x.com", parsed.getFrom());
        # every address of a header with a list of mailboxes is a recipient (issue #6134)
        assertEq(("j@x.com", "m@x.com", "plain@x.com", "jm@x.com"), parsed.getRecipients());
        string hdr = parsed.getHeaderString();
        string jb = mime_encode_header_word_b("Jöhn");
        assertEq(sprintf("From: %s <j@x.com>\r\n", jb), getFromLine(hdr));
        assertEq((sprintf("To: %s <j@x.com>,\r\n %s <m@x.com>, plain@x.com\r\n", jb,
            mime_encode_header_word_b("Müller, Jörg")),), getHeaderLines(hdr, "To"));
        assertEq((sprintf("CC: %s <jm@x.com>\r\n", mime_encode_header_word_b("Jörg Müller")),),
            getHeaderLines(hdr, "CC"));
        Message reparsed(parsed.serializeRaw());
        assertEq(parsed.getSender(), reparsed.getSender());
        assertEq(parsed.getCC(), reparsed.getCC());
        assertEq(parsed.getRecipients(), reparsed.getRecipients());
        # the headers written with encoded display names are written again as they were parsed
        assertEq(unfold(parsed.getHeaderString()), reparsed.getHeaderString());

        # a recipient added to a parsed message
        parsed.addTO("Ann <a@x.com>");
        assertEq(("j@x.com", "m@x.com", "plain@x.com", "a@x.com", "jm@x.com"), parsed.getRecipients());
        assertEq("To: Ann <a@x.com>\r\n", getHeaderLines(parsed.getHeaderString(), "To")[1]);
    }

    # issue #6066: a message created with a recipient that is not a list of mailboxes (a mailbox with a comment, a
    # group, a display name without angle brackets) is written with its addresses as they are and only its other
    # text encoded, and it is parsed again with the same recipients
    testAddressRoundTrips() {
        foreach hash<auto> i in (
                {"in": "Jöhn j@x.com", "rcpt": "j@x.com"},
                {"in": "j@x.com (Jörg)", "rcpt": "j@x.com", "hdr": "To: j@x.com (" + mime_encode_header_word_b("Jörg")
                    + ")"},
                {"in": "jörg@müller.de (Jörg)", "rcpt": "jörg@müller.de"},
                {"in": "Jörg <j@x.com> (c)", "rcpt": "j@x.com"},
                {"in": "\"Jörg\" <j@x.com>", "rcpt": "j@x.com"},
                {"in": "Grüppe: a@x.com, b@x.com;", "rcpt": ("a@x.com", "b@x.com"), "hdr": "To: "
                    + mime_encode_header_word_b("Grüppe") + ": a@x.com, b@x.com;"},
                {"in": "Müller, Jörg <m@x.com>, Ann <a@x.com>", "rcpt": ("m@x.com", "a@x.com")},
                {"in": "Jörg <j@x.com>, ,b@x.com", "rcpt": ("j@x.com", "b@x.com")},
                {"in": "Jörg <j@x.com>,", "rcpt": "j@x.com"},
                {"in": "(a,b) Jörg <j@x.com>", "rcpt": "j@x.com"},
                {"in": "Jörg <j@[192.0.2.1]>", "rcpt": "j@[192.0.2.1]"},
                {"in": "\"a,b\" <a@x.com>, Jö <c@x.com>", "rcpt": ("a@x.com", "c@x.com")},
                {"in": "Jö <a@x.com>, \"unterminated <b@x.com>", "rcpt": ("a@x.com", "b@x.com")},
                {"in": "Jö (x <a@x.com>", "rcpt": "a@x.com"},
                {"in": "Jö <a@x.com>, plain@x.com, (c) Ann <a2@x.com>",
                    "rcpt": ("a@x.com", "plain@x.com", "a2@x.com")},
                {"in": "Jö =?UTF-8?Q?x?= <a@x.com>", "rcpt": "a@x.com"},
                {"in": "\"=?UTF-8?Q?=3Cvictim@x.com=3E?=\" Jö <a@x.com>", "rcpt": "a@x.com"},
                {"in": "Jö \"jö rg\"@x.com", "rcpt": "\"jö rg\"@x.com"},
                {"in": "\"Jörg j@x.com\"", "rcpt": "j@x.com"},
                {"in": "Jö'j@x.com'", "rcpt": "Jö'j@x.com"},
                {"in": "Jö j@x.com/ö", "rcpt": "j@x.com"},
                {"in": "Jö\tj@x.com (c)", "rcpt": "j@x.com"},
            ) {
            Message msg(Sender, Subject);
            msg.addTO(i."in");
            msg.setBody("body");
            list<string> rcpts = i.rcpt.typeCode() == NT_LIST ? i.rcpt : (i.rcpt,);
            assertEq(rcpts, msg.getRecipients(), i."in");
            string hdr = msg.getHeaderString();
            list<string> to = getHeaderLines(hdr, "To");
            assertEq(1, to.size(), i."in");
            # only printable ASCII text and the addresses are written
            string text = to[0];
            map text = replace(text, $1, ""), rcpts;
            assertTrue(text.substr(0, -2).isDataPrintableAscii(), i."in");
            if (i.hdr) {
                assertEq(i.hdr + "\r\n", to[0], i."in");
            }
            string ser = msg.serializeRaw();
            Message parsed(ser);
            assertEq(msg.getRecipients(), parsed.getRecipients(), i."in");
            Message reparsed(parsed.serializeRaw());
            assertEq(msg.getRecipients(), reparsed.getRecipients(), i."in");
            assertEq(parsed.serializeRaw(), reparsed.serializeRaw(), i."in");
        }
    }

    # issue #6066: a header is written the same way after it is parsed and written again, any number of times
    testStableRoundTrips() {
        foreach string rcpt in (
                "jörg@müller.de (Jörg Müller-Lüdenscheidt Ölmühlenbesitzer Großherzöglicher Hoflieferant)",
                "Jörg Müller-Lüdenscheidt Ölmühlenbesitzer Großherzöglicher Hoflieferant Fürstenzell j@x.com",
                "(" + strmul("Größenwahn ", 12, 1) + ") j@x.com",
                "Grüppe Ölmühlenbesitzer Großherzöglicher Hoflieferant Fürstenzell: a@x.com, b@x.com;",
                "Jörg <j@x.com> (Kommentar mit Ölmühlenbesitzer Großherzöglicher Hoflieferant Fürstenzell)") {
            Message msg(Sender, Subject);
            msg.addTO(rcpt);
            msg.setBody("body");
            Message parsed(msg.serializeRaw());
            string ser = parsed.serializeRaw();
            for (int i = 0; i < 4; ++i) {
                Message reparsed(ser);
                assertEq(ser, reparsed.serializeRaw(), sprintf("%y round %d", rcpt, i));
                assertEq(parsed.getTO(), reparsed.getTO(), rcpt);
                ser = reparsed.serializeRaw();
            }
            # the text of the header is the text given
            assertEq((rcpt,), parsed.getTO());
        }
    }

    # issue #6066: the text after an address with non-ASCII characters is kept, and lines are folded by their
    # length in characters
    testNonAsciiOffsets() {
        foreach hash<auto> i in ({"in": "Jörg jörg@müller.de&x", "rcpt": "jörg@müller.de"},
                {"in": "jörg@müller.de/Vertrieb (Jörg)", "rcpt": "jörg@müller.de"}) {
            Message msg(Sender, Subject);
            msg.addTO(i."in");
            msg.setBody("body");
            assertEq((i.rcpt,), msg.getRecipients(), i."in");
            Message parsed(msg.serializeRaw());
            assertEq((i."in",), parsed.getTO(), i."in");
            assertEq((i.rcpt,), parsed.getRecipients(), i."in");
        }

        # mailboxes of 32 characters and more bytes: two fit on a line of 76 characters
        list<string> l = map sprintf("Ann <ännchen.müller.%02d@münchen.de>", $1), xrange(1, 10);
        Message msg(Sender, Subject);
        msg.addTO(l.join(", "));
        msg.setBody("body");
        list<string> lines = getHeaderLines(msg.getHeaderString(), "To")[0].substr(0, -2).split("\r\n");
        assertEq(5, lines.size());
        foreach string line in (lines) {
            assertLe(78, line.length(), line);
        }
        assertEq("To: " + l[0] + ", " + l[1] + ",", lines[0]);
    }

    # issue #6066: format characters (ex: a byte order mark) around an address are not part of it, and an address
    # in a comment is not the address of a mailbox
    testFormatCharsAndComments() {
        foreach string str in ("\ufeffjohn@x.com", "John <john@x.com>\ufeff", "john@x.com\u00ad",
                "John\u200b <john@x.com>", "<john@x.com\u200b>", "John <john@x.com>\u200e",
                "\u202ajohn@x.com\u202c", "John <john@x.com> \u200b",
                "john@x.com!", "john@x.com*", "john@x.com|k@x.com", "john@x.com\\", "x \ufeffjohn@x.com\ufeff y") {
            assertEq("john@x.com", Message::getEmailAddress(str), sprintf("%y", str));
        }
        # not in an address
        assertNothing(Message::getEmailAddress("jo\u200bhn@x.com"));
        assertNothing(Message::getEmailAddress("john@x\ufeff.com"));
        assertNothing(Message::getEmailAddress("<jo\u200bhn@x.com>"));

        foreach string str in ("(Jörg v@evil.com) a@x.com", "(v@evil.com) a@x.com", "(a (v@evil.com) b) a@x.com",
                "(a \\) v@evil.com) a@x.com", "\"(\" a@x.com", "a@x.com (v@evil.com)") {
            assertEq("a@x.com", Message::getEmailAddress(str), str);
            Message msg(Sender, Subject);
            msg.addTO(str);
            msg.setBody("body");
            assertEq(("a@x.com",), msg.getRecipients(), str);
            Message parsed(msg.serializeRaw());
            assertEq(("a@x.com",), parsed.getRecipients(), str);
        }
        # a format character before an address in a header with non-ASCII text is kept as text
        Message msg(Sender, Subject);
        msg.addTO("Jö \ufeffj@x.com");
        msg.setBody("body");
        Message parsed(msg.serializeRaw());
        assertEq(("j@x.com",), parsed.getRecipients());
        # the encoded format character is separated from the address by a space
        assertEq(("Jö \ufeff j@x.com",), parsed.getTO());
    }

    # issue #6066: the format characters at the start and the end of a display name are kept (ex: directional
    # formatting characters, which must stay balanced, or a soft hyphen); they are trimmed for the address only
    testDisplayNameFormatChars() {
        foreach string name in ("‫שלום‬", "­Jö", "Jö­", "‎Jörg Müller‏", "﻿Jö") {
            foreach string rcpt in (name + " <a@x.com>", name + " <a@x.com>, Ann <b@x.com>",
                    name + " <​a@x.com​>") {
                Message msg(Sender, Subject);
                msg.addTO(rcpt);
                msg.setBody("body");
                Message parsed(msg.serializeRaw());
                string to = parsed.getTO()[0];
                assertEq(name + " <a@x.com>", to.substr(0, name.length() + 10), sprintf("%y", rcpt));
                assertEq(msg.getRecipients(), parsed.getRecipients(), sprintf("%y", rcpt));
                # parsed and written again, the name is the same
                assertEq(parsed.getTO(), (new Message(parsed.serializeRaw())).getTO(), sprintf("%y", rcpt));
            }
        }
    }

    # issue #6066: an address in a quoted string is not the address of a mailbox when there is another address
    # after it, as a reader of the header sees it; a quoted local part is part of an address
    testQuotedStringAddresses() {
        foreach hash<auto> i in ({"in": "\"v@e.com\" a@x.com", "out": "a@x.com"},
                {"in": "\"v@e.com\" (w@e.com) a@x.com", "out": "a@x.com"},
                {"in": "\"Jörg v@e.com\" a@x.com", "out": "a@x.com"},
                {"in": "\"a\\\"v@e.com\" a@x.com", "out": "a@x.com"},
                {"in": "Jö \"x y\"@x.com", "out": "\"x y\"@x.com"},
                {"in": "\"x y\"@x.com, b@x.com", "out": "\"x y\"@x.com", "rcpt": ("\"x y\"@x.com", "b@x.com")},
                {"in": "\"v@e.com\" \"x y\"@x.com", "out": "\"x y\"@x.com"},
                # an address in a quoted string is found if there is no other, as before
                {"in": "\"Jörg j@x.com\"", "out": "j@x.com"},
                {"in": "foo \"j@x.com\" bar", "out": "j@x.com"},
                {"in": "\"j@x.com\"", "out": "j@x.com"},
                # an unterminated quoted string is text
                {"in": "\"v@e.com a@x.com", "out": "v@e.com"}) {
            assertEq(i.out, Message::getEmailAddress(i."in"), i."in");
            Message msg(Sender, Subject);
            msg.addTO(i."in");
            msg.setBody("body");
            assertEq(i.rcpt ?? (i.out,), msg.getRecipients(), i."in");
            Message parsed(msg.serializeRaw());
            assertEq(i.rcpt ?? (i.out,), parsed.getRecipients(), i."in");
            assertEq(i.rcpt ?? (i.out,), (new Message(parsed.serializeRaw())).getRecipients(), i."in");
        }
    }

    # issue #6066: a list of mailboxes is folded before a mailbox that would make the line longer than 76
    # characters
    testAddressFolding() {
        list<string> l = ();
        for (int i = 0; i < 40; ++i) {
            l += sprintf("Jörg Müller %d <joerg.mueller%d@example.com>", i, i);
        }
        foreach string eol in ("\r\n", "\n") {
            Message msg(Sender, Subject);
            msg.addTO(l.join(", "));
            msg.addCC("Jörg Müller <j@x.com>, " + (map sprintf("plain%d@x.com", $1), xrange(20)).join(", "));
            msg.setBody("body");
            string hdr = msg.getHeaderString(eol);
            foreach string line in (hdr.split(eol)) {
                assertLe(78, line.size(), line);
            }
            if (eol == "\n") {
                assertNRegex("\r", hdr);
            }
            Message parsed(msg.serializeRaw());
            assertEq(msg.getRecipients(), parsed.getRecipients());
            # the recipients are the same mailboxes
            assertEq(l.join(", "), parsed.getTO()[0]);
            assertEq(40, (parsed.getTO()[0] =~ x/(<joerg\.mueller[0-9]+@example\.com>)/g).size());
        }
    }

    # issue #6066: an address header is parsed and written in a time linear in its length
    testLongAddressHeaders() {
        foreach string prefix in ("a", "ö") {
            foreach string val in (prefix + "<" + strmul("\t", 20000) + ">x", prefix + "<" + strmul(" ", 20000) + "x<",
                    prefix + strmul("<a", 10000), prefix + strmul(" \"a", 10000), prefix + strmul("a,", 10000),
                    # unterminated domain literals
                    prefix + " " + strmul("a@[", 7000), prefix + strmul("a@[", 7000) + "]") {
                date start = now_us();
                Message parsed("From: a@x.com\r\nTo: " + val + "\r\nSubject: s\r\n\r\nbody\r\n");
                string hdr = parsed.getHeaderString();
                parsed.getRecipients();
                Message reparsed(parsed.serializeRaw());
                date elapsed = now_us() - start;
                # a quadratic time would take minutes
                assertLt(5s, elapsed, sprintf("%y...: %y", val.substr(0, 10), elapsed));
                assertEq(1, getHeaderLines(hdr, "To").size());
                assertEq(parsed.getRecipients(), reparsed.getRecipients());
            }
        }
        # a created message with unterminated domain literals
        {
            date start = now_us();
            Message msg(Sender, Subject);
            msg.addTO("b@x.com ö " + strmul("a@[", 7000));
            msg.setBody("body");
            Message parsed(msg.serializeRaw());
            assertEq(("b@x.com",), parsed.getRecipients());
            assertLt(5s, now_us() - start);
        }
        # several such headers
        string val = "a<" + strmul("\t", 20000) + ">x";
        date start = now_us();
        Message parsed("From: a@x.com\r\n" + strmul("To: " + val + "\r\n", 10) + "Subject: s\r\n\r\nbody\r\n");
        parsed.serializeRaw();
        assertLt(20s, now_us() - start);
    }

    # issue #6066: encoded words are folded with the line ending of the header, and a header value that is not
    # encoded cannot have control characters
    testHeaderEncoding() {
        string long = strmul("Jörg Müller ", 10, 1);
        int folds = (mime_encode_header_word_b(long) =~ x/(\r\n )/g).size();
        assertGt(0, folds);
        assertEq(folds, (mime_encode_header_word_b(long, "\n") =~ x/(\n )/g).size());
        assertNRegex("\r", mime_encode_header_word_b(long, "\n"));
        assertRegex("\\?=\n =\\?UTF-8\\?B\\?", mime_encode_header_word_b(long, "\n"));
        assertNRegex("\r", mime_encode_header_word_q(long, "\n"));
        assertRegex("\\?=\n =\\?UTF-8\\?Q\\?", mime_encode_header_word_q(long, "\n"));
        assertEq(long, mime_decode_header(mime_encode_header_word_q(long, "\n")));
        assertNRegex("\r", Message::doHeaderValue("Subject", long, "\n"));

        Message msg(long + " <j@x.com>", long);
        msg.addTO(long + " <t@x.com>");
        msg.addCC(long + " t@x.com");
        msg.setBody("body");
        string hdr = msg.getHeaderString("\n");
        assertNRegex("\r", hdr);
        # every line of the header string is folded with the line ending
        assertRegex("\n =\\?UTF-8\\?B\\?", hdr);
        assertRegex("\n =\\?UTF-8\\?Q\\?", hdr);
        hdr = msg.getHeaderString();
        assertEq(hdr.split("\r\n").size(), (hdr.split("\n")).size());

        # a value that is not encoded cannot have a control character other than horizontal tab
        foreach string c in ("\x01", "\x08", "\x0b", "\x0c", "\x1b", "\x7f") {
            assertThrows("HEADER-ERROR", "message header \"X-Test\" value .* contains a control character",
                \Message::doHeaderValue(), ("X-Test", "a" + c + "b", "\r\n", False), sprintf("%y", c));
            # an encoded value has the character encoded
            assertEq(Message::doHeaderValue("X-Test", "a" + c + "b"),
                sprintf("X-Test: %s\r\n", mime_encode_header_word_q("a" + c + "b")));
            assertNRegex(c, Message::doHeaderValue("X-Test", "a" + c + "b"));
        }
        assertEq("X-Test: a\tb\r\n", Message::doHeaderValue("X-Test", "a\tb", "\r\n", False));
        msg = new Message(Sender, "a\x01b");
        msg.addTO(To);
        msg.setBody("body");
        assertThrows("HEADER-ERROR", \msg.getHeaderString(), ("\r\n", False));
        assertNRegex("\x01", msg.getHeaderString());
    }

    # issue #6134: every address of a To, CC or BCC entry with several addresses is a recipient
    testListRecipients() {
        # value, recipients
        list<list<auto>> cases = (
            # plain addresses
            ("a@x.com, b@y.com", ("a@x.com", "b@y.com")),
            ("a@x.com,b@y.com,,c@z.com,", ("a@x.com", "b@y.com", "c@z.com")),
            # display names
            ("Ann <a@x.com>, Bob <b@y.com>", ("a@x.com", "b@y.com")),
            ("<a@x.com>, Bob b@y.com", ("a@x.com", "b@y.com")),
            # quoted names with commas, colons, semicolons and addresses
            ("\"Doe, John\" <j@x.com>, \"Roe; Jane: a@evil.com\" <r@y.com>", ("j@x.com", "r@y.com")),
            ("\"a\\\"b, c\" <j@x.com>, k@y.com", ("j@x.com", "k@y.com")),
            # an unquoted comma in a single display name
            ("Doe, John <j@x.com>", ("j@x.com",)),
            # comments
            ("a@x.com (Doe, John), b@y.com (c@evil.com, (nested, d@evil.com))", ("a@x.com", "b@y.com")),
            # a domain literal and a quoted local part
            ("a@[1.2.3.4], \"b,c\"@y.com", ("a@[1.2.3.4]", "\"b,c\"@y.com")),
            # groups, also an empty one
            ("Team: a@x.com, Bob <b@y.com>;, c@z.com", ("a@x.com", "b@y.com", "c@z.com")),
            ("undisclosed-recipients:;, a@x.com", ("a@x.com",)),
            ("A: a@x.com;B: b@y.com;", ("a@x.com", "b@y.com")),
            # a colon after an address is not the end of the name of a group
            ("a@x.com Re: b@y.com", ("a@x.com",)),
            ("Ann <a@x.com> Re: b@y.com, c@z.com", ("a@x.com", "c@z.com")),
            # non-ASCII names and addresses
            ("Jörg Müller <j@x.com>, \"Müller, Jörg\" <jörg@müller.de>, zoë@x.com", ("j@x.com", "jörg@müller.de",
                "zoë@x.com")),
            # duplicates: the domain is not case-sensitive, the local part is
            ("a@x.com, A <a@X.COM>, A@x.com", ("a@x.com", "A@x.com")),
            # an unterminated quoted string, comment or angle address does not hide the addresses after it
            ("\"Doe <j@x.com>, b@y.com", ("j@x.com", "b@y.com")),
            ("a@x.com (note, b@y.com", ("a@x.com", "b@y.com")),
            ("[ext a@x.com, b@y.com", ("a@x.com", "b@y.com")),
        );
        foreach list<auto> c in (cases) {
            string val = c[0];
            # created
            Message msg(Sender, Subject);
            msg.addTO(val);
            msg.setBody("body");
            assertEq(c[1], msg.getRecipients(), "created: " + val);
            # the header entry is not changed
            assertEq((val,), msg.getTO(), val);
            # parsed, and parsed again after it is serialized
            Message parsed(msg.serializeRaw());
            assertEq(c[1], parsed.getRecipients(), "parsed: " + val);
            Message reparsed(parsed.serializeRaw());
            assertEq(c[1], reparsed.getRecipients(), "reparsed: " + val);
        }

        # getEmailAddresses() returns the duplicates of an entry and an empty group has no address
        assertEq(("a@x.com", "a@X.COM", "A@x.com"), Message::getEmailAddresses("a@x.com, A <a@X.COM>, A@x.com"));
        assertEq((), Message::getEmailAddresses("undisclosed-recipients:;"));
        assertEq(("j@x.com",), Message::getEmailAddresses("=?UTF-8?Q?a@evil.com=2C?= <j@x.com>"));

        # an entry with no address cannot be added
        {
            Message msg(Sender, Subject);
            assertThrows("MESSAGE-ADDTO-ERROR", \msg.addTO(), "undisclosed-recipients:;");
        }

        # To, CC and BCC entries, with duplicates between them, in order
        {
            Message msg(Sender, Subject);
            msg.addTO("a@x.com, Bob <b@y.com>");
            msg.addTO("c@z.com");
            msg.addCC("B@Y.com, \"Doe, Dan\" <d@x.com>");
            msg.addBCC("Hidden: e@x.com, a@x.com;");
            msg.setBody("body");
            assertEq(("a@x.com", "b@y.com", "c@z.com", "B@Y.com", "d@x.com", "e@x.com"), msg.getRecipients());
            assertEq(("a@x.com, Bob <b@y.com>", "c@z.com"), msg.getTO());
            assertEq(("a@x.com, Bob <b@y.com>", "c@z.com"), msg.getInfo().to);
            assertEq(("B@Y.com, \"Doe, Dan\" <d@x.com>",), msg.getCC());
            # the header text is unchanged
            string hdr = msg.getHeaderString();
            assertEq(("To: a@x.com, Bob <b@y.com>\r\n", "To: c@z.com\r\n"), getHeaderLines(hdr, "To"));
            assertEq(("CC: B@Y.com, \"Doe, Dan\" <d@x.com>\r\n",), getHeaderLines(hdr, "CC"));
        }

        # parsed headers, with encoded words that cannot hide or add a separator or an address
        {
            string raw = "From: s@x.com\r\n"
                "To: a@x.com, =?UTF-8?Q?Doe=2C_John_evil@y.com=2C?= <j@x.com>, Team: b@y.com, c@z.com;\r\n"
                "CC: =?UTF-8?B?w4RubmE=?= <anna@x.com>,\r\n \"Müller, Jörg\" <jm@x.com>, undisclosed-recipients:;\r\n"
                "BCC: (c, d@evil.com) e@x.com, A@X.COM\r\n"
                "Subject: s\r\n\r\nbody\r\n";
            Message parsed(raw);
            assertEq(("a@x.com", "j@x.com", "b@y.com", "c@z.com", "anna@x.com", "jm@x.com", "e@x.com", "A@X.COM"),
                parsed.getRecipients());
            Message reparsed(parsed.serializeRaw());
            assertEq(parsed.getRecipients(), reparsed.getRecipients());
            assertEq(parsed.getTO(), reparsed.getTO());
        }
    }

    # issue #6134 review: the sender of a parsed or created message is the same after the message is written and
    # parsed again, and a sender header is never written as a group
    testSenderRoundTrips() {
        foreach string v in ("evil@e.com; Jörg <a@x.com>", "ü@ü.de;<a@x.com>", "Jörg evil@e.com, <a@x.com>",
                "Jörg <a@x.com>, evil@e.com", "evil@e.com: Jörg <a@x.com>") {
            Message f("From: " + v + "\r\nTo: t@x.com\r\nSubject: s\r\n\r\nbody\r\n");
            string from = f.getFrom();
            string ser = f.serializeRaw();
            string hdr = (ser =~ x/^(From: .*?)\r\n(?![ \t])/s)[0];
            assertNRegex(";$", hdr, v);
            for (int i = 0; i < 3; ++i) {
                Message f2(ser);
                assertEq(from, f2.getFrom(), sprintf("parsed %y round %d", v, i));
                ser = f2.serializeRaw();
            }
            # created
            Message m(v, "s");
            m.addTO("t@x.com");
            m.setBody("b");
            from = m.getFrom();
            ser = m.serializeRaw();
            hdr = (ser =~ x/^(From: .*?)\r\n(?![ \t])/s)[0];
            assertNRegex(";$", hdr, v);
            for (int i = 0; i < 3; ++i) {
                Message m2(ser);
                assertEq(from, m2.getFrom(), sprintf("created %y round %d", v, i));
                ser = m2.serializeRaw();
            }
        }
        assertEq("a@x.com", (new Message("From: evil@e.com; Jörg <a@x.com>\r\nTo: t@x.com\r\nSubject: s\r\n\r\nb\r\n"))
            .getFrom());
    }

    # issue #6134 review: text that looks like an encoded word but has a quote, a parenthesis, a bracket, a
    # backslash or a separator is not an encoded word: it cannot change how the rest of the value is read
    testEncodedWordLookalikes() {
        # value, recipients
        list<list<auto>> cases = (
            ("=?UTF-8?Q?\"?= , evil@e.com, \" <a@x.com>", ("a@x.com",)),
            ("Ann =?UTF-8?Q?\"?= x, evil@e.com, y\" <a@x.com>", ("a@x.com",)),
            ("=?UTF-8?Q?(?= , evil@e.com, ) <a@x.com>", ("a@x.com",)),
            ("=?UTF-8?Q?[?= , evil@e.com, ] <a@x.com>", ("a@x.com",)),
            ("=?UTF-8?Q?\\?= \", evil@e.com\" <a@x.com>", ("a@x.com",)),
            ("\"N=?UTF-8?Q?x\",evil@e.com,\"?=\" <a@x.com>", ("evil@e.com", "a@x.com")),
            ("\"=?UTF-8?Q?x\"?= , evil@e.com, \"\" <a@x.com>", ("evil@e.com", "a@x.com")),
            # a real encoded word is text, and the address in it is not a recipient
            ("=?UTF-8?Q?evil@e.com?= <a@x.com>", ("a@x.com",)),
            ("=?UTF-8?Q?J=C3=B6rg_x?= <a@x.com>, b@y.com", ("a@x.com", "b@y.com")),
        );
        foreach list<auto> c in (cases) {
            assertEq(c[1], Message::getEmailAddresses(c[0]), c[0]);
            Message msg(Sender, Subject);
            msg.addTO(c[0]);
            msg.setBody("body");
            assertEq(c[1], msg.getRecipients(), "created: " + c[0]);
            Message parsed("From: s@x.com\r\nTo: " + c[0] + "\r\nSubject: s\r\n\r\nbody\r\n");
            assertEq(c[1], parsed.getRecipients(), "parsed: " + c[0]);
            assertEq(c[1], (new Message(parsed.serializeRaw())).getRecipients(), "reparsed: " + c[0]);
        }
    }

    # issue #6134 review: a display name given apart from the address is quoted, so that it cannot add a recipient
    testNameAddressRecipients() {
        Message msg(Sender, Subject);
        msg.addTO("attacker@evil.com,", "j@x.com");
        msg.addCC("Doe, \"John\" \\ <x@evil.com>; G: e@evil.com;", "c@x.com");
        msg.addBCC("", "b@x.com");
        msg.addTO("Jörg Müller, (attacker@evil.com", "m@x.com");
        msg.setBody("body");
        assertEq(("j@x.com", "m@x.com", "c@x.com", "b@x.com"), msg.getRecipients());
        assertEq(("\"attacker@evil.com,\" <j@x.com>", "\"Jörg Müller, (attacker@evil.com\" <m@x.com>"), msg.getTO());
        assertEq(("b@x.com",), msg.getBCC());
        Message parsed(msg.serializeRaw());
        assertEq(msg.getRecipients(), parsed.getRecipients());
        assertEq(msg.getRecipients(), (new Message(parsed.serializeRaw())).getRecipients());
        # the address must be an address alone
        assertThrows("MESSAGE-ADDTO-ERROR", \msg.addTO(), ("Ann", "a@x.com, evil@e.com"));
        assertThrows("MESSAGE-ADDCC-ERROR", \msg.addCC(), ("Ann", "Ann <a@x.com>"));
        assertThrows("MESSAGE-ADDBCC-ERROR", \msg.addBCC(), ("Ann", "nothing"));
    }

    # issue #6134 review: a quoted local part that needs no quotes is the same address as the unquoted one
    testQuotedLocalPartDuplicates() {
        Message msg(Sender, Subject);
        msg.addTO("\"a\"@x.com, a@X.com, \"a.b\"@x.com, a.b@x.com, \"a b\"@x.com, \"a\\b\"@x.com, ab@x.com");
        msg.addCC("\"jörg\"@x.com, jörg@x.com, \"A\"@x.com");
        msg.setBody("body");
        assertEq(("\"a\"@x.com", "\"a.b\"@x.com", "\"a b\"@x.com", "\"a\\b\"@x.com", "\"jörg\"@x.com", "\"A\"@x.com"),
            msg.getRecipients());
    }

    # issue #6134: the time to get the recipients is linear in the length of an entry
    testListRecipientsTime() {
        int size = 100000;
        hash<string, string> inputs = {
            "commas": strmul(",", size),
            "addresses": strmul("a@x.com,", size / 8),
            "groups": strmul("g:", size / 2) + "a@x.com" + strmul(";", size / 2),
            "quotes": strmul("\"a,\" ", size / 5) + "<a@x.com>",
            "unterminated quotes": strmul("\"a, ", size / 4) + "<a@x.com>",
            "comments": strmul("(", size / 2) + strmul(")", size / 2) + " a@x.com",
            "unterminated": "\"(<[" + strmul("a@x.com, ", size / 9),
            "non-ascii": strmul("Jörg <j@x.com>, ", size / 16),
        };
        foreach hash<auto> i in (inputs.pairIterator()) {
            date start = now_us();
            list<string> l = Message::getEmailAddresses(i.value);
            date elapsed = now_us() - start;
            assertGe(i.key == "commas" ? 0 : 1, l.size(), i.key);
            # well under a second for 100KB; a quadratic algorithm takes minutes
            assertLt(10s, elapsed, i.key);
            if (m_options.verbose) {
                printf("%s: %d addresses in %y\n", i.key, l.size(), elapsed);
            }
        }
    }

    # issue #6307: the multipart boundary of a message is random, and another one is used when a part of the message
    # contains it (RFC 2046 section 5.1.1)
    testBoundary() {
        # a message attached to another one with the same boundary (as messages created in the same second had)
        Message m1(Sender, Subject);
        Message m2(Sender, Subject);
        m1.addTO(To);
        m1.setBody("body one");
        m1.attach("one.txt", MimeTypeText, "attachment one");
        string fwd = m1.serialize();
        m2.mpboundary = m1.mpboundary;
        m2.addTO(To);
        m2.setBody("body two");
        m2.attach("fwd.eml", "message/rfc822", fwd, ContentEncoding::QuotedPrintable);
        m2.attach("two.txt", MimeTypeText, "attachment two");
        Message p(m2.serialize());
        assertEq("body two", p.getBody());
        list<Attachment> atts = p.getAttachments();
        assertEq(("fwd.eml", "two.txt"), (map $1.getName(), atts));
        # the quoted-printable attachment is decoded with LF line breaks
        assertEq(replace(fwd, "\r\n", "\n"), replace(atts[0].getData(), "\r\n", "\n"));
        assertEq("attachment two", atts[1].getData());

        # a message body that contains the boundary
        Message m3(Sender, Subject);
        m3.addTO(To);
        m3.setBody("text\r\n--" + m3.mpboundary + "\r\nContent-Type: text/plain\r\n\r\nsplit",
            ContentEncoding::QuotedPrintable);
        m3.attach("three.txt", MimeTypeText, "attachment three");
        p = new Message(m3.serialize());
        assertEq(replace(m3.getBody(), "\r\n", "\n"), replace(p.getBody(), "\r\n", "\n"));
        assertEq(("three.txt",), (map $1.getName(), p.getAttachments()));

        # messages created at the same time have different boundaries
        assertNeq((new Message(Sender, Subject)).mpboundary, (new Message(Sender, Subject)).mpboundary);
    }
}
