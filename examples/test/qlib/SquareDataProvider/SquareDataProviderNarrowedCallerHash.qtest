%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires SquareDataProvider

%exec-class SquareDataProviderNarrowedCallerHashTest

#! Records the POST requests of a Square data provider and answers them from memory
class PostRecorder {
    public {
        list<hash<auto>> calls = ();
    }

    hash<auto> post(string path, *hash<auto> body) {
        push calls, {"path": path, "body": body};
        # the first page of a search has a cursor
        if (path =~ /search$/ && calls.size() == 1) {
            return {"objects": ({"id": "o1"},), "events": ({"id": "e1"},), "cursor": "next"};
        }
        return {
            "orders": ({"id": "o1"},),
            "order": {"id": "o1"},
            "booking": {"id": "b1"},
            "objects": ({"id": "o2"},),
            "events": ({"id": "e2"},),
        };
    }
}

class TestGetOrders inherits SquareDataProvider::SquareGetOrdersDataProvider {
    public {
        PostRecorder rec();
    }

    constructor(SquareRestClient::SquareRestClientIo rest) : SquareGetOrdersDataProvider(rest) {
    }

    hash<auto> doPost(string path, *hash<auto> body) {
        return rec.post(path, body);
    }
}

