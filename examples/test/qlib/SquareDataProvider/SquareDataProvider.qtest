%modern

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/DataProvider
%requires ../../../../qlib/ConnectionProvider
%requires ../../../../qlib/RestClient.qm

%try-module json
%define NoJson
%endtry

%requires ../../../../qlib/SquareRestClient.qm
%requires ../../../../qlib/SquareDataProvider

%exec-class SquareDataProviderTest

public class SquareDataProviderTest inherits QUnit::Test {
    private {
        #! Square REST client for integration tests
        *SquareRestClient::SquareRestClient client;

        #! Logger for verbose output
        Logger logger;

        #! Custom command-line options
        const MyOpts = Opts + {
            "client_id": "i,client-id=s",
            "client_secret": "s,client-secret=s",
            "token": "t,token=s",
            "location_id": "L,location-id=s",
            "conn": "c,connection=s",
            "sandbox": "S,sandbox",
            "url": "u,url=s",
        };

        #! Test customer ID (created during test)
        *string testCustomerId;

        #! Location ID for tests
        *string locationId;
    }

    constructor() : Test("SquareDataProvider Test", "1.0", \ARGV, MyOpts) {
        logger = new Logger("test", LoggerLevel::getLevelInfo());

        # Unit tests (always run, no credentials needed)
        addTestCase("sanity tests", \sanityTests());
        addTestCase("factory tests", \factoryTests());
        addTestCase("metadata tests", \metadataTests());
        addTestCase("child provider tests", \childProviderTests());
        addTestCase("data type tests", \dataTypeTests());
        addTestCase("trigger example data tests", \triggerExampleDataTests());
        addTestCase("negative tests", \negativeTests());
        addTestCase("connection tests", \connectionTests());

        # Integration tests (require Square credentials)
        addTestCase("integration tests", \integrationTests());

        # Try to set up connection for integration tests
        try {
            setupConnection();
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("Connection setup failed: %s: %s\n", ex.err, ex.desc);
            }
        }

        set_return_value(main());
    }

    #! Sets up the Square client for integration tests
    private setupConnection() {
        # Try to use a connection from Qorus if specified
        *string conn_name = m_options.conn ?? ENV.SQUARE_CONNECTION;
        if (conn_name) {
            if (m_options.verbose) {
                printf("Using connection: %s\n", conn_name);
            }
            client = get_connection(conn_name).get();
            return;
        }

        *string token = m_options.token ?? ENV.SQUARE_ACCESS_TOKEN;
        *string client_id = m_options.client_id ?? ENV.SQUARE_CLIENT_ID;
        *string client_secret = m_options.client_secret ?? ENV.SQUARE_CLIENT_SECRET;
        locationId = m_options.location_id ?? ENV.SQUARE_LOCATION_ID;

        if (!token && (!client_id || !client_secret)) {
            if (m_options.verbose) {
                printf("Missing Square credentials. Required:\n");
                printf("  - SQUARE_CONNECTION or -c option (Qorus connection name)\n");
                printf("Or:\n");
                printf("  - SQUARE_ACCESS_TOKEN or -t option (access token)\n");
                printf("  - SQUARE_LOCATION_ID or -l option (location ID)\n");
                printf("Or:\n");
                printf("  - SQUARE_CLIENT_ID or -i option\n");
                printf("  - SQUARE_CLIENT_SECRET or -s option\n");
                printf("  - SQUARE_LOCATION_ID or -l option\n");
            }
            return;
        }

        # Determine URL
        *string url = m_options.url ?? ENV.SQUARE_URL;
        if (!url && (m_options.sandbox || ENV.SQUARE_SANDBOX)) {
            url = "https://connect.squareupsandbox.com/v2";
        }

        # Token-only mode
        if (token && (!client_id || !client_secret)) {
            if (m_options.verbose) {
                printf("Using token-only mode (no OAuth2 refresh)\n");
                if (url) {
                    printf("Using URL: %s\n", url);
                }
            }
            hash<auto> opts = {
                "token": token,
            };
            if (url) {
                opts.url = url;
            }
            client = new SquareRestClient::SquareRestClient(opts);
            return;
        }

        # Full OAuth2 mode
        hash<auto> opts = {
            "oauth2_client_id": client_id,
            "oauth2_client_secret": client_secret,
        };
        if (token) {
            opts.token = token;
        }
        if (url) {
            opts.url = url;
        }
        client = new SquareRestClient::SquareRestClient(opts);
    }

    #! Check if json module is available
    private checkJson() {
%ifdef NoJson
        testSkip("no json module present");
%endif
    }

    #! Basic sanity tests - provider instantiation
    sanityTests() {
        checkJson();
        try {
            SquareDataProvider::SquareDataProvider prov({
                "squarerestclient_options": {
                    "token": "fake-token",
                },
            });
            assertEq("square", prov.getName());
            assertTrue(prov.getDesc().val());
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "OAUTH2-ERROR") {
                testSkip("OAuth2 requires manual authorization - skipping sanity tests");
            }
            if (ex.err == "SOCKET-CONNECT-ERROR" || ex.err == "SOCKET-SSL-ERROR"
                    || ex.err == "QOREADDRINFO-GETINFO-ERROR") {
                testSkip(sprintf("cannot connect to Square API: %s", ex.desc));
            }
            rethrow;
        }
    }

    #! Factory tests - verify factory registration
    factoryTests() {
        checkJson();
        AbstractDataProviderFactory factory = DataProvider::getFactory("square");
        assertEq("square", factory.getInfo().name);
        assertTrue(factory.getInfo().children_can_support_apis);
        assertTrue(factory.getInfo().children_can_support_records);
        assertTrue(factory.getInfo().children_can_support_observers);

        hash<auto> factoryOpts = factory.getInfo().provider_info.constructor_options;
        assertTrue(factoryOpts.hasKey("squarerestclient"));
    }

    #! Metadata tests - verify provider info structure
    metadataTests() {
        checkJson();
        try {
            SquareDataProvider::SquareDataProvider prov({
                "squarerestclient_options": {
                    "token": "fake-token",
                },
            });
            hash<DataProviderInfo> info = prov.getInfo();

            assertTrue(info.supports_children);
            assertTrue(info.children_can_support_apis);
            assertTrue(info.children_can_support_records);
            assertTrue(info.children_can_support_observers);
            assertEq("SquareDataProvider", info.type);

            assertTrue(info.constructor_options.hasKey("squarerestclient"));
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "OAUTH2-ERROR") {
                testSkip("OAuth2 requires manual authorization - skipping metadata tests");
            }
            if (ex.err == "SOCKET-CONNECT-ERROR" || ex.err == "SOCKET-SSL-ERROR"
                    || ex.err == "QOREADDRINFO-GETINFO-ERROR") {
                testSkip(sprintf("cannot connect to Square API: %s", ex.desc));
            }
            rethrow;
        }
    }

    #! Child provider tests - verify hierarchy
    childProviderTests() {
        checkJson();
        SquareDataProvider::SquareDataProvider prov;
        try {
            prov = new SquareDataProvider::SquareDataProvider({
                "squarerestclient_options": {
                    "token": "fake-token",
                },
            });
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "OAUTH2-ERROR") {
                testSkip("OAuth2 requires manual authorization - skipping child provider tests");
            }
            if (ex.err == "SOCKET-CONNECT-ERROR" || ex.err == "SOCKET-SSL-ERROR"
                    || ex.err == "QOREADDRINFO-GETINFO-ERROR") {
                testSkip(sprintf("cannot connect to Square API: %s", ex.desc));
            }
            rethrow;
        }

        # Check child provider names
        list<string> children = prov.getChildProviderNames();

        # Verify collection providers exist
        assertTrue(children.contains("customers"));
        assertTrue(children.contains("orders"));
        assertTrue(children.contains("payments"));
        assertTrue(children.contains("invoices"));
        assertTrue(children.contains("bookings"));
        assertTrue(children.contains("catalog"));
        assertTrue(children.contains("services"));
        assertTrue(children.contains("refunds"));
        assertTrue(children.contains("inventory"));
        assertTrue(children.contains("execute-api-call"));
        assertTrue(children.contains("events"));

        # Check customers child provider
        AbstractDataProvider customers = prov.getChildProvider("customers");
        assertEq("customers", customers.getName());
        hash<DataProviderInfo> customersInfo = customers.getInfo();
        assertTrue(customersInfo.supports_read);
        assertTrue(customersInfo.supports_native_search);
        assertTrue(customersInfo.supports_children);

        # Verify customers has action children
        list<string> customerChildren = customers.getChildProviderNames();
        assertTrue(customerChildren.contains("create"));
        assertTrue(customerChildren.contains("update"));
        assertTrue(customerChildren.contains("delete"));
        assertTrue(customerChildren.contains("add-to-group"));
        assertTrue(customerChildren.contains("remove-from-group"));

        # Check orders child provider
        AbstractDataProvider orders = prov.getChildProvider("orders");
        assertEq("orders", orders.getName());
        hash<DataProviderInfo> ordersInfo = orders.getInfo();
        assertTrue(ordersInfo.supports_read);
        assertTrue(ordersInfo.supports_native_search);

        # Verify orders has action children
        list<string> orderChildren = orders.getChildProviderNames();
        assertTrue(orderChildren.contains("create"));
        assertTrue(orderChildren.contains("create-paid"));
        assertTrue(orderChildren.contains("batch-get"));
        assertTrue(orderChildren.contains("cancel"));

        # Check payments child provider
        AbstractDataProvider payments = prov.getChildProvider("payments");
        assertEq("payments", payments.getName());
        list<string> paymentChildren = payments.getChildProviderNames();
        assertTrue(paymentChildren.contains("create"));
        assertTrue(paymentChildren.contains("complete"));
        assertTrue(paymentChildren.contains("refund"));

        # Check invoices child provider
        AbstractDataProvider invoices = prov.getChildProvider("invoices");
        assertEq("invoices", invoices.getName());
        list<string> invoiceChildren = invoices.getChildProviderNames();
        assertTrue(invoiceChildren.contains("create"));
        assertTrue(invoiceChildren.contains("send"));
        assertTrue(invoiceChildren.contains("cancel"));

        # Check bookings child provider
        AbstractDataProvider bookings = prov.getChildProvider("bookings");
        assertEq("bookings", bookings.getName());
        list<string> bookingChildren = bookings.getChildProviderNames();
        assertTrue(bookingChildren.contains("create"));
        assertTrue(bookingChildren.contains("cancel"));

        # Check inventory child provider
        AbstractDataProvider inventory = prov.getChildProvider("inventory");
        assertEq("inventory", inventory.getName());
        list<string> inventoryChildren = inventory.getChildProviderNames();
        assertTrue(inventoryChildren.contains("change"));

        # Check events child provider and triggers
        AbstractDataProvider events = prov.getChildProvider("events");
        assertEq("events", events.getName());
        hash<DataProviderInfo> eventsInfo = events.getInfo();
        assertTrue(eventsInfo.supports_children);
        assertTrue(eventsInfo.children_can_support_observers);

        list<string> eventChildren = events.getChildProviderNames();
        assertTrue(eventChildren.contains("customer-created"));
        assertTrue(eventChildren.contains("order-created-or-updated"));
        assertTrue(eventChildren.contains("payment-created-or-updated"));
        assertTrue(eventChildren.contains("new-appointment"));
        assertTrue(eventChildren.contains("new-catalog-item"));
        assertTrue(eventChildren.contains("new-invoice"));
        assertTrue(eventChildren.contains("new-events"));

        # Verify event providers have correct info
        AbstractDataProvider customerCreated = events.getChildProvider("customer-created");
        assertEq("customer-created", customerCreated.getName());
        hash<DataProviderInfo> customerCreatedInfo = customerCreated.getInfo();
        assertTrue(customerCreatedInfo.supports_observable);
    }

    #! Data type tests - verify record type definitions
    dataTypeTests() {
        checkJson();
        # Test customer data type
        SquareDataProvider::SquareCustomerDataType customerType();
        hash<string, AbstractDataField> customerFields = customerType.getFields();
        assertTrue(customerFields.hasKey("id"));
        assertTrue(customerFields.hasKey("given_name"));
        assertTrue(customerFields.hasKey("family_name"));
        assertTrue(customerFields.hasKey("email_address"));
        assertTrue(customerFields.hasKey("phone_number"));
        assertTrue(customerFields.hasKey("company_name"));
        assertTrue(customerFields.hasKey("version"));

        # Test order data type
        SquareDataProvider::SquareOrderDataType orderType();
        hash<string, AbstractDataField> orderFields = orderType.getFields();
        assertTrue(orderFields.hasKey("id"));
        assertTrue(orderFields.hasKey("location_id"));
        assertTrue(orderFields.hasKey("state"));
        assertTrue(orderFields.hasKey("total_money"));
        assertTrue(orderFields.hasKey("line_items"));
        assertTrue(orderFields.hasKey("version"));

        # Test payment data type
        SquareDataProvider::SquarePaymentDataType paymentType();
        hash<string, AbstractDataField> paymentFields = paymentType.getFields();
        assertTrue(paymentFields.hasKey("id"));
        assertTrue(paymentFields.hasKey("amount_money"));
        assertTrue(paymentFields.hasKey("total_money"));
        assertTrue(paymentFields.hasKey("status"));
        assertTrue(paymentFields.hasKey("source_type"));

        # Test invoice data type
        SquareDataProvider::SquareInvoiceDataType invoiceType();
        hash<string, AbstractDataField> invoiceFields = invoiceType.getFields();
        assertTrue(invoiceFields.hasKey("id"));
        assertTrue(invoiceFields.hasKey("version"));
        assertTrue(invoiceFields.hasKey("location_id"));
        assertTrue(invoiceFields.hasKey("order_id"));
        assertTrue(invoiceFields.hasKey("status"));

        # Test booking data type
        SquareDataProvider::SquareBookingDataType bookingType();
        hash<string, AbstractDataField> bookingFields = bookingType.getFields();
        assertTrue(bookingFields.hasKey("id"));
        assertTrue(bookingFields.hasKey("status"));
        assertTrue(bookingFields.hasKey("start_at"));
        assertTrue(bookingFields.hasKey("location_id"));
        assertTrue(bookingFields.hasKey("appointment_segments"));

        # Test catalog item data type
        SquareDataProvider::SquareCatalogItemDataType catalogType();
        hash<string, AbstractDataField> catalogFields = catalogType.getFields();
        assertTrue(catalogFields.hasKey("id"));
        assertTrue(catalogFields.hasKey("type"));
        assertTrue(catalogFields.hasKey("is_deleted"));
        assertTrue(catalogFields.hasKey("item_data"));

        # Test refund data type
        SquareDataProvider::SquareRefundDataType refundType();
        hash<string, AbstractDataField> refundFields = refundType.getFields();
        assertTrue(refundFields.hasKey("id"));
        assertTrue(refundFields.hasKey("status"));
        assertTrue(refundFields.hasKey("amount_money"));
        assertTrue(refundFields.hasKey("payment_id"));

        # Test inventory count data type
        SquareDataProvider::SquareInventoryCountDataType inventoryType();
        hash<string, AbstractDataField> inventoryFields = inventoryType.getFields();
        assertTrue(inventoryFields.hasKey("catalog_object_id"));
        assertTrue(inventoryFields.hasKey("state"));
        assertTrue(inventoryFields.hasKey("location_id"));
        assertTrue(inventoryFields.hasKey("quantity"));

        # Test webhook event data type
        SquareDataProvider::SquareWebhookEventDataType eventType();
        hash<string, AbstractDataField> eventFields = eventType.getFields();
        assertTrue(eventFields.hasKey("event_id"));
        assertTrue(eventFields.hasKey("event_type"));
        assertTrue(eventFields.hasKey("merchant_id"));
        assertTrue(eventFields.hasKey("data"));
    }

    #! Trigger example data tests
    triggerExampleDataTests() {
        checkJson();
        SquareDataProvider::SquareDataProvider prov;
        try {
            prov = new SquareDataProvider::SquareDataProvider({
                "squarerestclient_options": {
                    "token": "fake-token",
                },
            });
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "OAUTH2-ERROR") {
                testSkip("OAuth2 requires manual authorization - skipping trigger tests");
            }
            if (ex.err == "SOCKET-CONNECT-ERROR" || ex.err == "SOCKET-SSL-ERROR"
                    || ex.err == "QOREADDRINFO-GETINFO-ERROR") {
                testSkip(sprintf("cannot connect to Square API: %s", ex.desc));
            }
            rethrow;
        }

        AbstractDataProvider events = prov.getChildProvider("events");
        list<string> triggerNames = (
            "customer-created",
            "order-created-or-updated",
            "payment-created-or-updated",
            "new-appointment",
            "new-catalog-item",
            "new-invoice",
            "new-events",
        );

        foreach string triggerName in (triggerNames) {
            AbstractDataProvider triggerProvider = events.getChildProvider(triggerName);

            # Verify event types are defined
            hash<string, hash<DataProviderMessageInfo>> eventTypes = triggerProvider.getEventTypes();
            assertTrue(eventTypes.hasKey(triggerName),
                sprintf("%s should define event type '%s'", triggerName, triggerName));

            # Verify event type has a data type
            assertTrue(eventTypes{triggerName}.type instanceof AbstractDataProviderType,
                sprintf("%s event type should have a data type", triggerName));

            # Get example event data (will fall back to fake data since we have fake credentials)
            auto exampleData = triggerProvider.getExampleEventData(triggerName);
            assertTrue(exampleData instanceof hash,
                sprintf("%s getExampleEventData() should return a hash", triggerName));
        }
    }

    #! Negative tests - test error handling and invalid inputs
    negativeTests() {
        checkJson();
        SquareDataProvider::SquareDataProvider prov;
        try {
            prov = new SquareDataProvider::SquareDataProvider({
                "squarerestclient_options": {
                    "token": "fake-token",
                },
            });
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "OAUTH2-ERROR") {
                testSkip("OAuth2 requires manual authorization - skipping negative tests");
            }
            if (ex.err == "SOCKET-CONNECT-ERROR" || ex.err == "SOCKET-SSL-ERROR"
                    || ex.err == "QOREADDRINFO-GETINFO-ERROR") {
                testSkip(sprintf("cannot connect to Square API: %s", ex.desc));
            }
            rethrow;
        }

        # Test getting non-existent child provider
        assertThrows("INVALID-CHILD-PROVIDER", sub() {
            prov.getChildProviderEx("nonexistent");
        });

        # Test execute-api-call with invalid method
        AbstractDataProvider apiCall = prov.getChildProvider("execute-api-call");
        hash<DataProviderInfo> apiCallInfo = apiCall.getInfo();
        assertTrue(apiCallInfo.supports_request);
    }

    #! Connection tests - verify REST connection
    connectionTests() {
        checkJson();
        # Verify the scheme is registered
        hash<auto> scheme = ConnectionSchemeCache::getScheme("squareres");
        assertTrue(scheme.schemes.squareres);
        assertTrue(scheme.auto_url);

        # Verify scheme has required options
        assertTrue(scheme.options.hasKey("oauth2_auth_url"));
        assertTrue(scheme.options.hasKey("oauth2_token_url"));
        assertTrue(scheme.options.hasKey("oauth2_client_id"));
        assertTrue(scheme.options.hasKey("oauth2_client_secret"));
    }

    #! Integration tests - require real Square credentials
    integrationTests() {
        checkJson();

        if (!client) {
            testSkip("No Square credentials available - skipping integration tests");
            return;
        }

        if (m_options.verbose) {
            printf("Running Square integration tests...\n");
        }

        # Test 1: List customers
        testListCustomers();

        # Test 2: Create customer
        testCreateCustomer();

        # Test 3: Get customer by ID
        testGetCustomer();

        # Test 4: Update customer
        testUpdateCustomer();

        # Test 5: List payments
        testListPayments();

        # Test 6: Execute API call
        testExecuteApiCall();

        # Test 7: List refunds
        testListRefunds();

        # Cleanup
        cleanup();
    }

    #! Test listing customers
    private testListCustomers() {
        SquareDataProvider::SquareDataProvider prov(client);
        AbstractDataProvider customers = prov.getChildProvider("customers");

        # Search with limit
        AbstractDataProviderRecordIterator iter = customers.searchRecords(NOTHING, {"limit": 5});
        int count = 0;
        while (iter.next()) {
            hash<auto> record = iter.getValue();
            assertTrue(record.hasKey("id"), "Customer should have 'id' field");
            ++count;
        }

        if (m_options.verbose) {
            printf("Listed %d customers\n", count);
        }
        assertTrue(True, "List customers completed without error");
    }

    #! Test creating a customer
    private testCreateCustomer() {
        SquareDataProvider::SquareDataProvider prov(client);
        AbstractDataProvider createAction = prov.getChildProvider("customers").getChildProvider("create");

        string unique = now_us().format("YYYYMMDDHHmmssxxxxxx");
        hash<auto> result = createAction.doRequest({
            "given_name": "Test",
            "family_name": "User_" + unique,
            "email_address": sprintf("test_%s@example.com", unique),
            "note": "Integration test customer - safe to delete",
        });

        assertTrue(result.hasKey("id"), "Created customer should have 'id' field");
        assertTrue(result.id.val(), "Customer ID should be non-empty");
        testCustomerId = result.id;

        if (m_options.verbose) {
            printf("Created customer: %s\n", testCustomerId);
        }

        # Verify data persistence - retrieve the customer and verify fields
        AbstractDataProvider customers = prov.getChildProvider("customers");
        AbstractDataProviderRecordIterator iter = customers.searchRecords(NOTHING, {
            "customer_id": testCustomerId,
        });
        assertTrue(iter.next(), "Should find created customer by ID");
        hash<auto> fetched = iter.getValue();
        assertEq("Test", fetched.given_name, "Customer given_name should match");
        assertTrue(fetched.family_name.regex("User_" + unique),
            "Customer family_name should match");
    }

    #! Test getting a single customer by ID
    private testGetCustomer() {
        if (!testCustomerId) {
            testSkip("No test customer created");
            return;
        }

        SquareDataProvider::SquareDataProvider prov(client);
        AbstractDataProvider customers = prov.getChildProvider("customers");

        AbstractDataProviderRecordIterator iter = customers.searchRecords(NOTHING, {
            "customer_id": testCustomerId,
        });
        assertTrue(iter.next(), "Should find customer by ID");
        hash<auto> record = iter.getValue();
        assertEq(testCustomerId, record.id, "Customer ID should match");
        assertTrue(record.hasKey("given_name"), "Customer should have given_name");
        assertTrue(record.hasKey("family_name"), "Customer should have family_name");
    }

    #! Test updating a customer
    private testUpdateCustomer() {
        if (!testCustomerId) {
            testSkip("No test customer created");
            return;
        }

        SquareDataProvider::SquareDataProvider prov(client);
        AbstractDataProvider updateAction = prov.getChildProvider("customers")
            .getChildProvider("update");

        hash<auto> result = updateAction.doRequest({
            "customer_id": testCustomerId,
            "note": "Updated by integration test",
        });

        assertTrue(result.hasKey("id"), "Updated customer should have 'id' field");
        assertEq(testCustomerId, result.id, "Updated customer ID should match");

        # Verify the update persisted
        AbstractDataProvider customers = prov.getChildProvider("customers");
        AbstractDataProviderRecordIterator iter = customers.searchRecords(NOTHING, {
            "customer_id": testCustomerId,
        });
        assertTrue(iter.next(), "Should find updated customer");
        hash<auto> fetched = iter.getValue();
        assertEq("Updated by integration test", fetched.note, "Customer note should be updated");
    }

    #! Test listing payments
    private testListPayments() {
        SquareDataProvider::SquareDataProvider prov(client);
        AbstractDataProvider payments = prov.getChildProvider("payments");

        AbstractDataProviderRecordIterator iter = payments.searchRecords(NOTHING, {"limit": 5});
        int count = 0;
        while (iter.next()) {
            hash<auto> record = iter.getValue();
            assertTrue(record.hasKey("id"), "Payment should have 'id' field");
            ++count;
        }

        if (m_options.verbose) {
            printf("Listed %d payments\n", count);
        }
        assertTrue(True, "List payments completed without error");
    }

    #! Test execute API call
    private testExecuteApiCall() {
        SquareDataProvider::SquareDataProvider prov(client);
        AbstractDataProvider apiCall = prov.getChildProvider("execute-api-call");

        hash<auto> result = apiCall.doRequest({
            "method": "GET",
            "path": "locations",
        });

        assertTrue(result.hasKey("locations"), "API call should return locations");
        if (result.locations) {
            assertTrue(result.locations.size() > 0, "Should have at least one location");
            hash<auto> firstLoc = result.locations[0];
            assertTrue(firstLoc.hasKey("id"), "Location should have 'id' field");
            assertTrue(firstLoc.hasKey("name"), "Location should have 'name' field");
            if (m_options.verbose) {
                printf("Found %d locations, first: %s (%s)\n",
                    result.locations.size(), firstLoc.name, firstLoc.id);
            }
        }
    }

    #! Test listing refunds
    private testListRefunds() {
        SquareDataProvider::SquareDataProvider prov(client);
        AbstractDataProvider refunds = prov.getChildProvider("refunds");

        AbstractDataProviderRecordIterator iter = refunds.searchRecords(NOTHING, {"limit": 5});
        int count = 0;
        while (iter.next()) {
            hash<auto> record = iter.getValue();
            assertTrue(record.hasKey("id"), "Refund should have 'id' field");
            ++count;
        }

        if (m_options.verbose) {
            printf("Listed %d refunds\n", count);
        }
        assertTrue(True, "List refunds completed without error");
    }

    #! Cleanup test data
    private cleanup() {
        if (!testCustomerId) {
            return;
        }

        if (m_options.verbose) {
            printf("Cleaning up test customer: %s\n", testCustomerId);
        }

        # Delete the test customer using the delete action
        try {
            SquareDataProvider::SquareDataProvider prov(client);
            AbstractDataProvider deleteAction = prov.getChildProvider("customers")
                .getChildProvider("delete");
            deleteAction.doRequest({
                "customer_id": testCustomerId,
            });
            if (m_options.verbose) {
                printf("Test customer deleted successfully\n");
            }
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("Warning: cleanup failed: %s: %s\n", ex.err, ex.desc);
            }
        }
    }
}
