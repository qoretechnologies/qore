%modern

# Set up SIGUSR1 handler to dump thread stacks for debugging
@debug {
    set_signal_handler(SIGUSR1, sub (int sig) {
        printf("=== SIGUSR1 Thread Stacks ===\n%Y\n=== End Thread Stacks ===\n",
            get_all_thread_call_stacks());
    });
}

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/Http3ClientIo
%requires ../../../../qlib/AsyncSocketIo

%exec-class Http3ClientIoTest

class Http3ClientIoTest inherits QUnit::Test {
    private {
        Logger mLogger;
    }

    constructor() : Test("Http3ClientIoTest", "1.0") {
        # Module and definition tests
        addTestCase("module load test", \testModuleLoad());
        addTestCase("hashdecl and enum definitions", \testDefinitions());
        addTestCase("connection manager creation", \testConnectionManagerCreation());

        # Basic functionality tests
        addTestCase("connection manager stats", \testConnectionManagerStats());

        # Negative tests
        addTestCase("invalid URL handling", \testInvalidUrl());
        addTestCase("connection manager shutdown", \testConnectionManagerShutdown());

        # Corner case tests
        addTestCase("empty options hashdecl", \testEmptyOptions());
        addTestCase("stream state transitions", \testStreamStateTransitions());
        addTestCase("connection state transitions", \testConnectionStateTransitions());

        # Controller mode tests (without actual QUIC connections)
        addTestCase("controller mode setup", \testControllerModeSetup());

        # Connection manager lifecycle tests
        addTestCase("close all is idempotent", \testCloseAllIdempotent());
        addTestCase("cleanup idle with no connections", \testCleanupIdleNoConnections());

        set_return_value(main());
    }

    globalSetUp() {
        mLogger = new Logger("http3-client-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            mLogger.addAppender(new StdoutAppender());
        }
    }

    #! Test that the module loaded successfully
    testModuleLoad() {
        # Verify a key class from the module is accessible
        assertEq("Http3ClientConnectionManager", get_class_name(new Http3ClientConnectionManager()),
            "Http3ClientIo module loaded");
    }

    #! Test hashdecl and enum definitions are accessible
    testDefinitions() {
        # Test stream state enums have expected values
        assertEq(0, Http3ClientIo::Http3ClientStreamState::Pending, "stream state Pending");
        assertEq(1, Http3ClientIo::Http3ClientStreamState::Open, "stream state Open");
        assertEq(2, Http3ClientIo::Http3ClientStreamState::HeadersReceived, "stream state HeadersReceived");
        assertEq(3, Http3ClientIo::Http3ClientStreamState::ReceivingBody, "stream state ReceivingBody");
        assertEq(4, Http3ClientIo::Http3ClientStreamState::Complete, "stream state Complete");
        assertEq(5, Http3ClientIo::Http3ClientStreamState::Cancelled, "stream state Cancelled");
        assertEq(6, Http3ClientIo::Http3ClientStreamState::Error, "stream state Error");

        # Test connection state enums have expected values
        assertEq(0, Http3ClientIo::Http3ClientConnectionState::Connecting, "conn state Connecting");
        assertEq(1, Http3ClientIo::Http3ClientConnectionState::Ready, "conn state Ready");
        assertEq(2, Http3ClientIo::Http3ClientConnectionState::Draining, "conn state Draining");
        assertEq(3, Http3ClientIo::Http3ClientConnectionState::Closed, "conn state Closed");

        # Test constants have expected values
        assertEq(6, Http3ClientIo::DefaultMaxConnectionsPerHost, "default max connections per host");
        assertEq(100, Http3ClientIo::DefaultMaxStreamsPerConnection, "default max streams per connection");
        assertTrue(Http3ClientIo::DefaultConnectionIdleTimeout > 0, "default idle timeout > 0");
        assertTrue(Http3ClientIo::DefaultConnectTimeout > 0, "default connect timeout > 0");
        assertTrue(Http3ClientIo::DefaultRequestTimeout > 0, "default request timeout > 0");

        # Test hashdecl can be instantiated with values
        hash<Http3ClientIo::Http3ClientConnectionManagerOptions> opts = <Http3ClientIo::Http3ClientConnectionManagerOptions>{
            "max_connections_per_host": 4,
            "max_streams_per_connection": 50,
            "idle_timeout": 30s,
            "connect_timeout": 15s,
            "request_timeout": 45s,
        };
        assertEq(4, opts.max_connections_per_host, "manager options max_connections_per_host");
        assertEq(50, opts.max_streams_per_connection, "manager options max_streams_per_connection");
        assertEq(30000, int(opts.idle_timeout), "manager options idle_timeout");
        assertEq(15000, int(opts.connect_timeout), "manager options connect_timeout");
        assertEq(45000, int(opts.request_timeout), "manager options request_timeout");

        # Test request options hashdecl
        hash<Http3ClientIo::Http3ClientRequestOptions> req_opts = <Http3ClientIo::Http3ClientRequestOptions>{
            "timeout": 5s,
        };
        assertEq(5000, int(req_opts.timeout), "request options timeout");

        # Test response info hashdecl
        hash<Http3ClientIo::Http3ClientResponseInfo> resp_info = <Http3ClientIo::Http3ClientResponseInfo>{
            "status_code": 200,
            "headers": {"content-type": "text/plain"},
            "body": binary("test"),
            "stream_id": 1,
        };
        assertEq(200, resp_info.status_code, "response info status_code");
        assertEq("text/plain", resp_info.headers."content-type", "response info headers");
        assertEq(binary("test"), resp_info.body, "response info body");
        assertEq(1, resp_info.stream_id, "response info stream_id");

        # Test error info hashdecl
        hash<Http3ClientIo::Http3ClientErrorInfo> err_info = <Http3ClientIo::Http3ClientErrorInfo>{
            "err": "HTTP3-ERROR",
            "desc": "test error",
            "stream_id": 3,
        };
        assertEq("HTTP3-ERROR", err_info.err, "error info err");
        assertEq("test error", err_info.desc, "error info desc");
        assertEq(3, err_info.stream_id, "error info stream_id");

        # Test connection info hashdecl
        hash<Http3ClientIo::Http3ClientConnectionInfo> conn_info = <Http3ClientIo::Http3ClientConnectionInfo>{
            "host": "example.com",
            "port": 443,
            "active_streams": 5,
            "max_concurrent_streams": 100,
            "connection_id": 1,
        };
        conn_info.state = Http3ClientIo::Http3ClientConnectionState::Ready;
        assertEq("example.com", conn_info.host, "connection info host");
        assertEq(443, conn_info.port, "connection info port");
        assertEq(Http3ClientIo::Http3ClientConnectionState::Ready, conn_info.state, "connection info state");
        assertEq(5, conn_info.active_streams, "connection info active_streams");
        assertEq(100, conn_info.max_concurrent_streams, "connection info max_concurrent_streams");
        assertEq(1, conn_info.connection_id, "connection info connection_id");
    }

    #! Test connection manager creation with various options
    testConnectionManagerCreation() {
        # Create with default options
        Http3ClientIo::Http3ClientConnectionManager manager1();
        hash<auto> stats1 = manager1.getStats();
        assertEq(0, stats1.total_connections, "default manager initial connections");
        assertEq(0, stats1.total_active_streams, "default manager initial streams");
        assertEq(0, stats1.hosts, "default manager initial hosts");

        # Create with custom options
        Http3ClientIo::Http3ClientConnectionManager manager2(<Http3ClientIo::Http3ClientConnectionManagerOptions>{
            "max_connections_per_host": 4,
            "max_streams_per_connection": 50,
            "idle_timeout": 30s,
            "connect_timeout": 15s,
            "request_timeout": 45s,
            "logger": mLogger,
        });
        hash<auto> stats2 = manager2.getStats();
        assertEq(0, stats2.total_connections, "custom manager initial connections");
        assertEq(0, stats2.total_active_streams, "custom manager initial streams");

        # Create with minimal options
        Http3ClientIo::Http3ClientConnectionManager manager3(<Http3ClientIo::Http3ClientConnectionManagerOptions>{
            "max_connections_per_host": 1,
        });
        hash<auto> stats3 = manager3.getStats();
        assertEq(0, stats3.total_connections, "minimal manager initial connections");
    }

    #! Test connection manager statistics
    testConnectionManagerStats() {
        Http3ClientIo::Http3ClientConnectionManager manager();

        # Initial stats should be empty
        hash<auto> stats = manager.getStats();
        assertEq(0, stats.total_connections, "initial total_connections");
        assertEq(0, stats.total_active_streams, "initial total_active_streams");
        assertEq(0, stats.hosts, "initial hosts count");
        assertEq({}, stats.per_host, "initial per_host empty");

        # After cleanup (no connections to clean)
        manager.cleanupIdleConnections();
        stats = manager.getStats();
        assertEq(0, stats.total_connections, "after cleanup total_connections");
    }

    #! Test invalid URL handling
    testInvalidUrl() {
        Http3ClientIo::Http3ClientConnectionManager manager();

        # Test URL without host
        assertThrows("HTTP3-URL-ERROR", \manager.acquireStream(), ("https:///path",),
            "URL without host should throw");

        # Test empty URL
        assertThrows("HTTP3-URL-ERROR", \manager.acquireStream(), ("",),
            "empty URL should throw");

        # Test URL with only scheme
        assertThrows("HTTP3-URL-ERROR", \manager.acquireStream(), ("https://",),
            "URL with only scheme should throw");
    }

    #! Test connection manager shutdown
    testConnectionManagerShutdown() {
        Http3ClientIo::Http3ClientConnectionManager manager();

        # Close all connections (should work even with no connections)
        manager.closeAll();

        # After closeAll, acquiring streams should fail
        assertThrows("HTTP3-SHUTDOWN", \manager.acquireStream(), ("https://example.com",),
            "acquireStream after shutdown should throw");

        # Stats should show no connections
        hash<auto> stats = manager.getStats();
        assertEq(0, stats.total_connections, "after shutdown total_connections");
    }

    #! Test empty options hashdecl
    testEmptyOptions() {
        # Create manager with empty hash (should use defaults)
        Http3ClientIo::Http3ClientConnectionManager manager(<Http3ClientIo::Http3ClientConnectionManagerOptions>{});
        hash<auto> stats = manager.getStats();
        assertEq(0, stats.total_connections, "empty options manager works");
    }

    #! Test stream state transitions
    testStreamStateTransitions() {
        # Verify state values are distinct
        list<int> states = (
            Http3ClientIo::Http3ClientStreamState::Pending,
            Http3ClientIo::Http3ClientStreamState::Open,
            Http3ClientIo::Http3ClientStreamState::HeadersReceived,
            Http3ClientIo::Http3ClientStreamState::ReceivingBody,
            Http3ClientIo::Http3ClientStreamState::Complete,
            Http3ClientIo::Http3ClientStreamState::Cancelled,
            Http3ClientIo::Http3ClientStreamState::Error,
        );

        # All states should be unique
        hash<string, bool> seen;
        foreach int state in (states) {
            string key = string(state);
            assertFalse(seen{key} ?? False, sprintf("stream state %d should be unique", state));
            seen{key} = True;
        }
        assertEq(7, seen.size(), "should have 7 unique stream states");
    }

    #! Test connection state transitions
    testConnectionStateTransitions() {
        # Verify connection states are distinct
        list<int> conn_states = (
            Http3ClientIo::Http3ClientConnectionState::Connecting,
            Http3ClientIo::Http3ClientConnectionState::Ready,
            Http3ClientIo::Http3ClientConnectionState::Draining,
            Http3ClientIo::Http3ClientConnectionState::Closed,
        );

        hash<string, bool> conn_seen;
        foreach int state in (conn_states) {
            string key = string(state);
            assertFalse(conn_seen{key} ?? False, sprintf("conn state %d should be unique", state));
            conn_seen{key} = True;
        }
        assertEq(4, conn_seen.size(), "should have 4 unique connection states");
    }

    #! Test controller mode setup/teardown
    testControllerModeSetup() {
        AsyncSocketIo::AsyncSocketIoController controller(False);
        Http3ClientIo::Http3ClientConnectionManager manager(<Http3ClientIo::Http3ClientConnectionManagerOptions>{
            "logger": mLogger,
        });

        # Manager should not be in controller mode initially
        assertFalse(manager.isControllerMode(), "not in controller mode initially");
        assertNothing(manager.getController(), "no controller initially");

        # Set controller
        manager.setController(controller);
        assertTrue(manager.isControllerMode(), "in controller mode after setController");
        assertEq(True, exists manager.getController(), "controller set");

        # Start/stop controller cleanly
        controller.start();
        on_exit {
            controller.stop();
            manager.closeAll();
        }

        # Stats should still be empty
        hash<auto> stats = manager.getStats();
        assertEq(0, stats.total_connections, "controller mode initial connections");
    }

    #! Test that closeAll is idempotent
    testCloseAllIdempotent() {
        Http3ClientIo::Http3ClientConnectionManager manager();

        # Calling closeAll multiple times should not throw
        manager.closeAll();
        manager.closeAll();
        manager.closeAll();

        # Should still be in shutdown state
        assertThrows("HTTP3-SHUTDOWN", \manager.acquireStream(), ("https://example.com",),
            "still shutdown after multiple closeAll");
    }

    #! Test cleanup idle with no connections
    testCleanupIdleNoConnections() {
        Http3ClientIo::Http3ClientConnectionManager manager();

        # cleanupIdleConnections should work with no connections
        manager.cleanupIdleConnections();

        # Stats should still be empty
        hash<auto> stats = manager.getStats();
        assertEq(0, stats.total_connections, "cleanup idle no connections");
    }
}
