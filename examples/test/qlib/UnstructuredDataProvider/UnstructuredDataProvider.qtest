#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%allow-injection

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires FsUtil
%requires Mime
%requires QUnit
%requires Logger
%requires ConnectionProvider
%requires DataProvider
%requires UnstructuredRestClient
%requires UnstructuredDataProvider
%requires RestSchemaActions
%requires json

%exec-class UnstructuredDataProviderTest

#! Subclasses the real UnstructuredRestClientIo and overrides partitionText
#! to skip the multipart upload — returns a canned element tree.
class FakeUnstructuredRestClientIo inherits UnstructuredRestClient::UnstructuredRestClientIo {
    public {
        string last_text;
        *string last_filename;
        *string last_content_type;
        *data last_body;
        *hash<auto> last_options;
        list<hash<auto>> canned_elements;
    }
    constructor() : UnstructuredRestClientIo({"apikey": "fake-key"}) {}

    list<hash<auto>> partitionText(string text, *hash<auto> options) {
        last_text = text;
        last_options = options;
        return canned_elements;
    }

    list<hash<auto>> partition(string filename, string content_type, data body,
            *hash<auto> options) {
        last_filename = filename;
        last_content_type = content_type;
        last_body = body;
        last_options = options;
        return canned_elements;
    }
}

#! A Platform API client that records the body of a request and stops it there
class FakeUnstructuredPlatformRestClientIo inherits UnstructuredRestClient::UnstructuredPlatformRestClientIo {
    public {
        *hash<auto> last_request;
    }

    constructor() : UnstructuredPlatformRestClientIo({"apikey": "fake-key"}) {}

    RestClient::AbstractRestClient copyWithUrl(string new_url) {
        return self;
    }

    hash<RestClient::RestResponseInfo> restDoRawRequestTarget(string method,
            hash<RestClient::RestRequestTarget> target, *data body, *hash<auto> hdr) {
        return restDoRawRequest(method, target.path, body, hdr);
    }

    hash<RestClient::RestResponseInfo> restDoRawRequest(string method, string path, *data body,
            *hash<auto> hdr) {
        last_request = body.val() ? parse_json(body.toString()) : NOTHING;
        throw "TEST-REQUEST-SENT", sprintf("%s %s", method, path);
    }
}

