    public {
        const MyOpts = Opts + {
            "conn": "c,connection=s",
        };

        const OptionColumn = 22;

        #! A minimal, valid one-page PDF carrying a heading and two paragraphs
        /** Base64-encoded so the fixture needs no binary file in the repository and keeps its
            \c xref table intact; Unstructured rejects a PDF without \c startxref.
        */
        const TestPdfBase64 =
            "JVBERi0xLjQKMSAwIG9iago8PCAvVHlwZSAvQ2F0YWxvZyAvUGFnZXMgMiAwIFIgPj4KZW5kb2JqCjIgMCBvYmoK"
            "PDwgL1R5cGUgL1BhZ2VzIC9LaWRzIFszIDAgUl0gL0NvdW50IDEgPj4KZW5kb2JqCjMgMCBvYmoKPDwgL1R5cGUg"
            "L1BhZ2UgL1BhcmVudCAyIDAgUiAvTWVkaWFCb3ggWzAgMCA2MTIgNzkyXSAvUmVzb3VyY2VzIDw8IC9Gb250IDw8"
            "IC9GMSA1IDAgUiA+PiA+PiAvQ29udGVudHMgNCAwIFIgPj4KZW5kb2JqCjQgMCBvYmoKPDwgL0xlbmd0aCAxOTQg"
            "Pj4Kc3RyZWFtCkJUIC9GMSAxOCBUZiA3MiA3MjAgVGQgKFF1YXJ0ZXJseSBSZXBvcnQpIFRqIEVUCkJUIC9GMSAx"
            "MSBUZiA3MiA2OTAgVGQgKFJldmVudWUgZ3JldyBieSB0d2VsdmUgcGVyY2VudCB0aGlzIHF1YXJ0ZXIuKSBUaiBF"
            "VApCVCAvRjEgMTEgVGYgNzIgNjcwIFRkIChDb3N0cyByZW1haW5lZCBmbGF0IGFjcm9zcyBhbGwgcmVnaW9ucy4p"
            "IFRqIEVUCmVuZHN0cmVhbQplbmRvYmoKNSAwIG9iago8PCAvVHlwZSAvRm9udCAvU3VidHlwZSAvVHlwZTEgL0Jh"
            "c2VGb250IC9IZWx2ZXRpY2EgPj4KZW5kb2JqCnhyZWYKMCA2CjAwMDAwMDAwMDAgNjU1MzUgZiAKMDAwMDAwMDAw"
            "OSAwMDAwMCBuIAowMDAwMDAwMDU4IDAwMDAwIG4gCjAwMDAwMDAxMTUgMDAwMDAgbiAKMDAwMDAwMDI0MSAwMDAw"
            "MCBuIAowMDAwMDAwNDg2IDAwMDAwIG4gCnRyYWlsZXIKPDwgL1NpemUgNiAvUm9vdCAxIDAgUiA+PgpzdGFydHhy"
            "ZWYKNTU2CiUlRU9GCg==";

        const TestElements = (
            {"type": "Title", "text": "Section One", "element_id": "e1",
             "metadata": {"page_number": 1}},
            {"type": "NarrativeText", "text": "Body paragraph.", "element_id": "e2",
             "metadata": {"page_number": 1}},
        );
    }

    private {
        *string conn_name;
    }

    constructor() : Test("UnstructuredDataProvider Test", "1.0", \ARGV, MyOpts) {
        conn_name = m_options.conn ?? ENV.UNSTRUCTURED_CONNECTION;

        addTestCase("factory + app + action registered", \registrationTest());
        addTestCase("provider hierarchy", \providerHierarchyTest());
        addTestCase("constructor requires an API key", \constructorOptionsTest());
        addTestCase("request and response types", \providerTypesTest());
        addTestCase("partition-text forwards to partitionText()", \partitionTextTest());
        addTestCase("partition-file accepts inline data and a path", \partitionFileTest());
        addTestCase("partition-file rejects an ambiguous document argument",
            \partitionFileArgumentTest());
        addTestCase("platform action set is generated from the vendored schema",
            \platformActionSetTest());
        addTestCase("platform action options are usable", \platformActionOptionTest());
        addTestCase("every workflow schedule offered is one the API accepts", \platformScheduleTest());
        addTestCase("platform record tables", \platformRecordTableTest());
        addTestCase("platform job event provider", \platformEventTest());
        addTestCase("connector configuration fields", \connectorFieldsTest());

        # Live tests require a real Unstructured connection.  Unstructured Serverless free tier:
        # 1000 pages/month; these tests submit a few bytes of text.
        if (conn_name) {
            addTestCase("live: connection provides the data provider", \liveConnectionTest());
            addTestCase("live: partition-text round trip", \livePartitionTextTest());
            addTestCase("live: partition-file round trip", \livePartitionFileTest());
            addTestCase("live: platform connector and workflow lifecycle",
                \livePlatformLifecycleTest());
            addTestCase("live: platform record tables read", \livePlatformTableTest());
        }
        set_return_value(main());
    }

    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-c,--connection=ARG",
            "set the Unstructured connection name; without it (and without the "
            "UNSTRUCTURED_CONNECTION environment variable) the live tests are skipped",
            OptionColumn);
    }

    private registrationTest() {
        DataProvider::AbstractDataProviderFactory f =
            DataProvider::DataProvider::getFactory("unstructured");
        assertEq("unstructured", f.getInfo().name);
        hash<DataProviderAppInfo> app =
            DataProvider::DataProviderActionCatalog::getApp("UnstructuredIo");
        assertEq("UnstructuredIo", app.name);
        assertEq("unstructured", app.scheme);
        # filter out the framework-injected make-api-call action (covered by
        # GenericApiCallAutoInjection.qtest in RestClientDataProvider)
        list<hash<DataProviderActionInfo>> actions = select
            DataProvider::DataProviderActionCatalog::getActions("UnstructuredIo"),
            $1.action != AbstractDataProvider::GenericApiCallActionName;
        # the partition side; the Platform API actions live under /platform and are covered by
        # platformActionOptionTest()
        list<hash<DataProviderActionInfo>> partition_actions = select actions,
            $1.path !~ /^\/platform/;
        assertEq(("partition-file", "partition-text"),
            sort((map $1.action, partition_actions)));
        map assertEq(DPAT_API, $1.action_code, $1.action), partition_actions;
        assertTrue(actions.size() > partition_actions.size(),
            "the platform actions are registered for the same app");

        hash<DataProviderActionInfo> text_action =
            (select partition_actions, $1.action == "partition-text")[0];
        hash<DataProviderActionInfo> file_action =
            (select partition_actions, $1.action == "partition-file")[0];

        # "text" is the required input of the text action
        assertTrue(text_action.options.text.required);
        # the document is given either inline or by path, so neither is required on its own,
        # but both must be shown upfront
        assertTrue(file_action.options.file_data.preselected);
        assertTrue(file_action.options.file_path.preselected);

        # the endpoint's option set is exposed, not just a handful of it
        map assertTrue(exists text_action.options{$1}, $1),
            ("strategy", "content_type", "chunking_strategy", "max_characters", "overlap",
             "extract_image_block_types", "pdf_infer_table_structure", "coordinates");
        map assertTrue(exists file_action.options{$1}, $1),
            ("strategy", "content_type", "chunking_strategy", "max_characters", "overlap",
             "extract_image_block_types", "pdf_infer_table_structure", "coordinates");
        assertTrue(text_action.options.size() > 20,
            sprintf("partition-text exposes %d options", text_action.options.size()));

        # the strategies the API actually accepts, verified against its OpenAPI schema
        assertEq(("auto", "fast", "hi_res", "ocr_only", "od_only", "vlm"),
            (map $1.value, text_action.options.strategy.allowed_values));
        assertEq(("basic", "by_title", "by_page", "by_similarity"),
            (map $1.value, text_action.options.chunking_strategy.allowed_values));
    }

    private providerHierarchyTest() {
        FakeUnstructuredRestClientIo fake();
        UnstructuredDataProvider::UnstructuredDataProvider prov(fake);
        assertEq("unstructured", prov.getName());
        assertTrue(prov.getChildProviderNames().contains("partition-text"));

        AbstractDataProvider child = prov.getChildProviderEx("partition-text");
        assertEq("partition-text", child.getName());
        assertTrue(child.getInfo().supports_request);

        assertTrue(prov.getChildProviderNames().contains("partition-file"));
        assertEq("partition-file", prov.getChildProviderEx("partition-file").getName());

        assertTrue(prov.getChildProviderNames().contains("platform"));

        # summary info is published for every child
        assertEq(("partition-file", "partition-text", "platform"),
            sort((map $1.name, prov.getChildProviderSummaryInfo())));

        assertThrows("INVALID-CHILD-PROVIDER", sub () {
            prov.getChildProviderEx("does-not-exist");
        });
    }

    private constructorOptionsTest() {
        # the API key is mandatory for Unstructured API communication
        assertThrows("CONSTRUCTOR-ERROR", sub () {
            new UnstructuredDataProvider::UnstructuredDataProvider({});
        });

        # ... and a provider constructed with one uses the given URL
        UnstructuredDataProvider::UnstructuredDataProvider prov({
            "apikey": "k",
            "url": "https://example.com",
        });
        assertEq("unstructured", prov.getName());

        # the API key option is declared required and sensitive so that UIs prompt for it
        hash<auto> copts = UnstructuredDataProvider::UnstructuredDataProvider::ProviderInfo
            .constructor_options;
        assertTrue(copts.apikey.required);
        assertTrue(copts.apikey.sensitive);
    }

    private providerTypesTest() {
        FakeUnstructuredRestClientIo fake();
        AbstractDataProvider pt =
            new UnstructuredDataProvider::UnstructuredPartitionTextDataProvider(fake);

        AbstractDataProviderType req = pt.getRequestType();
        # the document text is the one mandatory input
        assertEq("string", req.getFields().text.getType().getName());
        assertTrue(req.getFields().text.isMandatory());
        assertFalse(req.getFields().strategy.isMandatory());
        # the partitioning strategies Unstructured accepts, verified against its OpenAPI schema
        assertEq(("auto", "fast", "hi_res", "ocr_only", "od_only", "vlm"),
            (map $1.value, req.getFields().strategy.getAllowedValues()));
        assertEq(("basic", "by_title", "by_page", "by_similarity"),
            (map $1.value, req.getFields().chunking_strategy.getAllowedValues()));

        # the file action shares the same option set and adds the document arguments
        AbstractDataProvider pf =
            new UnstructuredDataProvider::UnstructuredPartitionFileDataProvider(fake);
        AbstractDataProviderType freq = pf.getRequestType();
        assertEq("UnstructuredPartitionFileRequest", freq.getName());
        map assertTrue(exists freq.getFields(){$1}, $1),
            ("file_data", "file_path", "filename");
        # neither document argument is mandatory on its own; the provider enforces the choice
        map assertFalse(freq.getFields(){$1}.isMandatory(), $1),
            ("file_data", "file_path");
        # both actions expose the identical partition option set
        assertEq(keys (req.getFields() - "text"),
            keys (freq.getFields() - ("file_data", "file_path", "filename")));
        assertEq("UnstructuredPartitionResponse", pf.getResponseType().getName());

        # types must be named; an unnamed HashDataType reports as "hash<auto>" and the UI has
        # no schema to render
        assertEq("UnstructuredPartitionTextRequest", req.getName());

        AbstractDataProviderType resp = pt.getResponseType();
        # both actions share one response type
        assertEq("UnstructuredPartitionResponse", resp.getName());
        assertEq(("elt_list",), keys resp.getFields());
        assertEq("UnstructuredElementList", resp.getFields().elt_list.getType().getName());

        # the element and its metadata are typed, not bare hashes
        AbstractDataProviderType el = resp.getFields().elt_list.getType().getElementType();
        assertEq("UnstructuredElement", el.getName());
        AbstractDataProviderType md = el.getFields().metadata.getType();
        assertEq("UnstructuredElementMetadata", md.getName());
        # the fields that carry the value for RAG ingestion
        map assertTrue(exists md.getFields(){$1}, $1),
            ("page_number", "parent_id", "text_as_html", "image_base64", "coordinates",
             "orig_elements", "filename", "filetype");
    }

    private partitionTextTest() {
        FakeUnstructuredRestClientIo fake();
        fake.canned_elements = TestElements;
        UnstructuredDataProvider::UnstructuredPartitionTextDataProvider prov(fake);
        auto resp = prov.doRequest({
            "text": "Section One\n\nBody paragraph.",
            "strategy": "fast",
            "languages": ("eng",),
        });
        assertEq("Section One\n\nBody paragraph.", fake.last_text);
        assertEq("fast", fake.last_options.strategy);
        assertEq(("eng",), fake.last_options.languages);
        # text was removed from options before forwarding
        assertEq(NOTHING, fake.last_options.text);
        assertEq(2, resp.elt_list.size());
        assertEq("Title", resp.elt_list[0].type);
        assertEq("Section One", resp.elt_list[0].text);
        assertEq(1, resp.elt_list[0].metadata.page_number);
    }

    private partitionFileTest() {
        FakeUnstructuredRestClientIo fake();
        fake.canned_elements = TestElements;
        UnstructuredDataProvider::UnstructuredPartitionFileDataProvider prov(fake);

        # inline content: the caller's filename and content type are used
        auto resp = prov.doRequest({
            "file_data": binary("%PDF-1.4 fake"),
            "filename": "q3.pdf",
            "content_type": MimeTypePdf,
            "strategy": "fast",
        });
        assertEq("q3.pdf", fake.last_filename);
        assertEq(MimeTypePdf, fake.last_content_type);
        assertEq(binary("%PDF-1.4 fake"), fake.last_body);
        assertEq("fast", fake.last_options.strategy);
        # the content type stays in the options: it is also Unstructured's own hint field
        assertEq(MimeTypePdf, fake.last_options.content_type);
        # the document arguments are not forwarded as partition options
        map assertEq(NOTHING, fake.last_options{$1}, $1),
            ("file_data", "file_path", "filename");
        assertEq(2, resp.elt_list.size());

        # by path: the file is read and the base name is used when no filename is given
        TmpFile tmp("unstructured-", ".pdf");
        File f();
        f.open2(tmp.path, O_WRONLY | O_TRUNC);
        f.write("%PDF-1.4 on disk");
        f.close();
        prov.doRequest({"file_path": tmp.path, "content_type": MimeTypePdf});
        assertEq(basename(tmp.path), fake.last_filename);
        assertFalse(fake.last_filename =~ /\//);
        assertEq(binary("%PDF-1.4 on disk"), fake.last_body);
    }

    private partitionFileArgumentTest() {
        FakeUnstructuredRestClientIo fake();
        UnstructuredDataProvider::UnstructuredPartitionFileDataProvider prov(fake);

        assertThrows("PARTITION-FILE-ERROR", "mutually exclusive", sub () {
            prov.doRequest({"file_data": <00>, "file_path": "/tmp/does-not-matter"});
        });
        assertThrows("PARTITION-FILE-ERROR", "is required", sub () {
            prov.doRequest({"strategy": "fast"});
        });
    }

    #! Returns a platform subtree built on a client that is never used
    private AbstractDataProvider getPlatformProvider() {
        return new UnstructuredDataProvider::UnstructuredPlatformDataProvider(
            new UnstructuredRestClient::UnstructuredPlatformRestClientIo({"apikey": "fake-key"}));
    }

    private platformActionSetTest() {
        # the vendored schema is pinned, so its provenance is part of the module's contract
        hash<UnstructuredPlatformSchemaProvenanceInfo> p =
            UnstructuredDataProvider::UnstructuredPlatformSchema::Provenance;
        assertEq("3.1.1", p.api_version);
        assertEq(64, p.source_sha256.size());
        assertTrue(p.source_url =~ /openapi\.json$/);
        assertTrue(is_file(UnstructuredDataProvider::UnstructuredPlatformSchema::getSchemaPath()),
            "the vendored schema ships beside the module");

        RestSchemaActions::RestSchemaActionSet aset =
            UnstructuredDataProvider::UnstructuredPlatformSchema::getActionSet();
        # every action in the manifest resolves against the pinned document
        assertEq(UnstructuredPlatformManifest::Manifest.size(),
            aset.getActionInfoList(UnstructuredDataProvider::AppName).size());

        AbstractDataProvider plat = getPlatformProvider();
        assertEq("platform", plat.getName());
        list<string> kids = plat.getChildProviderNames();
        map assertTrue(kids.contains($1), $1),
            ("list-workflows", "create-workflow", "run-workflow", "list-jobs", "create-source",
             "create-destination", "list-templates", "connector-fields", "tables", "events");
    }

    #! The generated options have to be usable, which is what the manifest overlay is for
    private platformActionOptionTest() {
        list<hash<DataProviderActionInfo>> actions = select
            DataProvider::DataProviderActionCatalog::getActions("UnstructuredIo"),
            $1.path =~ /^\/platform/;
        assertTrue(actions.size() >= 35, sprintf("%d platform actions registered", actions.size()));

        # the connection owns the API key; every operation in this API declares it as a parameter,
        # so without the overlay every action would ask the user to type it again
        map assertEq(NOTHING, $1.options{"unstructured-api-key"}, $1.action), actions;

        hash<DataProviderActionInfo> create_source =
            (select actions, $1.action == "create-source")[0];
        # the connector type is written as anyOf [enum, string], which loses the enum's values
        assertTrue(create_source.options.type.allowed_values.size() >= 25);
        assertTrue(create_source.options.type.allowed_values_creatable);
        map assertTrue($1.display_name.val(), $1.value),
            create_source.options.type.allowed_values;
        assertTrue(create_source.options.config.sensitive);

        # the job listing declares status as a bare string although JobStatus exists
        hash<DataProviderActionInfo> list_jobs = (select actions, $1.action == "list-jobs")[0];
        assertEq(("SCHEDULED", "IN_PROGRESS", "COMPLETED", "STOPPED", "FAILED", "REJECTED"),
            (map $1.value, list_jobs.options.status.allowed_values));
        # ... and identifies its workflow with a dropdown rather than asking for a UUID
        assertEq(UnstructuredPlatformManifest::RefWorkflow, list_jobs.options.workflow_id.ref_data);

        # every action that names another object offers a dropdown for it
        foreach hash<DataProviderActionInfo> a in (actions) {
            foreach hash<auto> o in ((a.options ?? {}).pairIterator()) {
                if (o.key =~ /^(source_id|destination_id|workflow_id|template_id|channel_id|job_id)$/) {
                    assertTrue(o.value.ref_data.val(),
                        sprintf("%s.%s offers a dropdown", a.action, o.key));
                }
            }
        }

        # a list-valued field enumerates its ELEMENTS: "allowed_values" here would make each event a
        # one-element list, and a two-event subscription a list of lists
        hash<DataProviderActionInfo> upd =
            (select actions, $1.action == "update-notification-channel")[0];
        hash<auto> ev = upd.options.event_types;
        assertEq(NOTHING, ev.allowed_values);
        assertEq(("job.scheduled", "job.in_progress", "job.progress", "job.completed",
            "job.stopped", "job.failed"), (map $1.value, ev.element_allowed_values));
        map assertEq(NT_STRING, $1.value.typeCode(), sprintf("%y is a string, not a list", $1.value)),
            ev.element_allowed_values;
        map assertTrue($1.display_name.val(), $1.value), ev.element_allowed_values;
        assertTrue(ev.element_allowed_values_creatable);

        # a signing secret is a credential wherever it is typed: the create action supplies the whole
        # channel as a discriminated union, and the webhook alternative's secret must be masked there
        # just as the update action's own copy is
        hash<DataProviderActionInfo> cr =
            (select actions, $1.action == "create-notification-channel")[0];
        assertTrue(upd.options.secret.sensitive);
        list<AbstractDataProviderType> branches =
            cast<QoreUnionDataType>(cr.options.body.type).getUnionTypes();
        assertEq(2, branches.size());
        hash<string, AbstractDataField> webhook = branches[0].getFields();
        assertEq("Signing Secret", webhook.secret.getDisplayName());
        assertTrue(webhook.secret.getAttributes().sensitive);
        # the email alternative declares no secret, so nothing there was disturbed
        assertEq(NOTHING, branches[1].getFields().url);
        assertTrue(exists branches[1].getFields().email_config);

        # the file and node of a download come from the chosen job's own output listing, so both are
        # dropdowns scoped by it rather than UUIDs to be found elsewhere
        hash<DataProviderActionInfo> dl = (select actions, $1.action == "download-job-output")[0];
        assertEq(UnstructuredPlatformManifest::RefJob, dl.options.job_id.ref_data);
        assertEq(UnstructuredPlatformManifest::RefJobOutputFile, dl.options.file_id.ref_data);
        assertEq(UnstructuredPlatformManifest::RefJobOutputNode, dl.options.node_id.ref_data);
        assertEq(("job_id",), dl.options.file_id.depends_on);
        assertEq(("job_id",), dl.options.node_id.depends_on);

        # both are backed by get-job, which is what actually carries output_node_files
        AbstractDataProvider dlp =
            getPlatformProvider().getChildProviderEx("download-job-output");
        *hash<string, bool> ref = dlp.getSupportedReferenceData();
        map assertTrue(ref{$1}, $1), (UnstructuredPlatformManifest::RefJob,
            UnstructuredPlatformManifest::RefJobOutputFile,
            UnstructuredPlatformManifest::RefJobOutputNode);
        # a scoped dropdown cannot be listed before the option it is scoped by has a value, and
        # listing everything would offer files from other jobs
        assertEq(NOTHING, dlp.getReferenceData(UnstructuredPlatformManifest::RefJobOutputFile));
    }

    #! A schedule offered by a workflow action is one of the API's own, so choosing it sends the request
    private platformScheduleTest() {
        hash<string, hash<auto>> requests = {
            "create-workflow": {"name": "wf", "workflow_type": "basic"},
            "update-workflow": {"workflow_id": "00000000-0000-4000-8000-000000000001"},
        };
        foreach hash<auto> request in (requests.pairIterator()) {
            hash<auto> option = DataProviderActionCatalog::getAppActionEx("UnstructuredIo", request.key)
                .options.schedule;
            # the create action offers a reviewed choice of schedules; the update action publishes none, as
            # its nullable enumeration is not published as choices, but its type enforces the schema's
            list<auto> schedules = option.allowed_values
                ? (map $1.value, option.allowed_values)
                : option.type.getConstraints().enum_values;
            assertEq(request.key == "create-workflow" ? 6 : 11, schedules.size(), request.key);
            foreach string schedule in (schedules) {
                string ctx = sprintf("%s: %y", request.key, schedule);
                FakeUnstructuredPlatformRestClientIo fake();
                AbstractDataProvider prov = new UnstructuredDataProvider::UnstructuredPlatformDataProvider(fake)
                    .getChildProviderEx(request.key);
                assertThrows("TEST-REQUEST-SENT", \prov.doRequest(), request.value + {"schedule": schedule}, ctx);
                assertEq(schedule, fake.last_request.schedule, ctx);
            }
        }
        # the labels of the create action's own choices name the API's values
        hash<string, string> labels = map {$1.display_name: $1.value},
            DataProviderActionCatalog::getAppActionEx("UnstructuredIo", "create-workflow").options.schedule
                .allowed_values;
        assertEq("daily", labels.Daily);
        assertEq("weekly", labels.Weekly);
        assertEq("monthly", labels.Monthly);
    }

    private platformRecordTableTest() {
        AbstractDataProvider tables = getPlatformProvider().getChildProviderEx("tables");
        assertEq(("destinations", "jobs", "sources", "workflows"),
            sort(tables.getChildProviderNames()));

        AbstractDataProvider wf = tables.getChildProviderEx("workflows");
        hash<DataProviderInfo> i = wf.getInfo();
        map assertTrue(i{$1}, $1),
            ("supports_read", "supports_create", "supports_update", "supports_delete");
        # the Platform API has no filter-expression language, only query arguments
        assertFalse(i.supports_native_search,
            "no table may claim native search: where_cond would never reach the server");
        map assertTrue(exists wf.getRecordType(){$1}, $1),
            ("id", "name", "status", "sources", "destinations", "created_at");

        # a job is started by running a workflow, never by writing a record
        hash<DataProviderInfo> ji = tables.getChildProviderEx("jobs").getInfo();
        assertTrue(ji.supports_read);
        map assertFalse(ji{$1}, $1), ("supports_create", "supports_update", "supports_delete");
    }

    private platformEventTest() {
        AbstractDataProvider events = getPlatformProvider().getChildProviderEx("events");
        assertEq(("job-finished",), events.getChildProviderNames());

        AbstractDataProvider jw = events.getChildProviderEx("job-finished");
        assertTrue(jw.getInfo().supports_observable);
        hash<string, hash<DataProviderMessageInfo>> types = jw.getEventTypes();
        assertEq(("job-finished",), keys types);
        assertEq("UnstructuredJobEvent", types."job-finished".type.getName());
        map assertTrue(exists types."job-finished".type.getFields(){$1}, $1),
            ("id", "workflow_id", "workflow_name", "status", "created_at");

        # the example must be real data shaped like the event, not an empty stub
        auto example = jw.getExampleEventData("job-finished");
        assertTrue(example.id.val());
        assertTrue(UnstructuredJobWatchDataProvider::TerminalStatuses{example.status},
            sprintf("example status %y is terminal", example.status));

        # the trigger is configurable from the action form
        hash<DataProviderActionInfo> a = (select
            DataProvider::DataProviderActionCatalog::getActions("UnstructuredIo"),
            $1.action == "job-finished")[0];
        assertEq(DPAT_EVENT, a.action_code);
        assertEq(UnstructuredPlatformManifest::RefWorkflow, a.options.workflow_id.ref_data);
        assertEq(UnstructuredJobWatchDataProvider::DefaultPollInterval,
            a.options.poll_interval.default_value);
    }

    #! Unstructured types a connector config as a union over one schema per connector type
    private connectorFieldsTest() {
        AbstractDataProvider cf = getPlatformProvider().getChildProviderEx("connector-fields");

        # this action answers from the pinned document and makes no request
        auto r = cf.doRequest({"connector_type": "s3", "direction": "source"});
        assertEq("s3", r.connector_type);
        assertEq("S3SourceConnectorConfigInput", r.schema);
        hash<string, hash<auto>> by_name = map {$1.name: $1}, r.fields;
        assertEq("softstring", by_name.remote_url.type);
        assertTrue(by_name.remote_url.required);
        assertFalse(by_name.recursive.required);

        # the same type in the other direction is a different schema with different settings
        auto d = cf.doRequest({"connector_type": "s3", "direction": "destination"});
        assertEq("S3DestinationConnectorConfigInput", d.schema);
        assertTrue(exists (map {$1.name: True}, d.fields).remote_url);
        assertFalse(exists (map {$1.name: True}, d.fields).recursive);

        # a type whose schema is not named after it still resolves
        assertEq("KafkaCloudSourceConnectorConfigInput",
            cf.doRequest({"connector_type": "kafka-cloud", "direction": "source"}).schema);
        assertEq("QdrantCloudDestinationConnectorConfigInput",
            cf.doRequest({"connector_type": "qdrant-cloud", "direction": "destination"}).schema);

        # the type lists are the schema's own enums, so they must match it exactly - a value that
        # is not in the enum would be rejected by the API, and a missing one hides a real connector
        assertEq(29, UnstructuredPlatformManifest::SourceTypeValues.size());
        assertEq(31, UnstructuredPlatformManifest::DestinationTypeValues.size());

        # Unstructured accepts these but declares no configuration schema for them anywhere in its
        # own API description; the action says so rather than failing, because the connector can
        # still be created - its settings just have to come from Unstructured's documentation
        const hash<string, bool> UndescribedSources = {
            "airtable": True, "github": True, "gitlab": True, "local": True, "sftp": True,
            "vastdb": True,
        };
        const hash<string, bool> UndescribedDestinations = {
            "unstructured_blob_storage": True, "chroma": True, "dropbox": True, "kdbai": True,
            "local": True, "motherduck": True, "sftp": True, "singlestore": True, "vastdb": True,
        };
        foreach hash<AllowedValueInfo> v in (UnstructuredPlatformManifest::SourceTypeValues) {
            auto res = cf.doRequest({"connector_type": v.value, "direction": "source"});
            if (UndescribedSources{v.value}) {
                assertEq(NOTHING, res.schema, sprintf("source %y is undescribed", v.value));
                assertEq((), res.fields, sprintf("source %y has no fields", v.value));
            } else {
                assertTrue(res.fields.size() > 0, sprintf("source %y has fields", v.value));
            }
        }
        foreach hash<AllowedValueInfo> v in (UnstructuredPlatformManifest::DestinationTypeValues) {
            auto res = cf.doRequest({"connector_type": v.value, "direction": "destination"});
            if (UndescribedDestinations{v.value}) {
                assertEq(NOTHING, res.schema, sprintf("destination %y is undescribed", v.value));
            } else {
                assertTrue(res.fields.size() > 0, sprintf("destination %y has fields", v.value));
            }
        }

        # a type the API would reject is an error, not an empty answer
        assertThrows("CONNECTOR-TYPE-ERROR", "not a source connector type", sub () {
            cf.doRequest({"connector_type": "not-a-connector", "direction": "source"});
        });

        # the control offers every type in either direction, so a real type picked with the wrong
        # direction must be named as such rather than reported as unknown
        assertThrows("CONNECTOR-TYPE-ERROR", "is a destination connector type", sub () {
            cf.doRequest({"connector_type": "pinecone", "direction": "source"});
        });
        assertThrows("CONNECTOR-TYPE-ERROR", "is a source connector type", sub () {
            cf.doRequest({"connector_type": "confluence", "direction": "destination"});
        });

        # 17 types exist in both directions; offering the union must not list any of them twice
        list<hash<AllowedValueInfo>> all_types = UnstructuredPlatformManifest::ConnectorTypeValues;
        hash<string, bool> seen;
        foreach hash<AllowedValueInfo> v in (all_types) {
            assertFalse(seen{v.value} ?? False,
                sprintf("connector type %y is listed once", v.value));
            seen{v.value} = True;
        }
        # the union covers both enums and drops only the overlap
        assertEq(43, all_types.size());
        map assertTrue(exists seen{$1.value}, sprintf("source %y is offered", $1.value)),
            UnstructuredPlatformManifest::SourceTypeValues;
        map assertTrue(exists seen{$1.value}, sprintf("destination %y is offered", $1.value)),
            UnstructuredPlatformManifest::DestinationTypeValues;

        # the action's own option carries that list, so the form shows each type once
        hash<DataProviderActionInfo> action = (select
            DataProvider::DataProviderActionCatalog::getActions("UnstructuredIo"),
            $1.action == "get-connector-fields")[0];
        assertEq(all_types.size(), action.options.connector_type.allowed_values.size());
    }

    private liveConnectionTest() {
        AbstractConnection conn = get_connection(conn_name);
        assertEq("unstructured", conn.getType());
        assertTrue(conn.hasDataProvider());

        hash<auto> ping = conn.ping(True);
        assertTrue(ping.ok, sprintf("Unstructured connection ping failed: %s",
            ping.info ?? "no info"));

        AbstractDataProvider prov = conn.getDataProvider();
        assertTrue(prov.getChildProviderNames().contains("partition-text"));
    }

    #! Exercises Unstructured's live multipart upload + partition lifecycle
    /** Verifies the actual wire format against Unstructured's production API using a tiny text
        snippet.  Unstructured Serverless free tier: 1000 pages/month.
    */
    private livePartitionTextTest() {
        AbstractConnection conn = get_connection(conn_name);
        AbstractDataProvider prov = conn.getDataProvider();
        AbstractDataProvider pt = prov.getChildProviderEx("partition-text");
        auto resp = pt.doRequest({
            "text": "Section One\n\nHello world, this is a test document.",
            "strategy": "fast",
        });
        assertTrue(resp.elt_list.size() >= 1, "Unstructured returned at least one element");
        assertTrue(resp.elt_list[0].type.val(), "Unstructured element has a type");
        assertTrue(resp.elt_list[0].text.val(), "Unstructured element has text");

        # content_type decides how the text is parsed.  Submitted as plain text, HTML is not
        # parsed at all and returns as one element holding the raw markup
        string html = "<html><body><h1>Heading</h1><p>Some narrative text here.</p>"
            "<ul><li>bullet one</li><li>bullet two</li></ul></body></html>";
        auto plain = pt.doRequest({"text": html, "strategy": "fast"});
        assertEq(1, plain.elt_list.size());
        assertTrue(plain.elt_list[0].text =~ /<h1>/, "plain text keeps the raw markup");

        auto parsed = pt.doRequest({
            "text": html,
            "content_type": MimeTypeHtml,
            "strategy": "fast",
        });
        assertTrue(parsed.elt_list.size() > plain.elt_list.size(),
            sprintf("HTML yielded %d elements, plain text %d",
                parsed.elt_list.size(), plain.elt_list.size()));
        assertEq("Title", parsed.elt_list[0]."type");
        assertEq("Heading", parsed.elt_list[0].text);
        assertEq(("ListItem", "ListItem"),
            (map $1."type", (select parsed.elt_list, $1."type" == "ListItem")));
    }

    #! Creates a connector pair and a workflow, then removes them again
    /** Everything created here is named with a per-run tag and deleted in an \c on_exit block, so a
        failure part-way through does not leave objects behind in the account.
    */
    private livePlatformLifecycleTest() {
        AbstractConnection conn = get_connection(conn_name);
        AbstractDataProvider plat = conn.getDataProvider().getChildProviderEx("platform");

        string tag = "qore-qtest-" + get_random_string(6, 3).lwr();
        *string source_id;
        *string dest_id;
        *string workflow_id;

        on_exit {
            # deleted innermost-first: a workflow references its connectors
            if (workflow_id) {
                try {
                    plat.getChildProviderEx("delete-workflow").doRequest(
                        {"workflow_id": workflow_id});
                } catch (hash<ExceptionInfo> ex) {
                    printf("WARNING: could not delete workflow %y: %s: %s\n", workflow_id, ex.err,
                        ex.desc);
                }
            }
            foreach hash<auto> c in ((
                ("action": "delete-destination", "opt": "destination_id", "id": dest_id),
                ("action": "delete-source", "opt": "source_id", "id": source_id),
            )) {
                if (!c.id) {
                    continue;
                }
                try {
                    plat.getChildProviderEx(c.action).doRequest({c.opt: c.id});
                } catch (hash<ExceptionInfo> ex) {
                    printf("WARNING: could not run %y for %y: %s: %s\n", c.action, c.id, ex.err,
                        ex.desc);
                }
            }
        }

        # the settings sent here are the ones connector-fields says an S3 source takes
        auto src_res = plat.getChildProviderEx("create-source").doRequest({
            "name": tag + "-src",
            "type": "s3",
            "config": {
                "remote_url": "s3://qore-unstructured-test/docs",
                "anonymous": True,
                "recursive": True,
            },
        });
        source_id = src_res.id;
        assertTrue(source_id.val());
        assertEq(tag + "-src", src_res.name);
        assertEq("s3", src_res.type);
        assertEq("s3://qore-unstructured-test/docs", src_res.config.remote_url);

        auto dst_res = plat.getChildProviderEx("create-destination").doRequest({
            "name": tag + "-dst",
            "type": "s3",
            "config": {"remote_url": "s3://qore-unstructured-test/out", "anonymous": True},
        });
        dest_id = dst_res.id;
        assertTrue(dest_id.val());
        assertEq("s3", dst_res.type);

        # the dropdowns are backed by these listings, so they must now see what was just created
        AbstractDataProvider create_wf = plat.getChildProviderEx("create-workflow");
        list<hash<AllowedValueInfo>> sources =
            create_wf.getReferenceData(UnstructuredPlatformManifest::RefSource);
        assertTrue((select sources, $1.value == source_id).size() == 1,
            "the source dropdown lists the connector just created");
        list<hash<AllowedValueInfo>> dests =
            create_wf.getReferenceData(UnstructuredPlatformManifest::RefDestination);
        assertTrue((select dests, $1.value == dest_id).size() == 1,
            "the destination dropdown lists the connector just created");

        # a read of one connector returns what the listing said
        auto got = plat.getChildProviderEx("get-source").doRequest({"source_id": source_id});
        assertEq(tag + "-src", got.name);

        # ... and the type filter really narrows server-side
        auto filtered = plat.getChildProviderEx("list-sources").doRequest({"source_type": "s3"});
        assertTrue((select filtered, $1.id == source_id).size() == 1);

        auto wf = create_wf.doRequest({
            "name": tag + "-wf",
            "workflow_type": "basic",
            "source_id": source_id,
            "destination_id": dest_id,
        });
        workflow_id = wf.id;
        assertTrue(workflow_id.val());
        assertEq(tag + "-wf", wf.name);
        # "basic" is a preset chain, so Unstructured fills the nodes in
        assertTrue(wf.workflow_nodes.size() > 0, "the preset workflow type built a node chain");
        assertEq("active", wf.status);

        # the listing filters on the connectors a workflow uses
        auto by_source = plat.getChildProviderEx("list-workflows").doRequest(
            {"source_id": source_id});
        assertTrue((select by_source, $1.id == workflow_id).size() == 1);

        # deactivating stops it running on its schedule without deleting it
        auto updated = plat.getChildProviderEx("update-workflow").doRequest({
            "workflow_id": workflow_id,
            "state": "inactive",
        });
        assertEq("inactive", updated.status);

        # a workflow that has never run has no jobs; the API answers an empty result with no body
        # at all rather than an empty list
        auto jobs = plat.getChildProviderEx("list-jobs").doRequest({"workflow_id": workflow_id});
        assertEq(0, jobs.size());
    }

    #! Reads every record table against the live account
    private livePlatformTableTest() {
        AbstractConnection conn = get_connection(conn_name);
        AbstractDataProvider tables =
            conn.getDataProvider().getChildProviderEx("platform").getChildProviderEx("tables");

        foreach string name in (tables.getChildProviderNames()) {
            AbstractDataProvider t = tables.getChildProviderEx(name);
            int n = 0;
            AbstractDataProviderRecordIterator i = t.searchRecords();
            while (i.next()) {
                ++n;
                # a record must match the declared record type, or mappers built on it break
                map assertTrue(exists t.getRecordType(){$1.key}, sprintf("%s.%s", name, $1.key)),
                    i.getValue().pairIterator();
            }
            assertTrue(n >= 0, sprintf("%s read %d record(s)", name, n));
        }
    }

    #! Exercises the action that matters most: a real binary document
    private livePartitionFileTest() {
        AbstractConnection conn = get_connection(conn_name);
        AbstractDataProvider pf = conn.getDataProvider().getChildProviderEx("partition-file");

        TmpFile tmp("unstructured-", ".pdf");
        File f();
        f.open2(tmp.path, O_WRONLY | O_TRUNC);
        f.write(parse_base64_string(TestPdfBase64));
        f.close();

        auto resp = pf.doRequest({
            "file_path": tmp.path,
            "content_type": MimeTypePdf,
            "strategy": "fast",
        });
        assertTrue(resp.elt_list.size() >= 2,
            sprintf("Unstructured returned %d elements from the PDF", resp.elt_list.size()));
        assertEq("Title", resp.elt_list[0]."type");
        assertEq("Quarterly Report", resp.elt_list[0].text);
        # typed metadata carries the page and source file
        assertEq(1, resp.elt_list[0].metadata.page_number);
        assertEq(basename(tmp.path), resp.elt_list[0].metadata.filename);

        # the same document supplied inline, with the reported name overridden
        auto inline_resp = pf.doRequest({
            "file_data": ReadOnlyFile::readBinaryFile(tmp.path),
            "filename": "q3.pdf",
            "content_type": MimeTypePdf,
            "strategy": "fast",
        });
        assertEq(resp.elt_list.size(), inline_resp.elt_list.size());
        assertEq("q3.pdf", inline_resp.elt_list[0].metadata.filename);

        # server-side chunking returns composite chunks instead of the raw element tree
        auto chunked = pf.doRequest({
            "file_path": tmp.path,
            "content_type": MimeTypePdf,
            "strategy": "fast",
            "chunking_strategy": "basic",
            "max_characters": 2000,
        });
        assertEq("CompositeElement", chunked.elt_list[0]."type");
        assertTrue(chunked.elt_list.size() <= resp.elt_list.size());
    }
}
