#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%allow-injection

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/ConnectionProvider
%requires ../../../../qlib/DataProvider
%requires ../../../../qlib/MilvusDataProvider

%exec-class MilvusDataProviderTest

class FakeMilvusRestClientIo inherits RestClientIo::RestClientIo {
    public {
        string last_method;
        string last_path;
        *hash<auto> last_body;
        hash<auto> response_body;
    }
    constructor() : RestClientIo({"url": "http://localhost:19530"}) {}

    hash<RestClient::RestResponseInfo> restPost(string path, auto body, *hash<auto> hdr) {
        last_method = "POST";
        last_path = path;
        last_body = body;
        return <RestClient::RestResponseInfo>{"body": response_body};
    }
    string getSafeUrl() { return "http://localhost:19530"; }
}

public class MilvusDataProviderTest inherits QUnit::Test {
    public {
        const MyOpts = Opts + {
            "conn": "c,connection=s",
        };

        const OptionColumn = 22;
    }

    private {
        *string conn_name;
    }

    constructor() : Test("MilvusDataProvider Test", "1.0", \ARGV, MyOpts) {
        conn_name = m_options.conn ?? ENV.MILVUS_CONNECTION;

        addTestCase("factory + app + action registered", \registrationTest());
        addTestCase("list-collections hits /collections/list",
            \listCollectionsTest());

        # Live test requires a real Milvus connection AND a
        # `MILVUS_COLLECTION` env var naming an existing collection.
        # The MilvusDataProvider currently exposes a control-plane
        # `list-collections` action; the live test verifies that the
        # named collection appears in the response.
        # Cost: Free (self-hostable).
        if (conn_name) {
            addTestCase("live: ping + list-collections (verifies existing collection)",
                \liveMilvusTest());
        }
        set_return_value(main());
    }

    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-c,--connection=ARG",
            "set the Milvus connection name; without it (and without the "
            "MILVUS_CONNECTION env var) the live test is skipped.  Also "
            "requires MILVUS_COLLECTION naming an existing collection.",
            OptionColumn);
    }

    private registrationTest() {
        DataProvider::AbstractDataProviderFactory f =
            DataProvider::DataProvider::getFactory("milvus");
        assertEq("milvus", f.getInfo().name);
        hash<DataProviderAppInfo> app =
            DataProvider::DataProviderActionCatalog::getApp("Milvus");
        assertEq("Milvus", app.name);
        assertEq("milvus", app.scheme);
        # filter out the framework-injected make-api-call action (covered by
        # GenericApiCallAutoInjection.qtest in RestClientDataProvider)
        list<hash<DataProviderActionInfo>> actions = select
            DataProvider::DataProviderActionCatalog::getActions("Milvus"),
            $1.action != AbstractDataProvider::GenericApiCallActionName;
        assertEq(1, actions.size());
        assertEq("list-collections", actions[0].action);
    }

    private listCollectionsTest() {
        FakeMilvusRestClientIo fake();
        fake.response_body = {
            "code": 0,
            "data": ("vectors", "docs", "embeddings"),
        };
        MilvusDataProvider::MilvusListCollectionsDataProvider prov(fake);
        auto resp = prov.doRequest(NOTHING);
        assertEq("POST", fake.last_method);
        assertEq("/collections/list", fake.last_path);
        assertEq(3, resp.data.size());
        assertEq("vectors", resp.data[0]);
    }

    #! Exercises Milvus's live `/collections/list` endpoint
    /** Verifies the actual wire format against a running Milvus server.
        Requires both a connection name AND a `MILVUS_COLLECTION` env
        var naming an existing collection; the test asserts that the
        named collection appears in the response.

        Cost: Free (self-hostable).
    */
    private liveMilvusTest() {
        *string coll_name = ENV.MILVUS_COLLECTION;
        if (!coll_name.val()) {
            testSkip("MILVUS_COLLECTION env var must name an existing "
                "Milvus collection");
        }

        AbstractConnection conn = get_connection(conn_name);
        hash<auto> ping = conn.ping(True);
        assertTrue(ping.ok, sprintf("Milvus connection ping failed: %s",
            ping.info ?? "no info"));

        AbstractDataProvider prov = conn.getDataProvider();
        AbstractDataProvider lc = prov.getChildProvider("list-collections");
        auto resp = lc.doRequest(NOTHING);
        # Milvus 2.4+ wraps the collection-name list in `data`
        assertTrue(exists resp.data,
            "Milvus list-collections returned a data field");
        bool found = inlist(coll_name, resp.data ?? ());
        assertTrue(found, sprintf("MILVUS_COLLECTION %y was found in the "
            "list-collections response", coll_name));
    }
}
