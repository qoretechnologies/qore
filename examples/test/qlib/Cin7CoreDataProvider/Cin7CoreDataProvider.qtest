    #! Test products provider
    private testProductsProvider() {
        if (m_options.verbose) {
            printf("\n--- Testing Products Provider ---\n");
        }

        Cin7CoreDataProvider::Cin7CoreDataProvider prov(client);

        # Get products provider
        AbstractDataProvider productsProvider = prov.getChildProvider("products");
        hash<DataProviderInfo> info = productsProvider.getInfo();

        assertTrue(info.supports_read, "Products should support read");
