                printf("  Sample product: ID=%y, SKU=%y, Name=%y\n",
                    product.ID, product.SKU ?? "N/A", product.Name ?? "N/A");
            }
        }

        if (m_options.verbose) {
            printf("--- Products Provider tests completed ---\n");
        }
    }

    #! Test sales provider
    private testSalesProvider() {
        if (m_options.verbose) {
            printf("\n--- Testing Sales Provider ---\n");
        }

        Cin7CoreDataProvider::Cin7CoreDataProvider prov(client);

        # Get sales provider
        AbstractDataProvider salesProvider = prov.getChildProvider("sales");
        hash<DataProviderInfo> info = salesProvider.getInfo();

        assertTrue(info.supports_read, "Sales should support read");
        assertTrue(info.supports_native_search, "Sales should support native search");
        assertTrue(info.has_record, "Sales should have record type");

        # Verify search options exist
        assertTrue(info.search_options.hasKey("SaleID"), "Should have SaleID search option");
        assertTrue(info.search_options.hasKey("Status"), "Should have Status search option");
        assertTrue(info.search_options.hasKey("ModifiedSince"), "Should have ModifiedSince search option");
        assertTrue(info.search_options.hasKey("Page"), "Should have Page search option");
        assertTrue(info.search_options.hasKey("Limit"), "Should have Limit search option");

        # Fetch some sales (limited)
        hash<auto> searchOpts = {"Limit": 5};
        list<hash<auto>> sales = map $1, salesProvider.searchRecords(NOTHING, searchOpts);

        if (m_options.verbose) {
            printf("  Found %d sales (limited to 5)\n", sales.size());
        }

        if (sales.size() > 0) {
            # Verify sale record structure
            hash<auto> sale = sales[0];
            assertTrue(sale.hasKey("SaleID") || sale.hasKey("ID"), "Sale should have SaleID or ID");
            if (m_options.verbose) {
                printf("  Sample sale: ID=%y, OrderNumber=%y, Status=%y\n",
                    sale.SaleID ?? sale.ID, sale.SaleOrderNumber ?? "N/A",
                    sale.Status ?? "N/A");
            }
        }

        if (m_options.verbose) {
            printf("--- Sales Provider tests completed ---\n");
        }
    }

    #! Test customer data integrity - verifies data actually persists
    /** CRITICAL: This test verifies that customer data is correctly saved and retrievable.
        This catches issues like:
        - Wrong Content-Type
        - Silent API acceptance without data persistence
        - Incorrect field handling

        The test creates a customer with known values, retrieves it, and verifies the values match.
    */
    private testCustomerDataIntegrity() {
        if (m_options.verbose) {
            printf("\n--- Testing Customer Data Integrity ---\n");
        }

        Cin7CoreDataProvider::Cin7CoreDataProvider prov(client);

        # Test 1: Create customer
        if (m_options.verbose) {
            printf("\nTest 1: Create customer...\n");
        }

        AbstractDataProvider createCustomerProvider = prov.getChildProvider("create-customer");
        string testName = "Test Customer " + now_us().toString();
        hash<auto> createRequest = {
            "Name": testName,
            "Status": "Active",
            "Currency": "CZK",
            "PaymentTerm": "30 days",
            "TaxRule": "Auto Look Up",
            "AccountReceivable": "1200",
            "RevenueAccount": "4000",
            "Comments": "Test customer created by integration test",
        };

        try {
            auto createResult = createCustomerProvider.doRequest(createRequest);
            if (m_options.verbose) {
                printf("  Create result: ID=%y\n", createResult.ID);
            }
            assertTrue(exists createResult.ID, "Customer should be created with an ID");
            testCustomerId = createResult.ID;

            # Verify the data was actually saved by fetching it back
            AbstractDataProvider getCustomerProvider = prov.getChildProvider("get-customer");
            hash<auto> getRequest = {
                "ID": testCustomerId,
            };

            auto fetchedCustomer = getCustomerProvider.doRequest(getRequest);
            if (m_options.verbose) {
                printf("  Fetched customer: ID=%y, Name=%y\n",
                    fetchedCustomer.ID, fetchedCustomer.Name);
            }

            assertEq(testCustomerId, fetchedCustomer.ID, "Customer ID should match");
            assertEq(testName, fetchedCustomer.Name, "Customer Name should match");
            assertEq("Active", fetchedCustomer.Status, "Customer Status should match");
            assertEq("CZK", fetchedCustomer.Currency, "Customer Currency should match");

            if (m_options.verbose) {
                printf("  Data integrity verified: customer saved and retrieved correctly\n");
            }

            # Test 2: Update customer
            if (m_options.verbose) {
                printf("\nTest 2: Update customer...\n");
            }

            AbstractDataProvider updateCustomerProvider = prov.getChildProvider("update-customer");
            string updatedName = "Updated Test Customer " + now_us().toString();
            hash<auto> updateRequest = {
                "ID": testCustomerId,
                "Name": updatedName,
                "Comments": "Updated by integration test",
            };

            auto updateResult = updateCustomerProvider.doRequest(updateRequest);
            if (m_options.verbose) {
                printf("  Update result: ID=%y, Name=%y\n", updateResult.ID, updateResult.Name);
            }

            # Verify the update
            auto updatedCustomer = getCustomerProvider.doRequest(getRequest);
            assertEq(updatedName, updatedCustomer.Name, "Customer Name should be updated");

            if (m_options.verbose) {
                printf("  Update verified: customer updated correctly\n");
            }

        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("  Customer test failed: %s: %s\n", ex.err, ex.desc);
            }
            rethrow;
        }

        if (m_options.verbose) {
            printf("--- Customer Data Integrity tests completed ---\n");
        }
    }

    #! Test make-api-call action
    private testMakeApiCall() {
        if (m_options.verbose) {
            printf("\n--- Testing Make API Call Action ---\n");
        }

        Cin7CoreDataProvider::Cin7CoreDataProvider prov(client);

        AbstractDataProvider makeApiCallProvider = prov.getChildProvider("make-api-call");

        # Test GET request to customers endpoint
        auto result = makeApiCallProvider.doRequest({
            "method": "GET",
            "path": "/Customer",
            "query_params": {"Page": 1, "Limit": 1},
        });

        assertTrue(result.hasKey("body"), "make-api-call should return body");
        assertTrue(result.body.typeCode() == NT_HASH,
            "make-api-call response body should be hash");
        if (m_options.verbose) {
            printf("  GET /Customer returned hash with %d key(s)\n",
                elements keys result.body);
        }

        # Test with /me endpoint
        auto meResult = makeApiCallProvider.doRequest({
            "method": "GET",
            "path": "/me",
        });

        assertTrue(meResult.hasKey("body"), "make-api-call /me should return body");
        if (m_options.verbose) {
            printf("  GET /me returned successfully\n");
        }

        if (m_options.verbose) {
            printf("--- Make API Call tests completed ---\n");
        }
    }

    #! Polling trigger tests
    pollingTriggerTests() {
        checkJson();
        if (!client) {
            testSkip("No Cin7Core credentials provided");
            return;
        }

        if (m_options.verbose) {
            printf("\n--- Testing Polling Trigger Providers ---\n");
        }

        # ============================================
        # Test New Payment Watch Provider
        # ============================================
        if (m_options.verbose) {
            printf("\nTesting Cin7CoreNewPaymentWatchDataProvider...\n");
        }

        Cin7CoreDataProvider::Cin7CoreNewPaymentWatchDataProvider paymentProv(client, {});
        assertEq("new-payment", paymentProv.getName());

        # Verify provider metadata
        assertTrue(paymentProv.getInfo().supports_observable);

        # Test event types
        hash<string, hash<DataProviderMessageInfo>> paymentEventTypes = paymentProv.getEventTypes();
        assertTrue(paymentEventTypes.hasKey("new-payment"));
        assertTrue(paymentEventTypes{"new-payment"}.desc.val());
        # Verify event type uses custom data type
        assertEq("Cin7CoreSalePaymentDataType", paymentEventTypes{"new-payment"}.type.getName(),
            "new-payment event should use Cin7CoreSalePaymentDataType");

        if (m_options.verbose) {
            printf("  Event types: %y\n", keys paymentEventTypes);
        }

        # ============================================
        # Test Customer Updated Watch Provider
        # ============================================
        if (m_options.verbose) {
            printf("\nTesting Cin7CoreCustomerUpdatedWatchDataProvider...\n");
        }

        Cin7CoreDataProvider::Cin7CoreCustomerUpdatedWatchDataProvider customerProv(client, {});
        assertEq("customer-updated", customerProv.getName());
        assertTrue(customerProv.getInfo().supports_observable);

        hash<string, hash<DataProviderMessageInfo>> customerEventTypes = customerProv.getEventTypes();
        assertTrue(customerEventTypes.hasKey("customer-updated"));
        # Verify event type uses custom data type
