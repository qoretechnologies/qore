%require-types
%enable-all-warnings
%new-style
%strict-args

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/DataProvider
%requires ../../../../qlib/ConnectionProvider
%requires ../../../../qlib/RestClient.qm
%requires ../../../../qlib/Mime.qm

%try-module json
%define NoJson
%endtry

%requires ../../../../qlib/Cin7CoreRestClient.qm
%requires ../../../../qlib/Cin7CoreDataProvider

%exec-class Cin7CoreDataProviderTest

public class Cin7CoreDataProviderTest inherits QUnit::Test {
    private {
        #! Cin7Core REST client for integration tests
        *Cin7CoreRestClient::Cin7CoreRestClient client;

        #! Logger for verbose output
        Logger logger;

        #! Custom command-line options
        const MyOpts = Opts + {
            "account_id": "a,account-id=s",
            "apikey": "k,apikey=s",
            "conn": "c,connection=s",
        };

        #! Test customer ID created during tests (for verification)
        *string testCustomerId;

        #! Test sale ID created during tests (for verification)
        *string testSaleId;
    }

    constructor() : Test("Cin7CoreDataProvider Test", "1.0", \ARGV, MyOpts) {
        logger = new Logger("test", LoggerLevel::getLevelInfo());

        # Unit tests (always run, no credentials needed)
        addTestCase("sanity tests", \sanityTests());
        addTestCase("factory tests", \factoryTests());
        addTestCase("metadata tests", \metadataTests());
        addTestCase("child provider tests", \childProviderTests());
        addTestCase("data type tests", \dataTypeTests());
        addTestCase("negative tests", \negativeTests());
        addTestCase("corner case tests", \cornerCaseTests());
        addTestCase("connection tests", \connectionTests());
        addTestCase("action catalog tests", \actionCatalogTests());

        # Integration tests (require CIN7CORE_ACCOUNT_ID and CIN7CORE_API_KEY)
        addTestCase("integration tests", \integrationTests());

        # Polling trigger tests
        addTestCase("polling trigger tests", \pollingTriggerTests());

        # Try to set up connection for integration tests
        try {
            setupConnection();
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("Connection setup failed: %s: %s\n", ex.err, ex.desc);
            }
        }

        set_return_value(main());
    }

    #! Sets up the Cin7Core client for integration tests
    private setupConnection() {
        *string account_id = m_options.account_id ?? ENV.CIN7CORE_ACCOUNT_ID;
        *string apikey = m_options.apikey ?? ENV.CIN7CORE_API_KEY;
        if (!account_id || !apikey) {
            if (m_options.verbose) {
                printf("No API credentials provided (use -a and -k options or CIN7CORE_ACCOUNT_ID "
                    "and CIN7CORE_API_KEY env vars)\n");
            }
            return;
        }
        hash<auto> opts = {
            "account_id": account_id,
            "apikey": apikey,
        };
        client = new Cin7CoreRestClient::Cin7CoreRestClient(opts);
    }

    #! Check if json module is available
    private checkJson() {
%ifdef NoJson
        testSkip("no json module present");
%endif
    }

    #! Basic sanity tests - provider instantiation
    sanityTests() {
        checkJson();
        # Test creating provider with fake credentials
        Cin7CoreDataProvider::Cin7CoreDataProvider prov({
            "account_id": "fake-account-id",
            "apikey": "fake-key-for-testing",
        });
        assertEq("cin7core", prov.getName());
        assertEq("Cin7Core data provider for inventory management, sales, and order processing", prov.getDesc());
    }

    #! Factory tests - verify factory registration
    factoryTests() {
        checkJson();
        # Verify factory is registered
        AbstractDataProviderFactory factory = DataProvider::getFactory("cin7core");
        assertEq("cin7core", factory.getInfo().name);
        assertTrue(factory.getInfo().children_can_support_apis);
        assertTrue(factory.getInfo().children_can_support_records);

        # Verify factory can create provider with options
        hash<auto> factoryOpts = factory.getInfo().provider_info.constructor_options;
        assertTrue(factoryOpts.hasKey("account_id"));
        assertTrue(factoryOpts.hasKey("apikey"));
        assertTrue(factoryOpts.hasKey("cin7corerestclient"));
    }

    #! Metadata tests - verify provider info structure
    metadataTests() {
        checkJson();
        Cin7CoreDataProvider::Cin7CoreDataProvider prov({
            "account_id": "x",
            "apikey": "x",
        });
        hash<DataProviderInfo> info = prov.getInfo();

        assertTrue(info.supports_children);
        assertTrue(info.children_can_support_apis);
        assertTrue(info.children_can_support_records);
        assertEq("Cin7CoreDataProvider", info.type);

        # Check constructor options
        assertTrue(info.constructor_options.hasKey("account_id"));
        assertTrue(info.constructor_options.hasKey("apikey"));
        assertTrue(info.constructor_options.hasKey("cin7corerestclient"));

        # Check supported reference data types
        *hash<string, bool> refData = prov.getSupportedReferenceData();
        assertTrue(refData.hasKey("customers"), "Should support customers ref_data");
        assertTrue(refData.hasKey("suppliers"), "Should support suppliers ref_data");
        assertTrue(refData.hasKey("products"), "Should support products ref_data");
        assertTrue(refData.hasKey("sales"), "Should support sales ref_data");
    }

    #! Child provider tests - verify hierarchy
    childProviderTests() {
        checkJson();
        Cin7CoreDataProvider::Cin7CoreDataProvider prov({
            "account_id": "x",
            "apikey": "x",
        });

        # Check child provider names
        list<string> children = prov.getChildProviderNames();

        # Collection providers (DPAT_FIND)
        assertTrue(children.contains("customers"));
        assertTrue(children.contains("suppliers"));
        assertTrue(children.contains("products"));
        assertTrue(children.contains("sales"));
        assertTrue(children.contains("sale-payments"));
        assertTrue(children.contains("stock-adjustments"));

        # Action providers (DPAT_API)
        assertTrue(children.contains("create-customer"));
        assertTrue(children.contains("get-customer"));
        assertTrue(children.contains("update-customer"));
        assertTrue(children.contains("create-supplier"));
        assertTrue(children.contains("get-supplier"));
        assertTrue(children.contains("update-supplier"));
        assertTrue(children.contains("get-product"));
        assertTrue(children.contains("create-sale"));
        assertTrue(children.contains("get-sale"));
        assertTrue(children.contains("update-sale"));
        assertTrue(children.contains("delete-sale"));
        assertTrue(children.contains("make-api-call"));

        # Events provider
        assertTrue(children.contains("events"));

        # Check customers child provider
        AbstractDataProvider customers = prov.getChildProvider("customers");
        assertEq("customers", customers.getName());
        hash<DataProviderInfo> customersInfo = customers.getInfo();
        assertTrue(customersInfo.supports_read);
        assertTrue(customersInfo.supports_native_search);
        assertTrue(customersInfo.has_record);

        # Check create-customer child provider
        AbstractDataProvider createCustomer = prov.getChildProvider("create-customer");
        assertEq("create-customer", createCustomer.getName());
        hash<DataProviderInfo> createCustomerInfo = createCustomer.getInfo();
        assertTrue(createCustomerInfo.supports_request);

        # Check events child provider
        AbstractDataProvider events = prov.getChildProvider("events");
        assertEq("events", events.getName());
        hash<DataProviderInfo> eventsInfo = events.getInfo();
        assertTrue(eventsInfo.supports_children);
        assertTrue(eventsInfo.children_can_support_observers);

        # Check events child providers
        list<string> eventChildren = events.getChildProviderNames();
        assertTrue(eventChildren.contains("new-payment"));
        assertTrue(eventChildren.contains("new-sale-credit-note-authorized"));
        assertTrue(eventChildren.contains("new-sale-invoice-authorized"));
        assertTrue(eventChildren.contains("sale-tracking-changed"));
        assertTrue(eventChildren.contains("sale-voided"));
        assertTrue(eventChildren.contains("stock-level-update"));
        assertTrue(eventChildren.contains("customer-updated"));
        assertTrue(eventChildren.contains("supplier-updated"));
    }

    #! Data type tests - verify record type definitions
    dataTypeTests() {
        checkJson();
        # Test customer data type
        Cin7CoreDataProvider::Cin7CoreCustomerDataType customerType();
        hash<string, AbstractDataField> customerFields = customerType.getFields();
        assertTrue(customerFields.hasKey("ID"));
        assertTrue(customerFields.hasKey("Name"));
        assertTrue(customerFields.hasKey("Status"));
        assertTrue(customerFields.hasKey("Currency"));
        assertTrue(customerFields.hasKey("PaymentTerm"));

        # Test supplier data type
        Cin7CoreDataProvider::Cin7CoreSupplierDataType supplierType();
        hash<string, AbstractDataField> supplierFields = supplierType.getFields();
        assertTrue(supplierFields.hasKey("ID"));
        assertTrue(supplierFields.hasKey("Name"));
        assertTrue(supplierFields.hasKey("Status"));
        assertTrue(supplierFields.hasKey("Currency"));

        # Test product data type
        Cin7CoreDataProvider::Cin7CoreProductDataType productType();
        hash<string, AbstractDataField> productFields = productType.getFields();
        assertTrue(productFields.hasKey("ID"));
        assertTrue(productFields.hasKey("SKU"));
        assertTrue(productFields.hasKey("Name"));
        assertTrue(productFields.hasKey("Category"));
        assertTrue(productFields.hasKey("Brand"));

        # Test sale data type
        Cin7CoreDataProvider::Cin7CoreSaleDataType saleType();
        hash<string, AbstractDataField> saleFields = saleType.getFields();
        assertTrue(saleFields.hasKey("ID"));
        assertTrue(saleFields.hasKey("SaleOrderNumber"));
        assertTrue(saleFields.hasKey("Status"));
        assertTrue(saleFields.hasKey("Customer"));
        assertTrue(saleFields.hasKey("Lines"));

        # Test sale payment data type
        Cin7CoreDataProvider::Cin7CoreSalePaymentDataType paymentType();
        hash<string, AbstractDataField> paymentFields = paymentType.getFields();
        assertTrue(paymentFields.hasKey("ID"));
        assertTrue(paymentFields.hasKey("SaleID"));
        assertTrue(paymentFields.hasKey("Amount"));

        # Test stock adjustment data type
        Cin7CoreDataProvider::Cin7CoreStockAdjustmentDataType stockType();
        hash<string, AbstractDataField> stockFields = stockType.getFields();
        assertTrue(stockFields.hasKey("TaskID"));
        assertTrue(stockFields.hasKey("Location"));
        assertTrue(stockFields.hasKey("Status"));
        assertTrue(stockFields.hasKey("Lines"));

        # Test address data type
        Cin7CoreDataProvider::Cin7CoreAddressDataType addressType();
        hash<string, AbstractDataField> addressFields = addressType.getFields();
        assertTrue(addressFields.hasKey("Line1"));
        assertTrue(addressFields.hasKey("City"));
        assertTrue(addressFields.hasKey("State"));
        assertTrue(addressFields.hasKey("Country"));
        assertTrue(addressFields.hasKey("Postcode"));

        # Test ref_data attributes on get-* action options
        *hash<DataProviderActionInfo> getCustomerAction = DataProviderActionCatalog::getAppAction(
            Cin7CoreDataProvider::AppName, "get-customer");
        assertTrue(exists getCustomerAction, "get-customer action should exist");
        assertTrue(getCustomerAction.options.hasKey("ID"), "get-customer should have ID option");
        assertEq("customers", getCustomerAction.options.ID.ref_data,
            "ID should have ref_data = 'customers'");

        *hash<DataProviderActionInfo> getSaleAction = DataProviderActionCatalog::getAppAction(
            Cin7CoreDataProvider::AppName, "get-sale");
        assertTrue(exists getSaleAction, "get-sale action should exist");
        assertTrue(getSaleAction.options.hasKey("ID"), "get-sale should have ID option");
        assertEq("sales", getSaleAction.options.ID.ref_data,
            "ID should have ref_data = 'sales'");

        *hash<DataProviderActionInfo> getSupplierAction = DataProviderActionCatalog::getAppAction(
            Cin7CoreDataProvider::AppName, "get-supplier");
        assertTrue(exists getSupplierAction, "get-supplier action should exist");
        assertTrue(getSupplierAction.options.hasKey("ID"), "get-supplier should have ID option");
        assertEq("suppliers", getSupplierAction.options.ID.ref_data,
            "ID should have ref_data = 'suppliers'");

        # Test date formatting for Cin7Core API
        # Cin7Core requires dates in ISO 8601 format without timezone: yyyy-MM-ddTHH:mm:ss
        date testDate = 2024-06-15T14:30:45;
        string formattedDate = Cin7CoreDataProvider::Cin7CoreDataProviderBase::formatDate(testDate);
        assertEq("2024-06-15T14:30:45", formattedDate,
            "Date should be formatted as ISO 8601 without timezone");

        # Test with a date at midnight
        date midnightDate = 2024-01-01T00:00:00;
        string formattedMidnight = Cin7CoreDataProvider::Cin7CoreDataProviderBase::formatDate(midnightDate);
        assertEq("2024-01-01T00:00:00", formattedMidnight,
            "Midnight date should be formatted correctly");
    }

    #! Negative tests - test error handling and invalid inputs
    negativeTests() {
        checkJson();
        Cin7CoreDataProvider::Cin7CoreDataProvider prov({
            "account_id": "invalid-account",
            "apikey": "invalid-key",
        });

        # Test getting non-existent child provider
        assertThrows("INVALID-CHILD-PROVIDER", sub() {
            prov.getChildProviderEx("nonexistent");
        });

        # Test invalid child in events provider
        AbstractDataProvider events = prov.getChildProvider("events");
        assertThrows("INVALID-CHILD-PROVIDER", sub() {
            events.getChildProviderEx("invalid-event-type");
        });
    }

    #! Corner case tests - edge cases and boundary conditions
    cornerCaseTests() {
        checkJson();
        # Test REST client URL
        Cin7CoreRestClient::Cin7CoreRestClient client1({
            "account_id": "x",
            "apikey": "x",
        });
        assertTrue(client1.getURL() =~ /inventory\.dearsystems\.com/);
    }

    #! Connection tests - verify connection scheme registration
    connectionTests() {
        checkJson();
        # Verify connection scheme is registered
        hash<ConnectionSchemeInfo> scheme = ConnectionSchemeCache::getScheme("cin7core");
        assertEq("Cin7Core REST Connection", scheme.display_name);
        assertTrue(scheme.options.hasKey("account_id"));
        assertTrue(scheme.options."account_id".sensitive);
        assertTrue(scheme.options.hasKey("apikey"));
        assertTrue(scheme.options."apikey".sensitive);

        # Verify connection can create data provider
        Cin7CoreRestClient::Cin7CoreRestConnection conn("test", "test connection",
            "cin7core://inventory.dearsystems.com/externalapi", {},
            {"account_id": "x", "apikey": "x"});
        assertTrue(conn.hasDataProvider());
        assertEq("Cin7Core", conn.getAppName());
        assertEq("cin7core", conn.getType());
    }

    #! Action catalog tests - verify all actions are registered
    actionCatalogTests() {
        checkJson();
        # Get all actions for the Cin7Core app
        *list<hash<DataProviderActionInfo>> actions = DataProviderActionCatalog::getActions(
            Cin7CoreDataProvider::AppName);
        assertTrue(actions.size() > 0);

        # Verify action names
        list<string> actionNames = map $1.action, actions;

        # Customer actions
        assertTrue(actionNames.contains("create-customer"));
        assertTrue(actionNames.contains("get-customer"));
        assertTrue(actionNames.contains("update-customer"));
        assertTrue(actionNames.contains("search-customers"));

        # Supplier actions
        assertTrue(actionNames.contains("create-supplier"));
        assertTrue(actionNames.contains("get-supplier"));
        assertTrue(actionNames.contains("update-supplier"));
        assertTrue(actionNames.contains("search-suppliers"));

        # Product actions
        assertTrue(actionNames.contains("get-product"));
        assertTrue(actionNames.contains("search-products"));
        assertTrue(actionNames.contains("find-product-availability"));

        # Sale actions
        assertTrue(actionNames.contains("create-sale"));
        assertTrue(actionNames.contains("get-sale"));
        assertTrue(actionNames.contains("update-sale"));
        assertTrue(actionNames.contains("delete-sale"));
        assertTrue(actionNames.contains("search-sales"));

        # Sale payment actions
        assertTrue(actionNames.contains("add-sale-payment"));
        assertTrue(actionNames.contains("update-sale-payment"));
        assertTrue(actionNames.contains("delete-sale-payment"));
        assertTrue(actionNames.contains("search-sale-payments"));

        # Stock adjustment actions
        assertTrue(actionNames.contains("create-stock-adjustment"));
        assertTrue(actionNames.contains("get-stock-adjustment"));
        assertTrue(actionNames.contains("update-stock-adjustment"));
        assertTrue(actionNames.contains("delete-stock-adjustment"));
        assertTrue(actionNames.contains("search-stock-adjustments"));

        # Assembly actions
        assertTrue(actionNames.contains("find-assembly"));

        # Utility actions
        assertTrue(actionNames.contains("make-api-call"));

        # Trigger actions
        assertTrue(actionNames.contains("new-payment"));
        assertTrue(actionNames.contains("new-sale-credit-note-authorized"));
        assertTrue(actionNames.contains("new-sale-invoice-authorized"));
        assertTrue(actionNames.contains("sale-tracking-changed"));
        assertTrue(actionNames.contains("sale-voided"));
        assertTrue(actionNames.contains("stock-level-update"));
        assertTrue(actionNames.contains("customer-updated"));
        assertTrue(actionNames.contains("supplier-updated"));

        # Verify trigger actions have correct action_code
        *hash<DataProviderActionInfo> newPaymentAction = DataProviderActionCatalog::getAppAction(
            Cin7CoreDataProvider::AppName, "new-payment");
        assertTrue(exists newPaymentAction, "new-payment action should exist");
        assertEq(DPAT_EVENT, newPaymentAction.action_code);
    }

    #! Integration tests - require CIN7CORE_ACCOUNT_ID and CIN7CORE_API_KEY
    integrationTests() {
        checkJson();
        if (!client) {
            testSkip("No Cin7Core credentials provided (use -a/-k options or "
                "CIN7CORE_ACCOUNT_ID/CIN7CORE_API_KEY env vars)");
            return;
        }

        # Test API connectivity
        testApiConnectivity();

        # Test customers provider
        testCustomersProvider();

        # Test suppliers provider
        testSuppliersProvider();

        # Test products provider
        testProductsProvider();

        # Test sales provider
        testSalesProvider();

        # Test customer data integrity (create, fetch, verify)
        testCustomerDataIntegrity();

        # Test make-api-call action
        testMakeApiCall();
    }

    #! Test API connectivity
    private testApiConnectivity() {
        # Test that we can connect to the API
        hash<auto> response = client.get("me");
        assertTrue(response.body.typeCode() == NT_HASH);
        if (m_options.verbose) {
            printf("Connected to Cin7Core API successfully\n");
        }
    }

    #! Test customers provider
    private testCustomersProvider() {
        if (m_options.verbose) {
            printf("\n--- Testing Customers Provider ---\n");
        }

        Cin7CoreDataProvider::Cin7CoreDataProvider prov(client);

        # Get customers provider
        AbstractDataProvider customersProvider = prov.getChildProvider("customers");
        hash<DataProviderInfo> info = customersProvider.getInfo();

        assertTrue(info.supports_read, "Customers should support read");
        assertTrue(info.supports_native_search, "Customers should support native search");
        assertTrue(info.has_record, "Customers should have record type");

        # Verify search options exist
        assertTrue(info.search_options.hasKey("ID"), "Should have ID search option");
        assertTrue(info.search_options.hasKey("Name"), "Should have Name search option");
        assertTrue(info.search_options.hasKey("ModifiedSince"), "Should have ModifiedSince search option");
        assertTrue(info.search_options.hasKey("Page"), "Should have Page search option");
        assertTrue(info.search_options.hasKey("Limit"), "Should have Limit search option");

        # Fetch some customers (limited)
        hash<auto> searchOpts = {"Limit": 5};
        list<hash<auto>> customers = map $1, customersProvider.searchRecords(NOTHING, searchOpts);

        if (m_options.verbose) {
            printf("  Found %d customers (limited to 5)\n", customers.size());
        }

        if (customers.size() > 0) {
            # Verify customer record structure
            hash<auto> customer = customers[0];
            assertTrue(customer.hasKey("ID"), "Customer should have ID");
            assertTrue(customer.hasKey("Name"), "Customer should have Name");
            if (m_options.verbose) {
                printf("  Sample customer: ID=%y, Name=%y\n",
                    customer.ID, customer.Name ?? "N/A");
            }
        }

        if (m_options.verbose) {
            printf("--- Customers Provider tests completed ---\n");
        }
    }

