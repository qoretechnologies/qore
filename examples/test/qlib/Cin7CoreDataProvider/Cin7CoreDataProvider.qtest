        }

        # ============================================
        # Test Stock Level Update Watch Provider
        # ============================================
        if (m_options.verbose) {
            printf("\nTesting Cin7CoreStockLevelUpdateWatchDataProvider...\n");
        }

        Cin7CoreDataProvider::Cin7CoreStockLevelUpdateWatchDataProvider stockProv(client, {});
        assertEq("stock-level-update", stockProv.getName());
