#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit

%requires DataProvider
%requires SalesforceRestDataProvider

%exec-class SalesforceRestDataProviderTest

public class SalesforceRestDataProviderTest inherits QUnit::Test {
    constructor() : Test("SalesforceRestDataProvider test", "1.0") {
        addTestCase("action data dependent options", \testActionDataDependentOptions());

        set_return_value(main());
    }

    testActionDataDependentOptions() {
        list<string> expected_actions = (
            "create", "find_single", "find", "update", "upsert", "delete",
        );

        # NOTE: the action catalog is global and open to other modules; getActions() also loads any
        # installed module registering actions against this app (ex: SalesforcePubSubDataProvider in
        # module-grpc registers "pubsub-event" here), so only this module's own actions are checked
        hash<string, hash<DataProviderActionInfo>> action_map;
        foreach hash<DataProviderActionInfo> action in (DataProviderActionCatalog::getActions("Salesforce")) {
            action_map{action.action} = action;
        }
        foreach string action_name in (expected_actions) {
            assertTrue(action_map.hasKey(action_name), sprintf("action %y is registered", action_name));
            assertTrue(action_map{action_name}.data_dependent_options,
                sprintf("action %y has data_dependent_options", action_name));
        }
    }
}
