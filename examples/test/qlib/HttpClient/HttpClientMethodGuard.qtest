    MethodGuard lifetime-barrier stress test.

    Stresses the HttpClientConnectionBase MethodGuard by spawning many
    background threads hammering an HTTPClient while the main thread
    deletes it.  Pre-fix (raw pointer dereferences): crashes libqore with
    SIGSEGV on a freed Http{1,2,3}ClientPollOperationPriv vtable.
    Post-fix: every background call either completes successfully OR
    receives a clean HTTPCLIENT-STATE-ERROR Qore exception; no SIGSEGV,
    no assertion failures, no torn reads.

    Invariant asserted: "Qore code cannot crash libqore".  The test
    deliberately performs the unsafe-looking "delete rc" concurrent with
    "rc.get()" pattern that the MethodGuard was designed to survive.
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Mime
%requires Logger
%requires HttpServerUtil
%requires HttpServerAsyncIo
%requires HttpServer

%exec-class HttpClientMethodGuardTest

#! Tiny handler — we only care about the client-side race, not server work.
class OkHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, "ok", {"Content-Type": "text/plain"});
    }
}

