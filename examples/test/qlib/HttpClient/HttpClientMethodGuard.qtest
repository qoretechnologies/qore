    constructor() : Test("HttpClientMethodGuardTest", "1.0") {
        addTestCase("concurrent delete vs get (plain)", \testConcurrentDeletePlain());
        addTestCase("concurrent delete vs get (H2 over TLS)", \testConcurrentDeleteH2());
        addTestCase("concurrent delete vs get (H3 over QUIC)", \testConcurrentDeleteH3());
        set_return_value(main());
    }

    globalSetUp() {
        mLogger = new Logger("http-mguard-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            mLogger.addAppender(new StdoutAppender());
        }
    }

    #! Shared racing harness — spawns N threads calling rc.get() in a tight
    #! loop, then deletes rc from the main thread.  Passes if no thread
    #! observed a crash (indicated by a non-Qore-exception abnormal exit).
    private hammerAndDelete(string url, int n_threads = 16, int per_thread_ms = 300) {
        # Reference-counted client handle shared across threads via a
        # hash wrapper — Qore's ref counting keeps it alive across threads
        # until every background has dropped its reference.
        HTTPClient client({"url": url, "ssl_verify_cert": False});

        # Warm up the connection pool with one successful call so the
        # background threads race against a LIVE connection, not a fresh
        # connect.
        client.send("", "GET", "/ok", NOTHING, True);

        Counter done(n_threads);
        int ok_count = 0;
        int err_count = 0;
        Mutex m_stats();

        for (int i = 0; i < n_threads; ++i) {
            background sub() {
                on_exit done.dec();
                date deadline = now_us() + per_thread_ms * 1ms;
                while (now_us() < deadline) {
                    try {
                        client.send("", "GET", "/ok", NOTHING, True);
                        m_stats.lock();
                        on_exit m_stats.unlock();
                        ++ok_count;
                    } catch (hash<ExceptionInfo> ex) {
                        # Any Qore exception is acceptable — the only
                        # unacceptable outcome is a libqore-level crash
                        # (SIGSEGV / assert) which would terminate this
                        # test binary without executing any of these
                        # handlers.
                        m_stats.lock();
                        on_exit m_stats.unlock();
                        ++err_count;
                    }
                }
            }();
        }

        # Let the workers get into their loops before we destroy the
        # client.  The whole point is to overlap our delete with their
        # in-flight method calls.
        usleep(per_thread_ms * 250);  # 1/4 of the hammer window

        # This is the unsafe-looking operation the MethodGuard has to
        # survive: tear down the shared client while N threads are
        # executing its methods.
        delete client;

        # Wait for all workers to drain (they'll exit their loops on the
        # deadline or when a HTTPCLIENT-STATE-ERROR propagates).
        done.waitForZero(15s);

        if (m_options.verbose) {
            printf("hammerAndDelete: ok=%d err=%d\n", ok_count, err_count);
        }

        # The platform guarantee: no crash.  If we got here at all, no
        # SIGSEGV fired.  All err_count outcomes are clean Qore
        # exceptions (verified by the catch block above having run).
        assertGt(0, ok_count + err_count,
            "at least one background call must have observed an outcome");
    }

    testConcurrentDeletePlain() {
        HttpServer server(<HttpServerOptionInfo>{"logger": mLogger});
        on_exit delete server;
        server.setHandler("ok", "/ok", NOTHING, new OkHandler());

        hash<auto> info = server.addListener(<HttpListenerOptionInfo>{"service": "0"});
        server.waitForAsyncIo();

        hammerAndDelete("http://localhost:" + info.port);
    }

    testConcurrentDeleteH2() {
        HttpServer server(<HttpServerOptionInfo>{
            "logger": mLogger,
            "enable_h3": False,  # keep H3 out so we're testing H2 specifically
        });
        on_exit delete server;
        server.setHandler("ok", "/ok", NOTHING, new OkHandler());

        hash<auto> info = server.addListener(<HttpListenerOptionInfo>{
            "service": "0",
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        });
        server.waitForAsyncIo();

        hammerAndDelete("https://localhost:" + info.port);
    }

    testConcurrentDeleteH3() {
        HttpServer server(<HttpServerOptionInfo>{
            "logger": mLogger,
            "enable_h3": True,
        });
        on_exit delete server;
        server.setHandler("ok", "/ok", NOTHING, new OkHandler());

        hash<auto> info = server.addListener(<HttpListenerOptionInfo>{
            "service": "0",
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        });
        server.waitForAsyncIo();

        hammerAndDelete("https://localhost:" + info.port);
    }
}
