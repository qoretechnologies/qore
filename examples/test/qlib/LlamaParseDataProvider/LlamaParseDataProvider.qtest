#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%allow-injection

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/ConnectionProvider
%requires ../../../../qlib/DataProvider
%requires ../../../../qlib/LlamaParseRestClient.qm
%requires ../../../../qlib/LlamaParseDataProvider

%exec-class LlamaParseDataProviderTest

#! Subclasses the real LlamaParseRestClientIo and overrides parseDocument
#! to skip the upload/poll/fetch lifecycle — returns a canned result.
class FakeLlamaParseRestClientIo inherits LlamaParseRestClient::LlamaParseRestClientIo {
    public {
        string last_url;
        *hash<auto> last_options;
        hash<auto> canned_result;
    }
    constructor() : LlamaParseRestClientIo({"apikey": "fake-key"}) {}

    hash<auto> parseDocument(string url, *hash<auto> options) {
        last_url = url;
        last_options = options;
        return canned_result;
    }
}

public class LlamaParseDataProviderTest inherits QUnit::Test {
    public {
        const MyOpts = Opts + {
            "conn": "c,connection=s",
        };

        const OptionColumn = 22;

        #! Stable, tiny, publicly hosted sample invoice PDF (1 page)
        const SamplePdfUrl =
            "https://raw.githubusercontent.com/Azure-Samples/"
            "cognitive-services-REST-api-samples/master/curl/form-recognizer/"
            "sample-invoice.pdf";
    }

    private {
        *string conn_name;
    }

    constructor() : Test("LlamaParseDataProvider Test", "1.0", \ARGV, MyOpts) {
        conn_name = m_options.conn ?? ENV.LLAMAPARSE_CONNECTION;

        addTestCase("factory + app + action registered", \registrationTest());
        addTestCase("parse-document forwards to parseDocument()",
            \parseDocumentTest());

        # Live test requires a real LlamaParse connection.
        # LlamaParse free tier: 1000 pages/day. ~$0 per run when within free
        # tier.
        if (conn_name) {
            addTestCase("live: ping + parse-document (1-page sample PDF URL)",
                \liveLlamaParseTest());
        }
        set_return_value(main());
    }

    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-c,--connection=ARG",
            "set the LlamaParse connection name; without it (and without the "
            "LLAMAPARSE_CONNECTION env var) the live test is skipped",
            OptionColumn);
    }

    private registrationTest() {
        DataProvider::AbstractDataProviderFactory f =
            DataProvider::DataProvider::getFactory("llamaparse");
        assertEq("llamaparse", f.getInfo().name);
        hash<DataProviderAppInfo> app =
            DataProvider::DataProviderActionCatalog::getApp("LlamaParse");
        assertEq("LlamaParse", app.name);
        assertEq("llamaparse", app.scheme);
        list<hash<DataProviderActionInfo>> actions =
            DataProvider::DataProviderActionCatalog::getActions("LlamaParse");
        assertEq(1, actions.size());
        assertEq("parse-document", actions[0].action);
    }

    private parseDocumentTest() {
        FakeLlamaParseRestClientIo fake();
        fake.canned_result = {
            "job_id": "abc-123",
            "status": "SUCCESS",
            "result_type": "markdown",
            "content": "# Hello\n\nWorld.",
        };
        LlamaParseDataProvider::LlamaParseDocumentDataProvider prov(fake);
        auto resp = prov.doRequest({
            "url": "https://example.com/doc.pdf",
            "result_type": "markdown",
            "language": "en",
        });
        assertEq("https://example.com/doc.pdf", fake.last_url);
        assertEq("markdown", fake.last_options.result_type);
        assertEq("en", fake.last_options.language);
        # url is stripped from options before being passed through
        assertEq(NOTHING, fake.last_options.url);
        assertEq("abc-123", resp.job_id);
        assertEq("SUCCESS", resp.status);
        assertEq("# Hello\n\nWorld.", resp.content);
    }

    #! Exercises LlamaParse's live upload/poll/fetch lifecycle
    /** Verifies the actual wire format against LlamaParse's production
        API using a stable, publicly hosted 1-page sample PDF.

        LlamaParse free tier: 1000 pages/day.  ~$0 per run when within
        free tier.
    */
    private liveLlamaParseTest() {
        AbstractConnection conn = get_connection(conn_name);
        hash<auto> ping = conn.ping(True);
        assertTrue(ping.ok, sprintf("LlamaParse connection ping failed: %s",
            ping.info ?? "no info"));

        AbstractDataProvider prov = conn.getDataProvider();
        AbstractDataProvider pd = prov.getChildProvider("parse-document");
        auto resp = pd.doRequest({
            "url":         SamplePdfUrl,
            "result_type": "markdown",
        });
        assertTrue(resp.status.val(),
            "LlamaParse returned a status");
        assertTrue(resp.content.val() || resp.result.val(),
            "LlamaParse returned parsed content");
    }
}
