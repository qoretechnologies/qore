%modern

module RcScopedDatasourceProvider {
    version = "1.0";
    desc = "a datasource provider module that resolves names for the calling code, for the restricted-caller tests";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
}

#! the functions of a datasource provider module that returns only the calling code's own datasource
public namespace RcScopedDatasourceProvider {
    #! declares that every datasource that the module returns is one that the calling code may use and read
    public bool sub get_mod_caller_scoped() {
        return True;
    }

    public string sub get_mod_ds_string(string str) {
        if (str != "rc-scoped-ds") {
            throw "RC-UNKNOWN", sprintf("unknown datasource %y", str);
        }
        return RcScopedDatasourceProvider::own();
    }

    public *hash<string, string> sub get_mod_ds_hash() {
        return {"rc-scoped-ds": RcScopedDatasourceProvider::own()};
    }

    #! the datasource of the calling code's owner: the isolation domain of its sandbox, or "none"
    string sub own() {
        string owner = SandboxManager::getCallerIsolationDomain() ?? "none";
        return sprintf("pgsql:%s/secret-%s@%sdb", owner, owner, owner);
    }
}
