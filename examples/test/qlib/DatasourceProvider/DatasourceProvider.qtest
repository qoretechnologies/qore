#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%allow-injection

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit

%exec-class DatasourceProviderTest

public class DatasourceProviderTest inherits QUnit::Test {
    constructor() : Test("DatasourceProvider Test", "1.0") {
        addTestCase("dsp test", \datasourceProviderTest());
        addTestCase("dsp neg test", \datasourceProviderNegativeTest());
        addTestCase("dsp masked strings", \datasourceProviderMaskedTest());

        # Return for compatibility with test harness that checks return value.
        set_return_value(main());
    }

    datasourceProviderTest() {
        Program mp(PO_NO_CHILD_PO_RESTRICTIONS|PO_NEW_STYLE);
        mp.setGlobalVarValue("ENV", ENV + {"QORE_DATASOURCE_PROVIDERS": get_script_dir() + "./TestDatasourceProvider.qm"});
        mp.loadApplyToUserModule(get_script_dir() + "../../../../qlib/DatasourceProvider.qm", True);

        Program p();
        p.loadModule("DatasourceProvider");
        p.parse("string sub test(string str) { return get_ds_string(str); }", "");
        assertEq("TEST", p.callFunction("test", "X"));
        assertThrows("DATASOURCE-ERROR", \p.callFunction(), ("test", "Y"));
    }

    datasourceProviderNegativeTest() {
        Program mp(PO_NO_CHILD_PO_RESTRICTIONS|PO_NEW_STYLE);
        mp.loadApplyToUserModule(get_script_dir() + "../../../../qlib/DatasourceProvider.qm", True);

        Program p();
        p.loadModule("DatasourceProvider");
        p.parse("string sub test(string str) { return get_ds_string(str); }", "");
        assertThrows("DATASOURCE-ERROR", \p.callFunction(), ("test", "X"));
        assertEq("X:", p.callFunction("test", "X:"));
    }

    # a datasource string that is not matched is not shown in an exception; an identifier is (qore#6988)
    datasourceProviderMaskedTest() {
        list<string> secrets = ("u_SECRET1", "p_SECRET2", "d_SECRET3");

        # with a provider module that does not match the string
        {
            Program mp(PO_NO_CHILD_PO_RESTRICTIONS|PO_NEW_STYLE);
            mp.setGlobalVarValue("ENV", ENV + {"QORE_DATASOURCE_PROVIDERS": get_script_dir()
                + "./TestDatasourceProvider.qm"});
            mp.loadApplyToUserModule(get_script_dir() + "../../../../qlib/DatasourceProvider.qm", True);
            Program pp(PO_NEW_STYLE);
            pp.loadModule("DatasourceProvider");
            pp.parse("string sub test(string str) { return get_ds_string(str); }", "");
            foreach string str in (("u_SECRET1/p_SECRET2@d_SECRET3", "d_SECRET3(utf8){p_SECRET2=u_SECRET1}")) {
                try {
                    pp.callFunction("test", str);
                    fail("no exception was raised");
                } catch (hash<ExceptionInfo> ex) {
                    assertEq("DATASOURCE-ERROR", ex.err);
                    assertRegex("tried the following datasource provider modules", ex.desc);
                    string text = sprintf("%s: %y", ex.desc, ex.arg);
                    foreach string secret in (secrets) {
                        assertEq(-1, text.find(secret), secret);
                    }
                }
            }
        }
        # a string without a driver that is not matched is not shown in the exception, an identifier is
        Program np(PO_NEW_STYLE);
        np.loadModule("DatasourceProvider");
        np.parse("string sub test(string str) { return get_ds_string(str); }", "");
        try {
            np.callFunction("test", "u_SECRET1/p_SECRET2@d_SECRET3");
            fail("no exception was raised");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("DATASOURCE-ERROR", ex.err);
            string text = sprintf("%s: %y", ex.desc, ex.arg);
            foreach string secret in (secrets) {
                assertEq(-1, text.find(secret), secret);
            }
        }
        try {
            np.callFunction("test", "my_ident");
            fail("no exception was raised");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("DATASOURCE-ERROR", ex.err);
            assertRegex("\"my_ident\"", ex.desc);
        }
    }
}
