#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Mime.qm
%requires ../../../../qlib/ConnectionProvider
%requires ../../../../qlib/HttpServerUtil.qm
%requires ../../../../qlib/RestClient.qm
%requires ../../../../qlib/AwsRestClient.qm
%requires ../../../../qlib/HttpServerAsyncIo
%requires ../../../../qlib/HttpServer.qm

%requires qore >= 0.9.3

%modern

%exec-class AwsTest

class FakeAwsRestHandler inherits AbstractHttpRequestHandler {
    private {
        string input;
        string mime;
    }

    constructor(string mime, string input) {
        self.mime = mime;
        self.input = input;
    }

    hash handleRequest(hash cx, hash hdr, *data body) {
        #printf("cx: %N\nhdr: %N\nbody: %N\n", cx, hdr, body);
        if (cx.raw_path =~ /^\/?auth\/v1\/login$/) {
            return makeResponse({"Content-Type": MimeTypeJson}, 200, "{\"token\": \"token\"}");
        }
        if (cx.raw_path =~ /^\/?auth\/v1\/logout$/) {
            return makeResponse({"Content-Type": MimeTypeJson}, 200, "OK");
        }
        if (!hdr."authorization") {
            return makeResponse(400, "Missing authorization header");
        }
        if (hdr."authorization" != "Bearer token") {
            return makeResponse(401, "Unauthorized, invalid token");
        }
        if (hdr.method == "GET") {
            return makeResponse(("Content-Type": mime), 200, input);
        }
        if (hdr.method == "PUT") {
            return makeResponse(("Content-Type": mime), 200, input);
        }
    }
}

sub log(string str) {
    delete argv;
}

const VALUE_JSON = {
    "input": "{\"foo\":{\"bar\":1}}",
    "output": {"foo": {"bar": 1}},
};

class AwsTest inherits QUnit::Test {
    private {
        HttpServer m_http;
        int port;

        AwsRestClient client;

        const FakeAwsOptions = {
            "aws_keyid": "AKIDEXAMPLE",
            "aws_secret": "wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY",
            "aws_region": "us-east-1",
            "aws_service": "iam",
        };
    }

    constructor() : Test("AwsTest", "1.0") {
        addTestCase("Aws.com REST", \AwsRestClientRestTests());
        addTestCase("negative tests", \negativeTest());
        addTestCase("connection tests", \connectionTest());
        addTestCase("env-var credential fallback", \envVarCredentialTest());
        addTestCase("STS XML response parse", \stsParseTest());
        addTestCase("STS AssumeRole end-to-end", \stsAssumeRoleE2ETest());
        set_return_value(main());
    }

    globalSetUp() {
        Logger logger("test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }
        hash<HttpServerOptionInfo> http_opts = <HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        };
        m_http = new HttpServer(http_opts);
        m_http.setHandler("/api/v1/actionsteps", "/api/v1/actionsteps",
                        MimeTypeJson, new FakeAwsRestHandler(MimeTypeJson, VALUE_JSON.input));
        port = m_http.addListener(<HttpListenerOptionInfo>{"service": 0}).port;

        try {
            client = new AwsRestClient({"url": "http://localhost:" + port} + FakeAwsOptions);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "RESTCLIENT-ERROR") {
                printf("no REST client: %s: %s", ex.err, ex.desc);
            } else {
                rethrow;
            }
        }
    }

    globalTearDown() {
        delete client;
        delete m_http;
    }

    AwsRestClientRestTests() {
        if (!client) {
            testSkip("no client support");
        }

        # https://iam.amazonaws.com/?Action=ListUsers&Version=2010-05-08
        AwsRestTestClient aws_client;
        try {
            aws_client = new AwsRestTestClient({"url": "https://iam.amazonaws.com/?Action=ListUsers&Version=2010-05-08"} + FakeAwsOptions);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "QOREADDRINFO-GETINFO-ERROR" || ex.err == "SOCKET-CONNECT-ERROR"
                    || ex.err == "SOCKET-SSL-ERROR") {
                testSkip("connection error: " + ex.err + ": " + ex.desc);
            }
            rethrow;
        }
        # test the signature generation algorithm against a known good value for a certain request
        hash<auto> hdr = {"Content-Type": "application/x-www-form-urlencoded; charset=utf-8"};
        # this creates a request that matches the example request in the AWS docs, so the generated signature must match
        string sig = aws_client.getSignatureTest("GET", "/?Action=ListUsers&Version=2010-05-08", hdr, NOTHING,
            2015-08-30T12:36:00Z, "20150830/us-east-1/iam/aws4_request");
        assertEq("5d672d79c15b13162d9279b0855cfba6789a8edb4c82c400e06b5924a6f2b5d7", sig);

        try {
            aws_client = new AwsRestTestClient({"url": "https://iotevents.eu-central-1.amazonaws.com"}
                + (FakeAwsOptions - ("aws_service", "aws_region")));
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "QOREADDRINFO-GETINFO-ERROR" || ex.err == "SOCKET-CONNECT-ERROR"
                    || ex.err == "SOCKET-SSL-ERROR") {
                testSkip("connection error: " + ex.err + ": " + ex.desc);
            }
            rethrow;
        }
        sig = aws_client.getSignatureTest("GET", "/?Action=ListUsers&Version=2010-05-08", hdr, NOTHING,
            2015-08-30T12:36:00Z, "20150830/us-east-1/iam/aws4_request");
        assertEq(Type::String, sig.type());
    }

    negativeTest() {
        if (!client) {
            testSkip("no client support");
        }

        assertThrows("AWSRESTCLIENT-ERROR", sub () {new AwsRestClient({"url": "http://localhost:" + port});});
        AwsRestClient new_client({"url": "http://localhost:" + port} + FakeAwsOptions);
        assertThrows("REST-RESPONSE-ERROR", \new_client.get(), "/api_json");
    }

    connectionTest() {
        string url = "http://localhost:" + port;
        AwsRestConnection conn("test", "test", url, NOTHING, FakeAwsOptions);
        assertEq(True, conn instanceof AwsRestConnection);

        if (!client) {
            testSkip("no client support");
        }

        AwsRestClient new_client = conn.get(False);
        assertEq(True, new_client instanceof AwsRestClient);
    }

    #! Verifies AwsRestClient picks up credentials from AWS_* environment variables
    envVarCredentialTest() {
        # snapshot existing process env so we can restore it
        *string saved_keyid  = getenv("AWS_ACCESS_KEY_ID");
        *string saved_secret = getenv("AWS_SECRET_ACCESS_KEY");
        *string saved_token  = getenv("AWS_SESSION_TOKEN");
        *string saved_region = getenv("AWS_REGION");
        *string saved_default_region = getenv("AWS_DEFAULT_REGION");
        on_exit {
            saved_keyid.val()
                ? setenv("AWS_ACCESS_KEY_ID", saved_keyid)
                : unsetenv("AWS_ACCESS_KEY_ID");
            saved_secret.val()
                ? setenv("AWS_SECRET_ACCESS_KEY", saved_secret)
                : unsetenv("AWS_SECRET_ACCESS_KEY");
            saved_token.val()
                ? setenv("AWS_SESSION_TOKEN", saved_token)
                : unsetenv("AWS_SESSION_TOKEN");
            saved_region.val()
                ? setenv("AWS_REGION", saved_region)
                : unsetenv("AWS_REGION");
            saved_default_region.val()
                ? setenv("AWS_DEFAULT_REGION", saved_default_region)
                : unsetenv("AWS_DEFAULT_REGION");
        }

        # without env vars or aws_keyid in opts, construction must fail
        unsetenv("AWS_ACCESS_KEY_ID");
        unsetenv("AWS_SECRET_ACCESS_KEY");
        unsetenv("AWS_SESSION_TOKEN");
        unsetenv("AWS_REGION");
        unsetenv("AWS_DEFAULT_REGION");
        assertThrows("AWSRESTCLIENT-ERROR", sub () {
            new AwsRestClient({
                "url": "http://localhost:" + port,
                "aws_service": "iam",
            });
        });

        # with env vars set, the same call should succeed
        setenv("AWS_ACCESS_KEY_ID",     "AKIA-ENV-KEY-ID");
        setenv("AWS_SECRET_ACCESS_KEY", "envSECRET");
        setenv("AWS_SESSION_TOKEN",     "envSESSION");
        setenv("AWS_REGION",            "us-east-1");
        AwsRestClient c = new AwsRestClient({
            "url": "http://localhost:" + port,
            "aws_service": "iam",
        });
        assertEq(True, c instanceof AwsRestClient);

        # explicit opts must win over env vars
        AwsRestClient c2 = new AwsRestClient({
            "url": "http://localhost:" + port,
            "aws_keyid": "AKIA-EXPLICIT",
            "aws_secret": "explicitSecret",
            "aws_region": "eu-west-1",
            "aws_service": "iam",
        });
        assertEq(True, c2 instanceof AwsRestClient);

        # AWS_DEFAULT_REGION should be picked up when AWS_REGION is unset
        unsetenv("AWS_REGION");
        setenv("AWS_DEFAULT_REGION", "ap-south-1");
        AwsRestClient c3 = new AwsRestClient({
            "url": "http://localhost:" + port,
            "aws_service": "iam",
        });
        assertEq(True, c3 instanceof AwsRestClient);
    }

    #! parseAssumeRoleResponse extracts all expected fields from real STS XML
    stsParseTest() {
        string xml =
            "<AssumeRoleResponse xmlns=\"https://sts.amazonaws.com/doc/2011-06-15/\">\n"
            "  <AssumeRoleResult>\n"
            "    <Credentials>\n"
            "      <AccessKeyId>ASIA-TEST-KEY</AccessKeyId>\n"
            "      <SecretAccessKey>TEST/SECRET+VALUE</SecretAccessKey>\n"
            "      <SessionToken>TEST-SESSION-TOKEN</SessionToken>\n"
            "      <Expiration>2026-06-01T12:00:00Z</Expiration>\n"
            "    </Credentials>\n"
            "    <AssumedRoleUser>\n"
            "      <Arn>arn:aws:sts::123456789012:assumed-role/MyRole/qore</Arn>\n"
            "      <AssumedRoleId>AROAEXAMPLE:qore</AssumedRoleId>\n"
            "    </AssumedRoleUser>\n"
            "  </AssumeRoleResult>\n"
            "</AssumeRoleResponse>\n";
        hash<auto> creds = AwsRestClientBase::parseAssumeRoleResponse(xml);
        assertEq("ASIA-TEST-KEY",       creds.aws_keyid);
        assertEq("TEST/SECRET+VALUE",   creds.aws_secret);
        assertEq("TEST-SESSION-TOKEN",  creds.aws_token);
        assertEq(2026-06-01T12:00:00Z,  creds.expires);

        # binary body works too
        hash<auto> creds2 = AwsRestClientBase::parseAssumeRoleResponse(binary(xml));
        assertEq("ASIA-TEST-KEY", creds2.aws_keyid);

        # missing AccessKeyId should throw
        assertThrows("AWSRESTCLIENT-STS-ERROR", sub () {
            AwsRestClientBase::parseAssumeRoleResponse(
                "<AssumeRoleResponse></AssumeRoleResponse>");
        });
    }

    #! End-to-end: AssumeRole against a fake STS HTTP endpoint, then sign with the temp creds
    stsAssumeRoleE2ETest() {
        # spin up a fake STS endpoint that returns canned credentials
        Logger logger("test", LoggerLevel::getLevelInfo());
        HttpServer sts_http(<HttpServerOptionInfo>{"logger": logger});
        FakeStsHandler sts_handler();
        sts_http.setDefaultHandler("sts", sts_handler);
        int sts_port = sts_http.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        on_exit delete sts_http;

        hash<auto> creds = AwsRestClientBase::assumeRole({
            "aws_keyid": "AKIA-BASE",
            "aws_secret": "baseSecret",
            "aws_region": "us-east-1",
            "aws_role_arn": "arn:aws:iam::123456789012:role/MyRole",
            "aws_role_session_name": "test-session",
            "aws_external_id": "ext-id-42",
            "aws_sts_endpoint": "http://localhost:" + sts_port,
        });
        assertEq("FAKE-ASIA-KEY",   creds.aws_keyid);
        assertEq("fake-secret-456", creds.aws_secret);
        assertEq("fake-session-token-xyz", creds.aws_token);
        assertTrue(creds.expires > now_us());

        # verify the STS handler received the expected Query API parameters
        assertEq("AssumeRole", sts_handler.params.Action);
        assertEq("arn:aws:iam::123456789012:role/MyRole", sts_handler.params.RoleArn);
        assertEq("test-session", sts_handler.params.RoleSessionName);
        assertEq("ext-id-42",    sts_handler.params.ExternalId);
        assertEq("3600",         sts_handler.params.DurationSeconds);

        # constructor with aws_role_arn should overlay the temp creds onto opts
        # (no actual signed request is made in this test — we just verify the
        # client accepts the role-arn option without throwing)
        AwsRestClient role_client({
            "url": "http://localhost:" + port,
            "aws_keyid": "AKIA-BASE",
            "aws_secret": "baseSecret",
            "aws_region": "us-east-1",
            "aws_service": "iam",
            "aws_role_arn": "arn:aws:iam::123456789012:role/MyRole",
            "aws_sts_endpoint": "http://localhost:" + sts_port,
        });
        assertEq(True, role_client instanceof AwsRestClient);
    }
}

#! Fake STS endpoint that records the form-encoded query and returns canned creds
class FakeStsHandler inherits AbstractHttpRequestHandler {
    public {
        hash<auto> params = {};
    }

    hash handleRequest(hash cx, hash hdr, *data body) {
        # parse form-encoded body
        string body_str;
        if (body.typeCode() == NT_BINARY) {
            body_str = body.toString("UTF-8");
        } else if (body.typeCode() == NT_STRING) {
            body_str = body;
        } else {
            body_str = "";
        }
        foreach string pair in (body_str.split("&")) {
            list<string> kv = pair.split("=");
            if (kv.size() == 2) {
                params{decode_url(kv[0])} = decode_url(kv[1]);
            }
        }
        string xml =
            "<AssumeRoleResponse xmlns=\"https://sts.amazonaws.com/doc/2011-06-15/\">"
            "<AssumeRoleResult><Credentials>"
            "<AccessKeyId>FAKE-ASIA-KEY</AccessKeyId>"
            "<SecretAccessKey>fake-secret-456</SecretAccessKey>"
            "<SessionToken>fake-session-token-xyz</SessionToken>"
            "<Expiration>2099-12-31T23:59:59Z</Expiration>"
            "</Credentials></AssumeRoleResult></AssumeRoleResponse>";
        return makeResponse({"Content-Type": "text/xml"}, 200, xml);
    }
}

class AwsRestTestClient inherits AwsRestClient {
    constructor(hash<auto> opts) : AwsRestClient(opts) {
    }

    string getSignatureTest(string meth, string path, hash<auto> hdr, *data body, date gmdate, string scope) {
        string signed_headers;
        return getSignature(meth, path, \hdr, body, gmdate, scope, \signed_headers);
    }
}
