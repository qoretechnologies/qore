#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires HttpServer
%requires HttpServerUtil
%requires YamlRpcHandler
%requires yaml

%exec-class YamlRpcHandlerCredentialsTest

#! The log message callback of a restricted Program gets the request without its credentials, with the handler's own
#! keys for the dispatch of the call (qore#7303, qore#7724)

#! a hang guard only, never a timing assertion
const HangGuard = 20s;

#! a handler that adds a key in preprocessRequest() and names it, with keys that restricted code never gets: keys of
#! the request and of the server, and an object
class KeysHandler inherits YamlRpcHandler {
    constructor(AbstractAuthenticator auth, list<auto> methods, *code log) : YamlRpcHandler(auth, methods, log) {
    }

    *hash<HttpResponseInfo> preprocessRequest(HttpListenerInterface listener, reference<hash<auto>> hdr,
            reference<hash<auto>> cx) {
        cx.api_version = "v7";
        cx.api_object = new Mutex();
    }

    private *list<string> getRpcContextKeys() {
        return ("api_version", "api_object", "auth", "uctx", "hdr", "socket");
    }
}

class YamlRpcHandlerCredentialsTest inherits QUnit::Test {
    public {
        #! the tenant's code: records what it saw of the request
        const TenantSource = "%modern
string sub seen(hash<auto> cx) {
    return sprintf(\"cx.auth=%y cx.hdr.authorization=%y cx.hdr.cookie=%y function=%y method=%y yamlid=%y \"
        \"api_version=%y api_object=%y\", exists cx.auth, exists cx.hdr.authorization, exists cx.hdr.cookie,
        exists cx.function, cx.method, cx.yamlid, cx.api_version, exists cx.api_object);
}
code sub get_method() {
    return int sub () { return 1; };
}
code sub get_log(Queue q) {
    return *string sub (hash<auto> cx, hash<auto> method, reference<auto> params) { q.push(seen(cx)); };
}
";

        #! the handler's own keys
        const OwnKeys = " function=True method=\"probe\" yamlid=5";
        #! what code gets without the credentials of the request
        const Filtered = "cx.auth=False cx.hdr.authorization=False cx.hdr.cookie=False" + OwnKeys
            + " api_version=null api_object=False";
        #! what code gets with them
        const Raw = "cx.auth=True cx.hdr.authorization=True cx.hdr.cookie=True" + OwnKeys
            + " api_version=null api_object=False";
        #! what the code of a restricted Program gets from the subclass: the plain key that it names
        const FilteredSubclass = "cx.auth=False cx.hdr.authorization=False cx.hdr.cookie=False" + OwnKeys
            + " api_version=\"v7\" api_object=False";
    }

    constructor() : Test("YamlRpcHandlerCredentialsTest", "1.0", \ARGV) {
        addTestCase("the code of a restricted Program", \restrictedTest());
        addTestCase("the code of a restricted Program: the keys that a subclass names",
            \restrictedSubclassTest());
        addTestCase("trusted code", \trustedTest());
        set_return_value(main());
    }

    #! returns the tenant's Program with the given sandbox
    private Program getTenant(*SandboxManager sm) {
        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        if (sm) {
            p.setSandboxManager(sm);
        }
        p.parse(TenantSource, "tenant");
        return p;
    }

    #! calls the method with credentials; returns what the log callback saw
    private string call(Program p, bool subclass = False) {
        Queue lq();
        list<auto> methods = ({
            "name": "^probe$",
            "function": p.callFunction("get_method"),
            "text": "probe",
            "help": "probe",
        },);
        YamlRpcHandler handler = subclass
            ? new KeysHandler(new PermissiveAuthenticator(), methods, p.callFunction("get_log", lq))
            : new YamlRpcHandler(new PermissiveAuthenticator(), methods, p.callFunction("get_log", lq));
        HttpServer server(<HttpServerOptionInfo>{});
        on_exit server.stop();
        server.setDefaultHandler("yamlrpc", handler);
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        server.waitForAsyncIo();
        Socket c();
        c.connect("127.0.0.1:" + port, HangGuard);
        on_exit c.close();
        string body = make_yaml({"method": "probe", "id": 5, "params": ()});
        c.send(sprintf("POST /YAML HTTP/1.1\r\nHost: localhost\r\nContent-Type: application/x-yaml\r\n"
            "Authorization: Bearer secret\r\nCookie: session=secret\r\nContent-Length: %d\r\n\r\n%s", body.size(),
            body));
        hash<auto> h = c.readHTTPHeader(HangGuard);
        assertEq(200, h.status_code, "the request is served");
        return lq.get(HangGuard);
    }

    restrictedTest() {
        # the default sandbox does not trust its code
        assertEq(Filtered, call(getTenant(new SandboxManager())), "the log message callback");
    }

    restrictedSubclassTest() {
        assertEq(FilteredSubclass, call(getTenant(new SandboxManager()), True), "the log message callback");
    }

    trustedTest() {
        assertEq(Raw, call(getTenant()), "the log message callback");
    }
}
