#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires HttpServer
%requires HttpServerUtil
%requires YamlRpcHandler
%requires yaml

%exec-class YamlRpcHandlerCredentialsTest

#! The log message callback of a restricted Program gets the request without its credentials, with the handler's own
#! keys for the dispatch of the call (qore#7303, qore#7724)

#! a hang guard only, never a timing assertion
const HangGuard = 20s;

#! a handler that adds a key in preprocessRequest() and names it, with keys that restricted code never gets: keys of
#! the request and of the server, and an object
class KeysHandler inherits YamlRpcHandler {
    constructor(AbstractAuthenticator auth, list<auto> methods, *code log) : YamlRpcHandler(auth, methods, log) {
    }

    *hash<HttpResponseInfo> preprocessRequest(HttpListenerInterface listener, reference<hash<auto>> hdr,
            reference<hash<auto>> cx) {
        cx.api_version = "v7";
        cx.api_object = new Mutex();
    }

    private *list<string> getRpcContextKeys() {
        return ("api_version", "api_object", "auth", "uctx", "hdr", "socket");
    }
}

class YamlRpcHandlerCredentialsTest inherits QUnit::Test {
    public {
        #! the tenant's code: records what it saw of the request
        const TenantSource = "%modern
string sub seen(hash<auto> cx) {
    return sprintf(\"cx.auth=%y cx.hdr.authorization=%y cx.hdr.cookie=%y function=%y method=%y yamlid=%y \"
        \"api_version=%y api_object=%y\", exists cx.auth, exists cx.hdr.authorization, exists cx.hdr.cookie,
        exists cx.function, cx.method, cx.yamlid, cx.api_version, exists cx.api_object);
}
code sub get_method() {
    return int sub () { return 1; };
}
code sub get_log(Queue q) {
    return *string sub (hash<auto> cx, hash<auto> method, reference<auto> params) { q.push(seen(cx)); };
}
# what of the code values of the method the log message callback saw (qore#7726)
code sub get_code_log(Queue q) {
    return *string sub (hash<auto> cx, hash<auto> method, reference<auto> params) {
        q.push(sprintf(\"cmark=%y method.cmark=%y method.logopt=%y method.extra=%y\", exists cx.cmark,
            exists method.cmark, exists method.logopt, exists method.extra));
    };
}
# what of the method's function and context marker the log message callback saw (qore#7726)
code sub get_dispatch_log(Queue q) {
    return *string sub (hash<auto> cx, hash<auto> method, reference<auto> params) {
        q.push(sprintf(\"function=%y cmark=%y method.function=%y method.cmark=%y\", exists cx.function,
            cx.cmark.typeCode() == NT_OBJECT ? \"object\" : cx.cmark, exists method.function,
            method.cmark.typeCode() == NT_OBJECT ? \"object\" : method.cmark));
    };
}
";

        #! the handler's own keys
        const OwnKeys = " function=True method=\"probe\" yamlid=5";
        #! the handler's own keys that the code of a restricted Program gets: the method's function only as the name
        #! of an internal method, never the code of the method (qore#7726)
        const FilteredOwnKeys = " function=False method=\"probe\" yamlid=5";
        #! what code gets without the credentials of the request
        const Filtered = "cx.auth=False cx.hdr.authorization=False cx.hdr.cookie=False" + FilteredOwnKeys
            + " api_version=null api_object=False";
        #! what code gets with them
        const Raw = "cx.auth=True cx.hdr.authorization=True cx.hdr.cookie=True" + OwnKeys
            + " api_version=null api_object=False";
        #! what the code of a restricted Program gets from the subclass: the plain key that it names
        const FilteredSubclass = "cx.auth=False cx.hdr.authorization=False cx.hdr.cookie=False" + FilteredOwnKeys
            + " api_version=\"v7\" api_object=False";
    }

    constructor() : Test("YamlRpcHandlerCredentialsTest", "1.0", \ARGV) {
        addTestCase("the code of a restricted Program", \restrictedTest());
        addTestCase("the code of a restricted Program: the keys that a subclass names",
            \restrictedSubclassTest());
        addTestCase("trusted code", \trustedTest());
        addTestCase("a restricted log message callback of a trusted method", \restrictedLogTrustedMethodTest());
        addTestCase("a trusted log message callback", \trustedLogTest());
        addTestCase("a restricted log message callback gets no code of the method", \restrictedLogCodeValuesTest());
        set_return_value(main());
    }

    #! returns the tenant's Program with the given sandbox
    private Program getTenant(*SandboxManager sm) {
        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        if (sm) {
            p.setSandboxManager(sm);
        }
        p.parse(TenantSource, "tenant");
        return p;
    }

    #! calls the method with credentials; returns what the log callback saw
    private string call(Program p, bool subclass = False) {
        Queue lq();
        list<auto> methods = ({
            "name": "^probe$",
            "function": p.callFunction("get_method"),
            "text": "probe",
            "help": "probe",
        },);
        YamlRpcHandler handler = subclass
            ? new KeysHandler(new PermissiveAuthenticator(), methods, p.callFunction("get_log", lq))
            : new YamlRpcHandler(new PermissiveAuthenticator(), methods, p.callFunction("get_log", lq));
        HttpServer server(<HttpServerOptionInfo>{});
        on_exit server.stop();
        server.setDefaultHandler("yamlrpc", handler);
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        server.waitForAsyncIo();
        Socket c();
        c.connect("127.0.0.1:" + port, HangGuard);
        on_exit c.close();
        string body = make_yaml({"method": "probe", "id": 5, "params": ()});
        c.send(sprintf("POST /YAML HTTP/1.1\r\nHost: localhost\r\nContent-Type: application/x-yaml\r\n"
            "Authorization: Bearer secret\r\nCookie: session=secret\r\nContent-Length: %d\r\n\r\n%s", body.size(),
            body));
        hash<auto> h = c.readHTTPHeader(HangGuard);
        assertEq(200, h.status_code, "the request is served");
        return lq.get(HangGuard);
    }

    restrictedTest() {
        # the default sandbox does not trust its code
        assertEq(Filtered, call(getTenant(new SandboxManager())), "the log message callback");
    }

    restrictedSubclassTest() {
        assertEq(FilteredSubclass, call(getTenant(new SandboxManager()), True), "the log message callback");
    }

    trustedTest() {
        assertEq(Raw, call(getTenant()), "the log message callback");
    }

    #! calls a trusted method with the given context marker; returns what the log callback saw
    private string callDispatch(code log, Queue lq, auto cmark) {
        YamlRpcHandler handler(new PermissiveAuthenticator(), (), log);
        handler.addMethod("probe", int sub () { return 1; }, "probe", "probe", NOTHING, cmark);
        HttpServer server(<HttpServerOptionInfo>{});
        on_exit server.stop();
        server.setDefaultHandler("yamlrpc", handler);
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        server.waitForAsyncIo();
        Socket c();
        c.connect("127.0.0.1:" + port, HangGuard);
        on_exit c.close();
        string body = make_yaml({"method": "probe", "id": 5, "params": ()});
        c.send(sprintf("POST /YAML HTTP/1.1\r\nHost: localhost\r\nContent-Type: application/x-yaml\r\n"
            "Content-Length: %d\r\n\r\n%s", body.size(), body));
        hash<auto> h = c.readHTTPHeader(HangGuard);
        assertEq(200, h.status_code, "the request is served");
        return lq.get(HangGuard);
    }

    restrictedLogTrustedMethodTest() {
        Program p = getTenant(new SandboxManager());
        Queue lq();
        # the trusted method's code is not given to the restricted callback, nor its marker that holds an object
        assertEq("function=False cmark=null method.function=False method.cmark=null",
            callDispatch(p.callFunction("get_dispatch_log", lq), lq, new Mutex()), "an object marker");
        # a marker of plain data is given
        assertEq("function=False cmark={a: 1} method.function=False method.cmark={a: 1}",
            callDispatch(p.callFunction("get_dispatch_log", lq), lq, {"a": 1}), "a plain data marker");
    }

    #! calls a trusted method whose hash holds code; returns what the log callback saw
    private string callCodeValues(code log, Queue lq, auto cmark) {
        YamlRpcHandler handler(new PermissiveAuthenticator(), ({
            "name": "^probe$",
            "function": int sub () { return 1; },
            "text": "probe",
            "help": "probe",
            "cmark": cmark,
            "logopt": (string sub () { return "trusted"; },),
            "extra": string sub () { return "trusted"; },
        },), log);
        HttpServer server(<HttpServerOptionInfo>{});
        on_exit server.stop();
        server.setDefaultHandler("yamlrpc", handler);
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        server.waitForAsyncIo();
        Socket c();
        c.connect("127.0.0.1:" + port, HangGuard);
        on_exit c.close();
        string body = make_yaml({"method": "probe", "id": 5, "params": ()});
        c.send(sprintf("POST /YAML HTTP/1.1\r\nHost: localhost\r\nContent-Type: application/x-yaml\r\n"
            "Content-Length: %d\r\n\r\n%s", body.size(), body));
        hash<auto> h = c.readHTTPHeader(HangGuard);
        assertEq(200, h.status_code, "the request is served");
        return lq.get(HangGuard);
    }

    restrictedLogCodeValuesTest() {
        Queue lq();
        Mutex m();
        # a closure and a call reference to a method of a trusted object as the marker, a closure in the log option
        # and in another key of the method
        foreach auto cmark in ((string sub () { return "trusted"; }, \m.lock())) {
            assertEq("cmark=False method.cmark=False method.logopt=False method.extra=False",
                callCodeValues(getTenant(new SandboxManager()).callFunction("get_code_log", lq), lq, cmark),
                "restricted code gets no code of another Program");
        }
        # trusted code gets them
        assertEq("cmark=True method.cmark=True method.logopt=True method.extra=True",
            callCodeValues(getTenant().callFunction("get_code_log", lq), lq, \m.lock()), "trusted code");
    }

    trustedLogTest() {
        Program p = getTenant();
        Queue lq();
        assertEq("function=True cmark=\"object\" method.function=True method.cmark=\"object\"",
            callDispatch(p.callFunction("get_dispatch_log", lq), lq, new Mutex()),
            "trusted code gets the method's function and marker");
    }
}
