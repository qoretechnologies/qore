    testIntegrationModelCrud() {
        if (!live_provider) {
            testSkip("no connection; use -c <connection> or set HUGGINGFACE_TOKEN");
        }
        # generate unique repo name to avoid conflicts
        string repo_name = sprintf("qore-test-%d", clock_getmicros());

        # Create
        AbstractDataProvider create_dp = live_provider.getChildProvider("models")
            .getChildProvider("create");
        auto create_result = create_dp.doRequest({
            "name": repo_name,
            "private": True,
        });
        assertTrue(create_result.url.val() || create_result.repoUrl.val(),
            "create model returns URL");

        # Get - verify persistence
        AbstractDataProvider get_dp = live_provider.getChildProvider("models").getChildProvider("get");
        # need to determine the full repo_id (user/repo_name)
        *string repo_url = create_result.repoUrl ?? create_result.url;
        # extract repo_id from URL: https://huggingface.co/user/repo_name
        string repo_id;
        if (repo_url) {
            list<string> parts = repo_url.split("/");
            # last two parts are user/repo_name
            if (parts.size() >= 2) {
                repo_id = parts[parts.size() - 2] + "/" + parts[parts.size() - 1];
            }
        }
        if (!repo_id) {
            testSkip("Could not determine repo_id from create response");
            return;
        }

        on_exit {
            # Delete - cleanup
            try {
                AbstractDataProvider delete_dp = live_provider.getChildProvider("models")
                    .getChildProvider("delete");
                delete_dp.doRequest({"repo_id": repo_id});
            } catch (hash<ExceptionInfo> ex) {
                # log but don't fail the test on cleanup failure
                printf("WARNING: failed to delete test repo %y: %s: %s\n",
                    repo_id, ex.err, ex.desc);
            }
        }

        auto get_result = get_dp.doRequest({"repo_id": repo_id});
        assertEq(repo_id, get_result.id, "get model returns created repo");
        assertEq(True, get_result."private", "model is private");

        # Update
        AbstractDataProvider update_dp = live_provider.getChildProvider("models")
            .getChildProvider("update");
        update_dp.doRequest({"repo_id": repo_id, "gated": "auto"});
    }

