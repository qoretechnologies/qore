    testIntegrationChatCompletions() {
        if (!live_provider) {
            testSkip("no connection; use -c <connection> or set HUGGINGFACE_TOKEN");
        }
        # use the inference child provider to get the chat completions provider
        AbstractDataProvider chat_dp = live_provider.getChildProvider("inference")
            .getChildProvider("chat-completions");
        auto result = chat_dp.doRequest({
            "model": "meta-llama/Llama-3.1-8B-Instruct",
            "messages": (
                {"role": "user", "content": "Say hello in one word."},
            ),
            "max_tokens": 10,
        });
        assertTrue(result.id.val(), "chat completion has id");
        assertTrue(result.choices.size() > 0, "chat completion has choices");
        assertTrue(result.choices[0].message.content.val(), "first choice has content");
        assertTrue(result.output_text.val(), "output_text convenience field populated");
        assertTrue(result.usage.total_tokens > 0, "usage reports tokens");
    }

    testIntegrationReferenceData() {
        if (!live_provider) {
            testSkip("no connection; use -c <connection> or set HUGGINGFACE_TOKEN");
        }
        *list<hash<AllowedValueInfo>> models = live_provider.getReferenceData("models");
        assertTrue(models.size() > 0, "models reference data returns results");
        assertTrue(models[0].value.val(), "first model ref has value");
        assertTrue(models[0].display_name.val(), "first model ref has display_name");

        *list<hash<AllowedValueInfo>> datasets = live_provider.getReferenceData("datasets");
        assertTrue(datasets.size() > 0, "datasets reference data returns results");
        assertTrue(datasets[0].value.val(), "first dataset ref has value");
        assertTrue(datasets[0].display_name.val(), "first dataset ref has display_name");

        *list<hash<AllowedValueInfo>> spaces = live_provider.getReferenceData("spaces");
        assertTrue(spaces.size() > 0, "spaces reference data returns results");
        assertTrue(spaces[0].value.val(), "first space ref has value");
        assertTrue(spaces[0].display_name.val(), "first space ref has display_name");

        # verify chat completions provider can get model ref data via Hub client
        AbstractDataProvider chat_dp = live_provider.getChildProvider("inference")
            .getChildProvider("chat-completions");
        *list<hash<AllowedValueInfo>> chat_models = chat_dp.getReferenceData("models");
        assertTrue(chat_models.size() > 0, "chat completions models ref data returns results");
        assertTrue(chat_models[0].value.val(), "chat completions first model ref has value");
        assertTrue(chat_models[0].display_name.val(), "chat completions first model ref has display_name");
    }
}
