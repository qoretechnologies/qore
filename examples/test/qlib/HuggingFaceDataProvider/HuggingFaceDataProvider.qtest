#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/DataProvider
%requires ../../../../qlib/HuggingFaceDataProvider

%exec-class HuggingFaceDataProviderTest

class FakeHuggingFaceRestClientIo inherits RestClientIo::RestClientIo {
    public {
        string last_method;
        string last_path;
        *hash<auto> last_request;
        *hash<auto> last_headers;
        auto response_body;
    }

    constructor() : RestClientIo({"url": "https://huggingface.co", "data": "json",
            "headers": {"Authorization": "Bearer test-token"}}) {
    }

    hash<auto> getDefaultHeaders() {
        return {"Authorization": "Bearer test-token", "Accept": MimeTypeJson};
    }

    string getConnectionPath() {
        return "api";
    }

    hash<RestClient::RestResponseInfo> restGet(string path, *hash<auto> hdr) {
        last_method = "GET";
        last_path = path;
        last_headers = hdr;
        if (response_body) {
            return <RestClient::RestResponseInfo>{"body": response_body};
        }
        # default response for list endpoints
        return <RestClient::RestResponseInfo>{
            "body": (
                {
                    "id": "meta-llama/Llama-3.1-8B",
                    "modelId": "meta-llama/Llama-3.1-8B",
                    "author": "meta-llama",
                    "lastModified": "2025-01-15T00:00:00Z",
                    "private": False,
                    "pipeline_tag": "text-generation",
                    "downloads": 1000000,
                    "likes": 5000,
                },
            ),
        };
    }

    hash<RestClient::RestResponseInfo> restPost(string path, auto body, *hash<auto> hdr) {
        last_method = "POST";
        last_path = path;
        last_request = body;
        last_headers = hdr;
        if (response_body) {
            return <RestClient::RestResponseInfo>{"body": response_body};
        }
        # default create response
        return <RestClient::RestResponseInfo>{
            "body": {
                "url": "https://huggingface.co/test-user/test-repo",
                "repoUrl": "https://huggingface.co/test-user/test-repo",
            },
        };
    }

    hash<RestClient::RestResponseInfo> restPut(string path, auto body, *hash<auto> hdr) {
        last_method = "PUT";
        last_path = path;
        last_request = body;
        last_headers = hdr;
        return <RestClient::RestResponseInfo>{
            "body": {},
        };
    }

    hash<RestClient::RestResponseInfo> restDel(string path, auto body, *hash<auto> hdr) {
        last_method = "DELETE";
        last_path = path;
        last_request = body;
        last_headers = hdr;
        return <RestClient::RestResponseInfo>{
            "body": {},
        };
    }
}

class HuggingFaceDataProviderTest inherits QUnit::Test {
    private {
        FakeHuggingFaceRestClientIo fake_rest;
        HuggingFaceDataProvider::HuggingFaceDataProvider provider;

        # live provider from connection (set up if -c is given)
        *HuggingFaceDataProvider::HuggingFaceDataProvider live_provider;

        # command-line options
        const MyOpts = Opts + {
            "conn": "c,connection=s",
        };

        const OptionColumn = 22;
    }

    constructor() : Test("HuggingFaceDataProvider", "1.0", \ARGV, MyOpts) {
        # unit tests (always run)
        addTestCase("test provider tree", \testProviderTree());
        addTestCase("test list models", \testListModels());
        addTestCase("test list models pipeline_tag", \testListModelsPipelineTag());
        addTestCase("test get model", \testGetModel());
        addTestCase("test create model", \testCreateModel());
        addTestCase("test update model", \testUpdateModel());
        addTestCase("test delete model", \testDeleteModel());
        addTestCase("test list datasets", \testListDatasets());
        addTestCase("test get dataset", \testGetDataset());
        addTestCase("test create dataset", \testCreateDataset());
        addTestCase("test update dataset", \testUpdateDataset());
        addTestCase("test delete dataset", \testDeleteDataset());
        addTestCase("test list spaces", \testListSpaces());
        addTestCase("test get space", \testGetSpace());
        addTestCase("test create space", \testCreateSpace());
        addTestCase("test update space", \testUpdateSpace());
        addTestCase("test delete space", \testDeleteSpace());
        addTestCase("test chat completions", \testChatCompletions());
        addTestCase("test reference data", \testReferenceData());
        addTestCase("test data types", \testDataTypes());

        # integration tests (require connection)
        addTestCase("integration: list models", \testIntegrationListModels());
        addTestCase("integration: get model", \testIntegrationGetModel());
        addTestCase("integration: list datasets", \testIntegrationListDatasets());
        addTestCase("integration: list spaces", \testIntegrationListSpaces());
        addTestCase("integration: model CRUD", \testIntegrationModelCrud());
        addTestCase("integration: dataset CRUD", \testIntegrationDatasetCrud());
        addTestCase("integration: space CRUD", \testIntegrationSpaceCrud());
        addTestCase("integration: chat completions", \testIntegrationChatCompletions());
        addTestCase("integration: reference data", \testIntegrationReferenceData());

        try {
            setupConnection();
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose > 2) {
                printf("%s\n", get_exception_string(ex));
            } else if (m_options.verbose) {
                printf("%s: %s\n", ex.err, ex.desc);
            }
        }

        set_return_value(main());
    }

    setUp() {
        fake_rest = new FakeHuggingFaceRestClientIo();
        provider = new HuggingFaceDataProvider::HuggingFaceDataProvider(fake_rest);
    }

    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-c,--connection=ARG", "set connection name", OptionColumn);
    }

    private error(string fmt) {
        throw "OPTION-ERROR", sprintf("%s: ERROR: %s", get_script_name(), vsprintf(fmt, argv));
    }

    private setupConnection() {
        *string conn_name = m_options.conn ?? ENV.HUGGINGFACE_CONNECTION;
        if (conn_name.val()) {
            AbstractConnection conn = get_connection(conn_name);
            live_provider = conn.getDataProvider();
            return;
        }
        # fallback to API token env var
        *string token = ENV.HUGGINGFACE_TOKEN;
        if (token.val()) {
            live_provider = new HuggingFaceDataProvider::HuggingFaceDataProvider({"apikey": token});
        }
    }

    # ---- Unit tests (mock) ----

    testProviderTree() {
        list<string> children = provider.getChildProviderNames();
        assertEq(True, inlist("models", children), "models child exists");
        assertEq(True, inlist("datasets", children), "datasets child exists");
        assertEq(True, inlist("spaces", children), "spaces child exists");
        assertEq(True, inlist("inference", children), "inference child exists");

        # check models children
        AbstractDataProvider models = provider.getChildProvider("models");
        list<string> model_children = models.getChildProviderNames();
        assertEq(True, inlist("list", model_children), "models/list exists");
        assertEq(True, inlist("get", model_children), "models/get exists");
        assertEq(True, inlist("create", model_children), "models/create exists");
        assertEq(True, inlist("update", model_children), "models/update exists");
        assertEq(True, inlist("delete", model_children), "models/delete exists");
    }

    testListModels() {
        AbstractDataProvider list_dp = provider.getChildProvider("models").getChildProvider("list");
        auto result = list_dp.doRequest({"limit": 10, "search": "llama"});
        assertEq("GET", fake_rest.last_method, "list models uses GET");
        assertRegex("models\\?", fake_rest.last_path, "list models path contains models?");
        assertRegex("search=llama", fake_rest.last_path, "list models path contains search param");
        assertRegex("limit=10", fake_rest.last_path, "list models path contains limit param");

        # test filter as list joined with commas
        list_dp.doRequest({"filter": ("text-generation", "pytorch")});
        assertRegex("filter=text-generation%2Cpytorch", fake_rest.last_path,
            "list models filter joins list with commas");

        # test boolean model-specific params (full is now in shared type, config/cardData are model-specific)
        list_dp.doRequest({"full": True, "config": True, "cardData": True});
        assertRegex("full=1", fake_rest.last_path, "list models full param");
        assertRegex("config=1", fake_rest.last_path, "list models config param");
        assertRegex("cardData=1", fake_rest.last_path, "list models cardData param");
    }

    testListModelsPipelineTag() {
        AbstractDataProvider list_dp = provider.getChildProvider("models").getChildProvider("list");
        auto result = list_dp.doRequest({"pipeline_tag": "text-generation"});
        assertEq("GET", fake_rest.last_method, "list models pipeline_tag uses GET");
        assertRegex("pipeline_tag=text-generation", fake_rest.last_path,
            "list models path contains pipeline_tag param");
    }

    testGetModel() {
        AbstractDataProvider get_dp = provider.getChildProvider("models").getChildProvider("get");
        fake_rest.response_body = {
            "id": "meta-llama/Llama-3.1-8B",
            "author": "meta-llama",
            "pipeline_tag": "text-generation",
            "downloads": 1000000,
        };
        auto result = get_dp.doRequest({"repo_id": "meta-llama/Llama-3.1-8B"});
        assertEq("GET", fake_rest.last_method, "get model uses GET");
        assertEq("models/meta-llama/Llama-3.1-8B", fake_rest.last_path, "get model path");
        assertEq("meta-llama/Llama-3.1-8B", result.id, "model id returned");
        fake_rest.response_body = NOTHING;
    }

    testCreateModel() {
        AbstractDataProvider create_dp = provider.getChildProvider("models").getChildProvider("create");
        auto result = create_dp.doRequest({
            "name": "test-model",
            "private": True,
        });
        assertEq("POST", fake_rest.last_method, "create model uses POST");
        assertEq("repos/create", fake_rest.last_path, "create model path");
        assertEq("model", fake_rest.last_request."type", "create model type is model");
        assertEq("test-model", fake_rest.last_request.name, "create model name");
        assertEq(True, fake_rest.last_request."private", "create model private flag");
    }

    testUpdateModel() {
        AbstractDataProvider update_dp = provider.getChildProvider("models").getChildProvider("update");
        auto result = update_dp.doRequest({"repo_id": "my-org/my-model", "visibility": "private"});
        assertEq("PUT", fake_rest.last_method, "update model uses PUT");
        assertEq("models/my-org/my-model/settings", fake_rest.last_path, "update model path");
        assertEq("private", fake_rest.last_request.visibility, "update model visibility");
        # repo_id should be removed from body
        assertEq(NOTHING, fake_rest.last_request.repo_id, "repo_id not in body");

        # test discussionsDisabled field
        update_dp.doRequest({"repo_id": "my-org/my-model", "discussionsDisabled": True});
        assertEq(True, fake_rest.last_request.discussionsDisabled, "update model discussionsDisabled");
    }

    testDeleteModel() {
        AbstractDataProvider delete_dp = provider.getChildProvider("models").getChildProvider("delete");
        auto result = delete_dp.doRequest({"repo_id": "my-org/my-model"});
        assertEq("DELETE", fake_rest.last_method, "delete model uses DELETE");
        assertEq("repos/delete", fake_rest.last_path, "delete model path");
        assertEq("model", fake_rest.last_request."type", "delete model type");
        assertEq("my-org", fake_rest.last_request.organization, "delete model organization");
        assertEq("my-model", fake_rest.last_request.name, "delete model name");
    }

    testListDatasets() {
        AbstractDataProvider list_dp = provider.getChildProvider("datasets").getChildProvider("list");
        auto result = list_dp.doRequest({"search": "imdb"});
        assertEq("GET", fake_rest.last_method, "list datasets uses GET");
        assertRegex("datasets\\?", fake_rest.last_path, "list datasets path");
        assertRegex("search=imdb", fake_rest.last_path, "list datasets search param");

        # test full param
        list_dp.doRequest({"full": True});
        assertRegex("full=1", fake_rest.last_path, "list datasets full param");
    }

    testGetDataset() {
        AbstractDataProvider get_dp = provider.getChildProvider("datasets").getChildProvider("get");
        fake_rest.response_body = {
            "id": "imdb",
            "author": "stanfordnlp",
            "downloads": 500000,
        };
        auto result = get_dp.doRequest({"repo_id": "imdb"});
        assertEq("GET", fake_rest.last_method, "get dataset uses GET");
        assertEq("datasets/imdb", fake_rest.last_path, "get dataset path");
        fake_rest.response_body = NOTHING;
    }

    testCreateDataset() {
        AbstractDataProvider create_dp = provider.getChildProvider("datasets").getChildProvider("create");
        auto result = create_dp.doRequest({"name": "my-dataset"});
        assertEq("POST", fake_rest.last_method, "create dataset uses POST");
        assertEq("repos/create", fake_rest.last_path, "create dataset path");
        assertEq("dataset", fake_rest.last_request."type", "create dataset type is dataset");
    }

    testUpdateDataset() {
        AbstractDataProvider update_dp = provider.getChildProvider("datasets").getChildProvider("update");
        auto result = update_dp.doRequest({"repo_id": "my-org/my-dataset", "visibility": "public"});
        assertEq("PUT", fake_rest.last_method, "update dataset uses PUT");
        assertEq("datasets/my-org/my-dataset/settings", fake_rest.last_path, "update dataset path");
        assertEq("public", fake_rest.last_request.visibility, "update dataset visibility");
        assertEq(NOTHING, fake_rest.last_request.repo_id, "repo_id not in body");
    }

    testDeleteDataset() {
        AbstractDataProvider delete_dp = provider.getChildProvider("datasets").getChildProvider("delete");
        auto result = delete_dp.doRequest({"repo_id": "my-org/my-dataset"});
        assertEq("DELETE", fake_rest.last_method, "delete dataset uses DELETE");
        assertEq("repos/delete", fake_rest.last_path, "delete dataset path");
        assertEq("dataset", fake_rest.last_request."type", "delete dataset type");
        assertEq("my-org", fake_rest.last_request.organization, "delete dataset organization");
        assertEq("my-dataset", fake_rest.last_request.name, "delete dataset name");
    }

    testListSpaces() {
        AbstractDataProvider list_dp = provider.getChildProvider("spaces").getChildProvider("list");
        auto result = list_dp.doRequest({"author": "gradio"});
        assertEq("GET", fake_rest.last_method, "list spaces uses GET");
        assertRegex("spaces\\?", fake_rest.last_path, "list spaces path");
        assertRegex("author=gradio", fake_rest.last_path, "list spaces author param");

        # test full param
        list_dp.doRequest({"full": True});
        assertRegex("full=1", fake_rest.last_path, "list spaces full param");
    }

    testGetSpace() {
        AbstractDataProvider get_dp = provider.getChildProvider("spaces").getChildProvider("get");
        fake_rest.response_body = {
            "id": "gradio/chatbot",
            "author": "gradio",
            "sdk": "gradio",
        };
        auto result = get_dp.doRequest({"repo_id": "gradio/chatbot"});
        assertEq("GET", fake_rest.last_method, "get space uses GET");
        assertEq("spaces/gradio/chatbot", fake_rest.last_path, "get space path");
        fake_rest.response_body = NOTHING;
    }

    testCreateSpace() {
        AbstractDataProvider create_dp = provider.getChildProvider("spaces").getChildProvider("create");
        auto result = create_dp.doRequest({"name": "my-space", "space_sdk": "gradio"});
        assertEq("POST", fake_rest.last_method, "create space uses POST");
        assertEq("repos/create", fake_rest.last_path, "create space path");
        assertEq("space", fake_rest.last_request."type", "create space type is space");
        assertEq("gradio", fake_rest.last_request.sdk, "create space sdk mapped to 'sdk'");
        assertEq(NOTHING, fake_rest.last_request.space_sdk, "space_sdk not sent to API");
    }

    testUpdateSpace() {
        AbstractDataProvider update_dp = provider.getChildProvider("spaces").getChildProvider("update");
        auto result = update_dp.doRequest({"repo_id": "my-org/my-space", "visibility": "protected"});
        assertEq("PUT", fake_rest.last_method, "update space uses PUT");
        assertEq("spaces/my-org/my-space/settings", fake_rest.last_path, "update space path");
        assertEq("protected", fake_rest.last_request.visibility, "update space visibility");
        assertEq(NOTHING, fake_rest.last_request.repo_id, "repo_id not in body");
    }

    testDeleteSpace() {
        AbstractDataProvider delete_dp = provider.getChildProvider("spaces").getChildProvider("delete");
        auto result = delete_dp.doRequest({"repo_id": "my-org/my-space"});
        assertEq("DELETE", fake_rest.last_method, "delete space uses DELETE");
        assertEq("repos/delete", fake_rest.last_path, "delete space path");
        assertEq("space", fake_rest.last_request."type", "delete space type");
        assertEq("my-org", fake_rest.last_request.organization, "delete space organization");
        assertEq("my-space", fake_rest.last_request.name, "delete space name");
    }

    testChatCompletions() {
        # the inference container creates a separate RestClientIo;
        # we test the chat completions provider directly with our fake rest
        FakeHuggingFaceRestClientIo inference_rest = new FakeHuggingFaceRestClientIo();
        inference_rest.response_body = {
            "id": "chatcmpl-test123",
            "object": "chat.completion",
            "created": 1234567890,
            "model": "meta-llama/Llama-3.1-8B-Instruct",
            "choices": (
                {
                    "index": 0,
                    "message": {
                        "role": "assistant",
                        "content": "Machine learning is a subset of AI.",
                    },
                    "finish_reason": "stop",
                },
            ),
            "usage": {
                "prompt_tokens": 10,
                "completion_tokens": 8,
                "total_tokens": 18,
            },
        };
        HuggingFaceDataProvider::HuggingFaceChatCompletionsDataProvider chat_dp(inference_rest);
        auto result = chat_dp.doRequest({
            "model": "meta-llama/Llama-3.1-8B-Instruct",
            "messages": (
                {"role": "user", "content": "What is machine learning?"},
            ),
            "max_tokens": 100,
        });
        assertEq("POST", inference_rest.last_method, "chat completions uses POST");
        assertEq("chat/completions", inference_rest.last_path, "chat completions path");
        assertEq("meta-llama/Llama-3.1-8B-Instruct", inference_rest.last_request.model,
            "chat completions model");
        assertEq(False, inference_rest.last_request.stream, "streaming forced off");
        assertEq("Machine learning is a subset of AI.", result.output_text,
            "output_text convenience field");
        assertEq("chatcmpl-test123", result.id, "completion id");
        assertEq(18, result.usage.total_tokens, "total tokens");

        # test response_format and logprobs params
        chat_dp.doRequest({
            "model": "meta-llama/Llama-3.1-8B-Instruct",
            "messages": ({"role": "user", "content": "Return JSON."},),
            "response_format": {"type": "json_object"},
            "logprobs": True,
            "top_logprobs": 3,
        });
        assertEq("json_object", inference_rest.last_request.response_format."type",
            "response_format type passed");
        assertEq(True, inference_rest.last_request.logprobs, "logprobs passed");
        assertEq(3, inference_rest.last_request.top_logprobs, "top_logprobs passed");
    }

    testReferenceData() {
        fake_rest.response_body = NOTHING;
        *hash<string, bool> ref_data = provider.getSupportedReferenceData();
        assertEq(True, ref_data.models, "models reference data supported");
        assertEq(True, ref_data.datasets, "datasets reference data supported");
        assertEq(True, ref_data.spaces, "spaces reference data supported");
    }

    testDataTypes() {
        # Model data type
        HuggingFaceDataProvider::HuggingFaceModelDataType model_type();
        *hash<string, AbstractDataField> model_fields = model_type.getFields();
        assertTrue(model_fields.hasKey("id"), "model type has id field");
        assertTrue(model_fields.hasKey("pipeline_tag"), "model type has pipeline_tag field");
        assertTrue(model_fields.hasKey("downloads"), "model type has downloads field");
        assertTrue(model_fields.hasKey("likes"), "model type has likes field");
        assertTrue(model_fields.hasKey("tags"), "model type has tags field");
        assertTrue(model_fields.hasKey("gated"), "model type has gated field");
        assertTrue(model_fields.hasKey("trendingScore"), "model type has trendingScore field");

        # Dataset data type
        HuggingFaceDataProvider::HuggingFaceDatasetDataType dataset_type();
        *hash<string, AbstractDataField> dataset_fields = dataset_type.getFields();
        assertTrue(dataset_fields.hasKey("id"), "dataset type has id field");
        assertTrue(dataset_fields.hasKey("downloads"), "dataset type has downloads field");
        assertTrue(dataset_fields.hasKey("author"), "dataset type has author field");
        assertTrue(dataset_fields.hasKey("description"), "dataset type has description field");
        assertTrue(dataset_fields.hasKey("tags"), "dataset type has tags field");
        assertTrue(dataset_fields.hasKey("gated"), "dataset type has gated field");
        assertTrue(dataset_fields.hasKey("trendingScore"), "dataset type has trendingScore field");

        # Space data type
        HuggingFaceDataProvider::HuggingFaceSpaceDataType space_type();
        *hash<string, AbstractDataField> space_fields = space_type.getFields();
        assertTrue(space_fields.hasKey("id"), "space type has id field");
        assertTrue(space_fields.hasKey("sdk"), "space type has sdk field");
        assertTrue(space_fields.hasKey("likes"), "space type has likes field");
        assertTrue(space_fields.hasKey("subdomain"), "space type has subdomain field");
        assertTrue(space_fields.hasKey("host"), "space type has host field");
        assertTrue(space_fields.hasKey("tags"), "space type has tags field");
        assertTrue(space_fields.hasKey("gated"), "space type has gated field");
        assertTrue(space_fields.hasKey("trendingScore"), "space type has trendingScore field");

        # Chat completions request type
        HuggingFaceDataProvider::HuggingFaceChatCompletionsRequestDataType chat_req_type();
        *hash<string, AbstractDataField> chat_req_fields = chat_req_type.getFields();
        assertTrue(chat_req_fields.hasKey("model"), "chat request has model field");
        assertTrue(chat_req_fields.hasKey("messages"), "chat request has messages field");
        assertTrue(chat_req_fields.hasKey("max_tokens"), "chat request has max_tokens field");
        assertTrue(chat_req_fields.hasKey("temperature"), "chat request has temperature field");
        assertTrue(chat_req_fields.hasKey("frequency_penalty"), "chat request has frequency_penalty field");
        assertTrue(chat_req_fields.hasKey("presence_penalty"), "chat request has presence_penalty field");
        assertTrue(chat_req_fields.hasKey("seed"), "chat request has seed field");
        assertTrue(chat_req_fields.hasKey("response_format"), "chat request has response_format field");
        assertTrue(chat_req_fields.hasKey("logprobs"), "chat request has logprobs field");
        assertTrue(chat_req_fields.hasKey("top_logprobs"), "chat request has top_logprobs field");

        # Chat completions response type
        HuggingFaceDataProvider::HuggingFaceChatCompletionsResponseDataType chat_resp_type();
        *hash<string, AbstractDataField> chat_resp_fields = chat_resp_type.getFields();
        assertTrue(chat_resp_fields.hasKey("id"), "chat response has id field");
        assertTrue(chat_resp_fields.hasKey("system_fingerprint"), "chat response has system_fingerprint");
        assertTrue(chat_resp_fields.hasKey("choices"), "chat response has choices field");
        assertTrue(chat_resp_fields.hasKey("usage"), "chat response has usage field");
        assertTrue(chat_resp_fields.hasKey("output_text"), "chat response has output_text field");

        # Chat message type
        HuggingFaceDataProvider::HuggingFaceChatMessageDataType msg_type();
        *hash<string, AbstractDataField> msg_fields = msg_type.getFields();
        assertTrue(msg_fields.hasKey("role"), "message type has role field");
        assertTrue(msg_fields.hasKey("content"), "message type has content field");

        # Response format type
        HuggingFaceDataProvider::HuggingFaceChatResponseFormatDataType fmt_type();
        *hash<string, AbstractDataField> fmt_fields = fmt_type.getFields();
        assertTrue(fmt_fields.hasKey("type"), "response format type has type field");

        # Update request types have discussionsDisabled
        HuggingFaceDataProvider::HuggingFaceModelUpdateRequestDataType model_update_type();
        *hash<string, AbstractDataField> model_update_fields = model_update_type.getFields();
        assertTrue(model_update_fields.hasKey("discussionsDisabled"),
            "model update type has discussionsDisabled field");

        # List request type has full param
        HuggingFaceDataProvider::HuggingFaceListRequestDataType list_type();
        *hash<string, AbstractDataField> list_fields = list_type.getFields();
        assertTrue(list_fields.hasKey("full"), "list request type has full field");
    }

    # ---- Integration tests (require connection) ----

    testIntegrationListModels() {
        if (!live_provider) {
            testSkip("no connection; use -c <connection> or set HUGGINGFACE_TOKEN");
        }
        AbstractDataProvider list_dp = live_provider.getChildProvider("models").getChildProvider("list");
        auto result = list_dp.doRequest({"limit": 3, "sort": "downloads", "direction": -1});
        assertEq(Type::List, result.type(), "list models returns a list");
        assertTrue(result.size() > 0, "list models returns results");
        assertTrue(result[0].id.val(), "first model has id");
        assertTrue(result[0].downloads >= 0, "first model has downloads");
    }

    testIntegrationGetModel() {
        if (!live_provider) {
            testSkip("no connection; use -c <connection> or set HUGGINGFACE_TOKEN");
        }
        AbstractDataProvider get_dp = live_provider.getChildProvider("models").getChildProvider("get");
        auto result = get_dp.doRequest({"repo_id": "google-bert/bert-base-uncased"});
        assertEq("google-bert/bert-base-uncased", result.id, "get model returns correct id");
        assertTrue(result.downloads > 0, "bert-base-uncased has downloads");
    }

    testIntegrationListDatasets() {
        if (!live_provider) {
            testSkip("no connection; use -c <connection> or set HUGGINGFACE_TOKEN");
        }
        AbstractDataProvider list_dp = live_provider.getChildProvider("datasets").getChildProvider("list");
        auto result = list_dp.doRequest({"limit": 3, "sort": "downloads", "direction": -1});
        assertEq(Type::List, result.type(), "list datasets returns a list");
        assertTrue(result.size() > 0, "list datasets returns results");
        assertTrue(result[0].id.val(), "first dataset has id");
    }

