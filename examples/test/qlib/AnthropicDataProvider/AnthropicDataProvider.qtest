    liveCreateMessageTest() {
        checkModule();
%ifndef NoJson
        if (!rc) {
            testSkip("no ANTHROPIC_CONNECTION set");
        }
        AnthropicDataProvider prov(rc.getAsync());
        AbstractDataProvider create = prov.getChildProvider("messages").getChildProvider("create");
        hash<auto> resp = create.doRequest({
            "model": "claude-haiku-4-5-20241022",
            "max_tokens": 64,
            "messages": ({"role": "user", "content": "Say exactly: integration test ok"},),
        });
        assertEq("message", resp.type);
        assertEq("assistant", resp.role);
        assertTrue(resp.output_text.val());
        assertTrue(resp.stop_reason.val());
        assertTrue(resp.usage.input_tokens > 0);
%endif
    }

    liveModelsListTest() {
        checkModule();
