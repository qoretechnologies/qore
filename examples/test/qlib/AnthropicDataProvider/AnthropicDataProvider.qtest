        assertEq(True, action.options.hasKey("source"));
%endif
    }

    exampleEventDataTest() {
        checkModule();
%ifndef NoJson
        # the fake rest client returns a successful response, so getExampleEventDataImpl
        # returns the API response rather than falling back to fake data
        FakeAnthropicRestClientIo rest();
        AnthropicMessageStreamDataProvider stream(rest);
        auto example = stream.getExampleEventData(AnthropicDataProvider::EVENT_ANTHROPIC_MESSAGE_STREAM);
        assertEq(True, example instanceof hash);
        # the fake client returns type="message" from restPost
        assertEq("message", example.type);
        assertEq("message_start", example.event);
%endif
    }

    dataTypesTest() {
        checkModule();
%ifndef NoJson
        # verify AnthropicJsonSchemaDataType fields
        AnthropicJsonSchemaDataType schema_type();
        hash<string, AbstractDataField> schema_fields = schema_type.getFields();
        assertEq(True, schema_fields.hasKey("type"));
        assertEq(True, schema_fields.hasKey("properties"));
        assertEq(True, schema_fields.hasKey("required"));
        assertEq(True, schema_fields.hasKey("description"));

        # verify AnthropicContentBlockDataType fields
        AnthropicContentBlockDataType block_type();
        hash<string, AbstractDataField> block_fields = block_type.getFields();
        assertEq(True, block_fields.hasKey("type"));
        assertEq(True, block_fields.hasKey("text"));
        assertEq(True, block_fields.hasKey("id"));
        assertEq(True, block_fields.hasKey("name"));
        assertEq(True, block_fields.hasKey("input"));
        assertEq(True, block_fields.hasKey("thinking"));

        # verify AnthropicOutputConfigDataType fields
        AnthropicOutputConfigDataType output_config_type();
        hash<string, AbstractDataField> oc_fields = output_config_type.getFields();
        assertEq(True, oc_fields.hasKey("format"));
        assertEq(True, oc_fields.hasKey("effort"));

        # verify new fields in request type
        assertEq(True, AnthropicMessageRequestDataType::Fields.hasKey("service_tier"));
        assertEq(True, AnthropicMessageRequestDataType::Fields.hasKey("output_config"));
        assertEq(True, AnthropicMessageRequestDataType::Fields.hasKey("container"));

        # verify thinking config has adaptive option
        hash<auto> thinking_field = AnthropicMessageRequestDataType::Fields.thinking;
        assertEq(True, thinking_field instanceof hash);

        # verify model data type has new fields
        AnthropicModelDataType model_type();
        hash<string, AbstractDataField> model_fields = model_type.getFields();
        assertEq(True, model_fields.hasKey("max_input_tokens"));
        assertEq(True, model_fields.hasKey("max_tokens"));

        # verify count tokens request has thinking field
        assertEq(True, AnthropicCountTokensRequestDataType::Fields.hasKey("thinking"));

        # verify response type has container field with typed sub-type
        assertEq(True, AnthropicMessageResponseDataType::Fields.hasKey("container"));
        AnthropicContainerDataType container_type();
        hash<string, AbstractDataField> container_fields = container_type.getFields();
        assertEq(True, container_fields.hasKey("id"));
        assertEq(True, container_fields.hasKey("expires_at"));

        # verify delta data type fields
        AnthropicDeltaDataType delta_type();
        hash<string, AbstractDataField> delta_fields = delta_type.getFields();
        assertEq(True, delta_fields.hasKey("type"));
        assertEq(True, delta_fields.hasKey("text"));
        assertEq(True, delta_fields.hasKey("partial_json"));
        assertEq(True, delta_fields.hasKey("thinking"));
        assertEq(True, delta_fields.hasKey("signature"));
        assertEq(True, delta_fields.hasKey("stop_reason"));
        assertEq(True, delta_fields.hasKey("stop_sequence"));

        # verify stream event type uses typed sub-types
        AnthropicStreamEventDataType stream_evt_type();
        hash<string, AbstractDataField> stream_fields = stream_evt_type.getFields();
        assertEq(True, stream_fields.hasKey("message"));
        assertEq(True, stream_fields.hasKey("content_block"));
        assertEq(True, stream_fields.hasKey("delta"));

        # verify file content response type
        AnthropicFileContentResponseDataType content_type();
        hash<string, AbstractDataField> content_fields = content_type.getFields();
        assertEq(True, content_fields.hasKey("file"));

        # verify model list request type has pagination
        AnthropicModelListRequestDataType model_list_req();
        hash<string, AbstractDataField> model_list_fields = model_list_req.getFields();
        assertEq(True, model_list_fields.hasKey("limit"));
        assertEq(True, model_list_fields.hasKey("after_id"));
        assertEq(True, model_list_fields.hasKey("before_id"));

        # verify file list request type has pagination
        AnthropicFileListRequestDataType file_list_req();
        hash<string, AbstractDataField> file_list_fields = file_list_req.getFields();
        assertEq(True, file_list_fields.hasKey("limit"));
        assertEq(True, file_list_fields.hasKey("after_id"));
        assertEq(True, file_list_fields.hasKey("before_id"));

        # verify skill list request type has pagination and filter
        AnthropicSkillListRequestDataType skill_list_req();
        hash<string, AbstractDataField> skill_list_fields = skill_list_req.getFields();
        assertEq(True, skill_list_fields.hasKey("limit"));
        assertEq(True, skill_list_fields.hasKey("page"));
        assertEq(True, skill_list_fields.hasKey("source"));

        # verify skill response type has latest_version
        AnthropicSkillResponseDataType skill_resp();
        hash<string, AbstractDataField> skill_fields = skill_resp.getFields();
        assertEq(True, skill_fields.hasKey("latest_version"));
%endif
    }

    liveConnectionPingTest() {
