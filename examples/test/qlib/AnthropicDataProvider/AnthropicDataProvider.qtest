        FakeAnthropicRestClientIo rest();
        AnthropicMessageActionSession session({"restclient": rest});
        assertThrows("INVALID-ACTION", sub () {
            session.handleAction("invalid-action");
        });
%endif
    }

    betaHeadersTest() {
        checkModule();
%ifndef NoJson
        FakeAnthropicRestClientIo rest();
        rest.response_body = {
            "id": "skill_test",
            "type": "skill",
            "display_title": "Test",
        };
        AnthropicDataProvider prov(rest);

        # test that Skills API passes beta headers
        AbstractDataProvider skill_create = prov.getChildProvider("skills").getChildProvider("create");
        skill_create.doRequest({"name": "test-skill", "display_title": "Test", "description": "Test skill"});
        assertEq("POST", rest.last_method);
        assertEq("skills", rest.last_path);
        assertEq("skills-2025-10-02", rest.last_headers."anthropic-beta");

        # test that Files API passes beta headers
        rest.response_body = {
            "id": "file_test",
            "type": "file",
            "filename": "test.pdf",
        };
        AbstractDataProvider file_upload = prov.getChildProvider("files").getChildProvider("upload");
        file_upload.doRequest({"file": {"name": "test.pdf", "content": "dGVzdA==", "mime_type": "application/pdf"}});
        assertEq("POST", rest.last_method);
        assertEq("files", rest.last_path);
        assertEq("files-api-2025-04-14", rest.last_headers."anthropic-beta");

        # test that Files delete passes beta headers
        rest.response_body = {"id": "file_del", "type": "file_deleted"};
        AbstractDataProvider file_del = prov.getChildProvider("files").getChildProvider("delete");
        file_del.doRequest({"file_id": "file_del"});
        assertEq("DELETE", rest.last_method);
        assertEq("files/file_del", rest.last_path);
        assertEq("files-api-2025-04-14", rest.last_headers."anthropic-beta");
%endif
    }

    filesPaginationTest() {
        checkModule();
%ifndef NoJson
        FakeAnthropicRestClientIo rest();
        AnthropicDataProvider prov(rest);
        AbstractDataProvider files_list = prov.getChildProvider("files").getChildProvider("list");

        # verify request type has pagination fields
        *AbstractDataProviderType req_type = files_list.getRequestType();
        assertEq(True, req_type instanceof AbstractDataProviderType);
        hash<string, AbstractDataField> fields = req_type.getFields();
        assertEq(True, fields.hasKey("limit"));
        assertEq(True, fields.hasKey("after_id"));
        assertEq(True, fields.hasKey("before_id"));

        # test with pagination params
        files_list.doRequest({"limit": 5, "after_id": "file_abc"});
        assertEq("GET", rest.last_method);
        assertRegex("limit=5", rest.last_path);
        assertRegex("after_id=file_abc", rest.last_path);

        # test action catalog has options
        hash<DataProviderActionInfo> action = DataProviderActionCatalog::getAppAction(
            AnthropicDataProvider::AppName, "list-files"
        );
        assertEq(True, action.options.hasKey("limit"));
%endif
    }

    skillsPaginationTest() {
        checkModule();
