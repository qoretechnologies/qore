    }

    private setupConnection() {
%ifndef NoJson
        *string conn_name = m_options.conn ?? ENV.ANTHROPIC_CONNECTION;
        if (conn_name.val()) {
            AbstractConnection conn = get_connection(conn_name);
            if (conn instanceof AnthropicRestClient::AnthropicRestConnection) {
                rc = cast<AnthropicRestClient::AnthropicRestConnection>(conn);
            }
        }
%endif
    }
}
