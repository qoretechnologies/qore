    liveCountTokensTest() {
        checkModule();
%ifndef NoJson
        if (!rc) {
            testSkip("no ANTHROPIC_CONNECTION set");
        }
        AnthropicDataProvider prov(rc.getAsync());
        AbstractDataProvider ct = prov.getChildProvider("count-tokens");
        hash<auto> resp = ct.doRequest({
            "model": "claude-haiku-4-5-20241022",
            "messages": ({"role": "user", "content": "Count my tokens"},),
        });
