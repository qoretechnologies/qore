#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/DataProvider
%requires ../../../../qlib/AnthropicDataProvider

%try-module json
%define NoJson
%endtry

%exec-class AnthropicDataProviderTest

class FakeConnectionManager {
    public {
        FakeAnthropicRestClientIo fake_rest;
    }

    constructor(FakeAnthropicRestClientIo rest) {
        fake_rest = rest;
    }

    hash<auto> request(string url, string method, string path, hash<auto> hdr, binary body) {
        fake_rest.last_method = method;
        # strip /v1/ prefix from path for test assertions
        fake_rest.last_path = path;
        fake_rest.last_path =~ s/^\/v1\///;
        fake_rest.last_headers = hdr;
        return {
            "status_code": 200,
            "body": make_json(fake_rest.response_body ?? {
                "id": "test_id",
                "type": "skill",
                "display_title": "Test",
                "source": "custom",
            }),
            "headers": {},
        };
    }
}

class FakeAnthropicRestClientIo inherits RestClientIo::RestClientIo {
    public {
        hash<auto> last_request;
        string last_method;
        string last_path;
        *hash<auto> last_headers;
        hash<auto> response_body;
        hash<auto> last_stream_request;
        list<hash<SseMessageInfo>> stream_events;
        FakeConnectionManager conn_mgr;
    }

    constructor() : RestClientIo({"url": "https://api.anthropic.com", "token": "x", "data": "json"}) {
        conn_mgr = new FakeConnectionManager(self);
    }

    FakeConnectionManager getConnectionManager() {
        return conn_mgr;
    }

    string getUrl() {
        return "https://api.anthropic.com";
    }

    string getConnectionPath() {
        return "v1";
    }

    hash<RestClient::RestResponseInfo> restPost(string path, auto body, *hash<auto> hdr) {
        last_method = "POST";
        last_path = path;
        last_request = body;
        last_headers = hdr;
        if (!response_body) {
            response_body = {
                "id": "msg_test123",
                "type": "message",
                "role": "assistant",
                "content": (
                    {
                        "type": "text",
                        "text": "Hello! How can I help you?",
                    },
                ),
                "model": "claude-sonnet-4-6-20250514",
                "stop_reason": "end_turn",
                "usage": {
                    "input_tokens": 10,
                    "output_tokens": 15,
                },
            };
        }
        return <RestClient::RestResponseInfo>{
            "body": response_body,
        };
    }

    hash<RestClient::RestResponseInfo> restGet(string path, *hash<auto> hdr) {
        last_method = "GET";
        last_path = path;
        last_headers = hdr;
        return <RestClient::RestResponseInfo>{
            "body": {
                "data": (
                    {
                        "id": "claude-sonnet-4-6-20250514",
                        "display_name": "Claude Sonnet 4.6",
                        "type": "model",
                        "created_at": "2025-05-14T00:00:00Z",
                        "max_input_tokens": 1000000,
                        "max_tokens": 64000,
                    },
                ),
            },
        };
    }

    hash<RestClient::RestResponseInfo> restDel(string path, auto body, *hash<auto> hdr) {
        last_method = "DELETE";
        last_path = path;
        last_headers = hdr;
        return <RestClient::RestResponseInfo>{
            "body": response_body ?? {"id": "deleted", "type": "deleted"},
        };
    }

    auto openMessagesStream(hash<auto> req, *hash<auto> hdr, *timeout to) {
        last_stream_request = req;
        return new FakeAnthropicSseStream(stream_events);
    }
}

class FailingAnthropicRestClientIo inherits FakeAnthropicRestClientIo {
    auto openMessagesStream(hash<auto> req, *hash<auto> hdr, *timeout to) {
        throw "SSE-ERROR", "stream failed";
    }
}

class TestAnthropicConversationStore inherits AnthropicConversationContextStore {
    public {
        hash<auto> stored;
        string last_load_key;
        string last_save_key;
        hash<auto> last_saved;
    }

    *hash<auto> loadContext(string key) {
        last_load_key = key;
        return stored{key};
    }

    auto saveContext(string key, hash<auto> ctxt) {
        last_save_key = key;
        last_saved = ctxt;
        stored{key} = ctxt;
    }
}

class FakeAnthropicSseStream {
    public {
        list<hash<SseMessageInfo>> events;
        int idx;
        bool done_flag = False;
    }

    constructor(*list<hash<SseMessageInfo>> events) {
        self.events = events ?? ();
    }

    *hash<SseMessageInfo> readEvent(*timeout to) {
        if (idx >= events.lsize()) {
            done_flag = True;
            return;
        }
        return events[idx++];
    }

    bool isDone() {
        return done_flag;
    }

    close() {
    }
}

class StreamObserver inherits Observer {
    public {
        list<hash<auto>> events = ();
    }

    private {
        Mutex m();
        Condition cond();
    }

    update(string event_id, hash<auto> data_) {
        events += data_;
        m.lock();
        on_exit m.unlock();
        cond.broadcast();
    }

    wait(int count) {
        date start = now_us();
        m.lock();
        on_exit m.unlock();
        while (events.lsize() < count) {
            cond.wait(m, 1s);
            if ((now_us() - start) > 5s) {
                throw "ERROR", "no stream events in timeout";
            }
        }
    }
}

public class AnthropicDataProviderTest inherits QUnit::Test {
    public {
%ifndef NoJson
        *AnthropicRestClient::AnthropicRestConnection rc;
%endif
        Logger logger;

        # command-line options
        const MyOpts = Opts + {
            "conn": "c,connection=s",
        };

        const OptionColumn = 22;
    }

    constructor() : Test("AnthropicDataProvider Test", "1.0", \ARGV, MyOpts) {
        addTestCase("sanity test", \sanityTest());
        addTestCase("action catalog", \actionCatalogTest());
        addTestCase("child providers", \childProvidersTest());
        addTestCase("create message", \createMessageTest());
        addTestCase("create message with tools", \createMessageWithToolsTest());
        addTestCase("create message with file", \createMessageWithFileTest());
        addTestCase("conversation context save", \conversationContextSaveTest());
        addTestCase("conversation callback store", \conversationCallbackStoreTest());
        addTestCase("stream events", \streamEventsTest());
        addTestCase("stream error", \streamErrorTest());
        addTestCase("count tokens", \countTokensTest());
        addTestCase("models list", \modelsListTest());
        addTestCase("action session create", \actionSessionCreateTest());
        addTestCase("action session stream", \actionSessionStreamTest());
        addTestCase("action session invalid", \actionSessionInvalidTest());
        addTestCase("beta headers passed", \betaHeadersTest());
        addTestCase("files pagination", \filesPaginationTest());
        addTestCase("skills pagination", \skillsPaginationTest());
        addTestCase("example event data", \exampleEventDataTest());
        addTestCase("data types", \dataTypesTest());
        addTestCase("live connection ping", \liveConnectionPingTest());
        addTestCase("live create message", \liveCreateMessageTest());
        addTestCase("live models list", \liveModelsListTest());
        addTestCase("live count tokens", \liveCountTokensTest());

        try {
            setupConnection();
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose > 2) {
                printf("%s\n", get_exception_string(ex));
            } else if (m_options.verbose) {
                printf("%s: %s\n", ex.err, ex.desc);
            }
        }

        # Return for compatibility with test harness that checks return value.
        set_return_value(main());
    }

    checkModule() {
%ifdef NoJson
        testSkip("no json module");
%endif
    }

    sanityTest() {
        checkModule();
%ifndef NoJson
        FakeAnthropicRestClientIo rest();
        AnthropicDataProvider prov(rest);
        assertEq("anthropic", prov.getName());
        assertEq(("batches", "count-tokens", "files", "messages", "models", "skills"),
            sort(prov.getChildProviderNames()));
%endif
    }

    actionCatalogTest() {
        # test stream action
        hash<DataProviderActionInfo> action = DataProviderActionCatalog::getAppAction(
            AnthropicDataProvider::AppName, "stream-message"
        );
        assertEq("/messages/stream", action.path);
        assertEq(DPAT_EVENT, action.action_code);
        assertEq(AnthropicDataProvider::EVENT_ANTHROPIC_MESSAGE_STREAM, action.action_val);
        assertEq(True, action.output_type instanceof AnthropicStreamEventDataType);
        assertEq(("Messages",), action.groups);

        # test create action
        action = DataProviderActionCatalog::getAppAction(
            AnthropicDataProvider::AppName, "create-message"
        );
        assertEq("/messages/create", action.path);
        assertEq(DPAT_API, action.action_code);
        assertEq(("Messages",), action.groups);
        # verify new fields are in action options
        assertEq(True, action.options.hasKey("service_tier"));
        assertEq(True, action.options.hasKey("output_schema"));
        assertEq(True, action.options.hasKey("skill"));

        # test count-tokens action
        action = DataProviderActionCatalog::getAppAction(
            AnthropicDataProvider::AppName, "count-tokens"
        );
        assertEq("/count-tokens", action.path);
        assertEq(DPAT_API, action.action_code);
        assertEq(("Messages",), action.groups);

        # test batch actions
        action = DataProviderActionCatalog::getAppAction(
            AnthropicDataProvider::AppName, "create-batch"
        );
        assertEq("/batches/create", action.path);
        assertEq(DPAT_API, action.action_code);
        assertEq(("Batches",), action.groups);

        action = DataProviderActionCatalog::getAppAction(
            AnthropicDataProvider::AppName, "get-model"
        );
        assertEq("/models/get", action.path);
        assertEq(DPAT_API, action.action_code);
        assertEq(("Models",), action.groups);

        # test list-models action
        action = DataProviderActionCatalog::getAppAction(
            AnthropicDataProvider::AppName, "list-models"
        );
        assertEq("/models/list", action.path);
        assertEq(DPAT_API, action.action_code);
        assertEq(("Models",), action.groups);

        # test file actions
        action = DataProviderActionCatalog::getAppAction(
            AnthropicDataProvider::AppName, "upload-file"
        );
        assertEq("/files/upload", action.path);
        assertEq(DPAT_API, action.action_code);
        assertEq(("Files",), action.groups);

        # test get-file-content action
        action = DataProviderActionCatalog::getAppAction(
            AnthropicDataProvider::AppName, "get-file-content"
        );
        assertEq("/files/get-content", action.path);
        assertEq(DPAT_API, action.action_code);
        assertEq(("Files",), action.groups);
        assertEq(True, action.output_type instanceof AbstractDataProviderType);

        # test skill actions
        action = DataProviderActionCatalog::getAppAction(
            AnthropicDataProvider::AppName, "create-skill"
        );
        assertEq("/skills/create", action.path);
        assertEq(DPAT_API, action.action_code);
        assertEq(("Skills",), action.groups);
        # verify description and instructions are preselected
        assertEq(True, action.options.description.preselected);
        assertEq(True, action.options.instructions.preselected);

        # test delete-skill action
        action = DataProviderActionCatalog::getAppAction(
            AnthropicDataProvider::AppName, "delete-skill"
        );
        assertEq("/skills/delete", action.path);
        assertEq(DPAT_API, action.action_code);
        assertEq(("Skills",), action.groups);
    }

    childProvidersTest() {
        checkModule();
%ifndef NoJson
        FakeAnthropicRestClientIo rest();
        AnthropicDataProvider prov(rest);

        # verify batches children
        AbstractDataProvider batches = prov.getChildProvider("batches");
        assertEq(("cancel", "create", "get", "list"), sort(batches.getChildProviderNames()));

        # verify files children
        AbstractDataProvider files = prov.getChildProvider("files");
        assertEq(("delete", "get", "get-content", "list", "upload"), sort(files.getChildProviderNames()));

        # verify skills children
        AbstractDataProvider skills = prov.getChildProvider("skills");
        assertEq(("create", "delete", "get", "list", "update"), sort(skills.getChildProviderNames()));

        # verify models children (now a container)
        AbstractDataProvider models = prov.getChildProvider("models");
        assertEq(("get", "list"), sort(models.getChildProviderNames()));
%endif
    }

    createMessageTest() {
        checkModule();
%ifndef NoJson
        FakeAnthropicRestClientIo rest();
        AnthropicDataProvider prov(rest);
        AbstractDataProvider create = prov.getChildProvider("messages").getChildProvider("create");

        hash<auto> req = {
            "model": "claude-sonnet-4-6-20250514",
            "max_tokens": 1024,
            "messages": (
                {"role": "user", "content": "Hello!"},
            ),
        };
        hash<auto> resp = create.doRequest(req);
        assertEq("POST", rest.last_method);
        assertEq("messages", rest.last_path);
        assertEq("claude-sonnet-4-6-20250514", rest.last_request.model);
        assertEq(1024, rest.last_request.max_tokens);
        # verify stream is not set for non-streaming
        assertNothing(rest.last_request.stream);
        assertEq("Hello! How can I help you?", resp.output_text);
        assertEq("msg_test123", resp.id);
        assertEq("end_turn", resp.stop_reason);
%endif
    }

    createMessageWithToolsTest() {
        checkModule();
%ifndef NoJson
        FakeAnthropicRestClientIo rest();
        rest.response_body = {
            "id": "msg_tool123",
            "type": "message",
            "role": "assistant",
            "content": (
                {
                    "type": "text",
                    "text": "I'll check the weather.",
                },
                {
                    "type": "tool_use",
                    "id": "toolu_01",
                    "name": "get_weather",
                    "input": {"location": "San Francisco"},
                },
            ),
            "model": "claude-sonnet-4-6-20250514",
            "stop_reason": "tool_use",
            "usage": {"input_tokens": 20, "output_tokens": 30},
        };
        AnthropicDataProvider prov(rest);
        AbstractDataProvider create = prov.getChildProvider("messages").getChildProvider("create");

        hash<auto> req = {
            "model": "claude-sonnet-4-6-20250514",
            "max_tokens": 1024,
            "messages": ({"role": "user", "content": "What's the weather?"},),
            "tools": (
                {
                    "name": "get_weather",
                    "description": "Get weather",
                    "input_schema": {
                        "type": "object",
                        "properties": {"location": {"type": "string"}},
                    },
                },
            ),
        };
        hash<auto> resp = create.doRequest(req);
        assertEq("tool_use", resp.stop_reason);
        assertEq("I'll check the weather.", resp.output_text);
        assertEq(1, resp.tool_calls.lsize());
        assertEq("get_weather", resp.tool_calls[0].name);
        assertEq("San Francisco", resp.tool_calls[0].input.location);
%endif
    }

    createMessageWithFileTest() {
        checkModule();
%ifndef NoJson
        FakeAnthropicRestClientIo rest();
        AnthropicDataProvider prov(rest);
        AbstractDataProvider create = prov.getChildProvider("messages").getChildProvider("create");

        # test with image file + text
        hash<auto> req = {
            "model": "claude-sonnet-4-6-20250514",
            "max_tokens": 1024,
            "messages": (
                {
                    "role": "user",
                    "content": "What's in this image?",
                    "file": {
                        "name": "test.png",
                        "content": "iVBORw0KGgo=",
                        "mime_type": "image/png",
                    },
                },
            ),
        };
        hash<auto> resp = create.doRequest(req);
        # verify the message was converted to content blocks
        auto sent_content = rest.last_request.messages[0].content;
        assertEq(NT_LIST, sent_content.typeCode(), "content should be a list");
        assertEq(2, sent_content.lsize(), "should have text + image blocks");
        assertEq("text", sent_content[0].type);
        assertEq("What's in this image?", sent_content[0].text);
        assertEq("image", sent_content[1].type);
        assertEq("base64", sent_content[1].source.type);
        assertEq("image/png", sent_content[1].source.media_type);
        assertEq("iVBORw0KGgo=", sent_content[1].source.data);
        # file should be stripped from the sent message
        assertNothing(rest.last_request.messages[0].file);

        # test with PDF file
        rest.last_request = {};
        req = {
            "model": "claude-sonnet-4-6-20250514",
            "max_tokens": 1024,
            "messages": (
                {
                    "role": "user",
                    "content": "Summarize this document",
                    "file": {
                        "name": "doc.pdf",
                        "content": "JVBERi0=",
                        "mime_type": "application/pdf",
                    },
                },
            ),
        };
        resp = create.doRequest(req);
        sent_content = rest.last_request.messages[0].content;
        assertEq("document", sent_content[1].type);
        assertEq("application/pdf", sent_content[1].source.media_type);

        # test with file only — no text content
        rest.last_request = {};
        req = {
            "model": "claude-sonnet-4-6-20250514",
            "max_tokens": 1024,
            "messages": (
                {
                    "role": "user",
                    "file": {
                        "name": "photo.jpg",
                        "content": "/9j/4AAQ=",
                        "mime_type": "image/jpeg",
                    },
                },
            ),
        };
        resp = create.doRequest(req);
        sent_content = rest.last_request.messages[0].content;
        assertEq(NT_LIST, sent_content.typeCode(), "file-only should be a list");
        assertEq(1, sent_content.lsize(), "should have only image block");
        assertEq("image", sent_content[0].type);

        # test without file — content stays as string
        rest.last_request = {};
        req = {
            "model": "claude-sonnet-4-6-20250514",
            "max_tokens": 1024,
            "messages": ({"role": "user", "content": "Hello!"},),
        };
        resp = create.doRequest(req);
        assertEq(NT_STRING, rest.last_request.messages[0].content.typeCode(),
            "plain text message should stay as string");
%endif
    }

    conversationContextSaveTest() {
        checkModule();
%ifndef NoJson
        FakeAnthropicRestClientIo rest();
        AnthropicDataProvider prov(rest);
        TestAnthropicConversationStore store();
        prov.setConversationContextStore(store);
        AnthropicMessageCreateDataProvider create =
            cast<AnthropicMessageCreateDataProvider>(prov.getChildProvider("messages").getChildProvider("create"));
        create.setConversationContextStore(store);

        hash<auto> req = {
            "model": "claude-sonnet-4-6-20250514",
            "max_tokens": 1024,
            "messages": ({"role": "user", "content": "Hi"},),
            "conversation_key": "test-conv",
        };
        hash<auto> resp = create.doRequest(req);
        assertEq("test-conv", store.last_save_key);
        assertEq(True, store.last_saved.messages.lsize() > 0);
        # the saved messages should include the user message and assistant response
        assertEq("user", store.last_saved.messages[0].role);
        assertEq("assistant", store.last_saved.messages[1].role);

        # second call should load context and prepend messages
        hash<auto> req2 = {
            "model": "claude-sonnet-4-6-20250514",
            "max_tokens": 1024,
            "messages": ({"role": "user", "content": "Follow up"},),
            "conversation_key": "test-conv",
        };
        create.doRequest(req2);
        # should have loaded context
        assertEq("test-conv", store.last_load_key);
        # the request should have prepended the stored messages
        assertTrue(rest.last_request.messages.lsize() > 1);
%endif
    }

    conversationCallbackStoreTest() {
        checkModule();
%ifndef NoJson
        hash<auto> saved_data;
        string saved_key;
        AnthropicConversationContextStoreCallbacks store(
            *hash<auto> sub (string key) { return saved_data; },
            nothing sub (string key, hash<auto> ctxt) { saved_key = key; saved_data = ctxt; }
        );

        FakeAnthropicRestClientIo rest();
        AnthropicDataProvider prov(rest);
        AnthropicMessageCreateDataProvider create =
            cast<AnthropicMessageCreateDataProvider>(prov.getChildProvider("messages").getChildProvider("create"));
        create.setConversationContextStore(store);

        hash<auto> req = {
            "model": "claude-sonnet-4-6-20250514",
            "max_tokens": 1024,
            "messages": ({"role": "user", "content": "Hi"},),
            "conversation_key": "cb-test",
        };
        create.doRequest(req);
        assertEq("cb-test", saved_key);
        assertEq(True, saved_data.messages.lsize() > 0);
%endif
    }

    streamEventsTest() {
        checkModule();
%ifndef NoJson
        FakeAnthropicRestClientIo rest();
        rest.stream_events = (
            <SseMessageInfo>{
                "event": "message_start",
                "data": "{\"type\":\"message_start\",\"message\":{\"id\":\"msg_s1\",\"type\":\"message\","
                    "\"role\":\"assistant\",\"content\":[],\"model\":\"claude-sonnet-4-6-20250514\"}}",
            },
            <SseMessageInfo>{
                "event": "content_block_start",
                "data": "{\"type\":\"content_block_start\",\"index\":0,"
                    "\"content_block\":{\"type\":\"text\",\"text\":\"\"}}",
            },
            <SseMessageInfo>{
                "event": "content_block_delta",
                "data": "{\"type\":\"content_block_delta\",\"index\":0,"
                    "\"delta\":{\"type\":\"text_delta\",\"text\":\"Hello\"}}",
            },
            <SseMessageInfo>{
                "event": "content_block_stop",
                "data": "{\"type\":\"content_block_stop\",\"index\":0}",
            },
            <SseMessageInfo>{
                "event": "message_delta",
                "data": "{\"type\":\"message_delta\",\"delta\":{\"stop_reason\":\"end_turn\"},"
                    "\"usage\":{\"output_tokens\":5}}",
            },
            <SseMessageInfo>{
                "event": "message_stop",
                "data": "{\"type\":\"message_stop\"}",
            },
        );

        AnthropicMessageStreamDataProvider stream(rest);
        StreamObserver obs();
        stream.registerObserver(obs);
        stream.observersReady();
        stream.doRequest({
            "model": "claude-sonnet-4-6-20250514",
            "max_tokens": 1024,
            "messages": ({"role": "user", "content": "Hello!"},),
        });
        obs.wait(6);

        assertEq("message_start", obs.events[0].type);
        assertEq("msg_s1", obs.events[0].message.id);
        assertEq("content_block_start", obs.events[1].type);
        assertEq("content_block_delta", obs.events[2].type);
        assertEq("Hello", obs.events[2].delta.text);
        assertEq("content_block_stop", obs.events[3].type);
        assertEq("message_delta", obs.events[4].type);
        assertEq("end_turn", obs.events[4].delta.stop_reason);
        assertEq("message_stop", obs.events[5].type);

        # verify stream request had stream=True
        assertEq(True, rest.last_stream_request.stream);
%endif
    }

    streamErrorTest() {
        checkModule();
%ifndef NoJson
        FailingAnthropicRestClientIo rest();
        AnthropicMessageStreamDataProvider stream(rest);
        StreamObserver obs();
        stream.registerObserver(obs);
        stream.observersReady();
        stream.doRequest({
            "model": "claude-sonnet-4-6-20250514",
            "max_tokens": 1024,
            "messages": ({"role": "user", "content": "Hello!"},),
        });
        obs.wait(1);
        assertEq("error", obs.events[0].type);
        assertEq(True, obs.events[0].error instanceof hash);
%endif
    }

    countTokensTest() {
        checkModule();
%ifndef NoJson
        FakeAnthropicRestClientIo rest();
        rest.response_body = {
            "input_tokens": 42,
        };
        AnthropicDataProvider prov(rest);
        AbstractDataProvider ct = prov.getChildProvider("count-tokens");
        hash<auto> resp = ct.doRequest({
            "model": "claude-sonnet-4-6-20250514",
            "messages": ({"role": "user", "content": "Count my tokens"},),
        });
        assertEq("POST", rest.last_method);
        assertEq("messages/count_tokens", rest.last_path);
        assertEq(42, resp.input_tokens);
%endif
    }

    modelsListTest() {
        checkModule();
%ifndef NoJson
        FakeAnthropicRestClientIo rest();
        AnthropicDataProvider prov(rest);
        AbstractDataProvider models = prov.getChildProvider("models").getChildProvider("list");

        # verify request type has pagination fields
        *AbstractDataProviderType req_type = models.getRequestType();
        assertEq(True, req_type instanceof AbstractDataProviderType);
        hash<string, AbstractDataField> fields = req_type.getFields();
        assertEq(True, fields.hasKey("limit"));
        assertEq(True, fields.hasKey("after_id"));
        assertEq(True, fields.hasKey("before_id"));

        # test without pagination (default limit=20 is still sent)
        auto resp = models.doRequest(NOTHING);
        assertEq("GET", rest.last_method);
        assertRegex("^models", rest.last_path);
        assertEq(1, resp.lsize());
        assertEq("claude-sonnet-4-6-20250514", resp[0].id);
        assertEq(1000000, resp[0].max_input_tokens);
        assertEq(64000, resp[0].max_tokens);

        # test with pagination params
        models.doRequest({"limit": 5, "after_id": "claude-haiku-4-5-20241022"});
        assertEq("GET", rest.last_method);
        assertRegex("limit=5", rest.last_path);
        assertRegex("after_id=claude-haiku-4-5-20241022", rest.last_path);

        # test action catalog has options
        hash<DataProviderActionInfo> action = DataProviderActionCatalog::getAppAction(
            AnthropicDataProvider::AppName, "list-models"
        );
        assertEq(True, action.options.hasKey("limit"));
%endif
    }

    actionSessionCreateTest() {
        checkModule();
%ifndef NoJson
        FakeAnthropicRestClientIo rest();
        hash<auto> opts = {
            "restclient": rest,
        };
        AnthropicMessageActionSession session(opts);

        hash<auto> result = session.handleAction("anthropic-message-create", {
            "model": "claude-sonnet-4-6-20250514",
            "max_tokens": 1024,
            "messages": ({"role": "user", "content": "Hello!"},),
        });
        assertEq("msg_test123", result.message_id);
        assertEq("assistant", result.role);
        assertEq("Hello! How can I help you?", result.output_text);
%endif
    }

    actionSessionStreamTest() {
        checkModule();
%ifndef NoJson
        FakeAnthropicRestClientIo rest();
        rest.stream_events = (
            <SseMessageInfo>{
                "event": "message_start",
                "data": "{\"type\":\"message_start\",\"message\":{\"id\":\"msg_as1\"}}",
            },
            <SseMessageInfo>{
                "event": "content_block_delta",
                "data": "{\"type\":\"content_block_delta\",\"index\":0,"
                    "\"delta\":{\"type\":\"text_delta\",\"text\":\"Hi\"}}",
            },
            <SseMessageInfo>{
                "event": "message_stop",
                "data": "{\"type\":\"message_stop\"}",
            },
        );

        # test the action session by verifying it can handle create/stop actions
        # (streaming through the action session is integration-tested via stream events test)
        hash<auto> opts = {
            "restclient": rest,
        };
        AnthropicMessageActionSession session(opts);
        hash<auto> stop_result = session.handleAction("anthropic-message-stop");
        assertEq("stopped", stop_result.status);
%endif
    }

    actionSessionInvalidTest() {
        checkModule();
