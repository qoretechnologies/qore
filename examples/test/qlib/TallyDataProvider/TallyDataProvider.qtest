    getCurrentUserTest() {
        checkModule();
%ifndef NoJson
        FakeTallyRestClientIo rest();
        rest.response_body = {
            "id": "user1",
            "firstName": "Test",
            "lastName": "User",
            "fullName": "Test User",
            "email": "test@example.com",
            "organizationId": "org1",
            "isDeleted": False,
            "hasTwoFactorEnabled": True,
            "subscriptionPlan": "PRO",
            "createdAt": "2026-01-01T00:00:00Z",
            "updatedAt": "2026-04-07T00:00:00Z",
        };
        TallyDataProvider::TallyDataProvider prov(rest);
        AbstractDataProvider dp = prov.getChildProvider("get-current-user");
        hash<auto> resp = dp.doRequest({});

        assertEq("GET", rest.last_method);
        assertEq("users/me", rest.last_path);
        assertEq("user1", resp.id);
        assertEq("Test", resp.firstName);
        assertEq("Test User", resp.fullName);
        assertEq("test@example.com", resp.email);
        assertEq("org1", resp.organizationId);
        assertEq("PRO", resp.subscriptionPlan);
%endif
    }

    exampleEventDataTest() {
        checkModule();
%ifndef NoJson
        FakeTallyRestClientIo rest();
        # simulate no real data available (empty response)
        rest.response_body = {};
        TallyDataProvider::TallyDataProvider prov(rest);
        AbstractDataProvider events = prov.getChildProvider("events");
        AbstractDataProvider watch = events.getChildProvider(TallyDataProvider::EVENT_FORM_SUBMISSION);

        auto example = watch.getExampleEventData(TallyDataProvider::EVENT_FORM_SUBMISSION);
        assertTrue(example.typeCode() == NT_HASH, "example data is a hash");
        assertTrue(example.hasKey("id"), "example has id");
        assertTrue(example.hasKey("formId"), "example has formId");
        assertTrue(example.hasKey("isCompleted"), "example has isCompleted");
        assertTrue(example.hasKey("submittedAt"), "example has submittedAt");
        assertTrue(example.hasKey("createdAt"), "example has createdAt");
        assertTrue(example.hasKey("responses"), "example has responses");
        assertTrue(example.responses.lsize() > 0, "example has response items");
        assertTrue(example.responses[0].hasKey("questionId"), "response has questionId");
        assertTrue(example.responses[0].hasKey("answer"), "response has answer");
        assertTrue(example.responses[0].hasKey("formattedAnswer"), "response has formattedAnswer");
%endif
    }

    liveConnectionPingTest() {
        if (!m_options.conn) {
            testSkip("no connection specified; use -c <connection_name>");
        }
%ifndef NoJson
        AbstractConnection conn = get_connection(m_options.conn);
        hash<PingInfo> ping_result = conn.ping(True);
        assertEq(True, ping_result.ok, "connection ping succeeds");
%endif
    }

