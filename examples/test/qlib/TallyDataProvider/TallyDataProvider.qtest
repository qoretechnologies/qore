    getSubmissionTest() {
        checkModule();
%ifndef NoJson
        FakeTallyRestClientIo rest();
        rest.response_body = {
            "submission": {
                "id": "s1",
                "formId": "f1",
                "isCompleted": True,
                "responses": (
                    {"id": "r1", "questionId": "q1", "answer": "Hello"},
                ),
            },
        };
        TallyDataProvider::TallyDataProvider prov(rest);
        AbstractDataProvider dp = prov.getChildProvider("get-submission");
        hash<auto> resp = dp.doRequest({"form_id": "f1", "submission_id": "s1"});

        assertEq("GET", rest.last_method);
        assertEq("forms/f1/submissions/s1", rest.last_path);
        assertEq("s1", resp.id);
