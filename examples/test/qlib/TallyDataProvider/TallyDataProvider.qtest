    liveSearchFormsTest() {
        if (!m_options.conn) {
            testSkip("no connection specified; use -c <connection_name>");
        }
%ifndef NoJson
        AbstractConnection conn = get_connection(m_options.conn);
        TallyDataProvider::TallyDataProvider prov(cast<RestClientIo::RestClientIo>(conn.getAsync()));
        AbstractDataProvider dp = prov.getChildProvider("forms");
        AbstractDataProviderRecordIterator it = dp.searchRecords(NOTHING, {"limit": 5});

        list<hash<auto>> recs = ();
        while (it.next()) {
            recs += it.getValue();
        }
        assertTrue(recs.lsize() >= 0, "forms search returns results (may be empty)");
        if (recs.lsize() > 0) {
            assertTrue(recs[0].hasKey("id"), "form record has id");
            assertTrue(recs[0].hasKey("name"), "form record has name");
            assertTrue(recs[0].hasKey("status"), "form record has status");
        }
%endif
    }

    liveFormCrudTest() {
        if (!m_options.conn) {
            testSkip("no connection specified; use -c <connection_name>");
        }
%ifndef NoJson
        AbstractConnection conn = get_connection(m_options.conn);
        TallyDataProvider::TallyDataProvider prov(cast<RestClientIo::RestClientIo>(conn.getAsync()));

        # create a test form
        AbstractDataProvider create_dp = prov.getChildProvider("create-form");
        hash<auto> created = create_dp.doRequest({
            "blocks": (
                {
                    "uuid": "test-block-1",
                    "type": "INPUT_TEXT",
                    "groupUuid": "test-group-1",
                    "groupType": "INPUT_TEXT",
                    "payload": {
                        "isRequired": False,
                        "placeholder": "Test input",
                    },
                },
            ),
            "status": "DRAFT",
        });

        assertTrue(created.id.val(), "created form has id");
        string form_id = created.id;

        on_exit {
            # clean up: delete the form
            try {
                AbstractDataProvider del_dp = prov.getChildProvider("delete-form");
                del_dp.doRequest({"id": form_id});
            } catch () {
                # ignore cleanup errors
            }
        };

        # verify the form persisted by fetching it back
        AbstractDataProvider get_dp = prov.getChildProvider("get-form");
        hash<auto> fetched = get_dp.doRequest({"id": form_id});

        assertEq(form_id, fetched.id, "fetched form matches created form");
        assertEq("DRAFT", fetched.status, "form status is DRAFT");

        # update the form
        AbstractDataProvider update_dp = prov.getChildProvider("update-form");
        hash<auto> updated = update_dp.doRequest({
            "id": form_id,
            "status": "PUBLISHED",
        });
        assertEq(form_id, updated.id, "updated form ID matches");

        # verify update persisted
        fetched = get_dp.doRequest({"id": form_id});
        assertEq("PUBLISHED", fetched.status, "form status updated to PUBLISHED");

        # list questions for the form
        AbstractDataProvider q_dp = prov.getChildProvider("questions");
        AbstractDataProviderRecordIterator it = q_dp.searchRecords(NOTHING, {"form_id": form_id});
        list<hash<auto>> questions = ();
        while (it.next()) {
            questions += it.getValue();
        }
        assertTrue(questions.lsize() >= 0, "questions endpoint returns results");
%endif
    }

    liveWebhookCrudTest() {
        if (!m_options.conn) {
            testSkip("no connection specified; use -c <connection_name>");
        }
%ifndef NoJson
        AbstractConnection conn = get_connection(m_options.conn);
        TallyDataProvider::TallyDataProvider prov(cast<RestClientIo::RestClientIo>(conn.getAsync()));

        # first, get a form to attach the webhook to
        AbstractDataProvider forms_dp = prov.getChildProvider("forms");
        AbstractDataProviderRecordIterator it = forms_dp.searchRecords(NOTHING, {"limit": 1});
        *hash<auto> first_form;
        if (it.next()) {
            first_form = it.getValue();
        }
        if (!first_form) {
            testSkip("no forms available for webhook test");
        }

        string form_id = first_form.id;

        # create a webhook
        AbstractDataProvider create_dp = prov.getChildProvider("create-webhook");
        hash<auto> created = create_dp.doRequest({
            "formId": form_id,
            "url": "https://example.com/test-webhook-" + now_us().toString(),
            "eventTypes": ("FORM_RESPONSE",),
        });

        assertTrue(created.id.val(), "created webhook has id");
        string webhook_id = created.id;

        on_exit {
            # clean up: delete the webhook
            try {
                AbstractDataProvider del_dp = prov.getChildProvider("delete-webhook");
                del_dp.doRequest({"id": webhook_id});
            } catch () {
                # ignore cleanup errors
            }
        };

        # verify webhook appears in list
        AbstractDataProvider wh_dp = prov.getChildProvider("webhooks");
        it = wh_dp.searchRecords(NOTHING, {"limit": 100});
        bool found = False;
        while (it.next()) {
            hash<auto> wh = it.getValue();
            if (wh.id == webhook_id) {
                found = True;
                break;
            }
        }
        assertTrue(found, "created webhook found in list");

        # update the webhook
        AbstractDataProvider update_dp = prov.getChildProvider("update-webhook");
        hash<auto> updated = update_dp.doRequest({
            "id": webhook_id,
            "isEnabled": False,
        });
        # verify update result
        assertEq("updated", updated.status, "update status is updated");
        assertEq(webhook_id, updated.id, "updated webhook id matches");

        # re-fetch webhook to verify update persisted
        it = wh_dp.searchRecords(NOTHING, {"limit": 100});
        *hash<auto> updated_wh;
        while (it.next()) {
            hash<auto> wh = it.getValue();
            if (wh.id == webhook_id) {
                updated_wh = wh;
                break;
            }
        }
        assertTrue(updated_wh.val(), "updated webhook found in list");
        assertEq(False, updated_wh.isEnabled, "webhook isEnabled updated to False");
%endif
    }
}
