%modern

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/DataProvider
%requires ../../../../qlib/TallyDataProvider

%try-module json
%define NoJson
%endtry

%exec-class TallyDataProviderTest

class FakeTallyRestClientIo inherits RestClientIo::RestClientIo {
    public {
        *hash<auto> last_request;
        string last_method;
        string last_path;
        *hash<auto> last_headers;
        hash<auto> response_body;
    }

    constructor() : RestClientIo({"url": "https://api.tally.so", "apikey": "x", "data": "json"}) {
    }

    private hash<RestClient::RestResponseInfo> doRequest(string method, string path, auto body,
            *hash<auto> hdr) {
        last_method = method;
        last_path = path;
        last_request = body;
        last_headers = hdr;
        return <RestClient::RestResponseInfo>{
            "body": response_body,
        };
    }

    hash<RestClient::RestResponseInfo> restGet(string path, *hash<auto> hdr) {
        return doRequest("GET", path, NOTHING, hdr);
    }

    hash<RestClient::RestResponseInfo> restPost(string path, auto body, *hash<auto> hdr) {
        return doRequest("POST", path, body, hdr);
    }

    hash<RestClient::RestResponseInfo> restPatch(string path, auto body, *hash<auto> hdr) {
        return doRequest("PATCH", path, body, hdr);
    }

    hash<RestClient::RestResponseInfo> restDel(string path, auto body, *hash<auto> hdr) {
        return doRequest("DELETE", path, body, hdr);
    }
}

public class TallyDataProviderTest inherits QUnit::Test {
    public {
        Logger logger;

        # command-line options
        const MyOpts = Opts + {
            "conn": "c,connection=s",
        };
    }

    constructor() : Test("TallyDataProvider Test", "1.0", \ARGV, MyOpts) {
        addTestCase("sanity test", \sanityTest());
        addTestCase("action catalog", \actionCatalogTest());
        addTestCase("data types", \dataTypesTest());
        addTestCase("get form", \getFormTest());
        addTestCase("create form", \createFormTest());
        addTestCase("delete form", \deleteFormTest());
        addTestCase("search forms", \searchFormsTest());
        addTestCase("search submissions", \searchSubmissionsTest());
        addTestCase("get submission", \getSubmissionTest());
        addTestCase("create webhook", \createWebhookTest());
        addTestCase("get current user", \getCurrentUserTest());
        addTestCase("example event data", \exampleEventDataTest());
        addTestCase("live connection ping", \liveConnectionPingTest());
        addTestCase("live get current user", \liveGetCurrentUserTest());
        addTestCase("live search forms", \liveSearchFormsTest());
        addTestCase("live form CRUD lifecycle", \liveFormCrudTest());
        addTestCase("live webhook CRUD lifecycle", \liveWebhookCrudTest());

        set_return_value(main());
    }

    checkModule() {
%ifdef NoJson
        testSkip("no json module");
%endif
    }

    sanityTest() {
        checkModule();
%ifndef NoJson
        FakeTallyRestClientIo rest();
        TallyDataProvider::TallyDataProvider prov(rest);
        assertEq("tally", prov.getName());

        *list<string> children = prov.getChildProviderNames();
        assertTrue(children.size() > 0, "has child providers");
        assertTrue(inlist("forms", children), "has forms child");
        assertTrue(inlist("submissions", children), "has submissions child");
        assertTrue(inlist("questions", children), "has questions child");
        assertTrue(inlist("webhooks", children), "has webhooks child");
        assertTrue(inlist("create-form", children), "has create-form child");
        assertTrue(inlist("get-form", children), "has get-form child");
        assertTrue(inlist("update-form", children), "has update-form child");
        assertTrue(inlist("delete-form", children), "has delete-form child");
        assertTrue(inlist("get-submission", children), "has get-submission child");
        assertTrue(inlist("delete-submission", children), "has delete-submission child");
        assertTrue(inlist("create-webhook", children), "has create-webhook child");
        assertTrue(inlist("update-webhook", children), "has update-webhook child");
        assertTrue(inlist("delete-webhook", children), "has delete-webhook child");
        assertTrue(inlist("get-current-user", children), "has get-current-user child");
        assertTrue(inlist("events", children), "has events child");
%endif
    }

    actionCatalogTest() {
        # test create-form action
        hash<DataProviderActionInfo> action = DataProviderActionCatalog::getAppAction(
            TallyDataProvider::TallyDataProvider::AppName, "create-form"
        );
        assertEq("/create-form", action.path);
        assertEq(DPAT_API, action.action_code);
        assertEq(("Forms",), action.groups);
        assertEq(True, action.options.blocks.required);
        assertEq(True, action.options.status.required);
        assertTrue(action.output_type instanceof TallyDataProvider::TallyFormDataType);

        # test search-forms action
        action = DataProviderActionCatalog::getAppAction(
            TallyDataProvider::TallyDataProvider::AppName, "search-forms"
        );
        assertEq("/forms", action.path);
        assertEq(DPAT_FIND, action.action_code);
        assertEq(("Forms",), action.groups);
        assertTrue(action.options.hasKey("limit"));
        assertTrue(action.options.limit.preselected);

        # test search-submissions action
        action = DataProviderActionCatalog::getAppAction(
            TallyDataProvider::TallyDataProvider::AppName, "search-submissions"
        );
        assertEq(DPAT_FIND, action.action_code);
        assertEq(True, action.options.form_id.required);
        assertEq("forms", action.options.form_id.ref_data);

        # test create-webhook action
        action = DataProviderActionCatalog::getAppAction(
            TallyDataProvider::TallyDataProvider::AppName, "create-webhook"
        );
        assertEq(DPAT_API, action.action_code);
        assertEq(True, action.options.formId.required);
        assertEq("forms", action.options.formId.ref_data);
        assertEq(True, action.options.url.required);
        assertEq(True, action.options.eventTypes.required);

        # test get-current-user action
        action = DataProviderActionCatalog::getAppAction(
            TallyDataProvider::TallyDataProvider::AppName, "get-current-user"
        );
        assertEq(DPAT_API, action.action_code);
        assertTrue(action.output_type instanceof TallyDataProvider::TallyUserDataType);

        # test form-submission event
        action = DataProviderActionCatalog::getAppAction(
            TallyDataProvider::TallyDataProvider::AppName, TallyDataProvider::EVENT_FORM_SUBMISSION
        );
        assertEq(DPAT_EVENT, action.action_code);
        assertEq(True, action.options.form_id.required);
    }

    dataTypesTest() {
        # form data type
        auto form_type = new TallyDataProvider::TallyFormDataType();
        hash<string, AbstractDataField> fields = form_type.getFields();
        assertTrue(fields.hasKey("id"), "form has id field");
        assertTrue(fields.hasKey("name"), "form has name field");
        assertTrue(fields.hasKey("status"), "form has status field");
        assertTrue(fields.hasKey("blocks"), "form has blocks field");

        # verify status allowed values
        *list<auto> status_av = fields.status.getAllowedValues();
        assertEq(4, status_av.lsize(), "form status has 4 allowed values");

        # submission data type
        auto sub_type = new TallyDataProvider::TallySubmissionDataType();
        fields = sub_type.getFields();
        assertTrue(fields.hasKey("id"), "submission has id field");
        assertTrue(fields.hasKey("formId"), "submission has formId field");
        assertTrue(fields.hasKey("responses"), "submission has responses field");

        # webhook data type
        auto wh_type = new TallyDataProvider::TallyWebhookDataType();
        fields = wh_type.getFields();
        assertTrue(fields.hasKey("id"), "webhook has id field");
        assertTrue(fields.hasKey("url"), "webhook has url field");
        assertTrue(fields.hasKey("eventTypes"), "webhook has eventTypes field");

        # user data type - verify new fields from API
        auto user_type = new TallyDataProvider::TallyUserDataType();
        fields = user_type.getFields();
        assertTrue(fields.hasKey("id"), "user has id field");
        assertTrue(fields.hasKey("firstName"), "user has firstName field");
        assertTrue(fields.hasKey("lastName"), "user has lastName field");
        assertTrue(fields.hasKey("fullName"), "user has fullName field");
        assertTrue(fields.hasKey("email"), "user has email field");
        assertTrue(fields.hasKey("avatarUrl"), "user has avatarUrl field");
        assertTrue(fields.hasKey("organizationId"), "user has organizationId field");
        assertTrue(fields.hasKey("subscriptionPlan"), "user has subscriptionPlan field");

        # verify subscriptionPlan allowed values
        *list<auto> plan_av = fields.subscriptionPlan.getAllowedValues();
        assertEq(3, plan_av.lsize(), "subscriptionPlan has 3 allowed values");

        # form settings data type - verify typed sub-type
        auto settings_type = new TallyDataProvider::TallyFormSettingsDataType();
        fields = settings_type.getFields();
        assertTrue(fields.hasKey("isClosed"), "settings has isClosed field");
        assertTrue(fields.hasKey("redirectOnCompletion"), "settings has redirectOnCompletion field");
        assertTrue(fields.hasKey("language"), "settings has language field");
        assertTrue(fields.hasKey("hasProgressBar"), "settings has hasProgressBar field");
        assertTrue(fields.hasKey("hasSelfEmailNotifications"), "settings has hasSelfEmailNotifications field");

        # submission response data type
        auto resp_type = new TallyDataProvider::TallySubmissionResponseDataType();
        fields = resp_type.getFields();
        assertTrue(fields.hasKey("id"), "response has id field");
        assertTrue(fields.hasKey("questionId"), "response has questionId field");
        assertTrue(fields.hasKey("answer"), "response has answer field");
        assertTrue(fields.hasKey("formattedAnswer"), "response has formattedAnswer field");
        assertTrue(fields.hasKey("respondentId"), "response has respondentId field");
    }

    getFormTest() {
        checkModule();
%ifndef NoJson
        FakeTallyRestClientIo rest();
        rest.response_body = {
            "id": "form123",
            "name": "Test Form",
            "status": "PUBLISHED",
            "numberOfSubmissions": 42,
            "isClosed": False,
            "createdAt": "2026-01-01T00:00:00Z",
            "updatedAt": "2026-04-07T00:00:00Z",
        };
        TallyDataProvider::TallyDataProvider prov(rest);
        AbstractDataProvider dp = prov.getChildProvider("get-form");
        hash<auto> resp = dp.doRequest({"id": "form123"});

        assertEq("GET", rest.last_method);
        assertEq("forms/form123", rest.last_path);
        assertEq("form123", resp.id);
        assertEq("Test Form", resp.name);
        assertEq("PUBLISHED", resp.status);
%endif
    }

    createFormTest() {
        checkModule();
%ifndef NoJson
        FakeTallyRestClientIo rest();
        rest.response_body = {
            "id": "newform456",
            "name": "",
            "status": "DRAFT",
            "numberOfSubmissions": 0,
            "createdAt": "2026-04-07T12:00:00Z",
        };
        TallyDataProvider::TallyDataProvider prov(rest);
        AbstractDataProvider dp = prov.getChildProvider("create-form");
        hash<auto> resp = dp.doRequest({
            "blocks": ({"uuid": "abc", "type": "INPUT_TEXT", "groupUuid": "g1", "groupType": "INPUT_TEXT"},),
            "status": "DRAFT",
        });

        assertEq("POST", rest.last_method);
        assertEq("forms", rest.last_path);
        assertEq("DRAFT", rest.last_request.status);
        assertTrue(rest.last_request.blocks.lsize() > 0);
        assertEq("newform456", resp.id);
%endif
    }

    deleteFormTest() {
        checkModule();
%ifndef NoJson
        FakeTallyRestClientIo rest();
        rest.response_body = {};
        TallyDataProvider::TallyDataProvider prov(rest);
        AbstractDataProvider dp = prov.getChildProvider("delete-form");
        hash<auto> resp = dp.doRequest({"id": "form789"});

        assertEq("DELETE", rest.last_method);
        assertEq("forms/form789", rest.last_path);
        assertEq("deleted", resp.status);
        assertEq("form789", resp.id);
%endif
    }

    searchFormsTest() {
        checkModule();
%ifndef NoJson
        FakeTallyRestClientIo rest();
        rest.response_body = {
            "items": (
                {"id": "f1", "name": "Form 1", "status": "PUBLISHED"},
                {"id": "f2", "name": "Form 2", "status": "DRAFT"},
            ),
            "page": 1,
            "limit": 50,
            "total": 2,
            "hasMore": False,
        };
        TallyDataProvider::TallyDataProvider prov(rest);
        AbstractDataProvider dp = prov.getChildProvider("forms");
        AbstractDataProviderRecordIterator it = dp.searchRecords(NOTHING, {"limit": 50});

        list<hash<auto>> recs = ();
        while (it.next()) {
            recs += it.getValue();
        }
        assertEq(2, recs.lsize());
        assertEq("f1", recs[0].id);
        assertEq("f2", recs[1].id);
        assertTrue(rest.last_path.regex("forms\\?.*limit=50"));
%endif
    }

