#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

/*  Only the code of the module that registered a lazy value reads it (qore#6843): the module's getter, also for its
    callers and in a closure of the module that they run; not the code of another Program, of another module, of a
    tenant (also with the value's ID, also in a subclass of the module's class), and no ID can be guessed.  The code
    of a caller that the module's code runs (a callback: a closure, and the functions and the static and normal
    methods that it calls) is the caller's code in every execution mode, also after many calls (qore#7394)
*/

%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/lazy-value-owner"
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires DataProvider
%requires LazyOwnerValues
%requires LazyOtherModule

%exec-class LazyValueOwnerTest

const TenantOpts = PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES;

const Tenant = "%requires DataProvider
%requires LazyOwnerValues

class TenantSub inherits LazyOwnerValues::LazyOwnerValues {
    static auto read(int id) {
        return DataProviderActionCatalog::getLazyValue(id);
    }
}

auto sub readFunction(int id) {
    return DataProviderActionCatalog::getLazyValue(id);
}

class TenantReader {
    static auto readStatic(int id) {
        return DataProviderActionCatalog::getLazyValue(id);
    }

    auto read(int id) {
        return DataProviderActionCatalog::getLazyValue(id);
    }
}

#! the results of the reads in a callback that the module's code runs; the same code many times, so that the calls
#! are compiled in tiered execution
hash<string, list<string>> sub callbacks(int id) {
    hash<string, code> reads = {
        'callback-closure': auto sub () { return DataProviderActionCatalog::getLazyValue(id); },
        'callback-function': auto sub () { return readFunction(id); },
        'callback-static-method': auto sub () { return TenantReader::readStatic(id); },
        'callback-method': auto sub () { return new TenantReader().read(id); },
        'callback-subclass': auto sub () { return TenantSub::read(id); },
    };
    hash<string, list<string>> rv;
    foreach hash<auto> i in (reads.pairIterator()) {
        hash<string, bool> seen;
        for (int n = 0; n < 200; ++n) {
            code c = i.value;
            seen{attempt(auto sub () { return LazyOwnerValues::LazyOwnerValues::callBack(c); })} = True;
        }
        rv{i.key} = keys seen;
    }
    return rv;
}

string sub attempt(code c) {
    try {
        return sprintf('OK %y', c());
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
}

hash<auto> sub run(int id) {
    return {
        'direct': attempt(auto sub () { return DataProviderActionCatalog::getLazyValue(id); }),
        'subclass': attempt(auto sub () { return TenantSub::read(id); }),
        'getter': attempt(auto sub () { return LazyOwnerValues::LazyOwnerValues::getValue(); }),
        'closure': attempt(auto sub () { return LazyOwnerValues::LazyOwnerValues::getReader()(); }),
        'enumeration': enumerate(),
        # a call reference of the tenant that the module's code calls with the tenant's argument (qore#7601)
        'callref-direct': attempt(auto sub () {
            return LazyOwnerValues::LazyOwnerValues::callBackWith(\\DataProviderActionCatalog::getLazyValue(), id);
        }),
        'callref-function': attempt(auto sub () {
            return LazyOwnerValues::LazyOwnerValues::callBackWith(\\readFunction(), id);
        }),
        'callref-static-method': attempt(auto sub () {
            return LazyOwnerValues::LazyOwnerValues::callBackWith(\\TenantReader::readStatic(), id);
        }),
        'callref-method': attempt(auto sub () {
            return LazyOwnerValues::LazyOwnerValues::callBackWith(\\(new TenantReader()).read(), id);
        }),
    } + callbacks(id);
}

list<int> sub enumerate() {
    list<int> found = ();
    for (int i = 1; i <= 1000; ++i) {
        int n = i;
        if (attempt(auto sub () { return DataProviderActionCatalog::getLazyValue(n); })
                != 'DATA-PROVIDER-LAZY-VALUE-ERROR') {
            found += n;
        }
    }
    return found;
}
";

class LazyValueOwnerTest inherits QUnit::Test {
    constructor() : Test("LazyValueOwnerTest", "1.0") {
        addTestCase("the module's code reads its value", \testModule());
        addTestCase("other code does not", \testOthers());
        addTestCase("a tenant does not", \testTenant());
        addTestCase("a module loaded by its path at run time reads its value", \testByPath());
        set_return_value(main());
    }

    testModule() {
        assertEq("owned", LazyOwnerValues::getValue());
        assertEq("owned", LazyOwnerValues::getReader()());
    }

    testOthers() {
        int id = LazyOwnerValues::getIdForTest();
        # the IDs are random, not a sequence
        assertTrue(id > 1000);
        # the script's code, and another module's
        assertThrows("DATA-PROVIDER-LAZY-VALUE-ERROR", "for the calling code",
            \DataProviderActionCatalog::getLazyValue(), id);
        assertThrows("DATA-PROVIDER-LAZY-VALUE-ERROR", "for the calling code", \LazyOtherModule::read(), id);
    }

    testByPath() {
        # its initialization registers the value while the code that loads it runs (qore#7289)
        load_module(normalize_dir(get_script_dir()) + "/lazy-value-owner/LazyOwnerPath.qm");
        assertEq("owned by path", call_static_method("LazyOwnerPath::LazyOwnerPath", "getValue"));
        # a child Program that loads it by its path
        Program p(TenantOpts);
        p.loadModule(normalize_dir(get_script_dir()) + "/lazy-value-owner/LazyOwnerPath.qm");
        p.parse("string sub get() { return LazyOwnerPath::LazyOwnerPath::getValue(); }", "by-path");
        assertEq("owned by path", p.callFunction("get"));
    }

    testTenant() {
        Program p(TenantOpts);
        p.setSandboxManager(new SandboxManager());
        p.parse(Tenant, "tenant");
        hash<auto> rv = p.callFunction("run", LazyOwnerValues::getIdForTest());
        assertEq({
            # with the value's ID
            "direct": "DATA-PROVIDER-LAZY-VALUE-ERROR",
            "subclass": "DATA-PROVIDER-LAZY-VALUE-ERROR",
            # the module's code for the tenant
            "getter": "OK \"owned\"",
            "closure": "OK \"owned\"",
            # no ID is found
            "enumeration": (),
            # a call reference of the tenant to the tenant's code that the module's code calls is the tenant's call;
            # a call reference to getLazyValue() itself that the module's code calls with the tenant's argument is the
            # module's call, as documented (qore#7601)
            "callref-direct": "OK \"owned\"",
            "callref-function": "DATA-PROVIDER-LAZY-VALUE-ERROR",
            "callref-static-method": "DATA-PROVIDER-LAZY-VALUE-ERROR",
            "callref-method": "DATA-PROVIDER-LAZY-VALUE-ERROR",
            # the tenant's code that the module's code runs is the tenant's
            "callback-closure": ("DATA-PROVIDER-LAZY-VALUE-ERROR",),
            "callback-function": ("DATA-PROVIDER-LAZY-VALUE-ERROR",),
            "callback-static-method": ("DATA-PROVIDER-LAZY-VALUE-ERROR",),
            "callback-method": ("DATA-PROVIDER-LAZY-VALUE-ERROR",),
            "callback-subclass": ("DATA-PROVIDER-LAZY-VALUE-ERROR",),
        }, rv);
    }
}
