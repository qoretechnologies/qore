#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

# Copyright 2026 Qore Technologies, s.r.o.

# A pipeline whose last reference is released in another thread while its queue thread processes a record: the
# destructor waits for the record, which completes, and the queue thread logs to the pipeline's logs and reports its
# error to the destructor, which raises PIPELINE-FAILED, as it did before the queue thread could no longer call the
# pipeline once its destructor runs in another thread (qore#7509).

%modern
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires DataProvider

%exec-class PipelineDestroyedWhileProcessingTest

const HangTimeout = 30s;

#! holds the record until it may go on; then outputs it or raises an error
class HoldingProcessor inherits DataProvider::AbstractDataProcessor {
    public {
        Counter entered(1);
        Counter go(1);
        bool fail;
    }

    constructor(bool fail) {
        self.fail = fail;
    }

    string className() {
        return "HoldingProcessor";
    }

    private submitImpl(code<nothing(auto)> enqueue, auto _data) {
        entered.dec();
        go.waitForZero(HangTimeout);
        if (fail) {
            throw "TEST-ERROR", "the record failed";
        }
        enqueue(_data);
    }

    private bool supportsBulkApiImpl() {
        return False;
    }
}

#! takes a snapshot after every record, and records the snapshots with the thread that took them
class TestMetricsCollector inherits DataProvider::AbstractPipelineMetricsCollector {
    public {
        Queue snapshots();
    }

    int getIntervalMs() {
        return 0;
    }

    int getRecordInterval() {
        return 1;
    }

    reportMetrics(hash<PipelineMetricsSnapshot> snapshot) {
        snapshots.push({"tid": gettid(), "snapshot": snapshot});
    }

    shutdown() {
    }

    reset() {
    }
}

#! tells when its destructor starts
class TestPipeline inherits DataProvider::DataProviderPipeline {
    public {
        Counter test_in_dtor(1);
    }

    constructor(hash<PipelineOptionInfo> opts) : DataProviderPipeline(opts) {
    }

    destructor() {
        test_in_dtor.dec();
    }
}

#! records the calls of the methods that it reimplements, with the thread that made them
/** reportError() cannot be reimplemented outside of the module: its argument is a queue, whose class is not public;
    it logs the error with logError()
*/
class OverridingPipeline inherits DataProvider::DataProviderPipeline {
    public {
        Queue calls();
    }

    constructor(hash<PipelineOptionInfo> opts) : DataProviderPipeline(opts) {
    }

    logError(string fmt, ...) {
        calls.push({"method": "logError", "tid": gettid(), "msg": vsprintf(fmt, argv)});
    }

    logDebug(string fmt, ...) {
        calls.push({"method": "logDebug", "tid": gettid(), "msg": vsprintf(fmt, argv)});
    }
}

#! records the thread that processes each record, and raises an error for the record if told to
class ThreadProcessor inherits DataProvider::AbstractDataProcessor {
    public {
        Queue tids();
        bool fail;
    }

    constructor(bool fail) {
        self.fail = fail;
    }

    string className() {
        return "ThreadProcessor";
    }

    private submitImpl(code<nothing(auto)> enqueue, auto _data) {
        tids.push(gettid());
        if (fail) {
            throw "TEST-ERROR", "the record failed";
        }
        enqueue(_data);
    }

    private bool supportsBulkApiImpl() {
        return False;
    }
}

#! holds the first record in its logDebug() (its output) or logError() (its error) until it may go on, and reports
#! its destruction
class HoldingLogPipeline inherits DataProvider::DataProviderPipeline {
    public {
        Counter in_log(1);
        Counter go(1);
        bool armed = True;
        Queue events;
    }

    constructor(hash<PipelineOptionInfo> opts, Queue events) : DataProviderPipeline(opts) {
        self.events = events;
    }

    destructor() {
        events.push({"event": "destroyed", "tid": gettid()});
    }

    logDebug(string fmt, ...) {
        if (armed && fmt =~ /data processor .* output/) {
            hold();
        }
    }

    logError(string fmt, ...) {
        if (armed) {
            hold();
        }
    }

    private hold() {
        armed = False;
        in_log.dec();
        go.waitForZero(HangTimeout);
    }
}

#! reports the end of the destructor of its pipeline (the shutdown of its collector follows the wait for the queue
#! threads)
class ShutdownCollector inherits TestMetricsCollector {
    private {
        Queue events;
    }

    constructor(Queue events) {
        self.events = events;
    }

    shutdown() {
        events.push({"event": "collector shut down", "tid": gettid()});
    }
}

#! logs nothing: its logError() raises an error
class ThrowingLogPipeline inherits DataProvider::DataProviderPipeline {
    constructor(hash<PipelineOptionInfo> opts) : DataProviderPipeline(opts) {
    }

    logError(string fmt, ...) {
        throw "LOGERROR-FAILED", "the log failed";
    }
}

#! reports its destruction
class ReportingPipeline inherits DataProvider::DataProviderPipeline {
    public {
        Queue events;
    }

    constructor(hash<PipelineOptionInfo> opts, Queue events) : DataProviderPipeline(opts) {
        self.events = events;
    }

    destructor() {
        events.push({"event": "destroyed", "tid": gettid()});
    }
}

class PipelineDestroyedWhileProcessingTest inherits QUnit::Test {
    constructor() : QUnit::Test("PipelineDestroyedWhileProcessing", "1.0") {
        addTestCase("a record in progress completes while the pipeline is destroyed", \completesTest());
        addTestCase("the error of a record in progress is reported while the pipeline is destroyed", \errorTest());
        addTestCase("the metrics of a record in progress are taken while the pipeline is destroyed", \metricsTest());
        addTestCase("a queue thread calls the reimplemented log methods of a live pipeline", \overridesTest());
        addTestCase("the error of a queue thread of a live pipeline is logged with its reimplemented logError()",
            \overridesErrorTest());
        addTestCase("a pipeline whose last reference a queue thread's call holds is destroyed in the queue thread",
            \destroyedInQueueTest(), False);
        addTestCase("a pipeline whose last reference a queue thread's error report holds is destroyed in the queue "
            "thread", \destroyedInQueueTest(), True);
        addTestCase("an error of a record is reported when the pipeline's logError() raises an error",
            \throwingLogErrorTest());
        addTestCase("a pipeline whose last reference a fan-out queue thread's call of a child queue holds is destroyed "
            "in that thread", \fanOutDestroyedTest());
        set_return_value(main());
    }

    completesTest() {
        hash<auto> rv = run(False);
        assertEq(NOTHING, rv.err, "no error");
        assertTrue(rv.debug, "the queue thread logged the record's output");
    }

    errorTest() {
        hash<auto> rv = run(True);
        assertEq("PIPELINE-FAILED", rv.err);
        assertEq("TEST-ERROR", rv.arg[0].err, "the record's error is reported");
        assertTrue(rv.error_logged, "the queue thread logged the error");
    }

    metricsTest() {
        TestMetricsCollector collector();
        hash<auto> rv = run(False, collector);
        assertEq(NOTHING, rv.err, "no error");
        # the queue thread takes the record's snapshot while the destructor waits for it, in another thread than the
        # destructor's, whose final snapshot follows
        list<hash<auto>> snaps = ();
        while (collector.snapshots.size()) {
            snaps += collector.snapshots.get();
        }
        *hash<auto> worker_snap = (select snaps, $1.tid != rv.dtor_tid)[0];
        assertEq("destroyed-while-processing", worker_snap.snapshot.pipeline_name, "the queue thread's snapshot");
        assertEq(1, worker_snap.snapshot.num_queues);
        assertEq(PS_RUNNING, worker_snap.snapshot.status);
    }

    #! The queue thread of a live pipeline calls its reimplemented logDebug() (qore#7509)
    overridesTest() {
        OverridingPipeline pipe(<PipelineOptionInfo>{"name": "overrides", "debug_log": sub (string fmt, ...) {}});
        ThreadProcessor proc(False);
        pipe.append(proc);
        pipe.submit({"a": 1});
        pipe.waitDone();
        int tid = proc.tids.get(HangTimeout);
        assertNeq(gettid(), tid, "the record is processed in a queue thread");
        list<hash<auto>> calls = map pipe.calls.get(), xrange(pipe.calls.size());
        assertTrue((select calls, $1.method == "logDebug" && $1.tid == tid
            && $1.msg =~ /data processor "ThreadProcessor" output/).size() > 0,
            "the queue thread calls the pipeline's logDebug()");
    }

    #! The queue thread of a live pipeline reports its error to the pipeline, whose logError() logs it (qore#7509)
    overridesErrorTest() {
        OverridingPipeline pipe(<PipelineOptionInfo>{"name": "overrides"});
        ThreadProcessor proc(True);
        pipe.append(proc);
        pipe.submit({"a": 1});
        assertThrows("PIPELINE-FAILED", \pipe.waitDone());
        int tid = proc.tids.get(HangTimeout);
        list<hash<auto>> calls = map pipe.calls.get(), xrange(pipe.calls.size());
        assertTrue((select calls, $1.method == "logError" && $1.tid == tid && $1.msg =~ /TEST-ERROR/).size() > 0,
            "the queue thread's error is logged with the pipeline's logError()");
    }

    #! The program releases the pipeline while the queue thread calls its logDebug() or logError() (qore#7509)
    /** The call holds the last reference: the pipeline is destroyed in the queue thread, once the thread has released
        the pipeline's lock, which the destructor takes; the record completes, and its error is reported
    */
    destroyedInQueueTest(bool fail) {
        Queue events();
        Queue errors();
        ShutdownCollector collector(events);
        ThreadProcessor proc(fail);
        ThreadProcessor proc2(False);
        Counter go;
        {
            HoldingLogPipeline pipe(<PipelineOptionInfo>{
                "name": "destroyed-in-queue",
                "error_log": sub (string fmt, ...) {
                    errors.push(vsprintf(fmt, argv));
                },
                "metrics_collector": collector,
            }, events);
            pipe.append(proc);
            pipe.append(proc2);
            go = pipe.go;
            pipe.submit({"a": 1});
            assertEq(0, pipe.in_log.waitForZero(HangTimeout), "the queue thread calls the pipeline");
        }
        on_exit if (go.getCount()) {
            go.dec();
        }
        # the program has released the pipeline: the queue thread's call holds it
        int tid = proc.tids.get(HangTimeout);
        go.dec();
        hash<auto> ev = events.get(HangTimeout);
        assertEq("destroyed", ev.event, "the pipeline is destroyed");
        assertEq(tid, ev.tid, "the queue thread destroys the pipeline");
        assertEq("collector shut down", events.get(HangTimeout).event,
            "the destructor does not wait for the queue thread that runs it");
        if (fail) {
            assertEq(0, proc2.tids.size(), "the failed record goes no further");
            # the destructor raises the record's error once it has shut the collector down: the queue thread logs it
            string msg;
            while (msg !~ /PIPELINE-FAILED/) {
                msg = errors.get(HangTimeout);
            }
            assertRegex("PIPELINE-FAILED", msg,
                "the record's error is reported by the destructor that runs in the queue thread");
        } else {
            assertEq(tid, proc2.tids.get(HangTimeout), "the record completes");
        }
    }

    #! The program releases the pipeline while queue 0's thread logs its submission of a record to a child queue
    #! (qore#7509)
    /** Queue 0's thread calls the pipeline through the child queue (with the pipeline's lock held), and that call
        holds the last reference: the pipeline is destroyed in queue 0's thread, once the thread has released the lock
    */
    fanOutDestroyedTest() {
        Queue events();
        ShutdownCollector collector(events);
        ThreadProcessor proc(False);
        Counter in_log(1);
        Counter go(1);
        on_exit if (go.getCount()) {
            go.dec();
        }
        bool armed = True;
        int main_tid = gettid();
        Queue log_tid();
        {
            ReportingPipeline pipe(<PipelineOptionInfo>{
                "name": "destroyed-in-fan-out",
                "metrics_collector": collector,
                "debug_log": sub (string fmt, ...) {
                    # the log of the submission to the child queue in queue 0's thread
                    if (armed && gettid() != main_tid && fmt =~ /data submission/) {
                        armed = False;
                        log_tid.push(gettid());
                        in_log.dec();
                        go.waitForZero(HangTimeout);
                    }
                },
            }, events);
            int id = pipe.appendQueue(0);
            pipe.append(id, proc);
            pipe.submit({"a": 1});
            assertEq(0, in_log.waitForZero(HangTimeout), "queue 0's thread logs the submission to the child queue");
        }
        # the program has released the pipeline: the call of queue 0's thread holds it
        int tid = log_tid.get();
        go.dec();
        hash<auto> ev = events.get(HangTimeout);
        assertEq("destroyed", ev.event, "the pipeline is destroyed");
        assertEq(tid, ev.tid, "queue 0's thread destroys the pipeline");
        assertEq("collector shut down", events.get(HangTimeout).event,
            "the destructor does not wait for the queue thread that runs it");
    }

    #! The pipeline's logError() raises an error while the error of a record is reported (qore#7509)
    throwingLogErrorTest() {
        Queue errors();
        ThrowingLogPipeline pipe(<PipelineOptionInfo>{
            "name": "throwing-log",
            "error_log": sub (string fmt, ...) {
                errors.push(vsprintf(fmt, argv));
            },
        });
        pipe.append(new ThreadProcessor(True));
        pipe.submit({"a": 1});
        # the error is recorded, and the pipeline aborted, before it is logged
        assertThrows("PIPELINE-FAILED", \pipe.waitDone());
        list<string> logged = map errors.get(), xrange(errors.size());
        assertTrue((select logged, $1 =~ /TEST-ERROR/ && $1 =~ /could not be logged/ && $1 =~ /LOGERROR-FAILED/).size()
            > 0, "the logging error is logged with the shared state's log");
    }

    #! submits a record, releases the pipeline in another thread while the record is processed, and lets the record go on
    private hash<auto> run(bool fail, *AbstractPipelineMetricsCollector collector) {
        Queue debug_log();
        Queue error_log();
        HoldingProcessor proc(fail);
        Queue handoff();
        Counter in_dtor;
        {
            TestPipeline pipe(<PipelineOptionInfo>{
                "name": "destroyed-while-processing",
                "debug_log": sub (string fmt, ...) {
                    debug_log.push(vsprintf(fmt, argv));
                },
                "error_log": sub (string fmt, ...) {
                    error_log.push(vsprintf(fmt, argv));
                },
                "metrics_collector": collector,
            });
            pipe.append(proc);
            pipe.submit({"a": 1});
            in_dtor = pipe.test_in_dtor;
            # the other thread releases the last reference: this thread hands its reference over and releases it
            handoff.push(pipe);
            remove pipe;
        }
        assertEq(0, proc.entered.waitForZero(HangTimeout), "the queue thread processes the record");

        Queue result();
        Counter done(1);
        Queue dtor_tid();
        background sub () {
            on_exit done.dec();
            dtor_tid.push(gettid());
            try {
                TestPipeline pipe = handoff.get();
                remove pipe;
                result.push({});
            } catch (hash<ExceptionInfo> ex) {
                result.push({"err": ex.err, "arg": ex.arg});
            }
        }();
        assertEq(0, in_dtor.waitForZero(HangTimeout), "the pipeline's destructor started");
        # the record goes on while the destructor waits for it
        proc.go.dec();
        assertEq(0, done.waitForZero(HangTimeout), "the pipeline's destructor ended");
        hash<auto> rv = result.get();
        rv.dtor_tid = dtor_tid.get();
        while (debug_log.size()) {
            if (debug_log.get() =~ /data processor "HoldingProcessor" output/) {
                rv.debug = True;
            }
        }
        while (error_log.size()) {
            if (error_log.get() =~ /TEST-ERROR/) {
                rv.error_logged = True;
            }
        }
        return rv;
    }
}
