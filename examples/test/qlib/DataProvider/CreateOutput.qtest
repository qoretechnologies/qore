#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"

%requires QUnit
%requires DataProvider

%exec-class CreateOutputTest

class TestSimulationRecorder inherits AbstractSimulationRecorder {
    private {
        list<hash<auto>> actions = ();
    }

    record(string app, string action, auto input, string fidelity = "app-simulator") {
        actions += {
            "app": app,
            "action": action,
            "input": input,
            "fidelity": fidelity,
        };
    }

    list<hash<auto>> recorded(*string app, *string action) {
        return (map $1, actions, (!app || $1.app == app) && (!action || $1.action == action));
    }
}

#! Buffers created records and generates a CSV-like document from them, like a spreadsheet writer
class DocumentWriteProvider inherits AbstractDataProvider {
    private {
        const ProviderInfo = <DataProviderInfo>{
            "type": "DocumentWriteProvider",
            "supports_create": True,
            "has_record": True,
        };

        list<hash<auto>> recs = ();
        int finish_count = 0;
        # where the document is written if has_destination is set; otherwise it is returned as generated output
        *reference<binary> destination;
        bool has_destination = False;
    }

    constructor() {
    }

    constructor(reference<binary> destination) {
        self.destination = \destination;
        has_destination = True;
    }

    string getName() {
        return "document-write";
    }

    int getFinishCount() {
        return finish_count;
    }

    private *hash<auto> createRecordImpl(hash<auto> rec, *hash<auto> create_options) {
        recs += rec;
        return rec;
    }

    private auto finishCreateImpl() {
        ++finish_count;
        binary data = binary((map ($1.values()).join(","), recs).join("\n"));
        if (has_destination) {
            destination = data;
            return;
        }
        return <GeneratedDataInfo>{
            "data": data,
            "record_count": recs.size(),
        };
    }

    private hash<DataProviderInfo> getStaticInfoImpl() {
        return ProviderInfo;
    }

    private hash<auto> getExampleRecordDataImpl() {
        return {"record": True};
    }

    #! records can have any fields: an open record type
    private *hash<string, AbstractDataField> getRecordTypeImpl(*hash<auto> search_options) {
        return NOTHING;
    }
}

#! A record provider that does not override finishCreateImpl()
class RecordProvider inherits AbstractDataProvider {
    private {
        const ProviderInfo = <DataProviderInfo>{
            "type": "RecordProvider",
            "supports_create": True,
        };
    }

    string getName() {
        return "record";
    }

    private *hash<auto> createRecordImpl(hash<auto> rec, *hash<auto> create_options) {
        return rec;
    }

    private hash<DataProviderInfo> getStaticInfoImpl() {
        return ProviderInfo;
    }

    private hash<auto> getExampleRecordDataImpl() {
        return {"record": True};
    }
}

#! A provider that supports upserting records
class UpsertProvider inherits AbstractDataProvider {
    public {
        list<hash<auto>> upserted = ();
    }

    private {
        const ProviderInfo = <DataProviderInfo>{
            "type": "UpsertProvider",
            "supports_upsert": True,
        };
    }

    string getName() {
        return "upsert";
    }

    private string upsertRecordImpl(hash<auto> rec, *hash<auto> upsert_options) {
        upserted += rec;
        return UpsertResultInserted;
    }

    private hash<DataProviderInfo> getStaticInfoImpl() {
        return ProviderInfo;
    }
}

#! Captures log messages with their levels
class LogCapture inherits LoggerWrapper {
    public {
        list<hash<auto>> messages = ();
    }

    logArgs(Qore::Logger::LoggerLevel level, string message, *softlist<auto> args) {
        logArgs(level.getValue(), message, args);
    }

    logArgs(int level, string message, *softlist<auto> args) {
        messages += {"level": level, "message": args ? vsprintf(message, args) : message};
    }
}

#! A provider whose create action options cannot be determined
class FailingOptionsProvider inherits RecordProvider {
    private *hash<string, AbstractDataField> getCreateRecordTypeWithOptionsImpl(*hash<auto> options) {
        throw "OPTIONS-ERROR", "the record type cannot be determined";
    }
}

class CreateOutputTest inherits QUnit::Test {
    constructor() : Test("CreateOutputTest", "1.0", \ARGV) {
        addTestCase("generated data output type", \testOutputType());
        addTestCase("finishCreate default", \testFinishCreateDefault());
        addTestCase("finishCreate returns generated data", \testFinishCreateOutput());
        addTestCase("finishCreate writes to a destination", \testFinishCreateDestination());
        addTestCase("create-output action registration", \testRegistration());
        addTestCase("negative: invalid create-output registrations", \testRegistrationErrors());
        addTestCase("create-output action simulation", \testSimulation());
        addTestCase("create action options with an open record type", \testOpenRecordTypeOptions());
        addTestCase("caught option errors are logged", \testCaughtErrorLogged());
        addTestCase("empty and missing records", \testEmptyAndMissingRecords());

        set_return_value(main());
    }

    testOutputType() {
        assertEq(("data", "record_count"), keys GeneratedDataOutputDataType.getFields());
        assertEq("binary", GeneratedDataOutputDataType.getFields().data.getType().getBaseTypeName());
        assertEq("int", GeneratedDataOutputDataType.getFields().record_count.getType().getBaseTypeName());

        hash<GeneratedDataInfo> output = <GeneratedDataInfo>{"data": binary("a,b"), "record_count": 1};
        assertEq(output, GeneratedDataOutputDataType.acceptsValue(output));
        assertThrows("RUNTIME-TYPE-ERROR", \GeneratedDataOutputDataType.acceptsValue(),
            {"data": "not binary", "record_count": 1});

        # the type can be extended with provider-specific fields
        GeneratedDataOutputDataType extended("ReportOutput");
        extended.addQoreFields({
            "format": {
                "display_name": "Format",
                "type": StringType,
                "desc": "The format of the generated report",
            },
        });
        assertEq(("data", "record_count", "format"), keys extended.getFields());
        assertEq("ReportOutput", extended.getName());
    }

    testFinishCreateDefault() {
        RecordProvider prov();
        prov.createRecordsBulk({"a": (1, 2)});
        assertEq(NOTHING, prov.finishCreate());
    }

    testFinishCreateOutput() {
        DocumentWriteProvider prov();
        prov.createRecordsBulkWithOptions({"recs": {"sku": ("A-1", "B-2"), "qty": (5, 7)}});
        hash<GeneratedDataInfo> output = prov.finishCreate();
        assertEq(binary("A-1,5\nB-2,7"), output.data);
        assertEq(2, output.record_count);
        assertEq(1, prov.getFinishCount());

        # no records: the generated output is still returned
        prov = new DocumentWriteProvider();
        output = prov.finishCreate();
        assertEq(binary(), output.data);
        assertEq(0, output.record_count);
    }

    testFinishCreateDestination() {
        binary written;
        DocumentWriteProvider prov(\written);
        prov.createRecord({"sku": "A-1", "qty": 5});
        # output written to its destination is not returned
        assertEq(NOTHING, prov.finishCreate());
        assertEq(binary("A-1,5"), written);
    }

    testRegistration() {
        string app = registerApp();
        on_exit DataProviderActionCatalog::deregisterDynamicApp(app);

        registerAction(app, "write-data", DPAT_CREATE, DPAD_CREATE_OUTPUT, GeneratedDataOutputDataType);
        hash<DataProviderActionInfo> action = DataProviderActionCatalog::getAppActionEx(app, "write-data");
        assertEq(DPAD_CREATE_OUTPUT, action.output_data_type);
        assertEq("GeneratedDataOutput", action.output_type.getName());
        # create actions still accept records in every bulk form
        assertTrue(action.input_data_types{DPAD_RECORD_SET});
        assertTrue(action.input_data_types{DPAD_RECORD_STREAM});

        # an output type set with get_output_type is accepted
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": app,
            "path": "/",
            "action": "write-lazy",
            "display_name": "write-lazy",
            "short_desc": "write-lazy",
            "desc": "write-lazy",
            "action_code": DPAT_CREATE,
            "output_data_type": DPAD_CREATE_OUTPUT,
            "get_output_type": AbstractDataProviderType sub () { return GeneratedDataOutputDataType; },
        });
        action = DataProviderActionCatalog::getAppActionEx(app, "write-lazy");
        assertEq("GeneratedDataOutput", action.output_type.getName());

        # an ordinary create action keeps the record-set output data type
        registerAction(app, "write", DPAT_CREATE);
        assertEq(DPAD_RECORD_SET, DataProviderActionCatalog::getAppActionEx(app, "write").output_data_type);
    }

    testRegistrationErrors() {
        string app = registerApp();
        on_exit DataProviderActionCatalog::deregisterDynamicApp(app);

        # only create actions can return create output
        assertThrows("ACTION-ERROR", "only valid for create actions", sub () {
            registerAction(app, "find-data", DPAT_FIND, DPAD_CREATE_OUTPUT, GeneratedDataOutputDataType);
        });
        # the generated output must be described
        assertThrows("ACTION-ERROR", "no output type", sub () {
            registerAction(app, "write-data", DPAT_CREATE, DPAD_CREATE_OUTPUT);
        });
        assertEq(NOTHING, DataProviderActionCatalog::getAppAction(app, "find-data"));
        assertEq(NOTHING, DataProviderActionCatalog::getAppAction(app, "write-data"));
    }

    testSimulation() {
        string app = registerApp();
        on_exit DataProviderActionCatalog::deregisterDynamicApp(app);
        registerAction(app, "write-data", DPAT_CREATE, DPAD_CREATE_OUTPUT, GeneratedDataOutputDataType);

        DocumentWriteProvider prov();
        TestSimulationRecorder recorder();
        # a create-output action simulates its generated output
        hash<auto> simulated = prov.simulateRequest(app, "write-data", {"sku": "A-1"}, recorder);
        assertEq(("data", "record_count"), keys simulated);
        assertEq(Type::Binary, simulated.data.type());
        assertEq(Type::Int, simulated.record_count.type());
        # simulation has no side effects
        assertEq(0, prov.getFinishCount());

        list<hash<auto>> recorded = recorder.recorded();
        assertEq(1, recorded.size());
        assertEq("write-data", recorded[0].action);
        assertEq("example", recorded[0].fidelity);
    }

    private string registerApp() {
        string app = "CreateOutputTest" + get_random_string();
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": app,
            "display_name": "Create Output Test",
            "short_desc": "Create output test app",
            "desc": "Create output test app",
            "groups": (AppGroup::DataTransformation,),
            "logo": "data",
            "logo_mime_type": MimeTypeSvg,
            "logo_file_name": "test.svg",
            "dynamic": True,
        });
        return app;
    }

    private registerAction(string app, string action, int action_code, *string output_data_type,
            *AbstractDataProviderType output_type) {
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": app,
            "path": "/",
            "action": action,
            "display_name": action,
            "short_desc": action,
            "desc": action,
            "action_code": action_code,
            "output_data_type": output_data_type ?? "",
            "output_type": output_type,
        });
    }

    testOpenRecordTypeOptions() {
        string app = registerApp();
        on_exit DataProviderActionCatalog::deregisterDynamicApp(app);
        registerAction(app, "write-data", DPAT_CREATE, DPAD_CREATE_OUTPUT, GeneratedDataOutputDataType);
        hash<DataProviderActionInfo> action = DataProviderActionCatalog::getAppActionEx(app, "write-data");

        # the provider has no record type: the records option accepts records with any fields
        DocumentWriteProvider prov();
        assertNothing(prov.getRecordType());
        *hash<string, hash<ActionOptionInfo>> opts = prov.tryGetActionOptionsForCreateWithOptions(action);
        assertTrue(exists opts.recs, "the records option is offered");
        list<auto> recs = ({"sku": "A-1", "qty": 5}, {"note": "any fields"});
        assertEq(recs, opts.recs.type.acceptsValue(recs));
    }

    testCaughtErrorLogged() {
        string app = registerApp();
        on_exit DataProviderActionCatalog::deregisterDynamicApp(app);
        registerAction(app, "write", DPAT_CREATE);
        hash<DataProviderActionInfo> action = DataProviderActionCatalog::getAppActionEx(app, "write");

        LogCapture global_log();
        *LoggerInterface old_logger = DataProvider::getGlobalLogger();
        DataProvider::setGlobalLogger(global_log);
        on_exit DataProvider::setGlobalLogger(old_logger);

        # a provider without its own logger logs the error with the global logger
        FailingOptionsProvider prov();
        assertNothing(prov.tryGetActionOptionsForCreateWithOptions(action, {"token": "s3cr3t"}));
        assertEq(1, global_log.messages.size());
        hash<auto> entry = global_log.messages[0];
        assertEq(Qore::Logger::LoggerLevel::ERROR, entry.level);
        assertRegex("failed to get the options of create action " + app + "/write", entry.message);
        assertRegex("OPTIONS-ERROR", entry.message);
        assertRegex("token", entry.message, "the option names are logged");
        assertFalse(entry.message.find("s3cr3t") >= 0, "option values are never logged");

        # a provider with its own logger logs the error there
        LogCapture own_log();
        prov.setLogger(own_log);
        assertNothing(prov.tryGetActionOptionsForCreateWithOptions(action, {"token": "s3cr3t"}));
        assertEq(1, own_log.messages.size());
        assertEq(1, global_log.messages.size());
    }

    testEmptyAndMissingRecords() {
        # an empty list of records creates no records, and the generated output is an empty document
        DocumentWriteProvider prov();
        assertNothing(prov.createRecordsBulk(()));
        assertNothing(prov.createRecordsBulkWithOptions({"recs": ()}));
        hash<GeneratedDataInfo> output = prov.finishCreate();
        assertEq(0, output.record_count);
        assertEq(binary(), output.data);

        # a missing records option is an error that says so
        assertThrows("CREATE-RECORD-ERROR", "no records were given to create", \prov.createRecordsBulkWithOptions(),
            {});
        assertThrows("CREATE-RECORD-ERROR", "no records were given to create", \prov.createRecordsBulkWithOptions());

        # the same for upserts
        UpsertProvider uprov();
        assertEq((), uprov.upsertRecordsBulkWithOptions({"recs": ()}));
        assertEq((), uprov.upserted);
        assertEq((UpsertResultInserted,), uprov.upsertRecordsBulkWithOptions({"recs": ({"sku": "A-1"},)}));
        assertEq(({"sku": "A-1"},), uprov.upserted);
        assertThrows("CREATE-RECORD-ERROR", "no records were given to upsert", \uprov.upsertRecordsBulkWithOptions(),
            {});
    }
}
