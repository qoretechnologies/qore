%modern

%requires DataProvider
%requires ./LazyAppActionsHooks.qm

module LazyValueAppCycleModule {
    version = "1.0";
    desc = "test module whose initialization runs the code that the test sets, to register lazy values";
    author = "Qore Technologies, s.r.o.";
    license = "MIT";
    init = sub () {
        LazyAppActionsHooks::Hooks::run("LazyValueAppCycleModule");
    };
}
