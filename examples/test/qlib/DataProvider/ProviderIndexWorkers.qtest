#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright 2026 Qore Technologies, s.r.o. SPDX-License-Identifier: MIT

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/FsUtil.qm
%requires ../../../../qlib/DataProvider
%requires ../../../../qlib/ProviderIndex

%requires yaml

%try-module process >= 2.2
%define NoProcess
%endtry

%exec-class ProviderIndexWorkersTest

#! Tests index build mode and index builds with worker processes
public class ProviderIndexWorkersTest inherits QUnit::Test {
    private {
        # registers the provider module in QORE_PROVIDER_INDEX_FIXTURE_MODULE
        string registration_module = normalize_dir(get_script_dir()) + "/ProviderIndexEnvironmentMapFixture.qm";
        # registers the "IndexIdentityFixture" app
        string provider_module = normalize_dir(get_script_dir()) + "/index-identity/IndexIdentityFixture.qm";

        # environment variables changed by the tests and their original values
        hash<string, auto> saved_env;
    }

    constructor() : Test("ProviderIndex workers test", "1.0") {
        addTestCase("build mode never reads the published index", \buildModeTest());
        addTestCase("workers reject an unavailable process dependency before publishing", \missingProcessTest());
        addTestCase("a worker build writes the same index as a single-process build", \equivalenceTest());
        addTestCase("a failed worker publishes nothing", \workerFailureTest());
        addTestCase("workers that describe an action differently fail the build", \conflictTest());
        addTestCase("a worker setup error is reported and no further workers are started", \setupErrorTest());
        addTestCase("without MessagePack, a worker build is run in the calling process", \noMessagePackTest());
        addTestCase("cancelled workers are stopped and publish nothing", \cancelTest());

        set_return_value(main());
    }

    private checkModules(*bool workers) {
%ifdef NoProcess
        if (workers) {
            testSkip("no process module 2.2 or later");
        }
%endif
        if (workers && !ProviderIndexUtil::hasMessagePack()) {
            testSkip("no MessagePack support");
        }
    }

    #! Sets a process environment variable until restoreEnv() is called; workers inherit it
    private setEnv(string var, *string value) {
        if (!saved_env.hasKey(var)) {
            saved_env{var} = getenv(var);
        }
        if (exists value) {
            setenv(var, value);
            ENV{var} = value;
        } else {
            unsetenv(var);
            remove ENV{var};
        }
    }

    #! Restores the environment variables changed by setEnv()
    private restoreEnv() {
        foreach hash<auto> i in (saved_env.pairIterator()) {
            if (exists i.value) {
                setenv(i.key, i.value);
                ENV{i.key} = i.value;
            } else {
                unsetenv(i.key);
                remove ENV{i.key};
            }
        }
        saved_env = {};
    }

    #! Returns the options of a build that indexes only the providers registered by QORE_DATA_PROVIDERS
    private hash<ProviderIndexCreateOptions> getOptions(int workers) {
        return <ProviderIndexCreateOptions>{
            "load_known_factories": False,
            "load_typescript_actions": False,
            "workers": workers,
        };
    }

    #! Returns the contents of all index files in the given directory
    private hash<string, binary> readIndexFiles(string dir) {
        hash<string, binary> rv = {};
        Dir d();
        d.chdir(dir);
        foreach string file in (d.listFiles()) {
            rv{file} = ReadOnlyFile::readBinaryFile(dir + DirSep + file);
        }
        return rv;
    }

    missingProcessTest() {
%ifdef NoProcess
        if (!ProviderIndexUtil::hasMessagePack()) {
            testSkip("no MessagePack support");
        }
        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        on_exit restoreEnv();
        setEnv("QORE_DATA_PROVIDERS", NOTHING);
        *hash<ExceptionInfo> error;
        try {
            ProviderIndex::createDataProviderIndex(NOTHING, dir, getOptions(1));
        } catch (hash<ExceptionInfo> ex) {
            error = ex;
        }
        assertEq("PROVIDER-INDEX-WORKER-ERROR", error.err);
        assertRegex("process module 2[.]2 or later is required", error.desc);
        assertEq({}, readIndexFiles(dir), "unsupported workers publish no index or staging files");
%else
        testSkip("process module 2.2 or later is available");
%endif
    }

    buildModeTest() {
        checkModules();

        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        # the variable is read from the environment of the ProviderIndexUtil module
        ProviderIndexUtil::setEnvironmentVariable(dir);

        ProviderIndexUtil::writeDataProviderIndex(<DataProviderIndexInfo>{
            "factorymap": {},
            "appmap": {"QoreTestBuildModeApp": {"QoreTestMissingBuildModeModule": True}},
            "schememap": {},
            "appinfomap": {"QoreTestBuildModeApp": {"name": "QoreTestBuildModeApp"}},
            "actioninfomap": {},
        }, 0s, {});

        assertFalse(ProviderIndexUtil::inBuildMode());
        assertFalse(ProviderIndexUtil::setBuildMode(True), "the previous mode is returned");
        on_exit ProviderIndexUtil::setBuildMode(False);
        assertTrue(ProviderIndexUtil::inBuildMode());
        assertNothing(ProviderIndexUtil::tryGetAppInfo("QoreTestBuildModeApp"), "the index is not read");
        assertEq(False, ProviderIndexUtil::checkAppModule("QoreTestBuildModeApp"),
            "no module is loaded from the index");

        # leaving build mode makes the next lookup read the published index
        assertTrue(ProviderIndexUtil::setBuildMode(False));
        assertEq("QoreTestBuildModeApp", ProviderIndexUtil::tryGetAppInfo("QoreTestBuildModeApp").name);
    }

    equivalenceTest() {
        checkModules(True);

        string single_dir = make_tmp_dir();
        on_exit remove_tree(single_dir);
        string worker_dir = make_tmp_dir();
        on_exit remove_tree(worker_dir);
        on_exit restoreEnv();
        setEnv("QORE_DATA_PROVIDERS", registration_module);
        setEnv("QORE_PROVIDER_INDEX_FIXTURE_MODULE", provider_module);

        hash<auto> worker_info = ProviderIndex::createDataProviderIndex(NOTHING, worker_dir, getOptions(2));
        assertTrue(worker_info.summary.qualification.complete);
        assertEq(1, worker_info.summary.workers.size(), "one worker for the environment module");
        assertEq(0, worker_info.summary.workers[0].exit_code);
        assertTrue(inlist("IndexIdentityFixture", worker_info.summary.qualification.apps));
        assertEq(("IndexIdentityFixture",), keys ProviderIndexUtil::readDataProviderIndex().appmap."IndexIdentityFixture");

        # no staging files are left in the index directory
        assertEq((), (map $1, readIndexFiles(worker_dir).keyIterator(), $1 =~ /^\./) ?? ());

        ProviderIndex::createDataProviderIndex(NOTHING, single_dir, getOptions(0));
        assertEq(readIndexFiles(single_dir), readIndexFiles(worker_dir), "the index files are identical");
    }

    workerFailureTest() {
        checkModules(True);

        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        on_exit restoreEnv();
        setEnv("QORE_DATA_PROVIDERS", registration_module);
        setEnv("QORE_PROVIDER_INDEX_FIXTURE_MODULE", provider_module);
        ProviderIndex::createDataProviderIndex(NOTHING, dir, getOptions(1));
        hash<string, binary> published = readIndexFiles(dir);

        setEnv("QORE_PROVIDER_INDEX_FIXTURE_MODULE", "QoreTestMissingProviderIndexWorkerModule");
        try {
            ProviderIndex::createDataProviderIndex(NOTHING, dir, getOptions(1));
            fail("a build with a failed module must not be published");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("DATA-PROVIDER-DISCOVERY-ERROR", ex.err);
            assertFalse(ex.arg.complete);
            assertTrue((select ex.arg.failures, $1.module_context == "QoreTestMissingProviderIndexWorkerModule")
                .size() > 0, "the worker's failure is reported");
        }
        assertEq(published, readIndexFiles(dir), "the published index is untouched");
    }

    conflictTest() {
        checkModules(True);

        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        on_exit restoreEnv();

        # two provider modules, loaded by different workers, register the same action with different descriptions
        list<string> registration = ();
        File f();
        foreach string name in (("A", "B")) {
            string provider = sprintf("%s/ProviderIndexConflictFixture%s.qm", dir, name);
            f.open2(provider, O_CREAT | O_TRUNC | O_WRONLY);
            f.write(sprintf("%%modern
%%requires DataProvider
module ProviderIndexConflictFixture%s {
    version = \"1.0\"; desc = \"conflict fixture\"; author = \"Qore Technologies\"; license = \"MIT\";
    init = sub () {
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            \"name\": \"QoreTestConflictApp\", \"display_name\": \"Conflict\", \"short_desc\": \"Conflict\",
            \"desc\": \"Conflict\", \"groups\": (AppGroup::DataTransformation,), \"logo\": \"x\",
            \"logo_mime_type\": \"image/svg+xml\", \"logo_file_name\": \"x.svg\",
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            \"app\": \"QoreTestConflictApp\", \"action\": \"record\", \"path\": \"/record\",
            \"display_name\": \"Record\", \"short_desc\": \"Record\", \"desc\": \"Record %s\",
            \"action_code\": DPAT_API,
        });
    };
}
", name, name));

            string path = sprintf("%s/ProviderIndexConflictRegistration%s.qm", dir, name);
            f.open2(path, O_CREAT | O_TRUNC | O_WRONLY);
            f.write(sprintf("%%modern
module ProviderIndexConflictRegistration%s {
    version = \"1.0\"; desc = \"conflict fixture\"; author = \"Qore Technologies\"; license = \"MIT\";
}
public hash<string, string> sub get_data_provider_map() {
    return {\"conflict\": %y};
}
", name, provider));
            registration += path;
        }
        f.close();

        string index_dir = dir + "/index";
        setEnv("QORE_DATA_PROVIDERS", registration.join(PathSep));
        try {
            ProviderIndex::createDataProviderIndex(NOTHING, index_dir, getOptions(2));
            fail("conflicting workers must not be published");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("DATA-PROVIDER-DISCOVERY-ERROR", ex.err);
            list<hash<auto>> conflicts = select ex.arg.failures, $1.error == "PROVIDER-INDEX-WORKER-CONFLICT";
            assertEq(1, conflicts.size());
            assertEq("QoreTestConflictApp/record", conflicts[0].identity);
        }
        assertFalse(is_file(index_dir + "/qore-data-index.yaml"), "no index is published");
    }

    noMessagePackTest() {
        checkModules();
        if (ProviderIndexUtil::hasMessagePack()) {
            testSkip("MessagePack support is available");
        }

        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        on_exit restoreEnv();
        setEnv("QORE_DATA_PROVIDERS", registration_module);
        setEnv("QORE_PROVIDER_INDEX_FIXTURE_MODULE", provider_module);

        hash<auto> info = ProviderIndex::createDataProviderIndex(NOTHING, dir, getOptions(2));
        assertTrue(info.summary.qualification.complete);
        assertEq(0, info.summary.workers.size(), "no workers are started");
        assertTrue(inlist("IndexIdentityFixture", info.summary.qualification.apps));
    }

    cancelTest() {
        checkModules(True);
%ifndef NoProcess

        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        on_exit restoreEnv();
        setEnv("QORE_DATA_PROVIDERS", registration_module);
        setEnv("QORE_PROVIDER_INDEX_FIXTURE_MODULE", provider_module);
        ProviderIndex::createDataProviderIndex(NOTHING, dir + "/index", getOptions(1));
        hash<string, binary> published = readIndexFiles(dir + "/index");

        # a worker that reports its PID through a FIFO and then never finishes
        string fifo = dir + "/worker-pid";
        assertEq(0, mkfifo(fifo, 0600));
        string script = dir + "/worker.q";
        File f();
        f.open2(script, O_CREAT | O_TRUNC | O_WRONLY);
        f.write(sprintf("%%modern
File f();
f.open2(%y, O_WRONLY);
f.write(sprintf(\"%%d\\n\", getpid()));
f.close();
Queue q();
q.get();
", fifo));
        f.close();

        hash<ProviderIndexCreateOptions> opts = getOptions(1);
        string qore = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        if (qore.find(DirSep) >= 0) {
            qore = normalize_dir(qore);
        }
        opts.worker_command = (qore, script);

        Queue result();
        background sub () {
            # a build that ends without its worker starting would otherwise leave the reader below waiting
            on_exit {
                try {
                    File w();
                    w.open2(fifo, O_WRONLY | O_NONBLOCK);
                    w.write("0\n");
                } catch (hash<ExceptionInfo> ex) {
                }
            }
            try {
                ProviderIndex::createDataProviderIndex(NOTHING, dir + "/index", opts);
                result.push("published");
            } catch (hash<ExceptionInfo> ex) {
                result.push(ex.err);
            }
        }();

        File r();
        r.open2(fifo, O_RDONLY);
        int pid = int(trim(r.readLine()));
        r.close();
        assertGt(0, pid, "the worker started");
        assertTrue(Process::checkPid(pid), "the worker is running");

        assertEq(1, ProviderIndex::cancelWorkers(), "the running worker is terminated");
        assertEq("PROVIDER-INDEX-CANCELLED", result.get(), "the cancelled build fails");
        assertFalse(Process::checkPid(pid), "the worker has exited");
        assertEq(published, readIndexFiles(dir + "/index"), "the published index is untouched");
        assertEq((), (map $1, readIndexFiles(dir + "/index").keyIterator(), $1 =~ /^\./) ?? (),
            "no staging files are left");

        # builds started after the cancellation are not affected
        assertEq(0, ProviderIndex::cancelWorkers(), "no worker is running");
        ProviderIndex::createDataProviderIndex(NOTHING, dir + "/index", getOptions(1));
        assertEq(published, readIndexFiles(dir + "/index"), "a later build publishes the same index");
%endif
    }

    setupErrorTest() {
        checkModules(True);

        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        on_exit restoreEnv();

        # a worker command whose setup fails, as when an application's required module cannot be loaded
        string script = dir + "/worker.q";
        File f();
        f.open2(script, O_CREAT | O_TRUNC | O_WRONLY);
        f.write("%modern
%requires ProviderIndex
exit(ProviderIndex::runIndexWorker(ARGV[0], sub () {
    throw \"QORE-TEST-SETUP-ERROR\", \"the test setup failed\";
}));
");
        f.close();

        # two environment modules, so two batches; with one worker, the second batch is never started
        setEnv("QORE_DATA_PROVIDERS", registration_module + PathSep + registration_module + PathSep);
        setEnv("QORE_PROVIDER_INDEX_FIXTURE_MODULE", provider_module);
        hash<ProviderIndexCreateOptions> opts = getOptions(1);
        # a worker command must be found in the PATH or given as an absolute path; the interpreter may have been
        # started with a path relative to the working directory, as run_tests.sh runs "build/qore"
        string qore = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        if (qore.find(DirSep) >= 0) {
            qore = normalize_dir(qore);
        }
        opts.worker_command = (qore, script);
        try {
            ProviderIndex::createDataProviderIndex(NOTHING, dir + "/index", opts);
            fail("a build whose worker setup fails must not be published");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("DATA-PROVIDER-DISCOVERY-ERROR", ex.err);
            list<hash<auto>> failures = ex.arg.failures;
            assertEq(2, failures.size(), "the worker's error and the batches not run");
            assertRegex("QORE-TEST-SETUP-ERROR: the test setup failed", failures[0].description);
            assertEq(("w2",), failures[1].argument.batches);
        }
    }
}
