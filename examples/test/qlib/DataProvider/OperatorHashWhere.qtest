#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%enable-all-warnings

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires DataProvider
%requires SqlUtil

%exec-class OperatorHashWhereTest

#! an operator hash of the shape of SqlUtil's OperatorInfo: no op_args member
hashdecl TestOperatorInfo {
    string op;
    auto arg;
}

#! Minimal in-memory data provider supporting search expressions
class OperatorHashTestDataProvider inherits AbstractDataProvider {
    private {
        list<hash<auto>> data;
    }

    constructor(list<hash<auto>> data) {
        self.data = data;
    }

    string getName() {
        return "operator-hash-test";
    }

    private *hash<string, AbstractDataField> getRecordTypeImpl(*hash<auto> search_options) {
        HashDataType type();
        type.addField(new QoreDataField("id", "id", AbstractDataProviderType::get(IntType)));
        type.addField(new QoreDataField("name", "name", AbstractDataProviderType::get(StringType)));
        return type.getFields();
    }

    private AbstractDataProviderRecordIterator searchRecordsImpl(*hash<auto> where_cond,
            *hash<auto> search_options) {
        return new DefaultRecordIterator(new ListIterator(data), where_cond, search_options, getRecordType());
    }

    private hash<DataProviderInfo> getStaticInfoImpl() {
        return <DataProviderInfo>{
            "name": "operator-hash-test",
            "supports_read": True,
            "supports_search_expressions": True,
            "expressions": DataProviderGenericExpressions,
            "has_record": True,
        };
    }
}

#! Tests where hashes with operator hashes in providers that convert them to search expressions
class OperatorHashWhereTest inherits QUnit::Test {
    private {
        OperatorHashTestDataProvider provider(({"id": 1, "name": "alpha"}, {"id": 2, "name": "beta"},
            {"id": 3, "name": "gamma"}));
    }

    constructor() : Test("OperatorHashWhere", "1.0") {
        addTestCase("typed operator hashes without op_args", \typedOperatorHashTest());
        addTestCase("SqlUtil operator hashes", \sqlUtilOperatorHashTest());
        addTestCase("DataProvider search operators", \searchOperatorTest());
        addTestCase("invalid operator hashes", \negativeTest());
        set_return_value(main());
    }

    #! returns the ids of the records found
    private list<int> ids(hash<auto> where_cond) {
        AbstractDataProviderRecordIterator i = provider.searchRecords(where_cond);
        list<int> rv = ();
        while (i.next()) {
            rv += i.getValue().id;
        }
        return rv;
    }

    typedOperatorHashTest() {
        # reading op_args from a typed hash without that member raised INVALID-MEMBER
        assertEq((2, 3), ids({"id": <TestOperatorInfo>{"op": DP_SEARCH_OP_GT, "arg": 1}}));
        # the arguments of an operator of more than two arguments are given in a list
        assertEq((2, 3), ids({"id": <TestOperatorInfo>{"op": DP_SEARCH_OP_BETWEEN, "arg": (2, 3)}}));
        # a list is a single argument of an operator of two arguments
        assertEq((1, 3), ids({"id": <TestOperatorInfo>{"op": DP_SEARCH_OP_IN, "arg": (1, 3)}}));
        # an operator of an operator
        assertEq((2,), ids({"id": <TestOperatorInfo>{"op": DP_SEARCH_OP_NOT,
            "arg": <TestOperatorInfo>{"op": DP_SEARCH_OP_IN, "arg": (1, 3)}}}));
        # an operator whose argument is an operator with a false argument
        assertEq((2, 3), ids({"id": <TestOperatorInfo>{"op": DP_SEARCH_OP_NOT,
            "arg": <TestOperatorInfo>{"op": DP_SEARCH_OP_EQ, "arg": 1}}}));
    }

    sqlUtilOperatorHashTest() {
        assertEq((2, 3), ids({"id": op_gt(1)}));
        assertEq((2, 3), ids({"id": op_ge(2)}));
        assertEq((1, 2), ids({"id": op_lt(3)}));
        assertEq((1, 2), ids({"id": op_le(2)}));
        assertEq((2,), ids({"id": op_eq(2)}));
        assertEq((1, 3), ids({"id": op_ne(2)}));
        assertEq((2, 3), ids({"id": op_between(2, 3)}));
        assertEq((1, 3), ids({"id": op_in(1, 3)}));
        assertEq((1, 3), ids({"id": op_in((1, 3))}));
        assertEq((2,), ids({"id": op_not(op_in(1, 3))}));
        assertEq((3,), ids({"id": op_gt(1), "name": "gamma"}));
    }

    searchOperatorTest() {
        assertEq((2, 3), ids({"id": dp_op_gt(1)}));
        assertEq((2, 3), ids({"id": dp_op_between(2, 3)}));
        assertEq((1, 3), ids({"id": dp_op_in((1, 3))}));
        assertEq((2,), ids({"id": dp_op_not(dp_op_in((1, 3)))}));
        # the argument count of the inner operator is the inner operator's own
        assertEq((1,), ids({"id": dp_op_not(dp_op_between(2, 3))}));
    }

    negativeTest() {
        # an operator that the provider does not have
        assertThrows("DATA-PROVIDER-EXPRESSION-ERROR", \ids(), {"id": <TestOperatorInfo>{"op": "no-such-op",
            "arg": 1}});
        # a SqlUtil column comparison has no search expression
        assertThrows("DATA-PROVIDER-EXPRESSION-ERROR", \ids(), {"id": op_clt("name")});
        # the wrong number of arguments
        assertThrows("DATA-PROVIDER-EXPRESSION-ERROR", \ids(), {"id": <TestOperatorInfo>{"op": DP_SEARCH_OP_BETWEEN,
            "arg": 2}});
    }
}
