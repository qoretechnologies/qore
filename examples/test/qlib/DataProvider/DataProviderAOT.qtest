#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%allow-injection

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires FsUtil
%requires DataProvider
%requires ProviderIndexUtil

%try-module yaml
%define NoYaml
%endtry

%exec-class DataProviderAOTTest

public class DataProviderAOTTest inherits QUnit::Test {
    constructor() : Test("DataProvider AOT Test", "1.0") {
        addTestCase("provider index preserves type cache", \providerIndexPreservesTypeCache());
        addTestCase("child Program imports preserve type map", \childProgramImportsPreserveTypeMap());

        # Return for compatibility with test harnesses that check the return value.
        set_return_value(main());
    }

    private checkYaml() {
%ifdef NoYaml
        testSkip("no yaml module");
%endif
    }

    providerIndexPreservesTypeCache() {
        checkYaml();

        string dir = make_tmp_dir();
        on_exit remove_tree(dir);

        bool had_env = exists ENV{ProviderIndexEnvVar};
        string old_env = had_env ? ENV{ProviderIndexEnvVar} : "";
        on_exit {
            if (had_env) {
                ProviderIndexUtil::setEnvironmentVariable(old_env);
            } else {
                unsetenv(ProviderIndexEnvVar);
                remove ENV{ProviderIndexEnvVar};
            }
        }

        ProviderIndexUtil::setEnvironmentVariable(dir);
        ProviderIndexUtil::writeDataProviderIndex(<DataProviderIndexInfo>{
            "factorymap": {},
            "appmap": {},
            "schememap": {},
            "appinfomap": {},
            "actioninfomap": {},
            "top_actioninfomap": {},
        }, 0s, {});

        DataProvider::registerKnownTypes();
        list<string> before = DataProvider::getTypeCache().listRegisteredTypes();
        hash<string, bool> before_map = map {$1: True}, before;
        assertTrue(before_map{"/qore/hash"}, "registered type cache contains builtin hash type before index read");

        *list<hash<auto>> apps = ProviderIndexUtil::getCachedApps();
        assertEq(0, apps ? apps.size() : 0, "test index has no cached apps");

        list<string> after = DataProvider::getTypeCache().listRegisteredTypes();
        hash<string, bool> after_map = map {$1: True}, after;
        assertTrue(after_map{"/qore/hash"}, "registered type cache contains builtin hash type after index read");
        assertEq(before, after, "ProviderIndexUtil read must not reset the shared DataProvider type cache");
    }

    childProgramImportsPreserveTypeMap() {
        Counter cnt(5);
        list<string> failures = ();
        Mutex mtx();

        code record_failure = sub (string message) {
            AutoLock al(mtx);
            push failures, message;
        };

        for (int thread_index = 0; thread_index < 4; ++thread_index) {
            background sub (int idx) {
                on_exit cnt.dec();
                try {
                    for (int i = 0; i < 25; ++i) {
                        Program p(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES);
                        p.loadModule("SqlUtil");
                        p.loadModule("DataProvider");
                        p.parsePending("hash<auto> sub childSmoke() { return {}; }", "child-smoke");
                    }
                } catch (hash<ExceptionInfo> ex) {
                    record_failure(sprintf("loader %d failed: %s: %s", idx, ex.err, ex.desc));
                }
            }(thread_index);
        }

        background sub () {
            on_exit cnt.dec();
            try {
                for (int i = 0; i < 10000; ++i) {
                    auto softint_type = AbstractDataProviderTypeMap."softint";
                    if (softint_type.typeCode() != NT_OBJECT) {
                        throw "DATAPROVIDER-AOT-TYPE-MAP-ERROR",
                            sprintf("AbstractDataProviderTypeMap.\"softint\" has type code %d",
                                softint_type.typeCode());
                    }
                }
            } catch (hash<ExceptionInfo> ex) {
                record_failure(sprintf("reader failed: %s: %s", ex.err, ex.desc));
            }
        }();

        assertEq(0, cnt.waitForZero(30s), "concurrent child Program imports completed");
        assertEq((), failures, "concurrent child Program imports must not corrupt the DataProvider type map");
        assertEq(NT_OBJECT, AbstractDataProviderTypeMap."softint".typeCode(),
            "DataProvider type map remains initialized after child Program imports");
    }
}
