#!/usr/bin/env qore
# Copyright 2026 Qore Technologies, s.r.o.
%modern
%requires ProviderIndex >= 1.1
%requires json
%requires yaml

string target = ARGV[0];
string mode = ARGV[1];
if (mode == "legacy") {
    ProviderIndexUtil::writeDataProviderIndex(<DataProviderIndexInfo>{
        "appmap": {"IndexIdentityFixture": {target: True, get_module_hash().yaml.filename: True}},
    }, 0s, {});
}
if (mode == "read" || mode == "legacy") {
    bool loaded = ProviderIndexUtil::checkAppModule("IndexIdentityFixture");
    printf("%s\n", make_json({"loaded_app": loaded,
        "loaded": get_module_hash().IndexIdentityFixture.filename,
        "unloaded": ProviderIndexUtil::getAllAppModulesToLoad()}));
    exit(0);
}
load_module(target);
auto module_info = get_module_hash();
string artifact = module_info.IndexIdentityFixture.filename;
ProviderIndex::createDataProviderIndex(<DataProviderIndexInfo>{
    "factorymap": {"identity": artifact},
    "schememap": {"identity": {artifact: True, module_info.yaml.filename: True}},
}, ENV.QORE_PROVIDER_INDEX_DIR, <ProviderIndexCreateOptions>{
    "load_known_factories": False, "load_environment": False,
    "load_typescript_actions": False, "apps": ("IndexIdentityFixture",),
});
# the published index as it would be written to the canonical index file
string index_yaml = ProviderIndexUtil::dumpIndexYaml(ENV.QORE_PROVIDER_INDEX_DIR);
printf("%s\n", make_json({"index_yaml": index_yaml, "loaded": artifact,
    "unloaded": ProviderIndexUtil::getAllAppModulesToLoad()}));
