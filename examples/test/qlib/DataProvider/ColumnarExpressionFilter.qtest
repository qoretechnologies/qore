%modern
%enable-all-warnings

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires DataProvider
%requires dataframe
%requires i18n

%exec-class ColumnarExpressionFilterTest

class ColumnarExpressionFilterTest inherits QUnit::Test {
    constructor() : Test("ColumnarExpressionFilter", "1.0") {
        addTestCase("computed numeric DataFrame filter", \computedNumericDataFrame());
        addTestCase("computed numeric ColumnarResult filter", \computedNumericBufferColumns());
        addTestCase("field comparison DataFrame filter", \fieldComparisonDataFrame());
        addTestCase("field comparison ColumnarResult filter", \fieldComparisonBufferColumns());
        addTestCase("computed field comparison DataFrame filter", \computedFieldComparisonDataFrame());
        addTestCase("computed field comparison ColumnarResult filter", \computedFieldComparisonBufferColumns());
        addTestCase("truthy and inRange DataFrame filter", \truthyAndRangeDataFrame());
        addTestCase("membership DataFrame and ColumnarResult filters", \membershipFilters());
        addTestCase("string transform DataFrame filter", \stringTransformDataFrame());
        addTestCase("string transform ColumnarResult filter", \stringTransformBufferColumns());
        addTestCase("computed string predicate filters", \computedStringPredicateFilters());
        addTestCase("locale string predicate filters", \localeStringPredicateFilters());
        addTestCase("computed numeric function filters", \computedNumericFunctionFilters());
        addTestCase("computed string function filters", \computedStringFunctionFilters());
        addTestCase("computed date function filters", \computedDateFunctionFilters());
        addTestCase("float columns compared with numbers", \floatNumberComparisonFilters());
        addTestCase("string \"0\" as a condition", \stringZeroConditionFilters());

        set_return_value(main());
    }

    private hash<auto> makeColumns() {
        return {
            "id": new buffer<int64>((1, 2, 3, 4)),
            "amount": new buffer<float64>((50.0, 100.0, 125.0, 200.0)),
            "target": new buffer<float64>((60.0, 90.0, 130.0, 150.0)),
            "score": new buffer<int64>((88, 90, 85, 97)),
            "status": new buffer<string>(("Active", "inactive", "VIP", "active")),
            "name": (" Alice ", "Bob", "Carol", " Dave "),
            "created": (2026-03-15T10:30:00Z, 2026-01-20T00:00:00Z,
                2025-11-01T00:00:00Z, 2026-02-28T00:00:00Z),
            "city": new buffer<string>(("\u0130stanbul", "Istanbul", "Ankara", "Izmir")),
            "flag": new buffer<bool>((True, False, True, False)),
        };
    }

    private hash<DataProviderExpression> amountTimesComparison(float factor, float threshold) {
        return <DataProviderExpression>{
            "exp": ">=",
            "args": (
                <DataProviderExpression>{
                    "exp": "*",
                    "args": (<DataProviderFieldReference>{"field": "amount"}, factor),
                },
                threshold,
            ),
        };
    }

    private hash<DataProviderExpression> amountTargetComparison() {
        return <DataProviderExpression>{
            "exp": ">=",
            "args": (
                <DataProviderFieldReference>{"field": "amount"},
                <DataProviderFieldReference>{"field": "target"},
            ),
        };
    }

    private hash<DataProviderExpression> computedTargetComparison() {
        return <DataProviderExpression>{
            "exp": ">=",
            "args": (
                <DataProviderExpression>{
                    "exp": "+",
                    "args": (
                        <DataProviderFieldReference>{"field": "amount"},
                        <DataProviderFieldReference>{"field": "score"},
                    ),
                },
                <DataProviderExpression>{
                    "exp": "+",
                    "args": (
                        <DataProviderFieldReference>{"field": "target"},
                        100.0,
                    ),
                },
            ),
        };
    }

    private list<int> dataframeIds(DataFrame::DataFrame df) {
        return cast<list<int>>(df.getColumn("id"));
    }

    private list<int> columnarIds(ColumnarResult result) {
        return cast<list<int>>(result.getColumn("id").toList());
    }

    private assertShapeFilterIds(hash<DataProviderExpression> expr, list<int> expected, string label) {
        QoreFilterRecordsProcessor proc({"where_cond": expr});

        DataFrame::DataFrame df(makeColumns());
        assertEq(expected, dataframeIds(proc.processRecordsShape(df, DataProviderShape::DataFrameBlock)),
            label + " DataFrameBlock");

        ColumnarResult columns = ColumnarResult::fromColumnHash(makeColumns(), NOTHING);
        assertEq(expected, columnarIds(proc.processRecordsShape(columns, DataProviderShape::BufferColumns)),
            label + " BufferColumns");
    }

    private computedNumericDataFrame() {
        DataFrame::DataFrame df(makeColumns());
        QoreFilterRecordsProcessor proc({"where_cond": amountTimesComparison(1.5, 150.0)});
        DataFrame::DataFrame filtered = proc.processRecordsShape(df, DataProviderShape::DataFrameBlock);

        assertEq((2, 3, 4), dataframeIds(filtered));
    }

    private computedNumericBufferColumns() {
        ColumnarResult columns = ColumnarResult::fromColumnHash(makeColumns(), NOTHING);
        QoreFilterRecordsProcessor proc({"where_cond": amountTimesComparison(1.5, 150.0)});
        ColumnarResult filtered = proc.processRecordsShape(columns, DataProviderShape::BufferColumns);

        assertEq((2, 3, 4), columnarIds(filtered));
    }

    private fieldComparisonDataFrame() {
        DataFrame::DataFrame df(makeColumns());
        QoreFilterRecordsProcessor proc({"where_cond": amountTargetComparison()});
        DataFrame::DataFrame filtered = proc.processRecordsShape(df, DataProviderShape::DataFrameBlock);

        assertEq((2, 4), dataframeIds(filtered));
    }

    private fieldComparisonBufferColumns() {
        ColumnarResult columns = ColumnarResult::fromColumnHash(makeColumns(), NOTHING);
        QoreFilterRecordsProcessor proc({"where_cond": amountTargetComparison()});
        ColumnarResult filtered = proc.processRecordsShape(columns, DataProviderShape::BufferColumns);

        assertEq((2, 4), columnarIds(filtered));
    }

    private computedFieldComparisonBufferColumns() {
        ColumnarResult columns = ColumnarResult::fromColumnHash(makeColumns(), NOTHING);
        QoreFilterRecordsProcessor proc({"where_cond": computedTargetComparison()});
        ColumnarResult filtered = proc.processRecordsShape(columns, DataProviderShape::BufferColumns);

        assertEq((2, 4), columnarIds(filtered));
    }

    private computedFieldComparisonDataFrame() {
        DataFrame::DataFrame df(makeColumns());
        QoreFilterRecordsProcessor proc({"where_cond": computedTargetComparison()});
        DataFrame::DataFrame filtered = proc.processRecordsShape(df, DataProviderShape::DataFrameBlock);

        assertEq((2, 4), dataframeIds(filtered));
    }

    private truthyAndRangeDataFrame() {
        hash<DataProviderExpression> expr = <DataProviderExpression>{
            "exp": "&&",
            "args": (
                <DataProviderExpression>{
                    "exp": DP_EXPR_VALUE,
                    "args": (<DataProviderFieldReference>{"field": "flag"},),
                },
                <DataProviderExpression>{
                    "exp": DP_OP_RANGE,
                    "args": (<DataProviderFieldReference>{"field": "score"}, 85, 95),
                },
            ),
        };
        DataFrame::DataFrame df(makeColumns());
        QoreFilterRecordsProcessor proc({"where_cond": expr});
        DataFrame::DataFrame filtered = proc.processRecordsShape(df, DataProviderShape::DataFrameBlock);

        assertEq((1, 3), dataframeIds(filtered));
    }

    private membershipFilters() {
        assertShapeFilterIds(
            DataProvider::parseDpqlExpression('@status in ("Active", "VIP") && @id not in (2, 4)'),
            (1, 3),
            "membership DPQL filters are evaluated column-wise");

        assertShapeFilterIds(
            DataProvider::parseDpqlExpression('@id in (1, 4) || @status not in ("active", "inactive", "VIP")'),
            (1, 4),
            "numeric and string membership filters combine with dense masks");
    }

    private stringTransformBufferColumns() {
        hash<DataProviderExpression> expr = <DataProviderExpression>{
            "exp": "==",
            "args": (
                <DataProviderExpression>{
                    "exp": DP_OP_TO_LOWER,
                    "args": (<DataProviderFieldReference>{"field": "status"},),
                },
                "active",
            ),
        };
        ColumnarResult columns = ColumnarResult::fromColumnHash(makeColumns(), NOTHING);
        QoreFilterRecordsProcessor proc({"where_cond": expr});
        ColumnarResult filtered = proc.processRecordsShape(columns, DataProviderShape::BufferColumns);

        assertEq((1, 4), columnarIds(filtered));
    }

    private stringTransformDataFrame() {
        hash<DataProviderExpression> expr = <DataProviderExpression>{
            "exp": "==",
            "args": (
                <DataProviderExpression>{
                    "exp": DP_OP_TO_LOWER,
                    "args": (<DataProviderFieldReference>{"field": "status"},),
                },
                "active",
            ),
        };
        DataFrame::DataFrame df(makeColumns());
        QoreFilterRecordsProcessor proc({"where_cond": expr});
        DataFrame::DataFrame filtered = proc.processRecordsShape(df, DataProviderShape::DataFrameBlock);

        assertEq((1, 4), dataframeIds(filtered));
    }

    private computedStringPredicateFilters() {
        hash<DataProviderExpression> starts_expr = <DataProviderExpression>{
            "exp": DP_OP_STARTS_WITH,
            "args": (
                <DataProviderExpression>{
                    "exp": DP_OP_TO_LOWER,
                    "args": (<DataProviderFieldReference>{"field": "status"},),
                },
                "act",
            ),
        };
        hash<DataProviderExpression> like_expr = <DataProviderExpression>{
            "exp": DP_OP_LIKE,
            "args": (
                <DataProviderExpression>{
                    "exp": DP_OP_TO_LOWER,
                    "args": (<DataProviderFieldReference>{"field": "status"},),
                },
                "%vip%",
            ),
        };

        DataFrame::DataFrame df(makeColumns());
        QoreFilterRecordsProcessor starts_proc({"where_cond": starts_expr});
        assertEq((1, 4), dataframeIds(starts_proc.processRecordsShape(df, DataProviderShape::DataFrameBlock)),
            "DataFrameBlock computed string predicates avoid row materialization");

        QoreFilterRecordsProcessor like_proc({"where_cond": like_expr});
        assertEq((3,), dataframeIds(like_proc.processRecordsShape(df, DataProviderShape::DataFrameBlock)),
            "DataFrameBlock computed pattern predicates avoid row materialization");

        ColumnarResult columns = ColumnarResult::fromColumnHash(makeColumns(), NOTHING);
        assertEq((1, 4), columnarIds(starts_proc.processRecordsShape(columns, DataProviderShape::BufferColumns)),
            "BufferColumns computed string predicates build masks");
        assertEq((3,), columnarIds(like_proc.processRecordsShape(columns, DataProviderShape::BufferColumns)),
            "BufferColumns computed pattern predicates build masks");
    }

    private localeStringPredicateFilters() {
        hash<DataProviderExpression> expr = <DataProviderExpression>{
            "exp": DP_OP_STARTS_WITH,
            "args": (
                <DataProviderFieldReference>{"field": "city"},
                "i",
                {"value": {"locale": "tr-TR"}},
            ),
        };

        QoreFilterRecordsProcessor proc({"where_cond": expr});

        DataFrame::DataFrame df(makeColumns());
        DataFrame::DataFrame filtered_df = proc.processRecordsShape(df, DataProviderShape::DataFrameBlock);
        assertEq((1,), dataframeIds(filtered_df),
            "DataFrameBlock filter uses locale-sensitive string predicate masks");

        ColumnarResult columns = ColumnarResult::fromColumnHash(makeColumns(), NOTHING);
        ColumnarResult filtered_columns = proc.processRecordsShape(columns, DataProviderShape::BufferColumns);
        assertEq((1,), columnarIds(filtered_columns),
            "BufferColumns filter uses locale-sensitive string predicate masks");
    }

    private computedNumericFunctionFilters() {
        assertShapeFilterIds(
            DataProvider::parseDpqlExpression('round(@amount * 1.2) >= 120 && floor(@score / 10) == 9'),
            (2, 4),
            "numeric DPQL functions are evaluated column-wise");

        assertShapeFilterIds(
            DataProvider::parseDpqlExpression('ceil((@amount - 1) / 100) >= 2 && abs(@target - @amount) <= 50'),
            (3, 4),
            "additional numeric DPQL functions are evaluated column-wise");
    }

    private computedStringFunctionFilters() {
        assertShapeFilterIds(
            DataProvider::parseDpqlExpression(
                'trim(@name) == "Alice" || concat(trim(@name), ":", lwr(@status)) == "Dave:active"'),
            (1, 4),
            "string DPQL functions are evaluated column-wise");

        assertShapeFilterIds(
            DataProvider::parseDpqlExpression('nullif(lwr(@status), "inactive") == null'),
            (2,),
            "nullif() is evaluated column-wise");
    }

    private computedDateFunctionFilters() {
        assertShapeFilterIds(
            DataProvider::parseDpqlExpression('get_year(@created) == 2026 && get_month(@created) >= 2'),
            (1, 4),
            "date-part DPQL functions are evaluated column-wise");

        assertShapeFilterIds(
            DataProvider::parseDpqlExpression('@created >= 2026-04-01T00:00:00Z - days(60)'),
            (1, 4),
            "scalar date arithmetic is evaluated once for column-wise comparison");
    }

    private floatNumberComparisonFilters() {
        # a float value compared with a number is the number that its decimal digits give, in every shape:
        # 1.19 == 1.19n although number(1.19) is not 1.19n
        hash<auto> columns = {
            "id": new buffer<int64>((1, 2, 3)),
            "rate": new buffer<float64>((1.19, 2.5, 0.1)),
        };
        hash<string, list<int>> cases = {
            "==": (1,),
            "!=": (2, 3),
            "<=": (1, 3),
            ">=": (1, 2),
            "<": (3,),
            ">": (2,),
        };
        foreach hash<auto> i in (cases.pairIterator()) {
            hash<DataProviderExpression> expr = <DataProviderExpression>{
                "exp": i.key,
                "args": (<DataProviderFieldReference>{"field": "rate"}, 1.19n),
            };
            QoreFilterRecordsProcessor proc({"where_cond": expr});
            DataFrame::DataFrame df(columns);
            assertEq(i.value, dataframeIds(proc.processRecordsShape(df, DataProviderShape::DataFrameBlock)),
                i.key + " DataFrameBlock");
            ColumnarResult result = ColumnarResult::fromColumnHash(columns, NOTHING);
            assertEq(i.value, columnarIds(proc.processRecordsShape(result, DataProviderShape::BufferColumns)),
                i.key + " BufferColumns");
            list<hash<auto>> records = (
                {"id": 1, "rate": 1.19},
                {"id": 2, "rate": 2.5},
                {"id": 3, "rate": 0.1},
            );
            list<int> rows = map $1.id, records, AbstractDataProvider::evalGenericExpression($1, expr);
            assertEq(i.value, rows, i.key + " records");
        }
    }

    #! the string "0" is False as a condition and has a value in every evaluation path
    private stringZeroConditionFilters() {
        hash<auto> columns = makeColumns() + {
            "text": new buffer<string>(("0", "1", "", "abc")),
            "text_list": ("0", "1", "", "abc"),
        };
        foreach string field in ("text", "text_list") {
            hash<DataProviderExpression> value = <DataProviderExpression>{
                "exp": DP_EXPR_VALUE,
                "args": (<DataProviderFieldReference>{"field": field},),
            };
            hash<string, list<auto>> cases = {
                # top-level condition: truthiness mask
                "value": (value, (2, 4)),
                # negated condition: inverted mask
                "not": (<DataProviderExpression>{"exp": DP_SEARCH_OP_NOT, "args": (value,)}, (1, 3)),
                # combined conditions
                "and": (<DataProviderExpression>{"exp": DP_OP_AND, "args": (value,
                    <DataProviderExpression>{"exp": ">", "args": (<DataProviderFieldReference>{"field": "id"}, 0)},
                )}, (2, 4)),
                # condition evaluated per row inside a computed value
                "ternary": (<DataProviderExpression>{"exp": "==", "args": (
                    <DataProviderExpression>{"exp": DP_OP_TERNARY, "args": (value, 1, 0)}, 1,
                )}, (2, 4)),
                "or in ternary": (<DataProviderExpression>{"exp": "==", "args": (
                    <DataProviderExpression>{"exp": DP_OP_TERNARY, "args": (
                        <DataProviderExpression>{"exp": DP_OP_OR, "args": (value, False)}, 1, 0)}, 1,
                )}, (2, 4)),
                # has-value: "0" has a value
                "has-value": (<DataProviderExpression>{
                    "exp": DP_OP_HAS_VALUE,
                    "args": (<DataProviderFieldReference>{"field": field},),
                }, (1, 2, 4)),
            };
            foreach hash<auto> i in (cases.pairIterator()) {
                hash<DataProviderExpression> expr = i.value[0];
                list<int> expected = i.value[1];
                string label = sprintf("%s %s", field, i.key);

                # generic evaluation of each record
                list<int> generic_ids = ();
                foreach int id in (1, 2, 3, 4) {
                    if (AbstractDataProvider::evalGenericExpression({"id": id, field: columns{field}[id - 1]}, expr)) {
                        push generic_ids, id;
                    }
                }
                assertEq(expected, generic_ids, label + " generic");

                QoreFilterRecordsProcessor proc({"where_cond": expr});
                DataFrame::DataFrame df(columns);
                assertEq(expected, dataframeIds(proc.processRecordsShape(df, DataProviderShape::DataFrameBlock)),
                    label + " DataFrameBlock");
                ColumnarResult result = ColumnarResult::fromColumnHash(columns, NOTHING);
                assertEq(expected, columnarIds(proc.processRecordsShape(result, DataProviderShape::BufferColumns)),
                    label + " BufferColumns");
            }
        }
    }
}
