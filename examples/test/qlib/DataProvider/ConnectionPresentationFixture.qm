%modern
%requires ConnectionProvider

module ConnectionPresentationFixture {
    version = "1.0";
    desc = "connection presentation extraction fixture";
    author = "Qore Technologies";
    license = "MIT";
    init = sub() {
        ConnectionSchemeCache::registerScheme("presentation-fixture", FixtureConnection::ConnectionScheme);
        ConnectionSchemeCache::registerScheme("presentation-fixtures", FixtureConnection::ConnectionScheme);
    };
}

public namespace ConnectionPresentationFixture {
public class FixtureConnection inherits HttpConnection {
    public {
        const ConnectionScheme = ConnectionProvider::connection_scheme_presentation(
            "ConnectionPresentationFixture", "fixture", "en", <ConnectionSchemeInfo>{
                "cls": Class::forName("FixtureConnection"),
                "schemes": {"presentation-fixture": True, "presentation-fixtures": True},
                "display_name": "Fixture Connection", "short_desc": "A fixture connection", "desc": "Fixture details",
                "options": HttpConnection::ConnectionScheme.options + {
                    "account": <ConnectionOptionInfo>{"type": "string", "display_name": "Account",
                        "desc": "Account identifier"},
                },
                "messages": (<UiMessageInfo>{"presentation_id": "setup", "intent": "info",
                    "title": "Setup", "content": "Configure your account"},),
            });
    }
}
}
