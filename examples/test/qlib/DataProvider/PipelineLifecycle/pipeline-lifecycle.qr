#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# runs a DataProviderPipeline lifecycle case given as the first argument; run by PipelineLifecycle-<n>.qtest

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires DataProvider

/** Each case prints what it checks and ends the script normally; the program must then end (qore#7771): it waits for
    every thread before it releases its global variables, so a queue thread of a pipeline in a global variable that
    waited for data kept it from ending.  The callback cases check that an error of the pipeline's thread callback is
    raised by the call that starts the run, which hung before (qore#7777).
*/

#! adds a value to each record
class AddProc inherits DataProvider::AbstractDataProcessor {
    private {
        int add;
    }

    constructor(int add) {
        self.add = add;
    }

    string className() {
        return "AddProc";
    }

    private submitImpl(code<nothing(auto)> enqueue, auto _data) {
        enqueue(_data + add);
    }

    private bool supportsBulkApiImpl() {
        return False;
    }
}

#! the number of threads that wait for a run in the race cases
const RaceWaiters = 8;

#! takes time for some records, so that the threads that wait for the run wait while it processes them
class SpinProc inherits DataProvider::AbstractDataProcessor {
    string className() {
        return "SpinProc";
    }

    private submitImpl(code<nothing(auto)> enqueue, auto _data) {
        int n = 0;
        for (int i = 0; i < (abs(_data) % 7) * 3000; ++i) {
            n += i;
        }
        enqueue(_data);
    }

    private bool supportsBulkApiImpl() {
        return False;
    }
}

#! buffers the records that it gets and emits them when it is flushed
class BufProc inherits DataProvider::AbstractDataProcessor {
    private {
        list<auto> buf = ();
    }

    string className() {
        return "BufProc";
    }

    private submitImpl(code<nothing(auto)> enqueue, auto _data) {
        push buf, _data;
    }

    private flushImpl(code enqueue) {
        map enqueue($1), (remove buf);
    }

    private bool supportsBulkApiImpl() {
        return False;
    }
}

#! counts the records that it gets
class CountProc inherits DataProvider::AbstractDataProcessor {
    public {
        Counter seen();
    }

    string className() {
        return "CountProc";
    }

    private submitImpl(code<nothing(auto)> enqueue, auto _data) {
        seen.inc();
    }

    private bool supportsBulkApiImpl() {
        return False;
    }
}

#! raises an error for record 1
class FailProc inherits DataProvider::AbstractDataProcessor {
    string className() {
        return "FailProc";
    }

    private submitImpl(code<nothing(auto)> enqueue, auto _data) {
        if (_data == 1) {
            throw "FAIL", "record 1";
        }
        enqueue(_data);
    }

    private bool supportsBulkApiImpl() {
        return False;
    }
}

#! a fan-out pipeline whose queue 0 flushes records to its child queues: queue 0 (SpinProc, BufProc) feeds queue 1
#! (SpinProc, CountProc) and queue 2 (BufProc or nothing, CountProc)
class FanOutPipeline {
    public {
        DataProviderPipeline p();
        CountProc c1();
        CountProc c2();
    }

    constructor(bool buf0, bool buf2) {
        p.append(new SpinProc());
        if (buf0) {
            p.append(new BufProc());
        }
        int q1 = p.appendQueue(0);
        int q2 = p.appendQueue(0);
        p.append(q1, new SpinProc());
        p.append(q1, c1);
        if (buf2) {
            p.append(q2, new BufProc());
        }
        p.append(q2, c2);
    }

    #! throws an exception if a record that the pipeline counted has not been processed in both child queues
    check(int it, string what) {
        int rc = p.getInfo().record_count;
        if (c1.seen.getCount() != rc || c2.seen.getCount() != rc) {
            throw "RACE-ERROR", sprintf("iteration %d: %s: record_count %d; the child queues processed %d and %d",
                it, what, rc, c1.seen.getCount(), c2.seen.getCount());
        }
    }
}

#! a pipeline whose debug log the queue threads call, and that records the thread that destroys it
class HoldPipeline inherits DataProviderPipeline {
    public {
        #! the number of debug log calls
        int logged = 0;

        #! the TID of the thread that ran the destructor
        static *int destroyed_in;
    }

    constructor() : DataProviderPipeline(<PipelineOptionInfo>{"name": "hold"}) {
    }

    destructor() {
        HoldPipeline::destroyed_in = gettid();
    }

    #! called by the queue threads, which hold the pipeline while they call it
    logDebug(string fmt, ...) {
        ++logged;
    }
}

#! records the records that it gets, and the threads that it gets them in
class SinkProc inherits DataProvider::AbstractDataProcessor {
    public {
        list<auto> recs();
        hash<string, bool> tids();
    }

    private {
        Mutex m();
    }

    string className() {
        return "SinkProc";
    }

    private submitImpl(code<nothing(auto)> enqueue, auto _data) {
        m.lock();
        on_exit m.unlock();
        push recs, _data;
        tids{gettid()} = True;
    }

    private bool supportsBulkApiImpl() {
        return False;
    }

    list<auto> getSorted() {
        m.lock();
        on_exit m.unlock();
        return sort(recs);
    }
}

# the pipeline of the global cases; the program releases it after it has waited for its threads
our DataProviderPipeline pipe;

# the pipeline of the top-level case, a variable of the script's top-level code
*DataProviderPipeline top_pipe;

# the number of thread callback calls
our int callbacks = 0;

# True if every thread callback call raises an error
our bool fail_all = False;

# the number of the thread callback call that raises an error, if not 0
our int fail_at = 0;

# the error log messages
our list<string> errors = ();

sub thread_callback() {
    ++callbacks;
    if (fail_all || callbacks == fail_at) {
        throw "CB-ERROR", sprintf("callback %d failed", callbacks);
    }
}

hash<PipelineOptionInfo> sub opts(*bool callback) {
    hash<PipelineOptionInfo> rv = <PipelineOptionInfo>{
        "name": "lifecycle",
        "error_log": sub (string fmt) { push errors, vsprintf(fmt, argv); },
    };
    if (callback) {
        rv.thread_callback = \thread_callback();
    }
    return rv;
}

#! submits a record and prints the error that the submission raises
sub submit_error(DataProviderPipeline p, auto rec) {
    try {
        p.submit(rec);
        printf("submitted: no error\n");
    } catch (hash<ExceptionInfo> ex) {
        printf("submit error: %s: %s\n", ex.err, ex.desc);
    }
    printf("processing: %y\n", p.isProcessing());
}

#! calls waitDone() on a pipeline that another thread may abort
/** The submissions to a queue that the abort refuses are the errors of the run that waitDone() raises; no other
    error is expected
*/
sub waitDoneAborted(DataProviderPipeline p) {
    try {
        p.waitDone();
    } catch (hash<ExceptionInfo> ex) {
        if (ex.err != "PIPELINE-FAILED" || (select ex.arg, $1.err != "PIPELINE-SUBMISSION-ABORTED")) {
            rethrow;
        }
    }
}

#! prints the error log messages about the callback's error
sub print_errors() {
    printf("errors logged: %d (callback error: %y)\n", errors.size(),
        (select errors, $1 =~ /CB-ERROR/).size() == errors.size());
    errors = ();
}

string c = shift ARGV;
switch (c) {
    # a pipeline in a global variable that processed a record
    case "global": {
        SinkProc sink();
        pipe = new DataProviderPipeline(opts());
        pipe.append(new AddProc(1));
        pipe.append(sink);
        pipe.submit(1);
        pipe.waitDone();
        printf("records: %y\n", sink.getSorted());
        break;
    }

    # a pipeline in a variable of the top-level code that processed a record
    case "top-level": {
        SinkProc sink();
        top_pipe = new DataProviderPipeline(opts());
        top_pipe.append(new AddProc(1));
        top_pipe.append(sink);
        top_pipe.submit(1);
        top_pipe.waitDone();
        printf("records: %y\n", sink.getSorted());
        break;
    }

    # a pipeline in a global variable that processed no data
    case "global-idle": {
        pipe = new DataProviderPipeline(opts());
        pipe.append(new AddProc(1));
        printf("processing: %y\n", pipe.isProcessing());
        break;
    }

    # a pipeline in a global variable with fan-out queues, and two runs: each run has its own queue threads
    case "global-fanout": {
        SinkProc sink();
        pipe = new DataProviderPipeline(opts(True));
        pipe.append(0, new AddProc(1));
        int q1 = pipe.appendQueue(0);
        int q2 = pipe.appendQueue(0);
        pipe.append(q1, new AddProc(10));
        pipe.append(q1, sink);
        pipe.append(q2, new AddProc(20));
        pipe.append(q2, sink);
        printf("callbacks before the run: %d\n", callbacks);
        for (int run = 0; run < 2; ++run) {
            pipe.submit(1);
            pipe.submit(2);
            pipe.waitDone();
            printf("run %d: records: %y callbacks: %d\n", run, sink.getSorted(), callbacks);
            sink.recs = ();
        }
        break;
    }

    # a pipeline in a global variable whose run is aborted
    case "global-abort": {
        pipe = new DataProviderPipeline(opts());
        pipe.append(new AddProc(1));
        pipe.submit(1);
        pipe.abort(True);
        printf("processing: %y\n", pipe.isProcessing());
        break;
    }

    # a pipeline copied from one in a global variable, kept in another global variable
    case "global-copy": {
        SinkProc sink();
        DataProviderPipeline orig(opts());
        orig.append(new AddProc(1));
        orig.append(sink);
        pipe = orig.copy();
        pipe.submit(1);
        pipe.waitDone();
        printf("records: %y\n", sink.getSorted());
        break;
    }

    # the thread callback raises an error in every queue thread
    case "callback-throws": {
        fail_all = True;
        DataProviderPipeline p(opts(True));
        printf("constructed: callbacks: %d\n", callbacks);
        p.append(new AddProc(1));
        submit_error(p, 1);
        print_errors();
        # the run did not start; the next submission starts it again and gets the error again
        submit_error(p, 1);
        print_errors();
        p.waitDone();
        remove p;
        printf("destroyed\n");
        break;
    }

    # the thread callback raises an error in the second of three queue threads: the first one is ended, and the next
    # run, with a callback that succeeds, processes the data
    case "callback-throws-fanout": {
        SinkProc sink();
        pipe = new DataProviderPipeline(opts(True));
        pipe.append(0, new AddProc(1));
        int q1 = pipe.appendQueue(0);
        int q2 = pipe.appendQueue(0);
        pipe.append(q1, sink);
        pipe.append(q2, new AddProc(10));
        pipe.append(q2, sink);
        # the first run: the callback of the second thread raises an error, which is raised, and the first thread is
        # ended
        fail_at = 2;
        submit_error(pipe, 1);
        print_errors();
        # the next run: every callback succeeds
        fail_at = 0;
        pipe.submit(1);
        pipe.waitDone();
        printf("records: %y callbacks: %d\n", sink.getSorted(), callbacks);
        break;
    }

    # a pipeline in a global variable whose thread callback raises an error
    case "callback-throws-global": {
        fail_all = True;
        pipe = new DataProviderPipeline(opts(True));
        pipe.append(new AddProc(1));
        submit_error(pipe, 1);
        print_errors();
        break;
    }

    # threads wait in waitDone() while another thread ends the run with abort() or waitDone(); every waiter must
    # return: a waiter that the end of the run woke after the queue threads had ended waited for a flush that no
    # thread made
    case "race-abort":
    case "race-waitdone": {
        int iters = (shift ARGV ?? 1000).toInt();
        for (int it = 0; it < iters; ++it) {
            DataProviderPipeline p();
            p.append(new SpinProc());
            for (int i = 0; i < 3; ++i) {
                p.submit(i + it);
            }
            Counter waiting(RaceWaiters);
            for (int w = 0; w < RaceWaiters; ++w) {
                background sub () {
                    on_exit waiting.dec();
                    p.waitDone();
                }();
            }
            if (c == "race-abort") {
                p.abort(True);
            } else {
                p.waitDone();
            }
            waiting.waitForZero();
            # the pipeline can run again
            p.reset();
            p.submit(-1);
            p.waitDone();
            hash<PipelineInfo> info = p.getInfo();
            if (info.record_count != 1 || info.status != PS_IDLE) {
                throw "RACE-ERROR", sprintf("iteration %d: the next run: %y", it, info{"record_count", "status"});
            }
        }
        printf("%s: all waiters returned in %d iterations\n", c, iters);
        break;
    }

    # a fan-out pipeline whose queue 0 emits records when it is flushed, ended by threads that call waitDone() and
    # abort() at once: a queue thread that the end of the run stopped while its flush waited for a child queue
    # waited for data forever, and the run never ended
    case "race-flush": {
        int iters = (shift ARGV ?? 1000).toInt();
        for (int it = 0; it < iters; ++it) {
            FanOutPipeline fp(True, True);
            DataProviderPipeline p = fp.p;
            for (int i = 0; i < 4; ++i) {
                p.submit(i + it);
            }
            Counter waiting(RaceWaiters);
            for (int w = 0; w < RaceWaiters; ++w) {
                background sub (int w) {
                    on_exit waiting.dec();
                    if (w % 3 == 2) {
                        p.abort(True);
                    } else {
                        waitDoneAborted(p);
                    }
                }(w);
            }
            waitDoneAborted(p);
            waiting.waitForZero();
            if (p.isProcessing()) {
                throw "RACE-ERROR", sprintf("iteration %d: the pipeline is still processing", it);
            }
            # the pipeline can run again: the record of the next run is processed in both child queues, which also
            # get the records that the buffers of the aborted run held
            p.reset();
            int s1 = fp.c1.seen.getCount();
            int s2 = fp.c2.seen.getCount();
            p.submit(-1);
            p.waitDone();
            hash<PipelineInfo> info = p.getInfo();
            if (info.record_count != 1 || info.status != PS_IDLE || fp.c1.seen.getCount() - s1 < 1
                    || fp.c2.seen.getCount() - s2 < 1) {
                throw "RACE-ERROR", sprintf("iteration %d: the next run: %y; processed %d and %d", it,
                    info{"record_count", "status"}, fp.c1.seen.getCount() - s1, fp.c2.seen.getCount() - s2);
            }
        }
        printf("%s: every run ended in %d iterations\n", c, iters);
        break;
    }

    # the end of the run stops queue 0 while its thread has released the lock after its flush (the debug-only test
    # hooks of the pipeline hold it there): a thread that waited for data without checking the queue's state again
    # missed the stop, and the run never ended
    case "flush-window": {
        Counter in_window(1);
        Counter stopped(1);
        Queue gate();
        bool armed = True;
        code after_flush = sub (int id, code unlocked) {
            if (id || !armed) {
                return;
            }
            armed = False;
            in_window.dec();
            # the lock is released until the end of the run has stopped the queues
            unlocked(sub () { gate.get(); });
        };
        code after_stop = sub () {
            if (!armed && stopped.getCount()) {
                stopped.dec();
            }
        };
        try {
            call_static_method("DataProvider::DataProviderPipeline", "setTestHooks", after_flush, after_stop);
        } catch (hash<ExceptionInfo> ex) {
            # a module that was not built with QoreDebug has no test hooks
            printf("skipped: %s\n", ex.err);
            break;
        }
        on_exit call_static_method("DataProvider::DataProviderPipeline", "setTestHooks");

        FanOutPipeline fp(True, False);
        DataProviderPipeline p = fp.p;
        p.submit(1);
        Counter ended(1);
        background sub () {
            on_exit ended.dec();
            p.waitDone();
        }();
        # queue 0's thread has flushed and released the lock
        in_window.waitForZero();
        # the end of the run has stopped the queues
        stopped.waitForZero();
        gate.push(True);
        # a deadline: the run ends at once, or never
        if (ended.waitForZero(30s)) {
            printf("the run did not end\n");
            exit(1);
        }
        printf("run ended: processed %d and %d\n", fp.c1.seen.getCount(), fp.c2.seen.getCount());
        break;
    }

    # a submission while other threads end the run with waitDone(): a record accepted while the run ended was left in
    # a queue that no thread processed; it is now processed in the next run, which the submission starts
    case "late-submit":
    case "late-submit-buf": {
        int iters = (shift ARGV ?? 1000).toInt();
        int accepted = 0;
        for (int it = 0; it < iters; ++it) {
            FanOutPipeline fp(c == "late-submit-buf", False);
            DataProviderPipeline p = fp.p;
            for (int i = 0; i < 4; ++i) {
                p.submit(i + it);
            }
            Counter waiting(RaceWaiters / 2 + 1);
            for (int w = 0; w < RaceWaiters / 2; ++w) {
                background sub () {
                    on_exit waiting.dec();
                    p.waitDone();
                }();
            }
            background sub () {
                on_exit waiting.dec();
                p.submit(100);
            }();
            p.waitDone();
            waiting.waitForZero();
            # the run that the submission may have started
            p.waitDone();
            fp.check(it, "after the late submission");
            accepted += fp.c1.seen.getCount() == 5 ? 1 : 0;
        }
        printf("%s: every accepted record was processed in %d iterations (%s)\n", c, iters,
            accepted == iters ? "all accepted" : "not all accepted");
        break;
    }

    # the queue threads hold the pipeline while they call it (its debug log here, qore#7509), and release it before
    # they end with the run: once waitDone() has returned, the caller's reference is the last one, and its release
    # destroys the pipeline at once, in the caller's thread
    case "hold-released": {
        for (int run = 0; run < 2; ++run) {
            HoldPipeline p();
            p.append(0, new AddProc(1));
            int q1 = p.appendQueue(0);
            int q2 = p.appendQueue(0);
            CountProc c1();
            CountProc c2();
            p.append(q1, new BufProc());
            p.append(q1, c1);
            p.append(q2, c2);
            for (int i = 0; i < 3; ++i) {
                p.submit(i);
            }
            if (run) {
                # another thread ends the run while this one waits for it
                Counter ended(1);
                background sub () {
                    on_exit ended.dec();
                    p.waitDone();
                }();
                p.waitDone();
                ended.waitForZero();
            } else {
                p.waitDone();
            }
            int logged = p.logged;
            remove p;
            printf("run %d: processed %d and %d; debug log called: %y; destroyed: %y\n", run, c1.seen.getCount(),
                c2.seen.getCount(), logged > 0, HoldPipeline::destroyed_in == gettid());
            remove HoldPipeline::destroyed_in;
        }
        break;
    }

    # a synchronous pipeline given an iterator processes its records on the caller's thread: they were queued for a
    # queue thread that a synchronous pipeline does not start, and waitDone() never returned (qore#7793)
    case "sync-iterator": {
        DataProviderPipeline p(<PipelineOptionInfo>{"synchronous": True});
        SinkProc sink();
        p.append(sink);
        p.submitData(new ListIterator((1, 2, 3)));
        p.waitDone();
        printf("submitData(): records: %y record_count: %d\n", sink.getSorted(), p.getInfo().record_count);
        p.reset();
        sink.recs = ();
        p.submit(new DefaultRecordIterator(new ListIterator(({"a": 1}, {"a": 2}))));
        p.waitDone();
        printf("submit(record iterator): records: %y record_count: %d threads: %d\n", sink.recs,
            p.getInfo().record_count, sink.tids.size());
        break;
    }

    # a synchronous pipeline: a record that the queue refuses after the run has aborted is not counted
    case "sync-count": {
        DataProviderPipeline p(<PipelineOptionInfo>{"synchronous": True});
        p.append(new FailProc());
        p.submit(1);
        try {
            p.submit(2);
            printf("submit(2) accepted\n");
        } catch (hash<ExceptionInfo> ex) {
            printf("submit(2): %s\n", ex.err);
        }
        printf("record_count: %d\n", p.getInfo().record_count);
        try {
            p.waitDone();
        } catch (hash<ExceptionInfo> ex) {
            printf("waitDone: %s\n", ex.err);
        }
        break;
    }

    default:
        throw "BAD-CASE", sprintf("unknown case %y", c);
}

printf("end of script\n");
