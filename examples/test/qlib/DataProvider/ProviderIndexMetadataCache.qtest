#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%allow-injection

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires FsUtil
%requires DataProvider
%requires ProviderIndexUtil

%try-module yaml
%define NoYaml
%endtry

%try-module msgpack
%define NoMsgPack
%endtry

%exec-class ProviderIndexMetadataCacheTest

public class ProviderIndexMetadataCacheTest inherits QUnit::Test {
    constructor() : Test("ProviderIndex metadata cache test", "1.0") {
        addTestCase("corrupt cache falls back to canonical index", \corruptCacheFallsBackToCanonicalIndex());
        addTestCase("a published index is read without the canonical index file", \serializedIndexTest());
        addTestCase("listing apps leaves their actions to be loaded when needed", \appsOnlyTest());
        addTestCase("listing apps reads only the metadata cache manifest", \appsFromManifestTest());
        addTestCase("a canonical index changed after it was published is read instead of the compact files",
            \changedCanonicalTest());

        set_return_value(main());
    }

    private checkModules() {
%ifdef NoYaml
        testSkip("no yaml module");
%endif
%ifdef NoMsgPack
        testSkip("no msgpack module");
%endif
    }

    corruptCacheFallsBackToCanonicalIndex() {
        checkModules();

        string dir = make_tmp_dir();
        on_exit remove_tree(dir);

        bool had_env = exists ENV{ProviderIndexEnvVar};
        string old_env = had_env ? ENV{ProviderIndexEnvVar} : "";
        on_exit {
            if (had_env) {
                ProviderIndexUtil::setEnvironmentVariable(old_env);
            } else {
                unsetenv(ProviderIndexEnvVar);
                remove ENV{ProviderIndexEnvVar};
            }
        }

        string indexed_app = "QoreTestCachedApp";
        string indexed_action = "cached-action";
        ProviderIndexUtil::setEnvironmentVariable(dir);
        ProviderIndexUtil::writeDataProviderIndex(<DataProviderIndexInfo>{
            "factorymap": {},
            "appmap": {},
            "schememap": {},
            "appinfomap": {
                indexed_app: {
                    "name": indexed_app,
                },
            },
            "actioninfomap": {
                indexed_app: {
                    indexed_action: {
                        "app": indexed_app,
                        "action": indexed_action,
                    },
                },
            },
            "top_actioninfomap": {},
        }, 0s, {});

        string cache_path = dir + DirSep + "qore-data-index.msgpack";
        assertTrue(hstat(cache_path) != NOTHING, "provider index writer creates the optional metadata cache");
        File cache();
        cache.open2(path: cache_path, flags: O_WRONLY | O_TRUNC);
        cache.write(<deadbeef>);
        cache.close();

        assertFalse(ProviderIndexUtil::checkAppModule("QoreTestUnknownApp"),
            "routing-only lookup validates the sidecar before deferred metadata loading");
        assertEq(indexed_app, ProviderIndexUtil::tryGetAppInfo(indexed_app).name,
            "cache digest failure falls back to canonical app metadata");
        assertEq(indexed_action,
            ProviderIndexUtil::tryGetActionMetadata(indexed_app, indexed_action).action,
            "cache digest failure falls back to canonical action metadata");
    }

    serializedIndexTest() {
        checkModules();

        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        assertNothing(ProviderIndexUtil::readSerializedDataProviderIndex(dir), "no index yet");

        hash<auto> maps = {
            "factorymap": {"qoretest": "QoreTestModule"},
            "appmap": {"QoreTestApp": {"QoreTestModule": True}},
            "schememap": {"qoretest": {"QoreTestModule": True}},
            "appinfomap": {
                "QoreTestApp": {"name": "QoreTestApp", "desc": "orders"},
                "QoreTestEmptyApp": {"name": "QoreTestEmptyApp"},
            },
        };
        hash<auto> actions = {
            "QoreTestApp": {
                "create-order": {"app": "QoreTestApp", "action": "create-order", "created": 2026-09-25T10:00:00Z},
            },
        };
        bool had_env = exists ENV{ProviderIndexEnvVar};
        string old_env = had_env ? ENV{ProviderIndexEnvVar} : "";
        on_exit if (had_env) {
            ProviderIndexUtil::setEnvironmentVariable(old_env);
        }
        ProviderIndexUtil::setEnvironmentVariable(dir);
        ProviderIndexUtil::writeDataProviderIndexByApp(maps, keys actions, *hash<auto> sub (string app) {
            return actions{app};
        }, 0s, {});

        # the same index as the canonical index file
        *hash<SerializedDataProviderIndexInfo> info = ProviderIndexUtil::readSerializedDataProviderIndex(dir);
        assertEq(maps + {"actioninfomap": actions}, info.index);
        assertEq(parse_yaml(ReadOnlyFile::readTextFile(dir + "/qore-data-index.yaml")), info.index);
        assertEq(digest("sha256", ReadOnlyFile::readBinaryFile(dir + "/qore-routing-index.yaml")).toHex(),
            info.sha256);

        # apps can be read one at a time
        hash<auto> streamed = {"appinfomap": {}, "actioninfomap": {}};
        *hash<SerializedDataProviderIndexInfo> per_app_info = ProviderIndexUtil::readSerializedDataProviderIndex(dir,
            sub (string app, *hash<auto> app_info, *hash<auto> app_actions) {
                streamed.appinfomap{app} = app_info;
                if (app_actions) {
                    streamed.actioninfomap{app} = app_actions;
                }
            });
        assertEq(info.sha256, per_app_info.sha256);
        assertEq(maps - "appinfomap", per_app_info.index, "only the maps are returned");
        assertEq(info.index{"appinfomap", "actioninfomap"}, streamed);

        # an exception raised by the caller's code is passed on
        assertThrows("QORE-TEST-PER-APP-ERROR", \ProviderIndexUtil::readSerializedDataProviderIndex(), (dir,
            sub (string app, *hash<auto> app_info, *hash<auto> app_actions) {
                throw "QORE-TEST-PER-APP-ERROR";
            }));

        # the source has the same digest and size without the index
        *hash<SerializedDataProviderIndexInfo> source = ProviderIndexUtil::getSerializedDataProviderIndexSource(dir);
        assertEq(info.sha256, source.sha256);
        assertEq(info.size, source.size);
        assertNothing(source.index);

        # the canonical index file is not needed
        unlink(dir + "/qore-data-index.yaml");
        assertEq(info, ProviderIndexUtil::readSerializedDataProviderIndex(dir));

        # inconsistent files are not read: a changed app chunk, a changed manifest, and a changed routing index
        string chunk = sprintf("%s/qore-data-index-%s.msgpack", dir, digest("sha256", "QoreTestApp").toHex());
        foreach string path in ((chunk, dir + "/qore-data-index.msgpack", dir + "/qore-routing-index.yaml")) {
            binary data = ReadOnlyFile::readBinaryFile(path);
            {
                File f();
                f.open2(path, O_WRONLY | O_TRUNC);
                f.write(data + <00>);
            }
            assertNothing(ProviderIndexUtil::readSerializedDataProviderIndex(dir), path);
            assertNothing(ProviderIndexUtil::getSerializedDataProviderIndexSource(dir), path);
            File f();
            f.open2(path, O_WRONLY | O_TRUNC);
            f.write(data);
        }
        assertEq(info, ProviderIndexUtil::readSerializedDataProviderIndex(dir), "restored files are read again");
    }

    appsOnlyTest() {
        checkModules();

        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        bool had_env = exists ENV{ProviderIndexEnvVar};
        string old_env = had_env ? ENV{ProviderIndexEnvVar} : "";
        on_exit if (had_env) {
            ProviderIndexUtil::setEnvironmentVariable(old_env);
        }
        ProviderIndexUtil::setEnvironmentVariable(dir);

        hash<auto> actions = {
            "QoreTestOrders": {"create-order": {"app": "QoreTestOrders", "action": "create-order"}},
            "QoreTestInvoices": {"send-invoice": {"app": "QoreTestInvoices", "action": "send-invoice"}},
        };
        ProviderIndexUtil::writeDataProviderIndexByApp({
            "factorymap": {},
            "appmap": {},
            "schememap": {},
            "appinfomap": map {$1: {"name": $1}}, keys actions,
        }, keys actions, *hash<auto> sub (string app) { return actions{app}; }, 0s, {});

        # discard any index state read by other test cases, so this index is read from its files
        ProviderIndexUtil::setBuildMode(True);
        ProviderIndexUtil::setBuildMode(False);

        assertEq(("QoreTestInvoices", "QoreTestOrders"), sort(map $1.name, ProviderIndexUtil::getCachedApps()));
        # an app's actions are loaded from its own metadata when needed
        assertEq(("create-order",), map $1.action, ProviderIndexUtil::tryGetActionMetadataForApp("QoreTestOrders"));
        # a removed app's actions are not brought back when all actions are loaded
        assertTrue(ProviderIndexUtil::removeCachedApp("QoreTestInvoices"));
        assertEq(("create-order",), map $1.action, ProviderIndexUtil::getAllCachedActions());
        assertEq(("QoreTestOrders",), map $1.name, ProviderIndexUtil::getCachedApps());
    }

    appsFromManifestTest() {
        checkModules();

        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        bool had_env = exists ENV{ProviderIndexEnvVar};
        string old_env = had_env ? ENV{ProviderIndexEnvVar} : "";
        on_exit if (had_env) {
            ProviderIndexUtil::setEnvironmentVariable(old_env);
        }
        ProviderIndexUtil::setEnvironmentVariable(dir);

        hash<auto> actions = {
            "QoreTestOrders": {"create-order": {"app": "QoreTestOrders", "action": "create-order"}},
            "QoreTestInvoices": {"send-invoice": {"app": "QoreTestInvoices", "action": "send-invoice"}},
        };
        ProviderIndexUtil::writeDataProviderIndexByApp({
            "factorymap": {},
            "appmap": {},
            "schememap": {},
            "appinfomap": map {$1: {"name": $1, "desc": "the " + $1 + " app"}}, keys actions,
        }, keys actions, *hash<auto> sub (string app) { return actions{app}; }, 0s, {});

        # the chunks hold each app's actions as well as its info, and the canonical file holds everything; when
        # neither can be read, the apps can only have been read from the manifest (the canonical file must exist for
        # the index to be current, so it is made unreadable instead; this does not apply when run as root)
        list<string> chunks = glob(dir + DirSep + "qore-data-index-*.msgpack");
        assertEq(2, chunks.size());
        map unlink($1), chunks;
        string canonical = dir + DirSep + "qore-data-index.yaml";
        chmod(canonical, 0);
        on_exit chmod(canonical, 0644);

        # discard any index state read by other test cases, so this index is read from its files
        ProviderIndexUtil::setBuildMode(True);
        ProviderIndexUtil::setBuildMode(False);

        assertEq(("QoreTestInvoices", "QoreTestOrders"), sort(map $1.name, ProviderIndexUtil::getCachedApps()));
        assertEq("the QoreTestOrders app", ProviderIndexUtil::tryGetAppInfo("QoreTestOrders").desc);
    }

    changedCanonicalTest() {
        checkModules();

        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        bool had_env = exists ENV{ProviderIndexEnvVar};
        string old_env = had_env ? ENV{ProviderIndexEnvVar} : "";
        on_exit if (had_env) {
            ProviderIndexUtil::setEnvironmentVariable(old_env);
        }
        ProviderIndexUtil::setEnvironmentVariable(dir);

        ProviderIndexUtil::writeDataProviderIndex(<DataProviderIndexInfo>{
            "factorymap": {},
            "appmap": {},
            "schememap": {},
            "appinfomap": {"QoreTestOrders": {"name": "QoreTestOrders", "desc": "published"}},
            "actioninfomap": {},
            "top_actioninfomap": {},
        }, 0s, {});

        # the canonical file is changed without changing its size, so only its modification time shows the change
        string canonical = dir + DirSep + "qore-data-index.yaml";
        string data = ReadOnlyFile::readTextFile(canonical);
        assertTrue(data.find("published") >= 0);
        usleep(10ms);
        File f();
        f.open2(canonical, O_WRONLY | O_TRUNC);
        f.write(replace(data, "published", "changed!!"));
        f.close();

        # discard any index state read by other test cases, so this index is read from its files
        ProviderIndexUtil::setBuildMode(True);
        ProviderIndexUtil::setBuildMode(False);

        assertEq("changed!!", ProviderIndexUtil::tryGetAppInfo("QoreTestOrders").desc,
            "the changed canonical index is read");
    }
}
