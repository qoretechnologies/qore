%modern
%requires DataProvider

#! A provider module whose provider source cannot be read while it loads
/** As TypeScriptActionInterface does when its action script cannot be read, the module keeps the error, registers
    no app, and its discovery inventory provider raises the error; its load succeeds.  Required by
    I18nInventoryFailingOwner and used by I18nFailClosed.qtest (qore#7788).
*/
module I18nInventoryFailingHelper {
    version = "1.0";
    desc = "provider module fixture whose provider source fails while it loads";
    author = "Qore Technologies";
    license = "MIT";
    init = sub () {
        hash<ExceptionInfo> failure;
        try {
            throw "FILE-OPEN2-ERROR", "cannot open 'index.js': the action script of the fixture does not exist";
        } catch (hash<ExceptionInfo> ex) {
            failure = ex;
        }
        DataProviderActionCatalog::registerDiscoveryInventoryProvider("i18n-inventory-failing-helper",
            list<hash<DataProviderDiscoveryExpectedIdentityInfo>> sub () {
                throw "FIXTURE-INVENTORY-SOURCE-ERROR", "1 provider source failed before publishing a complete "
                    "inventory", {
                    "failures": ({
                        "source": "index.js",
                        "error": failure.err,
                        "description": failure.desc,
                    },),
                };
            });
    };
}
