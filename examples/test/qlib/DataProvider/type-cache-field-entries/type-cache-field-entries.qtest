#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires ../../../TestInterpreter.qm
%requires ../../../ExecModeHarness.qm

%exec-class TypeCacheFieldEntriesTest

#! Regression test for issue #7674: the field entries of the process-wide type cache are protected
/** The process-wide type cache of the DataProvider module creates entries for the fields of a registered type, and
    for the fields of those fields; sandboxed code cannot change, add to, lock or clear them
    (DATA-PROVIDER-REGISTRATION-DENIED), as it cannot change the cache's other entries, so that what the cache returns
    for those paths stays what trusted code registered.  Trusted code still changes them, and an entry that a tenant
    creates itself is its own.

    TypeCacheFieldEntries.q makes the checks; its output must be the one in TypeCacheFieldEntries.expected in every
    execution mode.
*/
class TypeCacheFieldEntriesTest inherits QUnit::Test {
    private {
        string qore_bin = TestInterpreter::qore_interpreter();
        string fixture = get_script_dir() + "/TypeCacheFieldEntries.q";
        string expected = ReadOnlyFile::readTextFile(get_script_dir() + "/TypeCacheFieldEntries.expected");
    }

    constructor() : QUnit::Test("type cache field entries", "1.0", \ARGV) {
        foreach string mode in (ExecModeHarness::ExecModes) {
            string execution_mode = mode;
            addTestCase("execution mode " + mode, sub () {
                # the checks run in child Programs and in the library modules, which choose their own execution
                assertEq(expected, ExecModeHarness::run(command(execution_mode), ExecModeHarness::NativeCheck::None));
            });
        }
        set_return_value(main());
    }

    private string command(string mode) {
        return sprintf("%s --exec-mode=%s %s", shellQuote(qore_bin), mode, shellQuote(fixture));
    }

    private static string shellQuote(string value) {
        return "'" + replace(value, "'", "'\\''") + "'";
    }
}
