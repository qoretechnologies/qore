%modern
%requires DataProvider

#! An app whose action and option descriptions contain documentation commands copied from API documentation
module PresentationMarkupOwner {
    version = "1.0";
    desc = "provider presentation fixture whose texts contain documentation commands";
    author = "Qore Technologies";
    license = "MIT";
    init = sub () {
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": "QoreTestMarkupProvider",
            "display_name": "Markup Provider",
            "short_desc": "Provider whose texts contain documentation commands",
            "desc": "Provider whose action is described with `@ref` in a code span, which is literal text",
            "presentation_source_locale": "en",
            "groups": (AppGroup::DataTransformation,),
            "logo": "data",
            "logo_mime_type": MimeTypeSvg,
            "logo_file_name": "markup-provider.svg",
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": "QoreTestMarkupProvider",
            "path": "/upload",
            "action": "upload",
            "display_name": "Upload a file",
            "short_desc": "Uploads a file",
            "desc": "Uploads a @ref DataProvider::FileDataType \"FileDataType\" structure",
            "action_code": DPAT_API,
            "output_type": new QoreHashDataType(),
            "options": {
                "name": <DataProviderOptionInfo>{
                    "display_name": "Name",
                    "short_desc": "The name of the file",
                    "type": AbstractDataProviderType::get(StringType),
                    "desc": "The name of the file; see \\c filename",
                },
            },
        });
    };
}
