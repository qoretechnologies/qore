%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires DataProvider
%requires SqlUtil

%exec-class DataTypeValueErrorTest

#! a type with a defect in its code: its check fails with a type error of the language, whatever the value is
class DefectiveDataType inherits QoreDataType {
    constructor() : QoreDataType(IntType) {
    }

    auto acceptsValue(auto value) {
        auto not_a_hash = "text";
        hash<auto> h = not_a_hash;
        return h;
    }
}

#! a type whose schema document no longer exists, as a schema type of the OpenApi3 or Swagger module raises it
class DestroyedDocumentDataType inherits QoreDataType {
    constructor() : QoreDataType(IntType) {
    }

    auto acceptsValue(auto value) {
        throw "SCHEMA-DOCUMENT-DESTROYED", "schema \"x\" can no longer build types or resolve references";
    }
}

#! a type whose check recurses without end
class RecursiveDataType inherits QoreDataType {
    constructor() : QoreDataType(AutoType) {
    }

    auto acceptsValue(auto value) {
        return acceptsValue(value);
    }
}

#! a type from outside the module that refuses a value with the code that the module's own types used to use
class ExternalRefusingDataType inherits QoreDataType {
    constructor() : QoreDataType(AutoType) {
    }

    auto acceptsValue(auto value) {
        if (value.typeCode() != NT_STRING) {
            throw "RUNTIME-TYPE-ERROR", "only strings are accepted";
        }
        return value;
    }
}

#! a provider with options of given types
class OptionProvider inherits AbstractDataProvider {
    private {
        hash<string, hash<DataProviderOptionInfo>> option_desc;
    }

    constructor(hash<string, hash<DataProviderOptionInfo>> option_desc) {
        self.option_desc = option_desc;
    }

    string getName() {
        return "test";
    }

    *string getDesc() {
        return "test";
    }

    hash<DataProviderInfo> getStaticInfoImpl() {
        return <DataProviderInfo>{
            "type": "OptionProvider",
            "supports_read": False,
            "supports_create": True,
            "supports_update": False,
            "supports_upsert": False,
            "supports_delete": False,
            "supports_native_search": False,
            "supports_bulk_read": False,
            "supports_bulk_create": False,
            "supports_bulk_upsert": False,
            "supports_children": False,
            "constructor_options": {},
            "search_options": NOTHING,
            "create_options": option_desc,
            "upsert_options": NOTHING,
            "transaction_management": False,
            "has_record": True,
        };
    }

    *hash<auto> check(*hash<auto> options) {
        return checkOptions("CREATE-OPTION-ERROR", option_desc, options);
    }

    private *hash<string, AbstractDataField> getRecordTypeImpl(*hash<auto> search_options) {
        return {};
    }

    *hash<string, hash<DataProviderOptionInfo>> getCreateOptions() {
        return option_desc;
    }
}

hashdecl ValueErrorTestInfo {
    int count;
}

class DataTypeValueErrorTest inherits QUnit::Test {
    public {
        #! a value that each named type refuses
        const RefusedValues = {
            "bool": "text",
            "softbool": "text",
            "int": "text",
            "float": "text",
            "number": "text",
            "string": 1,
            "date": "text",
            "binary": "text",
            "hash": "text",
            "list": "text",
            "email": "not an email",
            "uuid": "not a uuid",
            "ipv4": "999.0.0.1",
            "file": "not a hash",
            "epoch": {},
            "unixts": {},
            "rgbcolor": "text",
        };
    }

    constructor() : QUnit::Test("DataTypeValueErrorTest", "1.0", \ARGV) {
        addTestCase("named types", \namedTypes());
        addTestCase("declared types", \declaredTypes());
        addTestCase("native check keeps its description and diagnostic", \nativeCheck());
        addTestCase("hash fields", \hashFields());
        addTestCase("missing values", \missingValues());
        addTestCase("defect in a type", \defectInType());
        addTestCase("stack exhaustion in a type", \stackInType());
        addTestCase("language errors keep their code", \languageErrorCodes());
        addTestCase("union types", \unionTypes());
        addTestCase("options", \options());
        addTestCase("column default values", \columnDefaults());
        addTestCase("accepted values are unchanged", \acceptedValues());
        addTestCase("soft date text", \softDateText());
        addTestCase("soft types from the factory convert any text", \softFactoryTypes());
        set_return_value(main());
    }

    #! returns the exception raised by the code, which must raise one
    private hash<ExceptionInfo> getException(code c) {
        try {
            c();
        } catch (hash<ExceptionInfo> ex) {
            return ex;
        }
        throw "TEST-ERROR", "no exception was raised";
    }

    namedTypes() {
        foreach hash<auto> i in (RefusedValues.pairIterator()) {
            AbstractDataProviderType type = AbstractDataProviderTypeMap{i.key}
                ?? AbstractDataProviderType::get(i.key);
            hash<ExceptionInfo> ex = getException(sub () { type.acceptsValue(i.value); });
            assertEq("TYPE-VALUE-ERROR", ex.err, sprintf("%s: %s", i.key, ex.desc));
        }
    }

    declaredTypes() {
        hash<string, list<auto>> cases = {
            "int list element": (new ListDataType(IntType), ("a",)),
            "not a list": (new ListDataType(IntType), 1),
            "soft list element": (new SoftListDataType(IntType), "a"),
            "object class": (new ObjectClassNameDataType("Mutex"), 1),
            "hash declaration": (new HashDeclDataType(new TypedHash("ValueErrorTestInfo")),
                {"count": "text"}),
            "super soft string": (new SuperSoftStringDataType(), new Mutex()),
            # the value type of this hash is narrowed to binary, and the name is missing
            "file content only": (new FileDataType(), {"content": binary("x")}),
            "soft int": (new QoreSoftIntDataType(), "text"),
            "soft float": (new QoreSoftFloatDataType(), "text"),
            "soft number": (new QoreSoftNumberDataType(), "text"),
            "soft bool": (new QoreSoftBoolDataType(), "text"),
            "soft date": (new QoreSoftDateDataType(), "text"),
            "soft date out of range": (new QoreSoftDateDataType(), "2020-13-45"),
            "unix timestamp in ms": (new UnixTimestampMsType(), {}),
        };
        foreach hash<auto> i in (cases.pairIterator()) {
            AbstractDataProviderType type = i.value[0];
            auto value = i.value[1];
            hash<ExceptionInfo> ex = getException(sub () { type.acceptsValue(value); });
            assertEq("TYPE-VALUE-ERROR", ex.err, sprintf("%s: %s", i.key, ex.desc));
        }
    }

    nativeCheck() {
        hash<ExceptionInfo> direct = getException(sub () { IntType.acceptsValue("text"); });
        assertEq("RUNTIME-TYPE-ERROR", direct.err, "the language raises its own error for the check");

        hash<ExceptionInfo> ex = getException(sub () { AbstractDataProviderTypeMap."int".acceptsValue("text"); });
        assertEq("TYPE-VALUE-ERROR", ex.err);
        assertEq(direct.desc, ex.desc, "the description is the one of the check");
        assertEq(direct.arg, ex.arg, "the structured diagnostic of the check is kept");
    }

    hashFields() {
        HashDataType type();
        type.addField(new QoreDataField("a", "a", AbstractDataProviderTypeMap."int"));
        assertEq({"a": 1}, type.acceptsValue({"a": 1}));

        hash<ExceptionInfo> ex = getException(sub () { type.acceptsValue({"a": "text"}); });
        assertEq("TYPE-VALUE-ERROR", ex.err, "wrong value of a field");
        assertRegex("field \"a\"", ex.desc);

        ex = getException(sub () { type.acceptsValue({"a": 1, "b": 1}); });
        assertEq("TYPE-VALUE-ERROR", ex.err, "unknown field");

        ex = getException(sub () { type.acceptsValue("text"); });
        assertEq("TYPE-VALUE-ERROR", ex.err, "not a hash");

        HashDataType other();
        other.setDefaultOtherFieldType(AbstractDataProviderTypeMap."int");
        ex = getException(sub () { other.acceptsValue({"x": "text"}); });
        assertEq("TYPE-VALUE-ERROR", ex.err, "wrong value of an undeclared field");

        # a field with choices refuses a value with its own code; the hash reports the value as refused
        HashDataType choices();
        choices.addField(new QoreDataField({
            "name": "c",
            "type": AbstractDataProviderTypeMap."string",
            "allowed_values": ("x", "y"),
        }));
        ex = getException(sub () { choices.acceptsValue({"c": "z"}); });
        assertEq("TYPE-VALUE-ERROR", ex.err, "value outside of the allowed values");
        assertRegex("FIELD-VALUE-ERROR", ex.desc);
    }

    missingValues() {
        HashDataType type();
        type.addField(new QoreDataField("a", "a", AbstractDataProviderTypeMap."int"));
        assertThrows("MISSING-VALUE-ERROR", \type.acceptsValue(), {});
        assertThrows("MISSING-VALUE-ERROR", \type.acceptsValue());
    }

    defectInType() {
        DefectiveDataType defective();
        assertEq("RUNTIME-TYPE-ERROR", getException(sub () { defective.acceptsValue(1); }).err, "type");

        ListDataType list_type(defective);
        assertEq("RUNTIME-TYPE-ERROR", getException(sub () { list_type.acceptsValue((1,)); }).err, "list element");

        HashDataType hash_type();
        hash_type.addField(new QoreDataField("a", "a", defective));
        hash<ExceptionInfo> ex = getException(sub () { hash_type.acceptsValue({"a": 1}); });
        assertEq("RUNTIME-TYPE-ERROR", ex.err, "field");
        assertRegex("field \"a\"", ex.desc, "field description");

        HashDataType other();
        other.setDefaultOtherFieldType(defective);
        assertEq("RUNTIME-TYPE-ERROR", getException(sub () { other.acceptsValue({"a": 1}); }).err, "undeclared field");

    }

    stackInType() {
        HashDataType hash_type();
        hash_type.addField(new QoreDataField("a", "a", new RecursiveDataType()));
        assertEq("STACK-LIMIT-EXCEEDED", getException(sub () { hash_type.acceptsValue({"a": 1}); }).err);
    }

    languageErrorCodes() {
        foreach string err in (("RUNTIME-TYPE-ERROR", "RUNTIME-OVERLOAD-ERROR", "STACK-LIMIT-EXCEEDED",
                "SCHEMA-DOCUMENT-DESTROYED")) {
            assertEq(err, AbstractDataProviderType::getValueErrorCode(err));
        }
        # a field whose schema can no longer check the value reports that, not a refused value
        HashDataType h();
        h.addField(new QoreDataField("a", NOTHING, new DestroyedDocumentDataType()));
        hash<ExceptionInfo> ex = getException(sub () { h.acceptsValue({"a": 1}); });
        assertEq("SCHEMA-DOCUMENT-DESTROYED", ex.err);
        foreach string err in (("TYPE-VALUE-ERROR", "FIELD-VALUE-ERROR", "MISSING-VALUE-ERROR", "OTHER-ERROR")) {
            assertEq("TYPE-VALUE-ERROR", AbstractDataProviderType::getValueErrorCode(err));
        }
    }

    unionTypes() {
        QoreUnionDataType type((AbstractDataProviderTypeMap."int", AbstractDataProviderTypeMap."date"));
        assertEq(1, type.acceptsValue(1));
        assertEq("TYPE-VALUE-ERROR", getException(sub () { type.acceptsValue({}); }).err);

        # an alternative from outside the module can still refuse a value for another alternative to accept it
        QoreUnionDataType external((new ExternalRefusingDataType(), AbstractDataProviderTypeMap."int"));
        assertEq(1, external.acceptsValue(1));
        assertEq("a", external.acceptsValue("a"));
        assertEq("TYPE-VALUE-ERROR", getException(sub () { external.acceptsValue({}); }).err);
    }

    options() {
        hash<string, hash<DataProviderOptionInfo>> desc = {
            "opt": <DataProviderOptionInfo>{
                "type": (AbstractDataProviderTypeMap."int", new ExternalRefusingDataType()),
                "desc": "an option",
            },
            "single": <DataProviderOptionInfo>{
                "type": (AbstractDataProviderTypeMap."int",),
                "desc": "an option",
            },
        };
        OptionProvider dp(desc);
        # the second alternative accepts what the first refuses, and refuses with the former code itself
        assertEq("a", dp.check({"opt": "a"}).opt);
        assertEq(1, dp.check({"single": 1}).single);

        hash<ExceptionInfo> ex = getException(sub () { dp.check({"single": "50%s"}); });
        assertEq("OPTION-VALUE-ERROR", ex.err);
        assertRegex("option \"single\" of type \"int\"", ex.desc);
        assertRegex("50%s", ex.desc, "a value in the description is not taken as a format");
        assertEq("OPTION-VALUE-ERROR", getException(sub () { dp.check({"opt": {}}); }).err);
    }

    columnDefaults() {
        # a default value that the type refuses is an expression that is executed by the server
        SqlUtilColumnField field("a", "a", AbstractDataProviderTypeMap."int", "now()");
        assertEq("a", field.getName());

        # a failure of the check itself is not such a default value
        assertThrows("RUNTIME-TYPE-ERROR", sub () {
            SqlUtilColumnField f("a", "a", new DefectiveDataType(), 1);
            remove f;
        });
    }

    #! documents a known difference between the two ways to get a soft type, which is not a decision to keep it
    /** AbstractDataProviderType::get() has validating branches only for strings and booleans, so the other soft types
        that it returns are plain QoreDataType objects with the conversion of the language, where text that is not a
        number or a date is a zero value.  QoreSoftIntDataType and the other classes refuse that text.  Using the classes
        in the factory changes the type digests and catalogs of the data provider modules and refuses values that
        working APIs give, so it needs a decision of its own; this test fails when that changes, as a reminder to update
        it and the code that relies on it.
    */
    softFactoryTypes() {
        assertEq(0, AbstractDataProviderTypeMap."softint".acceptsValue("text"));
        assertEq(0.0, AbstractDataProviderTypeMap."softfloat".acceptsValue("text"));
        assertEq(0n, AbstractDataProviderTypeMap."softnumber".acceptsValue("text"));
        assertEq(localtime(0), AbstractDataProviderTypeMap."softdate".acceptsValue("text"));
        assertEq("QoreDataType", AbstractDataProviderTypeMap."softint".className());

        foreach AbstractDataProviderType t in ((new QoreSoftIntDataType(), new QoreSoftFloatDataType(),
                new QoreSoftNumberDataType(), new QoreSoftDateDataType())) {
            assertEq("TYPE-VALUE-ERROR", getException(sub () { t.acceptsValue("text"); }).err, t.className());
        }
    }

    softDateText() {
        QoreSoftDateDataType type();
        assertEq(2020-01-02, type.acceptsValue("2020-01-02"));

        # the description names the value and the type and keeps the reason of the date parser
        hash<ExceptionInfo> parser = getException(sub () { date d = date("2020-13-45"); remove d; });
        assertEq("INVALID-DATE", parser.err);
        hash<ExceptionInfo> ex = getException(sub () { type.acceptsValue("2020-13-45"); });
        assertEq("TYPE-VALUE-ERROR", ex.err);
        assertRegex("\"2020-13-45\"", ex.desc);
        assertRegex("softdate", ex.desc);
        assertTrue(index(ex.desc, parser.desc) >= 0, ex.desc);

        # a field of a hash type reports the refused text as a refused value
        HashDataType h();
        h.addField(new QoreDataField("when", NOTHING, type));
        assertEq("TYPE-VALUE-ERROR", getException(sub () { h.acceptsValue({"when": "text"}); }).err);
    }

    acceptedValues() {
        assertEq(1, AbstractDataProviderTypeMap."softint".acceptsValue("1"));
        assertEq("1", AbstractDataProviderTypeMap."softstring".acceptsValue(1));
        assertEq((1, 2), new ListDataType(IntType).acceptsValue((1, 2)));
        assertEq(NOTHING, AbstractDataProviderTypeMap."*int".acceptsValue(NOTHING));
    }
}
