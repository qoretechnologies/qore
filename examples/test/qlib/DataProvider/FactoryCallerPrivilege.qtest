#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%prepend-module-path "${SCRIPT_DIR}/../../qore/misc/reflection-operation-access"
%prepend-module-path "${SCRIPT_DIR}/FactoryCallerPrivilege"
%requires QUnit
%requires FsUtil
%requires DataProvider
%requires reflection
%requires ReflectionAccessProbe
%requires ReflectionFactoryProvider
%exec-class FactoryCallerPrivilegeTest

class FactoryCallerPrivilegeTest inherits QUnit::Test {
    private {
        const BaseOptions = PO_NEW_STYLE | PO_REQUIRE_TYPES | PO_STRICT_ARGS;
        const Operations = ("newObject", "newObjectArgs", "callConstructor", "method", "methodArgs",
            "variant", "variantArgs");
    }
    constructor() : Test("FactoryCallerPrivilegeTest", "1.0") {
        addTestCase("factories construct public classes exported by another module", \factories());
        addTestCase("all constructor entry points use the exact imported class", \constructors());
        addTestCase("public class method variants retain their class identity", \methods());
        addTestCase("an intervening application cannot borrow an outer import", \intervening());
        addTestCase("a same-named class is not the imported class", \sameName());
        addTestCase("restricting domains remain enforced", \restrictions());
        addTestCase("a sandboxed importer constructs the class under its own sandbox", \sandboxedImporter());
        addTestCase("another Program's own sandbox manager is enforced", \sandboxIdentity());
        addTestCase("class import does not authorize private classes, builtins, or globals", \otherSymbols());
        addTestCase("an imported class does not authorize its unrelated reflection Program", \foreignProgram());
        set_return_value(main());
    }

    factories() {
        ReflectionFactoryProvider::Provider direct({"name": "direct"});
        assertEq("direct", direct.getName());
        ReflectionFactoryProvider::Factory factory();
        assertEq("factory", factory.create({"name": "factory"}).getName());
        assertEq("template-factory", factory.createWithTemplate({"prefix": "template-"},
            {"name": "factory"}).getName());
        ReflectionFactoryProvider::Factory fallback(True);
        assertEq("fallback", fallback.createWithTemplate({"prefix": "unused-"},
            {"name": "fallback"}).getName());
    }

    constructors() {
        ReflectionFactoryProvider::Factory factory(True);
        foreach string operation in (Operations) {
            object obj = ReflectionAccessProbe::construct(factory.getClass(), operation, ({"name": operation},));
            assertEq(operation, obj.getName(), operation);
        }
    }

    methods() {
        ReflectionFactoryProvider::Factory factory(True);
        assertEq("pong", ReflectionAccessProbe::callStatic(factory.getClass().getStaticVariant("ping")));
    }

    private Program reader(bool import_class, int options = 0, *SandboxManager sm, string extra = "") {
        Program pgm(BaseOptions | options, True);
        pgm.parse("%modern\n%requires reflection\n%requires ReflectionAccessProbe\n"
            + (import_class ? "%requires ReflectionFactoryProvider\n" : "") + extra
            + "auto sub construct(Class cls, string operation, auto arg) {\n"
            + "    return ReflectionAccessProbe::construct(cls, operation, (arg,));\n}\n",
            "reflection-factory-reader");
        if (sm) { pgm.setSandboxManager(sm); }
        return pgm;
    }

    intervening() {
        ReflectionFactoryProvider::Factory factory(True);
        Program pgm = reader(False);
        foreach string operation in (Operations) {
            assertThrows("REFLECTION-ACCESS-ERROR", NOTHING, \pgm.callFunction(),
                ("construct", factory.getClass(), operation, {}));
        }
        # The same application is allowed once it has imported the exact public class.
        Program imported = reader(True);
        object obj = imported.callFunction("construct", factory.getClass(), "variant", {"name": "imported"});
        assertEq("imported", obj.getName());
    }

    sameName() {
        ReflectionFactoryProvider::Factory factory(True);
        Program pgm = reader(False, 0, NOTHING,
            "namespace ReflectionFactoryProvider { class FallbackProvider { constructor(*hash<auto> options) {} } }\n");
        assertThrows("REFLECTION-ACCESS-ERROR", NOTHING, \pgm.callFunction(),
            ("construct", factory.getClass(), "newObject", {}));
    }

    restrictions() {
        ReflectionFactoryProvider::Factory factory(True);
        Program pgm = reader(True, PO_NO_NETWORK);
        assertThrows("REFLECTION-ACCESS-ERROR", NOTHING, \pgm.callFunction(),
            ("construct", factory.getClass(), "variant", {}));
    }

    #! A user module Program has no sandbox manager of its own, so the provider module's code runs under the sandbox of
    #! the application that calls the factory, as when the application constructs the class directly.
    sandboxedImporter() {
        ReflectionFactoryProvider::Factory factory(True);
        TmpFile file("factory-caller-privilege-");
        file.file.write("file data");
        file.file.close();

        # a listener on the loopback interface, which a sandbox that blocks private networks must not reach
        Socket listener();
        listener.bind("127.0.0.1:0");
        listener.listen();
        on_exit listener.close();
        int port = listener.getSocketInfo().port;

        SandboxManager allowed();
        allowed.setFilesystemDefaultPolicy(True);
        allowed.setNetworkDefaultPolicy(True);
        SandboxManager denied();
        denied.setFilesystemDefaultPolicy(False);
        denied.setNetworkDefaultPolicy(True);
        denied.blockPrivateNetworks();

        Class io_class = ReflectionFactoryProvider::Factory::ioClass();
        Program allowed_pgm = reader(True, 0, allowed);
        Program denied_pgm = reader(True, 0, denied);
        foreach string operation in (Operations) {
            object obj = allowed_pgm.callFunction("construct", factory.getClass(), operation, {"name": operation});
            assertEq(operation, obj.getName(), operation);
            assertEq("none", denied_pgm.callFunction("construct", io_class, operation, {}).getName(), operation);

            assertEq("file data", allowed_pgm.callFunction("construct", io_class, operation,
                {"path": file.path}).getName(), operation);
            assertThrows("FILESYSTEM-ACCESS-DENIED", NOTHING, \denied_pgm.callFunction(),
                ("construct", io_class, operation, {"path": file.path}), operation);

            assertEq("connected", allowed_pgm.callFunction("construct", io_class, operation,
                {"port": port}).getName(), operation);
            assertThrows("NETWORK-ACCESS-DENIED", NOTHING, \denied_pgm.callFunction(),
                ("construct", io_class, operation, {"port": port}), operation);
        }
    }

    #! A Program with a sandbox manager of its own can be reached only by code governed by that manager; an
    #! application Program without one is not governed by the caller's sandbox.
    sandboxIdentity() {
        string source = "%modern\npublic class Local { constructor(*hash<auto> options) {} string getName() { "
            "return \"local\"; } }\n";
        SandboxManager target_sm();
        Program managed(BaseOptions, True);
        managed.parse(source, "reflection-factory-managed");
        managed.setSandboxManager(target_sm);
        Program unmanaged(BaseOptions, True);
        unmanaged.parse(source, "reflection-factory-unmanaged");

        Program other = reader(False, 0, new SandboxManager());
        foreach Program target in (managed, unmanaged) {
            assertThrows("REFLECTION-ACCESS-ERROR", NOTHING, \other.callFunction(),
                ("construct", Class::forName(target, "Local"), "newObject", {}));
        }
        Program same = reader(False, 0, target_sm);
        assertEq("local", same.callFunction("construct", Class::forName(managed, "Local"), "newObject",
            {}).getName());
    }

    otherSymbols() {
        foreach string operation in (Operations) {
            assertThrows("REFLECTION-ACCESS-ERROR", NOTHING, \ReflectionAccessProbe::construct(),
                (ReflectionFactoryProvider::Factory::privateClass(), operation, ({},)));
            assertThrows("REFLECTION-ACCESS-ERROR", NOTHING, \ReflectionAccessProbe::construct(),
                (ReflectionFactoryProvider::Factory::builtinClass(), operation, (PO_ALLOW_DEBUGGER,)));
        }
        assertThrows("REFLECTION-ACCESS-ERROR", NOTHING, \ReflectionAccessProbe::read(),
            (ReflectionFactoryProvider::Factory::secretVar(),));
    }

    foreignProgram() {
        # Even an exact imported class must not confer authority over a sibling application's context.
        Program target(BaseOptions | PO_ALLOW_DEBUGGER, True);
        target.parse("%modern\n%requires ReflectionFactoryProvider\n", "reflection-factory-foreign");
        Class cls = Class::forName(target, "ReflectionFactoryProvider::FallbackProvider");
        Program pgm = reader(True);
        assertThrows("REFLECTION-ACCESS-ERROR", NOTHING, \pgm.callFunction(),
            ("construct", cls, "variant", {}));
    }
}
