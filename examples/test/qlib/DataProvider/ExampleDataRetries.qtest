%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires DataProvider
%requires RestClientIo
%requires HttpServer
%requires Logger
%requires json

%exec-class ExampleDataRetriesTest

#! A local server that counts requests and answers each of them with 503 Service Unavailable
class UnavailableHandler inherits AbstractHttpRequestHandler {
    public {
        #! the number of requests received
        int requests = 0;
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        ++requests;
        return <HttpResponseInfo>{
            "code": 503,
            "hdr": {"Content-Type": MimeTypeJson},
            "body": make_json({"error": "unavailable"}),
        };
    }
}

#! A provider whose example data is requested from a server, retrying failed requests as a data provider does
/** Without a client, it records whether retries were suppressed when its example data was built
*/
class ExampleRequestProvider inherits AbstractDataProvider {
    public {
        #! the number of retries after a failed request
        const MaxRetries = 2;

        #! retriesSuppressed() when each example was built, in order
        list<bool> suppressed = ();
    }

    private {
        #! the client for the server, if any
        *RestClientIo rest;

        const ProviderInfo = <DataProviderInfo>{
            "type": "ExampleRequestProvider",
            "supports_read": True,
            "supports_observable": True,
        };

        const EventType = <DataProviderMessageInfo>{
            "desc": "a record was created",
            "type": AbstractDataProviderType::get(AutoHashType),
        };
    }

    constructor(*RestClientIo rest) {
        self.rest = rest;
    }

    string getName() {
        return "example-request";
    }

    #! Requests a record, retrying a failed request unless retries are suppressed
    hash<auto> getRecord() {
        int retries = 0;
        while (True) {
            try {
                return rest.restGet("/record").body;
            } catch (hash<ExceptionInfo> ex) {
                if (retries < MaxRetries && !DataProviderRetryUtil::retriesSuppressed()) {
                    ++retries;
                    continue;
                }
                rethrow;
            }
        }
    }

    private hash<DataProviderInfo> getStaticInfoImpl() {
        return ProviderInfo;
    }

    private hash<string, hash<DataProviderMessageInfo>> getEventTypesImpl() {
        return {"created": EventType};
    }

    private *hash<string, AbstractDataField> getRecordTypeImpl(*hash<auto> search_options) {
        return {
            "id": new QoreDataField("id", "the id", IntType),
        };
    }

    #! Returns a record from the server, or fake data if the request fails
    private auto getExampleEventDataImpl(string event_id) {
        return getExample();
    }

    #! Returns a record from the server, or fake data if the request fails
    private hash<auto> getExampleRecordDataImpl() {
        return getExample();
    }

    #! Returns a record from the server, or fake data if the request fails
    private hash<auto> getExample() {
        suppressed += DataProviderRetryUtil::retriesSuppressed();
        if (rest) {
            try {
                return getRecord();
            } catch (hash<ExceptionInfo> ex) {
                # fall through to the fake data
            }
        }
        return {"id": -1};
    }
}

public class ExampleDataRetriesTest inherits QUnit::Test {
    constructor() : Test("ExampleDataRetries", "1.0", \ARGV) {
        addTestCase("example data is built without retries", \exampleDataSuppressed());
        addTestCase("example data is requested once", \exampleDataRequestedOnce());
        set_return_value(main());
    }

    #! The public example data methods suppress retries while the data provider builds the example data
    exampleDataSuppressed() {
        ExampleRequestProvider prov();
        assertEq({"id": -1}, prov.getExampleEventData("created"));
        assertEq({"id": -1}, prov.getExampleEventDataWithOptions("created", {}));
        assertEq({"id": -1}, prov.getExampleRecordData());
        assertEq({"id": -1}, prov.getExampleRecordDataWithOptions({}));
        assertEq((True, True, True, True), prov.suppressed);
        # retries are suppressed only while the example data is built
        assertFalse(DataProviderRetryUtil::retriesSuppressed());
    }

    #! A server that fails is asked once for example data, and as often as the provider retries otherwise
    exampleDataRequestedOnce() {
        HttpServer server(<HttpServerOptionInfo>{
            "logger": new Logger("server", LoggerLevel::getLevelError()),
        });
        on_exit server.stop();
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        UnavailableHandler handler();
        server.setHandler("unavailable", "", NOTHING, handler);
        server.setDefaultHandler("unavailable", handler);

        ExampleRequestProvider prov(new RestClientIo({"url": "http://127.0.0.1:" + port, "data": "json"}));
        hash<string, code> examples = {
            "event": auto sub () { return prov.getExampleEventData("created"); },
            "event with options": auto sub () { return prov.getExampleEventDataWithOptions("created", {}); },
            "record": auto sub () { return prov.getExampleRecordData(); },
            "record with options": auto sub () { return prov.getExampleRecordDataWithOptions({}); },
        };
        foreach hash<auto> i in (examples.pairIterator()) {
            handler.requests = 0;
            # the fake data is returned after one request
            assertEq({"id": -1}, i.value(), i.key);
            assertEq(1, handler.requests, i.key);
        }

        # a request made otherwise is retried
        handler.requests = 0;
        assertThrows("REST-RESPONSE-ERROR", \prov.getRecord());
        assertEq(ExampleRequestProvider::MaxRetries + 1, handler.requests);
    }
}
