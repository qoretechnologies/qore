#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires DataProvider

%exec-class DataProviderTypeGraphTest

#! A type whose element type can be set after construction, so that cyclic element-type graphs can be built
class SettableElementType inherits AbstractDataProviderType {
    private {
        *AbstractDataProviderType elem;
        string myname;
    }

    constructor(string n) : AbstractDataProviderType() {
        myname = n;
    }

    setElementType(AbstractDataProviderType e) {
        elem = e;
    }

    string getName() {
        return myname;
    }

    *AbstractDataProviderType getElementType() {
        return elem;
    }

    *hash<string, AbstractDataField> getFields() {
    }

    hash<string, bool> getAcceptTypeHash(*bool simple) {
        return {"hash": True};
    }

    hash<string, bool> getReturnTypeHash(*bool simple) {
        return {"hash": True};
    }

    auto acceptsValue(auto value) {
        return value;
    }

    string getBaseTypeName() {
        return "hash";
    }

    hash<string, bool> getDirectTypeHash() {
        return {"hash": True};
    }

    AbstractDataProviderType getSoftType() {
        return self;
    }

    AbstractDataProviderType getOrNothingType() {
        return self;
    }

    *Type getValueType() {
    }
}

#! A hash type whose fields and element type must not be visited
class UntraversableHashType inherits HashDataType {
    constructor() : HashDataType("untraversable", NOTHING, {"x": 1}, {"a": 1}) {
        addField(new QoreDataField("str", "a string field", StringType));
    }

    *hash<string, hash<DataFieldInfo>> getFieldInfo() {
        throw "TYPE-TRAVERSED", "the fields of the type were described";
    }

    *AbstractDataProviderType getElementType() {
        throw "TYPE-TRAVERSED", "the element type of the type was described";
    }
}

#! Tests that type-graph traversals are bounded in time and memory
/** Type graphs are traversed as live objects, so they are not necessarily trees:
    - a type object reachable from more than one parent (a shared subtype in a DAG) must be expanded once, not
      once per path, otherwise the traversal is exponential in the depth of the graph
    - a cyclic element-type graph must terminate
*/
public class DataProviderTypeGraphTest inherits QUnit::Test {
    public {
        #! Fan-out per level in the shared-subtype DAG
        const Fanout = 3;

        #! Depth of the shared-subtype DAG
        /** Every level references the same child type object @ref Fanout times, so a traversal that re-expands
            shared subtypes performs Fanout ** Depth (3 ** 14 = 4,782,969) leaf expansions, which neither
            terminates in reasonable time nor fits in memory; a traversal that expands each distinct type object
            once performs Depth + 1 (15) of them
        */
        const Depth = 14;

        #! Upper bound on the traversal; the unbounded implementation needs many minutes and many GB at this depth
        const MaxTraversalTime = 30s;

        #! Depth of the cyclic graph whose description is measured
        const CyclicDepth = 6;
    }

    constructor() : Test("DataProviderTypeGraphTest", "1.0") {
        addTestCase("shared subtypes are not re-expanded per path", \sharedSubtypeDagTest());
        addTestCase("shared subtype info is identical at every occurrence", \sharedSubtypeInfoTest());
        addTestCase("cyclic element types terminate", \cyclicElementTypeTest());
        addTestCase("cyclic field types terminate", \cyclicFieldTypeTest());
        addTestCase("a field's configuration describes its type as getInfo() does", \configInfoTest());
        addTestCase("a field's configuration does not describe the type graph", \configInfoUntraversedTest());
        addTestCase("a field's configuration on a large cyclic graph is bounded", \configInfoCyclicGraphTest());
        addTestCase("a cyclic type graph is described with each type once", \graphInfoSizeTest());
        addTestCase("a type graph description refers to each type by its key", \graphInfoReferenceTest());
        addTestCase("a type graph builder describes several types with one type table", \graphBuilderTest());
        addTestCase("a type graph is restored with its cycles", \graphRestoreTest());
        addTestCase("a description is restored with one type per unique key", \infoRestoreSharedTest());
        addTestCase("recursive types are compared without recursing forever", \recursiveAssignableTest());

        set_return_value(main());
    }

    #! Builds an acyclic type DAG where every level shares the same child type object Fanout times
    private AbstractDataProviderType getSharedSubtypeDag(int depth) {
        HashDataType leaf();
        leaf.addField(new QoreDataField("str", "a string field", StringType));
        leaf.addField(new QoreDataField("num", "an int field", IntType));

        AbstractDataProviderType rv = leaf;
        for (int i = 0; i < depth; ++i) {
            HashDataType t();
            # all three fields reference the *same* child type object
            foreach string fname in ("a", "b", "c") {
                t.addField(new QoreDataField(fname, "shared subtype", rv));
            }
            rv = t;
        }
        return rv;
    }

    #! Builds a graph of @a depth levels that share their child type object three times, closed to a cycle
    /** The leaf has a field that refers back to the top of the graph, so every type is on the cycle

        @param depth the number of levels above the leaf
        @param types the type objects of the graph, by their unique hash

        @return the top of the graph
    */
    private AbstractDataProviderType getCyclicSharedGraph(int depth,
            reference<hash<string, AbstractDataProviderType>> types) {
        HashDataType root("level0");
        types{root.uniqueHash()} = root;
        AbstractDataProviderType rv = root;
        for (int i = 0; i < depth; ++i) {
            HashDataType t("level" + (i + 1));
            foreach string fname in ("a", "b", "c") {
                t.addField(new QoreDataField(fname, "shared subtype", rv));
            }
            types{t.uniqueHash()} = t;
            rv = t;
        }
        # close the cycle: the leaf refers back to the top of the graph
        root.addField(new QoreDataField("top", "cycle to the top", rv));
        return rv;
    }

    #! Returns the number of type descriptions in a description: the description and those nested in it
    private static int countTypeDescriptions(hash<auto> info) {
        int rv = 1;
        foreach hash<auto> field in (info.fields.iterator()) {
            rv += countTypeDescriptions(field.type);
        }
        if (info.element_type) {
            rv += countTypeDescriptions(info.element_type);
        }
        foreach hash<auto> union_type in (info.union_types) {
            rv += countTypeDescriptions(union_type);
        }
        return rv;
    }

    #! Adds the type objects reachable from a type, by identity
    private static getTypeObjects(AbstractDataProviderType t, reference<hash<string, AbstractDataProviderType>> rv) {
        if (rv{t.uniqueHash()}) {
            return;
        }
        rv{t.uniqueHash()} = t;
        foreach AbstractDataField field in (t.getFields().iterator()) {
            getTypeObjects(field.getType(), \rv);
        }
        if (*AbstractDataProviderType et = t.getElementType()) {
            getTypeObjects(et, \rv);
        }
    }

    #! A cyclic type graph is described with each type once, so the description grows with the graph
    /** getInfo() describes a type on a cycle again at every path to it and cannot share the descriptions, because
        each one is truncated at a different place: it has more than 3 ** depth descriptions of the leaf, and the
        types of a large REST schema, whose records refer to each other, have millions
    */
    graphInfoSizeTest() {
        hash<string, AbstractDataProviderType> small_types;
        AbstractDataProviderType small = getCyclicSharedGraph(3, \small_types);
        assertGt(pow(3, 3).toInt(), countTypeDescriptions(small.getInfo()), "getInfo() describes each path");

        hash<string, AbstractDataProviderType> types;
        AbstractDataProviderType top = getCyclicSharedGraph(CyclicDepth, \types);
        hash<DataTypeGraphInfo> graph = top.getInfoGraph();
        assertEq(types.size(), graph.types.size(), "every type of the graph is described once");
        # each type once, with one nested description (a reference, or the element type of a hash type) for each
        # field and element type
        int nested = foldl $1 + $2, (map countTypeDescriptions($1) - 1, graph.types.iterator());
        int edges = 3 * CyclicDepth + 1;
        assertEq(edges + types.size(), nested, "one nested description per field and element type");
    }

    #! References are by key, keys follow the order of first reference, and every reference resolves
    graphInfoReferenceTest() {
        hash<string, AbstractDataProviderType> types;
        AbstractDataProviderType top = getCyclicSharedGraph(4, \types);
        hash<DataTypeGraphInfo> graph = top.getInfoGraph();

        # the type itself is the first key; its description is a reference to it
        assertEq("1", graph.type.type_ref, "the description of a type with fields is a reference");
        assertEq("level4", graph.type.name, "a reference names the type");
        assertEq(("1", "2", "3", "4", "5"), keys graph.types, "keys follow the order of first reference");
        assertEq("level4", graph.types."1".name);
        assertEq("level3", graph.types."2".name);
        assertNothing(graph.types."1".type_ref, "a type of the table is not a reference");
        # all three fields of a level refer to the same type, by the same key
        assertEq("2", graph.types."1".fields.a.type.type_ref);
        assertEq("2", graph.types."1".fields.b.type.type_ref);
        assertEq("2", graph.types."1".fields.c.type.type_ref);
        # the leaf refers back to the top
        assertEq("1", graph.types."5".fields.top.type.type_ref);
        foreach hash<auto> entry in (graph.types.iterator()) {
            foreach hash<auto> field in (entry.fields.iterator()) {
                assertTrue(exists graph.types{field.type.type_ref}, "every reference resolves");
                assertFalse(field.type.recursive, "a reference is not a recursion marker");
                assertEq("", field.unique_key, "a field of a type graph description has no unique key");
            }
        }
        # the same graph is always described the same way
        assertEq(graph, top.getInfoGraph(), "the description does not depend on the process state");
        # getInfo() is unchanged: it describes the fields in place
        assertTrue(exists top.getInfo().fields.a.type.fields, "getInfo() describes the fields in place");
        assertNothing(top.getInfo().fields.a.type.type_ref);
    }

    #! A builder describes several types with one type table; a type already described is not described again
    graphBuilderTest() {
        hash<string, AbstractDataProviderType> types;
        AbstractDataProviderType top = getCyclicSharedGraph(3, \types);
        AbstractDataProviderType middle = top.getFields().a.getType();
        DataTypeGraphBuilder builder();
        hash<DataTypeInfo> top_info = builder.add(top);
        int size = builder.getTypes().size();
        hash<DataTypeInfo> middle_info = builder.add(middle);
        assertEq(size, builder.getTypes().size(), "the second type is already in the table");
        assertEq("2", middle_info.type_ref);
        # a scalar type is described in place
        hash<DataTypeInfo> scalar = builder.add(AbstractDataProviderTypeMap."string");
        assertNothing(scalar.type_ref);
        assertEq("string", scalar.name);
        # each type restored from the builder's type table
        AbstractDataProviderType restored_top = AbstractDataProviderType::getFromGraph(builder.getGraph(top_info));
        AbstractDataProviderType leaf = restored_top;
        while (leaf.getFields().a) {
            leaf = leaf.getFields().a.getType();
        }
        assertEq(restored_top, leaf.getFields().top.getType(), "the cycle is restored");
        AbstractDataProviderType restored = AbstractDataProviderType::getFromGraph(builder.getGraph(middle_info));
        assertEq("level2", restored.getName());
    }

    #! A type graph is restored with its cycles: a reference to a type is the restored type itself
    graphRestoreTest() {
        HashDataType node("node");
        node.addField(new QoreDataField("name", "the name", StringType));
        node.addField(new QoreDataField("children", "the children", new ListDataType("list<node>", node)));
        node.addField(new QoreDataField("self", "the node", node));

        AbstractDataProviderType restored = AbstractDataProviderType::getFromGraph(node.getInfoGraph());
        assertEq(restored, restored.getFields().self.getType(), "a recursive field is the restored type");
        assertEq(restored, restored.getFields().children.getType().getElementType(), "and so is an element type");
        assertEq(node.getInfoGraph(), restored.getInfoGraph(), "the restored graph has the same description");

        # a reference outside a type graph description cannot be restored
        hash<DataTypeInfo> ref = node.getInfoGraph().type;
        assertThrows("TYPE-ARG-ERROR", \AbstractDataProviderType::get(), ref);
    }

    #! get() restores each type of a description once, by its unique key, and a recursion marker as the cycle
    /** getInfo() describes a type on a cycle once per path to it; restoring each occurrence separately creates one
        type object per path (about 3 ** depth here, millions for the largest REST schemas), and a recursion marker
        becomes a type without fields
    */
    infoRestoreSharedTest() {
        hash<string, AbstractDataProviderType> types;
        AbstractDataProviderType top = getCyclicSharedGraph(4, \types);
        AbstractDataProviderType restored = AbstractDataProviderType::get(top.getInfo());
        hash<string, AbstractDataProviderType> restored_types;
        getTypeObjects(restored, \restored_types);
        int hash_types = elements (map 1, restored_types.iterator(), $1.getFields());
        assertEq(types.size(), hash_types, "one restored hash type per type of the graph");
        # the leaf's field refers back to the top: the restored top itself
        AbstractDataProviderType leaf = restored;
        while (leaf.getFields().a) {
            leaf = leaf.getFields().a.getType();
        }
        assertEq(restored, leaf.getFields().top.getType(), "the recursion marker is the restored type");
        assertEq(restored.getFields().a.getType(), restored.getFields().b.getType(), "shared types stay shared");
    }

    #! Two recursive types, such as a type and the type restored from its description, can be compared
    /** A comparison of the fields of two recursive types compares the same pair of types again below them; without
        recognizing the pair, it recursed until the stack was exhausted
    */
    recursiveAssignableTest() {
        hash<string, AbstractDataProviderType> types;
        AbstractDataProviderType top = getCyclicSharedGraph(3, \types);
        AbstractDataProviderType restored = AbstractDataProviderType::get(top.getInfo());
        assertTrue(top.isAssignableFrom(restored), "a type is assignable from the type restored from it");
        assertTrue(restored.isAssignableFrom(top));
        hash<string, AbstractDataProviderType> other_types;
        assertTrue(top.isAssignableFrom(getCyclicSharedGraph(3, \other_types)), "two equal recursive types");
        # a field that the other type lacks still makes it unassignable
        HashDataType node("node");
        node.addField(new QoreDataField("self", "the node", node));
        node.addField(new QoreDataField("required", "a required field", StringType));
        HashDataType other("node");
        other.addField(new QoreDataField("self", "the node", other));
        assertFalse(node.isAssignableFrom(other), "a mandatory field is missing");
    }

    #! A shared subtype must be expanded once per distinct type object, not once per path to it
    sharedSubtypeDagTest() {
        AbstractDataProviderType t = getSharedSubtypeDag(Depth);

        date start = now_us();
        hash<DataTypeInfo> info = t.getInfo();
        date elapsed = now_us() - start;

        assertLt(MaxTraversalTime, elapsed, "getInfo() on a shared-subtype DAG must not re-expand shared subtypes");

        # the graph is intact: Depth levels of "a"/"b"/"c" above the leaf
        hash<auto> node = info;
        for (int i = 0; i < Depth; ++i) {
            assertEq(("a", "b", "c"), sort(keys node.fields), sprintf("level %d fields", i));
            node = node.fields.a.type;
        }
        assertEq(("num", "str"), sort(keys node.fields), "leaf fields");
        assertEq("string", node.fields.str.type.base_type, "leaf field type");
    }

    #! Memoizing the traversal must not change the result: every occurrence of a shared subtype is identical
    sharedSubtypeInfoTest() {
        # keep this shallow so that the *unmemoized* result is also comparable
        AbstractDataProviderType t = getSharedSubtypeDag(3);
        hash<DataTypeInfo> info = t.getInfo();

        # all three fields reference the same type object, so all three must report the same type info
        assertEq(info.fields.a.type, info.fields.b.type, "shared subtype info must not depend on the path");
        assertEq(info.fields.a.type, info.fields.c.type, "shared subtype info must not depend on the path");

        # ... and the same holds one level down
        hash<auto> child = info.fields.a.type;
        assertEq(child.fields.a.type, child.fields.c.type, "nested shared subtype info must not depend on the path");

        # the shared subtype is a real expansion, not an empty placeholder
        assertEq("hash", info.fields.a.type.base_type, "shared subtype is expanded");
        assertTrue(info.fields.a.type.fields.hasKey("a"), "shared subtype retains its fields");
    }

    #! A cyclic element-type graph must terminate, with the cycle marked rather than followed
    cyclicElementTypeTest() {
        SettableElementType a("a");
        SettableElementType b("b");
        a.setElementType(b);
        b.setElementType(a);

        date start = now_us();
        hash<DataTypeInfo> info = a.getInfo();
        date elapsed = now_us() - start;

        assertLt(MaxTraversalTime, elapsed, "getInfo() on a cyclic element-type graph must terminate");

        # "a" contains "b"; "b" would contain "a" again, so the cycle is truncated there and marked
        assertEq("b", info.element_type.name, "the element type is reported");
        assertTrue(info.element_type.element_type.recursive, "the cycle is marked as recursive");
        assertNothing(info.element_type.element_type.element_type,
            "the cycle is truncated rather than followed");
    }

    #! A cyclic field graph must terminate, with the cycle marked rather than followed
    cyclicFieldTypeTest() {
        HashDataType t();
        # a field of the type itself: t.self -> t -> t.self -> ...
        t.addField(new QoreDataField("self", "self-referencing field", t));
        t.addField(new QoreDataField("str", "a string field", StringType));

        date start = now_us();
        hash<DataTypeInfo> info = t.getInfo();
        date elapsed = now_us() - start;

        assertLt(MaxTraversalTime, elapsed, "getInfo() on a cyclic field graph must terminate");

        hash<auto> child = info.fields.self.type;
        assertTrue(child.recursive, "the cycle is marked as recursive");
        assertNothing(child.fields, "the cycle is truncated rather than followed");
    }

    #! The configuration members of getInfo(), which the type described a field's configuration with before
    private hash<DataTypeInfo> getExpectedConfigInfo(AbstractDataProviderType t) {
        return t.getInfo(){AbstractDataProviderType::ConfigInfoKeys};
    }

    #! getConfigInfo() returns the configuration members of getInfo() for every kind of type
    configInfoTest() {
        HashDataType cyclic();
        cyclic.addField(new QoreDataField("self", "self-referencing field", cyclic));
        HashDataType with_path("with_path", NOTHING, {"x": 1}, {"a": 1});
        with_path.setPath("types/with_path");
        hash<string, AbstractDataProviderType> types = {
            "string": AbstractDataProviderType::get(StringType),
            "or nothing": AbstractDataProviderType::get(StringOrNothingType),
            "options": new QoreDataType(StringType, {"qore.no_null": True}, {"x": 1}, "default"),
            "hash with fields": getSharedSubtypeDag(2),
            "hash with other fields": new HashDataType(),
            "hash with path, tags and default": with_path,
            "list": new ListDataType(AbstractDataProviderType::get(IntType)),
            "union": new QoreUnionDataType((AbstractDataProviderType::get(IntType),
                AbstractDataProviderType::get(StringType))),
            "cyclic": cyclic,
        };
        foreach hash<auto> i in (types.pairIterator()) {
            hash<DataTypeInfo> expected = getExpectedConfigInfo(i.value);
            assertEq(expected, i.value.getConfigInfo(), i.key);
            assertEq(expected, new QoreDataField("f", "a field", i.value).getConfigInfo().type, i.key + " field");
        }
        # the members that a type may lack are given only if it has them
        assertEq("types/with_path", with_path.getConfigInfo().path);
        assertEq({"a": 1}, with_path.getConfigInfo().default_value);
        assertEq({"x": 1}, with_path.getConfigInfo().tags);
        assertFalse(AbstractDataProviderType::get(StringType).getConfigInfo().hasKey("path"));
        assertFalse(AbstractDataProviderType::get(StringType).getConfigInfo().hasKey("default_field_type_info"));
        assertEq("auto", new HashDataType().getConfigInfo().default_field_type_info.base_type);
        assertFalse(getSharedSubtypeDag(1).getConfigInfo().hasKey("default_field_type_info"),
            "a hash type with fields has no default field type");
        # nothing beyond the configuration members, not even the hashdecl's default member values
        foreach hash<auto> i in (types.pairIterator()) {
            assertEq(0, elements (map $1, keys i.value.getConfigInfo(),
                !inlist($1, AbstractDataProviderType::ConfigInfoKeys)), i.key);
        }
    }

    #! getConfigInfo() describes the type itself, never its fields or element type
    configInfoUntraversedTest() {
        UntraversableHashType t();
        assertThrows("TYPE-TRAVERSED", \t.getInfo());
        hash<DataTypeInfo> info = new QoreDataField("f", "a field", t).getConfigInfo().type;
        assertEq("untraversable", info.name);
        assertEq("hash", info.base_type);
        assertEq({"x": 1}, info.tags);
        assertEq({"a": 1}, info.default_value);
        assertFalse(info.hasKey("fields"));
        assertFalse(info.hasKey("element_type"));
    }

    #! A field's configuration on a deep graph whose shared subtypes are on a cycle is described in bounded time
    /** Info on a type truncated by a cycle depends on the path to it, so getInfo() cannot memoize the types on a
        cycle and re-expands each shared subtype once per path to it (Fanout ** Depth); a field's configuration does
        not traverse the graph at all
    */
    configInfoCyclicGraphTest() {
        HashDataType root();
        AbstractDataProviderType rv = root;
        for (int i = 0; i < Depth; ++i) {
            HashDataType t();
            foreach string fname in ("a", "b", "c") {
                t.addField(new QoreDataField(fname, "shared subtype", rv));
            }
            rv = t;
        }
        # close the cycle: the leaf refers back to the top of the graph
        root.addField(new QoreDataField("top", "cycle to the top", rv));

        date start = now_us();
        hash<DataFieldInfo> info = new QoreDataField("f", "a field", rv).getConfigInfo();
        date elapsed = now_us() - start;
        assertLt(MaxTraversalTime, elapsed, "a field's configuration must not traverse the type graph");
        assertEq("hash", info.type.base_type);
        assertFalse(info.type.hasKey("default_field_type_info"), "the type declares fields");
    }
}
