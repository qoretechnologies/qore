# DEALINGS IN THE SOFTWARE.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/FsUtil.qm
%requires ../../../../qlib/DataProvider
%requires i18n
%requires json

%exec-class DataProviderPresentationTest

#! Fixture proving that presentation extraction does not resolve a dynamic/contextual type
class StaticPresentationDataField inherits QoreDataField {
    constructor(hash<auto> info) : QoreDataField(info) {
    }

    AbstractDataProviderType getType() {
        throw "DYNAMIC-TYPE-RESOLUTION-ERROR",
            "presentation extraction must not resolve dynamic types";
    }

    AbstractDataProviderType getDeclaredType() {
        return QoreDataField::getType();
    }
}

class DataProviderPresentationTest inherits QUnit::Test {
    private {
        const App = "メール";
        const Action = "送信";
        const Option = "宛先";
        const PathVar = "アカウント";
        const AllowedValue = "doručit";
        const CatalogApp = "処理元";
        const Domain = "test.data-provider.presentation";
    }

    constructor() : Test("DataProvider presentation catalog test", "1.0") {
        addTestCase("technical identities produce stable catalog keys",
            \stableIdentityTest());
        addTestCase("catalog projection is locale-aware and identity-safe",
            \localizedProjectionTest());
        addTestCase("mirrored actions use explicit source-app presentation identity",
            \presentationCatalogAppTest());
        addTestCase("catalog projection preserves literal braces",
            \literalPresentationTest());
        addTestCase("owner fragments reject order-dependent conflicts",
            \ownerFragmentConflictTest());
        addTestCase("catalog search paths shadow repeated owner layers",
            \catalogSearchPathShadowingTest());
        addTestCase("composable catalog files are parsed exactly once",
            \catalogParseCountTest());
        addTestCase("a discovery index is reused across catalogs",
            \catalogDiscoveryIndexTest());
        addTestCase("domain catalogs share parsed catalog files",
            \domainCatalogBuilderTest());
        addTestCase("catalog conflicts name the conflicting files",
            \catalogConflictReportTest());
        addTestCase("source catalogs cover provider presentation metadata",
            \sourceCatalogTest());
        addTestCase("source catalogs recursively cover nested option types",
            \nestedSourceCatalogTest());
        addTestCase("producer locale validation is metadata-only and comprehensive",
            \sourceLocaleInspectionTest());
        addTestCase("the checked-in Qore source catalog is synchronized",
            \sourceCatalogSyncTest());
        addTestCase("the checked-in provider locale projects exact identities",
            \checkedInLocaleCatalogTest());
        addTestCase("missing translations never claim source prose is localized",
            \missingTranslationTest());
        addTestCase("catalog discovery builds multilingual embedding context",
            \multilingualEmbeddingTest());
        addTestCase("catalog checks reject stale translations without rejecting cognates",
            \sourceCatalogTranslationCheckTest());
        set_return_value(main());
    }

    private hash<auto> app() {
        return {
            "name": App,
            "display_name": "Poštovní služba",
            "short_desc": "Zpracovává poštu",
            "desc": "Poskytuje poštovní operace.",
            "presentation_catalog_domain": Domain,
            "presentation_source_locale": "cs-CZ",
        };
    }

    private hash<auto> action() {
        return {
            "app": App,
            "action": Action,
            "display_name": "Odeslat zprávu",
            "short_desc": "Odešle jednu zprávu",
            "desc": "Odešle zprávu přes vybraný účet.",
        };
    }

    private hash<auto> option() {
        return {
            "display_name": "Příjemce",
            "short_desc": "Adresa příjemce",
            "desc": "Technická adresa cílového příjemce.",
        };
    }

    private hash<auto> messages() {
        return {
            DataProviderPresentation::appMessageId(App, "display_name"):
                {"source": "Poštovní služba", "message": "メールサービス"},
            DataProviderPresentation::appMessageId(App, "short_desc"):
                {"source": "Zpracovává poštu", "message": "メールを処理します"},
            DataProviderPresentation::appMessageId(App, "desc"):
                {"source": "Poskytuje poštovní operace.", "message": "メール操作を提供します。"},
            DataProviderPresentation::actionMessageId(App, Action,
                "display_name"):
                {"source": "Odeslat zprávu", "message": "メッセージを送信"},
            DataProviderPresentation::actionMessageId(App, Action,
                "short_desc"):
                {"source": "Odešle jednu zprávu", "message": "1件のメッセージを送信します"},
            DataProviderPresentation::actionMessageId(App, Action, "desc"):
                {"source": "Odešle zprávu přes vybraný účet.",
                    "message": "選択したアカウントでメッセージを送信します。"},
            DataProviderPresentation::optionMessageId(App, Action, Option,
                "display_name"):
                {"source": "Příjemce", "message": "受信者"},
            DataProviderPresentation::optionMessageId(App, Action, Option,
                "short_desc"):
                {"source": "Adresa příjemce", "message": "受信者のアドレス"},
            DataProviderPresentation::optionMessageId(App, Action, Option,
                "desc"):
                {"source": "Technická adresa cílového příjemce.",
                    "message": "対象受信者の技術アドレス。"},
            DataProviderPresentation::allowedValueMessageId(App, Action,
                Option, AllowedValue, "display_name"):
                {"source": "Doručit", "message": "配信する"},
            DataProviderPresentation::allowedValueMessageId(App, Action,
                Option, AllowedValue, "short_desc"):
                {"source": "Doručí zprávu", "message": "メッセージを配信します"},
            DataProviderPresentation::allowedValueMessageId(App, Action,
                Option, AllowedValue, "desc"):
                {"source": "Zpráva bude doručena.", "message": "メッセージが配信されます。"},
        };
    }

    private sourceLocaleInspectionTest() {
        assertEq((), DataProviderPresentation::inspectSourceLocales(app(),
                (action(),)),
            "actions inherit a valid app source locale");

        hash<auto> missing_app = app();
        remove missing_app.presentation_source_locale;
        list<hash<auto>> missing =
            DataProviderPresentation::inspectSourceLocales(missing_app,
                (action(),));
        assertEq(2, missing.size(),
            "missing app metadata reports both affected presentations");
        assertEq(("app", "action"), map $1.scope, missing,
            "issues retain deterministic app-before-action order");
        assertEq(("source_locale_required", "source_locale_required"),
            map $1.reason, missing,
            "missing locale issues use stable reason codes");
        assertEq(Action, missing[1].action,
            "the action issue preserves its exact technical identity");

        hash<auto> invalid_app = app()
            + {"presentation_source_locale": "not a locale!"};
        hash<auto> explicit_action = action()
            + {"presentation_source_locale": "ja"};
        list<hash<auto>> invalid =
            DataProviderPresentation::inspectSourceLocales(invalid_app,
                (explicit_action,));
        assertEq(1, invalid.size(),
            "a valid action override is independent of an invalid app locale");
        assertEq("app", invalid[0].scope);
        assertEq("invalid_source_locale", invalid[0].reason);
        assertTrue(invalid[0].error.val(),
            "invalid locale diagnostics retain the structured exception code");

        hash<auto> invalid_action = action()
            + {"presentation_source_locale": "cs_looks_localized"};
        list<hash<auto>> action_issue =
            DataProviderPresentation::inspectSourceLocales(app(),
                (invalid_action,), False);
        assertEq(1, action_issue.size());
        assertEq("action", action_issue[0].scope);
        assertEq("invalid_source_locale", action_issue[0].reason,
            "locale validity never depends on lexical resemblance");
    }

    private string writeCatalog() {
        string root = make_tmp_dir("data-provider-presentation-");
        mkdir(root + DirSep + Domain);
        File file();
        file.open2(root + DirSep + Domain + DirSep + "ja.json", O_CREAT
            | O_WRONLY | O_TRUNC);
        file.write(make_json({
            "schema_version": I18n::get_catalog_schema_version(),
            "locales": {"ja": {"messages": messages()}},
        }));
        file.close();
        return root;
    }

    private hash<auto> arabicMessages() {
        return {
            DataProviderPresentation::appMessageId(App, "display_name"):
                {"source": "Poštovní služba", "message": "خدمة البريد"},
            DataProviderPresentation::appMessageId(App, "short_desc"):
                {"source": "Zpracovává poštu", "message": "تعالج البريد"},
            DataProviderPresentation::appMessageId(App, "desc"):
                {"source": "Poskytuje poštovní operace.",
                    "message": "توفر عمليات البريد."},
            DataProviderPresentation::actionMessageId(App, Action,
                "display_name"):
                {"source": "Odeslat zprávu", "message": "إرسال رسالة"},
            DataProviderPresentation::actionMessageId(App, Action,
                "short_desc"):
                {"source": "Odešle jednu zprávu",
                    "message": "ترسل رسالة واحدة"},
            DataProviderPresentation::actionMessageId(App, Action, "desc"):
                {"source": "Odešle zprávu přes vybraný účet.",
                    "message": "ترسل رسالة عبر الحساب المحدد."},
        };
    }

    private writeJson(string path, hash<auto> value) {
        File file();
        file.open2(path, O_CREAT | O_WRONLY | O_TRUNC);
        file.write(make_json(value));
        file.close();
    }

    private string sourceRoot() {
        string path = normalize_dir(dirname(get_script_path()));
        while (path.val()) {
            if (is_file(path + DirSep + "CMakeLists.txt")
                    && is_dir(path + DirSep + "qlib/DataProvider")) {
                return path;
            }
            string parent = dirname(path);
            if (parent == path) {
                break;
            }
            path = parent;
        }
        throw "TEST-ERROR", sprintf(
            "cannot locate the Qore source root above %y", get_script_path());
    }

    stableIdentityTest() {
        assertTrue(inlist("histogram", map $1.action,
                DataProviderActionCatalog::getActionsNoInit("Qore")),
            "the no-init action view exposes already-registered metadata");
        string domain = DataProviderPresentation::defaultCatalogDomain(App);
        assertTrue(regex(domain, "^data-provider\\.[A-Za-z0-9_-]+$"),
            "a non-Latin app has a path-safe catalog domain");
        assertEq(domain,
            DataProviderPresentation::defaultCatalogDomain(App),
            "catalog domain generation is deterministic");
        assertNeq(DataProviderPresentation::actionMessageId(App, Action,
                "display_name"),
            DataProviderPresentation::actionMessageId(App, Action + "。",
                "display_name"),
            "distinct Unicode technical identities cannot collide");
        assertNeq(DataProviderPresentation::allowedValueMessageId(App,
                Action, Option, 1, "display_name"),
            DataProviderPresentation::allowedValueMessageId(App, Action,
                Option, "1", "display_name"),
            "allowed-value identities include the exact scalar type");
        assertNeq(DataProviderPresentation::allowedValueMessageId(App,
                Action, Option, "GET", "display_name"),
            DataProviderPresentation::allowedValueMessageId(App, Action,
                Option, "PUT", "display_name"),
            "distinct allowed values cannot share a catalog identity");
        assertEq(NOTHING,
            DataProviderPresentation::allowedValueMessageId(App, Action,
                Option, {"complex": True}, "display_name"),
            "complex values do not acquire an unstable presentation id");
        assertThrows("DATA-PROVIDER-PRESENTATION-ERROR", sub () {
            DataProviderPresentation::appMessageId(App, "label");
        });
    }

    localizedProjectionTest() {
        string root = writeCatalog();
        on_exit remove_tree(root);
        DataProviderPresentationCatalog catalog(Domain, "ja-JP",
            {"search_path": (root,)});
        hash<auto> localized_app = catalog.projectApp(app());
        hash<auto> localized_action = catalog.projectAction(app(), action());
        hash<auto> localized_option = catalog.projectOption(app(), action(),
            Option, option());
        hash<auto> localized_value = catalog.projectAllowedValue(app(),
            action(), Option, {
                "value": AllowedValue,
                "display_name": "Doručit",
                "short_desc": "Doručí zprávu",
                "desc": "Zpráva bude doručena.",
            });

        assertEq(App, localized_app.name,
            "app technical identity is unchanged");
        assertEq(Action, localized_action.action,
            "action technical identity is unchanged");
        assertEq("メールサービス", localized_app.display_name);
        assertEq("メッセージを送信", localized_action.display_name);
        assertEq("受信者", localized_option.display_name);
        assertEq(AllowedValue, localized_value.value,
            "allowed-value technical identity is unchanged");
        assertEq("配信する", localized_value.display_name,
            "allowed-value presentation uses the locale catalog");
        assertEq("ja-JP", localized_action.presentation_language);
        assertEq("cs-CZ",
            localized_action.producer_presentation.language);
        assertEq("Odeslat zprávu",
            localized_action.producer_presentation.display_name);
        assertFalse(exists localized_action.presentation_incomplete,
            "complete locale projection is marked complete");

        hash<auto> changed_action = action() + {
            "display_name": "Nový název akce",
        };
        hash<auto> stale_projection = catalog.projectAction(app(),
            changed_action);
        assertEq(Action, stale_projection.display_name,
            "a translation with superseded source uses technical identity");
        assertTrue(stale_projection.presentation_incomplete,
            "a translation with superseded source is marked incomplete");
        assertEq("Nový název akce",
            stale_projection.producer_presentation.display_name,
            "current producer presentation remains separately available");

        DataProviderPresentationCatalog source_catalog(Domain, "cs",
            {"search_path": (root,)});
        hash<auto> source_action = source_catalog.projectAction(app(),
            action());
        assertEq("Odeslat zprávu", source_action.display_name,
            "a source-language regional fallback uses producer text");
        assertEq("cs-CZ", source_action.presentation_language);
    }

    presentationCatalogAppTest() {
        hash<auto> executable_app = app() + {
            "presentation_source_locale": "ja",
        };
        hash<auto> mirrored_action = action() + {
            "presentation_catalog_app": CatalogApp,
            "presentation_catalog_domain": Domain,
            "presentation_source_locale": "cs-CZ",
            "options": {
                Option: option() + {
                    "allowed_values": ({
                        "value": AllowedValue,
                        "display_name": "Doručit",
                    },),
                },
            },
        };
        string action_id = DataProviderPresentation::actionMessageId(
            CatalogApp, Action, "display_name");
        string action_short_id = DataProviderPresentation::actionMessageId(
            CatalogApp, Action, "short_desc");
        string action_desc_id = DataProviderPresentation::actionMessageId(
            CatalogApp, Action, "desc");
        string option_id = DataProviderPresentation::optionMessageId(
            CatalogApp, Action, Option, "display_name");
        string value_id = DataProviderPresentation::allowedValueMessageId(
            CatalogApp, Action, Option, AllowedValue, "display_name");
        hash<auto> alias_messages = {
            action_id: {
                "source": "Odeslat zprávu",
                "message": "転送されたメッセージを送信",
            },
            action_short_id: {
                "source": "Odešle jednu zprávu",
                "message": "転送されたメッセージを1件送信します",
            },
            action_desc_id: {
                "source": "Odešle zprávu přes vybraný účet.",
                "message": "選択したアカウントで転送されたメッセージを送信します。",
            },
            option_id: {
                "source": "Příjemce",
                "message": "転送先",
            },
            value_id: {
                "source": "Doručit",
                "message": "転送する",
            },
        };

        string root = make_tmp_dir("data-provider-presentation-alias-");
        on_exit remove_tree(root);
        mkdir(root + DirSep + Domain);
        writeJson(root + DirSep + Domain + DirSep + "ja.json", {
            "schema_version": I18n::get_catalog_schema_version(),
            "locales": {"ja": {"messages": alias_messages}},
        });

        DataProviderPresentationCatalog catalog(Domain, "ja",
            {"search_path": (root,)});
        hash<auto> projected_action = catalog.projectAction(executable_app,
            mirrored_action);
        hash<auto> projected_option = catalog.projectOption(executable_app,
            mirrored_action, Option, option());
        hash<auto> projected_value = catalog.projectAllowedValue(executable_app,
            mirrored_action, Option, {
                "value": AllowedValue,
                "display_name": "Doručit",
            });
        assertEq(App, projected_action.app,
            "catalog provenance cannot change the executable app identity");
        assertEq(Action, projected_action.action,
            "catalog provenance cannot change the executable action identity");
        assertEq("転送されたメッセージを送信",
            projected_action.display_name,
            "action presentation uses the explicit source-app identity");
        assertEq("cs-CZ", projected_action.producer_presentation.language,
            "action presentation uses the explicit source producer locale");
        assertEq("転送先", projected_option.display_name,
            "option presentation uses the explicit source-app identity");
        assertEq(AllowedValue, projected_value.value,
            "localized allowed values preserve the exact executable scalar");
        assertEq("転送する", projected_value.display_name,
            "allowed-value presentation uses the source-app identity");
        assertFalse(exists projected_action.presentation_incomplete,
            "the complete aliased projection is not marked incomplete");

        hash<string, hash<auto>> catalogs =
            DataProviderPresentation::buildSourceCatalogs(executable_app,
                (mirrored_action,));
        hash<auto> source_messages = catalogs{Domain}.locales.root.messages;
        assertTrue(exists source_messages{action_id},
            "source extraction emits the declared source-app action ID");
        assertTrue(exists source_messages{option_id},
            "source extraction emits the declared source-app option ID");
        assertTrue(exists source_messages{value_id},
            "source extraction emits the declared source-app value ID");
        assertFalse(exists source_messages{
                DataProviderPresentation::actionMessageId(App, Action,
                    "display_name")},
            "source extraction does not duplicate the executable app ID");

        DataProviderPresentationEmbeddingCatalog embedding(executable_app, {
            "search_path": (root,),
        });
        list<hash<auto>> documents =
            embedding.projectActionDocuments(mirrored_action);
        assertEq(2, documents.size(),
            "the aliased action contributes one translated locale document");
        assertEq("cs-CZ", documents[0].embedding_language,
            "canonical embedding language follows source presentation provenance");
        assertEq("ja", documents[1].embedding_language);
        assertTrue(documents[1].embedding_text.find(
                "転送されたメッセージを送信") >= 0,
            "embedding projection uses the same source-app provenance");
        assertTrue(documents[1].embedding_text.find(App) >= 0,
            "embedding routing retains the executable app identity");
    }

    literalPresentationTest() {
        const string Source = "Send {id: 123} to /users/{id}.";
        const string Translation = "{id: 123} を /users/{id} に送信します。";
        string root = make_tmp_dir("data-provider-presentation-literal-");
        on_exit remove_tree(root);
        mkdir(root + DirSep + Domain);
        string id = DataProviderPresentation::actionMessageId(App, Action,
            "desc");
        File file();
        file.open2(root + DirSep + Domain + DirSep + "ja.json", O_CREAT
            | O_WRONLY | O_TRUNC);
        file.write(make_json({
            "schema_version": I18n::get_catalog_schema_version(),
            "locales": {"ja": {"messages": {
                id: {"source": Source, "message": Translation},
            }}},
        }));
        file.close();

        DataProviderPresentationCatalog catalog(Domain, "ja",
            {"search_path": (root,)});
        hash<auto> source_action = action() + {"desc": Source};
        hash<auto> projected = catalog.projectAction(app(), source_action);
        assertEq(Translation, projected.desc,
            "provider prose treats JSON and path braces as literal text");
        assertEq(Source, projected.producer_presentation.desc,
            "literal producer prose is retained without escaping");
    }

    ownerFragmentConflictTest() {
        string root = make_tmp_dir("data-provider-presentation-fragments-");
        on_exit remove_tree(root);
        string root_dir = root + DirSep + Domain + DirSep + "root";
        mkdir(root + DirSep + Domain);
        mkdir(root_dir);
        string id = DataProviderPresentation::actionMessageId(App, Action,
            "display_name");
        hash<auto> entry = {
            "source": "Odeslat zprávu",
            "message": "Odeslat zprávu",
        };
        writeJson(root_dir + DirSep + "OwnerOne.json", {
            "schema_version": I18n::get_catalog_schema_version(),
            "locales": {"root": {"messages": {id: entry}}},
        });
        writeJson(root_dir + DirSep + "OwnerTwo.json", {
            "schema_version": I18n::get_catalog_schema_version(),
            "locales": {"root": {"messages": {id: entry}}},
        });

        DataProviderPresentationCatalog identical(Domain, "root",
            {"search_path": (root,)});
        assertEq("Odeslat zprávu",
            identical.projectAction(app(), action()).display_name,
            "structurally identical shared-domain contributions remain composable");

        writeJson(root_dir + DirSep + "OwnerTwo.json", {
            "schema_version": I18n::get_catalog_schema_version(),
            "locales": {"root": {"messages": {
                id: {"source": "Jiný název", "message": "Jiný název"},
            }}},
        });
        assertThrows("DATA-PROVIDER-PRESENTATION-CATALOG-ERROR", sub () {
            DataProviderPresentationCatalog conflicting(Domain, "root",
                {"search_path": (root,)});
        }, NOTHING, "conflicting root owner fragments cannot depend on load order");
        assertThrows("DATA-PROVIDER-PRESENTATION-CATALOG-ERROR", sub () {
            DataProviderPresentationEmbeddingCatalog embedding(app(), {
                "search_path": (root,),
            });
            embedding.projectAction(action());
        }, NOTHING, "embedding population validates root owner fragments");

        unlink(root_dir + DirSep + "OwnerTwo.json");
        string ja_dir = root + DirSep + Domain + DirSep + "ja";
        mkdir(ja_dir);
        writeJson(ja_dir + DirSep + "OwnerOne.json", {
            "schema_version": I18n::get_catalog_schema_version(),
            "locales": {"ja": {"messages": {
                id: {"source": "Odeslat zprávu", "message": "メッセージを送信"},
            }}},
        });
        writeJson(ja_dir + DirSep + "OwnerTwo.json", {
            "schema_version": I18n::get_catalog_schema_version(),
            "locales": {"ja": {"messages": {
                id: {"source": "Odeslat zprávu", "message": "別の翻訳"},
            }}},
        });
        assertThrows("DATA-PROVIDER-PRESENTATION-CATALOG-ERROR", sub () {
            DataProviderPresentationCatalog conflicting(Domain, "ja",
                {"search_path": (root,)});
        }, NOTHING, "conflicting translated owner fragments cannot depend on load order");
    }

    catalogSearchPathShadowingTest() {
        string low = make_tmp_dir("data-provider-presentation-low-");
        on_exit remove_tree(low);
        string high = make_tmp_dir("data-provider-presentation-high-");
        on_exit remove_tree(high);
        string id = DataProviderPresentation::actionMessageId(App, Action,
            "display_name");

        mkdir(low + DirSep + Domain);
        mkdir(low + DirSep + Domain + DirSep + "ja");
        mkdir(high + DirSep + Domain);
        mkdir(high + DirSep + Domain + DirSep + "ja");
        writeJson(low + DirSep + Domain + DirSep + "ja"
                + DirSep + "OwnerOne.json", {
            "schema_version": I18n::get_catalog_schema_version(),
            "locales": {"ja": {"messages": {
                id: {"source": "Odeslat zprávu", "message": "古い翻訳"},
            }}},
        });
        writeJson(high + DirSep + Domain + DirSep + "ja"
                + DirSep + "OwnerOne.json", {
            "schema_version": I18n::get_catalog_schema_version(),
            "locales": {"ja": {"messages": {
                id: {"source": "Odeslat zprávu", "message": "新しい翻訳"},
            }}},
        });

        DataProviderPresentationCatalog owner_catalog(Domain, "ja", {
            "search_path": (low, high),
        });
        assertEq("新しい翻訳",
            owner_catalog.projectAction(app(), action()).display_name,
            "the highest-precedence installation of one owner is effective");

        writeJson(low + DirSep + Domain + DirSep + "ja.json", {
            "schema_version": I18n::get_catalog_schema_version(),
            "locales": {"ja": {"messages": {
                id: {"source": "Odeslat zprávu", "message": "古い直接翻訳"},
            }}},
        });
        writeJson(high + DirSep + Domain + ".ja.json", {
            "schema_version": I18n::get_catalog_schema_version(),
            "locales": {"ja": {"messages": {
                id: {"source": "Odeslat zprávu", "message": "新しい直接翻訳"},
            }}},
        });
        unlink(low + DirSep + Domain + DirSep + "ja"
            + DirSep + "OwnerOne.json");
        unlink(high + DirSep + Domain + DirSep + "ja"
            + DirSep + "OwnerOne.json");

        DataProviderPresentationCatalog direct_catalog(Domain, "ja", {
            "search_path": (low, high),
        });
        assertEq("新しい直接翻訳",
            direct_catalog.projectAction(app(), action()).display_name,
            "flat and nested direct layouts share one precedence layer");
    }

    catalogParseCountTest() {
        string root = make_tmp_dir("data-provider-presentation-parse-count-");
        on_exit remove_tree(root);
        mkdir(root + DirSep + Domain);
        string ja_dir = root + DirSep + Domain + DirSep + "ja";
        mkdir(ja_dir);
        string app_id = DataProviderPresentation::appMessageId(App,
            "display_name");
        string action_id = DataProviderPresentation::actionMessageId(App,
            Action, "display_name");
        string option_id = DataProviderPresentation::optionMessageId(App,
            Action, Option, "display_name");
        writeJson(root + DirSep + Domain + DirSep + "root.json", {
            "schema_version": I18n::get_catalog_schema_version(),
            "locales": {"root": {"messages": {
                app_id: {"source": "Poštovní služba",
                    "message": "Poštovní služba"},
            }}},
        });
        # Distinct owners contribute disjoint ids for the same locale, so the
        # catalog composes more than one file per locale layer.
        writeJson(root + DirSep + Domain + DirSep + "ja.json", {
            "schema_version": I18n::get_catalog_schema_version(),
            "locales": {"ja": {"messages": {
                app_id: messages(){app_id},
            }}},
        });
        writeJson(ja_dir + DirSep + "OwnerOne.json", {
            "schema_version": I18n::get_catalog_schema_version(),
            "locales": {"ja": {"messages": {
                action_id: messages(){action_id},
            }}},
        });
        writeJson(ja_dir + DirSep + "OwnerTwo.json", {
            "schema_version": I18n::get_catalog_schema_version(),
            "locales": {"ja": {"messages": {
                option_id: messages(){option_id},
            }}},
        });

        hash<auto> discovery_opts = {"search_path": (root,)};
        list<string> files = I18n::discover_catalog_files(Domain, "ja",
            discovery_opts);
        assertEq(4, files.size(),
            "the catalog under test composes four independent files");

        int before = I18n::get_catalog_file_parse_count();
        DataProviderPresentationCatalog catalog(Domain, "ja",
            discovery_opts);
        assertEq(files.size(),
            I18n::get_catalog_file_parse_count() - before,
            "collision validation and catalog construction share one parse "
                "per discovered file");

        # Without a per-file counter the assertion above could also be
        # satisfied by a single increment per catalog, so prove the counter
        # itself is per file.
        before = I18n::get_catalog_file_parse_count();
        foreach string path in (files) {
            I18n::load_native_catalog(path);
        }
        assertEq(files.size(),
            I18n::get_catalog_file_parse_count() - before,
            "each native catalog file load is counted exactly once");

        # Every parsed layer must still reach the composed catalog.
        assertEq("メールサービス", catalog.projectApp(app()).display_name,
            "the direct locale layer is composed");
        assertEq("メッセージを送信",
            catalog.projectAction(app(), action()).display_name,
            "the first owner fragment is composed");
        assertEq("受信者", catalog.projectOption(app(), action(), Option,
                option()).display_name,
            "the second owner fragment is composed");

        before = I18n::get_catalog_file_parse_count();
        DataProviderPresentationCatalog empty(Domain, "ja",
            {"search_path": ()});
        assertEq(0, I18n::get_catalog_file_parse_count() - before,
            "a catalog with no discovered files parses nothing");
        assertEq(Action,
            empty.projectAction(app(), action()).display_name,
            "an empty catalog falls back to the exact technical identity");
    }

    catalogDiscoveryIndexTest() {
        string root = make_tmp_dir("data-provider-presentation-index-");
        on_exit remove_tree(root);
        mkdir(root + DirSep + Domain);
        writeJson(root + DirSep + Domain + DirSep + "ja.json", {
            "schema_version": I18n::get_catalog_schema_version(),
            "locales": {"ja": {"messages": messages()}},
        });
        writeJson(root + DirSep + Domain + DirSep + "ar-EG.json", {
            "schema_version": I18n::get_catalog_schema_version(),
            "locales": {"ar-EG": {"messages": arabicMessages()}},
        });

        hash<auto> discovery_opts = {"search_path": (root,)};
        list<string> locales = ("ja", "ar-EG", "sk");
        I18n::CatalogDiscoveryIndex discovery_index();
        foreach string locale in (locales) {
            DataProviderPresentationCatalog direct(Domain, locale,
                discovery_opts);
            DataProviderPresentationCatalog indexed(Domain, locale,
                discovery_opts, discovery_index);
            assertEq(direct.projectAction(app(), action()),
                indexed.projectAction(app(), action()),
                sprintf("an indexed %y catalog projects identical "
                    "presentation", locale));
        }

        int scans = discovery_index.getDirectoryScanCount();
        assertGt(0, scans, "building the catalogs read catalog directories");
        foreach string locale in (locales) {
            DataProviderPresentationCatalog repeated(Domain, locale,
                discovery_opts, discovery_index);
            assertEq(locale == "ar-EG" ? "ar-EG" : locale,
                repeated.getLocale(),
                "a repeated catalog keeps its requested locale");
        }
        assertEq(scans, discovery_index.getDirectoryScanCount(),
            "rebuilding the same catalogs reads no catalog directory again");

        # embedding population builds one catalog per discovered locale and
        # must reuse one index for the whole population
        DataProviderPresentationEmbeddingCatalog embedding(app(),
            discovery_opts);
        hash<auto> document = embedding.projectAction(action());
        assertEq("mul", document.embedding_language,
            "the population still discovers every installed locale");
        assertTrue(document.embedding_text.find("メッセージを送信") >= 0,
            "the population still projects translated presentation");
    }

    domainCatalogBuilderTest() {
        string root = make_tmp_dir("data-provider-presentation-builder-");
        on_exit remove_tree(root);
        string domain_dir = root + DirSep + Domain;
        mkdir(domain_dir);
        mkdir(domain_dir + DirSep + "ja");
        string display_id = DataProviderPresentation::actionMessageId(App,
            Action, "display_name");
        string desc_id = DataProviderPresentation::actionMessageId(App,
            Action, "desc");
        writeJson(domain_dir + DirSep + "root.json", {
            "schema_version": I18n::get_catalog_schema_version(),
            "locales": {"root": {"messages": {
                display_id: {"source": "Odeslat zprávu",
                    "message": "Odeslat zprávu"},
            }}},
        });
        writeJson(domain_dir + DirSep + "ja.json", {
            "schema_version": I18n::get_catalog_schema_version(),
            "locales": {"ja": {"messages": {
                display_id: {"source": "Odeslat zprávu",
                    "message": "メッセージを送信"},
            }}},
        });
        writeJson(domain_dir + DirSep + "ja" + DirSep + "OwnerOne.json", {
            "schema_version": I18n::get_catalog_schema_version(),
            "locales": {"ja": {"messages": {
                desc_id: {"source": "Odešle zprávu přes vybraný účet.",
                    "message": "メッセージを送信します。"},
            }}},
        });
        writeJson(domain_dir + DirSep + "pt.json", {
            "schema_version": I18n::get_catalog_schema_version(),
            "locales": {"pt": {"messages": {
                display_id: {"source": "Odeslat zprávu",
                    "message": "Enviar mensagem"},
            }}},
        });
        writeJson(domain_dir + DirSep + "pt-BR.json", {
            "schema_version": I18n::get_catalog_schema_version(),
            "locales": {"pt-BR": {"messages": {
                desc_id: {"source": "Odešle zprávu přes vybraný účet.",
                    "message": "Envia a mensagem."},
            }}},
        });

        hash<auto> discovery_opts = {"search_path": (root,)};
        # sk has no catalog, ja is requested twice, and pt_BR is not canonical
        list<string> locales = ("root", "ja", "pt", "pt_BR", "sk", "ja");
        list<string> canonical = ("root", "ja", "pt", "pt-BR", "sk", "ja");

        list<DataProviderPresentationCatalog> direct = ();
        int before = I18n::get_catalog_file_parse_count();
        foreach string locale in (locales) {
            direct += new DataProviderPresentationCatalog(Domain, locale,
                discovery_opts);
        }
        int direct_parses = I18n::get_catalog_file_parse_count() - before;

        before = I18n::get_catalog_file_parse_count();
        list<DataProviderPresentationCatalog> built =
            DataProviderPresentationCatalog::buildDomainCatalogs(Domain,
                locales, discovery_opts);
        int built_parses = I18n::get_catalog_file_parse_count() - before;

        assertEq(5, built_parses, "each of the five catalog files is parsed "
            "once although root.json, pt.json, and the ja files are shared");
        assertEq(13, direct_parses, "building each catalog separately parses "
            "the shared files again for every locale");
        assertEq(canonical, (map $1.getLocale(), built),
            "one catalog per requested locale in request order");
        foreach DataProviderPresentationCatalog catalog in (built) {
            assertEq(direct[$#].projectAction(app(), action()),
                catalog.projectAction(app(), action()),
                sprintf("the %y catalog projects the same presentation as its "
                    "separately built catalog", canonical[$#]));
        }
        assertEq("メッセージを送信", built[1].projectAction(app(),
            action()).display_name, "the direct locale catalog is composed");
        assertEq("メッセージを送信します。", built[1].projectAction(app(),
            action()).desc, "owner fragments are composed");
        hash<auto> pt_br = built[3].projectAction(app(), action());
        assertEq("Enviar mensagem", pt_br.display_name,
            "a regional catalog falls back to its shared base-language file");
        assertEq("Envia a mensagem.", pt_br.desc,
            "a regional catalog composes its own file");

        # the streaming form hands over the same catalogs in request order with
        # the same single parse of every file
        list<string> streamed_locales = ();
        list<hash<auto>> streamed_projections = ();
        before = I18n::get_catalog_file_parse_count();
        DataProviderPresentationCatalog::forEachDomainCatalog(Domain, locales,
            sub (DataProviderPresentationCatalog catalog) {
                streamed_locales += catalog.getLocale();
                streamed_projections += catalog.projectAction(app(), action());
            }, discovery_opts);
        assertEq(5, I18n::get_catalog_file_parse_count() - before,
            "streaming parses each catalog file once");
        assertEq(canonical, streamed_locales,
            "streaming visits the requested locales in order");
        assertEq((map $1.projectAction(app(), action()), built),
            streamed_projections,
            "streamed catalogs project the same presentation");

        # an exception thrown by the consumer stops the build
        int consumed = 0;
        assertThrows("CONSUMER-ERROR", sub () {
            DataProviderPresentationCatalog::forEachDomainCatalog(Domain,
                locales, sub (DataProviderPresentationCatalog catalog) {
                    if (++consumed == 2) {
                        throw "CONSUMER-ERROR", catalog.getLocale();
                    }
                }, discovery_opts);
        }, NOTHING, "a consumer exception is propagated");
        assertEq(2, consumed, "no catalog is built after the consumer fails");

        # a caller-supplied index serves every discovery of the call
        I18n::CatalogDiscoveryIndex discovery_index();
        DataProviderPresentationCatalog::buildDomainCatalogs(Domain, locales,
            discovery_opts, discovery_index);
        int scans = discovery_index.getDirectoryScanCount();
        assertGt(0, scans, "the build read catalog directories");
        DataProviderPresentationCatalog::buildDomainCatalogs(Domain, locales,
            discovery_opts, discovery_index);
        assertEq(scans, discovery_index.getDirectoryScanCount(),
            "a repeated build through the same index reads no directory "
                "again");

        assertEq((), DataProviderPresentationCatalog::buildDomainCatalogs(
            Domain, (), discovery_opts), "no locales build no catalogs");
        assertThrows("I18N-LOCALE-ERROR",
            \DataProviderPresentationCatalog::buildDomainCatalogs(),
            (Domain, ("ja", "not a locale!"), discovery_opts),
            "an invalid locale is rejected");
    }

    catalogConflictReportTest() {
        string root = make_tmp_dir("data-provider-presentation-conflict-");
        on_exit remove_tree(root);
        string domain_dir = root + DirSep + Domain;
        string ja_dir = domain_dir + DirSep + "ja";
        mkdir(domain_dir);
        mkdir(ja_dir);
        string id = DataProviderPresentation::actionMessageId(App, Action,
            "display_name");
        writeJson(domain_dir + DirSep + "root.json", {
            "schema_version": I18n::get_catalog_schema_version(),
            "locales": {"root": {"messages": {
                id: {"source": "Odeslat zprávu", "message": "Odeslat zprávu"},
            }}},
        });
        string owner_one = ja_dir + DirSep + "OwnerOne.json";
        string owner_two = ja_dir + DirSep + "OwnerTwo.json";
        writeJson(owner_one, {
            "schema_version": I18n::get_catalog_schema_version(),
            "locales": {"ja": {"messages": {
                id: {"source": "Odeslat zprávu", "message": "メッセージを送信"},
            }}},
        });
        writeJson(owner_two, {
            "schema_version": I18n::get_catalog_schema_version(),
            "locales": {"ja": {"messages": {
                id: {"source": "Odeslat zprávu", "message": "別の翻訳"},
            }}},
        });
        hash<auto> discovery_opts = {"search_path": (root,)};
        string desc = sprintf("provider catalog files %y and %y conflict for "
            "locale %y message id %y", owner_one, owner_two, "ja", id);
        hash<auto> arg = {
            "locale": "ja",
            "id": id,
            "files": (owner_one, owner_two),
        };

        *hash<ExceptionInfo> ex = catchException(sub () {
            DataProviderPresentationCatalog catalog(Domain, "ja",
                discovery_opts);
        });
        assertEq("DATA-PROVIDER-PRESENTATION-CATALOG-ERROR", ex.err);
        assertEq(desc, ex.desc);
        assertEq(arg, ex.arg);

        ex = catchException(sub () {
            DataProviderPresentationCatalog::buildDomainCatalogs(Domain,
                ("root", "ja"), discovery_opts);
        });
        assertEq("DATA-PROVIDER-PRESENTATION-CATALOG-ERROR", ex.err,
            "the domain builder rejects the same conflict");
        assertEq(desc, ex.desc);
        assertEq(arg, ex.arg);

        # root and ja define the same id for different locales, which is not a
        # conflict
        unlink(owner_two);
        list<DataProviderPresentationCatalog> catalogs =
            DataProviderPresentationCatalog::buildDomainCatalogs(Domain,
                ("root", "ja"), discovery_opts);
        assertEq("メッセージを送信",
            catalogs[1].projectAction(app(), action()).display_name);

        # one file can collide with itself through locale keys that name the
        # same locale
        string direct = domain_dir + DirSep + "pt-BR.json";
        writeJson(direct, {
            "schema_version": I18n::get_catalog_schema_version(),
            "locales": {
                "pt_BR": {"messages": {
                    id: {"source": "Odeslat zprávu", "message": "Enviar"},
                }},
                "pt-BR": {"messages": {
                    id: {"source": "Odeslat zprávu", "message": "Mandar"},
                }},
            },
        });
        ex = catchException(sub () {
            DataProviderPresentationCatalog catalog(Domain, "pt-BR",
                discovery_opts);
        });
        assertEq("DATA-PROVIDER-PRESENTATION-CATALOG-ERROR", ex.err);
        assertEq(sprintf("provider catalog file %y defines locale %y message "
            "id %y more than once with different content", direct, "pt-BR",
            id), ex.desc);
        assertEq({"locale": "pt-BR", "id": id, "files": (direct, direct)},
            ex.arg);
    }

    private *hash<ExceptionInfo> catchException(code c) {
        try {
            c();
        } catch (hash<ExceptionInfo> ex) {
            return ex;
        }
    }

    sourceCatalogTest() {
        hash<DataProviderPathVarInfo> path_var =
            <DataProviderPathVarInfo>{
                "display_name": "Účet",
                "short_desc": "Cílový účet",
                "desc": "Technický identifikátor cílového účtu.",
                "example_value": "primary",
            };
        hash<auto> source_action = action() + {
            "path_vars": {
                PathVar: path_var,
            },
            "options": {
                Option: option() + {
                    "allowed_values": ({
                        "value": AllowedValue,
                        "display_name": "Doručit",
                        "short_desc": "Doručí zprávu",
                        "desc": "Zpráva bude doručena.",
                    },),
                },
            },
        };
        hash<string, hash<auto>> catalogs =
            DataProviderPresentation::buildSourceCatalogs(app(),
                (source_action,));
        assertEq((Domain,), sort(keys catalogs),
            "the app-owned catalog domain contains the action metadata");
        hash<auto> source_messages =
            catalogs{Domain}.locales.root.messages;
        assertEq("Poštovní služba",
            source_messages{
                DataProviderPresentation::appMessageId(App,
                    "display_name")}.source,
            "the root catalog preserves app source text");
        assertEq("Odeslat zprávu",
            source_messages{
                DataProviderPresentation::actionMessageId(App, Action,
                    "display_name")}.source,
            "the root catalog preserves action source text");
        assertEq("Příjemce",
            source_messages{
                DataProviderPresentation::optionMessageId(App, Action,
                    Option, "display_name")}.source,
            "the root catalog preserves option source text");
        assertEq("Účet",
            source_messages{
                DataProviderPresentation::optionMessageId(App, Action,
                    PathVar, "display_name")}.source,
            "typed path variables contribute presentation without requiring action-option members");
        assertEq("Doručit",
            source_messages{
                DataProviderPresentation::allowedValueMessageId(App,
                    Action, Option, AllowedValue,
                    "display_name")}.source,
            "the root catalog preserves static allowed-value source text");

        hash<string, hash<auto>> action_only_catalogs =
            DataProviderPresentation::buildSourceCatalogs(app(),
                (source_action,), False);
        hash<auto> action_only_messages =
            action_only_catalogs{Domain}.locales.root.messages;
        assertFalse(exists action_only_messages{
                DataProviderPresentation::appMessageId(App,
                    "display_name")},
            "an action-only module does not duplicate app-owned presentation");
        assertTrue(exists action_only_messages{
                DataProviderPresentation::actionMessageId(App, Action,
                    "display_name")},
            "an action-only module retains its action presentation");

        assertThrows("DATA-PROVIDER-PRESENTATION-CATALOG-ERROR", sub () {
            DataProviderPresentation::buildSourceCatalogs(app(),
                (source_action + {"app": "別のアプリ"},));
        }, NOTHING, "source extraction rejects cross-app action metadata");
    }

    nestedSourceCatalogTest() {
        QoreDataField choice(<auto>{
            "name": "mode",
            "display_name": "Režim",
            "short_desc": "Režim zpracování",
            "desc": "Určuje režim zpracování.",
            "type": new QoreStringDataType(),
            "allowed_values": (<AllowedValueInfo>{
                "value": "fast",
                "display_name": "Rychlý",
                "short_desc": "Rychlé zpracování",
                "desc": "Použije rychlý režim.",
            },),
        });
        StaticPresentationDataField dynamic_leaf(<auto>{
            "name": "dynamic_leaf",
            "display_name": "Statický popisek",
            "short_desc": "Popisek bez dynamického typu",
            "desc": "Katalog čte deklarovaný typ bez kontextu.",
            "type": new QoreStringDataType(),
        });
        HashDataType item("NestedItem", {
            "mode": choice,
            "dynamic_leaf": dynamic_leaf,
        });
        ListDataType items(item);
        QoreDataField items_field(<auto>{
            "name": "items",
            "display_name": "Položky",
            "short_desc": "Položky požadavku",
            "desc": "Položky, které se zpracují.",
            "type": items,
        });
        HashDataType body("NestedBody", {"items": items_field});
        string body_identity
            = DataProviderPresentation::typePresentationIdentity(body);
        string item_identity
            = DataProviderPresentation::occurrenceTypePresentationIdentity(
                Action, Option, item, ("items",), (body_identity,));
        # The same branch is deliberately present twice. Identical union paths
        # must coalesce rather than acquire order-dependent branch ids.
        QoreUnionDataType union((body, body));
        hash<auto> source_action = action() + {
            "options": {
                Option: option() + {"type": union},
            },
        };
        hash<auto> source_messages =
            DataProviderPresentation::buildSourceCatalogs(app(),
                (source_action,)){Domain}.locales.root.messages;
        assertEq("Položky", source_messages{
                DataProviderPresentation::nestedFieldMessageId(App, Action,
                    Option, ("items",), "display_name",
                    (body_identity,))}.source,
            "a field nested directly in an option type is extracted");
        assertEq("Režim zpracování", source_messages{
                DataProviderPresentation::typeFieldMessageId(App,
                    item_identity, "mode", "short_desc")}.source,
            "fields in reusable deeper types use a bounded occurrence-scoped id");
        assertEq("Rychlý", source_messages{
                DataProviderPresentation::typeAllowedValueMessageId(App,
                    item_identity, "mode", "fast",
                    "display_name")}.source,
            "allowed values on nested fields are extracted");
        assertEq("Statický popisek", source_messages{
                DataProviderPresentation::typeFieldMessageId(App,
                    item_identity, "dynamic_leaf",
                    "display_name")}.source,
            "catalog extraction uses the declared type without resolving a dynamic type");

        string nested_id = DataProviderPresentation::nestedFieldMessageId(
            App, Action, Option, ("items",), "display_name",
            (body_identity,));
        string type_id = DataProviderPresentation::typeFieldMessageId(App,
            item_identity, "mode", "short_desc");
        string value_id =
            DataProviderPresentation::typeAllowedValueMessageId(App,
                item_identity, "mode", "fast",
                "display_name");
        string root = make_tmp_dir("data-provider-nested-presentation-");
        on_exit remove_tree(root);
        mkdir(root + DirSep + Domain);
        writeJson(root + DirSep + Domain + DirSep + "ja.json", {
            "schema_version": I18n::get_catalog_schema_version(),
            "locales": {"ja": {"messages": {
                nested_id: {
                    "source": "Položky",
                    "message": "項目",
                },
                type_id: {
                    "source": "Režim zpracování",
                    "message": "処理モード",
                },
                value_id: {
                    "source": "Rychlý",
                    "message": "高速",
                },
            }}},
        });
        DataProviderPresentationCatalog nested_catalog(Domain, "ja", {
            "search_path": (root,),
        });
        hash<auto> projected_nested = nested_catalog.projectNestedField(
            app(), source_action, Option, ("items",),
            (body_identity,),
            items_field.getPresentationInfo());
        assertEq("項目", projected_nested.display_name,
            "a translated first-layer nested field is projected");
        hash<auto> projected_type = nested_catalog.projectTypeField(app(),
            source_action, item_identity, "mode",
            choice.getPresentationInfo());
        assertEq("処理モード", projected_type.short_desc,
            "a translated reusable-type field is projected");
        hash<auto> projected_value = nested_catalog.projectTypeAllowedValue(
            app(), source_action, item_identity, "mode",
            choice.getAllowedValues()[0], False);
        assertEq("高速", projected_value.display_name,
            "a translated nested allowed value is projected");
        assertEq(DataProviderPresentation::optionMessageId(App, Action,
                Option, "display_name"),
            "app.44Oh44O844Or.action.6YCB5L-h.option.5a6b5YWI.display_name",
            "existing top-level option ids remain unchanged");

        HashDataType recursive("RecursivePresentationType");
        recursive.addField(new QoreDataField("self", "Rekurzivní větev",
            recursive));
        source_action.options{Option}.type = recursive;
        source_messages = DataProviderPresentation::buildSourceCatalogs(
            app(), (source_action,)){Domain}.locales.root.messages;
        assertTrue(exists source_messages{
                DataProviderPresentation::nestedFieldMessageId(App, Action,
                    Option, ("self",), "display_name")},
            "the field closing a recursive edge remains visible");
        assertFalse(exists source_messages{
                DataProviderPresentation::nestedFieldMessageId(App, Action,
                    Option, ("self", "self"), "display_name")},
            "path-local cycle detection stops the recursive edge");

        HashDataType deep_left_child("DeepUnionChild", {
            "value": new QoreDataField(<auto>{
                "name": "value",
                "display_name": "Hodnota vlevo",
                "type": new QoreStringDataType(),
            }),
        });
        HashDataType deep_right_child("DeepUnionChild", {
            "value": new QoreDataField(<auto>{
                "name": "value",
                "display_name": "Hodnota vpravo",
                "type": new QoreStringDataType(),
            }),
        });
        HashDataType deep_left_branch("DeepUnionLeft", {
            "child": new QoreDataField("child", "Levý potomek",
                deep_left_child),
        });
        HashDataType deep_right_branch("DeepUnionRight", {
            "child": new QoreDataField("child", "Pravý potomek",
                deep_right_child),
        });
        HashDataType deep_union_container("DeepUnionContainer", {
            "branch": new QoreDataField("branch", "Větev",
                new QoreUnionDataType((deep_left_branch,
                    deep_right_branch))),
        });
        source_action.options{Option}.type = deep_union_container;
        source_messages = DataProviderPresentation::buildSourceCatalogs(
            app(), (source_action,)){Domain}.locales.root.messages;
        string deep_left_identity
            = DataProviderPresentation::occurrenceTypePresentationIdentity(
                Action, Option, deep_left_child, ("branch", "child"),
                (DataProviderPresentation::typePresentationIdentity(
                    deep_left_branch),));
        string deep_right_identity
            = DataProviderPresentation::occurrenceTypePresentationIdentity(
                Action, Option, deep_right_child, ("branch", "child"),
                (DataProviderPresentation::typePresentationIdentity(
                    deep_right_branch),));
        assertNeq(deep_left_identity, deep_right_identity,
            "a deeper union branch remains part of descendant occurrence identity");
        assertEq("Hodnota vlevo", source_messages{
                DataProviderPresentation::typeFieldMessageId(App,
                    deep_left_identity, "value", "display_name")}.source,
            "a deeper left union branch keeps its descendant presentation");
        assertEq("Hodnota vpravo", source_messages{
                DataProviderPresentation::typeFieldMessageId(App,
                    deep_right_identity, "value", "display_name")}.source,
            "a deeper right union branch keeps its descendant presentation");

        HashDataType conflicting_left("ConflictingReusable", {
            "mode": new QoreDataField("mode", "První režim",
                new QoreStringDataType()),
        });
        HashDataType conflicting_right("ConflictingReusable", {
            "mode": new QoreDataField("mode", "Druhý režim",
                new QoreStringDataType()),
        });
        HashDataType left("ConflictBranch", {
            "child": new QoreDataField("child", "Potomek",
                conflicting_left),
        });
        HashDataType right("ConflictBranch", {
            "child": new QoreDataField("child", "Potomek",
                conflicting_right),
        });
        source_action.options{Option}.type = new QoreUnionDataType(
            (left, right));
        assertNeq(conflicting_left.uniqueHash(),
            conflicting_right.uniqueHash(),
            "conflict fixtures are distinct concrete type objects");
        assertEq(DataProviderPresentation::occurrenceTypePresentationIdentity(
                Action, Option, conflicting_left, ("child",),
                (DataProviderPresentation::typePresentationIdentity(left),)),
            DataProviderPresentation::occurrenceTypePresentationIdentity(
                Action, Option, conflicting_right, ("child",),
                (DataProviderPresentation::typePresentationIdentity(right),)),
            "equal technical occurrences deliberately claim the same presentation identity");
        assertThrows("DATA-PROVIDER-PRESENTATION-CATALOG-ERROR",
            "conflicting source strings", sub () {
                DataProviderPresentation::buildSourceCatalogs(app(),
                    (source_action,));
            }, NOTHING,
            "distinct types sharing one stable identity cannot hide conflicting presentation");

        conflicting_left.setPath("request/left/child");
        conflicting_right.setPath("request/right/child");
        assertNeq(DataProviderPresentation::typePresentationIdentity(
                conflicting_left),
            DataProviderPresentation::typePresentationIdentity(
                conflicting_right),
            "equal-shaped anonymous types at distinct technical schema paths have distinct identities");
        assertTrue(DataProviderPresentation::buildSourceCatalogs(app(),
                (source_action,)).hasKey(Domain),
            "technical schema paths disambiguate equal-shaped anonymous types without presentation text");
    }

    sourceCatalogSyncTest() {
        string root = sourceRoot();
        string qore_bin = root + DirSep + "build/qore";
        if (!is_executable(qore_bin)) {
            testSkip("built qore executable not available");
            return;
        }

        list<string> module_path = (
            root + DirSep + "build/modules/i18n",
            root + DirSep + "build/modules/json",
            root + DirSep + "qlib"
        );
        if (exists ENV.QORE_MODULE_DIR) {
            module_path += ENV.QORE_MODULE_DIR;
        }
        string local_env = sprintf("QORE_MODULE_DIR=%s LD_LIBRARY_PATH=%s",
            shellQuote(module_path.join(PathSep)),
            shellQuote(ENV.LD_LIBRARY_PATH ?? (root + DirSep + "build")));

        assertEq(0, system(sprintf("%s %s %s --help >/dev/null",
            local_env, shellQuote(qore_bin),
            shellQuote(root + DirSep + "bin/qore-data-provider-i18n"))),
            "qore-data-provider-i18n accepts default color handling");

        string cmd = sprintf(
            "%s %s %s -C --check -o %s -a Qore",
            local_env,
            shellQuote(qore_bin),
            shellQuote(root + DirSep + "bin/qore-data-provider-i18n"),
            shellQuote(root + DirSep + "qlib/DataProvider/i18n"));
        assertEq(0, system(cmd),
            "qore-data-provider-i18n --check accepts the source catalog");
        assertEq(0, runCatalogTreeCheck(root, qore_bin,
                root + DirSep + "qlib"),
            "recursive catalog validation covers every Qore provider without an app or locale list");
        assertEq(0, runSourceCatalogTreeCheck(root, qore_bin,
                root, (), True, True),
            "repository source-tree validation infers and verifies every "
                "production Qore provider owner module with complete standard locales");
    }

    sourceCatalogTranslationCheckTest() {
        string root = sourceRoot();
        string qore_bin = root + DirSep + "build/qore";
        if (!is_executable(qore_bin)) {
            testSkip("built qore executable not available");
            return;
        }

        hash<auto> qore_app = DataProviderActionCatalog::getAppEx("Qore");
        hash<string, hash<auto>> catalogs =
            DataProviderPresentation::buildSourceCatalogs(qore_app,
                DataProviderActionCatalog::getActions("Qore", False));
        string domain = DataProviderPresentation::appCatalogDomain(qore_app);
        string output = make_tmp_dir("data-provider-i18n-check-");
        on_exit remove_tree(output);
        mkdir(output + DirSep + domain);
        writeJson(output + DirSep + domain + DirSep + "root.json",
            catalogs{domain});
        hash<auto> stale_root = catalogs{domain};
        stale_root.locales.root.messages{
            DataProviderPresentation::appMessageId("Qore",
                "display_name")}.source = "outdated";
        writeJson(output + DirSep + domain + DirSep + "root.json",
            stale_root);
        assertEq(0, runSourceCatalogTreeUpdate(root, qore_bin, output,
                ("DataProvider",)),
            "source-tree update deterministically repairs every owned root catalog");
        assertEq(catalogs{domain}, parse_json(ReadOnlyFile::readTextFile(
                output + DirSep + domain + DirSep + "root.json")),
            "source-tree update writes the complete generated catalog");

        stale_root.locales.root.messages{
            DataProviderPresentation::appMessageId("Qore",
                "display_name")}.source = "still-outdated";
        writeJson(output + DirSep + domain + DirSep + "root.json",
            stale_root);
        string duplicate_dir = output + DirSep + "duplicate";
        mkdir(duplicate_dir);
        mkdir(duplicate_dir + DirSep + domain);
        writeJson(duplicate_dir + DirSep + domain + DirSep + "root.json",
            catalogs{domain});
        assertEq(1, runSourceCatalogTreeUpdate(root, qore_bin, output,
                ("DataProvider",)),
            "source-tree update rejects a duplicate before writing any root");
        assertEq("still-outdated", parse_json(ReadOnlyFile::readTextFile(
                output + DirSep + domain + DirSep + "root.json"))
                .locales.root.messages{
                    DataProviderPresentation::appMessageId("Qore",
                        "display_name")}.source,
            "a failed source-tree preflight leaves every existing root untouched");
        remove_tree(duplicate_dir);
        assertEq(0, runSourceCatalogTreeUpdate(root, qore_bin, output,
                ("DataProvider",)),
            "source-tree update succeeds after the duplicate is removed");
        assertEq(1, runSourceCatalogTreeCheck(root, qore_bin, output, ()),
            "a noncanonical source tree requires an explicit technical owner module");
        assertEq(0, runSourceCatalogTreeCheck(root, qore_bin, output,
                ("DataProvider",)),
            "an explicit technical owner validates a noncanonical source tree without app or locale lists");
        assertEq(0, runOwnerCatalogCheck(root, qore_bin, output,
                "DataProvider", ("WebSocketClient",)),
            "owner-scoped verification ignores ambient modules");

        string uncataloged_owner = "PresentationUncatalogedOwner";
        string uncataloged_owner_dir = output + DirSep
            + uncataloged_owner;
        mkdir(uncataloged_owner_dir);
        copy_file(get_script_dir() + DirSep + uncataloged_owner + ".qm",
            uncataloged_owner_dir + DirSep + uncataloged_owner + ".qm");
        assertEq(2, runSourceCatalogTreeCheck(root, qore_bin, output,
                ("DataProvider",)),
            "source-tree verification discovers an owner before its first catalog exists");
        remove_tree(uncataloged_owner_dir);

        string unlocalized_owner = "PresentationUnlocalizedOwner";
        string unlocalized_owner_dir = output + DirSep
            + unlocalized_owner;
        mkdir(unlocalized_owner_dir);
        copy_file(get_script_dir() + DirSep + unlocalized_owner + ".qm",
            unlocalized_owner_dir + DirSep + unlocalized_owner + ".qm");
        assertEq(1, runSourceCatalogTreeCheck(root, qore_bin, output,
                ("DataProvider",)),
            "source-tree verification rejects provider prose without a producer locale");
        remove_tree(unlocalized_owner_dir);

        string orphan_domain =
            DataProviderPresentation::defaultCatalogDomain("RemovedApp");
        mkdir(output + DirSep + orphan_domain);
        writeJson(output + DirSep + orphan_domain + DirSep + "root.json",
            catalogs{domain});
        assertEq(0, runCatalogCheck(root, qore_bin, output),
            "an app-scoped check does not classify unrelated catalogs as orphans");
        assertEq(2, runOwnerCatalogCheck(root, qore_bin, output,
                "DataProvider", ()),
            "a complete owner-scoped check rejects orphaned catalog domains");
        remove_tree(output + DirSep + orphan_domain);

        string id = DataProviderPresentation::appMessageId("Qore",
            "display_name");
        string source = catalogs{domain}.locales.root.messages{id}.source;
        writeJson(output + DirSep + domain + DirSep + "cs.json", {
            "schema_version": I18n::get_catalog_schema_version(),
            "locales": {"cs": {"messages": {
                id: {"source": "outdated", "message": "Qore"},
            }}},
        });
        assertEq(2, runCatalogCheck(root, qore_bin, output),
            "a stale producer source fails catalog verification");
        assertEq(2, runCatalogTreeCheck(root, qore_bin, output),
            "catalog-tree verification detects stale producer source");
        assertEq(2, runSourceCatalogTreeCheck(root, qore_bin, output,
                ("DataProvider",)),
            "source-tree verification detects stale producer source");

        writeJson(output + DirSep + domain + DirSep + "cs.json", {
            "schema_version": I18n::get_catalog_schema_version(),
            "locales": {"cs": {"messages": {
                id: {"source": source, "message": source},
            }}},
        });
        assertEq(0, runCatalogCheck(root, qore_bin, output),
            "an identical translated brand or cognate remains valid");
        assertEq(0, runCatalogTreeCheck(root, qore_bin, output),
            "catalog-tree verification accepts identical brands and cognates");
        assertEq(0, runSourceCatalogTreeCheck(root, qore_bin, output,
                ("DataProvider",)),
            "source-tree verification accepts identical brands and cognates");
        hash<auto> inspection =
            DataProviderPresentation::inspectTranslationCatalogs(domain,
                catalogs{domain}.locales.root.messages,
                {"search_path": (output,)});
        assertEq((id,),
            inspection.translation_message_ids_by_locale.cs,
            "translation inspection reports exact source-bound identities by locale");
        assertEq(2, runCatalogTreeCheck(root, qore_bin, output, False,
                True),
            "complete-locale verification rejects missing message identities");
        assertEq(2, runSourceCatalogTreeCheck(root, qore_bin, output,
                ("DataProvider",), False, True),
            "source-tree complete-locale verification rejects missing identities");

        hash<string, hash<auto>> complete_messages;
        foreach hash<auto> entry in (
                catalogs{domain}.locales.root.messages.pairIterator()) {
            complete_messages{entry.key} = {
                "source": entry.value.source,
                "message": entry.value.source,
            };
        }
        writeJson(output + DirSep + domain + DirSep + "cs.json", {
            "schema_version": I18n::get_catalog_schema_version(),
            "locales": {"cs": {"messages": complete_messages}},
        });
        assertEq(0, runCatalogTreeCheck(root, qore_bin, output, False,
                True),
            "complete-locale verification accepts source-identical brands and cognates");
        assertEq(0, runSourceCatalogTreeCheck(root, qore_bin, output,
                ("DataProvider",), False, True),
            "source-tree completeness accepts source-identical translations");
        assertEq(2, runCatalogTreeCheck(root, qore_bin, output, True),
            "catalog-tree verification detects missing standard locale files");

        string fragment_output = make_tmp_dir(
            "data-provider-i18n-fragment-check-");
        on_exit remove_tree(fragment_output);
        string fragment_domain = fragment_output + DirSep + domain;
        mkdir(fragment_domain);
        mkdir(fragment_domain + DirSep + "root");
        writeJson(fragment_domain + DirSep + "root" + DirSep
                + "OwnerOne.json", catalogs{domain});
        writeJson(fragment_domain + DirSep + "root" + DirSep
                + "OwnerTwo.json", catalogs{domain});
        mkdir(fragment_domain + DirSep + "cs");
        string fragment_translation = fragment_domain + DirSep + "cs"
            + DirSep + "OwnerOne.json";
        writeJson(fragment_translation, {
            "schema_version": I18n::get_catalog_schema_version(),
            "locales": {"cs": {"messages": {
                id: {"source": source, "message": source},
            }}},
        });
        assertEq(0, runCatalogTreeCheck(root, qore_bin, fragment_output),
            "catalog-tree verification composes owner-qualified root and translation fragments");
        writeJson(fragment_translation, {
            "schema_version": I18n::get_catalog_schema_version(),
            "locales": {"cs": {"messages": {
                id: {"source": "outdated", "message": source},
            }}},
        });
        assertEq(2, runCatalogTreeCheck(root, qore_bin, fragment_output),
            "catalog-tree verification rejects stale owner-qualified translations");
        writeJson(fragment_translation, {
            "schema_version": I18n::get_catalog_schema_version(),
            "locales": {"cs": {"messages": {
                id: {"source": source, "message": source},
            }}},
        });
        hash<auto> conflicting_root = catalogs{domain};
        conflicting_root.locales.root.messages{id}.source = "conflicting";
        writeJson(fragment_domain + DirSep + "root" + DirSep
                + "OwnerTwo.json", conflicting_root);
        assertEq(2, runCatalogTreeCheck(root, qore_bin, fragment_output),
            "catalog-tree verification rejects conflicting root owner fragments");

        string split_output = make_tmp_dir(
            "data-provider-i18n-split-domain-check-");
        on_exit remove_tree(split_output);
        list<string> split_ids = sort(keys
            catalogs{domain}.locales.root.messages);
        hash<auto> first_root = {
            "schema_version": I18n::get_catalog_schema_version(),
            "locales": {"root": {"messages": {
                split_ids[0]: catalogs{domain}.locales.root.messages
                    {split_ids[0]},
            }}},
        };
        hash<auto> second_root = {
            "schema_version": I18n::get_catalog_schema_version(),
            "locales": {"root": {"messages": {
                split_ids[1]: catalogs{domain}.locales.root.messages
                    {split_ids[1]},
            }}},
        };
        string first_search_root = split_output + DirSep
            + "OwnerOne/i18n";
        string second_search_root = split_output + DirSep
            + "OwnerTwo/i18n";
        mkdir_ex(first_search_root + DirSep + domain, 0755, True);
        mkdir_ex(second_search_root + DirSep + domain, 0755, True);
        writeJson(first_search_root + DirSep + domain + DirSep
                + "root.json", first_root);
        writeJson(second_search_root + DirSep + domain + DirSep
                + "root.json", second_root);
        writeJson(first_search_root + DirSep + domain + DirSep + "cs.json", {
            "schema_version": I18n::get_catalog_schema_version(),
            "locales": {"cs": {"messages": {
                split_ids[0]: {
                    "source": first_root.locales.root.messages
                        {split_ids[0]}.source,
                    "message": first_root.locales.root.messages
                        {split_ids[0]}.source,
                },
            }}},
        });
        writeJson(second_search_root + DirSep + domain + DirSep + "cs.json", {
            "schema_version": I18n::get_catalog_schema_version(),
            "locales": {"cs": {"messages": {
                split_ids[1]: {
                    "source": second_root.locales.root.messages
                        {split_ids[1]}.source,
                    "message": second_root.locales.root.messages
                        {split_ids[1]}.source,
                },
            }}},
        });
        assertEq(0, runCatalogTreeCheck(root, qore_bin, split_output,
                False, True),
            "complete-locale verification merges disjoint translations from "
                "every source owner of one domain");

        writeJson(output + DirSep + domain + DirSep + "cs.json", {
            "schema_version": I18n::get_catalog_schema_version(),
            "locales": {"cs": {"messages": {
                "removed.message": {
                    "source": "Removed", "message": "Odstraněno",
                },
            }}},
        });
        assertEq(2, runCatalogCheck(root, qore_bin, output),
            "a translation for a removed message id fails verification");
        assertEq(2, runSourceCatalogTreeCheck(root, qore_bin, output,
                ("DataProvider",)),
            "source-tree verification rejects removed message ids");
    }

    private int runCatalogCheck(string root, string qore_bin,
            string output) {
        list<string> module_path = (
            root + DirSep + "build/modules/i18n",
            root + DirSep + "build/modules/json",
            root + DirSep + "qlib"
        );
        if (exists ENV.QORE_MODULE_DIR) {
            module_path += ENV.QORE_MODULE_DIR;
        }
        return system(sprintf(
            "QORE_MODULE_DIR=%s LD_LIBRARY_PATH=%s %s %s -C --check -o %s -a Qore >/dev/null",
            shellQuote(module_path.join(PathSep)),
            shellQuote(ENV.LD_LIBRARY_PATH ?? (root + DirSep + "build")),
            shellQuote(qore_bin),
            shellQuote(root + DirSep + "bin/qore-data-provider-i18n"),
            shellQuote(output)));
    }

    private int runCatalogTreeCheck(string root, string qore_bin,
            string output, bool require_standard_locales = False,
            bool require_complete_locales = False) {
        list<string> module_path = (
            root + DirSep + "build/modules/i18n",
            root + DirSep + "build/modules/json",
            root + DirSep + "qlib"
        );
        if (exists ENV.QORE_MODULE_DIR) {
            module_path += ENV.QORE_MODULE_DIR;
        }
        return system(sprintf(
            "QORE_MODULE_DIR=%s LD_LIBRARY_PATH=%s %s %s -C --check-tree -o %s %s %s >/dev/null",
            shellQuote(module_path.join(PathSep)),
            shellQuote(ENV.LD_LIBRARY_PATH ?? (root + DirSep + "build")),
            shellQuote(qore_bin),
            shellQuote(root + DirSep + "bin/qore-data-provider-i18n"),
            shellQuote(output), require_standard_locales
                ? "--require-standard-locales" : "",
            require_complete_locales
                ? "--require-complete-locales" : ""));
    }

    private int runOwnerCatalogCheck(string root, string qore_bin,
            string output, string owner, list<string> modules) {
        list<string> module_path = (
            root + DirSep + "build/modules/i18n",
            root + DirSep + "build/modules/json",
            root + DirSep + "qlib"
        );
        if (exists ENV.QORE_MODULE_DIR) {
            module_path += ENV.QORE_MODULE_DIR;
        }
        list<string> module_args = map "--module " + shellQuote($1),
            modules;
        return system(sprintf(
            "QORE_MODULE_DIR=%s LD_LIBRARY_PATH=%s %s %s -C --check -o %s --owner %s %s >/dev/null",
            shellQuote(module_path.join(PathSep)),
            shellQuote(ENV.LD_LIBRARY_PATH ?? (root + DirSep + "build")),
            shellQuote(qore_bin),
            shellQuote(root + DirSep + "bin/qore-data-provider-i18n"),
            shellQuote(output), shellQuote(owner),
            module_args.join(" ")));
    }

    private int runSourceCatalogTreeCheck(string root, string qore_bin,
            string output, list<string> modules,
            bool require_standard_locales = False,
            bool require_complete_locales = False) {
        list<string> module_path = (
            root + DirSep + "qlib",
            output,
            root + DirSep + "build/modules/i18n",
            root + DirSep + "build/modules/json"
        );
        if (exists ENV.QORE_MODULE_DIR) {
            module_path += ENV.QORE_MODULE_DIR;
        }
        list<string> owner_args = map "--owner " + shellQuote($1),
            modules;
        return system(sprintf(
            "QORE_MODULE_DIR=%s LD_LIBRARY_PATH=%s %s %s -C --check-source-tree -o %s %s %s %s >/dev/null",
            shellQuote(module_path.join(PathSep)),
            shellQuote(ENV.LD_LIBRARY_PATH ?? (root + DirSep + "build")),
            shellQuote(qore_bin),
            shellQuote(root + DirSep + "bin/qore-data-provider-i18n"),
            shellQuote(output), owner_args.join(" "),
            require_standard_locales ? "--require-standard-locales" : "",
            require_complete_locales
                ? "--require-complete-locales" : ""));
    }

    private int runSourceCatalogTreeUpdate(string root, string qore_bin,
            string output, list<string> modules) {
        list<string> module_path = (
            root + DirSep + "qlib",
            output,
            root + DirSep + "build/modules/i18n",
            root + DirSep + "build/modules/json"
        );
        if (exists ENV.QORE_MODULE_DIR) {
            module_path += ENV.QORE_MODULE_DIR;
        }
        list<string> owner_args = map "--owner " + shellQuote($1),
            modules;
        return system(sprintf(
            "QORE_MODULE_DIR=%s LD_LIBRARY_PATH=%s %s %s -C --update-source-tree -o %s %s >/dev/null",
            shellQuote(module_path.join(PathSep)),
            shellQuote(ENV.LD_LIBRARY_PATH ?? (root + DirSep + "build")),
            shellQuote(qore_bin),
            shellQuote(root + DirSep + "bin/qore-data-provider-i18n"),
            shellQuote(output), owner_args.join(" ")));
    }

    checkedInLocaleCatalogTest() {
        string catalog_root = sourceRoot() + DirSep
            + "qlib/DataProvider/i18n";
        hash<auto> qore_app = DataProviderActionCatalog::getAppEx("Qore");
        hash<auto> histogram;
        foreach hash<auto> candidate in (
                DataProviderActionCatalog::getActions("Qore", False)) {
            if (candidate.action == "histogram") {
                histogram = candidate;
                break;
            }
        }
        assertTrue(histogram.toBool(),
            "the built-in histogram action is registered");

        DataProviderPresentationCatalog catalog(
            DataProviderPresentation::defaultCatalogDomain("Qore"), "ja", {
                "search_path": (catalog_root,),
            });
        hash<auto> action = catalog.projectAction(qore_app, histogram);
        assertEq("値の範囲を集計", action.display_name,
            "the provider action uses its source-owned Japanese catalog");
        assertEq("histogram", action.action,
            "localized action presentation preserves technical identity");
        assertFalse(exists action.presentation_incomplete,
            "the checked-in Japanese action presentation is complete");

        foreach hash<auto> option_entry in (
                histogram.options.pairIterator()) {
            hash<auto> projected_option = catalog.projectOption(qore_app,
                histogram, option_entry.key, option_entry.value);
            assertFalse(exists projected_option.presentation_incomplete,
                sprintf("the checked-in Japanese %s option presentation is complete",
                    option_entry.key));
        }

        hash<auto> option = catalog.projectOption(qore_app, histogram,
            "bin_method", histogram.options.bin_method);
        assertEq("ビン分割方法", option.display_name,
            "the provider option uses its source-owned Japanese catalog");
        hash<auto> allowed_value = catalog.projectAllowedValue(qore_app,
            histogram, "bin_method",
            histogram.options.bin_method.allowed_values[0]);
        assertEq(histogram.options.bin_method.allowed_values[0].value,
            allowed_value.value,
            "localized allowed-value presentation preserves its exact value");
        assertTrue(inlist(allowed_value.display_name,
                ("均等（等幅ビン）", "分位（等頻度ビン）")),
            "the allowed value uses its source-owned Japanese catalog");

        DataProviderPresentationCatalog portuguese_catalog(
            DataProviderPresentation::defaultCatalogDomain("Qore"),
            "pt-BR", {"search_path": (catalog_root,)});
        hash<auto> portuguese_action = portuguese_catalog.projectAction(
            qore_app, histogram);
        assertEq("Contar intervalos de valores",
            portuguese_action.display_name,
            "a regional request uses a provider-owned base-locale catalog");
        assertEq("pt-BR", portuguese_action.presentation_language,
            "the provider projection preserves the requested locale");
        assertTrue(portuguese_action.presentation_incomplete,
            "a deliberately partial provider locale reports incompleteness");
    }

    missingTranslationTest() {
        string root = writeCatalog();
        on_exit remove_tree(root);
        DataProviderPresentationCatalog catalog(Domain, "sk",
            {"search_path": (root,)});
        hash<auto> projected = catalog.projectAction(app(), action());
        assertEq(Action, projected.display_name,
            "missing display text falls back to exact technical identity");
        assertEq("", projected.short_desc,
            "source prose is withheld from a different requested language");
        assertEq("", projected.desc,
            "a cognate language does not authorize source-prose reuse");
        assertTrue(projected.presentation_incomplete);
        assertEq("sk", projected.presentation_language);
        assertEq("Odeslat zprávu",
            projected.producer_presentation.display_name,
            "opaque producer presentation remains available separately");

        hash<auto> complex = catalog.projectAllowedValue(app(), action(),
            Option, {
                "value": {"opaque": True},
                "display_name": "Složitá hodnota",
                "short_desc": "Popis složité hodnoty",
                "desc": "Dlouhý popis složité hodnoty.",
            });
        assertEq({"opaque": True}, complex.value,
            "complex allowed-value identity is unchanged");
        assertEq("", complex.display_name,
            "complex values without stable catalog ids do not leak source prose");
        assertTrue(complex.presentation_incomplete,
            "untranslatable complex values are marked incomplete");
    }

    multilingualEmbeddingTest() {
        string root = make_tmp_dir("data-provider-presentation-embedding-");
        on_exit remove_tree(root);
        mkdir(root + DirSep + Domain);
        hash<string, hash<auto>> source_catalogs =
            DataProviderPresentation::buildSourceCatalogs(app(), (action(),));
        writeJson(root + DirSep + Domain + DirSep + "root.json",
            source_catalogs{Domain});
        mkdir(root + DirSep + Domain + DirSep + "ja");
        writeJson(root + DirSep + Domain + DirSep + "ja"
                + DirSep + "PresentationTest.json", {
            "schema_version": I18n::get_catalog_schema_version(),
            "locales": {"ja": {"messages": messages()}},
        });
        writeJson(root + DirSep + Domain + ".ar-EG.json", {
            "schema_version": I18n::get_catalog_schema_version(),
            "locales": {"ar-EG": {"messages": arabicMessages()}},
        });

        hash<auto> opts = {"search_path": (root,)};
        assertEq(("root", "ar-EG", "ja"),
            DataProviderPresentation::discoverCatalogLocales(Domain, opts),
            "locale discovery uses both native layouts without a locale list");

        DataProviderPresentationEmbeddingCatalog embedding(app(), opts);
        hash<auto> info = embedding.projectAction(action());
        assertEq("mul", info.embedding_language,
            "distinct source-owned translations mark the document multilingual");
        foreach string expected in ((App, Action, "Poštovní služba",
                "Odeslat zprávu", "メールサービス", "メッセージを送信",
                "خدمة البريد", "إرسال رسالة")) {
            assertTrue(info.embedding_text.find(expected) >= 0,
                sprintf("the embedding document contains %y", expected));
        }

        list<hash<auto>> documents =
            embedding.projectActionDocuments(action());
        assertEq(("cs-CZ", "ar-EG", "ja"),
            map $1.embedding_language, documents,
            "locale embedding documents keep producer-first deterministic order");
        hash<string, hash<auto>> documents_by_language;
        foreach hash<auto> document in (documents) {
            documents_by_language{document.embedding_language} = document;
            assertTrue(document.embedding_text.find(App) >= 0
                    && document.embedding_text.find(Action) >= 0,
                "every locale document retains exact provider identities");
        }
        assertTrue(documents_by_language{"cs-CZ"}.embedding_text.find(
                "Poštovní služba") >= 0
                && documents_by_language{"cs-CZ"}.embedding_text.find(
                    "メールサービス") < 0,
            "the producer document does not absorb translated presentation");
        assertTrue(documents_by_language.ja.embedding_text.find(
                "メールサービス") >= 0
                && documents_by_language.ja.embedding_text.find(
                    "خدمة البريد") < 0,
            "the Japanese document contains only Japanese presentation");
        assertTrue(documents_by_language{"ar-EG"}.embedding_text.find(
                "خدمة البريد") >= 0
                && documents_by_language{"ar-EG"}.embedding_text.find(
                    "Poštovní služba") < 0,
            "the Arabic document contains only Arabic presentation");

        hash<auto> bounded = embedding.projectAction(action(), 0);
        assertEq(-1, bounded.embedding_text.find(
                "Odešle zprávu přes vybraný účet."),
            "zero description characters omits producer long descriptions");
        assertTrue(bounded.embedding_text.find("Odešle jednu zprávu") >= 0,
            "bounding long descriptions preserves short descriptions");

        string root_only = make_tmp_dir(
            "data-provider-presentation-embedding-root-");
        on_exit remove_tree(root_only);
        mkdir(root_only + DirSep + Domain);
        writeJson(root_only + DirSep + Domain + DirSep + "root.json",
            source_catalogs{Domain});
        writeJson(root_only + DirSep + Domain + DirSep + "sk.json", {
            "schema_version": I18n::get_catalog_schema_version(),
            "locales": {"sk": {"messages": {}}},
        });
        DataProviderPresentationEmbeddingCatalog source_embedding(app(), {
            "search_path": (root_only,),
        });
        hash<auto> source_info = source_embedding.projectAction(action());
        assertEq("cs-CZ", source_info.embedding_language,
            "a catalog without usable translations declares its producer "
                "language");
        assertEq(-1, source_info.embedding_text.find("メールサービス"),
            "a source-only catalog does not invent translated text");
        assertEq(("cs-CZ",), map $1.embedding_language,
            source_embedding.projectActionDocuments(action()),
            "an empty locale catalog does not create a redundant vector");

        writeJson(root_only + DirSep + Domain + DirSep + "sk.json", {
            "schema_version": I18n::get_catalog_schema_version(),
            "locales": {"sk": {"messages": {
                DataProviderPresentation::actionMessageId(App, Action,
                    "short_desc"): {
                    "source": "Odešle jednu zprávu",
                    "message": "Odešle jednu zprávu",
                },
            }}},
        });
        DataProviderPresentationEmbeddingCatalog cognate_embedding(app(), {
            "search_path": (root_only,),
        });
        list<hash<auto>> cognate_documents =
            cognate_embedding.projectActionDocuments(action());
        assertEq(("cs-CZ", "sk"), map $1.embedding_language,
            cognate_documents,
            "an explicitly translated cognate keeps its own locale vector");
        assertTrue(cognate_documents[1].embedding_text.find(
                "Odešle jednu zprávu") >= 0,
            "identical cognate text is retained without lexical rejection");

        assertThrows("DATA-PROVIDER-PRESENTATION-EMBEDDING-ERROR", sub () {
            embedding.projectAction(action(), -1);
        }, NOTHING, "negative description bounds are rejected");
        assertThrows("DATA-PROVIDER-PRESENTATION-EMBEDDING-ERROR", sub () {
            embedding.projectAction(action() + {"app": "別のアプリ"});
        }, NOTHING, "cross-app action records are rejected");
    }

    private string shellQuote(string value) {
        return "'" + replace(value, "'", "'\"'\"'") + "'";
    }
}
