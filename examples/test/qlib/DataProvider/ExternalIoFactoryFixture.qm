# -*- mode: qore; indent-tabs-mode: nil -*-
# ExternalIoFactoryFixture.qm registers a factory, and an app with external I/O that is not sandbox-aware, for AppExternalIo.qtest

# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern

%requires DataProvider >= 3.12

module ExternalIoFactoryFixture {
    version = "1.0";
    desc = "external I/O factory fixture: not sandbox-aware";
    author = "Qore Technologies";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        DataProvider::registerFactory(new ExternalIoFixtureFactory());
        DataProviderActionCatalog::registerApp(cast<hash<DataProviderAppInfo>>({
            "name": "QoreTestExternalIoFactoryApp",
            "display_name": "QoreTestExternalIoFactoryApp",
            "short_desc": "external I/O factory fixture",
            "desc": "external I/O factory fixture",
            "groups": (AppGroup::DataTransformation,),
            "logo": "fixture",
            "logo_mime_type": "image/svg+xml",
            "logo_file_name": "fixture.svg",
        } + {"external_io": True}));
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": "QoreTestExternalIoFactoryApp",
            "action": "run",
            "path": "/run",
            "display_name": "run",
            "short_desc": "external I/O factory fixture action",
            "desc": "external I/O factory fixture action",
            "action_code": DPAT_API,
            "cls": "ExternalIoFixtureProvider",
            "cls_mod": get_module_context_path(),
            "output_type": AbstractDataProviderType::get(AutoHashType),
        });
    };
}

#! The fixture's data provider
public class ExternalIoFixtureProvider inherits AbstractDataProvider {
    public {
        const ProviderInfo = <DataProviderInfo>{
            "type": "ExternalIoFixtureProvider",
            "supports_request": True,
        };
    }

    constructor(*hash<auto> options) {
    }

    string getName() {
        return "ExternalIoFixtureProvider";
    }

    *string getDesc() {
        return "external I/O factory fixture provider";
    }

    private hash<DataProviderInfo> getStaticInfoImpl() {
        return ProviderInfo;
    }
}

#! The fixture's factory: it belongs to this module, which registers the app
public class ExternalIoFixtureFactory inherits AbstractDataProviderFactory {
    private {
        static Class cls = new Class("ExternalIoFixtureProvider");

        const FactoryInfo = <DataProviderFactoryInfo>{
            "name": "qoretestexternalio",
            "desc": "external I/O factory fixture",
        };
    }

    private hash<DataProviderFactoryInfo> getInfoImpl() {
        return FactoryInfo;
    }

    private hash<DataProviderInfo> getProviderInfoImpl() {
        return ExternalIoFixtureProvider::ProviderInfo;
    }

    private Class getClassImpl() {
        return cls;
    }
}
