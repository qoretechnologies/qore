#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%prepend-module-path "${SCRIPT_DIR}"
%requires Util
%requires QUnit
%requires FsUtil
%requires Logger
%requires Mime
%requires DataProvider
%requires ProviderIndex

%try-module yaml
%define NoYaml
%endtry

%exec-class ProviderIndexInitializationFailureTest

#! Verifies that provider-index construction cannot certify a partial catalog after registration failures
public class ProviderIndexInitializationFailureTest inherits QUnit::Test {
    constructor() : Test("ProviderIndex initialization failures", "1.0") {
        addTestCase("structured deferred failure blocks repeated discovery", \deferredFailureTest());
        addTestCase("reported eager failure is filtered and retained", \eagerFailureTest());
        addTestCase("environment source failures remain visible and retryable", \environmentFailureTest());
        addTestCase("environment provider failures remain visible and retryable",
            \environmentProviderFailureTest());
        set_return_value(main());
    }

    private checkModules() {
%ifdef NoYaml
        testSkip("no yaml module");
%endif
    }

    private registerTestApp(string app) {
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": app,
            "display_name": app,
            "short_desc": "initialization failure test",
            "desc": "initialization failure test",
            "groups": (AppGroup::DataTransformation,),
            "logo": "data",
            "logo_mime_type": MimeTypeSvg,
            "logo_file_name": "test.svg",
            "dynamic": True,
        });
    }

    private hash<ExceptionInfo> createIndexExpectingFailure(string app, string dir) {
        try {
            ProviderIndex::createDataProviderIndex(<DataProviderIndexInfo>{}, dir, <ProviderIndexCreateOptions>{
                "load_known_factories": False,
                "load_environment": False,
                "load_typescript_actions": False,
                "apps": (app,),
            });
            fail("provider index creation must reject an incomplete catalog");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("DATA-PROVIDER-DISCOVERY-ERROR", ex.err,
                sprintf("provider index exception: %y", ex));
            return ex;
        }
        throw "TEST-ERROR", "provider index creation unexpectedly succeeded";
    }

    private checkFailure(hash<ExceptionInfo> ex, string kind, string app, *string action, string error,
            string description, auto argument) {
        hash<DataProviderDiscoveryReportInfo> report = ex.arg;
        assertFalse(report.complete, "failed discovery report is not complete");
        hash<string, bool> expected_apps = map {$1.app: True},
            report.expected.iterator();
        assertEq((app,), sort(keys expected_apps),
            "the report preserves only the selected expected app scope");
        list<hash<DataProviderDiscoveryFailureInfo>> selected = map $1,
            report.failures, $1.kind == kind && $1.app == app
                && $1.action == action && $1.error == error;
        assertEq(1, selected.size(),
            "the selected structured failure is reported once");
        hash<DataProviderDiscoveryFailureInfo> failure = selected[0];
        assertEq(kind, failure.kind);
        assertEq(app, failure.app);
        assertEq(action, failure.action);
        assertEq(error, failure.error);
        assertEq(description, failure.description);
        assertEq(argument, failure.argument);
        list<hash<DataProviderDiscoveryFailureInfo>> publication_failures
            = map $1, report.failures,
                $1.error == "DATA-PROVIDER-MODULE-PATH-MISSING";
        assertEq(1, publication_failures.size(),
            "publication qualification also reports the missing owner path");
    }

    private deferredFailureTest() {
        checkModules();

        string app = "DeferredFailure_" + get_random_string(8);
        registerTestApp(app);
        on_exit DataProviderActionCatalog::deregisterDynamicApp(app);

        DataProviderActionCatalog::registerPendingAppAction(app, "broken-action", sub () {
            throw "DEFERRED-REGISTRATION-ERROR", "synthetic deferred action failure", {"state": "deferred"};
        });

        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        hash<ExceptionInfo> first = createIndexExpectingFailure(app, dir);
        checkFailure(first, "action", app, "broken-action", "DEFERRED-REGISTRATION-ERROR",
            "synthetic deferred action failure", {"state": "deferred"});
        assertFalse(is_readable(join_paths(dir, "qore-routing-index.yaml")),
            "an incomplete index is not written");

        # The pending callback is consumed on the first attempt, so only retained structured state can make the
        # second discovery fail as well.
        hash<ExceptionInfo> second = createIndexExpectingFailure(app, dir);
        checkFailure(second, "action", app, "broken-action", "DEFERRED-REGISTRATION-ERROR",
            "synthetic deferred action failure", {"state": "deferred"});

        # A successful replacement of the same technical identity clears the retained failure.
        DataProviderActionCatalog::registerPendingAppAction(app, "broken-action", sub () {
            DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
                "app": app,
                "action": "broken-action",
                "path": "/broken-action",
                "display_name": "Recovered action",
                "short_desc": "recovered action",
                "desc": "recovered action",
                "action_code": DPAT_API,
            });
        });
        DataProviderActionCatalog::getActions(app, False);
        assertEq((), DataProviderActionCatalog::getInitializationFailures((app,)),
            "successful replacement clears the failure");
    }

    private eagerFailureTest() {
        checkModules();

        string app = "EagerFailure_" + get_random_string(8);
        registerTestApp(app);
        on_exit DataProviderActionCatalog::deregisterDynamicApp(app);

        try {
            throw "EAGER-REGISTRATION-ERROR", "synthetic eager action failure", {"state": "eager"};
        } catch (hash<ExceptionInfo> ex) {
            # Eager integrations report before rethrowing; TypeScriptActionInterface uses this path.
            DataProviderActionCatalog::reportInitializationFailure("action", app, "eager-action", ex,
                "/test/eager-provider.qm");
        }

        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        checkFailure(createIndexExpectingFailure(app, dir), "action", app, "eager-action",
            "EAGER-REGISTRATION-ERROR", "synthetic eager action failure", {"state": "eager"});

        assertEq((), DataProviderActionCatalog::getInitializationFailures(("UnrelatedApp",)),
            "scoped discovery ignores failures outside its selected applications");
        list<hash<DataProviderInitializationFailureInfo>> failures
            = DataProviderActionCatalog::getInitializationFailures((app,));
        assertEq("/test/eager-provider.qm", failures[0].module_context,
            "the provider module identity is retained");
    }

    private environmentFailureTest() {
        checkModules();

        string env_name = "QORE_DATA_PROVIDERS";
        *string old_value = getenv(env_name);
        auto old_env_value = ENV{env_name};
        string module_name = "MissingDiscoveryModule_" + get_random_string(8);
        setenv(env_name, module_name);
        ENV{env_name} = module_name;
        on_exit {
            if (old_value) {
                setenv(env_name, old_value);
            } else {
                unsetenv(env_name);
            }
            if (exists old_env_value) {
                ENV{env_name} = old_env_value;
            } else {
                remove ENV{env_name};
            }
        }

        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        for (int i = 0; i < 2; ++i) {
            try {
                ProviderIndex::createDataProviderIndex(<DataProviderIndexInfo>{}, dir,
                    <ProviderIndexCreateOptions>{
                        "load_known_factories": False,
                        "load_environment": True,
                        "load_typescript_actions": False,
                    });
                fail("provider index creation must reject a failed environment source");
            } catch (hash<ExceptionInfo> ex) {
                assertEq("DATA-PROVIDER-DISCOVERY-ERROR", ex.err,
                    sprintf("provider index exception: %y", ex));
                hash<DataProviderDiscoveryReportInfo> report = ex.arg;
                list<hash<DataProviderDiscoveryFailureInfo>> failures = map $1,
                    report.failures, $1.kind == "source"
                        && $1.phase == "registration-module"
                        && $1.identity == module_name;
                assertEq(1, failures.size(),
                    "the failed environment registration module is reported once on attempt " + (i + 1));
                assertEq(module_name, failures[0].module_context,
                    "the exact failing module is retained as source context");
                assertTrue(failures[0].error.val(),
                    "the original loader error code is retained");
                assertTrue(failures[0].description.val(),
                    "the original loader description is retained");
            }
            assertFalse(is_readable(join_paths(dir, "qore-routing-index.yaml")),
                "a source failure cannot publish an index on attempt " + (i + 1));
        }
    }

    private environmentProviderFailureTest() {
        checkModules();

        string env_name = "QORE_DATA_PROVIDERS";
        *string old_value = getenv(env_name);
        auto old_env_value = ENV{env_name};
        string fixture_env_name = "QORE_PROVIDER_INDEX_FIXTURE_MODULE";
        *string old_fixture_value = getenv(fixture_env_name);
        auto old_fixture_env_value = ENV{fixture_env_name};
        string registration_module = "ProviderIndexEnvironmentMapFixture";
        string provider_root = make_tmp_dir();
        on_exit remove_tree(provider_root);
        string provider_module = join_paths(provider_root,
            "ProviderIndexRecoveredProviderFixture.qm");
        setenv(env_name, registration_module);
        ENV{env_name} = registration_module;
        setenv(fixture_env_name, provider_module);
        ENV{fixture_env_name} = provider_module;
        on_exit {
            if (old_value) {
                setenv(env_name, old_value);
            } else {
                unsetenv(env_name);
            }
            if (exists old_env_value) {
                ENV{env_name} = old_env_value;
            } else {
                remove ENV{env_name};
            }
            if (old_fixture_value) {
                setenv(fixture_env_name, old_fixture_value);
            } else {
                unsetenv(fixture_env_name);
            }
            if (exists old_fixture_env_value) {
                ENV{fixture_env_name} = old_fixture_env_value;
            } else {
                remove ENV{fixture_env_name};
            }
        }

        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        for (int i = 0; i < 2; ++i) {
            try {
                ProviderIndex::createDataProviderIndex(
                    <DataProviderIndexInfo>{}, dir,
                    <ProviderIndexCreateOptions>{
                        "load_known_factories": False,
                        "load_environment": True,
                        "load_typescript_actions": False,
                    });
                fail("provider index creation must reject a failed environment provider module");
            } catch (hash<ExceptionInfo> ex) {
                assertEq("DATA-PROVIDER-DISCOVERY-ERROR", ex.err,
                    sprintf("provider index exception: %y", ex));
                hash<DataProviderDiscoveryReportInfo> report = ex.arg;
                list<hash<DataProviderDiscoveryFailureInfo>> failures
                    = map $1, report.failures,
                        $1.kind == "source"
                            && $1.phase == "provider-module"
                            && $1.identity == provider_module;
                assertEq(1, failures.size(),
                    "the failed provider child is retried and reported once on attempt "
                        + (i + 1));
                assertEq(provider_module, failures[0].module_context);
            }
            assertFalse(is_readable(join_paths(dir,
                "qore-routing-index.yaml")),
                "a provider-module failure cannot publish an index on attempt "
                    + (i + 1));
        }

        File recovered_module();
        recovered_module.open2(provider_module,
            O_CREAT | O_EXCL | O_WRONLY, 0644);
        recovered_module.write("%modern\n\nmodule ProviderIndexRecoveredProviderFixture {\n"
            "    version = \"1.0\";\n"
            "    desc = \"provider discovery retry fixture\";\n"
            "    author = \"Qore Technologies\";\n"
            "    url = \"http://qore.org\";\n"
            "    license = \"MIT\";\n"
            "}\n");
        recovered_module.close();
        hash<auto> recovered = ProviderIndex::createDataProviderIndex(
            <DataProviderIndexInfo>{}, dir,
            <ProviderIndexCreateOptions>{
                "load_known_factories": False,
                "load_environment": True,
                "load_typescript_actions": False,
            });
        assertTrue(recovered.summary.qualification.complete,
            "the same failed environment provider is retried successfully after its dependency appears");
        assertTrue(is_readable(join_paths(dir, "qore-routing-index.yaml")),
            "the recovered discovery attempt can publish its qualified index");
    }
}
