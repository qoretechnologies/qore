%modern
%requires DataProvider

#! A provider presentation fixture whose action reaches one nested type through three options
/** Catalogs that identified a nested type per option and path have three messages for each of its texts; with the
    per-action identity they have one.  Used by the re-keying cases of Presentation.qtest.
*/
module PresentationRekeyOwner {
    version = "1.0";
    desc = "provider presentation fixture with a nested type reached through three options";
    author = "Qore Technologies";
    license = "MIT";
    init = sub () {
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": "QoreTestRekeyProvider",
            "display_name": "Rekey Provider",
            "short_desc": "Provider with a shared nested type",
            "desc": "Provider whose options share a nested type",
            "presentation_source_locale": "en",
            "groups": (AppGroup::DataTransformation,),
            "logo": "data",
            "logo_mime_type": MimeTypeSvg,
            "logo_file_name": "rekey-provider.svg",
        });

        HashDataType address("RekeyAddress", {
            "city": new QoreDataField(<auto>{
                "name": "city",
                "display_name": "City",
                "short_desc": "The city of the address",
                "type": new QoreStringDataType(),
            }),
            "street": new QoreDataField(<auto>{
                "name": "street",
                "display_name": "Street",
                "type": new QoreStringDataType(),
            }),
        });
        QoreDataField sender("sender", "Sender", new HashDataType("RekeySender", {
            "address": new QoreDataField("address", "Address", address),
        }));
        QoreDataField recipient("recipient", "Recipient", new HashDataType("RekeyRecipient", {
            "address": new QoreDataField("address", "Address", address),
        }));
        QoreDataField courier("courier", "Courier", new HashDataType("RekeyCourier", {
            "address": new QoreDataField("address", "Address", address),
        }));

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": "QoreTestRekeyProvider",
            "path": "/send",
            "action": "send",
            "display_name": "Send",
            "short_desc": "Sends a letter",
            "desc": "Sends a letter from the sender to the recipient",
            "action_code": DPAT_API,
            "output_type": new QoreHashDataType(),
            "options": DataProviderActionCatalog::getActionOptionFromFields({
                "sender": sender,
                "recipient": recipient,
                "courier": courier,
            }),
        });
    };
}
