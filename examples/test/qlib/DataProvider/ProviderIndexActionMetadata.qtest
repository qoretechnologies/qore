#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright 2026 Qore Technologies, s.r.o. SPDX-License-Identifier: MIT

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires FsUtil
%requires DataProvider
%requires ProviderIndexUtil
%requires json

%try-module yaml
%define NoYaml
%endtry

%exec-class ProviderIndexActionMetadataTest

public class ProviderIndexActionMetadataTest inherits QUnit::Test {
    private {
        # an index written by the current version
        const CurrentApp = "QoreTestCurrentApp";
        # an index written before ProviderIndex 1.2, with primitive type names
        const LegacyApp = "QoreTestLegacyApp";
        # an index written by an unreleased development version, with serialized types
        const SerializedApp = "QoreTestSerializedApp";
        const RemovedApp = "QoreTestRemovedApp";
        const CachedApp = "QoreTestCachedApp";

        const ConnectionAlternative = {
            "connection_alternative": {
                "option": "webhook",
                "required_group": "test-destination",
            },
        };
    }

    constructor() : Test("ProviderIndex action metadata test", "1.0") {
        addTestCase("indexed actions describe option types with plain data", \currentFormat());
        addTestCase("primitive type names from earlier indexes are described", \legacyFormat());
        addTestCase("serialized types from development versions are not restored", \serializedFormat());
        addTestCase("indexed data provider info describes types with plain data", \dataProviderInfo());
        addTestCase("a removed app has no actions", \removedAppHasNoActions());
        addTestCase("a registered action is cached as an indexed action", \registeredActionIsIndexed());
        addTestCase("reading the index returns indexed actions", \readIndex());

%ifndef NoYaml
        string dir = make_tmp_dir();
        on_exit remove_tree(dir);

        bool had_env = exists ENV{ProviderIndexEnvVar};
        string old_env = had_env ? ENV{ProviderIndexEnvVar} : "";
        on_exit {
            if (had_env) {
                ProviderIndexUtil::setEnvironmentVariable(old_env);
            } else {
                unsetenv(ProviderIndexEnvVar);
                remove ENV{ProviderIndexEnvVar};
            }
        }

        ProviderIndexUtil::setEnvironmentVariable(dir);
        writeIndex();
%endif

        set_return_value(main());
    }

    private checkModules() {
%ifdef NoYaml
        testSkip("no yaml module");
%endif
    }

    #! Returns the option type used by the test actions
    private static HashDataType getOptionType() {
        HashDataType type("QoreTestIndexedType");
        type.addQoreFields({
            "value": {"name": "value", "type": AbstractDataProviderTypeMap."string"},
            "count": {"name": "count", "type": AbstractDataProviderTypeMap."*int"},
        });
        return type;
    }

    #! Writes an index with apps in each format
    private writeIndex() {
        HashDataType type = getOptionType();

        hash<string, hash<auto>> appinfomap = map {$1: {"name": $1}},
            (CurrentApp, LegacyApp, SerializedApp, RemovedApp, CachedApp);
        hash<string, hash<string, hash<auto>>> actioninfomap = {
            CurrentApp: {
                "send": {
                    "app": CurrentApp,
                    "action": "send",
                    "short_desc": "send a message",
                    "options": {
                        "webhook": {
                            "display_name": "Webhook",
                            "short_desc": "webhook destination",
                            "type_info": type.getInfo(),
                        },
                    },
                    "metadata": ConnectionAlternative,
                    # as written by ProviderIndex: each type by its base type name
                    "data_provider_info": {
                        "name": "send",
                        "display_name": "Send",
                        "type": "QoreTestDataProvider",
                        "supports_read": True,
                        "search_options": {
                            "limit": {
                                "display_name": "Limit",
                                "short_desc": "the maximum number of records",
                                "desc": "the maximum number of records",
                                "type": ("int",),
                            },
                        },
                        "create_options": {},
                        "expressions": {
                            "==": DataProviderGenericExpressions."==" + {
                                "args": (map $1 + {"type": $1.type.getBaseTypeName()},
                                    DataProviderGenericExpressions."==".args),
                                "return_type": DataProviderGenericExpressions."==".return_type.getBaseTypeName(),
                            },
                        },
                        "events": {
                            "changed": {"desc": "a record changed", "type": "hash"},
                        },
                    },
                },
            },
            LegacyApp: {
                "send": {
                    "app": LegacyApp,
                    "action": "send",
                    "options": {
                        "subject": {
                            "display_name": "Subject",
                            "type": "string",
                        },
                    },
                },
            },
            SerializedApp: {
                "send": {
                    "app": SerializedApp,
                    "action": "send",
                    # output types from earlier indexes are ignored
                    "output_type": type.serialize(),
                    "options": {
                        "webhook": {
                            "display_name": "Webhook",
                            "type": type.serialize(),
                        },
                    },
                },
            },
            RemovedApp: {
                "send": {"app": RemovedApp, "action": "send"},
            },
        };

        ProviderIndexUtil::writeDataProviderIndex(<DataProviderIndexInfo>{
            "factorymap": {},
            "appmap": {},
            "schememap": {},
            "appinfomap": appinfomap,
            "actioninfomap": actioninfomap,
            "top_actioninfomap": {},
        }, 0s, {});
    }

    currentFormat() {
        checkModules();

        *list<hash<auto>> actions = ProviderIndexUtil::tryGetActionMetadataForApp(CurrentApp);
        assertEq(1, actions.size());
        hash<auto> action = actions[0];
        assertEq("hash<DataProviderIndexedActionInfo>", action.fullType());
        assertEq(ConnectionAlternative, action.metadata);
        assertEq("hash<IndexedActionOptionInfo>", action.options.webhook.fullType());
        assertEq("webhook destination", action.options.webhook.short_desc);

        # the type description is typed at every level
        hash<DataTypeInfo> type_info = action.options.webhook.type_info;
        assertEq("hash<DataTypeInfo>", type_info.fullType());
        assertEq("hash<DataFieldInfo>", type_info.fields.value.fullType());
        assertEq("hash<DataTypeInfo>", type_info.fields.value.type.fullType());
        assertEq(getOptionType().getInfo().fields.count.type.name, type_info.fields.count.type.name);

        # a type object with the described structure can be created from the description
        AbstractDataProviderType type = AbstractDataProviderType::get(type_info);
        assertEq({"value": "x"}, type.acceptsValue({"value": "x"}));
        assertThrows("RUNTIME-TYPE-ERROR", sub () { type.acceptsValue({"value": "x", "count": "not a number"}); });

        assertEq(action, ProviderIndexUtil::tryGetActionMetadata(CurrentApp, "send"));
        assertEq(NOTHING, ProviderIndexUtil::tryGetActionMetadata(CurrentApp, "unknown"));
        assertEq(NOTHING, ProviderIndexUtil::tryGetActionMetadataForApp("QoreTestUnknownApp"));
    }

    legacyFormat() {
        checkModules();

        hash<auto> action = ProviderIndexUtil::tryGetActionMetadata(LegacyApp, "send");
        assertEq("string", action.options.subject.type_info.name);
        assertEq("hash<DataTypeInfo>", action.options.subject.type_info.fullType());
    }

    serializedFormat() {
        checkModules();

        hash<auto> action = ProviderIndexUtil::tryGetActionMetadata(SerializedApp, "send");
        assertFalse(action.hasKey("output_type"));
        assertEq("auto", action.options.webhook.type_info.name);
    }

    dataProviderInfo() {
        checkModules();

        hash<auto> action = ProviderIndexUtil::tryGetActionMetadata(CurrentApp, "send");
        # an indexed action has no objects, so it can be serialized
        assertEq(action.action, parse_json(make_json(action)).action);

        hash<IndexedDataProviderInfo> info = action.data_provider_info;
        assertEq("hash<IndexedDataProviderInfo>", info.fullType());
        assertEq("QoreTestDataProvider", info.type);
        assertEq("hash<IndexedDataProviderOptionInfo>", info.search_options.limit.fullType());
        assertEq("hash<DataTypeInfo>", info.search_options.limit.type_info[0].fullType());
        assertEq("int", info.search_options.limit.type_info[0].name);
        assertEq({}, info.create_options);
        assertEq(NOTHING, info.upsert_options);

        hash<IndexedDataProviderExpressionInfo> eq = info.expressions."==";
        assertEq("hash<IndexedDataProviderExpressionInfo>", eq.fullType());
        assertEq(DataProviderGenericExpressions."==".symbol, eq.symbol);
        assertEq("hash<IndexedDataProviderSignatureTypeInfo>", eq.args[0].fullType());
        assertEq(DataProviderGenericExpressions."==".args[0].type_code, eq.args[0].type_code);
        assertEq("hash<DataTypeInfo>", eq.return_type_info.fullType());
        assertEq("bool", eq.return_type_info.base_type);

        assertEq("hash<IndexedDataProviderMessageInfo>", info.events.changed.fullType());
        assertEq("hash", info.events.changed.type_info.base_type);

        # the info with type objects is restored without any provider module
        hash<DataProviderInfo> restored = DataProvider::restoreIndexedInfo(info);
        assertEq("int", restored.search_options.limit.type[0].getName());
        assertEq(5, restored.search_options.limit.type[0].acceptsValue(5));
        assertEq("bool", restored.expressions."==".return_type.getBaseTypeName());
        assertEq("hash", restored.events.changed.type.getBaseTypeName());
    }

    removedAppHasNoActions() {
        checkModules();

        assertEq(1, ProviderIndexUtil::tryGetActionMetadataForApp(RemovedApp).size());
        assertTrue(ProviderIndexUtil::removeCachedApp(RemovedApp));
        assertEq(NOTHING, ProviderIndexUtil::tryGetActionMetadataForApp(RemovedApp));
        # loading the complete index must not bring back a removed app
        hash<string, bool> all = map {$1.app + "/" + $1.action: True}, ProviderIndexUtil::getAllCachedActions();
        assertTrue(all{CurrentApp + "/send"});
        assertEq(NOTHING, all{RemovedApp + "/send"});
        assertEq(NOTHING, ProviderIndexUtil::tryGetActionMetadataForApp(RemovedApp));
    }

    registeredActionIsIndexed() {
        checkModules();

        HashDataType output("QoreTestOutput");
        ProviderIndexUtil::addActionToCache(<DataProviderActionInfo>{
            "app": CachedApp,
            "action": "registered",
            "path": "/registered",
            "display_name": "Registered",
            "short_desc": "a registered action",
            "desc": "a registered action",
            "action_code": DPAT_API,
            "options": {
                "webhook": <ActionOptionInfo>{
                    "display_name": "Webhook",
                    "short_desc": "webhook destination",
                    "desc": "webhook destination",
                    "type": getOptionType(),
                },
            },
            "output_type": output,
            "input_data_types": {},
            "output_data_type": DPAD_NORMAL,
            "data_provider_info": <DataProviderInfo>{
                "name": "registered",
                "display_name": "Registered",
                "type": "QoreTestDataProvider",
                "search_options": {
                    "record": <DataProviderOptionInfo>{
                        "display_name": "Record",
                        "short_desc": "a record",
                        "desc": "a record",
                        "type": getOptionType(),
                    },
                },
                "expressions": DataProviderGenericExpressions{"==",},
            },
        });
        hash<auto> action = ProviderIndexUtil::tryGetActionMetadata(CachedApp, "registered");
        assertEq("hash<DataProviderIndexedActionInfo>", action.fullType());
        assertFalse(action.hasKey("output_type"));
        assertEq("QoreTestIndexedType", action.options.webhook.type_info.name);
        assertEq(action, ProviderIndexUtil::searchCachedActionSubstr("a registered action")[0]);

        # the registered action's data provider info is cached with its types described by plain data
        assertEq("hash<IndexedDataProviderInfo>", action.data_provider_info.fullType());
        assertEq("QoreTestIndexedType", action.data_provider_info.search_options.record.type_info[0].name);
        assertEq(("value", "count"), keys action.data_provider_info.search_options.record.type_info[0].fields);
        assertEq(DataProviderGenericExpressions."==".return_type.getInfo().name,
            action.data_provider_info.expressions."==".return_type_info.name);
        assertEq(action.action, parse_json(make_json(action)).action);
    }

    readIndex() {
        checkModules();

        hash<DataProviderIndexInfo> index = ProviderIndexUtil::readDataProviderIndex();
        assertEq("hash<DataProviderIndexedActionInfo>", index.actioninfomap{CurrentApp}.send.fullType());
        assertEq("QoreTestIndexedType", index.actioninfomap{CurrentApp}.send.options.webhook.type_info.name);
        assertEq("string", index.actioninfomap{LegacyApp}.send.options.subject.type_info.name);
        assertEq(index.actioninfomap{CurrentApp}.send, index.top_actioninfomap{CurrentApp + "/send"});
    }
}
