%modern
%requires DataProvider

#! A provider fixture whose deferred action registration fails, as an action script that cannot be opened does
/** The app is registered, but the registration of its actions raises an exception, which the data provider catalog
    retains as an initialization failure of the app.  Used by I18nFailClosed.qtest (qore#7788).
*/
module I18nFailingDeferredOwner {
    version = "1.0";
    desc = "provider fixture whose deferred action registration fails";
    author = "Qore Technologies";
    license = "MIT";
    init = sub () {
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": "QoreTestI18nFailingDeferred",
            "display_name": "Failing Deferred Provider",
            "short_desc": "Provider whose actions cannot be registered",
            "desc": "Provider whose deferred action registration fails",
            "presentation_source_locale": "en",
            "groups": (AppGroup::DataTransformation,),
            "logo": "data",
            "logo_mime_type": MimeTypeSvg,
            "logo_file_name": "failing-deferred-provider.svg",
        });
        DataProviderActionCatalog::registerLazyAppActions("QoreTestI18nFailingDeferred", sub () {
            throw "FILE-OPEN2-ERROR", "cannot open 'index.js': the action script of the fixture does not exist";
        });
    };
}
