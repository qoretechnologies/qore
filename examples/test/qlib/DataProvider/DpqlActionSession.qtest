%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/DataProvider
%requires reflection

%exec-class DpqlActionSessionTest

#! In-memory provider exposing a restricted server-side expression set, for push-down tests
class PushdownTestProvider inherits DataProvider::AbstractDataProvider {
    public {
        const ProviderInfo = <DataProviderInfo>{
            "type": "PushdownTestProvider",
            "supports_read": True,
            "supports_search_expressions": True,
        };
    }

    constructor(*hash<auto> options) {
    }

    string getName() {
        return "pushdown-test";
    }

    private *hash<string, AbstractDataField> getRecordTypeImpl(*hash<auto> search_options) {
        return {
            "name": new QoreDataField("name", "Name", AbstractDataProviderType::get(StringType)),
            "age": new QoreDataField("age", "Age", AbstractDataProviderType::get(IntType)),
        };
    }

    private hash<DataProviderInfo> getStaticInfoImpl() {
        # Equality and greater-than have native support; regex is exposed for client evaluation only.
        return <DataProviderInfo>{
            "type": "PushdownTestProvider",
            "supports_read": True,
            "supports_search_expressions": True,
            "expressions": {
                DP_SEARCH_OP_EQ: DataProviderGenericExpressions{DP_SEARCH_OP_EQ},
                DP_SEARCH_OP_GT: DataProviderGenericExpressions{DP_SEARCH_OP_GT},
                DP_OP_REGEX_MATCH: DataProviderGenericExpressions{DP_OP_REGEX_MATCH}
                    + {"supports_pushdown": False},
            },
        };
    }
}

#! Factory for PushdownTestProvider so it is resolvable via a DPQL provider spec
class PushdownTestFactory inherits DataProvider::AbstractDataProviderFactory {
    private {
        static Class cls = new Class("PushdownTestProvider");

        const FactoryInfo = <DataProviderFactoryInfo>{
            "name": "pushdown-test",
            "desc": "push-down test data provider factory",
        };
    }

    private hash<DataProviderFactoryInfo> getInfoImpl() {
        return FactoryInfo;
    }

    private hash<DataProviderInfo> getProviderInfoImpl() {
        return PushdownTestProvider::ProviderInfo;
    }

    private Class getClassImpl() {
        return cls;
    }
}

class DpqlActionSessionTest inherits QUnit::Test {
    constructor() : QUnit::Test("DpqlActionSession", "1.0") {
        ensureNullFactory();
        addTestCase("dpql-set-context", \testSetContext());
        addTestCase("dpql-parse with fields", \testParseWithFields());
        addTestCase("dpql-parse unknown field", \testParseUnknownField());
        addTestCase("dpql-parse validation warnings and errors", \testParseValidationSeverity());
        addTestCase("each diagnostic is reported once", \testDiagnosticsOnce());
        addTestCase("dpql-get-completions without context", \testCompletionsNoContext());
        addTestCase("dpql-get-completions", \testCompletions());
        addTestCase("dpql-validate with override", \testValidateOverride());
        addTestCase("dpql-completions with override", \testCompletionsOverride());
        addTestCase("dpql-get-tokens", \testTokenize());
        addTestCase("dpql-get-tokens operator and punctuation types", \testTokenTypes());
        addTestCase("dpql-get-tokens word types by position", \testWordTokenTypes());
        addTestCase("dpql-format invalid", \testFormatInvalid());
        addTestCase("dpql-serialize", \testSerialize());
        addTestCase("schema-aware key completions", \testSchemaAwareKeyCompletions());
        addTestCase("base expressions via constructor", \testBaseExpressionsConstructor());
        addTestCase("base expressions via setter", \testBaseExpressionsSetter());
        addTestCase("base expressions merged with context", \testBaseExpressionsMergedWithContext());
        addTestCase("signature help action", \testSignatureHelp());
        addTestCase("dpql-eval local", \testEvalLocal());
        addTestCase("dpql-eval collection operator", \testEvalCollectionOperator());
        addTestCase("dpql-eval parse error", \testEvalParseError());
        addTestCase("dpql-eval push-down", \testEvalPushdown());
        addTestCase("exists: token types, completions and push-down", \testExists());
        addTestCase("field completion of a key with a dot", \testDottedFieldCompletion());

        set_return_value(main());
    }

    private ensureNullFactory() {
        try {
            DataProvider::registerFactory(new DataProvider::NullDataProviderFactory());
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "PROVIDER-ERROR") {
                rethrow;
            }
        }
    }

    private DataProvider::DpqlActionSession newSession() {
        return new DataProvider::DpqlActionSession();
    }

    private hash<string, hash<auto>> getFieldInfo() {
        return {
            "name": {"type": "string", "desc": "Name"},
            "age": {"type": "int", "desc": "Age"},
        };
    }

    testSetContext() {
        DataProvider::DpqlActionSession session = newSession();
        hash<auto> result = session.handleAction("dpql-set-context", {
            "provider": "null{}",
        });
        assertEq("null{}", result.provider, "Provider should match request");
        assertEq("record", result.recordType, "Record type should be default");
        assertTrue(result.hasKey("fields"), "Context should include fields");
        assertTrue(result.hasKey("expressions"), "Context should include expressions");
    }

    testParseWithFields() {
        DataProvider::DpqlActionSession session = newSession();
        hash<auto> result = session.handleAction("dpql-parse", {
            "text": "@name == 'test'",
            "fields": getFieldInfo(),
        });
        assertTrue(result.success, "Expression should parse");
        assertTrue(result.tokens.size() > 0, "Should return tokens");
    }

    testParseUnknownField() {
        DataProvider::DpqlActionSession session = newSession();
        hash<auto> result = session.handleAction("dpql-parse", {
            "text": "@unknown == 1",
            "fields": getFieldInfo(),
        });
        assertFalse(result.success, "Unknown field should fail validation");
        assertTrue(result.diagnostics.size() > 0, "Should return diagnostics");
    }

    testParseValidationSeverity() {
        DataProvider::DpqlActionSession session = newSession();
        # a warning is reported, and the expression still parses
        hash<auto> result = session.handleAction("dpql-parse", {
            "text": "@age == @age",
            "fields": getFieldInfo(),
        });
        assertTrue(result.success, "a validation warning does not fail parsing");
        assertEq(("DPQL-W006",), map $1.code, result.diagnostics);
        assertEq("warning", result.diagnostics[0].severity);

        # an error fails it
        result = session.handleAction("dpql-parse", {
            "text": "@name - 1",
            "fields": getFieldInfo(),
        });
        assertFalse(result.success, "a validation error fails parsing");
        assertEq(("DPQL-E050",), map $1.code, result.diagnostics);
    }

    testDiagnosticsOnce() {
        DataProvider::DpqlActionSession session = newSession();
        # a parse-time warning (an argument type) and a validation warning
        foreach string action in (("dpql-parse", "dpql-eval")) {
            hash<auto> result = session.handleAction(action, {
                "text": "lwr(@age) == \"x\" && @name == @name",
                "fields": getFieldInfo(),
            });
            assertEq(("DPQL-W004", "DPQL-W006"), map $1.code, result.diagnostics, action);
        }
    }

    testCompletionsNoContext() {
        DataProvider::DpqlActionSession session = newSession();
        bool caught = False;
        try {
            session.handleAction("dpql-get-completions", {
                "text": "@",
                "position": 1,
            });
        } catch (hash<ExceptionInfo> ex) {
            caught = True;
            assertEq("NO-CONTEXT", ex.err);
        }
        assertTrue(caught, "Should throw without context");
    }

    testCompletions() {
        DataProvider::DpqlActionSession session = newSession();
        hash<auto> result = session.handleAction("dpql-get-completions", {
            "text": "@n",
            "position": 2,
            "fields": getFieldInfo(),
        });
        assertTrue(result.completions.size() > 0, "Should return completions");
    }

    testValidateOverride() {
        DataProvider::DpqlActionSession session = newSession();
        session.handleAction("dpql-set-context", {
            "provider": "null{}",
        });
        hash<auto> result = session.handleAction("dpql-validate", {
            "text": "@name == 'test'",
            "fields": getFieldInfo(),
        });
        assertEq(0, result.diagnostics.size(), "Override fields should be used for validation");
    }

    testCompletionsOverride() {
        DataProvider::DpqlActionSession session = newSession();
        session.handleAction("dpql-set-context", {
            "provider": "null{}",
        });
        hash<auto> result = session.handleAction("dpql-get-completions", {
            "text": "@",
            "position": 1,
            "fields": getFieldInfo(),
        });
        assertTrue(result.completions.size() > 0, "Override fields should be used for completions");
    }

    #! Every operator token is an "operator" span and every bracket, brace, parenthesis, comma and dot is
    #! "punctuation"; none is an "identifier", which editors show as a function
    testTokenTypes() {
        DataProvider::DpqlActionSession session = newSession();
        string text = '@a[0..1]{b}.c + 1 - 2 * 3 / 4 % 5 == "x" && !(@d != null) || @e =~ /r/ && @f !~ /s/ '
            '&& @g[*] < 1 && @h <= 2 && @i > 3 && @j >= 4 && upr(@k, 1) == $static:x';
        list<hash<auto>> spans = session.handleAction("dpql-get-tokens", {"text": text}).tokens;
        # the type of each span, by its text; the two * (multiplication and wildcard) are both operators
        hash<string, list<string>> types = {};
        foreach hash<auto> span in (spans) {
            types{span.text} += (span.type,);
        }
        foreach string op in (("..", "+", "-", "*", "/", "%", "==", "!=", "<", "<=", ">", ">=", "&&", "||", "!",
                "=~", "!~")) {
            assertTrue(types.hasKey(op), sprintf("the expression has %y", op));
            assertEq((map "operator", types{op}), types{op}, sprintf("%y is an operator", op));
        }
        assertEq(("operator", "operator"), types."*", "multiplication and the wildcard");
        foreach string p in (("[", "]", "{", "}", ".", "(", ")", ",")) {
            assertTrue(types.hasKey(p), sprintf("the expression has %y", p));
            assertEq((map "punctuation", types{p}), types{p}, sprintf("%y is punctuation", p));
        }
        # the other tokens keep their types
        assertEq(("field",), types."@a");
        assertEq(("number",), types."0");
        assertEq(("string",), types."\"x\"");
        assertEq(("keyword",), types."null");
        assertEq(("string",), types."/r/");
        assertEq(("variable",), types."$static:x");
        assertEq(("identifier",), types.upr);
        # no operator or punctuation token is an identifier
        assertEq((), (map $1.text, spans, $1.type == "identifier" && $1.text !~ /^[[:alpha:]_]/));
    }

    #! Returns the span types of the words of an expression, in order, as "word:type"
    private list<string> wordTypes(DataProvider::DpqlActionSession session, string text) {
        return map $1.text + ":" + $1.type, session.handleAction("dpql-get-tokens", {"text": text}).tokens,
            $1.text =~ /^[[:alpha:]_"0-9]/ && $1.text !~ /^[0-9]+$/ || $1.text =~ /^"/;
    }

    #! A word's span type is what it is where it is: a key, an operator, a function or a value
    testWordTokenTypes() {
        DataProvider::DpqlActionSession session = newSession();
        # member and key names are fields, also when spelled like an operator
        assertEq(("map:field", "map:field", "omq:string"), wordTypes(session, '@x{map}.map == omq'));
        # (@x.select is one field token; a member after an accessor is a word)
        assertEq(("select:field", "select:operator"), wordTypes(session, '@x[0].select == select @l, @v'));
        assertEq(("b:field",), wordTypes(session, '@a[*].b'));
        assertEq(("\"k\":field", "c:field"), wordTypes(session, '@x{"k", c} == 1'));
        list<hash<auto>> spans = session.handleAction("dpql-get-tokens", {"text": '@x{"k", 2}[1] == 3'}).tokens;
        assertEq(("\"k\":field", "2:field", "1:number", "3:number"),
            (map $1.text + ":" + $1.type, spans, $1.type == "field" && $1.text !~ /^@/ || $1.type == "number"));
        # prefix operators, with or without a parenthesized first argument
        assertEq(("map:operator",), wordTypes(session, 'map @id, @orders'));
        assertEq(("count:operator",), wordTypes(session, 'count @l > 1'));
        assertEq(("first:operator",), wordTypes(session, 'first(@a)'));
        assertEq(("hash_map:operator", "takewhile:operator"),
            wordTypes(session, 'hash_map @k, @v, takewhile @ok, @rows'));
        # word operators
        assertEq(("between:operator", "and:operator"), wordTypes(session, '@y between 1 and 2'));
        assertEq(("not:operator", "in:operator", "a:string", "b:string"), wordTypes(session, '@z not in (a, b)'));
        assertEq(("not:operator", "between:operator", "and:operator"),
            wordTypes(session, '@z not between 1 and 2'));
        assertEq(("in:operator", "c:string"), wordTypes(session, '@w in (c)'));
        assertEq(("like:operator", "\"a%\":string"), wordTypes(session, '@k like "a%"'));
        assertEq(("listContains:operator",), wordTypes(session, '@t listContains 1'));
        # functions keep their type, also an operator written as a call
        assertEq(("upr:identifier", "\"N\":string"), wordTypes(session, 'upr(@n) == "N"'));
        assertEq(("listContains:identifier",), wordTypes(session, 'listContains(@u, 1)'));
        # unquoted values are strings, also where a word could be an operator elsewhere
        assertEq(("omq:string",), wordTypes(session, '@domain == omq'));
        assertEq(("in:string",), wordTypes(session, '@x == in'));
        assertEq(("concat:identifier", "between:string", "and:string"), wordTypes(session, 'concat(between, and)'));
        # keywords and fields are unchanged
        assertEq(("true:keyword", "null:keyword"), wordTypes(session, '@d == true && @e != null'));
    }

    testTokenize() {
        DataProvider::DpqlActionSession session = newSession();
        hash<auto> result = session.handleAction("dpql-get-tokens", {
            "text": "@name == 'test'",
        });
        assertTrue(result.tokens.size() > 0, "Should return tokens");
        hash<auto> tok = result.tokens[0];
        assertTrue(tok.hasKey("type"), "Token should have type");
        assertTrue(tok.hasKey("start"), "Token should have start");
        assertTrue(tok.hasKey("end"), "Token should have end");

        # Test template token mapping
        result = session.handleAction("dpql-get-tokens", {
            "text": "@name == $static:value",
        });
        # Find the template token
        *hash<auto> tmpl_tok = (map $1, result.tokens, $1.type == "variable")[0];
        assertTrue(exists tmpl_tok, "Should have a template token mapped to 'variable'");
        assertEq("$static:value", tmpl_tok.text, "Template token text should match");
    }

    testFormatInvalid() {
        DataProvider::DpqlActionSession session = newSession();
        hash<auto> result = session.handleAction("dpql-format", {
            "text": "@name == (incomplete",
        });
        assertFalse(result.success, "Invalid expression should not format");
        assertEq("@name == (incomplete", result.formatted, "Should return original text");
    }

    testSerialize() {
        DataProvider::DpqlActionSession session = newSession();
        hash<auto> result = session.handleAction("dpql-serialize", {
            "expression": <DataProviderExpression>{
                "exp": DP_SEARCH_OP_EQ,
                "args": (<DataProviderFieldReference>{"field": "name"}, "John"),
            },
        });
        assertEq('@name == "John"', result.dpql, "Serialized DPQL should match");
    }

    private DataProvider::DpqlActionSession newEvalSession() {
        return new DataProvider::DpqlActionSession({"base_expressions": dp_get_all_expression_info()});
    }

    testEvalLocal() {
        DataProvider::DpqlActionSession session = newEvalSession();
        # an expression that evaluates to True against the sample record
        hash<auto> result = session.handleAction("dpql-eval", {
            "text": "@age > 18",
            "fields": getFieldInfo(),
            "record": {"name": "John", "age": 25},
        });
        assertTrue(result.success, "Expression should verify");
        assertTrue(result.evaluation.executed, "Expression should evaluate locally");
        assertEq(True, result.evaluation.result, "age 25 > 18 is True");

        # a valid expression that evaluates to False still verifies (it ran correctly)
        result = session.handleAction("dpql-eval", {
            "text": "@age > 18",
            "fields": getFieldInfo(),
            "record": {"name": "Jane", "age": 10},
        });
        assertTrue(result.success, "Valid expression evaluating to False still verifies");
        assertEq(False, result.evaluation.result, "age 10 > 18 is False");
    }

    testEvalCollectionOperator() {
        DataProvider::DpqlActionSession session = newEvalSession();
        # the streaming/collection "any" operator over a list-valued field
        hash<auto> result = session.handleAction("dpql-eval", {
            "text": "any @value >= 90, @scores",
            "record": {"scores": (80, 95, 70)},
        });
        assertTrue(result.success, "Collection-operator expression should verify");
        assertEq(True, result.evaluation.result, "a score >= 90 exists -> True");

        result = session.handleAction("dpql-eval", {
            "text": "any @value >= 90, @scores",
            "record": {"scores": (80, 85, 70)},
        });
        assertEq(False, result.evaluation.result, "no score >= 90 -> False");
    }

    testEvalParseError() {
        DataProvider::DpqlActionSession session = newEvalSession();
        hash<auto> result = session.handleAction("dpql-eval", {
            "text": "@age > ",
            "record": {"age": 25},
        });
        assertFalse(result.success, "Broken expression should not verify");
        assertTrue(result.diagnostics.size() > 0, "Should return diagnostics");
    }

    testEvalPushdown() {
        try {
            DataProvider::registerFactory(new PushdownTestFactory());
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "PROVIDER-ERROR") {
                rethrow;
            }
        }
        DataProvider::DpqlActionSession session = newEvalSession();
        session.handleAction("dpql-set-context", {"provider": "pushdown-test{}"});
        session.setSearchContext(True);

        # an operator the provider supports server-side (>) -> fully pushdownable, verifies
        hash<auto> r1 = session.handleAction("dpql-eval", {
            "text": "@age > 18",
            "record": {"name": "John", "age": 25},
        });
        assertTrue(r1.hasKey("pushdown"), "push-down classification present in search context");
        assertEq(True, r1.pushdown.fully_pushdownable, "'>' is server-supported -> pushdownable");
        assertTrue(r1.success, "server-supported and evaluates -> verified");
        assertEq(True, r1.evaluation.result, "25 > 18 -> True");

        # A metadata-only operator that the provider exposes but does not support server-side -> not pushdownable.
        # This specifically verifies that map membership alone is not mistaken for native implementation support.
        # but still executable client-side, so it verifies with pushdown=False (the caller
        # learns the operator would be evaluated client-side rather than on the server)
        hash<auto> r2 = session.handleAction("dpql-eval", {
            "text": "@name =~ /John/",
            "record": {"name": "John", "age": 25},
        });
        assertEq(False, r2.pushdown.fully_pushdownable, "regex not in server set -> not pushdownable");
        assertTrue(r2.success, "regex is still evaluable client-side -> verifies");
        assertEq(True, r2.evaluation.result, "\"John\" matches /John/ -> True");

        # a condition that is not pushed down and cannot be evaluated locally
        hash<auto> r3 = session.handleAction("dpql-eval", {
            "text": "@age / 0 > 1",
            "record": {"name": "John", "age": 25},
        });
        assertFalse(r3.success, "a condition that fails locally and is not pushed down does not verify");
        list<hash<auto>> e100 = select r3.diagnostics, $1.code == "DPQL-E100";
        assertEq(1, e100.size(), "DPQL-E100 is reported");
        assertEq("error", e100[0].severity);
        assertRegex("^The search condition could not be checked here: DIVISION-BY-ZERO: ", e100[0].message);
    }

    #! A field of the record is one key: completion writes a dot in its name escaped, as a dot in a field reference
    #! separates the parts of a path
    testDottedFieldCompletion() {
        DataProvider::DpqlActionSession session = newSession();
        hash<string, hash<auto>> fields = {
            "Unit.Price": {"type": "float", "desc": "Unit price"},
            "order-id": {"type": "string", "desc": "Order id"},
            "name": {"type": "string", "desc": "Name"},
        };
        hash<string, string> inserts = map {$1.label: $1.insert_text}, session.handleAction("dpql-get-completions", {
            "text": "@",
            "position": 1,
            "fields": fields,
        }).completions, $1.kind == "field";
        assertEq({"Unit.Price": '@"Unit\.Price"', "order-id": '@"order-id"', "name": '@name'}, inserts);
        # the inserted reference is the key
        assertEq((), session.handleAction("dpql-validate", {
            "text": inserts."Unit.Price" + " > 1",
            "fields": fields,
        }).diagnostics);
    }

    #! exists is an operator where it is read as one, it is offered where a condition starts, a field reference
    #! follows it, and it is evaluated on the records read
    testExists() {
        DataProvider::DpqlActionSession session = newSession();
        assertEq(("exists:operator",), wordTypes(session, 'exists @type'));
        assertEq(("exists:operator", "\"return\":string"), wordTypes(session, '!exists(@type) || @type == "return"'));
        assertEq(("any:operator", "exists:operator"), wordTypes(session, 'any exists @id, @orders'));
        # a value, a key and a member named exists
        assertEq(("exists:string",), wordTypes(session, '@type == exists'));
        assertEq(("exists:field", "exists:field"), wordTypes(session, '@a{exists}.exists == 1'));

        # offered where a condition starts, with its field as the snippet's placeholder
        foreach string text in ("", "ex", "@age > 1 && ", "! ") {
            list<hash<auto>> items = select session.handleAction("dpql-get-completions", {
                "text": text,
                "position": text.size(),
                "fields": getFieldInfo(),
            }).completions, $1.label == "exists";
            assertEq(1, items.size(), text);
            assertEq("operator", items[0].kind, text);
            assertEq("exists ${1:Field}$0", items[0].snippet_text, text);
        }
        # after it, only the fields
        foreach string text in ("exists ", "exists(", "!exists ", "exists ( ") {
            list<hash<auto>> items = session.handleAction("dpql-get-completions", {
                "text": text,
                "position": text.size(),
                "fields": getFieldInfo(),
            }).completions;
            assertEq(("age", "name"), sort(map $1.label, items), text);
            assertEq(("field",), keys (map {$1.kind: True}, items), text);
        }
        assertEq(("name",), (map $1.label, session.handleAction("dpql-get-completions", {
            "text": "exists na",
            "position": 9,
            "fields": getFieldInfo(),
        }).completions));

        # not pushed down: it is evaluated on the records read
        try {
            DataProvider::registerFactory(new PushdownTestFactory());
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "PROVIDER-ERROR") {
                rethrow;
            }
        }
        session = newEvalSession();
        session.handleAction("dpql-set-context", {"provider": "pushdown-test{}"});
        session.setSearchContext(True);
        hash<auto> r = session.handleAction("dpql-eval", {
            "text": "exists @age && @age > 18",
            "record": {"name": "John", "age": 25},
        });
        assertEq(False, r.pushdown.fully_pushdownable);
        assertTrue(r.success);
        assertEq(True, r.evaluation.result);
        r = session.handleAction("dpql-eval", {
            "text": "exists @nickname",
            "record": {"name": "John", "age": 25},
        });
        assertTrue(r.success);
        assertEq(False, r.evaluation.result);
    }

    testSchemaAwareKeyCompletions() {
        # Test that schema-aware key completions work when fields have nested hash types
        # This simulates what a real data provider would return with structured data

        # Create fields with nested hash type (like what a provider would return)
        hash<string, AbstractDataField> fields = {
            "record": new QoreDataField("record", "A record with nested fields",
                new HashDataType(NOTHING, {
                    "name": new QoreDataField("name", "Name field", AbstractDataProviderType::get(StringType)),
                    "email": new QoreDataField("email", "Email field", AbstractDataProviderType::get(StringType)),
                    "age": new QoreDataField("age", "Age field", AbstractDataProviderType::get(IntType)),
                })),
            "items": new QoreDataField("items", "List of items",
                new ListDataType(new HashDataType(NOTHING, {
                    "id": new QoreDataField("id", "Item ID", AbstractDataProviderType::get(IntType)),
                    "value": new QoreDataField("value", "Item value", AbstractDataProviderType::get(StringType)),
                }))),
        };

        DataProvider::DpqlActionSession session = newSession();

        # Test key completions for hash field: @record{
        hash<auto> result = session.handleAction("dpql-get-completions", {
            "text": "@record{",
            "position": 8,
            "fields": fields,
        });
        assertTrue(result.completions.size() >= 3, "Should return completions for hash keys");
        list<string> labels = map $1.label, result.completions;
        assertTrue(inlist("name", labels), "Should suggest 'name' key");
        assertTrue(inlist("email", labels), "Should suggest 'email' key");
        assertTrue(inlist("age", labels), "Should suggest 'age' key");

        # Test key completions with prefix filtering: @record{na
        result = session.handleAction("dpql-get-completions", {
            "text": "@record{na",
            "position": 10,
            "fields": fields,
        });
        assertEq(1, result.completions.size(), "Should filter to one completion");
        assertEq("name", result.completions[0].label, "Should match 'name'");

        # Test nested list->hash: @items[0]{
        result = session.handleAction("dpql-get-completions", {
            "text": "@items[0]{",
            "position": 10,
            "fields": fields,
        });
        assertTrue(result.completions.size() >= 2, "Should return completions for list element hash keys");
        labels = map $1.label, result.completions;
        assertTrue(inlist("id", labels), "Should suggest 'id' key");
        assertTrue(inlist("value", labels), "Should suggest 'value' key");

        # Test that simple string fields return no key completions: @name{
        hash<string, AbstractDataField> simple_fields = {
            "name": new QoreDataField("name", "Simple string", AbstractDataProviderType::get(StringType)),
        };
        result = session.handleAction("dpql-get-completions", {
            "text": "@name{",
            "position": 6,
            "fields": simple_fields,
        });
        assertEq(0, result.completions.size(), "String field should have no key completions");
    }

    private hash<string, hash<DataProviderExpressionInfo>> getCustomExpressions() {
        return {
            "custom-func": <DataProviderExpressionInfo>{
                "type": DET_Function,
                "name": "custom-func",
                "display_name": "Custom Function",
                "short_desc": "A custom test function",
                "desc": "A custom test function",
                "symbol": "custom-func()",
                "return_type": AbstractDataProviderType::get(StringType),
            },
            "custom-op": <DataProviderExpressionInfo>{
                "type": DET_Operator,
                "name": "custom-op",
                "display_name": "Custom Operator",
                "short_desc": "A custom test operator",
                "desc": "A custom test operator",
                "symbol": "custom-op",
                "return_type": AbstractDataProviderType::get(BoolType),
            },
        };
    }

    testBaseExpressionsConstructor() {
        hash<string, hash<DataProviderExpressionInfo>> custom = getCustomExpressions();
        DataProvider::DpqlActionSession session({"base_expressions": custom});

        # Base expressions should be available immediately
        *hash<string, hash<DataProviderExpressionInfo>> exprs = session.getExpressions();
        assertTrue(exprs.hasKey("custom-func"), "base expression available before setContext");
        assertTrue(exprs.hasKey("custom-op"), "base operator available before setContext");

        # getBaseExpressions should return the base set
        *hash<string, hash<DataProviderExpressionInfo>> base = session.getBaseExpressions();
        assertTrue(base.hasKey("custom-func"), "getBaseExpressions returns custom-func");
    }

    testBaseExpressionsSetter() {
        DataProvider::DpqlActionSession session();

        # Initially no expressions
        assertNothing(session.getExpressions(), "no expressions initially");
        assertNothing(session.getBaseExpressions(), "no base expressions initially");

        hash<string, hash<DataProviderExpressionInfo>> custom = getCustomExpressions();
        session.setBaseExpressions(custom);

        # Now base expressions should be available
        *hash<string, hash<DataProviderExpressionInfo>> exprs = session.getExpressions();
        assertTrue(exprs.hasKey("custom-func"), "base expression available after setter");
        assertTrue(exprs.hasKey("custom-op"), "base operator available after setter");
    }

    testSignatureHelp() {
        hash<string, hash<DataProviderExpressionInfo>> custom = getCustomExpressions();
        DataProvider::DpqlActionSession session({"base_expressions": custom});

        # Signature help for base expression function
        hash<auto> result = session.handleAction("dpql-get-signature-help", {
            "text": "custom-func(",
            "position": 12,
        });
        assertTrue(exists result.signature, "should return signature for base expression");
        assertTrue(result.signature.label.find("custom-func(") == 0,
            "signature label should show function name");

        # Signature help outside function call
        result = session.handleAction("dpql-get-signature-help", {
            "text": "@name == 1",
            "position": 5,
        });
        assertNothing(result.signature, "no signature help outside function call");
    }

    testBaseExpressionsMergedWithContext() {
        hash<string, hash<DataProviderExpressionInfo>> custom = getCustomExpressions();
        DataProvider::DpqlActionSession session({"base_expressions": custom});

        # Set context with a provider (null provider has no custom expressions)
        session.handleAction("dpql-set-context", {"provider": "null{}"});

        # Base expressions should still be available after setContext
        *hash<string, hash<DataProviderExpressionInfo>> exprs = session.getExpressions();
        assertTrue(exprs.hasKey("custom-func"),
            "base expression still available after setContext");
        assertTrue(exprs.hasKey("custom-op"),
            "base operator still available after setContext");
    }
}
