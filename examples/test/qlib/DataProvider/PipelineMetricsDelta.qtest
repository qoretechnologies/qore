        pipe.append(0, new BulkPassthroughProcessor(), "elem-B");
        pipe.append(0, new BulkPassthroughProcessor(), "elem-C");

        hash<auto> bulk_data = {
            "id": (map $1, range(batch_size)),
        };
        pipe.submit(bulk_data);
        pipe.waitDone();

        hash<DataProvider::PipelineMetricsSnapshot> final_snap =
            collector.all_snapshots[collector.all_snapshots.size() - 1];

        # Final-snapshot invariants
        assertEq(final_snap.total_records_submitted, final_snap.total_records_completed,
            "submitted must equal completed after waitDone()");

        # Cumulative processing_time_us must be non-zero for all elements
        foreach hash<auto> pair in (final_snap.element_metrics.pairIterator()) {
            assertTrue(pair.value.processing_time_us > 0,
                sprintf("element '%s': cumulative processing_time_us must be > 0 "
                    "(records_processed=%d)", pair.key, pair.value.records_processed));
        }

        # Check delta snapshots
        int i = 0;
        foreach hash<DataProvider::PipelineMetricsSnapshot> s in (collector.all_snapshots) {
            foreach hash<auto> pair in (s.delta.element_metrics.pairIterator()) {
                hash<DataProvider::PipelineElementDelta> ed = pair.value;
                if (ed.records_processed > 0) {
                    assertTrue(ed.processing_time_us > 0,
                        sprintf("snapshot %d, element '%s': delta processing_time_us must be > 0 "
                            "when records_processed=%d", i, pair.key, ed.records_processed));
                    assertTrue(ed.avg_processing_time_us > 0.0,
                        sprintf("snapshot %d, element '%s': delta avg_processing_time_us must be > 0 "
                            "when records_processed=%d", i, pair.key, ed.records_processed));
                }
            }
            ++i;
        }
    }

    # =========================================================================
    # Test 17: cumulative processing time consistency
    # =========================================================================

    #! Submit records through a pipeline with IntervalMetricsCollector. Verify:
    #! - Sum of delta.processing_time_us across all snapshots equals cumulative
    #! - Sum of delta.queue_wait_time_us across all snapshots equals cumulative (>= 0)
    testCumulativeProcessingTimeConsistency() {
        int n = 100;
        int interval = 20;

        IntervalMetricsCollector collector(interval);
        DataProviderPipeline pipe(<PipelineOptionInfo>{
            "name": "processing-time-sums",
            "metrics_collector": collector,
        });
        pipe.append(0, new DeltaPassthroughProcessor());
        pipe.append(0, new DeltaPassthroughProcessor());

        pipe.submit(getGeneratorIterator(n));
        pipe.waitDone();

        hash<DataProvider::PipelineMetricsSnapshot> final_snap =
            collector.all_snapshots[collector.all_snapshots.size() - 1];

        # Sum delta processing_time_us and queue_wait_time_us per element
        hash<string, int> delta_processing_sums;
        hash<string, int> delta_queue_wait_sums;
        foreach hash<DataProvider::PipelineMetricsSnapshot> s in (collector.all_snapshots) {
            foreach hash<auto> epair in (s.delta.element_metrics.pairIterator()) {
                delta_processing_sums{epair.key} += epair.value.processing_time_us;
                delta_queue_wait_sums{epair.key} += epair.value.queue_wait_time_us;
            }
        }

        foreach hash<auto> pair in (final_snap.element_metrics.pairIterator()) {
            assertEq(pair.value.processing_time_us, delta_processing_sums{pair.key},
                sprintf("element '%s': sum of delta.processing_time_us must equal cumulative",
                    pair.key));
            assertEq(pair.value.queue_wait_time_us, delta_queue_wait_sums{pair.key},
                sprintf("element '%s': sum of delta.queue_wait_time_us must equal cumulative",
                    pair.key));
            # queue_wait_time_us must be non-negative
            assertTrue(pair.value.queue_wait_time_us >= 0,
                sprintf("element '%s': queue_wait_time_us must be >= 0", pair.key));
        }
    }

    # =========================================================================
    # Test 18: pipeline reset metrics
    # =========================================================================

    #! Run 1: submit 50 records, waitDone(). Run 2: reset, submit 30 records, waitDone().
    #! Verify run 2 metrics reflect only the second run (counters reset to 0).
    testPipelineResetMetrics() {
        int n1 = 50;
        int n2 = 30;

        CapturingMetricsCollector collector();
        DataProviderPipeline pipe(<PipelineOptionInfo>{
            "name": "reset-metrics",
            "metrics_collector": collector,
        });
        pipe.append(0, new DeltaPassthroughProcessor());

        # Run 1
        pipe.submit(getGeneratorIterator(n1));
        pipe.waitDone();

        assertTrue(collector.shutdown_called, "run1: shutdown must be called");
        assertNeq(NOTHING, collector.last_snapshot, "run1: must have a snapshot");
        hash<DataProvider::PipelineMetricsSnapshot> snap1 = collector.last_snapshot;
        assertEq(n1, snap1.total_records_submitted, "run1: submitted");
        assertEq(n1, snap1.total_records_completed, "run1: completed");

        # Reset and run 2
        pipe.reset();
        assertTrue(collector.reset_called, "reset() must be called on abstract collector");
        assertFalse(collector.shutdown_called,
            "shutdown_called must be False after reset (abstract collector reset)");

        pipe.submit(getGeneratorIterator(n2));
        pipe.waitDone();

        assertTrue(collector.shutdown_called, "run2: shutdown must be called");
        assertNeq(NOTHING, collector.last_snapshot, "run2: must have a snapshot");
        hash<DataProvider::PipelineMetricsSnapshot> snap2 = collector.last_snapshot;

        # Run 2 metrics must reflect ONLY the second run
        assertEq(n2, snap2.total_records_submitted, "run2: submitted must equal n2 (reset)");
        assertEq(n2, snap2.total_records_completed, "run2: completed must equal n2 (reset)");

        # Delta must also reflect only run 2
        assertNeq(NOTHING, snap2.delta, "run2: delta must be populated");

        # Cumulative element metrics must reflect only run 2
        foreach hash<auto> pair in (snap2.element_metrics.pairIterator()) {
            assertEq(n2, pair.value.records_processed,
                sprintf("run2: element '%s' records_processed must equal %d", pair.key, n2));
            assertEq(n2, pair.value.records_output,
                sprintf("run2: element '%s' records_output must equal %d", pair.key, n2));
        }
    }

    # =========================================================================
    # Test 19: pipeline reset after abort
    # =========================================================================

    #! Submit records, abort the pipeline, then reset and run again.
    #! Verify the collector is revived and metrics from the second run are correct.
    testPipelineResetAfterAbort() {
        int n = 20;

        CapturingMetricsCollector collector();
        DataProviderPipeline pipe(<PipelineOptionInfo>{
            "name": "reset-after-abort",
            "metrics_collector": collector,
        });
        pipe.append(0, new DeltaPassthroughProcessor());

        # Run 1: submit and process some records, then abort
        pipe.submit(getGeneratorIterator(n));
        pipe.waitDone();

        assertTrue(collector.shutdown_called, "shutdown must be called after waitDone()");

        # Verify metrics collector reports shut down
        PipelineMetricsCollector mc = pipe.getMetricsCollector();
        assertTrue(mc.isShutDown(), "collector must be shut down after waitDone()");

        # Reset the pipeline
        pipe.reset();
        assertFalse(mc.isShutDown(), "collector must NOT be shut down after reset()");

        # Run 2: submit more records
        int n2 = 15;
        pipe.submit(getGeneratorIterator(n2));
        pipe.waitDone();

        assertNeq(NOTHING, collector.last_snapshot, "run2: must have a snapshot");
        hash<DataProvider::PipelineMetricsSnapshot> snap = collector.last_snapshot;

        # Verify run 2 metrics
        assertEq(n2, snap.total_records_submitted, "run2: submitted must equal n2");
        assertEq(n2, snap.total_records_completed, "run2: completed must equal n2");

        # forceCallback must have worked (shut_down was cleared)
        assertTrue(collector.shutdown_called, "run2: shutdown must be called after waitDone()");
    }

    # =========================================================================
    # Test 20: pipeline reset with source element
    # =========================================================================

    #! Pipeline with a source element. Run 1: submit 100 records. Reset. Run 2: submit 50.
    #! Verify source element metrics are reset and reflect only run 2.
    testPipelineResetWithSourceElement() {
        int n1 = 100;
        int n2 = 50;

        CapturingMetricsCollector collector();
        DataProviderPipeline pipe(<PipelineOptionInfo>{
            "name": "reset-source-element",
            "metrics_collector": collector,
        });
        pipe.append(0, new DeltaPassthroughProcessor(), "proc-A");
        pipe.append(0, new DeltaPassthroughProcessor(), "proc-B");

        # Set up source element
        PipelineMetricsCollector mc = pipe.getMetricsCollector();
        mc.initElement("ext:source", "processor", "Source", "source-state");
        mc.setSourceElement("ext:source");

        # Run 1
        pipe.submit(getGeneratorIterator(n1));
        pipe.waitDone();

        hash<DataProvider::PipelineMetricsSnapshot> snap1 = collector.last_snapshot;
        assertEq(n1, snap1.total_records_submitted, "run1: submitted");
        assertEq(n1, snap1.total_records_completed, "run1: completed");
        # Source element must have recorded records in run 1
        assertTrue(snap1.element_metrics.hasKey("source-state"),
            "run1: source-state must be in element_metrics");
        assertEq(n1, snap1.element_metrics."source-state".records_processed,
            "run1: source records_processed");

        # Reset and run 2
        pipe.reset();

        pipe.submit(getGeneratorIterator(n2));
        pipe.waitDone();

        hash<DataProvider::PipelineMetricsSnapshot> snap2 = collector.last_snapshot;

        # Run 2 must reflect only the second run
        assertEq(n2, snap2.total_records_submitted, "run2: submitted must equal n2");
        assertEq(n2, snap2.total_records_completed, "run2: completed must equal n2");

        # Source element metrics must be reset to only run 2 counts
        assertTrue(snap2.element_metrics.hasKey("source-state"),
            "run2: source-state must still be in element_metrics");
        assertEq(n2, snap2.element_metrics."source-state".records_processed,
            "run2: source records_processed must equal n2 (reset)");
        assertEq(n2, snap2.element_metrics."source-state".records_output,
            "run2: source records_output must equal n2 (reset)");

        # Processing elements must also be reset
        assertEq(n2, snap2.element_metrics."proc-A".records_processed,
            "run2: proc-A records_processed must equal n2 (reset)");
        assertEq(n2, snap2.element_metrics."proc-B".records_processed,
            "run2: proc-B records_processed must equal n2 (reset)");
    }

    # =========================================================================
    # Test 21: fan-out submitted count
    # =========================================================================

    #! Fan-out topology: queue 0 has a fan-out list (no processor) that submits to queues 1 and 2.
    #! Each child queue has a passthrough processor. Verify total_records_submitted == n.
    testFanOutSubmittedCount() {
        int n = 50;

        CapturingMetricsCollector collector();
        DataProviderPipeline pipe(<PipelineOptionInfo>{
            "name": "delta-fanout-submitted",
            "metrics_collector": collector,
        });
        # Queue 0 fans out to child queues
        int q1 = pipe.appendQueue(0);
        int q2 = pipe.appendQueue(0);
        pipe.append(q1, new DeltaPassthroughProcessor());
        pipe.append(q2, new DeltaPassthroughProcessor());

        pipe.submit(getGeneratorIterator(n));
        pipe.waitDone();

        assertNeq(NOTHING, collector.last_snapshot);
        hash<DataProvider::PipelineMetricsSnapshot> snap = collector.last_snapshot;

        # total_records_submitted must equal n (not 0) — this was the bug
        assertEq(n, snap.total_records_submitted,
            "total_records_submitted must equal n for fan-out topology");
        # records are completed at each child queue's terminal processor
        assertEq(2 * n, snap.total_records_completed,
            "total_records_completed must equal 2*n (sum of both child queue terminal outputs)");
    }

    # =========================================================================
    # Test 22: fan-out with processor submitted count
    # =========================================================================

    #! Processor before fan-out: queue 0 has a passthrough processor then fans out.
    #! Verify total_records_submitted == n.
    testFanOutWithProcessorSubmittedCount() {
        int n = 40;

        CapturingMetricsCollector collector();
        DataProviderPipeline pipe(<PipelineOptionInfo>{
            "name": "delta-fanout-proc-submitted",
            "metrics_collector": collector,
        });
        # Queue 0: processor followed by fan-out to child queues
        pipe.append(0, new DeltaPassthroughProcessor());
        int q1 = pipe.appendQueue(0);
        int q2 = pipe.appendQueue(0);
        pipe.append(q1, new DeltaPassthroughProcessor());
        pipe.append(q2, new DeltaPassthroughProcessor());

        pipe.submit(getGeneratorIterator(n));
        pipe.waitDone();

        assertNeq(NOTHING, collector.last_snapshot);
        hash<DataProvider::PipelineMetricsSnapshot> snap = collector.last_snapshot;

        assertEq(n, snap.total_records_submitted,
            "total_records_submitted must equal n with processor before fan-out");
        # records are completed at each child queue's terminal processor
        assertEq(2 * n, snap.total_records_completed,
            "total_records_completed must equal 2*n (sum of both child queue terminal outputs)");
    }

    # =========================================================================
    # Test 23: fan-out with filter accounting
    # =========================================================================

    #! Test 23: fan-out topology where child queues have filters
    #! - Queue 0: fan-out to q1, q2
    #! - q1: EveryOtherFilterProcessor (passes n/2)
    #! - q2: passthrough (passes n)
    #! - total_records_submitted = n
    #! - total_records_completed = n/2 + n = 3n/2
    testFanOutWithFilterAccounting() {
        int n = 20;

        CapturingMetricsCollector collector();
        DataProviderPipeline pipe(<PipelineOptionInfo>{
            "name": "fanout-filter-test",
            "metrics_collector": collector,
        });

        # Queue 1: every-other filter (passes half)
        int q1 = pipe.appendQueue(0);
        pipe.append(q1, new EveryOtherFilterProcessor());

        # Queue 2: passthrough (passes all)
        int q2 = pipe.appendQueue(0);
        pipe.append(q2, new DeltaPassthroughProcessor());

        pipe.submit(getGeneratorIterator(n));
        pipe.waitDone();

        hash<DataProvider::PipelineMetricsSnapshot> snap = collector.last_snapshot;
        assertEq(n, snap.total_records_submitted,
            "total_records_submitted must be n");
        # total_records_completed = sum of terminal outputs: q1 passes n/2, q2 passes n
        assertEq(n / 2 + n, snap.total_records_completed,
            "total_records_completed must be sum of child queue terminal outputs (n/2 + n)");
    }

    # =========================================================================
    # Test 24: source element fan-out — no inflation
    # =========================================================================

    #! Fan-out topology with source element: Queue 0 → fan-out [Q1(proc), Q2(proc)].
    #! Verify that source element records are NOT inflated by the fan-out.
    testSourceElementFanOutNoInflation() {
        int n = 50;

        CapturingMetricsCollector collector();
        DataProviderPipeline pipe(<PipelineOptionInfo>{
            "name": "source-fanout-no-inflation",
            "metrics_collector": collector,
        });
        int q1 = pipe.appendQueue(0);
        int q2 = pipe.appendQueue(0);
        pipe.append(q1, new DeltaPassthroughProcessor(), "child-1");
        pipe.append(q2, new DeltaPassthroughProcessor(), "child-2");

        # Set up external source element
        PipelineMetricsCollector mc = pipe.getMetricsCollector();
        mc.initElement("ext:source", "processor", "SourceProvider", "source-state");
        mc.setSourceElement("ext:source");

        pipe.submit(getGeneratorIterator(n));
        pipe.waitDone();

        hash<DataProvider::PipelineMetricsSnapshot> snap = collector.last_snapshot;

        # Source element must have exactly N records — not 2*N
        assertEq(n, snap.element_metrics."source-state".records_processed,
            "source records_processed must equal N (not inflated by fan-out)");
        assertEq(n, snap.element_metrics."source-state".records_output,
            "source records_output must equal N (not inflated by fan-out)");

        # Total submitted must equal N
        assertEq(n, snap.total_records_submitted,
            "total_records_submitted must equal N");

        # Total completed = 2*N (each child queue outputs N)
        assertEq(2 * n, snap.total_records_completed,
            "total_records_completed must equal 2*N (fan-out)");
    }

    # =========================================================================
    # Test 25: source element with processor before fan-out
    # =========================================================================

    #! Queue 0 [proc] → fan-out [Q1(proc), Q2(proc)], source element set.
    #! Verify source element is not inflated.
    testSourceElementWithProcessorBeforeFanOut() {
        int n = 40;

        CapturingMetricsCollector collector();
        DataProviderPipeline pipe(<PipelineOptionInfo>{
            "name": "source-proc-fanout",
            "metrics_collector": collector,
        });
        pipe.append(0, new DeltaPassthroughProcessor(), "proc-0");
        int q1 = pipe.appendQueue(0);
        int q2 = pipe.appendQueue(0);
        pipe.append(q1, new DeltaPassthroughProcessor(), "child-1");
        pipe.append(q2, new DeltaPassthroughProcessor(), "child-2");

        # Set up external source element
        PipelineMetricsCollector mc = pipe.getMetricsCollector();
        mc.initElement("ext:source", "processor", "SourceProvider", "source-state");
        mc.setSourceElement("ext:source");

        pipe.submit(getGeneratorIterator(n));
        pipe.waitDone();

        hash<DataProvider::PipelineMetricsSnapshot> snap = collector.last_snapshot;

        # Source element must have exactly N records
        assertEq(n, snap.element_metrics."source-state".records_processed,
            "source records_processed must equal N");
        assertEq(n, snap.element_metrics."source-state".records_output,
            "source records_output must equal N");

        # Total submitted must equal N
        assertEq(n, snap.total_records_submitted,
            "total_records_submitted must equal N");

        # Total completed = 2*N (each child queue outputs N)
        assertEq(2 * n, snap.total_records_completed,
            "total_records_completed must equal 2*N (fan-out)");

        # The processor on queue 0 must have processed N records
        assertEq(n, snap.element_metrics."proc-0".records_processed,
            "proc-0 must have processed N records");
    }

    # =========================================================================
    # Test 26: queue wait time tracking
    # =========================================================================

    #! Use SlowProcessor to force queue wait time > 0.
    #! Submit records and verify that the first processor element has non-zero queue_wait_time_us.
    testQueueWaitTimeTracking() {
        int n = 10;

        CapturingMetricsCollector collector();
        DataProviderPipeline pipe(<PipelineOptionInfo>{
            "name": "queue-wait-time",
            "metrics_collector": collector,
        });
        # SlowProcessor adds 10ms delay per record — enough to build queue wait time
        pipe.append(0, new SlowProcessor(10000), "slow-proc");

        pipe.submit(getGeneratorIterator(n));
        pipe.waitDone();

        hash<DataProvider::PipelineMetricsSnapshot> snap = collector.last_snapshot;
        assertEq(n, snap.total_records_submitted, "submitted must equal N");
        assertEq(n, snap.total_records_completed, "completed must equal N");

        # The processor element must have queue_wait_time_us > 0
        # because records pile up while the slow processor works
        assertTrue(snap.element_metrics."slow-proc".queue_wait_time_us > 0,
            "queue_wait_time_us must be > 0 with slow processor");

        # The delta element must also reflect queue_wait_time_us
        *hash<DataProvider::PipelineElementDelta> delta_elem =
            snap.delta.element_metrics."slow-proc";
        assertNeq(NOTHING, delta_elem, "slow-proc must be in delta");
        assertTrue(delta_elem.queue_wait_time_us > 0,
            "delta queue_wait_time_us must be > 0");
    }

    # =========================================================================
    # Test 27: backpressure and depth tracking
    # =========================================================================

    #! Use SlowProcessor with default queue_size=1 to trigger backpressure.
    #! Submit enough records and verify queue-type metrics (max_queue_depth, queue_full_count)
    #! via getQueueMetrics(), which returns the queue-type elements filtered from snapshots.
    testBackpressureAndDepthTracking() {
        int n = 10;

        CapturingMetricsCollector collector();
        DataProviderPipeline pipe(<PipelineOptionInfo>{
            "name": "backpressure-depth",
            "metrics_collector": collector,
        });
        # SlowProcessor with 10ms delay per record — forces backpressure with default queue_size=1
        pipe.append(0, new SlowProcessor(10000), "slow-proc");

        pipe.submit(getGeneratorIterator(n));
        pipe.waitDone();

        hash<DataProvider::PipelineMetricsSnapshot> snap = collector.last_snapshot;
        assertEq(n, snap.total_records_submitted, "submitted must equal N");
        assertEq(n, snap.total_records_completed, "completed must equal N");

        # Access queue-type metrics directly (filtered from snapshots)
        PipelineMetricsCollector mc = pipe.getMetricsCollector();
        hash<string, hash<DataProvider::PipelineElementMetrics>> qm = mc.getQueueMetrics();

        # Queue "0" must have been tracked
        assertTrue(qm.hasKey("0"), "queue '0' must be in queue metrics");
        assertEq("queue", qm."0".element_type, "element_type must be 'queue'");

        # With queue_size=1 and slow processor, backpressure must have occurred
        assertTrue(qm."0".queue_full_count > 0,
            "queue_full_count must be > 0 (backpressure detected)");
        assertTrue(qm."0".max_queue_depth > 0,
            "max_queue_depth must be > 0");
    }

    # =========================================================================
    # Test 28: source element with 3+ child queues
    # =========================================================================

    #! Fan-out to 3 queues, verify source records_output == N still holds.
    testSourceElementWith3ChildQueues() {
        int n = 30;

        CapturingMetricsCollector collector();
        DataProviderPipeline pipe(<PipelineOptionInfo>{
            "name": "source-3-children",
            "metrics_collector": collector,
        });
        int q1 = pipe.appendQueue(0);
        int q2 = pipe.appendQueue(0);
        int q3 = pipe.appendQueue(0);
        pipe.append(q1, new DeltaPassthroughProcessor(), "child-1");
        pipe.append(q2, new DeltaPassthroughProcessor(), "child-2");
        pipe.append(q3, new DeltaPassthroughProcessor(), "child-3");

        PipelineMetricsCollector mc = pipe.getMetricsCollector();
        mc.initElement("ext:source", "processor", "SourceProvider", "source-state");
        mc.setSourceElement("ext:source");

        pipe.submit(getGeneratorIterator(n));
        pipe.waitDone();

        hash<DataProvider::PipelineMetricsSnapshot> snap = collector.last_snapshot;

        # Source element must have exactly N records — not 3*N
        assertEq(n, snap.element_metrics."source-state".records_processed,
            "source records_processed must equal N with 3 children");
        assertEq(n, snap.element_metrics."source-state".records_output,
            "source records_output must equal N with 3 children");

        # Total submitted = N
        assertEq(n, snap.total_records_submitted,
            "total_records_submitted must equal N");

        # Total completed = 3*N (each child queue outputs N)
        assertEq(3 * n, snap.total_records_completed,
            "total_records_completed must equal 3*N (3-way fan-out)");
    }

    # =========================================================================
    # Test 29: source element as queue 0 processor — no double-count
    # =========================================================================

    #! When setSourceElement uses an auto-generated ID that's also in elem_ids,
    #! verify records are NOT double-counted (once from source path, once from
    #! per-element path).  Reproduces the bug where source metrics were inflated
    #! by the number of processors when source_element_id was in element_ids.
    testSourceElementAsQueueProcessorNoDoubleCount() {
        int n = 500;

        CapturingMetricsCollector collector();
        DataProviderPipeline pipe(<PipelineOptionInfo>{
            "name": "source-as-processor",
            "metrics_collector": collector,
        });

        # Source processor in queue 0 — gets auto_id "0:0"
        pipe.append(0, new DeltaPassthroughProcessor(), "source-state");

        # Fan-out to 2 child queues
        int q1 = pipe.appendQueue(0);
        int q2 = pipe.appendQueue(0);

        # Queue 1: 2 processors
        pipe.append(q1, new DeltaPassthroughProcessor(), "proc-1a");
        pipe.append(q1, new DeltaPassthroughProcessor(), "proc-1b");

        # Queue 2: 4 processors
        pipe.append(q2, new DeltaPassthroughProcessor(), "proc-2a");
        pipe.append(q2, new DeltaPassthroughProcessor(), "proc-2b");
        pipe.append(q2, new DeltaPassthroughProcessor(), "proc-2c");
        pipe.append(q2, new DeltaPassthroughProcessor(), "proc-2d");

        # Set source element to auto-generated ID "0:0" (same as the first processor)
        PipelineMetricsCollector mc = pipe.getMetricsCollector();
        mc.setSourceElement("0:0");

        pipe.submit(getGeneratorIterator(n));
        pipe.waitDone();

        hash<DataProvider::PipelineMetricsSnapshot> snap = collector.last_snapshot;

        # Source element must have exactly N records — not 2*N (double-counted)
        assertEq(n, snap.element_metrics."source-state".records_processed,
            "source records_processed must equal N (not double-counted)");
        assertEq(n, snap.element_metrics."source-state".records_output,
            "source records_output must equal N (not double-counted)");

        # Source must still have processing time (per-element path must update it)
        assertTrue(snap.element_metrics."source-state".processing_time_us > 0,
            "source processing_time_us must be > 0");

        # Total submitted must equal N
        assertEq(n, snap.total_records_submitted,
            "total_records_submitted must equal N");

        # Total completed = 2*N (each child queue outputs N)
        assertEq(2 * n, snap.total_records_completed,
            "total_records_completed must equal 2*N (fan-out)");
    }

    # =========================================================================
    # Test 30: QoG fan-out with filter field reference and source metrics
    # =========================================================================

    #! Reproduces the QoG topology from qog-pipeline-test.json:
    #!   Source (Generator, N sequential records) → fan-out:
    #!     Branch 1: passthrough → passthrough
    #!     Branch 2: QoreFilterRecordsProcessor (value < threshold) → passthrough
    #!
    #! With sequential generator, value = 0.0, 1.0, ..., (N-1).0
    #! Filter passes records where value < threshold → exactly `threshold` records.
    #!
    #! Verifies:
    #! - Source element metrics = N (not inflated by fan-out)
    #! - Filter accounting: branch 1 outputs N, branch 2 outputs threshold
    #! - total_records_submitted = N
    #! - total_records_completed = N + threshold
    #! - QoreFilterRecordsProcessor correctly resolves DataProviderFieldReference
    testQogFanOutFilterFieldRefSourceMetrics() {
        int n = 100;
        int threshold = 50;

        CapturingMetricsCollector collector();
        DataProviderPipeline pipe(<PipelineOptionInfo>{
            "name": "qog-fanout-filter-test",
            "metrics_collector": collector,
        });

        # Branch 1: passthrough → passthrough
        int q1 = pipe.appendQueue(0);
        pipe.append(q1, new DeltaPassthroughProcessor(), "proc-1a");
        pipe.append(q1, new DeltaPassthroughProcessor(), "proc-1b");

        # Branch 2: QoreFilterRecordsProcessor (value < threshold) → passthrough
        int q2 = pipe.appendQueue(0);
        # Construct the filter expression: value < threshold
        # In JSON transport format: {"exp": "<", "args": [{"field": "value"}, {"value": threshold}]}
        hash<auto> filter_expr_json = {
            "exp": "<",
            "args": (
                {"field": "value"},
                {"value": threshold},
            ),
        };
        DataProvider::QoreFilterRecordsProcessor filter({"where_cond": filter_expr_json});
        pipe.append(q2, filter, "filter-2");
        pipe.append(q2, new DeltaPassthroughProcessor(), "proc-2a");

        # Set up external source element
        PipelineMetricsCollector mc = pipe.getMetricsCollector();
        mc.initElement("ext:source", "processor", "SourceProvider", "source-state");
        mc.setSourceElement("ext:source");

        pipe.submit(getGeneratorIterator(n));
        pipe.waitDone();

        hash<DataProvider::PipelineMetricsSnapshot> snap = collector.last_snapshot;

        # Source element must have exactly N records — not inflated by fan-out
        assertEq(n, snap.element_metrics."source-state".records_processed,
            "source records_processed must equal N");
        assertEq(n, snap.element_metrics."source-state".records_output,
            "source records_output must equal N");

        # Total submitted must equal N
        assertEq(n, snap.total_records_submitted,
            "total_records_submitted must equal N");

        # Total completed = N (branch 1 terminal) + threshold (branch 2 terminal after filter)
        assertEq(n + threshold, snap.total_records_completed,
            sprintf("total_records_completed must equal N + threshold (%d + %d)", n, threshold));

        # Branch 1 processors: both must have processed N records
        assertEq(n, snap.element_metrics."proc-1a".records_processed,
            "proc-1a must have processed N records");
        assertEq(n, snap.element_metrics."proc-1b".records_processed,
            "proc-1b must have processed N records");

        # Filter must have processed N records but output only threshold records
        assertEq(n, snap.element_metrics."filter-2".records_processed,
            "filter must have processed N records (received all)");
        assertEq(threshold, snap.element_metrics."filter-2".records_output,
            sprintf("filter must have output only %d records (value < %d)", threshold, threshold));

        # Branch 2 terminal processor must have processed only threshold records
        assertEq(threshold, snap.element_metrics."proc-2a".records_processed,
            sprintf("proc-2a must have processed only %d records (after filter)", threshold));
    }
}
