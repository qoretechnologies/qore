# each memory test case runs three times (see PipelineMemoryTest), which a loaded machine needs more than the
# default time limit of a test for
# test-timeout: 900

%modern
%enable-all-warnings

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Mime
%requires DataProvider
%requires GeneratorDataProvider
%requires FsUtil
%requires ../../ExecModeHarness.qm

%try-module process
%define NoProcess
%endtry

%exec-class PipelineMemoryTest

#! Simple passthrough processor that forwards records without accumulation
class PassthroughProcessor inherits DataProvider::AbstractDataProcessor {
    private bool supportsBulkApiImpl() {
        return False;
    }

    private submitImpl(code<nothing(auto)> enqueue, auto _data) {
        enqueue(_data);
    }
}

#! Processor that transforms records without accumulating data
class TransformProcessor inherits DataProvider::AbstractDataProcessor {
    private bool supportsBulkApiImpl() {
        return False;
    }

    private submitImpl(code<nothing(auto)> enqueue, auto _data) {
        if (_data.typeCode() == NT_HASH) {
            enqueue(_data + {"processed": True});
        } else {
            enqueue(_data);
        }
    }
}

#! Metrics collector that takes periodic memory snapshots during pipeline execution
class MemorySnapshotCollector inherits DataProvider::AbstractPipelineMetricsCollector {
    public {
        #! Memory snapshots taken during pipeline execution: list of {rss, vsz, records, threads}
        list<hash<auto>> snapshots();

        #! Whether shutdown was called
        bool shutdown_called = False;
    }

    private {
        #! Record interval for snapshot collection
        int record_interval;
    }

    constructor(int record_interval = 10000) {
        self.record_interval = record_interval;
    }

    int getIntervalMs() {
        return 0;
    }

    int getRecordInterval() {
        return record_interval;
    }

    reportMetrics(hash<DataProvider::PipelineMetricsSnapshot> snapshot) {
%ifndef NoProcess
        hash<auto> mem = Process::getMemorySummaryInfo();
        push snapshots, {
            "rss": mem.rss,
            "vsz": mem.vsz,
            "records_submitted": snapshot.total_records_submitted,
            "records_completed": snapshot.total_records_completed,
            "threads": num_threads(),
            "time": now_us(),
        };
%endif
    }

    shutdown() {
        shutdown_called = True;
    }
}

#! Lightweight metrics collector that discards snapshot data -- tests pure collection overhead
class LightweightMetricsCollector inherits DataProvider::AbstractPipelineMetricsCollector {
    public {
        #! Number of times reportMetrics was called
        int callback_count = 0;

        #! Whether shutdown was called
        bool shutdown_called = False;
    }

    private {
        int record_interval;
        int interval_ms;
    }

    constructor(int record_interval = 1000, int interval_ms = 0) {
        self.record_interval = record_interval;
        self.interval_ms = interval_ms;
    }

    int getIntervalMs() {
        return interval_ms;
    }

    int getRecordInterval() {
        return record_interval;
    }

    reportMetrics(hash<DataProvider::PipelineMetricsSnapshot> snapshot) {
        ++callback_count;
    }

    shutdown() {
        shutdown_called = True;
    }
}

#! Metrics collector that retains all snapshots -- tests accumulation memory impact
class AccumulatingMetricsCollector inherits DataProvider::AbstractPipelineMetricsCollector {
    public {
        #! All received snapshots
        list<hash<DataProvider::PipelineMetricsSnapshot>> snapshots();

        #! Whether shutdown was called
        bool shutdown_called = False;
    }

    private {
        int record_interval;
    }

    constructor(int record_interval = 1000) {
        self.record_interval = record_interval;
    }

    int getIntervalMs() {
        return 0;
    }

    int getRecordInterval() {
        return record_interval;
    }

    reportMetrics(hash<DataProvider::PipelineMetricsSnapshot> snapshot) {
        push snapshots, snapshot;
    }

    shutdown() {
        shutdown_called = True;
    }
}

#! Metrics collector that simulates slow callback processing (e.g., event posting)
class SlowMetricsCollector inherits DataProvider::AbstractPipelineMetricsCollector {
    public {
        #! Number of times reportMetrics was called
        int callback_count = 0;

        #! Maximum concurrent threads observed during callbacks
        int max_threads = 0;

        #! Whether shutdown was called
        bool shutdown_called = False;
    }

    private {
        int record_interval;
        int delay_us;
    }

    #! @param record_interval record interval for reporting
    #! @param delay_ms delay in milliseconds to simulate slow callback work
    constructor(int record_interval = 1000, int delay_ms = 10) {
        self.record_interval = record_interval;
        self.delay_us = delay_ms * 1000;
    }

    int getIntervalMs() {
        return 0;
    }

    int getRecordInterval() {
        return record_interval;
    }

    reportMetrics(hash<DataProvider::PipelineMetricsSnapshot> snapshot) {
        ++callback_count;
        int t = num_threads();
        if (t > max_threads) {
            max_threads = t;
        }
        if (delay_us > 0) {
            usleep(delay_us);
        }
    }

    shutdown() {
        shutdown_called = True;
    }
}

#! Tests that the memory of a pipeline does not grow with the records and the pipelines that it processes
/** The test runs its memory test cases in a worker: a second run of this script in the same execution mode, in
    which every function is compiled to its final tier at a known point.  With \c QORE_IR_THRESHOLD=1,
    \c QORE_JIT_THRESHOLD=1 and \c QORE_JIT_SYNC_COMPILE=1, a function is compiled to native code in its first call
    (\c --exec-mode=jit) or its second one (\c --exec-mode=tiered, and the functions of modules with either), and the
    call waits until the compilation is done.  Each memory test case runs its code three times there and measures
    only the third run: the first two have compiled everything that it calls, so the memory that it measures is the
    pipeline's own and not that of the compiler.

    Without the worker, when a function was compiled depended on how often it had been called and on the load of
    the machine: functions of the imported modules are promoted when they are hot and compiled on a background
    thread, so the compiler's memory (several MiB with LLVM) landed in a measured window often enough to fail the
    test under load.

    \c QORE_JIT_TIMING traces every compilation on the worker's stderr, together with the start and the end of each
    measured window, so the test also checks that nothing was compiled while memory was measured.
*/
public class PipelineMemoryTest inherits QUnit::Test {
    public {
        const OptionColumn = 24;

        #! The environment variable that makes a run of this script the worker that runs the memory test cases
        const WorkerEnv = "QORE_PIPELINE_MEMORY_WORKER";

        #! The environment of the worker: compilation in a function's first or second call, synchronous and traced
        const WorkerEnvironment = "QORE_IR_THRESHOLD=1 QORE_JIT_THRESHOLD=1 QORE_JIT_SYNC_COMPILE=1 "
            "QORE_JIT_TIMING=1 " + WorkerEnv + "=1";

        #! The prefix of the line on the worker's stderr that starts a measured window
        const MeasureBegin = "[PipelineMemory] measuring: ";

        #! The prefix of the line on the worker's stderr that ends a measured window
        const MeasureEnd = "[PipelineMemory] measured: ";

        #! The number of runs of a memory test case that bring all of its code to its final tier before it is measured
        const WarmRuns = 2;

        #! Number of records for the main pipeline test
        int record_count;

        #! Maximum allowed RSS growth in bytes
        int max_rss_growth;

        #! Whether to enable verbose memory reporting
        bool verbose_memory;
    }

    private {
        #! The worker's stderr: the compilation trace and the measured windows
        string worker_trace;

        #! The worker's exit status
        int worker_rc = -1;
    }

    constructor() : Test("PipelineMemory Test", "1.0", \ARGV, Opts) {
        record_count = m_options."record-count" ?? 5000;
        max_rss_growth = m_options."max-rss-growth" ?? (5 * 1024 * 1024);
        verbose_memory = m_options."verbose-memory" ?? False;

%ifndef NoProcess
        if (ENV{WorkerEnv}) {
            addTestCase("single pipeline memory stability", sub () { runMeasured(\singlePipeline()); });
            addTestCase("repeated pipelines memory stability", sub () { runMeasured(\repeatedPipelines()); });
            addTestCase("multi-processor pipeline memory stability",
                sub () { runMeasured(\multiProcessorPipeline()); });
            addTestCase("pipeline record count validation", \recordCountValidationTest());
            addTestCase("metrics vs baseline comparison", sub () { runMeasured(\metricsVsBaseline()); });
            addTestCase("high-frequency metrics collection", sub () { runMeasured(\metricsHighFrequency()); });
            addTestCase("accumulating metrics collector", sub () { runMeasured(\metricsAccumulating()); });
            addTestCase("repeated pipelines with metrics", sub () { runMeasured(\metricsRepeatedPipelines()); });
            addTestCase("slow metrics callback", sub () { runMeasured(\metricsSlowCallback()); });
        } else {
            addTestCase("pipeline memory is stable with all of its code compiled before it is measured",
                \workerTest());
            addTestCase("nothing is compiled while pipeline memory is measured", \measuredWindowsTest());
        }
%else
        addTestCase("skip - no process module", sub () { testSkip("no process module present"); });
%endif

        set_return_value(main());
    }

    #! Test options: extends base QUnit opts with pipeline memory test options
    const Opts = QUnit::TestReporter::Opts + {
        "record-count": "R,record-count=i",
        "max-rss-growth": "M,max-rss-growth=i",
        "iterations": "I,iterations=i",
        "verbose-memory": "V,verbose-memory",
    };

    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-R,--record-count=N", "records per pipeline [default: 5000]", OptionColumn);
        printOption("-M,--max-rss-growth=N", "max RSS growth bytes [default: 5242880]", OptionColumn);
        printOption("-I,--iterations=N", "repeated pipeline iterations [default: 10]", OptionColumn);
        printOption("-V,--verbose-memory", "verbose memory diagnostics", OptionColumn);
    }

    #! Returns the given string quoted for a POSIX shell
    private static string shellQuote(string value) {
        return "'" + replace(value, "'", "'\"'\"'") + "'";
    }

    #! Returns the execution mode given on the command line, if any
    private static *string getExecMode() {
        for (int i = 0; i < QORE_ARGV.size(); ++i) {
            *string mode = (QORE_ARGV[i] =~ x/^--exec-mode=(.+)$/)[0];
            if (mode) {
                return mode;
            }
            if (QORE_ARGV[i] == "--exec-mode" && i + 1 < QORE_ARGV.size()) {
                return QORE_ARGV[i + 1];
            }
        }
    }

    #! Returns the command that runs this script as the worker
    /** The worker runs the same qore with the same options and arguments, but its compilation thresholds come from
        WorkerEnvironment, which a threshold given on the command line would override
    */
    private static string getWorkerCommand() {
        list<string> args;
        for (int i = 0; i < QORE_ARGV.size(); ++i) {
            string arg = QORE_ARGV[i];
            if (arg =~ /^--jit-(ir|jit)-threshold=/) {
                continue;
            }
            if (arg =~ /^--jit-(ir|jit)-threshold$/) {
                ++i;
                continue;
            }
            push args, shellQuote(arg);
        }
        return WorkerEnvironment + " " + args.join(" ");
    }

    #! Runs the memory test cases in the worker
    workerTest() {
        TmpDir tmp("qore-pipeline-memory-");
        string trace_path = tmp.path + "/worker.stderr";
        string out = backquote(getWorkerCommand() + " 2>" + shellQuote(trace_path), \worker_rc);
        worker_trace = ReadOnlyFile::readTextFile(trace_path) ?? "";
        # the worker's report, and what it wrote to stderr besides the compilation trace and its windows
        print(out);
        foreach string line in (worker_trace.split("\n")) {
            if (line && !ExecModeHarness::is_trace_line(line) && !line.equalPartial(MeasureBegin)
                    && !line.equalPartial(MeasureEnd)) {
                stderr.printf("%s\n", line);
            }
        }
        assertEq(0, worker_rc, "the memory test cases pass in the worker");
    }

    #! Checks the worker's trace: nothing is compiled while memory is measured
    measuredWindowsTest() {
        if (worker_rc < 0) {
            testSkip("the worker did not run");
        }
        *string window;
        int windows = 0;
        int compilations = 0;
        list<string> compiled_in_window = ();
        foreach string line in (worker_trace.split("\n")) {
            if (line.equalPartial(MeasureBegin)) {
                window = line.substr(MeasureBegin.size());
                ++windows;
            } else if (line.equalPartial(MeasureEnd)) {
                window = NOTHING;
            } else if (ExecModeHarness::is_trace_line(line)) {
                if (ExecModeHarness::is_native_compilation(line)) {
                    ++compilations;
                }
                if (window) {
                    push compiled_in_window, window + ": " + line;
                }
            }
        }
        assertGt(0, windows, "the worker measures memory");
        assertEq((), compiled_in_window, "nothing is compiled while memory is measured");
        if (inlist(getExecMode(), ("jit", "tiered"))) {
            assertGt(0, compilations, "the worker's code is compiled to native code before it is measured");
        }
    }

    #! Runs a memory test case: twice to compile all of its code, then once more, measured
    /** @param body the test case; its argument tells it whether this run is the one that is measured
    */
    private runMeasured(code<nothing(bool)> body) {
        for (int i = 0; i < WarmRuns; ++i) {
            body(False);
        }
        body(True);
    }

    #! Starts a window: returns the memory info that the growth is measured from
    /** The measured window is reported on stderr, where the worker's compilation trace goes

        @param name the window
        @param measured whether this run is the one that is measured
    */
    private hash<auto> openWindow(string name, bool measured) {
        if (measured) {
            stderr.printf("%s%s\n", MeasureBegin, name);
        }
        return getMemInfo();
    }

    #! Ends a window: returns the memory info that the growth is measured to
    /** @param name the window
        @param measured whether this run is the one that is measured
    */
    private hash<auto> closeWindow(string name, bool measured) {
        hash<auto> mem = getMemInfo();
        if (measured) {
            stderr.printf("%s%s\n", MeasureEnd, name);
        }
        return mem;
    }

    #! Returns a formatted memory size string
    private string fmtMem(int bytes) {
        if (bytes < 0) {
            return "-" + fmtMem(-bytes);
        }
        if (bytes >= 1024 * 1024 * 1024) {
            return sprintf("%.2f GiB", bytes / (1024.0 * 1024.0 * 1024.0));
        }
        if (bytes >= 1024 * 1024) {
            return sprintf("%.2f MiB", bytes / (1024.0 * 1024.0));
        }
        return sprintf("%.2f KiB", bytes / 1024.0);
    }

    #! Returns current memory info
    private hash<auto> getMemInfo() {
%ifndef NoProcess
        hash<auto> mem = Process::getMemorySummaryInfo();
        return {
            "rss": mem.rss,
            "vsz": mem.vsz,
            "threads": num_threads(),
        };
%else
        return {
            "rss": 0,
            "vsz": 0,
            "threads": num_threads(),
        };
%endif
    }

    #! Logs memory info if verbose mode is enabled
    private logMem(string label, hash<auto> mem_info) {
        if (verbose_memory || m_options.verbose > 2) {
            printf("  [%s] RSS: %s  VSZ: %s  threads: %d\n",
                label, fmtMem(mem_info.rss), fmtMem(mem_info.vsz), mem_info.threads);
        }
    }

    #! Logs a verbose message
    private logVerbose(string fmt) {
        if (verbose_memory || m_options.verbose > 2) {
            vprintf("  " + fmt + "\n", argv);
        }
    }

    #! Creates a GeneratorDataProvider record iterator with the given count
    private DataProvider::AbstractDataProviderRecordIterator getGeneratorIterator(int count) {
        GeneratorDataProvider::GeneratorGenerateRecordsDataProvider provider({
            "count": count,
            "strategy": "sequential",
        });
        return provider.searchRecords();
    }

    #! Logs the collected memory snapshots relative to the given baseline
    /** @param collector the collector holding the periodic memory snapshots
        @param mem_before memory info sampled before the pipeline ran
        @param desc a label for the snapshot listing
    */
    private logSnapshots(MemorySnapshotCollector collector, hash<auto> mem_before, string desc) {
        if (!collector.snapshots) {
            return;
        }
        logVerbose("%s (%d snapshots):", desc, collector.snapshots.size());
        foreach hash<auto> snap in (collector.snapshots) {
            logVerbose("  records: %d  RSS delta: %s  threads: %d",
                snap.records_submitted, fmtMem(snap.rss - mem_before.rss), snap.threads);
        }
    }

    #! Asserts that pipeline memory is stable, ignoring any one-time cost paid at the start of the run
    /** These tests exist to catch memory that grows with the record count.  Growth is measured over the
        steady-state window, from the midpoint snapshot to the last one: memory that grows with the record count
        keeps growing there, while a one-time cost at the start of the run does not.  The total growth is still
        reported, and is used for the assertion when too few snapshots were collected to give a steady-state
        window.

        @param collector the collector holding the periodic memory snapshots
        @param mem_before memory info sampled before the pipeline ran
        @param mem_after memory info sampled after the pipeline completed
        @param desc describes the pipeline in assertion failures
        @param measured whether this run is the one that is measured; the other runs are not asserted
    */
    private assertPipelineMemoryStable(MemorySnapshotCollector collector, hash<auto> mem_before,
            hash<auto> mem_after, string desc, bool measured) {
        int total_growth = mem_after.rss - mem_before.rss;

        # fewer than three snapshots leaves no steady-state window to measure
        if (collector.snapshots.size() < 3) {
            logVerbose("%s: total RSS growth: %s (limit: %s; too few snapshots for a steady-state window)",
                desc, fmtMem(total_growth), fmtMem(max_rss_growth));
            if (measured) {
                assertTrue(total_growth < max_rss_growth,
                    sprintf("%s: RSS growth %s should be less than %s", desc, fmtMem(total_growth),
                        fmtMem(max_rss_growth)));
            }
            return;
        }

        int mid_idx = collector.snapshots.size() / 2;
        int steady_growth = collector.snapshots[collector.snapshots.size() - 1].rss
            - collector.snapshots[mid_idx].rss;
        logVerbose("%s: steady-state RSS growth over the last %d of %d snapshots: %s (limit: %s; "
            "total growth including one-time costs: %s)", desc, collector.snapshots.size() - mid_idx,
            collector.snapshots.size(), fmtMem(steady_growth), fmtMem(max_rss_growth), fmtMem(total_growth));
        if (measured) {
            assertTrue(steady_growth < max_rss_growth,
                sprintf("%s: steady-state RSS growth %s should be less than %s (total growth: %s)", desc,
                    fmtMem(steady_growth), fmtMem(max_rss_growth), fmtMem(total_growth)));
        }
    }

    #! Test: single pipeline with large record count should have stable memory
    private singlePipeline(bool measured) {
        logVerbose("single pipeline test: %d records", record_count);

        hash<auto> mem_before = openWindow("single pipeline", measured);
        logMem("before", mem_before);

        MemorySnapshotCollector collector(record_count > 10000 ? (record_count / 10) : 1000);

        hash<PipelineOptionInfo> opts = <PipelineOptionInfo>{
            "name": "single-pipeline-memory-test",
            "metrics_collector": collector,
        };

        DataProviderPipeline pipe(opts);
        pipe.append(new PassthroughProcessor());

        pipe.submit(getGeneratorIterator(record_count));
        pipe.waitDone();

        hash<PipelineInfo> info = pipe.getInfo();
        assertEq(record_count, info.record_count);
        assertTrue(collector.shutdown_called, "metrics collector shutdown should be called");

        hash<auto> mem_after = closeWindow("single pipeline", measured);
        logMem("after", mem_after);

        logVerbose("throughput: %.1f records/sec", info.recs_per_sec);
        logSnapshots(collector, mem_before, "memory snapshots during pipeline execution");
        assertPipelineMemoryStable(collector, mem_before, mem_after, "single pipeline", measured);
    }

    #! Test: repeated pipeline creation/destruction should not leak memory
    private repeatedPipelines(bool measured) {
        int iterations = m_options.iterations > 0 ? m_options.iterations : 10;
        int records_per_pipeline = record_count > 50000 ? 2000 : (record_count / 25 > 0 ? record_count / 25 : 100);
        logVerbose("repeated pipelines test: %d iterations x %d records", iterations, records_per_pipeline);

        hash<auto> mem_before = openWindow("repeated pipelines", measured);
        logMem("before", mem_before);

        list<int> rss_samples();

        for (int iter = 0; iter < iterations; ++iter) {
            {
                DataProviderPipeline pipe(<PipelineOptionInfo>{
                    "name": sprintf("repeated-pipeline-%d", iter),
                });
                pipe.append(new PassthroughProcessor());
                pipe.submit(getGeneratorIterator(records_per_pipeline));
                pipe.waitDone();

                assertEq(records_per_pipeline, pipe.getInfo().record_count);
            }

            if ((iter + 1) % 10 == 0) {
                hash<auto> mem_now = getMemInfo();
                push rss_samples, mem_now.rss;
                logMem(sprintf("iter %d", iter + 1), mem_now);
            }
        }

        hash<auto> mem_after = closeWindow("repeated pipelines", measured);
        logMem("after", mem_after);

        int rss_growth = mem_after.rss - mem_before.rss;
        logVerbose("RSS growth over %d iterations: %s (limit: %s)",
            iterations, fmtMem(rss_growth), fmtMem(max_rss_growth));

        # assert bounded memory growth across all iterations
        if (measured) {
            assertTrue(rss_growth < max_rss_growth,
                sprintf("RSS growth %s across %d pipeline iterations should be less than %s",
                    fmtMem(rss_growth), iterations, fmtMem(max_rss_growth)));
        }

        # check that late samples are not significantly larger than early samples
        if (rss_samples.size() >= 4) {
            int early_avg = (rss_samples[0] + rss_samples[1]) / 2;
            int late_avg = (rss_samples[rss_samples.size() - 2] + rss_samples[rss_samples.size() - 1]) / 2;
            int late_growth = late_avg - early_avg;
            logVerbose("early avg RSS: %s, late avg RSS: %s, late growth: %s",
                fmtMem(early_avg), fmtMem(late_avg), fmtMem(late_growth));
        }
    }

    #! Test: multi-processor pipeline should have stable memory with chained processors
    private multiProcessorPipeline(bool measured) {
        logVerbose("multi-processor pipeline test: %d records, 3 processors", record_count);

        hash<auto> mem_before = openWindow("multi-processor pipeline", measured);
        logMem("before", mem_before);

        MemorySnapshotCollector collector(record_count > 10000 ? (record_count / 10) : 1000);

        hash<PipelineOptionInfo> opts = <PipelineOptionInfo>{
            "name": "multi-processor-memory-test",
            "metrics_collector": collector,
        };

        DataProviderPipeline pipe(opts);
        pipe.append(new PassthroughProcessor());
        pipe.append(new TransformProcessor());
        pipe.append(new PassthroughProcessor());

        pipe.submit(getGeneratorIterator(record_count));
        pipe.waitDone();

        hash<PipelineInfo> info = pipe.getInfo();
        assertEq(record_count, info.record_count);
        assertTrue(collector.shutdown_called, "metrics collector shutdown should be called");

        hash<auto> mem_after = closeWindow("multi-processor pipeline", measured);
        logMem("after", mem_after);

        logVerbose("throughput: %.1f records/sec", info.recs_per_sec);
        logSnapshots(collector, mem_before, "memory snapshots");
        assertPipelineMemoryStable(collector, mem_before, mem_after, "multi-processor pipeline", measured);
    }

    #! Test: validate that pipeline actually processes the correct number of records from the generator
    recordCountValidationTest() {
        int test_count = 1000;
        logVerbose("record count validation test: %d records", test_count);

        # use a counting processor to verify exact record count
        CountingProcessor counter();

        DataProviderPipeline pipe(<PipelineOptionInfo>{
            "name": "record-count-validation",
        });
        pipe.append(counter);

        pipe.submit(getGeneratorIterator(test_count));
        pipe.waitDone();

        hash<PipelineInfo> info = pipe.getInfo();
        assertEq(test_count, info.record_count, "pipeline should report correct record count");
        assertEq(test_count, counter.count, "processor should receive exactly the right number of records");

        # verify record content from sequential generator
        assertTrue(counter.first_record.hasKey("id"), "generated record should have 'id' field");
        assertTrue(counter.first_record.hasKey("name"), "generated record should have 'name' field");
        assertTrue(counter.first_record.hasKey("value"), "generated record should have 'value' field");
        assertTrue(counter.first_record.hasKey("active"), "generated record should have 'active' field");
        assertTrue(counter.first_record.hasKey("created"), "generated record should have 'created' field");
        assertEq(0, counter.first_record.id, "first record id should be 0 for sequential strategy");
    }

    # =====================================================================
    # Metrics collection memory impact tests
    # =====================================================================

    #! Runs a pipeline with a passthrough processor and optional metrics collector, returns RSS delta
    private hash<auto> runPipelineAndMeasure(string name, int count, *AbstractPipelineMetricsCollector collector,
            bool measured) {
        hash<auto> mem_before = openWindow(name, measured);

        hash<PipelineOptionInfo> opts = <PipelineOptionInfo>{
            "name": name,
        };
        if (collector) {
            opts.metrics_collector = collector;
        }

        DataProviderPipeline pipe(opts);
        pipe.append(new PassthroughProcessor());
        pipe.submit(getGeneratorIterator(count));
        pipe.waitDone();

        hash<PipelineInfo> info = pipe.getInfo();
        hash<auto> mem_after = closeWindow(name, measured);

        return {
            "rss_before": mem_before.rss,
            "rss_after": mem_after.rss,
            "rss_growth": mem_after.rss - mem_before.rss,
            "record_count": info.record_count,
            "recs_per_sec": info.recs_per_sec,
        };
    }

    #! Test: compare same workload with and without metrics to isolate collection overhead
    private metricsVsBaseline(bool measured) {
        logVerbose("metrics vs baseline: %d records", record_count);

        # Short pipeline benchmarks are sensitive to scheduler noise on shared runners. Measure five paired
        # samples, alternate their execution order, and compare the median rather than allowing transient
        # scheduling delay or a consistent first-run advantage to fail the suite.
        list<float> throughput_overheads;
        for (int sample = 1; sample <= 5; ++sample) {
            LightweightMetricsCollector lw_collector(1000);
            hash<auto> baseline;
            hash<auto> with_metrics;
            if (sample % 2) {
                baseline = runPipelineAndMeasure(sprintf("baseline-no-metrics-%d", sample), record_count, NOTHING,
                    measured);
                with_metrics = runPipelineAndMeasure(
                    sprintf("with-lightweight-metrics-%d", sample), record_count, lw_collector, measured);
            } else {
                with_metrics = runPipelineAndMeasure(
                    sprintf("with-lightweight-metrics-%d", sample), record_count, lw_collector, measured);
                baseline = runPipelineAndMeasure(sprintf("baseline-no-metrics-%d", sample), record_count, NOTHING,
                    measured);
            }

            logVerbose("sample %d baseline (no metrics): RSS growth %s, %.1f rec/s", sample,
                fmtMem(baseline.rss_growth), baseline.recs_per_sec);
            assertEq(record_count, baseline.record_count);

            logVerbose("sample %d with metrics (interval=1000): RSS growth %s, %.1f rec/s, %d callbacks", sample,
                fmtMem(with_metrics.rss_growth), with_metrics.recs_per_sec, lw_collector.callback_count);
            assertEq(record_count, with_metrics.record_count);
            assertTrue(lw_collector.shutdown_called, "collector shutdown should be called");
            assertTrue(lw_collector.callback_count > 0, "should have received metrics callbacks");

            # the metrics overhead should not exceed the memory threshold in any sample
            if (measured) {
                assertTrue(with_metrics.rss_growth < max_rss_growth,
                    sprintf("metrics-enabled RSS growth %s should be less than %s",
                        fmtMem(with_metrics.rss_growth), fmtMem(max_rss_growth)));
            }

            int rss_overhead = with_metrics.rss_growth - baseline.rss_growth;
            logVerbose("sample %d metrics overhead (RSS delta): %s", sample, fmtMem(rss_overhead));

            if (baseline.recs_per_sec > 0.0) {
                float throughput_overhead_pct = ((baseline.recs_per_sec - with_metrics.recs_per_sec)
                    / baseline.recs_per_sec) * 100.0;
                push throughput_overheads, throughput_overhead_pct;
                logVerbose("sample %d throughput overhead: %.1f%%", sample, throughput_overhead_pct);
            }
        }

        # Verify median throughput overhead is within acceptable range.
        # NOTE: The overhead target is 70% for this no-op passthrough benchmark, where
        # per-record Qore interpreter operations dominate (~12 ops at ~3μs each = ~34μs).
        # For real-world pipelines with processors doing meaningful work (>100μs each),
        # the metrics overhead is <5%.  CI variability can add ~10-15% noise on shared
        # runners, so the threshold includes margin for that.
        if (measured && throughput_overheads) {
            list<float> sorted_overheads = sort(throughput_overheads);
            float median_overhead_pct = sorted_overheads[sorted_overheads.size() / 2];
            logVerbose("median throughput overhead: %.1f%% from samples %y (target: < 70%%)",
                median_overhead_pct, throughput_overheads);
            assertTrue(median_overhead_pct < 70.0,
                sprintf("median metrics throughput overhead %.1f%% must be less than 70%%",
                    median_overhead_pct));
        }
    }

    #! Test: high-frequency metrics reporting to stress snapshot creation and GC
    private metricsHighFrequency(bool measured) {
        # report every 100 records -- creates many snapshots
        int interval = 100;
        logVerbose("high-frequency metrics: %d records, interval=%d", record_count, interval);

        hash<auto> mem_before = openWindow("high-frequency metrics", measured);
        logMem("before", mem_before);

        LightweightMetricsCollector collector(interval);

        DataProviderPipeline pipe(<PipelineOptionInfo>{
            "name": "high-frequency-metrics",
            "metrics_collector": collector,
        });
        pipe.append(new PassthroughProcessor());
        pipe.submit(getGeneratorIterator(record_count));
        pipe.waitDone();

        hash<auto> mem_after = closeWindow("high-frequency metrics", measured);
        logMem("after", mem_after);

        int rss_growth = mem_after.rss - mem_before.rss;
        logVerbose("RSS growth: %s (limit: %s)", fmtMem(rss_growth), fmtMem(max_rss_growth));
        logVerbose("callbacks: %d (expected ~%d)", collector.callback_count, record_count / interval);
        logVerbose("throughput: %.1f rec/s", pipe.getInfo().recs_per_sec);

        assertEq(record_count, pipe.getInfo().record_count);
        assertTrue(collector.shutdown_called);
        # should have roughly record_count/interval callbacks (may vary due to timing)
        assertTrue(collector.callback_count >= record_count / interval / 2,
            sprintf("expected at least %d callbacks, got %d", record_count / interval / 2,
                collector.callback_count));

        if (measured) {
            assertTrue(rss_growth < max_rss_growth,
                sprintf("high-frequency metrics RSS growth %s should be less than %s",
                    fmtMem(rss_growth), fmtMem(max_rss_growth)));
        }
    }

    #! Test: accumulating metrics collector that retains all snapshots
    private metricsAccumulating(bool measured) {
        # report every 500 records; all snapshots are retained in memory
        int interval = 500;
        logVerbose("accumulating metrics: %d records, interval=%d", record_count, interval);

        hash<auto> mem_before = openWindow("accumulating metrics", measured);
        logMem("before", mem_before);

        AccumulatingMetricsCollector collector(interval);

        DataProviderPipeline pipe(<PipelineOptionInfo>{
            "name": "accumulating-metrics",
            "metrics_collector": collector,
        });
        pipe.append(new PassthroughProcessor());
        pipe.submit(getGeneratorIterator(record_count));
        pipe.waitDone();

        hash<auto> mem_after = closeWindow("accumulating metrics", measured);
        logMem("after", mem_after);

        int rss_growth = mem_after.rss - mem_before.rss;
        logVerbose("RSS growth: %s (limit: %s)", fmtMem(rss_growth), fmtMem(max_rss_growth));
        logVerbose("snapshots retained: %d", collector.snapshots.size());

        assertEq(record_count, pipe.getInfo().record_count);
        assertTrue(collector.shutdown_called);
        assertTrue(collector.snapshots.size() > 0, "should have accumulated snapshots");

        # verify snapshot data is consistent
        hash<PipelineMetricsSnapshot> last = collector.snapshots[collector.snapshots.size() - 1];
        assertTrue(last.total_records_submitted > 0);
        assertEq("accumulating-metrics", last.pipeline_name);

        if (measured) {
            assertTrue(rss_growth < max_rss_growth,
                sprintf("accumulating metrics RSS growth %s should be less than %s",
                    fmtMem(rss_growth), fmtMem(max_rss_growth)));
        }

        # now release the snapshots and measure RSS to see if memory is recovered
        int snapshot_count = collector.snapshots.size();
        remove collector.snapshots;
        collector.snapshots = ();
        hash<auto> mem_released = getMemInfo();
        logVerbose("after releasing %d snapshots: RSS delta %s",
            snapshot_count, fmtMem(mem_released.rss - mem_after.rss));
    }

    #! Test: repeated pipeline creation/destruction with metrics collector on each
    private metricsRepeatedPipelines(bool measured) {
        int iterations = m_options.iterations > 0 ? m_options.iterations : 10;
        int records_per_pipeline = record_count > 50000 ? 2000 : (record_count / 25 > 0 ? record_count / 25 : 100);
        int interval = records_per_pipeline > 200 ? (records_per_pipeline / 5) : 50;
        logVerbose("repeated pipelines with metrics: %d iterations x %d records, interval=%d",
            iterations, records_per_pipeline, interval);

        hash<auto> mem_before = openWindow("repeated pipelines with metrics", measured);
        logMem("before", mem_before);

        list<int> rss_samples();
        int total_callbacks = 0;

        for (int iter = 0; iter < iterations; ++iter) {
            {
                LightweightMetricsCollector collector(interval);
                DataProviderPipeline pipe(<PipelineOptionInfo>{
                    "name": sprintf("repeated-metrics-pipeline-%d", iter),
                    "metrics_collector": collector,
                });
                pipe.append(new PassthroughProcessor());
                pipe.submit(getGeneratorIterator(records_per_pipeline));
                pipe.waitDone();

                assertEq(records_per_pipeline, pipe.getInfo().record_count);
                assertTrue(collector.shutdown_called);
                total_callbacks += collector.callback_count;
            }

            if ((iter + 1) % 10 == 0) {
                hash<auto> mem_now = getMemInfo();
                push rss_samples, mem_now.rss;
                logMem(sprintf("iter %d", iter + 1), mem_now);
            }
        }

        hash<auto> mem_after = closeWindow("repeated pipelines with metrics", measured);
        logMem("after", mem_after);

        int rss_growth = mem_after.rss - mem_before.rss;
        logVerbose("RSS growth over %d iterations: %s (limit: %s)",
            iterations, fmtMem(rss_growth), fmtMem(max_rss_growth));
        logVerbose("total callbacks across all pipelines: %d", total_callbacks);

        if (measured) {
            assertTrue(rss_growth < max_rss_growth,
                sprintf("repeated pipelines with metrics RSS growth %s should be less than %s",
                    fmtMem(rss_growth), fmtMem(max_rss_growth)));
        }

        # check for upward trend in RSS samples
        if (rss_samples.size() >= 4) {
            int early_avg = (rss_samples[0] + rss_samples[1]) / 2;
            int late_avg = (rss_samples[rss_samples.size() - 2] + rss_samples[rss_samples.size() - 1]) / 2;
            int late_growth = late_avg - early_avg;
            logVerbose("early avg RSS: %s, late avg RSS: %s, trend: %s",
                fmtMem(early_avg), fmtMem(late_avg), fmtMem(late_growth));
        }
    }

    #! Test: slow metrics callback simulating real-world event posting latency
    private metricsSlowCallback(bool measured) {
        # use a smaller record count for the slow callback test to keep runtime reasonable
        int slow_count = record_count;
        int interval = 1000;
        int delay_ms = 10;
        logVerbose("slow metrics callback: %d records, interval=%d, delay=%dms",
            slow_count, interval, delay_ms);

        hash<auto> mem_before = openWindow("slow metrics callback", measured);
        logMem("before", mem_before);

        SlowMetricsCollector collector(interval, delay_ms);

        DataProviderPipeline pipe(<PipelineOptionInfo>{
            "name": "slow-callback-metrics",
            "metrics_collector": collector,
        });
        pipe.append(new PassthroughProcessor());
        pipe.submit(getGeneratorIterator(slow_count));
        pipe.waitDone();

        hash<auto> mem_after = closeWindow("slow metrics callback", measured);
        logMem("after", mem_after);

        int rss_growth = mem_after.rss - mem_before.rss;
        logVerbose("RSS growth: %s (limit: %s)", fmtMem(rss_growth), fmtMem(max_rss_growth));
        logVerbose("callbacks: %d, max threads: %d", collector.callback_count, collector.max_threads);
        logVerbose("throughput: %.1f rec/s", pipe.getInfo().recs_per_sec);

        assertEq(slow_count, pipe.getInfo().record_count);
        assertTrue(collector.shutdown_called);
        assertTrue(collector.callback_count > 0, "should have received callbacks");

        if (measured) {
            assertTrue(rss_growth < max_rss_growth,
                sprintf("slow callback metrics RSS growth %s should be less than %s",
                    fmtMem(rss_growth), fmtMem(max_rss_growth)));
        }
    }
}

#! Processor that counts records without accumulating them
class CountingProcessor inherits DataProvider::AbstractDataProcessor {
    public {
        int count = 0;
        *hash<auto> first_record;
        *hash<auto> last_record;
    }

    private submitImpl(code<nothing(auto)> enqueue, auto _data) {
        if (!count) {
            first_record = _data;
        }
        last_record = _data;
        ++count;
        enqueue(_data);
    }

    private bool supportsBulkApiImpl() {
        return False;
    }
}
