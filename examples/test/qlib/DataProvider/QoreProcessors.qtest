%modern
%strict-args
%require-types
%enable-all-warnings

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Mime.qm
%requires ../../../../qlib/DataProvider

%exec-class QoreProcessorsTest

#! A simple data provider that does NOT support pipeline processor
class NonProcessorDataProvider inherits DataProvider::AbstractDataProvider {
    string getName() {
        return "non-processor";
    }

    *string getDesc() {
        return "A test data provider that does not support the pipeline processor API";
    }

    hash<DataProviderInfo> getStaticInfoImpl() {
        return <DataProviderInfo>{
            "type": "NonProcessorDataProvider",
        };
    }
}

#! Simple sink processor for collecting pipeline output
class TestSinkProcessor inherits DataProvider::AbstractDataProcessor {
    public {
        list<auto> results;
    }

    private submitImpl(code enqueue, auto _data) {
        push results, _data;
    }

    private bool supportsBulkApiImpl() {
        return False;
    }
}

class QoreProcessorsTest inherits QUnit::Test {
    constructor() : Test("QoreProcessorsTest", "1.0") {
        addTestCase("filter - where_cond matching", \filterWhereCondMatch());
        addTestCase("filter - where_cond non-matching", \filterWhereCondNoMatch());
        addTestCase("filter - where_cond complex expression", \filterWhereCondComplex());
        addTestCase("filter - no options error", \filterNoOptions());

        addTestCase("select-fields - keep fields", \selectFieldsKeep());
        addTestCase("select-fields - rename fields", \selectFieldsRename());
        addTestCase("select-fields - combined keep and rename", \selectFieldsCombined());
        addTestCase("select-fields - empty fields error", \selectFieldsEmpty());

        addTestCase("set-fields - add new fields", \setFieldsAddNew());
        addTestCase("set-fields - overwrite existing fields", \setFieldsOverwrite());
        addTestCase("set-fields - multiple fields", \setFieldsMultiple());

        addTestCase("remove-fields - remove single field", \removeFieldsSingle());
        addTestCase("remove-fields - remove multiple fields", \removeFieldsMultiple());

        addTestCase("search-replace - literal replacement", \searchReplaceLiteral());
        addTestCase("search-replace - regex replacement", \searchReplaceRegex());
        addTestCase("search-replace - global vs first-only", \searchReplaceGlobalVsFirst());
        addTestCase("search-replace - regex with multiple options", \searchReplaceMultipleOptions());
        addTestCase("search-replace - invalid regex option", \searchReplaceInvalidOption());
        addTestCase("search-replace - field not present", \searchReplaceFieldMissing());

        addTestCase("record-limit - pass N records", \recordLimitPass());
        addTestCase("record-limit - drop after limit", \recordLimitDrop());
        addTestCase("record-limit - zero limit", \recordLimitZero());

        addTestCase("pipeline - filter + select + set chain", \pipelineFilterSelectSet());
        addTestCase("pipeline - all processors mixed", \pipelineAllProcessors());

        addTestCase("app registration", \appRegistration());
        addTestCase("action registration", \actionRegistration());

        addTestCase("data provider navigation - factory exists", \navigationFactory());
        addTestCase("data provider navigation - children", \navigationChildren());
        addTestCase("data provider navigation - child info", \navigationChildInfo());

        addTestCase("filter - where_cond expression builder", \filterWhereCond());

        addTestCase("pipeline processor type API - input/output types", \pipelineProcessorTypeApi());
        addTestCase("pipeline processor type API - with options", \pipelineProcessorTypeApiWithOptions());
        addTestCase("pipeline processor type API - guard throws", \pipelineProcessorTypeApiGuard());

        addTestCase("dynamic options - filter action", \dynamicOptionsFilterAction());
        addTestCase("dynamic options - pipeline processor dispatch", \dynamicOptionsPipelineProcessorDispatch());

        addTestCase("RegularExpressionArgInfo - RE_Global present", \regexArgInfoReGlobal());

        set_return_value(main());
    }

    # --- Filter Tests ---

    filterWhereCondMatch() {
        hash<DataProviderExpression> expr = <DataProviderExpression>{
            "exp": "==",
            "args": (<DataProviderFieldReference>{"field": "status"}, "active"),
        };
        QoreFilterRecordsProcessor proc({"where_cond": expr});
        hash<auto> record = {"name": "Alice", "status": "active", "amount": 100};
        assertEq(record, proc.processRecord(record));
    }

    filterWhereCondNoMatch() {
        hash<DataProviderExpression> expr = <DataProviderExpression>{
            "exp": "==",
            "args": (<DataProviderFieldReference>{"field": "status"}, "active"),
        };
        QoreFilterRecordsProcessor proc({"where_cond": expr});
        hash<auto> record = {"name": "Bob", "status": "inactive", "amount": 50};
        assertNothing(proc.processRecord(record));
    }

    filterWhereCondComplex() {
        # AND with two conditions
        hash<DataProviderExpression> expr = <DataProviderExpression>{
            "exp": "&&",
            "args": (
                <DataProviderExpression>{
                    "exp": "==",
                    "args": (<DataProviderFieldReference>{"field": "status"}, "active"),
                },
                <DataProviderExpression>{
                    "exp": ">",
                    "args": (<DataProviderFieldReference>{"field": "amount"}, 100),
                },
            ),
        };
        QoreFilterRecordsProcessor proc({"where_cond": expr});

        assertEq({"status": "active", "amount": 200},
            proc.processRecord({"status": "active", "amount": 200}));
        assertNothing(proc.processRecord({"status": "active", "amount": 50}));
        assertNothing(proc.processRecord({"status": "inactive", "amount": 200}));
    }

    filterNoOptions() {
        # a filter with no options is valid for navigation, but processRecord should throw
        QoreFilterRecordsProcessor proc();
        assertThrows("PROCESSOR-ERROR", sub () {
            proc.processRecord({"a": 1});
        });
    }

    # --- Select Fields Tests ---

    selectFieldsKeep() {
        QoreSelectFieldsProcessor proc({"fields": "name,email"});
        hash<auto> record = {"name": "Alice", "email": "a@b.com", "age": 30, "role": "admin"};
        hash<auto> expected = {"name": "Alice", "email": "a@b.com"};
        assertEq(expected, proc.processRecord(record));
    }

    selectFieldsRename() {
        QoreSelectFieldsProcessor proc({"fields": "customer_name=name,customer_email=email"});
        hash<auto> record = {"name": "Alice", "email": "a@b.com", "age": 30};
        hash<auto> expected = {"customer_name": "Alice", "customer_email": "a@b.com"};
        assertEq(expected, proc.processRecord(record));
    }

    selectFieldsCombined() {
        QoreSelectFieldsProcessor proc({"fields": "name,customer_email=email"});
        hash<auto> record = {"name": "Alice", "email": "a@b.com", "age": 30};
        hash<auto> expected = {"name": "Alice", "customer_email": "a@b.com"};
        assertEq(expected, proc.processRecord(record));
    }

    selectFieldsEmpty() {
        assertThrows("CONSTRUCTOR-ERROR", sub () {
            new QoreSelectFieldsProcessor({"fields": ",,,"});
        });
    }

    # --- Set Fields Tests ---

    setFieldsAddNew() {
        QoreSetFieldsProcessor proc({"fields": {"source": "pipeline"}});
        hash<auto> record = {"name": "Alice", "age": 30};
        hash<auto> expected = {"name": "Alice", "age": 30, "source": "pipeline"};
        assertEq(expected, proc.processRecord(record));
    }

    setFieldsOverwrite() {
        QoreSetFieldsProcessor proc({"fields": {"age": 25}});
        hash<auto> record = {"name": "Alice", "age": 30};
        hash<auto> expected = {"name": "Alice", "age": 25};
        assertEq(expected, proc.processRecord(record));
    }

    setFieldsMultiple() {
        QoreSetFieldsProcessor proc({"fields": {"source": "pipeline", "processed": True, "version": 2}});
        hash<auto> record = {"name": "Alice"};
        hash<auto> expected = {"name": "Alice", "source": "pipeline", "processed": True, "version": 2};
        assertEq(expected, proc.processRecord(record));
    }

    # --- Remove Fields Tests ---

    removeFieldsSingle() {
        QoreRemoveFieldsProcessor proc({"fields": "age"});
        hash<auto> record = {"name": "Alice", "age": 30, "email": "a@b.com"};
        hash<auto> expected = {"name": "Alice", "email": "a@b.com"};
        assertEq(expected, proc.processRecord(record));
    }

    removeFieldsMultiple() {
        QoreRemoveFieldsProcessor proc({"fields": "age,email"});
        hash<auto> record = {"name": "Alice", "age": 30, "email": "a@b.com"};
        hash<auto> expected = {"name": "Alice"};
        assertEq(expected, proc.processRecord(record));
    }

    # --- Search Replace Tests ---

    searchReplaceLiteral() {
        QoreSearchReplaceProcessor proc({
            "field": "name",
            "search": "Alice",
            "replace": "Bob",
            "regex_options": ("RE_Global",),
        });
        hash<auto> record = {"name": "Alice Smith", "age": 30};
        hash<auto> expected = {"name": "Bob Smith", "age": 30};
        assertEq(expected, proc.processRecord(record));
    }

    searchReplaceRegex() {
        QoreSearchReplaceProcessor proc({
            "field": "email",
            "search": "@old\\.com$",
            "replace": "@new.com",
            "is_regex": True,
        });
        hash<auto> record = {"name": "Alice", "email": "alice@old.com"};
        hash<auto> expected = {"name": "Alice", "email": "alice@new.com"};
        assertEq(expected, proc.processRecord(record));
    }

    searchReplaceGlobalVsFirst() {
        # global replacement using regex_options
        {
            QoreSearchReplaceProcessor proc({
                "field": "text",
                "search": "foo",
                "replace": "bar",
                "regex_options": ("RE_Global",),
            });
            hash<auto> record = {"text": "foo and foo"};
            assertEq({"text": "bar and bar"}, proc.processRecord(record));
        }
        # first-only replacement (no regex_options / no RE_Global)
        {
            QoreSearchReplaceProcessor proc({
                "field": "text",
                "search": "foo",
                "replace": "bar",
            });
            hash<auto> record = {"text": "foo and foo"};
            assertEq({"text": "bar and foo"}, proc.processRecord(record));
        }
    }

    searchReplaceMultipleOptions() {
        # regex with RE_Global + RE_Caseless
        QoreSearchReplaceProcessor proc({
            "field": "text",
            "search": "hello",
            "replace": "hi",
            "is_regex": True,
            "regex_options": ("RE_Global", "RE_Caseless"),
        });
        hash<auto> record = {"text": "Hello HELLO hello"};
        assertEq({"text": "hi hi hi"}, proc.processRecord(record));
    }

    searchReplaceInvalidOption() {
        assertThrows("OPTION-VALUE-ERROR", sub () {
            new QoreSearchReplaceProcessor({
                "field": "text",
                "search": "x",
                "replace": "y",
                "regex_options": ("RE_Invalid",),
            });
        });
    }

    searchReplaceFieldMissing() {
        QoreSearchReplaceProcessor proc({
            "field": "missing_field",
            "search": "x",
            "replace": "y",
        });
        hash<auto> record = {"name": "Alice"};
        # record should pass through unchanged
        assertEq(record, proc.processRecord(record));
    }

    # --- Record Limit Tests ---

    recordLimitPass() {
        QoreRecordLimitProcessor proc({"limit": 3});
        list<auto> results;
        for (int i = 0; i < 3; ++i) {
            auto result = proc.processRecord({"i": i});
            if (exists result) {
                push results, result;
            }
        }
        assertEq(3, results.size());
        assertEq(0, results[0].i);
        assertEq(1, results[1].i);
        assertEq(2, results[2].i);
    }

    recordLimitDrop() {
        QoreRecordLimitProcessor proc({"limit": 2});
        assertEq({"i": 0}, proc.processRecord({"i": 0}));
        assertEq({"i": 1}, proc.processRecord({"i": 1}));
        assertNothing(proc.processRecord({"i": 2}));
        assertNothing(proc.processRecord({"i": 3}));
    }

    recordLimitZero() {
        QoreRecordLimitProcessor proc({"limit": 0});
        assertNothing(proc.processRecord({"i": 0}));
        assertNothing(proc.processRecord({"i": 1}));
    }

    # --- Pipeline Integration Tests ---

    pipelineFilterSelectSet() {
        # chain filter -> select -> set using DataProviderPipeline
        hash<DataProviderExpression> expr = <DataProviderExpression>{
            "exp": "==",
            "args": (<DataProviderFieldReference>{"field": "status"}, "active"),
        };
        QoreFilterRecordsProcessor filter({"where_cond": expr});
        QoreSelectFieldsProcessor sel({"fields": "name,amount"});
        QoreSetFieldsProcessor setter({"fields": {"processed": True}});
        TestSinkProcessor sink();

        DataProviderPipeline pipeline();
        pipeline.append(filter);
        pipeline.append(sel);
        pipeline.append(setter);
        pipeline.append(sink);

        list<hash<auto>> input = (
            {"name": "Alice", "status": "active", "amount": 100, "extra": "x"},
            {"name": "Bob", "status": "inactive", "amount": 200, "extra": "y"},
            {"name": "Carol", "status": "active", "amount": 300, "extra": "z"},
        );

        foreach hash<auto> rec in (input) {
            pipeline.submit(rec);
        }
        pipeline.waitDone();

        assertEq(2, sink.results.size());
        assertEq({"name": "Alice", "amount": 100, "processed": True}, sink.results[0]);
        assertEq({"name": "Carol", "amount": 300, "processed": True}, sink.results[1]);
    }

    pipelineAllProcessors() {
        # chain all 6 processors using processRecord() for deterministic testing
        hash<DataProviderExpression> expr = <DataProviderExpression>{
            "exp": "==",
            "args": (<DataProviderFieldReference>{"field": "active"}, True),
        };
        QoreFilterRecordsProcessor filter({"where_cond": expr});
        QoreSelectFieldsProcessor sel({"fields": "name,desc"});
        QoreSetFieldsProcessor setter({"fields": {"source": "test"}});
        QoreRemoveFieldsProcessor remover({"fields": "desc"});
        QoreSearchReplaceProcessor replacer({
            "field": "name",
            "search": "User",
            "replace": "Person",
            "regex_options": ("RE_Global",),
        });
        QoreRecordLimitProcessor limiter({"limit": 2});

        list<AbstractDataProcessor> processors = (filter, sel, setter, remover, replacer, limiter);

        list<hash<auto>> input = (
            {"name": "User1", "active": True, "desc": "first"},
            {"name": "User2", "active": False, "desc": "second"},
            {"name": "User3", "active": True, "desc": "third"},
            {"name": "User4", "active": True, "desc": "fourth"},
        );

        list<auto> results;
        foreach hash<auto> rec in (input) {
            auto current = rec;
            foreach AbstractDataProcessor proc in (processors) {
                if (!exists current) {
                    break;
                }
                current = proc.processRecord(current);
            }
            if (exists current) {
                push results, current;
            }
        }

        assertEq(2, results.size());
        assertEq({"name": "Person1", "source": "test"}, results[0]);
        assertEq({"name": "Person3", "source": "test"}, results[1]);
    }

    # --- App and Action Catalog Tests ---

    appRegistration() {
        *hash<DataProviderAppInfo> app = DataProviderActionCatalog::getApp("Qore");
        assertEq(True, exists app);
        assertEq("Qore", app.name);
        assertEq("Qore", app.display_name);
        assertEq(True, app.logo.val());
        assertEq("Qore-Q-square.svg", app.logo_file_name);
        assertEq(MimeTypeSvg, app.logo_mime_type);
    }

    actionRegistration() {
        *hash<string, hash<DataProviderActionInfo>> actions = DataProviderActionCatalog::getActionHash("Qore");
        assertEq(True, exists actions);

        # check all 6 actions are registered
        list<string> expected_actions = (
            "filter-records",
            "select-fields",
            "set-fields",
            "remove-fields",
            "search-replace",
            "record-limit",
        );
        foreach string action_name in (expected_actions) {
            assertEq(True, actions.hasKey(action_name),
                sprintf("action %y should exist", action_name));
            assertEq(DPAT_PIPELINE_PROCESSOR, actions{action_name}.action_code);
            assertEq(True, actions{action_name}.processor_capabilities > 0,
                sprintf("action %y should have processor_capabilities", action_name));
        }

        # verify filter actions have DPC_FILTER capability
        assertEq(DPC_FILTER, actions."filter-records".processor_capabilities);
        assertEq(DPC_FILTER, actions."record-limit".processor_capabilities);

        # verify transform actions have DPC_TRANSFORM capability
        foreach string action_name in (("select-fields", "set-fields", "remove-fields", "search-replace")) {
            assertEq(DPC_TRANSFORM, actions{action_name}.processor_capabilities,
                sprintf("action %y should have DPC_TRANSFORM capability", action_name));
        }
    }

    # --- Data Provider Navigation Tests ---

    navigationFactory() {
        AbstractDataProviderFactory factory = DataProvider::getFactory("qore-processors");
        assertEq(True, exists factory);
        assertEq("qore-processors", factory.getInfo().name);
    }

    navigationChildren() {
        AbstractDataProvider root = DataProvider::getFactoryObject("qore-processors");
        *list<string> children = root.getChildProviderNames();
        assertEq(True, exists children);
        assertEq(18, children.size());
        # check all expected children
        list<string> expected = ("filter", "select-fields", "set-fields", "remove-fields",
            "search-replace", "record-limit", "running-stats", "moving-average",
            "trend-analysis", "anomaly-detection", "group-by",
            "correlation", "cross-correlation", "ewma-control-chart",
            "histogram", "percentile", "rate-of-change", "seasonality-detection");
        foreach string name in (expected) {
            assertEq(True, children.contains(name),
                sprintf("child %y should be listed", name));
        }
    }

    navigationChildInfo() {
        AbstractDataProvider root = DataProvider::getFactoryObject("qore-processors");
        # all children should support pipeline processor
        *list<string> children = root.getChildProviderNames();
        foreach string name in (children) {
            AbstractDataProvider child = root.getChildProvider(name);
            assertEq(True, child.supportsPipelineProcessor(),
                sprintf("child %y should support pipeline processor", name));
            assertEq(True, child.getProcessorCapabilities() > 0,
                sprintf("child %y should have processor capabilities", name));
        }
    }

    # --- Expression Builder Tests ---

    filterWhereCond() {
        # construct filter with a DataProviderExpression hash via where_cond
        hash<DataProviderExpression> expr = <DataProviderExpression>{
            "exp": "==",
            "args": (<DataProviderFieldReference>{"field": "status"}, "active"),
        };
        QoreFilterRecordsProcessor proc({"where_cond": expr});

        hash<auto> active = {"name": "Alice", "status": "active"};
        hash<auto> inactive = {"name": "Bob", "status": "inactive"};
        assertEq(active, proc.processRecord(active));
        assertNothing(proc.processRecord(inactive));

        # test with a more complex expression (AND with two conditions)
        hash<DataProviderExpression> complex_expr = <DataProviderExpression>{
            "exp": "&&",
            "args": (
                <DataProviderExpression>{
                    "exp": "==",
                    "args": (<DataProviderFieldReference>{"field": "status"}, "active"),
                },
                <DataProviderExpression>{
                    "exp": ">",
                    "args": (<DataProviderFieldReference>{"field": "amount"}, 100),
                },
            ),
        };
        QoreFilterRecordsProcessor proc2({"where_cond": complex_expr});

        assertEq({"status": "active", "amount": 200}, proc2.processRecord({"status": "active", "amount": 200}));
        assertNothing(proc2.processRecord({"status": "active", "amount": 50}));
        assertNothing(proc2.processRecord({"status": "inactive", "amount": 200}));
    }

    # --- Pipeline Processor Type API Tests ---

    pipelineProcessorTypeApi() {
        # pipeline processor providers should support the type API
        AbstractDataProvider root = DataProvider::getFactoryObject("qore-processors");
        AbstractDataProvider filter_prov = root.getChildProvider("filter");

        # filter processor returns NOTHING for input/output types (accepts any record type)
        # but the call should succeed (not throw)
        auto input_type = filter_prov.getPipelineProcessorInputType();
        auto output_type = filter_prov.getPipelineProcessorOutputType();
        # default implementations return NOTHING (any type)
        assertNothing(input_type);
        assertNothing(output_type);
    }

    pipelineProcessorTypeApiWithOptions() {
        AbstractDataProvider root = DataProvider::getFactoryObject("qore-processors");
        AbstractDataProvider filter_prov = root.getChildProvider("filter");

        # with options variants should also succeed
        auto input_type = filter_prov.getPipelineProcessorInputTypeWithOptions({"test": "data"});
        auto output_type = filter_prov.getPipelineProcessorOutputTypeWithOptions({"test": "data"});
        assertNothing(input_type);
        assertNothing(output_type);
    }

    pipelineProcessorTypeApiGuard() {
        # calling type API on a non-processor data provider should throw
        NonProcessorDataProvider prov();
        assertThrows("INVALID-OPERATION", sub () {
            prov.getPipelineProcessorInputType();
        });
        assertThrows("INVALID-OPERATION", sub () {
            prov.getPipelineProcessorOutputType();
        });
        assertThrows("INVALID-OPERATION", sub () {
            prov.getPipelineProcessorInputTypeWithOptions();
        });
        assertThrows("INVALID-OPERATION", sub () {
            prov.getPipelineProcessorOutputTypeWithOptions();
        });
    }

    # --- Dynamic Options Tests ---

    dynamicOptionsFilterAction() {
        # the filter-records action should have data_dependent_options set
        *hash<string, hash<DataProviderActionInfo>> actions = DataProviderActionCatalog::getActionHash("Qore");
        hash<DataProviderActionInfo> filter_action = actions."filter-records";
        assertEq(True, filter_action.data_dependent_options);

        # the action should have data_provider_info with expressions
        assertEq(True, exists filter_action.data_provider_info);
        assertEq("QoreFilterRecordsProcessor", filter_action.data_provider_info.type);
        assertEq(True, filter_action.data_provider_info.supports_pipeline_processor);
        assertEq(True, exists filter_action.data_provider_info.expressions);
        assertEq(DataProviderGenericExpressions, filter_action.data_provider_info.expressions);
    }

    dynamicOptionsPipelineProcessorDispatch() {
        # test that tryGetActionOptionsForPipelineProcessorWithOptions works on the filter processor
        AbstractDataProvider root = DataProvider::getFactoryObject("qore-processors");
        AbstractDataProvider filter_prov = root.getChildProvider("filter");

        *hash<string, hash<DataProviderActionInfo>> actions = DataProviderActionCatalog::getActionHash("Qore");
        hash<DataProviderActionInfo> filter_action = actions."filter-records";

        # call the dynamic options method
        *hash<string, hash<ActionOptionInfo>> dynamic_opts =
            filter_prov.tryGetActionOptionsForPipelineProcessorWithOptions(filter_action);
        assertEq(True, exists dynamic_opts);

        # the where_cond option should be present with correct attributes
        assertEq(True, dynamic_opts.hasKey("where_cond"));
        assertEq(True, dynamic_opts.where_cond.supports_expressions);
        assertEq(False, dynamic_opts.where_cond.supports_custom_values);
        assertEq(True, dynamic_opts.where_cond.server_expression_handling);
        assertEq(True, dynamic_opts.where_cond.preselected);
        assertEq("constructor", dynamic_opts.where_cond.loc);

        # also test the dispatch through tryGetActionOptionsWithOptions
        *hash<string, hash<ActionOptionInfo>> dispatched_opts =
            filter_prov.tryGetActionOptionsWithOptions(filter_action);
        assertEq(True, exists dispatched_opts);
        assertEq(True, dispatched_opts.hasKey("where_cond"));
        assertEq(True, dispatched_opts.where_cond.supports_expressions);
    }

    # --- RegularExpressionArgInfo Tests ---

    regexArgInfoReGlobal() {
        # verify RE_Global is present in the allowed values
        list<auto> allowed = RegularExpressionArgInfo[2].allowed_values;
        bool found = False;
        foreach hash<auto> av in (allowed) {
            if (av.value == "RE_Global") {
                found = True;
                break;
            }
        }
        assertEq(True, found, "RE_Global should be in RegularExpressionArgInfo allowed_values");
        # verify total count is 6 (5 original + RE_Global)
        assertEq(6, allowed.size());
    }
}
