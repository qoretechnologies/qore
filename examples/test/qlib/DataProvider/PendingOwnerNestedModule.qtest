%modern
%enable-all-warnings

%prepend-module-path "${SCRIPT_DIR}"
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires DataProvider

%exec-class PendingOwnerNestedModuleTest

class PendingOwnerNestedModuleTest inherits QUnit::Test {
    constructor() : QUnit::Test("nested provider registration ownership",
            "1.0") {
        addTestCase("nested module keeps its own provider ownership",
            \nestedModuleKeepsItsOwnProviderOwnership());
        set_return_value(main());
    }

    private list<string> appNames(list<hash<auto>> contributions) {
        return sort(map $1.app.name, contributions);
    }

    private nestedModuleKeepsItsOwnProviderOwnership() {
        load_module("PendingOwnerOuterModule");

        # Resolving the pending outer app loads the inner module from inside
        # the deferred initializer.
        assertEq("QoreTestPendingOwnerOuter",
            DataProviderActionCatalog::getAppEx(
                "QoreTestPendingOwnerOuter").name,
            "the deferred outer application initializes");
        assertEq("QoreTestPendingOwnerInner",
            DataProviderActionCatalog::getAppEx(
                "QoreTestPendingOwnerInner").name,
            "the nested module application initializes");

        assertEq(("QoreTestPendingOwnerOuter",), appNames(
                DataProviderActionCatalog::getPresentationContributionsForModule(
                    "PendingOwnerOuterModule")),
            "the deferred module owns only its own application");
        assertEq(("QoreTestPendingOwnerInner",), appNames(
                DataProviderActionCatalog::getPresentationContributionsForModule(
                    "PendingOwnerInnerModule")),
            "the nested module owns its own application");

        DataProviderActionCatalog::deregisterDynamicApp(
            "QoreTestPendingOwnerOuter");
        DataProviderActionCatalog::deregisterDynamicApp(
            "QoreTestPendingOwnerInner");
    }
}
