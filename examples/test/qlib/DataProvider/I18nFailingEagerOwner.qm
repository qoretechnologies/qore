%modern
%requires DataProvider

#! A provider fixture whose eager registration fails and is reported, so that the module registers nothing
/** As a provider integration that initializes eagerly does, the module reports the failure of its app's
    registration to the data provider catalog instead of raising it, so its load succeeds and it contributes no
    presentation.  Used by I18nFailClosed.qtest (qore#7788).
*/
module I18nFailingEagerOwner {
    version = "1.0";
    desc = "provider fixture whose eager registration fails and is reported";
    author = "Qore Technologies";
    license = "MIT";
    init = sub () {
        try {
            throw "FILE-OPEN2-ERROR", "cannot open 'index.js': the action script of the fixture does not exist";
        } catch (hash<ExceptionInfo> ex) {
            DataProviderActionCatalog::reportInitializationFailure("app", "QoreTestI18nFailingEager", NOTHING, ex,
                "I18nFailingEagerOwner");
        }
    };
}
