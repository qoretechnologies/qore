%modern

%requires DataProvider
%requires ./LazyAppActionsHooks.qm

module LazyAppActionsFailedLoad {
    version = "1.0";
    desc = "test module whose initialization runs the code that the test sets, which fails";
    author = "Qore Technologies, s.r.o.";
    license = "MIT";
    init = sub () {
        LazyAppActionsHooks::Hooks::run("LazyAppActionsFailedLoad");
    };
}
