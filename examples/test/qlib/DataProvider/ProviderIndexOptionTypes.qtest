#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright 2026 Qore Technologies, s.r.o. SPDX-License-Identifier: MIT

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/FsUtil.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/DataProvider
%requires ../../../../qlib/ProviderIndex
%requires ./ProviderIndexOptionTypeFixture.qm

%requires yaml

%try-module msgpack
%define NoMsgPack
%endtry

%exec-class ProviderIndexOptionTypesTest

#! Tests that an index build describes each option type once
/** An app's record type is the type of the options of several of its actions, and the descriptions of some types
    have millions of nodes; the build describes the option types of an app with one type table, in which each type
    with fields is described once, and gives each option a description that refers to the table
*/
public class ProviderIndexOptionTypesTest inherits QUnit::Test {
    constructor() : Test("ProviderIndex option types test", "1.0") {
        addTestCase("each option type is described once per app", \describedOnceTest());
        addTestCase("the options of a type have its description, which refers to the app's type table",
            \descriptionTest());
        addTestCase("a repeated build writes the same index", \repeatTest());
        addTestCase("the type table of an app is stored once, with the types its options refer to",
            \storedTableTest());
        addTestCase("a restored option type is the type described", \restoredTypeTest());
        set_return_value(main());
    }

    private checkModules() {
%ifdef NoMsgPack
        testSkip("no MessagePack support");
%endif
    }

    #! Returns the options of a single-process build of the fixture app
    private static hash<ProviderIndexCreateOptions> getOptions() {
        return <ProviderIndexCreateOptions>{
            "load_known_factories": False,
            "load_environment": False,
            "load_typescript_actions": False,
            "apps": (ProviderIndexOptionTypeFixture::App,),
        };
    }

    #! Builds the index of the fixture app in a new directory and returns the directory
    private static string build() {
        string dir = make_tmp_dir();
        ProviderIndex::createDataProviderIndex(NOTHING, dir, getOptions());
        return dir;
    }

    describedOnceTest() {
        checkModules();
%ifndef NoMsgPack
        ProviderIndexOptionTypeFixture::CountingRecordType::calls = {};
        string dir = build();
        on_exit remove_tree(dir);
        # the order is the type of 3 options and the key of 3; the address is the type of 2 fields of the order, and
        # is described once too
        assertEq({"FixtureOrder": 1, "FixtureKey": 1, "FixtureAddress": 1},
            ProviderIndexOptionTypeFixture::CountingRecordType::calls,
            "each type is described once, however many options and fields have it");
%endif
    }

    descriptionTest() {
        checkModules();
%ifndef NoMsgPack
        string dir = build();
        on_exit remove_tree(dir);
        hash<auto> actions = readIndex(dir).actioninfomap{ProviderIndexOptionTypeFixture::App};
        assertEq(("create", "lookup", "ping", "update", "upsert"), sort(keys actions));
        # an action without options is indexed without them
        assertNothing(actions.ping.options);
        hash<auto> order = actions.create.options.record.type_info;
        assertEq("FixtureOrder", order.name);
        # a type with fields is a reference to the app's type table, which the description gives
        assertTrue(order.type_ref.val());
        hash<auto> table = order.type_graph;
        foreach string action in (("update", "upsert")) {
            assertEq(order, actions{action}.options.record.type_info, action);
        }
        hash<auto> key = actions.lookup.options.key.type_info;
        assertEq("FixtureKey", key.name);
        assertEq(key, actions.lookup.options.other_key.type_info);
        assertEq(key, actions.update.options.key.type_info);
        assertEq(table, key.type_graph, "the options of an app share its type table");
        # the address that two fields of the order have is one type of the table
        hash<auto> order_type = table{order.type_ref};
        assertEq("FixtureOrder", order_type.name);
        assertEq(order_type.fields.billing.type.type_ref, order_type.fields.shipping.type.type_ref);
        assertEq("FixtureAddress", table{order_type.fields.billing.type.type_ref}.name);
        # the keys are numbered from 1 in the order in which the actions, by name, refer to them
        assertEq(("1", "2", "3"), keys table);
        assertEq("1", order.type_ref);
%endif
    }

    repeatTest() {
        checkModules();
%ifndef NoMsgPack
        string first = build();
        on_exit remove_tree(first);
        string second = build();
        on_exit remove_tree(second);
        assertEq(readIndexFiles(first), readIndexFiles(second));
%endif
    }

    storedTableTest() {
        checkModules();
%ifndef NoMsgPack
        string dir = build();
        on_exit remove_tree(dir);
        hash<auto> chunk = readChunk(dir);
        # the chunk stores the app's type table once, as positions in its table of type descriptions
        assertEq(("1", "2", "3"), keys chunk.type_graph);
        map assertEq(Type::Int, $1.type()), chunk.type_graph.iterator();
        # each option refers to the position of its description, which refers to the type table by key
        hash<auto> record = chunk.types[chunk.index.actioninfomap{ProviderIndexOptionTypeFixture::App}.create.options
            .record.type_info];
        assertEq("1", record.type_ref);
        assertEq(NOTHING, record.type_graph);
        hash<auto> order = chunk.types[chunk.type_graph."1"];
        assertEq("FixtureOrder", order.name);
%endif
    }

    restoredTypeTest() {
        checkModules();
%ifndef NoMsgPack
        string dir = build();
        on_exit remove_tree(dir);
        code restore = useIndexDir(dir);
        on_exit restore();
        list<hash<auto>> actions = ProviderIndexUtil::tryGetActionMetadataForApp(ProviderIndexOptionTypeFixture::App);
        hash<DataTypeInfo> record = (map $1, actions, $1.action == "create")[0].options.record.type_info;
        # restored from the description alone, as QorusIndexedAction restores option types
        AbstractDataProviderType order = AbstractDataProviderType::get(record);
        assertEq(ProviderIndexOptionTypeFixture::OrderType.getInfoGraph(), order.getInfoGraph());
        # the address of the two fields is one restored type
        assertEq(order.getFields().billing.getType(), order.getFields().shipping.getType());
%endif
    }

    #! Reads the published index of the fixture app in the serialized form
    private static hash<auto> readIndex(string dir) {
        return ProviderIndexUtil::readSerializedDataProviderIndex(dir).index;
    }

    #! Returns the unpacked metadata cache chunk of the fixture app
    private static hash<auto> readChunk(string dir) {
        hash<auto> routing = parse_yaml(ReadOnlyFile::readTextFile(dir + DirSep + "qore-routing-index.yaml"));
        hash<auto> manifest = msgpack_unpack(ReadOnlyFile::readBinaryFile(sprintf("%s%sqore-data-index-manifest-%s"
            ".msgpack", dir, DirSep, routing.metadata_cache_sha256)), MSGPACK_QORE_MODE);
        string path = sprintf("%s%sqore-data-index-%s.msgpack", dir, DirSep,
            manifest.apps{ProviderIndexOptionTypeFixture::App}.sha256);
        return msgpack_unpack(uncompress_to_binary(ReadOnlyFile::readBinaryFile(path)), MSGPACK_QORE_MODE);
    }

    #! Makes the given directory the index directory; returns code that restores the previous directory
    private static code useIndexDir(string dir) {
        bool had_env = exists ENV{ProviderIndexEnvVar};
        string old_env = had_env ? ENV{ProviderIndexEnvVar} : "";
        ProviderIndexUtil::setEnvironmentVariable(dir);
        ProviderIndexUtil::setBuildMode(True);
        ProviderIndexUtil::setBuildMode(False);
        return sub () {
            if (had_env) {
                ProviderIndexUtil::setEnvironmentVariable(old_env);
            } else {
                unsetenv(ProviderIndexEnvVar);
                remove ENV{ProviderIndexEnvVar};
            }
            ProviderIndexUtil::setBuildMode(True);
            ProviderIndexUtil::setBuildMode(False);
        };
    }

    #! Returns the contents of all index files in a directory
    private static hash<string, binary> readIndexFiles(string dir) {
        hash<string, binary> rv = {};
        Dir d();
        d.chdir(dir);
        foreach string file in (d.listFiles()) {
            rv{file} = ReadOnlyFile::readBinaryFile(dir + DirSep + file);
        }
        return rv;
    }
}
