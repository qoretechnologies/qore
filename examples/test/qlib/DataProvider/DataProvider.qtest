class TestRecordProcessor inherits AbstractDataProcessor {
    public {
        string pfx;
        list<hash<auto>> recs;
        list<hash<auto>> raw_recs;
        *hash<auto> crec;
        *bool raise_error;
    }

    constructor(string pfx, *hash<auto> crec, *bool raise_error) {
        self.pfx = pfx;
        self.crec = crec;
        self.raise_error = raise_error;
    }

    clear() {
        remove recs;
    }

    setRaiseError() {
        raise_error = True;
    }

    private submitImpl(code enqueue, auto rec) {
        if (raise_error) {
            remove raise_error;
            throw "ERROR", "error";
        }
        hash<auto> new_rec = (map {pfx + "-" + $1.key: $1.value}, rec.pairIterator()) + crec;
        raw_recs += new_rec;
        recs += map $1, new_rec.contextIterator();
        enqueue(new_rec);
    }

    private bool supportsBulkApiImpl() {
        return True;
    }
}

class SignalingTestRecordProcessor inherits AbstractDataProcessor {
    public {
        string pfx;
        list<hash<auto>> recs;
        list<hash<auto>> raw_recs;
        Queue processed_queue();
    }

    constructor(string pfx) {
        self.pfx = pfx;
    }

    clear() {
        remove recs;
        remove raw_recs;
        while (processed_queue.size()) {
            processed_queue.get();
        }
    }

    int waitForRecords(int count, string desc) {
        try {
            while (True) {
                int size = processed_queue.get(5s);
                if (size >= count) {
                    return size;
                }
            }
        } catch (hash<ExceptionInfo> ex) {
            throw "TEST-TIMEOUT", sprintf("timeout waiting for %s; expected at least %d processed records; have %d",
                desc, count, recs.size()), ex;
        }
    }

    private submitImpl(code enqueue, auto rec) {
        hash<auto> new_rec = (map {pfx + "-" + $1.key: $1.value}, rec.pairIterator());
        raw_recs += new_rec;
        recs += map $1, new_rec.contextIterator();
        processed_queue.push(recs.size());
        enqueue(new_rec);
    }

    private bool supportsBulkApiImpl() {
        return True;
    }
}

class TestFlushRecordProcessor inherits TestRecordProcessor {
    private {
        *hash<auto> new_rec;
    }

    constructor(string pfx, *hash<auto> crec, *bool raise_error, *hash<auto> new_rec)
        : TestRecordProcessor(pfx, crec, raise_error) {
        self.new_rec = new_rec;
    }

    private flushImpl(code enqueue) {
        if (new_rec) {
            enqueue(new_rec);
        }
    }
}

class DuplicateRecordProcessor inherits AbstractDataProcessor {
    public {
        string pfx1;
        string pfx2;
    }

    constructor(string pfx1, string pfx2) {
        self.pfx1 = pfx1;
        self.pfx2 = pfx2;
    }

    private submitImpl(code enqueue, auto rec) {
        hash<auto> rec1 = (map {pfx1 + "-" + $1.key: $1.value}, rec.pairIterator());
        enqueue(rec1);
        hash<auto> rec2 = (map {pfx2 + "-" + $1.key: $1.value}, rec.pairIterator());
        enqueue(rec2);
    }

    private bool supportsBulkApiImpl() {
        return True;
    }
}

