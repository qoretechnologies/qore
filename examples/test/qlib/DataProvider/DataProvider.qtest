        {
            TestBulkRecordIterator record_provider();
            DataProviderPipeline pipe(<PipelineOptionInfo>{
                "name": "test-pipeline-3",
                #"info_log": sub (string fmt) { vprintf(fmt + "\n", argv); },
                #"debug_log": sub (string fmt) { vprintf(fmt + "\n", argv); },
                #"error_log": sub (string fmt) { vprintf(fmt + "\n", argv); },
            });

            TestRecordProcessor record_processorA0("A", {"A0": 1});
            TestRecordProcessor record_processorA1("B", {"A1": 1});

            TestRecordProcessor record_processorB0("A", {"B0": 1});
            TestRecordProcessor record_processorB1("B", {"B1": 1});

            # run pipeline in parallel
            int p0 = pipe.appendQueue(0);
            int p1 = pipe.appendQueue(0);

            pipe.append(p0, record_processorA0);
            pipe.append(p0, record_processorA1);

            pipe.append(p1, record_processorB1);
            pipe.append(p1, record_processorB0);

            pipe.submit(record_provider);
            pipe.waitDone();
            assertEq({"B-A-a": (1, 2), "B-A-b": ("one", "two"), "B-A0": 1, "A1": 1}, record_processorA1.raw_recs[0]);
            assertEq({"A-B-a": (1, 2), "A-B-b": ("one", "two"), "A-B1": 1, "B0": 1}, record_processorB0.raw_recs[0]);

            hash<PipelineInfo> info = pipe.getInfo();
            assertEq(2, info.record_count);
            assertTrue(info.bulk);

            pipe.submit(record_provider);
            pipe.waitDone();

            info = pipe.getInfo();
            assertEq(4, info.record_count);
            assertEq(PS_IDLE, info.status);

            pipe.reset();
            pipe.submit(record_provider);
            pipe.waitDone();

            info = pipe.getInfo();
            assertEq(PS_IDLE, info.status);
            assertEq(2, info.record_count);

            DataProviderPipeline pipe1 = pipe.copy();
            record_processorA0.clear();
            record_processorA1.clear();
            record_processorB0.clear();
            record_processorB1.clear();

            pipe1.submit(record_provider);
            pipe1.waitDone();
            assertEq({"B-A-a": (1, 2), "B-A-b": ("one", "two"), "B-A0": 1, "A1": 1}, record_processorA1.raw_recs[0]);
            assertEq({"A-B-a": (1, 2), "A-B-b": ("one", "two"), "A-B1": 1, "B0": 1}, record_processorB0.raw_recs[0]);

            info = pipe1.getInfo();
            assertEq(2, info.record_count);
            assertTrue(info.bulk);

            pipe1.submit(record_provider);
            pipe1.waitDone();

            info = pipe1.getInfo();
            assertEq(4, info.record_count);
            assertEq(PS_IDLE, info.status);

            pipe1.reset();
            pipe1.submit(record_provider);
            pipe1.waitDone();

            info = pipe1.getInfo();
            assertEq(PS_IDLE, info.status);
            assertEq(2, info.record_count);

            DataProviderPipelineFactory factory();
            # run pipeline in parallel
            p0 = factory.appendQueue(0);
            p1 = factory.appendQueue(0);

            factory.append(p0, record_processorA0);
            factory.append(p0, record_processorA1);

            factory.append(p1, record_processorB1);
            factory.append(p1, record_processorB0);

            assertEq({
                "opts": NOTHING,
                "num_queues": 3,
                "bulk": True,
            }, factory.getInfo());

            DataProviderPipeline pipe2 = factory.create();
            record_processorA0.clear();
            record_processorA1.clear();
            record_processorB0.clear();
            record_processorB1.clear();

            pipe2.submit(record_provider);
            pipe2.waitDone();
            assertEq({"B-A-a": (1, 2), "B-A-b": ("one", "two"), "B-A0": 1, "A1": 1}, record_processorA1.raw_recs[0]);
            assertEq({"A-B-a": (1, 2), "A-B-b": ("one", "two"), "A-B1": 1, "B0": 1}, record_processorB0.raw_recs[0]);

            info = pipe2.getInfo();
            assertEq(2, info.record_count);
            assertTrue(info.bulk);

            pipe2.submit(record_provider);
            pipe2.waitDone();

            info = pipe2.getInfo();
            assertEq(4, info.record_count);
            assertEq(PS_IDLE, info.status);

            pipe2.reset();
            pipe2.submit(record_provider);
            pipe2.waitDone();

            info = pipe2.getInfo();
            assertEq(PS_IDLE, info.status);
            assertEq(2, info.record_count);
        }

        # verify pipeline abort
        {
            InfiniteRecordProvider record_provider();
            hash<PipelineOptionInfo> opts({
                "name": "test-pipeline-3",
                #"info_log": sub (string fmt) { vprintf("TID " + gettid() + " " + fmt + "\n", argv); },
                #"debug_log": sub (string fmt) { vprintf("TID " + gettid() + " " + fmt + "\n", argv); },
                #"error_log": sub (string fmt) { vprintf("TID " + gettid() + " " + fmt + "\n", argv); },
            });
            DataProviderPipeline pipe(opts);

            TestRecordProcessor record_processor0("A");
            pipe.append(record_processor0);
            hash<PipelineInfo> info = pipe.getInfo();
            assertNothing(info.start_time);
            assertNothing(info.stop_time);
            assertEq(PS_IDLE, info.status);
            assertEq(0, info.record_count);
            assertEq(1, info.num_queues);
            assertEq(True, info.bulk);
            assertEq(0s, info.duration);
            assertEq(0.0, info.duration_secs);
            assertEq(0.0, info.recs_per_sec);
            pipe.submit({"a": 1});
            assertEq(PS_RUNNING, pipe.getInfo().status);

            # wait for record count = 1
            while (True) {
                int size = record_processor0.recs.size();
                if (size == 1) {
                    break;
                }
                sleep(50ms);
            }

            Counter thread_cnt(1);
            Queue abort_queue();
            code submit = sub () {
                if (m_options.verbose > 2) {
                    printf("TID %d: infinite submission thread started\n", gettid());
                }
                on_exit if (m_options.verbose > 2) {
                    printf("TID %d: infinite submission thread exiting\n", gettid());
                }
                try {
                    thread_cnt.dec();
                    pipe.submit(record_provider);
                    abort_queue.push();
                } catch (hash<ExceptionInfo> ex) {
                    abort_queue.push(ex);
                }
            };
            background submit();
            thread_cnt.waitForZero();

            # issue #4317: do not abort before we know the infinite record provider is in progress
            # wait for record count >= 2
            while (True) {
                int size = record_processor0.recs.size();
                if (size >= 2) {
                    break;
                }
                sleep(50ms);
            }

            if (m_options.verbose > 2) {
                printf("TID %d: record processor0 size: %d; about to abort\n", gettid(), record_processor0.recs.size());
                hash<auto> stacks = get_all_thread_call_stacks();
                hash<auto> tmap;
                foreach hash<auto> i in (stacks.pairIterator()) {
                    splice i.value, 0, 2;
                    tmap{i.key} = map $1.type != "new-thread" ? sprintf("%s %s()", get_ex_pos($1), $1.function) : "new-thread", i.value;
                }
                printf("all threads: %N\n", tmap);
            }

            pipe.abort();
            assertEq(PS_ABORTED, pipe.getInfo().status);
            assertThrows("PIPELINE-ERROR", \pipe.submit(), {});

            if (m_options.verbose > 2) {
                printf("TID %d: pipeline info: %N\n", gettid(), pipe.getInfo());
            }

            *hash<ExceptionInfo> ex_info = abort_queue.get();
            assertEq("PIPELINE-SUBMISSION-ABORTED", ex_info.err);

            if (m_options.verbose > 2) {
                printf("TID %d: infinite submission exception: %s: %s\n", gettid(), ex_info.err, ex_info.desc);

            }

            pipe.reset();
            pipe.submit({"a": 1});
            pipe.waitDone();
            assertEq(PS_IDLE, pipe.getInfo().status);

            DataProviderPipeline pipe1 = pipe.copy();
            hash<PipelineInfo> info2 = pipe1.getInfo();
            assertEq(info - "name", info2 - "name");
            assertNothing(info2.start_time);
            assertNothing(info2.stop_time);
            assertEq(PS_IDLE, info2.status);
            assertEq(0, info2.record_count);
            assertEq(1, info2.num_queues);
            assertEq(True, info2.bulk);
            assertEq(0s, info2.duration);
            assertEq(0.0, info2.duration_secs);
            assertEq(0.0, info2.recs_per_sec);

            # clear record processor cache
            record_processor0.clear();

            pipe1.submit({"a": 1});
            assertEq(PS_RUNNING, pipe1.getInfo().status);

            # wait for record count = 1
            while (True) {
                int size = record_processor0.recs.size();
                if (size == 1) {
                    break;
                }
                sleep(50ms);
            }

            assertEq(0, thread_cnt.getCount());
            assertEq(0, abort_queue.size());
            thread_cnt.inc();
            submit = sub () {
                try {
                    thread_cnt.dec();
                    pipe1.submit(record_provider);
                    abort_queue.push();
                } catch (hash<ExceptionInfo> ex) {
                    abort_queue.push(ex);
                }
            };
            background submit();
            thread_cnt.waitForZero();

            # issue #4317: do not abort before we know the infinite record provider is in progress
            # wait for record count >= 2
            while (True) {
                int size = record_processor0.recs.size();
                if (size >= 2) {
                    break;
                }
                sleep(50ms);
            }

            pipe1.abort();
            assertEq(PS_ABORTED, pipe1.getInfo().status);
            #printf("%N\n", pipe.getInfo());
            assertThrows("PIPELINE-ERROR", \pipe1.submit(), {});

            ex_info = abort_queue.get();
            assertEq("PIPELINE-SUBMISSION-ABORTED", ex_info.err);

            pipe1.reset();
            pipe1.submit({"a": 1});
            pipe1.waitDone();
            assertEq(PS_IDLE, pipe1.getInfo().status);

            DataProviderPipelineFactory factory(opts);
            factory.append(record_processor0);
            assertEq({
                "opts": opts,
                "num_queues": 1,
                "bulk": True,
            }, factory.getInfo());

            DataProviderPipeline pipe2 = factory.create();
            info2 = pipe2.getInfo();
            assertEq(info, info2);
            assertNothing(info2.start_time);
            assertNothing(info2.stop_time);
            assertEq(PS_IDLE, info2.status);
            assertEq(0, info2.record_count);
            assertEq(1, info2.num_queues);
            assertEq(True, info2.bulk);
            assertEq(0s, info2.duration);
            assertEq(0.0, info2.duration_secs);
            assertEq(0.0, info2.recs_per_sec);

            # clear record processor cache
            record_processor0.clear();

            pipe2.submit({"a": 1});
            assertEq(PS_RUNNING, pipe2.getInfo().status);

            # wait for record count = 1
            while (True) {
                int size = record_processor0.recs.size();
                if (size == 1) {
                    break;
                }
                sleep(50ms);
            }

            assertEq(0, thread_cnt.getCount());
            assertEq(0, abort_queue.size());
            thread_cnt.inc();
            submit = sub () {
                try {
                    thread_cnt.dec();
                    pipe2.submit(record_provider);
                    abort_queue.push();
                } catch (hash<ExceptionInfo> ex) {
                    abort_queue.push(ex);
                }
            };
            background submit();
            thread_cnt.waitForZero();

            # issue #4317: do not abort before we know the infinite record provider is in progress
            # wait for record count >= 2
            while (True) {
                int size = record_processor0.recs.size();
                if (size >= 2) {
                    break;
                }
                sleep(50ms);
            }

            pipe2.abort();
            assertEq(PS_ABORTED, pipe2.getInfo().status);
            #printf("%N\n", pipe.getInfo());
            assertThrows("PIPELINE-ERROR", \pipe2.submit(), {});

            ex_info = abort_queue.get();
            assertEq("PIPELINE-SUBMISSION-ABORTED", ex_info.err);

            pipe2.reset();
            pipe2.submit({"a": 1});
            pipe2.waitDone();
            assertEq(PS_IDLE, pipe2.getInfo().status);
        }

        # verify pipeline error handling
        {
            TestBulkRecordIterator record_provider();
            hash<PipelineOptionInfo> opts({
                "name": "test-pipeline-4",
                #"info_log": sub (string fmt) { vprintf(fmt + "\n", argv); },
                #"debug_log": sub (string fmt) { vprintf(fmt + "\n", argv); },
                #"error_log": sub (string fmt) { vprintf(fmt + "\n", argv); },
            });
            DataProviderPipeline pipe(opts);

            TestRecordProcessor record_processorA0("A", {"A0": 1});
            TestRecordProcessor record_processorA1("B", {"A1": 1});

            TestRecordProcessor record_processorB0("A", {"B0": 1});
            TestRecordProcessor record_processorB1("B", {"B1": 1}, True);

            # run pipeline in parallel
            int p0 = pipe.appendQueue(0);
            int p1 = pipe.appendQueue(0);

            pipe.append(p0, record_processorA0);
            pipe.append(p0, record_processorA1);

            pipe.append(p1, record_processorB1);
            pipe.append(p1, record_processorB0);

            pipe.submit(record_provider);
            assertThrows("PIPELINE-FAILED", \pipe.waitDone());
            assertEq(PS_ABORTED, pipe.getInfo().status);
            pipe.reset();
            pipe.submit({"a": 1});
            pipe.waitDone();
            assertEq(PS_IDLE, pipe.getInfo().status);

            DataProviderPipeline pipe1 = pipe.copy();
            record_processorA0.clear();
            record_processorA1.clear();
            record_processorB0.clear();
            record_processorB1.clear();
            record_processorB1.setRaiseError();

            pipe1.submit(record_provider);
            assertThrows("PIPELINE-FAILED", \pipe1.waitDone());
            assertEq(PS_ABORTED, pipe1.getInfo().status);
            pipe1.reset();
            pipe1.submit({"a": 1});
            pipe1.waitDone();
            assertEq(PS_IDLE, pipe1.getInfo().status);

            DataProviderPipelineFactory factory(opts);

            # run pipeline in parallel
            p0 = factory.appendQueue(0);
            p1 = factory.appendQueue(0);

            factory.append(p0, record_processorA0);
            factory.append(p0, record_processorA1);

            factory.append(p1, record_processorB1);
            factory.append(p1, record_processorB0);

            assertEq({
                "opts": opts,
                "num_queues": 3,
                "bulk": True,
            }, factory.getInfo());

            DataProviderPipeline pipe2 = factory.create();
            record_processorA0.clear();
            record_processorA1.clear();
            record_processorB0.clear();
            record_processorB1.clear();
            record_processorB1.setRaiseError();

            pipe2.submit(record_provider);
            assertThrows("PIPELINE-FAILED", \pipe2.waitDone());
            assertEq(PS_ABORTED, pipe2.getInfo().status);
            pipe2.reset();
            pipe2.submit({"a": 1});
            pipe2.waitDone();
            assertEq(PS_IDLE, pipe2.getInfo().status);
        }

        # test non-record-based pipeline processing
        {
            hash<PipelineOptionInfo> opts({
                "name": "test-pipeline-5",
                #"info_log": sub (string fmt) { vprintf(fmt + "\n", argv); },
                #"debug_log": sub (string fmt) { vprintf(fmt + "\n", argv); },
                #"error_log": sub (string fmt) { vprintf(fmt + "\n", argv); },
            });
            DataProviderPipeline pipe(opts);
            TestIntProcessor int_processor0(1);
            TestIntProcessor int_processor1(2);

            # run pipeline in parallel
            int q0 = pipe.appendQueue(0);
            int q1 = pipe.appendQueue(0);

            pipe.append(q0, int_processor0);
            pipe.append(q0, int_processor0);

            pipe.append(q1, int_processor1);
            pipe.append(q1, int_processor1);

            hash<PipelineInfo> info = pipe.getInfo();

            pipe.submit(1);
            pipe.waitDone();
            assertEq(5, int_processor0.getSum());
            assertEq(8, int_processor1.getSum());

            DataProviderPipeline pipe1 = pipe.copy();
            hash<PipelineInfo> info1 = pipe1.getInfo();
            assertEq(info - "name", info1 - "name");

            int_processor0.reset();
            int_processor1.reset();

            pipe1.submit(1);
            pipe1.waitDone();
            assertEq(5, int_processor0.getSum());
            assertEq(8, int_processor1.getSum());

            DataProviderPipelineFactory factory(opts);
            # run pipeline in parallel
            q0 = factory.appendQueue(0);
            q1 = factory.appendQueue(0);

            factory.append(q0, int_processor0);
            factory.append(q0, int_processor0);

            factory.append(q1, int_processor1);
            factory.append(q1, int_processor1);

            DataProviderPipeline pipe2 = factory.create();
            hash<PipelineInfo> info2 = pipe2.getInfo();
            assertEq(info, info2);

            int_processor0.reset();
            int_processor1.reset();

            pipe2.submit(1);
            pipe2.waitDone();
            assertEq(5, int_processor0.getSum());
            assertEq(8, int_processor1.getSum());
        }

        # test data skipping
        {
            hash<PipelineOptionInfo> opts({
                "name": "test-pipeline-6",
                #"info_log": sub (string fmt) { vprintf(fmt + "\n", argv); },
                #"debug_log": sub (string fmt) { vprintf(fmt + "\n", argv); },
                #"error_log": sub (string fmt) { vprintf(fmt + "\n", argv); },
            });
            DataProviderPipeline pipe(opts);
            TestIntProcessor int_processor0(1);
            TestIntProcessor int_processor1(2, True);

            # run pipeline in parallel
            int q0 = pipe.appendQueue(0);
            int q1 = pipe.appendQueue(0);

            pipe.append(q0, int_processor0);
            pipe.append(q0, int_processor0);

            pipe.append(q1, int_processor1);
            pipe.append(q1, int_processor1);

            pipe.submit(1);
            pipe.waitDone();
            assertEq(5, int_processor0.getSum());
            assertEq(3, int_processor1.getSum());

            DataProviderPipeline pipe1 = pipe.copy();
            int_processor0.reset();
            int_processor1.reset();

            pipe1.submit(1);
            pipe1.waitDone();
            assertEq(5, int_processor0.getSum());
            assertEq(3, int_processor1.getSum());

            int count = 0;
            code thread_callback = sub () { ++count; };
            opts.thread_callback = thread_callback;
            DataProviderPipelineFactory factory(opts);

            # run pipeline in parallel
            q0 = factory.appendQueue(0);
            q1 = factory.appendQueue(0);

            factory.append(q0, int_processor0);
            factory.append(q0, int_processor0);

            factory.append(q1, int_processor1);
            factory.append(q1, int_processor1);

            DataProviderPipeline pipe2 = factory.create();
            int_processor0.reset();
            int_processor1.reset();

            pipe2.submit(1);
            pipe2.waitDone();
            assertEq(5, int_processor0.getSum());
            assertEq(3, int_processor1.getSum());
            assertEq(3, count);
        }

        {
            hash<PipelineOptionInfo> opts({
                "name": "test-pipeline-7",
                #"info_log": sub (string fmt) { vprintf(fmt + "\n", argv); },
                #"debug_log": sub (string fmt) { vprintf(fmt + "\n", argv); },
                #"error_log": sub (string fmt) { vprintf(fmt + "\n", argv); },
            });
            DataProviderPipeline pipe(opts);
            DuplicateRecordProcessor proc1("x", "y");
            pipe.append(proc1);
            RecordProcessorSink proc2();
            pipe.append(proc2);
            TestRecordProvider record_provider();
            pipe.submit(record_provider);
            pipe.waitDone();
            assertEq((
                {
                    "x-a": (1,),
                    "x-b": (2,),
                },
                {
                    "y-a": (1,),
                    "y-b": (2,),
                },
            ), proc2.recs);
        }

        {
            hash<PipelineOptionInfo> opts({
                "name": "test-pipeline-8",
                #"info_log": sub (string fmt) { vprintf(fmt + "\n", argv); },
                #"debug_log": sub (string fmt) { vprintf(fmt + "\n", argv); },
                #"error_log": sub (string fmt) { vprintf(fmt + "\n", argv); },
            });
            DataProviderPipeline pipe(opts);
            DummyRecordProcessor proc1();
            pipe.append(proc1);
            RecordProcessorSink proc2();
            pipe.append(proc2);
            pipe.submit();
            pipe.waitDone();
            assertEq(({"x": 1,},), proc2.recs);
        }

        {
            hash<PipelineOptionInfo> opts({
                "name": "test-pipeline-9",
                #"info_log": sub (string fmt) { vprintf(fmt + "\n", argv); },
                #"debug_log": sub (string fmt) { vprintf(fmt + "\n", argv); },
                #"error_log": sub (string fmt) { vprintf(fmt + "\n", argv); },
            });
            DataProviderPipeline pipe(opts);
            RecordProcessorSink proc1();
            pipe.append(proc1);
            RecordProcessorSink proc2();
            pipe.append(proc2);
            list<auto> l = (0, "one");
            pipe.submit(l);
            pipe.waitDone();
            assertEq((l,), proc1.recs);
            assertEq((l,), proc2.recs);
        }
    }

    #! Test pipeline metrics collection functionality
    /** @since DataProvider 3.1
    */
    pipelineMetricsTest() {
        # Test PipelineElementMetrics hashdecl
        {
            hash<PipelineElementMetrics> em = <PipelineElementMetrics>{
                "element_id": "0:0",
                "element_type": "processor",
                "class_name": "TestProcessor",
                "records_processed": 100,
                "records_output": 95,
                "processing_time_us": 5000000,
                "min_processing_time_us": 10,
                "max_processing_time_us": 100000,
                "queue_wait_time_us": 1000,
                "current_queue_depth": 5,
                "max_queue_depth": 10,
                "queue_full_count": 2,
                "first_record_time": now(),
                "last_record_time": now(),
                "error_count": 1,
            };

            assertEq("0:0", em.element_id);
            assertEq("processor", em.element_type);
            assertEq(100, em.records_processed);
            assertEq(95, em.records_output);
        }

        # Test PipelineMetricsSnapshot hashdecl
        {
            hash<PipelineMetricsSnapshot> ms = <PipelineMetricsSnapshot>{
                "pipeline_name": "test-pipeline",
                "status": PS_RUNNING,
                "start_time": now(),
                "snapshot_time": now(),
                "total_records_submitted": 1000,
                "total_records_completed": 950,
                "throughput_rps": 14500.5,
                "avg_latency_us": 250.0,
                "element_metrics": {},
                "num_queues": 2,
                "bulk_mode": True,
                "total_errors": 5,
                "user_context": {"test_key": 123},
            };

            assertEq("test-pipeline", ms.pipeline_name);
            assertEq(PS_RUNNING, ms.status);
            assertEq(1000, ms.total_records_submitted);
            assertEq(123, ms.user_context.test_key);
        }

        # Test pipeline metrics collection via collector
        {
            TestMetricsCollector collector(10, 5);

            hash<PipelineOptionInfo> opts = <PipelineOptionInfo>{
                "name": "metrics-test-pipeline",
                "metrics_collector": collector,
            };

            DataProviderPipeline pipe(opts);
            RecordProcessorSink proc();
            pipe.append(proc);

            # Submit 20 records
            for (int i = 0; i < 20; ++i) {
                pipe.submit({"record": i});
            }
            pipe.waitDone();

            assertTrue(collector.collected_metrics.size() > 0, "should have received metrics reports");

            # Verify metrics content
            hash<PipelineMetricsSnapshot> last_metrics = collector.collected_metrics[collector.collected_metrics.size() - 1];
            assertEq("metrics-test-pipeline", last_metrics.pipeline_name);
            assertTrue(last_metrics.total_records_submitted > 0);
            assertTrue(collector.shutdown_called, "shutdown should have been called");
        }

        # Test getMetrics() method
        {
            TestMetricsCollector collector(1000, 1000);

            hash<PipelineOptionInfo> opts = <PipelineOptionInfo>{
                "name": "getmetrics-test-pipeline",
                "metrics_collector": collector,
            };

            DataProviderPipeline pipe(opts);
            RecordProcessorSink proc();
            pipe.append(proc);

            for (int i = 0; i < 10; ++i) {
                pipe.submit({"record": i});
            }
            pipe.waitDone();

            *hash<PipelineMetricsSnapshot> metrics = pipe.getMetrics();
            assertTrue(exists metrics);
            assertEq("getmetrics-test-pipeline", metrics.pipeline_name);
            assertEq(10, metrics.total_records_submitted);
            assertEq(10, metrics.total_records_completed);
        }

        # Test metrics with user context
        {
            hash<auto> user_ctx = {
                "fsm_id": 123,
                "exec_id": 456,
            };

            TestMetricsCollector collector(10, 1, user_ctx);

            hash<PipelineOptionInfo> opts = <PipelineOptionInfo>{
                "name": "context-test-pipeline",
                "metrics_collector": collector,
            };

            DataProviderPipeline pipe(opts);
            RecordProcessorSink proc();
            pipe.append(proc);

            pipe.submit({"record": 1});
            pipe.waitDone();

            assertTrue(collector.collected_metrics.size() > 0);
            hash<PipelineMetricsSnapshot> metrics = collector.collected_metrics[0];
            assertEq(123, metrics.user_context.fsm_id);
            assertEq(456, metrics.user_context.exec_id);
        }

        # Test element metrics collection
        {
            TestMetricsCollector collector(10, 5);

            hash<PipelineOptionInfo> opts = <PipelineOptionInfo>{
                "name": "element-metrics-pipeline",
                "metrics_collector": collector,
            };

            DataProviderPipeline pipe(opts);
            RecordProcessorSink proc1();
            RecordProcessorSink proc2();
            pipe.append(proc1);
            pipe.append(proc2);

            for (int i = 0; i < 15; ++i) {
                pipe.submit({"record": i});
            }
            pipe.waitDone();

            assertTrue(collector.collected_metrics.size() > 0);
            hash<PipelineMetricsSnapshot> last_metrics = collector.collected_metrics[collector.collected_metrics.size() - 1];

            # Should have element metrics for both processors
            assertTrue(last_metrics.element_metrics.hasKey("0:0"), "should have element 0:0");
            assertTrue(last_metrics.element_metrics.hasKey("0:1"), "should have element 0:1");

            # Verify element types are tracked
            assertEq("processor", last_metrics.element_metrics."0:0".element_type);
            assertEq("processor", last_metrics.element_metrics."0:1".element_type);
        }

        # Test pipeline without metrics collector (getMetrics returns NOTHING)
        {
            hash<PipelineOptionInfo> opts = <PipelineOptionInfo>{
                "name": "no-metrics-pipeline",
                # No metrics_collector set
            };

            DataProviderPipeline pipe(opts);
            RecordProcessorSink proc();
            pipe.append(proc);

            pipe.submit({"record": 1});
            pipe.waitDone();

            *hash<PipelineMetricsSnapshot> metrics = pipe.getMetrics();
            assertNothing(metrics);
        }

        # Test empty pipeline metrics
        {
            TestMetricsCollector collector(100, 10);

            hash<PipelineOptionInfo> opts = <PipelineOptionInfo>{
                "name": "empty-pipeline",
                "metrics_collector": collector,
            };

            DataProviderPipeline pipe(opts);
            RecordProcessorSink proc();
            pipe.append(proc);

            # Don't submit any records
            pipe.waitDone();

            *hash<PipelineMetricsSnapshot> metrics = pipe.getMetrics();
            assertTrue(exists metrics);
            assertEq(0, metrics.total_records_submitted);
            assertEq(0, metrics.total_records_completed);
        }

        # Test that reportMetrics() exceptions don't crash the pipeline
        {
            ThrowingMetricsCollector collector(10, 1);

            hash<PipelineOptionInfo> opts = <PipelineOptionInfo>{
                "name": "throwing-report-pipeline",
                "metrics_collector": collector,
            };

            DataProviderPipeline pipe(opts);
            RecordProcessorSink proc();
            pipe.append(proc);

            # Submit records - reportMetrics will throw each time, but pipeline should continue
            for (int i = 0; i < 10; ++i) {
                pipe.submit({"record": i});
            }
            pipe.waitDone();

            # Pipeline should complete successfully despite collector errors
            hash<PipelineInfo> info = pipe.getInfo();
            assertEq(10, info.record_count);
            assertTrue(collector.shutdown_called, "shutdown should still be called after report errors");
        }

        # Test that shutdown() exceptions don't crash the pipeline
        {
            ThrowingShutdownCollector collector();

            hash<PipelineOptionInfo> opts = <PipelineOptionInfo>{
                "name": "throwing-shutdown-pipeline",
                "metrics_collector": collector,
            };

            DataProviderPipeline pipe(opts);
            RecordProcessorSink proc();
            pipe.append(proc);

            pipe.submit({"record": 1});
            # waitDone calls shutdown which throws - should not propagate
            pipe.waitDone();

            assertTrue(collector.shutdown_called, "shutdown should have been called");
            # Destructor will see isShutDown() == True and skip the second call
        }

        # Test that getIntervalMs()/getRecordInterval() exceptions don't deadlock or crash
        {
            ThrowingThresholdCollector collector();

            hash<PipelineOptionInfo> opts = <PipelineOptionInfo>{
                "name": "throwing-threshold-pipeline",
                "metrics_collector": collector,
            };

            DataProviderPipeline pipe(opts);
            RecordProcessorSink proc();
            pipe.append(proc);

            for (int i = 0; i < 10; ++i) {
                pipe.submit({"record": i});
            }
            # Should not deadlock despite threshold read errors
            pipe.waitDone();

            hash<PipelineInfo> info = pipe.getInfo();
            assertEq(10, info.record_count);
            # No periodic reportMetrics calls since thresholds couldn't be read;
            # only the forced final report from waitDone
            assertEq(1, collector.collected_metrics.size(),
                "only the forced final report should exist when threshold reads fail");
            assertTrue(collector.shutdown_called, "shutdown should still be called");
        }

        # Test idempotent shutdown (waitDone + destructor path)
        {
            TestMetricsCollector collector(1000, 1000);

            {
                hash<PipelineOptionInfo> opts = <PipelineOptionInfo>{
                    "name": "idempotent-shutdown-pipeline",
                    "metrics_collector": collector,
                };

                DataProviderPipeline pipe(opts);
                RecordProcessorSink proc();
                pipe.append(proc);

                pipe.submit({"record": 1});
                pipe.waitDone();
                assertTrue(collector.shutdown_called, "shutdown called by waitDone");

                # pipe goes out of scope here - destructor should not call forceCallback/shutdown again
            }

            # shutdown was called exactly once (the idempotency guard prevents double call)
            assertTrue(collector.shutdown_called);
        }

        # Test abort() calls shutdown
        {
            TestMetricsCollector collector(1000, 1000);

            hash<PipelineOptionInfo> opts = <PipelineOptionInfo>{
                "name": "abort-shutdown-pipeline",
                "metrics_collector": collector,
            };

            DataProviderPipeline pipe(opts);
            RecordProcessorSink proc();
            pipe.append(proc);

            pipe.submit({"record": 1});
            pipe.abort(True);

            assertTrue(collector.shutdown_called, "shutdown should be called on abort");
        }

        # Test time-based reporting only (record_interval = 0)
        {
            TestMetricsCollector collector(10, 0);

            hash<PipelineOptionInfo> opts = <PipelineOptionInfo>{
                "name": "time-only-metrics-pipeline",
                "metrics_collector": collector,
            };

            DataProviderPipeline pipe(opts);
            RecordProcessorSink proc();
            pipe.append(proc);

            for (int i = 0; i < 20; ++i) {
                pipe.submit({"record": i});
            }
            pipe.waitDone();

            # Final forced callback should always produce at least one report
            assertTrue(collector.collected_metrics.size() > 0,
                "should have received at least one metrics report");
            assertTrue(collector.shutdown_called);
        }

        # Test record-based reporting only (interval_ms = 0)
        {
            TestMetricsCollector collector(0, 5);

            hash<PipelineOptionInfo> opts = <PipelineOptionInfo>{
                "name": "record-only-metrics-pipeline",
                "metrics_collector": collector,
            };

            DataProviderPipeline pipe(opts);
            RecordProcessorSink proc();
            pipe.append(proc);

            for (int i = 0; i < 20; ++i) {
                pipe.submit({"record": i});
            }
            pipe.waitDone();

            assertTrue(collector.collected_metrics.size() > 0,
                "should have received metrics reports based on record count");
            assertTrue(collector.shutdown_called);
        }

        # Test both thresholds disabled (interval_ms = 0, record_interval = 0)
        {
            TestMetricsCollector collector(0, 0);

            hash<PipelineOptionInfo> opts = <PipelineOptionInfo>{
                "name": "no-auto-report-pipeline",
                "metrics_collector": collector,
            };

            DataProviderPipeline pipe(opts);
            RecordProcessorSink proc();
            pipe.append(proc);

            for (int i = 0; i < 20; ++i) {
                pipe.submit({"record": i});
            }
            pipe.waitDone();

            # Only the forced final callback from waitDone should produce a report
            assertEq(1, collector.collected_metrics.size(),
                "only the forced final report should exist when both thresholds are 0");
            assertEq(20, collector.collected_metrics[0].total_records_submitted);
            assertTrue(collector.shutdown_called);
        }
    }

    #! Tests for the output_callback option in DataProviderPipeline
    /** @since DataProvider 3.4
    */
    pipelineOutputCallbackTest() {
        # Test 1: Basic output callback fires for each terminal output record
        {
            list<auto> callback_records;
            TestRecordProcessor proc("A");
            DataProviderPipeline pipe(<PipelineOptionInfo>{
                "output_callback": sub (auto record) {
                    push callback_records, record;
                },
            });
            pipe.append(proc);
            pipe.submit({"x": 1});
            pipe.submit({"y": 2});
            pipe.waitDone();
            assertEq(2, callback_records.size(), "output_callback fires per output record");
            assertEq({"A-x": 1}, callback_records[0]);
            assertEq({"A-y": 2}, callback_records[1]);
        }

        # Test 2: Callback exception aborts the pipeline
        {
            int callback_count = 0;
            TestRecordProcessor proc("A");
            DataProviderPipeline pipe(<PipelineOptionInfo>{
                "output_callback": sub (auto record) {
                    ++callback_count;
                    throw "CALLBACK-ERROR", "intentional error";
                },
            });
            pipe.append(proc);
            pipe.submit({"x": 1});
            assertThrows("PIPELINE-FAILED", \pipe.waitDone());
            assertEq(1, callback_count, "callback invoked before error");
        }

        # Test 3: Fan-out — callback fires for output from all terminal queues
        {
            list<auto> callback_records;
            Mutex callback_lock();
            TestRecordProcessor proc1("A");
            TestRecordProcessor proc2("B");
            DataProviderPipeline pipe(<PipelineOptionInfo>{
                "output_callback": sub (auto record) {
                    callback_lock.lock();
                    on_exit callback_lock.unlock();
                    push callback_records, record;
                },
            });
            # Queue 0 fans out to two child queues, each with their own processor
            int q1 = pipe.appendQueue(0);
            int q2 = pipe.appendQueue(0);
            pipe.append(q1, proc1);
            pipe.append(q2, proc2);
            pipe.submit({"x": 1});
            pipe.waitDone();
            # Both terminal queues should produce output
            assertEq(2, callback_records.size(), "callback fires for each terminal queue output");
            # Check that we got records from both processors (order may vary)
            list<string> first_keys = map $1.firstKey(), callback_records;
            first_keys = sort(first_keys);
            assertEq(("A-x", "B-x"), first_keys, "output from both terminal queues");
        }

        # Test 4: No callback — pipeline works normally without output_callback
        {
            TestRecordProcessor proc("A");
            DataProviderPipeline pipe();
            pipe.append(proc);
            pipe.submit({"x": 1});
            pipe.waitDone();
            assertEq(1, proc.recs.size());
        }

        # Test 5: Callback not set on fan-out intermediate queues (only terminal)
        {
            list<auto> callback_records;
            Mutex callback_lock();
            TestRecordProcessor proc1("A");
            TestRecordProcessor proc2("B");
            TestRecordProcessor proc3("C");
            DataProviderPipeline pipe(<PipelineOptionInfo>{
                "output_callback": sub (auto record) {
                    callback_lock.lock();
                    on_exit callback_lock.unlock();
                    push callback_records, record;
                },
            });
            # Queue 0 has proc1, then fans out to q1 (proc2) and q2 (proc3)
            pipe.append(proc1);
            int q1 = pipe.appendQueue(0);
            pipe.append(q1, proc2);
            int q2 = pipe.appendQueue(0);
            pipe.append(q2, proc3);
            pipe.submit({"x": 1});
            pipe.waitDone();
            # Only terminal queues (q1 and q2) should fire the callback, not q0
            # (q0 is an intermediate queue that fans out, not a terminal queue)
            assertEq(2, callback_records.size(), "callback fires only for terminal queues");
        }

        # Test 6: Bulk mode — callback fires per individual record (unpacked from hash-of-lists)
        {
            list<auto> callback_records;
            TestRecordProcessor proc("A");
            DataProviderPipeline pipe(<PipelineOptionInfo>{
                "output_callback": sub (auto record) {
                    push callback_records, record;
                },
            });
            pipe.append(proc);
            # Submit a bulk record (hash-of-lists)
            pipe.submit({"x": (1, 2, 3), "y": (4, 5, 6)});
            pipe.waitDone();
            # In bulk mode, the processor gets the hash-of-lists and outputs hash-of-lists
            # The callback should unpack each row from the hash-of-lists
            assertTrue(callback_records.size() > 0, "callback fires for bulk output");
        }
    }

    #! Tests for the return-based processor API, data-provider-as-processor, and action catalog additions
    /** @since DataProvider 3.3
    */
    returnBasedApiTest() {
        # Test return-based processor - processRecord
        {
            ReturnBasedProcessor proc();
            *auto result = proc.processRecord({"a": 1, "b": 2});
            assertEq({"a": 1, "b": 2, "processed": True}, result);
        }

        # Test return-based filter processor
        {
            ReturnBasedFilterProcessor proc();
            *auto result = proc.processRecord({"x": 1});
            assertEq({"x": 1}, result);
            # test filtering
            result = proc.processRecord({"x": 1, "skip": True});
            assertNothing(result);
        }

        # Test processRecords (list)
        {
            ReturnBasedProcessor proc();
            *list<auto> results = proc.processRecords(({"a": 1}, {"a": 2}));
            assertEq(2, results.lsize());
            assertEq({"a": 1, "processed": True}, results[0]);
            assertEq({"a": 2, "processed": True}, results[1]);
        }

        # Test processRecords with filter
        {
            ReturnBasedFilterProcessor proc();
            *list<auto> results = proc.processRecords(({"x": 1}, {"x": 2, "skip": True}, {"x": 3}));
            assertEq(2, results.lsize());
            assertEq({"x": 1}, results[0]);
            assertEq({"x": 3}, results[1]);
        }

        # Test processRecordsBulk (hash-of-lists)
        {
            ReturnBasedProcessor proc();
            *hash<auto> result = proc.processRecordsBulk({"a": (1, 2), "b": ("x", "y")});
            # processRecordsBulk default passes hash-of-lists through processRecordImpl as a single unit
            # the ReturnBasedProcessor adds "processed": True to the hash
            assertEq(True, result.hasKey("processed"));
        }

        # Test flushRecords on aggregator
        {
            ReturnBasedAggregateProcessor proc();
            # process some records - should not produce output
            *auto result = proc.processRecord({"val": 1});
            assertNothing(result);
            result = proc.processRecord({"val": 2});
            assertNothing(result);
            # flush should return aggregated records
            *list<auto> flush_results = proc.flushRecords();
            assertEq(2, flush_results.lsize());
            assertEq({"val": 1}, flush_results[0]);
            assertEq({"val": 2}, flush_results[1]);
            # second flush should return nothing
            flush_results = proc.flushRecords();
            assertNothing(flush_results);
        }

        # Test processRecord on old closure-based processor (backwards compat bridge)
        {
            TestRecordProcessor proc("X");
            *auto result = proc.processRecord({"a": 1, "b": 2});
            assertEq({"X-a": 1, "X-b": 2}, result);
        }

        # Test submitAndCollect on old closure-based processor
        {
            TestRecordProcessor proc("Y");
            *list<auto> results = proc.submitAndCollect({"a": 1});
            assertEq(1, results.lsize());
            assertEq({"Y-a": 1}, results[0]);
        }

        # Test submitAndCollect on DuplicateRecordProcessor
        {
            DuplicateRecordProcessor proc("X", "Y");
            *list<auto> results = proc.submitAndCollect({"a": 1, "b": 2});
            assertEq(2, results.lsize());
            assertEq({"X-a": 1, "X-b": 2}, results[0]);
            assertEq({"Y-a": 1, "Y-b": 2}, results[1]);
        }

        # Test flushAndCollect on flush processor
        {
            TestFlushRecordProcessor proc("Z", NOTHING, NOTHING, {"flushed": True});
            *list<auto> flush_results = proc.flushAndCollect();
            assertEq(1, flush_results.lsize());
            assertEq({"flushed": True}, flush_results[0]);
        }

        # Test processor capabilities
        {
            ReturnBasedProcessor proc();
            assertEq(DPC_TRANSFORM, proc.getProcessorCapabilities());

            ReturnBasedFilterProcessor fproc();
            assertEq(DPC_FILTER, fproc.getProcessorCapabilities());

            ReturnBasedExpandProcessor eproc();
            assertEq(DPC_EXPAND, eproc.getProcessorCapabilities());

            ReturnBasedAggregateProcessor aproc();
            assertEq(DPC_AGGREGATE, aproc.getProcessorCapabilities());
        }

        # Test capability constants
        {
            assertEq(1, DPC_TRANSFORM);
            assertEq(2, DPC_FILTER);
            assertEq(4, DPC_EXPAND);
            assertEq(8, DPC_AGGREGATE);
            assertEq(16, DPC_SINK);
            # test bitfield combination
            int caps = DPC_TRANSFORM | DPC_FILTER;
            assertEq(3, caps);
        }

        # Test ProcessorCapabilityNameMap
        {
            assertEq("TRANSFORM", ProcessorCapabilityNameMap{DPC_TRANSFORM});
            assertEq("FILTER", ProcessorCapabilityNameMap{DPC_FILTER});
            assertEq("EXPAND", ProcessorCapabilityNameMap{DPC_EXPAND});
            assertEq("AGGREGATE", ProcessorCapabilityNameMap{DPC_AGGREGATE});
            assertEq("SINK", ProcessorCapabilityNameMap{DPC_SINK});
        }

        # Test hashListToRecords utility
        {
            hash<auto> hl = {"a": (1, 2, 3), "b": ("x", "y", "z")};
            list<auto> records = AbstractDataProcessor::hashListToRecords(hl);
            assertEq(3, records.lsize());
            assertEq({"a": 1, "b": "x"}, records[0]);
            assertEq({"a": 2, "b": "y"}, records[1]);
            assertEq({"a": 3, "b": "z"}, records[2]);
        }

        # Test recordsToHashList utility
        {
            list<auto> records = ({"a": 1, "b": "x"}, {"a": 2, "b": "y"});
            hash<auto> hl = AbstractDataProcessor::recordsToHashList(records);
            assertEq({"a": (1, 2), "b": ("x", "y")}, hl);
        }

        # Test hashListToRecords and recordsToHashList round-trip
        {
            hash<auto> orig = {"name": ("Alice", "Bob"), "age": (30, 25)};
            list<auto> records = AbstractDataProcessor::hashListToRecords(orig);
            hash<auto> roundtrip = AbstractDataProcessor::recordsToHashList(records);
            assertEq(orig, roundtrip);
        }

        # Test return-based processor in pipeline
        {
            DataProviderPipeline pipe(<PipelineOptionInfo>{
                "name": "test-return-based-pipeline",
            });
            ReturnBasedProcessor proc1();
            RecordProcessorSink sink();
            pipe.append(proc1);
            pipe.append(sink);
            pipe.submit({"a": 1});
            pipe.waitDone();
            assertEq(1, sink.recs.lsize());
            assertEq({"a": 1, "processed": True}, sink.recs[0]);
        }

        # Test mixing old and new processors in pipeline
        {
            DataProviderPipeline pipe(<PipelineOptionInfo>{
                "name": "test-mixed-pipeline",
            });
            TestRecordProcessor old_proc("X");
            ReturnBasedProcessor new_proc();
            RecordProcessorSink sink();
            pipe.append(old_proc);
            pipe.append(new_proc);
            pipe.append(sink);
            pipe.submit({"a": 1});
            pipe.waitDone();
            assertEq(1, sink.recs.lsize());
            assertEq({"X-a": 1, "processed": True}, sink.recs[0]);
        }

        # Test data provider as pipeline processor
        {
            TestPipelineDataProvider dp("P");
            assertTrue(dp.supportsPipelineProcessor());
            assertEq(DPC_TRANSFORM, dp.getProcessorCapabilities());

            # test in pipeline
            DataProviderPipeline pipe(<PipelineOptionInfo>{
                "name": "test-dp-as-processor-pipeline",
            });
            pipe.append(dp);
            RecordProcessorSink sink();
            pipe.append(sink);
            pipe.submit({"a": 1, "b": 2});
            pipe.waitDone();
            assertEq(1, sink.recs.lsize());
            assertEq({"P-a": 1, "P-b": 2}, sink.recs[0]);
        }

        # Test that plain AbstractDataProvider throws on processRecord
        {
            TestPipelineDataProvider dp("Q");
            # TestPipelineDataProvider overrides processRecordImpl, so it should work
            *auto result = dp.processRecord({"x": 1});
            assertEq({"Q-x": 1}, result);
        }

        # Negative test: recursion guard - processor with neither method overridden
        {
            BrokenProcessor proc();
            assertThrows("PROCESSOR-ERROR", \proc.processRecord(), ({"a": 1},));
        }

        # Negative test: recursion guard via submit (old API)
        {
            BrokenProcessor proc();
            code enqueue = sub (auto data) {};
            assertThrows("PROCESSOR-ERROR", \proc.submit(), (enqueue, {"a": 1}));
        }

        # Test DPAT_PIPELINE_PROCESSOR constant
        {
            assertEq(10, DPAT_PIPELINE_PROCESSOR);
            assertEq("supports_pipeline_processors", ActionCodeFlagMap{DPAT_PIPELINE_PROCESSOR});
            assertEq("supports_pipeline_processor", ActionAttrMap{DPAT_PIPELINE_PROCESSOR});
            assertEq("PIPELINE_PROCESSOR", ActionNameMap{DPAT_PIPELINE_PROCESSOR});
        }

        # Test registering a pipeline processor action
        {
            string app = get_random_string();
            hash<DataProviderAppInfo> my_app = <DataProviderAppInfo>{
                "name": app,
                "display_name": "test",
                "short_desc": "test",
                "desc": "test action catalog pipeline processor",
                "groups": (AppGroup::DataTransformation,),
                "logo": "data",
                "logo_mime_type": MimeTypeSvg,
                "logo_file_name": "test.svg",
                "dynamic": True,
            };
            DataProviderActionCatalog::registerApp(my_app);

            # negative test: pipeline processor action without capabilities
            assertThrows("ACTION-ERROR", \DataProviderActionCatalog::registerAction(),
                (<DataProviderActionInfo>{
                    "app": app,
                    "action": "bad-action",
                    "path": "/test",
                    "display_name": "Bad Processor",
                    "short_desc": "test",
                    "desc": "test",
                    "action_code": DPAT_PIPELINE_PROCESSOR,
                },));

            # positive test: pipeline processor action with capabilities
            DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
                "app": app,
                "action": "good-processor",
                "path": "/test-proc",
                "display_name": "Good Processor",
                "short_desc": "test processor",
                "desc": "test pipeline processor action",
                "action_code": DPAT_PIPELINE_PROCESSOR,
                "processor_capabilities": DPC_TRANSFORM,
            });

            # verify action was registered
            *hash<DataProviderActionInfo> action = DataProviderActionCatalog::getAppAction(app, "good-processor");
            assertTrue(action.val());
            assertEq(DPAT_PIPELINE_PROCESSOR, action.action_code);
            assertEq(DPC_TRANSFORM, action.processor_capabilities);

            # verify supports_pipeline_processors flag on app
            *hash<DataProviderAppInfo> app_info = DataProviderActionCatalog::getApp(app);
            assertTrue(app_info.supports_pipeline_processors);

            # verify default input/output data types
            assertTrue(action.input_data_types{DPAD_NORMAL});
            assertTrue(action.input_data_types{DPAD_RECORD_SET});
            assertEq(DPAD_NORMAL, action.output_data_type);

            # clean up
            DataProviderActionCatalog::deregisterDynamicApp(app);
        }

        # Test that getApp() initializes pending actions and sets supports_* flags
        {
            string app = get_random_string();
            hash<DataProviderAppInfo> my_app = <DataProviderAppInfo>{
                "name": app,
                "display_name": "test lazy init",
                "short_desc": "test lazy init app",
                "desc": "test lazy init description",
                "groups": ("Test",),
                "logo": "<svg></svg>",
                "logo_file_name": "test.svg",
                "logo_mime_type": MimeTypeSvg,
                "dynamic": True,
            };
            DataProviderActionCatalog::registerApp(my_app);

            # register action lazily via registerPendingAppAction
            DataProviderActionCatalog::registerPendingAppAction(app, "lazy-processor", sub () {
                DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
                    "app": app,
                    "path": "/lazy",
                    "action": "lazy-processor",
                    "display_name": "Lazy Processor",
                    "short_desc": "lazy processor for test",
                    "desc": "lazy processor for test",
                    "action_code": DPAT_PIPELINE_PROCESSOR,
                    "processor_capabilities": DPC_TRANSFORM,
                });
            });

            # verify getApp() initializes lazy actions and sets supports_pipeline_processors
            *hash<DataProviderAppInfo> app_info = DataProviderActionCatalog::getApp(app);
            assertTrue(app_info.supports_pipeline_processors);

            # clean up
            DataProviderActionCatalog::deregisterDynamicApp(app);
        }

        # Test that getAppEx() initializes pending actions and sets supports_* flags
        {
            string app = get_random_string();
