            # verify searchAppRegex() initializes lazy actions and sets supports_find
            *list<hash<DataProviderAppInfo>> results = DataProviderActionCatalog::searchAppRegex(app);
            assertEq(1, results.size());
            assertTrue(results[0].supports_find);

            # clean up
            DataProviderActionCatalog::deregisterDynamicApp(app);
        }

        # Test that searchAppSubstr() initializes pending actions and sets supports_* flags
        {
            string app = get_random_string();
            hash<DataProviderAppInfo> my_app = <DataProviderAppInfo>{
                "name": app,
                "display_name": "test lazy search substr",
                "short_desc": "test lazy search substr app",
                "desc": "test lazy search substr description",
                "groups": ("Test",),
                "logo": "<svg></svg>",
                "logo_file_name": "test.svg",
                "logo_mime_type": MimeTypeSvg,
                "dynamic": True,
            };
            DataProviderActionCatalog::registerApp(my_app);

            # register action lazily
            DataProviderActionCatalog::registerPendingAppAction(app, "lazy-create", sub () {
                DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
                    "app": app,
                    "path": "/lazy-create",
                    "action": "lazy-create",
                    "display_name": "Lazy Create",
                    "short_desc": "lazy create action for test",
                    "desc": "lazy create action for test",
                    "action_code": DPAT_CREATE,
                });
            });

            # verify searchAppSubstr() initializes lazy actions and sets supports_create
            *list<hash<DataProviderAppInfo>> results = DataProviderActionCatalog::searchAppSubstr(app);
            assertEq(1, results.size());
            assertTrue(results[0].supports_create);

            # clean up
            DataProviderActionCatalog::deregisterDynamicApp(app);
        }

        # Test DataProviderInfo and DataProviderSummaryInfo pipeline fields
        {
            TestPipelineDataProvider dp("T");
            hash<DataProviderSummaryInfo> summary = dp.getSummaryInfo();
            assertTrue(summary.supports_pipeline_processor);
            assertEq(DPC_TRANSFORM, summary.processor_capabilities);
        }

        # Test supportsBulkApi default returns True
        {
            ReturnBasedProcessor proc();
            assertTrue(proc.supportsBulkApi());
        }

        # Test expand processor in pipeline
        {
            DataProviderPipeline pipe(<PipelineOptionInfo>{
                "name": "test-expand-pipeline",
            });
            ReturnBasedExpandProcessor proc();
            RecordProcessorSink sink();
            pipe.append(proc);
            pipe.append(sink);
            pipe.submit({"val": 1});
            pipe.waitDone();
            assertEq(2, sink.recs.lsize());
            assertEq({"val": 1, "copy": 1}, sink.recs[0]);
            assertEq({"val": 1, "copy": 2}, sink.recs[1]);
        }

        # Test aggregator in pipeline
        {
            DataProviderPipeline pipe(<PipelineOptionInfo>{
                "name": "test-aggregate-pipeline",
            });
            ReturnBasedAggregateProcessor proc();
            RecordProcessorSink sink();
            pipe.append(proc);
            pipe.append(sink);
            pipe.submit({"val": 1});
            pipe.submit({"val": 2});
            pipe.submit({"val": 3});
            pipe.waitDone();
            # flushed records should flow through to sink
            assertEq(3, sink.recs.lsize());
            assertEq({"val": 1}, sink.recs[0]);
            assertEq({"val": 2}, sink.recs[1]);
            assertEq({"val": 3}, sink.recs[2]);
        }
    }

    typeCacheTest() {
        HashDataType h1();
        HashDataType h2();
        HashDataType h3();
        HashDataType hx();
        DataProviderTypeCache type_cache();
        assertEq(0, type_cache.size());
        assertTrue(type_cache.empty());

        type_cache.registerType("test/one", h1);
        assertEq(1, type_cache.size());
        assertFalse(type_cache.empty());
        assertThrows("TYPE-ERROR", \type_cache.registerType(), ("test/one", h2));
        assertNothing(h2.getPath());
        hash<DataProviderTypeEntryInfo> type_info = type_cache.getTypeInfo("test/one");
        assertEq(-1, type_info.epheremal_type_id);
        assertEq("one", type_info.name);
        assertEq("/test/one", type_info.path);
        assertFalse(type_info.locked);
        assertTrue(type_info.has_type);
        assertNothing(type_info.children);
        type_info = type_cache.getTypeInfo("/test/one");
        assertEq("one", type_info.name);
        assertEq("/test/one", type_info.path);
        assertFalse(type_info.locked);
        assertTrue(type_info.has_type);
        assertNothing(type_info.children);
        assertEq(h1, type_cache.lookupTypeFromId(-1));
        assertEq(h1, type_cache.lookupTypeFromPath("test/one"));
        assertEq(h1, type_cache.lookupTypeFromPath("/test/one"));

        type_cache.registerType("test/two", h2);
        assertEq(2, type_cache.size());
        assertThrows("TYPE-ARG-ERROR", \type_cache.registerType(), ("test/two", h1));
        assertEq("/test/one", h1.getPath());
        assertThrows("TYPE-ERROR", \type_cache.registerType(), ("test/two", hx));
        assertNothing(hx.getPath());
        type_info = type_cache.getTypeInfo("test/two");
        assertEq(-2, type_info.epheremal_type_id);
        assertEq("two", type_info.name);
        assertEq("/test/two", type_info.path);
        assertFalse(type_info.locked);
        assertTrue(type_info.has_type);
        assertNothing(type_info.children);
        type_info = type_cache.getTypeInfo("/test/two");
        assertEq("two", type_info.name);
        assertEq("/test/two", type_info.path);
        assertFalse(type_info.locked);
        assertTrue(type_info.has_type);
        assertNothing(type_info.children);
        assertEq(h2, type_cache.lookupTypeFromId(-2));

        type_cache.registerType("test/three", h3, True);
        assertEq(3, type_cache.size());
        assertThrows("TYPE-ARG-ERROR", \type_cache.registerType(), ("test/three", h1));
        assertEq("/test/one", h1.getPath());
        assertThrows("TYPE-ERROR", \type_cache.registerType(), ("test/three", hx));
        assertNothing(hx.getPath());
        assertEq(("/test/one", "/test/two", "/test/three"), type_cache.listTypes());
        assertEq(h1, type_cache.getType("test/one"));
        assertEq(h1, type_cache.getType("/test/one"));
        assertEq(h2, type_cache.getType("test/two"));
        assertEq(h3, type_cache.getType("test/three"));
        assertNothing(type_cache.getType("test/xxx"));
        assertNothing(type_cache.getType("/test/xxx"));
        assertThrows("PROVIDER-ERROR", \type_cache.getTypeEx(), ("test/xxx"));
        assertThrows("PROVIDER-ERROR", \type_cache.getTypeEx(), ("/test/xxx"));
        type_info = type_cache.getTypeInfo("test/three");
        assertEq(-3, type_info.epheremal_type_id);
        assertEq("three", type_info.name);
        assertEq("/test/three", type_info.path);
        assertTrue(type_info.locked);
        assertTrue(type_info.has_type);
        assertNothing(type_info.children);
        type_info = type_cache.getTypeInfo("/test/three");
        assertEq("three", type_info.name);
        assertEq("/test/three", type_info.path);
        assertTrue(type_info.locked);
        assertTrue(type_info.has_type);
        assertNothing(type_info.children);
        assertEq(h3, type_cache.lookupTypeFromId(-3));

        HashDataType h2bis();
        assertTrue(type_cache.registerOrReplaceType("test/two", h2bis));
        assertEq(3, type_cache.size());
        assertEq(h2bis, type_cache.getType("test/two"));
        assertEq(h2bis, type_cache.removeType("test/two"));
        assertEq(2, type_cache.size());
        assertNothing(type_cache.getType("test/two"));
        assertNothing(type_cache.getType("/test/two"));
        assertThrows("PROVIDER-ERROR", \type_cache.getTypeEx(), ("test/two"));
        assertThrows("PROVIDER-ERROR", \type_cache.getTypeEx(), ("/test/two"));
        assertEq(("/test/one", "/test/three"), type_cache.listTypes());
        assertEq(h1, type_cache.getType("test/one"));
        assertEq(h1, type_cache.getType("/test/one"));
        assertEq(h3, type_cache.getType("test/three"));
        assertEq(h3, type_cache.getType("/test/three"));
        assertFalse(type_cache.registerOrReplaceType("test/one", h1));
        assertFalse(type_cache.registerOrReplaceType("/test/one", h1));
        type_cache.registerType("test/one", h1);
        type_cache.registerType("/test/one", h1);
        assertEq(2, type_cache.size());
        type_cache.clear();
        assertEq(2, type_cache.size());
        assertEq(("/test/three",), type_cache.listTypes());

        DataProviderTypeCache t2 = Serializable::deserialize(type_cache.serialize());
        assertEq(2, t2.size());

        HashDataType h4();
        h4.addField(new QoreDataField("key1", "desc1", StringType));
        HashDataType ch1();
        ch1.addField(new QoreDataField("key1", "desc1", StringType));
        h4.addField(new QoreDataField("key2", "desc2", ch1));
        type_cache.registerType("test/four", h4);
        assertEq("string", type_cache.getType("/test/four/key1").getBaseTypeName());
        DataProviderTypeEntry entry = type_cache.getRoot().getChild("test").getChild("four");
        assertEq(("key1", "key2"), entry.getInfo().children);
        assertEq(("key2",), entry.getInfo(True).children);
        assertEq(("key1", "key2"), type_cache.getTypeInfo("/test/four").children);
        assertEq(("key2",), type_cache.getTypeInfo("/test/four", True).children);
        assertEq(("key1", "key2"), type_cache.getTypeInfoEx("/test/four").children);
        assertEq(("key2",), type_cache.getTypeInfoEx("/test/four", True).children);
    }

    dataProviderTest() {
        {
            AbstractDataProviderType t = EpochIntToDateType;
            assertEq(1970-01-01Z, t.acceptsValue(0));
            t = AbstractDataProviderTypeMap."epoch";
            assertEq(1970-01-01Z, t.acceptsValue(0));
            t = AbstractDataProviderTypeMap."*epoch";
            assertEq(1970-01-01Z, t.acceptsValue(0));
            assertNothing(t.acceptsValue(NOTHING));
            assertNothing(t.acceptsValue(NULL));
        }

        {
            AbstractDataProviderType t = SuperSoftStringDataType;
            assertEq("true", t.acceptsValue(True));
            assertEq("2025-05-21T09:48:57+02:00", t.acceptsValue(2025-05-21T09:48:57+02:00));
%ifndef NoYaml
            assertEq("{a: 1}", t.acceptsValue({"a": 1}));
            assertEq("[\"a\", 1]", t.acceptsValue(("a", 1)));
%endif
            t = AbstractDataProviderTypeMap."supersoftstring";
            assertEq("true", t.acceptsValue(True));
            assertEq("2025-05-21T09:48:57+02:00", t.acceptsValue(2025-05-21T09:48:57+02:00));
%ifndef NoYaml
            assertEq("{a: 1}", t.acceptsValue({"a": 1}));
            assertEq("[\"a\", 1]", t.acceptsValue(("a", 1)));
%endif

            t = AbstractDataProviderTypeMap."string";
            FlexibleTypeHandlingHelper fthh();
            assertEq("true", t.acceptsValue(True));
            assertEq("2025-05-21T09:48:57+02:00", t.acceptsValue(2025-05-21T09:48:57+02:00));
%ifndef NoYaml
            assertEq("{a: 1}", t.acceptsValue({"a": 1}));
            assertEq("[\"a\", 1]", t.acceptsValue(("a", 1)));
%endif
        }

        {
            AbstractDataProviderType t = SuperSoftStringOrNothingDataType;
            assertEq("true", t.acceptsValue(True));
            assertEq("2025-05-21T09:48:57+02:00", t.acceptsValue(2025-05-21T09:48:57+02:00));
%ifndef NoYaml
            assertEq("{a: 1}", t.acceptsValue({"a": 1}));
            assertEq("[\"a\", 1]", t.acceptsValue(("a", 1)));
%endif
            assertNothing(t.acceptsValue(NOTHING));
            assertNothing(t.acceptsValue(NULL));
            t = AbstractDataProviderTypeMap."*supersoftstring";
            assertEq("true", t.acceptsValue(True));
            assertEq("2025-05-21T09:48:57+02:00", t.acceptsValue(2025-05-21T09:48:57+02:00));
%ifndef NoYaml
            assertEq("{a: 1}", t.acceptsValue({"a": 1}));
            assertEq("[\"a\", 1]", t.acceptsValue(("a", 1)));
%endif
            assertNothing(t.acceptsValue(NOTHING));
            assertNothing(t.acceptsValue(NULL));
        }

        {
            # test for issue #4951
            QoreDataField f({
                "name": "key1",
                "desc": "desc1",
                "type": SoftAutoListType,
                "element_allowed_values": (
                    <AllowedValueInfo>{
                        "value": "one",
                    },
                    <AllowedValueInfo>{
                        "value": "two",
                    },
                ),
            });
            assertEq(("one",), f.acceptsValue("one"));
            assertEq(("one",), f.acceptsValue(("one",)));
            assertThrows("FIELD-VALUE-ERROR", \f.acceptsValue(), ("three",));
        }
        {
            # test for issue #4951
            QoreDataField f({
                "name": "key1",
                "desc": "desc1",
                "type": AutoListType,
                "element_allowed_values": (
                    <AllowedValueInfo>{
                        "value": "one",
                    },
                    <AllowedValueInfo>{
                        "value": "two",
                    },
                ),
            });
            assertEq(("one",), f.acceptsValue(("one",)));
            assertThrows("RUNTIME-TYPE-ERROR", \f.acceptsValue(), ("three",));
            assertThrows("FIELD-VALUE-ERROR", \f.acceptsValue(), (("three",),));
        }

        {
            AbstractDataProviderType t = AbstractDataProviderTypeMap.unixts;
            assertEq(1737461067, t.acceptsValue(2025-01-21T13:04:27.123456+01:00));
            assertEq(1737461067, t.acceptsValue(1737461067));
            assertNothing(t.getDefaultValue());
            assertThrows("RUNTIME-TYPE-ERROR", \t.acceptsValue(), True);
            assertThrows("RUNTIME-TYPE-ERROR", \t.acceptsValue(), NOTHING);
            assertThrows("RUNTIME-TYPE-ERROR", \t.acceptsValue(), NULL);
            t = t.getOrNothingType();
            assertEq(1737461067, t.acceptsValue(2025-01-21T13:04:27.123456+01:00));
            assertEq(1737461067, t.acceptsValue(1737461067));
            assertNothing(t.getDefaultValue());
            assertNothing(t.acceptsValue(NOTHING));
            assertNothing(t.acceptsValue(NULL));
            assertThrows("RUNTIME-TYPE-ERROR", \t.acceptsValue(), True);
            t = AbstractDataProviderTypeMap."*unixts";
            assertEq(1737461067, t.acceptsValue(2025-01-21T13:04:27.123456+01:00));
            assertEq(1737461067, t.acceptsValue(1737461067));
            assertNothing(t.getDefaultValue());
            assertNothing(t.acceptsValue(NOTHING));
            assertNothing(t.acceptsValue(NULL));
            assertThrows("RUNTIME-TYPE-ERROR", \t.acceptsValue(), True);
            t = t.getMandatoryType();
            assertEq(1737461067, t.acceptsValue(2025-01-21T13:04:27.123456+01:00));
            assertEq(1737461067, t.acceptsValue(1737461067));
            assertNothing(t.getDefaultValue());
            assertThrows("RUNTIME-TYPE-ERROR", \t.acceptsValue(), True);
            assertThrows("RUNTIME-TYPE-ERROR", \t.acceptsValue(), NOTHING);
            assertThrows("RUNTIME-TYPE-ERROR", \t.acceptsValue(), NULL);
            t = AbstractDataProviderTypeMap.unixtsms;
            assertEq(1737461067123, t.acceptsValue(2025-01-21T13:04:27.123456+01:00));
            assertEq(1737461067123, t.acceptsValue(1737461067123));
            assertNothing(t.getDefaultValue());
            assertThrows("RUNTIME-TYPE-ERROR", \t.acceptsValue(), True);
            assertThrows("RUNTIME-TYPE-ERROR", \t.acceptsValue(), NOTHING);
            assertThrows("RUNTIME-TYPE-ERROR", \t.acceptsValue(), NULL);
            t = t.getOrNothingType();
            assertEq(1737461067123, t.acceptsValue(2025-01-21T13:04:27.123456+01:00));
            assertEq(1737461067123, t.acceptsValue(1737461067123));
            assertNothing(t.getDefaultValue());
            assertNothing(t.acceptsValue(NOTHING));
            assertNothing(t.acceptsValue(NULL));
            assertThrows("RUNTIME-TYPE-ERROR", \t.acceptsValue(), True);
            t = AbstractDataProviderTypeMap."*unixtsms";
            assertEq(1737461067123, t.acceptsValue(2025-01-21T13:04:27.123456+01:00));
            assertEq(1737461067123, t.acceptsValue(1737461067123));
            assertNothing(t.getDefaultValue());
            assertNothing(t.acceptsValue(NOTHING));
            assertNothing(t.acceptsValue(NULL));
            assertThrows("RUNTIME-TYPE-ERROR", \t.acceptsValue(), True);
            t = t.getMandatoryType();
            assertEq(1737461067123, t.acceptsValue(2025-01-21T13:04:27.123456+01:00));
            assertEq(1737461067123, t.acceptsValue(1737461067123));
            assertNothing(t.getDefaultValue());
            assertThrows("RUNTIME-TYPE-ERROR", \t.acceptsValue(), True);
            assertThrows("RUNTIME-TYPE-ERROR", \t.acceptsValue(), NOTHING);
            assertThrows("RUNTIME-TYPE-ERROR", \t.acceptsValue(), NULL);
        }

        {
            assertEq("hash<auto>", AbstractDataProviderType::get("hash<auto>").getName());
            assertEq("hash<string, bool>", AbstractDataProviderType::get("hash<string, bool>").getName());
            assertEq("*hash<auto>", AbstractDataProviderType::get("*hash<auto>").getName());
            assertEq("*hash<string, bool>", AbstractDataProviderType::get("*hash<string, bool>").getName());
            assertThrows("UNKNOWN-TYPE", "xyz", \AbstractDataProviderType::get(), "xyz");
            assertThrows("UNKNOWN-TYPE", "hash<string>", \AbstractDataProviderType::get(), "hash<string>");

            AbstractDataProviderType list_type = AbstractDataProviderType::get("list<string>");
            AbstractDataProviderType list_rt = AbstractDataProviderType::get(list_type.getInfo());
            assertEq("list<string>", list_rt.getName());
            assertEq("string", list_rt.getElementType().getName());
            assertEq(("a", "b"), list_rt.acceptsValue(("a", "b")));
            assertThrows("RUNTIME-TYPE-ERROR", \list_rt.acceptsValue(), (1,));

            AbstractDataProviderType hash_type = AbstractDataProviderType::get("hash<string, bool>");
            AbstractDataProviderType hash_rt = AbstractDataProviderType::get(hash_type.getInfo());
            assertEq("hash<string, bool>", hash_rt.getName());
            assertEq("bool", hash_rt.getElementType().getName());
            assertEq({"enabled": True}, hash_rt.acceptsValue({"enabled": True}));
            assertThrows("RUNTIME-TYPE-ERROR", \hash_rt.acceptsValue(), {"enabled": "yes"});
        }

        {
            assertEq(("hash<string, list<int>>", "string"),
                AbstractDataProviderType::splitTypeUnion("hash<string, list<int>>|string"));
            assertThrows("UNKNOWN-TYPE", "empty alternative",
                \AbstractDataProviderType::splitTypeUnion(), "string|");

            AbstractDataProviderType t = AbstractDataProviderType::get("list<string>|list<hash>");
            assertEq("QoreUnionDataType", t.className());
            assertEq("list<string>|list<hash>", t.getName());
            assertEq("list", t.getBaseTypeName());
            assertTrue(t.isMandatory());
            hash<DataTypeInfo> tinfo = t.getInfo();
            assertEq(2, tinfo.union_types.size());
            assertEq(("list<string>", "list<hash>"), map $1.name, tinfo.union_types);
            AbstractDataProviderType rt = AbstractDataProviderType::get(tinfo);
            assertEq("QoreUnionDataType", rt.className());
            assertEq(t.getName(), rt.getName());
            assertEq(("a", "b"), t.acceptsValue(("a", "b")));
            assertEq(({"a": 1},), t.acceptsValue(({"a": 1},)));
            assertThrows("RUNTIME-TYPE-ERROR", "union type", \t.acceptsValue(), (1,));

            t = AbstractDataProviderType::get("*list<string>|*list<hash>");
            assertFalse(t.isMandatory());
            assertNothing(t.acceptsValue());
            assertNothing(t.acceptsValue(NULL));
            assertEq("list<string>|list<hash>", t.getMandatoryType().getName());

            ListDataType lt(AbstractDataProviderType::get("string|int"));
            assertEq("list<string|int>", lt.getName());
            assertEq("list<auto>", lt.getValueType().getName());
            AbstractDataProviderType ltrt = AbstractDataProviderType::get(lt.getInfo());
            assertEq("list<string|int>", ltrt.getName());
            assertEq("QoreUnionDataType", ltrt.getElementType().className());
            assertEq(("a", 1), lt.acceptsValue(("a", 1)));
            assertEq(("a", 1), ltrt.acceptsValue(("a", 1)));
            assertThrows("RUNTIME-TYPE-ERROR", \ltrt.acceptsValue(), (True,));
        }

        {
            AbstractDataProviderType type = DataProvider::getType("/qore/ftp/event");
            assertEq("hash<auto>", type.getValueType().getName());
            type = DataProvider::getType("qore/ftp/event");
            {
                AbstractDataProviderType t = Serializable::deserialize(type.serialize());
                assertEq("FtpPollerFileEventInfoDataType", t.className());
                assertEq("data", t.getField("data").getType().getValueType().getName());
            }
            assertEq("hash<auto>", type.getValueType().getName());
            assertNothing(DataProvider::getType("xxx"));
            assertThrows("PROVIDER-ERROR", \DataProvider::getTypeEx(), "xxx");
            type = DataProvider::getType("/qore/ftp/event/filepath");
            assertEq("string", type.getName());
            type = DataProvider::getType("qore/ftp/event/filepath");
            assertEq("string", type.getName());
            assertThrows("PROVIDER-ERROR", \DataProvider::getTypeEx(), "/qore/ftp/event/xxx");
            assertThrows("PROVIDER-ERROR", \DataProvider::getTypeEx(), "qore/ftp/event/xxx");
        }

        {
            Type type("hash<StatInfo>");
            AbstractDataProviderType datatype = AbstractDataProviderType::get(type);
            assertEq("hash<StatInfo>", datatype.getName());
            assertTrue(datatype.isAssignableFrom(HashType));
            assertTrue(IntType.isEqual(datatype.getField("size").getType().getValueType()));
        }

        {
            QoreNumberDataType type();
            assertThrows("RUNTIME-TYPE-ERROR", \type.acceptsValue(), "1");
            assertThrows("RUNTIME-TYPE-ERROR", \type.acceptsValue(), NOTHING);
            assertThrows("RUNTIME-TYPE-ERROR", \type.acceptsValue(), NULL);

            AbstractDataProviderType type1 = type.getSoftType();
            assertEq("softnumber", type1.getName());
            assertEq(1n, type1.acceptsValue("1"));
            assertEq(1234.56n, type1.acceptsValue("1234.56"));
        }

        {
            QoreNumberOrNothingDataType type();
            assertThrows("RUNTIME-TYPE-ERROR", \type.acceptsValue(), "1");

            AbstractDataProviderType type1 = type.getSoftType();
            assertEq("*softnumber", type1.getName());
            assertEq(1n, type1.acceptsValue("1"));
            assertEq(1234.56n, type1.acceptsValue("1234.56"));
            assertNothing(type1.acceptsValue());
            assertNothing(type1.acceptsValue(NULL));
        }

        {
            QoreSoftNumberDataType num1({"number.format": ".,"});
            assertEq(1234.56n, num1.acceptsValue("1.234,56"));
            # NULL and NOTHING are treated the same for soft types - both reject without qore.no_null
            assertThrows("RUNTIME-TYPE-ERROR", \num1.acceptsValue());
            assertThrows("RUNTIME-TYPE-ERROR", \num1.acceptsValue(), NULL);
        }

        {
            QoreSoftNumberDataType num1({"qore.no_null": True});
            assertThrows("RUNTIME-TYPE-ERROR", \num1.acceptsValue());
            assertThrows("RUNTIME-TYPE-ERROR", \num1.acceptsValue(), NULL);
        }

        {
            QoreSoftNumberOrNothingDataType num2({"number.format": ".,"});
            assertEq(1234.56n, num2.acceptsValue("1.234,56"));
            assertNothing(num2.acceptsValue());
            assertNothing(num2.acceptsValue(NULL));
        }

        {
            QoreSoftNumberOrNothingDataType num2();
            assertNothing(num2.acceptsValue(""));
            assertNothing(num2.acceptsValue());
            assertNothing(num2.acceptsValue(NULL));
        }

        {
            QoreBinaryDataType type();
            assertThrows("RUNTIME-TYPE-ERROR", \type.acceptsValue(), "1");
            assertThrows("RUNTIME-TYPE-ERROR", \type.acceptsValue(), NOTHING);
            assertThrows("RUNTIME-TYPE-ERROR", \type.acceptsValue(), NULL);

            AbstractDataProviderType type1 = type.getSoftType();
            assertEq("softbinary", type1.getName());
            assertEq(<31>, type1.acceptsValue("1"));
            assertEq(<3132>, type1.acceptsValue("12"));
        }

        {
            QoreBinaryOrNothingDataType type();
            assertThrows("RUNTIME-TYPE-ERROR", \type.acceptsValue(), "1");

            AbstractDataProviderType type1 = type.getSoftType();
            assertEq("*softbinary", type1.getName());
            assertEq(<31>, type1.acceptsValue("1"));
            assertEq(<3132>, type1.acceptsValue("12"));
            assertNothing(type1.acceptsValue());
            assertNothing(type1.acceptsValue(NULL));
        }

        {
            QoreSoftBinaryDataType bin1();
            assertEq(<3132>, bin1.acceptsValue("12"));
            assertThrows("RUNTIME-TYPE-ERROR", \bin1.acceptsValue());
            assertThrows("RUNTIME-TYPE-ERROR", \bin1.acceptsValue(), NULL);
        }

        {
            QoreSoftBinaryDataType bin1({"qore.no_null": True});
            assertThrows("RUNTIME-TYPE-ERROR", \bin1.acceptsValue());
            assertThrows("RUNTIME-TYPE-ERROR", \bin1.acceptsValue(), NULL);
        }

        {
            QoreSoftBinaryOrNothingDataType bin1();
            assertEq(<3132>, bin1.acceptsValue("12"));
            assertNothing(bin1.acceptsValue(""));
            assertNothing(bin1.acceptsValue());
            assertNothing(bin1.acceptsValue(NULL));
        }

        {
            QoreIntDataType type();
            assertThrows("RUNTIME-TYPE-ERROR", \type.acceptsValue(), "1");
            assertThrows("RUNTIME-TYPE-ERROR", \type.acceptsValue(), NOTHING);
            assertThrows("RUNTIME-TYPE-ERROR", \type.acceptsValue(), NULL);

            AbstractDataProviderType type1 = type.getSoftType();
            assertEq("softint", type1.getName());
            assertEq(1, type1.acceptsValue("1"));
            assertEq(1234, type1.acceptsValue("1234"));
        }

        {
            QoreIntOrNothingDataType type();
            assertThrows("RUNTIME-TYPE-ERROR", \type.acceptsValue(), "1");

            AbstractDataProviderType type1 = type.getSoftType();
            assertEq("*softint", type1.getName());
            assertEq(1, type1.acceptsValue("1"));
            assertEq(1234, type1.acceptsValue("1234"));
            assertNothing(type1.acceptsValue());
