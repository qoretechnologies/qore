    }
}

class TestMetricsCollector inherits AbstractPipelineMetricsCollector {
    public {
        list<hash<PipelineMetricsSnapshot>> collected_metrics;
        Mutex m();
        int interval_ms;
        int record_interval;
        *hash<auto> user_context;
        bool shutdown_called = False;
    }

    constructor(int interval_ms = 10, int record_interval = 5, *hash<auto> user_context) {
        self.interval_ms = interval_ms;
        self.record_interval = record_interval;
        self.user_context = user_context;
    }

    int getIntervalMs() {
        return interval_ms;
    }

    int getRecordInterval() {
        return record_interval;
    }

    reportMetrics(hash<PipelineMetricsSnapshot> snapshot) {
        if (user_context) {
            snapshot.user_context = user_context;
        }
        m.lock();
        on_exit m.unlock();
        collected_metrics += snapshot;
    }

    shutdown() {
        shutdown_called = True;
    }
}

#! Metrics collector that throws from reportMetrics()
class ThrowingMetricsCollector inherits AbstractPipelineMetricsCollector {
    public {
        int interval_ms;
        int record_interval;
        bool shutdown_called = False;
        int report_count = 0;
    }

    constructor(int interval_ms = 10, int record_interval = 5) {
        self.interval_ms = interval_ms;
        self.record_interval = record_interval;
    }

    int getIntervalMs() {
        return interval_ms;
    }

    int getRecordInterval() {
        return record_interval;
    }

    reportMetrics(hash<PipelineMetricsSnapshot> snapshot) {
        ++report_count;
        throw "METRICS-ERROR", "test error from reportMetrics";
    }

    shutdown() {
        shutdown_called = True;
    }
}

