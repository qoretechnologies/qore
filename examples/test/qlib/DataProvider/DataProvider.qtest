#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%allow-injection

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/Mime.qm
%requires ../../../../qlib/DataProvider

%requires reflection

%try-module yaml
%define NoYaml
%endtry

%exec-class DataProviderTest

class TestRecordProvider inherits AbstractDataProviderRecordIterator {
    private {
        bool ok = False;
    }

    bool valid() {
        return ok;
    }

    hash<auto> getValue() {
        if (!ok) {
            throw "INVALID-ITERATOR", "error";
        }

        return {
            "a": 1,
            "b": 2,
        };
    }

    private bool nextImpl() {
        return ok = !ok;
    }
}

class InfiniteRecordProvider inherits AbstractDataProviderRecordIterator {
    bool valid() {
        return True;
    }

    hash<auto> getValue() {
        return {"a": 1, "b": 2};
    }

    private bool nextImpl() {
        return True;
    }
}

class TestRecordProcessor inherits AbstractDataProcessor {
    public {
        string pfx;
        list<hash<auto>> recs;
        list<hash<auto>> raw_recs;
        *hash<auto> crec;
        *bool raise_error;
    }

    constructor(string pfx, *hash<auto> crec, *bool raise_error) {
        self.pfx = pfx;
        self.crec = crec;
        self.raise_error = raise_error;
    }

    clear() {
        remove recs;
    }

    setRaiseError() {
        raise_error = True;
    }

    private submitImpl(code enqueue, auto rec) {
        if (raise_error) {
            remove raise_error;
            throw "ERROR", "error";
        }
        hash<auto> new_rec = (map {pfx + "-" + $1.key: $1.value}, rec.pairIterator()) + crec;
        raw_recs += new_rec;
        recs += map $1, new_rec.contextIterator();
        enqueue(new_rec);
    }

    private bool supportsBulkApiImpl() {
        return True;
    }
}

class TestFlushRecordProcessor inherits TestRecordProcessor {
    private {
        *hash<auto> new_rec;
    }

    constructor(string pfx, *hash<auto> crec, *bool raise_error, *hash<auto> new_rec)
        : TestRecordProcessor(pfx, crec, raise_error) {
        self.new_rec = new_rec;
    }

    private flushImpl(code enqueue) {
        if (new_rec) {
            enqueue(new_rec);
        }
    }
}

class DuplicateRecordProcessor inherits AbstractDataProcessor {
    public {
        string pfx1;
        string pfx2;
    }

    constructor(string pfx1, string pfx2) {
        self.pfx1 = pfx1;
        self.pfx2 = pfx2;
    }

    private submitImpl(code enqueue, auto rec) {
        hash<auto> rec1 = (map {pfx1 + "-" + $1.key: $1.value}, rec.pairIterator());
        enqueue(rec1);
        hash<auto> rec2 = (map {pfx2 + "-" + $1.key: $1.value}, rec.pairIterator());
        enqueue(rec2);
    }

    private bool supportsBulkApiImpl() {
        return True;
    }
}

class RecordProcessorSink inherits AbstractDataProcessor {
    public {
        list<auto> recs;
    }

    private submitImpl(code enqueue, auto rec) {
        push recs, rec;
        enqueue(rec);
    }

    private bool supportsBulkApiImpl() {
        return True;
    }
}

class DummyRecordProcessor inherits AbstractDataProcessor {
    private submitImpl(code enqueue, auto rec) {
        enqueue({"x": 1});
    }

    private bool supportsBulkApiImpl() {
        return True;
    }
}

class TestBulkRecordIterator inherits AbstractDataProviderRecordIterator {
    bool valid() {
        return False;
    }

    hash<auto> getValue() {
        throw "INVALID-ITERATOR", "error";
    }

    bool supportsBulkApi() {
        return True;
    }

    *AbstractDataProviderBulkRecordInterface getBulkApi() {
        return new TestBulkRecordProvider();
    }

    private bool nextImpl() {
        return False;
    }
}

class TestBulkRecordProvider inherits AbstractDataProviderBulkRecordInterface {
    private {
        bool ok = True;
    }

    constructor() : AbstractDataProviderBulkRecordInterface(2) {
    }

    hash<string, auto> getValueImpl() {
        if (ok) {
            ok = False;
            return {
                "a": (1, 2),
                "b": ("one", "two"),
            };
        }
        return {};
    }
}

class TestIntProcessor inherits AbstractDataProcessor {
    private {
        int inc;
        int sum = 0;
        *bool skip_odd;
    }

    constructor(int inc, *bool skip_odd) {
        self.inc = inc;
        self.skip_odd = skip_odd;
    }

    int getSum() {
        return sum;
    }

    reset() {
        sum = 0;
    }

    private submitImpl(code enqueue, auto rec) {
        if (skip_odd && rec > inc && (rec % 2)) {
            return;
        }
        rec += inc;
        sum += rec;
        enqueue(rec);
    }

    private bool supportsBulkApiImpl() {
        return False;
    }
}

class StringTestType inherits Type {
    #! Creates the object
    constructor() : Type("softstring") {
    }

    #! Returns the type name
    string getName() {
        return "teststring";
    }
}

public class DataProviderTest inherits QUnit::Test {
    constructor() : Test("DataProvider Test", "1.0") {
        DataProviderTypeEntry::setEpheremalIdStart(-1);

        addTestCase("expression tests", \expressionTests());
        addTestCase("get display name", \getDisplayNameTest());
        addTestCase("app/action catalog tests", \actionCatalogTests());
        addTestCase("string test", \stringTest());
        addTestCase("data test", \dataTest());
        addTestCase("compat test", \compatTest());
        addTestCase("pipeline test", \pipelineTest());
        addTestCase("pipeline metrics test", \pipelineMetricsTest());
        addTestCase("type cache test", \typeCacheTest());
        addTestCase("test", \dataProviderTest());

        # Return for compatibility with test harnesses that check the return value.
        set_return_value(main());
    }

    private checkYaml() {
%ifdef NoYaml
        testSkip("no yaml module");
%endif
    }

    expressionTests() {
        checkYaml();
        hash<DataProviderExpression> exp = <DataProviderExpression>{
            "exp": DP_OP_AND,
            "args": (
                <DataProviderExpression>{
                    "exp": DP_SEARCH_OP_EQ,
                    "args": (
                        <DataProviderFieldReference>{"field": "status"},
                        "active",
                    ),
                },
                <DataProviderExpression>{
                    "exp": DP_SEARCH_OP_REGEX,
                    "args": (
                        <DataProviderFieldReference>{"field": "email"},
                        "@example\\.com$",
                    ),
                },
                <DataProviderExpression>{
                    "exp": DP_OP_OR,
                    "args": (
                        <DataProviderExpression>{
                            "exp": DP_SEARCH_OP_BETWEEN,
                            "args": (
                                <DataProviderFieldReference>{"field": "age"},
                                18,
                                30,
                            ),
                        },
                        <DataProviderExpression>{
                            "exp": DP_SEARCH_OP_IN,
                            "args": (
                                <DataProviderFieldReference>{"field": "role"},
                                ("admin", "editor", "moderator"),
                            ),
                        },
                        <DataProviderExpression>{
                            "exp": "calculate",
                            "args": (
                                <DataProviderFieldReference>{"field": "score"},
                                1000,
                                2000,
                            ),
                        },
                    ),
                },
            ),
        };
        hash<DataProviderExpressionInfo> fexp = <DataProviderExpressionInfo>{
            "type": DET_Function,
            "name": "calculate",
            "display_name": "calculate()",
            "short_desc": "Calculates a value",
            "desc": "Calculates a value",
            "args": (DataProviderSignatureIntType),
            "varargs": True,
            "return_type": AbstractDataProviderTypeMap."int",
        };

        string str = DataProvider::renderExpression(exp, DataProviderGenericExpressions + {
            "calculate": fexp,
        });
        assertEq("({status} == \"active\") && ({email} =~ /\"@example\\\\.com$\"/) && (({age} between 18 and 30) || "
            "({role} in ([\"admin\", \"editor\", \"moderator\"])) || calculate({score}, 1000, 2000))", str);

        hash<DataProviderExpressionInfo> opexp = <DataProviderExpressionInfo>{
            "type": DET_Operator,
            "name": "startsWith",
            "display_name": "String Starts With",
            "short_desc": "Returns `True` if the given value starts with the given characters when converted to a "
                "string",
            "desc": "Returns `True` if the given value starts with the given characters when converted to a string",
            "symbol": "startsWith",
            "render_template": "$arg[0].startsWith($arg[1], $arg[2])",
            "groups": "Comparison",
            "args": (DataProviderSignatureStringType, DataProviderSignatureStringType, DataProviderSignatureBoolType),
            "arg_info": (
                <DataProviderArgInfo>{
                },
                <DataProviderArgInfo>{
                },
                <DataProviderArgInfo>{
                    "default_value": False,
                },
            ),
            "return_type": AbstractDataProviderTypeMap."bool",
        },
        exp = <DataProviderExpression>{
            "exp": "startsWith",
            "args": (
                <DataProviderFieldReference>{"field": "username"},
                "admin",
                True,
            ),
        };
        str = DataProvider::renderExpression(exp, DataProviderGenericExpressions + {
            "startsWith": opexp,
        });
        assertEq("{username}.startsWith(\"admin\", true)", str);
        exp = <DataProviderExpression>{
            "exp": "startsWith",
            "args": (
                <DataProviderFieldReference>{"field": "username"},
                "admin",
            ),
        };
        str = DataProvider::renderExpression(exp, DataProviderGenericExpressions + {
            "startsWith": opexp,
        });
        assertEq("{username}.startsWith(\"admin\", false)", str);

        opexp = <DataProviderExpressionInfo>{
            "type": DET_Operator,
            "name": "in-list",
            "display_name": "In List",
            "short_desc": "Returns True if the first argument is found in the second argument",
            "desc": "Returns `True` if the first argument is found in the second argument; the optional third "
                "argument provides the location of the value to compare if list elements are complex objects "
                "themselves",
            "symbol": "in",
            "render_template": "$arg[0] in ($arg[1])${arg[2] ? [IGNORE-CASE]:}",
            "groups": "Comparison",
            "args": (DataProviderSignatureAnyType, DataProviderSignatureListType, DataProviderSignatureBoolType),
            "return_type": AbstractDataProviderTypeMap."bool",
        };
        exp = <DataProviderExpression>{
            "exp": "in-list",
            "args": (
                <DataProviderFieldReference>{"field": "category"},
                ("A", "B", "C"),
                True,
            ),
        };
        str = DataProvider::renderExpression(exp, DataProviderGenericExpressions + {
            "in-list": opexp,
        });
        assertEq("{category} in ([\"A\", \"B\", \"C\"]) [IGNORE-CASE]", str);
        exp = <DataProviderExpression>{
            "exp": "in-list",
            "args": (
                <DataProviderFieldReference>{"field": "category"},
                ("A", "B", "C"),
            ),
        };
        str = DataProvider::renderExpression(exp, DataProviderGenericExpressions + {
            "in-list": opexp,
        });
        assertEq("{category} in ([\"A\", \"B\", \"C\"])", str);

        opexp = <DataProviderExpressionInfo>{
            "type": DET_Operator,
            "name": "in-list",
            "display_name": "In List",
            "short_desc": "Returns True if the first argument is found in the second argument",
            "desc": "Returns `True` if the first argument is found in the second argument; the optional third "
                "argument provides the location of the value to compare if list elements are complex objects "
                "themselves",
            "symbol": "in",
            "render_template": "$arg[0] in ($arg[1])${arg[2] ? [loc $arg[2]]:}",
            "groups": "Comparison",
            "args": (DataProviderSignatureAnyType, DataProviderSignatureListType,
                DataProviderSignatureOptionalStringType),
            "return_type": AbstractDataProviderTypeMap."bool",
        };
        exp = <DataProviderExpression>{
            "exp": "in-list",
            "args": (
                <DataProviderFieldReference>{"field": "account"},
                ("A", "B", "C"),
                "extra.info",
            ),
        };
        str = DataProvider::renderExpression(exp, DataProviderGenericExpressions + {
            "in-list": opexp,
        });
        assertEq("{account} in ([\"A\", \"B\", \"C\"]) [loc \"extra.info\"]", str);

    }

    getDisplayNameTest() {
        assertEq("Get URL", AbstractDataField::getDisplayName("getURL"));
        assertEq("Get URL", AbstractDataField::getDisplayName("GetURL"));
        assertEq("Get User URL", AbstractDataField::getDisplayName("getUserURL"));
        assertEq("Get User URL", AbstractDataField::getDisplayName("GetUserURL"));
        assertEq("Client URLs", AbstractDataField::getDisplayName("clientURLs"));
        assertEq("Client URLs", AbstractDataField::getDisplayName("ClientURLs"));
        assertEq("User Id", AbstractDataField::getDisplayName("userId"));
        assertEq("User Id", AbstractDataField::getDisplayName("UserId"));
        assertEq("User ID", AbstractDataField::getDisplayName("userID"));
        assertEq("User ID", AbstractDataField::getDisplayName("UserID"));
        assertEq("Create TPS Reports", AbstractDataField::getDisplayName("createTPSReports"));
        assertEq("Create TPS Reports", AbstractDataField::getDisplayName("CreateTPSReports"));
        assertEq("FBI Code", AbstractDataField::getDisplayName("FBICode"));
    }

    actionCatalogTests() {
        # negative tests registering apps
        assertThrows("APP-ERROR", \DataProviderActionCatalog::registerApp(), <DataProviderAppInfo>{});
        assertThrows("APP-ERROR", \DataProviderActionCatalog::registerApp(), <DataProviderAppInfo>{
            "name": "",
            "short_desc": "",
            "desc": "",
            "logo": "",
            "logo_file_name": "",
            "logo_mime_type": "",
        });

        # missing description
        assertThrows("APP-ERROR", \DataProviderActionCatalog::registerApp(), <DataProviderAppInfo>{
            "name": "test",
            "display_name": "test",
            "short_desc": "test",
            "scheme": "test",
            "logo": "data",
            "logo_mime_type": MimeTypeSvg,
            "logo_file_name": "test.svg",
        });

        # missing logo
        assertThrows("APP-ERROR", \DataProviderActionCatalog::registerApp(), <DataProviderAppInfo>{
            "name": "test",
            "display_name": "test",
            "short_desc": "test",
            "desc": "desc",
            "scheme": "test",
            "logo_mime_type": MimeTypeSvg,
            "logo_file_name": "test.svg",
        });

        # missing logo mime type
        assertThrows("APP-ERROR", \DataProviderActionCatalog::registerApp(), <DataProviderAppInfo>{
            "name": "test",
            "display_name": "test",
            "short_desc": "test",
            "desc": "desc",
            "scheme": "test",
            "logo": "data",
            "logo_file_name": "test.svg",
        });

        # missing logo file name
        assertThrows("APP-ERROR", \DataProviderActionCatalog::registerApp(), <DataProviderAppInfo>{
            "name": "test",
            "display_name": "test",
            "short_desc": "test",
            "desc": "desc",
            "scheme": "test",
            "logo": "data",
            "logo_mime_type": MimeTypeJpeg,
        });

        # missing display name
        assertThrows("APP-ERROR", \DataProviderActionCatalog::registerApp(), <DataProviderAppInfo>{
            "name": "test",
            "short_desc": "test",
            "desc": "desc",
            "scheme": "test",
            "logo": "data",
            "logo_mime_type": MimeTypeJpeg,
            "logo_file_name": "test.svg",
        });

        # missing short desc
        assertThrows("APP-ERROR", \DataProviderActionCatalog::registerApp(), <DataProviderAppInfo>{
            "name": "test",
            "display_name": "test",
            "desc": "desc",
            "scheme": "test",
            "logo": "data",
            "logo_mime_type": MimeTypeJpeg,
            "logo_file_name": "test.svg",
        });

        string app = get_random_string();
        string appdesc = get_random_string();
        string scheme = get_random_string();
        hash<DataProviderAppInfo> my_app = <DataProviderAppInfo>{
            "name": app,
            "display_name": "test",
            "short_desc": "test",
            "desc": appdesc,
            "scheme": scheme,
            "logo": "data",
            "logo_mime_type": MimeTypeSvg,
            "logo_file_name": "test.svg",
            "dynamic": True,
        };
        DataProviderActionCatalog::registerApp(my_app);
        assertEq(my_app, DataProviderActionCatalog::getApp(app));

        {
            Program p(PO_NO_PROCESS_CONTROL);
            p.parse("sub test(string name) { DataProviderActionCatalog::deregisterDynamicApp(name); }", "test");
            assertThrows("PERMISSION-DENIED", \p.callFunction(), ("test", app));
        }

        assertThrows("APP-ERROR", \DataProviderActionCatalog::getAppEx(), get_random_string());

        # negative tests registering actions
        assertThrows("ACTION-ERROR", \DataProviderActionCatalog::registerAction(), <DataProviderActionInfo>{});
        assertThrows("ACTION-ERROR", \DataProviderActionCatalog::registerAction(), <DataProviderActionInfo>{
            "app": "",
            "action": "",
            "path": "",
            "display_name": "",
            "short_desc": "",
            "desc": "",
        });

        assertEq(my_app, DataProviderActionCatalog::getAllApps()[0]);

        string act = get_random_string();

        string short_desc = get_random_string(40);
        string desc = get_random_string(100);

        # invalid app
        assertThrows("ACTION-ERROR", \DataProviderActionCatalog::registerAction(), <DataProviderActionInfo>{
            "app": get_random_string(),
            "action": act,
            "path": "/",
            "display_name": "test",
            "short_desc": short_desc,
            "desc": desc,
            "action_code": DPAT_API,
        });

        # missing path var definitions
        assertThrows("ACTION-ERROR", \DataProviderActionCatalog::registerAction(), <DataProviderActionInfo>{
            "app": app,
            "action": act,
            "path": "/{key}",
            "display_name": "test",
            "short_desc": short_desc,
            "desc": desc,
            "action_code": DPAT_API,
        });

        # extra path var definitions
        assertThrows("ACTION-ERROR", \DataProviderActionCatalog::registerAction(), <DataProviderActionInfo>{
            "app": app,
            "action": act,
            "path": "/",
            "display_name": "test",
            "short_desc": short_desc,
            "desc": desc,
            "path_vars": {
                "test": <DataProviderPathVarInfo>{
                    "display_name": "test",
                    "short_desc": "test",
                    "desc": "test",
                },
            },
            "action_code": DPAT_API,
        });

        # invalid action code
        assertThrows("ACTION-ERROR", \DataProviderActionCatalog::registerAction(), <DataProviderActionInfo>{
            "app": app,
            "action": act,
            "path": "/",
            "display_name": "test",
            "short_desc": short_desc,
            "desc": desc,
            "action_code": -1,
        });

        # missing display name
        assertThrows("ACTION-ERROR", \DataProviderActionCatalog::registerAction(), <DataProviderActionInfo>{
            "app": app,
            "action": act,
            "path": "/",
            "short_desc": short_desc,
            "desc": desc,
            "action_code": DPAT_API,
        });

        {
            Program p();
            assertThrows("PARSE-EXCEPTION", \p.parse(), (
                "%modern\n"
                "%disable-warning unreferenced-variable\n"
                "%requires DataProvider\n"
                "sub test() {\n"
                "    hash<DataProviderActionInfo> bad = <DataProviderActionInfo>{\n"
                "        \"app\": \"" + app + "\",\n"
                "        \"action\": \"" + act + "\",\n"
                "        \"path\": \"/\",\n"
                "        \"display_name\": \"test\",\n"
                "        \"short_desc\": \"" + short_desc + "\",\n"
                "        \"desc\": \"" + desc + "\",\n"
                "        \"action_code\": 1,\n"
                "        \"requires_action_context\": 1,\n"
                "    };\n"
                "}\n",
                "test"));
        }

        hash<DataProviderActionInfo> action = <DataProviderActionInfo>{
            "app": app,
            "action": act,
            "path": "/",
            "display_name": "test",
            "short_desc": short_desc,
            "desc": desc,
            "action_code": DPAT_API,
            "input_data_types": {
                DPAD_NORMAL: True,
            },
            "output_data_type": DPAD_NORMAL,
            "requires_action_context": "pipeline",
            "action_context": "pipeline",
        };
        DataProviderActionCatalog::registerAction(action);
        my_app.supports_apis = True;

        assertThrows("APP-ERROR", \DataProviderActionCatalog::getActionsEx(), get_random_string());

        assertEq(action, DataProviderActionCatalog::getAllActions()[0]);
        assertEq("pipeline", DataProviderActionCatalog::getAllActions()[0].requires_action_context);
        assertEq("pipeline", DataProviderActionCatalog::getAllActions()[0].action_context);

        list<hash<DataProviderAppInfo>> apps = DataProviderActionCatalog::searchAppRegex(app);
        assertEq(1, apps.size());
        assertEq(my_app, apps[0]);

        apps = DataProviderActionCatalog::searchAppSubstr(app, True);
        assertEq(1, apps.size());
        assertEq(my_app, apps[0]);

        apps = DataProviderActionCatalog::searchAppSubstr(app, False);
        assertEq(1, apps.size());
        assertEq(my_app, apps[0]);

        apps = DataProviderActionCatalog::searchAppRegex(appdesc[5..10]);
        assertEq(1, apps.size());
        assertEq(my_app, apps[0]);

        apps = DataProviderActionCatalog::searchAppSubstr(appdesc[5..10], True);
        assertEq(1, apps.size());
        assertEq(my_app, apps[0]);

        apps = DataProviderActionCatalog::searchAppSubstr(appdesc[5..10], False);
        assertEq(1, apps.size());
        assertEq(my_app, apps[0]);

        apps = DataProviderActionCatalog::searchAppRegex(get_random_string());
        assertEq((), apps);

        apps = DataProviderActionCatalog::searchAppSubstr(get_random_string(), True);
        assertEq((), apps);

        apps = DataProviderActionCatalog::searchAppSubstr(get_random_string(), False);
        assertEq((), apps);

        list<hash<DataProviderActionInfo>> actions = DataProviderActionCatalog::getActions(app);
        assertEq(1, actions.size());
        assertEq(action, actions[0]);

        assertEq((), DataProviderActionCatalog::searchAppActionRegex(get_random_string(), short_desc));
        assertEq((), DataProviderActionCatalog::searchAppActionSubstr(get_random_string(), short_desc));

        assertThrows("APP-ERROR", \DataProviderActionCatalog::searchAppActionRegexEx(), (get_random_string(),
            short_desc));
        assertThrows("APP-ERROR", \DataProviderActionCatalog::searchAppActionSubstrEx(), (get_random_string(),
            short_desc));

        assertEq((), DataProviderActionCatalog::searchActionRegex(get_random_string()));
        assertEq((), DataProviderActionCatalog::searchActionSubstr(get_random_string(), True));
        assertEq((), DataProviderActionCatalog::searchActionSubstr(get_random_string(), False));
        assertNothing(DataProviderActionCatalog::getActionsForScheme(get_random_string()));

        actions = DataProviderActionCatalog::searchAppActionRegex(app, short_desc);
        assertEq(1, actions.size());
        assertEq(action, actions[0]);

        actions = DataProviderActionCatalog::searchAppActionSubstr(app, short_desc);
        assertEq(1, actions.size());
        assertEq(action, actions[0]);

        actions = DataProviderActionCatalog::searchActionRegex(short_desc);
        assertEq(1, actions.size());
        assertEq(action, actions[0]);

        actions = DataProviderActionCatalog::searchActionRegex(desc);
        assertEq(1, actions.size());
        assertEq(action, actions[0]);

        actions = DataProviderActionCatalog::searchActionSubstr(short_desc, False);
        assertEq(1, actions.size());
        assertEq(action, actions[0]);

        actions = DataProviderActionCatalog::searchActionSubstr(desc, False);
        assertEq(1, actions.size());
        assertEq(action, actions[0]);

        actions = DataProviderActionCatalog::searchActionSubstr(short_desc, True);
        assertEq(1, actions.size());
        assertEq(action, actions[0]);

        actions = DataProviderActionCatalog::searchActionSubstr(desc, True);
        assertEq(1, actions.size());
        assertEq(action, actions[0]);

        actions = DataProviderActionCatalog::getActionsForScheme(scheme);
        assertEq(1, actions.size());
        assertEq(action, actions[0]);

        assertTrue(exists DataProviderActionCatalog::deregisterDynamicApp(app));
        assertNothing(DataProviderActionCatalog::getApp(app));
    }

    stringTest() {
        AbstractDataProviderType t = AbstractDataProviderType::get(new StringTestType());
        assertEq("1", t.acceptsValue(1));
    }

    dataTest() {
        AbstractDataProviderType t = AbstractDataProviderType::get(DataType);
        binary val = get_random_bytes(20);
        assertEq(val, t.acceptsValue(val));
        t = AbstractDataProviderType::get(DataOrNothingType);
        assertEq(val, t.acceptsValue(val));
    }

    compatTest() {
        QoreStringDataType str();
        HashDataType t1("t1");
        t1.setDefaultOtherFieldType();
        t1.addField(new QoreDataField("a", "desc", str));
        HashDataType t2("t2");
        t2.setDefaultOtherFieldType();
        t2.addField(new QoreDataField("b", "desc", str));
        HashDataType t3("t3");
        HashDeclDataType t4(TypedHash::forName("StatInfo"));
        HashDataType t5("t5");
        t5.addField(new QoreDataField("a", "desc", str));
        t5.addField(new QoreDataField("b", "desc", str));
        HashDataType t6("t6");
        t6.addField(new QoreDataField("a", "desc", str));
        HashDataType t7("t7");
        t7.addField(new QoreDataField("b", "desc", str));
        HashDataType t8("t8");
        t8.addField(new QoreDataField("type", "desc", str));

        assertEq(NT_STRING, t1.getField("a").getType().getBaseTypeCode());

        assertEq({"a": "Example a"}, t1.getExampleValue());

        assertFalse(t1.isAssignableFrom(t2));
        assertTrue(t3.isAssignableFrom(t1));
        assertTrue(t3.isAssignableFrom(t2));
        assertTrue(t3.isAssignableFrom(t4));
        assertTrue(t1.isAssignableFrom(t3));
        assertTrue(t2.isAssignableFrom(t3));
        assertFalse(t1.isAssignableFrom(t5));
        assertFalse(t2.isAssignableFrom(t5));

        assertFalse(t1.isAssignableFrom(str));
        assertFalse(t2.isAssignableFrom(str));
        assertFalse(t3.isAssignableFrom(str));

        assertFalse(t6.isAssignableFrom(t2));
        assertTrue(t3.isAssignableFrom(t6));
        assertTrue(t3.isAssignableFrom(t7));
        assertTrue(t6.isAssignableFrom(t3));
        assertTrue(t7.isAssignableFrom(t3));
        assertFalse(t6.isAssignableFrom(t5));
        assertFalse(t7.isAssignableFrom(t5));

        assertFalse(t6.isAssignableFrom(str));
        assertFalse(t7.isAssignableFrom(str));
        assertFalse(t3.isAssignableFrom(str));

        assertFalse(t4.isAssignableFrom(t1));
        assertFalse(t4.isAssignableFrom(t8));
        assertFalse(t8.isAssignableFrom(t4));

        {
            hash<auto> v = {"type": "str"};
            assertEq(v, t8.acceptsValue(v));
            assertEq(v, t4.acceptsValue(v));
        }

        hash<auto> h1;
        h1 += {
            "a": "string",
        };
        hash<auto> h2;
        h2 += {
            "b": "string",
        };
        assertThrows("MISSING-VALUE-ERROR", \t1.acceptsValue(), h2);
        assertThrows("MISSING-VALUE-ERROR", \t2.acceptsValue(), h1);
        assertThrows("RUNTIME-TYPE-ERROR", \t1.acceptsValue(), 1);
        assertThrows("RUNTIME-TYPE-ERROR", \t2.acceptsValue(), 1);
        assertThrows("RUNTIME-TYPE-ERROR", \t3.acceptsValue(), 1);
        assertEq(h1, t1.acceptsValue(h1));
        assertEq(h2, t2.acceptsValue(h2));
        assertEq(h1, t3.acceptsValue(h1));
        assertEq(h2, t3.acceptsValue(h2));
        assertEq(<StatInfo>{"size": 1}, t3.acceptsValue(<StatInfo>{"size": 1}));
        assertThrows("RUNTIME-TYPE-ERROR", \t1.acceptsValue(), h2 + {"a": "string"});
        assertThrows("RUNTIME-TYPE-ERROR", \t2.acceptsValue(), h1 + {"b": "string"});
        assertThrows("RUNTIME-TYPE-ERROR", \t1.acceptsValue(), {"a": 1});
        assertThrows("RUNTIME-TYPE-ERROR", \t2.acceptsValue(), {"b": 2});
        t1.setDefaultOtherFieldType(new QoreIntDataType());
        t2.setDefaultOtherFieldType(new QoreIntDataType());
        h1 += {"b": 2};
        h2 += {"a": 2};
        assertEq(h1, t1.acceptsValue(h1));
        assertEq(h2, t2.acceptsValue(h2));
    }

    pipelineTest() {
        {
            TestRecordProvider record_provider();
            DataProviderPipeline pipe();
            assertThrows("PIPELINE-ERROR", \pipe.submit(), {});

            TestRecordProcessor record_processor0("A");
            assertEq(AbstractDataProviderType::anyDataType, record_processor0.getExpectedType());
            assertEq(AbstractDataProviderType::anyDataType, record_processor0.getReturnType());
            pipe.append(record_processor0);
            pipe.submit(record_provider);
            pipe.waitDone();
            assertEq({"A-a": 1, "A-b": 2}, record_processor0.recs[0]);

            hash<PipelineInfo> info = pipe.getInfo();
            assertEq(1, info.record_count);
            assertTrue(info.bulk);

            TestRecordProcessor record_processor1("B");
            pipe.append(record_processor1);
            pipe.submit(record_provider);
            pipe.waitDone();
            assertEq({"B-A-a": 1, "B-A-b": 2}, record_processor1.recs[0]);

            info = pipe.getInfo();
            assertEq(2, info.record_count);
            assertTrue(info.bulk);

            DataProviderPipeline pipe1 = pipe.copy();
            record_processor0.clear();
            record_processor1.clear();

            pipe1.submit(record_provider);
            pipe1.waitDone();
            assertEq({"A-a": 1, "A-b": 2}, record_processor0.recs[0]);
            assertEq({"B-A-a": 1, "B-A-b": 2}, record_processor1.recs[0]);

            info = pipe1.getInfo();
            assertEq(1, info.record_count);
            assertTrue(info.bulk);

