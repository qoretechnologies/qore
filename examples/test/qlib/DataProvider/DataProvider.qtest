class TestRecordProvider inherits AbstractDataProviderRecordIterator {
    private {
        bool ok = False;
    }

    bool valid() {
        return ok;
    }

    hash<auto> getValue() {
        if (!ok) {
            throw "INVALID-ITERATOR", "error";
        }

        return {
            "a": 1,
            "b": 2,
        };
    }

    private bool nextImpl() {
        return ok = !ok;
    }
}

class InfiniteRecordProvider inherits AbstractDataProviderRecordIterator {
    bool valid() {
        return True;
    }

    hash<auto> getValue() {
        return {"a": 1, "b": 2};
    }

    private bool nextImpl() {
        return True;
    }
}

class TestRecordProcessor inherits AbstractDataProcessor {
    public {
        string pfx;
        list<hash<auto>> recs;
        list<hash<auto>> raw_recs;
        *hash<auto> crec;
        *bool raise_error;
    }

    constructor(string pfx, *hash<auto> crec, *bool raise_error) {
        self.pfx = pfx;
        self.crec = crec;
        self.raise_error = raise_error;
    }

    clear() {
        remove recs;
    }

    setRaiseError() {
        raise_error = True;
    }

    private submitImpl(code enqueue, auto rec) {
        if (raise_error) {
            remove raise_error;
            throw "ERROR", "error";
        }
        hash<auto> new_rec = (map {pfx + "-" + $1.key: $1.value}, rec.pairIterator()) + crec;
        raw_recs += new_rec;
        recs += map $1, new_rec.contextIterator();
        enqueue(new_rec);
    }

    private bool supportsBulkApiImpl() {
        return True;
    }
}

class TestFlushRecordProcessor inherits TestRecordProcessor {
    private {
        *hash<auto> new_rec;
    }

    constructor(string pfx, *hash<auto> crec, *bool raise_error, *hash<auto> new_rec)
        : TestRecordProcessor(pfx, crec, raise_error) {
        self.new_rec = new_rec;
    }

    private flushImpl(code enqueue) {
        if (new_rec) {
            enqueue(new_rec);
        }
    }
}

class DuplicateRecordProcessor inherits AbstractDataProcessor {
    public {
        string pfx1;
        string pfx2;
    }

    constructor(string pfx1, string pfx2) {
        self.pfx1 = pfx1;
        self.pfx2 = pfx2;
    }

    private submitImpl(code enqueue, auto rec) {
        hash<auto> rec1 = (map {pfx1 + "-" + $1.key: $1.value}, rec.pairIterator());
        enqueue(rec1);
        hash<auto> rec2 = (map {pfx2 + "-" + $1.key: $1.value}, rec.pairIterator());
        enqueue(rec2);
    }

    private bool supportsBulkApiImpl() {
        return True;
    }
}

class RecordProcessorSink inherits AbstractDataProcessor {
    public {
        list<auto> recs;
    }

    private submitImpl(code enqueue, auto rec) {
        push recs, rec;
        enqueue(rec);
    }

    private bool supportsBulkApiImpl() {
        return True;
    }
}

class TestMetricsCollector inherits AbstractPipelineMetricsCollector {
    public {
        list<hash<PipelineMetricsSnapshot>> collected_metrics;
        Mutex m();
        int interval_ms;
        int record_interval;
        *hash<auto> user_context;
        bool shutdown_called = False;
    }

    constructor(int interval_ms = 10, int record_interval = 5, *hash<auto> user_context) {
        self.interval_ms = interval_ms;
        self.record_interval = record_interval;
        self.user_context = user_context;
    }

    int getIntervalMs() {
        return interval_ms;
    }

    int getRecordInterval() {
        return record_interval;
    }

    reportMetrics(hash<PipelineMetricsSnapshot> snapshot) {
        if (user_context) {
            snapshot.user_context = user_context;
        }
        m.lock();
        on_exit m.unlock();
        collected_metrics += snapshot;
    }

    shutdown() {
        shutdown_called = True;
    }
}

#! Metrics collector that throws from reportMetrics()
class ThrowingMetricsCollector inherits AbstractPipelineMetricsCollector {
    public {
        int interval_ms;
        int record_interval;
        bool shutdown_called = False;
        int report_count = 0;
    }

    constructor(int interval_ms = 10, int record_interval = 5) {
        self.interval_ms = interval_ms;
        self.record_interval = record_interval;
    }

    int getIntervalMs() {
        return interval_ms;
    }

    int getRecordInterval() {
        return record_interval;
    }

    reportMetrics(hash<PipelineMetricsSnapshot> snapshot) {
        ++report_count;
        throw "METRICS-ERROR", "test error from reportMetrics";
    }

    shutdown() {
        shutdown_called = True;
    }
}

#! Metrics collector that throws from shutdown()
class ThrowingShutdownCollector inherits AbstractPipelineMetricsCollector {
    public {
        list<hash<PipelineMetricsSnapshot>> collected_metrics;
        Mutex m();
        bool shutdown_called = False;
    }

    int getIntervalMs() {
        return 1000;
    }

    int getRecordInterval() {
        return 1000;
    }

    reportMetrics(hash<PipelineMetricsSnapshot> snapshot) {
        m.lock();
        on_exit m.unlock();
        collected_metrics += snapshot;
    }

    shutdown() {
        shutdown_called = True;
        throw "SHUTDOWN-ERROR", "test error from shutdown";
    }
}

#! Metrics collector that throws from getIntervalMs()/getRecordInterval()
class ThrowingThresholdCollector inherits AbstractPipelineMetricsCollector {
    public {
        list<hash<PipelineMetricsSnapshot>> collected_metrics;
        Mutex m();
        bool shutdown_called = False;
    }

    int getIntervalMs() {
        throw "THRESHOLD-ERROR", "test error from getIntervalMs";
    }

    int getRecordInterval() {
        throw "THRESHOLD-ERROR", "test error from getRecordInterval";
    }

    reportMetrics(hash<PipelineMetricsSnapshot> snapshot) {
        m.lock();
        on_exit m.unlock();
        collected_metrics += snapshot;
    }

    shutdown() {
        shutdown_called = True;
    }
}

