#! A provider whose operations fail with a protocol error carrying machine-readable detail
class StructuredFailureTestProvider inherits AbstractDataProvider {
    public {
        #! a protocol status code that a caller must be able to recover from the generic API error
        const StatusCode = 2151415808;

        const MessageId = "write-value";

        const ErrorCode = "PROTOCOL-WRITE-ERROR";
    }

    string getName() {
        return "StructuredFailureTestProvider";
    }

    private hash<DataProviderInfo> getStaticInfoImpl() {
        return <DataProviderInfo>{
            "name": "structured-failure-test",
            "desc": "test provider failing with structured protocol errors",
            "type": "structured-failure-test",
            "supports_messages": MSG_Async,
            "supports_create": True,
        };
    }

    private hash<string, hash<DataProviderMessageInfo>> getMessageTypesImpl() {
        return {
            MessageId: <DataProviderMessageInfo>{
                "desc": "test message",
                "type": AbstractDataProviderTypeMap."any",
            },
        };
    }

    private sendMessageImpl(string message_id, auto msg, *hash<auto> send_message_options) {
        throw ErrorCode, sprintf("failed to write value to node %y: status code %d", msg.node_id, StatusCode),
            {"status_code": StatusCode, "node_id": msg.node_id};
    }

    private *hash<auto> createRecordImpl(hash<auto> rec, *hash<auto> create_options) {
        throw ErrorCode, sprintf("record rejected: status code %d", StatusCode), {"status_code": StatusCode};
    }
}

class BulkShapeTestProvider inherits AbstractDataProvider {
    public {
        *DataProviderShape last_shape;
        *auto last_recs;
        int shape_create_calls = 0;
        int bulk_create_calls = 0;
        int shape_upsert_calls = 0;
        int bulk_upsert_calls = 0;
    }

    private {
        *list<DataProviderShape> create_shapes;
        *list<DataProviderShape> upsert_shapes;
    }

    constructor(*list<DataProviderShape> create_shapes, *list<DataProviderShape> upsert_shapes) {
        self.create_shapes = create_shapes;
        self.upsert_shapes = upsert_shapes;
    }

    string getName() {
        return "BulkShapeTestProvider";
    }

    private hash<DataProviderInfo> getStaticInfoImpl() {
        hash<DataProviderInfo> info = <DataProviderInfo>{
            "name": "bulk-shape-test",
            "desc": "bulk shape test provider",
            "type": "bulk-shape-test",
            "supports_create": True,
            "supports_bulk_create": True,
            "supports_upsert": True,
            "supports_bulk_upsert": True,
        };
        if (create_shapes) {
            info.bulk_create_shapes = create_shapes;
        }
        if (upsert_shapes) {
            info.bulk_upsert_shapes = upsert_shapes;
        }
        return info;
    }

    private *hash<auto> createRecordsBulkImpl(hash<auto> recs, *hash<auto> create_options) {
        last_shape = DataProviderShape::HashOfLists;
        last_recs = recs;
        ++bulk_create_calls;
        return recs;
    }

    private *hash<auto> createRecordsShapeImpl(auto recs, DataProviderShape shape, *hash<auto> create_options) {
        last_shape = shape;
        last_recs = recs;
        ++shape_create_calls;
        return AbstractDataProcessor::bufferColumnsToHashList(recs);
    }

    private string upsertRecordImpl(hash<auto> rec, *hash<auto> upsert_options) {
        return UpsertResultInserted;
    }

    private *list<string> upsertRecordsBulkImpl(hash<auto> recs, *hash<auto> upsert_options) {
        last_shape = DataProviderShape::HashOfLists;
        last_recs = recs;
        ++bulk_upsert_calls;
        return AbstractDataProcessor::repeatValue(UpsertResultInserted,
            AbstractDataProcessor::shapeRecordCount(recs, DataProviderShape::HashOfLists));
    }

    private *list<string> upsertRecordsShapeImpl(auto recs, DataProviderShape shape, *hash<auto> upsert_options) {
        last_shape = shape;
        last_recs = recs;
        ++shape_upsert_calls;
        return AbstractDataProcessor::repeatValue(UpsertResultUpdated,
            AbstractDataProcessor::shapeRecordCount(recs, shape));
    }
}

#! A provider whose record (response) type and request type both use semantic string format types
/** Models what a converted \c *DataProvider module looks like: the record type describes data the
    provider *returns* (metadata only, never validated), while the request type describes data a
    caller *sends* (validated by acceptsValue()).
*/
class SemanticTestRecordType inherits HashDataType {
    constructor() {
        addQoreFields(SemanticTypeTestProvider::RecordFields);
    }
}

class SemanticTestRequestType inherits HashDataType {
    constructor() {
        addQoreFields(SemanticTypeTestProvider::RequestFields);
    }
}

class SemanticTypeTestProvider inherits AbstractDataProvider {
    public {
        #! response/record fields: what the remote API gives back
        const RecordFields = {
            "id": {
                "type": StringType,
                "display_name": "ID",
                "short_desc": "The record ID",
                "desc": "The opaque record ID",
            },
            "email": {
                "type": EmailOrNothingType,
                "display_name": "Email",
                "short_desc": "Contact email",
                "desc": "The contact's email address",
            },
            "website_url": {
                "type": UriOrNothingType,
                "display_name": "Website URL",
                "short_desc": "Website URL",
                "desc": "The contact's website URL",
            },
        };

        #! request fields: what a caller sends
        const RequestFields = {
            "email": {
                "type": EmailType,
                "display_name": "Email",
                "short_desc": "Contact email",
                "desc": "The contact's email address",
                "required": True,
            },
            "note": {
                "type": StringOrNothingType,
                "display_name": "Note",
                "short_desc": "Free-text note",
                "desc": "A free-text note; deliberately a plain string",
            },
        };

        #! a record carrying a value that does NOT match the email regex
        const MalformedRecord = {
            "id": "1",
            "email": "Contact Name <a@b.com>",
            "website_url": "www.example.com",
        };
    }

    string getName() {
        return "SemanticTypeTestProvider";
    }

    private hash<DataProviderInfo> getStaticInfoImpl() {
        return <DataProviderInfo>{
            "name": "semantic-type-test",
            "desc": "test provider using semantic string format types",
            "type": "semantic-type-test",
            "supports_read": True,
            "supports_request": True,
            # hasRecord() reads getStaticInfoImpl() directly, which does not get the
            # has_record = supports_read default fill applied by getInfo()
            "has_record": True,
        };
    }

    private *hash<string, AbstractDataField> getRecordTypeImpl(*hash<auto> search_options) {
        return (new SemanticTestRecordType()).getFields();
    }

    private *AbstractDataProviderType getRequestTypeImpl() {
        return new SemanticTestRequestType();
    }

    private *AbstractDataProviderType getResponseTypeImpl() {
        return new SemanticTestRecordType();
    }

    #! returns the malformed record unchanged; a provider never validates what it returns
    private AbstractDataProviderRecordIterator searchRecordsImpl(*hash<auto> where_cond,
            *hash<auto> search_options) {
        return new DefaultRecordIterator(new ListIterator((MalformedRecord,)));
    }

    private auto doRequestImpl(auto req, *hash<auto> request_options) {
        return req;
    }
}

public class DataProviderTest inherits QUnit::Test {
    constructor() : Test("DataProvider Test", "1.0") {
        # Keep this core module test independent of host-specific provider discovery configuration.
        unsetenv("QORE_DATA_PROVIDERS");
        remove ENV{"QORE_DATA_PROVIDERS"};

        DataProviderTypeEntry::setEpheremalIdStart(-1);

        addTestCase("expression tests", \expressionTests());
        addTestCase("get display name", \getDisplayNameTest());
        addTestCase("action option example determinism", \actionOptionExampleDeterminismTest());
        addTestCase("action option semantic attributes", \actionOptionSemanticAttrTest());
        addTestCase("semantic string format types", \semanticStringFormatTypesTest());
        addTestCase("semantic types through a provider", \semanticTypesThroughProviderTest());
        addTestCase("app/action catalog tests", \actionCatalogTests());
        addTestCase("action deregister cleanup", \actionDeregisterCleanupTest());
        addTestCase("pending app module context", \pendingAppModuleContextTest());
        addTestCase("string test", \stringTest());
        addTestCase("data test", \dataTest());
        addTestCase("compat test", \compatTest());
        addTestCase("filtered hash map type hint test", \filteredHashMapTypeHintTest());
        addTestCase("optional typed hash field test", \optionalTypedHashFieldTest());
        addTestCase("generic record iterator test", \genericRecordIteratorTest());
        addTestCase("record iterator limit and offset", \recordIteratorLimitTest());
        addTestCase("processor shape API test", \processorShapeApiTest());
        addTestCase("bulk provider shape API test", \bulkProviderShapeApiTest());
        addTestCase("wrapped exception cause test", \wrappedExceptionCauseTest());
        addTestCase("pipeline test", \pipelineTest());
        addTestCase("pipeline metrics test", \pipelineMetricsTest());
        addTestCase("pipeline output callback test", \pipelineOutputCallbackTest());
        addTestCase("return-based processor API test", \returnBasedApiTest());
        addTestCase("type cache test", \typeCacheTest());
        addTestCase("static factory map test", \factoryMapTest());
        addTestCase("union optional type test", \unionOptionalTypeTest());
        addTestCase("optional field attribute test", \optionalFieldAttributeTest());
        addTestCase("soft list of union type test", \softListUnionTest());
        addTestCase("webhook signature test", \webhookSignatureTest());
        addTestCase("short description derivation", \shortDescriptionTest());
        addTestCase("test", \dataProviderTest());

        # Return for compatibility with test harnesses that check the return value.
        set_return_value(main());
    }

    genericRecordIteratorTest() {
        DefaultRecordIterator<hash<TypedRecordIteratorRow>> i(new TypedRecordIterator());

        assertTrue(i instanceof AbstractDataProviderRecordIterator<hash<TypedRecordIteratorRow>>);
        assertTrue(i instanceof AbstractIterator<hash<TypedRecordIteratorRow>>);
        assertTrue(i.next());

        hash<TypedRecordIteratorRow> row = i.getValue();
        assertEq("hash<TypedRecordIteratorRow>", row.fullType());
        assertEq(1, row.id);
        assertEq("alpha", row.name);
        assertFalse(i.next());

        hash<DataProviderExpression> where_cond = <DataProviderExpression>{
            "exp": DP_SEARCH_OP_EQ,
            "args": (
                <DataProviderFieldReference>{"field": "id"},
                1,
            ),
        };
        DefaultRecordIterator<hash<TypedRecordIteratorRow>> filtered(new TypedRecordIterator(), where_cond);
        assertTrue(filtered.next());
        assertEq(1, filtered.getValue().id);
        assertFalse(filtered.next());
    }

    #! A limit is honored without reading records that can never be returned
    /** The wrapped iterator is counted, because a record iterator over a service reads a record at a time
        and each one can cost a request: a search that stops at the right record but reads past it first is
        still wrong for the caller paying for those reads.

        A \c limit of zero is the case that was wrong: with an offset, the limit was tested as
        <tt>(count - offset) == limit</tt>, which is negative until the whole offset has been read, so a
        search asking for no records read the offset first and then returned nothing.
    */
    recordIteratorLimitTest() {
        list<auto> records = ();
        foreach int id in (xrange(1, 11)) {
            records += {"id": id};
        }
        assertEq(10, records.size());

        # no limit: everything is read
        CountingIterator::pulled = 0;
        CountingIterator all(records);
        DefaultRecordIterator plain(all);
        assertEq(10, (map $1, plain).size());
        assertEq(10, CountingIterator::pulled);

        # a limit of zero returns nothing and reads nothing
        CountingIterator::pulled = 0;
        CountingIterator none(records);
        DefaultRecordIterator zero(none, NOTHING, {"limit": 0});
        assertEq((), map $1, zero);
        assertEq(0, CountingIterator::pulled, "a limit of zero reads nothing");

        # ...and still reads nothing when an offset is given, which is what was wrong: skipping to the
        # offset can only produce records the limit already excludes
        CountingIterator::pulled = 0;
        CountingIterator none_off(records);
        DefaultRecordIterator zero_off(none_off, NOTHING, {"limit": 0, "offset": 5});
        assertEq((), map $1, zero_off);
        assertEq(0, CountingIterator::pulled, "a limit of zero with an offset reads nothing");

        # a limit stops the walk as soon as it is met rather than draining the iterator
        CountingIterator::pulled = 0;
        CountingIterator two(records);
        DefaultRecordIterator limited(two, NOTHING, {"limit": 2});
        assertEq((1, 2), map $1.id, limited);
        assertEq(2, CountingIterator::pulled, "a limit of two reads two records");

        # an offset is skipped and the limit counts records returned after it
        CountingIterator::pulled = 0;
        CountingIterator off(records);
        DefaultRecordIterator windowed(off, NOTHING, {"limit": 2, "offset": 3});
        assertEq((4, 5), map $1.id, windowed);
        assertEq(5, CountingIterator::pulled, "three records are skipped and two returned");

        # a negative limit means no limit
        CountingIterator::pulled = 0;
        CountingIterator neg(records);
        DefaultRecordIterator unlimited(neg, NOTHING, {"limit": -1});
        assertEq(10, (map $1, unlimited).size());

        # the limit counts MATCHING records, not records read
        hash<DataProviderExpression> even = <DataProviderExpression>{
            "exp": DP_SEARCH_OP_GT,
            "args": (<DataProviderFieldReference>{"field": "id"}, 6),
        };
        CountingIterator::pulled = 0;
        CountingIterator matching(records);
        DefaultRecordIterator filtered(matching, even, {"limit": 2});
        assertEq((7, 8), map $1.id, filtered);
    }

    processorShapeApiTest() {
        assertEq(DataProviderShape::RowRecords, AbstractDataProcessor::detectShape({"a": 1}));
        assertEq(DataProviderShape::HashOfLists, AbstractDataProcessor::detectShape({"a": (1, 2)}));
        assertEq(2, AbstractDataProcessor::shapeRecordCount({"a": (1, 2)}, DataProviderShape::HashOfLists));

        list<auto> rows = AbstractDataProcessor::convertShape({"a": (1, 2), "b": ("x", "y")},
            DataProviderShape::HashOfLists, DataProviderShape::RowRecords);
        assertEq(2, rows.size());
        assertEq({"a": 1, "b": "x"}, rows[0]);
        assertEq({"a": 2, "b": "y"}, rows[1]);

        hash<auto> columns = AbstractDataProcessor::convertShape({"a": 1, "b": "x"},
            DataProviderShape::RowRecords, DataProviderShape::HashOfLists)[0];
        assertEq({"a": (1,), "b": ("x",)}, columns);

        ReturnBasedProcessor proc();
        assertTrue(proc.supportsInputShape(DataProviderShape::HashOfLists));
        assertTrue(proc.supportsInputShape(DataProviderShape::RowRecords));
        assertFalse(proc.supportsInputShape(DataProviderShape::DataFrameBlock));
    }

    #! A generic API error must keep the provider-specific exception that caused it
    wrappedExceptionCauseTest() {
        StructuredFailureTestProvider provider();

        # a caller must be able to recover the protocol status code without inspecting the description text
        code get_status_code = auto sub (auto arg, int depth = 0) {
            if (arg.typeCode() != NT_HASH || depth > 8) {
                return;
            }
            if (exists arg.status_code) {
                return arg.status_code;
            }
            foreach auto value in (arg.iterator()) {
                if (auto rv = get_status_code(value, depth + 1)) {
                    return rv;
                }
            }
        };

        hash<ExceptionInfo> ex;
        try {
            provider.sendMessage(StructuredFailureTestProvider::MessageId, {"node_id": "ns=2;s=Setpoint"});
        } catch (hash<ExceptionInfo> e) {
            ex = e;
        }
        assertEq("SEND-MESSAGE-ERROR", ex.err, "the generic API error code is unchanged");
        assertEq(StructuredFailureTestProvider::ErrorCode, ex.arg.ex.err,
            "the wrapper carries the provider-specific error code");
        assertEq(StructuredFailureTestProvider::StatusCode, ex.arg.ex.arg.status_code,
            "the wrapper carries the provider's structured argument");
        assertEq("ns=2;s=Setpoint", ex.arg.ex.arg.node_id, "every key of the structured argument is preserved");
        assertEq(StructuredFailureTestProvider::StatusCode, get_status_code(ex.arg),
            "a generic traversal of the structured argument recovers the status code");
        assertTrue(get_exception_string(ex) =~ /source exception/,
            "the cause is rendered as the source exception: " + get_exception_string(ex));

        # a wrapper that already forwarded the original argument keeps those keys where they were
        try {
            provider.createRecord({"id": 1});
        } catch (hash<ExceptionInfo> e) {
            ex = e;
        }
        assertEq("CREATE-RECORD-ERROR", ex.err, "the generic API error code is unchanged");
        assertEq(StructuredFailureTestProvider::StatusCode, ex.arg.status_code,
            "the original argument's keys remain where callers already read them");
        assertEq(StructuredFailureTestProvider::ErrorCode, ex.arg.ex.err,
            "the cause is added alongside the original argument's keys");
    }

    bulkProviderShapeApiTest() {
        hash<auto> dense_columns = {
            "id": new buffer<int64>((1, 2)),
            "score": new buffer<float64>((90.5, 88.0)),
        };

        BulkShapeTestProvider provider(
            (DataProviderShape::BufferColumns,),
            (DataProviderShape::BufferColumns,));
        assertEqSoft((DataProviderShape::BufferColumns,), provider.getBulkCreateShapes(),
            "provider advertises native bulk create shapes");
        assertEqSoft((DataProviderShape::BufferColumns,), provider.getBulkUpsertShapes(),
            "provider advertises native bulk upsert shapes");
        assertTrue(provider.supportsBulkCreateShape(DataProviderShape::BufferColumns),
            "provider reports BufferColumns create support");
        assertTrue(provider.supportsBulkUpsertShape(DataProviderShape::BufferColumns),
            "provider reports BufferColumns upsert support");
        assertFalse(provider.supportsBulkCreateShape(DataProviderShape::DataFrameBlock),
            "provider does not report unadvertised create shapes");

        assertEq({"id": (1, 2), "score": (90.5, 88.0)}, provider.createRecordsBulk(dense_columns, NOTHING),
            "advertised BufferColumns bulk create preserves the native shape until provider dispatch");
        assertEq(DataProviderShape::BufferColumns, provider.last_shape,
            "BufferColumns create dispatch uses createRecordsShapeImpl()");
        assertEq(1, provider.shape_create_calls, "BufferColumns create calls shaped provider implementation");
        assertEq(0, provider.bulk_create_calls, "BufferColumns create does not fall back to hash-of-lists first");

        assertEq((UpsertResultUpdated, UpsertResultUpdated), provider.upsertRecordsBulk(dense_columns, NOTHING),
            "advertised BufferColumns bulk upsert preserves the native shape until provider dispatch");
        assertEq(DataProviderShape::BufferColumns, provider.last_shape,
            "BufferColumns upsert dispatch uses upsertRecordsShapeImpl()");
        assertEq(1, provider.shape_upsert_calls, "BufferColumns upsert calls shaped provider implementation");
        assertEq(0, provider.bulk_upsert_calls, "BufferColumns upsert does not fall back to hash-of-lists first");

        BulkShapeTestProvider fallback_provider(NOTHING, NOTHING);
        assertEqSoft((DataProviderShape::HashOfLists,), fallback_provider.getBulkCreateShapes(),
            "providers without explicit create shapes default to hash-of-lists compatibility");
        assertEq({"id": (1, 2), "score": (90.5, 88.0)}, fallback_provider.createRecordsBulk(dense_columns, NOTHING),
            "unadvertised BufferColumns bulk create falls back automatically to hash-of-lists");
        assertEq(DataProviderShape::HashOfLists, fallback_provider.last_shape,
            "fallback create dispatch uses hash-of-lists provider implementation");
        assertEq(0, fallback_provider.shape_create_calls, "fallback create does not call shaped implementation");
        assertEq(1, fallback_provider.bulk_create_calls, "fallback create calls bulk hash-of-lists implementation");

        BulkShapeTestProvider stream_provider(
            (DataProviderShape::BufferColumns,),
            (DataProviderShape::BufferColumns,));
        assertEq({"id": (10, 20), "score": (1.5, 2.5)},
            stream_provider.createRecordsBulk(new BufferColumnBulkRecordProvider(), NOTHING),
            "stream bulk create consumes getShapedValue() automatically");
        assertEq(DataProviderShape::BufferColumns, stream_provider.last_shape,
            "stream bulk create preserves the advertised stream shape");
    }

    filteredHashMapTypeHintTest() {
        hash<string, bool> path_vars = {"name": True};
        *hash<string, bool> query_set;

        hash<string, AbstractDataField> fields = map {$1: new QoreDataField({
            "name": $1,
            "type": AbstractDataProviderTypeMap."softstring",
            "desc": sprintf("URI path variable %y", $1),
        })}, keys path_vars, !query_set{$1};

        assertEq(1, fields.size());
        assertEq("name", fields.name.getName());
        assertEq("softstring", fields.name.getTypeName());
    }

