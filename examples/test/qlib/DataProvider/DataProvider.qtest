#! Test filter processor using the new return-based API
class ReturnBasedFilterProcessor inherits AbstractDataProcessor {
    private *auto processRecordImpl(auto record) {
        if (record.skip) {
            return;
        }
        return record;
    }

    private int getProcessorCapabilitiesImpl() {
        return DPC_FILTER;
    }
}

#! Test expand processor using the new return-based API
class ReturnBasedExpandProcessor inherits AbstractDataProcessor {
    private *auto processRecordImpl(auto record) {
        return (record + {"copy": 1}, record + {"copy": 2});
    }

    private int getProcessorCapabilitiesImpl() {
        return DPC_EXPAND;
    }
}

#! Test aggregator using the new return-based API
class ReturnBasedAggregateProcessor inherits AbstractDataProcessor {
    private {
        list<auto> buffer;
    }

    private *auto processRecordImpl(auto record) {
        push buffer, record;
        # aggregate - don't output until flushed
        return;
    }

    private *list<auto> flushRecordsImpl() {
        if (!buffer) {
            return;
        }
        *list<auto> result = buffer;
        remove buffer;
        return result;
    }

    private int getProcessorCapabilitiesImpl() {
        return DPC_AGGREGATE;
    }
}

