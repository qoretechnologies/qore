    expressionTests() {
        checkYaml();
        hash<DataProviderExpression> exp = <DataProviderExpression>{
            "exp": DP_OP_AND,
            "args": (
                <DataProviderExpression>{
                    "exp": DP_SEARCH_OP_EQ,
                    "args": (
                        <DataProviderFieldReference>{"field": "status"},
                        "active",
                    ),
                },
                <DataProviderExpression>{
                    "exp": DP_SEARCH_OP_REGEX,
                    "args": (
                        <DataProviderFieldReference>{"field": "email"},
                        "@example\\.com$",
                    ),
                },
                <DataProviderExpression>{
                    "exp": DP_OP_OR,
                    "args": (
                        <DataProviderExpression>{
                            "exp": DP_SEARCH_OP_BETWEEN,
                            "args": (
                                <DataProviderFieldReference>{"field": "age"},
                                18,
                                30,
                            ),
                        },
                        <DataProviderExpression>{
                            "exp": DP_SEARCH_OP_IN,
                            "args": (
                                <DataProviderFieldReference>{"field": "role"},
                                ("admin", "editor", "moderator"),
                            ),
                        },
                        <DataProviderExpression>{
                            "exp": "calculate",
                            "args": (
                                <DataProviderFieldReference>{"field": "score"},
                                1000,
                                2000,
                            ),
                        },
                    ),
                },
            ),
        };
        hash<DataProviderExpressionInfo> fexp = <DataProviderExpressionInfo>{
            "type": DET_Function,
            "name": "calculate",
            "display_name": "calculate()",
            "short_desc": "Calculates a value",
            "desc": "Calculates a value",
            "args": (DataProviderSignatureIntType),
            "varargs": True,
            "return_type": AbstractDataProviderTypeMap."int",
        };

        string str = DataProvider::renderExpression(exp, DataProviderGenericExpressions + {
            "calculate": fexp,
        });
        assertEq("({status} == \"active\") && ({email} =~ /\"@example\\\\.com$\"/) && (({age} between 18 and 30) || "
            "({role} in ([\"admin\", \"editor\", \"moderator\"])) || calculate({score}, 1000, 2000))", str);

        hash<DataProviderExpressionInfo> opexp = <DataProviderExpressionInfo>{
            "type": DET_Operator,
            "name": "startsWith",
            "display_name": "String Starts With",
            "short_desc": "Returns `True` if the given value starts with the given characters when converted to a "
                "string",
            "desc": "Returns `True` if the given value starts with the given characters when converted to a string",
            "symbol": "startsWith",
            "render_template": "$arg[0].startsWith($arg[1], $arg[2])",
            "groups": "Comparison",
            "args": (DataProviderSignatureStringType, DataProviderSignatureStringType, DataProviderSignatureBoolType),
            "arg_info": (
                <DataProviderArgInfo>{
                },
                <DataProviderArgInfo>{
                },
                <DataProviderArgInfo>{
                    "default_value": False,
                },
            ),
            "return_type": AbstractDataProviderTypeMap."bool",
        },
        exp = <DataProviderExpression>{
            "exp": "startsWith",
            "args": (
                <DataProviderFieldReference>{"field": "username"},
                "admin",
                True,
            ),
        };
        str = DataProvider::renderExpression(exp, DataProviderGenericExpressions + {
            "startsWith": opexp,
        });
        assertEq("{username}.startsWith(\"admin\", true)", str);
        exp = <DataProviderExpression>{
            "exp": "startsWith",
            "args": (
                <DataProviderFieldReference>{"field": "username"},
                "admin",
            ),
        };
        str = DataProvider::renderExpression(exp, DataProviderGenericExpressions + {
            "startsWith": opexp,
        });
        assertEq("{username}.startsWith(\"admin\", false)", str);

        opexp = <DataProviderExpressionInfo>{
            "type": DET_Operator,
            "name": "in-list",
            "display_name": "In List",
            "short_desc": "Returns True if the first argument is found in the second argument",
            "desc": "Returns `True` if the first argument is found in the second argument; the optional third "
                "argument provides the location of the value to compare if list elements are complex objects "
                "themselves",
            "symbol": "in",
            "render_template": "$arg[0] in ($arg[1])${arg[2] ? [IGNORE-CASE]:}",
            "groups": "Comparison",
            "args": (DataProviderSignatureAnyType, DataProviderSignatureListType, DataProviderSignatureBoolType),
            "return_type": AbstractDataProviderTypeMap."bool",
        };
        exp = <DataProviderExpression>{
            "exp": "in-list",
            "args": (
                <DataProviderFieldReference>{"field": "category"},
                ("A", "B", "C"),
                True,
            ),
        };
        str = DataProvider::renderExpression(exp, DataProviderGenericExpressions + {
            "in-list": opexp,
        });
        assertEq("{category} in ([\"A\", \"B\", \"C\"]) [IGNORE-CASE]", str);
        exp = <DataProviderExpression>{
            "exp": "in-list",
            "args": (
                <DataProviderFieldReference>{"field": "category"},
                ("A", "B", "C"),
            ),
        };
        str = DataProvider::renderExpression(exp, DataProviderGenericExpressions + {
            "in-list": opexp,
        });
        assertEq("{category} in ([\"A\", \"B\", \"C\"])", str);

        opexp = <DataProviderExpressionInfo>{
            "type": DET_Operator,
            "name": "in-list",
            "display_name": "In List",
            "short_desc": "Returns True if the first argument is found in the second argument",
            "desc": "Returns `True` if the first argument is found in the second argument; the optional third "
                "argument provides the location of the value to compare if list elements are complex objects "
                "themselves",
            "symbol": "in",
            "render_template": "$arg[0] in ($arg[1])${arg[2] ? [loc $arg[2]]:}",
            "groups": "Comparison",
            "args": (DataProviderSignatureAnyType, DataProviderSignatureListType,
                DataProviderSignatureOptionalStringType),
            "return_type": AbstractDataProviderTypeMap."bool",
        };
        exp = <DataProviderExpression>{
            "exp": "in-list",
            "args": (
                <DataProviderFieldReference>{"field": "account"},
                ("A", "B", "C"),
                "extra.info",
            ),
        };
        str = DataProvider::renderExpression(exp, DataProviderGenericExpressions + {
            "in-list": opexp,
        });
        assertEq("{account} in ([\"A\", \"B\", \"C\"]) [loc \"extra.info\"]", str);

    }

    getDisplayNameTest() {
        assertEq("Get URL", AbstractDataField::getDisplayName("getURL"));
        assertEq("Get URL", AbstractDataField::getDisplayName("GetURL"));
        assertEq("Get User URL", AbstractDataField::getDisplayName("getUserURL"));
        assertEq("Get User URL", AbstractDataField::getDisplayName("GetUserURL"));
        assertEq("Client URLs", AbstractDataField::getDisplayName("clientURLs"));
        assertEq("Client URLs", AbstractDataField::getDisplayName("ClientURLs"));
        assertEq("User ID", AbstractDataField::getDisplayName("userId"));
        assertEq("User ID", AbstractDataField::getDisplayName("UserId"));
        assertEq("User ID", AbstractDataField::getDisplayName("userID"));
        assertEq("User ID", AbstractDataField::getDisplayName("UserID"));
        assertEq("Create TPS Reports", AbstractDataField::getDisplayName("createTPSReports"));
        assertEq("Create TPS Reports", AbstractDataField::getDisplayName("CreateTPSReports"));
        assertEq("FBI Code", AbstractDataField::getDisplayName("FBICode"));

        # words in all upper case are case-folded
        assertEq("Payment Dispute Adjudicate 28", AbstractDataField::getDisplayName("PAYMENT-DISPUTE-ADJUDICATE-28"));
        assertEq("Payment", AbstractDataField::getDisplayName("PAYMENT"));
        assertEq("Order Number", AbstractDataField::getDisplayName("ORDER_NUMBER"));
        assertEq("Some Value 2", AbstractDataField::getDisplayName("SOME_VALUE_2"));
        assertEq("2Factor Auth", AbstractDataField::getDisplayName("2FACTOR_AUTH"));
        assertEq("User's Name", AbstractDataField::getDisplayName("USER'S_NAME"));
        assertEq("Abcd", AbstractDataField::getDisplayName("ABCD"));
        # mixed-case words carry their own case information and are never case-folded
        assertEq("Mixed CASE Here", AbstractDataField::getDisplayName("MixedCASE_here"));
        assertEq("Payment User ID", AbstractDataField::getDisplayName("PAYMENT_userID"));

        # short words and well-known acronyms are preserved
        assertEq("ID", AbstractDataField::getDisplayName("ID"));
        assertEq("URL", AbstractDataField::getDisplayName("URL"));
        assertEq("Customer ID", AbstractDataField::getDisplayName("CUSTOMER_ID"));
        assertEq("XML Data", AbstractDataField::getDisplayName("XML_DATA"));
        assertEq("VAT Number", AbstractDataField::getDisplayName("VAT_NUMBER"));
        assertEq("HTTP Server", AbstractDataField::getDisplayName("HTTP_SERVER"));
        assertEq("IBAN", AbstractDataField::getDisplayName("IBAN"));
        assertEq("SOAP Action", AbstractDataField::getDisplayName("SOAP_ACTION"));

        # short words that are not acronyms are case-folded
        assertEq("Max HTTP Retries", AbstractDataField::getDisplayName("MAX_HTTP_RETRIES"));
        assertEq("Min Value", AbstractDataField::getDisplayName("MIN_VALUE"));
        assertEq("New Order ID", AbstractDataField::getDisplayName("NEW_ORDER_ID"));

        # explicit classifications override all other rules
        assertEq("Top MAX Val", AbstractDataField::getDisplayName("TOP_MAX_VAL", {"MAX": True}));
        assertEq("Iban Code", AbstractDataField::getDisplayName("IBAN_CODE", {"IBAN": False}));
        assertEq("Id List", AbstractDataField::getDisplayName("ID_LIST", {"ID": False}));
        # an explicit classification also overrides a canonical rendering
        assertEq("Api Key", AbstractDataField::getDisplayName("api_key", {"API": False}));
        assertEq("Saas Tier", AbstractDataField::getDisplayName("saas_tier", {"SAAS": False}));

        # canonical renderings apply to technical names written in lower case
        assertEq("API Key", AbstractDataField::getDisplayName("api_key"));
        assertEq("API Schema Manager WS", AbstractDataField::getDisplayName("api-schema-manager-ws"));
        assertEq("JSON Payload", AbstractDataField::getDisplayName("json_payload"));
        assertEq("SQL Query", AbstractDataField::getDisplayName("sql_query"));
        assertEq("HTTP Client", AbstractDataField::getDisplayName("http_client"));
        assertEq("LDAP Server", AbstractDataField::getDisplayName("ldap_server"));
        assertEq("URL", AbstractDataField::getDisplayName("url"));
        assertEq("ID", AbstractDataField::getDisplayName("id"));

        # canonical renderings restore irregular capitalization that no case rule can derive
        assertEq("SaaS Provider", AbstractDataField::getDisplayName("saas_provider"));
        assertEq("IPv4 Address", AbstractDataField::getDisplayName("ipv4_address"));
        assertEq("IPv6 Address", AbstractDataField::getDisplayName("ipv6_address"));
        assertEq("OAuth2 Token", AbstractDataField::getDisplayName("oauth2_token"));
        assertEq("gRPC Stub", AbstractDataField::getDisplayName("grpc_stub"));
        assertEq("GraphQL Query", AbstractDataField::getDisplayName("graphql_query"));
        assertEq("PayPal Account", AbstractDataField::getDisplayName("paypal_account"));
        assertEq("eBay Listing", AbstractDataField::getDisplayName("ebay_listing"));
        assertEq("iOS Device", AbstractDataField::getDisplayName("ios_device"));
        assertEq("MySQL Connection", AbstractDataField::getDisplayName("mysql_connection"));
        assertEq("GitHub Repo", AbstractDataField::getDisplayName("github_repo"));
        assertEq("YoY Growth", AbstractDataField::getDisplayName("yoy_growth"));
        assertEq("CapEx Budget", AbstractDataField::getDisplayName("capex_budget"));

        # business acronyms longer than AcronymMaxLength are no longer case-folded
        assertEq("EBITDA Value", AbstractDataField::getDisplayName("ebitda_value"));
        assertEq("EBITDA Value", AbstractDataField::getDisplayName("EBITDA_VALUE"));
        assertEq("GDPR Consent", AbstractDataField::getDisplayName("gdpr_consent"));
        assertEq("HIPAA Flag", AbstractDataField::getDisplayName("hipaa_flag"));
        assertEq("EULA Text", AbstractDataField::getDisplayName("eula_text"));
        assertEq("RMA Number", AbstractDataField::getDisplayName("rma_number"));
        assertEq("DOE Form", AbstractDataField::getDisplayName("doe_form"));
        assertEq("ELF Binary", AbstractDataField::getDisplayName("elf_binary"));

        # the same word yields the same display name however the technical name is written
        foreach hash<auto> i in ((
            {"lower": "api_key", "upper": "API_KEY", "camel": "apiKey", "expect": "API Key"},
            {"lower": "user_id", "upper": "USER_ID", "camel": "userId", "expect": "User ID"},
            {"lower": "http_server", "upper": "HTTP_SERVER", "camel": "httpServer", "expect": "HTTP Server"},
            {"lower": "vat_number", "upper": "VAT_NUMBER", "camel": "vatNumber", "expect": "VAT Number"},
        )) {
            assertEq(i.expect, AbstractDataField::getDisplayName(i.lower), i.lower);
            assertEq(i.expect, AbstractDataField::getDisplayName(i.upper), i.upper);
            assertEq(i.expect, AbstractDataField::getDisplayName(i.camel), i.camel);
        }

        # function words are not acronyms, whatever case the technical name is written in
        assertEq("Created At", AbstractDataField::getDisplayName("created_at"));
        assertEq("Created At", AbstractDataField::getDisplayName("CREATED_AT"));
        assertEq("Updated By", AbstractDataField::getDisplayName("UPDATED_BY"));
        assertEq("Is Active", AbstractDataField::getDisplayName("IS_ACTIVE"));
        assertEq("In Stock", AbstractDataField::getDisplayName("IN_STOCK"));
        assertEq("Per Page", AbstractDataField::getDisplayName("PER_PAGE"));
        assertEq("Due Date", AbstractDataField::getDisplayName("DUE_DATE"));

        # function words stay in lower case in the middle of a display name, but not at either end
        assertEq("Wait for Active Shards", AbstractDataField::getDisplayName("wait_for_active_shards"));
        assertEq("Usage Limit per User", AbstractDataField::getDisplayName("usage_limit_per_user"));
        assertEq("Date on Sale From", AbstractDataField::getDisplayName("date_on_sale_from"));
        assertEq("Remove Customer from Group", AbstractDataField::getDisplayName("remove-customer-from-group"));
        assertEq("Of", AbstractDataField::getDisplayName("of"));
        assertEq("To Do", AbstractDataField::getDisplayName("to_do"));

        # words with no canonical rendering keep the behavior they had
        assertEq("Widget Sprocket", AbstractDataField::getDisplayName("widget_sprocket"));
        assertEq("Zzz Qqq", AbstractDataField::getDisplayName("zzz_qqq"));
        assertEq("Frobnicate", AbstractDataField::getDisplayName("FROBNICATE"));

        # consecutive separators do not produce consecutive spaces
        assertEq("Order Number", AbstractDataField::getDisplayName("order__number"));
        assertEq("Order Number", AbstractDataField::getDisplayName("_order-number_"));

        # canonical renderings never contain a word separator, so that display names convert back to the
        # technical names they were derived from
        foreach string word in (keys AbstractDataField::WordRenderings) {
            string rendering = AbstractDataField::WordRenderings{word};
            assertFalse(rendering =~ /[ .\/-]/, sprintf("%y rendering %y has no separator", word, rendering));
            assertEq(word, rendering.lwr(), sprintf("%y rendering %y folds back to its key", word, rendering));
        }

        # display names convert back to the technical names they were derived from
        foreach string name in (("api-key", "saas-provider", "ipv4-address", "oauth2-token", "user-id",
            "paypal-account", "ios-device", "created-at", "wait-for-active-shards", "ebitda-value")) {
            assertEq(name, AbstractDataField::getNameFromDisplayName(AbstractDataField::getDisplayName(name)),
                name);
        }

        # case handling is Unicode-aware in all scripts
        assertEq("Платіж Дата", AbstractDataField::getDisplayName("ПЛАТІЖ_ДАТА"));
        assertEq("ПІБ Клієнта", AbstractDataField::getDisplayName("ПІБ_КЛІЄНТА"));
        assertEq("Клієнт Дані", AbstractDataField::getDisplayName("клієнтДані"));
        assertEq("ПІБ Дані", AbstractDataField::getDisplayName("ПІБДані"));
        assertEq("Ім'я Користувача", AbstractDataField::getDisplayName("ІМ'Я_КОРИСТУВАЧА"));
        assertEq("Überweisung Betrag", AbstractDataField::getDisplayName("ÜBERWEISUNG_BETRAG"));
        assertEq("Český Město", AbstractDataField::getDisplayName("ČESKÝ_MĚSTO"));
        assertEq("İstanbul Kodu", AbstractDataField::getDisplayName("İSTANBUL_KODU"));
        # Greek: the final form of sigma is used at the end of a word
        assertEq("Οδος Αριθμος", AbstractDataField::getDisplayName("ΟΔΟΣ_ΑΡΙΘΜΟΣ"));
        assertEq("ΑΦΜ Πελατη", AbstractDataField::getDisplayName("ΑΦΜ_ΠΕΛΑΤΗ"));
        # explicit classifications work in any script
        assertEq("ЄДРПОУ Код", AbstractDataField::getDisplayName("ЄДРПОУ_КОД", {"ЄДРПОУ": True, "КОД": False}));
        # words in caseless scripts are always left unchanged
        assertEq("東京 駅", AbstractDataField::getDisplayName("東京_駅"));
        assertEq("مدينة رقم", AbstractDataField::getDisplayName("مدينة_رقم"));
        assertEq("עברית שדה", AbstractDataField::getDisplayName("עברית_שדה"));
        assertEq("支払い ID", AbstractDataField::getDisplayName("支払い-ID"));

        # corner cases
        assertEq("", AbstractDataField::getDisplayName(""));
        # a name consisting only of separators has no words, and therefore no display name
        assertEq("", AbstractDataField::getDisplayName("-"));
        assertEq("", AbstractDataField::getDisplayName("__"));
        assertEq("2", AbstractDataField::getDisplayName("2"));

        # technical names round-trip through display names in all scripts
        foreach string tname in (("payment-dispute-28", "customer-id", "платіж-дата", "οδος-αριθμος")) {
            assertEq(tname, AbstractDataField::getNameFromDisplayName(AbstractDataField::getDisplayName(tname)),
                tname);
        }
        assertEq("платіж-дата", AbstractDataField::getNameFromDisplayName("Платіж Дата"));
        assertEq("überweisung-betrag", AbstractDataField::getNameFromDisplayName("Überweisung Betrag"));
    }

    semanticStringFormatTypesTest() {
        # each semantic string format type is registered, string-backed, carries its format as the name and
        # the "qore.external_name" tag (used by UIs to render an appropriate control), and accepts a valid
        # value
        hash<string, string> valid = {
            "email": "a@b.com",
            "uri": "https://example.com/x",
            "uuid": "12345678-1234-1234-1234-123456789abc",
            "hostname": "host.example.com",
            "ipv4": "10.0.0.1",
            "ipv6": "::1",
            "phone": "+1 555 1234",
        };
        foreach hash<auto> i in (valid.pairIterator()) {
            AbstractDataProviderType t = AbstractDataProviderTypeMap{i.key};
            assertEq(i.key, t.getName(), i.key + " type name");
            assertEq("string", t.getBaseTypeName(), i.key + " is string-backed");
            assertEq(i.key, t.getTag("qore.external_name"), i.key + " external_name tag");
            assertEq(i.value, t.acceptsValue(i.value), i.key + " accepts a valid value");

            AbstractDataProviderType nt = AbstractDataProviderTypeMap{"*" + i.key};
            assertEq("*" + i.key, nt.getName(), "*" + i.key + " nullable name");
            assertNothing(nt.acceptsValue(NOTHING), "*" + i.key + " accepts no value");

            # the type resolves by name via both get(string) and a name-only get(hash) descriptor, so
            # fields/options may reference it by name (e.g. from metadata or the type builder)
            assertEq(i.key, AbstractDataProviderType::get(i.key).getName(), i.key + " resolves by name");
            assertEq(i.key, AbstractDataProviderType::get(<DataTypeInfo>{"name": i.key}).getName(),
                i.key + " resolves from a name-only descriptor");
        }

        # invalid values are rejected server-side (backstop)
        assertThrows("RUNTIME-TYPE-ERROR", sub () {
            AbstractDataProviderTypeMap."email".acceptsValue("not-an-email");
        });
        assertThrows("RUNTIME-TYPE-ERROR", sub () {
            AbstractDataProviderTypeMap."ipv4".acceptsValue("999.0.0.1");
        });
        assertThrows("RUNTIME-TYPE-ERROR", sub () {
            AbstractDataProviderTypeMap."uuid".acceptsValue("not-a-uuid");
        });

        # the "qore.external_name" tag survives a getInfo()/get() round-trip so the UI label is preserved
        # even though the reconstructed type degrades to its string base
        AbstractDataProviderType rt =
            AbstractDataProviderType::get((AbstractDataProviderTypeMap."email").getInfo());
        assertEq("string", rt.getBaseTypeName(), "round-trip type is string-backed");
        assertEq("email", rt.getTag("qore.external_name"), "external_name tag survives round-trip");
    }

    semanticTypesThroughProviderTest() {
        # semanticStringFormatTypesTest() covers the types in isolation; this covers them where
        # qlib modules actually use them: on a data provider's record/request types
        SemanticTypeTestProvider p();

        # --- response side: metadata only, and it survives the type description round-trip ---
        hash<string, AbstractDataField> rt = p.getRecordType();
        assertEq("*email", rt.email.getType().getName(), "record email field keeps its semantic type");
        assertEq("string", rt.email.getType().getBaseTypeName(), "record email field is string-backed");
        assertEq("email", rt.email.getType().getTag("qore.external_name"),
            "record email field carries the external_name tag a UI keys off");
        assertEq("uri", rt.website_url.getType().getTag("qore.external_name"),
            "record website_url field carries the uri external_name tag");
        assertNothing(rt.id.getType().getTag("qore.external_name"),
            "a plain-string record field carries no format identity");

        # the UI identity survives getInfo()/get(), even though the type degrades to its string base
        AbstractDataProviderType round = AbstractDataProviderType::get(rt.email.getType().getInfo());
        assertEq("string", round.getBaseTypeName(), "round-tripped record field type is string-backed");
        assertEq("email", round.getTag("qore.external_name"),
            "external_name survives getInfo()/get() on a record field");

        # the whole record type description round-trips with the format identity intact
        hash<string, hash<DataTypeInfo>> ti = map {$1.key: $1.value.getType().getInfo()}, rt.pairIterator();
        assertEq("email", AbstractDataProviderType::get(ti.email).getTag("qore.external_name"),
            "external_name survives a record-type-wide getInfo() round-trip");

        # --- records the provider RETURNS are never validated: this is the property that makes
        # converting a response field safe, so assert it rather than assume it ---
        list<auto> recs = map $1, p.searchRecords();
        assertEq(1, recs.size(), "the provider returned its record");
        assertEq(SemanticTypeTestProvider::MalformedRecord.email, recs[0].email,
            "a returned email that fails the format regex is relayed unchanged");
        assertEq(SemanticTypeTestProvider::MalformedRecord.website_url, recs[0].website_url,
            "a returned scheme-less URL is relayed unchanged");

        # --- request side: input IS validated ---
        AbstractDataProviderType reqt = p.getRequestType();
        assertEq("email", reqt.getFields().email.getType().getTag("qore.external_name"),
            "request email field carries the format identity");

        hash<auto> good = {"email": "a@b.com", "note": "anything at all"};
        assertEq(good, reqt.acceptsValue(good), "a well-formed request is accepted");

        # the exact values the design doc calls out as rejected must be rejected here too
        assertThrows("RUNTIME-TYPE-ERROR", "not a valid", sub () {
            reqt.acceptsValue({"email": "Contact Name <a@b.com>"});
        }, NOTHING, "RFC-5322 display-name form is rejected on a request field");
        assertThrows("RUNTIME-TYPE-ERROR", "not a valid", sub () {
            reqt.acceptsValue({"email": "a@b.com,c@d.com"});
        }, NOTHING, "a comma-joined address list is rejected on a request field");

        # a plain-string sibling field is unaffected by the semantic typing of its neighbour
        assertEq("anything at all", reqt.acceptsValue(good).note,
            "a plain-string request field still accepts free text");

        # --- the format identity reaches the app-action option a UI renders ---
        # NOTE: it rides on the option's *type* tags, not on ActionOptionInfo::ui_type: ui_type is
        # only populated from an explicit field attribute (DataProviderActionCatalog.qc:2235), and a
        # semantic type does not set one.  Assert the mechanism that actually carries the identity so
        # this stays honest if ui_type derivation is added later.
        hash<string, hash<ActionOptionInfo>> opts =
            DataProviderActionCatalog::getActionOptionFromFields(reqt.getFields());
        assertEq("email", opts.email.type.getTag("qore.external_name"),
            "the semantic format identity reaches the action option through the option type");
        assertEq((AbstractDataProviderTypeMap."email").getTag("qore.validation_regex"),
            opts.email.type.getTag("qore.validation_regex"),
            "the format regex reaches the action option through the option type");
        assertNothing(opts.email.ui_type,
            "a semantic type does not populate ui_type; only an explicit field attribute does");
    }

    actionOptionSemanticAttrTest() {
        # DataProviderOptionInfo (ConstructorOptions-style) options carry ui_type and sensitive (both
        # BaseOptionInfo fields); these must survive conversion to ActionOptionInfo. ui_type was previously
        # dropped on this (DataProviderOptionInfo) merge branch.
        hash<string, hash<DataProviderOptionInfo>> cfields = {
            "api_key": <DataProviderOptionInfo>{
                "type": AbstractDataProviderTypeMap."string",
                "display_name": "API Key",
                "short_desc": "API key",
                "desc": "The API key",
                "ui_type": "password",
                "sensitive": True,
            },
        };
        hash<string, hash<ActionOptionInfo>> copts =
            DataProviderActionCatalog::getActionOptionFromFields(cfields);
        assertEq("password", copts.api_key.ui_type,
            "ui_type propagates from a DataProviderOptionInfo option");
        assertTrue(copts.api_key.sensitive,
            "sensitive propagates from a DataProviderOptionInfo option");

        # AbstractDataField-sourced options (e.g. from a request/response record type) carry these via
        # custom field attributes; getActionOptionFromFields must copy them into the ActionOptionInfo
        QoreDataField email_field("email", "Email address", AbstractDataProviderTypeMap."string");
        email_field.setAttributes({
            "ui_type": "email",
            "validation_regex": "^[^@]+@[^@]+$",
        });
        hash<string, AbstractDataField> efields = {"email": email_field};
        hash<string, hash<ActionOptionInfo>> fopts =
            DataProviderActionCatalog::getActionOptionFromFields(efields);
        assertEq("email", fopts.email.ui_type,
            "ui_type propagates from an AbstractDataField attribute");
        assertEq("^[^@]+@[^@]+$", fopts.email.validation_regex,
            "validation_regex propagates from an AbstractDataField attribute");

        # a raw-hash field also carries an explicit ui_type through the raw-info merge path
        hash<auto> rawfields = {
            "website": {
                "type": AbstractDataProviderTypeMap."string",
                "display_name": "Website",
                "short_desc": "Website",
                "desc": "Website URL",
                "ui_type": "url",
            },
        };
        hash<string, hash<ActionOptionInfo>> ropts =
            DataProviderActionCatalog::getActionOptionFromFields(rawfields);
        assertEq("url", ropts.website.ui_type,
            "ui_type propagates from a raw-hash field");
    }

    actionOptionExampleDeterminismTest() {
        hash<auto> implicit_example_field = {
            "timestamp": {
                "type": DateOrNothingType,
                "display_name": "Timestamp",
                "short_desc": "Timestamp",
                "desc": "Timestamp",
            },
        };
        hash<string, hash<ActionOptionInfo>> implicit_options_a =
            DataProviderActionCatalog::getActionOptionFromFields(implicit_example_field);
        hash<string, hash<ActionOptionInfo>> implicit_options_b =
            DataProviderActionCatalog::getActionOptionFromFields(implicit_example_field);
        assertFalse(implicit_options_a.timestamp.hasKey("example_value"),
            "raw fields do not acquire a generated example value");
        assertFalse(implicit_options_b.timestamp.hasKey("example_value"),
            "repeated conversion does not acquire a generated example value");

        date example_a = 2026-01-02T03:04:05Z;
        date example_b = 2027-02-03T04:05:06Z;
        hash<auto> explicit_example_field_a = implicit_example_field + {
            "timestamp": implicit_example_field.timestamp + {
                "example_value": example_a,
            },
        };
        hash<auto> explicit_example_field_b = implicit_example_field + {
            "timestamp": implicit_example_field.timestamp + {
                "example_value": example_b,
            },
        };
        hash<string, hash<ActionOptionInfo>> explicit_options_a =
            DataProviderActionCatalog::getActionOptionFromFields(explicit_example_field_a);
        hash<string, hash<ActionOptionInfo>> explicit_options_b =
            DataProviderActionCatalog::getActionOptionFromFields(explicit_example_field_b);
        assertEq(example_a, explicit_options_a.timestamp.example_value,
            "explicit raw-field examples are preserved");
        assertEq(example_b, explicit_options_b.timestamp.example_value,
            "different explicit raw-field examples are preserved");

        string app = "option-example-" + get_random_string();
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": app,
            "display_name": "Option Example Test",
            "short_desc": "Option example test",
            "desc": "Tests deterministic action option examples",
            "groups": (AppGroup::DataTransformation,),
            "logo": "data",
            "logo_mime_type": MimeTypeSvg,
            "logo_file_name": "test.svg",
            "dynamic": True,
        });
        on_exit DataProviderActionCatalog::deregisterDynamicApp(app);

        hash<DataProviderActionInfo> implicit_action = <DataProviderActionInfo>{
            "app": app,
            "action": "implicit-example",
            "path": "/implicit-example",
            "display_name": "Implicit Example",
            "short_desc": "Implicit example",
            "desc": "Implicit example",
            "action_code": DPAT_API,
            "options": implicit_options_a,
        };
        DataProviderActionCatalog::registerAction(implicit_action);
        implicit_action.options = implicit_options_b;
        DataProviderActionCatalog::registerAction(implicit_action);

        hash<DataProviderActionInfo> explicit_action = <DataProviderActionInfo>{
            "app": app,
            "action": "explicit-example",
            "path": "/explicit-example",
            "display_name": "Explicit Example",
            "short_desc": "Explicit example",
            "desc": "Explicit example",
            "action_code": DPAT_API,
            "options": explicit_options_a,
        };
        DataProviderActionCatalog::registerAction(explicit_action);
        explicit_action.options = explicit_options_b;
        assertThrows("ACTION-ERROR", \DataProviderActionCatalog::registerAction(), explicit_action);
    }

    actionCatalogTests() {
        # negative tests registering apps
        assertThrows("APP-ERROR", \DataProviderActionCatalog::registerApp(), <DataProviderAppInfo>{});
        assertThrows("APP-ERROR", \DataProviderActionCatalog::registerApp(), <DataProviderAppInfo>{
            "name": "",
            "short_desc": "",
            "desc": "",
            "logo": "",
            "logo_file_name": "",
            "logo_mime_type": "",
        });

        # missing description
        assertThrows("APP-ERROR", \DataProviderActionCatalog::registerApp(), <DataProviderAppInfo>{
            "name": "test",
            "display_name": "test",
            "short_desc": "test",
            "scheme": "test",
            "logo": "data",
            "logo_mime_type": MimeTypeSvg,
            "logo_file_name": "test.svg",
        });

        # missing logo
        assertThrows("APP-ERROR", \DataProviderActionCatalog::registerApp(), <DataProviderAppInfo>{
            "name": "test",
            "display_name": "test",
            "short_desc": "test",
            "desc": "desc",
            "scheme": "test",
            "logo_mime_type": MimeTypeSvg,
            "logo_file_name": "test.svg",
        });

        # missing logo mime type
        assertThrows("APP-ERROR", \DataProviderActionCatalog::registerApp(), <DataProviderAppInfo>{
            "name": "test",
            "display_name": "test",
            "short_desc": "test",
            "desc": "desc",
            "scheme": "test",
            "logo": "data",
            "logo_file_name": "test.svg",
        });

        # missing logo file name
        assertThrows("APP-ERROR", \DataProviderActionCatalog::registerApp(), <DataProviderAppInfo>{
            "name": "test",
            "display_name": "test",
            "short_desc": "test",
            "desc": "desc",
            "scheme": "test",
            "logo": "data",
            "logo_mime_type": MimeTypeJpeg,
        });

        # missing display name
        assertThrows("APP-ERROR", \DataProviderActionCatalog::registerApp(), <DataProviderAppInfo>{
            "name": "test",
            "short_desc": "test",
            "desc": "desc",
            "scheme": "test",
            "logo": "data",
            "logo_mime_type": MimeTypeJpeg,
            "logo_file_name": "test.svg",
        });

        # missing short desc
        assertThrows("APP-ERROR", \DataProviderActionCatalog::registerApp(), <DataProviderAppInfo>{
            "name": "test",
            "display_name": "test",
            "desc": "desc",
            "scheme": "test",
            "logo": "data",
            "logo_mime_type": MimeTypeJpeg,
            "logo_file_name": "test.svg",
        });

        string app = get_random_string();
        string appdesc = get_random_string();
        string scheme = get_random_string();
        hash<DataProviderAppInfo> my_app = <DataProviderAppInfo>{
            "name": app,
            "display_name": "test",
            "short_desc": "test",
            "desc": appdesc,
            "groups": (AppGroup::DataTransformation,),
            "scheme": scheme,
            "logo": "data",
            "logo_mime_type": MimeTypeSvg,
            "logo_file_name": "test.svg",
            "dynamic": True,
        };
        DataProviderActionCatalog::registerApp(my_app);
        assertEq(my_app, DataProviderActionCatalog::getApp(app));

        {
            Program p(PO_NO_PROCESS_CONTROL);
            p.parse("sub test(string name) { DataProviderActionCatalog::deregisterDynamicApp(name); }", "test");
            assertThrows("PERMISSION-DENIED", \p.callFunction(), ("test", app));
        }

        assertThrows("APP-ERROR", \DataProviderActionCatalog::getAppEx(), get_random_string());

        # negative tests registering actions
        assertThrows("ACTION-ERROR", \DataProviderActionCatalog::registerAction(), <DataProviderActionInfo>{});
        assertThrows("ACTION-ERROR", \DataProviderActionCatalog::registerAction(), <DataProviderActionInfo>{
            "app": "",
            "action": "",
            "path": "",
            "display_name": "",
            "short_desc": "",
            "desc": "",
        });

        assertEq(my_app, DataProviderActionCatalog::getApp(app));

        string act = get_random_string();

        string short_desc = get_random_string(40);
        string desc = get_random_string(100);

        # invalid app
        assertThrows("ACTION-ERROR", \DataProviderActionCatalog::registerAction(), <DataProviderActionInfo>{
            "app": get_random_string(),
            "action": act,
            "path": "/",
            "display_name": "test",
            "short_desc": short_desc,
            "desc": desc,
            "action_code": DPAT_API,
        });

        # missing path var definitions
        assertThrows("ACTION-ERROR", \DataProviderActionCatalog::registerAction(), <DataProviderActionInfo>{
            "app": app,
            "action": act,
            "path": "/{key}",
            "display_name": "test",
            "short_desc": short_desc,
            "desc": desc,
            "action_code": DPAT_API,
        });

        # extra path var definitions
        assertThrows("ACTION-ERROR", \DataProviderActionCatalog::registerAction(), <DataProviderActionInfo>{
            "app": app,
            "action": act,
            "path": "/",
            "display_name": "test",
            "short_desc": short_desc,
            "desc": desc,
            "path_vars": {
                "test": <DataProviderPathVarInfo>{
                    "display_name": "test",
                    "short_desc": "test",
                    "desc": "test",
                },
            },
            "action_code": DPAT_API,
        });

        # invalid action code
        assertThrows("ACTION-ERROR", \DataProviderActionCatalog::registerAction(), <DataProviderActionInfo>{
            "app": app,
            "action": act,
            "path": "/",
            "display_name": "test",
            "short_desc": short_desc,
            "desc": desc,
            "action_code": -1,
        });

        # missing display name
        assertThrows("ACTION-ERROR", \DataProviderActionCatalog::registerAction(), <DataProviderActionInfo>{
            "app": app,
            "action": act,
            "path": "/",
            "short_desc": short_desc,
            "desc": desc,
            "action_code": DPAT_API,
        });

        {
            Program p();
            assertThrows("PARSE-EXCEPTION", \p.parse(), (
                "%modern\n"
                "%disable-warning unreferenced-variable\n"
                "%requires DataProvider\n"
                "sub test() {\n"
                "    hash<DataProviderActionInfo> bad = <DataProviderActionInfo>{\n"
                "        \"app\": \"" + app + "\",\n"
                "        \"action\": \"" + act + "\",\n"
                "        \"path\": \"/\",\n"
                "        \"display_name\": \"test\",\n"
                "        \"short_desc\": \"" + short_desc + "\",\n"
                "        \"desc\": \"" + desc + "\",\n"
                "        \"action_code\": 1,\n"
                "        \"requires_action_context\": \"invalid\",\n"
                "    };\n"
                "}\n",
                "test"));
        }

        # test type check for requires_child_eligibility_check (must be bool, not string)
        {
            Program p();
            assertThrows("PARSE-EXCEPTION", \p.parse(), (
                "%modern\n"
                "%disable-warning unreferenced-variable\n"
                "%requires DataProvider\n"
                "sub test() {\n"
                "    hash<DataProviderActionInfo> bad = <DataProviderActionInfo>{\n"
                "        \"app\": \"" + app + "\",\n"
                "        \"action\": \"" + act + "\",\n"
                "        \"path\": \"/\",\n"
                "        \"display_name\": \"test\",\n"
                "        \"short_desc\": \"" + short_desc + "\",\n"
                "        \"desc\": \"" + desc + "\",\n"
                "        \"action_code\": 1,\n"
                "        \"requires_child_eligibility_check\": \"invalid\",\n"
                "    };\n"
                "}\n",
                "test"));
        }

        hash<DataProviderActionInfo> action = <DataProviderActionInfo>{
            "app": app,
            "action": act,
            "path": "/",
            "display_name": "test",
            "short_desc": short_desc,
            "desc": desc,
            "action_code": DPAT_API,
            "input_data_types": {
                DPAD_NORMAL: True,
            },
            "output_data_type": DPAD_NORMAL,
            "requires_action_context": True,
            "action_context": "pipeline",
            "requires_child_eligibility_check": True,
        };
        DataProviderActionCatalog::registerAction(action);
        my_app.supports_apis = True;

        assertThrows("APP-ERROR", \DataProviderActionCatalog::getActionsEx(), get_random_string());

        list<hash<DataProviderActionInfo>> all_actions = DataProviderActionCatalog::getActions(app);
        assertEq(1, all_actions.size());
        assertEq(action, all_actions[0]);
        assertTrue(all_actions[0].requires_action_context);
        assertEq("pipeline", all_actions[0].action_context);
        assertTrue(all_actions[0].requires_child_eligibility_check);

        list<hash<DataProviderAppInfo>> apps = DataProviderActionCatalog::searchAppRegex(app);
        assertEq(1, apps.size());
        assertEq(my_app, apps[0]);

        apps = DataProviderActionCatalog::searchAppSubstr(app, True);
        assertEq(1, apps.size());
        assertEq(my_app, apps[0]);

        apps = DataProviderActionCatalog::searchAppSubstr(app, False);
        assertEq(1, apps.size());
        assertEq(my_app, apps[0]);

        apps = DataProviderActionCatalog::searchAppRegex(appdesc[5..10]);
        assertEq(1, apps.size());
        assertEq(my_app, apps[0]);

        apps = DataProviderActionCatalog::searchAppSubstr(appdesc[5..10], True);
        assertEq(1, apps.size());
        assertEq(my_app, apps[0]);

        apps = DataProviderActionCatalog::searchAppSubstr(appdesc[5..10], False);
        assertEq(1, apps.size());
        assertEq(my_app, apps[0]);

        apps = DataProviderActionCatalog::searchAppRegex(get_random_string());
        assertEq((), apps);

        apps = DataProviderActionCatalog::searchAppSubstr(get_random_string(), True);
        assertEq((), apps);

        apps = DataProviderActionCatalog::searchAppSubstr(get_random_string(), False);
        assertEq((), apps);

        list<hash<DataProviderActionInfo>> actions = DataProviderActionCatalog::getActions(app);
        assertEq(1, actions.size());
        assertEq(action, actions[0]);

        assertEq((), DataProviderActionCatalog::searchAppActionRegex(get_random_string(), short_desc));
        assertEq((), DataProviderActionCatalog::searchAppActionSubstr(get_random_string(), short_desc));

        assertThrows("APP-ERROR", \DataProviderActionCatalog::searchAppActionRegexEx(), (get_random_string(),
            short_desc));
        assertThrows("APP-ERROR", \DataProviderActionCatalog::searchAppActionSubstrEx(), (get_random_string(),
            short_desc));

        assertEq((), DataProviderActionCatalog::searchActionRegex(get_random_string()));
        assertEq((), DataProviderActionCatalog::searchActionSubstr(get_random_string(), True));
        assertEq((), DataProviderActionCatalog::searchActionSubstr(get_random_string(), False));
        assertNothing(DataProviderActionCatalog::getActionsForScheme(get_random_string()));

        actions = DataProviderActionCatalog::searchAppActionRegex(app, short_desc);
        assertEq(1, actions.size());
        assertEq(action, actions[0]);

        actions = DataProviderActionCatalog::searchAppActionSubstr(app, short_desc);
        assertEq(1, actions.size());
        assertEq(action, actions[0]);

        actions = DataProviderActionCatalog::searchActionRegex(short_desc);
        assertEq(1, actions.size());
        assertEq(action, actions[0]);

        actions = DataProviderActionCatalog::searchActionRegex(desc);
        assertEq(1, actions.size());
        assertEq(action, actions[0]);

        actions = DataProviderActionCatalog::searchActionSubstr(short_desc, False);
        assertEq(1, actions.size());
        assertEq(action, actions[0]);

        actions = DataProviderActionCatalog::searchActionSubstr(desc, False);
        assertEq(1, actions.size());
        assertEq(action, actions[0]);

        actions = DataProviderActionCatalog::searchActionSubstr(short_desc, True);
        assertEq(1, actions.size());
        assertEq(action, actions[0]);

        actions = DataProviderActionCatalog::searchActionSubstr(desc, True);
        assertEq(1, actions.size());
        assertEq(action, actions[0]);

        actions = DataProviderActionCatalog::getActionsForScheme(scheme);
        assertEq(1, actions.size());
        assertEq(action, actions[0]);

        assertTrue(exists DataProviderActionCatalog::deregisterDynamicApp(app));
        assertNothing(DataProviderActionCatalog::getApp(app));
    }

    #! Regression: deregistering apps must remove their actions from the static top_actionmap
    /** deregisterAppIntern()/deregisterDynamicApp() previously removed @c app_actionmap{name} before
        using it to clean @c top_actionmap, so the @c top_actionmap cleanup iterated an already-empty
        map and every action - together with the entire option/data-type graph it holds - was leaked
        permanently in the static @c top_actionmap on each register/deregister cycle (unbounded growth
        under app/connection churn). This asserts the top-level action map returns to its baseline
        size after deregistration.
    */
    actionDeregisterCleanupTest() {
        int base_actions = DataProviderActionCatalog::getAllActions().size();
        int base_apps = (DataProviderActionCatalog::getAllApps() ?? ()).size();

        # an option carrying an AbstractDataProviderType, mirroring the (heavy) option/type graph
        # that the framework-injected make-api-call action attaches to every REST-capable app
        hash<string, hash<ActionOptionInfo>> opts = {
            "name": <ActionOptionInfo>{
                "display_name": "Name",
                "short_desc": "the name",
                "desc": "the name",
                "type": AbstractDataProviderType::get("string"),
            },
        };

        int count = 25;
        list<string> names = ();
        for (int i = 0; i < count; ++i) {
            string app = sprintf("RegCleanupApp_%s_%d", get_random_string(8), i);
            names += app;
            DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
                "name": app,
                "display_name": app,
                "short_desc": "t",
                "desc": "t",
                "groups": (AppGroup::DataTransformation,),
                "logo": "data",
                "logo_mime_type": MimeTypeSvg,
                "logo_file_name": "t.svg",
                "dynamic": True,
            });
            DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
                "app": app,
                "action": "act",
                "path": "/act",
                "display_name": "Act",
                "short_desc": "a",
                "desc": "a",
                "action_code": DPAT_API,
                "options": opts,
            });
        }

        # the actions are present in the top-level map while registered
        assertEq(base_actions + count, DataProviderActionCatalog::getAllActions().size(),
            "registered actions appear in the top-level action map");

        # deregister every app
        map DataProviderActionCatalog::deregisterDynamicApp($1), names;

        # the deregistered actions must be fully removed from the static top_actionmap; before the
        # fix they leaked here and this size stayed at base_actions + count
        assertEq(base_actions, DataProviderActionCatalog::getAllActions().size(),
            "deregistered actions are removed from the top-level action map (no top_actionmap leak)");
        assertEq(base_apps, (DataProviderActionCatalog::getAllApps() ?? ()).size(),
            "deregistered apps are removed from the app cache");
        foreach string app in (names) {
            assertNothing(DataProviderActionCatalog::getApp(app), "app removed: " + app);
            assertNothing(DataProviderActionCatalog::getAppAction(app, "act"), "action removed: " + app);
        }
    }

    pendingAppModuleContextTest() {
        # the 3-arg registerPendingApp() form must associate the explicitly supplied module context
        # with the app, so that getModulePathsForApp() reports it after on-demand initialization
        string app = sprintf("PendingCtxApp_%s", get_random_string(8));
        string module_path = sprintf("/path/to/%s.qm", get_random_string(8));

        hash<DataProviderAppInfo> app_info = <DataProviderAppInfo>{
            "name": app,
            "display_name": app,
            "short_desc": "t",
            "desc": "t",
            "groups": (AppGroup::DataTransformation,),
            "logo": "data",
            "logo_mime_type": MimeTypeSvg,
            "logo_file_name": "t.svg",
            "dynamic": True,
        };

        # before init, no module paths are associated
        assertNothing(DataProviderActionCatalog::getModulePathsForApp(app),
            "no module paths before pending app is initialized");

        DataProviderActionCatalog::registerPendingApp(app, sub () {
            DataProviderActionCatalog::registerApp(app_info);
        }, module_path);

        # trigger on-demand initialization
        assertEq(app_info, DataProviderActionCatalog::getApp(app),
            "pending app is initialized on demand");

        # the explicitly supplied module context must be associated with the app, independent of the
        # caller's current module context (which is empty at the top level here)
        assertEq((module_path,), DataProviderActionCatalog::getModulePathsForApp(app),
            "explicit module context is associated with the app after init");

        DataProviderActionCatalog::deregisterDynamicApp(app);
        assertNothing(DataProviderActionCatalog::getApp(app), "app removed after deregistration");

        # the 2-arg backward-compatible form must still work without an explicit module context
        string app2 = sprintf("PendingCtxApp2_%s", get_random_string(8));
        hash<DataProviderAppInfo> app2_info = app_info;
        app2_info.name = app2;
        app2_info.display_name = app2;
        DataProviderActionCatalog::registerPendingApp(app2, sub () {
            DataProviderActionCatalog::registerApp(app2_info);
        });
        assertEq(app2_info, DataProviderActionCatalog::getApp(app2),
            "2-arg registerPendingApp() form initializes the app on demand");
        DataProviderActionCatalog::deregisterDynamicApp(app2);
    }

    stringTest() {
        AbstractDataProviderType t = AbstractDataProviderType::get(new StringTestType());
        assertEq("1", t.acceptsValue(1));
    }

    dataTest() {
        AbstractDataProviderType t = AbstractDataProviderType::get(DataType);
        binary val = get_random_bytes(20);
        assertEq(val, t.acceptsValue(val));
        t = AbstractDataProviderType::get(DataOrNothingType);
        assertEq(val, t.acceptsValue(val));
    }

    compatTest() {
        QoreStringDataType str();
        HashDataType t1("t1");
        t1.setDefaultOtherFieldType();
        t1.addField(new QoreDataField("a", "desc", str));
        HashDataType t2("t2");
        t2.setDefaultOtherFieldType();
        t2.addField(new QoreDataField("b", "desc", str));
        HashDataType t3("t3");
        HashDeclDataType t4(TypedHash::forName("StatInfo"));
        HashDataType t5("t5");
        t5.addField(new QoreDataField("a", "desc", str));
        t5.addField(new QoreDataField("b", "desc", str));
        HashDataType t6("t6");
        t6.addField(new QoreDataField("a", "desc", str));
        HashDataType t7("t7");
        t7.addField(new QoreDataField("b", "desc", str));
        HashDataType t8("t8");
        t8.addField(new QoreDataField("type", "desc", str));

        assertEq(NT_STRING, t1.getField("a").getType().getBaseTypeCode());

        assertEq({"a": "Example a"}, t1.getExampleValue());

        assertFalse(t1.isAssignableFrom(t2));
        assertTrue(t3.isAssignableFrom(t1));
        assertTrue(t3.isAssignableFrom(t2));
        assertTrue(t3.isAssignableFrom(t4));
        assertTrue(t1.isAssignableFrom(t3));
        assertTrue(t2.isAssignableFrom(t3));
        assertFalse(t1.isAssignableFrom(t5));
        assertFalse(t2.isAssignableFrom(t5));

        assertFalse(t1.isAssignableFrom(str));
        assertFalse(t2.isAssignableFrom(str));
        assertFalse(t3.isAssignableFrom(str));

        assertFalse(t6.isAssignableFrom(t2));
        assertTrue(t3.isAssignableFrom(t6));
        assertTrue(t3.isAssignableFrom(t7));
        assertTrue(t6.isAssignableFrom(t3));
        assertTrue(t7.isAssignableFrom(t3));
        assertFalse(t6.isAssignableFrom(t5));
        assertFalse(t7.isAssignableFrom(t5));

        assertFalse(t6.isAssignableFrom(str));
        assertFalse(t7.isAssignableFrom(str));
        assertFalse(t3.isAssignableFrom(str));

        assertFalse(t4.isAssignableFrom(t1));
        assertFalse(t4.isAssignableFrom(t8));
        assertFalse(t8.isAssignableFrom(t4));

        {
            hash<auto> v = {"type": "str"};
            assertEq(v, t8.acceptsValue(v));
            assertEq(v, t4.acceptsValue(v));
        }

        hash<auto> h1;
        h1 += {
            "a": "string",
        };
        hash<auto> h2;
        h2 += {
            "b": "string",
        };
        assertThrows("MISSING-VALUE-ERROR", \t1.acceptsValue(), h2);
        assertThrows("MISSING-VALUE-ERROR", \t2.acceptsValue(), h1);
        assertThrows("RUNTIME-TYPE-ERROR", \t1.acceptsValue(), 1);
        assertThrows("RUNTIME-TYPE-ERROR", \t2.acceptsValue(), 1);
        assertThrows("RUNTIME-TYPE-ERROR", \t3.acceptsValue(), 1);
        assertEq(h1, t1.acceptsValue(h1));
        assertEq(h2, t2.acceptsValue(h2));
        assertEq(h1, t3.acceptsValue(h1));
        assertEq(h2, t3.acceptsValue(h2));
        assertEq(<StatInfo>{"size": 1}, t3.acceptsValue(<StatInfo>{"size": 1}));
        assertThrows("RUNTIME-TYPE-ERROR", \t1.acceptsValue(), h2 + {"a": "string"});
        assertThrows("RUNTIME-TYPE-ERROR", \t2.acceptsValue(), h1 + {"b": "string"});
        assertThrows("RUNTIME-TYPE-ERROR", \t1.acceptsValue(), {"a": 1});
        assertThrows("RUNTIME-TYPE-ERROR", \t2.acceptsValue(), {"b": 2});
        t1.setDefaultOtherFieldType(new QoreIntDataType());
        t2.setDefaultOtherFieldType(new QoreIntDataType());
        h1 += {"b": 2};
        h2 += {"a": 2};
        assertEq(h1, t1.acceptsValue(h1));
        assertEq(h2, t2.acceptsValue(h2));
    }

    optionalTypedHashFieldTest() {
        AbstractDataProviderType optional_type = AbstractDataProviderType::get(new Type("*hash<StatInfo>"));
        assertFalse(optional_type.isMandatory());
        assertTrue(optional_type.isOrNothingType());
        assertNothing(optional_type.acceptsValue());
        assertEq(<StatInfo>{"size": 1}, optional_type.acceptsValue({"size": 1}));

        HashDataType request_type();
        request_type.addQoreFields({
            "stat": {
                "type": new Type("*hash<StatInfo>"),
                "display_name": "Stat",
            },
        });

        assertFalse(request_type.getField("stat").isMandatory());
        assertEq({}, request_type.acceptsValue({}));
        assertEq({"stat": <StatInfo>{"size": 1}}, request_type.acceptsValue({"stat": {"size": 1}}));
    }

    pipelineTest() {
        {
            TestRecordProvider record_provider();
            DataProviderPipeline pipe();
            assertThrows("PIPELINE-ERROR", \pipe.submit(), {});

            TestRecordProcessor record_processor0("A");
            assertEq(AbstractDataProviderType::anyDataType, record_processor0.getExpectedType());
            assertEq(AbstractDataProviderType::anyDataType, record_processor0.getReturnType());
            pipe.append(record_processor0);
            pipe.submit(record_provider);
            pipe.waitDone();
            assertEq({"A-a": 1, "A-b": 2}, record_processor0.recs[0]);

            hash<PipelineInfo> info = pipe.getInfo();
            assertEq(1, info.record_count);
            assertTrue(info.bulk);

            TestRecordProcessor record_processor1("B");
            pipe.append(record_processor1);
            pipe.submit(record_provider);
            pipe.waitDone();
            assertEq({"B-A-a": 1, "B-A-b": 2}, record_processor1.recs[0]);

            info = pipe.getInfo();
            assertEq(2, info.record_count);
            assertTrue(info.bulk);

            DataProviderPipeline pipe1 = pipe.copy();
            record_processor0.clear();
            record_processor1.clear();

            pipe1.submit(record_provider);
            pipe1.waitDone();
            assertEq({"A-a": 1, "A-b": 2}, record_processor0.recs[0]);
            assertEq({"B-A-a": 1, "B-A-b": 2}, record_processor1.recs[0]);

            info = pipe1.getInfo();
            assertEq(1, info.record_count);
            assertTrue(info.bulk);

            DataProviderPipelineFactory factory();
            factory.append(record_processor0);
            factory.append(record_processor1);
            assertEq({
                "opts": NOTHING,
                "num_queues": 1,
                "bulk": True,
            }, factory.getInfo());

            DataProviderPipeline pipe2 = factory.create();
            record_processor0.clear();
            record_processor1.clear();

            pipe2.submit(record_provider);
            pipe2.waitDone();
            assertEq({"A-a": 1, "A-b": 2}, record_processor0.recs[0]);
            assertEq({"B-A-a": 1, "B-A-b": 2}, record_processor1.recs[0]);

            info = pipe2.getInfo();
            assertEq(1, info.record_count);
            assertTrue(info.bulk);
        }

        {
            TestRecordProvider record_provider();
            DataProviderPipeline pipe(<PipelineOptionInfo>{
                #"info_log": sub (string fmt) { vprintf(fmt + "\n", argv); },
                #"debug_log": sub (string fmt) { vprintf(fmt + "\n", argv); },
                #"error_log": sub (string fmt) { vprintf(fmt + "\n", argv); },
            });
            assertThrows("PIPELINE-ERROR", \pipe.submit(), {});

            hash<auto> flush_rec = {
                "x-1": get_random_string(),
            };
            TestFlushRecordProcessor record_processor0("A", NOTHING, NOTHING, flush_rec);
            assertEq(AbstractDataProviderType::anyDataType, record_processor0.getExpectedType());
            assertEq(AbstractDataProviderType::anyDataType, record_processor0.getReturnType());
            pipe.append(record_processor0);
            pipe.submit(record_provider);
            pipe.waitDone();
            assertEq({"A-a": 1, "A-b": 2}, record_processor0.recs[0]);

            hash<PipelineInfo> info = pipe.getInfo();
            assertEq(1, info.record_count);
            assertTrue(info.bulk);

            TestRecordProcessor record_processor1("B");
            pipe.append(record_processor1);
            pipe.submit(record_provider);
            pipe.waitDone();
            assertEq({"B-A-a": 1, "B-A-b": 2}, record_processor1.recs[0]);

            info = pipe.getInfo();
            assertEq(2, info.record_count);
            assertTrue(info.bulk);

            DataProviderPipeline pipe1 = pipe.copy();
            record_processor0.clear();
            record_processor1.clear();

            pipe1.submit(record_provider);
            pipe1.waitDone();
            assertEq({"A-a": 1, "A-b": 2}, record_processor0.recs[0]);
            assertEq({"B-A-a": 1, "B-A-b": 2}, record_processor1.recs[0]);
            assertEq({"B-x-1": flush_rec."x-1"}, record_processor1.recs[1]);

            info = pipe1.getInfo();
            assertEq(1, info.record_count);
            assertTrue(info.bulk);

            DataProviderPipelineFactory factory();
            factory.append(record_processor0);
            factory.append(record_processor1);
            assertEq({
                "opts": NOTHING,
                "num_queues": 1,
                "bulk": True,
            }, factory.getInfo());

            DataProviderPipeline pipe2 = factory.create();
            record_processor0.clear();
            record_processor1.clear();

            pipe2.submit(record_provider);
            pipe2.waitDone();
            assertEq({"A-a": 1, "A-b": 2}, record_processor0.recs[0]);
            assertEq({"B-A-a": 1, "B-A-b": 2}, record_processor1.recs[0]);

            info = pipe2.getInfo();
            assertEq(1, info.record_count);
            assertTrue(info.bulk);
        }

        {
            TestRecordProvider record_provider();
            DataProviderPipeline pipe(<PipelineOptionInfo>{
                #"info_log": sub (string fmt) { vprintf(fmt + "\n", argv); },
                #"debug_log": sub (string fmt) { vprintf(fmt + "\n", argv); },
                #"error_log": sub (string fmt) { vprintf(fmt + "\n", argv); },
            });

            TestRecordProcessor record_processorA0("A");
            TestRecordProcessor record_processorA1("B");

            TestRecordProcessor record_processorB0("A");
            TestRecordProcessor record_processorB1("B");

            # run pipeline in parallel
            int p0 = pipe.appendQueue(0);
            int p1 = pipe.appendQueue(0);

            pipe.append(p0, record_processorA0);
            pipe.append(p0, record_processorA1);

            pipe.append(p1, record_processorB1);
            pipe.append(p1, record_processorB0);

            pipe.submit(record_provider);
            pipe.waitDone();
            assertEq({"B-A-a": 1, "B-A-b": 2}, record_processorA1.recs[0]);
            assertEq({"A-B-a": 1, "A-B-b": 2}, record_processorB0.recs[0]);

            hash<PipelineInfo> info = pipe.getInfo();
            assertEq(1, info.record_count);
            assertTrue(info.bulk);

            DataProviderPipeline pipe1 = pipe.copy();
            record_processorA0.clear();
            record_processorA1.clear();
            record_processorB0.clear();
            record_processorB1.clear();
