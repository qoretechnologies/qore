hashdecl TypedRecordIteratorRow {
    int id;
    string name;
}

#! An iterator that records how many records were pulled out of it
/** A record iterator wrapping a service reads a record at a time and each one can cost a request, so what
    matters is not only which records a search returns but how many it had to read to answer.
*/
class CountingIterator inherits AbstractIterator {
    public {
        #! How many times next() was called and returned a record
        /** Class-static, because DefaultRecordIterator deletes the iterator it wraps as soon as that
            iterator is exhausted, so a counter on the object cannot be read afterwards.
        */
        static int pulled = 0;
    }

    private {
        list<auto> l;
        int idx = -1;
    }

    constructor(list<auto> records) {
        l = records;
    }

    bool next() {
        if (idx >= (l.size() - 1)) {
            idx = l.size();
            return False;
        }
        ++idx;
        ++pulled;
        return True;
    }

    auto getValue() {
        return l[idx];
    }

    bool valid() {
        return idx >= 0 && idx < l.size();
    }
}

class TypedRecordIterator inherits AbstractIterator<hash<TypedRecordIteratorRow>> {
    private {
        bool available = True;
        bool valid_flag = False;
    }

    bool next() {
        if (!available) {
            valid_flag = False;
            return False;
        }

        available = False;
        valid_flag = True;
        return True;
    }

    hash<TypedRecordIteratorRow> getValue() {
        if (!valid_flag) {
            throw "INVALID-ITERATOR", "iterator is not valid";
        }

        return <TypedRecordIteratorRow>{
            "id": 1,
            "name": "alpha",
        };
    }

    bool valid() {
        return valid_flag;
    }
}

class TestIntProcessor inherits AbstractDataProcessor {
    private {
        int inc;
        int sum = 0;
        *bool skip_odd;
    }

    constructor(int inc, *bool skip_odd) {
        self.inc = inc;
        self.skip_odd = skip_odd;
    }

    int getSum() {
        return sum;
    }

    reset() {
        sum = 0;
    }

    private submitImpl(code enqueue, auto rec) {
        if (skip_odd && rec > inc && (rec % 2)) {
            return;
        }
        rec += inc;
        sum += rec;
        enqueue(rec);
    }

    private bool supportsBulkApiImpl() {
        return False;
    }
}

