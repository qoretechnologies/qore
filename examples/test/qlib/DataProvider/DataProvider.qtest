            # register action lazily
            DataProviderActionCatalog::registerPendingAppAction(app, "lazy-api", sub () {
                DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
                    "app": app,
                    "path": "/lazy-api",
                    "action": "lazy-api",
                    "display_name": "Lazy API",
                    "short_desc": "lazy API action for test",
                    "desc": "lazy API action for test",
