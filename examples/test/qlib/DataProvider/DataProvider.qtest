            assertTrue(app_info.supports_apis);

            # clean up
            DataProviderActionCatalog::deregisterDynamicApp(app);
        }

        # Test that getAllApps() initializes pending actions and sets supports_* flags
        {
            string app = get_random_string();
            hash<DataProviderAppInfo> my_app = <DataProviderAppInfo>{
                "name": app,
                "display_name": "test lazy init all",
                "short_desc": "test lazy init all app",
                "desc": "test lazy init all description",
                "groups": ("Test",),
                "logo": "<svg></svg>",
                "logo_file_name": "test.svg",
                "logo_mime_type": MimeTypeSvg,
                "dynamic": True,
            };
            DataProviderActionCatalog::registerApp(my_app);

            # register action lazily
            DataProviderActionCatalog::registerPendingAppAction(app, "lazy-event", sub () {
                DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
                    "app": app,
                    "path": "/lazy-event",
                    "action": "lazy-event",
                    "display_name": "Lazy Event",
                    "short_desc": "lazy event action for test",
                    "desc": "lazy event action for test",
                    "action_code": DPAT_EVENT,
                });
            });

            # verify getAllApps() initializes lazy actions and sets supports_events
            *list<hash<DataProviderAppInfo>> all_apps = DataProviderActionCatalog::getAllApps();
            *hash<DataProviderAppInfo> found = (map $1, all_apps, $1.name == app)[0];
            assertTrue(found.val());
            assertTrue(found.supports_events);

            # clean up
            DataProviderActionCatalog::deregisterDynamicApp(app);
        }

        # Test that searchAppRegex() initializes pending actions and sets supports_* flags
        {
            string app = get_random_string();
            hash<DataProviderAppInfo> my_app = <DataProviderAppInfo>{
                "name": app,
                "display_name": "test lazy search regex",
                "short_desc": "test lazy search regex app",
                "desc": "test lazy search regex description",
                "groups": ("Test",),
