#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%enable-all-warnings

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires DataProvider
%requires Logger
%requires HttpServerUtil
%requires HttpServer
%requires RestClientIo

%exec-class WatchDataProviderShutdownTest

#! Dummy observer for watch data providers
class TestObserver inherits DataProvider::Observer {
    update(string event_id, hash<auto> data_) {
        # no-op
    }
}

#! A concrete watch data provider that simulates a long-running poll operation
class SlowWatchDataProvider inherits DataProvider::AbstractWatchDataProviderBase {
    public {
        #! Set to True when cancelPollOperation() is called
        bool cancel_called = False;

        #! Set to True when pollOnce() starts
        bool poll_started = False;

        #! Counter for pollOnce() invocations
        Counter poll_counter(0);

        #! Condition for signaling that poll has started
        Mutex poll_m();
        Condition poll_cond();
    }

    private {
        #! Simulated blocking gate — pollOnce() waits on this
        Gate poll_gate();
    }

    constructor() : AbstractWatchDataProviderBase(1) {
        # Lock the gate so pollOnce() blocks
        poll_gate.enter();
    }

    #! Unblocks the gate, simulating what rest.close() does for real providers
    releasePoll() {
        poll_gate.exit();
    }

    private pollOnce() {
        {
            AutoLock al(poll_m);
            poll_started = True;
            poll_counter.inc();
            poll_cond.broadcast();
        }
        # Block here until the gate is released (simulates a blocking HTTP request)
        poll_gate.enter();
        poll_gate.exit();
    }

    private cancelPollOperation() {
        cancel_called = True;
        # Release the gate to unblock pollOnce()
        releasePoll();
    }

    #! Waits until pollOnce() has started
    waitForPollStart(timeout timeout_ms = 5s) {
        AutoLock al(poll_m);
        while (!poll_started) {
            if (poll_cond.wait(poll_m, timeout_ms)) {
                throw "TIMEOUT", "pollOnce() did not start in time";
            }
        }
    }

    #! Public wrapper for isStopping()
    bool checkStopping() {
        return isStopping();
    }

    # Stubs required by AbstractDataProvider
    string getName() { return "test-slow-watch"; }
    private hash<DataProvider::DataProviderInfo> getStaticInfoImpl() {
        return <DataProviderInfo>{
            "name": getName(),
            "supports_observable": True,
        };
    }
}

#! A watch data provider where pollOnce() completes quickly (tests normal stop during sleep)
class FastWatchDataProvider inherits DataProvider::AbstractWatchDataProviderBase {
    public {
        #! Set to True when cancelPollOperation() is called
        bool cancel_called = False;

        #! Number of times pollOnce() was called
        int poll_count = 0;

        #! Gate to signal first poll is done
        Mutex poll_m();
        Condition poll_cond();
    }

    constructor() : AbstractWatchDataProviderBase(60) {
    }

    private pollOnce() {
        {
            AutoLock al(poll_m);
            ++poll_count;
            poll_cond.broadcast();
        }
    }

    private cancelPollOperation() {
        cancel_called = True;
    }

    #! Waits until at least one poll has completed
    waitForFirstPoll(timeout timeout_ms = 5s) {
        AutoLock al(poll_m);
        while (poll_count < 1) {
            if (poll_cond.wait(poll_m, timeout_ms)) {
                throw "TIMEOUT", "pollOnce() did not complete in time";
            }
        }
    }

    #! Public wrapper for isStopping()
    bool checkStopping() {
        return isStopping();
    }

    # Stubs required by AbstractDataProvider
    string getName() { return "test-fast-watch"; }
    private hash<DataProvider::DataProviderInfo> getStaticInfoImpl() {
        return <DataProviderInfo>{
            "name": getName(),
            "supports_observable": True,
        };
    }
}

#! A watch data provider whose cancelPollOperation() throws
class ErrorCancelWatchDataProvider inherits DataProvider::AbstractWatchDataProviderBase {
    public {
        #! Set to True when pollOnce() starts
        bool poll_started = False;

        Mutex poll_m();
        Condition poll_cond();
    }

    private {
        Gate poll_gate();
    }

    constructor() : AbstractWatchDataProviderBase(1) {
        poll_gate.enter();
    }

    releasePoll() {
        poll_gate.exit();
    }

    private pollOnce() {
        {
            AutoLock al(poll_m);
            poll_started = True;
            poll_cond.broadcast();
        }
        poll_gate.enter();
        poll_gate.exit();
    }

    private cancelPollOperation() {
        # Release the gate first so the poll thread can exit
        releasePoll();
        # Then throw — stopEventsIntern() must still complete cleanly
        throw "CANCEL-ERROR", "simulated cancel failure";
    }

    waitForPollStart(timeout timeout_ms = 5s) {
        AutoLock al(poll_m);
        while (!poll_started) {
            if (poll_cond.wait(poll_m, timeout_ms)) {
                throw "TIMEOUT", "pollOnce() did not start in time";
            }
        }
    }

    # Stubs
    string getName() { return "test-error-cancel-watch"; }
    private hash<DataProvider::DataProviderInfo> getStaticInfoImpl() {
        return <DataProviderInfo>{
            "name": getName(),
            "supports_observable": True,
        };
    }
}

#! Concrete provider exposing the generic checkpoint hooks for deterministic tests
class CheckpointWatchDataProvider inherits DataProvider::AbstractWatchDataProviderBase {
    private {
        hash<auto> restored;
    }

    constructor() : AbstractWatchDataProviderBase(60) {
    }

    hash<auto> getRestoredCheckpoint() {
        return restored;
    }

    save(hash<auto> checkpoint) {
        persistCheckpoint(checkpoint);
    }

    private restoreCheckpoint(hash<auto> checkpoint) {
        if (checkpoint.version != 1) {
            throw "TEST-CHECKPOINT-ERROR", "unsupported checkpoint";
        }
        restored = checkpoint;
    }

    private pollOnce() {
        # no-op
    }

    string getName() { return "test-checkpoint-watch"; }
    private hash<DataProvider::DataProviderInfo> getStaticInfoImpl() {
        return <DataProviderInfo>{
            "name": getName(),
            "supports_observable": True,
        };
    }
}

#! A watch data provider whose poll blocks with no cancelPollOperation() override
/** The poll blocks on a queue, or in a request with a REST client shared with the test, until the polling thread
    is cancelled
*/
class BlockingWatchDataProvider inherits DataProvider::AbstractWatchDataProviderBase {
    public {
        #! Receives the TID of the polling thread when the poll starts
        Queue poll_entered();
        #! The errors of the poll
        list<hash<ExceptionInfo>> errors();
    }

    private {
        #! The poll blocks on this queue if no REST client is set
        Queue block();
        #! An optional REST client shared with the test
        *RestClientIo rest;
    }

    constructor(*RestClientIo rest) : AbstractWatchDataProviderBase(60) {
        self.rest = rest;
    }

    private pollOnce() {
        poll_entered.push(gettid());
        if (rest) {
            rest.restGet("/block");
        } else {
            block.get();
        }
    }

    private logPollError(hash<ExceptionInfo> ex) {
        errors += ex;
    }

    string getName() { return "test-blocking-watch"; }
    private hash<DataProvider::DataProviderInfo> getStaticInfoImpl() {
        return <DataProviderInfo>{
            "name": getName(),
            "supports_observable": True,
        };
    }
}

#! A watch data provider that raises one event and stores one checkpoint per poll
class DeferredWatchDataProvider inherits DataProvider::AbstractWatchDataProviderBase {
    public {
        #! Receives the TID of the polling thread when a checkpoint is being stored
        Queue saving();
        #! Released to let the checkpoint be stored
        Queue save_release();
        #! The checkpoints stored
        list<hash<auto>> saved();
        #! The errors of the poll
        list<hash<ExceptionInfo>> errors();
        #! Set if the checkpoint is stored before notifying
        bool save_first;
    }

    constructor(bool save_first) : AbstractWatchDataProviderBase(60) {
        self.save_first = save_first;
        setCheckpointPersistence(NOTHING, sub (hash<auto> checkpoint) {
            saving.push(gettid());
            save_release.get();
            saved += checkpoint;
        });
    }

    private pollOnce() {
        if (save_first) {
            persistCheckpoint({"n": 1});
        } else {
            notifyObservers("event", {"n": 1});
        }
    }

    private logPollError(hash<ExceptionInfo> ex) {
        errors += ex;
    }

    string getName() { return "test-deferred-watch"; }
    private hash<DataProvider::DataProviderInfo> getStaticInfoImpl() {
        return <DataProviderInfo>{
            "name": getName(),
            "supports_observable": True,
        };
    }
}

#! An observer that blocks until released
class BlockingObserver inherits DataProvider::Observer {
    public {
        #! Receives the TID of the notifying thread when an event is being handled
        Queue entered();
        #! Released to let the event be handled
        Queue release();
        #! The events handled completely
        list<hash<auto>> handled();
    }

    update(string event_id, hash<auto> data_) {
        entered.push(gettid());
        release.get();
        handled += data_;
    }
}

#! Blocks requests to "/block" until released
class BlockingRequestHandler inherits AbstractHttpRequestHandler {
    public {
        Queue release();
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        if (hdr.path == "block") {
            release.get(30s);
        }
        return <HttpResponseInfo>{
            "code": 200,
            "hdr": {"Content-Type": MimeTypeText},
            "body": hdr.path,
        };
    }
}

class WatchDataProviderShutdownTest inherits QUnit::Test {
    constructor() : Test("WatchDataProviderShutdownTest", "1.0") {
        addTestCase("cancel during blocked poll", \testCancelDuringBlockedPoll());
        addTestCase("polling thread cancelled on stop", \testPollThreadCancelled());
        addTestCase("notification not interrupted by cancellation", \testNotificationNotInterrupted());
        addTestCase("checkpoint not interrupted by cancellation", \testCheckpointNotInterrupted());
        addTestCase("shared REST client survives stop", \testSharedRestClient());
        addTestCase("cancel during sleep", \testCancelDuringSleep());
        addTestCase("cancel error does not break shutdown", \testCancelErrorHandling());
        addTestCase("isStopping flag", \testIsStoppingFlag());
        addTestCase("durable checkpoint lifecycle", \testCheckpointLifecycle());
        addTestCase("checkpoint validation and persistence errors", \testCheckpointErrors());
        addTestCase("undeclared stream identity", \testStreamIdentityDefault());
        set_return_value(main());
    }

    testCancelDuringBlockedPoll() {
        SlowWatchDataProvider prov();
        TestObserver obs();

        prov.registerObserver(obs);
        prov.observersReady();

        # Wait for the poll thread to enter pollOnce()
        prov.waitForPollStart();
        assertTrue(prov.poll_started, "poll thread started");
        assertEq(1, prov.poll_counter.getCount(), "pollOnce() entered once");

        # Stop should complete promptly because cancelPollOperation() unblocks the gate
        date start = now_us();
        prov.stopEvents();
        date elapsed = now_us() - start;

        assertTrue(prov.cancel_called, "cancelPollOperation() was called");
        # Should complete in well under 2 seconds (not waiting for poll interval)
        assertTrue(elapsed < 2s, sprintf("shutdown completed promptly (elapsed: %y)", elapsed));
    }

    #! A blocking poll without a cancelPollOperation() override ends when polling is stopped
    testPollThreadCancelled() {
        BlockingWatchDataProvider prov();
        prov.registerObserver(new TestObserver());
        prov.observersReady();
        prov.poll_entered.get(5s);

        prov.stopEvents();
        assertFalse(prov.isActive());
        # the cancellation is not reported as a poll error
        assertEq((), prov.errors);
    }

    #! An observer notification is completed when the polling thread is cancelled during it
    testNotificationNotInterrupted() {
        DeferredWatchDataProvider prov(False);
        BlockingObserver obs();
        prov.registerObserver(obs);
        prov.observersReady();
        int tid = obs.entered.get(5s);

        # the cancellation is delivered while the event is being handled
        assertTrue(cancel_thread(tid, "test"));
        obs.release.push(1);
        prov.stopEvents();
        assertEq(({"n": 1},), obs.handled);
        # the cancellation is raised after the notification, where it can only end the poll
        assertEq((), (select prov.errors, $1.err != "THREAD-CANCELLED"));
    }

    #! A checkpoint is stored completely when the polling thread is cancelled while it is being stored
    testCheckpointNotInterrupted() {
        DeferredWatchDataProvider prov(True);
        prov.registerObserver(new TestObserver());
        prov.observersReady();
        int tid = prov.saving.get(5s);

        assertTrue(cancel_thread(tid, "test"));
        prov.save_release.push(1);
        prov.stopEvents();
        assertEq(({"n": 1},), prov.saved);
    }

    #! A request of the polling thread is cancelled on stop without closing a REST client shared with others
    testSharedRestClient() {
        HttpServer server(<HttpServerOptionInfo>{
            "logger": new Logger("server", LoggerLevel::getLevelError()),
        });
        on_exit server.stop();
        int port = server.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        BlockingRequestHandler handler();
        server.setHandler("block", "", NOTHING, handler);
        server.setDefaultHandler("block", handler);
        on_exit handler.release.push(1);

        RestClientIo rest({"url": "http://localhost:" + port});
        {
            BlockingWatchDataProvider prov(rest);
            prov.registerObserver(new TestObserver());
            prov.observersReady();
            prov.poll_entered.get(5s);
            # the request of the poll is in flight until the polling thread is cancelled
            prov.stopEvents();
            assertEq((), prov.errors);
        }
        # the shared client still works
        assertEq("other", rest.restGet("/other").body);
    }

    testCancelDuringSleep() {
        FastWatchDataProvider prov();
        TestObserver obs();

        prov.registerObserver(obs);
        prov.observersReady();

        # Wait for the poll thread to complete one pollOnce() and enter sleep
        prov.waitForFirstPoll();
        assertTrue(prov.poll_count >= 1, "at least one poll completed");

        # Stop should complete promptly because the condition broadcast wakes the sleep
        date start = now_us();
        prov.stopEvents();
        date elapsed = now_us() - start;

        assertTrue(prov.cancel_called, "cancelPollOperation() was called");
        # Should not wait for the 60s poll interval
        assertTrue(elapsed < 2s, sprintf("shutdown completed promptly (elapsed: %y)", elapsed));
    }

    testCancelErrorHandling() {
        ErrorCancelWatchDataProvider prov();
        TestObserver obs();

        prov.registerObserver(obs);
        prov.observersReady();

        # Wait for poll to start
        prov.waitForPollStart();

        # stopEvents() should not throw even though cancelPollOperation() throws
        prov.stopEvents();
        assertTrue(True, "stopEvents() completed despite cancelPollOperation() throwing");
    }

    testIsStoppingFlag() {
        FastWatchDataProvider prov();
        assertFalse(prov.checkStopping(), "not stopping before start");

        TestObserver obs();
        prov.registerObserver(obs);
        prov.observersReady();
        assertFalse(prov.checkStopping(), "not stopping after start");

        prov.stopEvents();
        assertTrue(prov.checkStopping(), "stopping after stopEvents()");
    }

    testCheckpointLifecycle() {
        CheckpointWatchDataProvider prov();
        hash<auto> saved;
        prov.setCheckpointPersistence({"version": 1, "cursor": 42}, sub (hash<auto> checkpoint) {
            saved = checkpoint;
        });
        assertEq(42, prov.getRestoredCheckpoint().cursor, "checkpoint restored before polling starts");

        prov.save({"version": 1, "cursor": 43});
        assertEq(43, saved.cursor, "replacement checkpoint passed to persistence callback");

        TestObserver obs();
        prov.registerObserver(obs);
        prov.observersReady();
        prov.observersReady();
        assertThrows("WATCH-CHECKPOINT-ERROR", sub () {
            prov.setCheckpointPersistence(NOTHING, sub (hash<auto> checkpoint) {
                # no-op
            });
        });
        prov.stopEvents();
    }

    #! A provider that declares no stream identity leaves the embedder to key on the whole config
    testStreamIdentityDefault() {
        CheckpointWatchDataProvider prov();
        assertNothing(prov.getWatchStreamIdentity());
    }

    testCheckpointErrors() {
        CheckpointWatchDataProvider invalid();
        assertThrows("TEST-CHECKPOINT-ERROR", sub () {
            invalid.setCheckpointPersistence({"version": 2}, sub (hash<auto> checkpoint) {
                # no-op
            });
        });

        CheckpointWatchDataProvider failing();
        failing.setCheckpointPersistence(NOTHING, sub (hash<auto> checkpoint) {
            throw "TEST-PERSISTENCE-ERROR", "checkpoint was not stored";
        });
        assertThrows("TEST-PERSISTENCE-ERROR", sub () {
            failing.save({"version": 1, "cursor": 1});
        });
    }
}
