%modern
%requires DataProvider

#! An app whose action has an option and a field of an option type that describe their validation patterns
module PresentationPatternOwner {
    version = "1.0";
    desc = "provider presentation fixture with validation pattern descriptions";
    author = "Qore Technologies";
    license = "MIT";
    init = sub () {
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": "QoreTestPatternProvider",
            "display_name": "Pattern Provider",
            "short_desc": "Provider with validation pattern descriptions",
            "desc": "Provider whose options describe their validation patterns",
            "presentation_source_locale": "en",
            "groups": (AppGroup::DataTransformation,),
            "logo": "data",
            "logo_mime_type": MimeTypeSvg,
            "logo_file_name": "pattern-provider.svg",
        });

        # a top-level option: the description is read from the field's attributes
        QoreDataField language("language", "Language", new QoreStringDataType());
        language.setAttributes({
            "validation_regex": "^[a-z]{2}$",
            "validation_regex_desc": "a two-letter language code, such as en",
        });
        # a field of an option's type keeps the description in its attributes
        QoreDataField code("code", "Currency code", new QoreStringDataType());
        code.setAttributes({
            "validation_regex": "^[A-Z]{3}$",
            "validation_regex_desc": "a three-letter currency code, such as EUR",
        });
        QoreDataField currency("currency", "Currency", new HashDataType("PatternCurrency", {"code": code}));

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": "QoreTestPatternProvider",
            "path": "/set-language",
            "action": "set-language",
            "display_name": "Set language",
            "short_desc": "Sets the language",
            "desc": "Sets the language and the currency",
            "action_code": DPAT_API,
            "output_type": new QoreHashDataType(),
            "options": DataProviderActionCatalog::getActionOptionFromFields({
                "language": language,
                "currency": currency,
            }),
        });
    };
}
