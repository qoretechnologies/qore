#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright 2026 Qore Technologies, s.r.o. SPDX-License-Identifier: MIT

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires DataProvider

%exec-class DataTypeConstraintsTest

public class DataTypeConstraintsTest inherits QUnit::Test {
    constructor() : Test("DataProvider type constraints", "1.0") {
        addTestCase("numeric constraints", \numericTest());
        addTestCase("string, list, and hash constraints", \collectionTest());
        addTestCase("constraints are set on copies", \copyTest());
        addTestCase("constraints survive descriptions and derived types", \restoreTest());
        addTestCase("union constraints", \unionTest());
        addTestCase("restored types have the original conversions", \conversionTest());
        addTestCase("examples are accepted by their fields", \exampleTest());
        addTestCase("a type known only in its program is restored from its value types", \programTypeTest());
        addTestCase("soft conversions keep the constraints", \softConversionTest());
        addTestCase("soft conversions from strings are checked", \softAcceptanceTest());
        addTestCase("scalar types with a default value", \defaultValueTest());
        addTestCase("a type that always accepts nothing has no mandatory equivalent", \mandatoryAutoTest());
        set_return_value(main());
    }

    #! Returns the type for the given name with the given constraints
    private static AbstractDataProviderType constrained(string name, hash<DataTypeConstraintInfo> constraints) {
        return AbstractDataProviderType::get(name).copyWithConstraints(constraints);
    }

    numericTest() {
        AbstractDataProviderType t = constrained("int", <DataTypeConstraintInfo>{
            "minimum": 1,
            "exclusive_maximum": 10,
        });
        assertEq(1, t.acceptsValue(1));
        assertEq(9, t.acceptsValue(9));
        assertThrows("RUNTIME-TYPE-ERROR", \t.acceptsValue(), 0);
        assertThrows("RUNTIME-TYPE-ERROR", \t.acceptsValue(), 10);

        # decimal multiples are not affected by binary floating-point rounding
        t = constrained("number", <DataTypeConstraintInfo>{"multiple_of": 0.1n});
        assertEq(0.3n, t.acceptsValue(0.3n));
        assertEq(7n, t.acceptsValue(7));
        # a float is compared as the decimal value it prints as
        t.acceptsValue(0.3);
        assertThrows("RUNTIME-TYPE-ERROR", \t.acceptsValue(), 0.35);

        t = constrained("float", <DataTypeConstraintInfo>{"exclusive_minimum": 0, "maximum": 1.5});
        assertEq(1.5, t.acceptsValue(1.5));
        assertThrows("RUNTIME-TYPE-ERROR", \t.acceptsValue(), 0.0);
    }

    collectionTest() {
        AbstractDataProviderType t = constrained("string", <DataTypeConstraintInfo>{
            "min_length": 2,
            "max_length": 4,
            "pattern": "^a",
        });
        assertEq("ab", t.acceptsValue("ab"));
        assertThrows("RUNTIME-TYPE-ERROR", \t.acceptsValue(), "a");
        assertThrows("RUNTIME-TYPE-ERROR", \t.acceptsValue(), "abcde");
        assertThrows("RUNTIME-TYPE-ERROR", \t.acceptsValue(), "bcd");

        # enumerated values are compared as strings
        t = constrained("softstring", <DataTypeConstraintInfo>{"enum_values": ("ab", "1")});
        assertEq("ab", t.acceptsValue("ab"));
        assertEq("1", t.acceptsValue(1));
        assertThrows("TYPE-VALUE-ERROR", \t.acceptsValue(), "abd");

        t = new ListDataType(AbstractDataProviderType::get("softint")).copyWithConstraints(<DataTypeConstraintInfo>{
            "min_items": 1,
            "max_items": 2,
            "unique_items": True,
        });
        assertEq((1, 2), t.acceptsValue((1, 2)));
        assertThrows("RUNTIME-TYPE-ERROR", \t.acceptsValue(), ((),));
        assertThrows("RUNTIME-TYPE-ERROR", \t.acceptsValue(), ((1, 2, 3),));
        # elements are compared after conversion
        assertThrows("RUNTIME-TYPE-ERROR", \t.acceptsValue(), ((1, "1"),));

        t = new SoftListDataType(AbstractDataProviderType::get("string")).copyWithConstraints(
            <DataTypeConstraintInfo>{"max_items": 1});
        assertEq(("x",), t.acceptsValue("x"));
        assertThrows("RUNTIME-TYPE-ERROR", \t.acceptsValue(), (("x", "y"),));

        HashDataType h("QoreTestHash");
        h.setDefaultOtherFieldType(AbstractDataProviderTypeMap."auto");
        t = h.copyWithConstraints(<DataTypeConstraintInfo>{"min_properties": 1, "max_properties": 1});
        assertEq({"a": 1}, t.acceptsValue({"a": 1}));
        assertThrows("RUNTIME-TYPE-ERROR", \t.acceptsValue(), {});
        assertThrows("RUNTIME-TYPE-ERROR", \t.acceptsValue(), {"a": 1, "b": 2});
    }

    copyTest() {
        AbstractDataProviderType shared = AbstractDataProviderTypeMap."int";
        AbstractDataProviderType t = shared.copyWithConstraints(<DataTypeConstraintInfo>{"minimum": 5});
        assertEq(NOTHING, shared.getConstraints());
        assertEq(1, shared.acceptsValue(1));
        assertThrows("RUNTIME-TYPE-ERROR", \t.acceptsValue(), 1);
        # no constraints: the type itself
        assertTrue(shared == shared.copyWithConstraints());
    }

    restoreTest() {
        AbstractDataProviderType t = constrained("softint", <DataTypeConstraintInfo>{"maximum": 5});
        hash<DataTypeInfo> info = t.getInfo();
        assertEq(5n, info.constraints.maximum);

        # restored from its description
        AbstractDataProviderType restored = AbstractDataProviderType::get(info);
        assertEq(t.getConstraints(), restored.getConstraints());
        assertThrows("RUNTIME-TYPE-ERROR", \restored.acceptsValue(), 6);

        # derived types keep the constraints
        foreach AbstractDataProviderType derived in ((t.getOrNothingType(), t.getOrNothingType().getMandatoryType(),
                AbstractDataProviderType::get("int").copyWithConstraints(t.getConstraints()).getSoftType())) {
            assertEq(t.getConstraints(), derived.getConstraints(), derived.getName());
            assertThrows("RUNTIME-TYPE-ERROR", \derived.acceptsValue(), 6);
        }

        # a class-backed named type is copied, not modified
        AbstractDataProviderType email = AbstractDataProviderType::get(EmailType.copyWithConstraints(
            <DataTypeConstraintInfo>{"max_length": 20}).getInfo());
        assertEq(NOTHING, EmailType.getConstraints());
        assertThrows("RUNTIME-TYPE-ERROR", \email.acceptsValue(), "someone.with.a.long.name@example.com");
    }

    unionTest() {
        list<AbstractDataProviderType> alternatives = (
            AbstractDataProviderType::get("softstring"),
            AbstractDataProviderType::get("softint"),
        );
        QoreUnionDataType any(alternatives);
        # the first alternative accepting the value converts it
        assertEq("1", any.acceptsValue(1));

        AbstractDataProviderType one = any.copyWithConstraints(<DataTypeConstraintInfo>{"exclusive_union": True});
        # values match the alternative of their own kind
        assertEq("x", one.acceptsValue("x"));
        assertEq(1, one.acceptsValue(1));
        # restored from its description
        AbstractDataProviderType restored = AbstractDataProviderType::get(one.getInfo());
        assertEq(1, restored.acceptsValue(1));
        assertEq("x", restored.acceptsValue("x"));
        # exactly one: two alternatives of the same kind both match
        AbstractDataProviderType two = (new QoreUnionDataType((AbstractDataProviderType::get("string"),
            AbstractDataProviderType::get("string")))).copyWithConstraints(
            <DataTypeConstraintInfo>{"exclusive_union": True});
        assertThrows("RUNTIME-TYPE-ERROR", \two.acceptsValue(), "x");

        HashDataType cat("Cat");
        cat.addField(new QoreDataField({"name": "kind", "type": AbstractDataProviderTypeMap."string"}));
        cat.addField(new QoreDataField({"name": "meows", "type": AbstractDataProviderTypeMap."bool"}));
        HashDataType dog("Dog");
        dog.addField(new QoreDataField({"name": "kind", "type": AbstractDataProviderTypeMap."string"}));
        dog.addField(new QoreDataField({"name": "barks", "type": AbstractDataProviderTypeMap."bool"}));
        AbstractDataProviderType pet = (new QoreUnionDataType((cat, dog))).copyWithConstraints(
            <DataTypeConstraintInfo>{"discriminator": "kind", "discriminator_mapping": {"cat": 0, "dog": 1}});
        pet = AbstractDataProviderType::get(pet.getInfo());
        assertEq({"kind": "dog", "barks": True}, pet.acceptsValue({"kind": "dog", "barks": True}));
        # the discriminator selects the alternative, even if another would accept the value
        assertThrows("MISSING-VALUE-ERROR", \pet.acceptsValue(), {"kind": "dog", "meows": True});
        assertThrows("RUNTIME-TYPE-ERROR", \pet.acceptsValue(), {"kind": "fish"});
        assertThrows("RUNTIME-TYPE-ERROR", \pet.acceptsValue(), {"meows": True});
    }

    conversionTest() {
        # booleans validate strings
        AbstractDataProviderType b = AbstractDataProviderType::get("softbool");
        assertEq(True, b.acceptsValue("1"));
        assertThrows("RUNTIME-TYPE-ERROR", \b.acceptsValue(), "x");
        AbstractDataProviderType ob = AbstractDataProviderType::get("*softbool");
        assertEq(NOTHING, ob.acceptsValue(""));

        # a mandatory soft list accepts no value and does not describe itself as accepting one
        SoftListDataType mandatory(AbstractDataProviderType::get("string"));
        assertThrows("RUNTIME-TYPE-ERROR", \mandatory.acceptsValue(), NOTHING);
        assertFalse(mandatory.getInfo().types_accepted.contains("nothing"));
        SoftListDataType optional(AbstractDataProviderType::get("string"), True);
        assertEq(NOTHING, optional.acceptsValue(NOTHING));

        # a union's example is an example of its first alternative, which it accepts unconverted
        QoreUnionDataType u((new SoftListDataType(AbstractDataProviderType::get("softstring")),
            AbstractDataProviderType::get("softstring")));
        auto example = u.getExampleValue();
        assertEq(example, u.acceptsValue(example));

        # a hash type without fields and without other fields is restored as such
        HashDataType closed("Closed");
        closed.setDefaultOtherFieldType();
        AbstractDataProviderType restored = AbstractDataProviderType::get(closed.getInfo());
        assertEq(NOTHING, restored.getInfo().default_field_type_info);
    }

    programTypeTest() {
        # a description of a type based on a custom Qore type that only its own program knows
        hash<DataTypeInfo> info = <DataTypeInfo>{
            "name": "workflow",
            "display_name": "Workflow",
            "short_desc": "A workflow",
            "desc": "A workflow",
            "base_type": "workflow",
            "mandatory": True,
            "types_accepted": ("string", "int", "float"),
            "types_returned": ("string",),
            "unique_key": "1",
            "recursive": False,
        };
        AbstractDataProviderType t = AbstractDataProviderType::get(info);
        assertEq("5", t.acceptsValue(5));
        assertThrows("RUNTIME-TYPE-ERROR", \t.acceptsValue(), NOTHING);
        # the restored type is named and presented as described, not after its Qore value type
        assertEq("workflow", t.getName());
        assertEq("Workflow", t.getDisplayName());
        assertEq("A workflow", t.getShortDescription());
        # it accepts what its soft value type accepts, which may be more than the description lists
        assertEq(info{"name", "types_returned", "mandatory"}, t.getInfo(){"name", "types_returned", "mandatory"},
            "the restored type describes itself by the described name and value type");

        # the "or nothing" form keeps its name too
        AbstractDataProviderType opt_t = AbstractDataProviderType::get(cast<hash<DataTypeInfo>>(info + {
            "name": "*workflow",
            "mandatory": False,
            "types_accepted": ("string", "int", "float", "nothing"),
            "types_returned": ("string", "nothing"),
        }));
        assertEq("*workflow", opt_t.getName());
        assertNothing(opt_t.acceptsValue(NOTHING));
        assertEq("5", opt_t.acceptsValue(5));

        # without presentation text the name is also its display name
        AbstractDataProviderType bare_t = AbstractDataProviderType::get(
            cast<hash<DataTypeInfo>>(info - ("display_name", "short_desc", "desc")));
        assertEq("workflow", bare_t.getName());
        assertEq("workflow", bare_t.getDisplayName());

        # a type that accepts only its own value type is not a soft type
        info.types_accepted = ("string",);
        t = AbstractDataProviderType::get(info);
        assertThrows("RUNTIME-TYPE-ERROR", \t.acceptsValue(), 5);

        # a description returning several value types cannot be restored
        info.types_returned = ("string", "int");
        assertThrows("TYPE-ERROR", \AbstractDataProviderType::get(), (info,));
    }

    exampleTest() {
        QoreDataField choice({"name": "interval", "type": AbstractDataProviderTypeMap."string",
            "allowed_values": (<AllowedValueInfo>{"value": "day"}, <AllowedValueInfo>{"value": "week"})});
        assertEq("day", choice.getExampleValue());
        foreach AbstractDataProviderType t in ((EmailType, UriType, UuidType, HostnameType, Ipv4Type, Ipv6Type,
                PhoneType)) {
            auto example = t.getExampleValue();
            assertEq(example, t.acceptsValue(example), t.getName());
        }
    }

    #! The soft equivalent of each scalar type class describes and enforces the constraints of the type
    softConversionTest() {
        hash<DataTypeConstraintInfo> length = <DataTypeConstraintInfo>{"max_length": 4};
        hash<DataTypeConstraintInfo> bound = <DataTypeConstraintInfo>{"maximum": 10};
        hash<DataTypeConstraintInfo> choice = <DataTypeConstraintInfo>{"enum_values": ("a", "b")};
        # each type, its constraints, and, if the constraints apply to the values it accepts, a value that the soft
        # type accepts but the constraints do not
        list<hash<auto>> cases = (
            {"type": new QoreStringDataType(), "constraints": length, "value": 12345},
            {"type": new QoreStringOrNothingDataType(), "constraints": length, "value": "12345"},
            {"type": AbstractDataProviderType::get("*string"), "constraints": choice, "value": "c",
                "err": "TYPE-VALUE-ERROR"},
            {"type": new QoreIntDataType(), "constraints": bound, "value": "11"},
            {"type": new QoreIntOrNothingDataType(), "constraints": bound, "value": 11.0},
            {"type": new QoreFloatDataType(), "constraints": bound, "value": "10.5"},
            {"type": new QoreFloatOrNothingDataType(), "constraints": bound, "value": 11},
            {"type": new QoreNumberDataType(), "constraints": bound, "value": "11"},
            {"type": new QoreNumberOrNothingDataType(), "constraints": bound, "value": "10.5"},
            {"type": new QoreSignedByteDataType(), "constraints": bound, "value": "11"},
            {"type": new QoreUnsignedByteDataType(), "constraints": bound, "value": "11"},
            {"type": new QoreSignedByteOrNothingDataType(), "constraints": bound, "value": "11"},
            {"type": new QoreUnsignedByteOrNothingDataType(), "constraints": bound, "value": "11"},
            {"type": new QoreBoolDataType(), "constraints": choice},
            {"type": new QoreBoolOrNothingDataType(), "constraints": choice},
            {"type": new QoreDateDataType(), "constraints": choice},
            {"type": new QoreDateOrNothingDataType(), "constraints": choice},
            {"type": new QoreBinaryDataType(), "constraints": choice},
            {"type": new QoreBinaryOrNothingDataType(), "constraints": choice},
        );
        foreach hash<auto> c in (cases) {
            AbstractDataProviderType t = c.type.copyWithConstraints(c.constraints);
            AbstractDataProviderType soft = t.getSoftType();
            string label = sprintf("%s %s -> %s %s", t.className(), t.getName(), soft.className(), soft.getName());
            assertEq(c.constraints, soft.getConstraints(), label);
            assertEq(c.constraints, soft.getInfo().constraints, label);
            if (c.hasKey("value")) {
                assertThrows(c.err ?? "RUNTIME-TYPE-ERROR", \soft.acceptsValue(), (c.value,), label);
            }
            # the conversion does not change the original type
            assertEq(NOTHING, c.type.getConstraints(), label);
        }

        # a type without constraints has a soft equivalent without constraints
        assertEq(NOTHING, new QoreStringDataType().getSoftType().getConstraints());
    }

    #! A soft type that converts a value from a string checks the converted value against its constraints
    softAcceptanceTest() {
        hash<DataTypeConstraintInfo> bound = <DataTypeConstraintInfo>{"maximum": 10};
        foreach AbstractDataProviderType t in ((new QoreSoftFloatDataType(), new QoreSoftNumberDataType(),
                new QoreSoftIntDataType())) {
            AbstractDataProviderType constrained = t.copyWithConstraints(bound);
            assertEq(10n, number(constrained.acceptsValue("10")), t.getName());
            assertThrows("RUNTIME-TYPE-ERROR", \constrained.acceptsValue(), "10.5", t.getName());
        }
        # a number format is used to convert the string, then the value is checked
        AbstractDataProviderType formatted = new QoreSoftFloatDataType({"number.format": ".,"})
            .copyWithConstraints(bound);
        assertEq(9.5, formatted.acceptsValue("9,5"));
        assertThrows("RUNTIME-TYPE-ERROR", \formatted.acceptsValue(), "10,5");

        hash<DataTypeConstraintInfo> choice = <DataTypeConstraintInfo>{"enum_values": ("1",)};
        AbstractDataProviderType flag = new QoreSoftBoolDataType().copyWithConstraints(choice);
        assertEq(True, flag.acceptsValue("1"));
        assertThrows("TYPE-VALUE-ERROR", \flag.acceptsValue(), "0");
        AbstractDataProviderType bytes = new QoreSoftBinaryDataType().copyWithConstraints(
            <DataTypeConstraintInfo>{"enum_values": (binary("ab").toString(),)});
        assertEq(binary("ab"), bytes.acceptsValue("ab"));
        assertThrows("TYPE-VALUE-ERROR", \bytes.acceptsValue(), "cd");
        AbstractDataProviderType day = new QoreSoftDateDataType().copyWithConstraints(
            <DataTypeConstraintInfo>{"enum_values": (2026-10-25.toString(),)});
        assertEq(2026-10-25, day.acceptsValue("2026-10-25"));
        assertThrows("TYPE-VALUE-ERROR", \day.acceptsValue(), "2026-10-26");
    }

    #! A scalar type has the default value it is created with, also when restored from its description
    defaultValueTest() {
        foreach hash<auto> c in ((
                {"type": StringType, "value": "draft"},
                {"type": SoftStringType, "value": "draft"},
                {"type": BoolType, "value": True},
                {"type": IntType, "value": 7},
            )) {
            AbstractDataProviderType t = AbstractDataProviderType::get(c.type, NOTHING, NOTHING, c.value);
            assertEq(c.value, t.getDefaultValue(), c.type.getName());
            assertEq(c.value, t.acceptsValue(NOTHING), c.type.getName());
            AbstractDataProviderType restored = AbstractDataProviderType::get(t.getInfo());
            assertEq(c.value, restored.getDefaultValue(), c.type.getName());
        }
    }

    #! An auto type accepts nothing, so its "mandatory" equivalent is itself, described as it is restored
    mandatoryAutoTest() {
        QoreDataType any(AutoType);
        AbstractDataProviderType mandatory = any.getMandatoryType();
        assertTrue(any == mandatory);
        hash<DataTypeInfo> info = mandatory.getInfo();
        assertFalse(info.mandatory);
        assertEq(NOTHING, info.supported_options);
        hash<DataTypeInfo> restored = AbstractDataProviderType::get(info).getInfo();
        assertEq(info.supported_options, restored.supported_options);
        # a type with a mandatory form still has one
        AbstractDataProviderType optional_int = AbstractDataProviderType::get(IntOrNothingType);
        assertTrue(optional_int.getMandatoryType().isMandatory());
    }
}
