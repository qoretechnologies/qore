#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires DataProvider

%exec-class DataTypeRoundTripTest

#! A class that the DataProvider module cannot resolve by its name
class RoundTripObjectClass {
}

#! A class that inherits it
class RoundTripObjectSubclass inherits RoundTripObjectClass {
}

#! A Type whose name is not a Qore type name, as a host's wrapper type can have
class RoundTripWrapperType inherits Type {
    private {
        string wrapper_name;
    }

    constructor(string name, string base_type) : Type(base_type) {
        wrapper_name = name;
    }

    string getName() {
        return wrapper_name;
    }
}

#! Tests that a type restored from its description with AbstractDataProviderType::get() has the same description
/** The index of data providers stores option types as their descriptions, and a reader that needs a type object
    restores it from the description; a type that is not restored as it was described changes what the reader
    accepts and shows
*/
public class DataTypeRoundTripTest inherits QUnit::Test {
    constructor() : Test("DataTypeRoundTripTest", "1.0") {
        addTestCase("a recursive type is restored as a cycle", \recursiveTest());
        addTestCase("an unregistered type path is kept", \pathTest());
        addTestCase("a soft list is restored as a soft list whatever its name", \softListTest());
        addTestCase("a strict list named like a soft list is restored as a strict list", \strictListTest());
        addTestCase("a description written by an earlier version is restored by the list's name", \legacySoftListTest());
        addTestCase("a Qore soft list type is restored as get(Type) returns it", \qoreSoftListTest());
        addTestCase("the base type of a Type subclass with its own name is the Qore base type", \wrapperTypeTest());
        addTestCase("a named scalar type keeps its name and its softness", \namedScalarTest());
        addTestCase("a class-backed named type keeps its options", \classBackedOptionsTest());
        addTestCase("an object type of a class that cannot be resolved keeps its class", \objectClassTest());
        addTestCase("an empty constraints hash is no constraints", \emptyConstraintsTest());
        addTestCase("a type graph description is restored with the same description", \graphRoundTripTest());

        set_return_value(main());
    }

    #! The first difference between two descriptions, ignoring the unique keys, which identify objects
    private static *string diff(auto a, auto b, string path = "") {
        if (a.typeCode() == NT_HASH && b.typeCode() == NT_HASH) {
            foreach string key in (keys (a + b)) {
                if (key == "unique_key") {
                    continue;
                }
                if (*string rv = DataTypeRoundTripTest::diff(a{key}, b{key}, path + "." + key)) {
                    return rv;
                }
            }
            return;
        }
        if (a.typeCode() == NT_LIST && b.typeCode() == NT_LIST && a.size() == b.size()) {
            if (path =~ /\.types_(accepted|returned)$/) {
                return sort(a) == sort(b) ? NOTHING : sprintf("%s: %y -> %y", path.substr(1), a, b);
            }
            for (int i = 0; i < a.size(); ++i) {
                if (*string rv = DataTypeRoundTripTest::diff(a[i], b[i], sprintf("%s[%d]", path, i))) {
                    return rv;
                }
            }
            return;
        }
        return a === b ? NOTHING : sprintf("%s: %y -> %y", path.val() ? path.substr(1) : "<root>", a, b);
    }

    #! Checks that the type restored from the description of a type has the same description, in both forms
    private checkRoundTrip(string label, AbstractDataProviderType t) {
        hash<DataTypeInfo> info = t.getInfo();
        assertNothing(diff(info, AbstractDataProviderType::get(info).getInfo()), label);
        hash<DataTypeGraphInfo> graph = t.getInfoGraph();
        assertEq(graph, AbstractDataProviderType::getFromGraph(graph).getInfoGraph(), label + " (type graph)");
    }

    recursiveTest() {
        HashDataType node("Node");
        node.addField(new QoreDataField("name", NOTHING, AbstractDataProviderTypeMap."string"));
        node.addField(new QoreDataField({"name": "children", "type": new SoftListDataType(node, True)}));
        checkRoundTrip("recursive hash", node);
        AbstractDataProviderType restored = AbstractDataProviderType::get(node.getInfo());
        assertEq(restored, restored.getFields().children.getType().getElementType(),
            "the recursion marker is the restored type");
    }

    pathTest() {
        QoreStringDataTypeBase t(StringType);
        string path = "provider-schema-v1/app/QQ/action/QQ/role/b3B0aW9u/option/QQ/type/c3RyaW5n";
        t.setPath(path);
        checkRoundTrip("unregistered path", t);
        assertEq(path, AbstractDataProviderType::get(t.getInfo()).getPath());
        # a registered path is the registered type
        AbstractDataProviderType registered = AbstractDataProviderType::get("string");
        hash<DataTypeInfo> info = registered.getInfo();
        assertNothing(info.path);
    }

    softListTest() {
        SoftListDataType t("ObjectIdListType", AbstractDataProviderTypeMap."int");
        checkRoundTrip("soft list with its own name", t);
        hash<DataTypeInfo> info = t.getInfo();
        assertTrue(info.soft_list);
        assertEq("SoftListDataType", AbstractDataProviderType::get(info).className());
        assertEq((1,), AbstractDataProviderType::get(info).acceptsValue(1), "a single value is converted");
    }

    strictListTest() {
        ListDataType t("softlist<int>", AbstractDataProviderTypeMap."int");
        checkRoundTrip("strict list named softlist", t);
        hash<DataTypeInfo> info = t.getInfo();
        assertFalse(info.soft_list);
        assertEq("ListDataType", AbstractDataProviderType::get(info).className());
    }

    legacySoftListTest() {
        hash<DataTypeInfo> info = new SoftListDataType(AbstractDataProviderTypeMap."int").getInfo();
        remove info.soft_list;
        assertEq("SoftListDataType", AbstractDataProviderType::get(info).className(), "named softlist<int>");
        info = new ListDataType("ids", AbstractDataProviderTypeMap."int").getInfo();
        remove info.soft_list;
        assertEq("ListDataType", AbstractDataProviderType::get(info).className(), "named otherwise");
    }

    qoreSoftListTest() {
        AbstractDataProviderType t = AbstractDataProviderType::get(new Type("softlist<string>"));
        checkRoundTrip("Qore softlist type", t);
        AbstractDataProviderType restored = AbstractDataProviderType::get(t.getInfo());
        assertEq((), restored.acceptsValue(NOTHING), "no value is an empty list, as for the Qore type");
        assertEq(("x",), restored.acceptsValue("x"));
    }

    wrapperTypeTest() {
        AbstractDataProviderType t = AbstractDataProviderType::get(new RoundTripWrapperType("workflow", "softstring"));
        assertEq("string", t.getBaseTypeName());
        assertEq("workflow", t.getName());
        checkRoundTrip("wrapper Type name", t);
    }

    namedScalarTest() {
        checkRoundTrip("named softstring", new QoreStringDataTypeBase(SoftStringType, NOTHING, NOTHING, NOTHING,
            <NameDescInfo>{"name": "workflow"}));
        checkRoundTrip("named string", new QoreStringDataTypeBase(StringType, NOTHING, NOTHING, NOTHING,
            <NameDescInfo>{"name": "workflow"}));
        checkRoundTrip("named softint", AbstractDataProviderType::get(SoftIntType, NOTHING, NOTHING, NOTHING,
            <NameDescInfo>{"name": "count"}));
        AbstractDataProviderType restored = AbstractDataProviderType::get(AbstractDataProviderType::get(SoftIntType,
            NOTHING, NOTHING, NOTHING, <NameDescInfo>{"name": "count"}).getInfo());
        assertEq("count", restored.getName());
        assertEq(1, restored.acceptsValue("1"), "a soft type stays soft");
    }

    classBackedOptionsTest() {
        FileDataType f({"accept": ("application/pdf",)});
        checkRoundTrip("file type with options", f);
        AbstractDataProviderType restored = AbstractDataProviderType::get(f.getInfo());
        assertEq(("application/pdf",), restored.getOptions().accept);
        # the shared type is not changed
        assertNothing(AbstractDataProviderType::get(new FileDataType().getInfo()).getOptions().accept);
    }

    objectClassTest() {
        foreach string name in ("object<RoundTripObjectClass>", "*object<RoundTripObjectClass>") {
            AbstractDataProviderType t = AbstractDataProviderType::get(new Type(name));
            checkRoundTrip(name, t);
        }
        AbstractDataProviderType restored = AbstractDataProviderType::get(AbstractDataProviderType::get(
            new Type("object<RoundTripObjectClass>")).getInfo());
        assertEq("ObjectClassNameDataType", restored.className());
        RoundTripObjectSubclass obj();
        assertEq(obj, restored.acceptsValue(obj), "an object of a subclass is accepted");
        assertThrows("RUNTIME-TYPE-ERROR", \restored.acceptsValue(), new Mutex());
        assertThrows("RUNTIME-TYPE-ERROR", \restored.acceptsValue(), NOTHING);
        assertNothing(restored.getOrNothingType().acceptsValue(NOTHING));
    }

    emptyConstraintsTest() {
        AbstractDataProviderType t = AbstractDataProviderType::get("*softstring")
            .copyWithConstraints(<DataTypeConstraintInfo>{"enum_values": ("png", "jpeg")});
        AbstractDataProviderType unconstrained = t.copyWithConstraints(t.getConstraints() - "enum_values");
        assertNothing(unconstrained.getConstraints());
        checkRoundTrip("empty constraints", unconstrained);
    }

    graphRoundTripTest() {
        HashDataType node("node");
        node.addField(new QoreDataField("name", "the name", StringType));
        node.addField(new QoreDataField("parent", "the parent", node.getOrNothingType()));
        node.addField(new QoreDataField("children", "the children", new ListDataType("list<node>", node)));
        node.addField(new QoreDataField("ids", "the ids", new SoftListDataType("ids", AbstractDataProviderTypeMap."int")));
        node.addField(new QoreDataField("alt", "a union", new QoreUnionDataType((node,
            AbstractDataProviderTypeMap."string"))));
        hash<DataTypeGraphInfo> graph = node.getInfoGraph();
        assertEq(graph, AbstractDataProviderType::getFromGraph(graph).getInfoGraph());
        # the restored union refers to the restored type
        AbstractDataProviderType restored = AbstractDataProviderType::getFromGraph(graph);
        assertEq(restored, cast<QoreUnionDataType>(restored.getFields().alt.getType()).getUnionTypes()[0]);
    }
}
