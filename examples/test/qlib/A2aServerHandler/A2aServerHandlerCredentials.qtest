#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires json
%requires QUnit
%requires HttpServer
%requires HttpServerUtil
%requires Logger
%requires Mime
%requires A2aClient
%requires A2aServerHandler

%exec-class A2aServerHandlerCredentialsTest

#! a hang guard only, never a timing assertion
const HangGuard = 20s;

#! A method of a restricted Program that a trusted A2A handler calls with the request context gets it without its
#! credentials (qore#7303)
/** The method gets the context without the \c Authorization and \c Cookie fields and the raw \c Authorization value,
    with the handler's keys of the request (the A2A version of the request, \c a2a_version); a method of trusted code
    gets the request as the server has it
*/
class A2aServerHandlerCredentialsTest inherits QUnit::Test {
    public {
        #! the tenant's code: a method that records what of the credentials of the request it saw
        const TenantSource = "%modern
string sub seen(hash<auto> cx) {
    return sprintf(\"cx.auth=%y authorization=%y cookie=%y raw_authorization=%y logger=%y method=%y a2a_version=%y\",
        exists cx.auth, exists cx.hdr.authorization, exists cx.hdr.cookie,
        exists cx.\"header-info\".\"headers-raw\".Authorization, cx.hasKey(\"logger\"), cx.method, cx.a2a_version);
}
code sub get_method(Queue q) {
    return auto sub (hash<auto> cx) { q.push(seen(cx)); return 1; };
}
";

        const AgentCard = {
            "name": "CredentialsAgent",
            "description": "an agent with a method of restricted code",
            "url": "http://localhost",
            "version": "1.0",
            "capabilities": {"streaming": False, "pushNotifications": False},
            "defaultInputModes": ("text/plain",),
            "defaultOutputModes": ("text/plain",),
            "skills": (),
        };

        #! the handler's keys of the request, which restricted code keeps
        const Kept = " method=\"probe\" a2a_version=\"" + A2aVersionV10 + "\"";

        #! what the method of a restricted Program gets
        const Filtered = "cx.auth=False authorization=False cookie=False raw_authorization=False logger=False" + Kept;

        #! what trusted code gets
        const Raw = "cx.auth=True authorization=True cookie=True raw_authorization=True logger=True" + Kept;
    }

    constructor() : Test("A2aServerHandlerCredentialsTest", "1.0", \ARGV) {
        addTestCase("a method of a restricted Program", \restrictedTest());
        addTestCase("a method of a Program without a sandbox", \trustedTest());
        set_return_value(main());
    }

    #! returns the tenant's Program with the given sandbox
    private Program getTenant(*SandboxManager sm) {
        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        if (sm) {
            p.setSandboxManager(sm);
        }
        p.parse(TenantSource, "tenant");
        return p;
    }

    #! calls the method of the Program with credentials; returns what it saw
    private string call(Program p) {
        Queue q();
        A2aServerHandler handler(new Logger("a2a", LoggerLevel::getLevelInfo()), AgentCard);
        handler.addMethod("probe", p.callFunction("get_method", q), "probe", "probe", NOTHING, NOTHING, True);
        HttpServer server(<HttpServerOptionInfo>{});
        on_exit server.stop();
        server.setDefaultHandler("a2a", handler);
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        server.waitForAsyncIo();
        HTTPClient hc({"url": sprintf("http://127.0.0.1:%d", port), "timeout": HangGuard});
        on_exit hc.disconnect();
        hash<auto> rv = parse_json(hc.post("/", make_json({"jsonrpc": "2.0", "id": 1, "method": "probe",
            "params": ()}), {
                "Content-Type": MimeTypeJson,
                A2aVersionHeader: A2aVersionV10,
                "Authorization": "Bearer secret",
                "Cookie": "session=secret",
            }));
        assertEq(1, rv.result, "the method is called");
        return q.get(HangGuard);
    }

    restrictedTest() {
        # the default sandbox does not trust its code
        assertEq(Filtered, call(getTenant(new SandboxManager())), "the method of a restricted Program");
    }

    trustedTest() {
        assertEq(Raw, call(getTenant()), "the method of a Program without a sandbox");
    }
}
