%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires Mime

%exec-class MimeTest

public class MimeTest inherits QUnit::Test {
    private {
        string testString = "This is a test: æéìœü";

        string printableEncoded = "This is a test: =C3=A6=C3=A9=C3=AC=C5=93=C3=BC";
        string base64Encoded = "VGhpcyBpcyBhIHRlc3Q6IMOmw6nDrMWTw7w=";
        string headerWordQEncoded = "=?UTF-8?Q?This_is_a_test:_=C3=A6=C3=A9=C3=AC=C5=93=C3=BC?=";
        string headerWordBEncoded = "=?UTF-8?B?VGhpcyBpcyBhIHRlc3Q6IMOmw6nDrMWTw7w=?=";

        const UrlEncodingSource = "this,is!a\"test\"&it really is$-_.*'()";
        const UrlEncodingTarget = "this,is!a%22test%22%26it%20really%20is$-_.*'()";

        const FormDataBoundary = "---------------------------735323031399963166993862150";
        const FormDataBody = "-----------------------------735323031399963166993862150\r
Content-Disposition: form-data; name=\"text1\"\r
\r
text default\r
-----------------------------735323031399963166993862150\r
Content-Disposition: form-data; name=\"text2\"\r
\r
aωb\r
-----------------------------735323031399963166993862150\r
Content-Disposition: form-data; name=\"file1\"; filename=\"a.txt\"\r
Content-Type: text/plain\r
\r
Content of a.txt.\r
\r
-----------------------------735323031399963166993862150\r
Content-Disposition: form-data; name=\"file2\"; filename=\"a.html\"\r
Content-Type: text/html\r
\r
<!DOCTYPE html><title>Content of a.html.</title>\r
\r
-----------------------------735323031399963166993862150\r
Content-Disposition: form-data; name=\"file3\"; filename=\"binary\"\r
Content-Type: application/octet-stream\r
\r
aωb\r
-----------------------------735323031399963166993862150--\r
";

        #! a multipart body whose opening delimiter starts at byte zero
        const DelimiterBody = "--edge\r\nContent-Type: text/plain\r\n\r\none\r\n"
            "--edge\r\nContent-Type: text/plain\r\n\r\ntwo\r\n--edge--\r\n";

        #! a multipart body with a base64-encoded binary part
        const BinaryPartBody = "--edge\r\nContent-Type: application/octet-stream\r\n"
            "Content-Transfer-Encoding: base64\r\n\r\nAP8=\r\n--edge--\r\n";

        const MimeEncodingTestValues = (
            "testing-!@#$%^&*()+={}|[]:\"';,./<>?",
            "hi - hellö",
        );
    }

    constructor() : Test("MimeTest", "1.0") {
        addTestCase("text tests", \textTests());
        addTestCase("json tests", \jsonTests());
        addTestCase("issue 2936", \issue2936());
        addTestCase("mime type from ext", \mimeTypeTest());
        addTestCase("new file extensions", \newFileExtensionsTest());
        addTestCase("Printable test", \printableTest());
        addTestCase("Base64 test", \base64Test());
        addTestCase("Header word q test", \wordQTest());
        addTestCase("Header word b test", \wordBTest());
        addTestCase("urlencoding", \urlEncodingTest());
        addTestCase("form data", \formDataTest());
        addTestCase("RFC 2046 multipart boundary parameters", \boundaryParameterTest());
        addTestCase("form data has no MIME preamble", \formDataNoPreambleTest());
        addTestCase("form data field content types", \formDataFieldContentTypeTest());
        addTestCase("form data repeated field names", \formDataRepeatedPartTest());
        addTestCase("mime_parse_form_urlencoded_string", \parseFormUrlencodedTest());
        addTestCase("transfer encoding", \transferEncodingTest());
        addTestCase("MultiPartMixedMessage", \multiPartMixedTest());
        addTestCase("MultiPartAlternativeMessage", \multiPartAlternativeTest());
        addTestCase("MultiPartRelatedMessage", \multiPartRelatedTest());
        addTestCase("MultiPartDigestMessage", \multiPartDigestTest());
        addTestCase("MultiPartByteRangesMessage", \multiPartByteRangesTest());
        addTestCase("MultiPartSignedMessage", \multiPartSignedTest());
        addTestCase("MultiPartEncryptedMessage", \multiPartEncryptedTest());
        addTestCase("MultiPartMessageMessage", \multiPartMessageTest());
        addTestCase("yaml MIME types", \yamlMimeTypesTest());
        addTestCase("RFC 2046 delimiter lines", \parseBodyDelimiterTest());
        addTestCase("multipart part headers", \parseBodyHeaderTest());
        addTestCase("nested multipart bodies", \parseBodyNestedTest());
        addTestCase("part header case variants", \partHeaderCaseTest());
        addTestCase("MIME parameter value quoting", \quoteParameterValueTest());
        addTestCase("RFC 2387 multipart/related header", \multiPartRelatedHeaderTest());

        # Return for compatibility with test harness that checks return value.
        set_return_value(main());
    }

    boundaryParameterTest() {
        list<string> boundaries = ("a", "gc0pJq0M:08jU534c0p", "space and '()+_,./:=?-",
            sprintf("%070d", 1), MultiPartMessage::getBoundary());
        foreach string boundary in (boundaries) {
            MultiPartFormDataMessage msg(boundary);
            msg.addPart("invoice 5433", "text");
            hash<MessageInfo> serialized = msg.getMsgAndHeaders();
            assertEq("multipart/form-data; boundary=\"" + boundary + "\"",
                serialized.hdr."Content-Type");
            assertEq("--" + boundary + "\r\n", serialized.body.substr(0, boundary.size() + 4).toString());
            assertEq("\r\n--" + boundary + "--", serialized.body.substr(-boundary.size() - 6).toString());
            hash<string, hash<FormDataMessageInfo>> parsed = MultiPartFormDataMessage::parseMessage(
                serialized.hdr."Content-Type", serialized.body.toString());
            assertEq("invoice 5433", parsed.text.body);
        }
        foreach string boundary in ("", "trailing ", "bad\r\nheader", "line\n", "tab\t", "quote\"",
                "back\\slash", "non-ascii-é", sprintf("%071d", 1)) {
            assertThrows("MULTIPART-BOUNDARY-ERROR", sub () { new MultiPartFormDataMessage(boundary); });
        }
    }

    textTests() {
        assertTrue(is_mime_text(MimeTypeHtml));
        assertTrue(is_mime_text(MimeTypeCsv));
        assertTrue(is_mime_text(MimeTypeSoapXml));
        assertTrue(is_mime_text(MimeTypeFormUrlEncoded));
        assertTrue(is_mime_text(MimeTypeSvg));
        assertTrue(is_mime_text("application/x-texinfo"));
        assertTrue(is_mime_text("application/x-tcl"));
        assertTrue(is_mime_text("application/x-tex"));
        assertTrue(is_mime_text("application/x-texinfo"));
        assertTrue(is_mime_text("application/wsdl+xml"));
        assertTrue(is_mime_text("application/x-csh"));
        assertTrue(is_mime_text("application/srgs"));

        assertFalse(is_mime_text(MimeTypeOctetStream));
        assertFalse(is_mime_text(MimeTypeMultipartFormData));
        assertFalse(is_mime_text("audio/x-aiff"));
        assertFalse(is_mime_text("video/x-msvideo"));
        assertFalse(is_mime_text("application/mac-compactpro"));
        assertFalse(is_mime_text("application/vnd.wap.wmlc"));

        assertTrue(is_filename_text("file.html"));
        assertTrue(is_filename_text("file.yaml"));
        assertTrue(is_filename_text("file.q"));
        assertTrue(is_filename_text("file.qc"));
        assertTrue(is_filename_text("file.qm"));
        assertTrue(is_filename_text("file.java"));
        assertTrue(is_filename_text("file.py"));
        assertTrue(is_filename_text("file.sh"));

        assertFalse(is_filename_text("file.pyc"));
        assertFalse(is_filename_text("file.class"));
        assertFalse(is_filename_text("file.jar"));
        assertFalse(is_filename_text("file.dat"));
        assertFalse(is_filename_text("file"));
    }

    issue2936() {
        # get random binary data
        list<binary> bl = map get_random_bytes(128), 0..2;

        MultiPartFormDataMessage msg();
        map msg.addPart($1, "bin-" + $#, "binary-file-" + $# + ".bin", MimeTypeOctetStream), bl;

        string boundary = msg.getBoundary();
        hash<MessageInfo> h = MultiPartMessage::parseBody(boundary, msg.serializeBody(), True);

        map assertEq(MimeTypeOctetStream, $1.hdr."content-type"), h.part;
        map assertEq(bl[$#], $1.body), h.part;
    }

    mimeTypeTest() {
        assertEq(MimeTypeUnknown, get_mime_type_from_ext("/"));
        assertEq(MimeTypeHtml, get_mime_type_from_ext("/", MimeTypeHtml));
    }

    printableTest() {
        testAssertion("encode", \mime_encode_quoted_printable(), (testString,), new TestResultValue(printableEncoded));
        testAssertion("decode", \mime_decode_quoted_printable(), (printableEncoded,), new TestResultValue(testString));
    }

    base64Test() {
        testAssertion("encode", \mime_encode_base64(), (testString,), new TestResultValue(base64Encoded));
        testAssertion("decode", \mime_decode_base64_to_string(), (base64Encoded,), new TestResultValue(testString));
    }

    wordQTest() {
        testAssertion("encode", \mime_encode_header_word_q(), (testString,), new TestResultValue(headerWordQEncoded));
        testAssertion("decode", \mime_decode_header(), (headerWordQEncoded,), new TestResultValue(testString));
    }

    wordBTest() {
        testAssertion("encode", \mime_encode_header_word_b(), (testString,), new TestResultValue(headerWordBEncoded));
        testAssertion("decode", \mime_decode_header(), (headerWordBEncoded,), new TestResultValue(testString));
    }

    urlEncodingTest() {
        assertEq(UrlEncodingTarget, mime_get_urlencoded_string(UrlEncodingSource));
        assertEq("a=b&a%20x=c", mime_get_form_urlencoded_string({"a": "b", "a x": "c"}));
        assertEq("", mime_get_form_urlencoded_string({}));
        assertEq("empty=", mime_get_form_urlencoded_string({"empty": ""}));
        assertEq("=value", mime_get_form_urlencoded_string({"": "value"}));
        assertEq(UrlEncodingSource, mime_decode_urlencoded_string(UrlEncodingTarget));
        assertEq("a=b&a%20x=hi%20-%20hell%C3%B6", mime_get_form_urlencoded_string({"a": "b", "a x": "hi - hellö"}));
        assertThrows("INVALID-VALUE", \mime_get_urlencoded_string(), <abcd>);
        map assertEq($1, mime_decode_urlencoded_string(mime_get_urlencoded_string($1)), $1), MimeEncodingTestValues;
    }

    formDataTest() {
        hash<MessageInfo> mh = MultiPartMessage::parseBody(FormDataBoundary, FormDataBody);
        assertEq("", mh.body);
        assertEq(5, mh.part.size());
        #printf("mh: %N\n", mh);

        hash<string, hash<FormDataMessageInfo>> h = MultiPartFormDataMessage::parseMessage("multipart/form-data; "
            "boundary=---------------------------735323031399963166993862150", FormDataBody);
        assertEq(5, h.size());
        assertEq("hash<FormDataMessageInfo>", h.firstValue().fullType());

        MultiPartFormDataMessage msg = MultiPartFormDataMessage::makeMessage(h);
        assertEq(5, msg.size());
        #printf("str: %s\n%s <- boundary\n", msg.serializeBody().toString(), msg.getBoundary());
        h = MultiPartFormDataMessage::parseMessage(MimeTypeMultipartFormData + ";boundary=" + msg.getBoundary(),
            msg.serializeBody().toString());
        assertEq(5, h.size());
    }

    #! multipart/form-data must start with the first boundary delimiter, with no preamble
    /** Strict form-data parsers (Python's python-multipart, used by FastAPI/Starlette, for
        example) reject any content before the first delimiter, so a preamble made every
        form-data body generated by this module unparseable by those servers.
    */
    formDataNoPreambleTest() {
        MultiPartFormDataMessage msg();
        msg.addPart("Section One", "files", "input.txt", MimeTypeText);
        msg.addPart("fast", "strategy");

        string boundary = msg.getBoundary();
        string body = msg.serializeBody().toString();

        # the body starts with the delimiter itself: no preamble, and no leading CRLF either
        assertEq("--" + boundary + "\r\n", body.substr(0, boundary.size() + 4));
        assertFalse(body =~ /^This is a MIME multipart message/);
        # the closing delimiter is still present and well formed
        string close = "\r\n--" + boundary + "--";
        assertEq(close, body.substr(-close.size()));

        # ... and the message still round-trips through this module's own parsers
        hash<MessageInfo> parsed = MultiPartMessage::parseBody(boundary, msg.serializeBody(), True);
        assertEq(2, parsed.part.size());
        hash<string, hash<FormDataMessageInfo>> h = MultiPartFormDataMessage::parseMessage(
            MimeTypeMultipartFormData + ";boundary=" + boundary, body);
        assertEq(2, h.size());
        assertEq("Section One", h.files.body);
        assertEq("input.txt", h.files.filename);
        # RFC 2046 section 5.1: a part with no Content-Type is text, so a simple form field
        # comes back as a string and not as an undecoded binary
        assertEq("fast", h.strategy.body);

        # email-style multiparts keep the preamble; it is only harmful for form-data
        MultiPartMixedMessage mixed();
        mixed.addPart("This is the text body.", MimeTypeText, "inline");
        assertTrue(mixed.serializeBody().toString() =~ /^This is a MIME multipart message/);
    }

    #! a part with string data and no content type must not get a bare "charset=..." header
    formDataFieldContentTypeTest() {
        MultiPartFormDataMessage msg();
        # a simple form field: no content type given
        msg.addPart("fast", "strategy");
        # a file part: content type given, charset appended
        msg.addPart("Section One", "files", "input.txt", MimeTypeText);

        hash<MessageInfo> parsed = MultiPartMessage::parseBody(msg.getBoundary(),
            msg.serializeBody(), True);
        assertEq(2, parsed.part.size());

        # "charset=UTF-8" alone is not a valid media type, so no header is emitted at all
        assertEq(NOTHING, parsed.part[0].hdr."content-type");
        # the file part keeps its media type with the charset appended as a parameter
        assertEq(MimeTypeText + "; charset=UTF-8", parsed.part[1].hdr."content-type");
    }

    #! RFC 7578 section 4.3: a field name may be used by more than one part
    formDataRepeatedPartTest() {
        MultiPartFormDataMessage msg();
        msg.addPart("Section One", "files", "input.txt", MimeTypeText);
        msg.addRepeatedPart("eng", "languages");
        msg.addRepeatedPart("deu", "languages");
        assertEq(3, msg.size());

        hash<MessageInfo> parsed = MultiPartMessage::parseBody(msg.getBoundary(),
            msg.serializeBody(), True);
        assertEq(3, parsed.part.size());
        # both values are sent, each in its own part under the same name
        assertEq("eng", parsed.part[1].body);
        assertEq("deu", parsed.part[2].body);
        map assertTrue($1.hdr."content-disposition" =~ /name="languages"/),
            parsed.part[1..2];

        foreach string name in ("first.png", "second.png") {
            msg.addRepeatedPart(<FormDataMessageInfo>{"name": "images[]", "filename": name,
                "hdr": {"Content-Type": "image/png"}, "body": binary(name)});
        }
        parsed = MultiPartMessage::parseBody(msg.getBoundary(), msg.serializeBody(), True);
        assertEq(5, parsed.part.size());
        assertEq(binary("first.png"), parsed.part[3].body);
        assertEq(binary("second.png"), parsed.part[4].body);
        assertTrue(parsed.part[3].hdr."content-disposition".find("filename=\"first.png\"") >= 0);
        assertThrows("MULTIPART-FORMDATA-ERROR", sub () {
            msg.addRepeatedPart(<FormDataMessageInfo>{"name": "", "body": binary()});
        });

        # addPart() still rejects a repeated name
        assertThrows("MULTIPART-FORMDATA-ERROR", "given twice", sub () {
            msg.addPart("fra", "languages");
        });
        # ... and an empty name is rejected either way
        assertThrows("MULTIPART-FORMDATA-ERROR", "missing second argument", sub () {
            msg.addRepeatedPart("x", "");
        });
    }

    parseFormUrlencodedTest() {
        hash<auto> test_data = {
            "foo=bar&baz=1" : { "foo" : "bar", "baz" : "1", },
            "foo=bar&baz=" : { "foo" : "bar", "baz" : NOTHING, },
            "0=1&1=0" : { "0" : "1", "1" : "0", },
            "foo=bar&baz=1&foo=barber": {"foo": ("bar", "barber"), "baz": "1"},
        };

        HashIterator it(test_data);
        while (it.next()) {
            hash<auto> res = mime_parse_form_urlencoded_string(it.getKey());
            assertEq(it.getValue(), res, "mime_parse_form_urlencoded_string " + it.getKey());
        }
    }

    jsonTests() {
        # Test is_mime_json() function
        assertTrue(is_mime_json(MimeTypeJson));
        assertTrue(is_mime_json("application/json"));
        assertTrue(is_mime_json("application/vnd.api+json"));
        assertTrue(is_mime_json("application/ld+json"));
        assertTrue(is_mime_json("application/hal+json"));
        assertTrue(is_mime_json("application/problem+json"));
        assertTrue(is_mime_json("application/merge-patch+json"));
        assertTrue(is_mime_json("application/json-patch+json"));
        assertTrue(is_mime_json("application/fhir+json"));
        assertTrue(is_mime_json("application/geo+json"));
        assertTrue(is_mime_json("application/manifest+json"));

        # Test with charset modifier (should be stripped)
        assertTrue(is_mime_json("application/json; charset=utf-8"));
        assertTrue(is_mime_json("application/json;charset=UTF-8"));

        # Test non-JSON types
        assertFalse(is_mime_json(MimeTypeXml));
        assertFalse(is_mime_json(MimeTypeText));
        assertFalse(is_mime_json(MimeTypeHtml));
        assertFalse(is_mime_json("text/plain"));
    }

    newFileExtensionsTest() {
        # Test new file extensions added in v1.7
        assertEq("application/graphql", get_mime_type_from_ext("test.gql"));
        assertEq("application/graphql", get_mime_type_from_ext("test.graphql"));
        assertEq("image/heic", get_mime_type_from_ext("photo.heic"));
        assertEq("image/heif", get_mime_type_from_ext("photo.heif"));
        assertEq("text/jsx", get_mime_type_from_ext("component.jsx"));
        assertEq("text/markdown", get_mime_type_from_ext("README.md"));
        assertEq("text/markdown", get_mime_type_from_ext("docs.markdown"));
        assertEq("text/x-rst", get_mime_type_from_ext("docs.rst"));
        assertEq("application/sql", get_mime_type_from_ext("query.sql"));
        assertEq("application/toml", get_mime_type_from_ext("config.toml"));
        assertEq("text/typescript", get_mime_type_from_ext("app.ts"));
        assertEq("text/typescript-jsx", get_mime_type_from_ext("component.tsx"));
        assertEq("application/wasm", get_mime_type_from_ext("module.wasm"));

        # Test corrected MIME types
        assertEq("audio/webm", get_mime_type_from_ext("audio.weba"));
        assertEq("video/webm", get_mime_type_from_ext("video.webm"));
    }

    transferEncodingTest() {
        string testStr = "Hello, World! This is a test with special chars: äöü";

        # Test base64 encoding/decoding
        string encoded = mime_encode_transfer_data(testStr, ContentTransEncBase64);
        assertEq("string", encoded.type());
        # base64 decoding always returns binary (could be binary content)
        data decoded = mime_decode_transfer_data(encoded, ContentTransEncBase64);
        assertEq("binary", decoded.type());
        assertEq(testStr, decoded.toString());

        # Test base64 with text content-type (still returns binary - caller must convert)
        decoded = mime_decode_transfer_data(encoded, ContentTransEncBase64, "text/plain; charset=UTF-8");
        assertEq("binary", decoded.type());
        assertEq(testStr, decoded.toString());

        # Test quoted-printable encoding/decoding
        encoded = mime_encode_transfer_data(testStr, ContentTransEncQuotedPrintable);
        assertEq("string", encoded.type());
        decoded = mime_decode_transfer_data(encoded, ContentTransEncQuotedPrintable);
        assertEq("string", decoded.type());
        assertEq(testStr, decoded);

        # Test 7bit/8bit/binary (no encoding)
        assertEq(testStr, mime_encode_transfer_data(testStr, ContentTransEnc7Bit));
        assertEq(testStr, mime_encode_transfer_data(testStr, ContentTransEnc8Bit));
        assertEq(testStr, mime_encode_transfer_data(testStr, ContentTransEncBinary));

        # Test with charset in content-type for quoted-printable
        decoded = mime_decode_transfer_data(encoded, ContentTransEncQuotedPrintable, "text/plain; charset=UTF-8");
        assertEq("string", decoded.type());
        assertEq(testStr, decoded);

        # Test unknown encoding throws exception
        assertThrows("MIME-TRANSFER-ENCODING-ERROR", \mime_encode_transfer_data(), (testStr, "unknown-encoding"));
        assertThrows("MIME-TRANSFER-ENCODING-ERROR", \mime_decode_transfer_data(), (testStr, "unknown-encoding"));
    }

    multiPartMixedTest() {
        MultiPartMixedMessage msg();

        # Add text part
        msg.addPart("This is the text body.", MimeTypeText, "inline");

        # Add attachment
        binary attachmentData = <48656C6C6F>;  # "Hello" in binary
        msg.addEncodePart(attachmentData, ContentTransEncBase64, MimeTypeOctetStream,
            "attachment; filename=\"test.bin\"");

        assertEq(2, msg.size());

        # Test serialization
        hash<MessageInfo> mh = msg.getMsgAndHeaders();
        assertTrue(mh.hdr."Content-Type".val());
        assertTrue(mh.hdr."Content-Type" =~ /multipart\/mixed/);
        assertTrue(mh.hdr."MIME-Version".val());
        assertTrue(mh.body.val());

        # Test parsing back
        string boundary = msg.getBoundary();
        hash<MessageInfo> parsed = MultiPartMessage::parseBody(boundary, msg.serializeBody(), True);
        assertEq(2, parsed.part.size());
    }

    multiPartAlternativeTest() {
        MultiPartAlternativeMessage msg();

        # Add plain text alternative
        string plainText = "Hello, this is plain text.";
        msg.addPart(plainText, MimeTypeText, "inline");

        # Add HTML alternative
        string htmlText = "<html><body><p>Hello, this is <b>HTML</b>.</p></body></html>";
        msg.addPart(htmlText, MimeTypeHtml, "inline");

        assertEq(2, msg.size());

        # Test serialization
        hash<MessageInfo> mh = msg.getMsgAndHeaders();
        assertTrue(mh.hdr."Content-Type".val());
        assertTrue(mh.hdr."Content-Type" =~ /multipart\/alternative/);

        # Test with encoding
        MultiPartAlternativeMessage msg2();
        msg2.addEncodePart(plainText, ContentTransEncQuotedPrintable, MimeTypeText);
        msg2.addEncodePart(htmlText, ContentTransEncBase64, MimeTypeHtml);
        assertEq(2, msg2.size());

        # Test parsing back
        string boundary = msg.getBoundary();
        hash<MessageInfo> parsed = MultiPartMessage::parseBody(boundary, msg.serializeBody(), True);
        assertEq(2, parsed.part.size());
    }

    multiPartRelatedTest() {
        MultiPartRelatedMessage msg();

        # Add main HTML content
        string htmlContent = "<html><body><img src=\"cid:image1\"/></body></html>";
        msg.addPart(htmlContent, "mainContent", MimeTypeHtml);

        # Add related image
        binary imageData = <89504E470D0A1A0A>;  # PNG header
        msg.addPart(imageData, "image1", MimeTypePng);

        assertEq(2, msg.size());

        # Test serialization
        hash<MessageInfo> mh = msg.getMsgAndHeaders();
        assertTrue(mh.hdr."Content-Type".val());
        assertTrue(mh.hdr."Content-Type" =~ /multipart\/related/);
        assertTrue(mh.hdr."Content-Type" =~ /start=/);

        # Test parsing back
        string boundary = msg.getBoundary();
        hash<MessageInfo> parsed = MultiPartMessage::parseBody(boundary, msg.serializeBody(), True);
        assertEq(2, parsed.part.size());

        # Test error case - empty ID
        MultiPartRelatedMessage msg2();
        assertThrows("MULTIPART-RELATED-ERROR", \msg2.addPart(), (htmlContent, "", MimeTypeHtml));
    }

    multiPartDigestTest() {
        MultiPartDigestMessage msg();

        # Add email messages to digest
        string msg1 = "From: user1@example.com\r\nTo: list@example.com\r\nSubject: First message\r\n\r\nHello!";
        string msg2 = "From: user2@example.com\r\nTo: list@example.com\r\nSubject: Second message\r\n\r\nWorld!";

        msg.addPart(msg1);
        msg.addPart(msg2);

        assertEq(2, msg.size());

        # Test serialization
        hash<MessageInfo> mh = msg.getMsgAndHeaders();
        assertTrue(mh.hdr."Content-Type".val());
        assertTrue(mh.hdr."Content-Type" =~ /multipart\/digest/);
        assertTrue(mh.hdr."MIME-Version".val());

        # Test parsing back
        string boundary = msg.getBoundary();
        hash<MessageInfo> parsed = MultiPartMessage::parseBody(boundary, msg.serializeBody(), True);
        assertEq(2, parsed.part.size());

        # Verify default content type
        assertTrue(parsed.part[0].hdr."content-type" =~ /message\/rfc822/);
    }

    multiPartByteRangesTest() {
        MultiPartByteRangesMessage msg();

        # Simulate serving byte ranges of a file
        binary data1 = <48656C6C6F>;  # "Hello"
        binary data2 = <576F726C64>;  # "World"

        msg.addPart(data1, MimeTypeOctetStream, 0, 4, 10);
        msg.addPart(data2, MimeTypeOctetStream, 5, 9, 10);

        assertEq(2, msg.size());

        # Test serialization
        hash<MessageInfo> mh = msg.getMsgAndHeaders();
        assertTrue(mh.hdr."Content-Type".val());
        assertTrue(mh.hdr."Content-Type" =~ /multipart\/byteranges/);

        # Test parsing back
        string boundary = msg.getBoundary();
        hash<MessageInfo> parsed = MultiPartMessage::parseBody(boundary, msg.serializeBody(), True);
        assertEq(2, parsed.part.size());

        # Verify Content-Range headers
        assertTrue(parsed.part[0].hdr."content-range" =~ /bytes 0-4\/10/);
        assertTrue(parsed.part[1].hdr."content-range" =~ /bytes 5-9\/10/);

        # Test with unknown total size
        MultiPartByteRangesMessage msg2();
        msg2.addPart(data1, MimeTypeOctetStream, 0, 4, "*");
        hash<MessageInfo> parsed2 = MultiPartMessage::parseBody(msg2.getBoundary(), msg2.serializeBody(), True);
        assertTrue(parsed2.part[0].hdr."content-range" =~ /bytes 0-4\/\*/);
    }

    multiPartSignedTest() {
        # Test with PGP signature
        MultiPartSignedMessage msg("application/pgp-signature", "sha256");

        string content = "This is the message content to be signed.";
        string signature = "-----BEGIN PGP SIGNATURE-----\nfakesignaturedata\n-----END PGP SIGNATURE-----";

        msg.setContent(content, MimeTypeText);
        msg.setSignature(signature);

        assertEq(2, msg.size());

        # Test serialization
        hash<MessageInfo> mh = msg.getMsgAndHeaders();
        assertTrue(mh.hdr."Content-Type".val());
        assertTrue(mh.hdr."Content-Type" =~ /multipart\/signed/);
        assertTrue(mh.hdr."Content-Type" =~ /protocol="application\/pgp-signature"/);
        assertTrue(mh.hdr."Content-Type" =~ /micalg=sha256/);

        # Test parsing back
        string boundary = msg.getBoundary();
        hash<MessageInfo> parsed = MultiPartMessage::parseBody(boundary, msg.serializeBody(), True);
        assertEq(2, parsed.part.size());

        # Test error cases
        MultiPartSignedMessage msg2("application/pgp-signature", "sha256");
        assertThrows("MULTIPART-SIGNED-ERROR", \msg2.setSignature(), (signature,));  # No content yet

        MultiPartSignedMessage msg3("application/pgp-signature", "sha256");
        msg3.setContent(content, MimeTypeText);
        msg3.setSignature(signature);
        assertThrows("MULTIPART-SIGNED-ERROR", \msg3.setSignature(), (signature,));  # Already set

        # Test incomplete message
        MultiPartSignedMessage msg4("application/pgp-signature", "sha256");
        msg4.setContent(content, MimeTypeText);
        assertThrows("MULTIPART-SIGNED-ERROR", \msg4.getMsgAndHeaders());  # Missing signature
    }

    multiPartEncryptedTest() {
        # Test with PGP encryption
        MultiPartEncryptedMessage msg("application/pgp-encrypted");

        string controlInfo = "Version: 1";
        binary encryptedData = <0102030405060708>;  # Fake encrypted data

        msg.setControlInfo(controlInfo);
        msg.setEncryptedData(encryptedData);

        assertEq(2, msg.size());

        # Test serialization
        hash<MessageInfo> mh = msg.getMsgAndHeaders();
        assertTrue(mh.hdr."Content-Type".val());
        assertTrue(mh.hdr."Content-Type" =~ /multipart\/encrypted/);
        assertTrue(mh.hdr."Content-Type" =~ /protocol="application\/pgp-encrypted"/);

        # Test parsing back
        string boundary = msg.getBoundary();
        hash<MessageInfo> parsed = MultiPartMessage::parseBody(boundary, msg.serializeBody(), True);
        assertEq(2, parsed.part.size());

        # Test error cases
        MultiPartEncryptedMessage msg2("application/pgp-encrypted");
        assertThrows("MULTIPART-ENCRYPTED-ERROR", \msg2.setEncryptedData(), (encryptedData,));  # No control info

        MultiPartEncryptedMessage msg3("application/pgp-encrypted");
        msg3.setControlInfo(controlInfo);
        msg3.setEncryptedData(encryptedData);
        assertThrows("MULTIPART-ENCRYPTED-ERROR", \msg3.setEncryptedData(), (encryptedData,));  # Already set
        assertThrows("MULTIPART-ENCRYPTED-ERROR", \msg3.setControlInfo(), (controlInfo,));  # Already set

        # Test incomplete message
        MultiPartEncryptedMessage msg4("application/pgp-encrypted");
        msg4.setControlInfo(controlInfo);
        assertThrows("MULTIPART-ENCRYPTED-ERROR", \msg4.getMsgAndHeaders());  # Missing encrypted data
    }

    multiPartMessageTest() {
        MultiPartMessageMessage msg();

        # Add forwarded email messages
        string email1 = "From: sender@example.com\r\nTo: recipient@example.com\r\n"
            "Subject: Original message\r\n\r\nThis is the original message.";
        string email2 = "From: another@example.com\r\nTo: recipient@example.com\r\n"
            "Subject: Another message\r\n\r\nThis is another message.";

        msg.addPart(email1);
        msg.addPart(email2, MimeTypeMessage, "attachment; filename=\"forwarded.eml\"");

        assertEq(2, msg.size());

        # Test serialization
        hash<MessageInfo> mh = msg.getMsgAndHeaders();
        assertTrue(mh.hdr."Content-Type".val());
        assertTrue(mh.hdr."Content-Type" =~ /multipart\/message/);

        # Test parsing back
        string boundary = msg.getBoundary();
        hash<MessageInfo> parsed = MultiPartMessage::parseBody(boundary, msg.serializeBody(), True);
        assertEq(2, parsed.part.size());

        # Verify content types
        assertTrue(parsed.part[0].hdr."content-type" =~ /message\/rfc822/);
        assertTrue(parsed.part[1].hdr."content-type" =~ /message\/rfc822/);
    }

    #! RFC 2046 section 5.1.1 delimiter lines must be recognized as complete lines
    /** Transport padding (spaces and tabs) is legal between the boundary and the end of the
        delimiter line, the opening delimiter may start at byte zero, and text in a part that
        only looks like a delimiter line must be returned unchanged.
    */
    parseBodyDelimiterTest() {
        # the opening delimiter starts at byte zero: there is no preamble and no leading CRLF
        hash<MessageInfo> h = MultiPartMessage::parseBody("edge", DelimiterBody, False);
        assertEq(2, h.part.size());
        assertEq("", h.body);
        assertEq("one", h.part[0].body.toString());
        assertEq("two", h.part[1].body.toString());

        # a preamble before the opening delimiter is returned as the message body
        h = MultiPartMessage::parseBody("edge", "preamble text\r\n" + DelimiterBody, False);
        assertEq(2, h.part.size());
        assertEq("preamble text", h.body);

        # a body starting with CRLF has an empty preamble
        h = MultiPartMessage::parseBody("edge", "\r\n" + DelimiterBody, False);
        assertEq(2, h.part.size());
        assertEq("", h.body);

        # transport padding is legal on the opening, middle, and closing delimiter lines
        h = MultiPartMessage::parseBody("edge", replace(DelimiterBody, "--edge\r\n", "--edge \t\r\n"), False);
        assertEq(2, h.part.size());
        assertEq("one", h.part[0].body.toString());
        assertEq("two", h.part[1].body.toString());
        h = MultiPartMessage::parseBody("edge", replace(DelimiterBody, "--edge--", "--edge--  \t"), False);
        assertEq(2, h.part.size());
        assertEq("two", h.part[1].body.toString());

        # the closing delimiter may be terminated by the end of the body instead of CRLF
        h = MultiPartMessage::parseBody("edge", trim(DelimiterBody), False);
        assertEq(2, h.part.size());
        assertEq("two", h.part[1].body.toString());
        h = MultiPartMessage::parseBody("edge", trim(DelimiterBody) + " \t", False);
        assertEq(2, h.part.size());

        # anything after the closing delimiter is an epilogue and is returned with the body
        h = MultiPartMessage::parseBody("edge", DelimiterBody + "epilogue text\r\n", False);
        assertEq(2, h.part.size());
        assertEq("epilogue text\r\n", h.body);

        # a preamble and an epilogue are both returned with the body
        h = MultiPartMessage::parseBody("edge", "pre\r\n" + DelimiterBody + "post", False);
        assertEq(2, h.part.size());
        assertEq("prepost", h.body);

        # a delimiter-like line in the epilogue does not extend the message
        h = MultiPartMessage::parseBody("edge", DelimiterBody + "\r\n--edge--\r\n", False);
        assertEq(2, h.part.size());
        assertEq("\r\n--edge--\r\n", h.body);

        # data that only looks like a delimiter must be returned unchanged
        string body = "--edge\r\nContent-Type: text/plain\r\n\r\nnot--edge\r\n--edgemore\r\ntext\r\n--edge--\r\n";
        h = MultiPartMessage::parseBody("edge", body, False);
        assertEq(1, h.part.size());
        assertEq("not--edge\r\n--edgemore\r\ntext", h.part[0].body.toString());

        # a string body and the identical binary body must be parsed identically
        assertEq(MultiPartMessage::parseBody("edge", DelimiterBody, False),
            MultiPartMessage::parseBody("edge", binary(DelimiterBody), False));

        # with decode = False the raw part bytes must be returned unchanged
        h = MultiPartMessage::parseBody("edge", BinaryPartBody, False);
        assertEq(1, h.part.size());
        assertEq(binary("AP8="), h.part[0].body);
        # with decode = True the base64 transfer encoding is decoded
        h = MultiPartMessage::parseBody("edge", BinaryPartBody, True);
        assertEq(<00ff>, h.part[0].body);

        # no delimiter line at all
        assertThrows("MULTIPART-PARSEBODY-ERROR", "cannot find boundary",
            \MultiPartMessage::parseBody(), ("edge", "no delimiters here\r\n", False));
        # a dash-boundary that is not a complete delimiter line is not a delimiter
        assertThrows("MULTIPART-PARSEBODY-ERROR", "cannot find boundary",
            \MultiPartMessage::parseBody(), ("edge", "--edgemore\r\nX: y\r\n\r\none\r\n--edge--\r\n", False));
        # a delimiter line that does not start a line is not a delimiter
        assertThrows("MULTIPART-PARSEBODY-ERROR", "cannot find boundary",
            \MultiPartMessage::parseBody(), ("edge", "text--edge\r\nX: y\r\n\r\none\r\n--edge--\r\n", False));
        # a closing delimiter before any part
        assertThrows("MULTIPART-PARSEBODY-ERROR", "closing delimiter",
            \MultiPartMessage::parseBody(), ("edge", "\r\n--edge--\r\n", False));
        # no closing delimiter
        assertThrows("MULTIPART-PARSEBODY-ERROR", "cannot find closing boundary",
            \MultiPartMessage::parseBody(), ("edge", "--edge\r\nX: y\r\n\r\none\r\n", False));
        # an invalid closing delimiter line must not be accepted as a closing delimiter
        assertThrows("MULTIPART-PARSEBODY-ERROR", "cannot find closing boundary", \MultiPartMessage::parseBody(),
            ("edge", "--edge\r\nX: y\r\n\r\none\r\n--edge--not-a-delimiter\r\n", False));
        # a part with no header / body separator
        assertThrows("MULTIPART-PARSEBODY-ERROR", "could not find content boundary",
            \MultiPartMessage::parseBody(), ("edge", "--edge\r\nX: y\r\n--edge--\r\n", False));
    }

    #! part headers are returned with lower-case keys; repeated fields are returned as lists
    parseBodyHeaderTest() {
        # header field names are case-insensitive and are returned in lower case; long header
        # fields folded as per RFC 2822 section 2.2.3 are unfolded
        string body = "--edge\r\nCONTENT-type: text/plain\r\nX-Long: first\r\n \tsecond\r\n"
            "content-DESCRIPTION: desc\r\n\r\none\r\n--edge--\r\n";
        hash<MessageInfo> h = MultiPartMessage::parseBody("edge", body, False);
        assertEq(1, h.part.size());
        assertEq("text/plain", h.part[0].hdr."content-type");
        assertEq("first second", h.part[0].hdr."x-long");
        assertEq("desc", h.part[0].hdr."content-description");

        # a repeated Content-ID must not be silently overwritten; both values are returned in the
        # order received so that ambiguous attachment identity can be detected
        body = "--edge\r\nContent-Type: text/plain\r\nContent-ID: <a>\r\nContent-ID: <b>\r\n\r\none\r\n--edge--\r\n";
        h = MultiPartMessage::parseBody("edge", body, False);
        assertEq(("<a>", "<b>"), h.part[0].hdr."content-id");
        # identical repeated values must also be preserved
        body = "--edge\r\nContent-Type: text/plain\r\nContent-ID: <a>\r\nContent-ID: <a>\r\n\r\none\r\n--edge--\r\n";
        h = MultiPartMessage::parseBody("edge", body, False);
        assertEq(("<a>", "<a>"), h.part[0].hdr."content-id");
        # a repeated Content-ID does not make the part impossible to decode
        h = MultiPartMessage::parseBody("edge", body, True);
        assertEq(("<a>", "<a>"), h.part[0].hdr."content-id");
        assertEq("one", h.part[0].body);

        # repeated Content-Type and Content-Transfer-Encoding headers are also preserved
        body = "--edge\r\nContent-Type: text/plain\r\nContent-Type: text/plain\r\n\r\none\r\n--edge--\r\n";
        h = MultiPartMessage::parseBody("edge", body, False);
        assertEq(("text/plain", "text/plain"), h.part[0].hdr."content-type");
        # ... but make the part impossible to decode unambiguously
        assertThrows("MULTIPART-PARSEBODY-ERROR", "content-type", \MultiPartMessage::parseBody(),
            ("edge", body, True));

        body = "--edge\r\nContent-Transfer-Encoding: base64\r\nContent-Transfer-Encoding: base64\r\n\r\nAP8=\r\n"
            "--edge--\r\n";
        h = MultiPartMessage::parseBody("edge", body, False);
        assertEq(("base64", "base64"), h.part[0].hdr."content-transfer-encoding");
        assertThrows("MULTIPART-PARSEBODY-ERROR", "content-transfer-encoding", \MultiPartMessage::parseBody(),
            ("edge", body, True));

        # an unparseable header line is an error
        assertThrows("MULTIPART-PARSEBODY-ERROR", "header line", \MultiPartMessage::parseBody(),
            ("edge", "--edge\r\nnot a header\r\n\r\none\r\n--edge--\r\n", False));

        # a repeated Content-Disposition header in a form-data part is rejected
        body = "--edge\r\nContent-Disposition: form-data; name=\"a\"\r\nContent-Disposition: form-data; "
            "name=\"b\"\r\n\r\none\r\n--edge--\r\n";
        assertThrows("MULTIPART-FORMDATA-MESSAGE-ERROR", "at most one occurrence",
            \MultiPartFormDataMessage::parseMessage(), ("multipart/form-data; boundary=edge", body));
    }

    #! a part that is itself a multipart message is parsed recursively when decoding
    parseBodyNestedTest() {
        string inner = "--inner\r\nContent-Type: text/plain\r\n\r\ninner one\r\n"
            "--inner\r\nContent-Type: text/plain\r\n\r\ninner two\r\n--inner--\r\n";
        string outer = "--outer\r\nContent-Type: multipart/mixed; boundary=\"inner\"\r\n\r\n" + inner
            + "\r\n--outer\r\nContent-Type: text/plain\r\n\r\nlast\r\n--outer--\r\n";

        # the inner boundary must not affect the outer message
        hash<MessageInfo> h = MultiPartMessage::parseBody("outer", outer, False);
        assertEq(2, h.part.size());
        assertEq(0, h.part[0].part.size());
        assertEq(inner, h.part[0].body.toString());

        # with decoding enabled, the nested parts are parsed recursively
        h = MultiPartMessage::parseBody("outer", outer, True);
        assertEq(2, h.part.size());
        assertEq(2, h.part[0].part.size());
        assertEq("inner one", h.part[0].part[0].body);
        assertEq("inner two", h.part[0].part[1].body);
        assertEq("last", h.part[1].body);

        # a nested multipart part with no boundary parameter is an error
        outer = "--outer\r\nContent-Type: multipart/mixed\r\n\r\n" + inner + "\r\n--outer--\r\n";
        assertThrows("MULTIPART-PARSEBODY-ERROR", "could not find message boundary",
            \MultiPartMessage::parseBody(), ("outer", outer, True));
    }

    #! MIME header field names are case-insensitive, so a part header must be serialized only once
    partHeaderCaseTest() {
        MultiPartMixedMessage msg("edge");
        # the lower-case headers here are what MultiPartMessage::parseBody() returns
        msg.addPart("text", MimeTypeText, "inline", {
            "content-type": "text/html",
            "content-disposition": "attachment",
            "content-transfer-encoding": "7bit",
        });
        string body = msg.serializeBody().toString();
        assertEq(1, (body =~ x/(content-type)/gi).size());
        assertEq(1, (body =~ x/(content-disposition)/gi).size());
        assertEq(1, (body =~ x/(content-transfer-encoding)/gi).size());
        # the value generated for the part wins over the value given in another case
        hash<MessageInfo> h = MultiPartMessage::parseBody("edge", body, False);
        assertEq(MimeTypeText + "; charset=UTF-8", h.part[0].hdr."content-type");
        assertEq("inline", h.part[0].hdr."content-disposition");
        # a value that is not generated for the part is retained
        assertEq("7bit", h.part[0].hdr."content-transfer-encoding");

        # a form-data message parsed and reserialized must not repeat Content-Disposition
        hash<string, hash<FormDataMessageInfo>> parts = MultiPartFormDataMessage::parseMessage(
            "multipart/form-data; boundary=" + FormDataBoundary, FormDataBody);
        body = MultiPartFormDataMessage::makeMessage(parts).serializeBody().toString();
        assertEq(5, (body =~ x/(content-disposition)/gi).size());

        # the Content-Length header is generated for each part and may not be given by the caller
        # in any case
        assertThrows("HTTP-MULTIPART-ERROR", "Content-Length", \msg.addPart(),
            ("text", MimeTypeText, "inline", {"Content-Length": 4}));
        assertThrows("HTTP-MULTIPART-ERROR", "Content-Length", \msg.addPart(),
            ("text", MimeTypeText, "inline", {"content-length": 4}));
    }

    #! RFC 2045 section 5.1: parameter values that are not tokens must be quoted
    quoteParameterValueTest() {
        # tokens are returned unchanged
        assertEq("token", mime_quote_parameter_value("token"));
        assertEq("7bit", mime_quote_parameter_value("7bit"));
        assertEq("a-b_c.d+e", mime_quote_parameter_value("a-b_c.d+e"));
        # values containing tspecials must be quoted
        assertEq("\"text/xml\"", mime_quote_parameter_value("text/xml"));
        assertEq("\"<root@example.test>\"", mime_quote_parameter_value("<root@example.test>"));
        assertEq("\"a;b\"", mime_quote_parameter_value("a;b"));
        # spaces, empty values, and non-ASCII characters must be quoted
        assertEq("\"a b\"", mime_quote_parameter_value("a b"));
        assertEq("\"\"", mime_quote_parameter_value(""));
        assertEq("\"hellö\"", mime_quote_parameter_value("hellö"));
        # quotes and backslashes must be escaped in quoted-strings
        assertEq("\"a\\\"b\"", mime_quote_parameter_value("a\"b"));
        assertEq("\"a\\\\b\"", mime_quote_parameter_value("a\\b"));
    }

    #! RFC 2387: multipart/related requires a "type" parameter and quoted parameter values
    multiPartRelatedHeaderTest() {
        MultiPartRelatedMessage msg("test-boundary");
        msg.addPart("<root/>", "<root@example.test>", "text/xml; charset=UTF-8");
        msg.addPart(<89504e470d0a1a0a>, "<image@example.test>", MimeTypePng);

        # the type parameter gives the media type of the root part with no parameters, and both
        # parameter values are quoted because they contain tspecials
        hash<MessageInfo> mh = msg.getMsgAndHeaders();
        assertEq("multipart/related; boundary=\"test-boundary\"; type=\"text/xml\"; "
            "start=\"<root@example.test>\"", mh.hdr."Content-Type");

        # the root part retains its own charset parameter
        hash<MessageInfo> parsed = MultiPartMessage::parseBody("test-boundary", mh.body, False);
        assertEq(2, parsed.part.size());
        assertEq("text/xml; charset=UTF-8", parsed.part[0].hdr."content-type");
        assertEq("<root@example.test>", parsed.part[0].hdr."content-id");
        assertEq(MimeTypePng, parsed.part[1].hdr."content-type");

        # the first part added is the root part
        MultiPartRelatedMessage msg2("test-boundary");
        msg2.addPart("<root/>", "first", MimeTypeXml);
        msg2.addPart("<other/>", "second", MimeTypeHtml);
        assertEq("multipart/related; boundary=\"test-boundary\"; type=\"text/xml\"; start=first",
            msg2.getMsgAndHeaders().hdr."Content-Type");

        # a spliced part replaces the root part and its type
        msg2.splicePart(<0102>, "<spliced@example.test>", MimeTypeOctetStream);
        mh = msg2.getMsgAndHeaders();
        assertEq("multipart/related; boundary=\"test-boundary\"; type=\"application/octet-stream\"; "
            "start=\"<spliced@example.test>\"", mh.hdr."Content-Type");
        # the spliced part is the first part in the message
        parsed = MultiPartMessage::parseBody("test-boundary", mh.body, True);
        assertEq(3, parsed.part.size());
        assertEq("<spliced@example.test>", parsed.part[0].hdr."content-id");
        assertEq(<0102>, parsed.part[0].body);
        assertEq("first", parsed.part[1].hdr."content-id");

        # a message with no parts cannot be serialized
        MultiPartRelatedMessage msg3("test-boundary");
        assertThrows("HTTP-MULTIPART-ERROR", "no parts", \msg3.getMsgAndHeaders());
        # the Content-ID is required for every part
        assertThrows("MULTIPART-RELATED-ERROR", \msg3.splicePart(), ("<root/>", "", MimeTypeXml));
    }

    yamlMimeTypesTest() {
        # MimeTypeYaml must be the RFC 9512 official type
        assertEq("application/yaml", MimeTypeYaml);

        # MimeTypeYaml and MimeTypeYamlApp must now agree
        assertEq(MimeTypeYamlApp, MimeTypeYaml);

        # YamlMimeTypes must cover all four known YAML MIME variants
        assertTrue(YamlMimeTypes.hasKey("application/yaml"));
        assertTrue(YamlMimeTypes.hasKey("application/x-yaml"));
        assertTrue(YamlMimeTypes.hasKey("text/x-yaml"));
        assertTrue(YamlMimeTypes.hasKey("text/yaml"));
        assertEq(4, YamlMimeTypes.size());

        # .yaml and .yml extensions must map to the official type
        assertEq("application/yaml", get_mime_type_from_ext("config.yaml"));
        assertEq("application/yaml", get_mime_type_from_ext("config.yml"));
    }
}
