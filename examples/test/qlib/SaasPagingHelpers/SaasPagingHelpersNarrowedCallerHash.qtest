%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires SystemeIoDataProvider
%requires InstantlyDataProvider
%requires SmartSheetDataProvider
%requires KatanaDataProvider
%requires InsightlyDataProvider
%requires KitDataProvider
%requires TableauDataProvider
%requires SquareDataProvider

%exec-class SaasPagingHelpersNarrowedCallerHashTest

#! Systeme.io provider that answers GET requests from memory
class TestSystemeIoTags inherits SystemeIoDataProvider::SystemeIoTagsDataProvider {
    public {
        list<hash<auto>> calls = ();
    }

    constructor(RestClientIo::RestClientIo rest) : SystemeIoTagsDataProvider(rest) {
    }

    auto doGet(string path, *hash<auto> params) {
        push calls, {"path": path, "params": params};
        # first page has more items; the second page is the last
        if (calls.size() == 1) {
            return {"items": ({"id": 11},), "hasMore": True};
        }
        return {"items": ({"id": 12},), "hasMore": False};
    }
}

#! Instantly provider that answers GET and POST requests from memory
class TestInstantlyCampaigns inherits InstantlyDataProvider::InstantlyCampaignsDataProvider {
    public {
        list<hash<auto>> calls = ();
    }

    constructor(InstantlyRestClient::InstantlyRestClientIo rest) : InstantlyCampaignsDataProvider(rest) {
    }

    auto doGet(string path, *hash<auto> params) {
        return page(path, params);
    }

    auto doPost(string path, *hash<auto> body) {
        return page(path, body);
    }

    private hash<auto> page(string path, *hash<auto> params) {
        push calls, {"path": path, "params": params};
        if (calls.size() == 1) {
            return {"items": ({"id": "a"},), "next_starting_after": "a"};
        }
        return {"items": ({"id": "b"},)};
    }
}

