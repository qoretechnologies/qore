#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires json
%requires QUnit
%requires HttpServer
%requires HttpServerUtil
%requires Logger
%requires OneRecordServerHandler

%exec-class OneRecordServerHandlerCredentialsTest

#! a hang guard only, never a timing assertion
const HangGuard = 20s;

#! The authorizer of a restricted Program gets the request without its credentials (qore#7303)
/** A handler of trusted code gives an authorizer of a %Program that a sandbox that does not trust its code governs the
    request without its credentials; it gets the \c Authorization field only when trusted code opts in to it; a trusted
    authorizer gets the request as the server has it, and the authorizer of a handler that restricted code constructs
    gets it without its credentials
*/
class OneRecordServerHandlerCredentialsTest inherits QUnit::Test {
    public {
        #! the tenant's code: an authorizer that records what of the credentials of the request it saw
        const TenantSource = "%modern
%requires Logger
%requires OneRecordServerHandler
string sub seen(hash<auto> cx, hash<auto> hdr) {
    return sprintf(\"authorization=%y cookie=%y cx.auth=%y cx.hdr.authorization=%y raw_authorization=%y logger=%y \"
        \"listener=%y socket=%y url=%y\", exists hdr.authorization, exists hdr.cookie, exists cx.auth,
        exists cx.hdr.authorization, exists cx.\"header-info\".\"headers-raw\".Authorization, cx.hasKey(\"logger\"),
        cx.hasKey(\"listener\"), cx.hasKey(\"socket\"), exists cx.url);
}
class TenantAuthorizer inherits PermissiveOneRecordAuthorizer {
    private {
        Queue q;
    }
    constructor(Queue q) {
        self.q = q;
    }
    string getIdentity(hash<auto> cx, hash<auto> hdr) {
        q.push(seen(cx, hdr));
        return PermissiveOneRecordAuthorizer::getIdentity(cx, hdr);
    }
}
AbstractOneRecordAuthorizer sub get_authorizer(Queue q) {
    return new TenantAuthorizer(q);
}
OneRecordServerHandler sub make_handler(Queue q) {
    return new OneRecordServerHandler(new Logger(\"tenant\", LoggerLevel::getLevelInfo()), \"http://localhost\",
        new InMemoryOneRecordStorage(), new TenantAuthorizer(q));
}
";

        #! what the authorizer of a restricted Program gets: no credentials, no objects of the server
        const Filtered = "authorization=False cookie=False cx.auth=False cx.hdr.authorization=False "
            "raw_authorization=False logger=False listener=False socket=False url=True";

        #! what the authorizer of a restricted Program gets with the opt-in: the Authorization field only
        const FilteredOptIn = "authorization=True cookie=False cx.auth=False cx.hdr.authorization=True "
            "raw_authorization=True logger=False listener=False socket=False url=True";

        #! what a trusted authorizer gets
        const Raw = "authorization=True cookie=True cx.auth=True cx.hdr.authorization=True raw_authorization=True "
            "logger=True listener=False socket=True url=True";
    }

    constructor() : Test("OneRecordServerHandlerCredentialsTest", "1.0", \ARGV) {
        addTestCase("a restricted authorizer of a trusted handler", \restrictedTest());
        addTestCase("a restricted authorizer with the opt-in of trusted code", \optInTest());
        addTestCase("the authorizer of a Program without a sandbox", \trustedTest());
        addTestCase("the authorizer of a handler that restricted code constructs", \restrictedHandlerTest());
        set_return_value(main());
    }

    #! returns the tenant's Program with the given sandbox
    private Program getTenant(*SandboxManager sm) {
        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        if (sm) {
            p.setSandboxManager(sm);
        }
        p.parse(TenantSource, "tenant");
        return p;
    }

    #! returns a handler of the host with the given authorizer
    private OneRecordServerHandler getHandler(AbstractOneRecordAuthorizer authorizer) {
        return new OneRecordServerHandler(new Logger("host", LoggerLevel::getLevelInfo()), "http://localhost",
            new InMemoryOneRecordStorage(), authorizer);
    }

    #! requests an object with credentials; returns the status code
    private int request(OneRecordServerHandler handler) {
        HttpServer server(<HttpServerOptionInfo>{});
        on_exit server.stop();
        server.setDefaultHandler("onerecord", handler);
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        server.waitForAsyncIo();
        Socket c();
        c.connect("127.0.0.1:" + port, HangGuard);
        on_exit c.close();
        c.send("GET /logistics-objects/none HTTP/1.1\r\nHost: localhost\r\nAuthorization: Bearer secret\r\n"
            "Cookie: session=secret\r\n\r\n");
        hash<auto> h = c.readHTTPHeader(HangGuard);
        return h.status_code;
    }

    restrictedTest() {
        Queue q();
        # the default sandbox does not trust its code
        Program p = getTenant(new SandboxManager());
        assertEq(404, request(getHandler(p.callFunction("get_authorizer", q))), "the request is served");
        assertEq(Filtered, q.get(HangGuard), "the restricted authorizer");
    }

    optInTest() {
        Queue q();
        Program p = getTenant(new SandboxManager());
        OneRecordServerHandler h = getHandler(p.callFunction("get_authorizer", q));
        # the authorizer reads a bearer token: trusted code opts in to the Authorization field for it
        h.setRequestCredentialHeaders("authorization");
        assertEq(404, request(h), "the request is served");
        assertEq(FilteredOptIn, q.get(HangGuard), "the restricted authorizer with the opt-in");
    }

    trustedTest() {
        Queue q();
        Program p = getTenant();
        assertEq(404, request(getHandler(p.callFunction("get_authorizer", q))), "the request is served");
        assertEq(Raw, q.get(HangGuard), "the authorizer of a Program without a sandbox");
    }

    restrictedHandlerTest() {
        Queue q();
        Program p = getTenant(new SandboxManager());
        OneRecordServerHandler h = p.callFunction("make_handler", q);
        # no code can opt in to the Authorization field for a handler that restricted code constructs, also trusted
        # code
        assertThrows("REQUEST-ERROR", \h.setRequestCredentialHeaders(), "authorization");
        assertEq(404, request(h), "the request is served");
        assertEq(Filtered, q.get(HangGuard), "the authorizer of a handler that restricted code constructs");
    }
}
