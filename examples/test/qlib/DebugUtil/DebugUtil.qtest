#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires DebugUtil
%requires QUnit

%exec-class DebugUtilTest

public class DebugUtilTest inherits QUnit::Test {
    constructor() : Test("DebugUtilTest", "1.0") {
        addTestCase("serialize/unserialize round-trip tests", \serializeTests());
        addTestCase("unserialize error tests", \unserializeErrorTests());
        addTestCase("enumFilter tests", \enumFilterTests());
        addTestCase("evalCondition tests", \evalConditionTests());
        addTestCase("WrapperGetOpt.split tests", \wrapperGetOptTests());
        addTestCase("constants tests", \constantsTests());
        addTestCase("ResponseSync tests", \responseSyncTests());
        addTestCase("value descriptions and paths", \describeTests());
        addTestCase("marks in the output of programs", \outputMarkTest());
        addTestCase("UTF-8 characters in the output of programs", \utf8SizeTest());
        addTestCase("capture of the output of the process", \outputCaptureTest());
        set_return_value(main());
    }

    serializeTests() {
        # NOTHING round-trip
        {
            hash<auto> sv = AbstractDebugControl::serialize(NOTHING);
            assertEq("nothing", sv.type);
            assertFalse(sv.hasKey("value"));
            auto val = AbstractDebugControl::unserialize(sv);
            assertNothing(val);
        }

        # NULL round-trip
        {
            hash<auto> sv = AbstractDebugControl::serialize(NULL);
            assertEq("NULL", sv.type);
            assertFalse(sv.hasKey("value"));
            auto val = AbstractDebugControl::unserialize(sv);
            assertEq(NULL, val);
        }

        # int round-trip
        {
            hash<auto> sv = AbstractDebugControl::serialize(42);
            assertEq("integer", sv.type);
            assertEq(42, sv.value);
            auto val = AbstractDebugControl::unserialize(sv);
            assertEq(42, val);
        }

        # float round-trip
        {
            hash<auto> sv = AbstractDebugControl::serialize(3.14);
            assertEq("float", sv.type);
            assertEq(3.14, sv.value);
            auto val = AbstractDebugControl::unserialize(sv);
            assertEq(3.14, val);
        }

        # string round-trip
        {
            hash<auto> sv = AbstractDebugControl::serialize("hello");
            assertEq("string", sv.type);
            assertEq("hello", sv.value);
            auto val = AbstractDebugControl::unserialize(sv);
            assertEq("hello", val);
        }

        # bool round-trip
        {
            hash<auto> sv = AbstractDebugControl::serialize(True);
            assertEq("bool", sv.type);
            assertEq(True, sv.value);
            auto val = AbstractDebugControl::unserialize(sv);
            assertEq(True, val);
        }

        {
            hash<auto> sv = AbstractDebugControl::serialize(False);
            assertEq("bool", sv.type);
            assertEq(False, sv.value);
            auto val = AbstractDebugControl::unserialize(sv);
            assertEq(False, val);
        }

        # date round-trip
        {
            date d = 2026-01-15T10:30:00Z;
            hash<auto> sv = AbstractDebugControl::serialize(d);
            assertEq("date", sv.type);
            assertEq(d, sv.value);
            auto val = AbstractDebugControl::unserialize(sv);
            assertEq(d, val);
        }

        # binary round-trip
        {
            binary b = <deadbeef>;
            hash<auto> sv = AbstractDebugControl::serialize(b);
            assertEq("binary", sv.type);
            assertEq(b, sv.value);
            auto val = AbstractDebugControl::unserialize(sv);
            assertEq(b, val);
        }

        # number round-trip
        {
            number n = 123.456n;
            hash<auto> sv = AbstractDebugControl::serialize(n);
            assertEq("number", sv.type);
            assertEq(n, sv.value);
            auto val = AbstractDebugControl::unserialize(sv);
            assertEq(n, val);
        }

        # list round-trip (mixed types)
        {
            list<auto> l =(1, "two", 3.0, True);
            hash<auto> sv = AbstractDebugControl::serialize(l);
            assertEq("list", sv.type);
            assertEq(4, sv.value.size());
            # verify each element is serialized
            assertEq("integer", sv.value[0].type);
            assertEq("string", sv.value[1].type);
            assertEq("float", sv.value[2].type);
            assertEq("bool", sv.value[3].type);
            auto val = AbstractDebugControl::unserialize(sv);
            assertEq(l, val);
        }

        # hash round-trip
        {
            hash<auto> h ={"key1": 1, "key2": "val"};
            hash<auto> sv = AbstractDebugControl::serialize(h);
            assertEq("hash", sv.type);
            assertEq("integer", sv.value.key1.type);
            assertEq("string", sv.value.key2.type);
            auto val = AbstractDebugControl::unserialize(sv);
            assertEq(h, val);
        }

        # nested structure round-trip
        {
            hash<auto> nested ={"list": (1, {"inner": "val"}), "num": 42};
            hash<auto> sv = AbstractDebugControl::serialize(nested);
            assertEq("hash", sv.type);
            auto val = AbstractDebugControl::unserialize(sv);
            assertEq(nested, val);
        }

        # object serialization preserves class name
        {
            Mutex m();
            hash<auto> sv = AbstractDebugControl::serialize(m);
            assertEq("object", sv.type);
            assertEq("Mutex", sv.value.class);
        }

        # unsupported type (code/closure) — no value in serialized form
        {
            code c = sub() {};
            hash<auto> sv = AbstractDebugControl::serialize(c);
            assertEq("closure", sv.type);
            assertFalse(sv.hasKey("value"));
        }

        # empty list serializes, unserialize returns empty list via push
        {
            list<auto> l =();
            hash<auto> sv = AbstractDebugControl::serialize(l);
            assertEq("list", sv.type);
            assertEq((), sv.value);
            # unserialize uses push loop over empty list -> returns NOTHING
            auto val = AbstractDebugControl::unserialize(sv);
            assertNothing(val);
        }

        # empty hash serializes, unserialize iterates over empty keys -> returns NOTHING
        {
            hash<auto> h ={};
            hash<auto> sv = AbstractDebugControl::serialize(h);
            assertEq("hash", sv.type);
            auto val = AbstractDebugControl::unserialize(sv);
            assertNothing(val);
        }

        # pass-through: non-hash input to unserialize returns as-is
        {
            assertEq(42, AbstractDebugControl::unserialize(42));
            assertEq("str", AbstractDebugControl::unserialize("str"));
        }
    }

    unserializeErrorTests() {
        # unknown type throws DEBUG-ERROR
        assertThrows("DEBUG-ERROR", sub() {
            AbstractDebugControl::unserialize({"type": "unknown_type", "value": 1});
        });
    }

    enumFilterTests() {
        list<auto> items =("alpha", "beta", "gamma", "alphabet");

        # no path returns all
        assertEq(items, AbstractDebugControl::enumFilter(items, NOTHING));
        assertEq(items, AbstractDebugControl::enumFilter(items, ""));

        # prefix match
        assertEq(("alpha", "alphabet"), AbstractDebugControl::enumFilter(items, "alpha"));

        # exact match with = prefix
        assertEq(list("alpha"), AbstractDebugControl::enumFilter(items, "=alpha"));

        # no match
        assertEq((), AbstractDebugControl::enumFilter(items, "xyz"));

        # empty list
        assertEq((), AbstractDebugControl::enumFilter((), "alpha"));

        # single character prefix
        assertEq(("alpha", "alphabet"), AbstractDebugControl::enumFilter(items, "a"));
    }

    evalConditionTests() {
        # no condition returns True
        assertTrue(AbstractDebugControl::evalCondition("anything", NOTHING));
        assertTrue(AbstractDebugControl::evalCondition("anything", ""));

        # exact match with = prefix
        assertTrue(AbstractDebugControl::evalCondition("test", "=test"));
        assertFalse(AbstractDebugControl::evalCondition("testing", "=test"));

        # prefix match (default)
        assertTrue(AbstractDebugControl::evalCondition("testing", "test"));
        assertFalse(AbstractDebugControl::evalCondition("test", "testing"));

        # numeric values
        assertTrue(AbstractDebugControl::evalCondition(123, "=123"));
        assertTrue(AbstractDebugControl::evalCondition(123, "12"));
    }

    wrapperGetOptTests() {
        hash<auto> opts = {
            'help': 'h,help',
            'verbose': 'v,verbose',
            'listen': 'l,listen=s@',
        };

        # standard args: wrapper opts, then program name, then program args
        {
            WrapperGetOpt g(opts);
            list<string> wrp_args;
            *string pgm_name;
            list<string> pgm_args;
            g.split(("-v", "myfile.q", "-my", "params"), \wrp_args, \pgm_name, \pgm_args);
            assertEq("myfile.q", pgm_name);
            assertEq(("-v",), wrp_args);
            assertEq(("-my", "params"), pgm_args);
        }

        # -- for stdin
        {
            WrapperGetOpt g(opts);
            list<string> wrp_args;
            *string pgm_name;
            list<string> pgm_args;
            g.split(("-v", "--"), \wrp_args, \pgm_name, \pgm_args);
            assertEq("", pgm_name);
            assertEq(("-v",), wrp_args);
        }

        # all option args, no program name
        {
            WrapperGetOpt g(opts);
            list<string> wrp_args;
            *string pgm_name;
            list<string> pgm_args;
            g.split(("-v", "-h"), \wrp_args, \pgm_name, \pgm_args);
            assertNothing(pgm_name);
        }

        # --listen=xxx style: option with value, then program
        {
            WrapperGetOpt g(opts);
            list<string> wrp_args;
            *string pgm_name;
            list<string> pgm_args;
            g.split(("-v", "--listen=localhost", "myfile.q"), \wrp_args, \pgm_name, \pgm_args);
            assertEq("myfile.q", pgm_name);
        }

        # --listen xxx style
        {
            WrapperGetOpt g(opts);
            list<string> wrp_args;
            *string pgm_name;
            list<string> pgm_args;
            g.split(("-v", "--listen", "localhost", "myfile.q"), \wrp_args, \pgm_name, \pgm_args);
            assertEq("myfile.q", pgm_name);
        }

        # empty args
        {
            WrapperGetOpt g(opts);
            list<string> wrp_args;
            *string pgm_name;
            list<string> pgm_args;
            g.split(new list<string>(), \wrp_args, \pgm_name, \pgm_args);
            assertNothing(pgm_name);
            assertEq(new list<string>(), wrp_args);
        }
    }

    constantsTests() {
        # QoreDebugWsProtocolHeader
        assertEq("QoreDebugWsProtocol", QoreDebugWsProtocolHeader);

        # QoreDebugProtocolVersion
        assertEq("0.1", QoreDebugProtocolVersion);

        # runStateStrings contains expected keys
        assertTrue(AbstractDebugControl::runStateStrings.hasKey("detach"));
        assertTrue(AbstractDebugControl::runStateStrings.hasKey("run"));
        assertTrue(AbstractDebugControl::runStateStrings.hasKey("step"));
        assertTrue(AbstractDebugControl::runStateStrings.hasKey("stepover"));
        assertTrue(AbstractDebugControl::runStateStrings.hasKey("untilreturn"));

        # flowStrings
        assertTrue(AbstractDebugControl::flowStrings.hasKey("none"));
        assertTrue(AbstractDebugControl::flowStrings.hasKey("return"));
        assertTrue(AbstractDebugControl::flowStrings.hasKey("break"));
        assertTrue(AbstractDebugControl::flowStrings.hasKey("continue"));

        # boolStrings
        assertEq(False, AbstractDebugControl::boolStrings.false);
        assertEq(True, AbstractDebugControl::boolStrings.true);

        # policyStrings
        assertTrue(AbstractDebugControl::policyStrings.hasKey("none"));
        assertTrue(AbstractDebugControl::policyStrings.hasKey("accept"));
        assertTrue(AbstractDebugControl::policyStrings.hasKey("reject"));
    }

    responseSyncTests() {
        # basic deliver/wait cycle
        {
            ResponseSync sync();
            sync.prepare();
            assertTrue(sync.isPending());
            # deliver from same thread (simulating immediate response)
            assertTrue(sync.deliver({"type": DebugResponseType::Response, "result": "ok"}));
            assertFalse(sync.isPending());
            *auto result = sync.waitForResponse(100ms);
            assertEq(DebugResponseType::Response, result.type);
            assertEq("ok", result.result);
        }

        # deliver before waitForResponse returns the data
        {
            ResponseSync sync();
            sync.prepare();
            sync.deliver(42);
            *auto result = sync.waitForResponse(100ms);
            assertEq(42, result);
        }

        # deliver when not pending returns False
        {
            ResponseSync sync();
            assertFalse(sync.isPending());
            assertFalse(sync.deliver("data"));
        }

        # waitForResponse without prepare returns NOTHING (not pending)
        {
            ResponseSync sync();
            *auto result = sync.waitForResponse(50ms);
            assertNothing(result);
        }

        # timeout returns NOTHING
        {
            ResponseSync sync();
            sync.prepare();
            *auto result = sync.waitForResponse(10ms);
            assertNothing(result);
            # after timeout, pending is reset
            assertFalse(sync.isPending());
        }

        # prepare resets previous state
        {
            ResponseSync sync();
            sync.prepare();
            sync.deliver("first");
            # prepare again for new cycle
            sync.prepare();
            assertTrue(sync.isPending());
            sync.deliver("second");
            *auto result = sync.waitForResponse(100ms);
            assertEq("second", result);
        }

        # cross-thread deliver/wait
        {
            ResponseSync sync();
            sync.prepare();
            background sub() {
                usleep(10ms);
                sync.deliver({"status": "done"});
            }();
            *auto result = sync.waitForResponse(2s);
            assertEq("done", result.status);
        }

        # cross-thread timeout
        {
            ResponseSync sync();
            sync.prepare();
            # no one delivers
            *auto result = sync.waitForResponse(50ms);
            assertNothing(result);
        }

        # NOTHING data is a valid delivery
        {
            ResponseSync sync();
            sync.prepare();
            assertTrue(sync.deliver(NOTHING));
            # waitForResponse returns NOTHING (valid response)
            # but this is indistinguishable from timeout in this case
            *auto result = sync.waitForResponse(100ms);
            assertNothing(result);
        }

        # multiple prepare/deliver cycles work correctly
        {
            ResponseSync sync();
            for (int i = 0; i < 5; i++) {
                sync.prepare();
                sync.deliver(i);
                *auto result = sync.waitForResponse(100ms);
                assertEq(i, result);
            }
        }
        # only the response with the unique ID that is waited for is delivered
        {
            ResponseSync sync();
            sync.prepare("2");
            assertFalse(sync.deliver({"uid": "1", "result": "stale"}));
            assertFalse(sync.deliver({"result": "no uid"}));
            assertTrue(sync.isPending());
            assertTrue(sync.deliver({"uid": "2", "result": "ok"}));
            assertFalse(sync.isPending());
            assertEq("ok", sync.waitForResponse().result);
            # nothing is waited for any more
            assertFalse(sync.deliver({"uid": "2", "result": "again"}));
        }

        # a wait without a timeout returns when the response is delivered by another thread
        {
            ResponseSync sync();
            sync.prepare("3");
            Counter started(1);
            background sub () {
                started.waitForZero();
                sync.deliver({"uid": "3", "result": "from thread"});
            }();
            started.dec();
            assertEq("from thread", sync.waitForResponse().result);
        }

        # a wait without a timeout returns at once when the response was delivered before
        {
            ResponseSync sync();
            sync.prepare("4");
            sync.deliver({"uid": "4", "result": "early"});
            assertEq("early", sync.waitForResponse().result);
        }

        # cancel() stops waiting for a response
        {
            ResponseSync sync();
            sync.prepare("5");
            sync.cancel();
            assertFalse(sync.isPending());
            assertFalse(sync.deliver({"uid": "5"}));
            assertNothing(sync.waitForResponse());
        }

        # a timeout is still possible with a unique ID
        {
            ResponseSync sync();
            sync.prepare("6");
            assertNothing(sync.waitForResponse(10ms));
            assertFalse(sync.isPending());
            assertFalse(sync.deliver({"uid": "6"}));
        }
    }

    # the output before a mark, or before an end of the output that can be the beginning of a mark, is queued
    outputMarkTest() {
        binary mark = binary("\0mark-123");
        assertEq(5, DebugOutputCapture::getOutputSize(binary("abcde\0mark-123Frest"), mark));
        assertEq(0, DebugOutputCapture::getOutputSize(binary("\0mark-123S"), mark));
        # an end that can be the beginning of a mark
        assertEq(3, DebugOutputCapture::getOutputSize(binary("abc\0mar"), mark));
        assertEq(3, DebugOutputCapture::getOutputSize(binary("abc\0"), mark));
        # no mark
        assertEq(5, DebugOutputCapture::getOutputSize(binary("abcde"), mark));
        assertEq(4, DebugOutputCapture::getOutputSize(binary("ab\0x"), mark));
        assertEq(0, DebugOutputCapture::getOutputSize(binary(), mark));
    }

    # output that ends inside a UTF-8 character is passed without the incomplete character
    utf8SizeTest() {
        assertEq(3, DebugOutputCapture::getCompleteUtf8Size(binary("abc")));
        # "é" is 2 bytes; "€" is 3 bytes
        binary e = binary("é");
        binary euro = binary("€");
        assertEq(3, DebugOutputCapture::getCompleteUtf8Size(binary("a") + e));
        assertEq(1, DebugOutputCapture::getCompleteUtf8Size(binary("a") + e.substr(0, 1)));
        assertEq(1, DebugOutputCapture::getCompleteUtf8Size(binary("a") + euro.substr(0, 2)));
        assertEq(4, DebugOutputCapture::getCompleteUtf8Size(binary("a") + euro));
        assertEq(0, DebugOutputCapture::getCompleteUtf8Size(binary()));
    }

    # the output of the process is passed to the callbacks; flushAndWait() returns after the output before it
    outputCaptureTest() {
        if (PlatformOS == "Windows") {
            testSkip("the output is not captured on Windows");
        }
        list<string> out = ();
        list<string> err = ();
        Counter flushed(2);
        list<string> flushed_categories = ();
        Mutex m();
        DebugOutputCapture capture(
            sub (string category, string output) {
                m.lock();
                on_exit m.unlock();
                if (category == "stdout") {
                    out += output;
                } else {
                    err += output;
                }
            },
            sub (string category) {
                m.lock();
                flushed_categories += category;
                m.unlock();
                flushed.dec();
            });
        assertFalse(capture.isCapturing());
        assertTrue(capture.start());
        # a second start does nothing
        assertFalse(capture.start());
        bool stopped;
        on_exit if (!stopped) {
            capture.stop();
        }
        assertTrue(capture.isCapturing());

        stdout.print("out-1\n");
        stderr.print("err-1\n");
        capture.flushAndWait();
        list<string> out1 = out;
        list<string> err1 = err;

        stdout.print("out-2 é\n");
        capture.flush();
        flushed.waitForZero();

        stdout.print("out-3\n");
        capture.stop();
        stopped = True;
        assertFalse(capture.isCapturing());
        # without a capture, flush and flushAndWait do nothing
        assertFalse(capture.flush());
        capture.flushAndWait();

        assertEq("out-1\n", out1.join(""));
        assertEq("err-1\n", err1.join(""));
        assertEq("out-1\nout-2 é\nout-3\n", out.join(""));
        assertEq(("stderr", "stdout"), sort(flushed_categories));
    }

    describeTests() {
        DescribeTestAccount acct();
        hash<auto> v = {"acct": acct, "l": (1, "two", {"k": 3}), "s": "str", "n": NOTHING};

        # descriptions
        assertEq({"type": "hash<auto>", "value": "hash<auto> (4)", "named": 4}, AbstractDebugControl::describe(v));
        assertEq({"type": "list<auto>", "value": "list (3)", "indexed": 3}, AbstractDebugControl::describe(v.l));
        assertEq({"type": "DescribeTestAccount", "value": "DescribeTestAccount", "named": 3},
            AbstractDebugControl::describe(acct));
        assertEq({"type": "string", "value": "\"str\""}, AbstractDebugControl::describe("str"));
        assertEq({"type": "nothing", "value": "null"}, AbstractDebugControl::describe(NOTHING));
        # long text is shortened
        hash<auto> d = AbstractDebugControl::describe(strmul("x", 1000));
        assertEq(AbstractDebugControl::MaxValueTextSize + 3, d.value.length());

        # the members of an object, also private ones and those of parent classes
        assertEq(("id", "balance", "name"), map $1.name, AbstractDebugControl::describeChildren(acct));
        assertEq(("id", "balance", "name"), AbstractDebugControl::getMemberNames(acct));
        # the keys of a hash and the elements of a list, also a part of them
        assertEq(("acct", "l", "s", "n"), map $1.key, AbstractDebugControl::describeChildren(v));
        assertEq((1, 2), map $1.key, AbstractDebugControl::describeChildren(v.l, 1));
        assertEq(("\"two\"",), map $1.value, AbstractDebugControl::describeChildren(v.l, 1, 1));
        assertEq((), AbstractDebugControl::describeChildren(v.l, 5));

        # paths
        assertEq(3, AbstractDebugControl::getPath(v, ("l", 2, "k")));
        assertEq(100, AbstractDebugControl::getPath(v, ("acct", "balance")));
        assertEq(v, AbstractDebugControl::getPath(v, ()));
        v = AbstractDebugControl::setPath(v, ("l", 2, "k"), 4);
        assertEq(4, v.l[2].k);
        # the member of an object is set in the object
        AbstractDebugControl::setPath(v, ("acct", "balance"), 7);
        assertEq(7, acct.getBalance());
        assertEq("new", AbstractDebugControl::setPath(v, (), "new"));

        # negative
        assertThrows("DEBUG-ERROR", "no element 9", \AbstractDebugControl::getPath(), (v, ("l", 9)));
        assertThrows("DEBUG-ERROR", "no key \"x\"", \AbstractDebugControl::getPath(), (v, ("x",)));
        assertThrows("DEBUG-ERROR", "no member \"x\"", \AbstractDebugControl::getPath(), (v, ("acct", "x")));
        assertThrows("DEBUG-ERROR", "has no elements", \AbstractDebugControl::getPath(), (v, ("s", 0)));
        assertThrows("DEBUG-ERROR", "has no elements", \AbstractDebugControl::describeChildren(), (1,));
        assertThrows("DEBUG-ERROR", "no element 9", \AbstractDebugControl::setPath(), (v, ("l", 9), 1));
    }
}

#! a class with private members and a parent class, for describeTests()
class DescribeTestBase {
    private {
        int id = 7;
    }
}

class DescribeTestAccount inherits DescribeTestBase {
    private {
        int balance = 100;
    }

    public {
        string name = "acct";
    }

    int getBalance() {
        return balance;
    }
}
