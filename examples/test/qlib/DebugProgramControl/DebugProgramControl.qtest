%modern
%allow-debugger

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires DebugUtil
%requires DebugProgramControl
%requires QUnit

%exec-class DebugProgramControlTest

class TestDebugProgramControl inherits DebugProgramControl {
    public {
        list<hash<auto>> sentMessages = ();
        list<auto> broadcastMessages = ();
    }

    constructor() : DebugProgramControl("test-server") {
    }

    public sendDataImpl(hash<auto> cx, auto data) {
        push sentMessages, {"cx": cx, "data": data};
    }

    public broadcastDataImpl(auto data) {
        push broadcastMessages, data;
    }

    public clearMessages() {
        sentMessages = ();
        broadcastMessages = ();
    }

    #! serializes local variables as a stopped thread sends them to the clients
    public *hash<auto> testSerializeLocals(*hash<auto> lv) {
        return serializeLocals(lv);
    }

    #! evaluates an expression with the given local variables
    public auto testEvaluate(ProgramControl pgm, string expr, *hash<auto> lv) {
        return evaluateExpression(pgm, expr, lv);
    }

    #! returns the value of a local variable root
    public auto testLocalRootValue(ProgramControl pgm, string name, *hash<auto> lv) {
        return getDebugRootValue(pgm, {"local": name}, lv, {}, NOTHING);
    }
}

#! Holds a thread that stops right after it has found a connected client, before it registers as stopped
/** A thread that stops checks for a client at the start of handleInterrupt() and registers as stopped later; the
    test disconnects the last client in between, as an IDE that ends its session while a thread of the program stops.
*/
class HeldStopDebugProgramControl inherits DebugProgramControl {
    public {
        #! the stops broadcast to the clients
        list<auto> broadcastMessages = ();
    }

    private {
        #! the thread whose first connection check is held
        int hold_tid;
        #! decremented when the held thread has found a connected client
        Counter checked;
        #! the held thread continues when this reaches zero
        Counter release;
        #! decremented when a stop is broadcast
        Counter stopped;
        Mutex m();
    }

    constructor() : DebugProgramControl("test-server") {
    }

    #! Holds the next connection check of the given thread
    hold(int tid, Counter n_checked, Counter n_release, Counter n_stopped) {
        AutoLock al(m);
        hold_tid = tid;
        checked = n_checked;
        release = n_release;
        stopped = n_stopped;
    }

    private bool hasConnection() {
        bool rv = DebugProgramControl::hasConnection();
        *Counter c;
        *Counter r;
        {
            AutoLock al(m);
            if (hold_tid == gettid() && checked) {
                c = remove checked;
                r = release;
            }
        }
        if (c) {
            c.dec();
            r.waitForZero();
        }
        return rv;
    }

    public sendDataImpl(hash<auto> cx, auto data) {
    }

    public broadcastDataImpl(auto data) {
        *Counter s;
        {
            AutoLock al(m);
            push broadcastMessages, data;
            s = stopped;
        }
        if (s && s.getCount()) {
            s.dec();
        }
    }
}

public class DebugProgramControlTest inherits QUnit::Test {
    private {
        TestDebugProgramControl dpc;
        const CX = {"id": 1};
    }

    constructor() : Test("DebugProgramControlTest", "1.0") {
        addTestCase("help and version", \helpVersionTests());
        addTestCase("options", \optionsTests());
        addTestCase("session", \sessionTests());
        addTestCase("program list", \programListTests());
        addTestCase("breakpoint CRUD", \breakpointTests());
        addTestCase("thread stack", \threadStackTests());
        addTestCase("error handling", \errorHandlingTests());
        addTestCase("unavailable local variables", \unavailableLocalTests());
        addTestCase("connection management", \connectionTests());
        addTestCase("shutdown", \shutdownTests());
        addTestCase("a thread stops with a client: it waits until it is resumed", \stopWithClientTest());
        addTestCase("a thread stops as the last client disconnects: it continues", \stopAsClientDisconnectsTest());
        addTestCase("integration", \integrationTests());
        set_return_value(main());
    }

    setUp() {
        dpc = new TestDebugProgramControl();
        dpc.registerConnection(CX);
    }

    tearDown() {
        dpc.unregisterConnection(CX);
    }

    helpVersionTests() {
        # help command
        {
            *hash<auto> ret= dpc.processCommand(CX, {"cmd": "help"});
            assertEq(DebugResponseType::Response,ret.type);
            assertTrue(ret.result instanceof list);
            assertTrue(ret.result.size() > 0);
        }

        # version command
        {
            *hash<auto> ret= dpc.processCommand(CX, {"cmd": "version"});
            assertEq(DebugResponseType::Response,ret.type);
            assertTrue(ret.result.hasKey("class"));
            assertEq("TestDebugProgramControl", ret.result.class);
            # verify enhanced version info
            assertTrue(ret.result.hasKey("DebugProgramControl"));
            assertTrue(ret.result.hasKey("DebugUtil"));
            assertTrue(ret.result.hasKey("qore"));
            assertEq(Qore::VersionString, ret.result.qore);
        }
    }

    optionsTests() {
        # fullexceptioninfo get (default)
        {
            *hash<auto> ret= dpc.processCommand(CX, {"cmd": "options/fullexceptioninfo/get"});
            assertEq(DebugResponseType::Response,ret.type);
            assertEq(False, ret.result);
        }

        # fullexceptioninfo set/get
        {
            dpc.processCommand(CX, {"cmd": "options/fullexceptioninfo/set", "value": True});
            *hash<auto> ret= dpc.processCommand(CX, {"cmd": "options/fullexceptioninfo/get"});
            assertEq(True, ret.result);
            # reset
            dpc.processCommand(CX, {"cmd": "options/fullexceptioninfo/set", "value": False});
        }

        # sourcepath get (default)
        {
            *hash<auto> ret= dpc.processCommand(CX, {"cmd": "options/sourcepath/get"});
            assertEq(DebugResponseType::Response,ret.type);
            assertEq("", ret.result);
        }

        # sourcepath set/get
        {
            dpc.processCommand(CX, {"cmd": "options/sourcepath/set", "value": "/tmp"});
            *hash<auto> ret= dpc.processCommand(CX, {"cmd": "options/sourcepath/get"});
            assertEq("/tmp", ret.result);
            # reset
            dpc.processCommand(CX, {"cmd": "options/sourcepath/set", "value": ""});
        }
    }

    sessionTests() {
        # get session with no programs added to debugging
        {
            *hash<auto> ret= dpc.processCommand(CX, {"cmd": "session/get"});
            # with no programs added to debugging, result is NOTHING so no response is sent
            assertNothing(ret);
        }

        # get session after adding a program
        {
            Program pgm(PO_NO_CHILD_PO_RESTRICTIONS);
            pgm.parse("int sub sess_test() { return 1; }", "session-test.q");
            ProgramControl pc = pgm.getProgram();
            dpc.addProgram(pc);
            int pgmId = pc.getProgramId();

            *hash<auto> ret= dpc.processCommand(CX, {"cmd": "session/get"});
            assertEq(DebugResponseType::Response,ret.type);
            assertTrue(ret.result.hasKey(string(pgmId)));

            dpc.removeProgram(pc);
        }
    }

    programListTests() {
        # list programs (global list) — returns all ProgramControl instances
        {
            *hash<auto> ret= dpc.processCommand(CX, {"cmd": "program//list"});
            assertEq(DebugResponseType::Response,ret.type);
            # result is a hash of programs; at minimum our own program exists
            assertTrue(ret.result instanceof hash);
            assertTrue(ret.result.size() > 0);
        }

        # list with filter — nonexistent name returns no result (NOTHING)
        {
            *hash<auto> ret= dpc.processCommand(CX, {"cmd": "program/nonexistent_xyz/list"});
            # no programs match the filter, so result is NOTHING and no response is generated
            assertNothing(ret);
        }
    }

    breakpointTests() {
        # create a program for breakpoints
        Program pgm(PO_NO_CHILD_PO_RESTRICTIONS);
        pgm.parse("int sub test_func() { return 1; }", "test-bkpt.q");
        ProgramControl pc = pgm.getProgram();
        dpc.addProgram(pc);
        int pgmId = pc.getProgramId();

        dpc.clearMessages();

        # create breakpoint
        *hash<auto> ret= dpc.processCommand(CX, {"cmd": "program/" + pgmId + "/breakpoint//create"});
        assertEq(DebugResponseType::Response,ret.type);
        assertTrue(ret.result.hasKey("bkptid"));
        int bkptId = ret.result.bkptid;

        # verify broadcast
        assertTrue(dpc.broadcastMessages.size() > 0);
        assertEq("create", dpc.broadcastMessages[dpc.broadcastMessages.size() - 1].event);

        # list breakpoints
        {
            *hash<auto> ret2= dpc.processCommand(CX, {"cmd": "program/" + pgmId + "/breakpoint//list"});
            assertEq(DebugResponseType::Response,ret2.type);
            assertTrue(ret2.result instanceof list);
            assertTrue(ret2.result.size() >= 1);
        }

        # list all breakpoints (no pgmId)
        {
            *hash<auto> ret2= dpc.processCommand(CX, {"cmd": "program//breakpoint//list"});
            assertEq(DebugResponseType::Response,ret2.type);
            assertTrue(ret2.result instanceof list);
        }

        # enable/disable
        {
            *hash<auto> ret2= dpc.processCommand(CX, {"cmd": "program/" + pgmId + "/breakpoint/" + bkptId + "/disable"});
            assertEq(DebugResponseType::Response,ret2.type);
            assertEq("ok", ret2.result);
        }
        {
            *hash<auto> ret2= dpc.processCommand(CX, {"cmd": "program/" + pgmId + "/breakpoint/" + bkptId + "/enable"});
            assertEq(DebugResponseType::Response,ret2.type);
            assertEq("ok", ret2.result);
        }

        # policy get/set
        {
            *hash<auto> ret2= dpc.processCommand(CX, {"cmd": "program/" + pgmId + "/breakpoint/" + bkptId + "/policy/get"});
            assertEq(DebugResponseType::Response,ret2.type);
            assertEq("none", ret2.result);
        }
        {
            dpc.processCommand(CX, {"cmd": "program/" + pgmId + "/breakpoint/" + bkptId + "/policy/set", "value": "accept"});
            *hash<auto> ret2= dpc.processCommand(CX, {"cmd": "program/" + pgmId + "/breakpoint/" + bkptId + "/policy/get"});
            assertEq("accept", ret2.result);
        }

        # thread get/set/add/remove
        {
            *hash<auto> ret2= dpc.processCommand(CX, {"cmd": "program/" + pgmId + "/breakpoint/" + bkptId + "/thread/get"});
            assertEq(DebugResponseType::Response,ret2.type);
            assertEq((), ret2.result);
        }
        {
            dpc.processCommand(CX, {"cmd": "program/" + pgmId + "/breakpoint/" + bkptId + "/thread/add", "value": 42});
            *hash<auto> ret2= dpc.processCommand(CX, {"cmd": "program/" + pgmId + "/breakpoint/" + bkptId + "/thread/get"});
            assertTrue(inlist(42, ret2.result));
        }
        {
            dpc.processCommand(CX, {"cmd": "program/" + pgmId + "/breakpoint/" + bkptId + "/thread/remove", "value": 42});
            *hash<auto> ret2= dpc.processCommand(CX, {"cmd": "program/" + pgmId + "/breakpoint/" + bkptId + "/thread/get"});
            assertFalse(inlist(42, ret2.result));
        }

        # delete breakpoint
        {
            dpc.clearMessages();
            *hash<auto> ret2= dpc.processCommand(CX, {"cmd": "program/" + pgmId + "/breakpoint/" + bkptId + "/delete"});
            assertEq(DebugResponseType::Response,ret2.type);
            assertEq("ok", ret2.result);
            # verify delete broadcast
            assertTrue(dpc.broadcastMessages.size() > 0);
            assertEq("delete", dpc.broadcastMessages[dpc.broadcastMessages.size() - 1].event);
        }

        dpc.removeProgram(pc);
    }

    threadStackTests() {
        # thread stack all (no tid)
        {
            *hash<auto> ret= dpc.processCommand(CX, {"cmd": "thread/stack"});
            assertEq(DebugResponseType::Response,ret.type);
            assertTrue(ret.result instanceof hash);
        }

        # thread command without tid when tid is required
        {
            *hash<auto> ret= dpc.processCommand(CX, {"cmd": "thread/go", "tid": 99999});
            assertEq(DebugResponseType::Error,ret.type);
            assertTrue(ret.result.err.find("DEBUG-HANDLER-ERROR") >= 0);
        }
    }

    # a local variable that the AOT-compiled code of its frame keeps in native code has no value in the result of
    # get_local_vars() but "unavailable" (#5890): it is sent to the clients without a value, and an expression or a
    # variable path that uses it raises an error instead of giving it a value
    unavailableLocalTests() {
        hash<auto> lv = {
            "a": {"type": "local", "value": 1, "declaredType": "int"},
            "x": {"type": "local", "unavailable": True, "declaredType": "int"},
        };
        *hash<auto> slv = dpc.testSerializeLocals(lv);
        assertEq(AbstractDebugControl::serialize(1), slv.a.value);
        assertTrue(slv.x.unavailable);
        assertFalse(slv.x.hasKey("value"));
        assertEq("int", slv.x.declaredType);

        ProgramControl pgm = ProgramControl::getProgram();
        assertEq(2, dpc.testEvaluate(pgm, "a + 1", lv));
        # the name in a string and after a "." is not the variable
        assertEq("x1", dpc.testEvaluate(pgm, "\"x\" + a", lv));
        assertThrows("DEBUG-EVALUATE-ERROR", "local variable \"x\"", \dpc.testEvaluate(), (pgm, "x + 1", lv));
        assertThrows("DEBUG-EVALUATE-ERROR", "local variable \"x\"", \dpc.testEvaluate(), (pgm, "a + x", lv));

        assertEq(1, dpc.testLocalRootValue(pgm, "a", lv));
        assertThrows("DEBUG-ERROR", "local variable \"x\"", \dpc.testLocalRootValue(), (pgm, "x", lv));
    }

    errorHandlingTests() {
        # unknown command
        {
            *hash<auto> ret= dpc.processCommand(CX, {"cmd": "nonexistent_command"});
            assertEq(DebugResponseType::Error,ret.type);
        }

        # invalid program ID
        {
            *hash<auto> ret= dpc.processCommand(CX, {"cmd": "program/999999/add"});
            assertEq(DebugResponseType::Error,ret.type);
        }

        # invalid breakpoint ID
        {
            *hash<auto> ret= dpc.processCommand(CX, {"cmd": "program//breakpoint/999999/enable"});
            assertEq(DebugResponseType::Error,ret.type);
        }
    }

    connectionTests() {
        # register new connection
        hash<auto> cx2 = {"id": 2};
        dpc.registerConnection(cx2);

        # welcome message
        dpc.clearMessages();
        dpc.connectionRegistered(cx2);
        assertTrue(dpc.sentMessages.size() > 0);
        assertEq(DebugEventCmd::Welcome, dpc.sentMessages[0].data.cmd);
        assertEq("test-server", dpc.sentMessages[0].data.result);

        # getConnectionIds
        list<auto> ids = dpc.getConnectionIds();
        assertTrue(inlist(1, ids));
        assertTrue(inlist(2, ids));

        # unregister
        dpc.unregisterConnection(cx2);
        ids = dpc.getConnectionIds();
        assertFalse(inlist(2, ids));

        # unregisterAll
        hash<auto> cx3 = {"id": 3};
        hash<auto> cx4 = {"id": 4};
        dpc.registerConnection(cx3);
        dpc.registerConnection(cx4);
        dpc.unregisterAllConnections();
        ids = dpc.getConnectionIds();
        assertFalse(inlist(3, ids));
        assertFalse(inlist(4, ids));

        # re-register our main connection for tearDown
        dpc.registerConnection(CX);
    }

    shutdownTests() {
        # shutdown with no blocked threads should not deadlock
        TestDebugProgramControl dpc2();
        dpc2.registerConnection(CX);
        *hash<auto> ret= dpc2.processCommand(CX, {"cmd": "shutdown"});
        assertEq(DebugResponseType::Response,ret.type);
        assertEq("ok", ret.result);
        dpc2.unregisterConnection(CX);
    }

    #! Runs the detach stop of a thread of a program in the background, with its first connection check held
    /** @return a hash: \c dpc: the debug control, \c pc: the program, \c done: reaches zero when the stop has returned,
        \c release: lets the thread go on, \c stopped: reaches zero when the stop is broadcast
    */
    private hash<auto> startHeldStop() {
        HeldStopDebugProgramControl d();
        d.registerConnection(CX);
        Program pgm(PO_NO_CHILD_PO_RESTRICTIONS);
        pgm.parse("int sub held_stop() { return 1; }", "held-stop.q");
        ProgramControl pc = pgm.getProgram();
        d.addProgram(pc);
        Counter checked(1);
        Counter release(1);
        Counter stopped(1);
        Counter done(1);
        Counter tid_set(1);
        int tid;
        background sub () {
            on_exit done.dec();
            tid = gettid();
            d.hold(tid, checked, release, stopped);
            tid_set.dec();
            int rs = DebugDetach;
            int rts = 0;
            d.onDetach(pc, \rs, \rts);
        }();
        tid_set.waitForZero();
        # the thread has found a connected client and has not yet registered as stopped
        checked.waitForZero();
        return {"dpc": d, "pc": pc, "pgm": pgm, "done": done, "release": release, "stopped": stopped};
    }

    #! A thread that stops while a client is connected waits until it is resumed
    stopWithClientTest() {
        hash<auto> h = startHeldStop();
        HeldStopDebugProgramControl d = h.dpc;
        on_exit {
            # a failed assertion must not leave the thread stopped
            d.shutdown();
            h.done.waitForZero();
            d.removeProgram(h.pc);
        }
        h.release.dec();
        h.stopped.waitForZero();
        assertEq(1, d.broadcastMessages.size(), "the stop is broadcast to the client");
        assertEq("detach", d.broadcastMessages[0].func, "the stop is the detach of the thread");
        assertEq(1, h.done.getCount(), "the stopped thread waits for the client");
        # the client resumes the thread when it disconnects
        d.unregisterConnection(CX);
        h.done.waitForZero();
        assertEq(0, h.done.getCount(), "the thread continues when the client disconnects");
    }

    #! A thread that stops while the last client disconnects continues instead of waiting for a client
    /** The client disconnects after the thread has found it connected and before the thread registers as stopped;
        the disconnect resumes only the threads that are registered then.  The thread used to register and wait
        forever, so that the debug adapter of an IDE, waiting for the program to end, never ended.
    */
    stopAsClientDisconnectsTest() {
        hash<auto> h = startHeldStop();
        HeldStopDebugProgramControl d = h.dpc;
        bool ended;
        on_exit {
            if (!ended) {
                # the thread waits as a stopped thread: it is resumed, so that the test ends
                d.shutdown();
                h.done.waitForZero();
            }
            d.removeProgram(h.pc);
        }
        d.unregisterConnection(CX);
        assertEq((), d.getConnectionIds(), "no client is connected");
        h.release.dec();
        # the thread returns at once; the limit only ends the test if it waits for a client that will never come
        ended = !h.done.waitForZero(30s);
        assertTrue(ended, "the thread continues without a client to resume it");
        assertEq((), d.broadcastMessages, "the thread does not stop");
    }

    integrationTests() {
        # create a program, add to debugging, run in background, verify interrupt events
        Program pgm(PO_NO_CHILD_PO_RESTRICTIONS);
        pgm.parse("int sub integ_test() { return 1; }", "integration-test.q");
        ProgramControl pc = pgm.getProgram();

        # add to debug control
        int pgmId = pc.getProgramId();
        *hash<auto> ret= dpc.processCommand(CX, {"cmd": "program/" + pgmId + "/add"});
        assertEq(DebugResponseType::Response,ret.type);

        # verify program appears in session
        {
            *hash<auto> ret2= dpc.processCommand(CX, {"cmd": "session/get"});
            assertEq(DebugResponseType::Response,ret2.type);
            assertTrue(ret2.result.hasKey(string(pgmId)));
        }

        # remove program
        ret = dpc.processCommand(CX, {"cmd": "program/" + pgmId + "/remove"});
        assertEq(DebugResponseType::Response,ret.type);

        # add duplicate check
        dpc.processCommand(CX, {"cmd": "program/" + pgmId + "/add"});
        {
            *hash<auto> ret2= dpc.processCommand(CX, {"cmd": "program/" + pgmId + "/add"});
            assertEq(DebugResponseType::Response,ret2.type);
            # result should indicate already added
            assertTrue(ret2.result.find("already added") >= 0);
        }

        # remove and clean up
        dpc.processCommand(CX, {"cmd": "program/" + pgmId + "/remove"});

        # remove not-added
        {
            *hash<auto> ret2= dpc.processCommand(CX, {"cmd": "program/" + pgmId + "/remove"});
            assertEq(DebugResponseType::Response,ret2.type);
            assertTrue(ret2.result.find("not added") >= 0);
        }
    }
}
