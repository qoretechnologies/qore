    #! Trigger example data: verify each event provider returns valid example data
    triggerExampleDataTests() {
        skipIfNoCredentials();
        KitDataProvider::KitDataProvider provider(client);
        AbstractDataProvider events = provider.getChildProvider("events");

        *list<string> event_children = events.getChildProviderNames();
        assertEq(True, event_children.size() >= 6, "at least 6 event providers");

        list<string> expected_triggers = (
            "subscriber-activate",
            "subscriber-unsubscribe",
            "subscriber-bounce",
            "subscriber-complain",
            "form-subscribe",
            "course-subscribe",
        );

        foreach string trigger_name in (expected_triggers) {
            AbstractDataProvider trigger = events.getChildProvider(trigger_name);
            assertEq(trigger_name, trigger.getName(),
                sprintf("trigger %s name matches", trigger_name));

            # Verify supports_observable
            hash<DataProviderInfo> trigger_info = trigger.getInfo();
            assertEq(True, trigger_info.supports_observable,
                sprintf("trigger %s supports_observable", trigger_name));

            # Verify event types
            hash<string, hash<DataProviderMessageInfo>> event_types = trigger.getEventTypes();
            assertEq(True, event_types.hasKey(trigger_name),
                sprintf("trigger %s has matching event type", trigger_name));

            # Verify example event data
            auto example = trigger.getExampleEventData(trigger_name);
            assertEq(True, example.val(),
                sprintf("trigger %s returns example data", trigger_name));
            assertEq(Type::Hash, example.type(),
                sprintf("trigger %s example data is a hash", trigger_name));
            assertEq(True, example.id.val(),
                sprintf("trigger %s example data has id field", trigger_name));
            assertEq(True, example.email_address.val(),
                sprintf("trigger %s example data has email_address field", trigger_name));
            assertEq(True, example.hasKey("first_name"),
                sprintf("trigger %s example data has first_name field", trigger_name));
            assertEq(True, example.hasKey("state"),
                sprintf("trigger %s example data has state field", trigger_name));
        }
    }
}
