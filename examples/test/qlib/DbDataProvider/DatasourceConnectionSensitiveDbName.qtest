#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright 2026 Qore Technologies, s.r.o. SPDX-License-Identifier: MIT

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit

%requires DbDataProvider
%requires ConnectionProvider
%requires dbitest

%exec-class DatasourceConnectionSensitiveDbNameTest

#! The safe URL, the information and the ping result of a db:// connection mask a sensitive database name (qore#7275)
/** The "dbitestsensitivedb" mock driver declares that its database name can hold credentials
    (DBI_CAP_SENSITIVE_DBNAME), so its database name is masked in every form that shows one, even a plain name; the
    "dbitest" mock driver does not, so a plain database name is shown and the character rule of the masked forms
    decides.  The drivers are loaded (%requires) before the connections are created.
*/
class DatasourceConnectionSensitiveDbNameTest inherits QUnit::Test {
    public {
        const Plain = "plaindb7275";
        const Separated = "srv;password=s3cr3t-7275";
    }

    constructor() : Test("DatasourceConnection sensitive database names", "1.0", \ARGV) {
        addTestCase("a driver that declares it", \sensitiveDriver());
        addTestCase("a driver that declares it: failed ping", \failedPing());
        addTestCase("a driver that does not declare it", \plainDriver());
        addTestCase("the character rule", \separatedName());
        addTestCase("a driver that is not loaded", \driverNotLoaded());
        set_return_value(main());
    }

    sensitiveDriver() {
        DatasourceConnection conn("c7275", "test", "db://dbitestsensitivedb:user/pass@" + Plain + "%dbhost");
        checkMasked(conn, Plain);
        assertEq("db://dbitestsensitivedb:****/****@****%dbhost", conn.safe_url);
        hash<PingInfo> rv = conn.ping();
        assertTrue(rv.ok, rv.info);
        assertFalse(sprintf("%y", rv).find(Plain) >= 0);
        # with passwords, the information has the configuration
        assertEq(Plain, conn.getInfo({"with_passwords": True}).url_hash.db);
    }

    failedPing() {
        # the datasource cannot be made (an option that the driver does not declare)
        DatasourceConnection conn("c7275", "test", "db://dbitestsensitivedb:user/pass@" + Plain
            + "{undeclared7275=1,min=1,max=2}");
        hash<PingInfo> rv = conn.ping();
        assertFalse(rv.ok);
        assertFalse(sprintf("%y", rv).find(Plain) >= 0);
    }

    plainDriver() {
        DatasourceConnection conn("c7275", "test", "db://dbitest:user/pass@" + Plain + "%dbhost");
        assertEq("db://dbitest:****/****@" + Plain + "%dbhost", conn.safe_url);
        assertEq(Plain, conn.getInfo().url_hash.db);
        assertEq(Plain, conn.getInfoAsData().url_hash.db);
        hash<PingInfo> rv = conn.ping();
        assertTrue(rv.ok, rv.info);
        assertEq(Plain, parse_datasource(rv.url.substr(5)).db);
    }

    separatedName() {
        # a database name with "=" or ";" is masked whatever the driver declares
        DatasourceConnection conn("c7275", "test", "db://dbitest:user/pass@" + Separated + "{min=1,max=2}");
        checkMasked(conn, "s3cr3t-7275");
    }

    driverNotLoaded() {
        # the capability of a driver that is not loaded is not known and the driver is not loaded to mask it: the
        # character rule alone decides
        DatasourceConnection conn("c7275", "test", "db://qore7275nodriver:user/pass@" + Plain + "{min=1,max=2}");
        assertEq(Plain, parse_datasource(conn.safe_url.substr(5)).db);
        conn = new DatasourceConnection("c7275", "test", "db://qore7275nodriver:user/pass@" + Separated
            + "{min=1,max=2}");
        checkMasked(conn, "s3cr3t-7275");
        assertFalse(inlist("qore7275nodriver", dbi_get_driver_list() ?? ()));
    }

    private checkMasked(DatasourceConnection conn, string text) {
        assertFalse(conn.safe_url.find(text) >= 0, conn.safe_url);
        assertEq("****", parse_datasource(conn.safe_url.substr(5)).db);
        hash<ConnectionInfo> info = conn.getInfo();
        assertFalse(sprintf("%y", info).find(text) >= 0);
        assertEq("****", info.url_hash.db);
        assertFalse(sprintf("%y", conn.getInfo(False)).find(text) >= 0);
        hash<ConnectionDataInfo> dinfo = conn.getInfoAsData();
        assertFalse(sprintf("%y", dinfo).find(text) >= 0);
        assertEq("****", dinfo.url_hash.db);
        assertFalse(sprintf("%y", conn.getExtendedInfo()).find(text) >= 0);
        assertFalse(sprintf("%y", conn.getExtendedInfoAsData()).find(text) >= 0);
        hash<PingInfo> rv = conn.ping();
        assertFalse(sprintf("%y", rv).find(text) >= 0);
    }
}
