%modern
%enable-all-warnings

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires DataProvider
%requires SqlUtil
%requires DbDataProvider

%exec-class DbForeignConstraintTypeTest

#! Tests the foreign constraint data types; no database connection is required
public class DbForeignConstraintTypeTest inherits QUnit::Test {
    constructor() : Test("DbForeignConstraintTypeTest", "1.0") {
        addTestCase("target_columns is optional", \targetColumnsOptionalTest());
        addTestCase("required keys are enforced", \requiredKeysTest());
        addTestCase("constraint hashes are accepted by name", \constraintsTypeTest());
        set_return_value(main());
    }

    #! \c target_columns is only needed when the foreign columns are named differently
    private targetColumnsOptionalTest() {
        DbForeignConstraintDataType t();
        *AbstractDataField f = t.getFields().target_columns;
        assertTrue(exists f, "target_columns field is present");
        assertFalse(f.isMandatory(), "target_columns is optional");

        # a constraint without "target_columns" must be accepted unchanged
        hash<auto> v = t.acceptsValue({
            "columns": "id",
            "table": "other_table",
        });
        assertEq(("id",), v.columns);
        assertEq("other_table", v.table);
        assertFalse(v.hasKey("target_columns") && exists v.target_columns,
            "no target_columns value is generated");

        # an explicit value is still accepted and converted to a list
        v = t.acceptsValue({
            "columns": ("id", "tenant_id"),
            "table": "other_table",
            "target_columns": ("other_id", "other_tenant_id"),
        });
        assertEq(("other_id", "other_tenant_id"), v.target_columns);
    }

    #! the other two keys are required and must be reported when absent
    private requiredKeysTest() {
        DbForeignConstraintDataType t();
        assertTrue(t.getFields().columns.isMandatory(), "columns is mandatory");
        assertTrue(t.getFields().table.isMandatory(), "table is mandatory");

        assertThrows("MISSING-VALUE-ERROR", "required field \"table\" is absent", \t.acceptsValue(), {
            "columns": "id",
        });
        assertThrows("MISSING-VALUE-ERROR", "required field \"columns\" is absent", \t.acceptsValue(), {
            "table": "other_table",
        });
    }

    #! the containing type keys constraints by name
    private constraintsTypeTest() {
        DbForeignConstraintsDataType t();
        hash<auto> v = t.acceptsValue({
            "fk_test": {
                "columns": "id",
                "table": "other_table",
            },
        });
        assertEq(("id",), v.fk_test.columns);
        assertEq("other_table", v.fk_test.table);
    }
}
