%modern
%enable-all-warnings

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires DataProvider
%requires SqlUtil
%requires BulkSqlUtil
%requires DbDataProvider
%requires Schema

%exec-class DbTableDataProviderUpsertBulkTest

const TestTableName = "dp_upsert_bulk_test";

#! Schema for the test table
class TestSchema inherits AbstractSchema {
    public {
        const SchemaName = "DpUpsertBulkTestSchema";
        const SchemaVersion = "1.0";

        const T_Test = {
            "columns": {
                "id": c_number(15, True, "PK column"),
                "name": c_varchar(200, True, "name column"),
                "value": c_number(15, True, "value column"),
            },
            "primary_key": {"name": "pk_" + TestTableName, "columns": "id"},
        };

        const Tables = {
            TestTableName: T_Test,
        };
    }

    constructor(AbstractDatasource ds, *string dts, *string its) : AbstractSchema(ds, dts, its) {
    }

    private string getNameImpl() {
        return SchemaName;
    }

    private string getVersionImpl() {
        return SchemaVersion;
    }

    private *hash<auto> getTablesImpl() {
        return Tables;
    }
}

class DbTableDataProviderUpsertBulkTest inherits QUnit::Test {
    private {
        const MyOpts = Opts + {
            "connstr": "c,conn=s",
        };

        const OptionColumn = 22;
    }

    constructor() : Test("DbTableDataProviderUpsertBulk", "1.0", \ARGV, MyOpts) {
        addTestCase("upsertRecordsBulk default strategy", \testUpsertBulkDefaultStrategy());
        addTestCase("upsertRecordsBulk explicit strategy", \testUpsertBulkExplicitStrategy());
        addTestCase("upsertRecordsBulk insert then upsert", \testUpsertBulkInsertThenUpsert());
        addTestCase("columnar bulk shapes", \testColumnarBulkShapes());
        addTestCase("transactional mutation limits", \testTransactionalMutationLimits());

        set_return_value(main());
    }

    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-c,--conn=ARG", "set DB connection argument (ex: \"pgsql:user/pass@db\")", OptionColumn);
    }

    private Datasource getDatasource() {
        string connstr = m_options.connstr ?? ENV.QORE_DB_CONNSTR_PGSQL ?? "";
        if (!connstr) {
            throw "SKIP", "no DB connection string; set -c or QORE_DB_CONNSTR_PGSQL";
        }
        Datasource ds(connstr);
        ds.open();
        return ds;
    }

    #! Test that upsertRecordsBulk works with the default strategy (no explicit upsert_strategy)
    /** This was broken: the default string "UpsertAuto" was passed to BulkUpsertOperation
        which expected an integer constant.
    */
    private testUpsertBulkDefaultStrategy() {
        Datasource ds;
        try {
            ds = getDatasource();
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "SKIP") {
                testSkip(ex.desc);
            }
            rethrow;
        }

        TestSchema schema(ds);
        schema.align(False, m_options.verbose);
        on_exit schema.drop(False, m_options.verbose);

        Table t(ds, TestTableName);
        AbstractTable at = t.getTable();
        on_success at.commit();
        on_error at.rollback();
        at.del({});

        # Get the data provider for the table
        DbTableDataProvider provider(at);

        # Insert records via upsertRecordsBulk with NO explicit upsert_strategy
        list<hash<auto>> recs = (
            {"id": 1, "name": "alice", "value": 100},
            {"id": 2, "name": "bob", "value": 200},
            {"id": 3, "name": "carol", "value": 300},
        );

        # This should not throw — the default "UpsertAuto" string must be mapped to the
        # integer constant AbstractTable::UpsertAuto
        *list<string> result = provider.upsertRecordsBulk(recs);
        assertTrue(exists result, "upsertRecordsBulk should return results");
        assertEq(3, result.size(), "should have 3 upsert results");

        # Verify records exist
        list<auto> rows = at.selectRows({"orderby": "id"});
        assertEq(3, rows.size(), "should have 3 rows");
        assertEq("alice", rows[0].name);
        assertEq("bob", rows[1].name);
        assertEq("carol", rows[2].name);
    }

    #! Test that upsertRecordsBulk works with an explicit string strategy
    private testUpsertBulkExplicitStrategy() {
        Datasource ds;
        try {
            ds = getDatasource();
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "SKIP") {
                testSkip(ex.desc);
            }
            rethrow;
        }

        TestSchema schema(ds);
        schema.align(False, m_options.verbose);
        on_exit schema.drop(False, m_options.verbose);

        Table t(ds, TestTableName);
        AbstractTable at = t.getTable();
        on_success at.commit();
        on_error at.rollback();
        at.del({});

        DbTableDataProvider provider(at);

        list<hash<auto>> recs = (
            {"id": 1, "name": "dave", "value": 400},
            {"id": 2, "name": "eve", "value": 500},
        );

        # Explicit UpsertInsertFirst strategy as string
        *list<string> result = provider.upsertRecordsBulk(recs, {"upsert_strategy": "UpsertInsertFirst"});
        assertTrue(exists result, "upsertRecordsBulk with explicit strategy should return results");
        assertEq(2, result.size(), "should have 2 upsert results");

        list<auto> rows = at.selectRows({"orderby": "id"});
        assertEq(2, rows.size(), "should have 2 rows");
        assertEq("dave", rows[0].name);
        assertEq("eve", rows[1].name);
    }

    #! Test insert then upsert: records are inserted first, then upserted with updated values
    private testUpsertBulkInsertThenUpsert() {
        Datasource ds;
        try {
            ds = getDatasource();
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "SKIP") {
                testSkip(ex.desc);
            }
            rethrow;
        }

        TestSchema schema(ds);
        schema.align(False, m_options.verbose);
        on_exit schema.drop(False, m_options.verbose);

        Table t(ds, TestTableName);
        AbstractTable at = t.getTable();
        on_success at.commit();
        on_error at.rollback();
        at.del({});

        DbTableDataProvider provider(at);

        # First: insert records
        list<hash<auto>> initial_recs = (
            {"id": 1, "name": "alice", "value": 100},
            {"id": 2, "name": "bob", "value": 200},
        );
        provider.upsertRecordsBulk(initial_recs);

        # Second: upsert with updated values and a new record
        list<hash<auto>> updated_recs = (
            {"id": 1, "name": "alice-updated", "value": 150},
            {"id": 2, "name": "bob-updated", "value": 250},
            {"id": 3, "name": "carol", "value": 300},
        );
        *list<string> result = provider.upsertRecordsBulk(updated_recs);
        assertEq(3, result.size(), "should have 3 upsert results");

        # Verify the upserted state
        list<auto> rows = at.selectRows({"orderby": "id"});
        assertEq(3, rows.size(), "should have 3 rows after upsert");
        assertEq("alice-updated", rows[0].name, "alice should be updated");
        assertEq(150, rows[0].value, "alice value should be updated");
        assertEq("bob-updated", rows[1].name, "bob should be updated");
        assertEq(250, rows[1].value, "bob value should be updated");
        assertEq("carol", rows[2].name, "carol should be inserted");
        assertEq(300, rows[2].value, "carol value should be correct");
    }

    private testTransactionalMutationLimits() {
        Datasource ds;
        try {
            ds = getDatasource();
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "SKIP") {
                testSkip(ex.desc);
            }
            rethrow;
        }

        TestSchema schema(ds);
        schema.align(False, m_options.verbose);
        on_exit schema.drop(False, m_options.verbose);

        AbstractTable table = (new Table(ds, TestTableName)).getTable();
        DbTableDataProvider provider(table);
        provider.upsertRecordsBulk((
            {"id": 1, "name": "same", "value": 10},
            {"id": 2, "name": "same", "value": 20},
            {"id": 3, "name": "other", "value": 30},
        ));

        assertThrows("UPDATE-SINGLE-RECORD-ERROR", "the update has been rolled back", sub () {
            provider.updateSingleRecord({"value": 99}, {"name": "same"});
        });
        assertEq((10, 20, 30), map $1.value, table.selectRows({"orderby": "id"}));

        assertThrows("MAX-RECORDS-EXCEEDED", "the delete has been rolled back", sub () {
            provider.deleteRecords({}, {"max_records": 2});
        });
        assertEq((1, 2, 3), map $1.id, table.selectRows({"orderby": "id"}));

        AbstractDataProviderRecordIterator iter = provider.searchRecords({"name": "same"}, {"orderby": "id",
            "limit": 2});
        assertTrue(exists iter.getRecordType().id);
        AbstractDataProviderBulkRecordInterface bulk = iter.getBulkApi(1);
        assertEq(2, bulk.getLimit());
        list<int> ids;
        while (True) {
            *hash<auto> block = bulk.getValue();
            if (!exists block) {
                break;
            }
            ids += block.id;
        }
        assertEq((1, 2), ids);
        assertFalse(ds.currentThreadInTransaction());
    }

    #! Test that DB providers expose and consume native columnar bulk shapes
    private testColumnarBulkShapes() {
        Datasource ds;
        try {
            ds = getDatasource();
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "SKIP") {
                testSkip(ex.desc);
            }
            rethrow;
        }

        TestSchema schema(ds);
        schema.align(False, m_options.verbose);
        on_exit schema.drop(False, m_options.verbose);

        Table t(ds, TestTableName);
        AbstractTable at = t.getTable();
        on_success at.commit();
        on_error at.rollback();
        at.del({});

        DbTableDataProvider provider(at);
        assertTrue(provider.supportsBulkReadShape(DataProviderShape::BufferColumns),
            "table provider advertises BufferColumns bulk reads");
        assertTrue(provider.supportsBulkCreateShape(DataProviderShape::BufferColumns),
            "table provider advertises BufferColumns bulk creates");
        assertTrue(provider.supportsBulkUpsertShape(DataProviderShape::BufferColumns),
            "table provider advertises BufferColumns bulk upserts");

        ColumnarResult create_columns = ColumnarResult::fromColumnHash({
            "id": new buffer<int64>((11, 12, 13)),
            "name": ("delta", "echo", "foxtrot"),
            "value": new buffer<int64>((1100, 1200, 1300)),
        });
        *hash<auto> created = provider.createRecordsBulk(create_columns, {"block_size": 2});
        assertEq((11, 12, 13), created.id, "ColumnarResult create returns inserted ids");
        assertEq(("delta", "echo", "foxtrot"), created.name, "ColumnarResult create returns inserted names");

        AbstractDataProviderBulkRecordInterface table_bulk = provider.getBulkRecordInterface(2);
        assertEq(DataProviderShape::BufferColumns, table_bulk.getValueShape(),
            "table provider bulk iterator advertises BufferColumns");
        *auto table_block = table_bulk.getShapedValue();
        assertEq(DataProviderShape::BufferColumns, AbstractDataProcessor::detectShape(table_block),
            "table provider bulk iterator returns BufferColumns data");
        assertEq(2, AbstractDataProcessor::shapeRecordCount(table_block, DataProviderShape::BufferColumns),
            "table provider shaped bulk read respects the block size");

        DbDataProvider raw_provider(ds);
        assertTrue(raw_provider.supportsBulkReadShape(DataProviderShape::BufferColumns),
            "raw DB provider advertises BufferColumns bulk reads");
        AbstractDataProviderBulkRecordInterface raw_bulk = raw_provider.getBulkRecordInterface(10, {
            "sql": sprintf("select id, name, value from %s order by id", TestTableName),
        });
        assertEq(DataProviderShape::BufferColumns, raw_bulk.getValueShape(),
            "raw DB provider bulk iterator advertises BufferColumns");
        *auto raw_block = raw_bulk.getShapedValue();
        hash<auto> raw_rows = AbstractDataProcessor::convertShape(raw_block, DataProviderShape::BufferColumns,
            DataProviderShape::HashOfLists)[0];
        # scale-0 NUMERIC(15,0) columns narrow to int64 in the columnar fetch path, matching the
        # scalar/row fetch paths (see columnar_decimal_narrows_to_int64() in lib/QoreColumnarResult.cpp)
        assertEq((11, 12, 13), raw_rows.id, "raw DB provider shaped bulk read preserves ids");
        assertEq(("delta", "echo", "foxtrot"), raw_rows.name, "raw DB provider shaped bulk read preserves names");
        assertEq((1100, 1200, 1300), raw_rows.value, "raw DB provider shaped bulk read preserves values");

        ColumnarResult upsert_columns = ColumnarResult::fromColumnHash({
            "id": new buffer<int64>((12, 13, 14)),
            "name": ("echo-updated", "foxtrot-updated", "golf"),
            "value": new buffer<int64>((2200, 2300, 2400)),
        });
        *list<string> upserted = provider.upsertRecordsBulk(upsert_columns, {"block_size": 2});
        assertEq(3, upserted.size(), "ColumnarResult upsert returns a result per row");

        list<auto> rows = at.selectRows({"orderby": "id"});
        assertEq(4, rows.size(), "columnar create plus upsert leaves four rows");
        assertEq("echo-updated", rows[1].name, "ColumnarResult upsert updates existing rows");
        assertEq(2200, rows[1].value, "ColumnarResult upsert updates existing values");
        assertEq("golf", rows[3].name, "ColumnarResult upsert inserts new rows");
        assertEq(2400, rows[3].value, "ColumnarResult upsert inserts new values");
    }
}
