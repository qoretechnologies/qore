%new-style
%strict-args
%require-types
%enable-all-warnings

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/AsyncApi.qm

%exec-class AsyncApiGeneratorTest

class AsyncApiGeneratorTest inherits Test {
    constructor() : Test("AsyncApiGeneratorTest", "1.0") {
        addTestCase("parseEventBlock basic test", \testParseEventBlockBasic());
        addTestCase("parseEventBlock with info fields", \testParseEventBlockWithInfo());
        addTestCase("parseEventBlocks multiple events", \testParseEventBlocksMultiple());
        addTestCase("parseChannelBlock basic test", \testParseChannelBlockBasic());
        addTestCase("parseChannelBlocks multiple channels", \testParseChannelBlocksMultiple());
        addTestCase("type mapper basic types", \testTypeMapperBasicTypes());
        addTestCase("type mapper complex types", \testTypeMapperComplexTypes());
        addTestCase("type mapper nullable types", \testTypeMapperNullableTypes());
        addTestCase("generator basic test", \testGeneratorBasic());
        addTestCase("generator with events", \testGeneratorWithEvents());
        addTestCase("generator with channels", \testGeneratorWithChannels());
        addTestCase("generator output formats", \testGeneratorOutputFormats());
        addTestCase("malformed event block", \testMalformedEventBlock());
        addTestCase("malformed channel block", \testMalformedChannelBlock());
        addTestCase("empty content", \testEmptyContent());
        addTestCase("whitespace handling", \testWhitespaceHandling());
        addTestCase("special characters", \testSpecialCharacters());
        addTestCase("complex info schema", \testComplexInfoSchema());
        addTestCase("severity levels", \testSeverityLevels());
        addTestCase("event class extraction", \testEventClassExtraction());
        addTestCase("round-trip test", \testRoundTrip());
        addTestCase("unknown types fallback", \testUnknownTypesFallback());
        addTestCase("nested hash types", \testNestedHashTypes());
        addTestCase("list types", \testListTypes());
        set_return_value(main());
    }

    testParseEventBlockBasic() {
        string block = "@EVENT TEST_EVENT
@EVENTSCHEMA
@summary A test event
@desc This is a test event description
@class TEST
@severity INFO
@ENDEVENTSCHEMA";

        hash<AsyncApi::EventSchemaInfo> event = AsyncApi::AsyncApiSchemaTokenizer::parseEventBlock(block);

        assertEq("TEST_EVENT", event.name, "Event name should be extracted");
        assertEq("A test event", event.summary, "Summary should be extracted");
        assertEq("This is a test event description", event.desc, "Description should be extracted");
        assertEq("TEST", event.event_class, "Event class should be extracted");
        assertEq("INFO", event.severity, "Severity should be extracted");
    }

    testParseEventBlockWithInfo() {
        string block = "@EVENT STATUS_CHANGED
@EVENTSCHEMA
@summary Status changed event
@class WORKFLOW
@severity WARNING
@info
- workflow_id (int): The workflow ID
- status (string): The new status
- timestamp (date): When the change occurred
@ENDEVENTSCHEMA";

        hash<AsyncApi::EventSchemaInfo> event = AsyncApi::AsyncApiSchemaTokenizer::parseEventBlock(block);

        assertEq("STATUS_CHANGED", event.name, "Event name should be extracted");
        assertEq("WORKFLOW", event.event_class, "Event class should be extracted");
        assertEq("WARNING", event.severity, "Severity should be extracted");
        assertTrue(event.info_schema.hasKey("type"), "Info schema should have type");
        assertTrue(event.info_schema.hasKey("properties"), "Info schema should have properties");
        assertTrue(event.info_schema.properties.hasKey("workflow_id"), "Should have workflow_id property");
        assertTrue(event.info_schema.properties.hasKey("status"), "Should have status property");
        assertTrue(event.info_schema.properties.hasKey("timestamp"), "Should have timestamp property");
    }

    testParseEventBlocksMultiple() {
        string content = "Some code here
/** @EVENT FIRST_EVENT
    @EVENTSCHEMA
    @summary First event
    @class TEST
    @severity INFO
    @ENDEVENTSCHEMA
*/

more code

/** @EVENT SECOND_EVENT
    @EVENTSCHEMA
    @summary Second event
    @class TEST
    @severity WARNING
    @ENDEVENTSCHEMA
*/
trailing code";

        list<hash<AsyncApi::EventSchemaInfo>> events = AsyncApi::AsyncApiSchemaTokenizer::parseEventBlocks(content);

        assertEq(2, events.size(), "Should find 2 events");
        assertEq("FIRST_EVENT", events[0].name, "First event name");
        assertEq("SECOND_EVENT", events[1].name, "Second event name");
        assertEq("INFO", events[0].severity, "First event severity");
        assertEq("WARNING", events[1].severity, "Second event severity");
    }

    testParseChannelBlockBasic() {
        string block = "@WEBSOCKET /events
@ASYNCAPI
@summary Event streaming endpoint
@desc WebSocket endpoint for real-time events
@ENDASYNCAPI";

        hash<AsyncApi::ChannelSchemaInfo> channel = AsyncApi::AsyncApiSchemaTokenizer::parseChannelBlock(block);

        assertEq("/events", channel.path, "Channel path should be extracted");
        assertEq("Event streaming endpoint", channel.summary, "Summary should be extracted");
        assertEq("WebSocket endpoint for real-time events", channel.desc, "Description should be extracted");
    }

    testParseChannelBlocksMultiple() {
        string content = "/** @WEBSOCKET /creator
    @ASYNCAPI
    @summary Creator events
    @ENDASYNCAPI
*/

/** @WEBSOCKET /admin
    @ASYNCAPI
    @summary Admin events
    @ENDASYNCAPI
*/";

        list<hash<AsyncApi::ChannelSchemaInfo>> channels = AsyncApi::AsyncApiSchemaTokenizer::parseChannelBlocks(content);

        assertEq(2, channels.size(), "Should find 2 channels");
        assertEq("/creator", channels[0].path, "First channel path");
        assertEq("/admin", channels[1].path, "Second channel path");
    }

    testTypeMapperBasicTypes() {
        # String type
        hash<auto> result = AsyncApi::AsyncApiTypeMapper::mapType("string");
        assertEq("string", result.type, "String maps to string");

        # Integer type
        result = AsyncApi::AsyncApiTypeMapper::mapType("int");
        assertEq("integer", result.type, "Int maps to integer");

        # Float type
        result = AsyncApi::AsyncApiTypeMapper::mapType("float");
        assertEq("number", result.type, "Float maps to number");

        # Boolean type
        result = AsyncApi::AsyncApiTypeMapper::mapType("bool");
        assertEq("boolean", result.type, "Bool maps to boolean");

        # Date type
        result = AsyncApi::AsyncApiTypeMapper::mapType("date");
        assertEq("string", result.type, "Date maps to string");
        assertEq("date-time", result.format, "Date has date-time format");

        # Binary type
        result = AsyncApi::AsyncApiTypeMapper::mapType("binary");
        assertEq("string", result.type, "Binary maps to string");
        assertEq("binary", result.format, "Binary has binary format");
    }

    testTypeMapperComplexTypes() {
        # Hash type
        hash<auto> result = AsyncApi::AsyncApiTypeMapper::mapType("hash");
        assertEq("object", result.type, "Hash maps to object");
        assertTrue(result.additionalProperties, "Hash allows additional properties");

        # Hash with auto
        result = AsyncApi::AsyncApiTypeMapper::mapType("hash<auto>");
        assertEq("object", result.type, "Hash<auto> maps to object");

        # Hash with type name
        result = AsyncApi::AsyncApiTypeMapper::mapType("hash<UserInfo>");
        assertTrue(result.hasKey("$ref"), "Hash<UserInfo> has $ref");
        assertEq("#/components/schemas/UserInfo", result{"$ref"}, "$ref points to component");
    }

    testTypeMapperNullableTypes() {
        # Nullable string
        hash<auto> result = AsyncApi::AsyncApiTypeMapper::mapType("*string");
        assertEq("string", result.type, "*string maps to string");
        assertTrue(result.nullable, "*string is nullable");

        # Nullable int
        result = AsyncApi::AsyncApiTypeMapper::mapType("*int");
        assertEq("integer", result.type, "*int maps to integer");
        assertTrue(result.nullable, "*int is nullable");

        # Test isNullable helper
        assertTrue(AsyncApi::AsyncApiTypeMapper::isNullable("*string"), "*string is nullable");
        assertFalse(AsyncApi::AsyncApiTypeMapper::isNullable("string"), "string is not nullable");

        # Test getBaseType helper
        assertEq("string", AsyncApi::AsyncApiTypeMapper::getBaseType("*string"), "getBaseType removes *");
        assertEq("int", AsyncApi::AsyncApiTypeMapper::getBaseType("int"), "getBaseType preserves non-nullable");
    }

    testGeneratorBasic() {
        AsyncApi::AsyncApiSchemaGenerator gen({
            "title": "Test API",
            "version": "1.0.0",
            "description": "A test API",
        });

        hash<auto> schema = gen.generate();

        assertEq("3.0.0", schema.asyncapi, "AsyncAPI version should be 3.0.0");
        assertEq("Test API", schema.info.title, "Title should match");
        assertEq("1.0.0", schema.info.version, "Version should match");
        assertEq("A test API", schema.info.description, "Description should match");
    }

    testGeneratorWithEvents() {
        AsyncApi::AsyncApiSchemaGenerator gen({
            "title": "Event API",
            "version": "1.0.0",
        });

        gen.addEvent(cast<hash<AsyncApi::EventSchemaInfo>>({
            "name": "USER_CREATED",
            "summary": "User was created",
            "desc": "Fired when a new user is created",
            "event_class": "USER",
            "severity": "INFO",
            "info_schema": {
                "type": "object",
                "properties": {
                    "user_id": {"type": "integer"},
                    "username": {"type": "string"},
                },
            },
        }));

        hash<auto> schema = gen.generate();

        assertTrue(schema.hasKey("components"), "Should have components");
        assertTrue(schema.components.hasKey("schemas"), "Should have schemas");
        assertTrue(schema.components.schemas.hasKey("USER_CREATEDInfo"), "Should have event info schema");
    }

    testGeneratorWithChannels() {
        AsyncApi::AsyncApiSchemaGenerator gen({
            "title": "Channel API",
            "version": "1.0.0",
        });

        gen.addChannel(cast<hash<AsyncApi::ChannelSchemaInfo>>({
            "path": "/stream",
            "summary": "Main event stream",
            "desc": "Primary event streaming endpoint",
        }));

        hash<auto> schema = gen.generate();

        assertTrue(schema.hasKey("channels"), "Should have channels");
        # Channel key is path without leading /
        assertTrue(schema.channels.hasKey("stream"), "Should have stream channel");
        assertEq("/stream", schema.channels{"stream"}.address, "Channel address");
    }

    testGeneratorOutputFormats() {
        AsyncApi::AsyncApiSchemaGenerator gen({
            "title": "Format Test API",
            "version": "1.0.0",
        });

        gen.addEvent(cast<hash<AsyncApi::EventSchemaInfo>>({
            "name": "TEST_EVENT",
            "summary": "Test",
            "severity": "INFO",
        }));

        # Test YAML output
        string yaml = gen.toYaml();
        assertTrue(yaml.size() > 0, "YAML output should not be empty");
        assertTrue(yaml.find("asyncapi") >= 0, "YAML should contain asyncapi key");
        assertTrue(yaml.find("3.0.0") >= 0, "YAML should contain version");

        # Test JSON output
        string json = gen.toJson();
        assertTrue(json.size() > 0, "JSON output should not be empty");
        assertTrue(json.find("asyncapi") >= 0, "JSON should contain asyncapi key");
    }

    testMalformedEventBlock() {
        # Missing event name
        string block = "@EVENT
@EVENTSCHEMA
@summary No name
@ENDEVENTSCHEMA";

        bool threw = False;
        try {
            AsyncApi::AsyncApiSchemaTokenizer::parseEventBlock(block);
        } catch (hash<ExceptionInfo> ex) {
            threw = True;
            assertTrue(ex.err =~ /PARSE-ERROR/, "Should throw PARSE-ERROR");
        }
        assertTrue(threw, "Should throw exception for missing event name");
    }

    testMalformedChannelBlock() {
        # Missing path
        string block = "@WEBSOCKET
@ASYNCAPI
@summary No path
@ENDASYNCAPI";

        bool threw = False;
        try {
            AsyncApi::AsyncApiSchemaTokenizer::parseChannelBlock(block);
        } catch (hash<ExceptionInfo> ex) {
            threw = True;
            assertTrue(ex.err =~ /PARSE-ERROR/, "Should throw PARSE-ERROR");
        }
        assertTrue(threw, "Should throw exception for missing channel path");
    }

    testEmptyContent() {
        # Empty string
        list<hash<AsyncApi::EventSchemaInfo>> events = AsyncApi::AsyncApiSchemaTokenizer::parseEventBlocks("");
        assertEq(0, events.size(), "Empty content should return empty list");

        list<hash<AsyncApi::ChannelSchemaInfo>> channels = AsyncApi::AsyncApiSchemaTokenizer::parseChannelBlocks("");
        assertEq(0, channels.size(), "Empty content should return empty list for channels");

        # Content with no schema blocks
        events = AsyncApi::AsyncApiSchemaTokenizer::parseEventBlocks("just some random code here");
        assertEq(0, events.size(), "Content with no blocks should return empty list");
    }

    testWhitespaceHandling() {
        # Block with extra whitespace
        string block = "  @EVENT   WHITESPACE_TEST
@EVENTSCHEMA
  @summary   Lots of whitespace
  @desc   Description with spaces
@class   TEST
@severity   INFO
@ENDEVENTSCHEMA";

        hash<AsyncApi::EventSchemaInfo> event = AsyncApi::AsyncApiSchemaTokenizer::parseEventBlock(block);

        assertEq("WHITESPACE_TEST", event.name, "Name should be trimmed");
        assertEq("Lots of whitespace", event.summary, "Summary should be trimmed");
    }

    testSpecialCharacters() {
        string block = "@EVENT SPECIAL_CHARS
@EVENTSCHEMA
@summary Event with 'quotes' and \"double quotes\"
@desc Description with special chars: <>&
@class TEST
@severity INFO
@ENDEVENTSCHEMA";

        hash<AsyncApi::EventSchemaInfo> event = AsyncApi::AsyncApiSchemaTokenizer::parseEventBlock(block);

        assertEq("SPECIAL_CHARS", event.name, "Name should be extracted");
        assertTrue(event.summary.size() > 0, "Summary with special chars should be parsed");
    }

    testComplexInfoSchema() {
        string block = "@EVENT COMPLEX_INFO
@EVENTSCHEMA
@summary Complex info
@class TEST
@severity INFO
@info
- id (int): Primary ID
- name (string): Entity name
- metadata (*hash<auto>): Optional metadata
- tags (list<string>): List of tags
- created_at (date): Creation timestamp
@ENDEVENTSCHEMA";

        hash<AsyncApi::EventSchemaInfo> event = AsyncApi::AsyncApiSchemaTokenizer::parseEventBlock(block);

        assertTrue(event.info_schema.hasKey("properties"), "Should have properties");
        hash<auto> props = event.info_schema.properties;

        assertTrue(props.hasKey("id"), "Should have id");
        assertTrue(props.hasKey("name"), "Should have name");
        assertTrue(props.hasKey("metadata"), "Should have metadata");
        assertTrue(props.hasKey("tags"), "Should have tags");
        assertTrue(props.hasKey("created_at"), "Should have created_at");
    }

    testSeverityLevels() {
        list<string> severities = ("INFO", "WARNING", "MINOR", "MAJOR", "FATAL");

        foreach string sev in (severities) {
            string block = "@EVENT TEST_" + sev + "
@EVENTSCHEMA
@summary Test
@class TEST
@severity " + sev + "
@ENDEVENTSCHEMA";

            hash<AsyncApi::EventSchemaInfo> event = AsyncApi::AsyncApiSchemaTokenizer::parseEventBlock(block);
            assertEq(sev, event.severity, "Severity " + sev + " should be parsed");
        }
    }

    testEventClassExtraction() {
        list<string> classes = ("WORKFLOW", "SERVICE", "JOB", "SYSTEM", "USER", "CUSTOM_CLASS");

        foreach string cls in (classes) {
            string block = "@EVENT TEST_" + cls + "
@EVENTSCHEMA
@summary Test
@class " + cls + "
@severity INFO
@ENDEVENTSCHEMA";

            hash<AsyncApi::EventSchemaInfo> event = AsyncApi::AsyncApiSchemaTokenizer::parseEventBlock(block);
            assertEq(cls, event.event_class, "Class " + cls + " should be parsed");
        }
    }

    testRoundTrip() {
        # Create a generator with complete data
        AsyncApi::AsyncApiSchemaGenerator gen({
            "title": "Round Trip API",
            "version": "2.0.0",
            "description": "Testing round trip",
        });

        gen.addEvent(cast<hash<AsyncApi::EventSchemaInfo>>({
            "name": "RT_EVENT",
            "summary": "Round trip event",
            "desc": "Event for round trip testing",
            "event_class": "TEST",
            "severity": "INFO",
            "info_schema": {
                "type": "object",
                "properties": {
                    "id": {"type": "integer"},
                },
            },
        }));

        gen.addChannel(cast<hash<AsyncApi::ChannelSchemaInfo>>({
            "path": "/roundtrip",
            "summary": "RT channel",
        }));

        gen.addServer("production", {
            "url": "wss://api.example.com",
            "protocol": "wss",
        });

        # Generate and validate structure
        hash<auto> schema = gen.generate();

        assertEq("3.0.0", schema.asyncapi, "Version preserved");
        assertEq("Round Trip API", schema.info.title, "Title preserved");
        assertEq("2.0.0", schema.info.version, "API version preserved");
        assertTrue(schema.channels.hasKey("roundtrip"), "Channel preserved");
        assertTrue(schema.servers.hasKey("production"), "Server preserved");
        assertTrue(schema.components.schemas.hasKey("RT_EVENTInfo"), "Event schema preserved");
    }

    testUnknownTypesFallback() {
        # Test unknown type handling
        hash<auto> result = AsyncApi::AsyncApiTypeMapper::mapType("unknowntype");
        assertEq("object", result.type, "Unknown type maps to object");
        assertTrue(result.additionalProperties, "Unknown type allows additional properties");

        # Empty type
        result = AsyncApi::AsyncApiTypeMapper::mapType("");
        assertEq("object", result.type, "Empty type maps to object");

        # Softint
        result = AsyncApi::AsyncApiTypeMapper::mapType("softint");
        assertEq("integer", result.type, "Softint maps to integer");

        # Softbool
        result = AsyncApi::AsyncApiTypeMapper::mapType("softbool");
        assertEq("boolean", result.type, "Softbool maps to boolean");
    }

    testNestedHashTypes() {
        # Hash with type parameter
        hash<auto> result = AsyncApi::AsyncApiTypeMapper::mapType("hash<EventInfo>");
        assertTrue(result.hasKey("$ref"), "Hash<EventInfo> should have $ref");
        assertEq("#/components/schemas/EventInfo", result{"$ref"}, "$ref correct");

        # Nullable hash with type
        result = AsyncApi::AsyncApiTypeMapper::mapType("*hash<UserData>");
        assertTrue(result.nullable, "Nullable hash should be nullable");
        assertTrue(result.hasKey("$ref"), "Nullable hash should have $ref");
    }

    testListTypes() {
        # Simple list
        hash<auto> result = AsyncApi::AsyncApiTypeMapper::mapType("list<string>");
        assertEq("array", result.type, "List maps to array");
        assertTrue(result.hasKey("items"), "List should have items");
        assertEq("string", result.items.type, "List item type");

        # List of integers
        result = AsyncApi::AsyncApiTypeMapper::mapType("list<int>");
        assertEq("array", result.type, "List<int> maps to array");
        assertEq("integer", result.items.type, "List<int> item type");

        # Nullable list
        result = AsyncApi::AsyncApiTypeMapper::mapType("*list<hash<auto>>");
        assertEq("array", result.type, "*list maps to array");
        assertTrue(result.nullable, "Nullable list is nullable");

        # Plain list without type parameter
        result = AsyncApi::AsyncApiTypeMapper::mapType("list");
        assertEq("array", result.type, "Plain list maps to array");
    }
}
