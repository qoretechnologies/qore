#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

# try importing JSON and YAML modules
%requires json
%try-module yaml
%define NoYaml
%endtry

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires FsUtil
%requires Logger
%requires HttpServerUtil
%requires RestSchemaValidator
%requires WebSocketUtil
%requires WebSocketClient
%requires DataProvider
%requires AsyncApi
%requires AsyncApiDataProvider

%exec-class AsyncApiDataProviderTest

class CapturingAsyncApiTransport inherits AsyncApiDataProvider::AbstractAsyncApiTransport {
    private {
        list<hash<auto>> sent;
        bool connected = True;
        *code<nothing(auto, *hash<auto>)> inbound_callback;
        *hash<auto> subscription;
        bool unsubscribed = False;
    }

    send(string channel, auto msg, *hash<auto> headers) {
        sent += {
            "channel": channel,
            "msg": msg,
            "headers": headers,
        };
    }

    string getProtocol() {
        return "test";
    }

    bool isConnected() {
        return connected;
    }

    connect() {
        connected = True;
    }

    auto subscribe(string channel, code<nothing(auto, *hash<auto>)> callback, *hash<auto> options) {
        inbound_callback = callback;
        subscription = {
            "channel": channel,
            "options": options,
        };
        unsubscribed = False;
        return subscription;
    }

    unsubscribe(auto subscription) {
        unsubscribed = True;
        inbound_callback = NOTHING;
    }

    disconnect() {
        connected = False;
    }

    list<hash<auto>> getSent() {
        return sent;
    }

    hash<auto> getSubscription() {
        return subscription;
    }

    bool isUnsubscribed() {
        return unsubscribed;
    }

    emit(auto msg, *hash<auto> headers) {
        inbound_callback(msg, headers);
    }
}

class QueueObserver inherits DataProvider::Observer {
    private {
        Queue q();
    }

    update(string event_id, hash<auto> data) {
        q.push({
            "event_id": event_id,
            "data": data,
        });
    }

    hash<auto> get(timeout t) {
        return q.get(t);
    }
}

public class AsyncApiDataProviderTest inherits QUnit::Test {
    private {
        string testDir;
    }

    constructor() : Test("AsyncApiDataProviderTest", "1.0") {
        testDir = get_script_dir();
        addTestCase("data provider creation test", \dataProviderCreationTest());
        addTestCase("inline YAML schema markers", \inlineYamlSchemaMarkersTest());
        addTestCase("channel navigation test", \channelNavigationTest());
        addTestCase("operation navigation test", \operationNavigationTest());
        addTestCase("message type test", \messageTypeTest());
        addTestCase("multi-message union type test", \multiMessageUnionTypeTest());
        addTestCase("message send transport test", \messageSendTransportTest());
        addTestCase("receive operation observable transport test", \receiveObservableTransportTest());
        addTestCase("api management endpoint test", \apiManagementEndpointTest());
        set_return_value(main());
    }

    checkModules() {
%ifdef NoYaml
        testSkip("no yaml module");
%endif
    }

    dataProviderCreationTest() {
        checkModules();

        # Test creation from schema file path
        hash<auto> opts = {
            "schema": testDir + "/ChatApi.asyncapi.yaml",
        };
        AsyncApiDataProvider::AsyncApiDataProvider provider(opts);
        assertEq("Chat API", provider.getName());

        # Test description
        *string desc = provider.getDesc();
        assertTrue(exists desc);
        assertTrue(desc.find("Chat API") >= 0);

        # Test that it supports children
        hash<DataProviderInfo> info = provider.getInfo();
        assertTrue(info.supports_children);
        assertEq("asyncapi", info.schema_type);
    }

    inlineYamlSchemaMarkersTest() {
        checkModules();

        hash<auto> opts = {
            "schema": "%YAML 1.2\n---\n"
                + File::readTextFile(testDir + "/ChatApi.asyncapi.yaml"),
        };
        AsyncApiDataProvider::AsyncApiDataProvider provider(opts);
        assertEq("Chat API", provider.getName());
        assertTrue(inlist("userChat", provider.getChildProviderNames()));
    }

    channelNavigationTest() {
        checkModules();

        AsyncApiDataProvider::AsyncApiDataProvider provider({
            "schema": testDir + "/ChatApi.asyncapi.yaml",
        });

        # Get child provider names (channels)
        *list<string> children = provider.getChildProviderNames();
        assertTrue(exists children);
        assertTrue(children.size() >= 2);
        assertTrue(inlist("userChat", children));
        assertTrue(inlist("systemNotifications", children));

        # Get userChat channel provider
        AbstractDataProvider channelProvider = provider.getChildProvider("userChat");
        assertTrue(exists channelProvider);
        assertEq("userChat", channelProvider.getName());

        # Check channel description includes address
        *string channelDesc = channelProvider.getDesc();
        assertTrue(exists channelDesc);
        assertTrue(channelDesc.find("/chat/user") >= 0);
    }

    apiManagementEndpointTest() {
        checkModules();

        AsyncApiDataProvider::AsyncApiDataProvider provider({
            "schema": testDir + "/ChatApi.asyncapi.yaml",
        });

        list<hash<auto>> endpoints = provider.getApiManagementEndpoints();
        hash<string, hash<auto>> emap = map {$1.endpoint: $1}, endpoints;

        # every declared operation is an endpoint, keyed by operation ID
        assertEq(("sendChatMessage", "receiveChatMessage", "sendTypingIndicator", "receiveSystemNotification",
            "sendSystemNotification"), keys emap);
        assertEq(5, endpoints.size());

        # inbound operations are the ones an API management implementation binds handlers to, and they are
        # observable rather than request-capable; walking the provider tree for request-capable providers - the
        # request/response default - returns only the outbound half, so they must come from here
        assertEq("receive", emap.receiveChatMessage.action);
        assertEq("receive", emap.receiveSystemNotification.action);
        assertEq("send", emap.sendChatMessage.action);
        assertEq("send", emap.sendTypingIndicator.action);
        assertEq("send", emap.sendSystemNotification.action);

        list<string> observable = map $1.endpoint, endpoints, $1.action == "receive";
        assertEq(("receiveChatMessage", "receiveSystemNotification"), observable);
        foreach string opid in (observable) {
            AbstractDataProvider op = provider.getChildProviderPath(emap{opid}.channel_name + "/" + opid);
            assertFalse(op.getInfo().supports_request, opid);
            assertTrue(op.getInfo().supports_observable, opid);
        }

        # the endpoint key is the operation ID and not a path through the provider tree: two channels may declare
        # operations with the same ID, and a path key would rebind if a channel were renamed
        map assertEq($1.endpoint, $1.endpoint_id, $1.endpoint), endpoints;
        map assertFalse($1.endpoint =~ /\//, $1.endpoint), endpoints;

        # each endpoint carries its channel, and the address when the channel declares one
        assertEq("userChat", emap.sendChatMessage.channel_name);
        assertEq("/chat/user", emap.sendChatMessage.channel_address);
        assertEq("systemNotifications", emap.receiveSystemNotification.channel_name);
        assertEq("/chat/system", emap.receiveSystemNotification.channel_address);

        # the description is the operation provider's own, so a listing describes an operation exactly as the
        # provider for that operation does
        foreach hash<auto> ep in (endpoints) {
            AbstractDataProvider op = provider.getChildProviderPath(ep.channel_name + "/" + ep.endpoint);
            assertEq(op.getDesc(), ep.desc, ep.endpoint);
        }
        assertTrue(emap.receiveChatMessage.desc.find("Receive a chat message") >= 0);
        assertTrue(emap.receiveChatMessage.desc.find("Receives a chat message from the channel") >= 0);
        assertTrue(emap.sendChatMessage.desc.find("(send)") >= 0);
    }

    operationNavigationTest() {
        checkModules();

        AsyncApiDataProvider::AsyncApiDataProvider provider({
            "schema": testDir + "/ChatApi.asyncapi.yaml",
        });

        # Navigate to channel
        AbstractDataProvider channelProvider = provider.getChildProvider("userChat");

        # Get operations for this channel
        *list<string> operations = channelProvider.getChildProviderNames();
        assertTrue(exists operations);
        assertTrue(operations.size() >= 2);
        assertTrue(inlist("sendChatMessage", operations));
        assertTrue(inlist("receiveChatMessage", operations));

        # Get send operation
        AbstractDataProvider sendOpProvider = channelProvider.getChildProvider("sendChatMessage");
        assertTrue(exists sendOpProvider);
        assertEq("sendChatMessage", sendOpProvider.getName());

        # Check operation info
        hash<DataProviderInfo> sendInfo = sendOpProvider.getInfo();
        assertTrue(sendInfo.supports_request);
        assertEq(DataProvider::MSG_Async, sendInfo.supports_messages);
        assertFalse(sendInfo.supports_observable);

        # Get receive operation
        AbstractDataProvider recvOpProvider = channelProvider.getChildProvider("receiveChatMessage");
        hash<DataProviderInfo> recvInfo = recvOpProvider.getInfo();
        assertFalse(recvInfo.supports_request);
        assertEq(DataProvider::MSG_None, recvInfo.supports_messages);
        assertTrue(recvInfo.supports_observable);
    }

    messageTypeTest() {
        checkModules();

        AsyncApiDataProvider::AsyncApiDataProvider provider({
            "schema": testDir + "/ChatApi.asyncapi.yaml",
        });

        # Navigate to send operation
        AbstractDataProvider sendOpProvider = provider.getChildProviderPath("userChat/sendChatMessage");
        assertTrue(exists sendOpProvider);

        # Get request type (message type for send operations)
        *AbstractDataProviderType reqType = sendOpProvider.getRequestType();
        assertTrue(exists reqType);

        # Check that it has the expected fields
        *hash<string, AbstractDataField> fields = reqType.getFields();
        assertTrue(exists fields);
        assertTrue(fields.hasKey("userId"));
        assertTrue(fields.hasKey("message"));
        assertTrue(fields.hasKey("timestamp"));

        # Check field types
        AbstractDataField userIdField = fields.userId;
        assertEq(NT_STRING, userIdField.getType().getBaseTypeCode());

        AbstractDataField messageField = fields.message;
        assertEq(NT_STRING, messageField.getType().getBaseTypeCode());

        # metadata field should be optional
        if (fields.hasKey("metadata")) {
            AbstractDataField metadataField = fields.metadata;
            assertTrue(metadataField.getType().isOrNothingType());
        }
    }

    string getMultiMessageSchema() {
        return "asyncapi: 3.0.0\n"
            "info:\n"
            "  title: Multi Message API\n"
            "  version: 1.0.0\n"
            "servers:\n"
            "  test:\n"
            "    host: localhost\n"
            "    protocol: kafka\n"
            "channels:\n"
            "  events:\n"
            "    address: events\n"
            "    messages:\n"
            "      Alpha:\n"
            "        $ref: '#/components/messages/Alpha'\n"
            "      Beta:\n"
            "        $ref: '#/components/messages/Beta'\n"
            "operations:\n"
            "  publishEvent:\n"
            "    action: send\n"
            "    channel:\n"
            "      $ref: '#/channels/events'\n"
            "    messages:\n"
            "      - $ref: '#/channels/events/messages/Alpha'\n"
            "      - $ref: '#/channels/events/messages/Beta'\n"
            "  receiveEvent:\n"
            "    action: receive\n"
            "    channel:\n"
            "      $ref: '#/channels/events'\n"
            "    messages:\n"
            "      - $ref: '#/channels/events/messages/Alpha'\n"
            "      - $ref: '#/channels/events/messages/Beta'\n"
            "components:\n"
            "  schemas:\n"
            "    AlphaPayload:\n"
            "      type: object\n"
            "      required: [id, tags]\n"
            "      properties:\n"
            "        id:\n"
            "          type: string\n"
            "        tags:\n"
            "          type: array\n"
            "          items:\n"
            "            type: string\n"
            "    BetaPayload:\n"
            "      type: object\n"
            "      required: [id, amount]\n"
            "      properties:\n"
            "        id:\n"
            "          type: string\n"
            "        amount:\n"
            "          type: integer\n"
            "  messages:\n"
            "    Alpha:\n"
            "      name: Alpha\n"
            "      payload:\n"
            "        $ref: '#/components/schemas/AlphaPayload'\n"
            "    Beta:\n"
            "      name: Beta\n"
            "      payload:\n"
            "        $ref: '#/components/schemas/BetaPayload'\n";
    }

    multiMessageUnionTypeTest() {
        checkModules();

        AsyncApiDataProvider::AsyncApiDataProvider provider({
            "schema": getMultiMessageSchema(),
        });

        AbstractDataProvider opProvider = provider.getChildProviderPath("events/publishEvent");
        AbstractDataProviderType reqType = opProvider.getRequestType();
        assertEq("QoreUnionDataType", reqType.className(), "multi-message request type is a union");

        QoreUnionDataType unionType = cast<QoreUnionDataType>(reqType);
        assertEq(("publishEvent: Alpha", "publishEvent: Beta"),
            map $1.getName(), unionType.getUnionTypes());

        hash<DataTypeInfo> info = reqType.getInfo();
        assertEq(2, info.union_types.size(), "serialized union preserves both alternatives");
        assertEq("*list<string>", info.union_types[0].fields.tags.type.name,
            "nested generic list type is serialized");

        AbstractDataProviderType restoredType = AbstractDataProviderType::get(info);
        assertEq("QoreUnionDataType", restoredType.className(), "serialized union reconstructs");
        QoreUnionDataType restoredUnion = cast<QoreUnionDataType>(restoredType);
        assertEq(("publishEvent: Alpha", "publishEvent: Beta"),
            map $1.getName(), restoredUnion.getUnionTypes());
        assertEq("*list<string>", restoredUnion.getUnionTypes()[0].getField("tags").getType().getName(),
            "nested generic list type reconstructs");

        assertEq({"id": "a1", "tags": ("x", "y")},
            restoredType.acceptsValue({"id": "a1", "tags": ("x", "y")}));
        assertEq({"id": "b1", "amount": 7},
            restoredType.acceptsValue({"id": "b1", "amount": 7}));
        assertThrows("RUNTIME-TYPE-ERROR", \restoredType.acceptsValue(), {"id": "bad", "tags": (1,)});
    }

    messageSendTransportTest() {
        checkModules();

        CapturingAsyncApiTransport transport();
        AsyncApiDataProvider::AsyncApiDataProvider provider({
            "schema": getMultiMessageSchema(),
            "transport": transport,
        });

        AbstractDataProvider opProvider = provider.getChildProviderPath("events/publishEvent");
        opProvider.sendMessage("Alpha", {"id": "a1", "tags": ("x",)}, {"reply_topic": "responses"});

        list<hash<auto>> sent = transport.getSent();
        assertEq(1, sent.size());
        assertEq("events", sent[0].channel);
        assertEq({"id": "a1", "tags": ("x",)}, sent[0].msg);
        assertEq("Alpha", sent[0].headers.message_id);
        assertEq("responses", sent[0].headers.reply_topic);

        assertThrows("INVALID-MESSAGE", \opProvider.sendMessage(),
            ("Missing", {"id": "a1", "tags": ("x",)}, NOTHING));
        assertThrows("SEND-MESSAGE-ERROR", "RUNTIME-TYPE-ERROR", \opProvider.sendMessage(),
            ("Alpha", {"id": "a1", "tags": (1,)}, NOTHING));
    }

    receiveObservableTransportTest() {
        checkModules();

        CapturingAsyncApiTransport transport();
        AsyncApiDataProvider::AsyncApiDataProvider provider({
            "schema": getMultiMessageSchema(),
            "transport": transport,
        });

        AbstractDataProvider opProvider = provider.getChildProviderPath("events/receiveEvent");
        assertEq("events", call_object_method(opProvider, "getChannelName"));
        assertEq("events", call_object_method(opProvider, "getChannelAddress", NOTHING));

        QueueObserver observer();
        DataProvider::Observable observable = cast<DataProvider::Observable>(opProvider);
        observable.registerObserver(observer);
        cast<DataProvider::DelayedObservable>(opProvider).observersReady();

        hash<auto> subscription = transport.getSubscription();
        assertEq("events", subscription.channel);
        assertEq("receiveEvent", subscription.options.operation);

        transport.emit({"id": "a1", "tags": ("x", "y")}, {"trace": "t1"});
        hash<auto> event = observer.get(5s);
        assertEq("Alpha", event.event_id);
        assertEq("a1", event.data.id);
        assertEq(("x", "y"), event.data.tags);
        assertEq("t1", event.data.headers.trace);
        assertEq("Alpha", event.data.message_id);

        assertThrows("SCHEMA-VALIDATION-ERROR", \transport.emit(), ({"id": "bad", "tags": (1,)}, NOTHING));

        cast<DataProvider::DelayedObservable>(opProvider).stopEvents();
        assertTrue(transport.isUnsubscribed());
    }
}
