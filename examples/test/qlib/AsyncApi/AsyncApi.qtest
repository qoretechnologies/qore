#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

# try importing JSON and YAML modules
%try-module json
%define NoJson
%endtry
%try-module yaml
%define NoYaml
%endtry

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/FsUtil.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/HttpServerUtil.qm
%requires ../../../../qlib/RestSchemaValidator.qm
%requires ../../../../qlib/AsyncApi.qm

%exec-class AsyncApiTest

public class AsyncApiTest inherits QUnit::Test {
    private {
        string testDir;
    }

    constructor() : Test("AsyncApiTest", "1.0") {
        testDir = get_script_dir();
        addTestCase("schema parsing test", \schemaParsingTest());
        addTestCase("message validation test", \messageValidationTest());
        addTestCase("ref resolution test", \refResolutionTest());
        addTestCase("channel operations test", \channelOperationsTest());
        addTestCase("validation constraints test", \validationConstraintsTest());
        addTestCase("example parsing test", \exampleParsingTest());
        addTestCase("public schemas test", \publicSchemasTest());
        set_return_value(main());
    }

    checkModules() {
%ifdef NoJson
        testSkip("no json module");
%endif
%ifdef NoYaml
        testSkip("no yaml module");
%endif
    }

    schemaParsingTest() {
        checkModules();

        # Test loading from YAML file
        AsyncApi::AsyncApi3Schema schema = AsyncApi::AsyncApi3Loader::fromFile(testDir + "/ChatApi.asyncapi.yaml");
        assertEq("Chat API", schema.info.title);
        assertEq("1.0.0", schema.info.apiVersion);
        assertEq("3.0.0", schema.asyncapiSpec);

        # Test loading from string
        string yamlContent = File::readTextFile(testDir + "/ChatApi.asyncapi.yaml");
        AsyncApi::AsyncApi3Schema schema2 = AsyncApi::AsyncApi3Loader::fromString(yamlContent);
        assertEq("Chat API", schema2.info.title);
        assertEq("1.0.0", schema2.info.apiVersion);

        # Test info object
        assertTrue(schema.info instanceof AsyncApi::InfoObject);
        assertEq("A sample chat API for testing AsyncAPI 3.0 validation", schema.info.desc);
    }

    messageValidationTest() {
        checkModules();

        AsyncApi::AsyncApi3Schema schema = AsyncApi::AsyncApi3Loader::fromFile(testDir + "/ChatApi.asyncapi.yaml");

        # Test valid outgoing message
        hash<auto> validMessage = {
            "userId": "user123",
            "message": "Hello, world!",
            "timestamp": "2024-01-15T10:30:00Z",
        };
        hash<auto> headers = {};

        # Should not throw
        schema.validateOutgoingMessage("userChat", \validMessage, \headers);
        assertTrue(True);

        # Test valid typing indicator
        hash<auto> typingMessage = {
            "userId": "user123",
            "isTyping": True,
        };
        schema.validateOutgoingMessage("userChat", \typingMessage, \headers);
        assertTrue(True);

        # Test invalid message - missing required field
        hash<auto> invalidMessage = {
            "message": "Hello without userId",
        };
        try {
            schema.validateOutgoingMessage("userChat", \invalidMessage, \headers);
            fail("Expected SCHEMA-VALIDATION-ERROR");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("SCHEMA-VALIDATION-ERROR", ex.err);
        }
    }

    refResolutionTest() {
        checkModules();

        AsyncApi::AsyncApi3Schema schema = AsyncApi::AsyncApi3Loader::fromFile(testDir + "/ChatApi.asyncapi.yaml");

        # Test channel lookup
        *AsyncApi::ChannelObject channel = schema.getChannel("userChat");
        assertTrue(exists channel);
        assertEq("/chat/user", channel.address);
        assertEq("Channel for user chat messages", channel.desc);

        # Test that messages are resolved via $ref
        assertTrue(exists channel.messages);
        assertTrue(channel.messages.hasKey("chatMessage"));

        # Test operation lookup
        *AsyncApi::OperationObject op = schema.getOperation("sendChatMessage");
        assertTrue(exists op);
        assertEq("send", op.action);
        assertEq("Send a chat message", op.summary);

        # Test that operation references are resolved
        assertEq("userChat", op.channelName);
        assertTrue(exists op.channel);

        # Test messages list is populated
        assertTrue(op.messages.size() > 0);
        AsyncApi::MessageObject msg = op.messages[0];
        assertTrue(exists msg.payload);
    }

    channelOperationsTest() {
        checkModules();

        AsyncApi::AsyncApi3Schema schema = AsyncApi::AsyncApi3Loader::fromFile(testDir + "/ChatApi.asyncapi.yaml");

        # Test getChannelOperationHash
        hash<string, list<string>> channelOps = schema.getChannelOperationHash();
        assertTrue(channelOps.hasKey("userChat"));
        assertTrue(channelOps.hasKey("systemNotifications"));

        # userChat should have 3 operations (send, receive, typing)
        list<string> userChatOps = channelOps.userChat;
        assertTrue(userChatOps.size() >= 2);
        assertTrue(inlist("sendChatMessage", userChatOps));
        assertTrue(inlist("receiveChatMessage", userChatOps));

        # systemNotifications should have 1 receive operation
        list<string> systemOps = channelOps.systemNotifications;
        assertTrue(systemOps.size() >= 1);
        assertTrue(inlist("receiveSystemNotification", systemOps));

        # Test operation actions
        *AsyncApi::OperationObject sendOp = schema.getOperation("sendChatMessage");
        assertTrue(sendOp.isSend());
        assertFalse(sendOp.isReceive());

        *AsyncApi::OperationObject recvOp = schema.getOperation("receiveChatMessage");
        assertFalse(recvOp.isSend());
        assertTrue(recvOp.isReceive());
    }

    validationConstraintsTest() {
        checkModules();

        AsyncApi::AsyncApi3Schema schema = AsyncApi::AsyncApi3Loader::fromFile(testDir + "/ChatApi.asyncapi.yaml");

        # Test string length validation
        hash<auto> tooLongMessage = {
            "userId": "user123",
            "message": strmul("x", 5000),  # exceeds maxLength of 4096
            "timestamp": "2024-01-15T10:30:00Z",
        };
        hash<auto> headers = {};
        try {
            schema.validateOutgoingMessage("userChat", \tooLongMessage, \headers);
            fail("Expected SCHEMA-VALIDATION-ERROR for too long message");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("SCHEMA-VALIDATION-ERROR", ex.err);
        }

        # Test enum validation for system messages
        hash<auto> invalidEnumMessage = {
            "type": "invalid_type",  # not in enum
            "message": "Test message",
        };
        try {
            schema.validateOutgoingMessage("systemNotifications", \invalidEnumMessage, \headers);
            fail("Expected SCHEMA-VALIDATION-ERROR for invalid enum");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("SCHEMA-VALIDATION-ERROR", ex.err);
        }

        # Test valid enum value
        hash<auto> validEnumMessage = {
            "type": "info",
            "message": "Test message",
        };
        schema.validateOutgoingMessage("systemNotifications", \validEnumMessage, \headers);
        assertTrue(True);

        # Test empty string validation (minLength: 1)
        hash<auto> emptyMessage = {
            "userId": "user123",
            "message": "",  # empty, but minLength is 1
            "timestamp": "2024-01-15T10:30:00Z",
        };
        try {
            schema.validateOutgoingMessage("userChat", \emptyMessage, \headers);
            fail("Expected SCHEMA-VALIDATION-ERROR for empty message");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("SCHEMA-VALIDATION-ERROR", ex.err);
        }
    }

    #! Test parsing of @example JSON blocks in event and message schemas
    exampleParsingTest() {
        checkModules();

        # Test @example parsing in event schema
        hash<AsyncApi::EventSchemaInfo> event = AsyncApi::AsyncApiSchemaTokenizer::parseEventBlock('
@EVENT WORKFLOW_STATUS_CHANGED
@summary Workflow status changed event
@desc Fired when a workflow instance status changes
@class WORKFLOW
@severity INFO
@info
    - workflow_instanceid (int): Workflow instance ID
    - name (string): Workflow name
@example
{
  "workflow_instanceid": 12345,
  "name": "TestWorkflow"
}
@example
{
  "workflow_instanceid": 99999,
  "name": "AnotherWorkflow"
}
@ENDEVENTSCHEMA
');
        assertEq("WORKFLOW_STATUS_CHANGED", event.name);
        assertEq("Workflow status changed event", event.summary);
        assertTrue(exists event.examples);
        assertEq(2, event.examples.size());
        assertEq(12345, event.examples[0].workflow_instanceid);
        assertEq("TestWorkflow", event.examples[0].name);
        assertEq(99999, event.examples[1].workflow_instanceid);
        assertEq("AnotherWorkflow", event.examples[1].name);

        # Test event schema without examples
        hash<AsyncApi::EventSchemaInfo> simpleEvent = AsyncApi::AsyncApiSchemaTokenizer::parseEventBlock('
@EVENT SIMPLE_EVENT
@summary Simple event without examples
@ENDEVENTSCHEMA
');
        assertEq("SIMPLE_EVENT", simpleEvent.name);
        assertTrue(!simpleEvent.examples || simpleEvent.examples.size() == 0);

        # Test @example parsing in WebSocket channel with messages
        hash<AsyncApi::ChannelSchemaInfo> channel = AsyncApi::AsyncApiSchemaTokenizer::parseChannelBlock('
@WEBSOCKET /events
@summary Event subscription endpoint
@desc WebSocket endpoint for event subscriptions

@subscribe SubscribeRequest
- action (string): Action type
- channel (string): Channel name
@example
{
  "action": "subscribe",
  "channel": "events"
}

@publish EventNotification
- id (string): Event ID
- name (string): Event name
@example
{
  "id": "evt-123",
  "name": "TEST_EVENT"
}
@example
{
  "id": "evt-456",
  "name": "ANOTHER_EVENT"
}
@ENDASYNCAPI
');
        assertEq("/events", channel.path);
        assertEq("Event subscription endpoint", channel.summary);

        # Check subscribe message examples
        assertTrue(exists channel.subscribe_schemas);
        assertEq(1, channel.subscribe_schemas.size());
        assertEq("SubscribeRequest", channel.subscribe_schemas[0].name);
        assertTrue(exists channel.subscribe_schemas[0].examples);
        assertEq(1, channel.subscribe_schemas[0].examples.size());
        assertEq("subscribe", channel.subscribe_schemas[0].examples[0].action);
        assertEq("events", channel.subscribe_schemas[0].examples[0].channel);

        # Check publish message examples
        assertTrue(exists channel.publish_schemas);
        assertEq(1, channel.publish_schemas.size());
        assertEq("EventNotification", channel.publish_schemas[0].name);
        assertTrue(exists channel.publish_schemas[0].examples);
        assertEq(2, channel.publish_schemas[0].examples.size());
        assertEq("evt-123", channel.publish_schemas[0].examples[0].id);
        assertEq("TEST_EVENT", channel.publish_schemas[0].examples[0].name);
        assertEq("evt-456", channel.publish_schemas[0].examples[1].id);

        # Test malformed JSON is silently ignored
        hash<AsyncApi::EventSchemaInfo> badJsonEvent = AsyncApi::AsyncApiSchemaTokenizer::parseEventBlock('
@EVENT BAD_JSON_EVENT
@summary Event with malformed example
@example
{ this is not valid json }
@example
{
  "valid": "json"
}
@ENDEVENTSCHEMA
');
        assertEq("BAD_JSON_EVENT", badJsonEvent.name);
        # Only the valid example should be parsed
        assertTrue(exists badJsonEvent.examples);
        assertEq(1, badJsonEvent.examples.size());
        assertEq("json", badJsonEvent.examples[0].valid);

        # Test schema generation includes examples in messages
        AsyncApi::AsyncApiSchemaGenerator gen({"title": "TestApi", "version": "1.0.0"});
        gen.addChannel(channel);
        hash<auto> schema = gen.generate();

        assertTrue(exists schema.channels);
        assertTrue(schema.channels.hasKey("events"));

        # Check that messages component has examples
        assertTrue(exists schema.components.messages);
        *hash<auto> msgComponent;
        foreach string key in (keys schema.components.messages) {
            if (key =~ /SubscribeRequest/) {
                msgComponent = schema.components.messages{key};
                break;
            }
        }
        assertTrue(exists msgComponent);
        assertTrue(exists msgComponent.examples);
        assertEq(1, msgComponent.examples.size());
        assertEq("subscribe", msgComponent.examples[0].payload.action);

        # Test schema generation includes examples in event info schemas
        gen.addEvent(event);
        schema = gen.generate();

        assertTrue(exists schema.components.schemas);
        *hash<auto> eventInfoSchema;
        foreach string key in (keys schema.components.schemas) {
            if (key =~ /WORKFLOW_STATUS_CHANGED.*Info/) {
                eventInfoSchema = schema.components.schemas{key};
                break;
            }
        }
        assertTrue(exists eventInfoSchema);
        assertTrue(exists eventInfoSchema.examples);
        assertEq(2, eventInfoSchema.examples.size());
        assertEq(12345, eventInfoSchema.examples[0].workflow_instanceid);
    }

    #! Test parsing of public, known-good AsyncAPI 3.0 schemas from GitHub
    publicSchemasTest() {
        checkModules();

        # Official AsyncAPI example schemas from the spec repository
        # Pinned to v3.0.0 tag to avoid breakage when upstream bumps the spec version
        list<hash<auto>> publicSchemas = (
            {
                "name": "simple-asyncapi",
                "url": "https://raw.githubusercontent.com/asyncapi/spec/v3.0.0/examples/simple-asyncapi.yml",
                "expectedTitle": "Account Service",
                "expectedApiVersion": "1.0.0",
            },
            {
                "name": "streetlights-mqtt-asyncapi",
                "url": "https://raw.githubusercontent.com/asyncapi/spec/v3.0.0/examples/streetlights-mqtt-asyncapi.yml",
                "expectedTitle": "Streetlights MQTT API",
                "expectedApiVersion": "1.0.0",
            },
        );

        HTTPClient client({
            "url": "https://raw.githubusercontent.com",
            "timeout": 10s,
            "connect_timeout": 10s,
        });
        try {
            client.connect();
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err =~ /SOCKET|HTTP|SSL/) {
                testSkip(sprintf("Network unavailable: %s", ex.desc));
            }
            rethrow;
        }
        on_exit client.disconnect();

        bool anyPassed = False;

        for (int i = 0; i < publicSchemas.size(); i++) {
            hash<auto> schemaInfo = publicSchemas[i];
            try {
                # Extract path from full URL
                string path = schemaInfo.url;
                path =~ s/https:\/\/raw\.githubusercontent\.com//;

                # Fetch the schema from GitHub
                hash<auto> info;
                *string yamlContent = client.get(path, NOTHING, \info);
                int statusCode = info."response-headers".status_code;
                if (statusCode != 200) {
                    printf("SKIP: Could not fetch %s (HTTP %d)\n", schemaInfo.name, statusCode);
                    continue;
                }

                if (!exists yamlContent) {
                    printf("SKIP: Empty response for %s\n", schemaInfo.name);
                    continue;
                }

                # Parse the schema
                AsyncApi::AsyncApi3Schema schema = AsyncApi::AsyncApi3Loader::fromString(yamlContent);

                # Validate basic structure
                assertEq("3.0.0", schema.asyncapiSpec,
                    sprintf("Schema %s should be AsyncAPI 3.0.0", schemaInfo.name));
                assertEq(schemaInfo.expectedTitle, schema.info.title,
                    sprintf("Schema %s title should match", schemaInfo.name));
                assertEq(schemaInfo.expectedApiVersion, schema.info.apiVersion,
                    sprintf("Schema %s API version should match", schemaInfo.name));
                assertTrue(exists schema.channels,
                    sprintf("Schema %s should have channels", schemaInfo.name));
                assertTrue(exists schema.operations,
                    sprintf("Schema %s should have operations", schemaInfo.name));

                # Test that channels and operations are properly resolved
                hash<string, list<string>> channelOps = schema.getChannelOperationHash();
                assertTrue(channelOps.size() > 0,
                    sprintf("Schema %s should have channel operations", schemaInfo.name));

                anyPassed = True;
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err =~ /SOCKET|HTTP|SSL/) {
                    printf("SKIP: Network error fetching %s: %s\n", schemaInfo.name, ex.desc);
                    continue;
                }
                # Some complex schemas may have features not yet fully supported
                if (ex.err =~ /RUNTIME-TYPE-ERROR/) {
                    printf("SKIP: Schema %s uses unsupported features: %s\n", schemaInfo.name, ex.desc);
                    continue;
                }
                # Re-throw other errors
                rethrow;
            }
        }

        if (!anyPassed) {
            testSkip("Could not fetch any public schemas (network unavailable)");
        }
    }
}
