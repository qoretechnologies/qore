%exec-class GitHubDataProviderTest

#! A recorded outgoing request
hashdecl RecordedRequest {
    string method;
    string path;
    auto body;
    *hash<auto> headers;
}

#! A GitHub REST client that records requests instead of making them
class FakeGitHubRestClient inherits GitHubRestClient::GitHubRestClientIo {
    public {
        #! Every request made, in order
        list<hash<RecordedRequest>> requests = ();

        #! Queued responses, consumed in order
        list<hash<auto>> responses = ();

        #! Used when the response queue is empty
        hash<auto> default_response = {"body": {}, "headers": {}};
    }

    constructor() : GitHubRestClientIo({"token": "fake"}) {
    }

    push_response(hash<auto> resp) {
        push responses, resp;
    }

    reset() {
        requests = ();
        responses = ();
    }

    hash<RecordedRequest> last() {
        if (!requests) {
            throw "TEST-ERROR", "no requests were recorded";
        }
        return requests[requests.size() - 1];
    }

    #! Returns the last request body, decoded when the transport was handed a serialized one
    auto lastBody() {
        auto body = last().body;
        if (body.typeCode() == NT_BINARY) {
            body = binary_to_string(body, "UTF-8");
        }
        if (body.typeCode() == NT_STRING && body.val()) {
            return parse_json(body);
        }
        return body;
    }

    hash<RestClient::RestResponseInfo> restGet(string path, *hash<auto> hdr) {
        return record("GET", path, NOTHING, hdr);
    }

    hash<RestClient::RestResponseInfo> restPost(string path, auto body, *hash<auto> hdr) {
        return record("POST", path, body, hdr);
    }

    hash<RestClient::RestResponseInfo> restPut(string path, auto body, *hash<auto> hdr) {
        return record("PUT", path, body, hdr);
    }

    hash<RestClient::RestResponseInfo> restPatch(string path, auto body, *hash<auto> hdr) {
        return record("PATCH", path, body, hdr);
    }

    hash<RestClient::RestResponseInfo> restDel(string path, auto body, *hash<auto> hdr) {
        return record("DELETE", path, body, hdr);
    }

    hash<RestClient::RestResponseInfo> restDoRequest(string method, string path, auto body,
            *hash<auto> hdr) {
        return record(method, path, body, hdr);
    }

    hash<RestClient::RestResponseInfo> restDoRawRequest(string method, string path, *data body,
            *hash<auto> hdr) {
        return record(method, path, body, hdr);
    }

    private hash<RestClient::RestResponseInfo> record(string method, string path, auto body,
            *hash<auto> hdr) {
        push requests, <RecordedRequest>{
            "method": method,
            "path": path,
            "body": body,
            "headers": hdr,
        };
        hash<auto> resp = responses ? shift responses : default_response;
        if (resp.throw_status) {
            throw "REST-RESPONSE-ERROR", sprintf("HTTP %d response received", resp.throw_status),
                <RestClient::RestResponseInfo>{
                    "status_code": resp.throw_status,
                    "headers": resp.headers ?? {},
                    "body": resp.body,
                    "request_path": path,
                };
        }
        return <RestClient::RestResponseInfo>{
            "status_code": resp.status_code ?? 200,
            "body": resp.body,
            "headers": resp.headers ?? {},
        };
    }
}

#! An issue event provider whose deliveries can be driven directly
class TestGitHubIssueEventProvider inherits GitHubDataProvider::GitHubNewIssueDataProvider {
    public {
        #! Payloads the provider reported to its observers
        list<auto> notified = ();
    }

    constructor(*GitHubRestClient::GitHubRestClientIo rest, *hash<auto> options)
            : GitHubNewIssueDataProvider(rest, options) {
    }

    #! Delivers a webhook request, as the webhook endpoint would
    deliver(hash<auto> request) {
        handleWebhookEvent(request);
    }

    #! Returns the secret the hook was registered with
    *string secret() {
        return webhook_secret;
    }

    #! Returns the ID of the hook created on the repository
    *int hookId() {
        return hook_id;
    }

    #! Records what would have been reported to observers
    notifyObservers(string event_id, hash<auto> data) {
        notified += data;
    }

    reset() {
        notified = ();
    }
}

#! A branch event provider whose deliveries can be driven directly
class TestGitHubBranchEventProvider inherits GitHubDataProvider::GitHubNewBranchDataProvider {
    public {
        #! Payloads the provider reported to its observers
        list<auto> notified = ();
    }

    constructor(*GitHubRestClient::GitHubRestClientIo rest, *hash<auto> options)
            : GitHubNewBranchDataProvider(rest, options) {
        # the deliveries under test are built with a known secret rather than registered with GitHub
        webhook_secret = "branch-secret";
    }

    deliver(hash<auto> request) {
        handleWebhookEvent(request);
    }

    notifyObservers(string event_id, hash<auto> data) {
        notified += data;
    }

    reset() {
        notified = ();
    }
}

public class GitHubDataProviderTest inherits QUnit::Test {
    public {
        #! The action IDs the TypeScript application this module replaces exported
        /** Taken from its i18n catalog, which is keyed by the registered action name: the GitHub
            \c operationId with the slash replaced by a hyphen, because the action catalog accepts only
            \c A-Za-z0-9_- in a name.
        */
        const ExpectedTsActions = (
            "actions-create-or-update-repo-secret", "actions-delete-repo-secret",
            "actions-get-repo-public-key", "actions-get-repo-secret", "actions-list-repo-workflows",
            "git-create-ref",
            "issues-add-assignees", "issues-create", "issues-get", "issues-list", "issues-list-for-repo",
            "issues-remove-assignees", "issues-update",
            "orgs-list-members",
            "pulls-create", "pulls-get", "pulls-list", "pulls-list-requested-reviewers",
            "pulls-remove-requested-reviewers", "pulls-request-reviewers", "pulls-update",
            "repos-create-for-authenticated-user", "repos-create-in-org",
            "repos-create-or-update-file-contents", "repos-create-release", "repos-delete",
            "repos-delete-file", "repos-get", "repos-get-branch", "repos-get-content",
            "repos-list-branches", "repos-list-collaborators", "repos-list-commits",
            "repos-list-contributors", "repos-list-for-authenticated-user", "repos-list-for-org",
            "repos-list-releases", "repos-update",
            "search-issues-and-pull-requests", "search-repos",
        );

        #! The actions this application adds, each backing a dropdown the TypeScript app could not fill
        const ExpectedAddedActions = (
            "orgs-list-for-authenticated-user",
            "issues-list-labels-for-repo",
            "repos-list-for-user",
        );

        #! The event providers the application offers, with the IDs the TypeScript app registered
        const ExpectedEvents = (
            "new_repository_issue", "new_pull_request", "new_review_request", "new_commit",
            "new_repository_branch", "new_release", "new_commit_comment",
        );

        #! The record-based tables the application offers
        const ExpectedTables = ("issues", "pulls", "releases", "repositories");

        #! The record-based actions, with the IDs the TypeScript application registered
        /** These reach the tables from the action surface.  Without them the tables are reachable only by
            walking the provider tree, and a workflow that calls them by name breaks on the migration.
        */
        const ExpectedRecordActions = {
            "search": DPAT_FIND,
            "search-single": DPAT_FIND_SINGLE,
            "create": DPAT_CREATE,
            "update": DPAT_UPDATE,
            "delete": DPAT_DELETE,
        };

        #! The dropdowns scoped to a repository
        const ScopedReferenceData = (
            GitHubManifest::RefBranch, GitHubManifest::RefIssue, GitHubManifest::RefPull,
            GitHubManifest::RefCollaborator, GitHubManifest::RefLabel,
        );
    }

    private {
        RestSchemaActionSet aset;
    }

    constructor() : Test("GitHubDataProviderTest", "1.0") {
        aset = GitHubSchema::getActionSet();

        addTestCase("provenance", \provenanceTest());
        addTestCase("drift agreement", \driftTest());
        addTestCase("action identity", \actionIdentityTest());
        addTestCase("reference data", \referenceDataTest());
        addTestCase("reference data execution", \referenceDataExecutionTest());
        addTestCase("provider paths", \providerPathTest());
        addTestCase("request construction", \requestConstructionTest());
        addTestCase("connection", \connectionTest());
        addTestCase("event providers", \eventProviderTest());
        addTestCase("webhook registration", \webhookRegistrationTest());
        addTestCase("webhook verification", \webhookVerificationTest());
        addTestCase("webhook action filtering", \webhookFilteringTest());
        addTestCase("record action registration", \recordActionRegistrationTest());
        addTestCase("record tables", \recordTableTest());
        addTestCase("read-only record tables", \readOnlyTableTest());
        addTestCase("record search", \recordSearchTest());
        addTestCase("record search pushdown", \recordPushdownTest());
        addTestCase("a record limit counts matches", \recordLimitTest());
        addTestCase("record create", \recordCreateTest());
        addTestCase("record update", \recordUpdateTest());
        addTestCase("a repository is named by owner and name", \repositoryTableTest());
        set_return_value(main());
    }

    private provenanceTest() {
        hash<GitHubSchemaProvenanceInfo> p = GitHubSchema::Provenance;
        assertRegex("github/rest-api-description", p.source_url);
        assertRegex("^[0-9a-f]{64}$", p.source_sha256);
        assertGt(0, p.source_size);
        assertGt(0, p.source_paths);
        assertGt(0, p.source_schemas);
        assertTrue(p.imported.absolute());
        assertEq(GitHubRestClient::GitHubRestClientBase::ApiVersion, p.api_version,
            "the pinned description and the version the requests declare move together");
        assertTrue(is_file(GitHubSchema::getSchemaPath()));
        assertLt(p.source_size, hstat(GitHubSchema::getSchemaPath()).size,
            "the pruned schema is smaller than the document it was pruned from");
        assertLt(p.source_size / 10, hstat(GitHubSchema::getSchemaPath()).size,
            "pruning a 12.9 MB description is what makes this module loadable");
    }

    private driftTest() {
        list<hash<RestSchemaDriftInfo>> drift = RestSchemaDrift::compare(aset, GitHubSchema::getSchema());
        assertEq((), drift, "the manifest and the vendored schema agree");
    }

    private actionIdentityTest() {
        hash<string, bool> actions = {};
        map actions{$1} = True, aset.getActionNames();

        list<string> missing = ();
        foreach string action in (ExpectedTsActions) {
            if (!actions{action}) {
                missing += action;
            }
        }
        assertEq((), missing, "every action the TypeScript application exported is still exported");
        map assertTrue(actions{$1}, sprintf("added action %y is exported", $1)), ExpectedAddedActions;
        assertEq(ExpectedTsActions.size() + ExpectedAddedActions.size(), (keys actions).size(),
            "three actions were added, and nothing else");

        # the action ID is the operationId with the slash replaced, because the action catalog accepts
        # only "A-Za-z0-9_-"; an upstream rename has to surface as drift rather than rename an action
        foreach hash<RestSchemaActionInfo> info in (GitHubManifest::Manifest) {
            assertEq(info.action, replace(info.operation_id, "/", "-"),
                sprintf("action %y is its operationId, hyphenated", info.action));
            assertFalse(info.action =~ /[^A-Za-z0-9_-]/,
                sprintf("action %y can be registered in the action catalog", info.action));
        }
    }

    private referenceDataTest() {
        hash<string, hash<RestSchemaReferenceDataInfo>> refdata = aset.getReferenceDataDecls();
        assertEq(8, (keys refdata).size());

        hash<string, bool> actions = {};
        map actions{$1} = True, aset.getActionNames();
        foreach hash<auto> i in (refdata.pairIterator()) {
            hash<RestSchemaReferenceDataInfo> rd = i.value;
            assertEq(i.key, rd.name);
            assertTrue(actions{rd.action}, sprintf("reference data %y names exported action %y", i.key,
                rd.action));
            assertNothing(rd.records_path, "a GitHub collection is a bare array");
        }

        # a branch belongs to a repository and a repository to an owner, so those dropdowns are scoped
        map assertEq({"owner": "owner", "repo": "repo"}, refdata{$1}.options_from,
            sprintf("%y is scoped to the chosen repository", $1)), ScopedReferenceData;
        assertEq({"username": "owner"}, refdata{GitHubManifest::RefRepository}.options_from);
        assertNothing(refdata{GitHubManifest::RefOwner}.options_from,
            "the owner dropdown is the one with no scope");

        # the three listings added to this manifest exist so that three dropdowns can be filled
        assertEq("orgs-list-for-authenticated-user", refdata{GitHubManifest::RefOrganization}.action);
        assertEq("issues-list-labels-for-repo", refdata{GitHubManifest::RefLabel}.action);
        assertEq("repos-list-for-user", refdata{GitHubManifest::RefRepository}.action);

        # GitHub only accepts an assignee with push access, so the dropdown lists collaborators
        assertEq("repos-list-collaborators", refdata{GitHubManifest::RefCollaborator}.action);

        # the owner is nested inside each repository record
        assertEq("owner.login", refdata{GitHubManifest::RefOwner}.value_field);
    }

    private referenceDataExecutionTest() {
        FakeGitHubRestClient rest();
        GitHubDataProvider dp(rest);

        # every repository the credential can see carries its owner, and the same owner appears on many of
        # them; a dropdown offering the same value twice is offering the user a choice that is not one
        AbstractDataProvider create_issue = dp.getChildProviderEx("issues-create");
        rest.push_response({"body": (
            {"name": "qorus", "owner": {"login": "qoretechnologies"}},
            {"name": "qore", "owner": {"login": "qoretechnologies"}},
            {"name": "dotfiles", "owner": {"login": "octocat"}},
        )});
        *list<hash<AllowedValueInfo>> owners = create_issue.getReferenceData(GitHubManifest::RefOwner);
        assertEq(2, owners.size(), "the same owner is offered once, however many repositories it owns");
        assertEq("qoretechnologies", owners[0].value);
        assertEq("octocat", owners[1].value);
        assertRegex("per_page=100", rest.last().path, "a dropdown is filled in one request");

        # a scoped dropdown cannot be listed until the option it is scoped by has a value: listing every
        # branch the credential can see would offer branches of some other repository
        rest.reset();
        assertNothing(create_issue.getReferenceData(GitHubManifest::RefLabel, {"owner": "qoretechnologies"}),
            "a repository-scoped dropdown stays empty until the repository is chosen");
        assertEq(0, rest.requests.size(), "and makes no request at all");

        rest.push_response({"body": ({"name": "bug"}, {"name": "documentation"})});
        *list<hash<AllowedValueInfo>> labels = create_issue.getReferenceData(GitHubManifest::RefLabel,
            {"owner": "qoretechnologies", "repo": "qorus"});
        assertEq(2, labels.size());
        assertEq("bug", labels[0].value);
        assertRegex("/repos/qoretechnologies/qorus/labels", rest.last().path,
            "the chosen repository scopes the listing");
    }

    private providerPathTest() {
        FakeGitHubRestClient rest();
        GitHubDataProvider dp(rest);
        aset.validateActionPaths(dp);

        hash<string, bool> children = {};
        map children{$1} = True, dp.getChildProviderNames();
        assertTrue(children{GitHubDataProvider::EventsChildName});
        assertTrue(children{GitHubDataProvider::TablesChildName});
        assertNothing(dp.getChildProvider("no-such-action"));

        AbstractDataProvider events = dp.getChildProviderEx(GitHubDataProvider::EventsChildName);
        hash<string, bool> event_children = {};
        map event_children{$1} = True, events.getChildProviderNames();
        map assertTrue(event_children{$1}, sprintf("event %y resolves", $1)), ExpectedEvents;

        AbstractDataProvider tables = dp.getChildProviderEx(GitHubDataProvider::TablesChildName);
        hash<string, bool> table_children = {};
        map table_children{$1} = True, tables.getChildProviderNames();
        map assertTrue(table_children{$1}, sprintf("table %y resolves", $1)), ExpectedTables;
    }

    private requestConstructionTest() {
        FakeGitHubRestClient rest();
        GitHubDataProvider dp(rest);

        AbstractDataProvider get_repo = dp.getChildProviderEx("repos-get");
        rest.push_response({"body": {"id": 1, "name": "qorus", "default_branch": "develop"}});
        auto res = get_repo.doRequest({"owner": "qoretechnologies", "repo": "qorus"});
        assertEq("GET", rest.last().method);
        assertRegex("^/repos/qoretechnologies/qorus", rest.last().path);
        assertEq("develop", res.default_branch);

        # every reserved character in a query value has to be escaped, or the value changes the request
        # rather than travelling in it: an unescaped space ends the HTTP request line outright, which is
        # what a GitHub search query is full of
        AbstractDataProvider search = dp.getChildProviderEx("search-repos");
        rest.push_response({"body": {"total_count": 0, "items": ()}});
        search.doRequest({"q": "qore language:qore", "per_page": 5});
        assertRegex("q=qore%20language%3Aqore", rest.last().path, "a query value is percent-encoded");
        assertFalse(rest.last().path =~ / /, "and carries no space, which would end the request line");

        AbstractDataProvider list_issues = dp.getChildProviderEx("issues-list-for-repo");
        rest.push_response({"body": ({"number": 1, "title": "an issue"},)});
        list_issues.doRequest({"owner": "qoretechnologies", "repo": "qorus", "state": "all",
            "per_page": 100});
        assertRegex("state=all", rest.last().path);
        assertRegex("per_page=100", rest.last().path);

        AbstractDataProvider create_issue = dp.getChildProviderEx("issues-create");
        rest.push_response({"body": {"number": 7, "title": "Release notes are out of date"}});
        create_issue.doRequest({
            "owner": "qoretechnologies",
            "repo": "qorus",
            "title": "Release notes are out of date",
            "labels": ("documentation",),
        });
        auto sent = rest.lastBody();
        assertEq("POST", rest.last().method);
        assertEq("/repos/qoretechnologies/qorus/issues", rest.last().path);
        assertEq("Release notes are out of date", sent.title);
        assertEq(("documentation",), sent.labels);
        assertNothing(sent.owner, "the owner travels in the path, not in the body");

        # the reviewer request body is an object with an "anyOf" that only says one of two properties is
        # required; the properties themselves are still options
        RestSchemaActionOperation req_rev = aset.getOperationEx("pulls-request-reviewers");
        hash<string, AbstractDataField> fields = req_rev.getRequestFields();
        assertTrue(exists fields.reviewers, "a constraint-only composition does not hide the properties");
        assertTrue(exists fields.team_reviewers);
        hash<auto> wire = req_rev.unflatten({"owner": "o", "repo": "r", "pull_number": 3,
            "reviewers": ("octocat",)});
        assertEq({"owner": "o", "repo": "r", "pull_number": 3}, wire.path_vars);
        assertEq(("octocat",), wire.req.body.reviewers);

        rest.push_response({"throw_status": 404, "body": {"message": "Not Found"}});
        assertThrows("REST-RESPONSE-ERROR", \get_repo.doRequest(), {"owner": "nope", "repo": "nope"});
    }

    private connectionTest() {
        # this application supports OAuth2, so the OAuth2 option set is named FIRST in
        # "required_options": that is what declares OAuth2 support to the platform and makes the
        # authorization-code flow the connection's default rather than a personal access token
        list<string> req = GitHubRestConnection::ConnectionScheme.required_options.split("|");
        assertEq('oauth2_client_id,oauth2_client_secret', req[0],
            "the OAuth2 option set is the first alternative, so it is the default flow");

        # ...but naming the options first only decides what the form shows.  What decides whether the
        # platform offers the authorization flow at all is whether the CONNECTION reports it can authorize,
        # and it works that out from its own options: the grant type plus all five of the authorization
        # request options.  A connection that leaves any of them to be derived later, when a client is
        # finally built, reports that it cannot authorize and the platform falls back to asking for a token.
        GitHubRestConnection oauth2_conn({
            "name": "oauth2-flow-test",
            "desc": "test",
            "url": "github://github.com",
            "opts": {
                "oauth2_client_id": "id",
                "oauth2_client_secret": "secret",
                "oauth2_redirect_url": "auto",
            },
        });
        assertTrue(oauth2_conn.getFeatures(){RestConnection::RCF_OAUTH2_AUTH},
            "the connection reports that it can authorize with OAuth2");
        assertTrue(oauth2_conn.getFeatures(){RestConnection::RCF_OAUTH2_AUTH_CODE},
            "specifically with the authorization code flow");
        hash<auto> oauth2_opts = oauth2_conn.getRealOptions();
        assertTrue(oauth2_opts.oauth2_auth_url.val(), "the authorization endpoint is known to the connection");
        assertTrue(oauth2_opts.oauth2_token_url.val(), "the token endpoint is known to the connection");

        assertEq("2022-11-28", GitHubRestClientBase::ApiVersion);

        hash<auto> opts = GitHubRestClientBase::getOptions({"token": "abc"});
        assertEq("https://api.github.com", opts.url);
        assertEq("Bearer", opts.token_type);
        assertEq("/user", opts.ping_path);
        assertEq(GitHubRestClientBase::ApiVersion, opts.headers{GitHubRestClientBase::ApiVersionHeader});

        # a caller adding a header of its own must not drop the version pin
        hash<auto> hopts = GitHubRestClientBase::getOptions({"token": "abc", "headers": {"X-Trace": "1"}});
        assertEq(GitHubRestClientBase::ApiVersion, hopts.headers{GitHubRestClientBase::ApiVersionHeader});
        assertEq("1", hopts.headers."X-Trace");

        hash<auto> oopts = GitHubRestClientBase::getOptions({
            "oauth2_client_id": "id",
            "oauth2_client_secret": "secret",
        });
        assertEq("https://github.com/login/oauth/authorize", oopts.oauth2_auth_url);
        assertEq("https://github.com/login/oauth/access_token", oopts.oauth2_token_url);
        assertEq("authorization_code", oopts.oauth2_grant_type);
        # the application exports a Delete Repository action, and GitHub keeps that permission out of
        # "repo" deliberately; a connection without it offers an action that always fails with 403
        assertTrue(inlist("delete_repo", oopts.oauth2_scopes),
            "the scopes cover every action the application exports");

        GitHubRestConnection conn("github-test", "test", "github://api.github.com", {}, {"token": "abc"});
        assertEq("github", conn.getType());
        assertEq("Github", conn.getAppName());
        assertTrue(conn.hasDataProvider());
        assertTrue(GitHubRestConnection::ConnectionScheme.options."token".sensitive,
            "a personal access token is a credential");
    }

    private eventProviderTest() {
        FakeGitHubRestClient rest();
        GitHubEventsDataProvider events(rest);
        hash<string, bool> names = {};
        map names{$1} = True, events.getChildProviderNames();
        map assertTrue(names{$1}, sprintf("event %y is offered", $1)), ExpectedEvents;
        assertNothing(events.getChildProvider("no-such-event"));

        # a webhook is registered on one repository, so the repository is required -- but the provider is
        # built as a template when the children are enumerated, so constructing it must not throw
        AbstractDataProvider tmpl = events.getChildProviderEx("new_repository_issue");
        hash<DataProviderInfo> info = tmpl.getInfo();
        assertTrue(info.constructor_options.owner.required);
        assertTrue(info.constructor_options.repo.required);
        assertEq(GitHubManifest::RefOwner, info.constructor_options.owner.ref_data);
        assertEq(GitHubManifest::RefRepository, info.constructor_options.repo.ref_data);
        assertTrue(info.supports_observable);

        # the event type is composed from the pinned schema's own component types
        hash<string, hash<DataProviderMessageInfo>> types = tmpl.getEventTypes();
        AbstractDataProviderType t = types."new_repository_issue"."type";
        hash<string, AbstractDataField> fields = t.getFields();
        assertTrue(exists fields.issue);
        assertTrue(exists fields.repository);
        assertTrue(exists fields.sender);
        assertGt(10, fields.issue.getType().getFields().size(),
            "the issue is GitHub's own declared shape, not a hand-written summary of it");
    }

    private webhookRegistrationTest() {
        FakeGitHubRestClient rest();
        list<hash<auto>> created = ();
        list<hash<auto>> deleted = ();
        DataProviderWebhook::registerWebhookApis(
            hash<auto> sub (hash<auto> config) {
                created += config;
                return {"url": "https://qorus.example.com/webhook/1", "ctx": "ctx-1"};
            },
            sub (hash<auto> info) {
                deleted += info;
            },
        );

        TestGitHubIssueEventProvider p(rest, {"owner": "qoretechnologies", "repo": "qorus"});
        rest.push_response({"body": {"id": 4242}});
        p.observersReady();

        assertEq(1, created.size());
        assertEq("POST", rest.last().method);
        assertEq("/repos/qoretechnologies/qorus/hooks", rest.last().path);
        auto sent = rest.lastBody();
        assertEq("web", sent.name);
        assertEq(("issues",), sent.events);
        assertEq("https://qorus.example.com/webhook/1", sent.config.url);
        assertEq("json", sent.config.content_type);
        # the superseded application registered its hooks with no secret at all, so nothing it received
        # could be verified
        assertRegex("^[0-9a-f]{64}$", sent.config.secret, "a hook is registered with a generated secret");
        assertEq(sent.config.secret, p.secret());
        assertEq(4242, p.hookId());

        p.stopEvents();
        assertEq("DELETE", rest.last().method);
        assertEq("/repos/qoretechnologies/qorus/hooks/4242", rest.last().path);
        assertEq(1, deleted.size(), "the local endpoint is removed with the hook");

        # the repository is what a hook is registered on, so it cannot be left out
        TestGitHubIssueEventProvider bare(rest, {});
        assertThrows("GITHUB-EVENT-ERROR", "owner", \bare.observersReady());
    }

    private webhookVerificationTest() {
        FakeGitHubRestClient rest();
        TestGitHubIssueEventProvider p(rest, {"owner": "o", "repo": "r"});
        rest.push_response({"body": {"id": 1}});
        p.observersReady();
        string secret = p.secret();

        string body = make_json({"action": "opened", "issue": {"number": 7, "title": "a new issue"}});
        string sig = "sha256=" + WebhookSignature::sign(secret, body);

        p.deliver({"body": body, "hdr": {"X-Hub-Signature-256": sig, "X-GitHub-Event": "issues"}});
        assertEq(1, p.notified.size(), "a correctly signed delivery is raised");
        assertEq(7, p.notified[0].issue.number);

        # anyone on the internet can post to a webhook URL; a delivery that does not verify is dropped
        p.reset();
        p.deliver({"body": body, "hdr": {"X-Hub-Signature-256": "sha256=" + WebhookSignature::sign("wrong",
            body), "X-GitHub-Event": "issues"}});
        assertEq(0, p.notified.size(), "a delivery signed with the wrong secret is dropped");

        p.reset();
        p.deliver({"body": body, "hdr": {"X-GitHub-Event": "issues"}});
        assertEq(0, p.notified.size(), "a delivery with no signature is dropped");

        p.reset();
        p.deliver({"body": body, "hdr": {"X-Hub-Signature-256": WebhookSignature::sign(secret, body),
            "X-GitHub-Event": "issues"}});
        assertEq(0, p.notified.size(), "a signature with no \"sha256=\" prefix is dropped");

        # the signature covers the bytes as sent, so a body that arrives already parsed cannot be checked
        p.reset();
        p.deliver({"body": {"action": "opened"}, "hdr": {"X-Hub-Signature-256": sig,
            "X-GitHub-Event": "issues"}});
        assertEq(0, p.notified.size(), "a delivery whose raw body is not available is dropped");

        # GitHub posts a "ping" once when a hook is created; it is protocol noise, not an event
        p.reset();
        string ping = make_json({"zen": "Design for failure.", "hook_id": 1});
        p.deliver({"body": ping, "hdr": {"X-Hub-Signature-256": "sha256="
            + WebhookSignature::sign(secret, ping), "X-GitHub-Event": "ping"}});
        assertEq(0, p.notified.size(), "GitHub's \"ping\" delivery is not an event");

        # a hook can be edited in the GitHub UI to send more than it was created for
        p.reset();
        string other = make_json({"action": "created", "comment": {"id": 1}});
        p.deliver({"body": other, "hdr": {"X-Hub-Signature-256": "sha256="
            + WebhookSignature::sign(secret, other), "X-GitHub-Event": "commit_comment"}});
        assertEq(0, p.notified.size(), "a delivery for another GitHub event is dropped");

        p.stopEvents();
    }

    private webhookFilteringTest() {
        FakeGitHubRestClient rest();
        TestGitHubIssueEventProvider p(rest, {"owner": "o", "repo": "r"});
        rest.push_response({"body": {"id": 1}});
        p.observersReady();
        string secret = p.secret();

        # "New Issue" means opened, not edited or closed
        foreach string action in (("edited", "closed", "labeled")) {
            string body = make_json({"action": action, "issue": {"number": 7}});
            p.deliver({"body": body, "hdr": {"X-Hub-Signature-256": "sha256="
                + WebhookSignature::sign(secret, body), "X-GitHub-Event": "issues"}});
        }
        assertEq(0, p.notified.size(), "only the change the event is named for is raised");
        p.stopEvents();

        # ... unless the whole family is asked for, which is what the superseded application delivered
        FakeGitHubRestClient rest2();
        TestGitHubIssueEventProvider all(rest2, {"owner": "o", "repo": "r", "all_actions": True});
        rest2.push_response({"body": {"id": 2}});
        all.observersReady();
        string body = make_json({"action": "closed", "issue": {"number": 7}});
        all.deliver({"body": body, "hdr": {"X-Hub-Signature-256": "sha256="
            + WebhookSignature::sign(all.secret(), body), "X-GitHub-Event": "issues"}});
        assertEq(1, all.notified.size(), "\"all_actions\" restores the whole family");
        all.stopEvents();

        # GitHub's "create" event covers branches and tags alike, and only one of them is a new branch
        TestGitHubBranchEventProvider b(rest, {"owner": "o", "repo": "r"});
        string branch = make_json({"ref": "feature/x", "ref_type": "branch"});
        b.deliver({"body": branch, "hdr": {"X-Hub-Signature-256": "sha256="
            + WebhookSignature::sign("branch-secret", branch), "X-GitHub-Event": "create"}});
        string tag = make_json({"ref": "v1.0", "ref_type": "tag"});
        b.deliver({"body": tag, "hdr": {"X-Hub-Signature-256": "sha256="
            + WebhookSignature::sign("branch-secret", tag), "X-GitHub-Event": "create"}});
        assertEq(1, b.notified.size(), "a new tag is not a new branch");
        assertEq("feature/x", b.notified[0].ref);
    }

    #! Returns the tables container of a provider built on a fake client
    private AbstractDataProvider tables(FakeGitHubRestClient rest) {
        GitHubDataProvider dp(rest);
        return dp.getChildProviderEx(GitHubDataProvider::TablesChildName);
    }

    #! Returns the given table
    private AbstractDataProvider table(FakeGitHubRestClient rest, string name) {
        return tables(rest).getChildProviderEx(name);
    }

    private recordActionRegistrationTest() {
        *list<hash<DataProviderActionInfo>> actions = DataProviderActionCatalog::getActions("Github");
        hash<string, hash<DataProviderActionInfo>> by_action = {};
        map by_action{$1.action} = $1, actions;

        # the three tables are worth nothing if no action reaches them; the TypeScript application
        # registered "search", "search-single" and "create", so a workflow calling them survives the
        # migration, and "update" is added because GitHub does export a PATCH for issues and pull requests
        foreach hash<auto> i in (ExpectedRecordActions.pairIterator()) {
            assertTrue(exists by_action{i.key}, sprintf("record action %y is registered", i.key));
            assertEq(i.value, by_action{i.key}.action_code, sprintf("%y has its record action code", i.key));
            assertEq("/" + GitHubDataProvider::TablesChildName + "/{table}", by_action{i.key}.path,
                sprintf("%y names its table in the path", i.key));
            assertTrue(exists by_action{i.key}.path_vars.table, sprintf("%y takes a table", i.key));
            assertEq(("Record-Based",), by_action{i.key}.groups);
            # a short description is shown where there is no room for more, so it stays plain and short;
            # this is the check that a per-application override has to pass as well as the generic wording
            assertLt(80, by_action{i.key}.short_desc.size(), sprintf("%y short description fits", i.key));
            assertFalse(by_action{i.key}.short_desc =~ /[*`]/,
                sprintf("%y short description is plain text", i.key));
            assertEq(-1, by_action{i.key}.short_desc.find("\n"),
                sprintf("%y short description is one line", i.key));
            # the options depend on which table was named, so they are resolved from the data rather than
            # declared here
            assertTrue(by_action{i.key}.data_dependent_options,
                sprintf("%y resolves its options from the chosen table", i.key));
            assertTrue(by_action{i.key}.data_provider_info.has_record,
                sprintf("%y is declared as record-based", i.key));
        }

        # GitHub cannot delete an issue, a pull request or a release - each is closed rather than removed -
        # but it can delete a repository, so the action exists and the three tables that cannot honour it
        # report that for themselves
        assertTrue(exists by_action.delete, "a repository can be deleted, so a delete action is offered");

        # what every table has in common, which is what a form can show before a table has been chosen
        hash<DataProviderInfo> info = RestSchemaTablesDataProvider::getRecordActionProviderInfo(aset,
            GitHubRecordTables::Tables);
        assertTrue(info.supports_read);
        assertTrue(info.supports_create);
        assertTrue(info.supports_update);
        assertTrue(info.supports_delete, "one table - repositories - can delete");
        # GitHub takes a few query arguments; it has no filter expression language, so a search is not
        # answered by the server alone and saying otherwise would misdescribe every result
        assertFalse(info.supports_native_search);
        assertTrue(info.supports_search_expressions);
        # only an option EVERY table needs can be published before a table has been chosen, and
        # "repositories" needs no repository - its records are the repositories - so the repository scope is
        # resolved per table like everything else
        assertNothing(info.search_options.owner, "an option only some tables need is not declared app-wide");
        assertNothing(info.search_options.state, "a table-specific option is not declared app-wide");
        # the path a record action registers has to resolve to a table
        FakeGitHubRestClient rest();
        AbstractDataProvider t = tables(rest);

        # and the tables that are scoped still require the repository, resolved from the chosen table
        assertTrue(t.getChildProviderEx("issues").getInfo().search_options.owner.required,
            "a scoped table names the repository owner");
        assertNothing(t.getChildProviderEx("repositories").getInfo().search_options.owner,
            "the repositories table has no repository scope; its records are the repositories");
        map assertTrue(exists t.getChildProvider($1), sprintf("table %y resolves", $1)), ExpectedTables;
        assertEq("issues",
            RestSchemaTablesDataProvider::getTablePathVar(GitHubRecordTables::Tables).example_value,
            "the example table is one the application actually has");

        # every table has to name actions the manifest still exports
        cast<RestSchemaTablesDataProvider>(t).checkTables();
    }

    private recordTableTest() {
        FakeGitHubRestClient rest();
        AbstractDataProvider issues = table(rest, "issues");
        hash<DataProviderInfo> info = issues.getInfo();
        assertTrue(info.supports_read);
        assertTrue(info.supports_create);
        assertTrue(info.supports_update, "GitHub exports a PATCH for an issue");
        assertFalse(info.supports_delete, "GitHub cannot delete an issue");
        assertTrue(info.supports_search_expressions);
        assertFalse(info.supports_native_search, "the where clause does not reach GitHub");
        assertTrue(info.search_options.owner.required);
        assertTrue(info.create_options.repo.required);
        # the repository dropdowns are the manifest's, and reach the table option unchanged
        assertEq(GitHubManifest::RefOwner, info.search_options.owner.ref_data);
        assertEq(GitHubManifest::RefRepository, info.search_options.repo.ref_data);
        # the application this module replaces returned open and closed records by default; GitHub's own
        # listing defaults to open, so the table has to say so
        assertEq("all", info.search_options.state.default_value);

        # the table is a flattened, writable projection, not GitHub's response shape
        *hash<string, AbstractDataField> fields = issues.getRecordType();
        assertTrue(exists fields.labels);
        assertTrue(exists fields.assignees);
        assertTrue(exists fields.milestone);
        assertEq(NT_LIST, fields.labels.getType().getBaseTypeCode(),
            "labels are names, not the objects GitHub returns");

        # GitHub's releases collection accepts no state, sort or direction, so none is offered
        AbstractDataProvider releases = table(rest, "releases");
        assertNothing(releases.getInfo().search_options.state);
        assertNothing(releases.getInfo().search_options.sort);
        assertTrue(exists releases.getInfo().search_options.limit);
        assertFalse(releases.getInfo().supports_update, "the manifest exports no release update");
    }

    private recordSearchTest() {
        FakeGitHubRestClient rest();
        AbstractDataProvider issues = table(rest, "issues");

        rest.push_response({"body": (
            {
                "id": 1, "number": 7, "state": "open", "title": "an issue",
                "labels": ({"name": "bug"}, {"name": "documentation"}),
                "assignee": {"login": "octocat"},
                "assignees": ({"login": "octocat"},),
                "milestone": {"title": "6.1"},
            },
        )});
        AbstractDataProviderRecordIterator<hash<auto>> i = issues.searchRecords(NOTHING, {
            "owner": "qoretechnologies", "repo": "qorus", "state": "all",
        });
        list<hash<auto>> recs = map $1, i;
        assertEq(1, recs.size());
        assertEq(("bug", "documentation"), recs[0].labels, "labels are flattened to names");
        assertEq("octocat", recs[0].assignee, "the assignee is flattened to a login");
        assertEq(("octocat",), recs[0].assignees);
        assertEq("6.1", recs[0].milestone);
        assertRegex("^/repos/qoretechnologies/qorus/issues", rest.last().path);
        assertRegex("state=all", rest.last().path);
        assertRegex("per_page=100", rest.last().path);
        assertEq(1, rest.requests.size(), "a page shorter than the size asked for is the last page");

        # a table is scoped to one repository, and there is no default for it
        assertThrows("SEARCH-OPTION-ERROR", "owner", \issues.searchRecords(), (NOTHING, {"repo": "qorus"}));

        # a search naming an issue by its number reads that issue rather than walking the collection, which
        # is what makes a record readable straight after it is created
        rest.reset();
        rest.push_response({"body": {"id": 1, "number": 7, "title": "an issue"}});
        *hash<auto> one = issues.searchSingleRecord(<DataProviderExpression>{
            "exp": DP_SEARCH_OP_EQ,
            "args": (<DataProviderFieldReference>{"field": "number"}, 7),
        }, {"owner": "o", "repo": "r"});
        assertEq(7, one.number);
        assertEq("/repos/o/r/issues/7", rest.last().path);

        # a pull request's base and head arrive as objects and are presented as branch names
        AbstractDataProvider pulls = table(rest, "pulls");
        rest.reset();
        rest.push_response({"body": (
            {
                "id": 2, "number": 3, "title": "a pull request",
                "base": {"ref": "develop"},
                "head": {"ref": "feature/x", "repo": {"full_name": "octocat/qorus"}},
            },
        )});
        list<hash<auto>> pull_recs = map $1, pulls.searchRecords(NOTHING, {"owner": "q", "repo": "qorus"});
        assertEq("develop", pull_recs[0].base);
        assertEq("feature/x", pull_recs[0].head);
        assertEq("octocat/qorus", pull_recs[0].head_repo);
    }

    #! What GitHub filters for itself, and what this module filters
    private recordPushdownTest() {
        FakeGitHubRestClient rest();
        AbstractDataProvider issues = table(rest, "issues");

        # with no predicate the table sends its own default, which is "all": the application this module
        # replaces returned open and closed issues alike, and GitHub's listing defaults to open
        rest.push_response({"body": ()});
        map $1, issues.searchRecords(NOTHING, {"owner": "o", "repo": "r"});
        assertRegex("state=all", rest.last().path, "the table's default reaches GitHub");

        # a predicate on the same field replaces that default rather than being blocked by it
        rest.reset();
        rest.push_response({"body": ()});
        map $1, issues.searchRecords(<DataProviderExpression>{
            "exp": DP_SEARCH_OP_EQ,
            "args": (<DataProviderFieldReference>{"field": "state"}, "closed"),
        }, {"owner": "o", "repo": "r"});
        assertRegex("state=closed", rest.last().path, "a defaulted option yields to a predicate");

        # but an option the caller set explicitly does not yield: the two together mean the intersection,
        # so GitHub is asked for the open issues and the closed-ness is checked here, matching nothing
        rest.reset();
        rest.push_response({"body": ({"id": 1, "number": 1, "state": "open"},)});
        list<hash<auto>> both = map $1, issues.searchRecords(<DataProviderExpression>{
            "exp": DP_SEARCH_OP_EQ,
            "args": (<DataProviderFieldReference>{"field": "state"}, "closed"),
        }, {"owner": "o", "repo": "r", "state": "open"});
        assertRegex("state=open", rest.last().path, "the caller's own option is what was sent");
        assertEq(0, both.size(), "and the predicate is still answered");

        # an issue's state is a filter GitHub evaluates exactly, so it is sent
        rest.reset();
        rest.push_response({"body": ()});
        map $1, issues.searchRecords(<DataProviderExpression>{
            "exp": DP_SEARCH_OP_EQ,
            "args": (<DataProviderFieldReference>{"field": "state"}, "closed"),
        }, {"owner": "o", "repo": "r"});
        assertRegex("state=closed", rest.last().path, "the state predicate reaches GitHub");

        # a title predicate is not a filter GitHub offers, so it is evaluated here, over the whole listing
        rest.reset();
        rest.push_response({"body": ({"id": 1, "number": 1, "title": "keep"},
            {"id": 2, "number": 2, "title": "drop"})});
        list<hash<auto>> found = map $1, issues.searchRecords(<DataProviderExpression>{
            "exp": DP_SEARCH_OP_EQ,
            "args": (<DataProviderFieldReference>{"field": "title"}, "keep"),
        }, {"owner": "o", "repo": "r"});
        assertEq(1, found.size(), "the predicate GitHub cannot evaluate is still answered");
        assertEq("keep", found[0].title);
        assertFalse(rest.last().path =~ /title=/, "no filter GitHub does not offer is invented");

        # "since" narrows the listing but is not relied on to answer the predicate, because GitHub does not
        # document whether its bound is inclusive
        rest.reset();
        rest.push_response({"body": ({"id": 1, "number": 1, "title": "old", "updated_at": "2026-01-01"},
            {"id": 2, "number": 2, "title": "new", "updated_at": "2026-06-01"})});
        found = map $1, issues.searchRecords(<DataProviderExpression>{
            "exp": DP_SEARCH_OP_GT,
            "args": (<DataProviderFieldReference>{"field": "updated_at"}, "2026-03-01"),
        }, {"owner": "o", "repo": "r"});
        assertRegex("since=2026-03-01", rest.last().path, "the bound reaches GitHub as a narrowing hint");
        assertEq(1, found.size(), "and the predicate is applied again to what came back");
        assertEq("new", found[0].title);

        # a pull request's base branch is a filter GitHub evaluates exactly
        rest.reset();
        rest.push_response({"body": ()});
        map $1, table(rest, "pulls").searchRecords(<DataProviderExpression>{
            "exp": DP_SEARCH_OP_EQ,
            "args": (<DataProviderFieldReference>{"field": "base"}, "develop"),
        }, {"owner": "o", "repo": "r"});
        assertRegex("base=develop", rest.last().path);

        # every generic search operator is answered; what varies is who does the work
        hash<DataProviderInfo> info = issues.getInfo();
        assertTrue(info.expressions{DP_SEARCH_OP_EQ}.supports_pushdown);
        assertFalse(info.expressions{DP_SEARCH_OP_REGEX}.supports_pushdown);
        assertTrue(exists info.expressions{DP_SEARCH_OP_REGEX}, "an operator GitHub cannot evaluate is "
            "still offered, because this module evaluates it");
    }

    #! The defect the audit demonstrated: a limit counts matching records, not records read
    /** Measured before this change: a repository holding 10 closed issues among 100, asked for 10 records
        where the state is closed, answered with **one** - the fetch stopped at the limit and the filter ran
        afterwards, so nine matching issues were never read.
    */
    private recordLimitTest() {
        FakeGitHubRestClient rest();
        AbstractDataProvider issues = table(rest, "issues");

        # 250 issues served 100 to a page, as GitHub serves them: two full pages and a short third one,
        # and a short page is the last page.  Every twenty-fifth issue matches, so the ten matches are
        # spread over all three pages and none of them can be reached without reading that far
        for (int p = 1; p <= 3; ++p) {
            list<hash<auto>> body = ();
            for (int j = (p - 1) * 100; j < p * 100 && j < 250; ++j) {
                body += {"id": j, "number": j, "state": "open",
                    "title": sprintf("%s %d", j % 25 == 0 ? "match" : "issue", j)};
            }
            rest.push_response({"body": body});
        }

        list<hash<auto>> found = map $1, issues.searchRecords(<DataProviderExpression>{
            "exp": DP_SEARCH_OP_REGEX,
            "args": (<DataProviderFieldReference>{"field": "title"}, "^match "),
        }, {"owner": "o", "repo": "r", "limit": 10});
        assertEq(10, found.size(), "a limit counts matching records, not records read");
        assertEq(3, rest.requests.size(), "every page holding a match was read");
        assertEq(225, found[9].number, "the last match is on the last page");

        # and a limit met on the first page stops there
        rest.reset();
        list<hash<auto>> one_page = ();
        for (int j = 0; j < 100; ++j) {
            one_page += {"id": j, "number": j, "title": sprintf("issue %d", j), "state": "open"};
        }
        rest.push_response({"body": one_page});
        found = map $1, issues.searchRecords(NOTHING, {"owner": "o", "repo": "r", "limit": 3});
        assertEq(3, found.size());
        assertEq(1, rest.requests.size());
    }

    #! A repository is addressed by its owner and its name, and the listing spans owners
    private repositoryTableTest() {
        FakeGitHubRestClient rest();
        AbstractDataProvider repos = table(rest, "repositories");
        hash<DataProviderInfo> info = repos.getInfo();
        assertTrue(info.supports_read);
        assertFalse(info.supports_create, "a repository is created under an owner, not in this collection");
        assertTrue(info.supports_update);
        assertTrue(info.supports_delete);
        # the one GitHub table with no repository scope: its records are the repositories
        assertNothing(info.search_options.owner);
        assertNothing(info.search_options.repo);
        assertTrue(exists info.search_options.visibility, "the listing's own options are search options");

        # GitHub's listing returns repositories belonging to different owners in one response, which is
        # exactly why the owner cannot be a scope
        rest.push_response({"body": (
            {"id": 1, "name": "alpha", "owner": {"login": "octocat"}, "visibility": "public"},
            {"id": 2, "name": "beta", "owner": {"login": "acme"}, "visibility": "private"},
        )});
        list<hash<auto>> found = map $1, repos.searchRecords();
        assertEq(2, found.size());
        assertEq("octocat", found[0].owner.login);
        assertEq("acme", found[1].owner.login);
        assertEq("/user/repos?per_page=100&page=1", rest.last().path);

        # a write addresses each record by ITS OWN owner, read back off the record
        rest.reset();
        rest.push_response({"body": (
            {"id": 1, "name": "alpha", "owner": {"login": "octocat"}},
            {"id": 2, "name": "beta", "owner": {"login": "acme"}},
        )});
        rest.push_response({"body": {"id": 1, "name": "alpha"}});
        rest.push_response({"body": {"id": 2, "name": "beta"}});
        assertEq(2, repos.updateRecords({"description": "changed"}, <DataProviderExpression>{
            "exp": DP_SEARCH_OP_REGEX,
            "args": (<DataProviderFieldReference>{"field": "name"}, "^"),
        }));
        assertEq(3, rest.requests.size(), "one listing and two updates");
        assertEq("/repos/octocat/alpha", rest.requests[1].path);
        assertEq("/repos/acme/beta", rest.requests[2].path, "each record carries its own owner");

        # naming both parts reads the one repository instead of walking the listing
        rest.reset();
        rest.push_response({"body": {"id": 1, "name": "alpha", "owner": {"login": "octocat"}}});
        *hash<auto> one = repos.searchSingleRecord(<DataProviderExpression>{
            "exp": DP_OP_AND,
            "args": (
                <DataProviderExpression>{"exp": DP_SEARCH_OP_EQ,
                    "args": (<DataProviderFieldReference>{"field": "owner.login"}, "octocat")},
                <DataProviderExpression>{"exp": DP_SEARCH_OP_EQ,
                    "args": (<DataProviderFieldReference>{"field": "name"}, "alpha")},
            ),
        });
        assertEq("alpha", one.name);
        assertEq(1, rest.requests.size());
        assertEq("/repos/octocat/alpha", rest.last().path);

        # naming only the name is not naming a repository: two owners may each have one
        rest.reset();
        rest.push_response({"body": ({"id": 1, "name": "alpha", "owner": {"login": "octocat"}},)});
        map $1, repos.searchRecords(<DataProviderExpression>{
            "exp": DP_SEARCH_OP_EQ,
            "args": (<DataProviderFieldReference>{"field": "name"}, "alpha"),
        });
        assertRegex("^/user/repos", rest.requests[0].path, "a partial identity walks the listing");
    }

    private recordCreateTest() {
        FakeGitHubRestClient rest();
        AbstractDataProvider issues = table(rest, "issues");

        rest.push_response({"body": {"id": 9, "number": 12, "title": "from a record",
            "labels": ({"name": "bug"},)}});
        *hash<auto> rec = issues.createRecord({
            "title": "from a record",
            "body": "a description",
            "labels": ("bug",),
            "assignees": (),
            "milestone": NOTHING,
        }, {"owner": "qoretechnologies", "repo": "qorus"});

        assertEq("POST", rest.last().method);
        assertEq("/repos/qoretechnologies/qorus/issues", rest.last().path);
        auto sent = rest.lastBody();
        assertEq("from a record", sent.title);
        assertEq(("bug",), sent.labels);
        assertNothing(sent.assignees, "an empty column is not sent; GitHub rejects a null where it wants "
            "a value");
        assertNothing(sent.milestone);
        assertNothing(sent.id, "the identity is GitHub's to assign");
        assertEq(12, rec.number);
        assertEq(("bug",), rec.labels, "the created record comes back in the table's shape");

        assertThrows("CREATE-RECORD-ERROR", "repo", \issues.createRecord(), ({"title": "x"},
            {"owner": "qoretechnologies"}));

        # a column the create does not accept is dropped rather than turned into a request GitHub rejects:
        # a record is read and written in one shape, and "state" is settable only on an update
        rest.reset();
        rest.push_response({"body": {"id": 10, "number": 13, "title": "x"}});
        issues.createRecord({"title": "x", "state": "open", "number": 99},
            {"owner": "o", "repo": "r"});
        assertEq({"title": "x"}, rest.lastBody());
    }

    private recordUpdateTest() {
        FakeGitHubRestClient rest();
        AbstractDataProvider issues = table(rest, "issues");

        # an issue is addressed by its number within the repository, not by GitHub's global ID, so a search
        # naming the number changes exactly that issue and reads nothing first
        rest.push_response({"body": {"id": 1, "number": 7, "state": "closed"}});
        assertTrue(issues.updateSingleRecord({"state": "closed"}, <DataProviderExpression>{
            "exp": DP_SEARCH_OP_EQ,
            "args": (<DataProviderFieldReference>{"field": "number"}, 7),
        }, {"owner": "o", "repo": "r"}));
        assertEq(1, rest.requests.size(), "naming the record needs no search");
        assertEq("PATCH", rest.last().method);
        assertEq("/repos/o/r/issues/7", rest.last().path);
        assertEq({"state": "closed"}, rest.lastBody());

        # any other predicate is resolved by reading the table first, and every matching record is updated
        rest.reset();
        rest.push_response({"body": ({"id": 1, "number": 1, "title": "a", "state": "open"},
            {"id": 2, "number": 2, "title": "b", "state": "open"})});
        rest.push_response({"body": {"id": 1, "number": 1, "state": "closed"}});
        rest.push_response({"body": {"id": 2, "number": 2, "state": "closed"}});
        assertEq(2, issues.updateRecords({"state": "closed"}, <DataProviderExpression>{
            "exp": DP_SEARCH_OP_REGEX,
            "args": (<DataProviderFieldReference>{"field": "title"}, "^[ab]$"),
        }, {"owner": "o", "repo": "r"}));
        assertEq(3, rest.requests.size(), "one listing and two updates");
        assertEq("GET", rest.requests[0].method);
        assertEq("/repos/o/r/issues/1", rest.requests[1].path);
        assertEq("/repos/o/r/issues/2", rest.requests[2].path);

        # a table with no update action says so rather than doing nothing
        AbstractDataProvider releases = table(rest, "releases");
        assertThrows("INVALID-OPERATION", \releases.updateRecords(), ({"name": "x"}, {"id": 1},
            {"owner": "o", "repo": "r"}));
    }

    #! The three read-only tables publish GitHub's own shape and are named by what its paths take
    /** Unlike the tables that replace a TypeScript application, these have no predecessor whose column
        names have to be preserved, so the record type is the schema's and cannot drift from it.
    */
    private readOnlyTableTest() {
        FakeGitHubRestClient rest();
        GitHubDataProvider::GitHubDataProvider dp(rest);
        AbstractDataProvider tables =
            dp.getChildProviderEx(GitHubDataProvider::GitHubDataProvider::TablesChildName);

        foreach string name in (("labels", "collaborators", "contributors")) {
            hash<DataProviderInfo> info = tables.getChildProviderEx(name).getInfo();
            assertFalse(info.supports_create, sprintf("table %y creates nothing", name));
            assertFalse(info.supports_update, sprintf("table %y updates nothing", name));
            assertFalse(info.supports_delete, sprintf("table %y deletes nothing", name));
            assertTrue(info.supports_read, sprintf("table %y is readable", name));
            # a repository is the collection, so the caller supplies it and the listing requires it
            map assertTrue(info.search_options{$1}.required,
                sprintf("table %y requires the %y scope option", name, $1)), ("owner", "repo");
            # none of them takes a filter expression, whatever query arguments the listing has
            assertFalse(info.supports_native_search, sprintf("table %y has no query language", name));
        }

        # the identity is what GitHub's paths take, not the numeric ID every one of these records carries
        assertEq("name", GitHubRecordTables::LabelsTable.id_field);
        assertEq("login", GitHubRecordTables::CollaboratorsTable.id_field);
        assertEq("login", GitHubRecordTables::ContributorsTable.id_field);
        hash<string, AbstractDataField> lrt = tables.getChildProviderEx("labels").getRecordType();
        assertTrue(exists lrt.name, "the identity is a column");
        assertTrue(exists lrt.id, "and the global ID is published as well");

        # the record type is GitHub's own, not a projection
        assertNothing(GitHubRecordTables::CollaboratorsTable.record_type);
        assertNothing(GitHubRecordTables::CollaboratorsTable.to_record);
        hash<string, AbstractDataField> crt = tables.getChildProviderEx("collaborators").getRecordType();
        map assertTrue(exists crt{$1}, sprintf("collaborators publish %y", $1)),
            ("login", "role_name", "permissions", "site_admin");
        assertTrue(exists tables.getChildProviderEx("contributors").getRecordType().contributions,
            "a contributor carries the number of contributions made");

        # neither of the collaborator listing's arguments describes a column, so neither is pushed down:
        # "affiliation" appears in no record and "permission" is not the record's "role_name"
        assertNothing(GitHubRecordTables::CollaboratorsTable.filters);
        assertEq(("affiliation", "permission"), GitHubRecordTables::CollaboratorsTable.search_options);
        RestSchemaRecordFilter cf(GitHubRecordTables::CollaboratorsTable);
        hash<RestSchemaRecordFilterSplit> s = cf.split(<DataProviderExpression>{
            "exp": DP_SEARCH_OP_EQ,
            "args": (<DataProviderFieldReference>{"field": "role_name"}, "admin"),
        });
        assertEq({}, s.options, "a role predicate is not sent as a permission argument");
        assertEq(DP_SEARCH_OP_EQ, s.client.exp, "it is answered as the records arrive");
    }
}
