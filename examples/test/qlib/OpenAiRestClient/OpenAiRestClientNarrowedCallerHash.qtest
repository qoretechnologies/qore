#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
#
# Copyright 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires OpenAiRestClient
%requires OpenAiDataProvider

%exec-class OpenAiRestClientNarrowedCallerHashTest

#! Option and configuration hashes whose values all have the same type
/** A hash literal whose values all have the same type, such as \c {"apikey": "..."}, has a narrowed type (here
    \c hash<string, string>); the library must still be able to add values of other types to its own copy and report
    the real problem with the configuration.  No request is sent: connections and clients are only created
*/
class OpenAiRestClientNarrowedCallerHashTest inherits QUnit::Test {
    constructor() : Test("OpenAiRestClientNarrowedCallerHashTest", "1.0", \ARGV) {
        addTestCase("client options with only boolean values", \booleanClientOptions());
        addTestCase("response request with only list values", \responseRequest());
        set_return_value(main());
    }

    #! Returns the hash with its runtime type, as a caller's literal arrives in a library function
    static hash<auto> mk(hash<auto> h) {
        return h;
    }

    booleanClientOptions() {
        # the options are a hash<string, bool>, which cannot take the string schema path
        assertEq("hash<string, bool>", mk({"use_schema": True}).fullType());
        hash<auto> opts = OpenAiRestClientBase::getOptions({"use_schema": True});
        assertEq(True, opts.use_schema);
        assertEq(normalize_dir(dirname(get_module_hash().OpenAiRestClient.filename)
            + "/OpenAiDataProvider/openai-swagger-2.0.yaml"), normalize_dir(opts.swagger));
        assertEq(OpenAiRestClient::DefaultUrl, opts.url);
    }

    responseRequest() {
        # the request is a hash<string, list<hash<string, string>>>, which cannot take the string model ID
        assertEq("hash<string, list<hash<string, string>>>", mk({"input": ({"text": "hello"},)}).fullType());
        hash<auto> req = OpenAiModelCreateResponseDataProvider::prepareRequest({"input": ({"text": "hello"},)},
            {"id": "gpt-4o"});
        assertEq({"input": "hello", "model": "gpt-4o"}, req);
    }
}
