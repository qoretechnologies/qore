#!/usr/bin/env qore
# Copyright 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires OpenApi3
%requires RestSchemaActions
%requires RestClientIo
%requires json
%exec-class ParameterContentTest

class ContentParameterClient inherits RestClientIo::RestClientIo {
    public {
        string request_path;
        *hash<auto> request_headers;
    }
    constructor() : RestClientIo({"url": "https://example.test"}) {
    }
    #! Schema dispatch now supplies an explicit target; retain this mock's response recorder.
    hash<RestClient::RestResponseInfo> restDoRawRequestTarget(string method,
            hash<RestClient::RestRequestTarget> target, *data body, *hash<auto> hdr) {
        return restDoRawRequest(method, target.path, body, hdr);
    }

    hash<RestResponseInfo> restDoRawRequest(string method, string path, *data body, *hash<auto> hdr) {
        request_path = path;
        request_headers = hdr;
        return <RestResponseInfo>{"body": {"received": True}};
    }
}

class ParameterContentTest inherits QUnit::Test {
    private {
        const Document = {
            "openapi": "3.1.0", "info": {"title": "Agent metadata", "version": "1"},
            "paths": {"/agents": {"get": {
                "parameters": (
                    {"name": "metadata", "in": "query", "required": False,
                        "content": {"application/json": {"schema": {
                            "type": "object", "additionalProperties": False,
                            "properties": {"team": {"type": "string"}, "active": {"type": "boolean"}},
                        }}}},
                    {"name": "names", "in": "query", "content": {"application/json": {"schema": {
                        "type": "array", "items": {"type": "string"},
                    }}}},
                    {"name": "label", "in": "query", "content": {"application/json": {
                        "schema": {"type": "string"},
                    }}},
                    {"name": "page", "in": "query", "schema": {"type": "integer"}},
                ),
                "responses": {"200": {"description": "Matching agents", "content": {
                    "application/json": {"schema": {"type": "object"}},
                }}},
            }}},
        };
        const Action = <RestSchemaActionInfo>{
            "action": "list-agents", "path": "/agents", "method": "GET",
            "display_name": "List Agents", "short_desc": "Find agents by metadata",
            "desc": "Find agents for a business team.",
        };
    }
    constructor() : Test("OpenAPI parameter content", "1.0", \ARGV) {
        addTestCase("content parameters publish typed action options", \typeTest());
        addTestCase("action serializes JSON objects, arrays and strings once", \actionTest());
        addTestCase("client and server round trip content query values", \roundTripTest());
        addTestCase("content path and header parameters", \pathHeaderTest());
        addTestCase("invalid schemas, values and unknown parameters fail", \negativeTest());
        set_return_value(main());
    }
    private OpenApi3Schema getSchema() {
        return new OpenApi3Schema("content test", Document);
    }
    private typeTest() {
        OpenApi3Schema schema = getSchema();
        RestSchemaActionSet actions(schema, (Action,));
        hash<string, AbstractDataField> fields = actions.getOperationEx("list-agents").getRequestFields();
        assertEq(NT_HASH, fields.metadata.getType().getBaseTypeCode());
        assertEq(NT_BOOLEAN, fields.metadata.getType().getFields().active.getType().getBaseTypeCode());
        assertFalse(fields.metadata.isMandatory());
        assertEq(NT_LIST, fields.names.getType().getBaseTypeCode());
        assertEq(NOTHING, schema.paths.match("/agents").getOperation("get", "/agents").query_obj,
            "content objects must not consume unrelated query arguments");
    }
    private actionTest() {
        RestSchemaActionSet actions(getSchema(), (Action,));
        ContentParameterClient client();
        RestSchemaActionDataProvider provider(actions, actions.getOperationEx("list-agents"), client);
        hash<auto> options = {
            "metadata": {"team": "Sales & R&D=EU/Prague", "active": False},
            "names": ("a,b", "c&d"), "label": "quoted \"label\"", "page": 2,
        };
        hash<auto> original = options;
        assertTrue(provider.doRequest(options).received);
        hash<UriQueryInfo> query = parse_uri_query(client.request_path);
        assertEq(options.metadata, parse_json(query.params.metadata));
        assertEq(options.names, parse_json(query.params.names));
        assertEq(options.label, parse_json(query.params.label));
        assertEq("2", query.params.page);
        assertEq(original, options);
        provider.doRequest({"metadata": {}, "names": (), "label": ""});
        query = parse_uri_query(client.request_path);
        assertEq({}, parse_json(query.params.metadata));
        assertEq((), parse_json(query.params.names));
        assertEq("", parse_json(query.params.label));
        provider.doRequest({"page": 0});
        assertEq({"page": "0"}, parse_uri_query(client.request_path).params);
    }
    private roundTripTest() {
        OpenApi3Schema schema = getSchema();
        string path = "/agents?metadata=" + encode_url(make_json({"team": "a&b", "active": False}), True)
            + "&names=" + encode_url(make_json(("a,b", "c")), True)
            + "&label=" + encode_url(make_json("quoted \"label\""), True) + "&page=0";
        hash<RestRequestClientInfo> outgoing = schema.processRequest("GET", path, NOTHING);
        hash<auto> headers = {};
        hash<RestRequestServerInfo> incoming = schema.parseRequest("GET", outgoing.uri_path, NOTHING, \headers);
        assertEq({"team": "a&b", "active": False}, incoming.query.metadata);
        assertEq(("a,b", "c"), incoming.query.names);
        assertEq("quoted \"label\"", incoming.query.label);
        assertEq(0, incoming.query.page);
    }
    private negativeTest() {
        hash<auto> doc = Document;
        doc.paths."/agents".get.parameters[0].schema = {"type": "object"};
        assertThrows("INVALID-PARAMETER", sub () { new OpenApi3Schema("both", doc); });
        doc.paths."/agents".get.parameters[0].schema = {};
        assertThrows("INVALID-PARAMETER", sub () { new OpenApi3Schema("both with empty schema", doc); });
        doc = Document;
        doc.paths."/agents".get.parameters[0].content = {};
        assertThrows("INVALID-CONTENT", sub () { new OpenApi3Schema("empty", doc); });
        doc = Document;
        doc.paths."/agents".get.parameters[0].content."text/plain" = {"schema": {"type": "string"}};
        assertThrows("INVALID-CONTENT", sub () { new OpenApi3Schema("multiple", doc); });
        OpenApi3Schema schema = getSchema();
        assertThrows("DESERIALIZATION-ERROR", sub () {
            schema.processRequest("GET", "/agents?metadata=not-json", NOTHING);
        });
        assertThrows("SCHEMA-VALIDATION-ERROR", sub () {
            schema.processRequest("GET", "/agents?unknown=wrong", NOTHING);
        });
        assertThrows("SCHEMA-VALIDATION-ERROR", sub () {
            schema.processRequest("GET", "/agents?metadata=17", NOTHING);
        });
        hash<auto> headers = {};
        assertThrows("DESERIALIZATION-ERROR", sub () {
            schema.parseRequest("GET", "/agents?metadata=not-json", NOTHING, \headers);
        });
    }

    private pathHeaderTest() {
        hash<auto> doc = Document;
        doc.paths = {"/agents/{key}": {"get": {
            "parameters": (
                {"name": "key", "in": "path", "required": True,
                    "content": {"application/json": {"schema": {"type": "string"}}}},
                {"name": "x-filter", "in": "header", "content": {"application/json": {
                    "schema": {"type": "object", "properties": {"active": {"type": "boolean"}}},
                }}},
            ), "responses": Document.paths."/agents".get.responses,
        }}};
        OpenApi3Schema schema("path and header content", doc);
        RestSchemaActionSet actions(schema, (cast<hash<RestSchemaActionInfo>>(Action + {"path": "/agents/{key}"}),));
        ContentParameterClient client();
        RestSchemaActionDataProvider provider(actions, actions.getOperationEx("list-agents"), client);
        string key = "team&region";
        provider.doRequest({"key": key, "x-filter": {"active": False}});
        assertEq("/agents/" + encode_url(make_json(key), True), client.request_path);
        assertEq({"active": False}, parse_json(client.request_headers."x-filter"));
        hash<auto> headers = client.request_headers;
        hash<RestRequestServerInfo> incoming = schema.parseRequest("GET", client.request_path, NOTHING, \headers);
        assertEq(key, incoming.path_args.key);
        assertEq({"active": False}, headers."x-filter");
    }
}
