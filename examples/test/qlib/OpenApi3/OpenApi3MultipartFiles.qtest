#!/usr/bin/env qore
# Copyright 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/OpenApi3.qm
%requires json
%exec-class MultipartFilesTest

class MultipartFilesTest inherits QUnit::Test {
    private {
        OpenApi3Schema schema = new OpenApi3Schema("multipart test", {
            "openapi": "3.0.3", "info": {"title": "Invoice upload", "version": "1"},
            "paths": {"/upload": {"post": {
                "requestBody": {"required": True, "content": {"multipart/form-data": {"schema": {
                    "type": "object", "required": ("file", "model"), "properties": {
                        "file": {"type": "string", "format": "binary"},
                        "model": {"type": "string"},
                        "enabled": {"type": "boolean"},
                        "temperature": {"type": "number"},
                        "comment": {"type": "string"},
                        "settings": {"type": "object", "additionalProperties": True},
                        "metadata": {"type": "object", "additionalProperties": True},
                        "tags": {"type": "array", "items": {"type": "string"}},
                        "images": {"type": "array", "items": {"type": "string", "format": "binary"}},
                        "extra": {"anyOf": ({"type": "string", "format": "binary"}, {"type": "null"})},
                        "file_or_url": {"anyOf": ({"type": "string", "format": "binary"},
                            {"type": "string", "format": "uri"})},
                    },
                }, "encoding": {"settings": {"style": "deepObject", "explode": True}}}}},
                "responses": {"200": {"description": "Stored file", "content": {
                    "application/octet-stream": {"schema": {"type": "string", "format": "binary"}},
                }}},
            }}},
        });
    }
    constructor() : Test("OpenAPI multipart files", "1.0", \ARGV) {
        addTestCase("named files retain bytes, filenames, media types and field order", \fileTest());
        addTestCase("structured fields retain their declared form encoding", \structuredTest());
        addTestCase("legacy binary files and empty files", \binaryTest());
        addTestCase("invalid file input is rejected before serialization", \negativeTest());
        addTestCase("file request types preserve requiredness and cached wire types", \fieldTest());
        addTestCase("file arrays retain every named part through generated requests", \arrayTest());
        addTestCase("raw binary parts honor declared media types", \encodingTest());
        addTestCase("raw request bodies preserve bytes and empty payloads", \rawRequestTest());
        set_return_value(main());
    }
    private fileTest() {
        binary bytes = <00017FFF52494646>;
        hash<auto> request = {
            "file": {"name": "invoice.wav", "content": bytes, "mime_type": "audio/wav"},
            "model": "transcribe", "enabled": False, "temperature": 0, "comment": "",
            "extra": {"name": "notes.txt", "content": make_base64_string("invoice 42")},
        };
        hash<auto> original = request;
        hash<RestRequestClientInfo> result = schema.processRequest("POST", "/upload", request);
        hash<string, hash<FormDataMessageInfo>> parts = MultiPartFormDataMessage::parseMessage(
            result.content, result.body.toString());
        assertEq(original, request, "serialization must not mutate the caller's file objects");
        assertEq("invoice.wav", parts.file.filename);
        assertEq("audio/wav", parts.file.hdr."content-type");
        assertEq(bytes, parts.file.body);
        assertEq("notes.txt", parts.extra.filename);
        assertEq("text/plain", parts.extra.hdr."content-type");
        assertEq("invoice 42", parts.extra.body);
        assertEq("false", parts.enabled.body);
        assertEq(0.0, parts.temperature.body.toFloat());
        assertEq("", parts.comment.body);
        assertEq("transcribe", parts.model.body);
        assertEq(NOTHING, parts.model.filename);
        assertEq(NOTHING, parts.model.hdr."content-type");
        hash<MessageInfo> raw_parts = MultiPartMessage::parseBody(
            (result.content =~ x/boundary="([^"]+)"/)[0], result.body);
        assertRegex("name=\"model\"", raw_parts.part[0].hdr."content-disposition");
        assertRegex("filename=\"invoice.wav\"", raw_parts.part[4].hdr."content-disposition");
        assertRegex("filename=\"notes.txt\"", raw_parts.part[5].hdr."content-disposition");
    }
    private structuredTest() {
        foreach hash<auto> metadata in ({}, {"value": {"name": "literal", "content": "ordinary data"}}) {
            hash<auto> request = {"model": "transcribe", "file": {"name": "empty.wav", "content": binary()},
                "settings": {"seconds": 0, "enabled": False, "comment": ""}, "metadata": metadata, "tags": ()};
            hash<RestRequestClientInfo> result = schema.processRequest("POST", "/upload", request);
            hash<string, hash<FormDataMessageInfo>> parts = MultiPartFormDataMessage::parseMessage(
                result.content, result.body.toString());
            assertEq("0", parts."settings[seconds]".body);
            assertEq("false", parts."settings[enabled]".body);
            assertEq("", parts."settings[comment]".body);
            assertEq(metadata, parse_json(parts.metadata.body.toString()));
            assertEq((), parse_json(parts.tags.body.toString()));
            assertRegex("^application/json(?:;|$)", parts.metadata.hdr."content-type");
            assertNothing(parts.metadata.filename);
            assertEq("empty.wav", parts.file.filename);
        }
    }

    private arrayTest() {
        OpenApi3::PathItemObject pio = schema.paths.match("/upload");
        OpenApi3::OperationObject op = pio.getOperation("post", "/upload");
        hash<auto> request = {"model": "edit", "file": binary("base"),
            "images": ({"name": "one.png", "content": binary("one"), "mime_type": "image/png"},
                {"name": "two.png", "content": binary(), "mime_type": "image/png"})};
        auto accepted = op.getRequestBodyField(pio).acceptsValue(request);
        assertEq(2, accepted.images.size());
        hash<auto> headers;
        data body = op.getRequestBody(pio, accepted, \headers);
        hash<MessageInfo> message = MultiPartMessage::parseBody(
            (headers."Content-Type" =~ x/boundary="([^"]+)"/)[0], body);
        assertEq(4, message.part.size());
        assertTrue(message.part[2].hdr."content-disposition".find("name=\"images[]\"") >= 0);
        assertRegex("filename=\"one.png\"", message.part[2].hdr."content-disposition");
        assertEq(binary("one"), message.part[2].body);
        assertRegex("filename=\"two.png\"", message.part[3].hdr."content-disposition");
        assertEq(binary(), message.part[3].body);
        assertThrows("SCHEMA-VALIDATION-ERROR", sub () {
            schema.processRequest("POST", "/upload", {"model": "edit", "file": binary(),
                "images": ({"name": "", "content": binary()},)});
        });
    }

    private binaryTest() {
        foreach binary bytes in (binary(), binary("raw data")) {
            hash<RestRequestClientInfo> result = schema.processRequest("POST", "/upload", {
                "model": "transcribe", "file": bytes,
            });
            hash<string, hash<FormDataMessageInfo>> parts = MultiPartFormDataMessage::parseMessage(
                result.content, result.body.toString());
            assertEq("file", parts.file.filename);
            assertEq("application/octet-stream", parts.file.hdr."content-type");
            assertEq(bytes, parts.file.body);
        }
    }
    private encodingTest() {
        hash<MessageInfo> result = OpenApi3::OperationObject::serializeMultipartBody(
            {"config": {}, "audio": <00017fff>},
            {"config": {"contentType": "application/json"}, "audio": {"contentType": "audio/wav, audio/pcm"}},
            {"audio": True});
        hash<MessageInfo> parts = MultiPartMessage::parseBody(
            (result.hdr."Content-Type" =~ x/boundary="([^"]+)"/)[0], result.body);
        assertEq({}, parse_json(parts.part[0].body.toString()));
        assertEq("audio/wav", parts.part[1].hdr."content-type");
        assertEq(<00017fff>, parts.part[1].body);
        result = OpenApi3::OperationObject::serializeMultipartBody(
            {"audio": {"name": "raw.pcm", "mime_type": "audio/pcm", "content": <00017fff>}},
            {"audio": {"contentType": "audio/wav, audio/pcm"}}, {"audio": True});
        parts = MultiPartMessage::parseBody(
            (result.hdr."Content-Type" =~ x/boundary="([^"]+)"/)[0], result.body);
        assertEq("audio/pcm", parts.part[0].hdr."content-type");
        assertEq(<00017fff>, parts.part[0].body);
    }
    private rawRequestTest() {
        OpenApi3Schema raw_schema("raw bodies", {
            "openapi": "3.0.3", "info": {"title": "Raw uploads", "version": "1"},
            "paths": {"/upload": {"post": {
                "requestBody": {"required": True, "content": {"application/octet-stream": {
                    "schema": {"type": "string", "format": "binary"},
                }}},
                "responses": {"204": {"description": "Uploaded"}},
            }}},
        });
        foreach binary bytes in (binary(), <00017fff>) {
            hash<RestRequestClientInfo> result = raw_schema.processRequest("POST", "/upload", bytes);
            assertEq(bytes, result.body);
            assertEq("application/octet-stream", result.content);
        }
        assertThrows("SCHEMA-VALIDATION-ERROR", sub () {
            raw_schema.processRequest("POST", "/upload", {"value": "not binary"});
        });
    }
    private negativeTest() {
        foreach hash<auto> file in ({"name": "invoice.wav"}, {"content": binary("x")},
                {"name": "", "content": binary("x")}, {"name": "invoice.wav", "content": 5},
                {"name": "invoice.wav", "content": binary("x"), "unexpected": True}) {
            *hash<ExceptionInfo> error;
            try {
                schema.processRequest("POST", "/upload", {"model": "transcribe", "file": file});
            } catch (hash<ExceptionInfo> ex) {
                error = ex;
            }
            assertTrue(exists error);
            assertRegex("^(SCHEMA-VALIDATION-ERROR|RUNTIME-TYPE-ERROR|MISSING-VALUE-ERROR)$", error.err);
        }
    }
    private fieldTest() {
        OpenApi3::PathItemObject pio = schema.paths.match("/upload");
        OpenApi3::OperationObject op = pio.getOperation("post", "/upload");
        AbstractDataField field = op.getRequestBodyField(pio);
        hash<string, AbstractDataField> fields = field.getType().getFields();
        assertTrue(fields.file.isMandatory());
        assertFalse(fields.extra.isMandatory());
        assertTrue(fields.file.getType() instanceof QoreUnionDataType);
        assertEq(binary("bytes"), fields.file.acceptsValue(binary("bytes")));
        hash<auto> file = fields.file.acceptsValue({"name": "invoice.wav", "content": binary("bytes")});
        assertEq("invoice.wav", file.name);
        assertEq(binary("bytes"), parse_base64_string(file.content));
        assertEq(NOTHING, fields.extra.acceptsValue(NOTHING));
        # The interned wire schema may be reused in a response or a JSON operation.
        AbstractDataField wire = schema.getFieldFromSchema("body", "Wire body", op.body.schema);
        assertEq(NT_BINARY, wire.getType().getFields().file.getType().getBaseTypeCode());
        assertEq(NT_STRING, fields.model.getType().getBaseTypeCode());
        QoreUnionDataType uploads = cast<QoreUnionDataType>(fields.file_or_url.getType().getMandatoryType());
        assertEq("file", uploads.getUnionTypes()[0].getName(), "named files keep the established outer alternative");
        assertTrue(uploads.getUnionTypes()[1] instanceof OpenApi3UnionDataType,
            "the original wire union retains composition rules and presentation identity");
        assertEq("invoice.pdf", fields.file_or_url.acceptsValue({
            "name": "invoice.pdf", "content": binary("pdf")}).name);
        assertEq("https://example.com/invoice.pdf",
            fields.file_or_url.acceptsValue("https://example.com/invoice.pdf"));
    }
}
