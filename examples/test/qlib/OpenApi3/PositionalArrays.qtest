#!/usr/bin/env qore
# Copyright 2026 Qore Technologies, s.r.o. SPDX-License-Identifier: MIT
%modern
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires OpenApi3
%exec-class PositionalArraysTest

class PositionalArraysTest inherits QUnit::Test {
    constructor() : Test("OpenAPI 3.1 positional arrays", "1.0") {
        addTestCase("unconstrained arrays accept values and enforce bounds and uniqueness", \openArrayTest());
        addTestCase("typed positions and closed tails survive native serialization", \tupleTest());
        addTestCase("nested tuple alternatives retain timestamp and image positions", \nestedTest());
        addTestCase("positional response direction and recursive presentation are bounded", \directionTest());
        addTestCase("positions of a list whose values all have one type are converted", \narrowedListTest());
        set_return_value(main());
    }
    private OpenApi3Schema document(hash<auto> schema) {
        return new OpenApi3Schema("", {"openapi": "3.1.0", "info": {"title": "Array fixture", "version": "1"},
            "paths": {}, "components": {"schemas": {"Value": schema}}});
    }
    private openArrayTest() {
        auto doc = document({"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": True});
        auto value = (0, {"value": False});
        doc.components.schemas.Value.check(False, True, "/", "POST", "array", \value);
        assertEq((0, {"value": False}), value);
        foreach auto invalid in (((), (1, 2, 3), (1, 1.0), ({"a": 0, "b": False}, {"b": False, "a": 0}))) {
            assertThrows("SCHEMA-VALIDATION-ERROR", sub () {
                auto input = invalid;
                doc.components.schemas.Value.check(False, True, "/", "POST", "array", \input);
            });
        }
    }
    private tupleTest() {
        auto doc = document({"type": "array", "prefixItems": ({"type": "number", "minimum": 0},
            {"type": "string", "minLength": 1}), "items": False, "minItems": 2});
        AbstractDataProviderType type = doc.components.schemas.Value.getDataType();
        for (int pass = 0; pass < 3; ++pass) {
            assertTrue(type.getElementType() instanceof QoreUnionDataType);
            assertEq((0.0, "image"), type.acceptsValue((0, "image")));
            assertEq((1.5, "image"), type.acceptsValue((1.5, "image")));
            foreach auto value in ((("0", "image"), (0, ""), (-1, "image"), (0, "image", "extra"), (0,), "image")) {
                assertThrows("TYPE-VALUE-ERROR", sub () { type.acceptsValue(value); });
            }
            assertNothing(type.getOrNothingType().acceptsValue(NOTHING));
            assertEq((0.0, "image"), type.getSoftType().acceptsValue((0, "image")));
            type = Serializable::deserialize(type.serialize());
        }
    }
    #! a literal list of integers has a value type narrowed to int; its number positions are converted to numbers
    private narrowedListTest() {
        auto doc = document({"type": "array", "prefixItems": ({"type": "number"}, {"type": "number"}),
            "items": False, "minItems": 2});
        list<int> ints = (1, 2);
        auto value = ints;
        doc.components.schemas.Value.check(False, True, "/", "POST", "array", \value);
        assertEq((1.0, 2.0), value);
        assertEq((1, 2), ints, "the caller's list is unchanged");
        AbstractDataProviderType type = doc.components.schemas.Value.getDataType();
        assertEq((1.0, 2.0), type.acceptsValue(ints));
        # a refused value is refused as a value, not as a type error in the check
        list<int> one = (1,);
        assertEq("TYPE-VALUE-ERROR", getExceptionCode(sub () { type.acceptsValue(one); }));
    }

    private string getExceptionCode(code c) {
        try {
            c();
        } catch (hash<ExceptionInfo> ex) {
            return ex.err;
        }
        return "no exception";
    }

    private directionTest() {
        auto doc = document({"type": "array", "prefixItems": ({"type": "object", "properties": {
            "id": {"type": "string", "readOnly": True}, "secret": {"type": "string", "writeOnly": True}},
            "required": ("id",)},), "items": False});
        auto request = doc.components.schemas.Value.getDataType();
        auto response = OpenApi3HashDataType::forResponse(request);
        for (int pass = 0; pass < 3; ++pass) {
            assertEq(({"id": "published"},), response.acceptsValue(({"id": "published"},)));
            assertThrows("TYPE-VALUE-ERROR", sub () { request.acceptsValue(({"id": "published"},)); });
            response = Serializable::deserialize(response.serialize());
        }
        auto recursive = document({"type": "array", "prefixItems": ({"$ref": "#/components/schemas/Value"},), "items": False});
        auto type = recursive.components.schemas.Value.getDataType();
        assertEq(((),), type.acceptsValue(((),)));
    }
    private nestedTest() {
        auto pair = {"type": "array", "prefixItems": ({"type": "number"}, {"type": "string"}), "minItems": 2, "maxItems": 2};
        auto doc = document({"anyOf": ({"type": "string"}, pair,
            {"type": "array", "items": pair}, {"type": "array", "items": {"type": "string"}})});
        AbstractDataProviderType type = doc.components.schemas.Value.getDataType();
        for (int pass = 0; pass < 3; ++pass) {
            auto pairs = ((0.0, "first"), (3.5, "last"));
            assertEq(pairs, type.acceptsValue(pairs));
            assertEq(("first", "last"), type.acceptsValue(("first", "last")));
            assertThrows("TYPE-VALUE-ERROR", sub () { type.acceptsValue(((False, "image"),)); });
            type = Serializable::deserialize(type.serialize());
        }
    }
}
