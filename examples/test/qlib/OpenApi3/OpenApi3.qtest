    }

    testCommonExtensions() {
        checkModules();

        # Test schema-specific extensions
        {
            hash<auto> schema = {
                "openapi": "3.0.3",
                "info": {"title": "Test API", "version": "1.0"},
                "paths": {},
                "components": {
                    "schemas": {
                        "Status": {
                            "type": "string",
                            "enum": ("active", "inactive", "pending"),
                            "x-enum-varnames": ("STATUS_ACTIVE", "STATUS_INACTIVE", "STATUS_PENDING"),
                            "x-enum-descriptions": ("Currently active", "Not active", "Awaiting activation"),
                            "x-codegen-type": "StatusEnum",
                            "x-model-name": "StatusModel",
                            "x-class-name": "StatusClass",
                            "x-example": "active",
                            "x-examples": ("active", "pending"),
                            "x-internal": True,
                            "x-hidden": True,
                            "x-deprecated": True,
                            "x-displayName": "Status Field",
                        },
                    },
                },
            };
            OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", schema);
            OpenApi3::SchemaObject status = so.components.schemas.Status;
            assertEq(("STATUS_ACTIVE", "STATUS_INACTIVE", "STATUS_PENDING"), status.getEnumVarnames());
            assertEq(("Currently active", "Not active", "Awaiting activation"), status.getEnumDescriptions());
            assertEq("StatusEnum", status.getCodegenType());
            assertEq("StatusModel", status.getModelName());
            assertEq("StatusClass", status.getClassName());
            assertEq("active", status.getXExample());
            assertEq(("active", "pending"), status.getXExamples());
            # Test common ObjectBase extension accessors
            assertTrue(status.isInternal());
            assertTrue(status.isHidden());
            assertTrue(status.isXDeprecated());
            assertEq("Status Field", status.getDisplayName());
        }

        # Test top-level extensions (x-logo, x-tagGroups)
        {
            hash<auto> schema = {
                "openapi": "3.0.3",
                "info": {"title": "Test API", "version": "1.0"},
                "paths": {},
                "x-logo": {
                    "url": "https://example.com/logo.png",
                    "altText": "API Logo",
                    "backgroundColor": "#FFFFFF",
                },
                "x-tagGroups": (
                    {"name": "Core", "tags": ("users", "orders")},
                    {"name": "Admin", "tags": ("admin", "settings")},
                ),
            };
            OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", schema);
            hash<auto> logo = so.getLogo();
            assertEq("https://example.com/logo.png", logo.url);
            assertEq("API Logo", logo.altText);
            assertEq("#FFFFFF", logo.backgroundColor);

            list<hash<auto>> tagGroups = so.getTagGroups();
            assertEq(2, tagGroups.size());
            assertEq("Core", tagGroups[0].name);
            assertEq(("users", "orders"), tagGroups[0].tags);
        }

        # Test displayName extension on tags
        {
            hash<auto> schema = {
                "openapi": "3.0.3",
                "info": {"title": "Test API", "version": "1.0"},
                "paths": {},
                "tags": (
                    {
                        "name": "users",
                        "description": "User management",
                        "x-displayName": "User Management",
                    },
                ),
            };
            OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", schema);
            assertEq("User Management", so.tags[0].getDisplayName());
        }
    }

    testOpenApi31NegativeCases() {
        checkModules();

        # Test invalid OpenAPI version (not 3.x)
        {
            hash<auto> schema = {
                "openapi": "2.0",
                "info": {"title": "Test API", "version": "1.0"},
                "paths": {},
            };
            assertThrows("INVALID-OPENAPI3-VERSION", sub () {
                OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", schema);
            });
        }

        # Test invalid type array (empty list) - defaults to "any"
        {
            hash<auto> schema = {
                "openapi": "3.1.0",
                "info": {"title": "Test API", "version": "1.0"},
                "paths": {},
                "components": {
                    "schemas": {
                        "EmptyType": {
                            "type": (),
                        },
                    },
                },
            };
            # Empty type array defaults to "any" type
            OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", schema);
            assertEq("any", so.components.schemas.EmptyType.type);
        }

        # Test type array with only null - defaults to "any" type with nullable
        {
            hash<auto> schema = {
                "openapi": "3.1.0",
                "info": {"title": "Test API", "version": "1.0"},
                "paths": {},
                "components": {
                    "schemas": {
                        "OnlyNull": {
                            "type": ("null",),
                        },
                    },
                },
            };
            OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", schema);
            assertTrue(so.components.schemas.OnlyNull.nullable);
            # When only null type, defaults to "any"
            assertEq("any", so.components.schemas.OnlyNull.type);
        }

        # Test invalid exclusiveMinimum type (string)
        {
            hash<auto> schema = {
                "openapi": "3.1.0",
                "info": {"title": "Test API", "version": "1.0"},
                "paths": {},
                "components": {
                    "schemas": {
                        "InvalidExclusive": {
                            "type": "number",
                            "exclusiveMinimum": "invalid",
                        },
                    },
                },
            };
            assertThrows("INVALID-FIELD-TYPE", "exclusiveMinimum", sub () {
                OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", schema);
            });
        }

        # Test invalid exclusiveMaximum type (string)
        {
            hash<auto> schema = {
                "openapi": "3.1.0",
                "info": {"title": "Test API", "version": "1.0"},
                "paths": {},
                "components": {
                    "schemas": {
                        "InvalidExclusive": {
                            "type": "number",
                            "exclusiveMaximum": "invalid",
                        },
                    },
                },
            };
            assertThrows("INVALID-FIELD-TYPE", "exclusiveMaximum", sub () {
                OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", schema);
            });
        }

        # Test invalid examples type (not a list)
        {
            hash<auto> schema = {
                "openapi": "3.1.0",
                "info": {"title": "Test API", "version": "1.0"},
                "paths": {},
                "components": {
                    "schemas": {
                        "InvalidExamples": {
                            "type": "string",
                            "examples": "not a list",
                        },
                    },
                },
            };
            assertThrows("INVALID-FIELD-TYPE", "examples", sub () {
                OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", schema);
            });
        }

        # Test invalid webhooks type (not a hash)
        {
            hash<auto> schema = {
                "openapi": "3.1.0",
                "info": {"title": "Test API", "version": "1.0"},
                "paths": {},
                "webhooks": "invalid",
            };
            assertThrows("INVALID-FIELD-TYPE", "webhooks", sub () {
                OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", schema);
            });
        }

        # Test invalid security scheme type
        {
            hash<auto> schema = {
                "openapi": "3.1.0",
                "info": {"title": "Test API", "version": "1.0"},
                "paths": {},
                "components": {
                    "securitySchemes": {
                        "invalid": {
                            "type": "unknownType",
                        },
                    },
                },
            };
            assertThrows("INVALID-SCHEME-TYPE", "unknownType", sub () {
                OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", schema);
            });
        }

        # Test invalid contentEncoding type
        {
            hash<auto> schema = {
                "openapi": "3.1.0",
                "info": {"title": "Test API", "version": "1.0"},
                "paths": {},
                "components": {
                    "schemas": {
                        "InvalidEncoding": {
                            "type": "string",
                            "contentEncoding": 123,
                        },
                    },
                },
            };
            assertThrows("INVALID-FIELD-TYPE", "contentEncoding", sub () {
                OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", schema);
            });
        }

        # Test invalid info.summary type
        {
            hash<auto> schema = {
                "openapi": "3.1.0",
                "info": {
                    "title": "Test API",
                    "version": "1.0",
                    "summary": 123,
                },
                "paths": {},
            };
            assertThrows("INVALID-FIELD-TYPE", "summary", sub () {
                OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", schema);
            });
        }

        # Test invalid license.identifier type
        {
            hash<auto> schema = {
                "openapi": "3.1.0",
                "info": {
                    "title": "Test API",
                    "version": "1.0",
                    "license": {
                        "name": "MIT",
                        "identifier": 123,
                    },
                },
                "paths": {},
            };
            assertThrows("INVALID-FIELD-TYPE", "identifier", sub () {
                OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", schema);
            });
