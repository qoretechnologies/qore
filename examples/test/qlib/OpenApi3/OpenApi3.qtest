        addTestCase("Test getTypeForReference/replaceTypeForReference", \testTypeForReference());
        addTestCase("Test multiple object-valued query parameters", \testMultipleObjectQueryParams());
        addTestCase("Test server URL scheme", \testServerUrlScheme());
        addTestCase("Test form-encoded request body encoding", \testFormUrlEncodedBody());
        addTestCase("Test response header references", \testResponseHeaderReference());
        addTestCase("Test constraint-only compositions", \testConstraintOnlyComposition());
        addTestCase("Test reference siblings", \testReferenceSiblings());

        # Return for compatibility with test harness that checks return value.
        set_return_value(main());
    }

    checkModules() {
%ifdef NoYaml
        testSkip("no yaml module");
%endif
    }

    #! An operation may declare any number of object-valued query parameters
    /** OpenAPI 3 places no limit on them, and a real schema commonly declares several: Stripe's
        \c "GET /v1/credit_notes/preview" declares \c metadata and \c shipping_cost, each
        \c "style: deepObject" with \c "explode: true", so they serialize to disjoint and
        unambiguous query strings (\c "metadata[k]=v" against
        \c "shipping_cost[shipping_rate]=...").

        This module used to reject the second one outright, because it treated "the object-valued
        query parameter" and "the parameter that collects **undeclared** query arguments" as the
        same thing.  Only the second role needs there to be exactly one, so the restriction made a
        valid document unloadable — and the whole of Stripe's published schema with it.
    */
    testMultipleObjectQueryParams() {
        checkModules();

        hash<auto> meta = {
            "name": "metadata", "in": "query", "style": "deepObject", "explode": True,
            "schema": {"type": "object", "additionalProperties": {"type": "string"}},
        };
        hash<auto> shipping = {
            "name": "shipping_cost", "in": "query", "style": "deepObject", "explode": True,
            "schema": {"type": "object", "properties": {"shipping_rate": {"type": "string"}}},
        };
        hash<auto> plain = {"name": "limit", "in": "query", "schema": {"type": "integer"}};

        hash<auto> third = {
            "name": "discounts", "in": "query", "style": "deepObject", "explode": True,
            "schema": {"type": "object", "properties": {"coupon": {"type": "string"}}},
        };

        # two object-valued query parameters: this is what used to be rejected outright
        assertTrue(exists loadWithQueryParams((meta, shipping, plain)),
            "two object-valued query parameters load");
        # ...and any number beyond that is no different
        assertTrue(exists loadWithQueryParams((meta, shipping, third, plain)),
            "three object-valued query parameters load");
        # one still acts as the catch-all for undeclared arguments, unchanged
        assertTrue(exists loadWithQueryParams((meta, plain)),
            "a single object-valued query parameter still loads");
        # and none at all is still fine
        assertTrue(exists loadWithQueryParams((plain,)),
            "an operation with no object-valued query parameter loads");
    }

    testServerUrlScheme() {
        checkModules();

        # the scheme declared in "servers" has to survive into the target URL: downgrading a schema that
        # says it is served over TLS would have a client built from it send credentials in the clear
        OpenApi3Schema https = loadWithServers(({"url": "https://api.example.com/v1"},));
        assertEq("https://api.example.com/v1", https.getTargetUrl());

        OpenApi3Schema http = loadWithServers(({"url": "http://api.example.com/v1"},));
        assertEq("http://api.example.com/v1", http.getTargetUrl());

        # a schema declaring no servers at all keeps the historical default
        hash<auto> soh = ValidOpenApi3Schema + {
            "paths": {"/preview": {"get": {"operationId": "preview", "responses": {"200": {"description": "ok"}}}}},
            "host": "api.example.com",
        };
        remove soh.servers;
        assertEq("http://api.example.com",
            OpenApi3::OpenApi3Loader::fromString(my_make_json(soh), True).getTargetUrl());
    }

    testResponseHeaderReference() {
        checkModules();

        # a response declares each of its headers as either a Header Object or a Reference Object, and a
        # description that keeps its headers in "#/components/headers" -- as GitHub's does for the "Link"
        # pagination header -- is unparseable unless the reference is followed
        OpenApi3Schema schema = loadWithResponseHeader({"$ref": "#/components/headers/link"}, True);
        assertTrue(exists schema.components.headers.link, "the header component is parsed");
        assertEq("string", schema.components.headers.link.getSchema().type);
        assertEq(("get",), schema.getPathOperationHash(){"preview"},
            "the operation whose response header is a reference is reachable; before the reference was "
            "followed the whole document failed to parse");

        # an inline header still works, and is the case that always worked
        OpenApi3Schema inline = loadWithResponseHeader({"schema": {"type": "string"}}, False);
        assertEq(("get",), inline.getPathOperationHash(){"preview"},
            "a header declared inline needs no component to resolve against");

        # a reference that names nothing has to say so, rather than yielding an empty header
        assertThrows("INVALID-REFERENCE", "cannot resolve", \loadWithResponseHeader(),
            ({"$ref": "#/components/headers/nope"}, True));
    }

    #! Builds a one-operation schema whose 200 response declares one "Link" header
    private OpenApi3Schema loadWithResponseHeader(hash<auto> header, bool declare_component) {
        hash<auto!> soh = ValidOpenApi3Schema + {
            "paths": {
                "/preview": {
                    "get": {
                        "operationId": "preview",
                        "responses": {
                            "200": {
                                "description": "ok",
                                "headers": {"Link": header},
                            },
                        },
                    },
                },
            },
        };
        if (declare_component) {
            soh.components = soh.components + {
                "headers": {"link": {"description": "pagination", "schema": {"type": "string"}}},
            };
        }
        return OpenApi3::OpenApi3Loader::fromString(my_make_json(soh), True);
    }

    testReferenceSiblings() {
        checkModules();

        # OpenAPI 3.0 says a sibling of "$ref" is ignored, because a Reference Object is a JSON Reference.
        # Real descriptions rely on it: Xero's accounting document declares "$ref" beside "type" at 28
        # sites, and rejecting them made the whole document unloadable.
        hash<auto> base = ValidOpenApi3Schema + {
            "paths": {
                "/preview": {
                    "get": {
                        "operationId": "preview",
                        "parameters": ({"$ref": "#/components/parameters/a", "type": "string"},),
                        "responses": {"200": {"description": "ok"}},
                    },
                },
            },
        };
        OpenApi3Schema schema = OpenApi3::OpenApi3Loader::fromString(my_make_json(base), True);
        assertEq(("get",), schema.getPathOperationHash(){"preview"},
            "a parameter reference with a sibling loads");

        # a schema reference has always ignored its siblings; this is the case that already worked
        OpenApi3::OpenApi3Schema sibling_schema("", ValidOpenApi3Schema + {
            "components": ValidOpenApi3Schema.components + {
                "schemas": {
                    "Currency": {"type": "string"},
                    "Holder": {
                        "type": "object",
                        "properties": {
                            "code": {"$ref": "#/components/schemas/Currency", "type": "string"},
                        },
                    },
                },
            },
        });
        assertEq("string", sibling_schema.components.schemas.Holder.properties.code.type,
            "the sibling is ignored and the reference decides the type");

        # ... but a reference that names nothing is still an error, whatever it is written beside
        hash<auto> bad = base;
        bad.paths."/preview".get.parameters = ({"$ref": "#/components/parameters/nope", "type": "string"},);
        assertThrows("INVALID-REFERENCE", "cannot resolve", \OpenApi3::OpenApi3Loader::fromString(),
            (my_make_json(bad), True));
    }

    testConstraintOnlyComposition() {
        checkModules();

        # an object that declares its properties and then adds "anyOf: [{required: [a]}, {required: [b]}]"
        # is saying "at least one of these two", not "one of two different shapes"; exposing that as a union
        # would replace a typed object by an opaque one.  GitHub's "request reviewers" body is this.
        OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", ValidOpenApi3Schema + {
            "components": ValidOpenApi3Schema.components + {
                "schemas": {
                    "Reviewers": {
                        "type": "object",
                        "properties": {
                            "reviewers": {"type": "array", "items": {"type": "string"}},
                            "team_reviewers": {"type": "array", "items": {"type": "string"}},
                        },
                        "anyOf": ({"required": ("reviewers",)}, {"required": ("team_reviewers",)}),
                    },
                    "Union": {"anyOf": ({"type": "string"}, {"type": "integer"})},
                    "Alternatives": {
                        "type": "object",
                        "properties": {"a": {"type": "string"}},
                        "oneOf": (
                            {"type": "object", "properties": {"b": {"type": "string"}}},
                            {"type": "object", "properties": {"c": {"type": "string"}}},
                        ),
                    },
                },
            },
        });

        OpenApi3::SchemaObject reviewers = so.components.schemas.Reviewers;
        assertTrue(reviewers.isConstraintOnlyComposition());
        AbstractDataProviderType t = reviewers.getDataType();
        assertEq(NT_HASH, t.getBaseTypeCode(), "the object keeps its own type");
        *hash<string, AbstractDataField> fields = t.getFields();
        assertTrue(exists fields.reviewers, "the properties are still published as fields");
        assertTrue(exists fields.team_reviewers);

        # a composition whose members are real alternatives is still a union
        OpenApi3::SchemaObject u = so.components.schemas.Union;
        assertFalse(u.isConstraintOnlyComposition());
        assertNeq(NT_HASH, u.getDataType().getBaseTypeCode(),
            "alternatives of different types stay a union");

        # ... and so is one whose members carry properties of their own
        OpenApi3::SchemaObject alt = so.components.schemas.Alternatives;
        assertFalse(alt.isConstraintOnlyComposition(),
            "a member with properties of its own describes a shape, not a constraint");
    }

    testFormUrlEncodedBody() {
        checkModules();

        # "deepObject" is what an API taking structured form bodies declares, and without honoring the
        # Encoding Object a property that is not a scalar cannot be serialized at all
        OpenApi3Schema schema = loadWithFormBody({
            "metadata": {"style": "deepObject", "explode": True},
            "expand": {"style": "deepObject", "explode": True},
            "nested": {"style": "deepObject", "explode": True},
        });
        assertEq("email=a%40b.com&metadata%5Border%5D=123&expand%5B0%5D=src&expand%5B1%5D=inv",
            serializeBody(schema, {
                "email": "a@b.com",
                "metadata": {"order": "123"},
                "expand": ("src", "inv"),
            }));

        # deepObject nests to any depth
        assertEq("nested%5Ba%5D%5B0%5D%5Bb%5D=1",
            serializeBody(schema, {"nested": {"a": ({"b": 1},)}}));

        # a boolean is written as "true"/"false", not as the "1"/"0" a string conversion would give
        assertEq("nested%5Bflag%5D=true", serializeBody(schema, {"nested": {"flag": True}}));

        # "form" with explode, the OpenAPI default: an object's properties become top-level pairs and an
        # array repeats its key
        OpenApi3Schema form = loadWithFormBody({});
        assertEq("email=a%40b.com&order=123", serializeBody(form, {
            "email": "a@b.com",
            "metadata": {"order": "123"},
        }));
        assertEq("expand=src&expand=inv", serializeBody(form, {"expand": ("src", "inv")}));

        # "form" without explode joins with commas
        OpenApi3Schema noexp = loadWithFormBody({
            "expand": {"style": "form", "explode": False},
            "metadata": {"style": "form", "explode": False},
        });
        assertEq("expand=src,inv", serializeBody(noexp, {"expand": ("src", "inv")}));
        assertEq("metadata=order,123", serializeBody(noexp, {"metadata": {"order": "123"}}));

        # the delimited styles
        OpenApi3Schema delim = loadWithFormBody({
            "expand": {"style": "spaceDelimited", "explode": False},
            "codes": {"style": "pipeDelimited", "explode": False},
        });
        assertEq("expand=src%20inv", serializeBody(delim, {"expand": ("src", "inv")}));
        assertEq("codes=1%7C2", serializeBody(delim, {"codes": (1, 2)}));

        # a style that cannot express the value has to say so rather than serialize something wrong
        OpenApi3Schema bad = loadWithFormBody({"metadata": {"style": "spaceDelimited", "explode": False}});
        assertThrows("SERIALIZATION-ERROR", "cannot serialize an object value", \serializeBody(),
            (bad, {"metadata": {"order": "123"}}));
        OpenApi3Schema unknown = loadWithFormBody({"metadata": {"style": "matrix", "explode": True}});
        assertThrows("SERIALIZATION-ERROR", "is not valid for a form-encoded request body", \serializeBody(),
            (unknown, {"metadata": {"order": "123"}}));
    }

    #! Serializes a request body for the fixture operation and returns the wire form
    private string serializeBody(OpenApi3Schema schema, hash<auto> body) {
        OpenApi3::PathItemObject pio = schema.paths.tryMatch("/things");
        OpenApi3::OperationObject op = pio.getOperation("post", "/things");
        hash<auto> hdr = {};
        *data rv = op.getRequestBody(pio, body, \hdr, True);
        assertEq(MimeTypeFormUrlEncoded, hdr."Content-Type");
        return rv.toString();
    }

    #! Builds a one-operation schema with a form-encoded request body using the given Encoding Object
    private OpenApi3Schema loadWithFormBody(hash<auto> encoding) {
        hash<auto> content = {
            "schema": {
                "type": "object",
                "properties": {
                    "email": {"type": "string"},
                    "metadata": {"type": "object", "additionalProperties": {"type": "string"}},
                    "expand": {"type": "array", "items": {"type": "string"}},
                    "nested": {"type": "object"},
                    "codes": {"type": "array", "items": {"type": "integer"}},
                },
            },
        };
        if (encoding) {
            content.encoding = encoding;
        }
        hash<auto> soh = ValidOpenApi3Schema + {
            "paths": {
                "/things": {
                    "post": {
                        "operationId": "createThing",
                        "requestBody": {
                            "required": True,
                            "content": {MimeTypeFormUrlEncoded: content},
                        },
                        "responses": {"200": {"description": "ok"}},
                    },
                },
            },
        };
        return OpenApi3::OpenApi3Loader::fromString(my_make_json(soh), True);
    }

    #! Builds a one-operation schema with the given "servers" list
    private OpenApi3Schema loadWithServers(list<auto> servers) {
        hash<auto> soh = ValidOpenApi3Schema + {
            "paths": {"/preview": {"get": {"operationId": "preview", "responses": {"200": {"description": "ok"}}}}},
            "servers": servers,
        };
        return OpenApi3::OpenApi3Loader::fromString(my_make_json(soh), True);
    }

    #! Builds a one-operation schema whose query parameters are the ones given
    private OpenApi3Schema loadWithQueryParams(list<auto> params) {
        hash<auto> soh = ValidOpenApi3Schema + {
            "paths": {
                "/preview": {
                    "get": {
                        "operationId": "preview",
                        "parameters": params,
                        "responses": {"200": {"description": "ok"}},
                    },
                },
            },
        };
        return OpenApi3::OpenApi3Loader::fromString(my_make_json(soh), True);
    }

    testTypeForReference() {
        checkModules();

        # build a schema with a reusable schema reference in "components.schemas"
        hash<auto> soh = ValidOpenApi3Schema + {
            "components": ValidOpenApi3Schema.components + {
                "schemas": {
                    "Pet": {
                        "type": "object",
                        "properties": {
                            "name": {"type": "string"},
                            "age": {"type": "integer"},
                        },
                    },
                },
            },
        };
        OpenApi3Schema schema("", soh);

        # the uniform reference methods are inherited from AbstractRestSchemaValidator
        AbstractDataProviderType t = schema.getTypeForReference("Pet");
        assertEq(NT_HASH, t.getBaseTypeCode());
        assertFalse(t.isOrNothingType());
        # the resolved hash type exposes the schema's fields
        assertEq(("name", "age"), keys t.getFields());

        # the "or nothing" variant is returned when required = False
        AbstractDataProviderType opt = schema.getTypeForReference("Pet", False);
        assertTrue(opt.isOrNothingType());

        # an unknown reference raises a well-defined exception
        assertThrows("INVALID-REFERENCE-TYPE", "Unknown", \schema.getTypeForReference(), ("Unknown",));

        # replaceTypeForReference swaps the cached type for the reference
        AbstractDataProviderType newtype = AbstractDataProviderType::get("string");
        schema.replaceTypeForReference("Pet", newtype);
        assertEq("string", schema.getTypeForReference("Pet").getBaseTypeName());

        # replacing an unknown reference raises the same exception
        assertThrows("INVALID-REFERENCE-TYPE", "Unknown", \schema.replaceTypeForReference(),
            ("Unknown", newtype));
    }

    testFiles() {
        checkModules();

        {
            OpenApi3::OpenApi3Schema so;
            string basePath = normalize_dir(dirname(get_script_path())) + DirSep;

            # Should not throw.
            # PetStore files have servers: [{url: "https://petstore.swagger.io/v2"}]
            # so basePath is extracted as "/v2"
            so = OpenApi3::OpenApi3Loader::fromFile(basePath + "PetStore.openapi3.json");
            assertTrue(exists so);
            assertEq("/v2", so.getBasePath());
            delete so;
            so = OpenApi3::OpenApi3Loader::fromFile(basePath + "PetStore.openapi3.yaml");
            assertTrue(exists so);
            assertEq("/v2", so.getBasePath());

            assertThrows("EMPTY-SCHEMA-FILE", sub() {so = OpenApi3::OpenApi3Loader::fromFile(basePath + "EmptyOpenApi3.yaml");});
            assertThrows("EMPTY-SCHEMA-FILE", sub() {so = OpenApi3::OpenApi3Loader::fromFile(basePath + "EmptyOpenApi3.json");});
        }

        {
            hash soh = ValidOpenApi3Schema + (
                "paths": (
                    "/test": (
                        "get": (
                            "operationId": "test",
                            "responses": (
                                "200": (
                                    "description": "test",
                                ),
                            ),
                            "parameters": ((
                                "in": "body",
                                "name": "ignored",
                                "required": True,
                                "schema": (
                                    "$ref": "other.json#/info",
                                ),
                            ),),
                        ),
                    ),
                ),
            );
            assertThrows("FILE-OPEN2-ERROR", "other.json", sub () {OpenApi3Schema so("", soh);});

            code try_import = string sub (string fn) { return OtherJsonErr; };
            assertThrows("INVALID-REFERENCE", "other.json.*info", sub () {OpenApi3Schema so("", soh, ("try_import": try_import));});
            try_import = string sub (string fn) { return OtherJsonOk; };
            {
                OpenApi3Schema so("", soh, ("try_import": try_import));
                assertEq("/", so.getBasePath());
            }

            soh.paths."/test".get.parameters[0].schema."$ref" = "other.yaml#/info";
            assertThrows("FILE-OPEN2-ERROR", "other.yaml", sub () {OpenApi3Schema so("", soh);});

            try_import = string sub (string fn) { return OtherYamlErr; };
            assertThrows("INVALID-REFERENCE", "other.yaml.*info", sub () {OpenApi3Schema so("", soh, ("try_import": try_import));});
            try_import = string sub (string fn) { return OtherYamlOk; };
            OpenApi3Schema so("", soh, ("try_import": try_import));
        }
    }

    testOpenApi3Schema() {
        checkModules();

        assertThrows("INVALID-FIELD-TYPE", loadjson, '{"openapi": true}');
        assertThrows("REQUIRED-FIELD-MISSING", loadjson, '{}', "missing openapi3 field");
        assertThrows("REQUIRED-FIELD-MISSING", loadjson, '{"openapi": 3.0}', "missing info field");
        assertThrows("INVALID-FIELD-TYPE", loadjson, '{"openapi": 3.0, "info": []}', "invalid info field type");
        assertThrows("REQUIRED-FIELD-MISSING", loadjson, '{"openapi": 3.0, "info": {"title":"", "version":""}}',
            "missing paths field");

        assertTrue(loadjson(ValidOpenApi3SchemaJSON));
        assertTrue(loadyaml(ValidOpenApi3SchemaYAML));

        # Used for following tests.
        hash base = ValidOpenApi3Schema;

        assertTrue(loadyaml(my_make_yaml(base + {"host": "localhost"})));
        assertThrows("INVALID-FIELD-TYPE", loadyaml, my_make_yaml(base + {"host": 2.0}),
            "invalid host field type");

        assertTrue(loadyaml(my_make_yaml(base + {"basePath": "/test"})));
        assertThrows("INVALID-FIELD-FORMAT", loadyaml, my_make_yaml(base + {"basePath": "gfhgf"}),
            "invalid basePath format");
        assertThrows("INVALID-FIELD-TYPE", loadyaml, my_make_yaml(base + {"basePath": 2.0}),
            "invalid basePath field type");

        # Test OpenAPI 3.0 servers array parsing
        # servers array should set host and basePath from the first server URL
        {
            hash<auto> spec = {
                "openapi": "3.0.0",
                "info": {"title": "Servers Test", "version": "1.0"},
                "servers": (
                    {"url": "https://api.example.com:8080/v1/api"},
                ),
                "paths": {},
            };
            OpenApi3Schema so("", spec);
            assertEq("api.example.com:8080", so.host);
            assertEq("/v1/api", so.basePath);
        }

        # Test servers array with just a path (relative URL)
        {
            hash<auto> spec = {
                "openapi": "3.0.0",
                "info": {"title": "Servers Path Test", "version": "1.0"},
                "servers": (
                    {"url": "/api/v2"},
                ),
                "paths": {},
            };
            OpenApi3Schema so("", spec);
            assertEq("/api/v2", so.basePath);
        }

        # Test that trailing slash is removed from basePath
        {
            hash<auto> spec = {
                "openapi": "3.0.0",
                "info": {"title": "Trailing Slash Test", "version": "1.0"},
                "servers": (
                    {"url": "https://api.example.com/v1/"},
                ),
                "paths": {},
            };
            OpenApi3Schema so("", spec);
            assertEq("/v1", so.basePath);
        }

        # Test that explicit host/basePath are not overwritten by servers
        {
            hash<auto> spec = {
                "openapi": "3.0.0",
                "info": {"title": "Explicit Override Test", "version": "1.0"},
                "host": "explicit.example.com",
                "basePath": "/explicit",
                "servers": (
                    {"url": "https://api.example.com/v1"},
                ),
                "paths": {},
            };
            OpenApi3Schema so("", spec);
            # Explicit values should be preserved
            assertEq("explicit.example.com", so.host);
            assertEq("/explicit", so.basePath);
        }

        # Test multiple servers - only first one is used
        {
            hash<auto> spec = {
                "openapi": "3.0.0",
                "info": {"title": "Multiple Servers Test", "version": "1.0"},
                "servers": (
                    {"url": "https://prod.example.com/api"},
                    {"url": "https://staging.example.com/api"},
                ),
                "paths": {},
            };
            OpenApi3Schema so("", spec);
            assertEq("prod.example.com", so.host);
            assertEq("/api", so.basePath);
        }

        # Negative test: servers with invalid url type should be handled gracefully
        {
            hash<auto> spec = {
                "openapi": "3.0.0",
                "info": {"title": "Invalid Server URL Test", "version": "1.0"},
                "servers": (
                    {"url": 12345},  # Invalid URL type (integer instead of string)
                ),
                "paths": {},
            };
            # Should not throw - invalid URL type is silently ignored
            OpenApi3Schema so("", spec);
            assertNothing(so.host);
        }

        # Negative test: servers array with empty object
        {
            hash<auto> spec = {
                "openapi": "3.0.0",
                "info": {"title": "Empty Server Test", "version": "1.0"},
                "servers": (
                    {},  # Empty server object (missing url)
                ),
                "paths": {},
            };
            # Should not throw - missing URL is silently ignored
            OpenApi3Schema so("", spec);
            assertNothing(so.host);
        }

        assertTrue(loadyaml(my_make_yaml(base + {"consumes": ("test", "lalala")})));
        assertThrows("INVALID-FIELD-TYPE", loadyaml, my_make_yaml(base + {"consumes": "2.0"}),
            "invalid consumes field type");
        assertThrows("INVALID-FIELD-TYPE", loadyaml, my_make_yaml(base + {"consumes": (2, 5)}),
            "invalid consumes value type");

        assertTrue(loadyaml(my_make_yaml(base + {"produces": ("test", "lalala")})));
        assertThrows("INVALID-FIELD-TYPE", loadyaml, my_make_yaml(base + {"produces": "2.0"}),
            "invalid produces field type");
        assertThrows("INVALID-FIELD-TYPE", loadyaml, my_make_yaml(base + {"produces": (2, 5)}),
            "invalid produces value type");

        assertThrows("INVALID-FIELD-TYPE", loadyaml, my_make_yaml(base + {"components": {"schemas": 2}}),
            "invalid definitions field type");
        assertThrows("INVALID-FIELD-TYPE", "invalid definition datatype", loadyaml,
            my_make_yaml(base + {"components": {"schemas": {"a": 5}}}), "invalid definitions field value type");

        assertThrows("INVALID-FIELD-TYPE", loadyaml, my_make_yaml(base + {"components": {"parameters": 2}}),
            "invalid parameters field type");
        assertThrows("INVALID-FIELD-TYPE", "invalid parameter datatype", loadyaml,
            my_make_yaml(base + {"components": {"parameters": {"a": 5}}}), "invalid parameters field value type");

        assertThrows("INVALID-FIELD-TYPE", loadyaml, my_make_yaml(base + {"components": {"responses": 2}}),
            "invalid responses field type");
        assertThrows("INVALID-FIELD-TYPE", "invalid response datatype", loadyaml,
            my_make_yaml(base + {"components": {"responses": {"a": 5}}}), "invalid responses field value type");

        assertThrows("INVALID-FIELD-TYPE", loadyaml, my_make_yaml(base +
            {"components": base.components + {"securitySchemes": 2}}),
            "invalid securitySchemes field type");
        assertThrows("INVALID-FIELD-TYPE", "invalid security definition datatype", loadyaml,
            my_make_yaml(base + {"components": base.components + {"securitySchemes": {"a": 5}}}),
                "invalid securitySchemes field value type");

        assertThrows("INVALID-FIELD-TYPE", loadyaml, my_make_yaml(base + {"security": 2}),
            "invalid security field type");
        assertTrue(loadyaml(my_make_yaml(base + {"security": list()})));
        assertTrue(loadyaml(my_make_yaml(base + {
            "components": base.components + {"securitySchemes": {
                "ApiKeyAuth": {"type": "apiKey", "in": "header", "name": "X-API-Key"},
            }},
            "security": ({"ApiKeyAuth": ()}, {}),
        })));
        assertThrows("INVALID-FIELD-TYPE", "\"security\".*type \"integer\"", loadyaml,
            my_make_yaml(base + {"security": (2, 5)}), "invalid security field value type");
        assertThrows("INVALID-FIELD-TYPE", "\"security\".*\"integer\"", loadyaml,
            my_make_yaml(base + {"security": ({"a": "b"}, {"b": 2})}), "invalid security field value type");
        assertThrows("SECURITY-ERROR", "security schemes.*not defined", loadyaml,
            my_make_yaml(base + {"security": ({"a": "b"}, {"b": "a"})}), "invalid security values");

        assertThrows("INVALID-FIELD-TYPE", loadyaml, my_make_yaml(base + {"tags": 2}), "invalid tags field type");
        assertTrue(loadyaml(my_make_yaml(base + {"tags": list()})));
        assertThrows("INVALID-FIELD-TYPE", "invalid tag datatype", loadyaml,
            my_make_yaml(base + {"tags": (5, {})}), "invalid tags field value type");

        assertThrows("INVALID-FIELD-TYPE", loadyaml, my_make_yaml(base + {"externalDocs": 2}), "invalid externalDocs field type");

        {
            hash<auto> soh = ValidOpenApi3Schema + (
                "paths": (
                    "/test": (
                        "get": (
                            "operationId": "test",
                            "responses": (
                                "200": (
                                    "description": "test",
                                ),
                            ),
                            "parameters": ({
                                "in": "header",
                                "name": "Test-Header",
                                "schema": {
                                    "type": "string",
                                },
                                "required": True,
                                "default": "Test",
                            },),
                        ),
                    ),
                ),
            );
            OpenApi3Schema so("", soh);

            {
                string uri_path = "/test";
                hash<auto> hdr = {"Test-Header": "Test"};
                assertEq(Type::Hash, so.processRequest("get", uri_path, NOTHING, hdr).type());
                assertThrows("SCHEMA-VALIDATION-ERROR", \so.processRequest(), ("get", uri_path));
            }

            {
                string uri_path = "/test";
                hash hdr = ("Test-Header": 1);
                assertThrows("SCHEMA-VALIDATION-ERROR", \so.processRequest(), ("get", uri_path, NOTHING, hdr));
            }
        }

        {
            hash soh = ValidOpenApi3Schema + (
                "paths": (
                    "/test": (
                        "get": (
                            "operationId": "test",
                            "responses": (
                                "200": (
                                    "description": "test",
                                    "content": {
                                        "application/json": {
                                            "schema": {
                                                "type": "string"
                                            }
                                        }
                                    }
                                ),
                                "400": (
                                    "description": "test",
                                    "content": {
                                        "application/json": {
                                            "schema": {
                                                "type": "string"
                                            }
                                        }
                                    }
                                ),
                            ),
                            "parameters": ((
                                "in": "query",
                                "name": "bin",
                                "schema": {
                                    "type": "string",
                                    "format": "byte",
                                },
                            ),),
                        ),
                    ),
                ),
            );

            {
                OpenApi3Schema so("", soh);

                string uri_path = "/test?bin=YWJj";
                hash<RestRequestClientInfo> h = so.processRequest("get", uri_path);
                assertEq(Type::Hash, h.type());
                assertEq("/test?bin=YWJj", h.uri_path);

                hash<HttpResponseInfo> res = so.processResponse("get", "/test", 200, "OK", NOTHING, MimeTypeJson);
                assertEq(200, res.code);
                assertEq(MimeTypeJson, res.hdr."Content-Type");
                assertEq("\"OK\"", res.body);

                hash<RestResponseClientInfo> cres = so.parseResponse("get", "/test", res.code, res.body, res.hdr);
                assertEq(200, cres.code);
                assertEq(MimeTypeJson, cres.hdr."Content-Type");
                assertEq("OK", cres.body);
                #printf("cres: %N\n", cres);

                res = so.processResponse("get", "/test", 400, "ERR", NOTHING, MimeTypeJson);
                assertEq(400, res.code);
                assertEq(MimeTypeJson, res.hdr."Content-Type");
                assertEq("\"ERR\"", res.body);
                #printf("res: %N\n", res);

                cres = so.parseResponse("get", "/test", res.code, res.body, res.hdr);
                assertEq(400, cres.code);
                assertEq(MimeTypeJson, cres.hdr."Content-Type");
                assertEq("ERR", cres.body);
            }

            soh.components.schemas = {
                "robj": (
                    "type": "object",
                    "properties": (
                        "a": (
                            "type": "string",
                        ),
                        "b": (
                            "type": "integer",
                        ),
                        "c": {
                            "type": "integer",
                            "format": "unix-time",
                        },
                    ),
                ),
                "nobj": {
                    "type": "object",
                    "additionalProperties": True,
                },
                "pobj": {
                },
                "nullableobj": {
                    "type": "object",
                    "properties": {
                        "a": {
                            "type": "string",
                            "x-nullable": True,
                        },
                    },
                },
            };
            soh.paths."/test".get.responses."200".schema = {
                "$ref": "#/components/schemas/robj",
            };
            soh.paths."/test".get.responses."404" = {
                "description": "test",
                "schema": {
                    "$ref": "#/components/schemas/nobj",
                },
            };
            soh.paths."/test".get.responses."500" = {
                "description": "test",
                "schema": {
                    "$ref": "#/components/schemas/pobj",
                },
            };
            soh.paths."/test".get.responses."501" = {
                "description": "test",
                "schema": {
                    "$ref": "#/components/schemas/nullableobj",
                },
            };

            {
                OpenApi3Schema so("", soh);

                assertThrows("SCHEMA-VALIDATION-ERROR", \so.processResponse(), ("get", "/test", 200, "OK", NOTHING, MimeTypeJson));

                hash<auto> body = (
                    "a": "hi",
                    "b": 2,
                    "c": 2024-09-19T10:09:42,
                );
                hash<HttpResponseInfo> res = so.processResponse("get", "/test", 200, body, NOTHING, MimeTypeJson);
                assertEq(200, res.code);
                assertEq(MimeTypeJson, res.hdr."Content-Type");
                assertEq(Type::String, res.body.type());
                assertEq(body + {"c": body.c.getEpochSeconds()}, parse_json(res.body));

                hash<RestResponseClientInfo> cres = so.parseResponse("get", "/test", res."code", res.body, res.hdr);
                assertEq(200, cres.code);
                assertEq(MimeTypeJson, cres.hdr."Content-Type");
                assertEq(body, cres.body);
                #printf("cres: %N\n", cres);

                res = so.processResponse("get", "/test", 400, "ERR", NOTHING, MimeTypeJson);
                assertEq(400, res.code);
                assertEq(MimeTypeJson, res.hdr."Content-Type");
                assertEq("\"ERR\"", res.body);

                assertThrows("SCHEMA-VALIDATION-ERROR", \so.processResponse(), ("get", "/test", 200, ("x": 2),
                    NOTHING, MimeTypeJson));

                cres = so.parseResponse("get", "/test", res.code, res.body, res.hdr);
                assertEq(400, cres.code);
                assertEq(MimeTypeJson, cres.hdr."Content-Type");
                assertEq("ERR", cres.body);
                #printf("cres: %N\n", cres);

                res = so.processResponse("get", "/test", 404, {"a": 1}, NOTHING, MimeTypeJson);
                #printf("res: %N\n", res);
                assertEq(404, res.code);
                assertEq(MimeTypeJson, res.hdr."Content-Type");

                cres = so.parseResponse("get", "/test", res.code, res.body, res.hdr);
                #printf("cres: %N\n", cres);
                assertEq(404, cres.code);
                assertEq(MimeTypeJson, cres.hdr."Content-Type");
                assertEq({"a": 1}, cres.body);

                res = so.processResponse("get", "/test", 500, {"a": 1}, NOTHING, MimeTypeJson);
                #printf("res: %N\n", res);
                assertEq(500, res.code);
                assertEq(MimeTypeJson, res.hdr."Content-Type");

                cres = so.parseResponse("get", "/test", res.code, res.body, res.hdr);
                #printf("cres: %N\n", cres);
                assertEq(500, cres.code);
                assertEq(MimeTypeJson, cres.hdr."Content-Type");
                assertEq({"a": 1}, cres.body);

                res = so.processResponse("get", "/test", 500, 123, NOTHING, MimeTypeJson);
                #printf("res: %N\n", res);
                assertEq(500, res.code);
                assertEq(MimeTypeJson, res.hdr."Content-Type");

                cres = so.parseResponse("get", "/test", res.code, res.body, res.hdr);
                #printf("cres: %N\n", cres);
                assertEq(500, cres.code);
                assertEq(MimeTypeJson, cres.hdr."Content-Type");
                assertEq(123, cres.body);

                res = so.processResponse("get", "/test", 501, {"a": "abc"}, NOTHING, MimeTypeJson);
                #printf("res: %N\n", res);
                assertEq(501, res.code);
                assertEq(MimeTypeJson, res.hdr."Content-Type");

                cres = so.parseResponse("get", "/test", res.code, res.body, res.hdr);
                #printf("cres: %N\n", cres);
                assertEq(501, cres.code);
                assertEq(MimeTypeJson, cres.hdr."Content-Type");
                assertEq({"a": "abc"}, cres.body);

                res = so.processResponse("get", "/test", 501, {"a": NOTHING}, NOTHING, MimeTypeJson);
                #printf("res: %N\n", res);
                assertEq(501, res.code);
                assertEq(MimeTypeJson, res.hdr."Content-Type");

                cres = so.parseResponse("get", "/test", res.code, res.body, res.hdr);
                #printf("cres: %N\n", cres);
                assertEq(501, cres.code);
                assertEq(MimeTypeJson, cres.hdr."Content-Type");
                assertEq({"a": NOTHING}, cres.body);
            }
        }

        { # bug #2894 test that if schema is missing from response, then no body should be present for the response
          # also test that if schema is present and there is no response body, exception should be thrown
            hash soh = ValidOpenApi3Schema + (
                "paths": (
                    "/test": (
                        "get": (
                            "operationId": "test",
                            "responses": (
                                "200": (
                                    "description": "test",
                                    "schema": {
                                        "type": "string"
                                    }
                                ),
                                "400": (
                                    "description": "test",
                                ),
                            ),
                            "consumes": (
                                MimeTypeJson,
                                MimeTypeYaml,
                            ),
                            "produces": (
                                MimeTypeJson,
                                MimeTypeYaml,
                            ),
                        ),
                    ),
                ),
            );

            {
                OpenApi3Schema so("", soh);
                hash<HttpResponseInfo> res;
                hash<RestResponseClientInfo> cres;
                hash hdr = {"Content-Type" : "application/json"};

                code c = sub () { res = so.processResponse("get", "/test", 200, NOTHING, NOTHING, MimeTypeJson); };
                assertThrows("SCHEMA-VALIDATION-ERROR", "Param.*response body.*is null, but.*expected", c);

                c = sub () { cres = so.parseResponse("get", "/test", 200, NOTHING, hdr); };
                assertThrows("SCHEMA-VALIDATION-ERROR", "Param.*response body.*is null, but.*expected", c);

                c = sub () { res = so.processResponse("get", "/test", 400, "ERR", NOTHING, MimeTypeJson); };
                assertThrows("SCHEMA-VALIDATION-ERROR", "should not have any body", c);

                c = sub () { cres = so.parseResponse("get", "/test", 400, "\"ERR\"", hdr); };
                assertThrows("SCHEMA-VALIDATION-ERROR", "should not have any body", c);
            }
        }

        {
            hash<auto> soh = ValidOpenApi3Schema + (
                "paths": (
                    "/test": (
                        "get": (
                            "operationId": "test",
                            "parameters": (
                                {
                                    "name": "float",
                                    "in": "query",
                                    "description": "desc",
                                    "required": False,
                                    "schema": {
                                        "type": "number",
                                        "format": "float",
                                    },
                                },
                                {
                                    "name": "dt",
                                    "in": "query",
                                    "description": "desc",
                                    "required": False,
                                    "schema": {
                                        "type": "integer",
                                        "format": "unix-time",
                                    },
                                },
                            ),
                            "responses": (
                                "200": (
                                    "description": "test",
                                    "schema": {
                                        "type": "string"
                                    }
                                ),
                                "400": (
                                    "description": "test",
                                ),
                            ),
                            "consumes": (
                                MimeTypeJson,
                                MimeTypeYaml,
                            ),
                            "produces": (
                                MimeTypeJson,
                                MimeTypeYaml,
                            ),
                        ),
                    ),
                ),
            );

            {
                OpenApi3Schema so("", soh);
                string uri_path = "/test?float=1.1&dt=1726733382";
                # Use += to avoid type narrowing; parseRequest takes reference<hash<auto>>
                hash<auto> hdr += {"Test-Header": "Test"};
                hash<RestRequestServerInfo> req = so.parseRequest("GET", uri_path, NOTHING, \hdr);
                assertEq(Type::Float, req.query."float".type());
                assertEq(2024-09-19T10:09:42, req.query.dt);
            }

            {
                soh.paths."/test".get.parameters[0].format = "xxx";
                OpenApi3Schema so("", soh);
                assertTrue(True);
            }
        }

        {
            hash<auto> soh = ValidOpenApi3Schema + (
                "paths": (
                    "/cust/{id}": (
                        "get": (
                            "operationId": "get-customer",
                            "parameters": (
                                {
                                    "name": "id",
                                    "in": "path",
                                    "description": "customer ID",
                                    "required": True,
                                    "schema": {
                                        "type": "integer",
                                    },
                                },
                            ),
                            "responses": (
                                "200": (
                                    "description": "test",
                                    "schema": {
                                        "type": "string"
                                    }
                                ),
                                "400": (
                                    "description": "test",
                                ),
                            ),
                            "consumes": (
                                MimeTypeJson,
                                MimeTypeYaml,
                            ),
                            "produces": (
                                MimeTypeJson,
                                MimeTypeYaml,
                            ),
                        ),
                    ),
                ),
            );

            {
                OpenApi3Schema so("", soh);
                string uri_path = "/cust/1";
                hash<auto> hdr;
                hash<RestRequestServerInfo> req = so.parseRequest("GET", uri_path, NOTHING, \hdr);
                on_error printf("req: %y\n", req);
                assertEq(1, req.path_args.id);

                uri_path = "cust/1";
                req = so.parseRequest("GET", uri_path, NOTHING, \hdr);
                on_error printf("req: %y\n", req);
                assertEq(1, req.path_args.id);
            }
        }
    }

    testInfoObject() {
        checkModules();

        hash base = ValidOpenApi3Schema;
        hash info;

        assertThrows("REQUIRED-FIELD-MISSING", loadyaml, my_make_yaml(base + {"info": {}}));
        assertThrows("REQUIRED-FIELD-MISSING", "\"version\".*missing", loadyaml, my_make_yaml(base + {"info": {"title": "a"}}));
        assertThrows("REQUIRED-FIELD-MISSING", "\"title\".*missing", loadyaml, my_make_yaml(base + {"info": {"version": "a"}}));
        assertThrows("INVALID-FIELD-TYPE", "title", loadyaml, my_make_yaml(base + {"info": {"title": 5, "version": "a"}}));
        assertThrows("INVALID-FIELD-TYPE", "version", loadyaml, my_make_yaml(base + {"info": {"title": "a", "version": 1.0}}));
        loadyaml(my_make_yaml(base + {"info": {"title": "a", "version": "1.0.0"}}));
        loadyaml(my_make_yaml(base + {"info": {"title": "a", "version": "1.0"}}));

        info = ValidInfoObject + {"description": 5};
        assertThrows("INVALID-FIELD-TYPE", loadyaml, my_make_yaml(base + {"info": info}));
        info = ValidInfoObject + {"description": "lorem ipsum"};
        assertTrue(loadyaml(my_make_yaml(base + {"info": info})));

        info = ValidInfoObject + {"termsOfService": 5};
        assertThrows("INVALID-FIELD-TYPE", loadyaml, my_make_yaml(base + {"info": info}));
        info = ValidInfoObject + {"termsOfService": "lorem ipsum"};
        assertTrue(loadyaml(my_make_yaml(base + {"info": info})));

        info = ValidInfoObject + {"contact": 5};
        assertThrows("INVALID-FIELD-TYPE", loadyaml, my_make_yaml(base + {"info": info}));
        info = ValidInfoObject + {"license": 5};
        assertThrows("INVALID-FIELD-TYPE", loadyaml, my_make_yaml(base + {"info": info}));
    }

