    testPathItemObject() {
        checkModules();

        hash base = ValidOpenApi3Schema;
        hash p;

        p = {"/a": {}};
        assertTrue(loadyaml(my_make_yaml(base + {"paths": p})));

        # reference checks
        p = {"/a": {"$ref": "a"}};
        assertTrue(loadyaml(my_make_yaml(base + {"paths": p})));
        p = {"/a": {"$ref": 5}};
        assertThrows("INVALID-FIELD-TYPE", "ref", loadyaml, my_make_yaml(base + {"paths": p}));

        # operations checks
        p = {"/a": {"get": 5}};
        assertThrows("INVALID-FIELD-TYPE", "get", loadyaml, my_make_yaml(base + {"paths": p}));
        p = {"/a": {"put": 5}};
        assertThrows("INVALID-FIELD-TYPE", "put", loadyaml, my_make_yaml(base + {"paths": p}));
        p = {"/a": {"post": 5}};
        assertThrows("INVALID-FIELD-TYPE", "post", loadyaml, my_make_yaml(base + {"paths": p}));
        p = {"/a": {"delete": 5}};
        assertThrows("INVALID-FIELD-TYPE", "delete", loadyaml, my_make_yaml(base + {"paths": p}));
        p = {"/a": {"options": 5}};
        assertThrows("INVALID-FIELD-TYPE", "options", loadyaml, my_make_yaml(base + {"paths": p}));
        p = {"/a": {"head": 5}};
        assertThrows("INVALID-FIELD-TYPE", "head", loadyaml, my_make_yaml(base + {"paths": p}));
        p = {"/a": {"patch": 5}};
        assertThrows("INVALID-FIELD-TYPE", "patch", loadyaml, my_make_yaml(base + {"paths": p}));
        p = {"/a": {"get": 5}};
        assertThrows("INVALID-FIELD-TYPE", "get", loadyaml, my_make_yaml(base + {"paths": p}));

        # parameters checks
        p = {"/a": {"parameters": list()}};
        assertTrue(loadyaml(my_make_yaml(base + {"paths": p})));
        p = {"/a": {"parameters": ({"$ref": "#/components/parameters/a"}, {
            "name": "a",
            "in": "query",
            "schema": {"type": "string"},
        })}};
        assertTrue(loadyaml(my_make_yaml(base + {"paths": p})));
        p = {"/a": {"parameters": 5}};
        assertThrows("INVALID-FIELD-TYPE", "parameters", loadyaml, my_make_yaml(base + {"paths": p}));
    }

    testOperationObject() {
        checkModules();

        hash base = ValidOpenApi3Schema;
        hash r = {"200": {"description": "a"}};
        hash p;

        p = {"get": {"responses": r}};
        assertTrue(loadyaml(my_make_yaml(base + {"paths": {"/a": p}})));

        # tags checks
        p = {"get": {"responses": r, "tags": ("a", {"name": "a"})}};
        assertTrue(loadyaml(my_make_yaml(base + {"paths": {"/a": p}})));
        p = {"get": {"responses": r, "tags": 5}};
        assertThrows("INVALID-FIELD-TYPE", "tags", loadyaml, my_make_yaml(base + {"paths": {"/a": p}}));

        # summary checks
        p = {"get": {"responses": r, "summary": "a"}};
        assertTrue(loadyaml(my_make_yaml(base + {"paths": {"/a": p}})));
        p = {"get": {"responses": r, "summary": 5}};
        assertThrows("INVALID-FIELD-TYPE", "summary", loadyaml, my_make_yaml(base + {"paths": {"/a": p}}));

        # description checks
        p = {"get": {"responses": r, "description": "a"}};
        assertTrue(loadyaml(my_make_yaml(base + {"paths": {"/a": p}})));
        p = {"get": {"responses": r, "description": 5}};
        assertThrows("INVALID-FIELD-TYPE", "description", loadyaml, my_make_yaml(base + {"paths": {"/a": p}}));

        # deprecated checks
        p = {"get": {"responses": r, "deprecated": True}};
        assertTrue(loadyaml(my_make_yaml(base + {"paths": {"/a": p}})));
        p = {"get": {"responses": r, "deprecated": 5}};
        assertThrows("INVALID-FIELD-TYPE", "deprecated", loadyaml, my_make_yaml(base + {"paths": {"/a": p}}));

        # externalDocs checks
        p = {"get": {"responses": r, "externalDocs": {"url": "a"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"paths": {"/a": p}})));
        p = {"get": {"responses": r, "externalDocs": 5}};
        assertThrows("INVALID-FIELD-TYPE", "externalDocs", loadyaml, my_make_yaml(base + {"paths": {"/a": p}}));

        # operationId checks
        p = {"get": {"responses": r, "operationId": "a"}};
        assertTrue(loadyaml(my_make_yaml(base + {"paths": {"/a": p}})));
        p = {"get": {"responses": r, "operationId": 5}};
        assertThrows("INVALID-FIELD-TYPE", "operationId", loadyaml, my_make_yaml(base + {"paths": {"/a": p}}));

        # consumes checks
        p = {"get": {"responses": r, "consumes": ("a",)}};
        assertTrue(loadyaml(my_make_yaml(base + {"paths": {"/a": p}})));
        p = {"get": {"responses": r, "consumes": (5, 3)}};
        assertThrows("INVALID-FIELD-TYPE", "consumes.*list value", loadyaml, my_make_yaml(base + {"paths": {"/a": p}}));
        p = {"get": {"responses": r, "consumes": 5}};
        assertThrows("INVALID-FIELD-TYPE", "consumes", loadyaml, my_make_yaml(base + {"paths": {"/a": p}}));

        # produces checks
        p = {"get": {"responses": r, "produces": ("a",)}};
        assertTrue(loadyaml(my_make_yaml(base + {"paths": {"/a": p}})));
        p = {"get": {"responses": r, "produces": (5, 3)}};
        assertThrows("INVALID-FIELD-TYPE", "produces.*list value", loadyaml, my_make_yaml(base + {"paths": {"/a": p}}));
        p = {"get": {"responses": r, "produces": 5}};
        assertThrows("INVALID-FIELD-TYPE", "produces", loadyaml, my_make_yaml(base + {"paths": {"/a": p}}));

        # parameters checks
        p = {"get": {"responses": r, "parameters": ({"$ref": "#/components/parameters/a"},)}};
        assertTrue(loadyaml(my_make_yaml(base + {"paths": {"/a": p}})));
        p = {"get": {"responses": r, "parameters": 5}};
        assertThrows("INVALID-FIELD-TYPE", "parameters", loadyaml, my_make_yaml(base + {"paths": {"/a": p}}));

        # responses checks
        p = {"get": {"responses": 5}};
        assertThrows("INVALID-FIELD-TYPE", "responses", loadyaml, my_make_yaml(base + {"paths": {"/a": p}}));

        # security checks
        p = {"get": {"responses": r, "security": ({"a":("b",)},)}};
        assertTrue(loadyaml(my_make_yaml(base + {"paths": {"/a": p}})));
        p = {"get": {"responses": r, "security": 5}};
        assertThrows("INVALID-FIELD-TYPE", "security", loadyaml, my_make_yaml(base + {"paths": {"/a": p}}));
        p = {"get": {"responses": r, "security": (5,)}};
        assertThrows("INVALID-FIELD-TYPE", "security.*list value", loadyaml, my_make_yaml(base + {"paths": {"/a": p}}));
        p = {"get": {"responses": r, "security": ({"a":5},)}};
        assertThrows("INVALID-FIELD-TYPE", "value type", loadyaml, my_make_yaml(base + {"paths": {"/a": p}}));
        p = {"get": {"responses": r, "security": ({"a":(5,)},)}};
        assertThrows("INVALID-FIELD-TYPE", "value type", loadyaml, my_make_yaml(base + {"paths": {"/a": p}}));

        # check validation method
        hash<string, bool> mime_types();
        hash<UriQueryInfo> h({"method": "/create"});
        string filePath = get_script_dir() + DirSep + "Multipart.openapi3.yaml";
        OpenApi3Schema openapi3 = OpenApi3::OpenApi3Loader::fromFile(filePath);
        hash oh = OpenApi3Loader::parseSchemaContent(filePath, ReadOnlyFile::readTextFile(filePath));
        OperationObject op = new OperationObject("/create", "post", oh.paths."/create".post, openapi3);
        string body = "body";
        # Use += to avoid type narrowing; validateRequest takes reference<hash>
        hash<auto> headers += {"header": "header"};

        assertThrows("SCHEMA-VALIDATION-ERROR",
            'Parameter \"formData.upfile\".*expected type is \"string\"',
            sub() {op.validateRequest(False, new PathItemObject("/create", {}, openapi3), \h, \body, \headers,
                \mime_types); });
    }

    testExternalDocumentationObject() {
        checkModules();

        hash base = ValidOpenApi3Schema;
        hash extDocs;

        extDocs = {"externalDocs": {"url": "a"}};
        assertTrue(loadyaml(my_make_yaml(base + extDocs)));
        extDocs = {"externalDocs": {"description": "a"}};
        assertThrows("REQUIRED-FIELD-MISSING", "\"url\".*missing", loadyaml, my_make_yaml(base + extDocs));
        extDocs = {"externalDocs": {"url": 5}};
        assertThrows("INVALID-FIELD-TYPE", "url", loadyaml, my_make_yaml(base + extDocs));
        extDocs = {"externalDocs": {"url": "a", "description": "b"}};
        assertTrue(loadyaml(my_make_yaml(base + extDocs)));
        extDocs = {"externalDocs": {"url": "a", "description": 5}};
        assertThrows("INVALID-FIELD-TYPE", "description", loadyaml, my_make_yaml(base + extDocs));
    }

    testParameterObject() {
        checkModules();

        hash base = ValidOpenApi3Schema;
        hash p;

        # name and in checks
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "string"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"in": "query", "schema": {"type": "string"}}};
        assertThrows("REQUIRED-FIELD-MISSING", "\"name\".*missing", loadyaml,
            my_make_yaml(base + {"components": {"parameters": p}}));
        p = base.components.parameters + {"a": {"name": "a", "schema": {"type": "string"}}};
        assertThrows("REQUIRED-FIELD-MISSING", loadyaml, my_make_yaml(base + {"components": {"parameters": p}}));

        p = base.components.parameters + {"a": {"name": 5, "in": "query", "schema": {"type": "string"}}};
        assertThrows("INVALID-FIELD-TYPE", "name", loadyaml, my_make_yaml(base + {"components": {"parameters": p}}));
        p = base.components.parameters + {"a": {"name": "a", "in": 5, "schema": {"type": "string"}}};
        assertThrows("INVALID-FIELD-TYPE", "in", loadyaml, my_make_yaml(base + {"components": {"parameters": p}}));
        p = base.components.parameters + {"a": {"name": "a", "in": "a", "schema": {"type": "string"}}};
        assertThrows("INVALID-FIELD-VALUE", "in", loadyaml, my_make_yaml(base + {"components": {"parameters": p}}));

        # description checks
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "string"}, "description": 5}};
        assertThrows("INVALID-FIELD-TYPE", "description", loadyaml, my_make_yaml(base + {"components": {"parameters": p}}));

        # TODO - body location parameter - have to do SchemaObject first

        # in (location) checks
        p = base.components.parameters + {"a": {"name": "a", "in": "formData", "schema": {"type": "string"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "header", "schema": {"type": "string"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "string"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));

        # "required" checks
        p = base.components.parameters + {"a": {"name": "a", "in": "path", "schema": {"type": "string"},
            "required": False}};
        assertThrows("INVALID-PARAMETER", loadyaml, (my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "path", "schema": {"type": "string"}}};
        assertThrows("REQUIRED-FIELD-MISSING", "\"required\".*missing", loadyaml,
            my_make_yaml(base + {"components": {"parameters": p}}));
        p = base.components.parameters + {"a": {"name": "a", "in": "path", "schema": {"type": "string"}, "required": "a"}};
        assertThrows("INVALID-FIELD-TYPE", "required", loadyaml,
            my_make_yaml(base + {"components": {"parameters": p}}));

        # type checks
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": 5}}};
        assertThrows("INVALID-FIELD-TYPE", "\"type\"", loadyaml,
            my_make_yaml(base + {"components": {"parameters": p}}));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "a"}}};
        assertThrows("INVALID-FIELD-VALUE", loadyaml, my_make_yaml(base + {"components": {"parameters": p}}));

        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "array",
            "items": {"type": "string"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "boolean"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "integer"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "number"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "string"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "integer",
            "format": "unix-time"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));

        # format checks
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "string", "format": 5}}};
        assertThrows("INVALID-FIELD-TYPE", loadyaml, my_make_yaml(base + {"components": {"parameters": p}}));

        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "integer", "format": "int32"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "integer", "format": "int64"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "integer", "format": "a"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));

        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "number", "format": "double"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "number", "format": "float"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "number", "format": "a"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));

        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "string", "format": "binary"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "string", "format": "byte"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "string", "format": "date"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "string", "format": "date-time"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "string", "format": "password"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "string", "format": "a"}}};
        # issue 4203: ignore unknown string format
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));

        # allowEmptyValue checks
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "string"}, "allowEmptyValue": 5}};
        assertThrows("INVALID-FIELD-TYPE", "allowEmptyValue", loadyaml, my_make_yaml(base + {"components": {"parameters": p}}));

        # collectionFormat checks
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "style": "form", "explode": False,
            "schema": {"type": "array", "items": {"type": "string"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "style": "spaceDelimited",
            "schema": {"type": "array", "items": {"type": "string"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "style": "pipeDelimited",
            "schema": {"type": "array", "items": {"type": "string"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "style": "form",
            "schema": {"type": "array", "explode": True, "items": {"type": "string"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));

        p = base.components.parameters + {"a": {"name": "a", "in": "query", "style": 5,
            "schema": {"type": "array", "items": {"type": "string"}}}};
        assertThrows("INVALID-FIELD-TYPE", "style", loadyaml, my_make_yaml(base + {"components": {"parameters": p}}));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "style": "a",
            "schema": {"type": "array", "items": {"type": "string"}}}};
        assertThrows("INVALID-STYLE", loadyaml, my_make_yaml(base + {"components": {"parameters": p}}));
        p = base.components.parameters + {"a": {"name": "a", "in": "header", "style": "form",
            "schema": {"type": "array", "explode": True, "items": {"type": "string"}}}};
        assertThrows("INVALID-STYLE", loadyaml, my_make_yaml(base + {"components": {"parameters": p}}));

        # default checks

        p = base.components.parameters + {"a": {"name": "a", "in": "formData", "schema": {"type": "string"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));

        # TODO
        /*
        p = base.parameters + {"a": {"name": "a", "in": "query", "type": "array", "items": {"type": "string"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"parameters": p})));
        p = base.parameters + {"a": {"name": "a", "in": "query", "type": "array", "items": {"type": "string"}, "default": 5}};
        assertThrows("INVALID-FIELD-TYPE", "default", loadyaml, my_make_yaml(base + {"parameters": p}));
        */

        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "boolean", "default": "true"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "boolean", "default": 5}}};
        assertThrows("INVALID-FIELD-TYPE", "default", loadyaml, my_make_yaml(base + {"components": {"parameters": p}}));

        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "file"}}};
        assertThrows("INVALID-FIELD-VALUE", "invalid .* type", loadyaml, my_make_yaml(base + {"components": {"parameters": p}}));

        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "integer", "default": 5}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "integer", "default": "a"}}};
        assertThrows("INVALID-FIELD-TYPE", "default", loadyaml, my_make_yaml(base + {"components": {"parameters": p}}));

        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "number", "default": 2.0}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "number", "default": "a"}}};
        assertThrows("INVALID-FIELD-TYPE", "default", loadyaml, my_make_yaml(base + {"components": {"parameters": p}}));

        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "string", "default": "a"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "string", "default": 5}}};
        assertThrows("INVALID-FIELD-TYPE", "default", loadyaml, my_make_yaml(base + {"components": {"parameters": p}}));
    }

    testItemsObject() {
        checkModules();

        # OpenAPI 3.0 base schema without parameter references in paths
        hash base = {
            "openapi": "3.0",
            "info": ValidInfoObject,
            "paths": {},
        };
        # OpenAPI 3.0 style: schema with type array
        hash schemaBase = {"type": "array"};
        hash p;

        # type checks - items with empty object defaults to type "object"
        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        # items with invalid type (integer instead of string)
        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": 5}}}};
        assertThrows("INVALID-FIELD-TYPE", "\"type\"", loadyaml, my_make_yaml(base + {"components": {"parameters": p}}));
        # items with invalid type value
        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "a"}}}};
        assertThrows("INVALID-FIELD-VALUE", loadyaml, my_make_yaml(base + {"components": {"parameters": p}}));

        # valid item types
        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "boolean"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "integer"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "number"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "string"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));

        # format checks
        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "string", "format": 5}}}};
        assertThrows("INVALID-FIELD-TYPE", loadyaml, my_make_yaml(base + {"components": {"parameters": p}}));

        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "integer", "format": "int32"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "integer", "format": "int64"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "integer", "format": "a"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));

        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "number", "format": "double"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "number", "format": "float"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "number", "format": "a"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));

        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "string", "format": "binary"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "string", "format": "byte"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "string", "format": "date"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "string", "format": "date-time"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "string", "format": "password"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "string", "format": "a"}}}};
        # issue 4203: ignore unknown string format
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));

        # default checks
        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "boolean", "default": True}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "boolean", "default": 5}}}};
        assertThrows("INVALID-FIELD-TYPE", "default", loadyaml, my_make_yaml(base + {"components": {"parameters": p}}));

        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "integer", "default": 5}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "integer", "default": "a"}}}};
        assertThrows("INVALID-FIELD-TYPE", "default", loadyaml, my_make_yaml(base + {"components": {"parameters": p}}));

        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "number", "default": 2.0}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "number", "default": "a"}}}};
        assertThrows("INVALID-FIELD-TYPE", "default", loadyaml, my_make_yaml(base + {"components": {"parameters": p}}));

        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "string", "default": "a"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "string", "default": 5}}}};
        assertThrows("INVALID-FIELD-TYPE", "default", loadyaml, my_make_yaml(base + {"components": {"parameters": p}}));
    }

    testResponsesObject() {
        checkModules();

        hash base = ValidOpenApi3Schema;
        hash p;

        p = {"get": {"responses": {"200": {"description": "a"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"paths": {"/a": p}})));
        p = {"get": {"responses": {"default": {"description": "a"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"paths": {"/a": p}})));

        p = {"get": {"responses": {"200": 5}}};
        assertThrows("INVALID-FIELD-TYPE", "response.*invalid type", loadyaml, my_make_yaml(base + {"paths": {"/a": p}}));
        p = {"get": {"responses": {"default": 5}}};
        assertThrows("INVALID-FIELD-TYPE", "default.*invalid type", loadyaml, my_make_yaml(base + {"paths": {"/a": p}}));
    }

    testResponseObject() {
        checkModules();

        # OpenAPI 3.0 base schema without parameter references
        hash base = {
            "openapi": "3.0",
            "info": ValidInfoObject,
            "paths": {},
        };
        hash r;

        # Test responses in components.responses
        r = {"a": {}};
        assertThrows("REQUIRED-FIELD-MISSING", "\"description\".*missing", loadyaml, my_make_yaml(base + {"components": {"responses": r}}));
        r = {"a": {"description": "a"}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));
        r = {"a": {"description": 5}};
        assertThrows("INVALID-FIELD-TYPE", "description", loadyaml, my_make_yaml(base + {"components": {"responses": r}}));

        r = {"a": {"description": "a", "schema": 5}};
        assertThrows("INVALID-FIELD-TYPE", "schema", loadyaml, my_make_yaml(base + {"components": {"responses": r}}));
        r = {"a": {"description": "a", "headers": 5}};
        assertThrows("INVALID-FIELD-TYPE", "headers", loadyaml, my_make_yaml(base + {"components": {"responses": r}}));
        r = {"a": {"description": "a", "examples": 5}};
        assertThrows("INVALID-FIELD-TYPE", "examples", loadyaml, my_make_yaml(base + {"components": {"responses": r}}));

        # Test OpenAPI 3.0 content-style response with empty schema object {} (means "any type")
        # This tests the fix for handling falsy but valid empty schema objects
        {
            hash<auto> spec = {
                "openapi": "3.0.0",
                "info": {"title": "Empty Schema Test", "version": "1.0"},
                "paths": {
                    "/test": {
                        "get": {
                            "operationId": "testEmptySchema",
                            "responses": {
                                "200": {
                                    "description": "Success with any response body",
                                    "content": {
                                        "application/json": {
                                            "schema": {},  # Empty schema means "any type"
                                        },
                                    },
                                },
                            },
                        },
                    },
                },
            };
            OpenApi3Schema so("", spec);

            # Verify the response was parsed correctly
            OpenApi3::PathItemObject pio = so.paths.match("/test");
            OpenApi3::OperationObject op = pio.getOperation("get", "/test");
            assertTrue(exists op.responses);

            # Get the 200 response and verify schema exists (even though empty)
            *OpenApi3::ResponseObject resp = op.responses.responses."200";
            assertTrue(exists resp);
            # The schema should exist because we used "exists" check
            assertTrue(exists resp.schema);
        }

        # Test that response without schema in content works (no schema key at all)
        {
            hash<auto> spec = {
                "openapi": "3.0.0",
                "info": {"title": "No Schema Test", "version": "1.0"},
                "paths": {
                    "/test": {
                        "get": {
                            "operationId": "testNoSchema",
                            "responses": {
                                "204": {
                                    "description": "No content response",
                                    "content": {
                                        "application/json": {},  # No schema key
                                    },
                                },
                            },
                        },
                    },
                },
            };
            OpenApi3Schema so("", spec);

            OpenApi3::PathItemObject pio = so.paths.match("/test");
            OpenApi3::OperationObject op = pio.getOperation("get", "/test");
            *OpenApi3::ResponseObject resp = op.responses.responses."204";
            assertTrue(exists resp);
            # Schema should NOT exist when the schema key is completely absent
            assertFalse(exists resp.schema);
        }

        # Negative test: schema with invalid type should still throw error
        {
            hash<auto> spec = {
                "openapi": "3.0.0",
                "info": {"title": "Invalid Schema Test", "version": "1.0"},
                "paths": {
                    "/test": {
                        "get": {
                            "operationId": "testInvalidSchema",
                            "responses": {
                                "200": {
                                    "description": "Response with invalid schema type",
                                    "content": {
                                        "application/json": {
                                            "schema": {"type": "invalid_type"},
                                        },
                                    },
                                },
                            },
                        },
                    },
                },
            };
            assertThrows("INVALID-FIELD-VALUE", "invalid_type",
                sub () { new OpenApi3Schema("", spec); });
        }
    }

    testHeaderObject() {
        checkModules();

        hash base = {"openapi": "3.0", "info": ValidInfoObject, "paths": {}};
        hash r;

        # Empty headers object should be valid
        r = {"a": {"description": "a", "headers": {}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));

        # Headers in OpenAPI 3.0 require either schema or content
        r = {"a": {"description": "a", "headers": {"a": {}}}};
        assertThrows("INVALID-PARAMETER", "schema.*content", loadyaml, my_make_yaml(base + {"components": {"responses": r}}));

        # type checks - using schema object
        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "boolean"}}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));
        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "integer"}}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));
        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "number"}}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));
        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "string"}}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));
        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "array", "items": {"type": "string"}}}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));

        # invalid schema type
        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": 5}}}}};
        assertThrows("INVALID-FIELD-TYPE", "type", loadyaml, my_make_yaml(base + {"components": {"responses": r}}));
        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "invalid"}}}}};
        assertThrows("INVALID-FIELD-VALUE", loadyaml, my_make_yaml(base + {"components": {"responses": r}}));

        # invalid items
        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "array", "items": 5}}}}};
        assertThrows("INVALID-FIELD-TYPE", "items", loadyaml, my_make_yaml(base + {"components": {"responses": r}}));

        # format checks
        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "string", "format": 5}}}}};
        assertThrows("INVALID-FIELD-TYPE", loadyaml, my_make_yaml(base + {"components": {"responses": r}}));

        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "integer", "format": "int32"}}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));
        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "integer", "format": "int64"}}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));
        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "integer", "format": "a"}}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));

        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "number", "format": "double"}}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));
        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "number", "format": "float"}}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));
        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "number", "format": "a"}}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));

        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "string", "format": "binary"}}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));
        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "string", "format": "byte"}}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));
        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "string", "format": "date"}}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));
        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "string", "format": "date-time"}}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));
        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "string", "format": "password"}}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));
        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "string", "format": "a"}}}}};
        # issue 4203: ignore unknown string format
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));

        # style checks (replaces collectionFormat in OpenAPI 3.0)
        r = {"a": {"description": "a", "headers": {"a": {"style": "simple", "schema": {"type": "array", "items": {"type": "string"}}}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));

        r = {"a": {"description": "a", "headers": {"a": {"style": 5, "schema": {"type": "array", "items": {"type": "string"}}}}}};
        assertThrows("INVALID-FIELD-TYPE", "style", loadyaml, my_make_yaml(base + {"components": {"responses": r}}));

        # default checks - defaults go in schema object in OpenAPI 3.0
        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "boolean", "default": True}}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));
        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "boolean", "default": 5}}}}};
        assertThrows("INVALID-FIELD-TYPE", "default", loadyaml, my_make_yaml(base + {"components": {"responses": r}}));

        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "integer", "default": 5}}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));
        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "integer", "default": "a"}}}}};
        assertThrows("INVALID-FIELD-TYPE", "default", loadyaml, my_make_yaml(base + {"components": {"responses": r}}));

        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "number", "default": 2.0}}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));
        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "number", "default": "a"}}}}};
        assertThrows("INVALID-FIELD-TYPE", "default", loadyaml, my_make_yaml(base + {"components": {"responses": r}}));

        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "string", "default": "a"}}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));
        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "string", "default": 5}}}}};
        assertThrows("INVALID-FIELD-TYPE", "default", loadyaml, my_make_yaml(base + {"components": {"responses": r}}));
    }

    testTagObject() {
        checkModules();

        hash base = ValidOpenApi3Schema;
        hash tag;

        tag = {"name": "a"};
        assertTrue(loadyaml(my_make_yaml(base + {"tags": (tag,)})));
        tag = {};
        assertThrows("REQUIRED-FIELD-MISSING", "\"name\".*missing", loadyaml, my_make_yaml(base + {"tags": (tag,)}));
        tag = {"name": 5};
        assertThrows("INVALID-FIELD-TYPE", "name", loadyaml, my_make_yaml(base + {"tags": (tag,)}));

        tag = {"name": "a", "description": "a"};
        assertTrue(loadyaml(my_make_yaml(base + {"tags": (tag,)})));
        tag = {"name": "a", "description": 5};
        assertThrows("INVALID-FIELD-TYPE", "description", loadyaml, my_make_yaml(base + {"tags": (tag,)}));

        tag = {"name": "a", "externalDocs": 5};
        assertThrows("INVALID-FIELD-TYPE", "externalDocs", loadyaml, my_make_yaml(base + {"tags": (tag,)}));
    }

    testSemanticStringFormats() {
        checkModules();

        OpenApi3Schema schema("", {"openapi": "3.0", "info": ValidInfoObject, "paths": {}});
        foreach string fmt in (("email", "uri", "uuid", "hostname", "ipv4", "ipv6", "phone")) {
            auto t = schema.getType("p", "string", fmt);
            assertEq(fmt, t.getName(), sprintf("string/%s maps to the %y type", fmt, fmt));
            assertEq("string", t.getBaseTypeName(), fmt + " is string-backed");
        }
        # an unrecognized format still maps to a plain string type
        assertEq("softstring", schema.getType("p", "string").getName(), "no format maps to a string type");
    }

    testSchemaObject() {
        checkModules();

        hash base = {"openapi": "3.0", "info": ValidInfoObject, "paths": {}};
        hash s;

        # ref checks
        s = {"$ref": "#/components/schemas/x"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"x": ("type": "string"), "a": s}}})));
        s = {"$ref": 5};
        assertThrows("INVALID-FIELD-TYPE", "ref.*invalid type", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        s = {"$ref": "#/components/schemas/y"};
        assertThrows("INVALID-REFERENCE", "cannot resolve", loadyaml, my_make_yaml(base + {"components": {"schemas": {"x": ("type": "string"), "a": s}}}));
        # issue #3843: sibling elements to a $ref must be ignored
        s = {"$ref": "#/components/schemas/x", "a": 1};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"x": ("type": "string"), "a": s}}})));

        # type checks
        s = {};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": 5};
        assertThrows("INVALID-FIELD-TYPE", "\"type\"", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"type": "a"};
        assertThrows("INVALID-FIELD-VALUE", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        # TODO array of array
        /*p = base.parameters + {"a": {"name":"a", "in": "query", "type": "array", "items": {"type": "string"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));*/
        s = {"type": "boolean"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "integer"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "number"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));

        # format checks
        s = {"type": "string", "format": 5};
        assertThrows("INVALID-FIELD-TYPE", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        s = {"type": "integer", "format": "int32"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "integer", "format": "int64"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "integer", "format": "a"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));

        s = {"type": "number", "format": "double"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "number", "format": "float"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "number", "format": "a"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));

        s = {"type": "string", "format": "binary"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "format": "byte"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "format": "date"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "format": "date-time"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "format": "password"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "format": "a"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));

        # title checks
        s = {"type": "string", "title": "a"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "title": 5};
        assertThrows("INVALID-FIELD-TYPE", "title", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        # description checks
        s = {"type": "string", "description": "a"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "description": 5};
        assertThrows("INVALID-FIELD-TYPE", "description", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        # items checks

        # default checks
        # TODO arrays
        /*p = {"type": "array", "items": {"type": "string"}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        p = {"type": "array", "items": {"type": "string"}, "default": 5};
        assertThrows("INVALID-FIELD-TYPE", "default", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));*/

        s = {"type": "boolean", "default": True};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "boolean", "default": 5};
        assertThrows("INVALID-FIELD-TYPE", "default", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        # TODO files
        /*p = {"type": "file"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        p = {"type": "file"};
        assertThrows("INVALID-FIELD-TYPE", "default", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));*/

        s = {"type": "integer", "default": 5};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "integer", "default": "a"};
        assertThrows("INVALID-FIELD-TYPE", "default", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        s = {"type": "number", "default": 2.0};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "number", "default": "a"};
        assertThrows("INVALID-FIELD-TYPE", "default", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        s = {"type": "string", "default": "a"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "default": 5};
        assertThrows("INVALID-FIELD-TYPE", "default", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        # maxProperties checks
        s = {"type": "object", "maxProperties": 0};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "object", "maxProperties": 5};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "object", "maxProperties": -2};
        assertThrows("INVALID-FIELD-FORMAT", "maxProperties", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"type": "object", "maxProperties": "a"};
        assertThrows("INVALID-FIELD-TYPE", "maxProperties", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        s = {"type": "string", "maxProperties": 0};
        assertThrows("INVALID-FIELD-FORMAT", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"type": "string", "maxProperties": 5};
        assertThrows("INVALID-FIELD-FORMAT", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"type": "string", "maxProperties": -2};
        assertThrows("INVALID-FIELD-FORMAT", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"type": "string", "maxProperties": "a"};
        assertThrows("INVALID-FIELD-TYPE", "maxProperties", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        # minProperties checks
        s = {"type": "object", "minProperties": 0};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "object", "minProperties": 5};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "object", "minProperties": -2};
        assertThrows("INVALID-FIELD-FORMAT", "minProperties", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"type": "object", "minProperties": "a"};
        assertThrows("INVALID-FIELD-TYPE", "minProperties", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        s = {"type": "string", "minProperties": 0};
        assertThrows("INVALID-FIELD-FORMAT", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"type": "string", "minProperties": 5};
        assertThrows("INVALID-FIELD-FORMAT", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"type": "string", "minProperties": -2};
        assertThrows("INVALID-FIELD-FORMAT", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"type": "string", "minProperties": "a"};
        assertThrows("INVALID-FIELD-TYPE", "minProperties", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        # properties checks
        s = {"type": "object", "properties": {}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "object", "properties": {"a": {"type": "string"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "object", "properties": {"a": 5}};
        assertThrows("INVALID-FIELD-FORMAT", "properties", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"type": "object", "properties": 5};
        assertThrows("INVALID-FIELD-TYPE", "properties", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        s = {"type": "string", "properties": {}};
        assertThrows("INVALID-FIELD-FORMAT", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"type": "string", "properties": {"a": {"type": "string"}}};
        assertThrows("INVALID-FIELD-FORMAT", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"type": "string", "properties": {"a": 5}};
        assertThrows("INVALID-FIELD-FORMAT", "properties", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"type": "string", "properties": 5};
        assertThrows("INVALID-FIELD-TYPE", "properties", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        # additionalProperties checks
        s = {"type": "object", "additionalProperties": True};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "object", "additionalProperties": {"type": "string"}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "object", "additionalProperties": "a"};
        assertThrows("INVALID-FIELD-TYPE", "additionalProperties", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        s = {"type": "string", "additionalProperties": True};
        assertThrows("INVALID-FIELD-FORMAT", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"type": "string", "additionalProperties": {"type": "string"}};
        assertThrows("INVALID-FIELD-FORMAT", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"type": "string", "additionalProperties": "a"};
        assertThrows("INVALID-FIELD-TYPE", "additionalProperties", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        # "required" checks
        s = {"type": "object", "properties": {"a": {"type": "string"}}, "required": ("a",)};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "required": ()};
        assertThrows("INVALID-FIELD-FORMAT", "required", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"type": "string", "required": (5, 3)};
        assertThrows("INVALID-FIELD-TYPE", "required", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"type": "string", "required": 5};
        assertThrows("INVALID-FIELD-TYPE", "required", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        # discriminator checks
        s = {"type": "object", "properties": {"a": {"type": "string"}, "b": {}}, "discriminator": "a", "required": ("a", "b")};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "object", "properties": {"a": {"type": "string"}, "b": {}}, "discriminator": "x", "required": ("a", "b")};
        assertThrows("INVALID-FIELD-VALUE", "discriminator", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"type": "string", "discriminator": 5};
        assertThrows("INVALID-FIELD-TYPE", "discriminator", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        # readOnly checks
        s = {"type": "string", "readOnly": False};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "readOnly": True};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "readOnly": 5};
        assertThrows("INVALID-FIELD-TYPE", "readOnly", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        # allOf Checks
        s = {"type": "string", "allOf": ({"$ref": "#/components/schemas/x"}, {"type": "string"})};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"x": ("type": "string"), "a": s}}})));
        s = {"type": "string", "allOf": list()};
        assertThrows("INVALID-FIELD-FORMAT", "allOf", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"type": "string", "allOf": (5, 3)};
        assertThrows("INVALID-FIELD-TYPE", "allOf", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"type": "string", "allOf": 5};
        assertThrows("INVALID-FIELD-TYPE", "allOf", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        # oneOf Checks
        s = {"oneOf": ({"type": "string"}, {"type": "integer"})};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"oneOf": ({"$ref": "#/components/schemas/x"}, {"type": "integer"})};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"x": ("type": "string"), "a": s}}})));
        s = {"oneOf": list()};
        assertThrows("INVALID-FIELD-FORMAT", "oneOf", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"oneOf": (5, 3)};
        assertThrows("INVALID-FIELD-TYPE", "oneOf", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"oneOf": 5};
        assertThrows("INVALID-FIELD-TYPE", "oneOf", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        # anyOf Checks
        s = {"anyOf": ({"type": "string"}, {"type": "integer"})};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"anyOf": ({"$ref": "#/components/schemas/x"}, {"type": "integer"})};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"x": ("type": "string"), "a": s}}})));
        s = {"anyOf": list()};
        assertThrows("INVALID-FIELD-FORMAT", "anyOf", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"anyOf": (5, 3)};
        assertThrows("INVALID-FIELD-TYPE", "anyOf", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"anyOf": 5};
        assertThrows("INVALID-FIELD-TYPE", "anyOf", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        # not Checks
        s = {"not": {"type": "string"}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"not": {"$ref": "#/components/schemas/x"}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"x": ("type": "string"), "a": s}}})));
        s = {"not": 5};
        assertThrows("INVALID-FIELD-TYPE", "not", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        # writeOnly checks
        s = {"type": "string", "writeOnly": False};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "writeOnly": True};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "writeOnly": 5};
        assertThrows("INVALID-FIELD-TYPE", "writeOnly", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        # deprecated checks (stored as deprec since deprecated is a Qore keyword)
        s = {"type": "string", "deprecated": False};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "deprecated": True};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "deprecated": 5};
        assertThrows("INVALID-FIELD-TYPE", "deprecated", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        # xml checks
        s = {"type": "string", "xml": {"name": "a"}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "xml": 5};
        assertThrows("INVALID-FIELD-TYPE", "xml", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        # externalDocs checks
        s = {"type": "string", "externalDocs": {"url": "a"}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "externalDocs": 5};
        assertThrows("INVALID-FIELD-TYPE", "externalDocs", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
    }

    testSchemaCompositionValidation() {
        checkModules();

        hash hdr = {"content-type": MimeTypeJson};

        # Test allOf - value must match all schemas
        {
            hash spec = {
                "openapi": "3.0.0",
                "info": {"title": "AllOf Test", "version": "1.0"},
                "paths": {
                    "/test": {
                        "post": {
                            "operationId": "testAllOf",
                            "requestBody": {
                                "required": True,
                                "content": {
                                    "application/json": {
                                        "schema": {
                                            "allOf": (
                                                {
                                                    "type": "object",
                                                    "properties": {"name": {"type": "string"}},
                                                    "required": ("name",),
                                                },
                                                {
                                                    "type": "object",
                                                    "properties": {"age": {"type": "integer"}},
                                                    "required": ("age",),
                                                },
                                            ),
                                        },
                                    },
                                },
                            },
                            "responses": {"200": {"description": "Success"}},
                        },
                    },
                },
            };
            OpenApi3Schema so("", spec);

            # Valid: has both required properties from both schemas
            hash body = {"name": "John", "age": 30};
            hash<RestRequestClientInfo> req = so.processRequest("POST", "/test", body, hdr);
            assertEq("/test", req.uri_path);

            # Invalid: missing age (required by second schema)
            body = {"name": "John"};
            assertThrows("SCHEMA-VALIDATION-ERROR", "missing.*age", \so.processRequest(), ("POST", "/test", body, hdr));

            # Invalid: missing name (required by first schema)
            body = {"age": 30};
            assertThrows("SCHEMA-VALIDATION-ERROR", "missing.*name", \so.processRequest(), ("POST", "/test", body, hdr));
        }

        # Test oneOf - value must match exactly one schema
        {
            hash spec = {
                "openapi": "3.0.0",
                "info": {"title": "OneOf Test", "version": "1.0"},
                "paths": {
                    "/test": {
                        "post": {
                            "operationId": "testOneOf",
                            "requestBody": {
                                "required": True,
                                "content": {
                                    "application/json": {
                                        "schema": {
                                            "oneOf": (
                                                {
                                                    "type": "object",
                                                    "properties": {
                                                        "petType": {"type": "string"},
                                                        "bark": {"type": "boolean"},
                                                    },
                                                    "required": ("petType", "bark"),
                                                },
                                                {
                                                    "type": "object",
                                                    "properties": {
                                                        "petType": {"type": "string"},
                                                        "meow": {"type": "boolean"},
                                                    },
                                                    "required": ("petType", "meow"),
                                                },
                                            ),
                                        },
                                    },
                                },
                            },
                            "responses": {"200": {"description": "Success"}},
                        },
                    },
                },
            };
            OpenApi3Schema so("", spec);

            # Valid: matches first schema (dog)
            hash body = {"petType": "dog", "bark": True};
            hash<RestRequestClientInfo> req = so.processRequest("POST", "/test", body, hdr);
            assertEq("/test", req.uri_path);

            # Valid: matches second schema (cat)
            body = {"petType": "cat", "meow": True};
            req = so.processRequest("POST", "/test", body, hdr);
            assertEq("/test", req.uri_path);

            # Invalid: matches neither schema (missing required fields)
            body = {"petType": "bird"};
            assertThrows("SCHEMA-VALIDATION-ERROR", "does not match any.*oneOf", \so.processRequest(),
                ("POST", "/test", body, hdr));

            # Invalid: matches both schemas
            body = {"petType": "hybrid", "bark": True, "meow": True};
            assertThrows("SCHEMA-VALIDATION-ERROR", "matches multiple oneOf", \so.processRequest(),
                ("POST", "/test", body, hdr));
        }

        # Test anyOf - value must match at least one schema
        {
            hash spec = {
                "openapi": "3.0.0",
                "info": {"title": "AnyOf Test", "version": "1.0"},
                "paths": {
                    "/test": {
                        "post": {
                            "operationId": "testAnyOf",
                            "requestBody": {
                                "required": True,
                                "content": {
                                    "application/json": {
                                        "schema": {
                                            "anyOf": (
                                                {
                                                    "type": "object",
                                                    "properties": {"name": {"type": "string"}},
                                                    "required": ("name",),
                                                },
                                                {
                                                    "type": "object",
                                                    "properties": {"id": {"type": "integer"}},
                                                    "required": ("id",),
                                                },
                                            ),
                                        },
                                    },
                                },
                            },
                            "responses": {"200": {"description": "Success"}},
                        },
                    },
                },
            };
            OpenApi3Schema so("", spec);

            # Valid: matches first schema
            hash body = {"name": "John"};
            hash<RestRequestClientInfo> req = so.processRequest("POST", "/test", body, hdr);
            assertEq("/test", req.uri_path);

            # Valid: matches second schema
            body = {"id": 123};
            req = so.processRequest("POST", "/test", body, hdr);
            assertEq("/test", req.uri_path);

            # Valid: matches both schemas (allowed for anyOf)
            body = {"name": "John", "id": 123};
            req = so.processRequest("POST", "/test", body, hdr);
            assertEq("/test", req.uri_path);

            # Invalid: matches neither schema
            body = {"other": "value"};
            assertThrows("SCHEMA-VALIDATION-ERROR", "does not match any.*anyOf", \so.processRequest(),
                ("POST", "/test", body, hdr));
        }

        # Test not - value must NOT match the schema
        {
            hash spec = {
                "openapi": "3.0.0",
                "info": {"title": "Not Test", "version": "1.0"},
                "paths": {
                    "/test": {
                        "post": {
                            "operationId": "testNot",
                            "requestBody": {
                                "required": True,
                                "content": {
                                    "application/json": {
                                        "schema": {
                                            "type": "object",
                                            "properties": {"value": {"type": "string"}},
                                            "not": {
                                                "type": "object",
                                                "properties": {"forbidden": {"type": "string"}},
                                                "required": ("forbidden",),
                                            },
                                        },
                                    },
                                },
                            },
                            "responses": {"200": {"description": "Success"}},
                        },
                    },
                },
            };
            OpenApi3Schema so("", spec);

            # Valid: does not have forbidden property
            hash body = {"value": "allowed"};
            hash<RestRequestClientInfo> req = so.processRequest("POST", "/test", body, hdr);
            assertEq("/test", req.uri_path);

            # Invalid: has the forbidden property
            body = {"value": "allowed", "forbidden": "not allowed"};
            assertThrows("SCHEMA-VALIDATION-ERROR", "must not match.*'not' schema", \so.processRequest(),
                ("POST", "/test", body, hdr));
        }

        # Test readOnly - property cannot be in request
        {
            hash spec = {
                "openapi": "3.0.0",
                "info": {"title": "ReadOnly Test", "version": "1.0"},
                "paths": {
                    "/test": {
                        "post": {
                            "operationId": "testReadOnly",
                            "requestBody": {
                                "required": True,
                                "content": {
                                    "application/json": {
                                        "schema": {
                                            "type": "object",
                                            "properties": {
                                                "id": {"type": "integer", "readOnly": True},
                                                "name": {"type": "string"},
                                            },
                                        },
                                    },
                                },
                            },
                            "responses": {"200": {"description": "Success"}},
                        },
                    },
                },
            };
            OpenApi3Schema so("", spec);

            # Valid: no readOnly field in request
            hash body = {"name": "John"};
            hash<RestRequestClientInfo> req = so.processRequest("POST", "/test", body, hdr);
            assertEq("/test", req.uri_path);

            # Invalid: readOnly field in request
            body = {"id": 123, "name": "John"};
            assertThrows("SCHEMA-VALIDATION-ERROR", "read-only", \so.processRequest(), ("POST", "/test", body, hdr));
        }

        # Test writeOnly - property cannot be in response
        {
            hash spec = {
                "openapi": "3.0.0",
                "info": {"title": "WriteOnly Test", "version": "1.0"},
                "paths": {
                    "/test": {
                        "post": {
                            "operationId": "testWriteOnly",
                            "requestBody": {
                                "required": True,
                                "content": {
                                    "application/json": {
                                        "schema": {
                                            "type": "object",
                                            "properties": {
                                                "password": {"type": "string", "writeOnly": True},
                                                "username": {"type": "string"},
                                            },
                                        },
                                    },
                                },
                            },
                            "responses": {
                                "200": {
                                    "description": "Success",
                                    "content": {
                                        "application/json": {
                                            "schema": {
                                                "type": "object",
                                                "properties": {
                                                    "password": {"type": "string", "writeOnly": True},
                                                    "username": {"type": "string"},
                                                },
                                            },
                                        },
                                    },
                                },
                            },
                        },
                    },
                },
            };
            OpenApi3Schema so("", spec);

            # Valid: writeOnly field in request is allowed
            hash body = {"password": "secret", "username": "john"};
            hash<RestRequestClientInfo> req = so.processRequest("POST", "/test", body, hdr);
            assertEq("/test", req.uri_path);

            # Test response validation - writeOnly field should not be in response
            hash resp_body = {"password": "exposed", "username": "john"};
            assertThrows("SCHEMA-VALIDATION-ERROR", "write-only", \so.processResponse(), ("POST", "/test", 200,
                resp_body, hdr));

            # Valid response without writeOnly field
            resp_body = {"username": "john"};
            hash<HttpResponseInfo> res = so.processResponse("POST", "/test", 200, resp_body, hdr);
            assertEq(200, res.code);
        }
    }

    testXmlObject() {
        checkModules();

        hash base = {"openapi": "3.0", "info": ValidInfoObject, "paths": {}};
        hash s;

        s = {"type": "string", "xml": {}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));

        # name checks
        s = {"type": "string", "xml": {"name": "a"}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "xml": {"name": 5}};
        assertThrows("INVALID-FIELD-TYPE", "name", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        # namespace checks
        s = {"type": "string", "xml": {"namespace": "a"}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "xml": {"namespace": 5}};
        assertThrows("INVALID-FIELD-TYPE", "namespace", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        # prefix checks
        s = {"type": "string", "xml": {"prefix": "a"}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "xml": {"prefix": 5}};
        assertThrows("INVALID-FIELD-TYPE", "prefix", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        # attribute checks
        s = {"type": "string", "xml": {"attribute": False}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "xml": {"attribute": True}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "xml": {"attribute": 5}};
        assertThrows("INVALID-FIELD-TYPE", "attribute", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        # wrapped checks
        s = {"type": "string", "xml": {"wrapped": False}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "xml": {"wrapped": True}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "xml": {"wrapped": 5}};
        assertThrows("INVALID-FIELD-TYPE", "wrapped", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
    }

    testSecuritySchemeObject() {
        checkModules();

        hash base = {"openapi": "3.0", "info": ValidInfoObject, "paths": {}};
        hash sd;

        # type checks
        sd = {"type": "http", "scheme": "basic"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}})));
        sd = {"type": "a"};
        assertThrows("INVALID-SCHEME-TYPE", loadyaml, my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}}));
        sd = {"type": 5};
        assertThrows("INVALID-FIELD-TYPE", "\"type\"", loadyaml, my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}}));

        # description checks
        sd = {"type": "http", "scheme": "basic", "description": "a"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}})));
        sd = {"type": "http", "scheme": "basic", "description": 5};
        assertThrows("INVALID-FIELD-TYPE", "description", loadyaml, my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}}));

        # type=apiKey checks
        sd = {"type": "apiKey"};
        assertThrows("REQUIRED-FIELD-MISSING", loadyaml, my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}}));
        sd = {"type": "apiKey", "name": "a"};
        assertThrows("REQUIRED-FIELD-MISSING", "\"in\".*missing", loadyaml, my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}}));
        sd = {"type": "apiKey", "in": "query"};
        assertThrows("REQUIRED-FIELD-MISSING", "\"name\".*missing", loadyaml, my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}}));
        sd = {"type": "apiKey", "name": "a", "in": "query"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}})));
        sd = {"type": "apiKey", "name": "a", "in": "header"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}})));
        sd = {"type": "apiKey", "name": "a", "in": "a"};
        assertThrows("INVALID-APIKEY-LOCATION", loadyaml, my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}}));
        sd = {"type": "apiKey", "name": 5, "in": "query"};
        assertThrows("INVALID-FIELD-TYPE", "name", loadyaml, my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}}));
        sd = {"type": "apiKey", "name": "a", "in": 5};
        assertThrows("INVALID-FIELD-TYPE", "in", loadyaml, my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}}));

        # type=oauth2 checks - requires 'flows' field
        sd = {"type": "oauth2"};
        assertThrows("REQUIRED-FIELD-MISSING", "\"flows\".*missing", loadyaml, my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}}));
        sd = {"type": "oauth2", "flows": 5};
        assertThrows("INVALID-FIELD-TYPE", "flows", loadyaml, my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}}));

        # oauth2 implicit flow
        sd = {"type": "oauth2", "flows": {"implicit": {"authorizationUrl": "https://example.com/auth", "scopes": {"read": "Read access"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}})));
        sd = {"type": "oauth2", "flows": {"implicit": {"scopes": {}}}};
        assertThrows("REQUIRED-FIELD-MISSING", "\"authorizationUrl\".*missing", loadyaml, my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}}));
        sd = {"type": "oauth2", "flows": {"implicit": {"authorizationUrl": 5, "scopes": {}}}};
        assertThrows("INVALID-FIELD-TYPE", "authorizationUrl", loadyaml, my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}}));

        # oauth2 password flow
        sd = {"type": "oauth2", "flows": {"password": {"tokenUrl": "https://example.com/token", "scopes": {}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}})));
        sd = {"type": "oauth2", "flows": {"password": {"scopes": {}}}};
        assertThrows("REQUIRED-FIELD-MISSING", "\"tokenUrl\".*missing", loadyaml, my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}}));
        sd = {"type": "oauth2", "flows": {"password": {"tokenUrl": 5, "scopes": {}}}};
        assertThrows("INVALID-FIELD-TYPE", "tokenUrl", loadyaml, my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}}));

        # oauth2 clientCredentials flow
        sd = {"type": "oauth2", "flows": {"clientCredentials": {"tokenUrl": "https://example.com/token", "scopes": {}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}})));
        sd = {"type": "oauth2", "flows": {"clientCredentials": {"scopes": {}}}};
        assertThrows("REQUIRED-FIELD-MISSING", "\"tokenUrl\".*missing", loadyaml, my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}}));

        # oauth2 authorizationCode flow
        sd = {"type": "oauth2", "flows": {"authorizationCode": {"authorizationUrl": "https://example.com/auth", "tokenUrl": "https://example.com/token", "scopes": {}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}})));
        sd = {"type": "oauth2", "flows": {"authorizationCode": {"tokenUrl": "https://example.com/token", "scopes": {}}}};
        assertThrows("REQUIRED-FIELD-MISSING", "\"authorizationUrl\".*missing", loadyaml, my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}}));
        sd = {"type": "oauth2", "flows": {"authorizationCode": {"authorizationUrl": "https://example.com/auth", "scopes": {}}}};
        assertThrows("REQUIRED-FIELD-MISSING", "\"tokenUrl\".*missing", loadyaml, my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}}));

        # type=http checks
        sd = {"type": "http", "scheme": "bearer"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}})));
        sd = {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}})));
        sd = {"type": "http"};
        assertThrows("REQUIRED-FIELD-MISSING", "\"scheme\".*missing", loadyaml, my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}}));

        # type=openIdConnect checks
        sd = {"type": "openIdConnect", "openIdConnectUrl": "https://example.com/.well-known/openid-configuration"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}})));
        sd = {"type": "openIdConnect"};
        assertThrows("REQUIRED-FIELD-MISSING", "\"openIdConnectUrl\".*missing", loadyaml, my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}}));
    }

    testScopesObject() {
        checkModules();

        hash base = {"openapi": "3.0", "info": ValidInfoObject, "paths": {}};
        hash sd;

        # Test scopes in OAuth2 flows
        sd = {"type": "oauth2", "flows": {"password": {"tokenUrl": "https://example.com/token", "scopes": {}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}})));
        sd = {"type": "oauth2", "flows": {"password": {"tokenUrl": "https://example.com/token", "scopes": {"read": "Read access"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}})));
        sd = {"type": "oauth2", "flows": {"password": {"tokenUrl": "https://example.com/token", "scopes": {"a": 5}}}};
        assertThrows("INVALID-FIELD-TYPE", loadyaml, my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}}));
    }

    testValidation() {
        checkModules();

        testValidation(OpenApi3::OpenApi3Loader::fromFile(get_script_dir() + DirSep + "PetStore.openapi3.yaml"));
        testValidation(OpenApi3::OpenApi3Loader::fromFile(get_script_dir() + DirSep + "PetStore.openapi3.json"));

        {
            hash b = ValidOpenApi3Schema;
            b.components.schemas.a = {
                "type": "object",
                "properties": {
                    "a": {
                        "type": "string",
                        "readOnly": True,
                    },
                },
            };
            b.components.parameters.a = b.components.parameters.a + (
                "in": "body",
                "name": "body",
                "required": True,
                "schema": (
                    "$ref": "#/components/schemas/a",
                ),
            );
            b.paths."/api/smtg" += (
                "post": (
                    "parameters": ((
                        "$ref": "#/components/parameters/a",
                    ),),
                    "responses": (
                        "200": (
                            "description": "success",
                        ),
                        "409": (
                            "description": "error",
                            "schema": (
                                "type": "string",
                                "format": "date",
                            ),
                        ),
                    ),
                    "consumes": (
                        MimeTypeJson,
                        MimeTypeYamlRpc,
                        MimeTypeFormUrlEncoded,
                        MimeTypeMultipartFormData,
                        "image/png",
                    ),
                    "produces": (
                        MimeTypeJson,
                        MimeTypeYamlRpc,
                    ),
                ),
                "put": (
                    "parameters": (
                        ("$ref": "#/components/parameters/enum",),
                        ("$ref": "#/components/parameters/int",),
                        ("$ref": "#/components/parameters/date",),
                        ("$ref": "#/components/parameters/byte",),
                        ("$ref": "#/components/parameters/string",),
                    ),
                    "responses": (
                        "200": (
                            "description": "success",
                        ),
                    ),
                    "consumes": (
                        MimeTypeJson,
                        MimeTypeYamlRpc,
                        MimeTypeFormUrlEncoded,
                        MimeTypeMultipartFormData,
                    ),
                    "produces": (
                        MimeTypeJson,
                        MimeTypeYamlRpc,
                    ),
                ),
            );
            b.paths."/api/b2497" += (
                "get": (
                    "responses": (
                        "200": (
                            "description": "success",
                            "schema": {
                                "type": "string",
                                "format": "binary",
                            }
                        ),
                    ),
                    "consumes": (MimeTypeJson,),
                    "produces": ("image/jpeg", "image/png"),
                ),
                "post": (
                    "responses": (
                        "200": ("description": "success",),
                    ),
                    "consumes": ("image/png",),
                    "produces": ("text/plain",),
                    "parameters": (
                        {
                            "in": "body",
                            "name": "body",
                            "schema": (
                                "type": "string",
                                "format": "binary",
                            ),
                        },
                    )
                ),
            );
            b.paths."/api/b2507" += (
                "post": (
                    "responses": (
                        "200": (
                            "description": "success",
                            "schema": {
                                "type": "string",
                            }
                        ),
                    ),
                    "consumes": (MimeTypeJson,),
                    "produces": (MimeTypeJson,),
                    "parameters": (
                        {
                            "in": "body",
                            "name": "body",
                            "schema": (
                                "type": "object",
                                "properties": {
                                    "a": {"type": "string"}
                                }
                            ),
                        },
                    )
                ),
            );
            b.paths."/api/b2517" += {
                "post": (
                    "responses": (
                        "200": ("description": "success",),
                    ),
                    "consumes": ("image/jpeg","image/png"),
                    "produces": ("text/plain",),
                    "parameters": (
                        {
                            "in": "body",
                            "name": "body",
                            "schema": (
                                "type": "string",
                                "format": "binary",
                            ),
                        },
                    )
                ),
            };
            b.paths."/api/unix-time" += {
                "get": {
                    "responses": {
                        "200": {"description": "success",},
                    },
                    #"produces": (MimeTypeJson,),
                    "parameters": (
                        {
                            "in": "query",
                            "name": "t",
                            "schema": {
                                "type": "integer",
                                "format": "unix-time",
                            },
                        },
                    )
                },
                "post": {
                    "responses": {
                        "200": {
                            "description": "success",
                            "schema": {
                                "type": "integer",
                                "format": "unix-time",
                            }
                        },
                    },
                    "consumes": (MimeTypeJson,),
                    "produces": (MimeTypeJson,),
                    "parameters": (
                        {
                            "in": "body",
                            "name": "t",
                            "schema": {
                                "type": "integer",
                                "format": "unix-time",
                            },
                        },
                    )
                },
            };

            # Remove type from schema to test type-less schema
            remove b.components.parameters.a.schema.type;

            OpenApi3Schema so("", b);

            assertThrows("SCHEMA-VALIDATION-ERROR", \so.processRequest(), ("post", "/api/smtg", ("a": "a")));

            b.components.schemas.a.properties.a.readOnly = False;
            so = new OpenApi3Schema("", b);

            # issue #2369
            assertThrows("SCHEMA-VALIDATION-ERROR", \so.processRequest(), ("post", "/api/smtg"));

            b.components.parameters.a.required = False;
            so = new OpenApi3Schema("", b);
            hash<RestRequestClientInfo> h = so.processRequest("post", "/api/smtg");
            assertEq("/api/smtg", h.uri_path);
            assertNothing(h.body);

            # by default, parameters are optional
            remove b.components.parameters.a.required;
            so = new OpenApi3Schema("", b);
            h = so.processRequest("post", "/api/smtg");
            assertEq("/api/smtg", h.uri_path);
            assertNothing(h.body);

            h = so.processRequest("post", "/api/smtg", ("a": "a"), NOTHING, MimeTypeFormUrlEncoded);
            assertEq("/api/smtg", h.uri_path);
            assertEq("a=a", h.body);
            assertEq(MimeTypeFormUrlEncoded, h.content);
            #printf("h: %y\n", h);

            {
                hash hdr = ("content-type": h.content);
                hash<RestRequestServerInfo> sh = so.parseRequest("post", h.uri_path, h.body, \hdr);
                assertEq("/api/smtg", sh.path);
                assertEq("a", sh.body.a);
                #printf("sh: %N\n", sh);
            }

            {
                hash hdr = ("content-type": h.content);
                h.body = "b=a";
                assertThrows("SCHEMA-VALIDATION-ERROR", \so.parseRequest(), ("post", h.uri_path, h.body, \hdr));
            }

            # test for issue #2365
            assertThrows("SCHEMA-VALIDATION-ERROR", "Parameter \"a\".*invalid type", \so.processRequest(), ("post",
                "/api/smtg", ("a": 1)));

            assertThrows("SERIALIZATION-ERROR", "application/octet-stream", \so.processRequest(), ("post",
                "/api/smtg", ("a": "a"), NOTHING, MimeTypeOctetStream));

            h = so.processRequest("post", "/api/smtg", ("a": "a"), NOTHING, MimeTypeMultipartFormData);
            assertEq("/api/smtg", h.uri_path);
            assertEq(True, h.content =~ /^multipart\/form-data; boundary=/);
            assertEq(Type::Binary, h.body.type());
            #printf("h: %y\n", h + ("body": h.body.toString()));

            {
                hash hdr = ("content-type": h.content);
                hash<RestRequestServerInfo> sh = so.parseRequest("post", h.uri_path, h.body, \hdr);
                assertEq("/api/smtg", sh.path);
                assertEq("a", sh.body.a);
            }

            # issue #2396 minLength and maxLength checks
            h = so.processRequest("put", "/api/smtg?string=abc", 1);
            #printf("h: %y\n", h);
            assertEq("/api/smtg?string=abc", h.uri_path);
            assertEq(Type::String, h.body.type());

            assertThrows("SCHEMA-VALIDATION-ERROR", "enumerated values", \so.processRequest(),
                ("put", "/api/smtg?string=xyz", 1));
            assertThrows("SCHEMA-VALIDATION-ERROR", "string.*too short", \so.processRequest(),
                ("put", "/api/smtg?string=a", 1));
            assertThrows("SCHEMA-VALIDATION-ERROR", "string.*too long", \so.processRequest(),
                ("put", "/api/smtg?string=abcdefg", 1));

            {
                hash hdr = ("content-type": h.content);
                hash<RestRequestServerInfo> sh = so.parseRequest("put", h.uri_path, h.body, \hdr);
                assertEq("/api/smtg", sh.path);
                assertEq(1, sh.body);

                assertThrows("SCHEMA-VALIDATION-ERROR", "string.*too short", \so.parseRequest(), ("put", "/api/smtg?string=a", h.body, \hdr));
                assertThrows("SCHEMA-VALIDATION-ERROR", "string.*too long", \so.parseRequest(), ("put", "/api/smtg?string=abcdefg", h.body, \hdr));
            }

            # issue #2364 enum check
            h = so.processRequest("put", "/api/smtg", 1);
            #printf("h: %y\n", h);
            assertEq("/api/smtg", h.uri_path);
            assertEq(Type::String, h.body.type());

            assertThrows("SCHEMA-VALIDATION-ERROR", "enum.*values", \so.processRequest(), ("put", "/api/smtg", 4));

            # issue #2388 int parameter check
            h = so.processRequest("put", "/api/smtg?int=1", 2);
            #printf("h: %y\n", h);
            assertEq("/api/smtg?int=1", h.uri_path);
            assertEq(Type::String, h.body.type());

            assertThrows("SCHEMA-VALIDATION-ERROR", "integer", \so.processRequest(), ("put", "/api/smtg?int=sdf", 2));

            h = so.processRequest("put", "/api/smtg?int=-1", 2);
            #printf("h: %y\n", h);
            assertEq("/api/smtg?int=-1", h.uri_path);
            assertEq(Type::String, h.body.type());

            h = so.processRequest("put", "/api/smtg?int=+1", 2);
            #printf("h: %y\n", h);
            assertEq("/api/smtg?int=1", h.uri_path);
            assertEq(Type::String, h.body.type());

            {
                hash hdr."content-type" = "application/json";
                hash<RestRequestServerInfo> sh = so.parseRequest("put", h.uri_path, h.body, \hdr);
                #printf("sh: %y\n", sh);
                assertEq("/api/smtg", sh.path);
                assertEq(1, sh.query.int);
                assertEq(2, sh.body);
            }

            # issue #2388 date parameter check
            h = so.processRequest("put", "/api/smtg?date=2017-01-01", 2);
            #printf("h: %y\n", h);
            assertEq("/api/smtg?date=2017-01-01", h.uri_path);
            assertEq(Type::String, h.body.type());

            assertThrows("SCHEMA-VALIDATION-ERROR", "date", \so.processRequest(), ("put", "/api/smtg?date=sdf", 2));

            {
                hash hdr."content-type" = "application/json";
                hash<RestRequestServerInfo> sh = so.parseRequest("put", h.uri_path, h.body, \hdr);
                #printf("sh: %y\n", sh);
                assertEq("/api/smtg", sh.path);
                assertEq(2017-01-01, sh.query.date);
                assertEq(2, sh.body);
            }

            {
                # issue #2397 400 Bad Request response to invalid date params
                hash hdr."content-type" = "application/json";
                assertThrows("SCHEMA-VALIDATION-ERROR", "date.*invalid", \so.parseRequest(), ("put", "/api/smtg?date=2017-01-x1", h.body, \hdr));
            }

            # issue #2388 byte parameter check
            h = so.processRequest("put", "/api/smtg?byte=YWJj", 3);
            #printf("h: %y\n", h);
            assertEq("/api/smtg?byte=YWJj", h.uri_path);
            assertEq(Type::String, h.body.type());

            assertThrows("SCHEMA-VALIDATION-ERROR", "byte.*base64", \so.processRequest(), ("put", "/api/smtg?byte=123", 3));

            {
                hash hdr."content-type" = "application/json";
                hash<RestRequestServerInfo> sh = so.parseRequest("put", h.uri_path, h.body, \hdr);
                #printf("sh: %y\n", sh);
                assertEq("/api/smtg", sh.path);
                assertEq(<616263>, sh.query.byte);
                assertEq(3, sh.body);
            }

            # issue #2397 400 Bad Request response to invalid date params
            b.components.schemas.a = (
                "type": "string",
                "format": "date",
            );

            so = new OpenApi3Schema("", b);

            {
                hash hdr = ("content-type": h.content);
                hash<RestRequestServerInfo> sh = so.parseRequest("post", "/api/smtg", "\"2017-01-01\"", \hdr);
                assertEq("/api/smtg", sh.path);
                assertEq(2017-01-01, sh.body);

                assertThrows("SCHEMA-VALIDATION-ERROR", \so.parseRequest(), ("post", "/api/smtg", "\"2017-01-0x\"", \hdr));
                #printf("sh: %N\n", sh);
            }

            # issue #2397 400 Bad Request response to invalid binary params
            b.components.schemas.a.format = "binary";

            so = new OpenApi3Schema("", b);

            {
                hash hdr = ("content-type": "image/png");
                hash<RestRequestServerInfo> sh = so.parseRequest("post", "/api/smtg", <abcd>, \hdr);
                assertEq("/api/smtg", sh.path);
                assertEq(<abcd>, sh.body);
                #printf("sh: %N\n", sh);
            }

            # issue #2397 400 Bad Request response to invalid byte params
            b.components.schemas.a.format = "byte";

            so = new OpenApi3Schema("", b);

            {
                hash hdr = ("content-type": h.content);
                hash<RestRequestServerInfo> sh = so.parseRequest("post", "/api/smtg", "\"YWJjZA==\"", \hdr);
                assertEq("/api/smtg", sh.path);
                assertEq("abcd", sh.body.toString());

                assertThrows("SCHEMA-VALIDATION-ERROR", \so.parseRequest(), ("post", "/api/smtg", "\"YWJjZZZ\"", \hdr));
                #printf("sh: %N\n", sh);
            }

            # issue #2409: date values formatted incorrectly in OpenApi3 responses
            {
                date now = now_us();

                hash<HttpResponseInfo> res = so.processResponse("post", "/api/smtg", 409, now, NOTHING, MimeTypeJson);
                assertEq(409, res.code);
                assertEq(MimeTypeJson, res.hdr."Content-Type");
                assertEq(now.format("\"YYYY-MM-DD\""), res.body);
            }

            # issue #2497 test response
            so = new OpenApi3Schema("", b);
            {
                hash<HttpResponseInfo> res = so.processResponse("get", "/api/b2497", 200, <feedface>, {"content-type": "image/jpeg"}, NOTHING);
                assertEq(200, res.code);
                assertEq("image/jpeg", res.hdr."content-type");
                assertEq(<feedface>, res.body);

                res = so.processResponse("get", "/api/b2497", 200, <feedface>, {"content-type": "image/png"}, NOTHING);
                assertEq(200, res.code);
                assertEq("image/png", res.hdr."content-type");
                assertEq(<feedface>, res.body);

                res = so.processResponse("get", "/api/b2497", 200, <feedface>, {"Content-Type": "image/jpeg"}, NOTHING);
                assertEq(200, res.code);
                assertEq("image/jpeg", res.hdr."Content-Type");
                assertEq(<feedface>, res.body);

                res = so.processResponse("get", "/api/b2497", 200, <feedface>, {"Content-Type": "image/png"}, NOTHING);
                assertEq(200, res.code);
                assertEq("image/png", res.hdr."Content-Type");
                assertEq(<feedface>, res.body);
            }
            # issue #2497 test response parsing with Content-Types that cannot be deserialized
            {
                hash<RestResponseClientInfo> cres = so.parseResponse("get", "/api/b2497", 200, <feedface>, ("content-type": "image/jpeg"));
                assertEq(200, cres.code);
                assertEq(MimeTypeJpeg, cres.hdr."content-type");
                assertEq(<feedface>, cres.body);
            }
            {
                hash<HttpResponseInfo> res = so.processResponse("get", "/api/b2497", 200, <feedface>, {"content-type": "image/jpeg"}, ("*/*",));
                assertEq(200, res.code);
                assertEq("image/jpeg", res.hdr."content-type");
                assertEq(<feedface>, res.body);

                res = so.processResponse("get", "/api/b2497", 200, <feedface>, {"content-type": "image/png"}, ("*/*",));
                assertEq(200, res.code);
                assertEq("image/png", res.hdr."content-type");
                assertEq(<feedface>, res.body);

                res = so.processResponse("get", "/api/b2497", 200, <feedface>, {"Content-Type": "image/jpeg"}, ("*/*",));
                assertEq(200, res.code);
                assertEq("image/jpeg", res.hdr."Content-Type");
                assertEq(<feedface>, res.body);

                res = so.processResponse("get", "/api/b2497", 200, <feedface>, {"Content-Type": "image/png"}, ("*/*",));
                assertEq(200, res.code);
                assertEq("image/png", res.hdr."Content-Type");
                assertEq(<feedface>, res.body);
            }
            {
                hash<HttpResponseInfo> res = so.processResponse("get", "/api/b2497", 200, <feedface>, {"content-type": "image/jpeg"}, ("image/*",));
                assertEq(200, res.code);
                assertEq("image/jpeg", res.hdr."content-type");
                assertEq(<feedface>, res.body);

                res = so.processResponse("get", "/api/b2497", 200, <feedface>, {"content-type": "image/png"}, ("image/*",));
                assertEq(200, res.code);
                assertEq("image/png", res.hdr."content-type");
                assertEq(<feedface>, res.body);

                res = so.processResponse("get", "/api/b2497", 200, <feedface>, {"Content-Type": "image/jpeg"}, ("image/*",));
                assertEq(200, res.code);
                assertEq("image/jpeg", res.hdr."Content-Type");
                assertEq(<feedface>, res.body);

                res = so.processResponse("get", "/api/b2497", 200, <feedface>, {"Content-Type": "image/png"}, ("image/*",));
                assertEq(200, res.code);
                assertEq("image/png", res.hdr."Content-Type");
                assertEq(<feedface>, res.body);
            }
            {
                list contentTypes = ("text/x-yaml","application/x-yaml","text/xml","application/xml","application/json","image/jpeg","image/png");
                hash<HttpResponseInfo> res = so.processResponse("get", "/api/b2497", 200, <feedface>, {"content-type": "image/jpeg"}, contentTypes);
                assertEq(200, res.code);
                assertEq("image/jpeg", res.hdr."content-type");
                assertEq(<feedface>, res.body);

                res = so.processResponse("get", "/api/b2497", 200, <feedface>, {"content-type": "image/png"}, contentTypes);
                assertEq(200, res.code);
                assertEq("image/png", res.hdr."content-type");
                assertEq(<feedface>, res.body);

                res = so.processResponse("get", "/api/b2497", 200, <feedface>, {"Content-Type": "image/jpeg"}, contentTypes);
                assertEq(200, res.code);
                assertEq("image/jpeg", res.hdr."Content-Type");
                assertEq(<feedface>, res.body);

                res = so.processResponse("get", "/api/b2497", 200, <feedface>, {"Content-Type": "image/png"}, contentTypes);
                assertEq(200, res.code);
                assertEq("image/png", res.hdr."Content-Type");
                assertEq(<feedface>, res.body);
            }
            {
                list contentTypes = ("text/x-yaml","application/x-yaml","text/xml","application/xml","application/json","image/jpeg","image/png");
                assertThrows("ACCEPT-ERROR", \so.processResponse(), ("get", "/api/b2497", 200, <feedface>, NOTHING, NOTHING));
                assertThrows("ACCEPT-ERROR", \so.processResponse(), ("get", "/api/b2497", 200, <feedface>, NOTHING, ("image/*",)));
                assertThrows("ACCEPT-ERROR", \so.processResponse(), ("get", "/api/b2497", 200, <feedface>, NOTHING, contentTypes));
            }

            # issue #2497 test request
            {
                hash<RestRequestClientInfo> res = so.processRequest("post", "/api/b2497", <feedface>, {"content-type": "image/png"}, NOTHING);
                assertEq("/api/b2497", res.uri_path);
                assertEq("image/png", res.content);
                assertEq(<feedface>, res.body);

                res = so.processRequest("post", "/api/b2497", <feedface>, {"Content-Type": "image/png"}, NOTHING);
                assertEq("/api/b2497", res.uri_path);
                assertEq("image/png", res.content);
                assertEq(<feedface>, res.body);
            }
            {
                hash<RestRequestClientInfo> res = so.processRequest("post", "/api/b2497", <feedface>, {"content-type": "image/png"}, ("image/png",));
                assertEq("/api/b2497", res.uri_path);
                assertEq("image/png", res.content);
                assertEq(<feedface>, res.body);

                res = so.processRequest("post", "/api/b2497", <feedface>, {"Content-Type": "image/png"}, ("image/png",));
                assertEq("/api/b2497", res.uri_path);
                assertEq("image/png", res.content);
                assertEq(<feedface>, res.body);
            }

            # issue #2507
            so = new OpenApi3Schema("", b);
            {
                hash<RestRequestClientInfo> res = so.processRequest("post", "/api/b2507", {"a":"b"}, NOTHING, (MimeTypeJson,));
                assertEq("/api/b2507", res.uri_path);
                assertEq(MimeTypeJson, res.content);
                assertEq('{"a":"b"}', res.body);

                hash hdr = ("content-type": MimeTypeJson);
                hash<RestRequestServerInfo> sh = so.parseRequest("post", res.uri_path, res.body, \hdr);
                assertEq("/api/b2507", sh.path);
                assertEq(("a":"b"), sh.body);

                hdr = ("content-type": MimeTypeYamlRpc);
                assertThrows("DESERIALIZATION-ERROR", \so.parseRequest(), ("post", res.uri_path, res.body, \hdr));

                hdr = ("content-type": MimeTypeText);
                assertThrows("SCHEMA-VALIDATION-ERROR", \so.parseRequest(), ("post", res.uri_path, res.body, \hdr));

                hash<RestResponseClientInfo> rsh = so.parseResponse("post", res.uri_path, 200, "\"string\"", ("content-type": MimeTypeJson));
                assertEq(200, rsh.code);
                assertEq(MimeTypeJson, rsh.hdr."content-type");
                assertEq("string", rsh.body);
                assertThrows("DESERIALIZATION-ERROR", \so.parseResponse(), ("post", res.uri_path, 200, "\"string\"", ("content-type": MimeTypeYamlRpc)));
            }

            # issue #2517
            so = new OpenApi3Schema("", b);
            {
                hash hdr = {
                    "http_version": "1.1",
                    "status_code": 200,
                    "status_message": "OK",
                    "server": "Qorus-HTTP-Server/0.3.11.1",
                    "connection": "Keep-Alive",
                    "date": "Thu, 30 Nov 2017 12:59:55 GMT",
                    "content-length": "0",
                };
                hash<RestResponseClientInfo> res = so.parseResponse("post", "/api/b2517", 200, NOTHING, hdr);
                assertEq(200, res.code);
                assertEq(NOTHING, res.body);
            }

            # issue #2516
            so = new OpenApi3Schema("", b);
            {
                hash<RestRequestClientInfo> res = so.processRequest("post", "/api/b2517", <feedface>,
                    {"Content-Type": "image/jpeg"});
                assertEq("/api/b2517", res.uri_path);
                assertEq(<feedface>, res.body);

                # the following call would throw a SCHEMA-VALIDATION-ERROR without the fix
                res = so.processRequest("post", "api/b2517", <feedface>, {"Content-Type": "image/jpeg"});
                assertEq("/api/b2517", res.uri_path);
                assertEq(<feedface>, res.body);
            }

            # issue #4087
            so = new OpenApi3Schema("", b + {"basePath": "/v1"});
            {
                assertEq("/v1", so.getBasePath());
                hash<RestRequestClientInfo> res = so.processRequest("post", "v1/api/b2517", <feedface>,
                    {"Content-Type": "image/jpeg"});
                assertEq("/v1/api/b2517", res.uri_path);
                assertEq(<feedface>, res.body);
                hash<RestResponseClientInfo> rsh = so.parseResponse("post", "/v1/api/b2507", 200, "\"string\"",
                    {"content-type": MimeTypeJson});
                assertEq(200, rsh.code);
                assertEq(MimeTypeJson, rsh.hdr."content-type");
                assertEq("string", rsh.body);
                assertThrows("SCHEMA-VALIDATION-ERROR", \so.parseResponse(), ("post", "/v2/api/b2507", 200,
                    "\"string\"", {"content-type": MimeTypeJson}));
            }

            h = so.processRequest("get", "/v1/api/unix-time?t=2024-09-30T12:35:52", NOTHING, NOTHING, MimeTypeJson);
            assertEq("/v1/api/unix-time?t=1727692552", h.uri_path);
            assertNothing(h.body);
            assertNothing(h.content);
            #printf("h: %y\n", h);

            {
                hash hdr = ("content-type": h.content);
                hash<RestRequestServerInfo> sh = so.parseRequest("get", h.uri_path, h.body, \hdr);
                on_error printf("sh: %N\n", sh);
                assertEq("/api/unix-time", sh.path);
                assertEq(2024-09-30T12:35:52, sh.query.t);
                assertNothing(sh.body);
            }

            h = so.processRequest("post", "/v1/api/unix-time", 2024-09-30T12:35:52, NOTHING, MimeTypeJson);
            assertEq("/v1/api/unix-time", h.uri_path);
            assertEq("1727692552", h.body);
            assertEq(MimeTypeJson, h.content);
            #printf("h: %y\n", h);

            {
                # Use += to avoid type narrowing; parseRequest takes reference<hash<auto>>
                hash<auto> hdr += ("content-type": h.content);
                hash<RestRequestServerInfo> sh = so.parseRequest("post", h.uri_path, h.body, \hdr);
                on_error printf("sh: %N\n", sh);
                assertEq("/api/unix-time", sh.path);
                assertEq(2024-09-30T12:35:52, sh.body);
            }

            {
                hash<HttpResponseInfo> res = so.processResponse("post", "/api/unix-time", 200, 2024-09-30T12:35:52, NOTHING, MimeTypeJson);
                {
                    on_error printf("res: %N\n", res);
                    assertEq(200, res."code");
                    assertEq(MimeTypeJson, res.hdr."Content-Type");
                    assertEq("1727692552", res.body);
                }

                hash<RestResponseClientInfo> cres = so.parseResponse("post", "/api/unix-time", res."code", res.body, res.hdr);
                assertEq(200, cres."code");
                assertEq(MimeTypeJson, cres.hdr."Content-Type");
                assertEq(2024-09-30T12:35:52, cres.body);
            }
        }

        {
            # GET /pets is declared as array<Pet> in PetStore.openapi3.yaml;
            # with the v1.0 allOf merge SchemaObject::getDataType() exposes Pet as
            # a concrete hash<{name, tag, id}>, so the dummy response body must be
            # a valid Pet object for the response validator to accept it
            hash<auto> petRep = {"id": 1, "name": "OK", "tag": "x"};
            string rep = makeBody(petRep);

            HttpTestServer serv(rep);
            string url = sprintf("http://localhost:%d", serv.port);
            hash<auto> opts = {
                "url": url,
                "openapi3": dirname(get_script_path()) + DirSep + "PetStore.openapi3.yaml",
            };
            {
                on_exit serv.done();

                RestClient rc(opts);
                #printf("url: %y\n", url);
                # GET /pets returns an array schema, so single value gets wrapped in a list
                hash<auto> h = rc.get("/pets?limit=10");
                assertEq((petRep,), h.body);

                assertThrows("SCHEMA-VALIDATION-ERROR", \rc.get(), "/pets?invalid_param=y");
                assertThrows("SCHEMA-VALIDATION-ERROR", \rc.get(), "/something?x=y");
            }
            {
                serv.restart();
                on_exit serv.done();

                RestClient rc(opts + {
                    "openapi3_base_path": "/",
                });
                # GET /pets returns an array schema, so single value gets wrapped in a list
                hash<auto> h = rc.get("/pets?limit=10");
                assertEq((petRep,), h.body);
            }
            {
                serv.restart();
                on_exit serv.done();

                RestClient rc(opts + {
                    "openapi3_base_path": "/v2",
                });
                rc.getValidator().setBasePath("v2");
                # GET /pets returns an array schema, so single value gets wrapped in a list
                hash<auto> h = rc.get("/v2/pets?limit=10");
                assertEq((petRep,), h.body);
            }
        }
    }

    private testValidation(OpenApi3Schema so) {
        # PetStore has servers: [{url: "https://petstore.swagger.io/v2"}] so basePath is "/v2"
        string bp = so.getBasePath();

        # Test GET /pets with query parameters (tags array)
        so.processRequest("get", "/pets?tags=tag1;tags=tag2");
        so.processRequest("get", "/pets?limit=10");

        # Test arrays in parameters
        {
            string uri = "/pets?tags=tag1;tags=tag2";
            hash<RestRequestClientInfo> req = so.processRequest("GET", uri);
            assertEq(bp + uri, req.uri_path);
        }

        {
            string uri = "/pets?tags=tag1&tags=tag2";
            hash<RestRequestClientInfo> req = so.processRequest("GET", uri);
            assertEq(bp + uri, req.uri_path);
        }

        # Test POST /pets with body (NewPet schema)
        {
            hash hdr = {};
            hash body = (
                "name": "Scooby",
                "tag": "dog",
            );
            hash<RestRequestClientInfo> req = so.processRequest("POST", "/pets", body, hdr);
            assertEq(MimeTypeJson, req.content);
            assertEq(Type::String, req.body.type());
            assertEq(bp + "/pets", req.uri_path);
            assertEq("UTF-8", req.body.encoding());

            {
                hdr = ("content-type": req.content);
                hash<RestRequestServerInfo> sh = so.parseRequest("POST", req.uri_path, req.body, \hdr);
                assertEq("Scooby", sh.body.name);
                assertEq("dog", sh.body.tag);
            }

            # Test missing required field "name"
            delete body.name;
            assertThrows("SCHEMA-VALIDATION-ERROR", "missing.*name", \so.processRequest(), ("post", "/pets", body, hdr));
        }

        # Test GET /pets/{id}
        {
            hash<RestRequestClientInfo> req = so.processRequest("GET", "/pets/123");
            assertEq(bp + "/pets/123", req.uri_path);
        }

        # Test DELETE /pets/{id}
        {
            hash<RestRequestClientInfo> req = so.processRequest("DELETE", "/pets/456");
            assertEq(bp + "/pets/456", req.uri_path);
        }

        # Test invalid path
        assertThrows("SCHEMA-VALIDATION-ERROR", \so.processRequest(), ("get", "/invalid/path"));

        {
            # GET /pets is declared as array<Pet> in PetStore.openapi3.yaml;
            # with the v1.0 allOf merge SchemaObject::getDataType() exposes Pet as
            # a concrete hash<{name, tag, id}>, so the dummy response body must be
            # a valid Pet object for the response validator to accept it
            hash<auto> petRep = {"id": 1, "name": "OK", "tag": "x"};
            string rep = makeBody(petRep);

            HttpTestServer serv(rep);
            on_exit serv.done();

            string url = sprintf("http://localhost:%d", serv.port);
            hash opts = (
                "url": url,
                "validator": so,
            );

            assertEq(bp, so.getBasePath());

            RestClient rc(opts);
            hash h = rc.get("/pets?limit=10");
            # GET /pets returns an array schema, so single value gets wrapped in a list
            assertEq((petRep,), h.body);

            assertThrows("SCHEMA-VALIDATION-ERROR", \rc.get(), "/invalid?x=y");
        }

        {
            # Test response processing for GET /pets
            list<auto> petList = ({"id": 1, "name": "Fido", "tag": "dog"},);
            hash<HttpResponseInfo> res = so.processResponse("get", "/pets", 200, petList, NOTHING, MimeTypeJson);
            assertEq(200, res.code);
            assertEq(MimeTypeJson, res.hdr."Content-Type");
        }

    }

    testExamples() {
        checkModules();

        testExamples(OpenApi3::OpenApi3Loader::fromFile(get_script_dir() + DirSep + "PetStore.openapi3.yaml"));
        testExamples(OpenApi3::OpenApi3Loader::fromFile(get_script_dir() + DirSep + "PetStore.openapi3.json"));
    }

    private testExamples(OpenApi3Schema so) {
        # Test GET /pets example request
        hash<RestQoreExampleCodeInfo> qex = so.getQoreExampleRequest("GET", "/pets");
        assertEq(True, qex.example =~ /\/pets\?tags=Example items;limit=1/im);
        hash<RestExampleRequestInfo> rex = so.getExampleRequest("GET", "/pets");
        assertEq(True, rex.request_uri =~ /\/pets\?tags=Example items;limit=1/im);

        # Test POST /pets example request
        qex = so.getQoreExampleRequest("POST", "/pets");
        assertEq(Type::String, qex.example.type());

        rex = so.getExampleRequest("POST", "/pets");
        assertEq("POST /pets HTTP/1.1", rex.request_uri);
        assertEq(MimeTypeJson, rex.hdr."Content-Type");

        # Test GET /pets response example
        qex = so.getQoreExampleResponse("GET", "/pets", 200);
        assertEq(True, qex.example =~ /makeResponse.200/);
        hash<RestExampleResponseInfo> res = so.getExampleResponse("GET", "/pets", 200);
        assertEq(200, res.code);
        assertEq(MimeTypeJson, res.hdr."Content-Type");

        # Test GET /pets/{id} response example
        qex = so.getQoreExampleResponse("get", "/pets/{id}", 200);
        assertEq(True, qex.example =~ /makeResponse.200/);
        res = so.getExampleResponse("GET", "/pets/{id}", 200);
        assertEq(200, res.code);
        assertEq(MimeTypeJson, res.hdr."Content-Type");
        assertEq(True, res.body =~ /id/);
    }

    testRealMessages() {
        checkModules();

        testRealMessages(OpenApi3::OpenApi3Loader::fromFile(get_script_dir() + DirSep + "PetStore.openapi3.yaml"));
        testRealMessages(OpenApi3::OpenApi3Loader::fromFile(get_script_dir() + DirSep + "PetStore.openapi3.json"));
    }

    testRealMessages(OpenApi3Schema so) {
        foreach hash h in (JsonRequestMessages.pairIterator()) {
            foreach hash mh in (h.value.pairIterator()) {
                hash hdr."content-type" = MimeTypeJson;
                hash<RestRequestServerInfo> sh = so.parseRequest(mh.key, h.key, mh.value, \hdr);
                assertEq(Type::Hash, sh.type());
            }
        }

        foreach hash h in (JsonResponseMessages.pairIterator()) {
            foreach hash mh in (h.value.pairIterator()) {
                foreach hash ch in (mh.value.pairIterator()) {
                    hash hdr."content-type" = MimeTypeJson;
                    hash<RestResponseClientInfo> sh = so.parseResponse(mh.key, h.key, ch.key.toInt(), ch.value, hdr);
                    assertEq(Type::Hash, sh.type());
                }
            }
        }
    }

    static string makeBody(any b) {
        string json = my_make_json(b);

        return sprintf("HTTP/1.1 200 OK\r\nServer: Test/1.0\r\nContent-Type: application/json\r\nContent-Length: %d\r\nDate: %s GMT\r\n\r\n%s", json.size(), gmtime().format("Dy, DD Mon YYYY HH:mm:SS"), json);
    }

    testOpenApi31Version() {
        checkModules();

        # Test 3.0.x detection
        {
            hash<auto> schema30 = {
                "openapi": "3.0.3",
                "info": {"title": "Test API", "version": "1.0"},
                "paths": {},
            };
            OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", schema30);
            assertFalse(so.is31OrLater());
        }

        # Test 3.1.x detection
        {
            hash<auto> schema31 = {
                "openapi": "3.1.0",
                "info": {"title": "Test API", "version": "1.0"},
                "paths": {},
            };
            OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", schema31);
            assertTrue(so.is31OrLater());
        }

        # Test 3.1.1 detection
        {
            hash<auto> schema311 = {
                "openapi": "3.1.1",
                "info": {"title": "Test API", "version": "1.0"},
                "paths": {},
            };
            OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", schema311);
            assertTrue(so.is31OrLater());
        }

        # Test jsonSchemaDialect
        {
            hash<auto> schema31 = {
                "openapi": "3.1.0",
                "info": {"title": "Test API", "version": "1.0"},
                "paths": {},
                "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
            };
            OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", schema31);
            assertEq("https://json-schema.org/draft/2020-12/schema", so.jsonSchemaDialect);
        }
    }

    testOpenApi31TypeArrays() {
        checkModules();

        # Test type array with null (OpenAPI 3.1 nullable syntax)
        {
            hash<auto> schema = {
                "openapi": "3.1.0",
                "info": {"title": "Test API", "version": "1.0"},
                "paths": {},
                "components": {
                    "schemas": {
                        "NullableString": {
                            "type": ("string", "null"),
                        },
                    },
                },
            };
            OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", schema);
            OpenApi3::SchemaObject nullableString = so.components.schemas.NullableString;
            assertEq("string", nullableString.type);
            assertTrue(nullableString.nullable);
        }

        # Test type array with multiple types (first non-null type used)
        {
            hash<auto> schema = {
                "openapi": "3.1.0",
                "info": {"title": "Test API", "version": "1.0"},
                "paths": {},
                "components": {
                    "schemas": {
                        "NullableInt": {
                            "type": ("integer", "null"),
                        },
                    },
                },
            };
            OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", schema);
            OpenApi3::SchemaObject nullableInt = so.components.schemas.NullableInt;
            assertEq("integer", nullableInt.type);
            assertTrue(nullableInt.nullable);
        }
    }

    testOpenApi31NullType() {
        checkModules();

        # a standalone scalar "null" type: unconstrained and nullable, symmetric with the list form
        {
            OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", ValidOpenApi31Schema + {
                "components": {
                    "schemas": {
                        "NullOnly": {"type": "null"},
                    },
                },
            });
            OpenApi3::SchemaObject nullOnly = so.components.schemas.NullOnly;
            assertEq("any", nullOnly.type);
            assertTrue(nullOnly.nullable);
            assertTrue(nullOnly.nullType);
            assertEq("any", nullOnly.getDataType().getName());
        }

        # the list form with only "null" must be identical to the scalar form
        {
            OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", ValidOpenApi31Schema + {
                "components": {
                    "schemas": {
                        "NullOnly": {"type": ("null",)},
                    },
                },
            });
            OpenApi3::SchemaObject nullOnly = so.components.schemas.NullOnly;
            assertEq("any", nullOnly.type);
            assertTrue(nullOnly.nullable);
            assertTrue(nullOnly.nullType);
        }

        # an empty type list is unconstrained but NOT a null type
        {
            OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", ValidOpenApi31Schema + {
                "components": {
                    "schemas": {
                        "EmptyType": {"type": ()},
                    },
                },
            });
            OpenApi3::SchemaObject emptyType = so.components.schemas.EmptyType;
            assertEq("any", emptyType.type);
            assertFalse(emptyType.nullable);
            assertFalse(emptyType.nullType);
        }

        # "anyOf" with a "null" member is the OpenAPI 3.1 nullability idiom: it must produce exactly the same
        # data type as the equivalent list form "type: [string, null]", not a union widened to "any"
        {
            OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", ValidOpenApi31Schema + {
                "components": {
                    "schemas": {
                        "Obj": {
                            "type": "object",
                            "properties": {
                                "listForm": {"type": ("string", "null")},
                                "anyOfForm": {"anyOf": ({"type": "string"}, {"type": "null"})},
                                "oneOfForm": {"oneOf": ({"type": "integer"}, {"type": "null"})},
                                "optionalAnyOfForm": {"anyOf": ({"type": "string"}, {"type": "null"})},
                                "realUnion": {"anyOf": ({"type": "string"}, {"type": "integer"})},
                            },
                            "required": ("listForm", "anyOfForm", "oneOfForm", "realUnion"),
                        },
                    },
                },
            });
            OpenApi3::SchemaObject obj = so.components.schemas.Obj;
            OpenApi3::SchemaObject any_of_form = obj.properties.anyOfForm;
            OpenApi3::SchemaObject one_of_form = obj.properties.oneOfForm;
            OpenApi3::SchemaObject real_union = obj.properties.realUnion;

            # the composition is marked nullable by its "null" member
            assertTrue(any_of_form.nullable);
            assertTrue(one_of_form.nullable);
            # ... but the "null" member is still present in the parsed composition
            assertEq(2, any_of_form.anyOf.size());
            assertTrue(any_of_form.anyOf[1].nullType);
            # a union with no "null" member is not nullable
            assertFalse(real_union.nullable);

            hash<string, AbstractDataField> fields = obj.getDataType().getFields();
            assertEq(fields.listForm.getType().getName(), fields.anyOfForm.getType().getName());
            assertEq("softstring", fields.anyOfForm.getType().getName());
            assertTrue(fields.anyOfForm.isMandatory());
            assertEq("softint", fields.oneOfForm.getType().getName());
            assertTrue(fields.oneOfForm.isMandatory());
            # an optional nullable field is an "or nothing" type
            assertEq("*softstring", fields.optionalAnyOfForm.getType().getName());
            assertFalse(fields.optionalAnyOfForm.isMandatory());
            # a real union is still exposed as a union
            assertEq("softstring|softint", fields.realUnion.getType().getName());
        }

        # a composition consisting only of "null" members is unconstrained
        {
            OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", ValidOpenApi31Schema + {
                "components": {
                    "schemas": {
                        "AllNull": {"anyOf": ({"type": "null"}, {"type": "null"})},
                    },
                },
            });
            OpenApi3::SchemaObject allNull = so.components.schemas.AllNull;
            assertTrue(allNull.nullable);
            assertEq("any", allNull.getDataType().getName());
        }

        # a "null"-typed value still validates against the composition at runtime
        {
            OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", ValidOpenApi31Schema + {
                "components": {
                    "schemas": {
                        "MaybeString": {"anyOf": ({"type": "string"}, {"type": "null"})},
                    },
                },
            });
            OpenApi3::SchemaObject maybeString = so.components.schemas.MaybeString;
            auto val = "x";
            maybeString.check(False, True, "/", "POST", "MaybeString", \val);
            assertEq("x", val);
            val = NOTHING;
            maybeString.check(False, True, "/", "POST", "MaybeString", \val);
            assertNothing(val);
        }

        # negative: an unknown scalar type value is still rejected; "null" must not open the door to typos
        {
            assertThrows("INVALID-FIELD-VALUE", "invalid schema type value", sub () {
                new OpenApi3::OpenApi3Schema("", ValidOpenApi31Schema + {
                    "components": {"schemas": {"Bogus": {"type": "nul"}}},
                });
            });
        }
    }

    testOpenApi3DiscriminatorObject() {
        checkModules();

        # OpenAPI 3.x object form with a mapping
        {
            OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", ValidOpenApi31Schema + {
                "components": {
                    "schemas": {
                        "Pet": {
                            "type": "object",
                            "properties": {"petType": {"type": "string"}, "name": {"type": "string"}},
                            "required": ("petType",),
                            "discriminator": {
                                "propertyName": "petType",
                                "mapping": {
                                    "dog": "#/components/schemas/Pet",
                                    "cat": "Cat",
                                },
                            },
                        },
                    },
                },
            });
            OpenApi3::SchemaObject pet = so.components.schemas.Pet;
            assertEq("petType", pet.discriminator);
            assertEq({"dog": "#/components/schemas/Pet", "cat": "Cat"}, pet.discriminatorMapping);
        }

        # object form without a mapping
        {
            OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", ValidOpenApi31Schema + {
                "components": {
                    "schemas": {
                        "Pet": {
                            "type": "object",
                            "properties": {"petType": {"type": "string"}},
                            "required": ("petType",),
                            "discriminator": {"propertyName": "petType"},
                        },
                    },
                },
            });
            OpenApi3::SchemaObject pet = so.components.schemas.Pet;
            assertEq("petType", pet.discriminator);
            assertNothing(pet.discriminatorMapping);
        }

        # OpenAPI 3.x says the discriminator property SHOULD be required, not MUST, so the object form must be
        # accepted when the property is missing from the "required" list
        {
            OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", ValidOpenApi31Schema + {
                "components": {
                    "schemas": {
                        "Pet": {
                            "type": "object",
                            "properties": {"petType": {"type": "string"}},
                            "discriminator": {"propertyName": "petType"},
                        },
                    },
                },
            });
            assertEq("petType", so.components.schemas.Pet.discriminator);
        }

        # the Swagger 2.0 string form is still accepted (and still requires the property to be in "required")
        {
            OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", ValidOpenApi31Schema + {
                "components": {
                    "schemas": {
                        "Pet": {
                            "type": "object",
                            "properties": {"petType": {"type": "string"}},
                            "required": ("petType",),
                            "discriminator": "petType",
                        },
                    },
                },
            });
            assertEq("petType", so.components.schemas.Pet.discriminator);
            assertNothing(so.components.schemas.Pet.discriminatorMapping);
        }

        # negative: the object form requires "propertyName"
        {
            assertThrows("REQUIRED-FIELD-MISSING", "propertyName", sub () {
                new OpenApi3::OpenApi3Schema("", ValidOpenApi31Schema + {
                    "components": {
                        "schemas": {
                            "Pet": {
                                "type": "object",
                                "properties": {"petType": {"type": "string"}},
                                "discriminator": {"mapping": {"dog": "Dog"}},
                            },
                        },
                    },
                });
            });
        }

        # negative: "propertyName" must be a string
        {
            assertThrows("INVALID-FIELD-TYPE", "discriminator.propertyName", sub () {
                new OpenApi3::OpenApi3Schema("", ValidOpenApi31Schema + {
                    "components": {
                        "schemas": {
                            "Pet": {
                                "type": "object",
                                "properties": {"petType": {"type": "string"}},
                                "discriminator": {"propertyName": 5},
                            },
                        },
                    },
                });
            });
        }

        # negative: "mapping" must be a hash
        {
            assertThrows("INVALID-FIELD-TYPE", "discriminator.mapping", sub () {
                new OpenApi3::OpenApi3Schema("", ValidOpenApi31Schema + {
                    "components": {
                        "schemas": {
                            "Pet": {
                                "type": "object",
                                "properties": {"petType": {"type": "string"}},
                                "discriminator": {"propertyName": "petType", "mapping": ("dog",)},
                            },
                        },
                    },
                });
            });
        }

        # negative: "mapping" values must be strings
        {
            assertThrows("INVALID-FIELD-TYPE", "discriminator.mapping", sub () {
                new OpenApi3::OpenApi3Schema("", ValidOpenApi31Schema + {
                    "components": {
                        "schemas": {
                            "Pet": {
                                "type": "object",
                                "properties": {"petType": {"type": "string"}},
                                "discriminator": {"propertyName": "petType", "mapping": {"dog": 1}},
                            },
                        },
                    },
                });
            });
        }

        # negative: neither a string nor a hash
        {
            assertThrows("INVALID-FIELD-TYPE", "discriminator", sub () {
                new OpenApi3::OpenApi3Schema("", ValidOpenApi31Schema + {
                    "components": {"schemas": {"Pet": {"type": "string", "discriminator": 5}}},
                });
            });
        }

        # negative: the string form still requires the property to be in the "required" list
        {
            assertThrows("INVALID-FIELD-VALUE", "'required' list", sub () {
                new OpenApi3::OpenApi3Schema("", ValidOpenApi31Schema + {
                    "components": {
                        "schemas": {
                            "Pet": {
                                "type": "object",
                                "properties": {"petType": {"type": "string"}},
                                "discriminator": "petType",
                            },
                        },
                    },
                });
            });
        }
    }

    testOpenApi3AllOfScalar() {
        checkModules();

        # a one-member "allOf" wrapping a scalar $ref is how OpenAPI 3.x attaches a per-use description to a
        # reusable scalar type; the composition must adopt the referenced type rather than stay unconstrained
        {
            OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", ValidOpenApi31Schema + {
                "components": {
                    "schemas": {
                        "Email": {"type": "string", "format": "email"},
                        "Kind": {"type": "string", "enum": ("a", "b")},
                        "Ids": {"type": "array", "items": {"type": "string"}},
                        "Obj": {
                            "type": "object",
                            "properties": {
                                "email": {
                                    "allOf": ({"$ref": "#/components/schemas/Email"},),
                                    "description": "the customer's email address",
                                },
                                "kind": {"allOf": ({"$ref": "#/components/schemas/Kind"},)},
                                "ids": {"allOf": ({"$ref": "#/components/schemas/Ids"},)},
                                "count": {"allOf": ({"type": "integer"},)},
                            },
                            "required": ("email",),
                        },
                    },
                },
            });
            OpenApi3::SchemaObject obj = so.components.schemas.Obj;
            OpenApi3::SchemaObject email = obj.properties.email;
            OpenApi3::SchemaObject kind = obj.properties.kind;
            OpenApi3::SchemaObject ids = obj.properties.ids;

            # the type and the constraints that belong to it are both adopted
            assertEq("string", email.type);
            assertEq("email", email.format);
            # the outer schema's own description is not overwritten by the member's
            assertEq("the customer's email address", email.desc);
            assertEq("string", kind.type);
            assertEq({"a": True, "b": True}, kind.enumValues);
            assertEq("array", ids.type);
            assertEq("string", ids.items.type);

            hash<string, AbstractDataField> fields = obj.getDataType().getFields();
            assertEq("email", fields.email.getType().getName());
            assertTrue(fields.email.isMandatory());
            assertEq("*softstring", fields.kind.getType().getName());
            assertEq("*softlist<softstring>", fields.ids.getType().getName());
            assertEq("*softint", fields.count.getType().getName());
        }

        # an explicit type on the outer schema wins over the members
        {
            OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", ValidOpenApi31Schema + {
                "components": {
                    "schemas": {
                        "Wrapped": {
                            "type": "string",
                            "allOf": ({"type": "integer"},),
                        },
                    },
                },
            });
            assertEq("string", so.components.schemas.Wrapped.type);
        }

        # members that disagree describe an unsatisfiable intersection; no type is invented
        {
            OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", ValidOpenApi31Schema + {
                "components": {
                    "schemas": {
                        "Conflict": {"allOf": ({"type": "string"}, {"type": "integer"})},
                    },
                },
            });
            assertEq("any", so.components.schemas.Conflict.type);
        }

        # object composition is unaffected: properties are merged and the type is "object"
        {
            OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", ValidOpenApi31Schema + {
                "components": {
                    "schemas": {
                        "Base": {
                            "type": "object",
                            "properties": {"a": {"type": "string"}},
                            "required": ("a",),
                        },
                        "Derived": {
                            "allOf": (
                                {"$ref": "#/components/schemas/Base"},
                                {"type": "object", "properties": {"b": {"type": "integer"}}},
                            ),
                        },
                    },
                },
            });
            OpenApi3::SchemaObject derived = so.components.schemas.Derived;
            assertEq("object", derived.type);
            hash<string, AbstractDataField> fields = derived.getDataType().getFields();
            assertEq("softstring", fields.a.getType().getName());
            assertTrue(fields.a.isMandatory());
            assertEq("*softint", fields.b.getType().getName());
        }

        # a reusable type is often reached through a chain of single-member compositions: an "allOf" that
        # adds a description, around a "$ref" to a "oneOf" naming one enum.  Every link declares no type of
        # its own, so the chain has to be followed to reach the type at the end
        {
            OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", ValidOpenApi31Schema + {
                "components": {
                    "schemas": {
                        "PublicOrigin": {"type": "string", "enum": ("api", "web")},
                        "Origin": {"oneOf": ({"$ref": "#/components/schemas/PublicOrigin"},)},
                        "Obj": {
                            "type": "object",
                            "properties": {
                                "origin": {
                                    "allOf": ({"$ref": "#/components/schemas/Origin"},),
                                    "description": "how the transaction was created",
                                },
                            },
                        },
                    },
                },
            });
            OpenApi3::SchemaObject origin = so.components.schemas.Obj.properties.origin;
            assertEq("string", origin.type);
            assertEq({"api": True, "web": True}, origin.enumValues);
            assertEq("*softstring",
                so.components.schemas.Obj.getDataType().getFields().origin.getType().getName());
        }

        # a chain that never reaches a declared type stays unconstrained rather than looping
        {
            OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", ValidOpenApi31Schema + {
                "components": {
                    "schemas": {
                        "Inner": {"description": "no type anywhere"},
                        "Middle": {"oneOf": ({"$ref": "#/components/schemas/Inner"},)},
                        "Outer": {"allOf": ({"$ref": "#/components/schemas/Middle"},)},
                    },
                },
            });
            assertEq("any", so.components.schemas.Outer.type);
        }

        # a multi-member composition inside the chain is ambiguous and is not followed
        {
            OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", ValidOpenApi31Schema + {
                "components": {
                    "schemas": {
                        "Either": {"oneOf": ({"type": "string"}, {"type": "integer"})},
                        "Outer": {"allOf": ({"$ref": "#/components/schemas/Either"},)},
                    },
                },
            });
            assertEq("any", so.components.schemas.Outer.type);
            # ... but the data type still resolves through the wrapper, because a union can be expressed
            assertEq("softstring|softint", so.components.schemas.Outer.getDataType().getName());
        }

        # an "allOf" of unconstrained members stays unconstrained
        {
            OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", ValidOpenApi31Schema + {
                "components": {
                    "schemas": {
                        "Unconstrained": {"allOf": ({"description": "no type here"},)},
                    },
                },
            });
            assertEq("any", so.components.schemas.Unconstrained.type);
        }

        # a nullable scalar member carries its nullability to the composition
        {
            OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", ValidOpenApi31Schema + {
                "components": {
                    "schemas": {
                        "MaybeName": {"allOf": ({"type": ("string", "null")},)},
                    },
                },
            });
            OpenApi3::SchemaObject maybe_name = so.components.schemas.MaybeName;
            assertEq("string", maybe_name.type);
            assertTrue(maybe_name.nullable);
        }
    }

    testOpenApi31JsonSchemaKeywords() {
        checkModules();

        # JSON Schema 2020-12 keywords adopted by OpenAPI 3.1 that the module does not model but must accept
        # rather than reject; these are regression tests locking in that documents using them still parse
        {
            OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", ValidOpenApi31Schema + {
                "components": {
                    "schemas": {
                        "Tuple": {
                            "type": "array",
                            "prefixItems": ({"type": "string"}, {"type": "integer"}),
                            "items": {"type": "string"},
                        },
                        "Closed": {
                            "type": "object",
                            "properties": {"a": {"type": "string"}},
                            "unevaluatedProperties": False,
                        },
                        "Fixed": {
                            "type": "string",
                            "const": "only-value",
                        },
                    },
                },
            });
            assertEq("array", so.components.schemas.Tuple.type);
            assertEq("string", so.components.schemas.Tuple.items.type);
            assertEq("object", so.components.schemas.Closed.type);
            assertEq("*softstring", so.components.schemas.Closed.getDataType().getFields().a.getType().getName());
            assertEq("string", so.components.schemas.Fixed.type);
        }
    }

    testOpenApi31File() {
        checkModules();

        # the 3.1 fixture exercises every 3.1-specific construct the module supports, in a real document
        string path = normalize_dir(dirname(get_script_path())) + DirSep + "PetStore31.openapi3.yaml";
        OpenApi3::OpenApi3Schema so = OpenApi3::OpenApi3Loader::fromFile(path);
        assertTrue(so.is31OrLater());
        assertEq("/v31", so.getBasePath());
        assertEq("An OpenAPI 3.1 variant of the Petstore used to exercise 3.1-only constructs", so.info.summary);
        assertEq("Apache-2.0", so.info.license.identifier);

        # top-level webhooks
        assertEq(1, so.webhooks.size());
        assertEq("PathItemObject", so.webhooks.petCreated.className());

        OpenApi3::SchemaObject pet = so.components.schemas.Pet;
        # the discriminator object form, with its mapping
        assertEq("petType", pet.discriminator);
        assertEq({"dog": "#/components/schemas/Dog", "cat": "#/components/schemas/Cat"}, pet.discriminatorMapping);

        # both nullability idioms produce the same type
        OpenApi3::SchemaObject tag = pet.properties.tag;
        OpenApi3::SchemaObject nickname = pet.properties.nickname;
        assertTrue(tag.nullable);
        assertTrue(nickname.nullable);
        hash<string, AbstractDataField> fields = pet.getDataType().getFields();
        assertEq(fields.tag.getType().getName(), fields.nickname.getType().getName());
        assertEq("*softstring", fields.tag.getType().getName());

        # 3.1 annotations
        OpenApi3::SchemaObject color = pet.properties.color;
        OpenApi3::SchemaObject photo = pet.properties.photo;
        assertEq(("black", "white"), color.examples);
        assertEq("base64", photo.contentEncoding);
        assertEq("image/png", photo.contentMediaType);

        # numeric exclusiveMinimum/exclusiveMaximum on an operation parameter
        OpenApi3::PathItemObject pio = so.paths.match("/pets");
        OpenApi3::OperationObject get_op = pio.getOperation("get", "/pets");
        assertEq("findPets31", get_op.operationId);

        # allOf composition against a discriminated base schema
        OpenApi3::SchemaObject dog = so.components.schemas.Dog;
        assertEq("*softint", dog.getDataType().getFields().packSize.getType().getName());

        # a document-declared request round-trips through validation, with a null-valued nullable field
        OpenApi3::OperationObject post_op = pio.getOperation("post", "/pets");
        hash<auto> hdr = {};
        *data req = post_op.getRequestBody(pio, {"name": "Rex", "petType": "dog", "tag": NOTHING}, \hdr, True);
        assertEq(MimeTypeJson, hdr."Content-Type");
        assertEq("Rex", parse_json(req.toString()).name);

        # negative: a required property must be present
        assertThrows("SCHEMA-VALIDATION-ERROR", "name", \post_op.getRequestBody(), (pio, {"petType": "dog"},
            \hdr, True));
    }

    testOpenApi31ExclusiveNumeric() {
        checkModules();

        # Test exclusiveMinimum/exclusiveMaximum as numbers (OpenAPI 3.1 style)
        {
            hash<auto> schema = {
                "openapi": "3.1.0",
                "info": {"title": "Test API", "version": "1.0"},
                "paths": {},
                "components": {
                    "schemas": {
                        "BoundedNumber": {
                            "type": "number",
                            "exclusiveMinimum": 0,
                            "exclusiveMaximum": 100,
                        },
                    },
                },
            };
            OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", schema);
            OpenApi3::SchemaObject bounded = so.components.schemas.BoundedNumber;
            assertEq(0.0, bounded.exclusiveMinValue);
            assertEq(100.0, bounded.exclusiveMaxValue);
        }

        # Test old-style exclusiveMinimum/Maximum (boolean) still works
        {
            hash<auto> schema = {
                "openapi": "3.0.3",
                "info": {"title": "Test API", "version": "1.0"},
                "paths": {},
                "components": {
                    "schemas": {
                        "BoundedNumber": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 100,
                            "exclusiveMinimum": True,
                            "exclusiveMaximum": True,
                        },
                    },
                },
            };
            OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", schema);
            OpenApi3::SchemaObject bounded = so.components.schemas.BoundedNumber;
            assertTrue(bounded.exclusiveMin);
            assertTrue(bounded.exclusiveMax);
            assertEq(0.0, bounded.minimum);
            assertEq(100.0, bounded.maximum);
        }
    }

    testOpenApi31Examples() {
        checkModules();

        # Test examples array (OpenAPI 3.1)
        {
            hash<auto> schema = {
                "openapi": "3.1.0",
                "info": {"title": "Test API", "version": "1.0"},
                "paths": {},
                "components": {
                    "schemas": {
                        "WithExamples": {
                            "type": "string",
                            "examples": ("example1", "example2", "example3"),
                        },
                    },
                },
            };
            OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", schema);
            OpenApi3::SchemaObject withExamples = so.components.schemas.WithExamples;
            assertEq(3, withExamples.examples.size());
            assertEq("example1", withExamples.examples[0]);
            assertEq("example2", withExamples.examples[1]);
            assertEq("example3", withExamples.examples[2]);
        }
    }

    testOpenApi31Webhooks() {
        checkModules();

        # Test webhooks parsing
        {
            hash<auto> schema = {
                "openapi": "3.1.0",
                "info": {"title": "Test API", "version": "1.0"},
                "paths": {},
                "webhooks": {
                    "newPet": {
                        "post": {
                            "summary": "New pet notification",
                            "operationId": "newPetWebhook",
                            "requestBody": {
                                "description": "Pet data",
                                "required": True,
                                "content": {
                                    "application/json": {
                                        "schema": {"type": "object"},
                                    },
                                },
                            },
                            "responses": {
                                "200": {"description": "Success"},
                            },
                        },
                    },
                },
            };
            OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", schema);
            assertTrue(exists so.webhooks);
            assertTrue(exists so.webhooks.newPet);
            # Verify the webhook PathItemObject was parsed
            assertEq("PathItemObject", so.webhooks.newPet.className());
        }
    }

