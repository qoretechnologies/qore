                    "responses": (
                        "200": (
                            "description": "success",
                            "schema": {
                                "type": "string",
                                "format": "binary",
                            }
                        ),
                    ),
                    "consumes": (MimeTypeJson,),
                    "produces": ("image/jpeg", "image/png"),
