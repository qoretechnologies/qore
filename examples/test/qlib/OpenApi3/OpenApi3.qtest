        # Test invalid jsonSchemaDialect type
        {
            hash<auto> schema = {
                "openapi": "3.1.0",
                "info": {"title": "Test API", "version": "1.0"},
                "paths": {},
                "jsonSchemaDialect": 123,
            };
            assertThrows("INVALID-FIELD-TYPE", "jsonSchemaDialect", sub () {
                OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", schema);
            });
