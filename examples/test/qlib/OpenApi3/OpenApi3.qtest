    constructor() : Test("OpenApi3Test", "1.0") {
        addTestCase("Test loading from files", \testFiles());
        addTestCase("Test OpenApi3Schema", \testOpenApi3Schema());
        addTestCase("Test InfoObject", \testInfoObject());
        addTestCase("Test ContactObject", \testContactObject());
        addTestCase("Test LicenseObject", \testLicenseObject());
        addTestCase("Test PathsObject", \testPathsObject());
        addTestCase("Test PathItemObject", \testPathItemObject());
        addTestCase("Test OperationObject", \testOperationObject());
        addTestCase("Test ExternalDocumentationObject", \testExternalDocumentationObject());
        addTestCase("Test ParameterObject", \testParameterObject());
        addTestCase("Test ItemsObject", \testItemsObject());
        addTestCase("Test ResponsesObject", \testResponsesObject());
        addTestCase("Test ResponseObject", \testResponseObject());
        addTestCase("Test HeaderObject", \testHeaderObject());
        addTestCase("Test TagObject", \testTagObject());
        addTestCase("Test SchemaObject", \testSchemaObject());
        addTestCase("Test SchemaObject Composition Validation", \testSchemaCompositionValidation());
        addTestCase("Test XmlObject", \testXmlObject());
        addTestCase("Test SecuritySchemeObject", \testSecuritySchemeObject());
        addTestCase("Test ScopesObject", \testScopesObject());
        addTestCase("Test validation", \testValidation());
        addTestCase("Test examples", \testExamples());
        addTestCase("Test real msgs", \testRealMessages());
        addTestCase("Test OpenAPI 3.1 version detection", \testOpenApi31Version());
        addTestCase("Test OpenAPI 3.1 type arrays", \testOpenApi31TypeArrays());
        addTestCase("Test OpenAPI 3.1 exclusive min/max", \testOpenApi31ExclusiveNumeric());
        addTestCase("Test OpenAPI 3.1 examples array", \testOpenApi31Examples());
        addTestCase("Test OpenAPI 3.1 webhooks", \testOpenApi31Webhooks());
        addTestCase("Test OpenAPI 3.1 mutualTLS", \testOpenApi31MutualTLS());
        addTestCase("Test OpenAPI 3.1 contentEncoding", \testOpenApi31ContentEncoding());
        addTestCase("Test OpenAPI 3.1 info.summary", \testOpenApi31InfoSummary());
        addTestCase("Test OpenAPI 3.1 license.identifier", \testOpenApi31LicenseIdentifier());
        addTestCase("Test common extensions", \testCommonExtensions());
        addTestCase("Test OpenAPI 3.1 negative cases", \testOpenApi31NegativeCases());
        addTestCase("Test OpenAPI 3.1 type validation", \testOpenApi31TypeValidation());
        addTestCase("Test multiple content types in requestBody", \testMultipleContentTypes());

        # Return for compatibility with test harness that checks return value.
        set_return_value(main());
    }

    checkModules() {
%ifdef NoJson
        testSkip("no json module");
%endif
%ifdef NoYaml
        testSkip("no yaml module");
%endif
    }

    testFiles() {
        checkModules();

        {
            OpenApi3::OpenApi3Schema so;
            string basePath = normalize_dir(dirname(get_script_path())) + DirSep;

            # Should not throw.
            # PetStore files have servers: [{url: "https://petstore.swagger.io/v2"}]
            # so basePath is extracted as "/v2"
            so = OpenApi3::OpenApi3Loader::fromFile(basePath + "PetStore.openapi3.json");
            assertTrue(exists so);
            assertEq("/v2", so.getBasePath());
            delete so;
            so = OpenApi3::OpenApi3Loader::fromFile(basePath + "PetStore.openapi3.yaml");
            assertTrue(exists so);
            assertEq("/v2", so.getBasePath());

            assertThrows("EMPTY-SCHEMA-FILE", sub() {so = OpenApi3::OpenApi3Loader::fromFile(basePath + "EmptyOpenApi3.yaml");});
            assertThrows("EMPTY-SCHEMA-FILE", sub() {so = OpenApi3::OpenApi3Loader::fromFile(basePath + "EmptyOpenApi3.json");});
        }

        {
            hash soh = ValidOpenApi3Schema + (
                "paths": (
                    "/test": (
                        "get": (
                            "operationId": "test",
                            "responses": (
                                "200": (
                                    "description": "test",
                                ),
                            ),
                            "parameters": ((
                                "in": "body",
                                "name": "ignored",
                                "required": True,
                                "schema": (
                                    "$ref": "other.json#/info",
                                ),
                            ),),
                        ),
                    ),
                ),
            );
            assertThrows("FILE-OPEN2-ERROR", "other.json", sub () {OpenApi3Schema so("", soh);});

            code try_import = string sub (string fn) { return OtherJsonErr; };
            assertThrows("INVALID-REFERENCE", "other.json.*info", sub () {OpenApi3Schema so("", soh, ("try_import": try_import));});
            try_import = string sub (string fn) { return OtherJsonOk; };
            {
                OpenApi3Schema so("", soh, ("try_import": try_import));
                assertEq("/", so.getBasePath());
            }

            soh.paths."/test".get.parameters[0].schema."$ref" = "other.yaml#/info";
            assertThrows("FILE-OPEN2-ERROR", "other.yaml", sub () {OpenApi3Schema so("", soh);});

            try_import = string sub (string fn) { return OtherYamlErr; };
            assertThrows("INVALID-REFERENCE", "other.yaml.*info", sub () {OpenApi3Schema so("", soh, ("try_import": try_import));});
            try_import = string sub (string fn) { return OtherYamlOk; };
            OpenApi3Schema so("", soh, ("try_import": try_import));
        }
    }

    testOpenApi3Schema() {
        checkModules();

        assertThrows("INVALID-FIELD-TYPE", loadjson, '{"openapi": true}');
        assertThrows("REQUIRED-FIELD-MISSING", loadjson, '{}', "missing openapi3 field");
        assertThrows("REQUIRED-FIELD-MISSING", loadjson, '{"openapi": 3.0}', "missing info field");
        assertThrows("INVALID-FIELD-TYPE", loadjson, '{"openapi": 3.0, "info": []}', "invalid info field type");
        assertThrows("REQUIRED-FIELD-MISSING", loadjson, '{"openapi": 3.0, "info": {"title":"", "version":""}}',
            "missing paths field");

        assertTrue(loadjson(ValidOpenApi3SchemaJSON));
        assertTrue(loadyaml(ValidOpenApi3SchemaYAML));

        # Used for following tests.
        hash base = ValidOpenApi3Schema;

        assertTrue(loadyaml(my_make_yaml(base + {"host": "localhost"})));
        assertThrows("INVALID-FIELD-TYPE", loadyaml, my_make_yaml(base + {"host": 2.0}),
            "invalid host field type");

        assertTrue(loadyaml(my_make_yaml(base + {"basePath": "/test"})));
        assertThrows("INVALID-FIELD-FORMAT", loadyaml, my_make_yaml(base + {"basePath": "gfhgf"}),
            "invalid basePath format");
        assertThrows("INVALID-FIELD-TYPE", loadyaml, my_make_yaml(base + {"basePath": 2.0}),
            "invalid basePath field type");

        # Test OpenAPI 3.0 servers array parsing
        # servers array should set host and basePath from the first server URL
        {
            hash<auto> spec = {
                "openapi": "3.0.0",
                "info": {"title": "Servers Test", "version": "1.0"},
                "servers": (
                    {"url": "https://api.example.com:8080/v1/api"},
                ),
                "paths": {},
            };
            OpenApi3Schema so("", spec);
            assertEq("api.example.com:8080", so.host);
            assertEq("/v1/api", so.basePath);
        }

        # Test servers array with just a path (relative URL)
        {
            hash<auto> spec = {
                "openapi": "3.0.0",
                "info": {"title": "Servers Path Test", "version": "1.0"},
                "servers": (
                    {"url": "/api/v2"},
                ),
                "paths": {},
            };
            OpenApi3Schema so("", spec);
            assertEq("/api/v2", so.basePath);
        }

        # Test that trailing slash is removed from basePath
        {
            hash<auto> spec = {
                "openapi": "3.0.0",
                "info": {"title": "Trailing Slash Test", "version": "1.0"},
                "servers": (
                    {"url": "https://api.example.com/v1/"},
                ),
                "paths": {},
            };
            OpenApi3Schema so("", spec);
            assertEq("/v1", so.basePath);
        }

        # Test that explicit host/basePath are not overwritten by servers
        {
            hash<auto> spec = {
                "openapi": "3.0.0",
                "info": {"title": "Explicit Override Test", "version": "1.0"},
                "host": "explicit.example.com",
                "basePath": "/explicit",
                "servers": (
                    {"url": "https://api.example.com/v1"},
                ),
                "paths": {},
            };
            OpenApi3Schema so("", spec);
            # Explicit values should be preserved
            assertEq("explicit.example.com", so.host);
            assertEq("/explicit", so.basePath);
        }

        # Test multiple servers - only first one is used
        {
            hash<auto> spec = {
                "openapi": "3.0.0",
                "info": {"title": "Multiple Servers Test", "version": "1.0"},
                "servers": (
                    {"url": "https://prod.example.com/api"},
                    {"url": "https://staging.example.com/api"},
                ),
                "paths": {},
            };
            OpenApi3Schema so("", spec);
            assertEq("prod.example.com", so.host);
            assertEq("/api", so.basePath);
        }

        # Negative test: servers with invalid url type should be handled gracefully
        {
            hash<auto> spec = {
                "openapi": "3.0.0",
                "info": {"title": "Invalid Server URL Test", "version": "1.0"},
                "servers": (
                    {"url": 12345},  # Invalid URL type (integer instead of string)
                ),
                "paths": {},
            };
            # Should not throw - invalid URL type is silently ignored
            OpenApi3Schema so("", spec);
            assertNothing(so.host);
        }

        # Negative test: servers array with empty object
        {
            hash<auto> spec = {
                "openapi": "3.0.0",
                "info": {"title": "Empty Server Test", "version": "1.0"},
                "servers": (
                    {},  # Empty server object (missing url)
                ),
                "paths": {},
            };
            # Should not throw - missing URL is silently ignored
            OpenApi3Schema so("", spec);
            assertNothing(so.host);
        }

        assertTrue(loadyaml(my_make_yaml(base + {"consumes": ("test", "lalala")})));
        assertThrows("INVALID-FIELD-TYPE", loadyaml, my_make_yaml(base + {"consumes": "2.0"}),
            "invalid consumes field type");
        assertThrows("INVALID-FIELD-TYPE", loadyaml, my_make_yaml(base + {"consumes": (2, 5)}),
            "invalid consumes value type");

        assertTrue(loadyaml(my_make_yaml(base + {"produces": ("test", "lalala")})));
        assertThrows("INVALID-FIELD-TYPE", loadyaml, my_make_yaml(base + {"produces": "2.0"}),
            "invalid produces field type");
        assertThrows("INVALID-FIELD-TYPE", loadyaml, my_make_yaml(base + {"produces": (2, 5)}),
            "invalid produces value type");

        assertThrows("INVALID-FIELD-TYPE", loadyaml, my_make_yaml(base + {"components": {"schemas": 2}}),
            "invalid definitions field type");
        assertThrows("INVALID-FIELD-TYPE", "invalid definition datatype", loadyaml,
            my_make_yaml(base + {"components": {"schemas": {"a": 5}}}), "invalid definitions field value type");

        assertThrows("INVALID-FIELD-TYPE", loadyaml, my_make_yaml(base + {"components": {"parameters": 2}}),
            "invalid parameters field type");
        assertThrows("INVALID-FIELD-TYPE", "invalid parameter datatype", loadyaml,
            my_make_yaml(base + {"components": {"parameters": {"a": 5}}}), "invalid parameters field value type");

        assertThrows("INVALID-FIELD-TYPE", loadyaml, my_make_yaml(base + {"components": {"responses": 2}}),
            "invalid responses field type");
        assertThrows("INVALID-FIELD-TYPE", "invalid response datatype", loadyaml,
            my_make_yaml(base + {"components": {"responses": {"a": 5}}}), "invalid responses field value type");

        assertThrows("INVALID-FIELD-TYPE", loadyaml, my_make_yaml(base +
            {"components": base.components + {"securitySchemes": 2}}),
            "invalid securitySchemes field type");
        assertThrows("INVALID-FIELD-TYPE", "invalid security definition datatype", loadyaml,
            my_make_yaml(base + {"components": base.components + {"securitySchemes": {"a": 5}}}),
                "invalid securitySchemes field value type");

        assertThrows("INVALID-FIELD-TYPE", loadyaml, my_make_yaml(base + {"security": 2}),
            "invalid security field type");
        assertTrue(loadyaml(my_make_yaml(base + {"security": list()})));
        assertThrows("INVALID-FIELD-TYPE", "\"security\".*type \"integer\"", loadyaml,
            my_make_yaml(base + {"security": (2, 5)}), "invalid security field value type");
        assertThrows("INVALID-FIELD-TYPE", "\"security\".*\"integer\"", loadyaml,
            my_make_yaml(base + {"security": ({"a": "b"}, {"b": 2})}), "invalid security field value type");
        assertThrows("SECURITY-ERROR", "security schemes.*not defined", loadyaml,
            my_make_yaml(base + {"security": ({"a": "b"}, {"b": "a"})}), "invalid security values");

        assertThrows("INVALID-FIELD-TYPE", loadyaml, my_make_yaml(base + {"tags": 2}), "invalid tags field type");
        assertTrue(loadyaml(my_make_yaml(base + {"tags": list()})));
        assertThrows("INVALID-FIELD-TYPE", "invalid tag datatype", loadyaml,
            my_make_yaml(base + {"tags": (5, {})}), "invalid tags field value type");

        assertThrows("INVALID-FIELD-TYPE", loadyaml, my_make_yaml(base + {"externalDocs": 2}), "invalid externalDocs field type");

        {
            hash<auto> soh = ValidOpenApi3Schema + (
                "paths": (
                    "/test": (
                        "get": (
                            "operationId": "test",
                            "responses": (
                                "200": (
                                    "description": "test",
                                ),
                            ),
                            "parameters": ({
                                "in": "header",
                                "name": "Test-Header",
                                "schema": {
                                    "type": "string",
                                },
                                "required": True,
                                "default": "Test",
                            },),
                        ),
                    ),
                ),
            );
            OpenApi3Schema so("", soh);

            {
                string uri_path = "/test";
                hash<auto> hdr = {"Test-Header": "Test"};
                assertEq(Type::Hash, so.processRequest("get", uri_path, NOTHING, hdr).type());
                assertThrows("SCHEMA-VALIDATION-ERROR", \so.processRequest(), ("get", uri_path));
            }

            {
                string uri_path = "/test";
                hash hdr = ("Test-Header": 1);
                assertThrows("SCHEMA-VALIDATION-ERROR", \so.processRequest(), ("get", uri_path, NOTHING, hdr));
            }
        }

        {
            hash soh = ValidOpenApi3Schema + (
                "paths": (
                    "/test": (
                        "get": (
                            "operationId": "test",
                            "responses": (
                                "200": (
                                    "description": "test",
                                    "content": {
                                        "application/json": {
                                            "schema": {
                                                "type": "string"
                                            }
                                        }
                                    }
                                ),
                                "400": (
                                    "description": "test",
                                    "content": {
                                        "application/json": {
                                            "schema": {
                                                "type": "string"
                                            }
                                        }
                                    }
                                ),
                            ),
                            "parameters": ((
                                "in": "query",
                                "name": "bin",
                                "schema": {
                                    "type": "string",
                                    "format": "byte",
                                },
                            ),),
                        ),
                    ),
                ),
            );

            {
                OpenApi3Schema so("", soh);

                string uri_path = "/test?bin=YWJj";
                hash<RestRequestClientInfo> h = so.processRequest("get", uri_path);
                assertEq(Type::Hash, h.type());
                assertEq("/test?bin=YWJj", h.uri_path);

                hash<HttpResponseInfo> res = so.processResponse("get", "/test", 200, "OK", NOTHING, MimeTypeJson);
                assertEq(200, res.code);
                assertEq(MimeTypeJson, res.hdr."Content-Type");
                assertEq("\"OK\"", res.body);

                hash<RestResponseClientInfo> cres = so.parseResponse("get", "/test", res.code, res.body, res.hdr);
                assertEq(200, cres.code);
                assertEq(MimeTypeJson, cres.hdr."Content-Type");
                assertEq("OK", cres.body);
                #printf("cres: %N\n", cres);

                res = so.processResponse("get", "/test", 400, "ERR", NOTHING, MimeTypeJson);
                assertEq(400, res.code);
                assertEq(MimeTypeJson, res.hdr."Content-Type");
                assertEq("\"ERR\"", res.body);
                #printf("res: %N\n", res);

                cres = so.parseResponse("get", "/test", res.code, res.body, res.hdr);
                assertEq(400, cres.code);
                assertEq(MimeTypeJson, cres.hdr."Content-Type");
                assertEq("ERR", cres.body);
            }

            soh.components.schemas = {
                "robj": (
                    "type": "object",
                    "properties": (
                        "a": (
                            "type": "string",
                        ),
                        "b": (
                            "type": "integer",
                        ),
                        "c": {
                            "type": "integer",
                            "format": "unix-time",
                        },
                    ),
                ),
                "nobj": {
                    "type": "object",
                    "additionalProperties": True,
                },
                "pobj": {
                },
                "nullableobj": {
                    "type": "object",
                    "properties": {
                        "a": {
                            "type": "string",
                            "x-nullable": True,
                        },
                    },
                },
            };
            soh.paths."/test".get.responses."200".schema = {
                "$ref": "#/components/schemas/robj",
            };
            soh.paths."/test".get.responses."404" = {
                "description": "test",
                "schema": {
                    "$ref": "#/components/schemas/nobj",
                },
            };
            soh.paths."/test".get.responses."500" = {
                "description": "test",
                "schema": {
                    "$ref": "#/components/schemas/pobj",
                },
            };
            soh.paths."/test".get.responses."501" = {
                "description": "test",
                "schema": {
                    "$ref": "#/components/schemas/nullableobj",
                },
            };

            {
                OpenApi3Schema so("", soh);

                assertThrows("SCHEMA-VALIDATION-ERROR", \so.processResponse(), ("get", "/test", 200, "OK", NOTHING, MimeTypeJson));

                hash<auto> body = (
                    "a": "hi",
                    "b": 2,
                    "c": 2024-09-19T10:09:42,
                );
                hash<HttpResponseInfo> res = so.processResponse("get", "/test", 200, body, NOTHING, MimeTypeJson);
                assertEq(200, res.code);
                assertEq(MimeTypeJson, res.hdr."Content-Type");
                assertEq(Type::String, res.body.type());
%ifndef NoJson
                assertEq(body + {"c": body.c.getEpochSeconds()}, parse_json(res.body));
%endif

                hash<RestResponseClientInfo> cres = so.parseResponse("get", "/test", res."code", res.body, res.hdr);
                assertEq(200, cres.code);
                assertEq(MimeTypeJson, cres.hdr."Content-Type");
                assertEq(body, cres.body);
                #printf("cres: %N\n", cres);

                res = so.processResponse("get", "/test", 400, "ERR", NOTHING, MimeTypeJson);
                assertEq(400, res.code);
                assertEq(MimeTypeJson, res.hdr."Content-Type");
                assertEq("\"ERR\"", res.body);

                assertThrows("SCHEMA-VALIDATION-ERROR", \so.processResponse(), ("get", "/test", 200, ("x": 2),
                    NOTHING, MimeTypeJson));

                cres = so.parseResponse("get", "/test", res.code, res.body, res.hdr);
                assertEq(400, cres.code);
                assertEq(MimeTypeJson, cres.hdr."Content-Type");
                assertEq("ERR", cres.body);
                #printf("cres: %N\n", cres);

                res = so.processResponse("get", "/test", 404, {"a": 1}, NOTHING, MimeTypeJson);
                #printf("res: %N\n", res);
                assertEq(404, res.code);
                assertEq(MimeTypeJson, res.hdr."Content-Type");

                cres = so.parseResponse("get", "/test", res.code, res.body, res.hdr);
                #printf("cres: %N\n", cres);
                assertEq(404, cres.code);
                assertEq(MimeTypeJson, cres.hdr."Content-Type");
                assertEq({"a": 1}, cres.body);

                res = so.processResponse("get", "/test", 500, {"a": 1}, NOTHING, MimeTypeJson);
                #printf("res: %N\n", res);
                assertEq(500, res.code);
                assertEq(MimeTypeJson, res.hdr."Content-Type");

                cres = so.parseResponse("get", "/test", res.code, res.body, res.hdr);
                #printf("cres: %N\n", cres);
                assertEq(500, cres.code);
                assertEq(MimeTypeJson, cres.hdr."Content-Type");
                assertEq({"a": 1}, cres.body);

                res = so.processResponse("get", "/test", 500, 123, NOTHING, MimeTypeJson);
                #printf("res: %N\n", res);
                assertEq(500, res.code);
                assertEq(MimeTypeJson, res.hdr."Content-Type");

                cres = so.parseResponse("get", "/test", res.code, res.body, res.hdr);
                #printf("cres: %N\n", cres);
                assertEq(500, cres.code);
                assertEq(MimeTypeJson, cres.hdr."Content-Type");
                assertEq(123, cres.body);

                res = so.processResponse("get", "/test", 501, {"a": "abc"}, NOTHING, MimeTypeJson);
                #printf("res: %N\n", res);
                assertEq(501, res.code);
                assertEq(MimeTypeJson, res.hdr."Content-Type");

                cres = so.parseResponse("get", "/test", res.code, res.body, res.hdr);
                #printf("cres: %N\n", cres);
                assertEq(501, cres.code);
                assertEq(MimeTypeJson, cres.hdr."Content-Type");
                assertEq({"a": "abc"}, cres.body);

                res = so.processResponse("get", "/test", 501, {"a": NOTHING}, NOTHING, MimeTypeJson);
                #printf("res: %N\n", res);
                assertEq(501, res.code);
                assertEq(MimeTypeJson, res.hdr."Content-Type");

                cres = so.parseResponse("get", "/test", res.code, res.body, res.hdr);
                #printf("cres: %N\n", cres);
                assertEq(501, cres.code);
                assertEq(MimeTypeJson, cres.hdr."Content-Type");
                assertEq({"a": NOTHING}, cres.body);
            }
        }

        { # bug #2894 test that if schema is missing from response, then no body should be present for the response
          # also test that if schema is present and there is no response body, exception should be thrown
            hash soh = ValidOpenApi3Schema + (
                "paths": (
                    "/test": (
                        "get": (
                            "operationId": "test",
                            "responses": (
                                "200": (
                                    "description": "test",
                                    "schema": {
                                        "type": "string"
                                    }
                                ),
                                "400": (
                                    "description": "test",
                                ),
                            ),
                            "consumes": (
                                MimeTypeJson,
                                MimeTypeYaml,
                            ),
                            "produces": (
                                MimeTypeJson,
                                MimeTypeYaml,
                            ),
                        ),
                    ),
                ),
            );

            {
                OpenApi3Schema so("", soh);
                hash<HttpResponseInfo> res;
                hash<RestResponseClientInfo> cres;
                hash hdr = {"Content-Type" : "application/json"};

                code c = sub () { res = so.processResponse("get", "/test", 200, NOTHING, NOTHING, MimeTypeJson); };
                assertThrows("SCHEMA-VALIDATION-ERROR", "Param.*response body.*is null, but.*expected", c);

                c = sub () { cres = so.parseResponse("get", "/test", 200, NOTHING, hdr); };
                assertThrows("SCHEMA-VALIDATION-ERROR", "Param.*response body.*is null, but.*expected", c);

                c = sub () { res = so.processResponse("get", "/test", 400, "ERR", NOTHING, MimeTypeJson); };
                assertThrows("SCHEMA-VALIDATION-ERROR", "should not have any body", c);

                c = sub () { cres = so.parseResponse("get", "/test", 400, "\"ERR\"", hdr); };
                assertThrows("SCHEMA-VALIDATION-ERROR", "should not have any body", c);
            }
        }

        {
            hash<auto> soh = ValidOpenApi3Schema + (
                "paths": (
                    "/test": (
                        "get": (
                            "operationId": "test",
                            "parameters": (
                                {
                                    "name": "float",
                                    "in": "query",
                                    "description": "desc",
                                    "required": False,
                                    "schema": {
                                        "type": "number",
                                        "format": "float",
                                    },
                                },
                                {
                                    "name": "dt",
                                    "in": "query",
                                    "description": "desc",
                                    "required": False,
                                    "schema": {
                                        "type": "integer",
                                        "format": "unix-time",
                                    },
                                },
                            ),
                            "responses": (
                                "200": (
                                    "description": "test",
                                    "schema": {
                                        "type": "string"
                                    }
                                ),
                                "400": (
                                    "description": "test",
                                ),
                            ),
                            "consumes": (
                                MimeTypeJson,
                                MimeTypeYaml,
                            ),
                            "produces": (
                                MimeTypeJson,
                                MimeTypeYaml,
                            ),
                        ),
                    ),
                ),
            );

            {
                OpenApi3Schema so("", soh);
                string uri_path = "/test?float=1.1&dt=1726733382";
                # Use += to avoid type narrowing; parseRequest takes reference<hash<auto>>
                hash<auto> hdr += {"Test-Header": "Test"};
                hash<RestRequestServerInfo> req = so.parseRequest("GET", uri_path, NOTHING, \hdr);
                assertEq(Type::Float, req.query."float".type());
                assertEq(2024-09-19T10:09:42, req.query.dt);
            }

            {
                soh.paths."/test".get.parameters[0].format = "xxx";
                OpenApi3Schema so("", soh);
                assertTrue(True);
            }
        }

        {
            hash<auto> soh = ValidOpenApi3Schema + (
                "paths": (
                    "/cust/{id}": (
                        "get": (
                            "operationId": "get-customer",
                            "parameters": (
                                {
                                    "name": "id",
                                    "in": "path",
                                    "description": "customer ID",
                                    "required": True,
                                    "schema": {
                                        "type": "integer",
                                    },
                                },
                            ),
                            "responses": (
                                "200": (
                                    "description": "test",
                                    "schema": {
                                        "type": "string"
                                    }
                                ),
                                "400": (
                                    "description": "test",
                                ),
                            ),
                            "consumes": (
                                MimeTypeJson,
                                MimeTypeYaml,
                            ),
                            "produces": (
                                MimeTypeJson,
                                MimeTypeYaml,
                            ),
                        ),
                    ),
                ),
            );

            {
                OpenApi3Schema so("", soh);
                string uri_path = "/cust/1";
                hash<auto> hdr;
                hash<RestRequestServerInfo> req = so.parseRequest("GET", uri_path, NOTHING, \hdr);
                on_error printf("req: %y\n", req);
                assertEq(1, req.path_args.id);

                uri_path = "cust/1";
                req = so.parseRequest("GET", uri_path, NOTHING, \hdr);
                on_error printf("req: %y\n", req);
                assertEq(1, req.path_args.id);
            }
        }
    }

    testInfoObject() {
        checkModules();

        hash base = ValidOpenApi3Schema;
        hash info;

        assertThrows("REQUIRED-FIELD-MISSING", loadyaml, my_make_yaml(base + {"info": {}}));
        assertThrows("REQUIRED-FIELD-MISSING", "\"version\".*missing", loadyaml, my_make_yaml(base + {"info": {"title": "a"}}));
        assertThrows("REQUIRED-FIELD-MISSING", "\"title\".*missing", loadyaml, my_make_yaml(base + {"info": {"version": "a"}}));
        assertThrows("INVALID-FIELD-TYPE", "title", loadyaml, my_make_yaml(base + {"info": {"title": 5, "version": "a"}}));
        assertThrows("INVALID-FIELD-TYPE", "version", loadyaml, my_make_yaml(base + {"info": {"title": "a", "version": 1.0}}));
        loadyaml(my_make_yaml(base + {"info": {"title": "a", "version": "1.0.0"}}));
        loadyaml(my_make_yaml(base + {"info": {"title": "a", "version": "1.0"}}));

        info = ValidInfoObject + {"description": 5};
        assertThrows("INVALID-FIELD-TYPE", loadyaml, my_make_yaml(base + {"info": info}));
        info = ValidInfoObject + {"description": "lorem ipsum"};
        assertTrue(loadyaml(my_make_yaml(base + {"info": info})));

        info = ValidInfoObject + {"termsOfService": 5};
        assertThrows("INVALID-FIELD-TYPE", loadyaml, my_make_yaml(base + {"info": info}));
        info = ValidInfoObject + {"termsOfService": "lorem ipsum"};
        assertTrue(loadyaml(my_make_yaml(base + {"info": info})));

        info = ValidInfoObject + {"contact": 5};
        assertThrows("INVALID-FIELD-TYPE", loadyaml, my_make_yaml(base + {"info": info}));
        info = ValidInfoObject + {"license": 5};
        assertThrows("INVALID-FIELD-TYPE", loadyaml, my_make_yaml(base + {"info": info}));
    }

    testContactObject() {
        checkModules();

        hash base = ValidOpenApi3Schema;
        hash info;

        info = ValidInfoObject + {"contact": {}};
        assertTrue(loadyaml(my_make_yaml(base + {"info": info})));
        info = ValidInfoObject + {"contact": {"name": 5}};
        assertThrows("INVALID-FIELD-TYPE", "name", loadyaml, my_make_yaml(base + {"info": info}));
        info = ValidInfoObject + {"contact": {"url": 5}};
        assertThrows("INVALID-FIELD-TYPE", "url", loadyaml, my_make_yaml(base + {"info": info}));
        info = ValidInfoObject + {"contact": {"email": 5}};
        assertThrows("INVALID-FIELD-TYPE", "email", loadyaml, my_make_yaml(base + {"info": info}));
    }

    testLicenseObject() {
        checkModules();

        hash base = ValidOpenApi3Schema;
        hash info;

        info = ValidInfoObject + {"license": {"name": "name"}};
        assertTrue(loadyaml(my_make_yaml(base + {"info": info})));
        info = ValidInfoObject + {"license": {"url": "a"}};
        assertThrows("REQUIRED-FIELD-MISSING", "\"name\".*missing", loadyaml, my_make_yaml(base + {"info": info}));
        info = ValidInfoObject + {"license": {"name": 5}};
        assertThrows("INVALID-FIELD-TYPE", "name", loadyaml, my_make_yaml(base + {"info": info}));
        info = ValidInfoObject + {"license": {"name": "name", "url": "a"}};
        assertTrue(loadyaml(my_make_yaml(base + {"info": info})));
        info = ValidInfoObject + {"license": {"name": "a", "url": 5}};
        assertThrows("INVALID-FIELD-TYPE", "url", loadyaml, my_make_yaml(base + {"info": info}));
    }

    testPathsObject() {
        checkModules();

        hash base = ValidOpenApi3Schema;
        hash p;

        p = {};
        assertTrue(loadyaml(my_make_yaml(base + {"paths": p})));
        p = base.parameters + {"a": {}};
        assertThrows("INVALID-FIELD-FORMAT", loadyaml, my_make_yaml(base + {"paths": p}));
    }

    testPathItemObject() {
        checkModules();

        hash base = ValidOpenApi3Schema;
        hash p;

        p = {"/a": {}};
        assertTrue(loadyaml(my_make_yaml(base + {"paths": p})));

        # reference checks
        p = {"/a": {"$ref": "a"}};
        assertTrue(loadyaml(my_make_yaml(base + {"paths": p})));
        p = {"/a": {"$ref": 5}};
        assertThrows("INVALID-FIELD-TYPE", "ref", loadyaml, my_make_yaml(base + {"paths": p}));

        # operations checks
        p = {"/a": {"get": 5}};
        assertThrows("INVALID-FIELD-TYPE", "get", loadyaml, my_make_yaml(base + {"paths": p}));
        p = {"/a": {"put": 5}};
        assertThrows("INVALID-FIELD-TYPE", "put", loadyaml, my_make_yaml(base + {"paths": p}));
        p = {"/a": {"post": 5}};
        assertThrows("INVALID-FIELD-TYPE", "post", loadyaml, my_make_yaml(base + {"paths": p}));
        p = {"/a": {"delete": 5}};
        assertThrows("INVALID-FIELD-TYPE", "delete", loadyaml, my_make_yaml(base + {"paths": p}));
        p = {"/a": {"options": 5}};
        assertThrows("INVALID-FIELD-TYPE", "options", loadyaml, my_make_yaml(base + {"paths": p}));
        p = {"/a": {"head": 5}};
        assertThrows("INVALID-FIELD-TYPE", "head", loadyaml, my_make_yaml(base + {"paths": p}));
        p = {"/a": {"patch": 5}};
        assertThrows("INVALID-FIELD-TYPE", "patch", loadyaml, my_make_yaml(base + {"paths": p}));
        p = {"/a": {"get": 5}};
        assertThrows("INVALID-FIELD-TYPE", "get", loadyaml, my_make_yaml(base + {"paths": p}));

        # parameters checks
        p = {"/a": {"parameters": list()}};
        assertTrue(loadyaml(my_make_yaml(base + {"paths": p})));
        p = {"/a": {"parameters": ({"$ref": "#/components/parameters/a"}, {
            "name": "a",
            "in": "query",
            "schema": {"type": "string"},
        })}};
        assertTrue(loadyaml(my_make_yaml(base + {"paths": p})));
        p = {"/a": {"parameters": 5}};
        assertThrows("INVALID-FIELD-TYPE", "parameters", loadyaml, my_make_yaml(base + {"paths": p}));
    }

    testOperationObject() {
        checkModules();

        hash base = ValidOpenApi3Schema;
        hash r = {"200": {"description": "a"}};
        hash p;

        p = {"get": {"responses": r}};
        assertTrue(loadyaml(my_make_yaml(base + {"paths": {"/a": p}})));

        # tags checks
        p = {"get": {"responses": r, "tags": ("a", {"name": "a"})}};
        assertTrue(loadyaml(my_make_yaml(base + {"paths": {"/a": p}})));
        p = {"get": {"responses": r, "tags": 5}};
        assertThrows("INVALID-FIELD-TYPE", "tags", loadyaml, my_make_yaml(base + {"paths": {"/a": p}}));

        # summary checks
        p = {"get": {"responses": r, "summary": "a"}};
        assertTrue(loadyaml(my_make_yaml(base + {"paths": {"/a": p}})));
        p = {"get": {"responses": r, "summary": 5}};
        assertThrows("INVALID-FIELD-TYPE", "summary", loadyaml, my_make_yaml(base + {"paths": {"/a": p}}));

        # description checks
        p = {"get": {"responses": r, "description": "a"}};
        assertTrue(loadyaml(my_make_yaml(base + {"paths": {"/a": p}})));
        p = {"get": {"responses": r, "description": 5}};
        assertThrows("INVALID-FIELD-TYPE", "description", loadyaml, my_make_yaml(base + {"paths": {"/a": p}}));

        # deprecated checks
        p = {"get": {"responses": r, "deprecated": True}};
        assertTrue(loadyaml(my_make_yaml(base + {"paths": {"/a": p}})));
        p = {"get": {"responses": r, "deprecated": 5}};
        assertThrows("INVALID-FIELD-TYPE", "deprecated", loadyaml, my_make_yaml(base + {"paths": {"/a": p}}));

        # externalDocs checks
        p = {"get": {"responses": r, "externalDocs": {"url": "a"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"paths": {"/a": p}})));
        p = {"get": {"responses": r, "externalDocs": 5}};
        assertThrows("INVALID-FIELD-TYPE", "externalDocs", loadyaml, my_make_yaml(base + {"paths": {"/a": p}}));

        # operationId checks
        p = {"get": {"responses": r, "operationId": "a"}};
        assertTrue(loadyaml(my_make_yaml(base + {"paths": {"/a": p}})));
        p = {"get": {"responses": r, "operationId": 5}};
        assertThrows("INVALID-FIELD-TYPE", "operationId", loadyaml, my_make_yaml(base + {"paths": {"/a": p}}));

        # consumes checks
        p = {"get": {"responses": r, "consumes": ("a",)}};
        assertTrue(loadyaml(my_make_yaml(base + {"paths": {"/a": p}})));
        p = {"get": {"responses": r, "consumes": (5, 3)}};
        assertThrows("INVALID-FIELD-TYPE", "consumes.*list value", loadyaml, my_make_yaml(base + {"paths": {"/a": p}}));
        p = {"get": {"responses": r, "consumes": 5}};
        assertThrows("INVALID-FIELD-TYPE", "consumes", loadyaml, my_make_yaml(base + {"paths": {"/a": p}}));

        # produces checks
        p = {"get": {"responses": r, "produces": ("a",)}};
        assertTrue(loadyaml(my_make_yaml(base + {"paths": {"/a": p}})));
        p = {"get": {"responses": r, "produces": (5, 3)}};
        assertThrows("INVALID-FIELD-TYPE", "produces.*list value", loadyaml, my_make_yaml(base + {"paths": {"/a": p}}));
        p = {"get": {"responses": r, "produces": 5}};
        assertThrows("INVALID-FIELD-TYPE", "produces", loadyaml, my_make_yaml(base + {"paths": {"/a": p}}));

        # parameters checks
        p = {"get": {"responses": r, "parameters": ({"$ref": "#/components/parameters/a"},)}};
        assertTrue(loadyaml(my_make_yaml(base + {"paths": {"/a": p}})));
        p = {"get": {"responses": r, "parameters": 5}};
        assertThrows("INVALID-FIELD-TYPE", "parameters", loadyaml, my_make_yaml(base + {"paths": {"/a": p}}));

        # responses checks
        p = {"get": {"responses": 5}};
        assertThrows("INVALID-FIELD-TYPE", "responses", loadyaml, my_make_yaml(base + {"paths": {"/a": p}}));

        # security checks
        p = {"get": {"responses": r, "security": ({"a":("b",)},)}};
        assertTrue(loadyaml(my_make_yaml(base + {"paths": {"/a": p}})));
        p = {"get": {"responses": r, "security": 5}};
        assertThrows("INVALID-FIELD-TYPE", "security", loadyaml, my_make_yaml(base + {"paths": {"/a": p}}));
        p = {"get": {"responses": r, "security": (5,)}};
        assertThrows("INVALID-FIELD-TYPE", "security.*list value", loadyaml, my_make_yaml(base + {"paths": {"/a": p}}));
        p = {"get": {"responses": r, "security": ({"a":5},)}};
        assertThrows("INVALID-FIELD-TYPE", "value type", loadyaml, my_make_yaml(base + {"paths": {"/a": p}}));
        p = {"get": {"responses": r, "security": ({"a":(5,)},)}};
        assertThrows("INVALID-FIELD-TYPE", "value type", loadyaml, my_make_yaml(base + {"paths": {"/a": p}}));

        # check validation method
        hash<string, bool> mime_types();
        hash<UriQueryInfo> h({"method": "/create"});
        string filePath = get_script_dir() + DirSep + "Multipart.openapi3.yaml";
        OpenApi3Schema openapi3 = OpenApi3::OpenApi3Loader::fromFile(filePath);
        hash oh = OpenApi3Loader::parseSchemaContent(filePath, ReadOnlyFile::readTextFile(filePath));
        OperationObject op = new OperationObject("/create", "post", oh.paths."/create".post, openapi3);
        string body = "body";
        # Use += to avoid type narrowing; validateRequest takes reference<hash>
        hash<auto> headers += {"header": "header"};

        assertThrows("SCHEMA-VALIDATION-ERROR",
            'Parameter \"formData.upfile\".*expected type is \"string\"',
            sub() {op.validateRequest(False, new PathItemObject("/create", {}, openapi3), \h, \body, \headers,
                \mime_types); });
    }

    testExternalDocumentationObject() {
        checkModules();

        hash base = ValidOpenApi3Schema;
        hash extDocs;

        extDocs = {"externalDocs": {"url": "a"}};
        assertTrue(loadyaml(my_make_yaml(base + extDocs)));
        extDocs = {"externalDocs": {"description": "a"}};
        assertThrows("REQUIRED-FIELD-MISSING", "\"url\".*missing", loadyaml, my_make_yaml(base + extDocs));
        extDocs = {"externalDocs": {"url": 5}};
        assertThrows("INVALID-FIELD-TYPE", "url", loadyaml, my_make_yaml(base + extDocs));
        extDocs = {"externalDocs": {"url": "a", "description": "b"}};
        assertTrue(loadyaml(my_make_yaml(base + extDocs)));
        extDocs = {"externalDocs": {"url": "a", "description": 5}};
        assertThrows("INVALID-FIELD-TYPE", "description", loadyaml, my_make_yaml(base + extDocs));
    }

    testParameterObject() {
        checkModules();

        hash base = ValidOpenApi3Schema;
        hash p;

        # name and in checks
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "string"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"in": "query", "schema": {"type": "string"}}};
        assertThrows("REQUIRED-FIELD-MISSING", "\"name\".*missing", loadyaml,
            my_make_yaml(base + {"components": {"parameters": p}}));
        p = base.components.parameters + {"a": {"name": "a", "schema": {"type": "string"}}};
        assertThrows("REQUIRED-FIELD-MISSING", loadyaml, my_make_yaml(base + {"components": {"parameters": p}}));

        p = base.components.parameters + {"a": {"name": 5, "in": "query", "schema": {"type": "string"}}};
        assertThrows("INVALID-FIELD-TYPE", "name", loadyaml, my_make_yaml(base + {"components": {"parameters": p}}));
        p = base.components.parameters + {"a": {"name": "a", "in": 5, "schema": {"type": "string"}}};
        assertThrows("INVALID-FIELD-TYPE", "in", loadyaml, my_make_yaml(base + {"components": {"parameters": p}}));
        p = base.components.parameters + {"a": {"name": "a", "in": "a", "schema": {"type": "string"}}};
        assertThrows("INVALID-FIELD-VALUE", "in", loadyaml, my_make_yaml(base + {"components": {"parameters": p}}));

        # description checks
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "string"}, "description": 5}};
        assertThrows("INVALID-FIELD-TYPE", "description", loadyaml, my_make_yaml(base + {"components": {"parameters": p}}));

        # TODO - body location parameter - have to do SchemaObject first

        # in (location) checks
        p = base.components.parameters + {"a": {"name": "a", "in": "formData", "schema": {"type": "string"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "header", "schema": {"type": "string"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "string"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));

        # "required" checks
        p = base.components.parameters + {"a": {"name": "a", "in": "path", "schema": {"type": "string"},
            "required": False}};
        assertThrows("INVALID-PARAMETER", loadyaml, (my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "path", "schema": {"type": "string"}}};
        assertThrows("REQUIRED-FIELD-MISSING", "\"required\".*missing", loadyaml,
            my_make_yaml(base + {"components": {"parameters": p}}));
        p = base.components.parameters + {"a": {"name": "a", "in": "path", "schema": {"type": "string"}, "required": "a"}};
        assertThrows("INVALID-FIELD-TYPE", "required", loadyaml,
            my_make_yaml(base + {"components": {"parameters": p}}));

        # type checks
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": 5}}};
        assertThrows("INVALID-FIELD-TYPE", "\"type\"", loadyaml,
            my_make_yaml(base + {"components": {"parameters": p}}));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "a"}}};
        assertThrows("INVALID-FIELD-VALUE", loadyaml, my_make_yaml(base + {"components": {"parameters": p}}));

        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "array",
            "items": {"type": "string"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "boolean"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "integer"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "number"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "string"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "integer",
            "format": "unix-time"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));

        # format checks
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "string", "format": 5}}};
        assertThrows("INVALID-FIELD-TYPE", loadyaml, my_make_yaml(base + {"components": {"parameters": p}}));

        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "integer", "format": "int32"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "integer", "format": "int64"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "integer", "format": "a"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));

        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "number", "format": "double"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "number", "format": "float"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "number", "format": "a"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));

        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "string", "format": "binary"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "string", "format": "byte"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "string", "format": "date"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "string", "format": "date-time"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "string", "format": "password"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "string", "format": "a"}}};
        # issue 4203: ignore unknown string format
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));

        # allowEmptyValue checks
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "string"}, "allowEmptyValue": 5}};
        assertThrows("INVALID-FIELD-TYPE", "allowEmptyValue", loadyaml, my_make_yaml(base + {"components": {"parameters": p}}));

        # collectionFormat checks
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "style": "form", "explode": False,
            "schema": {"type": "array", "items": {"type": "string"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "style": "spaceDelimited",
            "schema": {"type": "array", "items": {"type": "string"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "style": "pipeDelimited",
            "schema": {"type": "array", "items": {"type": "string"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "style": "form",
            "schema": {"type": "array", "explode": True, "items": {"type": "string"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));

        p = base.components.parameters + {"a": {"name": "a", "in": "query", "style": 5,
            "schema": {"type": "array", "items": {"type": "string"}}}};
        assertThrows("INVALID-FIELD-TYPE", "style", loadyaml, my_make_yaml(base + {"components": {"parameters": p}}));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "style": "a",
            "schema": {"type": "array", "items": {"type": "string"}}}};
        assertThrows("INVALID-STYLE", loadyaml, my_make_yaml(base + {"components": {"parameters": p}}));
        p = base.components.parameters + {"a": {"name": "a", "in": "header", "style": "form",
            "schema": {"type": "array", "explode": True, "items": {"type": "string"}}}};
        assertThrows("INVALID-STYLE", loadyaml, my_make_yaml(base + {"components": {"parameters": p}}));

        # default checks

        p = base.components.parameters + {"a": {"name": "a", "in": "formData", "schema": {"type": "string"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));

        # TODO
        /*
        p = base.parameters + {"a": {"name": "a", "in": "query", "type": "array", "items": {"type": "string"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"parameters": p})));
        p = base.parameters + {"a": {"name": "a", "in": "query", "type": "array", "items": {"type": "string"}, "default": 5}};
        assertThrows("INVALID-FIELD-TYPE", "default", loadyaml, my_make_yaml(base + {"parameters": p}));
        */

        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "boolean", "default": "true"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "boolean", "default": 5}}};
        assertThrows("INVALID-FIELD-TYPE", "default", loadyaml, my_make_yaml(base + {"components": {"parameters": p}}));

        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "file"}}};
        assertThrows("INVALID-FIELD-VALUE", "invalid .* type", loadyaml, my_make_yaml(base + {"components": {"parameters": p}}));

        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "integer", "default": 5}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "integer", "default": "a"}}};
        assertThrows("INVALID-FIELD-TYPE", "default", loadyaml, my_make_yaml(base + {"components": {"parameters": p}}));

        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "number", "default": 2.0}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "number", "default": "a"}}};
        assertThrows("INVALID-FIELD-TYPE", "default", loadyaml, my_make_yaml(base + {"components": {"parameters": p}}));

        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "string", "default": "a"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = base.components.parameters + {"a": {"name": "a", "in": "query", "schema": {"type": "string", "default": 5}}};
        assertThrows("INVALID-FIELD-TYPE", "default", loadyaml, my_make_yaml(base + {"components": {"parameters": p}}));
    }

    testItemsObject() {
        checkModules();

        # OpenAPI 3.0 base schema without parameter references in paths
        hash base = {
            "openapi": "3.0",
            "info": ValidInfoObject,
            "paths": {},
        };
        # OpenAPI 3.0 style: schema with type array
        hash schemaBase = {"type": "array"};
        hash p;

        # type checks - items with empty object defaults to type "object"
        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        # items with invalid type (integer instead of string)
        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": 5}}}};
        assertThrows("INVALID-FIELD-TYPE", "\"type\"", loadyaml, my_make_yaml(base + {"components": {"parameters": p}}));
        # items with invalid type value
        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "a"}}}};
        assertThrows("INVALID-FIELD-VALUE", loadyaml, my_make_yaml(base + {"components": {"parameters": p}}));

        # valid item types
        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "boolean"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "integer"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "number"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "string"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));

        # format checks
        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "string", "format": 5}}}};
        assertThrows("INVALID-FIELD-TYPE", loadyaml, my_make_yaml(base + {"components": {"parameters": p}}));

        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "integer", "format": "int32"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "integer", "format": "int64"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "integer", "format": "a"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));

        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "number", "format": "double"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "number", "format": "float"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "number", "format": "a"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));

        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "string", "format": "binary"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "string", "format": "byte"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "string", "format": "date"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "string", "format": "date-time"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "string", "format": "password"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "string", "format": "a"}}}};
        # issue 4203: ignore unknown string format
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));

        # default checks
        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "boolean", "default": True}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "boolean", "default": 5}}}};
        assertThrows("INVALID-FIELD-TYPE", "default", loadyaml, my_make_yaml(base + {"components": {"parameters": p}}));

        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "integer", "default": 5}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "integer", "default": "a"}}}};
        assertThrows("INVALID-FIELD-TYPE", "default", loadyaml, my_make_yaml(base + {"components": {"parameters": p}}));

        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "number", "default": 2.0}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "number", "default": "a"}}}};
        assertThrows("INVALID-FIELD-TYPE", "default", loadyaml, my_make_yaml(base + {"components": {"parameters": p}}));

        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "string", "default": "a"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"parameters": p}})));
        p = {"a": {"name": "a", "in": "query", "schema": schemaBase + {"items": {"type": "string", "default": 5}}}};
        assertThrows("INVALID-FIELD-TYPE", "default", loadyaml, my_make_yaml(base + {"components": {"parameters": p}}));
    }

    testResponsesObject() {
        checkModules();

        hash base = ValidOpenApi3Schema;
        hash p;

        p = {"get": {"responses": {"200": {"description": "a"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"paths": {"/a": p}})));
        p = {"get": {"responses": {"default": {"description": "a"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"paths": {"/a": p}})));

        p = {"get": {"responses": {"200": 5}}};
        assertThrows("INVALID-FIELD-TYPE", "response.*invalid type", loadyaml, my_make_yaml(base + {"paths": {"/a": p}}));
        p = {"get": {"responses": {"default": 5}}};
        assertThrows("INVALID-FIELD-TYPE", "default.*invalid type", loadyaml, my_make_yaml(base + {"paths": {"/a": p}}));
    }

    testResponseObject() {
        checkModules();

        # OpenAPI 3.0 base schema without parameter references
        hash base = {
            "openapi": "3.0",
            "info": ValidInfoObject,
            "paths": {},
        };
        hash r;

        # Test responses in components.responses
        r = {"a": {}};
        assertThrows("REQUIRED-FIELD-MISSING", "\"description\".*missing", loadyaml, my_make_yaml(base + {"components": {"responses": r}}));
        r = {"a": {"description": "a"}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));
        r = {"a": {"description": 5}};
        assertThrows("INVALID-FIELD-TYPE", "description", loadyaml, my_make_yaml(base + {"components": {"responses": r}}));

        r = {"a": {"description": "a", "schema": 5}};
        assertThrows("INVALID-FIELD-TYPE", "schema", loadyaml, my_make_yaml(base + {"components": {"responses": r}}));
        r = {"a": {"description": "a", "headers": 5}};
        assertThrows("INVALID-FIELD-TYPE", "headers", loadyaml, my_make_yaml(base + {"components": {"responses": r}}));
        r = {"a": {"description": "a", "examples": 5}};
        assertThrows("INVALID-FIELD-TYPE", "examples", loadyaml, my_make_yaml(base + {"components": {"responses": r}}));

        # Test OpenAPI 3.0 content-style response with empty schema object {} (means "any type")
        # This tests the fix for handling falsy but valid empty schema objects
        {
            hash<auto> spec = {
                "openapi": "3.0.0",
                "info": {"title": "Empty Schema Test", "version": "1.0"},
                "paths": {
                    "/test": {
                        "get": {
                            "operationId": "testEmptySchema",
                            "responses": {
                                "200": {
                                    "description": "Success with any response body",
                                    "content": {
                                        "application/json": {
                                            "schema": {},  # Empty schema means "any type"
                                        },
                                    },
                                },
                            },
                        },
                    },
                },
            };
            OpenApi3Schema so("", spec);

            # Verify the response was parsed correctly
            OpenApi3::PathItemObject pio = so.paths.match("/test");
            OpenApi3::OperationObject op = pio.getOperation("get", "/test");
            assertTrue(exists op.responses);

            # Get the 200 response and verify schema exists (even though empty)
            *OpenApi3::ResponseObject resp = op.responses.responses."200";
            assertTrue(exists resp);
            # The schema should exist because we used "exists" check
            assertTrue(exists resp.schema);
        }

        # Test that response without schema in content works (no schema key at all)
        {
            hash<auto> spec = {
                "openapi": "3.0.0",
                "info": {"title": "No Schema Test", "version": "1.0"},
                "paths": {
                    "/test": {
                        "get": {
                            "operationId": "testNoSchema",
                            "responses": {
                                "204": {
                                    "description": "No content response",
                                    "content": {
                                        "application/json": {},  # No schema key
                                    },
                                },
                            },
                        },
                    },
                },
            };
            OpenApi3Schema so("", spec);

            OpenApi3::PathItemObject pio = so.paths.match("/test");
            OpenApi3::OperationObject op = pio.getOperation("get", "/test");
            *OpenApi3::ResponseObject resp = op.responses.responses."204";
            assertTrue(exists resp);
            # Schema should NOT exist when the schema key is completely absent
            assertFalse(exists resp.schema);
        }

        # Negative test: schema with invalid type should still throw error
        {
            hash<auto> spec = {
                "openapi": "3.0.0",
                "info": {"title": "Invalid Schema Test", "version": "1.0"},
                "paths": {
                    "/test": {
                        "get": {
                            "operationId": "testInvalidSchema",
                            "responses": {
                                "200": {
                                    "description": "Response with invalid schema type",
                                    "content": {
                                        "application/json": {
                                            "schema": {"type": "invalid_type"},
                                        },
                                    },
                                },
                            },
                        },
                    },
                },
            };
            assertThrows("INVALID-FIELD-VALUE", "invalid_type",
                sub () { new OpenApi3Schema("", spec); });
        }
    }

    testHeaderObject() {
        checkModules();

        hash base = {"openapi": "3.0", "info": ValidInfoObject, "paths": {}};
        hash r;

        # Empty headers object should be valid
        r = {"a": {"description": "a", "headers": {}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));

        # Headers in OpenAPI 3.0 require either schema or content
        r = {"a": {"description": "a", "headers": {"a": {}}}};
        assertThrows("INVALID-PARAMETER", "schema.*content", loadyaml, my_make_yaml(base + {"components": {"responses": r}}));

        # type checks - using schema object
        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "boolean"}}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));
        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "integer"}}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));
        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "number"}}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));
        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "string"}}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));
        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "array", "items": {"type": "string"}}}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));

        # invalid schema type
        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": 5}}}}};
        assertThrows("INVALID-FIELD-TYPE", "type", loadyaml, my_make_yaml(base + {"components": {"responses": r}}));
        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "invalid"}}}}};
        assertThrows("INVALID-FIELD-VALUE", loadyaml, my_make_yaml(base + {"components": {"responses": r}}));

        # invalid items
        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "array", "items": 5}}}}};
        assertThrows("INVALID-FIELD-TYPE", "items", loadyaml, my_make_yaml(base + {"components": {"responses": r}}));

        # format checks
        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "string", "format": 5}}}}};
        assertThrows("INVALID-FIELD-TYPE", loadyaml, my_make_yaml(base + {"components": {"responses": r}}));

        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "integer", "format": "int32"}}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));
        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "integer", "format": "int64"}}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));
        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "integer", "format": "a"}}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));

        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "number", "format": "double"}}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));
        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "number", "format": "float"}}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));
        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "number", "format": "a"}}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));

        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "string", "format": "binary"}}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));
        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "string", "format": "byte"}}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));
        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "string", "format": "date"}}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));
        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "string", "format": "date-time"}}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));
        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "string", "format": "password"}}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));
        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "string", "format": "a"}}}}};
        # issue 4203: ignore unknown string format
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));

        # style checks (replaces collectionFormat in OpenAPI 3.0)
        r = {"a": {"description": "a", "headers": {"a": {"style": "simple", "schema": {"type": "array", "items": {"type": "string"}}}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));

        r = {"a": {"description": "a", "headers": {"a": {"style": 5, "schema": {"type": "array", "items": {"type": "string"}}}}}};
        assertThrows("INVALID-FIELD-TYPE", "style", loadyaml, my_make_yaml(base + {"components": {"responses": r}}));

        # default checks - defaults go in schema object in OpenAPI 3.0
        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "boolean", "default": True}}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));
        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "boolean", "default": 5}}}}};
        assertThrows("INVALID-FIELD-TYPE", "default", loadyaml, my_make_yaml(base + {"components": {"responses": r}}));

        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "integer", "default": 5}}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));
        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "integer", "default": "a"}}}}};
        assertThrows("INVALID-FIELD-TYPE", "default", loadyaml, my_make_yaml(base + {"components": {"responses": r}}));

        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "number", "default": 2.0}}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));
        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "number", "default": "a"}}}}};
        assertThrows("INVALID-FIELD-TYPE", "default", loadyaml, my_make_yaml(base + {"components": {"responses": r}}));

        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "string", "default": "a"}}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"responses": r}})));
        r = {"a": {"description": "a", "headers": {"a": {"schema": {"type": "string", "default": 5}}}}};
        assertThrows("INVALID-FIELD-TYPE", "default", loadyaml, my_make_yaml(base + {"components": {"responses": r}}));
    }

    testTagObject() {
        checkModules();

        hash base = ValidOpenApi3Schema;
        hash tag;

        tag = {"name": "a"};
        assertTrue(loadyaml(my_make_yaml(base + {"tags": (tag,)})));
        tag = {};
        assertThrows("REQUIRED-FIELD-MISSING", "\"name\".*missing", loadyaml, my_make_yaml(base + {"tags": (tag,)}));
        tag = {"name": 5};
        assertThrows("INVALID-FIELD-TYPE", "name", loadyaml, my_make_yaml(base + {"tags": (tag,)}));

        tag = {"name": "a", "description": "a"};
        assertTrue(loadyaml(my_make_yaml(base + {"tags": (tag,)})));
        tag = {"name": "a", "description": 5};
        assertThrows("INVALID-FIELD-TYPE", "description", loadyaml, my_make_yaml(base + {"tags": (tag,)}));

        tag = {"name": "a", "externalDocs": 5};
        assertThrows("INVALID-FIELD-TYPE", "externalDocs", loadyaml, my_make_yaml(base + {"tags": (tag,)}));
    }

    testSchemaObject() {
        checkModules();

        hash base = {"openapi": "3.0", "info": ValidInfoObject, "paths": {}};
        hash s;

        # ref checks
        s = {"$ref": "#/components/schemas/x"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"x": ("type": "string"), "a": s}}})));
        s = {"$ref": 5};
        assertThrows("INVALID-FIELD-TYPE", "ref.*invalid type", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        s = {"$ref": "#/components/schemas/y"};
        assertThrows("INVALID-REFERENCE", "cannot resolve", loadyaml, my_make_yaml(base + {"components": {"schemas": {"x": ("type": "string"), "a": s}}}));
        # issue #3843: sibling elements to a $ref must be ignored
        s = {"$ref": "#/components/schemas/x", "a": 1};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"x": ("type": "string"), "a": s}}})));

        # type checks
        s = {};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": 5};
        assertThrows("INVALID-FIELD-TYPE", "\"type\"", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"type": "a"};
        assertThrows("INVALID-FIELD-VALUE", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        # TODO array of array
        /*p = base.parameters + {"a": {"name":"a", "in": "query", "type": "array", "items": {"type": "string"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));*/
        s = {"type": "boolean"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "integer"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "number"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));

        # format checks
        s = {"type": "string", "format": 5};
        assertThrows("INVALID-FIELD-TYPE", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        s = {"type": "integer", "format": "int32"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "integer", "format": "int64"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "integer", "format": "a"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));

        s = {"type": "number", "format": "double"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "number", "format": "float"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "number", "format": "a"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));

        s = {"type": "string", "format": "binary"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "format": "byte"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "format": "date"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "format": "date-time"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "format": "password"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "format": "a"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));

        # title checks
        s = {"type": "string", "title": "a"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "title": 5};
        assertThrows("INVALID-FIELD-TYPE", "title", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        # description checks
        s = {"type": "string", "description": "a"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "description": 5};
        assertThrows("INVALID-FIELD-TYPE", "description", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        # items checks

        # default checks
        # TODO arrays
        /*p = {"type": "array", "items": {"type": "string"}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        p = {"type": "array", "items": {"type": "string"}, "default": 5};
        assertThrows("INVALID-FIELD-TYPE", "default", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));*/

        s = {"type": "boolean", "default": True};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "boolean", "default": 5};
        assertThrows("INVALID-FIELD-TYPE", "default", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        # TODO files
        /*p = {"type": "file"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        p = {"type": "file"};
        assertThrows("INVALID-FIELD-TYPE", "default", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));*/

        s = {"type": "integer", "default": 5};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "integer", "default": "a"};
        assertThrows("INVALID-FIELD-TYPE", "default", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        s = {"type": "number", "default": 2.0};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "number", "default": "a"};
        assertThrows("INVALID-FIELD-TYPE", "default", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        s = {"type": "string", "default": "a"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "default": 5};
        assertThrows("INVALID-FIELD-TYPE", "default", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        # maxProperties checks
        s = {"type": "object", "maxProperties": 0};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "object", "maxProperties": 5};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "object", "maxProperties": -2};
        assertThrows("INVALID-FIELD-FORMAT", "maxProperties", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"type": "object", "maxProperties": "a"};
        assertThrows("INVALID-FIELD-TYPE", "maxProperties", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        s = {"type": "string", "maxProperties": 0};
        assertThrows("INVALID-FIELD-FORMAT", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"type": "string", "maxProperties": 5};
        assertThrows("INVALID-FIELD-FORMAT", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"type": "string", "maxProperties": -2};
        assertThrows("INVALID-FIELD-FORMAT", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"type": "string", "maxProperties": "a"};
        assertThrows("INVALID-FIELD-TYPE", "maxProperties", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        # minProperties checks
        s = {"type": "object", "minProperties": 0};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "object", "minProperties": 5};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "object", "minProperties": -2};
        assertThrows("INVALID-FIELD-FORMAT", "minProperties", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"type": "object", "minProperties": "a"};
        assertThrows("INVALID-FIELD-TYPE", "minProperties", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        s = {"type": "string", "minProperties": 0};
        assertThrows("INVALID-FIELD-FORMAT", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"type": "string", "minProperties": 5};
        assertThrows("INVALID-FIELD-FORMAT", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"type": "string", "minProperties": -2};
        assertThrows("INVALID-FIELD-FORMAT", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"type": "string", "minProperties": "a"};
        assertThrows("INVALID-FIELD-TYPE", "minProperties", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        # properties checks
        s = {"type": "object", "properties": {}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "object", "properties": {"a": {"type": "string"}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "object", "properties": {"a": 5}};
        assertThrows("INVALID-FIELD-FORMAT", "properties", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"type": "object", "properties": 5};
        assertThrows("INVALID-FIELD-TYPE", "properties", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        s = {"type": "string", "properties": {}};
        assertThrows("INVALID-FIELD-FORMAT", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"type": "string", "properties": {"a": {"type": "string"}}};
        assertThrows("INVALID-FIELD-FORMAT", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"type": "string", "properties": {"a": 5}};
        assertThrows("INVALID-FIELD-FORMAT", "properties", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"type": "string", "properties": 5};
        assertThrows("INVALID-FIELD-TYPE", "properties", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        # additionalProperties checks
        s = {"type": "object", "additionalProperties": True};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "object", "additionalProperties": {"type": "string"}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "object", "additionalProperties": "a"};
        assertThrows("INVALID-FIELD-TYPE", "additionalProperties", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        s = {"type": "string", "additionalProperties": True};
        assertThrows("INVALID-FIELD-FORMAT", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"type": "string", "additionalProperties": {"type": "string"}};
        assertThrows("INVALID-FIELD-FORMAT", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"type": "string", "additionalProperties": "a"};
        assertThrows("INVALID-FIELD-TYPE", "additionalProperties", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        # "required" checks
        s = {"type": "object", "properties": {"a": {"type": "string"}}, "required": ("a",)};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "required": ()};
        assertThrows("INVALID-FIELD-FORMAT", "required", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"type": "string", "required": (5, 3)};
        assertThrows("INVALID-FIELD-TYPE", "required", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"type": "string", "required": 5};
        assertThrows("INVALID-FIELD-TYPE", "required", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        # discriminator checks
        s = {"type": "object", "properties": {"a": {"type": "string"}, "b": {}}, "discriminator": "a", "required": ("a", "b")};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "object", "properties": {"a": {"type": "string"}, "b": {}}, "discriminator": "x", "required": ("a", "b")};
        assertThrows("INVALID-FIELD-VALUE", "discriminator", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"type": "string", "discriminator": 5};
        assertThrows("INVALID-FIELD-TYPE", "discriminator", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        # readOnly checks
        s = {"type": "string", "readOnly": False};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "readOnly": True};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "readOnly": 5};
        assertThrows("INVALID-FIELD-TYPE", "readOnly", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        # allOf Checks
        s = {"type": "string", "allOf": ({"$ref": "#/components/schemas/x"}, {"type": "string"})};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"x": ("type": "string"), "a": s}}})));
        s = {"type": "string", "allOf": list()};
        assertThrows("INVALID-FIELD-FORMAT", "allOf", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"type": "string", "allOf": (5, 3)};
        assertThrows("INVALID-FIELD-TYPE", "allOf", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"type": "string", "allOf": 5};
        assertThrows("INVALID-FIELD-TYPE", "allOf", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        # oneOf Checks
        s = {"oneOf": ({"type": "string"}, {"type": "integer"})};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"oneOf": ({"$ref": "#/components/schemas/x"}, {"type": "integer"})};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"x": ("type": "string"), "a": s}}})));
        s = {"oneOf": list()};
        assertThrows("INVALID-FIELD-FORMAT", "oneOf", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"oneOf": (5, 3)};
        assertThrows("INVALID-FIELD-TYPE", "oneOf", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"oneOf": 5};
        assertThrows("INVALID-FIELD-TYPE", "oneOf", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        # anyOf Checks
        s = {"anyOf": ({"type": "string"}, {"type": "integer"})};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"anyOf": ({"$ref": "#/components/schemas/x"}, {"type": "integer"})};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"x": ("type": "string"), "a": s}}})));
        s = {"anyOf": list()};
        assertThrows("INVALID-FIELD-FORMAT", "anyOf", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"anyOf": (5, 3)};
        assertThrows("INVALID-FIELD-TYPE", "anyOf", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
        s = {"anyOf": 5};
        assertThrows("INVALID-FIELD-TYPE", "anyOf", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        # not Checks
        s = {"not": {"type": "string"}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"not": {"$ref": "#/components/schemas/x"}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"x": ("type": "string"), "a": s}}})));
        s = {"not": 5};
        assertThrows("INVALID-FIELD-TYPE", "not", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        # writeOnly checks
        s = {"type": "string", "writeOnly": False};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "writeOnly": True};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "writeOnly": 5};
        assertThrows("INVALID-FIELD-TYPE", "writeOnly", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        # deprecated checks (stored as deprec since deprecated is a Qore keyword)
        s = {"type": "string", "deprecated": False};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "deprecated": True};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "deprecated": 5};
        assertThrows("INVALID-FIELD-TYPE", "deprecated", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        # xml checks
        s = {"type": "string", "xml": {"name": "a"}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "xml": 5};
        assertThrows("INVALID-FIELD-TYPE", "xml", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        # externalDocs checks
        s = {"type": "string", "externalDocs": {"url": "a"}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "externalDocs": 5};
        assertThrows("INVALID-FIELD-TYPE", "externalDocs", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
    }

    testSchemaCompositionValidation() {
        checkModules();

        hash hdr = {"content-type": MimeTypeJson};

        # Test allOf - value must match all schemas
        {
            hash spec = {
                "openapi": "3.0.0",
                "info": {"title": "AllOf Test", "version": "1.0"},
                "paths": {
                    "/test": {
                        "post": {
                            "operationId": "testAllOf",
                            "requestBody": {
                                "required": True,
                                "content": {
                                    "application/json": {
                                        "schema": {
                                            "allOf": (
                                                {
                                                    "type": "object",
                                                    "properties": {"name": {"type": "string"}},
                                                    "required": ("name",),
                                                },
                                                {
                                                    "type": "object",
                                                    "properties": {"age": {"type": "integer"}},
                                                    "required": ("age",),
                                                },
                                            ),
                                        },
                                    },
                                },
                            },
                            "responses": {"200": {"description": "Success"}},
                        },
                    },
                },
            };
            OpenApi3Schema so("", spec);

            # Valid: has both required properties from both schemas
            hash body = {"name": "John", "age": 30};
            hash<RestRequestClientInfo> req = so.processRequest("POST", "/test", body, hdr);
            assertEq("/test", req.uri_path);

            # Invalid: missing age (required by second schema)
            body = {"name": "John"};
            assertThrows("SCHEMA-VALIDATION-ERROR", "missing.*age", \so.processRequest(), ("POST", "/test", body, hdr));

            # Invalid: missing name (required by first schema)
            body = {"age": 30};
            assertThrows("SCHEMA-VALIDATION-ERROR", "missing.*name", \so.processRequest(), ("POST", "/test", body, hdr));
        }

        # Test oneOf - value must match exactly one schema
        {
            hash spec = {
                "openapi": "3.0.0",
                "info": {"title": "OneOf Test", "version": "1.0"},
                "paths": {
                    "/test": {
                        "post": {
                            "operationId": "testOneOf",
                            "requestBody": {
                                "required": True,
                                "content": {
                                    "application/json": {
                                        "schema": {
                                            "oneOf": (
                                                {
                                                    "type": "object",
                                                    "properties": {
                                                        "petType": {"type": "string"},
                                                        "bark": {"type": "boolean"},
                                                    },
                                                    "required": ("petType", "bark"),
                                                },
                                                {
                                                    "type": "object",
                                                    "properties": {
                                                        "petType": {"type": "string"},
                                                        "meow": {"type": "boolean"},
                                                    },
                                                    "required": ("petType", "meow"),
                                                },
                                            ),
                                        },
                                    },
                                },
                            },
                            "responses": {"200": {"description": "Success"}},
                        },
                    },
                },
            };
            OpenApi3Schema so("", spec);

            # Valid: matches first schema (dog)
            hash body = {"petType": "dog", "bark": True};
            hash<RestRequestClientInfo> req = so.processRequest("POST", "/test", body, hdr);
            assertEq("/test", req.uri_path);

            # Valid: matches second schema (cat)
            body = {"petType": "cat", "meow": True};
            req = so.processRequest("POST", "/test", body, hdr);
            assertEq("/test", req.uri_path);

            # Invalid: matches neither schema (missing required fields)
            body = {"petType": "bird"};
            assertThrows("SCHEMA-VALIDATION-ERROR", "does not match any.*oneOf", \so.processRequest(),
                ("POST", "/test", body, hdr));

            # Invalid: matches both schemas
            body = {"petType": "hybrid", "bark": True, "meow": True};
            assertThrows("SCHEMA-VALIDATION-ERROR", "matches multiple oneOf", \so.processRequest(),
                ("POST", "/test", body, hdr));
        }

        # Test anyOf - value must match at least one schema
        {
            hash spec = {
                "openapi": "3.0.0",
                "info": {"title": "AnyOf Test", "version": "1.0"},
                "paths": {
                    "/test": {
                        "post": {
                            "operationId": "testAnyOf",
                            "requestBody": {
                                "required": True,
                                "content": {
                                    "application/json": {
                                        "schema": {
                                            "anyOf": (
                                                {
                                                    "type": "object",
                                                    "properties": {"name": {"type": "string"}},
                                                    "required": ("name",),
                                                },
                                                {
                                                    "type": "object",
                                                    "properties": {"id": {"type": "integer"}},
                                                    "required": ("id",),
                                                },
                                            ),
                                        },
                                    },
                                },
                            },
                            "responses": {"200": {"description": "Success"}},
                        },
                    },
                },
            };
            OpenApi3Schema so("", spec);

            # Valid: matches first schema
            hash body = {"name": "John"};
            hash<RestRequestClientInfo> req = so.processRequest("POST", "/test", body, hdr);
            assertEq("/test", req.uri_path);

            # Valid: matches second schema
            body = {"id": 123};
            req = so.processRequest("POST", "/test", body, hdr);
            assertEq("/test", req.uri_path);

            # Valid: matches both schemas (allowed for anyOf)
            body = {"name": "John", "id": 123};
            req = so.processRequest("POST", "/test", body, hdr);
            assertEq("/test", req.uri_path);

            # Invalid: matches neither schema
            body = {"other": "value"};
            assertThrows("SCHEMA-VALIDATION-ERROR", "does not match any.*anyOf", \so.processRequest(),
                ("POST", "/test", body, hdr));
        }

        # Test not - value must NOT match the schema
        {
            hash spec = {
                "openapi": "3.0.0",
                "info": {"title": "Not Test", "version": "1.0"},
                "paths": {
                    "/test": {
                        "post": {
                            "operationId": "testNot",
                            "requestBody": {
                                "required": True,
                                "content": {
                                    "application/json": {
                                        "schema": {
                                            "type": "object",
                                            "properties": {"value": {"type": "string"}},
                                            "not": {
                                                "type": "object",
                                                "properties": {"forbidden": {"type": "string"}},
                                                "required": ("forbidden",),
                                            },
                                        },
                                    },
                                },
                            },
                            "responses": {"200": {"description": "Success"}},
                        },
                    },
                },
            };
            OpenApi3Schema so("", spec);

            # Valid: does not have forbidden property
            hash body = {"value": "allowed"};
            hash<RestRequestClientInfo> req = so.processRequest("POST", "/test", body, hdr);
            assertEq("/test", req.uri_path);

            # Invalid: has the forbidden property
            body = {"value": "allowed", "forbidden": "not allowed"};
            assertThrows("SCHEMA-VALIDATION-ERROR", "must not match.*'not' schema", \so.processRequest(),
                ("POST", "/test", body, hdr));
        }

        # Test readOnly - property cannot be in request
        {
            hash spec = {
                "openapi": "3.0.0",
                "info": {"title": "ReadOnly Test", "version": "1.0"},
                "paths": {
                    "/test": {
                        "post": {
                            "operationId": "testReadOnly",
                            "requestBody": {
                                "required": True,
                                "content": {
                                    "application/json": {
                                        "schema": {
                                            "type": "object",
                                            "properties": {
                                                "id": {"type": "integer", "readOnly": True},
                                                "name": {"type": "string"},
                                            },
                                        },
                                    },
                                },
                            },
                            "responses": {"200": {"description": "Success"}},
                        },
                    },
                },
            };
            OpenApi3Schema so("", spec);

            # Valid: no readOnly field in request
            hash body = {"name": "John"};
            hash<RestRequestClientInfo> req = so.processRequest("POST", "/test", body, hdr);
            assertEq("/test", req.uri_path);

            # Invalid: readOnly field in request
            body = {"id": 123, "name": "John"};
            assertThrows("SCHEMA-VALIDATION-ERROR", "read-only", \so.processRequest(), ("POST", "/test", body, hdr));
        }

        # Test writeOnly - property cannot be in response
        {
            hash spec = {
                "openapi": "3.0.0",
                "info": {"title": "WriteOnly Test", "version": "1.0"},
                "paths": {
                    "/test": {
                        "post": {
                            "operationId": "testWriteOnly",
                            "requestBody": {
                                "required": True,
                                "content": {
                                    "application/json": {
                                        "schema": {
                                            "type": "object",
                                            "properties": {
                                                "password": {"type": "string", "writeOnly": True},
                                                "username": {"type": "string"},
                                            },
                                        },
                                    },
                                },
                            },
                            "responses": {
                                "200": {
                                    "description": "Success",
                                    "content": {
                                        "application/json": {
                                            "schema": {
                                                "type": "object",
                                                "properties": {
                                                    "password": {"type": "string", "writeOnly": True},
                                                    "username": {"type": "string"},
                                                },
                                            },
                                        },
                                    },
                                },
                            },
                        },
                    },
                },
            };
            OpenApi3Schema so("", spec);

            # Valid: writeOnly field in request is allowed
            hash body = {"password": "secret", "username": "john"};
            hash<RestRequestClientInfo> req = so.processRequest("POST", "/test", body, hdr);
            assertEq("/test", req.uri_path);

            # Test response validation - writeOnly field should not be in response
            hash resp_body = {"password": "exposed", "username": "john"};
            assertThrows("SCHEMA-VALIDATION-ERROR", "write-only", \so.processResponse(), ("POST", "/test", 200,
                resp_body, hdr));

            # Valid response without writeOnly field
            resp_body = {"username": "john"};
            hash<HttpResponseInfo> res = so.processResponse("POST", "/test", 200, resp_body, hdr);
            assertEq(200, res.code);
        }
    }

    testXmlObject() {
        checkModules();

        hash base = {"openapi": "3.0", "info": ValidInfoObject, "paths": {}};
        hash s;

        s = {"type": "string", "xml": {}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));

        # name checks
        s = {"type": "string", "xml": {"name": "a"}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "xml": {"name": 5}};
        assertThrows("INVALID-FIELD-TYPE", "name", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        # namespace checks
        s = {"type": "string", "xml": {"namespace": "a"}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "xml": {"namespace": 5}};
        assertThrows("INVALID-FIELD-TYPE", "namespace", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        # prefix checks
        s = {"type": "string", "xml": {"prefix": "a"}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "xml": {"prefix": 5}};
        assertThrows("INVALID-FIELD-TYPE", "prefix", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        # attribute checks
        s = {"type": "string", "xml": {"attribute": False}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "xml": {"attribute": True}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "xml": {"attribute": 5}};
        assertThrows("INVALID-FIELD-TYPE", "attribute", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));

        # wrapped checks
        s = {"type": "string", "xml": {"wrapped": False}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "xml": {"wrapped": True}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"schemas": {"a": s}}})));
        s = {"type": "string", "xml": {"wrapped": 5}};
        assertThrows("INVALID-FIELD-TYPE", "wrapped", loadyaml, my_make_yaml(base + {"components": {"schemas": {"a": s}}}));
    }

    testSecuritySchemeObject() {
        checkModules();

        hash base = {"openapi": "3.0", "info": ValidInfoObject, "paths": {}};
        hash sd;

        # type checks
        sd = {"type": "http", "scheme": "basic"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}})));
        sd = {"type": "a"};
        assertThrows("INVALID-SCHEME-TYPE", loadyaml, my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}}));
        sd = {"type": 5};
        assertThrows("INVALID-FIELD-TYPE", "\"type\"", loadyaml, my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}}));

        # description checks
        sd = {"type": "http", "scheme": "basic", "description": "a"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}})));
        sd = {"type": "http", "scheme": "basic", "description": 5};
        assertThrows("INVALID-FIELD-TYPE", "description", loadyaml, my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}}));

        # type=apiKey checks
        sd = {"type": "apiKey"};
        assertThrows("REQUIRED-FIELD-MISSING", loadyaml, my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}}));
        sd = {"type": "apiKey", "name": "a"};
        assertThrows("REQUIRED-FIELD-MISSING", "\"in\".*missing", loadyaml, my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}}));
        sd = {"type": "apiKey", "in": "query"};
        assertThrows("REQUIRED-FIELD-MISSING", "\"name\".*missing", loadyaml, my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}}));
        sd = {"type": "apiKey", "name": "a", "in": "query"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}})));
        sd = {"type": "apiKey", "name": "a", "in": "header"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}})));
        sd = {"type": "apiKey", "name": "a", "in": "a"};
        assertThrows("INVALID-APIKEY-LOCATION", loadyaml, my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}}));
        sd = {"type": "apiKey", "name": 5, "in": "query"};
        assertThrows("INVALID-FIELD-TYPE", "name", loadyaml, my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}}));
        sd = {"type": "apiKey", "name": "a", "in": 5};
        assertThrows("INVALID-FIELD-TYPE", "in", loadyaml, my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}}));

        # type=oauth2 checks - requires 'flows' field
        sd = {"type": "oauth2"};
        assertThrows("REQUIRED-FIELD-MISSING", "\"flows\".*missing", loadyaml, my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}}));
        sd = {"type": "oauth2", "flows": 5};
        assertThrows("INVALID-FIELD-TYPE", "flows", loadyaml, my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}}));

        # oauth2 implicit flow
        sd = {"type": "oauth2", "flows": {"implicit": {"authorizationUrl": "https://example.com/auth", "scopes": {"read": "Read access"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}})));
        sd = {"type": "oauth2", "flows": {"implicit": {"scopes": {}}}};
        assertThrows("REQUIRED-FIELD-MISSING", "\"authorizationUrl\".*missing", loadyaml, my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}}));
        sd = {"type": "oauth2", "flows": {"implicit": {"authorizationUrl": 5, "scopes": {}}}};
        assertThrows("INVALID-FIELD-TYPE", "authorizationUrl", loadyaml, my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}}));

        # oauth2 password flow
        sd = {"type": "oauth2", "flows": {"password": {"tokenUrl": "https://example.com/token", "scopes": {}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}})));
        sd = {"type": "oauth2", "flows": {"password": {"scopes": {}}}};
        assertThrows("REQUIRED-FIELD-MISSING", "\"tokenUrl\".*missing", loadyaml, my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}}));
        sd = {"type": "oauth2", "flows": {"password": {"tokenUrl": 5, "scopes": {}}}};
        assertThrows("INVALID-FIELD-TYPE", "tokenUrl", loadyaml, my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}}));

        # oauth2 clientCredentials flow
        sd = {"type": "oauth2", "flows": {"clientCredentials": {"tokenUrl": "https://example.com/token", "scopes": {}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}})));
        sd = {"type": "oauth2", "flows": {"clientCredentials": {"scopes": {}}}};
        assertThrows("REQUIRED-FIELD-MISSING", "\"tokenUrl\".*missing", loadyaml, my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}}));

        # oauth2 authorizationCode flow
        sd = {"type": "oauth2", "flows": {"authorizationCode": {"authorizationUrl": "https://example.com/auth", "tokenUrl": "https://example.com/token", "scopes": {}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}})));
        sd = {"type": "oauth2", "flows": {"authorizationCode": {"tokenUrl": "https://example.com/token", "scopes": {}}}};
        assertThrows("REQUIRED-FIELD-MISSING", "\"authorizationUrl\".*missing", loadyaml, my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}}));
        sd = {"type": "oauth2", "flows": {"authorizationCode": {"authorizationUrl": "https://example.com/auth", "scopes": {}}}};
        assertThrows("REQUIRED-FIELD-MISSING", "\"tokenUrl\".*missing", loadyaml, my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}}));

        # type=http checks
        sd = {"type": "http", "scheme": "bearer"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}})));
        sd = {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}})));
        sd = {"type": "http"};
        assertThrows("REQUIRED-FIELD-MISSING", "\"scheme\".*missing", loadyaml, my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}}));

        # type=openIdConnect checks
        sd = {"type": "openIdConnect", "openIdConnectUrl": "https://example.com/.well-known/openid-configuration"};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}})));
        sd = {"type": "openIdConnect"};
        assertThrows("REQUIRED-FIELD-MISSING", "\"openIdConnectUrl\".*missing", loadyaml, my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}}));
    }

    testScopesObject() {
        checkModules();

        hash base = {"openapi": "3.0", "info": ValidInfoObject, "paths": {}};
        hash sd;

        # Test scopes in OAuth2 flows
        sd = {"type": "oauth2", "flows": {"password": {"tokenUrl": "https://example.com/token", "scopes": {}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}})));
        sd = {"type": "oauth2", "flows": {"password": {"tokenUrl": "https://example.com/token", "scopes": {"read": "Read access"}}}};
        assertTrue(loadyaml(my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}})));
        sd = {"type": "oauth2", "flows": {"password": {"tokenUrl": "https://example.com/token", "scopes": {"a": 5}}}};
        assertThrows("INVALID-FIELD-TYPE", loadyaml, my_make_yaml(base + {"components": {"securitySchemes": {"a": sd}}}));
    }

    testValidation() {
        checkModules();

        testValidation(OpenApi3::OpenApi3Loader::fromFile(get_script_dir() + DirSep + "PetStore.openapi3.yaml"));
        testValidation(OpenApi3::OpenApi3Loader::fromFile(get_script_dir() + DirSep + "PetStore.openapi3.json"));

        {
            hash b = ValidOpenApi3Schema;
            b.components.schemas.a = {
                "type": "object",
                "properties": {
                    "a": {
                        "type": "string",
                        "readOnly": True,
                    },
                },
            };
            b.components.parameters.a = b.components.parameters.a + (
                "in": "body",
                "name": "body",
                "required": True,
                "schema": (
                    "$ref": "#/components/schemas/a",
