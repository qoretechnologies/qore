    testOpenApi31TypeValidation() {
        checkModules();

        # Test that nullable type from type array is parsed correctly
        {
            hash<auto> schema = {
                "openapi": "3.1.0",
                "info": {"title": "Test API", "version": "1.0"},
                "paths": {},
                "components": {
                    "schemas": {
                        "NullableObject": {
                            "type": "object",
                            "properties": {
                                "nullableField": {
                                    "type": ("string", "null"),
                                },
                                "requiredField": {
                                    "type": "string",
                                },
                            },
                            "required": ("requiredField",),
                        },
                    },
                },
            };
            OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", schema);
            OpenApi3::SchemaObject objSchema = so.components.schemas.NullableObject;

            # Verify nullable property is set correctly
            assertTrue(objSchema.properties.nullableField.nullable);
            assertEq("string", objSchema.properties.nullableField.type);
            assertFalse(objSchema.properties.requiredField.nullable);
            assertEq("string", objSchema.properties.requiredField.type);

            # Verify required field is tracked (as hash with True values)
            assertTrue(objSchema.required.requiredField);
        }

        # Test that exclusiveMinimum/Maximum as numbers are parsed correctly
        {
            hash<auto> schema = {
                "openapi": "3.1.0",
                "info": {"title": "Test API", "version": "1.0"},
                "paths": {},
                "components": {
                    "schemas": {
                        "BoundedNumber": {
                            "type": "number",
                            "exclusiveMinimum": 0,
                            "exclusiveMaximum": 100,
                        },
                    },
                },
            };
            OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", schema);
            OpenApi3::SchemaObject bounded = so.components.schemas.BoundedNumber;

            # Verify the numeric exclusive values are set
            assertEq(0.0, bounded.exclusiveMinValue);
            assertEq(100.0, bounded.exclusiveMaxValue);
            # Boolean exclusive flags should not be set
            assertNothing(bounded.exclusiveMin);
            assertNothing(bounded.exclusiveMax);
        }

        # Test backward compatibility with 3.0 boolean exclusiveMinimum/Maximum
        {
            hash<auto> schema = {
                "openapi": "3.0.3",
                "info": {"title": "Test API", "version": "1.0"},
                "paths": {},
                "components": {
                    "schemas": {
                        "BoundedNumber": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 100,
                            "exclusiveMinimum": True,
                            "exclusiveMaximum": True,
                        },
                    },
                },
            };
            OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", schema);
            OpenApi3::SchemaObject bounded = so.components.schemas.BoundedNumber;

            # Verify the boolean exclusive flags are set
            assertTrue(bounded.exclusiveMin);
            assertTrue(bounded.exclusiveMax);
            assertEq(0.0, bounded.minimum);
            assertEq(100.0, bounded.maximum);
            # Numeric exclusive values should not be set
            assertNothing(bounded.exclusiveMinValue);
            assertNothing(bounded.exclusiveMaxValue);
        }

        # Test mixed types in type array (first non-null type used)
        {
            hash<auto> schema = {
                "openapi": "3.1.0",
                "info": {"title": "Test API", "version": "1.0"},
                "paths": {},
                "components": {
                    "schemas": {
                        "NullableNumber": {
                            "type": ("number", "null"),
                            "minimum": 0,
                        },
                    },
                },
            };
            OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", schema);
            OpenApi3::SchemaObject numSchema = so.components.schemas.NullableNumber;

            assertEq("number", numSchema.type);
            assertTrue(numSchema.nullable);
            assertEq(0.0, numSchema.minimum);
        }

        # Test multiple non-null types in type array (first type used)
        {
            hash<auto> schema = {
                "openapi": "3.1.0",
                "info": {"title": "Test API", "version": "1.0"},
                "paths": {},
                "components": {
                    "schemas": {
                        "MultiType": {
                            "type": ("string", "integer"),
                        },
                    },
                },
            };
            OpenApi3::OpenApi3Schema so = new OpenApi3::OpenApi3Schema("", schema);
            OpenApi3::SchemaObject multiSchema = so.components.schemas.MultiType;

            # First non-null type should be used
            assertEq("string", multiSchema.type);
            assertFalse(multiSchema.nullable);
        }
    }

    #! Test that multiple content types in requestBody are all accepted
    testMultipleContentTypes() {
        checkModules();

        # Test schema with requestBody supporting multiple content types
        # This tests that all content types from requestBody.content are added to consumes,
        # not just the first one (which was the bug fixed in this commit)
        hash<auto> spec = {
            "openapi": "3.0.0",
            "info": {"title": "Multiple Content Types Test", "version": "1.0"},
            "paths": {
                "/data": {
                    "post": {
                        "operationId": "postData",
                        "requestBody": {
                            "required": True,
                            "content": {
                                "application/json": {
                                    "schema": {
                                        "type": "object",
                                        "properties": {
                                            "name": {"type": "string"},
                                        },
                                    },
                                },
                                "application/xml": {
                                    "schema": {
                                        "type": "object",
                                        "properties": {
                                            "name": {"type": "string"},
                                        },
                                    },
                                },
                                "text/x-yaml": {
                                    "schema": {
                                        "type": "object",
                                        "properties": {
                                            "name": {"type": "string"},
                                        },
                                    },
                                },
                            },
                        },
                        "responses": {
                            "200": {"description": "Success"},
                        },
                    },
                },
            },
        };
        OpenApi3Schema so("", spec);

        hash<auto> body = {"name": "test"};

        # Test that JSON content type is accepted (default, first in list)
        {
            hash<RestRequestClientInfo> req = so.processRequest("POST", "/data", body);
            assertEq("/data", req.uri_path);
            assertEq(MimeTypeJson, req.content);
        }

        # Test that XML content type is accepted when explicitly requested via content_types
        # Before the fix, only the first content type (JSON) would be in consumes,
        # so requesting XML would fail
        {
            hash<RestRequestClientInfo> req = so.processRequest("POST", "/data", body, NOTHING,
                (MimeTypeXmlApp,));
            assertEq("/data", req.uri_path);
            assertEq(MimeTypeXmlApp, req.content);
        }

        # Test that YAML content type is accepted when explicitly requested
        # This also verifies that all content types from requestBody.content are in consumes
        {
            hash<RestRequestClientInfo> req = so.processRequest("POST", "/data", body, NOTHING,
                (MimeTypeYaml,));
            assertEq("/data", req.uri_path);
            assertEq(MimeTypeYaml, req.content);
        }

        # Negative test: unsupported content type should be rejected
        {
            assertThrows("SERIALIZATION-ERROR", "application/octet-stream",
                \so.processRequest(), ("POST", "/data", body, NOTHING, ("application/octet-stream",)));
        }

        # Negative test: schema with only unsupported content type should fail default serialization
        {
            hash<auto> spec2 = {
                "openapi": "3.0.0",
                "info": {"title": "Limited Content Types Test", "version": "1.0"},
                "paths": {
                    "/limited": {
                        "post": {
                            "operationId": "postLimited",
                            "requestBody": {
                                "required": True,
                                "content": {
                                    "image/png": {
                                        "schema": {
                                            "type": "string",
                                            "format": "binary",
                                        },
                                    },
                                },
                            },
                            "responses": {
                                "200": {"description": "Success"},
                            },
                        },
                    },
                },
            };
            OpenApi3Schema so2("", spec2);
            # With no matching serialization module for image/png, this should fail
            assertThrows("SERIALIZATION-ERROR", "image/png",
                \so2.processRequest(), ("POST", "/limited", <abcd>));
        }

        # Test that body parameter is created only once (not duplicated for each content type)
        {
            OpenApi3::PathItemObject pio = so.paths.match("/data");
            OpenApi3::OperationObject op = pio.getOperation("post", "/data");
            assertTrue(exists op.body);
            assertEq("body", op.body.name);
        }
    }

    testGeneratorNullableNestedNamedHashBodyParams() {
        string source =
            "/** @REST /v1/example\n"
            "*/\n"
            "class ExampleRestClass {\n"
            "    /** @REST PUT action=getOptions\n"
            "        @SCHEMA\n"
            "        @summary Get options\n"
            "        @desc Gets options.\n"
            "        @params\n"
            "        - output_type (*hash TypeSpecInfo): output type\n"
            "          - type (string): type source\n"
            "          - name (string): type name\n"
            "          - options (*hash UndefinedHash): provider options\n"
            "        - output_field (string): output field\n"
            "        @return (hash ResultInfo): result\n"
            "        - ok (bool): True on success\n"
            "        @ENDSCHEMA\n"
            "    */\n"
            "    hash<auto> putGetOptions(hash<auto> cx, *hash<auto> ah) { }\n"
            "}\n";

        list<hash<RestMethodInfo>> methods =
            OpenApi3SchemaTokenizer::parseSourceContent(source);
        assertEq(1, methods.size());

        OpenApi3SchemaGenerator gen({"title": "Generator Test",
            "version": "1.0"});
        gen.addMethod("/v1/example", methods[0]);

        hash<auto> spec = gen.generate();
        list<string> path_keys = keys spec.paths;
        assertEq(("/v1/example/getOptions",), path_keys);
        hash<auto> body_schema = spec.paths{path_keys[0]}.put.requestBody
            .content{"application/json"}.schema;
        hash<auto> output_type = body_schema.properties.output_type;
        assertEq(True, output_type.nullable);
        assertEq(2, output_type.allOf.size());
        assertEq("#/components/schemas/TypeSpecInfo",
            output_type.allOf[0]."\$ref");
        assertTrue(exists output_type.allOf[1].properties.type);
        assertTrue(exists spec.components.schemas.TypeSpecInfo);
    }

    testGeneratorUnionTypeSchemas() {
        hash<auto> mapped = OpenApi3TypeMapper::mapType("*list<string>|*list<hash>");
        assertTrue(mapped.nullable);
        assertEq(2, mapped.anyOf.size());
        assertEq("array", mapped.anyOf[0].type);
        assertEq("string", mapped.anyOf[0].items.type);
        assertEq("array", mapped.anyOf[1].type);
        assertEq("object", mapped.anyOf[1].items.type);
        assertTrue(mapped.anyOf[1].items.additionalProperties);

        string source =
            "/** @REST /v1/example\n"
            "*/\n"
            "class ExampleRestClass {\n"
            "    /** @REST POST /v1/example action=create\n"
            "        @SCHEMA\n"
            "        @summary Create example\n"
            "        @desc Creates an example.\n"
            "        @params\n"
            "        - groups (*list<string>|*list<hash>): groups\n"
            "        @return (hash ResultInfo): result\n"
            "        - ok (bool): True on success\n"
            "        @ENDSCHEMA\n"
            "    */\n"
            "    hash<auto> postCreate(hash<auto> cx, *hash<auto> ah) { }\n"
            "}\n";

        list<hash<RestMethodInfo>> methods =
            OpenApi3SchemaTokenizer::parseSourceContent(source);
        assertEq(1, methods.size());

        OpenApi3SchemaGenerator gen({"title": "Union Test",
            "version": "1.0"});
        gen.addMethod("/v1/example", methods[0]);

        hash<auto> spec = gen.generate();
        string path = (keys spec.paths)[0];
        hash<auto> groups = spec.paths{path}.post.requestBody
            .content{"application/json"}.schema.properties.groups;
        assertTrue(groups.nullable);
        assertEq(2, groups.anyOf.size());
        assertEq("array", groups.anyOf[0].type);
        assertEq("string", groups.anyOf[0].items.type);
        assertEq("array", groups.anyOf[1].type);
        assertEq("object", groups.anyOf[1].items.type);
    }
}
