#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

# try importing JSON and YAML modules
%requires json
%try-module yaml
%define NoYaml
%endtry

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires Mime
%requires QUnit
%requires HttpServerUtil
%requires RestSchemaValidator
%requires OpenApi3
%requires ConnectionProvider
%requires RestClient

%exec-class OpenApi3Test

string sub my_make_json(any v) {
    return make_json(v);
}

string sub my_make_yaml(any v) {
%ifndef NoYaml
    return make_yaml(v);
%else
    return "";
%endif
}

class HttpTestServer {
    public {
        int port = 0;
        string body;
    }

    private {
        Counter end();
        Counter listener_done();
        string resp;
        Socket s();
    }

    constructor(string r) {
        resp = r;

        restart();
    }

    done() {
        end.dec();
        # Wait for the listener thread to finish cleanup before returning
        listener_done.waitForZero();
    }

    restart() {
        end.inc();
        listener_done.inc();
        # start a fake server
        if (s.bind(port, True)) {
            throw "BIND-ERROR", strerror();
        }

        if (s.listen()) {
            throw "LISTEN-ERROR", strerror();
        }

        if (!port) {
            port = s.getSocketInfo().port;
        }
        background startListener(s);
    }

    private startListener(Socket s) {
        on_exit listener_done.dec();
        Socket s1 = s.accept(2s);
        hash<auto> h = s1.readHTTPHeader(2s);
        if (h."content-length") {
            body = s1.recv(h."content-length");
        } else if (h."transfer-encoding" == "chunked") {
            body = s1.readHTTPChunkedBody().body;
        }
        s1.send(resp);
        end.waitForZero();
        s.close();
        s.shutdown();
    }

    string getBody() {
        return body;
    }
}

