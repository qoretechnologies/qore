#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires HttpServer
%requires HttpServerUtil
%requires DpqlWebSocket

%exec-class DpqlWebSocketHandlerCredentialsTest

#! a hang guard only, never a timing assertion
const HangGuard = 20s;

#! The authentication callback of a restricted Program gets the request without its credentials (qore#7303)
/** A DpqlWebSocketHandler of trusted code gives an authentication callback of a %Program that a sandbox that does not trust
    its code governs the request without its credentials, also when trusted code set the callback: it keeps the
    header fields that are not credentials (an API key field), the address of the client and the URL, and gets the
    \c Authorization field only when trusted code opts in to it; a trusted callback gets the request as the server
    has it, and the callback of a handler that restricted code creates gets it without its credentials
*/
class DpqlWebSocketHandlerCredentialsTest inherits QUnit::Test {
    public {
        #! the tenant's code: a callback that records what of the credentials of the request it saw and refuses it
        const TenantSource = "%modern
%requires DpqlWebSocket
string sub seen(hash<auto> cx, hash<auto> hdr) {
    return sprintf(\"authorization=%y cookie=%y api_key=%y cx.auth=%y raw_authorization=%y logger=%y listener=%y \"
        \"socket=%y peer=%y url=%y\", exists hdr.authorization, exists hdr.cookie, hdr.\"x-api-key\", exists cx.auth,
        exists cx.\"header-info\".\"headers-raw\".Authorization, cx.hasKey(\"logger\"), cx.hasKey(\"listener\"),
        cx.hasKey(\"socket\"), exists cx.\"peer-info\".address, exists cx.url);
}
code sub get_callback(Queue q) {
    return bool sub (hash<auto> cx, hash<auto> hdr) { q.push(seen(cx, hdr)); return False; };
}
DpqlWebSocketHandler sub make_handler(Queue q) {
    return new DpqlWebSocketHandler(NOTHING, {\"auth_callback\": get_callback(q)});
}
";

        #! what the callback of a restricted Program gets: no credentials, no objects of the server
        const Filtered = "authorization=False cookie=False api_key=\"k\" cx.auth=False raw_authorization=False "
            "logger=False listener=False socket=False peer=True url=True";

        #! what the callback of a restricted Program gets with the opt-in: the Authorization field only
        const FilteredOptIn = "authorization=True cookie=False api_key=\"k\" cx.auth=False raw_authorization=True "
            "logger=False listener=False socket=False peer=True url=True";

        #! what a trusted callback gets
        const Raw = "authorization=True cookie=True api_key=\"k\" cx.auth=True raw_authorization=True logger=True "
            "listener=False socket=True peer=True url=True";
    }

    constructor() : Test("DpqlWebSocketHandlerCredentialsTest", "1.0", \ARGV) {
        addTestCase("a restricted callback of a trusted handler (option)", \restrictedOptionTest());
        addTestCase("a restricted callback of a trusted handler (setAuthCallback())", \restrictedSetTest());
        addTestCase("a restricted callback with the opt-in of trusted code", \optInTest());
        addTestCase("the callback of a Program without a sandbox", \trustedTest());
        addTestCase("the callback of a handler that restricted code creates", \restrictedHandlerTest());
        set_return_value(main());
    }

    #! returns the tenant's Program with the given sandbox
    private Program getTenant(*SandboxManager sm) {
        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        if (sm) {
            p.setSandboxManager(sm);
        }
        p.parse(TenantSource, "tenant");
        return p;
    }

    #! sends a WebSocket upgrade request with credentials; returns the status code
    private int request(DpqlWebSocketHandler handler) {
        HttpServer server(<HttpServerOptionInfo>{});
        on_exit server.stop();
        server.setDefaultHandler("ws", handler);
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        server.waitForAsyncIo();
        Socket c();
        c.connect("127.0.0.1:" + port, HangGuard);
        on_exit c.close();
        c.send("GET / HTTP/1.1\r\nHost: localhost\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
            "Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n"
            "Authorization: Bearer secret\r\nCookie: session=secret\r\nX-Api-Key: k\r\n\r\n");
        hash<auto> h = c.readHTTPHeader(HangGuard);
        return h.status_code;
    }

    restrictedOptionTest() {
        Queue q();
        # the default sandbox does not trust its code
        Program p = getTenant(new SandboxManager());
        DpqlWebSocketHandler h(NOTHING, {"auth_callback": p.callFunction("get_callback", q)});
        assertEq(401, request(h), "the callback refuses the request");
        assertEq(Filtered, q.get(HangGuard), "the restricted callback");
    }

    restrictedSetTest() {
        Queue q();
        Program p = getTenant(new SandboxManager());
        DpqlWebSocketHandler h();
        h.setAuthCallback(p.callFunction("get_callback", q));
        assertEq(401, request(h), "the callback refuses the request");
        assertEq(Filtered, q.get(HangGuard), "the restricted callback");
    }

    optInTest() {
        Queue q();
        Program p = getTenant(new SandboxManager());
        DpqlWebSocketHandler h(NOTHING, {"auth_callback": p.callFunction("get_callback", q)});
        h.setRequestCredentialHeaders("authorization");
        assertEq(401, request(h), "the callback refuses the request");
        assertEq(FilteredOptIn, q.get(HangGuard), "the restricted callback with the opt-in");
    }

    trustedTest() {
        Queue q();
        Program p = getTenant();
        DpqlWebSocketHandler h(NOTHING, {"auth_callback": p.callFunction("get_callback", q)});
        assertEq(401, request(h), "the callback refuses the request");
        assertEq(Raw, q.get(HangGuard), "the callback of a Program without a sandbox");
    }

    restrictedHandlerTest() {
        Queue q();
        Program p = getTenant(new SandboxManager());
        assertEq(401, request(p.callFunction("make_handler", q)), "the callback refuses the request");
        assertEq(Filtered, q.get(HangGuard), "the callback of a handler that restricted code creates");
    }
}
