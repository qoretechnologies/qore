%modern
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Mime
%requires Logger
%requires DataProvider
%requires ConnectionProvider
%requires HttpServerUtil
%requires AsyncSocketIo
%requires HttpServerAsyncIo
%requires HttpServer
%requires ServerSentEventHandler
%requires HttpClientIo
%requires HttpClientStreamingIo
%requires AsyncApi
%requires json

%exec-class SseObservableTest

class TestSseHandler inherits ServerSentEventHandler {
    constructor() : ServerSentEventHandler() {
    }

    connectionRegisteredImpl(ServerSentEventConnection conn) {
        conn.send(<SseMessageInfo>{
            "event": "greeting",
            "data": "hello",
        });
    }
}

#! Handler that lets each test override the async heartbeat interval (ms)
class HeartbeatSseHandler inherits ServerSentEventHandler {
    public {
        int hb_ms;
    }

    constructor(int heartbeat_ms) : ServerSentEventHandler() {
        hb_ms = heartbeat_ms;
    }

    HttpServerAsyncIo::HttpSseStreamPollOperation setupAsyncSseConnection(Socket sock,
            hash<auto> cx, hash<auto> hdr, string cid) {
        HttpServerAsyncIo::HttpSseStreamPollOperation poll_op =
            ServerSentEventHandler::setupAsyncSseConnection(sock, cx, hdr, cid);
        poll_op.setHeartbeat(hb_ms);
        return poll_op;
    }

    connectionRegisteredImpl(ServerSentEventConnection conn) {
        conn.send(<SseMessageInfo>{
            "event": "greeting",
            "data": "hello",
        });
    }
}

class JsonSseHandler inherits ServerSentEventHandler {
    public {
        bool validator_seen = False;
    }

    constructor(AsyncApi::AsyncApi3Schema validator)
            : ServerSentEventHandler(NOTHING, {
                "data": "json",
                "validator": validator,
                "asyncapi_channel": "events",
            }) {
    }

    connectionRegisteredImpl(ServerSentEventConnection conn) {
        validator_seen = conn.getAsyncApiValidator() instanceof AsyncApi::AsyncApi3Schema
            && conn.getAsyncApiChannel() == "events";
        conn.send(<SseMessageInfo>{
            "event": "greeting",
            "data": {
                "message": "hello",
            },
        });
    }
}

class InvalidJsonSseHandler inherits ServerSentEventHandler {
    constructor() : ServerSentEventHandler(NOTHING, {"data": "json"}) {
    }

    connectionRegisteredImpl(ServerSentEventConnection conn) {
        conn.send(<SseMessageInfo>{
            "event": "greeting",
            "data": {
                "unexpected": True,
            },
        });
    }
}

#! Observable whose destructor widens the object teardown window
/** %Qore destroys an object's members only after its destructor returns, and
    entering a method is still allowed in that window — so a slow destructor
    gives the async I/O thread many chances to enter the dying observable and
    take its Mutex while the member cleanup is about to delete it.
*/
class SlowTeardownObservable inherits HttpClientStreamingIo::SseObservable {
    public {
        int teardown_ms;
    }

    constructor(HttpClientIo::HttpClientConnectionManager mgr, string url, string method,
            string path, *hash<auto> headers, *data body, *hash<auto> opts, int teardown_ms)
            : HttpClientStreamingIo::SseObservable(mgr, url, method, path, headers, body, opts) {
        self.teardown_ms = teardown_ms;
    }

    destructor() {
        usleep(milliseconds(teardown_ms));
    }
}

class TestObserver inherits DataProvider::Observer {
    public {
        list<hash<auto>> events = ();
        Mutex m();
        Condition cond();
        int expected_count = 0;
    }

    constructor(int expected = 1) {
        expected_count = expected;
    }

    update(string event_id, hash<auto> data_) {
        AutoLock al(m);
        push events, {
            "event_id": event_id,
            "data": data_,
        };
        cond.broadcast();
    }

    bool waitForEvents(timeout t = 10s) {
        return waitForCount(expected_count, t);
    }

    # Waits until at least \c count events have been received
    bool waitForCount(int count, timeout t = 10s) {
        AutoLock al(m);
        date end_time = now_us() + t;
        while (events.size() < count) {
            date remaining = end_time - now_us();
            if (remaining <= 0us) {
                return False;
            }
            cond.wait(m, remaining);
        }
        return True;
    }

    bool waitForEvent(string event_id, int count = 1, timeout t = 10s) {
        AutoLock al(m);
        date end_time = now_us() + t;
        while ((select events, $1.event_id == event_id).size() < count) {
            date remaining = end_time - now_us();
            if (remaining <= 0us) {
                return False;
            }
            cond.wait(m, remaining);
        }
        return True;
    }
}

class SseObservableTest inherits Test {
    private {
        HttpServer server;
        int port;
        TestSseHandler handler();
    }

    constructor() : Test("SseObservableTest", "1.0") {
        addTestCase("TestObserver wakes for partial wait counts", \testObserverPartialWaitWakes());
        addTestCase("SseObservable receives events via Observer pattern", \testObserverReceivesEvents());
        addTestCase("SseObservable receives multiple events", \testObserverMultipleEvents());
        addTestCase("SseObservable stopEvents cancels stream", \testStopEvents());
        addTestCase("SseObservable with POST method and JSON body", \testPostWithJsonBody());
        addTestCase("SseObservable receives heartbeat events", \testHeartbeatReceived());
        addTestCase("SseObservable suppresses heartbeat when emit_heartbeat=False",
            \testHeartbeatSuppressed());
        addTestCase("SseObservable closes on idle timeout", \testIdleTimeoutFires());
        addTestCase("SseObservable teardown with a live stream is safe",
            \testTeardownWhileStreamActive());
        addTestCase("SseObservable heartbeats prevent idle timeout",
            \testHeartbeatPreventsIdleTimeout());
        addTestCase("SseObservable validates AsyncAPI events", \testAsyncApiValidatedEvents());
        addTestCase("SseObservable reports AsyncAPI validation errors",
            \testAsyncApiIncomingValidationFailure());
        addTestCase("SSE AsyncAPI option and outbound validation",
            \testAsyncApiOptionsAndOutboundValidation());
        set_return_value(main());
    }

    private static AsyncApi::AsyncApi3Schema createAsyncApiSchema() {
        return new AsyncApi::AsyncApi3Schema("", {
            "asyncapi": "3.0.0",
            "info": {
                "title": "SSE Observable Test API",
                "version": "1.0.0",
            },
            "channels": {
                "events": {
                    "address": "/sse",
                    "messages": {
                        "eventMessage": {
                            "$ref": "#/components/messages/EventMessage",
                        },
                    },
                },
            },
            "operations": {
                "sendEvent": {
                    "action": "send",
                    "channel": {
                        "$ref": "#/channels/events",
                    },
                    "messages": (
                        {
                            "$ref": "#/channels/events/messages/eventMessage",
                        },
                    ),
                },
                "receiveEvent": {
                    "action": "receive",
                    "channel": {
                        "$ref": "#/channels/events",
                    },
                    "messages": (
                        {
                            "$ref": "#/channels/events/messages/eventMessage",
                        },
                    ),
                },
            },
            "components": {
                "messages": {
                    "EventMessage": {
                        "payload": {
                            "$ref": "#/components/schemas/EventPayload",
                        },
                    },
                },
                "schemas": {
                    "EventPayload": {
                        "type": "object",
                        "required": ("message",),
                        "properties": {
                            "message": {
                                "type": "string",
                            },
                        },
                    },
                },
            },
        });
    }

    globalSetUp() {
        Logger logger("test", LoggerLevel::getLevelInfo());
        hash<HttpServerOptionInfo> http_opts = <HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        };
        server = new HttpServer(http_opts);
        server.setDefaultHandler("sse", handler);
        port = server.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
    }

    globalTearDown() {
        if (server) {
            server.stop();
            delete server;
        }
    }

    testObserverPartialWaitWakes() {
        TestObserver observer(3);
        Counter done(1);
        background sub () {
            usleep(100ms);
            observer.update("one", {});
            observer.update("two", {});
            done.dec();
        }();

        date start = now_us();
        assertTrue(observer.waitForCount(2, 3s), "partial-count wait returned");
        int elapsed_us = (now_us() - start).durationMicroseconds();
        assertLt(2000000, elapsed_us, "partial-count wait woke before timeout");
        assertEq(0, done.waitForZero(2s), "producer completed");
    }

    testObserverReceivesEvents() {
        string url = sprintf("http://localhost:%d/sse", port);
        HttpClientIo::HttpClientConnectionManager mgr();

        HttpClientStreamingIo::SseObservable obs(mgr, url, "GET", "/sse");

        # Expect: connected + at least 1 data event
        TestObserver observer(2);
        obs.registerObserver(observer);
        obs.observersReady();

        # Wait for the connected + greeting event
        bool got_events = observer.waitForEvents(10s);
        assertEq(True, got_events, "received expected events");
        assertGe(2, observer.events.size(), "at least 2 events received");

        # Verify connected event
        assertEq(HttpClientStreamingIo::EVENT_SSE_CONNECTED, observer.events[0].event_id);

        # Verify data event — the SSE handler serializes data as JSON
        assertEq(HttpClientStreamingIo::EVENT_SSE_DATA, observer.events[1].event_id);
        assertEq("greeting", observer.events[1].data.event);
        assertEq("\"hello\"", observer.events[1].data.data);

        obs.stopEvents();
    }

    testObserverMultipleEvents() {
        string url = sprintf("http://localhost:%d/sse", port);
        HttpClientIo::HttpClientConnectionManager mgr();

        HttpClientStreamingIo::SseObservable obs(mgr, url, "GET", "/sse");

        # connected + greeting + update = 3 events
        TestObserver observer(3);
        obs.registerObserver(observer);
        obs.observersReady();

        # Wait for connected + greeting before sending a second event
        bool got_greeting = observer.waitForCount(2, 10s);
        assertTrue(got_greeting, "greeting arrived");

        # Send a second event from the server
        handler.sendAll(<SseMessageInfo>{
            "event": "update",
            "data": "payload",
        });

        bool got_events = observer.waitForEvents(10s);
        assertEq(True, got_events, "received 3 events");

        # Find the data events
        list<hash<auto>> data_events = (
            select observer.events,
            $1.event_id == HttpClientStreamingIo::EVENT_SSE_DATA
        );
        assertGe(2, data_events.size(), "at least 2 data events");
        assertEq("greeting", data_events[0].data.event);
        assertEq("update", data_events[1].data.event);
        assertEq("\"payload\"", data_events[1].data.data);

        obs.stopEvents();
    }

    testStopEvents() {
        string url = sprintf("http://localhost:%d/sse", port);
        HttpClientIo::HttpClientConnectionManager mgr();

        HttpClientStreamingIo::SseObservable obs(mgr, url, "GET", "/sse");

        # Wait for connected + greeting + closed = 3
        TestObserver observer(3);
        obs.registerObserver(observer);
        obs.observersReady();

        # Wait for connected + greeting before stopping
        bool got_initial = observer.waitForCount(2, 10s);
        assertTrue(got_initial, "greeting arrived before stop");

        # Stop the observable
        obs.stopEvents();
        assertEq(True, obs.isStopped(), "observable is stopped");

        # Wait for the closed event
        bool got_events = observer.waitForEvents(10s);
        assertEq(True, got_events, "received events including closed");

        # Find the closed event
        list<hash<auto>> closed_events = (
            select observer.events,
            $1.event_id == HttpClientStreamingIo::EVENT_SSE_CLOSED
        );
        assertEq(1, closed_events.size(), "one closed event");
    }

    testPostWithJsonBody() {
        string url = sprintf("http://localhost:%d/sse", port);
        HttpClientIo::HttpClientConnectionManager mgr();

        # POST with JSON body — the SSE handler doesn't check method/body,
        # but this verifies the SSE Observable works with non-GET methods
        HttpClientStreamingIo::SseObservable obs(mgr, url, "POST", "/sse",
            {"Content-Type": MimeTypeJson},
            make_json({"prompt": "test"}));

        # Expect: connected + greeting
        TestObserver observer(2);
        obs.registerObserver(observer);
        obs.observersReady();

        bool got_data = observer.waitForEvent(HttpClientStreamingIo::EVENT_SSE_DATA, 1, 10s);
        assertEq(True, got_data, "received data event with POST method");

        # Verify data event still arrived
        list<hash<auto>> data_events = (
            select observer.events,
            $1.event_id == HttpClientStreamingIo::EVENT_SSE_DATA
        );
        assertGe(1, data_events.size(), "at least 1 data event with POST");
        assertEq("greeting", data_events[0].data.event);
        assertEq("\"hello\"", data_events[0].data.data);

        obs.stopEvents();
    }

    #! Mock HTTP server that sends only headers + no events; used to exercise
    #! the client-side idle-timeout path with no server-side heartbeat.
    private int startSilentServer(reference<bool> stop_flag) {
        Socket listener();
        listener.bindINET("localhost", 0, True, AF_INET, SOCK_STREAM);
        listener.listen();
        int lport = listener.getSocketInfo().port;

        background sub () {
            while (!stop_flag) {
                try {
                    *Socket client = listener.accept(250ms);
                    if (!client) {
                        continue;
                    }
                    background sub () {
                        try {
                            client.readHTTPHeader(5s);
                            client.send2(
                                "HTTP/1.1 200 OK\r\n"
                                "Content-Type: text/event-stream\r\n"
                                "Cache-Control: no-cache\r\n"
                                "Connection: keep-alive\r\n"
                                "\r\n", 5s);
                            # Keep socket open, send nothing — server is "alive"
                            # but silent, so the client's idle timeout must fire.
                            while (!stop_flag && client.isOpen()) {
                                usleep(100ms);
                            }
                        } catch (hash<ExceptionInfo> ex) {
                            # client disconnect or similar — exit the thread
                        }
                        try {
                            client.close();
                        } catch () {}
                    }();
                } catch (hash<ExceptionInfo> ex) {
                    # listener issue — retry on next loop iteration
                }
            }
            listener.close();
        }();
        return lport;
    }

    testHeartbeatReceived() {
        # Server heartbeat every 1s; client default emit_heartbeat = True
        HeartbeatSseHandler hb_handler(1000);
        HttpServer hb_server(<HttpServerOptionInfo>{
            "logger": new Logger("hb", LoggerLevel::getLevelInfo()),
            "debug": True,
        });
        on_exit hb_server.stop();
        hb_server.setDefaultHandler("sse", hb_handler);
        int hb_port = hb_server.addListener(<HttpListenerOptionInfo>{"service": 0}).port;

        string url = sprintf("http://localhost:%d/sse", hb_port);
        HttpClientIo::HttpClientConnectionManager mgr();
        HttpClientStreamingIo::SseObservable obs(mgr, url, "GET", "/sse");

        TestObserver observer(4);  # connected + greeting + >= 2 heartbeats
        obs.registerObserver(observer);
        obs.observersReady();

        bool got = observer.waitForCount(4, 5s);
        assertEq(True, got, "observed >= 2 heartbeats on top of connected+greeting");

        list<hash<auto>> hb_events = (
            select observer.events,
            $1.event_id == HttpClientStreamingIo::EVENT_SSE_HEARTBEAT
        );
        assertGe(2, hb_events.size(), "at least 2 heartbeat events");
        assertEq("hb", hb_events[0].data.comment, "heartbeat comment payload");

        obs.stopEvents();
    }

    testHeartbeatSuppressed() {
        # Server heartbeat every 1s; client emit_heartbeat = False
        HeartbeatSseHandler hb_handler(1000);
        HttpServer hb_server(<HttpServerOptionInfo>{
            "logger": new Logger("hb-s", LoggerLevel::getLevelInfo()),
            "debug": True,
        });
        on_exit hb_server.stop();
        hb_server.setDefaultHandler("sse", hb_handler);
        int hb_port = hb_server.addListener(<HttpListenerOptionInfo>{"service": 0}).port;

        string url = sprintf("http://localhost:%d/sse", hb_port);
        HttpClientIo::HttpClientConnectionManager mgr();
        HttpClientStreamingIo::SseObservable obs(mgr, url, "GET", "/sse",
            NOTHING, NOTHING, {"emit_heartbeat": False});

        TestObserver observer(2);  # connected + greeting only
        obs.registerObserver(observer);
        obs.observersReady();

        bool got = observer.waitForCount(2, 5s);
        assertEq(True, got, "received connected + greeting");

        # Wait long enough for several heartbeats to arrive and be suppressed
        usleep(2500ms);

        list<hash<auto>> hb_events = (
            select observer.events,
            $1.event_id == HttpClientStreamingIo::EVENT_SSE_HEARTBEAT
        );
        assertEq(0, hb_events.size(), "no heartbeat events surfaced");

        # Connection still alive — send an extra event from the server
        hb_handler.sendAll(<SseMessageInfo>{"event": "update", "data": "live"});
        assertTrue(observer.waitForCount(3, 3s), "data event still delivered");

        obs.stopEvents();
    }

    testIdleTimeoutFires() {
        bool stop_flag = False;
        int silent_port = startSilentServer(\stop_flag);
        on_exit stop_flag = True;

        string url = sprintf("http://localhost:%d/sse", silent_port);
        HttpClientIo::HttpClientConnectionManager mgr();
        HttpClientStreamingIo::SseObservable obs(mgr, url, "GET", "/sse",
            NOTHING, NOTHING, {"idle_timeout": 500ms});

        TestObserver observer(2);  # connected + closed
        obs.registerObserver(observer);
        obs.observersReady();

        bool got = observer.waitForCount(2, 5s);
        assertEq(True, got, "idle-timeout produced connected + closed");

        list<hash<auto>> closed = (
            select observer.events,
            $1.event_id == HttpClientStreamingIo::EVENT_SSE_CLOSED
        );
        assertEq(1, closed.size(), "one closed event");
        assertEq("idle-timeout", closed[0].data.reason, "closed reason");

        # quiesce the notifier poll operation before the locals holding the
        # observable and its observer go out of scope
        obs.stopEvents();
    }

    #! Dropping an SseObservable while its poll operation is still live must be safe
    /** The notifier poll operation reaches the observable through weak method call
        references, so the object is destroyed as soon as its owner drops the last
        strong reference — while the async I/O thread may be inside it.  %Qore
        destroys members only after the destructor returns, so without the lock pin
        in SseObservable the I/O thread is holding the observable's Mutex when that
        cleanup deletes it, and the dropping thread gets "LOCK-ERROR: TID N deleted
        Mutex object while TID M was holding the lock".

        SlowTeardownObservable widens that window to 250ms so each iteration gives
        the I/O thread many chances to enter the dying object; the observable is
        dropped with the stream still live and no stopEvents() call.
    */
    testTeardownWhileStreamActive() {
        string url = sprintf("http://localhost:%d/sse", port);
        for (int i = 0; i < 10; ++i) {
            TestObserver observer(2);
            {
                HttpClientIo::HttpClientConnectionManager mgr();
                # short idle timeout: the poll operation keeps ticking (and so
                # keeps re-entering the observable) throughout the teardown window
                SlowTeardownObservable obs(mgr, url, "GET", "/sse", NOTHING, NOTHING,
                    {"idle_timeout": 100ms}, 250);
                obs.registerObserver(observer);
                obs.observersReady();
                # connected + greeting
                assertEq(True, observer.waitForCount(2, 10s),
                    sprintf("iteration %d: stream delivered events", i));
                # obs is dropped here with the poll operation still active
            }
        }

        # the module is still usable after the teardown races above
        HttpClientIo::HttpClientConnectionManager mgr();
        HttpClientStreamingIo::SseObservable obs(mgr, url, "GET", "/sse");
        TestObserver observer(2);
        obs.registerObserver(observer);
        obs.observersReady();
        assertEq(True, observer.waitForCount(2, 10s), "stream works after teardown races");
        obs.stopEvents();
    }

    testHeartbeatPreventsIdleTimeout() {
        # Server heartbeat every 1s; idle timeout 2.5s so heartbeats reset it
        HeartbeatSseHandler hb_handler(1000);
        HttpServer hb_server(<HttpServerOptionInfo>{
            "logger": new Logger("hb-p", LoggerLevel::getLevelInfo()),
            "debug": True,
        });
        on_exit hb_server.stop();
        hb_server.setDefaultHandler("sse", hb_handler);
        int hb_port = hb_server.addListener(<HttpListenerOptionInfo>{"service": 0}).port;

        string url = sprintf("http://localhost:%d/sse", hb_port);
        HttpClientIo::HttpClientConnectionManager mgr();
        HttpClientStreamingIo::SseObservable obs(mgr, url, "GET", "/sse",
            NOTHING, NOTHING, {"idle_timeout": 2500ms});

        TestObserver observer(100);  # keep collecting
        obs.registerObserver(observer);
        obs.observersReady();

        # Observe for 3.5s — with 1s heartbeat and 2.5s idle timeout, the
        # connection must stay alive (no EVENT_SSE_CLOSED with idle-timeout)
        usleep(3500ms);

        list<hash<auto>> closed = (
            select observer.events,
            $1.event_id == HttpClientStreamingIo::EVENT_SSE_CLOSED
        );
        assertEq(0, closed.size(), "no idle-timeout fired");

        list<hash<auto>> hb_events = (
            select observer.events,
            $1.event_id == HttpClientStreamingIo::EVENT_SSE_HEARTBEAT
        );
        assertGe(2, hb_events.size(), "heartbeats kept the stream alive");

        obs.stopEvents();
    }

    testAsyncApiValidatedEvents() {
        AsyncApi::AsyncApi3Schema schema = createAsyncApiSchema();
        JsonSseHandler async_handler(schema);
        HttpServer async_server(<HttpServerOptionInfo>{
            "logger": new Logger("asyncapi-sse", LoggerLevel::getLevelInfo()),
            "debug": True,
        });
        on_exit async_server.stop();
        async_server.setDefaultHandler("sse", async_handler);
        int async_port = async_server.addListener(<HttpListenerOptionInfo>{"service": 0}).port;

        string url = sprintf("http://localhost:%d/sse", async_port);
        HttpClientIo::HttpClientConnectionManager mgr();
        HttpClientStreamingIo::SseObservable obs(mgr, url, "GET", "/sse",
            NOTHING, NOTHING, {
                "serialization": "json",
                "validator": schema,
                "asyncapi_channel": "events",
            });

        TestObserver observer(2);
        obs.registerObserver(observer);
        obs.observersReady();

        assertTrue(observer.waitForEvents(10s), "received connected + AsyncAPI data event");
        assertTrue(async_handler.validator_seen, "handler-level AsyncAPI validator was assigned to connection");

        list<hash<auto>> data_events = (
            select observer.events,
            $1.event_id == HttpClientStreamingIo::EVENT_SSE_DATA
        );
        assertEq(1, data_events.size(), "one data event");
        assertEq("greeting", data_events[0].data.event);
        assertEq("hello", data_events[0].data.data.message);

        obs.stopEvents();
    }

    testAsyncApiIncomingValidationFailure() {
        AsyncApi::AsyncApi3Schema schema = createAsyncApiSchema();
        InvalidJsonSseHandler invalid_handler();
        HttpServer invalid_server(<HttpServerOptionInfo>{
            "logger": new Logger("asyncapi-invalid-sse", LoggerLevel::getLevelInfo()),
            "debug": True,
        });
        on_exit invalid_server.stop();
        invalid_server.setDefaultHandler("sse", invalid_handler);
        int invalid_port = invalid_server.addListener(<HttpListenerOptionInfo>{"service": 0}).port;

        string url = sprintf("http://localhost:%d/sse", invalid_port);
        HttpClientIo::HttpClientConnectionManager mgr();
        HttpClientStreamingIo::SseObservable obs(mgr, url, "GET", "/sse",
            NOTHING, NOTHING, {
                "serialization": "json",
                "validator": schema,
                "asyncapi_channel": "events",
            });

        TestObserver observer(2);
        obs.registerObserver(observer);
        obs.observersReady();

        assertTrue(observer.waitForCount(2, 10s), "received connected + validation closed event");

        list<hash<auto>> data_events = (
            select observer.events,
            $1.event_id == HttpClientStreamingIo::EVENT_SSE_DATA
        );
        assertEq(0, data_events.size(), "invalid message was not delivered");

        list<hash<auto>> closed_events = (
            select observer.events,
            $1.event_id == HttpClientStreamingIo::EVENT_SSE_CLOSED
        );
        assertEq(1, closed_events.size(), "one closed event");
        assertEq("validation-error", closed_events[0].data.reason);
        assertEq("SCHEMA-VALIDATION-ERROR", closed_events[0].data.error.err);

        obs.stopEvents();
    }

    testAsyncApiOptionsAndOutboundValidation() {
        AsyncApi::AsyncApi3Schema schema = createAsyncApiSchema();

        HttpClientIo::HttpClientConnectionManager mgr();
        assertThrows("SSE-OBSERVABLE-OPTION-ERROR", sub () {
            new HttpClientStreamingIo::SseObservable(mgr, "http://localhost:1/sse", "GET", "/sse",
                NOTHING, NOTHING, {"validator": schema});
        });
        assertThrows("SSE-OBSERVABLE-OPTION-ERROR", sub () {
            new HttpClientStreamingIo::SseObservable(mgr, "http://localhost:1/sse", "GET", "/sse",
                NOTHING, NOTHING, {"asyncapi_channel": "events"});
        });
        assertThrows("SERVERSENTEVENTHANDLER-OPTION-ERROR", sub () {
            new ServerSentEventHandler(NOTHING, {"validator": schema});
        });
        assertThrows("SERVERSENTEVENTHANDLER-OPTION-ERROR", sub () {
            new ServerSentEventHandler(NOTHING, {"asyncapi_channel": "events"});
        });

        ServerSentEventHandler handler();
        Socket sock();
        ServerSentEventConnection conn(handler, sock, {}, {}, "asyncapi-unit");
        conn.setAsyncApiValidator(schema, "events");
        conn.send(<SseMessageInfo>{
            "event": "greeting",
            "data": {
                "message": "hello",
            },
        });
        assertThrows("SCHEMA-VALIDATION-ERROR", sub () {
            conn.send(<SseMessageInfo>{
                "event": "greeting",
                "data": {
                    "unexpected": True,
                },
            });
        });
    }
}
