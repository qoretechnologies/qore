#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%disable-warning module-only

%include ../../../../qlib/QUnit.qm

%exec-class QUnitTest

public class DIJClass inherits QUnit::DependencyInjectedTest {
    constructor() : DependencyInjectedTest("DIJClass", "1.0") {
    }

    private string getScriptPathImpl() {
        return get_script_path();
    }

    private performInjectionsImpl() {
    }
}

public class EmptyTest inherits QUnit::Test {
    constructor() : Test("EmptyTest", "1.0") {
    }

    static EmptyTest makeMe() {
        return new EmptyTest();
    }
}

public class QUnitTest inherits QUnit::Test {
    constructor() : Test("QUnitTest", "1.0") {
        addTestCase("nested test", \nestedTest());
        addTestCase("issue 3172", \issue3172());
        addTestCase("Dependency injection tests", \testInjectedClass());
        addTestCase("Test empty test", \testEmptyTest());
        addTestCase("misc test", \testMisc());
        addTestCase("assertion name truncation", \testTruncateAssertionName());

        set_return_value(main());
    }

    bool boolWrapper(callref f, softlist args) {
        call_function_args(f, args);
        return True;
    }

    nestedTest() {
        {
            Test test("NestedTest", "1.0");

            code test_code = sub () {
                test.assertTrue(True);
            };
            test.addTestCase("my test", test_code);
            test.main();
        }

        assertTrue(True);
    }

    issue3172() {
        assertThrows("TEST-SKIPPED-EXCEPTION", "fmt: 1", \testSkip(), ("fmt: %d", 1));
    }

    testMisc() {
        assertNeqSoft(1, 2);
        assertNeq(1, "1");
        assertRegex("x", "1x1");
        assertNRegex("z", "1x1");
        assertGt(2, 3);
        assertGtSoft(2, "3");
        assertGe(2, 3);
        assertGeSoft(2, "3");
        assertGe(2, 2);
        assertGeSoft(2, "2");
        assertLt(2, 1);
        assertLtSoft(2, "1");
        assertLe(2, 1);
        assertLeSoft(2, "1");
        assertLe(2, 2);
        assertLeSoft(2, "2");
        assertNothing(NOTHING);

        # check that asserts fail correctly and check error messages
        try {
            assertRegex("x", "y");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("TEST-EXCEPTION", ex.err);
            assertRegex("Regular Expression Match", ex.desc);
            # force the test that failed to pass
            assertionOk();
        }

        try {
            assertNRegex("x", "1x1");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("TEST-EXCEPTION", ex.err);
            assertRegex("Negative Regular Expression Match", ex.desc);
            # force the test that failed to pass
            assertionOk();
        }

        try {
            assertNeqSoft(1, "1");
        } catch (hash<ExceptionInfo> ex) {
            #printf("%s: %s\n", ex.err, ex.desc);
            assertEq("TEST-EXCEPTION", ex.err);
            assertRegex("identical", ex.desc);
            # force the test that failed to pass
            assertionOk();
        }

        try {
            assertNeq(1, "1");
        } catch (hash<ExceptionInfo> ex) {
            #printf("%s: %s\n", ex.err, ex.desc);
            assertEq("TEST-EXCEPTION", ex.err);
            assertRegex("identical", ex.desc);
            # force the test that failed to pass
            assertionOk();
        }

        try {
            assertNeq(1, 1);
        } catch (hash<ExceptionInfo> ex) {
            #printf("%s: %s\n", ex.err, ex.desc);
            assertEq("TEST-EXCEPTION", ex.err);
            assertRegex("identical", ex.desc);
            # force the test that failed to pass
            assertionOk();
        }

        try {
            assertGt(2, 2);
        } catch (hash<ExceptionInfo> ex) {
            on_error printf("%s: %s\n", ex.err, ex.desc);
            assertEq("TEST-EXCEPTION", ex.err);
            assertRegex("Expected Greater Than", ex.desc);
            # force the test that failed to pass
            assertionOk();
        }

        try {
            assertGt(2, "3");
        } catch (hash<ExceptionInfo> ex) {
            #printf("%s: %s\n", ex.err, ex.desc);
            assertEq("TEST-EXCEPTION", ex.err);
            assertRegex("Expected Greater Than", ex.desc);
            # force the test that failed to pass
            assertionOk();
        }

        try {
            assertGe(2, 3);
        } catch (hash<ExceptionInfo> ex) {
            #printf("%s: %s\n", ex.err, ex.desc);
            assertEq("TEST-EXCEPTION", ex.err);
            assertRegex("Expected Greater Than", ex.desc);
            # force the test that failed to pass
            assertionOk();
        }

        try {
            assertGe(2, "3");
        } catch (hash<ExceptionInfo> ex) {
            #printf("%s: %s\n", ex.err, ex.desc);
            assertEq("TEST-EXCEPTION", ex.err);
            assertRegex("Expected Greater Than", ex.desc);
            # force the test that failed to pass
            assertionOk();
        }

        try {
            assertLt(2, 2);
        } catch (hash<ExceptionInfo> ex) {
            #printf("%s: %s\n", ex.err, ex.desc);
            assertEq("TEST-EXCEPTION", ex.err);
            assertRegex("Expected Less Than", ex.desc);
            # force the test that failed to pass
            assertionOk();
        }

        try {
            assertLt(2, "1");
        } catch (hash<ExceptionInfo> ex) {
            #printf("%s: %s\n", ex.err, ex.desc);
            assertEq("TEST-EXCEPTION", ex.err);
            assertRegex("Expected Less Than", ex.desc);
            # force the test that failed to pass
            assertionOk();
        }

        try {
            assertLe(2, 1);
        } catch (hash<ExceptionInfo> ex) {
            #printf("%s: %s\n", ex.err, ex.desc);
            assertEq("TEST-EXCEPTION", ex.err);
            assertRegex("Expected Less Than Or Equal To", ex.desc);
            # force the test that failed to pass
            assertionOk();
        }

        try {
            assertLe(2, "1");
        } catch (hash<ExceptionInfo> ex) {
            #printf("%s: %s\n", ex.err, ex.desc);
            assertEq("TEST-EXCEPTION", ex.err);
            assertRegex("Expected Less Than Or Equal To", ex.desc);
            # force the test that failed to pass
            assertionOk();
        }

        # check that asserts fail correctly and check error messages
        try {
            assertNothing(1);
        } catch (hash<ExceptionInfo> ex) {
            #printf("%s: %s\n", ex.err, ex.desc);
            assertEq("TEST-EXCEPTION", ex.err);
            #assertRegex("Regular Expression Match", ex.desc);
            # force the test that failed to pass
            assertionOk();
        }

        {
            list<string> l1 = ("hello\nworld",);
            list<string> l2 = ("hello\nmars",);
            try {
                assertEq(l1, l2);
                assertTrue(False);
            } catch (hash<ExceptionInfo> ex) {
                on_error printf("desc: %y\n", ex.desc);
                assertTrue(ex.desc =~ /hello\\nworld/);
                assertTrue(ex.desc =~ /hello\\nmars/);
            }
        }
    }

    testTruncateAssertionName() {
        # save and restore the global so changes don't leak across test cases
        *int saved = QUnit::name_max_chars;
        on_exit QUnit::name_max_chars = saved;

        QUnit::name_max_chars = 80;

        # short single-line names pass through unchanged
        assertEq("short name", QUnit::Test::truncateAssertionName("short name"));

        # multi-line names collapse at the first newline with a trailing "..."
        assertEq("first line...", QUnit::Test::truncateAssertionName("first line\nsecond line"));

        # \r\n line endings: the trailing \r before the \n is stripped
        assertEq("first line...", QUnit::Test::truncateAssertionName("first line\r\nsecond"));

        # over-long single-line names are cut to exactly the budget, including the "..."
        string long_name = strmul("x", 200);
        string truncated = QUnit::Test::truncateAssertionName(long_name);
        assertEq(80, truncated.length(), "truncated length matches name_max_chars");
        assertEq("...", truncated.substr(truncated.length() - 3));
        assertEq(strmul("x", 77), truncated.substr(0, 77));

        # a non-positive limit disables truncation entirely
        QUnit::name_max_chars = 0;
        assertEq(long_name, QUnit::Test::truncateAssertionName(long_name));
        string mline = "line one\nline two";
        assertEq(mline, QUnit::Test::truncateAssertionName(mline));

        # multi-byte characters are counted as characters, not bytes (each "é" is 2 bytes in UTF-8)
        QUnit::name_max_chars = 10;
        string multibyte = strmul("é", 20);
        string mb_trunc = QUnit::Test::truncateAssertionName(multibyte);
        assertEq(10, mb_trunc.length(), "char-counted, not byte-counted");
        assertEq(strmul("é", 7) + "...", mb_trunc);
    }

    testInjectedClass() {
        DIJClass dit();

        # Try to instantiate a second dependency injected test
        assertThrows("TESTING-EXCEPTION", "Only one instance of", sub () { new DIJClass(); });
    }

    testEmptyTest() {
        EmptyTest t();
        assertThrows("TESTING-EXCEPTION", "define some tests first", \t.main());
    }
}
