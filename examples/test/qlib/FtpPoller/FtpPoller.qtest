#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%include  ../../qore/classes/FtpServer.qc

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires FsUtil
%requires QUnit
%requires DataProvider
%requires FtpPollerUtil
%requires FtpPoller

%exec-class FtpPollerTest

class MyFtpPoller inherits FtpPoller {
    public {
        list<hash<FtpPollerFileEventInfo>> files;
    }

    private {
        hash<auto> opts;
    }

    constructor(FtpClient ftp, hash<auto> opts) : FtpPoller(ftp, opts) {
        self.opts = opts;
    }

    singleFileEvent(hash<FtpPollerFileEventInfo> fih) {
        files += fih;
    }

    postSingleFileEvent(hash<FtpPollerFileEventInfo> fih) {
    }

    #! Returns the error retry delay in effect (used to verify the "error_delay" option)
    int getErrorDelay() {
        return error_delay;
    }
}

#! a poller that reports its polls and its destruction
class LifetimeFtpPoller inherits FtpPoller {
    private {
        Queue events;
        #! released when the poller is destroyed, which ends the sleep closure's wait
        Counter release;
    }

    constructor(FtpClient ftp, hash<auto> opts, Queue events, Counter release) : FtpPoller(ftp, opts) {
        self.events = events;
        self.release = release;
    }

    destructor() {
        events.push({"destructor": gettid()});
        release.dec();
    }

    *bool fileEvent(list<hash<FtpPollerFileEventInfo>> l) {
        events.push({"poll": gettid()});
        return False;
    }

    singleFileEvent(hash<FtpPollerFileEventInfo> fih) {
    }

    postSingleFileEvent(hash<FtpPollerFileEventInfo> fih) {
    }
}

#! a poller created with the hash-only constructor
class MyHostFtpPoller inherits FtpPoller {
    public {
        list<hash<FtpPollerFileEventInfo>> files;
    }

    constructor(hash<auto> opts) : FtpPoller(opts) {
    }

    singleFileEvent(hash<FtpPollerFileEventInfo> fih) {
        files += fih;
    }

    postSingleFileEvent(hash<FtpPollerFileEventInfo> fih) {
    }
}

class FtpPollerTest inherits QUnit::Test {
    public {
    }

    private {
        const Files = (
            "file_1_",
            "file_2_",
            "file_3_",
            "file_4_",
        );
    }

    constructor() : Test("FtpPollerTest", "1.0") {
        addTestCase("main test", \mainTest());
        addTestCase("error delay option test", \errorDelayOptionTest());
        addTestCase("dropping the last reference to a started poller stops its thread", \lastReferenceTest());
        addTestCase("error logging test", \errorLoggingTest());
        addTestCase("data provider test", \dataProviderTest());
        addTestCase("start_thread from the thread's capability", \capabilityTest());
        addTestCase("start_thread from the thread's capability in a restricted Program", \restrictedCapabilityTest());
        addTestCase("regex mask test", \regexMaskTest());
        addTestCase("an observer refusal keeps the file and polling", \observerRefusalTest());
        addTestCase("a post-transfer error stops polling", \postTransferErrorStopsTest());
        addTestCase("relative paths", \relativePathTest());
        addTestCase("a failed setup of a new connection is retried", \newConnectionSetupRetryTest());
        addTestCase("a failed setup of a new connection is retried by a started poller",
            \newConnectionSetupRetryStartedTest());

        # Return for compatibility with test harness that checks return value
        set_return_value(main());
    }

    int getPort() {
        int port;
        if (m_options.port) {
            port = m_options.port;
        } else if (ENV.FTPCLIENT_TEST_PORT) {
            port = ENV.FTPCLIENT_TEST_PORT.toInt();
        } else {
            port = 0;
        }

        return port;
    }

    private mainTest() {
        int port = getPort();

        # PORT only supports IPv4, so we can't use "localhost", which may resolve
        # to an IPv6 address
        FtpServer serv(port, m_options.verbose - 1, "127.0.0.1");
        on_exit serv.shutdown();

        port = serv.getPort();

        FtpClient ftp_client(url: "ftp://user:pass@127.0.0.1:" + port);
        Queue queue();
        ftp_client.setWarningQueue(warning_ms: 20000, warning_bytes: 20000, queue: queue, argument: "test");
        assertNothing(ftp_client.connect());

        TmpDir tmp_dir();
        string dir = tmp_dir.path;
        # printf("DIR: %y\n", dir);
        serv.setPwd(dir);

        list<TmpFile> files;
        map files += new TmpFile("ftp_test_" + $1, NOTHING, dir), Files;

        hash<string, bool> file_paths;
        map file_paths{$1.path} = True, files;

        # printf("files: %y\n", file_paths);

        MyFtpPoller poller(ftp_client, {"path": tmp_dir.path});
        assertEq(FtpPoller::ErrorDelaySeconds, poller.getErrorDelay());
        assertTrue(poller.runOnce());

        foreach hash<FtpPollerFileEventInfo> file in (poller.files) {
            on_error printf("file: %y file_paths: %y\n", file - "data", keys file_paths);
            assertTrue(file.name != NOTHING);
            assertTrue(file_paths.hasKey(file.filepath));
        }
    }

    #! the polling thread holds the poller only for each poll: dropping the owner's reference destroys the poller,
    #! whose destructor stops the thread and waits for it (qorus#867)
    private lastReferenceTest() {
        int port = getPort();
        FtpServer serv(port, m_options.verbose - 1, "127.0.0.1");
        on_exit serv.shutdown();
        TmpDir tmp_dir();
        serv.setPwd(tmp_dir.path);
        port = serv.getPort();
        # a file, so that each poll reports its list
        TmpFile f("ftp_lifetime_", NOTHING, tmp_dir.path);

        Queue events();
        # the polling thread sleeps in this closure, which refers to no poller, until the poller is destroyed: the
        # reference is dropped while the thread holds none
        Counter release(1);
        code sleeper = sub (int secs) {
            events.push({"sleeping": gettid()});
            release.waitForZero();
        };
        int tid;
        {
            LifetimeFtpPoller poller(new FtpClient("ftp://user:pass@127.0.0.1:" + port), {
                "path": tmp_dir.path,
                "poll_interval": 3600,
                "sleep": sleeper,
            }, events, release);
            tid = poller.start();
            assertEq({"poll": tid}, events.get(60s), "the polling thread polls");
            assertEq({"sleeping": tid}, events.get(60s), "and sleeps");
        }
        # the sleep closure can run again after the subclass destructor has released it, before the poller stops
        assertEq(({"destructor": gettid()},), (select (map events.get(), xrange(events.size())), $1.destructor),
            "the poller was destroyed in the thread that dropped its last reference, which the thread had left");
    }

    # issue #3377: an empty "regex_mask" matches every file with both constructors
    private regexMaskTest() {
        int port = getPort();

        # PORT only supports IPv4, so we can't use "localhost", which may resolve
        # to an IPv6 address
        FtpServer serv(port, m_options.verbose - 1, "127.0.0.1");
        on_exit serv.shutdown();

        TmpDir tmp_dir();
        string dir = tmp_dir.path;
        serv.setPwd(dir);

        port = serv.getPort();

        TmpFile txt1("regex_mask_test_", ".txt", dir);
        TmpFile txt2("regex_mask_test_", ".txt", dir);
        TmpFile dat("regex_mask_test_", ".dat", dir);
        list<string> all = sort(map basename($1.path), (txt1, txt2, dat));
        list<string> txt = sort(map basename($1.path), (txt1, txt2));

        code get_names = list<string> sub (list<hash<FtpPollerFileEventInfo>> files) {
            return sort(map $1.name, files);
        };

        # runs one poll with the FtpClient constructor and returns the names of the files found
        code poll_client = list<string> sub (hash<auto> opts) {
            FtpClient ftp_client(url: "ftp://user:pass@127.0.0.1:" + port);
            MyFtpPoller poller(ftp_client, {"path": dir} + opts);
            assertTrue(poller.runOnce());
            return get_names(poller.files);
        };

        # runs one poll with the hash-only constructor and returns the names of the files found
        code poll_host = list<string> sub (hash<auto> opts) {
            MyHostFtpPoller poller({
                "host": "127.0.0.1",
                "port": port,
                "user": "user",
                "pass": "pass",
                "path": dir,
            } + opts);
            assertTrue(poller.runOnce());
            return get_names(poller.files);
        };

        foreach code poll in ((poll_client, poll_host)) {
            # an empty regex mask matches every file, also when it overrides a glob mask
            assertEq(all, poll({"regex_mask": ""}));
            assertEq(all, poll({"regex_mask": "", "mask": "*.dat"}));
            # a regex mask overrides the glob mask
            assertEq(txt, poll({"regex_mask": "\\.txt$", "mask": "*.dat"}));
            # without a regex mask, the glob mask is used
            assertEq((basename(dat.path),), poll({"regex_mask": NOTHING, "mask": "*.dat"}));
            assertEq(all, poll({}));
        }
    }

    private errorDelayOptionTest() {
        assertEq(FtpPoller::ErrorDelaySeconds,
            FtpPollerDataProviderBase::ConstructorOptions.error_delay.default_value);
        assertEq(FtpPoller::ErrorDelaySeconds, FtpPoller::ErrorDelay.durationSeconds());

        int port = getPort();

        FtpServer serv(port, m_options.verbose - 1, "127.0.0.1");
        on_exit serv.shutdown();

        TmpDir tmp_dir();
        serv.setPwd(tmp_dir.path);

        port = serv.getPort();

        FtpClient ftp_client(url: "ftp://user:pass@127.0.0.1:" + port);
        assertEq(5, new MyFtpPoller(ftp_client, {"path": tmp_dir.path, "error_delay": 5}).getErrorDelay());
        # a string value must be converted like "poll_interval"
        assertEq(7, new MyFtpPoller(ftp_client, {"path": tmp_dir.path, "error_delay": "7"}).getErrorDelay());

        # the option is validated before any connection is attempted
        assertThrows("FTPPOLLER-CONSTRUCTOR-ARG-ERROR", "error_delay cannot be <= 0",
            sub () {
                new MyFtpPoller(ftp_client, {"path": tmp_dir.path, "error_delay": 0});
            }
        );
        assertThrows("FTPPOLLER-CONSTRUCTOR-ARG-ERROR", "error_delay cannot be <= 0",
            sub () {
                new MyFtpPoller(ftp_client, {"path": tmp_dir.path, "error_delay": -1});
            }
        );
        # the hash-only constructor used by the data providers reports FTPPOLLER-CONSTRUCTOR-ERROR
        assertThrows("FTPPOLLER-CONSTRUCTOR-ERROR", "error_delay cannot be <= 0",
            sub () {
                new FtpDelayedPollerDataProvider({
                    "url": "ftp://user:pass@127.0.0.1:1/tmp",
                    "error_delay": 0,
                });
            }
        );
    }

    private errorLoggingTest() {
        int port = getPort();

        FtpServer serv(port, m_options.verbose - 1, "127.0.0.1");
        on_exit serv.shutdown();

        TmpDir tmp_dir();
        serv.setPwd(tmp_dir.path);
        # make every directory listing fail so that the poll loop always takes the error path
        serv.setBroken("nlst", 100ms);

        port = serv.getPort();

        # errors must be reported through "log_error" when it is set
        {
            MessageCollector errors();
            MessageCollector info();
            FtpClient ftp_client(url: "ftp://user:pass@127.0.0.1:" + port);
            MyFtpPoller poller(ftp_client, {
                "path": tmp_dir.path,
                "error_delay": 1,
                "log_error": sub (string msg) { errors.add(msg); },
                "log_info": sub (string msg) { info.add(msg); },
            });
            on_exit poller.stop();

            poller.start();
            assertRegex("FTP error in .*; waiting 1s for next try", errors.waitForMatch("FTP error in "));
            # informational messages must not carry the error
            assertThrows("MESSAGE-TIMEOUT", \info.waitForMatch(), ("FTP error in ", 0));
        }

        # without "log_error", errors must fall back to "log_info" so that they are never lost
        {
            MessageCollector info();
            FtpClient ftp_client(url: "ftp://user:pass@127.0.0.1:" + port);
            MyFtpPoller poller(ftp_client, {
                "path": tmp_dir.path,
                "error_delay": 1,
                "log_info": sub (string msg) { info.add(msg); },
            });
            on_exit poller.stop();

            poller.start();
            assertRegex("FTP error in ", info.waitForMatch("FTP error in "));
        }
    }

    # issue #6400: an observer that refuses a file event leaves the remote file in place, and polling continues, so
    # the file is handled again after the error delay, once the observer accepts it
    private observerRefusalTest() {
        Logger logger("test", LoggerLevel::getLevelInfo());
        CapturingAppender capture();
        logger.addAppender(capture);

        # PORT only supports IPv4, so we can't use "localhost", which may resolve to an IPv6 address
        FtpServer serv(getPort(), m_options.verbose - 1, "127.0.0.1");
        on_exit serv.shutdown();

        TmpDir tmp_dir();
        serv.setPwd(tmp_dir.path);
        serv.setDirect();
        int port = serv.getPort();

        string remote_path = tmp_dir.path + DirSep + "refused.txt";
        File f();
        f.open2(remote_path, O_CREAT | O_TRUNC | O_WRONLY);
        f.write("data");
        f.close();

        # refuses the first two events and accepts the third
        RefusingObserver observer(2);
        # the retries after a refusal must wait the error delay, not the poll interval, which the test would not meet
        FtpDelayedPollerDataProvider prov({
            "url": sprintf("ftp://user:pass@127.0.0.1:%d%s", port, tmp_dir.path),
            "poll_interval": 3600,
            "error_delay": 1,
            "remote_file_disposition": "DELETE",
        });
        prov.setLogger(logger);
        prov.registerObserver(observer);
        on_exit prov.stopEvents();
        prov.observersReady();

        hash<auto> event = observer.waitAccepted(capture);
        # stopping cancels an FTP command in progress, so the deletion of the accepted file is waited for first
        capture.waitForMatch("refused\\.txt.*: deleted on the remote host");
        prov.stopEvents();

        assertEq("refused.txt", event.name);
        # the file was delivered again after each refusal: polling went on
        assertEq(3, observer.getAttempts());
        assertFalse(is_file(remote_path), "the remote file of the accepted event was deleted; poller log:\n"
            + capture.getLog());
        assertRegex("event handler error in .*REFUSED.*the remote file is kept", capture.getLog());
    }

    # issue #6457: a relative path is resolved against the login directory, like an absolute path; a single relative
    # path failed on every poll, as the poll changed into it again from the directory that setup had changed into
    private relativePathTest() {
        # PORT only supports IPv4, so we can't use "localhost", which may resolve to an IPv6 address
        FtpServer serv(getPort(), m_options.verbose - 1, "127.0.0.1");
        on_exit serv.shutdown();

        TmpDir root();
        serv.setPwd(root.path);
        # the fixture serves the files themselves (by their absolute paths)
        serv.setDirect();
        int port = serv.getPort();

        mkdir(root.path + DirSep + "sub1");
        mkdir(root.path + DirSep + "sub2");
        File f();
        foreach list<string> l in ((("in-login-dir.txt", "login"), ("sub1/one.txt", "one"),
                ("sub2/two.txt", "two"))) {
            f.open2(root.path + DirSep + l[0], O_CREAT | O_TRUNC | O_WRONLY);
            f.write(l[1]);
            f.close();
        }

        # a single relative path, polled twice, and after the client connects again (in the login directory)
        {
            FtpClient client("ftp://user:pass@127.0.0.1:" + port);
            MyFtpPoller poller(client, {"path": "sub1"});
            for (int i = 0; i < 3; ++i) {
                if (i == 2) {
                    client.disconnect();
                    # the fixture has one working directory for all connections: a new connection starts in the
                    # login directory
                    serv.setPwd(root.path);
                    client.connect();
                }
                poller.files = ();
                assertTrue(poller.runOnce(), sprintf("poll %d", i + 1));
                assertEq(("one.txt",), map $1.name, poller.files);
                assertEq(root.path + "/sub1/one.txt", poller.files[0].filepath);
                assertEq(binary("one"), poller.files[0].data);
            }
        }

        # several relative paths
        {
            serv.setPwd(root.path);
            MyFtpPoller poller(new FtpClient("ftp://user:pass@127.0.0.1:" + port), {"path": ("sub1", "sub2/")});
            for (int i = 0; i < 2; ++i) {
                poller.files = ();
                assertTrue(poller.runOnce(), sprintf("poll %d", i + 1));
                assertEq(("one.txt", "two.txt"), map $1.name, poller.files);
                assertEq((root.path + "/sub1/one.txt", root.path + "/sub2/two.txt"), map $1.filepath, poller.files);
                assertEq((binary("one"), binary("two")), map $1.data, poller.files);
            }
        }

        # an absolute path with a trailing "/"
        {
            serv.setPwd(root.path);
            MyFtpPoller poller(new FtpClient("ftp://user:pass@127.0.0.1:" + port), {"path": root.path + "/sub2/"});
            assertTrue(poller.runOnce());
            assertEq((root.path + "/sub2/two.txt",), map $1.filepath, poller.files);
        }

        # the login directory ("."), the default; the file path is relative, which this fixture serves only without
        # the files themselves, so another server serves the directory
        {
            FtpServer serv2(getPort(), m_options.verbose - 1, "127.0.0.1");
            on_exit serv2.shutdown();
            serv2.setPwd(root.path);
            MyFtpPoller poller(new FtpClient("ftp://user:pass@127.0.0.1:" + serv2.getPort()), {"mask": "*.txt"});
            assertTrue(poller.runOnce());
            assertEq(("in-login-dir.txt",), map $1.name, poller.files);
            assertEq("in-login-dir.txt", poller.files[0].filepath);
        }
    }

    # issue #6456: a failed setup of a new FtpClient given with updateOptions() is retried after the error delay, and
    # the state of the previous connection (login directory, user, URL) is not kept for the new one
    private newConnectionSetupRetryTest() {
        newConnectionSetupRetry(True);
    }

    # the same with the poller's own polling thread (start()), which polls as startInline() does
    private newConnectionSetupRetryStartedTest() {
        newConnectionSetupRetry(False);
    }

    private newConnectionSetupRetry(bool inline) {
        # PORT only supports IPv4, so we can't use "localhost", which may resolve to an IPv6 address
        FtpServer serv1(getPort(), m_options.verbose - 1, "127.0.0.1");
        on_exit serv1.shutdown();
        FtpServer serv2(getPort(), m_options.verbose - 1, "127.0.0.1");
        on_exit serv2.shutdown();

        TmpDir root1();
        TmpDir root2();
        serv1.setPwd(root1.path);
        serv2.setPwd(root2.path);

        mkdir(root1.path + DirSep + "sub");
        File f();
        f.open2(root1.path + DirSep + "sub" + DirSep + "first.txt", O_CREAT | O_TRUNC | O_WRONLY);
        f.close();

        MessageCollector msgs();
        EventCollectingFtpPoller poller(new FtpClient("ftp://user1:pass@127.0.0.1:" + serv1.getPort()), {
            "path": "sub",
            "poll_interval": 1,
            "error_delay": 1,
            "log_error": sub (string msg) { msgs.add(msg); },
            "log_info": sub (string msg) { msgs.add(msg); },
        });

        # runs the poller inline in another thread, which ends when polling stops, or in its own polling thread
        Counter done(1);
        if (inline) {
            background sub () {
                on_exit done.dec();
                try {
                    poller.startInline();
                } catch (hash<ExceptionInfo> ex) {
                    msgs.add(sprintf("polling stopped: %s: %s", ex.err, ex.desc));
                }
            }();
        } else {
            done.dec();
            poller.start();
        }
        on_exit {
            if (inline) {
                poller.stopNoWait();
                # only a guard against a hang
                done.waitForZero(30s);
            } else {
                poller.stop();
            }
        }

        poller.waitFor("first.txt");

        mkdir(root2.path + DirSep + "sub");
        f.open2(root2.path + DirSep + "sub" + DirSep + "second.txt", O_CREAT | O_TRUNC | O_WRONLY);
        f.close();

        # a new connection whose setup fails at the connection: its server refuses the login
        int port2 = serv2.getPort();
        serv2.setRejectLogin();
        poller.updateOptions(new FtpClient("ftp://user2:pass@127.0.0.1:" + port2));
        msgs.waitForMatch("^FTP error in .*waiting 1s for next try");

        # the setup is retried, succeeds once the server accepts the login, and the new connection is polled in its
        # own login directory
        serv2.setRejectLogin(False);
        poller.waitFor("second.txt");

        hash<auto> state = poller.getConnectionState();
        assertEq(root2.path, state.root);
        assertEq("user2", state.user);
        assertRegex("^ftp://user2@127\\.0\\.0\\.1:" + port2 + "$", state.url);
        assertEq(0, (select msgs.getAll(), $1 =~ /polling stopped|polling terminated/).size(), "polling went on");
    }

    # an error after a file was handled is fatal: polling stops, so the file is not handled more than once
    private postTransferErrorStopsTest() {
        FtpServer serv(getPort(), m_options.verbose - 1, "127.0.0.1");
        on_exit serv.shutdown();

        TmpDir tmp_dir();
        serv.setPwd(tmp_dir.path);
        int port = serv.getPort();

        TmpFile tf("ftp_post_error_", NOTHING, tmp_dir.path);

        FailingPostFtpPoller poller(new FtpClient("ftp://user:pass@127.0.0.1:" + port), {
            "path": tmp_dir.path,
            "poll_interval": 1,
            "error_delay": 1,
        });

        # runs the poller inline in another thread, which ends when polling stops
        Counter done(1);
        *hash<ExceptionInfo> stop_ex;
        background sub () {
            on_exit done.dec();
            try {
                poller.startInline();
            } catch (hash<ExceptionInfo> ex) {
                stop_ex = ex;
            }
        }();
        on_exit poller.stopNoWait();

        # only a guard against a hang
        assertEq(0, done.waitForZero(30s), "polling stopped after the post-transfer error");
        assertEq("POST-ERROR", stop_ex.err);
        assertEq((basename(tf.path),), poller.files);
    }

    #! without the option, a poller created in a host's capability scope starts its thread with the host's
    #! start_thread (qorus#867)
    private capabilityTest() {
        int port = getPort();
        FtpServer serv(port, m_options.verbose - 1, "127.0.0.1");
        on_exit serv.shutdown();
        TmpDir tmp_dir();
        serv.setPwd(tmp_dir.path);
        port = serv.getPort();

        Queue started();
        MyFtpPoller poller;
        {
            ThreadCapabilityScope scope({"start_thread": int sub (code<nothing()> c) {
                started.push(True);
                return background c();
            }});
            poller = new MyFtpPoller(new FtpClient("ftp://user:pass@127.0.0.1:" + port), {
                "path": tmp_dir.path,
                "error_delay": 1,
            });
        }
        # the capability is taken when the poller is created, so it is used after the scope
        poller.start();
        on_exit poller.stop();
        assertEq(1, started.size(), "the polling thread was started with the host's start_thread");

        # a poller created outside a scope does not use it
        MyFtpPoller poller2(new FtpClient("ftp://user:pass@127.0.0.1:" + port), {
            "path": tmp_dir.path,
            "error_delay": 1,
        });
        poller2.start();
        on_exit poller2.stop();
        assertEq(1, started.size(), "outside a scope the host's start_thread is not used");
    }

    #! a restricted Program that loads the module first: the module declares THREAD_CONTROL (qorus#867)
    /** The module's requirement is set when it is first loaded, so the restricted Program must load it first: the
        check runs in a child process whose main Program does not load the module
    */
    private restrictedCapabilityTest() {
        int port = getPort();
        FtpServer serv(port, m_options.verbose - 1, "127.0.0.1");
        on_exit serv.shutdown();
        port = serv.getPort();
        TmpDir dir("FtpPollerRestricted-");
        serv.setPwd(dir.path);
        string script = dir.path + "/restricted.q";
        File f();
        f.open2(script, O_CREAT | O_TRUNC | O_WRONLY);
        f.write(RestrictedScript);
        f.close();
        string qore_bin = ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        string module_dir = get_script_dir() + "/../../../../qlib"
            + (ENV.QORE_MODULE_DIR ? ":" + ENV.QORE_MODULE_DIR : "");
        string out = backquote(sprintf("QORE_MODULE_DIR=%s %s -b %s %s %d 2>&1", module_dir, qore_bin, script,
            dir.path, port));
        # the result lines; the loader can warn of modules that the restricted Program loads from source
        list<string> lines = select out.split("\n"), $1 =~ /^(no-)?scope: /;
        # the module declares the THREAD_CONTROL domain, so a restricted Program that loads it first needs no option
        assertEq("no-scope: created", lines[0], "without a scope, the poller is created without the option: " + out);
        assertEq("scope: created", lines[1], "in a scope, the poller is created with the capability: " + out);
    }

    private {
        #! a host whose restricted Program loads FtpPoller first and creates a poller in and out of a scope
        const RestrictedScript = "%new-style
%require-types
%strict-args
Program p(PO_NEW_STYLE | PO_REQUIRE_TYPES | PO_STRICT_ARGS | PO_NO_THREAD_CONTROL);
p.loadModule(\"FtpPoller\");
p.parse(\"class RestrictedPoller inherits FtpPoller::FtpPoller {
    constructor(FtpClient c, hash<auto> opts) : FtpPoller::FtpPoller(c, opts) {}
    singleFileEvent(hash<FtpPoller::FtpPollerFileEventInfo> event) {}
    postSingleFileEvent(hash<FtpPoller::FtpPollerFileEventInfo> event) {}
}
object sub make(string dir, int port) {
    return new RestrictedPoller(new FtpClient(\\\"ftp://user:pass@127.0.0.1:\\\" + port), {\\\"path\\\": dir,
        \\\"sleep\\\": sub (softint s) {}});
}\", \"restricted\");
string dir = ARGV[0];
int port = ARGV[1].toInt();
try {
    p.callFunction(\"make\", dir, port);
    printf(\"no-scope: created\\n\");
} catch (hash<ExceptionInfo> ex) {
    printf(\"no-scope: %s\\n\", ex.err);
}
{
    ThreadCapabilityScope scope({\"start_thread\": int sub (code c) { return background c(); }});
    try {
        p.callFunction(\"make\", dir, port);
        printf(\"scope: created\\n\");
    } catch (hash<ExceptionInfo> ex) {
        printf(\"scope: %s: %s\\n\", ex.err, ex.desc);
    }
}
";
    }

    private dataProviderTest() {
        # NOTE: the logger must be at least at INFO level, and its output must be captured, so that any FTP error
        # reported by the poller is available if no file events arrive; otherwise a failure here gives no information
        # about the underlying error at all
        LoggerLevel level = m_options.verbose > 3 ? LoggerLevel::getLevelDebug() : LoggerLevel::getLevelInfo();
        Logger logger("test", level);
        CapturingAppender capture();
        logger.addAppender(capture);
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }

        int port = getPort();

        # PORT only supports IPv4, so we can't use "localhost", which may resolve
        # to an IPv6 address
        FtpServer serv(port, m_options.verbose - 1, "127.0.0.1");
        on_exit serv.shutdown();

        TmpDir tmp_dir();
        string dir = tmp_dir.path;
        serv.setPwd(dir);
        serv.setDirect();

        port = serv.getPort();

        TmpDir local_dir();
        MyObserver observer();
        FtpDelayedPollerDataProvider prov({
            "url": sprintf("ftp://user:pass@127.0.0.1:%d%s", port, tmp_dir.path),
            "poll_interval": 1,
            # NOTE: the default is 1 minute, which would guarantee a test failure if the first poll fails for any
            # transient reason; with 1s the poller recovers well inside the event wait below
            "error_delay": 1,
            "local_dir": local_dir.path,
            "remote_file_disposition": "NONE",
        });
        prov.setLogger(logger);
        prov.registerObserver(observer);
        on_exit prov.stopEvents();

        list<TmpFile> files;
        map files += new TmpFile("ftp_test_" + $1, NOTHING, dir), Files;
        map $1.file.write(get_random_string()), files;

        prov.observersReady();

        hash<string, hash<auto>> event_map = observer.wait(files.size(), capture);
        prov.stopEvents();
        assertEq(files.size(), event_map.size());
        map assertEq($1, event_map{$1}.name), (map basename($1.path), files);

        map assertEq(File::readBinaryFile($1.path),
            File::readBinaryFile(local_dir.path + DirSep + basename($1.path)), basename($1.path)),
            files;
    }
}

#! A poller that collects the names of the files of its events, and can wait for one
class EventCollectingFtpPoller inherits FtpPoller {
    private {
        list<string> ev_names();
        Mutex ev_m();
        Condition ev_cond();
    }

    constructor(FtpClient ftp, hash<auto> opts) : FtpPoller(ftp, opts) {
    }

    singleFileEvent(hash<FtpPollerFileEventInfo> fih) {
        AutoLock al(ev_m);
        ev_names += fih.name;
        ev_cond.broadcast();
    }

    postSingleFileEvent(hash<FtpPollerFileEventInfo> fih) {
    }

    #! Waits for an event for the file \a name; the timeout only guards against a hang
    waitFor(string name, timeout to = 30s) {
        int start = clock_get_monotonic_us();
        AutoLock al(ev_m);
        while (!(select ev_names, $1 == name)) {
            int left_ms = to - (clock_get_monotonic_us() - start) / 1000;
            if (left_ms <= 0) {
                throw "ERROR", sprintf("no event for %y in %dms; events: %y", name, to, ev_names);
            }
            ev_cond.wait(ev_m, left_ms);
        }
    }

    #! Returns the state of the current connection
    hash<auto> getConnectionState() {
        return {"root": rootFtpPath, "user": user, "url": url};
    }
}

#! A poller whose post-transfer handling fails
class FailingPostFtpPoller inherits FtpPoller {
    public {
        list<string> files();
    }

    constructor(FtpClient ftp, hash<auto> opts) : FtpPoller(ftp, opts) {
    }

    singleFileEvent(hash<FtpPollerFileEventInfo> fih) {
        files += fih.name;
    }

    postSingleFileEvent(hash<FtpPollerFileEventInfo> fih) {
        throw "POST-ERROR", sprintf("cannot dispose of %y", fih.name);
    }
}

#! An observer that refuses a number of events by throwing, and then accepts the next one
class RefusingObserver inherits Observer {
    public {
        #! how long to wait for the accepted event; only a guard against a hang
        const EventTimeout = 30s;
    }

    private {
        #! the number of events to refuse
        int refusals;
        #! the number of events received
        int attempts = 0;
        #! the accepted event
        *hash<auto> accepted;
        Mutex m();
        Condition cond();
    }

    constructor(int refusals) {
        self.refusals = refusals;
    }

    update(string event_id, hash<auto> data_) {
        m.lock();
        on_exit m.unlock();

        if (++attempts <= refusals) {
            throw "REFUSED", sprintf("event %d refused", attempts);
        }
        accepted = data_;
        cond.broadcast();
    }

    int getAttempts() {
        m.lock();
        on_exit m.unlock();

        return attempts;
    }

    #! Waits for the accepted event and returns it
    /** @throw ERROR no event was accepted in @ref EventTimeout; the poller's log is included in the exception
    */
    hash<auto> waitAccepted(CapturingAppender capture) {
        int start = clock_get_monotonic_us();

        m.lock();
        on_exit m.unlock();

        while (!accepted) {
            int left_ms = EventTimeout.durationMilliseconds() - (clock_get_monotonic_us() - start) / 1000;
            if (left_ms <= 0) {
                throw "ERROR", sprintf("no event accepted in %y after %d event(s); poller log:\n%s", EventTimeout,
                    attempts, capture.getLog());
            }
            cond.wait(m, left_ms);
        }
        return accepted;
    }
}

class MyObserver inherits Observer {
    public {
        #! how long to wait for all expected file events
        const EventTimeout = 30s;
    }

    private {
        hash<string, hash<auto>> h();
        Mutex m();
        Condition cond();
    }

    update(string event_id, hash<auto> data_) {
        m.lock();
        on_exit m.unlock();

        h{data_.name} = data_;
        cond.broadcast();
    }

    #! Waits for \a expected file events and returns them
    /** @param expected the number of file events to wait for
        @param capture the appender capturing the poller's log messages; its contents are included in the exception
        if the events do not arrive, otherwise the failure gives no information about the underlying error

        @throw ERROR not all expected events were received in @ref EventTimeout
    */
    hash<string, hash<auto>> wait(int expected, CapturingAppender capture) {
        # NOTE: a monotonic clock must be used here; wall clock steps on CI machines can trip the deadline
        int start = clock_get_monotonic_us();

        m.lock();
        on_exit m.unlock();

        while (h.size() != expected) {
            cond.wait(m, 1s);
            if ((clock_get_monotonic_us() - start) > EventTimeout.durationMicroseconds()) {
                throw "ERROR", sprintf("%d/%d files received in %y: %y; poller log:\n%s", h.size(), expected,
                    EventTimeout, keys h, capture.getLog());
            }
        }
        return h;
    }
}

#! Collects log messages from a poller log callback so that they can be matched deterministically
class MessageCollector {
    public {
        #! how long to wait for a matching message by default
        const DefaultTimeout = 30s;
    }

    private {
        list<string> msgs();
        Mutex m();
        Condition cond();
    }

    #! Returns the messages collected so far
    list<string> getAll() {
        m.lock();
        on_exit m.unlock();

        return msgs;
    }

    #! Stores a message and wakes any waiter
    add(string msg) {
        m.lock();
        on_exit m.unlock();

        msgs += msg;
        cond.broadcast();
    }

    #! Waits for a message matching \a pattern and returns it
    /** @param pattern the regular expression to match
        @param to how long to wait; use 0 to check the messages already collected without waiting

        @throw MESSAGE-TIMEOUT no matching message was collected in \a to
    */
    string waitForMatch(string pattern, timeout to = DefaultTimeout) {
        # NOTE: a monotonic clock must be used here; wall clock steps on CI machines can trip the deadline
        int start = clock_get_monotonic_us();

        m.lock();
        on_exit m.unlock();

        while (True) {
            foreach string msg in (msgs) {
                if (regex(msg, pattern)) {
                    return msg;
                }
            }
            int elapsed_ms = (clock_get_monotonic_us() - start) / 1000;
            if (elapsed_ms >= to) {
                throw "MESSAGE-TIMEOUT", sprintf("no message matching %y received in %dms; messages: %y", pattern,
                    to, msgs);
            }
            cond.wait(m, to - elapsed_ms);
        }
    }
}

#! An appender that stores all log messages in memory so that they can be reported on a test failure
class CapturingAppender inherits LoggerAppenderWithLayout {
    private {
        list<string> lines();
        Mutex m();
        Condition cond();
    }

    constructor() : LoggerAppenderWithLayout("capture",
            new LoggerLayoutPattern("%d{YYYY-MM-DD HH:mm:SS.xx} T%t [%p]: %m%n")) {
        open();
    }

    processEventImpl(int type, auto params) {
        if (type == LoggerAppender::EVENT_LOG) {
            m.lock();
            on_exit m.unlock();
            lines += params.toString();
            cond.broadcast();
        }
    }

    #! Waits for a log message matching \a pattern; the timeout only guards against a hang
    /** @throw MESSAGE-TIMEOUT no matching message was logged in \a to
    */
    waitForMatch(string pattern, timeout to = 30s) {
        int start = clock_get_monotonic_us();

        m.lock();
        on_exit m.unlock();

        while (True) {
            foreach string line in (lines) {
                if (regex(line, pattern)) {
                    return;
                }
            }
            int left_ms = to - (clock_get_monotonic_us() - start) / 1000;
            if (left_ms <= 0) {
                throw "MESSAGE-TIMEOUT", sprintf("no log message matching %y in %dms; log:\n%s", pattern, to,
                    lines.join(""));
            }
            cond.wait(m, left_ms);
        }
    }

    #! Returns all captured log messages as a single string
    string getLog() {
        m.lock();
        on_exit m.unlock();

        return lines ? lines.join("") : "<no log messages>";
    }
}
