        addTestCase("discovery test", \discoveryTest());
        addTestCase("SMART backend services test", \smartBackendServicesTest());
        addTestCase("resource operations test", \resourceOperationsTest());
        addTestCase("bundle operation test", \bundleOperationTest());
        addTestCase("resource builder test", \resourceBuilderTest());
        addTestCase("operation outcome test", \operationOutcomeTest());
        addTestCase("connection scheme test", \connectionSchemeTest());
        addTestCase("validation test", \validationTest());
        addTestCase("terminology operation test", \terminologyOperationTest());

        set_return_value(main());
    }

    globalSetUp() {
        logger = new Logger("test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }

        http = new HttpServer(<HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        });
        http.setHandler("fhir", "", NOTHING, handler);
        http.setDefaultHandler("fhir", handler);
        port = http.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        base_url = sprintf("http://localhost:%d/fhir", port);
    }

    globalTearDown() {
        http.stop();
        delete http;
    }

    discoveryTest() {
        FhirRestClient::FhirRestClient client({"url": base_url}, True);

        hash<auto> capability = client.getCapabilityStatement();
        assertEq("CapabilityStatement", capability.resourceType);
        assertEq("4.0.1", capability.fhirVersion);
        assertEq("4.0.1", client.getFhirVersion(capability));
        assertEq("4.0.1", client.getFhirVersion());
        assertThrows("FHIR-CAPABILITY-STATEMENT-ERROR", sub () {
            client.getFhirVersion({"resourceType": "CapabilityStatement"});
        });
        assertEq("4.0.1", FhirRestClient::FhirRestClient::getFhirVersionFromContentType(
            "application/fhir+json; fhirVersion=4.0.1"));
        assertNothing(FhirRestClient::FhirRestClient::getFhirVersionFromContentType("application/fhir+json"));
        assertEq(("Observation", "Patient"), client.getCapabilityStatementResourceTypes());
        assertTrue(client.isCapabilityStatementResourceType("Patient"));
        assertFalse(client.isCapabilityStatementResourceType("Bundle"));
        assertEq("Patient", client.assertCapabilityStatementResourceType("Patient"));
        assertThrows("FHIR-CAPABILITY-RESOURCE-ERROR", sub () {
            client.assertCapabilityStatementResourceType("Bundle");
        });

        hash<auto> smart = client.getSmartConfiguration();
        assertEq("https://auth.example.org/authorize", smart.authorization_endpoint);
        assertEq("https://auth.example.org/token", smart.token_endpoint);

        hash<auto> oauth2_options = client.getSmartOAuth2ClientOptions({
            "oauth2_grant_type": "client_credentials",
            "oauth2_client_id": "qore-test",
            "oauth2_scope": "system/Patient.read",
        });
        assertEq("https://auth.example.org/authorize", oauth2_options.oauth2_auth_url);
        assertEq("https://auth.example.org/token", oauth2_options.oauth2_token_url);
        assertEq("client_credentials", oauth2_options.oauth2_grant_type);
        assertEq("qore-test", oauth2_options.oauth2_client_id);
        assertThrows("FHIR-SMART-CONFIGURATION-ERROR", sub () {
            FhirRestClient::FhirRestClient::makeSmartOAuth2ClientOptions({});
        });
    }

    smartBackendServicesTest() {
        FhirRestClient::FhirRestClient client({"url": base_url}, True);

        string token = FhirRestClient::FhirRestClient::makeSmartBackendClientAssertion({
            "client_id": "system-client",
            "private_key": rsa_private_key,
            "token_endpoint": "https://auth.example.org/token",
            "key_id": "key-1",
            "issued_at": 1700000000,
            "lifetime_seconds": 300,
            "jti": "jwt-1",
        });
        hash<JwtDecodeResult> result = cast<hash<JwtDecodeResult>>(jwt_decode(token, rsa_public_key));
        assertTrue(result.signature_valid);
        assertEq("RS256", result.header.alg);
        assertEq("key-1", result.header.kid);
        assertEq("system-client", result.claims.iss);
        assertEq("system-client", result.claims.sub);
        assertEq("https://auth.example.org/token", result.claims.aud);
        assertEq(1700000000, result.claims.iat);
        assertEq(1700000300, result.claims.exp);
        assertEq("jwt-1", result.claims.jti);

        hash<auto> backend_options = client.getSmartBackendOAuth2ClientOptions({
            "client_id": "system-client",
            "private_key": rsa_private_key,
            "key_id": "key-1",
            "issued_at": 1700000000,
            "lifetime_seconds": 300,
            "jti": "jwt-1",
            "scopes": ("system/Patient.read", "system/Observation.write"),
            "oauth2_auto_refresh": False,
        });
        assertEq("client_credentials", backend_options.oauth2_grant_type);
        assertEq("system-client", backend_options.oauth2_client_id);
        assertEq("https://auth.example.org/token", backend_options.oauth2_token_url);
        assertEq(FhirRestClient::FhirRestClientBase::JwtBearerClientAssertionType,
            backend_options.oauth2_client_assertion_type);
        assertEq(("system/Patient.read", "system/Observation.write"), backend_options.oauth2_scopes);
        assertFalse(backend_options.oauth2_auto_refresh);
        assertFalse(exists backend_options.private_key);
        assertFalse(exists backend_options.key_id);
        assertFalse(exists backend_options.jti);

        code<string()> provider = backend_options.oauth2_client_assertion_provider;
        hash<JwtDecodeResult> generated = cast<hash<JwtDecodeResult>>(jwt_decode(provider(), rsa_public_key));
        assertTrue(generated.signature_valid);
        assertEq("system-client", generated.claims.iss);
        assertEq("https://auth.example.org/token", generated.claims.aud);
        assertEq("jwt-1", generated.claims.jti);

        hash<auto> single_scope_options = FhirRestClient::FhirRestClient::makeSmartBackendOAuth2ClientOptions({
            "token_endpoint": "https://auth.example.org/token",
        }, {
            "client_id": "system-client",
            "private_key": rsa_private_key,
            "scope": "system/Patient.read system/Observation.read",
        });
        assertEq(("system/Patient.read", "system/Observation.read"), single_scope_options.oauth2_scopes);

        assertThrows("FHIR-SMART-CONFIGURATION-ERROR", sub () {
            FhirRestClient::FhirRestClient::makeSmartBackendClientAssertion({
                "client_id": "system-client",
                "token_endpoint": "https://auth.example.org/token",
            });
        });
        assertThrows("FHIR-SMART-CONFIGURATION-ERROR", sub () {
            FhirRestClient::FhirRestClient::makeSmartBackendClientAssertion({
                "client_id": "system-client",
                "private_key": rsa_private_key,
                "token_endpoint": "https://auth.example.org/token",
                "jwt_alg": "ES256",
            });
        });
        assertThrows("FHIR-SMART-CONFIGURATION-ERROR", sub () {
            FhirRestClient::FhirRestClient::makeSmartBackendClientAssertion({
                "client_id": "system-client",
                "private_key": rsa_private_key,
                "token_endpoint": "https://auth.example.org/token",
                "lifetime_seconds": 301,
            });
        });
        assertThrows("FHIR-SMART-CONFIGURATION-ERROR", sub () {
            FhirRestClient::FhirRestClient::makeSmartBackendClientAssertion({
                "client_id": "system-client",
                "private_key": rsa_private_key,
                "token_endpoint": "https://auth.example.org/token",
                "jti": "",
            });
        });
        assertThrows("FHIR-SMART-CONFIGURATION-ERROR", sub () {
            FhirRestClient::FhirRestClient::makeSmartBackendOAuth2ClientOptions({}, {
                "client_id": "system-client",
                "private_key": rsa_private_key,
            });
        });
        assertThrows("FHIR-SMART-CONFIGURATION-ERROR", sub () {
            FhirRestClient::FhirRestClient::makeSmartBackendOAuth2ClientOptions({
                "token_endpoint": "https://auth.example.org/token",
            }, {
                "client_id": "system-client",
                "private_key": rsa_private_key,
                "scopes": ("system/Patient.read", 1),
            });
        });
    }

    resourceOperationsTest() {
        FhirRestClient::FhirRestClient client({"url": base_url}, True);

        hash<auto> patient = client.readResource("Patient", "pat-1");
        assertEq("Patient", patient.resourceType);
        assertEq("pat-1", patient.id);
        assertEq("Smith", patient.name[0].family);

        hash<auto> bundle = client.searchResources("Patient", {
            "name": "Smith",
            "_include": ("Patient:general-practitioner", "Patient:organization"),
        });
        assertEq("Bundle", bundle.resourceType);
        assertEq("searchset", bundle.type);
        assertEq("Smith", bundle.query.name);
        assertEq(2, bundle.query."_include".size());
        assertEq("Patient?page=2",
            FhirRestClient::FhirRestClientBase::getBundleLinkUrl(bundle, "next"));
        assertNothing(FhirRestClient::FhirRestClientBase::getBundleLinkUrl(bundle, "previous"));
        assertNothing(FhirRestClient::FhirRestClientBase::getBundleLinkUrl({"resourceType": "Bundle"}, "next"));
        assertEq("Patient?active=true&name=Smith", FhirRestClient::FhirRestClientBase::getPathWithParams(
            "Patient?active=true", {"name": "Smith"}));

        hash<auto> all = client.searchAllResources("Patient", {"name": "Smith"});
        assertEq("Bundle", all.resourceType);
        assertEq(2, all.entry.size());
        assertEq("pat-1", all.entry[0].resource.id);
        assertEq("pat-2", all.entry[1].resource.id);
        assertThrows("FHIR-PAGINATION-ERROR", sub () {
            client.searchAllResources("Patient", {"name": "Smith"}, 1);
        });

        hash<RestClient::RestResponseInfo> created = client.createResource("Patient", {
            "resourceType": "Patient",
            "name": ({"family": "Jones"},),
        }, "identifier=http://example.org/mrn|123");
        assertEq(201, created.status_code);
        assertEq("Patient", created.body.requestBodyType);
        assertEq(TestFhirMimeTypeJson, created.body.requestContentType);
        assertEq("identifier=http://example.org/mrn|123", created.body.ifNoneExist);
        assertEq("W/\"2\"", created.headers.etag);

        hash<RestClient::RestResponseInfo> updated = client.updateResource("Patient", "pat-1", {
            "resourceType": "Patient",
            "id": "pat-1",
        }, "W/\"1\"");
        assertEq(200, updated.status_code);
        assertEq("W/\"1\"", updated.body.ifMatch);
        assertEq("W/\"3\"", updated.headers.etag);

        hash<RestClient::RestResponseInfo> conditional = client.conditionalUpdateResource("Patient", {
            "identifier": "http://example.org/mrn|123",
        }, {
            "resourceType": "Patient",
            "id": "conditional",
        });
        assertEq(200, conditional.status_code);
        assertEq("http%3A%2F%2Fexample.org%2Fmrn%7C123", conditional.body.queryIdentifier);
        assertEq("Patient", conditional.body.requestBodyType);
        assertEq("W/\"4\"", conditional.headers.etag);

        hash<RestClient::RestResponseInfo> patched = client.patchResource("Patient", "pat-1", ({
            "op": "replace",
            "path": "/active",
            "value": False,
        },), "application/json-patch+json", "W/\"3\"");
        assertEq(200, patched.status_code);
        assertEq("application/json-patch+json", patched.body.requestContentType);
        assertEq("replace", patched.body.patchOperation);
        assertEq("W/\"3\"", patched.body.ifMatch);
        assertEq("W/\"5\"", patched.headers.etag);

        hash<RestClient::RestResponseInfo> deleted = client.deleteResource("Patient", "pat-1", "W/\"5\"");
        assertEq(200, deleted.status_code);
        assertEq("OperationOutcome", deleted.body.resourceType);
        assertEq("W/\"5\"", deleted.body.ifMatch);
    }

    bundleOperationTest() {
        FhirRestClient::FhirRestClient client({"url": base_url}, True);

        hash<auto> create_entry = FhirRestClient::FhirRestClientBase::makeConditionalCreateBundleEntry("Patient", {
            "resourceType": "Patient",
            "name": ({"family": "Jones"},),
        }, "identifier=http://example.org/mrn|123", "urn:uuid:patient-1");
        assertEq("POST", create_entry.request.method);
        assertEq("Patient", create_entry.request.url);
        assertEq("identifier=http://example.org/mrn|123", create_entry.request.ifNoneExist);
        assertEq("urn:uuid:patient-1", create_entry.fullUrl);

        hash<auto> update_entry = FhirRestClient::FhirRestClientBase::makeUpdateBundleEntry("Patient", "pat-1", {
            "resourceType": "Patient",
            "id": "pat-1",
            "active": True,
        }, "W/\"1\"");
        assertEq("PUT", update_entry.request.method);
        assertEq("Patient/pat-1", update_entry.request.url);
        assertEq("W/\"1\"", update_entry.request.ifMatch);

        hash<auto> transaction = FhirRestClient::FhirRestClientBase::makeBundle((create_entry, update_entry),
            "transaction");
        hash<RestClient::RestResponseInfo> response = client.submitBundle(transaction);
        assertEq(200, response.status_code);
        assertEq("Bundle", response.body.resourceType);
        assertEq("transaction-response", response.body.type);
        assertEq(TestFhirMimeTypeJson, response.body.requestContentType);
        assertEq(2, response.body.entryCount);
        assertEq("POST", response.body.firstMethod);
        assertEq("Patient", response.body.firstUrl);
        assertEq("identifier=http://example.org/mrn|123", response.body.firstIfNoneExist);

        hash<auto> batch = FhirRestClient::FhirRestClientBase::makeBundle((
            FhirRestClient::FhirRestClientBase::makeDeleteBundleEntry("Patient", "pat-1"),
        ), "batch");
        assertEq("batch", batch.type);
        assertEq("DELETE", batch.entry[0].request.method);

        assertThrows("FHIR-BUNDLE-ERROR", sub () {
            FhirRestClient::FhirRestClientBase::makeBundle((), "collection");
        });
        assertThrows("FHIR-BUNDLE-ERROR", sub () {
            client.submitBundle({"resourceType": "Bundle", "type": "collection", "entry": ()});
        });
        assertThrows("FHIR-BUNDLE-ERROR", sub () {
            client.submitBundle({
                "resourceType": "Bundle",
                "type": "transaction",
                "entry": ({"request": {"url": "Patient"}},),
            });
        });
        assertThrows("FHIR-PATH-ERROR", sub () {
            FhirRestClient::FhirRestClientBase::makeBundleEntry("GET", "https://evil.example/Patient");
        });
        assertThrows("FHIR-OPERATION-OUTCOME", sub () {
            client.submitBundle({"resourceType": "Bundle", "id": "fail", "type": "transaction", "entry": ()});
        });
    }

    resourceBuilderTest() {
        hash<auto> coding = FhirRestClient::fhir_make_coding(FhirRestClient::FhirSystemLoinc, "8867-4",
            "Heart rate");
        assertEq("http://loinc.org", coding.system);
        assertEq("8867-4", coding.code);
        assertEq("Heart rate", coding.display);

        hash<auto> concept = FhirRestClient::fhir_make_codeable_concept((coding,), "Heart rate");
        assertEq("8867-4", concept.coding[0].code);
        assertEq("Heart rate", concept.text);

        hash<auto> unit = FhirRestClient::fhir_normalize_ucum_unit("mmHg");
        assertEq("http://unitsofmeasure.org", unit.system);
        assertEq("mm[Hg]", unit.code);
        assertEq("mmHg", unit.unit);

        hash<auto> quantity = FhirRestClient::fhir_make_ucum_quantity(72, "bpm");
        assertEq(72, quantity.value);
        assertEq("/min", quantity.code);
        assertEq("/min", quantity.unit);

        hash<auto> observation = FhirRestClient::fhir_make_observation({
            "id": "obs-1",
            "identifier": {"system": "http://example.org/observations", "value": "obs-1"},
            "code_system": FhirRestClient::FhirSystemLoinc,
            "code_code": "8867-4",
            "code_display": "Heart rate",
            "subject": "Patient/pat-1",
            "device": {"reference": "Device/dev-1"},
            "effectiveDateTime": "2026-05-30T10:15:00Z",
            "value": 72,
            "unit_code": "bpm",
        });
        assertEq("Observation", observation.resourceType);
        assertEq("final", observation.status);
        assertEq("obs-1", observation.id);
        assertEq("Patient/pat-1", observation.subject.reference);
        assertEq("Device/dev-1", observation.device.reference);
        assertEq("8867-4", observation.code.coding[0].code);
        assertEq("/min", observation.valueQuantity.code);
        assertEq("obs-1", observation.identifier[0].value);

        hash<auto> audit = FhirRestClient::fhir_make_audit_event({
            "type": FhirRestClient::fhir_make_codeable_concept((
                FhirRestClient::fhir_make_coding("http://terminology.hl7.org/CodeSystem/audit-event-type",
                    "rest", "RESTful operation"),
            )),
            "action": "C",
            "recorded": "2026-05-30T10:15:01Z",
            "agent": ({"who": FhirRestClient::fhir_make_reference("Device/gateway")},),
            "source": {"observer": FhirRestClient::fhir_make_reference("Device/gateway")},
            "entity": ({"what": FhirRestClient::fhir_make_reference("Observation/obs-1")},),
        });
        assertEq("AuditEvent", audit.resourceType);
        assertEq("C", audit.action);
        assertEq("Device/gateway", audit.agent[0].who.reference);
        assertEq("Observation/obs-1", audit.entity[0].what.reference);

        hash<auto> provenance = FhirRestClient::fhir_make_provenance({
            "target": "Observation/obs-1",
            "recorded": "2026-05-30T10:15:01Z",
            "agent": ({"who": FhirRestClient::fhir_make_reference("Device/gateway")},),
        });
        assertEq("Provenance", provenance.resourceType);
        assertEq("Observation/obs-1", provenance.target[0].reference);

        assertThrows("FHIR-UCUM-ERROR", sub () {
            FhirRestClient::fhir_normalize_ucum_unit("../bad");
        });
        assertThrows("FHIR-RESOURCE-BUILDER-ERROR", sub () {
            FhirRestClient::fhir_make_ucum_quantity("72", "bpm");
        });
        assertThrows("FHIR-RESOURCE-BUILDER-ERROR", sub () {
            FhirRestClient::fhir_make_observation({
                "code_system": FhirRestClient::FhirSystemLoinc,
                "code_code": "8867-4",
                "value": 72,
            });
        });
        assertThrows("FHIR-RESOURCE-BUILDER-ERROR", sub () {
            FhirRestClient::fhir_make_provenance({
                "target": "Observation/obs-1",
                "recorded": "2026-05-30T10:15:01Z",
            });
        });
    }

    operationOutcomeTest() {
        FhirRestClient::FhirRestClient client({"url": base_url}, True);

        assertThrows("FHIR-OPERATION-OUTCOME", sub () {
            client.readResource("Patient", "missing");
        });

        try {
            client.updateResource("Patient", "pat-conflict", {
                "resourceType": "Patient",
                "id": "pat-conflict",
            }, "W/\"old\"");
            assertTrue(False, "expected FHIR-OPERATION-OUTCOME");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("FHIR-OPERATION-OUTCOME", ex.err);
            assertEq(412, ex.arg.status_code);
            assertEq("OperationOutcome", ex.arg.outcome.resourceType);
            assertEq("conflict", ex.arg.outcome.issue[0].code);
        }

        string summary = FhirRestClient::FhirRestClientBase::getOperationOutcomeSummary({
            "resourceType": "OperationOutcome",
            "issue": ({
                "severity": "error",
                "code": "not-found",
                "diagnostics": "Patient not found",
            },),
        });
        assertEq("error/not-found: Patient not found", summary);
    }

    connectionSchemeTest() {
        hash<ConnectionSchemeInfo> scheme_info = FhirRestConnection::ConnectionScheme;
        assertEq("FHIR REST Connection", scheme_info.display_name);
        assertTrue(scheme_info.schemes.fhir, "should support fhir");
        assertTrue(scheme_info.schemes.fhirs, "should support fhirs");
        assertEq("fhir", scheme_info.base_scheme_map.http);
        assertEq("fhirs", scheme_info.base_scheme_map.https);
        assertEq(TestFhirMimeTypeJson, scheme_info.options.headers.default_value.Accept);
        assertEq("metadata", scheme_info.options.ping_path.default_value);

        string fhir_url = regex_subst(base_url, "^http:", "fhir:");
        FhirRestConnection conn("test-fhir", "Test FHIR connection", fhir_url, {"monitor": False});
        assertEq("fhir", conn.getType());

        FhirRestClient::FhirRestClient client = conn.get(False);
        assertEq(base_url, client.getURL());
    }

    validationTest() {
        FhirRestClient::FhirRestClient client({"url": base_url}, True);

        hash<auto> outcome = client.validateResource({
            "resourceType": "Patient",
            "id": "pat-1",
        }, "Patient");
        assertEq("OperationOutcome", outcome.resourceType);
        assertEq("information", outcome.issue[0].severity);

        assertThrows("FHIR-RESOURCE-TYPE-ERROR", sub () {
            client.readResource("patient", "pat-1");
        });
        assertThrows("FHIR-ID-ERROR", sub () {
            client.readResource("Patient", "../pat-1");
        });
        assertThrows("FHIR-PATH-ERROR", sub () {
            client.validateCode("../CodeSystem/example", {"code": "abc"});
        });
        assertThrows("FHIR-PATH-ERROR", sub () {
            client.expandValueSet("https://evil.example/ValueSet/example");
        });
    }

    terminologyOperationTest() {
        FhirRestClient::FhirRestClient client({"url": base_url}, True);

        hash<auto> result = client.validateCode("CodeSystem/example", {
            "code": "abc",
        });
        assertEq("Parameters", result.resourceType);
        assertTrue(result.parameter[0].valueBoolean);
        assertEq("abc", result.parameter[1].valueCode);

        hash<auto> lookup = client.lookupCode("CodeSystem/example", {
            "system": "http://example.org/system",
            "code": "abc",
        });
        assertEq("Parameters", lookup.resourceType);
        assertEq("Example CodeSystem", lookup.parameter[0].valueString);
        assertEq("abc display", lookup.parameter[1].valueString);

        hash<auto> translation = client.translateCode("ConceptMap/example", {
            "system": "http://example.org/local",
            "code": "abc",
        });
        assertEq("Parameters", translation.resourceType);
        assertTrue(translation.parameter[0].valueBoolean);
        assertEq("abc-target", translation.parameter[1].part[0].valueCode);

        hash<auto> expansion = client.expandValueSet("ValueSet/example", {
            "filter": "smi",
        });
        assertEq("ValueSet", expansion.resourceType);
        assertEq("smi", expansion.expansion.parameter[0].valueString);
        assertEq("smith", expansion.expansion.contains[0].code);
    }
}
