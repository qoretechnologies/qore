        const OcrImageBase64 = "iVBORw0KGgoAAAANSUhEUgAAAMgAAABICAAAAACWg+WaAAAAl0lEQVR42u3aSQrAMAgAQP//6fRekGroImW8JZjEOYmQWD+JAAEBAQEZAYkk0guK+XER3fzzORAQEBCQbyHVgqfkpw0RBAQEBAQEBAQEBAQkyX9sEAMBAQEBGQXprrvw7vnthggCAgIC8glkd79b+O79ICAgICCzINlAU32wOijdNYi1fz6AgICAgLwCWX5ig4CAgIDU4wCfgds7hQte2AAAAABJRU5ErkJggg==";
