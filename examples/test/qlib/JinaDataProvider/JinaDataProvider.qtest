#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright 2026 Qore Technologies, s.r.o.

%modern
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/JinaDataProvider
%requires json

%exec-class JinaDataProviderTest

hashdecl JinaRecordedRequest {
    string url;
    string method;
    string path;
    auto body;
    hash<auto> headers;
}

class JinaCallLog {
    private {
        list<hash<JinaRecordedRequest>> requests = ();
        auto response = {};
        *int error_status;
    }

    synchronized reset(auto response = {}, *int error_status) {
        requests = ();
        self.response = response;
        self.error_status = error_status;
    }

    synchronized auto record(hash<JinaRecordedRequest> req) {
        requests += req;
        if (error_status) {
            throw "REST-RESPONSE-ERROR", sprintf("HTTP %d", error_status),
                <RestClient::RestResponseInfo>{"status_code": error_status};
        }
        return response;
    }

    synchronized hash<JinaRecordedRequest> last() {
        return requests[requests.size() - 1];
    }

    synchronized int count() {
        return requests.size();
    }
}

#! Actual client cloning and serialization, with the network boundary replaced by a recorder
class FakeJinaRestClientIo inherits JinaRestClient::JinaRestClientIo {
    public {
        static JinaCallLog Log();
    }

    constructor(hash<auto> opts = {"apikey": "fixture-key"},
            *HttpClientIo::HttpClientConnectionManager mgr) : JinaRestClientIo(opts, mgr) {
    }

    hash<RestClient::RestResponseInfo> restDoRawRequest(string method, string path, *data body,
            *hash<auto> hdr) {
        auto response = Log.record(<JinaRecordedRequest>{
            "url": getUrl().toString(), "method": method, "path": path,
            "body": body.val() ? parse_json(body.toString()) : NOTHING,
            "headers": (getDefaultHeaders() ?? {}) + (hdr ?? {}),
        });
        return <RestClient::RestResponseInfo>{"status_code": 200, "body": response};
    }

    hash<RestClient::RestResponseInfo> restDoRequest(string method, string path, auto body,
            *hash<auto> hdr) {
        return restDoRawRequest(method, path, exists body ? make_json(body) : NOTHING, hdr);
    }
}

public class JinaDataProviderTest inherits QUnit::Test {
    public {
        const MyOpts = Opts + {"conn": "c,connection=s"};
        const ActionNames = ("cancel-batch", "chat", "classify", "create-batch-embeddings",
            "create-embeddings", "deep-search", "delete-classifier", "download-batch-errors",
            "download-batch-output", "get-batch", "get-model", "list-batches", "list-classifiers",
            "list-models", "read-url", "rerank", "search-web", "segment-text", "train-classifier");
    }

    private {
        *string conn_name;
    }

    constructor() : Test("JinaDataProvider Test", "1.1", \ARGV, MyOpts) {
        conn_name = m_options.conn ?? ENV.JINA_CONNECTION;
        addTestCase("registration and every action path", \registrationTest());
        addTestCase("vendored schema provenance and drift", \schemaTest());
        addTestCase("constructor alternatives and child registration", \constructorTest());
        addTestCase("embedding model variants and encoding compatibility", \embeddingTest());
        addTestCase("rerank and classification wire contracts", \inferenceTest());
        addTestCase("all schema actions construct documented requests", \schemaRequestsTest());
        addTestCase("model and account reference data", \referenceTest());
        addTestCase("Reader and Search headers, uploads, and host isolation", \readerTest());
        addTestCase("Segmenter, vision, and DeepSearch requests", \contentTest());
        addTestCase("JSONL downloads and malformed responses", \downloadTest());
        addTestCase("invalid inputs never reach transport", \invalidInputTest());
        addTestCase("transport errors are not retried", \errorTest());
        if (conn_name || ENV.JINAAI_APIKEY) {
            addTestCase("live catalog, inference, and model dropdowns", \liveInferenceTest());
            addTestCase("live Reader, Search, Segmenter, and vision", \liveContentTest());
            addTestCase("live batch submission and status", \liveBatchTest());
        }
        if (ENV.JINA_TEST_CLASSIFIERS) {
            addTestCase("live classifier lifecycle", \liveClassifierTest());
        }
        if (ENV.JINA_TEST_DEEPSEARCH) {
            addTestCase("live DeepSearch", \liveDeepSearchTest());
        }
        if (ENV.JINA_BATCH_ID) {
            addTestCase("live completed batch downloads", \liveBatchDownloadTest());
        }
        set_return_value(main());
    }

    private JinaDataProvider::JinaDataProvider provider(auto response = {}) {
        FakeJinaRestClientIo::Log.reset(response);
        return new JinaDataProvider::JinaDataProvider(new FakeJinaRestClientIo());
    }

    private hash<JinaRecordedRequest> last() {
        return FakeJinaRestClientIo::Log.last();
    }

    private registrationTest() {
        assertEq("jina", DataProvider::getFactory("jina").getInfo().name);
        hash<DataProviderAppInfo> app = DataProviderActionCatalog::getApp("JinaAi");
        assertEq("jina", app.scheme);
        assertTrue(app.logo.val());
        list<hash<DataProviderActionInfo>> actions = select DataProviderActionCatalog::getActions("JinaAi"),
            $1.action != AbstractDataProvider::GenericApiCallActionName;
        assertEq(ActionNames, sort(map $1.action, actions));
        AbstractDataProvider root = provider();
        assertEq(ActionNames, sort(select root.getChildProviderNames(),
            $1 != AbstractDataProvider::GenericApiCallChildName));
        foreach hash<DataProviderActionInfo> action in (actions) {
            assertTrue(action.display_name.val());
            assertTrue(action.short_desc.val() && action.short_desc.size() < 80, action.action);
            assertTrue(action.desc.val());
            assertFalse(exists action.cls);
            assertTrue(action.output_type instanceof AbstractDataProviderType, action.action);
            AbstractDataProvider child = root.getChildProvider(action.path.substr(1));
            assertTrue(child.getInfo().supports_request, action.action);
            if (action.action !~ /^list-(classifiers|models)$/) {
                assertTrue(!!action.options, action.action + " has a usable form");
            }
            int previous_rank = 0;
            foreach hash<auto> option in ((action.options ?? {}).pairIterator()) {
                int rank = option.value.required_groups ? 0 : (option.value.required ? 1 : 2);
                assertTrue(rank >= previous_rank, action.action + "." + option.key
                    + " follows required groups and required fields");
                previous_rank = rank;
                assertTrue(option.value.display_name.val(), action.action + "." + option.key);
                assertTrue(option.value.short_desc.val(), action.action + "." + option.key);
                assertTrue(option.value.desc.val(), action.action + "." + option.key);
                assertFalse(option.value.desc =~ /(?<!`)\b(true|false|True|False|NOTHING|null)\b(?!`)/,
                    action.action + "." + option.key + " formats API literals as code");
                if (option.value.ref_data) {
                    assertTrue(child.getSupportedReferenceData(){option.value.ref_data}, action.action);
                }
                foreach hash<AllowedValueInfo> value in (option.value.allowed_values ?? ()) {
                    assertTrue(value.display_name.val());
                    if (option.key == "model") {
                        assertRegex("^[A-Z]", value.display_name, action.action + " has readable model names");
                    }
                }
            }
        }
    }

    private schemaTest() {
        hash<JinaSchemaProvenanceInfo> info = JinaSchema::Provenance;
        assertRegex("^[0-9a-f]{64}$", info.source_sha256);
        assertEq("https://api.jina.ai/openapi.json", info.source_url);
        assertTrue(info.source_size > 100000);
        assertEq(19, info.source_operations);
        assertEq((), RestSchemaDrift::compare(JinaSchema::getActionSet(), JinaSchema::getSchema()));
        assertEq(12, JinaSchema::getActionSet().getActionNames().size());
        assertTrue(JinaSchema::getSchema() == JinaSchema::getSchema(), "schema cache reuses its immutable instance");
    }

    private constructorTest() {
        assertThrows("CONSTRUCTOR-ERROR", sub () { new JinaDataProvider::JinaDataProvider({}); });
        JinaDataProvider::JinaDataProvider root({"restclient": new FakeJinaRestClientIo()});
        assertEq("jina", root.getName());
        assertThrows("JINA-CHILD-ERROR", sub () {
            JinaDataProvider::JinaDataProvider::registerChild("list-models", Class::forName("JinaReaderDataProvider"));
        });
        assertThrows("CONSTRUCTOR-ERROR", sub () {
            new JinaDataProvider::JinaDataProvider({"apikey": "key", "invalid": True});
        });
        assertEq(19, root.getChildProviderSummaryInfo().size());
    }

    private embeddingTest() {
        AbstractDataProvider p = provider({"model": "jina-embeddings-v3", "data": (
            {"index": 0, "embedding": (0.1, 0.2)},), "usage": {"total_tokens": 2}})
            .getChildProvider("create-embeddings");
        auto response = p.doRequest({"model": "jina-embeddings-v3", "input": ("delivery",),
            "dimensions": 2, "task": "retrieval.query"});
        assertEq((0.1, 0.2), response.data[0].embedding);
        assertEq("/v1/embeddings", last().path);
        assertEq("retrieval.query", last().body.task);
        assertEq(2, last().body.dimensions);
        p.doRequest({"model": "jina-embeddings-v4", "input": ({"image": "https://example.com/image.png"},),
            "return_multivector": True});
        assertTrue(last().body.return_multivector);
        assertEq("https://example.com/image.png", last().body.input[0].image);
        p.doRequest({"model": "jina-embeddings-v5-text-nano", "input": "Delivery status",
            "task": "clustering", "embedding_type": ("float", "binary")});
        assertEq(("float", "binary"), last().body.embedding_type);
        p.doRequest({"model": "jina-embeddings-v3", "input": ("delivery",), "encoding_format": "base64"});
        assertEq("base64", last().body.embedding_type);
        assertNothing(last().body.encoding_format);
    }

    private inferenceTest() {
        AbstractDataProvider p = provider();
        p.getChildProvider("rerank").doRequest({"model": "jina-reranker-m0", "query": "Beach",
            "documents": ({"image": "https://example.com/beach.png"},), "return_documents": False});
        assertEq("/v1/rerank", last().path);
        assertFalse(last().body.return_documents);
        p.getChildProvider("classify").doRequest({"model": "jina-embeddings-v3", "input": ("Help with delivery",),
            "labels": ("delivery", "billing")});
        assertEq("/v1/classify", last().path);
        assertEq(("delivery", "billing"), last().body.labels);
        p.getChildProvider("classify").doRequest({"classifier_id": "cls-fixture", "input": ("Hello",)});
        assertEq("cls-fixture", last().body.classifier_id);
        assertNothing(last().body.model);
        p.getChildProvider("train-classifier").doRequest({"model": "jina-embeddings-v3", "access": "private",
            "input": ({"text": "Excellent", "label": "positive"}, {"text": "Terrible", "label": "negative"})});
        assertEq("/v1/train", last().path);
        assertEq("private", last().body.access);
        p.getChildProvider("train-classifier").doRequest({"classifier_id": "cls-fixture",
            "input": ({"text": "Fine", "label": "positive"},)});
        assertNothing(last().body.access);
        assertNothing(last().body.model);
        assertEq("cls-fixture", last().body.classifier_id);
        assertEq("Fine", last().body.input[0].text);
    }

    private schemaRequestsTest() {
        AbstractDataProvider p = provider();
        foreach string action in (("list-models", "list-classifiers", "list-batches")) {
            p.getChildProvider(action).doRequest();
            assertEq("GET", last().method);
            assertRegex("^/v1/(models|classifiers|batches)", last().path);
        }
        p.getChildProvider("get-model").doRequest({"model_id": "jina-ai/jina-embeddings-v3"});
        assertEq("/v1/models/jina-ai%2Fjina-embeddings-v3", last().path);
        p.getChildProvider("delete-classifier").doRequest({"classifier_id": "cls /?"});
        assertEq("DELETE", last().method);
        assertEq("/v1/classifiers/cls%20%2F%3F", last().path);
        p.getChildProvider("create-batch-embeddings").doRequest({"model": "jina-embeddings-v5-text-nano",
            "input": ({"custom_id": "ticket-1", "body": {"input": "Delivery status"}},)});
        assertEq("/v1/batch/embeddings", last().path);
        assertEq("ticket-1", last().body.input[0].custom_id);
        assertEq("Delivery status", last().body.input[0].body.input);
        foreach string action in (("get-batch", "cancel-batch")) {
            p.getChildProvider(action).doRequest({"batch_id": "batch-1"});
            assertEq("/v1/batch/batch-1", last().path);
            assertEq(action == "get-batch" ? "GET" : "DELETE", last().method);
        }
    }

    private referenceTest() {
        AbstractDataProvider p = provider({"data": (
            {"id": "jina-ai/jina-embeddings-v3", "name": "Jina Embeddings V3"},
            {"id": "jina-ai/jina-reranker-v3.5", "name": "Jina Reranker V3.5"},
            {"id": "jina-ai/jina-ocr-v1", "name": "Jina OCR v1"},
        )});
        list<hash<AllowedValueInfo>> values = p.getChildProvider("create-embeddings")
            .getReferenceData("embedding-models");
        assertEq(("jina-embeddings-v3",), map $1.value, values);
        assertEq("Jina Embeddings V3", values[0].display_name);
        values = p.getChildProvider("rerank").getReferenceData("rerank-models");
        assertEq(("jina-reranker-v3.5",), map $1.value, values);
        values = p.getChildProvider("get-model").getReferenceData("all-models");
        assertEq(3, values.size());
        FakeJinaRestClientIo::Log.reset(({"batch_id": "batch-1"},));
        assertEq("batch-1", p.getChildProvider("download-batch-output").getReferenceData("batches")[0].value);
        FakeJinaRestClientIo::Log.reset(({"classifier_id": "cls-1"},));
        assertEq("cls-1", p.getChildProvider("classify").getReferenceData("classifiers")[0].value);
        FakeJinaRestClientIo::Log.reset({"data": ()});
        assertEq((), p.getChildProvider("create-embeddings").getReferenceData("embedding-models"));
    }

    private readerTest() {
        AbstractDataProvider p = provider({"code": 200, "data": {"title": "Delivery", "content": "Shipped"}});
        p.getChildProvider("read-url").doRequest({"html": "<h1>Delivery</h1>", "region": "eu",
            "return_format": "markdown", "no_cache": True, "do_not_track": True,
            "target_selector": "article", "set_cookie": "session=fixture"});
        assertEq("https://eu.r.jina.ai", last().url);
        assertEq("/", last().path);
        assertEq({"html": "<h1>Delivery</h1>"}, last().body);
        assertEq("markdown", last().headers."X-Return-Format");
        assertEq("1", last().headers.DNT);
        assertEq("true", last().headers."X-No-Cache");
        assertEq("session=fixture", last().headers."X-Set-Cookie");
        assertTrue(JinaReaderRequestDataType.getFields().set_cookie.getAttributes().sensitive);
        assertEq("Bearer fixture-key", last().headers.Authorization ?? last().headers.authorization);
        p.getChildProvider("read-url").doRequest({"file": {"name": "report.pdf", "content": binary("PDF bytes")}, "page": 1});
        assertEq(make_base64_string("PDF bytes"), last().body.file);
        p.getChildProvider("search-web").doRequest({"q": "delivery & returns", "num": 2,
            "page": 0, "respond_with": "no-content", "site": "example.com"});
        assertEq("https://s.jina.ai", last().url);
        assertEq("delivery & returns", last().body.q);
        assertEq("no-content", last().headers."X-Respond-With");
        assertEq("example.com", last().headers."X-Site");
        p.getChildProvider("list-models").doRequest();
        assertEq("https://api.jina.ai", last().url, "Reader routing does not mutate the API client");
    }

    private contentTest() {
        AbstractDataProvider p = provider();
        p.getChildProvider("segment-text").doRequest({"content": "One. Two.", "max_chunk_length": 5});
        assertEq("/v1/segment", last().path);
        assertTrue(last().body.return_chunks);
        p.getChildProvider("chat").doRequest({"messages": ({"role": "user", "content": "Hello"},), "max_tokens": 8});
        assertEq("jina-ocr-v1", last().body.model);
        assertFalse(last().body.stream);
        p.getChildProvider("chat").doRequest({"messages": ({"role": "user", "content": (
            {"type": "text", "text": "Describe this product"},
            {"type": "image_url", "image_url": {"url": "https://example.com/product.png"}},
        )},)});
        assertEq("https://example.com/product.png", last().body.messages[0].content[1].image_url.url);
        p.getChildProvider("deep-search").doRequest({"messages": ({"role": "user", "content": "What is Qore?"},),
            "budget_tokens": 1000, "only_hostnames": ("qore.org",),
            "response_format": {"type": "json_schema", "json_schema": {"type": "object",
                "properties": {"answer": {"type": "string"}}, "required": ("answer",)}}});
        assertEq("https://deepsearch.jina.ai", last().url);
        assertEq("/v1/chat/completions", last().path);
        assertEq(("qore.org",), last().body.only_hostnames);
        assertFalse(last().body.stream);
        assertEq("object", last().body.response_format.json_schema.type);
        assertEq("string", last().body.response_format.json_schema.properties.answer.type);
        p.getChildProvider("deep-search").doRequest({"messages": ({"role": "user", "content": "Hello"},)});
        assertNothing(last().body.response_format, "structured output remains optional");
    }

    private downloadTest() {
        AbstractDataProvider p = provider("{\"custom_id\":\"one\",\"response\":{}}\n\n{\"custom_id\":\"two\",\"error\":{}}\r\n");
        hash<auto> result = p.getChildProvider("download-batch-output").doRequest({"batch_id": "batch /?"});
        assertEq(("one", "two"), map $1.custom_id, result.records);
        assertEq("/v1/batch/batch%20%2F%3F/output", last().path);
        FakeJinaRestClientIo::Log.reset("");
        assertEq((), p.getChildProvider("download-batch-errors").doRequest({"batch_id": "batch-1"}).records);
        foreach auto response in (("not json", "[]\n", "{}\ninvalid", {})) {
            FakeJinaRestClientIo::Log.reset(response);
            assertThrows("JINA-RESPONSE-ERROR", sub () {
                p.getChildProvider("download-batch-output").doRequest({"batch_id": "batch-1"});
            });
        }
    }

    private invalidInputTest() {
        AbstractDataProvider p = provider();
        foreach hash<auto> test in ((
            {"action": "read-url", "input": {}},
            {"action": "read-url", "input": {"url": ""}},
            {"action": "read-url", "input": {"url": "https://example.com", "region": "invalid"}},
            {"action": "read-url", "input": {"html": "<p>test</p>", "timeout": -1}},
            {"action": "search-web", "input": {"q": "test", "num": 0}},
            {"action": "segment-text", "input": {"content": "test", "head": 1, "tail": 1}},
            {"action": "segment-text", "input": {"content": "test", "tokenizer": "invalid"}},
            {"action": "chat", "input": {"messages": ()}},
            {"action": "deep-search", "input": {"messages": ({"role": "user", "content": "Hello"},),
                "response_format": {"type": "text", "json_schema": {}}}},
            {"action": "deep-search", "input": {"messages": ({"role": "user", "content": "Hello"},),
                "response_format": {"type": "json_schema"}}},
            {"action": "chat", "input": {"messages": ({"role": "system", "content": "Hello"},)}},
            {"action": "chat", "input": {"messages": ({"role": "user", "content": "One"},
                {"role": "user", "content": "Two"})}},
            {"action": "chat", "input": {"messages": ({"role": "user", "content": ""},)}},
            {"action": "chat", "input": {"messages": ({"role": "user", "content": ({"type": "text"},)},)}},
            {"action": "read-url", "input": {"url": "https://example.com", "viewport": {"width": 0, "height": 10}}},
            {"action": "read-url", "input": {"html": "test", "file": {"name": "x.pdf", "content": "eA=="}}},
            {"action": "create-embeddings", "input": {"model": "invalid", "input": ("hello",)}},
            {"action": "create-embeddings", "input": {"model": "jina-embeddings-v3", "input": ("hello",), "dimensions": 0}},
            {"action": "rerank", "input": {"model": "jina-reranker-v3.5", "query": "test", "documents": ()}},
            {"action": "classify", "input": {"input": ("test",)}},
            {"action": "create-batch-embeddings", "input": {"model": "jina-embeddings-v5-text-nano"}},
            {"action": "create-batch-embeddings", "input": {"input": ({"custom_id": "one", "input": "legacy flat input"},)}},
            {"action": "create-batch-embeddings", "input": {"input": ({"custom_id": "", "body": {"input": "Hello"}},)}},
            {"action": "create-batch-embeddings", "input": {"input": ({"custom_id": "one", "body": {"input": ()}},)}},
            {"action": "create-batch-embeddings", "input": {"model": "jina-embeddings-v5-text-nano", "input": ({"input": "test"},), "input_url": "https://example.com/input.jsonl"}}
        )) {
            *hash<ExceptionInfo> error;
            try {
                p.getChildProvider(test.action).doRequest(test.input);
            } catch (hash<ExceptionInfo> ex) {
                error = ex;
            }
            assertTrue(exists error, test.action + " rejects invalid input");
            assertEq(0, FakeJinaRestClientIo::Log.count(), test.action + " rejects input before I/O");
        }
        assertThrows("JINA-REQUEST-ERROR", sub () {
            p.getChildProvider("create-embeddings").doRequest({"input": ("hello",),
                "embedding_type": "float", "encoding_format": "base64"});
        });
    }

    private errorTest() {
        AbstractDataProvider p = provider();
        foreach int status in ((401, 429, 500)) {
            FakeJinaRestClientIo::Log.reset({}, status);
            assertThrows("REST-RESPONSE-ERROR", sub () {
                p.getChildProvider("create-batch-embeddings").doRequest({"model": "jina-embeddings-v5-text-nano",
                    "input": ({"custom_id": "one", "body": {"input": "Hello"}},)});
            });
            assertEq(1, FakeJinaRestClientIo::Log.count(), "submissions are never retried implicitly");
        }
    }

