    private AbstractDataProvider liveProvider() {
        if (conn_name) {
            return get_connection(conn_name).getDataProvider();
        }
        return new JinaDataProvider::JinaDataProvider({"apikey": ENV.JINAAI_APIKEY});
    }

    private liveInferenceTest() {
        AbstractDataProvider p = liveProvider();
        hash<auto> models = p.getChildProvider("list-models").doRequest();
        assertTrue(models.data.lsize() > 0);
        hash<auto> model = p.getChildProvider("get-model").doRequest({"model_id": "jina-embeddings-v3"});
        assertEq("jina-ai/jina-embeddings-v3", model.id);
        assertEq(NT_DATE, model.created.typeCode());
        list<hash<AllowedValueInfo>> values = p.getChildProvider("create-embeddings").getReferenceData("embedding-models");
        assertTrue(!!(select values, $1.value == "jina-embeddings-v3"));
        hash<auto> embeddings = p.getChildProvider("create-embeddings").doRequest({"model": "jina-embeddings-v3",
            "input": ("Where is my delivery?", "My order has shipped."), "dimensions": 32, "task": "retrieval.query"});
        assertEq(2, embeddings.data.lsize());
        assertEq(32, embeddings.data[0].embedding.lsize());
        hash<auto> encoded = p.getChildProvider("create-embeddings").doRequest({"model": "jina-embeddings-v3",
            "input": ("Delivery",), "encoding_format": "base64", "dimensions": 32});
        assertEq(NT_STRING, encoded.data[0].embedding.typeCode());
        hash<auto> ranked = p.getChildProvider("rerank").doRequest({"model": "jina-reranker-v2-base-multilingual",
            "query": "Where is my delivery?", "documents": ("Track your shipment here.", "Reset your password."), "top_n": 1});
        assertEq(0, ranked.results[0]."index");
        hash<auto> classified = p.getChildProvider("classify").doRequest({"model": "jina-embeddings-v3",
            "input": ("The support team was excellent.",), "labels": ("positive", "negative")});
        assertEq("positive", classified.data[0].prediction);
    }

    private liveContentTest() {
        AbstractDataProvider p = liveProvider();
        hash<auto> page = p.getChildProvider("read-url").doRequest({"html": "<html><head><title>Delivery</title></head><body><h1>Order shipped</h1></body></html>", "url": "https://example.com"});
        assertRegex("Order shipped", page.data.content);
        hash<auto> search = p.getChildProvider("search-web").doRequest({"q": "Qore programming language", "num": 1, "respond_with": "no-content"});
        assertTrue(search.data.lsize() > 0);
        assertTrue(search.data[0].url.val());
        hash<auto> chunks = p.getChildProvider("segment-text").doRequest({"content": "First paragraph.\n\nSecond paragraph.", "max_chunk_length": 30, "return_tokens": True});
        assertTrue(chunks.num_tokens > 0);
        assertTrue(chunks.chunks.lsize() > 0);
        # the chat action uses the OCR model, which reads exactly one image per request
        hash<auto> chat = p.getChildProvider("chat").doRequest({"messages": ({"role": "user", "content": (
            {"type": "image_url", "image_url": {"url": "data:image/png;base64," + OcrImageBase64}},
        )},), "max_tokens": 64});
        assertTrue(chat.choices[0].message.content.val(), "the OCR model returns the text of the image");
        assertEq(NT_DATE, chat.created.typeCode());
    }

    private liveBatchTest() {
        AbstractDataProvider p = liveProvider();
        auto batches = p.getChildProvider("list-batches").doRequest({"limit": 1});
        assertEq(NT_LIST, batches.typeCode());
        hash<auto> batch = p.getChildProvider("create-batch-embeddings").doRequest({"model": "jina-embeddings-v5-text-nano",
            "input": ({"custom_id": "qore-5432", "body": {"input": "Delivery status"}},), "dimensions": 32});
        assertTrue(batch.batch_id.val());
        assertEq(NT_DATE, batch.created_at.typeCode());
        printf("Live batch for download verification: %s\n", batch.batch_id);
        hash<auto> status = p.getChildProvider("get-batch").doRequest({"batch_id": batch.batch_id});
        assertEq(batch.batch_id, status.batch_id);
        assertTrue(!!status.status);
        if (!ENV.JINA_KEEP_BATCH) {
            if (status.status == "pending" || status.status == "processing") {
                try {
                    hash<auto> cancelled = p.getChildProvider("cancel-batch").doRequest({"batch_id": batch.batch_id});
                    assertEq(batch.batch_id, cancelled.batch_id);
                    assertEq("cancelled", cancelled.status);
                } catch (hash<ExceptionInfo> ex) {
                    # A tiny fixture may complete between the status and cancellation requests.
                    if (ex.err != "REST-RESPONSE-ERROR" || ex.arg.status_code != 400) {
                        rethrow;
                    }
                    string final_status = p.getChildProvider("get-batch")
                        .doRequest({"batch_id": batch.batch_id}).status;
                    assertTrue(final_status == "completed" || final_status == "failed");
                }
            }
        }
    }

    private liveBatchDownloadTest() {
        AbstractDataProvider p = liveProvider();
        hash<auto> result = p.getChildProvider("download-batch-output").doRequest({"batch_id": ENV.JINA_BATCH_ID});
        assertEq("qore-5432", result.records[0].custom_id);
        assertEq(32, result.records[0].response.body.data[0].embedding.lsize());
    }

    private liveDeepSearchTest() {
        hash<auto> result = liveProvider().getChildProvider("deep-search").doRequest({
            "messages": ({"role": "user", "content": "What is the Qore programming language? One sentence."},),
            "budget_tokens": 1000, "max_attempts": 1});
        assertTrue(result.choices[0].message.content.val());
        hash<auto> structured = liveProvider().getChildProvider("deep-search").doRequest({
            "messages": ({"role": "user", "content": "Return the integer 42 as the answer."},),
            "budget_tokens": 1000, "max_attempts": 1,
            "response_format": {"type": "json_schema", "json_schema": {"type": "object",
                "properties": {"answer": {"type": "integer"}}, "required": ("answer",)}}});
        assertEq(42, parse_json(structured.choices[0].message.content).answer);
    }

    private liveClassifierTest() {
        AbstractDataProvider p = liveProvider();
        hash<auto> result = p.getChildProvider("train-classifier").doRequest({"model": "jina-embeddings-v3", "access": "private",
            "input": ({"text": "Excellent service", "label": "positive"}, {"text": "Terrible service", "label": "negative"})});
        string id = result.classifier_id;
        bool deleted = False;
        on_exit {
            if (!deleted) {
                p.getChildProvider("delete-classifier").doRequest({"classifier_id": id});
            }
        }
        assertTrue(id.val());
        assertEq(2, result.num_samples);
        auto classifiers = p.getChildProvider("list-classifiers").doRequest();
        list<hash<auto>> matching = select classifiers, $1.classifier_id == id;
        assertEq(1, matching.lsize());
        assertEq("jina-embeddings-v3", matching[0].model);
        assertEq("private", matching[0].access);
        assertEq(("negative", "positive"), sort(matching[0].labels));
        int updates = matching[0].updated_number;
        hash<auto> prediction = p.getChildProvider("classify").doRequest({"classifier_id": id, "input": ("Excellent support",)});
        assertEq("positive", prediction.data[0].prediction);
        hash<auto> updated = p.getChildProvider("train-classifier").doRequest({"classifier_id": id,
            "input": ({"text": "Helpful customer support", "label": "positive"},
                {"text": "Unhelpful customer support", "label": "negative"})});
        assertEq(id, updated.classifier_id);
        assertEq(2, updated.num_samples);
        classifiers = p.getChildProvider("list-classifiers").doRequest();
        matching = select classifiers, $1.classifier_id == id;
        assertEq(1, matching.lsize());
        assertTrue(matching[0].updated_number > updates);
        assertEq(("negative", "positive"), sort(matching[0].labels));
        p.getChildProvider("delete-classifier").doRequest({"classifier_id": id});
        deleted = True;
        classifiers = p.getChildProvider("list-classifiers").doRequest();
        assertFalse(!!(select classifiers, $1.classifier_id == id));
    }
}
