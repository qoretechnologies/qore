#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%prepend-module-path "${SCRIPT_DIR}"
%requires ./PgsqlTestIsolation.qm
# the test runs against every database connection that is configured
%requires ../../DbTestConnections.qm
%requires Util
%requires DataProvider
%requires SqlUtil
%requires QUnit
%requires ./MysqlTestIsolation.qm
%requires ./OracleTestIsolation.qm
%requires ./MssqlTestIsolation.qm

%exec-class SqlUtilSelectGenerationTest

#! Datasource wrapper that counts the queries issued against the connection
/** Used to prove how often generating SQL for a select with name-referenced joins and sub-selects reads the
    description of the referenced tables.
*/
class CountingDatasource inherits Datasource {
    public {
        int queries = 0;
        list<string> sql = ();
    }

    constructor(string str) : Datasource(str) {
    }

    auto select(string sql, ...) {
        count(sql);
        return Datasource::vselect(sql, argv);
    }

    auto vselect(string sql, *softlist<auto> args) {
        count(sql);
        return Datasource::vselect(sql, args);
    }

    auto selectRow(string sql, ...) {
        count(sql);
        return Datasource::vselectRow(sql, argv);
    }

    auto vselectRow(string sql, *softlist<auto> args) {
        count(sql);
        return Datasource::vselectRow(sql, args);
    }

    auto selectRows(string sql, ...) {
        count(sql);
        return Datasource::vselectRows(sql, argv);
    }

    auto vselectRows(string sql, *softlist<auto> args) {
        count(sql);
        return Datasource::vselectRows(sql, args);
    }

    reset() {
        queries = 0;
        sql = ();
    }

    private count(string str) {
        ++queries;
        sql += str;
    }
}

#! a connection of the test and its tables
class SelectGenerationContext {
    public {
        #! the connection
        hash<DbTestConnection> conn;

        #! the open connection, or @ref nothing if it could not be opened
        *CountingDatasource ds;

        #! the reason the connection's test cases are skipped, if it is not open
        string skip_reason = "the connection is not open";

        #! the error table
        *AbstractTable errs;

        #! the member table
        *AbstractTable mem;

        #! the error that creating the tables raised, if any
        *hash<ExceptionInfo> setup_error;
    }

    constructor(hash<DbTestConnection> conn) {
        self.conn = conn;
    }

    #! returns the name of the connection's test case
    string name(string test) {
        return sprintf("%s (%s): %s", conn.label, conn.driver ?? "unknown driver", test);
    }
}

class SqlUtilSelectGenerationTest inherits QUnit::Test {
    public {
        const MyOpts = Opts + {
            "connstr": "c,conn=s",
        };

        const ErrTable = "sqlutil_gen_errors";
        const MemTable = "sqlutil_gen_members";

        #! number of generations counted
        const Iterations = 60;
    }

    private {
        #! the test's connections (see DbTestConnections)
        list<SelectGenerationContext> contexts = ();

        #! the connection of the running test case and its tables
        *CountingDatasource ds;
        *AbstractTable errs;
        *AbstractTable mem;
    }

    constructor() : Test("SqlUtilSelectGenerationTest", "1.0", \ARGV, MyOpts) {
        contexts = map new SelectGenerationContext($1), DbTestConnections::get(m_options.connstr);
        # a run on PostgreSQL uses its own schema; this is set up before any connection is opened
        map PgsqlRunSchema::setup($1.conn.connstr, "SqlUtilSelectGeneration"), contexts;
        # on MySQL, Oracle and SQL Server, the run's own database or schema
        foreach SelectGenerationContext ctx in (contexts) {
            ctx.conn.connstr = MysqlRunDatabase::getConnectionString(ctx.conn.connstr, "SqlUtilSelectGen");
            ctx.conn.connstr = OracleRunSchema::getConnectionString(ctx.conn.connstr, "SqlUtilSelectGen");
            ctx.conn.connstr = MssqlRunDatabase::getConnectionString(ctx.conn.connstr, "SqlUtilSelectGen");
        }
        map setUpContext($1), contexts;

        if (!contexts) {
            addTestCase("select generation", sub () { testSkip("no DB connection; set QORE_DB_CONNSTR"); });
        }
        foreach SelectGenerationContext ctx in (contexts) {
            addTestCase(ctx.name("resolution order"), \testResolutionOrder(), ctx);
            addTestCase(ctx.name("unresolved names are never cached"), \testNoStaleDescriptionByDefault(), ctx);
            addTestCase(ctx.name("registered resolver is used"), \testRegisteredResolverIsUsed(), ctx);
            addTestCase(ctx.name("caching resolver issues no queries"), \testCachingResolverIssuesNoQueries(), ctx);
            addTestCase(ctx.name("caching resolver is invalidatable"), \testCachingResolverIsInvalidatable(), ctx);
            addTestCase(ctx.name("generation is stable"), \testGenerationIsStable(), ctx);
            addTestCase(ctx.name("concurrent resolution"), \testConcurrentResolution(), ctx);
            addTestCase(ctx.name("concurrent generation"), \testConcurrentGeneration(), ctx);
            addTestCase(ctx.name("name reference costs no more than object"), \testNameReferenceCost(), ctx);
        }

        set_return_value(main());
    }

    #! opens the connection and creates its tables; the connection's test cases are skipped if it fails
    private setUpContext(SelectGenerationContext ctx) {
        try {
            ctx.ds = getDatasource(ctx.conn.connstr);
        } catch (hash<ExceptionInfo> ex) {
            ctx.skip_reason = sprintf("cannot open the connection: %s: %s", ex.err, ex.desc);
            if (m_options.verbose) {
                printf("%s: %s\n", ctx.conn.label, ctx.skip_reason);
            }
            return;
        }
        use(ctx);
        try {
            setupTables();
        } catch (hash<ExceptionInfo> ex) {
            # the connection's test cases fail with the error
            ctx.setup_error = ex;
        }
        ctx.errs = errs;
        ctx.mem = mem;
    }

    #! makes the connection the one that the test case uses
    private use(SelectGenerationContext ctx) {
        ds = ctx.ds;
        errs = ctx.errs;
        mem = ctx.mem;
    }

    globalTearDown() {
        # the resolver and its cache are process-wide; leave neither behind
        sqlutil_register_table_resolver();
        sqlutil_clear_table_cache();
        foreach SelectGenerationContext ctx in (contexts) {
            if (!ctx.ds) {
                continue;
            }
            try {
                map $1.dropCommit(), (ctx.mem, ctx.errs), exists $1;
                ctx.ds.rollback();
            } catch (hash<ExceptionInfo> ex) {
                printf("WARNING: %s: cannot drop the test tables: %s: %s\n", ctx.conn.label, ex.err, ex.desc);
            }
        }
        # drops the run's schema with everything left in it, if the connection is a PostgreSQL connection
        PgsqlRunSchema::teardown();
        MysqlRunDatabase::teardown();
        OracleRunSchema::teardown();
        MssqlRunDatabase::teardown();
    }

    #! returns the name in the run's schema on PostgreSQL, so that it can never resolve to a table in another schema
    private string q(string name) {
        *string schema = ds.getDriverName() == "pgsql" ? PgsqlRunSchema::getName() : NOTHING;
        return schema ? schema + "." + name : name;
    }

    private static CountingDatasource getDatasource(string connstr) {
        CountingDatasource ds(connstr);
        ds.open();
        return ds;
    }

    private setupTables() {
        Database db(ds);
        # drop leftovers from an interrupted run
        foreach string name in ((MemTable, ErrTable)) {
            *AbstractTable t = db.getTable(name);
            if (t) {
                t.dropCommit();
            }
        }
        errs = db.makeTable(ErrTable, {
            "columns": {
                "errid": {"qore_type": Type::Int, "notnull": True},
                "parent_errid": {"qore_type": Type::Int},
                "state": {"qore_type": Type::String, "size": 32, "notnull": True},
            },
            "primary_key": {"name": "pk_" + ErrTable, "columns": "errid"},
        });
        errs.create();
        mem = db.makeTable(MemTable, {
            "columns": {
                "errid": {"qore_type": Type::Int, "notnull": True},
                "groupid": {"qore_type": Type::Int, "notnull": True},
            },
        });
        mem.create();
        ds.commit();
        # make sure both descriptions are cached before any test measures anything
        map $1.describe(), (errs, mem);
    }

    #! skips the current test case if no database connection is available, and clears process-wide state
    private checkDb(SelectGenerationContext ctx) {
        sqlutil_register_table_resolver();
        sqlutil_clear_table_cache();
        if (!ctx.ds) {
            testSkip(ctx.skip_reason);
        }
        if (*hash<ExceptionInfo> ex = ctx.setup_error) {
            throw ex.err, sprintf("the test tables could not be created: %s", ex.desc), ex.arg;
        }
        use(ctx);
    }

    #! Returns a select hash on the member table joining the error table and testing a sub-select, both by name
    private hash<auto> nameReferencedSelectHash() {
        return {
            "columns": ("groupid",),
            "join": join_inner(ErrTable, "e", {"errid": "errid"}),
            "where": {
                "groupid": op_in(1, 2, 3),
                "errid": op_in_select(ErrTable, {"columns": "errid", "where": {"state": "open"}}),
            },
            "groupby": ("groupid",),
        };
    }

    #! Returns the same select hash with the sub-select table supplied as an object instead of a name
    private hash<auto> objectReferencedSelectHash() {
        return {
            "columns": ("groupid",),
            "join": join_inner(errs, "e", {"errid": "errid"}),
            "where": {
                "groupid": op_in(1, 2, 3),
                "errid": op_in_select(errs, {"columns": "errid", "where": {"state": "open"}}),
            },
            "groupby": ("groupid",),
        };
    }

    #! a "tablecode" option wins over a registered resolver, which wins over building a new table object
    testResolutionOrder(SelectGenerationContext ctx) {
        checkDb(ctx);
        # no resolver: a new object every time
        AbstractTable plain = mem.getSubtableFromString(ErrTable, NOTHING);
        assertEq(ErrTable, plain.getName());
        assertEq(False, plain === mem.getSubtableFromString(ErrTable, NOTHING));

        # a registered resolver is consulted instead
        int resolver_calls = 0;
        sqlutil_register_table_resolver(AbstractTable sub (AbstractDatasource cb_ds, string name) {
            ++resolver_calls;
            return errs;
        });
        assertEq(True, errs === mem.getSubtableFromString(ErrTable, NOTHING));
        assertEq(1, resolver_calls);

        # "tablecode" takes precedence over the registered resolver
        int tablecode_calls = 0;
        hash<auto> opt = {
            "tablecode": AbstractTable sub (AbstractDatasource cb_ds, string name) {
                ++tablecode_calls;
                return AbstractTable::getTable(cb_ds, name);
            },
        };
        AbstractTable via_tablecode = mem.getSubtableFromString(ErrTable, opt);
        assertEq(1, tablecode_calls);
        assertEq(1, resolver_calls);
        assertEq(False, via_tablecode === errs);
        assertEq(ErrTable, via_tablecode.getName());
    }

    #! with no resolver registered, nothing is retained, so a changed table definition is always picked up
    /** SqlUtil must not keep a table object that the caller cannot reach and therefore cannot discard: SQL
        generated for a name-referenced sub-select would then keep using a description that no longer matches
        the database.
    */
    testNoStaleDescriptionByDefault(SelectGenerationContext ctx) {
        checkDb(ctx);
        string tmp_table = ErrTable + "_alt";
        Database db(ds);
        {
            *AbstractTable t = db.getTable(tmp_table);
            if (t) {
                t.dropCommit();
            }
        }
        on_exit {
            *AbstractTable t = db.getTable(tmp_table);
            if (t) {
                t.dropCommit();
            }
        }
        db.makeTable(tmp_table, {
            "columns": {"errid": {"qore_type": Type::Int, "notnull": True}},
        }).create();
        ds.commit();

        hash<auto> sh = {"columns": ("groupid",),
            "where": {"errid": op_in_select(tmp_table, {"columns": "errid"})}};
        list<auto> args;
        # resolve the name once
        assertNeq("", mem.getSelectSql(sh, \args));

        # change the table's definition outside of any SqlUtil table object
        # the syntax of every database: Oracle and SQL Server have no COLUMN keyword in "add", and Sybase adds a
        # column only with an explicit null
        ds.execRaw("alter table " + q(tmp_table) + " add extra integer null");
        ds.commit();

        # generation must see the new column without anything being cleared
        hash<auto> sh2 = {"columns": ("groupid",),
            "where": {"errid": op_in_select(tmp_table, {"columns": "errid", "where": {"extra": 1}})}};
        list<auto> args2;
        string sql = mem.getSelectSql(sh2, \args2);
        assertEq(True, sql.find("extra") != -1, sql);
        assertEq((1,), args2);
    }

    #! a registered resolver receives the query's connection and the table name as given
    testRegisteredResolverIsUsed(SelectGenerationContext ctx) {
        checkDb(ctx);
        list<string> names = ();
        list<bool> same_ds = ();
        sqlutil_register_table_resolver(AbstractTable sub (AbstractDatasource cb_ds, string name) {
            names += name;
            same_ds += (cb_ds === ds);
            return AbstractTable::getTable(cb_ds, name);
        });
        assertEq(True, exists sqlutil_get_table_resolver());

        list<auto> args;
        mem.getSelectSql(nameReferencedSelectHash(), \args);
        # the join and the sub-select both name the same table
        assertEq((ErrTable, ErrTable), names);
        assertEq((True, True), same_ds);

        sqlutil_register_table_resolver();
        assertEq(True, !exists sqlutil_get_table_resolver());
    }

    #! the caching resolver reads a referenced table's description only once per connection and name
    testCachingResolverIssuesNoQueries(SelectGenerationContext ctx) {
        checkDb(ctx);
        hash<auto> sh = nameReferencedSelectHash();
        list<auto> args;

        # without a resolver every generation re-reads the referenced table
        ds.reset();
        for (int i = 0; i < 3; ++i) {
            list<auto> a;
            mem.getSelectSql(sh, \a);
        }
        int uncached = ds.queries;
        assertGt(0, uncached);

        sqlutil_register_table_resolver(\sqlutil_get_cached_table());
        # the first call fills the cache
        mem.getSelectSql(sh, \args);
        ds.reset();
        for (int i = 0; i < 5; ++i) {
            list<auto> a;
            mem.getSelectSql(sh, \a);
        }
        if (m_options.verbose) {
            printf("queries for 3 generations without a resolver: %d; for 5 with the caching resolver: %d\n",
                uncached, ds.queries);
        }
        assertEq(0, ds.queries);
        # the same object is served for the same connection and name
        assertEq(True, sqlutil_get_cached_table(ds, ErrTable) === sqlutil_get_cached_table(ds, ErrTable));
    }

    #! sqlutil_clear_table_cache() discards cached tables so a changed definition is picked up
    testCachingResolverIsInvalidatable(SelectGenerationContext ctx) {
        checkDb(ctx);
        sqlutil_register_table_resolver(\sqlutil_get_cached_table());
        AbstractTable first = sqlutil_get_cached_table(ds, ErrTable);
        assertEq(True, first === sqlutil_get_cached_table(ds, ErrTable));

        # clearing one table on one connection
        sqlutil_clear_table_cache(ds, ErrTable);
        AbstractTable second = sqlutil_get_cached_table(ds, ErrTable);
        assertEq(False, first === second);

        # clearing every table on one connection
        sqlutil_clear_table_cache(ds);
        assertEq(False, second === sqlutil_get_cached_table(ds, ErrTable));

        # clearing every connection
        AbstractTable third = sqlutil_get_cached_table(ds, ErrTable);
        sqlutil_clear_table_cache();
        assertEq(False, third === sqlutil_get_cached_table(ds, ErrTable));

        # clearing a name that was never cached is a no-op
        sqlutil_clear_table_cache(ds, "no_such_table_" + ErrTable);
        sqlutil_clear_table_cache(NOTHING, "no_such_table_" + ErrTable);
    }

    #! repeated generation produces byte-identical SQL and bind arguments, cached or not
    testGenerationIsStable(SelectGenerationContext ctx) {
        checkDb(ctx);
        hash<auto> sh = nameReferencedSelectHash();
        list<auto> first_args;
        string first = mem.getSelectSql(sh, \first_args);
        for (int i = 0; i < 3; ++i) {
            list<auto> args;
            assertEq(first, mem.getSelectSql(sh, \args));
            assertEq(first_args, args);
        }

        sqlutil_register_table_resolver(\sqlutil_get_cached_table());
        for (int i = 0; i < 3; ++i) {
            list<auto> args;
            assertEq(first, mem.getSelectSql(sh, \args));
            assertEq(first_args, args);
        }

        # the generated SQL must still execute
        assertEq((), mem.selectRows(sh) ?? ());
        ds.rollback();
    }

    #! concurrent resolution through the caching resolver yields a single shared object
    testConcurrentResolution(SelectGenerationContext ctx) {
        checkDb(ctx);
        sqlutil_register_table_resolver(\sqlutil_get_cached_table());
        const int Threads = 8;
        Counter cnt(Threads);
        Mutex m();
        list<auto> results = ();
        list<hash<ExceptionInfo>> errors = ();
        for (int i = 0; i < Threads; ++i) {
            background sub () {
                on_exit cnt.dec();
                try {
                    AbstractTable t = mem.getSubtableFromString(ErrTable, NOTHING);
                    m.lock();
                    on_exit m.unlock();
                    results += t;
                } catch (hash<ExceptionInfo> ex) {
                    m.lock();
                    on_exit m.unlock();
                    errors += ex;
                }
            }();
        }
        cnt.waitForZero();
        assertEq((), errors);
        assertEq(Threads, results.size());
        map assertEq(True, $1 === results[0]), results;
    }

    #! concurrent generation through shared resolved tables is safe and produces identical SQL
    testConcurrentGeneration(SelectGenerationContext ctx) {
        checkDb(ctx);
        sqlutil_register_table_resolver(\sqlutil_get_cached_table());
        hash<auto> sh = nameReferencedSelectHash();
        const int Threads = 8;
        Counter cnt(Threads);
        Mutex m();
        list<string> results = ();
        list<hash<ExceptionInfo>> errors = ();
        for (int i = 0; i < Threads; ++i) {
            background sub () {
                on_exit cnt.dec();
                try {
                    list<auto> args;
                    string sql = mem.getSelectSql(sh, \args);
                    m.lock();
                    on_exit m.unlock();
                    results += sql;
                } catch (hash<ExceptionInfo> ex) {
                    m.lock();
                    on_exit m.unlock();
                    errors += ex;
                }
            }();
        }
        cnt.waitForZero();
        assertEq((), errors);
        assertEq(Threads, results.size());
        map assertEq(results[0], $1), results;
    }

    #! with a resolver registered, naming a sub-select's table must not cost more than supplying the object
    /** A generation that names its tables resolves each name with the registered resolver, which returns the cached
        table: it builds no table object and reads no description, as a generation given the objects does.  It took
        4.5 times as long, and read the referenced table's description on every call, when a name was always
        resolved by building a new table object.  The queries and the tables resolved are counted, which makes this
        independent of the speed and load of the machine and of the database.
    */
    testNameReferenceCost(SelectGenerationContext ctx) {
        checkDb(ctx);
        list<AbstractTable> resolved = ();
        sqlutil_register_table_resolver(AbstractTable sub (AbstractDatasource rds, string name) {
            AbstractTable t = sqlutil_get_cached_table(rds, name);
            push resolved, t;
            return t;
        });
        hash<auto> by_name = nameReferencedSelectHash();
        hash<auto> by_object = objectReferencedSelectHash();
        # the first generation fills the cache
        list<auto> args;
        string name_sql = mem.getSelectSql(by_name, \args);
        AbstractTable cached = sqlutil_get_cached_table(ds, ErrTable);

        hash<string, int> by_name_work = generationWork(by_name, name_sql, \resolved);
        list<AbstractTable> resolved_by_name = resolved;
        hash<string, int> by_object_work = generationWork(by_object, mem.getSelectSql(by_object, \args),
            \resolved);
        if (m_options.verbose) {
            printf("%d generations: by name: %y; by object: %y\n", Iterations, by_name_work, by_object_work);
        }
        # the join and the sub-select each name the table
        assertEq({"queries": 0, "resolved": 2 * Iterations, "changed": 0}, by_name_work,
            "naming the tables reads no description and resolves each name to the cached table");
        assertEq({"queries": 0, "resolved": 0, "changed": 0}, by_object_work,
            "supplying the tables reads no description and resolves no name");
        assertEq((), (select resolved_by_name, $1 !== cached), "every name resolves to the cached table");
    }

    #! Returns the queries made and the tables resolved by generating the SQL of the given select hash repeatedly
    /** \c changed is the number of generations whose SQL differs from the given SQL.
    */
    private hash<string, int> generationWork(hash<auto> sh, string expected_sql,
            reference<list<AbstractTable>> resolved) {
        resolved = ();
        ds.reset();
        int changed = 0;
        for (int i = 0; i < Iterations; ++i) {
            list<auto> args;
            if (mem.getSelectSql(sh, \args) != expected_sql) {
                ++changed;
            }
        }
        return {"queries": ds.queries, "resolved": resolved.size(), "changed": changed};
    }
}
