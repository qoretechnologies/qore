#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
#
# Copyright 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires SqlUtil
%requires PgsqlSqlUtilBase
%requires PgsqlSqlUtil
%requires QUnit

%try-module pgsql
%define NoPgsql
%endtry

%exec-class PgsqlSearchPathTest

#! PostgreSQL introspection resolves an unqualified name in the schema of the connection's search_path
/** The test creates a schema of its own for the run and sets it as the search_path of its connection (with
    \c PGOPTIONS, before the connection is opened), and a decoy schema outside the search_path with objects of the
    same names but other definitions; every object described or listed must be the run schema's.  A third schema,
    whose name must be quoted, and the decoy schema hold the functions of triggers that name them with their schema,
    some called with arguments, and a fourth schema, whose name has a \c ".", holds objects whose names have one too,
    which are looked up with quoted names.  The schemas are dropped when the test ends, also when it fails.
*/
class PgsqlSearchPathTest inherits QUnit::Test {
    private {
        #! the connection string; no value if no PostgreSQL database is configured
        *string connstr;
        #! the connection that creates and drops the schemas, opened with the default search_path
        *Datasource admin;
        #! the connection of the tests, whose search_path is the run schema
        *Datasource ds;
        #! the PGOPTIONS environment variable before the test set it
        *string pgoptions;
        string run_schema;
        string decoy_schema;
        #! a schema outside the search_path whose name must be quoted (upper case letters and a space)
        string other_schema;
        #! a schema outside the search_path whose name has a "."
        string dot_schema;

        #! a function name that must be quoted, with a quote and a parenthesis
        const QuotedFunction = "Sp\"(Tf";
    }

    constructor() : Test("PgsqlSearchPathTest", "1.0", \ARGV) {
        addTestCase("the connection's schema is the run schema", \currentSchema());
        addTestCase("functions are looked up in the search_path", \functions());
        addTestCase("functions are listed from the search_path", \listFunctions());
        addTestCase("types are looked up and listed in the search_path", \types());
        addTestCase("tables, indexes and triggers are the run schema's", \tables());
        addTestCase("partitions are named as in the run schema", \partitions());
        addTestCase("sequences and views are the run schema's", \sequencesAndViews());
        addTestCase("trigger functions named with their schema are the functions the triggers execute",
            \qualifiedTriggerFunctions());
        addTestCase("a table with qualified trigger functions is dropped and created again as it was",
            \qualifiedTriggerFunctionRoundTrip());
        addTestCase("a table with qualified trigger functions is aligned with its description",
            \qualifiedTriggerFunctionAlignment());
        addTestCase("sequences are described with their start, increment, minimum, maximum and cycle",
            \sequenceAttributes());
        addTestCase("existing sequences are aligned without SQL and keep their values", \sequenceAlignment());
        addTestCase("functions given quoted names are looked up in the schema the name gives",
            \quotedFunctionNames());
        addTestCase("tables given quoted names are looked up in the schema the name gives", \quotedTableNames());
        addTestCase("sequences, views and types given quoted names are looked up in the schema the name gives",
            \quotedObjectNames());

        {
            on_exit cleanup();
            setup();
            set_return_value(main());
        }
    }

    #! returns a part of a schema name: lower case letters, digits and underscores
    private static string namePart(string str, int max) {
        str = str.lwr();
        str =~ s/[^a-z0-9_]/_/g;
        return str.substr(0, max);
    }

    private setup() {
%ifdef NoPgsql
        return;
%endif
        connstr = ENV.QORE_DB_CONNSTR_PGSQL;
        if (!connstr) {
            return;
        }
        string tail = sprintf("%s_%d_%d", PgsqlSearchPathTest::namePart(gethostname(), 16), getpid(),
            get_epoch_seconds(now_utc()));
        run_schema = "qtest_searchpath_" + tail;
        decoy_schema = "qtest_spdecoy_" + tail;
        other_schema = "Qtest Sp " + tail;
        dot_schema = "Qtest.Dot " + tail;

        # the schemas are created and dropped with the default search_path
        admin = new Datasource(connstr);
        if (admin.getDriverName() != "pgsql") {
            throw "PGSQL-ERROR", sprintf("cannot run the PostgreSQL tests with driver %y", admin.getDriverName());
        }
        admin.open();
        {
            on_error admin.rollback();
            on_success admin.commit();
            createObjects(run_schema, {
                "columns": "id int not null primary key, name text",
                "index_col": "name",
                "seq": "start 1 increment 1",
                "fn": "select 1",
                "tfn": "new.name := 'run trigger'",
                "type": "a int, b text",
                "bound": "0) to (100",
                "view": "select 1 as run_col",
            });
            # the decoy is created after the run schema, so a lookup across schemas finds it last
            createObjects(decoy_schema, {
                "columns": "id int not null, other_col text",
                "index_col": "other_col",
                "seq": "start 100 increment 5",
                "fn": "select 2",
                "tfn": "new.other_col := 'decoy trigger'",
                "type": "x int",
                "bound": "0) to (50",
                "view": "select 2 as decoy_col",
            });
            createQualifiedTriggerObjects();
            createQuotedNameObjects();
        }

        # every connection of this process opened from now on has the run schema as its search_path
        pgoptions = ENV.PGOPTIONS;
        setenv("PGOPTIONS", (pgoptions ? pgoptions + " " : "") + "-c search_path=" + run_schema + ",public");
        ds = new Datasource(connstr);
        ds.open();
    }

    private createObjects(string schema, hash<auto> def) {
        admin.exec(sprintf("create schema %s", schema));
        admin.exec(sprintf("create table %s.sp_t (%s)", schema, def.columns));
        admin.exec(sprintf("create index sp_t_ix on %s.sp_t (%s)", schema, def.index_col));
        admin.exec(sprintf("create sequence %s.sp_seq %s", schema, def.seq));
        admin.exec(sprintf("create function %s.sp_f() returns int language sql as '%s'", schema, def.fn));
        admin.exec(sprintf("create function %s.sp_tf() returns trigger language plpgsql as "
            "$$ begin %s; return new; end $$", schema, def.tfn));
        admin.exec(sprintf("create trigger sp_trg before insert on %s.sp_t for each row execute function "
            "%s.sp_tf()", schema, schema));
        # an overload of the trigger function's name, so that the name alone does not identify a function
        admin.exec(sprintf("create function %s.sp_tf(int) returns int language sql as 'select 1'", schema));
        admin.exec(sprintf("create type %s.sp_type as (%s)", schema, def.type));
        admin.exec(sprintf("create table %s.sp_p (id int not null, v text) partition by range (id)", schema));
        admin.exec(sprintf("create table %s.sp_p1 partition of %s.sp_p for values from (%s)", schema, schema,
            def.bound));
        admin.exec(sprintf("create view %s.sp_v as %s", schema, def.view));
    }

    #! returns an identifier quoted as PostgreSQL quotes it: in double quotes, with each double quote doubled
    private static string quote(string id) {
        return "\"" + replace(id, "\"", "\"\"") + "\"";
    }

    #! returns the source of a trigger function that sets a column, as PostgreSQL returns it
    private static string triggerFunctionSource(string column, string value) {
        return sprintf("returns trigger language plpgsql as $function$ begin new.%s := '%s'; return new; end "
            "$function$", column, value);
    }

    #! returns the source of a trigger function that sets a column to its trigger arguments, separated by \c "|"
    private static string argumentFunctionSource(string column) {
        return sprintf("returns trigger language plpgsql as $function$ begin new.%s := array_to_string(tg_argv, '|'); "
            "return new; end $function$", column);
    }

    #! returns the functions of the triggers of sp_qt as the triggers name them, with the column each one sets
    /** each hash gives:
        - \c function: the function as the trigger names it
        - \c column: the column it sets
        - \c value: the value it sets
        - \c source: the source of the function
        - \c args: the arguments of the trigger, as PostgreSQL gives them
        - \c create: the function as it is named when it is created, if not \c function
        - \c create_args: the arguments of the trigger as it is created, if not \c args
    */
    private hash<string, hash<auto>> getQualifiedTriggerFunctions() {
        hash<string, hash<auto>> rv = {
            "sp_qt_a": {"function": quote(other_schema) + "." + quote(QuotedFunction), "column": "a",
                "value": "quoted schema, quoted name"},
            "sp_qt_b": {"function": quote(other_schema) + ".sp_plain", "column": "b",
                "value": "quoted schema, plain name"},
            "sp_qt_c": {"function": decoy_schema + "." + quote(QuotedFunction), "column": "c",
                "value": "plain schema, quoted name"},
            "sp_qt_d": {"function": decoy_schema + ".sp_plain", "column": "d",
                "value": "plain schema, plain name"},
        };
        map rv{$1.key} += {"source": PgsqlSearchPathTest::triggerFunctionSource($1.value.column, $1.value.value),
            "args": "()"}, rv.pairIterator();

        # functions called with trigger arguments: literals with upper case letters, commas, quotes and
        # parentheses, an empty literal, and a number, which PostgreSQL gives as a literal
        rv += {
            "sp_qt_e": {"function": quote(other_schema) + "." + quote("Sp Args"), "column": "e",
                "args": "('X y', 'a,b')", "value": "X y|a,b"},
            "sp_qt_f": {"function": decoy_schema + ".sp_args", "column": "f",
                "args": "('it''s (1)', '')", "value": "it's (1)|"},
            "sp_qt_g": {"function": "sp_args_run", "create": run_schema + ".sp_args_run", "column": "g",
                "args": "('1')", "create_args": "(1)", "value": "1"},
        };
        foreach string key in (("sp_qt_e", "sp_qt_f", "sp_qt_g")) {
            rv{key}.source = PgsqlSearchPathTest::argumentFunctionSource(rv{key}.column);
        }
        return rv;
    }

    #! creates the table sp_qt in the run schema, whose triggers execute functions in other schemas
    /** the run schema has functions of the same names that set every column to \c "decoy"
    */
    private createQualifiedTriggerObjects() {
        admin.exec(sprintf("create schema %s", quote(other_schema)));
        admin.exec(sprintf("create table %s.sp_qt (id int not null primary key, a text, b text, c text, d text, "
            "e text, f text, g text)", run_schema));
        foreach string name in ((quote(QuotedFunction), "sp_plain", quote("Sp Args"), "sp_args")) {
            admin.exec(sprintf("create function %s.%s() returns trigger language plpgsql as $function$ begin "
                "new.a := 'decoy'; new.b := 'decoy'; new.c := 'decoy'; new.d := 'decoy'; new.e := 'decoy'; "
                "new.f := 'decoy'; new.g := 'decoy'; return new; end $function$", run_schema, name));
        }
        foreach hash<auto> i in (getQualifiedTriggerFunctions().pairIterator()) {
            string fname = i.value.create ?? i.value.function;
            admin.exec(sprintf("create function %s() %s", fname, i.value.source));
            admin.exec(sprintf("create trigger %s before insert on %s.sp_qt for each row execute function %s%s",
                i.key, run_schema, fname, i.value.create_args ?? i.value.args));
        }
    }

    #! creates objects whose names have a "." in a schema whose name has one, and decoys in the run schema
    private createQuotedNameObjects() {
        admin.exec(sprintf("create schema %s", quote(dot_schema)));
        foreach hash<auto> i in ({quote(dot_schema): "dot", run_schema: "run"}.pairIterator()) {
            admin.exec(sprintf("create function %s.\"c.d\"() returns text language sql as 'select ''%s'''", i.key,
                i.value));
            admin.exec(sprintf("create table %s.\"T.1\" (id int, %s_col text)", i.key, i.value));
            admin.exec(sprintf("create view %s.\"V.1\" as select 1 as %s_col", i.key, i.value));
            admin.exec(sprintf("create type %s.\"Ty.1\" as (%s_a int)", i.key, i.value));
        }
        # sequences only outside the search_path: getSequence() does not describe the start or the increment of a
        # sequence on PostgreSQL 10 and later, so only its existence shows which schema it is looked up in
        admin.exec(sprintf("create sequence %s.\"S.1\"", quote(dot_schema)));
        admin.exec(sprintf("create sequence %s.sp_seq_decoy", decoy_schema));
        # sequences with attributes other than the defaults
        admin.exec(sprintf("create sequence %s.sp_seq_attr as integer start 7 increment 3 minvalue 5 maxvalue 1000 "
            "cycle", run_schema));
        admin.exec(sprintf("create sequence %s.sp_seq_desc increment -2", run_schema));
        admin.exec(sprintf("create sequence %s.sp_seq_int as integer start 10", run_schema));
        admin.exec(sprintf("create sequence %s.sp_seq_adv start 10", run_schema));
        # a quoted name in a schema with a plain name, and a plain name in a schema with a quoted one
        admin.exec(sprintf("create table %s.\"Sp Tab\" (id int, sp_col text)", decoy_schema));
        admin.exec(sprintf("create table %s.sp_plain_t (id int, plain_col text)", quote(other_schema)));
    }

    private cleanup() {
        if (ds) {
            ds.rollback();
            ds.close();
        }
        if (pgoptions) {
            setenv("PGOPTIONS", pgoptions);
        } else {
            unsetenv("PGOPTIONS");
        }
        if (admin) {
            admin.rollback();
            # one statement, so that every schema is dropped or none
            admin.exec(sprintf("drop schema if exists %s cascade", (foldl $1 + ", " + $2,
                (map quote($1), (run_schema, decoy_schema, other_schema, dot_schema)))));
            admin.commit();
        }
    }

    private Datasource getDatasource() {
        if (!ds) {
            testSkip("no PostgreSQL database is configured (QORE_DB_CONNSTR_PGSQL)");
        }
        return ds;
    }

    private currentSchema() {
        Datasource ds = getDatasource();
        assertEq(run_schema, ds.selectRow("select current_schema() as s").s);
    }

    private functions() {
        Datasource ds = getDatasource();
        Database db(ds);
        foreach string name in (("sp_f", "sp_f()")) {
            *AbstractFunction f = db.getFunction(name);
            assertEq(True, exists f, name);
            assertRegex("select 1", f.src, name);
            assertNRegex("select 2", f.src, name);
        }
        # a qualified name is looked up in its schema, also outside the search_path
        *AbstractFunction decoy = db.getFunction(decoy_schema + ".sp_f");
        assertEq(True, exists decoy);
        assertRegex("select 2", decoy.src);
        assertEq(True, exists db.getFunction(decoy_schema + ".sp_f()"));
        # no such function in the run schema
        assertNothing(db.getFunction("sp_no_such_function"));
    }

    private listFunctions() {
        Datasource ds = getDatasource();
        Database db(ds);
        list<string> l = db.listFunctions();
        assertEq(True, inlist("sp_f()", l), "the run schema's function is listed unqualified");
        assertEq(True, inlist("sp_tf()", l), "the run schema's trigger function is listed unqualified");
        assertEq(1, (select l, $1 == "sp_f()").size(), "the function is listed once");
        assertEq((), (select l, $1.find(decoy_schema) >= 0), "no function outside the search_path is listed");
        # every name listed is found
        foreach string name in (select l, $1 =~ /^sp_/) {
            assertEq(True, exists db.getFunction(name), name);
        }
    }

    private types() {
        Datasource ds = getDatasource();
        Database db(ds);
        auto t = db.getType("sp_type");
        assertEq(True, exists t);
        assertRegex("^a ", t.src);
        assertNRegex("x int", t.src);
        list<string> l = db.listTypes();
        assertEq(1, (select l, $1 == "sp_type").size(), "the type is listed once, unqualified");
        assertEq((), (select l, $1.find(decoy_schema) >= 0), "no type outside the search_path is listed");
    }

    private tables() {
        Datasource ds = getDatasource();
        on_exit ds.rollback();
        Table t(ds, "sp_t");
        AbstractTable table = t.getTable();
        assertEq(("id", "name"), table.describe().keys());
        hash<auto> indexes = map {$1.name: $1.columns.keys()}, table.getIndexes().iterator();
        assertEq(("name",), indexes.sp_t_ix);
        assertEq(("sp_trg",), table.getTriggers().keys());
        # the trigger function is the run schema's, named as the trigger names it: without a schema
        list<auto> sql = table.getCreateSql();
        assertEq(1, (select sql, $1.typeCode() == NT_STRING && $1 =~ /run trigger/).size(), sprintf("%Y", sql));
        assertEq((), (select sql, $1.typeCode() == NT_STRING && $1 =~ /decoy trigger/), sprintf("%Y", sql));
        assertEq(1, (select table.getCreateMiscSql(), $1 =~ /^create function sp_tf\(\) /).size());
        # and runs on an insert
        t.insert({"id": 1});
        assertEq("run trigger", t.selectRow({"where": {"id": 1}}).name);
    }

    private partitions() {
        Datasource ds = getDatasource();
        Table t(ds, "sp_p");
        hash<string, PartitionInfo> ph = t.getTable().listPartitions();
        assertEq(("sp_p1",), keys ph);
        assertEq(run_schema, ph.sp_p1.schema);
        # the name read back resolves to the same partition
        assertEq("sp_p1", t.getTable().getPartition("sp_p1").name);
        # a partition is not a table
        list<string> tables = (new Database(ds)).listTables();
        assertEq(True, inlist("sp_p", tables));
        assertEq(False, inlist("sp_p1", tables));
    }

    private sequencesAndViews() {
        Datasource ds = getDatasource();
        Database db(ds);
        assertEq("sp_seq", db.getSequence("sp_seq").name);
        # a sequence only in the decoy schema is found only with its schema
        assertNothing(db.getSequence("sp_seq_decoy"));
        assertEq("sp_seq_decoy", db.getSequence(decoy_schema + ".sp_seq_decoy").name);
        *AbstractView v = db.getView("sp_v");
        assertRegex("run_col", v.src);
    }

    #! returns the SQL that creates the trigger functions of sp_qt
    private list<string> getQualifiedTriggerFunctionSql() {
        return sort(map sprintf("create function %s() %s", $1.function, $1.source),
            getQualifiedTriggerFunctions().iterator());
    }

    #! returns the schemas that have a function of the given name
    private list<string> getFunctionSchemas(string name) {
        return sort(ds.select("select n.nspname from pg_catalog.pg_proc p join pg_catalog.pg_namespace n "
            "on n.oid = p.pronamespace where p.proname = %v", name).nspname ?? ());
    }

    private qualifiedTriggerFunctions() {
        Datasource ds = getDatasource();
        PgsqlTable t(ds, "sp_qt");
        hash<string, AbstractTrigger> triggers = map {$1.name: $1}, t.getTriggers().iterator();
        assertEq(sort(keys getQualifiedTriggerFunctions()), sort(keys triggers));
        foreach hash<auto> i in (getQualifiedTriggerFunctions().pairIterator()) {
            # the trigger names its function as PostgreSQL does, with the case of quoted identifiers kept
            assertEq(sprintf("before insert on sp_qt for each row execute function %s%s", i.value.function,
                i.value.args), triggers{i.key}.src, i.key);
        }
        # each trigger function is read from the schema the trigger names, not the run schema's decoy
        list<string> sql = sort(t.getCreateMiscSql() ?? ());
        assertEq(getQualifiedTriggerFunctionSql(), sql);
        assertEq((), (select sql, $1 =~ /:= 'decoy'/));
    }

    private qualifiedTriggerFunctionRoundTrip() {
        Datasource ds = getDatasource();
        on_exit ds.rollback();
        PgsqlTable t(ds, "sp_qt");
        list<auto> create_sql = t.getCreateSql();
        list<auto> drop_sql = t.getDropSql();

        # the table's trigger functions are dropped with it; the run schema's decoys are not
        map ds.exec($1), drop_sql;
        foreach string name in ((QuotedFunction, "sp_plain", "Sp Args", "sp_args")) {
            assertEq((run_schema,), getFunctionSchemas(name), name);
        }
        assertEq((), getFunctionSchemas("sp_args_run"));
        assertFalse((new PgsqlTable(ds, "sp_qt")).checkExistence());

        map ds.exec($1), create_sql;
        assertEq(sort((decoy_schema, other_schema, run_schema)), getFunctionSchemas(QuotedFunction));
        assertEq(sort((decoy_schema, other_schema, run_schema)), getFunctionSchemas("sp_plain"));
        assertEq(sort((other_schema, run_schema)), getFunctionSchemas("Sp Args"));
        assertEq(sort((decoy_schema, run_schema)), getFunctionSchemas("sp_args"));
        assertEq((run_schema,), getFunctionSchemas("sp_args_run"));

        # the triggers execute the functions of the schemas they name
        ds.exec("insert into sp_qt (id) values (1)");
        hash<auto> row = ds.selectRow("select a, b, c, d, e, f, g from sp_qt where id = 1");
        assertEq((map {$1.column: $1.value}, getQualifiedTriggerFunctions().iterator()), row);

        # and the table is described as it was
        assertEq(create_sql, (new PgsqlTable(ds, "sp_qt")).getCreateSql());
    }

    #! returns a description of sp_qt with its triggers and trigger functions
    private hash<auto> getQualifiedTriggerDescription(PgsqlTable t) {
        hash<auto> desc = t.getDescriptionHash();
        foreach hash<auto> i in (getQualifiedTriggerFunctions().pairIterator()) {
            desc.functions{i.value.function + "()"} = i.value.source;
            desc.triggers{i.key} = sprintf("before insert on sp_qt for each row execute function %s%s",
                i.value.function, i.value.args);
        }
        return desc;
    }

    private qualifiedTriggerFunctionAlignment() {
        Datasource ds = getDatasource();
        PgsqlTable t(ds, "sp_qt");
        hash<auto> desc = getQualifiedTriggerDescription(t);

        PgsqlTable template(ds, "sp_qt");
        template.setupTable(desc);
        assertEq((), t.getAlignSql(template) ?? ());

        # a trigger naming a function whose quoted name differs only in case names another function
        string other_function = quote(other_schema) + "." + quote(QuotedFunction.lwr());
        desc.triggers.sp_qt_a = sprintf("before insert on sp_qt for each row execute function %s()",
            other_function);
        template = new PgsqlTable(ds, "sp_qt");
        template.setupTable(desc);
        list<auto> sql = t.getAlignSql(template) ?? ();
        assertEq(("drop trigger sp_qt_a on " + t.getSqlName(), "create trigger sp_qt_a " + desc.triggers.sp_qt_a),
            sql);

        # a trigger argument differing only in case is another argument
        desc = getQualifiedTriggerDescription(t);
        desc.triggers.sp_qt_e = sprintf("before insert on sp_qt for each row execute function %s('x y', 'a,b')",
            getQualifiedTriggerFunctions().sp_qt_e.function);
        template = new PgsqlTable(ds, "sp_qt");
        template.setupTable(desc);
        assertEq(("drop trigger sp_qt_e on " + t.getSqlName(), "create trigger sp_qt_e " + desc.triggers.sp_qt_e),
            t.getAlignSql(template) ?? ());
    }

    #! returns the attributes of a sequence
    private static hash<auto> getSequenceAttributes(AbstractSequence seq) {
        PgsqlSequence pseq = cast<PgsqlSequence>(seq);
        return {
            "start": pseq.start.toInt(),
            "increment": pseq.increment.toInt(),
            "max": exists pseq.max ? pseq.max.toInt() : NOTHING,
            "min": exists pseq.min ? pseq.min.toInt() : NOTHING,
            "cycle": pseq.cycle,
        };
    }

    private sequenceAttributes() {
        Datasource ds = getDatasource();
        on_exit ds.rollback();
        Database db(ds);
        # a maximum or minimum that is the default of a bigint sequence in its direction is not given
        hash<string, hash<auto>> expected = {
            "sp_seq_attr": {"start": 7, "increment": 3, "max": 1000, "min": 5, "cycle": True,
                "sql": "create sequence sp_seq_attr start with 7 increment by 3 maxvalue 1000 minvalue 5 cycle"},
            "sp_seq_desc": {"start": -1, "increment": -2, "max": NOTHING, "min": NOTHING, "cycle": False,
                "sql": "create sequence sp_seq_desc start with -1 increment by -2 no maxvalue"},
            # the maximum of an integer sequence is given, as a sequence is created as a bigint sequence
            "sp_seq_int": {"start": 10, "increment": 1, "max": 2147483647, "min": NOTHING, "cycle": False,
                "sql": "create sequence sp_seq_int start with 10 increment by 1 maxvalue 2147483647"},
            "sp_seq": {"start": 1, "increment": 1, "max": NOTHING, "min": NOTHING, "cycle": False,
                "sql": "create sequence sp_seq start with 1 increment by 1 no maxvalue"},
        };
        foreach hash<auto> i in (expected.pairIterator()) {
            AbstractSequence seq = db.getSequence(i.key);
            assertEq(i.value - "sql", PgsqlSearchPathTest::getSequenceAttributes(seq), i.key);
            assertEq(i.value.sql, seq.getCreateSql(), i.key);
        }
        # the decoy schema's sequence of the same name
        assertEq({"start": 100, "increment": 5, "max": NOTHING, "min": NOTHING, "cycle": False},
            PgsqlSearchPathTest::getSequenceAttributes(db.getSequence(decoy_schema + ".sp_seq")));

        # a sequence created with the SQL of its description is described as it was
        AbstractSequence seq = db.getSequence("sp_seq_attr");
        ds.exec(seq.getDropSql());
        ds.exec(seq.getCreateSql());
        assertEq(PgsqlSearchPathTest::getSequenceAttributes(seq),
            PgsqlSearchPathTest::getSequenceAttributes(db.getSequence("sp_seq_attr")));
    }

    private sequenceAlignment() {
        Datasource ds = getDatasource();
        on_exit ds.rollback();
        Database db(ds);
        # advance the sequence
        map ds.selectRow("select nextval('sp_seq_adv')"), xrange(3);

        # a sequence as it is described produces no SQL
        assertEq((), db.getAlignSql({"tables": {}, "sequences": {
            "sp_seq_adv": {"start": 10, "increment": 1},
            "sp_seq_attr": {"start": 7, "increment": 3, "end": 1000, "min": 5, "cycle": True},
        }}));
        # an existing sequence whose parameters differ is altered, never created again nor restarted, so it keeps
        # its value (@since SqlUtil 3.11.0; before, a parameter difference produced no SQL)
        list<auto> sql = db.getAlignSql({"tables": {}, "sequences": {"sp_seq_adv": {"start": 1, "increment": 5,
            "end": 50}}});
        assertEq(("alter sequence sp_seq_adv increment by 5 maxvalue 50",), sql);
        map ds.exec($1), sql;
        # the current value (12, after three nextval calls on a sequence that starts at 10) is preserved, and the
        # new increment of 5 applies, so the next value is 17, not a value from a recreated sequence
        assertEq(17, ds.selectRow("select nextval('sp_seq_adv') as v").v);
        # the altered sequence now describes as it was aligned, so a second alignment produces no SQL
        assertEq((), db.getAlignSql({"tables": {}, "sequences": {"sp_seq_adv": {"start": 1, "increment": 5,
            "end": 50}}}));
        # a missing sequence is created
        assertEq(("create sequence sp_seq_missing start with 3 increment by 1 no maxvalue",),
            db.getAlignSql({"tables": {}, "sequences": {"sp_seq_missing": {"start": 3}}}));
    }

    private quotedFunctionNames() {
        Datasource ds = getDatasource();
        Database db(ds);
        # a quoted schema and name, both with a ".", with and without the argument list
        foreach string name in ((quote(dot_schema) + ".\"c.d\"", quote(dot_schema) + ".\"c.d\"()")) {
            *AbstractFunction f = db.getFunction(name);
            assertEq(True, exists f, name);
            assertEq("\"c.d\"()", f.name, name);
            assertRegex("'dot'", f.src, name);
        }
        # an unqualified quoted name is the run schema's
        assertRegex("'run'", db.getFunction("\"c.d\"").src);
        # quoted schemas and names, also with a quote and a parenthesis in the name, and plain ones
        hash<string, string> names = {
            quote(other_schema) + "." + quote(QuotedFunction): "quoted schema, quoted name",
            quote(other_schema) + "." + quote(QuotedFunction) + "()": "quoted schema, quoted name",
            quote(other_schema) + ".sp_plain": "quoted schema, plain name",
            decoy_schema + "." + quote(QuotedFunction): "plain schema, quoted name",
            decoy_schema + ".sp_plain()": "plain schema, plain name",
        };
        foreach hash<auto> i in (names.pairIterator()) {
            *AbstractFunction f = db.getFunction(i.key);
            assertEq(True, exists f, i.key);
            assertRegex(i.value, f.src, i.key);
        }
        assertEq(quote(QuotedFunction) + "()", db.getFunction(quote(other_schema) + "." + quote(QuotedFunction)).name);
        # a quoted name is looked up with its case
        assertNothing(db.getFunction(quote(dot_schema) + ".\"C.D\""));
        assertNothing(db.getFunction(quote(other_schema) + "." + quote(QuotedFunction.lwr())));
    }

    private quotedTableNames() {
        Datasource ds = getDatasource();
        on_exit ds.rollback();
        # a quoted schema and name, both with a "."
        Table t(ds, quote(dot_schema) + ".\"T.1\"");
        AbstractTable table = t.getTable();
        assertTrue(table.checkExistence());
        assertEq(("id", "dot_col"), table.describe().keys());
        assertEq(dot_schema, table.getSchemaName());
        assertEq(quote(dot_schema) + ".\"T.1\"", table.getSqlName());
        t.insert({"id": 1, "dot_col": "x"});
        assertEq({"id": 1, "dot_col": "x"}, t.selectRow({"where": {"id": 1}}));

        # an unqualified quoted name is the run schema's
        PgsqlTable run_table(ds, "\"T.1\"");
        assertEq(("id", "run_col"), run_table.describe().keys());
        assertEq(run_schema, run_table.getSchemaName());

        # a quoted name in a plain schema, and a plain name in a quoted schema
        assertEq(("id", "sp_col"), (new PgsqlTable(ds, decoy_schema + ".\"Sp Tab\"")).describe().keys());
        assertEq(("id", "plain_col"), (new PgsqlTable(ds, quote(other_schema) + ".sp_plain_t")).describe().keys());
    }

    private quotedObjectNames() {
        Datasource ds = getDatasource();
        Database db(ds);
        assertEq("\"S.1\"", db.getSequence(quote(dot_schema) + ".\"S.1\"").name);
        assertNothing(db.getSequence("\"S.1\""));
        assertNothing(db.getSequence(quote(dot_schema) + ".\"s.1\""));
        assertRegex("dot_col", db.getView(quote(dot_schema) + ".\"V.1\"").src);
        assertRegex("run_col", db.getView("\"V.1\"").src);
        assertRegex("dot_a", db.getType(quote(dot_schema) + ".\"Ty.1\"").src);
        assertRegex("run_a", db.getType("\"Ty.1\"").src);
    }
}
