#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires SqlUtil
%requires PgsqlSqlUtil
%requires QUnit

%prepend-module-path "${SCRIPT_DIR}"
%requires ./PgsqlTestIsolation.qm

%try-module pgsql
%define NoPgsql
%endtry

%exec-class PgsqlSerialAlignmentTest

#! Tests aligning columns to and from the serial pseudo-types on PostgreSQL (issue #853)
/** A serial pseudo-type is not a type that a column can be altered to: the column gets the integer type of the
    pseudo-type with a sequence of its own as its default, as PostgreSQL creates a serial column
*/
public class PgsqlSerialAlignmentTest inherits QUnit::Test {
    private {
        bool m_live = False;
    }

    constructor() : QUnit::Test("PgsqlSerialAlignment", "1.0", \ARGV) {
        addTestCase("an integer column is aligned to each serial pseudo-type", \toSerial());
        addTestCase("serial columns aligned with serial pseudo-types are unchanged", \unchanged());
        addTestCase("a serial column is aligned to another serial pseudo-type", \serialToSerial());
        addTestCase("a serial column is aligned to its integer type", \serialToInt());
        set_return_value(main());
    }

    globalTearDown() {
        if (m_live) {
            PgsqlRunSchema::teardown();
        }
    }

    private Datasource connectOrSkip() {
%ifdef NoPgsql
        testSkip("pgsql module unavailable");
%endif
        if (!ENV.QORE_DB_CONNSTR_PGSQL) {
            testSkip("QORE_DB_CONNSTR_PGSQL is not set");
        }
        if (!m_live) {
            PgsqlRunSchema::setup(ENV.QORE_DB_CONNSTR_PGSQL, "PgsqlSerialAlignment");
            m_live = True;
        }
        return new Datasource(ENV.QORE_DB_CONNSTR_PGSQL);
    }

    #! returns the description of a test table with the given native type of column \c n
    private static hash<auto> getDesc(string table, string n_type) {
        return {
            "columns": {
                "id": {"native_type": "integer", "notnull": True},
                "n": {"native_type": n_type, "notnull": True},
            },
            "primary_key": {"name": table + "_pkey", "columns": "id"},
        };
    }

    #! aligns the table with the description, and checks that aligning it again changes nothing
    private alignTwice(Datasource ds, string table, string n_type) {
        Database db(ds);
        hash<auto> desc = getDesc(table, n_type);
        list<auto> sql = db.getTable(table).getAlignSql(db.makeTable(table, desc));
        assertTrue(sql.size() > 0, n_type);
        map ds.exec($1), sql;
        ds.commit();
        assertEq((), db.getTable(table).getAlignSql(db.makeTable(table, desc)), n_type + " again");
    }

    #! returns the type of the column \c n, its sequence, and the type of the sequence
    private static hash<auto> getSerialInfo(Datasource ds, string table) {
        return ds.selectRow("select format_type(a.atttypid, a.atttypmod) as type, "
            "pg_get_serial_sequence(%v, 'n') is not null as owned, "
            "(select format_type(s.seqtypid, null) from pg_sequence s "
            "  where s.seqrelid = pg_get_serial_sequence(%v, 'n')::regclass) as seqtype "
            "from pg_attribute a where a.attrelid = %v::regclass and a.attname = 'n'", table, table, table);
    }

    toSerial() {
        Datasource ds = connectOrSkip();
        on_exit ds.rollback();
        foreach hash<auto> h in ({"type": "smallserial", "int": "smallint"}, {"type": "serial", "int": "integer"},
                {"type": "bigserial", "int": "bigint"}) {
            string table = "ser_to_" + h.type;
            ds.exec(sprintf("create table %s (id integer not null primary key, n integer)", table));
            ds.exec(sprintf("insert into %s values (1, 5), (2, 7)", table));
            ds.commit();
            alignTwice(ds, table, h.type);
            assertEq({"type": h.int, "owned": True, "seqtype": h.int}, getSerialInfo(ds, table), h.type);
            # the sequence starts after the greatest value of the column
            ds.exec(sprintf("insert into %s (id) values (3)", table));
            assertEq(8, ds.selectRow(sprintf("select n from %s where id = 3", table)).n, h.type);
            ds.commit();
        }
    }

    unchanged() {
        Datasource ds = connectOrSkip();
        on_exit ds.rollback();
        ds.exec("create table ser_same (id integer not null primary key, a smallserial, b serial, c bigserial)");
        ds.commit();
        Database db(ds);
        hash<auto> desc = {
            "columns": {
                "id": {"native_type": "integer", "notnull": True},
                "a": {"native_type": "smallserial", "notnull": True},
                "b": {"native_type": "serial", "notnull": True},
                "c": {"native_type": "bigserial", "notnull": True},
            },
            "primary_key": {"name": "ser_same_pkey", "columns": "id"},
        };
        assertEq((), db.getTable("ser_same").getAlignSql(db.makeTable("ser_same", desc)));
    }

    serialToSerial() {
        Datasource ds = connectOrSkip();
        on_exit ds.rollback();
        ds.exec("create table ser_widen (id integer not null primary key, n smallserial)");
        ds.exec("insert into ser_widen (id) values (1), (2)");
        ds.commit();
        alignTwice(ds, "ser_widen", "bigserial");
        # the column keeps its sequence, which gets the column's type
        assertEq({"type": "bigint", "owned": True, "seqtype": "bigint"}, getSerialInfo(ds, "ser_widen"));
        ds.exec("insert into ser_widen (id) values (3)");
        assertEq(3, ds.selectRow("select n from ser_widen where id = 3").n);
        ds.commit();
    }

    serialToInt() {
        Datasource ds = connectOrSkip();
        on_exit ds.rollback();
        ds.exec("create table ser_to_int (id integer not null primary key, n serial)");
        ds.commit();
        alignTwice(ds, "ser_to_int", "integer");
        assertEq(NULL, ds.selectRow("select column_default from information_schema.columns "
            "where table_schema = current_schema() and table_name = 'ser_to_int' and column_name = 'n'")
            .column_default);
    }
}
