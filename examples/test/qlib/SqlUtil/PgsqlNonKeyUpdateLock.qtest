#!/usr/bin/env qore
# Copyright 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires SqlUtil
%requires PgsqlSqlUtilBase
%try-module pgsql
%define NoPgsql
%endtry
%exec-class NonKeyLockTest

class UnsupportedLockTable inherits PgsqlSqlUtilBase::PgsqlTable {
    constructor(AbstractDatasource ds, string name) : PgsqlTable(ds, name) {}
    private bool supportsNonKeyUpdateLocksImpl() { return False; }
}
class NonKeyLockTest inherits Test {
    private { int serial; }
    constructor() : Test("Explicit non-key update row locks", "1.0", \ARGV) {
        addTestCase("explicit option capability and invalid combinations", \contract());
        addTestCase("independent deferred foreign-key commit is compatible only with explicit non-key locking", \foreignKey());
        addTestCase("non-key lock excludes row writers deletes and key-changing moves", \writers());
        addTestCase("existing foreign-key readers permit non-key writers but exclude ordinary update locks", \readers());
        set_return_value(main());
    }
    private Datasource connection() {
%ifdef NoPgsql
        testSkip("pgsql module unavailable");
%endif
        if (!ENV.QORE_DB_CONNSTR_PGSQL) { testSkip("set QORE_DB_CONNSTR_PGSQL to a disposable database"); }
        Datasource ds(ENV.QORE_DB_CONNSTR_PGSQL); ds.open(); ds.setAutoCommit(False);
        if (ds.getServerVersion() < 170000) { testSkip("PostgreSQL17+ is required for bounded fixture transactions"); }
        return ds;
    }
    private hash<auto> fixture(bool deferred = True) {
        Datasource ds = connection();
        string name = sprintf("nonkey_%d_%d", getpid(), ++serial);
        hash<auto> f = {"ds": ds, "tables": ()}; on_error cleanup(f);
        hash<auto> column = {"qore_type": "number", "size": 10, "notnull": True};
        foreach string suffix in (("parent", "audit")) {
            string table_name = name + "_" + suffix;
            AbstractTable table = (new Table(ds, {"columns": {"id": column, "value": column},
                "primary_key": {"name": table_name + "_pk", "columns": ("id",)}}, table_name)).getTable();
            table.createCommit(); f.tables += table;
        }
        f.parent = f.tables[0]; f.audit = f.tables[1];
        f.audit.addForeignConstraint(name + "_fk", ("value",), f.parent.getName(), ("id",),
            {"deferrable": True, "initially_deferred": deferred});
        f.parent.insert({"id": 1, "value": 0}); ds.commit(); return f;
    }
    private cleanup(hash<auto> f) {
        f.ds.rollback();
        for (int i = f.tables.size() - 1; i >= 0; --i) {
            f.tables[i].dropCommit(); assertFalse(f.tables[i].checkExistence());
        }
        f.ds.commit();
    }
    private contract() {
        hash<auto> f = fixture(); on_exit cleanup(f);
        assertTrue(f.parent.supportsNonKeyUpdateLocks());
        assertTrue(f.parent.getSelectSql({"forupdate": True}).endsWith(" for update"));
        assertTrue(f.parent.getSelectSql({"forupdate": True, "forupdate_no_key": True}).endsWith(" for no key update"));
        assertTrue(f.parent.getSelectSql({"forupdate": True, "forupdate_no_key": False}).endsWith(" for update"));
        assertEq(-1, f.parent.getSelectSql({"forupdate_no_key": False}).find(" for "));
        assertThrows("OPTION-ERROR", sub() { f.parent.getSelectSql({"forupdate": True, "forupdate_no_key": "invalid"}); });

        assertThrows("OPTION-ERROR", sub() { f.parent.selectRow({"forupdate_no_key": True}); });
        assertThrows("OPTION-ERROR", sub() { f.parent.selectRow({"forupdate": False, "forupdate_no_key": True}); });
        assertThrows("OPTION-ERROR", sub() { f.parent.selectRow({"forupdate": True, "forupdate_no_key": True,
            "superquery": {"columns": "id"}}); });
        UnsupportedLockTable unsupported(f.ds, f.parent.getName());
        assertFalse(unsupported.supportsNonKeyUpdateLocks());
        assertThrows("NONKEY-UPDATE-LOCK-NOT-SUPPORTED", sub() {
            unsupported.selectRow({"forupdate": True, "forupdate_no_key": True});
        });
        assertEq(1, unsupported.selectRow({"forupdate": True, "forupdate_no_key": False}).id.toInt());
        f.ds.rollback();
        assertEq(1, f.parent.selectRow({"forupdate": True, "forupdate_no_key": True}).id.toInt());
        assertTrue(f.ds.currentThreadInTransaction()); f.ds.rollback();
    }
    private foreignKey() {
        foreach bool nonkey in ((False, True)) {
            hash<auto> f = fixture(); on_exit cleanup(f);
            Datasource other = connection(); on_exit other.rollback();
            AbstractTable audit = AbstractTable::getTable(other, f.audit.getName()); other.rollback();
            f.parent.selectRow({"where": {"id": 1}, "forupdate": True, "forupdate_no_key": nonkey});
            audit.beginBoundedTransaction(150, 1000, 5000);
            audit.insert({"id": 1, "value": 1});
            assertEq(!nonkey, commitBlocked(other));
            f.ds.rollback();
            assertEq(nonkey ? 1 : 0, f.audit.selectRows().size()); f.ds.rollback();
        }
    }
    private writers() {
        foreach string action in (("status", "key", "delete", "strict-lock", "nonkey-lock")) {
            hash<auto> f = fixture(); on_exit cleanup(f);
            Datasource other = connection(); on_exit other.rollback();
            AbstractTable parent = AbstractTable::getTable(other, f.parent.getName()); other.rollback();
            f.parent.selectRow({"where": {"id": 1}, "forupdate": True, "forupdate_no_key": True});
            parent.beginBoundedTransaction(150, 1000, 5000);
            bool blocked = False;
            try {
                if (action == "status") { parent.update({"value": 1}, {"id": 1}); }
                else if (action == "key") { parent.update({"id": 2}, {"id": 1}); }
                else if (action == "delete") { parent.del({"id": 1}); }
                else { parent.selectRow({"where": {"id": 1}, "forupdate": True,
                    "forupdate_no_key": action == "nonkey-lock"}); }
            } catch (hash<ExceptionInfo> ex) {
                assertTrue(ex.desc.find("lock timeout") >= 0); blocked = True;
            }
            other.rollback(); assertTrue(blocked, action); f.ds.rollback();
            assertEq(0, f.parent.selectRow({"where": {"id": 1}}).value.toInt()); f.ds.rollback();
        }
    }
    private readers() {
        foreach bool nonkey in ((False, True)) {
            hash<auto> f = fixture(False); on_exit cleanup(f);
            Datasource other = connection(); on_exit other.rollback();
            AbstractTable parent = AbstractTable::getTable(other, f.parent.getName()); other.rollback();
            f.audit.insert({"id": 1, "value": 1});
            parent.beginBoundedTransaction(150, 1000, 5000);
            bool blocked = False;
            try { parent.selectRow({"where": {"id": 1}, "forupdate": True, "forupdate_no_key": nonkey}); }
            catch (hash<ExceptionInfo> ex) { assertTrue(ex.desc.find("lock timeout") >= 0); blocked = True; }
            other.rollback(); assertEq(!nonkey, blocked); f.ds.rollback();
        }
    }
    private bool commitBlocked(AbstractDatasource ds) {
        try { ds.commit(); return False; }
        catch (hash<ExceptionInfo> ex) {
            assertTrue(ex.desc.find("lock timeout") >= 0); ds.rollback(); return True;
        }
    }
}
