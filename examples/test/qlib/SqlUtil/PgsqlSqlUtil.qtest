        const GenericOptions = {
            "replace": True,
        };

        const T_VectorTest = {
            "columns": {
                "id": c_number(14, True),
                "vec_f": c_vector(3, True, "test vector column"),
                "halfvec_f": c_halfvec(5),
                "sparsevec_f": c_sparsevec(10),
            },
            "primary_key": {"name": "pk_vector_test", "columns": ("id",)},
