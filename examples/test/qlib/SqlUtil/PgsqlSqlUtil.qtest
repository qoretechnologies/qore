}

class PgsqlTest inherits SqlTestBase {
    public {
        hash<SchemaAlignmentInfo> schema_info;

        const CustomColumns = {
            "varchar": (
                "value": "hello",
                "size": "20",
            ),
            "char": (
                "value": "hello",
                "size": "20",
            ),
            "numeric": (
                "size": 15,
                "scale": 2,
                "value": 400.95n,
            ),
            "numeric_def": (
                "type": "numeric",
                "value": 400.95n,
            ),

            "smallint": 100,
            "integer": 1928381,
            "bigint": 2198374739812,

            "smallserial": 100,
            "serial": 39484392,
            "bigserial": 129383948393,

            "real": 1.5,
            "double precision": 3.1415927,
            "float": 3.141592653589793238,
            "oid": 1234, # should not be used

            "date": 2016-01-11,
            "interval": 6M + 3D + 2h + 45m + 15s,
            "time": 09:26:52,
            "time with time zone": 09:27:03-06,
            "timetz": 09:27:03-06,
            "timestamp": 2016-02-11T09:26:14,
            "timestamp with time zone": 2016-02-11T09:28:12.384629+03,
            "timestamptz": 2016-02-11T09:28:12.384629+03,

            /*
            "money": (
                "value": 400.56,
%ifndef NoPgsql
                "bind": pgsql_bind(PG_TYPE_CASH, "400.56"),
%endif
            ),
            */
            "text": "test",
            "character": "c",
            "character varying": "character varying",

            "bool": True,
            "boolean": False,

            "bytea": <bead>,
%ifndef NoPgsql
            "bit": ("bind": pgsql_bind(PG_TYPE_BIT, "10011001"), "size": 8, "expect": <99>),
            "varbit": ("bind": pgsql_bind(PG_TYPE_VARBIT, "xBEAF"), "expect": <BEAF>),

            "macaddr": ("bind": pgsql_bind(PG_TYPE_MACADDR, "0a:1e:df:e4:4f:da")),
            "inet": ("bind": pgsql_bind(PG_TYPE_INET, "192.168.11.1"), "expect": "192.168.11.1/32"),
            "cidr": ("bind": pgsql_bind(PG_TYPE_CIDR, "192.168"), "expect": "192.168.0.0/24"),

            "json": {"bind": pgsql_bind(PG_TYPE_JSON, "{\"a\": 1}")},
            "jsonb": {"bind": pgsql_bind(PG_TYPE_JSON, "{\"a\": 1}")},
            "xml": {"bind": pgsql_bind(PG_TYPE_XML, "<a>1</a>")},
%endif
        };
    }

    constructor() : SqlTestBase("PgsqlTest", "1.0", \ARGV, MyOpts) {
        Datasource ds;
        try {
            ds = getDatasource();
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose)
                printf("%s: %s\n", ex.err, ex.desc);
            # skip tests if we can't create the datasource
        }

        if (ds) {
            initTestData(CustomColumns);

            { # Make sure the DB is clear before doing the tests.
                PgsqlTable t = new PgsqlTable(ds, "pgsql_test");
                if (t.checkExistence())
                    t.dropCommit();
            }

            # create the test schema
            schema = new PgsqlTestSchema(ds);

            # workaround for issue #853 (https://github.com/qoretechnologies/qore/issues/853)
            try {
                on_error ds.rollback();
                on_success ds.commit();
                ds.exec("drop table pgsql_test");
            } catch () {}
            try {
                on_error ds.rollback();
                on_success ds.commit();
                ds.exec("drop sequence pgsql_test_seq");
            } catch () {}

            schema_info = schema.alignWithInfo(False, m_options.verbose, m_options.verbose > 0);

            # get table object
            table = (new Table(schema.getDatasource(), "pgsql_test")).getTable();

            addTestCase("create schema", \createSchema());
            addTestCase("sequence operators", \testSequenceOperators());
            addTestCase("analytic/window functions", \testAnalyticFunctions());
            addTestCase("default value", \testDefaultValue());
            addTestCase("pgsqlutil: schema align with trigger drop #2963", \test2963());
            addTestCase("proxy bulk upsert", \proxyBulkUpsertTest());
            addTestCase("pgvector type support", \pgvectorTest());
            addTestCase("pgvector ivfflat index", \pgvectorIvfflatIndexTest());
            addTestCase("pg_get_indexdef parser", \pgIndexDefParserTest());
        }

        set_return_value(main());
    }

    createSchema() {
        on_error printf("alignment: %y\n", map {AbstractDatabase::ActionMap{$1.key}: $1.value},
            schema_info.change_map.pairIterator());
        assertTrue(schema_info.created);
    }

    testSequenceOperators() {
        if (!table)
            testSkip("no DB connection");

        hash sh = (
            "columns": ("id", cop_seq("pgsql_test_seq", "seq"), cop_seq_currval("pgsql_test_seq", "seq_currval")),
            "where": ("id": 2),
        );

        assertEq(("id": 2, "seq": 1, "seq_currval": 1), table.selectRow(sh));
        assertEq(("id": 2, "seq": 2, "seq_currval": 2), table.selectRow(sh));
        assertEq(("id": 2, "seq": 3, "seq_currval": 3), table.selectRow(sh));

        assertEq(1, table.update(("id": uop_seq("pgsql_test_seq")), ("id": 2)));
        sh."where".id = 4;
        assertEq(("id": 4, "seq": 5, "seq_currval": 5), table.selectRow(sh));
    }

    testDefaultValue() {
        if (!table)
            testSkip("no DB connection");

        AbstractColumn c = table.describe().dvtest_f;
        AbstractColumn new_col = c.copy();
        new_col.def_val =~ s/::.*//;
        assertRegex("::character varying", c.def_val);
        assertNRegex("::character varying", new_col.def_val);
        list l = c.getModifySql(table, new_col);
        assertEq((), l);
    }

    private test2963() {
        AbstractDatasource ds = getDatasource();
        on_exit ds.rollback();

        Bug2963Schema schema(ds);
        # to create test schema without triggers
        auto res = schema.align(False, m_options.verbose, m_options.verbose > 0);

        # create trigger outseide the schema
        ds.execRaw("create function pgsql_test_2963_func() returns trigger\n"
                   "language plpgsql as $function$\n"
                   "begin\n"
                   "   null;\n"
                   "end;\n"
                   "$function$");
        ds.execRaw("create trigger pgsql_test_2963_func "
                   "before insert on pgsql_test_2963 execute procedure pgsql_test_2963_func()");

        # align the schema again to drop trigger (and function)
        res = schema.align(False, m_options.verbose, m_options.verbose > 0);
        # 1 = drop trigger
        # 2 = drop function
        assertEq(2, res, "2 actions must be performed");
    }

    #! Tests that bulk upsert UNNEST works with non-DatasourcePool AbstractDatasource subclasses
    /** When the datasource is not a Datasource or DatasourcePool, getBulkUpsertClosure() should
        fall back to using ds.vexec() instead of SQLStatement for the UNNEST path.
    */
    private proxyBulkUpsertTest() {
        if (!table) {
            testSkip("no DB connection");
        }

        AbstractDatasource real_ds = getDatasource();
        DatasourceProxy proxy(real_ds);

        # verify proxy is NOT a Datasource or DatasourcePool
        assertEq(False, proxy instanceof Datasource);
        assertEq(False, proxy instanceof DatasourcePool);
        # verify proxy reports array bind capability
        assertEq(True, (proxy.getCapabilities() & DBI_CAP_HAS_ARRAY_BIND) != 0);

        # create the table with the real datasource, then swap in the proxy for the upsert
        AbstractTable proxy_table = (new Table(real_ds, "pgsql_test")).getTable();
        proxy_table.setDatasource(proxy);

        on_error real_ds.rollback();
        on_success real_ds.commit();

        # insert seed rows via real_ds so all NOT NULL columns are satisfied
        proxy_table.setDatasource(real_ds);
        proxy_table.del({"id": op_in((500, 501, 502))});
        real_ds.commit();
        map proxy_table.insert({"id": $1, "id_": $1 + 100, "blob_f": <cafe>, "clob_f": "test"}),
            (500, 501, 502);
        real_ds.commit();

        # swap to proxy datasource for the bulk upsert test
        proxy_table.setDatasource(proxy);

        # test UpsertAuto: update existing rows with new id_ values via UNNEST through vexec()
        code upsert = proxy_table.getBulkUpsertClosure(
            {"id": 500, "id_": 900, "blob_f": <cafe>, "clob_f": "test"},
            AbstractTable::UpsertAuto);

        int result = upsert({
            "id": (500, 501, 502),
            "id_": (900, 901, 902),
            "blob_f": (<cafe>, <cafe>, <cafe>),
            "clob_f": ("test", "test", "test"),
        });
        assertEq(AbstractTable::UR_Verified, result);
        proxy.commit();

        # verify the upsert updated the rows through the proxy
        proxy_table.setDatasource(real_ds);
        assertEq(900, proxy_table.selectRow({"where": {"id": 500}}).id_);
        assertEq(901, proxy_table.selectRow({"where": {"id": 501}}).id_);
        assertEq(902, proxy_table.selectRow({"where": {"id": 502}}).id_);

        # clean up
        proxy_table.del({"id": op_in((500, 501, 502))});

        # negative test: prove that SQLStatement cannot be used with a proxy datasource;
        # this is the runtime failure that the vexec() fallback above is designed to prevent.
        # we pass the proxy typed as AbstractDatasource (as in real Qorus usage) so the
        # parse-time type checker accepts it; at runtime, overload resolution rejects the
        # proxy because it is not a Datasource or DatasourcePool
        AbstractDatasource ads = proxy;
        assertThrows("RUNTIME-OVERLOAD-ERROR", sub () { new SQLStatement(ads); });
    }

    private pgvectorTest() {
        if (!table) {
            testSkip("no DB connection");
        }

        AbstractDatasource ds = getDatasource();
        on_exit ds.rollback();

        # check if pgvector extension is available
        *hash<auto> ext_row = ds.selectRow("select * from pg_extension where extname = %v", "vector");
        if (!ext_row) {
            testSkip("pgvector extension not installed");
        }

        # test Schema helper functions produce correct column hashes
        hash<GenericColumnInfo> vec_col = c_vector(3, True, "test vector column");
        assertEq("vector", vec_col.driver.pgsql.native_type, "c_vector native_type");
        assertEq(3, vec_col.driver.pgsql.size, "c_vector size");
        assertEq(True, vec_col.notnull, "c_vector notnull");
        assertEq("test vector column", vec_col.comment, "c_vector comment");

        hash<GenericColumnInfo> hv_col = c_halfvec(5);
        assertEq("halfvec", hv_col.driver.pgsql.native_type, "c_halfvec native_type");
        assertEq(5, hv_col.driver.pgsql.size, "c_halfvec size");

        hash<GenericColumnInfo> sv_col = c_sparsevec(10, True);
        assertEq("sparsevec", sv_col.driver.pgsql.native_type, "c_sparsevec native_type");
        assertEq(10, sv_col.driver.pgsql.size, "c_sparsevec size");
        assertEq(True, sv_col.notnull, "c_sparsevec notnull");

        # comment-only overloads
        hash<GenericColumnInfo> vec_col2 = c_vector(3, "my comment");
        assertEq("my comment", vec_col2.comment, "c_vector comment-only overload");
        hash<GenericColumnInfo> hv_col2 = c_halfvec(5, "hv comment");
        assertEq("hv comment", hv_col2.comment, "c_halfvec comment-only overload");
        hash<GenericColumnInfo> sv_col2 = c_sparsevec(10, "sv comment");
        assertEq("sv comment", sv_col2.comment, "c_sparsevec comment-only overload");

        string tname = "pgsql_vector_test";

        # clean up if table exists from a previous failed run
        {
            PgsqlTable t(ds, tname);
            if (t.checkExistence()) {
                t.dropCommit();
            }
        }

        # test schema creation with vector columns
        PgsqlTestVectorSchema vec_schema(ds);
        hash<SchemaAlignmentInfo> info = vec_schema.alignWithInfo(False, m_options.verbose,
            m_options.verbose > 0);
        assertTrue(info.created, "vector schema created");

        # get table and describe it
        PgsqlTable vec_table(ds, tname);
        assertTrue(vec_table.checkExistence(), "vector table exists");

        Columns cols = vec_table.describe();

        # verify vector column was correctly described
        assertTrue(cols.hasKey("vec_f"), "vector column exists");
        assertEq("vector", cols.vec_f.native_type, "vector native_type from describe");
        assertEq(3, cols.vec_f.size, "vector dimension from describe");
        assertEq(False, cols.vec_f.nullable, "vector not null from describe");

        # verify halfvec column
        assertTrue(cols.hasKey("halfvec_f"), "halfvec column exists");
        assertEq("halfvec", cols.halfvec_f.native_type, "halfvec native_type from describe");
        assertEq(5, cols.halfvec_f.size, "halfvec dimension from describe");
        assertEq(True, cols.halfvec_f.nullable, "halfvec nullable from describe");

        # verify sparsevec column
        assertTrue(cols.hasKey("sparsevec_f"), "sparsevec column exists");
        assertEq("sparsevec", cols.sparsevec_f.native_type, "sparsevec native_type from describe");
        assertEq(10, cols.sparsevec_f.size, "sparsevec dimension from describe");

        # test getNativeTypeString() produces correct DDL
        assertEq("vector(3)", cols.vec_f.getNativeTypeString(), "vector getNativeTypeString");
        assertEq("halfvec(5)", cols.halfvec_f.getNativeTypeString(), "halfvec getNativeTypeString");
        assertEq("sparsevec(10)", cols.sparsevec_f.getNativeTypeString(), "sparsevec getNativeTypeString");

        # test schema re-alignment (should report no real changes)
        hash<SchemaAlignmentInfo> info2 = vec_schema.alignWithInfo(False, m_options.verbose,
            m_options.verbose > 0);
        assertFalse(info2.created, "vector schema re-align not created");
        # all entries should be "unchanged"
        assertEq(info2.num_changes, info2.change_map.unchanged ?? 0,
            "vector schema re-align only unchanged");

        # test SchemaReverse for vector columns
        TableReverse rev(ds, tname);
        hash<auto> rev_hash = rev.toQore();
        assertEq("vector", rev_hash.columns.vec_f.driver.pgsql.native_type,
            "reverse vector native_type");
        assertEq(3, rev_hash.columns.vec_f.driver.pgsql.size, "reverse vector size");
        assertEq(True, rev_hash.columns.vec_f.driver.pgsql.notnull, "reverse vector notnull");

        assertEq("halfvec", rev_hash.columns.halfvec_f.driver.pgsql.native_type,
            "reverse halfvec native_type");
        assertEq(5, rev_hash.columns.halfvec_f.driver.pgsql.size, "reverse halfvec size");
        assertEq(False, rev_hash.columns.halfvec_f.driver.pgsql.notnull, "reverse halfvec notnull");

        assertEq("sparsevec", rev_hash.columns.sparsevec_f.driver.pgsql.native_type,
            "reverse sparsevec native_type");
        assertEq(10, rev_hash.columns.sparsevec_f.driver.pgsql.size, "reverse sparsevec size");

        # test vector column without dimension constraint (SZ_OPT allows this)
        {
            on_error ds.rollback();
            on_success ds.commit();
            ds.execRaw("create table pgsql_vector_nodim_test (id serial primary key, "
                "vec_f vector)");
        }
        {
            PgsqlTable nodim_table(ds, "pgsql_vector_nodim_test");
            Columns nodim_cols = nodim_table.describe();
            assertEq("vector", nodim_cols.vec_f.native_type,
                "dimensionless vector native_type");
            assertEq(0, nodim_cols.vec_f.size, "dimensionless vector size is 0");
            assertEq("vector", nodim_cols.vec_f.getNativeTypeString(),
                "dimensionless vector getNativeTypeString no parens");
            on_error ds.rollback();
            on_success ds.commit();
            nodim_table.drop();
        }

        # test unknown USER-DEFINED type falls through gracefully
        {
            on_error ds.rollback();
            on_success ds.commit();
            ds.execRaw("do $$ begin "
                "if not exists (select 1 from pg_type where typname = 'test_status_enum') then "
                "create type test_status_enum as enum ('active', 'inactive'); "
                "end if; end $$");
            ds.execRaw("create table pgsql_udt_test (id serial primary key, "
                "status test_status_enum)");
        }
        {
            PgsqlTable udt_table(ds, "pgsql_udt_test");
            Columns udt_cols = udt_table.describe();
            # unknown USER-DEFINED type should not crash; column is still described
            assertTrue(udt_cols.hasKey("status"), "unknown USER-DEFINED column exists");
            # the type falls through as USER-DEFINED since it's not in PgsqlTypeMap
            assertEq("USER-DEFINED", udt_cols.status.native_type,
                "unknown USER-DEFINED native_type preserved");
            on_error ds.rollback();
            on_success ds.commit();
            udt_table.drop();
            ds.execRaw("drop type test_status_enum");
        }

        # clean up
        vec_table.dropCommit();
    }

    #! Unit test for parsePgIndexDef — no DB required
    private pgIndexDefParserTest() {
        # simple btree with no extras
        hash<auto> r = PgsqlTable::parsePgIndexDef(
            "CREATE INDEX sk_users_name ON public.users USING btree (name)");
        assertEq(NOTHING, r.with_options, "simple btree: no with");
        assertEq(NOTHING, r.opclass, "simple btree: no opclass");

        # unique btree with per-column opclass
        r = PgsqlTable::parsePgIndexDef(
            "CREATE UNIQUE INDEX uk_users_email ON public.users USING btree "
            "(email varchar_pattern_ops)");
        assertEq(NOTHING, r.with_options, "varchar_pattern_ops: no with");
        assertEq("varchar_pattern_ops", r.opclass.email, "varchar_pattern_ops: opclass");

        # ivfflat with WITH clause and opclass (integer coerced back to int)
        r = PgsqlTable::parsePgIndexDef(
            "CREATE INDEX sk_ai_chunks_embedding ON public.ai_chunks USING ivfflat "
            "(embedding vector_cosine_ops) WITH (lists='100')");
        assertEq("vector_cosine_ops", r.opclass.embedding, "ivfflat: opclass");
        assertEq(100, r.with_options.lists, "ivfflat: lists coerced to int");

        # hnsw with multiple WITH options
        r = PgsqlTable::parsePgIndexDef(
            "CREATE INDEX sk_ai_chunks_embedding ON public.ai_chunks USING hnsw "
            "(embedding vector_l2_ops) WITH (m='16', ef_construction='64')");
        assertEq("vector_l2_ops", r.opclass.embedding, "hnsw: opclass");
        assertEq(16, r.with_options.m, "hnsw: m");
        assertEq(64, r.with_options.ef_construction, "hnsw: ef_construction");

        # multi-column, mixed default/non-default opclasses — default is not reported by PG so we
        # should only see the non-default ones
        r = PgsqlTable::parsePgIndexDef(
            "CREATE INDEX sk_mixed ON public.t USING btree (a, b varchar_pattern_ops)");
        assertEq(NOTHING, r.opclass.a, "multi-col: default opclass not reported");
        assertEq("varchar_pattern_ops", r.opclass.b, "multi-col: non-default opclass reported");
    }

    #! End-to-end ivfflat index test — requires pgvector installed
    private pgvectorIvfflatIndexTest() {
        if (!table) {
            testSkip("no DB connection");
        }

        AbstractDatasource ds = getDatasource();
        on_exit ds.rollback();

        *hash<auto> ext_row = ds.selectRow("select * from pg_extension where extname = %v", "vector");
        if (!ext_row) {
            testSkip("pgvector extension not installed");
        }

        # build a table description with a vector column and an ivfflat index
        hash<auto> tdesc = {
            "columns": {
                "id": {"qore_type": Type::Int, "notnull": True},
                "embedding": {"driver": {"pgsql": {"native_type": "vector", "size": 3}}},
            },
            "primary_key": {"name": "pk_ivfflat_test", "columns": ("id",)},
            "indexes": {
                "sk_ivfflat_test_emb": {
                    "columns": ("embedding",),
                    "method": "ivfflat",
                    "with": {"lists": 100},
                    "opclass": {"embedding": "vector_cosine_ops"},
                },
            },
        };

        string tname = "pgsql_ivfflat_test";

        # clean up a leftover from a previous failed run
        {
            PgsqlTable t0(ds, tname);
            if (t0.checkExistence()) {
                t0.dropCommit();
            }
        }

        # create + populate the table via setupTable
        PgsqlTable t(ds, tname);
        t.setupTable(tdesc);
        t.create();
        ds.commit();
        on_exit {
            ds.rollback();
            PgsqlTable tc(ds, tname);
            if (tc.checkExistence()) {
                tc.dropCommit();
            }
        }

        # verify the index exists with the right access method
        *string amname = ds.selectRow(
            "select am.amname from pg_class i, pg_am am "
            "where i.relkind = 'i' and i.relname = %v and i.relam = am.oid",
            "sk_ivfflat_test_emb").amname;
        assertEq("ivfflat", amname, "ivfflat access method recorded in catalog");

        # verify the reconstructed DDL captures the WITH clause and opclass
        *string indexdef = ds.selectRow(
            "select pg_get_indexdef(i.oid, 0, false) indexdef from pg_class i "
            "where i.relkind = 'i' and i.relname = %v", "sk_ivfflat_test_emb").indexdef;
        assertTrue(indexdef.lwr().find("ivfflat") >= 0, "DDL contains ivfflat");
        assertTrue(indexdef.lwr().find("vector_cosine_ops") >= 0, "DDL contains opclass");
        assertTrue(indexdef.lwr().find("lists") >= 0, "DDL contains WITH lists");

        # re-describe the table and verify round-trip through PgsqlIndex.equalImpl: the loaded
        # definition must compare equal to a fresh one built from the same hash so that a second
        # alignment reports no drift
        PgsqlTable t2(ds, tname);
        Indexes live_ix = t2.getIndexes();
        assertTrue(live_ix.hasKey("sk_ivfflat_test_emb"), "ivfflat index present in describe");
        PgsqlIndex live = cast<PgsqlIndex>(live_ix.sk_ivfflat_test_emb);
        assertEq("ivfflat", live.method, "reverse-engineered method");
        assertEq(100, live.with_options.lists, "reverse-engineered WITH lists");
        assertEq("vector_cosine_ops", live.opclass.embedding, "reverse-engineered opclass");

        # construct an expected PgsqlIndex with the same column reference, and verify they compare equal
        Columns emb_cols = t2.describe();
        hash<auto> ch = {"embedding": emb_cols.embedding};
        PgsqlIndex expected("sk_ivfflat_test_emb", False, ch,
            NOTHING, "ivfflat", {"lists": 100}, {"embedding": "vector_cosine_ops"});
        assertTrue(live.equal(expected), "live ivfflat index equals expected definition");
    }

    private string getResultSetSql() {
        testSkip("does not support result set output binds");
        return "";
    }

    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-c,--conn=ARG", "set DB connection argument (ex: \"pgsql:user/pass@db\")", OptionColumn);
    }

    Datasource getDatasource() {
        if (!m_options.connstr)
            m_options.connstr = ENV.QORE_DB_CONNSTR_PGSQL;
        Datasource ds(m_options.connstr);
        if (ds.getDriverName() != "pgsql")
            throw "PGSQL-ERROR", sprintf("cannot execute the pgsql tests on a connection using driver %y", ds.getDriverName());
        ds.open();
        return ds;
    }
}
