    }

    private *hash getGenericOptionsImpl() {
        return GenericOptions;
    }
}

class PgsqlTest inherits SqlTestBase {
    public {
        hash<SchemaAlignmentInfo> schema_info;

        const CustomColumns = {
            "varchar": (
                "value": "hello",
                "size": "20",
            ),
            "char": (
                "value": "hello",
                "size": "20",
            ),
            "numeric": (
                "size": 15,
                "scale": 2,
                "value": 400.95n,
            ),
            "numeric_def": (
                "type": "numeric",
                "value": 400.95n,
            ),

            "smallint": 100,
            "integer": 1928381,
            "bigint": 2198374739812,

            "smallserial": 100,
            "serial": 39484392,
            "bigserial": 129383948393,

            "real": 1.5,
            "double precision": 3.1415927,
            "float": 3.141592653589793238,
            "oid": 1234, # should not be used

            "date": 2016-01-11,
            "interval": 6M + 3D + 2h + 45m + 15s,
            "time": 09:26:52,
            "time with time zone": 09:27:03-06,
            "timetz": 09:27:03-06,
            "timestamp": 2016-02-11T09:26:14,
            "timestamp with time zone": 2016-02-11T09:28:12.384629+03,
            "timestamptz": 2016-02-11T09:28:12.384629+03,

            /*
            "money": (
                "value": 400.56,
%ifndef NoPgsql
                "bind": pgsql_bind(PG_TYPE_CASH, "400.56"),
%endif
            ),
            */
            "text": "test",
            "character": "c",
            "character varying": "character varying",

            "bool": True,
            "boolean": False,

            "bytea": <bead>,
%ifndef NoPgsql
            "bit": ("bind": pgsql_bind(PG_TYPE_BIT, "10011001"), "size": 8, "expect": <99>),
            "varbit": ("bind": pgsql_bind(PG_TYPE_VARBIT, "xBEAF"), "expect": <BEAF>),

            "macaddr": ("bind": pgsql_bind(PG_TYPE_MACADDR, "0a:1e:df:e4:4f:da")),
            "inet": ("bind": pgsql_bind(PG_TYPE_INET, "192.168.11.1"), "expect": "192.168.11.1/32"),
            "cidr": ("bind": pgsql_bind(PG_TYPE_CIDR, "192.168"), "expect": "192.168.0.0/24"),

            "json": {"bind": pgsql_bind(PG_TYPE_JSON, "{\"a\": 1}")},
            "jsonb": {"bind": pgsql_bind(PG_TYPE_JSON, "{\"a\": 1}")},
            "xml": {"bind": pgsql_bind(PG_TYPE_XML, "<a>1</a>")},
%endif
        };
    }

    constructor() : SqlTestBase("PgsqlTest", "1.0", \ARGV, MyOpts) {
        Datasource ds;
        try {
            ds = getDatasource();
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose)
                printf("%s: %s\n", ex.err, ex.desc);
            # skip tests if we can't create the datasource
        }

        if (ds) {
            initTestData(CustomColumns);

            { # Make sure the DB is clear before doing the tests.
                PgsqlTable t = new PgsqlTable(ds, "pgsql_test");
                if (t.checkExistence())
                    t.dropCommit();
            }

            # create the test schema
            schema = new PgsqlTestSchema(ds);

            # workaround for issue #853 (https://github.com/qoretechnologies/qore/issues/853)
            try {
                on_error ds.rollback();
                on_success ds.commit();
                ds.exec("drop table pgsql_test");
            } catch () {}
            try {
                on_error ds.rollback();
                on_success ds.commit();
                ds.exec("drop sequence pgsql_test_seq");
            } catch () {}

            schema_info = schema.alignWithInfo(False, m_options.verbose, m_options.verbose > 0);

            # get table object
            table = (new Table(schema.getDatasource(), "pgsql_test")).getTable();

            addTestCase("create schema", \createSchema());
            addTestCase("sequence operators", \testSequenceOperators());
            addTestCase("analytic/window functions", \testAnalyticFunctions());
            addTestCase("default value", \testDefaultValue());
            addTestCase("pgsqlutil: schema align with trigger drop #2963", \test2963());
            addTestCase("concurrent multi-event trigger introspection", \concurrentTriggerIntrospectionTest());
            addTestCase("proxy bulk upsert", \proxyBulkUpsertTest());
            addTestCase("pgvector extension alignment SQL", \pgvectorExtensionAlignmentSqlTest());
            addTestCase("pgvector type support", \pgvectorTest());
            addTestCase("pgvector ivfflat index", \pgvectorIvfflatIndexTest());
            addTestCase("pg_get_indexdef parser", \pgIndexDefParserTest());
            addTestCase("populate column backfill", \populateColumnTest());
            addTestCase("tables populate FK ordering", \tablesPopulateFkOrderingTest());
            addTestCase("foreign key column order introspection", \foreignKeyColumnOrderIntrospectionTest());
            addTestCase("temporary table resolution", \temporaryTableResolutionTest());
            addTestCase("search_path schema resolution", \searchPathSchemaResolutionTest());
            addTestCase("sequence schema resolution", \sequenceSchemaResolutionTest());
            addTestCase("partition schema coercion and validation", \partitionSchemaCoercionAndValidationTest());
            addTestCase("range partition lifecycle", \rangePartitionLifecycleTest());
            addTestCase("concurrent partition detach", \concurrentPartitionDetachTest());
            addTestCase("partition lifecycle callbacks", \partitionLifecycleCallbackTest());
            addTestCase("insert-select callback forwarding", \insertFromSelectCallbackForwardingTest());
            addTestCase("structured aggregate selection", \structuredAggregateSelectionTest());
            addTestCase("partition enhancements", \partitionEnhancementsTest());
            addTestCase("partition method families", \partitionMethodFamiliesTest());
            addTestCase("partition child not listed as table", \partitionChildExclusionTest());
            addTestCase("PK not backed by non-unique index", \pkNonUniqueIndexTest());
            addTestCase("drop PK constraint without backing index", \dropPkConstraintNoBackingIndexTest());
            addTestCase("schema physical size", \schemaPhysicalSizeTest());
        }

        set_return_value(main());
    }

    createSchema() {
        on_error printf("alignment: %y\n", map {AbstractDatabase::ActionMap{$1.key}: $1.value},
            schema_info.change_map.pairIterator());
        assertTrue(schema_info.created);
    }

    #! Schema physical measurement counts every PostgreSQL storage family once
    private schemaPhysicalSizeTest() {
        AbstractDatasource ds = getDatasource();
        Database db(ds);
        const string SizeSchema = "sqlutil_schema_size_test";
        const string OtherSchema = "sqlutil_schema_size_other";
        const string EmptySchema = "sqlutil_schema_size_empty";

        code cleanup = sub () {
            on_error ds.rollback();
            ds.exec(sprintf("drop schema if exists %s cascade", SizeSchema));
            ds.exec(sprintf("drop schema if exists %s cascade", OtherSchema));
            ds.exec(sprintf("drop schema if exists %s cascade", EmptySchema));
            ds.commit();
        };
        cleanup();
        on_exit cleanup();

        on_error ds.rollback();
        ds.exec(sprintf("create schema %s", SizeSchema));
        ds.exec(sprintf("create schema %s", OtherSchema));
        ds.exec(sprintf("create schema %s", EmptySchema));
        ds.exec(sprintf("create table %s.payloads (id bigint primary key, tag text not null, payload text)",
            SizeSchema));
        ds.exec(sprintf("create index payloads_tag_idx on %s.payloads (tag)", SizeSchema));
        # The correlated digest stream is deliberately incompressible enough to force external TOAST storage.
        ds.exec(sprintf("insert into %s.payloads "
            "select g, 'tag-' || mod(g, 17), (select string_agg(md5((g * 1000 + x)::text), '') "
            "from generate_series(1, 400) x) from generate_series(1, 128) g", SizeSchema));
        ds.exec(sprintf("create table %s.events (id bigint, event_day date, payload text) "
            "partition by range (event_day)", SizeSchema));
        ds.exec(sprintf("create table %s.events_2026_01 partition of %s.events "
            "for values from ('2026-01-01') to ('2026-02-01')", SizeSchema, SizeSchema));
        ds.exec(sprintf("create table %s.events_2026_02 partition of %s.events "
            "for values from ('2026-02-01') to ('2026-03-01')", SizeSchema, SizeSchema));
        ds.exec(sprintf("create index events_payload_idx on %s.events (payload)", SizeSchema));
        ds.exec(sprintf("insert into %s.events values "
            "(1, '2026-01-15', 'one'), (2, '2026-02-15', 'two')", SizeSchema));
        ds.exec(sprintf("create materialized view %s.tag_counts as "
            "select tag, count(*) as count from %s.payloads group by tag", SizeSchema, SizeSchema));
        ds.exec(sprintf("create unique index tag_counts_idx on %s.tag_counts (tag)", SizeSchema));
        ds.exec(sprintf("create sequence %s.standalone_seq", SizeSchema));
        ds.exec(sprintf("create view %s.payload_view as select id, tag from %s.payloads", SizeSchema, SizeSchema));

        # Cross-schema data must not leak into the requested namespace total.
        ds.exec(sprintf("create table %s.other_payloads as select * from %s.payloads", OtherSchema, SizeSchema));
        ds.commit();

        # independent decomposition of the physical storage rooted in a single namespace
        code<int(string)> decompose = int sub (string schema) {
            return ds.selectRow("select "
                "coalesce((select sum(pg_catalog.pg_table_size(c.oid) + pg_catalog.pg_indexes_size(c.oid)) "
                "from pg_catalog.pg_class c join pg_catalog.pg_namespace n on n.oid = c.relnamespace "
                "where n.nspname = %v and c.relkind in ('r', 'm')), 0) "
                "+ coalesce((select sum(pg_catalog.pg_relation_size(c.oid)) "
                "from pg_catalog.pg_class c join pg_catalog.pg_namespace n on n.oid = c.relnamespace "
                "where n.nspname = %v and c.relkind = 'S'), 0) as size_bytes",
                schema, schema).size_bytes;
        };

        int measured = db.getSchemaPhysicalSize(SizeSchema);
        assertEq(decompose(SizeSchema), measured,
            "schema size equals independent table/index/TOAST/sequence decomposition");
        assertGt(0, measured, "populated schema reports allocated bytes");
        assertEq(0, db.getSchemaPhysicalSize(EmptySchema), "empty schema reports zero bytes");

        # Isolation: the other schema holds a copy of the payload data, so a measurement that ignored the
        # requested namespace would return more than this schema's own decomposition.  Each schema must
        # report exactly its own storage; ordering between the two totals is deliberately not asserted, as
        # it is not required to prove isolation.
        int other_measured = db.getSchemaPhysicalSize(OtherSchema);
        assertGt(0, other_measured, "cross-schema fixture data has physical storage of its own");
        assertEq(decompose(OtherSchema), other_measured,
            "measurement is isolated to the requested schema");

        hash<auto> storage = ds.selectRow("select "
            "pg_catalog.pg_total_relation_size(%v::regclass) as table_bytes, "
            "pg_catalog.pg_indexes_size(%v::regclass) as index_bytes, "
            "pg_catalog.pg_total_relation_size(c.reltoastrelid) as toast_bytes "
            "from pg_catalog.pg_class c where c.oid = %v::regclass",
            SizeSchema + ".payloads", SizeSchema + ".payloads", SizeSchema + ".payloads");
        assertGt(0, storage.index_bytes, "secondary and primary indexes have physical storage");
        assertGt(0, storage.toast_bytes, "fixture has physical TOAST storage");
        assertGt(storage.index_bytes + storage.toast_bytes, storage.table_bytes,
            "table total includes index and TOAST storage without adding either twice");

        assertThrows("SCHEMA-NOT-FOUND", "PostgreSQL schema \"sqlutil_schema_size_missing\" does not exist",
            sub () {
                db.getSchemaPhysicalSize("sqlutil_schema_size_missing");
            });
        assertThrows("SCHEMA-NOT-FOUND", "the schema name cannot be empty", sub () {
            db.getSchemaPhysicalSize("");
        });
    }

    #! a primary key must only be backed by a unique index
    /** Regression test: a non-unique index covering the same column set as the primary key (in any
        order) must not be selected as the supporting index for the PK. Previously
        AbstractColumnSupportingConstraint::findMatchingIndex() matched any index with the same
        column set (matchKeys() is order-independent and did not check uniqueness), so a PK could be
        linked to a non-unique index, producing invalid DDL: PostgreSQL rejects
        "alter table ... add constraint ... primary key using index <ix>" with
        "<ix> is not a unique index".
    */
    private pkNonUniqueIndexTest() {
        if (!table) {
            testSkip("no DB connection");
        }

        AbstractDatasource ds = getDatasource();
        string tname = "pgsql_pk_nonuniq_test";
        string pkname = "pk_" + tname;
        string ixname = "sk_" + tname + "_reorder";

        # clean up from any previous failed run
        {
            PgsqlTable t(ds, tname);
            if (t.checkExistence()) {
                t.dropCommit();
            }
        }

        hash<auto> table_desc = {
            "columns": {
                "a": {"qore_type": Type::Int, "notnull": True},
                "b": {"qore_type": Type::Int, "notnull": True},
                "c": {"qore_type": Type::Int, "notnull": True},
            },
            "primary_key": {"name": pkname, "columns": ("a", "b", "c")},
            "indexes": {
                # same column set as the PK but in a different order, and NOT unique
                ixname: {"columns": ("b", "c", "a")},
            },
        };

        AbstractTable t = (new Table(ds, table_desc, tname)).getTable();

        # the generated PK SQL must not reuse the non-unique index as a supporting index
        *string pk_sql = t.getCreatePrimaryKeySql();
        assertNRegex("using index", pk_sql ?? "",
            "PK creation must not reuse a non-unique index");

        # faithful repro: actually create the table to confirm the DDL executes without error
        on_error ds.rollback();
        t.create();
        ds.commit();

        on_exit {
            PgsqlTable dt(ds, tname);
            if (dt.checkExistence()) {
                dt.dropCommit();
            }
        }

        # verify the primary key was created with the expected columns
        PgsqlTable verify(ds, tname);
        AbstractPrimaryKey pk = verify.getPrimaryKey();
        assertFalse(pk.empty(), "primary key created");
        assertEq(("a", "b", "c"), keys pk.getHash(), "primary key columns");

        # verify the non-unique index still exists and is in fact not unique
        Indexes ixs = verify.getIndexes();
        assertTrue(ixs.hasKey(ixname), "non-unique index retained");
        assertFalse(ixs{ixname}.unique, "reorder index is not unique");
    }

    #! dropping a PK constraint must not fail when the backing index is not in the index container
    /** Regression test: on PostgreSQL the index backing a primary key (and a matched unique
        constraint) is deliberately not stored separately in the table's index container (see
        PgsqlTable::getIndexesImpl()). When dropping such a constraint with
        \c sql_callback_executed = True, the internal removal closure called
        Indexes::take(constraint_name) unconditionally; with no matching index present, take()
        returned no value for its non-optional AbstractIndex return type and raised a confusing
        RUNTIME-TYPE-ERROR ("<block return> expects type 'object<AbstractIndex>'"). Because the
        error was thrown from an on_success handler, the table mutex was left locked, so the next
        operation on the table failed with a cascading LOCK-ERROR. Both the constraint removal
        closure and getDropAllConstraintsAndIndexesOnColumnSqlUnlocked() now only remove the index
        if it actually exists in the container.
    */
    private dropPkConstraintNoBackingIndexTest() {
        if (!table) {
            testSkip("no DB connection");
        }

        AbstractDatasource ds = getDatasource();
        string tname = "pgsql_drop_pk_test";
        string pkname = "pk_" + tname;

        code drop_if_exists = sub () {
            PgsqlTable t(ds, tname);
            if (t.checkExistence()) {
                t.dropCommit();
            }
        };

        drop_if_exists();
        on_exit drop_if_exists();

        hash<auto> table_desc = {
            "columns": {
                "a": {"qore_type": Type::Int, "notnull": True},
                "b": {"qore_type": Type::Int, "notnull": True},
            },
            "primary_key": {"name": pkname, "columns": ("a", "b")},
        };

        # create the table in the DB so the PK is real
        on_error ds.rollback();
        AbstractTable created = (new Table(ds, table_desc, tname)).getTable();
        created.create();
        ds.commit();

        # load the table fresh from the DB; the PK's backing index is NOT present in the index
        # container on PostgreSQL, which is the exact condition that previously triggered the error
        PgsqlTable t(ds, tname);
        Indexes ixs = t.getIndexes();
        assertFalse(ixs.hasKey(pkname), "PK backing index is not stored in the index container");

        hash<auto> callback_opts = {"sql_callback_executed": True};

        # before the fix this threw RUNTIME-TYPE-ERROR from the on_success removal closure (the
        # closure unconditionally called Indexes::take() for an index that is not in the container)
        string drop_sql = t.getDropConstraintSql(pkname, callback_opts);
        assertRegex("drop constraint", drop_sql, "PK drop SQL generated without error");

        # execute the generated DDL against the DB, mirroring the real schema-upgrade flow where the
        # collected callback SQL is executed externally (sql_callback_executed = True)
        on_error ds.rollback();
        ds.exec(drop_sql);
        ds.commit();

        # before the fix the mutex was left locked by the failed on_success handler, so this locking
        # call failed with a cascading LOCK-ERROR; confirm a subsequent locking operation works
        list<auto> mod_sql = t.getModifyColumnSql("b", c_number(14), True, callback_opts);
        assertTrue(mod_sql.size() > 0, "subsequent locking operation succeeds (no mutex leak)");

        # verify against the DB that the primary key was actually dropped
        PgsqlTable verify(ds, tname);
        assertTrue(verify.getPrimaryKey().empty(), "primary key dropped from the database");
    }

    testSequenceOperators() {
        if (!table)
            testSkip("no DB connection");

        hash sh = (
            "columns": ("id", cop_seq("pgsql_test_seq", "seq"), cop_seq_currval("pgsql_test_seq", "seq_currval")),
            "where": ("id": 2),
        );

        assertEq(("id": 2, "seq": 1, "seq_currval": 1), table.selectRow(sh));
        assertEq(("id": 2, "seq": 2, "seq_currval": 2), table.selectRow(sh));
        assertEq(("id": 2, "seq": 3, "seq_currval": 3), table.selectRow(sh));

        assertEq(1, table.update(("id": uop_seq("pgsql_test_seq")), ("id": 2)));
        sh."where".id = 4;
        assertEq(("id": 4, "seq": 5, "seq_currval": 5), table.selectRow(sh));
    }

    testDefaultValue() {
        if (!table)
            testSkip("no DB connection");

        AbstractColumn c = table.describe().dvtest_f;
        AbstractColumn new_col = c.copy();
        new_col.def_val =~ s/::.*//;
        assertRegex("::character varying", c.def_val);
        assertNRegex("::character varying", new_col.def_val);
        list l = c.getModifySql(table, new_col);
        assertEq((), l);
    }

    private test2963() {
        AbstractDatasource ds = getDatasource();
        on_exit ds.rollback();

        Bug2963Schema schema(ds);
        # to create test schema without triggers
        auto res = schema.align(False, m_options.verbose, m_options.verbose > 0);

        # create trigger outseide the schema
        ds.execRaw("create function pgsql_test_2963_func() returns trigger\n"
                   "language plpgsql as $function$\n"
                   "begin\n"
                   "   null;\n"
                   "end;\n"
                   "$function$");
        ds.execRaw("create trigger pgsql_test_2963_func "
                   "before insert on pgsql_test_2963 execute procedure pgsql_test_2963_func()");

        # align the schema again to drop trigger (and function)
        res = schema.align(False, m_options.verbose, m_options.verbose > 0);
        # 1 = drop trigger
        # 2 = drop function
        assertEq(2, res, "2 actions must be performed");
    }

    private concurrentTriggerIntrospectionTest() {
        if (!table) {
            testSkip("no DB connection");
        }

        const int Workers = 32;
        const int Iterations = 200;
        const string TableName = "pgsql_trigger_concurrency";
        const string FunctionName = "pgsql_trigger_concurrency_func";

        AbstractDatasource ds = getDatasource();
        on_exit {
            ds.rollback();
            on_error ds.rollback();
            ds.execRaw("drop table if exists " + TableName);
            ds.execRaw("drop function if exists " + FunctionName + "()");
            ds.commit();
        }

        ds.execRaw("drop table if exists " + TableName);
        ds.execRaw("drop function if exists " + FunctionName + "()");
        ds.execRaw("create table " + TableName + " (id int)");
        ds.execRaw("create function " + FunctionName + "() returns trigger language plpgsql as "
            "$function$ begin return new; end; $function$");
        ds.execRaw("create trigger " + FunctionName + " before insert or update on " + TableName
            + " for each row execute function " + FunctionName + "()");
        ds.commit();

        string connstr = m_options.connstr;
        Counter ready(Workers);
        Counter gate(1);
        Counter done(Workers);
        Queue errors();
        for (int i = 0; i < Workers; ++i) {
            background sub (string worker_connstr, string table_name,
                    Counter worker_ready, Counter start_gate,
                    Counter worker_done, Queue worker_errors) {
                on_exit worker_done.dec();
                worker_ready.dec();
                start_gate.waitForZero();
                try {
                    Datasource worker_ds(worker_connstr);
                    for (int j = 0; j < Iterations; ++j) {
                        PgsqlTable trigger_table(worker_ds, table_name);
                        trigger_table.cache();
                    }
                } catch (hash<ExceptionInfo> ex) {
                    worker_errors.push(ex);
                }
            }(connstr, TableName, ready, gate, done, errors);
        }

        ready.waitForZero();
        gate.dec();
        done.waitForZero();

        list<hash<ExceptionInfo>> failures;
        while (!errors.empty()) {
            failures += errors.get();
        }
        assertEq(0, failures.size(), sprintf("concurrent trigger introspection failures: %y", failures));

        PgsqlTable trigger_table(ds, TableName);
        assertEq(1, trigger_table.getTriggers().size(), "multi-event trigger is represented once");
    }

    private temporaryTableResolutionTest() {
        if (!table) {
            testSkip("no DB connection");
        }

        AbstractDatasource ds = getDatasource();
        on_exit ds.rollback();

        string tname = ("qore_pgsql_temp_" + get_random_string()).lwr();
        ds.exec(sprintf("create temp table %s (id int, name text)", tname));

        Table unqualified(ds, tname);
        assertTrue(unqualified.checkExistence(), "unqualified temporary table exists");
        assertRegex("^pg_temp_", unqualified.getSchemaName(),
            "unqualified temporary table resolves to the active temp schema");
        assertTrue(unqualified.describe().hasKey("id"), "unqualified temporary table can be described");
        unqualified.insert({"id": 1, "name": "one"});

        Table pg_temp(ds, "pg_temp." + tname);
        assertTrue(pg_temp.checkExistence(), "pg_temp temporary table exists");
        assertEq(unqualified.getSchemaName(), pg_temp.getSchemaName(),
            "pg_temp alias resolves to the same active temp schema");
        assertTrue(pg_temp.describe().hasKey("name"), "pg_temp temporary table can be described");
        pg_temp.insert({"id": 2, "name": "two"});

        assertEq(2, ds.selectRow(sprintf("select count(*) c from %s", tname)).c,
            "temporary table inserts use the resolved table object");
    }

    #! Tests that unqualified table names are resolved with the connection's search_path
    /** PostgreSQL resolves an unqualified name against the connection's search_path, so an unqualified
        table name must not be assumed to be in the \c public schema.
    */
    #! Sequences must resolve in the schema the name resolves in, not in any schema that happens to have one
    /** A database holding one schema per tenant has the same sequence name in every schema. Matching a
        sequence on its name alone finds another schema's, which made getSequence() report a sequence that
        does not exist on this connection's search_path (and then fail reading it), and listSequences()
        report sequences that unqualified SQL here cannot reach. Aligning a schema in such a database
        failed outright once a second schema existed.
    */
    private sequenceSchemaResolutionTest() {
        if (!table) {
            testSkip("no DB connection");
        }

        AbstractDatasource ds = getDatasource();
        on_exit {
            ds.rollback();
        }

        # two schemas, each with a sequence of the SAME name: the case a schema-blind lookup gets wrong
        string mine = ("qore_pgsql_sqm_" + get_random_string()).lwr();
        string other = ("qore_pgsql_sqo_" + get_random_string()).lwr();
        string seq_name = ("qore_pgsql_seq_" + get_random_string()).lwr();
        string other_only = ("qore_pgsql_seqo_" + get_random_string()).lwr();
        ds.exec(sprintf("create schema %s", mine));
        ds.exec(sprintf("create schema %s", other));
        on_exit {
            ds.exec(sprintf("drop schema if exists %s cascade", mine));
            ds.exec(sprintf("drop schema if exists %s cascade", other));
            ds.exec("set search_path to public");
            ds.commit();
        }
        ds.exec(sprintf("create sequence %s.%s start with 1", mine, seq_name));
        ds.exec(sprintf("create sequence %s.%s start with 1", other, seq_name));
        # exists ONLY in the other schema: unreachable from our search_path
        ds.exec(sprintf("create sequence %s.%s start with 1", other, other_only));
        ds.commit();

        ds.exec(sprintf("set search_path to %s", mine));
        ds.commit();

        Database db(ds);

        # the sequence in our own schema resolves
        assertTrue(exists db.getSequence(seq_name), "a sequence in the search_path schema is found");

        # ... and the one that exists only in another schema must NOT: this is the regression. A
        # name-only match found it and then read it unqualified, which cannot resolve here
        assertNothing(db.getSequence(other_only),
            "a sequence that exists only in another schema is not reported as existing");

        # listing must be confined to the search path for the same reason
        list<string> seqs = db.listSequences();
        assertTrue(seqs.contains(seq_name), "listSequences() lists the search_path schema's sequence");
        assertFalse(seqs.contains(other_only), "listSequences() does not list another schema's sequences");

        # an explicit schema must still reach the other schema's sequence
        assertTrue(exists db.getSequence(other + "." + other_only),
            "an explicitly qualified sequence in another schema is found");
    }

    private searchPathSchemaResolutionTest() {
        if (!table) {
            testSkip("no DB connection");
        }

        AbstractDatasource ds = getDatasource();
        on_exit {
            ds.rollback();
        }

        string sname = ("qore_pgsql_sp_" + get_random_string()).lwr();
        string tname = ("qore_pgsql_spt_" + get_random_string()).lwr();
        ds.exec(sprintf("create schema %s", sname));
        on_exit {
            ds.exec(sprintf("drop schema if exists %s cascade", sname));
            ds.exec("set search_path to public");
            ds.commit();
        }
        ds.exec(sprintf("create table %s.%s (id int, name text)", sname, tname));
        ds.commit();

        # the default search_path must continue to resolve to "public"
        assertEq("public", get_pgsql_default_schema(ds), "default search_path resolves to public");

        ds.exec(sprintf("set search_path to %s", sname));
        ds.commit();

        assertEq(sname, get_pgsql_default_schema(ds), "search_path is reported as the default schema");

        Table unqualified(ds, tname);
        assertEq(sname, unqualified.getSchemaName(), "unqualified name resolves via search_path");
        assertEq(sname + "." + tname, unqualified.getSqlName(), "resolved SQL name is schema-qualified");
        assertTrue(unqualified.checkExistence(), "search_path-resolved table exists");
        assertTrue(unqualified.describe().hasKey("id"), "search_path-resolved table can be described");

        # DML through the resolved object must reach the table in the search_path schema
        unqualified.insert({"id": 1, "name": "one"});
        ds.commit();
        assertEq(1, ds.selectRow(sprintf("select count(*) c from %s.%s", sname, tname)).c,
            "insert through the resolved object writes to the search_path schema");

        # an explicit schema in the name must still win over search_path
        Table qualified(ds, "public." + table.getName());
        assertEq("public", qualified.getSchemaName(), "an explicit schema overrides search_path");

        # a foreign key whose target this connection resolves without a schema must be reported without
        # one, so that it matches an unqualified schema description instead of being dropped and re-added
        # on every alignment
        string parent_name = ("qore_pgsql_spp_" + get_random_string()).lwr();
        string child_name = ("qore_pgsql_spc_" + get_random_string()).lwr();
        string fk_name = ("fk_" + child_name).lwr();
        ds.exec(sprintf("create table %s.%s (id int primary key)", sname, parent_name));
        ds.exec(sprintf("create table %s.%s (id int, pid int, constraint %s foreign key (pid) "
            "references %s.%s (id))", sname, child_name, fk_name, sname, parent_name));
        ds.commit();

        PgsqlTable child(ds, child_name);
        AbstractForeignConstraint fk = child.getForeignConstraints().memberGate(fk_name);
        assertEq(parent_name, fk.target.table,
            "a foreign key target in the search_path schema is reported unqualified");

        # the same table reached by a qualified name on a connection whose search_path does not name its
        # schema must report the target qualified, as the caller cannot resolve it otherwise
        ds.exec("set search_path to public");
        ds.commit();
        PgsqlTable child_qualified(ds, sname + "." + child_name);
        AbstractForeignConstraint qualified_fk =
            child_qualified.getForeignConstraints().memberGate(fk_name);
        assertEq(sname + "." + parent_name, qualified_fk.target.table,
            "a foreign key target outside the connection's default schema is reported qualified");

        ds.exec(sprintf("set search_path to %s", sname));
        ds.commit();

        # a name with no schema must still resolve to a temporary table when search_path names a
        # schema other than "public"
        string temp_name = ("qore_pgsql_sptmp_" + get_random_string()).lwr();
        ds.exec(sprintf("create temp table %s (id int)", temp_name));
        Table temp_table(ds, temp_name);
        assertRegex("^pg_temp", temp_table.getSchemaName(),
            "temporary table resolves under a non-public search_path");
        assertTrue(temp_table.checkExistence(), "temporary table exists under a non-public search_path");

        # a search_path naming no existing schema must fall back to public rather than throw
        ds.exec("set search_path to qore_pgsql_nonexistent_schema");
        ds.commit();
        assertEq("public", get_pgsql_default_schema(ds),
            "an unresolvable search_path falls back to public");
    }

    #! Tests that bulk upsert UNNEST works with non-DatasourcePool AbstractDatasource subclasses
    /** When the datasource is not a Datasource or DatasourcePool, getBulkUpsertClosure() should
        fall back to using ds.vexec() instead of SQLStatement for the UNNEST path.
    */
    private proxyBulkUpsertTest() {
        if (!table) {
            testSkip("no DB connection");
        }

        AbstractDatasource real_ds = getDatasource();
        DatasourceProxy proxy(real_ds);

        # verify proxy is NOT a Datasource or DatasourcePool
        assertEq(False, proxy instanceof Datasource);
        assertEq(False, proxy instanceof DatasourcePool);
        # verify proxy reports array bind capability
        assertEq(True, (proxy.getCapabilities() & DBI_CAP_HAS_ARRAY_BIND) != 0);

        # create the table with the real datasource, then swap in the proxy for the upsert
        AbstractTable proxy_table = (new Table(real_ds, "pgsql_test")).getTable();
        proxy_table.setDatasource(proxy);

        on_error real_ds.rollback();
        on_success real_ds.commit();

        # insert seed rows via real_ds so all NOT NULL columns are satisfied
        proxy_table.setDatasource(real_ds);
        proxy_table.del({"id": op_in((500, 501, 502))});
        real_ds.commit();
        map proxy_table.insert({"id": $1, "id_": $1 + 100, "blob_f": <cafe>, "clob_f": "test"}),
            (500, 501, 502);
        real_ds.commit();

        # swap to proxy datasource for the bulk upsert test
        proxy_table.setDatasource(proxy);

        # test UpsertAuto: update existing rows with new id_ values via UNNEST through vexec()
        code upsert = proxy_table.getBulkUpsertClosure(
            {"id": 500, "id_": 900, "blob_f": <cafe>, "clob_f": "test"},
            AbstractTable::UpsertAuto);

        int result = upsert({
            "id": (500, 501, 502),
            "id_": (900, 901, 902),
            "blob_f": (<cafe>, <cafe>, <cafe>),
            "clob_f": ("test", "test", "test"),
        });
        assertEq(AbstractTable::UR_Verified, result);
        proxy.commit();

        # verify the upsert updated the rows through the proxy
        proxy_table.setDatasource(real_ds);
        assertEq(900, proxy_table.selectRow({"where": {"id": 500}}).id_);
        assertEq(901, proxy_table.selectRow({"where": {"id": 501}}).id_);
        assertEq(902, proxy_table.selectRow({"where": {"id": 502}}).id_);

        # clean up
        proxy_table.del({"id": op_in((500, 501, 502))});

        # negative test: prove that SQLStatement cannot be used with a proxy datasource;
        # this is the runtime failure that the vexec() fallback above is designed to prevent.
        # we pass the proxy typed as AbstractDatasource (as in real Qorus usage) so the
        # parse-time type checker accepts it; at runtime, overload resolution rejects the
        # proxy because it is not a Datasource or DatasourcePool
        AbstractDatasource ads = proxy;
        assertThrows("RUNTIME-OVERLOAD-ERROR", sub () { new SQLStatement(ads); });
    }

    private pgvectorExtensionAlignmentSqlTest() {
        if (!table) {
            testSkip("no DB connection");
        }

        AbstractDatasource ds = getDatasource();
        on_exit ds.rollback();

        *hash<auto> ext_row = ds.selectRow("select 1 from pg_extension where extname = %v", "vector");
        hash<auto> schema_hash = {
            "tables": {
                "pgsql_vector_extension_probe": {
                    "columns": {
                        "id": {"qore_type": Type::Int, "notnull": True},
                        "embedding": {"driver": {"pgsql": {"native_type": "vector", "size": 3}}},
                    },
                    "primary_key": {"name": "pk_pgsql_vector_extension_probe", "columns": ("id",)},
                },
            },
        };

        AbstractDatabase db = (new Database(ds)).getDatabase();
        Tables tc();
        list<string> sql = db.getAlignSql(schema_hash, ("force": True), tc);
        string joined = sql.join("\n").lwr();

        bool has_ext_sql = joined.find("create extension if not exists vector") >= 0;
        assertEq(ext_row ? False : True, has_ext_sql,
            "pgvector extension DDL emitted only when extension is missing");

        if (has_ext_sql) {
            int ext_pos = joined.find("create extension if not exists vector");
            int table_pos = joined.find("create table");
            assertTrue(table_pos < 0 || ext_pos < table_pos,
                "pgvector extension DDL precedes table DDL");
        }
    }

    private pgvectorTest() {
        if (!table) {
            testSkip("no DB connection");
        }

        AbstractDatasource ds = getDatasource();
        on_exit ds.rollback();

        # check if pgvector extension is available
        *hash<auto> ext_row = ds.selectRow("select * from pg_extension where extname = %v", "vector");
        if (!ext_row) {
            testSkip("pgvector extension not installed");
        }

        # test Schema helper functions produce correct column hashes
        hash<GenericColumnInfo> vec_col = c_vector(3, True, "test vector column");
        assertEq("vector", vec_col.driver.pgsql.native_type, "c_vector native_type");
        assertEq(3, vec_col.driver.pgsql.size, "c_vector size");
        assertEq(True, vec_col.notnull, "c_vector notnull");
        assertEq("test vector column", vec_col.comment, "c_vector comment");

        hash<GenericColumnInfo> hv_col = c_halfvec(5);
        assertEq("halfvec", hv_col.driver.pgsql.native_type, "c_halfvec native_type");
        assertEq(5, hv_col.driver.pgsql.size, "c_halfvec size");

        hash<GenericColumnInfo> sv_col = c_sparsevec(10, True);
        assertEq("sparsevec", sv_col.driver.pgsql.native_type, "c_sparsevec native_type");
        assertEq(10, sv_col.driver.pgsql.size, "c_sparsevec size");
        assertEq(True, sv_col.notnull, "c_sparsevec notnull");

        # comment-only overloads
        hash<GenericColumnInfo> vec_col2 = c_vector(3, "my comment");
        assertEq("my comment", vec_col2.comment, "c_vector comment-only overload");
        hash<GenericColumnInfo> hv_col2 = c_halfvec(5, "hv comment");
        assertEq("hv comment", hv_col2.comment, "c_halfvec comment-only overload");
        hash<GenericColumnInfo> sv_col2 = c_sparsevec(10, "sv comment");
        assertEq("sv comment", sv_col2.comment, "c_sparsevec comment-only overload");

        string tname = "pgsql_vector_test";

        # clean up if table exists from a previous failed run
        {
            PgsqlTable t(ds, tname);
            if (t.checkExistence()) {
                t.dropCommit();
            }
        }

        # test schema creation with vector columns
        PgsqlTestVectorSchema vec_schema(ds);
        hash<SchemaAlignmentInfo> info = vec_schema.alignWithInfo(False, m_options.verbose,
            m_options.verbose > 0);
        assertTrue(info.created, "vector schema created");

        # get table and describe it
        PgsqlTable vec_table(ds, tname);
        assertTrue(vec_table.checkExistence(), "vector table exists");

        Columns cols = vec_table.describe();

        # verify vector column was correctly described
        assertTrue(cols.hasKey("vec_f"), "vector column exists");
        assertEq("vector", cols.vec_f.native_type, "vector native_type from describe");
        assertEq(3, cols.vec_f.size, "vector dimension from describe");
        assertEq(False, cols.vec_f.nullable, "vector not null from describe");

        # verify halfvec column
        assertTrue(cols.hasKey("halfvec_f"), "halfvec column exists");
        assertEq("halfvec", cols.halfvec_f.native_type, "halfvec native_type from describe");
        assertEq(5, cols.halfvec_f.size, "halfvec dimension from describe");
        assertEq(True, cols.halfvec_f.nullable, "halfvec nullable from describe");

        # verify sparsevec column
        assertTrue(cols.hasKey("sparsevec_f"), "sparsevec column exists");
        assertEq("sparsevec", cols.sparsevec_f.native_type, "sparsevec native_type from describe");
        assertEq(10, cols.sparsevec_f.size, "sparsevec dimension from describe");

        # test getNativeTypeString() produces correct DDL
        assertEq("vector(3)", cols.vec_f.getNativeTypeString(), "vector getNativeTypeString");
        assertEq("halfvec(5)", cols.halfvec_f.getNativeTypeString(), "halfvec getNativeTypeString");
        assertEq("sparsevec(10)", cols.sparsevec_f.getNativeTypeString(), "sparsevec getNativeTypeString");

        # test schema re-alignment (should report no real changes)
        hash<SchemaAlignmentInfo> info2 = vec_schema.alignWithInfo(False, m_options.verbose,
            m_options.verbose > 0);
        assertFalse(info2.created, "vector schema re-align not created");
        # all entries should be "unchanged"
        assertEq(info2.num_changes, info2.change_map.unchanged ?? 0,
            "vector schema re-align only unchanged");

        # test SchemaReverse for vector columns
        TableReverse rev(ds, tname);
        hash<auto> rev_hash = rev.toQore();
        assertEq("vector", rev_hash.columns.vec_f.driver.pgsql.native_type,
            "reverse vector native_type");
        assertEq(3, rev_hash.columns.vec_f.driver.pgsql.size, "reverse vector size");
        assertEq(True, rev_hash.columns.vec_f.driver.pgsql.notnull, "reverse vector notnull");

        assertEq("halfvec", rev_hash.columns.halfvec_f.driver.pgsql.native_type,
            "reverse halfvec native_type");
        assertEq(5, rev_hash.columns.halfvec_f.driver.pgsql.size, "reverse halfvec size");
        assertEq(False, rev_hash.columns.halfvec_f.driver.pgsql.notnull, "reverse halfvec notnull");

        assertEq("sparsevec", rev_hash.columns.sparsevec_f.driver.pgsql.native_type,
            "reverse sparsevec native_type");
        assertEq(10, rev_hash.columns.sparsevec_f.driver.pgsql.size, "reverse sparsevec size");

        # test vector column without dimension constraint (SZ_OPT allows this)
        {
            on_error ds.rollback();
            on_success ds.commit();
            ds.execRaw("create table pgsql_vector_nodim_test (id serial primary key, "
                "vec_f vector)");
        }
        {
            PgsqlTable nodim_table(ds, "pgsql_vector_nodim_test");
            Columns nodim_cols = nodim_table.describe();
            assertEq("vector", nodim_cols.vec_f.native_type,
                "dimensionless vector native_type");
            assertEq(0, nodim_cols.vec_f.size, "dimensionless vector size is 0");
            assertEq("vector", nodim_cols.vec_f.getNativeTypeString(),
                "dimensionless vector getNativeTypeString no parens");
            on_error ds.rollback();
            on_success ds.commit();
            nodim_table.drop();
        }

        # test unknown USER-DEFINED type falls through gracefully
        {
            on_error ds.rollback();
            on_success ds.commit();
            ds.execRaw("do $$ begin "
                "if not exists (select 1 from pg_type where typname = 'test_status_enum') then "
                "create type test_status_enum as enum ('active', 'inactive'); "
                "end if; end $$");
            ds.execRaw("create table pgsql_udt_test (id serial primary key, "
                "status test_status_enum)");
        }
        {
            PgsqlTable udt_table(ds, "pgsql_udt_test");
            Columns udt_cols = udt_table.describe();
            # unknown USER-DEFINED type should not crash; column is still described
            assertTrue(udt_cols.hasKey("status"), "unknown USER-DEFINED column exists");
            # the type falls through as USER-DEFINED since it's not in PgsqlTypeMap
            assertEq("USER-DEFINED", udt_cols.status.native_type,
                "unknown USER-DEFINED native_type preserved");
            on_error ds.rollback();
            on_success ds.commit();
            udt_table.drop();
            ds.execRaw("drop type test_status_enum");
        }

        # clean up
        vec_table.dropCommit();
    }

    #! Unit test for parsePgIndexDef — no DB required
    private pgIndexDefParserTest() {
        # simple btree with no extras
        hash<auto> r = PgsqlTable::parsePgIndexDef(
            "CREATE INDEX sk_users_name ON public.users USING btree (name)");
        assertEq(NOTHING, r.with_options, "simple btree: no with");
        assertEq(NOTHING, r.opclass, "simple btree: no opclass");

        # unique btree with per-column opclass
        r = PgsqlTable::parsePgIndexDef(
            "CREATE UNIQUE INDEX uk_users_email ON public.users USING btree "
            "(email varchar_pattern_ops)");
        assertEq(NOTHING, r.with_options, "varchar_pattern_ops: no with");
        assertEq("varchar_pattern_ops", r.opclass.email, "varchar_pattern_ops: opclass");

        # ivfflat with WITH clause and opclass (integer coerced back to int)
        r = PgsqlTable::parsePgIndexDef(
            "CREATE INDEX sk_ai_chunks_embedding ON public.ai_chunks USING ivfflat "
            "(embedding vector_cosine_ops) WITH (lists='100')");
        assertEq("vector_cosine_ops", r.opclass.embedding, "ivfflat: opclass");
        assertEq(100, r.with_options.lists, "ivfflat: lists coerced to int");

        # hnsw with multiple WITH options
        r = PgsqlTable::parsePgIndexDef(
            "CREATE INDEX sk_ai_chunks_embedding ON public.ai_chunks USING hnsw "
            "(embedding vector_l2_ops) WITH (m='16', ef_construction='64')");
        assertEq("vector_l2_ops", r.opclass.embedding, "hnsw: opclass");
        assertEq(16, r.with_options.m, "hnsw: m");
        assertEq(64, r.with_options.ef_construction, "hnsw: ef_construction");

        # multi-column, mixed default/non-default opclasses — default is not reported by PG so we
        # should only see the non-default ones
        r = PgsqlTable::parsePgIndexDef(
            "CREATE INDEX sk_mixed ON public.t USING btree (a, b varchar_pattern_ops)");
        assertEq(NOTHING, r.opclass.a, "multi-col: default opclass not reported");
        assertEq("varchar_pattern_ops", r.opclass.b, "multi-col: non-default opclass reported");
    }

    #! End-to-end ivfflat index test — requires pgvector installed
    private pgvectorIvfflatIndexTest() {
        if (!table) {
            testSkip("no DB connection");
        }

        AbstractDatasource ds = getDatasource();
        on_exit ds.rollback();

        *hash<auto> ext_row = ds.selectRow("select * from pg_extension where extname = %v", "vector");
        if (!ext_row) {
            testSkip("pgvector extension not installed");
        }

        # build a table description with a vector column and an ivfflat index
        hash<auto> tdesc = {
            "columns": {
                "id": {"qore_type": Type::Int, "notnull": True},
                "embedding": {"driver": {"pgsql": {"native_type": "vector", "size": 3}}},
            },
            "primary_key": {"name": "pk_ivfflat_test", "columns": ("id",)},
            "indexes": {
                "sk_ivfflat_test_emb": {
                    "columns": ("embedding",),
                    "method": "ivfflat",
                    "with": {"lists": 100},
                    "opclass": {"embedding": "vector_cosine_ops"},
                },
            },
        };

        string tname = "pgsql_ivfflat_test";

        # clean up a leftover from a previous failed run
        {
            PgsqlTable t0(ds, tname);
            if (t0.checkExistence()) {
                t0.dropCommit();
            }
        }

        # create + populate the table via setupTable
        PgsqlTable t(ds, tname);
        t.setupTable(tdesc);
        t.create();
        ds.commit();
        on_exit {
            ds.rollback();
            PgsqlTable tc(ds, tname);
            if (tc.checkExistence()) {
                tc.dropCommit();
            }
        }

        # verify the index exists with the right access method
        *string amname = ds.selectRow(
            "select am.amname from pg_class i, pg_am am "
            "where i.relkind = 'i' and i.relname = %v and i.relam = am.oid",
            "sk_ivfflat_test_emb").amname;
        assertEq("ivfflat", amname, "ivfflat access method recorded in catalog");

        # verify the reconstructed DDL captures the WITH clause and opclass
        *string indexdef = ds.selectRow(
            "select pg_get_indexdef(i.oid, 0, false) indexdef from pg_class i "
            "where i.relkind = 'i' and i.relname = %v", "sk_ivfflat_test_emb").indexdef;
        assertTrue(indexdef.lwr().find("ivfflat") >= 0, "DDL contains ivfflat");
        assertTrue(indexdef.lwr().find("vector_cosine_ops") >= 0, "DDL contains opclass");
        assertTrue(indexdef.lwr().find("lists") >= 0, "DDL contains WITH lists");

        # re-describe the table and verify round-trip through PgsqlIndex.equalImpl: the loaded
        # definition must compare equal to a fresh one built from the same hash so that a second
        # alignment reports no drift
        PgsqlTable t2(ds, tname);
        Indexes live_ix = t2.getIndexes();
        assertTrue(live_ix.hasKey("sk_ivfflat_test_emb"), "ivfflat index present in describe");
        PgsqlIndex live = cast<PgsqlIndex>(live_ix.sk_ivfflat_test_emb);
        assertEq("ivfflat", live.method, "reverse-engineered method");
        assertEq(100, live.with_options.lists, "reverse-engineered WITH lists");
        assertEq("vector_cosine_ops", live.opclass.embedding, "reverse-engineered opclass");

        # construct an expected PgsqlIndex with the same column reference, and verify they compare equal
        Columns emb_cols = t2.describe();
        hash<auto> ch = {"embedding": emb_cols.embedding};
        PgsqlIndex expected("sk_ivfflat_test_emb", False, ch,
            NOTHING, "ivfflat", {"lists": 100}, {"embedding": "vector_cosine_ops"});
        assertTrue(live.equal(expected), "live ivfflat index equals expected definition");
    }

    #! Integration test for the populate column feature
    /** Creates a table with data, then adds a NOT NULL column with populate, and verifies
        the 3-step dance: add-nullable → backfill → SET NOT NULL.
    */
    private populateColumnTest() {
        if (!table) {
            testSkip("no DB connection");
        }

        AbstractDatasource ds = getDatasource();
        on_exit ds.rollback();

        string tname = "pgsql_populate_test";

        # clean up leftover from a previous failed run
        {
            PgsqlTable t0(ds, tname);
            if (t0.checkExistence()) {
                t0.dropCommit();
            }
        }

        # Phase 1: create a table with initial data (no populate columns yet)
        string schema_v1 = make_yaml({
            "schema": {"name": "PopulateTest", "version": "1.0"},
            "tables": {
                (tname): {
                    "columns": {
                        "id": {"type": "int", "notnull": True},
                        "name": {"type": "varchar", "size": 100, "notnull": True},
                    },
                    "primary_key": {"name": "pk_populate_test", "columns": ("id",)},
                },
            },
        });

        {
            Schema::DataSchema s1(ds, Schema::DataSchemaLoader::loadHash(parse_yaml(schema_v1)));
            s1.align(True, m_options.verbose);
        }

        # insert some test data
        {
            on_error ds.rollback();
            on_success ds.commit();
            AbstractTable at = (new Table(ds, tname)).getTable();
            at.insert({"id": 1, "name": "alice"});
            at.insert({"id": 2, "name": "bob"});
        }

        # Phase 2: add a NOT NULL column with populate:{field: name}
        string schema_v2 = make_yaml({
            "schema": {"name": "PopulateTest", "version": "1.1"},
            "tables": {
                (tname): {
                    "columns": {
                        "id": {"type": "int", "notnull": True},
                        "name": {"type": "varchar", "size": 100, "notnull": True},
                        "display_name": {
                            "type": "varchar", "size": 240, "notnull": True,
                            "populate": {"field": "name"},
                        },
                    },
                    "primary_key": {"name": "pk_populate_test", "columns": ("id",)},
                },
            },
        });

        {
            Schema::DataSchema s2(ds, Schema::DataSchemaLoader::loadHash(parse_yaml(schema_v2)));
            s2.align(True, m_options.verbose);
        }

        # verify the column exists and is NOT NULL
        {
            AbstractTable at = (new Table(ds, tname)).getTable();
            Columns cols = at.describe();
            assertTrue(cols.hasKey("display_name"), "populate column exists");
            assertFalse(cols.display_name.nullable, "populate column is NOT NULL");
        }

        # verify the data was backfilled
        {
            *list<auto> rows = ds.selectRows("select id, display_name from " + tname
                + " order by id");
            assertEq(2, rows.size(), "two rows present");
            assertEq("alice", rows[0].display_name, "row 1 backfilled from name");
            assertEq("bob", rows[1].display_name, "row 2 backfilled from name");
        }

        # Phase 3: re-align — should be a no-op
        {
            Schema::DataSchema s3(ds, Schema::DataSchemaLoader::loadHash(parse_yaml(schema_v2)));
            hash<SchemaAlignmentInfo> info = s3.alignWithInfo(False, m_options.verbose,
                m_options.verbose > 0);
            assertFalse(info.created, "re-align not created");
        }

        # clean up
        {
            on_error ds.rollback();
            on_success ds.commit();
            AbstractTable tc = (new Table(ds, tname)).getTable();
            if (tc.checkExistence()) {
                tc.drop();
            }
        }
    }

    # Verifies that Tables::populate() applies the template to a parent table
    # even when a referring child appears *before* the parent in the input hash.
    # Before the topological-sort fix, a child-first iteration caused the parent
    # to be pre-cached from the live DB during FK resolution, then silently
    # skipped on its own turn — producing a DB-shaped cache entry for the parent.
    tablesPopulateFkOrderingTest() {
        if (!table) {
            testSkip("no DB connection");
        }

        AbstractDatasource ds = getDatasource();
        on_exit ds.rollback();

        string parent_name = "pgsql_fk_order_parent";
        string child_name  = "pgsql_fk_order_child";

        # clean slate
        code<nothing(string)> drop_if_exists = sub (string n) {
            PgsqlTable t(ds, n);
            if (t.checkExistence()) {
                t.dropCommit();
            }
        };
        drop_if_exists(child_name);
        drop_if_exists(parent_name);

        # DB state: OLD schema with an extra column the new template doesn't have
        ds.execRaw(sprintf("create table %s (id numeric(14) primary key, legacy varchar(80))",
            parent_name));
        ds.execRaw(sprintf(
            "create table %s (id numeric(14) primary key, parent_id numeric(14), "
            "constraint fk_%s_parent foreign key (parent_id) references %s(id))",
            child_name, child_name, parent_name));
        ds.commit();

        on_exit {
            drop_if_exists(child_name);
            drop_if_exists(parent_name);
        }

        # template: new schema drops "legacy", adds "display"
        hash<auto> t_parent = {
            "columns": {
                "id":      {"qore_type": SqlUtil::NUMERIC, "size": 14, "notnull": True},
                "display": {"qore_type": SqlUtil::VARCHAR, "size": 120},
            },
            "primary_key": {"name": "pk_" + parent_name, "columns": "id"},
        };
        hash<auto> t_child = {
            "columns": {
                "id":        {"qore_type": SqlUtil::NUMERIC, "size": 14, "notnull": True},
                "parent_id": {"qore_type": SqlUtil::NUMERIC, "size": 14},
            },
            "primary_key": {"name": "pk_" + child_name, "columns": "id"},
            "foreign_constraints": {
                ("fk_" + child_name + "_parent"): {
                    "columns": "parent_id", "table": parent_name, "target_columns": "id",
                },
            },
        };

        list expected_parent_cols = ("display", "id");

        # child-before-parent input order (the failure case pre-fix)
        {
            Tables tc();
            tc.populate(ds, {(child_name): t_child, (parent_name): t_parent});
            assertEq(expected_parent_cols, sort(tc{parent_name}.describe().keys()),
                "parent cached from template with child-first ordering");
        }

        # parent-before-child input order (always worked)
        {
            Tables tc();
            tc.populate(ds, {(parent_name): t_parent, (child_name): t_child});
            assertEq(expected_parent_cols, sort(tc{parent_name}.describe().keys()),
                "parent cached from template with parent-first ordering");
        }

        # end-to-end: AbstractDatabase::getAlignSql() with a child-first template
        # hash must emit DROP for the parent's legacy column and ADD for the new one.
        # Pre-fix, the parent's cache entry was DB-shaped, so column alignment
        # reported AC_Unchanged for every parent column and emitted no DDL.
        {
            AbstractDatabase db = (new Database(ds)).getDatabase();
            hash<auto> schema_hash = {
                "tables": {
                    (child_name):  t_child,
                    (parent_name): t_parent,
                },
            };
            Tables tc();
            list<string> sql = db.getAlignSql(schema_hash, ("force": True), tc);
            string joined = sql.join("\n");
            assertTrue(joined =~ /legacy/i, "alignment SQL drops legacy column on parent");
            assertTrue(joined =~ /display/i, "alignment SQL adds display column on parent");
        }
    }

    foreignKeyColumnOrderIntrospectionTest() {
        if (!table) {
            testSkip("no DB connection");
        }

        AbstractDatasource ds = getDatasource();
        on_exit ds.rollback();

        string parent_name = "pgsql_fk_column_order_parent";
        string child_name = "pgsql_fk_column_order_child";
        string fk_name = "fk_" + child_name + "_parent";

        code drop_if_exists = sub (string n) {
            PgsqlTable t(ds, n);
            if (t.checkExistence()) {
                t.dropCommit();
            }
        };

        drop_if_exists(child_name);
        drop_if_exists(parent_name);
        on_exit {
            drop_if_exists(child_name);
            drop_if_exists(parent_name);
        }

        hash<auto> parent_desc = {
            "columns": {
                "file_name": c_varchar(80, True),
                "releaseid": c_number(14, True),
            },
            "primary_key": {"name": "pk_" + parent_name, "columns": ("releaseid", "file_name")},
        };
        hash<auto> child_desc = {
            "columns": {
                "file_name": c_varchar(80, True),
                "releaseid": c_number(14, True),
                "payload": c_varchar(80),
            },
            "foreign_constraints": {
                (fk_name): {
                    "columns": ("releaseid", "file_name"),
                    "table": parent_name,
                    "target_columns": ("releaseid", "file_name"),
                },
            },
        };

        PgsqlTable parent_t(ds, parent_name);
        parent_t.setupTable(parent_desc);
        parent_t.createCommit();

        PgsqlTable child_t(ds, child_name);
        child_t.setupTable(child_desc);
        child_t.createCommit();

        PgsqlTable live_child(ds, child_name);
        ForeignConstraints fks = live_child.getForeignConstraints();
        AbstractForeignConstraint fk = fks.memberGate(fk_name);
        assertEq(("releaseid", "file_name"), fk.keys(), "source FK order follows declaration order");
        assertEq(("releaseid", "file_name"), fk.target.columns.keys(),
            "target FK order follows declaration order");

        AbstractDatabase db = (new Database(ds)).getDatabase();
        Tables tc();
        list<string> sql = db.getAlignSql({
            "tables": {
                (parent_name): parent_desc,
                (child_name): child_desc,
            },
        }, ("force": True), tc);
        string joined = sql.join("\n");
        assertFalse(joined =~ /fk_pgsql_fk_column_order_child_parent/, joined);
    }

    partitionSchemaCoercionAndValidationTest() {
        if (!table) {
            testSkip("no DB connection");
        }

        AbstractDatasource ds = getDatasource();
        hash<auto> loaded = Schema::DataSchemaLoader::normalizeTable("pgsql_partition_coercion", {
            "columns": {
                "id": {"type": "int", "notnull": True},
                "event_ts": {"type": "int", "notnull": True,
                    "driver": {"pgsql": {"native_type": "date"}}},
            },
            "primary_key": {"name": "pk_pgsql_partition_coercion", "columns": ("id", "event_ts")},
            "partition_strategy": {"method": "range", "columns": ("id",),
                "driver": {"pgsql": {"columns": ("event_ts",)}}},
            "partitions": {
                "p1": {"bound_from": "2026-01-01", "bound_to": "2026-01-02T12:34:56.123456Z"},
            },
        });
        assertEq(Type::String, loaded.partitions.p1.bound_from.type(),
            "data schema loader leaves coercion until driver setup");

        PgsqlTable coerced(ds, "pgsql_partition_coercion");
        coerced.setupTable(loaded);
        assertEq(("event_ts",), coerced.getPartitionStrategy().columns,
            "driver override selects the effective partition key");
        hash<string, PartitionInfo> parts = coerced.listPartitions();
        assertEq(Type::Date, parts.p1.bound_from.type(), "generic date shorthand is coerced after driver overrides");
        assertEq(Type::Date, parts.p1.bound_to.type(), "ISO datetime is coerced");
        assertEq("2026-01-01 00:00:00.000000", parts.p1.bound_from.format("YYYY-MM-DD HH:mm:SS.us"));
        assertEq("2026-01-02 12:34:56.123456", parts.p1.bound_to.format("YYYY-MM-DD HH:mm:SS.us"));

        PgsqlTable composite(ds, "pgsql_partition_composite_coercion");
        composite.setupTable({
            "columns": {
                "id": {"qore_type": Type::Int, "notnull": True},
                "event_ts": {"native_type": "timestamp", "notnull": True},
            },
            "primary_key": {"name": "pk_pgsql_partition_composite_coercion",
                "columns": ("id", "event_ts")},
            "partition_strategy": {"method": "range", "columns": ("id", "event_ts")},
            "partitions": {
                "p1": {"bound_from": (1, "2026-02-01 01:02:03"),
                    "bound_to": (2, "2026-02-02T01:02:03+01:00")},
            },
        });
        parts = composite.listPartitions();
        assertEq(1, parts.p1.bound_from[0], "non-date composite element remains unchanged");
        assertEq(Type::Date, parts.p1.bound_from[1].type(),
            "driver-native timestamp metadata coerces its composite element");
        assertEq(Type::Date, parts.p1.bound_to[1].type());

        PgsqlTable strings(ds, "pgsql_partition_string_bounds");
        strings.setupTable({
            "columns": {"event_ts": {"native_type": "date", "notnull": True}},
            "primary_key": {"name": "pk_pgsql_partition_string_bounds", "columns": "event_ts"},
            "partition_strategy": {"method": "range", "columns": "event_ts"},
            "partitions": {"p1": {"bound_from": "alpha", "bound_to": "omega"}},
        });
        parts = strings.listPartitions();
        assertEq("alpha", parts.p1.bound_from, "non-ISO string lower bound remains a string");
        assertEq("omega", parts.p1.bound_to, "non-ISO string upper bound remains a string");

        PgsqlTable native_sql(ds, "pgsql_partition_native_sql_bounds");
        native_sql.setupTable({
            "columns": {"event_ts": {"native_type": "date", "notnull": True}},
            "primary_key": {"name": "pk_pgsql_partition_native_sql_bounds", "columns": "event_ts"},
            "partition_strategy": {"method": "range", "columns": "event_ts"},
            "partitions": {"p1": {"bound_from_sql": "date '2026-03-01'",
                "bound_to_sql": "date '2026-04-01'"}},
        });
        parts = native_sql.listPartitions();
        assertEq("date '2026-03-01'", parts.p1.bound_from_sql, "native lower SQL is never coerced");
        assertEq("date '2026-04-01'", parts.p1.bound_to_sql, "native upper SQL is never coerced");

        assertThrows("DESCRIPTION-ERROR", "not a valid ISO date", sub () {
            PgsqlTable malformed(ds, "pgsql_partition_malformed_date");
            malformed.setupTable({
                "columns": {"event_ts": {"native_type": "date", "notnull": True}},
                "primary_key": {"name": "pk_pgsql_partition_malformed_date", "columns": "event_ts"},
                "partition_strategy": {"method": "range", "columns": "event_ts"},
                "partitions": {"p1": {"bound_from": "2026-02-30", "bound_to": "2026-03-01"}},
            });
        });

        assertThrows("DESCRIPTION-ERROR", "must be a list", sub () {
            PgsqlTable bad_scalar(ds, "pgsql_partition_bad_scalar");
            bad_scalar.setupTable({
                "columns": {"id": {"qore_type": Type::Int}, "event_ts": {"native_type": "date"}},
                "primary_key": {"name": "pk_pgsql_partition_bad_scalar", "columns": ("id", "event_ts")},
                "partition_strategy": {"method": "range", "columns": ("id", "event_ts")},
                "partitions": {"p1": {"bound_from": 1, "bound_to": 2}},
            });
        });
        assertThrows("DESCRIPTION-ERROR", "has 1 value", sub () {
            PgsqlTable bad_list(ds, "pgsql_partition_bad_list");
            bad_list.setupTable({
                "columns": {"id": {"qore_type": Type::Int}, "event_ts": {"native_type": "date"}},
                "primary_key": {"name": "pk_pgsql_partition_bad_list", "columns": ("id", "event_ts")},
                "partition_strategy": {"method": "range", "columns": ("id", "event_ts")},
                "partitions": {"p1": {"bound_from": (1,), "bound_to": (2,)}},
            });
        });

        hash<auto> unique_base = {
            "columns": {"id": {"qore_type": Type::Int, "notnull": True},
                "event_ts": {"native_type": "date", "notnull": True}},
            "partition_strategy": {"method": "range", "columns": "event_ts"},
        };
        assertThrows("DESCRIPTION-ERROR", "primary key", sub () {
            PgsqlTable bad_pk(ds, "pgsql_partition_bad_pk");
            bad_pk.setupTable(unique_base + {
                "primary_key": {"name": "pk_pgsql_partition_bad_pk", "columns": "id"},
            });
        });
        assertThrows("DESCRIPTION-ERROR", "unique index", sub () {
            PgsqlTable bad_ix(ds, "pgsql_partition_bad_ix");
            bad_ix.setupTable(unique_base + {
                "indexes": {"uk_pgsql_partition_bad_ix": {"columns": "id", "unique": True}},
            });
        });
        assertThrows("DESCRIPTION-ERROR", "unique constraint", sub () {
            PgsqlTable bad_uk(ds, "pgsql_partition_bad_uk");
            bad_uk.setupTable(unique_base + {
                "unique_constraints": {"uk_pgsql_partition_bad_uk": {"columns": "id"}},
            });
        });
    }

    rangePartitionLifecycleTest() {
        if (!table) {
            testSkip("no DB connection");
        }

        AbstractDatasource ds = schema.getDatasource();
        on_exit ds.rollback();

        string parent = "pgsql_partition_test";
        string p1 = parent + "_p1";
        string p2 = parent + "_p2";
        string p3 = parent + "_p3";

        code drop_if_exists = sub (string n) {
            PgsqlTable t(ds, n);
            if (t.checkExistence()) {
                t.dropCommit();
            }
        };

        drop_if_exists(p3);
        drop_if_exists(parent);
        on_exit {
            drop_if_exists(p3);
            drop_if_exists(parent);
        }

        hash<auto> desc = {
            "columns": {
                "id": {"qore_type": Type::Int, "notnull": True},
                "name": {"qore_type": SqlUtil::VARCHAR, "size": 80},
            },
            "primary_key": {"name": "pk_" + parent, "columns": ("id",), "partition_aligned": True},
            "indexes": {
                (parent + "_name_idx"): {"columns": ("name",), "partition_aligned": True},
            },
            "partition_strategy": {"method": "range", "columns": ("name",),
                "driver": {"pgsql": {"columns": ("id",)}}},
            "partitions": {
                (p1): {"bound_from": -10, "bound_to": -1,
                    "driver": {"pgsql": {"bound_from": 0, "bound_to": 10}}},
                (p2): {"bound_from": 10, "bound_to": 999,
                    "driver": {"pgsql": {"bound_to": 20}}},
            },
        };

        assertThrows("INDEX-OPTION-ERROR", "requires a partitioned table", sub () {
            PgsqlTable nonpartitioned(ds, "pgsql_partition_aligned_invalid");
            nonpartitioned.setupTable({
                "columns": {"id": {"qore_type": Type::Int}},
                "indexes": {"bad_ix": {"columns": "id", "partition_aligned": True}},
            });
        });

        PgsqlTable direct_aligned(ds, "pgsql_partition_aligned_direct");
        direct_aligned.setupTable({
            "columns": desc.columns,
            "partition_strategy": {"method": "range", "columns": "id"},
        });
        assertTrue(direct_aligned.getAddPrimaryKeySql("pgsql_partition_aligned_direct_pk", "id",
            {"partition_aligned": True}) =~ /primary key \(id\)/i,
            "direct primary-key SQL accepts portable partition alignment");
        string aligned_uk_sql = direct_aligned.getAddUniqueConstraintSql("pgsql_partition_aligned_direct_uk",
            ("name", "id"), {"partition_aligned": True});
        assertTrue(aligned_uk_sql =~ /add constraint .* unique/i,
            "direct unique-constraint SQL accepts portable partition alignment: " + aligned_uk_sql);

        PgsqlTable tmpl(ds, parent);
        tmpl.setupTable(desc);
        string create_sql = tmpl.getCreateSqlString();
        assertTrue(create_sql =~ /partition by range \(id\)/i, "parent DDL contains partition strategy");
        assertTrue(create_sql =~ /partition of public\.pgsql_partition_test/i, "child DDL references parent");
        tmpl.createCommit();

        PgsqlTable t(ds, parent);
        assertTrue(t.supportsPartitions(), "pgsql supports partitions");
        assertFalse(t.supportsPartitionRead(), "pgsql child-table reads are not generic partition qualification");
        assertTrue(t.supportsTargetedPartitionLookup(), "pgsql supports targeted partition catalog lookup");
        assertTrue(t.supportsPartitionDetach(), "pgsql supports partition detach");
        assertFalse(t.supportsPartitionExchange(), "pgsql does not expose non-equivalent partition exchange");
        assertEq("I", ds.selectRow("select relkind from pg_catalog.pg_class where oid = %v::regclass",
            parent + "_name_idx").relkind,
            "secondary index fixture is a PostgreSQL partitioned parent index");
        Indexes partition_indexes = t.getIndexes();
        assertTrue(partition_indexes.hasKey(parent + "_name_idx"),
            "partitioned parent index is exposed by portable index introspection");
        assertEq(("name",), partition_indexes{parent + "_name_idx"}.columns.keys(),
            "partitioned parent index columns are introspected");
        assertThrows("PARTITION-NOT-SUPPORTED", "does not support exchanging partitions", sub () {
            t.getExchangePartitionSql(parent + "_p1", t);
        });
        assertThrows("PARTITION-NOT-SUPPORTED", "does not support named partition qualification", sub () {
            t.getSelectSql({"partition": p1});
        });
        DbTableDataProvider partition_dp(t);
        assertThrows("PARTITION-NOT-SUPPORTED", "does not support named partition qualification", sub () {
            partition_dp.searchSingleRecord(NOTHING, {"partition": p1});
        });

        *hash<PartitionInfo> targeted_p1 = t.getPartition(p1);
        assertTrue(exists targeted_p1, "pgsql targeted lookup returns the named child partition");
        assertEq(-1, targeted_p1.ordinal, "pgsql marks targeted order unknown without loading the full catalog");
        assertEq(0, targeted_p1.bound_from, "pgsql targeted lookup parses the lower bound");
        assertEq(10, targeted_p1.bound_to, "pgsql targeted lookup parses the upper bound");
        assertTrue(exists targeted_p1.estimated_row_count,
            "pgsql targeted lookup exposes the catalog-estimated row count");
        assertTrue(targeted_p1.size_bytes > 0, "pgsql targeted lookup exposes allocated partition bytes");
        assertNothing(t.getPartition(parent + "_missing"),
            "pgsql targeted lookup returns nothing for a relation outside the partition set");
        hash<PartitionLookupResult> targeted_lookup = t.findPartitionBySpec({
            "name": p1,
            "bound_from": 0,
            "bound_to": 10,
        });
        assertEq(PartitionLookupStatus::Found, targeted_lookup.status,
            "pgsql verifies name-bearing comparable specs with targeted metadata");
        hash<PartitionLookupResult> fallback_lookup = t.findPartitionBySpec({
            "name": p1,
            "bound_from": 10,
            "bound_to": 20,
        });
        assertEq(PartitionLookupStatus::Found, fallback_lookup.status,
            "pgsql falls back to the complete scan when targeted name and bounds disagree");
        assertEq(p2, fallback_lookup.partition.name,
            "pgsql deterministic fallback resolves the partition matching the requested bounds");

        *hash<PartitionStrategy> strategy = t.getPartitionStrategy();
        assertTrue(exists strategy, "partition strategy introspected");
        assertEq("range", strategy.method, "partition method");
        assertEq(("id",), strategy.columns, "partition key columns");

        hash<string, PartitionInfo> partitions = t.listPartitions();
        assertEq(2, partitions.size(), "initial partition count");
        assertEq(0, partitions{p1}.ordinal, "full pgsql listing replaces the partial targeted cache");
        assertEq(p1, t.getPartition("public." + p1).name,
            "pgsql targeted lookup preserves explicitly qualified lifecycle names after a full listing");
        assertTrue(partitions.hasKey(p1), "partition p1 introspected");
        assertEq(0, partitions{p1}.bound_from, "p1 lower bound parsed");
        assertEq(10, partitions{p1}.bound_to, "p1 upper bound parsed");
        assertEq(20, partitions{p2}.bound_to, "partition driver override applied");

        hash<auto> desc_no_parts = t.getDescriptionHash();
        assertTrue(desc_no_parts.hasKey("partition_strategy"), "description includes strategy");
        assertFalse(desc_no_parts.hasKey("partitions"), "description omits partitions by default");
        hash<auto> desc_parts = t.getDescriptionHash({"with_partitions": True});
        assertTrue(desc_parts.partitions.hasKey(p1), "description includes partitions when requested");
        assertFalse(exists desc_parts.partitions{p1}.name,
            sprintf("partition key is the canonical name: %y", desc_parts.partitions{p1}));
        assertFalse(desc_parts.partitions{p1}.hasKey("ordinal"), "description excludes catalog ordinal");
        assertFalse(desc_parts.partitions{p1}.hasKey("sql_name"), "description excludes diagnostic SQL name");
        assertFalse(desc_parts.partitions{p1}.hasKey("estimated_row_count"),
            "description excludes runtime row statistics");
        assertFalse(desc_parts.partitions{p1}.hasKey("size_bytes"),
            "description excludes runtime storage statistics");
        assertFalse(desc_parts.partitions{p1}.hasKey("bound_sql"),
            "typed bounds take precedence over native SQL bounds");
        assertEq(0, desc_parts.partitions{p1}.bound_from, "description preserves typed lower bound");
        assertEq(10, desc_parts.partitions{p1}.bound_to, "description preserves typed upper bound");

        assertEq((), t.getAlignSql(tmpl), "table aligns with the schema used to create it");
        PgsqlTable reverse_template(ds, parent);
        reverse_template.setupTable(desc_parts);
        assertEq((), t.getAlignSql(reverse_template), "reverse-engineered partition schema aligns unchanged");

        hash<auto> changed_strategy_desc = {} + desc_parts;
        changed_strategy_desc.partition_strategy = {} + desc_parts.partition_strategy;
        changed_strategy_desc.partition_strategy.auto = {"policy": "different"};
        PgsqlTable changed_strategy(ds, parent);
        changed_strategy.setupTable(changed_strategy_desc);
        assertThrows("PARTITION-ERROR", "normalized desired", sub () {
            t.getAlignSql(changed_strategy);
        });

        hash<PartitionLookupResult> lookup = t.findPartitionBySpec({"bound_from": 0, "bound_to": 10});
        assertEq(PartitionLookupStatus::Found, lookup.status, "find partition by typed bounds");
        assertEq(p1, lookup.partition.name, "lookup returned p1");
        lookup = t.findPartitionBySpec({"bound_from": 30, "bound_to": 40});
        assertEq(PartitionLookupStatus::NotFound, lookup.status, "missing typed range returns NotFound");
        lookup = t.findPartitionBySpec({"bound_sql": "from (30) to (40)"});
        assertEq(PartitionLookupStatus::Uncomparable, lookup.status, "native-only range returns Uncomparable");

        hash<PartitionEnsureResult> ensure_existing = t.ensurePartition({
            "name": p1,
            "bound_from": 0,
            "bound_to": 10,
        });
        assertFalse(ensure_existing.created, "ensure existing does not create");
        assertTrue(ensure_existing.materialized, "ensure existing is materialized");
        assertTrue(ensure_existing.bounds_verified, "ensure existing verified by bounds");

        hash<PartitionEnsureResult> ensure_created = t.ensurePartition({
            "name": p3,
            "bound_from": 20,
            "bound_to": 30,
        });
        assertTrue(ensure_created.created, "ensure new creates");
        assertTrue(ensure_created.materialized, "ensure new is materialized");
        assertEq(p3, ensure_created.partition.name, "ensure returns re-introspected partition metadata");
        assertTrue(exists ensure_created.partition.sql_name, "created partition includes its actual SQL name");
        ds.commit();

        t.clear();
        partitions = t.listPartitions();
        assertTrue(partitions.hasKey(p3), "new partition introspected after cache clear");

        t.insert({"id": 21, "name": "to truncate"});
        assertEq(1, ds.selectRow("select count(*) c from " + p3).c, "row routed to p3");
        t.truncatePartition(p3);
        assertEq(0, ds.selectRow("select count(*) c from " + p3).c, "partition truncate removes rows");

        t.detachPartition(p3);
        ds.commit();
        t.clear();
        assertFalse(t.listPartitions().hasKey(p3), "detached partition removed from parent list");
        drop_if_exists(p3);

        t.dropPartition(p2);
        ds.commit();
        t.clear();
        assertFalse(t.listPartitions().hasKey(p2), "dropped partition removed from parent list");

        hash<auto> reversed = (new SchemaReverse::TableReverse(ds, parent, {"with_partitions": True})).toQore();
        assertTrue(reversed.hasKey("partition_strategy"), "SchemaReverse includes partition strategy");
        assertTrue(reversed.partitions.hasKey(p1), "SchemaReverse includes partitions with option");
        assertFalse(reversed.partitions{p1}.hasKey("ordinal"), "SchemaReverse excludes partition runtime metadata");
        hash<auto> loaded = Schema::DataSchemaLoader::loadHash({
            "schema": {"name": "PartitionRoundTrip", "version": "1.0"},
            "tables": {(parent): reversed},
        }, False);
        PgsqlTable loaded_table(ds, parent + "_loaded");
        loaded_table.setupTable(loaded.tables{parent});
        assertTrue(loaded_table.getCreateSqlString() =~ /partition by range \(id\)/i,
            "SchemaReverse output passes through DataSchemaLoader and setupTable");

        # prove that the emitted table description can recreate the physical table without manual filtering
        t.dropCommit();
        PgsqlTable recreated(ds, parent);
        recreated.setupTable(desc_parts);
        recreated.createCommit();
        hash<string, PartitionInfo> recreated_parts = recreated.listPartitions();
        assertEq(2, recreated_parts.size(), "description recreates all exported partitions");
        assertEq(0, recreated_parts{p1}.bound_from, "recreated partition has the exported lower bound");
        assertEq(20, recreated_parts{p2}.bound_to, "recreated partition has the exported upper bound");
    }

    concurrentPartitionDetachTest() {
        if (!table) {
            testSkip("no DB connection");
        }

        AbstractDatasource ds = schema.getDatasource();
        PgsqlTable capability_table(ds, "pgsql_test");
        if (!capability_table.supportsConcurrentPartitionDetach()) {
            testSkip("PostgreSQL server older than 14");
        }

        string parent = "pgsql_concurrent_detach";
        string p1 = parent + "_p1";
        string p2 = parent + "_p2";
        string pdef = parent + "_default";
        code drop_if_exists = sub (string n) {
            PgsqlTable drop_table(ds, n);
            if (drop_table.checkExistence()) {
                drop_table.dropCommit();
            }
        };
        code<nothing()> cleanup = sub () {
            drop_if_exists(p1);
            drop_if_exists(p2);
            drop_if_exists(pdef);
            drop_if_exists(parent);
        };
        cleanup();
        on_exit cleanup();

        PgsqlTable tmpl(ds, parent);
        tmpl.setupTable({
            "columns": {
                "id": {"qore_type": Type::Int, "notnull": True},
                "value": {"qore_type": SqlUtil::VARCHAR, "size": 40},
            },
            "partition_strategy": {"method": "range", "columns": "id"},
            "partitions": {
                (p1): {"bound_from": 0, "bound_to": 10},
                (p2): {"bound_from": 10, "bound_to": 20},
            },
        });
        tmpl.createCommit();

        PgsqlTable t(ds, parent);
        assertTrue(t.supportsConcurrentPartitionDetach(), "PostgreSQL 14+ supports concurrent partition detach");
        hash<string, PartitionInfo> parts = t.listPartitions();
        assertFalse(parts{p1}.driver.pgsql.detach_pending,
            "ordinary PostgreSQL partition is not pending concurrent detach");

        list<hash<auto>> events = ();
        list<string> callback_sql = ();
        code<nothing(string, int, *string, *string, *string, *string, *string)> info_cb = sub (
                string str, int ac, *string type, *string nm, *string tbl, *string nn, *string info) {
            events += {"action": ac, "type": type, "name": nm, "table": tbl, "info": info};
        };
        code<nothing(string)> sql_cb = sub (string statement) {
            callback_sql += statement;
        };
        string preview_sql = t.getDetachPartitionConcurrentlySql({"bound_from": 0, "bound_to": 10}, {
            "info_callback": info_cb,
            "sql_callback": sql_cb,
        });
        assertTrue(preview_sql =~ /detach partition .*pgsql_concurrent_detach_p1 concurrently/i,
            "concurrent detach generator emits PostgreSQL syntax for a specification");
        assertEq(1, events.size(), "concurrent detach preview emits one info callback");
        assertEq(AbstractDatabase::AC_Modify, events[0].action,
            "concurrent detach preview uses the modify action");
        assertEq("concurrent detach", events[0].info, "concurrent detach preview identifies the operation");
        assertEq(1, callback_sql.size(), "concurrent detach preview emits one SQL callback");
        assertTrue(t.listPartitions().hasKey(p1), "concurrent detach preview does not mutate the table");

        ds.beginTransaction();
        assertThrows("PARTITION-TRANSACTION-ERROR", "cannot run while the calling thread is in a transaction", sub () {
            t.detachPartitionConcurrently(p1);
        });
        ds.rollback();
        assertTrue(t.listPartitions().hasKey(p1), "rejected transactional detach leaves the partition attached");

        t.addPartitionCommit({"name": pdef, "is_default": True});
        assertThrows("PARTITION-ERROR", "default partition", sub () {
            t.getDetachPartitionConcurrentlySql(p1);
        });
        t.dropPartitionCommit(pdef);

        assertThrows("PARTITION-ERROR", "is not pending concurrent detach", sub () {
            t.getFinalizePartitionDetachSql({"bound_from": 0, "bound_to": 10});
        });
        assertThrows("PARTITION-ERROR", "is not pending concurrent detach", sub () {
            t.finalizePartitionDetach(p1);
        });

        t.insertCommit({"id": 1, "value": "kept"});
        t.insertCommit({"id": 11, "value": "callback kept"});
        assertFalse(ds.currentThreadInTransaction(), "caller datasource is outside a transaction before detach");
        AbstractTable detached = t.detachPartitionConcurrently({"bound_from": 0, "bound_to": 10});
        assertEq(p1, detached.getName(), "concurrent detach returns the standalone partition table");
        assertFalse(ds.currentThreadInTransaction(), "concurrent detach does not acquire the caller datasource");
        assertFalse(t.listPartitions().hasKey(p1), "concurrently detached partition is removed from the parent");
        assertEq("kept", detached.selectRow().value, "concurrently detached table keeps its data");

        int executing_callback_count = 0;
        code<nothing(string)> executing_cb = sub (string statement) {
            ++executing_callback_count;
            Datasource exec_ds(ds.getConfigHash());
            exec_ds.setAutoCommit(True);
            exec_ds.open();
            exec_ds.execRaw(statement);
        };
        AbstractTable callback_detached = t.detachPartitionConcurrently(p2, {
            "sql_callback": executing_cb,
            "sql_callback_executed": True,
        });
        assertEq(1, executing_callback_count,
            "executing concurrent detach callback is not followed by duplicate execution");
        assertFalse(t.listPartitions().hasKey(p2),
            "executing concurrent detach callback invalidates structural metadata");
        assertEq("callback kept", callback_detached.selectRow().value,
            "externally executed concurrent detach keeps partition data");
    }

    partitionLifecycleCallbackTest() {
        if (!table) {
            testSkip("no DB connection");
        }

        AbstractDatasource ds = getDatasource();
        string parent = "pgsql_partition_callback_test";
        string p1 = parent + "_p1";
        string p2 = parent + "_p2";
        string p3 = parent + "_p3";
        string p4 = parent + "_p4";

        code drop_if_exists = sub (string table_name) {
            ds.execRaw(sprintf("drop table if exists %s cascade", table_name));
            ds.commit();
        };
        drop_if_exists(parent);
        drop_if_exists(p1);
        on_exit {
            drop_if_exists(p1);
            drop_if_exists(parent);
        }

        PgsqlTable tmpl(ds, parent);
        tmpl.setupTable({
            "columns": {"id": {"qore_type": Type::Int, "notnull": True}},
            "partition_strategy": {"method": "range", "columns": "id"},
            "partitions": {(p1): {"bound_from": 0, "bound_to": 10}},
        });
        tmpl.createCommit();

        PgsqlTable t(ds, parent);
        t.listPartitions();
        list<hash<auto>> events = ();
        list<string> callback_sql = ();
        code info_cb = sub (string str, int ac, *string type, *string nm, *string tbl, *string nn, *string info) {
            events += {"action": ac, "type": type, "name": nm, "table": tbl};
        };
        code sql_cb = sub (string statement) {
            callback_sql += statement;
        };
        hash<auto> preview_opt = {"info_callback": info_cb, "sql_callback": sql_cb};

        t.getAddPartitionSql({"name": p2, "bound_from": 10, "bound_to": 20}, preview_opt);
        assertEq(1, events.size(), "add generator emits one info callback");
        assertEq(1, callback_sql.size(), "add generator emits one SQL callback");
        assertEq({"action": AbstractDatabase::AC_Add, "type": "partition", "name": p2, "table": parent},
            events[0], "add generator callback metadata");
        assertFalse(t.listPartitions().hasKey(p2), "add SQL preview does not mutate the partition cache");

        events = ();
        callback_sql = ();
        t.getDropPartitionSql(p1, preview_opt);
        assertEq(1, events.size(), "drop generator emits one info callback");
        assertEq(AbstractDatabase::AC_Drop, events[0].action, "drop generator action code");
        assertEq(1, callback_sql.size(), "drop generator emits one SQL callback");

        events = ();
        callback_sql = ();
        t.getTruncatePartitionSql(p1, preview_opt);
        assertEq(1, events.size(), "truncate generator emits one info callback");
        assertEq(AbstractDatabase::AC_Truncate, events[0].action, "truncate generator action code");
        assertEq(1, callback_sql.size(), "truncate generator emits one SQL callback");

        events = ();
        callback_sql = ();
        t.getDetachPartitionSql(p1, preview_opt);
        assertEq(1, events.size(), "detach generator emits one info callback");
        assertEq(AbstractDatabase::AC_Modify, events[0].action, "detach generator action code");
        assertEq(1, callback_sql.size(), "detach generator emits one SQL callback");

        t.getAddPartitionSql({"name": p2, "bound_from": 10, "bound_to": 20},
            {"sql_callback_executed": True});
        assertFalse(t.listPartitions().hasKey(p2),
            "sql_callback_executed without a callback does not mark preview SQL as executed");

        assertThrows("OPTION-ERROR", "unknown key \"force\"", sub () {
            t.getAddPartitionSql({"name": p2, "bound_from": 10, "bound_to": 20}, {"force": True});
        });
        assertThrows("OPTION-ERROR", "unknown key \"force\"", sub () {
            t.getDropPartitionSql(p1, {"force": True});
        });
        assertThrows("OPTION-ERROR", "unknown key \"force\"", sub () {
            t.getTruncatePartitionSql(p1, {"force": True});
        });
        assertThrows("OPTION-ERROR", "unknown key \"force\"", sub () {
            t.getDetachPartitionSql(p1, {"force": True});
        });
        assertThrows("OPTION-ERROR", "unknown key \"force\"", sub () {
            t.addPartition({"name": p2, "bound_from": 10, "bound_to": 20}, {"force": True});
        });
        assertThrows("OPTION-ERROR", "unknown key \"force\"", sub () {
            t.ensurePartition({"name": p2, "bound_from": 10, "bound_to": 20}, {"force": True});
        });
        assertThrows("OPTION-ERROR", "unknown key \"force\"", sub () {
            t.dropPartition(p1, {"force": True});
        });
        assertThrows("OPTION-ERROR", "unknown key \"force\"", sub () {
            t.truncatePartition(p1, {"force": True});
        });
        assertThrows("OPTION-ERROR", "unknown key \"force\"", sub () {
            t.detachPartition(p1, {"force": True});
        });

        events = ();
        callback_sql = ();
        hash<PartitionInfo> added = t.addPartitionCommit({
            "name": p2,
            "bound_from": 10,
            "bound_to": 20,
        }, preview_opt);
        assertEq(p2, added.name, "direct add returns the created partition");
        assertEq(1, events.size(), "direct add emits one info callback");
        assertEq(AbstractDatabase::AC_Add, events[0].action, "direct add action code");
        assertEq(1, callback_sql.size(), "direct add emits one SQL callback while executing directly");

        ds.execRaw(sprintf("insert into %s values (11)", parent));
        ds.commit();
        int cached_partition_count = t.listPartitions().size();
        events = ();
        callback_sql = ();
        t.truncatePartitionCommit(p2, preview_opt);
        assertEq(1, events.size(), "direct truncate emits one info callback");
        assertEq(AbstractDatabase::AC_Truncate, events[0].action, "direct truncate action code");
        assertEq(1, callback_sql.size(), "direct truncate emits one SQL callback");
        assertEq(cached_partition_count, t.listPartitions().size(),
            "truncate refreshes statistics without changing structural partition metadata");
        assertEq(0, ds.selectRow(sprintf("select count(*) c from %s", p2)).c, "truncate executed exactly once");

        events = ();
        callback_sql = ();
        hash<PartitionEnsureResult> ensured = t.ensurePartitionCommit({
            "name": p3,
            "bound_from": 20,
            "bound_to": 30,
        }, preview_opt);
        assertTrue(ensured.created, "ensure creates the missing partition");
        assertEq(1, events.size(), "creating ensure emits one add callback");
        events = ();
        callback_sql = ();
        ensured = t.ensurePartition({"name": p3, "bound_from": 20, "bound_to": 30}, preview_opt);
        assertFalse(ensured.created, "ensure recognizes the existing partition");
        assertEq(0, events.size(), "non-creating ensure emits no DDL callback");
        assertEq(0, callback_sql.size(), "non-creating ensure emits no SQL callback");

        events = ();
        callback_sql = ();
        t.dropPartitionCommit(p3, preview_opt);
        assertEq(1, events.size(), "direct drop emits one info callback");
        assertEq(AbstractDatabase::AC_Drop, events[0].action, "direct drop action code");
        assertEq(1, callback_sql.size(), "direct drop emits one SQL callback");
        assertFalse(t.listPartitions().hasKey(p3), "drop reloads structural metadata after success");

        int external_calls = 0;
        code executing_cb = sub (string statement) {
            ++external_calls;
            ds.execRaw(statement);
        };
        hash<auto> executing_opt = {
            "sql_callback": executing_cb,
            "sql_callback_executed": True,
        };
        t.addPartitionCommit({"name": p4, "bound_from": 20, "bound_to": 30}, executing_opt);
        assertEq(1, external_calls, "executing add callback is not followed by duplicate direct execution");
        assertTrue(t.listPartitions().hasKey(p4), "executing add callback clears and reloads partition metadata");
        external_calls = 0;
        t.dropPartitionCommit(p4, executing_opt);
        assertEq(1, external_calls, "executing drop callback is not followed by duplicate direct execution");

        code failing_cb = sub (string statement) {
            throw "PARTITION-CALLBACK-ERROR", "intentional callback failure";
        };
        int error_callback_count = 0;
        code error_cb = sub (int ac, string type, string nm, *string tbl, *string nn, *string info,
                string statement, hash<ExceptionInfo> ex) {
            ++error_callback_count;
            assertEq(AbstractDatabase::AC_Add, ac, "error callback action code");
            assertEq("partition", type, "error callback object type");
            assertEq(p4, nm, "error callback object name");
            assertEq(parent, tbl, "error callback table name");
            assertEq("PARTITION-CALLBACK-ERROR", ex.err, "error callback receives the callback exception");
        };
        int before_failure = t.listPartitions().size();
        assertThrows("PARTITION-CALLBACK-ERROR", "intentional callback failure", sub () {
            t.addPartition({"name": p4, "bound_from": 20, "bound_to": 30}, {
                "sql_callback": failing_cb,
                "error_callback": error_cb,
            });
        });
        assertEq(1, error_callback_count, "failing SQL callback invokes the error callback exactly once");
        assertEq(before_failure, t.listPartitions().size(), "failed callback leaves the old partition cache valid");
        assertFalse(t.listPartitions().hasKey(p4), "failed callback does not create or cache a partition");

        code execute_then_fail_cb = sub (string statement) {
            ds.execRaw(statement);
            throw "PARTITION-CALLBACK-ERROR", "failure after execution";
        };
        assertThrows("PARTITION-CALLBACK-ERROR", "failure after execution", sub () {
            t.addPartition({"name": p4, "bound_from": 20, "bound_to": 30}, {
                "sql_callback": execute_then_fail_cb,
                "sql_callback_executed": True,
            });
        });
        assertTrue(t.listPartitions().hasKey(p4),
            "executing callback failure invalidates cache before reloading uncertain database state");
        ds.commit();
        t.dropPartitionCommit(p4);

        events = ();
        callback_sql = ();
        AbstractTable detached = t.detachPartitionCommit(p1, preview_opt);
        assertEq(p1, detached.getName(), "direct detach returns the standalone relation");
        assertEq(1, events.size(), "direct detach emits one info callback");
        assertEq(AbstractDatabase::AC_Modify, events[0].action, "direct detach action code");
        assertEq(1, callback_sql.size(), "direct detach emits one SQL callback");
        assertFalse(t.listPartitions().hasKey(p1), "detach reloads structural metadata after success");
    }

    insertFromSelectCallbackForwardingTest() {
        if (!table) {
            testSkip("no DB connection");
        }

        AbstractDatasource ds = getDatasource();
        string source_name = "pgsql_insert_select_source";
        string target_name = "pgsql_insert_select_target";
        code drop_if_exists = sub (string table_name) {
            ds.execRaw(sprintf("drop table if exists %s", table_name));
            ds.commit();
        };
        drop_if_exists(target_name);
        drop_if_exists(source_name);
        on_exit {
            drop_if_exists(target_name);
            drop_if_exists(source_name);
        }

        ds.execRaw(sprintf("create table %s (id integer not null)", source_name));
        ds.execRaw(sprintf("create table %s (id integer not null)", target_name));
        ds.execRaw(sprintf("insert into %s values (1), (2)", source_name));
        ds.commit();

        PgsqlTable source(ds, source_name);
        PgsqlTable target(ds, target_name);
        int callback_count = 0;
        *string callback_sql;
        *softlist<auto> callback_args;
        code sqlarg_cb = sub (string statement, *softlist<auto> args) {
            ++callback_count;
            callback_sql = statement;
            callback_args = args;
        };

        list<auto> preview_args;
        string preview_sql = target.getInsertFromSelectSql(("id",), source, {"where": {"id": 2}},
            \preview_args, {"sqlarg_callback": sqlarg_cb});
        assertTrue(preview_sql =~ /^insert into .*pgsql_insert_select_target.*\(id\) select/i,
            "insert-select preview returns SQL without executing it");
        assertEq((2,), preview_args, "insert-select preview returns ordered bind arguments");
        assertEq(0, callback_count, "non-executing insert-select preview does not invoke execution callbacks");
        assertEq(0, ds.selectRow(sprintf("select count(*) c from %s", target_name)).c,
            "insert-select preview does not modify the target");

        hash<SqlResultInfo> preview_info = target.getInsertFromSelectSqlWithInfo(("id",), source,
            {"columns": "id", "where": {"id": 2}});
        assertTrue(preview_info.sql =~ /\(id\) select id from/i,
            "WithInfo preview returns the generated projection SQL");
        assertEq((2,), preview_info.args, "WithInfo preview returns ordered bind arguments");

        int tablecode_count = 0;
        code<AbstractTable(AbstractDatasource, string)> tablecode = AbstractTable sub (
                AbstractDatasource resolved_ds, string resolved_name) {
            ++tablecode_count;
            assertEq(ds, resolved_ds, "insert-select tablecode receives the source datasource");
            return new PgsqlTable(resolved_ds, resolved_name);
        };
        target.getInsertFromSelectSql(("id",), source, {
            "alias": "s1",
            "columns": "s1.id",
            "join": join_inner(source_name, "s2", {"id": "id"}),
        }, NOTHING, {"tablecode": tablecode});
        assertEq(1, tablecode_count, "insert-select forwards tablecode while resolving source joins");

        assertThrows("COLUMN-ERROR", "2 source select expressions", sub () {
            target.getInsertFromSelectSql(("id",), source, {"columns": ("id", cop_value(1))});
        });
        assertThrows("COLUMN-ERROR", "duplicate insert-select target column", sub () {
            target.getInsertFromSelectSql(("id", "id"), source, {"columns": ("id", "id")});
        });
        assertThrows("COLUMN-ERROR", "at least one target column", sub () {
            target.getInsertFromSelectSql((), source, {"columns": "id"});
        });
        assertThrows("OPTION-ERROR", "unknown key", sub () {
            target.getInsertFromSelectSql(("id",), source, {"columns": "id"}, NOTHING,
                {"unsupported": True});
        });

        AbstractDatasource other_ds = getDatasource();
        PgsqlTable other_source(other_ds, source_name);
        assertThrows("DATASOURCE-ERROR", "same AbstractDatasource object", sub () {
            target.getInsertFromSelectSql(("id",), other_source, {"columns": "id"});
        });
        assertThrows("DATASOURCE-ERROR", "same AbstractDatasource object", sub () {
            target.insertFromSelect(("id",), other_source, {"columns": "id"});
        });
        PgsqlTable ctas_target(ds, "pgsql_ctas_identity_target");
        assertThrows("DATASOURCE-ERROR", "same AbstractDatasource object", sub () {
            ctas_target.getCreateAsSelectSql(other_source, {"columns": "id"});
        });

        string sql;
        int inserted = target.insertFromSelectCommit(("id",), source, {"where": {"id": 1}}, \sql,
            {"sqlarg_callback": sqlarg_cb});
        assertEq(1, inserted, "insert-select commit returns the inserted row count");
        assertEq(1, callback_count, "insert-select commit forwards the callback option exactly once");
        assertEq(sql, callback_sql, "insert-select callback receives the returned SQL");
        assertEq((1,), callback_args, "insert-select callback receives bound select arguments");
        assertEq(1, ds.selectRow(sprintf("select id from %s", target_name)).id,
            "insert-select commit inserts the selected row");
    }

    structuredAggregateSelectionTest() {
        if (!table) {
            testSkip("no DB connection");
        }

        AbstractDatasource ds = getDatasource();
        string parent_name = "pgsql_aggregate_parent";
        string child_name = "pgsql_aggregate_child";
        code drop_if_exists = sub (string table_name) {
            ds.execRaw(sprintf("drop table if exists %s", table_name));
            ds.commit();
        };
        drop_if_exists(child_name);
        drop_if_exists(parent_name);
        on_exit {
            drop_if_exists(child_name);
            drop_if_exists(parent_name);
        }

        ds.execRaw(sprintf("create table %s (id integer primary key, region text not null)", parent_name));
        ds.execRaw(sprintf("create table %s (parent_id integer not null, amount integer not null)", child_name));
        ds.execRaw(sprintf("insert into %s values (1, 'A'), (2, 'B')", parent_name));
        ds.execRaw(sprintf("insert into %s values (1, 5), (1, 15), (2, 3)", child_name));
        ds.commit();

        PgsqlTable parent(ds, parent_name);
        PgsqlTable child(ds, child_name);
        hash<SqlResultInfo> info = parent.selectRowsWithInfo({
            "alias": "p",
            "columns": (
                "p.region",
                cop_as(cop_min("c.amount"), "min_amount"),
                cop_as(cop_max("c.amount"), "max_amount"),
            ),
            "join": join_inner(child, "c", {"id": "parent_id"}),
            "groupby": "p.region",
            "having": {"c.amount": (COP_MAX, op_gt(10))},
        });
        assertEq(1, info.result.size(), "aggregate having filter returns one grouped row");
        assertEq("A", info.result[0].region, "aggregate query preserves the grouped join column");
        assertEq(5, info.result[0].min_amount, "cop_min computes the grouped minimum over the join");
        assertEq(15, info.result[0].max_amount, "cop_max computes the grouped maximum over the join");
        assertEq((10,), info.args, "aggregate WithInfo result exposes the having bind argument");
        assertTrue(info.sql =~ / join .* group by .* having /i,
            "aggregate WithInfo result exposes structured join/group/having SQL");
    }

    partitionEnhancementsTest() {
        if (!table) {
            testSkip("no DB connection");
        }

        AbstractDatasource ds = schema.getDatasource();
        on_exit ds.rollback();

        string parent = "pgsql_part_enh";
        code drop_if_exists = sub (string n) {
            PgsqlTable t(ds, n);
            if (t.checkExistence()) {
                t.dropCommit();
            }
        };
        list<string> children = (parent + "_a", parent + "_b", parent + "_c", parent + "_def",
            parent + "_order", parent + "_race");
        code cleanup = sub () {
            map drop_if_exists($1), children;
            drop_if_exists(parent);
        };
        cleanup();
        on_exit cleanup();

        PgsqlTable tmpl(ds, parent);
        tmpl.setupTable({
            "columns": {
                "id": {"qore_type": Type::Int, "notnull": True},
                "val": {"qore_type": Type::Int},
            },
            "partition_strategy": {"method": "range", "columns": ("id",)},
        });
        tmpl.createCommit();

        PgsqlTable t(ds, parent);

        # --- lower-bound ordering + zero-bound parsing + is_default (created deliberately out of order) ---
        t.addPartitionCommit({"name": parent + "_b", "bound_from": 200, "bound_to": 300});
        t.addPartitionCommit({"name": parent + "_a", "bound_from": 0, "bound_to": 100});
        t.addPartitionCommit({"name": parent + "_c", "bound_from": 100, "bound_to": 200});
        assertThrows("PARTITION-ERROR", "bounds overlap existing partition", sub () {
            t.getAddPartitionSql({"name": parent + "_overlap", "bound_from": 50, "bound_to": 150});
        });
        assertThrows("PARTITION-ERROR", "lower bound must be less than upper bound", sub () {
            t.getAddPartitionSql({"name": parent + "_reversed", "bound_from": 500, "bound_to": 400});
        });
        assertThrows("PARTITION-ERROR", "already exists", sub () {
            t.getAddPartitionSql({"name": parent + "_a", "bound_from": 300, "bound_to": 400});
        });
        t.addPartitionCommit({"name": parent + "_def", "is_default": True});
        assertThrows("PARTITION-ERROR", "default partition", sub () {
            t.getAddPartitionSql({"name": parent + "_def2", "is_default": True});
        });
        t.clear();

        hash<string, PartitionInfo> parts = t.listPartitions();
        assertEq((parent + "_a", parent + "_c", parent + "_b", parent + "_def"), keys parts,
            "partitions ordered by ascending lower bound with the default partition last");
        assertEq(0, parts{parent + "_a"}.bound_from, "zero lower bound parsed (not discarded as false)");
        assertTrue(parts{parent + "_def"}.is_default, "default partition flagged is_default");
        assertFalse(parts{parent + "_a"}.is_default, "range partition not flagged is_default");
        hash<auto> partition_desc = t.getDescriptionHash({"with_partitions": True});
        assertTrue(partition_desc.partitions{parent + "_def"}.is_default,
            "default partition description preserves is_default");
        assertFalse(exists partition_desc.partitions{parent + "_def"}.bound_from,
            "default partition description has no typed bounds");
        assertFalse(exists partition_desc.partitions{parent + "_def"}.bound_sql,
            "default partition description has no native bounds");
        assertThrows("OPTION-ERROR", "unknown key \"unknown\"", sub () {
            t.getDescriptionHash({"unknown": True});
        });

        # --- detachPartition() returns the standalone table and keeps its data ---
        ds.execRaw(sprintf("insert into %s (id, val) values (5, 50)", parent));
        ds.commit();
        AbstractTable detached = t.detachPartition(parent + "_a");
        ds.commit();
        assertEq(parent + "_a", detached.getName(), "detachPartition() returns the detached standalone table");
        assertEq(1, ds.selectRow(sprintf("select count(1) c from %s", parent + "_a")).c,
            "detached standalone table keeps its data");
        t.clear();
        assertFalse(t.listPartitions().hasKey(parent + "_a"), "detached partition removed from the parent");
        drop_if_exists(parent + "_a");

        # --- detach callback uses AC_Modify ---
        int cb_ac = -1;
        code icb = sub (string str, int ac, *string type, *string nm, *string tbl, *string nn, *string info) {
            cb_ac = ac;
        };
        t.getDetachPartitionSql(parent + "_c", {"info_callback": icb});
        assertEq(AbstractDatabase::AC_Modify, cb_ac, "detach callback emits the AC_Modify action code");

        # --- reserved-word partition name is quoted in DDL and sql_name ---
        t.addPartitionCommit({"name": parent + "_order", "bound_from": 300, "bound_to": 350});
        # a partition whose name is a reserved word requires identifier quoting to be created at all
        t.addPartitionCommit({"name": "order", "bound_from": 350, "bound_to": 400});
        t.clear();
        hash<string, PartitionInfo> rwparts = t.listPartitions();
        assertTrue(rwparts.hasKey("order"), "reserved-word partition name created and introspected");
        assertEq('public."order"', rwparts{"order"}.sql_name, "reserved-word partition sql_name is quoted");
        t.dropPartitionCommit("order");

        # --- ensurePartition() concurrent-create race: prime a stale cache, create the partition out of band
        #     via a second handle, then ensurePartition must treat the duplicate CREATE as success ---
        PgsqlTable racer(ds, parent);
        racer.listPartitions();
        t.addPartitionCommit({"name": parent + "_race", "bound_from": 400, "bound_to": 500});
        hash<PartitionEnsureResult> raced = racer.ensurePartition({
            "name": parent + "_race",
            "bound_from": 400,
            "bound_to": 500,
        });
        ds.commit();
        assertFalse(raced.created, "ensurePartition() race resolves the duplicate without creating");
        assertTrue(raced.materialized, "ensurePartition() race resolves to a materialized partition");
        assertEq(PartitionVerifiedBy::Bounds, raced.verified_by, "ensurePartition() race resolved by bounds");
    }

    partitionMethodFamiliesTest() {
        if (!table) {
            testSkip("no DB connection");
        }

        AbstractDatasource ds = schema.getDatasource();
        on_exit ds.rollback();

        list<string> names = ("pgsql_part_methods", "pgsql_part_methods_eu", "pgsql_part_methods_eu_h0",
            "pgsql_part_methods_eu_h1", "pgsql_part_methods_us", "pgsql_part_methods_us_h0",
            "pgsql_part_methods_us_h1", "pgsql_part_hash", "pgsql_part_hash_h0", "pgsql_part_hash_h1");
        code cleanup = sub () {
            # pgsql_part_mixed intentionally cannot be represented by PgsqlTable, so remove it natively
            ds.execRaw("drop table if exists pgsql_part_mixed cascade");
            ds.commit();
            foreach string n in (names) {
                PgsqlTable t(ds, n);
                if (t.checkExistence()) {
                    t.dropCommit();
                }
            }
        };
        cleanup();
        on_exit cleanup();

        PgsqlTable list_table(ds, "pgsql_part_methods");
        list_table.setupTable({
            "columns": {
                "id": {"qore_type": Type::Int, "notnull": True},
                "region": {"qore_type": SqlUtil::VARCHAR, "size": 8, "notnull": True},
            },
            "partition_strategy": {
                "method": "list",
                "columns": "region",
                "subpartition": {"method": "hash", "columns": "id"},
            },
            "partitions": {
                "pgsql_part_methods_eu": {
                    "values": ("eu", "e,u", "o'k"),
                    "subpartitions": {
                        "pgsql_part_methods_eu_h0": {"modulus": 2, "remainder": 0},
                        "pgsql_part_methods_eu_h1": {"modulus": 2, "remainder": 1},
                    },
                },
                "pgsql_part_methods_us": {
                    "values": ("us",),
                    "subpartitions": {
                        "pgsql_part_methods_us_h0": {"modulus": 2, "remainder": 0},
                        "pgsql_part_methods_us_h1": {"modulus": 2, "remainder": 1},
                    },
                },
            },
        });
        assertTrue(list_table.supportsPartitionMethod("list"), "PostgreSQL supports portable list partitioning");
        assertTrue(list_table.supportsPartitionMethod("hash", True),
            "PostgreSQL supports portable hash subpartitioning");
        assertThrows("DESCRIPTION-ERROR", "duplicate value", sub () {
            PgsqlTable invalid(ds, "pgsql_part_invalid_list");
            invalid.setupTable({
                "columns": {"region": {"qore_type": Type::String}},
                "partition_strategy": {"method": "list", "columns": "region"},
                "partitions": {"p": {"values": ("eu", "eu")}},
            });
        });
        assertThrows("PARTITION-ERROR", "already assigned", sub () {
            PgsqlTable invalid(ds, "pgsql_part_overlapping_list");
            invalid.setupTable({
                "columns": {"region": {"qore_type": Type::String}},
                "partition_strategy": {"method": "list", "columns": "region"},
                "partitions": {
                    "p1": {"values": ("eu",)},
                    "p2": {"values": ("eu", "us")},
                },
            });
        });
        assertThrows("DESCRIPTION-ERROR", "values cannot be empty", sub () {
            PgsqlTable invalid(ds, "pgsql_part_empty_list");
            invalid.setupTable({
                "columns": {"region": {"qore_type": Type::String}},
                "partition_strategy": {"method": "list", "columns": "region"},
                "partitions": {"p": {"values": ()}},
            });
        });
        assertThrows("DESCRIPTION-ERROR", "0 <= remainder < modulus", sub () {
            PgsqlTable invalid(ds, "pgsql_part_invalid_hash");
            invalid.setupTable({
                "columns": {"id": {"qore_type": Type::Int}},
                "partition_strategy": {"method": "hash", "columns": "id"},
                "partitions": {"p": {"modulus": 2, "remainder": 2}},
            });
        });
        assertTrue(list_table.getCreateSqlString() =~ /partition by list \(region\).*partition by hash \(id\)/is,
            "nested list/hash DDL includes both partitioning levels");
        list_table.createCommit();

        PgsqlTable live(ds, "pgsql_part_methods");
        hash<PartitionStrategy> strategy = live.getPartitionStrategy();
        assertEq("list", strategy.method, "list strategy round-trips");
        assertEq("hash", strategy.subpartition.method, "subpartition strategy round-trips");
        hash<string, PartitionInfo> parts = live.listPartitions();
        assertEq(("eu", "e,u", "o'k"), parts.pgsql_part_methods_eu.values,
            "typed list values, including SQL punctuation, are introspected");
        assertEq(2, parts.pgsql_part_methods_eu.subpartitions.size(), "nested partitions are introspected");
        assertTrue(exists parts.pgsql_part_methods_eu.subpartitions.pgsql_part_methods_eu_h0.size_bytes,
            "nested partition storage metadata is introspected recursively");
        assertEq(0, parts.pgsql_part_methods_eu.subpartitions.pgsql_part_methods_eu_h0.remainder,
            "hash remainder is introspected");
        assertEq(2, parts.pgsql_part_methods_eu.subpartitions.pgsql_part_methods_eu_h0.modulus,
            "hash modulus is introspected");

        live.insert({"id": 1, "region": "eu"});
        live.insert({"id": 2, "region": "us"});
        ds.commit();
        assertEq(2, live.rowCount(), "nested partitions route inserted rows");
        hash<PartitionLookupResult> lookup = live.findPartitionBySpec({"values": ("o'k", "eu", "e,u")});
        assertEq(PartitionLookupStatus::Found, lookup.status, "list partition lookup compares typed values");
        assertEq("pgsql_part_methods_eu", lookup.partition.name, "list lookup returns the expected partition");
        hash<PartitionEnsureResult> ensured = live.ensurePartition({
            "name": "pgsql_part_methods_eu",
            "values": ("eu", "e,u", "o'k"),
        });
        assertEq(PartitionVerifiedBy::Definition, ensured.verified_by,
            "list ensure reports definition verification");

        hash<auto> desc = live.getDescriptionHash({"with_partitions": True});
        assertEq(("eu", "e,u", "o'k"), desc.partitions.pgsql_part_methods_eu.values,
            "list values are recreatable in table descriptions");
        assertEq(1, desc.partitions.pgsql_part_methods_eu.subpartitions.pgsql_part_methods_eu_h1.remainder,
            "nested hash definitions are recreatable");
        PgsqlTable roundtrip(ds, "pgsql_part_methods_copy");
        roundtrip.setupTable(desc);
        assertTrue(roundtrip.getCreateSqlString() =~ /for values with \(modulus 2, remainder 1\)/i,
            "round-tripped descriptions regenerate hash bucket DDL");

        PgsqlTable hash_table(ds, "pgsql_part_hash");
        hash_table.setupTable({
            "columns": {"id": {"qore_type": Type::Int, "notnull": True}},
            "partition_strategy": {"method": "hash", "columns": "id"},
            "partitions": {
                "pgsql_part_hash_h0": {"modulus": 2, "remainder": 0},
                "pgsql_part_hash_h1": {"modulus": 2, "remainder": 1},
            },
        });
        hash_table.createCommit();
        PgsqlTable live_hash(ds, "pgsql_part_hash");
        hash<PartitionLookupResult> hash_lookup = live_hash.findPartitionBySpec({"modulus": 2, "remainder": 1});
        assertEq(PartitionLookupStatus::Found, hash_lookup.status, "hash bucket lookup is semantic");
        assertEq("pgsql_part_hash_h1", hash_lookup.partition.name, "hash lookup returns the expected bucket");
        assertThrows("PARTITION-ERROR", "modulus", sub () {
            live_hash.getAddPartitionSql({"name": "pgsql_part_hash_h2", "modulus": 4, "remainder": 2});
        });
        assertThrows("PARTITION-ERROR", "duplicates existing partition", sub () {
            live_hash.getAddPartitionSql({"name": "pgsql_part_hash_dup", "modulus": 2, "remainder": 1});
        });

        ds.execRaw("create table pgsql_part_mixed (id int, region text) partition by range (id)");
        ds.execRaw("create table pgsql_part_mixed_p0 partition of pgsql_part_mixed "
            "for values from (0) to (100) partition by hash (region)");
        ds.execRaw("create table pgsql_part_mixed_p1 partition of pgsql_part_mixed "
            "for values from (100) to (200)");
        ds.commit();
        PgsqlTable mixed(ds, "pgsql_part_mixed");
        assertThrows("PARTITION-ERROR", "non-uniform native subpartition hierarchy", sub () {
            mixed.getPartitionStrategy();
        });
    }

    partitionChildExclusionTest() {
        if (!table) {
            testSkip("no DB connection");
        }

        AbstractDatasource ds = schema.getDatasource();
        on_exit ds.rollback();

        code drop_if_exists = sub (string n) {
            PgsqlTable t(ds, n);
            if (t.checkExistence()) {
                t.dropCommit();
            }
        };
        list<string> names = ("pce_p1", "pce_part", "pce_ci_child", "pce_ci_parent", "pce_normal");
        code cleanup = sub () { map drop_if_exists($1), names; };
        cleanup();
        on_exit cleanup();

        # a partitioned table with a child partition
        ds.execRaw("create table pce_part (id int not null) partition by range (id)");
        ds.execRaw("create table pce_p1 partition of pce_part for values from (0) to (100)");
        # a classic table-inheritance parent/child (NOT partitions) to guard against over-filtering
        ds.execRaw("create table pce_ci_parent (id int)");
        ds.execRaw("create table pce_ci_child (extra int) inherits (pce_ci_parent)");
        # a plain table
        ds.execRaw("create table pce_normal (id int)");
        ds.commit();

        hash<auto> listed = map {$1: True}, (new Database(ds)).listTables();
        # PostgreSQL exposes partitions as relations, but a partition child is not a standalone logical table
        assertTrue(listed.hasKey("pce_part"), "partitioned parent is listed");
        assertFalse(listed.hasKey("pce_p1"), "partition child is not listed as a table");
        # classic inheritance children are not partitions and must still be listed
        assertTrue(listed.hasKey("pce_ci_parent"), "classic-inheritance parent is listed");
        assertTrue(listed.hasKey("pce_ci_child"), "classic-inheritance child is still listed (not a partition)");
        assertTrue(listed.hasKey("pce_normal"), "plain table is listed");

        # the data-schema export represents the child only under the parent's partitions, never as a top table
        hash<auto> rev = (new SchemaReverse::SchemaReverse(ds, "T", {"with_partitions": True})).toQore();
        assertTrue(rev.tables.hasKey("pce_part"), "export includes the partitioned parent");
        assertFalse(rev.tables.hasKey("pce_p1"), "export does not include the partition child as a top-level table");
        assertTrue(rev.tables.pce_part.partitions.hasKey("pce_p1"), "export lists the child under the parent's partitions");
    }

    private string getResultSetSql() {
        testSkip("does not support result set output binds");
        return "";
    }

    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-c,--conn=ARG", "set DB connection argument (ex: \"pgsql:user/pass@db\")", OptionColumn);
    }

    Datasource getDatasource() {
        if (!m_options.connstr)
            m_options.connstr = ENV.QORE_DB_CONNSTR_PGSQL;
        Datasource ds(m_options.connstr);
        if (ds.getDriverName() != "pgsql")
            throw "PGSQL-ERROR", sprintf("cannot execute the pgsql tests on a connection using driver %y", ds.getDriverName());
        ds.open();
        return ds;
    }
}
