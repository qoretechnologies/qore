%modern
%requires Util

module TestRunIsolation {
    version = "1.0";
    desc = "the names, leftovers and host locks of the databases and schemas of test runs";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
}

/** @mainpage TestRunIsolation Module

    @section testrunisolationintro Introduction

    The isolation modules of the database tests (MysqlTestIsolation.qm, OracleTestIsolation.qm, MssqlTestIsolation.qm
    and FirebirdTestIsolation.qm) give each run of a test a database, schema or user of its own:
    - @ref TestRunIsolation::TestRun::makeName() "TestRun::makeName()" names it
      <tt>qtest_</tt><em>suite</em><tt>_</tt><em>host</em><tt>_</tt><em>pid</em><tt>_</tt><em>epoch</em><tt>_</tt>
      <em>random</em>: two runs never have the same name, also in CI job pods whose host names and process ids are
      the same, as the name has random characters of its own; a database, schema or user with the name of the run is
      never shared: it is created, and its creation fails when it exists
    - @ref TestRunIsolation::TestRun::isLeftover() "TestRun::isLeftover()" tells a run's object that is at least
      @ref TestRunIsolation::TestRun::LeftoverAge "LeftoverAge" old, by the time in its name, whatever the host and
      process that made it: a run that is killed leaves its objects behind, and a CI job's pod has a host name and
      process ids of its own, so neither its host nor its process tells whether it still runs; no test runs that long
    - @ref TestRunIsolation::TestRun::lockHost() "TestRun::lockHost()" makes the tests that cannot have a database of
      their own on a host run one at a time: each holds an exclusive lock on a file in the temporary directory until
      it ends
*/

#! Contains the definitions of the TestRunIsolation module
public namespace TestRunIsolation {
#! The names, leftovers and host locks of test runs
public class TestRun {
    public {
        #! The prefix of the name of a run's object, in lower case
        const Prefix = "qtest_";

        #! A run's object is a leftover when it is at least this old: well above the longest test (its time limit)
        const LeftoverAge = 6h;
    }

    private {
        #! The locks of the tests that cannot have a database of their own, keyed by the file
        static hash<string, File> locks;

        #! Serializes the locks
        static Mutex lck();
    }

    #! Returns the name of an object of a test run
    /** @param suite the name of the test: its letters and digits, in lower case, at most 12 of them

        @return \c qtest_<suite>_<host>_<pid>_<epoch>_<random>, in lower case
    */
    static string makeName(string suite) {
        return sprintf("%s%s_%s_%d_%d_%s", Prefix, TestRun::getLabel(suite, 12), TestRun::getHost(), getpid(),
            now_us().getEpochSeconds(), TestRun::getLabel(get_random_string(24), 6));
    }

    #! Returns True if the given name is that of a run's object that is at least LeftoverAge old
    /** @param name a name, in any case
        @param now the current time; the time is taken if not given

        @return True if the name is a run's (see makeName()), optionally followed by \c "_" and a tag, and its time
        is at least LeftoverAge before \a now
    */
    static bool isLeftover(string name, *date now) {
        *string epoch = (name =~ x/^qtest_[a-z0-9]+_[a-z0-9]+_[0-9]+_([0-9]+)_[a-z0-9]+(?:_[a-z0-9]+)?$/i)[0];
        if (!epoch) {
            return False;
        }
        int age = (now ?? now_us()).getEpochSeconds() - epoch.toInt();
        return age >= LeftoverAge.durationSeconds();
    }

    #! Holds an exclusive lock, until the process ends, of the tests on this host that use the given datasource string
    #! without a database of their own
    /** A second process that takes the lock waits until the first one has ended

        @param kind the kind of database, in the name of the lock file
        @param connstr the datasource string
    */
    static lockHost(string kind, string connstr) {
        string path = TestRun::getLockPath(kind, connstr);
        lck.lock();
        on_exit lck.unlock();
        if (locks{path}) {
            return;
        }
        File f();
        f.open2(path, O_CREAT | O_RDWR, 0666);
        # the file is shared by the users of the host, whose runs wait for one another: its mode is not the one that
        # the user's umask leaves (only the owner of the file can change it, so a second user's run opens it as it is)
        if (hstat(path).uid == getuid()) {
            chmod(path, 0666);
        }
        # an exclusive (write) lock: a shared (read) lock would not keep another run out
        f.lockBlocking(F_WRLCK);
        locks{path} = f;
    }

    #! Returns the path of the lock file of the given kind of database and datasource string
    /** The name has the MD5 of the database that the datasource string names (its driver, user, host, port and
        database), never of its password, which could be guessed from the name
    */
    static string getLockPath(string kind, string connstr) {
        string id;
        try {
            hash<auto> config = parse_datasource(connstr);
            id = sprintf("%s:%s@%s:%s/%s", config.type ?? "", config.user ?? "", config.host ?? "", config.port ?? "",
                config.db ?? "");
        } catch (hash<ExceptionInfo> ex) {
            # a string that cannot be parsed, without anything that can be a password
            id = TestRun::maskSecrets(connstr);
        }
        return sprintf("%s/qore-test-%s-%s.lock", tmp_location(), kind, MD5(id));
    }

    #! Returns a text, such as an exception's description, with the passwords of the datasource strings in it masked
    /** A datasource string's password is between its user's \c "/" and the last \c "@" before its database; a
        message about a datasource string, such as the description of \c DATASOURCE-PARSE-ERROR, quotes the whole
        string, and is printed where others can read it (CI job logs)

        @param text the text
        @param connstrs datasource strings whose passwords are masked wherever they are in the text, also when the
        datasource string cannot be parsed
    */
    static string maskSecrets(string text, *softlist<string> connstrs) {
        foreach string connstr in (connstrs) {
            *string pass;
            try {
                pass = parse_datasource(connstr).pass;
            } catch (hash<ExceptionInfo> ex) {
                pass = (connstr =~ x/^(?:[^:\/@]*:)?[^\/@]*\/(.*)@/s)[0];
            }
            if (pass) {
                text = replace(text, pass, "****");
            }
        }
        # the password of any other datasource string: "user/password@" at the start, after a driver name, a quote or
        # a space
        text =~ s/(^|[:"' ])([^:\/@"' ]+)\/[^@"' ]*@/$1$2\/****@/g;
        return text;
    }

    #! Returns the letters and digits of a string, in lower case, at most the given number of them
    static string getLabel(string str, int max) {
        string label = str.lwr();
        label =~ s/[^a-z0-9]//g;
        if (!label) {
            label = "x";
        }
        return label.substr(0, max);
    }

    #! Returns the first label of the host name, as a label
    private static string getHost() {
        return TestRun::getLabel((gethostname() =~ x/^([^.]+)/)[0] ?? gethostname(), 12);
    }
}
}
