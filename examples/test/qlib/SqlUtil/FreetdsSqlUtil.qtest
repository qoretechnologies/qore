#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires Logger
%requires DataProvider
%requires SqlUtil
%requires MssqlSqlUtilBase
%requires FreetdsSqlUtil

%prepend-module-path "${SCRIPT_DIR}"
%requires SqlUtilTestBase

%exec-class FreetdsTest

class FreetdsTestSchema inherits SqlUtilTestSchema {
    public {
        const SchemaName = "FreetdsTestSchema";
        const SchemaVersion = "1.0";
    }

    private {
        const GenericOptions = (
            "replace": True,
        );

        const IndexOptions = {};

        const ColumnOptions = {};

        const T_SqlUtilTest = (
            "columns": (
                "id": c_number(14, True, "an example comment with 'quotes'"),
                "id_": c_number(14, True),
                "null_f": c_varchar(69),
                "blob_f": c_blob(True),
                "clob_f": c_clob(True),
            ),
            "primary_key": ("name": "pk_sqlutil_test", "columns": ("id")),
        );

        const Tables = (
            "sqlutil_test": T_SqlUtilTest,
        );
    }

    constructor(AbstractDatasource ds, *string dts, *string its) : SqlUtilTestSchema(ds, dts, its) {
    }

    private string getNameImpl() {
        return SchemaName;
    }

    private string getVersionImpl() {
        return SchemaVersion;
    }

    private *hash getTablesImpl() {
        return doTables(Tables, FreetdsTest::CustomColumns) + ("test_analytic_functions" : T_TestAnalyticFunctions);
    }

    private *hash getIndexOptionsImpl() {
        return IndexOptions;
    }

    private *hash getGenericOptionsImpl() {
        return GenericOptions;
    }

    private *hash getColumnOptionsImpl() {
        return ColumnOptions;
    }
}

class FreetdsTest inherits SqlTestBase {
    public {
        const CustomColumns = (
            "varchar": (
                "value": "hello",
                "size": "20",
            ),
            "char": (
                "value": "hello",
                "size": "20",
            ),
            "decimal": (
                "size": 15,
                "scale": 2,
                "value": 400.95n,
            ),
            "decimal_def": (
                "type": "decimal",
                "value": 401,
            ),

            "text": "test",

            "tinyint": 8,
            "smallint": 1024,
            "int": 12345,
            "float": 2.5,
            "real": 5.5,

            "date": ("value": 2015-01-01),
            "time": ("value": 12:45,),
            "datetime": 2015-01-01T12:45:00.450,
            "smalldatetime": 2015-01-01T12:45,

            # fake timestamp column for cop_trunc_date
            "timestamp": (
                "type": "datetime",
                "value": 2016-02-11T09:26:14.500,
                # note: The SQL Server datetime type only has a 1/300 ms (~3.33̅ ms) resolution
            ),

            "varbinary": <bead>,

            "image": <bead>,
        );
    }

    constructor() : SqlTestBase("FreetdsTest", "1.0", \ARGV, MyOpts) {
        Datasource ds;
        try {
            ds = getDatasource();
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose)
                printf("%s: %s\n", ex.err, ex.desc);
            # skip tests if we can't create the datasource
        }

        if (ds) {
            initTestData(CustomColumns);

            { # Make sure the DB is clear before doing the tests.
                FreetdsTable t = new FreetdsTable(ds, "sqlutil_test");
                if (t.checkExistence())
                    t.dropCommit();
            }

            # create the test schema
            schema = new FreetdsTestSchema(ds);

            schema.align(False, m_options.verbose, m_options.verbose > 0);

            # get table object
            table = (new Table(schema.getDatasource(), "sqlutil_test")).getTable();

            addTestCase("analytic/window functions", \testAnalyticFunctions());
            addTestCase("range partition lifecycle", \rangePartitionLifecycleTest());
            addTestCase("create as select", \createAsSelectTest());
            addTestCase("drop table options", \dropTableOptionsTest());
        }

        set_return_value(main());
    }

    private cleanupDropOptionsTest(AbstractDatasource ds) {
        string schema = ds.selectRow("select schema_name() as \"schema\"").schema;
        ds.execRaw(sprintf("if object_id('%s.mssql_drop_options_test', 'U') is not null "
            "drop table %s.mssql_drop_options_test", schema, schema));
        ds.commit();
    }

    private dropTableOptionsTest() {
        if (!table) {
            testSkip("no DB connection");
        }

        AbstractDatasource ds = table.getDatasource();
        if ((new MssqlTable(ds, "mssql_drop_options_probe")).is_sybase) {
            testSkip("SQL Server DROP TABLE IF EXISTS test is not supported on Sybase");
        }

        cleanupDropOptionsTest(ds);
        on_exit {
            try {
                cleanupDropOptionsTest(ds);
            } catch (hash<ExceptionInfo> ex) {
            }
        }

        ds.execRaw("create table mssql_drop_options_test (id int not null)");
        ds.commit();

        MssqlTable t(ds, "mssql_drop_options_test");
        softlist<auto> sql = t.getDropSql({"if_exists": True});
        assertEq(1, sql.size());
        assertTrue(sql[0] =~ /^drop table if exists .*mssql_drop_options_test$/i);
        t.dropCommit({"if_exists": True});
        assertEq(False, t.checkExistence());

        assertEq((), t.getDropSql({"if_exists": True}));
        t.dropCommit({"if_exists": True});

        ds.execRaw("create table mssql_drop_options_test (id int not null)");
        ds.commit();
        MssqlTable t2(ds, "mssql_drop_options_test");
        assertThrows("OPTION-ERROR", "cascade table drop options",
            sub() {
                t2.getDropSql({"cascade": True});
            });
    }

    private cleanupCreateAsSelectTest(AbstractDatasource ds) {
        string schema = ds.selectRow("select schema_name() as \"schema\"").schema;
        foreach string name in (("mssql_ctas_dst", "mssql_ctas_src")) {
            ds.execRaw(sprintf("if object_id('%s.%s', 'U') is not null drop table %s.%s",
                schema, name, schema, name));
        }
        ds.commit();
    }

    private createAsSelectTest() {
        if (!table) {
            testSkip("no DB connection");
        }

        AbstractDatasource ds = table.getDatasource();
        if ((new MssqlTable(ds, "mssql_ctas_probe")).is_sybase) {
            testSkip("SQL Server SELECT INTO CTAS test is not supported on Sybase");
        }

        cleanupCreateAsSelectTest(ds);
        on_exit {
            try {
                cleanupCreateAsSelectTest(ds);
            } catch (hash<ExceptionInfo> ex) {
            }
        }

        ds.execRaw("create table mssql_ctas_src (id int not null, name varchar(100) not null, amount int not null)");
        ds.execRaw("insert into mssql_ctas_src values (1, 'a', 10), (2, 'b', 20), (3, 'c', 30)");
        ds.commit();

        AbstractTable source = AbstractTable::getTable(ds, "mssql_ctas_src");
        AbstractTable target = AbstractTable::getTable(ds, "mssql_ctas_dst");
        hash<SqlResultInfo> info = target.getCreateAsSelectSqlWithInfo(source, {
            "columns": ("id", "name"),
            "where": {"amount": op_gt(10)},
        });
        assertTrue(info.sql =~ /^select .* into .*mssql_ctas_dst from /i);
        assertEq(1, info.args.size());
        assertEq(10, info.args[0]);

        info = target.createAsSelectWithInfo(source, {
            "columns": ("id", "name"),
            "where": {"amount": op_gt(10)},
        });
        assertTrue(info.sql =~ /^select .* into .*mssql_ctas_dst from /i);

        AbstractTable materialized = AbstractTable::getTable(ds, "mssql_ctas_dst");
        assertEq(2, materialized.rowCount());
        hash<auto> rows = materialized.select({"columns": ("id", "name"), "orderby": "id"});
        assertEq((2, 3), rows.id);
        assertEq(("b", "c"), rows.name);
    }

    private cleanupRangePartitionLifecycleTest(AbstractDatasource ds) {
        string schema = ds.selectRow("select schema_name() as \"schema\"").schema;
        string suffix = regex_subst(schema + "_mssql_partition_test", "[^A-Za-z0-9_]", "_", RE_Global);
        ds.execRaw(sprintf("if object_id('%s.mssql_partition_test', 'U') is not null "
            "drop table %s.mssql_partition_test", schema, schema));
        ds.execRaw(sprintf("if exists (select 1 from sys.partition_schemes where name = 'qore_ps_%s') "
            "drop partition scheme qore_ps_%s", suffix, suffix));
        ds.execRaw(sprintf("if exists (select 1 from sys.partition_functions where name = 'qore_pf_%s') "
            "drop partition function qore_pf_%s", suffix, suffix));
        ds.commit();
    }

    private rangePartitionLifecycleTest() {
        if (!table) {
            testSkip("no DB connection");
        }

        AbstractDatasource ds = table.getDatasource();
        AbstractTable probe = AbstractTable::getTable(ds, "mssql_partition_test");
        if (!probe.supportsPartitions()) {
            testSkip("SQL Server partition lifecycle support requires SQL Server 2016 or newer");
        }

        cleanupRangePartitionLifecycleTest(ds);
        on_exit {
            try {
                cleanupRangePartitionLifecycleTest(ds);
            } catch (hash<ExceptionInfo> ex) {
            }
        }

        AbstractTable t = AbstractTable::getTable(ds, "mssql_partition_test");
        t.setupTable({
            "columns": {
                "id": {"qore_type": Type::Int, "notnull": True},
                "d": {"native_type": "datetime2", "notnull": True},
                "v": {"qore_type": Type::String, "size": 20},
            },
            "primary_key": {"name": "mssql_partition_test_pk", "columns": ("id", "d")},
            "partition_strategy": {"method": "range", "columns": "d"},
            "partitions": {
                "p1": {"name": "p1", "bound_from": 2026-01-01, "bound_to": 2026-02-01},
                "p2": {"name": "p2", "bound_from": 2026-02-01, "bound_to": 2026-03-01},
            },
        });
        list<auto> create_sql = t.getCreateSql();
        assertTrue(create_sql[0] =~ /create partition function/i);
        assertTrue(create_sql[0] =~ /as range right/i);
        t.createCommit();

        AbstractTable rt = AbstractTable::getTable(ds, "mssql_partition_test");
        assertEq(True, rt.supportsPartitions());
        assertEq(False, rt.supportsPartitionDetach());

        hash<PartitionStrategy> strategy = rt.getPartitionStrategy();
        assertEq("range", strategy.method);
        assertEq(1, strategy.columns.size());
        assertEq("d", strategy.columns[0]);

        hash<string, PartitionInfo> parts = rt.listPartitions();
        assertEq(2, parts.size());
        assertEq(2026-02-01, parts.p2.bound_from);
        assertEq(2026-03-01, parts.p2.bound_to);
        assertEq(3, parts.p2.driver.mssql.partition_number);

        hash<auto> desc = rt.getDescriptionHash({"with_partitions": True});
        assertEq(2, desc.partitions.size());

        hash<PartitionLookupResult> lookup = rt.findPartitionBySpec({
            "bound_from": 2026-02-01,
            "bound_to": 2026-03-01,
        });
        assertEq(PartitionLookupStatus::Found, lookup.status);
        assertEq("p2", lookup.partition.name);

        hash<PartitionEnsureResult> ensure = rt.ensurePartitionCommit({
            "name": "p3",
            "bound_from": 2026-03-01,
            "bound_to": 2026-04-01,
        });
        assertEq(True, ensure.created);
        assertEq(True, ensure.materialized);
        assertEq(PartitionVerifiedBy::Bounds, ensure.verified_by);
        assertEq(True, rt.listPartitions().hasKey("p3"));

        ds.execRaw("insert into mssql_partition_test values (3, cast('2026-03-15' as datetime2), 'x')");
        ds.commit();
        assertEq(1, ds.selectRow("select count(*) c from mssql_partition_test where d >= cast('2026-03-01' "
            "as datetime2) and d < cast('2026-04-01' as datetime2)").c);
        string truncate_sql = rt.getTruncatePartitionSql({"bound_from": 2026-03-01, "bound_to": 2026-04-01});
        assertTrue(truncate_sql =~ /with \(partitions \([0-9]+\)\)/i);
        rt.truncatePartitionCommit({"bound_from": 2026-03-01, "bound_to": 2026-04-01});
        assertEq(0, ds.selectRow("select count(*) c from mssql_partition_test where d >= cast('2026-03-01' "
            "as datetime2) and d < cast('2026-04-01' as datetime2)").c);

        rt.dropPartitionCommit({"bound_from": 2026-03-01, "bound_to": 2026-04-01});
        assertEq(False, rt.listPartitions().hasKey("p3"));

        AbstractTable racer = AbstractTable::getTable(ds, "mssql_partition_test");
        racer.listPartitions();
        rt.ensurePartitionCommit({"name": "p3", "bound_from": 2026-03-01, "bound_to": 2026-04-01});
        hash<PartitionEnsureResult> raced = racer.ensurePartitionCommit({
            "name": "p3",
            "bound_from": 2026-03-01,
            "bound_to": 2026-04-01,
        });
        assertEq(False, raced.created, "ensurePartition() race resolves the duplicate without creating");
        assertEq(True, raced.materialized, "ensurePartition() race resolves to a materialized partition");
        rt.dropPartitionCommit("p3");

        assertThrows("PARTITION-NOT-SUPPORTED", "does not support detaching partitions",
            sub() {
                rt.detachPartition("p2");
            });

        AbstractTable bad = AbstractTable::getTable(ds, "mssql_partition_test_bad");
        assertThrows("DESCRIPTION-ERROR", "composite partition key",
            sub() {
                bad.setupTable({
                    "columns": {
                        "id": {"qore_type": Type::Int, "notnull": True},
                        "d": {"native_type": "datetime2", "notnull": True},
                    },
                    "primary_key": {"name": "mssql_partition_test_bad_pk", "columns": ("id", "d")},
                    "partition_strategy": {"method": "range", "columns": ("id", "d")},
                    "partitions": {
                        "p1": {"name": "p1", "bound_from": 1, "bound_to": 2},
                    },
                });
            });
    }

    private string getResultSetSql() {
        testSkip("does not support result set output binds");
        return "";
    }

    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-c,--conn=ARG", "set DB connection argument (ex: \"freetds:user/pass@db\")", OptionColumn);
    }

    Datasource getDatasource() {
        if (!m_options.connstr)
            m_options.connstr = ENV.QORE_DB_CONNSTR_FREETDS;
        Datasource ds(m_options.connstr);
        if (ds.getDriverName() != "freetds")
            throw "FREETDS-ERROR", sprintf("cannot execute the freetds tests on a connection using driver %y", ds.getDriverName());
        ds.open();
        return ds;
    }
}
