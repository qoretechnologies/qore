#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires ../../../../qlib/Util.qmod
%requires ../../../../qlib/Logger.qmod
%requires ../../../../qlib/DataProvider/DataProvider.qmod
%requires ../../../../qlib/SqlUtil/SqlUtil.qmod
%requires ../../../../qlib/MssqlSqlUtilBase.qmod
%requires ../../../../qlib/FreetdsSqlUtil.qmod

%prepend-module-path "${SCRIPT_DIR}"
%requires ./SqlUtilTestBase.qm

%exec-class FreetdsTest

class FreetdsTestSchema inherits SqlUtilTestSchema {
    public {
        const SchemaName = "FreetdsTestSchema";
        const SchemaVersion = "1.0";
    }

    private {
        const GenericOptions = (
            "replace": True,
        );

        const IndexOptions = {};

        const ColumnOptions = {};

        const T_SqlUtilTest = (
            "columns": (
                "id": c_number(14, True, "an example comment with 'quotes'"),
                "id_": c_number(14, True),
                "null_f": c_varchar(69),
                "blob_f": c_blob(True),
                "clob_f": c_clob(True),
            ),
            "primary_key": ("name": "pk_sqlutil_test", "columns": ("id")),
        );

        const Tables = (
            "sqlutil_test": T_SqlUtilTest,
        );
    }

    constructor(AbstractDatasource ds, *string dts, *string its) : SqlUtilTestSchema(ds, dts, its) {
    }

    private string getNameImpl() {
        return SchemaName;
    }

    private string getVersionImpl() {
        return SchemaVersion;
    }

    private *hash getTablesImpl() {
        return doTables(Tables, FreetdsTest::CustomColumns) + ("test_analytic_functions" : T_TestAnalyticFunctions);
    }

    private *hash getIndexOptionsImpl() {
        return IndexOptions;
    }

    private *hash getGenericOptionsImpl() {
        return GenericOptions;
    }

    private *hash getColumnOptionsImpl() {
        return ColumnOptions;
    }
}

class FreetdsTest inherits SqlTestBase {
    public {
        const CustomColumns = (
            "varchar": (
                "value": "hello",
                "size": "20",
            ),
            "char": (
                "value": "hello",
                "size": "20",
            ),
            "decimal": (
                "size": 15,
                "scale": 2,
                "value": 400.95n,
            ),
            "decimal_def": (
                "type": "decimal",
                "value": 401,
            ),

            "text": "test",

            "tinyint": 8,
            "smallint": 1024,
            "int": 12345,
            "float": 2.5,
            "real": 5.5,

            "date": ("value": 2015-01-01),
            "time": ("value": 12:45,),
            "datetime": 2015-01-01T12:45:00.450,
            "smalldatetime": 2015-01-01T12:45,

            # fake timestamp column for cop_trunc_date
            "timestamp": (
                "type": "datetime",
                "value": 2016-02-11T09:26:14.500,
                # note: The SQL Server datetime type only has a 1/300 ms (~3.33̅ ms) resolution
            ),

            "varbinary": <bead>,

            "image": <bead>,
        );
    }

    constructor() : SqlTestBase("FreetdsTest", "1.0", \ARGV, MyOpts) {
        Datasource ds;
        try {
            ds = getDatasource();
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose)
                printf("%s: %s\n", ex.err, ex.desc);
            # skip tests if we can't create the datasource
        }

        if (ds) {
            initTestData(CustomColumns);

            { # Make sure the DB is clear before doing the tests.
                FreetdsTable t = new FreetdsTable(ds, "sqlutil_test");
                if (t.checkExistence())
                    t.dropCommit();
            }

            # create the test schema
            schema = new FreetdsTestSchema(ds);

            schema.align(False, m_options.verbose, m_options.verbose > 0);

            # get table object
            table = (new Table(schema.getDatasource(), "sqlutil_test")).getTable();

            addTestCase("analytic/window functions", \testAnalyticFunctions());
            addTestCase("range partition lifecycle", \rangePartitionLifecycleTest());
            addTestCase("partition switch", \partitionExchangeTest());
            addTestCase("create as select", \createAsSelectTest());
            addTestCase("drop table options", \dropTableOptionsTest());
        }

        set_return_value(main());
    }

    private cleanupDropOptionsTest(AbstractDatasource ds) {
        string schema = ds.selectRow("select schema_name() as \"schema\"").schema;
        ds.execRaw(sprintf("if object_id('%s.mssql_drop_options_test', 'U') is not null "
            "drop table %s.mssql_drop_options_test", schema, schema));
        ds.commit();
    }

    private dropTableOptionsTest() {
        if (!table) {
            testSkip("no DB connection");
        }

        AbstractDatasource ds = table.getDatasource();
        if ((new MssqlTable(ds, "mssql_drop_options_probe")).is_sybase) {
            testSkip("SQL Server DROP TABLE IF EXISTS test is not supported on Sybase");
        }

        cleanupDropOptionsTest(ds);
        on_exit {
            try {
                cleanupDropOptionsTest(ds);
            } catch (hash<ExceptionInfo> ex) {
            }
        }

        ds.execRaw("create table mssql_drop_options_test (id int not null)");
        ds.commit();

        MssqlTable t(ds, "mssql_drop_options_test");
        softlist<auto> sql = t.getDropSql({"if_exists": True});
        assertEq(1, sql.size());
        assertTrue(sql[0] =~ /^drop table if exists .*mssql_drop_options_test$/i);
        t.dropCommit({"if_exists": True});
        assertEq(False, t.checkExistence());

        assertEq((), t.getDropSql({"if_exists": True}));
        t.dropCommit({"if_exists": True});

        ds.execRaw("create table mssql_drop_options_test (id int not null)");
        ds.commit();
        MssqlTable t2(ds, "mssql_drop_options_test");
        assertThrows("OPTION-ERROR", "cascade table drop options",
            sub() {
                t2.getDropSql({"cascade": True});
            });
    }

    private cleanupCreateAsSelectTest(AbstractDatasource ds) {
        string schema = ds.selectRow("select schema_name() as \"schema\"").schema;
        foreach string name in (("mssql_ctas_dst", "mssql_ctas_src")) {
            ds.execRaw(sprintf("if object_id('%s.%s', 'U') is not null drop table %s.%s",
                schema, name, schema, name));
        }
        ds.commit();
    }

    private createAsSelectTest() {
        if (!table) {
            testSkip("no DB connection");
        }

        AbstractDatasource ds = table.getDatasource();
        if ((new MssqlTable(ds, "mssql_ctas_probe")).is_sybase) {
            testSkip("SQL Server SELECT INTO CTAS test is not supported on Sybase");
        }

        cleanupCreateAsSelectTest(ds);
        on_exit {
            try {
                cleanupCreateAsSelectTest(ds);
            } catch (hash<ExceptionInfo> ex) {
            }
        }

        ds.execRaw("create table mssql_ctas_src (id int not null, name varchar(100) not null, amount int not null)");
        ds.execRaw("insert into mssql_ctas_src values (1, 'a', 10), (2, 'b', 20), (3, 'c', 30)");
        ds.commit();

        AbstractTable source = AbstractTable::getTable(ds, "mssql_ctas_src");
        AbstractTable target = AbstractTable::getTable(ds, "mssql_ctas_dst");
        hash<SqlResultInfo> info = target.getCreateAsSelectSqlWithInfo(source, {
            "columns": ("id", "name"),
            "where": {"amount": op_gt(10)},
        });
        assertTrue(info.sql =~ /^select .* into .*mssql_ctas_dst from /i);
        assertEq(1, info.args.size());
        assertEq(10, info.args[0]);

        info = target.createAsSelectWithInfo(source, {
            "columns": ("id", "name"),
            "where": {"amount": op_gt(10)},
        });
        assertTrue(info.sql =~ /^select .* into .*mssql_ctas_dst from /i);

        AbstractTable materialized = AbstractTable::getTable(ds, "mssql_ctas_dst");
        assertEq(2, materialized.rowCount());
        hash<auto> rows = materialized.select({"columns": ("id", "name"), "orderby": "id"});
        assertEq((2, 3), rows.id);
        assertEq(("b", "c"), rows.name);
    }

    private cleanupRangePartitionLifecycleTest(AbstractDatasource ds) {
        string schema = ds.selectRow("select schema_name() as \"schema\"").schema;
        string suffix = regex_subst(schema + "_mssql_partition_test", "[^A-Za-z0-9_]", "_", RE_Global);
        ds.execRaw(sprintf("if object_id('%s.mssql_partition_test', 'U') is not null "
            "drop table %s.mssql_partition_test", schema, schema));
        ds.execRaw(sprintf("if exists (select 1 from sys.partition_schemes where name = 'qore_ps_%s') "
            "drop partition scheme qore_ps_%s", suffix, suffix));
        ds.execRaw(sprintf("if exists (select 1 from sys.partition_functions where name = 'qore_pf_%s') "
            "drop partition function qore_pf_%s", suffix, suffix));
        ds.commit();
    }

    private rangePartitionLifecycleTest() {
        if (!table) {
            testSkip("no DB connection");
        }

        AbstractDatasource ds = table.getDatasource();
        AbstractTable probe = AbstractTable::getTable(ds, "mssql_partition_test");
        if (!probe.supportsPartitions()) {
            testSkip("SQL Server partition lifecycle support requires SQL Server 2016 or newer");
        }

        cleanupRangePartitionLifecycleTest(ds);
        on_exit {
            try {
                cleanupRangePartitionLifecycleTest(ds);
            } catch (hash<ExceptionInfo> ex) {
            }
        }

        AbstractTable regular_clustered = AbstractTable::getTable(ds, "mssql_regular_clustered");
        regular_clustered.setupTable({
            "columns": {"id": {"qore_type": Type::Int, "notnull": True}},
            "indexes": {"mssql_regular_clustered_uk": {
                "columns": "id", "unique": True, "method": "clustered",
            }},
        });
        assertTrue(regular_clustered.getCreateSqlString() =~ /create unique clustered index/i,
            "nonpartitioned unique clustered index remains supported");

        AbstractTable bad_clustered = AbstractTable::getTable(ds, "mssql_partition_bad_clustered");
        bad_clustered.setupTable({
            "columns": {
                "id": {"qore_type": Type::Int, "notnull": True},
                "d": {"native_type": "datetime2", "notnull": True},
            },
            "indexes": {"mssql_partition_bad_clustered_uk": {
                "columns": "id", "unique": True, "method": "clustered",
            }},
            "partition_strategy": {"method": "range", "columns": "d"},
            "partitions": {"pmax": {"bound_from": "2026-01-01", "bound_to": "2026-02-01"}},
        });
        assertThrows("OPTION-ERROR", "must include partition column", sub () {
            bad_clustered.getCreateSql();
        });

        # SQL Server accepts nonaligned unique keys that omit the partition column.  Materialize this mode first;
        # partition-level TRUNCATE requires every index to be aligned, so the lifecycle table below is recreated
        # with aligned keys after this independent DDL check.
        AbstractTable nonaligned = AbstractTable::getTable(ds, "mssql_partition_test");
        nonaligned.setupTable({
            "columns": {
                "id": {"qore_type": Type::Int, "notnull": True},
                "d": {"native_type": "datetime2", "notnull": True},
                "v": {"qore_type": Type::String, "size": 20},
            },
            "primary_key": {"name": "mssql_partition_test_pk", "columns": "id"},
            "indexes": {"mssql_partition_test_uk": {"columns": ("id", "v"), "unique": True}},
            "unique_constraints": {"mssql_partition_test_uc": {"columns": "v"}},
            "partition_strategy": {"method": "range", "columns": "d"},
            "partitions": {
                "p1": {"name": "p1", "bound_from": "2026-01-01", "bound_to": "2026-02-01"},
                "p2": {"name": "p2", "bound_from": "2026-02-01", "bound_to": "2026-03-01"},
            },
        });
        list<auto> create_sql = nonaligned.getCreateSql();
        string all_create_sql = create_sql.join("\n");
        assertTrue(all_create_sql =~ /primary key nonclustered\s*\(id\) on \[primary\]/i,
            "nonaligned primary key is explicitly nonclustered: " + all_create_sql);
        assertTrue(all_create_sql =~ /create unique index mssql_partition_test_uk on mssql_partition_test \(id, v\) on \[primary\]/i,
            "nonaligned unique index uses a regular filegroup");
        assertTrue(all_create_sql =~ /constraint mssql_partition_test_uc unique\s+\(v\) on \[primary\]/i,
            "nonaligned unique constraint uses a regular filegroup");
        nonaligned.createCommit();
        AbstractTable nonaligned_rt = AbstractTable::getTable(ds, "mssql_partition_test");
        assertTrue(nonaligned_rt.getIndexes().hasKey("mssql_partition_test_uk"),
            "nonaligned unique index is materialized");
        assertTrue(nonaligned_rt.getConstraints().hasKey("mssql_partition_test_uc"),
            "nonaligned unique constraint is materialized");
        nonaligned_rt.dropCommit();

        AbstractTable t = AbstractTable::getTable(ds, "mssql_partition_test");
        t.setupTable({
            "columns": {
                "id": {"qore_type": Type::Int, "notnull": True},
                "d": {"native_type": "datetime2", "notnull": True},
                "v": {"qore_type": Type::String, "size": 20},
            },
            "primary_key": {"name": "mssql_partition_test_pk", "columns": ("id", "d")},
            "indexes": {"mssql_partition_test_aligned_uk": {"columns": ("d", "id"), "unique": True}},
            "unique_constraints": {"mssql_partition_test_aligned_uc": {"columns": ("d", "v")}},
            "partition_strategy": {"method": "range", "columns": "d"},
            "partitions": {
                "p1": {"name": "p1", "bound_from": "2026-01-01", "bound_to": "2026-02-01"},
                "p2": {"name": "p2", "bound_from": "2026-02-01", "bound_to": "2026-03-01"},
            },
        });
        create_sql = t.getCreateSql();
        assertTrue(create_sql[0] =~ /create partition function/i);
        assertTrue(create_sql[0] =~ /as range right/i);
        all_create_sql = create_sql.join("\n");
        assertTrue(all_create_sql =~ /create unique index mssql_partition_test_aligned_uk.*on qore_ps_/i,
            "unique index containing the partition key is aligned");
        assertTrue(all_create_sql =~ /constraint mssql_partition_test_aligned_uc unique.*on qore_ps_/i,
            "unique constraint containing the partition key is aligned");
        t.createCommit();

        AbstractTable rt = AbstractTable::getTable(ds, "mssql_partition_test");
        assertEq(True, rt.supportsPartitions());
        assertEq(False, rt.supportsPartitionDetach());
        assertEq(False, rt.supportsConcurrentPartitionDetach());

        hash<PartitionStrategy> strategy = rt.getPartitionStrategy();
        assertEq("range", strategy.method);
        assertEq(1, strategy.columns.size());
        assertEq("d", strategy.columns[0]);

        hash<string, PartitionInfo> parts = rt.listPartitions();
        assertEq(2, parts.size());
        assertEq(2026-02-01, parts.p2.bound_from);
        assertEq(2026-03-01, parts.p2.bound_to);
        assertEq(3, parts.p2.driver.mssql.partition_number);

        hash<auto> desc = rt.getDescriptionHash({"with_partitions": True});
        assertEq(2, desc.partitions.size());
        assertFalse(desc.partitions.p2.hasKey("ordinal"));
        assertFalse(desc.partitions.p2.hasKey("sql_name"));
        assertFalse(desc.partitions.p2.driver.mssql.hasKey("partition_number"));
        assertFalse(desc.partitions.p2.driver.mssql.hasKey("lower_boundary_id"));
        assertFalse(desc.partitions.p2.driver.mssql.hasKey("upper_boundary_id"));
        assertEq(strategy.driver.mssql.partition_function,
            desc.partitions.p2.driver.mssql.partition_function);
        assertEq(strategy.driver.mssql.partition_scheme, desc.partitions.p2.driver.mssql.partition_scheme);

        assertEq((), rt.getAlignSql(t), "generated partition object names align with the creation schema");
        AbstractTable reverse_template = AbstractTable::getTable(ds, "mssql_partition_test");
        reverse_template.setupTable(desc);
        assertEq((), rt.getAlignSql(reverse_template), "reverse-engineered partition schema aligns unchanged");

        hash<auto> changed_strategy_desc = {} + desc;
        changed_strategy_desc.partition_strategy = {} + desc.partition_strategy;
        changed_strategy_desc.partition_strategy.driver = {
            "mssql": {
                "partition_function": "different_partition_function",
                "partition_scheme": strategy.driver.mssql.partition_scheme,
            },
        };
        assertEq("different_partition_function",
            changed_strategy_desc.partition_strategy.driver.mssql.partition_function,
            "changed SQL Server partition function is present in the input description");
        AbstractTable changed_strategy = AbstractTable::getTable(ds, "mssql_partition_test");
        changed_strategy.setupTable(changed_strategy_desc);
        assertEq("different_partition_function",
            changed_strategy.getPartitionStrategy().driver.mssql.partition_function,
            "changed SQL Server partition function reaches the normalized strategy");
        assertThrows("PARTITION-ERROR", "normalized desired", sub () {
            rt.getAlignSql(changed_strategy);
        });
        assertThrows("PARTITION-ERROR", "does not support generic default partitions", sub () {
            rt.getAddPartitionSql({"name": "pmax", "is_default": True});
        });

        hash<PartitionLookupResult> lookup = rt.findPartitionBySpec({
            "bound_from": 2026-02-01,
            "bound_to": 2026-03-01,
        });
        assertEq(PartitionLookupStatus::Found, lookup.status);
        assertEq("p2", lookup.partition.name);

        hash<PartitionEnsureResult> ensure = rt.ensurePartitionCommit({
            "name": "p3",
            "bound_from": 2026-03-01,
            "bound_to": 2026-04-01,
        });
        assertEq(True, ensure.created);
        assertEq(True, ensure.materialized);
        assertEq(PartitionVerifiedBy::Bounds, ensure.verified_by);
        assertEq(True, rt.listPartitions().hasKey("p3"));

        ds.execRaw("insert into mssql_partition_test values (3, cast('2026-03-15' as datetime2), 'x')");
        ds.commit();
        assertEq(1, ds.selectRow("select count(*) c from mssql_partition_test where d >= cast('2026-03-01' "
            "as datetime2) and d < cast('2026-04-01' as datetime2)").c);
        string truncate_sql = rt.getTruncatePartitionSql({"bound_from": 2026-03-01, "bound_to": 2026-04-01});
        assertTrue(truncate_sql =~ /with \(partitions \([0-9]+\)\)/i);
        rt.truncatePartitionCommit({"bound_from": 2026-03-01, "bound_to": 2026-04-01});
        assertEq(0, ds.selectRow("select count(*) c from mssql_partition_test where d >= cast('2026-03-01' "
            "as datetime2) and d < cast('2026-04-01' as datetime2)").c);

        rt.dropPartitionCommit({"bound_from": 2026-03-01, "bound_to": 2026-04-01});
        assertEq(False, rt.listPartitions().hasKey("p3"));

        AbstractTable racer = AbstractTable::getTable(ds, "mssql_partition_test");
        racer.listPartitions();
        rt.ensurePartitionCommit({"name": "p3", "bound_from": 2026-03-01, "bound_to": 2026-04-01});
        hash<PartitionEnsureResult> raced = racer.ensurePartitionCommit({
            "name": "p3",
            "bound_from": 2026-03-01,
            "bound_to": 2026-04-01,
        });
        assertEq(False, raced.created, "ensurePartition() race resolves the duplicate without creating");
        assertEq(True, raced.materialized, "ensurePartition() race resolves to a materialized partition");
        rt.dropPartitionCommit("p3");

        assertThrows("PARTITION-NOT-SUPPORTED", "does not support detaching partitions",
            sub() {
                rt.detachPartition("p2");
            });

        AbstractTable bad = AbstractTable::getTable(ds, "mssql_partition_test_bad");
        assertThrows("DESCRIPTION-ERROR", "composite partition key",
            sub() {
                bad.setupTable({
                    "columns": {
                        "id": {"qore_type": Type::Int, "notnull": True},
                        "d": {"native_type": "datetime2", "notnull": True},
                    },
                    "primary_key": {"name": "mssql_partition_test_bad_pk", "columns": ("id", "d")},
                    "partition_strategy": {"method": "range", "columns": ("id", "d")},
                    "partitions": {
                        "p1": {"name": "p1", "bound_from": 1, "bound_to": 2},
                    },
                });
            });
    }

    private cleanupPartitionExchangeTest(AbstractDatasource ds) {
        string schema = ds.selectRow("select schema_name() as \"schema\"").schema;
        foreach string table_name in (("mssql_partition_exchange_target", "mssql_partition_exchange")) {
            ds.execRaw(sprintf("if object_id('%s.%s', 'U') is not null drop table %s.%s",
                schema, table_name, schema, table_name));
        }
        string suffix = regex_subst(schema + "_mssql_partition_exchange", "[^A-Za-z0-9_]", "_", RE_Global);
        ds.execRaw(sprintf("if exists (select 1 from sys.partition_schemes where name = 'qore_ps_%s') "
            "drop partition scheme qore_ps_%s", suffix, suffix));
        ds.execRaw(sprintf("if exists (select 1 from sys.partition_functions where name = 'qore_pf_%s') "
            "drop partition function qore_pf_%s", suffix, suffix));
        ds.commit();
    }

    private partitionExchangeTest() {
        if (!table) {
            testSkip("no DB connection");
        }

        AbstractDatasource ds = table.getDatasource();
        AbstractTable probe = AbstractTable::getTable(ds, "mssql_partition_exchange");
        if (!probe.supportsPartitions()) {
            testSkip("SQL Server partition switch support requires SQL Server 2016 or newer");
        }

        cleanupPartitionExchangeTest(ds);
        on_exit cleanupPartitionExchangeTest(ds);

        hash<auto> columns = {
            "id": {"qore_type": Type::Int, "notnull": True},
            "d": {"native_type": "datetime2", "notnull": True},
            "v": {"qore_type": Type::String, "size": 20},
        };
        AbstractTable source = AbstractTable::getTable(ds, "mssql_partition_exchange");
        source.setupTable({
            "columns": columns,
            "partition_strategy": {"method": "range", "columns": "d"},
            "partitions": {
                "p1": {"bound_from": 2026-01-01, "bound_to": 2026-02-01},
                "p2": {"bound_from": 2026-02-01, "bound_to": 2026-03-01},
            },
        });
        source.createCommit();

        AbstractTable target = AbstractTable::getTable(ds, "mssql_partition_exchange_target");
        target.setupTable({"columns": columns});
        target.createCommit();

        AbstractTable actual_source = AbstractTable::getTable(ds, "mssql_partition_exchange");
        AbstractTable actual_target = AbstractTable::getTable(ds, "mssql_partition_exchange_target");
        assertTrue(actual_source.supportsPartitionExchange(), "SQL Server supports partition switch");
        actual_source.validateTableShape(actual_target);

        ds.execRaw("insert into mssql_partition_exchange values (2, cast('2026-02-15' as datetime2), 'source')");
        ds.commit();

        string sql = actual_source.getExchangePartitionSql({
            "bound_from": 2026-02-01,
            "bound_to": 2026-03-01,
        }, actual_target);
        assertTrue(sql =~ /alter table .*mssql_partition_exchange switch partition 3 to .*mssql_partition_exchange_target$/i,
            "SQL Server switch SQL uses the resolved physical partition number");
        assertThrows("OPTION-ERROR", "cannot disable validation", sub () {
            actual_source.getExchangePartitionSql("p2", actual_target, {"validate": False});
        });

        int executing_callback_count;
        actual_source.exchangePartitionCommit("p2", actual_target, {
            "sql_callback": sub (string callback_sql) {
                ++executing_callback_count;
                ds.execRaw(callback_sql);
            },
            "sql_callback_executed": True,
        });
        assertEq(1, executing_callback_count,
            "executing SQL Server switch callback is invoked exactly once without duplicate execution");
        assertEq(0, ds.selectRow("select count(*) c from mssql_partition_exchange where "
            "d >= cast('2026-02-01' as datetime2) and d < cast('2026-03-01' as datetime2)").c,
            "SQL Server switch leaves the source partition empty");
        assertEq("source", actual_target.selectRow().v,
            "SQL Server switch moves the partition rows to the standalone table");

        assertThrows("PARTITION-ERROR", "must be empty", sub () {
            actual_source.getExchangePartitionSql("p2", actual_target);
        });

        AbstractTable bad_target = AbstractTable::getTable(ds, "mssql_partition_exchange_bad");
        bad_target.setupTable({"columns": columns + {"v": {"qore_type": Type::String, "size": 21}}});
        assertThrows("PARTITION-ERROR", "not storage-compatible", sub () {
            actual_source.getExchangePartitionSql("p2", bad_target);
        });
        assertThrows("PARTITION-ERROR", "cannot be exchanged with its parent", sub () {
            actual_source.getExchangePartitionSql("p2", actual_source);
        });
        assertThrows("OPTION-ERROR", "unknown key", sub () {
            actual_source.getExchangePartitionSql("p2", actual_target, {"unsupported": True});
        });

        Datasource other_ds = getDatasource();
        AbstractTable other_target = AbstractTable::getTable(other_ds, "mssql_partition_exchange_target");
        assertThrows("DATASOURCE-ERROR", "same AbstractDatasource object", sub () {
            actual_source.getExchangePartitionSql("p2", other_target);
        });
    }

    private string getResultSetSql() {
        testSkip("does not support result set output binds");
        return "";
    }

    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-c,--conn=ARG", "set DB connection argument (ex: \"freetds:user/pass@db\")", OptionColumn);
    }

    Datasource getDatasource() {
        if (!m_options.connstr)
            m_options.connstr = ENV.QORE_DB_CONNSTR_FREETDS;
        Datasource ds(m_options.connstr);
        if (ds.getDriverName() != "freetds")
            throw "FREETDS-ERROR", sprintf("cannot execute the freetds tests on a connection using driver %y", ds.getDriverName());
        ds.open();
        return ds;
    }
}
