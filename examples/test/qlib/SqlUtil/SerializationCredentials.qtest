#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - SQLite3 database driver connections of serialized and restored SqlUtil tables
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../TestInterpreter.qm
%requires SqlUtil
%requires Sqlite3SqlUtil

%try-module sqlite3
%define NoSqlite3
%endtry

%exec-class SerializationCredentialsTest

#! serialized SqlUtil objects keep no credentials of their datasource (qore#7016)
/** The default serializer keeps the masked configuration of the datasource; a datasource is restored by a registered
    deserializer, from the configuration of data of an earlier version, or by a registered credential resolver, and
    otherwise \c DATASOURCE-DESERIALIZATION-ERROR names the masked datasource.  The serialized data and the errors
    are searched for each credential: the password and the user name.
*/
class SerializationCredentialsTest inherits QUnit::Test {
    public {
        #! the user name of the datasource
        const User = "scott-user-7016";
        #! the password of the datasource
        const Pass = "tiger-pass-7016";
    }

    private {
        TmpDir dir;
    }

    constructor() : QUnit::Test("SqlUtil serialization credentials", "1.0", \ARGV) {
        dir = new TmpDir("sqlutil-serialization-credentials-");
        addTestCase("serialized data has no credentials", \noCredentialsTest());
        addTestCase("a pool is serialized without credentials", \poolTest());
        addTestCase("without a credential source the error names the masked datasource", \noSourceTest());
        addTestCase("a credential resolver gives the credentials", \resolverTest());
        addTestCase("a resolver that returns no configuration", \badResolverTest());
        addTestCase("a registered deserializer gets no credentials", \deserializerTest());
        addTestCase("a credential resolver is used before a registered deserializer", \resolverFirstTest());
        addTestCase("a registered deserializer gets the string of data of an earlier version",
            \legacyDeserializerTest());
        addTestCase("data of an earlier version is restored and serialized without its credentials", \legacyTest());
        addTestCase("the resolver is registered by code that may control the process", \registrationTest());
        addTestCase("a datasource of a named connection is restored by its name", \connectionTest());
        addTestCase("restricted code cannot relabel a datasource that it is lent", \relabelTest());
        set_return_value(main());
    }

    noCredentialsTest() {
        Datasource ds = datasource("nc");
        on_exit ds.close();
        hash<auto> data = table(ds).serializeToData();
        checkNoCredentials(sprintf("%N", data), "serialized data");
        checkNoCredentials(table(ds).serialize().toString(), "serialized binary");
    }

    poolTest() {
        DatasourcePool pool(config("pool") + {"options": {"min": 1, "max": 2}});
        on_exit delete pool;
        hash<auto> data = table(pool).serializeToData();
        checkNoCredentials(sprintf("%N", data), "serialized pool");
        # the option values of the pool are masked: an option of a driver can hold a credential
        string s = sprintf("%N", data);
        assertNeq(-1, s.find("min : \"****\""), s);
        assertNeq(-1, s.find("max : \"****\""), s);
    }

    noSourceTest() {
        Datasource ds = datasource("ns");
        on_exit ds.close();
        binary data = table(ds).serialize();
        try {
            Serializable::deserialize(data);
            assertTrue(False, "deserialization without credentials must fail");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("DATASOURCE-DESERIALIZATION-ERROR", ex.err);
            # the error names the masked datasource, with its database
            assertNeq(-1, ex.desc.find("sqlite3:****/****@" + dbPath("ns")), ex.desc);
            checkNoCredentials(ex.desc, "error");
        }
    }

    resolverTest() {
        Datasource ds = datasource("rs");
        on_exit ds.close();
        binary data = table(ds).serialize();
        list<hash<auto>> calls = ();
        sqlutil_register_ds_credential_resolver(hash<auto> sub (string type, hash<auto> masked) {
            calls += {"type": type, "masked": masked};
            return config("rs");
        });
        on_exit sqlutil_register_ds_credential_resolver();
        AbstractTable restored = Serializable::deserialize(data);
        assertEq("t7016", restored.getName());
        assertEq(1, restored.getDatasource().selectRow("select 1 as value").value);
        assertEq(User, restored.getDatasource().getUserName());
        assertTrue(calls.size() > 0);
        assertEq("Datasource", calls[0].type);
        assertEq("sqlite3", calls[0].masked.type);
        assertEq("****", calls[0].masked.user);
        assertEq(dbPath("rs"), calls[0].masked.db);
        assertFalse(calls[0].masked.hasKey("pass"));
        restored.getDatasource().close();
    }

    badResolverTest() {
        Datasource ds = datasource("br");
        on_exit ds.close();
        binary data = table(ds).serialize();
        sqlutil_register_ds_credential_resolver(auto sub (string type, hash<auto> masked) {
            return 1;
        });
        on_exit sqlutil_register_ds_credential_resolver();
        assertThrows("DATASOURCE-DESERIALIZATION-ERROR", \Serializable::deserialize(), data);
    }

    deserializerTest() {
        Datasource ds = datasource("ds");
        on_exit ds.close();
        binary data = table(ds).serialize();
        list<string> configs = ();
        sqlutil_register_ds_deserializer(AbstractDatasource sub (string type, string ds_string) {
            configs += ds_string;
            return new Datasource(config("ds"));
        });
        on_exit sqlutil_register_ds_deserializer();
        AbstractTable restored = Serializable::deserialize(data);
        assertEq("t7016", restored.getName());
        assertTrue(configs.size() > 0);
        # never masked credentials, which it could use to log in: the empty string
        assertEq(SqlUtilNoCredentials, configs[0]);
        assertEq("", configs[0]);
        restored.getDatasource().close();
    }

    resolverFirstTest() {
        Datasource ds = datasource("rf");
        on_exit ds.close();
        binary data = table(ds).serialize();
        int deserializer_calls = 0;
        sqlutil_register_ds_deserializer(AbstractDatasource sub (string type, string ds_string) {
            ++deserializer_calls;
            return new Datasource(config("rf"));
        });
        on_exit sqlutil_register_ds_deserializer();
        int resolver_calls = 0;
        sqlutil_register_ds_credential_resolver(hash<auto> sub (string type, hash<auto> masked) {
            ++resolver_calls;
            return config("rf");
        });
        on_exit sqlutil_register_ds_credential_resolver();
        AbstractTable restored = Serializable::deserialize(data);
        assertEq(1, restored.getDatasource().selectRow("select 1 as value").value);
        assertTrue(resolver_calls > 0);
        assertEq(0, deserializer_calls);
        cast<Datasource>(restored.getDatasource()).close();
    }

    # data of an earlier version keeps its string for a registered deserializer, as before
    legacyDeserializerTest() {
        Datasource ds = datasource("ld");
        on_exit ds.close();
        sqlutil_register_ds_serializer(hash<auto> sub (AbstractDatasource source) {
            return {
                "ds_type": "Datasource",
                "ds": source.getConfigString(),
                "ds_config": source.getConfigHash(),
            };
        });
        binary data;
        {
            on_exit sqlutil_register_ds_serializer();
            data = table(ds).serialize();
        }
        list<string> configs = ();
        sqlutil_register_ds_deserializer(AbstractDatasource sub (string type, string ds_string) {
            configs += ds_string;
            return new Datasource(ds_string);
        });
        on_exit sqlutil_register_ds_deserializer();
        AbstractTable restored = Serializable::deserialize(data);
        assertEq(ds.getConfigString(), configs[0]);
        cast<Datasource>(restored.getDatasource()).close();
    }

    # data that the default serializer of an earlier version made: the configuration with its credentials
    legacyTest() {
        Datasource ds = datasource("lg");
        on_exit ds.close();
        sqlutil_register_ds_serializer(hash<auto> sub (AbstractDatasource source) {
            return {
                "ds_type": "Datasource",
                "ds": source.getConfigString(),
                "ds_config": source.getConfigHash(),
            };
        });
        binary data;
        {
            on_exit sqlutil_register_ds_serializer();
            data = table(ds).serialize();
        }
        assertNeq(-1, data.toString().find(Pass), "the legacy data has the password");
        AbstractTable restored = Serializable::deserialize(data);
        assertEq(1, restored.getDatasource().selectRow("select 1 as value").value);
        # the restored object is serialized again without the credentials
        checkNoCredentials(sprintf("%N", restored.serializeToData()), "serialized again");
        restored.getDatasource().close();
    }

    registrationTest() {
        Program p(PO_NEW_STYLE | PO_NO_PROCESS_CONTROL);
        p.loadModule("SqlUtil");
        assertThrows("PARSE-EXCEPTION", \p.parse(), ("sub t() { sqlutil_register_ds_credential_resolver(); }",
            "registration"));
    }

    # the restore by connection name runs in a process of its own, with the connection provider of this test in its
    # environment, which the connection registry reads
    connectionTest() {
%ifdef NoSqlite3
        testSkip("the sqlite3 module is not available");
%endif
        # the output is compared; the error output (warnings, an exception) is shown if it differs
        string err_file = dir.path + "/connection.err";
        string cmd = sprintf("QORE_CONNECTION_PROVIDERS=%s SQLUTIL_7016_DB=%s %s %s 2>%s",
            get_script_dir() + "/SerializationCredentialsProvider.qm", dbPath("conn"),
            TestInterpreter::qore_interpreter(), get_script_dir() + "/SerializationCredentialsConnection.q", err_file);
        string out = backquote(cmd);
        string err = is_file(err_file) ? ReadOnlyFile::readTextFile(err_file) : "";
        assertEq("name: conn7016\n"
            "password in data: False\n"
            "user in data: False\n"
            "masked config in data: False\n"
            "name in data: True\n"
            "restored: t7016 conn7016 1\n"
            "restored pool: DatasourcePool conn7016\n"
            "not a datasource connection: DATASOURCE-DESERIALIZATION-ERROR: True\n", out, "error output: " + err);
    }

    # a datasource that has a connection name keeps it: code that it is lent to cannot relabel it as another
    # connection, also code that may use databases; code restricted from databases cannot set a name at all
    relabelTest() {
        Datasource ds = datasource("rl");
        on_exit ds.close();
        ds.setConnectionName("orders");
        Program p(PO_NEW_STYLE | PO_NO_THREAD_CONTROL | PO_NO_PROCESS_CONTROL);
        p.parse('string sub relabel(Datasource ds) {
    try {
        ds.setConnectionName("payroll");
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
    return "relabeled";
}', "relabel");
        assertEq("DATASOURCE-CONNECTION-NAME-ERROR", p.callFunction("relabel", ds));
        assertEq("orders", ds.getConnectionName());
        # setting the same name again changes nothing, also in another encoding
        ds.setConnectionName("orders");
        ds.setConnectionName(convert_encoding("orders", "ISO-8859-1"));
        assertEq("orders", ds.getConnectionName());
        assertThrows("DATASOURCE-CONNECTION-NAME-ERROR", \ds.setConnectionName(), "");
        # code restricted from databases cannot name a datasource that it is lent, also one without a name
        Datasource unnamed = datasource("rl2");
        on_exit unnamed.close();
        Program np(PO_NEW_STYLE | PO_NO_DATABASE);
        np.parse('string sub relabel(object ds) {
    try {
        ds.setConnectionName("x");
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
    return "set";
}', "relabel");
        assertEq("INVALID-FUNCTION-ACCESS", np.callFunction("relabel", unnamed));
        assertNothing(unnamed.getConnectionName());
    }

    private string dbPath(string name) {
        return dir.path + "/" + name + ".db";
    }

    private hash<auto> config(string name) {
        return {"type": "sqlite3", "user": User, "pass": Pass, "db": dbPath(name)};
    }

    private Datasource datasource(string name) {
%ifdef NoSqlite3
        testSkip("the sqlite3 module is not available");
%endif
        Datasource ds(config(name));
        ds.open();
        return ds;
    }

    private Sqlite3Table table(AbstractDatasource ds) {
%ifdef NoSqlite3
        testSkip("the sqlite3 module is not available");
%endif
        Sqlite3Table t(ds, "t7016");
        t.setupTable({"columns": {"id": {"qore_type": "integer", "notnull": True}}});
        return t;
    }

    private checkNoCredentials(string s, string label) {
        assertEq(-1, s.find(Pass), label + ": no password");
        assertEq(-1, s.find(User), label + ": no user name");
    }
}
