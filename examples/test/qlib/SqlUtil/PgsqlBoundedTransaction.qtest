#!/usr/bin/env qore
# Copyright 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires SqlUtil
%requires json
%try-module pgsql
%define NoPgsql
%endtry
%exec-class BoundedTransactionTest

class BoundedTransactionTest inherits QUnit::Test {
    private { int serial; }

    constructor() : Test("database-enforced transaction limits", "1.0", \ARGV) {
        addTestCase("capability, arguments and transaction ownership", \contract());
        addTestCase("commit and rollback restore session defaults", \settings());
        addTestCase("stricter caller settings remain effective", \stricter());
        addTestCase("pooled borrowers do not inherit transaction limits", \pool());
        addTestCase("blocked writer times out without changing either owner", \lockWait());
        addTestCase("statement timeout rolls back preceding writes", \statement());
        addTestCase("whole transaction deadline covers multiple short statements", \transaction());
        addTestCase("maintenance uses fresh snapshots and restores isolation and access defaults", \maintenance());
        addTestCase("maintenance refuses policy-hidden rows without bypassing row security", \visibility());
        addTestCase("maintenance settings do not leak to the next pooled borrower", \maintenancePool());
        addTestCase("maintenance setup rejection rolls back partial transaction settings", \maintenanceFailure());
        addTestCase("maintenance setup and writes preserve the caller mutation declaration", \maintenanceDeclaration());
        set_return_value(main());
    }

    private Datasource connection(bool supported = True) {
%ifdef NoPgsql
        testSkip("pgsql module is unavailable");
%endif
        *string dsn = ENV.QORE_DB_CONNSTR_PGSQL;
        if (!dsn) { testSkip("set QORE_DB_CONNSTR_PGSQL to a disposable test database"); }
        Datasource ds(dsn);
        ds.open();
        ds.setAutoCommit(False);
        if (supported && ds.getServerVersion() < 170000) {
            testSkip("PostgreSQL 17 or later is required for transaction_timeout");
        }
        return ds;
    }

    private hash<auto> fixture(bool supported = True) {
        Datasource ds = connection(supported);
        string name = sprintf("bounded_tx_%d_%d", getpid(), ++serial);
        AbstractTable table = (new Table(ds, {
            "columns": {"id": {"qore_type": "number", "size": 10, "notnull": True},
                "value": {"qore_type": "number", "size": 10, "notnull": True}},
            "primary_key": {"name": name + "_pk", "columns": ("id",)},
        }, name)).getTable();
        table.createCommit();
        on_error {
            ds.rollback();
            table.dropCommit();
        }
        table.insert({"id": 1, "value": 0});
        table.commit();
        return {"ds": ds, "table": table, "name": name};
    }

    private cleanup(hash<auto> f) {
        # A transaction deadline closes its connection. A fresh observer owns cleanup and proves rollback.
        Datasource observer = connection(False);
        AbstractTable table = AbstractTable::getTable(observer, f.name);
        on_exit {
            table.dropCommit();
            assertFalse(table.checkExistence(), "the exact owned fixture table is absent");
            observer.commit();
        }
        f.ds.rollback();
    }

    private static hash<string, int> readSettings(AbstractDatasource ds) {
        hash<auto> row = ds.selectRow(
            "select (select setting::bigint from pg_settings where name = 'lock_timeout') as l, "
            "(select setting::bigint from pg_settings where name = 'statement_timeout') as s, "
            "(select setting::bigint from pg_settings where name = 'transaction_timeout') as t");
        return {"lock_timeout_ms": row.l.toInt(), "statement_timeout_ms": row.s.toInt(),
            "transaction_timeout_ms": row.t.toInt()};
    }

    private contract() {
        hash<auto> f = fixture(False);
        on_exit cleanup(f);
        bool supported = f.ds.getServerVersion() >= 170000;
        assertEq(supported, f.table.supportsBoundedTransactions());
        assertEq(supported, f.table.supportsBoundedMaintenanceTransactions());
        if (!supported) {
            assertThrows("TRANSACTION-LIMIT-NOT-SUPPORTED", sub() {
                f.table.beginBoundedTransaction(50, 100, 500);
            });
            assertFalse(f.ds.currentThreadInTransaction());
            assertThrows("TRANSACTION-LIMIT-NOT-SUPPORTED", sub() {
                f.table.beginBoundedMaintenanceTransaction(50, 100, 500);
            });
            assertFalse(f.ds.currentThreadInTransaction());
            return;
        }
        foreach list<int> limits in (((0, 100, 500), (101, 100, 500), (50, 501, 500), (50, 100, 60001))) {
            assertThrows("OPTION-ERROR", sub() {
                f.table.beginBoundedTransaction(limits[0], limits[1], limits[2]);
            });
            assertFalse(f.ds.currentThreadInTransaction());
            assertThrows("OPTION-ERROR", sub() {
                f.table.beginBoundedMaintenanceTransaction(limits[0], limits[1], limits[2]);
            });
            assertFalse(f.ds.currentThreadInTransaction());
        }
        f.ds.beginTransaction();
        assertThrows("TRANSACTION-ERROR", sub() { f.table.beginBoundedTransaction(50, 100, 500); });
        assertThrows("TRANSACTION-ERROR", sub() { f.table.beginBoundedMaintenanceTransaction(50, 100, 500); });
        assertTrue(f.ds.currentThreadInTransaction(), "rejecting a nested call does not rollback its caller");
        f.ds.rollback();
        f.ds.setAutoCommit(True);
        assertThrows("AUTOCOMMIT-ERROR", sub() { f.table.beginBoundedTransaction(50, 100, 500); });
        assertThrows("AUTOCOMMIT-ERROR", sub() { f.table.beginBoundedMaintenanceTransaction(50, 100, 500); });
        assertTrue(f.ds.getAutoCommit());
        f.ds.setAutoCommit(False);
    }

    private settings() {
        hash<auto> f = fixture();
        on_exit cleanup(f);
        hash<string, int> original = readSettings(f.ds);
        f.ds.commit();
        hash<string, int> effective = f.table.beginBoundedTransaction(100, 1000, 5000);
        assertTrue(f.ds.currentThreadInTransaction());
        assertEq(effective, readSettings(f.ds));
        assertEq(100, effective.lock_timeout_ms);
        assertEq(1000, effective.statement_timeout_ms);
        assertTrue(effective.transaction_timeout_ms > 0 && effective.transaction_timeout_ms <= 5000);
        f.table.update({"value": 1}, {"id": 1});
        f.table.commit();
        assertEq(original, readSettings(f.ds));
        f.ds.commit();
        f.table.beginBoundedTransaction(100, 1000, 5000);
        f.table.update({"value": 2}, {"id": 1});
        f.table.rollback();
        assertEq(original, readSettings(f.ds));
        assertEq(1, f.table.selectRow({"where": {"id": 1}}).value.toInt());
        f.ds.commit();
    }

    private static hash<auto> readModes(AbstractDatasource ds) {
        return ds.selectRow("select current_setting('transaction_isolation') as isolation, "
            "current_setting('transaction_read_only') as read_only, current_setting('row_security') as row_security");
    }

    private maintenance() {
        hash<auto> f = fixture();
        on_exit cleanup(f);
        # These are defaults of this owned connection, not of the database or any serving session.
        f.ds.execRaw("set default_transaction_isolation = 'repeatable read'");
        f.ds.execRaw("set default_transaction_read_only = on");
        f.ds.execRaw("set row_security = on");
        f.ds.execRaw("set lock_timeout = '50ms'");
        f.ds.commit();
        hash<auto> original = readModes(f.ds);
        hash<string, int> original_limits = readSettings(f.ds);
        f.ds.commit();
        assertEq({"isolation": "repeatable read", "read_only": "on", "row_security": "on"}, original);
        hash<string, int> effective = f.table.beginBoundedMaintenanceTransaction(100, 1000, 5000);
        assertEq({"isolation": "read committed", "read_only": "off", "row_security": "off"}, readModes(f.ds));
        assertEq(effective, readSettings(f.ds));
        assertEq(50, effective.lock_timeout_ms, "stricter session lock deadline survives maintenance setup");
        assertEq(0, f.table.selectRow({"where": {"id": 1}}).value.toInt());
        Datasource independent = connection();
        on_exit independent.rollback();
        AbstractTable other = AbstractTable::getTable(independent, f.name);
        other.update({"value": 8}, {"id": 1});
        independent.commit();
        assertEq(8, f.table.selectRow({"where": {"id": 1}}).value.toInt(), "later statements see the independent commit");
        f.table.update({"value": 9}, {"id": 1});
        f.ds.commit();
        assertEq(original, readModes(f.ds));
        assertEq(original_limits, readSettings(f.ds));
        f.ds.commit();
        f.table.beginBoundedMaintenanceTransaction(100, 1000, 5000);
        f.table.update({"value": 10}, {"id": 1});
        f.ds.rollback();
        assertEq(original, readModes(f.ds));
        assertEq(original_limits, readSettings(f.ds));
        assertEq(9, f.table.selectRow({"where": {"id": 1}}).value.toInt());
        f.ds.rollback();
    }

    private visibility() {
        hash<auto> f = fixture();
        on_exit cleanup(f);
        string role = f.name + "_reader";
        # PostgreSQL-specific privilege/policy fixture. Identifiers are locally generated ASCII;
        # the runner owns this database and its roles, and no application credentials are used.
        f.ds.execRaw("create role " + role);
        f.ds.commit();
        on_exit {
            f.ds.rollback();
            f.ds.execRaw("reset role");
            f.ds.execRaw("revoke all on " + f.name + " from " + role);
            f.ds.execRaw("revoke usage on schema public from " + role);
            f.ds.execRaw("drop role " + role);
            f.ds.commit();
        }
        f.ds.execRaw("grant usage on schema public to " + role);
        f.ds.execRaw("grant select on " + f.name + " to " + role);
        f.ds.execRaw("alter table " + f.name + " enable row level security");
        f.ds.execRaw("create policy " + f.name + "_policy on " + f.name + " using (id = 999)");
        f.ds.execRaw("set role " + role);
        f.ds.commit();
        assertEq(0, f.table.selectRows().size(), "the ordinary query silently filters the owned row");
        f.ds.rollback();
        f.table.beginBoundedMaintenanceTransaction(100, 1000, 5000);
        *hash<ExceptionInfo> failure;
        try { f.table.selectRows(); }
        catch (hash<ExceptionInfo> ex) { failure = ex; }
        assertTrue(exists failure, "maintenance cannot certify a policy-filtered empty result");
        assertTrue(make_json(failure).find("42501") >= 0, "PostgreSQL rejects row-security filtering");
        f.ds.rollback();
        assertEq("on", readModes(f.ds).row_security);
        assertEq(0, f.table.selectRows().size(), "the role did not gain permission to see the row");
        f.ds.commit();
        f.ds.execRaw("reset role");
        f.ds.commit();
        assertEq(1, f.table.selectRows().size(), "the fixture owner still sees the original row");
        f.ds.rollback();
    }

    private maintenancePool() {
        hash<auto> f = fixture();
        on_exit cleanup(f);
        hash<auto> config = parse_datasource(ENV.QORE_DB_CONNSTR_PGSQL);
        config.options = (config.options ?? {}) + {"min": 1, "max": 1};
        DatasourcePool pool(config);
        assertEq(1, pool.getMinimum());
        assertEq(1, pool.getMaximum());
        AbstractTable table = AbstractTable::getTable(pool, f.name);
        pool.execRaw("set default_transaction_isolation = 'repeatable read'");
        pool.execRaw("set default_transaction_read_only = on");
        pool.commit();
        hash<auto> original = readModes(pool);
        int original_pid = pool.selectRow("select pg_catalog.pg_backend_pid() as pid").pid.toInt();
        pool.commit();
        table.beginBoundedMaintenanceTransaction(100, 1000, 5000);
        assertEq("off", readModes(pool).row_security);
        table.update({"value": 11}, {"id": 1});
        pool.commit();
        table.beginBoundedMaintenanceTransaction(100, 1000, 5000);
        table.update({"value": 12}, {"id": 1});
        pool.rollback();
        Counter done(1);
        Queue results();
        int tid = background sub() {
            on_exit done.dec();
            on_exit pool.rollback();
            try { results.push({"modes": readModes(pool), "value": table.selectRow().value.toInt(),
                "pid": pool.selectRow("select pg_catalog.pg_backend_pid() as pid").pid.toInt()}); }
            catch (hash<ExceptionInfo> ex) {
                if (ex.err == "THREAD-CANCELLED") { clear_thread_cancel(); }
                results.push({"error": ex.err});
            }
        }();
        on_exit {
            if (done.waitForZero(5s)) {
                cancel_thread(tid, "owned maintenance pool test cleanup");
                if (done.waitForZero(5s)) { throw "TEST-WORKER-ERROR", "maintenance pool worker did not stop"; }
            }
        }
        assertEq(0, done.waitForZero(5s));
        hash<auto> result = results.get(1s);
        assertNothing(result.error);
        assertEq(original_pid, result.pid, "the next thread borrows the same physical PostgreSQL connection");
        assertEq(original, result.modes, "the same connection restores its session defaults in another thread");
        assertEq(11, result.value, "the next borrower sees only the committed maintenance write");
    }

    private maintenanceFailure() {
        hash<auto> f = fixture();
        on_exit cleanup(f);
        f.ds.execRaw("set default_transaction_isolation = 'repeatable read'");
        f.ds.execRaw("set default_transaction_read_only = on");
        f.ds.commit();
        hash<auto> original = readModes(f.ds);
        f.ds.commit();
        int executions = 0;
        f.ds.setMutationObserver(*hash<SqlMutationDecisionInfo> sub(hash<SqlMutationEventInfo> event) {
            if (event.event == SQL_MUTATION_EVENT_PRE_EXEC && ++executions == 2) {
                return <SqlMutationDecisionInfo>{"admit": False, "err": "TEST-MAINTENANCE-SETUP-REJECTED",
                    "desc": "injected second setup rejection"};
            }
        }, SQL_MUTATION_MASK_ALL);
        on_exit f.ds.clearMutationObserver();
        assertThrows("TEST-MAINTENANCE-SETUP-REJECTED", sub() {
            f.table.beginBoundedMaintenanceTransaction(100, 1000, 5000);
        });
        f.ds.clearMutationObserver();
        assertEq(2, executions);
        assertFalse(f.ds.currentThreadInTransaction(), "partial setup is rolled back by the API");
        assertEq(original, readModes(f.ds));
        f.ds.rollback();
        f.table.beginBoundedMaintenanceTransaction(100, 1000, 5000);
        assertEq("read committed", readModes(f.ds).isolation, "the same connection is reusable after setup rejection");
        f.ds.rollback();
    }

    private maintenanceDeclaration() {
        hash<auto> f = fixture();
        on_exit cleanup(f);
        list<hash<SqlMutationEventInfo>> events = ();
        f.ds.setMutationObserver(*hash<SqlMutationDecisionInfo> sub(hash<SqlMutationEventInfo> event) {
            events += event;
        }, SQL_MUTATION_MASK_ALL);
        on_exit f.ds.clearMutationObserver();
        hash<SqlMutationInfo> intent = <SqlMutationInfo>{"op_id": "owned-maintenance-fixture",
            "path_id": "bounded_tx_test", "effect": SQL_MUTATION_EFFECT_MAY_GROW, "max_growth_bytes": 4096};
        {
            SqlMutationDeclaration declaration(f.ds, intent);
            f.table.beginBoundedMaintenanceTransaction(100, 1000, 5000);
            f.table.update({"value": 13}, {"id": 1});
            f.ds.commit();
        }
        f.ds.clearMutationObserver();
        int executions = 0;
        bool committed = False;
        foreach hash<SqlMutationEventInfo> event in (events) {
            assertTrue(event.declared);
            assertEq(intent, event.info, "the helper never replaces the complete producer declaration");
            if (event.event == SQL_MUTATION_EVENT_PRE_EXEC) { ++executions; }
            if (event.outcome == SQL_MUTATION_OUTCOME_COMMIT) { committed = True; }
        }
        assertTrue(executions >= 3, "both setup commands and the business write cross the observer boundary");
        assertTrue(committed);
    }

    private stricter() {
        hash<auto> f = fixture();
        on_exit cleanup(f);
        f.ds.execRaw("set lock_timeout = '50ms'");
        f.ds.execRaw("set statement_timeout = '500ms'");
        f.ds.execRaw("set transaction_timeout = '3000ms'");
        f.ds.commit();
        hash<string, int> original = readSettings(f.ds);
        f.ds.commit();
        hash<string, int> effective = f.table.beginBoundedTransaction(100, 1000, 5000);
        assertEq(50, effective.lock_timeout_ms);
        assertEq(500, effective.statement_timeout_ms);
        assertTrue(effective.transaction_timeout_ms > 0 && effective.transaction_timeout_ms <= 3000);
        assertEq(effective, readSettings(f.ds));
        f.ds.rollback();
        assertEq(original, readSettings(f.ds));
        f.ds.commit();
    }

    private pool() {
        hash<auto> f = fixture();
        on_exit cleanup(f);
        hash<auto> config = parse_datasource(ENV.QORE_DB_CONNSTR_PGSQL);
        config.options = (config.options ?? {}) + {"min": 1, "max": 1};
        DatasourcePool pool(config);
        assertEq(1, pool.getMinimum());
        assertEq(1, pool.getMaximum());
        AbstractTable table = AbstractTable::getTable(pool, f.name);
        hash<string, int> original = readSettings(pool);
        pool.commit();
        table.beginBoundedTransaction(50, 500, 2000);
        table.update({"value": 4}, {"id": 1});
        pool.commit();
        table.beginBoundedTransaction(50, 500, 2000);
        table.update({"value": 5}, {"id": 1});
        pool.rollback();
        Counter done(1);
        hash<string, int> observed;
        int observed_value;
        *hash<ExceptionInfo> failure;
        background sub() {
            on_exit done.dec();
            try {
                on_error pool.rollback();
                observed = readSettings(pool);
                observed_value = table.selectRow({"where": {"id": 1}}).value.toInt();
                pool.commit();
            } catch (hash<ExceptionInfo> ex) { failure = ex; }
        }();
        assertEq(0, done.waitForZero(5s));
        assertNothing(failure);
        assertEq(original, observed, "the same pooled connection has its original defaults in another thread");
        assertEq(4, observed_value, "the next borrower observes only the committed transaction");
    }

    private lockWait() {
        hash<auto> f = fixture();
        on_exit cleanup(f);
        Datasource owner = connection();
        AbstractTable locked = AbstractTable::getTable(owner, f.name);
        locked.update({"value": 7}, {"id": 1});
        on_exit owner.rollback();
        f.table.beginBoundedTransaction(50, 1000, 5000);
        *hash<ExceptionInfo> failure;
        try { f.table.update({"value": 9}, {"id": 1}); }
        catch (hash<ExceptionInfo> ex) { failure = ex; }
        assertTrue(exists failure, "the contended write fails");
        assertTrue(make_json(failure).find("55P03") >= 0, "lock deadline is the database cause");
        f.ds.rollback();
        assertEq(7, locked.selectRow({"where": {"id": 1}}).value.toInt(), "the owner survives unchanged");
        owner.rollback();
        assertEq(0, f.table.selectRow({"where": {"id": 1}}).value.toInt());
        f.ds.commit();
    }

    private statement() {
        hash<auto> f = fixture();
        on_exit cleanup(f);
        f.table.beginBoundedTransaction(20, 80, 1000);
        f.table.update({"value": 2}, {"id": 1});
        *hash<ExceptionInfo> failure;
        try { f.ds.execRaw("select 1 from pg_sleep(0.4)"); }
        catch (hash<ExceptionInfo> ex) { failure = ex; }
        assertTrue(exists failure);
        assertTrue(make_json(failure).find("57014") >= 0, "statement deadline is the database cause");
        f.ds.rollback();
        assertEq(0, f.table.selectRow({"where": {"id": 1}}).value.toInt());
        f.ds.commit();
    }

    private transaction() {
        hash<auto> f = fixture();
        on_exit cleanup(f);
        # An existing positive timer must actually be tightened, not just display the new setting.
        f.ds.execRaw("set transaction_timeout = '5000ms'");
        f.ds.commit();
        f.table.beginBoundedTransaction(20, 150, 300);
        f.table.update({"value": 3}, {"id": 1});
        *hash<ExceptionInfo> failure;
        int completed;
        try {
            # Each individual statement fits its budget; the transaction as a whole must not.
            for (int i = 0; i < 12; ++i) {
                f.ds.execRaw("select 1 from pg_sleep(0.05)");
                ++completed;
            }
            f.ds.commit();
        } catch (hash<ExceptionInfo> ex) { failure = ex; }
        assertTrue(exists failure, "the whole-transaction deadline is enforced");
        assertTrue(completed > 0 && completed < 12, "short statements ran before the total budget expired");
        # The native pgsql driver reports a terminated session as connection loss, without the server FATAL text.
        assertEq("DBI:PGSQL:CONNECTION-ERROR", failure.err);
        assertTrue(failure.desc.find("lost while in a transaction") >= 0);
        f.ds.rollback();
        Datasource observer = connection();
        AbstractTable observed = AbstractTable::getTable(observer, f.name);
        assertEq(0, observed.selectRow({"where": {"id": 1}}).value.toInt(), "an independent observer sees rollback");
        observer.commit();
    }
}
