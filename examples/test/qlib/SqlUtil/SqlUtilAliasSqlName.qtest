#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/DataProvider
%requires ../../../../qlib/SqlUtil
%requires ../../../../qlib/Sqlite3SqlUtil.qm
%requires ../../../../qlib/QUnit.qm

%try-module sqlite3
%define NoSqlite3
%endtry

%exec-class SqlUtilAliasSqlNameTest

#! a table that records the aliases given to getAliasSqlName() and quotes them in their exact case
class AliasTable inherits Sqlite3Table {
    public {
        list<string> aliases = ();
    }

    constructor(AbstractDatasource ds, string name) : Sqlite3Table(ds, name) {
    }

    string getAliasSqlName(string alias) {
        aliases += alias;
        return "\"" + replace(alias, "\"", "\"\"") + "\"";
    }
}

#! Tests that a column alias is given to SQL through AbstractTable::getAliasSqlName()
class SqlUtilAliasSqlNameTest inherits QUnit::Test {
    private {
        *Datasource ds;
    }

    constructor() : Test("SqlUtilAliasSqlName", "1.0", \ARGV) {
        addTestCase("cop_as() aliases are given by getAliasSqlName()", \copAs());
        addTestCase("the default keeps the result key of a working alias", \defaultAlias());
        addTestCase("a pre-quoted alias names its result key", \quotedAlias());
        addTestCase("delimited alias names", \delimitedNames());
        set_return_value(main());
    }

    globalSetUp() {
%ifndef NoSqlite3
        ds = new Datasource("sqlite3:x@:memory:");
        ds.exec("create table t (id integer, val text)");
        ds.exec("insert into t (id, val) values (1, 'a')");
        ds.commit();
%endif
    }

    globalTearDown() {
        if (ds) {
            ds.rollback();
        }
    }

    private Datasource getDatasource() {
%ifdef NoSqlite3
        testSkip("no sqlite3 module");
%endif
        return ds;
    }

    copAs() {
        Datasource ds = getDatasource();
        AliasTable t(ds, "t");
        # the alias of the legacy column operator is given by the hook, so a driver can keep its case
        *hash<auto> row = t.selectRow({"columns": (cop_as("val", "My Value"),), "where": {"id": 1}});
        assertEq(("My Value",), t.aliases);
        assertEq({"My Value": "a"}, row);
    }

    defaultAlias() {
        Datasource ds = getDatasource();
        Sqlite3Table t(ds, "t");
        # the default gives an ordinary alias as before, so its result key is unchanged
        *hash<auto> row = t.selectRow({"columns": (cop_as("val", "v1"),), "where": {"id": 1}});
        assertEq({"v1": "a"}, row);
        assertEq("v1", t.getAliasSqlName("v1"));
    }

    #! an alias given as a delimited identifier (issue #2163) is used as given, names the result key without its
    #! delimiters, and can be referenced by that name; an alias that needs quotes is quoted
    quotedAlias() {
        Datasource ds = getDatasource();
        Sqlite3Table t(ds, "t");
        foreach string alias in (("\"user-interaction\"", "`user-interaction`", "[user-interaction]")) {
            assertEq(alias, t.getAliasSqlName(alias));
            list<auto> args;
            assertEq("select val as " + alias + " from t order by val", t.getSelectSql({"columns":
                (cop_as("val", alias),), "orderby": "user-interaction"}, \args), alias);
            assertEq({"user-interaction": "a"}, t.selectRow({"columns": (cop_as("val", alias),), "where": {"id": 1}}),
                alias);
        }
        assertEq("\"user-interaction\"", t.getAliasSqlName("user-interaction"));
        assertEq({"user-interaction": "a"}, t.selectRow({"columns": (cop_as("val", "user-interaction"),),
            "where": {"id": 1}}));
        assertEq({"a\"b": "a"}, t.selectRow({"columns": (cop_as("val", "\"a\"\"b\""),), "where": {"id": 1}}));
        # SQLite has no escape in brackets, so a bracketed alias with a "]" is quoted
        assertEq("\"[a]]b]\"", t.getAliasSqlName("[a]]b]"));
        # the expression form
        assertEq({"user-interaction": "a"}, t.selectRow({"columns": (<DataProviderExpression>{
            "exp": COP_AS,
            "args": (<DataProviderFieldReference>{"field": "val"}, "\"user-interaction\""),
        },), "where": {"id": 1}}));
    }

    #! the name that a delimited identifier gives, as a driver recognizes it
    delimitedNames() {
        assertEq("a-b", AbstractTable::getDelimitedName("\"a-b\"", "\"", "\""));
        assertEq("a\"b", AbstractTable::getDelimitedName("\"a\"\"b\"", "\"", "\""));
        assertEq("a]b", AbstractTable::getDelimitedName("[a]]b]", "[", "]"));
        # a closing delimiter that is not doubled ends the identifier before the end of the alias
        assertEq(NOTHING, AbstractTable::getDelimitedName("\"a\" b\"", "\"", "\""));
        assertEq(NOTHING, AbstractTable::getDelimitedName("\"a\"\"", "\"", "\""));
        # a doubled delimiter before the closing one is part of the name
        assertEq("a\"", AbstractTable::getDelimitedName("\"a\"\"\"", "\"", "\""));
        # empty, unterminated, and undelimited aliases
        assertEq(NOTHING, AbstractTable::getDelimitedName("\"\"", "\"", "\""));
        assertEq(NOTHING, AbstractTable::getDelimitedName("\"a", "\"", "\""));
        assertEq(NOTHING, AbstractTable::getDelimitedName("a-b", "\"", "\""));
        assertEq(NOTHING, AbstractTable::getDelimitedName("\"", "\"", "\""));
    }
}
