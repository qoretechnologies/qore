#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%prepend-module-path "${SCRIPT_DIR}"
%requires QUnit
%requires SqlUtil
%requires ./PgsqlTestIsolation.qm

%try-module sqlite3
%define NoSqlite3
%endtry

%try-module pgsql
%define NoPgsql
%endtry

%exec-class SqlUtilTruncDateWhereTest

#! Tests op_trunc_date(), which compares a date column truncated as cop_trunc_date() does (issue #2363)
/** The tests run on PostgreSQL in a schema of their own when \c QORE_DB_CONNSTR_PGSQL is set, and on SQLite, whose
    driver has no implementation of cop_trunc_date()
*/
class SqlUtilTruncDateWhereTest inherits QUnit::Test {
    public {
        #! the optional schema of a table name in SQL, as a regular expression
        const T = "(?:\\w+\\.)?";
    }

    private {
        *Datasource pgsql;
    }

    constructor() : Test("SqlUtilTruncDateWhere", "1.0", \ARGV) {
        addTestCase("PostgreSQL: op_trunc_date()", \pgsqlTruncDate());
        addTestCase("SQLite: op_trunc_date() is not supported", \sqliteTruncDate());
        addTestCase("invalid op_trunc_date() masks", \invalidMask());
        set_return_value(main());
    }

    globalSetUp() {
%ifndef NoPgsql
        if (ENV.QORE_DB_CONNSTR_PGSQL) {
            PgsqlRunSchema::setup(ENV.QORE_DB_CONNSTR_PGSQL, "SqlUtilTruncDateWhere");
            pgsql = new Datasource(ENV.QORE_DB_CONNSTR_PGSQL);
            pgsql.exec("create table tdw_ev (id integer not null primary key, ts timestamp)");
            pgsql.exec("insert into tdw_ev values (1, '2020-01-01 10:00:00'), (2, '2020-01-01 23:00:00'), "
                "(3, '2020-01-02 01:00:00'), (4, null)");
            pgsql.commit();
        }
%endif
    }

    globalTearDown() {
        if (pgsql) {
            pgsql.rollback();
            delete pgsql;
            PgsqlRunSchema::teardown();
        }
    }

    pgsqlTruncDate() {
%ifdef NoPgsql
        testSkip("no pgsql module");
%endif
        if (!pgsql) {
            testSkip("QORE_DB_CONNSTR_PGSQL is not set");
        }
        on_exit pgsql.rollback();
        Table t(pgsql, "tdw_ev");
        string sql;

        # a value: compared for equality
        assertEq((1, 2), ids(t, {"ts": op_trunc_date(DT_DAY, 2020-01-01)}, \sql));
        assertRegex(" where date_trunc\\('day', ts\\) = %v order by ", sql);

        # an operator applied to the truncated column
        assertEq((3,), ids(t, {"ts": op_trunc_date(DT_DAY, op_ge(2020-01-02))}, \sql));
        assertRegex(" where date_trunc\\('day', ts\\) >= %v order by ", sql);
        assertEq((1, 2), ids(t, {"ts": op_trunc_date(DT_HOUR, op_between(2020-01-01T10:00:00,
            2020-01-01T23:00:00))}, \sql));
        assertRegex(" where date_trunc\\('hour', ts\\) between %v and %v order by ", sql);
        assertEq((1, 2, 3), ids(t, {"ts": op_trunc_date(DT_MONTH, op_in((2020-01-01, 2020-02-01)))}, \sql));
        assertEq((4,), ids(t, {"ts": op_trunc_date(DT_YEAR, NULL)}, \sql));
        assertRegex(" where date_trunc\\('year', ts\\) is null order by ", sql);

        # within op_not()
        assertEq((3,), ids(t, {"ts": op_not(op_trunc_date(DT_DAY, 2020-01-01))}, \sql));
        assertRegex(" where not \\(date_trunc\\('day', ts\\) = %v\\) order by ", sql);

        # in a delete and an update, which take the same where clause
        assertEq(2, t.update({"ts": 2021-01-01}, {"ts": op_trunc_date(DT_DAY, 2020-01-01)}));
        assertEq(2, t.del({"ts": op_trunc_date(DT_YEAR, 2021-01-01)}));
        assertEq((3, 4), ids(t, NOTHING, \sql));
    }

    sqliteTruncDate() {
%ifdef NoSqlite3
        testSkip("no sqlite3 module");
%endif
        Datasource ds("sqlite3:x@:memory:");
        ds.exec("create table tdw_ev (id integer not null primary key, ts timestamp)");
        Table t(ds, "tdw_ev");
        assertThrows("SELECT-ERROR", "unknown column operator", sub () {
            t.selectRows({"where": {"ts": op_trunc_date(DT_DAY, 2020-01-01)}});
        });
        ds.rollback();
    }

    invalidMask() {
        assertThrows("COP-TRUNC-DATE-ERROR", sub () { op_trunc_date("X", 2020-01-01); });
    }

    #! returns the ids of the rows that match the where clause, in their order
    private list<auto> ids(Table t, *hash<auto> cond, reference<string> sql) {
        return map $1.id, t.selectRows({"columns": "id", "where": cond, "orderby": "id"}, \sql);
    }
}
