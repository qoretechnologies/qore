#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - the credential checks of the serialization tests need no database
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern

%requires ./SqlUtilTestBase.qm

%exec-class SqlTestBaseCredentialLeaksTest

#! the checks that the serialization tests of the SqlUtil drivers make of serialized data for credentials (qore#7016)
class SqlTestBaseCredentialLeaksTest inherits QUnit::Test {
    constructor() : QUnit::Test("SqlTestBaseCredentialLeaks", "1.0", \ARGV) {
        addTestCase("a password that collides with other configured values", \collisionTest());
        addTestCase("a distinctive password", \distinctiveTest());
        addTestCase("the password where a connection string has it", \connectionStringTest());
        set_return_value(main());
    }

    #! as on CI: password "qore", user and database "qore_test_<random>"
    collisionTest() {
        hash<auto> config = {
            "type": "pgsql",
            "user": "qore_test_abcdefghij",
            "pass": "qore",
            "db": "qore_test_abcdefghij",
            "host": "pgsql",
        };
        assertFalse(SqlTestBase::isDistinctivePassword("qore", config), "a short password that collides");
        # a long password that is part of the database name collides as well
        assertFalse(SqlTestBase::isDistinctivePassword("qore_test", config + {"pass": "qore_test"}),
            "a long password that is part of the database name");
        # a password that is part of an option value collides
        assertFalse(SqlTestBase::isDistinctivePassword("utf8mb4x", config + {"pass": "utf8mb4x",
            "options": {"charset": "utf8mb4x_bin"}}), "a password that is part of an option value");

        # the masked data of such a datasource names the database: nothing is reported
        hash<auto> data = {
            "_index": ({
                "_members": {
                    "ds": "pgsql:****/****@qore_test_abcdefghij%pgsql",
                    "ds_masked": {"type": "pgsql", "user": "****", "db": "qore_test_abcdefghij", "host": "pgsql"},
                    "connection_name": "qore",
                    "name": "qore_table",
                },
            },),
        };
        assertEq((), SqlTestBase::findCredentialLeaks(data, "qore"));
    }

    #! a password that no other configured value has in it is looked for anywhere in the data
    distinctiveTest() {
        hash<auto> config = {
            "type": "pgsql",
            "user": "qore_test_abcdefghij",
            "pass": "Zx9-secret",
            "db": "qore_test_abcdefghij",
            "host": "pgsql",
            "port": 5432,
        };
        assertTrue(SqlTestBase::isDistinctivePassword("Zx9-secret", config));
        # the password itself is not a value that it collides with
        assertTrue(SqlTestBase::isDistinctivePassword("Zx9-secret", config + {"options": {"min": 1}}));

        hash<auto> data = {
            "_index": ({
                "_members": {
                    "ds": "pgsql:****/****@qore_test_abcdefghij%pgsql",
                    "name": "t",
                    "comment": "created with Zx9-secret by mistake",
                },
                "Zx9-secret": 1,
            },),
        };
        # an arbitrary field is not where a connection string has the password: only the search anywhere finds it
        assertEq((), SqlTestBase::findCredentialLeaks(data, "Zx9-secret"));
        assertEq(sort(("._index[0]._members.comment", "._index[0].Zx9-secret (key)")),
            sort(SqlTestBase::findCredentialLeaks(data, "Zx9-secret", "", False, True)));
        # data with no password is clean for the search anywhere
        assertEq((), SqlTestBase::findCredentialLeaks(data - "_index", "Zx9-secret", "", False, True));
    }

    #! the password in a datasource or connection field, whatever the password is
    connectionStringTest() {
        hash<auto> data = {
            "a": {"Password": "qore"},
            "ds": "pgsql:qore_test_abc/qore@qore_test_abc%pgsql",
            "x": {"conn_info": {"url": "https://user:qore@host/path"}},
            "y": {"connstr": "Server=h;Uid=u;Pwd=qore;Database=d"},
            "z": {"datasource": "pgsql:u/****@db{password=qore}"},
            # not credentials: the same text as a name, and a password key that has another value
            "n": {"db": "qore", "pass": "****", "url": "https://qore.example.com/qore"},
        };
        assertEq((".a.Password", ".ds", ".x.conn_info.url", ".y.connstr", ".z.datasource"),
            sort(SqlTestBase::findCredentialLeaks(data, "qore")));
    }
}
