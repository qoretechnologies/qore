#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
#
# Copyright 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires SqlUtil
%requires MssqlSqlUtilBase
%requires ./TestRunIsolation.qm
%requires ./MssqlTestIsolation.qm

%exec-class MssqlTriggersTest

#! The triggers of a table on SQL Server, with the freetds driver and the jdbc driver
/** The triggers of a table were not read from the database, so an alignment created each trigger of the template
    again, which failed as it existed (server message 2714), also for the automatic triggers of a data schema
*/
class MssqlTriggersTest inherits QUnit::Test {
    constructor() : Test("MssqlTriggersTest", "1.0", \ARGV) {
        addTestCase("triggers with the freetds driver", \freetdsTriggers());
        addTestCase("triggers with the jdbc driver", \jdbcTriggers());
        addTestCase("the source of a trigger from its definition", \triggerSource());
        set_return_value(main());
    }

    globalTearDown() {
        MssqlRunDatabase::teardown();
    }

    private freetdsTriggers() {
        checkTriggers("QORE_DB_CONNSTR_FREETDS");
    }

    private jdbcTriggers() {
        checkTriggers("QORE_DB_CONNSTR_JDBC_MSSQL");
    }

    #! returns the description of the test table with a trigger that sets the column "v" to the given value
    private static hash<auto> desc(string name, string value) {
        return {
            "columns": {
                "id": {"qore_type": Type::Int, "notnull": True},
                "v": {"native_type": "varchar", "size": 20},
            },
            "primary_key": {"name": "pk_" + name, "columns": ("id",)},
            "triggers": {
                "trg_" + name: sprintf("ON %s\nAFTER INSERT\nAS\nBEGIN\n  SET NOCOUNT ON;\n"
                    "  UPDATE t SET t.v = '%s' FROM %s t INNER JOIN inserted i ON t.id = i.id;\nEND", name, value,
                    name),
            },
        };
    }

    private checkTriggers(string var) {
        Datasource ds = datasource(var);
        on_exit ds.rollback();
        Database db(ds);
        string name = TestRun::makeName("mssql_trg");
        string trigger = "trg_" + name;
        db.makeTable(name, desc(name, "one")).create();
        ds.commit();
        on_exit {
            ds.rollback();
            ds.exec("drop table " + name);
            ds.commit();
        }

        AbstractTable t = db.getTable(name);
        # the trigger is read from the database
        assertEq((trigger,), t.getTriggers().keys());
        # and the table is aligned to its description with no change
        assertEq((), t.getAlignSql(db.makeTable(name, desc(name, "one"))));

        # a changed trigger is dropped and created
        list<auto> sql = t.getAlignSql(db.makeTable(name, desc(name, "two")));
        assertEq(2, sql.size());
        assertRegex("^drop trigger ", sql[0]);
        assertRegex("^create trigger ", sql[1]);
        map ds.execRaw($1), sql;
        ds.commit();
        t = db.getTable(name);
        t.insert({"id": 1});
        ds.commit();
        assertEq("two", t.selectRow({"where": {"id": 1}}).v);
        assertEq((), t.getAlignSql(db.makeTable(name, desc(name, "two"))));

        # a trigger that the template does not have is dropped
        hash<auto> h = desc(name, "two");
        remove h.triggers;
        sql = t.getAlignSql(db.makeTable(name, h));
        assertEq(1, sql.size());
        assertRegex("^drop trigger ", sql[0]);
    }

    #! the source of a trigger is its definition after the trigger's name, as SQL Server keeps it
    private triggerSource() {
        foreach hash<auto> i in ({
                "create trigger trg_a ON t AFTER INSERT AS BEGIN SET NOCOUNT ON; END": "trg_a",
                "CREATE TRIGGER [trg a] ON t AFTER INSERT AS BEGIN SET NOCOUNT ON; END": "trg a",
                "  create\r\ntrigger dbo.trg_a\r\nON t AFTER INSERT AS BEGIN SET NOCOUNT ON; END": "trg_a",
                "create or alter trigger [dbo].[trg]]a] ON t AFTER INSERT AS BEGIN SET NOCOUNT ON; END": "trg]a",
            }.pairIterator()) {
            assertEq("ON t AFTER INSERT AS BEGIN SET NOCOUNT ON; END",
                replace(replace(MssqlTable::getTriggerSource(i.key), "\r\n", " "), "\n", " "), i.value);
        }
        # a definition that is not one of a trigger is kept as it is
        assertEq("select 1", MssqlTable::getTriggerSource("select 1"));
    }

    #! returns the datasource of the run's database on SQL Server, or skips the test case if there is none
    private Datasource datasource(string var) {
        if (!ENV{var}.val()) {
            testSkip(var + " is not set");
        }
        try {
            Datasource ds(ENV{var});
            ds.open();
            if (MssqlDatabase::isSybase(ds)) {
                testSkip("the database is Sybase, not SQL Server");
            }
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "TEST-SKIPPED-EXCEPTION") {
                rethrow;
            }
            testSkip(sprintf("no DB connection: %s: %s", ex.err, ex.desc));
        }
        Datasource ds(MssqlRunDatabase::getConnectionString(ENV{var}, "MssqlTriggers"));
        ds.open();
        return ds;
    }
}
