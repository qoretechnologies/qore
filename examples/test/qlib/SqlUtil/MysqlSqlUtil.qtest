#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%prepend-module-path "${SCRIPT_DIR}"
%requires ../../../../qlib/Util.qmod
%requires ../../../../qlib/Logger.qmod
%requires ../../../../qlib/DataProvider/DataProvider.qmod
%requires ../../../../qlib/SqlUtil/SqlUtil.qmod
%requires ../../../../qlib/MysqlSqlUtil.qmod

%requires ./SqlUtilTestBase.qm

%try-module mysql
%define NoMysql
%endtry

%exec-class MysqlTest

class MysqlTestSchema inherits SqlUtilTestSchema {
    public {
        const SchemaName = "MysqlTestSchema";
        const SchemaVersion = "1.0";
    }

    private {
        const GenericOptions = (
            "replace": True,
        );

        const IndexOptions = {};

        const ColumnOptions = {};

        const T_MysqlTest = (
            "columns": (
                "id": c_number(14, True, "an example comment with 'quotes'"),
                "id_": c_number(14, True),
                "null_f": c_varchar(69),
                "blob_f": c_blob(True),
                "clob_f": c_clob(True),
            ),
            "primary_key": ("name": "pk_mysql_test", "columns": ("id")),
        );

        const Tables = (
            "mysql_test": T_MysqlTest,
        );
    }

    constructor(AbstractDatasource ds, *string dts, *string its) : SqlUtilTestSchema(ds, dts, its) {
    }

    private string getNameImpl() {
        return SchemaName;
    }

    private string getVersionImpl() {
        return SchemaVersion;
    }

    private *hash getTablesImpl() {
        return doTables(Tables, MysqlTest::CustomColumns);
    }

    private *hash getIndexOptionsImpl() {
        return IndexOptions;
    }

    private *hash getGenericOptionsImpl() {
        return GenericOptions;
    }

    private *hash getColumnOptionsImpl() {
        return ColumnOptions;
    }
}

class MysqlTestAutoIncrementNegativeSchema inherits AbstractSchema {
    constructor(AbstractDatasource ds, *string dts, *string its)
        : AbstractSchema(ds, dts, its) {
    }

    string getNameImpl() { return "MysqlTestAutoIncrementNegativeSchema"; }
    string getVersionImpl() { return "1.0"; }

    private *hash getTablesImpl() {
        return {
            "mysql_test_auto_increment" : {
                "columns": {
                    "id": c_number(14, C_NOT_NULL) + { "auto_increment" : True, },
                },
                "primary_key" : { "name" : "pk_mysql_test_auto_increment", "columns" : "id" },
            },
        };
    }
}

class MysqlTestAutoIncrementPositiveSchema inherits AbstractSchema {

    constructor(AbstractDatasource ds, *string dts, *string its)
        : AbstractSchema(ds, dts, its)
    {
    }

    string getNameImpl() { return "MysqlTestAutoIncrementPositiveSchema"; }
    string getVersionImpl() { return "1.0"; }

    private *hash getTablesImpl() {
        return {
            "mysql_test_auto_increment" : {
                "columns": {
                    "id": c_int(C_NOT_NULL) + { "auto_increment" : True, },
                },
                "primary_key" : { "name" : "pk_mysql_test_auto_increment", "columns" : "id" },
            },
        };
    }
}

class MysqlTest inherits SqlTestBase {
    public {
        const CustomColumns = (
            "varchar": (
                "value": "hello",
                "size": "20",
            ),
            "char": (
                "value": "hello",
                "size": "20",
            ),
            "decimal": (
                "size": 15,
                "scale": 2,
                "value": 400.95n,
            ),
            "decimal_def": (
                "type": "decimal",
                "value": 401,
            ),

            "tinyint": 10,
            "smallint": 512,
            "mediumint": 192932,
            "int": 49349839,
            "bigint": 34839203948394,
            "float": 1.5,
            "double": 3.1415927,

            "date": 2016-02-11,
            "datetime": 2016-02-11T09:26:14,
            "timestamp": 2016-02-11T09:26:14,
            "time": 09:26:52,
            "year": 2016, # XXX: this is likely just an integer

            "binary": (
                "value": <bead>,
                "size": 2, # must be 2 as default is 1
            ),
            "varbinary": (
                "value": <bead>,
                "size": 10,
            ),

            "tinyblob": <bead>,
            "blob": <bead>,
            "mediumblob": <bead>,
            # temporarily disabled due to a bug on rhel7 handling logblob columns with mariadb
            #"longblob": <bead>,

            "tinytext": "test",
            "mediumtext": "test",
            # temporarily disabled due to a bug on rhel7 handling logtext columns with mariadb
            #"longtext": "test",

            #"bit": 100,
        );
    }

    constructor() : SqlTestBase("MysqlTest", "1.0", \ARGV, MyOpts) {
        Datasource ds;
        try {
            ds = getDatasource();
        } catch (hash ex) {
            if (m_options.verbose)
                printf("%s: %s\n", ex.err, ex.desc);
            # skip tests if we can't create the datasource
        }

        if (ds) {
            initTestData(CustomColumns);

            { # Make sure the DB is clear before doing the tests.
                MysqlTable t = new MysqlTable(ds, "mysql_test");
                if (t.checkExistence())
                    t.dropCommit();
            }

            # create the test schema
            schema = new MysqlTestSchema(ds);

            schema.align(False, m_options.verbose, m_options.verbose > 0);

            # get table object
            table = (new Table(schema.getDatasource(), "mysql_test")).getTable();

            # this feature can be enabled for MariaDB >= 10.2. Let's hope it will be recived in MySQL too
            # addTestCase("analytic/window functions", \testAnalyticFunctions());

            addTestCase("test create table with auto increment - negative", \testCreateTableWithAutoIncrementNegative());
            addTestCase("test create table with auto increment - positive", \testCreateTableWithAutoIncrementPositive());
            addTestCase("range partition lifecycle", \rangePartitionLifecycleTest());
            addTestCase("list partition lifecycle", \listPartitionLifecycleTest());
            addTestCase("a unique index or constraint with other columns is dropped and created once",
                \uniqueColumnChanges());
            addTestCase("the first value of an emulated sequence is its start value", \sequenceStartTest());
            addTestCase("a referenced unique key changes with the foreign constraint that references it",
                \referencedKeyChanges());
            addTestCase("a template that changes a referenced unique key without the foreign constraint is refused",
                \inconsistentTemplates());
        }
        addTestCase("the SQL of a unique index or constraint with other columns", \uniqueColumnChangeSql());
        addTestCase("the SQL of a new emulated sequence", \sequenceSql());

        set_return_value(main());
    }

    private string getResultSetSql() {
        testSkip("does not support result set output binds");
        return "";
    }

    private testCreateTableWithAutoIncrementNegative() {
        MysqlTestAutoIncrementNegativeSchema schema(table.getDatasource());
        assertThrows("MYSQL-COLUMN-ERROR",
                     "AUTO_INCREMENT can be used only with a subset of types",
                     sub() { schema.align(False, m_options.verbose, m_options.verbose > 0); });
    }

    private testCreateTableWithAutoIncrementPositive() {
        MysqlTestAutoIncrementPositiveSchema schema(table.getDatasource());
        schema.align(False, m_options.verbose, m_options.verbose > 0);
        assertEq(True, True, "schema alignment works");
    }

    private rangePartitionLifecycleTest() {
        if (!table) {
            testSkip("no DB connection");
        }

        AbstractDatasource ds = table.getDatasource();
        ds.execRaw("drop table if exists mysql_partition_test");
        ds.commit();

        on_exit {
            try {
                ds.execRaw("drop table if exists mysql_partition_test");
                ds.commit();
            } catch (hash<ExceptionInfo> ex) {
            }
        }

        assertThrows("DESCRIPTION-ERROR", "primary key", sub () {
            MysqlTable bad_unique(ds, "mysql_partition_bad_unique");
            bad_unique.setupTable({
                "columns": {
                    "id": {"qore_type": Type::Int, "notnull": True},
                    "d": {"native_type": "datetime", "notnull": True},
                },
                "primary_key": {"name": "pk_mysql_partition_bad_unique", "columns": "id"},
                "partition_strategy": {"method": "range", "columns": "d"},
            });
        });

        MysqlTable t(ds, "mysql_partition_test");
        t.setupTable({
            "columns": {
                "id": {"qore_type": Type::Int, "notnull": True},
                "d": {"native_type": "datetime", "notnull": True},
                "v": {"qore_type": Type::String, "size": 20},
            },
            "primary_key": {"name": "mysql_partition_test_pk", "columns": ("id", "d")},
            "indexes": {
                "mysql_partition_test_v_idx": {"columns": "v", "partition_aligned": True},
            },
            "partition_strategy": {"method": "range", "columns": "d"},
            "partitions": {
                "p1": {"name": "p1", "bound_sql": "values less than ('2026-02-01 00:00:00')"},
                "p2": {"name": "p2", "bound_from": "2026-02-01", "bound_to": "2026-03-01"},
            },
        });
        t.createCommit();

        MysqlTable rt(ds, "mysql_partition_test");
        assertEq(True, rt.supportsPartitions());
        assertEq(True, rt.supportsPartitionRead());
        assertEq(True, rt.supportsTargetedPartitionLookup());
        assertEq(False, rt.supportsPartitionDetach());
        assertEq(False, rt.supportsConcurrentPartitionDetach());

        *hash<PartitionInfo> targeted_p2 = rt.getPartition("p2");
        assertTrue(exists targeted_p2, "MySQL targeted lookup returns the named partition");
        assertEq(2026-02-01, targeted_p2.bound_from, "MySQL targeted lookup resolves the preceding bound");
        assertEq(2026-03-01, targeted_p2.bound_to, "MySQL targeted lookup resolves the selected upper bound");
        assertTrue(exists targeted_p2.estimated_row_count,
            "MySQL targeted lookup exposes the catalog-estimated row count");
        assertTrue(exists targeted_p2.size_bytes, "MySQL targeted lookup exposes allocated partition bytes");
        assertNothing(rt.getPartition("missing"), "MySQL targeted lookup returns nothing for a missing name");
        hash<PartitionLookupResult> targeted_lookup = rt.findPartitionBySpec({
            "name": "p2",
            "bound_from": 2026-02-01,
            "bound_to": 2026-03-01,
        });
        assertEq(PartitionLookupStatus::Found, targeted_lookup.status,
            "MySQL verifies name-bearing comparable specs with targeted metadata");

        rt.insertCommit({"id": 101, "d": 2026-01-15, "v": "p1 row"});
        rt.insertCommit({"id": 102, "d": 2026-02-15, "v": "p2 row"});
        *list<auto> p1_rows = rt.selectRows({"partition": "p1"});
        assertEq(1, p1_rows.size(), "generic partition read restricts MySQL to one physical partition");
        assertEq(101, p1_rows[0].id, "MySQL partition read returns the row from the named partition");
        DbTableDataProvider partition_dp(rt);
        assertTrue(partition_dp.getInfo().search_options.hasKey("partition"),
            "DbTableDataProvider exposes the SqlUtil partition read option");
        *hash<string, hash<ActionOptionInfo>> find_options = partition_dp.tryGetActionOptionsWithOptions(
            DataProviderActionCatalog::getAppActionEx("Db", "find"), NOTHING);
        assertTrue(find_options.hasKey("partition"), "the DB find action exposes the partition option");
        assertEq(101, partition_dp.searchSingleRecord({"id": 101}, {"partition": "p1"}).id,
            "DbTableDataProvider single-record reads forward the partition option");
        *list<auto> provider_rows = map $1, partition_dp.searchRecords(NOTHING, {"partition": "p1"});
        assertEq(1, provider_rows.size(), "DbTableDataProvider iterators forward the partition option");
        {
            AbstractDataProviderBulkRecordInterface bulk = partition_dp.getBulkRecordInterface(10,
                {"partition": "p1"});
            hash<auto> block = bulk.getValue();
            assertEq((101,), block.id, "DbTableDataProvider bulk reads forward the partition option");
        }
        string partition_select_sql = rt.getSelectSql({"partition": "p2"});
        assertTrue(partition_select_sql =~ /partition \(p2\)/i,
            "generic partition read emits the MySQL partition-selection clause");
        assertThrows("PARTITION-ERROR", "partition \"missing\" does not exist", sub () {
            rt.getSelectSql({"partition": "missing"});
        });
        *list<auto> joined_partition_rows = rt.selectRows({
            "alias": "a",
            "columns": "a.id",
            "partition": "p1",
            "join": join_inner(rt, "b", {"id": "id"}, NOTHING, {"partition": "p1"}),
        });
        assertEq(1, joined_partition_rows.size(),
            "generic partition qualifier applies independently to MySQL join table references");

        hash<PartitionStrategy> strategy = rt.getPartitionStrategy();
        assertEq("range", strategy.method);
        assertEq(1, strategy.columns.size());
        assertEq("d", strategy.columns[0]);
        assertTrue(rt.getIndexes().hasKey("mysql_partition_test_v_idx"),
            "portable aligned index is materialized with MySQL's inherent partition-local storage");

        hash<string, PartitionInfo> parts = rt.listPartitions();
        assertEq(2, parts.size());
        assertEq(0, parts.p1.ordinal, "full MySQL listing replaces the partial targeted cache");
        assertEq(2026-02-01, parts.p2.bound_from);
        assertEq(2026-03-01, parts.p2.bound_to);

        hash<auto> desc = rt.getDescriptionHash({"with_partitions": True});
        assertEq(2, desc.partitions.size());
        assertFalse(desc.partitions.p1.hasKey("ordinal"));
        assertFalse(desc.partitions.p1.hasKey("sql_name"));
        assertFalse(desc.partitions.p1.hasKey("estimated_row_count"),
            "description excludes runtime row statistics");
        assertFalse(desc.partitions.p1.hasKey("size_bytes"), "description excludes runtime storage statistics");
        assertTrue(desc.partitions.p1.hasKey("bound_sql"));
        assertFalse(desc.partitions.p1.hasKey("bound_to_sql"));
        assertTrue(desc.partitions.p2.hasKey("bound_from"));
        assertFalse(desc.partitions.p2.hasKey("bound_sql"));
        assertTrue(rt.getCreateSql()[0] =~ /partition by range columns/i);

        assertEq((), rt.getAlignSql(t), "table aligns with the schema used to create it");
        MysqlTable reverse_template(ds, "mysql_partition_test");
        reverse_template.setupTable(desc);
        assertEq((), rt.getAlignSql(reverse_template), "reverse-engineered partition schema aligns unchanged");

        hash<auto> changed_strategy_desc = {} + desc;
        changed_strategy_desc.partition_strategy = {} + desc.partition_strategy;
        changed_strategy_desc.partition_strategy.auto = {"policy": "different"};
        MysqlTable changed_strategy(ds, "mysql_partition_test");
        changed_strategy.setupTable(changed_strategy_desc);
        assertThrows("PARTITION-ERROR", "normalized desired", sub () {
            rt.getAlignSql(changed_strategy);
        });

        hash<PartitionLookupResult> lookup = rt.findPartitionBySpec({
            "bound_from": 2026-02-01,
            "bound_to": 2026-03-01,
        });
        assertEq(PartitionLookupStatus::Found, lookup.status);
        assertEq("p2", lookup.partition.name);
        assertThrows("PARTITION-ERROR", "must start at the preceding upper bound", sub () {
            rt.getAddPartitionSql({"name": "pgap", "bound_from": 2026-03-15, "bound_to": 2026-04-01});
        });
        assertThrows("PARTITION-ERROR", "bounds overlap existing partition", sub () {
            rt.getAddPartitionSql({"name": "poverlap", "bound_from": 2026-02-15, "bound_to": 2026-03-15});
        });
        assertThrows("PARTITION-ERROR", "lower bound must be less than upper bound", sub () {
            rt.getAddPartitionSql({"name": "preversed", "bound_from": 2026-04-01, "bound_to": 2026-03-01});
        });

        hash<PartitionEnsureResult> ensure = rt.ensurePartitionCommit({
            "name": "p3",
            "bound_from": 2026-03-01,
            "bound_to": 2026-04-01,
        });
        assertEq(True, ensure.created);
        assertEq(True, ensure.materialized);
        assertEq(PartitionVerifiedBy::Bounds, ensure.verified_by);
        assertEq("p3", ensure.partition.name);
        assertEq(2026-03-01, ensure.partition.bound_from);
        assertEq(2026-04-01, ensure.partition.bound_to);
        assertEq(True, rt.listPartitions().hasKey("p3"));

        ds.execRaw("insert into mysql_partition_test values (3, '2026-03-15 00:00:00', 'x')");
        ds.commit();
        assertEq(1, ds.selectRow("select count(*) c from mysql_partition_test partition (p3)").c);
        rt.truncatePartitionCommit("p3");
        assertEq(0, ds.selectRow("select count(*) c from mysql_partition_test partition (p3)").c);

        rt.dropPartitionCommit("p3");
        assertEq(False, rt.listPartitions().hasKey("p3"));

        # ensurePartition() concurrent-create race (MySQL/MariaDB auto-commits DDL, so no savepoint is used):
        # prime a stale cache on a second handle, create the partition out of band, then ensurePartition must
        # treat the duplicate ADD PARTITION ("Duplicate partition name") as success
        MysqlTable racer(ds, "mysql_partition_test");
        racer.listPartitions();
        rt.ensurePartitionCommit({"name": "p4", "bound_from": 2026-03-01, "bound_to": 2026-04-01});
        hash<PartitionEnsureResult> raced = racer.ensurePartitionCommit({
            "name": "p4",
            "bound_from": 2026-03-01,
            "bound_to": 2026-04-01,
        });
        assertEq(False, raced.created, "ensurePartition() race resolves the duplicate without creating");
        assertEq(True, raced.materialized, "ensurePartition() race resolves to a materialized partition");
        rt.dropPartitionCommit("p4");

        rt.addPartitionCommit({"name": "pmax", "is_default": True});
        assertEq(PartitionLookupStatus::Found, rt.findPartitionBySpec({"is_default": True}).status);
        assertThrows("PARTITION-ERROR", "default partition", sub () {
            rt.getAddPartitionSql({"name": "pmax2", "is_default": True});
        });
        assertThrows("PARTITION-ERROR", "catch-all partition", sub () {
            rt.getAddPartitionSql({"name": "p5", "bound_from": 2026-03-01, "bound_to": 2026-04-01});
        });
        rt.dropPartitionCommit("pmax");

        MysqlTable finite_first(ds, "mysql_partition_finite_first");
        assertThrows("PARTITION-ERROR", "cannot declare finite lower bound", sub () {
            finite_first.setupTable({
                "columns": {"d": {"qore_type": Type::Date, "notnull": True}},
                "partition_strategy": {"method": "range", "columns": "d"},
                "partitions": {"p1": {"bound_from": 2026-01-01, "bound_to": 2026-02-01}},
            });
        });

        assertThrows("PARTITION-NOT-SUPPORTED", "does not support detaching partitions",
            sub() {
                rt.detachPartition("p2");
            });

        MysqlTable bad(ds, "mysql_partition_test_bad");
        bad.setupTable({
            "columns": {
                "id": {"qore_type": Type::Int, "notnull": True},
                "d": {"qore_type": Type::Date, "notnull": True},
            },
            "primary_key": {"name": "mysql_partition_test_bad_pk", "columns": ("id", "d")},
            "partition_strategy": {"method": "range", "columns": "d"},
            "partitions": {
                "p1": {"name": "p1", "bound_sql": "values less than ('2026-02-01')"},
            },
        });
        assertThrows("PARTITION-ERROR", "does not allow \"timestamp\" columns in RANGE COLUMNS partition keys",
            sub() {
                bad.getCreateSql();
        });
    }

    private listPartitionLifecycleTest() {
        if (!table) {
            testSkip("no DB connection");
        }

        AbstractDatasource ds = table.getDatasource();
        code cleanup = sub () {
            ds.execRaw("drop table if exists mysql_partition_list_test");
            ds.commit();
        };
        cleanup();
        on_exit cleanup();

        MysqlTable tmpl(ds, "mysql_partition_list_test");
        tmpl.setupTable({
            "columns": {
                "id": {"qore_type": Type::Int, "notnull": True},
                "region": {"qore_type": Type::String, "size": 8, "notnull": True},
            },
            "primary_key": {"name": "mysql_partition_list_pk", "columns": ("id", "region")},
            "partition_strategy": {"method": "list", "columns": "region"},
            "partitions": {
                "p_eu": {"values": ("eu", "uk")},
                "p_us": {"values": ("us",)},
            },
        });
        assertTrue(tmpl.supportsPartitionMethod("list"), "MySQL supports portable list partitioning");
        assertFalse(tmpl.supportsPartitionMethod("hash"),
            "MySQL does not claim portable explicit modulus/remainder semantics");
        assertFalse(tmpl.supportsPartitionMethod("list", True),
            "MySQL does not claim the recursive portable subpartition contract");
        assertThrows("DESCRIPTION-ERROR", "does not support portable hash partitioning", sub () {
            MysqlTable bad(ds, "mysql_partition_hash_bad");
            bad.setupTable({
                "columns": {"id": {"qore_type": Type::Int}},
                "partition_strategy": {"method": "hash", "columns": "id"},
                "partitions": {"p": {"modulus": 2, "remainder": 0}},
            });
        });
        assertThrows("PARTITION-ERROR", "does not support a portable default list partition", sub () {
            MysqlTable bad(ds, "mysql_partition_list_default_bad");
            bad.setupTable({
                "columns": {"region": {"qore_type": Type::String, "size": 8}},
                "partition_strategy": {"method": "list", "columns": "region"},
                "partitions": {"p": {"is_default": True}},
            });
        });
        assertTrue(tmpl.getCreateSql()[0] =~ /partition by list columns \(region\)/i,
            "MySQL LIST COLUMNS strategy is emitted in CREATE TABLE");
        tmpl.createCommit();

        MysqlTable live(ds, "mysql_partition_list_test");
        assertEq("list", live.getPartitionStrategy().method, "MySQL list strategy is introspected");
        hash<string, PartitionInfo> parts = live.listPartitions();
        assertEq(("eu", "uk"), parts.p_eu.values, "MySQL list values are introspected as typed values");
        hash<PartitionLookupResult> lookup = live.findPartitionBySpec({"values": ("uk", "eu")});
        assertEq(PartitionLookupStatus::Found, lookup.status, "MySQL list lookup is order-insensitive");
        assertEq("p_eu", lookup.partition.name, "MySQL list lookup returns the expected partition");
        hash<PartitionEnsureResult> ensured = live.ensurePartition({"name": "p_eu", "values": ("eu", "uk")});
        assertEq(PartitionVerifiedBy::Definition, ensured.verified_by,
            "MySQL list ensure reports definition verification");

        live.insertCommit({"id": 1, "region": "eu"});
        live.insertCommit({"id": 2, "region": "us"});
        assertEq(1, live.selectRows({"partition": "p_eu"}).size(),
            "MySQL list partition read returns only its values");
        live.addPartitionCommit({"name": "p_apac", "values": ("apac", "au")});
        assertEq(("apac", "au"), live.getPartition("p_apac").values,
            "MySQL list partition can be added and targeted");
        live.truncatePartitionCommit("p_eu");
        assertEq(0, live.selectRows({"partition": "p_eu"}).size(), "MySQL list partition can be truncated");
        live.dropPartitionCommit("p_apac");
        assertNothing(live.getPartition("p_apac"), "MySQL list partition can be dropped");

        hash<auto> desc = live.getDescriptionHash({"with_partitions": True});
        assertEq("list", desc.partition_strategy.method, "MySQL list strategy is recreatable");
        assertEq(("us",), desc.partitions.p_us.values, "MySQL list values are recreatable");
        MysqlTable roundtrip(ds, "mysql_partition_list_copy");
        roundtrip.setupTable(desc);
        assertTrue(roundtrip.getCreateSql()[0] =~ /partition p_us values in \('us'\)/i,
            "MySQL list description regenerates partition DDL");
    }

    #! Returns the alignment SQL of a table described with \a current to a template described with \a template
    private list<auto> alignSql(AbstractDatasource ds, string name, hash<auto> current, hash<auto> template) {
        MysqlTable table(ds, name);
        table.setupTable(current);
        MysqlTable target(ds, name);
        target.setupTable(template);
        return table.getAlignSql(target);
    }

    #! A unique constraint in MySQL is its unique index: a unique index or constraint with other columns is dropped
    #! once and created once, as the SQL shows without a database
    private uniqueColumnChangeSql() {
%ifdef NoMysql
        testSkip("no mysql module");
%endif
        OfflineDatasource ds("mysql:user/pass@db%localhost:1");
        hash<auto> columns = {"columns": {"x": {"native_type": "int"}, "y": {"native_type": "varchar", "size": 10}}};
        assertEq(("alter table db.t drop index ui", "create unique index ui on db.t (y, x)"),
            alignSql(ds, "t", columns + {"indexes": {"ui": {"columns": ("y",), "unique": True}}},
                columns + {"indexes": {"ui": {"columns": ("y", "x"), "unique": True}}}));
        assertEq(("alter table db.t drop index uk", "alter table db.t add constraint uk unique (y, x)"),
            alignSql(ds, "t", columns + {"unique_constraints": {"uk": {"columns": ("y",)}}},
                columns + {"unique_constraints": {"uk": {"columns": ("y", "x")}}}));
    }

    #! The same changes on the database: the SQL is run, and the next alignment needs none
    private uniqueColumnChanges() {
        AbstractDatasource ds = table.getDatasource();
        on_exit {
            try {
                ds.execRaw("drop table if exists mysql_ui_test");
                ds.execRaw("drop table if exists mysql_uk_test");
                ds.commit();
            } catch (hash<ExceptionInfo> ex) {
            }
        }
        ds.execRaw("drop table if exists mysql_ui_test");
        ds.execRaw("drop table if exists mysql_uk_test");
        ds.execRaw("create table mysql_ui_test (x int, y varchar(10))");
        ds.execRaw("create unique index ui_mysql_ui_test on mysql_ui_test (y)");
        ds.execRaw("create table mysql_uk_test (x int, y varchar(10), constraint uk_mysql_uk_test unique (y))");
        ds.commit();
        hash<auto> columns = {"columns": {"x": {"native_type": "int"}, "y": {"native_type": "varchar", "size": 10}}};

        # a unique index with other columns
        hash<auto> ui_desc = columns + {"indexes": {"ui_mysql_ui_test": {"columns": ("y", "x"), "unique": True}}};
        MysqlTable ui_table(ds, "mysql_ui_test");
        string ui_name = ui_table.getSqlName();
        assertEq((sprintf("alter table %s drop index ui_mysql_ui_test", ui_name),
            sprintf("create unique index ui_mysql_ui_test on %s (y, x)", ui_name)), alignTable(ds, "mysql_ui_test",
            ui_desc));
        assertEq((), alignTable(ds, "mysql_ui_test", ui_desc));
        assertEq(("y", "x"), (new MysqlTable(ds, "mysql_ui_test")).getIndexes().ui_mysql_ui_test.columns.keys());

        # a unique constraint with other columns
        hash<auto> uk_desc = columns + {"unique_constraints": {"uk_mysql_uk_test": {"columns": ("y", "x")}}};
        MysqlTable uk_table(ds, "mysql_uk_test");
        string uk_name = uk_table.getSqlName();
        assertEq((sprintf("alter table %s drop index uk_mysql_uk_test", uk_name),
            sprintf("alter table %s add constraint uk_mysql_uk_test unique (y, x)", uk_name)),
            alignTable(ds, "mysql_uk_test", uk_desc));
        assertEq((), alignTable(ds, "mysql_uk_test", uk_desc));
        assertEq(("y", "x"),
            (new MysqlTable(ds, "mysql_uk_test")).getConstraints().uk_mysql_uk_test.keys());
    }

    #! A new emulated sequence holds the value before its start value, which the sequence function adds 1 to
    private sequenceSql() {
        assertEq("insert into sqlutil_sequences (name, id) values ('qtest_seq', 4)",
            (new MysqlSequence("sqlutil_sequences", "qtest_seq", 5)).getCreateSql());
        assertEq("insert into sqlutil_sequences (name, id) values ('qtest_seq', 0)",
            (new MysqlSequence("sqlutil_sequences", "qtest_seq")).getCreateSql());
    }

    #! An emulated sequence gives its start value first, as a database sequence does
    private sequenceStartTest() {
        AbstractDatasource ds = table.getDatasource();
        MysqlDatabase db(ds);
        on_exit {
            try {
                db.dropSequenceIfExists("qtest_mysql_seq");
                ds.commit();
            } catch (hash<ExceptionInfo> ex) {
            }
        }
        db.dropSequenceIfExists("qtest_mysql_seq");
        map ds.execRaw($1), db.getAlignSql({"sequences": {"qtest_mysql_seq": {"start": 5}}});
        ds.commit();
        assertEq(5, db.getNextSequenceValue("qtest_mysql_seq"));
        assertEq(6, db.getNextSequenceValue("qtest_mysql_seq"));
    }

    #! Creates a parent table with a unique index on code and a child table whose foreign constraint references it
    private createReferencedKey(AbstractDatasource ds) {
        ds.execRaw("drop table if exists fk_key_child");
        ds.execRaw("drop table if exists fk_key_parent");
        ds.execRaw("create table fk_key_parent (id int not null primary key, code varchar(10), x int)");
        ds.execRaw("create unique index ui_fk_key_parent on fk_key_parent (code)");
        ds.execRaw("create table fk_key_child (id int not null primary key, code varchar(10), x int, "
            "constraint fk_key_child foreign key (code) references fk_key_parent (code))");
        ds.commit();
    }

    #! Drops the parent and child tables
    private dropReferencedKey(AbstractDatasource ds) {
        try {
            ds.rollback();
            ds.execRaw("drop table if exists fk_key_child");
            ds.execRaw("drop table if exists fk_key_parent");
            ds.commit();
        } catch (hash<ExceptionInfo> ex) {
        }
    }

    #! Returns the schema of the parent and child tables, in the given order, with the given columns of the parent's
    #! unique index and of the child's foreign constraint
    private hash<auto> keySchema(bool child_first, list<string> key_columns, list<string> fk_columns) {
        hash<auto> columns = {
            "id": {"native_type": "int", "notnull": True},
            "code": {"native_type": "varchar", "size": 10},
            "x": {"native_type": "int"},
        };
        hash<auto> parent = {
            "columns": columns,
            "primary_key": {"name": "PRIMARY", "columns": ("id",)},
            "indexes": {"ui_fk_key_parent": {"columns": key_columns, "unique": True}},
        };
        hash<auto> child = {
            "columns": columns,
            "primary_key": {"name": "PRIMARY", "columns": ("id",)},
            "foreign_constraints": {"fk_key_child": {"columns": fk_columns, "table": "fk_key_parent",
                "target_columns": fk_columns}},
        };
        return {"tables": child_first
            ? {"fk_key_child": child, "fk_key_parent": parent}
            : {"fk_key_parent": parent, "fk_key_child": child}};
    }

    #! Aligns the schema with an SQL callback that records each statement, and runs the SQL
    private list<auto> alignSchema(AbstractDatasource ds, hash<auto> schema, reference<list<string>> called) {
        Database db(ds);
        list<auto> sql = db.getAlignSql(schema, {"sql_callback": sub (string str) { called += str; }});
        on_success ds.commit();
        on_error ds.rollback();
        map ds.execRaw($1), sql;
        return sql;
    }

    #! A unique key that a foreign constraint references, changed with the foreign constraint, is aligned in either
    #! order of the tables: the foreign constraint is dropped first and added after the key
    private referencedKeyChanges() {
        AbstractDatasource ds = table.getDatasource();
        on_exit dropReferencedKey(ds);
        foreach bool child_first in ((True, False)) {
            createReferencedKey(ds);
            string parent_name = (new MysqlTable(ds, "fk_key_parent")).getSqlName();
            string child_name = (new MysqlTable(ds, "fk_key_child")).getSqlName();
            list<string> called = ();
            hash<auto> schema = keySchema(child_first, ("code", "x"), ("code", "x"));
            assertEq((
                sprintf("alter table %s drop foreign key fk_key_child", child_name),
                sprintf("alter table %s drop index ui_fk_key_parent", parent_name),
                sprintf("create unique index ui_fk_key_parent on %s (code, x)", parent_name),
                sprintf("alter table %s add constraint fk_key_child foreign key (code, x) references fk_key_parent "
                    "(code, x)", child_name),
            ), alignSchema(ds, schema, \called), sprintf("child first: %y", child_first));
            assertEq((), alignSchema(ds, schema, \called), sprintf("child first: %y", child_first));
        }
    }

    #! A template that changes a unique key that a foreign constraint references, but not the foreign constraint, is
    #! refused before any SQL, in either order of the tables
    private inconsistentTemplates() {
        AbstractDatasource ds = table.getDatasource();
        on_exit dropReferencedKey(ds);
        foreach bool child_first in ((True, False)) {
            createReferencedKey(ds);
            list<string> called = ();
            assertThrows("FOREIGN-CONSTRAINT-ERROR", "^foreign constraint \"fk_key_child\" of table \"fk_key_child\" "
                "references the columns \\(code\\) of table \"fk_key_parent\", whose template changes its unique key "
                "\"ui_fk_key_parent\" on them to \\(code, x\\): the foreign constraint would not reference a unique "
                "key; change the foreign constraint with the key$", \alignSchema(),
                (ds, keySchema(child_first, ("code", "x"), ("code",)), \called),
                sprintf("child first: %y", child_first));
            assertEq((), called, "no SQL was run");
        }
    }

    #! Aligns the table to a template with the description, runs the SQL in the database and returns it
    private list<auto> alignTable(AbstractDatasource ds, string name, hash<auto> desc) {
        MysqlTable template(ds, name);
        template.setupTable(desc);
        MysqlTable current(ds, name);
        list<auto> sql = current.getAlignSql(template);
        on_success ds.commit();
        on_error ds.rollback();
        map ds.execRaw($1), sql;
        return sql;
    }

    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-c,--conn=ARG", "set DB connection argument (ex: \"mysql:user/pass@db\")", OptionColumn);
    }

    Datasource getDatasource() {
        if (!m_options.connstr)
            m_options.connstr = ENV.QORE_DB_CONNSTR_MYSQL;
        Datasource ds(m_options.connstr);
        if (ds.getDriverName() != "mysql")
            throw "MYSQL-ERROR", sprintf("cannot execute the mysql tests on a connection using driver %y", ds.getDriverName());
        ds.open();
        return ds;
    }
}

#! A datasource that reports a server version without connecting, to get SQL without a database
class OfflineDatasource inherits Datasource {
    constructor(string connstr) : Datasource(connstr) {
    }

    auto getServerVersion() {
        return 110400;
    }
}
