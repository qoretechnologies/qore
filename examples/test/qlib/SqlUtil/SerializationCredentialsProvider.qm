%modern

%requires DbDataProvider
%requires ConnectionProvider

#! the connection provider of SerializationCredentials.qtest: a datasource connection and an HTTP connection
module SerializationCredentialsProvider {
    version = "1.0";
    desc = "test connection provider for SerializationCredentials.qtest";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
}

/*  The database file of the datasource connection is given in the SQLUTIL_7016_DB environment variable; getenv() is
    used, as the module is loaded into a Program of its own, whose ENV is a snapshot taken when it is created
*/

public ConnectionProvider::AbstractConnection sub get_mod_connection(string name) {
    switch (name) {
        case "conn7016":
            return new DbDataProvider::DatasourceConnection(name, "test datasource connection",
                "db://sqlite3:scott-user-7016/tiger-pass-7016@" + getenv("SQLUTIL_7016_DB"));
        case "http7016":
            return new ConnectionProvider::HttpConnection(name, "test HTTP connection", "http://localhost:1");
    }
    throw "CONNECTION-ERROR", sprintf("connection %y is unknown to the test connection provider", name);
}

public *hash<string, ConnectionProvider::AbstractConnection> sub get_mod_connections() {
    hash<string, ConnectionProvider::AbstractConnection> rv();
    foreach string name in (("conn7016", "http7016")) {
        rv{name} = get_mod_connection(name);
    }
    return rv;
}
