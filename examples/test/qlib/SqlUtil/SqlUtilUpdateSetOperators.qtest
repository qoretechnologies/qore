#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%prepend-module-path "${SCRIPT_DIR}"
%requires QUnit
%requires SqlUtil
%requires ./PgsqlTestIsolation.qm

%try-module sqlite3
%define NoSqlite3
%endtry

%try-module pgsql
%define NoPgsql
%endtry

%exec-class SqlUtilUpdateSetOperatorsTest

#! Tests the operators in the set clause of an update (issue #2962)
/** A column operator or a where operator in the set clause raises \c UPDATE-ERROR, which names the update operators
    to use instead; it raised \c INVALID-MEMBER for the missing \c "uop" key.  The tests run on SQLite, and on
    PostgreSQL in a schema of their own when \c QORE_DB_CONNSTR_PGSQL is set.
*/
class SqlUtilUpdateSetOperatorsTest inherits QUnit::Test {
    private {
        *Datasource pgsql;
    }

    constructor() : Test("SqlUtilUpdateSetOperators", "1.0", \ARGV) {
        addTestCase("SQLite: operators in the set clause", \sqliteSet());
        addTestCase("PostgreSQL: operators in the set clause", \pgsqlSet());
        set_return_value(main());
    }

    globalSetUp() {
%ifndef NoPgsql
        if (ENV.QORE_DB_CONNSTR_PGSQL) {
            PgsqlRunSchema::setup(ENV.QORE_DB_CONNSTR_PGSQL, "SqlUtilUpdateSetOperators");
            pgsql = new Datasource(ENV.QORE_DB_CONNSTR_PGSQL);
            setupTable(pgsql);
        }
%endif
    }

    globalTearDown() {
        if (pgsql) {
            pgsql.rollback();
            delete pgsql;
            PgsqlRunSchema::teardown();
        }
    }

    private static setupTable(Datasource ds) {
        ds.exec("create table uso_cnt (objectid integer not null primary key, status varchar(1), total_count integer)");
        ds.exec("insert into uso_cnt values (1, 'C', 10), (2, 'C', 20)");
        ds.commit();
    }

    sqliteSet() {
%ifdef NoSqlite3
        testSkip("no sqlite3 module");
%endif
        Datasource ds("sqlite3:x@:memory:");
        on_exit ds.rollback();
        setupTable(ds);
        checkSet(ds);
    }

    pgsqlSet() {
%ifdef NoPgsql
        testSkip("no pgsql module");
%endif
        if (!pgsql) {
            testSkip("QORE_DB_CONNSTR_PGSQL is not set");
        }
        on_exit pgsql.rollback();
        checkSet(pgsql);
    }

    private checkSet(Datasource ds) {
        Table t(ds, "uso_cnt");
        hash<auto> cond = {"objectid": 1, "status": "C"};

        # the example of the issue: a column operator
        assertThrows("UPDATE-ERROR", "column \"total_count\": column operators \\(\"plus\" given\\) are not "
            "supported in the set clause.*uop_plus", sub () {
                t.update({"total_count": cop_plus("total_count", cop_value(5))}, cond);
            });
        assertThrows("UPDATE-ERROR", "column operators \\(\"upper\" given\\)", sub () {
            t.getUpdateSql({"status": cop_upper("status")}, cond);
        });
        # a where operator
        assertThrows("UPDATE-ERROR", "where operators \\(\">\" given\\) are not supported in the set clause",
            sub () { t.update({"total_count": op_gt(5)}, cond); });
        assertEq(({"total_count": 10}, {"total_count": 20}),
            ds.selectRows("select total_count from uso_cnt order by objectid"));

        # the update operator does it
        string sql;
        assertEq(1, t.update({"total_count": uop_plus(5)}, cond, \sql));
        assertRegex("^update .*uso_cnt set total_count = total_count \\+ 5 where ", sql);
        # an untyped update operator hash and a plain value, as before
        assertEq(1, t.update({"total_count": {"uop": COP_PLUS, "arg": 1}, "status": "D"}, cond - "status"));
        assertEq(({"objectid": 1, "status": "D", "total_count": 16}, {"objectid": 2, "status": "C", "total_count": 20}),
            ds.selectRows("select * from uso_cnt order by objectid"));
        ds.rollback();
    }
}
