#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%prepend-module-path "${SCRIPT_DIR}"
%requires ../../../../qlib/Util.qmod
%requires ../../../../qlib/Logger.qmod
%requires ../../../../qlib/DataProvider/DataProvider.qmod
%requires ../../../../qlib/SqlUtil/SqlUtil.qmod
%requires ../../../../qlib/OracleSqlUtil.qmod

%requires ./SqlUtilTestBase.qm

%try-module oracle
%define NoOracle
%endtry

%exec-class OracleTest

class OracleTestSchema inherits SqlUtilTestSchema {
    public {
        const SchemaName = "OracleTestSchema";
        const SchemaVersion = "1.0";
    }

    private {
        const GenericOptions = (
            "replace": True,
        );

        const IndexOptions = {};

        const ColumnOptions = (
            "character_semantics": True,
        );

        const T_OracleTest = (
            "columns": (
                "id": c_number(14, True, "an example comment with 'quotes'"),
                "id_": c_number(14, True),
                "null_f": c_varchar(69),
                "blob_f": c_blob(True),
                "clob_f": c_clob(True),
                # data for test of driver specific opts merged into tolevel hash
                "drv_test" : (
                    "qore_type" : SqlUtil::VARCHAR,
                    "size" : 1,
                    "driver" : (
                        "oracle" : (
                            "qore_type" : SqlUtil::NUMERIC,
                        ),
                    ),
                ),
                # default value test for
                # SqlUtil: schema alignment: default values can be complex statement instead of simple value only #1428
                "def_test1" : c_date(C_NOT_NULL) + ("driver" : ("oracle" : ("default_value" : "to_date('1.1.2000', 'dd.mm.yyyy')", "default_value_native" : True))),
                "def_test2" : c_number(C_NOT_NULL) + ( "default_value" : 0 ),
                # issue #1684: sqlutil: schema alignment skips column with name "driver"
                "driver" : c_number(),
                # issue #3400: column names with reserved words are not quoted
                "level": c_number(1, "test comment"),
            ),
            "primary_key": ("name": "pk_oracle_test", "columns": ("id")),
            "indexes": {
                "oracle_test_func_ix": {"columns": "def_test2 desc"},
                "uk_oracle_test": {"columns": ("id", "level")},
            },
        );

        const T_OracleTest2 = {
            "columns": {
                "id": c_number(14, True),
                "string": c_varchar(20, True),
            },
            "primary_key": {"name": "pk_oracle_test2", "columns": "id"},
        };

        # bug #1688: sqlutil: oracle: character_semantics can be
        # different for each column, not only for the whole schema
        # BYTE semantics is forced here because global character_semantics = True
        const T_OracleTestSemantics = (
            "columns" : (
                "c_char" : c_varchar(1) + ( "character_semantics" : True ),
                "c_byte" : c_varchar(1) + ( "character_semantics" : False ),
            ),
        );

        const Tables = (
            "oracle_test": T_OracleTest,
            "oracle_test2": T_OracleTest2,
            # these tables are real tables without CustomColumns, so these should not be enhanced
            #"oracle_test_semantics" : T_OracleTestSemantics,
        );

        const Sequences = (
            "oracle_test_seq": {},
        );

        const Functions = (
            "oracle_test_func" : "oracle_test_func(in_foo in number) return number is begin return in_foo; end;",
        );

        const Types = (
            "oracle_test_object" : "object ( id number )",
            "oracle_test_coll" : "table of oracle_test_object",
        );
    }

    constructor(AbstractDatasource ds, *string dts, *string its) : SqlUtilTestSchema(ds, dts, its) {
    }

    private string getNameImpl() {
        return SchemaName;
    }

    private string getVersionImpl() {
        return SchemaVersion;
    }

    private *hash<auto> getTablesImpl() {
        hash<auto> tables = Tables;

        if (hasSdoGeometry(ds)) {
            # SDO_GEOMETRY test: OracleSqlUtil does not support spatial data types #1465
            # actually it tests it for any named type
            tables.oracle_test.columns.location = {"native_type": "sdo_geometry"};
        }

        return doTables(tables, OracleTest::CustomColumns) + (
            "oracle_test_semantics" : T_OracleTestSemantics,
            "test_analytic_functions" : T_TestAnalyticFunctions,
        );
    }

    private *hash<auto> getSequencesImpl() {
        return Sequences;
    }

    private *hash<auto> getIndexOptionsImpl() {
        return IndexOptions;
    }

    private *hash<auto> getGenericOptionsImpl() {
        return GenericOptions;
    }

    private *hash<auto> getColumnOptionsImpl() {
        return ColumnOptions;
    }

    private *hash<auto> getFunctionsImpl() {
        return Functions;
    }

    private *hash<auto> getTypesImpl() {
        return Types;
    }

    static bool hasSdoGeometry(AbstractDatasource ds) {
        return ds.select("select object_name from all_objects where object_type = %v and object_name = %v",
            "TYPE", "SDO_GEOMETRY").object_name[0].val();
    }
}

class OracleByteSchema inherits OracleTestSchema {
    constructor(AbstractDatasource ds, *string dts, *string its) : OracleTestSchema(ds, dts, its) {
    }

    private *hash<auto> getColumnOptionsImpl() {
    }
}

class OracleTest inherits SqlTestBase {
    public {
        const CustomColumns = (
            "varchar2": (
                "value": "hello",
                "size": "20",
            ),
            "char": (
                "value": "hello",
                "size": "20",
                "expect": rpad ("hello", 20),
            ),
            "number": (
                "size": 15,
                "scale": 2,
                "value": 400.95n,
            ),
            "number_def": (
                "type": "number",
                "value": 400.95n,
            ),
            "date": 2016-01-11,
            "timestamp": 2016-02-11T09:26:14.502134,
            # why are the timestamp with * time zone tests failing during DST?
            #"timestamp with time zone": 2016-02-11T09:26:14.502134,
            #"timestamp with local time zone": 2016-02-11T09:26:14.502134,
            #"interval year to month": 2Y + 6M,
            #"interval day to second": 2D + 3h + 4m + 1s,
            "clob": "test",
            "blob": <bead>,
            "binary_float": 1.5,
            "binary_double": 1.5,
            #raw
            #bfile
            #long
        );

        AbstractTable table2;
    }

    constructor() : SqlTestBase("OracleTest", "1.0", \ARGV, MyOpts) {
        Datasource ds;
        try {
            ds = getDatasource();
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose)
                printf("%s: %s\n", ex.err, ex.desc);
            # skip tests if we can't create the datasource
        }

        if (ds) {
            # create dummy objects to test drop/create functionality of schema alignment
            on_exit ds.commit();
            ds.execRaw("create or replace function oracle_test_func(in_foo in number) return number is begin return 1; end");
            ds.execRaw("begin execute immediate 'drop type oracle_test_object force'; exception when others then null; end;");
            ds.execRaw("create type oracle_test_object as object (id date)");
            ds.execRaw("begin execute immediate 'drop type oracle_test_coll force'; exception when others then null; end;");
            ds.execRaw("create type oracle_test_coll as table of oracle_test_object");

            initTestData(CustomColumns);

            { # Make sure the DB is clear before doing the tests.
                OracleTable t = new OracleTable(ds, "oracle_test");
                if (t.checkExistence())
                    t.dropCommit();
            }

            # create the test schema
            schema = new OracleTestSchema(ds);

            schema.align(False, m_options.verbose, m_options.verbose > 0);

            # get table object
            table = (new Table(schema.getDatasource(), "oracle_test")).getTable();
            table2 = (new Table(schema.getDatasource(), "oracle_test2")).getTable();

            addTestCase("rowid test", \rowidTest());
            addTestCase("rownum test", \rownumTest());
            addTestCase("for update and limit", \forupdateAndLimitTest());
            addTestCase("issue 2795", \issue2785());
            addTestCase("sequence operators", \testSequenceOperators());
            addTestCase("pseudo-columns", \testPseudoColumns());
            addTestCase("character semantics", \testCharacterSemantics());
            addTestCase("driver specific opts for columns", \testDriverSpecificColumns());
            addTestCase("default values", \testDefaultValues());
            addTestCase("named types to align", \testNTYAlignment());
            addTestCase("bug 1684 'driver' column name", \testDriverColumnName());
            addTestCase("issue 2163", \issue2163());
            addTestCase("analytic/window functions", \testAnalyticFunctions());
            addTestCase("custom column operators #2314", \testCustomColumnOperators());
            addTestCase("chained synonyms #2408", \testChainedSynonyms());
            addTestCase("range partition lifecycle", \rangePartitionLifecycleTest());
            addTestCase("partition-local indexes and constraints", \partitionLocalIndexTest());
        }

        set_return_value(main());
    }

    rowidTest() {
        if (!table)
            testSkip("no DB connection");

        hash<auto> sh = {
            "columns": ("rowid", "id"),
            "where": ("t2.rowid": "xxx"),
            "join": join_inner(table2, "t2", ("id": "id")),
        };
        on_error printf("SQL: %s\n", table.getSelectSql(sh));
        list<hash<auto>> q = table.selectRows(sh);
        assertEq(0, q.size());
    }

    rownumTest() {
        if (!table)
            testSkip("no DB connection");

        hash<auto> sh = {
            "comment": " from a_table where something > 1",
            "where": {
                "rownum": 1,
            },
        };
        hash<auto> row = table.selectRow(sh);
        assertEq("hash", row.type());
    }

    forupdateAndLimitTest() {
        if (!table)
            testSkip("no DB connection");

        hash<auto> sh = {
            "comment": " from a_table where something > 1",
            "where": {
                "id": op_in(1, 2, 3),
            },
            "limit": 2,
            "forupdate": True,
        };

        table.getDatasource().beginTransaction();
        on_exit table.rollback();

        hash<SqlResultInfo> rv = table.selectRowsWithInfo(sh);
        assertEq(2, rv.result.size());
    }

    issue2785() {
        if (!table)
            testSkip("no DB connection");

        hash sh = {
            "where": {
                "id": op_in(1, 2, 3),
            },
        };

        SQLStatement stmt = table.getRowIteratorNoExec(sh);
        # make sure this does not throw an ORA-22905 error
        hash h = stmt.describe();
        assertEq(Type::Hash, h.type());
    }

    testCharacterSemantics() {
        if (!table)
            testSkip("no DB connection");

        AbstractDatasource ds = table.getDatasource();

        assertEq(True, schema.getColumnOptions().character_semantics, "character_semantics value in schema");

        hash c = ds.selectRow("select * from user_tab_columns where table_name = %v and column_name = %v", "ORACLE_TEST", "VARCHAR2_F");
        # it must be C (CHAR) in case of character_semantics=True, B is for BYTE
        assertEq("C", c.char_used, "character_semantics from data dictionary");

        # align schema with byte semantics
        OracleByteSchema byte_schema(ds);
        byte_schema.align(True, m_options.verbose, m_options.verbose > 0);

        c = ds.selectRow("select * from user_tab_columns where table_name = %v and column_name = %v", "ORACLE_TEST", "VARCHAR2_F");
        # it must be C (CHAR) in case of character_semantics=True, B is for BYTE
        assertEq("B", c.char_used, "character_semantics after alignment");

        # align schema with character semantics
        schema.align(True, m_options.verbose, m_options.verbose > 0);

        c = ds.selectRow("select * from user_tab_columns where table_name = %v and column_name = %v", "ORACLE_TEST", "VARCHAR2_F");
        # it must be C (CHAR) in case of character_semantics=True, B is for BYTE
        assertEq("C", c.char_used, "character_semantics after alignment");

        # bug #1688: sqlutil: oracle: character_semantics can be
        # different for each column, not only for the whole schema
        # BYTE semantics is forced here because global character_semantics = True
        c = ds.selectRow("select * from user_tab_columns where table_name = %v and column_name = %v",
                         "ORACLE_TEST_SEMANTICS", "C_CHAR");
        assertEq("C", c.char_used, "character_semantics CHAR enforced");
        c = ds.selectRow("select * from user_tab_columns where table_name = %v and column_name = %v",
                         "ORACLE_TEST_SEMANTICS", "C_BYTE");
        assertEq("B", c.char_used, "character_semantics BYTE enforced");
    }

    testSequenceOperators() {
        if (!table)
            testSkip("no DB connection");

        hash sh = (
            "columns": ("id", cop_seq("oracle_test_seq", "seq"), cop_seq_currval("oracle_test_seq", "seq_currval")),
            "where": ("id": 2),
            );

        assertEq(("id": 2, "seq": 1, "seq_currval": 1), table.selectRow(sh));
        assertEq(("id": 2, "seq": 2, "seq_currval": 2), table.selectRow(sh));
        assertEq(("id": 2, "seq": 3, "seq_currval": 3), table.selectRow(sh));

        assertEq(1, table.update(("id": uop_seq("oracle_test_seq")), ("id": 2)));
        sh."where".id = 4;
        assertEq(("id": 4, "seq": 5, "seq_currval": 5), table.selectRow(sh));
    }

    testPseudoColumns() {
        if (!table)
            testSkip("no DB connection");

        hash sh = (
            "columns": ("rowid", "*"),
            "limit": 1,
            );

        assertEq(Type::String, table.selectRow(sh).rowid.type());
    }

    testDriverSpecificColumns() {
        if (!table)
            testSkip("no DB connection");

        AbstractDatasource ds = table.getDatasource();
        hash c = ds.selectRow("select * from user_tab_columns where table_name = %v and column_name = %v", "ORACLE_TEST", "DRV_TEST");
        assertEq("NUMBER", c.data_type);
    }

    testDefaultValues() {
        if (!table)
            testSkip("no DB connection");

        AbstractDatasource ds = table.getDatasource();
        hash c = ds.selectRow("select * from user_tab_columns where table_name = %v and column_name = %v", "ORACLE_TEST", "DEF_TEST1");
        assertEq("to_date('1.1.2000', 'dd.mm.yyyy') ", c.data_default);

        c = ds.selectRow("select * from user_tab_columns where table_name = %v and column_name = %v", "ORACLE_TEST", "DEF_TEST2");
        assertEq("0 ", c.data_default);
    }

    testNTYAlignment() {
        if (!table)
            testSkip("no DB connection");

        AbstractDatasource ds = table.getDatasource();
        if (!OracleTestSchema::hasSdoGeometry(ds)) {
            testSkip("no spacial types in DB");
        }
        hash<auto> c = ds.selectRow("select * from user_tab_columns where table_name = %v and column_name = %v", "ORACLE_TEST", "LOCATION");
        assertEq("SDO_GEOMETRY", c.data_type);
    }

    testDriverColumnName() {
        if (!table)
            testSkip("no DB connection");

        AbstractDatasource ds = table.getDatasource();
        *hash c = ds.selectRow("select * from user_tab_columns where table_name = %v and column_name = %v", "ORACLE_TEST", "DRIVER");
        assertEq(True, exists c, "column 'driver' must exist in the table");
    }

    issue2163() {
        if (!table)
            testSkip("no DB connection");

        string sql;
        on_error printf("SQL: %s\n", sql);

        Columns cols = table.describe();
        list<string> cl = cols.keys();

        string col1 = cl[0];
        string col2 = cl[1];
        hash<auto> sh = {
            "columns": (col1, col2, cop_as(cop_over(cop_max(col2), col1), "max_val")),
            "superquery": {
                "columns": (cop_distinct(col1), col2),
                "where": {"max_val": op_ceq(col2)},
            },
        };
        assertEq(Type::List, table.selectRows(sh, \sql).type());
    }

    testCustomColumnOperators() {
        if (!table)
            testSkip("no DB connection");

        # negative test
        try {
            table.addCustomCopOperator("as", hash());
        } catch (hash<ExceptionInfo> ex) {
            assertEq("CUSTOM-OPERATOR-ERROR", ex.err, "Operator 'as' must be already registered");
        }

        # regular test
        hash to_char = (
            "code" : string sub(string arg1, auto arg) {
                 return sprintf("to_char(%s, '%s')", arg1, arg);
             },
        );

        table.addCustomCopOperator("to_char", to_char);

        hash sh = (
            "columns" : ( cop_as(SqlUtil::make_cop("to_char", "date_f", "yyyymmdd"), "date_to_char"),
                          # test oracle specific operator because I changed getColumnOperatorMap too
                          cop_year("date_f"),
                        ),
            "limit" : 1,
        );

        string sql;
        on_error {
            printf("custom op sql: %s\n", sql);
        }

        hash<auto> res = table.selectRow(sh, \sql);
        assertEq("20160111", res.date_to_char, "Date format test from to_char");
    }

    # CREATE SYNONYM system priv is required for this test
    testChainedSynonyms() {
        if (!table)
            testSkip("no DB connection");

        AbstractDatasource ds = table.getDatasource();
        on_exit {
            try {
                ds.exec("drop synonym oracle_test_syn3");
            } catch (hash<auto> ex) {}
            try {
                ds.exec("drop synonym oracle_test_syn2");
            } catch (hash<auto> ex) {}
            try {
                ds.exec("drop synonym oracle_test_syn1");
            } catch (hash<auto> ex) {}
            try {
                ds.exec("drop table test_oracle_syn");
            } catch (hash<auto> ex) {}
        }

        ds.exec("create table test_oracle_syn (dummy varchar2(1))");
        ds.exec("insert into test_oracle_syn values ('X')");
        # issue #2757 OracleSqlUtil: synonym resolving can fail with duplicated object name
        # some people are crazy to create objects with the same name for table and eg. index
        ds.exec("create index test_oracle_syn on test_oracle_syn (dummy)");
        ds.exec("create or replace synonym oracle_test_syn1 for test_oracle_syn");
        ds.exec("create or replace synonym oracle_test_syn2 for oracle_test_syn1");
        ds.exec("create or replace synonym oracle_test_syn3 for oracle_test_syn2");

        Table t(ds, "oracle_test_syn3");
        assertEq("X", t.selectRow().dummy, "dummy must be resolved, returning X");
    }

    private rangePartitionLifecycleTest() {
        if (!table) {
            testSkip("no DB connection");
        }

        AbstractDatasource ds = table.getDatasource();
        ds.execRaw("begin execute immediate 'drop table oracle_partition_test purge'; exception when others then "
            "null; end;");
        ds.execRaw("begin execute immediate 'drop table oracle_partition_interval_alignment purge'; exception when "
            "others then null; end;");
        ds.execRaw("begin execute immediate 'drop table oracle_partition_global_unique purge'; exception when "
            "others then null; end;");
        ds.commit();

        on_exit {
            try {
                ds.execRaw("begin execute immediate 'drop table oracle_partition_test purge'; exception when others "
                    "then null; end;");
                ds.execRaw("begin execute immediate 'drop table oracle_partition_interval_alignment purge'; "
                    "exception when others then null; end;");
                ds.execRaw("begin execute immediate 'drop table oracle_partition_global_unique purge'; exception "
                    "when others then null; end;");
                ds.commit();
            } catch (hash<ExceptionInfo> ex) {
            }
        }

        OracleTable t(ds, "oracle_partition_test");
        t.setupTable({
            "columns": {
                "id": {"qore_type": Type::Int, "notnull": True},
                "d": {"qore_type": Type::Date, "notnull": True},
                "v": {"qore_type": Type::String, "size": 20},
            },
            # Oracle global PK/unique indexes do not have to contain the partition key.
            "primary_key": {"name": "oracle_partition_test_pk", "columns": "id"},
            "indexes": {"oracle_partition_test_uk": {"columns": ("id", "v"), "unique": True}},
            "partition_strategy": {"method": "range", "columns": "d"},
            "partitions": {
                "p1": {"name": "p1",
                    "bound_sql": "values less than (TO_DATE('2026-02-01', 'YYYY-MM-DD'))"},
                "p2": {"name": "p2", "bound_from": "2026-02-01", "bound_to": "2026-03-01"},
            },
        });
        t.createCommit();

        OracleTable rt(ds, "oracle_partition_test");
        assertEq(True, rt.supportsPartitions());
        assertEq(False, rt.supportsPartitionDetach());

        hash<PartitionStrategy> strategy = rt.getPartitionStrategy();
        assertEq("range", strategy.method);
        assertEq(1, strategy.columns.size());
        assertEq("d", strategy.columns[0]);

        hash<string, PartitionInfo> parts = rt.listPartitions();
        assertEq(2, parts.size());
        assertEq(2026-02-01, parts.p2.bound_from);
        assertEq(2026-03-01, parts.p2.bound_to);

        hash<auto> desc = rt.getDescriptionHash({"with_partitions": True});
        assertEq(2, desc.partitions.size());
        assertFalse(desc.partitions.p1.hasKey("ordinal"));
        assertFalse(desc.partitions.p1.hasKey("sql_name"));
        assertTrue(desc.partitions.p1.hasKey("bound_sql"));
        assertFalse(desc.partitions.p1.hasKey("bound_to_sql"));
        assertTrue(desc.partitions.p2.hasKey("bound_from"));
        assertFalse(desc.partitions.p2.hasKey("bound_sql"));
        assertTrue(rt.getCreateSql()[0] =~ /partition by range/i);

        assertEq((), rt.getAlignSql(t), "table aligns with the schema used to create it");
        OracleTable reverse_template(ds, "oracle_partition_test");
        reverse_template.setupTable(desc);
        assertEq((), rt.getAlignSql(reverse_template), "reverse-engineered partition schema aligns unchanged");

        # A global Oracle unique constraint is also valid without the partition key.  Exercise its actual DDL in a
        # separate table because getDescriptionHash() intentionally does not export unique constraints.
        OracleTable global_unique(ds, "oracle_partition_global_unique");
        global_unique.setupTable({
            "columns": {
                "id": {"qore_type": Type::Int, "notnull": True},
                "d": {"native_type": "date", "notnull": True},
                "v": {"qore_type": Type::String, "size": 20},
            },
            "primary_key": {"name": "oracle_partition_global_unique_pk", "columns": "id"},
            "unique_constraints": {"oracle_partition_global_unique_uc": {"columns": "v"}},
            "partition_strategy": {"method": "range", "columns": "d"},
            "partitions": {"pmax": {"bound_sql": "values less than (MAXVALUE)"}},
        });
        global_unique.createCommit();
        OracleTable global_unique_rt(ds, "oracle_partition_global_unique");
        assertTrue(global_unique_rt.getConstraints().hasKey("oracle_partition_global_unique_uc"),
            "global unique constraint omitting the partition key is materialized");
        global_unique_rt.dropCommit();

        hash<auto> changed_strategy_desc = {} + desc;
        changed_strategy_desc.partition_strategy = {} + desc.partition_strategy;
        changed_strategy_desc.partition_strategy.auto = {"expression": "NUMTOYMINTERVAL(2, 'MONTH')"};
        OracleTable changed_strategy(ds, "oracle_partition_test");
        changed_strategy.setupTable(changed_strategy_desc);
        assertThrows("PARTITION-ERROR", "normalized desired", sub () {
            rt.getAlignSql(changed_strategy);
        });

        hash<PartitionLookupResult> lookup = rt.findPartitionBySpec({
            "bound_from": 2026-02-01,
            "bound_to": 2026-03-01,
        });
        assertEq(PartitionLookupStatus::Found, lookup.status);
        assertEq("p2", lookup.partition.name);
        assertThrows("PARTITION-ERROR", "must start at the preceding upper bound", sub () {
            rt.getAddPartitionSql({"name": "pgap", "bound_from": 2026-03-15, "bound_to": 2026-04-01});
        });
        assertThrows("PARTITION-ERROR", "bounds overlap existing partition", sub () {
            rt.getAddPartitionSql({"name": "poverlap", "bound_from": 2026-02-15, "bound_to": 2026-03-15});
        });
        assertThrows("PARTITION-ERROR", "lower bound must be less than upper bound", sub () {
            rt.getAddPartitionSql({"name": "preversed", "bound_from": 2026-04-01, "bound_to": 2026-03-01});
        });

        hash<PartitionEnsureResult> ensure = rt.ensurePartitionCommit({
            "name": "p3",
            "bound_from": 2026-03-01,
            "bound_to": 2026-04-01,
        });
        assertEq(True, ensure.created);
        assertEq(True, ensure.materialized);
        assertEq(PartitionVerifiedBy::Bounds, ensure.verified_by);
        assertEq("p3", ensure.partition.name);
        assertEq(2026-03-01, ensure.partition.bound_from);
        assertEq(2026-04-01, ensure.partition.bound_to);
        assertEq(True, rt.listPartitions().hasKey("p3"));

        ds.execRaw("insert into oracle_partition_test values (3, timestamp '2026-03-15 00:00:00', 'x')");
        ds.commit();
        assertEq(1, ds.selectRow("select count(*) c from oracle_partition_test partition (p3)").c);
        rt.truncatePartitionCommit("p3");
        assertEq(0, ds.selectRow("select count(*) c from oracle_partition_test partition (p3)").c);

        rt.dropPartitionCommit("p3");
        assertEq(False, rt.listPartitions().hasKey("p3"));

        # ensurePartition() concurrent-create race (Oracle auto-commits DDL, so no savepoint is used): prime a
        # stale cache on a second handle, create the partition out of band, then ensurePartition must treat the
        # duplicate ADD PARTITION as success
        OracleTable racer(ds, "oracle_partition_test");
        racer.listPartitions();
        rt.ensurePartitionCommit({"name": "p4", "bound_from": 2026-03-01, "bound_to": 2026-04-01});
        hash<PartitionEnsureResult> raced = racer.ensurePartitionCommit({
            "name": "p4",
            "bound_from": 2026-03-01,
            "bound_to": 2026-04-01,
        });
        assertEq(False, raced.created, "ensurePartition() race resolves the duplicate without creating");
        assertEq(True, raced.materialized, "ensurePartition() race resolves to a materialized partition");
        rt.dropPartitionCommit("p4");

        rt.addPartitionCommit({"name": "pmax", "is_default": True});
        assertEq(PartitionLookupStatus::Found, rt.findPartitionBySpec({"is_default": True}).status);
        assertThrows("PARTITION-ERROR", "default partition", sub () {
            rt.getAddPartitionSql({"name": "pmax2", "is_default": True});
        });
        assertThrows("PARTITION-ERROR", "catch-all partition", sub () {
            rt.getAddPartitionSql({"name": "p5", "bound_from": 2026-03-01, "bound_to": 2026-04-01});
        });
        rt.dropPartitionCommit("pmax");

        OracleTable finite_first(ds, "oracle_partition_finite_first");
        assertThrows("PARTITION-ERROR", "cannot declare finite lower bound", sub () {
            finite_first.setupTable({
                "columns": {"d": {"qore_type": Type::Date, "notnull": True}},
                "partition_strategy": {"method": "range", "columns": "d"},
                "partitions": {"p1": {"bound_from": 2026-01-01, "bound_to": 2026-02-01}},
            });
        });

        OracleTable interval_template(ds, "oracle_partition_interval_alignment");
        interval_template.setupTable({
            "columns": {"d": {"qore_type": Type::Date, "notnull": True}},
            "partition_strategy": {
                "method": "range",
                "columns": "d",
                "auto": {"interval": "numtoyminterval(1, 'month')"},
            },
            "partitions": {
                "p0": {"bound_sql": "values less than (TO_DATE('2026-01-01', 'YYYY-MM-DD'))"},
            },
        });
        interval_template.createCommit();

        OracleTable interval_actual(ds, "oracle_partition_interval_alignment");
        assertEq((), interval_actual.getAlignSql(interval_template),
            "equivalent declared and introspected Oracle interval policies align");
        hash<auto> interval_desc = interval_actual.getDescriptionHash({"with_partitions": True});
        OracleTable interval_reverse(ds, "oracle_partition_interval_alignment");
        interval_reverse.setupTable(interval_desc);
        assertEq((), interval_actual.getAlignSql(interval_reverse),
            "reverse-engineered Oracle interval strategy aligns unchanged");

        interval_desc.partition_strategy = {} + interval_desc.partition_strategy;
        interval_desc.partition_strategy.auto = {"expression": "NUMTOYMINTERVAL(2, 'MONTH')"};
        OracleTable changed_interval(ds, "oracle_partition_interval_alignment");
        changed_interval.setupTable(interval_desc);
        assertThrows("PARTITION-ERROR", "normalized desired", sub () {
            interval_actual.getAlignSql(changed_interval);
        });

        assertThrows("PARTITION-NOT-SUPPORTED", "does not support detaching partitions",
            sub() {
                rt.detachPartition("p2");
            });
    }

    private partitionLocalIndexTest() {
        Datasource ds = getDatasource();
        string table_name = "oracle_partition_local_index";
        string tablespace = ds.selectRow("select default_tablespace from user_users").default_tablespace;

        # Ensure deterministic recovery if a previous interrupted run left the integration fixture behind.
        ds.execRaw("begin execute immediate 'drop table " + table_name
            + " cascade constraints'; exception when others then if sqlcode != -942 then raise; end if; end;");
        ds.commit();

        hash<auto> columns = {
            "id": {"qore_type": Type::Int, "notnull": True},
            "d": {"qore_type": Type::Date, "notnull": True},
            "v": {"qore_type": Type::String, "size": 20, "notnull": True},
            "u": {"qore_type": Type::String, "size": 20},
        };
        hash<auto> partition_strategy = {"method": "range", "columns": "d"};
        hash<auto> partitions = {"pmax": {"bound_sql": "values less than (MAXVALUE)"}};

        OracleTable desired(ds, table_name);
        desired.setupTable({
            "columns": columns,
            "indexes": {
                "olit_v": {
                    "columns": "v",
                    "driver": {"oracle": {
                        "partition_scope": "local",
                        "index_tablespace": tablespace,
                        "compute_statistics": True,
                    }},
                },
                "olit_ud": {
                    "columns": ("u", "d"),
                    "unique": True,
                    "driver": {"oracle": {"partition_scope": "local"}},
                },
                "ogit_v": {
                    "columns": ("id", "v"),
                    "unique": True,
                    "driver": {"oracle": {"partition_scope": "global"}},
                },
            },
            "primary_key": {
                "name": "opli_pk",
                "columns": ("id", "d"),
                "driver": {"oracle": {
                    "partition_scope": "local",
                    "index_tablespace": tablespace,
                    "compute_statistics": True,
                }},
            },
            "unique_constraints": {
                "opli_uk": {
                    "columns": ("v", "d"),
                    "driver": {"oracle": {
                        "partition_scope": "local",
                        "index_tablespace": tablespace,
                        "compute_statistics": True,
                    }},
                },
            },
            "partition_strategy": partition_strategy,
            "partitions": partitions,
        });

        hash<auto> manual_desc = desired.getDescriptionHash({"with_partitions": True});
        assertEq("local", manual_desc.indexes.olit_v.driver.oracle.partition_scope,
            "manual index description preserves local scope");
        assertEq(True, manual_desc.indexes.olit_v.driver.oracle.compute_statistics,
            "manual index description preserves compute_statistics");
        assertEq(tablespace, manual_desc.indexes.olit_v.driver.oracle.index_tablespace,
            "manual index description preserves its tablespace");
        assertEq("local", manual_desc.primary_key.driver.oracle.partition_scope,
            "manual primary-key description preserves local scope");
        assertEq("local", manual_desc.unique_constraints.opli_uk.driver.oracle.partition_scope,
            "manual unique-constraint description preserves local scope");

        string index_sql = desired.getIndexes().olit_v.getCreateSql(table_name);
        assertTrue(index_sql =~ /tablespace .* compute statistics local$/i,
            "local index DDL orders tablespace, statistics, and scope clauses correctly");
        string pk_sql = desired.getPrimaryKey().getCreateSql(table_name);
        assertTrue(pk_sql =~ /using index tablespace .* compute statistics local$/i,
            "local primary-key DDL emits an inline local index clause");
        OracleUniqueConstraint desired_uk = cast<OracleUniqueConstraint>(
            desired.getConstraints().opli_uk);
        assertTrue(desired_uk.getCreateSql(table_name)
            =~ /using index tablespace .* compute statistics local$/i,
            "local unique-constraint DDL emits an inline local index clause");

        assertThrows("INDEX-OPTION-ERROR", "must include partition key", sub () {
            OracleTable invalid(ds, "opli_invalid_unique_index");
            invalid.setupTable({
                "columns": columns,
                "indexes": {"bad_ix": {
                    "columns": "v", "unique": True,
                    "driver": {"oracle": {"partition_scope": "local"}},
                }},
                "partition_strategy": partition_strategy,
            });
        });
        assertThrows("CONSTRAINT-OPTION-ERROR", "must include partition key", sub () {
            OracleTable invalid(ds, "opli_invalid_pk");
            invalid.setupTable({
                "columns": columns,
                "primary_key": {
                    "name": "bad_pk", "columns": "id",
                    "driver": {"oracle": {"partition_scope": "local"}},
                },
                "partition_strategy": partition_strategy,
            });
        });
        assertThrows("CONSTRAINT-OPTION-ERROR", "must include partition key", sub () {
            OracleTable invalid(ds, "opli_invalid_uk");
            invalid.setupTable({
                "columns": columns,
                "unique_constraints": {"bad_uk": {
                    "columns": "v",
                    "driver": {"oracle": {"partition_scope": "local"}},
                }},
                "partition_strategy": partition_strategy,
            });
        });
        assertThrows("INDEX-OPTION-ERROR", "nonpartitioned table", sub () {
            OracleTable invalid(ds, "opli_invalid_nonpartitioned");
            invalid.setupTable({
                "columns": columns,
                "indexes": {"bad_ix": {
                    "columns": "v",
                    "driver": {"oracle": {"partition_scope": "local"}},
                }},
            });
        });
        assertThrows("INDEX-OPTION-ERROR", "invalid partition_scope", sub () {
            OracleTable invalid(ds, "opli_invalid_scope");
            invalid.setupTable({
                "columns": columns,
                "indexes": {"bad_ix": {
                    "columns": "v",
                    "driver": {"oracle": {"partition_scope": "regional"}},
                }},
                "partition_strategy": partition_strategy,
            });
        });
        assertThrows("INDEX-OPTION-ERROR", "bitmap index", sub () {
            OracleTable invalid(ds, "opli_invalid_bitmap");
            invalid.setupTable({
                "columns": columns,
                "indexes": {"bad_ix": {"columns": "v", "method": "bitmap"}},
                "partition_strategy": partition_strategy,
            });
        });
        assertThrows("CONSTRAINT-OPTION-ERROR", "do not match index", sub () {
            OracleTable invalid(ds, "opli_invalid_named_index");
            invalid.setupTable({
                "columns": columns,
                "indexes": {"support_ix": {
                    "columns": ("v", "d"), "unique": True,
                    "driver": {"oracle": {"partition_scope": "local"}},
                }},
                "primary_key": {
                    "name": "bad_pk", "columns": ("id", "d"),
                    "driver": {"oracle": {"index": "support_ix"}},
                },
                "partition_strategy": partition_strategy,
            });
        });
        assertThrows("CONSTRAINT-OPTION-ERROR", "conflicts with", sub () {
            OracleTable invalid(ds, "opli_invalid_named_scope");
            invalid.setupTable({
                "columns": columns,
                "indexes": {"support_ix": {
                    "columns": ("id", "d"), "unique": True,
                    "driver": {"oracle": {"partition_scope": "global"}},
                }},
                "primary_key": {
                    "name": "bad_pk", "columns": ("id", "d"),
                    "driver": {"oracle": {"index": "support_ix", "partition_scope": "local"}},
                },
                "partition_strategy": partition_strategy,
            });
        });

        desired.createCommit();
        hash<auto> locality = ds.selectRow("select count(*) c, min(locality) locality from user_part_indexes "
            "where index_name in ('OLIT_V', 'OLIT_UD', 'OPLI_PK', 'OPLI_UK')");
        assertEq(4, locality.c, "all requested local index structures are physically partitioned");
        assertEq("LOCAL", locality.locality, "all requested local index structures are local");
        assertEq("NO", ds.selectRow("select partitioned from user_indexes where index_name = 'OGIT_V'").partitioned,
            "the explicit global index is not partitioned");

        OracleTable actual(ds, table_name);
        Indexes actual_indexes = actual.getIndexes();
        assertEq("local", cast<OracleIndex>(actual_indexes.olit_v).getEffectivePartitionScope(),
            "catalog introspection identifies local indexes");
        assertEq(tablespace.lwr(), cast<OracleIndex>(actual_indexes.olit_v).tablespace,
            "catalog introspection preserves a uniform local-index tablespace");
        assertEq("global", cast<OracleIndex>(actual_indexes.ogit_v).getEffectivePartitionScope(),
            "catalog introspection identifies global indexes on partitioned tables");

        hash<auto> desc = actual.getDescriptionHash({"with_partitions": True});
        assertEq("local", desc.indexes.olit_v.driver.oracle.partition_scope,
            "reverse description preserves local index scope");
        assertEq("global", desc.indexes.ogit_v.driver.oracle.partition_scope,
            "reverse description preserves global index scope");
        assertEq("opli_pk", desc.primary_key.driver.oracle.index,
            "reverse description links the primary key to its physical index");
        assertTrue(desc.unique_constraints.hasKey("opli_uk"),
            "reverse description exports unique constraints");
        assertEq("opli_uk", desc.unique_constraints.opli_uk.driver.oracle.index,
            "reverse description links a unique constraint to its physical index");

        OracleTable reverse_template(ds, table_name);
        reverse_template.setupTable(desc);
        assertEq((), actual.getAlignSql(reverse_template),
            "reverse-engineered local and global indexes align unchanged");

        actual.dropCommit();
        OracleTable recreated(ds, table_name);
        recreated.setupTable(desc);
        recreated.createCommit();
        locality = ds.selectRow("select count(*) c, min(locality) locality from user_part_indexes "
            "where index_name in ('OLIT_V', 'OLIT_UD', 'OPLI_PK', 'OPLI_UK')");
        assertEq(4, locality.c, "reverse description recreates all local index structures");
        assertEq("LOCAL", locality.locality, "reverse description recreates local physical scope");
        recreated.dropCommit();
    }

    private string getResultSetSql() {
        return "begin open :rs for select id, def_test1, def_test2 from oracle_test; end;";
    }

    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-c,--conn=ARG", "set DB connection argument (ex: \"oracle:user/pass@db\")", OptionColumn);
    }

    Datasource getDatasource() {
        if (!m_options.connstr)
            m_options.connstr = ENV.QORE_DB_CONNSTR_ORACLE;
        Datasource ds(m_options.connstr);
        if (ds.getDriverName() != "oracle")
            throw "ORACLE-ERROR", sprintf("cannot execute the oracle tests on a connection using driver %y", ds.getDriverName());
        ds.open();
        return ds;
    }
}
