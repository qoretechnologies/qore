#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/SqlUtil
%requires ../../../../qlib/PgsqlSqlUtilBase.qm
%exec-class PgsqlForeignConstraintTest

class PgsqlForeignConstraintTest inherits QUnit::Test {
    constructor() : Test("PgsqlForeignConstraintTest", "1.0", \ARGV) {
        addTestCase("plain foreign-key names remain unchanged", \plain());
        addTestCase("reserved columns are quoted on both sides", \reserved());
        addTestCase("composite column order and deferrability are preserved", \composite());
        addTestCase("renamed column DDL names are used", \renamed());
        addTestCase("invalid deferred constraint options are rejected", \invalid());
        set_return_value(main());
    }
    private static Columns columns(list<string> names) {
        Columns columns({});
        foreach string name in (names) {
            columns.add(name, new PgsqlColumn(name, "text", "string", 80, False));
        }
        return columns;
    }
    private plain() {
        PgsqlForeignConstraint fk("fk_plain", columns(("parent_id",)),
            new ForeignConstraintTarget("parent", columns(("id",))));
        assertEq("alter table child add constraint fk_plain foreign key (parent_id) references parent (id)",
            fk.getCreateSql("child"));
    }
    private reserved() {
        PgsqlForeignConstraint fk("fk_reserved", columns(("order",)),
            new ForeignConstraintTarget("parent", columns(("user",))));
        assertEq('alter table child add constraint fk_reserved foreign key ("order") references parent ("user")',
            fk.getCreateSql("child"));
        # the constraint is renamed in place, never dropped and added again
        assertEq(("alter table child rename constraint fk_reserved to fk_renamed",),
            fk.getRenameSql("child", "fk_renamed"));
    }
    private composite() {
        PgsqlForeignConstraint fk("fk_composite", columns(("draft_user", "type", "draft_id")),
            new ForeignConstraintTarget("drafts", columns(("user", "type", "draftid"))), True, True);
        assertEq('alter table guard add constraint fk_composite foreign key (draft_user, type, draft_id) references drafts ("user", type, draftid) deferrable initially deferred',
            fk.getCreateSql("guard"));
    }
    private renamed() {
        Columns source = columns(("local_name",));
        Columns target = columns(("old_name",));
        source.local_name.setDdlName("order");
        target.old_name.setDdlName("user");
        PgsqlForeignConstraint fk("fk_after_rename", source, new ForeignConstraintTarget("parent", target));
        assertEq('alter table child add constraint fk_after_rename foreign key ("order") references parent ("user")',
            fk.getCreateSql("child"));
    }
    private invalid() {
        assertThrows("FOREIGN-CONSTRAINT-ERROR", sub() {
            new PgsqlForeignConstraint("fk_invalid", columns(("order",)),
                new ForeignConstraintTarget("parent", columns(("user",))), False, True);
        });
    }
}
