#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%prepend-module-path "${SCRIPT_DIR}"
%requires QUnit
%requires SqlUtil
%requires ./PgsqlTestIsolation.qm
%requires ./MysqlTestIsolation.qm
%requires ./OracleTestIsolation.qm
%requires ./MssqlTestIsolation.qm

%try-module sqlite3
%define NoSqlite3
%endtry

%try-module pgsql
%define NoPgsql
%endtry

%try-module mysql
%define NoMysql
%endtry

%try-module oracle
%define NoOracle
%endtry

%try-module freetds
%define NoFreetds
%endtry

%exec-class UpsertBulkRowsTest

#! a row of list values (bulk DML) is upserted with every driver and strategy (issue #6691)
/** a row of list values was passed to the upsert statement as it was, which only the Oracle driver binds as arrays:
    every other driver failed with a bind error; runs on SQLite, and on PostgreSQL, MySQL, Oracle and SQL Server when
    \c QORE_DB_CONNSTR_PGSQL, \c QORE_DB_CONNSTR_MYSQL, \c QORE_DB_CONNSTR_ORACLE and \c QORE_DB_CONNSTR_FREETDS are
    set
*/
class UpsertBulkRowsTest inherits QUnit::Test {
    private {
        hash<string, Datasource> dbs;
        hash<string, string> skips = {
            "pgsql": "QORE_DB_CONNSTR_PGSQL is not set",
            "mysql": "QORE_DB_CONNSTR_MYSQL is not set",
            "oracle": "QORE_DB_CONNSTR_ORACLE is not set",
            "mssql": "QORE_DB_CONNSTR_FREETDS is not set",
        };

        const Strategies = {
            "auto": AbstractTable::UpsertAuto,
            "update-first": AbstractTable::UpsertUpdateFirst,
            "select-first": AbstractTable::UpsertSelectFirst,
            "insert-first": AbstractTable::UpsertInsertFirst,
            "insert-only": AbstractTable::UpsertInsertOnly,
            "update-only": AbstractTable::UpsertUpdateOnly,
        };
    }

    constructor() : Test("UpsertBulkRows", "1.0", \ARGV) {
        addTestCase("SQLite", \sqliteTest());
        addTestCase("PostgreSQL", \pgsqlTest());
        addTestCase("MySQL", \mysqlTest());
        addTestCase("Oracle", \oracleTest());
        addTestCase("SQL Server", \mssqlTest());
        set_return_value(main());
    }

    globalSetUp() {
%ifndef NoPgsql
        if (ENV.QORE_DB_CONNSTR_PGSQL) {
            PgsqlRunSchema::setup(ENV.QORE_DB_CONNSTR_PGSQL, "UpsertBulkRows");
            dbs.pgsql = new Datasource(ENV.QORE_DB_CONNSTR_PGSQL);
        }
%else
        skips.pgsql = "no pgsql module";
%endif
%ifndef NoMysql
        if (ENV.QORE_DB_CONNSTR_MYSQL) {
            connect("mysql", *string sub () { return MysqlRunDatabase::getConnectionString(ENV.QORE_DB_CONNSTR_MYSQL,
                "UpsertBulkRows"); });
        }
%else
        skips.mysql = "no mysql module";
%endif
%ifndef NoOracle
        if (ENV.QORE_DB_CONNSTR_ORACLE) {
            connect("oracle", *string sub () { return OracleRunSchema::getConnectionString(ENV.QORE_DB_CONNSTR_ORACLE,
                "UpsertBulkRows"); });
        }
%else
        skips.oracle = "no oracle module";
%endif
%ifndef NoFreetds
        if (ENV.QORE_DB_CONNSTR_FREETDS) {
            connect("mssql", *string sub () { return MssqlRunDatabase::getConnectionString(ENV.QORE_DB_CONNSTR_FREETDS,
                "UpsertBulkRows"); });
        }
%else
        skips.mssql = "no freetds module";
%endif
    }

    globalTearDown() {
        foreach string k in (keys dbs) {
            dbs{k}.rollback();
        }
        remove dbs;
        if (ENV.QORE_DB_CONNSTR_PGSQL) {
            PgsqlRunSchema::teardown();
        }
        if (ENV.QORE_DB_CONNSTR_MYSQL) {
            MysqlRunDatabase::teardown();
        }
        if (ENV.QORE_DB_CONNSTR_ORACLE) {
            OracleRunSchema::teardown();
        }
        if (ENV.QORE_DB_CONNSTR_FREETDS) {
            MssqlRunDatabase::teardown();
        }
    }

    private connect(string db, code get_connstr) {
        try {
            Datasource ds(get_connstr());
            ds.open();
            dbs{db} = ds;
        } catch (hash<ExceptionInfo> ex) {
            skips{db} = sprintf("cannot connect: %s: %s", ex.err, ex.desc);
        }
    }

    sqliteTest() {
%ifdef NoSqlite3
        testSkip("no sqlite3 module");
%endif
        check(new Datasource("sqlite3:x@:memory:"), "sqlite");
    }

    pgsqlTest() {
        Datasource ds = getDs("pgsql");
        check(ds, "pgsql");
        checkArrayColumn(ds);
    }

    #! a list for an array column is a value of the column, and a list of lists a row of list values
    private checkArrayColumn(Datasource ds) {
        on_exit ds.rollback();
        string name = "ubr_arr";
        ds.exec(sprintf("create table %s (tags integer[], id integer not null, v integer, primary key (id))", name));
        ds.commit();
        on_exit {
            ds.rollback();
            ds.exec("drop table " + name);
            ds.commit();
        }
        AbstractTable t = new Table(ds, name).getTable();
        foreach hash<auto> st in (Strategies.pairIterator()) {
            string desc = sprintf("pgsql: array column first: %s", st.key);
            t.del();
            # AbstractTable::insert() takes a list for the first column as a row of list values
            ds.exec(sprintf("insert into %s (tags, id, v) values ('{1,2}', 1, 1)", name));
            try {
                # a row whose first value is the value of an array column
                t.upsert({"tags": (3, 4), "id": 1, "v": 2}, st.value);
                t.upsert({"tags": (5,), "id": 2, "v": 3}, st.value);
                # a row of list values, whose array column has a list for each row
                t.getUpsertClosure({"tags": ((6,),), "id": (1,), "v": (4,)}, st.value)({"tags": ((7, 8), (9,)), "id": (1, 3),
                    "v": (5, 6)});
                # and upsertFromIterator() with both
                t.upsertFromIterator(({"tags": (10,), "id": 4, "v": 7}, {"tags": ((11,), (12,)), "id": (4, 5),
                    "v": (8, 9)}).iterator(), st.value);
            } catch (hash<ExceptionInfo> ex) {
                fail(sprintf("%s: %s: %s", desc, ex.err, ex.desc));
            }
            hash<auto> rows = map {$1.id.toString(): ($1.tags, $1.v)}, t.selectRows({"orderby": "id"});
            hash<auto> expected;
            switch (st.key) {
                case "insert-only":
                    expected = {"1": ((1, 2), 1), "2": ((5,), 3), "3": ((9,), 6), "4": ((10,), 7), "5": ((12,), 9)};
                    break;
                case "update-only":
                    expected = {"1": ((7, 8), 5)};
                    break;
                default:
                    expected = {"1": ((7, 8), 5), "2": ((5,), 3), "3": ((9,), 6), "4": ((11,), 8), "5": ((12,), 9)};
                    break;
            }
            assertEq(expected, rows, desc);
            # a row of empty lists with an array column first, and a row of list values whose first array value is
            # NULL
            try {
                assertEq(AbstractTable::UR_Unchanged, t.getUpsertClosure({"tags": ((6,),), "id": (1,), "v": (4,)},
                    st.value)({"tags": (), "id": (), "v": ()}), desc + ": empty lists");
                t.getBulkUpsertClosure({"tags": (6,), "id": 1, "v": 4}, st.value)({"tags": (), "id": (), "v": ()});
                t.getUpsertClosure({"tags": ((6,),), "id": (1,), "v": (4,)}, st.value)({"tags": (NULL, (13,)), "id": (6, 7),
                    "v": (10, 11)});
            } catch (hash<ExceptionInfo> ex) {
                fail(sprintf("%s: %s: %s", desc, ex.err, ex.desc));
            }
            rows = map {$1.id.toString(): ($1.tags, $1.v)}, t.selectRows({"where": {"id": op_ge(6)}, "orderby": "id"});
            assertEq(st.key == "update-only" ? {} : {"6": (NULL, 10), "7": ((13,), 11)}, rows, desc + ": NULL array");
            ds.rollback();
        }
    }

    mysqlTest() {
        check(getDs("mysql"), "mysql");
    }

    oracleTest() {
        check(getDs("oracle"), "oracle");
    }

    mssqlTest() {
        check(getDs("mssql"), "mssql");
    }

    private Datasource getDs(string db) {
        if (!dbs{db}) {
            testSkip(skips{db});
        }
        return dbs{db};
    }

    #! for each strategy: a row of list values given to an upsert closure, to upsertFromIterator() (also with
    #! delete_others and with hash rows) and to a bulk upsert closure upserts each of its rows
    private check(Datasource ds, string db) {
        on_exit ds.rollback();
        string name = "ubr_t";
        ds.exec(sprintf("create table %s (k integer not null, s varchar(10) not null, v integer, primary key (k, s))",
            name));
        ds.commit();
        on_exit {
            ds.rollback();
            ds.exec("drop table " + name);
            ds.commit();
        }
        AbstractTable t = new Table(ds, name).getTable();
        foreach hash<auto> st in (Strategies.pairIterator()) {
            # the Oracle select-first upsert binds the lists of the row in a select (issue #6688)
            if (db == "oracle" && st.key == "select-first") {
                continue;
            }
            string desc = sprintf("%s: %s", db, st.key);
            # the rows expected after an upsert of the keys 1, 2 and 3 in a table with the rows of the keys 1 and 9
            hash<auto> expected = {"1": 10, "2": 20, "3": 30, "9": 9};
            switch (st.key) {
                case "insert-only": expected."1" = 1; break;
                case "update-only": expected = {"1": 10, "9": 9}; break;
            }
            # a key column with one value for all rows of the row of list values
            hash<auto> bulk = {"k": (1, 2, 3), "s": "a", "v": (10, 20, 30)};
            foreach string how in (("closure", "bulk closure", "iterator", "iterator, bulk row first",
                    "iterator with delete_others")) {
                reset(t);
                try {
                    switch (how) {
                        case "closure":
                            # the closure is made from a row of list values
                            assertEq(AbstractTable::UR_Verified, t.getUpsertClosure({"k": (1, 2), "s": ("a", "a"),
                                "v": (10, 20)}, st.value)(bulk), desc + ": " + how);
                            break;
                        case "bulk closure":
                            t.getBulkUpsertClosure({"k": 1, "s": "a", "v": 1}, st.value)(bulk);
                            break;
                        case "iterator":
                            # a hash row, then the row of list values
                            t.upsertFromIterator(({"k": 4, "s": "a", "v": 40}, bulk).iterator(), st.value);
                            break;
                        case "iterator, bulk row first":
                            # the row of list values, then hash rows: the result counts the row of list values once
                            *hash<string, int> rh = t.upsertFromIterator((bulk, {"k": 4, "s": "a", "v": 40},
                                {"k": 1, "s": "a", "v": 10}).iterator(), st.value);
                            assertEq(3, (foldl $1 + $2, rh.values()), desc + ": " + how + ": rows counted");
                            break;
                        case "iterator with delete_others":
                            *hash<string, int> rh = t.upsertFromIterator((bulk,).iterator(), st.value,
                                {"delete_others": True});
                            assertEq(1, rh.deleted, desc + ": " + how + ": deleted");
                            break;
                    }
                } catch (hash<ExceptionInfo> ex) {
                    fail(sprintf("%s: %s: %s: %s", desc, how, ex.err, ex.desc));
                }
                hash<auto> rows = getRows(t);
                hash<auto> exp = expected;
                switch (how) {
                    case "iterator":
                    case "iterator, bulk row first":
                        if (st.key != "update-only") {
                            exp."4" = 40;
                        }
                        break;
                    case "iterator with delete_others":
                        remove exp."9";
                        break;
                }
                assertEq(exp, rows, desc + ": " + how);
            }
        }
        # a row of empty lists upserts nothing, and the bulk closure gives UR_Verified for a row of list values
        reset(t);
        foreach hash<auto> st in (Strategies.pairIterator()) {
            # the Oracle select-first upsert binds the lists of the row in a select (issue #6688)
            if (db == "oracle" && st.key == "select-first") {
                continue;
            }
            assertEq(AbstractTable::UR_Unchanged, t.getUpsertClosure({"k": (1,), "s": "a", "v": (1,)},
                st.value)({"k": (), "s": (), "v": ()}), db + ": empty lists: " + st.key);
            assertEq({"unchanged": 1}, t.upsertFromIterator(({"k": (), "s": (), "v": ()},).iterator(), st.value),
                db + ": empty lists: upsertFromIterator(): " + st.key);
            assertEq(AbstractTable::UR_Verified, t.getBulkUpsertClosure({"k": 1, "s": "a", "v": 1}, st.value)({"k": (1,
                9), "s": "a", "v": (1, 9)}), db + ": bulk closure return value: " + st.key);
        }
        assertEq({"1": 1, "9": 9}, getRows(t), db + ": empty lists: nothing is changed");
        # lists of other lengths are raised before any row is changed
        reset(t);
        assertThrows("UPSERT-ERROR", "must have the same length; column \"v\" has 1 element, the first value 2",
            sub () { t.getUpsertClosure({"k": (1,), "s": "a", "v": (1,)})({"k": (5, 6), "s": "a", "v": (1,)}); });
        assertEq({"1": 1, "9": 9}, getRows(t), db + ": lists of other lengths: nothing is changed");
        assertThrows("UPSERT-ERROR", "must have the same length; column \"v\" has 1 element, the first value 2",
            sub () { t.getBulkUpsertClosure({"k": 1, "s": "a", "v": 1})({"k": (5, 6), "s": "a", "v": (1,)}); });
        assertEq({"1": 1, "9": 9}, getRows(t), db + ": lists of other lengths: bulk closure: nothing is changed");
    }

    private reset(AbstractTable t) {
        t.del();
        t.insert({"k": 1, "s": "a", "v": 1});
        t.insert({"k": 9, "s": "a", "v": 9});
    }

    private hash<auto> getRows(AbstractTable t) {
        return map {$1.k.toString(): $1.v.toInt()}, t.selectRows({"orderby": "k"});
    }
}
