#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%enable-all-warnings
%require-types
%strict-args

module BulkSqlUtilTestBase {
    version = "0.1";
    desc = "BulkSqlUtil test base module";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
}

%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/DataProvider
%requires ../../../../qlib/SqlUtil
%requires ../../../../qlib/BulkSqlUtil
%requires ../../../../qlib/Schema

%try-module dataframe
%define NoDataFrame
%endtry

public class SqlUtilTestSchema inherits AbstractSchema {
    constructor(AbstractDatasource ds, *string dts, *string its) : AbstractSchema(ds, dts, its) {
    }

    private *hash doTables(hash tables, hash columns) {
        foreach string table in (keys tables) {
            foreach hash h in (columns.pairIterator()) {
                string type = h.value.type ?? h.key;
                hash ch = (
                    "native_type": type,
                    "notnull": True,
                );
                if (h.value.typeCode() == NT_HASH)
                    ch += (h.value - ("value", "bind", "expect", "type"));
                tables{table}.columns{SqlTestBase::getColumnName(h.key)} = ch;
            }
        }
        return tables;
    }

    log(string fmt) {
        delete argv;
    }

    logpf(string fmt) {
        delete argv;
    }

    logProgress(string fmt) {
        delete argv;
    }
}

public class SqlTestBase inherits QUnit::Test {
    private {
        AbstractSchema schema;
        AbstractTable table;

        const MyOpts = Opts + (
            "connstr": "c,conn=s",
        );

        const OptionColumn = 22;

        hash expect_data;

        list insert_data;
        list upsert_data;

        # constant record
        *hash crec;
    }

    constructor(string testName, string testVer, any args, *hash mopts) : Test(testName, testVer, \args, mopts) {
        addTestCase("BulkInsert", \bulkInsertTest());
        addTestCase("BulkColumnarInsert", \bulkColumnarInsertTest());
        addTestCase("BulkHashOfBuffersInsert", \bulkHashOfBuffersInsertTest());
        addTestCase("BulkInputValidation", \bulkInputValidationTest());
%ifndef NoDataFrame
        addTestCase("BulkDataFrameInsert", \bulkDataFrameInsertTest());
%endif
        addTestCase("BulkUpsert", \bulkUpsertTest());
    }

    globalTearDown() {
        # drop the test schema
        if (schema)
            schema.drop(True, m_options.verbose);
    }

    bulkInsertTest() {
        if (!table) testSkip("no DB connection");

        on_success table.commit();
        on_error table.rollback();

        table.del();

        {
            BulkInsertOperation insert(table, {"block_size": 3});
            on_success insert.flush();
            on_error insert.discard();

            foreach hash data in (insert_data)
                assertEq(NOTHING, insert.queueData(data + crec));
        }

        table.del();

        {
            # now do a bulk insert with a hash of lists
            BulkInsertOperation insert(table, {"block_size": 3});

            on_success insert.flush();
            on_error insert.discard();

            assertEq(NOTHING, insert.queueData(getRows(insert_data, 0, 2) + crec));
            assertEq(2, insert.size());
            assertEq(NOTHING, insert.queueData(getRows(insert_data, 2, 4) + crec));
            assertEq(NOTHING, insert.queueData(getRows(insert_data, 4) + crec));
        }

        # compare data inserted
        list l = table.selectRows(("orderby": "id"));
        assertEq(5, l.size());
        map assertEq(insert_data[$#] + crec + expect_data, $1), l;
    }

    bulkColumnarInsertTest() {
        if (!table) testSkip("no DB connection");
        if (table.getDatasource().getDriverName() != "pgsql")
            testSkip("covered by pgsql bulk tests");

        runSimpleColumnarInsert("qore_bulk_columnar_test", getSimpleColumnarResult());
    }

    bulkHashOfBuffersInsertTest() {
        if (!table) testSkip("no DB connection");
        if (table.getDatasource().getDriverName() != "pgsql")
            testSkip("covered by pgsql bulk tests");

        runSimpleColumnarInsert("qore_bulk_buffers_test", getSimpleBufferColumns());
    }

    bulkInputValidationTest() {
        if (!table) {
            testSkip("no DB connection");
        }

        {
            BulkInsertOperation insert(table, {"block_size": 10});
            assertThrows("BULK-SQL-OPERATION-ERROR", "record 2/2 has a different field set", sub () {
                insert.queueData(({"id": 1}, {"id": 2, "id_": 2}));
            });
            assertEq(0, insert.size());
            assertEq(NOTHING, insert.queueData(({"id": 1, "id_": 2}, {"id_": 3, "id": 2})));
            assertEq(2, insert.size());
            insert.discard();
        }

        {
            BulkInsertOperation insert(table, {"block_size": 10});
            assertThrows("BULK-SQL-OPERATION-ERROR", "field \"id_\" has 1 values", sub () {
                insert.queueData({"id": (1, 2), "id_": (2,)});
            });
            assertEq(0, insert.size());
            insert.discard();
        }

        {
            BulkInsertOperation insert(table, {"block_size": 10});
            assertThrows("BULK-SQL-OPERATION-ERROR", "field \"id_\" has 1 values", sub () {
                insert.queueData({
                    "id": new buffer<int64>((1, 2)),
                    "id_": new buffer<int64>((2,)),
                });
            });
            assertEq(0, insert.size());
            insert.discard();
        }

        {
            BulkInsertOperation insert(table, {"block_size": 10});
            assertThrows("BULK-SQL-OPERATION-ERROR", "record 2/2 is type", sub () {
                insert.queueData(({"id": 1}, 2));
            });
            assertEq(0, insert.size());
            insert.discard();
        }

    }

%ifndef NoDataFrame
    bulkDataFrameInsertTest() {
        if (!table) testSkip("no DB connection");
        if (table.getDatasource().getDriverName() != "pgsql")
            testSkip("covered by pgsql bulk tests");

        runSimpleColumnarInsert("qore_bulk_dataframe_test", new DataFrame::DataFrame(getSimpleBufferColumns()));
    }
%endif

    private runSimpleColumnarInsert(string table_name, auto data) {
        AbstractDatasource ds = table.getDatasource();

        on_success ds.commit();
        on_error ds.rollback();

        ds.exec(sprintf("drop table if exists %s", table_name));
        ds.exec(sprintf("create table %s (id bigint primary key, name text, score double precision, active boolean)",
            table_name));
        on_exit {
            try {
                ds.exec(sprintf("drop table if exists %s", table_name));
            } catch (hash<ExceptionInfo> ex) {
            }
        }

        Table target(ds, getSimpleTableDescription(), table_name);
        BulkInsertOperation insert(target, {"block_size": 2});
        assertEq(NOTHING, insert.queueData(data));
        assertEq(NOTHING, insert.flush());

        list<hash<auto>> rows = ds.selectRows(sprintf("select id, name, score, active from %s order by id",
            table_name));
        assertEq(3, rows.size());
        assertEq({"id": 1, "name": "Ada", "score": 10.5, "active": True}, rows[0]);
        assertEq({"id": 2, "name": "Ben", "score": 20.25, "active": False}, rows[1]);
        assertEq({"id": 3, "name": "Cy", "score": 30.75, "active": True}, rows[2]);
    }

    private static hash<auto> getSimpleTableDescription() {
        return {
            "columns": {
                "id": {"qore_type": "integer"},
                "name": {"qore_type": "string"},
                "score": {"qore_type": "float"},
                "active": {"qore_type": "bool"},
            },
        };
    }

    private static hash<auto> getSimpleBufferColumns() {
        return {
            "id": new buffer<int64>((1, 2, 3)),
            "name": new buffer<string>(("Ada", "Ben", "Cy")),
            "score": new buffer<float64>((10.5, 20.25, 30.75)),
            "active": new buffer<bool>((True, False, True)),
        };
    }

    private static ColumnarResult getSimpleColumnarResult() {
        return ColumnarResult::fromColumnHash(getSimpleBufferColumns());
    }

    static hash getRows(list l, int start, int end = -1) {
        if (end < 0)
            end = l.size();
        hash h = map {$1: ()}, keys l[0];

        for (int i = start; i < end; ++i)
            map h{$1.key} += $1.value, l[i].pairIterator();

        return h;
    }

    bulkUpsertTest() {
        if (!table) testSkip("no DB connection");

        on_success table.commit();
        on_error table.rollback();

        table.del();

        BulkUpsertOperation insert(table, {"block_size": 3});
        on_success insert.flush();
        on_error insert.discard();

        foreach hash data in (upsert_data)
            assertEq(NOTHING, insert.queueData(data + crec));
    }

    static string getColumnName(string n) {
        n =~ s/ //g;
        return n + "_f";
    }

    initTestData(hash custom_columns, *hash const_columns) {
        hash row;

        foreach hash h in (custom_columns.pairIterator()) {
            string cn = getColumnName(h.key);
            row{cn} = h.value.bind ?? h.value.value ?? h.value;
            expect_data{cn} = h.value.expect ?? h.value.bind."^value^" ?? h.value.value ?? h.value;
        }
        foreach hash h in (const_columns.pairIterator()) {
            string cn = getColumnName(h.key);
            crec{cn} = h.value.bind ?? h.value.value ?? h.value;
            expect_data{cn} = h.value.expect ?? h.value.bind."^value^" ?? h.value.value ?? h.value;
        }
        insert_data = (
            {"id": 1, "id_": 2, "null_f": "abc"} + row,
            {"id": 2, "id_": 2, "null_f": NULL} + row,
            {"id": 3, "id_": 10, "null_f": "def"} + row,
            {"id": 4, "id_": 11, "null_f": "lala"} + row,
            {"id": 5, "id_": 12, "null_f": "trololo"} + row,
        );
        upsert_data = (
            {"id": 2, "id_": 2, "null_f": "abc"} + row,
            {"id": 3, "id_": 2, "null_f": "bla"} + row,
            {"id": 4, "id_": 13, "null_f": "blabla"} + row,
            {"id": 5, "id_": 14, "null_f": "trololo"} + row,
            {"id": 6, "id_": 15, "null_f": "ghijkl"} + row,
            {"id": 7, "id_": 16, "null_f": "bububu"} + row,
        );
    }
}
