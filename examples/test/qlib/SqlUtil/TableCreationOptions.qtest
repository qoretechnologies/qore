#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
#
# Copyright 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires SqlUtil
%requires Sqlite3SqlUtil
%requires QUnit

%try-module sqlite3
%define NoSqlite3
%endtry

%exec-class TableCreationOptionsTest

#! The options of the methods that give the SQL to create a table
class TableCreationOptionsTest inherits QUnit::Test {
    constructor() : Test("TableCreationOptionsTest", "1.0", \ARGV) {
        addTestCase("getCreateTableSql() takes the omit option", \createTableSqlOmit());
        addTestCase("the creation methods take options in a hash literal", \createSqlHashLiteral());
        set_return_value(main());
    }

    #! Returns a template table with an index, on an in-memory database
    private Sqlite3Table template(Datasource ds) {
        Sqlite3Table t(ds, "options_test");
        t.setupTable({
            "columns": {"id": {"native_type": "integer", "notnull": True}, "name": {"native_type": "text"}},
            "indexes": {"ix_options_test_name": {"columns": ("name",)}},
        });
        return t;
    }

    private Datasource datasource() {
%ifdef NoSqlite3
        testSkip("no sqlite3 module");
%endif
        return new Datasource("sqlite3:@:memory:");
    }

    #! getCreateTableSql() validates its options before it converts the omit option to the hash that the SQL is
    #! made with, so an omit option is accepted, as a list, as a string or in a hash literal
    private createTableSqlOmit() {
        Datasource ds = datasource();
        on_exit ds.rollback();
        Sqlite3Table t = template(ds);
        string sql = "create table options_test (\n  id integer not null,\n  name text\n)";
        assertEq(sql, t.getCreateTableSql());

        hash<auto> opt = {};
        opt.omit = ("indexes",);
        assertEq(sql, t.getCreateTableSql(opt), "a list");
        opt.omit = "indexes";
        assertEq(sql, t.getCreateTableSql(opt), "a string");
        # a hash literal is typed by its values: hash<string, string>
        assertEq(sql, t.getCreateTableSql({"omit": "indexes"}), "a hash literal");

        # an unknown omission is still refused, and so is an unknown option
        opt.omit = "columns";
        assertThrows("CREATE-TABLE-ERROR", \t.getCreateTableSql(), (opt,));
        assertThrows("OPTION-ERROR", \t.getCreateTableSql(), ({"no_such_option": True},));
    }

    #! A hash literal is typed by its values, such as hash<string, string> for {"omit": "indexes"}; the creation
    #! methods set other options in the hash they are given, so they work with a copy that takes values of any type
    private createSqlHashLiteral() {
        Datasource ds = datasource();
        on_exit ds.rollback();
        Sqlite3Table t = template(ds);
        string table_sql = "create table options_test (\n  id integer not null,\n  name text\n)";
        string index_sql = "create index ix_options_test_name on options_test (name)";
        assertEq((table_sql, index_sql), t.getCreateSql());

        # the omit option in a hash literal (hash<string, string> and hash<string, list<string>>)
        assertEq((table_sql,), t.getCreateSql({"omit": "indexes"}));
        assertEq((table_sql,), t.getCreateSql({"omit": ("indexes",)}));
        hash<auto> opt = {};
        opt.omit = "indexes";
        assertEq(t.getCreateSqlString(opt), t.getCreateSqlString({"omit": "indexes"}));
        assertEq(Sqlite3Database::getCreateSql((table_sql,)), t.getCreateSqlString({"omit": "indexes"}));

        # another option in a hash literal (hash<string, code>)
        list<string> sqls;
        assertEq((table_sql, index_sql), t.getCreateSql({"sql_callback": sub (string sql) { push sqls, sql; }}));
        assertEq((table_sql, index_sql), sqls);

        # and the table is created with them
        t.create({"omit": "indexes"});
        Sqlite3Table live(ds, "options_test");
        assertEq(("id", "name"), live.describe().keys());
        assertEq(0, live.getIndexes().size());
    }
}
