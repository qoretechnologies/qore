#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - SQLite3 database driver connections of restored SqlUtil tables
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires FsUtil
%requires SqlUtil
%requires Sqlite3SqlUtil
%requires ../../qore/security/ambient-host/AmbientCallers.qm

%try-module sqlite3
%define NoSqlite3
%endtry

%exec-class SerializationHostCredentialsTest

#! The credentials that the host's datasource credential resolver gives are host secrets (qore#6844)
/** Serialized SqlUtil data keeps no credentials of its datasource; a credential resolver that the host registers gives
    them when the data is restored.  Data is restored with them only for code that may receive the host's secrets: code
    restricted from external information and sandboxed code get \c PERMISSION-DENIED, unless the host grants them
*/
class SerializationHostCredentialsTest inherits QUnit::Test {
    public {
        #! the code of the Programs: restores serialized data, returns the user name of its datasource or the error
        const Source = "%modern
%requires SqlUtil
%requires Sqlite3SqlUtil
%requires AmbientCallers
string sub restore(binary data) {
    try {
        object t = Serializable::deserialize(data);
        string user = t.getDatasource().getUserName();
        t.getDatasource().close();
        return user;
    } catch (hash<ExceptionInfo> ex) {
        return ex.err + \": \" + ex.desc;
    }
}
# the host's grants (no closure: a policy barrier does not mask the provenance of a callback of the calling code)
string sub restore_grant(string how, binary data) {
    try {
        object t = how == \"barrier\"
            ? AmbientCallers::invoke_barrier(\"Qore::Serializable\", \"deserialize\", (data,))
            : AmbientCallers::invoke_capability(\"Qore::Serializable\", \"deserialize\", (data,));
        string user = t.getDatasource().getUserName();
        t.getDatasource().close();
        return user;
    } catch (hash<ExceptionInfo> ex) {
        return ex.err + \": \" + ex.desc;
    }
}
";

        #! the user name of the datasource
        const User = "host-user-6844";
    }

    private {
        TmpDir dir("sqlutil-host-credentials-");
    }

    constructor() : QUnit::Test("SqlUtil serialization host credentials", "1.0", \ARGV) {
        addTestCase("credential resolver", \resolverTest());
        set_return_value(main());
    }

    resolverTest() {
%ifdef NoSqlite3
        testSkip("the sqlite3 module is not available");
%endif
        hash<auto> config = {"type": "sqlite3", "user": User, "pass": "host-pass-6844", "db": dir.path + "/t.db"};
        Datasource ds(config);
        on_exit ds.close();
        Sqlite3Table t(ds, "t6844");
        t.setupTable({"columns": {"id": {"qore_type": "integer", "notnull": True}}});
        binary data = t.serialize();
        int calls = 0;
        sqlutil_register_ds_credential_resolver(hash<auto> sub (string type, hash<auto> masked) {
            ++calls;
            return config;
        });
        on_exit sqlutil_register_ds_credential_resolver();

        # the host's own code
        {
            AbstractTable restored = Serializable::deserialize(data);
            assertEq(User, restored.getDatasource().getUserName(), "host");
            restored.getDatasource().close();
        }
        hash<string, Program> pgms = AmbientCallers::make_programs(Source, "sqlutil-host-credentials");
        foreach string kind in (keys pgms) {
            int before = calls;
            string v = pgms{kind}.callFunction("restore", data);
            if (AmbientCallers::may_receive(kind)) {
                assertEq(User, v, kind);
            } else {
                assertRegex("^PERMISSION-DENIED: .*not available to the calling code", v, kind);
                # the resolver was not asked
                assertEq(before, calls, kind + ": resolver not called");
            }
            # the host's grants give them to any caller, also to the code of the objects that the deserialization
            # creates inside the grant
            foreach string how in (("barrier", "capability")) {
                assertEq(User, pgms{kind}.callFunction("restore_grant", how, data), kind + ": " + how);
            }
        }
    }
}
