#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/DataProvider
%requires ../../../../qlib/SqlUtil
%requires ../../../../qlib/Sqlite3SqlUtil.qm
%requires ../../../../qlib/QUnit.qm

%try-module sqlite3
%define NoSqlite3
%endtry

%exec-class Sqlite3ExpressionTest

class TestAppender inherits LoggerAppenderWithLayout {
    constructor() : LoggerAppenderWithLayout("test", new LoggerLayoutPattern("%d T%t [%p]: %m%n")) {
        open();
    }

    processEventImpl(int type, auto params) {
        switch (type) {
            case EVENT_LOG:
                print(params);
                break;
        }
    }
}

class Sqlite3ExpressionTest inherits QUnit::Test {
    public {
        const MyOpts = Opts + {
            "connstr": "c,conn=s",
        };

        const TableName = "sqlite3_expr_test";
    }

    private {
        *Datasource ds;
        *Sqlite3Table table;
        Logger logger;
    }

    constructor() : Test("Sqlite3ExpressionTest", "1.0", \ARGV, MyOpts) {
        {
            LoggerLevel level;
            if (m_options.verbose > 3) {
                level = LoggerLevel::getLevelDebug();
            } else if (m_options.verbose > 2) {
                level = LoggerLevel::getLevelInfo();
            } else {
                level = LoggerLevel::getLevelError();
            }
            logger = new Logger("test", level);
        }
        logger.addAppender(new TestAppender());

        try {
            ds = getDatasource();
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("%s: %s\n", ex.err, ex.desc);
            }
        }

        if (ds) {
            setupTable();
        }

        # Pattern matching tests
        addTestCase("DP_OP_LIKE", \testDpOpLike());
        addTestCase("DP_OP_CONTAINS", \testDpOpContains());
        addTestCase("DP_OP_STARTS_WITH", \testDpOpStartsWith());
        addTestCase("DP_OP_ENDS_WITH", \testDpOpEndsWith());
        addTestCase("DP_OP_REPLACE", \testDpOpReplace());

        # Type conversion tests
        addTestCase("DP_OP_TO_STRING", \testDpOpToString());
        addTestCase("DP_OP_TO_INT", \testDpOpToInt());
        addTestCase("DP_OP_TO_FLOAT", \testDpOpToFloat());
        addTestCase("DP_OP_TO_NUMBER", \testDpOpToNumber());

        # String manipulation tests
        addTestCase("DP_OP_TO_LOWER", \testDpOpToLower());
        addTestCase("DP_OP_TO_UPPER", \testDpOpToUpper());
        addTestCase("DP_OP_LENGTH", \testDpOpLength());

        # Control flow / misc tests
        addTestCase("DP_OP_TERNARY", \testDpOpTernary());
        addTestCase("DP_OP_HAS_VALUE", \testDpOpHasValue());

        # Multi-value list membership tests
        addTestCase("DP_SEARCH_OP_IN", \testDpOpIn());
        addTestCase("DP_OP_NOT_IN", \testDpOpNotIn());
        addTestCase("DP IN large + mixed", \testDpOpInLargeAndMixed());

        # Date/string function tests
        addTestCase("DP_FUNC_FORMAT_DATE", \testDpFuncFormatDate());
        addTestCase("DP_FUNC_SUBSTR", \testDpFuncSubstr());

        # Test format conversion helper
        addTestCase("convertDateFormat", \testConvertDateFormat());

        # Verify expression map completeness
        addTestCase("DP_FUNC_DIGEST", \testDpFuncDigest());
        addTestCase("expression map keys", \testExpressionMapKeys());
        addTestCase("DPQL select expressions", \testDpqlSelectExpressions());
        addTestCase("DPQL update assignment expressions", \testDpqlUpdateAssignmentExpressions());

        # Generic SqlUtil CTAS API
        addTestCase("create as select", \testCreateAsSelect());
        addTestCase("drop table options", \testDropTableOptions());
        addTestCase("stats preferences unsupported", \testStatsPreferencesUnsupported());
        addTestCase("create constraints SQL", \testCreateConstraintsSql());

        set_return_value(main());
    }

    globalTearDown() {
        if (table) {
            table.dropCommit();
        }
    }

    private Datasource getDatasource() {
%ifdef NoSqlite3
        testSkip("no sqlite3 module");
%endif
        string connstr = m_options.connstr ?? ENV.QORE_DB_CONNSTR_SQLITE3 ?? "";
        if (!connstr.val()) {
            testSkip("no DB connection");
        }
        Datasource ds(connstr);
        if (ds.getDriverName() != "sqlite3") {
            testSkip("not a sqlite3 connection");
        }
        ds.open();
        return ds;
    }

    private setupTable() {
        # drop if exists
        {
            Sqlite3Table t(ds, TableName);
            if (t.checkExistence()) {
                t.dropCommit();
            }
        }
        # create test table with various column types
        ds.execRaw("create table " + TableName + " ("
            "id integer primary key, "
            "name text not null, "
            "description text, "
            "amount real, "
            "is_active integer default 1, "
            "created_at text default (datetime('now'))"
            ")");
        ds.commit();

        table = new Sqlite3Table(ds, TableName);

        # insert test data
        ds.execRaw("insert into " + TableName + " values "
            "(1, 'Hello World', 'A test description', 100.50, 1, '2026-01-15 10:30:00'), "
            "(2, 'foo bar', 'Another test', 200.75, 0, '2026-02-20 14:45:30'), "
            "(3, 'UPPER CASE', null, 0.00, 1, '2026-03-25 08:00:00'), "
            "(4, 'Test String', 'has special chars: 100%', 50.25, null, '2026-04-10 16:15:45')");
        ds.commit();
    }

    private cleanupCreateAsSelectTest() {
        Sqlite3Table t(ds, "sqlite3_ctas_test");
        if (t.checkExistence()) {
            t.dropCommit();
        }
    }

    private cleanupDropOptionsTest() {
        Sqlite3Table t(ds, "sqlite3_drop_options_test");
        if (t.checkExistence()) {
            t.dropCommit();
        }
    }

    private cleanupDpqlUpdateAssignmentTest() {
        Sqlite3Table t(ds, "sqlite3_dpql_update_test");
        if (t.checkExistence()) {
            t.dropCommit();
        }
    }

    # Helper: create a field reference
    private hash<DataProviderFieldReference> fref(string name) {
        return <DataProviderFieldReference>{"field": name};
    }

    # Helper: create an expression
    private hash<DataProviderExpression> expr(string exp, softlist<auto> args) {
        return <DataProviderExpression>{"exp": exp, "args": args};
    }

    # Helper: create an aliased expression column (wraps with COP_AS)
    private hash<DataProviderExpression> aliased(string alias, hash<DataProviderExpression> inner) {
        return expr(COP_AS, (inner, alias));
    }

    # Helper: select with expression-based where clause and return rows
    private hash<auto> selectWhere(hash<DataProviderExpression> cond) {
        return table.select({
            "columns": ("id",),
            "where": cond,
            "orderby": "id",
        });
    }

    # Helper: select a single row with an aliased expression column
    private *hash<auto> selectExprRow(string alias, hash<DataProviderExpression> col_expr, int id) {
        return table.selectRow({
            "columns": (
                "id",
                aliased(alias, col_expr),
            ),
            "where": {"id": id},
        });
    }

    testCreateAsSelect() {
        if (!table) { testSkip("no DB connection"); }

        cleanupCreateAsSelectTest();
        on_exit {
            try {
                cleanupCreateAsSelectTest();
            } catch (hash<ExceptionInfo> ex) {
            }
        }

        Sqlite3Table target(ds, "sqlite3_ctas_test");
        hash<SqlResultInfo> info = target.getCreateAsSelectSqlWithInfo(table, {
            "columns": ("id", "name"),
            "where": {"is_active": 1},
        });
        assertTrue(info.sql =~ /^create table sqlite3_ctas_test as select/i);
        assertEq(1, info.args.size());
        assertEq(1, info.args[0]);

        info = target.createAsSelectWithInfo(table, {
            "columns": ("id", "name"),
            "where": {"is_active": 1},
        });
        assertTrue(info.sql =~ /^create table sqlite3_ctas_test as select/i);
        assertEq(1, info.args.size());

        Sqlite3Table materialized(ds, "sqlite3_ctas_test");
        assertEq(2, materialized.rowCount());
        hash<auto> rows = materialized.select({"columns": ("id", "name"), "orderby": "id"});
        assertEq((1, 3), rows.id);
        assertEq(("Hello World", "UPPER CASE"), rows.name);
    }

    testDropTableOptions() {
        if (!table) { testSkip("no DB connection"); }

        cleanupDropOptionsTest();
        on_exit {
            try {
                cleanupDropOptionsTest();
            } catch (hash<ExceptionInfo> ex) {
            }
        }

        ds.execRaw("create table sqlite3_drop_options_test (id integer primary key)");
        ds.commit();

        Sqlite3Table t(ds, "sqlite3_drop_options_test");
        softlist<auto> sql = t.getDropSql({"if_exists": True});
        assertEq(1, sql.size());
        assertEq("drop table if exists sqlite3_drop_options_test", sql[0]);
        t.dropCommit({"if_exists": True});
        assertFalse(t.checkExistence());

        assertEq((), t.getDropSql({"if_exists": True}));
        t.dropCommit({"if_exists": True});

        ds.execRaw("create table sqlite3_drop_options_test (id integer primary key)");
        ds.commit();
        Sqlite3Table t2(ds, "sqlite3_drop_options_test");
        assertThrows("OPTION-ERROR", "cascade table drop options", \t2.getDropSql(), {"cascade": True});
    }

    testStatsPreferencesUnsupported() {
        if (!table) { testSkip("no DB connection"); }

        assertThrows("STATS-PREFERENCES-NOT-SUPPORTED", "does not support table statistics preferences",
            \table.getSetStatsPreferencesSql(), {"incremental": True});
    }

    testCreateConstraintsSql() {
        if (!table) { testSkip("no DB connection"); }

        *list<auto> sql = table.getCreateConstraintsSql();
        assertEq(NOTHING, sql);
    }

    # --- Pattern matching tests ---

    testDpOpLike() {
        if (!table) { testSkip("no DB connection"); }

        # case-sensitive LIKE
        hash<auto> rows = selectWhere(
            expr(DP_OP_LIKE, (fref("name"), "%World%", False)),
        );
        assertEq((1,), rows.id);

        # case-insensitive LIKE
        rows = selectWhere(
            expr(DP_OP_LIKE, (fref("name"), "%world%", True)),
        );
        assertEq((1,), rows.id);

        # explicit case-sensitive behavior overrides SQLite's default ASCII behavior
        rows = selectWhere(
            expr(DP_OP_LIKE, (fref("name"), "%world%", False)),
        );
        assertEq((), rows.id);
    }

    testDpOpContains() {
        if (!table) { testSkip("no DB connection"); }

        # case-insensitive contains
        hash<auto> rows = selectWhere(
            expr(DP_OP_CONTAINS, (fref("name"), "world", True)),
        );
        assertEq((1,), rows.id);

        # the case option is optional and defaults to case-sensitive matching
        rows = selectWhere(
            expr(DP_OP_CONTAINS, (fref("name"), "world")),
        );
        assertEq((), rows.id);

        # substring in middle
        rows = selectWhere(
            expr(DP_OP_CONTAINS, (fref("name"), "bar", False)),
        );
        assertEq((2,), rows.id);
    }

    testDpOpStartsWith() {
        if (!table) { testSkip("no DB connection"); }

        # case-insensitive starts with
        hash<auto> rows = selectWhere(
            expr(DP_OP_STARTS_WITH, (fref("name"), "hello", True)),
        );
        assertEq((1,), rows.id);

        # case-sensitive starts with
        rows = selectWhere(
            expr(DP_OP_STARTS_WITH, (fref("name"), "Hello", False)),
        );
        assertEq((1,), rows.id);

        # explicit case-sensitive behavior overrides SQLite's default ASCII behavior
        rows = selectWhere(
            expr(DP_OP_STARTS_WITH, (fref("name"), "hello", False)),
        );
        assertEq((), rows.id);
    }

    testDpOpEndsWith() {
        if (!table) { testSkip("no DB connection"); }

        # case-insensitive ends with
        hash<auto> rows = selectWhere(
            expr(DP_OP_ENDS_WITH, (fref("name"), "world", True)),
        );
        assertEq((1,), rows.id);

        # case-sensitive ends with
        rows = selectWhere(
            expr(DP_OP_ENDS_WITH, (fref("name"), "bar", False)),
        );
        assertEq((2,), rows.id);

        # case-sensitive match
        rows = selectWhere(
            expr(DP_OP_ENDS_WITH, (fref("name"), "CASE", False)),
        );
        assertEq((3,), rows.id);
    }

    testDpOpReplace() {
        if (!table) { testSkip("no DB connection"); }

        # simple replace
        *hash<auto> row = selectExprRow("result",
            expr(DP_OP_REPLACE, (fref("name"), "World", "Qore")), 1);
        assertEq("Hello Qore", row.result);

        # replace nothing (no match)
        row = selectExprRow("result",
            expr(DP_OP_REPLACE, (fref("name"), "xyz", "abc")), 1);
        assertEq("Hello World", row.result);
    }

    # --- Type conversion tests ---

    testDpOpToString() {
        if (!table) { testSkip("no DB connection"); }

        *hash<auto> row = selectExprRow("result",
            expr(DP_OP_TO_STRING, (fref("amount"),)), 1);
        assertEq(Type::String, row.result.type());
        assertTrue(row.result.val());
    }

    testDpOpToInt() {
        if (!table) { testSkip("no DB connection"); }

        *hash<auto> row = selectExprRow("result",
            expr(DP_OP_TO_INT, (fref("amount"),)), 1);
        # 100.50 cast to integer = 100 (truncated) or 101 (rounded)
        assertEq(Type::Int, row.result.type());
        assertTrue(row.result >= 100 && row.result <= 101);
    }

    testDpOpToFloat() {
        if (!table) { testSkip("no DB connection"); }

        *hash<auto> row = selectExprRow("result",
            expr(DP_OP_TO_FLOAT, (fref("id"),)), 1);
        assertEq(Type::Float, row.result.type());
        assertEq(1.0, row.result);
    }

    testDpOpToNumber() {
        if (!table) { testSkip("no DB connection"); }

        *hash<auto> row = selectExprRow("result",
            expr(DP_OP_TO_NUMBER, (fref("id"),)), 1);
        assertTrue(row.result == 1);
    }

    # --- String manipulation tests ---

    testDpOpToLower() {
        if (!table) { testSkip("no DB connection"); }

        *hash<auto> row = selectExprRow("result",
            expr(DP_OP_TO_LOWER, (fref("name"),)), 3);
        assertEq("upper case", row.result);
    }

    testDpOpToUpper() {
        if (!table) { testSkip("no DB connection"); }

        *hash<auto> row = selectExprRow("result",
            expr(DP_OP_TO_UPPER, (fref("name"),)), 1);
        assertEq("HELLO WORLD", row.result);
    }

    testDpOpLength() {
        if (!table) { testSkip("no DB connection"); }

        *hash<auto> row = selectExprRow("result",
            expr(DP_OP_LENGTH, (fref("name"),)), 1);
        assertEq(11, row.result);  # "Hello World" = 11 chars
    }

    # --- Control flow / misc tests ---

    testDpOpTernary() {
        if (!table) { testSkip("no DB connection"); }

        # ternary: if is_active then 'yes' else 'no'
        *hash<auto> row = selectExprRow("result",
            expr(DP_OP_TERNARY, (fref("is_active"), "yes", "no")), 1);
        assertEq("yes", row.result);

        row = selectExprRow("result",
            expr(DP_OP_TERNARY, (fref("is_active"), "yes", "no")), 2);
        assertEq("no", row.result);
    }

    testDpOpHasValue() {
        if (!table) { testSkip("no DB connection"); }

        # description is null for id=3
        hash<auto> rows = selectWhere(
            expr(DP_OP_HAS_VALUE, (fref("description"),)),
        );
        assertEq((1, 2, 4), rows.id);

        # is_active is null for id=4
        rows = selectWhere(
            expr(DP_OP_HAS_VALUE, (fref("is_active"),)),
        );
        assertEq((1, 2, 3), rows.id);
    }

    # counts the bind placeholders in generated SQL; guards against the value list being bound to a
    # single placeholder (which silently mismatches on backends without native list-bind support)
    private int bindCount(hash<DataProviderExpression> cond) {
        list<auto> args;
        string sql = table.getSelectSql({"columns": ("id",), "where": cond}, \args);
        return sql.split("%v").size() - 1;
    }

    # evaluates the expression in memory (generic implementation) over the known test rows and
    # returns the ids that match; used to assert the in-memory and SQL implementations agree
    private list<int> evalIds(hash<DataProviderExpression> cond) {
        list<int> rv = ();
        foreach hash<auto> rec in (table.selectRows({"orderby": "id"})) {
            if (AbstractDataProvider::evalGenericExpression(rec, cond)) {
                rv += rec.id;
            }
        }
        return rv;
    }

    testDpOpIn() {
        if (!table) { testSkip("no DB connection"); }

        # validated generic form: (field, list); each value must bind to its own placeholder
        hash<DataProviderExpression> num_in = expr(DP_SEARCH_OP_IN, (fref("id"), (1, 3, 4)));
        assertEq(3, bindCount(num_in));
        assertEq((1, 3, 4), selectWhere(num_in).id);

        # string column membership
        assertEq((2, 3),
            selectWhere(expr(DP_SEARCH_OP_IN, (fref("name"), ("foo bar", "UPPER CASE")))).id);

        # single-element list
        assertEq((2,), selectWhere(expr(DP_SEARCH_OP_IN, (fref("id"), (2,)))).id);

        # the varargs form (field, v1, v2, ...) - what the DPQL parser produces - must behave
        # identically to the (field, list) form and bind each value separately
        hash<DataProviderExpression> varargs = expr(DP_SEARCH_OP_IN, (fref("id"), 1, 3, 4));
        assertEq(3, bindCount(varargs));
        assertEq((1, 3, 4), selectWhere(varargs).id);

        # a DPQL-parsed "in" (which emits the varargs form) must work against a SqlUtil table
        hash<DataProviderExpression> dpql = DataProvider::parseDpqlExpression("@id in (1, 4)");
        assertEq(2, bindCount(dpql));
        assertEq((1, 4), selectWhere(dpql).id);

        # the in-memory (generic) implementation must agree with the SQL implementation for every form
        assertEq(selectWhere(num_in).id, evalIds(num_in));
        assertEq(selectWhere(varargs).id, evalIds(varargs));
        assertEq(selectWhere(dpql).id, evalIds(dpql));
    }

    testDpOpNotIn() {
        if (!table) { testSkip("no DB connection"); }

        # numeric column: ids not in (1, 2) -> 3, 4
        hash<DataProviderExpression> num_not_in = expr(DP_OP_NOT_IN, (fref("id"), (1, 2)));
        assertEq(2, bindCount(num_not_in));
        assertEq((3, 4), selectWhere(num_not_in).id);

        # string column
        assertEq((1, 4),
            selectWhere(expr(DP_OP_NOT_IN, (fref("name"), ("foo bar", "UPPER CASE")))).id);

        # varargs form (as produced by DPQL) must behave identically
        hash<DataProviderExpression> varargs = expr(DP_OP_NOT_IN, (fref("id"), 1, 2));
        assertEq(2, bindCount(varargs));
        assertEq((3, 4), selectWhere(varargs).id);
    }

    # Regression: a large IN list must generate the right SQL (one placeholder per value, values
    # bound in order) and must do so in linear time.  Historically the "in"/"not in" ops built the
    # placeholder list with an O(n^2) foldl string concatenation and bound each value one at a time
    # through the reference<hash<QueryInfo>> (each append copied the whole QueryInfo hash, making the
    # bind step O(n * map-size)); both made large IN clauses spin CPU for seconds.
    testDpOpInLargeAndMixed() {
        if (!table) { testSkip("no DB connection"); }

        # large scalar IN list: one placeholder + one bind per value, in order
        list<int> ids = map $1, xrange(1, 5001);
        assertEq(5000, ids.size());
        hash<DataProviderExpression> big_in = expr(DP_SEARCH_OP_IN, (fref("id"), ids));
        list<auto> args;
        string sql = table.getSelectSql({"columns": ("id",), "where": big_in}, \args);
        assertEq(ids.size(), args.size());
        assertEq(ids, args);
        assertEq(ids.size(), sql.split("%v").size() - 1);
        # same for "not in"
        list<auto> nargs;
        table.getSelectSql({"columns": ("id",),
            "where": expr(DP_OP_NOT_IN, (fref("id"), ids))}, \nargs);
        assertEq(ids, nargs);

        # mixed IN list: scalars interleaved with a field reference and a nested expression must
        # preserve bind order (scalar binds flushed before/after the non-scalar elements)
        list<auto> margs;
        string msql = table.getSelectSql({"columns": ("id",), "where":
            expr(DP_SEARCH_OP_IN, (fref("id"),
                (7, fref("id"), 9,
                 expr(DP_OP_PLUS, (fref("id"), 100)), 11)))}, \margs);
        # binds in source order: 7, 9, 100, 11 (the bare field reference binds nothing)
        assertEq((7, 9, 100, 11), margs);
        assertEq(4, msql.split("%v").size() - 1);
    }

    # --- Date/string function tests ---

    testDpFuncFormatDate() {
        if (!table) { testSkip("no DB connection"); }

        *hash<auto> row = selectExprRow("result",
            expr(DP_FUNC_FORMAT_DATE, (fref("created_at"), "YYYY-MM-DD")), 1);
        assertEq("2026-01-15", row.result);

        # format with time components
        row = selectExprRow("result",
            expr(DP_FUNC_FORMAT_DATE, (fref("created_at"), "YYYY-MM-DD HH:mm:SS")), 1);
        assertEq("2026-01-15 10:30:00", row.result);
    }

    testDpFuncSubstr() {
        if (!table) { testSkip("no DB connection"); }

        # substring from position (1-based) with length
        *hash<auto> row = selectExprRow("result",
            expr(DP_FUNC_SUBSTR, (fref("name"), 1, 5)), 1);
        assertEq("Hello", row.result);

        # substring without length (rest of string)
        row = selectExprRow("result",
            expr(DP_FUNC_SUBSTR, (fref("name"), 7)), 1);
        assertEq("World", row.result);
    }

    # --- Helper tests ---

    testConvertDateFormat() {
        # test the date format conversion - no DB needed
        assertEq("%Y-%m-%d", Sqlite3Table::convertDateFormat("YYYY-MM-DD"));
        assertEq("%Y-%m-%d %H:%M:%S", Sqlite3Table::convertDateFormat("YYYY-MM-DD HH:mm:SS"));
        assertEq("%Y-%m-%d %H:%M:%S.%f", Sqlite3Table::convertDateFormat("YYYY-MM-DD HH:mm:SS.us"));
        assertEq("%H:%M:%S.%f", Sqlite3Table::convertDateFormat("HH:mm:SS.ms"));
        # ensure MM is converted to %m
        assertEq("%m-%d", Sqlite3Table::convertDateFormat("MM-DD"));
        # ensure single quotes are escaped for SQL safety
        assertEq("%Y''%m''%d", Sqlite3Table::convertDateFormat("YYYY'MM'DD"));
    }

    testExpressionMapKeys() {
        if (!table) { testSkip("no DB connection"); }

        hash<auto> emap = table.getExpressionMap();

        # verify all SQLite3-specific overrides are present
        assertTrue(emap.hasKey(DP_OP_TO_STRING));
        assertTrue(emap.hasKey(DP_OP_TO_FLOAT));
        assertTrue(emap.hasKey(DP_OP_TO_NUMBER));
        assertTrue(emap.hasKey(DP_OP_LENGTH));
        assertTrue(emap.hasKey(DP_FUNC_FORMAT_DATE));

        # verify inherited default operators are present
        assertTrue(emap.hasKey(DP_OP_LIKE));
        assertTrue(emap.hasKey(DP_OP_CONTAINS));
        assertTrue(emap.hasKey(DP_OP_STARTS_WITH));
        assertTrue(emap.hasKey(DP_OP_ENDS_WITH));
        assertTrue(emap.hasKey(DP_OP_REPLACE));
        assertTrue(emap.hasKey(DP_OP_TO_INT));
        assertTrue(emap.hasKey(DP_OP_TO_LOWER));
        assertTrue(emap.hasKey(DP_OP_TO_UPPER));
        assertTrue(emap.hasKey(DP_OP_TERNARY));
        assertTrue(emap.hasKey(DP_OP_HAS_VALUE));
        assertTrue(emap.hasKey(DP_OP_AND));
        assertTrue(emap.hasKey(DP_EXPR_VALUE));
        assertTrue(emap.hasKey(DP_OP_PLUS));
        assertTrue(emap.hasKey(DP_OP_MINUS));
        assertTrue(emap.hasKey(DP_OP_MULT));
        assertTrue(emap.hasKey(DP_OP_DIV));
        assertTrue(emap.hasKey(OP_LIKE));
        assertTrue(emap.hasKey(COP_UPPER));
        assertTrue(emap.hasKey(COP_LOWER));
        assertTrue(emap.hasKey(DP_FUNC_DIGEST));
    }

    testDpqlSelectExpressions() {
        if (!table) { testSkip("no DB connection"); }

        list<auto> columns = table.parseDpqlSelectColumns({
            "name_upper": "upr(@name)",
        });
        assertEq(1, columns.size());
        assertEq(COP_AS, columns[0].exp);
        assertEq(DP_OP_TO_UPPER, columns[0].args[0].exp);
        assertEq("name_upper", columns[0].args[1]);

        *hash<auto> row = table.selectRowDpql({
            "columns_dpql": {
                "name_upper": "upr(@name)",
                "amount_plus": "@amount + 1",
            },
            "where_dpql": "@id == 1",
        });
        assertEq("HELLO WORLD", row.name_upper);
        assertEqSoft(101.5, row.amount_plus);

        hash<SqlResultInfo> rows_info = table.selectRowsDpqlWithInfo({
            "columns_dpql": {
                "name_upper": "upr(@name)",
            },
            "where_dpql": "@id in (1, 3)",
            "orderby": "id",
        });
        assertEq(2, rows_info.result.size());
        assertEq("HELLO WORLD", rows_info.result[0].name_upper);
        assertEq("UPPER CASE", rows_info.result[1].name_upper);
        assertTrue(rows_info.sql =~ /^select upper\(name\) as name_upper from /);
        assertEq((1, 3), rows_info.args);

        hash<SqlResultInfo> select_info = table.selectDpqlWithInfo({
            "columns_dpql": {
                "next_id": "@id + 1",
            },
            "where_dpql": "@id == 1",
        });
        assertEq((2,), select_info.result.next_id);

        list<auto> args;
        string sql = table.getSelectDpqlSql({
            "columns_dpql": {
                "amount_plus": "@amount + 1",
            },
            "where_dpql": "@id == 1",
        }, \args);
        assertTrue(sql =~ /^select \(amount \+ %v\) as amount_plus from /);
        assertEq((1, 1), args);

        assertThrows("OPTION-ERROR", "\"columns\" and \"columns_dpql\"", \table.prepareDpqlSelectHash(), {
            "columns": "id",
            "columns_dpql": {"x": "@id"},
        });
        assertThrows("OPTION-ERROR", "\"where\" and \"where_dpql\"", \table.prepareDpqlSelectHash(), {
            "where": {"id": 1},
            "where_dpql": "@id == 1",
        });
        assertThrows("COLUMN-ERROR", "query references unknown column", \table.parseDpqlSelectColumns(), {
            "x": "@missing",
        });
    }

    testDpqlUpdateAssignmentExpressions() {
        if (!table) { testSkip("no DB connection"); }

        cleanupDpqlUpdateAssignmentTest();
        on_exit {
            try {
                cleanupDpqlUpdateAssignmentTest();
            } catch (hash<ExceptionInfo> ex) {
            }
        }

        ds.execRaw("create table sqlite3_dpql_update_test ("
            "id integer primary key, "
            "target integer, "
            "source integer, "
            "delta integer, "
            "label text"
            ")");
        ds.execRaw("insert into sqlite3_dpql_update_test values "
            "(1, 0, 10, 3, 'alpha'), "
            "(2, 0, null, 5, 'beta')");
        ds.commit();

        Sqlite3Table t(ds, "sqlite3_dpql_update_test");

        assertEq(DP_OP_PLUS, t.parseDpqlFieldExpression("@source + @delta", "target").exp);
        assertEq(DP_SEARCH_OP_EQ, t.parseDpqlSearchExpression("@id == 1").exp);

        # Bare DPQL field references parse to DP_EXPR_VALUE and must be usable as an update RHS.
        hash<SqlCommandInfo> cmd = t.getUpdateSql({
            "target": t.parseDpqlFieldExpression("@source", "target"),
        }, {"id": 1});
        assertEq("update sqlite3_dpql_update_test set target = source where id = %v", cmd.sql);
        assertEq((1,), cmd.args);

        # Canonical DPQL arithmetic operators must map to SqlUtil SQL expressions.
        hash<SqlResultInfo> info = t.updateDpqlWithInfo({
            "target": "@source + @delta",
            "label": "upr(@label)",
        }, "@id == 1");
        ds.commit();
        assertEq(1, info.result);
        assertTrue(info.sql =~ /^update sqlite3_dpql_update_test set /);
        assertEq((1,), info.args);

        *hash<auto> row = t.selectRow({"where": {"id": 1}});
        assertEq(13, row.target);
        assertEq("ALPHA", row.label);

        assertEq(1, t.updateDpqlCommit({
            "target": "coalesce(@source, @delta, 0)",
            "label": '"gamma"',
        }, "@id == 2"));

        row = t.selectRow({"where": {"id": 2}});
        assertEq(5, row.target);
        assertEq("gamma", row.label);

        # Existing update() semantics are unchanged: plain strings are literal values, not DPQL.
        t.updateCommit({"label": "@source"}, {"id": 2});
        row = t.selectRow({"where": {"id": 2}});
        assertEq("@source", row.label);

        hash<SqlResultInfo> del_info = t.delDpqlWithInfo("@id == 2");
        ds.commit();
        assertEq(1, del_info.result);
        assertEq("delete from sqlite3_dpql_update_test where id = %v", del_info.sql);
        assertEq((2,), del_info.args);
        assertEq(1, t.rowCount());

        assertThrows("COLUMN-ERROR", "query references unknown column", \t.parseDpqlFieldExpression(),
            ("@missing", "target"),
            "unknown DPQL field in update assignment");
    }

    testDpFuncDigest() {
        if (!table) { testSkip("no DB connection"); }

        # SQLite has no built-in cryptographic hash functions, so digest must raise a clear error
        assertThrows("DIGEST-ERROR", sub () {
            selectExprRow("d", expr(DP_FUNC_DIGEST, (fref("name"), "sha256", "hex")), 1);
        });
    }
}
