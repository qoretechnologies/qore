%modern
%enable-all-warnings

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires DataProvider
%requires SqlUtil
%requires OracleSqlUtilBase
%requires OracleSqlUtil
%requires QUnit

%try-module oracle
%define NoOracle
%endtry

%exec-class OracleListTablesTest

#! A datasource that answers the catalog queries of OracleSqlUtilBase from an in-memory catalog and records them
/** No connection is opened: the queries that OracleTable and OracleDatabase make to list and acquire tables are
    answered from the objects given, so that what is listed and opened as a table is tested without an Oracle server.
*/
class CatalogDatasource inherits Datasource {
    public {
        #! the queries made, with their arguments
        list<hash<auto>> queries = ();
    }

    private {
        #! the user's tables, with the container tables of the user's materialized views
        list<string> user_tables;
        #! the user's views
        list<string> user_views;
        #! the user's materialized views
        list<string> user_mviews;
        #! the user's dropped tables in the recycle bin, which are in user_tables with dropped = 'YES'
        list<string> user_dropped;
        #! the user's synonyms: name -> hash of owner, name and type of the object named
        hash<string, hash<auto>> synonyms;
        #! the objects of other schemas: "OWNER.NAME" -> "TABLE", "VIEW", "MATERIALIZED VIEW" or "DROPPED TABLE"
        hash<string, string> other_objects;
    }

    constructor(list<string> user_tables, list<string> user_views, list<string> user_mviews,
            list<string> user_dropped, hash<string, hash<auto>> synonyms, hash<string, string> other_objects)
            : Datasource("oracle:qtest/none@qtest") {
        self.user_tables = user_tables + user_mviews + user_dropped;
        self.user_dropped = user_dropped;
        self.user_views = user_views;
        self.user_mviews = user_mviews;
        self.synonyms = synonyms;
        self.other_objects = other_objects;
    }

    auto getServerVersion() {
        return "19.3.0.0.0";
    }

    string getDriverRealName() {
        return "oracle";
    }

    *hash<auto> select(string sql) {
        return answer(sql, argv, True);
    }

    *hash<auto> selectRow(string sql) {
        return answer(sql, argv, False);
    }

    #! returns the answer to a query, as a hash of lists for select() (\a as_list) or a row for selectRow()
    private *hash<auto> answer(string sql, *list<auto> args, bool as_list) {
        queries += {"sql": sql, "args": args};
        # system view introspection: every DBA_* view is available
        if (sql =~ /from all_objects/) {
            return {"object_name": map $1.upr(), args[1]."^values^"};
        }
        # the listing of the user's tables: user_tables has the container tables of materialized views, which the
        # query has to exclude
        # and the dropped tables in the recycle bin, with dropped = 'YES'
        if (sql =~ /^select table_name from user_tables/) {
            bool excl = (sql =~ /not exists \(select 1 from user_mviews m where m\.mview_name = t\.table_name\)/);
            bool excl_dropped = (sql =~ /nvl\(t\.dropped, 'NO'\) != 'YES'/);
            return {"table_name": sort(map $1, user_tables, (!excl || !inlist($1, user_mviews))
                && (!excl_dropped || !inlist($1, user_dropped)))};
        }
        # the listing of the tables of the user's synonyms: all_tables has the container tables of materialized
        # views as well
        if (sql =~ /^select synonym_name from user_synonyms s, all_tables t/) {
            bool excl = (sql =~ /not exists \(select 1 from all_mviews m where m\.owner = t\.owner and m\.mview_name = t\.table_name\)/);
            bool excl_dropped = (sql =~ /nvl\(t\.dropped, 'NO'\) != 'YES'/);
            return {"synonym_name": sort(map $1.key, synonyms.pairIterator(), $1.value.type == "TABLE"
                || (!excl && $1.value.type == "MATERIALIZED VIEW")
                || (!excl_dropped && $1.value.type == "DROPPED TABLE"))};
        }
        # the views, materialized views and sequences: the recycle bin has none of them
        if (sql =~ /^select object_name from user_objects where object_type = %v order by 1$/) {
            switch (args[0]) {
                case "VIEW": return {"object_name": user_views};
                case "MATERIALIZED VIEW": return {"object_name": user_mviews};
            }
            return {"object_name": ()};
        }
        if (sql =~ /^select \* from user_tables where table_name = %v$/) {
            return inlist(args[0], user_tables)
                ? {"table_name": args[0], "tablespace_name": "USERS",
                    "dropped": inlist(args[0], user_dropped) ? "YES" : "NO"}
                : NOTHING;
        }
        if (sql =~ /^select \* from user_views where view_name = %v$/) {
            return inlist(args[0], user_views) ? {"view_name": args[0]} : NOTHING;
        }
        if (sql =~ /^select 1 as v from dba_mviews where owner = %v and mview_name = %v$/) {
            if (args[0] == "QTEST") {
                return inlist(args[1], user_mviews) ? {"v": 1} : NOTHING;
            }
            return other_objects{args[0] + "." + args[1]} == "MATERIALIZED VIEW" ? {"v": 1} : NOTHING;
        }
        if (sql =~ /^select \* from dba_tables where owner = %v and table_name = %v$/) {
            *string type = other_objects{args[0] + "." + args[1]};
            return (type == "TABLE" || type == "MATERIALIZED VIEW" || type == "DROPPED TABLE")
                ? {"table_name": args[1], "tablespace_name": "USERS", "dropped": type == "DROPPED TABLE" ? "YES" : "NO"}
                : NOTHING;
        }
        if (sql =~ /^select \* from dba_views where owner = %v and view_name = %v$/) {
            return other_objects{args[0] + "." + args[1]} == "VIEW" ? {"view_name": args[1]} : NOTHING;
        }
        if (sql =~ /dbms_utility\.name_resolve/) {
            # the name is given as "OWNER"."NAME"
            string name = (args[0] =~ x/\.(.*)$/)[0];
            name =~ s/"//g;
            if (*hash<auto> syn = synonyms{name}) {
                return {"owner": syn.owner, "table": syn.name, "link": NULL};
            }
            throw "ORA-06564", "object does not exist";
        }
        if (sql =~ /from dba_synonyms s/) {
            # the fallback synonym resolution, after dbms_utility.name_resolve() failed
            *hash<auto> syn = args[0] == "QTEST" ? synonyms{args[1]} : NOTHING;
            return (syn && syn.type != "MATERIALIZED VIEW")
                ? {"table_owner": syn.owner, "table_name": syn.name,
                    "object_type": syn.type == "DROPPED TABLE" ? "TABLE" : syn.type}
                : NOTHING;
        }
        if (sql =~ /from dba_tab_comments/) {
            return as_list ? {} : {"comments": NULL};
        }
        throw "UNEXPECTED-QUERY", sprintf("unexpected query: %s (args: %y)", sql, args);
    }
}

#! Tests that OracleSqlUtil lists and opens only tables as tables, without an Oracle server
/** The catalog queries are answered by CatalogDatasource; nothing here is run against a live Oracle database.
*/
class OracleListTablesTest inherits QUnit::Test {
    constructor() : Test("OracleListTables", "1.0") {
        addTestCase("listTables() lists only tables", \listTablesTest());
        addTestCase("getTable() opens only tables", \getTableTest());
        addTestCase("a synonym opens only a table", \synonymTest());
        addTestCase("a table object reads a view or a materialized view", \tableObjectTest());
        addTestCase("dropped tables in the recycle bin are not tables", \recycleBinTest());
        set_return_value(main());
    }

    #! returns a catalog with a table, a view, a materialized view and a dropped table of the user, and synonyms of
    #! each kind
    private CatalogDatasource getCatalog() {
        return new CatalogDatasource(("T1",), ("V1",), ("MV1",), ("BIN$TBL1$0",), {
            "SYN_T": {"owner": "OTHER", "name": "T2", "type": "TABLE"},
            "SYN_V": {"owner": "OTHER", "name": "V2", "type": "VIEW"},
            "SYN_MV": {"owner": "OTHER", "name": "MV2", "type": "MATERIALIZED VIEW"},
            "SYN_DROPPED": {"owner": "OTHER", "name": "BIN$TBL2$0", "type": "DROPPED TABLE"},
        }, {
            "OTHER.T2": "TABLE",
            "OTHER.V2": "VIEW",
            "OTHER.MV2": "MATERIALIZED VIEW",
            "OTHER.BIN$TBL2$0": "DROPPED TABLE",
        });
    }

    private checkDriver() {
%ifdef NoOracle
        testSkip("the oracle driver is not available");
%endif
    }

    listTablesTest() {
        checkDriver();
        CatalogDatasource ds = getCatalog();
        OracleDatabase db(ds);
        # the materialized view's container table, the dropped table and the synonyms of the other schema's
        # materialized view and dropped table are not listed; the synonym of the view was never listed
        assertEq(("syn_t", "t1"), db.listTables());
        assertEq(2, ds.queries.size(), "a query each for the user's tables and the tables of the user's synonyms");
    }

    getTableTest() {
        checkDriver();
        OracleDatabase db(getCatalog());
        assertEq("t1", db.getTable("t1").getName());
        assertNothing(db.getTable("v1"), "a view is not opened as a table");
        assertNothing(db.getTable("mv1"), "a materialized view is not opened as a table");
        assertNothing(db.getTable("no_such_table"));
        # every name listed opens as a table
        foreach string name in (db.listTables()) {
            assertTrue(exists db.getTable(name), name);
        }
    }

    synonymTest() {
        checkDriver();
        OracleDatabase db(getCatalog());
        assertEq("t2", db.getTable("syn_t").getName(), "a synonym of a table opens the table");
        assertNothing(db.getTable("syn_v"), "a synonym of a view does not open as a table");
        assertNothing(db.getTable("syn_mv"), "a synonym of a materialized view does not open as a table");
    }

    tableObjectTest() {
        checkDriver();
        CatalogDatasource ds = getCatalog();
        # a table object made for a view knows that it is a view, and does not exist as a table
        OracleTable v = AbstractTable::getTable(ds, "v1");
        assertFalse(v.checkExistence());
        assertTrue(v.isView());
        assertFalse(v.inDb());
        OracleTable mv = AbstractTable::getTable(ds, "mv1");
        assertFalse(mv.checkExistence());
        assertTrue(mv.isMaterializedView());
        assertFalse(mv.isView());
        OracleTable t = AbstractTable::getTable(ds, "t1");
        assertTrue(t.checkExistence());
        assertFalse(t.isView());
        assertFalse(t.isMaterializedView());
        assertTrue(t.inDb());
    }

    recycleBinTest() {
        checkDriver();
        CatalogDatasource ds = getCatalog();
        OracleDatabase db(ds);
        assertFalse(inlist("bin$tbl1$0", db.listTables()), "a dropped table is not listed");
        assertFalse(inlist("syn_dropped", db.listTables()), "a synonym of a dropped table is not listed");
        assertNothing(db.getTable("bin$tbl1$0"), "a dropped table is not opened as a table");
        assertNothing(db.getTable("syn_dropped"), "a synonym of a dropped table does not open as a table");
        OracleTable t = AbstractTable::getTable(ds, "bin$tbl1$0");
        assertFalse(t.checkExistence());
        assertTrue(t.isDropped());
        OracleTable t1 = AbstractTable::getTable(ds, "t1");
        assertTrue(t1.checkExistence());
        assertFalse(t1.isDropped());
        # the recycle bin has no views, materialized views or sequences, so their listings are unchanged
        assertEq(("v1",), db.listViews());
        assertEq(("mv1",), db.listMaterializedViews());
        assertEq((), db.listSequences());
    }
}
