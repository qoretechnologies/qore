#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

# An insert-only upsert skips an existing row without a server error and never sends BEGIN
# Copyright 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%prepend-module-path "${SCRIPT_DIR}"
%requires ./PgsqlTestIsolation.qm
%requires QUnit
%requires SqlUtil
%requires PgsqlSqlUtilBase

%try-module pgsql
%define NoPgsql
%endtry

%exec-class PgsqlInsertOnlyUpsertTest

#! The exception a PostgreSQL server raises for a duplicate key
const DuplicateKeyError = <ExceptionInfo>{
    "err": "DBI:PGSQL:ERROR",
    "desc": "duplicate key value violates unique constraint \"insert_probe_pk\"",
};

#! A datasource that records each statement and answers inserts as scripted, without a database
class RecordingDatasource inherits AbstractDatasource {
    public {
        #! Each statement sent, in order; a transaction start is recorded as "<begin transaction>"
        list<string> statements = ();

        #! The server version reported
        int server_version;

        #! The result of each insert, in order: an int row count, or an ExceptionInfo hash to raise
        list<auto> insert_results = ();
    }

    private {
        bool in_trans = False;
    }

    constructor(int server_version) {
        self.server_version = server_version;
    }

    nothing commit() { statements += "<commit>"; in_trans = False; }
    nothing rollback() { statements += "<rollback>"; in_trans = False; }
    auto exec(string sql, ...) { return vexec(sql, argv); }
    auto vexec(string sql, *softlist<auto> vargs) {
        statements += sql;
        in_trans = True;
        if (sql.equalPartial("insert ")) {
            assertTrue(insert_results.size() > 0, "an insert result is scripted");
            auto rv = shift insert_results;
            if (rv.typeCode() == NT_HASH) {
                throw rv.err, rv.desc;
            }
            return rv;
        }
        return 0;
    }
    auto execRaw(string sql) { return vexec(sql); }
    auto select(string sql, ...) { throw "UNEXPECTED-SELECT", sql; }
    auto selectRow(string sql, ...) { return vselectRow(sql, argv); }
    auto selectRows(string sql, ...) { throw "UNEXPECTED-SELECT", sql; }
    auto selectTyped(string sql, ...) { throw "UNEXPECTED-SELECT", sql; }
    auto selectRowsTyped(string sql, ...) { throw "UNEXPECTED-SELECT", sql; }
    auto vselect(string sql, *softlist<auto> vargs) { throw "UNEXPECTED-SELECT", sql; }
    auto vselectRow(string sql, *softlist<auto> vargs) {
        # the table object's constructor looks up the table
        if (sql =~ /from pg_tables /) {
            return {"schemaname": vargs[0], "tablename": vargs[1]};
        }
        throw "UNEXPECTED-SELECT", sql;
    }
    auto vselectRows(string sql, *softlist<auto> vargs) { throw "UNEXPECTED-SELECT", sql; }
    auto vselectTyped(string sql, *softlist<auto> vargs) { throw "UNEXPECTED-SELECT", sql; }
    auto vselectRowsTyped(string sql, *softlist<auto> vargs) { throw "UNEXPECTED-SELECT", sql; }
    nothing beginTransaction() { statements += "<begin transaction>"; in_trans = True; }
    *string getUserName() {}
    *string getPassword() {}
    *string getDBName() {}
    *string getDBEncoding() {}
    *string getOSEncoding() {}
    *string getHostName() {}
    *int getPort() {}
    string getDriverName() { return "pgsql"; }
    auto getServerVersion() { return server_version; }
    auto getClientVersion() { return server_version; }
    bool inTransaction() { return in_trans; }
    bool currentThreadInTransaction() { return in_trans; }
    hash<auto> getConfigHash() { return {"type": "pgsql"}; }
    string getConfigString() { return "pgsql:"; }

    private assertTrue(bool b, string msg) {
        if (!b) {
            throw "TEST-SCRIPT-ERROR", msg;
        }
    }
}

#! Exposes PgsqlTable::tryInsertImpl() to the test
class InsertProbeTable inherits PgsqlSqlUtilBase::PgsqlTable {
    constructor(AbstractDatasource ds) : PgsqlTable(ds, "public.insert_probe") {
    }

    bool tryInsert(string sql, hash<auto> row) {
        return tryInsertImpl(sql, row);
    }
}

#! A datasource that records each statement sent to a real datasource
class StatementRecorder inherits AbstractDatasource {
    public {
        list<string> statements = ();
    }

    private {
        AbstractDatasource real_ds;
    }

    constructor(AbstractDatasource ds) {
        real_ds = ds;
    }

    nothing commit() { real_ds.commit(); }
    nothing rollback() { real_ds.rollback(); }
    auto exec(string sql, ...) { statements += sql; return real_ds.vexec(sql, argv); }
    auto vexec(string sql, *softlist<auto> vargs) { statements += sql; return real_ds.vexec(sql, vargs); }
    auto execRaw(string sql) { statements += sql; return real_ds.execRaw(sql); }
    auto select(string sql, ...) { return real_ds.vselect(sql, argv); }
    auto selectRow(string sql, ...) { return real_ds.vselectRow(sql, argv); }
    auto selectRows(string sql, ...) { return real_ds.vselectRows(sql, argv); }
    auto selectTyped(string sql, ...) { return real_ds.vselectTyped(sql, argv); }
    auto selectRowsTyped(string sql, ...) { return real_ds.vselectRowsTyped(sql, argv); }
    auto vselect(string sql, *softlist<auto> vargs) { return real_ds.vselect(sql, vargs); }
    auto vselectRow(string sql, *softlist<auto> vargs) { return real_ds.vselectRow(sql, vargs); }
    auto vselectRows(string sql, *softlist<auto> vargs) { return real_ds.vselectRows(sql, vargs); }
    auto vselectTyped(string sql, *softlist<auto> vargs) { return real_ds.vselectTyped(sql, vargs); }
    auto vselectRowsTyped(string sql, *softlist<auto> vargs) { return real_ds.vselectRowsTyped(sql, vargs); }
    nothing beginTransaction() { statements += "<begin transaction>"; real_ds.beginTransaction(); }
    *string getUserName() { return real_ds.getUserName(); }
    *string getPassword() { return real_ds.getPassword(); }
    *string getDBName() { return real_ds.getDBName(); }
    *string getDBEncoding() { return real_ds.getDBEncoding(); }
    *string getOSEncoding() { return real_ds.getOSEncoding(); }
    *string getHostName() { return real_ds.getHostName(); }
    *int getPort() { return real_ds.getPort(); }
    string getDriverName() { return real_ds.getDriverName(); }
    auto getServerVersion() { return real_ds.getServerVersion(); }
    auto getClientVersion() { return real_ds.getClientVersion(); }
    bool inTransaction() { return real_ds.inTransaction(); }
    bool currentThreadInTransaction() { return real_ds.currentThreadInTransaction(); }
    hash<auto> getConfigHash() { return real_ds.getConfigHash(); }
    string getConfigString() { return real_ds.getConfigString(); }
    int getCapabilities() { return real_ds.getCapabilities(); }
}

class PgsqlInsertOnlyUpsertTest inherits QUnit::Test {
    private {
        int serial;
    }

    constructor() : Test("PgsqlInsertOnlyUpsert", "1.0", \ARGV) {
        addTestCase("atomic upsert servers skip an existing row with on conflict", \atomicStatementTest());
        addTestCase("atomic upsert servers report an inserted row", \atomicInsertTest());
        addTestCase("atomic upsert servers raise other insert errors", \atomicErrorTest());
        addTestCase("older servers isolate the insert in a savepoint without BEGIN", \savepointTest());
        addTestCase("older servers raise other insert errors after the savepoint", \savepointErrorTest());
        addTestCase("live: an existing row is skipped in an open transaction", \liveInsertOnlyTest());
        addTestCase("live: a key-only table upsert skips an existing row", \liveKeyOnlyTest());
        set_return_value(main());
    }

    globalTearDown() {
        # drops the run's schema with everything left in it
        PgsqlRunSchema::teardown();
    }

    private atomicStatementTest() {
        RecordingDatasource ds(170000);
        ds.insert_results = (0,);
        InsertProbeTable t(ds);
        ds.beginTransaction();
        assertFalse(t.tryInsert("insert into insert_probe (id) values ($1)", {"id": 1}),
            "an existing row is not inserted");
        assertEq(("<begin transaction>", "insert into insert_probe (id) values ($1) on conflict do nothing"),
            ds.statements, "one insert with a conflict clause; no BEGIN and no savepoint");
    }

    private atomicInsertTest() {
        RecordingDatasource ds(90500);
        ds.insert_results = (1,);
        InsertProbeTable t(ds);
        assertTrue(t.tryInsert("insert into insert_probe (id) values ($1)", {"id": 1}), "a new row is inserted");
        assertEq(("insert into insert_probe (id) values ($1) on conflict do nothing",), ds.statements,
            "the insert starts the datasource's transaction itself; no BEGIN is sent");
    }

    private atomicErrorTest() {
        RecordingDatasource ds(170000);
        ds.insert_results = (<ExceptionInfo>{"err": "DBI:PGSQL:ERROR", "desc": "value too long"},);
        InsertProbeTable t(ds);
        assertThrows("DBI:PGSQL:ERROR", "value too long", \t.tryInsert(), ("insert into insert_probe (id) values ($1)",
            {"id": 1}));
        assertEq(("insert into insert_probe (id) values ($1) on conflict do nothing",), ds.statements,
            "nothing is sent after the failed insert");
    }

    private savepointTest() {
        RecordingDatasource ds(90400);
        ds.insert_results = (DuplicateKeyError, 1);
        InsertProbeTable t(ds);
        ds.beginTransaction();
        assertFalse(t.tryInsert("insert into insert_probe (id) values ($1)", {"id": 1}),
            "a duplicate row is not inserted");
        assertTrue(t.tryInsert("insert into insert_probe (id) values ($1)", {"id": 2}), "a new row is inserted");
        string sp = PgsqlDatabase::PGSQL_TempSavepoint;
        assertEq((
            "<begin transaction>",
            "savepoint " + sp,
            "insert into insert_probe (id) values ($1)",
            "rollback to savepoint " + sp,
            "savepoint " + sp,
            "insert into insert_probe (id) values ($1)",
            "release savepoint " + sp,
        ), ds.statements, "each insert is isolated in a savepoint; no BEGIN is sent");
    }

    private savepointErrorTest() {
        RecordingDatasource ds(90400);
        ds.insert_results = (<ExceptionInfo>{"err": "DBI:PGSQL:ERROR", "desc": "value too long"},);
        InsertProbeTable t(ds);
        assertThrows("DBI:PGSQL:ERROR", "value too long", \t.tryInsert(), ("insert into insert_probe (id) values ($1)",
            {"id": 1}));
        assertEq(("savepoint " + PgsqlDatabase::PGSQL_TempSavepoint, "insert into insert_probe (id) values ($1)"),
            ds.statements, "the error is raised without rolling back to the savepoint");
    }

    private liveInsertOnlyTest() {
        Datasource ds = connection();
        AbstractTable t = createTable(ds, ("id", "value"));
        on_exit dropTable(ds, t);

        StatementRecorder rec(ds);
        AbstractTable rt = AbstractTable::getTable(rec, t.getName());
        on_exit ds.rollback();
        rt.insert({"id": 1, "value": 10});
        assertTrue(ds.currentThreadInTransaction(), "the transaction is open");
        rec.statements = ();
        assertEq(AbstractTable::UR_Unchanged, rt.upsert({"id": 1, "value": 20}, AbstractTable::UpsertInsertOnly),
            "an existing row is unchanged");
        assertEq(AbstractTable::UR_Inserted, rt.upsert({"id": 2, "value": 30}, AbstractTable::UpsertInsertOnly),
            "a new row is inserted");
        checkStatements(rec.statements);
        # the transaction was not aborted: it still reads and commits
        assertEq(((1, 10), (2, 30)), map ($1.id.toInt(), $1.value.toInt()),
            rt.selectRows({"orderby": "id"}), "both rows are in the open transaction");
        ds.commit();
        assertEq(2, rt.rowCount(), "both rows are committed");
    }

    private liveKeyOnlyTest() {
        Datasource ds = connection();
        AbstractTable t = createTable(ds, ("id",));
        on_exit dropTable(ds, t);

        StatementRecorder rec(ds);
        AbstractTable rt = AbstractTable::getTable(rec, t.getName());
        on_exit ds.rollback();
        rt.insert({"id": 1});
        rec.statements = ();
        foreach int strategy in ((AbstractTable::UpsertAuto, AbstractTable::UpsertInsertFirst,
                AbstractTable::UpsertUpdateFirst)) {
            assertEq(AbstractTable::UR_Unchanged, rt.upsert({"id": 1}, strategy),
                sprintf("an existing key-only row is unchanged with strategy %d", strategy));
        }
        assertEq(AbstractTable::UR_Inserted, rt.upsert({"id": 2}), "a new key-only row is inserted");
        checkStatements(rec.statements);
        ds.commit();
        assertEq(2, rt.rowCount(), "both rows are committed");
    }

    private checkStatements(list<string> statements) {
        foreach string sql in (statements) {
            assertFalse(sql =~ /^\s*begin\b/i, sprintf("BEGIN is never sent: %y", sql));
            assertFalse(sql =~ /savepoint/i, sprintf("no savepoint is needed: %y", sql));
            assertRegex("on conflict do nothing$", sql, "each insert skips an existing row on the server");
        }
        assertGt(0, statements.size(), "the inserts are recorded");
    }

    private Datasource connection() {
%ifdef NoPgsql
        testSkip("pgsql module unavailable");
%endif
        if (!ENV.QORE_DB_CONNSTR_PGSQL) {
            testSkip("set QORE_DB_CONNSTR_PGSQL to a disposable database");
        }
        PgsqlRunSchema::setup(ENV.QORE_DB_CONNSTR_PGSQL, "PgsqlInsertOnlyUpsert");
        Datasource ds(ENV.QORE_DB_CONNSTR_PGSQL);
        ds.open();
        if (ds.getServerVersion() < 90500) {
            testSkip("PostgreSQL 9.5+ is required for on conflict");
        }
        return ds;
    }

    private AbstractTable createTable(Datasource ds, list<string> cols) {
        string name = sprintf("insert_only_%d_%d", getpid(), ++serial);
        hash<auto> column = {"qore_type": "number", "size": 10, "notnull": True};
        hash<auto> desc = {
            "columns": (map {$1: column}, cols),
            "primary_key": {"name": name + "_pk", "columns": ("id",)},
        };
        AbstractTable t = (new Table(ds, desc, name)).getTable();
        t.createCommit();
        return t;
    }

    private dropTable(Datasource ds, AbstractTable t) {
        ds.rollback();
        t.dropCommit();
    }
}
