#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
#
# Copyright 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/DataProvider
%requires ../../../../qlib/SqlUtil
%requires ../../../../qlib/Sqlite3SqlUtil.qm
%requires ../../../../qlib/QUnit.qm

%try-module sqlite3
%define NoSqlite3
%endtry

%exec-class Sqlite3KeysTest

#! Primary keys, unique indexes, upsert and duplicate-row detection on an in-memory SQLite database
class Sqlite3KeysTest inherits QUnit::Test {
    private {
        *Datasource ds;
    }

    constructor() : Test("Sqlite3KeysTest", "1.0", \ARGV) {
        addTestCase("primary keys are described", \primaryKeys());
        addTestCase("primary key descriptions round trip", \primaryKeyDescriptions());
        addTestCase("invalid primary key descriptions are rejected", \invalidPrimaryKeyDescriptions());
        addTestCase("unsupported primary key DDL remains explicit", \unsupportedPrimaryKeyDdl());
        addTestCase("a table is created with its primary key", \createdPrimaryKeys());
        addTestCase("the primary key of an existing table is not added or dropped", \existingPrimaryKeyChanges());
        addTestCase("a table is created with its foreign constraints", \createdForeignConstraints());
        addTestCase("a foreign constraint of an existing table is not added or dropped",
            \existingForeignConstraintChanges());
        addTestCase("automatic indexes are described", \automaticIndexes());
        addTestCase("upsert uses the key", \upsert());
        addTestCase("a select that locks rows is refused", \forUpdateRefused());
        addTestCase("duplicate rows are recognized", \duplicateRows());
        set_return_value(main());
    }

    globalSetUp() {
%ifndef NoSqlite3
        ds = new Datasource("sqlite3:x@:memory:");
        ds.exec("create table single_pk (id integer not null primary key, status varchar(100))");
        ds.exec("create table composite_pk (a integer, b varchar(10), v varchar(10), primary key (b, a))");
        ds.exec("create table unique_col (id integer primary key, code varchar(10) unique, v varchar(10))");
        ds.exec("create table no_pk (x integer)");
        ds.exec("create table quoted (\"id\" integer, \"code\" varchar(10), \"name\" varchar(10))");
        ds.exec("create unique index \"quoted_code\" on \"quoted\" (\"code\")");
        ds.exec("create index quoted_name on quoted (name collate nocase)");
        ds.commit();
%endif
    }

    globalTearDown() {
        if (ds) {
            ds.rollback();
        }
    }

    private Datasource getDatasource() {
%ifdef NoSqlite3
        testSkip("no sqlite3 module");
%endif
        return ds;
    }

    primaryKeys() {
        Datasource ds = getDatasource();
        assertEq(("id",), (new Table(ds, "single_pk")).getPrimaryKey().keys());
        assertEq(("b", "a"), (new Table(ds, "composite_pk")).getPrimaryKey().keys(),
            "a composite key keeps its declared column order");
        assertEq((), (new Table(ds, "no_pk")).getPrimaryKey().keys(), "a table without a key has none");
    }

    automaticIndexes() {
        Datasource ds = getDatasource();
        # the composite key's own index is the primary key, not an extra index
        assertEq(0, (new Table(ds, "composite_pk")).getIndexes().size());
        list<auto> indexes = map $1, (new Table(ds, "unique_col")).getIndexes().iterator();
        assertEq(1, indexes.size(), "a unique constraint's index is described");
        assertTrue(indexes[0].unique);
        assertEq(("code",), indexes[0].columns.keys());

        # an index's columns are described without their quotes, and a lower-case unique index is unique
        hash<auto> quoted = map {$1.getName(): $1}, (new Table(ds, "quoted")).getIndexes().iterator();
        assertEq(("quoted_code", "quoted_name"), sort(keys quoted));
        assertEq(("code",), quoted.quoted_code.columns.keys());
        assertTrue(quoted.quoted_code.unique);
        assertFalse(quoted.quoted_name.unique);
        assertEq({"name": "nocase"}, quoted.quoted_name.collations, "a column collation is kept as declared");
    }

    primaryKeyDescriptions() {
        Datasource ds = getDatasource();
        foreach string name in (("single_pk", "composite_pk", "no_pk")) {
            Sqlite3Table current(ds, name);
            hash<auto> desc = current.getDescriptionHash();
            Sqlite3Table described(ds, name);
            described.setupTable(desc);
            assertEq(current.getPrimaryKey().keys(), described.getPrimaryKey().keys(),
                "constructing metadata preserves the ordered primary key");
            assertEq(desc.primary_key, described.getDescriptionHash().primary_key,
                "the primary key description round trips without executing DDL");
            assertEq((), current.getAlignSql(described), "an unchanged primary key requires no ALTER TABLE SQL");
        }
        Sqlite3Table absent(ds, "not_created");
        absent.setupTable({"columns": {"id": {"native_type": "integer"}}});
        assertTrue(absent.getPrimaryKey().empty(), "a new table with no key returns an empty key object");
        assertFalse(absent.inDb(), "reading manually defined key metadata does not introspect the database");
    }

    invalidPrimaryKeyDescriptions() {
        Datasource ds = getDatasource();
        hash<auto> desc = (new Table(ds, "single_pk")).getDescriptionHash();
        desc.primary_key.columns = ("missing",);
        Sqlite3Table missing(ds, "single_pk");
        assertThrows("PRIMARY-KEY-ERROR", \missing.setupTable(), (desc,),
            "metadata construction still validates primary key columns");
        desc.primary_key.columns = ();
        Sqlite3Table empty(ds, "single_pk");
        assertThrows("PRIMARY-KEY-ERROR", \empty.setupTable(), (desc,),
            "an empty primary key description is invalid");
        desc.primary_key.columns = (42,);
        Sqlite3Table invalid(ds, "single_pk");
        assertThrows("PRIMARY-KEY-ERROR", \invalid.setupTable(), (desc,),
            "primary key column names must be strings");
    }

    unsupportedPrimaryKeyDdl() {
        Datasource ds = getDatasource();
        Sqlite3Table no_pk(ds, "no_pk");
        assertThrows("UNSUPPORTED", \no_pk.getAddPrimaryKeySql(), ("PRIMARY", ("x",)),
            "requesting unsupported SQLite ALTER TABLE SQL still fails");
        assertThrows("UNSUPPORTED", \no_pk.addPrimaryKey(), ("PRIMARY", ("x",)),
            "adding a key to an existing SQLite table still fails");
        assertEq((), no_pk.getPrimaryKey().keys(), "failed DDL must not publish a primary key");
    }

    #! SQLite creates a primary key only with its table, so the key is in the table's CREATE TABLE statement
    createdPrimaryKeys() {
        Datasource ds = getDatasource();
        on_exit ds.rollback();

        # a key of one column
        Sqlite3Table single(ds, "created_single");
        single.setupTable({"columns": {"id": {"native_type": "integer", "notnull": True},
            "v": {"native_type": "text"}}, "primary_key": {"name": "pk_created_single", "columns": ("id",)}});
        assertEq("create table created_single (\n  id integer not null,\n  v text,\n  primary key (id)\n)",
            single.getCreateTableSql());
        assertEq((single.getCreateTableSql(),), single.getCreateSql(), "there is no separate primary key SQL");

        # a composite key in another order than its columns, with a reserved word
        Sqlite3Table composite(ds, "created_composite");
        composite.setupTable({"columns": {"a": {"native_type": "integer", "notnull": True},
            "group": {"native_type": "text", "notnull": True}, "v": {"native_type": "text"}},
            "primary_key": {"name": "pk_created_composite", "columns": ("group", "a")}});
        assertEq("create table created_composite (\n  a integer not null,\n  'group' text not null,\n  v text,\n"
            "  primary key ('group', a)\n)", composite.getCreateTableSql());

        # a table without a key
        Sqlite3Table none(ds, "created_none");
        none.setupTable({"columns": {"x": {"native_type": "integer"}}});
        assertEq("create table created_none (\n  x integer\n)", none.getCreateTableSql());

        foreach Sqlite3Table t in ((single, composite, none)) {
            t.create();
            # the table in the database has the key, so the template needs no change
            Sqlite3Table live(ds, t.getName());
            assertEq(t.getPrimaryKey().keys(), live.getPrimaryKey().keys(), t.getName());
            assertEq((), live.getAlignSql(t), t.getName());
        }

        # the keys are enforced
        Table live_composite(ds, "created_composite");
        live_composite.insert({"a": 1, "group": "x", "v": "1"});
        live_composite.insert({"a": 1, "group": "y", "v": "2"});
        try {
            live_composite.insert({"a": 1, "group": "x", "v": "3"});
            fail("a row with a duplicate key was inserted");
        } catch (hash<ExceptionInfo> ex) {
            assertTrue(live_composite.isDuplicateRowError(ex), get_exception_string(ex));
        }
        live_composite.upsert({"a": 1, "group": "x", "v": "4"});
        assertEq(("4", "2"), (map $1.v, live_composite.selectRows({"orderby": "group"})));

        # an integer key column of one column is the rowid, so a row inserted without it is given one
        Sqlite3Table auto(ds, "created_auto");
        auto.setupTable({"columns": {"id": {"native_type": "integer"}, "v": {"native_type": "text"}},
            "primary_key": {"name": "pk_created_auto", "columns": ("id",)}});
        auto.create();
        Table live_auto(ds, "created_auto");
        live_auto.insert({"v": "a"});
        live_auto.insert({"v": "b"});
        assertEq(({"id": 1, "v": "a"}, {"id": 2, "v": "b"}), live_auto.selectRows({"orderby": "id"}));
    }

    #! SQLite cannot add a primary key to an existing table, or drop its key: the alignment says so
    existingPrimaryKeyChanges() {
        Datasource ds = getDatasource();
        on_exit ds.rollback();

        # adding a key to a table without one; the template's column is the table's column, so the key is the only
        # difference: a NOT NULL change would be refused before the key on SQLite before 3.53.0, which cannot change a
        # column of an existing table
        Sqlite3Table with_key(ds, "no_pk");
        with_key.setupTable({"columns": {"x": {"native_type": "integer"}},
            "primary_key": {"name": "pk_no_pk", "columns": ("x",)}});
        Sqlite3Table no_pk(ds, "no_pk");
        assertEq(no_pk.describe().x.nullable, with_key.describe().x.nullable,
            "the template's column has the table's NOT NULL constraint");
        assertThrows("UNSUPPORTED", "cannot add the primary key \\(x\\) to table \"no_pk\": SQLite cannot add a "
            "primary key to an existing table", \no_pk.getAlignSql(), (with_key,));

        # dropping the key of a table: the same table without its key
        Sqlite3Table single_pk(ds, "single_pk");
        hash<auto> desc = single_pk.getDescriptionHash();
        remove desc.primary_key;
        Sqlite3Table without_key(ds, "single_pk");
        without_key.setupTable(desc);
        assertThrows("UNSUPPORTED", "cannot drop the primary key \\(id\\) of table \"single_pk\": SQLite cannot drop "
            "the primary key of an existing table", \single_pk.getAlignSql(), (without_key,));

        # a key in SQLite has no name, so there is nothing to rename
        Sqlite3PrimaryKey pk = cast<Sqlite3PrimaryKey>(single_pk.getPrimaryKey());
        assertFalse(pk.supportsName());
        assertEq((), pk.getRenameSql("single_pk", "pk_other"));
    }

    #! Returns a template for the table "fk_line", whose foreign constraints reference "fk_order" and "fk_item"
    private Sqlite3Table lineTemplate(Datasource ds, *hash<auto> foreign_constraints) {
        Sqlite3Table line(ds, "fk_line");
        line.setupTable({
            "columns": {
                "id": {"native_type": "integer", "notnull": True},
                "order_id": {"native_type": "integer"},
                "item_group": {"native_type": "text"},
                "item_id": {"native_type": "integer"},
            },
            "primary_key": {"name": "pk_fk_line", "columns": ("id",)},
            "foreign_constraints": foreign_constraints ?? {
                "fk_line_order": {"columns": ("order_id",), "table": "fk_order", "target_columns": ("id",)},
                # a composite key in another order than the referenced table's columns, with a reserved word
                "fk_line_item": {"columns": ("item_group", "item_id"), "table": "fk_item",
                    "target_columns": ("group", "id")},
            },
        });
        return line;
    }

    #! Creates the tables referenced by "fk_line"
    private createReferencedTables(Datasource ds) {
        Sqlite3Table order(ds, "fk_order");
        order.setupTable({"columns": {"id": {"native_type": "integer", "notnull": True}},
            "primary_key": {"name": "pk_fk_order", "columns": ("id",)}});
        order.create();
        Sqlite3Table item(ds, "fk_item");
        item.setupTable({"columns": {"id": {"native_type": "integer", "notnull": True},
            "group": {"native_type": "text", "notnull": True}},
            "primary_key": {"name": "pk_fk_item", "columns": ("group", "id")}});
        item.create();
    }

    #! SQLite creates a foreign constraint only with its table, so it is in the table's CREATE TABLE statement
    createdForeignConstraints() {
        Datasource ds = getDatasource();
        on_exit ds.rollback();
        createReferencedTables(ds);

        Sqlite3Table line = lineTemplate(ds);
        assertEq("create table fk_line (\n  id integer not null,\n  order_id integer,\n  item_group text,\n"
            "  item_id integer,\n  primary key (id),\n"
            "  constraint fk_line_order foreign key (order_id) references fk_order (id),\n"
            "  constraint fk_line_item foreign key (item_group, item_id) references fk_item ('group', id)\n)",
            line.getCreateTableSql());
        assertEq((line.getCreateTableSql(),), line.getCreateSql(), "there is no separate foreign constraint SQL");
        hash<auto> omit_opt = {};
        omit_opt.omit = "foreign_constraints";
        assertEq(("create table fk_line (\n  id integer not null,\n  order_id integer,\n  item_group text,\n"
            "  item_id integer,\n  primary key (id)\n)",), line.getCreateSql(omit_opt),
            "the foreign constraints can be omitted");
        line.create();

        # SQLite does not report the names, so the described constraints are numbered; their definitions are kept
        Sqlite3Table live(ds, "fk_line");
        hash<auto> desc = live.getDescriptionHash().foreign_constraints;
        assertEq(2, desc.size());
        assertEq(({"table": "fk_item", "columns": ("item_group", "item_id"), "target_columns": ("group", "id")},
            {"table": "fk_order", "columns": ("order_id",), "target_columns": ("id",)}),
            sort(desc.values(), int sub (hash<auto> l, hash<auto> r) { return l.table <=> r.table; }));
        foreach string fk_name in (keys desc) {
            assertRegex("^sqlite_fk_[0-9]+$", fk_name);
        }
        # an unchanged foreign constraint needs no SQL, whatever its name in the template
        assertEq((), live.getAlignSql(line));

        # a foreign constraint that references the primary key of a table without naming its columns
        ds.exec("create table fk_implicit (id integer primary key, item_group text, item_id integer, "
            "foreign key (item_group, item_id) references fk_item)");
        Sqlite3Table implicit(ds, "fk_implicit");
        hash<auto> implicit_desc = implicit.getDescriptionHash().foreign_constraints;
        assertEq(({"table": "fk_item", "columns": ("item_group", "item_id"), "target_columns": ("group", "id")},),
            implicit_desc.values());
    }

    #! SQLite cannot add a foreign constraint to an existing table, or drop one: the alignment says so
    existingForeignConstraintChanges() {
        Datasource ds = getDatasource();
        on_exit ds.rollback();
        createReferencedTables(ds);
        lineTemplate(ds, {"fk_line_order": {"columns": ("order_id",), "table": "fk_order",
            "target_columns": ("id",)}}).create();
        Sqlite3Table live(ds, "fk_line");

        # adding a foreign constraint
        assertThrows("UNSUPPORTED", "cannot add the foreign constraint \"fk_line_item\" \\(item_group, item_id\\) "
            "referencing fk_item \\(group, id\\) to table \"fk_line\": SQLite cannot add a foreign constraint to an "
            "existing table", \live.getAlignSql(), (lineTemplate(ds),));

        # dropping it
        Sqlite3Table live_again(ds, "fk_line");
        assertThrows("UNSUPPORTED", "cannot drop the foreign constraint \\(order_id\\) referencing fk_order \\(id\\) "
            "of table \"fk_line\": SQLite cannot drop a foreign constraint of an existing table",
            \live_again.getAlignSql(), (lineTemplate(ds, {}),));

        # changing it is dropping it and adding another
        Sqlite3Table live_changed(ds, "fk_line");
        assertThrows("UNSUPPORTED", "cannot drop the foreign constraint \\(order_id\\) referencing fk_order",
            \live_changed.getAlignSql(), (lineTemplate(ds, {"fk_line_order": {"columns": ("item_id",),
                "table": "fk_order", "target_columns": ("id",)}}),));

        # SQLite does not keep the name of a foreign constraint, so there is nothing to rename
        Sqlite3Table live_rename(ds, "fk_line");
        list<AbstractForeignConstraint> fks = map $1, live_rename.getForeignConstraints().iterator();
        assertEq(1, fks.size());
        AbstractForeignConstraint fk = fks[0];
        assertEq((), fk.getRenameSql("fk_line", "fk_other"));
    }

    forUpdateRefused() {
        Datasource ds = getDatasource();
        on_exit ds.rollback();
        Table single(ds, "single_pk");
        # SQLite cannot lock rows, so a select asking for the lock must fail rather than run without it
        assertThrows("FORUPDATE-NOT-SUPPORTED", sub () { single.selectRows({"forupdate": True}); });
        assertFalse(ds.currentThreadInTransaction(), "the refused select leaves no transaction open");
        assertEq((), single.selectRows() ?? (), "a select without the option still runs");
    }

    upsert() {
        Datasource ds = getDatasource();
        on_exit ds.rollback();
        Table single(ds, "single_pk");
        single.insert({"id": 1, "status": "A"});
        single.upsert({"id": 1, "status": "B"});
        single.upsert({"id": 2, "status": "C"});
        assertEq(({"id": 1, "status": "B"}, {"id": 2, "status": "C"}), single.selectRows({"orderby": "id"}));

        Table composite(ds, "composite_pk");
        composite.upsert({"a": 1, "b": "x", "v": "1"});
        composite.upsert({"a": 1, "b": "x", "v": "2"});
        assertEq(({"a": 1, "b": "x", "v": "2"},), composite.selectRows());
    }

    duplicateRows() {
        Datasource ds = getDatasource();
        Table single(ds, "single_pk");
        # a driver that reports SQLite's result codes
        assertTrue(single.isDuplicateRowError(<ExceptionInfo>{"err": "SQLITE3-EXEC", "desc": "",
            "arg": {"code": 19, "extended_code": SQLITE_CONSTRAINT_PRIMARYKEY}}));
        assertTrue(single.isDuplicateRowError(<ExceptionInfo>{"err": "SQLITE3-EXEC", "desc": "",
            "arg": {"code": 19, "extended_code": SQLITE_CONSTRAINT_UNIQUE}}));
        assertFalse(single.isDuplicateRowError(<ExceptionInfo>{"err": "SQLITE3-EXEC",
            "desc": "sqlite3 error: NOT NULL constraint failed: single_pk.id",
            "arg": {"code": 19, "extended_code": 1299}}), "another constraint is not a duplicate row");
        # an older driver that reports only SQLite's message
        assertTrue(single.isDuplicateRowError(<ExceptionInfo>{"err": "SQLITE3-EXEC",
            "desc": "sqlite3 error: UNIQUE constraint failed: single_pk.id"}));
        assertFalse(single.isDuplicateRowError(<ExceptionInfo>{"err": "SQLITE3-EXEC",
            "desc": "Duplicate entry '1' for key 'PRIMARY'"}), "another database's message is not SQLite's");

        # and the driver installed here raises an error that is recognized
        on_exit ds.rollback();
        single.insert({"id": 7, "status": "A"});
        try {
            single.insert({"id": 7, "status": "B"});
            fail("a duplicate insert succeeded");
        } catch (hash<ExceptionInfo> ex) {
            assertTrue(single.isDuplicateRowError(ex), get_exception_string(ex));
        }
    }
}
