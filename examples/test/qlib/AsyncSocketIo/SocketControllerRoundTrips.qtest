%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/Mime.qm
%requires ../../../../qlib/HttpServerUtil.qm
%requires ../../../../qlib/HttpServer.qm

%exec-class SocketControllerRoundTripsTest

#! Counts the async I/O controller submissions of synchronous Socket calls by method name
/** A synchronous Socket call that must run on the socket's I/O thread submits an operation keyed
    "QoreSocketObject::sync:<method>:..."; the controller logs every submission at DEBUG level in the calling thread
    before it returns, so the count is exact when the call returns.
*/
class SubmitCountingAppender inherits LoggerAppenderWithLayout {
    private {
        Mutex mtx();
        hash<string, int> counts = {};
    }

    constructor() : LoggerAppenderWithLayout("round-trips", new LoggerLayoutPattern("%m")) {
        open();
    }

    public processEventImpl(int type, auto params) {
        if (type != LoggerAppender::EVENT_LOG) {
            return;
        }
        *list<*string> m = (params.toString() =~ x/^submit: operation 'QoreSocketObject::sync:([A-Za-z0-9]+):/);
        if (m) {
            AutoLock al(mtx);
            ++counts{m[0]};
        }
    }

    #! Returns the number of submissions by method
    hash<string, int> getAll() {
        AutoLock al(mtx);
        return counts;
    }

    #! Returns the number of submissions of the given methods
    int get(softlist<string> methods) {
        AutoLock al(mtx);
        return foldl $1 + $2, (map counts{$1} ?? 0, methods);
    }
}

#! Keeps the HTTP server's request log lines
class RequestLogAppender inherits LoggerAppenderWithLayout {
    private {
        Mutex mtx();
        list<string> lines = ();
    }

    constructor() : LoggerAppenderWithLayout("request-log", new LoggerLayoutPattern("%m")) {
        open();
    }

    public processEventImpl(int type, auto params) {
        if (type != LoggerAppender::EVENT_LOG) {
            return;
        }
        string msg = params.toString();
        # the request line, not the body line logged with it
        if (msg =~ /cid [0-9]+ src .* \(agent: /) {
            AutoLock al(mtx);
            push lines, msg;
        }
    }

    list<string> get(string path) {
        AutoLock al(mtx);
        return select lines, $1.find(" " + path + " ") != -1;
    }
}

#! Echoes the request body
class EchoHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, body ?? "none", {"Content-Type": "application/octet-stream"});
    }
}

