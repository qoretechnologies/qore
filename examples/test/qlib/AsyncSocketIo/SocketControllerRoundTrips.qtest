        const CipherMethods = ("getSSLCipherName", "getSSLCipherVersion");
        const LimitMethods = ("setMaxChunkedBodySize", "setHttp2MaxRequestBodySize");

        #! Requests sent on one HTTP/2 connection
        const Requests = 10;
    }

    private {
        SubmitCountingAppender counter();
        Logger counter_logger("round-trips", LoggerLevel::getLevelDebug());
    }

    constructor() : Test("SocketControllerRoundTripsTest", "1.0") {
        addTestCase("the TLS cipher is read once per TLS state", \cipherCacheTest());
        addTestCase("setting a body size limit to its value needs no round trip", \limitSetterTest());
        addTestCase("an HTTP/2 request needs no round trip for the cipher and limits", \http2RequestTest());
        addTestCase("a changed body size limit applies to the next request", \limitChangeTest());
        set_return_value(main());
    }

    globalSetUp() {
        counter_logger.addAppender(counter);
        AsyncIoController::setLogger(counter_logger);
    }

    globalTearDown() {
        AsyncIoController::setLogger(NOTHING);
    }

    #! Returns a connected plain socket pair: (client, server)
    private list<Socket> getSocketPair() {
        Socket listener();
        listener.bind("127.0.0.1:0");
        listener.listen();
        int port = listener.getSocketInfo().port;
        Queue q();
        background sub () {
            try {
                q.push(listener.accept(10s));
            } catch (hash<ExceptionInfo> ex) {
                q.push(ex);
            }
        }();
        Socket client();
        client.connect("127.0.0.1:" + port, 10s);
        auto server = q.get(10s);
        if (server.typeCode() == NT_HASH) {
            throw server.err, server.desc;
        }
        return (client, server);
    }

    #! Upgrades both ends of a plain connection to TLS
    private upgradeToTls(Socket client, Socket server) {
        server.setCertificate(new SSLCertificate(CertPem));
        server.setPrivateKey(new SSLPrivateKey(KeyPem));
        Queue q();
        background sub () {
            try {
                server.upgradeServerToSSL(10s);
                q.push(True);
            } catch (hash<ExceptionInfo> ex) {
                q.push(ex);
            }
        }();
        client.upgradeClientToSSL(10s);
        auto rv = q.get(10s);
        if (rv.typeCode() == NT_HASH) {
            throw rv.err, rv.desc;
        }
    }

    #! The cipher name and version are read from the socket's I/O thread once for each TLS state of the socket
    /** They were read with a round trip to the socket's I/O thread on every call; they can only change when the
        socket's TLS connection is created, renegotiated or released.
    */
    cipherCacheTest() {
        list<Socket> pair = getSocketPair();
        Socket client = pair[0];
        Socket server = pair[1];
        on_exit {
            client.close();
            server.close();
        }

        # a plain connection has no cipher
        int start = counter.get(CipherMethods);
        assertNothing(client.getSSLCipherName());
        assertNothing(client.getSSLCipherVersion());
        assertNothing(client.getSSLCipherName());
        assertEq(1, counter.get(CipherMethods) - start, "the plain connection's state is read once");

        # the TLS connection is reported; the cached plain state is not
        upgradeToTls(client, server);
        start = counter.get(CipherMethods);
        *string name = client.getSSLCipherName();
        *string version = client.getSSLCipherVersion();
        assertEq(Type::String, name.type(), "the TLS cipher name is reported after the upgrade");
        assertEq(Type::String, version.type(), "the TLS cipher version is reported after the upgrade");
        assertEq(server.getSSLCipherName(), name, "both ends report the same cipher");
        assertEq(server.getSSLCipherVersion(), version, "both ends report the same version");
        for (int i = 0; i < 10; ++i) {
            assertEq(name, client.getSSLCipherName());
            assertEq(version, client.getSSLCipherVersion());
        }
        assertEq(1, counter.get(CipherMethods) - start - 1,
            "the client's TLS state is read once for 22 calls (the server's once more)");

        # the connection still works, and the cipher is still the same
        client.send("ping");
        assertEq("ping", server.recv(4, 10s));
        assertEq(name, client.getSSLCipherName());

        # a closed socket has no cipher
        client.close();
        assertNothing(client.getSSLCipherName(), "a closed socket has no cipher name");
        assertNothing(client.getSSLCipherVersion(), "a closed socket has no cipher version");
    }

    #! Setting a body size limit to its current value changes nothing and needs no round trip
    limitSetterTest() {
        list<Socket> pair = getSocketPair();
        Socket client = pair[0];
        on_exit {
            client.close();
            pair[1].close();
        }

        int start = counter.get(LimitMethods);
        client.setMaxChunkedBodySize(1000);
        client.setHttp2MaxRequestBodySize(1000);
        assertEq(2, counter.get(LimitMethods) - start, "a new value is set on the socket's thread");
        assertEq(1000, client.getMaxChunkedBodySize());
        assertEq(1000, client.getHttp2MaxRequestBodySize());

        start = counter.get(LimitMethods);
        for (int i = 0; i < 10; ++i) {
            client.setMaxChunkedBodySize(1000);
            client.setHttp2MaxRequestBodySize(1000);
        }
        assertEq(0, counter.get(LimitMethods) - start, "setting the current value needs no round trip");
        assertEq(1000, client.getMaxChunkedBodySize());
        assertEq(1000, client.getHttp2MaxRequestBodySize());

        start = counter.get(LimitMethods);
        client.setMaxChunkedBodySize(2000);
        client.setHttp2MaxRequestBodySize(0);
        assertEq(2, counter.get(LimitMethods) - start, "a changed value is set on the socket's thread");
        assertEq(2000, client.getMaxChunkedBodySize());
        assertEq(0, client.getHttp2MaxRequestBodySize());
    }

    #! An HTTPS server sets the limits and logs the cipher of every HTTP/2 request without per-request round trips
    /** The server set both body size limits and read the cipher name and version with a round trip to the
        connection's I/O thread for every request.
    */
    http2RequestTest() {
        Logger logger("round-trips-server", LoggerLevel::getLevelInfo());
        RequestLogAppender request_log();
        logger.addAppender(request_log);
        HttpServer srv(<HttpServerOptionInfo>{
            "logger": logger,
            "max_request_body_size": 4096,
        });
        on_exit delete srv;
        srv.setDefaultHandler("echo", new EchoHandler());
        int port = srv.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        }).port;
        srv.waitForAsyncIo();
        # the server sets its own logger on the controller
        AsyncIoController::setLogger(counter_logger);

        HTTPClient client({
            "url": "https://localhost:" + port,
            "ssl_verify_cert": False,
            "http_version": "2.0",
            "timeout": 10s,
        });
        client.connect();
        on_exit client.disconnect();

        int cipher_start = counter.get(CipherMethods);
        int limit_start = counter.get(LimitMethods);
        for (int i = 0; i < Requests; ++i) {
            hash<auto> resp = client.send(binary("body-" + i), "POST", "/round-trip");
            assertEq(200, resp.status_code);
            assertEq(binary("body-" + i), resp.body);
            assertTrue(client.isHttp2Active(), "the request is sent with HTTP/2");
        }
        # the server reads the cipher once for the connection, and the limits it sets for each request are the ones
        # it set when it accepted the connection
        assertLe(1, counter.get(CipherMethods) - cipher_start, "the cipher is read at most once per connection");
        assertEq(0, counter.get(LimitMethods) - limit_start, "the limits are not set again for each request");

        # every request is logged with the connection's cipher
        list<string> lines = request_log.get("/round-trip");
        assertEq(Requests, lines.size(), "every request is logged");
        # the line ends with the cipher name and version, then any connection kind in brackets
        *list<*string> suffix = (lines[0] =~ x/ ([A-Za-z0-9_-]+) (TLSv[0-9.]+)(?: \[[a-z0-9-]+\])?\)$/);
        assertEq(2, suffix.size(), "the request log line has the cipher name and version: " + lines[0]);
        foreach string line in (lines) {
            assertNeq(-1, line.find(sprintf(" %s %s", suffix[0], suffix[1])), "the request is logged with the cipher");
        }
    }

    #! A body size limit changed between two requests on one connection applies to the second request
    limitChangeTest() {
        HttpServer srv(<HttpServerOptionInfo>{
            "logger": new Logger("round-trips-limits", LoggerLevel::getLevelInfo()),
            "max_request_body_size": 4096,
        });
        on_exit delete srv;
        srv.setDefaultHandler("echo", new EchoHandler());
        int port = srv.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        srv.waitForAsyncIo();

        Socket s();
        s.connect("127.0.0.1:" + port, 10s);
        on_exit s.close();

        string body = strmul("C", 2000);
        assertEq(200, sendChunked(s, port, body).status_code, "a chunked body under the limit is accepted");

        # the same connection: the next request is checked against the new limit
        srv.setMaxRequestBodySize(1024);
        assertGe(400, sendChunked(s, port, body).status_code, "a chunked body over the new limit is rejected");
    }

    #! Sends a chunked POST request and returns the response header
    private hash<auto> sendChunked(Socket s, int port, string body) {
        s.sendHTTPMessage("POST", "/limit", "1.1", {
            "Host": "localhost:" + port,
            "Transfer-Encoding": "chunked",
            "Content-Type": "application/octet-stream",
        });
        s.send(sprintf("%x\r\n%s\r\n0\r\n\r\n", body.size(), body));
        hash<auto> hdr = s.readHTTPHeader(10s);
        if (hdr."content-length") {
            s.recv(hdr."content-length".toInt(), 10s);
        }
        return hdr;
    }
}
