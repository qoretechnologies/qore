#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/AsyncSocketIo

%exec-class TimerDispatchTest

public class TimerDispatchTest inherits QUnit::Test {
    constructor() : Test("TimerDispatchTest", "1.0") {
        addTestCase("closure udata fires off I/O thread", \closureFiresOffIoThread());
        addTestCase("funcref udata fires off I/O thread", \funcrefFiresOffIoThread());
        addTestCase("owner-tagged timer callback is drainable", \ownerTaggedTimerDrained());
        addTestCase("self-draining destructor on worker does not deadlock",
            \selfDrainingDestructorOnWorkerNoDeadlock());
        addTestCase("cancelTimer stops a not-yet-fired timer", \cancelTimerStopsTimer());
        set_return_value(main());
    }

    # Regression for the WebSocketPerfTest CI hang (self-deadlock in the
    # AsyncIoController callback dispatcher): a destructor that drains its OWN
    # owner via flushCallbacksByOwner() must not deadlock when it runs on the
    # dispatcher worker that is executing one of that owner's callbacks.
    #
    # In the field this was WebSocketClient::destructor, reached from the
    # on_poll_complete callback when that callback released the client's last
    # reference: it called flushCallbacksByOwner(async_owner) →
    # waitForOwnerIdle(), which blocked until active_per_owner[async_owner]
    # reached zero — but the worker's OWN in-flight callback kept the count at
    # 1, so the worker waited for itself, wedging the dispatcher and hanging
    # process exit.  The fix makes waitForOwnerIdle() exclude the calling
    # worker's own item (see current_callback_owner in AsyncIoControllerPriv.cpp).
    selfDrainingDestructorOnWorkerNoDeadlock() {
        AsyncSocketIoController ctrl();
        on_exit delete ctrl;

        string owner = "selfdrain-" + get_random_string(8);
        Counter started(1);
        Counter destructed(1);

        SelfDrainingOwner obj(owner, destructed);

        # Owner-tagged timer whose callback deletes obj from WITHIN the
        # dispatched callback, running obj's destructor on the very worker that
        # is executing this owner's callback — so active_per_owner[owner] >= 1
        # while the destructor calls flushCallbacksByOwner(owner).
        ctrl.addTimer(now_us() + 10ms, sub () {
            started.dec();
            delete obj;
        }, owner);

        assertEq(0, started.waitForZero(10s),
            "owner-tagged timer callback did not start within 10s");
        # If the dispatcher self-deadlocks, destructed never reaches zero and
        # this times out — a deterministic failure rather than an infinite hang.
        assertEq(0, destructed.waitForZero(30s),
            "self-draining destructor deadlocked the dispatcher worker: "
            "flushCallbacksByOwner() waited for its own in-flight callback");
    }

    # An owner-tagged timer's fired-but-still-running callback must be drainable
    # via flushCallbacksByOwner(): the call must BLOCK until the in-flight callback
    # completes.  This is the mechanism the DiscordWebSocketClient destructor relies
    # on to guarantee no watchdog callback touches destroyed members.  Without owner
    # tagging, flushCallbacksByOwner() cannot see the callback and returns immediately.
    ownerTaggedTimerDrained() {
        AsyncSocketIoController ctrl();
        on_exit delete ctrl;

        string owner = "test-owner-" + get_random_string(8);
        Counter started(1);
        bool callback_done = False;
        # callback marks itself started, sleeps long enough to stay in flight while
        # the test calls flush, then records completion
        ctrl.addTimer(now_us() + 10ms, sub () {
            started.dec();
            usleep(1s);
            callback_done = True;
        }, owner);

        # wait until the callback is actually running (fired + dispatched to a worker)
        assertEq(0, started.waitForZero(10s), "owner-tagged timer callback did not start within 10s");

        # flush must block for the remainder of the callback's 1s sleep
        date t0 = now_us();
        ctrl.flushCallbacksByOwner(owner);
        date elapsed = now_us() - t0;

        assertTrue(callback_done, "flushCallbacksByOwner() must wait for the in-flight callback to finish");
        # the callback was ~10ms+dispatch into its 1s sleep when flush was called, so
        # flush must have blocked for a substantial fraction of a second; a generous
        # lower bound avoids flakiness while still proving flush actually waited
        assertGe(500ms, elapsed, "flushCallbacksByOwner() returned too fast to have waited for the callback");
    }

    # cancelTimer() on a not-yet-fired timer returns True and the callback never runs
    cancelTimerStopsTimer() {
        AsyncSocketIoController ctrl();
        on_exit delete ctrl;

        bool fired = False;
        int id = ctrl.addTimer(now_us() + 30s, sub () {
            fired = True;
        });
        assertGt(0, id, "addTimer must return a positive timer id");
        assertTrue(ctrl.cancelTimer(id), "cancelTimer must return True for a live, not-yet-fired timer");
        # a second cancel of the same id must report not-found
        assertFalse(ctrl.cancelTimer(id), "second cancelTimer of the same id must return False");
        # give any (erroneously) dispatched callback a chance to run, then confirm it did not
        usleep(200ms);
        assertFalse(fired, "a cancelled timer's callback must never fire");
    }

    # Encodes the contract documented on AsyncIoController::addTimer():
    # a closure udata is auto-dispatched to a worker thread — callers may
    # block / acquire locks / do Qore I/O without blocking the async I/O loop.
    closureFiresOffIoThread() {
        AsyncSocketIoController ctrl();
        on_exit delete ctrl;

        int caller_tid = gettid();
        Counter cnt(1);
        int fire_tid = 0;
        ctrl.addTimer(now_us() + 50ms, sub () {
            fire_tid = gettid();
            cnt.dec();
        });
        assertEq(0, cnt.waitForZero(10s), "timer closure did not fire within 10s");
        assertNeq(0, fire_tid, "closure did not record its tid");
        assertNeq(caller_tid, fire_tid, "closure must run on a dispatcher worker, not the caller");
    }

    funcrefFiresOffIoThread() {
        AsyncSocketIoController ctrl();
        on_exit delete ctrl;

        int caller_tid = gettid();
        Counter cnt(1);
        int fire_tid = 0;
        code<nothing()> cb = sub () {
            fire_tid = gettid();
            cnt.dec();
        };
        ctrl.addTimer(now_us() + 50ms, cb);
        assertEq(0, cnt.waitForZero(10s), "timer funcref did not fire within 10s");
        assertNeq(caller_tid, fire_tid, "funcref must run on a dispatcher worker, not the caller");
    }
}

#! An object whose destructor drains its OWN async-I/O owner.
/** Models WebSocketClient::destructor, which calls
    flushCallbacksByOwner(async_owner) and can itself run on the dispatcher
    worker that is executing one of that owner's callbacks (when the callback
    drops the object's last reference).
*/
class SelfDrainingOwner {
    private {
        string owner;
        Counter destructed;
    }

    constructor(string n_owner, Counter n_destructed) {
        owner = n_owner;
        destructed = n_destructed;
    }

    destructor() {
        # Drain our own owner.  When this destructor runs on the dispatcher
        # worker that is executing this owner's callback, that worker's own
        # in-flight item keeps active_per_owner[owner] >= 1; waitForOwnerIdle()
        # must exclude it rather than wait for itself.
        AsyncSocketIoController controller = getGlobalAsyncIoController();
        controller.flushCallbacksByOwner(owner);
        destructed.dec();
    }
}
