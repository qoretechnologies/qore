%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Logger
%requires DataProvider
%requires ConnectionProvider
%requires RestClient
%requires Mime

%try-module json
%define NoJson
%endtry

%requires SendCloudRestClient
%requires SendCloudDataProvider

%exec-class SendCloudDataProviderTest

public class SendCloudDataProviderTest inherits QUnit::Test {
    private {
        #! Logger for verbose output
        Logger logger;

        #! Custom command-line options
        const MyOpts = Opts + {
            "conn": "c,connection=s",
        };

        #! Connection name (if provided) — enables live integration tests
        *string conn_name;

        #! Live data provider (set only when -c is given and connection resolves)
        *DataProvider::AbstractDataProvider root;

        #! Tracks a test parcel created during integration tests for cleanup
        *int testParcelId;

        #! Shipping method used by tests; 8 = "Unstamped letter" (no carrier charges)
        const TestShippingMethodId = 8;

        #! Column width for --help option descriptions
        const OptionColumn = 22;
    }

    constructor() : Test("SendCloudDataProvider Test", "1.0", \ARGV, MyOpts) {
        logger = new Logger("test", LoggerLevel::getLevelInfo());
        conn_name = m_options.conn;

        # Unit tests (always run — no credentials required)
        addTestCase("scheme registered", \testSchemeRegistered());
        addTestCase("factory registered", \testFactoryRegistered());
        addTestCase("data type instantiation", \testDataTypeInstantiation());
        addTestCase("app registered", \testAppRegistered());
        addTestCase("actions registered", \testActionsRegistered());
        addTestCase("event example data", \testEventExampleData());
        addTestCase("create-parcel required fields", \testCreateParcelRequiredFields());
        addTestCase("create-return v3 request type", \testCreateReturnV3RequestType());
        addTestCase("credential propagation", \testCredentialPropagation());

        # Integration tests (require -c <connection>)
        addTestCase("integration: ping", \testPing());
        addTestCase("integration: get-user", \testGetUser());
        addTestCase("integration: list-shipping-methods", \testListShippingMethods());
        addTestCase("integration: list-sender-addresses", \testListSenderAddresses());
        addTestCase("integration: parcel round-trip (v3)", \testParcelRoundTrip());
        addTestCase("integration: create-parcel minimal fields", \testCreateParcelMinimalFields());
        addTestCase("integration: return round-trip (v3)", \testReturnRoundTrip());
        addTestCase("integration: service point search", \testServicePointSearch());

        set_return_value(main());
    }

    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-c,--connection=ARG", "set the connection name for live integration tests", OptionColumn);
    }

    #! Check if json module is available
    private checkJson() {
%ifdef NoJson
        testSkip("no json module present");
%endif
    }

    #! Skip if no connection provided; otherwise lazily resolve live root provider
    private *DataProvider::AbstractDataProvider requireConnection() {
        if (!conn_name) {
            testSkip("no connection specified (use -c <name>)");
        }
        if (!root) {
            try {
                object conn = call_function("get_connection", conn_name);
                root = conn.getDataProvider();
            } catch (hash<ExceptionInfo> ex) {
                testSkip(sprintf("connection %y unavailable: %s: %s", conn_name, ex.err, ex.desc));
            }
        }
        return root;
    }

    #! Executes an advertised SendCloud action through the real child data provider API
    private auto runAction(DataProvider::AbstractDataProvider provider, string action, hash<auto> req) {
        DataProvider::AbstractDataProvider action_provider = provider.getChildProviderEx(action);
        return action_provider.doRequest(req);
    }

    #! Returns True if the given exception corresponds to an HTTP status code indicating a
    #! missing scope or unsupported endpoint (so the test can be skipped gracefully).
    private bool isScopeOr404(hash<ExceptionInfo> ex) {
        *int code = ex.arg.status_code;
        return code == 401 || code == 403 || code == 404;
    }

    ########################################################################
    # Unit tests
    ########################################################################

    #! Verify the sendcloudrest connection scheme is registered with expected options
    testSchemeRegistered() {
        checkJson();
        *hash<ConnectionSchemeInfo> scheme = ConnectionSchemeCache::getScheme("sendcloudrest");
        assertTrue(exists scheme, "sendcloudrest scheme should be registered");
        assertEq("SendCloudRestConnection", scheme.cls.getName());

        # Expected connection options
        assertTrue(scheme.options.hasKey("public_key"), "scheme should have 'public_key' option");
        assertTrue(scheme.options.hasKey("secret_key"), "scheme should have 'secret_key' option");
    }

    #! Verify the sendcloud data provider factory is registered
    testFactoryRegistered() {
        checkJson();
        AbstractDataProviderFactory factory = DataProvider::getFactoryEx("sendcloud");
        assertEq("sendcloud", factory.getName());
        hash<DataProviderFactoryInfo> finfo = factory.getInfo();
        assertEq("sendcloud", finfo.name);
        assertTrue(finfo.children_can_support_apis, "children_can_support_apis should be True");
    }

    #! Instantiate exported DataType classes and assert Fields are populated.
    #! Do NOT call getRecordType() on collection providers — gated by has_record.
    testDataTypeInstantiation() {
        checkJson();

        # Core request/response types that must exist for the data provider to function.
        # Missing symbols will produce parse-time errors — this verifies both existence and structure.
        list<string> type_class_names = (
            "SendCloudDataProvider::SendCloudParcelDataType",
            "SendCloudDataProvider::SendCloudParcelCreateRequestDataType",
            "SendCloudDataProvider::SendCloudReturnDataType",
        );

        foreach string cls_name in (type_class_names) {
            try {
                Class cls = Class::forName(cls_name);
                AbstractDataProviderType t = cast<AbstractDataProviderType>(cls.newObject());
                hash<string, AbstractDataField> fields = t.getFields();
                assertGt(0, fields.size(), sprintf("%s should have at least 1 field", cls_name));
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err == "UNKNOWN-CLASS") {
                    # Tolerate individual type class naming differences so the test still runs
                    # against a provider using slightly different names; surface as a soft failure.
                    if (m_options.verbose) {
                        printf("note: type class %y not found — skipping\n", cls_name);
                    }
                    continue;
                }
                rethrow;
            }
        }
    }

    #! Verify the SendCloud app is registered with the Shipping group
    testAppRegistered() {
        checkJson();
        *hash<DataProviderAppInfo> app = DataProviderActionCatalog::getApp("SendCloud");
        assertTrue(exists app, "SendCloud app should be registered");
        assertEq("SendCloud", app.name);
        assertTrue(exists app.groups, "SendCloud app should have groups");
    }

    #! Verify the event providers expose example data of the right shape
    testEventExampleData() {
        checkJson();
        # Construct event watch providers without a REST client — the public
        # getExampleEventData() falls back to getFakeExampleData() when fetchRecords() can't run.
        list<list<auto>> cases = (
            ("SendCloudDataProvider::SendCloudWatchParcelStatusChangedDataProvider",
                "parcel-status-changed", ("id", "tracking_number", "status")),
            ("SendCloudDataProvider::SendCloudWatchReturnUpdatedDataProvider",
                "return-updated", ("id", "status", "products")),
        );

        foreach list<auto> entry in (cases) {
            string cls_name = entry[0];
            string event_name = entry[1];
            list<string> required_keys = entry[2];

            Class cls = Class::forName(cls_name);
            DataProvider::AbstractDataProvider provider =
                cast<DataProvider::AbstractDataProvider>(cls.newObject(NOTHING));
            hash<auto> example = provider.getExampleEventData(event_name);
            foreach string key in (required_keys) {
                assertTrue(example.hasKey(key),
                    sprintf("%s example event data should include %y key", cls_name, key));
            }
        }
    }

    #! Verify create-return request type carries the v3-required fields after the
    #! v2-write→v3-write migration: \c shipping_option_code (returns shipping option, e.g.
    #! \c "dpd:return/return") and the optional \c weight override.  These are the new
    #! fields the v3 \c POST /api/v3/returns/announce-synchronously endpoint relies on.
    testCreateReturnV3RequestType() {
        checkJson();
        AbstractDataProviderType req_type = new SendCloudReturnCreateRequestDataType();
        hash<string, AbstractDataField> fields = req_type.getFields();

        assertTrue(fields.hasKey("outgoing_parcel"),
            "outgoing_parcel field should be present (used to derive v3 from/to addresses)");
        assertTrue(fields.hasKey("shipping_option_code"),
            "shipping_option_code field should be present (required for v3)");
        assertTrue(fields.hasKey("weight"),
            "weight field should be present (optional v3 override)");
        assertTrue(fields.hasKey("products"),
            "products field should still be present (translated to v3 parcel_items)");
    }

    #! Verify create-parcel request type carries the v3-required minimal field surface.
    #! v3 \c POST /api/v3/shipments/announce requires: \c to_address (name + address_line_1 +
    #! postal_code + city + country_code), \c parcels[].weight, and \c ship_with.  The flat
    #! request shape this provider exposes maps these to: \c name, \c address, \c city,
    #! \c postal_code, \c country, \c weight, and \c shipping_method.  All seven must be
    #! marked \c required and \c shipping_method must carry \c ref_data="shipping_methods"
    #! so the UI renders a dropdown instead of a freeform int input.
    testCreateParcelRequiredFields() {
        checkJson();
        # Build the action options the same way the provider registers them; this is the
        # surface Qorus reads to render the form.
        hash<string, hash<ActionOptionInfo>> opts = DataProviderActionCatalog::getActionOptionFromFields(
            SendCloudParcelCreateRequestDataType::Fields);

        list<string> required_fields = (
            "name", "address", "city", "postal_code", "country", "weight", "shipping_method",
        );
        foreach string field_name in (required_fields) {
            *hash<ActionOptionInfo> o = opts{field_name};
            assertTrue(exists o, sprintf("%s option should exist", field_name));
            assertTrue(o.required, sprintf("%s should be marked required", field_name));
        }

        # shipping_method must surface ref_data so the UI can build a dropdown of available
        # shipping methods (the previous nested `shipment` hash hid the inner ref_data).
        assertEq("shipping_methods", opts.shipping_method.ref_data,
            "shipping_method must carry ref_data=shipping_methods for UI dropdown rendering");

        # The legacy `shipment` hash field should no longer exist on the surface; the
        # provider keeps a backward-compat fallback for callers that still send `shipment.id`.
        assertEq(NOTHING, opts.shipment, "shipment hash field should be removed in favor of shipping_method");
    }

    #! Guard against the regression where v3 actions failed with
    #! \c SENDCLOUD-ERROR "no credentials are available" because the data provider
    #! constructed via the connection's \c getDataProvider() never recovered the
    #! public_key/secret_key from the async rest client.  The provider must expose
    #! the credentials regardless of which constructor path is hit.
    testCredentialPropagation() {
        checkJson();
        # 1) Build a SendCloudRestClientIo directly with explicit credentials
        SendCloudRestClient::SendCloudRestClientIo io(
            {"public_key": "pk-test", "secret_key": "sk-test"});
        *hash<auto> recovered = io.getSendCloudCredentials();
        assertEq("pk-test", recovered.public_key, "rest client should retain public_key");
        assertEq("sk-test", recovered.secret_key, "rest client should retain secret_key");

        # 2) Construct the data provider from that rest client (the path Qorus uses
        # when invoking actions via a connection): credentials must propagate so v3
        # cross-prefix calls can build a synchronous client.
        SendCloudDataProvider::SendCloudDataProvider dp(io);
        *hash<auto> dp_creds = dp.getSendCloudCredentials();
        assertEq("pk-test", dp_creds.public_key, "data provider should recover public_key from rest client");
        assertEq("sk-test", dp_creds.secret_key, "data provider should recover secret_key from rest client");

        # 3) Construct via constructor options that supply a pre-built rest client:
        # credentials must still surface.
        SendCloudDataProvider::SendCloudDataProvider dp2({"restclient": io});
        assertEq("pk-test", dp2.getSendCloudCredentials().public_key,
            "data provider should recover credentials when restclient is passed via options");
    }

    #! Verify every advertised action is resolvable via the factory's action catalog
    testActionsRegistered() {
        checkJson();
        *list<hash<DataProviderActionInfo>> actions = DataProviderActionCatalog::getActions("SendCloud");
        assertTrue(exists actions, "action catalog should exist");
        assertGt(0, actions.size(), "action catalog should be non-empty");

        # Spot-check each action has an action code
        foreach hash<DataProviderActionInfo> action in (actions) {
            assertTrue(exists action.action, sprintf("action missing 'action' code: %y", action));
            assertTrue(exists action.action_code,
                sprintf("action %y missing action_code", action.action));
        }
    }

    ########################################################################
    # Live integration tests (skipped unless -c <conn> provided)
    ########################################################################

    testPing() {
        checkJson();
        if (!conn_name) {
            testSkip("no connection specified (use -c <name>)");
        }
        try {
            object conn = call_function("get_connection", conn_name);
            hash<auto> result = conn.ping(True);
            assertTrue(result.ok, sprintf("ping failed: %y", result));
        } catch (hash<ExceptionInfo> ex) {
            fail(sprintf("ping threw %s: %s", ex.err, ex.desc));
        }
    }

    testGetUser() {
        checkJson();
        DataProvider::AbstractDataProvider r = requireConnection();
        try {
            hash<auto> result = runAction(r, "get-user", {});
            # get-user unwraps the {user: ...} envelope — result is the user record directly
            assertTrue(result.username.val(), "username should be non-empty");
        } catch (hash<ExceptionInfo> ex) {
            if (isScopeOr404(ex)) {
                testSkip(sprintf("get-user unavailable (status %d): %s", ex.arg.status_code, ex.desc));
            }
            rethrow;
        }
    }

    testListShippingMethods() {
        checkJson();
        DataProvider::AbstractDataProvider r = requireConnection();
        try {
            hash<auto> result = runAction(r, "list-shipping-methods", {});
            assertTrue(exists result.shipping_methods, "response should include shipping_methods");
            assertEq(Type::List, result.shipping_methods.type(),
                "shipping_methods should be a list");
            assertGt(0, result.shipping_methods.size(), "at least one shipping method expected");
        } catch (hash<ExceptionInfo> ex) {
            if (isScopeOr404(ex)) {
                testSkip(sprintf("list-shipping-methods unavailable: %s", ex.desc));
            }
            rethrow;
        }
    }

    testListSenderAddresses() {
        checkJson();
        DataProvider::AbstractDataProvider r = requireConnection();
        try {
            hash<auto> result = runAction(r, "list-sender-addresses", {});
            # Account may have zero sender addresses — accept empty list
            assertTrue(exists result.sender_addresses, "response should include sender_addresses key");
        } catch (hash<ExceptionInfo> ex) {
            if (isScopeOr404(ex)) {
                testSkip(sprintf("list-sender-addresses unavailable: %s", ex.desc));
            }
            rethrow;
        }
    }

    #! Create a test parcel, fetch it by id, verify persistence, then cancel it.
    #! Uses shipping method 8 (Unstamped letter) with request_label: False to avoid charges.
    testParcelRoundTrip() {
        checkJson();
        DataProvider::AbstractDataProvider r = requireConnection();

        hash<auto> parcel_request = {
            "name": "Qore Test Recipient",
            "company_name": "Qore Technologies",
            "address": "Test Street 1",
            "house_number": "1",
            "city": "Amsterdam",
            "postal_code": "1012AB",
            "country": "NL",
            "telephone": "0000000000",
            "request_label": False,
            "email": "test@example.com",
            "weight": "1.000",
            "order_number": sprintf("qore-test-%d", now_us().format("YYYYMMDDHHmmSSxx")),
            "shipping_method": TestShippingMethodId,
        };

        hash<auto> created;
        try {
            created = runAction(r, "create-parcel", parcel_request);
        } catch (hash<ExceptionInfo> ex) {
            if (isScopeOr404(ex)) {
                testSkip(sprintf("create-parcel unavailable: %s", ex.desc));
            }
            rethrow;
        }

        # The v3 create-parcel implementation flattens the v3 shipment response back to a
        # v2-shaped parcel hash; the integer parcel id (same ID space as v2) is on `id`,
        # and the v3-only shipment UUID is surfaced under `shipment_uuid` for callers that
        # need it.  The presence of `shipment_uuid` is the marker that confirms the v3
        # endpoint was actually used (rather than a silent fallback to v2).
        assertTrue(exists created.id, "created parcel should have an integer id");
        assertTrue(exists created.shipment_uuid,
            "created result should include `shipment_uuid` (the v3 shipment id), proving the "
            "v3 /shipments/announce endpoint was used");
        testParcelId = created.id;

        on_exit {
            if (testParcelId) {
                try {
                    runAction(r, "cancel-parcel", {"id": testParcelId});
                } catch (hash<ExceptionInfo> ex) {
                    if (m_options.verbose) {
                        printf("cleanup: failed to cancel parcel %d: %s\n", testParcelId, ex.desc);
                    }
                }
            }
        }

        # Verify data persistence — the server must return the parcel when queried.
        # This is the critical check: 200 OK on create is not proof of persistence.
        try {
            hash<auto> fetched = runAction(r, "get-parcel", {"id": testParcelId});
            # get-parcel's doRequestImpl returns the parcel record directly (already unwrapped)
            assertEq(testParcelId, fetched.id,
                "fetched parcel id should match created id (data persistence check)");
            assertEq(parcel_request.postal_code, fetched.postal_code,
                "postal_code should match what was submitted");
        } catch (hash<ExceptionInfo> ex) {
            if (isScopeOr404(ex)) {
                testSkip(sprintf("get-parcel unavailable: %s", ex.desc));
            }
            rethrow;
        }
    }

    #! Submit \c create-parcel with the absolute minimum field set per the v3 announce
    #! schema: \c to_address required fields, \c parcels[].weight, and \c ship_with (via
    #! \c shipping_method).  The provider auto-resolves the default sender address so
    #! \c from_address is not required client-side.  Skips cleanly if the account has no
    #! sender addresses (the auto-resolve path then throws a clear SENDCLOUD-ERROR).
    testCreateParcelMinimalFields() {
        checkJson();
        DataProvider::AbstractDataProvider r = requireConnection();

        hash<auto> minimal_request = {
            "name": "Qore Minimal",
            "address": "Test Street 1",
            "city": "Amsterdam",
            "postal_code": "1012AB",
            "country": "NL",
            "weight": "1.000",
            "shipping_method": TestShippingMethodId,
        };

        *int parcel_id;
        on_exit {
            if (parcel_id) {
                try {
                    runAction(r, "cancel-parcel", {"id": parcel_id});
                } catch (hash<ExceptionInfo> ex) {
                    if (m_options.verbose) {
                        printf("cleanup: failed to cancel parcel %d: %s\n", parcel_id, ex.desc);
                    }
                }
            }
        }

        hash<auto> created;
        try {
            created = runAction(r, "create-parcel", minimal_request);
        } catch (hash<ExceptionInfo> ex) {
            if (isScopeOr404(ex)) {
                testSkip(sprintf("create-parcel unavailable: %s", ex.desc));
            }
            # SendCloud rejects with SENDCLOUD-ERROR if no sender address is configured —
            # acceptable skip since this test exercises the *minimal client-side* surface.
            if (ex.err == "SENDCLOUD-ERROR" && ex.desc =~ /sender address/) {
                testSkip(sprintf("no sender address configured: %s", ex.desc));
            }
            rethrow;
        }
        assertTrue(exists created.id,
            "minimal-fields create-parcel should succeed and return an integer parcel id");
        assertTrue(exists created.shipment_uuid,
            "minimal-fields response should include shipment_uuid (proves v3 announce was used)");
        parcel_id = created.id;
    }

    #! End-to-end return round-trip exercising the v3 \c create-return path:
    #!   create parcel  →  create return on it  →  fetch the return back  →  cancel the return.
    #!
    #! The return uses the same shipping method as the outgoing parcel (id 8 = "Unstamped
    #! letter") translated via the SendCloud compatibility endpoint into a v3
    #! shipping_option_code.  This exercises the full v3 flow:
    #!   - outgoing parcel lookup (deriving v3 from_address + to_address)
    #!   - sender_address resolution into a v3 to_address
    #!   - shipping_option_code translation via /api/v3/compat/shipping-options
    #!   - POST /api/v3/returns/announce-synchronously
    #!
    #! The test gracefully skips on accounts where the carrier behind shipping method 8
    #! does not expose a return-capable option (the compat endpoint returns null in that
    #! case and our data provider raises SENDCLOUD-ERROR with a clear message).
    testReturnRoundTrip() {
        checkJson();
        DataProvider::AbstractDataProvider r = requireConnection();

        # First, create an outgoing parcel to anchor the return on.
        hash<auto> created;
        try {
            created = runAction(r, "create-parcel", {
                "name": "Qore Test Recipient",
                "company_name": "Qore Technologies",
                "address": "Test Street 1",
                "house_number": "1",
                "city": "Amsterdam",
                "postal_code": "1012AB",
                "country": "NL",
                "telephone": "0000000000",
                "request_label": False,
                "email": "test@example.com",
                "weight": "1.000",
                "order_number": sprintf("qore-test-ret-%d", now_us().format("YYYYMMDDHHmmSSxx")),
                "shipping_method": TestShippingMethodId,
            });
        } catch (hash<ExceptionInfo> ex) {
            if (isScopeOr404(ex)) {
                testSkip(sprintf("create-parcel unavailable: %s", ex.desc));
            }
            rethrow;
        }
        int parcel_id = created.id;
        on_exit {
            try {
                runAction(r, "cancel-parcel", {"id": parcel_id});
            } catch () {
                # best-effort cleanup
            }
        }

        # Create a return for the outgoing parcel.  The shipping_option_code is omitted so
        # the data provider falls back to translating the outgoing parcel's shipping method
        # via the v3 compat endpoint.  If that translation produces no return-capable code,
        # the data provider raises SENDCLOUD-ERROR and we skip — that's an account-level
        # limit, not a test failure.
        hash<auto> created_return;
        try {
            created_return = runAction(r, "create-return", {
                "outgoing_parcel": parcel_id,
                "products": (
                    {"description": "Test item", "quantity": 1, "value": "9.99"},
                ),
                "reason": "no_longer_needed",
            });
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "SENDCLOUD-ERROR" && ex.desc =~ /shipping_option_code/) {
                testSkip(sprintf(
                    "no return-capable shipping option for shipping method %d on this account",
                    TestShippingMethodId));
            }
            if (isScopeOr404(ex)) {
                testSkip(sprintf("create-return unavailable: %s", ex.desc));
            }
            rethrow;
        }

        # The v3 sync response is {return_id, parcel_id, multi_collo_ids}; flattenV3ReturnResponse()
        # exposes return_id under `id` and parcel_id under `parcel_id` for backward compat.
        assertTrue(exists created_return.id, "created return should have an integer id");
        assertTrue(exists created_return.parcel_id,
            "created return should expose `parcel_id` (the v3 incoming parcel id)");
        int return_id = created_return.id;

        on_exit {
            try {
                runAction(r, "cancel-return", {"id": return_id});
            } catch () {
                # best-effort cleanup
            }
        }

        # Fetch the return back to verify persistence.  get-return is still wired to v2
        # (the v3 parcel/return id space is shared with v2 reads, so v2 GET /returns/{id}
        # works for v3-created returns); skip if this account has migrated returns reads
        # to v3-only.
        try {
            hash<auto> fetched = runAction(r, "get-return", {"id": return_id});
            assertEq(return_id, int(fetched.id),
                "fetched return id should match created id (data persistence check)");
        } catch (hash<ExceptionInfo> ex) {
            if (isScopeOr404(ex)) {
                testSkip(sprintf("get-return unavailable: %s", ex.desc));
            }
            rethrow;
        }
    }

    testServicePointSearch() {
        checkJson();
        DataProvider::AbstractDataProvider r = requireConnection();
        try {
            hash<auto> result = runAction(r, "search-service-points", {
                "country": "NL",
            });
            # Accept either a top-level list or a {service_points: [...]} shape
            auto points = exists result.service_points ? result.service_points : result;
            assertTrue(points.type() == Type::List || exists result.service_points,
                "search-service-points should return a list");
        } catch (hash<ExceptionInfo> ex) {
            if (isScopeOr404(ex)) {
                testSkip(sprintf("search-service-points unavailable: %s", ex.desc));
            }
            rethrow;
        }
    }
}
