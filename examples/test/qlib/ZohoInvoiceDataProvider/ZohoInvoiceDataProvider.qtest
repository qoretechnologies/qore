    #! Test invoices provider
    private testInvoicesProvider() {
        if (m_options.verbose) {
            printf("\n--- Testing Invoices Provider ---\n");
        }

        ZohoInvoiceDataProvider::ZohoInvoiceDataProvider prov(client);

        # List existing invoices
        AbstractDataProvider invoicesProvider = prov.getChildProvider("invoices");
        list<hash<auto>> invoices = map $1, invoicesProvider.searchRecords();

        if (m_options.verbose) {
            printf("Found %d invoices\n", invoices.size());
        }

        # Create a test invoice
        AbstractDataProvider createInvoiceProvider = prov.getChildProvider("create-invoice");

        try {
            hash<auto> newInvoice = createInvoiceProvider.doRequest({
                "customer_id": testContactId,
                "date": now().format("YYYY-MM-DD"),
                "line_items": ({
                    "item_id": testItemId,
                    "name": "Test Item",
                    "quantity": 1,
                    "rate": 100.00,
                },),
            });

            if (newInvoice.invoice_id) {
                testInvoiceId = newInvoice.invoice_id;
                assertTrue(testInvoiceId.val(), "Invoice should be created with an ID");
                if (m_options.verbose) {
                    printf("Created test invoice: %s (Total: %s)\n",
                        newInvoice.invoice_number ?? testInvoiceId,
                        newInvoice.total ?? "N/A");
                }

                # Test get invoice
                AbstractDataProvider getInvoiceProvider = prov.getChildProvider("get-invoice");
                hash<auto> fetchedInvoice = getInvoiceProvider.doRequest({
                    "invoice_id": testInvoiceId,
                });
                assertEq(testInvoiceId, fetchedInvoice.invoice_id);
                assertEq(testContactId, fetchedInvoice.customer_id);
                if (m_options.verbose) {
                    printf("Fetched invoice: %s\n", fetchedInvoice.invoice_number ?? testInvoiceId);
                }

                # Test update invoice
                AbstractDataProvider updateInvoiceProvider = prov.getChildProvider("update-invoice");
                string testNotes = sprintf("Updated by integration test at %s", now_us().toString());
                hash<auto> updatedInvoice = updateInvoiceProvider.doRequest({
                    "invoice_id": testInvoiceId,
                    "notes": testNotes,
                });
                if (m_options.verbose) {
                    printf("Updated invoice: %s\n", updatedInvoice.invoice_number ?? testInvoiceId);
                }

                # Verify update persisted
                hash<auto> verifyInvoice = getInvoiceProvider.doRequest({
                    "invoice_id": testInvoiceId,
                });
                assertEq(testNotes, verifyInvoice.notes);
            }
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("Invoice operation failed: %s: %s\n", ex.err, ex.desc);
            }
            rethrow;
        }

        if (m_options.verbose) {
            printf("--- Invoices Provider tests completed ---\n");
        }
    }

    #! Test invoice data integrity - verifies data actually persists
    /** CRITICAL: This test verifies that invoice data is correctly saved and retrievable.
        This catches issues like:
        - Wrong Content-Type (JSON vs form-encoded)
        - Incorrect field name transformation
        - Silent API acceptance without data persistence
    */
    private testInvoiceDataIntegrity() {
        if (m_options.verbose) {
            printf("\n--- Testing Invoice Data Integrity ---\n");
        }

        if (!testInvoiceId) {
            if (m_options.verbose) {
                printf("No test invoice available, skipping data integrity test\n");
            }
            return;
        }

        ZohoInvoiceDataProvider::ZohoInvoiceDataProvider prov(client);

        # Fetch invoice and verify data was saved
        AbstractDataProvider getInvoiceProvider = prov.getChildProvider("get-invoice");
        hash<auto> invoice = getInvoiceProvider.doRequest({
            "invoice_id": testInvoiceId,
        });

        # Verify key fields
        assertEq(testInvoiceId, invoice.invoice_id);
        assertEq(testContactId, invoice.customer_id);
        assertTrue(invoice.line_items.size() > 0, "Invoice should have line items");
        assertTrue(invoice.total > 0, "Invoice total should be greater than 0");
        assertTrue(invoice.invoice_number.val(), "Invoice should have an invoice number");
        assertTrue(invoice.date.val(), "Invoice should have a date");
        assertTrue(invoice.status.val(), "Invoice should have a status");

        # Verify line item data
        hash<auto> lineItem = invoice.line_items[0];
        assertEq(testItemId, lineItem.item_id);
        assertEq(1, lineItem.quantity);
        assertEq(100.00, lineItem.rate);

        if (m_options.verbose) {
            printf("Data integrity verified:\n");
            printf("  - Invoice ID: %s\n", invoice.invoice_id);
            printf("  - Invoice Number: %s\n", invoice.invoice_number);
            printf("  - Customer ID: %s\n", invoice.customer_id);
            printf("  - Date: %s\n", invoice.date);
            printf("  - Status: %s\n", invoice.status);
            printf("  - Line items: %d\n", invoice.line_items.size());
            printf("  - Total: %s\n", invoice.total);
        }

        if (m_options.verbose) {
            printf("--- Invoice Data Integrity tests completed ---\n");
        }
    }

