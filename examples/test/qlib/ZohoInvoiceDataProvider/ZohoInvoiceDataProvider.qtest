    private testCreateEstimateWithOptionalFields() {
        if (m_options.verbose) {
            printf("\n--- Testing Create Estimate With Optional Fields ---\n");
        }

        if (!testContactId || !testItemId) {
            if (m_options.verbose) {
                printf("Skipping estimate test - need contact and item\n");
            }
            return;
        }

        ZohoInvoiceDataProvider::ZohoInvoiceDataProvider prov(client);
        AbstractDataProvider createEstimateProvider = prov.getChildProvider("create-estimate");

        try {
            # Calculate dates
            date today = now();
            date expiryDate = today + 30D;

            # Create estimate with all optional fields
            hash<auto> estimateData = {
                "customer_id": testContactId,
                "reference_number": "PO-TEST-001",
                "date": today.format("YYYY-MM-DD"),
                "expiry_date": expiryDate.format("YYYY-MM-DD"),
                "payment_terms": 30,
                "discount": 10.0,
                "discount_type": "entity_level",
                "notes": "Special promotional discount applied",
                "terms": "Payment due within 30 days",
                "salesperson_name": "John Doe",
            };

            hash<auto> newEstimate = createEstimateProvider.doRequest(estimateData);

            if (newEstimate.estimate_id) {
                assertTrue(newEstimate.estimate_id.val(), "Estimate should be created with an ID");

                # CRITICAL: Verify data persistence
                AbstractDataProvider getEstimateProvider = prov.getChildProvider("get-estimate");
                hash<auto> fetchedEstimate = getEstimateProvider.doRequest({
                    "estimate_id": newEstimate.estimate_id,
                });

                # Verify key fields persisted correctly
                assertEq(testContactId, fetchedEstimate.customer_id, "customer_id should persist");
                if (fetchedEstimate.reference_number) {
                    assertEq("PO-TEST-001", fetchedEstimate.reference_number, "reference_number should persist");
                }

                if (m_options.verbose) {
                    printf("Created and verified estimate with all fields: %s\n", newEstimate.estimate_id);
                    printf("  - Reference Number: %s\n", fetchedEstimate.reference_number ?? "N/A");
                    printf("  - Expiry Date: %s\n", fetchedEstimate.expiry_date ?? "N/A");
                    printf("  - Payment Terms: %s\n", fetchedEstimate.payment_terms ?? "N/A");
                }

                # Delete test estimate
                try {
                    AbstractDataProvider deleteEstimateProvider = prov.getChildProvider("delete-estimate");
                    deleteEstimateProvider.doRequest({"estimate_id": newEstimate.estimate_id});
                } catch (hash<ExceptionInfo> ex) {
                    if (m_options.verbose) {
                        printf("Cleanup failed: %s\n", ex.desc);
                    }
                }
            }
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("Create estimate with optional fields failed: %s: %s\n", ex.err, ex.desc);
            }
            rethrow;
        }

        if (m_options.verbose) {
            printf("--- Create Estimate With Optional Fields test completed ---\n");
        }
    }

    #! Test creating an invoice with all optional fields
    private testCreateInvoiceWithOptionalFields() {
        if (m_options.verbose) {
            printf("\n--- Testing Create Invoice With Optional Fields ---\n");
        }

        if (!testContactId || !testItemId) {
            if (m_options.verbose) {
                printf("Skipping invoice with optional fields test - need contact and item\n");
            }
            return;
        }

        ZohoInvoiceDataProvider::ZohoInvoiceDataProvider prov(client);
        AbstractDataProvider createInvoiceProvider = prov.getChildProvider("create-invoice");

        try {
            # Calculate dates
            date today = now();
            date dueDate = today + 30D;

            # Create invoice with all optional fields
            hash<auto> invoiceData = {
                "customer_id": testContactId,
                "reference_number": "PO-FULL-TEST-001",
                "date": today.format("YYYY-MM-DD"),
                "due_date": dueDate.format("YYYY-MM-DD"),
                "payment_terms": 30,
                "discount": 15.0,
                "discount_type": "entity_level",
                "notes": "Thank you for your business!",
                "terms": "Net 30 - Payment due within 30 days",
                "salesperson_name": "Jane Smith",
                "line_items": ({
                    "item_id": testItemId,
                    "quantity": 2,
                    "rate": 150.00,
                },),
            };

            hash<auto> newInvoice = createInvoiceProvider.doRequest(invoiceData);

            if (newInvoice.invoice_id) {
                assertTrue(newInvoice.invoice_id.val(), "Invoice should be created with an ID");

                # CRITICAL: Verify data persistence - this catches silent API failures
                AbstractDataProvider getInvoiceProvider = prov.getChildProvider("get-invoice");
                hash<auto> fetchedInvoice = getInvoiceProvider.doRequest({
                    "invoice_id": newInvoice.invoice_id,
                });

                # Verify ALL key fields persisted correctly
                assertEq(testContactId, fetchedInvoice.customer_id, "customer_id should persist");
                assertEq("PO-FULL-TEST-001", fetchedInvoice.reference_number, "reference_number should persist");
                assertEq(30, fetchedInvoice.payment_terms, "payment_terms should persist");
                assertEq("Thank you for your business!", fetchedInvoice.notes, "notes should persist");
                assertEq("Net 30 - Payment due within 30 days", fetchedInvoice.terms, "terms should persist");

                if (m_options.verbose) {
                    printf("Created and verified invoice with all fields: %s\n",
                        fetchedInvoice.invoice_number ?? newInvoice.invoice_id);
                    printf("  - Reference Number: %s\n", fetchedInvoice.reference_number);
                    printf("  - Payment Terms: %d days\n", fetchedInvoice.payment_terms);
                    printf("  - Discount: %s\n", fetchedInvoice.discount ?? "N/A");
                    printf("  - Notes: %s\n", fetchedInvoice.notes);
                    printf("  - Salesperson: %s\n", fetchedInvoice.salesperson_name ?? "N/A");
                }

                # Delete test invoice
                try {
                    AbstractDataProvider deleteInvoiceProvider = prov.getChildProvider("delete-invoice");
                    deleteInvoiceProvider.doRequest({"invoice_id": newInvoice.invoice_id});
                } catch (hash<ExceptionInfo> ex) {
                    if (m_options.verbose) {
                        printf("Cleanup failed: %s\n", ex.desc);
                    }
                }
            }
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("Create invoice with optional fields failed: %s: %s\n", ex.err, ex.desc);
            }
            rethrow;
        }

        if (m_options.verbose) {
            printf("--- Create Invoice With Optional Fields test completed ---\n");
        }
    }

    #! Test update actions with optional fields
    private testUpdateActionsWithOptionalFields() {
        if (m_options.verbose) {
            printf("\n--- Testing Update Actions With Optional Fields ---\n");
        }

        if (!testContactId) {
            if (m_options.verbose) {
                printf("Skipping update tests - no test contact available\n");
            }
            return;
        }

        ZohoInvoiceDataProvider::ZohoInvoiceDataProvider prov(client);

        try {
            # Test update-contact with optional fields
            AbstractDataProvider updateContactProvider = prov.getChildProvider("update-contact");
            string updatedNotes = sprintf("Updated via test at %s", now_us().toString());

            hash<auto> updateData = {
                "contact_id": testContactId,
                "company_name": "Updated Company Name",
                "phone": "+1-555-9999",
                "notes": updatedNotes,
                "payment_terms": 45,
            };

            hash<auto> updatedContact = updateContactProvider.doRequest(updateData);

            # CRITICAL: Verify the update persisted
            AbstractDataProvider getContactProvider = prov.getChildProvider("get-contact");
            hash<auto> fetchedContact = getContactProvider.doRequest({
                "contact_id": testContactId,
            });

            assertEq("Updated Company Name", fetchedContact.company_name,
                "Updated company_name should persist");
            assertEq(updatedNotes, fetchedContact.notes, "Updated notes should persist");
            assertEq(45, fetchedContact.payment_terms, "Updated payment_terms should persist");

            if (m_options.verbose) {
                printf("Successfully updated contact with optional fields\n");
                printf("  - Company Name: %s\n", fetchedContact.company_name);
                printf("  - Payment Terms: %d days\n", fetchedContact.payment_terms);
            }
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("Update actions with optional fields failed: %s: %s\n", ex.err, ex.desc);
            }
            rethrow;
        }

        if (m_options.verbose) {
            printf("--- Update Actions With Optional Fields test completed ---\n");
        }
    }

    #! Test list actions with optional search filters
    private testListFiltersWithOptionalFields() {
        if (m_options.verbose) {
            printf("\n--- Testing List Actions With Optional Filters ---\n");
        }

        ZohoInvoiceDataProvider::ZohoInvoiceDataProvider prov(client);

        try {
            # Test list-invoices with date filters
            AbstractDataProvider listInvoicesProvider = prov.getChildProvider("invoices");
            date today = now();
            date last30Days = today - 30D;

            hash<auto> searchOptions = {
                "date_start": last30Days.format("YYYY-MM-DD"),
                "date_end": today.format("YYYY-MM-DD"),
                "status": "paid",
            };

            list<hash<auto>> invoices = map $1, listInvoicesProvider.searchRecords(NOTHING, searchOptions);

            if (m_options.verbose) {
                printf("Found %d paid invoices in last 30 days\n", invoices.size());
            }

            # Test list-contacts with search filters
            AbstractDataProvider listContactsProvider = prov.getChildProvider("contacts");

            hash<auto> contactSearchOptions = {
                "status": "active",
                "contact_name": "Test",
            };

            list<hash<auto>> contacts = map $1, listContactsProvider.searchRecords(NOTHING, contactSearchOptions);

            if (m_options.verbose) {
                printf("Found %d active contacts matching 'Test'\n", contacts.size());
            }
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("List with optional filters failed: %s: %s\n", ex.err, ex.desc);
            }
            # Don't rethrow - filters might not be supported in all Zoho accounts
        }

        if (m_options.verbose) {
            printf("--- List Actions With Optional Filters test completed ---\n");
        }
    }

    #! Cleanup test data
    private cleanup() {
        if (m_options.verbose) {
            printf("\n--- Cleanup ---\n");
        }

        ZohoInvoiceDataProvider::ZohoInvoiceDataProvider prov(client);

        # Delete test invoice
        if (testInvoiceId) {
            try {
                AbstractDataProvider deleteInvoiceProvider = prov.getChildProvider("delete-invoice");
                deleteInvoiceProvider.doRequest({"invoice_id": testInvoiceId});
                if (m_options.verbose) {
                    printf("Deleted test invoice: %s\n", testInvoiceId);
                }
            } catch (hash<ExceptionInfo> ex) {
                if (m_options.verbose) {
                    printf("Failed to delete invoice: %s\n", ex.desc);
                }
            }
        }

        # Delete test project
        if (testProjectId) {
            try {
                AbstractDataProvider markProjectProvider = prov.getChildProvider("mark-project");
                markProjectProvider.doRequest({
                    "project_id": testProjectId,
                    "status": "inactive",
                });
                if (m_options.verbose) {
                    printf("Marked test project inactive: %s\n", testProjectId);
                }
            } catch (hash<ExceptionInfo> ex) {
                if (m_options.verbose) {
                    printf("Failed to mark project inactive: %s\n", ex.desc);
                }
            }
        }

        # Mark test contact inactive
        if (testContactId) {
            try {
                AbstractDataProvider markContactProvider = prov.getChildProvider("mark-contact");
                markContactProvider.doRequest({
                    "contact_id": testContactId,
                    "status": "inactive",
                });
                if (m_options.verbose) {
                    printf("Marked test contact inactive: %s\n", testContactId);
                }
            } catch (hash<ExceptionInfo> ex) {
                if (m_options.verbose) {
                    printf("Failed to mark contact inactive: %s\n", ex.desc);
                }
            }
        }

        if (m_options.verbose) {
            printf("--- Cleanup completed ---\n");
        }
    }

    #! Polling trigger tests - test polling-based triggers
    pollingTriggerTests() {
        checkJson();
        if (!client) {
            testSkip("No Zoho Invoice credentials provided");
            return;
        }

        if (m_options.verbose) {
            printf("\n--- Testing Polling Trigger Providers ---\n");
        }

        # ============================================
        # Test New Invoice Event Provider
        # ============================================
        if (m_options.verbose) {
            printf("\nTesting ZohoInvoiceNewInvoiceWatchDataProvider...\n");
        }

        ZohoInvoiceDataProvider::ZohoInvoiceNewInvoiceWatchDataProvider invoiceEventProv(client, {
            "poll_interval": 60,
        });
        assertEq("new-invoice", invoiceEventProv.getName());

        hash<DataProviderInfo> invoiceEventInfo = invoiceEventProv.getInfo();
        assertTrue(invoiceEventInfo.supports_observable);
        assertEq("ZohoInvoiceNewInvoiceWatchDataProvider", invoiceEventInfo.type);

        if (m_options.verbose) {
            printf("  Provider name: %s\n", invoiceEventProv.getName());
            printf("  Supports observable: %s\n", invoiceEventInfo.supports_observable);
        }

        # ============================================
        # Test New Contact Event Provider
        # ============================================
        if (m_options.verbose) {
            printf("\nTesting ZohoInvoiceNewContactWatchDataProvider...\n");
        }

        ZohoInvoiceDataProvider::ZohoInvoiceNewContactWatchDataProvider contactEventProv(client, {
            "poll_interval": 60,
        });
        assertEq("new-contact", contactEventProv.getName());
        assertTrue(contactEventProv.getInfo().supports_observable);

        # ============================================
        # Test New Estimate Event Provider
        # ============================================
        if (m_options.verbose) {
            printf("\nTesting ZohoInvoiceNewEstimateWatchDataProvider...\n");
        }

        ZohoInvoiceDataProvider::ZohoInvoiceNewEstimateWatchDataProvider estimateEventProv(client, {
            "poll_interval": 60,
        });
        assertEq("new-estimate", estimateEventProv.getName());
        assertTrue(estimateEventProv.getInfo().supports_observable);

        # ============================================
        # Test New Expense Event Provider
        # ============================================
        if (m_options.verbose) {
            printf("\nTesting ZohoInvoiceNewExpenseWatchDataProvider...\n");
        }

        ZohoInvoiceDataProvider::ZohoInvoiceNewExpenseWatchDataProvider expenseEventProv(client, {
            "poll_interval": 60,
        });
        assertEq("new-expense", expenseEventProv.getName());
        assertTrue(expenseEventProv.getInfo().supports_observable);

        # ============================================
        # Test New Item Event Provider
        # ============================================
        if (m_options.verbose) {
            printf("\nTesting ZohoInvoiceNewItemWatchDataProvider...\n");
        }

        ZohoInvoiceDataProvider::ZohoInvoiceNewItemWatchDataProvider itemEventProv(client, {});
        assertEq("new-item", itemEventProv.getName());
        assertTrue(itemEventProv.getInfo().supports_observable);

        # ============================================
        # Test New Project Event Provider
        # ============================================
        if (m_options.verbose) {
            printf("\nTesting ZohoInvoiceNewProjectWatchDataProvider...\n");
        }

        ZohoInvoiceDataProvider::ZohoInvoiceNewProjectWatchDataProvider projectEventProv(client, {});
        assertEq("new-project", projectEventProv.getName());
        assertTrue(projectEventProv.getInfo().supports_observable);

        # ============================================
        # Test Observer Registration
        # ============================================
        if (m_options.verbose) {
            printf("\nTesting observer registration...\n");
        }

        TestObserver observer();
        invoiceEventProv.registerObserver(observer);

        if (m_options.verbose) {
            printf("  Observer registered successfully\n");
        }

        if (m_options.verbose) {
            printf("\n--- Polling Trigger tests completed ---\n");
        }
    }
}

#! Test observer for polling events
class TestObserver inherits Observer {
    public {
        list<hash<auto>> events = ();
    }

    update(string event_id, hash<auto> data) {
        events += {"event_id": event_id, "data": data};
    }
}
