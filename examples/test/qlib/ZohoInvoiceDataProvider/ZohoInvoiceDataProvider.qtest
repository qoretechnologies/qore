%require-types
%enable-all-warnings
%new-style
%strict-args

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/DataProvider
%requires ../../../../qlib/ConnectionProvider
%requires ../../../../qlib/RestClient.qm

%try-module json
%define NoJson
%endtry

%requires ../../../../qlib/ZohoInvoiceRestClient.qm
%requires ../../../../qlib/ZohoInvoiceDataProvider

%exec-class ZohoInvoiceDataProviderTest

public class ZohoInvoiceDataProviderTest inherits QUnit::Test {
    private {
        #! Zoho Invoice REST client for integration tests
        *ZohoInvoiceRestClient::ZohoInvoiceRestClient client;

        #! Logger for verbose output
        Logger logger;

        #! Custom command-line options
        const MyOpts = Opts + {
            "client_id": "i,client-id=s",
            "client_secret": "s,client-secret=s",
            "refresh_token": "r,refresh-token=s",
            "access_token": "a,access-token=s",
            "org_id": "o,org-id=s",
            "subdomain": "S,subdomain=s",
            "domain": "D,domain=s",
            "conn": "c,connection=s",
        };

        #! Test contact ID (created during test)
        *string testContactId;

        #! Test invoice ID (created during test)
        *string testInvoiceId;

        #! Test item ID (created during test)
        *string testItemId;

        #! Test project ID (created during test)
        *string testProjectId;
    }

    constructor() : Test("ZohoInvoiceDataProvider Test", "1.0", \ARGV, MyOpts) {
        logger = new Logger("test", LoggerLevel::getLevelInfo());

        # Unit tests (always run, no credentials needed)
        addTestCase("sanity tests", \sanityTests());
        addTestCase("factory tests", \factoryTests());
        addTestCase("metadata tests", \metadataTests());
        addTestCase("child provider tests", \childProviderTests());
        addTestCase("data type tests", \dataTypeTests());
        addTestCase("negative tests", \negativeTests());
        addTestCase("corner case tests", \cornerCaseTests());
        addTestCase("connection tests", \connectionTests());
        addTestCase("action catalog tests", \actionCatalogTests());

        # Integration tests (require Zoho Invoice credentials)
        addTestCase("integration tests", \integrationTests());

        # Polling trigger tests (require credentials)
        addTestCase("polling trigger tests", \pollingTriggerTests());

        # Try to set up connection for integration tests
        try {
            setupConnection();
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("Connection setup failed: %s: %s\n", ex.err, ex.desc);
            }
        }

        set_return_value(main());
    }

    #! Sets up the Zoho Invoice client for integration tests
    /** Supports two authentication modes:
        1. OAuth2: client_id + client_secret + refresh_token
        2. Access Token: access_token (simpler, recommended for testing)

        Organization ID is now optional - can be set per-request if needed.
    */
    private setupConnection() {
        *string access_token = m_options.access_token ?? ENV.ZOHOINVOICE_ACCESS_TOKEN;
        *string client_id = m_options.client_id ?? ENV.ZOHOINVOICE_CLIENT_ID;
        *string client_secret = m_options.client_secret ?? ENV.ZOHOINVOICE_CLIENT_SECRET;
        *string refresh_token = m_options.refresh_token ?? ENV.ZOHOINVOICE_REFRESH_TOKEN;
        *string org_id = m_options.org_id ?? ENV.ZOHOINVOICE_ORGANIZATION_ID;

        hash<auto> opts = {
            "subdomain": m_options.subdomain ?? ENV.ZOHOINVOICE_SUBDOMAIN ?? "zoho",
            "domain": m_options.domain ?? ENV.ZOHOINVOICE_DOMAIN ?? ".com",
        };

        # Add organization_id if provided (optional)
        if (org_id) {
            opts.organization_id = org_id;
        }

        # Mode 1: Access Token (simpler, recommended for testing)
        if (access_token) {
            opts.token = access_token;
            if (m_options.verbose) {
                printf("Using access token authentication\n");
            }
        }
        # Mode 2: OAuth2 (requires client credentials)
        else if (client_id && client_secret && refresh_token) {
            opts.oauth2_client_id = client_id;
            opts.oauth2_client_secret = client_secret;
            opts.oauth2_refresh_token = refresh_token;
            if (m_options.verbose) {
                printf("Using OAuth2 authentication\n");
            }
        }
        # No valid credentials
        else {
            if (m_options.verbose) {
                printf("Missing Zoho Invoice credentials. Provide either:\n");
                printf("  Option 1 (Access Token):\n");
                printf("    - ZOHOINVOICE_ACCESS_TOKEN or -a option\n");
                printf("  Option 2 (OAuth2):\n");
                printf("    - ZOHOINVOICE_CLIENT_ID or -i option\n");
                printf("    - ZOHOINVOICE_CLIENT_SECRET or -s option\n");
                printf("    - ZOHOINVOICE_REFRESH_TOKEN or -r option\n");
                printf("  Optional:\n");
                printf("    - ZOHOINVOICE_ORGANIZATION_ID or -o option\n");
            }
            return;
        }

        client = new ZohoInvoiceRestClient::ZohoInvoiceRestClient(opts);
    }

    #! Check if json module is available
    private checkJson() {
%ifdef NoJson
        testSkip("no json module present");
%endif
    }

    #! Basic sanity tests - provider instantiation
    sanityTests() {
        checkJson();
        # Test creating provider with fake credentials via zohoinvoicerestclient_options
        # Note: This may fail with OAuth2 errors since Zoho requires authorization_code grant
        try {
            ZohoInvoiceDataProvider::ZohoInvoiceDataProvider prov({
                "subdomain": "zoho",
                "domain": ".com",
                "zohoinvoicerestclient_options": {
                    "oauth2_client_id": "fake-client-id",
                    "oauth2_client_secret": "fake-client-secret",
                },
            });
            assertEq("zohoinvoice", prov.getName());
            assertTrue(prov.getDesc().val());
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "OAUTH2-ERROR") {
                testSkip("OAuth2 requires manual authorization - skipping sanity tests");
            }
            rethrow;
        }
    }

    #! Factory tests - verify factory registration
    factoryTests() {
        checkJson();
        # Verify factory is registered
        AbstractDataProviderFactory factory = DataProvider::getFactory("zohoinvoice");
        assertEq("zohoinvoice", factory.getInfo().name);
        assertEq("Zoho Invoice data provider factory", factory.getInfo().desc);
        assertTrue(factory.getInfo().children_can_support_apis);
        assertTrue(factory.getInfo().children_can_support_records);
        assertTrue(factory.getInfo().children_can_support_observers);

        # Verify factory can create provider with options
        hash<auto> factoryOpts = factory.getInfo().provider_info.constructor_options;
        assertTrue(factoryOpts.hasKey("zohoinvoicerestclient"));
    }

    #! Metadata tests - verify provider info structure
    metadataTests() {
        checkJson();
        try {
            ZohoInvoiceDataProvider::ZohoInvoiceDataProvider prov({
                "subdomain": "zoho",
                "domain": ".com",
                "zohoinvoicerestclient_options": {
                    "oauth2_client_id": "x",
                    "oauth2_client_secret": "x",
                },
            });
            hash<DataProviderInfo> info = prov.getInfo();

            assertTrue(info.supports_children);
            assertTrue(info.children_can_support_apis);
            assertTrue(info.children_can_support_records);
            assertTrue(info.children_can_support_observers);
            assertEq("ZohoInvoiceDataProvider", info.type);

            # Check constructor options
            assertTrue(info.constructor_options.hasKey("zohoinvoicerestclient"));
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "OAUTH2-ERROR") {
                testSkip("OAuth2 requires manual authorization - skipping metadata tests");
            }
            rethrow;
        }
    }

    #! Child provider tests - verify hierarchy
    childProviderTests() {
        checkJson();
        ZohoInvoiceDataProvider::ZohoInvoiceDataProvider prov;
        try {
            prov = new ZohoInvoiceDataProvider::ZohoInvoiceDataProvider({
                "subdomain": "zoho",
                "domain": ".com",
                "zohoinvoicerestclient_options": {
                    "oauth2_client_id": "x",
                    "oauth2_client_secret": "x",
                },
            });
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "OAUTH2-ERROR") {
                testSkip("OAuth2 requires manual authorization - skipping child provider tests");
            }
            rethrow;
        }

        # Check child provider names
        list<string> children = prov.getChildProviderNames();

        # Verify collection providers exist
        assertTrue(children.contains("invoices"));
        assertTrue(children.contains("recurring-invoices"));
        assertTrue(children.contains("contacts"));
        assertTrue(children.contains("expenses"));
        assertTrue(children.contains("recurring-expenses"));
        assertTrue(children.contains("payments"));
        assertTrue(children.contains("estimates"));
        assertTrue(children.contains("projects"));
        assertTrue(children.contains("items"));

        # Verify invoice action providers exist
        assertTrue(children.contains("create-invoice"));
        assertTrue(children.contains("update-invoice"));
        assertTrue(children.contains("delete-invoice"));
        assertTrue(children.contains("get-invoice"));
        assertTrue(children.contains("email-invoice"));
        assertTrue(children.contains("mark-invoice"));

        # Verify recurring invoice action providers exist
        assertTrue(children.contains("create-recurring-invoice"));
        assertTrue(children.contains("update-recurring-invoice"));
        assertTrue(children.contains("get-recurring-invoice"));
        assertTrue(children.contains("mark-recurring-invoice"));

        # Verify contact action providers exist
        assertTrue(children.contains("create-contact"));
        assertTrue(children.contains("update-contact"));
        assertTrue(children.contains("delete-contact"));
        assertTrue(children.contains("get-contact"));
        assertTrue(children.contains("mark-contact"));

        # Verify expense action providers exist
        assertTrue(children.contains("create-expense"));
        assertTrue(children.contains("update-expense"));
        assertTrue(children.contains("delete-expense"));
        assertTrue(children.contains("get-expense"));

        # Verify recurring expense action providers exist
        assertTrue(children.contains("create-recurring-expense"));
        assertTrue(children.contains("update-recurring-expense"));
        assertTrue(children.contains("delete-recurring-expense"));
        assertTrue(children.contains("get-recurring-expense"));

        # Verify payment action providers exist
        assertTrue(children.contains("create-payment"));
        assertTrue(children.contains("update-payment"));
        assertTrue(children.contains("delete-payment"));
        assertTrue(children.contains("get-payment"));
        assertTrue(children.contains("refund-payment"));

        # Verify estimate action providers exist
        assertTrue(children.contains("create-estimate"));
        assertTrue(children.contains("update-estimate"));
        assertTrue(children.contains("delete-estimate"));
        assertTrue(children.contains("get-estimate"));
        assertTrue(children.contains("mark-estimate"));

        # Verify project action providers exist
        assertTrue(children.contains("create-project"));
        assertTrue(children.contains("update-project"));
        assertTrue(children.contains("get-project"));
        assertTrue(children.contains("mark-project"));

        # Verify item action providers exist
        assertTrue(children.contains("create-item"));
        assertTrue(children.contains("update-item"));
        assertTrue(children.contains("delete-item"));
        assertTrue(children.contains("get-item"));

        # Verify events provider exists
        assertTrue(children.contains("events"));

        # Check invoices child provider
        AbstractDataProvider invoices = prov.getChildProvider("invoices");
        assertEq("invoices", invoices.getName());
        hash<DataProviderInfo> invoicesInfo = invoices.getInfo();
        assertTrue(invoicesInfo.supports_read);
        assertTrue(invoicesInfo.supports_native_search);
        assertTrue(invoicesInfo.has_record);

        # Check contacts child provider
        AbstractDataProvider contacts = prov.getChildProvider("contacts");
        assertEq("contacts", contacts.getName());
        hash<DataProviderInfo> contactsInfo = contacts.getInfo();
        assertTrue(contactsInfo.supports_read);
        assertTrue(contactsInfo.supports_native_search);

        # Check projects child provider
        AbstractDataProvider projects = prov.getChildProvider("projects");
        assertEq("projects", projects.getName());
        hash<DataProviderInfo> projectsInfo = projects.getInfo();
        assertTrue(projectsInfo.supports_read);
        assertTrue(projectsInfo.supports_native_search);

        # Check events child provider
        AbstractDataProvider events = prov.getChildProvider("events");
        assertEq("events", events.getName());
        hash<DataProviderInfo> eventsInfo = events.getInfo();
        assertTrue(eventsInfo.supports_children);

        # Check events child providers (triggers)
        list<string> eventChildren = events.getChildProviderNames();
        assertTrue(eventChildren.contains("new-invoice"));
        assertTrue(eventChildren.contains("new-contact"));
        assertTrue(eventChildren.contains("new-estimate"));
        assertTrue(eventChildren.contains("new-expense"));
        assertTrue(eventChildren.contains("new-item"));
        assertTrue(eventChildren.contains("new-project"));

        # Verify event providers have correct info
        AbstractDataProvider newInvoiceEvent = events.getChildProvider("new-invoice");
        assertEq("new-invoice", newInvoiceEvent.getName());
        hash<DataProviderInfo> newInvoiceInfo = newInvoiceEvent.getInfo();
        assertTrue(newInvoiceInfo.supports_observable);
    }

    #! Data type tests - verify record type definitions
    dataTypeTests() {
        checkJson();
        # Test invoice data type
        ZohoInvoiceDataProvider::ZohoInvoiceInvoiceDataType invoiceType();
        hash<string, AbstractDataField> invoiceFields = invoiceType.getFields();
        assertTrue(invoiceFields.hasKey("invoice_id"));
        assertTrue(invoiceFields.hasKey("customer_id"));
        assertTrue(invoiceFields.hasKey("customer_name"));
        assertTrue(invoiceFields.hasKey("invoice_number"));
        assertTrue(invoiceFields.hasKey("date"));
        assertTrue(invoiceFields.hasKey("due_date"));
        assertTrue(invoiceFields.hasKey("total"));
        assertTrue(invoiceFields.hasKey("balance"));
        assertTrue(invoiceFields.hasKey("status"));
        assertTrue(invoiceFields.hasKey("line_items"));
        assertTrue(invoiceFields.hasKey("currency_code"));
        assertTrue(invoiceFields.hasKey("created_time"));

        # Test line item data type
        ZohoInvoiceDataProvider::ZohoInvoiceLineItemDataType lineItemType();
        hash<string, AbstractDataField> lineItemFields = lineItemType.getFields();
        assertTrue(lineItemFields.hasKey("line_item_id"));
        assertTrue(lineItemFields.hasKey("item_id"));
        assertTrue(lineItemFields.hasKey("name"));
        assertTrue(lineItemFields.hasKey("description"));
        assertTrue(lineItemFields.hasKey("quantity"));
        assertTrue(lineItemFields.hasKey("rate"));
        assertTrue(lineItemFields.hasKey("item_total"));

        # Test contact data type
        ZohoInvoiceDataProvider::ZohoInvoiceContactDataType contactType();
        hash<string, AbstractDataField> contactFields = contactType.getFields();
        assertTrue(contactFields.hasKey("contact_id"));
        assertTrue(contactFields.hasKey("contact_name"));
        assertTrue(contactFields.hasKey("company_name"));
        assertTrue(contactFields.hasKey("email"));
        assertTrue(contactFields.hasKey("status"));

        # Test project data type
        ZohoInvoiceDataProvider::ZohoInvoiceProjectDataType projectType();
        hash<string, AbstractDataField> projectFields = projectType.getFields();
        assertTrue(projectFields.hasKey("project_id"));
        assertTrue(projectFields.hasKey("project_name"));
        assertTrue(projectFields.hasKey("customer_id"));
        assertTrue(projectFields.hasKey("status"));

        # Test create invoice request data type
        ZohoInvoiceDataProvider::ZohoInvoiceCreateInvoiceRequestDataType createInvoiceType();
        hash<string, AbstractDataField> createInvoiceFields = createInvoiceType.getFields();
        assertTrue(createInvoiceFields.hasKey("customer_id"));
        assertTrue(createInvoiceFields.hasKey("date"));
        assertTrue(createInvoiceFields.hasKey("due_date"));
        assertTrue(createInvoiceFields.hasKey("line_items"));
    }

    #! Negative tests - test error handling and invalid inputs
    negativeTests() {
        checkJson();
        ZohoInvoiceDataProvider::ZohoInvoiceDataProvider prov;
        try {
            prov = new ZohoInvoiceDataProvider::ZohoInvoiceDataProvider({
                "subdomain": "zoho",
                "domain": ".com",
                "zohoinvoicerestclient_options": {
                    "oauth2_client_id": "invalid",
                    "oauth2_client_secret": "invalid",
                },
            });
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "OAUTH2-ERROR") {
                testSkip("OAuth2 requires manual authorization - skipping negative tests");
            }
            rethrow;
        }

        # Test getting non-existent child provider
        assertThrows("INVALID-CHILD-PROVIDER", sub() {
            prov.getChildProviderEx("nonexistent");
        });

        # Test invalid child in events provider
        AbstractDataProvider events = prov.getChildProvider("events");
        assertThrows("INVALID-CHILD-PROVIDER", sub() {
            events.getChildProviderEx("invalid-event");
        });

        # Test invalid subdomain
        assertThrows("ZOHOINVOICE-ERROR", sub() {
            new ZohoInvoiceRestClient::ZohoInvoiceRestClient({
                "oauth2_client_id": "x",
                "oauth2_client_secret": "x",
                "subdomain": "invalid",
                "domain": ".com",
            });
        });

        # Test invalid domain
        assertThrows("ZOHOINVOICE-ERROR", sub() {
            new ZohoInvoiceRestClient::ZohoInvoiceRestClient({
                "oauth2_client_id": "x",
                "oauth2_client_secret": "x",
                "subdomain": "zoho",
                "domain": ".invalid",
            });
        });
    }

    #! Corner case tests - edge cases and boundary conditions
    cornerCaseTests() {
        checkJson();
        # Test with different subdomains
        ZohoInvoiceRestClient::ZohoInvoiceRestClient clientZoho({
            "oauth2_client_id": "x",
            "oauth2_client_secret": "x",
            "subdomain": "zoho",
            "domain": ".com",
        }, True);
        assertEq("https://www.zohoapis.com/invoice/v3", clientZoho.getURL());
        assertEq("zoho", clientZoho.getSubdomain());
        assertEq(".com", clientZoho.getDomain());

        ZohoInvoiceRestClient::ZohoInvoiceRestClient clientZohoCloud({
            "oauth2_client_id": "x",
            "oauth2_client_secret": "x",
            "subdomain": "zohocloud",
            "domain": ".com",
        }, True);
        assertEq("https://www.zohoapis.com/invoice/v3", clientZohoCloud.getURL());
        assertEq("zohocloud", clientZohoCloud.getSubdomain());

        # Test with different domains
        ZohoInvoiceRestClient::ZohoInvoiceRestClient clientEU({
            "oauth2_client_id": "x",
            "oauth2_client_secret": "x",
            "subdomain": "zoho",
            "domain": ".eu",
        }, True);
        assertEq("https://www.zohoapis.eu/invoice/v3", clientEU.getURL());
        assertEq(".eu", clientEU.getDomain());

        ZohoInvoiceRestClient::ZohoInvoiceRestClient clientIN({
            "oauth2_client_id": "x",
            "oauth2_client_secret": "x",
            "subdomain": "zoho",
            "domain": ".in",
        }, True);
        assertEq("https://www.zohoapis.in/invoice/v3", clientIN.getURL());

        ZohoInvoiceRestClient::ZohoInvoiceRestClient clientAU({
            "oauth2_client_id": "x",
            "oauth2_client_secret": "x",
            "subdomain": "zoho",
            "domain": ".com.au",
        }, True);
        assertEq("https://www.zohoapis.com.au/invoice/v3", clientAU.getURL());

        ZohoInvoiceRestClient::ZohoInvoiceRestClient clientCA({
            "oauth2_client_id": "x",
            "oauth2_client_secret": "x",
            "subdomain": "zoho",
            "domain": ".ca",
        }, True);
        assertEq("https://www.zohoapis.ca/invoice/v3", clientCA.getURL());

        ZohoInvoiceRestClient::ZohoInvoiceRestClient clientSA({
            "oauth2_client_id": "x",
            "oauth2_client_secret": "x",
            "subdomain": "zoho",
            "domain": ".sa",
        }, True);
        assertEq("https://www.zohoapis.sa/invoice/v3", clientSA.getURL());

        ZohoInvoiceRestClient::ZohoInvoiceRestClient clientJP({
            "oauth2_client_id": "x",
            "oauth2_client_secret": "x",
            "subdomain": "zoho",
            "domain": ".jp",
        }, True);
        assertEq("https://www.zohoapis.jp/invoice/v3", clientJP.getURL());

        # Test default subdomain and domain
        ZohoInvoiceRestClient::ZohoInvoiceRestClient clientDefault({
            "oauth2_client_id": "x",
            "oauth2_client_secret": "x",
        }, True);
        assertEq("https://www.zohoapis.com/invoice/v3", clientDefault.getURL());
        assertEq("zoho", clientDefault.getSubdomain());
        assertEq(".com", clientDefault.getDomain());

        # Test organization_id handling
        ZohoInvoiceRestClient::ZohoInvoiceRestClient clientWithOrg({
            "oauth2_client_id": "x",
            "oauth2_client_secret": "x",
            "organization_id": "12345",
        }, True);
        assertEq("12345", clientWithOrg.getOrganizationId());

        # Test setOrganizationId
        clientWithOrg.setOrganizationId("67890");
        assertEq("67890", clientWithOrg.getOrganizationId());
    }

    #! Connection tests - verify connection scheme registration
    connectionTests() {
        checkJson();
        # Verify connection scheme is registered
        hash<ConnectionSchemeInfo> scheme = ConnectionSchemeCache::getScheme("zohoinvoice");
        assertEq("Zoho Invoice REST Connection", scheme.display_name);
        assertTrue(scheme.short_desc.val());
        assertTrue(scheme.desc.val());

        # Verify required options
        assertEq("subdomain,domain,token|oauth2_auth_url,oauth2_grant_type,oauth2_token_url,"
            "oauth2_client_id,oauth2_client_secret", scheme.required_options);
        assertTrue(scheme.options.hasKey("subdomain"));
        assertTrue(scheme.options.hasKey("domain"));
        assertTrue(scheme.options.hasKey("oauth2_client_id"));
        assertTrue(scheme.options.hasKey("oauth2_client_secret"));
        assertTrue(scheme.options.hasKey("oauth2_refresh_token"));

        # Check subdomain option
        assertEq("zoho", scheme.options.subdomain.default_value);
        assertTrue(scheme.options.subdomain.preselected);
        assertTrue(scheme.options.subdomain.allowed_values.size() == 2);

        # Check domain option
        assertEq(".com", scheme.options.domain.default_value);
        assertTrue(scheme.options.domain.preselected);
        assertTrue(scheme.options.domain.allowed_values.size() == 7);

        # Verify connection can create data provider
        ZohoInvoiceRestClient::ZohoInvoiceRestConnection conn("test", "test connection",
            "zohoinvoice://www.zohoapis.com", {}, {
                "oauth2_client_id": "x",
                "oauth2_client_secret": "x",
                "subdomain": "zoho",
                "domain": ".com",
            });
        assertTrue(conn.hasDataProvider());
        assertEq("ZohoInvoice", conn.getAppName());
        assertEq("zohoinvoice", conn.getType());
    }

    #! Action catalog tests - verify all actions are registered
    actionCatalogTests() {
        checkJson();
        # Get all actions for the Zoho Invoice app
        *list<hash<DataProviderActionInfo>> actions = DataProviderActionCatalog::getActions(
            ZohoInvoiceDataProvider::AppName);
        assertTrue(actions.size() > 0);

        # Verify action count (50 CRUD/actions + 6 triggers = 56)
        assertEq(56, actions.size());

        # Get action names
        list<string> actionNames = map $1.action, actions;

        # Verify invoice actions
        assertTrue(actionNames.contains("create-invoice"));
        assertTrue(actionNames.contains("update-invoice"));
        assertTrue(actionNames.contains("delete-invoice"));
        assertTrue(actionNames.contains("get-invoice"));
        assertTrue(actionNames.contains("list-invoices"));
        assertTrue(actionNames.contains("email-invoice"));
        assertTrue(actionNames.contains("mark-invoice"));

        # Verify recurring invoice actions
        assertTrue(actionNames.contains("create-recurring-invoice"));
        assertTrue(actionNames.contains("update-recurring-invoice"));
        assertTrue(actionNames.contains("get-recurring-invoice"));
        assertTrue(actionNames.contains("list-recurring-invoices"));
        assertTrue(actionNames.contains("mark-recurring-invoice"));

        # Verify contact actions
        assertTrue(actionNames.contains("create-contact"));
        assertTrue(actionNames.contains("update-contact"));
        assertTrue(actionNames.contains("delete-contact"));
        assertTrue(actionNames.contains("get-contact"));
        assertTrue(actionNames.contains("list-contacts"));
        assertTrue(actionNames.contains("mark-contact"));

        # Verify expense actions
        assertTrue(actionNames.contains("create-expense"));
        assertTrue(actionNames.contains("update-expense"));
        assertTrue(actionNames.contains("delete-expense"));
        assertTrue(actionNames.contains("get-expense"));
        assertTrue(actionNames.contains("list-expenses"));

        # Verify recurring expense actions
        assertTrue(actionNames.contains("create-recurring-expense"));
        assertTrue(actionNames.contains("update-recurring-expense"));
        assertTrue(actionNames.contains("delete-recurring-expense"));
        assertTrue(actionNames.contains("get-recurring-expense"));
        assertTrue(actionNames.contains("list-recurring-expenses"));

        # Verify payment actions
        assertTrue(actionNames.contains("create-payment"));
        assertTrue(actionNames.contains("update-payment"));
        assertTrue(actionNames.contains("delete-payment"));
        assertTrue(actionNames.contains("get-payment"));
        assertTrue(actionNames.contains("list-payments"));
        assertTrue(actionNames.contains("refund-payment"));

        # Verify estimate actions
        assertTrue(actionNames.contains("create-estimate"));
        assertTrue(actionNames.contains("update-estimate"));
        assertTrue(actionNames.contains("delete-estimate"));
        assertTrue(actionNames.contains("get-estimate"));
        assertTrue(actionNames.contains("list-estimates"));
        assertTrue(actionNames.contains("mark-estimate"));

        # Verify project actions
        assertTrue(actionNames.contains("create-project"));
        assertTrue(actionNames.contains("update-project"));
        assertTrue(actionNames.contains("get-project"));
        assertTrue(actionNames.contains("list-projects"));
        assertTrue(actionNames.contains("mark-project"));

        # Verify item actions
        assertTrue(actionNames.contains("create-item"));
        assertTrue(actionNames.contains("update-item"));
        assertTrue(actionNames.contains("delete-item"));
        assertTrue(actionNames.contains("get-item"));
        assertTrue(actionNames.contains("list-items"));

        # Verify trigger actions
        assertTrue(actionNames.contains(ZohoInvoiceDataProvider::EVENT_NEW_INVOICE));
        assertTrue(actionNames.contains(ZohoInvoiceDataProvider::EVENT_NEW_CONTACT));
        assertTrue(actionNames.contains(ZohoInvoiceDataProvider::EVENT_NEW_ESTIMATE));
        assertTrue(actionNames.contains(ZohoInvoiceDataProvider::EVENT_NEW_EXPENSE));
        assertTrue(actionNames.contains(ZohoInvoiceDataProvider::EVENT_NEW_ITEM));
        assertTrue(actionNames.contains(ZohoInvoiceDataProvider::EVENT_NEW_PROJECT));

        # Verify create-invoice action has ref_data for customers
        *hash<DataProviderActionInfo> createInvoiceAction = DataProviderActionCatalog::getAppAction(
            ZohoInvoiceDataProvider::AppName, "create-invoice");
        assertTrue(exists createInvoiceAction, "create-invoice action should exist");
        assertTrue(createInvoiceAction.options.customer_id.ref_data == "customers");

        # Verify event actions have correct action_code
        *hash<DataProviderActionInfo> newInvoiceAction = DataProviderActionCatalog::getAppAction(
            ZohoInvoiceDataProvider::AppName, ZohoInvoiceDataProvider::EVENT_NEW_INVOICE);
        assertTrue(exists newInvoiceAction, "new-invoice action should exist");
        assertEq(DPAT_EVENT, newInvoiceAction.action_code);
        assertEq(ZohoInvoiceDataProvider::EVENT_NEW_INVOICE, newInvoiceAction.action_val);
    }

    #! Integration tests - require Zoho Invoice credentials
    integrationTests() {
        checkJson();
        if (!client) {
            testSkip("No Zoho Invoice credentials provided (use -i, -s, -r, -o options or env vars)");
            return;
        }

        # Test API connectivity
        testApiConnectivity();

        # Test reference data
        testReferenceData();

        # Test contacts provider
        testContactsProvider();

        # Test items provider
        testItemsProvider();

        # Test invoices provider (requires contact and item)
        if (testContactId && testItemId) {
            testInvoicesProvider();
        }

        # Test data integrity
        if (testContactId && testItemId) {
            testInvoiceDataIntegrity();
        }

        # Test projects provider
        if (testContactId) {
            testProjectsProvider();
        }

        # Test estimates provider
        if (testContactId) {
            testEstimatesProvider();
        }

        # Test expenses provider
        testExpensesProvider();

        # Test new optional fields
        testCreateContactWithOptionalFields();
        testCreateItemWithOptionalFields();
        testCreateExpenseWithOptionalFields();
        testCreateProjectWithOptionalFields();
        testCreateEstimateWithOptionalFields();
        testCreateInvoiceWithOptionalFields();
        testUpdateActionsWithOptionalFields();
        testListFiltersWithOptionalFields();

        # Cleanup test data
        cleanup();
    }

