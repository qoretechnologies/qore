    #! Test creating a contact with all optional fields
    private testCreateContactWithOptionalFields() {
        if (m_options.verbose) {
            printf("\n--- Testing Create Contact With Optional Fields ---\n");
        }

        ZohoInvoiceDataProvider::ZohoInvoiceDataProvider prov(client);
        AbstractDataProvider createContactProvider = prov.getChildProvider("create-contact");
        string testName = sprintf("Full Contact Test %s", now_us().format("YYYYMMDDHHmmss"));

        try {
            # Create contact with all optional fields
            hash<auto> contactData = {
                "contact_name": testName,
                "company_name": "Test Company Inc",
                "email": "fulltest@example.com",
                "phone": "+1-555-0100",
                "mobile": "+1-555-0101",
                "website": "https://example.com",
                "billing_address": {
                    "street": "123 Test Street",
                    "city": "Test City",
                    "state": "CA",
                    "zip": "12345",
                    "country": "USA",
                },
                "payment_terms": 30,
                "notes": "Test contact with all fields",
            };

            hash<auto> newContact = createContactProvider.doRequest(contactData);

            if (newContact.contact_id) {
                assertTrue(newContact.contact_id.val(), "Contact should be created with an ID");

                # CRITICAL: Verify data persistence - fetch back and check all fields
                AbstractDataProvider getContactProvider = prov.getChildProvider("get-contact");
                hash<auto> fetchedContact = getContactProvider.doRequest({
                    "contact_id": newContact.contact_id,
                });

                # Verify all fields persisted correctly
                assertEq(testName, fetchedContact.contact_name, "contact_name should persist");
                assertEq("Test Company Inc", fetchedContact.company_name, "company_name should persist");
                assertEq("fulltest@example.com", fetchedContact.email, "email should persist");

                if (m_options.verbose) {
                    printf("Created and verified contact with all fields: %s\n", newContact.contact_id);
                    printf("  - Company: %s\n", fetchedContact.company_name);
                    printf("  - Email: %s\n", fetchedContact.email);
                    printf("  - Phone: %s\n", fetchedContact.phone ?? "N/A");
                    printf("  - Payment Terms: %s\n", fetchedContact.payment_terms ?? "N/A");
                }

                # Mark as inactive for cleanup
                try {
                    AbstractDataProvider markContactProvider = prov.getChildProvider("mark-contact");
                    markContactProvider.doRequest({
                        "contact_id": newContact.contact_id,
                        "status": "inactive",
                    });
                } catch (hash<ExceptionInfo> ex) {
                    if (m_options.verbose) {
                        printf("Cleanup failed: %s\n", ex.desc);
                    }
                }
            }
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("Create contact with optional fields failed: %s: %s\n", ex.err, ex.desc);
            }
            rethrow;
        }

        if (m_options.verbose) {
            printf("--- Create Contact With Optional Fields test completed ---\n");
        }
    }

