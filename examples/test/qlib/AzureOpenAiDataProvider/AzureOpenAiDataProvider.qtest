%modern


%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires json
%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/Mime.qm
%requires ../../../../qlib/HttpServerUtil.qm
%requires ../../../../qlib/HttpServer.qm
%requires ../../../../qlib/HttpServerAsyncIo
%requires ../../../../qlib/ConnectionProvider
%requires ../../../../qlib/DataProvider
%requires ../../../../qlib/RestClientIo.qm
%requires ../../../../qlib/AzureAuth.qm
%requires ../../../../qlib/OpenAiRestClient.qm
%requires ../../../../qlib/AzureOpenAiRestClient.qm
%requires ../../../../qlib/AzureOpenAiDataProvider

%exec-class AzureOpenAiDataProviderTest

class FakeAzureHandler inherits AbstractHttpRequestHandler {
    public {
        string last_path = "";
        string last_api_key_header = "";
        string last_authorization = "";
        *hash<auto> last_body;
    }
    hash handleRequest(hash cx, hash hdr, *data body) {
        last_path = cx.raw_path;
        last_api_key_header = hdr."api-key" ?? "";
        last_authorization = hdr."authorization" ?? "";
        string body_str = body ? (body.typeCode() == NT_BINARY
            ? body.toString("UTF-8") : body) : "";
        last_body = body_str ? parse_json(body_str) : NOTHING;
        if (last_api_key_header != "test-azure-key") {
            return makeResponse({"Content-Type": MimeTypeJson}, 401,
                make_json({"error": {"code": "Unauthorized", "message": "Invalid API key"}}));
        }
        if (last_path == "/openai/v1/models" || last_path == "/api/projects/qore-tests/openai/v1/models") {
            return makeResponse({"Content-Type": MimeTypeJson}, 200,
                make_json({"object": "list", "data": ({"id": "gpt-4.1-mini", "object": "model"},)}));
        }
        if (last_path == "/api/projects/qore-tests/openai/v1/conversations?limit=1") {
            return makeResponse({"Content-Type": MimeTypeJson}, 200,
                make_json({"object": "list", "data": (), "has_more": False}));
        }
        if (last_path =~ /\/chat\/completions/) {
            return makeResponse({"Content-Type": MimeTypeJson}, 200, make_json({
                "id": "chatcmpl-fake",
                "object": "chat.completion",
                "created": 1700000000,
                "model": "gpt-4o-2024-08-06",
                "choices": (
                    {"index": 0,
                     "message": {"role": "assistant", "content": "Hello from Azure OpenAI"},
                     "finish_reason": "stop"},
                ),
                "usage": {"prompt_tokens": 7, "completion_tokens": 5, "total_tokens": 12},
            }));
        }
        if (last_path =~ /\/embeddings/) {
            return makeResponse({"Content-Type": MimeTypeJson}, 200, make_json({
                "object": "list",
                "data": ({"index": 0, "object": "embedding",
                          "embedding": (0.1, 0.2, 0.3)},),
                "model": "text-embedding-3-small",
                "usage": {"prompt_tokens": 3, "total_tokens": 3},
            }));
        }
        return makeResponse(404, "unknown azure path: " + last_path);
    }
}

public class AzureOpenAiDataProviderTest inherits QUnit::Test {
    public {
        const MyOpts = Opts + {
            "conn": "c,connection=s",
        };

        const OptionColumn = 22;
    }

    private {
        HttpServer http;
        int port;
        FakeAzureHandler handler;
        *string conn_name;
    }

    constructor() : Test("AzureOpenAiDataProvider Test", "1.0", \ARGV, MyOpts) {
        conn_name = m_options.conn ?? ENV.AZURE_OPENAI_CONNECTION;

        addTestCase("factory + provider info",            \factoryTest());
        addTestCase("app registered with logo + group",   \appTest());
        addTestCase("chat-completion + embedding actions registered", \actionsTest());
        addTestCase("ChatCompletion action end-to-end",   \chatCompletionTest());
        addTestCase("Embedding action end-to-end",        \embeddingTest());
        addTestCase("URL routes through deployment + api-version",
            \deploymentPathTest());
        addTestCase("api-key auth header sent on chat call", \apiKeyHeaderTest());
        addTestCase("child providers discoverable",       \childrenTest());
        addTestCase("root children preserve authentication and deployment names", \childRequestTest());
        addTestCase("connections expose Azure actions and authenticated pings", \connectionTest());
        addTestCase("Foundry project paths survive constructors, copies, and pings", \projectPathTest());
        addTestCase("sync, async, and copied transports preserve authentication", \transportTest());
        addTestCase("connection authentication validates mode-specific credentials", \connectionValidationTest());

        setupServer();

        # Live test requires a real Azure OpenAI connection plus the
        # AZURE_OPENAI_DEPLOYMENT env var naming a deployment in the account.
        # Uses one short, token-bounded request to the configured deployment.
        if (conn_name) {
            addTestCase("live: authentication, inference, and temporary file lifecycle",
                \liveAzureOpenAiTest());
        }
        set_return_value(main());
    }

    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-c,--connection=ARG",
            "set the Azure OpenAI connection name; without it (and without "
            "the AZURE_OPENAI_CONNECTION env var) the live test is skipped",
            OptionColumn);
    }

    #! Exercises authenticated v1 actions against explicitly configured Azure deployments.
    /** Uses bounded inference requests and removes temporary uploads even if an assertion fails.
    */
    private liveAzureOpenAiTest() {
        *string deployment = ENV.AZURE_OPENAI_DEPLOYMENT;
        if (!deployment.val()) {
            testSkip("AZURE_OPENAI_DEPLOYMENT env var is required to name a "
                "deployment in the account");
        }

        if (!ENV.AZURE_OPENAI_API_KEY.val() || !ENV.AZURE_OPENAI_ENDPOINT.val()) {
            testSkip("AZURE_OPENAI_API_KEY and AZURE_OPENAI_ENDPOINT are required for standalone live tests");
        }
        AzureOpenAiRestConnection conn({"name": conn_name, "url": ENV.AZURE_OPENAI_ENDPOINT,
            "opts": {"api_key": ENV.AZURE_OPENAI_API_KEY}});
        hash<auto> ping = conn.ping(True);
        assertTrue(ping.ok, sprintf("Azure OpenAI connection ping failed: %s",
            ping.info ?? "no info"));

        AbstractDataProvider prov = conn.getDataProvider();
        AbstractDataProvider cc = prov.getChildProvider("chat-completion");
        auto resp = cc.doRequest({
            "deployment": deployment,
            "messages": ({"role": "user", "content": "Say hi in one word."},),
            "max_tokens": 16,
        });
        assertTrue(resp.choices[0].message.content.val(),
            "Azure OpenAI returned assistant text");
        assertTrue(resp.usage.total_tokens > 0,
            "Azure OpenAI reported a positive total-token count");

        auto response = prov.getChildProvider("create-response").doRequest({"model": deployment,
            "input": "Return JSON with ok set to true.", "store": False, "max_output_tokens": 32,
            "text": {"format": {"type": "json_schema", "name": "result", "schema": {}, "strict": False}}});
        assertTrue(response.output.size() > 0);
        assertTrue(response.usage.total_tokens > 0);
        if (ENV.AZURE_OPENAI_EMBEDDING_DEPLOYMENT.val()) {
            auto embedding = prov.getChildProvider("embedding").doRequest({
                "deployment": ENV.AZURE_OPENAI_EMBEDDING_DEPLOYMENT, "input": "Qore test", "dimensions": 8});
            assertEq(8, embedding.data[0].embedding.size());
        }
        foreach bool expiration in (False, True) {
            binary bytes = binary(make_json({"custom_id": "fixture", "method": "POST",
                "url": "/chat/completions", "body": {"model": deployment,
                    "messages": ({"role": "user", "content": "OK"},)}}) + "\n");
            hash<auto> options = {"purpose": "batch", "file": {"name": "qore-5425.jsonl", "content": bytes}};
            if (expiration) {
                options.expires_after = {"anchor": "created_at", "seconds": 259200};
            }
            auto file = prov.getChildProvider("create-file").doRequest(options);
            string id = file.id;
            on_exit {
                auto deleted = prov.getChildProvider("delete-file").doRequest({"file_id": id});
                assertTrue(deleted.deleted, "temporary upload cleanup");
            }
            auto metadata = prov.getChildProvider("get-file").doRequest({"file_id": id});
            assertEq("qore-5425.jsonl", metadata.filename);
            if (expiration) {
                assertEq(259200, int(get_epoch_seconds(file.expires_at) - get_epoch_seconds(file.created_at)));
            }
            auto content = prov.getChildProvider("download-file").doRequest({"file_id": id});
            assertEq(bytes.toString(), content.toString());
        }
        AzureOpenAiRestConnection invalid({"name": "invalid", "url": ENV.AZURE_OPENAI_ENDPOINT,
            "opts": {"api_key": "qore-invalid-key"}});
        *hash<ExceptionInfo> error;
        try {
            invalid.ping(True);
        } catch (hash<ExceptionInfo> ex) {
            error = ex;
        }
        assertTrue(exists error);
        assertEq(401, error.arg.status_code);
    }

    private setupServer() {
        Logger logger("test", LoggerLevel::getLevelInfo());
        http = new HttpServer(<HttpServerOptionInfo>{"logger": logger});
        handler = new FakeAzureHandler();
        http.setDefaultHandler("azure", handler);
        port = http.addListener(<HttpListenerOptionInfo>{"node": "localhost", "service": 0}).port;
    }

    globalTearDown() {
        delete http;
    }

    private factoryTest() {
        AbstractDataProviderFactory f = DataProvider::getFactoryEx("azure-openai");
        assertEq("azure-openai", f.getName());
        hash<DataProviderInfo> pi = f.getProviderInfo();
        assertTrue(pi.supports_children);
    }

    private appTest() {
        hash<DataProviderAppInfo> app =
            DataProviderActionCatalog::getApp(AzureOpenAiDataProvider::AppName);
        assertEq("Azure OpenAI", app.display_name);
        assertEq("azure-openai", app.scheme);
        assertEq("azure-logo.svg", app.logo_file_name);
        assertTrue(app.logo.val(), "logo content was loaded from the SVG file");
        assertTrue(inlist(DataProvider::AppGroup::AiLlm, app.groups));
    }

    private actionsTest() {
        list<hash<DataProviderActionInfo>> actions =
            DataProviderActionCatalog::getActionsEx(AzureOpenAiDataProvider::AppName);
        list<string> names = map $1.action, actions;
        assertTrue(inlist("chat-completion", names));
        assertTrue(inlist("embedding", names));

        hash<DataProviderActionInfo> chat = DataProviderActionCatalog::getAppActionEx(
            AzureOpenAiDataProvider::AppName, "chat-completion");
        assertEq(DPAT_API, chat.action_code);
        assertEq("/chat-completion", chat.path);
        assertTrue(chat.options.deployment.required);
        assertTrue(chat.options.messages.required);
        foreach string action_name in (("chat-completion", "embedding")) {
            hash<DataProviderActionInfo> action = DataProviderActionCatalog::getAppActionEx(
                AzureOpenAiDataProvider::AppName, action_name);
            assertEq(NT_BOOLEAN, action.mutates_state.typeCode(),
                action_name + " publishes a typed mutation effect");
            assertEq(action_name == "chat-completion", DataProviderActionCatalog::actionMutatesState(action),
                "chat can store completions; embedding only returns vectors");
        }
    }

    private chatCompletionTest() {
        AzureOpenAiChatCompletionDataProvider p(buildOptions());
        auto resp = p.doRequest({
            "deployment": "gpt-4o",
            "messages": (
                {"role": "user", "content": "ping"},
            ),
            "max_tokens": 50,
        });
        assertEq("Hello from Azure OpenAI", resp.choices[0].message.content);
        assertEq("stop", resp.choices[0].finish_reason);
        assertEq(12, resp.usage.total_tokens);
        assertEq("user", handler.last_body.messages[0].role);
        # max_tokens forwarded
        assertEq(50, handler.last_body.max_tokens);
    }

    private embeddingTest() {
        AzureOpenAiEmbeddingDataProvider p(buildOptions());
        auto resp = p.doRequest({
            "deployment": "text-embedding-3-small",
            "input": "embed me",
        });
        assertEq((0.1, 0.2, 0.3), resp.data[0].embedding);
        assertEq("embed me", handler.last_body.input);
    }

    private deploymentPathTest() {
        AzureOpenAiChatCompletionDataProvider p(buildOptions());
        p.doRequest({
            "deployment": "my-gpt4o-deploy",
            "messages": ({"role": "user", "content": "x"},),
        });
        assertTrue(handler.last_path =~ /\/openai\/deployments\/my-gpt4o-deploy\/chat\/completions/,
            sprintf("expected deployment-routed path, got %y", handler.last_path));
        assertTrue(handler.last_path =~ /api-version=2024-10-21/,
            "api-version query param must be present");
    }

    private apiKeyHeaderTest() {
        AzureOpenAiChatCompletionDataProvider p(buildOptions());
        p.doRequest({
            "deployment": "gpt-4o",
            "messages": ({"role": "user", "content": "x"},),
        });
        assertEq("test-azure-key", handler.last_api_key_header);
    }

    private childrenTest() {
        AzureOpenAiDataProvider::AzureOpenAiDataProvider root(buildOptions());
        list<string> names = root.getChildProviderNames();
        assertTrue(inlist("chat-completion", names));
        assertTrue(inlist("embedding", names));
    }

    private hash<auto> connectionConfig(*string key) {
        return {"name": "azure-test", "url": "http://localhost:" + port,
            "opts": {"api_key": key ?? "test-azure-key", "azure_api_version": "2024-12-01-preview"}};
    }

    private childRequestTest() {
        AzureOpenAiDataProvider::AzureOpenAiDataProvider root(buildOptions()
            + {"azure_api_version": "2024-12-01-preview"});
        AbstractDataProvider child = root.getChildProvider("chat-completion");
        auto response = child.doRequest({"deployment": "custom-chat",
            "messages": ({"role": "user", "content": "hello"},)});
        assertEq("Hello from Azure OpenAI", response.choices[0].message.content);
        assertEq("test-azure-key", handler.last_api_key_header);
        assertEq("/openai/v1/chat/completions?api-version=v1", handler.last_path);
        assertEq("custom-chat", handler.last_body.model);
        assertFalse(handler.last_body.hasKey("deployment"));
        child = root.getChildProvider("embedding");
        response = child.doRequest({"deployment": "custom-embedding", "input": "hello"});
        assertEq((0.1, 0.2, 0.3), response.data[0].embedding);
        assertEq("test-azure-key", handler.last_api_key_header);
    }

    private connectionTest() {
        AzureOpenAiRestConnection conn(connectionConfig());
        assertEq("AzureOpenAI", conn.getAppName());
        assertEq("AzureOpenAI", conn.getInfo().app);
        assertTrue(conn.ping(True).ok);
        assertEq("/openai/v1/models", handler.last_path);
        assertEq("test-azure-key", handler.last_api_key_header);
        AbstractDataProvider root = conn.getDataProvider();
        assertEq("azure-openai", root.getName());
        auto response = root.getChildProvider("chat-completion").doRequest({"deployment": "custom-chat",
            "messages": ({"role": "user", "content": "hello"},)});
        assertEq("Hello from Azure OpenAI", response.choices[0].message.content);
        assertEq("/openai/v1/chat/completions?api-version=v1", handler.last_path);
        assertEq("custom-chat", handler.last_body.model);
        assertFalse(handler.last_body.hasKey("deployment"));
        AzureOpenAiRestConnection invalid(connectionConfig("invalid-key"));
        assertThrows("REST-RESPONSE-ERROR", sub () { invalid.ping(True); });
    }

    private projectPathTest() {
        string project = "/api/projects/qore-tests";
        foreach string suffix in ("", "/", "/openai", "/openai/v1", "/openai/v1/") {
            hash<auto> config = connectionConfig();
            config.url += project + suffix;
            AzureOpenAiRestConnection conn(config);
            assertTrue(conn.ping(True).ok);
            assertEq(project + "/openai/v1/conversations?limit=1", handler.last_path);
            RestClientIo::RestClientIo original({"url": config.url,
                "headers": {"api-key": "test-azure-key"}, "data": "json"});
            *string original_path = original.getConnectionPath();
            list<AbstractDataProvider> roots = (
                new AzureOpenAiDataProvider::AzureOpenAiDataProvider(original),
                new AzureOpenAiDataProvider::AzureOpenAiDataProvider({"restclient": original}),
                new AzureOpenAiDataProvider::AzureOpenAiDataProvider({"url": config.url,
                    "api_key": "test-azure-key"}),
                conn.getDataProvider(),
            );
            foreach AbstractDataProvider root in (roots) {
                auto response = root.getChildProvider("chat-completion").doRequest({
                    "deployment": "test", "messages": ({"role": "user", "content": "hello"},)});
                assertEq("Hello from Azure OpenAI", response.choices[0].message.content);
                assertEq(project + "/openai/v1/chat/completions?api-version=v1", handler.last_path);
            }
            assertEq(original_path, original.getConnectionPath(), "provider copies preserve the caller's client");
            foreach AbstractRestClient client in (conn.get(), conn.getAsync()) {
                assertEq(project, client.getConnectionPath());
                assertEq(200, client.restGet("/openai/v1/models").status_code);
                assertEq(project + "/openai/v1/models", handler.last_path);
                AbstractRestClient copy = client.copyWithUrl(config.url);
                assertEq(project, copy.getConnectionPath());
                assertEq(200, copy.restGet("/openai/v1/models").status_code);
                assertEq(project + "/openai/v1/models", handler.last_path);
            }
        }
        foreach string path in ("", "/", "/openai/v1", "/api/projects", "/api/projects/name/unrelated") {
            assertFalse(exists AzureOpenAiRestClientBase::getProjectPath("https://example.com" + path));
        }
    }

    private transportTest() {
        AzureOpenAiRestConnection conn(connectionConfig());
        AbstractRestClient sync = conn.get(False);
        assertTrue(sync instanceof AzureOpenAiRestClient::AzureOpenAiRestClient);
        assertEq("gpt-4.1-mini", sync.restGet("/openai/v1/models").body.data[0].id);
        AbstractRestClient sync_copy = sync.copyWithUrl(sync.getUrl());
        assertTrue(sync_copy instanceof AzureOpenAiRestClient::AzureOpenAiRestClient);
        assertEq(200, sync_copy.restGet("/openai/v1/models").status_code);
        AzureOpenAiRestClientIo async = cast<AzureOpenAiRestClientIo>(conn.getAsync(False));
        auto response = async.restDoRequestAsync("GET", "/openai/v1/models", NOTHING, NOTHING).get();
        assertEq(200, response.status_code);
        AbstractRestClient copy = async.copyWithUrl(async.getUrl());
        assertTrue(copy instanceof AzureOpenAiRestClientIo);
        assertEq(200, copy.restDoRawRequest("GET", "/openai/v1/models", NOTHING, NOTHING).status_code);
        async.setConnectionPath("/unchanged");
        AzureOpenAiDataProvider::AzureOpenAiDataProvider root(async);
        assertEq("/unchanged", async.getConnectionPath(), "constructing a provider preserves the caller's path");
        assertEq(200, root.getRestClient().restGet("/openai/v1/models").status_code);
    }

    private connectionValidationTest() {
        hash<ConnectionSchemeInfo> scheme = AzureOpenAiRestConnection::ConnectionScheme;
        foreach string name in (("api_key", "azure_tenant_id", "azure_client_id", "azure_client_secret")) {
            assertTrue(scheme.options{name}.required, name + " is marked required for its authentication mode");
            assertTrue(scheme.options{name}.depends_on.val());
        }
        assertTrue(scheme.options.api_key.sensitive);
        assertTrue(scheme.options.azure_client_secret.sensitive);
        assertFalse(scheme.options.azure_managed_identity_client_id.required);
        foreach string key in (("", " ")) {
            hash<auto> cfg = connectionConfig();
            cfg.opts.api_key = key;
            assertThrows("AZURE-OPENAI-AUTH-ERROR", sub () { new AzureOpenAiRestConnection(cfg); });
        }
        hash<auto> cfg = connectionConfig();
        remove cfg.opts.api_key;
        assertThrows("AZURE-OPENAI-AUTH-ERROR", sub () { new AzureOpenAiRestConnection(cfg); });
        cfg.opts.azure_auth_mode = "entra_client_credentials";
        cfg.opts.azure_client_id = "client";
        cfg.opts.azure_client_secret = "secret";
        assertThrows("AZURE-OPENAI-AUTH-ERROR", sub () { new AzureOpenAiRestConnection(cfg); });
        cfg.opts.azure_tenant_id = "tenant";
        AzureOpenAiRestConnection entra(cfg);
        assertTrue(entra.getExtendedInfoAsData().oauth2_client_credentials);
        cfg.opts = {"azure_auth_mode": "entra_managed_identity"};
        AzureOpenAiRestConnection managed(cfg);
        assertFalse(managed.getExtendedInfoAsData().oauth2_client_credentials);
    }

    private hash<auto> buildOptions() {
        return {
            "url": "http://localhost:" + port,
            "azure_api_version": "2024-10-21",
            "azure_auth_mode": "api_key",
            "api_key": "test-azure-key",
        };
    }
}
