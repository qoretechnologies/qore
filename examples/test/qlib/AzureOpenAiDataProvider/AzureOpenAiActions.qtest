%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires json
%requires QUnit
%requires AzureOpenAiDataProvider
%requires RestSchemaActions
%requires Mime
%exec-class AzureActionsTest

class AzureActionFixtureClient inherits RestClientIo::RestClientIo {
    public {
        string method;
        string path;
        *data raw;
        *hash<auto> last_headers;
        auto response = {};
        int requests = 0;
    }
    constructor() : RestClientIo({"url": "https://resource.example.com", "data_type": "auto", "headers": {"accept": "application/json"}}) {
    }
    RestClient::AbstractRestClient copyWithUrl(string url) {
        return self;
    }
    #! Schema dispatch now supplies an explicit target; retain this mock's response recorder.
    hash<RestClient::RestResponseInfo> restDoRawRequestTarget(string method,
            hash<RestClient::RestRequestTarget> target, *data body, *hash<auto> hdr) {
        return restDoRawRequest(method, target.path, body, hdr);
    }

    hash<RestClient::RestResponseInfo> restDoRawRequest(string method, string path, *data body, *hash<auto> hdr) {
        self.method = method;
        self.path = path;
        raw = body;
        last_headers = hdr;
        ++requests;
        return <RestClient::RestResponseInfo>{"status_code": 200, "body": response};
    }
    hash<RestClient::RestResponseInfo> restDoRequest(string method, string path, auto body, *hash<auto> hdr) {
        self.method = method;
        self.path = path;
        ++requests;
        return <RestClient::RestResponseInfo>{"status_code": 200, "body": response};
    }
}

class AzureActionsTest inherits QUnit::Test {
    private {
        list<hash<auto>> fixtures = parse_json(File::readTextFile(get_script_dir() + "/requests.json"));
        RestSchemaActionSet actions = AzureOpenAiSchema::getActionSet();
    }
    constructor() : Test("Azure OpenAI v1 actions", "1.1", \ARGV) {
        addTestCase("exact independent action inventory and metadata", \inventoryTest());
        addTestCase("deferred registration preserves the complete inventory", \deferredTest());
        addTestCase("pinned schema agrees with every manifest entry", \driftTest());
        foreach hash<auto> fixture in (fixtures) {
            hash<auto> test_fixture = fixture;
            addTestCase("request: " + fixture.action, sub () { requestTest(test_fixture); });
        }
        addTestCase("empty values and raw value objects survive transport and serialization", \valuesTest());
        addTestCase("invalid values stop before transport", \negativeTest());
        addTestCase("resource references retain IDs and display names", \referenceTest());
        addTestCase("resource timestamps are dates, including null and epoch zero", \timestampTest());
        addTestCase("multipart media and file expiration preserve bytes and structure", \multipartTest());
        addTestCase("audio media choices and typed responses match Azure's contract", \audioFormatsTest());
        addTestCase("empty conversation item lists retain the required envelope", \conversationItemsTest());
        addTestCase("fresh recursive catalogs match all twelve locales", \translationTest());
        set_return_value(main());
    }
    private inventoryTest() {
        list<string> expected = sort((map $1.action, fixtures) + (AbstractDataProvider::GenericApiCallActionName,));
        assertEq(100, expected.size());
        foreach int pass in (0..1) {
            if (pass) {
                foreach hash<DataProviderActionInfo> action in (actionInfoList("AzureOpenAI")) {
                    if (action.action == "embedding") {
                        action.mutates_state = False;
                    }
                    DataProviderActionCatalog::registerAction(action);
                }
            }
            list<hash<DataProviderActionInfo>> actual = DataProviderActionCatalog::getActions("AzureOpenAI");
            assertEq(expected, sort(map $1.action, actual));
            assertEq((), DataProviderActionCatalog::getInitializationFailures(("AzureOpenAI",)));
            foreach hash<DataProviderActionInfo> action in (actual) {
                assertTrue(action.display_name.val(), action.action);
                assertTrue(action.short_desc.val() && action.short_desc.size() < 80, action.action);
                assertTrue(action.desc.val(), action.action);
                assertFalse(exists action.cls, action.action);
                if (action.action == AbstractDataProvider::GenericApiCallActionName) {
                    continue;
                }
                RestSchemaActionOperation operation = AzureOpenAiSchema::getOperationEx(action.action);
                assertEq(sort(keys operation.getRequestFields()), sort(keys action.options), action.action);
                assertEq(exists operation.getResponseType(), exists action.output_type, action.action);
            }
        }
    }
    private deferredTest() {
        string alias = "AzureOpenAI-DeferredFixture";
        hash<DataProviderAppInfo> app = DataProviderActionCatalog::getApp("AzureOpenAI");
        app.name = alias;
        app.dynamic = True;
        DataProviderActionCatalog::registerPendingApp(alias, sub () {
            DataProviderActionCatalog::registerApp(app);
            foreach hash<DataProviderActionInfo> action in (actionInfoList(alias)) {
                hash<DataProviderActionInfo> deferred = action;
                DataProviderActionCatalog::registerPendingAppAction(alias, action.action, sub () {
                    DataProviderActionCatalog::registerAction(deferred);
                });
            }
        });
        on_exit DataProviderActionCatalog::deregisterDynamicApp(alias);
        list<string> expected = sort((map $1.action, fixtures) + (AbstractDataProvider::GenericApiCallActionName,));
        DataProviderActionCatalog::getApp(alias);
        assertEq(expected, sort(map $1.action, DataProviderActionCatalog::getActions(alias)));
        assertEq((), DataProviderActionCatalog::getInitializationFailures((alias,)));
        list<hash<DataProviderDiscoveryExpectedIdentityInfo>> inventory
            = map <DataProviderDiscoveryExpectedIdentityInfo>{"app": alias, "action": $1}, expected;
        DataProviderDiscoverySession session = DataProviderActionCatalog::beginDiscovery(inventory, (alias,));
        DataProviderActionCatalog::collectDiscoveryExpectedInventory(session);
        DataProviderQualifiedDiscovery result = DataProviderActionCatalog::sealDiscovery(session);
        assertTrue(result.getReport().complete);
        assertEq((), result.getReport().failures);
    }

    private static list<hash<DataProviderActionInfo>> actionInfoList(string app) {
        list<hash<DataProviderActionInfo>> result = ();
        foreach RestSchemaActionSet set in (AzureOpenAiSchema::getActionSets()) {
            result += set.getActionInfoList(app);
        }
        return result;
    }

    private driftTest() {
        assertEq((), RestSchemaDrift::compare(actions, AzureOpenAiSchema::getSchema()));
        assertEq("/openai/v1", AzureOpenAiSchema::getSchema().getBasePath());
        assertEq((), RestSchemaDrift::compare(AzureOpenAiSchema::getActionSets()[1],
            AzureOpenAiSchema::getAudioSchema()));
        assertEq("/openai", AzureOpenAiSchema::getAudioSchema().getBasePath());
        assertEq("2025-04-01-preview", AzureOpenAiSchema::AudioProvenance.api_version);
        assertEq(118, AzureOpenAiSchema::Provenance.source_operations);
        assertRegex("^[a-f0-9]{64}$", AzureOpenAiSchema::Provenance.source_sha256);
    }
    private requestTest(hash<auto> fixture) {
        AzureActionFixtureClient fake();
        AzureOpenAiDataProvider::AzureOpenAiDataProvider root(fake);
        root.getChildProvider(fixture.action).doRequest(fixture.request);
        assertEq(1, fake.requests, fixture.action);
        assertEq(fixture.method, fake.method, fixture.action);
        string path = (fixture.action == "create-transcription" || fixture.action == "create-translation"
            ? "/openai" : "/openai/v1") + fixture.path;
        foreach string name in ((path =~ x/\{([^}]+)\}/g)) {
            # Path placeholder names are wire names; video_id is the curated action name.
            path = replace(path, "{" + name + "}", fixture.request{name == "video-id" ? "video_id" : (name == "deployment-id" ? "model" : name)});
        }
        assertEq(path, fake.path.split("?")[0], fixture.action);
        if (fixture.path.startsWith("/conversations")) {
            assertFalse(fake.path.find("api-version=") >= 0, "Foundry v1 forbids this query parameter");
            assertFalse(exists AzureOpenAiSchema::getOperationEx(fixture.action).getRequestFields()."api-version",
                "unsupported API version options are not offered for conversations");
        }
    }
    private valuesTest() {
        AbstractDataProviderType original = AzureOpenAiSchema::getOperationEx("create-response").getRequestType();
        AbstractDataProviderType restored = Serializable::deserialize(original.serialize());
        foreach AbstractDataProviderType type in (original, restored) {
            hash<auto> options = {"model": "fixture", "input": "", "store": False, "temperature": 0,
                "tools": (), "metadata": {}, "text": {"format": {"type": "json_schema", "name": "result",
                    "schema": {}, "strict": False}}};
            auto value = type.acceptsValue(options);
            assertEq({}, value.text.format.schema);
            assertEq("", value.input);
            assertEq(False, value.store);
            assertTrue(value.temperature == 0);
            assertEq((), value.tools);
            AzureActionFixtureClient fake();
            AzureOpenAiDataProvider::AzureOpenAiDataProvider root(fake);
            root.getChildProvider("create-response").doRequest(options);
            hash<auto> wire = parse_json(fake.raw.toString());
            assertEq({}, wire.text.format.schema);
            assertFalse(wire.store);
            options.text.format.schema = {"properties": {"value": {"type": "string"}}};
            value = type.acceptsValue(options);
            assertEq("string", value.text.format.schema.properties.value.type);
        }
    }
    private negativeTest() {
        AzureActionFixtureClient fake();
        AzureOpenAiDataProvider::AzureOpenAiDataProvider root(fake);
        foreach hash<auto> request in ({}, {"deployment": "fixture", "messages": ()},
                {"deployment": "fixture", "messages": ({"role": "invalid", "content": "x"},)},
                {"deployment": "fixture", "messages": NOTHING},
                {"deployment": "", "messages": ({"role": "user", "content": "x"},)},
                {"deployment": "   ", "messages": ({"role": "user", "content": "x"},)}) {
            *hash<ExceptionInfo> error;
            try {
                root.getChildProvider("chat-completion").doRequest(request);
            } catch (hash<ExceptionInfo> ex) {
                error = ex;
            }
            assertTrue(exists error);
            assertEq(0, fake.requests);
        }
    }
    private referenceTest() {
        AzureActionFixtureClient fake();
        fake.response = {"data": ({"id": "file-1", "filename": "invoices.jsonl"},)};
        AzureOpenAiDataProvider::AzureOpenAiDataProvider root(fake);
        auto choices = root.getChildProvider("get-file").getReferenceData("files");
        assertEq("file-1", choices[0].value);
        assertEq("invoices.jsonl", choices[0].display_name);
        assertTrue(fake.path.startsWith("/openai/v1/files"));
    }
    private timestampTest() {
        auto file = AzureOpenAiSchema::getOperationEx("get-file").processResponse({"created_at": 0, "expires_at": 1});
        assertEq(1970-01-01Z, file.created_at);
        assertEq(1970-01-01T00:00:01Z, file.expires_at);
        auto job = AzureOpenAiSchema::getOperationEx("get-fine-tuning-job").processResponse({
            "created_at": 0, "finished_at": 1, "estimated_finish": NOTHING});
        assertEq(1970-01-01T00:00:01Z, job.finished_at);
        assertNothing(job.estimated_finish);
        assertEq(NT_DATE, AzureOpenAiSchema::getOperationEx("get-fine-tuning-job").getResponseType()
            .getFields().finished_at.getType().getBaseTypeCode());
        hash<auto> wire = {"data": ({"created_at": 0, "expires_at": NOTHING, "last_active_at": 1},)};
        auto stores = AzureOpenAiSchema::getOperationEx("list-vector-stores").processResponse(wire);
        assertEq(1970-01-01Z, stores.data[0].created_at);
        assertNothing(stores.data[0].expires_at);
        assertEq(1970-01-01T00:00:01Z, stores.data[0].last_active_at);
        assertEq(0, wire.data[0].created_at, "response conversion preserves the caller's wire hash");
        auto absent = AzureOpenAiSchema::getOperationEx("get-file").processResponse({"created_at": 0});
        assertFalse(exists absent.expires_at);
        auto session = AzureOpenAiSchema::getOperationEx("create-realtime-transcription-session").processResponse({
            "client_secret": {"expires_at": 0}});
        assertEq(1970-01-01Z, session.client_secret.expires_at);
    }
    private translationTest() {
        string dir = get_script_dir() + "/../../../../qlib/AzureOpenAiDataProvider/i18n/data-provider.QXp1cmVPcGVuQUk/";
        hash<auto> root = parse_json(File::readTextFile(dir + "root.json")).locales.root.messages;
        hash<DataProviderAppInfo> app = DataProviderActionCatalog::getApp("AzureOpenAI");
        hash<auto> generated = DataProviderPresentation::buildSourceCatalogs(app,
            DataProviderActionCatalog::getActions("AzureOpenAI"));
        assertEq(generated{DataProviderPresentation::appCatalogDomain(app)}.locales.root.messages, root);
        foreach string locale in (DataProviderPresentation::StandardTranslationLocales) {
            hash<auto> messages = parse_json(File::readTextFile(dir + locale + ".json")).locales{locale}.messages;
            assertEq(sort(keys root), sort(keys messages), locale + ": exact message IDs");
            list<string> invalid = ();
            foreach hash<auto> entry in (messages.pairIterator()) {
                if (entry.value.source != root{entry.key}.source || !trim(entry.value.message)) {
                    invalid += entry.key;
                }
            }
            assertEq((), invalid, locale + ": exact source text and nonempty translations");
            if (locale == "ja") {
                foreach list<string> option in (("chat-completion", "deployment"), ("create-file", "file"),
                        ("create-transcription", "timestamp_granularities")) {
                    string id = DataProviderPresentation::optionMessageId("AzureOpenAI", option[0], option[1],
                        "display_name");
                    assertTrue(messages{id}.message.val());
                    assertNeq(root{id}.source, messages{id}.message);
                }
            }
        }
    }

    private audioFormatsTest() {
        AzureActionFixtureClient fake();
        AzureOpenAiDataProvider::AzureOpenAiDataProvider root(fake);
        foreach string format in ("mp3", "opus", "aac", "flac", "wav", "pcm") {
            root.getChildProvider("create-speech").doRequest({"model": "tts-deployment", "voice": "alloy",
                "input": "Your invoice is ready.", "response_format": format});
            assertEq(format, parse_json(fake.raw.toString()).response_format);
        }
        foreach string action in ("create-image", "create-image-edit") {
            auto image_type = AzureOpenAiSchema::getOperationEx(action).getResponseType();
            auto accepted = image_type.acceptsValue({"created": 1970-01-01Z,
                "data": ({"b64_json": "AQID"},)});
            assertEq("AQID", accepted.data[0].b64_json);
            assertFalse(exists accepted.data[0].prompt_filter_results);
            assertFalse(exists accepted.data[0].content_filter_results);
        }
        foreach string action in ("create-transcription", "create-translation") {
            auto op = AzureOpenAiSchema::getOperationEx(action);
            foreach AbstractDataProviderType type in (op.getResponseType(),
                    Serializable::deserialize(op.getResponseType().serialize())) {
                assertEq({"text": "Hello"}, type.acceptsValue({"text": "Hello"}));
                assertEq("Hello", type.acceptsValue("Hello"));
                hash<auto> verbose = {"text": "Hello", "task": "transcribe", "language": "english",
                    "duration": 1.5, "segments": (), "words": ()};
                auto accepted = type.acceptsValue(verbose);
                assertEq(sort(keys verbose), sort(keys accepted));
                assertEq("Hello", accepted.text);
                assertEq("transcribe", accepted.task);
                assertEq("english", accepted.language);
                assertEq(1.5, accepted.duration.toFloat());
                assertEq((), accepted.segments);
                assertEq((), accepted.words);
                assertThrows("RUNTIME-TYPE-ERROR", sub () { type.acceptsValue({"wrong": "field"}); });
            }
            foreach string format in ("json", "text", "srt", "verbose_json", "vtt") {
                root.getChildProvider(action).doRequest({"model": "whisper-deployment",
                    "file": {"name": "invoice.wav", "content": <52494646>}, "response_format": format});
                assertTrue(fake.path.startsWith("/openai/deployments/whisper-deployment/audio/"));
                auto parts = MultiPartFormDataMessage::parseMessage(fake.last_headers."Content-Type", fake.raw.toString());
                assertEq(format, parts.response_format.body);
                assertFalse(exists parts.model, "Azure selects the deployment from the path");
            }
            foreach hash<auto> invalid in ({"model": ""}, {"model": "  "}, {"temperature": -0.01},
                    {"temperature": 1.01}, {"response_format": "invalid"}, {"file": NOTHING}) {
                int sent = fake.requests;
                *hash<ExceptionInfo> error;
                try {
                    root.getChildProvider(action).doRequest({"model": "whisper-deployment",
                        "file": {"name": "invoice.wav", "content": <52494646>}} + invalid);
                } catch (hash<ExceptionInfo> ex) {
                    error = ex;
                }
                assertTrue(exists error, sprintf("%s: %y", action, invalid));
                assertEq(sent, fake.requests, "invalid audio inputs fail before transport");
            }
        }
    }

    private conversationItemsTest() {
        AbstractDataProviderType original = AzureOpenAiSchema::getOperationEx("list-conversation-items")
            .getResponseType();
        foreach AbstractDataProviderType type in (original, Serializable::deserialize(original.serialize())) {
            hash<auto> empty = {"object": "list", "data": (), "has_more": False};
            assertEq(empty, type.acceptsValue(empty));
            foreach string name in ("object", "data", "has_more") {
                hash<auto> missing = empty;
                remove missing{name};
                assertThrows("MISSING-VALUE-ERROR", sub () { type.acceptsValue(missing); });
            }
            foreach string name in ("first_id", "last_id") {
                hash<auto> invalid = empty;
                invalid{name} = {};
                assertThrows("RUNTIME-TYPE-ERROR", sub () { type.acceptsValue(invalid); });
                invalid{name} = "item-1";
                assertEq("item-1", type.acceptsValue(invalid){name});
            }
        }
    }

    private multipartTest() {
        AzureActionFixtureClient fake();
        AzureOpenAiDataProvider::AzureOpenAiDataProvider root(fake);
        root.getChildProvider("create-file").doRequest({"purpose": "batch",
            "file": {"name": "invoices.jsonl", "content": binary("{}\n")},
            "expires_after": {"anchor": "created_at", "seconds": 259200}});
        auto parts = MultiPartFormDataMessage::parseMessage(fake.last_headers."Content-Type", fake.raw.toString());
        assertEq("invoices.jsonl", parts.file.filename);
        assertEq("259200", parts."expires_after[seconds]".body);
        assertEq("created_at", parts."expires_after[anchor]".body);
        root.getChildProvider("create-transcription").doRequest({"model": "speech-deployment",
            "file": {"name": "invoice.wav", "content": binary("RIFF")}, "temperature": 0,
            "timestamp_granularities": ("word", "segment"), "response_format": "verbose_json"});
        assertTrue(fake.path.startsWith("/openai/deployments/speech-deployment/audio/transcriptions"));
        assertTrue(fake.path.find("api-version=2025-04-01-preview") >= 0);
        parts = MultiPartFormDataMessage::parseMessage(fake.last_headers."Content-Type", fake.raw.toString());
        assertEq("invoice.wav", parts.file.filename);
        assertEq("segment", parts."timestamp_granularities[]".body);
        assertEq(0.0, parts.temperature.body.toFloat());
        int sent = fake.requests;
        foreach int seconds in (0, 259199, 2592001) {
            *hash<ExceptionInfo> error;
            try {
                root.getChildProvider("create-file").doRequest({"purpose": "batch",
                    "file": {"name": "invoices.jsonl", "content": binary("{}\n")},
                    "expires_after": {"anchor": "created_at", "seconds": seconds}});
            } catch (hash<ExceptionInfo> ex) {
                error = ex;
            }
            assertTrue(exists error);
            assertEq(sent, fake.requests);
        }
    }
}
