%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/QoreLlmTypes.qm
%requires ../../../../qlib/QoreLlmUtils
%requires ../../../../qlib/OpenAiRestClient.qm
%requires ../../../../qlib/DeepSeekRestClient.qm

%requires ../../../../qlib/HttpServer.qm

%exec-class DeepSeekRestClientTest

class DeepSeekPingHandler inherits AbstractHttpRequestHandler {
    private {
        Mutex lock();
        hash<auto> request;
    }
    hash handleRequest(hash cx, hash hdr, *data body) {
        AutoLock al(lock);
        request = hdr;
        return makeResponse(hdr.authorization == "Bearer test-key" ? 200 : 401,
            hdr.authorization == "Bearer test-key" ? "[]" : "{\"error\":\"Unauthorized\"}",
            {"Content-Type": MimeTypeJson});
    }
    hash<auto> getRequest() {
        AutoLock al(lock);
        return request;
    }
}

class SyncDeepSeekConnection inherits DeepSeekRestClient::DeepSeekRestConnection {
    constructor(string url, hash<auto> options)
            : DeepSeekRestConnection("sync-test", "test", url, {}, options) {
    }
    private object getAsyncImpl(bool connect = True, *hash<auto> rtopts) {
        throw "CONNECTION-ASYNC-UNSUPPORTED", "exercise synchronous ping";
    }
}



public class DeepSeekRestClientTest inherits QUnit::Test {
    constructor() : Test("DeepSeekRestClient Test", "1.0") {
        addTestCase("connection scheme registered",      \connectionSchemeTest());
        addTestCase("factory registered + lazy-loadable", \factoryTest());
        addTestCase("provider applies default URL",       \defaultUrlTest());
        addTestCase("provider preserves explicit URL",    \explicitUrlTest());
        addTestCase("factory getInfo advertises capabilities",
            \getInfoTest());
        addTestCase("default chat-completions path is OpenAI shape",
            \chatPathTest());
        addTestCase("REST client options apply Bearer mapping",
            \restOptionsTest());
        addTestCase("automatic connection URL and app identity", \connectionConfigTest());
        addTestCase("sync and async pings verify authentication", \pingTest());
        if (ENV.DEEPSEEK_LIVE) {
            addTestCase("live valid and invalid authentication", \livePingTest());
        }
        addTestCase("current models expose supported reasoning levels", \modelEfforts());
        set_return_value(main());
    }

    private modelEfforts() {
        assertEq("deepseek-flash", DeepSeekRestClientBase::DefaultChatModel);
        foreach string model in (("deepseek-flash", "deepseek-v4-pro", "deepseek-v4-flash",
                "deepseek-v4-flash-vision-exp")) {
            assertEq(("none", "low", "high", "max"), DeepSeekRestClientBase::getModelReasoningEfforts(model));
        }
        assertNothing(DeepSeekRestClientBase::getModelReasoningEfforts("deepseek-unknown"));
    }

    private connectionConfigTest() {
        DeepSeekRestClient::DeepSeekRestConnection conn({
            "name": "test", "desc": "automatic connection", "url": "deepseek://localhost",
            "opts": {"apikey": "test-key"},
        });
        assertEq("DeepSeek", conn.getAppName());
        assertEq("DeepSeek", conn.getInfo().app);
        assertEq("https://api.deepseek.com", conn.getConnectionOptions().url);
        assertEq("json", conn.getConnectionOptions().data);
        assertTrue(DeepSeekRestClient::DeepSeekRestConnection::ConnectionScheme.options.apikey.sensitive);
        assertThrows("CONNECTION-OPTION-ERROR", sub () {
            new DeepSeekRestClient::DeepSeekRestConnection("missing", "missing credentials");
        });
        assertEq("v1", DeepSeekRestClient::DeepSeekRestConnection::ConnectionScheme.options.api.allowed_values[0].value);
        assertEq("beta", DeepSeekRestClient::DeepSeekRestConnection::ConnectionScheme.options.api.allowed_values[1].value);
        DeepSeekRestClient::DeepSeekRestConnection legacy("legacy", "old automatic URL", "deepseek://localhost", {},
            {"apikey": "test-key"});
        *hash<auto> updated;
        legacy.setUpdateOptionsCode(sub (hash<auto> options) { updated = options; });
        assertEq({"url": DeepSeekRestClient::DeepSeekRestConnection::DefaultUrl}, updated);
        legacy.setUpdateOptionsCode(NOTHING);
        updated = NOTHING;
        conn.setUpdateOptionsCode(sub (hash<auto> options) { updated = options; });
        assertNothing(updated);
        conn.setUpdateOptionsCode(NOTHING);
    }

    private pingTest() {
        HttpServer http(<HttpServerOptionInfo>{"logger": new Logger("test", LoggerLevel::getLevelWarn())});
        on_exit delete http;
        int port = http.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        DeepSeekPingHandler handler();
        http.setDefaultHandler("ping", handler);
        string url = sprintf("http://127.0.0.1:%d", port);
        foreach bool sync in (False, True) {
            foreach string key in ("test-key", "invalid-key") {
                hash<auto> opts = {"apikey": key, "http_version": "1.1"};
                DeepSeekRestClient::DeepSeekRestConnection conn = sync
                    ? new SyncDeepSeekConnection(url, opts)
                    : new DeepSeekRestClient::DeepSeekRestConnection("test", "test", url, {}, opts);
                if (key == "test-key") {
                    assertTrue(conn.ping(True).ok);
                } else {
                    assertPingFailure(conn);
                }
                assertEq("v1/models", handler.getRequest().path);
                assertEq("GET", handler.getRequest().method);
                assertEq("Bearer " + key, handler.getRequest().authorization);
            }
        }
        DeepSeekRestClient::DeepSeekRestClient client({"url": url, "apikey": "test-key"});
        assertTrue(client.isConnected());
        DeepSeekRestClient::DeepSeekRestClient deferred({"url": url, "apikey": "test-key"}, True);
        assertFalse(deferred.isConnected());
        deferred.get("models");
        assertTrue(deferred.isConnected());
        client.get("models");
        assertEq("v1/models", handler.getRequest().path);
        assertEq("Bearer test-key", handler.getRequest().authorization);
    }

    private assertPingFailure(DeepSeekRestClient::DeepSeekRestConnection conn) {
        *hash<ExceptionInfo> error;
        try {
            conn.ping(True);
        } catch (hash<ExceptionInfo> ex) {
            error = ex;
        }
        assertTrue(exists error);
        assertRegex("^(REST-PING-ERROR|REST-RESPONSE-ERROR|HTTP-CLIENT-RECEIVE-ERROR)$", error.err);
        assertRegex("401", error.desc);
    }

    private livePingTest() {
        DeepSeekRestClient::DeepSeekRestConnection conn("live", "live authentication",
            DeepSeekRestClient::DeepSeekRestConnection::DefaultUrl, {}, {"apikey": ENV.DEEPSEEK_APIKEY});
        assertTrue(conn.ping(True).ok);
        DeepSeekRestClient::DeepSeekRestConnection invalid("invalid", "negative authentication",
            DeepSeekRestClient::DeepSeekRestConnection::DefaultUrl, {}, {"apikey": "invalid-qore-audit-key"});
        assertPingFailure(invalid);
    }

    private connectionSchemeTest() {
        hash<ConnectionSchemeInfo> info =
            ConnectionProvider::ConnectionSchemeCache::getScheme("deepseek");
        assertEq("DeepSeek REST Connection", info.display_name);
        assertTrue(info.schemes.deepseek);
        assertEq("apikey", info.required_options);
    }

    private factoryTest() {
        QoreLlmUtils::AbstractLlmProviderFactory f =
            QoreLlmUtils::LlmProviderRegistry::getFactoryEx("deepseek");
        assertEq("deepseek", f.getMode());
        assertEq("DeepSeek chat completions", f.getDisplayName());
        assertEq("DeepSeekRestClient", f.getInfo().module_name);
    }

    private defaultUrlTest() {
        DeepSeekRestClient::DeepSeekLlmProvider p(
            <QoreLlmUtils::LlmBackendConfig>{
                "model": "deepseek-chat",
                "api_key": "test-key",
            });
        assertEq("deepseek", p.getMode());
        assertEq(DeepSeekRestClient::DeepSeekLlmProvider::DefaultUrl,
            p.getConfig().url);
    }

    private explicitUrlTest() {
        DeepSeekRestClient::DeepSeekLlmProvider p(
            <QoreLlmUtils::LlmBackendConfig>{
                "url": "https://custom.example.com",
                "model": "deepseek-chat",
                "api_key": "k",
            });
        assertEq("https://custom.example.com", p.getConfig().url);
    }

    private getInfoTest() {
        QoreLlmUtils::AbstractLlmProviderFactory f =
            QoreLlmUtils::LlmProviderRegistry::getFactoryEx("deepseek");
        hash<QoreLlmUtils::LlmProviderInfo> info = f.getInfo();
        assertTrue(info.supports_streaming);
        assertTrue(info.supports_tools);
        assertFalse(info.supports_structured_output, "JSON mode does not enforce JSON schemas");
        assertTrue(info.supports_multimodal);
    }

    private chatPathTest() {
        DeepSeekRestClient::DeepSeekLlmProvider p(
            <QoreLlmUtils::LlmBackendConfig>{
                "model": "deepseek-chat",
                "api_key": "k",
            });
        # OpenAI-compatible default — DeepSeek does NOT override the path
        assertEq("/v1/chat/completions", p.getChatCompletionsPath());
    }

    private restOptionsTest() {
        hash<auto> opts = DeepSeekRestClient::DeepSeekRestClientBase::getOptions({
            "apikey": "my-key",
        });
        # apikey is remapped to token for Bearer header
        assertEq("my-key", opts.token);
        assertEq(NOTHING, opts.apikey);
        # URL + api defaults applied
        assertEq("https://api.deepseek.com", opts.url);
        assertEq("v1", opts.api);
        assertEq("/v1", opts.default_path);
    }
}
