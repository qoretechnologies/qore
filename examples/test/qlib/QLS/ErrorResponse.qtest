%modern

%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/QLS
%requires json

%exec-class ErrorResponseTest

class ErrorResponseTest inherits QUnit::Test {
    constructor() : Test("ErrorResponse", "1.0") {
        addTestCase("ErrorCodes constants", \testErrorCodes());
        addTestCase("notInitialized", \testNotInitialized());
        addTestCase("invalidRequest", \testInvalidRequest());
        addTestCase("invalidRequest with message", \testInvalidRequestWithMessage());
        addTestCase("methodNotFound", \testMethodNotFound());
        addTestCase("internalError", \testInternalError());
        addTestCase("internalError with message", \testInternalErrorWithMessage());
        addTestCase("invalidParams", \testInvalidParams());
        addTestCase("nonExistentDocument", \testNonExistentDocument());

        set_return_value(main());
    }

    testErrorCodes() {
        assertEq(-32700, QLS::ErrorCodes.ParseError);
        assertEq(-32600, QLS::ErrorCodes.InvalidRequest);
        assertEq(-32601, QLS::ErrorCodes.MethodNotFound);
        assertEq(-32602, QLS::ErrorCodes.InvalidParams);
        assertEq(-32603, QLS::ErrorCodes.InternalError);
        assertEq(-32002, QLS::ErrorCodes.ServerNotInitialized);
        assertEq(-32001, QLS::ErrorCodes.UnknownErrorCode);
    }

    testNotInitialized() {
        hash request = {"jsonrpc": "2.0", "id": 1, "method": "test"};
        string resp = QLS::ErrorResponse::notInitialized(request);
        assertEq(Type::String, resp.type());
        hash parsed = parse_json(resp);
        assertEq("2.0", parsed.jsonrpc);
        assertEq(1, parsed.id);
        assertEq(QLS::ErrorCodes.ServerNotInitialized, parsed.error.code);
    }

    testInvalidRequest() {
        hash request = {"jsonrpc": "2.0", "id": 2, "method": "test"};
        string resp = QLS::ErrorResponse::invalidRequest(request);
        hash parsed = parse_json(resp);
        assertEq(QLS::ErrorCodes.InvalidRequest, parsed.error.code);
        assertEq("invalid request", parsed.error.message);
    }

    testInvalidRequestWithMessage() {
        hash request = {"jsonrpc": "2.0", "id": 3, "method": "test"};
        string resp = QLS::ErrorResponse::invalidRequest(request, "custom error");
        hash parsed = parse_json(resp);
        assertEq(QLS::ErrorCodes.InvalidRequest, parsed.error.code);
        assertEq("custom error", parsed.error.message);
    }

    testMethodNotFound() {
        hash request = {"jsonrpc": "2.0", "id": 4, "method": "nonExistent"};
        string resp = QLS::ErrorResponse::methodNotFound(request);
        hash parsed = parse_json(resp);
        assertEq(QLS::ErrorCodes.MethodNotFound, parsed.error.code);
        assertRegex("nonExistent", parsed.error.message);
    }

    testInternalError() {
        string resp = QLS::ErrorResponse::internalError("2.0");
        hash parsed = parse_json(resp);
        assertEq(QLS::ErrorCodes.InternalError, parsed.error.code);
        assertEq("internal error", parsed.error.message);
    }

    testInternalErrorWithMessage() {
        string resp = QLS::ErrorResponse::internalError("2.0", "something broke");
        hash parsed = parse_json(resp);
        assertEq(QLS::ErrorCodes.InternalError, parsed.error.code);
        assertEq("something broke", parsed.error.message);
    }

    testInvalidParams() {
        hash request = {"jsonrpc": "2.0", "id": 5, "method": "test"};
        string resp = QLS::ErrorResponse::invalidParams(request, "bad params");
        hash parsed = parse_json(resp);
        assertEq(QLS::ErrorCodes.InvalidParams, parsed.error.code);
        assertEq("bad params", parsed.error.message);
    }

    testNonExistentDocument() {
        hash request = {
            "jsonrpc": "2.0",
            "id": 6,
            "method": "test",
            "params": {"textDocument": {"uri": "file:///nonexistent"}},
        };
        string resp = QLS::ErrorResponse::nonExistentDocument(request);
        hash parsed = parse_json(resp);
        assertEq(QLS::ErrorCodes.InvalidParams, parsed.error.code);
        assertRegex("nonexistent", parsed.error.message);
    }
}
