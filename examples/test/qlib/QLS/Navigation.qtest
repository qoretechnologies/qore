    testTypeDefinitionNullableType() {
        string code = "%modern
class MyType {
    int val;
}
sub test() {
    *MyType obj;
}
";
        string uri = setupDoc(code);

        # "obj" at line 5, col 12 → type is *MyType → should strip * and find MyType
        *list<auto> result = sendTypeDefinition(uri, 5, 12);
        assertTrue(exists result && result.size() > 0,
            "nullable type '*MyType' should resolve to a type declaration");
        assertEq(1, result[0].range.start.line,
            "nullable type should resolve to class declaration");
    }

    testTypeDefinitionCrossDocType() {
        # Type declaration in one doc
        string typeCode = "%modern
class Vehicle {
    string model;
}
";
        string typeUri = setupDoc(typeCode);

        # Usage in another doc
        string usageCode = "%modern
sub test() {
    Vehicle car();
}
";
        string usageUri = setupDoc(usageCode);

        # "car" at line 2, col 12 → type is Vehicle → should find Vehicle in other doc
        *list<auto> result = sendTypeDefinition(usageUri, 2, 12);
        assertTrue(exists result && result.size() > 0,
            "cross-doc type should resolve");
        if (result) {
            assertEq(typeUri, result[0].uri,
                "cross-doc type should point to type document");
            assertEq(1, result[0].range.start.line,
                "cross-doc type should point to Vehicle class at line 1");
        }
    }

