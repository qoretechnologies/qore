            "variable 'pet' should resolve to type declaration");
        if (result) {
            assertEq(1, result[0].range.start.line,
                "type definition should point to Animal class at line 1");
        }
    }

    testTypeDefinitionParameterClassType() {
        string uri = setupDoc(getTypeDefinitionTestCode());

