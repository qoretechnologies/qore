    # ═══════════════════════════════════════════════════════════════════
    # Call Hierarchy tests
    # ═══════════════════════════════════════════════════════════════════

    testCallHierarchyPrepareFunction() {
        string uri = setupDoc(getCallHierarchyTestCode());

        # "helper" at line 1, col 4
        *list<auto> result = sendCallHierarchyPrepare(uri, 1, 4);
        assertTrue(exists result && result.size() > 0,
            "prepare on function should return item");
        if (result) {
            assertEq("helper", result[0].name, "item should be named helper");
            assertEq(uri, result[0].uri, "URI should match");
        }
    }

    testCallHierarchyPrepareNonCallable() {
        string uri = setupDoc(getCallHierarchyTestCode());

        # Position on %modern at line 0, col 0
        *list<auto> result = sendCallHierarchyPrepare(uri, 0, 0);
        # Should return null — not a callable
        if (result) {
            assertEq(0, result.size(), "non-callable should return empty");
        }
    }

    testCallHierarchyIncomingCalls() {
        string uri = setupDoc(getCallHierarchyTestCode());

        # Prepare on "helper" at line 1, col 4
        *list<auto> prepared = sendCallHierarchyPrepare(uri, 1, 4);
        assertTrue(exists prepared && prepared.size() > 0, "should prepare helper");

        # Get incoming calls to helper
        *list<auto> incoming = sendIncoming(prepared[0]);
        assertTrue(exists incoming, "should return incoming calls");
        if (incoming && incoming.size() > 0) {
            # helper is called from worker
            assertTrue(incoming.size() >= 1,
                sprintf("helper should have at least 1 caller (got %d)", incoming.size()));
            # Check the caller is worker
            bool foundWorker = False;
            foreach hash<auto> call in (incoming) {
                if (call."from".name == "worker") {
                    foundWorker = True;
                    assertTrue(call.fromRanges.size() >= 2,
                        sprintf("worker should call helper at least 2 times (got %d)",
                            call.fromRanges.size()));
                }
            }
            assertTrue(foundWorker, "should find worker as caller");
        }
    }

    testCallHierarchyOutgoingCalls() {
        string uri = setupDoc(getCallHierarchyTestCode());

        # Prepare on "worker" at line 2, col 4
        *list<auto> prepared = sendCallHierarchyPrepare(uri, 2, 4);
        assertTrue(exists prepared && prepared.size() > 0, "should prepare worker");

        # Get outgoing calls from worker
        *list<auto> outgoing = sendOutgoing(prepared[0]);
        assertTrue(exists outgoing, "should return outgoing calls");
        # worker calls helper
        if (outgoing && outgoing.size() > 0) {
            bool foundHelper = False;
            foreach hash<auto> call in (outgoing) {
                if (call."to".name == "helper") {
                    foundHelper = True;
                }
            }
            assertTrue(foundHelper, "worker should call helper");
        }
    }

    testCallHierarchyNoCalls() {
        string code = "%modern
sub isolated() { return 42; }
";
        string uri = setupDoc(code);

        # Prepare on "isolated" at line 1, col 4
        *list<auto> prepared = sendCallHierarchyPrepare(uri, 1, 4);
        assertTrue(exists prepared && prepared.size() > 0, "should prepare isolated");

        # No incoming calls
        *list<auto> incoming = sendIncoming(prepared[0]);
        assertEq(0, incoming.size(), "isolated function should have no callers");
    }

    testCallHierarchyMissingParams() {
        hash<auto> req = makeRequest("textDocument/prepareCallHierarchy");
        delete req.params;
        softlist<auto> responses = server.handleRequest(make_json(req));
        assertTrue(exists responses && responses.size() > 0,
            "should return error response for missing params");
        hash<auto> resp = parse_json(responses[0]);
        assertTrue(exists resp.error, "response should have error field");
    }

    # ═══════════════════════════════════════════════════════════════════
    # Definition tests
    # ═══════════════════════════════════════════════════════════════════

    testDefinitionLocalVariable() {
        string uri = setupDoc(getDefinitionTestCode());

        # "calc" on line 9 "calc.add(5)" col 0 → should resolve to "Calculator calc(10)"
        # on line 8
        *list<auto> result = sendDefinition(uri, 9, 0);
        assertTrue(exists result && result.size() > 0,
            "local variable 'calc' should resolve to declaration");
        if (result) {
            assertEq(8, result[0].range.start.line,
                "calc declaration should be on line 8");
        }
    }

    testDefinitionParameter() {
        string uri = setupDoc(getDefinitionTestCode());

        # "n" in "total += n" on line 4 → parameter "n" in "int add(int n)"
        # "n" is at approximately col 33 on line 4
        *list<auto> result = sendDefinition(uri, 4, 33);
        if (result && result.size() > 0) {
            assertEq(4, result[0].range.start.line,
                "parameter 'n' should be on line 4");
        }
    }

    testDefinitionClassRef() {
        string uri = setupDoc(getDefinitionTestCode());

        # "Calculator" at line 8 col 0 → class declaration at line 1
        *list<auto> result = sendDefinition(uri, 8, 0);
        assertTrue(exists result && result.size() > 0,
            "class reference 'Calculator' should resolve");
        if (result) {
            assertEq(1, result[0].range.start.line,
                "class declaration should be on line 1");
        }
    }

    testDefinitionFunctionCall() {
        string uri = setupDoc(getDefinitionTestCode());

        # "helper" at line 10 col 13 → function declaration at line 7
        *list<auto> result = sendDefinition(uri, 10, 13);
        assertTrue(exists result && result.size() > 0,
            "function call 'helper' should resolve");
        if (result) {
            assertEq(7, result[0].range.start.line,
                "helper function should be on line 7");
        }
    }

    testDefinitionMethodCall() {
        string uri = setupDoc(getDefinitionTestCode());

        # "add" in "calc.add(5)" at line 9 col 5 → method "add" in Calculator
        *list<auto> result = sendDefinition(uri, 9, 5);
        if (result && result.size() > 0) {
            assertEq(4, result[0].range.start.line,
                "method 'add' should resolve to line 4");
        }
    }

    testDefinitionStaticMethod() {
        string uri = setupDoc(getDefinitionTestCode());

        # "zero" in "Calculator::zero()" at line 11 col 13 → static method at line 5
        *list<auto> result = sendDefinition(uri, 11, 13);
        if (result && result.size() > 0) {
            assertEq(5, result[0].range.start.line,
                "static method 'zero' should resolve to line 5");
        }
    }

    testDefinitionForeachVariable() {
        string uri = setupDoc(getDefinitionTestCode());

        # "item" in printf on line 12 col 51
        *list<auto> result = sendDefinition(uri, 12, 51);
        if (result && result.size() > 0) {
            assertEq(12, result[0].range.start.line,
                "foreach variable 'item' should resolve to line 12");
        }
    }

    testDefinitionCrossDocFallback() {
        string uri = setupDoc(getDefinitionTestCode());

        # "Calculator" in "class Calculator" at line 1 col 6 — already at declaration
        # resolveDefinition returns NOTHING for declaration names, then the fallback
        # cross-document search runs; should return a valid response (list)
        *list<auto> result = sendDefinition(uri, 1, 6);
        assertTrue(exists result, "at declaration returns a valid response");
        # The cross-doc fallback should find the Calculator class declaration
        assertTrue(result.size() > 0,
            "cross-doc fallback finds the Calculator declaration");
    }

    testDefinitionUnknownSymbol() {
        string uri = setupDoc(getDefinitionTestCode());

        # Position on whitespace/parse directive — line 0 col 0 (%modern)
        # Should return an empty result list (no symbol to resolve)
        *list<auto> result = sendDefinition(uri, 0, 0);
        assertEq(0, result.size(),
            "unknown symbol returns empty result");
    }

    testDefinitionMemberFieldAccess() {
        # Use a separate test with explicit member_expression via self.member
        string memberCode = "%modern
class Foo {
    private { int count = 0; }
    int getCount() { return self.count; }
}
";
        string uri = setupDoc(memberCode);

        # "count" in "self.count" at line 3, col 33 → member "count" on line 2
        *list<auto> result = sendDefinition(uri, 3, 33);
        if (result && result.size() > 0) {
            assertEq(2, result[0].range.start.line,
                "member 'count' via self should resolve to line 2");
        }
    }

    testDefinitionInheritedMethodViaInstance() {
