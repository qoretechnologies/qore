    testDefinitionCrossDocTopLevelDecl() {
        # Function doc:
        # Line 0: %modern
        # Line 1: sub xhelper(int x) { return x + 1; }
        string funcCode = "%modern
sub xhelper(int x) { return x + 1; }
";
        string funcUri = setupDoc(funcCode);

        # Caller doc:
        # Line 0: %modern
        # Line 1: xhelper(5);
        string callerCode = "%modern
xhelper(5);
";
        string callerUri = setupDoc(callerCode);

        # "xhelper" at line 1, col 0 → function at line 1 in funcDoc
        *list<auto> result = sendDefinition(callerUri, 1, 0);
        assertTrue(exists result && result.size() > 0,
            "cross-doc top-level function should resolve");
        if (result) {
            assertEq(funcUri, result[0].uri,
                "cross-doc top-level function URI should point to func doc");
            assertEq(1, result[0].range.start.line,
                "cross-doc top-level function should resolve to line 1");
        }
    }

    testDefinitionMissingParams() {
        # Needs its own server — tests error handling without a document open
        QLS::QLSServer errorServer();

        hash<auto> initReq = makeRequest("initialize", {
            "processId": getpid(),
            "capabilities": {},
            "rootUri": NOTHING,
        });
        errorServer.handleRequest(make_json(initReq));

        hash<auto> initializedReq = makeRequest("initialized");
        delete initializedReq.id;
        errorServer.handleRequest(make_json(initializedReq));

        hash<auto> req = makeRequest("textDocument/definition");
        delete req.params;
        softlist<auto> responses = errorServer.handleRequest(make_json(req));
        assertTrue(exists responses, "should return error response for missing params");
        assertTrue(responses.size() > 0, "should have at least one response");
        hash<auto> resp = parse_json(responses[0]);
        assertTrue(exists resp.error, "response should have error field");
    }

    testDefinitionNonExistentDocument() {
        setupDoc(getDefinitionTestCode());

        hash<auto> req = makeRequest("textDocument/definition", {
            "textDocument": {"uri": "file:///nonexistent.q"},
            "position": {"line": 0, "character": 0},
        });
        softlist<auto> responses = server.handleRequest(make_json(req));
        assertTrue(exists responses, "should return response for non-existent document");
        hash<auto> resp = parse_json(responses[0]);
        assertTrue(exists resp.error, "should return error for non-existent document");
    }

    # ═══════════════════════════════════════════════════════════════════
    # Implementation tests
    # ═══════════════════════════════════════════════════════════════════

    testImplementationClassToSubtypes() {
        string uri = setupDoc(getImplementationTestCode());

        # "Shape" at line 1, col 6 → should find Circle and Square
        *list<auto> result = sendImplementation(uri, 1, 6);
        assertTrue(exists result && result.size() >= 2,
            sprintf("Shape should have at least 2 implementations (got %d)",
                result ? result.size() : 0));
    }

    testImplementationMethodToImplementations() {
        string uri = setupDoc(getImplementationTestCode());

        # "area" in abstract method at line 2, col 19 → concrete implementations
        *list<auto> result = sendImplementation(uri, 2, 19);
        assertTrue(exists result && result.size() >= 2,
            sprintf("abstract area() should have at least 2 implementations (got %d)",
                result ? result.size() : 0));
    }

    testImplementationConcreteMethodSelf() {
        string uri = setupDoc(getImplementationTestCode());

        # "area" in Circle at line 6, col 10 → should return itself or its definition
        *list<auto> result = sendImplementation(uri, 6, 10);
        assertTrue(exists result && result.size() > 0,
            "concrete method should return at least its definition");
    }

    testImplementationFunctionDefinition() {
        string code = "%modern
sub myFunc(int x) { return x; }
myFunc(5);
";
        string uri = setupDoc(code);

        # "myFunc" at line 2, col 0 → should return function definition
        *list<auto> result = sendImplementation(uri, 2, 0);
        assertTrue(exists result && result.size() > 0,
            "function call should return its definition");
    }

    testImplementationCrossDocImplementations() {
        # Base class
        string baseCode = "%modern
class ImplBase {
    abstract string getName();
}
";
        setupDoc(baseCode);

        # Implementation in another doc
        string implCode = "%modern
class ImplChild inherits ImplBase {
    string getName() { return \"child\"; }
}
";
        string implUri = setupDoc(implCode);

        # Check that the implementation exists
        # Get the child class implementations
        *list<auto> result = sendImplementation(implUri, 2, 11);
        assertTrue(exists result, "should find implementation result");
    }

    testImplementationNoImplementations() {
        string code = "%modern
int x = 5;
";
        string uri = setupDoc(code);

        # Position on a simple variable
        *list<auto> result = sendImplementation(uri, 1, 4);
        # May return the definition itself or empty
        assertTrue(exists result, "should return a result");
    }

    testImplementationMissingParams() {
        hash<auto> req = makeRequest("textDocument/implementation");
