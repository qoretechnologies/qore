%modern

%requires ../../../../qlib/QUnit.qm
%requires json
%requires ../../../../qlib/QLS

%exec-class NavigationTest

class NavigationTest inherits QUnit::Test {
    private {
        QLS::QLSServer server;
        int reqId = 0;
        int docCount = 0;
        hash<string, string> docCache;
    }

    constructor() : Test("QLS Navigation", "1.0") {
        initServer();

        # Call Hierarchy tests
        addTestCase("call hierarchy: prepare on function", \testCallHierarchyPrepareFunction());
        addTestCase("call hierarchy: prepare on non-callable", \testCallHierarchyPrepareNonCallable());
        addTestCase("call hierarchy: incoming calls", \testCallHierarchyIncomingCalls());
        addTestCase("call hierarchy: outgoing calls", \testCallHierarchyOutgoingCalls());
        addTestCase("call hierarchy: no calls", \testCallHierarchyNoCalls());
        addTestCase("call hierarchy: missing params", \testCallHierarchyMissingParams());

        # Definition tests
        addTestCase("definition: local variable to declaration", \testDefinitionLocalVariable());
        addTestCase("definition: parameter to declaration", \testDefinitionParameter());
        addTestCase("definition: class reference to class declaration", \testDefinitionClassRef());
        addTestCase("definition: function call to function declaration", \testDefinitionFunctionCall());
        addTestCase("definition: method call to method declaration", \testDefinitionMethodCall());
        addTestCase("definition: static method via scope to declaration", \testDefinitionStaticMethod());
        addTestCase("definition: foreach variable to foreach statement", \testDefinitionForeachVariable());
        addTestCase("definition: cross-doc fallback for declaration name", \testDefinitionCrossDocFallback());
        addTestCase("definition: unknown symbol returns empty", \testDefinitionUnknownSymbol());
        addTestCase("definition: member field access", \testDefinitionMemberFieldAccess());
        addTestCase("definition: inherited method via instance", \testDefinitionInheritedMethodViaInstance());
        addTestCase("definition: inherited field via instance", \testDefinitionInheritedFieldViaInstance());
        addTestCase("definition: inherited method via scope", \testDefinitionInheritedMethodViaScope());
        addTestCase("definition: deep inheritance chain", \testDefinitionDeepInheritance());
        addTestCase("definition: inherited constant via scope", \testDefinitionInheritedConstant());
        addTestCase("definition: cross-doc inherited method", \testDefinitionCrossDocInheritedMethod());
        addTestCase("definition: cross-doc inherited field", \testDefinitionCrossDocInheritedField());
        addTestCase("definition: cross-doc deep inheritance", \testDefinitionCrossDocDeepInheritance());
        addTestCase("definition: cross-doc scope access", \testDefinitionCrossDocScopeAccess());
        addTestCase("definition: cross-doc top-level declaration", \testDefinitionCrossDocTopLevelDecl());
        addTestCase("definition: missing params", \testDefinitionMissingParams());
        addTestCase("definition: non-existent document", \testDefinitionNonExistentDocument());

        # Implementation tests
        addTestCase("implementation: class to subtypes", \testImplementationClassToSubtypes());
        addTestCase("implementation: method to implementations", \testImplementationMethodToImplementations());
        addTestCase("implementation: concrete method returns itself", \testImplementationConcreteMethodSelf());
        addTestCase("implementation: function returns definition", \testImplementationFunctionDefinition());
        addTestCase("implementation: cross-doc implementations", \testImplementationCrossDocImplementations());
        addTestCase("implementation: no implementations", \testImplementationNoImplementations());
        addTestCase("implementation: missing params", \testImplementationMissingParams());
        addTestCase("implementation: non-existent document", \testImplementationNonExistentDocument());

        # Type Definition tests
        addTestCase("type definition: variable with class type", \testTypeDefinitionVariableClassType());
        addTestCase("type definition: parameter with class type", \testTypeDefinitionParameterClassType());
        addTestCase("type definition: primitive type returns empty", \testTypeDefinitionPrimitiveType());
        addTestCase("type definition: auto type returns empty", \testTypeDefinitionAutoType());
        addTestCase("type definition: untyped variable returns empty", \testTypeDefinitionUntypedVariable());
        addTestCase("type definition: nullable type strips prefix", \testTypeDefinitionNullableType());
        addTestCase("type definition: cross-doc type resolution", \testTypeDefinitionCrossDocType());
        addTestCase("type definition: missing params", \testTypeDefinitionMissingParams());
        addTestCase("type definition: non-existent document", \testTypeDefinitionNonExistentDocument());

        # Type Hierarchy tests
        addTestCase("type hierarchy: prepare on class name", \testTypeHierarchyPrepareOnClass());
        addTestCase("type hierarchy: prepare not on class", \testTypeHierarchyPrepareNotOnClass());
        addTestCase("type hierarchy: single parent supertypes", \testTypeHierarchySingleParent());
        addTestCase("type hierarchy: multiple parents supertypes", \testTypeHierarchyMultipleParents());
        addTestCase("type hierarchy: subtypes scan", \testTypeHierarchySubtypes());
        addTestCase("type hierarchy: no parent class", \testTypeHierarchyNoParent());
        addTestCase("type hierarchy: cross-doc hierarchy", \testTypeHierarchyCrossDocHierarchy());
        addTestCase("type hierarchy: missing params", \testTypeHierarchyMissingParams());

        set_return_value(main());
    }

    private initServer() {
        server = new QLS::QLSServer();

        hash<auto> initReq = makeRequest("initialize", {
            "processId": getpid(),
            "capabilities": {},
            "rootUri": NOTHING,
        });
        server.handleRequest(make_json(initReq));

        hash<auto> initializedReq = makeRequest("initialized");
        delete initializedReq.id;
        server.handleRequest(make_json(initializedReq));
    }

    private hash<auto> makeRequest(string method, *hash<auto> params) {
        return {
            "jsonrpc": "2.0",
            "id": ++reqId,
            "method": method,
            "params": params,
        };
    }

    #! Opens a document on the shared server, caching by content; returns the URI
    private string setupDoc(*string text) {
        string src = text ?? getCallHierarchyTestCode();
        *string cached = docCache{src};
        if (exists cached) {
            return cached;
        }
        string uri = sprintf("file:///test/nav%d.q", ++docCount);
        hash<auto> openReq = makeRequest("textDocument/didOpen", {
            "textDocument": {
                "uri": uri,
                "languageId": "qore",
                "version": 1,
                "text": src,
            },
        });
        delete openReq.id;
        server.handleRequest(make_json(openReq));
        docCache{src} = uri;
        return uri;
    }

    # ─── Call Hierarchy helpers ───

    # Test source:
    # Line 0: %modern
    # Line 1: sub helper(int x) { return x + 1; }
    # Line 2: sub worker(int n) { return helper(n) + helper(n + 1); }
    # Line 3: sub main_func() { worker(5); }
    private string getCallHierarchyTestCode() {
        return "%modern
sub helper(int x) { return x + 1; }
sub worker(int n) { return helper(n) + helper(n + 1); }
sub main_func() { worker(5); }
";
    }

    private *list<auto> sendCallHierarchyPrepare(string uri, int line, int character) {
        hash<auto> req = makeRequest("textDocument/prepareCallHierarchy", {
            "textDocument": {"uri": uri},
            "position": {"line": line, "character": character},
        });
        softlist<auto> responses = server.handleRequest(make_json(req));
        if (!responses || !responses[0]) {
            return NOTHING;
        }
        hash<auto> resp = parse_json(responses[0]);
        return resp.result;
    }

    private *list<auto> sendIncoming(hash<auto> item) {
        hash<auto> req = makeRequest("callHierarchy/incomingCalls", {
            "item": item,
        });
        softlist<auto> responses = server.handleRequest(make_json(req));
        if (!responses || !responses[0]) {
            return NOTHING;
        }
        hash<auto> resp = parse_json(responses[0]);
        return resp.result;
    }

    private *list<auto> sendOutgoing(hash<auto> item) {
        hash<auto> req = makeRequest("callHierarchy/outgoingCalls", {
            "item": item,
        });
        softlist<auto> responses = server.handleRequest(make_json(req));
        if (!responses || !responses[0]) {
            return NOTHING;
        }
        hash<auto> resp = parse_json(responses[0]);
        return resp.result;
    }

    # ─── Definition helpers ───

    # Test source code:
    # Line 0: %modern
    # Line 1: class Calculator {
    # Line 2:     private { int total = 0; }
    # Line 3:     constructor(int initial) { total = initial; }
    # Line 4:     int add(int n) { total += n; return total; }
    # Line 5:     static int zero() { return 0; }
    # Line 6: }
    # Line 7: sub helper(int x) { return x + 1; }
    # Line 8: Calculator calc(10);
    # Line 9: calc.add(5);
    # Line 10: int result = helper(calc.add(3));
    # Line 11: Calculator::zero();
    # Line 12: foreach int item in ((1, 2, 3)) { printf("%d", item); }
    private string getDefinitionTestCode() {
        return "%modern
class Calculator {
    private { int total = 0; }
    constructor(int initial) { total = initial; }
    int add(int n) { total += n; return total; }
    static int zero() { return 0; }
}
sub helper(int x) { return x + 1; }
Calculator calc(10);
calc.add(5);
int result = helper(calc.add(3));
Calculator::zero();
foreach int item in ((1, 2, 3)) { printf(\"%d\", item); }
";
    }

    # Inheritance test source:
    # Line 0: %modern
    # Line 1: class Base {
    # Line 2:     private { int count = 0; }
    # Line 3:     int getValue() { return count; }
    # Line 4: }
    # Line 5: class Child inherits Base {
    # Line 6:     string getName() { return "child"; }
    # Line 7: }
    # Line 8: class GrandChild inherits Child {
    # Line 9:     bool isValid() { return True; }
    # Line 10: }
    # Line 11: sub test() {
    # Line 12:     Child c();
    # Line 13:     c.getValue();
    # Line 14:     c.count;
    # Line 15:     GrandChild gc();
    # Line 16:     gc.getValue();
    # Line 17: }
    private string getInheritanceCode() {
        return "%modern
class Base {
    private { int count = 0; }
    int getValue() { return count; }
}
class Child inherits Base {
    string getName() { return \"child\"; }
}
class GrandChild inherits Child {
    bool isValid() { return True; }
}
sub test() {
    Child c();
    c.getValue();
    c.count;
    GrandChild gc();
    gc.getValue();
}
";
    }

    # Constants test source:
    # Line 0: %modern
    # Line 1: class Base {
    # Line 2:     const VERSION = "1.0";
    # Line 3: }
    # Line 4: class Child inherits Base {}
    # Line 5: Child::VERSION;
    private string getConstantCode() {
        return "%modern
class Base {
    const VERSION = \"1.0\";
}
class Child inherits Base {}
Child::VERSION;
";
    }

    # Cross-doc test: XBase class in one document, XChild in another
    # (unique names to avoid conflicts with single-doc inheritance tests)
    # Base doc:
    # Line 0: %modern
    # Line 1: class XBase {
    # Line 2:     private { int xcount = 0; }
    # Line 3:     int xGetValue() { return xcount; }
    # Line 4: }
    private string getCrossDocBaseCode() {
        return "%modern
class XBase {
    private { int xcount = 0; }
    int xGetValue() { return xcount; }
}
";
    }

    # Child doc:
    # Line 0: %modern
    # Line 1: class XChild inherits XBase {
    # Line 2:     string xGetName() { return "child"; }
    # Line 3: }
    # Line 4: sub xtest() {
    # Line 5:     XChild c();
    # Line 6:     c.xGetValue();
    # Line 7:     c.xcount;
    # Line 8: }
    private string getCrossDocChildCode() {
        return "%modern
class XChild inherits XBase {
    string xGetName() { return \"child\"; }
}
sub xtest() {
    XChild c();
    c.xGetValue();
    c.xcount;
}
";
    }

    private *list<auto> sendDefinition(string uri, int line, int character) {
        hash<auto> req = makeRequest("textDocument/definition", {
            "textDocument": {"uri": uri},
            "position": {"line": line, "character": character},
        });
        softlist<auto> responses = server.handleRequest(make_json(req));
        if (!responses || !responses[0]) {
            return NOTHING;
        }
        hash<auto> resp = parse_json(responses[0]);
        return resp.result;
    }

    # ─── Implementation helpers ───

    # Test source:
    # Line 0: %modern
    # Line 1: class Shape {
    # Line 2:     abstract float area();
    # Line 3: }
    # Line 4: class Circle inherits Shape {
    # Line 5:     float radius;
    # Line 6:     float area() { return 3.14 * radius * radius; }
    # Line 7: }
    # Line 8: class Square inherits Shape {
    # Line 9:     float side;
    # Line 10:     float area() { return side * side; }
    # Line 11: }
    private string getImplementationTestCode() {
        return "%modern
class Shape {
    abstract float area();
}
class Circle inherits Shape {
    float radius;
    float area() { return 3.14 * radius * radius; }
}
class Square inherits Shape {
    float side;
    float area() { return side * side; }
}
";
    }

    private *list<auto> sendImplementation(string uri, int line, int character) {
        hash<auto> req = makeRequest("textDocument/implementation", {
            "textDocument": {"uri": uri},
            "position": {"line": line, "character": character},
        });
        softlist<auto> responses = server.handleRequest(make_json(req));
        if (!responses || !responses[0]) {
            return NOTHING;
        }
        hash<auto> resp = parse_json(responses[0]);
        return resp.result;
    }

    # ─── Type Definition helpers ───

    # Test source:
    # Line 0: %modern
    # Line 1: class Animal {
    # Line 2:     string name;
    # Line 3:     constructor(string n) { name = n; }
    # Line 4: }
    # Line 5: sub test() {
    # Line 6:     Animal pet("cat");
    # Line 7:     int count = 5;
    # Line 8:     auto val = pet;
    # Line 9: }
    # Line 10: sub helper(Animal a) { return a.name; }
    private string getTypeDefinitionTestCode() {
        return "%modern
class Animal {
    string name;
    constructor(string n) { name = n; }
}
sub test() {
    Animal pet(\"cat\");
    int count = 5;
    auto val = pet;
}
sub helper(Animal a) { return a.name; }
";
    }

    private *list<auto> sendTypeDefinition(string uri, int line, int character) {
        hash<auto> req = makeRequest("textDocument/typeDefinition", {
            "textDocument": {"uri": uri},
            "position": {"line": line, "character": character},
        });
        softlist<auto> responses = server.handleRequest(make_json(req));
        if (!responses || !responses[0]) {
            return NOTHING;
        }
        hash<auto> resp = parse_json(responses[0]);
        return resp.result;
    }

    # ─── Type Hierarchy helpers ───

    # Test source:
    # Line 0: %modern
    # Line 1: class Animal {
    # Line 2:     string name;
    # Line 3: }
    # Line 4: class Dog inherits Animal {
    # Line 5:     string breed;
    # Line 6: }
    # Line 7: class GoldenRetriever inherits Dog {
    # Line 8:     bool friendly = True;
    # Line 9: }
    # Line 10: class Cat inherits Animal {
    # Line 11:     bool indoor;
    # Line 12: }
    private string getTypeHierarchyTestCode() {
        return "%modern
class Animal {
    string name;
}
class Dog inherits Animal {
    string breed;
}
class GoldenRetriever inherits Dog {
    bool friendly = True;
}
class Cat inherits Animal {
    bool indoor;
}
";
    }

