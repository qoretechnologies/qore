%modern

%requires ../../../../qlib/QUnit.qm
%requires json
%requires ../../../../qlib/QLS

%exec-class CallHierarchyTest

class CallHierarchyTest inherits QUnit::Test {
    private {
        QLS::QLSServer server;
        int reqId = 0;
        int docCount = 0;
        hash<string, string> docCache;
    }

    constructor() : Test("QLS CallHierarchy", "1.0") {
        initServer();

        addTestCase("prepare on function", \testPrepareFunction());
        addTestCase("prepare on non-callable", \testPrepareNonCallable());
        addTestCase("incoming calls", \testIncomingCalls());
        addTestCase("outgoing calls", \testOutgoingCalls());
        addTestCase("no calls", \testNoCalls());
        addTestCase("missing params", \testMissingParams());

        set_return_value(main());
    }

    private initServer() {
        server = new QLS::QLSServer();

        hash<auto> initReq = makeRequest("initialize", {
            "processId": getpid(),
            "capabilities": {},
            "rootUri": NOTHING,
        });
        server.handleRequest(make_json(initReq));

        hash<auto> initializedReq = makeRequest("initialized");
        delete initializedReq.id;
        server.handleRequest(make_json(initializedReq));
    }

    # Test source:
    # Line 0: %modern
    # Line 1: sub helper(int x) { return x + 1; }
    # Line 2: sub worker(int n) { return helper(n) + helper(n + 1); }
    # Line 3: sub main_func() { worker(5); }
    private string getTestCode() {
        return "%modern
sub helper(int x) { return x + 1; }
sub worker(int n) { return helper(n) + helper(n + 1); }
sub main_func() { worker(5); }
";
    }

    private string setupDoc(*string text) {
        string src = text ?? getTestCode();
        *string cached = docCache{src};
        if (exists cached) {
            return cached;
        }
        string uri = sprintf("file:///test/callhier%d.q", ++docCount);
        hash<auto> openReq = makeRequest("textDocument/didOpen", {
            "textDocument": {
                "uri": uri,
                "languageId": "qore",
                "version": 1,
                "text": src,
            },
        });
        delete openReq.id;
        server.handleRequest(make_json(openReq));
        docCache{src} = uri;
        return uri;
    }

    private hash<auto> makeRequest(string method, *hash<auto> params) {
        return {
            "jsonrpc": "2.0",
            "id": ++reqId,
            "method": method,
            "params": params,
        };
    }

    private *list<auto> sendPrepare(string uri, int line, int character) {
        hash<auto> req = makeRequest("textDocument/prepareCallHierarchy", {
            "textDocument": {"uri": uri},
            "position": {"line": line, "character": character},
        });
        softlist<auto> responses = server.handleRequest(make_json(req));
        if (!responses || !responses[0]) {
            return NOTHING;
        }
        hash<auto> resp = parse_json(responses[0]);
        return resp.result;
    }

    private *list<auto> sendIncoming(hash<auto> item) {
        hash<auto> req = makeRequest("callHierarchy/incomingCalls", {
            "item": item,
        });
        softlist<auto> responses = server.handleRequest(make_json(req));
        if (!responses || !responses[0]) {
            return NOTHING;
        }
        hash<auto> resp = parse_json(responses[0]);
        return resp.result;
    }

    private *list<auto> sendOutgoing(hash<auto> item) {
        hash<auto> req = makeRequest("callHierarchy/outgoingCalls", {
            "item": item,
        });
        softlist<auto> responses = server.handleRequest(make_json(req));
        if (!responses || !responses[0]) {
            return NOTHING;
        }
        hash<auto> resp = parse_json(responses[0]);
        return resp.result;
    }

    testPrepareFunction() {
        string uri = setupDoc();

        # "helper" at line 1, col 4
        *list<auto> result = sendPrepare(uri, 1, 4);
        assertTrue(exists result && result.size() > 0,
            "prepare on function should return item");
        if (result) {
            assertEq("helper", result[0].name, "item should be named helper");
            assertEq(uri, result[0].uri, "URI should match");
        }
    }

    testPrepareNonCallable() {
        string uri = setupDoc();

        # Position on %modern at line 0, col 0
        *list<auto> result = sendPrepare(uri, 0, 0);
        # Should return null — not a callable
        if (result) {
            assertEq(0, result.size(), "non-callable should return empty");
        }
    }

    testIncomingCalls() {
        string uri = setupDoc();

        # Prepare on "helper" at line 1, col 4
        *list<auto> prepared = sendPrepare(uri, 1, 4);
        assertTrue(exists prepared && prepared.size() > 0, "should prepare helper");

        # Get incoming calls to helper
        *list<auto> incoming = sendIncoming(prepared[0]);
        assertTrue(exists incoming, "should return incoming calls");
        if (incoming && incoming.size() > 0) {
            # helper is called from worker
            assertTrue(incoming.size() >= 1,
                sprintf("helper should have at least 1 caller (got %d)", incoming.size()));
            # Check the caller is worker
            bool foundWorker = False;
            foreach hash<auto> call in (incoming) {
                if (call."from".name == "worker") {
                    foundWorker = True;
                    assertTrue(call.fromRanges.size() >= 2,
                        sprintf("worker should call helper at least 2 times (got %d)",
                            call.fromRanges.size()));
                }
            }
            assertTrue(foundWorker, "should find worker as caller");
        }
    }

    testOutgoingCalls() {
        string uri = setupDoc();

        # Prepare on "worker" at line 2, col 4
        *list<auto> prepared = sendPrepare(uri, 2, 4);
        assertTrue(exists prepared && prepared.size() > 0, "should prepare worker");

        # Get outgoing calls from worker
        *list<auto> outgoing = sendOutgoing(prepared[0]);
        assertTrue(exists outgoing, "should return outgoing calls");
        # worker calls helper
        if (outgoing && outgoing.size() > 0) {
            bool foundHelper = False;
            foreach hash<auto> call in (outgoing) {
                if (call."to".name == "helper") {
                    foundHelper = True;
                }
            }
            assertTrue(foundHelper, "worker should call helper");
        }
    }

    testNoCalls() {
        string code = "%modern
sub isolated() { return 42; }
";
        string uri = setupDoc(code);

        # Prepare on "isolated" at line 1, col 4
        *list<auto> prepared = sendPrepare(uri, 1, 4);
        assertTrue(exists prepared && prepared.size() > 0, "should prepare isolated");

        # No incoming calls
        *list<auto> incoming = sendIncoming(prepared[0]);
        assertEq(0, incoming.size(), "isolated function should have no callers");
    }

    testMissingParams() {
        hash<auto> req = makeRequest("textDocument/prepareCallHierarchy");
        delete req.params;
        softlist<auto> responses = server.handleRequest(make_json(req));
        assertTrue(exists responses && responses.size() > 0,
            "should return error response for missing params");
        hash<auto> resp = parse_json(responses[0]);
        assertTrue(exists resp.error, "response should have error field");
    }
}
