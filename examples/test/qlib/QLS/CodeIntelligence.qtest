    testInlayHintFunctionCallHints() {
        string uri = setupInlayHintDoc();

        # Get hints for line 3: add(1, 2) -- should have hints for 'a:' and 'b:'
        *list<auto> hints = sendInlayHint(uri, 3, 3);
        assertTrue(exists hints && hints.size() > 0,
            "should return hints for multi-arg call");
        # Verify hints have parameter kind (2)
        foreach hash<auto> hint in (hints) {
            assertEq(2, hint.kind, "hint should be parameter kind");
            assertTrue(hint.label.size() > 0, "hint label should not be empty");
            assertTrue(hint.paddingRight, "hint should have padding right");
        }
    }

    testInlayHintSingleArgNoHints() {
        string uri = setupInlayHintDoc();

        # Get hints for line 4: single(5) -- single-arg, should have no hints
        *list<auto> hints = sendInlayHint(uri, 4, 4);
        # Should be empty (single-arg calls are excluded)
        assertEq(0, hints.size(), "single-arg call should have no hints");
    }

    testInlayHintRangeFiltering() {
