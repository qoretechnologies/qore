%modern

%requires ../../../../qlib/QUnit.qm
%requires json
%requires ../../../../qlib/QLS

%exec-class TypeDefinitionTest

class TypeDefinitionTest inherits QUnit::Test {
    private {
        QLS::QLSServer server;
        int reqId = 0;
        int docCount = 0;
        hash<string, string> docCache;
    }

    constructor() : Test("QLS TypeDefinition", "1.0") {
        initServer();

        addTestCase("variable with class type", \testVariableClassType());
        addTestCase("parameter with class type", \testParameterClassType());
        addTestCase("primitive type returns empty", \testPrimitiveType());
        addTestCase("auto type returns empty", \testAutoType());
        addTestCase("untyped variable returns empty", \testUntypedVariable());
        addTestCase("nullable type strips prefix", \testNullableType());
        addTestCase("cross-doc type resolution", \testCrossDocType());
        addTestCase("missing params", \testMissingParams());
        addTestCase("non-existent document", \testNonExistentDocument());

        set_return_value(main());
    }

    private initServer() {
        server = new QLS::QLSServer();

        hash<auto> initReq = makeRequest("initialize", {
            "processId": getpid(),
            "capabilities": {},
            "rootUri": NOTHING,
        });
        server.handleRequest(make_json(initReq));

        hash<auto> initializedReq = makeRequest("initialized");
        delete initializedReq.id;
        server.handleRequest(make_json(initializedReq));
    }

    # Test source:
    # Line 0: %modern
    # Line 1: class Animal {
    # Line 2:     string name;
    # Line 3:     constructor(string n) { name = n; }
    # Line 4: }
    # Line 5: sub test() {
    # Line 6:     Animal pet("cat");
    # Line 7:     int count = 5;
    # Line 8:     auto val = pet;
    # Line 9: }
    # Line 10: sub helper(Animal a) { return a.name; }
    private string getTestCode() {
        return "%modern
class Animal {
    string name;
    constructor(string n) { name = n; }
}
sub test() {
    Animal pet(\"cat\");
    int count = 5;
    auto val = pet;
}
sub helper(Animal a) { return a.name; }
";
    }

    private string setupDoc(*string text) {
        string src = text ?? getTestCode();
        *string cached = docCache{src};
        if (exists cached) {
            return cached;
        }
        string uri = sprintf("file:///test/typedef%d.q", ++docCount);
        hash<auto> openReq = makeRequest("textDocument/didOpen", {
            "textDocument": {
                "uri": uri,
                "languageId": "qore",
                "version": 1,
                "text": src,
            },
        });
        delete openReq.id;
        server.handleRequest(make_json(openReq));
        docCache{src} = uri;
        return uri;
    }

    private hash<auto> makeRequest(string method, *hash<auto> params) {
        return {
            "jsonrpc": "2.0",
            "id": ++reqId,
            "method": method,
            "params": params,
        };
    }

    private *list<auto> sendTypeDefinition(string uri, int line, int character) {
        hash<auto> req = makeRequest("textDocument/typeDefinition", {
            "textDocument": {"uri": uri},
            "position": {"line": line, "character": character},
        });
        softlist<auto> responses = server.handleRequest(make_json(req));
        if (!responses || !responses[0]) {
            return NOTHING;
        }
        hash<auto> resp = parse_json(responses[0]);
        return resp.result;
    }

    testVariableClassType() {
        string uri = setupDoc();

        # "pet" at line 6, col 11 → type is Animal → class declaration at line 1
        *list<auto> result = sendTypeDefinition(uri, 6, 11);
        assertTrue(exists result && result.size() > 0,
            "variable 'pet' should resolve to type declaration");
        if (result) {
            assertEq(1, result[0].range.start.line,
                "type definition should point to Animal class at line 1");
        }
    }

    testParameterClassType() {
        string uri = setupDoc();

        # "a" at parameter declaration position: line 10, col 18 (in "sub helper(Animal a)")
        *list<auto> result = sendTypeDefinition(uri, 10, 18);
        assertTrue(exists result && result.size() > 0,
            "parameter 'a' should resolve to a type declaration");
        assertEq(1, result[0].range.start.line,
            "parameter type definition should point to Animal class");
    }

    testPrimitiveType() {
        string uri = setupDoc();

        # "count" at line 7, col 8 → type is int (primitive)
        *list<auto> result = sendTypeDefinition(uri, 7, 8);
        assertEq(0, result.size(),
            "primitive type 'int' should return empty result");
    }

    testAutoType() {
        string uri = setupDoc();

        # "val" at line 8, col 9 → type is auto
        *list<auto> result = sendTypeDefinition(uri, 8, 9);
        assertEq(0, result.size(),
            "'auto' type should return empty result");
    }

    testUntypedVariable() {
        string code = "%modern
sub test() {
    auto x = 5;
}
";
        string uri = setupDoc(code);

        # "x" at line 2, col 9 → auto type → empty
        *list<auto> result = sendTypeDefinition(uri, 2, 9);
        assertEq(0, result.size(),
            "untyped variable should return empty result");
    }

    testNullableType() {
        string code = "%modern
class MyType {
    int val;
}
sub test() {
    *MyType obj;
}
";
        string uri = setupDoc(code);

        # "obj" at line 5, col 12 → type is *MyType → should strip * and find MyType
        *list<auto> result = sendTypeDefinition(uri, 5, 12);
        assertTrue(exists result && result.size() > 0,
            "nullable type '*MyType' should resolve to a type declaration");
        assertEq(1, result[0].range.start.line,
            "nullable type should resolve to class declaration");
    }

    testCrossDocType() {
        # Type declaration in one doc
        string typeCode = "%modern
class Vehicle {
    string model;
}
";
        string typeUri = setupDoc(typeCode);

        # Usage in another doc
        string usageCode = "%modern
sub test() {
    Vehicle car();
}
";
        string usageUri = setupDoc(usageCode);

        # "car" at line 2, col 12 → type is Vehicle → should find Vehicle in other doc
        *list<auto> result = sendTypeDefinition(usageUri, 2, 12);
        assertTrue(exists result && result.size() > 0,
            "cross-doc type should resolve");
        if (result) {
            assertEq(typeUri, result[0].uri,
                "cross-doc type should point to type document");
            assertEq(1, result[0].range.start.line,
                "cross-doc type should point to Vehicle class at line 1");
        }
    }

    testMissingParams() {
        hash<auto> req = makeRequest("textDocument/typeDefinition");
        delete req.params;
        softlist<auto> responses = server.handleRequest(make_json(req));
        assertTrue(exists responses && responses.size() > 0,
            "should return error response for missing params");
        hash<auto> resp = parse_json(responses[0]);
        assertTrue(exists resp.error, "response should have error field");
    }

    testNonExistentDocument() {
        setupDoc();

        *list<auto> result = sendTypeDefinition("file:///nonexistent.q", 0, 0);
        assertEq(0, result.size(),
            "non-existent doc should return empty result");
    }
}
