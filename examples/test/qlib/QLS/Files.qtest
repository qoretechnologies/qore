%modern

%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/QLS

%exec-class FilesTest

class FilesTest inherits QUnit::Test {
    constructor() : Test("Files", "1.0") {
        addTestCase("QORE_EXTENSIONS constant", \testQoreExtensions());
        addTestCase("is_valid_qore_file by extension", \testIsValidByExtension());
        addTestCase("is_valid_qore_file by magic", \testIsValidByMagic());
        addTestCase("is_valid_qore_file by alt shebang", \testIsValidByAltShebang());
        addTestCase("is_valid_qore_file invalid", \testIsValidInvalid());
        addTestCase("is_valid_qore_file no ext no magic", \testIsValidNoExtNoMagic());
        addTestCase("is_valid_qore_file nonexistent", \testIsValidNonexistent());
        addTestCase("find_std_modules", \testFindStdModules());
        addTestCase("find_qore_files", \testFindQoreFiles());
        addTestCase("find_qore_files bad path", \testFindQoreFilesBadPath());

        set_return_value(main());
    }

    private string testDataDir() {
        return get_script_dir() + "/testdata/";
    }

    testQoreExtensions() {
        assertEq(Type::Hash, QLS::Files::QORE_EXTENSIONS.type());
        assertEq(True, QLS::Files::QORE_EXTENSIONS.hasKey("q"));
        assertEq(True, QLS::Files::QORE_EXTENSIONS.hasKey("qm"));
        assertEq(True, QLS::Files::QORE_EXTENSIONS.hasKey("qtest"));
        assertEq(True, QLS::Files::QORE_EXTENSIONS.hasKey("qr"));
    }

    testIsValidByExtension() {
        assertEq(True, QLS::Files::is_valid_qore_file(testDataDir() + "valid_qore_file.q"),
            "valid by .q extension");
        assertEq(True, QLS::Files::is_valid_qore_file(testDataDir() + "valid_qore_file.qr"),
            "valid by .qr extension");
    }

    testIsValidByMagic() {
        assertEq(True, QLS::Files::is_valid_qore_file(testDataDir() + "valid_qore_file"),
            "valid by magic header");
    }

    testIsValidByAltShebang() {
        assertEq(True, QLS::Files::is_valid_qore_file(testDataDir() + "valid_qore_file_alt_shebang"),
            "valid by alternative shebang");
    }

    testIsValidInvalid() {
        assertEq(False, QLS::Files::is_valid_qore_file(testDataDir() + "invalid_qore_file.txt"),
            "invalid by .txt extension");
    }

    testIsValidNoExtNoMagic() {
        assertEq(False, QLS::Files::is_valid_qore_file(testDataDir() + "no_ext_no_magic"),
            "invalid - no extension and no magic");
    }

    testIsValidNonexistent() {
        assertEq(False, QLS::Files::is_valid_qore_file(testDataDir() + "does_not_exist"),
            "nonexistent file returns False");
    }

    testFindStdModules() {
        list files = QLS::Files::find_std_modules();
        # there should be at least one module
        bool success = False;
        if (files.size()) {
            foreach auto f in (files) {
                success = success || QLS::Files::is_valid_qore_file(f);
            }
        }
        assertEq(True, success, "find_std_modules should find at least one valid file");
    }

    testFindQoreFiles() {
        list files = QLS::Files::find_qore_files(testDataDir());
        # should find the valid files in testdata
        assertGt(0, files.size(), "find_qore_files should find at least one file");
        # all found files should be valid
        foreach auto f in (files) {
            assertEq(True, QLS::Files::is_valid_qore_file(f),
                sprintf("found file should be valid: %s", f));
        }
    }

    testFindQoreFilesBadPath() {
        assertThrows("WORKSPACE-PATH-ERROR", sub() {
            QLS::Files::find_qore_files("/nonexistent/path/that/does/not/exist");
        });
    }
}
