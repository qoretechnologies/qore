%modern

%requires ../../../../qlib/QUnit.qm
%requires json
%requires ../../../../qlib/QLS

%exec-class TypeHierarchyTest

class TypeHierarchyTest inherits QUnit::Test {
    private {
        QLS::QLSServer server;
        int reqId = 0;
        int docCount = 0;
        hash<string, string> docCache;
    }

    constructor() : Test("QLS TypeHierarchy", "1.0") {
        initServer();

        addTestCase("prepare on class name", \testPrepareOnClass());
        addTestCase("prepare not on class", \testPrepareNotOnClass());
        addTestCase("single parent supertypes", \testSingleParent());
        addTestCase("multiple parents supertypes", \testMultipleParents());
        addTestCase("subtypes scan", \testSubtypes());
        addTestCase("no parent class", \testNoParent());
        addTestCase("cross-doc hierarchy", \testCrossDocHierarchy());
        addTestCase("missing params", \testMissingParams());

        set_return_value(main());
    }

    private initServer() {
        server = new QLS::QLSServer();

        hash<auto> initReq = makeRequest("initialize", {
            "processId": getpid(),
            "capabilities": {},
            "rootUri": NOTHING,
        });
        server.handleRequest(make_json(initReq));

        hash<auto> initializedReq = makeRequest("initialized");
        delete initializedReq.id;
        server.handleRequest(make_json(initializedReq));
    }

    # Test source:
    # Line 0: %modern
    # Line 1: class Animal {
    # Line 2:     string name;
    # Line 3: }
    # Line 4: class Dog inherits Animal {
    # Line 5:     string breed;
    # Line 6: }
    # Line 7: class GoldenRetriever inherits Dog {
    # Line 8:     bool friendly = True;
    # Line 9: }
    # Line 10: class Cat inherits Animal {
    # Line 11:     bool indoor;
    # Line 12: }
    private string getTestCode() {
        return "%modern
class Animal {
    string name;
}
class Dog inherits Animal {
    string breed;
}
class GoldenRetriever inherits Dog {
    bool friendly = True;
}
class Cat inherits Animal {
    bool indoor;
}
";
    }

    private string setupDoc(*string text) {
        string src = text ?? getTestCode();
        *string cached = docCache{src};
        if (exists cached) {
            return cached;
        }
        string uri = sprintf("file:///test/typehier%d.q", ++docCount);
        hash<auto> openReq = makeRequest("textDocument/didOpen", {
            "textDocument": {
                "uri": uri,
                "languageId": "qore",
                "version": 1,
                "text": src,
            },
        });
        delete openReq.id;
        server.handleRequest(make_json(openReq));
        docCache{src} = uri;
        return uri;
    }

    private hash<auto> makeRequest(string method, *hash<auto> params) {
        return {
            "jsonrpc": "2.0",
            "id": ++reqId,
            "method": method,
            "params": params,
        };
    }

    private *list<auto> sendPrepare(string uri, int line, int character) {
        hash<auto> req = makeRequest("textDocument/prepareTypeHierarchy", {
            "textDocument": {"uri": uri},
            "position": {"line": line, "character": character},
        });
        softlist<auto> responses = server.handleRequest(make_json(req));
        if (!responses || !responses[0]) {
            return NOTHING;
        }
        hash<auto> resp = parse_json(responses[0]);
        return resp.result;
    }

    private *list<auto> sendSupertypes(hash<auto> item) {
        hash<auto> req = makeRequest("typeHierarchy/supertypes", {
            "item": item,
        });
        softlist<auto> responses = server.handleRequest(make_json(req));
        if (!responses || !responses[0]) {
            return NOTHING;
        }
        hash<auto> resp = parse_json(responses[0]);
        return resp.result;
    }

    private *list<auto> sendSubtypes(hash<auto> item) {
        hash<auto> req = makeRequest("typeHierarchy/subtypes", {
            "item": item,
        });
        softlist<auto> responses = server.handleRequest(make_json(req));
        if (!responses || !responses[0]) {
            return NOTHING;
        }
        hash<auto> resp = parse_json(responses[0]);
        return resp.result;
    }

    testPrepareOnClass() {
        string uri = setupDoc();

        # "Dog" at line 4, col 6
        *list<auto> result = sendPrepare(uri, 4, 6);
        assertTrue(exists result && result.size() > 0,
            "prepare on class name should return item");
        if (result) {
            assertEq("Dog", result[0].name, "item should be named Dog");
            assertEq(5, result[0].kind, "kind should be Class (5)");
            assertEq(uri, result[0].uri, "URI should match");
        }
    }

    testPrepareNotOnClass() {
        string uri = setupDoc();

        # On "name" member at line 2, col 11
        *list<auto> result = sendPrepare(uri, 2, 11);
        # Should be NOTHING or empty — not a class
        if (result) {
            assertEq(0, result.size(), "prepare on non-class should return empty");
        }
    }

    testSingleParent() {
        string uri = setupDoc();

        # Prepare on Dog at line 4, col 6
        *list<auto> prepared = sendPrepare(uri, 4, 6);
        assertTrue(exists prepared && prepared.size() > 0, "should prepare Dog");

        # Get supertypes
        *list<auto> supers = sendSupertypes(prepared[0]);
        assertTrue(exists supers && supers.size() > 0,
            "Dog should have supertypes");
        assertEq(1, supers.size(), "Dog should have 1 supertype");
        assertEq("Animal", supers[0].name, "Dog's supertype should be Animal");
    }

    testMultipleParents() {
        string code = "%modern
class Flyable {
    fly() {}
}
class Swimmable {
    swim() {}
}
class Duck inherits Flyable, Swimmable {
    quack() {}
}
";
        string uri = setupDoc(code);

        # Prepare on Duck at line 7, col 6
        *list<auto> prepared = sendPrepare(uri, 7, 6);
        assertTrue(exists prepared && prepared.size() > 0, "should prepare Duck");

        # Get supertypes
        *list<auto> supers = sendSupertypes(prepared[0]);
        assertTrue(exists supers && supers.size() >= 2,
            "Duck should have at least 2 supertypes");
    }

    testSubtypes() {
        string uri = setupDoc();

        # Prepare on Animal at line 1, col 6
        *list<auto> prepared = sendPrepare(uri, 1, 6);
        assertTrue(exists prepared && prepared.size() > 0, "should prepare Animal");

        # Get subtypes
        *list<auto> subs = sendSubtypes(prepared[0]);
        assertTrue(exists subs && subs.size() >= 2,
            "Animal should have at least 2 subtypes (Dog and Cat)");

        # Check names
        list<string> subNames = map $1.name, subs;
        assertTrue(subNames.contains("Dog"), "subtypes should include Dog");
        assertTrue(subNames.contains("Cat"), "subtypes should include Cat");
    }

    testNoParent() {
        string uri = setupDoc();

        # Prepare on Animal at line 1, col 6
        *list<auto> prepared = sendPrepare(uri, 1, 6);
        assertTrue(exists prepared && prepared.size() > 0, "should prepare Animal");

        # Get supertypes — Animal has no parent
        *list<auto> supers = sendSupertypes(prepared[0]);
        assertEq(0, supers.size(), "Animal should have 0 supertypes");
    }

    testCrossDocHierarchy() {
        # Base in one doc
        string baseCode = "%modern
class THBase {
    int val;
}
";
        string baseUri = setupDoc(baseCode);

        # Child in another doc
        string childCode = "%modern
class THChild inherits THBase {
    string name;
}
";
        string childUri = setupDoc(childCode);

        # Prepare on THChild at line 1, col 6
        *list<auto> prepared = sendPrepare(childUri, 1, 6);
        assertTrue(exists prepared && prepared.size() > 0, "should prepare THChild");

        # Get supertypes — should find THBase in other doc
        *list<auto> supers = sendSupertypes(prepared[0]);
        assertTrue(exists supers && supers.size() > 0,
            "THChild should have supertypes");
        assertEq("THBase", supers[0].name, "supertype should be THBase");
        assertEq(baseUri, supers[0].uri, "supertype URI should point to base doc");
    }

    testMissingParams() {
        hash<auto> req = makeRequest("textDocument/prepareTypeHierarchy");
        delete req.params;
        softlist<auto> responses = server.handleRequest(make_json(req));
        assertTrue(exists responses && responses.size() > 0,
            "should return error response for missing params");
        hash<auto> resp = parse_json(responses[0]);
        assertTrue(exists resp.error, "response should have error field");
    }
}
