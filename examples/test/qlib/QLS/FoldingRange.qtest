%modern

%requires ../../../../qlib/QUnit.qm
%requires json
%requires ../../../../qlib/QLS

%exec-class FoldingRangeTest

class FoldingRangeTest inherits QUnit::Test {
    private {
        QLS::QLSServer server;
        int reqId = 0;
        int docCount = 0;
        hash<string, string> docCache;
    }

    constructor() : Test("QLS FoldingRange", "1.0") {
        initServer();

        addTestCase("capability advertised", \testCapability());
        addTestCase("class with methods", \testClassWithMethods());
        addTestCase("namespace folds", \testNamespace());
        addTestCase("control flow folds", \testControlFlow());
        addTestCase("block comments fold", \testBlockComments());
        addTestCase("single-line nodes excluded", \testSingleLineExcluded());
        addTestCase("empty document", \testEmptyDocument());
        addTestCase("missing params", \testMissingParams());
        addTestCase("non-existent document", \testNonExistentDocument());
        addTestCase("folding range structure", \testFoldingRangeStructure());
        addTestCase("parse error document", \testParseErrorDocument());

        set_return_value(main());
    }

    private initServer() {
        server = new QLS::QLSServer();

        hash<auto> initReq = makeRequest("initialize", {
            "processId": getpid(),
            "capabilities": {},
            "rootUri": NOTHING,
        });
        server.handleRequest(make_json(initReq));

        hash<auto> initializedReq = makeRequest("initialized");
        delete initializedReq.id;
        server.handleRequest(make_json(initializedReq));
    }

    #! Opens a document on the shared server, caching by content; returns the URI
    private string setupDoc(string text) {
        *string cached = docCache{text};
        if (exists cached) {
            return cached;
        }
        string uri = sprintf("file:///test/fold%d.q", ++docCount);
        hash<auto> openReq = makeRequest("textDocument/didOpen", {
            "textDocument": {
                "uri": uri,
                "languageId": "qore",
                "version": 1,
                "text": text,
            },
        });
        delete openReq.id;
        server.handleRequest(make_json(openReq));
        docCache{text} = uri;
        return uri;
    }

    private hash<auto> makeRequest(string method, *hash<auto> params) {
        return {
            "jsonrpc": "2.0",
            "id": ++reqId,
            "method": method,
            "params": params,
        };
    }

    private *list<auto> sendFoldingRange(string uri) {
        hash<auto> req = makeRequest("textDocument/foldingRange", {
            "textDocument": {"uri": uri},
        });
        softlist<auto> responses = server.handleRequest(make_json(req));
        if (!responses || !responses[0]) {
            return NOTHING;
        }
        hash<auto> resp = parse_json(responses[0]);
        return resp.result;
    }

    testCapability() {
        assertEq(True, QLS::ServerCapabilities.foldingRangeProvider,
            "foldingRangeProvider should be True");
    }

    testClassWithMethods() {
        string text = "%modern\nclass Foo {\n    int getValue() {\n        return 1;\n    }\n}\n";
        string uri = setupDoc(text);

        *list<auto> ranges = sendFoldingRange(uri);
        assertTrue(exists ranges, "should return folding ranges");
        assertTrue(ranges.size() >= 2, sprintf("should have at least 2 ranges (class + method), got %d",
            ranges.size()));

        # Find the class range (starts at line 1 "class Foo {")
        *hash<auto> classRange;
        *hash<auto> methodRange;
        foreach hash<auto> r in (ranges) {
            if (r.startLine == 1 && r.kind == "region") {
                classRange = r;
            } else if (r.startLine == 2 && r.kind == "region") {
                methodRange = r;
            }
        }

        assertTrue(exists classRange, "should have a class folding range at line 1");
        assertEq(5, classRange.endLine, "class range should end at line 5");

        assertTrue(exists methodRange, "should have a method folding range at line 2");
        assertEq(4, methodRange.endLine, "method range should end at line 4");
    }

    testNamespace() {
        string text = "%modern\npublic namespace MyNs {\n    our int x = 1;\n}\n";
        string uri = setupDoc(text);

        *list<auto> ranges = sendFoldingRange(uri);
        assertTrue(exists ranges, "should return folding ranges");

        # Find namespace range
        *hash<auto> nsRange;
        foreach hash<auto> r in (ranges) {
            if (r.startLine == 1 && r.kind == "region") {
                nsRange = r;
            }
        }
        assertTrue(exists nsRange, "should have a namespace folding range");
        assertEq(3, nsRange.endLine, "namespace range should end at line 3");
    }

    testControlFlow() {
        string text = "%modern\nsub test() {\n    if (True) {\n        int x = 1;\n    }\n}\n";
        string uri = setupDoc(text);

        *list<auto> ranges = sendFoldingRange(uri);
        assertTrue(exists ranges, "should return folding ranges");

        # Should have at least function + if_statement
        list<auto> regionRanges = select ranges, $1.kind == "region";
        assertTrue(regionRanges.size() >= 2,
            sprintf("should have at least 2 region ranges (function + if), got %d", regionRanges.size()));
    }

    testBlockComments() {
        string text = "%modern\n/*\n * Multi-line\n * block comment\n */\nint x = 1;\n";
        string uri = setupDoc(text);

        *list<auto> ranges = sendFoldingRange(uri);
        assertTrue(exists ranges, "should return folding ranges");

        # Find comment range
        *hash<auto> commentRange;
        foreach hash<auto> r in (ranges) {
            if (r.kind == "comment") {
                commentRange = r;
            }
        }
        assertTrue(exists commentRange, "should have a comment folding range");
        assertTrue(commentRange.endLine > commentRange.startLine,
            "comment range should span multiple lines");
    }

    testSingleLineExcluded() {
        # A function on a single line should not produce a folding range
        string text = "%modern\nsub foo() { return 1; }\n";
        string uri = setupDoc(text);

        *list<auto> ranges = sendFoldingRange(uri);
        # Verify no single-line ranges exist
        int singleLineCount = 0;
        if (ranges) {
            foreach hash<auto> r in (ranges) {
                if (r.endLine <= r.startLine) {
                    ++singleLineCount;
                }
            }
        }
        assertEq(0, singleLineCount, "should have no single-line folding ranges");
    }

    testEmptyDocument() {
        string uri = setupDoc("");

        *list<auto> ranges = sendFoldingRange(uri);
        assertEq(0, ranges.size(), "should return empty list for empty document");
    }

    testMissingParams() {
        QLS::QLSServer errorServer();

        hash<auto> initReq = makeRequest("initialize", {
            "processId": getpid(),
            "capabilities": {},
            "rootUri": NOTHING,
        });
        errorServer.handleRequest(make_json(initReq));

        hash<auto> initializedReq = makeRequest("initialized");
        delete initializedReq.id;
        errorServer.handleRequest(make_json(initializedReq));

        hash<auto> req = makeRequest("textDocument/foldingRange");
        delete req.params;
        softlist<auto> responses = errorServer.handleRequest(make_json(req));
        assertTrue(exists responses, "should return error response for missing params");
        assertTrue(responses.size() > 0, "should have at least one response");
        hash<auto> resp = parse_json(responses[0]);
        assertTrue(exists resp.error, "response should have error field");
    }

    testNonExistentDocument() {
        string text = "%modern\nclass Foo {}\n";
        setupDoc(text);

        hash<auto> req = makeRequest("textDocument/foldingRange", {
            "textDocument": {"uri": "file:///nonexistent.q"},
        });
        softlist<auto> responses = server.handleRequest(make_json(req));
        assertTrue(exists responses, "should return response for non-existent document");
        hash<auto> resp = parse_json(responses[0]);
        assertEq(0, resp.result.size(), "should return empty list for non-existent document");
    }

    testParseErrorDocument() {
        # Document with parse errors should still return foldable ranges or empty list
        string text = "%modern\nclass Foo {\n    broken syntax\n}\n";
        string uri = setupDoc(text);

        *list<auto> ranges = sendFoldingRange(uri);
        # tree-sitter produces partial parse; verify result contains only valid ranges
        if (ranges) {
            foreach hash<auto> r in (ranges) {
                assertTrue(r.endLine > r.startLine,
                    "any range in parse-error doc should span multiple lines");
            }
        } else {
            assertEq(0, ranges.size(), "should return empty list for parse-error document");
        }
    }

    testFoldingRangeStructure() {
        # Verify all ranges have required fields
        string text = "%modern\nclass Foo {\n    int getValue() {\n        return 1;\n    }\n}\n";
        string uri = setupDoc(text);

        *list<auto> ranges = sendFoldingRange(uri);
        assertTrue(exists ranges && ranges.size() > 0, "should have ranges");

        foreach hash<auto> r in (ranges) {
            assertTrue(exists r.startLine, "range should have startLine");
            assertTrue(exists r.endLine, "range should have endLine");
            assertTrue(exists r.kind, "range should have kind");
            assertTrue(r.kind == "region" || r.kind == "comment",
                sprintf("kind should be 'region' or 'comment', got '%s'", r.kind));
            assertTrue(r.endLine > r.startLine,
                sprintf("endLine (%d) should be > startLine (%d)", r.endLine, r.startLine));
        }
    }
}
