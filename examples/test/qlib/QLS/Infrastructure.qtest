%modern

%disable-warning unreferenced-variable

%requires ../../../../qlib/QUnit.qm
%requires json
%requires ../../../../qlib/QLS

%exec-class InfrastructureTest

class InfrastructureTest inherits QUnit::Test {
    private {
        QLS::QLSServer server;
        int reqId = 0;
        int docCount = 0;
        hash<string, string> docCache;
    }

    constructor() : Test("QLS Infrastructure", "1.0") {
        initServer();

        # QLSMetadata tests
        addTestCase("metadata loaded at init", \testMetadataLoaded());
        addTestCase("resolve provider capability", \testResolveProviderCapability());
        addTestCase("hover — builtin class", \testHoverBuiltinClass());
        addTestCase("hover — builtin function", \testHoverBuiltinFunction());
        addTestCase("hover — user-defined symbol not affected", \testHoverUserDefined());
        addTestCase("hover — unknown symbol returns empty", \testHoverUnknown());
        addTestCase("completion — builtin class in visible symbols", \testCompletionBuiltinClass());
        addTestCase("completion — dot access on builtin type", \testCompletionDotBuiltin());
        addTestCase("completion — scope access on builtin class", \testCompletionScopeBuiltin());
        addTestCase("completion resolve — enriches with documentation", \testCompletionResolve());
        addTestCase("completion resolve — no data returns as-is", \testCompletionResolveNoData());
        addTestCase("signature help — builtin function", \testSignatureHelpBuiltinFunction());
        addTestCase("signature help — builtin method", \testSignatureHelpBuiltinMethod());
        addTestCase("signature help — user function still works", \testSignatureHelpUserFunction());
        addTestCase("no metadata dir — graceful", \testNoMetadataGraceful());

        # SymbolInfoKinds tests
        addTestCase("ASTSymbolKind constants", \testASTSymbolKind());
        addTestCase("ASTSymbolUsageKind constants", \testASTSymbolUsageKind());
        addTestCase("SymbolUsageStringMap", \testSymbolUsageStringMap());
        addTestCase("SymbolUsageFastMap", \testSymbolUsageFastMap());

        # ParamValidator tests
        addTestCase("required - missing key", \testRequiredMissing());
        addTestCase("required - wrong type", \testRequiredWrongType());
        addTestCase("required - valid", \testRequiredValid());
        addTestCase("initializeParams - valid", \testInitializeParamsValid());
        addTestCase("initializeParams - missing processId", \testInitializeParamsMissingPid());
        addTestCase("textDocumentIdentifier - valid", \testTextDocIdentValid());
        addTestCase("textDocumentIdentifier - missing", \testTextDocIdentMissing());
        addTestCase("textDocumentItem - valid", \testTextDocItemValid());
        addTestCase("textDocumentItem - missing fields", \testTextDocItemMissing());
        addTestCase("versionedTextDocumentIdentifier", \testVersionedTextDoc());
        addTestCase("textDocumentPositionParams - valid", \testTextDocPosValid());
        addTestCase("textDocumentPositionParams - missing position", \testTextDocPosMissing());
        addTestCase("didChangeConfigParams", \testDidChangeConfig());
        addTestCase("didChangeWatchedFilesParams - valid", \testDidChangeWatchedFiles());
        addTestCase("didChangeWatchedFilesParams - invalid event", \testDidChangeWatchedFilesInvalid());
        addTestCase("referenceParams", \testReferenceParams());
        addTestCase("workspaceSymbolParams", \testWorkspaceSymbolParams());

        # ErrorResponse tests
        addTestCase("ErrorCodes constants", \testErrorCodes());
        addTestCase("notInitialized", \testNotInitialized());
        addTestCase("invalidRequest", \testInvalidRequest());
        addTestCase("invalidRequest with message", \testInvalidRequestWithMessage());
        addTestCase("methodNotFound", \testMethodNotFound());
        addTestCase("internalError", \testInternalError());
        addTestCase("internalError with message", \testInternalErrorWithMessage());
        addTestCase("invalidParams", \testInvalidParams());
        addTestCase("nonExistentDocument", \testNonExistentDocument());

        # Notification tests
        addTestCase("MessageType constants", \testMessageType());
        addTestCase("diagnostics notification", \testDiagnostics());
        addTestCase("diagnostics empty", \testDiagnosticsEmpty());
        addTestCase("showMessage notification", \testShowMessage());

        set_return_value(main());
    }

    # ==========================================
    # Shared helpers
    # ==========================================

    private initServer() {
        server = new QLS::QLSServer();

        hash<auto> initReq = makeRequest("initialize", {
            "processId": getpid(),
            "capabilities": {},
            "rootUri": NOTHING,
        });
        server.handleRequest(make_json(initReq));

        hash<auto> initializedReq = makeRequest("initialized");
        delete initializedReq.id;
        server.handleRequest(make_json(initializedReq));
    }

    private string setupDoc(string text) {
        *string cached = docCache{text};
        if (exists cached) {
            return cached;
        }
        string uri = sprintf("file:///test/meta%d.q", ++docCount);
        hash<auto> openReq = makeRequest("textDocument/didOpen", {
            "textDocument": {
                "uri": uri,
                "languageId": "qore",
                "version": 1,
                "text": text,
            },
        });
        delete openReq.id;
        server.handleRequest(make_json(openReq));
        docCache{text} = uri;
        return uri;
    }

    private hash<auto> makeRequest(string method, *hash<auto> params) {
        return {
            "jsonrpc": "2.0",
            "id": ++reqId,
            "method": method,
            "params": params,
        };
    }

    # ==========================================
    # QLSMetadata helpers
    # ==========================================

    private hash<auto> sendHover(string uri, int line, int character) {
        hash<auto> req = makeRequest("textDocument/hover", {
            "textDocument": {"uri": uri},
            "position": {"line": line, "character": character},
        });
        softlist<auto> responses = server.handleRequest(make_json(req));
        if (!responses || !responses[0]) {
            return {"contents": ()};
        }
        hash<auto> resp = parse_json(responses[0]);
        return resp.result ?? {"contents": ()};
    }

    private hash<auto> sendCompletion(string uri, int line, int character) {
        hash<auto> req = makeRequest("textDocument/completion", {
            "textDocument": {"uri": uri},
            "position": {"line": line, "character": character},
        });
        softlist<auto> responses = server.handleRequest(make_json(req));
        if (!responses || !responses[0]) {
            return {"isIncomplete": False, "items": ()};
        }
        hash<auto> resp = parse_json(responses[0]);
        return resp.result;
    }

    private hash<auto> sendCompletionResolve(hash<auto> item) {
        hash<auto> req = makeRequest("completionItem/resolve", item);
        softlist<auto> responses = server.handleRequest(make_json(req));
        if (!responses || !responses[0]) {
            return item;
        }
        hash<auto> resp = parse_json(responses[0]);
        return resp.result;
    }

    private hash<auto> sendSignatureHelp(string uri, int line, int character) {
        hash<auto> req = makeRequest("textDocument/signatureHelp", {
            "textDocument": {"uri": uri},
            "position": {"line": line, "character": character},
        });
        softlist<auto> responses = server.handleRequest(make_json(req));
        if (!responses || !responses[0]) {
            return {"signatures": (), "activeSignature": 0, "activeParameter": 0};
        }
        hash<auto> resp = parse_json(responses[0]);
        return resp.result;
    }

    # ==========================================
    # ParamValidator helpers
    # ==========================================

    private hash baseRequest() {
        return {"jsonrpc": "2.0", "id": 1, "method": "test"};
    }

    # ==========================================
    # QLSMetadata tests
    # ==========================================

    testMetadataLoaded() {
        # The server should have loaded metadata during initialization
        # We can verify by hovering over a known builtin — if metadata loaded,
        # we'll get results; this is an indirect test
        # Use a source that references "Mutex" — a well-known builtin class
        string text = "%modern\nsub test() {\n    Mutex m();\n}\n";
        string uri = setupDoc(text);

        # Line 2: "    Mutex m();"  cursor on "Mutex" at col 4-9
        hash<auto> result = sendHover(uri, 2, 5);
        # Verify we got a valid response structure (even if no hover content)
        assertEq(Type::List, result.contents.type(), "hover returns a list for contents");
    }

    testResolveProviderCapability() {
        assertEq(True, QLS::ServerCapabilities.completionProvider.resolveProvider,
            "completionProvider.resolveProvider should be True");
    }

    testHoverBuiltinClass() {
        # Source referencing Mutex — a builtin class
        string text = "%modern\nsub test() {\n    Mutex m();\n}\n";
        string uri = setupDoc(text);

        # Hover over "Mutex" at line 2, col 5
        hash<auto> result = sendHover(uri, 2, 5);
        if (result.contents && result.contents.size()) {
            # verify content mentions "Mutex" or "class"
            string content = result.contents[0];
            assertTrue(content.find("Mutex") >= 0 || content.find("class") >= 0,
                sprintf("hover for Mutex should mention 'Mutex' or 'class': got '%s'",
                    content.substr(0, 200)));
        } else {
            # metadata might not be available (no QORE_METADATA_DIR) — that's OK
            testSkip("builtin metadata not available (no .meta.json files found)");
        }
    }

    testHoverBuiltinFunction() {
        # Source calling printf — a builtin function
        string text = "%modern\nsub test() {\n    printf(\"hello %s\", \"world\");\n}\n";
        string uri = setupDoc(text);

        # Hover over "printf" at line 2, col 6
        hash<auto> result = sendHover(uri, 2, 6);
        if (result.contents && result.contents.size()) {
            string content = result.contents[0];
            assertTrue(content.find("printf") >= 0,
                sprintf("hover for printf should mention 'printf': got '%s'",
                    content.substr(0, 200)));
        } else {
            testSkip("builtin metadata not available");
        }
    }

    testHoverUserDefined() {
        # User-defined class — hover should work via CST, not metadata
        string text = "%modern\nclass MyFoo {\n    int getValue() { return 42; }\n}\n"
            "sub test() {\n    MyFoo f();\n}\n";
        string uri = setupDoc(text);

        # Hover over "MyFoo" at line 5, col 5
        hash<auto> result = sendHover(uri, 5, 5);
        # Should return a valid response structure
        assertEq(Type::List, result.contents.type(), "hover returns a list for contents");
    }

    testHoverUnknown() {
        string text = "%modern\nsub test() {\n    int x = 42;\n}\n";
        string uri = setupDoc(text);

        # Hover over "42" — not a symbol, should return empty contents
        hash<auto> result = sendHover(uri, 2, 13);
        assertEq(Type::List, result.contents.type(), "hover returns a list for contents");
    }

    testCompletionBuiltinClass() {
        # Source with partial typing — "Mut" should suggest "Mutex" from metadata
        string text = "%modern\nsub test() {\n    Mut\n}\n";
        string uri = setupDoc(text);

        # Complete at line 2, col 7 (after "Mut")
        hash<auto> result = sendCompletion(uri, 2, 7);
        if (result.items.size()) {
            hash<string, bool> labels;
            foreach hash<auto> item in (result.items) {
                labels{item.label} = True;
            }
            if (labels{"Mutex"}) {
                assertEq(True, labels{"Mutex"}, "Mutex found in completion results");
            } else {
                # May not be available if metadata wasn't loaded
                testSkip("Mutex not found in completions (metadata may not be available)");
            }
        } else {
            testSkip("no completion results (metadata may not be available)");
        }
    }

    testCompletionDotBuiltin() {
        # Source with a Mutex variable and dot access
        string text = "%modern\nsub test() {\n    Mutex m();\n    m.lock();\n}\n";
        string uri = setupDoc(text);

        # Complete at line 3, col 6 (after "m.lo")
        # We need a valid expression — complete after "m."
        hash<auto> result = sendCompletion(uri, 3, 6);
        if (result.items.size()) {
            hash<string, bool> labels;
            foreach hash<auto> item in (result.items) {
                labels{item.label} = True;
            }
            if (labels{"lock"}) {
                assertTrue(True, "lock() found in dot access completion");
            } else {
                # Dot completion for builtins depends on type resolution + metadata
                testSkip("lock not found in dot completions (type resolution may not work for builtins)");
            }
        } else {
            testSkip("no dot completion results");
        }
    }

    testCompletionScopeBuiltin() {
        # Test scope completion on a builtin class — Mutex::
        string text = "%modern\nsub test() {\n    Mutex::lock();\n}\n";
        string uri = setupDoc(text);

        # Complete at line 2, col 10 (after "Mutex::l")
        hash<auto> result = sendCompletion(uri, 2, 10);
        # Verify valid response structure
        assertEq(Type::List, result.items.type(), "scope completion returns a list of items");
    }

    testCompletionResolve() {
        # Resolve a completion item — should enrich with documentation
        hash<auto> item = {
            "label": "Mutex",
            "kind": 7,  # Class
            "data": {
                "name": "Mutex",
                "symbolKind": "class",
            },
        };

        hash<auto> resolved = sendCompletionResolve(item);
        assertEq("Mutex", resolved.label, "label should be preserved");
        if (resolved.documentation) {
            assertTrue(resolved.documentation.value.find("Mutex") >= 0
                || resolved.documentation.value.find("class") >= 0,
                "resolved documentation should mention Mutex");
        } else {
            testSkip("no documentation from resolve (metadata may not be available)");
        }
    }

    testCompletionResolveNoData() {
        # Item without data field should return as-is
        hash<auto> item = {
            "label": "myLocalVar",
            "kind": 6,  # Variable
        };

        hash<auto> resolved = sendCompletionResolve(item);
        assertEq("myLocalVar", resolved.label, "label should be preserved");
    }

    testSignatureHelpBuiltinFunction() {
        # Source calling printf — a builtin function
        string text = "%modern\nsub test() {\n    printf(\"hello\");\n}\n";
        string uri = setupDoc(text);

        # Signature help at line 2, col 11 (after "printf(")
        hash<auto> result = sendSignatureHelp(uri, 2, 11);
        if (result.signatures.size()) {
            hash<auto> sig = result.signatures[0];
            assertTrue(sig.label.find("printf") >= 0,
                sprintf("signature label should contain 'printf': got '%s'", sig.label));
            assertTrue(sig.parameters.size() > 0,
                "printf should have parameters from metadata");
        } else {
            testSkip("no signature for printf (metadata may not be available)");
        }
    }

    testSignatureHelpBuiltinMethod() {
        # Source calling mutex.lock() — builtin method
        string text = "%modern\nsub test() {\n    Mutex m();\n    m.lock(500);\n}\n";
        string uri = setupDoc(text);

        # Signature help at line 3, col 11 (after "m.lock(")
        hash<auto> result = sendSignatureHelp(uri, 3, 11);
        if (result.signatures.size()) {
            hash<auto> sig = result.signatures[0];
            assertTrue(sig.label.find("lock") >= 0,
                sprintf("signature label should contain 'lock': got '%s'", sig.label));
        } else {
            # Method resolution depends on type inference + metadata
            testSkip("no signature for lock() (type resolution may not work for builtins)");
        }
    }

    testSignatureHelpUserFunction() {
        # User-defined function — should still work via CST
        string text = "%modern\nsub myFunc(int x, string y) { return; }\n"
            "sub caller() { myFunc(1, \"hello\"); }\n";
        string uri = setupDoc(text);

        # Line 2: "sub caller() { myFunc(1, "hello"); }" — col 22 after "myFunc("
        hash<auto> result = sendSignatureHelp(uri, 2, 22);
        assertTrue(result.signatures.size() > 0,
            "should find signature for user-defined function");
        hash<auto> sig = result.signatures[0];
        assertTrue(sig.label.find("myFunc") >= 0,
            "signature should contain 'myFunc'");
        assertEq(2, sig.parameters.size(), "myFunc should have 2 parameters");
    }

    testNoMetadataGraceful() {
        # Create a fresh server with a nonexistent metadata dir
        # This tests that when metadata is not available, everything degrades gracefully
        QLS::QLSServer freshServer();

        hash<auto> initReq = makeRequest("initialize", {
            "processId": getpid(),
            "capabilities": {},
            "rootUri": NOTHING,
        });
        # Should not crash even if metadata loading fails
        freshServer.handleRequest(make_json(initReq));

        hash<auto> initializedReq = makeRequest("initialized");
        delete initializedReq.id;
        freshServer.handleRequest(make_json(initializedReq));

        # Open a document and try hover/completion/signature
        string uri = "file:///test/graceful.q";
        hash<auto> openReq = makeRequest("textDocument/didOpen", {
            "textDocument": {
                "uri": uri,
                "languageId": "qore",
                "version": 1,
                "text": "%modern\nsub test() {\n    printf(\"hello\");\n}\n",
            },
        });
        delete openReq.id;
        freshServer.handleRequest(make_json(openReq));

        # Hover should return a valid JSON-RPC response
        hash<auto> hoverReq = makeRequest("textDocument/hover", {
            "textDocument": {"uri": uri},
            "position": {"line": 2, "character": 6},
        });
        softlist<auto> hoverResp = freshServer.handleRequest(make_json(hoverReq));
        assertEq(Type::List, hoverResp.type(), "hover returns a response list without metadata");

        # Completion should return a valid JSON-RPC response
        hash<auto> compReq = makeRequest("textDocument/completion", {
            "textDocument": {"uri": uri},
            "position": {"line": 2, "character": 6},
        });
        softlist<auto> compResp = freshServer.handleRequest(make_json(compReq));
        assertEq(Type::List, compResp.type(), "completion returns a response list without metadata");

        # Signature help should return a valid JSON-RPC response
        hash<auto> sigReq = makeRequest("textDocument/signatureHelp", {
            "textDocument": {"uri": uri},
            "position": {"line": 2, "character": 11},
        });
        softlist<auto> sigResp = freshServer.handleRequest(make_json(sigReq));
        assertEq(Type::List, sigResp.type(), "signature help returns a response list without metadata");
    }

    # ==========================================
    # SymbolInfoKinds tests
    # ==========================================

    testASTSymbolKind() {
        assertEq(0, QLS::ASTSymbolKind.None);
        assertEq(1, QLS::ASTSymbolKind.File);
        assertEq(5, QLS::ASTSymbolKind.Class);
        assertEq(6, QLS::ASTSymbolKind.Method);
        assertEq(12, QLS::ASTSymbolKind.Function);
        assertEq(13, QLS::ASTSymbolKind.Variable);
        assertEq(14, QLS::ASTSymbolKind.Constant);
        assertEq(18, QLS::ASTSymbolKind.Array);
    }

    testASTSymbolUsageKind() {
        assertEq(0, QLS::ASTSymbolUsageKind.None);
        assertEq(100, QLS::ASTSymbolUsageKind.ClassDeclName);
        assertEq(200, QLS::ASTSymbolUsageKind.AccessVariable);
        assertEq(300, QLS::ASTSymbolUsageKind.ContextStmtName);
        assertEq(316, QLS::ASTSymbolUsageKind.WhileStmtCond);
    }

    testSymbolUsageStringMap() {
        assertEq(Type::Hash, QLS::SymbolUsageStringMap.type());
        # ClassDeclName should map to (Class,)
        assertEq((QLS::ASTSymbolKind.Class,), QLS::SymbolUsageStringMap.ClassDeclName);
        # FuncDeclName should include Function, Method, Constructor
        list funcDecl = QLS::SymbolUsageStringMap.FuncDeclName;
        assertEq(True, funcDecl.contains(QLS::ASTSymbolKind.Function));
        assertEq(True, funcDecl.contains(QLS::ASTSymbolKind.Method));
        assertEq(True, funcDecl.contains(QLS::ASTSymbolKind.Constructor));
    }

    testSymbolUsageFastMap() {
        assertEq(Type::Hash, QLS::SymbolUsageFastMap.type());
        # check that the fast map has entries for all usage kinds
        string key = string(QLS::ASTSymbolUsageKind.ClassDeclName);
        assertEq(True, QLS::SymbolUsageFastMap.hasKey(key));
        assertEq((QLS::ASTSymbolKind.Class,), QLS::SymbolUsageFastMap{key});
    }

    # ==========================================
    # ParamValidator tests
    # ==========================================

    testRequiredMissing() {
        hash request = baseRequest();
        string err;
        bool result = QLS::ParamValidator::required(request, {}, "missing", NT_STRING, \err);
        assertEq(False, result);
        assertEq(Type::String, err.type());
    }

    testRequiredWrongType() {
        hash request = baseRequest();
        string err;
        bool result = QLS::ParamValidator::required(request, {"key": 123}, "key", NT_STRING, \err);
        assertEq(False, result);
        assertEq(Type::String, err.type());
    }

    testRequiredValid() {
        hash request = baseRequest();
        string err;
        bool result = QLS::ParamValidator::required(request, {"key": "value"}, "key", NT_STRING, \err);
        assertEq(True, result);
    }

    testInitializeParamsValid() {
        hash request = baseRequest();
        hash params = {
            "processId": 123,
            "rootPath": "/tmp",
            "rootUri": "file:///tmp",
            "capabilities": {},
        };
        *string result = QLS::ParamValidator::initializeParams(request, params);
        assertNothing(result);
    }

    testInitializeParamsMissingPid() {
        hash request = baseRequest();
        hash params = {"capabilities": {}};
        *string result = QLS::ParamValidator::initializeParams(request, params);
        assertEq(Type::String, result.type());
    }

    testTextDocIdentValid() {
        hash request = baseRequest();
        hash params = {"textDocument": {"uri": "file:///test.q"}};
        *string result = QLS::ParamValidator::textDocumentIdentifier(request, params);
        assertNothing(result);
    }

    testTextDocIdentMissing() {
        hash request = baseRequest();
        *string result = QLS::ParamValidator::textDocumentIdentifier(request, {});
        assertEq(Type::String, result.type());
    }

    testTextDocItemValid() {
        hash request = baseRequest();
        hash params = {
            "textDocument": {
                "uri": "file:///test.q",
                "languageId": "qore",
                "version": 1,
                "text": "code",
            },
        };
        *string result = QLS::ParamValidator::textDocumentItem(request, params);
        assertNothing(result);
    }

    testTextDocItemMissing() {
        hash request = baseRequest();
        hash params = {
            "textDocument": {
                "uri": "file:///test.q",
                # missing languageId, version, text
            },
        };
        *string result = QLS::ParamValidator::textDocumentItem(request, params);
        assertEq(Type::String, result.type());
    }

    testVersionedTextDoc() {
        hash request = baseRequest();
        hash params = {"textDocument": {"uri": "file:///test.q", "version": 1}};
        *string result = QLS::ParamValidator::versionedTextDocumentIdentifier(request, params);
        assertNothing(result);

        # missing version
        hash params2 = {"textDocument": {"uri": "file:///test.q"}};
        *string result2 = QLS::ParamValidator::versionedTextDocumentIdentifier(request, params2);
        assertEq(Type::String, result2.type());
    }

    testTextDocPosValid() {
        hash request = baseRequest();
        hash params = {
            "textDocument": {"uri": "file:///test.q"},
            "position": {"line": 0, "character": 0},
        };
        *string result = QLS::ParamValidator::textDocumentPositionParams(request, params);
        assertNothing(result);
    }

    testTextDocPosMissing() {
        hash request = baseRequest();
        hash params = {"textDocument": {"uri": "file:///test.q"}};
        *string result = QLS::ParamValidator::textDocumentPositionParams(request, params);
        assertEq(Type::String, result.type());
    }

    testDidChangeConfig() {
        hash request = baseRequest();
        hash params = {"settings": {"qore": {}}};
        *string result = QLS::ParamValidator::didChangeConfigParams(request, params);
        assertNothing(result);

        # missing settings
        *string result2 = QLS::ParamValidator::didChangeConfigParams(request, {});
        assertEq(Type::String, result2.type());
    }

    testDidChangeWatchedFiles() {
        hash request = baseRequest();
        hash params = {
            "changes": ({"uri": "file:///test.q", "type": 1},),
        };
        *string result = QLS::ParamValidator::didChangeWatchedFilesParams(request, params);
        assertNothing(result);
    }

    testDidChangeWatchedFilesInvalid() {
        hash request = baseRequest();
        # event is not a hash
        hash params = {"changes": ("not a hash",)};
        *string result = QLS::ParamValidator::didChangeWatchedFilesParams(request, params);
        assertEq(Type::String, result.type());
    }

    testReferenceParams() {
        hash request = baseRequest();
        hash params = {
            "textDocument": {"uri": "file:///test.q"},
            "position": {"line": 0, "character": 0},
            "context": {"includeDeclaration": True},
        };
        *string result = QLS::ParamValidator::referenceParams(request, params);
        assertNothing(result);

        # missing context
        hash params2 = {
            "textDocument": {"uri": "file:///test.q"},
            "position": {"line": 0, "character": 0},
        };
        *string result2 = QLS::ParamValidator::referenceParams(request, params2);
        assertEq(Type::String, result2.type());
    }

    testWorkspaceSymbolParams() {
        hash request = baseRequest();
        hash params = {"query": "test"};
        *string result = QLS::ParamValidator::workspaceSymbolParams(request, params);
        assertNothing(result);

        # missing query
        *string result2 = QLS::ParamValidator::workspaceSymbolParams(request, {});
        assertEq(Type::String, result2.type());
    }

    # ==========================================
    # ErrorResponse tests
    # ==========================================

    testErrorCodes() {
        assertEq(-32700, QLS::ErrorCodes.ParseError);
        assertEq(-32600, QLS::ErrorCodes.InvalidRequest);
        assertEq(-32601, QLS::ErrorCodes.MethodNotFound);
        assertEq(-32602, QLS::ErrorCodes.InvalidParams);
        assertEq(-32603, QLS::ErrorCodes.InternalError);
        assertEq(-32002, QLS::ErrorCodes.ServerNotInitialized);
        assertEq(-32001, QLS::ErrorCodes.UnknownErrorCode);
    }

    testNotInitialized() {
        hash request = {"jsonrpc": "2.0", "id": 1, "method": "test"};
        string resp = QLS::ErrorResponse::notInitialized(request);
        assertEq(Type::String, resp.type());
        hash parsed = parse_json(resp);
        assertEq("2.0", parsed.jsonrpc);
        assertEq(1, parsed.id);
        assertEq(QLS::ErrorCodes.ServerNotInitialized, parsed.error.code);
    }

    testInvalidRequest() {
        hash request = {"jsonrpc": "2.0", "id": 2, "method": "test"};
        string resp = QLS::ErrorResponse::invalidRequest(request);
        hash parsed = parse_json(resp);
        assertEq(QLS::ErrorCodes.InvalidRequest, parsed.error.code);
        assertEq("invalid request", parsed.error.message);
    }

    testInvalidRequestWithMessage() {
        hash request = {"jsonrpc": "2.0", "id": 3, "method": "test"};
        string resp = QLS::ErrorResponse::invalidRequest(request, "custom error");
        hash parsed = parse_json(resp);
        assertEq(QLS::ErrorCodes.InvalidRequest, parsed.error.code);
        assertEq("custom error", parsed.error.message);
    }

    testMethodNotFound() {
        hash request = {"jsonrpc": "2.0", "id": 4, "method": "nonExistent"};
        string resp = QLS::ErrorResponse::methodNotFound(request);
        hash parsed = parse_json(resp);
        assertEq(QLS::ErrorCodes.MethodNotFound, parsed.error.code);
        assertRegex("nonExistent", parsed.error.message);
    }

    testInternalError() {
        string resp = QLS::ErrorResponse::internalError("2.0");
        hash parsed = parse_json(resp);
        assertEq(QLS::ErrorCodes.InternalError, parsed.error.code);
        assertEq("internal error", parsed.error.message);
    }

    testInternalErrorWithMessage() {
        string resp = QLS::ErrorResponse::internalError("2.0", "something broke");
        hash parsed = parse_json(resp);
        assertEq(QLS::ErrorCodes.InternalError, parsed.error.code);
        assertEq("something broke", parsed.error.message);
    }

    testInvalidParams() {
        hash request = {"jsonrpc": "2.0", "id": 5, "method": "test"};
        string resp = QLS::ErrorResponse::invalidParams(request, "bad params");
        hash parsed = parse_json(resp);
        assertEq(QLS::ErrorCodes.InvalidParams, parsed.error.code);
        assertEq("bad params", parsed.error.message);
    }

    testNonExistentDocument() {
        hash request = {
            "jsonrpc": "2.0",
            "id": 6,
            "method": "test",
            "params": {"textDocument": {"uri": "file:///nonexistent"}},
        };
        string resp = QLS::ErrorResponse::nonExistentDocument(request);
        hash parsed = parse_json(resp);
        assertEq(QLS::ErrorCodes.InvalidParams, parsed.error.code);
        assertRegex("nonexistent", parsed.error.message);
    }

    # ==========================================
    # Notification tests
    # ==========================================

    testMessageType() {
        assertEq(1, QLS::MessageType.Error);
        assertEq(2, QLS::MessageType.Warning);
        assertEq(3, QLS::MessageType.Info);
        assertEq(4, QLS::MessageType.Log);
    }

    testDiagnostics() {
        list diags = ({"message": "test error", "range": {"start": {"line": 0, "character": 0}}},);
        string resp = QLS::Notification::diagnostics("2.0", "file:///test.q", diags);
        assertEq(Type::String, resp.type());
        hash parsed = parse_json(resp);
        assertEq("2.0", parsed.jsonrpc);
        assertEq("textDocument/publishDiagnostics", parsed.method);
        assertEq("file:///test.q", parsed.params.uri);
        assertEq(1, parsed.params.diagnostics.size());
    }

    testDiagnosticsEmpty() {
        string resp = QLS::Notification::diagnostics("2.0", "file:///test.q");
        hash parsed = parse_json(resp);
        assertEq("textDocument/publishDiagnostics", parsed.method);
        assertEq(0, parsed.params.diagnostics.size());
    }

    testShowMessage() {
        string resp = QLS::Notification::showMessage("2.0", QLS::MessageType.Warning, "test warning");
        hash parsed = parse_json(resp);
        assertEq("window/showMessage", parsed.method);
        assertEq(QLS::MessageType.Warning, parsed.params.type);
        assertEq("test warning", parsed.params.message);
    }
}
