%modern

%requires ../../../../qlib/QUnit.qm
%requires json
%requires ../../../../qlib/QLS

%exec-class InlayHintTest

class InlayHintTest inherits QUnit::Test {
    private {
        QLS::QLSServer server;
        int reqId = 0;
        int docCount = 0;
        hash<string, string> docCache;
    }

    constructor() : Test("QLS InlayHint", "1.0") {
        initServer();

        addTestCase("parameter hints for function calls", \testFunctionCallHints());
        addTestCase("no hints for single-arg calls", \testSingleArgNoHints());
        addTestCase("range filtering", \testRangeFiltering());
        addTestCase("empty document", \testEmptyDocument());
        addTestCase("missing params", \testMissingParams());

        set_return_value(main());
    }

    private initServer() {
        server = new QLS::QLSServer();

        hash<auto> initReq = makeRequest("initialize", {
            "processId": getpid(),
            "capabilities": {},
            "rootUri": NOTHING,
        });
        server.handleRequest(make_json(initReq));

        hash<auto> initializedReq = makeRequest("initialized");
        delete initializedReq.id;
        server.handleRequest(make_json(initializedReq));
    }

    # Test source:
    # Line 0: %modern
    # Line 1: sub add(int a, int b) { return a + b; }
    # Line 2: sub single(int x) { return x; }
    # Line 3: add(1, 2);
    # Line 4: single(5);
    private string getTestCode() {
        return "%modern
sub add(int a, int b) { return a + b; }
sub single(int x) { return x; }
add(1, 2);
single(5);
";
    }

    private string setupDoc(*string text) {
        string src = text ?? getTestCode();
        *string cached = docCache{src};
        if (exists cached) {
            return cached;
        }
        string uri = sprintf("file:///test/inlayhint%d.q", ++docCount);
        hash<auto> openReq = makeRequest("textDocument/didOpen", {
            "textDocument": {
                "uri": uri,
                "languageId": "qore",
                "version": 1,
                "text": src,
            },
        });
        delete openReq.id;
        server.handleRequest(make_json(openReq));
        docCache{src} = uri;
        return uri;
    }

    private hash<auto> makeRequest(string method, *hash<auto> params) {
        return {
            "jsonrpc": "2.0",
            "id": ++reqId,
            "method": method,
            "params": params,
        };
    }

    private *list<auto> sendInlayHint(string uri, int startLine, int endLine) {
        hash<auto> req = makeRequest("textDocument/inlayHint", {
            "textDocument": {"uri": uri},
            "range": {
                "start": {"line": startLine, "character": 0},
                "end": {"line": endLine, "character": 999},
            },
        });
        softlist<auto> responses = server.handleRequest(make_json(req));
        if (!responses || !responses[0]) {
            return NOTHING;
        }
        hash<auto> resp = parse_json(responses[0]);
        return resp.result;
    }

    testFunctionCallHints() {
        string uri = setupDoc();

        # Get hints for line 3: add(1, 2) — should have hints for 'a:' and 'b:'
        *list<auto> hints = sendInlayHint(uri, 3, 3);
        assertTrue(exists hints && hints.size() > 0,
            "should return hints for multi-arg call");
        # Verify hints have parameter kind (2)
        foreach hash<auto> hint in (hints) {
            assertEq(2, hint.kind, "hint should be parameter kind");
            assertTrue(hint.label.size() > 0, "hint label should not be empty");
            assertTrue(hint.paddingRight, "hint should have padding right");
        }
    }

    testSingleArgNoHints() {
        string uri = setupDoc();

        # Get hints for line 4: single(5) — single-arg, should have no hints
        *list<auto> hints = sendInlayHint(uri, 4, 4);
        # Should be empty (single-arg calls are excluded)
        assertEq(0, hints.size(), "single-arg call should have no hints");
    }

    testRangeFiltering() {
        string uri = setupDoc();

        # Request only line 0 (parse directive) — should have no call hints
        *list<auto> hints = sendInlayHint(uri, 0, 0);
        assertEq(0, hints.size(), "no hints on parse directive line");
    }

    testEmptyDocument() {
        string uri = setupDoc("");

        *list<auto> hints = sendInlayHint(uri, 0, 0);
        assertEq(0, hints.size(), "empty doc should return no hints");
    }

    testMissingParams() {
        hash<auto> req = makeRequest("textDocument/inlayHint");
        delete req.params;
        softlist<auto> responses = server.handleRequest(make_json(req));
        assertTrue(exists responses && responses.size() > 0,
            "should return error response for missing params");
        hash<auto> resp = parse_json(responses[0]);
        assertTrue(exists resp.error, "response should have error field");
    }
}
