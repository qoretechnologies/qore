    unverifiedBreakpointTest() {
        TmpDir tmp("qore-vda-test-");
        string path = writeProgram(tmp);

        Process proc = startAdapter();
        on_exit if (proc.running()) {
            proc.terminate();
        }
        DapClient dap(proc);
        launch(dap, {"program": path, "stopOnEntry": False});

        # the IDE is told why a breakpoint cannot be set
        hash<auto> r = dap.request("setFunctionBreakpoints", {"breakpoints": ({"name": "no_such_function"},)});
        assertTrue(r.success, r.message);
        assertFalse(r.body.breakpoints[0].verified);
        assertRegex("no_such_function", r.body.breakpoints[0].message);
        r = dap.request("setFunctionBreakpoints", {"breakpoints": ({"name": "add(string)"},)});
        assertTrue(r.success, r.message);
        assertFalse(r.body.breakpoints[0].verified);
        assertTrue(exists r.body.breakpoints[0].message, sprintf("%y", r.body.breakpoints));
        # a line without a statement, in plain words
        r = dap.request("setBreakpoints", {"source": {"path": path}, "breakpoints": ({"line": 1},)});
        assertTrue(r.success, r.message);
        assertFalse(r.body.breakpoints[0].verified);
        assertRegex("^there is no statement on line 1 of \".*target\\.q\" where the program can pause$",
            r.body.breakpoints[0].message);
        r = dap.request("configurationDone");
        assertTrue(r.success, r.message);

        # the program runs to its end
        dap.waitForEvent("terminated");
        assertEq((), dap.getEvents("stopped"));
        r = dap.request("disconnect");
        assertTrue(r.success, r.message);
        proc.closeStdin();
        assertTrue(proc.wait(30s), "the adapter ends");
        assertEq(0, proc.exitCode());
    }

    exceptionTest() {
        TmpDir tmp("qore-vda-test-");
        string path = writeProgram(tmp, ExceptionProgram);

        Process proc = startAdapter();
        on_exit if (proc.running()) {
            proc.terminate();
        }
        DapClient dap(proc);
        launch(dap, {"program": path, "stopOnEntry": False});
        hash<auto> r = dap.request("setExceptionBreakpoints", {"filters": ("User",)});
        assertTrue(r.success, r.message);
        r = dap.request("configurationDone");
        assertTrue(r.success, r.message);

        # the stop gives the name of the exception
        hash<auto> stopped = dap.waitForEvent("stopped");
        assertEq("exception", stopped.body.reason);
        assertEq("TEST-ERROR", stopped.body.text);
        int tid = stopped.body.threadId;
        hash<auto> frame = topFrame(dap, tid);
        assertEq(3, frame.line);
        r = dap.request("exceptionInfo", {"threadId": tid});
        assertTrue(r.success, r.message);
        assertEq("TEST-ERROR", r.body.exceptionId);
        assertEq("test", r.body.description);

        # the program catches the exception
        r = dap.request("continue", {"threadId": tid});
        assertTrue(r.success, r.message);
        dap.waitForEvent("terminated");
        assertEq(("caught TEST-ERROR\n",), dap.getOutput("stdout"));
        assertEq((), dap.getEvents("stopped"));
        r = dap.request("disconnect");
        assertTrue(r.success, r.message);
        proc.closeStdin();
        assertTrue(proc.wait(30s), "the adapter ends");
        assertEq(0, proc.exitCode());
    }

    #! a running adapter that does not send the message fails the wait in time, with what it did send (qore#5834)
    missingMessageTest() {
        Process proc = startAdapter();
        on_exit if (proc.running()) {
            proc.terminate();
        }
        DapClient dap(proc);
        hash<auto> r = dap.request("initialize", {"adapterID": "qore", "linesStartAt1": True,
            "columnsStartAt1": True, "pathFormat": "path"});
        assertTrue(r.success, r.message);
        # the adapter sends no stopped event before a program is launched
        date start = now_us();
        assertThrows("DAP-ERROR", "^no stopped event from the adapter within <time: 2 seconds>; the messages received "
            "and not taken: .*; stray output: .*; adapter stderr: ", \dap.waitForEvent(), ("stopped", 2s));
        date elapsed = now_us() - start;
        assertTrue(elapsed >= 2s, sprintf("%y", elapsed));
        assertTrue(elapsed < 30s, sprintf("%y", elapsed));
        # the adapter is still running: the wait ended at the deadline, not at the end of the adapter's output
        assertTrue(proc.running());
        r = dap.request("disconnect");
        assertTrue(r.success, r.message);
        proc.closeStdin();
        assertTrue(proc.wait(30s), "the adapter ends");
    }

    # with the "uncaught" filter, only an exception that no try statement catches stops the thread
    uncaughtExceptionTest() {
        TmpDir tmp("qore-vda-test-");
        string path = writeProgram(tmp, UncaughtProgram);

        Process proc = startAdapter();
        on_exit if (proc.running()) {
            proc.terminate();
        }
        DapClient dap(proc);
        hash<auto> r = dap.request("initialize", {"adapterID": "qore", "linesStartAt1": True,
            "columnsStartAt1": True, "pathFormat": "path"});
        assertTrue(r.success, r.message);
        assertEq(("User", "System", "uncaught", "code"), map $1.filter, r.body.exceptionBreakpointFilters);
        assertEq(("User exceptions", "System exceptions", "Uncaught exceptions", "Exceptions by code"),
            map $1.label, r.body.exceptionBreakpointFilters);
        # each filter is described for the IDE
        assertEq(4, (select r.body.exceptionBreakpointFilters, $1.description =~ /^[A-Z].+[a-z]$/).size());
        r = dap.request("launch", {"program": path});
        assertTrue(r.success, r.message);
        dap.waitForEvent("initialized");
        r = dap.request("setExceptionBreakpoints", {"filters": ("uncaught",)});
        assertTrue(r.success, r.message);
        r = dap.request("configurationDone");
        assertTrue(r.success, r.message);

        # the exceptions caught in a calling function, in a catch block and in a closure do not stop the thread
        hash<auto> stopped = dap.waitForEvent("stopped");
        assertEq("exception", stopped.body.reason);
        assertEq("UNCAUGHT", stopped.body.text);
        assertEq(("before\n",), dap.getOutput("stdout"));
        int tid = stopped.body.threadId;
        assertEq(3, topFrame(dap, tid).line);

        # the program ends with the exception
        r = dap.request("continue", {"threadId": tid});
        assertTrue(r.success, r.message);
        dap.waitForEvent("terminated");
        assertEq((), dap.getEvents("stopped"));
        r = dap.request("disconnect");
        assertTrue(r.success, r.message);
        proc.closeStdin();
        assertTrue(proc.wait(30s), "the adapter ends");
    }

