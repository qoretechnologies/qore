%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires json
%requires FsUtil
%requires Util
%requires VscDebugAdapter

%try-module process >= 2.2
%define NoProcess
%endtry

%exec-class VscDebugAdapterTest

%ifndef NoProcess
#! A client of the Debug Adapter Protocol for an adapter process
class DapClient {
    public {
        #! bytes on stdout that are not part of a protocol message
        list<string> stray = ();

        #! the maximum time to wait for a message before the test fails
        /** Long enough for an adapter that is starved under load, short enough that a missing message fails the test
            case well within the time limit of run_tests.sh
        */
        const MessageTimeout = 60s;
    }

    private {
        Process proc;
        binary buf = binary();
        list<hash<auto>> backlog = ();
        int seq = 0;
    }

    constructor(Process proc) {
        self.proc = proc;
    }

    #! Sends a request and returns its response
    hash<auto> request(string command, *hash<auto> arguments, bool with_arguments = True) {
        hash<auto> msg = {"seq": ++seq, "type": "request", "command": command};
        if (with_arguments) {
            msg.arguments = arguments ?? {};
        }
        binary content = binary(make_json(msg));
        proc.write(sprintf("Content-Length: %d\r\n\r\n", content.size()));
        proc.write(content);
        int request_seq = seq;
        return waitFor(bool sub (hash<auto> m) {
            return m.type == "response" && m.request_seq == request_seq;
        }, command + " response");
    }

    #! Returns the next message that matches, including messages that were received before
    /** @throw DAP-ERROR the adapter did not send the message within \a timeout_ms or ended without it
    */
    hash<auto> waitFor(code<bool(hash<auto>)> pred, string what, timeout timeout_ms = MessageTimeout) {
        for (int i = 0; i < backlog.size(); ++i) {
            if (pred(backlog[i])) {
                return (extract backlog, i, 1)[0];
            }
        }
        # on the monotonic clock, in microseconds
        int deadline = clock_getmicros() + timeout_ms * 1000;
        while (True) {
            *hash<auto> msg = readMessage(deadline);
            if (!msg) {
                throw "DAP-ERROR", sprintf("no %s from the adapter %s; the messages received and not taken: %y; "
                    "stray output: %y; adapter stderr: %y", what,
                    proc.running() ? sprintf("within %y", milliseconds(timeout_ms)) : "before it ended",
                    summarizeBacklog(), stray.size() > 20 ? stray[stray.size() - 20..] : stray, readStderr());
            }
            if (pred(msg)) {
                return msg;
            }
            push backlog, msg;
        }
    }

    #! Returns the next event with the given name
    hash<auto> waitForEvent(string event, timeout timeout_ms = MessageTimeout) {
        return waitFor(bool sub (hash<auto> m) {
            return m.type == "event" && m.event == event;
        }, event + " event", timeout_ms);
    }

    #! Returns the events with the given name received so far and not yet taken by waitFor()
    list<hash<auto>> getEvents(string event) {
        return select backlog, $1.type == "event" && $1.event == event;
    }

    #! Returns the output events received so far for the given category
    list<string> getOutput(string category) {
        return map $1.body.output, backlog, $1.event == "output" && $1.body.category == category;
    }

    #! Reads the next message; returns NOTHING if the adapter does not send one before the deadline
    private *hash<auto> readMessage(int deadline) {
        while (True) {
            int end = buf.find(<0d0a0d0a>);
            if (end >= 0) {
                int len = -1;
                foreach string line in (buf.substr(0, end).toString("UTF-8").split("\r\n")) {
                    *list<string> m = (line =~ x/^Content-Length: *([0-9]+)$/);
                    if (m) {
                        len = int(m[0]);
                    } else {
                        stray += line;
                    }
                }
                if (len < 0) {
                    splice buf, 0, end + 4;
                    continue;
                }
                while (buf.size() < end + 4 + len) {
                    if (!fill(deadline)) {
                        return NOTHING;
                    }
                }
                hash<auto> msg = parse_json(buf.substr(end + 4, len).toString("UTF-8"));
                splice buf, 0, end + 4 + len;
                return msg;
            }
            if (!fill(deadline)) {
                return NOTHING;
            }
        }
    }

    #! Reads more output of the adapter; returns False when the adapter's stdout is at end of file or at the deadline
    /** readStdoutBinary() returns nothing either when nothing arrives within the timeout, which is the deadline, or
        at once at the end of the adapter's output; an adapter that keeps running without sending the message fails
        the test case at the deadline instead of blocking it (qore#5834), and at the end of its output, the adapter is
        given until the deadline to exit, so that a reader does not spin while it ends

        @param deadline the time on the monotonic clock (clock_getmicros()) at which the wait fails
    */
    private bool fill(int deadline) {
        int remaining_us = deadline - clock_getmicros();
        if (remaining_us <= 0) {
            return False;
        }
        # rounded up, so that the wait does not end before the deadline
        *binary data = proc.readStdoutBinary(65536, (remaining_us + 999) / 1000);
        if (data) {
            buf += data;
            return True;
        }
        # the deadline passed, or the output ended: then the adapter ends or has ended
        remaining_us = deadline - clock_getmicros();
        if (remaining_us > 0 && proc.running()) {
            proc.wait((remaining_us + 999) / 1000);
        }
        return False;
    }

    #! Returns the messages received and not taken, for the message of a failure; repeated messages are counted
    private list<string> summarizeBacklog() {
        list<string> summary = ();
        string last;
        int count = 0;
        foreach hash<auto> msg in (backlog) {
            string desc = msg.type == "event"
                ? sprintf("event %s%s", msg.event, msg.event == "stopped" ? sprintf(" (%y)", msg.body.reason) : "")
                : sprintf("%s %s", msg.type, msg.command ?? "");
            if (desc == last) {
                ++count;
                continue;
            }
            if (count) {
                push summary, count > 1 ? sprintf("%s x%d", last, count) : last;
            }
            last = desc;
            count = 1;
        }
        if (count) {
            push summary, count > 1 ? sprintf("%s x%d", last, count) : last;
        }
        return summary;
    }

    #! Returns what the adapter wrote to stderr so far, for the message of a failure
    private string readStderr() {
        try {
            *string err = proc.readStderr(65536, 0);
            return err ?? "";
        } catch (hash<ExceptionInfo> ex) {
            return sprintf("(not readable: %s: %s)", ex.err, ex.desc);
        }
    }
}
%endif

public class VscDebugAdapterTest inherits QUnit::Test {
    private {
        #! the program that is debugged; the comments are the line numbers
        const Program = "%modern\n"                                         # 1
            "int sub add(int a, int b) {\n"                                  # 2
            "    int sum = a + b;\n"                                         # 3
            "    return sum;\n"                                              # 4
            "}\n"                                                            # 5
            "hash<auto> h = {\"name\": \"invoice\", \"lines\": (1, 2, 3)};\n"  # 6
            "int total = add(2, 3);\n"                                       # 7
            "printf(\"total: %d %y\\n\", total, h);\n";                      # 8

        #! a program with a thread started with the background operator; the comments are the line numbers
        const ThreadProgram = "%modern\n"                                   # 1
            "int sub add(int a, int b) {\n"                                  # 2
            "    int sum = a + b;\n"                                         # 3
            "    return sum;\n"                                              # 4
            "}\n"                                                            # 5
            "sub work() {\n"                                                 # 6
            "    int t = add(10, 20);\n"                                     # 7
            "}\n"                                                            # 8
            "Counter c(1);\n"                                                # 9
            "background sub () { on_exit c.dec(); set_thread_name(\"worker\"); work(); }();\n" # 10
            "c.waitForZero();\n"                                             # 11
            "printf(\"done\\n\");\n";                                         # 12

        #! a program of a debug server that starts a thread for each line of input; the comments are the line numbers
        const AttachProgram = "%modern\n"                                  # 1
            "sub work() { printf(\"work\\n\");\n"                           # 2
            "    int t = 1;\n"                                               # 3
            "}\n"                                                            # 4
            "while (stdin.readLine(False) == \"thread\") {\n"                # 5
            "    Counter c(1);\n"                                            # 6
            "    background sub () { on_exit c.dec(); work(); }();\n"        # 7
            "    c.waitForZero();\n"                                         # 8
            "    printf(\"done\\n\");\n"                                     # 9
            "}\n";                                                           # 10

        #! a program with a thread that runs and one that waits when the main thread stops at line 33; the comments
        #! are the line numbers
        const StopAllProgram = "%modern\n"                                 # 1
            "our Counter stop(1);\n"                                         # 2
            "our Counter busy_running(1);\n"                                 # 3
            "our Mutex m();\n"                                               # 4
            "our Condition cond();\n"                                        # 5
            "our bool waiting = False;\n"                                    # 6
            "our bool release = False;\n"                                    # 7
            "sub busy() {\n"                                                 # 8
            "    set_thread_name(\"busy\"); busy_running.dec();\n"           # 9
            "    int i = 0;\n"                                               # 10
            "    while (stop.getCount()) {\n"                                # 11
            "        ++i;\n"                                                 # 12
            "    }\n"                                                        # 13
            "}\n"                                                            # 14
            "sub blocked() {\n"                                              # 15
            "    set_thread_name(\"waiter\"); m.lock();\n"                   # 16
            "    on_exit m.unlock();\n"                                      # 17
            "    waiting = True;\n"                                          # 18
            "    cond.broadcast();\n"                                        # 19
            "    while (!release) {\n"                                       # 20
            "        cond.wait(m);\n"                                        # 21
            "    }\n"                                                        # 22
            "}\n"                                                            # 23
            "Counter ended(2);\n"                                            # 24
            "background sub () { on_exit ended.dec(); busy(); }();\n"        # 25
            "background sub () { on_exit ended.dec(); blocked(); }();\n"     # 26
            "busy_running.waitForZero();\n"                                  # 27
            # the waiting thread releases the mutex only in Condition::wait()
            "m.lock();\n"                                                    # 28
            "while (!waiting) {\n"                                           # 29
            "    cond.wait(m);\n"                                            # 30
            "}\n"                                                            # 31
            "m.unlock();\n"                                                  # 32
            "int k = 1;\n"                                                   # 33
            "stop.dec();\n"                                                  # 34
            "m.lock();\n"                                                    # 35
            "release = True;\n"                                              # 36
            "cond.broadcast();\n"                                            # 37
            "m.unlock();\n"                                                  # 38
            "ended.waitForZero();\n"                                         # 39
            "printf(\"done\\n\");\n";                                         # 40

        #! a program that raises an exception and catches it; the comments are the line numbers
        const ExceptionProgram = "%modern\n"                                # 1
            "try {\n"                                                        # 2
            "    throw \"TEST-ERROR\", \"test\";\n"                          # 3
            "} catch (hash<ExceptionInfo> ex) {\n"                           # 4
            "    printf(\"caught %s\\n\", ex.err);\n"                         # 5
            "}\n";                                                           # 6

        #! a program with exceptions that are caught in different ways, and one that is not caught; the comments are
        #! the line numbers
        const UncaughtProgram = "%modern\n"                                # 1
            "sub fail(string err) {\n"                                       # 2
            "    throw err, \"test\";\n"                                    # 3
            "}\n"                                                            # 4
            "try {\n"                                                        # 5
            "    fail(\"CAUGHT-1\");\n"                                     # 6
            "} catch (hash<ExceptionInfo> ex) {\n"                           # 7
            "    try {\n"                                                    # 8
            "        fail(\"CAUGHT-2\");\n"                                 # 9
            "    } catch () {\n"                                             # 10
            "    }\n"                                                        # 11
            "}\n"                                                            # 12
            "code c = sub () { fail(\"CAUGHT-3\"); };\n"                    # 13
            "try { c(); } catch () {}\n"                                     # 14
            "printf(\"before\\n\");\n"                                      # 15
            "fail(\"UNCAUGHT\");\n";                                        # 16

        #! a program that runs until its variable \c done is set; the comments are the line numbers
        const LoopProgram = "%modern\n"                                     # 1
            "bool done = False;\n"                                           # 2
            "printf(\"looping\\n\");\n"                                      # 3
            "while (!done) {\n"                                              # 4
            "    usleep(1ms);\n"                                             # 5
            "}\n"                                                            # 6
            "printf(\"done\\n\");\n";                                         # 7

        #! a program with structured values and a loop; the comments are the line numbers
        const DataProgram = "%modern\n"                                     # 1
            "class Base {\n"                                                 # 2
            "    private { int id = 7; }\n"                                  # 3
            "}\n"                                                            # 4
            "class Account inherits Base {\n"                                # 5
            "    private { int balance = 100; hash<auto> meta = {\"owner\": \"ann\", \"tags\": (\"a\", \"b\")}; }\n" # 6
            "    public { string name = \"acct\"; }\n"                       # 7
            "    int getBalance() { return balance; }\n"                     # 8
            "}\n"                                                            # 9
            "int sub work(int n) {\n"                                        # 10
            "    int total = 0;\n"                                           # 11
            "    for (int i = 0; i < n; ++i) {\n"                            # 12
            "        total += i;\n"                                          # 13
            "    }\n"                                                        # 14
            "    return total;\n"                                            # 15
            "}\n"                                                            # 16
            "our Account acct = new Account();\n"                            # 17
            "our hash<auto> h = {\"name\": \"invoice\", \"lines\": (1, 2, 3), \"nested\": {\"k\": \"v\"}};\n" # 18
            "list<int> big = range(0, 250);\n"                               # 19
            "int r = work(5);\n"                                             # 20
            "printf(\"r: %d\\n\", r);\n";                                     # 21

        #! a program whose line 4 calls g() twice; the comments are the line numbers
        const StepInProgram = "%modern\n"                                   # 1
            "int sub g(int x) { return x + 1; }\n"                           # 2
            "int sub h(int x) { return g(x) * 2; }\n"                        # 3
            "int r = g(h(1));\n"                                             # 4
            "r = h(r);\n"                                                    # 5
            "printf(\"%d\\n\", r);\n";                                      # 6

        #! a program with lines of more than one statement; the comments are the line numbers
        /** in line 3, the second and third statements start at the UTF-16 code units 18 and 37, which are the bytes
            21 and 40, as the string before them has a character of two bytes and one of four bytes and two UTF-16
            code units
        */
        const ColumnProgram = "%modern\n"                                   # 1
            "int sub add(int a, int b) { return a + b; }\n"                  # 2
            "string s = \"é😀\"; int x = add(1, 2); printf(\"%d\\n\", x);\n"   # 3
            "x = add(x, 4); x = add(x, 5);\n";                               # 4

        #! the capabilities that the adapter gave in its response to the last initialize request
        hash<auto> capabilities;

        string qore_exe = executablePath(ENV.QORE_EXECUTABLE ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore");
        string adapter = normalize_dir(get_script_dir() + "/../../../../bin/qdbg-vsc-adapter");
        string qlib_dir = normalize_dir(get_script_dir() + "/../../../../qlib");
        string server_script = normalize_dir(get_script_dir() + "/../../../../bin/qdbg-server");
    }

    constructor() : Test("VscDebugAdapter", "1.0", \ARGV) {
%ifndef NoProcess
        addTestCase("debug session over the Debug Adapter Protocol", \sessionTest());
        addTestCase("stopOnEntry false: the first stop is a breakpoint", \noStopOnEntryTest());
        addTestCase("stopOnEntry false: a breakpoint on the first statement stops", \firstStatementBreakpointTest());
        addTestCase("stopOnEntry not given: the program runs to its end", \defaultStopOnEntryTest());
        addTestCase("function breakpoints", \functionBreakpointTest());
        addTestCase("breakpoints that cannot be set", \unverifiedBreakpointTest());
        addTestCase("exception breakpoints", \exceptionTest());
        addTestCase("exceptions without an exception breakpoint", \exceptionNoFilterTest());
        addTestCase("uncaught exceptions", \uncaughtExceptionTest());
        addTestCase("a message that the adapter does not send fails the wait", \missingMessageTest());
%endif
        # needs no adapter process
        addTestCase("the exception filters that stop a thread", \exceptionFilterTest());
%ifndef NoProcess
        addTestCase("threads started by the program", \threadTest());
        addTestCase("pausing a running program", \pauseTest());
        addTestCase("structured variables are shown as trees", \variablesTest());
        addTestCase("values of variables, elements and members are set", \setVariableTest());
        addTestCase("expressions are evaluated for watches, hovers and the debug console", \evaluateTest());
        addTestCase("conditional breakpoints", \conditionalBreakpointTest());
        addTestCase("hit conditions of breakpoints", \hitConditionTest());
        addTestCase("logpoints", \logpointTest());
        addTestCase("a breakpoint whose condition is false does not hide a step", \conditionalStepTest());
        addTestCase("the columns of the protocol and of the source", \columnConversionTest());
        addTestCase("breakpoints on a statement of a line with more than one", \columnBreakpointTest());
        addTestCase("stepping into a chosen call", \stepInTargetTest());
        addTestCase("columns of a source that only the debug server can read", \remoteColumnTest());
        addTestCase("a debug server that requires a token", \tokenTest());
        addTestCase("exceptions by code", \exceptionCodeTest());
        addTestCase("the adapter communicates over sockets, as Visual Studio Code starts it", \socketTest());
        addTestCase("the adapter logs to its file and to the debug console", \logTest());
        addTestCase("the end of a program that started a process is reported", \childProcessTest());
%endif
        # needs no adapter process
        addTestCase("names of threads", \threadNameTest());
%ifndef NoProcess
        addTestCase("all threads stop and continue together", \stopAllThreadsTest());
        addTestCase("output written before a stop is sent before it", \outputOrderTest());
        addTestCase("sources are parsed in the mode that the interpreter gives their files", \sourceModeTest());
        addTestCase("stopAllThreads false: only the thread that stops is stopped", \stopOneThreadTest());
        addTestCase("attaching to a program of a debug server", \attachTest());
        addTestCase("a debug server that cannot be reached", \noServerTest());
        addTestCase("a debug server that ends during the session", \serverClosedTest());
        addTestCase("the adapter ends when the IDE closes its input", \endOfInputTest());
        addTestCase("a launched program ends when the session ends", \terminateTest());
        addTestCase("the restart request launches the program again", \restartTest());
        addTestCase("integers in hexadecimal", \hexFormatTest());
        addTestCase("hints for exceptions that match a common pitfall", \trapHintTest());
%else
        # every other case runs the adapter in a process
        addTestCase("the cases that run the adapter in a process", sub () {
            testSkip("no process module 2.2 or later");
        });
%endif
        set_return_value(main());
    }

    #! Returns the absolute path of the given Qore executable
    /** A Process is started with an absolute path or with a name that is found in the search path, so a path
        relative to the working directory, as \c QORE_ARGV[0] is when the test is run with \c build/qore, is made
        absolute; whether the process module finds such a path depends on the version of Boost.Process
    */
    private static string executablePath(string name) {
        if (name.regex("/")) {
            return realpath(name);
        }
        foreach string dir in (split(":", ENV.PATH ?? "")) {
            string path = (dir ? dir : ".") + "/" + name;
            if (is_executable(path)) {
                return realpath(path);
            }
        }
        throw "TEST-SETUP-ERROR", sprintf("cannot locate Qore executable %y", name);
    }


    # an exception stops the thread if its type is selected, or if it is not caught and uncaught exceptions are
    exceptionFilterTest() {
        hash<auto> user = {"exception": {"type": "User"}, "uncaught": False};
        hash<auto> uncaught_system = {"exception": {"type": "System"}, "uncaught": True};
        assertTrue(VscDebugAdapter::stopsAtException(user, ("User",)));
        assertFalse(VscDebugAdapter::stopsAtException(user, ("System",)));
        assertFalse(VscDebugAdapter::stopsAtException(user, ("uncaught",)));
        assertTrue(VscDebugAdapter::stopsAtException(uncaught_system, ("uncaught",)));
        assertTrue(VscDebugAdapter::stopsAtException(uncaught_system, ("System", "uncaught")));
        assertFalse(VscDebugAdapter::stopsAtException(uncaught_system, ("User",)));
        # a debug server that does not give "uncaught"
        assertFalse(VscDebugAdapter::stopsAtException({"exception": {"type": "User"}}, ("uncaught",)));
        assertFalse(VscDebugAdapter::stopsAtException(user, NOTHING));
        # exception codes
        hash<auto> file_error = {"exception": {"type": "User", "err": "FILE-OPEN-ERROR"}, "uncaught": False};
        assertTrue(VscDebugAdapter::stopsAtException(file_error, (), ("SOCKET-ERROR", "FILE-OPEN-ERROR")));
        assertFalse(VscDebugAdapter::stopsAtException(file_error, (), ("SOCKET-ERROR",)));
        assertEq(("FILE-OPEN-ERROR", "SOCKET-ERROR"), VscDebugAdapter::getExceptionCodes({"filterOptions": (
            {"filterId": "code", "condition": " FILE-OPEN-ERROR,, SOCKET-ERROR "},
            {"filterId": "uncaught"},
        )}));
        assertEq((), VscDebugAdapter::getExceptionCodes({"filters": ("User",)}));
        assertEq((), VscDebugAdapter::getExceptionCodes({"filterOptions": ({"filterId": "code"},)}));
    }

    # the default names that Qore gives threads are not shown
    threadNameTest() {
        assertEq("worker (3)", VscDebugAdapter::getThreadDisplayName(3, "worker", False));
        assertEq("worker (3)", VscDebugAdapter::getThreadDisplayName(3, "worker", True));
        assertEq("Thread 3", VscDebugAdapter::getThreadDisplayName(3, "qore/3", False));
        assertEq("Thread 3", VscDebugAdapter::getThreadDisplayName(3, NOTHING, False));
        assertEq("Main Thread (1)", VscDebugAdapter::getThreadDisplayName(1, "qore", True));
        assertEq("Main Thread (5)", VscDebugAdapter::getThreadDisplayName(5, "qore/5", True));
        # names that only look like the default names
        assertEq("qore-x (4)", VscDebugAdapter::getThreadDisplayName(4, "qore-x", False));
        assertEq("qore/a (4)", VscDebugAdapter::getThreadDisplayName(4, "qore/a", False));
    }

%ifndef NoProcess
    #! Starts the adapter with the modules of this source tree
    private Process startAdapter(*list<string> args, *hash<auto> env) {
        *string module_dir = ENV.QORE_MODULE_DIR;
        return new Process(qore_exe, (adapter,) + (args ?? ()), {
            "env": Process::getEnvironment() + {
                "QORE_MODULE_DIR": qlib_dir + (module_dir ? ":" + module_dir : ""),
            } + env,
        });
    }

    sessionTest() {
        TmpDir tmp("qore-vda-test-");
        string path = tmp.path + "/target.q";
        {
            File f();
            f.open2(path, O_CREAT | O_WRONLY | O_TRUNC);
            f.write(Program);
        }

        Process proc = startAdapter();
        on_exit if (proc.running()) {
            proc.terminate();
        }
        DapClient dap(proc);

        hash<auto> r = dap.request("initialize", {"adapterID": "qore", "linesStartAt1": True,
            "columnsStartAt1": True, "pathFormat": "path"});
        assertTrue(r.success, r.message);
        assertTrue(r.body.supportsConfigurationDoneRequest);

        r = dap.request("launch", {"program": path, "stopOnEntry": True});
        assertTrue(r.success, r.message);
        dap.waitForEvent("initialized");

        # requests without arguments are accepted with empty arguments, as the protocol allows
        r = dap.request("configurationDone");
        assertTrue(r.success, r.message);

        hash<auto> stopped = dap.waitForEvent("stopped");
        assertEq("entry", stopped.body.reason);
        int tid = stopped.body.threadId;
        r = dap.request("threads", NOTHING, False);
        assertTrue(r.success, r.message);
        assertEq((tid,), (map $1.id, r.body.threads));

        # the call stack of the stopped thread
        r = dap.request("stackTrace", {"threadId": tid});
        assertTrue(r.success, r.message);
        list<hash<auto>> frames = r.body.stackFrames;
        assertTrue(frames.size() > 0);
        # the source of the frame is the file itself, where the IDE shows values in hovers
        assertEq({"name": "target.q", "path": path, "sourceReference": 0}, frames[0].source);
        assertEq(6, frames[0].line);

        # the variables of the frame
        r = dap.request("scopes", {"frameId": frames[0].id});
        assertTrue(r.success, r.message);
        hash<string, int> scopes = map {$1.name: $1.variablesReference}, r.body.scopes;
        assertTrue(scopes.hasKey("Locals"));
        assertTrue(scopes.hasKey("Globals"));
        r = dap.request("variables", {"variablesReference": scopes.Locals});
        assertTrue(r.success, r.message);
        list<string> locals = map $1.name, r.body.variables;
        assertTrue(locals.contains("h"), sprintf("%y", locals));
        assertTrue(locals.contains("total"), sprintf("%y", locals));

        # after a step, the value of the local variable is shown in a watch
        r = dap.request("next", {"threadId": tid});
        assertTrue(r.success, r.message);
        stopped = dap.waitForEvent("stopped");
        assertEq("step", stopped.body.reason);
        r = dap.request("stackTrace", {"threadId": tid});
        frames = r.body.stackFrames;
        r = dap.request("evaluate", {"expression": "h.name", "context": "watch", "frameId": frames[0].id});
        assertTrue(r.success, r.message);
        assertRegex("invoice", r.body.result);

        # the output of the program is sent as output events
        r = dap.request("continue", {"threadId": tid});
        assertTrue(r.success, r.message);
        dap.waitFor(bool sub (hash<auto> m) {
            return m.type == "event" && m.event == "output" && m.body.category == "stdout";
        }, "stdout output event");
        dap.waitForEvent("terminated");
        r = dap.request("disconnect");
        assertTrue(r.success, r.message);
        proc.closeStdin();
        assertTrue(proc.wait(30s), "the adapter ends");
        assertEq(0, proc.exitCode());

        # nothing but protocol messages is written to stdout
        assertEq((), dap.stray);
    }

    #! Writes the given test program to the given directory and returns its path
    private string writeProgram(TmpDir tmp, string program = Program, string name = "target.q") {
        string path = tmp.path + "/" + name;
        File f();
        f.open2(path, O_CREAT | O_WRONLY | O_TRUNC);
        f.write(program);
        return path;
    }

    #! Initializes the session and launches the program with the given launch arguments; returns the launch response
    private hash<auto> launch(DapClient dap, hash<auto> launch_args) {
        hash<auto> r = dap.request("initialize", {"adapterID": "qore", "linesStartAt1": True,
            "columnsStartAt1": True, "pathFormat": "path"});
        assertTrue(r.success, r.message);
        capabilities = r.body;
        r = dap.request("launch", launch_args);
        assertTrue(r.success, r.message);
        dap.waitForEvent("initialized");
        return r;
    }

    #! Returns the top frame of the given thread
    private hash<auto> topFrame(DapClient dap, int tid) {
        hash<auto> r = dap.request("stackTrace", {"threadId": tid});
        assertTrue(r.success, r.message);
        return r.body.stackFrames[0];
    }

    #! Continues the program to its end and ends the adapter
    private finish(DapClient dap, Process proc, int tid) {
        hash<auto> r = dap.request("continue", {"threadId": tid});
        assertTrue(r.success, r.message);
        dap.waitForEvent("terminated");
        r = dap.request("disconnect");
        assertTrue(r.success, r.message);
        proc.closeStdin();
        assertTrue(proc.wait(30s), "the adapter ends");
        assertEq(0, proc.exitCode());
        assertEq((), dap.stray);
    }

    noStopOnEntryTest() {
        TmpDir tmp("qore-vda-test-");
        string path = writeProgram(tmp);

        Process proc = startAdapter();
        on_exit if (proc.running()) {
            proc.terminate();
        }
        DapClient dap(proc);
        launch(dap, {"program": path, "stopOnEntry": False});

        # a breakpoint in add(), set before the program runs
        hash<auto> r = dap.request("setBreakpoints", {"source": {"path": path}, "breakpoints": ({"line": 3},)});
        assertTrue(r.success, r.message);
        assertEq(1, r.body.breakpoints.size());
        assertTrue(r.body.breakpoints[0].verified, sprintf("%y", r.body.breakpoints));
        int bkpt_id = r.body.breakpoints[0].id;

        r = dap.request("configurationDone");
        assertTrue(r.success, r.message);

        # the first stop is the breakpoint, not the first statement of the program
        hash<auto> stopped = dap.waitForEvent("stopped");
        # a breakpoint stop gives the breakpoints that are hit
        assertEq("breakpoint", stopped.body.reason);
        assertEq((bkpt_id,), stopped.body.hitBreakpointIds);
        int tid = stopped.body.threadId;
        hash<auto> frame = topFrame(dap, tid);
        assertEq(path, frame.source.path);
        assertEq(3, frame.line);
        # each frame is named after the function its line is in: the stop is in add(), which is called by the
        # top-level code at line 7
        r = dap.request("stackTrace", {"threadId": tid});
        assertTrue(r.success, r.message);
        assertEq((("add", 3), ("<top level>", 7)), (map ($1.name, $1.line), r.body.stackFrames));
        assertEq(2, r.body.totalFrames);

        # the arguments of add()
        r = dap.request("scopes", {"frameId": frame.id});
        assertTrue(r.success, r.message);
        int locals_ref = (select r.body.scopes, $1.name == "Locals")[0].variablesReference;
        r = dap.request("variables", {"variablesReference": locals_ref});
        assertTrue(r.success, r.message);
        hash<string, string> locals = map {$1.name: $1.value}, r.body.variables;
        assertEq("2", locals.a, sprintf("%y", locals));
        assertEq("3", locals.b, sprintf("%y", locals));

        finish(dap, proc, tid);
        # there was no other stop
        assertEq((), dap.getEvents("stopped"));
    }

    firstStatementBreakpointTest() {
        TmpDir tmp("qore-vda-test-");
        string path = writeProgram(tmp);

        Process proc = startAdapter();
        on_exit if (proc.running()) {
            proc.terminate();
        }
        DapClient dap(proc);
        launch(dap, {"program": path, "stopOnEntry": False});
        hash<auto> r = dap.request("setBreakpoints", {"source": {"path": path}, "breakpoints": ({"line": 6},)});
        assertTrue(r.success, r.message);
        assertTrue(r.body.breakpoints[0].verified, sprintf("%y", r.body.breakpoints));
        int bkpt_id = r.body.breakpoints[0].id;
        r = dap.request("configurationDone");
        assertTrue(r.success, r.message);

        # the breakpoint on the first statement of the program stops it there; the thread arrives there by a step,
        # and the stop is reported as a breakpoint stop
        hash<auto> stopped = dap.waitForEvent("stopped");
        assertEq("breakpoint", stopped.body.reason);
        assertEq((bkpt_id,), stopped.body.hitBreakpointIds);
        int tid = stopped.body.threadId;
        hash<auto> frame = topFrame(dap, tid);
        assertEq(path, frame.source.path);
        assertEq(6, frame.line);

        finish(dap, proc, tid);
        assertEq((), dap.getEvents("stopped"));
    }

