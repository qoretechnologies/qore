    threadTest() {
        TmpDir tmp("qore-vda-test-");
        string path = writeProgram(tmp, ThreadProgram);

        Process proc = startAdapter();
        on_exit if (proc.running()) {
            proc.terminate();
        }
        DapClient dap(proc);
        launch(dap, {"program": path, "stopOnEntry": False});
        hash<auto> r = dap.request("setBreakpoints", {"source": {"path": path}, "breakpoints": ({"line": 3},)});
        assertTrue(r.success, r.message);
        int bkpt_id = r.body.breakpoints[0].id;
        r = dap.request("configurationDone");
        assertTrue(r.success, r.message);

        # the thread started by the program does not stop when it starts, but at the breakpoint
        hash<auto> stopped = dap.waitForEvent("stopped");
        assertEq("breakpoint", stopped.body.reason);
        assertEq((bkpt_id,), stopped.body.hitBreakpointIds);
        int tid = stopped.body.threadId;

        # the threads are shown with their names
        r = dap.request("threads", NOTHING, False);
        assertTrue(r.success, r.message);
        hash<string, string> names = map {$1.id: $1.name}, r.body.threads;
        assertEq(2, names.size(), sprintf("%y", r.body.threads));
        assertEq(HAVE_THREAD_NAME ? sprintf("worker (%d)", tid) : sprintf("Thread %d", tid), names{tid});
        # the thread that started the program has a default name
        int main_tid = (select keys names, $1.toInt() != tid)[0].toInt();
        assertEq(sprintf("Main Thread (%d)", main_tid), names{main_tid});

        # the call stack of the thread ends with the call of its code by the background operator at line 10; the
        # top-level code that started the thread is not in it
        r = dap.request("stackTrace", {"threadId": tid});
        assertTrue(r.success, r.message);
        list<hash<auto>> frames = r.body.stackFrames;
        assertEq(("add", "work"), (map $1.name, frames[0..1]), sprintf("%y", frames));
        assertEq((3, 7, 10, 10), (map $1.line, frames), sprintf("%y", frames));
        assertEq("<background operator>", frames.last().name);
        assertEq(frames.size(), r.body.totalFrames);

        r = dap.request("continue", {"threadId": tid});
        assertTrue(r.success, r.message);
        dap.waitForEvent("terminated");
        assertEq(("done\n",), dap.getOutput("stdout"));
        # the thread is reported as ended, and it does not stop when it ends
        assertTrue((select dap.getEvents("thread"), $1.body.threadId == tid && $1.body.reason == "exited").size() > 0,
            sprintf("%y", dap.getEvents("thread")));
        assertEq((), dap.getEvents("stopped"));
        r = dap.request("disconnect");
        assertTrue(r.success, r.message);
        proc.closeStdin();
        assertTrue(proc.wait(30s), "the adapter ends");
        assertEq(0, proc.exitCode());
    }

    pauseTest() {
        TmpDir tmp("qore-vda-test-");
        string path = writeProgram(tmp, LoopProgram);

        Process proc = startAdapter();
        on_exit if (proc.running()) {
            proc.terminate();
        }
        DapClient dap(proc);
        launch(dap, {"program": path, "stopOnEntry": False});
        hash<auto> r = dap.request("configurationDone");
        assertTrue(r.success, r.message);

        # the program is in its loop once it has written its output
        dap.waitFor(bool sub (hash<auto> m) {
            return m.type == "event" && m.event == "output" && m.body.category == "stdout"
                && m.body.output == "looping\n";
        }, "stdout output event");
        r = dap.request("threads", NOTHING, False);
        assertTrue(r.success, r.message);
        assertEq(1, r.body.threads.size());
        int tid = r.body.threads[0].id;

        r = dap.request("pause", {"threadId": tid});
        assertTrue(r.success, r.message);
        hash<auto> stopped = dap.waitForEvent("stopped");
        assertEq("pause", stopped.body.reason);
        assertEq(tid, stopped.body.threadId);
        hash<auto> frame = topFrame(dap, tid);
        assertEq("<top level>", frame.name);
        assertTrue(inlist(frame.line, (4, 5)), sprintf("%y", frame));

        # the loop ends when its variable is set
        r = dap.request("scopes", {"frameId": frame.id});
        assertTrue(r.success, r.message);
        int locals_ref = (select r.body.scopes, $1.name == "Locals")[0].variablesReference;
        r = dap.request("setVariable", {"variablesReference": locals_ref, "name": "done", "value": "True"});
        assertTrue(r.success, r.message);

        # a step after the pause is a step
        r = dap.request("next", {"threadId": tid});
        assertTrue(r.success, r.message);
        stopped = dap.waitForEvent("stopped");
        assertEq("step", stopped.body.reason);

        finish(dap, proc, tid);
        # the output before the pause was taken above
        assertEq(("done\n",), dap.getOutput("stdout"));
    }

    columnConversionTest() {
        # a character of two bytes and one of four bytes and two UTF-16 code units
        string line = "a\u00e9\U0001f600b";
        assertEq(0, VscDebugAdapter::getByteColumn(line, 1));
        assertEq(1, VscDebugAdapter::getByteColumn(line, 2));
        assertEq(3, VscDebugAdapter::getByteColumn(line, 3));
        assertEq(7, VscDebugAdapter::getByteColumn(line, 5));
        assertEq(7, VscDebugAdapter::getByteColumn(line, 4, False));
        assertEq(1, VscDebugAdapter::getProtocolColumn(line, 0));
        assertEq(3, VscDebugAdapter::getProtocolColumn(line, 3));
        assertEq(5, VscDebugAdapter::getProtocolColumn(line, 7));
        assertEq(4, VscDebugAdapter::getProtocolColumn(line, 7, False));
        # columns after the end of the line
        assertEq(10, VscDebugAdapter::getByteColumn(line, 8));
        assertEq(8, VscDebugAdapter::getProtocolColumn(line, 10));
        # without the text of the line, a character is a byte
        assertEq(4, VscDebugAdapter::getByteColumn(NOTHING, 5));
        assertEq(5, VscDebugAdapter::getProtocolColumn(NOTHING, 4));
        # columns before the start of the line
        assertEq(0, VscDebugAdapter::getByteColumn(line, 0));
    }

    columnBreakpointTest() {
        TmpDir tmp("qore-vda-test-");
        string path = writeProgram(tmp, ColumnProgram);
        Process proc = startAdapter();
        on_exit if (proc.running()) {
            proc.terminate();
        }
        DapClient dap(proc);
        launch(dap, {"program": path, "stopOnEntry": False});

        # each statement that starts on a line is a location
        hash<auto> r = dap.request("breakpointLocations", {"source": {"path": path}, "line": 3});
        assertTrue(r.success, r.message);
        assertEq(({"line": 3, "column": 1}, {"line": 3, "column": 19}, {"line": 3, "column": 38}),
            r.body.breakpoints);
        # a range of lines and columns
        r = dap.request("breakpointLocations", {"source": {"path": path}, "line": 3, "column": 2, "endLine": 4,
            "endColumn": 10});
        assertTrue(r.success, r.message);
        assertEq(({"line": 3, "column": 19}, {"line": 3, "column": 38}, {"line": 4, "column": 1}),
            r.body.breakpoints);
        # negative: a line without a statement and a file that is not a source of the program
        r = dap.request("breakpointLocations", {"source": {"path": path}, "line": 5});
        assertTrue(r.success, r.message);
        assertEq((), r.body.breakpoints);
        r = dap.request("breakpointLocations", {"source": {"path": tmp.path + "/other.q"}, "line": 3});
        assertTrue(r.success, r.message);
        assertEq((), r.body.breakpoints);

        # a breakpoint on the second statement of line 3, and one in the middle of the second statement of line 4
        # (column 9 of "x = add(x, 4); x = add(x, 5);" is in the first statement, column 20 in the second)
        r = dap.request("setBreakpoints", {"source": {"path": path}, "breakpoints": ({"line": 3, "column": 19},
            {"line": 4, "column": 20})});
        assertTrue(r.success, r.message);
        assertEq((True, True), (map $1.verified, r.body.breakpoints));
        # the IDE shows each breakpoint at the statement that it is set on
        assertEq(((3, 19), (4, 16)), (map ($1.line, $1.column), r.body.breakpoints));
        list<int> bkpt_ids = map $1.id, r.body.breakpoints;
        r = dap.request("configurationDone");
        assertTrue(r.success, r.message);

        # the first statement of line 3 runs, the thread stops at its second statement
        hash<auto> stopped = dap.waitForEvent("stopped");
        assertEq("breakpoint", stopped.body.reason);
        assertEq((bkpt_ids[0],), stopped.body.hitBreakpointIds);
        int tid = stopped.body.threadId;
        hash<auto> frame = topFrame(dap, tid);
        assertEq((3, 19, 3, 36), (frame.line, frame.column, frame.endLine, frame.endColumn));
        # the first statement of the line ran
        assertEq("\"é😀\"", evaluate(dap, tid, "s").body.result);

        # the second breakpoint is on the second statement of line 4
        r = dap.request("continue", {"threadId": tid});
        assertTrue(r.success, r.message);
        stopped = dap.waitForEvent("stopped");
        assertEq((bkpt_ids[1],), stopped.body.hitBreakpointIds);
        frame = topFrame(dap, tid);
        assertEq((4, 16), (frame.line, frame.column));
        assertEq("7", evaluate(dap, tid, "x").body.result);

        finish(dap, proc, tid);
        assertEq(("3\n",), dap.getOutput("stdout"));
    }

    stepInTargetTest() {
        TmpDir tmp("qore-vda-test-");
        string path = writeProgram(tmp, StepInProgram);
        Process proc = startAdapter();
        on_exit if (proc.running()) {
            proc.terminate();
        }
        DapClient dap(proc);
        hash<auto> stopped = launchToStop(dap, path, ({"line": 4}, {"line": 5}));
        assertTrue(capabilities.supportsStepInTargetsRequest);
        assertTrue(capabilities.supportsBreakpointLocationsRequest);
        int tid = stopped.body.threadId;
        hash<auto> frame = topFrame(dap, tid);
        assertEq(4, frame.line);

        # the calls of the statement, with their locations: "int r = g(h(1));"
        hash<auto> r = dap.request("stepInTargets", {"frameId": frame.id});
        assertTrue(r.success, r.message);
        assertEq((("h", 4, 11, 15), ("g", 4, 9, 16)), (map ($1.label, $1.line, $1.column, $1.endColumn),
            r.body.targets));
        int g_target = r.body.targets[1].id;
        # only the top frame has targets
        r = dap.request("stepInTargets", {"frameId": frame.id + 1});
        assertTrue(r.success, r.message);
        assertEq((), r.body.targets);

        # stepping into g(): the thread stops in g() when the statement calls it with the value of h(1), not in the
        # call of g() in h()
        r = dap.request("stepIn", {"threadId": tid, "targetId": g_target});
        assertTrue(r.success, r.message);
        stopped = dap.waitForEvent("stopped");
        assertEq("step", stopped.body.reason);
        frame = topFrame(dap, tid);
        assertEq(2, frame.line);
        assertEq("4", evaluate(dap, tid, "x").body.result);
        # the frame of the caller is located at the call of g(), with the columns of its step-in target
        r = dap.request("stackTrace", {"threadId": tid});
        assertTrue(r.success, r.message);
        hash<auto> caller = r.body.stackFrames[1];
        assertEq((4, 4, 9, 16), (caller.line, caller.endLine, caller.column, caller.endColumn));

        # line 5 calls g() only in h(), so it has h() only
        r = dap.request("continue", {"threadId": tid});
        assertTrue(r.success, r.message);
        stopped = dap.waitForEvent("stopped");
        assertEq("breakpoint", stopped.body.reason);
        frame = topFrame(dap, tid);
        assertEq(5, frame.line);
        r = dap.request("stepInTargets", {"frameId": frame.id});
        assertEq(("h",), (map $1.label, r.body.targets));
        r = dap.request("stepIn", {"threadId": tid, "targetId": r.body.targets[0].id});
        assertTrue(r.success, r.message);
        stopped = dap.waitForEvent("stopped");
        assertEq("step", stopped.body.reason);
        frame = topFrame(dap, tid);
        assertEq(3, frame.line);
        assertEq("5", evaluate(dap, tid, "x").body.result);
        # negative: a target that the statement does not have
        r = dap.request("stepIn", {"threadId": tid, "targetId": 9});
        assertFalse(r.success);
        assertRegex("no call 8 to step into", r.message);

        finish(dap, proc, tid);
        assertEq(("12\n",), dap.getOutput("stdout"));
    }

    #! Launches the given program with breakpoints and returns the first stopped event
    /** @param breakpoints the source breakpoints of the program, as given in a \c setBreakpoints request
    */
    private hash<auto> launchToStop(DapClient dap, string path, list<auto> breakpoints) {
        launch(dap, {"program": path, "stopOnEntry": False});
        hash<auto> r = dap.request("setBreakpoints", {"source": {"path": path}, "breakpoints": breakpoints});
        assertTrue(r.success, r.message);
        foreach hash<auto> b in (r.body.breakpoints) {
            assertTrue(b.verified, sprintf("%y", r.body.breakpoints));
        }
        r = dap.request("configurationDone");
        assertTrue(r.success, r.message);
        return dap.waitForEvent("stopped");
    }

    #! Returns the variables of a variable reference as a hash by name
    private hash<auto> getVariables(DapClient dap, int ref, *hash<auto> args) {
        hash<auto> r = dap.request("variables", {"variablesReference": ref} + args);
        assertTrue(r.success, r.message);
        return (map {$1.name: $1}, r.body.variables) ?? {};
    }

    #! Returns the variable reference of the given scope of the top frame of a thread
    private int getScope(DapClient dap, int tid, string scope) {
        hash<auto> frame = topFrame(dap, tid);
        hash<auto> r = dap.request("scopes", {"frameId": frame.id});
        assertTrue(r.success, r.message);
        return (select r.body.scopes, $1.name == scope)[0].variablesReference;
    }

    # a launched program ends when the IDE disconnects, also a thread that runs forever
    terminateTest() {
        TmpDir tmp("qore-vda-test-");
        string path = writeProgram(tmp, "%modern\nint n;\nwhile (True) {\n    ++n;\n}\n");
        Process proc = startAdapter();
        on_exit if (proc.running()) {
            proc.terminate();
        }
        DapClient dap(proc);
        launch(dap, {"program": path, "stopOnEntry": False});
        assertTrue(capabilities.supportTerminateDebuggee);
        hash<auto> r = dap.request("configurationDone");
        assertTrue(r.success, r.message);
        # the default of terminateDebuggee for a launched program
        r = dap.request("disconnect");
        assertTrue(r.success, r.message);
        proc.closeStdin();
        assertTrue(proc.wait(30s), "the adapter ends with the program");
        assertEq(0, proc.exitCode());
    }

    # the program is ended and launched again; the IDE sets the breakpoints again after the "initialized" event
    restartTest() {
        TmpDir tmp("qore-vda-test-");
        string path = writeProgram(tmp);
        Process proc = startAdapter();
        on_exit if (proc.running()) {
            proc.terminate();
        }
        DapClient dap(proc);
        hash<auto> stopped = launchToStop(dap, path, ({"line": 3},));
        assertTrue(capabilities.supportsRestartRequest);
        assertEq("breakpoint", stopped.body.reason);
        hash<auto> r = dap.request("restart", {"arguments": {"program": path, "stopOnEntry": False}});
        assertTrue(r.success, r.message);
        dap.waitForEvent("initialized");
        r = dap.request("setBreakpoints", {"source": {"path": path}, "breakpoints": ({"line": 3},)});
        assertTrue(r.success, r.message);
        assertTrue(r.body.breakpoints[0].verified, sprintf("%y", r.body.breakpoints));
        r = dap.request("configurationDone");
        assertTrue(r.success, r.message);
        stopped = dap.waitForEvent("stopped");
        assertEq("breakpoint", stopped.body.reason);
        int tid = stopped.body.threadId;
        assertEq(3, topFrame(dap, tid).line);
        # the end of the first run did not end the session
        assertEq((), dap.getEvents("exited") + dap.getEvents("terminated"));
        finish(dap, proc, tid);
        # the first run ended at the breakpoint, before its output
        assertEq(1, (select dap.getOutput("stdout"), $1 =~ /total: 5/).size());
        # the end of the second run is reported
        assertEq(1, dap.getEvents("exited").size());
    }

    # integers are shown in hexadecimal with the hex option of the format argument
    hexFormatTest() {
        TmpDir tmp("qore-vda-test-");
        string path = writeProgram(tmp);
        Process proc = startAdapter();
        on_exit if (proc.running()) {
            proc.terminate();
        }
        DapClient dap(proc);
        hash<auto> stopped = launchToStop(dap, path, ({"line": 8},));
        int tid = stopped.body.threadId;
        assertTrue(capabilities.supportsValueFormattingOptions);
        hash<auto> frame = topFrame(dap, tid);
        hash<auto> r = dap.request("evaluate", {"expression": "total * 3", "frameId": frame.id, "context": "watch",
            "format": {"hex": True}});
        assertTrue(r.success, r.message);
        assertEq("0xf", r.body.result);
        r = dap.request("evaluate", {"expression": "-total", "frameId": frame.id, "context": "watch",
            "format": {"hex": True}});
        assertEq("-0x5", r.body.result);
        # without the option, and a value that is not an integer
        assertEq("15", evaluate(dap, tid, "total * 3").body.result);
        r = dap.request("evaluate", {"expression": "h.name", "frameId": frame.id, "context": "watch",
            "format": {"hex": True}});
        assertEq("\"invoice\"", r.body.result);
        # variables and their elements
        hash<auto> vars = getVariables(dap, getScope(dap, tid, "Locals"), {"format": {"hex": True}});
        assertEq("0x5", vars.total.value);
        hash<auto> h = getVariables(dap, vars.h.variablesReference, {"format": {"hex": True}});
        assertEq(("0x1", "0x2", "0x3"), map $1.value,
            getVariables(dap, h.lines.variablesReference, {"format": {"hex": True}}).iterator());
        finish(dap, proc, tid);
    }

    # an exception that matches a common pitfall is shown with a hint, and a variable that was declared but not
    # assigned is shown as such
    trapHintTest() {
        TmpDir tmp("qore-vda-test-");
        string path = writeProgram(tmp, "%modern\n"                     # 1
            "sub f() {\n"                                                # 2
            "    *int src;\n"                                            # 3
            "    int count = src;\n"                                     # 4
            "    printf(\"%d\\n\", count);\n"                             # 5
            "}\n"                                                        # 6
            "f();\n");                                                   # 7
        Process proc = startAdapter();
        on_exit if (proc.running()) {
            proc.terminate();
        }
        DapClient dap(proc);
        launch(dap, {"program": path, "stopOnEntry": False});
        hash<auto> r = dap.request("setExceptionBreakpoints", {"filters": ("uncaught",)});
        assertTrue(r.success, r.message);
        r = dap.request("configurationDone");
        assertTrue(r.success, r.message);

        hash<auto> stopped = dap.waitForEvent("stopped");
        assertEq("exception", stopped.body.reason);
        assertEq("RUNTIME-TYPE-ERROR", stopped.body.text);
        int tid = stopped.body.threadId;
        assertEq(4, topFrame(dap, tid).line);
        r = dap.request("exceptionInfo", {"threadId": tid});
        assertTrue(r.success, r.message);
        assertEq("RUNTIME-TYPE-ERROR", r.body.exceptionId);
        assertRegex("^<lvalue> expects type 'int', but got no value instead\n\nhint \\(NO-VALUE-FOR-TYPE\\): ",
            r.body.description);
        assertRegex("\n  - assign the variable before it is read", r.body.description);
        # the message is the description of the exception only
        assertEq("<lvalue> expects type 'int', but got no value instead", r.body.details.message);

        hash<auto> locals = getVariables(dap, getScope(dap, tid, "Locals"));
        assertEq("NOTHING (declared but not assigned)", locals.count.value);
        assertEq("int", locals.count.type);
        # a variable whose type allows no value is not unassigned
        assertEq("NOTHING", locals.src.value);
        assertEq("nothing", locals.src.type);

        r = dap.request("continue", {"threadId": tid});
        assertTrue(r.success, r.message);
        dap.waitForEvent("terminated");
        r = dap.request("disconnect");
        assertTrue(r.success, r.message);
        proc.closeStdin();
        assertTrue(proc.wait(30s), "the adapter ends");
    }

    #! Evaluates an expression with the top frame of a thread and returns the response
    private hash<auto> evaluate(DapClient dap, int tid, string expr, string eval_context = "watch") {
        return dap.request("evaluate", {"expression": expr, "frameId": topFrame(dap, tid).id,
            "context": eval_context});
    }

    variablesTest() {
        TmpDir tmp("qore-vda-test-");
        string path = writeProgram(tmp, DataProgram);
        Process proc = startAdapter();
        on_exit if (proc.running()) {
            proc.terminate();
        }
        DapClient dap(proc);
        hash<auto> stopped = launchToStop(dap, path, ({"line": 20},));
        int tid = stopped.body.threadId;

        # the global variables of the program
        hash<auto> vars = getVariables(dap, getScope(dap, tid, "Globals"));
        assertEq("Account", vars.acct.type);
        # the object has the members of its class and of its parent class, also private ones
        assertEq(4, vars.acct.namedVariables);
        assertEq("hash<auto> (3)", vars.h.value);
        assertEq(3, vars.h.namedVariables);
        assertEq("h", vars.h.evaluateName);
        # the local variables of the top-level code
        hash<auto> locals = getVariables(dap, getScope(dap, tid, "Locals"));
        assertEq(250, locals.big.indexedVariables);
        assertEq("list (250)", locals.big.value);
        assertEq(0, locals.r.variablesReference);

        # the keys of a hash, and the elements of a list in it
        hash<auto> h = getVariables(dap, vars.h.variablesReference);
        assertEq(("name", "lines", "nested"), keys h);
        assertEq("\"invoice\"", h.name.value);
        assertEq("h{\"lines\"}", h.lines.evaluateName);
        hash<auto> lines = getVariables(dap, h.lines.variablesReference);
        assertEq(("0", "1", "2"), keys lines);
        assertEq("3", lines."2".value);
        assertEq("h{\"lines\"}[2]", lines."2".evaluateName);
        assertEq("\"v\"", getVariables(dap, h.nested.variablesReference).k.value);

        # the members of an object, also private ones and those of parent classes
        hash<auto> acct = getVariables(dap, vars.acct.variablesReference);
        assertEq(("id", "balance", "meta", "name"), keys acct);
        assertEq("100", acct.balance.value);
        assertEq("7", acct.id.value);
        assertEq("acct.balance", acct.balance.evaluateName);
        hash<auto> meta = getVariables(dap, acct.meta.variablesReference);
        assertEq(("\"a\"", "\"b\""), map $1.value, getVariables(dap, meta.tags.variablesReference).iterator());

        # the elements of a long list are paged
        hash<auto> part = getVariables(dap, locals.big.variablesReference,
            {"filter": "indexed", "start": 100, "count": 3});
        assertEq(("100", "101", "102"), keys part);
        assertEq("101", part."101".value);
        assertEq({}, getVariables(dap, locals.big.variablesReference, {"filter": "named"}));

        # the local variables of a function and their values
        hash<auto> r = dap.request("stepIn", {"threadId": tid});
        assertTrue(r.success, r.message);
        dap.waitForEvent("stopped");
        locals = getVariables(dap, getScope(dap, tid, "Locals"));
        assertEq("5", locals.n.value);
        assertEq("n", locals.n.evaluateName);

        # the references of a thread are not valid once it has resumed
        int old_ref = vars.h.variablesReference;
        r = dap.request("continue", {"threadId": tid});
        assertTrue(r.success, r.message);
        dap.waitForEvent("terminated");
        r = dap.request("variables", {"variablesReference": old_ref});
        assertFalse(r.success);
        assertRegex("thread has resumed", r.message);
        r = dap.request("disconnect");
        assertTrue(r.success, r.message);
        proc.closeStdin();
        assertTrue(proc.wait(30s), "the adapter ends");
        assertEq(("r: 10\n",), dap.getOutput("stdout"));
    }

    setVariableTest() {
        TmpDir tmp("qore-vda-test-");
        string path = writeProgram(tmp, DataProgram);
        Process proc = startAdapter();
        on_exit if (proc.running()) {
            proc.terminate();
        }
        DapClient dap(proc);
        hash<auto> stopped = launchToStop(dap, path, ({"line": 20},));
        int tid = stopped.body.threadId;
        hash<auto> vars = getVariables(dap, getScope(dap, tid, "Globals"));

        # a key of a nested hash
        hash<auto> h = getVariables(dap, vars.h.variablesReference);
        hash<auto> r = dap.request("setVariable", {"variablesReference": h.nested.variablesReference, "name": "k",
            "value": "\"w\""});
        assertTrue(r.success, r.message);
        assertEq("\"w\"", r.body.value);
        assertEq("\"w\"", evaluate(dap, tid, "h.nested.k").body.result);

        # an element of a list
        r = dap.request("setVariable", {"variablesReference": h.lines.variablesReference, "name": "1",
            "value": "20"});
        assertTrue(r.success, r.message);
        assertEq("20", evaluate(dap, tid, "h.lines[1]").body.result);

        # a private member of an object, which the object's method returns
        hash<auto> acct = getVariables(dap, vars.acct.variablesReference);
        r = dap.request("setVariable", {"variablesReference": vars.acct.variablesReference, "name": "balance",
            "value": "7"});
        assertTrue(r.success, r.message);
        assertEq("7", evaluate(dap, tid, "acct.getBalance()").body.result);

        # negative: a value of the wrong type for a typed list, and an element that does not exist
        hash<auto> locals = getVariables(dap, getScope(dap, tid, "Locals"));
        r = dap.request("setVariable", {"variablesReference": locals.big.variablesReference, "name": "0",
            "value": "\"x\""});
        assertFalse(r.success);
        r = dap.request("setVariable", {"variablesReference": h.lines.variablesReference, "name": "9",
            "value": "1"});
        assertFalse(r.success);
        assertRegex("no element 9", r.message);

        # a global variable, which the program uses; the value is an expression
        r = dap.request("setVariable", {"variablesReference": getScope(dap, tid, "Globals"), "name": "h",
            "value": "{\"name\": \"other-\" + acct.name}"});
        assertTrue(r.success, r.message);
        assertEq(1, r.body.namedVariables);
        assertEq("\"other-acct\"", evaluate(dap, tid, "h.name").body.result);

        finish(dap, proc, tid);
    }

    evaluateTest() {
        TmpDir tmp("qore-vda-test-");
        string path = writeProgram(tmp, DataProgram);
        Process proc = startAdapter();
        on_exit if (proc.running()) {
            proc.terminate();
        }
        DapClient dap(proc);
        hash<auto> stopped = launchToStop(dap, path, ({"line": 13},));
        int tid = stopped.body.threadId;

        # watches with the local variables of the frame and the global variables of the program
        hash<auto> r = evaluate(dap, tid, "i + 10");
        assertTrue(r.success, r.message);
        assertEq("10", r.body.result);
        assertEq("integer", r.body.type);
        assertEq("\"invoice-5\"", evaluate(dap, tid, "sprintf(\"%s-%d\", h.name, n)").body.result);
        assertEq("100", evaluate(dap, tid, "acct.getBalance()").body.result);
        # a hover
        assertEq("hash<auto> (3)", evaluate(dap, tid, "h", "hover").body.result);

        # a structured value is shown as a tree
        r = evaluate(dap, tid, "h.lines");
        assertTrue(r.success, r.message);
        assertEq(3, r.body.indexedVariables);
        assertEq(("1", "2", "3"), map $1.value, getVariables(dap, r.body.variablesReference).iterator());

        # the debug console: an expression, an expression with "$", and a debugger command
        r = evaluate(dap, tid, "n * 2", "repl");
        assertEq("10", r.body.result);
        r = evaluate(dap, tid, "$n", "repl");
        assertEq("5", r.body.result);
        r = evaluate(dap, tid, "help", "repl");
        assertTrue(r.success, r.message);
        assertEq("", r.body.result);
        # the shortcuts of the command line, such as "n" for "go stepover", and aliases, such as "backtrace" for "bt",
        # are not commands in the debug console, as they can be the names of variables
        r = evaluate(dap, tid, "n", "repl");
        assertEq("5", r.body.result);
        foreach string word in ("locals", "continue", "backtrace") {
            r = evaluate(dap, tid, word, "repl");
            assertFalse(r.success, word);
            # evaluated as an expression
            assertRegex("^DEBUG-EVALUATE-ERROR: ", r.message, word);
        }

        # the code of the program: a function, and a class whose private member is read by its method
        r = evaluate(dap, tid, "work(n) + new Account().getBalance()", "repl");
        assertTrue(r.success, r.message);
        assertEq("110", r.body.result);

        # negative: a syntax error, an unknown variable, and code that the expressions may not run
        r = evaluate(dap, tid, "n +");
        assertFalse(r.success);
        # the error is given without the errors of the commands that it was sent with
        assertRegex("^DEBUG-EVALUATE-ERROR: ", r.message);
        r = evaluate(dap, tid, "no_such_name");
        assertEq("DEBUG-EVALUATE-ERROR: cannot resolve bareword 'no_such_name' to any reachable object", r.message);
        r = evaluate(dap, tid, "no_such_variable + 1");
        assertFalse(r.success);
        r = evaluate(dap, tid, "system(\"true\")");
        assertFalse(r.success);
        # an expression without a frame
        r = dap.request("evaluate", {"expression": "1 + 1", "context": "watch"});
        assertFalse(r.success);

        # an assignment in an expression does not change the program's variable
        evaluate(dap, tid, "total = 1000");
        assertEq("0", evaluate(dap, tid, "total").body.result);

        # the breakpoint in the loop stops the thread in the other iterations
        assertEq((13, 13, 13, 13), runToEnd(dap, proc, tid));
    }

    #! Continues the thread until the program ends and returns the lines of the stops on the way
    private list<int> runToEnd(DapClient dap, Process proc, int tid) {
        list<int> lines = ();
        while (True) {
            hash<auto> r = dap.request("continue", {"threadId": tid});
            assertTrue(r.success, r.message);
            hash<auto> m = dap.waitFor(bool sub (hash<auto> m) {
                return m.type == "event" && (m.event == "stopped" || m.event == "terminated");
            }, "stopped or terminated event");
            if (m.event == "terminated") {
                break;
            }
            push lines, topFrame(dap, tid).line;
        }
        hash<auto> r = dap.request("disconnect");
        assertTrue(r.success, r.message);
        proc.closeStdin();
        assertTrue(proc.wait(30s), "the adapter ends");
        assertEq(0, proc.exitCode());
        return lines;
    }

    conditionalBreakpointTest() {
        TmpDir tmp("qore-vda-test-");
        string path = writeProgram(tmp, DataProgram);
        Process proc = startAdapter();
        on_exit if (proc.running()) {
            proc.terminate();
        }
        DapClient dap(proc);
        # the breakpoint stops the thread only when its condition is true
        hash<auto> stopped = launchToStop(dap, path, ({"line": 13, "condition": "i == 3"},));
        assertEq("breakpoint", stopped.body.reason);
        int tid = stopped.body.threadId;
        assertEq("3", evaluate(dap, tid, "i").body.result);
        assertEq((), runToEnd(dap, proc, tid));
        assertEq(("r: 10\n",), dap.getOutput("stdout"));

        # negative: a condition that raises an error when it is evaluated stops the thread, and the error is shown
        Process proc2 = startAdapter();
        on_exit if (proc2.running()) {
            proc2.terminate();
        }
        DapClient dap2(proc2);
        stopped = launchToStop(dap2, path, ({"line": 13, "condition": "i.nosuchmethod()"},));
        assertEq("breakpoint", stopped.body.reason);
        assertRegex("nosuchmethod", dap2.getOutput("console").join(""));
        tid = stopped.body.threadId;
        assertEq("0", evaluate(dap2, tid, "i").body.result);
        # every hit stops the thread
        assertEq((13, 13, 13, 13), runToEnd(dap2, proc2, tid));

        # negative: a breakpoint with a condition that cannot be parsed with the variables of its statement is not
        # set, and the IDE shows why
        Process proc3 = startAdapter();
        on_exit if (proc3.running()) {
            proc3.terminate();
        }
        DapClient dap3(proc3);
        launch(dap3, {"program": path, "stopOnEntry": False});
        hash<auto> r = dap3.request("setBreakpoints", {"source": {"path": path}, "breakpoints": (
            {"line": 13, "condition": "i =="},
            {"line": 13, "condition": "nosuchvar > 1"},
        )});
        assertTrue(r.success, r.message);
        assertEq((False, False), map $1.verified, r.body.breakpoints);
        assertRegex("^invalid condition \"i ==\": ", r.body.breakpoints[0].message);
        assertRegex("^invalid condition \"nosuchvar > 1\": .*nosuchvar", r.body.breakpoints[1].message);
        r = dap3.request("configurationDone");
        assertTrue(r.success, r.message);
        # no breakpoint was left set: the program runs to its end
        dap3.waitForEvent("terminated");
        assertEq((), dap3.getEvents("stopped"));
        dap3.request("disconnect");
        proc3.closeStdin();
        assertTrue(proc3.wait(30s), "the adapter ends");
    }

    hitConditionTest() {
        TmpDir tmp("qore-vda-test-");
        string path = writeProgram(tmp, DataProgram);
        # blanks are allowed also between the characters of an operator
        foreach hash<auto> i in ({"cond": ">= 4", "values": ("3", "4")}, {"cond": "%2", "values": ("1", "3")},
                {"cond": "2", "values": ("1",)}, {"cond": "> = 4", "values": ("3", "4")}) {
            Process proc = startAdapter();
            on_exit if (proc.running()) {
                proc.terminate();
            }
            DapClient dap(proc);
            hash<auto> stopped = launchToStop(dap, path, ({"line": 13, "hitCondition": i.cond},));
            int tid = stopped.body.threadId;
            list<string> values = (evaluate(dap, tid, "i").body.result,);
            while (True) {
                hash<auto> r = dap.request("continue", {"threadId": tid});
                assertTrue(r.success, r.message);
                hash<auto> m = dap.waitFor(bool sub (hash<auto> m) {
                    return m.type == "event" && (m.event == "stopped" || m.event == "terminated");
                }, "stopped or terminated event");
                if (m.event == "terminated") {
                    break;
                }
                push values, evaluate(dap, tid, "i").body.result;
            }
            assertEq(i.values, values, i.cond);
            dap.request("disconnect");
            proc.closeStdin();
            assertTrue(proc.wait(30s), "the adapter ends");
        }

        # negative: a breakpoint with an invalid hit condition is not set, and the IDE shows why
        Process proc = startAdapter();
        on_exit if (proc.running()) {
            proc.terminate();
        }
        DapClient dap(proc);
        launch(dap, {"program": path, "stopOnEntry": False});
        hash<auto> r = dap.request("setBreakpoints", {"source": {"path": path}, "breakpoints": (
            {"line": 13, "hitCondition": "often"},
        )});
        assertTrue(r.success, r.message);
        assertFalse(r.body.breakpoints[0].verified);
        # the IDE shows the reason in plain words, without the code of the error
        assertEq("invalid hit condition \"often\"; give a number, optionally after ==, >, >=, <, <= or %",
            r.body.breakpoints[0].message);
        r = dap.request("configurationDone");
        assertTrue(r.success, r.message);
        # no breakpoint was left set: the program runs to its end
        dap.waitForEvent("terminated");
        assertEq((), dap.getEvents("stopped"));
        dap.request("disconnect");
        proc.closeStdin();
        assertTrue(proc.wait(30s), "the adapter ends");
    }

    logpointTest() {
        TmpDir tmp("qore-vda-test-");
        string path = writeProgram(tmp, DataProgram);
        Process proc = startAdapter();
        on_exit if (proc.running()) {
            proc.terminate();
        }
        DapClient dap(proc);
        launch(dap, {"program": path, "stopOnEntry": False});
        hash<auto> r = dap.request("setBreakpoints", {"source": {"path": path}, "breakpoints": (
            {"line": 13, "logMessage": "i={i} total={total} name={h.name} bad={i.nosuchmethod()}"},
        )});
        assertTrue(r.success, r.message);
        r = dap.request("configurationDone");
        assertTrue(r.success, r.message);
        # the logpoint writes its message and does not stop the thread
        dap.waitForEvent("terminated");
        assertEq((), dap.getEvents("stopped"));
        list<string> log = select dap.getOutput("console"), $1 =~ /^i=/;
        assertEq(5, log.size(), sprintf("%y", log));
        assertRegex("^i=0 total=0 name=invoice bad=<[A-Z-]+: .*nosuchmethod", log[0]);
        assertRegex("^i=4 total=6 ", log[4]);
        assertEq(("r: 10\n",), dap.getOutput("stdout"));
        r = dap.request("disconnect");
        assertTrue(r.success, r.message);
        proc.closeStdin();
        assertTrue(proc.wait(30s), "the adapter ends");
    }

    conditionalStepTest() {
        TmpDir tmp("qore-vda-test-");
        string path = writeProgram(tmp, DataProgram);
        Process proc = startAdapter();
        on_exit if (proc.running()) {
            proc.terminate();
        }
        DapClient dap(proc);
        # a breakpoint before the loop, and one in the loop whose condition is never true
        hash<auto> stopped = launchToStop(dap, path, ({"line": 11}, {"line": 13, "condition": "i < 0"}));
        int tid = stopped.body.threadId;
        assertEq(11, topFrame(dap, tid).line);
        # stepping onto the statement of the breakpoint stops there as a step
        int line;
        while (line != 13) {
            hash<auto> r = dap.request("next", {"threadId": tid});
            assertTrue(r.success, r.message);
            stopped = dap.waitForEvent("stopped");
            line = topFrame(dap, tid).line;
        }
        assertEq("step", stopped.body.reason);
        # running on, the breakpoint does not stop the thread
        assertEq((), runToEnd(dap, proc, tid));
    }

    #! A client that starts the adapter with sockets for its standard input and output, as Visual Studio Code does,
    #! runs a program with a logpoint and prints the messages that it gets; Qore cannot give a socket to a process
    const SocketClient = "import json, socket, subprocess, sys, os
qore, adapter, prog = sys.argv[1:4]
a_in, c_in = socket.socketpair()
a_out, c_out = socket.socketpair()
p = subprocess.Popen([qore, adapter], stdin=a_in.fileno(), stdout=a_out.fileno())
a_in.close(); a_out.close()
buf = b''
seq = 0
def send(cmd, args):
    global seq
    seq += 1
    m = json.dumps({'seq': seq, 'type': 'request', 'command': cmd, 'arguments': args}).encode()
    c_in.sendall(b'Content-Length: %d\\r\\n\\r\\n' % len(m) + m)
def read():
    global buf
    while True:
        i = buf.find(b'\\r\\n\\r\\n')
        if i >= 0:
            if not buf.startswith(b'Content-Length:'):
                print('CORRUPTED %r' % buf[:80])
                sys.exit(1)
            n = int(buf[:i].split(b':')[1])
            if len(buf) >= i + 4 + n:
                m = json.loads(buf[i + 4:i + 4 + n])
                buf = buf[i + 4 + n:]
                return m
        d = c_out.recv(65536)
        if not d:
            print('EOF')
            sys.exit(1)
        buf += d
send('initialize', {'adapterID': 'qore', 'linesStartAt1': True, 'pathFormat': 'path'})
send('launch', {'program': prog, 'stopOnEntry': False})
send('setBreakpoints', {'source': {'path': prog}, 'breakpoints': [{'line': 13, 'logMessage': 'i={i}'}]})
send('configurationDone', {})
while True:
    m = read()
    if m.get('event') == 'output':
        print('%s: %s' % (m['body']['category'], m['body']['output'].rstrip()))
    elif m.get('event') == 'terminated':
        print('terminated')
        break
send('disconnect', {})
c_in.close()
print('exit code: %d' % p.wait(30))
";

    socketTest() {
        *string python = (backquote("command -v python3 2>/dev/null") =~ x/^(\S+)/)[0];
        if (!python) {
            testSkip("python3 is not available to start the adapter with sockets");
        }
        TmpDir tmp("qore-vda-test-");
        string path = writeProgram(tmp, DataProgram);
        string client = tmp.path + "/client.py";
        {
            File f();
            f.open2(client, O_CREAT | O_WRONLY | O_TRUNC);
            f.write(SocketClient);
        }
        *string module_dir = ENV.QORE_MODULE_DIR;
        Process proc(python, ("-I", client, qore_exe, adapter, path), {
            "env": Process::getEnvironment() + {
                "QORE_MODULE_DIR": qlib_dir + (module_dir ? ":" + module_dir : ""),
            },
        });
        on_exit if (proc.running()) {
            proc.terminate();
        }
        proc.wait();
        list<string> lines = proc.readStdout(1048576).split("\n");
        # the output of the program is captured, so that it does not corrupt the protocol, and it is sent before the
        # end of the session
        assertEq(("console: i=0", "console: i=1", "console: i=2", "console: i=3", "console: i=4", "stdout: r: 10",
            "terminated", "exit code: 0"), (select lines, $1 =~ /^(console: i=|stdout: |terminated|exit code)/),
            lines.join("\n"));
    }

    #! Runs a program in the adapter started with the given arguments and environment, and returns the client
    private DapClient runLogged(string path, list<string> args, *hash<auto> env) {
        Process proc = startAdapter(args, env);
        on_exit if (proc.running()) {
            proc.terminate();
        }
        DapClient dap(proc);
        launch(dap, {"program": path, "stopOnEntry": False});
        hash<auto> r = dap.request("configurationDone");
        assertTrue(r.success, r.message);
        dap.waitForEvent("terminated");
        r = dap.request("disconnect");
        assertTrue(r.success, r.message);
        proc.closeStdin();
        assertTrue(proc.wait(30s), "the adapter ends");
        return dap;
    }

    logTest() {
        TmpDir tmp("qore-vda-test-");
        string path = writeProgram(tmp);

        # with a log file, the log is written to the file only
        string log = tmp.path + "/adapter.log";
        DapClient dap = runLogged(path, ("-v", "-l", log));
        assertRegex("receiveVsc: .*\"launch\"", ReadOnlyFile::readTextFile(log));
        assertEq((), select dap.getOutput("console"), $1 =~ /receiveVsc:/);

        # without a log file, the log is written to the default file and shown in the debug console, each message
        # as one line
        dap = runLogged(path, ("-v",), {"HOME": tmp.path});
        assertRegex("receiveVsc: .*\"launch\"", ReadOnlyFile::readTextFile(tmp.path + "/.qoredebugadapter.log"));
        list<string> console = dap.getOutput("console");
        assertTrue((select console, $1 =~ /receiveVsc: .*"launch"/).size() > 0, sprintf("%y", console));
        assertEq((), select console, $1 =~ /\r/ || $1 =~ /\n\n$/ || $1 !~ /\n$/);
    }

    childProcessTest() {
        TmpDir tmp("qore-vda-test-");
        string pid_file = tmp.path + "/child.pid";
        # the child process keeps the adapter's stdout open after the program has ended
        string path = writeProgram(tmp, sprintf("%%modern\n"
            "system(\"sleep 1000 & echo $! > %s\");\n"
            "printf(\"parent done\\n\");\n", pid_file));
        Process proc = startAdapter();
        on_exit if (proc.running()) {
            proc.terminate();
        }
        on_exit {
            *string pid = is_file(pid_file) ? trim(ReadOnlyFile::readTextFile(pid_file)) : NOTHING;
            if (pid =~ /^[0-9]+$/) {
                system("kill " + pid);
            }
        }
        DapClient dap(proc);
        launch(dap, {"program": path, "stopOnEntry": False});
        hash<auto> r = dap.request("configurationDone");
        assertTrue(r.success, r.message);
        # the end of the program is reported after its output, while the child process still runs
        dap.waitForEvent("terminated");
        assertEq(("parent done\n",), dap.getOutput("stdout"));
        r = dap.request("disconnect");
        assertTrue(r.success, r.message);
        proc.closeStdin();
        assertTrue(proc.wait(30s), "the adapter ends");
        assertEq(0, proc.exitCode());
    }

    attachTest() {
        TmpDir tmp("qore-vda-test-");
        string path = writeProgram(tmp, AttachProgram);
        # the server logs to stderr
        Process server(qore_exe, (server_script, "-v", path), {
            "env": Process::getEnvironment() + {
                "QORE_MODULE_DIR": qlib_dir + (ENV.QORE_MODULE_DIR ? ":" + ENV.QORE_MODULE_DIR : ""),
            },
        });
        on_exit if (server.running()) {
            server.terminate();
        }
        # the server writes its port when it listens
        string line = readServerOutput(server, "\n");
        int port = (line =~ x/listening on port ([0-9]+)/)[0].toInt();

        # the server holds the program at its start until a client attaches; the program runs when the client has set
        # its breakpoints
        attachSession(server, port, path, False);
        # the program runs when a client attaches; the runtime stops its thread at its next statement, and the thread
        # is held there until the client has set its breakpoints
        attachSession(server, port, path, True);

        # the server ends with the program
        server.write("end\n");
        assertTrue(server.wait(30s), "the debug server ends");
        assertEq(0, server.exitCode());
    }

    # the columns of a line of a source that the adapter cannot read are converted with the text that the debug
    # server gives
    remoteColumnTest() {
        TmpDir tmp("qore-vda-test-");
        writeProgram(tmp, ColumnProgram);
        # the server parses the program with a relative path in its directory, which is not the directory of the adapter
        assertFalse(is_file("target.q"));
        Process server(qore_exe, (server_script, "-v", "target.q"), {
            "cwd": tmp.path,
            "env": Process::getEnvironment() + {
                "QORE_MODULE_DIR": qlib_dir + (ENV.QORE_MODULE_DIR ? ":" + ENV.QORE_MODULE_DIR : ""),
            },
        });
        on_exit if (server.running()) {
            server.terminate();
        }
        string line = readServerOutput(server, "\n");
        int port = (line =~ x/listening on port ([0-9]+)/)[0].toInt();

        Process proc = startAdapter(("-a", sprintf("ws://localhost:%d", port)));
        on_exit if (proc.running()) {
            proc.terminate();
        }
        DapClient dap(proc);
        hash<auto> r = dap.request("initialize", {"adapterID": "qore", "linesStartAt1": True,
            "columnsStartAt1": True, "pathFormat": "path"});
        assertTrue(r.success, r.message);
        r = dap.request("attach", {"program": "target.q"});
        assertTrue(r.success, r.message);
        dap.waitForEvent("initialized");

        # the statements of line 3 after the string of characters of more than one byte: with the text of the line,
        # the columns count UTF-16 code units, otherwise they would count bytes (22 and 41)
        r = dap.request("breakpointLocations", {"source": {"path": "target.q"}, "line": 3});
        assertTrue(r.success, r.message);
        assertEq((1, 19, 38), (map $1.column, r.body.breakpoints));
        r = dap.request("setBreakpoints", {"source": {"path": "target.q"}, "breakpoints": (
            {"line": 3, "column": 38},
        )});
        assertTrue(r.success, r.message);
        assertEq((True, 3, 38), (r.body.breakpoints[0].verified, r.body.breakpoints[0].line,
            r.body.breakpoints[0].column));
        r = dap.request("configurationDone");
        assertTrue(r.success, r.message);

        # the thread stops at the third statement, which the stack frame gives with its columns
        hash<auto> stopped = dap.waitForEvent("stopped");
        assertEq("breakpoint", stopped.body.reason);
        int tid = stopped.body.threadId;
        hash<auto> frame = topFrame(dap, tid);
        assertEq((3, 38), (frame.line, frame.column));
        assertEq("3", evaluate(dap, tid, "x").body.result);

        r = dap.request("continue", {"threadId": tid});
        assertTrue(r.success, r.message);
        dap.waitFor(bool sub (hash<auto> m) {
            return m.type == "event" && m.event == "output" && m.body.category == "stdout" && m.body.output == "3\n";
        }, "program output");
        r = dap.request("disconnect");
        assertTrue(r.success, r.message);
        proc.closeStdin();
        assertTrue(proc.wait(30s), "the adapter ends");
        server.write("end\n");
        assertTrue(server.wait(30s), "the debug server ends");
    }

    # the "code" exception filter stops threads at the exceptions with the codes of its condition
    exceptionCodeTest() {
        TmpDir tmp("qore-vda-test-");
        string path = writeProgram(tmp, UncaughtProgram);
        Process proc = startAdapter();
        on_exit if (proc.running()) {
            proc.terminate();
        }
        DapClient dap(proc);
        launch(dap, {"program": path});
        assertTrue(capabilities.supportsExceptionFilterOptions);
        hash<auto> r = dap.request("setExceptionBreakpoints", {"filters": (), "filterOptions": (
            {"filterId": "code", "condition": "CAUGHT-2, NO-SUCH-ERROR"},
        )});
        assertTrue(r.success, r.message);
        r = dap.request("configurationDone");
        assertTrue(r.success, r.message);
        # the thread stops at CAUGHT-2 in each frame that it leaves, and at no other exception
        list<string> stops = ();
        while (True) {
            hash<auto> m = dap.waitFor(bool sub (hash<auto> m) {
                return m.type == "event" && (m.event == "stopped" || m.event == "terminated");
            }, "stopped or terminated event");
            if (m.event == "terminated") {
                break;
            }
            push stops, m.body.text;
            r = dap.request("continue", {"threadId": m.body.threadId});
            assertTrue(r.success, r.message);
        }
        assertTrue(stops.size() > 0);
        assertEq(("CAUGHT-2",), keys (map {$1: True}, stops));
        r = dap.request("disconnect");
        assertTrue(r.success, r.message);
        proc.closeStdin();
        assertTrue(proc.wait(30s), "the adapter ends");
    }

    # a debug server with a token accepts only the clients that give it
    tokenTest() {
        TmpDir tmp("qore-vda-test-");
        writeProgram(tmp, ColumnProgram);
        File f();
        f.open2(tmp.path + "/token", O_CREAT | O_WRONLY | O_TRUNC);
        f.write("s3cret\n");
        f.close();
        Process server(qore_exe, (server_script, "-k", "token", "target.q"), {
            "cwd": tmp.path,
            "env": Process::getEnvironment() + {
                "QORE_MODULE_DIR": qlib_dir + (ENV.QORE_MODULE_DIR ? ":" + ENV.QORE_MODULE_DIR : ""),
            },
        });
        on_exit if (server.running()) {
            server.terminate();
        }
        string line = readServerOutput(server, "\n");
        int port = (line =~ x/listening on port ([0-9]+)/)[0].toInt();
        string url = sprintf("ws://localhost:%d", port);

        # negative: no token and a wrong token
        list<list<string>> refused = (("-a", url), ("-a", url, "-H", "Authorization=Bearer wrong"));
        foreach list<string> args in (refused) {
            Process proc = startAdapter(args);
            on_exit if (proc.running()) {
                proc.terminate();
            }
            DapClient dap(proc);
            hash<auto> r = dap.request("initialize", {"adapterID": "qore", "linesStartAt1": True,
                "columnsStartAt1": True, "pathFormat": "path"});
            assertFalse(r.success, sprintf("%y", args));
            assertRegex("401", r.message);
            proc.closeStdin();
            assertTrue(proc.wait(30s), "the adapter ends");
        }

        # the token
        Process proc = startAdapter(("-a", url, "-H", "Authorization=Bearer s3cret"));
        on_exit if (proc.running()) {
            proc.terminate();
        }
        DapClient dap(proc);
        hash<auto> r = dap.request("initialize", {"adapterID": "qore", "linesStartAt1": True,
            "columnsStartAt1": True, "pathFormat": "path"});
        assertTrue(r.success, r.message);
        r = dap.request("attach", {"program": "target.q"});
        assertTrue(r.success, r.message);
        dap.waitForEvent("initialized");
        r = dap.request("configurationDone");
        assertTrue(r.success, r.message);
        dap.waitFor(bool sub (hash<auto> m) {
            return m.type == "event" && m.event == "output" && m.body.category == "stdout" && m.body.output == "3\n";
        }, "program output");
        r = dap.request("disconnect");
        assertTrue(r.success, r.message);
        proc.closeStdin();
        assertTrue(proc.wait(30s), "the adapter ends");
        server.write("end\n");
        assertTrue(server.wait(30s), "the debug server ends");
    }

    # the IDE is told why the debug server cannot be reached
    noServerTest() {
        # a port that is bound but does not accept connections
        Socket sock();
        sock.bind("localhost:0");
        int port = sock.getSocketInfo().port;

        Process proc = startAdapter(("-a", sprintf("ws://localhost:%d", port)));
        on_exit if (proc.running()) {
            proc.terminate();
        }
        DapClient dap(proc);
        hash<auto> r = dap.request("initialize", {"adapterID": "qore", "linesStartAt1": True,
            "columnsStartAt1": True, "pathFormat": "path"});
        assertFalse(r.success);
        assertRegex(sprintf("^DEBUG-CONNECT-ERROR: cannot connect to the debug server at ws://localhost:%d: ", port),
            r.message);
        # the error of the connection is given: Linux refuses a connection to a port that is bound but does not
        # listen, while on macOS the connection times out, or, when many processes connect at the same time, the
        # connection is accepted by the system and then reset as the adapter writes its request, which is reported as
        # a broken pipe: in each case the connection fails
        assertRegex("(SOCKET-CONNECT-ERROR: error in connect\\(\\) \\(target: localhost:[0-9]+\\): "
            + "(Connection refused|Operation timed out)|Broken pipe)", r.message);
        proc.closeStdin();
        assertTrue(proc.wait(30s), "the adapter ends");
        assertEq(0, proc.exitCode());
        assertEq((), dap.stray);
    }

    # the session ends with a message when the debug server ends
    serverClosedTest() {
        TmpDir tmp("qore-vda-test-");
        string path = writeProgram(tmp, AttachProgram);
        # the server logs to stderr
        Process server(qore_exe, (server_script, "-v", path), {
            "env": Process::getEnvironment() + {
                "QORE_MODULE_DIR": qlib_dir + (ENV.QORE_MODULE_DIR ? ":" + ENV.QORE_MODULE_DIR : ""),
            },
        });
        on_exit if (server.running()) {
            server.terminate();
        }
        string line = readServerOutput(server, "\n");
        int port = (line =~ x/listening on port ([0-9]+)/)[0].toInt();

        Process proc = startAdapter(("-a", sprintf("ws://localhost:%d", port)));
        on_exit if (proc.running()) {
            proc.terminate();
        }
        DapClient dap(proc);
        hash<auto> r = dap.request("initialize", {"adapterID": "qore", "linesStartAt1": True,
            "columnsStartAt1": True, "pathFormat": "path"});
        assertTrue(r.success, r.message);
        r = dap.request("attach", {"program": "target.q"});
        assertTrue(r.success, r.message);
        dap.waitForEvent("initialized");

        server.terminate();
        server.wait();
        dap.waitForEvent("terminated");
        assertEq((sprintf("the connection to the debug server at ws://localhost:%d was closed\n", port),),
            dap.getOutput("important"));
        proc.closeStdin();
        assertTrue(proc.wait(30s), "the adapter ends");
        assertEq(0, proc.exitCode());
    }

    #! Attaches to the program of the debug server, and stops at a breakpoint in a thread that the program starts
    /** @param running if the program is running when it is attached; its thread then gets the line of input that
        starts a thread in the configuration phase
    */
    private attachSession(Process server, int port, string path, bool running) {
        Process proc = startAdapter(("-a", sprintf("ws://localhost:%d", port)));
        on_exit if (proc.running()) {
            proc.terminate();
        }
        DapClient dap(proc);
        hash<auto> r = dap.request("initialize", {"adapterID": "qore", "linesStartAt1": True,
            "columnsStartAt1": True, "pathFormat": "path"});
        assertTrue(r.success, r.message);
        # the program is given by its script name
        r = dap.request("attach", {"program": "target.q"});
        assertTrue(r.success, r.message);
        # the client can set its breakpoints as soon as the program is debugged
        dap.waitForEvent("initialized");
        assertEq({"name": "target.q", "isLocalProcess": False, "startMethod": "attach"},
            dap.waitForEvent("process").body);

        int main_tid;
        if (running) {
            # the thread of the program stops at its next statement, and it is held until the configuration phase
            # has ended
            server.write("thread\n");
            main_tid = dap.waitForEvent("thread").body.threadId;
        } else {
            # the thread of the program that the server holds
            main_tid = dap.waitForEvent("thread").body.threadId;
        }
        r = dap.request("setBreakpoints", {"source": {"path": path}, "breakpoints": ({"line": 3},)});
        assertTrue(r.success, r.message);
        assertTrue(r.body.breakpoints[0].verified, sprintf("%y", r.body));
        r = dap.request("configurationDone");
        assertTrue(r.success, r.message);
        if (!running) {
            server.write("thread\n");
        }

        # the thread that the program starts stops at the breakpoint
        hash<auto> stopped = dap.waitForEvent("stopped");
        assertEq("breakpoint", stopped.body.reason);
        int tid = stopped.body.threadId;
        assertNeq(main_tid, tid);
        hash<auto> frame = topFrame(dap, tid);
        assertEq("work", frame.name);
        assertEq(3, frame.line);
        # the output that the thread wrote before it stopped has been sent before the stop
        assertEq(("work\n",), dap.getOutput("stdout"));
        r = dap.request("threads", NOTHING, False);
        assertTrue(r.success, r.message);
        assertEq(sprintf("Thread %d", tid), (select r.body.threads, $1.id == tid)[0].name);

        # the thread runs to its end
        r = dap.request("continue", {"threadId": tid});
        assertTrue(r.success, r.message);
        dap.waitFor(bool sub (hash<auto> m) {
            return m.type == "event" && m.event == "thread" && m.body.threadId == tid && m.body.reason == "exited";
        }, "thread exited event");
        # the output of the program is also written by the server
        assertEq("work\ndone\n", readServerOutput(server, "done\n"));
        # the output of the program is sent to the IDE
        dap.waitFor(bool sub (hash<auto> m) {
            return m.type == "event" && m.event == "output" && m.body.category == "stdout" && m.body.output == "done\n";
        }, "program output");
        # the log of the server is not sent as the output of the program
        assertEq((), (select dap.getOutput("stderr"), $1 =~ /\[INFO\]/));
        # no other thread was reported as stopped
        assertEq((), dap.getEvents("stopped"));
        # the events of the debug server are not written to the debug console
        assertEq((), (select dap.getOutput("console"), $1 =~ /(interrupt|run)\//));

        r = dap.request("disconnect");
        assertTrue(r.success, r.message);
        proc.closeStdin();
        assertTrue(proc.wait(30s), "the adapter ends");
        assertEq(0, proc.exitCode());
        assertEq((), dap.stray);
    }

    stopAllThreadsTest() {
        TmpDir tmp("qore-vda-test-");
        string path = writeProgram(tmp, StopAllProgram);

        Process proc = startAdapter();
        on_exit if (proc.running()) {
            proc.terminate();
        }
        DapClient dap(proc);
        # all threads stop together by default
        launch(dap, {"program": path, "stopOnEntry": False});
        hash<auto> r = dap.request("setBreakpoints", {"source": {"path": path}, "breakpoints": ({"line": 33},)});
        assertTrue(r.success, r.message);
        r = dap.request("configurationDone");
        assertTrue(r.success, r.message);

        hash<auto> stopped = dap.waitForEvent("stopped");
        assertEq("breakpoint", stopped.body.reason);
        int main_tid = stopped.body.threadId;
        assertEq(33, topFrame(dap, main_tid).line);

        # the thread that runs stops at its next statement; it is reported without taking the focus
        stopped = dap.waitForEvent("stopped");
        assertEq("pause", stopped.body.reason);
        assertTrue(stopped.body.preserveFocusHint);
        int busy_tid = stopped.body.threadId;
        assertNeq(main_tid, busy_tid);
        hash<auto> frame = topFrame(dap, busy_tid);
        assertEq("busy", frame.name);
        assertTrue(inlist(frame.line, (11, 12)), sprintf("%y", frame));

        # the threads have their current names, also the waiting thread, which has not stopped since it set its name
        r = dap.request("threads", NOTHING, False);
        assertTrue(r.success, r.message);
        hash<string, string> names = map {$1.id: $1.name}, r.body.threads;
        assertEq(3, names.size(), sprintf("%y", names));
        assertEq(sprintf("Main Thread (%d)", main_tid), names{main_tid});
        if (HAVE_THREAD_NAME) {
            assertEq(sprintf("busy (%d)", busy_tid), names{busy_tid});
            int waiter_tid = (select keys names, !inlist($1.toInt(), (main_tid, busy_tid)))[0].toInt();
            assertEq(sprintf("waiter (%d)", waiter_tid), names{waiter_tid});
        }

        # a step of the main thread stops it at its next statement, while the other threads stay stopped
        r = dap.request("next", {"threadId": main_tid});
        assertTrue(r.success, r.message);
        stopped = dap.waitForEvent("stopped");
        assertEq("step", stopped.body.reason);
        assertEq(main_tid, stopped.body.threadId);
        assertEq(34, topFrame(dap, main_tid).line);
        assertEq(frame.line, topFrame(dap, busy_tid).line);

        # all threads continue; the waiting thread, whose stop was requested, runs on when the main thread releases it
        r = dap.request("continue", {"threadId": main_tid});
        assertTrue(r.success, r.message);
        assertTrue(r.body.allThreadsContinued);
        dap.waitForEvent("terminated");
        assertEq(("done\n",), dap.getOutput("stdout"));
        assertEq((), dap.getEvents("stopped"));
        # both threads continued
        list<int> continued = map $1.body.threadId, dap.getEvents("continued");
        assertTrue(inlist(main_tid, continued), sprintf("%y", continued));
        assertTrue(inlist(busy_tid, continued), sprintf("%y", continued));

        r = dap.request("disconnect");
        assertTrue(r.success, r.message);
        proc.closeStdin();
        assertTrue(proc.wait(30s), "the adapter ends");
        assertEq(0, proc.exitCode());
        assertEq((), dap.stray);
    }

    stopOneThreadTest() {
        TmpDir tmp("qore-vda-test-");
        string path = writeProgram(tmp, StopAllProgram);

        Process proc = startAdapter();
        on_exit if (proc.running()) {
            proc.terminate();
        }
        DapClient dap(proc);
        launch(dap, {"program": path, "stopAllThreads": False});
        hash<auto> r = dap.request("setBreakpoints", {"source": {"path": path}, "breakpoints": ({"line": 33},)});
        assertTrue(r.success, r.message);
        r = dap.request("configurationDone");
        assertTrue(r.success, r.message);

        hash<auto> stopped = dap.waitForEvent("stopped");
        assertEq("breakpoint", stopped.body.reason);
        int main_tid = stopped.body.threadId;

        # only the main thread continues; the program ends only if the other threads were not stopped
        r = dap.request("continue", {"threadId": main_tid});
        assertTrue(r.success, r.message);
        assertFalse(r.body.allThreadsContinued);
        dap.waitForEvent("terminated");
        assertEq(("done\n",), dap.getOutput("stdout"));
        assertEq((), dap.getEvents("stopped"));

        r = dap.request("disconnect");
        assertTrue(r.success, r.message);
        proc.closeStdin();
        assertTrue(proc.wait(30s), "the adapter ends");
        assertEq(0, proc.exitCode());
        assertEq((), dap.stray);
    }

    outputOrderTest() {
        TmpDir tmp("qore-vda-test-");
        string path = writeProgram(tmp, "%modern\n"                    # 1
            "printf(\"before\\n\");\n"                                   # 2
            "stderr.print(\"err\\n\");\n"                                # 3
            "int x = 1;\n"                                                # 4
            "printf(\"after %d\\n\", x);\n");                            # 5
        Process proc = startAdapter();
        on_exit if (proc.running()) {
            proc.terminate();
        }
        DapClient dap(proc);
        launch(dap, {"program": path});
        hash<auto> r = dap.request("setBreakpoints", {"source": {"path": path}, "breakpoints": ({"line": 4},)});
        assertTrue(r.success, r.message);
        r = dap.request("configurationDone");
        assertTrue(r.success, r.message);
        hash<auto> stopped = dap.waitForEvent("stopped");
        assertEq("breakpoint", stopped.body.reason);
        # the output of both streams before the stop has been sent before the stop
        assertEq(("before\n",), dap.getOutput("stdout"));
        assertEq(("err\n",), dap.getOutput("stderr"));
        finish(dap, proc, stopped.body.threadId);
        assertEq(("before\n", "after 1\n"), dap.getOutput("stdout"));
    }

    # a file whose name does not end in .q is parsed in %modern mode without the directive, and a .q file in the
    # old-style mode, as the interpreter parses them
    sourceModeTest() {
        TmpDir tmp("qore-vda-test-");
        map runToOutput(writeProgram(tmp, $1.program, $1.name), $1.output), (
            {"name": "modern.qr", "program": "int x = 2;\nprintf(\"modern: %d\\n\", x);\n", "output": "modern: 2\n"},
            {"name": "modern", "program": "int x = 3;\nprintf(\"modern: %d\\n\", x);\n", "output": "modern: 3\n"},
            {"name": "old.q", "program": "my $x = 4;\nprintf(\"old: %d\\n\", $x);\n", "output": "old: 4\n"},
        );
    }

    #! Launches the program without breakpoints and checks its output
    private runToOutput(string path, string output) {
        Process proc = startAdapter();
        on_exit if (proc.running()) {
            proc.terminate();
        }
        DapClient dap(proc);
        launch(dap, {"program": path});
        hash<auto> r = dap.request("configurationDone");
        assertTrue(r.success, r.message);
        dap.waitForEvent("terminated");
        assertEq((output,), dap.getOutput("stdout"), path);
        r = dap.request("disconnect");
        assertTrue(r.success, r.message);
        proc.closeStdin();
        assertTrue(proc.wait(30s), "the adapter ends");
        assertEq(0, proc.exitCode());
    }

    #! Returns the output of the debug server up to the end of the given text
    private string readServerOutput(Process server, string end) {
        string out = "";
        while (out.find(end) < 0) {
            *string s = server.readStdout(1024, DapClient::MessageTimeout);
            if (!exists s) {
                throw "TEST-ERROR", sprintf("the debug server did not write %y: %y", end, out);
            }
            out += s;
        }
        return out;
    }

    endOfInputTest() {
        Process proc = startAdapter();
        on_exit if (proc.running()) {
            proc.terminate();
        }
        DapClient dap(proc);
        hash<auto> r = dap.request("initialize", {"adapterID": "qore"});
        assertTrue(r.success, r.message);

        # the adapter waits for requests; when the IDE closes its input, it ends instead of waiting for input
        # that cannot come
        proc.closeStdin();
        assertTrue(proc.wait(30s), "the adapter ends at the end of its input");
        assertEq(0, proc.exitCode());
    }
%endif
}
