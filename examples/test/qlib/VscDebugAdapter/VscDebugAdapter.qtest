%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires json
%requires FsUtil
%requires Util
%requires VscDebugAdapter

%try-module process >= 2.2
%define NoProcess
%endtry

%exec-class VscDebugAdapterTest

#! A client of the Debug Adapter Protocol for an adapter process
class DapClient {
    public {
        #! bytes on stdout that are not part of a protocol message
        list<string> stray = ();

        #! the maximum time to wait for a message before the test fails
        const MessageTimeout = 30s;
    }

    private {
        Process proc;
        binary buf = binary();
        list<hash<auto>> backlog = ();
        int seq = 0;
    }

    constructor(Process proc) {
        self.proc = proc;
    }

    #! Sends a request and returns its response
    hash<auto> request(string command, *hash<auto> arguments, bool with_arguments = True) {
        hash<auto> msg = {"seq": ++seq, "type": "request", "command": command};
        if (with_arguments) {
            msg.arguments = arguments ?? {};
        }
        binary content = binary(make_json(msg));
        proc.write(sprintf("Content-Length: %d\r\n\r\n", content.size()));
        proc.write(content);
        int request_seq = seq;
        return waitFor(bool sub (hash<auto> m) {
            return m.type == "response" && m.request_seq == request_seq;
        }, command + " response");
    }

    #! Returns the next message that matches, including messages that were received before
    hash<auto> waitFor(code<bool(hash<auto>)> pred, string what) {
        for (int i = 0; i < backlog.size(); ++i) {
            if (pred(backlog[i])) {
                return (extract backlog, i, 1)[0];
            }
        }
        while (True) {
            *hash<auto> msg = readMessage();
            if (!msg) {
                throw "DAP-ERROR", sprintf("no %s from the adapter", what);
            }
            if (pred(msg)) {
                return msg;
            }
            push backlog, msg;
        }
    }

    #! Returns the next event with the given name
    hash<auto> waitForEvent(string event) {
        return waitFor(bool sub (hash<auto> m) {
            return m.type == "event" && m.event == event;
        }, event + " event");
    }

    #! Returns the events with the given name received so far and not yet taken by waitFor()
    list<hash<auto>> getEvents(string event) {
        return select backlog, $1.type == "event" && $1.event == event;
    }

    #! Returns the output events received so far for the given category
    list<string> getOutput(string category) {
        return map $1.body.output, backlog, $1.event == "output" && $1.body.category == category;
    }

    #! Reads the next message; returns NOTHING if the adapter does not send one in time
    private *hash<auto> readMessage() {
        while (True) {
            int end = buf.find(<0d0a0d0a>);
            if (end >= 0) {
                int len = -1;
                foreach string line in (buf.substr(0, end).toString("UTF-8").split("\r\n")) {
                    *list<string> m = (line =~ x/^Content-Length: *([0-9]+)$/);
                    if (m) {
                        len = int(m[0]);
                    } else {
                        stray += line;
                    }
                }
                if (len < 0) {
                    splice buf, 0, end + 4;
                    continue;
                }
                while (buf.size() < end + 4 + len) {
                    if (!fill()) {
                        return NOTHING;
                    }
                }
                hash<auto> msg = parse_json(buf.substr(end + 4, len).toString("UTF-8"));
                splice buf, 0, end + 4 + len;
                return msg;
            }
            if (!fill()) {
                return NOTHING;
            }
        }
    }

    #! Reads more output of the adapter; returns False only when the adapter's stdout is at end of file
    /** readStdoutBinary() returns nothing both at end of file and when nothing arrives within the timeout.  The
        latter is not the end of the stream: under load the adapter can be starved and produce no output for a
        while, which must not be mistaken for a missing message.  Wait on the real signal - data, or the adapter
        actually exiting - by reading again while the adapter is still running; give up only once it has exited
        (then readStdoutBinary() returns nothing at once, so this does not spin).
    */
    private bool fill() {
        while (True) {
            *binary data = proc.readStdoutBinary(65536, MessageTimeout);
            if (data) {
                buf += data;
                return True;
            }
            if (!proc.running()) {
                return False;
            }
        }
    }
}

public class VscDebugAdapterTest inherits QUnit::Test {
    private {
        #! the program that is debugged; the comments are the line numbers
        const Program = "%modern\n"                                         # 1
            "int sub add(int a, int b) {\n"                                  # 2
            "    int sum = a + b;\n"                                         # 3
            "    return sum;\n"                                              # 4
            "}\n"                                                            # 5
            "hash<auto> h = {\"name\": \"invoice\", \"lines\": (1, 2, 3)};\n"  # 6
            "int total = add(2, 3);\n"                                       # 7
            "printf(\"total: %d %y\\n\", total, h);\n";                      # 8

        #! a program with a thread started with the background operator; the comments are the line numbers
        const ThreadProgram = "%modern\n"                                   # 1
            "int sub add(int a, int b) {\n"                                  # 2
            "    int sum = a + b;\n"                                         # 3
            "    return sum;\n"                                              # 4
            "}\n"                                                            # 5
            "sub work() {\n"                                                 # 6
            "    int t = add(10, 20);\n"                                     # 7
            "}\n"                                                            # 8
            "Counter c(1);\n"                                                # 9
            "background sub () { on_exit c.dec(); set_thread_name(\"worker\"); work(); }();\n" # 10
            "c.waitForZero();\n"                                             # 11
            "printf(\"done\\n\");\n";                                         # 12

        #! a program of a debug server that starts a thread for each line of input; the comments are the line numbers
        const AttachProgram = "%modern\n"                                  # 1
            "sub work() {\n"                                                 # 2
            "    int t = 1;\n"                                               # 3
            "}\n"                                                            # 4
            "while (stdin.readLine(False) == \"thread\") {\n"                # 5
            "    Counter c(1);\n"                                            # 6
            "    background sub () { on_exit c.dec(); work(); }();\n"        # 7
            "    c.waitForZero();\n"                                         # 8
            "    printf(\"done\\n\");\n"                                     # 9
            "}\n";                                                           # 10

        #! a program with a thread that runs and one that waits when the main thread stops at line 33; the comments
        #! are the line numbers
        const StopAllProgram = "%modern\n"                                 # 1
            "our Counter stop(1);\n"                                         # 2
            "our Counter busy_running(1);\n"                                 # 3
            "our Mutex m();\n"                                               # 4
            "our Condition cond();\n"                                        # 5
            "our bool waiting = False;\n"                                    # 6
            "our bool release = False;\n"                                    # 7
            "sub busy() {\n"                                                 # 8
            "    set_thread_name(\"busy\"); busy_running.dec();\n"           # 9
            "    int i = 0;\n"                                               # 10
            "    while (stop.getCount()) {\n"                                # 11
            "        ++i;\n"                                                 # 12
            "    }\n"                                                        # 13
            "}\n"                                                            # 14
            "sub blocked() {\n"                                              # 15
            "    set_thread_name(\"waiter\"); m.lock();\n"                   # 16
            "    on_exit m.unlock();\n"                                      # 17
            "    waiting = True;\n"                                          # 18
            "    cond.broadcast();\n"                                        # 19
            "    while (!release) {\n"                                       # 20
            "        cond.wait(m);\n"                                        # 21
            "    }\n"                                                        # 22
            "}\n"                                                            # 23
            "Counter ended(2);\n"                                            # 24
            "background sub () { on_exit ended.dec(); busy(); }();\n"        # 25
            "background sub () { on_exit ended.dec(); blocked(); }();\n"     # 26
            "busy_running.waitForZero();\n"                                  # 27
            # the waiting thread releases the mutex only in Condition::wait()
            "m.lock();\n"                                                    # 28
            "while (!waiting) {\n"                                           # 29
            "    cond.wait(m);\n"                                            # 30
            "}\n"                                                            # 31
            "m.unlock();\n"                                                  # 32
            "int k = 1;\n"                                                   # 33
            "stop.dec();\n"                                                  # 34
            "m.lock();\n"                                                    # 35
            "release = True;\n"                                              # 36
            "cond.broadcast();\n"                                            # 37
            "m.unlock();\n"                                                  # 38
            "ended.waitForZero();\n"                                         # 39
            "printf(\"done\\n\");\n";                                         # 40

        #! a program that raises an exception and catches it; the comments are the line numbers
        const ExceptionProgram = "%modern\n"                                # 1
            "try {\n"                                                        # 2
            "    throw \"TEST-ERROR\", \"test\";\n"                          # 3
            "} catch (hash<ExceptionInfo> ex) {\n"                           # 4
            "    printf(\"caught %s\\n\", ex.err);\n"                         # 5
            "}\n";                                                           # 6

        #! a program that runs until its variable \c done is set; the comments are the line numbers
        const LoopProgram = "%modern\n"                                     # 1
            "bool done = False;\n"                                           # 2
            "printf(\"looping\\n\");\n"                                      # 3
            "while (!done) {\n"                                              # 4
            "    usleep(1ms);\n"                                             # 5
            "}\n"                                                            # 6
            "printf(\"done\\n\");\n";                                         # 7

        #! a program with structured values and a loop; the comments are the line numbers
        const DataProgram = "%modern\n"                                     # 1
            "class Base {\n"                                                 # 2
            "    private { int id = 7; }\n"                                  # 3
            "}\n"                                                            # 4
            "class Account inherits Base {\n"                                # 5
            "    private { int balance = 100; hash<auto> meta = {\"owner\": \"ann\", \"tags\": (\"a\", \"b\")}; }\n" # 6
            "    public { string name = \"acct\"; }\n"                       # 7
            "    int getBalance() { return balance; }\n"                     # 8
            "}\n"                                                            # 9
            "int sub work(int n) {\n"                                        # 10
            "    int total = 0;\n"                                           # 11
            "    for (int i = 0; i < n; ++i) {\n"                            # 12
            "        total += i;\n"                                          # 13
            "    }\n"                                                        # 14
            "    return total;\n"                                            # 15
            "}\n"                                                            # 16
            "our Account acct = new Account();\n"                            # 17
            "our hash<auto> h = {\"name\": \"invoice\", \"lines\": (1, 2, 3), \"nested\": {\"k\": \"v\"}};\n" # 18
            "list<int> big = range(0, 250);\n"                               # 19
            "int r = work(5);\n"                                             # 20
            "printf(\"r: %d\\n\", r);\n";                                     # 21

        string qore_exe = executablePath(ENV.QORE_EXECUTABLE ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore");
        string adapter = normalize_dir(get_script_dir() + "/../../../../bin/qdbg-vsc-adapter");
        string qlib_dir = normalize_dir(get_script_dir() + "/../../../../qlib");
        string server_script = normalize_dir(get_script_dir() + "/../../../../bin/qdbg-server");
    }

    constructor() : Test("VscDebugAdapter", "1.0", \ARGV) {
        addTestCase("debug session over the Debug Adapter Protocol", \sessionTest());
        addTestCase("stopOnEntry false: the first stop is a breakpoint", \noStopOnEntryTest());
        addTestCase("stopOnEntry false: a breakpoint on the first statement stops", \firstStatementBreakpointTest());
        addTestCase("stopOnEntry not given: the program runs to its end", \defaultStopOnEntryTest());
        addTestCase("function breakpoints", \functionBreakpointTest());
        addTestCase("breakpoints that cannot be set", \unverifiedBreakpointTest());
        addTestCase("exception breakpoints", \exceptionTest());
        addTestCase("exceptions without an exception breakpoint", \exceptionNoFilterTest());
        addTestCase("threads started by the program", \threadTest());
        addTestCase("pausing a running program", \pauseTest());
        addTestCase("structured variables are shown as trees", \variablesTest());
        addTestCase("values of variables, elements and members are set", \setVariableTest());
        addTestCase("expressions are evaluated for watches, hovers and the debug console", \evaluateTest());
        addTestCase("conditional breakpoints", \conditionalBreakpointTest());
        addTestCase("hit conditions of breakpoints", \hitConditionTest());
        addTestCase("logpoints", \logpointTest());
        addTestCase("a breakpoint whose condition is false does not hide a step", \conditionalStepTest());
        addTestCase("the adapter communicates over sockets, as Visual Studio Code starts it", \socketTest());
        addTestCase("the adapter logs to its file and to the debug console", \logTest());
        addTestCase("the end of a program that started a process is reported", \childProcessTest());
        addTestCase("marks in the output of programs", \outputMarkTest());
        addTestCase("names of threads", \threadNameTest());
        addTestCase("all threads stop and continue together", \stopAllThreadsTest());
        addTestCase("sources are parsed in the mode that the interpreter gives their files", \sourceModeTest());
        addTestCase("stopAllThreads false: only the thread that stops is stopped", \stopOneThreadTest());
        addTestCase("attaching to a program of a debug server", \attachTest());
        addTestCase("the adapter ends when the IDE closes its input", \endOfInputTest());
        set_return_value(main());
    }

    #! Returns the absolute path of the given Qore executable
    /** A Process is started with an absolute path or with a name that is found in the search path, so a path
        relative to the working directory, as \c QORE_ARGV[0] is when the test is run with \c build/qore, is made
        absolute; whether the process module finds such a path depends on the version of Boost.Process
    */
    private static string executablePath(string name) {
        if (name.regex("/")) {
            return realpath(name);
        }
        foreach string dir in (split(":", ENV.PATH ?? "")) {
            string path = (dir ? dir : ".") + "/" + name;
            if (is_executable(path)) {
                return realpath(path);
            }
        }
        throw "TEST-SETUP-ERROR", sprintf("cannot locate Qore executable %y", name);
    }

