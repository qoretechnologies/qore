    # the output before a mark, or before an end of the output that can be the beginning of a mark, is queued
    outputMarkTest() {
        binary mark = binary("\0mark-123");
        assertEq(5, VscDebugAdapter::getOutputSize(binary("abcde\0mark-123Frest"), mark));
        assertEq(0, VscDebugAdapter::getOutputSize(binary("\0mark-123S"), mark));
        # an end that can be the beginning of a mark
        assertEq(3, VscDebugAdapter::getOutputSize(binary("abc\0mar"), mark));
        assertEq(3, VscDebugAdapter::getOutputSize(binary("abc\0"), mark));
        # no mark
        assertEq(5, VscDebugAdapter::getOutputSize(binary("abcde"), mark));
        assertEq(4, VscDebugAdapter::getOutputSize(binary("ab\0x"), mark));
        assertEq(0, VscDebugAdapter::getOutputSize(binary(), mark));
    }

    # the default names that Qore gives threads are not shown
    threadNameTest() {
        assertEq("worker (3)", VscDebugAdapter::getThreadDisplayName(3, "worker", False));
        assertEq("worker (3)", VscDebugAdapter::getThreadDisplayName(3, "worker", True));
        assertEq("Thread 3", VscDebugAdapter::getThreadDisplayName(3, "qore/3", False));
        assertEq("Thread 3", VscDebugAdapter::getThreadDisplayName(3, NOTHING, False));
        assertEq("Main Thread (1)", VscDebugAdapter::getThreadDisplayName(1, "qore", True));
        assertEq("Main Thread (5)", VscDebugAdapter::getThreadDisplayName(5, "qore/5", True));
        # names that only look like the default names
        assertEq("qore-x (4)", VscDebugAdapter::getThreadDisplayName(4, "qore-x", False));
        assertEq("qore/a (4)", VscDebugAdapter::getThreadDisplayName(4, "qore/a", False));
    }

%ifndef NoProcess
    #! Starts the adapter with the modules of this source tree
    private Process startAdapter(*list<string> args, *hash<auto> env) {
        *string module_dir = ENV.QORE_MODULE_DIR;
        return new Process(qore_exe, (adapter,) + (args ?? ()), {
            "env": Process::getEnvironment() + {
                "QORE_MODULE_DIR": qlib_dir + (module_dir ? ":" + module_dir : ""),
            } + env,
        });
    }

    sessionTest() {
        TmpDir tmp("qore-vda-test-");
        string path = tmp.path + "/target.q";
        {
            File f();
            f.open2(path, O_CREAT | O_WRONLY | O_TRUNC);
            f.write(Program);
        }

        Process proc = startAdapter();
        on_exit if (proc.running()) {
            proc.terminate();
        }
        DapClient dap(proc);

        hash<auto> r = dap.request("initialize", {"adapterID": "qore", "linesStartAt1": True,
            "columnsStartAt1": True, "pathFormat": "path"});
        assertTrue(r.success, r.message);
        assertTrue(r.body.supportsConfigurationDoneRequest);

        r = dap.request("launch", {"program": path, "stopOnEntry": True});
        assertTrue(r.success, r.message);
        dap.waitForEvent("initialized");

        # requests without arguments are accepted with empty arguments, as the protocol allows
        r = dap.request("configurationDone");
        assertTrue(r.success, r.message);

        hash<auto> stopped = dap.waitForEvent("stopped");
        assertEq("entry", stopped.body.reason);
        int tid = stopped.body.threadId;
        r = dap.request("threads", NOTHING, False);
        assertTrue(r.success, r.message);
        assertEq((tid,), (map $1.id, r.body.threads));

        # the call stack of the stopped thread
        r = dap.request("stackTrace", {"threadId": tid});
        assertTrue(r.success, r.message);
        list<hash<auto>> frames = r.body.stackFrames;
        assertTrue(frames.size() > 0);
        # the source of the frame is the file itself, where the IDE shows values in hovers
        assertEq({"name": "target.q", "path": path, "sourceReference": 0}, frames[0].source);
        assertEq(6, frames[0].line);

        # the variables of the frame
        r = dap.request("scopes", {"frameId": frames[0].id});
        assertTrue(r.success, r.message);
        hash<string, int> scopes = map {$1.name: $1.variablesReference}, r.body.scopes;
        assertTrue(scopes.hasKey("Locals"));
        assertTrue(scopes.hasKey("Globals"));
        r = dap.request("variables", {"variablesReference": scopes.Locals});
        assertTrue(r.success, r.message);
        list<string> locals = map $1.name, r.body.variables;
        assertTrue(locals.contains("h"), sprintf("%y", locals));
        assertTrue(locals.contains("total"), sprintf("%y", locals));

        # after a step, the value of the local variable is shown in a watch
        r = dap.request("next", {"threadId": tid});
        assertTrue(r.success, r.message);
        stopped = dap.waitForEvent("stopped");
        assertEq("step", stopped.body.reason);
        r = dap.request("stackTrace", {"threadId": tid});
        frames = r.body.stackFrames;
        r = dap.request("evaluate", {"expression": "h.name", "context": "watch", "frameId": frames[0].id});
        assertTrue(r.success, r.message);
        assertRegex("invoice", r.body.result);

        # the output of the program is sent as output events
        r = dap.request("continue", {"threadId": tid});
        assertTrue(r.success, r.message);
        dap.waitFor(bool sub (hash<auto> m) {
            return m.type == "event" && m.event == "output" && m.body.category == "stdout";
        }, "stdout output event");
        dap.waitForEvent("terminated");
        r = dap.request("disconnect");
        assertTrue(r.success, r.message);
        proc.closeStdin();
        assertTrue(proc.wait(30s), "the adapter ends");
        assertEq(0, proc.exitCode());

        # nothing but protocol messages is written to stdout
        assertEq((), dap.stray);
    }

    #! Writes the given test program to the given directory and returns its path
    private string writeProgram(TmpDir tmp, string program = Program, string name = "target.q") {
        string path = tmp.path + "/" + name;
        File f();
        f.open2(path, O_CREAT | O_WRONLY | O_TRUNC);
        f.write(program);
        return path;
    }

    #! Initializes the session and launches the program with the given launch arguments; returns the launch response
    private hash<auto> launch(DapClient dap, hash<auto> launch_args) {
        hash<auto> r = dap.request("initialize", {"adapterID": "qore", "linesStartAt1": True,
            "columnsStartAt1": True, "pathFormat": "path"});
        assertTrue(r.success, r.message);
        r = dap.request("launch", launch_args);
        assertTrue(r.success, r.message);
        dap.waitForEvent("initialized");
        return r;
    }

    #! Returns the top frame of the given thread
    private hash<auto> topFrame(DapClient dap, int tid) {
        hash<auto> r = dap.request("stackTrace", {"threadId": tid});
        assertTrue(r.success, r.message);
        return r.body.stackFrames[0];
    }

    #! Continues the program to its end and ends the adapter
    private finish(DapClient dap, Process proc, int tid) {
        hash<auto> r = dap.request("continue", {"threadId": tid});
        assertTrue(r.success, r.message);
        dap.waitForEvent("terminated");
        r = dap.request("disconnect");
        assertTrue(r.success, r.message);
        proc.closeStdin();
        assertTrue(proc.wait(30s), "the adapter ends");
        assertEq(0, proc.exitCode());
        assertEq((), dap.stray);
    }

    noStopOnEntryTest() {
        TmpDir tmp("qore-vda-test-");
        string path = writeProgram(tmp);

        Process proc = startAdapter();
        on_exit if (proc.running()) {
            proc.terminate();
        }
        DapClient dap(proc);
        launch(dap, {"program": path, "stopOnEntry": False});

        # a breakpoint in add(), set before the program runs
        hash<auto> r = dap.request("setBreakpoints", {"source": {"path": path}, "breakpoints": ({"line": 3},)});
        assertTrue(r.success, r.message);
        assertEq(1, r.body.breakpoints.size());
        assertTrue(r.body.breakpoints[0].verified, sprintf("%y", r.body.breakpoints));
        int bkpt_id = r.body.breakpoints[0].id;

        r = dap.request("configurationDone");
        assertTrue(r.success, r.message);

        # the first stop is the breakpoint, not the first statement of the program
        hash<auto> stopped = dap.waitForEvent("stopped");
        # a breakpoint stop gives the breakpoints that are hit
        assertEq("breakpoint", stopped.body.reason);
        assertEq((bkpt_id,), stopped.body.hitBreakpointIds);
        int tid = stopped.body.threadId;
        hash<auto> frame = topFrame(dap, tid);
        assertEq(path, frame.source.path);
        assertEq(3, frame.line);
        # each frame is named after the function its line is in: the stop is in add(), which is called by the
        # top-level code at line 7
        r = dap.request("stackTrace", {"threadId": tid});
        assertTrue(r.success, r.message);
        assertEq((("add", 3), ("<top level>", 7)), (map ($1.name, $1.line), r.body.stackFrames));
        assertEq(2, r.body.totalFrames);

        # the arguments of add()
        r = dap.request("scopes", {"frameId": frame.id});
        assertTrue(r.success, r.message);
        int locals_ref = (select r.body.scopes, $1.name == "Locals")[0].variablesReference;
        r = dap.request("variables", {"variablesReference": locals_ref});
        assertTrue(r.success, r.message);
        hash<string, string> locals = map {$1.name: $1.value}, r.body.variables;
        assertEq("2", locals.a, sprintf("%y", locals));
        assertEq("3", locals.b, sprintf("%y", locals));

        finish(dap, proc, tid);
        # there was no other stop
        assertEq((), dap.getEvents("stopped"));
    }

    firstStatementBreakpointTest() {
        TmpDir tmp("qore-vda-test-");
        string path = writeProgram(tmp);

        Process proc = startAdapter();
        on_exit if (proc.running()) {
            proc.terminate();
        }
