%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires DataProvider
%requires RestClient
%requires ApolloDataProvider
%requires BigCommerceDataProvider
%requires BitlyDataProvider
%requires CircleDataProvider
%requires ClickFunnelsRestClient
%requires ClickFunnelsDataProvider
%requires CloseDataProvider
%requires EasyPostDataProvider
%requires FreshsalesDataProvider
%requires GoHighLevelDataProvider
%requires GorgiasDataProvider

%exec-class SaasDataProviderPagingNarrowedCallerHashTest

#! Returns its argument with its runtime type, so a literal reaches the call as a caller's literal does
hash<auto> sub mk(hash<auto> h) {
    return h;
}

const TestInfo = <DataProviderInfo>{
    "name": "test",
    "type": "test",
};

#! Bitly provider that answers GET requests locally: one page with a cursor, then a last page
class TestBitly inherits BitlyDataProvider::BitlyDataProviderBase {
    public {
        list<auto> calls = ();
    }

    constructor() {
    }

    hash<auto> doGet(string path, *hash<auto> params) {
        push calls, params;
        return calls.size() == 1
            ? {"links": ({"id": "a"},), "pagination": {"search_after": "c1"}}
            : {"links": ({"id": "b"},)};
    }

    string getName() {
        return "test";
    }

    private hash<DataProvider::DataProviderInfo> getStaticInfoImpl() {
        return TestInfo;
    }
}

#! Close provider that answers GET requests locally: one page with more to come, then a last page
class TestClose inherits CloseDataProvider::CloseDataProviderBase {
    public {
        list<auto> calls = ();
    }

    constructor() {
    }

    hash<auto> doGet(string path, *hash<auto> params) {
        push calls, params;
        return calls.size() == 1
            ? {"data": ({"id": "a"},), "has_more": True}
            : {"data": ({"id": "b"},), "has_more": False};
    }

    string getName() {
        return "test";
    }

    private hash<DataProvider::DataProviderInfo> getStaticInfoImpl() {
        return TestInfo;
    }
}

