#! EasyPost provider that answers GET requests locally: one page with more to come, then a last page
class TestEasyPost inherits EasyPostDataProvider::EasyPostDataProviderBase {
    public {
        list<auto> calls = ();
    }

    constructor() {
    }

    auto doGet(string path, *hash<auto> params) {
        push calls, params;
        return calls.size() == 1
            ? {"items": ({"id": "a1"},), "has_more": True}
            : {"items": ({"id": "b1"},), "has_more": False};
    }

    string getName() {
        return "test";
    }

    private hash<DataProvider::DataProviderInfo> getStaticInfoImpl() {
        return TestInfo;
    }
