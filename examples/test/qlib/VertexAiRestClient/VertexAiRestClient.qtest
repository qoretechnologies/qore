%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/Mime.qm
%requires ../../../../qlib/HttpServerUtil.qm
%requires ../../../../qlib/HttpServer.qm
%requires ../../../../qlib/HttpServerAsyncIo
%requires ../../../../qlib/QoreLlmTypes.qm
%requires ../../../../qlib/QoreRagTypes.qm
%requires ../../../../qlib/QoreLlmUtils
%requires ../../../../qlib/GcpAuth.qm
%requires ../../../../qlib/GeminiBodyShape.qm
%requires ../../../../qlib/GeminiRestClient.qm
%requires ../../../../qlib/VertexAiRestClient.qm

%requires json

%exec-class VertexAiTest

# A combined fake server that handles:
# - GCP token endpoint (/token)
# - Vertex AI :generateContent
# - Vertex AI :streamGenerateContent (SSE)
# - Vertex AI :predict (for embedder)
class FakeVertexHandler inherits AbstractHttpRequestHandler {
    private {
        Mutex retry_mutex();
        int failures = 0;
        int predict_attempts = 0;
    }
    failNextPrediction() {
        AutoLock al(retry_mutex);
        failures = 1;
        predict_attempts = 0;
    }
    int getPredictAttempts() {
        AutoLock al(retry_mutex);
        return predict_attempts;
    }
    public {
        string last_path = "";
        string last_method = "";
        *hash<auto> last_body;
        #! cachedContents requests in the order received: method, path and body
        list<hash<auto>> cache_requests = ();
        string last_authorization = "";
        hash<auto> generate_response = {
            "candidates": (
                {
                    "content": {
                        "parts": ({"text": "Hello from Vertex"},),
                        "role": "model",
                    },
                    "finishReason": "STOP",
                },
            ),
            "usageMetadata": {
                "promptTokenCount": 8,
                "candidatesTokenCount": 4,
                "totalTokenCount": 12,
            },
            "model": "gemini-2.0-flash",
            "responseId": "vertex-test-id",
        };
        hash<auto> predict_response = {
            "predictions": (
                {"embeddings": {"values": (0.5, 0.4, 0.3, 0.2, 0.1)}},
            ),
        };
        hash<auto> token_response = {
            "access_token": "fake-vertex-token",
            "expires_in": 3600,
            "token_type": "Bearer",
        };
        #! Response chunks returned by :streamGenerateContent
        list<hash<auto>> stream_chunks = ();
        #! When set, :streamGenerateContent fails with this status and stream_error_body
        *int stream_error_code;
        string stream_error_body = "";
    }

    hash handleRequest(hash cx, hash hdr, *data body) {
        last_path = cx.raw_path;
        last_method = hdr.method;
        last_authorization = hdr."authorization" ?? "";
        string body_str = body
            ? (body.typeCode() == NT_BINARY ? body.toString("UTF-8") : body)
            : "";
        try {
            last_body = parse_json(body_str);
        } catch () {
            last_body = NOTHING;
        }
        # Token endpoint (used by GcpAuth) — accept with or without trailing slash
        if (last_path =~ /\/token\/?$/) {
            return makeResponse({"Content-Type": MimeTypeJson}, 200,
                make_json(token_response));
        }
        if (last_path =~ /\/cachedContents/) {
            push cache_requests, {"method": last_method, "path": last_path, "body": last_body};
            string name = "projects/fake-project/locations/us-central1/cachedContents/cache-1";
            if (last_method == "DELETE") {
                return makeResponse({"Content-Type": MimeTypeJson}, 200, "{}");
            }
            return makeResponse({"Content-Type": MimeTypeJson}, 200, make_json({
                "name": name,
                "model": last_body.model
                    ?? "projects/fake-project/locations/us-central1/publishers/google/models/gemini-2.0-flash",
                "expireTime": "2026-10-05T12:00:00Z",
                "usageMetadata": {"totalTokenCount": 4096},
            } + (last_body.displayName ? {"displayName": last_body.displayName} : {})));
        }
        if (last_path =~ /:streamGenerateContent\?alt=sse$/) {
            if (stream_error_code) {
                return makeResponse({"Content-Type": MimeTypeJson}, stream_error_code,
                    stream_error_body);
            }
            # Vertex AI frames SSE events with CRLF and sends no end marker
            string out = (map "data: " + make_json($1) + "\r\n\r\n", stream_chunks).join("");
            return makeResponse({"Content-Type": "text/event-stream"}, 200, out);
        }
        if (last_path =~ /:generateContent$/) {
            return makeResponse({"Content-Type": MimeTypeJson}, 200,
                make_json(generate_response));
        }
        if (last_path =~ /:predict$/) {
            AutoLock al(retry_mutex);
            ++predict_attempts;
            if (failures) {
                --failures;
                return makeResponse({"Content-Type": MimeTypeJson}, 503, make_json({"message": "busy"}));
            }
            return makeResponse({"Content-Type": MimeTypeJson}, 200,
                make_json(predict_response));
        }
        return makeResponse(404, "unknown vertex path: " + last_path);
    }
}

public class VertexAiTest inherits QUnit::Test {
    private {
        HttpServer fake_http;
        int fake_port;
        FakeVertexHandler handler;
        string sa_path;
    }

    constructor() : Test("VertexAi Test", "1.0") {
        addTestCase("factory + getInfo",                  \factoryTest());
        addTestCase("registry Gemini shaping metadata",  \registryShapingMetadataTest());
        addTestCase("Gemini-on-Vertex chat round-trip",   \chatTest());
        addTestCase("OpenAI tool_choice maps to toolConfig", \toolChoiceConversionTest());
        addTestCase("complete() helper",                  \completeTest());
        addTestCase("chatStream streams streamGenerateContent events", \chatStreamTest());
        addTestCase("streamed tool call is collected once", \streamToolCallTest());
        addTestCase("streaming error response raises", \streamErrorTest());
        addTestCase("live Vertex AI streaming (VERTEX_SA_JSON)", \liveStreamTest());
        addTestCase("URL path includes project/region/model", \pathTest());
        addTestCase("API URL follows location kind",        \apiUrlTest());
        addTestCase("missing project_id throws",          \missingProjectTest());
        addTestCase("embedder factory + round-trip",      \embedderTest());
        addTestCase("VertexAiRestConnection constructs",  \connectionTest());
        addTestCase("chat body with and without cached content", \cachedContentBodyShapeTest());
        addTestCase("cachedContents create/get/refresh/delete requests", \cacheResourceTest());
        addTestCase("chat with cached content omits cached parts", \cachedChatTest());
        addTestCase("Gemini usage normalization", \usageNormalizationTest());
        addTestCase("streamed usage counts thinking tokens once", \streamUsageTest());

        try {
            setupFakeServer();
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("setup error: %s\n", get_exception_string(ex));
            }
        }
        set_return_value(main());
    }

    static checkJson(Test test) {
    }

    private setupFakeServer() {
        Logger logger("test", LoggerLevel::getLevelInfo());
        fake_http = new HttpServer(<HttpServerOptionInfo>{"logger": logger});
        handler = new FakeVertexHandler();
        fake_http.setDefaultHandler("vertex", handler);
        fake_port = fake_http.addListener(<HttpListenerOptionInfo>{"service": 0}).port;

        # write a minimal service-account JSON file whose token_uri points
        # at our fake token endpoint so GcpAuth resolves via JWT-bearer
        sa_path = tmp_location() + "/vertex_sa_" + get_random_string(8) + ".json";
        File f();
        f.open2(sa_path, O_CREAT | O_WRONLY | O_TRUNC);
        f.write(make_json({
            "type": "service_account",
            "project_id": "fake-project",
            "private_key_id": "key-id",
            "private_key": TestPrivateKey,
            "client_email": "fake@fake-project.iam.gserviceaccount.com",
            "token_uri": "http://localhost:" + fake_port + "/token",
        }));
        f.close();
    }

    globalTearDown() {
        if (sa_path && is_file(sa_path)) {
            unlink(sa_path);
        }
        delete fake_http;
    }

    private factoryTest() {
        QoreLlmUtils::AbstractLlmProviderFactory f =
            QoreLlmUtils::LlmProviderRegistry::getFactoryEx("vertex-ai");
        assertEq("vertex-ai", f.getMode());
        hash<QoreLlmUtils::LlmProviderInfo> info = f.getInfo();
        assertEq("VertexAiRestClient", info.module_name);
        assertTrue(info.supports_tools);
        assertTrue(info.supports_structured_output);
        assertTrue(info.supports_multimodal);
        assertTrue(info.supports_reasoning_token_budget);
    }

    #! The Vertex and native Gemini providers share GeminiBodyShape, so registry
    #! consumers must receive identical Gemini-specific shaping preferences.
    private registryShapingMetadataTest() {
        QoreLlmUtils::AbstractLlmProviderFactory vertex_factory =
            QoreLlmUtils::LlmProviderRegistry::getFactoryEx("vertex-ai");
        QoreLlmUtils::AbstractLlmProviderFactory gemini_factory =
            QoreLlmUtils::LlmProviderRegistry::getFactoryEx("gemini");
        hash<QoreLlmUtils::LlmProviderInfo> vertex = vertex_factory.getInfo();
        hash<QoreLlmUtils::LlmProviderInfo> gemini = gemini_factory.getInfo();

        assertTrue(vertex.prefers_narrow_tool_catalogue,
            "Vertex advertises the Gemini narrow tool-catalogue preference");
        assertEq(8, vertex.preferred_max_tool_count,
            "Vertex advertises the Gemini conservative tool-count cap");
        assertTrue(vertex.prefers_single_tool_dispatch,
            "Vertex advertises the Gemini single-dispatch preference");
        assertTrue(vertex.prefers_stringified_tool_payloads,
            "Vertex advertises the Gemini stringified-payload preference");

        assertEq(gemini.prefers_narrow_tool_catalogue,
            vertex.prefers_narrow_tool_catalogue,
            "Vertex and Gemini narrow-catalogue metadata match");
        assertEq(gemini.preferred_max_tool_count,
            vertex.preferred_max_tool_count,
            "Vertex and Gemini tool-count metadata match");
        assertEq(gemini.prefers_single_tool_dispatch,
            vertex.prefers_single_tool_dispatch,
            "Vertex and Gemini dispatch metadata match");
        assertEq(gemini.prefers_stringified_tool_payloads,
            vertex.prefers_stringified_tool_payloads,
            "Vertex and Gemini payload metadata match");
    }

    #! Regression: the OpenAI-compatible adapter path must translate tool_choice
    #! into Vertex's toolConfig rather than leaking the raw OpenAI field (which
    #! Vertex rejects with HTTP 400 "Unknown name \"tool_choice\"")
    private toolChoiceConversionTest() {
        VertexAiTest::checkJson(self);
        if (!fake_http) {
            testSkip("no fake server");
        }
        GcpAuth::clearTokenCache();
        QoreLlmUtils::LlmBackend backend(
            <QoreLlmUtils::LlmBackendConfig>{
                "mode": "vertex-ai",
                "model": "gemini-2.0-flash",
                "url": "http://localhost:" + fake_port,
                "provider_options": {
                    "gcp_project_id": "fake-project",
                    "gcp_region": "us-central1",
                    "gcp_sa_json_path": sa_path,
                },
            });
        backend.chatCompletions({
            "messages": ({"role": "user", "content": "hi"},),
            "tools": ({
                "type": "function",
                "function": {
                    "name": "lookup",
                    "description": "look up a value",
                    "parameters": {
                        "type": "object",
                        "properties": {"k": {"type": "string"}},
                    },
                },
            },),
            "tool_choice": {"type": "function", "function": {"name": "lookup"}},
        });
        assertNothing(handler.last_body.tool_choice,
            "raw OpenAI tool_choice must not be sent to Vertex");
        assertEq("ANY",
            handler.last_body.toolConfig.functionCallingConfig.mode,
            "named tool_choice maps to Vertex toolConfig mode ANY");
        assertEq("lookup",
            handler.last_body.tools[0].functionDeclarations[0].name,
            "OpenAI tool is converted to a Vertex functionDeclaration");
    }

    private chatTest() {
        VertexAiTest::checkJson(self);
        if (!fake_http) {
            testSkip("no fake server");
        }
        # clear any cached GCP token from previous tests
        GcpAuth::clearTokenCache();

        VertexAiRestClient::VertexAiLlmProvider p = newProvider();
        hash<QoreLlmUtils::ChatResponse> r = p.chat((
            <QoreLlmUtils::ChatMessage>{"role": "user", "content": "hello"},
        ));
        assertEq("Hello from Vertex", r.content);
        assertEq("end_turn", r.stop_reason);
        assertEq(8,  r.usage.prompt_tokens);
        assertEq(4,  r.usage.completion_tokens);
        assertEq(12, r.usage.total_tokens);
        # request body shape: contents/parts/text
        assertEq("user", handler.last_body.contents[0].role);
        assertEq("hello", handler.last_body.contents[0].parts[0].text);
        # authorization header carries the fake bearer
        assertEq("Bearer fake-vertex-token", handler.last_authorization);
    }

    private completeTest() {
        VertexAiTest::checkJson(self);
        if (!fake_http) {
            testSkip("no fake server");
        }
        GcpAuth::clearTokenCache();
        VertexAiRestClient::VertexAiLlmProvider p = newProvider();
        hash<QoreLlmUtils::LlmCompletionResult> r =
            p.complete("You are a helper.", "Say hi.");
        assertEq("Hello from Vertex", r.content);
        # system prompt routed to Gemini systemInstruction.parts
        assertEq("You are a helper.",
            handler.last_body.systemInstruction.parts[0].text);
    }

    private chatStreamTest() {
        VertexAiTest::checkJson(self);
        if (!fake_http) {
            testSkip("no fake server");
        }
        GcpAuth::clearTokenCache();
        handler.stream_chunks = (
            {
                "candidates": ({"content": {"role": "model", "parts": ({"text": "Hello"},)}},),
                "responseId": "vertex-stream-id",
            },
            {
                "candidates": ({
                    "content": {"role": "model", "parts": ({"text": " from Vertex"},)},
                    "finishReason": "STOP",
                },),
                "usageMetadata": {"promptTokenCount": 8, "candidatesTokenCount": 4, "totalTokenCount": 12},
            },
        );
        on_exit handler.stream_chunks = ();
        VertexAiRestClient::VertexAiLlmProvider p = newProvider();
        list<hash<QoreLlmUtils::ChatStreamEvent>> events = ();
        p.chatStream((
            <QoreLlmUtils::ChatMessage>{"role": "user", "content": "stream"},
        ), sub (hash<QoreLlmUtils::ChatStreamEvent> e) {
            push events, e;
        });
        assertEq(2, events.size(), "each response chunk is one event");
        assertEq("Hello", events[0].delta);
        assertFalse(events[0].done);
        assertEq("vertex-stream-id", events[0].raw.responseId);
        assertEq(" from Vertex", events[1].delta, "the final chunk keeps its text");
        assertTrue(events[1].done);
        assertEq("STOP", events[1].raw.candidates[0].finishReason);
        assertEq("/v1/projects/fake-project/locations/us-central1/publishers/google/models/"
            "gemini-2.0-flash:streamGenerateContent?alt=sse", handler.last_path);
        assertEq("Bearer fake-vertex-token", handler.last_authorization);
        assertEq("stream", handler.last_body.contents[0].parts[0].text);

        # the OpenAI-compatible facade assembles the same response
        QoreLlmUtils::LlmBackend backend = newBackend();
        list<hash<auto>> chunks = ();
        hash<auto> resp = backend.chatCompletionsStream({
            "messages": ({"role": "user", "content": "stream"},),
        }, sub (hash<auto> chunk) {
            push chunks, chunk;
        });
        assertEq(2, chunks.size());
        assertEq("Hello from Vertex", resp.choices[0].message.content);
        assertEq("stop", resp.choices[0].finish_reason);
        assertEq(12, resp.usage.total_tokens);
    }

    private streamToolCallTest() {
        VertexAiTest::checkJson(self);
        if (!fake_http) {
            testSkip("no fake server");
        }
        GcpAuth::clearTokenCache();
        # one chunk carries text, a tool call, and the finish reason
        handler.stream_chunks = (
            {
                "candidates": ({
                    "content": {"role": "model", "parts": (
                        {"text": "Checking."},
                        {"functionCall": {"name": "lookup", "args": {"k": "v"}}, "thoughtSignature": "sig-v"},
                    )},
                    "finishReason": "STOP",
                },),
            },
        );
        on_exit handler.stream_chunks = ();
        list<hash<QoreLlmUtils::ToolDefinition>> tools = (
            <QoreLlmUtils::ToolDefinition>{
                "name": "lookup",
                "description": "look up a value",
                "parameters": {"type": "object", "properties": {"k": {"type": "string"}}},
            },
        );
        QoreLlmUtils::LlmBackend backend = newBackend();
        hash<QoreLlmUtils::ChatResponse> r = backend.chatStreamCollect((
            <QoreLlmUtils::ChatMessage>{"role": "user", "content": "look up v"},
        ), NOTHING, tools);
        assertEq("tool_use", r.stop_reason);
        assertEq("Checking.", r.content);
        assertEq(1, r.tool_calls.size(), "the tool call is collected exactly once");
        assertEq("lookup", r.tool_calls[0].name);
        assertEq({"k": "v"}, r.tool_calls[0].arguments);
        assertEq("sig-v", r.tool_calls[0].thought_signature);

        hash<auto> resp = backend.chatCompletionsStream({
            "messages": ({"role": "user", "content": "look up v"},),
            "tools": ({
                "type": "function",
                "function": {
                    "name": "lookup",
                    "parameters": {"type": "object", "properties": {"k": {"type": "string"}}},
                },
            },),
        }, sub (hash<auto> chunk) {});
        assertEq("tool_calls", resp.choices[0].finish_reason);
        assertEq("Checking.", resp.choices[0].message.content);
        assertEq(1, resp.choices[0].message.tool_calls.size());
        assertEq("{\"k\":\"v\"}", resp.choices[0].message.tool_calls[0]."function".arguments);
    }

    private streamErrorTest() {
        VertexAiTest::checkJson(self);
        if (!fake_http) {
            testSkip("no fake server");
        }
        GcpAuth::clearTokenCache();
        handler.stream_error_code = 403;
        handler.stream_error_body = make_json({"error": {
            "code": 403,
            "message": "Permission denied on resource project fake-project.",
            "status": "PERMISSION_DENIED",
        }});
        on_exit {
            remove handler.stream_error_code;
            handler.stream_error_body = "";
        }
        VertexAiRestClient::VertexAiLlmProvider p = newProvider();
        list<hash<QoreLlmUtils::ChatStreamEvent>> events = ();
        assertThrows("LLM-ERROR", "HTTP 403: Permission denied on resource project fake-project", \p.chatStream(), (
            (<QoreLlmUtils::ChatMessage>{"role": "user", "content": "stream"},),
            sub (hash<QoreLlmUtils::ChatStreamEvent> e) {
                push events, e;
            },
        ));
        assertEq((), events, "no event is delivered for a rejected request");
    }

    #! Streams from Vertex AI with the service-account key file named by VERTEX_SA_JSON
    /** Optional environment variables: VERTEX_PROJECT (default: the key's project), VERTEX_REGION (default
        us-central1), VERTEX_MODEL (default gemini-2.5-flash).
    */
    private liveStreamTest() {
        *string sa = ENV.VERTEX_SA_JSON;
        if (!sa.val()) {
            testSkip("set VERTEX_SA_JSON to a service-account key file to run the live Vertex AI streaming test");
        }
        hash<auto> sa_info = parse_json(ReadOnlyFile::readTextFile(sa));
        GcpAuth::clearTokenCache();
        QoreLlmUtils::LlmBackend backend(<QoreLlmUtils::LlmBackendConfig>{
            "mode": "vertex-ai",
            "model": ENV.VERTEX_MODEL ?? "gemini-2.5-flash",
            "provider_options": {
                "gcp_project_id": ENV.VERTEX_PROJECT ?? sa_info.project_id,
                "gcp_region": ENV.VERTEX_REGION ?? "us-central1",
                "gcp_sa_json_path": sa,
            },
        });

        # text arrives in several events
        list<hash<QoreLlmUtils::ChatStreamEvent>> events = ();
        hash<QoreLlmUtils::ChatResponse> r = backend.chatStreamCollect((
            <QoreLlmUtils::ChatMessage>{
                "role": "user",
                # a prompt whose answer is the model's own prose; reciting a known sequence or text can be
                # stopped by the recitation filter, which would end the response with "content_filter"
                "content": "Explain in about 200 words why the sky appears blue.",
            },
        ), sub (hash<QoreLlmUtils::ChatStreamEvent> e) {
            push events, e;
        });
        assertGt(1, events.size(), "the response is streamed in several events");
        assertTrue(events.last().done, "the last event ends the stream");
        int text_events = (select events, $1.delta.val()).size();
        assertGt(1, text_events, "several events carry text");
        assertEq("end_turn", r.stop_reason);
        assertRegex("(?i)scatter|blue", r.content);
        assertGt(0, r.usage.total_tokens, "usage is reported");

        # a tool call is streamed and replayed with its reasoning signature
        list<hash<QoreLlmUtils::ToolDefinition>> tools = (
            <QoreLlmUtils::ToolDefinition>{
                "name": "get_weather",
                "description": "Returns the current weather for a city",
                "parameters": {
                    "type": "object",
                    "properties": {"city": {"type": "string", "description": "the city name"}},
                    "required": ("city",),
                },
            },
        );
        list<hash<QoreLlmUtils::ChatMessage>> messages = (
            <QoreLlmUtils::ChatMessage>{
                "role": "user",
                "content": "What is the weather in Prague right now? Use the get_weather tool.",
            },
        );
        r = backend.chatStreamCollect(messages, NOTHING, tools);
        assertEq("tool_use", r.stop_reason);
        assertEq(1, r.tool_calls.size());
        assertEq("get_weather", r.tool_calls[0].name);
        assertRegex("(?i)prague|praha", r.tool_calls[0].arguments.city);
        messages += <QoreLlmUtils::ChatMessage>{
            "role": "assistant",
            "content": r.content,
            "tool_calls": r.tool_calls,
        };
        messages += <QoreLlmUtils::ChatMessage>{
            "role": "tool",
            "tool_call_id": r.tool_calls[0].id,
            "name": r.tool_calls[0].name,
            "content": make_json({"temperature_celsius": 17, "condition": "light rain"}),
        };
        r = backend.chatStreamCollect(messages, NOTHING, tools);
        assertEq("end_turn", r.stop_reason);
        assertRegex("17", r.content, "the tool result reaches the model");

        # a rejected request raises instead of ending as an empty response
        QoreLlmUtils::LlmBackend bad(<QoreLlmUtils::LlmBackendConfig>{
            "mode": "vertex-ai",
            "model": "qore-test-no-such-model",
            "provider_options": {
                "gcp_project_id": ENV.VERTEX_PROJECT ?? sa_info.project_id,
                "gcp_region": ENV.VERTEX_REGION ?? "us-central1",
                "gcp_sa_json_path": sa,
            },
        });
        assertThrows("LLM-ERROR", "HTTP 404", \bad.chatStream(), (
            (<QoreLlmUtils::ChatMessage>{"role": "user", "content": "hello"},),
            sub (hash<QoreLlmUtils::ChatStreamEvent> e) {},
        ));
    }

    private pathTest() {
        VertexAiTest::checkJson(self);
        VertexAiRestClient::VertexAiLlmProvider p = newProvider();
        string path = p.getVertexPath();
        assertEq("/v1/projects/fake-project/locations/us-central1/"
            "publishers/google/models/gemini-2.0-flash:generateContent", path);
    }

    private apiUrlTest() {
        assertEq("https://us-central1-aiplatform.googleapis.com",
            VertexAiRestClient::vertexApiUrl("us-central1"),
            "regional locations use the regional hostname");
        assertEq("https://europe-west4-aiplatform.googleapis.com",
            VertexAiRestClient::vertexApiUrl("europe-west4"),
            "European regional locations use the regional hostname");
        assertEq("https://aiplatform.googleapis.com",
            VertexAiRestClient::vertexApiUrl("us"),
            "US multi-region uses the general hostname with location in the path");
        assertEq("https://aiplatform.googleapis.com",
            VertexAiRestClient::vertexApiUrl("eu"),
            "EU multi-region uses the general hostname with location in the path");
        assertEq("https://aiplatform.googleapis.com",
            VertexAiRestClient::vertexApiUrl("global"),
            "global uses the unprefixed hostname");
        assertThrows("VERTEX-AI-CONFIG-ERROR",
            "Vertex AI location must not be empty",
            \VertexAiRestClient::vertexApiUrl(), ("",),
            "an empty location is rejected before an invalid hostname is built");
    }

    private missingProjectTest() {
        assertThrows("LLM-CONFIG-ERROR", sub () {
            new VertexAiRestClient::VertexAiLlmProvider(
                <QoreLlmUtils::LlmBackendConfig>{
                    "model": "gemini-2.0-flash",
                });
        });
    }

    private embedderTest() {
        VertexAiTest::checkJson(self);
        if (!fake_http) {
            testSkip("no fake server");
        }
        GcpAuth::clearTokenCache();
        QoreRagUtils::AbstractEmbedderFactory f =
            QoreRagUtils::RagProviderRegistry::getEmbedderFactoryEx("vertex-ai");
        assertEq("vertex-ai", f.getType());
        QoreRagUtils::AbstractEmbedder emb = f.create(<QoreRagUtils::EmbedderConfig>{
            "backend": "vertex-ai",
            "model": "text-embedding-005",
            "url": "http://localhost:" + fake_port,
            "options": {
                "gcp_project_id": "fake-project",
                "gcp_region": "us-central1",
                "gcp_sa_json_path": sa_path,
            },
        });
        handler.failNextPrediction();
        list<float> v = emb.encode("hello", {"retry_max_delay": 0});
        assertEq(2, handler.getPredictAttempts(), "Vertex prediction retries a transient response");
        assertEq((0.5, 0.4, 0.3, 0.2, 0.1), v);
        assertEq(5, emb.getDimension());
        # request body shape: instances[].content
        assertEq("hello", handler.last_body.instances[0].content);
    }

    private connectionTest() {
        VertexAiTest::checkJson(self);
        VertexAiRestClient::VertexAiRestConnection conn(
            "vertex-test", "test", "", NOTHING, {
                "gcp_project_id": "fake-project",
                "gcp_region": "us-central1",
            });
        assertEq("vertex-ai", conn.getType());
    }

    private QoreLlmUtils::LlmBackend newBackend() {
        return new QoreLlmUtils::LlmBackend(
            <QoreLlmUtils::LlmBackendConfig>{
                "mode": "vertex-ai",
                "model": "gemini-2.0-flash",
                "url": "http://localhost:" + fake_port,
                "provider_options": {
                    "gcp_project_id": "fake-project",
                    "gcp_region": "us-central1",
                    "gcp_sa_json_path": sa_path,
                },
            });
    }

    #! a request that uses cached content leaves out what the cache holds; without it the body is unchanged
    private cachedContentBodyShapeTest() {
        list<hash<QoreLlmUtils::ChatMessage>> messages = (
            <QoreLlmUtils::ChatMessage>{"role": "system", "content": "You review contracts."},
            <QoreLlmUtils::ChatMessage>{"role": "user", "content": "Find the termination clauses"},
        );
        list<hash<QoreLlmUtils::ToolDefinition>> tools = (
            <QoreLlmUtils::ToolDefinition>{"name": "lookup", "description": "look up a clause",
                "parameters": {"type": "object", "properties": {"k": {"type": "string"}}}},
        );
        hash<auto> resolved = {"max_output_tokens": 100, "temperature": 0.2};
        hash<auto> plain = GeminiBodyShape::shapeChatBody(messages, tools, NOTHING, resolved);
        assertEq("You review contracts.", plain.systemInstruction.parts[0].text);
        assertEq("lookup", plain.tools[0].functionDeclarations[0].name);
        assertFalse(plain.hasKey("cachedContent"));
        # a resolved hash without cached_content and one with an empty value give the same body
        assertEq(plain, GeminiBodyShape::shapeChatBody(messages, tools, NOTHING, resolved + {"cached_content": ""}));

        string cache = "projects/p/locations/us-central1/cachedContents/c1";
        hash<auto> cached = GeminiBodyShape::shapeChatBody(messages, tools, NOTHING, resolved + {
            "cached_content": cache,
            "extra_body": {"toolConfig": {"functionCallingConfig": {"mode": "ANY"}}},
        });
        assertEq(cache, cached.cachedContent);
        assertFalse(cached.hasKey("systemInstruction"), "the system instruction is in the cache");
        assertFalse(cached.hasKey("tools"), "the tools are in the cache");
        assertFalse(cached.hasKey("toolConfig"), "the tool configuration is in the cache");
        # everything else is unchanged
        assertEq(plain.contents, cached.contents);
        assertEq(plain.generationConfig, cached.generationConfig);
        assertEq(plain - ("systemInstruction", "tools") + {"cachedContent": cache}, cached);

        # the cache create body holds the parts that the requests leave out
        hash<auto> create = GeminiBodyShape::shapeCachedContentBody(
            "projects/p/locations/us-central1/publishers/google/models/gemini-2.5-flash", messages, tools,
            <GeminiBodyShape::GeminiCachedContentOptions>{
                "ttl_seconds": 600,
                "display_name": "contracts",
                "tool_config": {"functionCallingConfig": {"mode": "AUTO"}},
            });
        assertEq({
            "model": "projects/p/locations/us-central1/publishers/google/models/gemini-2.5-flash",
            "contents": plain.contents,
            "systemInstruction": plain.systemInstruction,
            "tools": plain.tools,
            "toolConfig": {"functionCallingConfig": {"mode": "AUTO"}},
            "displayName": "contracts",
            "ttl": "600s",
        }, create);
        assertEq({"expireTime": "2026-10-05T10:00:00.000000+00:00"},
            GeminiBodyShape::shapeCacheExpiration(NOTHING, 2026-10-05T12:00:00+02:00));
        assertEq({}, GeminiBodyShape::shapeCacheExpiration());
        assertThrows("GEMINI-CACHE-ERROR", \GeminiBodyShape::shapeCacheExpiration(), (60, now_us()));
        assertThrows("GEMINI-CACHE-ERROR", \GeminiBodyShape::shapeCacheExpiration(), (0,));
    }

    #! cache resources are created, read, refreshed and deleted with the Vertex AI cachedContents API
    private cacheResourceTest() {
        if (!fake_http) {
            testSkip("no fake server");
        }
        GcpAuth::clearTokenCache();
        handler.cache_requests = ();
        VertexAiRestClient::VertexAiLlmProvider p = newProvider();
        string base = "/v1/projects/fake-project/locations/us-central1/cachedContents";
        string full = "projects/fake-project/locations/us-central1/cachedContents/cache-1";
        assertEq(full, p.resolveCachedContentName("cache-1"));
        assertEq(full, p.resolveCachedContentName(full));
        assertThrows("VERTEX-AI-CACHE-ERROR", \p.resolveCachedContentName(), "cachedContents/cache-1");
        assertEq("projects/fake-project/locations/us-central1/publishers/google/models/gemini-2.0-flash",
            p.getModelResourceName());

        hash<auto> created = p.createCachedContent((
            <QoreLlmUtils::ChatMessage>{"role": "system", "content": "You review contracts."},
            <QoreLlmUtils::ChatMessage>{"role": "user", "content": "the contract"},
        ), NOTHING, <GeminiBodyShape::GeminiCachedContentOptions>{"ttl_seconds": 3600, "display_name": "c"});
        assertEq(full, created.name);
        assertEq({
            "method": "POST",
            "path": base,
            "body": {
                "model": "projects/fake-project/locations/us-central1/publishers/google/models/gemini-2.0-flash",
                "contents": ({"role": "user", "parts": ({"text": "the contract"},)},),
                "systemInstruction": {"parts": ({"text": "You review contracts."},)},
                "displayName": "c",
                "ttl": "3600s",
            },
        }, handler.cache_requests[0]);
        assertEq("Bearer fake-vertex-token", handler.last_authorization);

        assertEq(full, p.getCachedContent("cache-1").name);
        assertEq({"method": "GET", "path": base + "/cache-1"}, handler.cache_requests[1] - "body");

        p.refreshCachedContent(full, 7200);
        assertEq({"method": "PATCH", "path": base + "/cache-1?updateMask=ttl", "body": {"ttl": "7200s"}},
            handler.cache_requests[2]);
        p.refreshCachedContent("cache-1", NOTHING, 2026-10-06T00:00:00Z);
        assertEq({"method": "PATCH", "path": base + "/cache-1?updateMask=expireTime",
            "body": {"expireTime": "2026-10-06T00:00:00.000000+00:00"}}, handler.cache_requests[3]);
        assertThrows("GEMINI-CACHE-ERROR", \p.refreshCachedContent(), ("cache-1",));

        p.deleteCachedContent("cache-1");
        assertEq({"method": "DELETE", "path": base + "/cache-1"}, handler.cache_requests[4] - "body");
        assertEq(5, handler.cache_requests.size());
    }

    #! a chat that uses cached content references it and leaves out the cached parts, through the provider and
    #! the OpenAI-compatible facade
    private cachedChatTest() {
        if (!fake_http) {
            testSkip("no fake server");
        }
        GcpAuth::clearTokenCache();
        VertexAiRestClient::VertexAiLlmProvider p = newProvider();
        hash<QoreLlmUtils::ChatResponse> r = p.chat((
            <QoreLlmUtils::ChatMessage>{"role": "system", "content": "not sent"},
            <QoreLlmUtils::ChatMessage>{"role": "user", "content": "question"},
        ), (<QoreLlmUtils::ToolDefinition>{"name": "lookup", "parameters": {"type": "object"}},),
            <QoreLlmUtils::LlmRequestOptions>{"cached_content": "cache-1"});
        assertEq("projects/fake-project/locations/us-central1/cachedContents/cache-1",
            handler.last_body.cachedContent);
        assertFalse(handler.last_body.hasKey("systemInstruction"));
        assertFalse(handler.last_body.hasKey("tools"));
        assertEq(({"role": "user", "parts": ({"text": "question"},)},), handler.last_body.contents);
        # the response reports no cached tokens; the cache miss is explicit
        assertEq(0, r.usage.cached_content_token_count);
        assertEq(0, r.usage.prompt_tokens_details.cached_tokens);

        # the OpenAI-compatible facade takes the cache in cached_content, and a tool_choice translated to
        # toolConfig is left out
        QoreLlmUtils::LlmBackend backend = newBackend();
        backend.chatCompletions({
            "messages": ({"role": "system", "content": "not sent"}, {"role": "user", "content": "hi"}),
            "tools": ({"type": "function", "function": {"name": "lookup", "parameters": {"type": "object"}}},),
            "tool_choice": "required",
            "cached_content": "cache-1",
        });
        assertEq("projects/fake-project/locations/us-central1/cachedContents/cache-1",
            handler.last_body.cachedContent);
        assertFalse(handler.last_body.hasKey("systemInstruction"));
        assertFalse(handler.last_body.hasKey("tools"));
        assertFalse(handler.last_body.hasKey("toolConfig"));

        # a cachedContent given in body_options is used the same way
        p.chat((<QoreLlmUtils::ChatMessage>{"role": "system", "content": "not sent"},
            <QoreLlmUtils::ChatMessage>{"role": "user", "content": "question"}), NOTHING,
            <QoreLlmUtils::LlmRequestOptions>{"body_options": {"cachedContent": "cache-1",
                "toolConfig": {"functionCallingConfig": {"mode": "ANY"}}}});
        assertEq("projects/fake-project/locations/us-central1/cachedContents/cache-1",
            handler.last_body.cachedContent);
        assertFalse(handler.last_body.hasKey("systemInstruction"));
        assertFalse(handler.last_body.hasKey("tools"));
        assertFalse(handler.last_body.hasKey("toolConfig"));

        # without a cache the request is unchanged
        p.chat((<QoreLlmUtils::ChatMessage>{"role": "system", "content": "sent"},
            <QoreLlmUtils::ChatMessage>{"role": "user", "content": "question"}));
        assertFalse(handler.last_body.hasKey("cachedContent"));
        assertEq("sent", handler.last_body.systemInstruction.parts[0].text);
    }

    #! Gemini reports thinking tokens separately from the output tokens, and cached tokens as part of the prompt
    private usageNormalizationTest() {
        # thinking tokens are separate from the output; the flag says so
        hash<auto> usage = GeminiBodyShape::normalizeUsage({
            "promptTokenCount": 100,
            "candidatesTokenCount": 20,
            "thoughtsTokenCount": 30,
            "totalTokenCount": 150,
        });
        assertEq(20, usage.output_tokens);
        assertEq(30, usage.reasoning_tokens);
        assertFalse(usage.reasoning_in_output);
        assertEq(150, usage.total_tokens);
        assertFalse(usage.hasKey("cached_content_token_count"), "no cache: no cached count");
        hash<LlmTokenUsage> tokens = LlmTelemetry::normalizeUsage(usage);
        assertEq(20, tokens.output_tokens);
        assertEq(30, tokens.reasoning_tokens);
        assertFalse(tokens.reasoning_in_output, "the normalized usage keeps the flag");
        assertEq(150, tokens.total_tokens, "thinking tokens are counted once");
        # the raw usage gives the same result
        assertEq(tokens, LlmTelemetry::normalizeUsage({
            "promptTokenCount": 100,
            "candidatesTokenCount": 20,
            "thoughtsTokenCount": 30,
            "totalTokenCount": 150,
        }));
        # without a reported total, the derived total counts the thinking tokens once
        assertEq(150, GeminiBodyShape::normalizeUsage({
            "promptTokenCount": 100, "candidatesTokenCount": 20, "thoughtsTokenCount": 30}).total_tokens);
        assertEq(150, LlmTelemetry::normalizeUsage(GeminiBodyShape::normalizeUsage({
            "promptTokenCount": 100, "candidatesTokenCount": 20, "thoughtsTokenCount": 30})).total_tokens);
        # OpenAI reasoning tokens are part of the output count
        hash<LlmTokenUsage> openai = LlmTelemetry::normalizeUsage({
            "prompt_tokens": 100, "completion_tokens": 50,
            "completion_tokens_details": {"reasoning_tokens": 30},
        });
        assertTrue(openai.reasoning_in_output);
        assertEq(150, openai.total_tokens);
        # Gemini without thinking tokens still says that reasoning is not part of the output
        assertFalse(LlmTelemetry::normalizeUsage(GeminiBodyShape::normalizeUsage({
            "promptTokenCount": 10, "candidatesTokenCount": 5})).reasoning_in_output);

        # cached tokens: present, present as 0, absent with and without a cache request
        hash<auto> cached = GeminiBodyShape::normalizeUsage({
            "promptTokenCount": 100, "candidatesTokenCount": 20, "cachedContentTokenCount": 80});
        assertEq(80, cached.cached_content_token_count);
        assertEq(80, cached.cache_read_input_tokens);
        assertEq(80, cached.prompt_tokens_details.cached_tokens);
        assertEq(80, LlmTelemetry::normalizeUsage(cached).cached_input_tokens);
        hash<auto> zero = GeminiBodyShape::normalizeUsage({
            "promptTokenCount": 100, "candidatesTokenCount": 20, "cachedContentTokenCount": 0});
        assertEq(0, zero.cached_content_token_count);
        assertTrue(zero.hasKey("cached_content_token_count"));
        hash<auto> miss = GeminiBodyShape::normalizeUsage({
            "promptTokenCount": 100, "candidatesTokenCount": 20}, True);
        assertEq(0, miss.cached_content_token_count);
        assertEq(0, miss.prompt_tokens_details.cached_tokens);
        assertFalse(GeminiBodyShape::normalizeUsage({
            "promptTokenCount": 100, "candidatesTokenCount": 20}).hasKey("prompt_tokens_details"));
    }

    #! the usage of the final stream chunk counts the thinking tokens once
    private streamUsageTest() {
        if (!fake_http) {
            testSkip("no fake server");
        }
        GcpAuth::clearTokenCache();
        handler.stream_chunks = (
            {"candidates": ({"content": {"role": "model", "parts": ({"text": "A"},)}},)},
            {
                "candidates": ({"content": {"role": "model", "parts": ({"text": "B"},)}, "finishReason": "STOP"},),
                "usageMetadata": {"promptTokenCount": 10, "candidatesTokenCount": 4, "thoughtsTokenCount": 6,
                    "cachedContentTokenCount": 8, "totalTokenCount": 20},
            },
        );
        on_exit handler.stream_chunks = ();
        QoreLlmUtils::LlmBackend backend = newBackend();
        hash<auto> resp = backend.chatCompletionsStream({
            "messages": ({"role": "user", "content": "stream"},),
        }, sub (hash<auto> chunk) {});
        assertEq(4, resp.usage.output_tokens);
        assertEq(6, resp.usage.reasoning_tokens);
        assertFalse(resp.usage.reasoning_in_output);
        assertEq(8, resp.usage.cached_content_token_count);
        assertEq(20, resp.usage.total_tokens);
        hash<LlmTokenUsage> tokens = LlmTelemetry::normalizeUsage(resp.usage);
        assertEq(20, tokens.total_tokens);
        assertEq(8, tokens.cached_input_tokens);
        assertFalse(tokens.reasoning_in_output);
    }

    private VertexAiRestClient::VertexAiLlmProvider newProvider() {
        return new VertexAiRestClient::VertexAiLlmProvider(
            <QoreLlmUtils::LlmBackendConfig>{
                "model": "gemini-2.0-flash",
                "url": "http://localhost:" + fake_port,
                "provider_options": {
                    "gcp_project_id": "fake-project",
                    "gcp_region": "us-central1",
                    "gcp_sa_json_path": sa_path,
                },
            });
    }

