    #! Test contacts provider
    private testContactsProvider() {
        if (m_options.verbose) {
            printf("\n--- Testing Contacts Provider ---\n");
        }

        ZohoInventoryDataProvider::ZohoInventoryDataProvider prov(client);

        # List existing contacts
        AbstractDataProvider contactsProvider = prov.getChildProvider("contacts");
        list<hash<auto>> contacts = map $1, contactsProvider.searchRecords(NOTHING, {
            "organization_id": organizationId,
        });

        if (m_options.verbose) {
            printf("Found %d contacts\n", contacts.size());
        }

        # Create a test contact
        AbstractDataProvider createContactProvider = prov.getChildProvider("create-contact");
        string testName = sprintf("Test Contact %s", now_us().format("YYYYMMDDHHmmss"));

        try {
            hash<auto> newContact = createContactProvider.doRequest({
                "contact_name": testName,
                "contact_type": "customer",
                "company_name": "Test Company Inc",
                "payment_terms": 30,
                "notes": "Created by integration test",
            });

            if (newContact.contact_id) {
                testContactId = newContact.contact_id;
                assertTrue(testContactId.val(), "Contact should be created with an ID");
                if (m_options.verbose) {
                    printf("Created test contact: %s (%s)\n", testName, testContactId);
                }

                # Verify the contact was created by listing
                list<hash<auto>> updatedContacts = map $1, contactsProvider.searchRecords(
                    NOTHING, {"organization_id": organizationId});
                bool found = False;
                foreach hash<auto> contact in (updatedContacts) {
                    if (contact.contact_id == testContactId) {
                        found = True;
                        assertEq(testName, contact.contact_name);
                        if (m_options.verbose) {
                            printf("  Verified contact: %s (company: %s)\n",
                                contact.contact_name, contact.company_name ?? "N/A");
                        }
                        break;
                    }
                }
                assertTrue(found, "Created contact should be found in contact list");

                # Verify the contact via get-contact
                AbstractDataProvider getContactProvider = prov.getChildProvider("get-contact");
                hash<auto> fetchedContact = getContactProvider.doRequest({
                    "contact_id": testContactId,
                });
                assertEq(testContactId, fetchedContact.contact_id);
                assertEq(testName, fetchedContact.contact_name);
                if (m_options.verbose) {
                    printf("  Fetched contact: %s (type: %s)\n",
                        fetchedContact.contact_name, fetchedContact.contact_type ?? "N/A");
                }
            }
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("Create contact failed: %s: %s\n", ex.err, ex.desc);
            }
        }

        if (m_options.verbose) {
            printf("--- Contacts Provider tests completed ---\n");
        }
    }

