%modern

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/DataProvider
%requires ../../../../qlib/ConnectionProvider
%requires ../../../../qlib/RestClient.qm

%try-module json
%define NoJson
%endtry

%requires ../../../../qlib/ZohoInventoryRestClient.qm
%requires ../../../../qlib/ZohoInventoryDataProvider

%exec-class ZohoInventoryDataProviderTest

public class ZohoInventoryDataProviderTest inherits QUnit::Test {
    private {
        #! Zoho Inventory REST client for integration tests
        *ZohoInventoryRestClient::ZohoInventoryRestClient client;

        #! Logger for verbose output
        Logger logger;

        #! Custom command-line options
        const MyOpts = Opts + {
            "client_id": "i,client-id=s",
            "client_secret": "s,client-secret=s",
            "refresh_token": "r,refresh-token=s",
            "token": "t,token=s",
            "org_id": "o,org-id=s",
            "subdomain": "S,subdomain=s",
            "domain": "D,domain=s",
            "conn": "c,connection=s",
        };

        #! Test contact ID (created during test)
        *string testContactId;

        #! Test item ID (created during test)
        *string testItemId;

        #! Test sales order ID (created during test)
        *string testSalesOrderId;

        #! Test invoice ID (created during test)
        *string testInvoiceId;

        #! Organization ID for tests (passed per-action, not from connection)
        *string organizationId;
    }

    constructor() : Test("ZohoInventoryDataProvider Test", "1.0", \ARGV, MyOpts) {
        logger = new Logger("test", LoggerLevel::getLevelInfo());

        # Unit tests (always run, no credentials needed)
        addTestCase("sanity tests", \sanityTests());
        addTestCase("factory tests", \factoryTests());
        addTestCase("metadata tests", \metadataTests());
        addTestCase("child provider tests", \childProviderTests());
        addTestCase("negative tests", \negativeTests());
        addTestCase("corner case tests", \cornerCaseTests());
        addTestCase("connection tests", \connectionTests());
        addTestCase("action catalog tests", \actionCatalogTests());

        # Integration tests (require Zoho Inventory credentials)
        addTestCase("integration tests", \integrationTests());

        # Polling trigger tests (require credentials)
        addTestCase("polling trigger tests", \pollingTriggerTests());

        # Try to set up connection for integration tests
        try {
            setupConnection();
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("Connection setup failed: %s: %s\n", ex.err, ex.desc);
            }
        }

        set_return_value(main());
    }

    #! Sets up the Zoho Inventory client for integration tests
    private setupConnection() {
        # Organization ID is always required for actions (passed per-action, not from connection)
        organizationId = m_options.org_id ?? ENV.ZOHOINVENTORY_ORGANIZATION_ID;

        # Try to use a connection from Qorus if specified
        *string conn_name = m_options.conn ?? ENV.ZOHOINVENTORY_CONNECTION;
        if (conn_name) {
            if (m_options.verbose) {
                printf("Using connection: %s\n", conn_name);
            }
            if (!organizationId) {
                if (m_options.verbose) {
                    printf("Warning: No organization_id provided. Use -o option or "
                        "ZOHOINVENTORY_ORGANIZATION_ID env var.\n");
                }
            }
            client = get_connection(conn_name).get();
            # Set organization_id on the client for request providers
            if (organizationId) {
                client.setOrganizationId(organizationId);
            }
            return;
        }

        *string client_id = m_options.client_id ?? ENV.ZOHOINVENTORY_CLIENT_ID;
        *string client_secret = m_options.client_secret ?? ENV.ZOHOINVENTORY_CLIENT_SECRET;
        *string refresh_token = m_options.refresh_token ?? ENV.ZOHOINVENTORY_REFRESH_TOKEN;
        *string token = m_options.token ?? ENV.ZOHOINVENTORY_TOKEN;

        # Allow token-only mode: just access token + org_id for quick testing
        if (token && organizationId && (!client_id || !client_secret || !refresh_token)) {
            if (m_options.verbose) {
                printf("Using token-only mode (no OAuth2 refresh)\n");
            }
            hash<auto> opts = {
                "subdomain": m_options.subdomain ?? ENV.ZOHOINVENTORY_SUBDOMAIN ?? "zoho",
                "domain": m_options.domain ?? ENV.ZOHOINVENTORY_DOMAIN ?? ".com",
                "token": token,
            };
            client = new ZohoInventoryRestClient::ZohoInventoryRestClient(opts);
            if (organizationId) {
                client.setOrganizationId(organizationId);
            }
            return;
        }

        if (!client_id || !client_secret || !refresh_token || !organizationId) {
            if (m_options.verbose) {
                printf("Missing Zoho Inventory credentials. Required:\n");
                printf("  - ZOHOINVENTORY_CONNECTION or -c option (Qorus connection name)\n");
                printf("Or (token-only mode):\n");
                printf("  - ZOHOINVENTORY_TOKEN or -t option (access token)\n");
                printf("  - ZOHOINVENTORY_ORGANIZATION_ID or -o option\n");
                printf("Or (full OAuth2 mode):\n");
                printf("  - ZOHOINVENTORY_CLIENT_ID or -i option\n");
                printf("  - ZOHOINVENTORY_CLIENT_SECRET or -s option\n");
                printf("  - ZOHOINVENTORY_REFRESH_TOKEN or -r option\n");
                printf("  - ZOHOINVENTORY_ORGANIZATION_ID or -o option\n");
                printf("  - ZOHOINVENTORY_TOKEN or -t option (optional access token)\n");
            }
            return;
        }

        hash<auto> opts = {
            "oauth2_client_id": client_id,
            "oauth2_client_secret": client_secret,
            "oauth2_refresh_token": refresh_token,
            # NOTE: organization_id is intentionally NOT set here to match real Qorus behavior
            # where it's selected per-action, not from the connection
            "subdomain": m_options.subdomain ?? ENV.ZOHOINVENTORY_SUBDOMAIN ?? "zoho",
            "domain": m_options.domain ?? ENV.ZOHOINVENTORY_DOMAIN ?? ".com",
        };
        if (token) {
            opts.token = token;
        }

        client = new ZohoInventoryRestClient::ZohoInventoryRestClient(opts);

        # Set organization_id on the client for request providers (create, update, delete, get)
        # Search providers pass it via search_options, the REST client won't duplicate it
        if (organizationId) {
            client.setOrganizationId(organizationId);
        }
    }

    #! Get a test provider - uses real client if available, otherwise creates with do_not_connect
    private ZohoInventoryDataProvider::ZohoInventoryDataProvider getTestProvider() {
        if (client) {
            return new ZohoInventoryDataProvider::ZohoInventoryDataProvider(client);
        }
        ZohoInventoryRestClient::ZohoInventoryRestClient rest({
            "oauth2_client_id": "x",
            "oauth2_client_secret": "x",
        }, True);
        return new ZohoInventoryDataProvider::ZohoInventoryDataProvider(rest);
    }

    #! Check if json module is available
    private checkJson() {
%ifdef NoJson
        testSkip("no json module present");
%endif
    }

    #! Basic sanity tests - provider instantiation
    sanityTests() {
        checkJson();
        ZohoInventoryDataProvider::ZohoInventoryDataProvider prov = getTestProvider();
        assertEq("zohoinventory", prov.getName());
        assertTrue(prov.getDesc().val());
    }

    #! Factory tests - verify factory registration
    factoryTests() {
        checkJson();
        # Verify factory is registered
        AbstractDataProviderFactory factory = DataProvider::getFactory("zohoinventory");
        assertEq("zohoinventory", factory.getInfo().name);
        assertEq("Zoho Inventory data provider factory", factory.getInfo().desc);
        assertTrue(factory.getInfo().children_can_support_apis);
        assertTrue(factory.getInfo().children_can_support_records);
        assertTrue(factory.getInfo().children_can_support_observers);

        # Verify factory can create provider with options
        hash<auto> factoryOpts = factory.getInfo().provider_info.constructor_options;
        assertTrue(factoryOpts.hasKey("zohoinventoryrestclient"));
    }

    #! Metadata tests - verify provider info structure
    metadataTests() {
        checkJson();
        ZohoInventoryDataProvider::ZohoInventoryDataProvider prov = getTestProvider();
        hash<DataProviderInfo> info = prov.getInfo();

        assertTrue(info.supports_children);
        assertTrue(info.children_can_support_apis);
        assertTrue(info.children_can_support_records);
        assertTrue(info.children_can_support_observers);
        assertEq("ZohoInventoryDataProvider", info.type);

        # Check constructor options
        assertTrue(info.constructor_options.hasKey("zohoinventoryrestclient"));
    }

    #! Child provider tests - verify hierarchy
    childProviderTests() {
        checkJson();
        ZohoInventoryDataProvider::ZohoInventoryDataProvider prov = getTestProvider();

        # Check child provider names
        list<string> children = prov.getChildProviderNames();

        # Verify collection providers exist
        assertTrue(children.contains("contacts"));
        assertTrue(children.contains("contactpersons"));
        assertTrue(children.contains("items"));
        assertTrue(children.contains("itemgroups"));
        assertTrue(children.contains("inventoryadjustments"));
        assertTrue(children.contains("packages"));
        assertTrue(children.contains("purchaseorders"));
        assertTrue(children.contains("salesorders"));
        assertTrue(children.contains("invoices"));

        # Verify CRUD providers exist
        assertTrue(children.contains("create-invoice"));
        assertTrue(children.contains("create-contact"));
        assertTrue(children.contains("create-contact-person"));
        assertTrue(children.contains("create-item"));
        assertTrue(children.contains("create-item-group"));
        assertTrue(children.contains("create-item-adjustment"));
        assertTrue(children.contains("create-package"));
        assertTrue(children.contains("create-purchase-order"));
        assertTrue(children.contains("create-sales-order"));
        assertTrue(children.contains("create-shipment-order"));

        assertTrue(children.contains("get-invoice"));
        assertTrue(children.contains("get-contact"));
        assertTrue(children.contains("get-contact-person"));
        assertTrue(children.contains("get-item"));
        assertTrue(children.contains("get-item-group"));
        assertTrue(children.contains("get-item-adjustment"));
        assertTrue(children.contains("get-package"));
        assertTrue(children.contains("get-purchase-order"));
        assertTrue(children.contains("get-sales-order"));
        assertTrue(children.contains("get-shipment-order"));

        assertTrue(children.contains("update-invoice"));
        assertTrue(children.contains("update-contact"));
        assertTrue(children.contains("update-contact-person"));
        assertTrue(children.contains("update-item"));
        assertTrue(children.contains("update-item-group"));
        assertTrue(children.contains("update-package"));
        assertTrue(children.contains("update-purchase-order"));
        assertTrue(children.contains("update-sales-order"));

        assertTrue(children.contains("delete-invoice"));
        assertTrue(children.contains("delete-contact"));
        assertTrue(children.contains("delete-contact-person"));
        assertTrue(children.contains("delete-item-group"));
        assertTrue(children.contains("delete-item-adjustment"));
        assertTrue(children.contains("delete-package"));
        assertTrue(children.contains("delete-purchase-order"));
        assertTrue(children.contains("delete-sales-order"));
        assertTrue(children.contains("delete-shipment-order"));
        assertTrue(children.contains("delete-item"));

        # Verify shipment order providers
        assertTrue(children.contains("shipmentorders"));
        assertTrue(children.contains("update-shipment-order"));

        # Verify special action providers exist
        assertTrue(children.contains("mark-contact-active"));
        assertTrue(children.contains("mark-contact-person-primary"));
        assertTrue(children.contains("mark-item-active"));
        assertTrue(children.contains("mark-shipment-delivered"));
        assertTrue(children.contains("api-call"));

        # Verify events provider exists
        assertTrue(children.contains("events"));

        # Check contacts child provider
        AbstractDataProvider contacts = prov.getChildProvider("contacts");
        assertEq("contacts", contacts.getName());
        hash<DataProviderInfo> contactsInfo = contacts.getInfo();
        assertTrue(contactsInfo.supports_read);
        assertTrue(contactsInfo.supports_native_search);

        # Check items child provider
        AbstractDataProvider items = prov.getChildProvider("items");
        assertEq("items", items.getName());
        hash<DataProviderInfo> itemsInfo = items.getInfo();
        assertTrue(itemsInfo.supports_read);
        assertTrue(itemsInfo.supports_native_search);

        # Check salesorders child provider
        AbstractDataProvider salesorders = prov.getChildProvider("salesorders");
        assertEq("salesorders", salesorders.getName());
        hash<DataProviderInfo> salesordersInfo = salesorders.getInfo();
        assertTrue(salesordersInfo.supports_read);
        assertTrue(salesordersInfo.supports_native_search);

        # Check purchaseorders child provider
        AbstractDataProvider purchaseorders = prov.getChildProvider("purchaseorders");
        assertEq("purchaseorders", purchaseorders.getName());
        hash<DataProviderInfo> purchaseordersInfo = purchaseorders.getInfo();
        assertTrue(purchaseordersInfo.supports_read);
        assertTrue(purchaseordersInfo.supports_native_search);

        # Check invoices child provider
        AbstractDataProvider invoices = prov.getChildProvider("invoices");
        assertEq("invoices", invoices.getName());
        hash<DataProviderInfo> invoicesInfo = invoices.getInfo();
        assertTrue(invoicesInfo.supports_read);
        assertTrue(invoicesInfo.supports_native_search);

        # Check events child provider
        AbstractDataProvider events = prov.getChildProvider("events");
        assertEq("events", events.getName());
        hash<DataProviderInfo> eventsInfo = events.getInfo();
        assertTrue(eventsInfo.supports_children);

        # Check events child providers (triggers)
        list<string> eventChildren = events.getChildProviderNames();
        assertTrue(eventChildren.contains("new-contact"));
        assertTrue(eventChildren.contains("new-invoice"));
        assertTrue(eventChildren.contains("new-item-adjustment"));
        assertTrue(eventChildren.contains("new-item-group"));
        assertTrue(eventChildren.contains("new-item"));
        assertTrue(eventChildren.contains("new-package"));
        assertTrue(eventChildren.contains("new-purchase-order"));
        assertTrue(eventChildren.contains("new-sales-order"));

        # Verify event providers have correct info
        AbstractDataProvider newContactEvent = events.getChildProvider("new-contact");
        assertEq("new-contact", newContactEvent.getName());
        hash<DataProviderInfo> newContactInfo = newContactEvent.getInfo();
        assertTrue(newContactInfo.supports_observable);

        AbstractDataProvider newInvoiceEvent = events.getChildProvider("new-invoice");
        assertEq("new-invoice", newInvoiceEvent.getName());
        hash<DataProviderInfo> newInvoiceInfo = newInvoiceEvent.getInfo();
        assertTrue(newInvoiceInfo.supports_observable);

        AbstractDataProvider newItemEvent = events.getChildProvider("new-item");
        assertEq("new-item", newItemEvent.getName());
        hash<DataProviderInfo> newItemInfo = newItemEvent.getInfo();
        assertTrue(newItemInfo.supports_observable);

        AbstractDataProvider newSalesOrderEvent = events.getChildProvider("new-sales-order");
        assertEq("new-sales-order", newSalesOrderEvent.getName());
        hash<DataProviderInfo> newSalesOrderInfo = newSalesOrderEvent.getInfo();
        assertTrue(newSalesOrderInfo.supports_observable);
    }

    #! Negative tests - test error handling and invalid inputs
    negativeTests() {
        checkJson();
        ZohoInventoryDataProvider::ZohoInventoryDataProvider prov = getTestProvider();

        # Test getting non-existent child provider
        assertThrows("INVALID-CHILD-PROVIDER", sub() {
            prov.getChildProviderEx("nonexistent");
        });

        # Test invalid child in events provider
        AbstractDataProvider events = prov.getChildProvider("events");
        assertThrows("INVALID-CHILD-PROVIDER", sub() {
            events.getChildProviderEx("invalid-event");
        });

        # Test invalid subdomain
        assertThrows("ZOHOINVENTORY-ERROR", sub() {
            new ZohoInventoryRestClient::ZohoInventoryRestClient({
                "oauth2_client_id": "x",
                "oauth2_client_secret": "x",
                "subdomain": "invalid",
                "domain": ".com",
            });
        });

        # Test invalid domain
        assertThrows("ZOHOINVENTORY-ERROR", sub() {
            new ZohoInventoryRestClient::ZohoInventoryRestClient({
                "oauth2_client_id": "x",
                "oauth2_client_secret": "x",
                "subdomain": "zoho",
                "domain": ".invalid",
            });
        });
    }

    #! Corner case tests - edge cases and boundary conditions
    cornerCaseTests() {
        checkJson();
        # Test with different subdomains
        ZohoInventoryRestClient::ZohoInventoryRestClient clientZoho({
            "oauth2_client_id": "x",
            "oauth2_client_secret": "x",
            "subdomain": "zoho",
            "domain": ".com",
        }, True);
        assertEq("https://www.zohoapis.com/inventory/v1", clientZoho.getURL());
        assertEq("zoho", clientZoho.getSubdomain());
        assertEq(".com", clientZoho.getDomain());

        ZohoInventoryRestClient::ZohoInventoryRestClient clientZohoCloud({
            "oauth2_client_id": "x",
            "oauth2_client_secret": "x",
            "subdomain": "zohocloud",
            "domain": ".com",
        }, True);
        assertEq("https://www.zohoapis.com/inventory/v1", clientZohoCloud.getURL());
        assertEq("zohocloud", clientZohoCloud.getSubdomain());

        # Test with different domains
        ZohoInventoryRestClient::ZohoInventoryRestClient clientEU({
            "oauth2_client_id": "x",
            "oauth2_client_secret": "x",
            "subdomain": "zoho",
            "domain": ".eu",
        }, True);
        assertEq("https://www.zohoapis.eu/inventory/v1", clientEU.getURL());
        assertEq(".eu", clientEU.getDomain());

        ZohoInventoryRestClient::ZohoInventoryRestClient clientIN({
            "oauth2_client_id": "x",
            "oauth2_client_secret": "x",
            "subdomain": "zoho",
            "domain": ".in",
        }, True);
        assertEq("https://www.zohoapis.in/inventory/v1", clientIN.getURL());

        ZohoInventoryRestClient::ZohoInventoryRestClient clientAU({
            "oauth2_client_id": "x",
            "oauth2_client_secret": "x",
            "subdomain": "zoho",
            "domain": ".com.au",
        }, True);
        assertEq("https://www.zohoapis.com.au/inventory/v1", clientAU.getURL());

        ZohoInventoryRestClient::ZohoInventoryRestClient clientCA({
            "oauth2_client_id": "x",
            "oauth2_client_secret": "x",
            "subdomain": "zoho",
            "domain": ".ca",
        }, True);
        assertEq("https://www.zohoapis.ca/inventory/v1", clientCA.getURL());

        ZohoInventoryRestClient::ZohoInventoryRestClient clientSA({
            "oauth2_client_id": "x",
            "oauth2_client_secret": "x",
            "subdomain": "zoho",
            "domain": ".sa",
        }, True);
        assertEq("https://www.zohoapis.sa/inventory/v1", clientSA.getURL());

        ZohoInventoryRestClient::ZohoInventoryRestClient clientJP({
            "oauth2_client_id": "x",
            "oauth2_client_secret": "x",
            "subdomain": "zoho",
            "domain": ".jp",
        }, True);
        assertEq("https://www.zohoapis.jp/inventory/v1", clientJP.getURL());

        # Test default subdomain and domain
        ZohoInventoryRestClient::ZohoInventoryRestClient clientDefault({
            "oauth2_client_id": "x",
            "oauth2_client_secret": "x",
        }, True);
        assertEq("https://www.zohoapis.com/inventory/v1", clientDefault.getURL());
        assertEq("zoho", clientDefault.getSubdomain());
        assertEq(".com", clientDefault.getDomain());

        # Test organization_id handling
        ZohoInventoryRestClient::ZohoInventoryRestClient clientWithOrg({
            "oauth2_client_id": "x",
            "oauth2_client_secret": "x",
            "organization_id": "12345",
        }, True);
        assertEq("12345", clientWithOrg.getOrganizationId());

        # Test setOrganizationId
        clientWithOrg.setOrganizationId("67890");
        assertEq("67890", clientWithOrg.getOrganizationId());
    }

    #! Connection tests - verify connection scheme registration
    connectionTests() {
        checkJson();
        # Verify connection scheme is registered
        hash<ConnectionSchemeInfo> scheme = ConnectionSchemeCache::getScheme("zohoinventory");
        assertEq("Zoho Inventory REST Connection", scheme.display_name);
        assertTrue(scheme.short_desc.val());
        assertTrue(scheme.desc.val());

        # Verify required options (token OR oauth2 client credentials)
        assertEq("token|oauth2_client_id,oauth2_client_secret", scheme.required_options);
        assertTrue(scheme.options.hasKey("subdomain"));
        assertTrue(scheme.options.hasKey("domain"));
        assertTrue(scheme.options.hasKey("oauth2_client_id"));
        assertTrue(scheme.options.hasKey("oauth2_client_secret"));
        assertTrue(scheme.options.hasKey("oauth2_refresh_token"));
        # Note: organization_id is NOT a connection option - it's an action-level option with ref_data

        # Check subdomain option
        assertEq("zoho", scheme.options.subdomain.default_value);
        assertTrue(scheme.options.subdomain.preselected);
        assertTrue(scheme.options.subdomain.allowed_values.size() == 2);

        # Check domain option
        assertEq(".com", scheme.options.domain.default_value);
        assertTrue(scheme.options.domain.preselected);
        assertTrue(scheme.options.domain.allowed_values.size() == 7);

        # Verify connection can create data provider
        ZohoInventoryRestClient::ZohoInventoryRestConnection conn("test", "test connection",
            "zohoinventory://www.zohoapis.com", {}, {
                "oauth2_client_id": "x",
                "oauth2_client_secret": "x",
                "subdomain": "zoho",
                "domain": ".com",
            });
        assertTrue(conn.hasDataProvider());
        assertEq("ZohoInventory", conn.getAppName());
        assertEq("zohoinventory", conn.getType());
    }

    #! Action catalog tests - verify all actions are registered
    actionCatalogTests() {
        checkJson();
        # Get all actions for the Zoho Inventory app
        *list<hash<DataProviderActionInfo>> actions = DataProviderActionCatalog::getActions(
            ZohoInventoryDataProvider::AppName);
        assertTrue(actions.size() > 0);

        # Verify action count (10 DPAT_FIND + 44 DPAT_API + 8 DPAT_EVENT = 62)
        assertEq(62, actions.size());

        # Get action names
        list<string> actionNames = map $1.action, actions;

        # Verify contact actions
        assertTrue(actionNames.contains("list-contacts"));
        assertTrue(actionNames.contains("create-contact"));
        assertTrue(actionNames.contains("get-contact"));
        assertTrue(actionNames.contains("update-contact"));
        assertTrue(actionNames.contains("delete-contact"));
        assertTrue(actionNames.contains("mark-contact-active"));

        # Verify contact person actions
        assertTrue(actionNames.contains("list-contact-persons"));
        assertTrue(actionNames.contains("create-contact-person"));
        assertTrue(actionNames.contains("get-contact-person"));
        assertTrue(actionNames.contains("update-contact-person"));
        assertTrue(actionNames.contains("delete-contact-person"));
        assertTrue(actionNames.contains("mark-contact-person-primary"));

        # Verify item actions
        assertTrue(actionNames.contains("list-items"));
        assertTrue(actionNames.contains("create-item"));
        assertTrue(actionNames.contains("get-item"));
        assertTrue(actionNames.contains("update-item"));
        assertTrue(actionNames.contains("delete-item"));
        assertTrue(actionNames.contains("mark-item-active"));

        # Verify item group actions
        assertTrue(actionNames.contains("list-item-groups"));
        assertTrue(actionNames.contains("create-item-group"));
        assertTrue(actionNames.contains("get-item-group"));
        assertTrue(actionNames.contains("update-item-group"));
        assertTrue(actionNames.contains("delete-item-group"));

        # Verify item adjustment actions
        assertTrue(actionNames.contains("list-item-adjustments"));
        assertTrue(actionNames.contains("create-item-adjustment"));
        assertTrue(actionNames.contains("get-item-adjustment"));
        assertTrue(actionNames.contains("delete-item-adjustment"));

        # Verify package actions
        assertTrue(actionNames.contains("list-packages"));
        assertTrue(actionNames.contains("create-package"));
        assertTrue(actionNames.contains("get-package"));
        assertTrue(actionNames.contains("update-package"));
        assertTrue(actionNames.contains("delete-package"));

        # Verify purchase order actions
        assertTrue(actionNames.contains("list-purchase-orders"));
        assertTrue(actionNames.contains("create-purchase-order"));
        assertTrue(actionNames.contains("get-purchase-order"));
        assertTrue(actionNames.contains("update-purchase-order"));
        assertTrue(actionNames.contains("delete-purchase-order"));

        # Verify sales order actions
        assertTrue(actionNames.contains("list-sales-orders"));
        assertTrue(actionNames.contains("create-sales-order"));
        assertTrue(actionNames.contains("get-sales-order"));
        assertTrue(actionNames.contains("update-sales-order"));
        assertTrue(actionNames.contains("delete-sales-order"));

        # Verify invoice actions
        assertTrue(actionNames.contains("list-invoices"));
        assertTrue(actionNames.contains("create-invoice"));
        assertTrue(actionNames.contains("get-invoice"));
        assertTrue(actionNames.contains("update-invoice"));
        assertTrue(actionNames.contains("delete-invoice"));

        # Verify shipment order actions
        assertTrue(actionNames.contains("create-shipment-order"));
        assertTrue(actionNames.contains("get-shipment-order"));
        assertTrue(actionNames.contains("delete-shipment-order"));
        assertTrue(actionNames.contains("update-shipment-order"));
        assertTrue(actionNames.contains("list-shipment-orders"));
        assertTrue(actionNames.contains("mark-shipment-delivered"));

        # Verify api-call action
        assertTrue(actionNames.contains("api-call"));

        # Verify trigger actions
        assertTrue(actionNames.contains(ZohoInventoryDataProvider::EVENT_NEW_CONTACT));
        assertTrue(actionNames.contains(ZohoInventoryDataProvider::EVENT_NEW_INVOICE));
        assertTrue(actionNames.contains(ZohoInventoryDataProvider::EVENT_NEW_ITEM_ADJUSTMENT));
        assertTrue(actionNames.contains(ZohoInventoryDataProvider::EVENT_NEW_ITEM_GROUP));
        assertTrue(actionNames.contains(ZohoInventoryDataProvider::EVENT_NEW_ITEM));
        assertTrue(actionNames.contains(ZohoInventoryDataProvider::EVENT_NEW_PACKAGE));
        assertTrue(actionNames.contains(ZohoInventoryDataProvider::EVENT_NEW_PURCHASE_ORDER));
        assertTrue(actionNames.contains(ZohoInventoryDataProvider::EVENT_NEW_SALES_ORDER));

        # Verify create-contact action has ref_data for organizations
        *hash<DataProviderActionInfo> createContactAction = DataProviderActionCatalog::getAppAction(
            ZohoInventoryDataProvider::AppName, "create-contact");
        assertTrue(exists createContactAction, "create-contact action should exist");
        assertTrue(createContactAction.options.organization_id.ref_data == "organizations");

        # Verify event actions have correct action_code
        *hash<DataProviderActionInfo> newContactAction = DataProviderActionCatalog::getAppAction(
            ZohoInventoryDataProvider::AppName, ZohoInventoryDataProvider::EVENT_NEW_CONTACT);
        assertTrue(exists newContactAction, "new-contact action should exist");
        assertEq(DPAT_EVENT, newContactAction.action_code);
        assertEq(ZohoInventoryDataProvider::EVENT_NEW_CONTACT, newContactAction.action_val);

        *hash<DataProviderActionInfo> newInvoiceAction = DataProviderActionCatalog::getAppAction(
            ZohoInventoryDataProvider::AppName, ZohoInventoryDataProvider::EVENT_NEW_INVOICE);
        assertTrue(exists newInvoiceAction, "new-invoice action should exist");
        assertEq(DPAT_EVENT, newInvoiceAction.action_code);
        assertEq(ZohoInventoryDataProvider::EVENT_NEW_INVOICE, newInvoiceAction.action_val);

        *hash<DataProviderActionInfo> newSalesOrderAction = DataProviderActionCatalog::getAppAction(
            ZohoInventoryDataProvider::AppName, ZohoInventoryDataProvider::EVENT_NEW_SALES_ORDER);
        assertTrue(exists newSalesOrderAction, "new-sales-order action should exist");
        assertEq(DPAT_EVENT, newSalesOrderAction.action_code);
        assertEq(ZohoInventoryDataProvider::EVENT_NEW_SALES_ORDER, newSalesOrderAction.action_val);
    }

    #! Integration tests - require Zoho Inventory credentials
    integrationTests() {
        checkJson();
        if (!client) {
            testSkip("No Zoho Inventory credentials provided (use -i, -s, -r, -o options or env vars)");
            return;
        }

        # Test API connectivity
        testApiConnectivity();

        # Test reference data
        testReferenceData();

        # Test contacts provider
        testContactsProvider();

        # Test items provider
        testItemsProvider();

        # Test sales orders provider (requires contact and item)
        if (testContactId && testItemId) {
            testSalesOrdersProvider();
        }

        # Test invoices provider (requires contact and item)
        if (testContactId && testItemId) {
            testInvoicesProvider();
        }

        # Cleanup test data
        cleanup();
    }

