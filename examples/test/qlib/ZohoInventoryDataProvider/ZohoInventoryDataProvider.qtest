    #! Test sales orders provider
    private testSalesOrdersProvider() {
        if (m_options.verbose) {
            printf("\n--- Testing Sales Orders Provider ---\n");
        }

        ZohoInventoryDataProvider::ZohoInventoryDataProvider prov(client);

        # List existing sales orders
        AbstractDataProvider salesOrdersProvider = prov.getChildProvider("salesorders");
        list<hash<auto>> salesOrders = map $1, salesOrdersProvider.searchRecords(NOTHING, {
            "organization_id": organizationId,
        });

        if (m_options.verbose) {
            printf("Found %d sales orders\n", salesOrders.size());
        }

        # Create a test sales order
        AbstractDataProvider createSalesOrderProvider = prov.getChildProvider("create-sales-order");

        string orderDate = now().format("YYYY-MM-DD");

        try {
            hash<auto> newSalesOrder = createSalesOrderProvider.doRequest({
                "customer_id": testContactId,
                "date": orderDate,
                "line_items": ({
                    "item_id": testItemId,
                    "name": "Test Item",
                    "quantity": 2,
                    "rate": 100.00,
                },),
                "notes": "Created by integration test",
            });

            if (newSalesOrder.salesorder_id) {
                testSalesOrderId = newSalesOrder.salesorder_id;
                assertTrue(testSalesOrderId.val(), "Sales order should be created with an ID");
                if (m_options.verbose) {
                    printf("Created test sales order: %s (Total: %s)\n",
                        newSalesOrder.salesorder_number ?? testSalesOrderId,
                        newSalesOrder.total ?? "N/A");
                }

                # Small delay to allow API to fully process the created sales order
                sleep(500ms);

                # Test get sales order and verify created fields
                AbstractDataProvider getSalesOrderProvider = prov.getChildProvider("get-sales-order");
                hash<auto> fetchedOrder = getSalesOrderProvider.doRequest({
                    "salesorder_id": testSalesOrderId,
                });
                assertEq(testSalesOrderId, fetchedOrder.salesorder_id);
                assertEq(testContactId, fetchedOrder.customer_id);
                assertEq(orderDate, fetchedOrder.date);
                assertTrue(fetchedOrder.line_items.size() > 0, "Sales order should have line items");
                if (m_options.verbose) {
                    printf("Fetched sales order: %s (status: %s)\n",
                        fetchedOrder.salesorder_number ?? testSalesOrderId,
                        fetchedOrder.status ?? "N/A");
                }

                # Test update sales order
                AbstractDataProvider updateSalesOrderProvider = prov.getChildProvider("update-sales-order");
                string updatedNotes = sprintf("Updated by integration test at %s", now_us().toString());
                hash<auto> updatedOrder = updateSalesOrderProvider.doRequest({
                    "salesorder_id": testSalesOrderId,
                    "customer_id": testContactId,
                    "date": orderDate,
                    "line_items": ({
                        "item_id": testItemId,
                        "name": "Test Item",
                        "quantity": 3,
                        "rate": 100.00,
                    },),
                    "notes": updatedNotes,
                });
                if (m_options.verbose) {
                    printf("Updated sales order: %s\n",
                        updatedOrder.salesorder_number ?? testSalesOrderId);
                }

                # Verify update persisted
                hash<auto> verifyOrder = getSalesOrderProvider.doRequest({
                    "salesorder_id": testSalesOrderId,
                });
                assertEq(updatedNotes, verifyOrder.notes);
                assertTrue(verifyOrder.line_items.size() > 0, "Sales order should have line items after update");
                if (m_options.verbose) {
                    printf("Verified update: notes=%s, line_items=%d\n",
                        verifyOrder.notes ?? "N/A", verifyOrder.line_items.size());
                }
            }
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("Sales order operation failed: %s: %s\n", ex.err, ex.desc);
            }
            rethrow;
        }

        if (m_options.verbose) {
            printf("--- Sales Orders Provider tests completed ---\n");
        }
    }

    #! Test invoices provider
    private testInvoicesProvider() {
        if (m_options.verbose) {
            printf("\n--- Testing Invoices Provider ---\n");
        }

        ZohoInventoryDataProvider::ZohoInventoryDataProvider prov(client);

        # List existing invoices
        AbstractDataProvider invoicesProvider = prov.getChildProvider("invoices");
        list<hash<auto>> invoicesList = map $1, invoicesProvider.searchRecords(NOTHING, {
            "organization_id": organizationId,
        });

        if (m_options.verbose) {
            printf("Found %d invoices\n", invoicesList.size());
        }

        # Create a test invoice
        AbstractDataProvider createInvoiceProvider = prov.getChildProvider("create-invoice");

        string invoiceDate = now().format("YYYY-MM-DD");

        try {
            hash<auto> newInvoice = createInvoiceProvider.doRequest({
                "customer_id": testContactId,
                "date": invoiceDate,
                "line_items": ({
                    "item_id": testItemId,
                    "name": "Test Item",
                    "quantity": 1,
                    "rate": 100.00,
                },),
                "notes": "Created by integration test",
                "payment_terms": 30,
            });

            if (newInvoice.invoice_id) {
                testInvoiceId = newInvoice.invoice_id;
                assertTrue(testInvoiceId.val(), "Invoice should be created with an ID");
                if (m_options.verbose) {
                    printf("Created test invoice: %s (%s)\n",
                        newInvoice.invoice_number ?? testInvoiceId, testInvoiceId);
                }

                # Small delay to allow API to fully process the created invoice
                sleep(500ms);

                # Test get invoice and verify created fields
                AbstractDataProvider getInvoiceProvider = prov.getChildProvider("get-invoice");
                hash<auto> fetchedInvoice = getInvoiceProvider.doRequest({
                    "invoice_id": testInvoiceId,
                });
                assertEq(testInvoiceId, fetchedInvoice.invoice_id);
                assertEq(testContactId, fetchedInvoice.customer_id);
                assertEq(invoiceDate, fetchedInvoice.date);
                assertTrue(fetchedInvoice.line_items.size() > 0, "Invoice should have line items");
                if (m_options.verbose) {
                    printf("Fetched invoice: %s (status: %s, total: %s)\n",
                        fetchedInvoice.invoice_number ?? testInvoiceId,
                        fetchedInvoice.status ?? "N/A",
                        fetchedInvoice.total ?? "N/A");
                }

                # Test list invoices with invoice_id filter (DPAT_FIND_SINGLE pattern)
                list<hash<auto>> singleResult = map $1, invoicesProvider.searchRecords(
                    NOTHING, {
                        "organization_id": organizationId,
                        "invoice_id": testInvoiceId,
                    });
                assertEq(1, singleResult.size(), "Should find exactly one invoice by ID");
                assertEq(testInvoiceId, singleResult[0].invoice_id);
                if (m_options.verbose) {
                    printf("Single invoice lookup: %s\n", singleResult[0].invoice_number ?? "N/A");
                }

                # Test update invoice
                AbstractDataProvider updateInvoiceProvider = prov.getChildProvider("update-invoice");
                string updatedNotes = sprintf("Updated by integration test at %s", now_us().toString());
                hash<auto> updatedInvoice = updateInvoiceProvider.doRequest({
                    "invoice_id": testInvoiceId,
                    "customer_id": testContactId,
                    "date": invoiceDate,
                    "line_items": ({
                        "item_id": testItemId,
                        "name": "Test Item",
                        "quantity": 2,
                        "rate": 100.00,
                    },),
                    "notes": updatedNotes,
                });
                if (m_options.verbose) {
                    printf("Updated invoice: %s\n",
                        updatedInvoice.invoice_number ?? testInvoiceId);
                }

                # Verify update persisted
                hash<auto> verifyInvoice = getInvoiceProvider.doRequest({
                    "invoice_id": testInvoiceId,
                });
                assertEq(updatedNotes, verifyInvoice.notes);
                assertTrue(verifyInvoice.line_items.size() > 0,
                    "Invoice should have line items after update");
                if (m_options.verbose) {
                    printf("Verified update: notes=%s, line_items=%d\n",
                        verifyInvoice.notes ?? "N/A", verifyInvoice.line_items.size());
                }
            }
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("Invoice operation failed: %s: %s\n", ex.err, ex.desc);
            }
            rethrow;
        }

        if (m_options.verbose) {
            printf("--- Invoices Provider tests completed ---\n");
        }
    }

    #! Cleanup test data
    private cleanup() {
        if (m_options.verbose) {
            printf("\n--- Cleanup ---\n");
        }

        ZohoInventoryDataProvider::ZohoInventoryDataProvider prov(client);

        # Delete test invoice
        if (testInvoiceId) {
            try {
                AbstractDataProvider deleteInvoiceProvider = prov.getChildProvider("delete-invoice");
                deleteInvoiceProvider.doRequest({"invoice_id": testInvoiceId});
                if (m_options.verbose) {
                    printf("Deleted test invoice: %s\n", testInvoiceId);
                }
            } catch (hash<ExceptionInfo> ex) {
                if (m_options.verbose) {
                    printf("Failed to delete invoice: %s\n", ex.desc);
                }
            }
        }

        # Delete test sales order (before item, since sales orders reference items)
        if (testSalesOrderId) {
            try {
                AbstractDataProvider deleteSalesOrderProvider = prov.getChildProvider("delete-sales-order");
                deleteSalesOrderProvider.doRequest({"salesorder_id": testSalesOrderId});
                if (m_options.verbose) {
                    printf("Deleted test sales order: %s\n", testSalesOrderId);
                }
            } catch (hash<ExceptionInfo> ex) {
                if (m_options.verbose) {
                    printf("Failed to delete sales order: %s\n", ex.desc);
                }
            }
        }

        # Delete test item (after invoice and sales order, since they reference items)
        if (testItemId) {
            try {
                AbstractDataProvider deleteItemProvider = prov.getChildProvider("delete-item");
                deleteItemProvider.doRequest({"item_id": testItemId});
                if (m_options.verbose) {
                    printf("Deleted test item: %s\n", testItemId);
                }
            } catch (hash<ExceptionInfo> ex) {
                if (m_options.verbose) {
                    printf("Failed to delete item: %s\n", ex.desc);
                }
            }
        }

        # Delete test contact
        if (testContactId) {
            try {
                AbstractDataProvider deleteContactProvider = prov.getChildProvider("delete-contact");
                deleteContactProvider.doRequest({"contact_id": testContactId});
                if (m_options.verbose) {
                    printf("Deleted test contact: %s\n", testContactId);
                }
            } catch (hash<ExceptionInfo> ex) {
                if (m_options.verbose) {
                    printf("Failed to delete contact: %s\n", ex.desc);
                }
            }
        }

        if (m_options.verbose) {
            printf("--- Cleanup completed ---\n");
        }
    }

    #! Polling trigger tests - test polling-based triggers
    pollingTriggerTests() {
        checkJson();
        if (!client) {
            testSkip("No Zoho Inventory credentials provided");
            return;
        }

        if (m_options.verbose) {
            printf("\n--- Testing Polling Trigger Providers ---\n");
        }

        # ============================================
        # Test New Contact Event Provider
        # ============================================
        if (m_options.verbose) {
            printf("\nTesting ZohoInventoryNewContactWatchDataProvider...\n");
        }

        ZohoInventoryDataProvider::ZohoInventoryNewContactWatchDataProvider contactEventProv(client, {
            "poll_interval": 60,
        });
        assertEq("new-contact", contactEventProv.getName());

        # Verify provider metadata
        hash<DataProviderInfo> contactEventInfo = contactEventProv.getInfo();
        assertTrue(contactEventInfo.supports_observable);
        assertEq("ZohoInventoryNewContactWatchDataProvider", contactEventInfo.type);

        if (m_options.verbose) {
            printf("  Provider name: %s\n", contactEventProv.getName());
            printf("  Supports observable: %s\n", contactEventInfo.supports_observable);
        }

        # ============================================
        # Test New Invoice Event Provider
        # ============================================
        if (m_options.verbose) {
            printf("\nTesting ZohoInventoryNewInvoiceWatchDataProvider...\n");
        }

        ZohoInventoryDataProvider::ZohoInventoryNewInvoiceWatchDataProvider invoiceEventProv(client, {
            "poll_interval": 60,
        });
        assertEq("new-invoice", invoiceEventProv.getName());
        assertTrue(invoiceEventProv.getInfo().supports_observable);

        # ============================================
        # Test New Item Adjustment Event Provider
        # ============================================
        if (m_options.verbose) {
            printf("\nTesting ZohoInventoryNewItemAdjustmentWatchDataProvider...\n");
        }

        ZohoInventoryDataProvider::ZohoInventoryNewItemAdjustmentWatchDataProvider itemAdjEventProv(client, {
            "poll_interval": 60,
        });
        assertEq("new-item-adjustment", itemAdjEventProv.getName());
        assertTrue(itemAdjEventProv.getInfo().supports_observable);

        # ============================================
        # Test New Item Group Event Provider
        # ============================================
        if (m_options.verbose) {
            printf("\nTesting ZohoInventoryNewItemGroupWatchDataProvider...\n");
        }

        ZohoInventoryDataProvider::ZohoInventoryNewItemGroupWatchDataProvider itemGroupEventProv(client, {
            "poll_interval": 60,
        });
        assertEq("new-item-group", itemGroupEventProv.getName());
        assertTrue(itemGroupEventProv.getInfo().supports_observable);

        # ============================================
        # Test New Item Event Provider
        # ============================================
        if (m_options.verbose) {
            printf("\nTesting ZohoInventoryNewItemWatchDataProvider...\n");
        }

        ZohoInventoryDataProvider::ZohoInventoryNewItemWatchDataProvider itemEventProv(client, {
            "poll_interval": 60,
        });
        assertEq("new-item", itemEventProv.getName());
        assertTrue(itemEventProv.getInfo().supports_observable);

        # ============================================
        # Test Remaining Event Providers
        # ============================================
        if (m_options.verbose) {
            printf("\nTesting remaining event providers...\n");
        }

        ZohoInventoryDataProvider::ZohoInventoryNewPackageWatchDataProvider packageEventProv(client, {});
        assertEq("new-package", packageEventProv.getName());
        assertTrue(packageEventProv.getInfo().supports_observable);

        ZohoInventoryDataProvider::ZohoInventoryNewPurchaseOrderWatchDataProvider purchaseOrderEventProv(client, {});
        assertEq("new-purchase-order", purchaseOrderEventProv.getName());
        assertTrue(purchaseOrderEventProv.getInfo().supports_observable);

        ZohoInventoryDataProvider::ZohoInventoryNewSalesOrderWatchDataProvider salesOrderEventProv(client, {});
        assertEq("new-sales-order", salesOrderEventProv.getName());
        assertTrue(salesOrderEventProv.getInfo().supports_observable);

        # ============================================
        # Test Observer Registration
        # ============================================
        if (m_options.verbose) {
            printf("\nTesting observer registration...\n");
        }

        TestObserver observer();
        contactEventProv.registerObserver(observer);

        # Note: We don't actually start polling in tests as it would make API calls
        # The observer registration test verifies the mechanism works

        if (m_options.verbose) {
            printf("  Observer registered successfully\n");
        }

        # ============================================
        # Test Example Event Data
        # ============================================
        if (m_options.verbose) {
            printf("\nTesting example event data (getExampleEventData)...\n");
        }

        # Test that each event provider returns example data (either real or fake)
        hash<string, hash<DataProviderMessageInfo>> contactEventTypes = contactEventProv.getEventTypes();
        assertTrue(contactEventTypes.hasKey(ZohoInventoryDataProvider::EVENT_NEW_CONTACT));
        auto contactExampleData = contactEventProv.getExampleEventData(
            ZohoInventoryDataProvider::EVENT_NEW_CONTACT);
        assertTrue(contactExampleData.contact_id.val(), "Contact example should have contact_id");
        if (m_options.verbose) {
            printf("  Contact example data: contact_id=%s\n", contactExampleData.contact_id);
        }

        hash<string, hash<DataProviderMessageInfo>> invoiceEventTypes = invoiceEventProv.getEventTypes();
        assertTrue(invoiceEventTypes.hasKey(ZohoInventoryDataProvider::EVENT_NEW_INVOICE));
        auto invoiceExampleData = invoiceEventProv.getExampleEventData(
            ZohoInventoryDataProvider::EVENT_NEW_INVOICE);
        assertTrue(invoiceExampleData.invoice_id.val(), "Invoice example should have invoice_id");
        if (m_options.verbose) {
            printf("  Invoice example data: invoice_id=%s\n", invoiceExampleData.invoice_id);
        }

        hash<string, hash<DataProviderMessageInfo>> itemEventTypes = itemEventProv.getEventTypes();
        assertTrue(itemEventTypes.hasKey(ZohoInventoryDataProvider::EVENT_NEW_ITEM));
        auto itemExampleData = itemEventProv.getExampleEventData(
            ZohoInventoryDataProvider::EVENT_NEW_ITEM);
        assertTrue(itemExampleData.item_id.val(), "Item example should have item_id");
        if (m_options.verbose) {
            printf("  Item example data: item_id=%s\n", itemExampleData.item_id);
        }

        hash<string, hash<DataProviderMessageInfo>> salesOrderEventTypes = salesOrderEventProv.getEventTypes();
        assertTrue(salesOrderEventTypes.hasKey(ZohoInventoryDataProvider::EVENT_NEW_SALES_ORDER));
        auto salesOrderExampleData = salesOrderEventProv.getExampleEventData(
            ZohoInventoryDataProvider::EVENT_NEW_SALES_ORDER);
        assertTrue(salesOrderExampleData.salesorder_id.val(),
            "Sales order example should have salesorder_id");
        if (m_options.verbose) {
            printf("  Sales order example data: salesorder_id=%s\n", salesOrderExampleData.salesorder_id);
        }

        if (m_options.verbose) {
            printf("\n--- Polling Trigger tests completed ---\n");
        }
    }
}

#! Test observer for polling events
class TestObserver inherits Observer {
    public {
        list<hash<auto>> events = ();
    }

    update(string event_id, hash<auto> data) {
        events += {"event_id": event_id, "data": data};
    }
}
