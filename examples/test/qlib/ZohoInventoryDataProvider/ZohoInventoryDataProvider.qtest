        assertTrue(response.body.organizations.val());
        if (m_options.verbose) {
            printf("Connected to Zoho Inventory - Organization: %s\n",
                response.body.organizations[0].name ?? "N/A");
        }

        if (m_options.verbose) {
            printf("--- API Connectivity tests completed ---\n");
        }
    }

