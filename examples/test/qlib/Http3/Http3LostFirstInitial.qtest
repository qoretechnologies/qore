    HTTP/3 server handling of a lost or reordered first client datagram.

    A ClientHello with a post-quantum key share does not fit one datagram, so a
    client's first flight is two Initial datagrams.  When the first is lost (or
    arrives after the second), the server's first Initial does not start the
    ClientHello; ngtcp2 then asks the server for a Retry (NGTCP2_ERR_RETRY) or a
    silent drop.  The server used to answer with CONNECTION_CLOSE, so the client
    failed with "connection closed by peer" at once, or - when that close was
    lost as well - stalled until its connect timeout.

    The client-side datagram loss is modelled with the DEBUG-build test hook
    QORE_QUIC_TEST_DROP_CLIENT_DATAGRAMS; the cases skip in other builds.
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Mime
%requires Logger
%requires HttpServerUtil
%requires AsyncSocketIo
%requires HttpServerAsyncIo
%requires HttpServer
%requires RestClientIo
%requires json

%exec-class Http3LostFirstInitialTest

class PingHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, make_json({"ok": True}), {"Content-Type": MimeTypeJson});
    }
}

class StallHandler inherits AbstractHttpRequestHandler {
    public {
        Channel release(10);
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        release.recv(20s);
        return makeResponse(200, make_json({"ok": True}), {"Content-Type": MimeTypeJson});
    }
}

#! Records the messages logged to the async I/O logger
class CaptureAppender inherits LoggerAppenderWithLayout {
    public {
        Queue messages();
    }

    constructor() : LoggerAppenderWithLayout("capture", new LoggerLayoutPattern("%m")) {
        open();
    }

    processEventImpl(int type, auto params) {
        if (type == EVENT_LOG) {
            messages.push(params);
        }
    }
}

