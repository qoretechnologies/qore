        #! The client's initial PTO: a recovery faster than this did not wait for a retransmission
        const ClientInitialPtoMs = 900;
    }

    #! True when running under valgrind, which makes the client's timers too slow for latency assertions
    private bool underValgrind() {
        return is_file("/proc/self/maps") && ReadOnlyFile::readTextFile("/proc/self/maps") =~ /valgrind|vgpreload/;
    }

    constructor() : Test("Http3LostFirstInitialTest", "1.0") {
        addTestCase("lost first datagram: the server answers with Retry", \testLostFirst());
        addTestCase("lost first datagram after the Retry: the validated client is buffered", \testLostAfterRetry());
        addTestCase("every datagram of a request is delivered after a lost first datagram", \testBody());
        addTestCase("a cancelled unanswered request logs its transport state without the query",
            \testStallDiagnostic());
        addTestCase("without a global async I/O logger the diagnostic goes to the controller's logger",
            \testStallDiagnosticControllerLogger());
        addTestCase("QORE_QUIC_STALL_TRACE logs the connection's last ngtcp2 events with the diagnostic",
            \testStallTrace());
        set_return_value(main());
    }

    globalSetUp() {
        Logger logger("h3-lost-initial", LoggerLevel::getLevelWarn());
        mServer = new HttpServer(<HttpServerOptionInfo>{"logger": logger, "debug": False});
        mServer.setHandler("ping", "/ping", NOTHING, new PingHandler());
        mStall = new StallHandler();
        mServer.setHandler("stall", "/stall", NOTHING, mStall);
        mServer.waitForAsyncIo();
        hash<auto> info = mServer.addQuicListener(<HttpListenerOptionInfo>{
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        });
        mServer.waitForAsyncIo();
        mUrl = sprintf("https://127.0.0.1:%d", info.port);
    }

    globalTearDown() {
        if (mStall) {
            mStall.release.send(True);
        }
        if (mServer) {
            mServer.stop();
        }
    }

    #! A new HTTP/3 client, so each request opens a new QUIC connection
    private RestClientIo client(timeout connect_timeout = 5s) {
        return new RestClientIo({"url": mUrl, "protocol": "h3", "ssl_verify_cert": False, "data": "json",
            "timeout": 10s, "connect_timeout": connect_timeout});
    }

    #! Skips unless the build drops datagrams for QORE_QUIC_TEST_DROP_CLIENT_DATAGRAMS (DEBUG builds)
    private checkDropHook() {
        setenv("QORE_QUIC_TEST_DROP_CLIENT_DATAGRAMS", (foldl $1 + "," + $2, (map string($1), xrange(64))));
        on_exit unsetenv("QORE_QUIC_TEST_DROP_CLIENT_DATAGRAMS");
        try {
            client(500ms).restGet("/ping");
        } catch (hash<ExceptionInfo> ex) {
            # every client datagram was dropped: the hook is active
            return;
        }
        testSkip("QORE_QUIC_TEST_DROP_CLIENT_DATAGRAMS needs a DEBUG build");
    }

    #! Returns the time in ms for one request on a new connection
    private int timedRequest() {
        int t0 = clock_get_monotonic_us();
        hash<auto> resp = client().restGet("/ping");
        assertEq(200, resp.status_code);
        assertTrue(resp.body.ok);
        return (clock_get_monotonic_us() - t0) / 1000;
    }

    testLostFirst() {
        checkDropHook();
        setenv("QORE_QUIC_TEST_DROP_CLIENT_DATAGRAMS", "0");
        on_exit unsetenv("QORE_QUIC_TEST_DROP_CLIENT_DATAGRAMS");
        for (int i = 0; i < 3; ++i) {
            # the Retry answers the second datagram at once; a silent drop would cost a PTO and a
            # CONNECTION_CLOSE fails the request
            int ms = timedRequest();
            if (!underValgrind()) {
                assertLt(ClientInitialPtoMs, ms, "recovered by the Retry, not a retransmission");
            }
        }
    }

    testLostAfterRetry() {
        checkDropHook();
        # 0: the first datagram of the first flight; 2: the first datagram of the flight answering the Retry
        setenv("QORE_QUIC_TEST_DROP_CLIENT_DATAGRAMS", "0,2");
        on_exit unsetenv("QORE_QUIC_TEST_DROP_CLIENT_DATAGRAMS");
        # the server buffers the validated client's out-of-order ClientHello; the client's PTO resends the
        # lost part
        assertLt(5000, timedRequest());
    }

    testBody() {
        checkDropHook();
        setenv("QORE_QUIC_TEST_DROP_CLIENT_DATAGRAMS", "0");
        on_exit unsetenv("QORE_QUIC_TEST_DROP_CLIENT_DATAGRAMS");
        RestClientIo rc = client();
        for (int i = 0; i < 5; ++i) {
            hash<auto> resp = rc.restPost("/ping", {"n": i, "pad": strmul("x", 3000)});
            assertEq(200, resp.status_code);
        }
    }

    testStallDiagnostic() {
        Logger logger("h3-diag", LoggerLevel::getLevelWarn());
        CaptureAppender capture();
        logger.addAppender(capture);
        set_async_io_logger(logger);
        on_exit set_async_io_logger();
        checkStallDiagnostic(capture);
    }

    #! An application that only sets the controller's logger (as HttpServer and Qorus do) gets the diagnostic
    testStallDiagnosticControllerLogger() {
        Logger logger("h3-diag-ctrl", LoggerLevel::getLevelWarn());
        CaptureAppender capture();
        logger.addAppender(capture);
        set_async_io_logger();
        AsyncIoController::setLogger(logger);
        on_exit AsyncIoController::setLogger();
        checkStallDiagnostic(capture);
    }

    testStallTrace() {
        Logger logger("h3-trace", LoggerLevel::getLevelWarn());
        CaptureAppender capture();
        logger.addAppender(capture);
        set_async_io_logger(logger);
        on_exit set_async_io_logger();
        setenv("QORE_QUIC_STALL_TRACE", "40");
        on_exit unsetenv("QORE_QUIC_STALL_TRACE");
        list<string> lines = checkStallDiagnostic(capture);
        *string trace = (select lines, $1 =~ /^QUIC: last [0-9]+ ngtcp2 events of session/)[0];
        assertTrue(exists trace, sprintf("trace logged: %y", lines));
        assertRegex("^QUIC: last 40 ngtcp2 events", trace, "the ring keeps the configured number of lines");
        assertRegex("pkt (tx|rx)", trace);
    }

    private list<string> checkStallDiagnostic(CaptureAppender capture) {
        RestClientIo rc({"url": mUrl, "protocol": "h3", "ssl_verify_cert": False, "data": "json",
            "timeout": 1s});
        assertThrows("HTTPCLIENT-TIMEOUT", \rc.restGet(), ("/stall?apikey=secret-value",));
        mStall.release.send(True);
        list<string> lines = ();
        while (capture.messages.size()) {
            auto m = capture.messages.get();
            lines += m.typeCode() == NT_STRING ? m : sprintf("%y", m);
        }
        *string line = (select lines, $1 =~ /cancelling unanswered client stream/)[0];
        assertTrue(exists line, sprintf("diagnostic logged: %y", lines));
        assertRegex("\\(GET /stall\\)", line);
        assertRegex("handshake_complete=1", line);
        assertRegex("pkt_recv=[0-9]+", line);
        # the request left and the peer acknowledged it: the server, not the transport, did not answer
        assertRegex("req_tx=[1-9][0-9]* req_acked=[1-9][0-9]* fin_written=1", line);
        assertRegex("last_write=[0-9]+ ms ago", line);
        assertFalse(line =~ /secret-value/, "the query string is not logged");
        return lines;
    }
}
