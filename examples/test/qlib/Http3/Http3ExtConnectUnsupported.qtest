    }

    private {
        Logger logger;
        LogCapture log_capture();
    }

    constructor() : QUnit::Test("Http3ExtConnectUnsupportedTest", "1.0") {
        logger = new Logger("h3-ext-connect-unsupported-test", LoggerLevel::getLevelInfo());
        logger.addAppender(log_capture);
        addTestCase("HTTPClient: not sent to a server without the setting", \httpClientTest());
        addTestCase("WebSocketClient: not sent and not retried", \webSocketClientTest());
        addTestCase("HTTPClient: sent to a server with the setting", \supportedTest());
        set_return_value(main());
    }

    globalSetUp() {
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }
    }

    #! sendHttp3Connect() raises HTTP3-EXTENDED-CONNECT-UNSUPPORTED; the connection still answers other requests
    httpClientTest() {
        hash<auto> srv = startServer(False);
        on_exit delete srv.server;
        CountingHandler handler = srv.handler;

        HTTPClient client = getClient(srv.port);
        assertThrows("HTTP3-EXTENDED-CONNECT-UNSUPPORTED", "SETTINGS_ENABLE_CONNECT_PROTOCOL",
            \client.sendHttp3Connect(), ("/tunnel", NOTHING, "bidi-stream"));
        assertEq(0, handler.connects.getCount(), "the server got no extended CONNECT");

        # the connection is open: an ordinary request is answered
        hash<auto> info;
        string body = client.get("/page", NOTHING, \info);
        assertEq("page", body, "an ordinary request on the same client");
        assertEq(1, handler.requests.getCount(), "the server got the ordinary request");
    }

    #! a WebSocket connection over HTTP/3 fails with HTTP3-EXTENDED-CONNECT-UNSUPPORTED at once, without retries
    webSocketClientTest() {
        hash<auto> srv = startServer(False);
        on_exit delete srv.server;
        CountingHandler handler = srv.handler;

        WebSocketClient wsc(sub (*data msg) {}, {
            "url": "wss://127.0.0.1:" + srv.port,
            "logger": logger,
            "http3_mode": "required",
            "ssl_verify_cert": False,
            "timeout": 10s,
            "connect_timeout": 10s,
        });
        on_exit {
            try {
                wsc.disconnect();
            } catch () {
            }
        }
        log_capture.takeMessages();
        assertThrows("HTTP3-EXTENDED-CONNECT-UNSUPPORTED", "SETTINGS_ENABLE_CONNECT_PROTOCOL", \wsc.connect());
        list<string> retries = select log_capture.takeMessages(), $1 =~ /retrying on a fresh connection/;
        assertEq((), retries, "the refusal is not retried as a connection error");
        assertEq(0, handler.connects.getCount(), "the server got no extended CONNECT");
    }

    #! with the setting, the extended CONNECT is sent and answered
    supportedTest() {
        hash<auto> srv = startServer(True);
        on_exit delete srv.server;
        CountingHandler handler = srv.handler;

        HTTPClient client = getClient(srv.port);
        hash<auto> resp = client.sendHttp3Connect("/tunnel", NOTHING, "bidi-stream");
        assertEq(200, resp.status_code, "the server answered the extended CONNECT");
        assertEq(1, handler.connects.getCount(), "the server got the extended CONNECT");
        client.sendHttp3StreamData(resp.stream_id, NOTHING, True);
    }

    #! starts a server with an HTTP/3 listener; ext_connect False turns off extended CONNECT for its HTTP/3 sessions
    private hash<auto> startServer(bool ext_connect) {
        NoExtConnectHttpServer server(<HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        });
        on_error delete server;
        CountingHandler handler();
        server.setHandler("counting", "", NOTHING, handler);
        server.setDefaultHandler("counting", handler);
        server.waitForAsyncIo();

        hash<auto> h3info = server.addListener(<HttpListenerOptionInfo>{
            "node": "127.0.0.1",
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
            "enable_h3": True,
        });
        server.waitForAsyncIo();
        if (!ext_connect) {
            # before any client connects: the setting is read when a session is created
            assertEq(1, server.disableH3ExtendedConnect(), "the listener has one QUIC socket");
        }
        return {
            "server": server,
            "handler": handler,
            "port": h3info.port,
        };
    }

    #! returns an HTTP/3 client for the given port
    private HTTPClient getClient(int port) {
        return new HTTPClient({
            "url": sprintf("https://127.0.0.1:%d", port),
            "http3_mode": "required",
            "timeout": 10s,
            "connect_timeout": 10s,
            "ssl_verify_cert": False,
        });
    }
}

#! keeps the messages that the code under test logs
class LogCapture inherits LoggerAppenderWithLayout {
    private {
        list<string> messages;
        Mutex lck();
    }

    constructor() : LoggerAppenderWithLayout("capture", new LoggerLayoutPattern("%m")) {
        open();
    }

    #! returns the messages logged so far and forgets them
    list<string> takeMessages() {
        lck.lock();
        on_exit lck.unlock();
        list<string> rv = messages;
        messages = ();
        return rv;
    }

    processEventImpl(int type, auto params) {
        if (type == EVENT_LOG) {
            lck.lock();
            on_exit lck.unlock();
            messages += params;
        }
    }
}
