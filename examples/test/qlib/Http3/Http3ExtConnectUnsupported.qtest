%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Mime
%requires Logger
%requires HttpServerUtil
%requires HttpServer
%requires WebSocketUtil
%requires WebSocketHandler
%requires WebSocketClient

%exec-class Http3ExtConnectUnsupportedTest

#! an HTTP server whose HTTP/3 sessions do not advertise SETTINGS_ENABLE_CONNECT_PROTOCOL (RFC 9220)
class NoExtConnectHttpServer inherits HttpServer {
    constructor(hash<HttpServerOptionInfo> opts) : HttpServer(opts) {
    }

    #! turns off extended CONNECT for the sessions that the QUIC sockets of the listeners create from now on
    /** @return the number of QUIC sockets
    */
    int disableH3ExtendedConnect() {
        fast_routes_lock.lock();
        on_exit fast_routes_lock.unlock();
        foreach Socket sock in (quic_udp_sockets.iterator()) {
            sock.setHttp3ConnectProtocolEnabled(False);
        }
        return quic_udp_sockets.size();
    }
}

#! counts the requests that reach it and answers extended CONNECT with a tunnel, any other request with a page
class CountingHandler inherits AbstractHttpSocketHandler {
    public {
        Counter connects();
        Counter requests();
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        if (is_extended_connect(cx, hdr)) {
            connects.inc();
            return <HttpResponseInfo>{
                "code": 200,
                "streaming": True,
            };
        }
        requests.inc();
        return makeResponse(200, "page");
    }

    #! echoes the data of a tunnel until the client ends its stream, then ends the stream
    private bool startImpl(softstring lid, hash<auto> cx, hash<auto> hdr, Socket s) {
        Queue stream_data_queue = cx."header-info".stream_data_queue;
        code send = cx."header-info".send_stream_data;
        while (True) {
            auto chunk = stream_data_queue.get(10s);
            if (!exists chunk) {
                break;
            }
            send(chunk);
        }
        send(NOTHING, True);
        return False;
    }
}

#! an HTTP/3 client does not send an extended CONNECT to a server that does not support it (issue #5678)
/** A client must not send a request with the :protocol pseudo-header unless the server's SETTINGS advertised
    SETTINGS_ENABLE_CONNECT_PROTOCOL (RFC 9220 section 3, RFC 8441 section 4).  The HTTP/3 client sent it regardless;
    now an HTTP/3 connection reports ready only after the server's SETTINGS, as an HTTP/2 connection does, and an
    extended CONNECT to a server without the setting fails with HTTP3-EXTENDED-CONNECT-UNSUPPORTED before the request
    is sent, which callers do not retry on a fresh connection.
*/
