    private {
        Logger logger;
        LogCapture log_capture();
        #! values given to the DEBUG hook QORE_QUIC_TEST_IDLE_CLOSE_AT_SUBMIT
        int hook_values;
    }

    constructor() : QUnit::Test("Http3ExtConnectUnsupportedTest", "1.0") {
        logger = new Logger("h3-ext-connect-unsupported-test", LoggerLevel::getLevelInfo());
        logger.addAppender(log_capture);
        addTestCase("HTTPClient: not sent to a server without the setting", \httpClientTest());
        addTestCase("WebSocketClient: not sent and not retried", \webSocketClientTest());
        addTestCase("HTTPClient: sent to a server with the setting", \supportedTest());
        addTestCase("HTTPClient: an extended CONNECT waits for the SETTINGS", \settingsWaitTest());
        addTestCase("HTTPClient: unsupported when the awaited SETTINGS arrive", \settingsWaitUnsupportedTest());
        addTestCase("HTTPClient and WebSocketClient: the SETTINGS do not arrive in time", \settingsTimeoutTest());
        addTestCase("Socket: waitForQuicSettings() and extended CONNECT", \socketSettingsTest());
        addTestCase("Socket: a closed connection is reported before a missing setting", \socketClosedGateTest());
        addTestCase("Socket: a close ends waitForQuicSettings()", \socketCloseWakesTest());
        addTestCase("Socket: submitQuicRequest() refuses :protocol", \socketNonStreamingProtocolTest());
        addTestCase("Socket: a cancelled waitForQuicSettings() raises THREAD-CANCELLED", \socketCancelTest());
        addTestCase("HTTPClient: a cancelled wait without a connect timeout raises THREAD-CANCELLED",
            \httpClientCancelTest());
        addTestCase("HTTPClient: a peer close while waiting gives HTTP3-PEER-CLOSE", \peerCloseWhileWaitingTest());
        addTestCase("HTTPClient: an idle close while waiting gives HTTP3-IDLE-CLOSE", \idleCloseWhileWaitingTest());
        addTestCase("WebSocketClient: connects over HTTP/3 once the awaited SETTINGS arrive",
            \webSocketSettingsWaitTest());
        set_return_value(main());
    }

    globalSetUp() {
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }
    }

    #! sendHttp3Connect() raises HTTP3-EXTENDED-CONNECT-UNSUPPORTED; the connection still answers other requests
    httpClientTest() {
        hash<auto> srv = startServer(False);
        on_exit delete srv.server;
        CountingHandler handler = srv.handler;

        HTTPClient client = getClient(srv.port);
        assertThrows("HTTP3-EXTENDED-CONNECT-UNSUPPORTED", "SETTINGS_ENABLE_CONNECT_PROTOCOL",
            \client.sendHttp3Connect(), ("/tunnel", NOTHING, "bidi-stream"));
        assertEq(0, handler.connects.getCount(), "the server got no extended CONNECT");

        # the connection is open: an ordinary request is answered
        hash<auto> info;
        string body = client.get("/page", NOTHING, \info);
        assertEq("page", body, "an ordinary request on the same client");
        assertEq(1, handler.requests.getCount(), "the server got the ordinary request");
    }

    #! a WebSocket connection over HTTP/3 fails with HTTP3-EXTENDED-CONNECT-UNSUPPORTED at once, without retries
    webSocketClientTest() {
        hash<auto> srv = startServer(False);
        on_exit delete srv.server;
        CountingHandler handler = srv.handler;

        WebSocketClient wsc(sub (*data msg) {}, {
            "url": "wss://127.0.0.1:" + srv.port,
            "logger": logger,
            "http3_mode": "required",
            "ssl_verify_cert": False,
            "timeout": 10s,
            "connect_timeout": 10s,
        });
        on_exit {
            try {
                wsc.disconnect();
            } catch () {
            }
        }
        log_capture.takeMessages();
        assertThrows("HTTP3-EXTENDED-CONNECT-UNSUPPORTED", "SETTINGS_ENABLE_CONNECT_PROTOCOL", \wsc.connect());
        list<string> retries = select log_capture.takeMessages(), $1 =~ /retrying on a fresh connection/;
        assertEq((), retries, "the refusal is not retried as a connection error");
        assertEq(0, handler.connects.getCount(), "the server got no extended CONNECT");
    }

    #! with the setting, the extended CONNECT is sent and answered
    supportedTest() {
        hash<auto> srv = startServer(True);
        on_exit delete srv.server;
        CountingHandler handler = srv.handler;

        HTTPClient client = getClient(srv.port);
        hash<auto> resp = client.sendHttp3Connect("/tunnel", NOTHING, "bidi-stream");
        assertEq(200, resp.status_code, "the server answered the extended CONNECT");
        assertEq(1, handler.connects.getCount(), "the server got the extended CONNECT");
        client.sendHttp3StreamData(resp.stream_id, NOTHING, True);
    }

    #! an extended CONNECT waits for the server's SETTINGS; an ordinary request does not
    settingsWaitTest() {
        checkDebugHooks();
        hash<auto> srv = startServer(True);
        on_exit delete srv.server;
        CountingHandler handler = srv.handler;

        holdSettings();
        on_exit releaseSettings();
        HTTPClient client = getClient(srv.port);
        # the connection is ready at the end of the handshake: an ordinary request does not wait for the SETTINGS
        assertEq("page", client.get("/page"), "an ordinary request is answered while the SETTINGS are held");
        assertEq(1, call_function("dbg_quic_held_client_settings"), "the server's SETTINGS arrived and are held");

        Queue result();
        background connectInBackground(client, result);
        assertTrue(call_function("dbg_quic_wait_settings_waiters", 1, 20s),
            "the extended CONNECT waits for the server's SETTINGS");
        assertEq(0, handler.connects.getCount(), "the server got no extended CONNECT before the SETTINGS");
        releaseSettings();
        auto rv = result.get(20s);
        if (rv.typeCode() == NT_HASH && rv.err) {
            fail(sprintf("sendHttp3Connect() failed: %s: %s", rv.err, rv.desc));
        }
        assertEq(200, rv.status_code, "the extended CONNECT is answered once the SETTINGS arrived");
        assertEq(1, handler.connects.getCount(), "the server got the extended CONNECT");
        client.sendHttp3StreamData(rv.stream_id, NOTHING, True);
    }

    #! the SETTINGS that arrive after the wait began do not advertise extended CONNECT: it is not sent
    settingsWaitUnsupportedTest() {
        checkDebugHooks();
        hash<auto> srv = startServer(False);
        on_exit delete srv.server;
        CountingHandler handler = srv.handler;

        holdSettings();
        on_exit releaseSettings();
        HTTPClient client = getClient(srv.port);
        assertEq("page", client.get("/page"), "an ordinary request is answered while the SETTINGS are held");

        Queue result();
        background connectInBackground(client, result);
        assertTrue(call_function("dbg_quic_wait_settings_waiters", 1, 20s),
            "the extended CONNECT waits for the server's SETTINGS");
        releaseSettings();
        auto rv = result.get(20s);
        assertEq("HTTP3-EXTENDED-CONNECT-UNSUPPORTED", rv.err, "the awaited SETTINGS refuse the extended CONNECT");
        assertEq(0, handler.connects.getCount(), "the server got no extended CONNECT");
    }

    #! the SETTINGS do not arrive within the connect timeout: HTTP3-EXTENDED-CONNECT-ERROR, at the connect deadline
    settingsTimeoutTest() {
        checkDebugHooks();
        hash<auto> srv = startServer(True);
        on_exit delete srv.server;
        CountingHandler handler = srv.handler;

        holdSettings();
        on_exit releaseSettings();

        HTTPClient client = getClient(srv.port, ShortConnectTimeout);
        date start = now_us();
        assertThrows("HTTP3-EXTENDED-CONNECT-ERROR", "did not arrive within the connect timeout",
            \client.sendHttp3Connect(), ("/tunnel", NOTHING, "bidi-stream"));
        timeout elapsed = (now_us() - start).durationMilliseconds();
        # the deadline is the start of the connection, made in the call, plus the connect timeout
        assertTrue(elapsed >= ShortConnectTimeout, sprintf("the wait ends at the connect deadline (%d ms)", elapsed));
        assertTrue(elapsed < ShortConnectTimeout + 15000, sprintf("the wait ends at the connect deadline (%d ms)",
            elapsed));
        assertEq(0, handler.connects.getCount(), "the server got no extended CONNECT");

        WebSocketClient wsc(sub (*data msg) {}, {
            "url": "wss://127.0.0.1:" + srv.port,
            "logger": logger,
            "http3_mode": "required",
            "ssl_verify_cert": False,
            "timeout": 10s,
            "connect_timeout": ShortConnectTimeout,
        });
        on_exit {
            try {
                wsc.disconnect();
            } catch () {
            }
        }
        log_capture.takeMessages();
        assertThrows("HTTP3-EXTENDED-CONNECT-ERROR", "did not arrive within the connect timeout", \wsc.connect());
        list<string> retries = select log_capture.takeMessages(), $1 =~ /retrying on a fresh connection/;
        assertEq((), retries, "the timeout is not retried as a connection error");
        assertEq(0, handler.connects.getCount(), "the server got no extended CONNECT");
    }

    #! Socket::waitForQuicSettings() before an extended CONNECT made directly on a QUIC socket
    socketSettingsTest() {
        checkDebugHooks();
        hash<auto> srv = startServer(True);
        on_exit delete srv.server;
        CountingHandler handler = srv.handler;

        holdSettings();
        on_exit releaseSettings();
        HttpClientConnectionManager mgr = getManager();
        on_exit mgr.closeAll();
        Socket sock = openConnection(mgr, srv.port);

        assertFalse(sock.waitForQuicSettings(0), "the SETTINGS have not been received while they are held");
        assertThrows("HTTP3-EXTENDED-CONNECT-ERROR", "have not been received yet",
            \sock.submitQuicRequestStreaming(), ("CONNECT", "/tunnel", connectHeaders(srv.port)));

        Queue result();
        background sub () {
            try {
                result.push(sock.waitForQuicSettings());
            } catch (hash<ExceptionInfo> ex) {
                result.push(ex);
            }
        }();
        assertTrue(call_function("dbg_quic_wait_settings_waiters", 1, 20s), "waitForQuicSettings() waits");
        releaseSettings();
        assertEq(True, result.get(20s), "waitForQuicSettings() returns True when the SETTINGS arrive");
        assertTrue(sock.waitForQuicSettings(0), "the SETTINGS have been received");

        int stream_id = sock.submitQuicRequestStreaming("CONNECT", "/tunnel", connectHeaders(srv.port));
        assertTrue(stream_id >= 0, "the extended CONNECT is submitted");
        handler.first_connect.waitForZero(20s);
        assertEq(1, handler.connects.getCount(), "the server got the extended CONNECT");
    }

    #! a request on a closed connection gets the error of the close, which callers retry, not the missing SETTINGS
    socketClosedGateTest() {
        checkDebugHooks();
        hash<auto> srv = startServer(True);
        on_exit delete srv.server;
        CountingHandler handler = srv.handler;

        holdSettings();
        on_exit releaseSettings();
        HttpClientConnectionManager mgr = getManager();
        on_exit mgr.closeAll();
        Socket sock = openConnection(mgr, srv.port);

        # the DEBUG hook idle-closes the connection at the next submit, as if its idle timer had expired
        setenv(IdleCloseHookVar, sprintf("%d-%d", getpid(), ++hook_values));
        on_exit unsetenv(IdleCloseHookVar);
        assertThrows("HTTP3-IDLE-CLOSE", "the request was not sent",
            \sock.submitQuicRequestStreaming(), ("CONNECT", "/tunnel", connectHeaders(srv.port)));
        assertEq(0, handler.connects.getCount(), "the server got no extended CONNECT");
    }

    #! a thread waiting for the SETTINGS is woken when the socket is closed
    socketCloseWakesTest() {
        checkDebugHooks();
        hash<auto> srv = startServer(True);
        on_exit delete srv.server;

        holdSettings();
        on_exit releaseSettings();
        HttpClientConnectionManager mgr = getManager();
        on_exit mgr.closeAll();
        Socket sock = openConnection(mgr, srv.port);

        Queue result();
        background sub () {
            try {
                result.push(sock.waitForQuicSettings());
            } catch (hash<ExceptionInfo> ex) {
                result.push(ex);
            }
        }();
        assertTrue(call_function("dbg_quic_wait_settings_waiters", 1, 20s), "waitForQuicSettings() waits");
        mgr.closeAll();
        auto rv = result.get(20s);
        assertEq("HTTP3-LOCAL-CLOSE", rv.err, "the close ends the wait with the error of the close");
    }

    #! an extended CONNECT is a streaming request: submitQuicRequest() refuses :protocol, as it would drop it
    socketNonStreamingProtocolTest() {
        hash<auto> srv = startServer(True);
        on_exit delete srv.server;
        CountingHandler handler = srv.handler;

        HttpClientConnectionManager mgr = getManager();
        on_exit mgr.closeAll();
        Socket sock = openConnection(mgr, srv.port);
        assertThrows("HTTP3-REQUEST-ERROR", "must be made as a streaming request",
            \sock.submitQuicRequest(), ("CONNECT", "/tunnel", connectHeaders(srv.port)));
        assertEq(0, handler.connects.getCount(), "the server got no request");
    }

    #! a thread waiting in Socket::waitForQuicSettings() is cancelled: THREAD-CANCELLED (not only the release)
    socketCancelTest() {
        checkDebugHooks();
        hash<auto> srv = startServer(True);
        on_exit delete srv.server;

        holdSettings();
        on_exit releaseSettings();
        HttpClientConnectionManager mgr = getManager();
        on_exit mgr.closeAll();
        Socket sock = openConnection(mgr, srv.port);

        Queue result();
        int tid = background sub () {
            try {
                result.push(sock.waitForQuicSettings());
            } catch (hash<ExceptionInfo> ex) {
                result.push(ex);
            }
        }();
        assertTrue(call_function("dbg_quic_wait_settings_waiters", 1, 20s), "waitForQuicSettings() waits");
        cancel_thread(tid, "settings wait test");
        auto rv = result.get(20s);
        assertEq("THREAD-CANCELLED", rv.err, "the cancellation ends the wait");
    }

    #! an extended CONNECT without a connect timeout waits with no deadline: a cancellation ends it
    httpClientCancelTest() {
        checkDebugHooks();
        hash<auto> srv = startServer(True);
        on_exit delete srv.server;
        CountingHandler handler = srv.handler;

        holdSettings();
        on_exit releaseSettings();
        HTTPClient client = getClient(srv.port, -1);
        assertEq("page", client.get("/page"), "an ordinary request is answered while the SETTINGS are held");

        Queue result();
        int tid = background connectInBackground(client, result);
        assertTrue(call_function("dbg_quic_wait_settings_waiters", 1, 20s),
            "the extended CONNECT waits for the server's SETTINGS");
        cancel_thread(tid, "settings wait test");
        auto rv = result.get(20s);
        assertEq("THREAD-CANCELLED", rv.err, "the cancellation ends the wait");
        assertEq(0, handler.connects.getCount(), "the server got no extended CONNECT");
    }

    #! the server closes the connection while an extended CONNECT waits: the error of the close, which callers retry
    peerCloseWhileWaitingTest() {
        checkDebugHooks();
        hash<auto> srv = startServer(True);
        on_exit delete srv.server;

        holdSettings();
        on_exit releaseSettings();
        HTTPClient client = getClient(srv.port);
        assertEq("page", client.get("/page"), "an ordinary request is answered while the SETTINGS are held");

        Queue result();
        background connectInBackground(client, result);
        assertTrue(call_function("dbg_quic_wait_settings_waiters", 1, 20s),
            "the extended CONNECT waits for the server's SETTINGS");
        delete srv.server;
        auto rv = result.get(20s);
        assertEq("HTTP3-PEER-CLOSE", rv.err, "the close ends the wait with the error of the close");
    }

    #! the connection is closed by its idle timer while an extended CONNECT waits: HTTP3-IDLE-CLOSE
    idleCloseWhileWaitingTest() {
        checkDebugHooks();
        hash<auto> srv = startServer(True);
        on_exit delete srv.server;

        holdSettings();
        on_exit releaseSettings();
        HTTPClient client = getClient(srv.port);
        assertEq("page", client.get("/page"), "an ordinary request is answered while the SETTINGS are held");

        Queue result();
        background connectInBackground(client, result);
        assertTrue(call_function("dbg_quic_wait_settings_waiters", 1, 20s),
            "the extended CONNECT waits for the server's SETTINGS");
        assertEq(1, call_function("dbg_quic_idle_close_held_client_sessions"), "the waiting session is idle-closed");
        auto rv = result.get(20s);
        assertEq("HTTP3-IDLE-CLOSE", rv.err, "the idle close ends the wait with the error of the close");
    }

    #! a WebSocket connection over HTTP/3 waits for the server's SETTINGS and connects when they arrive
    webSocketSettingsWaitTest() {
        checkDebugHooks();
        hash<auto> srv = startServer(True);
        on_exit delete srv.server;
        CountingHandler handler = srv.handler;

        holdSettings();
        on_exit releaseSettings();
        WebSocketClient wsc(sub (*data msg) {}, {
            "url": "wss://127.0.0.1:" + srv.port,
            "logger": logger,
            "http3_mode": "required",
            "ssl_verify_cert": False,
            "timeout": 20s,
            "connect_timeout": 20s,
        });
        on_exit {
            try {
                wsc.disconnect();
            } catch () {
            }
        }
        Queue result();
        background sub () {
            try {
                result.push(wsc.connect());
            } catch (hash<ExceptionInfo> ex) {
                result.push(ex);
            }
        }();
        assertTrue(call_function("dbg_quic_wait_settings_waiters", 1, 20s),
            "the WebSocket handshake waits for the server's SETTINGS");
        assertEq(0, handler.connects.getCount(), "the server got no extended CONNECT before the SETTINGS");
        releaseSettings();
        auto rv = result.get(20s);
        if (rv.typeCode() == NT_HASH && rv.err) {
            fail(sprintf("connect() failed: %s: %s", rv.err, rv.desc));
        }
        assertTrue(wsc.isHttp3(), "the WebSocket connection is over HTTP/3");
        assertEq(1, handler.connects.getCount(), "the server got the extended CONNECT");
    }

    #! skips the case in a build without the DEBUG test hooks
    private checkDebugHooks() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("the QUIC SETTINGS test hooks are only available in a library-debug build");
        }
    }

    #! holds the server's SETTINGS back from the client sessions created from now on
    private holdSettings() {
        call_function("dbg_quic_hold_client_settings", True);
    }

    #! releases the held SETTINGS, which the client sessions record as they were received
    private releaseSettings() {
        if (Option::HAVE_LIBRARY_DEBUGGING) {
            call_function("dbg_quic_hold_client_settings", False);
        }
    }

    #! sends an extended CONNECT with the client and pushes the response or the exception to the queue; returns at
    #! once in the thread that runs it
    private connectInBackground(HTTPClient client, Queue result) {
        try {
            result.push(client.sendHttp3Connect("/tunnel", NOTHING, "bidi-stream"));
        } catch (hash<ExceptionInfo> ex) {
            result.push(ex);
        }
    }

    #! an HTTP/3 connection manager
    private HttpClientConnectionManager getManager() {
        return new HttpClientConnectionManager(<HttpClientConnectionManagerOptions>{
            "protocol": "h3",
            "accept_all_certs": True,
            "connect_timeout": 20s,
            "request_timeout": 20s,
        });
    }

    #! opens an HTTP/3 connection with an ordinary request and returns its socket
    private Socket openConnection(HttpClientConnectionManager mgr, int port) {
        HttpClientStreamHandle stream = mgr.acquireAndStartStreaming(sprintf("https://127.0.0.1:%d", port), "GET",
            "/page", NOTHING, False);
        on_exit stream.cancel();
        while (True) {
            auto chunk = stream.readData(20s);
            if (!exists chunk) {
                fail("no response data within 20s");
            }
            if (chunk.typeCode() == NT_HASH) {
                if (chunk.error) {
                    fail(sprintf("the response failed: %y", chunk.error));
                }
                if (chunk.end_stream) {
                    break;
                }
            }
        }
        return stream.getConnection().getSocket();
    }

    #! the headers of an extended CONNECT made directly on a QUIC socket
    private hash<auto> connectHeaders(int port) {
        return {
            ":protocol": "bidi-stream",
            "host": sprintf("127.0.0.1:%d", port),
        };
    }

    #! starts a server with an HTTP/3 listener; ext_connect False turns off extended CONNECT for its HTTP/3 sessions
    private hash<auto> startServer(bool ext_connect) {
        NoExtConnectHttpServer server(<HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        });
        on_error delete server;
        CountingHandler handler();
        server.setHandler("counting", "", NOTHING, handler);
        server.setDefaultHandler("counting", handler);
        server.waitForAsyncIo();

        hash<auto> h3info = server.addListener(<HttpListenerOptionInfo>{
            "node": "127.0.0.1",
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
            "enable_h3": True,
        });
        server.waitForAsyncIo();
        if (!ext_connect) {
            # before any client connects: the setting is read when a session is created
            assertEq(1, server.disableH3ExtendedConnect(), "the listener has one QUIC socket");
        }
        return {
            "server": server,
            "handler": handler,
            "port": h3info.port,
        };
    }

    #! returns an HTTP/3 client for the given port
    private HTTPClient getClient(int port, timeout connect_timeout = 10s) {
        return new HTTPClient({
            "url": sprintf("https://127.0.0.1:%d", port),
            "http3_mode": "required",
            "timeout": 10s,
            "connect_timeout": connect_timeout,
            "ssl_verify_cert": False,
        });
    }
}

#! keeps the messages that the code under test logs
class LogCapture inherits LoggerAppenderWithLayout {
    private {
        list<string> messages;
        Mutex lck();
    }

    constructor() : LoggerAppenderWithLayout("capture", new LoggerLayoutPattern("%m")) {
        open();
    }

    #! returns the messages logged so far and forgets them
    list<string> takeMessages() {
        lck.lock();
        on_exit lck.unlock();
        list<string> rv = messages;
        messages = ();
        return rv;
    }

    processEventImpl(int type, auto params) {
        if (type == EVENT_LOG) {
            lck.lock();
            on_exit lck.unlock();
            messages += params;
        }
    }
}
