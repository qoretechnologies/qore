    constructor() : Test("Http3SyncHttpClientBodyTest", "1.0") {
        addTestCase("send: multi-datagram non-chunked body", \testSend());
        addTestCase("sendWithRecvCallback: single dispatch per body", \testSendWithRecvCallback());

        set_return_value(main());
    }

    globalSetUp() {
        mLogger = new Logger("h3-body-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            mLogger.addAppender(new StdoutAppender());
        }

        mServer = new HttpServer(<HttpServerOptionInfo>{
            "logger": mLogger,
            "debug": False,
        });
        mServer.setHandler("body", "/body", NOTHING, new SizedHandler());
        mServer.waitForAsyncIo();

        hash<auto> info = mServer.addQuicListener(<HttpListenerOptionInfo>{
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        });
        mServer.waitForAsyncIo();
        mUrl = sprintf("https://127.0.0.1:%d", info.port);

        if (m_options.verbose > 1) {
            printf("HTTP/3 test server at %s\n", mUrl);
        }
    }

    globalTearDown() {
        if (mServer) {
            try {
                mServer.stop();
            } catch (hash<ExceptionInfo> ex) {
                # ignore
            }
        }
    }

    HTTPClient newClient() {
        HTTPClient hc({
            "url": mUrl,
            "http_version": "3.0",
            "ssl_verify_cert": False,
            "accept_all_certs": True,
            "error_passthru": True,
        });
        # Long-lived persistent connection: warm up to mirror the production
        # pattern (Qorus's QorusSystemRestHelper) where the QUIC connection
        # is reused across many requests before the large body arrives.
        for (int i = 0; i < 5; ++i) {
            hc.send(NOTHING, "GET", "/body/200/50");
        }
        return hc;
    }

    # Plain HTTPClient.send must round-trip every (status, size) combination
    # — both the success path and the error path that goes through
    # send_internal_conn_mgr's non-streaming branch.
    testSend() {
        HTTPClient hc = newClient();
        hash<auto> hdrs = {"Accept-Encoding": "identity"};
        foreach int code in (StatusCodes) {
            foreach int size in (Sizes) {
                hash<auto> resp = hc.send(NOTHING, "GET",
                    sprintf("/body/%d/%d", code, size), hdrs);
                assertEq(code, resp.status_code,
                    sprintf("code %d size %d: status_code", code, size));
                int rx = resp.body.size();
                assertEq(size, rx,
                    sprintf("code %d size %d: body size (got %d)",
                        code, size, rx));
            }
        }
    }

    # The streaming-recv path used by sendWithRecvCallback must deliver each
    # non-chunked body as exactly ONE data callback regardless of how many
    # QUIC datagrams it spans on the wire — the same contract H1 and H2
    # provide and the same contract DataStreamClient's ds_get_recv assumes
    # for non-chunked transfers.  Pre-fix this test fails: a 16000-byte body
    # arrived as ~12 invocations and the consumer (and ex.arg.body) saw
    # only the last datagram's bytes.
    testSendWithRecvCallback() {
        HTTPClient hc = newClient();
        # Mirror the Accept-Encoding RestClient sends by default.  The bug
        # only shows up when the server actually delivers an uncompressed
        # body (i.e. the response carries no Content-Encoding); the matrix
        # below uses incompressible content so gzip cannot mask it.
        hash<auto> hdrs = {"Accept-Encoding": "gzip"};
        foreach int code in (StatusCodes) {
            foreach int size in (Sizes) {
                int data_calls = 0;
                int total_received = 0;
                binary accumulated = binary();
                bool got_terminator = False;
                code cb = sub (hash<auto> h) {
                    if (h.hasKey("data") && exists h."data") {
                        ++data_calls;
                        if (h."data".typeCode() == NT_STRING) {
                            accumulated += binary(h."data");
                        } else {
                            accumulated += h."data";
                        }
                        total_received = accumulated.size();
                    } else if (h.hasKey("hdr") && !exists h.hdr) {
                        got_terminator = True;
                    }
                };
                hc.sendWithRecvCallback(cb, binary(), "GET",
                    sprintf("/body/%d/%d", code, size), hdrs);
                assertTrue(got_terminator,
                    sprintf("code %d size %d: terminal callback fired", code, size));
                assertEq(size, total_received,
                    sprintf("code %d size %d: total accumulated bytes", code, size));
                # The fix's contract: exactly ONE data callback per
                # non-chunked, non-event-stream body.
                assertEq(1, data_calls,
                    sprintf("code %d size %d: data callback invocations "
                        "(expected one per non-chunked body)", code, size));
            }
        }
    }
}
