    HTTP/3 sync HTTPClient body delivery tests.

    Regression coverage for the bug where the legacy sync HTTPClient
    sendWithRecvCallback path delivered an HTTP/3 non-chunked response in
    multiple per-DATA-frame callback invocations once the body spanned more
    than one QUIC datagram (~1200 bytes).  Consumers that follow the H1/H2
    contract (one recv_callback invocation per non-chunked body) — e.g.
    DataStreamClient's ds_get_recv — overwrote earlier chunks with each
    subsequent invocation and ended up with only the last datagram's bytes.

    The fix accumulates the body in qore_httpclient_priv::send_internal_conn_mgr
    when the response is not chunked and not text/event-stream, then delivers
    it as one recv_callback({"data": ..., "chunked": false}) invocation at
    end_stream — matching H1/H2 semantics and the new HttpClientIo stack.
*/

%modern

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Mime.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/HttpServerUtil.qm
%requires ../../../../qlib/AsyncSocketIo
%requires ../../../../qlib/HttpServerAsyncIo
%requires ../../../../qlib/HttpServer.qm

%exec-class Http3SyncHttpClientBodyTest

class SizedHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        # Path layout: /body/<status>/<size>
        int code = 200;
        int size = 1000;
        *list<*string> m = (hdr.path =~ x/body\/(\d+)\/(\d+)/);
        if (m) {
            code = m[0].toInt();
            size = m[1].toInt();
        }
        # Use random alphanumeric content so gzip cannot compress to under
        # one QUIC datagram and mask the bug.
        string body_str = get_random_string(size);
        # application/octet-stream so the consumer's per-event callback
        # path (DataStreamClient-style) sees a non-chunked, non-event-stream
        # body and exposes the accumulation contract.
        return makeResponse(code, body_str,
            {"Content-Type": "application/octet-stream"});
    }
}

class Http3SyncHttpClientBodyTest inherits QUnit::Test {
    private {
        HttpServer mServer;
        string mUrl;
        Logger mLogger;

        # 9 sizes spanning 1- to many-datagram bodies.  1500/2000/4000/...
        # are reliably multi-datagram (path MTU ~ 1200 bytes).
        const Sizes = (100, 500, 1000, 1500, 1664, 2000, 4000, 8000, 16000);
        # status 200 used for the success path; error_passthru for everything
        # else so we can inspect the raw response uniformly.
        const StatusCodes = (200, 400, 404, 409, 500);

        const CertPem = "-----BEGIN CERTIFICATE-----
