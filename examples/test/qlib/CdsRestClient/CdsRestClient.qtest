#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Mime
%requires MapperUtil
%requires Logger
%requires DataProvider
%requires ConnectionProvider
%requires RestClient
%requires CdsRestClient
%requires CdsRestDataProvider

%requires json

%requires qore >= 0.9

%modern

#! A Dynamics connection whose discovery answers from a fixture rather than from Microsoft
class FakeDynamicsConnection inherits CdsRestClient::DynamicsRestConnection {
    public {
        *hash<auto> discovered;
    }

    constructor(hash<auto> config, *hash<auto> found) : DynamicsRestConnection(config) {
        discovered = found;
    }

    private *hash<auto> discoverInstance(string token) {
        return discovered;
    }

    #! reaches the hook the platform calls when it has exchanged the authorization code
    hash<auto> completeAuthorization(hash<auto> resp) {
        return processOAuth2TokenResponse(resp) ?? {};
    }
}

%exec-class CdsTest

class CdsTest inherits QUnit::Test {
    public {}

    private {
        CdsRestConnection rconn;
        CdsRestClient rc;
        Logger logger;

        # CDS connection options
        hash cdsopts;

        # command-line options
        const MyOpts = Opts + {
            "conn":           "c,connection=s",
            "client_id":      "i,client_id=s",
            "client_secret":  "s,client_secret=s",
            "timeout":        "t,timeout=i",
            "url":            "u,url=s",
        };

        const OptionColumn = 22;

        const AcctNo1 = "DEL_TEST_1";
        const AcctName1 = "My Test Account 1";

        const AcctNo2 = "DEL_TEST_2";
    }

    constructor() : Test("CdsTest", "1.0", \ARGV, MyOpts) {
        addTestCase("poll tests", \pollTests());
        addTestCase("CDS DataProvider test", \CdsDataProviderTests());
        addTestCase("CDS REST", \CdsRestTests());
        addTestCase("connection tests", \connectionTest());
        addTestCase("profile scopes follow the URL", \profileScopeTest());
        addTestCase("no URL is needed to create a connection", \autoUrlDiscoveryTest());
        addTestCase("a discovered environment asks for a second authorization", \reauthorizeTest());

        try {
            setupConnection();
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("%s: %s\n", ex.err, ex.desc);
            }
        }

        Logger logger("test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }

        set_return_value(main());
    }

    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-c,--connection=ARG", "set CDS connection name", OptionColumn);
        printOption("-i,--client_id=ARG", "set CDS consumer key", OptionColumn);
        printOption("-s,--client_secret=ARG", "set CDS consumer secret", OptionColumn);
        printOption("-t,--timeout=ARG", "set CDS timeout in seconds", OptionColumn);
        printOption("-u,--url=ARG", "URL for the CDS instance", OptionColumn);
    }

    setupConnection() {
        *string conn_name = m_options.conn ?? ENV.CDS_CONNECTION;
        if (conn_name) {
            AbstractConnection conn = get_connection(conn_name);
            if (!(conn instanceof CdsRestConnection)) {
                error("connection %y is type %y; expecting \"CdsRestConnection\"", conn_name, conn.className());
            }
            rconn = conn;
            rc = conn.get(False);
            return;
        }
        cdsopts.url = m_options.url ?? ENV.CDS_URL;
        if (!cdsopts.url) {
            error("missing --url or --connection options, CDS_URL or CDS_CONNECTION environment variables");
        }
        cdsopts.oauth2_client_id = m_options.client_id ?? ENV.CDS_CLIENT_ID;
        if (!cdsopts.oauth2_client_id)
            error("missing --client_id option or CDS_CLIENT_ID environment variable");
        cdsopts.oauth2_client_secret = m_options.client_secret ?? ENV.CDS_CLIENT_SECRET;
        if (!cdsopts.oauth2_client_secret)
            error("missing --client_secret option or CDS_CLIENT_SECRET environment variable");
        if (cdsopts."timeout")
            cdsopts.connect_timeout = cdsopts."timeout";

        rc = new CdsRestClient(cdsopts);
    }

    private error(string fmt) {
        throw "OPTION-ERROR", sprintf("%s: ERROR: %s", get_script_name(), vsprintf(fmt, argv));
    }

    CdsDataProviderTests() {
        if (!rc) testSkip("no CDS connection");

        CdsRestTablesDataProvider dp(rc);

        assertFalse(dp.requiresTransactionManagement());
        {
            list<string> children = dp.getChildProviderNames();
            assertEq(Type::List, children.type());
            hash<string, bool> child_map = map {$1: True}, children;
            assertTrue(child_map.account);
        }

        list<hash<auto>> recs;
        {
            AbstractDataProvider account = dp.getChildProvider("account");

            string tel = get_random_string();
            string id;
            {
                # create new account
                hash<auto> rec += {
                    "name": "deleteme",
                    "telephone2": tel,
                };
                id = account.createRecord(rec).accountid;
            }
            on_exit {
                # delete the record
                assertEq(1, account.deleteRecords({"telephone2": tel}));
            }

            # search the record
            recs = map $1, account.searchRecords({"accountid": id}, {"limit": 1});
            assertEq(1, recs.size());
            assertEq(id, recs[0].accountid);

            # update the record
            assertEq(1, account.updateRecords({"name": "deleteme-now"}, {"telephone2": tel}));
        }
    }

    CdsRestTests() {
        if (!rc) testSkip("no CDS connection");

        assertEq(Type::String, rc.getApi().type());

        assertEq(Type::String, rc.getToken().type());

        hash<auto> h = rc.get("");
        assertEq(Type::List, h.body.value.type());

        #rc.logout();
        #assertEq(NOTHING, rc.getToken());
    }

    pollTests() {
        if (!rconn) {
            testSkip("no CdsRestConnection");
        }

        {
            # first test a standard ping
            hash<PingInfo> ping = rconn.ping(True);
            assertTrue(ping.ok);
            assertEq("OK", ping.info);

            TestPollingConnectionMonitor monitor(logger);
            on_exit delete monitor;

            monitor.add(rconn);
            hash<auto> info = monitor.waitForResult();
            on_error if (info.ex) {
                printf("%s\n", get_exception_string(info.ex));
            }
            assertEq("OK", info.result);
        }
    }

    #! A profile scope carries the connection URL, so it has to follow the URL when that changes
    /** The profile declares the scope as "{url}user_impersonation" and the resolved value is stored with
        the connection, so a later URL change leaves the old URL in a scope with no placeholder left to
        substitute.  The authorization request then names the old organisation, and Microsoft answers
        AADSTS500011 - "the resource principal was not found in the tenant" - which says nothing about the
        URL being the reason.
    */
    #! A Dynamics connection is created without a URL and finds its environment from the credential
    /** A Dataverse environment's URL is not knowable before the credential exists - which environments a
        credential reaches is what Microsoft's Global Discovery Service answers - so the connection is
        created against the discovery service and moves to its environment once authorized.
    */
    #! Discovering the environment changes which resource the connection targets, so it asks for another round
    /** The token issued by the first authorization is for the discovery service, and no refresh will move
        it to the environment: an OAuth2 refresh does not name a resource, and asking for another one
        returns the originally granted one anyway - measured against Microsoft's own service.  So the
        connection tells the platform to authorize again, now that there is an environment to name.
    */
    reauthorizeTest() {
        hash<auto> opts = {"oauth2_client_id": "id", "oauth2_client_secret": "secret"};
        hash<auto> found = {"url": "dynamics://contoso.crm17.dynamics.com", "organization": "orgabc"};

        FakeDynamicsConnection c({"name": "d", "desc": "d", "opts": opts}, found);
        hash<auto> rv = c.completeAuthorization({"access_token": "at", "refresh_token": "rt"});
        assertEq("dynamics://contoso.crm17.dynamics.com", rv.url, "the environment is returned as the URL");
        assertEq("orgabc", rv.organization);
        assertTrue(rv{RestConnection::ReauthorizationRequiredOption},
            "and the platform is asked to authorize again against the environment");

        # a connection that already has its environment does not discover again, and does not ask for
        # another authorization: this is what makes a token refresh cost nothing
        FakeDynamicsConnection c2({"name": "d", "desc": "d",
            "url": "dynamics://contoso.crm17.dynamics.com", "opts": opts}, found);
        hash<auto> rv2 = c2.completeAuthorization({"access_token": "at", "refresh_token": "rt"});
        assertNothing(rv2{RestConnection::ReauthorizationRequiredOption},
            "an environment already chosen is left alone");
        assertNothing(rv2.url, "and no URL change is requested");

        # a discovery that finds nothing must not ask for a round that would change nothing
        FakeDynamicsConnection c3({"name": "d", "desc": "d", "opts": opts}, NOTHING);
        hash<auto> rv3 = c3.completeAuthorization({"access_token": "at"});
        assertNothing(rv3{RestConnection::ReauthorizationRequiredOption});
    }

    autoUrlDiscoveryTest() {
        hash<auto> opts = {"oauth2_client_id": "id", "oauth2_client_secret": "secret"};

        # created with no URL at all
        DynamicsRestConnection c({"name": "d", "desc": "d", "opts": opts});
        assertEq(CdsRestClientBase::DefaultUrl, c.url, "the connection targets the discovery service");
        assertTrue(DynamicsRestConnection::ConnectionScheme.auto_url, "and does not ask for a URL");
        assertTrue(CdsRestClientBase::isDiscoveryUrl(c.url));

        # the discovery service is an OAuth2 resource of its own, so the profile's own scope template
        # resolves to exactly the scope the discovery call needs - no special case
        assertEq(("offline_access", "https://globaldisco.crm.dynamics.com/user_impersonation"),
            c.opts.oauth2_scopes, "the scope is the discovery scope while the environment is unknown");

        # one environment: there is nothing to choose
        hash<auto> one = {"value": ({"UniqueName": "orgabc", "UrlName": "contoso",
            "FriendlyName": "Contoso", "Url": "https://contoso.crm17.dynamics.com"},)};
        assertEq({"url": "dynamics://contoso.crm17.dynamics.com", "organization": "orgabc"},
            CdsRestClientBase::getInstanceOptions(one, NOTHING, NOTHING),
            "the URL carries the connection's own scheme, since it is promoted onto the connection");

        # several environments and nothing to say which: choosing one would silently read another
        # company's data, so none is chosen and the connection stays on the discovery service
        hash<auto> many = {"value": ({"UniqueName": "orgA", "Url": "https://a.crm17.dynamics.com"},
                                     {"UniqueName": "orgB", "Url": "https://b.crm17.dynamics.com"})};
        assertNothing(CdsRestClientBase::getInstanceOptions(many, NOTHING, NOTHING),
            "no environment is chosen arbitrarily");
        assertEq({"url": "dynamics://b.crm17.dynamics.com", "organization": "orgB"},
            CdsRestClientBase::getInstanceOptions(many, "orgB", NOTHING), "the named one is chosen");
        assertNothing(CdsRestClientBase::getInstanceOptions(many, "nosuch", NOTHING),
            "and a name that matches nothing chooses nothing");

        # an environment with no URL cannot be connected to whatever else it says
        assertNothing(CdsRestClientBase::getInstanceOptions({"value": ({"UniqueName": "x"},)}, NOTHING,
            NOTHING));
        assertNothing(CdsRestClientBase::getInstanceOptions({"value": ()}, NOTHING, NOTHING));

        # once the environment is known the scope follows it, which is what makes the whole flow work
        DynamicsRestConnection c2({"name": "d", "desc": "d",
            "url": "dynamics://contoso.crm17.dynamics.com", "opts": c.opts});
        assertEq(("offline_access", "https://contoso.crm17.dynamics.com/user_impersonation"),
            c2.opts.oauth2_scopes, "the environment's scope replaces the discovery scope");
        assertFalse(CdsRestClientBase::isDiscoveryUrl(c2.url), "and the discovery is not done again");

        # a look-alike host is not the discovery service
        assertFalse(CdsRestClientBase::isDiscoveryUrl(
            "dynamics://globaldiscoXcrmXdynamics.com"));
        assertFalse(CdsRestClientBase::isDiscoveryUrl(NOTHING));
    }

    profileScopeTest() {
        string UrlA = "https://eu.lcs.dynamics.com/";
        string UrlB = "https://qoretechnologies.crm17.dynamics.com/";
        hash<auto> Opts = {
            "oauth2_client_id": "id",
            "oauth2_client_secret": "secret",
            "api_profile": "dynamics",
        };

        CdsRestConnection c1({"name": "d", "desc": "d", "url": "dynamics://eu.lcs.dynamics.com",
            "opts": Opts});
        assertEq(("offline_access", UrlA + "user_impersonation"), c1.opts.oauth2_scopes,
            "the scope is resolved against the connection URL");

        # the resolved options are what get stored and handed back when the connection is rebuilt
        CdsRestConnection c2({"name": "d", "desc": "d",
            "url": "dynamics://qoretechnologies.crm17.dynamics.com", "opts": c1.opts});
        assertEq(("offline_access", UrlB + "user_impersonation"), c2.opts.oauth2_scopes,
            "a scope resolved against the old URL is resolved again against the new one");

        # ... and rebuilding with the same URL changes nothing
        CdsRestConnection c3({"name": "d", "desc": "d",
            "url": "dynamics://qoretechnologies.crm17.dynamics.com", "opts": c2.opts});
        assertEq(c2.opts.oauth2_scopes, c3.opts.oauth2_scopes, "resolving is idempotent");

        # a scope the caller set itself does not have the profile's shape and is left alone
        CdsRestConnection c4({"name": "d", "desc": "d", "url": "dynamics://eu.lcs.dynamics.com",
            "opts": Opts + {"oauth2_scopes": ("offline_access", "https://graph.microsoft.com/.default")}});
        assertEq(("offline_access", "https://graph.microsoft.com/.default"), c4.opts.oauth2_scopes,
            "a custom scope is not rewritten");
        CdsRestConnection c5({"name": "d", "desc": "d",
            "url": "dynamics://qoretechnologies.crm17.dynamics.com", "opts": c4.opts});
        assertEq(c4.opts.oauth2_scopes, c5.opts.oauth2_scopes,
            "and it still is not, when the URL changes");

        # the helper itself: a template with no placeholder never rewrites anything
        assertEq("offline_access",
            CdsRestClientBase::resolveProfileScope(DynamicsProfile.oauth2_scopes, "offline_access", UrlB));
        assertEq(UrlB + "user_impersonation", CdsRestClientBase::resolveProfileScope(
            DynamicsProfile.oauth2_scopes, UrlA + "user_impersonation", UrlB));
        assertEq("something-else", CdsRestClientBase::resolveProfileScope(
            DynamicsProfile.oauth2_scopes, "something-else", UrlB));
    }

    connectionTest() {
        # a hard-coded port encodes an assumption about the machine that the test cannot verify; ports in
        # common use (8080 above all) are occupied on many developer machines, and connecting to whatever is
        # listening there produces an unrelated error.  Reserve an unused one instead
        int port = get_free_port();
        string url = sprintf("https://localhost:%d", port);

        {
            CdsRestConnection crc({
                "name": "test",
                "desc": "test",
                "url": url,
                "opts": {
                    "oauth2_client_id": "x",
                    "oauth2_client_secret": "x",
                }
            });
            assertEq(True, crc instanceof CdsRestConnection);
        }

        assertThrows("CONNECTION-OPTION-ERROR", sub () {
            CdsRestConnection crc({
                "name": "test",
                "desc": "test",
                "url": url,
                "opts": {
                    "oauth2_client_id": "x",
                    "oauth2_client_secret": "x",
                    "x": 1,
                },
            });
        });

        {
            DynamicsRestConnection crc({
                "name": "test",
                "desc": "test",
                "url": "https://example.com",
                "opts": {
                    "oauth2_client_id": "x",
                    "oauth2_client_secret": "x",
                    "oauth2_grant_type": "authorization_code",
                    "api_profile": "dynamics",
                },
            });
            assertEq(True, crc instanceof DynamicsRestConnection);
            assertEq("https://login.microsoftonline.com/common/oauth2/v2.0/authorize?"
                "scope=offline_access%20https://example.com/user_impersonation&redirect_uri=auto&"
                "client_id=x&response_type=code&response_mode=query",
                crc.getAuthorizationCodeRequest());
            assertEq("https://login.microsoftonline.com/common/oauth2/v2.0/authorize", crc.getAuthUrl());
            assertEq("https://login.microsoftonline.com/common/oauth2/v2.0/token", crc.getTokenUrl());
        }

        {
            CdsRestConnection crc({
                "name": "test",
                "desc": "test",
                "url": url,
                "opts": {
                    "oauth2_client_id": "x",
                    "oauth2_client_secret": "x",
                },
            });
            CdsRestClient client = crc.get(False);
            # issue #3321: check default timeouts
            assertEq(45000, client.getTimeout());
            assertEq(45000, client.getConnectTimeout());
        }
    }
}

class TestPollingConnectionMonitor inherits PollingConnectionMonitor {
    private {
        Queue msgq();
    }

    constructor(*Logger logger) : PollingConnectionMonitor(logger) {
        ping_timeout = 5s;
    }

    hash<auto> waitForResult() {
        return msgq.get();
    }

    private failedToStartPing(string name, hash<ExceptionInfo> ex) {
        PollingConnectionMonitor::failedToStartPing(name, ex);
        msgq.push({"name": name, "result": "error", "ex": ex});
    }

    private handlePingSuccess(string name, date delta, *bool oldok) {
        PollingConnectionMonitor::handlePingSuccess(name, delta, oldok);
        msgq.push({"name": name, "result": "OK"});
    }

    private handlePingFailed(string name, date delta, hash<ExceptionInfo> ex) {
        PollingConnectionMonitor::handlePingFailed(name, delta, ex);
        msgq.push({"name": name, "result": "error", "ex": ex});
    }

    private handlePingTimeout(string name, date delta) {
        PollingConnectionMonitor::handlePingTimeout(name, delta);
        msgq.push({"name": name, "result": "timeout"});
    }
}
