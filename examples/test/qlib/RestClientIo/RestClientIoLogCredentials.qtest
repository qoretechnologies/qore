%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires Util
%requires Mime
%requires Logger
%requires HttpServerUtil
%requires HttpServer
%requires RestClient
%requires RestClientIo

%requires json

%exec-class RestClientIoLogCredentialsTest

#! Captures every message logged
class LogCapture inherits LoggerAppenderWithLayout {
    public {
        list<string> messages();
        Mutex m();
    }

    constructor() : LoggerAppenderWithLayout("capture", new LoggerLayoutPattern("%m")) {
        open();
    }

    processEventImpl(int type, auto params) {
        if (type == EVENT_LOG) {
            AutoLock al(m);
            push messages, params;
        }
    }

    list<string> snapshot() {
        AutoLock al(m);
        return messages;
    }
}

#! Answers every request with a JSON object
class OkHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return <HttpResponseInfo>{
            "code": 200,
            "hdr": {"Content-Type": MimeTypeJson},
            "body": make_json({"ok": True}),
        };
    }
}

#! The debug messages of RestClientIo requests give the target URL with its password masked, and those of a new
#! OAuth2 token give no token
class RestClientIoLogCredentialsTest inherits QUnit::Test {
    public {
        const Secret = "s3cr3t-UrlPw-6504";
        const Token = "s3cr3t-Access-6504";
        const RefreshToken = "s3cr3t-Refresh-6504";
    }

    private {
        HttpServer server;
        int port;
    }

    constructor() : QUnit::Test("RestClientIoLogCredentials", "1.0") {
        addTestCase("no credentials in logs", \noCredentialsInLogs());
        addTestCase("a URL not valid in its encoding is not given", \invalidUrlNotGiven());
        set_return_value(main());
    }

    globalSetUp() {
        server = new HttpServer(<HttpServerOptionInfo>{
            "logger": new Logger("server", LoggerLevel::getLevelError()),
        });
        port = server.addListener(<HttpListenerOptionInfo>{"node": "localhost", "service": 0}).port;
        OkHandler handler();
        server.setHandler("ok", "", NOTHING, handler);
        server.setDefaultHandler("ok", handler);
    }

    globalTearDown() {
        server.stop();
    }

    #! a URL that is not valid in its encoding cannot be masked; it is not given, as it holds credentials (qore#6553)
    invalidUrlNotGiven() {
        string url = "https://user:secret@" + binary_to_string(parse_hex_string("ff"), "UTF-8") + "host/";
        RestClientIo::RestClientIo rc({"url": url, "no_connect": True});
        string safe = rc.getSafeUrl();
        assertEq(-1, binary(safe).find(binary("secret")), "the password is not given");
        assertRegex("not valid in its encoding", safe);
    }

    noCredentialsInLogs() {
        LogCapture log();
        Logger logger("test", LoggerLevel::getLevelDebug());
        logger.addAppender(log);
        RestClientIo rest({
            "url": "http://user:" + Secret + "@localhost:" + port,
            "http_version": "1.1",
            "logger": logger,
        });
        on_exit rest.close();

        assertEq({"ok": True}, rest.restGet("a").body);
        assertEq({"ok": True}, rest.restDoRequestAsync("GET", "b", NOTHING, NOTHING).get().body);
        rest.restDoRequestAsync("GET", "c", NOTHING, NOTHING, False).get();
        rest.restDoRequestCancellableAsync("GET", "d", NOTHING, NOTHING).get();
        assertEq({"ok": True}, rest.doSignedRequest("X-Signature", string sub (hash<auto> req) { return "sig"; },
            "GET", "e", NOTHING, NOTHING).body);

        # a new OAuth2 token: the tokens are not logged
        rest.updateOAuth2Token({"token_type": "Bearer", "access_token": Token, "refresh_token": RefreshToken,
            "expires_in": 3600});
        assertEq(Token, rest.getToken());

        list<string> messages = log.snapshot();
        assertTrue((select messages, $1 =~ /set OAuth2 auth: Bearer <redacted>; refresh_token: <redacted>/).size()
            > 0, sprintf("the new token is logged without its value: %N", messages));
        # each request is logged with its target
        foreach string path in ("a", "b", "c", "d", "e") {
            string rx = "GET http://user:<masked>@localhost:" + port + "/?" + path + "$";
            assertTrue((select messages, regex($1, rx)).size() > 0,
                sprintf("the request to %y is logged with the masked URL: %N", path, messages));
        }
        foreach string msg in (messages) {
            foreach string secret in (Secret, Token, RefreshToken) {
                assertEq(-1, msg.find(secret), sprintf("no credential in a log message: %y", msg));
            }
        }
    }
}
