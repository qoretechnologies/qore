    testHeaderManagement() {
        RestClientIo::RestClientIo rest = createClient();
        on_exit rest.close();

        # verify default Accept and User-Agent headers are present
        hash<auto> hdrs = rest.getDefaultHeaders();
        assertEq(True, exists hdrs."Accept", "Accept header must be set by default");
        assertRegex("application/yaml", hdrs."Accept", "Accept must include YAML MIME type");
        assertRegex("Qore-RestClientIo/", hdrs."User-Agent", "User-Agent must be set");

        # addDefaultHeaders preserves defaults
        rest.addDefaultHeaders({"X-Custom": "header-value"});
        assertEq("header-value", rest.getDefaultHeaders()."X-Custom");
        assertEq(True, exists rest.getDefaultHeaders()."Accept",
            "Accept still present after addDefaultHeaders");

        # replaceDefaultHeaders preserves DefaultHeaders
        rest.replaceDefaultHeaders({"X-New": "only"});
        assertEq("only", rest.getDefaultHeaders()."X-New");
        assertEq(True, !rest.getDefaultHeaders()."X-Custom",
            "old custom header removed after replace");
        assertEq(True, exists rest.getDefaultHeaders()."Accept",
            "Accept preserved by replaceDefaultHeaders");
        assertEq(True, exists rest.getDefaultHeaders()."User-Agent",
            "User-Agent preserved by replaceDefaultHeaders");

        # user-provided headers override defaults
        RestClientIo::RestClientIo rest2 = createClient({
            "headers": {"Accept": "text/html", "User-Agent": "CustomAgent/1.0"},
        });
        on_exit rest2.close();
        assertEq("text/html", rest2.getDefaultHeaders()."Accept",
            "user Accept overrides default");
        assertEq("CustomAgent/1.0", rest2.getDefaultHeaders()."User-Agent",
            "user User-Agent overrides default");
    }

    testDefaultAcceptSentOnWire() {
