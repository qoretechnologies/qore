#! Simple JSON echo handler for testing
class JsonEchoHandler inherits AbstractHttpRequestHandler {
    hash<auto> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        if (hdr.method == "HEAD") {
            return makeResponse(200, NOTHING, {"Content-Type": MimeTypeJson});
        }
        if (hdr.method == "OPTIONS") {
            return makeResponse(200, make_json({"allow": "GET, POST, PUT, PATCH, DELETE, HEAD, OPTIONS"}),
                {"Content-Type": MimeTypeJson});
        }
        hash<auto> resp_body;
        if (body) {
            auto parsed;
            if (body.typeCode() == NT_BINARY) {
                parsed = parse_json(body.toString());
            } else {
                parsed = parse_json(body);
            }
            resp_body = {
                "method": hdr.method,
                "path": hdr.path,
                "body": parsed,
            };
        } else {
            resp_body = {
                "method": hdr.method,
                "path": hdr.path,
            };
        }
        int status = hdr.method == "DELETE" ? 204 : 200;
        return makeResponse(status, make_json(resp_body), {"Content-Type": MimeTypeJson});
    }
}

#! Handler that returns HTML for testing allow_any_response
class HtmlHandler inherits AbstractHttpRequestHandler {
    hash<auto> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, "<html><body>Hello</body></html>",
            {"Content-Type": "text/html"});
    }
}

#! Echo handler that includes request headers in the response for verification
class EchoHeadersHandler inherits AbstractHttpRequestHandler {
    hash<auto> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        hash<auto> resp_body = {
            "method": hdr.method,
            "path": hdr.path,
            "request_headers": hdr,
        };
        if (body) {
            if (body.typeCode() == NT_BINARY) {
                body = body.toString();
            }
            try {
                resp_body.body = parse_json(body);
            } catch () {
                resp_body.body = body;
            }
        }
        return makeResponse(200, make_json(resp_body), {"Content-Type": MimeTypeJson});
    }
}

#! Handler that returns errors for testing error_passthru
class ErrorHandler inherits AbstractHttpRequestHandler {
    hash<auto> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(500, make_json({"error": "internal server error"}),
            {"Content-Type": MimeTypeJson});
    }
}

#! Mock OAuth2 token endpoint handler
class OAuth2TokenHandler inherits AbstractHttpRequestHandler {
    private {
        #! Number of token requests received
        int request_count = 0;
        Mutex mtx();
        #! Expected client_id (if set)
        *string expected_client_id;
        #! Expected client_secret (if set)
        *string expected_client_secret;
        #! Access token to return
        string return_token = "test-access-token";
        #! Refresh token to return
        *string return_refresh_token = "test-refresh-token";
        #! Token expiry in seconds
        int return_expires_in = 3600;
        #! If True, return an error
        bool return_error = False;
    }

    constructor(*string expected_client_id, *string expected_client_secret) {
        self.expected_client_id = expected_client_id;
        self.expected_client_secret = expected_client_secret;
    }

    int getRequestCount() {
        AutoLock al(mtx);
        return request_count;
    }

    resetRequestCount() {
        AutoLock al(mtx);
        request_count = 0;
    }

    setReturnToken(string token) {
        self.return_token = token;
    }

    setReturnRefreshToken(*string token) {
        self.return_refresh_token = token;
    }

    setReturnExpiresIn(int expires_in) {
        self.return_expires_in = expires_in;
    }

    setReturnError(bool val) {
        self.return_error = val;
    }

    hash<auto> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        {
            AutoLock al(mtx);
            ++request_count;
        }

        if (return_error) {
            return makeResponse(400, make_json({"error": "invalid_grant"}),
                {"Content-Type": MimeTypeJson});
        }

        # Parse form-urlencoded body
        hash<auto> params;
        if (body) {
            string body_str = body.typeCode() == NT_BINARY ? body.toString() : body;
            params = parse_uri_query("?" + body_str).params;
        }

        # Check for basic auth
        *string auth_header = hdr.authorization ?? hdr.Authorization;
        if (auth_header =~ /^Basic /) {
            # Basic auth — client_id/secret in Authorization header
        } else if (expected_client_id && params.client_id != expected_client_id) {
            return makeResponse(401, make_json({"error": "invalid_client",
                "error_description": sprintf("expected client_id %y, got %y",
                    expected_client_id, params.client_id)}),
                {"Content-Type": MimeTypeJson});
        }

        hash<auto> resp = {
            "access_token": return_token,
            "token_type": "Bearer",
            "expires_in": return_expires_in,
        };
        if (return_refresh_token) {
            resp.refresh_token = return_refresh_token;
        }

        return makeResponse(200, make_json(resp), {"Content-Type": MimeTypeJson});
    }
}

#! Handler that returns 401 on first request, then 200 on retry
class Auth401Handler inherits AbstractHttpRequestHandler {
    private {
        #! Set of tokens that should get 401
        hash<string, bool> reject_tokens;
        Mutex mtx();
    }

    constructor() {
    }

    addRejectToken(string token) {
        AutoLock al(mtx);
        reject_tokens{token} = True;
    }

    removeRejectToken(string token) {
        AutoLock al(mtx);
        remove reject_tokens{token};
    }

    hash<auto> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        # Check Authorization header
        *string auth = hdr.authorization ?? hdr.Authorization;
        if (auth) {
            *string token = (auth =~ x/Bearer\s+(.+)/)[0];
            {
                AutoLock al(mtx);
                if (token && reject_tokens{token}) {
                    return makeResponse(401, make_json({"error": "invalid_token"}),
                        {"Content-Type": MimeTypeJson});
                }
            }
        }
        hash<auto> resp_body = {
            "method": hdr.method,
            "path": hdr.path,
            "status": "ok",
        };
        return makeResponse(200, make_json(resp_body), {"Content-Type": MimeTypeJson});
    }
}

