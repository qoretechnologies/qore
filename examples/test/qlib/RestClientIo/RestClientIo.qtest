%endif
    }

    testH1ConcurrentRequests() {
%ifndef NoJson
        # HTTP/1.1 concurrent requests — the connection manager creates
        # multiple TCP connections since H1 is serial
        RestClientIo::RestClientIo rest = createH1Client();
        on_exit rest.close();

        Counter cnt(5);
        list<hash<RestClient::RestResponseInfo>> results = ();
        *hash<ExceptionInfo> bg_ex;
        Mutex mtx();
        for (int i = 0; i < 5; ++i) {
            int idx = i;
            background sub () {
                on_exit cnt.dec();
                try {
                    hash<RestClient::RestResponseInfo> resp =
                        rest.restGet(sprintf("/api/item/%d", idx));
                    {
                        AutoLock al(mtx);
                        push results, resp;
                    }
                } catch (hash<ExceptionInfo> ex) {
                    AutoLock al(mtx);
                    if (!bg_ex) {
                        bg_ex = ex;
                    }
                }
            }();
        }
        cnt.waitForZero();

        if (bg_ex) {
            throw bg_ex.err, bg_ex.desc;
        }
        assertEq(5, results.size());
        for (int i = 0; i < 5; ++i) {
            assertEq(200, results[i].status_code,
                sprintf("h1 concurrent request %d status", i));
        }
%endif
    }

