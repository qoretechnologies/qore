    constructor() : Test("RestClientIoTest", "1.0") {
        addTestCase("constructor options", \testConstructorOptions());
        addTestCase("AbstractRestClient conformance", \testAbstractRestClientConformance());
        addTestCase("restGet", \testRestGet());
        addTestCase("restHead", \testRestHead());
        addTestCase("restOptions", \testRestOptions());
        addTestCase("restPost", \testRestPost());
        addTestCase("restPut", \testRestPut());
        addTestCase("restPatch", \testRestPatch());
        addTestCase("restDel", \testRestDel());
        addTestCase("restDoRequest", \testRestDoRequest());
        addTestCase("serialization config", \testSerializationConfig());
        addTestCase("header management", \testHeaderManagement());
        addTestCase("default Accept header sent on wire", \testDefaultAcceptSentOnWire());
        addTestCase("token management", \testTokenManagement());
        addTestCase("error passthru", \testErrorPassthru());
        addTestCase("error without passthru", \testErrorWithoutPassthru());
        addTestCase("missing url error", \testMissingUrlError());
        addTestCase("stats", \testStats());
        addTestCase("shared manager", \testSharedManager());
        addTestCase("shared manager close does not close manager", \testSharedManagerCloseNoClose());
        addTestCase("restGetAsync", \testRestGetAsync());
        addTestCase("restPostAsync", \testRestPostAsync());
        addTestCase("async concurrent", \testAsyncConcurrent());
        addTestCase("async error", \testAsyncError());
        addTestCase("pool basic", \testPoolBasic());
        addTestCase("pool with options", \testPoolWithOptions());
        addTestCase("pool with shared manager", \testPoolWithSharedManager());
        addTestCase("pool concurrent", \testPoolConcurrent());
        addTestCase("h1 basic get", \testH1BasicGet());
        addTestCase("h1 post with body", \testH1PostWithBody());
        addTestCase("h1 head request", \testH1HeadRequest());
        addTestCase("h1 delete 204", \testH1Delete204());
        addTestCase("h1 error passthru", \testH1ErrorPassthru());
        addTestCase("h1 concurrent requests", \testH1ConcurrentRequests());
        addTestCase("h1 pool basic", \testH1PoolBasic());
        addTestCase("h1 ssl", \testH1Ssl());
        addTestCase("auto plain http fallback to h1", \testAutoPlainHttpFallback());
        addTestCase("auto plain http fallback caching", \testAutoPlainHttpFallbackCaching());
        addTestCase("auto plain http concurrent fallback", \testAutoPlainHttpConcurrentFallback());
        addTestCase("oauth2 client_credentials", \testOAuth2ClientCredentials());
        addTestCase("oauth2 password grant", \testOAuth2PasswordGrant());
        addTestCase("oauth2 proactive refresh", \testOAuth2ProactiveRefresh());
        addTestCase("oauth2 refresh within window", \testOAuth2RefreshWithinWindow());
        addTestCase("oauth2 no refresh outside window", \testOAuth2NoRefreshOutsideWindow());
        addTestCase("oauth2 concurrent refresh", \testOAuth2ConcurrentRefresh());
        addTestCase("oauth2 401 retry", \testOAuth2_401Retry());
        addTestCase("oauth2 setOAuth2Options/getOAuth2Options", \testOAuth2OptionsRoundTrip());
        addTestCase("oauth2 getNewToken", \testOAuth2GetNewToken());
        addTestCase("oauth2 basic auth", \testOAuth2BasicAuth());
        addTestCase("oauth2 secret only auth", \testOAuth2SecretOnlyAuth());
        addTestCase("oauth2 scopes", \testOAuth2Scopes());
        addTestCase("oauth2 token args", \testOAuth2TokenArgs());
        addTestCase("oauth2 different token URL host", \testOAuth2DifferentTokenHost());
        addTestCase("oauth2 invalid options", \testOAuth2InvalidOptions());
        addTestCase("oauth2 authorization_code throws", \testOAuth2AuthCodeThrows());
        addTestCase("oauth2 refresh failure", \testOAuth2RefreshFailure());
        addTestCase("oauth2 async", \testOAuth2Async());
        addTestCase("oauth2 pool", \testOAuth2Pool());
        # Phase 1: Simple additions
        addTestCase("getLogger", \testGetLogger());
        addTestCase("allow any response", \testAllowAnyResponse());
        addTestCase("allow any response async", \testAllowAnyResponseAsync());
        addTestCase("allow any response + error passthru", \testAllowAnyResponseWithErrorPassthru());
        addTestCase("setContentEncoding", \testSetContentEncoding());
        addTestCase("setContentEncoding invalid", \testSetContentEncodingInvalid());
        addTestCase("validator access", \testValidatorAccess());
        # Phase 2: Connection path
        addTestCase("connection path", \testConnectionPath());
        addTestCase("connection path no double", \testConnectionPathNoDouble());
        addTestCase("connection path clear", \testConnectionPathClear());
        addTestCase("connection path constructor", \testConnectionPathConstructor());
        addTestCase("connection path trailing slash", \testConnectionPathTrailingSlash());
        addTestCase("connection path empty vs NOTHING", \testConnectionPathEmptyVsNothing());
        addTestCase("connection path h1", \testConnectionPathH1());
        # Phase 3: Basic auth
        addTestCase("basic auth", \testBasicAuth());
        addTestCase("basic auth clear", \testBasicAuthClear());
        addTestCase("basic auth constructor", \testBasicAuthConstructor());
        addTestCase("basic auth empty password", \testBasicAuthEmptyPassword());
        addTestCase("basic auth special chars", \testBasicAuthSpecialChars());
        addTestCase("basic auth overwrite", \testBasicAuthOverwrite());
        addTestCase("basic auth + token interaction", \testBasicAuthTokenInteraction());
        addTestCase("basic auth clear idempotent", \testBasicAuthClearIdempotent());
        # Phase 4: Request signing
        addTestCase("signed request", \testSignedRequest());
        addTestCase("signed request async", \testSignedRequestAsync());
        addTestCase("signed request with body", \testSignedRequestWithBody());
        addTestCase("signed request with connection path", \testSignedRequestWithConnectionPath());
        addTestCase("signed request signer throws", \testSignedRequestSignerThrows());
        addTestCase("signed request hdr excludes sig", \testSignedRequestHdrExcludesSig());
        # Phase 5: Proxy protocol tests
        addTestCase("proxy h3 auto downgrade", \testProxyH3AutoDowngrade());
        addTestCase("proxy h3 forced error", \testProxyH3ForcedError());
        addTestCase("proxy invalid url", \testProxyInvalidUrl());
        addTestCase("proxy default port", \testProxyDefaultPort());
        addTestCase("proxy with h1 protocol", \testProxyWithH1Protocol());
        addTestCase("proxy with h2 protocol", \testProxyWithH2Protocol());

        # Create servers once in the constructor — they're shared across all test
        # cases since the handlers are stateless. This avoids a race condition
        # where rapid server destroy/recreate cycles in setUp/tearDown can cause
        # SSL_connect errors: the async HttpServer's HTTPS listener may not be
        # fully torn down by the time the next test's client connects to the
        # new server on a different port, and stale I/O events from the
        # controller's previous poll cycle can interfere.
        Logger logger("test", LoggerLevel::getLevelInfo());
        hash<HttpServerOptionInfo> http_opts = <HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        };
        token_handler = new OAuth2TokenHandler("test-client-id", "test-client-secret");
        auth401_handler = new Auth401Handler();
        server = new HttpServer(http_opts);
        server.setHandler("/api", "/api", MimeTypeJson, new JsonEchoHandler());
        server.setHandler("/error", "/error", MimeTypeJson, new ErrorHandler());
        server.setHandler("/html", "/html", "text/html", new HtmlHandler());
        server.setHandler("/echo", "/echo", MimeTypeJson, new EchoHeadersHandler());
        server.setHandler("/oauth/token", "/oauth/token", MimeTypeFormUrlEncoded, token_handler);
        server.setHandler("/auth401", "/auth401", MimeTypeJson, auth401_handler);
        server.setDefaultHandler("/api", new JsonEchoHandler());
        port = server.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        }).port;
        # Plain HTTP listener for HTTP/1.1 tests
        h1_port = server.addListener(<HttpListenerOptionInfo>{
            "service": 0,
        }).port;
        server.waitForAsyncIo();

        # HTTP/1.1-only server (no HTTP/2 support)
        # Simulates servers like uvicorn, nginx default, etc. that only speak HTTP/1.1
        Logger h1_logger("h1test", LoggerLevel::getLevelInfo());
        h1only_server = new HttpServer(<HttpServerOptionInfo>{
            "logger": h1_logger,
            "debug": True,
        });
        h1only_server.setHandler("/api", "/api", MimeTypeJson, new JsonEchoHandler());
        h1only_server.setHandler("/error", "/error", MimeTypeJson, new ErrorHandler());
        h1only_server.setHandler("/html", "/html", "text/html", new HtmlHandler());
        h1only_server.setHandler("/echo", "/echo", MimeTypeJson, new EchoHeadersHandler());
        h1only_server.setDefaultHandler("/api", new JsonEchoHandler());
        h1only_port = h1only_server.addListener(<HttpListenerOptionInfo>{
            "service": 0,
        }).port;

        set_return_value(main());
    }

    destructor() {
        delete h1only_server;
        delete server;
    }

    private RestClientIo::RestClientIo createClient(*hash<auto> extra_opts) {
        hash<auto> opts = {
            "url": sprintf("https://127.0.0.1:%d", port),
            "data": "json",
            "error_passthru": True,
            "accept_all_certs": True,
            "protocol": "h2",
        } + extra_opts;
        return new RestClientIo::RestClientIo(opts);
    }

    private RestClientIo::RestClientIo createH1Client(*hash<auto> extra_opts) {
        hash<auto> opts = {
            "url": sprintf("http://127.0.0.1:%d", h1_port),
            "data": "json",
            "error_passthru": True,
            "protocol": "h1",
        } + extra_opts;
        return new RestClientIo::RestClientIo(opts);
    }

    testConstructorOptions() {
        RestClientIo::RestClientIo rest = createClient();
        assertEq(sprintf("https://127.0.0.1:%d", port), rest.getUrl());
        assertEq("json", rest.getSerialization());
    }

    testAbstractRestClientConformance() {
        RestClientIo::RestClientIo rest = createClient();
        # RestClientIo should be an instance of AbstractRestClient
        assertEq(True, rest instanceof RestClient::AbstractRestClient);
        on_exit rest.close();
    }

    testRestGet() {
%ifndef NoJson
        RestClientIo::RestClientIo rest = createClient();
        on_exit rest.close();

        hash<RestClient::RestResponseInfo> resp = rest.restGet("/api/test");
        assertEq(200, resp.status_code);
        assertEq("GET", resp.body.method);
        assertRegex("api/test", resp.body.path);
        assertEq(True, resp.headers instanceof hash);
%endif
    }

    testRestHead() {
%ifndef NoJson
        RestClientIo::RestClientIo rest = createClient();
        on_exit rest.close();

        hash<RestClient::RestResponseInfo> resp = rest.restHead("/api/test");
        assertEq(200, resp.status_code);
%endif
    }

    testRestOptions() {
%ifndef NoJson
        RestClientIo::RestClientIo rest = createClient();
        on_exit rest.close();

        hash<RestClient::RestResponseInfo> resp = rest.restOptions("/api/test");
        assertEq(200, resp.status_code);
%endif
    }

    testRestPost() {
%ifndef NoJson
