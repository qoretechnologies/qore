    constructor() : Test("RestClientIoTest", "1.0") {
        addTestCase("constructor options", \testConstructorOptions());
        addTestCase("AbstractRestClient conformance", \testAbstractRestClientConformance());
        addTestCase("restGet", \testRestGet());
        addTestCase("restHead", \testRestHead());
        addTestCase("restOptions", \testRestOptions());
        addTestCase("restPost", \testRestPost());
        addTestCase("restPut", \testRestPut());
        addTestCase("restPatch", \testRestPatch());
        addTestCase("restDel", \testRestDel());
        addTestCase("restDoRequest", \testRestDoRequest());
        addTestCase("serialization config", \testSerializationConfig());
        addTestCase("header management", \testHeaderManagement());
        addTestCase("token management", \testTokenManagement());
        addTestCase("error passthru", \testErrorPassthru());
        addTestCase("error without passthru", \testErrorWithoutPassthru());
        addTestCase("missing url error", \testMissingUrlError());
        addTestCase("stats", \testStats());
        addTestCase("shared manager", \testSharedManager());
        addTestCase("shared manager close does not close manager", \testSharedManagerCloseNoClose());
        addTestCase("restGetAsync", \testRestGetAsync());
        addTestCase("restPostAsync", \testRestPostAsync());
        addTestCase("async concurrent", \testAsyncConcurrent());
        addTestCase("async error", \testAsyncError());

        set_return_value(main());
    }

    setUp() {
        Logger logger("test", LoggerLevel::getLevelInfo());
        hash<HttpServerOptionInfo> http_opts = <HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
            "async_mode": True,
        };
        server = new HttpServer(http_opts);
        server.setHandler("/api", "/api", MimeTypeJson, new JsonEchoHandler());
        server.setHandler("/error", "/error", MimeTypeJson, new ErrorHandler());
        server.setDefaultHandler("/api", new JsonEchoHandler());
        port = server.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        }).port;
        server.waitForAsyncIo();
    }

    tearDown() {
        delete server;
    }

    private RestClientIo::RestClientIo createClient(*hash<auto> extra_opts) {
        hash<auto> opts = {
            "url": sprintf("https://127.0.0.1:%d", port),
            "data": "json",
            "error_passthru": True,
            "accept_all_certs": True,
            "protocol": "h2",
        } + extra_opts;
        return new RestClientIo::RestClientIo(opts);
    }

    testConstructorOptions() {
        RestClientIo::RestClientIo rest = createClient();
        assertEq(sprintf("https://127.0.0.1:%d", port), rest.getUrl());
        assertEq("json", rest.getSerialization());
    }

    testAbstractRestClientConformance() {
        RestClientIo::RestClientIo rest = createClient();
        # RestClientIo should be an instance of AbstractRestClient
        assertEq(True, rest instanceof RestClient::AbstractRestClient);
        on_exit rest.close();
    }

    testRestGet() {
%ifndef NoJson
        RestClientIo::RestClientIo rest = createClient();
        on_exit rest.close();

        hash<RestClient::RestResponseInfo> resp = rest.restGet("/api/test");
        assertEq(200, resp.status_code);
        assertEq("GET", resp.body.method);
        assertRegex("api/test", resp.body.path);
        assertEq(True, resp.headers instanceof hash);
%endif
    }

    testRestHead() {
%ifndef NoJson
        RestClientIo::RestClientIo rest = createClient();
        on_exit rest.close();

        hash<RestClient::RestResponseInfo> resp = rest.restHead("/api/test");
        assertEq(200, resp.status_code);
%endif
    }

    testRestOptions() {
%ifndef NoJson
        RestClientIo::RestClientIo rest = createClient();
        on_exit rest.close();

        hash<RestClient::RestResponseInfo> resp = rest.restOptions("/api/test");
        assertEq(200, resp.status_code);
%endif
    }

    testRestPost() {
%ifndef NoJson
        RestClientIo::RestClientIo rest = createClient();
        on_exit rest.close();

        hash<auto> body = {"key": "value", "num": 42};
        hash<RestClient::RestResponseInfo> resp = rest.restPost("/api/test", body);
        assertEq(200, resp.status_code);
        assertEq("POST", resp.body.method);
        assertEq(body, resp.body.body);
%endif
    }

    testRestPut() {
%ifndef NoJson
        RestClientIo::RestClientIo rest = createClient();
        on_exit rest.close();

        hash<auto> body = {"update": True};
        hash<RestClient::RestResponseInfo> resp = rest.restPut("/api/test", body);
        assertEq(200, resp.status_code);
        assertEq("PUT", resp.body.method);
        assertEq(body, resp.body.body);
%endif
    }

    testRestPatch() {
%ifndef NoJson
        RestClientIo::RestClientIo rest = createClient();
        on_exit rest.close();

        hash<auto> body = {"patch": "data"};
        hash<RestClient::RestResponseInfo> resp = rest.restPatch("/api/test", body);
        assertEq(200, resp.status_code);
        assertEq("PATCH", resp.body.method);
        assertEq(body, resp.body.body);
%endif
    }

    testRestDel() {
%ifndef NoJson
        RestClientIo::RestClientIo rest = createClient();
        on_exit rest.close();

        hash<RestClient::RestResponseInfo> resp = rest.restDel("/api/test", NOTHING);
        assertEq(204, resp.status_code);
%endif
    }

    testRestDoRequest() {
%ifndef NoJson
        RestClientIo::RestClientIo rest = createClient();
        on_exit rest.close();

        hash<auto> body = {"generic": True};
        hash<RestClient::RestResponseInfo> resp = rest.restDoRequest("POST", "/api/test", body);
        assertEq(200, resp.status_code);
        assertEq("POST", resp.body.method);
        assertEq(body, resp.body.body);
%endif
    }

    testSerializationConfig() {
        RestClientIo::RestClientIo rest = createClient();
        on_exit rest.close();

        assertEq("json", rest.getSerialization());
        rest.setSerialization("auto");
        assertEq("auto", rest.getSerialization());
        rest.setSerialization("json");
        assertEq("json", rest.getSerialization());

        assertThrows("RESTCLIENT-ERROR", sub () { rest.setSerialization("invalid"); });
    }

    testHeaderManagement() {
        RestClientIo::RestClientIo rest = createClient();
        on_exit rest.close();

        rest.addDefaultHeaders({"X-Custom": "header-value"});
        assertEq("header-value", rest.getDefaultHeaders()."X-Custom");

        rest.replaceDefaultHeaders({"X-New": "only"});
        assertEq("only", rest.getDefaultHeaders()."X-New");
        assertEq(True, !rest.getDefaultHeaders()."X-Custom");
    }

    testTokenManagement() {
        RestClientIo::RestClientIo rest = createClient();
        on_exit rest.close();

        rest.setToken("Bearer", "my-token-456");
        assertEq("my-token-456", rest.getToken());
        assertEq("Bearer", rest.getTokenType());
        assertEq("Bearer my-token-456", rest.getDefaultHeaders().authorization);
    }

    testErrorPassthru() {
%ifndef NoJson
        RestClientIo::RestClientIo rest = createClient();
        on_exit rest.close();

        # With error_passthru=True, errors should be returned as responses
        hash<RestClient::RestResponseInfo> resp = rest.restGet("/error");
        assertEq(500, resp.status_code);
        assertEq("internal server error", resp.body.error);
%endif
    }

    testErrorWithoutPassthru() {
%ifndef NoJson
        RestClientIo::RestClientIo rest = new RestClientIo::RestClientIo({
            "url": sprintf("https://127.0.0.1:%d", port),
            "data": "json",
            "error_passthru": False,
            "accept_all_certs": True,
            "protocol": "h2",
        });
        on_exit rest.close();

        # Without error_passthru, errors should throw exceptions
        assertThrows("REST-RESPONSE-ERROR", sub () { rest.restGet("/error"); });
%endif
    }

    testMissingUrlError() {
        assertThrows("RESTCLIENTIO-ERROR", sub () {
            new RestClientIo::RestClientIo({});
        });
    }

    testStats() {
        RestClientIo::RestClientIo rest = createClient();
        on_exit rest.close();

        hash<auto> stats = rest.getStats();
        assertEq(True, exists stats.total_connections);
        assertEq(True, exists stats.protocol);
    }

    testSharedManager() {
%ifndef NoJson
        # Create a shared manager
        HttpClientIo::HttpClientConnectionManager shared_mgr(
            <HttpClientIo::HttpClientConnectionManagerOptions>{
                "accept_all_certs": True,
            },
        );

        # Two clients sharing the same connection manager
        RestClientIo::RestClientIo rest1({
            "url": sprintf("https://127.0.0.1:%d", port),
            "data": "json",
            "error_passthru": True,
        }, shared_mgr);
        on_exit rest1.close();

        RestClientIo::RestClientIo rest2({
            "url": sprintf("https://127.0.0.1:%d", port),
            "data": "json",
            "error_passthru": True,
        }, shared_mgr);
        on_exit rest2.close();

        # Both clients should use the same manager
        assertEq(True, rest1.getConnectionManager() == rest2.getConnectionManager());

        # Both should work for requests
        hash<RestClient::RestResponseInfo> resp1 = rest1.restGet("/api/test1");
        assertEq(200, resp1.status_code);

        hash<RestClient::RestResponseInfo> resp2 = rest2.restGet("/api/test2");
        assertEq(200, resp2.status_code);
%endif
    }

    testSharedManagerCloseNoClose() {
%ifndef NoJson
        # Create a shared manager
        HttpClientIo::HttpClientConnectionManager shared_mgr(
            <HttpClientIo::HttpClientConnectionManagerOptions>{
                "accept_all_certs": True,
            },
        );

        # Create client with shared manager
        RestClientIo::RestClientIo rest1({
            "url": sprintf("https://127.0.0.1:%d", port),
            "data": "json",
            "error_passthru": True,
        }, shared_mgr);

        # Make a request to establish a connection
        hash<RestClient::RestResponseInfo> resp = rest1.restGet("/api/test");
        assertEq(200, resp.status_code);

        # Close the client — should NOT close the shared manager
        rest1.close();

        # Create another client with the same shared manager — should still work
        RestClientIo::RestClientIo rest2({
            "url": sprintf("https://127.0.0.1:%d", port),
            "data": "json",
            "error_passthru": True,
        }, shared_mgr);
        on_exit rest2.close();

        resp = rest2.restGet("/api/test");
        assertEq(200, resp.status_code);
%endif
    }

    testRestGetAsync() {
%ifndef NoJson
        RestClientIo::RestClientIo rest = createClient();
        on_exit rest.close();

        RestClientIo::RestFuture f = rest.restGetAsync("/api/test");
        assertEq(False, f instanceof Future);
        hash<RestClient::RestResponseInfo> resp = f.get(30s);
        assertEq(200, resp.status_code);
        assertEq("GET", resp.body.method);
        assertRegex("api/test", resp.body.path);
%endif
    }

    testRestPostAsync() {
%ifndef NoJson
        RestClientIo::RestClientIo rest = createClient();
        on_exit rest.close();

        hash<auto> body = {"async_key": "async_value"};
        RestClientIo::RestFuture f = rest.restPostAsync("/api/test", body);
        hash<RestClient::RestResponseInfo> resp = f.get(30s);
        assertEq(200, resp.status_code);
        assertEq("POST", resp.body.method);
        assertEq(body, resp.body.body);
%endif
    }

    testAsyncConcurrent() {
%ifndef NoJson
        RestClientIo::RestClientIo rest = createClient();
        on_exit rest.close();

        # Fire 10 async requests concurrently
        list<RestClientIo::RestFuture> futures = ();
        for (int i = 0; i < 10; ++i) {
            push futures, rest.restGetAsync(sprintf("/api/item/%d", i));
        }

        # Collect all results
        for (int i = 0; i < 10; ++i) {
            hash<RestClient::RestResponseInfo> resp = futures[i].get(30s);
            assertEq(200, resp.status_code,
                sprintf("async concurrent request %d status", i));
        }
%endif
    }

    testAsyncError() {
%ifndef NoJson
        # Test with error_passthru=True: errors returned as responses via RestFuture
        RestClientIo::RestClientIo rest = createClient();
        on_exit rest.close();

        RestClientIo::RestFuture f = rest.restGetAsync("/error");
        hash<RestClient::RestResponseInfo> resp = f.get(30s);
        assertEq(500, resp.status_code);
        assertEq("internal server error", resp.body.error);

        # Test with error_passthru=False: errors propagated as exceptions on get()
        RestClientIo::RestClientIo rest_strict = new RestClientIo::RestClientIo({
            "url": sprintf("https://127.0.0.1:%d", port),
            "data": "json",
            "error_passthru": False,
            "accept_all_certs": True,
            "protocol": "h2",
        });
        on_exit rest_strict.close();

        RestClientIo::RestFuture f2 = rest_strict.restGetAsync("/error");
        assertThrows("REST-RESPONSE-ERROR", \f2.get(), (30s,));
%endif
    }
}
