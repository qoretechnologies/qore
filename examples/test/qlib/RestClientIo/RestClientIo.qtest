        RestClientIo::RestClientIo rest = createOAuth2Client();
        on_exit rest.close();

        assertEq(1, token_handler.getRequestCount(), "initial login");

        # Async request should work with the acquired token
        RestClientIo::RestFuture f = rest.restGetAsync("/api/test");
        hash<RestClient::RestResponseInfo> resp = f.get(30s);
