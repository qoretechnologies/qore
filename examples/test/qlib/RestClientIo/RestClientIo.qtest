    testOAuth2InvalidOptions() {
%ifndef NoJson
        # Missing required options for client_credentials
        assertThrows("OAUTH2-ERROR", sub () {
            new RestClientIo::RestClientIo({
                "url": sprintf("https://127.0.0.1:%d", port),
                "data": "json",
                "accept_all_certs": True,
                "oauth2_grant_type": "client_credentials",
                # Missing client_id, client_secret, token_url
            });
        });

        # Invalid grant type
        assertThrows("OAUTH2-ERROR", sub () {
            new RestClientIo::RestClientIo({
                "url": sprintf("https://127.0.0.1:%d", port),
                "data": "json",
                "accept_all_certs": True,
                "oauth2_grant_type": "invalid_type",
            });
        });

        # Password grant without username
        assertThrows("OAUTH2-ERROR", sub () {
            new RestClientIo::RestClientIo({
                "url": sprintf("https://127.0.0.1:%d", port),
                "data": "json",
                "accept_all_certs": True,
                "oauth2_grant_type": "password",
                "oauth2_client_id": "test",
                "oauth2_client_secret": "test",
                "oauth2_token_url": "/oauth/token",
                # Missing username and password
            });
        });
%endif
    }

    testOAuth2AuthCodeThrows() {
%ifndef NoJson
        # authorization_code grant should throw on auto-login
        assertThrows("OAUTH2-ERROR", "manually authorized", sub () {
            new RestClientIo::RestClientIo({
                "url": sprintf("https://127.0.0.1:%d", port),
                "data": "json",
                "accept_all_certs": True,
                "oauth2_grant_type": "authorization_code",
                "oauth2_client_id": "test",
                "oauth2_client_secret": "test",
                "oauth2_token_url": "/oauth/token",
                "oauth2_auth_url": "https://example.com/auth",
                "oauth2_redirect_url": "https://example.com/callback",
            });
        });

        # implicit grant should throw on auto-login
        assertThrows("OAUTH2-ERROR", "manually authorized", sub () {
            new RestClientIo::RestClientIo({
                "url": sprintf("https://127.0.0.1:%d", port),
                "data": "json",
                "accept_all_certs": True,
                "oauth2_grant_type": "implicit",
                "oauth2_client_id": "test",
                "oauth2_auth_url": "https://example.com/auth",
                "oauth2_redirect_url": "https://example.com/callback",
            });
        });
%endif
    }

    testOAuth2RefreshFailure() {
%ifndef NoJson
        token_handler.resetRequestCount();
        token_handler.setReturnToken("initial-rf-token");
        token_handler.setReturnRefreshToken("rf-refresh");

        RestClientIo::RestClientIo rest = createOAuth2Client();
        on_exit rest.close();

        assertEq(1, token_handler.getRequestCount());

        # Set expired token to trigger refresh
        rest.setToken("Bearer", "expired-rf", "rf-refresh", now_us() - 15m);

        # Make the token server return errors
        token_handler.setReturnError(True);
        on_exit token_handler.setReturnError(False);

        # Request should still work but with error from refresh — ensureToken throws
        assertThrows("OAUTH2-ERROR", sub () { rest.restGet("/api/test"); });
%endif
    }

    testOAuth2Async() {
