    testSharedManager() {
%ifndef NoJson
        # Create a shared manager
        HttpClientIo::HttpClientConnectionManager shared_mgr(
            <HttpClientIo::HttpClientConnectionManagerOptions>{
                "accept_all_certs": True,
            },
        );

        # Two clients sharing the same connection manager
        RestClientIo::RestClientIo rest1({
            "url": sprintf("https://127.0.0.1:%d", port),
            "data": "json",
            "error_passthru": True,
        }, shared_mgr);
        on_exit rest1.close();

        RestClientIo::RestClientIo rest2({
            "url": sprintf("https://127.0.0.1:%d", port),
            "data": "json",
            "error_passthru": True,
        }, shared_mgr);
        on_exit rest2.close();

        # Both clients should use the same manager
        assertEq(True, rest1.getConnectionManager() == rest2.getConnectionManager());

        # Both should work for requests
        hash<RestClient::RestResponseInfo> resp1 = rest1.restGet("/api/test1");
        assertEq(200, resp1.status_code);

        hash<RestClient::RestResponseInfo> resp2 = rest2.restGet("/api/test2");
        assertEq(200, resp2.status_code);
%endif
    }

    testSharedManagerCloseNoClose() {
%ifndef NoJson
        # Create a shared manager
        HttpClientIo::HttpClientConnectionManager shared_mgr(
            <HttpClientIo::HttpClientConnectionManagerOptions>{
                "accept_all_certs": True,
            },
        );

        # Create client with shared manager
        RestClientIo::RestClientIo rest1({
            "url": sprintf("https://127.0.0.1:%d", port),
            "data": "json",
            "error_passthru": True,
        }, shared_mgr);

        # Make a request to establish a connection
        hash<RestClient::RestResponseInfo> resp = rest1.restGet("/api/test");
        assertEq(200, resp.status_code);

        # Close the client — should NOT close the shared manager
        rest1.close();

        # Create another client with the same shared manager — should still work
        RestClientIo::RestClientIo rest2({
            "url": sprintf("https://127.0.0.1:%d", port),
            "data": "json",
            "error_passthru": True,
        }, shared_mgr);
        on_exit rest2.close();

        resp = rest2.restGet("/api/test");
        assertEq(200, resp.status_code);
%endif
    }

