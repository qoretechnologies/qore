    testOAuth2Pool() {
%ifndef NoJson
        token_handler.resetRequestCount();
        token_handler.setReturnToken("pool-token");
        token_handler.setReturnRefreshToken("pool-refresh");

        hash<auto> client_opts = {
            "url": sprintf("https://127.0.0.1:%d", port),
            "data": "json",
            "error_passthru": True,
            "accept_all_certs": True,
            "protocol": "h2",
            "oauth2_grant_type": "client_credentials",
            "oauth2_client_id": "test-client-id",
            "oauth2_client_secret": "test-client-secret",
            "oauth2_token_url": "/oauth/token",
        };
        RestClientIo::RestClientIoPool pool(client_opts);
        on_exit pool.shutdown();

        assertEq(1, token_handler.getRequestCount(), "initial login");
        assertEq("pool-token", pool.getToken());

        RestClientIo::RestClientIo rc = pool.acquire();
        on_exit pool.release();

        hash<RestClient::RestResponseInfo> resp = rc.restGet("/api/test");
        assertEq(200, resp.status_code);
        assertEq("GET", resp.body.method);
%endif
    }

    # ---- Phase 1: Simple additions ----

    testGetLogger() {
        # Client with logger
        Logger logger("test-logger", LoggerLevel::getLevelDebug());
        RestClientIo::RestClientIo rest = createClient({
            "logger": logger,
        });
        on_exit rest.close();

        *LoggerInterface lg = rest.getLogger();
        assertEq(True, exists lg);
        assertEq(True, lg instanceof LoggerInterface);

        # Client without logger
        RestClientIo::RestClientIo rest2 = createClient();
        on_exit rest2.close();
        assertEq(True, !exists rest2.getLogger());
    }

    testAllowAnyResponse() {
%ifndef NoJson
        # Default: allow_any_response is False — DESERIALIZATION-ERROR is thrown for
        # non-deserializable content
        RestClientIo::RestClientIo rest = new RestClientIo::RestClientIo({
            "url": sprintf("https://127.0.0.1:%d", port),
            "data": "json",
            "error_passthru": True,
            "accept_all_certs": True,
            "protocol": "h2",
        });
        on_exit rest.close();

        assertEq(False, rest.getAllowAnyResponse());
        assertThrows("DESERIALIZATION-ERROR", sub () { rest.restGet("/html"); });

        # Set allow_any_response — should return raw body
        rest.setAllowAnyResponse(True);
        assertEq(True, rest.getAllowAnyResponse());
        hash<RestClient::RestResponseInfo> resp = rest.restGet("/html");
        assertEq(200, resp.status_code);
        assertRegex("text/html", resp.content_type);
        # Body should contain HTML
        assertRegex("Hello", resp.body);

        # Constructor option
        RestClientIo::RestClientIo rest2 = new RestClientIo::RestClientIo({
            "url": sprintf("https://127.0.0.1:%d", port),
            "data": "json",
            "allow_any_response": True,
            "accept_all_certs": True,
            "protocol": "h2",
        });
        on_exit rest2.close();
        assertEq(True, rest2.getAllowAnyResponse());
        resp = rest2.restGet("/html");
        assertEq(200, resp.status_code);
%endif
    }

    testSetContentEncoding() {
        RestClientIo::RestClientIo rest = createClient();
        on_exit rest.close();

        rest.setContentEncoding("gzip");
        hash<auto> hdrs = rest.getDefaultHeaders();
        assertEq("gzip", hdrs."accept-encoding");

        rest.setContentEncoding("identity");
        hdrs = rest.getDefaultHeaders();
        assertEq("identity", hdrs."accept-encoding");

        # Constructor option
        RestClientIo::RestClientIo rest2 = createClient({
            "content_encoding": "deflate",
        });
        on_exit rest2.close();
        hdrs = rest2.getDefaultHeaders();
        assertEq(True, exists hdrs."accept-encoding");
    }

    testValidatorAccess() {
%ifndef NoJson
        RestClientIo::RestClientIo rest = createClient();
        on_exit rest.close();

        # Get default validator
        auto v = rest.getValidator();
        assertEq(True, v instanceof RestSchemaValidator::AbstractRestSchemaValidator);
        assertEq(True, v instanceof RestSchemaValidator::NullRestSchemaValidator);

        # Set a new validator (NullRestSchemaValidator as replacement)
        auto new_v = new RestSchemaValidator::NullRestSchemaValidator();
        rest.setValidator(new_v);
        auto v2 = rest.getValidator();
        assertEq(True, v2 instanceof RestSchemaValidator::NullRestSchemaValidator);

        # Constructor option
        auto ctor_v = new RestSchemaValidator::NullRestSchemaValidator();
        RestClientIo::RestClientIo rest2 = createClient({
            "validator": ctor_v,
        });
        on_exit rest2.close();
        auto v3 = rest2.getValidator();
        assertEq(True, v3 instanceof RestSchemaValidator::AbstractRestSchemaValidator);
%endif
    }

    # ---- Phase 2: Connection path ----

    testConnectionPath() {
%ifndef NoJson
        RestClientIo::RestClientIo rest = createClient();
        on_exit rest.close();

        rest.setConnectionPath("/api/v2");
        assertEq("/api/v2", rest.getConnectionPath());

        hash<RestClient::RestResponseInfo> resp = rest.restGet("/users");
        assertEq(200, resp.status_code);
        # Path should include connection path (server may strip leading /)
        assertRegex("api/v2/users", resp.body.path);
%endif
    }

    testConnectionPathNoDouble() {
%ifndef NoJson
        RestClientIo::RestClientIo rest = createClient();
        on_exit rest.close();

        rest.setConnectionPath("/api");
        hash<RestClient::RestResponseInfo> resp = rest.restGet("/api/users");
        assertEq(200, resp.status_code);
        # Should NOT double-prepend: path should be /api/users, not /api/api/users
        assertRegex("api/users", resp.body.path);
        assertEq(True, resp.body.path !~ /api\/api\//);
%endif
    }

    testConnectionPathClear() {
%ifndef NoJson
        RestClientIo::RestClientIo rest = createClient();
        on_exit rest.close();

        rest.setConnectionPath("/api/v2");
        assertEq("/api/v2", rest.getConnectionPath());

        rest.clearConnectionPath();
        assertEq(True, !exists rest.getConnectionPath());

        hash<RestClient::RestResponseInfo> resp = rest.restGet("/api/test");
        assertEq(200, resp.status_code);
        # Path should NOT include connection path
        assertRegex("api/test", resp.body.path);
        assertEq(True, resp.body.path !~ /api\/v2/);
%endif
    }

    testConnectionPathConstructor() {
%ifndef NoJson
        RestClientIo::RestClientIo rest = createClient({
            "default_path": "/api",
        });
        on_exit rest.close();

        assertEq("/api", rest.getConnectionPath());

        hash<RestClient::RestResponseInfo> resp = rest.restGet("/test");
        assertEq(200, resp.status_code);
        assertRegex("api/test", resp.body.path);
%endif
    }

    # ---- Phase 3: Basic auth ----

    testBasicAuth() {
%ifndef NoJson
        RestClientIo::RestClientIo rest = createClient();
        on_exit rest.close();

        rest.setUserPassword("testuser", "testpass");
        hash<auto> hdrs = rest.getDefaultHeaders();
        string expected = "Basic " + make_base64_string("testuser:testpass");
        assertEq(expected, hdrs.authorization);

        # Verify the authorization header is sent in requests
        hash<RestClient::RestResponseInfo> resp = rest.restGet("/echo/test");
        assertEq(200, resp.status_code);
        assertEq(True, exists resp.body.request_headers.authorization);
%endif
    }

    testBasicAuthClear() {
%ifndef NoJson
        RestClientIo::RestClientIo rest = createClient();
        on_exit rest.close();

        rest.setUserPassword("user1", "pass1");
        assertEq(True, exists rest.getDefaultHeaders().authorization);

        rest.clearUserPassword();
        assertEq(True, !exists rest.getDefaultHeaders().authorization);
%endif
    }

    testBasicAuthConstructor() {
%ifndef NoJson
        # Username/password without OAuth2 should set basic auth
        RestClientIo::RestClientIo rest = createClient({
            "username": "ctoruser",
            "password": "ctorpass",
        });
        on_exit rest.close();

        string expected = "Basic " + make_base64_string("ctoruser:ctorpass");
        assertEq(expected, rest.getDefaultHeaders().authorization);

        # With OAuth2, username/password should NOT set basic auth header
        # (they're used for the OAuth2 password grant instead)
        token_handler.resetRequestCount();
        token_handler.setReturnToken("ctor-oauth-token");
        RestClientIo::RestClientIo rest2 = createClient({
            "username": "oauthuser",
            "password": "oauthpass",
            "oauth2_grant_type": "password",
            "oauth2_client_id": "test-client-id",
            "oauth2_client_secret": "test-client-secret",
            "oauth2_token_url": "/oauth/token",
        });
        on_exit rest2.close();

        # Should have Bearer token from OAuth2, not Basic auth
        assertRegex("Bearer", rest2.getDefaultHeaders().authorization);
%endif
    }

    # ---- Phase 4: Request signing ----

    testSignedRequest() {
%ifndef NoJson
        RestClientIo::RestClientIo rest = createClient();
        on_exit rest.close();

        # Signer that concatenates path and body info
        code signer = auto sub (hash<auto> info) {
            return "sig-" + info.path;
        };

        hash<RestClient::RestResponseInfo> resp = rest.doSignedRequest(
            "x-signature", signer, "GET", "/echo/test", NOTHING);
        assertEq(200, resp.status_code);
        # Verify the signature header was sent
        assertEq(True, exists resp.body.request_headers."x-signature");
        assertRegex("sig-", resp.body.request_headers."x-signature");
%endif
    }

    testSignedRequestAsync() {
%ifndef NoJson
        RestClientIo::RestClientIo rest = createClient();
        on_exit rest.close();

        code signer = auto sub (hash<auto> info) {
            return "async-sig-" + info.path;
        };

        RestClientIo::RestFuture f = rest.doSignedRequestAsync(
            "x-signature", signer, "GET", "/echo/test", NOTHING);
        hash<RestClient::RestResponseInfo> resp = f.get(30s);
        assertEq(200, resp.status_code);
        assertEq(True, exists resp.body.request_headers."x-signature");
        assertRegex("async-sig-", resp.body.request_headers."x-signature");
%endif
    }

    # ---- Phase 5: Proxy protocol tests ----

    testProxyH3AutoDowngrade() {
        # With a proxy configured and auto protocol, H3 should not be attempted
        # (QUIC cannot tunnel through HTTP proxies)
        HttpClientIo::HttpClientConnectionManager mgr(
            <HttpClientIo::HttpClientConnectionManagerOptions>{
                "protocol": "auto",
                "proxy_url": "http://127.0.0.1:9999",
            }
        );
        on_exit mgr.closeAll();

        # The manager should have been created successfully (no error)
        hash<auto> stats = mgr.getStats();
        assertEq("auto", stats.protocol);
    }

    testProxyH3ForcedError() {
        # Forcing H3 with a proxy should throw
        assertThrows("HTTPCLIENT-PROXY-ERROR", sub () {
            HttpClientIo::HttpClientConnectionManager mgr(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
                    "protocol": "h3",
                    "proxy_url": "http://127.0.0.1:9999",
                }
            );
            # Need to actually try to use the connection to trigger resolveProtocol
            mgr.request("https://example.com", "GET", "/");
        });
    }

    # ---- Additional Phase 1 tests ----

    testAllowAnyResponseAsync() {
%ifndef NoJson
        # Verify allow_any_response works with async requests too
        RestClientIo::RestClientIo rest = new RestClientIo::RestClientIo({
            "url": sprintf("https://127.0.0.1:%d", port),
            "data": "json",
            "allow_any_response": True,
            "accept_all_certs": True,
            "protocol": "h2",
        });
        on_exit rest.close();

        RestClientIo::RestFuture f = rest.restGetAsync("/html");
        hash<RestClient::RestResponseInfo> resp = f.get(30s);
        assertEq(200, resp.status_code);
        assertRegex("Hello", resp.body);

        # Without allow_any_response, async should also throw
        RestClientIo::RestClientIo rest2 = new RestClientIo::RestClientIo({
            "url": sprintf("https://127.0.0.1:%d", port),
            "data": "json",
            "allow_any_response": False,
            "accept_all_certs": True,
            "protocol": "h2",
        });
        on_exit rest2.close();

        RestClientIo::RestFuture f2 = rest2.restGetAsync("/html");
        assertThrows("DESERIALIZATION-ERROR", \f2.get(), (30s,));
%endif
    }

    testAllowAnyResponseWithErrorPassthru() {
%ifndef NoJson
        # Both error_passthru=True AND allow_any_response=True on 500 + HTML response
        RestClientIo::RestClientIo rest = new RestClientIo::RestClientIo({
            "url": sprintf("https://127.0.0.1:%d", port),
            "data": "json",
            "error_passthru": True,
            "allow_any_response": True,
            "accept_all_certs": True,
            "protocol": "h2",
        });
        on_exit rest.close();

        # Normal JSON error response should still deserialize
        hash<RestClient::RestResponseInfo> resp = rest.restGet("/error");
        assertEq(500, resp.status_code);
        assertEq("internal server error", resp.body.error);

        # HTML response should return raw body (not throw)
        resp = rest.restGet("/html");
        assertEq(200, resp.status_code);
        assertRegex("Hello", resp.body);

        # Without error_passthru, 500 should throw even with allow_any_response
        RestClientIo::RestClientIo rest2 = new RestClientIo::RestClientIo({
            "url": sprintf("https://127.0.0.1:%d", port),
            "data": "json",
            "error_passthru": False,
            "allow_any_response": True,
            "accept_all_certs": True,
            "protocol": "h2",
        });
        on_exit rest2.close();
        assertThrows("REST-RESPONSE-ERROR", sub () { rest2.restGet("/error"); });
%endif
    }

    testSetContentEncodingInvalid() {
        RestClientIo::RestClientIo rest = createClient();
        on_exit rest.close();

        # Invalid encoding should throw
        assertThrows("RESTCLIENT-ERROR", sub () { rest.setSendEncoding("not-a-real-encoding"); });
        assertThrows("RESTCLIENT-ERROR", sub () { rest.setContentEncoding("not-a-real-encoding"); });
    }

    # ---- Additional Phase 2 tests ----

    testConnectionPathTrailingSlash() {
%ifndef NoJson
        RestClientIo::RestClientIo rest = createClient();
        on_exit rest.close();

        # Trailing slash on connection path
        rest.setConnectionPath("/api/");
        hash<RestClient::RestResponseInfo> resp = rest.restGet("/test");
        assertEq(200, resp.status_code);
        # Should have /api//test or /api/test depending on normalization
        assertRegex("api/", resp.body.path);
%endif
    }

    testConnectionPathEmptyVsNothing() {
%ifndef NoJson
        RestClientIo::RestClientIo rest = createClient();
        on_exit rest.close();

        # Set to empty string
        rest.setConnectionPath("");
        # Empty string in Qore has no .val() — should behave like no path
        hash<RestClient::RestResponseInfo> resp = rest.restGet("/api/test");
        assertEq(200, resp.status_code);
        assertRegex("api/test", resp.body.path);

        # Set to NOTHING
        rest.setConnectionPath();
        assertEq(True, !exists rest.getConnectionPath());
        resp = rest.restGet("/api/test");
        assertEq(200, resp.status_code);
        assertRegex("api/test", resp.body.path);
%endif
    }

    testConnectionPathH1() {
%ifndef NoJson
        # Connection path should work with HTTP/1.1 too
        RestClientIo::RestClientIo rest = createH1Client({
            "default_path": "/api",
        });
        on_exit rest.close();

        assertEq("/api", rest.getConnectionPath());

        hash<RestClient::RestResponseInfo> resp = rest.restGet("/test");
        assertEq(200, resp.status_code);
        assertRegex("api/test", resp.body.path);
%endif
    }

    # ---- Additional Phase 3 tests ----

    testBasicAuthEmptyPassword() {
%ifndef NoJson
        RestClientIo::RestClientIo rest = createClient();
        on_exit rest.close();

        # Empty password — should produce "user:" before base64
        rest.setUserPassword("user", "");
        string expected = "Basic " + make_base64_string("user:");
        assertEq(expected, rest.getDefaultHeaders().authorization);

        # Verify it works with requests
        hash<RestClient::RestResponseInfo> resp = rest.restGet("/echo/test");
        assertEq(200, resp.status_code);
        assertEq(expected, resp.body.request_headers.authorization);
%endif
    }

    testBasicAuthSpecialChars() {
%ifndef NoJson
        RestClientIo::RestClientIo rest = createClient();
        on_exit rest.close();

        # Username with colon, password with special chars
        rest.setUserPassword("user:name", "p@ss:w0rd!");
        string expected = "Basic " + make_base64_string("user:name:p@ss:w0rd!");
        assertEq(expected, rest.getDefaultHeaders().authorization);

        # UTF-8 characters
        rest.setUserPassword("ùser", "pàss");
        expected = "Basic " + make_base64_string("ùser:pàss");
        assertEq(expected, rest.getDefaultHeaders().authorization);
%endif
    }

    testBasicAuthOverwrite() {
%ifndef NoJson
        RestClientIo::RestClientIo rest = createClient();
        on_exit rest.close();

        # First set
        rest.setUserPassword("user1", "pass1");
        string expected1 = "Basic " + make_base64_string("user1:pass1");
        assertEq(expected1, rest.getDefaultHeaders().authorization);

        # Overwrite with different credentials
        rest.setUserPassword("user2", "pass2");
        string expected2 = "Basic " + make_base64_string("user2:pass2");
        assertEq(expected2, rest.getDefaultHeaders().authorization);
        # Verify the old credentials are gone
        assertEq(True, rest.getDefaultHeaders().authorization != expected1);
%endif
    }

    testBasicAuthTokenInteraction() {
%ifndef NoJson
        # Last writer wins: setToken overwrites setUserPassword and vice versa
        RestClientIo::RestClientIo rest = createClient();
        on_exit rest.close();

        # Set basic auth
        rest.setUserPassword("user", "pass");
        assertRegex("Basic", rest.getDefaultHeaders().authorization);

        # setToken should overwrite authorization header
        rest.setToken("Bearer", "my-token");
        assertEq("Bearer my-token", rest.getDefaultHeaders().authorization);

        # setUserPassword should overwrite back
        rest.setUserPassword("user2", "pass2");
        assertRegex("Basic", rest.getDefaultHeaders().authorization);

        # clearUserPassword should remove authorization
        rest.clearUserPassword();
        assertEq(True, !exists rest.getDefaultHeaders().authorization);
%endif
    }

    testBasicAuthClearIdempotent() {
        RestClientIo::RestClientIo rest = createClient();
        on_exit rest.close();

        # Clear without ever setting — should not throw
        rest.clearUserPassword();
        assertEq(True, !exists rest.getDefaultHeaders().authorization);

        # Set then clear twice
        rest.setUserPassword("user", "pass");
        rest.clearUserPassword();
        rest.clearUserPassword();
        assertEq(True, !exists rest.getDefaultHeaders().authorization);
    }

    # ---- Additional Phase 4 tests ----

    testSignedRequestWithBody() {
%ifndef NoJson
        RestClientIo::RestClientIo rest = createClient();
        on_exit rest.close();

        # Signer that includes body info — verify serialized body is passed
        code signer = auto sub (hash<auto> info) {
            return sprintf("body-len:%d,path:%s", info.body ? info.body.size() : 0, info.path);
        };

        hash<auto> body = {"key": "value"};
        hash<RestClient::RestResponseInfo> resp = rest.doSignedRequest(
            "x-signature", signer, "POST", "/echo/test", body);
        assertEq(200, resp.status_code);
        # Signature should contain body length > 0 (serialized JSON body)
        assertRegex("body-len:[1-9]", resp.body.request_headers."x-signature");
        assertRegex("path:", resp.body.request_headers."x-signature");
        # Verify original body was also sent
        assertEq("value", resp.body.body.key);
%endif
    }

    testSignedRequestWithConnectionPath() {
%ifndef NoJson
        RestClientIo::RestClientIo rest = createClient({
            "default_path": "/echo",
        });
        on_exit rest.close();

        # Signer should receive the path WITH connection_path prepended
        code signer = auto sub (hash<auto> info) {
            return "signed-path:" + info.path;
        };

        hash<RestClient::RestResponseInfo> resp = rest.doSignedRequest(
            "x-signature", signer, "GET", "/test", NOTHING);
        assertEq(200, resp.status_code);
        # The signer should have received /echo/test
        assertRegex("signed-path:/echo/test", resp.body.request_headers."x-signature");
        # The request path should also be /echo/test
        assertRegex("echo/test", resp.body.path);
%endif
    }

    testSignedRequestSignerThrows() {
%ifndef NoJson
        RestClientIo::RestClientIo rest = createClient();
        on_exit rest.close();

        code signer = auto sub (hash<auto> info) {
            throw "SIGNER-ERROR", "signing failed";
        };

        # Sync: exception should propagate
        assertThrows("SIGNER-ERROR", "signing failed", sub () {
            rest.doSignedRequest("x-signature", signer, "GET", "/echo/test", NOTHING);
        });

        # Async: exception should propagate at call time (not at get())
        assertThrows("SIGNER-ERROR", "signing failed", sub () {
            rest.doSignedRequestAsync("x-signature", signer, "GET", "/echo/test", NOTHING);
        });
%endif
    }

    testSignedRequestHdrExcludesSig() {
%ifndef NoJson
        RestClientIo::RestClientIo rest = createClient();
        on_exit rest.close();

        # Verify that the signer receives headers WITHOUT the signature header
        bool sig_absent_in_hdr = False;
        code signer = auto sub (hash<auto> info) {
            sig_absent_in_hdr = !info.hdr.hasKey("x-signature");
            return "test-sig";
        };

        rest.addDefaultHeaders({"x-custom": "val"});
        hash<RestClient::RestResponseInfo> resp = rest.doSignedRequest(
            "x-signature", signer, "GET", "/echo/test", NOTHING);
        assertEq(200, resp.status_code);
        # Signer should NOT have seen "x-signature" in the hdr param
        assertEq(True, sig_absent_in_hdr);
        # But the actual request should have both headers
        assertEq(True, exists resp.body.request_headers."x-signature");
        assertEq(True, exists resp.body.request_headers."x-custom");
%endif
    }

    # ---- Additional Phase 5 tests ----

    testProxyInvalidUrl() {
        # Proxy URL that fails to parse (no host after scheme)
        assertThrows("HTTPCLIENT-OPTION-ERROR", sub () {
            new HttpClientIo::HttpClientConnectionManager(
                <HttpClientIo::HttpClientConnectionManagerOptions>{
                    "proxy_url": "http://",
                }
            );
        });

        # Empty proxy URL should be treated as no proxy (no error)
        HttpClientIo::HttpClientConnectionManager mgr(
            <HttpClientIo::HttpClientConnectionManagerOptions>{
                "proxy_url": "",
            }
        );
        on_exit mgr.closeAll();
        assertEq("auto", mgr.getStats().protocol);
    }

    testProxyDefaultPort() {
        # HTTP proxy without port should default to 80
        HttpClientIo::HttpClientConnectionManager mgr(
            <HttpClientIo::HttpClientConnectionManagerOptions>{
                "proxy_url": "http://proxy.example.com",
            }
        );
        on_exit mgr.closeAll();
        # Manager created successfully with default port
        hash<auto> stats = mgr.getStats();
        assertEq("auto", stats.protocol);

        # HTTPS proxy without port should default to 443
        HttpClientIo::HttpClientConnectionManager mgr2(
            <HttpClientIo::HttpClientConnectionManagerOptions>{
                "proxy_url": "https://proxy.example.com",
            }
        );
        on_exit mgr2.closeAll();
        stats = mgr2.getStats();
        assertEq("auto", stats.protocol);
    }

    testProxyWithH1Protocol() {
        # H1 protocol with proxy should be accepted (no error)
        HttpClientIo::HttpClientConnectionManager mgr(
            <HttpClientIo::HttpClientConnectionManagerOptions>{
                "protocol": "h1",
                "proxy_url": "http://127.0.0.1:9999",
            }
        );
        on_exit mgr.closeAll();
        hash<auto> stats = mgr.getStats();
        assertEq("h1", stats.protocol);
    }

    testProxyWithH2Protocol() {
        # H2 protocol with proxy should be accepted (no error)
        HttpClientIo::HttpClientConnectionManager mgr(
            <HttpClientIo::HttpClientConnectionManagerOptions>{
                "protocol": "h2",
                "proxy_url": "http://127.0.0.1:9999",
            }
        );
        on_exit mgr.closeAll();
        hash<auto> stats = mgr.getStats();
        assertEq("h2", stats.protocol);
    }
}
