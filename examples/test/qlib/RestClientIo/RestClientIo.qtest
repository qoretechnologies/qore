        assertEq(200, resp.status_code);
        assertRegex("application/yaml", resp.body.request_headers.accept,
            "Accept header must be sent on the wire");
        assertRegex("Qore-RestClientIo/", resp.body.request_headers."user-agent",
            "User-Agent header must be sent on the wire");
%endif
    }

