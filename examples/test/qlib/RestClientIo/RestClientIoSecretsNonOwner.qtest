#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires RestClientIo
%requires RestClient
%requires ConnectionProvider

%exec-class RestClientIoSecretsNonOwnerTest

#! A sandboxed borrower of a REST client that other code created cannot read its options, OAuth2 options or tokens
#! (qore#7861)
/** The options that a client was created with hold its tokens, passwords, API keys and proxy credentials, and its OAuth2
    options its client secret and refresh token: getConstructorOptions(), getOAuth2Options() and getNewToken() are
    refused for code that a sandbox restricts and that is not the owner of the client (PERMISSION-DENIED), also for a
    copy made with copyWithUrl() and for the client that a connection of the host creates for restricted code that was
    lent the connection.  The owner, restricted code that owns its client, and the copies that the module makes use the
    methods as before.
*/

#! the secrets of the host
const Token = "SECRET-TOKEN";
const ProxyUrl = "http://puser:psecret@127.0.0.1:1";

#! the OAuth2 options of a client; the secret is the host's
const OAuth2Options = {
    "oauth2_grant_type": "client_credentials",
    "oauth2_client_id": "id",
    "oauth2_client_secret": "SECRET-CLIENT",
    "oauth2_token_url": "http://127.0.0.1:1/token",
    "skip_login": True,
};

#! the code of the borrower
const BorrowerCode = "%modern
%requires RestClientIo
%requires ConnectionProvider
const OAuth2Options = {
    \"oauth2_grant_type\": \"client_credentials\",
    \"oauth2_client_id\": \"id\",
    \"oauth2_client_secret\": \"own-secret\",
    \"oauth2_token_url\": \"http://127.0.0.1:1/token\",
    \"skip_login\": True,
};
#! calls a method of the lent client that gives its options or tokens; returns what happened
string sub take(RestClientIo::RestClientIo c, string what) {
    try {
        switch (what) {
            case \"getConstructorOptions\": c.getConstructorOptions(); break;
            case \"getOAuth2Options\": c.getOAuth2Options(); break;
            case \"getNewToken\": c.getNewToken(); break;
            case \"copyGetConstructorOptions\": c.copyWithUrl(\"http://127.0.0.1:2\").getConstructorOptions(); break;
            case \"copyGetOAuth2Options\": c.copyWithUrl(\"http://127.0.0.1:2\").getOAuth2Options(); break;
            default: throw \"UNKNOWN\", what;
        }
        return \"done\";
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
}
#! gets the client that a connection of the host creates for the borrower, and asks for its options; returns what
#! happened
string sub fromConnection(AbstractConnection conn) {
    object o;
    try {
        o = conn.getAsync(False);
    } catch (hash<ExceptionInfo> ex) {
        return \"getAsync: \" + ex.err + \": \" + ex.desc;
    }
    try {
        o.getConstructorOptions();
        o.getOAuth2Options();
        return \"done\";
    } catch (hash<ExceptionInfo> ex) {
        return ex.err;
    }
}
#! a restricted borrower that owns its client uses the methods; returns what happened
string sub own() {
    try {
        RestClientIo::RestClientIo c({\"url\": \"http://127.0.0.1:1\", \"no_connect\": True, \"token\": \"own-token\"}
            + OAuth2Options);
        if (c.getConstructorOptions().token != \"own-token\") {
            return \"no own option\";
        }
        if (c.getOAuth2Options().token != \"own-token\") {
            return \"no own OAuth2 option\";
        }
        RestClientIo::RestClientIo copy = cast<RestClientIo::RestClientIo>(c.copyWithUrl(\"http://127.0.0.1:2\"));
        if (copy.getConstructorOptions().token != \"own-token\") {
            return \"no option in the copy\";
        }
        try {
            c.getNewToken();
        } catch (hash<ExceptionInfo> ex) {
            # the owner takes the token: the request of the token endpoint, which nothing listens at, fails
            if (ex.err == \"PERMISSION-DENIED\") {
                rethrow;
            }
        }
        return \"done\";
    } catch (hash<ExceptionInfo> ex) {
        return ex.err + \": \" + ex.desc;
    }
}
";

class RestClientIoSecretsNonOwnerTest inherits QUnit::Test {
    constructor() : QUnit::Test("lent REST client: the borrower cannot take its options or tokens", "1.0", \ARGV) {
        addTestCase("the options, the OAuth2 options and the tokens are refused", \refusedTest());
        addTestCase("a restricted borrower that owns its client uses them", \borrowerOwnerTest());
        addTestCase("the code that owns the client uses them", \ownerTest());
        addTestCase("a connection of the host creates a client whose options are the host's", \connectionTest());
        set_return_value(main());
    }

    #! a sandboxed borrower
    private Program getBorrower() {
        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        SandboxManager sm();
        sm.setNetworkDefaultPolicy(False);
        # the OAuth2 token endpoint is on the loopback address; nothing connects to it
        sm.addNetworkAllowedIPRange("127.0.0.1/32");
        p.setSandboxManager(sm);
        p.parse(BorrowerCode, "borrower");
        return p;
    }

    #! a borrower that the parse options restrict from the NETWORK domain
    private Program getNoNetworkBorrower() {
        Program p(PO_NO_NETWORK | PO_NO_CHILD_PO_RESTRICTIONS);
        SandboxManager sm();
        p.setSandboxManager(sm);
        p.parse(BorrowerCode, "borrower-nn");
        return p;
    }

    #! a client that the host creates and lends
    private RestClientIo::RestClientIo getClient() {
        return new RestClientIo::RestClientIo({
            "url": "http://127.0.0.1:1",
            "no_connect": True,
            "token": Token,
            "proxy": ProxyUrl,
        } + OAuth2Options);
    }

    refusedTest() {
        RestClientIo::RestClientIo client = getClient();
        foreach Program p in (getBorrower(), getNoNetworkBorrower()) {
            foreach string what in ("getConstructorOptions", "getOAuth2Options", "getNewToken",
                    "copyGetConstructorOptions", "copyGetOAuth2Options") {
                assertEq("PERMISSION-DENIED", p.callFunction("take", client, what), what);
            }
        }
        # the host's options are as they were
        assertEq(Token, client.getConstructorOptions().token, "the host's token");
        assertEq(ProxyUrl, client.getConstructorOptions().proxy, "the host's proxy");
    }

    borrowerOwnerTest() {
        # a borrower that is restricted from the NETWORK domain cannot create a client of its own
        assertEq("done", getBorrower().callFunction("own"), "the borrower's own client");
    }

    ownerTest() {
        RestClientIo::RestClientIo client = getClient();
        assertEq(Token, client.getConstructorOptions().token, "the owner's options");
        assertEq(Token, client.getOAuth2Options().token, "the owner's OAuth2 options");
        assertEq("SECRET-CLIENT", client.getOAuth2Options().oauth2_client_secret, "the owner's client secret");
        RestClientIo::RestClientIo copy = cast<RestClientIo::RestClientIo>(client.copyWithUrl("http://127.0.0.1:2"));
        assertEq(Token, copy.getConstructorOptions().token, "the copy's options");
        assertEq("SECRET-CLIENT", cast<RestClientIo::RestClientIo>(client.copyWithUrl("http://127.0.0.1:3"))
            .getOAuth2Options().oauth2_client_secret, "the copy's OAuth2 options");
    }

    connectionTest() {
        # the client that the connection of the host creates for code that is restricted from the NETWORK domain and
        # was lent it is the host's (qore#7262), and has the host's token in its options, which the borrower does not
        # read
        RestClient::RestConnection lent("rest-conn", "", "http://127.0.0.1:1", {}, {"token": Token});
        assertEq("PERMISSION-DENIED", getNoNetworkBorrower().callFunction("fromConnection", lent),
            "a REST connection of the host");
        # the host's own use of its connection
        RestClient::RestConnection rest("rest-conn", "", "http://127.0.0.1:1", {}, {"token": Token});
        object o = rest.getAsync(False);
        assertEq(Token, o.getConstructorOptions().token, "the host's own async client");
    }
}
