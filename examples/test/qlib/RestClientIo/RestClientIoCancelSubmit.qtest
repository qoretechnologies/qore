#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# RestClientIoCancelSubmit.qtest Copyright 2026 Qore Technologies, s.r.o. — MIT License

%modern
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires RestClientIo
%exec-class RestClientIoCancelSubmitTest

#! A client that runs a hook just before and just after an async request is submitted
/** The hooks run in the thread that submits the request, inside the operation's submission step, so a cancel made
    there lands exactly in the window between the request going out and the operation recording its stream.
*/
class SubmitHookClient inherits RestClientIo {
    public {
        #! Runs before the request is submitted
        *code<nothing()> before_submit;
        #! Runs after the request has been submitted, before the operation has recorded its stream
        *code<nothing()> after_submit;
    }

    constructor(hash<auto> opts) : RestClientIo(opts) {
    }

    hash<auto> submitPreparedAsyncRequestAttemptWithNotifier(string method, string path, *hash<auto> hdr,
            hash<auto> prepared, EventNotifier notifier) {
        if (before_submit) {
            before_submit();
        }
        hash<auto> rv = RestClientIo::submitPreparedAsyncRequestAttemptWithNotifier(method, path, hdr, prepared,
            notifier);
        if (after_submit) {
            after_submit();
        }
        return rv;
    }
}

#! A server that accepts one connection, never answers and reports how the connection ended
class HoldingServer {
    public {
        int port;
        #! Receives True when the client closes the connection, False if it does not close it in time
        Queue closed();
    }

    private {
        Socket listener();
        Counter running();
    }

    #! The time the server waits for the client to close the connection
    const CloseWait = 30s;

    constructor() {
        listener.bind("127.0.0.1:0");
        listener.listen();
        port = listener.getSocketInfo().port;
        running.inc();
        background serveOne();
    }

    #! Waits until the connection has been served; every queue entry has been pushed when this returns
    waitDone() {
        running.waitForZero();
        listener.close();
    }

    private serveOne() {
        on_exit running.dec();
        Socket conn;
        try {
            conn = listener.accept(60s);
        } catch (hash<ExceptionInfo> ex) {
            closed.push(False);
            return;
        }
        on_exit conn.close();
        # nothing is sent, so reading ends only when the client closes the connection (or resets it); the request
        # is read as well, as a cancel can close the connection before or after the request has been sent
        bool is_closed = False;
        try {
            date deadline = now_us() + CloseWait;
            while (True) {
                conn.recv(1, max(1, (deadline - now_us()).durationMilliseconds()));
            }
        } catch (hash<ExceptionInfo> ex) {
            is_closed = ex.err == "SOCKET-CLOSED" || (ex.err == "SOCKET-RECV-ERROR" && ex.arg == ECONNRESET);
        }
        closed.push(is_closed);
    }
}

class RestClientIoCancelSubmitTest inherits QUnit::Test {
    constructor() : Test("RestClientIo cancellation around request submission", "1.0", \ARGV) {
        addTestCase("a cancel just after submission closes the request's connection", \testCancelAfterSubmit());
        addTestCase("a cancel just before submission closes the request's connection", \testCancelBeforeSubmit());
        set_return_value(main());
    }

    testCancelAfterSubmit() {
        cancelAroundSubmit(True);
    }

    testCancelBeforeSubmit() {
        cancelAroundSubmit(False);
    }

    #! Cancels a request from its submission hook and checks that its connection is closed
    /** The request's own timeout is an hour, so only the cancellation can close its connection.
    */
    private cancelAroundSubmit(bool after) {
        string ctx = after ? "after submission" : "before submission";
        HoldingServer server();
        on_exit server.waitDone();

        SubmitHookClient client({"url": "http://127.0.0.1:" + server.port});
        on_exit client.close();

        int caller_tid = gettid();
        # the abort callback that the request registers, handed to the hook
        Queue aborts();
        # receives the thread ID of each hook call
        Queue hook_threads();
        code<nothing()> hook = sub () {
            hook_threads.push(gettid());
            # submitted from the caller's thread, the request registers its abort callback only after this hook
            # returns; it is then cancelled from another thread, and the case reports the submitting thread
            if (gettid() == caller_tid) {
                background sub () { code<nothing()> abort = aborts.get(30s); abort(); }();
                return;
            }
            code<nothing()> abort = aborts.get(30s);
            abort();
        };
        if (after) {
            client.after_submit = hook;
        } else {
            client.before_submit = hook;
        }

        hash<ExceptionInfo> ex;
        try {
            client.restDoCancellableRequestTarget("POST", <RestClient::RestRequestTarget>{"path": "/held"},
                {"a": 1}, NOTHING, 3600000, code<nothing()> sub (code<nothing()> abort) {
                    aborts.push(abort);
                    return sub () {};
                });
            fail(ctx + ": the request returned instead of being cancelled");
        } catch (hash<ExceptionInfo> ex0) {
            ex = ex0;
        }
        assertEq("HTTPCLIENT-CANCELLED", ex.err, ctx);
        assertTrue(hook_threads.get(30s) != caller_tid, ctx + ": the request was submitted from another thread");
        assertTrue(server.closed.get(60s), ctx + ": the cancellation closes the request's connection");
    }
}
