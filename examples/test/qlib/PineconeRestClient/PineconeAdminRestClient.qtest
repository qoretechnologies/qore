%modern
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/PineconeRestClient.qm
%requires ../../../../qlib/HttpServer.qm
%requires ../../../../qlib/HttpServerUtil.qm
%requires ../../../../qlib/Logger
%requires json
%exec-class PineconeAdminConnectionTest

#! Deterministic OAuth2 and resource endpoints, recording each completed request under a mutex
class PineconeAdminHandler inherits AbstractHttpRequestHandler {
    private {
        Mutex lck();
        list<hash<auto>> calls = ();
        int tokens = 0;
        bool reject = False;
        string token_type = "Bearer";
    }
    hash<auto> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        AutoLock al(lck);
        *hash<auto> data;
        if (body) {
            data = hdr."content-type" =~ /json/ ? parse_json(body) : parse_uri_query("?" + body).params;
        }
        string path = hdr.path.startsWith("/") ? hdr.path : "/" + hdr.path;
        calls += {"path": path, "method": hdr.method, "headers": hdr, "body": data};
        if (path == "/oauth/token") {
            if (data.client_id != "test-client" || data.client_secret != "test-secret"
                    || data.grant_type != "client_credentials"
                    || data.audience != PineconeAdminRestClientBase::Audience) {
                return makeResponse(401, make_json({"error": "invalid_client"}), {"Content-Type": MimeTypeJson});
            }
            ++tokens;
            reject = False;
            return makeResponse(200, make_json({"access_token": sprintf("admin-token-%d", tokens),
                "token_type": token_type, "expires_in": 3600}), {"Content-Type": MimeTypeJson});
        }
        if (reject || hdr.authorization != sprintf("Bearer admin-token-%d", tokens)) {
            return makeResponse(401, make_json({"error": "invalid_token"}), {"Content-Type": MimeTypeJson});
        }
        return makeResponse(200, make_json({"data": (), "ok": True}), {"Content-Type": MimeTypeJson});
    }
    list<hash<auto>> getCalls() {
        AutoLock al(lck);
        return calls;
    }
    invalidate() {
        AutoLock al(lck);
        reject = True;
    }
    setTokenType(string token_type) {
        AutoLock al(lck);
        self.token_type = token_type;
    }
}

#! Records persistence callbacks independently of the thread executing the login
class PineconeAdminTokenUpdates {
    private {
        Mutex lck();
        list<hash<auto>> updates = ();
    }
    record(hash<auto> options) {
        AutoLock al(lck);
        updates += options;
    }
    list<hash<auto>> getUpdates() {
        AutoLock al(lck);
        return updates;
    }
}
class PineconeAdminConnectionTest inherits QUnit::Test {
    private {
        *HttpServer server;
        PineconeAdminHandler handler;
        string url;
    }
    constructor() : Test("Pinecone Admin connection", "1.0") {
        addTestCase("connection discovery, sensitive options and OAuth2 capabilities", \metadataTest());
        addTestCase("synchronous OAuth2 token acquisition and renewal", \syncTest());
        addTestCase("asynchronous OAuth2 token acquisition and renewal", \asyncTest());
        addTestCase("connection ping accepts and rejects credentials", \pingTest());
        addTestCase("fixed audience and incompatible authentication", \optionsTest());
        set_return_value(main());
    }
    setUp() {
        server = new HttpServer(<HttpServerOptionInfo>{"logger": new Logger("pinecone-admin-test", LoggerLevel::getLevelError()), "debug": True});
        handler = new PineconeAdminHandler();
        server.setDefaultHandler("admin", handler);
        int port = server.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        url = sprintf("http://127.0.0.1:%d", port);
    }
    tearDown() {
        delete server;
    }
    private hash<auto> options() {
        return {"url": url, "oauth2_token_url": url + "/oauth/token",
            "oauth2_client_id": "test-client", "oauth2_client_secret": "test-secret"};
    }
    private metadataTest() {
        hash<ConnectionSchemeInfo> scheme = ConnectionSchemeCache::getScheme("pinecone-admin");
        assertTrue(scheme.options.oauth2_client_id.sensitive);
        assertTrue(scheme.options.oauth2_client_secret.sensitive);
        assertEq("client_credentials", scheme.options.oauth2_grant_type.default_value);
        assertEq(PineconeAdminRestClientBase::TokenUrl, scheme.options.oauth2_token_url.default_value);
        assertEq("/admin/projects", scheme.options.ping_path.default_value);
        PineconeAdminRestConnection c("admin", "test", PineconeAdminRestConnection::DefaultUrl, {}, {
            "oauth2_client_id": "test-client", "oauth2_client_secret": "test-secret"});
        hash<auto> info = c.getExtendedInfo();
        assertTrue(info.oauth2);
        assertTrue(info.oauth2_client_credentials);
        assertFalse(info.oauth2_auth);
        assertEq("client_credentials", info.oauth2_grant_type);
        assertEq("PineconeAdmin", c.getInfo().app);
        assertEq(0, handler.getCalls().size());
    }
    private checkCalls() {
        list<hash<auto>> calls = handler.getCalls();
        list<hash<auto>> token_calls = select calls, $1.path == "/oauth/token";
        assertEq(2, token_calls.size());
        foreach hash<auto> c in (token_calls) {
            assertEq("POST", c.method);
            assertEq("client_credentials", c.body.grant_type);
            assertEq("test-client", c.body.client_id);
            assertEq("test-secret", c.body.client_secret);
            assertEq(PineconeAdminRestClientBase::Audience, c.body.audience);
            assertFalse(c.body.hasKey("refresh_token"));
        }
        assertEq("Bearer admin-token-2", calls.last().headers.authorization);
        assertEq(PineconeRestClientBase::ApiVersion, calls.last().headers."x-pinecone-api-version");
        assertNothing(calls.last().headers."api-key");
    }
    private syncTest() {
        PineconeAdminTokenUpdates updates();
        date start = now_us();
        PineconeAdminRestClient c(options() + {"update_options": \updates.record()});
        assertTrue(c.restGet("/admin/projects").body.ok);
        assertEq(1, updates.getUpdates().size());
        checkUpdate(updates.getUpdates()[0], "admin-token-1", "Bearer", start, now_us());
        handler.invalidate();
        handler.setTokenType("bearer");
        c.setToken("Bearer", "expired-token", NOTHING, now_us() - 15m);
        start = now_us();
        assertTrue(c.restGet("/admin/projects").body.ok);
        assertEq(2, updates.getUpdates().size());
        checkUpdate(updates.getUpdates()[1], "admin-token-2", NOTHING, start, now_us());
        checkCalls();
    }
    private asyncTest() {
        PineconeAdminTokenUpdates updates();
        date start = now_us();
        # Both the previous token and its type are absent on this first login.
        PineconeAdminRestClientIo c(options() + {"update_options": \updates.record()});
        on_exit c.close();
        assertTrue(c.restGet("/admin/projects").body.ok);
        assertEq(1, updates.getUpdates().size());
        checkUpdate(updates.getUpdates()[0], "admin-token-1", "Bearer", start, now_us());
        handler.invalidate();
        handler.setTokenType("bearer");
        c.setToken("Bearer", "expired-token", NOTHING, now_us() - 15m);
        start = now_us();
        assertTrue(c.restGet("/admin/projects").body.ok);
        assertEq(2, updates.getUpdates().size());
        checkUpdate(updates.getUpdates()[1], "admin-token-2", NOTHING, start, now_us());
        checkCalls();
    }
    private checkUpdate(hash<auto> options, string token, *string token_type, date start, date finish) {
        hash<auto> expected = {"token": token};
        if (token_type) {
            expected.token_type = token_type;
        }
        # The callback must not invent a refresh token or persist a casing-only type change.
        assertEq(expected, options - "oauth2_token_expiry");
        assertEq(NT_DATE, options.oauth2_token_expiry.typeCode());
        assertTrue(options.oauth2_token_expiry >= start + 1h);
        assertTrue(options.oauth2_token_expiry <= finish + 1h);
    }
    private pingTest() {
        PineconeAdminTokenUpdates good_updates();
        PineconeAdminRestConnection good("admin", "test", url, {}, options() - "url");
        good.setUpdateOptionsCode(\good_updates.record());
        date start = now_us();
        assertTrue(good.ping(True).ok);
        assertEq(1, good_updates.getUpdates().size());
        checkUpdate(good_updates.getUpdates()[0], "admin-token-1", "Bearer", start, now_us());
        assertEq("/admin/projects", handler.getCalls().last().path);
        PineconeAdminTokenUpdates bad_updates();
        PineconeAdminRestConnection bad("admin-bad", "test", url, {},
            (options() - "url") + {"oauth2_client_secret": "wrong-secret"});
        bad.setUpdateOptionsCode(\bad_updates.record());
        hash<PingInfo> result = bad.ping();
        assertFalse(result.ok);
        assertTrue(result.info =~ /401|invalid_client/);
        assertEq("/oauth/token", handler.getCalls().last().path);
        assertEq(0, bad_updates.getUpdates().size());
    }
    private optionsTest() {
        hash<auto> o = PineconeAdminRestClientBase::getOptions({
            "oauth2_token_args": {"audience": "wrong", "custom": "kept"}});
        assertEq(PineconeAdminRestClientBase::Audience, o.oauth2_token_args.audience);
        assertEq("kept", o.oauth2_token_args.custom);
        assertThrows("PINECONE-ADMIN-OPTION-ERROR", \PineconeAdminRestClientBase::getOptions(), ({"apikey": "key"},));
        assertThrows("PINECONE-ADMIN-OPTION-ERROR", \PineconeAdminRestClientBase::getOptions(),
            ({"oauth2_grant_type": "authorization_code"},));
        assertEq("key", PineconeRestClientBase::getOptions({"apikey": "key"}).headers."Api-Key");
    }
}
