# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"

%requires yaml
%requires QUnit
%requires HttpServer
%requires Logger
%requires Mime
%requires YamlRpcHandler
%requires YamlRpcClientIo

%exec-class YamlRpcClientIoTest

class TestYamlRpcHandler inherits YamlRpcHandler {
    public {
        const ApiMethods = (
            {
                "name": "^system\\.echo$",
                "text": "system.echo",
                "function": \TestYamlRpcHandler::echo(),
                "help": "echos the argument",
                "logopt": 0,
            }, {
                "name": "^system\\.error$",
                "text": "system.error",
                "function": \TestYamlRpcHandler::error(),
                "help": "throws an error",
                "logopt": 0,
            }, {
                "name": "^system\\.add$",
                "text": "system.add",
                "function": \TestYamlRpcHandler::add(),
                "help": "adds two numbers",
                "logopt": 0,
            },
        );
    }

    constructor(*code log) : YamlRpcHandler(new PermissiveAuthenticator(), ApiMethods, NOTHING, False,
            NOTHING, log) {
    }

    static auto echo(auto arg) {
        return arg;
    }

    static nothing error(auto arg) {
        throw "TEST-ERROR", arg;
    }

    static int add(int a, int b) {
        return a + b;
    }
}

public class YamlRpcClientIoTest inherits QUnit::Test {
    private {
        HttpServer server;
        YamlRpcClientIo::YamlRpcClientIo client;
        TestYamlRpcHandler handler;
        int port;
    }

    public {
        const SimpleHashValue = {"a": 1};
        const LargerHashValue = {"a": 1, "b": "two"};
        const HashValue = {"a": (1, "two")};
        const ListValue = (1, "two", 3.1);
        const AllValues = (1, "two", ListValue, SimpleHashValue, LargerHashValue, HashValue);
    }

    constructor() : Test("YamlRpcClientIo test", "1.0") {
        addTestCase("basic call test", \testBasicCall());
        addTestCase("callArgs test", \testCallArgs());
        addTestCase("callWithInfo test", \testCallWithInfo());
        addTestCase("callArgsWithInfo test", \testCallArgsWithInfo());
        addTestCase("makeRequest test", \testMakeRequest());
        addTestCase("error handling test", \testErrorHandling());
        addTestCase("connection provider test", \testConnectionProvider());
        addTestCase("connection hash constructor test", \testConnectionHashConstructor());
        addTestCase("connection scheme info test", \testConnectionSchemeInfo());
        addTestCase("connection serialization test", \testConnectionSerialization());
        addTestCase("legacy constructor test", \testLegacyConstructor());
        addTestCase("URL scheme mapping test", \testUrlSchemeMapping());
        addTestCase("default path test", \testDefaultPath());
        addTestCase("constructor negative test", \testConstructorNegative());
        addTestCase("close and reuse test", \testCloseAndReuse());
        addTestCase("multi-arg varargs test", \testMultiArgVarargs());
        addTestCase("custom headers test", \testCustomHeaders());
        addTestCase("data types test", \testDataTypes());
        addTestCase("error message test", \testErrorMessage());

        set_return_value(main());
    }

    globalSetUp() {
        Logger logger("test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            logger.addAppender(new TestAppender());
        }
        hash<HttpServerOptionInfo> http_opts = <HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        };
        server = new HttpServer(http_opts);
        handler = new TestYamlRpcHandler(sub (string msg) { logger.info(msg); });
        server.setHandler("yamlrpc-handler", "", MimeTypeYamlRpc, handler);
        server.setDefaultHandler("yamlrpc-handler", handler);
        port = server.addListener(<HttpListenerOptionInfo>{"service": 0}).port;

        client = new YamlRpcClientIo::YamlRpcClientIo("http://localhost:" + port + "/YAML");
    }

    globalTearDown() {
        client.close();
        server.stop();
        delete server;
    }

    testBasicCall() {
        # Test basic call with single arg
        auto h = client.call("system.echo", "hello");
        assertEq("hello", h.result, "should echo back the argument");

        # Test call with no args
        h = client.call("system.echo");
        assertEq(NOTHING, h.result, "no args should return nothing");

        # Test call with hash arg
        h = client.call("system.echo", SimpleHashValue);
        assertEq(SimpleHashValue, h.result, "should echo back hash");

        # Test call with list arg
        h = client.call("system.echo", ListValue);
        assertEq(ListValue, h.result, "should echo back list");
    }

    testCallArgs() {
        # Test callArgs with single arg
        auto h = client.callArgs("system.echo", "hello");
        assertEq("hello", h.result, "callArgs should echo back argument");

        # Test callArgs with list as multiple positional params -- use system.add which takes two ints
        h = client.callArgs("system.add", (3, 4));
        assertEq(7, h.result, "callArgs with list should expand as positional params");

        # Test callArgs with hash
        h = client.callArgs("system.echo", SimpleHashValue);
        assertEq(SimpleHashValue, h.result, "callArgs should echo back hash");

        # Test callArgs with no args
        h = client.callArgs("system.echo");
        assertEq(NOTHING, h.result, "callArgs with no args should return nothing");
    }

    testCallWithInfo() {
        hash<auto> info;
        auto h = client.callWithInfo(\info, "system.echo", "info-test");

        assertEq("info-test", h.result, "should echo back the argument");

        # Verify info hash is populated
        assertTrue(info.request.val(), "info.request should be set");
        assertTrue(info.request.find("system.echo") >= 0, "request should contain method name");
        assertTrue(info.request_headers instanceof hash, "info.request_headers should be a hash");
        assertEq(MimeTypeYamlRpc + ";charset=utf-8", info.request_headers."Content-Type",
            "should have Content-Type header");
        assertEq(200, info.response_code, "info.response_code should be 200");
        assertTrue(info.response.val(), "info.response should be set");
        assertTrue(info.response_headers instanceof hash, "info.response_headers should be a hash");
    }

    testCallArgsWithInfo() {
        hash<auto> info;
        auto h = client.callArgsWithInfo(\info, "system.echo", "args-info-test");

        assertEq("args-info-test", h.result, "should echo back the argument");
        assertTrue(info.request.val(), "info.request should be set");
        assertEq(200, info.response_code, "info.response_code should be 200");
    }

    testMakeRequest() {
        # Test static makeRequest method
        string req = YamlRpcClientIo::YamlRpcClientIo::makeRequest("test.method", ("arg1", "arg2"));
        hash<auto> parsed = parse_yaml(req);
        assertEq("test.method", parsed.method);
        assertEq(("arg1", "arg2"), parsed.params);

        # Test with no arguments
        req = YamlRpcClientIo::YamlRpcClientIo::makeRequest("noargs", NOTHING);
        parsed = parse_yaml(req);
        assertEq("noargs", parsed.method);

        # Test with complex arguments
        hash<auto> complex_arg = {
            "nested": {"key": "value"},
            "list": (1, 2, 3),
        };
        req = YamlRpcClientIo::YamlRpcClientIo::makeRequest("complex", complex_arg);
        parsed = parse_yaml(req);
        assertEq("complex", parsed.method);
        assertEq(complex_arg, parsed.params);

        # Test with YAML flags
        req = YamlRpcClientIo::YamlRpcClientIo::makeRequest("test", "arg", YAML::Canonical);
        parsed = parse_yaml(req);
        assertEq("test", parsed.method);
    }

    testErrorHandling() {
        # Test YAML-RPC error response (server returns error in YAML-RPC format)
        auto h = client.call("system.error", "test error message");
        assertTrue(exists h.error, "should have error in response");
        assertEq(104, h.error.code, "should be error code 104");
    }

    testConnectionProvider() {
        string url = "yamlrpcios://localhost:" + port + "/YAML";
        YamlRpcIoConnection conn("test", "test connection", url, {"monitor": False});
        YamlRpcClientIo::YamlRpcClientIo conn_client = conn.get(False);

        assertEq("yamlrpcio", conn.getType(), "connection type should be yamlrpcio");
        assertEq("https://localhost:" + port + "/YAML", conn_client.getUrl(),
            "URL should be mapped to https");

        # Test with non-SSL scheme
        url = "yamlrpcio://localhost:" + port + "/YAML";
        conn = new YamlRpcIoConnection("test-http", "HTTP test", url, {"monitor": False});
        conn_client = conn.get(False);
        assertEq("http://localhost:" + port + "/YAML", conn_client.getUrl(),
            "URL should be mapped to http");

        # Test that the connected client works
        auto h = conn_client.call("system.echo", "connection-test");
        assertEq("connection-test", h.result, "connected client should work");
    }

    testConnectionHashConstructor() {
        hash<auto> config = {
            "name": "hash-test",
            "display_name": "Hash Test Connection",
            "short_desc": "Short description",
            "desc": "Long description",
            "url": "yamlrpcio://localhost:" + port + "/YAML",
        };

        YamlRpcIoConnection conn(config, {"monitor": False});
        assertEq("yamlrpcio", conn.getType(), "connection type from hash constructor");

        YamlRpcClientIo::YamlRpcClientIo conn_client = conn.get(False);
        auto h = conn_client.call("system.echo", "hash-ctor-test");
        assertEq("hash-ctor-test", h.result, "client from hash constructor should work");
    }

    testConnectionSchemeInfo() {
        hash<ConnectionSchemeInfo> scheme_info = YamlRpcIoConnection::ConnectionScheme;

        assertTrue(exists scheme_info.display_name, "should have display_name");
        assertTrue(exists scheme_info.short_desc, "should have short_desc");
        assertTrue(exists scheme_info.desc, "should have desc");
        assertTrue(exists scheme_info.cls, "should have cls");
        assertTrue(exists scheme_info.options, "should have options");
        assertTrue(exists scheme_info.schemes, "should have schemes");
        assertTrue(exists scheme_info.base_scheme_map, "should have base_scheme_map");

        # Verify schemes
        assertTrue(scheme_info.schemes.yamlrpcio, "should support yamlrpcio");
        assertTrue(scheme_info.schemes.yamlrpcios, "should support yamlrpcios");

        # Verify base scheme map
        assertEq("yamlrpcios", scheme_info.base_scheme_map.https, "https -> yamlrpcios");
        assertEq("yamlrpcio", scheme_info.base_scheme_map.http, "http -> yamlrpcio");
    }

    testConnectionSerialization() {
        string url = "yamlrpcio://localhost:" + port + "/YAML";
        YamlRpcIoConnection conn("serialize-test", "test", url, {"monitor": False});

        # Test serialization round-trip
        YamlRpcIoConnection conn2 = Serializable::deserialize(conn.serialize());
        assertEq(conn.url, conn2.url, "URL should survive serialization");
        assertEq("yamlrpcio", conn2.getType(), "type should survive serialization");
    }

    testLegacyConstructor() {
        # Test hash-based constructor (legacy compatible)
        auto legacy_client = new YamlRpcClientIo::YamlRpcClientIo(
            {"url": "http://localhost:" + port, "timeout": 30000});
        auto h = legacy_client.call("system.echo", "legacy-test");
        assertEq("legacy-test", h.result, "legacy constructor should work");
        legacy_client.close();
    }

    testUrlSchemeMapping() {
        # Test that yamlrpc:// and yamlrpcs:// schemes are mapped
        auto yrpc_client = new YamlRpcClientIo::YamlRpcClientIo(
            "yamlrpc://localhost:" + port + "/YAML");
        assertEq("http://localhost:" + port + "/YAML", yrpc_client.getUrl(),
            "yamlrpc:// should map to http://");
        auto h = yrpc_client.call("system.echo", "scheme-test");
        assertEq("scheme-test", h.result, "yamlrpc:// client should work");
        yrpc_client.close();

        # Test yamlrpcio:// scheme
        yrpc_client = new YamlRpcClientIo::YamlRpcClientIo(
            "yamlrpcio://localhost:" + port + "/YAML");
        assertEq("http://localhost:" + port + "/YAML", yrpc_client.getUrl(),
            "yamlrpcio:// should map to http://");
        yrpc_client.close();

        # Test yamlrpcs:// scheme
        yrpc_client = new YamlRpcClientIo::YamlRpcClientIo(
            "yamlrpcs://localhost:" + port + "/YAML");
        assertEq("https://localhost:" + port + "/YAML", yrpc_client.getUrl(),
            "yamlrpcs:// should map to https://");
        yrpc_client.close();

        # Test yamlrpcios:// scheme
        yrpc_client = new YamlRpcClientIo::YamlRpcClientIo(
            "yamlrpcios://localhost:" + port + "/YAML");
        assertEq("https://localhost:" + port + "/YAML", yrpc_client.getUrl(),
            "yamlrpcios:// should map to https://");
        yrpc_client.close();
    }

    testDefaultPath() {
        # URL without path should get /YAML appended
        auto path_client = new YamlRpcClientIo::YamlRpcClientIo(
            "http://localhost:" + port);
        assertTrue(path_client.getUrl().find("/YAML") >= 0, "should have /YAML in URL");
        path_client.close();

        # URL with custom path
        path_client = new YamlRpcClientIo::YamlRpcClientIo(
            "http://localhost:" + port + "/custom");
        assertEq("http://localhost:" + port + "/custom", path_client.getUrl(),
            "should preserve custom path");
        path_client.close();

        # Custom default_path option
        path_client = new YamlRpcClientIo::YamlRpcClientIo(
            "http://localhost:" + port, {"default_path": "RPC"});
        assertTrue(path_client.getUrl().find("/RPC") >= 0, "should use custom default_path");
        path_client.close();
    }

    testConstructorNegative() {
        # Missing URL in hash constructor
        assertThrows("YAMLRPCCLIENTIO-ERROR", sub () {
            new YamlRpcClientIo::YamlRpcClientIo({});
        });

        # Empty URL in hash constructor
        assertThrows("YAMLRPCCLIENTIO-ERROR", sub () {
            new YamlRpcClientIo::YamlRpcClientIo({"url": ""});
        });
    }

    testCloseAndReuse() {
        # Create a client, use it, close it, then use it again
        auto reuse_client = new YamlRpcClientIo::YamlRpcClientIo(
            "http://localhost:" + port + "/YAML");
        auto h = reuse_client.call("system.echo", "before-close");
        assertEq("before-close", h.result, "call before close should work");

        reuse_client.close();

        h = reuse_client.call("system.echo", "after-close");
        assertEq("after-close", h.result, "call after close should work (reconnect on demand)");
        reuse_client.close();
    }

    testMultiArgVarargs() {
        # Test call() with multiple varargs expanding to positional params
        auto h = client.call("system.add", 10, 20);
        assertEq(30, h.result, "call with multiple varargs should work");
    }

    testCustomHeaders() {
        # Test that custom headers option is accepted and doesn't break requests
        auto hdr_client = new YamlRpcClientIo::YamlRpcClientIo(
            "http://localhost:" + port + "/YAML",
            {"headers": {"X-Custom-Header": "test-value"}});
        auto h = hdr_client.call("system.echo", "header-test");
        assertEq("header-test", h.result, "client with custom headers should work");
        hdr_client.close();
    }

    testDataTypes() {
        # Test various data types round-trip through YAML-RPC
        foreach auto v in (AllValues) {
            auto h = client.call("system.echo", v);
            assertEq(v, h.result, v.type() + " value should round-trip");
        }
    }

    testErrorMessage() {
        # Test YAML-RPC error response includes error message
        auto h = client.call("system.error", "detailed error info");
        assertTrue(exists h.error, "should have error in response");
        assertEq(104, h.error.code, "should be error code 104");
        assertTrue(h.error.message.val(), "error message should not be empty");
        assertTrue(h.error.message.find("TEST-ERROR") >= 0, "error message should include exception name");
    }
}

class TestAppender inherits LoggerAppenderWithLayout {
    constructor() : LoggerAppenderWithLayout("test", new LoggerLayoutPattern("%d T%t [%p]: %m%n")) {
        open();
    }

    processEventImpl(int type, auto params) {
        switch (type) {
            case EVENT_LOG:
                print(params);
                break;
        }
    }
}
