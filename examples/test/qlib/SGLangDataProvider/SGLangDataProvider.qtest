#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%allow-injection

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires DataProvider
%requires SGLangDataProvider

%exec-class SGLangDataProviderTest

public class SGLangDataProviderTest inherits QUnit::Test {
    public {
        const ActionNames = ("chat-completion", "create-embeddings", "flush-cache", "generate", "server-info");
    }

    constructor() : Test("SGLangDataProvider Test", "1.0") {
        addTestCase("factory, app and actions are registered", \registrationTest());
        addTestCase("read-only actions declare that they change nothing", \readOnlyActionsTest());
        set_return_value(main());
    }

    private registrationTest() {
        assertEq("sglang", DataProvider::getFactory("sglang").getInfo().name);
        hash<DataProviderAppInfo> app = DataProviderActionCatalog::getApp(SGLangDataProvider::AppName);
        assertEq("sglang", app.scheme);
        list<hash<DataProviderActionInfo>> actions = select DataProviderActionCatalog::getActions(
            SGLangDataProvider::AppName), $1.action != AbstractDataProvider::GenericApiCallActionName;
        assertEq(ActionNames, sort(map $1.action, actions));
        map assertEq(DPAT_API, $1.action_code, $1.action), actions;
    }

    #! chat, embeddings and generation are stateless inference and server-info is a GET; flush-cache changes the
    #! state of the server (qore#7454)
    private readOnlyActionsTest() {
        foreach string name in (("chat-completion", "create-embeddings", "generate", "server-info")) {
            hash<DataProviderActionInfo> action =
                DataProviderActionCatalog::getAppActionEx(SGLangDataProvider::AppName, name);
            assertEq(NT_BOOLEAN, action.mutates_state.typeCode(), name);
            assertFalse(action.mutates_state, name);
            assertFalse(DataProviderActionCatalog::actionMutatesState(action), name);
        }
        hash<DataProviderActionInfo> action =
            DataProviderActionCatalog::getAppActionEx(SGLangDataProvider::AppName, "flush-cache");
        assertTrue(DataProviderActionCatalog::actionMutatesState(action));
    }
}
