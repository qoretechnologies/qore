%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"

%requires HttpServer
%requires Logger
%requires Mime
%requires yaml
%requires DataStreamUtil
%requires Connect
%requires ConnectDataProvider
%requires QUnit

%requires HttpClientIo

%requires HttpServerAsyncIo

%exec-class ConnectDataProviderTest

