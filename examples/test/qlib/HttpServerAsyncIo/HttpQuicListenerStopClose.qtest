    constructor() : QUnit::Test("HttpQuicListenerStopClose", "1.0") {
        addTestCase("stopping the controller releases the port of an HTTP/3 listener", \testStopReleasesPort());
        set_return_value(main());
    }

    testStopReleasesPort() {
        AsyncSocketIoController io_ctrl(False);
        on_exit io_ctrl.stop();
        HttpAsyncSocketIoController ctrl(io_ctrl);
        # the test's reference to the listener socket
        Socket udp();
        udp.bindINET("127.0.0.1", "0", False, AF_INET, SOCK_DGRAM);
        int port = udp.getSocketInfo().port;
        ctrl.addQuicListener(udp, new QuietTarget(), CertPem, KeyPem, new QuietListener());

        ctrl.stop();

        Socket probe();
        on_exit probe.close();
        try {
            probe.bindINET("127.0.0.1", string(port), False, AF_INET, SOCK_DGRAM);
        } catch (hash<ExceptionInfo> ex) {
            fail(sprintf("the port of the stopped HTTP/3 listener is still bound (or another process took it): "
                "%s: %s", ex.err, ex.desc));
        }
        assertFalse(udp.isOpen(), "the listener socket is closed");
    }
}
