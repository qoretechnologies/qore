# test-platform: macos - UDP socket close and port release of an HTTP/3 listener when the async I/O controller stops

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires AsyncSocketIo
%requires HttpServerUtil
%requires HttpServerAsyncIo

%exec-class HttpQuicListenerStopCloseTest

#! A target that receives no event: no client connects
class QuietTarget inherits HttpAsyncTarget {
    hash<HttpRequestResultInfo> onHttpRequest(hash<HttpConnectionInfo> info) {
        throw "UNEXPECTED", "no request is expected";
    }
    onIdleTimeout(Socket sock, *HttpServer::HttpListenerInterface listener, hash<auto> cx) {
    }
    onError(Socket sock, hash<ExceptionInfo> ex, *HttpServer::HttpListenerInterface listener, *hash<auto> cx) {
    }
    onSseDisconnect(Socket sock, *HttpServer::HttpListenerInterface listener, hash<auto> cx) {
    }
    onWebSocketFrame(Socket sock, hash<WebSocketFrameInfo> frame, *HttpServer::HttpListenerInterface listener,
            hash<auto> cx) {
    }
    onWebSocketClose(Socket sock, int code, string reason, *HttpServer::HttpListenerInterface listener,
            hash<auto> cx) {
    }
}

#! The HTTP listener that a QUIC listener is registered for
class QuietListener inherits HttpServer::HttpListenerInterface {
    log(string fmt, ...) {
    }
    logError(string fmt, ...) {
    }
    addUserThreadContext(hash<auto> uctx) {
    }
    auto removeUserThreadContext(*string k) {
    }
}

#! Stopping the controller closes the UDP socket of an HTTP/3 listener (qore#5812)
/** Otherwise the socket is closed only when its last reference goes, an unknown time after stop() returns, and its
    port stays bound: a client that sends a request again on a new connection reaches whatever binds the port next.
    The test keeps its own reference to the socket, so without the close the port stays bound.
*/
