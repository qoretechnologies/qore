    Permission is hereby granted, free of charge, to any person obtaining a
    copy of this software and associated documentation files (the "Software"),
    to deal in the Software without restriction, including without limitation
    the rights to use, copy, modify, merge, publish, distribute, sublicense,
    and/or sell copies of the Software, and to permit persons to whom the
    Software is furnished to do so, subject to the following conditions:

    The above copyright notice and this permission notice shall be included in
    all copies or substantial portions of the Software.

    THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
    IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
    FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
    AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
    LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
    FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
    DEALINGS IN THE SOFTWARE.

    qore#5991: a connection whose request returns while its listener is being removed is ended, not registered on
    the removed listener.  HttpAsyncSocketIoController::removeListener() cancels the connections of the listener that
    it finds; the connection of a request that returns after that is submitted after it, and was registered and kept
    running: an SSE stream kept delivering events on the removed listener, and a keep-alive connection kept serving
    requests.

    The race is made deterministic: the server's async target is wrapped, and the wrapper returns the request's
    result only once the controller has logged the removal of the listener, which another thread runs with
    HttpServer::stopListenerID() (the stop itself waits for the request).

    The SSE case is run over HTTP/1.1, HTTP/2 and HTTP/3: a stream of an HTTP/2 or HTTP/3 connection is added to the
    connection's operation rather than submitted, and that operation, which the removal cancels (HTTP/2) or whose
    streams it ends (HTTP/3), must end a stream added after that too.
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires Logger
%requires HttpServerUtil
%requires HttpServerAsyncIo
%requires HttpServer
%requires ServerSentEventHandler
%requires HttpClientIo
%requires HttpClientStreamingIo
%requires ../../TestCertificates.qm

%exec-class HttpListenerRemovalRaceTest

#! Upper bound for any wait that a regression turns into a hang
const HangTimeout = 30s;

#! Signals the removal of the listeners of a listener ID from the controller's log
/** An HTTP/3 listener is a TCP listener and the QUIC listener paired with it, which the controller removes one after
    the other; HttpServer removes each of them twice (when the listener stops and once it has stopped), so the
    listeners are counted by their hash.
*/
class RemovalSignal inherits LoggerAppenderWithLayout {
    public {
        Counter removed;
    }

    private {
        hash<string, bool> seen;
        Mutex lck();
    }

    constructor(int listeners) : LoggerAppenderWithLayout("removal-signal", new LoggerLayoutPattern("%m")) {
        removed = new Counter(listeners);
        open();
    }

    processEventImpl(int type, auto params) {
        if (type != EVENT_LOG) {
            return;
        }
        *string lhash = (params =~ x/Removed listener "([0-9a-f]+)"/)[0];
        if (!lhash) {
            return;
        }
        AutoLock al(lck);
        if (!seen{lhash} && removed.getCount()) {
            seen{lhash} = True;
            removed.dec();
        }
    }
}

#! Records the SSE connections registered with the handler
class RaceSseHandler inherits ServerSentEventHandler::ServerSentEventHandler {
    public {
        *ServerSentEventHandler::ServerSentEventConnection conn;
        Counter registered(1);
        Counter deregistered(1);
    }

    constructor() : ServerSentEventHandler::ServerSentEventHandler({"data": "none"}) {
    }

    connectionRegisteredImpl(ServerSentEventHandler::ServerSentEventConnection conn) {
        self.conn = conn;
        registered.dec();
    }

    deregisterConnectionImpl(ServerSentEventHandler::ServerSentEventConnection conn) {
        if (deregistered.getCount()) {
            deregistered.dec();
        }
    }
}

#! Returns a plain response, so that the connection stays open (keep-alive)
class RacePlainHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(HttpListenerInterface listener, Socket s, hash<auto> cx,
            hash<auto> hdr, *data body) {
        return makeResponse(200, "ok", {"Content-Type": MimeTypeText});
    }
}

#! Returns the result of the request on \a path only once the listener has been removed
class RaceTarget inherits HttpAsyncTarget {
    public {
        HttpAsyncTarget d;
        *HttpServer srv;
        int lid;
        string path;
        RemovalSignal signal;
        Counter stop_done(1);
        #! the requests on \a path that held their result
        int held;
    }

    constructor(HttpAsyncTarget d) {
        self.d = d;
    }

    hash<HttpRequestResultInfo> onHttpRequest(hash<HttpConnectionInfo> info) {
        hash<HttpRequestResultInfo> rv = d.onHttpRequest(info);
        if (srv && info.hdr.path == path && !held++) {
            # the stop waits for this request, so it runs in a thread of its own
            HttpServer s = srv;
            int l = lid;
            Counter done = stop_done;
            background sub () {
                on_exit done.dec();
                s.stopListenerID(l);
            }();
            if (signal.removed.waitForZero(HangTimeout)) {
                throw "TEST-ERROR", "the listener was not removed";
            }
        }
        return rv;
    }

    onIdleTimeout(Socket sock, *HttpServer::HttpListenerInterface listener, hash<auto> cx) {
        d.onIdleTimeout(sock, listener, cx);
    }

    onError(Socket sock, hash<ExceptionInfo> ex, *HttpServer::HttpListenerInterface listener, *hash<auto> cx) {
        d.onError(sock, ex, listener, cx);
    }

    onSseDisconnect(Socket sock, *HttpServer::HttpListenerInterface listener, hash<auto> cx) {
        d.onSseDisconnect(sock, listener, cx);
    }

    onWebSocketFrame(Socket sock, hash<WebSocketFrameInfo> frame, *HttpServer::HttpListenerInterface listener,
            hash<auto> cx) {
        d.onWebSocketFrame(sock, frame, listener, cx);
    }

    onWebSocketClose(Socket sock, int code, string reason, *HttpServer::HttpListenerInterface listener,
            hash<auto> cx) {
        d.onWebSocketClose(sock, code, reason, listener, cx);
    }

    auto saveDispatchContext() {
        return d.saveDispatchContext();
    }

    restoreDispatchContext(auto save_data) {
        d.restoreDispatchContext(save_data);
    }
}

#! A server whose async target is a RaceTarget
class RaceServer inherits HttpServer {
    public {
        RaceTarget race;
    }

    constructor(hash<HttpServerOptionInfo> opts) : HttpServer(opts) {
        race = new RaceTarget(asyncTarget);
        asyncTarget = race;
    }
}

class HttpListenerRemovalRaceTest inherits QUnit::Test {
    constructor() : QUnit::Test("HttpListenerRemovalRace", "1.0") {
        foreach string proto in ("h1", "h2", "h3") {
            addTestCase(sprintf("%s: an SSE stream set up by a request that returns after the removal ends", proto),
                \sseTest(), proto);
        }
        addTestCase("a keep-alive connection whose request returns after the removal is closed", \keepAliveTest());
        set_return_value(main());
    }

    #! Starts a server whose listener is removed while a request on \a path is held
    /** An HTTP/2 or HTTP/3 listener uses TLS; HTTP/3 adds a QUIC listener paired with the TCP listener.
    */
    private hash<auto> startServer(string path, AbstractHttpRequestHandler handler, string proto = "h1") {
        RemovalSignal signal(proto == "h3" ? 2 : 1);
        Logger logger("listener-removal-race", LoggerLevel::getLevelInfo());
        logger.addAppender(signal);
        RaceServer srv(<HttpServerOptionInfo>{"logger": logger});
        srv.setHandler("race", path, NOTHING, handler);
        hash<HttpListenerOptionInfo> lopts = <HttpListenerOptionInfo>{"node": "localhost", "service": 0};
        if (proto != "h1") {
            lopts += <HttpListenerOptionInfo>{
                "cert": new SSLCertificate(TestCertificates::CertPem),
                "key": new SSLPrivateKey(TestCertificates::KeyPem),
                "http_version": "auto",
                "enable_h3": proto == "h3",
            };
        }
        hash<auto> li;
        try {
            li = srv.addListener(lopts);
        } catch (hash<ExceptionInfo> ex) {
            delete srv;
            testSkip(sprintf("no %s listener: %s: %s", proto, ex.err, ex.desc));
        }
        srv.race.signal = signal;
        srv.race.path = path;
        srv.race.lid = li.id;
        srv.race.srv = srv;
        srv.waitForAsyncIo();
        return {"srv": srv, "port": li.port};
    }

    #! Waits for the stop of the listener and checks that it is gone
    private waitForStop(RaceServer srv) {
        assertEq(0, srv.race.stop_done.waitForZero(HangTimeout), "the stop of the listener finished");
        assertEq(0, srv.getListeners().size(), "the listener is gone");
    }

    sseTest(string proto) {
        RaceSseHandler h();
        hash<auto> s = startServer("/sse", h, proto);
        RaceServer srv = s.srv;
        on_exit delete srv;

        hash<HttpClientIo::HttpClientConnectionManagerOptions> copts =
            <HttpClientIo::HttpClientConnectionManagerOptions>{
                "accept_all_certs": True,
                "request_timeout": 20s,
                "connect_timeout": 5s,
            };
        if (proto != "h1") {
            copts.protocol = proto;
        }
        HttpClientIo::HttpClientConnectionManager mgr(copts);
        on_exit delete mgr;
        HttpClientIo::HttpClientStreamHandle stream = mgr.acquireAndStartStreaming(
            sprintf("%s://localhost:%d", proto == "h1" ? "http" : "https", s.port), "GET", "/sse",
            {"Accept": "text/event-stream"});
        on_exit stream.cancel();

        assertEq(0, h.registered.waitForZero(HangTimeout), "the stream was registered with the handler");
        waitForStop(srv);

        # the stream was ended with its listener: its end deregisters it from the handler, and an event sent to it
        # does not reach the client
        # the end is reported on a handler-pool thread; the timeout only turns a regression into a failure
        assertEq(0, h.deregistered.waitForZero(HangTimeout), "the end of the stream was reported to the handler");
        assertEq((), h.getConnectionIds(), "the stream was deregistered from the handler");
        try {
            h.conn.send(<SseMessageInfo>{"event": "after-removal", "data": "1"});
        } catch (hash<ExceptionInfo> ex) {
            # the connection may already be closed
        }
        HttpClientStreamingIo::SseStreamReader reader(stream);
        *hash<SseMessageInfo> evt;
        try {
            evt = reader.readEvent(2s);
        } catch (hash<ExceptionInfo> ex) {
            # the stream ended
        }
        assertNothing(evt, "no event reaches the client after the removal");
    }

    keepAliveTest() {
        RacePlainHandler h();
        hash<auto> s = startServer("/plain", h);
        RaceServer srv = s.srv;
        on_exit delete srv;

        Socket sock();
        sock.connect(sprintf("localhost:%d", s.port), 5s);
        on_exit sock.close();
        string req = "GET /plain HTTP/1.1\r\nHost: localhost\r\nConnection: keep-alive\r\n\r\n";
        sock.send(req);
        # the held request is answered with "Connection: close" unless the removal (which HttpServer runs twice, on
        # the stop of the listener and when it has stopped) cancels the send of the response, as it cancels the
        # operations of the other connections of the listener: either way the connection ends
        bool closed;
        try {
            hash<auto> resp = sock.readHTTPHeader(HangTimeout);
            assertEq(200, resp.status_code, "the held request was answered");
            assertEq("close", resp.connection, "the answer closes the connection");
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "SOCKET-CLOSED") {
                rethrow;
            }
            closed = True;
        }
        waitForStop(srv);

        # the server closes the connection instead of keeping it for another request on the removed listener
        if (!closed) {
            try {
                sock.send(req);
                *hash<auto> second = sock.readHTTPHeader(HangTimeout);
                closed = !second;
            } catch (hash<ExceptionInfo> ex) {
                closed = True;
            }
        }
        assertTrue(closed, "the connection was closed with its listener");
        assertEq(1, srv.race.held, "only the held request was handled");
    }
}
