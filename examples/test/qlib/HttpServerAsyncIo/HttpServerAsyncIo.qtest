    constructor() : QUnit::Test("HttpServerAsyncIo Test", "1.0") {
        addTestCase("Constants test", \constantsTest());
        addTestCase("Hashdecl test", \hashdeclTest());
        addTestCase("Target class test", \targetClassTest());
        addTestCase("HttpIdlePollOperation basic test", \idlePollOperationBasicTest());
        addTestCase("Controller start/stop test", \controllerStartStopTest());
        addTestCase("HttpAcceptPollOperation HTTP/2 mode test", \acceptPollHttp2ModeTest());
        set_return_value(main());
    }

    constantsTest() {
        # Test WebSocket opcodes
        assertEq(0x0, WS_OP_CONTINUATION);
        assertEq(0x1, WS_OP_TEXT);
        assertEq(0x2, WS_OP_BINARY);
        assertEq(0x8, WS_OP_CLOSE);
        assertEq(0x9, WS_OP_PING);
        assertEq(0xA, WS_OP_PONG);

        # Test timeouts
        assertEq(30s, DefaultHeaderReadTimeout);
        assertEq(75s, DefaultIdleTimeout);
    }

    hashdeclTest() {
        # Test HttpRequestResultInfo hashdecl
        hash<HttpRequestResultInfo> result = <HttpRequestResultInfo>{
            "close": True,
            "return_to_idle": False,
            "streaming": False,
        };
        assertTrue(result.close);
        assertFalse(result.return_to_idle);
        assertFalse(result.streaming);

        # Test WebSocketFrameInfo hashdecl
        hash<WebSocketFrameInfo> frame = <WebSocketFrameInfo>{
            "type": "text",
            "data": "Hello",
        };
        assertEq("text", frame.type);
        assertEq("Hello", frame.data);
    }

    targetClassTest() {
        # Test that our target class can be instantiated
        TestTarget target();

        # Create a minimal connection info
        Socket sock();
        sock.bind("localhost:0");
        hash<HttpConnectionInfo> info = <HttpConnectionInfo>{
            "sock": sock,
            "hdr": {},
            "header_info": {},
            "listener": sock,  # Just use sock as listener for test
            "cx": {},
            "keep_alive": False,
            "ssl": False,
        };

        # Call onHttpRequest
        hash<HttpRequestResultInfo> result = target.onHttpRequest(info);
        assertTrue(target.request_received);
        assertTrue(result.close);

        sock.close();
    }

    idlePollOperationBasicTest() {
        # Create a socket pair for testing
        Socket server();
        server.bind("localhost:0");
        server.listen();
        int port = server.getSocketInfo().port;

        Socket client();
        client.connect("localhost:" + port);

        Socket accepted = server.accept(100ms);

        # Create idle poll operation with short timeout
        HttpIdlePollOperation op(accepted, 50ms);
        assertEq("idle_monitor", op.getGoal());
        assertEq("idle", op.getState());
        assertFalse(op.goalReached());

        # Clean up
        client.close();
        accepted.close();
        server.close();
    }

    controllerStartStopTest() {
        # Create controller
        HttpAsyncSocketIoController ctrl();

        # Verify initial state
        assertFalse(ctrl.running());

        # Start controller
        ctrl.start();
        assertTrue(ctrl.running());

        # Get stats
        hash<auto> stats = ctrl.getStats();
        assertEq(0, stats.listeners);
        assertEq(0, stats.connections);
        assertTrue(stats.running);

        # Stop controller
        ctrl.stop();
        assertFalse(ctrl.running());
    }

    acceptPollHttp2ModeTest() {
        # Test HttpAcceptPollOperation with different HTTP/2 modes

        # Create a listener socket with SSL
        Socket server();
        server.bind("localhost:0");
        server.setCertificate(TestCert);
        server.setPrivateKey(TestCert);
        server.listen();
        int port = server.getSocketInfo().port;

        # Test 1: Create accept poll with "auto" mode (default)
        {
            HttpAcceptPollOperation op(server, True, TestCert, TestCert, SSL_VERIFY_NONE, True, "auto");
            assertEq("http_accept", op.getGoal());
            assertEq("accepting", op.getState());
            assertFalse(op.goalReached());
            assertFalse(op.isHttp2());  # Not negotiated yet
            assertNothing(op.getNegotiatedProtocol());
            op.abort();
        }

        # Test 2: Create accept poll with "1.1" mode
        {
            HttpAcceptPollOperation op(server, True, TestCert, TestCert, SSL_VERIFY_NONE, True, "1.1");
            assertEq("http_accept", op.getGoal());
            assertFalse(op.isHttp2());
            op.abort();
        }

        # Test 3: Create accept poll with "2.0" mode (HTTP/2 required)
        {
            HttpAcceptPollOperation op(server, True, TestCert, TestCert, SSL_VERIFY_NONE, True, "2.0");
            assertEq("http_accept", op.getGoal());
            assertFalse(op.isHttp2());  # Not connected yet
            op.abort();
        }

        # Test 4: Non-SSL mode should work without ALPN
        {
            HttpAcceptPollOperation op(server, False);
            assertEq("http_accept", op.getGoal());
            assertFalse(op.isHttp2());  # No ALPN without SSL
            op.abort();
        }

        server.close();

        # Test 5: ALPN negotiation between client and server (if HTTP/2 compiled)
        Socket server2();
        server2.bind("localhost:0");
        server2.setCertificate(TestCert);
        server2.setPrivateKey(TestCert);
        # Set ALPN protocols on listener for accept
        server2.setAlpnProtocols(("h2", "http/1.1"));
        server2.listen();
        port = server2.getSocketInfo().port;

        Queue q();
        background sub () {
            try {
                HttpAcceptPollOperation op(server2, True, TestCert, TestCert, SSL_VERIFY_NONE, True, "auto");

                # Drive the poll operation until complete or timeout
                date timeout = now_us() + 5s;
                while (!op.goalReached() && now_us() < timeout) {
                    *hash<SocketPollInfo> info = op.continuePoll();
                    if (!info) {
                        break;
                    }
                    Socket::poll((info,), 100ms);
                }

                if (op.goalReached()) {
                    hash<auto> output = op.getOutput();
                    q.push({
                        "is_http2": output.is_http2,
                        "negotiated_protocol": output.negotiated_protocol,
                    });
                } else {
                    q.push({"error": "timeout"});
                }
            } catch (hash<ExceptionInfo> ex) {
                q.push({"error": ex.err, "desc": ex.desc});
            }
        }();

        # Client connects with HTTP/2 preference
        Socket client();
        client.setAlpnProtocols(("h2", "http/1.1"));
        try {
            client.connectSSL("localhost:" + port, 5s);
            *string proto = client.getAlpnProtocol();
            if (proto == "h2") {
                assertTrue(client.isHttp2());
            }
        } catch (hash<ExceptionInfo> ex) {
            # SSL connection may fail in test environment - that's OK
        }

        # Get server result
        auto result = q.get(5s);
        if (result.error) {
            # Skip if accept failed (can happen in test environments)
            testSkip("ALPN test skipped: " + result.error);
        } else {
            # Either HTTP/2 or HTTP/1.1 should be negotiated
            assertTrue(result.negotiated_protocol.val() || !result.is_http2);
        }

        client.close();
        server2.close();
    }
}
