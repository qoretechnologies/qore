%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires AsyncSocketIo
%requires HttpServerAsyncIo
%requires ../../TestCertificates.qm

%exec-class HttpServerAsyncIoTest

class TestTarget inherits HttpAsyncTarget {
    public {
        hash<auto> last_request;
        bool request_received = False;
    }

    hash<HttpRequestResultInfo> onHttpRequest(hash<HttpConnectionInfo> info) {
        last_request = info;
        request_received = True;
        return <HttpRequestResultInfo>{
            "close": True,
        };
    }

    onIdleTimeout(Socket sock, *HttpServer::HttpListenerInterface listener, hash<auto> cx) {
        try { sock.close(); } catch () {}
    }

    onError(Socket sock, hash<ExceptionInfo> ex, *HttpServer::HttpListenerInterface listener, *hash<auto> cx) {
        try { sock.close(); } catch () {}
    }

    onSseDisconnect(Socket sock, *HttpServer::HttpListenerInterface listener, hash<auto> cx) {
        try { sock.close(); } catch () {}
    }

    onWebSocketFrame(Socket sock, hash<WebSocketFrameInfo> frame, *HttpServer::HttpListenerInterface listener, hash<auto> cx) {
    }

    onWebSocketClose(Socket sock, int code, string reason, *HttpServer::HttpListenerInterface listener, hash<auto> cx) {
        try { sock.close(); } catch () {}
    }
}

#! Target that captures handler thread IDs and supports configurable delays
class InstrumentedTarget inherits HttpAsyncTarget {
    public {
        #! Thread IDs of all handler invocations
        list<int> handler_tids;

        #! Mutex for thread-safe access to handler_tids
        Mutex handler_m();

        #! Number of requests handled
        int request_count = 0;

        #! Optional delay in handler (for testing concurrent dispatch and stop safety)
        timeout handler_delay = 0ms;

        #! Counter decremented when each handler completes
        *Counter handler_done;
    }

    hash<HttpRequestResultInfo> onHttpRequest(hash<HttpConnectionInfo> info) {
        int tid = gettid();
        {
            AutoLock al(handler_m);
            handler_tids += tid;
            ++request_count;
        }
        if (handler_delay > 0ms) {
            usleep(handler_delay);
        }
        # Send a minimal response before closing
        info.sock.send("HTTP/1.0 200 OK\r\nContent-Length: 2\r\n\r\nOK");
        if (handler_done) {
            handler_done.dec();
        }
        return <HttpRequestResultInfo>{
            "close": True,
        };
    }

    onIdleTimeout(Socket sock, *HttpServer::HttpListenerInterface listener, hash<auto> cx) {
        try { sock.close(); } catch () {}
    }

    onError(Socket sock, hash<ExceptionInfo> ex, *HttpServer::HttpListenerInterface listener, *hash<auto> cx) {
        try { sock.close(); } catch () {}
    }

    onSseDisconnect(Socket sock, *HttpServer::HttpListenerInterface listener, hash<auto> cx) {
        try { sock.close(); } catch () {}
    }

    onWebSocketFrame(Socket sock, hash<WebSocketFrameInfo> frame, *HttpServer::HttpListenerInterface listener, hash<auto> cx) {
    }

    onWebSocketClose(Socket sock, int code, string reason, *HttpServer::HttpListenerInterface listener, hash<auto> cx) {
        try { sock.close(); } catch () {}
    }
}

#! Target that captures the pre-read request body for body-read regression testing
class BodyCaptureTarget inherits HttpAsyncTarget {
    public {
        #! Body received by the handler (set from info.header_info.body)
        *binary received_body;
        #! True once onHttpRequest has been called
        bool request_received = False;
        #! Counter decremented after the handler captures the body
        *Counter handler_done;
    }

    hash<HttpRequestResultInfo> onHttpRequest(hash<HttpConnectionInfo> info) {
        received_body = info.header_info.body;
        request_received = True;
        info.sock.send("HTTP/1.0 200 OK\r\nContent-Length: 2\r\n\r\nOK");
        if (handler_done) {
            handler_done.dec();
        }
        return <HttpRequestResultInfo>{
            "close": True,
        };
    }

    onIdleTimeout(Socket sock, *HttpServer::HttpListenerInterface listener, hash<auto> cx) {
        try { sock.close(); } catch () {}
    }

    onError(Socket sock, hash<ExceptionInfo> ex, *HttpServer::HttpListenerInterface listener, *hash<auto> cx) {
        try { sock.close(); } catch () {}
    }

    onSseDisconnect(Socket sock, *HttpServer::HttpListenerInterface listener, hash<auto> cx) {
        try { sock.close(); } catch () {}
    }

    onWebSocketFrame(Socket sock, hash<WebSocketFrameInfo> frame, *HttpServer::HttpListenerInterface listener, hash<auto> cx) {
    }

    onWebSocketClose(Socket sock, int code, string reason, *HttpServer::HttpListenerInterface listener, hash<auto> cx) {
        try { sock.close(); } catch () {}
    }
}

#! Target that answers during preparation, after a short delay, with a body larger than a socket can take at once
class DelayedLargeResponseTarget inherits TestTarget {
    public {
        const BodySize = 16 * 1024 * 1024;
        Queue prepared();
    }

    *hash<HttpRequestResultInfo> prepareHttpRequest(hash<HttpConnectionInfo> info) {
        prepared.push(True);
        return <HttpRequestResultInfo>{
            "code": 200,
            "hdr": {
                "Content-Length": string(BodySize),
                "Connection": "keep-alive",
            },
            "body": strmul("x", BodySize).toBinary(),
            "status_message": "OK",
            "return_to_idle": True,
            "response_delay": 50ms,
        };
    }
}

#! Target that rejects during preparation with server-enforced response pacing
class DelayedPreparationTarget inherits TestTarget {
    public {
        timeout response_delay = 200ms;
        int preparation_count = 0;
        Queue prepared();
    }

    *hash<HttpRequestResultInfo> prepareHttpRequest(hash<HttpConnectionInfo> info) {
        ++preparation_count;
        prepared.push(True);
        timeout delay = info.header_info.path == "/pending-at-stop"
            ? 5s : response_delay;
        return <HttpRequestResultInfo>{
            "code": 503,
            "hdr": {
                "Content-Length": "2",
                "Connection": "keep-alive",
                "Retry-After": "1",
            },
            "body": "NO".toBinary(),
            "status_message": "Service Unavailable",
            "return_to_idle": True,
            "response_delay": delay,
        };
    }
}

#! A non-I/O-thread-safe, memory-backed InputStream (Qore streams block the I/O thread)
class QoreMemoryInputStream inherits Qore::InputStream {
    private {
        binary data;
        int pos = 0;
    }

    constructor(binary d) {
        data = d;
    }

    *binary read(int limit) {
        if (pos >= data.size()) {
            return NOTHING;
        }
        int n = min(limit, data.size() - pos);
        binary chunk = data.substr(pos, n);
        pos += n;
        return chunk;
    }

    int peek() {
        return pos < data.size() ? data[pos] : -1;
    }
}

#! Target whose handler returns a blocking InputStream body together with response_delay
/** The delay must be ignored: a non-I/O-thread-safe stream is sent inline while blocking,
    so it can never be paced on the callback-dispatcher pool. */
class DelayedStreamingTarget inherits TestTarget {
    public {
        timeout response_delay = 1s;
        binary body = "streamed-ok".toBinary();
        Queue handled();
    }

    hash<HttpRequestResultInfo> onHttpRequest(hash<HttpConnectionInfo> info) {
        request_received = True;
        handled.push(True);
        return <HttpRequestResultInfo>{
            "code": 200,
            "hdr": {"Content-Length": body.size().toString()},
            "status_message": "OK",
            "input_stream": new QoreMemoryInputStream(body),
            "response_delay": response_delay,
            "close": True,
        };
    }
}

#! Holds the controller through an or-nothing member, as HttpServer does
class NamedArgListenerHolder {
    private {
        *HttpAsyncSocketIoController ctrl;
    }

    constructor(HttpAsyncSocketIoController ctrl) {
        self.ctrl = ctrl;
    }

    #! skips the or-nothing certificate and key parameters
    addPlain(Socket listener, HttpAsyncTarget target) {
        ctrl.addListener(listener, target, max_request_body_size: 4096);
    }

    #! passes certificate and key values whose types are only known at runtime
    addSsl(Socket listener, HttpAsyncTarget target, *string cert, auto key) {
        ctrl.addListener(listener, target, True, cert, key, HttpVersionMode::Auto, max_request_body_size: 4096);
    }

    #! passes the certificate and key by name
    addSslByName(Socket listener, HttpAsyncTarget target, auto cert, auto key) {
        ctrl.addListener(key: key, cert: cert, ssl: True, target: target, listener: listener);
    }
}

public class HttpServerAsyncIoTest inherits QUnit::Test {
    public {
        # Test SSL certificate (self-signed for testing)
        # NOTE: Certificate and key must match - they are a valid pair
        const CertPem = TestCertificates::CertPem;

        const KeyPem = TestCertificates::KeyPem;
    }

    constructor() : QUnit::Test("HttpServerAsyncIo Test", "1.0", ARGV) {
        addTestCase("Constants test", \constantsTest());
        addTestCase("Hashdecl test", \hashdeclTest());
        addTestCase("SseEventFormat test", \sseEventFormatTest());
        addTestCase("Target class test", \targetClassTest());
        addTestCase("delayed preparation response", \delayedPreparationResponseTest());
        addTestCase("a drain waits for a delayed response", \delayedResponseDrainTest());
        addTestCase("response delay guard for blocking bodies",
            \delayedStreamingResponseGuardTest());
        addTestCase("HttpIdlePollOperation basic test", \idlePollOperationBasicTest());
        addTestCase("HttpKeepAlivePollOperation basic test", \keepAlivePollOperationBasicTest());
        addTestCase("HttpKeepAlivePollOperation header timeout test", \keepAliveHeaderTimeoutTest());
        addTestCase("Controller start/stop test", \controllerStartStopTest());
        addTestCase("persistent queue close completion signal",
            \persistentQueueCloseCompletionTest());
        addTestCase("persistent queue replacement survives delayed cleanup",
            \persistentQueueReplacementTest());
        addTestCase("HttpAcceptPollOperation HTTP/2 mode test", \acceptPollHttp2ModeTest());
        if (Option::HAVE_LIBRARY_DEBUGGING) {
            addTestCase("an aborted idle operation does not report data available", \abortedIdleTest());
            addTestCase("an aborted keep-alive operation does not read a request header", \abortedKeepAliveTest());
            addTestCase("an aborted accept operation does not start the TLS handshake", \abortedAcceptTest());
            addTestCase("a keep-alive operation aborted while its header operation is released",
                \abortedKeepAliveReleaseTest());
            addTestCase("an accept operation aborted while its accept operation is released",
                \abortedAcceptReleaseTest());
            addTestCase("an aborted idle operation keeps its close when it finds its connection closed", \abortedIdleEofTest());
            addTestCase("an aborted keep-alive operation is not made idle again", \abortedKeepAliveResetTest());
            addTestCase("a keep-alive operation aborted after its header phase started reads no more",
                \abortedKeepAliveHeaderPhaseTest());
            addTestCase("a connection accepted after an abort is closed", \abortedPlainAcceptTest());
        }
        addTestCase("addListener with named arguments", \addListenerNamedArgsTest());
        # Binary search: comment out tests to find the hanging one
        addTestCase("concurrent addListener/removeListener", \concurrentListenerTest());
        addTestCase("stop during active accepts", \stopDuringAcceptsTest());
        addTestCase("accept replenish contention", \acceptReplenishContentionTest());
        addTestCase("thread pool dispatch", \threadPoolDispatchTest());
        addTestCase("external controller", \externalControllerTest());
        addTestCase("stop with in-flight handlers", \stopWithInFlightHandlersTest());
        addTestCase("stop during SSL handshake", \stopDuringSslHandshakeTest());
        addTestCase("POST Content-Length body pre-read", \postBodyReadTest());
        addTestCase("SSE close drains queued final frame after partial send",
            \sseCloseDrainsQueuedFinalFrameTest());
        if (Option::HAVE_LIBRARY_DEBUGGING) {
            addTestCase("a step back of the system clock does not stop the SSE heartbeat",
                \sseClockStepHeartbeatTest());
        }
        set_return_value(main());
    }

    #! A step back of the system clock does not stop the SSE heartbeat
    /** The time since the last send is measured on the monotonic clock: on the system clock, a step back of an hour
        made it negative, so no heartbeat was sent until the system clock was back where it was.  The step is made
        with dbg_set_realtime_offset() (debug builds).
    */
    sseClockStepHeartbeatTest() {
        Socket server();
        server.bind("127.0.0.1:0");
        server.listen();
        Socket client();
        client.connect("127.0.0.1:" + server.getSocketInfo().port);
        Socket accepted = server.accept(5s);
        on_exit {
            try { accepted.close(); } catch (hash<ExceptionInfo> ex) {}
            try { client.close(); } catch (hash<ExceptionInfo> ex) {}
            try { server.close(); } catch (hash<ExceptionInfo> ex) {}
        }

        # the operation takes the time of its last send when it is created, before the system clock steps back
        HttpServerAsyncIo::HttpSseStreamPollOperation op(accepted);
        on_exit op.abort();
        op.setHeartbeat(50, ":hb\n\n");
        op.continuePoll();
        call_function("dbg_set_realtime_offset", -3600 * 1000000);
        on_exit call_function("dbg_set_realtime_offset", 0);

        # the operation is driven until the client receives the heartbeat, at most for 20 seconds
        int deadline = clock_get_monotonic_us() + 20000000;
        string received = "";
        while (received !~ /:hb/ && clock_get_monotonic_us() < deadline) {
            op.continuePoll();
            if (client.isDataAvailable(20ms)) {
                received += client.recv(0, 1s);
            }
        }
        assertRegex(":hb", received, "the client receives the heartbeat after its interval");
    }

    #! Regression: an SSE frame queued behind an in-flight (partially-sent) frame
    #! must still be delivered when the producer signals end-of-stream via close().
    /** HttpSseStreamPollOperation::continuePoll() returned NOTHING as soon as the
        state was STATE_DRAINING after a send completed, abandoning any events still
        queued in the event_channel — including the OpenAI-compatible
        "data: [DONE]" terminator.  The async controller treats a NOTHING return as
        end-of-operation and disconnects, so the queued terminator was silently
        dropped.  This intermittently truncated AI gateway streaming responses
        (the client saw content chunks but never the [DONE] terminator) whenever
        close() landed while a prior chunk was still in pending_data.
    */
    sseCloseDrainsQueuedFinalFrameTest() {
        Socket server();
        server.bind("127.0.0.1:0");
        server.listen();
        int port = server.getSocketInfo().port;

        Socket client();
        client.connect("127.0.0.1:" + port);

        Socket accepted = server.accept(5s);
        on_exit {
            try { accepted.close(); } catch (hash<ExceptionInfo> ex) {}
            try { client.close(); } catch (hash<ExceptionInfo> ex) {}
            try { server.close(); } catch (hash<ExceptionInfo> ex) {}
        }

        HttpServerAsyncIo::HttpSseStreamPollOperation op(accepted);
        # disable the heartbeat so the only frames on the wire are the ones we queue
        op.setHeartbeat(0);
        # the stream holds both frames: the bound of the queued data (qore#5792) is not what this case tests
        op.setMaxBufferSize(64 * 1024 * 1024);

        # A frame far larger than any socket send/receive buffer: with the client
        # not yet reading, the first continuePoll() can only send part of it, so it
        # stays in pending_data — the precondition for the close() race.
        string big = "data: " + strmul("x", 16 * 1024 * 1024) + "\n\n";
        op.queueRawString(big);

        # Start the send; it cannot complete (the client is not reading), so the op
        # must ask to wait for writability rather than report completion.
        *hash<auto> info = op.continuePoll();
        assertTrue(exists info, "first continuePoll() must wait for writability (partial send)");
        assertEq("streaming", op.getState());

        # Queue the terminator behind the in-flight frame, then signal end-of-stream.
        op.queueRawString("data: [DONE]\n\n");
        op.close();
        assertEq("draining", op.getState());

        # Drive the op exactly as the async controller does: a NOTHING return means
        # "operation complete" (the controller then disconnects), a hash means
        # "keep waiting".  Reading on the client frees socket buffer space so the
        # send can progress.
        string received = "";
        int guard = 0;
        while (True) {
            try {
                received += client.recv(0, 2s);
            } catch (hash<ExceptionInfo> ex) {
                # nothing available yet — fall through to poll the op again
            }
            *hash<auto> pi = op.continuePoll();
            if (!pi) {
                break;
            }
            if (++guard > 100000) {
                throw "TEST-GUARD", "SSE drain did not complete within the iteration budget";
            }
        }

        # Collect whatever is still buffered after the op completed; closing the
        # server side (as the controller's disconnect handler would) lets the
        # client read the remainder and then see EOF.
        try { accepted.close(); } catch (hash<ExceptionInfo> ex) {}
        while (True) {
            try {
                string rest = client.recv(0, 2s);
                if (!rest.val()) {
                    break;
                }
                received += rest;
            } catch (hash<ExceptionInfo> ex) {
                break;
            }
        }

        assertTrue(received =~ /data:\s*\[DONE\]/,
            "the [DONE] terminator queued behind an in-flight frame must be delivered, "
            "not abandoned when close() is signalled mid-send");
    }

    constantsTest() {
        # Test WebSocket opcodes
        assertEq(0x0, WS_OP_CONTINUATION);
        assertEq(0x1, WS_OP_TEXT);
        assertEq(0x2, WS_OP_BINARY);
        assertEq(0x8, WS_OP_CLOSE);
        assertEq(0x9, WS_OP_PING);
        assertEq(0xA, WS_OP_PONG);

        # Test timeouts
        assertEq(30s, DefaultHeaderReadTimeout);
        assertEq(75s, DefaultIdleTimeout);
    }

    sseEventFormatTest() {
        # a value that cannot be one line of an event stream is refused
        assertThrows("SSE-EVENT-ERROR", "server-sent event type \"a\\\\x0ab\" contains a line break",
            \SseEventFormat::formatLineField(), ("event", "a\nb"));
        assertThrows("SSE-EVENT-ERROR", "server-sent event ID \"a\\\\x0db\" contains a line break",
            \SseEventFormat::formatLineField(), ("id", "a\rb"));
        assertThrows("SSE-EVENT-ERROR", "server-sent event ID \"a\\\\x00b\" contains a NUL character",
            \SseEventFormat::formatLineField(), ("id", "a\x00b"));
        assertEq("id: 12\n", SseEventFormat::formatLineField("id", 12));
        assertEq("event: \n", SseEventFormat::formatLineField("event", ""));

        # each line of a value is one field line
        assertEq("data: a\ndata: b\ndata: c\ndata: \n", SseEventFormat::formatMultiLineField("data", "a\r\nb\rc\n"));
        assertEq("data: \n", SseEventFormat::formatMultiLineField("data", ""));
        assertEq("data: a\x00b\n", SseEventFormat::formatMultiLineField("data", "a\x00b"));
        assertEq(": x\n: y\n", SseEventFormat::formatMultiLineField("", "x\ny"));

        assertEq("retry: 0\n", SseEventFormat::formatRetry(0));
        assertEq("retry: 250\n", SseEventFormat::formatRetry("250"));
        assertThrows("SSE-EVENT-ERROR", \SseEventFormat::formatRetry(), -1);
        assertThrows("SSE-EVENT-ERROR", \SseEventFormat::formatRetry(), "250\n");
        assertThrows("SSE-EVENT-ERROR", \SseEventFormat::formatRetry(), "1.5");
        assertThrows("SSE-EVENT-ERROR", \SseEventFormat::formatRetry(), 1.5);

        assertEq("id: 1\nevent: t\nretry: 10\ndata: x\n\n",
            SseEventFormat::formatEvent({"id": 1, "type": "t", "retry": 10, "data": "x"}));
        assertEq("\n", SseEventFormat::formatEvent({}));
    }

    hashdeclTest() {
        # Test HttpRequestResultInfo hashdecl
        hash<HttpRequestResultInfo> result = <HttpRequestResultInfo>{
            "close": True,
            "return_to_idle": False,
            "streaming": False,
        };
        assertTrue(result.close);
        assertFalse(result.return_to_idle);
        assertFalse(result.streaming);

        # Test WebSocketFrameInfo hashdecl
        hash<WebSocketFrameInfo> frame = <WebSocketFrameInfo>{
            "type": "text",
            "data": "Hello",
        };
        assertEq("text", frame.type);
        assertEq("Hello", frame.data);
    }

    targetClassTest() {
        # Test that our target class can be instantiated
        TestTarget target();

        # Create a minimal connection info
        Socket sock();
        sock.bind("127.0.0.1:0");
        hash<HttpConnectionInfo> info = <HttpConnectionInfo>{
            "sock": sock,
            "hdr": {},
            "header_info": {},
            # listener is *HttpListenerInterface; NOTHING is fine for standalone tests
            "listener": NOTHING,
            "cx": {},
            "keep_alive": False,
            "ssl": False,
        };

        # Call onHttpRequest
        hash<HttpRequestResultInfo> result = target.onHttpRequest(info);
        assertTrue(target.request_received);
        assertTrue(result.close);

        sock.close();
    }

    #! a drain counts a connection whose response waits for its delay until the response is sent (qore#5899)
    delayedResponseDrainTest() {
        AsyncSocketIoController io_ctrl(False);
        on_exit io_ctrl.stop();
        HttpAsyncSocketIoController ctrl(io_ctrl);
        ctrl.start();
        on_exit delete ctrl;

        DelayedLargeResponseTarget target();
        Socket server();
        server.bind("127.0.0.1:0");
        server.listen();
        int port = server.getSocketInfo().port;
        on_exit server.close();
        ctrl.addListener(server, target);

        Socket client();
        on_exit client.close();
        client.connect("127.0.0.1:" + port, 10s);
        client.send("GET /large HTTP/1.1\r\nHost: localhost\r\n\r\n");
        assertTrue(target.prepared.get(10s), "the request is prepared");

        # the response is sent after its delay, and its send cannot end while the client reads nothing: the drain
        # must wait for it all that time
        ctrl.startDrain();
        assertTrue(ctrl.isDraining());
        assertFalse(ctrl.waitDrain(5s), "the drain waits for the delayed response that is being sent");

        hash<auto> h = client.readHTTPHeader(30s);
        assertEq(200, h.status_code, "the delayed response is sent");
        assertEq("close", h.connection, "the response closes the connection");
        int size = 0;
        while (size < DelayedLargeResponseTarget::BodySize) {
            size += client.recvBinary(0, 30s).size();
        }
        assertEq(DelayedLargeResponseTarget::BodySize, size, "the whole response is received");
        assertTrue(ctrl.waitDrain(30s), "the drain ends when the delayed response has been sent");
    }

    delayedPreparationResponseTest() {
        AsyncSocketIoController io_ctrl(False);
        on_exit io_ctrl.stop();
        HttpAsyncSocketIoController ctrl(io_ctrl);
        ctrl.start();
        on_exit delete ctrl;

        DelayedPreparationTarget target();
        Socket server();
        server.bind("127.0.0.1:0");
        server.listen();
        int port = server.getSocketInfo().port;
        on_exit server.close();
        ctrl.addListener(server, target);

        Queue client_events();
        Counter client_done(1);
        background sub () {
            on_exit client_done.dec();
            try {
                Socket client();
                on_exit client.close();
                client.connect("127.0.0.1:" + port, 2s);
                foreach string path in (("/delayed", "/delayed-again")) {
                    date started = now_us();
                    client.send(sprintf("GET %s HTTP/1.1\r\nHost: localhost\r\n\r\n",
                        path));
                    string response = client.recv(0, 3s);
                    client_events.push({
                        "path": path,
                        "response": response,
                        "elapsed_ms":
                            (now_us() - started).durationMilliseconds(),
                    });
                }
                client.send("GET /pending-at-stop HTTP/1.1\r\nHost: localhost\r\n\r\n");
                client_events.push({"pending_sent": True});
                try { client.recv(0, 10s); } catch () {}
            } catch (hash<ExceptionInfo> ex) {
                client_events.push({"error": ex{"err", "desc",}});
            }
        }();

        for (int i = 0; i < 2; ++i) {
            hash<auto> event = client_events.get(5s);
            target.prepared.get(1s);
            assertFalse(exists event.error,
                sprintf("delayed client request succeeds: %y; controller stats: %y",
                    event.error, ctrl.getStats()));
            assertTrue(event.response =~ /503 Service Unavailable/,
                i ? "delayed response preserves HTTP/1.1 keep-alive"
                    : "pre-dispatch response is sent normally after its delay");
            assertTrue(event.elapsed_ms >= 150,
                sprintf("response %s is delayed independently (%d ms)",
                    event.path, event.elapsed_ms));
        }
        assertFalse(target.request_received,
            "a preparation response does not enter the handler pool");

        # A long pending delay must be canceled promptly during controller shutdown.
        hash<auto> pending = client_events.get(5s);
        assertTrue(pending.pending_sent,
            "the client submits a long-delay request before shutdown");
        target.prepared.get(1s);
        usleep(20ms);
        assertEq(3, target.preparation_count,
            "the long-delay request reaches preparation before shutdown");
        assertEq(1, ctrl.getStats().delayed_responses,
            "the long-delay response is tracked while pending");
        date started = now_us();
        ctrl.stop();
        int elapsed_ms = (now_us() - started).durationMilliseconds();
        assertTrue(elapsed_ms < 2000,
            sprintf("shutdown cancels pending delayed responses promptly (%d ms)",
                elapsed_ms));
        assertEq(0, ctrl.getStats().delayed_responses,
            "shutdown removes every pending delayed response");
        assertEq(0, client_done.waitForZero(2s),
            "shutdown releases the client waiting for the delayed response");
        assertEq(3, target.preparation_count,
            "every test request reached preparation exactly once");
    }

    delayedStreamingResponseGuardTest() {
        AsyncSocketIoController io_ctrl(False);
        on_exit io_ctrl.stop();
        HttpAsyncSocketIoController ctrl(io_ctrl);
        ctrl.start();
        on_exit delete ctrl;

        DelayedStreamingTarget target();
        Socket server();
        server.bind("127.0.0.1:0");
        server.listen();
        int port = server.getSocketInfo().port;
        on_exit server.close();
        ctrl.addListener(server, target);

        Socket client();
        on_exit client.close();
        client.connect("127.0.0.1:" + port, 2s);
        # use a monotonic clock so an NTP/VM wall-clock step cannot skew the elapsed check
        int started = clock_get_monotonic_us();
        client.send("GET /streamed HTTP/1.1\r\nHost: localhost\r\n\r\n");
        # the handler closes the connection after sending, so read until EOF (a closed
        # socket surfaces as SOCKET-NOT-OPEN / END-OF-STREAM rather than NOTHING)
        string response;
        try {
            while (True) {
                *string chunk = client.recv(0, 3s);
                if (!exists chunk) {
                    break;
                }
                response += chunk;
            }
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err != "SOCKET-NOT-OPEN" && ex.err != "SOCKET-CLOSED"
                    && ex.err != "END-OF-STREAM") {
                rethrow;
            }
        }
        int elapsed_ms = (clock_get_monotonic_us() - started) / 1000;

        assertTrue(target.handled.get(1s),
            "the blocking-body handler ran on the handler pool");
        assertTrue(response =~ /200 OK/,
            "the blocking-body response is sent");
        assertTrue(response =~ /streamed-ok/,
            "the streamed body is delivered intact");
        # response_delay is 1s; the guard must skip it, so the response arrives well before
        assertTrue(elapsed_ms < 500,
            sprintf("response_delay is ignored for a blocking InputStream body (%d ms)",
                elapsed_ms));
        assertEq(0, ctrl.getStats().delayed_responses,
            "a blocking-body response is never entered into the delayed-response table");
    }

    idlePollOperationBasicTest() {
        # Create a socket pair for testing
        Socket server();
        server.bind("127.0.0.1:0");
        server.listen();
        int port = server.getSocketInfo().port;

        Socket client();
        client.connect("127.0.0.1:" + port);

        Socket accepted = server.accept(100ms);

        # Create idle poll operation with short timeout
        HttpIdlePollOperation op(accepted, 50ms);
        assertEq("idle_monitor", op.getGoal());
        assertEq("idle", op.getState());
        assertFalse(op.goalReached());

        # Clean up
        client.close();
        accepted.close();
        server.close();
    }

    #! Returns a connected pair: the client socket and the accepted one; data sent by the client is readable on the
    #! accepted one before this returns, when @a data is given
    private list<Socket> socketPair(*string data) {
        Socket server();
        server.bind("127.0.0.1:0");
        server.listen();
        Socket client();
        client.connect("127.0.0.1:" + server.getSocketInfo().port);
        Socket accepted = server.accept(5s);
        server.close();
        if (data) {
            client.send(data);
            assertTrue(accepted.isDataAvailable(5s), "the data arrived");
        }
        return (client, accepted);
    }

    #! An HTTP idle operation is aborted (as by another thread) right before it reports the data that arrived: it
    #! stays closed
    abortedIdleTest() {
        list<Socket> sp = socketPair("x");
        on_exit map $1.close(), sp;
        HttpIdlePollOperation op(sp[1], 30s);
        # disarms the hook if it did not fire
        on_exit call_function("dbg_poll_wait_close_before_open_state", 0);
        call_function("dbg_poll_close_before_open_state", op, "data-available");
        op.continuePoll();
        *bool closed = call_function("dbg_poll_wait_close_before_open_state", 0);
        assertTrue(exists closed, "the hook fired");
        assertTrue(closed, "the state store left the operation closed");
        assertEq("closed", op.getState());
    }

    #! An HTTP keep-alive operation is aborted (as by another thread) right before it starts reading the request
    #! header that is arriving: it stays closed and reads nothing
    abortedKeepAliveTest() {
        list<Socket> sp = socketPair("GET / HTTP/1.1\r\n");
        on_exit map $1.close(), sp;
        HttpKeepAlivePollOperation op(sp[1], 30000);
        # disarms the hook if it did not fire
        on_exit call_function("dbg_poll_wait_close_before_open_state", 0);
        call_function("dbg_poll_close_before_open_state", op, "header-reading");
        assertNothing(op.continuePoll(), "the aborted operation does not read the header");
        *bool closed = call_function("dbg_poll_wait_close_before_open_state", 0);
        assertTrue(exists closed, "the hook fired");
        assertTrue(closed, "the state store left the operation closed");
        assertEq("closed", op.getState());
        assertEq("idle", op.getPhase(), "the operation did not enter the header phase");
    }

    #! An HTTP accept operation is aborted (as by another thread) right before it starts the TLS handshake of the
    #! accepted connection: it stays complete and does not start the handshake
    abortedAcceptTest() {
        # a plain listener: the operation itself starts the TLS handshake of the accepted connection
        Socket server();
        server.bind("127.0.0.1:0");
        server.listen();
        on_exit server.close();
        # the connection is waiting to be accepted before the operation polls
        Socket client();
        client.connect("127.0.0.1:" + server.getSocketInfo().port);
        on_exit client.close();
        # connect() returns when the client side of the TCP handshake completes, which under load can be before the
        # listener has queued the connection: the listener is readable once it has, so the accept completes in the
        # cycle that the test expects
        assertTrue(server.isDataAvailable(5s), "the connection is waiting to be accepted");
        HttpAcceptPollOperation op(server, True, CertPem, KeyPem, SSL_VERIFY_NONE, True, "auto");
        # disarms the hook if it did not fire
        on_exit call_function("dbg_poll_wait_close_before_open_state", 0);
        call_function("dbg_poll_close_before_open_state", op, "ssl-handshake");
        # the first cycle starts the accept and asks for the listener's readiness, which the waiting connection
        # already gives: the accept completes in the next cycle, whose next step is the TLS handshake
        *hash<SocketPollInfo> pi = op.continuePoll();
        if (pi) {
            pi = op.continuePoll();
        }
        assertNothing(pi, "the aborted operation does not start the handshake");
        *bool closed = call_function("dbg_poll_wait_close_before_open_state", 0);
        assertTrue(exists closed, "the hook fired");
        assertTrue(closed, "the state store left the operation complete");
        assertEq("complete", op.getState());
    }

    #! An HTTP idle operation is aborted (as by another thread) right before it reports that its connection is closed:
    #! the abort's close is kept, not replaced by the I/O thread's
    abortedIdleEofTest() {
        list<Socket> sp = socketPair();
        on_exit map $1.close(), sp;
        HttpIdlePollOperation op(sp[1], 30s);
        # the connection is closed: the next cycle reports it
        sp[1].close();
        # disarms the hook if it did not fire
        on_exit call_function("dbg_poll_wait_close_before_open_state", 0);
        call_function("dbg_poll_close_before_open_state", op, "peer-closed");
        op.continuePoll();
        *bool kept = call_function("dbg_poll_wait_close_before_open_state", 0);
        assertTrue(exists kept, "the hook fired");
        assertTrue(kept, "the abort's close was not replaced");
        assertEq("closed", op.getState());
    }

    #! An aborted HTTP keep-alive operation is not made idle again by resetForIdle()
    abortedKeepAliveResetTest() {
        list<Socket> sp = socketPair();
        on_exit map $1.close(), sp;
        HttpKeepAlivePollOperation op(sp[1], 30000);
        op.abort();
        op.resetForIdle();
        assertEq("closed", op.getState(), "the aborted operation stays closed");
        assertTrue(op.goalReached());
    }

    #! An HTTP keep-alive operation is aborted (as by another thread) right after its header phase started: it reads no
    #! more and reports no poll info
    abortedKeepAliveHeaderPhaseTest() {
        list<Socket> sp = socketPair("GET / HTTP/1.1\r\n");
        on_exit map $1.close(), sp;
        HttpKeepAlivePollOperation op(sp[1], 30000);
        # disarms the hook if it did not fire
        on_exit call_function("dbg_poll_wait_close_before_open_state", 0);
        call_function("dbg_poll_close_before_open_state", op, "header-op-created");
        assertNothing(op.continuePoll(), "the aborted operation reads no more");
        *bool closed = call_function("dbg_poll_wait_close_before_open_state", 0);
        assertTrue(exists closed, "the hook fired");
        assertTrue(closed, "the operation was aborted");
        assertEq("closed", op.getState());
    }

    #! A plain (non-TLS) accept operation is aborted (as by another thread) after its inner accept completed and before
    #! it recorded the accepted connection: the connection is closed, not handed over open
    abortedPlainAcceptTest() {
        Socket server();
        server.bind("127.0.0.1:0");
        server.listen();
        on_exit server.close();
        Socket client();
        client.connect("127.0.0.1:" + server.getSocketInfo().port);
        on_exit client.close();
        # connect() returns when the client side of the TCP handshake completes, which under load can be before the
        # listener has queued the connection: the listener is readable once it has, so the accept completes in the
        # cycle that the test expects
        assertTrue(server.isDataAvailable(5s), "the connection is waiting to be accepted");
        HttpAcceptPollOperation op(server, False);
        # disarms the hook if it did not fire
        on_exit call_function("dbg_poll_wait_close_before_open_state", 0);
        call_function("dbg_poll_close_before_open_state", op, "accept-complete");
        # the first cycle starts the accept and asks for the listener's readiness, which the waiting connection
        # already gives: the accept completes in the next cycle
        *hash<SocketPollInfo> pi = op.continuePoll();
        if (pi) {
            pi = op.continuePoll();
        }
        assertNothing(pi);
        *bool closed = call_function("dbg_poll_wait_close_before_open_state", 0);
        assertTrue(exists closed, "the hook fired");
        assertTrue(closed, "the connection accepted after the abort was closed");
        assertEq("complete", op.getState());
    }

    #! A keep-alive operation is aborted (as by another thread) while resetForIdle() releases its header operation:
    #! abort() takes its own reference to the operation, so it never uses a released one
    /** The debug hook aborts the operation right after the header operation was taken from it for its release; the
        pointer is nulled with the lock held before the reference is released, so the abort() finds no operation
        (valgrind reports the use of a released one when the order is reversed).
    */
    abortedKeepAliveReleaseTest() {
        list<Socket> sp = socketPair("GET / HTTP/1.1\r\n");
        on_exit map $1.close(), sp;
        HttpKeepAlivePollOperation op(sp[1], 30000);
        # the header phase starts: the header operation exists, and waits for the rest of the header
        assertFalse(op.goalReached());
        op.continuePoll();
        assertEq("header", op.getPhase(), "the operation reads the request header");
        # disarms the hook if it did not fire
        on_exit call_function("dbg_poll_wait_close_before_open_state", 0);
        call_function("dbg_poll_close_before_open_state", op, "release-header-op");
        op.resetForIdle();
        *bool closed = call_function("dbg_poll_wait_close_before_open_state", 0);
        assertTrue(exists closed, "the hook fired");
        assertTrue(closed, "the operation was aborted");
    }

    #! An accept operation is aborted (as by another thread) while its I/O thread releases the accept operation to
    #! start the TLS handshake: abort() takes its own references, so it never uses a released operation
    /** The debug hook aborts the operation right after the accept operation was taken from it for its release; the
        pointers are nulled with the lock held before the references are released, so the abort() finds no operation
        (valgrind reports the use of a released one when the order is reversed).
    */
    abortedAcceptReleaseTest() {
        # a plain listener: the operation itself starts the TLS handshake of the accepted connection
        Socket server();
        server.bind("127.0.0.1:0");
        server.listen();
        on_exit server.close();
        Socket client();
        client.connect("127.0.0.1:" + server.getSocketInfo().port);
        on_exit client.close();
        # connect() returns when the client side of the TCP handshake completes, which under load can be before the
        # listener has queued the connection: the listener is readable once it has, so the accept completes in the
        # cycle that the test expects
        assertTrue(server.isDataAvailable(5s), "the connection is waiting to be accepted");
        HttpAcceptPollOperation op(server, True, CertPem, KeyPem, SSL_VERIFY_NONE, True, "auto");
        # disarms the hook if it did not fire
        on_exit call_function("dbg_poll_wait_close_before_open_state", 0);
        call_function("dbg_poll_close_before_open_state", op, "release-current-op");
        # the first cycle starts the accept and asks for the listener's readiness, which the waiting connection
        # already gives: the accept completes in the next cycle, which releases the accept operation
        *hash<SocketPollInfo> pi = op.continuePoll();
        if (pi) {
            pi = op.continuePoll();
        }
        assertNothing(pi, "the aborted operation does not start the handshake");
        *bool closed = call_function("dbg_poll_wait_close_before_open_state", 0);
        assertTrue(exists closed, "the hook fired");
        assertTrue(closed, "the operation was aborted");
        assertEq("complete", op.getState());
    }

    controllerStartStopTest() {
        # Create controller — start/stop are no-ops with the global singleton
        AsyncSocketIoController io_ctrl(False);
        HttpAsyncSocketIoController ctrl(io_ctrl);

        # start/stop are no-ops; verify wrapper methods don't throw
        ctrl.start();
        ctrl.stop();

        # Get stats — should work regardless of I/O thread state
        hash<auto> stats = ctrl.getStats();
        assertEq(0, stats.listeners);
        assertEq(0, stats.connections);
    }

    #! Verifies targeted persistent-close entries carry an exact completion channel
    /** A service-stop caller uses this channel as a deterministic barrier against
        unloading callback code before the dedicated persistent-handler thread has
        finished its close notification and thread-local cleanup.
    */
    persistentQueueCloseCompletionTest() {
        AsyncSocketIoController io_ctrl(False);
        HttpAsyncSocketIoController ctrl(io_ctrl);

        Queue persistent_queue(1);
        ctrl.registerPersistentQueue("persistent-close-test", persistent_queue, NOTHING);
        on_exit ctrl.deregisterPersistentQueue("persistent-close-test");

        Queue close_ack(1);
        assertTrue(ctrl.signalPersistentQueuesForConnection(
            "persistent-close-test", close_ack),
            "registered persistent queue accepts targeted close");

        hash<auto> entry = persistent_queue.get(1s);
        assertEq("close", entry.type, "targeted signal queues a close entry");
        assertTrue(entry.close_ack === close_ack,
            "close entry carries the caller's exact completion queue");

        entry.close_ack.push("cleanup-complete");
        assertEq("cleanup-complete", close_ack.get(1s),
            "caller observes owner-thread cleanup completion");

        assertFalse(ctrl.signalPersistentQueuesForConnection(
            "unknown-persistent-close-test", close_ack),
            "unknown persistent queue is reported without blocking");
    }

    persistentQueueReplacementTest() {
        AsyncSocketIoController io_ctrl(False);
        HttpAsyncSocketIoController ctrl(io_ctrl);
        string key = "persistent-replacement-test";
        Queue first();
        Queue second();
        on_exit ctrl.deregisterPersistentQueue(key);

        ctrl.registerPersistentQueue(key, first, NOTHING);
        ctrl.deregisterPersistentQueue(key, first);
        assertFalse(ctrl.pushPersistentQueue(key, {}, {"body": "ended"}, NOTHING),
            "ended session no longer receives requests");

        ctrl.registerPersistentQueue(key, second, NOTHING);
        ctrl.deregisterPersistentQueue(key, first);
        assertTrue(ctrl.pushPersistentQueue(key, {}, {"body": "new session"}, NOTHING),
            "late cleanup of the first session preserves the replacement");
        assertEq("new session", second.get(1s).body,
            "the next request reaches the replacement queue");
        assertEq(0, first.size(), "old session receives no replacement requests");

        ctrl.deregisterPersistentQueue(key, second);
        ctrl.deregisterPersistentQueue(key, second);
        assertFalse(ctrl.pushPersistentQueue(key, {}, {"body": "ended again"}, NOTHING),
            "matching cleanup removes the replacement and is idempotent");

        ctrl.registerPersistentQueue(key, first, NOTHING);
        ctrl.deregisterPersistentQueue(key);
        assertFalse(ctrl.signalPersistentQueuesForConnection(key),
            "legacy key-only cleanup still removes the current session");
    }

    acceptPollHttp2ModeTest() {
        # Test HttpAcceptPollOperation with different HTTP/2 modes

        # Create a listener socket with SSL
        Socket server();
        server.bind("127.0.0.1:0");
        server.setCertificate(CertPem);
        server.setPrivateKey(KeyPem);
        server.listen();
        int port = server.getSocketInfo().port;

        # Test 1: Create accept poll with "auto" mode (default)
        {
            HttpAcceptPollOperation op(server, True, CertPem, KeyPem, SSL_VERIFY_NONE, True, "auto");
            assertEq("http_accept", op.getGoal());
            assertEq("accepting", op.getState());
            assertFalse(op.goalReached());
            assertFalse(op.isHttp2());  # Not negotiated yet
            assertNothing(op.getNegotiatedProtocol());
            op.abort();
        }

        # Test 2: Create accept poll with "1.1" mode
        {
            HttpAcceptPollOperation op(server, True, CertPem, KeyPem, SSL_VERIFY_NONE, True, "1.1");
            assertEq("http_accept", op.getGoal());
            assertFalse(op.isHttp2());
            op.abort();
        }

        # Test 3: Create accept poll with "2.0" mode (HTTP/2 required)
        {
            HttpAcceptPollOperation op(server, True, CertPem, KeyPem, SSL_VERIFY_NONE, True, "2.0");
            assertEq("http_accept", op.getGoal());
            assertFalse(op.isHttp2());  # Not connected yet
            op.abort();
        }

        # Test 4: Non-SSL mode should work without ALPN
        {
            HttpAcceptPollOperation op(server, False);
            assertEq("http_accept", op.getGoal());
            assertFalse(op.isHttp2());  # No ALPN without SSL
            op.abort();
        }

        server.close();

        # Test 5: ALPN negotiation between client and server (if HTTP/2 compiled)
        Socket server2();
        server2.bind("127.0.0.1:0");
        server2.setCertificate(CertPem);
        server2.setPrivateKey(KeyPem);
        # Set ALPN protocols on listener for accept
        server2.setAlpnProtocols(("h2", "http/1.1"));
        server2.listen();
        port = server2.getSocketInfo().port;

        Queue q();
        background sub () {
            try {
                HttpAcceptPollOperation op(server2, True, CertPem, KeyPem, SSL_VERIFY_NONE, True, "auto");

                # Drive the poll operation until complete or timeout
                date timeout = now_us() + 5s;
                while (!op.goalReached() && now_us() < timeout) {
                    *hash<SocketPollInfo> info = op.continuePoll();
                    if (!info) {
                        break;
                    }
                    Socket::poll((info,), 100ms);
                }

                if (op.goalReached()) {
                    hash<auto> output = op.getOutput();
                    q.push({
                        "is_http2": output.is_http2,
                        "negotiated_protocol": output.negotiated_protocol,
                    });
                } else {
                    q.push({"error": "timeout"});
                }
            } catch (hash<ExceptionInfo> ex) {
                q.push({"error": ex.err, "desc": ex.desc});
            }
        }();

        # Client connects with HTTP/2 preference
        Socket client();
        client.setAlpnProtocols(("h2", "http/1.1"));
        try {
            client.connectSSL("127.0.0.1:" + port, 5s);
            *string proto = client.getAlpnProtocol();
            if (proto == "h2") {
                assertTrue(client.isHttp2());
            }
        } catch (hash<ExceptionInfo> ex) {
            # SSL connection may fail in test environment - that's OK
        }

        # Get server result
        auto result = q.get(5s);
        if (result.error) {
            # Skip if accept failed (can happen in test environments)
            testSkip("ALPN test skipped: " + result.error);
        } else {
            # Either HTTP/2 or HTTP/1.1 should be negotiated
            assertTrue(result.negotiated_protocol.val() || !result.is_http2);
        }

        client.close();
        server2.close();
    }

    #! Tests concurrent addListener/removeListener — exercises lock contention on m
    concurrentListenerTest() {
        AsyncSocketIoController io_ctrl(False);
        on_exit io_ctrl.stop();
        HttpAsyncSocketIoController ctrl(io_ctrl);
        ctrl.start();
        on_exit delete ctrl;

        TestTarget target();
        int num_listeners = 4;
        list<Socket> sockets;

        # Create listener sockets
        for (int i = 0; i < num_listeners; ++i) {
            Socket s();
            s.bind("127.0.0.1:0");
            s.listen();
            push sockets, s;
        }

        # Add all listeners concurrently from background threads
        Counter add_cnt(num_listeners);
        for (int i = 0; i < num_listeners; ++i) {
            int idx = i;
            background sub () {
                on_exit add_cnt.dec();
                ctrl.addListener(sockets[idx], target);
            }();
        }
        add_cnt.waitForZero(10s);

        hash<auto> stats = ctrl.getStats();
        assertEq(num_listeners, stats.listeners, "all listeners should be registered");

        # Remove all listeners concurrently
        Counter rm_cnt(num_listeners);
        for (int i = 0; i < num_listeners; ++i) {
            int idx = i;
            background sub () {
                on_exit rm_cnt.dec();
                ctrl.removeListener(sockets[idx]);
            }();
        }
        rm_cnt.waitForZero(10s);

        stats = ctrl.getStats();
        assertEq(0, stats.listeners, "all listeners should be removed");

        foreach Socket s in (sockets) {
            s.close();
        }
        assertTrue(True, "concurrent add/remove completed without deadlock");
    }

    #! Tests stop() while accept operations are in flight — the deadlock scenario we fixed
    stopDuringAcceptsTest() {
        # Run several iterations to increase the chance of hitting the race window
        for (int iter = 0; iter < 5; ++iter) {
            AsyncSocketIoController io_ctrl(False);
            HttpAsyncSocketIoController ctrl(io_ctrl);
            ctrl.start();

            TestTarget target();

            Socket server();
            server.bind("127.0.0.1:0");
            server.listen();
            int listen_port = server.getSocketInfo().port;

            ctrl.addListener(server, target);

            # Connect a client so at least one accept completes, triggering replenish
            Socket client();
            try {
                client.connect("127.0.0.1:" + listen_port, 1s);
            } catch () {
                # connection may fail — that's fine
            }

            # Small delay to let accept callbacks fire and replenish
            usleep(50ms);

            # Stop while accepts are being replenished — this is the deadlock scenario
            ctrl.stop();

            client.close();
            server.close();
            delete ctrl;
            io_ctrl.stop();
        }
        assertTrue(True, "stop during active accepts completed without deadlock");
    }

    #! Tests accept replenish under heavy client connection load
    acceptReplenishContentionTest() {
        AsyncSocketIoController io_ctrl(False);
        on_exit io_ctrl.stop();
        HttpAsyncSocketIoController ctrl(io_ctrl);
        ctrl.start();
        on_exit delete ctrl;

        TestTarget target();

        Socket server();
        server.bind("127.0.0.1:0");
        server.listen();
        int listen_port = server.getSocketInfo().port;
        on_exit server.close();

        ctrl.addListener(server, target);

        # Rapidly connect multiple clients — each triggers accept completion + replenish
        int num_clients = 10;
        Counter client_cnt(num_clients);
        for (int i = 0; i < num_clients; ++i) {
            background sub () {
                on_exit client_cnt.dec();
                try {
                    Socket c();
                    c.connect("127.0.0.1:" + listen_port, 2s);
                    # Send a minimal HTTP request so the header read completes
                    c.send("GET / HTTP/1.0\r\nHost: localhost\r\n\r\n");
                    usleep(50ms);
                    c.close();
                } catch () {
                    # ignore connection errors
                }
            }();
        }

        client_cnt.waitForZero(15s);

        # Give time for callbacks to settle
        usleep(200ms);

        # The key assertion: no deadlock occurred and controller is still healthy
        assertTrue(ctrl.running(), "controller should still be running after accept replenish storm");

        ctrl.removeListener(server);
        assertTrue(True, "accept replenish contention test completed without deadlock");
    }

    #! Helper: sends HTTP request and reads response
    /** @param port the port to connect to
        @param ignore_errors if True, swallow connection/I/O errors (for tests where the
            server may close the socket during shutdown)
        @return response body string, or NOTHING if ignore_errors and an error occurred
    */
    private *string doHttpRequest(int port, bool ignore_errors = False) {
        try {
            Socket c();
            c.connect("127.0.0.1:" + port, 2s);
            c.send("GET / HTTP/1.0\r\nHost: localhost\r\n\r\n");
            *string resp = c.recv(0, 2s);
            c.close();
            return resp;
        } catch (hash<ExceptionInfo> ex) {
            if (ignore_errors) {
                return NOTHING;
            }
            rethrow;
        }
    }

    #! Tests that onHttpRequest runs on a handler thread pool worker, not the I/O thread
    threadPoolDispatchTest() {
        InstrumentedTarget target();

        AsyncSocketIoController io_ctrl(False);
        on_exit io_ctrl.stop();
        HttpAsyncSocketIoController ctrl(io_ctrl);
        ctrl.start();
        on_exit delete ctrl;

        Socket server();
        server.bind("127.0.0.1:0");
        server.listen();
        int port = server.getSocketInfo().port;
        on_exit server.close();

        ctrl.addListener(server, target);

        # Send several requests sequentially to collect handler TIDs
        int num_requests = 5;
        for (int i = 0; i < num_requests; ++i) {
            doHttpRequest(port);
        }

        # Give callbacks time to settle
        usleep(500ms);

        assertEq(num_requests, target.request_count, "all requests should be handled");

        # Verify handlers ran on worker threads — all handler TIDs should be
        # different from the test thread TID.  We can't easily capture the I/O
        # thread TID, but we CAN verify that not all handlers ran on a single
        # thread (proving thread pool dispatch actually parallelizes).
        assertTrue(target.handler_tids.size() == num_requests,
            "should have one TID per request");

        # At least verify we got valid TIDs
        foreach int tid in (target.handler_tids) {
            assertTrue(tid > 0, "handler TID should be positive");
        }

        ctrl.removeListener(server);
    }

    #! Tests that an external controller is used correctly
    externalControllerTest() {
        InstrumentedTarget target();

        # Create controller with an explicit external AsyncSocketIoController
        AsyncSocketIoController io_ctrl(False);
        on_exit io_ctrl.stop();
        HttpAsyncSocketIoController ctrl(io_ctrl);
        ctrl.start();
        on_exit delete ctrl;

        # Verify getStats reports expected keys (no io_threads since single-controller)
        hash<auto> stats = ctrl.getStats();
        assertTrue(stats.hasKey("listeners"), "stats should have listeners key");
        assertTrue(stats.hasKey("connections"), "stats should have connections key");
        assertTrue(stats.hasKey("running"), "stats should have running key");

        Socket server();
        server.bind("127.0.0.1:0");
        server.listen();
        int port = server.getSocketInfo().port;
        on_exit server.close();

        ctrl.addListener(server, target);

        # Send requests sequentially — they should work correctly
        int num_requests = 10;
        for (int i = 0; i < num_requests; ++i) {
            doHttpRequest(port);
        }

        # Give callbacks time to settle
        usleep(500ms);

        assertEq(num_requests, target.request_count,
            "all requests should complete with external controller");

        ctrl.removeListener(server);
    }

    #! Tests HttpKeepAlivePollOperation basic lifecycle
    keepAlivePollOperationBasicTest() {
        # Create a socket pair
        Socket server();
        server.bind("127.0.0.1:0");
        server.listen();
        int port = server.getSocketInfo().port;

        Socket client();
        client.connect("127.0.0.1:" + port);
        Socket accepted = server.accept(1s);

        # Create keep-alive poll operation with idle timeout long enough for test
        HttpKeepAlivePollOperation op(accepted, 10s);
        assertEq("keep_alive_idle", op.getGoal());
        assertEq("idle", op.getState());
        assertEq("idle", op.getPhase());
        assertFalse(op.goalReached());
        assertFalse(op.timedOut());
        assertFalse(op.headersReady());
        assertFalse(op.wasClosed());

        # Send a full HTTP request — should transition to header phase and complete
        client.send("GET / HTTP/1.1\r\nHost: localhost\r\n\r\n");
        usleep(50ms);

        # Drive the poll operation to completion
        date deadline = now_us() + 5s;
        while (!op.goalReached() && now_us() < deadline) {
            *hash<SocketPollInfo> poll_info = op.continuePoll();
            if (!poll_info) {
                if (op.goalReached()) {
                    break;
                }
                # No poll info but not done — brief sleep and retry
                usleep(10ms);
                continue;
            }
            Socket::poll((poll_info,), 100ms);
        }

        assertTrue(op.goalReached(), "operation should be complete");
        assertTrue(op.headersReady(), "headers should be ready");
        assertEq("header_complete", op.getState());
        assertEq("header", op.getPhase());

        # getOutput should return parsed headers
        hash<auto> output = op.getOutput();
        assertTrue(output.hasKey("hdr"), "output should contain parsed headers");

        # Test resetForIdle
        op.resetForIdle();
        assertEq("idle", op.getPhase());
        assertEq("idle", op.getState());
        assertFalse(op.goalReached());

        client.close();
        accepted.close();
        server.close();
    }

    #! Tests that HttpKeepAlivePollOperation enforces header read timeout, not idle TTL
    keepAliveHeaderTimeoutTest() {
        # Create a socket pair
        Socket server();
        server.bind("127.0.0.1:0");
        server.listen();
        int port = server.getSocketInfo().port;

        Socket client();
        client.connect("127.0.0.1:" + port);
        Socket accepted = server.accept(1s);

        # Use a very long idle TTL (60s) but we expect header timeout (DefaultHeaderReadTimeout=30s)
        # to kick in. We can't wait 30s in a test, so we test the mechanism:
        # 1. Create the operation
        # 2. Send partial headers to trigger transition to header phase
        # 3. Verify that the header_deadline is set and is much shorter than idle TTL
        HttpKeepAlivePollOperation op(accepted, 60s);

        # Send partial HTTP request — just enough to trigger data available
        client.send("GET / HTTP/1.1\r\n");
        usleep(50ms);

        # Drive until we're in header phase
        date drive_deadline = now_us() + 5s;
        while (op.getPhase() == "idle" && now_us() < drive_deadline) {
            *hash<SocketPollInfo> info = op.continuePoll();
            if (!info) {
                break;
            }
            Socket::poll((info,), 50ms);
        }

        # Should now be in header phase, waiting for the rest of the headers
        assertEq("header", op.getPhase(), "should transition to header phase on partial data");
        assertEq("header_reading", op.getState());
        assertFalse(op.goalReached(), "should not be complete with partial headers");

        # The operation should NOT have timed out yet (header timeout is 30s)
        assertFalse(op.timedOut(), "should not timeout immediately in header phase");

        # Verify the operation is still polling (not complete)
        op.continuePoll();
        # Should still be waiting for more header data
        assertTrue(!op.goalReached(), "should still be waiting for complete headers");

        client.close();
        accepted.close();
        server.close();
    }

    #! Tests addListener() with named arguments that skip or pass the certificate and key
    addListenerNamedArgsTest() {
        # the listening sockets are closed after the controller has been stopped
        list<Socket> servers;
        on_exit {
            map $1.close(), servers;
        }
        AsyncSocketIoController io_ctrl(False);
        HttpAsyncSocketIoController ctrl(io_ctrl);
        on_exit {
            ctrl.stop();
            io_ctrl.stop();
        }
        ctrl.start();
        NamedArgListenerHolder holder(ctrl);
        TestTarget target();

        holder.addPlain(listenSocket(\servers), target);
        assertEq(1, ctrl.getStats().listeners, "plain listener with skipped cert and key");

        holder.addSsl(listenSocket(\servers), target, CertPem, KeyPem);
        assertEq(2, ctrl.getStats().listeners, "SSL listener with PEM strings");

        holder.addSslByName(listenSocket(\servers), target, new SSLCertificate(CertPem),
            new SSLPrivateKey(KeyPem));
        assertEq(3, ctrl.getStats().listeners, "SSL listener with objects passed by name");

        # a certificate of the wrong type fails at runtime as with positional arguments
        auto bad_cert = {"pem": CertPem};
        string positional_err;
        try {
            ctrl.addListener(listenSocket(\servers), target, True, bad_cert, KeyPem);
        } catch (hash<ExceptionInfo> ex) {
            positional_err = ex.err;
        }
        assertEq("RUNTIME-OVERLOAD-ERROR", positional_err, "positional call with an invalid certificate");
        assertThrows(positional_err, sub () {
            holder.addSsl(listenSocket(\servers), target, NOTHING, bad_cert);
        });
        assertThrows(positional_err, sub () {
            holder.addSslByName(listenSocket(\servers), target, bad_cert, KeyPem);
        });
        assertEq(3, ctrl.getStats().listeners, "rejected listeners are not added");
    }

    private static Socket listenSocket(reference<list<Socket>> servers) {
        Socket server();
        server.bind("127.0.0.1:0");
        server.listen();
        servers += server;
        return server;
    }

    #! Tests that stop() during SSL handshake doesn't leak operations
    stopDuringSslHandshakeTest() {
        for (int iter = 0; iter < 5; ++iter) {
            AsyncSocketIoController io_ctrl(False);
            HttpAsyncSocketIoController ctrl(io_ctrl);
            ctrl.start();

            TestTarget target();

            Socket server();
            server.bind("127.0.0.1:0");
            server.setCertificate(CertPem);
            server.setPrivateKey(KeyPem);
            server.listen();
            int port = server.getSocketInfo().port;

            ctrl.addListener(server, target, True, CertPem, KeyPem);

            # Connect a client but DON'T do the SSL handshake — leave it hanging
            # This means the server will have an in-flight SSL handshake operation
            Socket client();
            try {
                # Plain TCP connect (no SSL) to trigger accept + SSL handshake start on server
                client.connect("127.0.0.1:" + port, 1s);
            } catch () {}

            # Brief delay so accept completes and SSL handshake op is submitted
            usleep(100ms);

            # Stop while SSL handshake is in progress
            ctrl.stop();
            assertFalse(ctrl.running(),
                sprintf("controller should be stopped after SSL handshake stop (iter=%d)", iter));

            # Verify clean shutdown
            hash<auto> stats = ctrl.getStats();
            assertEq(0, stats.connections,
                sprintf("no connections should remain after stop during SSL (iter=%d)", iter));
            assertEq(0, stats.listeners,
                sprintf("no listeners should remain after stop during SSL (iter=%d)", iter));

            client.close();
            server.close();
            delete ctrl;
            io_ctrl.stop();
        }
        assertTrue(True, "stop during SSL handshake completed cleanly");
    }

    #! Tests that stop() with in-flight handler tasks doesn't leak operations
    stopWithInFlightHandlersTest() {
        for (int iter = 0; iter < 3; ++iter) {
            InstrumentedTarget target();
            # Handler sleeps 500ms to ensure stop() is called while handlers are active
            target.handler_delay = 500ms;

            AsyncSocketIoController io_ctrl(False);
            HttpAsyncSocketIoController ctrl(io_ctrl);
            ctrl.start();

            Socket server();
            server.bind("127.0.0.1:0");
            server.listen();
            int port = server.getSocketInfo().port;

            ctrl.addListener(server, target);

            # Fire off requests — their handlers will sleep
            int num_requests = 3;
            Counter client_done(num_requests);
            for (int i = 0; i < num_requests; ++i) {
                background sub () {
                    on_exit client_done.dec();
                    doHttpRequest(port, True);
                }();
            }

            # Brief delay so accepts + header reads complete and handler tasks start
            usleep(100ms);

            # Stop while handlers are sleeping — should complete without leaking ops
            ctrl.stop();
            assertFalse(ctrl.running(), sprintf("controller should be stopped (iter=%d)", iter));

            # Verify clean shutdown — getStats should show no connections
            hash<auto> stats = ctrl.getStats();
            assertEq(0, stats.connections,
                sprintf("no connections should remain after stop (iter=%d)", iter));
            assertEq(0, stats.listeners,
                sprintf("no listeners should remain after stop (iter=%d)", iter));

            client_done.waitForZero(5s);
            server.close();
            delete ctrl;
            io_ctrl.stop();
        }
        assertTrue(True, "stop with in-flight handlers completed without leaks");
    }

    #! Regression test: HTTP/1.x POST with Content-Length must drive the async
    #! body-read path in handleHeaderComplete() and deliver the body bytes to
    #! the handler via info.header_info.body.
    #!
    #! Guards against the string->int type-narrowing bug where the
    #! content-length header value (always a string) was assigned to a strict
    #! `int` lvalue, throwing RUNTIME-TYPE-ERROR inside the try/catch at
    #! HttpAsyncSocketIoController.qc:~2292 and silently falling through to
    #! the handler without pre-reading the body.
    postBodyReadTest() {
        BodyCaptureTarget target();
        Counter done(1);
        target.handler_done = done;

        AsyncSocketIoController io_ctrl(False);
        on_exit io_ctrl.stop();
        HttpAsyncSocketIoController ctrl(io_ctrl);
        ctrl.start();
        on_exit delete ctrl;

        Socket server();
        server.bind("127.0.0.1:0");
        server.listen();
        int port = server.getSocketInfo().port;
        on_exit server.close();

        ctrl.addListener(server, target);

        binary body = binary("Hello, async body read!");

        Socket c();
        c.connect("127.0.0.1:" + port, 2s);
        c.send(sprintf("POST /echo HTTP/1.0\r\nHost: localhost\r\nContent-Length: %d\r\n\r\n",
            body.size()));
        # Force the body-read operation to wait for socket readiness instead
        # of finding the whole request body already buffered.
        usleep(50ms);
        c.send(body);
        # Drain the response so the handler can finish cleanly
        c.recv(0, 2s);
        c.close();

        # Deterministic sync: wait for the handler to run, no polling
        done.waitForZero(5s);

        assertTrue(target.request_received, "handler should have been invoked");
        assertEq(body, target.received_body,
            "handler must receive the full POST body pre-read by the I/O controller "
            "(missing body => string->int regression in handleHeaderComplete)");

        ctrl.removeListener(server);
    }
}
