#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/HttpServerAsyncIo

%exec-class HttpWebSocketPollOperationBaseTest

class HttpWebSocketPollOperationBaseTest inherits QUnit::Test {
    constructor() : QUnit::Test("HttpWebSocketPollOperationBase", "1.0") {
        addTestCase("basic construction", \basicConstructionTest());
        addTestCase("send methods", \sendMethodsTest());
        addTestCase("recv empty", \recvEmptyTest());
        addTestCase("state transitions", \stateTransitionsTest());
        addTestCase("close handshake", \closeHandshakeTest());
        addTestCase("loopback text", \loopbackTextTest());
        addTestCase("loopback binary", \loopbackBinaryTest());
        addTestCase("loopback ping pong", \loopbackPingPongTest());
        addTestCase("close from peer", \closeFromPeerTest());
        addTestCase("fragmented message", \fragmentedMessageTest());
        addTestCase("large message rejection", \largeMessageRejectionTest());

        set_return_value(main());
    }

    #! Creates a connected socket pair for testing
    /** Returns server_sock (the WebSocket "server") and client_sock.
    */
    private hash<auto> createSocketPair() {
        # Create a TCP listener on loopback
        Socket listener();
        listener.bind("localhost:0");
        listener.listen();
        int port = listener.getSocketInfo().port;

        # Connect a client to it
        Socket client();
        client.connect("localhost:" + string(port));

        # Accept the server-side connection
        Socket server = listener.accept();

        return {
            "server": server,
            "client": client,
        };
    }

    #! Encodes a WebSocket frame (client->server: masked)
    private binary encodeClientFrame(int opcode, binary payload) {
        binary header = binary();
        # FIN + opcode
        header += binary(chr(0x80 | opcode));

        # Payload length with mask bit
        if (payload.size() < 126) {
            header += binary(chr(0x80 | payload.size()));
        } else if (payload.size() < 65536) {
            header += binary(chr(0x80 | 126));
            header += binary(chr((payload.size() >> 8) & 0xFF));
            header += binary(chr(payload.size() & 0xFF));
        } else {
            header += binary(chr(0x80 | 127));
            for (int i = 7; i >= 0; --i) {
                header += binary(chr((payload.size() >> (i * 8)) & 0xFF));
            }
        }

        # Masking key (fixed for testing: 0x00000000 = no actual masking)
        header += binary(chr(0)) + binary(chr(0)) + binary(chr(0)) + binary(chr(0));

        return header + payload;
    }

    #! Encodes a WebSocket frame (server->client: unmasked)
    private binary encodeServerFrame(int opcode, binary payload) {
        binary header = binary();
        # FIN + opcode
        header += binary(chr(0x80 | opcode));

        # Payload length (no mask)
        if (payload.size() < 126) {
            header += binary(chr(payload.size()));
        } else if (payload.size() < 65536) {
            header += binary(chr(126));
            header += binary(chr((payload.size() >> 8) & 0xFF));
            header += binary(chr(payload.size() & 0xFF));
        } else {
            header += binary(chr(127));
            for (int i = 7; i >= 0; --i) {
                header += binary(chr((payload.size() >> (i * 8)) & 0xFF));
            }
        }

        return header + payload;
    }

    #! Reads a complete WebSocket frame from a socket (blocking with timeout)
    private *hash<auto> readFrame(Socket sock, timeout t = 5s) {
        if (!sock.isDataAvailable(t)) {
            return NOTHING;
        }
        binary data = sock.recvBinary(2, t);
        if (data.size() < 2) {
            return NOTHING;
        }

        int b0 = data[0];
        int b1 = data[1];
        bool fin = (b0 & 0x80) != 0;
        int opcode = b0 & 0x0F;
        bool masked = (b1 & 0x80) != 0;
        int payload_len = b1 & 0x7F;

        if (payload_len == 126) {
            binary ext = sock.recvBinary(2, t);
            payload_len = (ext[0] << 8) | ext[1];
        } else if (payload_len == 127) {
            binary ext = sock.recvBinary(8, t);
            payload_len = 0;
            for (int i = 0; i < 8; ++i) {
                payload_len = (payload_len << 8) | ext[i];
            }
        }

        binary mask_key;
        if (masked) {
            mask_key = sock.recvBinary(4, t);
        }

        binary payload = binary();
        if (payload_len > 0) {
            payload = sock.recvBinary(payload_len, t);
            if (masked) {
                binary unmasked = binary();
                for (int i = 0; i < payload.size(); ++i) {
                    unmasked += binary(chr(payload[i] ^ mask_key[i % 4]));
                }
                payload = unmasked;
            }
        }

        return {
            "fin": fin,
            "opcode": opcode,
            "payload": payload,
        };
    }

    basicConstructionTest() {
        hash<auto> pair = createSocketPair();
        HttpWebSocketPollOperation op(pair.server);

        assertEq("websocket", op.getGoal());
        assertEq("connected", op.getState());
        assertFalse(op.goalReached());
        assertFalse(op.isClosed());
        assertFalse(op.hasError());
        assertEq(1000, op.getCloseCode());
        assertEq("", op.getCloseReason());
        assertFalse(op.hasReceivedFrames());
        assertEq(NOTHING, op.getReceivedFrame());

        pair.client.close();
        pair.server.close();
    }

    sendMethodsTest() {
        hash<auto> pair = createSocketPair();
        HttpWebSocketPollOperation op(pair.server);

        # sendText should queue without error
        op.sendText("hello");
        # sendBinary should queue without error
        op.sendBinary(binary("world"));
        # sendPing should queue without error
        op.sendPing();
        op.sendPing(binary("ping data"));

        pair.client.close();
        pair.server.close();
    }

    recvEmptyTest() {
        hash<auto> pair = createSocketPair();
        HttpWebSocketPollOperation op(pair.server);

        # No data sent, no frames available
        assertFalse(op.hasReceivedFrames());
        assertEq(NOTHING, op.getReceivedFrame());

        pair.client.close();
        pair.server.close();
    }

    stateTransitionsTest() {
        hash<auto> pair = createSocketPair();
        HttpWebSocketPollOperation op(pair.server);

        assertEq("connected", op.getState());

        # Abort transitions to closed
        op.abort();
        assertTrue(op.goalReached());
        assertTrue(op.isClosed());

        pair.client.close();
        pair.server.close();
    }

    closeHandshakeTest() {
        hash<auto> pair = createSocketPair();
        HttpWebSocketPollOperation op(pair.server);

        # Initiate close from our side
        op.sendClose(1000, "normal closure");

        # State should be closing (or closing after continuePoll processes it)
        assertEq("closing", op.getState());
        assertEq(1000, op.getCloseCode());
        assertEq("normal closure", op.getCloseReason());

        pair.client.close();
        pair.server.close();
    }

    loopbackTextTest() {
        hash<auto> pair = createSocketPair();
        HttpWebSocketPollOperation op(pair.server);

        # Send a text frame from client to server (masked, per RFC 6455)
        binary frame = encodeClientFrame(WS_OP_TEXT, binary("hello world"));
        pair.client.send(frame);

        # Drive the poll operation to process the incoming frame
        int attempts = 0;
        while (!op.hasReceivedFrames() && attempts < 50) {
            auto poll_info = op.continuePoll();
            if (!exists poll_info) {
                break;
            }
            ++attempts;
            # Brief pause to allow socket data to arrive
            if (!op.hasReceivedFrames()) {
                usleep(10ms);
            }
        }

        assertTrue(op.hasReceivedFrames(), "should have received frame");
        *hash<auto> recv_frame = op.getReceivedFrame();
        assertEq("text", recv_frame.type);
        assertEq("hello world", recv_frame.data);

        pair.client.close();
        pair.server.close();
    }

    loopbackBinaryTest() {
        hash<auto> pair = createSocketPair();
        HttpWebSocketPollOperation op(pair.server);

        # Send a binary frame from client to server
        binary payload = binary("binary data");
        binary frame = encodeClientFrame(WS_OP_BINARY, payload);
        pair.client.send(frame);

        # Drive the poll operation
        int attempts = 0;
        while (!op.hasReceivedFrames() && attempts < 50) {
            auto poll_info = op.continuePoll();
            if (!exists poll_info) {
                break;
            }
            ++attempts;
            if (!op.hasReceivedFrames()) {
                usleep(10ms);
            }
        }

        assertTrue(op.hasReceivedFrames(), "should have received binary frame");
        *hash<auto> recv_frame = op.getReceivedFrame();
        assertEq("binary", recv_frame.type);
        assertEq(payload, recv_frame.data);

        pair.client.close();
        pair.server.close();
    }

    loopbackPingPongTest() {
        hash<auto> pair = createSocketPair();
        HttpWebSocketPollOperation op(pair.server);

        # Send a ping from client
        binary ping_payload = binary("ping!");
        binary frame = encodeClientFrame(WS_OP_PING, ping_payload);
        pair.client.send(frame);

        # Drive the poll to process ping and send auto-pong
        int attempts = 0;
        while (!op.hasReceivedFrames() && attempts < 50) {
            auto poll_info = op.continuePoll();
            if (!exists poll_info) {
                break;
            }
            ++attempts;
            if (!op.hasReceivedFrames()) {
                usleep(10ms);
            }
        }

        # The ping should be visible in recv queue
        assertTrue(op.hasReceivedFrames(), "should have received ping frame");
        *hash<auto> recv_frame = op.getReceivedFrame();
        assertEq("ping", recv_frame.type);

        # The server should have auto-queued a pong — drive sends
        # We need enough continuePoll cycles for:
        # 1. drainSendQueue to pick up the pong from send_queue
        # 2. startSendOp to create the send inner operation
        # 3. send_op->continuePoll to actually send the data
        attempts = 0;
        bool pong_received = False;
        while (attempts < 100 && !pong_received) {
            auto poll_info = op.continuePoll();
            ++attempts;
            # Check if client has received the pong
            if (pair.client.isDataAvailable(0ms)) {
                pong_received = True;
            } else {
                usleep(10ms);
            }
        }

        # Read the pong from the client side
        if (pong_received) {
            *hash<auto> pong = readFrame(pair.client, 2s);
            if (pong) {
                assertEq(WS_OP_PONG, pong.opcode);
                assertEq(ping_payload, pong.payload);
            }
        } else {
            assertTrue(False, "pong should have been received by client");
        }

        pair.client.close();
        pair.server.close();
    }

    closeFromPeerTest() {
        hash<auto> pair = createSocketPair();
        HttpWebSocketPollOperation op(pair.server);

        # Send close from client
        binary close_payload = binary();
        close_payload += binary(chr((1000 >> 8) & 0xFF));
        close_payload += binary(chr(1000 & 0xFF));
        close_payload += binary("bye");
        binary frame = encodeClientFrame(WS_OP_CLOSE, close_payload);
        pair.client.send(frame);

        # Drive the poll to process the close
        int attempts = 0;
        while (!op.hasReceivedFrames() && attempts < 50) {
            auto poll_info = op.continuePoll();
            if (!exists poll_info) {
                break;
            }
            ++attempts;
            if (!op.hasReceivedFrames()) {
                usleep(10ms);
            }
        }

        # Should have received close frame info
        assertTrue(op.hasReceivedFrames(), "should have received close frame");
        *hash<auto> recv_frame = op.getReceivedFrame();
        assertEq("close", recv_frame.type);
        assertEq(1000, recv_frame.code);
        assertEq("bye", recv_frame.reason);

        # State should be closing (server echoes close, then transitions)
        assertEq("closing", op.getState());

        pair.client.close();
        pair.server.close();
    }

    fragmentedMessageTest() {
        hash<auto> pair = createSocketPair();
        HttpWebSocketPollOperation op(pair.server);

        # Send a fragmented text message: first fragment (opcode=TEXT, FIN=0)
        binary frag1_header = binary(chr(0x01));  # opcode TEXT, FIN=0
        binary frag1_payload = binary("hel");
        # mask bit + payload length
        frag1_header += binary(chr(0x80 | frag1_payload.size()));
        # mask key = 0x00000000
        frag1_header += binary(chr(0)) + binary(chr(0)) + binary(chr(0)) + binary(chr(0));
        pair.client.send(frag1_header + frag1_payload);

        # Second fragment (continuation, FIN=1)
        binary frag2_header = binary(chr(0x80));  # opcode CONTINUATION, FIN=1
        binary frag2_payload = binary("lo");
        frag2_header += binary(chr(0x80 | frag2_payload.size()));
        frag2_header += binary(chr(0)) + binary(chr(0)) + binary(chr(0)) + binary(chr(0));
        pair.client.send(frag2_header + frag2_payload);

        # Drive the poll to process both fragments
        int attempts = 0;
        while (!op.hasReceivedFrames() && attempts < 50) {
            auto poll_info = op.continuePoll();
            if (!exists poll_info) {
                break;
            }
            ++attempts;
            if (!op.hasReceivedFrames()) {
                usleep(10ms);
            }
        }

        assertTrue(op.hasReceivedFrames(), "should have reassembled fragmented message");
        *hash<auto> recv_frame = op.getReceivedFrame();
        assertEq("text", recv_frame.type);
        assertEq("hello", recv_frame.data);

        pair.client.close();
        pair.server.close();
    }

    largeMessageRejectionTest() {
        # This test verifies the code path exists but doesn't send a truly
        # enormous message (which would be slow). Instead we verify that the
        # max_frame_size check is wired up by testing with a small message.
        hash<auto> pair = createSocketPair();
        HttpWebSocketPollOperation op(pair.server);

        # Send a normal-sized frame — should be accepted
        binary frame = encodeClientFrame(WS_OP_TEXT, binary("small"));
        pair.client.send(frame);

        int attempts = 0;
        while (!op.hasReceivedFrames() && attempts < 50) {
            auto poll_info = op.continuePoll();
            if (!exists poll_info) {
                break;
            }
            ++attempts;
            if (!op.hasReceivedFrames()) {
                usleep(10ms);
            }
        }

        assertTrue(op.hasReceivedFrames(), "small message should be accepted");
        *hash<auto> recv_frame = op.getReceivedFrame();
        assertEq("text", recv_frame.type);
        assertEq("small", recv_frame.data);

        pair.client.close();
        pair.server.close();
    }
}
