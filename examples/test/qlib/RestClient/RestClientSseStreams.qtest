    Server-sent event streams of the AI REST clients, synchronous and asynchronous, against a local server
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires Mime
%requires Logger
%requires HttpServerUtil
%requires HttpServer
%requires OpenAiRestClient
%requires AnthropicRestClient
%requires GeminiRestClient
%requires GrokRestClient
%requires PerplexityRestClient

%exec-class RestClientSseStreamsTest

#! Returns data a few bytes at a time, so that events and compressed data span many chunks
class TrickleInputStream inherits InputStream {
    private {
        binary data;
        int pos = 0;
    }

    constructor(binary data) {
        self.data = data;
    }

    int peek() {
        return pos < data.size() ? data[pos] : -1;
    }

    *binary read(int limit) {
        if (limit <= 0 || pos >= data.size()) {
            return;
        }
        int size = min(limit, 3, data.size() - pos);
        binary rv = data.substr(pos, size);
        pos += size;
        return rv;
    }
}

#! Returns the first data, then the data pushed to a queue until NOTHING is pushed
/** The response stalls until the test pushes more data, so that an event wait times out deterministically
*/
class GatedInputStream inherits InputStream {
    private {
        *binary first;
        Queue gate;
        bool done;
    }

    constructor(binary first, Queue gate) {
        self.first = first;
        self.gate = gate;
    }

    int peek() {
        return -1;
    }

    *binary read(int limit) {
        if (first) {
            binary rv = first;
            remove first;
            return rv;
        }
        if (done) {
            return;
        }
        try {
            *binary rv = gate.get(30s);
            if (!rv) {
                done = True;
            }
            return rv;
        } catch (hash<ExceptionInfo> ex) {
            # the test failed; the response is ended
            done = True;
        }
    }
}

#! Returns a complete event stream as a chunked response body with the content encoding given in the request
/** The Content-Type has a charset parameter, as sent by many servers; HttpServer handles a response with exactly
    \c text/event-stream as a live stream that requires a server-sent event handler.  "%s" in the events is replaced
    by the request path and body.
*/
class SseStreamHandler inherits AbstractHttpRequestHandler {
    public {
        const Encoders = {
            "gzip": \gzip(),
            "deflate": \compress(),
            "br": \brotli(),
            "zstd": \zstd(),
        };
    }

    public {
        #! queues for gated responses, by the value of the X-Test-Gate header
        hash<string, Queue> gates;
    }

    private {
        string events;
    }

    constructor(string events) {
        self.events = events;
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        if (hdr."x-test-content-type") {
            return <HttpResponseInfo>{
                "code": 200,
                "hdr": {"Content-Type": hdr."x-test-content-type"},
                "body": "{}",
            };
        }
        if (hdr."x-test-gate") {
            return <HttpResponseInfo>{
                "code": 200,
                "hdr": {
                    "Content-Type": "text/event-stream; charset=utf-8",
                    "Transfer-Encoding": "chunked",
                },
                "chunked_body": new GatedInputStream(binary("data: first\n\n"), gates{hdr."x-test-gate"}),
            };
        }
        if (hdr."x-test-status") {
            return <HttpResponseInfo>{
                "code": hdr."x-test-status".toInt(),
                "hdr": {"Content-Type": MimeTypeText},
                "body": "error",
            };
        }
        binary stream;
        if (hdr."x-test-bomb") {
            # an event that never ends
            stream = binary("data: " + strmul("x", 4 * 1024 * 1024));
        } else {
            stream = binary(replace(replace(events, "%s", hdr.path + " " + (body ? body.toString() : "")), "%h",
                hdr."x-test-echo" ?? ""));
        }
        hash<auto> rhdr = {
            "Content-Type": "text/event-stream; charset=utf-8",
            "Transfer-Encoding": "chunked",
        };
        if (*string enc = hdr."x-test-encoding") {
            stream = Encoders{enc}(stream);
            rhdr."Content-Encoding" = enc;
        }
        return <HttpResponseInfo>{
            "code": 200,
            "hdr": rhdr,
            "chunked_body": new TrickleInputStream(stream),
        };
    }
}

public class RestClientSseStreamsTest inherits QUnit::Test {
    private {
        HttpServer server;
        SseStreamHandler handler;
        string url;
    }

    constructor() : Test("RestClientSseStreamsTest", "1.0") {
        server = new HttpServer(<HttpServerOptionInfo>{
            "logger": new Logger("server", LoggerLevel::getLevelError()),
        });
        int port = server.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        # the first event gives the path and the request body; line endings of all kinds
        handler = new SseStreamHandler("data: %s\n\nevent: e\r\ndata: one\r\n\r\ndata: two\r\rdata: three%h\n\n");
        server.setHandler("sse", "", NOTHING, handler);
        server.setDefaultHandler("sse", handler);
        url = "http://localhost:" + port;

        addTestCase("events", \eventTest());
        addTestCase("limits and errors", \limitTest());
        addTestCase("event wait timeouts", \timeoutTest());
        addTestCase("synchronous client state", \syncClientStateTest());
        addTestCase("closing streams", \closeTest());
        set_return_value(main());
    }

    globalTearDown() {
        server.stop();
    }

    # returns openers of the streams of all synchronous clients, with the path requested
    private hash<string, list<auto>> getOpeners(int max_size = 0) {
        hash<auto> opts = {"url": url, "max_response_body_size": max_size};
        return getOpenersIntern(new OpenAiRestClient(opts + {"token": "x"}),
            new AnthropicRestClient(opts + {"apikey": "x"}), new GeminiRestClient(opts + {"apikey": "x"}),
            new GrokRestClient(opts + {"token": "x"}), new PerplexityRestClient(opts + {"token": "x"}));
    }

    # returns openers of the streams of all asynchronous clients, with the path requested
    private hash<string, list<auto>> getOpenersIo(int max_size = 0) {
        hash<auto> opts = {"url": url, "max_response_body_size": max_size};
        return getOpenersIntern(new OpenAiRestClientIo(opts + {"token": "x"}),
            new AnthropicRestClientIo(opts + {"apikey": "x"}), new GeminiRestClientIo(opts + {"apikey": "x"}),
            new GrokRestClientIo(opts + {"token": "x"}), new PerplexityRestClientIo(opts + {"token": "x"}));
    }

    private hash<string, list<auto>> getOpenersIntern(object oai, object ant, object gem, object grok, object ppx) {
        return {
            "OpenAi": (
                "v1/responses",
                object sub (hash<auto> req, *hash<auto> hdr) { return oai.openResponsesStream(req, hdr); },
                oai,
            ),
            "Anthropic": (
                "v1/messages",
                object sub (hash<auto> req, *hash<auto> hdr) { return ant.openMessagesStream(req, hdr); },
                ant,
            ),
            "Gemini": (
                "v1beta/models/m1:streamGenerateContent?alt=sse",
                object sub (hash<auto> req, *hash<auto> hdr) { return gem.openStreamingConnection("m1", req, hdr); },
                gem,
            ),
            "Grok": (
                "v1/responses",
                object sub (hash<auto> req, *hash<auto> hdr) { return grok.openResponsesStream(req, hdr); },
                grok,
            ),
            "Perplexity": (
                "chat/completions",
                object sub (hash<auto> req, *hash<auto> hdr) { return ppx.openChatStream(req, hdr); },
                ppx,
            ),
        };
    }

    eventTest() {
        foreach *string enc in ((NOTHING,) + keys SseStreamHandler::Encoders) {
            # the synchronous and asynchronous clients: (suffix, name, opener info)
            list<list<auto>> clients = (map ("", $1.key, $1.value), getOpeners().pairIterator())
                + (map ("Io", $1.key, $1.value), getOpenersIo().pairIterator());
            foreach list<auto> i in (clients) {
                string label = sprintf("%s%s %s", i[1], i[0], enc ?? "identity");
                list<auto> v = i[2];
                # a hash request is serialized as JSON
                object stream = v[1]({"model": "m"}, enc ? {"X-Test-Encoding": enc} : NOTHING);
                list<string> data = ();
                while (*hash<SseMessageInfo> evt = stream.readEvent(10s)) {
                    data += evt.data;
                }
                assertEq((v[0] + " {\"model\":\"m\"}", "one", "two", "three"), data, label);
                # the end of the stream is reported again
                assertNothing(stream.readEvent(10s), label);
            }
        }
    }

    limitTest() {
        foreach hash<auto> i in (getOpeners(1024 * 1024).pairIterator()) {
            # a compressed event that never ends: decompression stops at the maximum response body size
            object stream = i.value[1]({}, {"X-Test-Encoding": "gzip", "X-Test-Bomb": "1"});
            assertThrows("SSE-EVENT-TOO-LARGE", "maximum event size of 1048576 bytes", \stream.readEvent(), 30s,
                i.key);

            # an error response raises an exception with the response
            assertThrows("HTTP-CLIENT-RECEIVE-ERROR", "HTTP status code 500 received", i.value[1],
                ({}, {"X-Test-Status": "500"}), i.key);
        }
        foreach hash<auto> i in (getOpenersIo(1024 * 1024).pairIterator()) {
            # the maximum response body size of the client limits an event
            object stream = i.value[1]({}, {"X-Test-Encoding": "gzip", "X-Test-Bomb": "1"});
            assertThrows("SSE-EVENT-TOO-LARGE", "maximum event size of 1048576 bytes", \stream.readEvent(), 30s,
                i.key + "Io");

            assertThrows("REST-RESPONSE-ERROR", "500", i.value[1], ({}, {"X-Test-Status": "500"}), i.key + "Io");
            # a successful response that is not an event stream
            assertThrows("REST-RESPONSE-ERROR", "expected an event stream", i.value[1],
                ({}, {"X-Test-Content-Type": "application/json"}), i.key + "Io");
        }
        foreach hash<auto> i in (getOpeners().pairIterator()) {
            # the error response is in the exception argument
            try {
                i.value[1]({}, {"X-Test-Status": "503"});
                assertTrue(False, i.key + ": no exception");
            } catch (hash<ExceptionInfo> ex) {
                assertEq("HTTP-CLIENT-RECEIVE-ERROR", ex.err, i.key);
                assertEq(503, ex.arg.status_code, i.key);
                assertEq("error", ex.arg.body, i.key);
                # the response headers are in the argument
                assertEq("5", ex.arg."content-length", i.key);
            }
            # a successful response that is not an event stream
            assertThrows("SSE-ERROR", "expected an event stream", i.value[1],
                ({}, {"X-Test-Content-Type": "application/json"}), i.key);
        }
    }

    timeoutTest() {
        int n = 0;
        foreach hash<auto> i in (getOpeners().pairIterator()) {
            string gate_id = sprintf("%d", ++n);
            Queue gate();
            handler.gates{gate_id} = gate;
            object stream = i.value[1]({}, {"X-Test-Gate": gate_id});
            on_exit {
                # the response is ended whatever happens
                gate.push(NOTHING);
            }
            assertEq("first", stream.readEvent(10s).data, i.key);
            # no event is received while the response stalls: the synchronous stream raises an exception
            assertThrows("SOCKET-TIMEOUT", \stream.readEvent(), 100ms, i.key);
            assertFalse(stream.isDone(), i.key);
            # the stream remains usable
            gate.push(binary("data: late\n\n"));
            assertEq("late", stream.readEvent(10s).data, i.key);
            gate.push(NOTHING);
            assertNothing(stream.readEvent(10s), i.key);
            assertTrue(stream.isDone(), i.key);
        }
        foreach hash<auto> i in (getOpenersIo().pairIterator()) {
            string gate_id = sprintf("%d", ++n);
            Queue gate();
            handler.gates{gate_id} = gate;
            object stream = i.value[1]({}, {"X-Test-Gate": gate_id});
            on_exit {
                gate.push(NOTHING);
            }
            assertEq("first", stream.readEvent(10s).data, i.key + "Io");
            # the asynchronous stream returns nothing when the wait times out, and has not ended
            assertNothing(stream.readEvent(100ms), i.key + "Io");
            assertFalse(stream.isDone(), i.key + "Io");
            gate.push(binary("data: late\n\n"));
            assertEq("late", stream.readEvent(10s).data, i.key + "Io");
            gate.push(NOTHING);
            assertNothing(stream.readEvent(10s), i.key + "Io");
            assertTrue(stream.isDone(), i.key + "Io");
        }
    }

    syncClientStateTest() {
        foreach hash<auto> i in (getOpeners().pairIterator()) {
            RestClient rest = i.value[2];
            # the options the client was created with are returned
            assertEq(url, rest.getConstructorOptions().url, i.key);
            # default headers and a connection path set after the client was created are used by the stream
            rest.addDefaultHeaders({"X-Test-Echo": "-echo"});
            string path = i.value[0];
            if (path =~ /^v1(beta)?\//) {
                rest.setConnectionPath("/v2");
                path =~ s/^v1(beta)?/v2/;
            } else {
                rest.setConnectionPath("/api");
                path = "api/" + path;
            }
            object stream = i.value[1]({"model": "m"});
            list<string> data = ();
            while (*hash<SseMessageInfo> evt = stream.readEvent(10s)) {
                data += evt.data;
            }
            assertEq((path + " {\"model\":\"m\"}", "one", "two", "three-echo"), data, i.key);
        }
    }

    closeTest() {
        foreach hash<auto> i in (getOpeners().pairIterator()) {
            object stream = i.value[1]({});
            assertFalse(stream.isDone(), i.key);
            stream.close();
            assertTrue(stream.isDone(), i.key);
            # a closed stream returns no more events
            assertNothing(stream.readEvent(10s), i.key);
            # closing again has no effect
            stream.close();
            assertTrue(stream.isDone(), i.key);
        }
    }
}
