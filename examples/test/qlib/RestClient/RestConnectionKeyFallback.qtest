            "required_options": "domain,oauth2_client_id,oauth2_client_secret|domain,apikey",
        };
    }

    constructor(hash<auto> opts, string url = NoServer) : TestKeyConnection("domain", opts, url) {
    }

    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
