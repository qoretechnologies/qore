%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires Logger
%requires Mime
%requires json
%requires ConnectionProvider
%requires RestClient
%requires RestClientIo
%requires HttpServerUtil
%requires HttpServer
%requires ShippoRestClient
%requires KlaviyoRestClient
%requires ConfluenceRestClient

%exec-class RestConnectionKeyFallbackTest

#! The URL of a local port that nothing listens on; no request in this test leaves the host
const NoServer = "http://127.0.0.1:9";

#! OAuth2 options of the test schemes: the authorization code grant by default, at local URLs
const OAuth2Defaults = RestConnection::ConnectionScheme.options + {
    "oauth2_grant_type": connection_option_override(RestConnection::ConnectionScheme.options.oauth2_grant_type, {
        "default_value": "authorization_code",
    }),
    "oauth2_auth_url": connection_option_override(RestConnection::ConnectionScheme.options.oauth2_auth_url, {
        "default_value": NoServer + "/oauth2/authorize",
    }),
    "oauth2_token_url": connection_option_override(RestConnection::ConnectionScheme.options.oauth2_token_url, {
        "default_value": NoServer + "/oauth2/token",
    }),
    "oauth2_redirect_url": connection_option_override(RestConnection::ConnectionScheme.options.oauth2_redirect_url,
        {
        "default_value": "http://127.0.0.1:9/callback",
    }),
};

#! A sensitive API key option
const ApiKeyOption = <ConnectionOptionInfo>{
    "display_name": "API Key",
    "short_desc": "An API key",
    "type": "string",
    "desc": "An API key",
    "sensitive": True,
};

#! A connection whose scheme is given by its subclass
class TestKeyConnection inherits RestConnection {
    constructor(string name, hash<auto> opts, string url) : RestConnection(name, "test", url, {}, opts) {
    }

    #! Does not check the required options, so that a connection can lack the OAuth2 client ID and secret
    /** The platform supplies them from its API servers, so a connection's own options can lack them
    */
    private hash<auto> validateOptions(hash<auto> options, bool check_required = True) {
        return RestConnection::validateOptions(options, False);
    }

    #! Returns the OAuth2 grant type the connection publishes
    *string grantType() {
        return getOAuth2GrantType();
    }

    #! Returns the result of the hook under test
    bool nonOAuth2() {
        return usesNonOAuth2Credential();
    }
}

#! OAuth2 first, an API key as the fallback (Deel, Shippo)
class ApiKeyConnection inherits TestKeyConnection {
    public {
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "API Key Fallback",
            "short_desc": "test",
            "desc": "test",
            "cls": Class::forName("ApiKeyConnection"),
            "schemes": {"rest": True},
            "base_scheme_map": {"http": "rest"},
            "options": OAuth2Defaults + {"apikey": ApiKeyOption},
            "required_options": "oauth2_client_id,oauth2_client_secret|apikey",
        };
    }

    constructor(hash<auto> opts, string url = NoServer) : TestKeyConnection("apikey", opts, url) {
    }

    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}

#! OAuth2 first, a token as the fallback (Klaviyo, GitHub, GitLab, Intercom)
class TokenConnection inherits TestKeyConnection {
    public {
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "Token Fallback",
            "short_desc": "test",
            "desc": "test",
            "cls": Class::forName("TokenConnection"),
            "schemes": {"rest": True},
            "base_scheme_map": {"http": "rest"},
            "options": OAuth2Defaults,
            "required_options": "oauth2_client_id,oauth2_client_secret|token",
        };
    }

    constructor(hash<auto> opts, string url = NoServer) : TestKeyConnection("token", opts, url) {
    }

    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}

#! The token first, as older modules name it (Google, Wave, Linear)
class TokenFirstConnection inherits TestKeyConnection {
    public {
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "Token First",
            "short_desc": "test",
            "desc": "test",
            "cls": Class::forName("TokenFirstConnection"),
            "schemes": {"rest": True},
            "base_scheme_map": {"http": "rest"},
            "options": OAuth2Defaults,
            "required_options": "token|oauth2_auth_url,oauth2_grant_type,oauth2_token_url,oauth2_client_id,"
                "oauth2_client_secret",
        };
    }

    constructor(hash<auto> opts, string url = NoServer) : TestKeyConnection("token-first", opts, url) {
    }

    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        return ConnectionScheme;
    }
}

#! An identifier shared by both alternatives (Freshsales)
class SharedDomainConnection inherits TestKeyConnection {
    public {
        const ConnectionScheme = <ConnectionSchemeInfo>{
            "display_name": "Shared Domain",
            "short_desc": "test",
            "desc": "test",
            "cls": Class::forName("SharedDomainConnection"),
            "schemes": {"rest": True},
            "base_scheme_map": {"http": "rest"},
            "options": OAuth2Defaults + {
                "apikey": ApiKeyOption,
                "domain": <ConnectionOptionInfo>{
                    "display_name": "Domain",
                    "short_desc": "the domain",
                    "type": "string",
                    "desc": "the domain",
                },
