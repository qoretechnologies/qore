#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
#
# OAuth2 credentials that trusted code seals into a client are used for the client's token requests but never given
# out, and are sent only to their sealed token endpoint (qoretechnologies/qore#7248)
# test-platform: macos - TLS certificate verification, HTTPS proxies (CONNECT) and sockets of the token requests

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires Util
%requires Mime
%requires json
%requires Logger
%requires HttpServer
%requires RestClient
%requires RestClientIo

# the reflection module is in this repository, but a build can omit it
%try-module reflection
%define NoReflection
%endtry

%modern
%no-child-restrictions

%exec-class SealedOAuth2CredentialsTest

#! The token endpoint of the tests: records the form bodies and headers of the requests
class TokenHandler inherits AbstractHttpRequestHandler {
    public {
        #! the requests: list of {"body", "authorization"}
        list<hash<auto>> requests = ();

        #! the response mode: "ok", "redirect" (to \c redirect_url) or "echo" (an error echoing the request)
        string mode = "ok";

        #! the redirect target of mode "redirect"
        string redirect_url;
    }

    private {
        Mutex m();
    }

    hash<auto> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        string b = body.typeCode() == NT_BINARY ? body.toString() : (body ?? "");
        {
            AutoLock al(m);
            requests += {"body": b, "authorization": hdr.authorization};
        }
        switch (mode) {
            case "echo200":
                # a token response that echoes the request: its body (URL-encoded) and its basic authentication
                # (base64) in fields and a header
                return makeResponse(200, make_json({"access_token": "tok", "token_type": "Bearer",
                    "echo": b, "auth": hdr.authorization ?? ""}), {"Content-Type": MimeTypeJson,
                    "X-Echo": b});
            case "echobin":
                return makeResponse(400, binary(b + " " + (hdr.authorization ?? "")),
                    {"Content-Type": MimeTypeOctetStream, "X-Echo": b});
            case "redirect":
                return makeResponse(302, "", {"Location": redirect_url});
            case "echo":
                return makeResponse(400, make_json({"error": "invalid_client", "error_description":
                    "rejected: " + b + " " + (hdr.authorization ?? "")}), {"Content-Type": MimeTypeJson});
        }
        return makeResponse(200, make_json({"access_token": "tok-" + requests.size(), "token_type": "Bearer",
            "expires_in": 3600}), {"Content-Type": MimeTypeJson});
    }

    list<hash<auto>> take() {
        AutoLock al(m);
        on_exit requests = ();
        return requests;
    }
}

#! A "proxy" that records what it receives on one connection and refuses it
class RecordingProxy {
    public {
        int port;
    }

    private {
        Socket s();
        Queue q();
    }

    constructor() {
        s.bind("127.0.0.1:0");
        s.listen();
        port = s.getSocketInfo().port;
        background accept();
    }

    #! returns what the proxy received
    string get() {
        return q.get(30s);
    }

    private accept() {
        string rv;
        try {
            *Socket c = s.accept(30s);
            if (c) {
                # the request head of a CONNECT or a plain request ends with an empty line
                while (rv !~ /\r\n\r\n/) {
                    rv += c.recv(-1, 10s);
                }
                c.send("HTTP/1.1 403 Forbidden\r\nContent-Length: 0\r\nConnection: close\r\n\r\n");
                c.close();
            }
        } catch (hash<ExceptionInfo> ex) {
            rv += sprintf("<%s>", ex.err);
        }
        q.push(rv ?? "");
    }
}

#! A connection whose clients get sealed credentials, as a platform's connection class gives them
class SealedConnection inherits RestConnection {
    private {
        SealedOAuth2Credentials creds;
    }

    constructor(SealedOAuth2Credentials creds, string url, hash<auto> opts)
            : RestConnection("sealed", "sealed", url, {"monitor": False}, opts) {
        self.creds = creds;
    }

    #! the options of the connection's clients, synchronous and asynchronous: with the sealed credentials
    *hash<auto> getConnectionOptions(*hash<auto> rtopts) {
        return RestConnection::getConnectionOptions(rtopts) + {"oauth2_sealed_credentials": creds};
    }
}

#! The ping endpoint of the tests
class PingHandler inherits AbstractHttpRequestHandler {
    public {
        list<string> seen_auth = ();
    }

    hash<auto> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        seen_auth += hdr.authorization ?? "";
        return makeResponse(200, "{}", {"Content-Type": MimeTypeJson});
    }
}

class SealedOAuth2CredentialsTest inherits QUnit::Test {
    public {
        const Secret = "s3cr3t-7248-" + get_random_string(12);
        const ClientId = "client-7248";
    }

    private {
        HttpServer server;
        TokenHandler handler();
        TokenHandler attacker();
        int tls_port;
        int attacker_port;
        string pem;
    }

    constructor() : QUnit::Test("SealedOAuth2Credentials", "1.0") {
        addTestCase("the secret is used for token requests", \tokenTest());
        addTestCase("the secret is never given out", \notGivenOutTest());
        addTestCase("the secret goes only to the sealed endpoint", \endpointTest());
        addTestCase("certificate verification is forced", \verifyTest());
        addTestCase("a proxy sees only a CONNECT tunnel", \proxyTest());
        addTestCase("redirects are not followed", \redirectTest());
        addTestCase("errors and non-blocking output do not echo the secret", \errorTest());
        addTestCase("the credentials are sealed once and limited to their grant types", \sealOnceTest());
        addTestCase("sandboxed code cannot read the secret", \sandboxTest());
        addTestCase("invalid credentials are refused", \invalidTest());
        addTestCase("RestClientIo uses sealed credentials without giving them out", \restClientIoTest());
        addTestCase("a connection's non-blocking ping refreshes with sealed credentials", \pingTest());
        addTestCase("a connection's synchronous ping checks its configuration with sealed credentials",
            \syncPingTest());
        addTestCase("encoded echoes of the secret are not returned", \encodedEchoTest());
        addTestCase("the trusted CA certificates are captured when the credentials are created", \caCaptureTest());
        addTestCase("sandboxed code uses sealed credentials without file access", \sandboxedUseTest());
        addTestCase("the client's CA options do not change the sealed anchors", \clientCaTest());
        set_return_value(main());
    }

    globalSetUp() {
        pem = get_script_dir() + "/sealed-oauth2-localhost.pem";
        string pem_text = ReadOnlyFile::readTextFile(pem);
        server = new HttpServer(<HttpServerOptionInfo>{"logger": new Logger("sealed", LoggerLevel::getLevelInfo())});
        server.setHandler("token", "/token", NOTHING, handler);
        tls_port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0,
            "cert": new SSLCertificate(pem_text), "key": new SSLPrivateKey(pem_text)}).port;
    }

    globalTearDown() {
        delete server;
    }

    #! logs the client in with a request: its token request is made first; the request itself fails, as the API
    #! URL has no server
    static login(RestClient rc) {
        try {
            rc.get("/api");
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "OAUTH2-SEALED-ERROR") {
                rethrow;
            }
        }
    }

    #! returns sealed credentials for the test token endpoint
    SealedOAuth2Credentials creds(*hash<auto> opts) {
        return new SealedOAuth2Credentials({
            "client_id": ClientId,
            "client_secret": Secret,
            "token_url": sprintf("https://127.0.0.1:%d/token", tls_port),
            "grant_types": ("client_credentials", "refresh_token"),
            "ssl_ca_file": pem,
        } + opts);
    }

    #! returns a client with sealed credentials and the client credentials grant
    RestClient client(*hash<auto> opts, *hash<auto> creds_opts) {
        return new RestClient({
            "url": "http://127.0.0.1:1",
            "oauth2_grant_type": "client_credentials",
            "oauth2_sealed_credentials": creds(creds_opts),
        } + opts, True);
    }

    tokenTest() {
        RestClient rc = client();
        handler.take();
        login(rc);
        assertEq("tok-1", rc.getToken());
        list<hash<auto>> reqs = handler.take();
        assertEq(1, reqs.size());
        hash<auto> form = mime_parse_form_urlencoded_string(reqs[0].body);
        assertEq(Secret, form.client_secret);
        assertEq(ClientId, form.client_id);
        assertEq("client_credentials", form.grant_type);

        # basic authentication
        rc = client(NOTHING, {"token_use_basic_auth": True});
        login(rc);
        reqs = handler.take();
        form = mime_parse_form_urlencoded_string(reqs[0].body);
        assertNothing(form.client_secret);
        assertEq("Basic " + make_base64_string(ClientId + ":" + Secret), reqs[0].authorization);
    }

    notGivenOutTest() {
        RestClient rc = client({"oauth2_client_secret": "tenant-own"});
        hash<auto> o = rc.getOAuth2Options();
        assertEq("tenant-own", o.oauth2_client_secret, "the client's own option is the owner's");
        assertTrue(o.oauth2_sealed_credentials instanceof SealedOAuth2Credentials);
        string all = sprintf("%N %N %N", o, rc.getSealedOAuth2Credentials(), rc);
        assertFalse(all.find(Secret) >= 0, "no secret in the options or the objects' dumps");
        SealedOAuth2Credentials c = rc.getSealedOAuth2Credentials();
        assertEq(ClientId, c.getClientId());
        assertEq(sprintf("https://127.0.0.1:%d/token", tls_port), c.getTokenUrl());
        # serialization: the client without the transient credentials; the credentials not at all
        string ser = sprintf("%y", Serializable::serializeToData(rc));
        assertFalse(ser.find(Secret) >= 0, "no secret in the serialized client");
        assertThrows("SERIALIZATION-ERROR", sub () { Serializable::serialize(c); });
        # a copy uses the same credentials
        SealedOAuth2Credentials c2 = c.copy();
        assertEq(c.getTokenUrl(), c2.getTokenUrl());
        # other clients made from the client keep them; a deserialized client has none
        assertTrue(rc.getConstructorOptions().oauth2_sealed_credentials == c);
        assertTrue(cast<RestClient>(rc.copyWithUrl("http://127.0.0.1:2")).getSealedOAuth2Credentials() == c);
        RestClient d = Serializable::deserialize(Serializable::serialize(rc));
        assertNothing(d.getSealedOAuth2Credentials());
%ifndef NoReflection
        # trusted reflection of the client's members does not reach the credentials' members
        foreach AbstractClassMember m in (Class::forName("RestClient::SealedOAuth2Credentials").getMembers()) {
            assertEq("private:internal", m.getAccessModifierString(), m.getName());
        }
%endif
    }

    endpointTest() {
        # an attacker endpoint set as the client's token URL and alternate token URL receives nothing
        HttpServer a(<HttpServerOptionInfo>{"logger": new Logger("attacker", LoggerLevel::getLevelInfo())});
        on_exit delete a;
        a.setHandler("token", "/token", NOTHING, attacker);
        int port = a.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        string aurl = sprintf("http://127.0.0.1:%d/token", port);
        RestClient rc = client({"oauth2_token_url": aurl, "oauth2_alt_token_url": aurl,
            "oauth2_client_secret": "tenant-own"});
        handler.take();
        login(rc);
        assertEq((), attacker.take(), "the attacker endpoint received nothing");
        assertEq(1, handler.take().size(), "the sealed endpoint received the request");
    }

    verifyTest() {
        # without the CA file, the certificate of the endpoint cannot be verified: the request fails, even though
        # the client turned verification off
        RestClient rc = client({"ssl_verify_cert": False}, {"ssl_ca_file": NOTHING});
        handler.take();
        assertThrows("OAUTH2-SEALED-ERROR", \login(), rc);
        assertEq((), handler.take(), "no request reached the endpoint");
    }

    proxyTest() {
        RecordingProxy p();
        RestClient rc = client({"proxy": sprintf("http://127.0.0.1:%d", p.port)});
        assertThrows("OAUTH2-SEALED-ERROR", \login(), rc);
        string seen = p.get();
        assertRegex("^CONNECT 127\\.0\\.0\\.1:" + tls_port, seen, "the proxy saw a CONNECT tunnel");
        assertFalse(seen.find(Secret) >= 0, "the proxy did not see the secret");
    }

    redirectTest() {
        HttpServer a(<HttpServerOptionInfo>{"logger": new Logger("attacker", LoggerLevel::getLevelInfo())});
        on_exit delete a;
        a.setHandler("token", "/token", NOTHING, attacker);
        int port = a.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        handler.mode = "redirect";
        handler.redirect_url = sprintf("http://127.0.0.1:%d/token", port);
        on_exit handler.mode = "ok";
        RestClient rc = client();
        assertThrows("OAUTH2-SEALED-ERROR", \login(), rc);
        assertEq((), attacker.take(), "the redirect was not followed");
    }

    errorTest() {
        handler.mode = "echo";
        on_exit handler.mode = "ok";
        RestClient rc = client();
        try {
            login(rc);
            assertTrue(False, "the request failed");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("OAUTH2-SEALED-ERROR", ex.err);
            assertRegex("400", ex.desc);
            assertRegex("invalid_client", ex.desc);
            string all = sprintf("%s %y", ex.desc, ex.arg);
            assertFalse(all.find(Secret) >= 0, "no secret in the error");
        }
        # the output of a non-blocking request has no request part and masks an echoed secret
        AbstractPollOperation op = rc.startOAuth2PollSendRecv();
        while (*hash<SocketPollInfo> info = op.continuePoll()) {
            Socket::poll((info,), 30s);
        }
        auto out = op.getOutput();
        assertEq(400, out.code);
        assertEq(sort(("info", "code", "response-body")), sort(keys out));
        string all = sprintf("%y", out);
        assertFalse(all.find(Secret) >= 0, "no secret in the poll output");
    }

    sealOnceTest() {
        RestClient rc = client();
        SealedOAuth2Credentials other = creds();
        assertThrows("OAUTH2-SEALED-ERROR", \rc.setOAuth2Options(), {"oauth2_sealed_credentials": other});
        # the same object again is accepted
        rc.setOAuth2Options({"oauth2_sealed_credentials": rc.getSealedOAuth2Credentials()});
        # a grant type that the credentials do not allow
        RestClient pw = client({"oauth2_grant_type": "password", "username": "u", "password": "p"});
        assertThrows("OAUTH2-SEALED-ERROR", \login(), pw);
        assertThrows("OAUTH2-SEALED-ERROR", sub () { other.requestToken({"grant_type": "authorization_code"}); });
    }

    sandboxTest() {
        RestClient rc = client();
        Program p(PO_NEW_STYLE | PO_NO_CHILD_PO_RESTRICTIONS);
        p.parse("%requires RestClient\n"
%ifndef NoReflection
            "%requires reflection\n"
%endif
            "string sub t(object rc) { list<string> rv = (); "
            "rv += sprintf(\"opts:%N\", rc.getOAuth2Options()); "
%ifndef NoReflection
            "try { foreach AbstractClassMember m in (Class::forName(\"RestClient::SealedOAuth2Credentials\")"
            ".getMembers()) { rv += sprintf(\"%y\", cast<NormalMember>(m).getValue(rc.getSealedOAuth2Credentials())); }"
            " } catch (hash<ExceptionInfo> ex) { rv += ex.err; } "
%endif
            "return rv.join(\" \"); }", "tenant");
        p.setSandboxManager(new SandboxManager());
        string out = p.callFunction("t", rc);
        assertFalse(out.find(Secret) >= 0, "no secret for sandboxed code");
%ifndef NoReflection
        assertRegex("REFLECTION-ACCESS-ERROR", out);
%endif
        # a subclass of the credentials cannot be declared
        Program p2(PO_NEW_STYLE | PO_NO_CHILD_PO_RESTRICTIONS);
        assertThrows("PARSE-EXCEPTION", \p2.parse(), ("%requires RestClient\nclass X inherits "
            "SealedOAuth2Credentials { string get() { return client_secret; } }", "tenant2"));
    }

    restClientIoTest() {
        RestClientIo rcio({
            "url": "http://127.0.0.1:1",
            "oauth2_grant_type": "client_credentials",
            "oauth2_sealed_credentials": creds(),
            "oauth2_token_url": "http://127.0.0.1:1/attacker",
            "skip_login": True,
        });
        hash<auto> o = rcio.getOAuth2Options();
        assertNothing(o.oauth2_client_secret);
        assertEq(ClientId, o.oauth2_client_id);
        assertFalse(sprintf("%N %N", o, rcio).find(Secret) >= 0, "no secret in the options or the object's dump");
        # the token request goes to the sealed endpoint
        handler.take();
        try {
            rcio.restGetAsync("/api").get();
        } catch (hash<ExceptionInfo> ex) {
            assertTrue(ex.err != "OAUTH2-SEALED-ERROR", ex.err + ": " + ex.desc);
        }
        list<hash<auto>> reqs = handler.take();
        assertEq(1, reqs.size());
        assertEq(Secret, mime_parse_form_urlencoded_string(reqs[0].body).client_secret);
        # the non-blocking request: no request part is given out
        hash<auto> h = rcio.startOAuth2PollRefreshToken();
        assertEq(("poll",), keys h);
        AbstractPollOperation op = h.poll;
        while (*hash<SocketPollInfo> info = op.continuePoll()) {
            Socket::poll((info,), 30s);
        }
        auto out = op.getOutput();
        assertEq(200, out.code);
        assertFalse(sprintf("%y", out).find(Secret) >= 0, "no secret in the poll output");
        handler.take();
        # copies keep the credentials; serialization drops them
        assertTrue(rcio.getConstructorOptions().oauth2_sealed_credentials == rcio.getSealedOAuth2Credentials());
        assertTrue(cast<RestClientIo>(rcio.copyWithUrl("http://127.0.0.1:2")).getSealedOAuth2Credentials()
            == rcio.getSealedOAuth2Credentials());
        assertThrows("OAUTH2-SEALED-ERROR", \rcio.setOAuth2Options(), {"oauth2_sealed_credentials": creds()});
    }

    pingTest() {
        PingHandler ph();
        HttpServer api(<HttpServerOptionInfo>{"logger": new Logger("api", LoggerLevel::getLevelInfo())});
        on_exit delete api;
        api.setHandler("ping", "/ping", NOTHING, ph);
        int port = api.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        # an expired token with a refresh token: the ping refreshes it first
        SealedConnection conn(creds(), sprintf("http://127.0.0.1:%d", port), {
            "oauth2_grant_type": "client_credentials",
            "oauth2_client_id": ClientId,
            "token": "old",
            "oauth2_refresh_token": "rt",
            "oauth2_token_expiry": now_us() - 1h,
            "ping_method": "GET",
            "ping_path": "/ping",
        });
        handler.take();
        AbstractPollOperation op = conn.startPollConnect();
        while (*hash<SocketPollInfo> info = op.continuePoll()) {
            Socket::poll((info,), 30s);
        }
        assertTrue(op.goalReached(), "the ping succeeded");
        list<hash<auto>> reqs = handler.take();
        assertEq(1, reqs.size(), "one token request");
        hash<auto> form = mime_parse_form_urlencoded_string(reqs[0].body);
        assertEq("refresh_token", form.grant_type);
        assertEq(Secret, form.client_secret);
        assertEq("Bearer tok-1", ph.seen_auth.last(), "the ping used the new token");
    }

    #! issue #7236: a ping checks the configuration with the options of the connection's clients, where a subclass
    #! gives its sealed credentials; the connection's own options have no client secret or token URL
    syncPingTest() {
        PingHandler ph();
        HttpServer api(<HttpServerOptionInfo>{"logger": new Logger("api", LoggerLevel::getLevelInfo())});
        on_exit delete api;
        api.setHandler("ping", "/ping", NOTHING, ph);
        int port = api.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        string url = sprintf("http://127.0.0.1:%d", port);
        hash<auto> opts = {
            "oauth2_grant_type": "client_credentials",
            "oauth2_client_id": ClientId,
            "token": "old",
            "oauth2_refresh_token": "rt",
            "oauth2_token_expiry": now_us() - 1h,
            "ping_method": "GET",
            "ping_path": "/ping",
        };

        SealedConnection conn(creds(), url, opts);
        handler.take();
        hash<PingInfo> ping = conn.ping();
        assertTrue(ping.ok, ping.info);
        assertTrue(conn.up);
        assertEq("OK", conn.status);
        list<hash<auto>> reqs = handler.take();
        assertEq(1, reqs.size(), "one token request");
        assertEq(Secret, mime_parse_form_urlencoded_string(reqs[0].body).client_secret);
        assertEq("Bearer tok-1", ph.seen_auth.last(), "the ping used the new token");

        # without sealed credentials and without its own client secret and token URL, the configuration cannot work
        RestConnection plain("plain", "plain", url, {"monitor": False}, opts);
        ping = plain.ping();
        assertFalse(ping.ok);
        assertEq("OAUTH2-ERROR", ping.ex.err);
        assertRegex("oauth2_client_secret", ping.ex.desc);
        assertFalse(plain.up);
        assertRegex("^OAUTH2-ERROR: ", plain.status);
        assertThrows("OAUTH2-ERROR", \plain.ping(), True);
        assertEq((), handler.take(), "no token request without sealed credentials");
    }

    encodedEchoTest() {
        # a secret that changes when it is URL-encoded
        string secret = "Ab+c/d=e" + get_random_string(8);
        string enc = mime_get_urlencoded_string(secret);
        string b64 = make_base64_string(ClientId + ":" + secret);
        code check = sub (string label, auto v) {
            string str = sprintf("%y", v);
            assertFalse(str.find(secret) >= 0 || str.find(enc) >= 0 || str.find(b64) >= 0, label);
        };
        on_exit handler.mode = "ok";
        foreach bool basic in ((False, True)) {
            SealedOAuth2Credentials c = creds({"client_secret": secret, "token_use_basic_auth": basic});
            handler.mode = "echo200";
            hash<auto> rv = c.requestToken({"grant_type": "client_credentials"});
            check("requestToken() " + basic, rv);
            assertEq(("access_token", "token_type"), keys rv);
            # the poll output of a token response and of an error with a binary body
            foreach string mode in ("echo200", "echobin") {
                handler.mode = mode;
                AbstractPollOperation op = c.startPollRequestToken({"grant_type": "client_credentials"});
                while (*hash<SocketPollInfo> info = op.continuePoll()) {
                    Socket::poll((info,), 30s);
                }
                check(mode + " poll output " + basic, op.getOutput());
            }
            handler.mode = "echobin";
            try {
                c.requestToken({"grant_type": "client_credentials"});
                assertTrue(False, "the request failed");
            } catch (hash<ExceptionInfo> ex) {
                check("binary error " + basic, ex);
            }
        }
        handler.take();
        # with a secret that occurs in the text of the error, the text is not changed: nothing shows where it occurs
        handler.mode = "echo";
        try {
            creds({"client_secret": "s"}).requestToken({"grant_type": "client_credentials"});
            assertTrue(False, "the request failed");
        } catch (hash<ExceptionInfo> ex) {
            assertRegex("^the OAuth2 token request to \"https://127\\.0\\.0\\.1:", ex.desc);
            assertFalse(ex.desc =~ /masked/, "no masking marks the secret's occurrences");
        }
        handler.mode = "ok";
        handler.take();
        # a form value that cannot be sent raises an error of the credentials, without the secret
        try {
            creds().requestToken({"grant_type": "client_credentials", "x": (1, 2)});
            assertTrue(False, "the request failed");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("OAUTH2-SEALED-ERROR", ex.err);
            check("form error", ex);
        }
        # the grant type must be a string
        assertThrows("OAUTH2-SEALED-ERROR", sub () { creds().requestToken({"grant_type": ("refresh_token",
            "client_credentials")}); });
    }

    caCaptureTest() {
        *string old = getenv("SSL_CERT_FILE");
        on_exit {
            if (exists old) {
                setenv("SSL_CERT_FILE", old);
            } else {
                unsetenv("SSL_CERT_FILE");
            }
        }
        # credentials created without CA certificates capture the default ones: setting SSL_CERT_FILE to the CA of
        # the endpoint later does not make it trusted
        SealedOAuth2Credentials before = creds({"ssl_ca_file": NOTHING});
        setenv("SSL_CERT_FILE", pem);
        assertEq(pem, get_default_ssl_ca_locations().file);
        handler.take();
        assertThrows("OAUTH2-SEALED-ERROR", \before.requestToken(), {"grant_type": "client_credentials"});
        assertEq((), handler.take(), "no request reached the endpoint");
        # credentials created now capture the CA of the endpoint
        SealedOAuth2Credentials after = creds({"ssl_ca_file": NOTHING});
        assertEq("tok-1", after.requestToken({"grant_type": "client_credentials"}).access_token);
        handler.take();
    }

    sandboxedUseTest() {
        # trusted code creates the credentials (its CA file is read now) and the client; a tenant whose sandbox allows
        # the network but no file uses the client: the token request reads no file
        RestClient rc = client();
        Program p(PO_NEW_STYLE | PO_NO_CHILD_PO_RESTRICTIONS);
        p.parse("%requires RestClient\n"
            "string sub t(object rc, string pem) { "
            "try { ReadOnlyFile::readTextFile(pem); return \"file read\"; } catch (hash<ExceptionInfo> ex) { "
            "if (ex.err != \"FILESYSTEM-ACCESS-DENIED\") { rethrow; } } "
            "try { rc.get(\"/api\"); } catch (hash<ExceptionInfo> ex) { "
            "if (ex.err =~ /OAUTH2|FILESYSTEM/) { return ex.err + \": \" + ex.desc; } } "
            "return rc.getToken() ?? \"no token\"; }", "tenant");
        SandboxManager sm();
        sm.setNetworkDefaultPolicy(True);
        p.setSandboxManager(sm);
        handler.take();
        assertEq("tok-1", p.callFunction("t", rc, pem));
        list<hash<auto>> reqs = handler.take();
        assertEq(1, reqs.size());
        assertEq(Secret, mime_parse_form_urlencoded_string(reqs[0].body).client_secret);
    }

    clientCaTest() {
        # credentials with the default CA certificates (which do not trust the endpoint): the client's own CA file,
        # which does, takes no part in the sealed request
        RestClient rc = client({"ssl_ca_file": pem, "ssl_verify_cert": True}, {"ssl_ca_file": NOTHING});
        handler.take();
        assertThrows("OAUTH2-SEALED-ERROR", \login(), rc);
        assertEq((), handler.take(), "no request reached the endpoint");
        # credentials with a trust store of the endpoint's certificate
        SSLTrustStore ts((new SSLCertificate(ReadOnlyFile::readTextFile(pem)),));
        rc = client(NOTHING, {"ssl_ca_file": NOTHING, "ssl_trust_store": ts});
        login(rc);
        assertEq("tok-1", rc.getToken());
        handler.take();
        # only one source of CA certificates
        assertThrows("OAUTH2-SEALED-ERROR", sub () { creds({"ssl_trust_store": ts}); });
    }

    invalidTest() {
        assertThrows("OAUTH2-SEALED-ERROR", sub () { new SealedOAuth2Credentials({"client_id": "c",
            "client_secret": Secret, "token_url": "http://127.0.0.1/token"}); });
        assertThrows("OAUTH2-SEALED-ERROR", sub () { new SealedOAuth2Credentials({"client_id": "c",
            "token_url": "https://127.0.0.1/token"}); });
        assertThrows("OAUTH2-SEALED-ERROR", sub () { new SealedOAuth2Credentials({"client_id": "c",
            "client_secret": Secret, "token_url": "https://127.0.0.1/token", "grant_types": ("bogus",)}); });
        try {
            new SealedOAuth2Credentials({"client_id": "c", "client_secret": Secret, "token_url": "ftp://" + Secret});
        } catch (hash<ExceptionInfo> ex) {
            assertFalse(ex.desc.find(Secret) >= 0, "no secret in the error");
        }
        assertThrows("OAUTH2-SEALED-ERROR", sub () { new RestClient({"url": "https://x.invalid",
            "oauth2_sealed_credentials": "not an object"}, True); });
    }
}
