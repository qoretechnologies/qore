    testRestClientIoPoolSharedMgrScalability() {
%ifndef NoJson
        if (!container_running) {
            testSkip("nginx container not available");
            return;
        }

        if (m_options.verbose > 2) {
            printf("\n  RestClientIoPool + shared manager scalability:\n");
        }

        # Single shared connection manager for all pooled instances
        HttpClientIo::HttpClientConnectionManager shared_mgr(
            <HttpClientIo::HttpClientConnectionManagerOptions>{
                "accept_all_certs": True,
                "protocol": "h2",
            }
        );

        foreach int threads in (ThreadCounts) {
            RestClientIo::RestClientIoPool pool(
                {"url": base_url, "data": "json", "error_passthru": True,
                 "accept_all_certs": True, "protocol": "h2"},
                <Qore::Thread::ConnectionPoolOptions>{"min": min(threads, 5), "max": threads + 5},
                shared_mgr);
            on_exit pool.shutdown();

            int per_thread = RequestsPerThread;
            int total = threads * per_thread;
            Counter done(threads);
            Mutex mtx();
            int success_count = 0;

            date start = now_us();
            for (int t = 0; t < threads; ++t) {
                background sub () {
                    on_exit done.dec();
                    for (int i = 0; i < per_thread; ++i) {
                        try {
                            RestClientIo::RestClientIo rc = pool.acquire();
                            on_exit pool.release();
                            hash<RestClient::RestResponseInfo> resp = rc.restGet("/api/echo");
                            if (resp.status_code == 200) {
                                mtx.lock();
                                on_exit mtx.unlock();
                                ++success_count;
                            }
                        } catch () {
                            # count failure silently
                        }
                    }
                }();
            }
            int remaining = done.waitForZero(120s);
            float total_ms = elapsedMs(start);

            assertEq(0, remaining, sprintf("%d-thread: all threads should complete", threads));
            # Shared manager funnels all streams through fewer connections, so under heavy
            # concurrency HTTP/2 stream limits can cause some failures — use 80% threshold
            assertGe(total * 80 / 100, success_count,
                sprintf("%d-thread: at least 80%% success (got %d/%d)", threads, success_count, total));

            if (m_options.verbose > 2) {
                float throughput = success_count * 1000.0 / total_ms;
                printf("    %3d threads: %4d/%4d OK in %7.1fms = %7.1f req/s\n",
                    threads, success_count, total, total_ms, throughput);
            }
        }
%endif
    }

    testRestClientIoPoolSharedMgrH3Scalability() {
%ifndef NoJson
        if (!container_running) {
            testSkip("nginx container not available");
            return;
        }

        if (m_options.verbose > 2) {
            printf("\n  RestClientIoPool + shared manager H3 scalability:\n");
        }

        # Single shared connection manager persists across all thread-count
        # iterations — exercises dead-connection detection and eviction
        # between bursts when QUIC sessions are recycled by the server.
        HttpClientIo::HttpClientConnectionManager shared_mgr(
            <HttpClientIo::HttpClientConnectionManagerOptions>{
                "accept_all_certs": True,
                "protocol": "h3",
            }
        );

        foreach int threads in (ThreadCounts) {
            RestClientIo::RestClientIoPool pool(
                {"url": base_url, "data": "json", "error_passthru": True,
                 "accept_all_certs": True, "protocol": "h3"},
                <Qore::Thread::ConnectionPoolOptions>{"min": min(threads, 5), "max": threads + 5},
                shared_mgr);
            on_exit pool.shutdown();

            int per_thread = RequestsPerThread;
            int total = threads * per_thread;
            Counter done(threads);
            Mutex mtx();
            int success_count = 0;
            hash<string, int> errors();

            date start = now_us();
            for (int t = 0; t < threads; ++t) {
                background sub () {
                    on_exit done.dec();
                    for (int i = 0; i < per_thread; ++i) {
                        try {
                            RestClientIo::RestClientIo rc = pool.acquire();
                            on_exit pool.release();
                            hash<RestClient::RestResponseInfo> resp = rc.restGet("/api/echo");
                            if (resp.status_code == 200) {
                                mtx.lock();
                                on_exit mtx.unlock();
                                ++success_count;
                            }
                        } catch (hash<ExceptionInfo> ex) {
                            mtx.lock();
                            on_exit mtx.unlock();
                            errors{ex.err} = (errors{ex.err} ?? 0) + 1;
                        }
                    }
                }();
            }
            int remaining = done.waitForZero(120s);
            float total_ms = elapsedMs(start);

            assertEq(0, remaining, sprintf("%d-thread: all threads should complete", threads));
            assertGe(total * 90 / 100, success_count,
                sprintf("%d-thread: at least 90%% success (got %d/%d, errors: %y)",
                    threads, success_count, total, errors));

            if (m_options.verbose > 2) {
                float throughput = success_count * 1000.0 / total_ms;
                printf("    %3d threads: %4d/%4d OK in %7.1fms = %7.1f req/s",
                    threads, success_count, total, total_ms, throughput);
                if (errors) {
                    printf(" errors: %y", errors);
                }
                printf("\n");
            }
        }
%endif
    }

    # ── HTTP/3 scalability ─────────────────────────────────────────────

    testRestClientPoolH3Scalability() {
%ifndef NoJson
        if (!container_running) {
            testSkip("nginx container not available");
            return;
        }

        if (m_options.verbose > 2) {
            printf("\n  RestClientPool H3 scalability (blocking I/O, HTTP/3 QUIC):\n");
        }

        foreach int threads in (ThreadCounts) {
            RestClient::RestClientPool pool(
                {"url": base_url, "data": "json", "accept_all_certs": True,
                 "http_version": "3.0"},
                <Qore::Thread::ConnectionPoolOptions>{"min": min(threads, 5), "max": threads + 5});
            on_exit pool.shutdown();

            int per_thread = RequestsPerThread;
            int total = threads * per_thread;
            Counter done(threads);
            Mutex mtx();
            int success_count = 0;

            date start = now_us();
            for (int t = 0; t < threads; ++t) {
                background sub () {
                    on_exit done.dec();
                    for (int i = 0; i < per_thread; ++i) {
                        try {
                            RestClient rc = cast<RestClient>(pool.acquire());
                            on_exit pool.release();
                            hash<auto> resp = rc.get("/api/echo");
                            if (resp.status_code == 200) {
                                mtx.lock();
                                on_exit mtx.unlock();
                                ++success_count;
                            }
                        } catch () {
                            # count failure silently
                        }
                    }
                }();
            }
            int remaining = done.waitForZero(120s);
            float total_ms = elapsedMs(start);

            assertEq(0, remaining, sprintf("%d-thread: all threads should complete", threads));
            assertGe(total * 90 / 100, success_count,
                sprintf("%d-thread: at least 90%% success (got %d/%d)", threads, success_count, total));

            if (m_options.verbose > 2) {
                float throughput = success_count * 1000.0 / total_ms;
                printf("    %3d threads: %4d/%4d OK in %7.1fms = %7.1f req/s\n",
                    threads, success_count, total, total_ms, throughput);
            }
        }
%endif
    }

    testRestClientIoPoolH3Scalability() {
%ifndef NoJson
        if (!container_running) {
            testSkip("nginx container not available");
            return;
        }

        if (m_options.verbose > 2) {
            printf("\n  RestClientIoPool H3 scalability (async multiplexed I/O, HTTP/3 QUIC):\n");
        }

        foreach int threads in (ThreadCounts) {
            RestClientIo::RestClientIoPool pool(
                {"url": base_url, "data": "json", "error_passthru": True,
                 "accept_all_certs": True, "protocol": "h3"},
                <Qore::Thread::ConnectionPoolOptions>{"min": min(threads, 5), "max": threads + 5});
            on_exit pool.shutdown();

            int per_thread = RequestsPerThread;
            int total = threads * per_thread;
            Counter done(threads);
            Mutex mtx();
            int success_count = 0;

            date start = now_us();
            for (int t = 0; t < threads; ++t) {
                background sub () {
                    on_exit done.dec();
                    for (int i = 0; i < per_thread; ++i) {
                        try {
                            RestClientIo::RestClientIo rc = pool.acquire();
                            on_exit pool.release();
                            hash<RestClient::RestResponseInfo> resp = rc.restGet("/api/echo");
                            if (resp.status_code == 200) {
                                mtx.lock();
                                on_exit mtx.unlock();
                                ++success_count;
                            }
                        } catch () {
                            # count failure silently
                        }
                    }
                }();
            }
            int remaining = done.waitForZero(120s);
            float total_ms = elapsedMs(start);

            assertEq(0, remaining, sprintf("%d-thread: all threads should complete", threads));
            assertGe(total * 90 / 100, success_count,
                sprintf("%d-thread: at least 90%% success (got %d/%d)", threads, success_count, total));

            if (m_options.verbose > 2) {
                float throughput = success_count * 1000.0 / total_ms;
                printf("    %3d threads: %4d/%4d OK in %7.1fms = %7.1f req/s\n",
                    threads, success_count, total, total_ms, throughput);
            }
        }
%endif
    }

    # ── Head-to-head comparison ────────────────────────────────────────

    testPoolComparison() {
%ifndef NoJson
        if (!container_running) {
            testSkip("nginx container not available");
            return;
        }

        int threads = 25;
        int per_thread = RequestsPerThread;
        int total = threads * per_thread;

        # --- RestClientPool (blocking) ---
        float blocking_ms;
        int blocking_success;
        {
            RestClient::RestClientPool pool(
                {"url": base_url, "data": "json", "accept_all_certs": True},
                <Qore::Thread::ConnectionPoolOptions>{"min": 5, "max": threads + 5});
            on_exit pool.shutdown();

            Counter done(threads);
            Mutex mtx();
            blocking_success = 0;

            date start = now_us();
            for (int t = 0; t < threads; ++t) {
                background sub () {
                    on_exit done.dec();
                    for (int i = 0; i < per_thread; ++i) {
                        try {
                            RestClient rc = cast<RestClient>(pool.acquire());
                            on_exit pool.release();
                            hash<auto> resp = rc.get("/api/echo");
                            if (resp.status_code == 200) {
                                mtx.lock();
                                on_exit mtx.unlock();
                                ++blocking_success;
                            }
                        } catch () {}
                    }
                }();
            }
            done.waitForZero(120s);
            blocking_ms = elapsedMs(start);
        }

        # --- RestClientIoPool H2 (async multiplexed) ---
        float async_h2_ms;
        int async_h2_success;
        {
            RestClientIo::RestClientIoPool pool(
                {"url": base_url, "data": "json", "error_passthru": True,
                 "accept_all_certs": True, "protocol": "h2"},
                <Qore::Thread::ConnectionPoolOptions>{"min": 5, "max": threads + 5});
            on_exit pool.shutdown();

            Counter done(threads);
            Mutex mtx();
            async_h2_success = 0;

            date start = now_us();
            for (int t = 0; t < threads; ++t) {
                background sub () {
                    on_exit done.dec();
                    for (int i = 0; i < per_thread; ++i) {
                        try {
                            RestClientIo::RestClientIo rc = pool.acquire();
                            on_exit pool.release();
                            hash<RestClient::RestResponseInfo> resp = rc.restGet("/api/echo");
                            if (resp.status_code == 200) {
                                mtx.lock();
                                on_exit mtx.unlock();
                                ++async_h2_success;
                            }
                        } catch () {}
                    }
                }();
            }
            done.waitForZero(120s);
            async_h2_ms = elapsedMs(start);
        }

        # --- RestClientPool H3 (blocking, QUIC) ---
        float blocking_h3_ms;
        int blocking_h3_success;
        {
            RestClient::RestClientPool pool(
                {"url": base_url, "data": "json", "accept_all_certs": True,
                 "http_version": "3.0"},
                <Qore::Thread::ConnectionPoolOptions>{"min": 5, "max": threads + 5});
            on_exit pool.shutdown();

            Counter done(threads);
            Mutex mtx();
            blocking_h3_success = 0;

            date start = now_us();
            for (int t = 0; t < threads; ++t) {
                background sub () {
                    on_exit done.dec();
                    for (int i = 0; i < per_thread; ++i) {
                        try {
                            RestClient rc = cast<RestClient>(pool.acquire());
                            on_exit pool.release();
                            hash<auto> resp = rc.get("/api/echo");
                            if (resp.status_code == 200) {
                                mtx.lock();
                                on_exit mtx.unlock();
                                ++blocking_h3_success;
                            }
                        } catch () {}
                    }
                }();
            }
            done.waitForZero(120s);
            blocking_h3_ms = elapsedMs(start);
        }

        # --- RestClientIoPool H3 (async multiplexed, QUIC) ---
        float async_h3_ms;
        int async_h3_success;
        {
            RestClientIo::RestClientIoPool pool(
                {"url": base_url, "data": "json", "error_passthru": True,
                 "accept_all_certs": True, "protocol": "h3"},
                <Qore::Thread::ConnectionPoolOptions>{"min": 5, "max": threads + 5});
            on_exit pool.shutdown();

            Counter done(threads);
            Mutex mtx();
            async_h3_success = 0;

            date start = now_us();
            for (int t = 0; t < threads; ++t) {
                background sub () {
                    on_exit done.dec();
                    for (int i = 0; i < per_thread; ++i) {
                        try {
                            RestClientIo::RestClientIo rc = pool.acquire();
                            on_exit pool.release();
                            hash<RestClient::RestResponseInfo> resp = rc.restGet("/api/echo");
                            if (resp.status_code == 200) {
                                mtx.lock();
                                on_exit mtx.unlock();
                                ++async_h3_success;
                            }
                        } catch () {}
                    }
                }();
            }
            done.waitForZero(120s);
            async_h3_ms = elapsedMs(start);
        }

        # All variants should succeed
        assertGe(total * 90 / 100, blocking_success,
            sprintf("blocking H2: at least 90%% success (got %d/%d)", blocking_success, total));
        assertGe(total * 90 / 100, async_h2_success,
            sprintf("async H2: at least 90%% success (got %d/%d)", async_h2_success, total));
        assertGe(total * 90 / 100, blocking_h3_success,
            sprintf("blocking H3: at least 90%% success (got %d/%d)", blocking_h3_success, total));
        assertGe(total * 90 / 100, async_h3_success,
            sprintf("async H3: at least 90%% success (got %d/%d)", async_h3_success, total));

        if (m_options.verbose > 2) {
            float blocking_rps = blocking_success * 1000.0 / blocking_ms;
            float async_h2_rps = async_h2_success * 1000.0 / async_h2_ms;
            float blocking_h3_rps = blocking_h3_success * 1000.0 / blocking_h3_ms;
            float async_h3_rps = async_h3_success * 1000.0 / async_h3_ms;
            printf("\n  Head-to-head comparison (%d threads x %d requests):\n", threads, per_thread);
            printf("    RestClientPool     (H2 blocking): %d/%d OK in %7.1fms = %7.1f req/s\n",
                blocking_success, total, blocking_ms, blocking_rps);
            printf("    RestClientIoPool   (H2 async)   : %d/%d OK in %7.1fms = %7.1f req/s\n",
                async_h2_success, total, async_h2_ms, async_h2_rps);
            printf("    RestClientPool     (H3 blocking): %d/%d OK in %7.1fms = %7.1f req/s\n",
                blocking_h3_success, total, blocking_h3_ms, blocking_h3_rps);
            printf("    RestClientIoPool   (H3 async)   : %d/%d OK in %7.1fms = %7.1f req/s\n",
                async_h3_success, total, async_h3_ms, async_h3_rps);
        }
%endif
    }
}
