#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - QUIC connections over UDP sockets, reset by a server that restarted on the same port

# Copyright (C) 2026 Qore Technologies, s.r.o.

# qore#6931: an HTTP/3 server answers a packet of a connection that it does not know with a stateless reset (RFC 9000
# section 10.3), whose token is derived from a static key that it derives from its private key: a server that restarts
# with the same key resets the connections of the server before it at once, and the client ends the connection with
# HTTP3-STATELESS-RESET instead of waiting for its connect timeout (HTTP3-PEER-UNRESPONSIVE, qore#6930); an idempotent
# request is repeated on a new connection, another one raises the error.  A server with another key cannot reset the
# connection: its reset has another token, which the client does not take.  The connect timeout of the client is long,
# so that a request that waited for it would fail the checks of the reset; the counts of the resets that the process
# sent and received (dbg_quic_stateless_reset_counts()) show which happened, with no clock involved.  The server is
# stopped as a killed one is with dbg_quic_silent_server_close() (debug builds), once neither the client nor the server
# has anything in flight (dbg_quic_wait_all_idle()), so that the client sends nothing more until the request.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Logger
%requires HttpServerUtil
%requires HttpServer
%requires RestClient
%requires json
%requires ../../TestCertificates.qm

%exec-class RestClientH3StatelessResetTest

#! The bound on a blocking wait: a hang guard only, never a timing assertion
const HangGuard = 60s;

#! The connect timeout of the client, which the load of the machine cannot exceed: a request that waits for it when
#! the server resets the connection (as before qore#6931) is ended by it, with HTTP3-PEER-UNRESPONSIVE, and fails the
#! checks of the reset
const LongConnectTimeout = 20s;

#! The peer response timeout of the old connection when the server cannot reset it, set only once the old server is
#! gone (dbg_quic_set_client_peer_response_timeout()), so that no other wait is bounded by it
const ShortPeerResponseTimeout = 1s;

