#! Answers each request with its method and body, and counts the requests
class CountingHandler inherits AbstractHttpRequestHandler {
    public {
        Counter requests();
    }

    hash<HttpResponseInfo> handleRequest(HttpListenerInterface listener, Socket s, hash<auto> cx, hash<auto> hdr,
            *data body) {
        requests.inc();
        return makeResponse(200, make_json({"method": hdr.method, "body": body ? string(body) : NOTHING}),
            {"Content-Type": "application/json"});
    }
}

class RestClientH3StatelessResetTest inherits QUnit::Test {
    constructor() : QUnit::Test("RestClientH3StatelessResetTest", "1.0") {
        addTestCase("a GET is reset by the restarted server and repeated on a new connection", \resetTest(), "GET");
        addTestCase("a POST raises HTTP3-STATELESS-RESET, and the next request takes a new connection", \resetTest(),
            "POST");
        addTestCase("a server with another key cannot reset the connection", \otherKeyTest());
        set_return_value(main());
    }

    #! starts an HTTPS server with HTTP/3 on the given port (0: assigned by the OS); returns the server and its port
    private list<auto> startServer(int port, CountingHandler handler, bool other_key = False) {
        HttpServer server(<HttpServerOptionInfo>{});
        server.setDefaultHandler("count", handler);
        server.waitForAsyncIo();
        int p = server.addListener(<HttpListenerOptionInfo>{
            "node": "127.0.0.1",
            "service": port,
            "cert": new SSLCertificate(other_key ? OtherCertPem : TestCertificates::CertPem),
            "key": new SSLPrivateKey(other_key ? OtherKeyPem : TestCertificates::KeyPem),
            "enable_h3": True,
        }).port;
        server.waitForAsyncIo();
        return (server, p);
    }

    #! returns a client on HTTP/3 to a server that then stops as a killed server process does, and the server's port
    private list<auto> connectAndStop() {
        CountingHandler first_handler();
        HttpServer first;
        int port;
        (first, port) = startServer(0, first_handler);
        on_exit if (first) {
            first.stop();
        }
        RestClient rc({
            "url": "https://127.0.0.1:" + port,
            "ssl_verify_cert": False,
            "timeout": HangGuard,
            "connect_timeout": LongConnectTimeout,
            "serialization": "json",
        });
        # the first response offers HTTP/3 (Alt-Svc), which the next request takes
        for (int i = 0; i < 2; ++i) {
            assertEq("GET", rc.get("/").body.method);
        }
        assertTrue(rc.isHttp3Active(), "the client uses HTTP/3");
        # the server stops only when neither side has anything to send (qore#7452): a packet of the client sent after it
        # stopped would reach the new server before the request, which would reset the connection before the request
        # was submitted, and a packet of the old server could arrive after the request
        assertTrue(call_function("dbg_quic_wait_all_idle", HangGuard), "nothing is in flight");
        call_function("dbg_quic_silent_server_close", True);
        on_exit call_function("dbg_quic_silent_server_close", False);
        first.stop();
        delete first;
        return (rc, port);
    }

    resetTest(string method) {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("a server is stopped as a killed one is only with dbg_quic_silent_server_close()");
        }
        RestClient rc;
        int port;
        (rc, port) = connectAndStop();
        CountingHandler handler();
        HttpServer second = startServer(port, handler)[0];
        on_exit second.stop();

        hash<auto> before = call_function("dbg_quic_stateless_reset_counts");
        # the request is sent on the old connection, which the new server does not know: it resets the connection
        if (method == "GET") {
            assertEq("GET", rc.get("/").body.method, "the new server answered the request");
            assertEq(1, handler.requests.getCount(), "the new server received the request once");
        } else {
            # a request that is not idempotent is not repeated: the old server may have processed it
            assertThrows("HTTP3-STATELESS-RESET", \rc.post(), ("/", "payload"));
            assertEq(0, handler.requests.getCount(), "the request was not repeated");
            # the next request takes a new connection
            hash<auto> rv = rc.post("/", "payload").body;
            assertEq("POST", rv.method, "the new server answered the next request");
            assertEq("payload", parse_json(rv.body), "the request body was sent");
            assertEq(1, handler.requests.getCount(), "the new server received the next request once");
        }
        hash<auto> after = call_function("dbg_quic_stateless_reset_counts");
        assertGt(before.sent, after.sent, "the new server sent a stateless reset");
        assertEq(before.received + 1, after.received, "the client took the reset");
    }

    otherKeyTest() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("a server is stopped as a killed one is only with dbg_quic_silent_server_close()");
        }
        RestClient rc;
        int port;
        (rc, port) = connectAndStop();
        CountingHandler handler();
        HttpServer second = startServer(port, handler, True)[0];
        on_exit second.stop();
        assertGe(1, call_function("dbg_quic_set_client_peer_response_timeout", ShortPeerResponseTimeout),
            "the peer response timeout of the old connection was shortened");

        hash<auto> before = call_function("dbg_quic_stateless_reset_counts");
        # the reset of the new server has another token: the client ends the connection after its peer response
        # timeout (qore#6930), and repeats the request on a new connection
        assertEq("GET", rc.get("/").body.method, "the new server answered the request");
        assertEq(1, handler.requests.getCount(), "the new server received the request once");
        hash<auto> after = call_function("dbg_quic_stateless_reset_counts");
        assertGt(before.sent, after.sent, "the new server sent a stateless reset");
        assertEq(before.received, after.received, "the client did not take a reset with another token");
    }
}
