%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires Mime
%requires Logger
%requires HttpServerUtil
%requires DataProvider
%requires ConnectionProvider
%requires RestSchemaValidator
%requires Swagger
%requires OpenApi3
%requires RestClient
%requires HttpServer

%requires json

%exec-class AbstractRestClientTest

#! Simple JSON echo handler
class JsonEchoHandler inherits AbstractHttpRequestHandler {
    hash<auto> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        hash<auto> resp_body;
        if (hdr.method == "HEAD") {
            return makeResponse(200, NOTHING, {"Content-Type": MimeTypeJson});
        }
        if (hdr.method == "OPTIONS") {
            return makeResponse(200, make_json({"allow": "GET, POST, PUT, PATCH, DELETE, HEAD, OPTIONS"}),
                {"Content-Type": MimeTypeJson, "Allow": "GET, POST, PUT, PATCH, DELETE, HEAD, OPTIONS"});
        }
        if (body) {
            auto parsed;
            if (body.typeCode() == NT_BINARY) {
                parsed = parse_json(body.toString());
            } else {
                parsed = parse_json(body);
            }
            resp_body = {
                "method": hdr.method,
                "path": hdr.path,
                "body": parsed,
            };
        } else {
            resp_body = {
                "method": hdr.method,
                "path": hdr.path,
            };
        }
        int status = hdr.method == "DELETE" ? 204 : 200;
        return makeResponse(status, make_json(resp_body), {"Content-Type": MimeTypeJson});
    }
}

class AbstractRestClientTest inherits QUnit::Test {
    private {
        HttpServer server;
        int port;
        RestClient rest;
    }

    constructor() : Test("AbstractRestClientTest", "1.0") {
        addTestCase("RestResponseInfo hashdecl", \testRestResponseInfo());
        addTestCase("AbstractRestClient conformance", \testAbstractRestClientConformance());
        addTestCase("copyWithUrl preserves the subclass", \testCopyWithUrlPreservesClass());
        addTestCase("restGet", \testRestGet());
        addTestCase("restHead", \testRestHead());
        addTestCase("restOptions", \testRestOptions());
        addTestCase("restPost", \testRestPost());
        addTestCase("restPut", \testRestPut());
        addTestCase("restPatch", \testRestPatch());
        addTestCase("restDel", \testRestDel());
        addTestCase("restDoRequest", \testRestDoRequest());
        addTestCase("serialization methods", \testSerializationMethods());
        addTestCase("header management", \testHeaderManagement());
        addTestCase("token management", \testTokenManagement());
        addTestCase("close method", \testClose());
        addTestCase("a header sent more than once", \testRepeatedHeader());

        set_return_value(main());
    }

    setUp() {
        Logger logger("test", LoggerLevel::getLevelInfo());
        hash<HttpServerOptionInfo> http_opts = <HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        };
        server = new HttpServer(http_opts);
        server.setHandler("/api", "/api", MimeTypeJson, new JsonEchoHandler());
        server.setDefaultHandler("/api", new JsonEchoHandler());
        port = server.addListener(<HttpListenerOptionInfo>{"service": 0}).port;

        rest = new RestClient({
            "url": sprintf("http://localhost:%d", port),
            "data": "json",
            "error_passthru": True,
        });
    }

    tearDown() {
        delete rest;
        delete server;
    }

    testRestResponseInfo() {
        hash<RestResponseInfo> info = <RestResponseInfo>{
            "status_code": 200,
            "headers": {"content-type": "application/json"},
            "body": {"key": "value"},
            "content_type": "application/json",
        };
        assertEq(200, info.status_code);
        assertEq("application/json", info.content_type);
        assertEq({"key": "value"}, info.body);
        assertEq({"content-type": "application/json"}, info.headers);
    }

    testAbstractRestClientConformance() {
        # RestClient should be an instance of AbstractRestClient
        AbstractRestClient arc = rest;
        assertEq(True, arc instanceof AbstractRestClient);
        assertEq(True, rest instanceof AbstractRestClient);
    }

    testRestGet() {
        hash<RestResponseInfo> resp = rest.restGet("/api/test");
        assertEq(200, resp.status_code);
        assertEq("GET", resp.body.method);
        assertRegex("api/test", resp.body.path);
        assertEq(True, resp.headers instanceof hash);
    }

    testRestHead() {
        hash<RestResponseInfo> resp = rest.restHead("/api/test");
        assertEq(200, resp.status_code);
        # HEAD responses have no body
        assertEq(True, !exists resp.body || !resp.body);
    }

    testRestOptions() {
        hash<RestResponseInfo> resp = rest.restOptions("/api/test");
        assertEq(200, resp.status_code);
        assertEq(True, exists resp.body);
    }

    testRestPost() {
        hash<auto> body = {"key": "value", "num": 42};
        hash<RestResponseInfo> resp = rest.restPost("/api/test", body);
        assertEq(200, resp.status_code);
        assertEq("POST", resp.body.method);
        assertEq(body, resp.body.body);
    }

    testRestPut() {
        hash<auto> body = {"update": True};
        hash<RestResponseInfo> resp = rest.restPut("/api/test", body);
        assertEq(200, resp.status_code);
        assertEq("PUT", resp.body.method);
        assertEq(body, resp.body.body);
    }

    testRestPatch() {
        hash<auto> body = {"patch": "data"};
        hash<RestResponseInfo> resp = rest.restPatch("/api/test", body);
        assertEq(200, resp.status_code);
        assertEq("PATCH", resp.body.method);
        assertEq(body, resp.body.body);
    }

    testRestDel() {
        hash<RestResponseInfo> resp = rest.restDel("/api/test", NOTHING);
        assertEq(204, resp.status_code);
    }

    testRestDoRequest() {
        hash<auto> body = {"generic": True};
        hash<RestResponseInfo> resp = rest.restDoRequest("POST", "/api/test", body);
        assertEq(200, resp.status_code);
        assertEq("POST", resp.body.method);
        assertEq(body, resp.body.body);
    }

    testSerializationMethods() {
        # Test getSerialization / setSerialization
        string orig = rest.getSerialization();
        rest.setSerialization("json");
        assertEq("json", rest.getSerialization());
        rest.setSerialization("auto");
        assertEq("auto", rest.getSerialization());
        rest.setSerialization(orig);

        # Test invalid serialization
        assertThrows("RESTCLIENT-ERROR", sub () { rest.setSerialization("invalid"); });
    }

    testHeaderManagement() {
        hash<auto> orig = rest.getDefaultHeaders();

        # Test addDefaultHeaders
        rest.addDefaultHeaders({"X-Test": "value"});
        assertEq("value", rest.getDefaultHeaders()."X-Test");

        # Test replaceDefaultHeaders
        rest.replaceDefaultHeaders({"X-New": "header"});
        assertEq("header", rest.getDefaultHeaders()."X-New");
        assertEq(True, !rest.getDefaultHeaders()."X-Test");

        # Restore
        rest.replaceDefaultHeaders(orig);
    }

    testTokenManagement() {
        rest.setToken("Bearer", "test-token-123");
        assertEq("test-token-123", rest.getToken());
        assertEq("Bearer", rest.getTokenType());

        # Verify token appears in default headers
        assertEq("Bearer test-token-123", rest.getDefaultHeaders().Authorization);
    }

    #! A server may send the same header more than once, and the response must still be readable
    /** Microsoft Dynamics answers some OData requests with two Content-Type headers.  The repeated header
        arrives as a list, and \c RestResponseInfo::content_type is a single string, so building the
        response raised a type error in place of returning it - every such response was unreadable.
    */
    testRepeatedHeader() {
        assertEq("application/json", RestClient::getSingleHeaderValue("application/json"));
        assertEq("application/json",
            RestClient::getSingleHeaderValue(("application/json", "application/json")),
            "a repeated header yields a single value");
        assertEq("application/json",
            RestClient::getSingleHeaderValue(("application/json", "text/plain")),
            "the first value wins where they differ");
        assertNothing(RestClient::getSingleHeaderValue(NOTHING));
        assertNothing(RestClient::getSingleHeaderValue(()));
        assertNothing(RestClient::getSingleHeaderValue(""));
    }

    testClose() {
        # Create a fresh client for this test
        RestClient client({
            "url": sprintf("http://localhost:%d", port),
            "data": "json",
            "error_passthru": True,
        });

        # Verify close() exists on AbstractRestClient interface
        AbstractRestClient arc = client;

        # Make a request to establish a connection
        hash<RestResponseInfo> resp = arc.restGet("/api/test");
        assertEq(200, resp.status_code);

        # close() should disconnect without error
        arc.close();

        # The client should be disconnected
        assertEq(False, client.isConnected());
    }
    testCopyWithUrlPreservesClass() {
        # copyWithUrl() used to end in `new RestClient(opts, True)`, so copying any subclass
        # silently produced a generic client and discarded whatever the subclass adds.  For
        # AwsRestClient, whose signRequest() applies AWS SigV4 signing, that meant the copy's
        # requests went out unsigned.  The copy must be an instance of the object's own class.
        TestSubclassRestClient parent({"url": "http://localhost:8099"}, True);
        object child = parent.copyWithUrl("http://localhost:8098");

        assertTrue(child instanceof TestSubclassRestClient, "the copy keeps the subclass");
        assertEq("subclass", cast<TestSubclassRestClient>(child).subclassMarker(),
            "the subclass's own behaviour survives the copy");
        assertEq("http://localhost:8098", cast<RestClient::RestClient>(child).getUrl());
    }

}

#! A RestClient subclass used to prove that copyWithUrl() preserves the runtime class
/** Stands in for any client that adds behaviour to the base -- AwsRestClient's SigV4 request
    signing, for example -- all of which was silently discarded when a copy was constructed as a
    plain RestClient.
*/
class TestSubclassRestClient inherits RestClient::RestClient {
    constructor(*hash<auto> opts, *softbool do_not_connect) : RestClient(opts, do_not_connect) {
    }

    string subclassMarker() {
        return "subclass";
    }
}
