#! Answers each request with its method and body, and counts the requests
class CountingHandler inherits AbstractHttpRequestHandler {
    public {
        Counter requests();
    }

    hash<HttpResponseInfo> handleRequest(HttpListenerInterface listener, Socket s, hash<auto> cx, hash<auto> hdr,
            *data body) {
        requests.inc();
        return makeResponse(200, make_json({"method": hdr.method, "body": body ? string(body) : NOTHING}),
            {"Content-Type": "application/json"});
    }
}

#! Answers each request with its method, and holds a request for "/slow" until it is released
class HoldingHandler inherits CountingHandler {
    public {
        #! a request for "/slow" arrived
        Queue reached();
        #! releases the requests for "/slow"
        Queue release();
    }

    hash<HttpResponseInfo> handleRequest(HttpListenerInterface listener, Socket s, hash<auto> cx, hash<auto> hdr,
            *data body) {
        if (hdr.path == "slow") {
            reached.push(True);
            release.get(HangGuard);
            return makeResponse(200, make_json({"method": hdr.method}), {"Content-Type": "application/json"});
        }
        return CountingHandler::handleRequest(listener, s, cx, hdr, body);
    }
}

class RestClientH3ServerRestartTest inherits QUnit::Test {
    constructor() : QUnit::Test("RestClientH3ServerRestartTest", "1.0") {
        addTestCase("a GET is repeated on a new connection after the server restarted", \restartTest(), "GET");
        addTestCase("a POST raises the error after the server restarted, and the next request takes a new connection",
            \restartTest(), "POST");
        addTestCase("the response to another request does not end the wait for a request that the server did not "
            "receive", \otherResponseTest());
        set_return_value(main());
    }

    #! starts an HTTPS server with HTTP/3 on the given port (0: assigned by the OS); returns the server and its port
    private list<auto> startServer(int port, AbstractHttpRequestHandler handler, bool other_key = False) {
        HttpServer server(<HttpServerOptionInfo>{});
        server.setDefaultHandler("count", handler);
        server.waitForAsyncIo();
        int p = server.addListener(<HttpListenerOptionInfo>{
            "node": "127.0.0.1",
            "service": port,
            "cert": new SSLCertificate(other_key ? TestCertificates::CertPem : CertPem),
            "key": new SSLPrivateKey(other_key ? TestCertificates::KeyPem : KeyPem),
            "enable_h3": True,
        }).port;
        server.waitForAsyncIo();
        return (server, p);
    }

    restartTest(string method) {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("a server is stopped as a killed one is only with dbg_quic_silent_server_close()");
        }
        CountingHandler first_handler();
        HttpServer first;
        int port;
        (first, port) = startServer(0, first_handler);
        on_exit if (first) {
            first.stop();
        }
        RestClient rc({
            "url": "https://127.0.0.1:" + port,
            "ssl_verify_cert": False,
            "timeout": HangGuard,
            "connect_timeout": HangGuard,
            "serialization": "json",
        });
        # the first response offers HTTP/3 (Alt-Svc), which the next request takes
        for (int i = 0; i < 2; ++i) {
            assertEq("GET", rc.get("/").body.method);
        }
        assertTrue(rc.isHttp3Active(), "the client uses HTTP/3");

        # the server stops as a killed server process does, and a new one serves the port
        call_function("dbg_quic_silent_server_close", True);
        {
            on_exit call_function("dbg_quic_silent_server_close", False);
            first.stop();
            delete first;
        }
        CountingHandler handler();
        # the new server has another key: it cannot reset the old connection (see above)
        HttpServer second = startServer(port, handler, True)[0];
        on_exit second.stop();
        assertGe(1, call_function("dbg_quic_set_client_peer_response_timeout", PeerResponseTimeout),
            "the peer response timeout of the old connection was shortened");

        # the request is sent on the old connection, which the new server does not know: once the server has not
        # acknowledged it for the peer response timeout, the connection is closed; an idempotent request is repeated
        # on a new one
        if (method == "GET") {
            assertEq("GET", rc.get("/").body.method, "the new server answered the request");
            assertEq(1, handler.requests.getCount(), "the new server received the request once");
            return;
        }
        # a request that is not idempotent is not repeated: the old server may have processed it
        assertThrows("HTTP3-PEER-UNRESPONSIVE", \rc.post(), ("/", "payload"));
        assertEq(0, handler.requests.getCount(), "the request was not repeated");
        # the next request takes a new connection
        hash<auto> rv = rc.post("/", "payload").body;
        assertEq("POST", rv.method, "the new server answered the next request");
        assertEq("payload", parse_json(rv.body), "the request body was sent");
        assertEq(1, handler.requests.getCount(), "the new server received the next request once");
    }

    #! qore#7452: a request that the server did not receive ends the connection although another response arrives
    otherResponseTest() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("the client's datagrams are dropped only with QORE_QUIC_TEST_DROP_CLIENT_DATAGRAMS");
        }
        HoldingHandler handler();
        HttpServer server;
        int port;
        (server, port) = startServer(0, handler);
        on_exit server.stop();
        # the requests held by the handler are released however the test ends
        on_exit handler.release.push(True);
        RestClient rc({
            "url": "https://127.0.0.1:" + port,
            "ssl_verify_cert": False,
            "timeout": HangGuard,
            "connect_timeout": HangGuard,
            "serialization": "json",
        });
        # the first response offers HTTP/3 (Alt-Svc), which the next request takes
        for (int i = 0; i < 2; ++i) {
            assertEq("GET", rc.get("/").body.method);
        }
        assertTrue(rc.isHttp3Active(), "the client uses HTTP/3");

        # a request that the server holds: its response comes later, on the same connection
        Queue held_done();
        background sub () {
            try {
                rc.get("/slow");
            } catch (hash<ExceptionInfo> ex) {
                # the connection can be closed before the response arrives (see below); the held request is only the
                # source of the response's packets
            }
            held_done.push(True);
        }();
        assertTrue(handler.reached.get(HangGuard), "the server received the held request");
        # neither side has anything to send until the next request: the next datagram of the client is its request
        assertTrue(call_function("dbg_quic_wait_all_idle", HangGuard), "nothing is in flight");

        assertGe(1, call_function("dbg_quic_set_client_peer_response_timeout", PeerResponseTimeout),
            "the peer response timeout of the connection was shortened");
        # from now on the server receives nothing from the client, as a server whose connection state is gone
        int requests = handler.requests.getCount();
        int dropped = call_function("dbg_quic_dropped_client_datagrams");
        setenv("QORE_QUIC_TEST_DROP_CLIENT_DATAGRAMS", "*");
        on_exit unsetenv("QORE_QUIC_TEST_DROP_CLIENT_DATAGRAMS");
        Queue result();
        background sub () {
            try {
                rc.post("/", "payload");
                result.push("no error");
            } catch (hash<ExceptionInfo> ex) {
                result.push(ex.err);
            }
        }();
        # the request was submitted: its first datagram was dropped
        assertTrue(call_function("dbg_quic_wait_dropped_client_datagrams", dropped + 1, HangGuard),
            "the request was sent");
        # the response to the held request arrives after the request was submitted, and again and again, as the
        # server sends it again while the client's acknowledgments are dropped; it does not show that the server
        # received the request, which is not idempotent: it raises the error instead of waiting for its timeout
        handler.release.push(True);
        assertEq("HTTP3-PEER-UNRESPONSIVE", result.get(HangGuard), "the request ended with the connection");
        unsetenv("QORE_QUIC_TEST_DROP_CLIENT_DATAGRAMS");
        held_done.get(HangGuard);
        assertEq(requests, handler.requests.getCount(), "the server did not receive the request");
    }
}
