#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/Mime.qm
%requires ../../../../qlib/HttpServerUtil.qm
%requires ../../../../qlib/HttpServer.qm
%requires ../../../../qlib/HttpServerAsyncIo
%requires ../../../../qlib/ConnectionProvider
%requires ../../../../qlib/DataProvider
%requires ../../../../qlib/RestClientIo.qm
%requires ../../../../qlib/GcpAuth.qm
%requires ../../../../qlib/GeminiBodyShape.qm
%requires ../../../../qlib/VertexAiRestClient.qm
%requires ../../../../qlib/VertexAiDataProvider

%try-module json
%define NoJson
%endtry

%exec-class VertexAiDataProviderTest

class FakeVertexHandler inherits AbstractHttpRequestHandler {
    public {
        string last_path = "";
        string last_authorization = "";
        *hash<auto> last_body;
    }
    hash handleRequest(hash cx, hash hdr, *data body) {
        last_path = cx.raw_path;
        last_authorization = hdr."authorization" ?? "";
        string body_str = body ? (body.typeCode() == NT_BINARY
            ? body.toString("UTF-8") : body) : "";
%ifndef NoJson
        try { last_body = parse_json(body_str); } catch () {}
%endif
        # GCP token endpoint (used by GcpAuth) — accept with/without trailing /
        if (last_path =~ /\/token\/?$/) {
            return makeResponse({"Content-Type": MimeTypeJson}, 200, make_json({
                "access_token": "fake-vertex-token",
                "expires_in": 3600,
                "token_type": "Bearer",
            }));
        }
        if (last_path =~ /:generateContent$/) {
            return makeResponse({"Content-Type": MimeTypeJson}, 200, make_json({
                "candidates": (
                    {"content": {"role": "model",
                                 "parts": ({"text": "Hello from Vertex DP"},)},
                     "finishReason": "STOP"},
                ),
                "usageMetadata": {
                    "promptTokenCount": 5, "candidatesTokenCount": 4,
                    "totalTokenCount": 9,
                },
                "modelVersion": "gemini-2.0-flash-001",
                "responseId": "fake-id",
            }));
        }
        if (last_path =~ /:predict$/) {
            return makeResponse({"Content-Type": MimeTypeJson}, 200, make_json({
                "predictions": (
                    {"embeddings": {"values": (0.1, 0.2, 0.3)}},
                ),
            }));
        }
        return makeResponse(404, "unknown vertex path: " + last_path);
    }
}

public class VertexAiDataProviderTest inherits QUnit::Test {
    public {
        const MyOpts = Opts + {
            "conn": "c,connection=s",
        };

        const OptionColumn = 22;
    }

    private {
        HttpServer http;
        int port;
        FakeVertexHandler handler;
        string sa_path;
        *string conn_name;
    }

    constructor() : Test("VertexAiDataProvider Test", "1.0", \ARGV, MyOpts) {
        conn_name = m_options.conn ?? ENV.VERTEX_AI_CONNECTION;

        addTestCase("factory + provider info",            \factoryTest());
        addTestCase("app registered with logo + group",   \appTest());
        addTestCase("generate-content + embed actions registered",
            \actionsTest());
        addTestCase("GenerateContent action end-to-end", \chatTest());
        addTestCase("Embed action end-to-end",           \embedTest());
        addTestCase("URL routes through project + region + publisher + model",
            \pathTest());
        addTestCase("Bearer token from GcpAuth flows through to outbound calls",
            \authTest());
        addTestCase("child providers discoverable",       \childrenTest());

        try { setupServer(); }
        catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("setup error: %s\n", get_exception_string(ex));
            }
        }

        # Live test requires a real Google Vertex AI connection.
        # Cost: 1 token-bounded gemini-2.5-flash-lite request (free tier
        # eligible).
        if (conn_name) {
            addTestCase("live: ping + generate-content (gemini-2.5-flash-lite)",
                \liveVertexAiTest());
        }
        set_return_value(main());
    }

    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-c,--connection=ARG",
            "set the Google Vertex AI connection name; without it (and "
            "without the VERTEX_AI_CONNECTION env var) the live test is "
            "skipped",
            OptionColumn);
    }

    #! Exercises Vertex AI's live generateContent endpoint.
    /** Verifies the actual wire format against Google Vertex AI's production
        endpoint — including GcpAuth Bearer-token issuance, the
        project/region/publisher/model URL routing, and the generateContent
        response shape.  Cost: 1 token-bounded gemini-2.5-flash-lite request
        (free tier eligible).
    */
    private liveVertexAiTest() {
        AbstractConnection conn = get_connection(conn_name);
        hash<auto> ping = conn.ping(True);
        assertTrue(ping.ok, sprintf("Vertex AI connection ping failed: %s",
            ping.info ?? "no info"));

        AbstractDataProvider prov = conn.getDataProvider();
        AbstractDataProvider gc = prov.getChildProvider("generate-content");
        auto resp = gc.doRequest({
            "model": "gemini-2.5-flash-lite",
            "contents": ({"role": "user", "parts": ({"text": "Say hi in one word."},)},),
            "generationConfig": {"maxOutputTokens": 16, "temperature": 0.0},
        });
        assertTrue(resp.candidates[0].content.parts[0].text.val(),
            "Vertex AI returned assistant text");
        assertTrue(resp.usageMetadata.totalTokenCount > 0,
            "Vertex AI reported a positive total-token count");
    }

    static checkJson(Test test) {
%ifdef NoJson
        test.testSkip("no json module");
%endif
    }

    private setupServer() {
        Logger logger("test", LoggerLevel::getLevelInfo());
        http = new HttpServer(<HttpServerOptionInfo>{"logger": logger});
        handler = new FakeVertexHandler();
        http.setDefaultHandler("vertex", handler);
        port = http.addListener(<HttpListenerOptionInfo>{"service": 0}).port;

        sa_path = tmp_location() + "/vertex_dp_sa_" + get_random_string(8) + ".json";
        File f();
        f.open2(sa_path, O_CREAT | O_WRONLY | O_TRUNC);
        f.write(make_json({
            "type": "service_account",
            "project_id": "fake-project",
            "private_key_id": "key-id",
            "private_key": TestPrivateKey,
            "client_email": "fake@fake-project.iam.gserviceaccount.com",
            "token_uri": "http://localhost:" + port + "/token",
        }));
        f.close();
    }

    globalTearDown() {
        if (sa_path && is_file(sa_path)) {
            unlink(sa_path);
        }
        delete http;
    }

    private factoryTest() {
        AbstractDataProviderFactory f = DataProvider::getFactoryEx("vertex-ai");
        assertEq("vertex-ai", f.getName());
        hash<DataProviderInfo> pi = f.getProviderInfo();
        assertTrue(pi.supports_children);
    }

    private appTest() {
        hash<DataProviderAppInfo> app =
            DataProviderActionCatalog::getApp(VertexAiDataProvider::AppName);
        assertEq("Google Vertex AI", app.display_name);
        assertEq("vertex-ai", app.scheme);
        assertEq("vertex-ai-logo.svg", app.logo_file_name);
        assertTrue(app.logo.val(), "logo content was loaded from the SVG file");
        assertTrue(inlist(DataProvider::AppGroup::AiLlm, app.groups));
    }

    private actionsTest() {
        list<hash<DataProviderActionInfo>> actions =
            DataProviderActionCatalog::getActionsEx(VertexAiDataProvider::AppName);
        list<string> names = map $1.action, actions;
        assertTrue(inlist("generate-content", names));
        assertTrue(inlist("embed", names));

        hash<DataProviderActionInfo> gc = DataProviderActionCatalog::getAppActionEx(
            VertexAiDataProvider::AppName, "generate-content");
        assertEq(DPAT_API, gc.action_code);
        assertEq("/generate-content", gc.path);
        assertTrue(gc.options.model.required);
        assertTrue(gc.options.contents.required);
    }

    private chatTest() {
        VertexAiDataProviderTest::checkJson(self);
        if (!http) {
            testSkip("no fake server");
        }
        GcpAuth::clearTokenCache();
        VertexAiGenerateContentDataProvider p(buildOptions());
        auto resp = p.doRequest({
            "model": "gemini-2.0-flash",
            "contents": (
                {"role": "user", "parts": ({"text": "ping"},)},
            ),
        });
        assertEq("Hello from Vertex DP", resp.candidates[0].content.parts[0].text);
        assertEq("STOP", resp.candidates[0].finishReason);
        assertEq(9, resp.usageMetadata.totalTokenCount);
        assertEq("user", handler.last_body.contents[0].role);
    }

    private embedTest() {
        VertexAiDataProviderTest::checkJson(self);
        if (!http) {
            testSkip("no fake server");
        }
        GcpAuth::clearTokenCache();
        VertexAiEmbedDataProvider p(buildOptions());
        auto resp = p.doRequest({
            "model": "text-embedding-005",
            "instances": ({"content": "embed me"},),
        });
        assertEq((0.1, 0.2, 0.3), resp.predictions[0].embeddings.values);
        assertEq("embed me", handler.last_body.instances[0].content);
    }

    private pathTest() {
        VertexAiDataProviderTest::checkJson(self);
        if (!http) {
            testSkip("no fake server");
        }
        GcpAuth::clearTokenCache();
        VertexAiGenerateContentDataProvider p(buildOptions());
        p.doRequest({
            "model": "gemini-1.5-pro-002",
            "contents": ({"role": "user", "parts": ({"text": "x"},)},),
        });
        assertTrue(handler.last_path
            =~ /\/v1\/projects\/fake-project\/locations\/us-central1\/publishers\/google\/models\/gemini-1\.5-pro-002:generateContent$/,
            sprintf("expected full Vertex path, got %y", handler.last_path));
    }

    private authTest() {
        VertexAiDataProviderTest::checkJson(self);
        if (!http) {
            testSkip("no fake server");
        }
        GcpAuth::clearTokenCache();
        VertexAiGenerateContentDataProvider p(buildOptions());
        p.doRequest({
            "model": "gemini-2.0-flash",
            "contents": ({"role": "user", "parts": ({"text": "x"},)},),
        });
        assertEq("Bearer fake-vertex-token", handler.last_authorization);
    }

    private childrenTest() {
        VertexAiDataProviderTest::checkJson(self);
        if (!http) {
            testSkip("no fake server");
        }
        VertexAiDataProvider::VertexAiDataProvider root(buildOptions());
        list<string> names = root.getChildProviderNames();
        assertTrue(inlist("generate-content", names));
        assertTrue(inlist("embed", names));
    }

    private hash<auto> buildOptions() {
        return {
            "gcp_project_id": "fake-project",
            "gcp_region": "us-central1",
            "gcp_sa_json_path": sa_path,
            "restclient": new RestClientIo::RestClientIo({
                "url": "http://localhost:" + port,
                "data": "json",
            }),
        };
    }

