#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
#
# Copyright 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires HttpServerUtil
%requires HttpServer
%requires RestSchemaValidator
%requires RestHandler

%exec-class RestHandlerAcceptRetryTest

#! The SSE body that the hook sends in place of the error response
const SseBody = "event: error\ndata: {\"err\":\"X\"}\n\n";

#! The Content-Type that the hook sets with the SSE body
const SseContentType = "text/event-stream;charset=utf-8";

#! Returns an error response that no serializer can send as text/event-stream
class AcceptRetryRestClass inherits AbstractRestClass {
    string name() {
        return "items";
    }

    hash<HttpHandlerResponseInfo> get(hash<auto> cx, *hash<auto> ah) {
        return RestHandler::makeResponse(403, {"err": "X"});
    }
}

#! What the response serialization hook does to the response
enum HookAction {
    #! leaves the response as it is
    None = 0,
    #! sets an SSE body and Content-Type
    Sse = 1,
    #! sets an SSE body and Content-Type and changes the status code
    SseCode = 2,
    #! sets the SSE Content-Type only
    HeaderOnly = 3,
    #! sets another body that cannot be serialized either
    StillUnserializable = 4,
}

#! A REST handler whose response serialization hook does what the test asks
class AcceptRetryRestHandler inherits RestHandler {
    public {
        #! what the hook does
        HookAction action;
        #! the number of times that the hook was called
        int hook_calls = 0;
    }

    constructor(HookAction action, *AbstractRestSchemaValidator validator)
            : RestHandler(NOTHING, validator ?? new NullRestSchemaValidator()) {
        self.action = action;
        addClass(new AcceptRetryRestClass());
    }

    responseSerializationRetry(hash<auto> cx, *hash<auto> aih, reference<hash<HttpHandlerResponseInfo>> rv) {
        ++hook_calls;
        switch (action) {
            case HookAction::Sse:
                rv.hdr = {"Content-Type": SseContentType};
                rv.body = SseBody;
                break;
            case HookAction::SseCode:
                rv.code = 503;
                rv.hdr = {"Content-Type": SseContentType};
                rv.body = SseBody;
                break;
            case HookAction::HeaderOnly:
                rv.hdr = {"Content-Type": SseContentType};
                break;
            case HookAction::StillUnserializable:
                rv.body = {"err": "Y"};
                break;
            case HookAction::None:
                break;
        }
    }
}

#! A validator whose response serialization fails with an error other than ACCEPT-ERROR
class FailingResponseValidator inherits NullRestSchemaValidator {
    private hash<HttpResponseInfo> processResponseImpl(string method, string path, int code, auto response_body,
            *hash<auto> headers, *softlist<string> content_types) {
        throw "TEST-RESPONSE-ERROR", "response validation failed";
    }
}

#! A validator whose first response serialization fails with ACCEPT-ERROR and whose retry fails with another error
class FailingRetryValidator inherits NullRestSchemaValidator {
    private {
        #! the number of responses processed
        int calls = 0;
    }

    private hash<HttpResponseInfo> processResponseImpl(string method, string path, int code, auto response_body,
            *hash<auto> headers, *softlist<string> content_types) {
        if (!calls++) {
            throw "ACCEPT-ERROR", "cannot serialize response";
        }
        throw "TEST-RETRY-ERROR", "retry validation failed";
    }
}

#! dummy HttpListenerInterface object for direct handleRequest() calls
class AcceptRetryListener inherits HttpListenerInterface {
    addUserThreadContext(hash<auto> uctx) {}
    auto removeUserThreadContext(*string k) {}
    log(string fmt, ...) {}
    logError(string fmt, ...) {}
}

#! A response that RestHandler::responseSerializationRetry() makes serializable is sent (qore#7250)
/** The handler is called directly, without a server
*/
class RestHandlerAcceptRetryTest inherits QUnit::Test {
    constructor() : Test("RestHandlerAcceptRetryTest", "1.0", \ARGV) {
        addTestCase("a response that the hook makes serializable is sent", \hookSerializable());
        addTestCase("a response that the hook makes serializable is sent with its new code", \hookSerializableCode());
        addTestCase("a response that the hook leaves unchanged gives 406", \hookUnchanged());
        addTestCase("a hook that changes only the headers gives 406", \hookHeaderOnly());
        addTestCase("a failed retry gives 406", \hookRetryFails());
        addTestCase("a retry that fails with another error gives 406", \hookRetryOtherError());
        addTestCase("an acceptable response does not call the hook", \acceptable());
        addTestCase("a serialization error other than ACCEPT-ERROR is raised", \otherError());
        set_return_value(main());
    }

    hookSerializable() {
        AcceptRetryRestHandler handler(HookAction::Sse);
        hash<auto> rv = handle(handler, "text/event-stream");
        assertEq(1, handler.hook_calls);
        assertEq(403, rv.code);
        assertEq(SseBody, rv.body);
        assertEq(SseContentType, rv.hdr."Content-Type");
    }

    hookSerializableCode() {
        AcceptRetryRestHandler handler(HookAction::SseCode);
        hash<auto> rv = handle(handler, "text/event-stream");
        assertEq(1, handler.hook_calls);
        assertEq(503, rv.code);
        assertEq(SseBody, rv.body);
        assertEq(SseContentType, rv.hdr."Content-Type");
    }

    hookUnchanged() {
        AcceptRetryRestHandler handler(HookAction::None);
        hash<auto> rv = handle(handler, "text/event-stream");
        assertEq(1, handler.hook_calls);
        assertEq(406, rv.code);
        assertRegex("cannot serialize response", rv.body);
    }

    hookHeaderOnly() {
        AcceptRetryRestHandler handler(HookAction::HeaderOnly);
        hash<auto> rv = handle(handler, "text/event-stream");
        assertEq(1, handler.hook_calls);
        assertEq(406, rv.code);
        assertRegex("cannot serialize response", rv.body);
    }

    hookRetryFails() {
        AcceptRetryRestHandler handler(HookAction::StillUnserializable);
        hash<auto> rv = handle(handler, "text/event-stream");
        assertEq(1, handler.hook_calls);
        assertEq(406, rv.code);
        # the body describes the failure of the retry
        assertRegex("cannot serialize response", rv.body);
        assertRegex("\"Y\"", rv.body);
        assertNRegex("\"X\"", rv.body);
    }

    hookRetryOtherError() {
        AcceptRetryRestHandler handler(HookAction::Sse, new FailingRetryValidator());
        hash<auto> rv = handle(handler, "text/event-stream");
        assertEq(1, handler.hook_calls);
        assertEq(406, rv.code);
        assertEq("retry validation failed", rv.body);
    }

    acceptable() {
        AcceptRetryRestHandler handler(HookAction::Sse);
        hash<auto> rv = handle(handler, "application/json");
        assertEq(0, handler.hook_calls);
        assertEq(403, rv.code);
        assertEq("{\"err\":\"X\"}", rv.body);
        assertEq("application/json", rv.hdr."Content-Type");
    }

    otherError() {
        AcceptRetryRestHandler handler(HookAction::Sse, new FailingResponseValidator());
        try {
            handle(handler, "text/event-stream");
            fail("no exception was raised");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("TEST-RESPONSE-ERROR", ex.err);
            # the original error response is added to the description
            assertRegex("^response validation failed \\.\\.\\. Original response: code: 403", ex.desc);
        }
        assertEq(0, handler.hook_calls);
    }

    private hash<auto> handle(RestHandler handler, string accept) {
        AcceptRetryListener listener();
        Socket s();
        string path = "items";
        hash<auto> hdr = {
            "method": "GET",
            "path": path,
            "accept": accept,
            "http_version": "1.1",
            "host": "localhost",
        };
        hash<auto> cx = {
            "url": parse_url("http://localhost/" + path),
            "hdr": hdr,
            "id": 1,
        };
        return handler.handleRequest(listener, s, cx, hdr);
    }
}
