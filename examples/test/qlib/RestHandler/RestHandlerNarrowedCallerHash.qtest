%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires HttpServerUtil
%requires RestSchemaValidator
%requires RestHandler

%exec-class RestHandlerNarrowedCallerHashTest

#! Returns REST responses whose header values all have the same type
class NarrowedHeaderRestClass inherits AbstractRestClass {
    string name() {
        return "items";
    }

    #! a serialized response with an integer header
    hash<HttpHandlerResponseInfo> get(hash<auto> cx, *hash<auto> ah) {
        return RestHandler::makeResponse(200, {"a": 1}, {"X-Total-Count": 42});
    }

    #! a raw response with an integer header and no Content-Type
    hash<HttpHandlerResponseInfo> getRaw(hash<auto> cx, *hash<auto> ah) {
        return <HttpHandlerResponseInfo>{
            "code": 200,
            "body": "raw",
            "hdr": {"X-Total-Count": 42},
            "raw_response": True,
        };
    }
}

#! A stream handler that adds response headers whose values all have the same type
class NarrowedHeaderStreamHandler inherits AbstractRestStreamRequestHandler {
    private {
        #! the handler's response headers
        hash<auto> resp_hdr;
        #! the headers that the stream adds
        hash<auto> stream_hdr;
    }

    constructor(hash<auto> cx, *hash<auto> ah, hash<auto> resp_hdr, hash<auto> stream_hdr)
            : AbstractRestStreamRequestHandler(cx, ah) {
        self.resp_hdr = resp_hdr;
        self.stream_hdr = stream_hdr;
    }

    private hash<auto> getResponseHeaderMessageImpl() {
        return {
            "code": 200,
            "body": "streamed",
            "hdr": resp_hdr,
        };
    }

    private nothing recvImpl(hash<auto> v) {
        # the end of the request body
        if (v.hasKey("hdr")) {
            rhdr = stream_hdr;
        }
    }

    private auto sendImpl() {
    }
}

#! Streams responses with integer and string headers
class NarrowedHeaderStreamRestClass inherits AbstractRestClass {
    string name() {
        return "stream";
    }

    #! the handler's headers are integers and the stream adds string headers
    AbstractRestStreamRequestHandler streamGetIntString(hash<auto> cx, *hash<auto> ah) {
        return new NarrowedHeaderStreamHandler(cx, ah, RestHandlerNarrowedCallerHashTest::mk({"X-Count": 1}),
            RestHandlerNarrowedCallerHashTest::mk({"X-Stream": "yes"}));
    }

    #! the handler's headers are strings and the stream adds integer headers
    AbstractRestStreamRequestHandler streamGetStringInt(hash<auto> cx, *hash<auto> ah) {
        return new NarrowedHeaderStreamHandler(cx, ah, RestHandlerNarrowedCallerHashTest::mk({"X-Stream": "yes"}),
            RestHandlerNarrowedCallerHashTest::mk({"X-Count": 1}));
    }

    #! the handler's headers are boolean and the stream adds string headers
    AbstractRestStreamRequestHandler streamGetBoolString(hash<auto> cx, *hash<auto> ah) {
        return new NarrowedHeaderStreamHandler(cx, ah, RestHandlerNarrowedCallerHashTest::mk({"X-Debug": True}),
            RestHandlerNarrowedCallerHashTest::mk({"X-Stream": "yes"}));
    }

    #! returns the context hash that the REST handler built
    hash<HttpHandlerResponseInfo> getContext(hash<auto> cx, *hash<auto> ah) {
        return RestHandler::makeResponse(200, {"user": cx.user, "method": cx.hdr.method, "path": cx.url.path,
            "arg": ah.arg});
    }
}

class NarrowedHeaderRestHandler inherits RestHandler {
    constructor() {
        addClass(new NarrowedHeaderRestClass());
        addClass(new NarrowedHeaderStreamRestClass());
    }
}

#! dummy HttpListenerInterface object for direct handleRequest() calls
class NarrowedHeaderListener inherits HttpListenerInterface {
    addUserThreadContext(hash<auto> uctx) {}
    auto removeUserThreadContext(*string k) {}
    log(string fmt, ...) {}
    logError(string fmt, ...) {}
}

#! Response headers whose values all have the same type are accepted by the REST server and validators
/** A hash literal such as \c {"X-Total-Count": 42} has the narrowed runtime type \c hash<string, int>; adding the
    \c Content-Type string header to it raised RUNTIME-TYPE-ERROR, which the REST handler returned as a 406 error.
    The handler is called directly, without a server
*/
class RestHandlerNarrowedCallerHashTest inherits QUnit::Test {
    constructor() : Test("RestHandlerNarrowedCallerHashTest", "1.0", \ARGV) {
        addTestCase("NullRestSchemaValidator::processResponse() adds Content-Type", \validatorResponse());
        addTestCase("RestHandler serializes a response with integer headers", \handlerResponse());
        addTestCase("RestHandler adds Content-Type to a raw response", \handlerRawResponse());
        addTestCase("RestHandler stream adds string headers to integer headers", \streamIntString());
        addTestCase("RestHandler stream adds integer headers to string headers", \streamStringInt());
        addTestCase("RestHandler stream adds string headers to boolean headers", \streamBoolString());
        addTestCase("handleExternalRequest() accepts a context hash with string values",
            \externalRequestStringContext());
        addTestCase("handleExternalRequest() accepts a context hash with boolean values",
            \externalRequestBoolContext());
        set_return_value(main());
    }

    #! Returns its argument, so that a literal keeps its narrowed runtime type
    static hash<auto> mk(hash<auto> h) {
        return h;
    }

    validatorResponse() {
        assertEq("hash<string, int>", RestHandlerNarrowedCallerHashTest::mk({"X-Total-Count": 42}).fullType());
        NullRestSchemaValidator validator();
        hash<HttpResponseInfo> rv = validator.processResponse("GET", "/items", 200, {"a": 1},
            {"X-Total-Count": 42}, "application/json");
        assertEq(200, rv.code);
        assertEq({"X-Total-Count": 42, "Content-Type": "application/json"}, rv.hdr);
        assertEq("{\"a\":1}", rv.body);
    }

    handlerResponse() {
        hash<auto> rv = handle("items");
        assertEq(200, rv.code);
        assertEq(42, rv.hdr."X-Total-Count");
        assertEq("application/json", rv.hdr."Content-Type");
        assertEq("{\"a\":1}", rv.body);
    }

    handlerRawResponse() {
        hash<auto> rv = handle("items?action=raw");
        assertEq(200, rv.code);
        assertEq({"X-Total-Count": 42, "Content-Type": "application/octet-stream"}, rv.hdr);
        assertEq("raw", rv.body);
    }

    streamIntString() {
        hash<auto> rv = handle("stream?action=intString");
        assertEq(200, rv.code);
        # the body is serialized as JSON
        assertEq("\"streamed\"", rv.body);
        assertEq({"X-Count": 1, "X-Stream": "yes", "Content-Type": "application/json"},
            rv.hdr{"X-Count", "X-Stream", "Content-Type"});
    }

    streamStringInt() {
        hash<auto> rv = handle("stream?action=stringInt");
        assertEq(200, rv.code);
        # the body is serialized as JSON
        assertEq("\"streamed\"", rv.body);
        assertEq({"X-Stream": "yes", "X-Count": 1, "Content-Type": "application/json"},
            rv.hdr{"X-Stream", "X-Count", "Content-Type"});
    }

    streamBoolString() {
        hash<auto> rv = handle("stream?action=boolString");
        assertEq(200, rv.code);
        # the body is serialized as JSON
        assertEq("\"streamed\"", rv.body);
        assertEq({"X-Debug": True, "X-Stream": "yes", "Content-Type": "application/json"},
            rv.hdr{"X-Debug", "X-Stream", "Content-Type"});
    }

    externalRequestStringContext() {
        assertEq("hash<string, string>", RestHandlerNarrowedCallerHashTest::mk({"user": "admin"}).fullType());
        NarrowedHeaderRestHandler handler();
        hash<auto> cx = {"user": "admin"};
        assertEq({"user": "admin", "method": "GET", "path": "stream?action=context&arg=1", "arg": "1"},
            handler.handleExternalRequest("GET", "stream?action=context&arg=1", NOTHING, cx));
        # the caller's hash is not changed
        assertEq({"user": "admin"}, cx);
    }

    externalRequestBoolContext() {
        NarrowedHeaderRestHandler handler();
        assertEq({"user": NOTHING, "method": "GET", "path": "stream?action=context", "arg": NOTHING},
            handler.handleExternalRequest("GET", "stream?action=context", NOTHING,
                RestHandlerNarrowedCallerHashTest::mk({"internal": True})));
    }

    private hash<auto> handle(string path) {
        NarrowedHeaderRestHandler handler();
        NarrowedHeaderListener listener();
        Socket s();
        hash<auto> hdr = {
            "method": "GET",
            "path": path,
            "accept": "application/json",
            "http_version": "1.1",
            "host": "localhost",
        };
        hash<auto> cx = {
            "url": parse_url("http://localhost/" + path),
            "hdr": hdr,
            "id": 1,
        };
        return handler.handleRequest(listener, s, cx, hdr);
    }
}
