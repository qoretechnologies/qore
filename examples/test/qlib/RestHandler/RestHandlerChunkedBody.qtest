    Tests for chunked HTTP/1.1 request bodies sent to REST methods without a stream handler
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires Logger
%requires HttpServerUtil
%requires HttpServer
%requires RestHandler
%requires HttpClientIo
%requires json

%exec-class RestHandlerChunkedBodyTest

#! returns the body, the arguments, and the trailers of a request
class EchoRestClass inherits AbstractRestClass {
    string name() {
        return "echo";
    }

    hash<HttpHandlerResponseInfo> post(hash<auto> cx, *hash<auto> ah) {
        return RestHandler::makeResponse(200, {
            "body": cx.body,
            "args": ah,
            "orig": cx."orig-request-body",
            "trailers": cx.hasKey("trailers") ? cx.trailers : NOTHING,
        });
    }
}

#! a request handler with methods whose names RestHandler uses internally, with other signatures
class OtherHttpHandler inherits AbstractHttpRequestHandler {
    #! returns the request path without the handler's URL prefix
    string getRequestPath(string hpath) {
        return "custom:" + hpath;
    }

    static bool isRequestBodyError(int code) {
        return code == 400;
    }
}

#! a REST handler that also inherits another handler, like the REST handlers of Qorus services
/** RestHandler's own helpers must not clash with the methods of the other base class
*/
class SubclassRestHandler inherits OtherHttpHandler, RestHandler {
    #! requests are handled by RestHandler
    hash<HttpResponseInfo> handleRequest(HttpListenerInterface listener, Socket s, hash<auto> cx, hash<auto> hdr,
            *data body) {
        return RestHandler::handleRequest(listener, s, cx, hdr, body);
    }
}

public class RestHandlerChunkedBodyTest inherits QUnit::Test {
    private {
        HttpServer server;
        SubclassRestHandler rest;
        string url;
    }

    constructor() : Test("RestHandlerChunkedBodyTest", "1.0") {
        addTestCase("chunked request bodies are deserialized", \testDeserialized());
        addTestCase("invalid chunked request bodies", \testInvalid());
        addTestCase("subclass methods", \testSubclass());
        server = new HttpServer(<HttpServerOptionInfo>{
            "logger": new Logger("server", LoggerLevel::getLevelError()),
        });
        rest = new SubclassRestHandler();
        rest.addClass(new EchoRestClass());
        server.setHandler("rest", "^echo", NOTHING, rest);
        url = sprintf("http://127.0.0.1:%d", server.addListener(<HttpListenerOptionInfo>{
            "node": "127.0.0.1",
            "service": 0,
        }).port);
        on_exit server.stop();
        set_return_value(main());
    }

    testDeserialized() {
        # a hash body is reflected in the arguments; query arguments take precedence
        hash<auto> resp = send("/echo?b=query", ("{\"a\": 1, ", "\"b\": \"body\"}"), {"x-sum": "1"});
        assertEq(200, resp.status_code);
        hash<auto> rv = parse_json(resp.body);
        assertEq({"a": 1, "b": "body"}, rv.body);
        assertEq({"a": 1, "b": "query"}, rv.args);
        assertEq("{\"a\": 1, \"b\": \"body\"}", rv.orig);
        assertEq({"x-sum": "1"}, rv.trailers);
        # a body that is not a hash
        resp = send("/echo", ("[1, ", "2]"));
        assertEq(200, resp.status_code);
        rv = parse_json(resp.body);
        assertEq((1, 2), rv.body);
        assertNothing(rv.trailers);
    }

    testInvalid() {
        hash<auto> resp = send("/echo", ("{\"a\": ", "}"));
        assertEq(400, resp.status_code);
        assertRegex("DESERIALIZATION-ERROR", resp.body);
    }

    testSubclass() {
        # the requests of the other test cases are handled by a subclass with methods named like RestHandler's
        # internal helpers; the subclass's methods are its own
        assertEq("custom:x", rest.getRequestPath("x"));
        assertTrue(SubclassRestHandler::isRequestBodyError(400));
        hash<auto> resp = send("/echo", ("{\"a\": ", "1}"));
        assertEq(200, resp.status_code);
        assertEq({"a": 1}, parse_json(resp.body).body);
    }

    #! sends a chunked JSON request body and returns the response status code and body
    private hash<auto> send(string path, list<string> parts, *hash<string, string> trailers) {
        HttpClientConnectionManager mgr(<HttpClientConnectionManagerOptions>{
            "protocol": "h1",
            "accept_encoding": "",
        });
        on_exit mgr.closeAll();
        HttpClientStreamHandle sh = mgr.acquireStream(url);
        sh.startStreaming("POST", path, {"Content-Type": MimeTypeJson, "Accept": MimeTypeJson}, True);
        if (trailers) {
            sh.setTrailers(trailers);
        }
        foreach string part in (parts) {
            sh.sendData(part, $# == (parts.size() - 1));
        }
        string body;
        date deadline = now_us() + 30s;
        while (True) {
            if (now_us() > deadline) {
                fail("timed out reading the response");
            }
            auto chunk = sh.readData(5s);
            if (!exists chunk) {
                continue;
            }
            if (chunk.typeCode() == NT_HASH) {
                if (chunk.error) {
                    fail(sprintf("stream error: %y", chunk));
                }
                if (chunk.end_stream) {
                    break;
                }
                continue;
            }
            body += chunk.typeCode() == NT_BINARY ? chunk.toString() : chunk;
        }
        return {"status_code": sh.getResponse().status_code, "body": body};
    }
}
