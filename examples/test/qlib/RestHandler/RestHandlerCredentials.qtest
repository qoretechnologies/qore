    The REST classes get the request without the server's objects and the credentials of the request, in their
    request methods and their stream handlers; a REST handler that authenticates the requests of its own endpoint
    opts in to receive its own credentials (qore#6843)
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires Logger
%requires HttpServerUtil
%requires HttpServer
%requires RestHandler
%requires json

%exec-class RestHandlerCredentialsTest

#! the REST class of a tenant, in a sandboxed Program: each method reports the credentials and the server objects
#! that it got
const Tenant = "
%requires RestHandler
%requires DataStreamRequestHandler
%requires json

class Report {
    static string attempt(code c) {
        try {
            auto v = c();
            return 'OK ' + (v.typeCode() == NT_HASH ? 'hash' : v.type());
        } catch (hash<ExceptionInfo> ex) {
            return ex.err;
        }
    }

    static hash<auto> facts(hash<auto> cx) {
        return {
            'credentials': (map $1, ('authorization', 'cookie', 'proxy-authorization'), cx.hdr.hasKey($1)),
            'server objects': (map $1, ('auth', 'socket', 'socket-info', 'uctx', 'logger'), cx.hasKey($1)),
            'user': cx.user,
            'peer-info keys': sort(keys cx.'peer-info'),
        };
    }
}

class TenantStream inherits RestHandler::AbstractRestStreamRequestHandler {
    private:internal {
        hash<auto> facts;
    }

    constructor(hash<auto> cx, *hash<auto> ah) : RestHandler::AbstractRestStreamRequestHandler(cx, ah) {
        facts = Report::facts(cx);
    }

    private nothing recvImpl(hash<auto> v) {
    }

    private auto sendImpl() {
    }

    private hash<HttpServer::HttpResponseInfo> getResponseHeaderMessageImpl() {
        return <HttpServer::HttpResponseInfo>{
            'code': 200,
            'hdr': {'Content-Type': 'application/json'},
            'body': make_json(facts),
        };
    }
}

class TenantClass inherits RestHandler::AbstractRestClass {
    private:internal {
        string n;
    }

    constructor(string n) {
        self.n = n;
    }

    string name() {
        return n;
    }

    hash<HttpServer::HttpHandlerResponseInfo> get(hash<auto> cx, *hash<auto> ah) {
        return RestHandler::RestHandler::makeResponse(200, Report::facts(cx));
    }

    hash<HttpServer::HttpHandlerResponseInfo> put(hash<auto> cx, *hash<auto> ah) {
        return RestHandler::RestHandler::makeResponse(200, Report::facts(cx));
    }

    # what the request's socket gives the tenant's code
    hash<HttpServer::HttpHandlerResponseInfo> getSock(hash<auto> cx, *hash<auto> ah) {
        auto s = cx.socketobject;
        if (!s) {
            return RestHandler::RestHandler::makeResponse(200, {'type': 'none'});
        }
        hash<auto> rv = {'type': s.className()};
        switch (ah.op) {
            case 'recv': rv.recv = Report::attempt(auto sub () { return s.recv(-1, 0); }); break;
            case 'read-header': rv.'read-header' = Report::attempt(auto sub () {
                hash<auto> h = s.readHTTPHeader(1s);
                return h.authorization ?? h.headers.authorization ?? 'no authorization';
            }); break;
            case 'shutdown': rv.shutdown = Report::attempt(auto sub () { s.shutdown(); return 'done'; }); break;
            case 'close': rv.close = Report::attempt(auto sub () { s.close(); return 'done'; }); break;
        }
        return RestHandler::RestHandler::makeResponse(200, rv);
    }

    RestHandler::AbstractRestStreamRequestHandler streamPost(hash<auto> cx, *hash<auto> ah) {
        return new TenantStream(cx, ah);
    }
}

class TenantDs inherits DataStreamRequestHandler::AbstractDataStreamRequestHandler {
    constructor(hash<auto> cx, *hash<auto> ah) : DataStreamRequestHandler::AbstractDataStreamRequestHandler(cx, ah) {
    }

    private nothing recvDataImpl(auto data) {
    }

    private auto sendDataImpl() {
    }
}

class TenantDsClass inherits RestHandler::AbstractRestClass {
    string name() {
        return 'platformds';
    }

    RestHandler::AbstractRestStreamRequestHandler streamPost(hash<auto> cx, *hash<auto> ah) {
        return new TenantDs(cx, ah);
    }
}

RestHandler::AbstractRestClass sub make_ds() {
    return new TenantDsClass();
}

RestHandler::AbstractRestClass sub make(string name) {
    return new TenantClass(name);
}
";

#! accepts every request with Basic authentication for the user it names, as a platform's authenticator does
#! a REST class that trusted code declares
class TrustedClass inherits AbstractRestClass {
    private:internal {
        string n;
    }

    constructor(string n = "platformtrusted") {
        self.n = n;
    }

    string name() {
        return n;
    }

    hash<HttpHandlerResponseInfo> getSock(hash<auto> cx, *hash<auto> ah) {
        return RestHandler::makeResponse(200, {"type": cx.socketobject ? cx.socketobject.className() : "none"});
    }
}

class TestAuthenticator inherits AbstractAuthenticator {
    bool requiresAuthentication() {
        return True;
    }

    authenticate(reference<hash<auto>> cx, string user, string pass = "") {
        if (user != "test" || pass != "test") {
            throw "AUTHENTICATION-ERROR", "invalid user or password";
        }
    }
}

#! a REST handler that authenticates the requests of its own endpoint itself, and opts in to get its credentials
class OwnAuthRestHandler inherits RestHandler {
    constructor() : RestHandler() {
        setRequestCredentialHeaders("authorization");
    }
}

#! sandboxed code: a REST handler that tries to opt in, a handler that tries the raw access, and a class that is
#! never instantiated with a static method that tries it
const TenantHandlers = "
%requires RestHandler

class TenantRestHandler inherits RestHandler::RestHandler {
    constructor() : RestHandler::RestHandler() {
    }

    string optIn() {
        try {
            setRequestCredentialHeaders('authorization');
            return 'OK';
        } catch (hash<ExceptionInfo> ex) {
            return ex.err + ': ' + ex.desc;
        }
    }

    string contextKeys() {
        try {
            setRestContextKeys('auth');
            return 'OK';
        } catch (hash<ExceptionInfo> ex) {
            return ex.err + ': ' + ex.desc;
        }
    }

    string raw() {
        try {
            return sprintf('%y', call_object_method(self, 'getRawRequest'));
        } catch (hash<ExceptionInfo> ex) {
            return ex.err;
        }
    }
}

class Thief inherits RestHandler::RestHandler {
    static string steal(RestHandler::RestHandler h) {
        try {
            return sprintf('%y', call_object_method(h, 'getRawRequest'));
        } catch (hash<ExceptionInfo> ex) {
            return ex.err;
        }
    }
}

hash<auto> sub run(RestHandler::RestHandler trusted) {
    TenantRestHandler h();
    return {
        'opt-in': h.optIn(),
        'context keys': h.contextKeys(),
        'raw': h.raw(),
        'thief': Thief::steal(trusted),
    };
}
";

public class RestHandlerCredentialsTest inherits QUnit::Test {
    private {
        Program tenant;
        HttpServer server;
        string url;
    }

    constructor() : Test("RestHandlerCredentialsTest", "1.0") {
        addTestCase("the platform's authentication consumed the credentials", \testPlatformAuth());
        addTestCase("a handler that authenticates its own endpoint opts in", \testOwnAuth());
        addTestCase("sandboxed code cannot opt in or get the raw request", \testSandboxedRefused());
        addTestCase("the request's socket", \testSocket());
        addTestCase("SandboxManager::isFromSandboxedProgram()", \testPredicate());
        addTestCase("a data stream handler that sandboxed code declares", \testDataStream());

        tenant = new Program(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES);
        tenant.setSandboxManager(new SandboxManager());
        tenant.parse(Tenant, "tenant");

        server = new HttpServer(<HttpServerOptionInfo>{
            "logger": new Logger("server", LoggerLevel::getLevelError()),
        });
        RestHandler platform(new TestAuthenticator());
        platform.addClass(tenant.callFunction("make", "platform"));
        platform.addClass(new TrustedClass());
        platform.addClass(tenant.callFunction("make_ds"));
        server.setHandler("platform", "^platform", NOTHING, platform);
        # a REST handler that hosts no code of a sandboxed Program
        RestHandler solo(new TestAuthenticator());
        solo.addClass(new TrustedClass("solotrusted"));
        server.setHandler("solo", "^solotrusted", NOTHING, solo);
        OwnAuthRestHandler own();
        own.addClass(tenant.callFunction("make", "own"));
        server.setHandler("own", "^own", NOTHING, own);
        url = sprintf("http://127.0.0.1:%d", server.addListener(<HttpListenerOptionInfo>{
            "node": "127.0.0.1",
            "service": 0,
        }).port);
        on_exit server.stop();
        set_return_value(main());
    }

    testPlatformAuth() {
        hash<auto> expected = {
            "credentials": (),
            "server objects": (),
            "user": "test",
            "peer-info keys": ("address", "address_desc", "family", "familystr", "port"),
        };
        foreach string method in (("GET", "PUT", "POST")) {
            assertEq(expected, request(method, "/platform"), method);
        }
    }

    testOwnAuth() {
        hash<auto> expected = {
            # only the credential addressed to the handler, which it opts in to receive
            "credentials": ("authorization",),
            "server objects": (),
            "user": NOTHING,
            "peer-info keys": ("address", "address_desc", "family", "familystr", "port"),
        };
        foreach string method in (("GET", "PUT", "POST")) {
            assertEq(expected, request(method, "/own"), method);
        }
    }

    testSocket() {
        hash<auto> h = {
            "Accept": "application/json",
            "Authorization": "Basic dGVzdDp0ZXN0",
        };
        # a REST class that trusted code declared gets the socket of the connection of an HTTP/1.1 request from a
        # handler that hosts no code of a sandboxed Program
        {
            HTTPClient c({"url": url});
            on_exit c.disconnect();
            assertEq({"type": "Socket"}, parse_json(c.send(NOTHING, "GET", "/solotrusted?action=sock", h).body));
        }
        # and a socket of its own request from a handler that also hosts the code of a sandboxed Program (qore#7305)
        {
            HTTPClient c({"url": url});
            on_exit c.disconnect();
            assertEq({"type": "Http1HandlerSocket"}, parse_json(c.send(NOTHING, "GET", "/platformtrusted?action=sock",
                h).body));
        }
        # a REST class that sandboxed code declared never gets the socket of the connection: it cannot read a request
        # pipelined after its own, nor close the connection
        foreach string op in (("read-header", "close", "shutdown")) {
            Socket s();
            s.connect(url.substr(7));
            on_exit s.close();
            string req = sprintf("GET /platform?action=sock&op=%s HTTP/1.1\r\nHost: x\r\nAccept: application/json\r\n"
                "Authorization: Basic dGVzdDp0ZXN0\r\n\r\n", op);
            # the next request, pipelined, with other credentials
            string next = "GET /platform HTTP/1.1\r\nHost: x\r\nAccept: application/json\r\n"
                "Authorization: Basic dGVzdDp0ZXN0\r\nX-Next: 1\r\n\r\n";
            s.send(req + next);
            hash<auto> resp = s.readHTTPHeader(10s);
            assertEq(200, resp.status_code, op);
            string body = s.recv(resp."content-length".toInt(), 10s);
            # it gets a socket of its own request (qore#7305), which refuses to act on the connection
            assertEq({"type": "Http1HandlerSocket", op: "HTTP-HANDLER-SOCKET-ERROR"}, parse_json(body), op);
            # the pipelined request is served
            resp = s.readHTTPHeader(10s);
            assertEq(200, resp.status_code, op + ": the next request");
            assertEq("test", parse_json(s.recv(resp."content-length".toInt(), 10s)).user, op + ": the next request");
        }
    }

    testDataStream() {
        HTTPClient c({"url": url});
        on_exit c.disconnect();
        hash<auto> info;
        try {
            c.send("x", "POST", "/platformds", {
                "Accept": "application/x-yaml",
                "Content-Type": "application/x-yaml;datastream=1",
                "Authorization": "Basic dGVzdDp0ZXN0",
            }, False, \info);
            assertTrue(False, "the request without DataStream headers is refused");
        } catch (hash<ExceptionInfo> ex) {
            # the handler gets a socket of its own request (qore#7305), so it is created and serves the request with
            # the DataStream protocol, which refuses a request without its headers, without naming the request's
            # credentials
            string body = ex.arg.body ?? "";
            assertNRegex("DATASTREAM-ERROR", body);
            assertNRegex("dGVzdDp0ZXN0", body);
        }
    }

    testPredicate() {
        Program p(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES);
        p.setSandboxManager(new SandboxManager());
        p.importClass("TrustedClass");
        p.parse("%requires RestHandler
class TenantSub inherits TrustedClass {}
class TenantOwn {}
object sub trusted_by_tenant() { return new TrustedClass(); }
object sub sub_by_tenant() { return new TenantSub(); }
object sub own() { return new TenantOwn(); }", "predicate");
        assertFalse(SandboxManager::isFromSandboxedProgram(new TrustedClass()), "trusted");
        # the class is imported into the sandboxed Program, whose class it is then
        assertTrue(SandboxManager::isFromSandboxedProgram(p.callFunction("trusted_by_tenant")),
            "trusted, imported into the tenant's Program and created there");
        assertTrue(SandboxManager::isFromSandboxedProgram(p.callFunction("sub_by_tenant")), "a tenant's subclass of a trusted class");
        assertTrue(SandboxManager::isFromSandboxedProgram(p.callFunction("own")), "a tenant's class");
    }

    testSandboxedRefused() {
        Program p(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES);
        p.setSandboxManager(new SandboxManager());
        p.parse(TenantHandlers, "tenant-handlers");
        hash<auto> rv = p.callFunction("run", new RestHandler());
        # the refusals do not name the request's header fields or values
        assertEq("REQUEST-ERROR: restricted code cannot set the credentials that a handler's code gets", rv."opt-in");
        assertEq("REST-ERROR: restricted code cannot set the keys of the request context of the REST classes",
            rv."context keys");
        # a private method of a class that trusted code declared
        assertEq("METHOD-IS-PRIVATE", rv.raw);
        assertEq("METHOD-IS-PRIVATE", rv.thief);
    }

    #! sends a request with credentials and returns what the tenant's method got
    private hash<auto> request(string method, string path) {
        HTTPClient client({"url": url});
        on_exit client.disconnect();
        hash<auto> info;
        hash<auto> resp;
        try {
            resp = client.send(method == "GET" ? NOTHING : "{}", method, path, {
                "Content-Type": "application/json",
                "Accept": "application/json",
                "Authorization": "Basic dGVzdDp0ZXN0",
                "Proxy-Authorization": "Basic dGVzdDp0ZXN0",
                "Cookie": "session=secret",
            }, False, \info);
        } catch (hash<ExceptionInfo> ex) {
            return {"error": sprintf("%s: %s: %y", ex.err, ex.desc, ex.arg.body)};
        }
        return parse_json(resp.body);
    }
}
