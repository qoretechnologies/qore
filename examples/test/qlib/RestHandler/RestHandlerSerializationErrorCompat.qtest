#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
#
# Copyright 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires HttpServerUtil
%requires HttpServer
%requires RestSchemaValidator
%requires RestHandler

%exec-class RestHandlerSerializationErrorCompatTest

#! The SSE body that the retry hook sends in place of the error response
const SseBody = "event: error\ndata: {\"err\":\"X\"}\n\n";

#! The Content-Type that the retry hook sets with the SSE body
const SseContentType = "text/event-stream;charset=utf-8";

#! Returns an error response that no serializer can send as text/event-stream
class CompatRestClass inherits AbstractRestClass {
    string name() {
        return "items";
    }

    hash<HttpHandlerResponseInfo> get(hash<auto> cx, *hash<auto> ah) {
        return RestHandler::makeResponse(403, {"err": "X"});
    }
}

#! A REST handler that overrides responseSerializationError() with its signature in Qore 2.2
class Qore22RestHandler inherits RestHandler {
    public {
        #! the arguments of each call of responseSerializationError()
        list<hash<auto>> calls = ();
        #! the hooks in the order that they were called
        list<string> order = ();
    }

    constructor(*AbstractRestSchemaValidator validator)
            : RestHandler(NOTHING, validator ?? new NullRestSchemaValidator()) {
        addClass(new CompatRestClass());
    }

    responseSerializationError(hash<auto> cx, *hash<auto> aih, hash<auto> rv) {
        calls += {"aih": aih, "rv": rv};
        order += "error";
        # a change to the copy has no effect
        rv.body = SseBody;
        rv.hdr = {"Content-Type": SseContentType};
    }
}

#! A REST handler that overrides both hooks
class BothHooksRestHandler inherits Qore22RestHandler {
    public {
        #! the response body that responseSerializationRetry() received
        auto retry_body;
    }

    responseSerializationRetry(hash<auto> cx, *hash<auto> aih, reference<hash<HttpHandlerResponseInfo>> rv) {
        order += "retry";
        retry_body = rv.body;
        rv.hdr = {"Content-Type": SseContentType};
        rv.body = SseBody;
    }
}

#! A validator whose response serialization fails with an error other than ACCEPT-ERROR
class FailingResponseValidator inherits NullRestSchemaValidator {
    private hash<HttpResponseInfo> processResponseImpl(string method, string path, int code, auto response_body,
            *hash<auto> headers, *softlist<string> content_types) {
        throw "TEST-RESPONSE-ERROR", "response validation failed";
    }
}

#! dummy HttpListenerInterface object for direct handleRequest() calls
class CompatListener inherits HttpListenerInterface {
    addUserThreadContext(hash<auto> uctx) {}
    auto removeUserThreadContext(*string k) {}
    log(string fmt, ...) {}
    logError(string fmt, ...) {}
}

#! An override of RestHandler::responseSerializationError() with its Qore 2.2 signature is called (qore#7250)
/** The handler is called directly, without a server
*/
class RestHandlerSerializationErrorCompatTest inherits QUnit::Test {
    constructor() : Test("RestHandlerSerializationErrorCompatTest", "1.0", \ARGV) {
        addTestCase("a Qore 2.2 override is called with a copy of the response", \qore22Override());
        addTestCase("a Qore 2.2 override is called before the retry hook", \bothHooks());
        addTestCase("an acceptable response does not call the Qore 2.2 override", \acceptable());
        addTestCase("an error other than ACCEPT-ERROR does not call the Qore 2.2 override", \otherError());
        set_return_value(main());
    }

    qore22Override() {
        Qore22RestHandler handler();
        hash<auto> rv = handle(handler, "text/event-stream");
        assertEq(1, handler.calls.size());
        assertEq({"text/event-stream": True}, handler.calls[0].aih);
        assertEq(403, handler.calls[0].rv.code);
        assertEq({"err": "X"}, handler.calls[0].rv.body);
        # its change to the copy of the response is not sent: the answer is 406, as in Qore 2.2
        assertEq(406, rv.code);
        assertRegex("cannot serialize response", rv.body);
    }

    bothHooks() {
        BothHooksRestHandler handler();
        hash<auto> rv = handle(handler, "text/event-stream");
        assertEq(("error", "retry"), handler.order);
        # the retry hook gets the original response, not the copy that responseSerializationError() changed
        assertEq({"err": "X"}, handler.retry_body);
        assertEq({"err": "X"}, handler.calls[0].rv.body);
        assertEq(403, rv.code);
        assertEq(SseBody, rv.body);
        assertEq(SseContentType, rv.hdr."Content-Type");
    }

    acceptable() {
        Qore22RestHandler handler();
        hash<auto> rv = handle(handler, "application/json");
        assertEq(0, handler.calls.size());
        assertEq(403, rv.code);
        assertEq("{\"err\":\"X\"}", rv.body);
    }

    otherError() {
        Qore22RestHandler handler(new FailingResponseValidator());
        try {
            handle(handler, "text/event-stream");
            fail("no exception was raised");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("TEST-RESPONSE-ERROR", ex.err);
        }
        assertEq(0, handler.calls.size());
    }

    private hash<auto> handle(RestHandler handler, string accept) {
        CompatListener listener();
        Socket s();
        string path = "items";
        hash<auto> hdr = {
            "method": "GET",
            "path": path,
            "accept": accept,
            "http_version": "1.1",
            "host": "localhost",
        };
        hash<auto> cx = {
            "url": parse_url("http://localhost/" + path),
            "hdr": hdr,
            "id": 1,
        };
        return handler.handleRequest(listener, s, cx, hdr);
    }
}
