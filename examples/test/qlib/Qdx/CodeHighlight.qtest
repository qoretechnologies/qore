# tests the highlighting of Qore code fragments in HTML generated by doxygen (issue #5573)

%modern
%exec-class CodeHighlightTests

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Qdx
%requires FsUtil
%requires Util
%requires QUnit

public class CodeHighlightTests inherits QUnit::Test {
    public {
        const FS = QoreCodeFragmentHighlighter::FragmentStart;
        const FE = QoreCodeFragmentHighlighter::FragmentEnd;
    }

    constructor() : QUnit::Test("Qdx code highlighting", "1.0", \ARGV) {
        addTestCase("capture classes", \testGetClass());
        addTestCase("comments and directives", \testCommentsAndDirectives());
        addTestCase("types and hashdecls", \testTypes());
        addTestCase("regular expressions", \testRegex());
        addTestCase("literals", \testLiterals());
        addTestCase("expressions without a semicolon", \testExpression());
        addTestCase("links", \testLinks());
        addTestCase("tooltips", \testTooltips());
        addTestCase("multi-line ranges", \testMultiLine());
        addTestCase("HTML outside fragments", \testOutside());
        addTestCase("fragments left unchanged", \testUnchanged());
        addTestCase("open fragments", \testOpenFragments());
        addTestCase("post-processing iterator", \testIterator());
        addTestCase("qdx --post", \testQdxPost());
        set_return_value(main());
    }

    #! returns a doxygen code fragment with the given line HTML
    static string fragment(list<string> lines, string extra = "") {
        return FS + (foldl $1 + "\n" + $2, (map "<div class=\"line\">" + $1 + "</div>", lines)) + "\n" + extra + FE;
    }

    #! returns the highlighted HTML of a fragment with the given lines
    static string highlight(list<string> lines) {
        QoreCodeFragmentHighlighter h();
        return h.process(fragment(lines));
    }

    testGetClass() {
        assertEq("comment", QoreCodeFragmentHighlighter::getClass("comment"));
        assertEq("comment", QoreCodeFragmentHighlighter::getClass("comment.documentation"));
        assertEq("keyword", QoreCodeFragmentHighlighter::getClass("keyword"));
        assertEq("keyword", QoreCodeFragmentHighlighter::getClass("keyword.operator"));
        assertEq("keyword", QoreCodeFragmentHighlighter::getClass("keyword.type"));
        assertEq("keywordflow", QoreCodeFragmentHighlighter::getClass("keyword.conditional"));
        assertEq("keywordflow", QoreCodeFragmentHighlighter::getClass("keyword.repeat"));
        assertEq("keywordflow", QoreCodeFragmentHighlighter::getClass("keyword.return"));
        assertEq("keywordflow", QoreCodeFragmentHighlighter::getClass("keyword.exception"));
        assertEq("preprocessor", QoreCodeFragmentHighlighter::getClass("keyword.directive"));
        assertEq("keywordtype", QoreCodeFragmentHighlighter::getClass("type.builtin"));
        assertEq("", QoreCodeFragmentHighlighter::getClass("type"));
        assertEq("stringliteral", QoreCodeFragmentHighlighter::getClass("string.regexp"));
        assertEq("charliteral", QoreCodeFragmentHighlighter::getClass("number.date"));
        assertEq("charliteral", QoreCodeFragmentHighlighter::getClass("character"));
        assertEq("keyword", QoreCodeFragmentHighlighter::getClass("constant.builtin"));
        assertEq("keyword", QoreCodeFragmentHighlighter::getClass("variable.builtin"));
        assertEq("", QoreCodeFragmentHighlighter::getClass("constant"));
        assertEq("", QoreCodeFragmentHighlighter::getClass("function.method.call"));
        assertEq("", QoreCodeFragmentHighlighter::getClass("unknown"));
        assertEq("", QoreCodeFragmentHighlighter::getClass(""));
    }

    testCommentsAndDirectives() {
        # doxygen's Python lexer highlighted the directive as text
        assertEq(fragment((
            "<span class=\"preprocessor\">%modern</span>",
            "<span class=\"preprocessor\">%requires Util</span>",
            "<span class=\"comment\"># a comment</span>",
            "<span class=\"keywordtype\">int</span> i = <span class=\"charliteral\">1</span>; "
                "<span class=\"comment\">/* block */</span>",
        )), highlight((
            "%modern",
            "%requires Util",
            "<span class=\"comment\"># a comment</span>",
            "int i = 1; /* block */",
        )));
    }

    testTypes() {
        assertEq(fragment((
            "<span class=\"keyword\">hashdecl</span> MyHash {",
            "    <span class=\"keywordtype\">*string</span> name;",
            "    <span class=\"keywordtype\">hash</span>&lt;<span class=\"keywordtype\">string</span>, "
                "<span class=\"keywordtype\">auto</span>&gt; info;",
            "}",
            "<span class=\"keyword\">class</span> Foo <span class=\"keyword\">inherits</span> Bar {",
            "    <span class=\"keyword\">private</span> { <span class=\"keywordtype\">softint</span> i; }",
            "}",
        )), highlight((
            "hashdecl MyHash {",
            "    *string name;",
            "    hash&lt;string, auto&gt; info;",
            "}",
            "<span class=\"keyword\">class</span> Foo inherits Bar {",
            "    <span class=\"keyword\">private</span> { softint i; }",
            "}",
        )));
    }

    testRegex() {
        assertEq(fragment((
            "<span class=\"keywordflow\">if</span> (str =~ <span class=\"stringliteral\">/^a+$/i</span>) {",
            "    str =~ <span class=\"stringliteral\">s/a/b/g</span>;",
            "    <span class=\"keywordtype\">*string</span> x = (str =~ <span class=\"stringliteral\">x/(\\w+)/</span>)"
                "[<span class=\"charliteral\">0</span>];",
            "    printf(<span class=\"stringliteral\">&quot;%s\\n&quot;</span>, <span class=\"keyword\">$1</span>);",
            "}",
        )), highlight((
            "<span class=\"keywordflow\">if</span> (str =~ /^a+$/i) {",
            "    str =~ s/a/b/g;",
            "    *string x = (str =~ x/(\\w+)/)[0];",
            "    printf(<span class=\"stringliteral\">&quot;%s\\n&quot;</span>, $1);",
            "}",
        )));
    }

    testLiterals() {
        assertEq(replace(fragment((
            "<span class=\"keywordtype\">date</span> d = <span class=\"charliteral\">2024-01-31T10:20:30</span> + "
                "<span class=\"charliteral\">5ms</span>;",
            "<span class=\"keywordtype\">bool</span> b = <span class=\"keyword\">True</span>; x = "
                "<span class=\"keyword\">NOTHING</span>; y = <span class=\"charliteral\">c&#39;a&#39;</span>;",
        )), "&#39;", "'"), highlight((
            "date d = 2024-01-31T10:20:30 + 5ms;",
            "bool b = True; x = NOTHING; y = c&#39;a&#39;;",
        )));
    }

    testExpression() {
        # a single expression without ";", as often shown in documentation, is highlighted
        assertEq(fragment(("<span class=\"keyword\">True</span>",)), highlight(("True",)));
        assertEq(fragment(("<span class=\"keyword\">elements</span> list",)), highlight(("elements list",)));
        assertEq(fragment(("x = <span class=\"charliteral\">1</span>",)), highlight(("x = 1",)));
    }

    testLinks() {
        # links are kept with their text; highlighting inside a link is in the link
        string link1 = "<a class=\"code hl_class\" href=\"class_qore_1_1_socket.html\">Socket</a>";
        string link2 = "<a class=\"code hl_function\" href=\"group__f.html#ga1\">printf</a>";
        string link3 = "<a class=\"code hl_function\" href=\"group__t.html#ga2\">string</a>";
        # a type name called as a function is highlighted as a type
        string link3_highlighted = "<a class=\"code hl_function\" href=\"group__t.html#ga2\">"
            "<span class=\"keywordtype\">string</span></a>";
        assertEq(fragment((
            link1 + " sock = <span class=\"keyword\">new</span> " + link1 + "();",
            link2 + "(<span class=\"stringliteral\">&quot;%y&quot;</span>, " + link3_highlighted + "(sock));",
        )), highlight((
            link1 + " sock = <span class=\"keyword\">new</span> " + link1 + "();",
            link2 + "(<span class=\"stringliteral\">&quot;%y&quot;</span>, " + link3 + "(sock));",
        )));

        # a link over text with several highlights; a link in a comment
        string link4 = "<a class=\"code\" href=\"x.html\">list&lt;int&gt;</a>";
        string link5 = "<a class=\"code\" href=\"y.html\">Mutex</a>";
        assertEq(fragment((
            "<a class=\"code\" href=\"x.html\"><span class=\"keywordtype\">list</span>&lt;"
                "<span class=\"keywordtype\">int</span>&gt;</a> l; <span class=\"comment\"># see </span>"
                "<a class=\"code\" href=\"y.html\"><span class=\"comment\">Mutex</span></a>",
        )), highlight((
            link4 + " l; <span class=\"comment\"># see " + link5 + "</span>",
        )));

        # an anchor without text is kept
        assertEq(fragment(("<a id=\"l1\"></a><span class=\"keywordtype\">int</span> i;",)),
            highlight(("<a id=\"l1\"></a>int i;",)));
    }

    testTooltips() {
        # doxygen adds the tooltips of links after the lines
        string tooltip = "<div class=\"ttc\" id=\"a1\"><div class=\"ttname\"><a href=\"f.html\">Qore::f</a></div>"
            "<div class=\"ttdeci\">string f()</div></div>\n";
        string link = "<a class=\"code hl_function\" href=\"f.html\">f</a>";
        QoreCodeFragmentHighlighter h();
        assertEq(fragment(("<span class=\"keywordtype\">string</span> s = " + link + "();",), tooltip),
            h.process(fragment(("string s = " + link + "();",), tooltip)));
    }

    testMultiLine() {
        # a range over several lines is highlighted in each line
        assertEq(replace(fragment((
            "<span class=\"comment\">/* line 1</span>",
            "<span class=\"comment\">   line 2 */</span>",
            "x = <span class=\"stringliteral\">&quot;a&quot;</span>;",
            "<span class=\"comment\"></span>",
        )), "\n<div class=\"line\"><span class=\"comment\"></span></div>", "\n<div class=\"line\"></div>"),
        highlight((
            "/* line 1",
            "   line 2 */",
            "x = &quot;a&quot;;",
            "",
        )));
    }

    testOutside() {
        # HTML before, between and after fragments is unchanged, including fragments on one line in a table
        string html = "<td>" + fragment(("a++",)) + " <p>text &amp; <b>bold</b></p> " + fragment(("--a",))
            + "</td>\n<p>after</p>\n";
        string expected = "<td>" + fragment(("a++",)) + " <p>text &amp; <b>bold</b></p> " + fragment(("--a",))
            + "</td>\n<p>after</p>\n";
        QoreCodeFragmentHighlighter h();
        assertEq(expected, h.process(html));
        assertEq("<p>no code</p>", h.process("<p>no code</p>"));
        assertEq("", h.process(""));
    }

    testUnchanged() {
        QoreCodeFragmentHighlighter h();
        # code in other languages that cannot be parsed as Qore keeps doxygen's highlighting
        list<string> yaml = (
            "server:",
            "  port: 8080",
            "  hosts: [a, b]",
            "  - name: x # comment",
        );
        assertEq(NOTHING, h.highlightFragment(fragment(yaml).substr(FS.length(), -FE.length())));
        string html = fragment(yaml);
        assertEq(html, h.process(html));

        # source listings with line numbers
        html = fragment(("<a id=\"l00001\" name=\"l00001\"></a><span class=\"lineno\">    1</span>int i;",));
        assertEq(html, h.process(html));

        # HTML that doxygen does not generate for code
        html = fragment(("<b>int</b> i;",));
        assertEq(html, h.process(html));
        html = fragment(("int i; &nbsp;",));
        assertEq(html, h.process(html));
        html = fragment(("int i; &#8364;",));
        assertEq(html, h.process(html));
        # a link that is not closed in the line
        html = fragment(("<a class=\"code\" href=\"x.html\">int i;",));
        assertEq(html, h.process(html));
        # text between lines
        html = FS + "<div class=\"line\">int i;</div>\n<p>x</p>\n" + FE;
        assertEq(html, h.process(html));
        # a fragment without lines or with only whitespace
        html = FS + "\n" + FE;
        assertEq(html, h.process(html));
        html = fragment(("   ", ""));
        assertEq(html, h.process(html));
        # a fragment that does not end
        html = FS + "<div class=\"line\">int i;</div>\n";
        assertEq(html, h.process(html));
    }

    testOpenFragments() {
        assertFalse(QoreCodeFragmentHighlighter::hasOpenFragment(""));
        assertFalse(QoreCodeFragmentHighlighter::hasOpenFragment("<p>x</p>"));
        assertFalse(QoreCodeFragmentHighlighter::hasOpenFragment(fragment(("a",))));
        assertTrue(QoreCodeFragmentHighlighter::hasOpenFragment(FS + "<div class=\"line\">a</div>\n"));
        assertTrue(QoreCodeFragmentHighlighter::hasOpenFragment(fragment(("a",)) + " " + FS));
        assertFalse(QoreCodeFragmentHighlighter::hasOpenFragment(fragment(("a",)) + " " + fragment(("b",))));
    }

    testIterator() {
        # a fragment over several lines is highlighted as a whole, after the other post-processing of each line
        string html = "<p>before</p>\n" + FS + "<div class=\"line\">list l = (1, 2);</div>\n"
            + "<div class=\"line\">x = l__1_0__2_;</div>\n" + FE + "<p>__1_after__2_</p>\n";
        string expected = "<p>before</p>\n" + FS + "<div class=\"line\"><span class=\"keywordtype\">list</span> l = "
            "(<span class=\"charliteral\">1</span>, <span class=\"charliteral\">2</span>);</div>\n"
            "<div class=\"line\">x = l[<span class=\"charliteral\">0</span>];</div>\n" + FE + "<p>[after]</p>\n";
        assertEq(expected, iterate(html));
        assertEq(expected, iterate(html, True));

        # highlighting disabled
        string unhighlighted = "<p>before</p>\n" + FS + "<div class=\"line\">list l = (1, 2);</div>\n"
            + "<div class=\"line\">x = l[0];</div>\n" + FE + "<p>[after]</p>\n";
        assertEq(unhighlighted, iterate(html, False, False));

        # the TeX iterator does not highlight code
        QorePostProcessingTexInputStreamLineIterator ti(new StringInputStream(FS + "<div class=\"line\">int i;</div>\n"
            + FE + "\n"));
        string out = "";
        map out += $1, ti;
        assertEq(FS + "<div class=\"line\">int i;</div>\n" + FE + "\n", out);

        # a fragment that does not end before the end of the input is returned unchanged
        html = FS + "<div class=\"line\">int i;</div>\n<div class=\"line\">int j;</div>\n";
        assertEq(html, iterate(html));

        # the documentation of Python and Java code is not post-processed after the list of its source files
        html = "<p>The documentation for this class was generated from the following file:</p><ul>\n"
            "<li>foo.py</li>\n" + FS + "<div class=\"line\">int i;</div>\n" + FE + "\n";
        assertEq(html, iterate(html));
    }

    #! writes a file
    static write_file(string path, string data) {
        File f();
        f.open2(path, O_CREAT | O_TRUNC | O_WRONLY);
        f.write(data);
    }

    #! post-processes HTML with QorePostProcessingInputStreamLineIterator
    static string iterate(string html, bool do_trim = False, bool highlight = True) {
        QorePostProcessingInputStreamLineIterator i(new StringInputStream(html), NOTHING, NOTHING, do_trim);
        if (!highlight) {
            i.setHighlightCode(False);
        }
        string rv = "";
        while (i.next()) {
            rv += i.getValue();
            if (do_trim) {
                rv += "\n";
            }
        }
        return rv;
    }

    testQdxPost() {
        string qdx = normalize_dir(get_script_dir() + "../../../../doxygen/qdx");
        if (!is_file(qdx)) {
            testSkip("doxygen/qdx is not available");
        }
        string qore_bin = ENV.QORE_EXECUTABLE ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        string module_dir = normalize_dir(get_script_dir() + "../../../../qlib")
            + (ENV.QORE_MODULE_DIR ? ":" + ENV.QORE_MODULE_DIR : "");

        TmpDir tmp("qdx-highlight-");
        string page = fragment(("int i = 1;",)) + "\n";
        string highlighted = fragment(("<span class=\"keywordtype\">int</span> i = <span class=\"charliteral\">1</span>;",))
            + "\n";
        string python_page = "<p>The documentation for this class was generated from the following files:</p><ul>\n"
            "<li>a.qc</li>\n<li>b.py</li>\n</ul>\n";
        # the list of source files of a Python class is after the code
        python_page = page + python_page;

        hash<string, string> files = {
            "a.html": page,
            "b.html": page,
            "python.html": python_page,
        };
        map write_file(tmp.path + DirSep + $1.key, $1.value), files.pairIterator();

        code<string(string, *string)> run = string sub (string opts, *string env) {
            string cmd = sprintf("%sQORE_MODULE_DIR='%s' '%s' '%s' --post %s '%s'/*.html 2>&1", env ?? "",
                module_dir, qore_bin, qdx, opts, tmp.path);
            int rc;
            string output = backquote(cmd, \rc);
            assertEq(0, rc, output);
            return output;
        };

        run("");
        assertEq(highlighted, File::readTextFile(tmp.path + DirSep + "a.html"));
        assertEq(highlighted, File::readTextFile(tmp.path + DirSep + "b.html"));
        assertEq(python_page, File::readTextFile(tmp.path + DirSep + "python.html"));

        # disabled with the option and with the environment variable
        map write_file(tmp.path + DirSep + $1.key, $1.value), files.pairIterator();
        run("--no-highlight");
        assertEq(page, File::readTextFile(tmp.path + DirSep + "a.html"));
        run("-H");
        assertEq(page, File::readTextFile(tmp.path + DirSep + "b.html"));
        run("", "QORE_DOC_NO_CODE_HIGHLIGHT=1 ");
        assertEq(page, File::readTextFile(tmp.path + DirSep + "a.html"));
        run("", "QORE_DOC_NO_CODE_HIGHLIGHT=0 ");
        assertEq(highlighted, File::readTextFile(tmp.path + DirSep + "a.html"));
    }
}
