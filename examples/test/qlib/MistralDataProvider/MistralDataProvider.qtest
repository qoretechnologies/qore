%modern
%allow-injection

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Logger
%requires ConnectionProvider
%requires DataProvider
%requires MistralDataProvider
%requires RestSchemaActions
%requires HttpServer
%requires HttpServerUtil
%requires json

%exec-class MistralDataProviderTest

class FakeMistralRestClientIo inherits RestClientIo::RestClientIo {
    public {
        *hash<auto> last_request;
        string last_method;
        string last_path;
        auto response_body = {};
        list<auto> responses = ();
        *data last_raw;
        *hash<auto> last_headers;
        int requests = 0;
        *string failure;
    }

    constructor() : RestClientIo({"url": "https://api.mistral.ai", "token": "x"}) {
    }

    RestClient::AbstractRestClient copyWithUrl(string new_url) {
        return self;
    }

    #! Schema dispatch now supplies an explicit target; retain this mock's response recorder.
    hash<RestClient::RestResponseInfo> restDoRawRequestTarget(string method,
            hash<RestClient::RestRequestTarget> target, *data body, *hash<auto> hdr) {
        return restDoRawRequest(method, target.path, body, hdr);
    }

    hash<RestClient::RestResponseInfo> restDoRawRequest(string method, string path, *data body,
            *hash<auto> hdr) {
        last_method = method;
        last_path = path;
        last_raw = body;
        last_headers = hdr;
        ++requests;
        if (failure) {
            throw failure, "injected transport failure";
        }
        last_request = body.val() && (hdr."Content-Type" ?? hdr."content-type" ?? "") !~ /^multipart\//
            ? parse_json(body.toString()) : NOTHING;
        return <RestClient::RestResponseInfo>{"status_code": 200,
            "body": responses ? shift responses : response_body};
    }

    hash<RestClient::RestResponseInfo> restDoRequest(string method, string path,
            auto body, *hash<auto> hdr) {
        last_method = method;
        last_path = path;
        last_request = body;
        return <RestClient::RestResponseInfo>{"body": response_body};
    }

    hash<RestClient::RestResponseInfo> restGet(string path, *hash<auto> hdr) {
        return restDoRequest("GET", path, NOTHING, hdr);
    }

    hash<RestClient::RestResponseInfo> restPost(string path, auto body,
            *hash<auto> hdr) {
        return restDoRequest("POST", path, body, hdr);
    }

    hash<RestClient::RestResponseInfo> restDel(string path, auto body,
            *hash<auto> hdr) {
        return restDoRequest("DELETE", path, body, hdr);
    }

    string getSafeUrl() {
        return "https://api.mistral.ai";
    }
}

class MistralWireHandler inherits AbstractHttpRequestHandler {
    private {
        Mutex lock();
        hash<auto> request;
        *data payload;
    }
    hash handleRequest(hash cx, hash hdr, *data body) {
        AutoLock al(lock);
        request = hdr;
        payload = body;
        return makeResponse(200, "{}", {"Content-Type": "application/json"});
    }
    hash<auto> getRequest() {
        AutoLock al(lock);
        return request;
    }
    *data getBody() {
        AutoLock al(lock);
        return payload;
    }
}

public class MistralDataProviderTest inherits QUnit::Test {
    public {
        const MyOpts = Opts + {
            "conn": "c,connection=s",
        };

        const OptionColumn = 22;
    }

    private {
        *string conn_name;
    }

    constructor() : Test("MistralDataProvider Test", "1.0", \ARGV, MyOpts) {
        conn_name = m_options.conn ?? ENV.MISTRAL_CONNECTION;

        addTestCase("factory + app + 161 actions registered", \registrationTest());
        addTestCase("root provider lists 161 children",       \rootProviderTest());
        addTestCase("chat-completion converts created date", \chatRequestTest());
        addTestCase("create-embeddings forwards body unchanged",
            \embeddingRequestTest());
        addTestCase("ocr posts to /ocr",                    \ocrRequestTest());

        # Live test requires a real Mistral AI connection.
        # Cost: 1 token-bounded open-mistral-nemo request (~$0.0001 per run).
        if (conn_name) {
            addTestCase("live: ping + chat-completion (open-mistral-nemo)",
                \liveMistralTest());
        }
        addTestCase("complete action contracts", \contractTest());
        addTestCase("pinned provenance and schema drift", \schemaTest());
        addTestCase("an enumeration shows the same labels wherever an action reaches it", \enumLabelTest());
        addTestCase("resource dropdowns", \referenceTest());
        addTestCase("HTTP authentication, paths and named multipart files", \wireTest());
        addTestCase("invalid requests and transport failures", \negativeTest());
        hash<auto> fixtures = parse_json(File::readTextFile(get_script_dir() + "/requests.json"));
        foreach hash<RestSchemaActionInfo> info in (MistralManifest::Manifest) {
            hash<RestSchemaActionInfo> entry = info;
            hash<auto> request = fixtures{info.action};
            addTestCase("request: " + info.action, sub () { operationTest(entry, request); });
        }
        set_return_value(main());
    }

    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-c,--connection=ARG",
            "set the Mistral AI connection name; without it (and "
            "without the MISTRAL_CONNECTION env var) the live test is skipped",
            OptionColumn);
    }

    private registrationTest() {
        DataProvider::AbstractDataProviderFactory f =
            DataProvider::DataProvider::getFactory("mistral");
        assertEq("mistral", f.getInfo().name);

        hash<DataProviderAppInfo> app =
            DataProvider::DataProviderActionCatalog::getApp("MistralAi");
        assertEq("MistralAi", app.name);
        assertEq("Mistral AI", app.display_name);
        assertEq("mistral", app.scheme);
        assertEq("mistral-ai-logo.svg", app.logo_file_name);

        # filter out the framework-injected make-api-call action (covered by
        # GenericApiCallAutoInjection.qtest in RestClientDataProvider)
        list<hash<DataProviderActionInfo>> actions = select
            DataProvider::DataProviderActionCatalog::getActions("MistralAi"),
            $1.action != AbstractDataProvider::GenericApiCallActionName;
        assertEq(161, actions.size());
        list<string> action_names = sort(map $1.action, actions);
        assertEq(sort(map $1.action, MistralManifest::Manifest), action_names);
    }

    private rootProviderTest() {
        FakeMistralRestClientIo fake();
        MistralDataProvider::MistralDataProvider prov(fake);
        # filter out the framework-injected __call__ child (covered by
        # GenericApiCallAutoInjection.qtest in RestClientDataProvider)
        list<string> children = sort(select prov.getChildProviderNames(),
            $1 != AbstractDataProvider::GenericApiCallChildName);
        assertEq(sort(map $1.action, MistralManifest::Manifest), children);
        foreach string name in (children) {
            assertTrue(prov.getChildProvider(name).supportsRequest(), name);
        }
        assertThrows("MISTRAL-CHILD-ERROR", sub () {
            MistralDataProvider::MistralDataProvider::registerChild("list-models",
                Class::forName("MistralDataProvider::MistralChatCompletionDataProvider"));
        });
    }

    private chatRequestTest() {
        FakeMistralRestClientIo fake();
        fake.response_body = {
            "id": "mistral-id",
            "created": 1700000000,
            "model": "mistral-large-latest",
            "choices": (
                {"index": 0, "message": {"role": "assistant", "content": "Hi"},
                 "finish_reason": "stop"},
            ),
            "usage": {"prompt_tokens": 5, "completion_tokens": 1, "total_tokens": 6},
        };

        MistralDataProvider::MistralChatCompletionDataProvider prov(fake);
        auto resp = prov.doRequest({
            "model": "mistral-large-latest",
            "messages": ({"role": "user", "content": "Hi"},),
        });

        assertEq("POST", fake.last_method);
        assertEq("/v1/chat/completions", fake.last_path);
        assertEq("Hi", resp.choices[0].message.content);
        assertEq(NT_DATE, resp.created.typeCode());
        assertEq(1700000000, int(resp.created - 1970-01-01Z));
    }

    private embeddingRequestTest() {
        FakeMistralRestClientIo fake();
        fake.response_body = {
            "id": "emb-id",
            "object": "list",
            "model": "mistral-embed",
            "data": (
                {"index": 0, "object": "embedding",
                 "embedding": (0.1, 0.2, 0.3)},
            ),
            "usage": {"prompt_tokens": 3, "total_tokens": 3},
        };

        MistralDataProvider::MistralEmbeddingDataProvider prov(fake);
        auto resp = prov.doRequest({
            "model": "mistral-embed",
            "input": ("hello",),
        });

        assertEq("POST", fake.last_method);
        assertEq("/v1/embeddings", fake.last_path);
        assertEq(3, resp.data[0].embedding.size());
    }

    private ocrRequestTest() {
        FakeMistralRestClientIo fake();
        fake.response_body = {
            "model": "mistral-ocr-latest",
            "pages": (
                {"index": 0, "markdown": "# Hello\n\nWorld.", "images": ()},
            ),
            "usage_info": {"pages_processed": 1, "doc_size_bytes": 12345},
        };

        MistralDataProvider::MistralOcrDataProvider prov(fake);
        auto resp = prov.doRequest({
            "model": "mistral-ocr-latest",
            "document": {
                "type": "document_url",
                "document_url": "https://example.test/doc.pdf",
            },
        });

        assertEq("POST", fake.last_method);
        assertEq("/v1/ocr", fake.last_path);
        assertEq("document_url", fake.last_request.document."type");
        assertEq("# Hello\n\nWorld.", resp.pages[0].markdown);
        assertEq(1, resp.usage_info.pages_processed);
    }

    private contractTest() {
        RestSchemaActionSet actions = MistralSchema::getActionSet();
        foreach hash<DataProviderActionInfo> action in (DataProviderActionCatalog::getActions("MistralAi")) {
            if (action.action == AbstractDataProvider::GenericApiCallActionName) {
                continue;
            }
            assertTrue(action.display_name.val(), action.action);
            assertTrue(action.short_desc.val() && action.short_desc.size() < 80, action.action);
            assertTrue(action.desc.val(), action.action);
            assertFalse(exists action.cls, action.action);
            RestSchemaActionOperation op = actions.getOperationEx(action.action);
            assertEq(exists op.getResponseType(), exists action.output_type, action.action);
            if (op.getRequestType()) {
                assertEq(sort(keys op.getRequestType().getFields()), sort(keys action.options), action.action);
            }
        }
        hash<string, AbstractDataField> chat = new MistralChatCompletionRequestDataType().getFields();
        foreach string field in ("tools", "tool_choice", "response_format", "random_seed", "safe_prompt") {
            assertTrue(exists chat{field}, field);
        }
        assertFalse(exists chat.stream);
        assertEq("models", chat.model.getAttributes().ref_data);
        assertTrue(chat.tool_choice.getAllowedValues().size() > 1);
        hash<string, AbstractDataField> connector = actions.getOperationEx("create-connector").getRequestFields();
        assertTrue(connector.headers.getAttributes().sensitive);
        assertTrue(connector.auth_data.getAttributes().sensitive);
        assertTrue(actions.getOperationEx("update-connector").getRequestFields()
            .connection_secrets.getAttributes().sensitive);
        hash<string, AbstractDataField> batch = actions.getOperationEx("create-batch-job").getRequestFields();
        assertEq("files", batch.input_files.getAttributes().element_ref_data);
        assertEq("conversations", actions.getOperationEx("import-dataset-from-playground").getRequestFields()
            .conversation_ids.getAttributes().element_ref_data);
        assertEq("workflow-runs", actions.getOperationEx("batch-cancel-workflow-executions").getRequestFields()
            .execution_ids.getAttributes().element_ref_data);
    }

    private operationTest(hash<RestSchemaActionInfo> info, hash<auto> request) {
        FakeMistralRestClientIo fake();
        MistralDataProvider::MistralDataProvider root(fake);
        foreach string key in (keys request) {
            if (request{key} == "__test_binary__") {
                request{key} = binary("test payload");
            } else if (request{key}.typeCode() == NT_HASH && request{key}.content == "__test_binary__") {
                request{key}.content = binary("test payload");
            }
        }
        root.getChildProvider(info.action).doRequest(request);
        assertEq(1, fake.requests);
        assertEq(info.method, fake.last_method);
        string path = info.path;
        foreach string key in ((info.path =~ x/\{([^}]+)\}/g) ?? ()) {
            path = replace(path, "{" + key + "}", encode_url(request{key}.toString()));
        }
        assertEq(path, fake.last_path.split("?")[0]);
    }

    private referenceTest() {
        FakeMistralRestClientIo fake();
        MistralDataProvider::MistralDataProvider root(fake);
        fake.response_body = {"data": ({"id": "model-1"},)};
        auto values = root.getChildProvider("chat-completion").getReferenceData("models");
        assertEq("model-1", values[0].value);
        assertEq("/v1/models", fake.last_path);
        fake.response_body = {"data": ()};
        assertNothing(root.getChildProvider("chat-completion").getReferenceData("models"));
        hash<string, AbstractDataProvider> providers;
        foreach hash<RestSchemaActionInfo> info in (MistralManifest::Manifest) {
            AbstractDataProvider provider = root.getChildProvider(info.action);
            foreach string name in (keys provider.getSupportedReferenceData()) {
                providers{name} = provider;
            }
        }
        foreach hash<RestSchemaReferenceDataInfo> decl in (MistralManifest::ReferenceData.iterator()) {
            assertTrue(exists providers{decl.name}, decl.name + " is used by an action option");
            AbstractDataProviderType records = (MistralSchema::getActionSet()).getOperationEx(decl.action)
                .getResponseType();
            foreach string path in (decl.records_path) {
                records = records.getFields(){path}.getType();
            }
            assertEq(NT_LIST, records.getBaseTypeCode(), decl.name + " reaches an API response list");
            hash<auto> row = {decl.value_field: decl.name == "agent-versions" ? 7
                : "00000000-0000-4000-8000-000000000001"};
            if (decl.value_field != decl.display_field) {
                row{decl.display_field} = "Invoices";
            }
            auto response = (row,);
            for (int i = decl.records_path.size() - 1; i >= 0; --i) {
                response = {decl.records_path[i]: response};
            }
            fake.response_body = response;
            if (decl.options_reference) {
                fake.responses = ({"datasets": {"results": ({"id": "00000000-0000-4000-8000-000000000002"},)}},
                    response);
            }
            hash<auto> scope;
            foreach string key in (decl.options_from.iterator()) {
                scope{key} = "00000000-0000-4000-8000-000000000002";
            }
            int before = fake.requests;
            if (scope) {
                assertNothing(providers{decl.name}.getReferenceData(decl.name));
                assertEq(before, fake.requests, "scoped dropdowns make no request without their parent");
            }
            auto choices = providers{decl.name}.getReferenceData(decl.name, scope);
            assertEq(row{decl.value_field}, choices[0].value, decl.name);
            assertEq(row{decl.display_field}.toString(), choices[0].display_name, decl.name);
            assertEq(decl.name == "chat-events" ? "POST" : "GET", fake.last_method);
            assertEq(before + (decl.options_reference ? 2 : 1), fake.requests);
        }

    }

    private enumLabelTest() {
        # (action, schema of the type, field) -> labels -> paths
        hash<string, hash<string, list<string>>> labels = {};
        foreach hash<auto> action in (DataProviderActionCatalog::getActions("MistralAi", False)) {
            hash<string, bool> seen = {};
            foreach hash<auto> option in (action.options.pairIterator()) {
                if (option.value.type instanceof AbstractDataProviderType) {
                    collectEnumLabels(action.action, option.value.type, option.key, \seen, \labels);
                }
            }
        }
        assertTrue(labels{"search-chat-events|#/components/schemas/FilterCondition|op"}.size() > 0,
            "the filter condition's operator is reached");
        assertTrue(labels{"chat-completion|#/components/schemas/ToolCall|type"}.size() > 0,
            "the tool call's type is reached");
        foreach hash<auto> e in (labels.pairIterator()) {
            assertEq(1, e.value.size(), sprintf("%s has one set of labels; found: %y", e.key,
                map {$1.key: $1.value[0]}, e.value.pairIterator()));
        }
    }

    #! Collects the labels of the enumerated fields of the types an action option reaches
    private collectEnumLabels(string action, AbstractDataProviderType type, string path,
            reference<hash<string, bool>> seen, reference<hash<string, hash<string, list<string>>>> labels) {
        if (seen{type.uniqueHash()}) {
            return;
        }
        seen{type.uniqueHash()} = True;
        if (type instanceof QoreUnionDataType) {
            foreach AbstractDataProviderType alternative in (cast<QoreUnionDataType>(type).getUnionTypes()) {
                collectEnumLabels(action, alternative, path, \seen, \labels);
            }
            return;
        }
        *hash<string, AbstractDataField> fields = type.getFields();
        if (!fields) {
            if (*AbstractDataProviderType element = type.getElementType()) {
                collectEnumLabels(action, element, path + "[]", \seen, \labels);
            }
            return;
        }
        # an overlay's copy of a type is the schema's type
        *string schema = (type.getSchemaIdentity() =~ x/^([^#]*#[^#]*)/)[0];
        foreach hash<auto> field in (fields.pairIterator()) {
            if (schema && (*list<hash<AllowedValueInfo>> values = field.value.getAllowedValues())) {
                string key = sprintf("%s|%s|%s", action, schema, field.key);
                labels{key}{(map $1.display_name, values).join(", ")} += path + "." + field.key;
            }
            collectEnumLabels(action, field.value.getDeclaredType(), path + "." + field.key, \seen, \labels);
        }
    }

    private schemaTest() {
        assertTrue(MistralSchema::Provenance.source_sha256 =~ /^[a-f0-9]{64}$/);
        assertTrue(MistralSchema::Provenance.source_url =~ /platform-docs-public\/[a-f0-9]{40}\/openapi.yaml$/);
        assertTrue(MistralSchema::Provenance.source_size > 0);
        assertEq(173, MistralSchema::Provenance.source_operations);
        assertEq((), RestSchemaDrift::compare(MistralSchema::getActionSet(), MistralSchema::getSchema()),
            "the manifest and pinned operation contracts agree");
    }

    private wireTest() {
        Logger logger("mistral-wire", LoggerLevel::getLevelWarn());
        HttpServer server(<HttpServerOptionInfo>{"logger": logger});
        on_exit delete server;
        MistralWireHandler handler();
        server.setDefaultHandler("mistral", handler);
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        MistralRestClient::MistralRestClientIo client({"url": sprintf("http://127.0.0.1:%d", port),
            "apikey": "wire-key", "api": "v2", "http_version": "1.1"});
        MistralDataProvider::MistralDataProvider root(client);
        root.getChildProvider("list-models").doRequest({});
        assertEq("v1/models", handler.getRequest().path);
        assertEq("Bearer wire-key", handler.getRequest().authorization);
        client.restGet("models");
        assertEq("v2/models", handler.getRequest().path, "the caller's client retains its prefix");
        root.getChildProvider("list-agents").doRequest({"metadata": {"team": "sales&support"}});
        hash<UriQueryInfo> query = parse_uri_query(handler.getRequest().path);
        # HttpServer separates the query from the route in its request metadata.
        assertEq("v1/agents", query.method);
        root.getChildProvider("transcribe-audio").doRequest({"file": {"name": "invoice.wav",
            "content": <00017fff52494646>, "mime_type": "audio/wav"}, "language": "en"});
        hash<string, hash<FormDataMessageInfo>> parts = MultiPartFormDataMessage::parseMessage(
            handler.getRequest()."content-type", handler.getBody().toString());
        assertEq("invoice.wav", parts.file.filename);
        assertEq("audio/wav", parts.file.hdr."content-type");
        assertEq(<00017fff52494646>, parts.file.body);
        assertEq("en", parts.language.body);
        assertEq("voxtral-mini-latest", parts.model.body);
        assertEq(NOTHING, parts.model.filename);
    }

    private negativeTest() {
        assertThrows("CONSTRUCTOR-ERROR", sub () { new MistralDataProvider::MistralDataProvider({}); });
        FakeMistralRestClientIo fake();
        MistralDataProvider::MistralDataProvider root({"restclient": fake});
        foreach hash<auto> test in (
                {"action": "chat-completion", "request": {}},
                {"action": "create-embeddings", "request": {}},
                {"action": "ocr", "request": {}},
                {"action": "transcribe-audio", "request": {}},
                {"action": "get-model", "request": {}},
                {"action": "chat-completion", "request": {"messages": ({"role": "invalid", "content": "Hello"},)}},
                {"action": "chat-completion", "request": {"messages": ({"role": "user", "content": "Hello"},), "temperature": -1}}) {
            *hash<ExceptionInfo> error;
            try {
                root.getChildProvider(test.action).doRequest(test.request);
            } catch (hash<ExceptionInfo> ex) {
                error = ex;
            }
            assertTrue(exists error, test.action);
        }
        assertEq(0, fake.requests);
        fake.failure = "SOCKET-CLOSED";
        assertThrows("SOCKET-CLOSED", sub () { root.getChildProvider("list-models").doRequest({}); });
        assertEq(1, fake.requests, "failed operations are never retried automatically");
        assertNothing(root.getChildProvider("nonexistent"));
    }

    #! Exercises Mistral AI's live chat-completion endpoint
    /** Verifies the actual wire format against Mistral AI's production
        endpoint with a token-bounded request on `open-mistral-nemo`.
        Cost: ~$0.0001 per run (capped via max_tokens=16).
    */
    private liveMistralTest() {
        AbstractConnection conn = get_connection(conn_name);
        hash<auto> ping = conn.ping(True);
        assertTrue(ping.ok, sprintf("Mistral connection ping failed: %s",
            ping.info ?? "no info"));

        AbstractDataProvider prov = conn.getDataProvider();
        AbstractDataProvider chat = prov.getChildProvider("chat-completion");
        auto resp = chat.doRequest({
            "model": "open-mistral-nemo",
            "messages": ({"role": "user", "content": "Say hi in one word."},),
            "max_tokens": 16,
        });
        assertTrue(resp.choices[0].message.content.val(),
            "Mistral returned non-empty assistant content");
        assertTrue(resp.usage.total_tokens > 0,
            "Mistral reported positive total_tokens");
    }
}
