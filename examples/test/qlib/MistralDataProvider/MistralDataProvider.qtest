#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%allow-injection

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/DataProvider
%requires ../../../../qlib/MistralDataProvider

%exec-class MistralDataProviderTest

class FakeMistralRestClientIo inherits RestClientIo::RestClientIo {
    public {
        *hash<auto> last_request;
        string last_method;
        string last_path;
        hash<auto> response_body;
    }

    constructor() : RestClientIo({"url": "https://api.mistral.ai", "token": "x"}) {
    }

    hash<RestClient::RestResponseInfo> restDoRequest(string method, string path,
            auto body, *hash<auto> hdr) {
        last_method = method;
        last_path = path;
        last_request = body;
        return <RestClient::RestResponseInfo>{"body": response_body};
    }

    hash<RestClient::RestResponseInfo> restGet(string path, *hash<auto> hdr) {
        return restDoRequest("GET", path, NOTHING, hdr);
    }

    hash<RestClient::RestResponseInfo> restPost(string path, auto body,
            *hash<auto> hdr) {
        return restDoRequest("POST", path, body, hdr);
    }

    hash<RestClient::RestResponseInfo> restDel(string path, auto body,
            *hash<auto> hdr) {
        return restDoRequest("DELETE", path, body, hdr);
    }

    string getSafeUrl() {
        return "https://api.mistral.ai";
    }
}

public class MistralDataProviderTest inherits QUnit::Test {
    constructor() : Test("MistralDataProvider Test", "1.0") {
        addTestCase("factory + app + 3 actions registered", \registrationTest());
        addTestCase("root provider lists 3 children",       \rootProviderTest());
        addTestCase("chat-completion converts created date", \chatRequestTest());
        addTestCase("create-embeddings forwards body unchanged",
            \embeddingRequestTest());
        addTestCase("ocr posts to /ocr",                    \ocrRequestTest());
        set_return_value(main());
    }

    private registrationTest() {
        DataProvider::AbstractDataProviderFactory f =
            DataProvider::DataProvider::getFactory("mistral");
        assertEq("mistral", f.getInfo().name);

        hash<DataProviderAppInfo> app =
            DataProvider::DataProviderActionCatalog::getApp("MistralAi");
        assertEq("MistralAi", app.name);
        assertEq("Mistral AI", app.display_name);
        assertEq("mistral", app.scheme);
        assertEq("mistral-ai-logo.svg", app.logo_file_name);

        list<hash<DataProviderActionInfo>> actions =
            DataProvider::DataProviderActionCatalog::getActions("MistralAi");
        assertEq(3, actions.size());
        list<string> action_names = sort(map $1.action, actions);
        assertEq(("chat-completion", "create-embeddings", "ocr"), action_names);
    }

    private rootProviderTest() {
        FakeMistralRestClientIo fake();
        MistralDataProvider::MistralDataProvider prov(fake);
        list<string> children = sort(prov.getChildProviderNames());
        assertEq(("chat-completion", "create-embeddings", "ocr"), children);
    }

    private chatRequestTest() {
        FakeMistralRestClientIo fake();
        fake.response_body = {
            "id": "mistral-id",
            "created": 1700000000,
            "model": "mistral-large-latest",
            "choices": (
                {"index": 0, "message": {"role": "assistant", "content": "Hi"},
                 "finish_reason": "stop"},
            ),
            "usage": {"prompt_tokens": 5, "completion_tokens": 1, "total_tokens": 6},
        };

        MistralDataProvider::MistralChatCompletionDataProvider prov(fake);
        auto resp = prov.doRequest({
            "model": "mistral-large-latest",
            "messages": ({"role": "user", "content": "Hi"},),
        });

        assertEq("POST", fake.last_method);
        assertEq("chat/completions", fake.last_path);
        assertEq("Hi", resp.choices[0].message.content);
        assertEq(NT_DATE, resp.created.typeCode());
        assertEq(1700000000, int(resp.created - 1970-01-01Z));
    }

    private embeddingRequestTest() {
        FakeMistralRestClientIo fake();
        fake.response_body = {
            "id": "emb-id",
            "object": "list",
            "model": "mistral-embed",
            "data": (
                {"index": 0, "object": "embedding",
                 "embedding": (0.1, 0.2, 0.3)},
            ),
            "usage": {"prompt_tokens": 3, "total_tokens": 3},
        };

        MistralDataProvider::MistralEmbeddingDataProvider prov(fake);
        auto resp = prov.doRequest({
            "model": "mistral-embed",
            "input": ("hello",),
        });

        assertEq("POST", fake.last_method);
        assertEq("embeddings", fake.last_path);
        assertEq(3, resp.data[0].embedding.size());
    }

    private ocrRequestTest() {
        FakeMistralRestClientIo fake();
        fake.response_body = {
            "model": "mistral-ocr-latest",
            "pages": (
                {"index": 0, "markdown": "# Hello\n\nWorld.", "images": ()},
            ),
            "usage_info": {"pages_processed": 1, "doc_size_bytes": 12345},
        };

        MistralDataProvider::MistralOcrDataProvider prov(fake);
        auto resp = prov.doRequest({
            "model": "mistral-ocr-latest",
            "document": {
                "type": "document_url",
                "document_url": "https://example.test/doc.pdf",
            },
        });

        assertEq("POST", fake.last_method);
        assertEq("ocr", fake.last_path);
        assertEq("document_url", fake.last_request.document."type");
        assertEq("# Hello\n\nWorld.", resp.pages[0].markdown);
        assertEq(1, resp.usage_info.pages_processed);
    }
}
