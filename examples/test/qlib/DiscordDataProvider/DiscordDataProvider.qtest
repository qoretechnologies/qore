#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Mime
%requires Logger
%requires ConnectionProvider
%requires DataProvider
%requires RestClient
%requires DiscordRestClient
%requires WebSocketClient
%requires DiscordWebSocketClient
%requires DiscordDataProvider

%requires json

%exec-class Main

public class Main inherits QUnit::Test {
    private {
        DiscordDataProvider ddp;

        # command-line options
        const MyOpts = Opts + {
            "conn": "c,connection=s",
        };

        const OptionColumn = 22;
    }

    constructor() : Test("DiscordDataProviderTest", "1.0", \ARGV, MyOpts) {
        addTestCase("discord sanity tests", \discordSanityTests());
        addTestCase("discord tests", \discordTests());
        addTestCase("action data dependent options", \testActionDataDependentOptions());
        addTestCase("rest command error formatting", \testRestCommandErrorFormatting());

        try {
            setupConnection();
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose > 2) {
                printf("%s\n", get_exception_string(ex));
            } else if (m_options.verbose) {
                printf("%s: %s\n", ex.err, ex.desc);
            }
        }

        # Return for compatibility with test harness that checks return value.
        set_return_value(main());
    }

    checkModule() {
    }

    discordSanityTests() {
        checkModule();

        try {
            DiscordDataProvider prov({
                "oauth2_client_id": "x",
                "oauth2_client_secret": "x",
                "token": "x",
            });
            assertEq("discord", prov.getName());
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "SOCKET-CONNECT-ERROR" || ex.err == "SOCKET-SSL-ERROR"
                    || ex.err == "QOREADDRINFO-GETINFO-ERROR" || ex.err == "SOCKET-TIMEOUT" || ex.err == "HTTPCLIENT-NEGOTIATE-TIMEOUT" || ex.err == "HTTPCLIENT-TIMEOUT") {
                testSkip(sprintf("cannot connect to Discord API: %s", ex.desc));
            }
            rethrow;
        }
    }

    discordTests() {
        checkModule();
        if (!ddp) {
            testSkip("no connection to Discord");
        }

        AbstractDataProvider prov = ddp.getChildProvider("user-info");
        hash<auto> info = prov.doRequest();
        assertEq(Type::String, info.username.type());
        assertEq(Type::String, info.id.type());
        assertEq(Type::String, info.avatar.type());
        assertEq(Type::String, info.global_name.type());

        prov = ddp.getChildProvider("guilds");
        string gid = prov.getChildProviderNames()[0];
        prov = prov.getChildProvider(gid);
        prov = prov.getChildProvider("get");
        info = prov.doRequest();
        assertEq(Type::String, info.id.type());
        assertEq(Type::String, info.name.type());
        assertEq(Type::String, info.icon.type());
    }

    #! Verifies that doRestCommand() only appends response info that is actually present
    /** On a non-response error (ex: an OAuth2 token refresh failure) there are no response headers, so the bare
        exception must be rethrown unchanged instead of appending a useless
        "(HTTP response code: null x-ratelimit-remaining: null x-ratelimit-reset: null)" suffix.
    */
    testRestCommandErrorFormatting() {
        # no response headers set: the error must be rethrown with its original description, unadorned
        {
            DiscordGuildsByNameDataProvider prov(new MockNoInfoRest());
            hash<ExceptionInfo> ex;
            try {
                prov.getChildProviderNames();
            } catch (hash<ExceptionInfo> ex1) {
                ex = ex1;
            }
            assertEq("REST-RESPONSE-ERROR", ex.err);
            assertEq("HTTP 400 response received", ex.desc);
            assertFalse(ex.desc =~ /x-ratelimit/, "no rate-limit noise in message");
            assertFalse(ex.desc =~ /null/, "no null placeholders in message");
        }

        # only a status code present: the message includes it, but not the absent rate-limit fields
        {
            DiscordGuildsByNameDataProvider prov(new MockStatusOnlyRest());
            hash<ExceptionInfo> ex;
            try {
                prov.getChildProviderNames();
            } catch (hash<ExceptionInfo> ex1) {
                ex = ex1;
            }
            assertEq("REST-RESPONSE-ERROR", ex.err);
            assertEq("HTTP 400 response received (HTTP response code: 400)", ex.desc);
            assertFalse(ex.desc =~ /x-ratelimit/, "no absent rate-limit fields in message");
        }
    }

    testActionDataDependentOptions() {
        list<string> expected_actions = (
            "user-info", "guild-info",
        );

        list<hash<DataProviderActionInfo>> actions = DataProviderActionCatalog::getActions("Discord");
        hash<string, hash<DataProviderActionInfo>> action_map;
        for (int i = 0; i < actions.size(); ++i) {
            action_map{actions[i].action} = actions[i];
        }
        for (int i = 0; i < expected_actions.size(); ++i) {
            string action_name = expected_actions[i];
            assertTrue(action_map.hasKey(action_name),
                sprintf("action %y is registered", action_name));
            if (action_map.hasKey(action_name)) {
                assertTrue(action_map{action_name}.data_dependent_options,
                    sprintf("action %y has data_dependent_options", action_name));
            }
        }
    }

    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-c,--connection=ARG", "set connection name", OptionColumn);
    }

    private error(string fmt) {
        throw "OPTION-ERROR", sprintf("%s: ERROR: %s", get_script_name(), vsprintf(fmt, argv));
    }

    private setupConnection() {
        *string conn_name = m_options.conn ?? ENV.DISCORD_CONNECTION;
        if (!conn_name.val()) {
            error("missing -c,--connection option or DISCORD_CONNECTION environment variable");
        }

        AbstractConnection conn = get_connection(conn_name);
        if (!(conn instanceof DiscordRestConnection)) {
            error("connection %y is type %y; expecting \"DiscordRestConnection\"", conn_name, conn.className());
        }
        ddp = conn.getDataProvider();
    }
}

#! A non-connecting REST client whose doRequest() fails without populating any response info
/** Simulates an OAuth2 token refresh failure, where the error is raised before any Discord API response is
    received, so \c info has no "response-headers".
*/
class MockNoInfoRest inherits DiscordRestClient {
    constructor() : DiscordRestClient({"url": "discord://discord.com/api", "token": "x"}, True) {
    }

    hash<auto> doRequest(string m, string path, auto body, *reference<hash<auto>> info,
            softbool decode_errors = True, *hash<auto> hdr) {
        throw "REST-RESPONSE-ERROR", "HTTP 400 response received";
    }
}

#! A non-connecting REST client whose doRequest() fails with only a status code (no rate-limit headers)
class MockStatusOnlyRest inherits DiscordRestClient {
    constructor() : DiscordRestClient({"url": "discord://discord.com/api", "token": "x"}, True) {
    }

    hash<auto> doRequest(string m, string path, auto body, *reference<hash<auto>> info,
            softbool decode_errors = True, *hash<auto> hdr) {
        info."response-headers" = {"status_code": 400};
        throw "REST-RESPONSE-ERROR", "HTTP 400 response received";
    }
}
