%exec-class TableauDataProviderTest

#! A Tableau client that sends requests to a local server
class LocalTableauRestClientIo inherits TableauRestClient::TableauRestClientIo {
    constructor(hash<auto> opts, string local_url) : TableauRestClientIo(opts) {
        url = local_url;
    }
}

#! A local Tableau API server that records requests
class FakeTableauHandler inherits AbstractHttpRequestHandler {
    public {
        #! the requests received
        list<hash<auto>> requests = ();
        #! the number of sign-ins
        int sign_ins;
        #! the number of requests still to be answered with 401 Unauthorized
        int expire_session;
        #! the number of requests still to be answered with 429 Too Many Requests
        int rate_limited;
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        requests += {
            "method": hdr.method,
            "path": hdr.path,
            "auth": hdr."x-tableau-auth",
            "body": body ? parse_json(body.toString()) : NOTHING,
        };
        if (hdr.path =~ /auth\/signin$/) {
            ++sign_ins;
            return <HttpResponseInfo>{
                "code": 200,
                "hdr": {"Content-Type": MimeTypeJson},
                "body": make_json({"credentials": {"token": "session-" + sign_ins, "site": {"id": "site-1"}}}),
            };
        }
        if (expire_session > 0) {
            --expire_session;
            return <HttpResponseInfo>{
                "code": 401,
                "hdr": {"Content-Type": MimeTypeJson},
                "body": make_json({"error": {"summary": "Signin Error", "code": "401002"}}),
            };
        }
        if (rate_limited > 0) {
            --rate_limited;
            return <HttpResponseInfo>{
                "code": 429,
                "hdr": {"Content-Type": MimeTypeJson, "Retry-After": "1"},
                "body": make_json({"error": {"summary": "Too Many Requests"}}),
            };
        }
        if (hdr.path =~ /users\/missing$/) {
            return <HttpResponseInfo>{
                "code": 404,
                "hdr": {"Content-Type": MimeTypeJson},
                "body": make_json({"error": {"summary": "Resource Not Found", "code": "404002"}}),
            };
        }
        if (hdr.method == "POST") {
            return <HttpResponseInfo>{
                "code": 201,
                "hdr": {"Content-Type": MimeTypeJson},
                "body": make_json({"project": {"id": "p2", "name": "New"}}),
            };
        }
        return <HttpResponseInfo>{
            "code": 200,
            "hdr": {"Content-Type": MimeTypeJson},
            "body": make_json({
                "pagination": {"pageNumber": "1", "pageSize": "100", "totalAvailable": "1"},
                "projects": {"project": ({"id": "p1", "name": "Default"},)},
            }),
        };
    }
}

public class TableauDataProviderTest inherits QUnit::Test {
    private {
        #! Tableau REST client for integration tests
        *TableauRestClient::TableauRestClientIo client;

        #! Logger for verbose output
        Logger logger;

        #! Custom command-line options
        const MyOpts = Opts + {
            "subdomain": "d,subdomain=s",
            "token_name": "n,token-name=s",
            "token_secret": "s,token-secret=s",
            "content_url": "C,content-url=s",
            "conn": "c,connection=s",
        };

        #! Test project ID (created during test)
        *string testProjectId;

        #! Test user ID (created during test)
        *string testUserId;
    }

    constructor() : Test("TableauDataProvider Test", "1.0", \ARGV, MyOpts) {
        logger = new Logger("test", LoggerLevel::getLevelInfo());

        # Unit tests (always run, no credentials needed)
        addTestCase("sanity tests", \sanityTests());
        addTestCase("factory tests", \factoryTests());
        addTestCase("metadata tests", \metadataTests());
        addTestCase("child provider tests", \childProviderTests());
        addTestCase("data type tests", \dataTypeTests());
        addTestCase("trigger example data tests", \triggerExampleDataTests());
        addTestCase("negative tests", \negativeTests());
        addTestCase("connection tests", \connectionTests());
        addTestCase("local server tests", \localServerTests());

        # Integration tests (require Tableau credentials)
        addTestCase("integration tests", \integrationTests());

        # Try to set up connection for integration tests
        try {
            setupConnection();
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("Connection setup failed: %s: %s\n", ex.err, ex.desc);
            }
        }

        set_return_value(main());
    }

    #! Sets up the Tableau client for integration tests
    private setupConnection() {
        # Try to use a connection from Qorus if specified
        *string conn_name = m_options.conn ?? ENV.TABLEAU_CONNECTION;
        if (conn_name) {
            if (m_options.verbose) {
                printf("Using connection: %s\n", conn_name);
            }
            client = get_connection(conn_name).get();
            return;
        }

        *string subdomain = m_options.subdomain ?? ENV.TABLEAU_SUBDOMAIN;
        *string token_name = m_options.token_name ?? ENV.TABLEAU_TOKEN_NAME;
        *string token_secret = m_options.token_secret ?? ENV.TABLEAU_TOKEN_SECRET;
        *string content_url = m_options.content_url ?? ENV.TABLEAU_CONTENT_URL;

        if (!subdomain || !token_name || !token_secret) {
            if (m_options.verbose) {
                printf("Missing Tableau credentials. Required:\n");
                printf("  - TABLEAU_CONNECTION or -c option (Qorus connection name)\n");
                printf("Or:\n");
                printf("  - TABLEAU_SUBDOMAIN or -d option (e.g., us-east-23b)\n");
                printf("  - TABLEAU_TOKEN_NAME or -n option (PAT name)\n");
                printf("  - TABLEAU_TOKEN_SECRET or -s option (PAT secret)\n");
                printf("  - TABLEAU_CONTENT_URL or -C option (site name, optional)\n");
            }
            return;
        }

        hash<auto> opts = {
            "subdomain": subdomain,
            "token_name": token_name,
            "token_secret": token_secret,
        };
        if (content_url.val()) {
            opts.content_url = content_url;
        }

        client = new TableauRestClient::TableauRestClientIo(opts);
    }

    #! Check if json module is available
    private checkJson() {
    }

    #! Basic sanity tests - provider instantiation
    sanityTests() {
        checkJson();
        TableauDataProvider::TableauDataProvider prov({
            "tableaurestclient_options": {
                "subdomain": "fake-pod",
                "token_name": "fake-token-name",
                "token_secret": "fake-token-secret",
            },
        });
        assertEq("tableau", prov.getName());
        assertTrue(prov.getDesc().val());
    }

    #! Factory tests - verify factory registration
    factoryTests() {
        checkJson();
        AbstractDataProviderFactory factory = DataProvider::getFactory("tableau");
        assertEq("tableau", factory.getInfo().name);
        assertTrue(factory.getInfo().children_can_support_apis);
        assertTrue(factory.getInfo().children_can_support_records);
        assertTrue(factory.getInfo().children_can_support_observers);

        hash<auto> factoryOpts = factory.getInfo().provider_info.constructor_options;
        assertTrue(factoryOpts.hasKey("tableaurestclient"));
    }

    #! Metadata tests - verify provider info structure
    metadataTests() {
        checkJson();
        TableauDataProvider::TableauDataProvider prov({
            "tableaurestclient_options": {
                "subdomain": "fake-pod",
                "token_name": "fake-token-name",
                "token_secret": "fake-token-secret",
            },
        });
        hash<DataProviderInfo> info = prov.getInfo();

        assertTrue(info.supports_children);
        assertTrue(info.children_can_support_apis);
        assertTrue(info.children_can_support_records);
        assertTrue(info.children_can_support_observers);
        assertEq("TableauDataProvider", info.type);

        assertTrue(info.constructor_options.hasKey("tableaurestclient"));
    }

    #! Child provider tests - verify hierarchy
    childProviderTests() {
        checkJson();
        TableauDataProvider::TableauDataProvider prov({
            "tableaurestclient_options": {
                "subdomain": "fake-pod",
                "token_name": "fake-token-name",
                "token_secret": "fake-token-secret",
            },
        });

        # Check child provider names
        list<string> children = prov.getChildProviderNames();

        # Verify collection providers exist
        assertTrue(children.contains("datasources"));
        assertTrue(children.contains("projects"));
        assertTrue(children.contains("users"));
        assertTrue(children.contains("extract-refresh-tasks"));
        assertTrue(children.contains(AbstractDataProvider::GenericApiCallChildName));
        assertTrue(children.contains("events"));

        # Check datasources child provider
        AbstractDataProvider datasources = prov.getChildProvider("datasources");
        assertEq("datasources", datasources.getName());
        hash<DataProviderInfo> dsInfo = datasources.getInfo();
        assertTrue(dsInfo.supports_read);
        assertTrue(dsInfo.supports_native_search);
        assertTrue(dsInfo.supports_children);

        # Verify datasources has action children
        list<string> dsChildren = datasources.getChildProviderNames();
        assertTrue(dsChildren.contains("update"));
        assertTrue(dsChildren.contains("delete"));
        assertTrue(dsChildren.contains("download"));
        assertTrue(dsChildren.contains("add-tag"));
        assertTrue(dsChildren.contains("delete-tag"));

        # Check projects child provider
        AbstractDataProvider projects = prov.getChildProvider("projects");
        assertEq("projects", projects.getName());
        hash<DataProviderInfo> projInfo = projects.getInfo();
        assertTrue(projInfo.supports_read);
        assertTrue(projInfo.supports_native_search);

        # Verify projects has action children
        list<string> projChildren = projects.getChildProviderNames();
        assertTrue(projChildren.contains("create"));
        assertTrue(projChildren.contains("update"));
        assertTrue(projChildren.contains("delete"));

        # Check users child provider
        AbstractDataProvider users = prov.getChildProvider("users");
        assertEq("users", users.getName());
        list<string> userChildren = users.getChildProviderNames();
        assertTrue(userChildren.contains("create"));
        assertTrue(userChildren.contains("update"));
        assertTrue(userChildren.contains("delete"));

        # Check extract-refresh-tasks child provider
        AbstractDataProvider tasks = prov.getChildProvider("extract-refresh-tasks");
        assertEq("extract-refresh-tasks", tasks.getName());
        list<string> taskChildren = tasks.getChildProviderNames();
        assertTrue(taskChildren.contains("delete"));

        # Check events child provider and triggers
        AbstractDataProvider events = prov.getChildProvider("events");
        assertEq("events", events.getName());
        hash<DataProviderInfo> eventsInfo = events.getInfo();
        assertTrue(eventsInfo.supports_children);
        assertTrue(eventsInfo.children_can_support_observers);

        list<string> eventChildren = events.getChildProviderNames();
        assertTrue(eventChildren.contains("datasource-created"));
        assertTrue(eventChildren.contains("datasource-deleted"));
        assertTrue(eventChildren.contains("datasource-updated"));
        assertTrue(eventChildren.contains("datasource-refresh-started"));
        assertTrue(eventChildren.contains("datasource-refresh-succeeded"));
        assertTrue(eventChildren.contains("datasource-refresh-failed"));
        assertTrue(eventChildren.contains("watch-datasources"));
        assertTrue(eventChildren.contains("watch-projects"));

        # Verify event providers have correct info
        AbstractDataProvider dsCreated = events.getChildProvider("datasource-created");
        assertEq("datasource-created", dsCreated.getName());
        hash<DataProviderInfo> dsCreatedInfo = dsCreated.getInfo();
        assertTrue(dsCreatedInfo.supports_observable);
    }

    #! Data type tests - verify record type definitions
    dataTypeTests() {
        checkJson();
        # Test datasource data type
        TableauDataProvider::TableauDatasourceDataType dsType();
        hash<string, AbstractDataField> dsFields = dsType.getFields();
        assertTrue(dsFields.hasKey("id"));
        assertTrue(dsFields.hasKey("name"));
        assertTrue(dsFields.hasKey("contentUrl"));
        assertTrue(dsFields.hasKey("type"));
        assertTrue(dsFields.hasKey("createdAt"));
        assertTrue(dsFields.hasKey("updatedAt"));
        assertTrue(dsFields.hasKey("isCertified"));

        # Test project data type
        TableauDataProvider::TableauProjectDataType projType();
        hash<string, AbstractDataField> projFields = projType.getFields();
        assertTrue(projFields.hasKey("id"));
        assertTrue(projFields.hasKey("name"));
        assertTrue(projFields.hasKey("description"));
        assertTrue(projFields.hasKey("createdAt"));
        assertTrue(projFields.hasKey("updatedAt"));

        # Test user data type
        TableauDataProvider::TableauUserDataType userType();
        hash<string, AbstractDataField> userFields = userType.getFields();
        assertTrue(userFields.hasKey("id"));
        assertTrue(userFields.hasKey("name"));
        assertTrue(userFields.hasKey("fullName"));
        assertTrue(userFields.hasKey("email"));
        assertTrue(userFields.hasKey("siteRole"));
        assertTrue(userFields.hasKey("lastLogin"));

        # Test extract refresh task data type
        TableauDataProvider::TableauExtractRefreshTaskDataType taskType();
        hash<string, AbstractDataField> taskFields = taskType.getFields();
        assertTrue(taskFields.hasKey("id"));
        assertTrue(taskFields.hasKey("type"));
        assertTrue(taskFields.hasKey("priority"));
        assertTrue(taskFields.hasKey("consecutiveFailedCount"));

        # Test webhook event data type
        TableauDataProvider::TableauWebhookEventDataType eventType();
        hash<string, AbstractDataField> eventFields = eventType.getFields();
        assertTrue(eventFields.hasKey("resource"));
        assertTrue(eventFields.hasKey("event_type"));
        assertTrue(eventFields.hasKey("resource_name"));
        assertTrue(eventFields.hasKey("resource_luid"));
        assertTrue(eventFields.hasKey("site_luid"));
        assertTrue(eventFields.hasKey("created_at"));
    }

    #! Trigger example data tests
    triggerExampleDataTests() {
        checkJson();
        TableauDataProvider::TableauDataProvider prov({
            "tableaurestclient_options": {
                "subdomain": "fake-pod",
                "token_name": "fake-token-name",
                "token_secret": "fake-token-secret",
            },
        });

        AbstractDataProvider events = prov.getChildProvider("events");
        list<string> triggerNames = (
            "datasource-created",
            "datasource-deleted",
            "datasource-updated",
            "datasource-refresh-started",
            "datasource-refresh-succeeded",
            "datasource-refresh-failed",
            "watch-datasources",
            "watch-projects",
        );

        foreach string triggerName in (triggerNames) {
            AbstractDataProvider triggerProvider = events.getChildProvider(triggerName);

            # Verify event types are defined
            hash<string, hash<DataProviderMessageInfo>> eventTypes = triggerProvider.getEventTypes();
            assertTrue(eventTypes.hasKey(triggerName),
                sprintf("%s should define event type '%s'", triggerName, triggerName));

            # Verify event type has a data type
            assertTrue(eventTypes{triggerName}.type instanceof AbstractDataProviderType,
                sprintf("%s event type should have a data type", triggerName));
        }

        # Verify example event data for each trigger
        foreach string triggerName in (triggerNames) {
            AbstractDataProvider triggerProvider = events.getChildProvider(triggerName);

            # Get example event data
            auto exampleData = triggerProvider.getExampleEventData(triggerName);
            assertTrue(exampleData.val(),
                sprintf("%s should return non-empty example data", triggerName));
            assertTrue(exampleData instanceof hash,
                sprintf("%s example data should be a hash", triggerName));

            # Webhook triggers should have specific fields
            if (triggerName =~ /^datasource-/) {
                hash<auto> data = exampleData;
                assertTrue(data.hasKey("resource"),
                    sprintf("%s example should have 'resource' field", triggerName));
                assertTrue(data.hasKey("event_type"),
                    sprintf("%s example should have 'event_type' field", triggerName));
                assertTrue(data.hasKey("resource_luid"),
                    sprintf("%s example should have 'resource_luid' field", triggerName));
            }

            # Polling triggers should have resource-specific fields
            if (triggerName == "watch-datasources") {
                hash<auto> data = exampleData;
                assertTrue(data.hasKey("name"),
                    "watch-datasources example should have 'name' field");
            }
            if (triggerName == "watch-projects") {
                hash<auto> data = exampleData;
                assertTrue(data.hasKey("name"),
                    "watch-projects example should have 'name' field");
            }
        }
    }

    #! Negative tests - test error handling and invalid inputs
    negativeTests() {
        checkJson();
        TableauDataProvider::TableauDataProvider prov({
            "tableaurestclient_options": {
                "subdomain": "fake-pod",
                "token_name": "fake-token-name",
                "token_secret": "fake-token-secret",
            },
        });

        # Test getting non-existent child provider
        assertThrows("INVALID-CHILD-PROVIDER", sub() {
            prov.getChildProviderEx("nonexistent");
        });

        # Test the framework-injected generic API call child has request support
        AbstractDataProvider apiCall = prov.getChildProvider(AbstractDataProvider::GenericApiCallChildName);
        hash<DataProviderInfo> apiCallInfo = apiCall.getInfo();
        assertTrue(apiCallInfo.supports_request);
    }

    #! Connection tests - verify REST connection
    connectionTests() {
        checkJson();
        # Verify the scheme is registered
        hash<auto> scheme = ConnectionSchemeCache::getScheme("tableaures");
        assertTrue(scheme.schemes.tableaures);
        assertTrue(scheme.auto_url);

        # Verify scheme has required options
        assertTrue(scheme.options.hasKey("subdomain"));
        assertTrue(scheme.options.hasKey("token_name"));
        assertTrue(scheme.options.hasKey("token_secret"));
    }

    #! Integration tests - require real Tableau credentials
    integrationTests() {
        checkJson();

        if (!client) {
            testSkip("No Tableau credentials available - skipping integration tests");
            return;
        }

        if (m_options.verbose) {
            printf("Running Tableau integration tests...\n");
        }

        # Test 1: List projects
        testListProjects();

        # Test 2: Create project
        testCreateProject();

        # Test 3: Update project
        testUpdateProject();

        # Test 4: Search datasources
        testSearchDatasources();

        # Test 5: List users
        testListUsers();

        # Test 6: List extract refresh tasks
        testListExtractRefreshTasks();

        # Test the framework-injected generic API call
        testGenericApiCall();

        # Cleanup
        cleanup();
    }

    #! Test listing projects
    private testListProjects() {
        TableauDataProvider::TableauDataProvider prov(client);
        AbstractDataProvider projects = prov.getChildProvider("projects");

        # Search with limit
        AbstractDataProviderRecordIterator iter = projects.searchRecords(NOTHING, {"limit": 5});
        int count = 0;
        while (iter.next()) {
            hash<auto> record = iter.getValue();
            assertTrue(record.hasKey("id"), "Project should have 'id' field");
            assertTrue(record.hasKey("name"), "Project should have 'name' field");
            ++count;
        }

        if (m_options.verbose) {
            printf("Listed %d projects\n", count);
        }
        assertTrue(True, "List projects completed without error");
    }

    #! Test creating a project
    private testCreateProject() {
        TableauDataProvider::TableauDataProvider prov(client);
        AbstractDataProvider createAction = prov.getChildProvider("projects")
            .getChildProvider("create");

        string unique = now_us().format("YYYYMMDDHHmmSSxxxxxx");
        string projectName = "Test_Project_" + unique;
        hash<auto> result = createAction.doRequest({
            "name": projectName,
            "description": "Integration test project - safe to delete",
        });

        assertTrue(result.hasKey("id"), "Created project should have 'id' field");
        assertTrue(result.id.val(), "Project ID should be non-empty");
        testProjectId = result.id;

        if (m_options.verbose) {
            printf("Created project: %s (%s)\n", projectName, testProjectId);
        }

        # Verify data persistence - retrieve the project (brief delay for API consistency)
        sleep(2s);
        AbstractDataProvider projects = prov.getChildProvider("projects");
        AbstractDataProviderRecordIterator iter = projects.searchRecords(NOTHING, {
            "project_id": testProjectId,
        });
        assertTrue(iter.next(), "Should find created project by ID");
        hash<auto> fetched = iter.getValue();
        assertEq(projectName, fetched.name, "Project name should match");
    }

    #! Test updating a project
    private testUpdateProject() {
        if (!testProjectId) {
            testSkip("No test project created");
            return;
        }

        TableauDataProvider::TableauDataProvider prov(client);
        AbstractDataProvider updateAction = prov.getChildProvider("projects")
            .getChildProvider("update");

        hash<auto> result = updateAction.doRequest({
            "project_id": testProjectId,
            "description": "Updated by integration test",
        });

        assertTrue(result.hasKey("id"), "Updated project should have 'id' field");

        # Verify the update persisted (brief delay for API consistency)
        sleep(2s);
        AbstractDataProvider projects = prov.getChildProvider("projects");
        AbstractDataProviderRecordIterator iter = projects.searchRecords(NOTHING, {
            "project_id": testProjectId,
        });
        assertTrue(iter.next(), "Should find updated project");
        hash<auto> fetched = iter.getValue();
        assertEq("Updated by integration test", fetched.description,
            "Project description should be updated");
    }

    #! Test searching datasources
    private testSearchDatasources() {
        TableauDataProvider::TableauDataProvider prov(client);
        AbstractDataProvider datasources = prov.getChildProvider("datasources");

        AbstractDataProviderRecordIterator iter = datasources.searchRecords(NOTHING, {"limit": 5});
        int count = 0;
        while (iter.next()) {
            hash<auto> record = iter.getValue();
            assertTrue(record.hasKey("id"), "Datasource should have 'id' field");
            ++count;
        }

        if (m_options.verbose) {
            printf("Listed %d datasources\n", count);
        }
        assertTrue(True, "Search datasources completed without error");
    }

    #! Test listing users
    private testListUsers() {
        TableauDataProvider::TableauDataProvider prov(client);
        AbstractDataProvider users = prov.getChildProvider("users");

        AbstractDataProviderRecordIterator iter = users.searchRecords(NOTHING, {"limit": 5});
        int count = 0;
        while (iter.next()) {
            hash<auto> record = iter.getValue();
            assertTrue(record.hasKey("id"), "User should have 'id' field");
            assertTrue(record.hasKey("name"), "User should have 'name' field");
            ++count;
        }

        if (m_options.verbose) {
            printf("Listed %d users\n", count);
        }
        assertTrue(count > 0, "Should have at least one user");
    }

    #! Test listing extract refresh tasks
    private testListExtractRefreshTasks() {
        TableauDataProvider::TableauDataProvider prov(client);
        AbstractDataProvider tasks = prov.getChildProvider("extract-refresh-tasks");

        AbstractDataProviderRecordIterator iter = tasks.searchRecords(NOTHING, {"limit": 5});
        int count = 0;
        while (iter.next()) {
            hash<auto> record = iter.getValue();
            assertTrue(record.hasKey("id"), "Task should have 'id' field");
            ++count;
        }

        if (m_options.verbose) {
            printf("Listed %d extract refresh tasks\n", count);
        }
        assertTrue(True, "List extract refresh tasks completed without error");
    }

    #! Test execute API call
    private testGenericApiCall() {
        TableauDataProvider::TableauDataProvider prov(client);
        AbstractDataProvider apiCall = prov.getChildProvider(AbstractDataProvider::GenericApiCallChildName);

        hash<auto> result = apiCall.doRequest({
            "method": "GET",
            "path": "projects",
        });

        assertEq(200, result.status, "API call should succeed");
        assertTrue(result.body.hasKey("projects"), "API call should return projects");
        if (m_options.verbose) {
            printf("Generic API call returned %d keys\n", result.body.size());
        }
    }

    #! Cleanup test data
    private cleanup() {
        if (testProjectId) {
            if (m_options.verbose) {
                printf("Cleaning up test project: %s\n", testProjectId);
            }
            try {
                TableauDataProvider::TableauDataProvider prov(client);
                AbstractDataProvider deleteAction = prov.getChildProvider("projects")
                    .getChildProvider("delete");
                deleteAction.doRequest({
                    "project_id": testProjectId,
                });
                if (m_options.verbose) {
                    printf("Test project deleted successfully\n");
                }
            } catch (hash<ExceptionInfo> ex) {
                if (m_options.verbose) {
                    printf("Warning: project cleanup failed: %s: %s\n", ex.err, ex.desc);
                }
            }
        }
    }

    #! Requests against a local server
    localServerTests() {
        HttpServer server(<HttpServerOptionInfo>{
            "logger": new Logger("server", LoggerLevel::getLevelError()),
        });
        on_exit server.stop();
        int port = server.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        FakeTableauHandler handler();
        server.setHandler("tableau", "", NOTHING, handler);
        server.setDefaultHandler("tableau", handler);

        LocalTableauRestClientIo rest({
            "subdomain": "local",
            "token_name": "pat-name",
            "token_secret": "pat-secret",
            "content_url": "my-site",
        }, "http://localhost:" + port);
        assertNothing(rest.getSiteLuid());
        TableauDataProvider::TableauDataProvider provider({"tableaurestclient": rest});
        AbstractDataProvider projects = provider.getChildProviderEx("projects");

        # the client signs in with the PAT, then sends the request for the site with the session token
        list<hash<auto>> recs = map $1, projects.searchRecords();
        assertEq(({"id": "p1", "name": "Default"},), recs);
        assertEq(2, handler.requests.size());
        assertEq("POST", handler.requests[0].method);
        assertEq("api/3.27/auth/signin", handler.requests[0].path);
        assertEq({
            "personalAccessTokenName": "pat-name",
            "personalAccessTokenSecret": "pat-secret",
            "site": {"contentUrl": "my-site"},
        }, handler.requests[0].body.credentials);
        assertEq("GET", handler.requests[1].method);
        assertEq("api/3.27/sites/site-1/projects?pageSize=100&pageNumber=1", handler.requests[1].path);
        assertEq("session-1", handler.requests[1].auth);
        assertEq("site-1", rest.getSiteLuid());

        # the session is reused; a POST request sends the body
        handler.requests = ();
        hash<auto> project = provider.getChildProviderPath("projects/create").doRequest({"name": "New"});
        assertEq({"id": "p2", "name": "New"}, project);
        assertEq(1, handler.requests.size());
        assertEq("POST", handler.requests[0].method);
        assertEq("api/3.27/sites/site-1/projects", handler.requests[0].path);
        assertEq("session-1", handler.requests[0].auth);
        assertEq({"project": {"name": "New"}}, handler.requests[0].body);

        # an expired session is renewed and the request is retried once
        handler.requests = ();
        handler.expire_session = 1;
        recs = map $1, projects.searchRecords();
        assertEq(({"id": "p1", "name": "Default"},), recs);
        assertEq(("GET", "POST", "GET"), (map $1.method, handler.requests));
        assertEq("api/3.27/auth/signin", handler.requests[1].path);
        assertEq("session-2", handler.requests[2].auth);

        # a rate-limited request is retried after the time given by the server
        handler.requests = ();
        handler.rate_limited = 1;
        recs = map $1, projects.searchRecords();
        assertEq(({"id": "p1", "name": "Default"},), recs);
        assertEq(2, handler.requests.size());
        assertEq("session-2", handler.requests[1].auth);

        # an error response is raised with the response
        try {
            provider.getChildProviderEx("users").searchRecords(NOTHING, {"user_id": "missing"});
            assertTrue(False, "no exception");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("REST-RESPONSE-ERROR", ex.err);
            assertEq(404, ex.arg.status_code);
            assertEq("404002", ex.arg.body.error.code);
        }

        # a session that cannot be renewed raises the authentication error
        handler.requests = ();
        handler.expire_session = 2;
        try {
            projects.searchRecords();
            assertTrue(False, "no exception");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("REST-RESPONSE-ERROR", ex.err);
            assertEq(401, ex.arg.status_code);
        }
        assertEq(("GET", "POST", "GET"), (map $1.method, handler.requests));
    }
}
