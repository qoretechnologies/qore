#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires HttpServer
%requires HttpServerUtil
%requires ServerSentEventHandler

%exec-class SseHandlerCredentialsTest

#! The connection of a server-sent event handler of restricted code gets the request without its credentials
#! (qore#7303)
/** The HTTP server sets up the event stream of a handler with the request (ServerSentEventHandler::getConnectionImpl());
    a handler of restricted code gets it without the credentials of the request, a trusted handler as before
*/

#! a hang guard only, never a timing assertion
const HangGuard = 20s;

class SseHandlerCredentialsTest inherits QUnit::Test {
    public {
        #! the tenant's handler: records what the setup of its connection saw of the credentials of the request
        const TenantSource = "%modern
%requires ServerSentEventHandler
class TenantSseHandler inherits ServerSentEventHandler {
    private { Queue seen; }
    constructor(Queue seen) : ServerSentEventHandler() {
        self.seen = seen;
    }
    ServerSentEventConnection getConnectionImpl(Socket sock, hash<auto> cx, hash<auto> hdr, string cid) {
        seen.push(sprintf(\"authorization=%y cookie=%y cx.auth=%y cx.hdr.authorization=%y\", exists hdr.authorization,
            exists hdr.cookie, exists cx.auth, exists cx.hdr.authorization));
        return ServerSentEventHandler::getConnectionImpl(sock, cx, hdr, cid);
    }
}
ServerSentEventHandler sub get_handler(Queue seen) {
    return new TenantSseHandler(seen);
}
";

        #! what a handler gets without the credentials of the request
        const Filtered = "authorization=False cookie=False cx.auth=False cx.hdr.authorization=False";
    }

    constructor() : Test("SseHandlerCredentialsTest", "1.0", \ARGV) {
        addTestCase("the connection of an SSE handler of restricted code", \restrictedTest());
        addTestCase("the connection of a trusted SSE handler", \trustedTest());
        set_return_value(main());
    }

    #! returns the tenant's Program with the given sandbox
    private Program getTenant(*SandboxManager sm) {
        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        if (sm) {
            p.setSandboxManager(sm);
        }
        p.parse(TenantSource, "tenant");
        return p;
    }

    #! opens an event stream with credentials; returns what the handler's connection saw
    private string open(Program p) {
        Queue seen();
        ServerSentEventHandler handler = p.callFunction("get_handler", seen);
        HttpServer server(<HttpServerOptionInfo>{});
        on_exit server.stop();
        server.setDefaultHandler("sse", handler);
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        server.waitForAsyncIo();
        Socket c();
        c.connect("127.0.0.1:" + port, HangGuard);
        on_exit c.close();
        c.send("GET /sse HTTP/1.1\r\nHost: localhost\r\nAccept: text/event-stream\r\n"
            "Authorization: Bearer secret\r\nCookie: session=secret\r\n\r\n");
        hash<auto> h = c.readHTTPHeader(HangGuard);
        assertEq(200, h.status_code, "the event stream is opened");
        return seen.get(HangGuard);
    }

    restrictedTest() {
        # the default sandbox does not trust its code
        assertEq(Filtered, open(getTenant(new SandboxManager())));
    }

    trustedTest() {
        assertEq("authorization=True cookie=True cx.auth=True cx.hdr.authorization=True", open(getTenant()));
    }
}
