#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%allow-injection

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Logger
%requires ConnectionProvider
%requires DataProvider
%requires ChromaDataProvider

%exec-class ChromaDataProviderTest

class FakeChromaRestClientIo inherits RestClientIo::RestClientIo {
    public {
        *hash<auto> last_request;
        string last_method;
        string last_path;
        hash<auto> response_body;
    }
    constructor() : RestClientIo({"url": "http://localhost:8000"}) {}

    hash<RestClient::RestResponseInfo> restDoRequest(string method, string path,
            auto body, *hash<auto> hdr) {
        last_method = method;
        last_path = path;
        last_request = body;
        return <RestClient::RestResponseInfo>{"body": response_body};
    }
    hash<RestClient::RestResponseInfo> restGet(string path, *hash<auto> hdr) {
        return restDoRequest("GET", path, NOTHING, hdr);
    }
    hash<RestClient::RestResponseInfo> restPost(string path, auto body, *hash<auto> hdr) {
        return restDoRequest("POST", path, body, hdr);
    }
    hash<RestClient::RestResponseInfo> restDel(string path, auto body, *hash<auto> hdr) {
        return restDoRequest("DELETE", path, body, hdr);
    }
    string getSafeUrl() { return "http://localhost:8000"; }
}

public class ChromaDataProviderTest inherits QUnit::Test {
    public {
        const MyOpts = Opts + {
            "conn": "c,connection=s",
        };

        const OptionColumn = 22;
    }

    private {
        *string conn_name;
    }

    constructor() : Test("ChromaDataProvider Test", "1.0", \ARGV, MyOpts) {
        conn_name = m_options.conn ?? ENV.CHROMA_CONNECTION;

        addTestCase("factory + app + action registered", \registrationTest());
        addTestCase("query hits tenant/database-scoped collection URL",
            \queryTest());

        # Live test requires a real Chroma connection AND a
        # `CHROMA_COLLECTION_ID` env var naming an existing Chroma
        # collection UUID — Chroma vector search must target an
        # already-populated collection whose embedding dimension
        # matches the supplied query vector.
        # Cost: Free (self-hostable).
        if (conn_name) {
            addTestCase("live: ping + vector-search (existing collection)",
                \liveChromaTest());
        }
        set_return_value(main());
    }

    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-c,--connection=ARG",
            "set the Chroma connection name; without it (and without the "
            "CHROMA_CONNECTION env var) the live test is skipped.  Also "
            "requires CHROMA_COLLECTION_ID naming an existing collection "
            "UUID.",
            OptionColumn);
    }

    private registrationTest() {
        DataProvider::AbstractDataProviderFactory f =
            DataProvider::DataProvider::getFactory("chroma");
        assertEq("chroma", f.getInfo().name);
        hash<DataProviderAppInfo> app =
            DataProvider::DataProviderActionCatalog::getApp("Chroma");
        assertEq("Chroma", app.name);
        assertEq("chroma", app.scheme);
        # filter out the framework-injected make-api-call action (covered by
        # GenericApiCallAutoInjection.qtest in RestClientDataProvider)
        list<hash<DataProviderActionInfo>> actions = select
            DataProvider::DataProviderActionCatalog::getActions("Chroma"),
            $1.action != AbstractDataProvider::GenericApiCallActionName;
        assertEq(1, actions.size());
        assertEq("vector-search", actions[0].action);
    }

    private queryTest() {
        FakeChromaRestClientIo fake();
        fake.response_body = {
            "ids": (("doc1", "doc2"),),
            "distances": ((0.1, 0.3),),
            "metadatas": (({"title": "A"}, {"title": "B"}),),
        };
        ChromaDataProvider::ChromaQueryDataProvider prov(fake);
        auto resp = prov.doRequest({
            "collection_id": "abc-uuid-123",
            "query_embeddings": ((0.1, 0.2, 0.3),),
            "n_results": 5,
        });
        assertEq("POST", fake.last_method);
        # default tenant/database used when not overridden
        assertEq(
            "/api/v2/tenants/default_tenant/databases/default_database/collections/abc-uuid-123/query",
            fake.last_path);
        # collection_id removed from body before send
        assertEq(NOTHING, fake.last_request.collection_id);
        assertEq(5, fake.last_request.n_results);
        assertEq("doc1", resp.ids[0][0]);
    }

    #! Exercises Chroma's live `/collections/{id}/query` endpoint
    /** Verifies the actual wire format against a running Chroma server.
        Requires both a connection name AND a `CHROMA_COLLECTION_ID` env
        var naming an existing collection.  Chroma rejects queries whose
        embedding dimension does not match the collection's stored
        vectors; the test assumes the user has aligned `CHROMA_QUERY_DIM`
        (default 5) to the collection's embedder.

        Cost: Free (self-hostable). Requires an existing Chroma collection
        with embeddings.
    */
    private liveChromaTest() {
        *string coll_id = ENV.CHROMA_COLLECTION_ID;
        if (!coll_id.val()) {
            testSkip("CHROMA_COLLECTION_ID env var must name an existing "
                "Chroma collection UUID");
        }

        AbstractConnection conn = get_connection(conn_name);
        hash<auto> ping = conn.ping(True);
        assertTrue(ping.ok, sprintf("Chroma connection ping failed: %s",
            ping.info ?? "no info"));

        AbstractDataProvider prov = conn.getDataProvider();
        AbstractDataProvider q = prov.getChildProvider("query");
        # Use a small 5-dim vector by default; users can override the
        # dimension by setting CHROMA_QUERY_DIM if their collection's
        # embedder requires a different size.
        int dim = (ENV.CHROMA_QUERY_DIM ?? "5").toInt();
        list<float> vec = map 0.1, xrange(dim);
        auto resp = q.doRequest({
            "collection_id": coll_id,
            "query_embeddings": (vec,),
            "n_results": 1,
        });
        # Chroma always returns an `ids` field (may be empty when the
        # collection has no documents) — the assertion verifies the
        # response shape rather than content
        assertTrue(exists resp.ids,
            "Chroma vector-search returned an ids field");
    }
}
