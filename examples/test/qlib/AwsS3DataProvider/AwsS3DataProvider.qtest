%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Mime
%requires DataProvider
%requires ConnectionProvider
%requires AwsRestClient
%requires AwsS3DataProvider

%exec-class AwsS3DataProviderTest

public class AwsS3DataProviderTest inherits QUnit::Test {
    public {
        #! the application name
        const App = AwsS3DataProvider::AppName;

        #! the action the framework injects into every app served by a REST connection
        const FrameworkAction = "make-api-call";

        #! command-line options
        const MyOpts = Opts + {
            "conn": "c,connection=s",
        };

        #! Width of the option column in the usage text
        const OptionColumn = 22;

        #! connection options sufficient to construct a connection without contacting AWS
        const TestConnOptions = {
            "aws_keyid": "AKIAIOSFODNN7EXAMPLE",
            "aws_secret": "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY",
            "aws_region": "eu-central-1",
        };
    }

    constructor() : Test("AwsS3DataProvider Test", "1.0", \ARGV, MyOpts) {
        addTestCase("connection construction", \connectionConstructionTest());
        addTestCase("connection scheme", \connectionSchemeTest());
        addTestCase("S3-compatible connection", \compatibleConnectionTest());
        addTestCase("action catalog", \actionCatalogTest());
        addTestCase("file API registration", \fileApiTest());
        addTestCase("reference data", \referenceDataTest());
        addTestCase("live connection", \liveConnectionTest());

        set_return_value(main());
    }

    #! The connection must be constructible without being given a URL
    /** Regression: the connection used to inject "aws_service" and "aws_s3" into its own option hash while
        removing both from its declared option set, so validation rejected them as unknown options and the
        connection could not be created at all
    */
    connectionConstructionTest() {
        # no URL is passed: Amazon serves every region at a well-known endpoint, so the URL is derived from the
        # region rather than asked for
        AwsS3RestConnection conn({
            "name": "s3-test",
            "desc": "test connection",
            "opts": TestConnOptions,
        });
        assertEq("s3", conn.getType());
        assertEq(App, conn.getAppName());
        assertEq(True, conn.hasDataProvider());
        # the stored URL carries the "s3" connection scheme: it is what the connection is rebuilt from, and a
        # URL stored as "https://" would be rebuilt as the generic HTTP connection instead
        assertEq("s3://s3.eu-central-1.amazonaws.com", conn.getSafeUrl(),
            "the endpoint is derived from the region");
        assertEq("https://s3.eu-central-1.amazonaws.com", conn.real_url,
            "the client still targets the real https endpoint");

        # the other constructor form ignores the URL it is given for the same reason
        AwsS3RestConnection conn2("s3-test-2", "test connection", "https://wrong.example.com", {},
            TestConnOptions);
        assertEq("s3://s3.eu-central-1.amazonaws.com", conn2.getSafeUrl());

        # the regional endpoint is used rather than the global one, which answers a request for a bucket in
        # another region with a redirect that has to be re-signed
        assertEq("s3://s3.us-east-1.amazonaws.com", AwsS3RestConnection::getRegionUrl("us-east-1"));
        assertEq(AwsS3RestConnection::DefaultUrl, AwsS3RestConnection::getRegionUrl(NOTHING));

        # neither option may appear in the connection's own options, since neither is a user-settable option
        assertEq(False, conn.getInfo().opts.hasKey("aws_service"));
        assertEq(False, conn.getInfo().opts.hasKey("aws_s3"));

        # ... but the client built from the connection must still be configured for S3; a wrong value here
        # signs requests for the wrong service and fails with an opaque signature mismatch
        *hash<auto> copts = conn.getConnectionOptions();
        assertEq("s3", copts.aws_service);
        assertEq(True, copts.aws_s3);
        assertEq("eu-central-1", copts.aws_region);

        AwsRestClient client = cast<AwsRestClient>(conn.get(False));
        assertEq("s3", client.getAwsService());
        assertEq("eu-central-1", client.getAwsRegion());

        # the application file API and the data provider must agree that this connection serves S3
        assertEq(False, conn.supportsFileLocations(),
            "an application connection leaves file locations to its application's file API");
    }

    connectionSchemeTest() {
        *hash<ConnectionSchemeInfo> scheme = ConnectionSchemeCache::getScheme("s3");
        assertTrue(exists scheme, "the s3 scheme is registered");
        assertEq("aws_keyid,aws_secret,aws_region", scheme.required_options);
        # both are pinned by the connection and must not be offered as options
        assertEq(False, scheme.options.hasKey("aws_service"));
        assertEq(False, scheme.options.hasKey("aws_s3"));
        # the user is never asked for a URL; it is derived from the region
        assertEq(True, scheme.auto_url, "the Amazon S3 connection supplies its own URL");
        # path-style is the only mode the module implements, so it is not offered as a choice here
        assertEq(False, scheme.options.hasKey("path_style"));

        # the region must be a picker rather than a free-text field with no guidance
        assertTrue(scheme.options.aws_region.allowed_values.size() > 20,
            "the AWS regions are offered as allowed values");
        assertEq("us-east-1", scheme.options.aws_region.default_value);
        # ... but AWS adds regions, so one that is not listed must still be accepted
        assertEq(True, scheme.options.aws_region.allowed_values_creatable);
        foreach string region in (("us-east-1", "eu-central-1", "ap-southeast-2", "sa-east-1")) {
            assertTrue(inlist(region, (map $1.value, scheme.options.aws_region.allowed_values)),
                sprintf("region %y is offered", region));
        }
        # every allowed value needs a display name, or the picker shows raw region codes
        foreach hash<AllowedValueInfo> v in (scheme.options.aws_region.allowed_values) {
            assertTrue(v.display_name.val(), sprintf("region %y has a display name", v.value));
            assertTrue(v.desc.val(), sprintf("region %y has a description", v.value));
        }

        assertEq("s3", (new AwsS3DataProviderFactory()).getName());
    }

    #! S3-compatible services are a separate connection type, since they need a URL of their own
    compatibleConnectionTest() {
        *hash<ConnectionSchemeInfo> scheme = ConnectionSchemeCache::getScheme("s3compatible");
        assertTrue(exists scheme, "the s3compatible scheme is registered");
        assertEq("S3-Compatible Storage", scheme.display_name);
        # a service that is not Amazon is reached at a URL of its own, so one must be given
        assertEq(False, scheme.auto_url, "an S3-compatible connection needs a URL");
        assertEq("aws_keyid,aws_secret", scheme.required_options);
        # the region is whatever the service was configured with, so it must not be restricted to AWS regions
        assertEq(NOTHING, scheme.options.aws_region.allowed_values,
            "the region is free-form for a service that is not Amazon");
        assertEq("us-east-1", scheme.options.aws_region.default_value);
        # most S3-compatible services require path-style addressing, so it is offered here
        assertTrue(scheme.options.hasKey("path_style"));
        assertEq(True, scheme.options.path_style.default_value);
        assertEq(False, scheme.options.hasKey("aws_service"));
        assertEq(False, scheme.options.hasKey("aws_s3"));

        AwsS3CompatibleRestConnection conn("minio-test", "test connection", "https://minio.example.com:9000", {}, {
            "aws_keyid": "minioadmin",
            "aws_secret": "minioadmin",
        });
        assertEq("s3compatible", conn.getType());
        # an http(s) URL is stored under this connection's own scheme so that it survives a reload, while
        # still reaching the same host over the same protocol
        assertEq("s3compatibles://minio.example.com:9000", conn.getSafeUrl());
        assertEq("https://minio.example.com:9000", conn.real_url);
        assertEq("s3compatible://minio.example.com:9000",
            AwsS3CompatibleRestConnection::getStorageUrl("http://minio.example.com:9000"),
            "a plain-HTTP service keeps plain HTTP");
        # it serves the same application and the same actions as an Amazon S3 connection
        assertEq(App, conn.getAppName());
        assertEq(True, conn.hasDataProvider());
        *hash<auto> copts = conn.getConnectionOptions();
        assertEq("s3", copts.aws_service);
        assertEq(True, copts.aws_s3);
    }

    actionCatalogTest() {
        hash<DataProviderAppInfo> app = DataProviderActionCatalog::getAppEx(App);
        assertEq("AmazonS3", app.name);
        assertEq("s3", app.scheme);
        assertEq(MimeTypeSvg, app.logo_mime_type);
        assertTrue(app.logo.val(), "the logo was loaded from its file");

        # the root provider is built directly from an unconnected client, so that every action's own request
        # type can be compared against the options the catalog advertises for it
        AwsS3RestConnection conn("s3-test", "test connection", AwsS3RestConnection::DefaultUrl, {},
            TestConnOptions);
        AwsS3DataProvider::AwsS3DataProvider root({"restclient": conn.get(False)});

        hash<string, bool> children = map {$1: True}, keys AwsS3DataProvider::AwsS3DataProvider::DefaultChildMap;
        hash<string, bool> seen;
        int actions = 0;
        foreach hash<DataProviderActionInfo> action in (DataProviderActionCatalog::getActionsEx(App)) {
            if (action.action == FrameworkAction) {
                continue;
            }
            ++actions;
            string path = action.path;
            path =~ s/^\///;
            seen{path} = True;
            # an action path that does not resolve through the root ChildMap leaves the action's provider null:
            # reference data returns nothing and doRequest() is never reached, with no error anywhere
            assertTrue(children{path}, sprintf("action %y path %y resolves through the root ChildMap",
                action.action, action.path));
            assertTrue(exists action.output_type, sprintf("action %y has an output type", action.action));
            assertTrue(action.short_desc.length() < 80, sprintf("action %y short_desc is under 80 chars",
                action.action));

            # an action whose request type has fields must advertise options for them, or it renders with no
            # form fields and cannot be used; an action that genuinely takes no input needs none
            *AbstractDataProvider dp = root.getChildProvider(path);
            assertTrue(exists dp, sprintf("action %y has a child provider", action.action));
            *AbstractDataProviderType rt = dp.getRequestType();
            int fields = rt ? rt.getFields().size() : 0;
            assertEq(fields > 0, action.options.size() > 0,
                sprintf("action %y advertises options if and only if its request type has fields (%d fields, "
                    "%d options)", action.action, fields, action.options.size()));
        }
        assertEq(children.size(), actions, "every child has a registered action and vice versa");
        assertEq((), keys (children - (keys seen)), "every child has a registered action");
    }

    fileApiTest() {
        *hash<DataProviderFileApiInfo> fapi = DataProviderActionCatalog::getAppFileApi(App);
        assertTrue(exists fapi, "the app registers a file API for conn:// locations");

        # the declared actions and options must exist, or the file API silently fails at use time
        hash<DataProviderActionInfo> read = DataProviderActionCatalog::getAppActionEx(App, fapi.read_action);
        assertTrue(exists read.options{fapi.read_path_option}, "the read path option exists on the read action");
        if (fapi.read_container_option.val()) {
            assertTrue(exists read.options{fapi.read_container_option},
                "the read container option exists on the read action");
        }
        if (fapi.write_action.val()) {
            hash<DataProviderActionInfo> write = DataProviderActionCatalog::getAppActionEx(App, fapi.write_action);
            assertTrue(exists write.options{fapi.write_path_option},
                "the write path option exists on the write action");
            assertTrue(exists write.options{fapi.write_data_option},
                "the write data option exists on the write action");
            if (fapi.write_container_option.val()) {
                assertTrue(exists write.options{fapi.write_container_option},
                    "the write container option exists on the write action");
            }
        }
    }
    #! Every option declaring reference data must have a provider that can supply it
    /** Regression: every action declares `"ref_data": "buckets"` on its bucket option, but the provider
        implemented no reference data at all, so the bucket picker was empty on every form - a silent UI
        failure with nothing in the logs
    */
    referenceDataTest() {
        AwsS3RestConnection conn("s3-test", "test connection", AwsS3RestConnection::DefaultUrl, {},
            TestConnOptions);
        AwsS3DataProvider::AwsS3DataProvider root({"restclient": conn.get(False)});

        *hash<string, bool> supported = root.getSupportedReferenceData();
        assertTrue(supported.buckets, "bucket reference data is offered");

        # collect every reference data type named by any action option, and require the provider to supply it
        hash<string, bool> wanted;
        foreach hash<DataProviderActionInfo> action in (DataProviderActionCatalog::getActionsEx(App)) {
            foreach hash<auto> opt in (action.options.iterator()) {
                if (opt.ref_data.val()) {
                    wanted{opt.ref_data} = True;
                }
            }
        }
        assertTrue(wanted.size() > 0, "at least one option declares reference data");
        foreach string type in (keys wanted) {
            assertTrue(supported{type}, sprintf("reference data %y declared by an option is supported", type));
        }

        # an unknown type yields nothing rather than raising
        assertEq(NOTHING, root.getReferenceData("no-such-reference-data"));
    }

    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-c,--connection=ARG", "set connection name for functional tests", OptionColumn);
    }

    #! Returns the connection named on the command line, or skips the test
    private *AbstractConnection getConnection() {
        *string conn_name = m_options.conn ?? ENV.AWS_S3_CONNECTION;
        if (!conn_name.val()) {
            testSkip("no connection specified; use -c,--connection=ARG or set AWS_S3_CONNECTION");
            return;
        }
        AbstractConnection conn = get_connection(conn_name);
        if (conn.getType() != "s3") {
            throw "OPTION-ERROR", sprintf("connection %y is type %y; expecting \"s3\"", conn_name,
                conn.getType());
        }
        return conn;
    }

    #! Exercises the connection against the live service
    liveConnectionTest() {
        *AbstractConnection conn = getConnection();
        if (!conn) {
            return;
        }

        hash<auto> ping = conn.ping(True);
        assertEq(True, ping.ok, sprintf("ping succeeded: %s", ping.info));

        AbstractDataProvider dp = conn.getDataProvider().getChildProvider("list-buckets");
        hash<auto> resp = dp.doRequest({});
        assertEq(NT_LIST, resp.buckets.typeCode(), "list-buckets returned a list");
        if (m_options.verbose > 0) {
            printf("list-buckets: %d buckets\n", resp.buckets.size());
            foreach auto e in (resp.buckets) {
                printf("  %y\n", e.name);
            }
        }
    }
}
