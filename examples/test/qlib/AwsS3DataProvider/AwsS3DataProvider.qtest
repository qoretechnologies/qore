%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Mime
%requires DataProvider
%requires ConnectionProvider
%requires AwsRestClient
%requires AwsS3DataProvider

%exec-class AwsS3DataProviderTest

#! One event delivered to an observer
hashdecl RecordedEvent {
    #! the event ID the source raised
    string id;
    #! the event data
    hash<auto> data;
}

#! Records every event raised, so that a watch cycle can be asserted against
class RecordingObserver inherits DataProvider::Observer {
    public {
        #! every event raised, oldest first
        list<hash<RecordedEvent>> events = ();
    }

    update(string event_id, hash<auto> data_) {
        events += <RecordedEvent>{"id": event_id, "data": data_};
    }
}

#! Answers S3 requests from a script of XML documents rather than reaching Amazon
class FakeAwsRestClient inherits AwsRestClient::AwsRestClient {
    public {
        #! response bodies to return, in order; the last one is reused once the list is exhausted
        list<string> bodies = ("",);

        #! every request path made, oldest first
        list<string> paths = ();

        #! the number of responses already handed out
        int served = 0;
    }

    constructor() : AwsRestClient(AwsS3DataProviderTest::TestConnOptions + {
        "url": "https://s3.eu-central-1.amazonaws.com",
        "aws_service": "s3",
        "aws_s3": True,
        "data": "bin",
    }, True) {
    }

    hash<auto> doRequest(string m, string path, auto body, *reference<hash<auto>> info,
            softbool decode_errors = True, *hash<auto> hdr) {
        paths += path;
        int i = served < bodies.size() ? served : bodies.size() - 1;
        ++served;
        return {"body": bodies[i], "hdr": {}};
    }
}

/** The watch providers run their cycle on a background thread on a timer, which is neither fast nor
    deterministic to test through. \c pollOnce() is the cycle itself, and is \c private -- which in %Qore means
    accessible to a subclass -- so this exposes it and drives one cycle at a time from the test.
*/
class TestObjectWatch inherits AwsS3DataProvider::AwsS3WatchObjectsDataProvider {
    constructor(*hash<auto> options) : AwsS3WatchObjectsDataProvider(options) {}
    #! Runs one polling cycle
    poll() { pollOnce(); }
}

class TestBucketWatch inherits AwsS3DataProvider::AwsS3WatchNewBucketDataProvider {
    constructor(*hash<auto> options) : AwsS3WatchNewBucketDataProvider(options) {}
    #! Runs one polling cycle
    poll() { pollOnce(); }
}

public class AwsS3DataProviderTest inherits QUnit::Test {
    public {
        #! the application name
        const App = AwsS3DataProvider::AppName;

        #! the action the framework injects into every app served by a REST connection
        const FrameworkAction = "make-api-call";

        #! command-line options
        const MyOpts = Opts + {
            "conn": "c,connection=s",
        };

        #! Width of the option column in the usage text
        const OptionColumn = 22;

        #! connection options sufficient to construct a connection without contacting AWS
        const TestConnOptions = {
            "aws_keyid": "AKIAIOSFODNN7EXAMPLE",
            "aws_secret": "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY",
            "aws_region": "eu-central-1",
        };
    }

    constructor() : Test("AwsS3DataProvider Test", "1.0", \ARGV, MyOpts) {
        addTestCase("connection construction", \connectionConstructionTest());
        addTestCase("connection scheme", \connectionSchemeTest());
        addTestCase("S3-compatible connection", \compatibleConnectionTest());
        addTestCase("action catalog", \actionCatalogTest());
        addTestCase("file API registration", \fileApiTest());
        addTestCase("reference data", \referenceDataTest());
        addTestCase("event providers", \eventProviderTest());
        addTestCase("watch cycle", \watchCycleTest());
        addTestCase("presigned url", \presignedUrlTest());
        addTestCase("batch operations", \batchOperationsTest());
        addTestCase("encryption options", \encryptionOptionsTest());
        addTestCase("live connection", \liveConnectionTest());
        addTestCase("live presigned url", \livePresignedUrlTest());
        addTestCase("live object round trip", \liveObjectRoundTripTest());
        addTestCase("live record iterator", \liveRecordIteratorTest());

        set_return_value(main());
    }

    #! The connection must be constructible without being given a URL
    /** Regression: the connection used to inject "aws_service" and "aws_s3" into its own option hash while
        removing both from its declared option set, so validation rejected them as unknown options and the
        connection could not be created at all
    */
    connectionConstructionTest() {
        # no URL is passed: Amazon serves every region at a well-known endpoint, so the URL is derived from the
        # region rather than asked for
        AwsS3RestConnection conn({
            "name": "s3-test",
            "desc": "test connection",
            "opts": TestConnOptions,
        });
        assertEq("s3", conn.getType());
        assertEq(App, conn.getAppName());
        assertEq(True, conn.hasDataProvider());
        # the stored URL carries the "s3" connection scheme: it is what the connection is rebuilt from, and a
        # URL stored as "https://" would be rebuilt as the generic HTTP connection instead
        assertEq("s3://s3.eu-central-1.amazonaws.com", conn.getSafeUrl(),
            "the endpoint is derived from the region");
        assertEq("https://s3.eu-central-1.amazonaws.com", conn.real_url,
            "the client still targets the real https endpoint");

        # the other constructor form ignores the URL it is given for the same reason
        AwsS3RestConnection conn2("s3-test-2", "test connection", "https://wrong.example.com", {},
            TestConnOptions);
        assertEq("s3://s3.eu-central-1.amazonaws.com", conn2.getSafeUrl());

        # the regional endpoint is used rather than the global one, which answers a request for a bucket in
        # another region with a redirect that has to be re-signed
        assertEq("s3://s3.us-east-1.amazonaws.com", AwsS3RestConnection::getRegionUrl("us-east-1"));
        assertEq(AwsS3RestConnection::DefaultUrl, AwsS3RestConnection::getRegionUrl(NOTHING));

        # neither option may appear in the connection's own options, since neither is a user-settable option
        assertEq(False, conn.getInfo().opts.hasKey("aws_service"));
        assertEq(False, conn.getInfo().opts.hasKey("aws_s3"));

        # ... but the client built from the connection must still be configured for S3; a wrong value here
        # signs requests for the wrong service and fails with an opaque signature mismatch
        *hash<auto> copts = conn.getConnectionOptions();
        assertEq("s3", copts.aws_service);
        assertEq(True, copts.aws_s3);
        assertEq("eu-central-1", copts.aws_region);

        AwsRestClient client = cast<AwsRestClient>(conn.get(False));
        assertEq("s3", client.getAwsService());
        assertEq("eu-central-1", client.getAwsRegion());

        # Regression: the request target must reach the server exactly as signed.  Without this the HTTP client
        # percent-encodes the path again on the way out, turning a signed "%2F" into "%252F" on the wire, and
        # every request carrying a reserved character -- an object key with a space, a listing continuation
        # token -- was rejected as SignatureDoesNotMatch
        assertEq(True, client.getPreEncodedUrls(), "S3 request targets are sent pre-encoded");

        # Regression: "data" must be "bin".  S3 object content is raw bytes, and with the client left on its
        # JSON default every upload body was serialized into a JSON document, so objects were stored as a
        # quoted base64 string rather than as their content -- reads were unaffected, so only the bytes were
        # wrong and nothing looked broken
        assertEq("bin", copts.data, "S3 sends and receives raw bytes rather than JSON");


        # the application file API and the data provider must agree that this connection serves S3
        assertEq(False, conn.supportsFileLocations(),
            "an application connection leaves file locations to its application's file API");
    }

    connectionSchemeTest() {
        *hash<ConnectionSchemeInfo> scheme = ConnectionSchemeCache::getScheme("s3");
        assertTrue(exists scheme, "the s3 scheme is registered");
        assertEq("aws_keyid,aws_secret,aws_region", scheme.required_options);
        # both are pinned by the connection and must not be offered as options
        assertEq(False, scheme.options.hasKey("aws_service"));
        assertEq(False, scheme.options.hasKey("aws_s3"));
        # the user is never asked for a URL; it is derived from the region
        assertEq(True, scheme.auto_url, "the Amazon S3 connection supplies its own URL");
        # path-style is the only mode the module implements, so it is not offered as a choice here
        assertEq(False, scheme.options.hasKey("path_style"));

        # the region must be a picker rather than a free-text field with no guidance
        assertTrue(scheme.options.aws_region.allowed_values.size() > 20,
            "the AWS regions are offered as allowed values");
        assertEq("us-east-1", scheme.options.aws_region.default_value);
        # ... but AWS adds regions, so one that is not listed must still be accepted
        assertEq(True, scheme.options.aws_region.allowed_values_creatable);
        foreach string region in (("us-east-1", "eu-central-1", "ap-southeast-2", "sa-east-1")) {
            assertTrue(inlist(region, (map $1.value, scheme.options.aws_region.allowed_values)),
                sprintf("region %y is offered", region));
        }
        # every allowed value needs a display name, or the picker shows raw region codes
        foreach hash<AllowedValueInfo> v in (scheme.options.aws_region.allowed_values) {
            assertTrue(v.display_name.val(), sprintf("region %y has a display name", v.value));
            assertTrue(v.desc.val(), sprintf("region %y has a description", v.value));
        }

        assertEq("s3", (new AwsS3DataProviderFactory()).getName());
    }

    #! S3-compatible services are a separate connection type, since they need a URL of their own
    compatibleConnectionTest() {
        *hash<ConnectionSchemeInfo> scheme = ConnectionSchemeCache::getScheme("s3compatible");
        assertTrue(exists scheme, "the s3compatible scheme is registered");
        assertEq("S3-Compatible Storage", scheme.display_name);
        # a service that is not Amazon is reached at a URL of its own, so one must be given
        assertEq(False, scheme.auto_url, "an S3-compatible connection needs a URL");
        assertEq("aws_keyid,aws_secret", scheme.required_options);
        # the region is whatever the service was configured with, so it must not be restricted to AWS regions
        assertEq(NOTHING, scheme.options.aws_region.allowed_values,
            "the region is free-form for a service that is not Amazon");
        assertEq("us-east-1", scheme.options.aws_region.default_value);
        # most S3-compatible services require path-style addressing, so it is offered here
        assertTrue(scheme.options.hasKey("path_style"));
        assertEq(True, scheme.options.path_style.default_value);
        assertEq(False, scheme.options.hasKey("aws_service"));
        assertEq(False, scheme.options.hasKey("aws_s3"));

        AwsS3CompatibleRestConnection conn("minio-test", "test connection", "https://minio.example.com:9000", {}, {
            "aws_keyid": "minioadmin",
            "aws_secret": "minioadmin",
        });
        assertEq("s3compatible", conn.getType());
        # an http(s) URL is stored under this connection's own scheme so that it survives a reload, while
        # still reaching the same host over the same protocol
        assertEq("s3compatibles://minio.example.com:9000", conn.getSafeUrl());
        assertEq("https://minio.example.com:9000", conn.real_url);
        assertEq("s3compatible://minio.example.com:9000",
            AwsS3CompatibleRestConnection::getStorageUrl("http://minio.example.com:9000"),
            "a plain-HTTP service keeps plain HTTP");
        # it serves the same application and the same actions as an Amazon S3 connection
        assertEq(App, conn.getAppName());
        assertEq(True, conn.hasDataProvider());
        *hash<auto> copts = conn.getConnectionOptions();
        assertEq("s3", copts.aws_service);
        assertEq(True, copts.aws_s3);
    }

    actionCatalogTest() {
        hash<DataProviderAppInfo> app = DataProviderActionCatalog::getAppEx(App);
        assertEq("AmazonS3", app.name);
        assertEq("s3", app.scheme);
        assertEq(MimeTypeSvg, app.logo_mime_type);
        assertTrue(app.logo.val(), "the logo was loaded from its file");

        # the root provider is built directly from an unconnected client, so that every action's own request
        # type can be compared against the options the catalog advertises for it
        AwsS3RestConnection conn("s3-test", "test connection", AwsS3RestConnection::DefaultUrl, {},
            TestConnOptions);
        AwsS3DataProvider::AwsS3DataProvider root({"restclient": conn.get(False)});

        hash<string, bool> children = map {$1: True}, keys AwsS3DataProvider::AwsS3DataProvider::DefaultChildMap;
        hash<string, bool> seen;
        int actions = 0;
        foreach hash<DataProviderActionInfo> action in (DataProviderActionCatalog::getActionsEx(App)) {
            if (action.action == FrameworkAction) {
                continue;
            }
            ++actions;
            string path = action.path;
            path =~ s/^\///;
            # the first segment must name a root child; an action path that does not resolve leaves the
            # action's provider null: reference data returns nothing and doRequest() is never reached, with no
            # error anywhere
            string root_child = (path =~ x/^([^\/]+)/)[0];
            seen{root_child} = True;
            assertTrue(children{root_child}, sprintf("action %y path %y resolves through the root ChildMap",
                action.action, action.path));
            assertTrue(exists action.output_type, sprintf("action %y has an output type", action.action));
            assertTrue(action.short_desc.length() < 80, sprintf("action %y short_desc is under 80 chars",
                action.action));

            # ... and the whole path must resolve, not just its first segment: an event action addresses a
            # provider nested under the events container
            *AbstractDataProvider dp = root.getChildProviderPath(path);
            assertTrue(exists dp, sprintf("action %y has a child provider", action.action));

            if (action.action_code == DPAT_EVENT) {
                # the event name the action advertises must be one the provider actually raises, or a trigger
                # configured from the catalog waits for an event that never arrives
                assertTrue(dp.getInfo().supports_observable,
                    sprintf("event action %y has an observable provider", action.action));
                assertTrue(exists dp.getEventTypes(){action.action_val},
                    sprintf("event action %y action_val %y is an event the provider raises", action.action,
                        action.action_val));
                continue;
            }

            if (action.action_code == DPAT_FIND) {
                # a find reads the provider as a record source, so it must have one, and every option it
                # advertises must exist in the provider's own search options -- an option the provider does
                # not declare is rejected as unknown the moment the action is used
                assertTrue(dp.getInfo().supports_read,
                    sprintf("find action %y has a record source", action.action));
                assertTrue(exists dp.getRecordType(),
                    sprintf("find action %y describes its records", action.action));
                hash<string, bool> search_opts = map {$1: True}, keys dp.getInfo().search_options;
                foreach string opt in (keys action.options) {
                    assertTrue(search_opts{opt},
                        sprintf("find action %y option %y exists in the provider's search options",
                            action.action, opt));
                }
                continue;
            }

            # an action whose request type has fields must advertise options for them, or it renders with no
            # form fields and cannot be used; an action that genuinely takes no input needs none
            *AbstractDataProviderType rt = dp.getRequestType();
            int fields = rt ? rt.getFields().size() : 0;
            assertEq(fields > 0, action.options.size() > 0,
                sprintf("action %y advertises options if and only if its request type has fields (%d fields, "
                    "%d options)", action.action, fields, action.options.size()));
        }
        assertEq((), keys (children - (keys seen)), "every child has a registered action");
    }

    #! The module must offer triggers, not only actions
    /** The TypeScript application being replaced had triggers for new buckets and new or updated files; a
        module that is 100% DPAT_API is a functional regression against it however complete its action list is.
    */
    eventProviderTest() {
        AwsS3RestConnection conn("s3-test", "test connection", AwsS3RestConnection::DefaultUrl, {},
            TestConnOptions);
        AwsS3DataProvider::AwsS3DataProvider root({"restclient": conn.get(False)});

        AbstractDataProvider events = root.getChildProviderEx("events");
        assertEq("events", events.getName());
        assertTrue(events.getInfo().children_can_support_observers,
            "the events container advertises observable children");
        assertEq(("new-bucket", "new-or-updated-file"), events.getChildProviderNames());
        assertEq(2, events.getChildProviderSummaryInfo().size(), "every event child has summary info");

        # the object watch has to be told which bucket to watch; the bucket watch covers the whole account
        hash<string, AbstractDataProvider> configured = {
            "new-bucket": new AwsS3WatchNewBucketDataProvider({"restclient": conn.get(False)}),
            "new-or-updated-file": new AwsS3WatchObjectsDataProvider({
                "restclient": conn.get(False),
                "bucket": "test-bucket",
            }),
        };

        foreach string name in (("new-bucket", "new-or-updated-file")) {
            AbstractDataProvider w = events.getChildProviderEx(name);
            assertEq(name, w.getName());
            assertTrue(w.getInfo().supports_observable, sprintf("%y is observable", name));
            hash<string, hash<DataProviderMessageInfo>> types = w.getEventTypes();
            assertEq((name,), keys types, sprintf("%y raises the event it is named for", name));
            assertTrue(types{name}.desc.val(), sprintf("%y describes its event", name));
            assertTrue(exists types{name}.type, sprintf("%y declares an event type", name));

            # example data must be produced without a working connection: the form that shows a trigger's
            # output fields is rendered before any credentials are exercised
            auto ex = configured{name}.getExampleEventData(name);
            assertEq(NT_HASH, ex.typeCode(), sprintf("%y provides example event data", name));
            # ... and it must match the declared type, or the field list the user maps against is wrong
            hash<string, AbstractDataField> fields = types{name}.type.getFields();
            foreach string f in (keys fields) {
                assertTrue(exists ex{f}, sprintf("%y example data has the declared field %y", name, f));
            }
        }

        # the object watch is scoped by bucket and prefix, so a change to either defines a different feed and
        # must not resume the previous cursor against a different set of objects
        AwsS3WatchObjectsDataProvider w1({"restclient": conn.get(False), "bucket": "a", "prefix": "p/"});
        AwsS3WatchObjectsDataProvider w2({"restclient": conn.get(False), "bucket": "b", "prefix": "p/"});
        assertNeq(w1.getWatchStreamIdentity(), w2.getWatchStreamIdentity(),
            "watching a different bucket is a different feed");
        # ... while the poll interval only changes how often the same feed is checked
        AwsS3WatchObjectsDataProvider w3({
            "restclient": conn.get(False),
            "bucket": "a",
            "prefix": "p/",
            "poll_interval": 300,
        });
        assertEq(w1.getWatchStreamIdentity(), w3.getWatchStreamIdentity(),
            "tuning the poll interval does not discard the cursor");
        assertEq(300, w3.getPollIntervalSeconds());
        # the minimum interval is enforced, since S3 charges per request
        AwsS3WatchObjectsDataProvider w4({"restclient": conn.get(False), "bucket": "a", "poll_interval": 1});
        assertEq(MinPollInterval, w4.getPollIntervalSeconds());

        # a watch with no bucket names the option to set rather than failing obscurely at the API
        AwsS3WatchObjectsDataProvider w5({"restclient": conn.get(False)});
        assertThrows("S3-WATCH-ERROR", "bucket", sub () { w5.getExampleEventData("new-or-updated-file"); });
    }

    fileApiTest() {
        *hash<DataProviderFileApiInfo> fapi = DataProviderActionCatalog::getAppFileApi(App);
        assertTrue(exists fapi, "the app registers a file API for conn:// locations");

        # the declared actions and options must exist, or the file API silently fails at use time
        hash<DataProviderActionInfo> read = DataProviderActionCatalog::getAppActionEx(App, fapi.read_action);
        assertTrue(exists read.options{fapi.read_path_option}, "the read path option exists on the read action");
        if (fapi.read_container_option.val()) {
            assertTrue(exists read.options{fapi.read_container_option},
                "the read container option exists on the read action");
        }
        if (fapi.write_action.val()) {
            hash<DataProviderActionInfo> write = DataProviderActionCatalog::getAppActionEx(App, fapi.write_action);
            assertTrue(exists write.options{fapi.write_path_option},
                "the write path option exists on the write action");
            assertTrue(exists write.options{fapi.write_data_option},
                "the write data option exists on the write action");
            if (fapi.write_container_option.val()) {
                assertTrue(exists write.options{fapi.write_container_option},
                    "the write container option exists on the write action");
            }
        }
    }
    #! Every option declaring reference data must have a provider that can supply it
    /** Regression: every action declares `"ref_data": "buckets"` on its bucket option, but the provider
        implemented no reference data at all, so the bucket picker was empty on every form - a silent UI
        failure with nothing in the logs
    */
    referenceDataTest() {
        AwsS3RestConnection conn("s3-test", "test connection", AwsS3RestConnection::DefaultUrl, {},
            TestConnOptions);
        AwsS3DataProvider::AwsS3DataProvider root({"restclient": conn.get(False)});

        *hash<string, bool> supported = root.getSupportedReferenceData();
        assertTrue(supported.buckets, "bucket reference data is offered");

        # collect every reference data type named by any action option, and require the provider to supply it
        hash<string, bool> wanted;
        foreach hash<DataProviderActionInfo> action in (DataProviderActionCatalog::getActionsEx(App)) {
            foreach hash<auto> opt in (action.options.iterator()) {
                if (opt.ref_data.val()) {
                    wanted{opt.ref_data} = True;
                }
            }
        }
        assertTrue(wanted.size() > 0, "at least one option declares reference data");
        foreach string type in (keys wanted) {
            assertTrue(supported{type}, sprintf("reference data %y declared by an option is supported", type));
        }

        # an unknown type yields nothing rather than raising
        assertEq(NOTHING, root.getReferenceData("no-such-reference-data"));
    }

    #! Drives the watch cycle itself, since a cycle that silently delivers nothing looks exactly like quiet
    /** A watch swallows and logs whatever its cycle raises, so a defect inside it produces no events and no
        error -- indistinguishable from a bucket in which nothing has changed.  The only way to tell the two
        apart is to run a cycle and assert on what was delivered.
    */
    watchCycleTest() {
        FakeAwsRestClient rest();
        RecordingObserver obs();
        TestObjectWatch w({"restclient": rest, "bucket": "b", "start_date": 2026-01-01Z});
        w.registerObserver(obs);

        # two objects, one older than the cursor and one newer
        rest.bodies = (
            '<?xml version="1.0" encoding="UTF-8"?>'
            '<ListBucketResult><IsTruncated>false</IsTruncated>'
            '<Contents><Key>old.txt</Key><Size>10</Size>'
            '<LastModified>2025-06-01T00:00:00.000Z</LastModified>'
            '<ETag>&quot;aaa&quot;</ETag><StorageClass>STANDARD</StorageClass></Contents>'
            '<Contents><Key>new.txt</Key><Size>20</Size>'
            '<LastModified>2026-06-01T00:00:00.000Z</LastModified>'
            '<ETag>&quot;bbb&quot;</ETag><StorageClass>STANDARD</StorageClass></Contents>'
            '</ListBucketResult>',
        );

        w.poll();
        assertEq(1, obs.events.size(), "only the object modified after the start date is reported");
        assertEq("new-or-updated-file", obs.events[0].id);
        assertEq("new.txt", obs.events[0].data.key);
        assertEq("b", obs.events[0].data.bucket);
        assertEq(20, obs.events[0].data.size);
        # the quotes S3 wraps an ETag in must be stripped, or every consumer has to do it
        assertEq("bbb", obs.events[0].data.etag);
        assertRegex("list-type=2", rest.paths[0], "the listing uses ListObjectsV2");
        assertRegex("^/b", rest.paths[0], "the bucket is addressed in the path");

        # the cursor advanced past the object delivered, so polling again reports nothing new
        w.poll();
        assertEq(1, obs.events.size(), "an object already delivered is not delivered again");

        # ... but an object modified after it is
        rest.bodies = (
            '<?xml version="1.0" encoding="UTF-8"?>'
            '<ListBucketResult><IsTruncated>false</IsTruncated>'
            '<Contents><Key>newer.txt</Key><Size>30</Size>'
            '<LastModified>2026-07-01T00:00:00.000Z</LastModified>'
            '<ETag>&quot;ccc&quot;</ETag><StorageClass>STANDARD</StorageClass></Contents>'
            '</ListBucketResult>',
        );
        rest.served = 0;
        w.poll();
        assertEq(2, obs.events.size(), "an object modified after the cursor is reported");
        assertEq("newer.txt", obs.events[1].data.key);

        # the prefix is applied by S3 rather than after the listing arrives, so it must reach the request
        FakeAwsRestClient rest2();
        rest2.bodies = ('<?xml version="1.0" encoding="UTF-8"?>'
            '<ListBucketResult><IsTruncated>false</IsTruncated></ListBucketResult>',);
        TestObjectWatch wp({"restclient": rest2, "bucket": "b", "prefix": "incoming/"});
        wp.poll();
        assertRegex("prefix=incoming", rest2.paths[0], "the prefix is sent to S3");

        # a bucket watch reports each bucket created after the start date
        FakeAwsRestClient rest3();
        rest3.bodies = ('<?xml version="1.0" encoding="UTF-8"?>'
            '<ListAllMyBucketsResult><Owner><ID>oid</ID><DisplayName>me</DisplayName></Owner><Buckets>'
            '<Bucket><Name>old-bucket</Name><CreationDate>2025-01-01T00:00:00.000Z</CreationDate></Bucket>'
            '<Bucket><Name>new-bucket</Name><CreationDate>2026-06-01T00:00:00.000Z</CreationDate></Bucket>'
            '</Buckets></ListAllMyBucketsResult>',);
        RecordingObserver bobs();
        TestBucketWatch bw({"restclient": rest3, "start_date": 2026-01-01Z});
        bw.registerObserver(bobs);
        bw.poll();
        assertEq(1, bobs.events.size(), "only the bucket created after the start date is reported");
        assertEq("new-bucket", bobs.events[0].id);
        assertEq("new-bucket", bobs.events[0].data.name);
        assertEq("oid", bobs.events[0].data.owner_id);
        assertEq("/", rest3.paths[0], "the bucket listing addresses the service root");

        # a single-element XML document must not be special-cased by callers: the parser returns one repeated
        # element as a hash and several as a list, which is exactly the shape a test with one object produces
        # and a production bucket does not
        FakeAwsRestClient rest4();
        rest4.bodies = ('<?xml version="1.0" encoding="UTF-8"?>'
            '<ListBucketResult><IsTruncated>false</IsTruncated>'
            '<Contents><Key>only.txt</Key><Size>1</Size>'
            '<LastModified>2026-06-01T00:00:00.000Z</LastModified></Contents></ListBucketResult>',);
        RecordingObserver sobs();
        TestObjectWatch ws({"restclient": rest4, "bucket": "b", "start_date": 2026-01-01Z});
        ws.registerObserver(sobs);
        ws.poll();
        assertEq(1, sobs.events.size(), "a listing holding one object is handled like any other");
        assertEq("only.txt", sobs.events[0].data.key);
    }

    #! A presigned URL is signed rather than requested, so its correctness is entirely in its construction
    /** Nothing is sent to Amazon S3 when one is made, so a mistake here produces a URL that looks perfectly
        plausible and is rejected only when someone finally uses it.
    */
    presignedUrlTest() {
        FakeAwsRestClient rest();
        AwsS3PresignedUrlDataProvider dp({"restclient": rest});

        hash<auto> r = dp.doRequest({
            "bucket": "b",
            "object_key": "dir/file name.txt",
            "method": "GET",
            "expiration_seconds": 900,
        });
        assertEq("GET", r.method);
        assertEq("b", r.bucket);
        assertEq("dir/file name.txt", r.object_key);
        # the caller must be told when the URL stops working; a URL with no stated expiry is a leak waiting
        assertTrue(r.expires > now_us(), "the expiry is in the future");
        assertTrue(r.expires <= now_us() + 900s, "the expiry matches the lifetime asked for");

        string url = r.url;
        # every parameter AWS requires must be present, or the URL is rejected as malformed rather than as
        # unauthorized -- which is a much more confusing failure
        foreach string param in (("X-Amz-Algorithm=AWS4-HMAC-SHA256", "X-Amz-Credential=", "X-Amz-Date=",
                "X-Amz-Expires=900", "X-Amz-SignedHeaders=host", "X-Amz-Signature=")) {
            assertRegex(param, url, sprintf("the URL carries %y", param));
        }
        # the credential scope must be encoded: AWS rebuilds the canonical query string to verify the
        # signature, and an unencoded "/" there is a signature mismatch
        assertRegex("X-Amz-Credential=[^&]*%2F", url, "the credential scope separators are encoded");
        assertRegex("/b/dir/file%20name\\.txt\\?", url, "the key is URI-encoded in the path");
        # the signature is a SHA-256 HMAC rendered as hex
        assertRegex("X-Amz-Signature=[0-9a-f]{64}(&|$)", url, "the signature is a hex SHA-256 HMAC");

        # a URL is signed for exactly one operation, so a different method must produce a different signature
        string put_url = dp.doRequest({
            "bucket": "b",
            "object_key": "dir/file name.txt",
            "method": "PUT",
            "expiration_seconds": 900,
        }).url;
        assertNeq(AwsS3DataProviderTest::getSignature(url), AwsS3DataProviderTest::getSignature(put_url),
            "a URL signed for PUT differs from one signed for GET");

        # ... and so must a different key, a different expiry, and different response overrides
        assertNeq(AwsS3DataProviderTest::getSignature(url),
            AwsS3DataProviderTest::getSignature(dp.doRequest({
                "bucket": "b", "object_key": "other.txt", "expiration_seconds": 900,
            }).url), "a URL for a different key differs");
        assertNeq(AwsS3DataProviderTest::getSignature(url),
            AwsS3DataProviderTest::getSignature(dp.doRequest({
                "bucket": "b", "object_key": "dir/file name.txt", "expiration_seconds": 60,
            }).url), "a URL with a different lifetime differs");

        # response overrides and a version ID are signed into the URL, not appended to it afterwards
        string over = dp.doRequest({
            "bucket": "b",
            "object_key": "f.txt",
            "version_id": "v1",
            "response_content_disposition": "attachment; filename=\"r.pdf\"",
        }).url;
        assertRegex("versionId=v1", over, "the version ID is in the URL");
        assertRegex("response-content-disposition=", over, "the content disposition is in the URL");

        # AWS refuses a lifetime beyond 7 days, so it is reported here rather than by a rejected URL later
        assertThrows("AWS-PRESIGN-ERROR", "7 days", sub () {
            dp.doRequest({"bucket": "b", "object_key": "f.txt", "expiration_seconds": 604801});
        });
        assertThrows("AWS-PRESIGN-ERROR", "positive", sub () {
            dp.doRequest({"bucket": "b", "object_key": "f.txt", "expiration_seconds": 0});
        });

        # no request is made: a presigned URL for an object that does not exist yet is exactly what an upload
        # URL is
        assertEq((), rest.paths, "creating a presigned URL contacts nothing");
    }

    #! Returns the signature from a presigned URL
    static string getSignature(string url) {
        return (url =~ x/X-Amz-Signature=([0-9a-f]+)/)[0];
    }

    #! The batch operations send XML documents, where an unescaped value is a malformed or altered request
    batchOperationsTest() {
        # an object key may contain "&" or "<", both ordinary characters in a key; unescaped, the first
        # produces a request that means something else and the second one the server rejects
        assertEq("a&amp;b&lt;c&gt;d", AwsS3ExtendedXml::escape("a&b<c>d"));
        assertEq("&quot;q&quot;&apos;", AwsS3ExtendedXml::escape("\"q\"'"));

        string body = AwsS3DeleteObjectsDataProvider::getDeleteBody(("a&b.txt", "c.txt"), False);
        assertRegex("<Object><Key>a&amp;b\\.txt</Key></Object>", body, "keys are escaped in the document");
        assertRegex("<Object><Key>c\\.txt</Key></Object>", body);
        assertEq(False, body =~ /<Quiet>/, "quiet mode is omitted when not asked for");
        assertRegex("<Quiet>true</Quiet>", AwsS3DeleteObjectsDataProvider::getDeleteBody(("a",), True));

        string tags = AwsS3PutObjectTaggingDataProvider::getTaggingBody({"p<": "v&"});
        assertRegex("<Tag><Key>p&lt;</Key><Value>v&amp;</Value></Tag>", tags,
            "tag names and values are both escaped");

        FakeAwsRestClient rest();
        AwsS3DeleteObjectsDataProvider dp({"restclient": rest});
        # AWS caps a batch at 1000 keys; exceeding it is reported here rather than as an opaque API error
        assertThrows("S3-DELETE-ERROR", "1000", sub () {
            dp.doRequest({
                "bucket": "b",
                "object_keys": (map sprintf("k%d", $1), xrange(0, MaxDeleteKeys + 1)),
            });
        });
        # ... and exactly the cap is accepted, since an off-by-one here would reject a legal batch
        rest.bodies = ('<?xml version="1.0" encoding="UTF-8"?><DeleteResult></DeleteResult>',);
        hash<auto> full = dp.doRequest({
            "bucket": "b",
            "object_keys": (map sprintf("k%d", $1), xrange(0, MaxDeleteKeys)),
        });
        assertEq(0, full.error_count, "a batch of exactly the maximum size is accepted");
        rest.served = 0;
        assertThrows("S3-DELETE-ERROR", "no object keys", sub () {
            dp.doRequest({"bucket": "b", "object_keys": ()});
        });

        # a batch delete can succeed as a request while refusing individual keys, so the failures must be
        # reported rather than the response being assumed empty
        rest.bodies = ('<?xml version="1.0" encoding="UTF-8"?><DeleteResult>'
            '<Deleted><Key>gone.txt</Key></Deleted>'
            '<Error><Key>locked.txt</Key><Code>AccessDenied</Code><Message>denied</Message></Error>'
            '</DeleteResult>',);
        hash<auto> r = dp.doRequest({"bucket": "b", "object_keys": ("gone.txt", "locked.txt")});
        assertEq(1, r.deleted_count);
        assertEq(1, r.error_count);
        assertEq("gone.txt", r.deleted[0].key);
        assertEq("locked.txt", r.errors[0].key);
        assertEq("AccessDenied", r.errors[0].code);
        assertRegex("delete", rest.paths[0], "the batch delete addresses the bucket's delete sub-resource");

        # tags come back as a hash rather than as the API's TagSet structure, so a caller can map them
        FakeAwsRestClient trest();
        trest.bodies = ('<?xml version="1.0" encoding="UTF-8"?><Tagging><TagSet>'
            '<Tag><Key>project</Key><Value>invoicing</Value></Tag>'
            '<Tag><Key>retention</Key><Value>7y</Value></Tag></TagSet></Tagging>',);
        hash<auto> t = (new AwsS3GetObjectTaggingDataProvider({"restclient": trest})).doRequest({
            "bucket": "b",
            "object_key": "k",
        });
        assertEq({"project": "invoicing", "retention": "7y"}, t.tags);

        # a single tag arrives as a hash rather than a list from the XML parser, and must not be special-cased
        trest.bodies = ('<?xml version="1.0" encoding="UTF-8"?><Tagging><TagSet>'
            '<Tag><Key>only</Key><Value>one</Value></Tag></TagSet></Tagging>',);
        trest.served = 0;
        t = (new AwsS3GetObjectTaggingDataProvider({"restclient": trest})).doRequest({
            "bucket": "b",
            "object_key": "k",
        });
        assertEq({"only": "one"}, t.tags, "a single tag is handled like any other");

        # versions and delete markers are reported separately: a delete marker is what hides an object, and
        # removing it is what brings the object back
        FakeAwsRestClient vrest();
        vrest.bodies = ('<?xml version="1.0" encoding="UTF-8"?><ListVersionsResult>'
            '<IsTruncated>true</IsTruncated><NextKeyMarker>k2</NextKeyMarker>'
            '<NextVersionIdMarker>v9</NextVersionIdMarker>'
            '<Version><Key>k</Key><VersionId>v2</VersionId><IsLatest>true</IsLatest><Size>10</Size>'
            '<LastModified>2026-06-01T00:00:00.000Z</LastModified><ETag>&quot;e&quot;</ETag></Version>'
            '<DeleteMarker><Key>d</Key><VersionId>v3</VersionId><IsLatest>true</IsLatest>'
            '<LastModified>2026-06-02T00:00:00.000Z</LastModified></DeleteMarker>'
            '</ListVersionsResult>',);
        hash<auto> v = (new AwsS3ListObjectVersionsDataProvider({"restclient": vrest})).doRequest({
            "bucket": "b",
        });
        assertEq(1, v.versions.size());
        assertEq("v2", v.versions[0].version_id);
        assertEq(True, v.versions[0].is_latest);
        assertEq("e", v.versions[0].etag, "the ETag quotes are stripped");
        assertEq(1, v.delete_markers.size());
        assertEq("d", v.delete_markers[0].key);
        assertEq(True, v.truncated);
        assertEq("k2", v.next_key_marker);
        assertEq("v9", v.next_version_id_marker);
        assertRegex("versions", vrest.paths[0], "the listing addresses the versions sub-resource");
    }

    #! Server-side encryption headers must be sent, and a KMS key only with a KMS scheme
    encryptionOptionsTest() {
        hash<auto> hdr = {};
        AwsS3UploadFileDataProvider::addEncryptionHeaders({}, \hdr);
        assertEq({}, hdr, "nothing is sent when no encryption was asked for");

        hdr = {};
        AwsS3UploadFileDataProvider::addEncryptionHeaders({"server_side_encryption": "AES256"}, \hdr);
        assertEq("AES256", hdr."x-amz-server-side-encryption");

        # a KMS key sent alongside AES256 is rejected by Amazon S3 rather than ignored, so it must not be sent
        hdr = {};
        AwsS3UploadFileDataProvider::addEncryptionHeaders({
            "server_side_encryption": "AES256",
            "kms_key_id": "alias/k",
        }, \hdr);
        assertEq(NOTHING, hdr."x-amz-server-side-encryption-aws-kms-key-id",
            "a KMS key is not sent with S3-managed encryption");

        hdr = {};
        AwsS3UploadFileDataProvider::addEncryptionHeaders({
            "server_side_encryption": "aws:kms",
            "kms_key_id": "alias/k",
        }, \hdr);
        assertEq("aws:kms", hdr."x-amz-server-side-encryption");
        assertEq("alias/k", hdr."x-amz-server-side-encryption-aws-kms-key-id");

        # the options must be reachable from the actions that write objects, or they cannot be used at all
        foreach string action in (("upload-file", "create-text-file")) {
            hash<DataProviderActionInfo> a = DataProviderActionCatalog::getAppActionEx(App, action);
            assertTrue(exists a.options.server_side_encryption,
                sprintf("%y offers server-side encryption", action));
            assertTrue(a.options.server_side_encryption.allowed_values.size() > 0,
                sprintf("%y declares the encryption schemes as allowed values", action));
        }
    }

    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-c,--connection=ARG", "set connection name for functional tests", OptionColumn);
    }

    #! Returns the connection named on the command line, or skips the test
    private *AbstractConnection getConnection() {
        *string conn_name = m_options.conn ?? ENV.AWS_S3_CONNECTION;
        if (!conn_name.val()) {
            testSkip("no connection specified; use -c,--connection=ARG or set AWS_S3_CONNECTION");
            return;
        }
        AbstractConnection conn = get_connection(conn_name);
        if (conn.getType() != "s3") {
            throw "OPTION-ERROR", sprintf("connection %y is type %y; expecting \"s3\"", conn_name,
                conn.getType());
        }
        return conn;
    }

    #! Proves a presigned URL against the live service, which is the only thing that can confirm the signature
    /** A signature can only be shown correct by Amazon accepting it: every mistake in query-string signing
        produces a URL that looks entirely plausible and fails when someone finally uses it.

        @note The request is issued over a plain TLS socket rather than through \c HTTPClient because the
        latter decodes the percent-escapes in the request target, and the credential scope in a presigned URL
        contains `%2F` separators that AWS re-encodes when it verifies the signature -- a decoded target is
        rejected as a malformed credential.  Sending the signed target verbatim is the point of the test.
    */
    livePresignedUrlTest() {
        *AbstractConnection conn = getConnection();
        if (!conn) {
            return;
        }
        AbstractDataProvider prov = conn.getDataProvider();

        # any object will do; the point is that the URL works without credentials
        hash<auto> listing = prov.getChildProviderEx("list-objects").doRequest({"max_keys": 1,
            "bucket": getLiveBucket(prov)});
        if (!listing.objects) {
            testSkip("the account's first bucket holds no objects to sign a URL for");
            return;
        }
        string bucket = getLiveBucket(prov);
        string key = listing.objects[0].key;

        hash<auto> r = prov.getChildProviderEx("presigned-url").doRequest({
            "bucket": bucket,
            "object_key": key,
            "method": "HEAD",
            "expiration_seconds": 300,
        });
        assertRegex("^https://", r.url, "the URL addresses the real endpoint");

        hash<UrlInfo> u = parse_url(r.url);
        Socket s();
        s.connectSSL(sprintf("%s:%d", u.host, u.port ?? 443), 30s);
        on_exit s.close();
        # no credentials of any kind are sent: the authorization is entirely in the URL
        s.send(sprintf("HEAD %s HTTP/1.1\r\nHost: %s\r\nConnection: close\r\n\r\n", u.path, u.host));
        string status = s.recv(64, 30s).toString();
        assertRegex("^HTTP/1\\.[01] 200 ", status,
            sprintf("Amazon S3 accepted the presigned URL: %y", (status =~ x/^([^\r\n]+)/)[0]));

        # a URL signed for one operation must not work for another, or it grants more than it says
        hash<auto> get_only = prov.getChildProviderEx("presigned-url").doRequest({
            "bucket": bucket,
            "object_key": key,
            "method": "GET",
            "expiration_seconds": 300,
        });
        hash<UrlInfo> gu = parse_url(get_only.url);
        Socket s2();
        s2.connectSSL(sprintf("%s:%d", gu.host, gu.port ?? 443), 30s);
        on_exit s2.close();
        s2.send(sprintf("DELETE %s HTTP/1.1\r\nHost: %s\r\nConnection: close\r\n\r\n", gu.path, gu.host));
        string dstatus = s2.recv(64, 30s).toString();
        assertRegex("^HTTP/1\\.[01] 40[0-9] ", dstatus,
            sprintf("a URL signed for GET is refused for DELETE: %y", (dstatus =~ x/^([^\r\n]+)/)[0]));
    }

    #! Writes an object and reads it back, which is the only way to see that it was stored intact
    /** Regression: nothing here ever round-tripped content.  The client's `data` option was applied so that it
        overrode whatever the caller asked for, leaving it on the JSON default, so **every object written
        through this module was serialized into a JSON document and stored as a quoted base64 string** rather
        than as its content.  Reads were unaffected, so a listing looked healthy and only the bytes were wrong.

        The key deliberately contains a space, a `+`, and an `&`.  All three are legal in an S3 key and all
        three must be percent-encoded in the request target; the signature covers that target, so an encoding
        that does not survive the trip to the wire fails as `SignatureDoesNotMatch`.

        This writes to the account under test; exclude it with `--exclude="live object round trip"`.
    */
    liveObjectRoundTripTest() {
        *AbstractConnection conn = getConnection();
        if (!conn) {
            return;
        }
        AbstractDataProvider prov = conn.getDataProvider();
        string bucket = getLiveBucket(prov);
        string stamp = sprintf("%d", now_us().durationMicroseconds());
        string key = sprintf("qore test %s/a+b c&d.txt", stamp);
        string content = "written by the Qore AwsS3DataProvider test suite";

        prov.getChildProviderEx("create-text-file").doRequest({
            "bucket": bucket,
            "object_key": key,
            "content": content,
        });
        on_exit {
            prov.getChildProviderEx("delete-object").doRequest({"bucket": bucket, "object_key": key});
        }

        hash<auto> got = prov.getChildProviderEx("download-file").doRequest({
            "bucket": bucket,
            "object_key": key,
        });
        assertEq(content, parse_base64_string(got.content).toString(),
            "the object holds exactly what was written");
        assertEq(content.size(), got.size, "the stored size matches the content, not a serialized form of it");

        # a binary upload must survive too: a JSON round trip would corrupt any byte that is not valid UTF-8
        string bin_key = sprintf("qore test %s/binary.dat", stamp);
        binary payload = binary(<0001020380818283fffefdfc>);
        prov.getChildProviderEx("upload-file").doRequest({
            "bucket": bucket,
            "object_key": bin_key,
            "file": {
                "name": "binary.dat",
                "content": make_base64_string(payload),
                "mime_type": "application/octet-stream",
            },
        });
        on_exit {
            prov.getChildProviderEx("delete-object").doRequest({"bucket": bucket, "object_key": bin_key});
        }
        hash<auto> gotbin = prov.getChildProviderEx("download-file").doRequest({
            "bucket": bucket,
            "object_key": bin_key,
        });
        assertEq(payload, parse_base64_string(gotbin.content), "binary content survives the round trip");

        # the key with reserved characters must also be findable by a listing under its prefix
        hash<auto> listing = prov.getChildProviderEx("list-objects").doRequest({
            "bucket": bucket,
            "prefix": sprintf("qore test %s/", stamp),
        });
        assertEq(2, listing.objects.size(), "both objects are listed under the prefix");
    }

    #! Reads a bucket as a record source, across a page boundary
    /** The point of the record source is that the caller never sees the pagination, so the test forces more
        than one page: `page_size` is set to `1`, which makes every object its own page.

        Regression: a continuation token contains characters needing percent-encoding, and the request target
        was being encoded a second time on the way to the wire, so the signature never matched and **no second
        page could ever be fetched** -- neither here nor through the `list-objects` action's own
        `continuation_token`.

        This only reads; it is safe against any account.
    */
    liveRecordIteratorTest() {
        *AbstractConnection conn = getConnection();
        if (!conn) {
            return;
        }
        AbstractDataProvider prov = conn.getDataProvider();
        string bucket = getLiveBucket(prov);
        AbstractDataProvider dp = prov.getChildProviderEx("list-objects");

        assertEq(True, dp.getInfo().supports_read, "the listing is also a record source");
        assertEq(True, dp.getInfo().has_record);
        assertTrue(exists dp.getRecordType().key, "the record type describes the object key");

        # one object per page, so anything past the first crosses a page boundary
        AbstractDataProviderRecordIterator i = dp.searchRecords(NOTHING, {
            "bucket": bucket,
            "page_size": 1,
        });
        list<auto> keys_read = ();
        while (i.next()) {
            keys_read += i.getValue().key;
        }

        # the same objects must be reachable through the action, which reads one page at a time
        hash<auto> one_page = dp.doRequest({"bucket": bucket, "max_keys": MaxKeys});
        list<auto> action_keys = map $1.key, one_page.objects;
        if (!one_page.truncated) {
            assertEq(action_keys, keys_read,
                "the record source returns the same objects as the action, across pages");
        } else {
            # a bucket larger than one page: the record source must have read past the action's first page
            assertTrue(keys_read.size() >= action_keys.size(),
                "the record source read at least as much as one page of the action");
        }
        if (m_options.verbose > 0) {
            printf("record source read %d objects from %y\n", keys_read.size(), bucket);
        }
    }

    #! Returns a bucket from the live account to exercise object operations against
    private string getLiveBucket(AbstractDataProvider prov) {
        hash<auto> buckets = prov.getChildProviderEx("list-buckets").doRequest({});
        if (!buckets.buckets) {
            throw "TEST-ERROR", "the account owns no buckets to test against";
        }
        return buckets.buckets[0].name;
    }

    #! Exercises the connection against the live service
    liveConnectionTest() {
        *AbstractConnection conn = getConnection();
        if (!conn) {
            return;
        }

        hash<auto> ping = conn.ping(True);
        assertEq(True, ping.ok, sprintf("ping succeeded: %s", ping.info));

        AbstractDataProvider dp = conn.getDataProvider().getChildProvider("list-buckets");
        hash<auto> resp = dp.doRequest({});
        assertEq(NT_LIST, resp.buckets.typeCode(), "list-buckets returned a list");
        if (m_options.verbose > 0) {
            printf("list-buckets: %d buckets\n", resp.buckets.size());
            foreach auto e in (resp.buckets) {
                printf("  %y\n", e.name);
            }
        }
    }
}
