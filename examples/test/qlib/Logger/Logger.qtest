#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - log file appenders: rotation and ring renames, archives, reopen, stderr output

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Logger

%exec-class Test

class ReentrantLoggerAppender inherits LoggerAppenderWithLayout {
    private {
        Logger m_logger;
        string m_seen;
    }

    constructor(Logger logger) : LoggerAppenderWithLayout("reentrant", new LoggerLayoutPattern("%m")) {
        m_logger = logger;
        m_seen = "";
    }

    processEventImpl(int type, auto params) {
        # Re-enter the owning logger while the appender is being called.  Logger must not hold its appender-list
        # lock while invoking appender methods.
        if (m_logger.getLevel().getValue() != LoggerLevel::INFO) {
            throw "LOGGER-TEST-ERROR", "unexpected logger level during reentrant appender callback";
        }
        m_seen += params;
    }

    string getSeen() {
        return m_seen;
    }
}

class Test inherits QUnit::Test {
    private {
        Counter m_counter();
        #! the lock of m_helper_ex
        Mutex m_helper_lock();
        #! the first exception raised in a helper thread (a failed assertion, for example), raised again in the test
        /** an exception in a background thread cannot fail the test case by itself: the test thread checks for it after
            the threads end (checkHelperThreads())
        */
        *hash<ExceptionInfo> m_helper_ex;
        #! the base name of the files and directories the test creates in the temporary directory
        /** unique for every run, so that runs on the same host, at the same time or after a run that left files
            behind, never use each other's files
        */
        string unique_name = sprintf("qore_logger_test_%d_%s", getpid(), get_random_string(8));
    }
    public {
    }

    constructor() : QUnit::Test("Logger", "1.0", \ARGV) {
        addTestCase("serialization", \testSerialization());
        addTestCase("LoggerLevel", \testLoggerLevel());
        addTestCase("LoggerEvent", \testLoggerEvent());
        addTestCase("LoggerLayout", \testLoggerLayout());
        addTestCase("LoggerFilter", \testLoggerFilter());
        addTestCase("LoggerAppender", \testLoggerAppender());
        addTestCase("LoggerAppenderQueue", \testLoggerAppenderQueue());
        addTestCase("LoggerAppenderQueueBackpressure", \testLoggerAppenderQueueBackpressure());
        addTestCase("LoggerAppenderMultiThread", \testLoggerAppenderMultiThread());
        addTestCase("LoggerAppenderMultiThreadUnassigned", \testLoggerAppenderMultiThreadUnassigned());
        addTestCase("LoggerAppenderReentrantCallbacks", \testLoggerAppenderReentrantCallbacks());
        addTestCase("LoggerAppenderFile", \testLoggerAppenderFile());
        addTestCase("LoggerAppenderStdErr", \testLoggerAppenderStdErr());
        addTestCase("LoggerAppenderFileRotate", \testLoggerAppenderFileRotate());
        addTestCase("LoggerAppenderFileRing", \testLoggerAppenderFileRing());
        addTestCase("LoggerAppenderFileArchive", \testLoggerAppenderFileArchive());
        addTestCase("LoggerAppenderFile lifecycle markers", \testLifecycleMarkers());
        addTestCase("LoggerSearchUtil", \testLoggerSearchUtil());
        addTestCase("LoggerSearchUtil scan budget", \testLoggerSearchScanBudget());
        addTestCase("LoggerSearchUtil v3 cursor", \testLoggerSearchV3Cursor());
        addTestCase("Logger", \testLogger());
        set_return_value(main());
    }

    testSerialization() {
        Logger l0();
        assertTrue(l0.getAdditivity());
        assertNothing(l0.getName());
        assertThrows("LOGGER-ERROR", \l0.getLevel());
        assertEq((), l0.getAppenders());
        Logger l1 = Serializable::deserialize(l0.serialize());
        l1 = Serializable::deserialize(l1.serialize());
        assertNothing(l1.getName());
        assertThrows("LOGGER-ERROR", \l1.getLevel());
        assertTrue(l1.getAdditivity());
        assertEq((), l0.getAppenders());

        LoggerLevel ll0 = Serializable::deserialize(LoggerLevel::LevelInfo.serialize());
        assertTrue(LoggerLevel::LevelInfo.isEqual(ll0));

        LoggerLevel ll1(550, "LOW");
        ll0 = Serializable::deserialize(ll1.serialize());
        assertTrue(ll1.isEqual(ll0));

        # the level and the parent of a logger are serialized with it: they are private:internal members of Logger,
        # which its serializer reads with the class (qore#6839)
        Logger parent("parent", LoggerLevel::getLevelWarn());
        Logger l2("child", LoggerLevel::getLevelDebug());
        l2.setParent(parent);
        Logger l3 = Serializable::deserialize(l2.serialize());
        assertEq("child", l3.getName());
        assertEq("DEBUG", l3.getLevel().getStr());
        assertEq("parent", l3.getParent().getName());
        assertEq("WARN", l3.getParent().getLevel().getStr());
    }

    testLoggerLevel() {
        hash lls = (
            'ALL':   LoggerLevel::ALL,
            'TRACE': LoggerLevel::TRACE,
            'DEBUG': LoggerLevel::DEBUG,
            'INFO':  LoggerLevel::INFO,
            'WARN':  LoggerLevel::WARN,
            'ERROR': LoggerLevel::ERROR,
            'FATAL': LoggerLevel::FATAL,
            'OFF':   LoggerLevel::OFF,
        );
        assertEq(LoggerLevel::getLevelAll().getStr(), 'ALL');
        assertEq(LoggerLevel::getLevelTrace().getStr(), 'TRACE');
        assertEq(LoggerLevel::getLevelDebug().getStr(), 'DEBUG');
        assertEq(LoggerLevel::getLevelInfo().getStr(), 'INFO');
        assertEq(LoggerLevel::getLevelWarn().getStr(), 'WARN');
        assertEq(LoggerLevel::getLevelError().getStr(), 'ERROR');
        assertEq(LoggerLevel::getLevelFatal().getStr(), 'FATAL');
        assertEq(LoggerLevel::getLevelOff().getStr(), 'OFF');
        LoggerLevel l1 = LoggerLevel::getLevelFatal();
        LoggerLevel l2 = LoggerLevel::getLevelError();
        assertTrue(l1.isGreaterOrEqual(l2));
        assertTrue(l1.isEqual(LoggerLevel::getLevelFatal()));
        assertTrue(l1.isEqual(l1));
        assertFalse(l1.isEqual(l2));

        foreach string s in (keys lls) {
            LoggerLevel ll1 = LoggerLevel::getLevel(s);
            assertEq(ll1.getValue(), lls{s});
            assertEq(ll1.getStr(), s);
            LoggerLevel ll2 = LoggerLevel::getLevel(lls{s});
            assertEq(ll2.getValue(), lls{s});
            assertEq(ll2.getStr(), s);
            assertTrue(ll1.isEqual(ll2));
            assertTrue(ll1.isGreaterOrEqual(ll2));
        }
    }

    testLoggerEvent() {
        LoggerEvent lle;
        date ts = LoggerEvent::getStartTime() + 1D;
        lle = new LoggerEvent('fqcn', 'ctg', LoggerLevel::getLevelError(), 'test: %d, %d', (1, 2), NOTHING, gettid(), ts, NOTHING);
        assertEq(lle.getFullQualifiedClassname(), 'fqcn');
        assertEq(lle.getCategoryName(), 'ctg');
        assertTrue(lle.getLevel().isEqual(LoggerLevel::getLevelError()));
        assertEq('test: 1, 2', lle.getMessage());
        assertEq(lle.getThreadId(), gettid());
        assertEq(lle.getTimeStamp(), ts);
        # get the duration to the same time on the next day; due to DST changes we cannot just add "1D"
        # as if we do, the test will fail twice a year, when the difference to the same time is 23 hours
        # or 25 hours
        date time_to_tomorrow = now();
        time_to_tomorrow = time_to_tomorrow + 1D - time_to_tomorrow;
        assertEq(lle.getRelativeTime(), time_to_tomorrow);

        Logger l('testLogger');
        lle = new LoggerEvent(l, LoggerLevel::getLevelError(), 'test: %d, %y, %d', (1, new LoggerEventParameter(\sprintf(), '%s:%s:%d:%y', 'A', 'B', 99, (3, 4)), 2));
        assertEq(lle.getFullQualifiedClassname(), get_class_name(l));
        assertEq(lle.getCategoryName(), 'testLogger');
        assertEq(lle.getLogger(), l);
        int id = lle.getUniqueId();
        assertTrue(id > 0);
        assertEq(id, lle.getUniqueId());
        assertEq('test: 1, "A:B:99:[3, 4]", 2', lle.getMessage());
    }

    testLoggerLayout() {
        LoggerLayoutPattern llp("");
        hash<CallStackInfo> csi();
        csi.file = "testfile";
        csi.source = "testsource";
        csi.line = 987;
        csi.function = "myfunction";
        hash<ExceptionInfo> ei();
        try {
            throw "TEST-ERROR", "Test exception";
        } catch (hash<ExceptionInfo> ex) {
            ei = ex;
        }
        LoggerEvent::setStartTime(2000-01-01T00:00:00);
        date ts = LoggerEvent::getStartTime() + 1D;
        LoggerEvent lle = new LoggerEvent('Logger', 'mylogger', LoggerLevel::getLevelError(), 'ABCDEF', (), csi, 123, ts, ei);
        hash patterns = (
            "": (
                "parsed": (),
                "output": "",
            ),
            "ABC": (
                "parsed": ("ABC",),
                "output": "ABC",
            ),
            "%%": (
                "parsed": ("%",),
                "output": "%",
            ),
            "%%%%%%": (
                "parsed": ("%%%",),
                "output": "%%%",
            ),
            "ABC%%": (
                "parsed": ("ABC%",),
                "output": "ABC%",
            ),
            "%%ABC": (
                "parsed": ("%ABC",),
                "output": "%ABC",
            ),
            "ABC%%D": (
                "parsed": ("ABC%D",),
                "output": "ABC%D",
            ),
            "%m": (
                "parsed": (("key": "m"),),
                "output": "ABCDEF",
            ),
            "%mGH": (
                "parsed": (("key": "mGH"),),
                "output": "ABCDEFGH",
            ),
            "%mGH{}": (
                "parsed": ((
                    "key": "mGH",
                    "option": "",
                ),),
                "error": "Unknown pattern token \"mGH\"",
            ),
            "%ZGH": (
                "parsed": (("key": "ZGH"),),
                "error": "Unknown pattern token \"ZGH\"",
            ),
            "%mmmm%m": (
                "parsed": (
                    ("key": "mmmm"),
                    ("key": "m"),
                ),
                "output": "ABCDEFmmmABCDEF",
            ),
            "%Z": (
                "parsed": (("key": "Z"),),
                "error": "Unknown pattern token \"Z\"",
            ),
            "%m{%DUMMY}": (
                "parsed": ((
                    "key": "m",
                    "option": "%DUMMY",
                ),),
                "output": "ABCDEF",
            ),
            "%5m{DUMMY}": (
                "parsed": ((
                    "key": "m",
                    "minWidth": 5,
                    "leftJustify": False,
                    "option": "DUMMY",
                ),),
                "output": "ABCDEF",
            ),
            "%10m{DUMMY}": (
                "parsed": ((
                    "key": "m",
                    "minWidth": 10,
                    "leftJustify": False,
                    "option": "DUMMY",
                ),),
                "output": "    ABCDEF",
            ),
            "%-10m{DUMMY}": (
                "parsed": ((
                    "key": "m",
                    "minWidth": 10,
                    "leftJustify": True,
                    "option": "DUMMY",
                ),),
                "output": "ABCDEF    ",
            ),
            "%.3m{DUMMY}": (
                "parsed": ((
                    "key": "m",
                    "maxWidth": 3,
                    "option": "DUMMY",
                ),),
                "output": "ABC",
            ),
            "%.10m{DUMMY}": (
                "parsed": ((
                    "key": "m",
                    "maxWidth": 10,
                    "option": "DUMMY",
                ),),
                "output": "ABCDEF",
            ),
            "%10.10m{DUMMY}": (
                "parsed": ((
                    "key": "m",
                    "minWidth": 10,
                    "maxWidth": 10,
                    "leftJustify": False,
                    "option": "DUMMY",
                ),),
                "output": "    ABCDEF",
            ),
            "%-10.10m{DUMMY}": (
                "parsed": ((
                    "key": "m",
                    "minWidth": 10,
                    "maxWidth": 10,
                    "leftJustify": True,
                    "option": "DUMMY",
                ),),
                "output": "ABCDEF    ",
            ),
            "%%%m%%": (
                "parsed": (
                    "%",
                    (
                        "key": "m",
                    ),
                    "%"
                ),
                "output": "%ABCDEF%",
            ),
            "%d": (
                "parsed": (("key": "d"),),
                "output": format_date(LoggerLayoutPattern::DEFAULT_DATE_FORMAT, lle.getTimeStamp()),
            ),
            "%F:%L %M": (
                "parsed": (
                    ("key": "F"),
                    ":",
                    ("key": "L"),
                    " ",
                    ("key": "M"),
                ),
                "output": csi.file+":"+string(csi.line)+" "+csi.function,
            ),
            "%d{DD.MM.YYYY HH:mm:SS}": (
                "parsed": (("key": "d", "option": "DD.MM.YYYY HH:mm:SS"),),
                "output": format_date("DD.MM.YYYY HH:mm:SS", lle.getTimeStamp()),
            ),

            "%c %c{XXX} %C%n": (
                "parsed": (
                    ("key": "c"),
                    " ",
                    ("key": "c", "option": "XXX"),
                    " ",
                    ("key": "C"),
                    ("key": "n"),
                ),
                "output": "mylogger mylogger Logger" + LoggerLayoutPattern::getLineDelimiter(),
            ),

            "%E{"+ENV.firstKey()+"}|%E{"+ENV.lastKey()+"}": (
                "parsed": (
                    ("key": "E", "option": ENV.firstKey()),
                    "|",
                    ("key": "E", "option": ENV.lastKey()),
                ),
                "output": ENV.firstValue()+"|"+ENV.lastValue(),
            ),

            "%r{%010d} [%t] %p %c - %m%n": (
                "parsed": (
                    ("key": "r", "option": "%010d"),
                    " [",
                    ("key": "t"),
                    "] ",
                    ("key": "p"),
                    " ",
                    ("key": "c"),
                    " - ",
                    ("key": "m"),
                    ("key": "n"),
                ),
                "output": "0086400000 [123] ERROR mylogger - ABCDEF"+LoggerLayoutPattern::getLineDelimiter(),
            ),
        );
        foreach string patt in (keys patterns) {
            on_error rethrow $1.err, sprintf("%s (pattern %y)", $1.desc, patt);
            llp.setPattern(patt);
            assertEq(patt, llp.getPattern());
            assertEq(patterns{patt}.parsed, llp.getParsedPattern());
            if (exists patterns{patt}.output) {
                assertEq(patterns{patt}.output, llp.format(lle));
            }
            if (exists patterns{patt}.error) {
                assertThrows("LOGGER-ERROR", patterns{patt}.error, \llp.format(), (lle));
            }
        }

        llp.setPattern("%x");
        assertTrue(exists lle.getThrowableInfo());
        assertRegex("TEST-ERROR: Test exception", llp.format(lle));

        llp.setPattern("%u");
        assertTrue(int(llp.format(lle)) > 0);

        hash patternsErr = (
            "%/AAA": "Invalid logger pattern starting at %/AAA",
            "%0-9c": "Invalid logger pattern option starting at %0-9c",
            "%%%": "Invalid logger pattern starting at %",
        );
        foreach string patt in (keys patternsErr) {
            assertThrows("LOGGER-ERROR", patternsErr{patt}, \llp.setPattern(), (patt));
        }
    }

    testLoggerFilter() {
        hash<CallStackInfo> csi();
        csi.file = "testfile";
        csi.source = "testsource";
        csi.line = 987;
        csi.function = "myfunction";
        LoggerEvent lle = new LoggerEvent('Logger', 'mylogger', LoggerLevel::getLevelError(), 'ABCDEF', (), csi, 123);
        LoggerFilterLevel lfl(); # INFO-OFF
        # max > min
        assertEq(LoggerLevel::getLevelInfo(), lfl.getMinLevel());
        assertEq(LoggerLevel::getLevelOff(), lfl.getMaxLevel());
        assertEq(LoggerFilter::NEUTRAL, lfl.eval(lle));
        lfl.setMinLevel(LoggerLevel::getLevelFatal());
        assertEq(LoggerFilter::DENY, lfl.eval(lle));
        lfl.setMinLevel(LoggerLevel::ERROR);
        assertEq(LoggerLevel::getLevelError(), lfl.getMinLevel());
        assertEq(LoggerFilter::NEUTRAL, lfl.eval(lle));
        lfl.setMaxLevel("ERROR");
        assertEq(LoggerLevel::getLevelError(), lfl.getMaxLevel());
        assertEq(LoggerFilter::NEUTRAL, lfl.eval(lle));
        lfl.setMinLevel("DEBUG");
        assertEq(LoggerLevel::getLevelDebug(), lfl.getMinLevel());
        assertEq(LoggerFilter::NEUTRAL, lfl.eval(lle));
        lfl.setMaxLevel(LoggerLevel::INFO);
        assertEq(LoggerLevel::getLevelInfo(), lfl.getMaxLevel());
        assertEq(LoggerFilter::DENY, lfl.eval(lle));
        # max < min
        lfl.setMaxLevel("DEBUG");
        lfl.setMinLevel("ERROR");
        assertEq(LoggerFilter::DENY, lfl.eval(lle));
        lfl.setMinLevel("INFO");
        assertEq(LoggerFilter::NEUTRAL, lfl.eval(lle));
        lfl.setMinLevel("OFF");
        lfl.setMaxLevel("ERROR");
        assertEq(LoggerFilter::DENY, lfl.eval(lle));
        lfl.setMaxLevel("FATAL");
        assertEq(LoggerFilter::NEUTRAL, lfl.eval(lle));

        LoggerFilterRegex lfr("^A", True);
        assertEq("^A", lfr.getRegex());
        assertTrue(lfr.getRegexResult());
        assertEq(LoggerFilter::NEUTRAL, lfr.eval(lle));
        lfr.setRegex("^A", False);
        assertFalse(lfr.getRegexResult());
        assertEq(LoggerFilter::DENY, lfr.eval(lle));
        lfr.setRegex("^B", False);
        assertEq("^B", lfr.getRegex());
        assertFalse(lfr.getRegexResult());
        assertEq(LoggerFilter::NEUTRAL, lfr.eval(lle));
        lfr.setRegex("^B", True);
        assertEq(LoggerFilter::DENY, lfr.eval(lle));

    }

    testLoggerAppender() {
        LoggerLayoutPattern llp("");
        llp.setPattern("%m");
        StringOutputStream sos();
        StreamWriter sw(sos);
        LoggerAppenderStream la("TEST", llp, sw);
        LoggerFilterLevel lfl(LoggerLevel::ERROR);
        LoggerFilterRegex lfr("^A");
        LoggerFilterRegex lfr2("DUMMY");
        LoggerEvent lle = new LoggerEvent('Logger', 'mylogger', LoggerLevel::getLevelError(), 'ABCDEF');
        assertEq("TEST", la.getName());
        assertFalse(la.isOpen());
        assertEq(llp, la.getLayout());
        assertEq(NOTHING, la.getQueue());
        la.open();
        assertTrue(la.isOpen());
        la.post(lle);
        assertEq("ABCDEF", sos.getData());
        # filter list test
        assertEq((), la.getFilters());
        la.addFilter(lfl);
        assertEq((lfl, ), la.getFilters());
        la.removeFilter(lfl);
        assertEq((), la.getFilters());
        la.addFilter(lfl);
        la.addFilter(lfr);
        assertEq((lfl, lfr), la.getFilters());
        assertThrows("LOGGER-ERROR", "Filter already exists in list", \la.addFilter(), (lfr));
        la.addFilter(lfr2, True);
        assertEq((lfr2, lfl, lfr), la.getFilters());
        la.removeFilter(lfl);
        assertEq((lfr2, lfr), la.getFilters());
        la.removeAllFilters();
        assertEq((), la.getFilters());
        la.addFilter(lfl);
        la.addFilter(lfr);
        la.post(lle);
        assertEq("ABCDEF", sos.getData());
        lfr.setRegex("^B");
        la.post(lle);
        assertEq("", sos.getData());
        la.removeFilter(lfr);
        assertEq((lfl, ), la.getFilters());
        la.post(lle);
        assertEq("ABCDEF", sos.getData());
    }

    testLoggerAppenderQueue() {
        StringOutputStream sos();
        StreamWriter sw(sos);
        LoggerAppenderStream la("TEST", new LoggerLayoutPattern("%m"), sw);
        LoggerEvent lle = new LoggerEvent('Logger', 'mylogger', LoggerLevel::getLevelError(), 'ABCDEF');
        assertFalse(la.isOpen());
        assertEq(NOTHING, la.getQueue());
        LoggerAppenderQueue laq = new LoggerAppenderQueue();
        la.setQueue(laq);
        assertEq(laq, la.getQueue());
        la.setQueue(NOTHING);
        assertEq(NOTHING, la.getQueue());
        la.setQueue(laq);
        la.open();
        assertTrue(la.isOpen());
        assertThrows("LOGGER-ERROR", "Appender is opened", \la.setQueue(), (laq,));
        la.post(lle);
        laq.process();
        assertEq("ABCDEF", sos.getData());
        la.close();
        laq.process(); # async close
        assertFalse(la.isOpen());
        la.setQueue(NOTHING);
        assertEq(NOTHING, la.getQueue());
        assertThrows("LOGGER-ERROR", "Cannot reopen stream", \la.open());
    }

    testLoggerAppenderQueueBackpressure() {
        # Test constructor with memory limit
        {
            LoggerAppenderQueue laq(1024);  # 1KB limit
            assertEq(1024, laq.maxBytes(), "maxBytes returns correct limit");
            assertEq(0, laq.currentBytes(), "currentBytes starts at 0");
            assertFalse(laq.isFull(), "isFull is false initially");
        }

        # Test constructor with default limit (0 = 10MB)
        {
            LoggerAppenderQueue laq(0);
            assertEq(10 * 1024 * 1024, laq.maxBytes(), "default limit is 10MB");
        }

        # Test constructor with unlimited (-1)
        {
            LoggerAppenderQueue laq(-1);
            assertEq(-1, laq.maxBytes(), "unlimited returns -1");
            assertFalse(laq.isFull(), "unlimited queue is never full");
        }

        # Test invalid constructor argument
        assertThrows("LOGGERAPPENDERQUEUE-ERROR", sub() { new LoggerAppenderQueue(-2); });

        # Test byte tracking with push
        {
            StringOutputStream sos();
            StreamWriter sw(sos);
            LoggerAppenderStream la("TEST", new LoggerLayoutPattern("%m"), sw);
            LoggerAppenderQueue laq(10000);  # 10KB limit
            la.setQueue(laq);
            la.open();

            # Push a small event
            LoggerEvent lle1 = new LoggerEvent('Logger', 'test', LoggerLevel::getLevelInfo(), 'short');
            assertTrue(la.post(lle1), "small event posted successfully");
            assertTrue(laq.currentBytes() > 0, "currentBytes increased after push");

            # Push a larger event with a bigger message
            string large_msg = strmul("x", 1000);
            LoggerEvent lle2 = new LoggerEvent('Logger', 'test', LoggerLevel::getLevelInfo(), large_msg);
            assertTrue(la.post(lle2), "larger event posted successfully");
            int bytes_after_large = laq.currentBytes();
            assertTrue(bytes_after_large > 1000, "currentBytes reflects large message size");

            # Process events and verify bytes decrease
            laq.process();
            assertTrue(laq.currentBytes() < bytes_after_large, "currentBytes decreased after processing");

            la.close();
            laq.process();  # Process close event
        }

        # Test drop behavior with negative timeout
        {
            StringOutputStream sos();
            StreamWriter sw(sos);
            LoggerAppenderStream la("TEST", new LoggerLayoutPattern("%m"), sw);
            LoggerAppenderQueue laq(100);  # Very small 100 byte limit
            la.setQueue(laq);
            la.open();

            # First event should succeed (queue is empty)
            string msg = strmul("y", 200);  # 200 byte message
            LoggerEvent lle = new LoggerEvent('Logger', 'test', LoggerLevel::getLevelInfo(), msg);
            assertTrue(la.post(lle), "first large event succeeds on empty queue");

            # Second event should be dropped with timeout=-1
            assertFalse(laq.push(la, LoggerAppender::EVENT_LOG, msg, -1ms),
                "event dropped with negative timeout when full");

            laq.process();
            la.close();
            laq.process();
        }

        # Test timeout behavior
        {
            StringOutputStream sos();
            StreamWriter sw(sos);
            LoggerAppenderStream la("TEST", new LoggerLayoutPattern("%m"), sw);
            LoggerAppenderQueue laq(100);  # Very small limit
            la.setQueue(laq);
            la.open();

            # Fill the queue
            string msg = strmul("z", 200);
            LoggerEvent lle = new LoggerEvent('Logger', 'test', LoggerLevel::getLevelInfo(), msg);
            la.post(lle);

            # Should timeout waiting for space
            assertThrows("QUEUE-TIMEOUT", sub() {
                laq.push(la, LoggerAppender::EVENT_LOG, msg, 50ms);
            });

            laq.process();
            la.close();
            laq.process();
        }

        # Test oversized entry (larger than max_bytes) when queue is empty
        {
            StringOutputStream sos();
            StreamWriter sw(sos);
            LoggerAppenderStream la("TEST", new LoggerLayoutPattern("%m"), sw);
            LoggerAppenderQueue laq(100);  # Very small 100 byte limit
            la.setQueue(laq);
            la.open();

            # Create a message much larger than the queue limit
            string large_msg = strmul("X", 500);  # 500 bytes, 5x the limit
            assertEq(500, large_msg.size());

            # Queue is empty, so oversized entry should be allowed to prevent deadlock
            assertTrue(laq.push(la, LoggerAppender::EVENT_LOG, large_msg, 0ms),
                "oversized entry allowed when queue is empty");
            assertTrue(laq.currentBytes() >= 500, "currentBytes reflects oversized entry");
            assertTrue(laq.isFull(), "queue is full after oversized entry");

            # Process the oversized entry
            laq.process();
            assertEq(0, laq.currentBytes(), "currentBytes back to 0 after processing");

            # Verify the message was written correctly
            assertEq(large_msg, sos.getData(), "oversized message processed correctly");

            la.close();
            laq.process();
        }
    }

    #! keeps the first exception of a helper thread
    private recordHelperFailure(hash<ExceptionInfo> ex) {
        AutoLock al(m_helper_lock);
        if (!m_helper_ex) {
            m_helper_ex = ex;
        }
    }

    #! returns True if a helper thread has failed
    private bool hasHelperFailure() {
        AutoLock al(m_helper_lock);
        return exists m_helper_ex;
    }

    #! fails the test case with the first exception of a helper thread, if any; called after the threads have ended
    private checkHelperThreads() {
        *hash<ExceptionInfo> ex;
        {
            AutoLock al(m_helper_lock);
            ex = remove m_helper_ex;
        }
        if (ex) {
            fail(sprintf("a helper thread failed: %s", get_exception_string(ex)));
        }
    }

    startPostThread(LoggerAppender la) {
        on_exit m_counter.dec();
        try {
            assertTrue(la.post(new LoggerEvent('Logger', 'e', LoggerLevel::getLevelError(), 'ABCDEF')));
        } catch (hash<ExceptionInfo> ex) {
            recordHelperFailure(ex);
        }
    }

    startProcessThread(LoggerAppenderStream la) {
        on_exit m_counter.dec();
        StringOutputStream sos = la.getStreamWriter().getOutputStream();
        try {
            int n = la.getQueue().size();
            sos.reassignThread();
            on_exit sos.unassignThread();
            la.getQueue().process();
            assertEq(n, sos.getData().split(",").size());
        } catch (hash<ExceptionInfo> ex) {
            recordHelperFailure(ex);
        }
    }

    testLoggerAppenderMultiThread() {
        LoggerLayoutPattern llp("");
        llp.setPattern("%m[%t]");
        StringOutputStream sos();
        StreamWriter sw(sos);
        LoggerAppenderStream la("TEST", llp, sw);
        la.setQueue(new LoggerAppenderQueue());
        la.open();
        assertFalse(la.hasAssignThread());

        m_counter.inc();
        int tid = background startPostThread(la);
        m_counter.waitForZero();
        checkHelperThreads();
        la.getQueue().process();
        assertEq(sprintf("ABCDEF[%d]", tid), sos.getData());

        llp.setPattern("%t,");
        int n = 200;
        list tids = ();
        while (n > 0) {
            m_counter.inc();
            push tids, background startPostThread(la);
            n--;
        }
        # ends when a helper has failed too, as a failed post can leave no data to wait for
        while ((m_counter.getCount() > 0 || !sos.hasData()) && !hasHelperFailure()) {
            la.getQueue().process(100ms);
        }
        m_counter.waitForZero();
        checkHelperThreads();
        # the loop ends when the last thread is done, but a thread can post its event after the last call above and
        # end before the loop checks the counter: every event is queued now, so the rest is processed here
        la.getQueue().process();
        list l2 = ();
        string ls = sos.getData();

        {
            on_error {
                printf("sos: %s\n", sos);
                printf("l2: %y\n", l2);
            }
            map (push l2, int($1)), (select ls.split(","), $1 != "");
            tids = sort(tids, int sub(int l, int h) {return l<=>h;});
            l2 = sort(l2, int sub(int l, int h) {return l<=>h;});
            assertEq(tids, l2);
        }

        llp.setPattern("%m,");
        n = 200;
        while (n > 0) {
            m_counter.inc();
            push tids, background startPostThread(la);
            n--;
        }
        m_counter.waitForZero();
        checkHelperThreads();
        m_counter.inc();
        # "external" stream thread manipulation
        sos.unassignThread();
        background startProcessThread(la);
        m_counter.waitForZero();
        checkHelperThreads();
        sos.reassignThread();  # for close()
    }

    testLoggerAppenderMultiThreadUnassigned() {
        StringOutputStream sos();
        sos.unassignThread();
        assertEq(-1, sos.getThreadId());
        StreamWriter sw(sos);
        LoggerAppenderStream la("TEST", new LoggerLayoutPattern("%m[%t]"), sw);
        la.setQueue(new LoggerAppenderQueue());
        assertTrue(la.hasAssignThread());
        la.open();

        m_counter.inc();
        int tid = background startPostThread(la);
        m_counter.waitForZero();
        checkHelperThreads();
        la.getQueue().process();

        sos.reassignThread(); # just to get value
        assertEq(sprintf("ABCDEF[%d]", tid), sos.getData());
        sos.unassignThread();
        assertEq(-1, sos.getThreadId());
        la.close();
    }

    testLoggerAppenderReentrantCallbacks() {
        Logger logger("reentrant-lock-test", LoggerLevel::INFO);
        ReentrantLoggerAppender appender(logger);
        logger.addAppender(appender);
        appender.open();
        on_exit appender.close();
        logger.info("callback-ok");
        assertEq("callback-ok", appender.getSeen());
    }

    testLoggerAppenderFile() {
        string fn = tmp_location() + DirSep + unique_name + ".log";
        unlink(fn);
        LoggerAppenderFile la1("TEST1", new LoggerLayoutPattern("%m"), fn);
        LoggerAppenderFile la("TEST", new LoggerLayoutPattern("%m"), fn);
        LoggerEvent lle1 = new LoggerEvent("Logger", "a", LoggerLevel::getLevelError(), "X");
        LoggerEvent lle = new LoggerEvent("Logger", "a", LoggerLevel::getLevelError(), "TEST");
        assertFalse(la.getFile().isOpen());
        la1.open();
        la.open();
        assertTrue(la.getFile().isOpen());
        assertEq(fn, la.getFile().getFileName());
        la.post(lle);
        la1.post(lle1);
        la.close();
        la1.close();
        assertFalse(la.getFile().isOpen());
        string s = ReadOnlyFile::readTextFile(fn);
        assertEq("TESTX", s);
        la.open();
        assertTrue(la.getFile().isOpen());
        la.post(lle);
        la.close();
        assertFalse(la.getFile().isOpen());
        s = ReadOnlyFile::readTextFile(fn);
        assertEq("TESTXTEST", s);
        unlink(fn);
    }

    testLoggerAppenderStdErr() {
        string fn = tmp_location() + DirSep + unique_name + ".log";
        File f();
        f.open2(fn, O_CREAT|O_WRONLY|O_TRUNC);
        on_exit unlink(fn);

        LoggerAppenderStdErr laso("STDERR", new LoggerLayoutPattern("%m"));
        LoggerEvent lle = new LoggerEvent("Logger", "a", LoggerLevel::getLevelError(), "STDTEST");
        stderr.redirect(f);
        stderr.setPos(0);
        laso.open();
        laso.post(lle);
        laso.close();
        stderr.redirect(stdout);  # TODO: redir back to real stderr, seems it is not possible so redir to stdout to see anything
        f.close();
        assertEq("STDTEST", ReadOnlyFile::readTextFile(fn));
    }

    testLoggerAppenderFileRotate() {
        string fn = DirSep + "%c-%C.log";
        LoggerAppenderFileRotate la("TEST", new LoggerLayoutPattern("%m"), fn, 3);
        assertEq(DirSep + "LoggerAppenderFileRotate-TEST.log", la.getFileName());
        assertEq(3, la.getCount());
        for (my int i = 1; i<=la.getCount(); i++) {
            assertEq(sprintf("%s.%d", la.getFileName(), i), la.getArchiveFileName(i));
        }
        la = new LoggerAppenderFileRotate("TEST", new LoggerLayoutPattern("%m"), fn, 3, "%p%i"+DirSep+"%f.%i.%n");
        for (my int i = 1; i<=la.getCount(); i++) {
            assertEq(sprintf("%s%d%sLoggerAppenderFileRotate-TEST.log.%d.%d", DirSep, i, DirSep, i, la.getCount()), la.getArchiveFileName(i));
        }
        code do_clean = sub (bool del_dir) {
            for (int i=1; i <= la.getCount(); i++) {
                string s = la.getArchiveFileName(i);
                unlink(s);
                if (del_dir && is_dir(dirname(s))) {
                    rmdir(dirname(s));
                }
            }
            unlink(la.getFileName());
        };
        fn = tmp_location() + DirSep + unique_name + ".log";
        la = new LoggerAppenderFileRotate("TEST", new LoggerLayoutPattern("%u"), fn, 3);
        do_clean(False);
        la.open();
        list prev = ();
        for (int i=0; i < 3*la.getCount(); i++) {
            LoggerEvent lle = new LoggerEvent("Logger", "a", LoggerLevel::getLevelError(), "TEST");
            la.post(lle);
            unshift prev, string(lle.getUniqueId());
            la.rotate();
            assertTrue(la.getFile().isOpen());
            for (int j=1; j <= la.getCount(); j++) {
                assertEq(j <= prev.size(), is_file(la.getArchiveFileName(j)));
                if (j <= prev.size()) {
                    string s2 = ReadOnlyFile::readTextFile(la.getArchiveFileName(j));
                    assertEq(prev[j-1], s2);
                }
            }
        }
        do_clean(False);

        # test rotation in subdirectory
        la = new LoggerAppenderFileRotate("TEST", new LoggerLayoutPattern("%u"), fn, 3, "%p"+unique_name+"-%i"+DirSep+"%f");
        do_clean(True);
        la.open();
        prev = ();
        for (int i=0; i < 3*la.getCount(); i++) {
            LoggerEvent lle = new LoggerEvent("Logger", "a", LoggerLevel::getLevelError(), "TEST");
            la.post(lle);
            unshift prev, string(lle.getUniqueId());
            la.rotate();
            assertTrue(la.getFile().isOpen());
            for (int j=1; j <= la.getCount(); j++) {
                string s = la.getArchiveFileName(j);
                assertEq(j <= prev.size(), is_dir(dirname(s)));
                assertEq(j <= prev.size(), is_file(s));
                if (j <= prev.size()) {
                    string s2 = ReadOnlyFile::readTextFile(s);
                    assertEq(prev[j-1], s2);
                }
            }
        }
        do_clean(True);
    }

    testLoggerAppenderFileRing() {
        string fn = "%c-%C-%i{%02d}-%n{%02d}.log";
        LoggerAppenderFileRing la("TEST", new LoggerLayoutPattern("%m"), fn, 50);
        assertEq(50, la.getCount());
        assertEq("LoggerAppenderFileRing-TEST-00-50.log", la.getFileName());

        int ringSize = 3;
        fn = tmp_location() + DirSep + unique_name + ".log.%i";
        string fn2 = fn;
        fn2 =~ s/%i/%d/;
        for (int i = 0; i < ringSize; i++) {
            unlink(sprintf(fn2, i));
        }
        la = new LoggerAppenderFileRing("TEST", new LoggerLayoutPattern("%u"), fn, ringSize);
        assertFalse(la.getFile().isOpen());
        assertEq(sprintf(fn2, 0), la.getFileName());
        la.open();
        assertTrue(la.getFile().isOpen());

        for (int rot = 0; rot < 3 * ringSize; rot++) {
            assertEq(sprintf(fn2, rot % ringSize), la.getFileName());
            string prevFilename = la.getFileName();
            LoggerEvent lle = new LoggerEvent("Logger", "a", LoggerLevel::getLevelError(), "TEST");
            la.post(lle);
            assertEq(rot % ringSize, la.getCurrentIndex());
            la.rotate();
            assertEq((rot+1)% ringSize, la.getCurrentIndex());
            assertEq(sprintf(fn2, (rot+1) % ringSize), la.getFileName());
            assertFalse(prevFilename == la.getFileName());
            assertTrue(la.getFile().isOpen());
            string s = ReadOnlyFile::readTextFile(prevFilename);
            assertEq(string(lle.getUniqueId()), s);
        }
        la.rotate();
        assertEq(sprintf(fn2, 1), la.getFileName());
        sleep(1200ms); # we need unique mtime
        la.post(new LoggerEvent("Logger", "a", LoggerLevel::getLevelError(), "TEST"));
        la.close();
        assertFalse(la.isOpen());
        assertFalse(la.getFile().isOpen());
        la.open();
        assertEq(sprintf(fn2, 1), la.getFileName()); # check the latest file is found
        la.close();
        for (int i = 0; i < ringSize; i++) {
            unlink(sprintf(fn2, i));
        }
    }

    testLoggerAppenderFileArchive() {
        LoggerAppenderFileArchive la("TEST", new LoggerLayoutPattern("%m"), "%c%s%C.log");
        assertEq("LoggerAppenderFileArchive"+DirSep+"TEST.log", la.getFileName());

        string fn = tmp_location() + DirSep + unique_name + ".log";
        unlink(fn);
        # Use a fixed archive pattern (without date) to test "Target file already exists" error
        # The default pattern "%p%f.%d" includes a timestamp which changes between calls
        la = new LoggerAppenderFileArchive("TEST", new LoggerLayoutPattern("%m"), fn, "%p%f.bak");
        string expected_afn = la.getArchiveFileName();
        assertEq(fn + ".bak", expected_afn);
        assertFalse(la.getFile().isOpen());
        assertEq(fn, la.getFileName());
        la.open();
        assertTrue(la.getFile().isOpen());
        LoggerEvent lle = new LoggerEvent("Logger", "a", LoggerLevel::getLevelError(), "ARCHIVE");
        la.post(lle);
        string afn = la.archive();
        assertEq(expected_afn, afn);
        assertTrue(la.getFile().isOpen());
        assertTrue(is_file(afn));
        assertThrows("LOGGER-ERROR", "Target file already exists", \la.archive());
        lle = new LoggerEvent("Logger", "a", LoggerLevel::getLevelError(), "LOG");
        la.post(lle);
        la.close();
        string s = ReadOnlyFile::readTextFile(la.getFileName());
        assertEq("LOG", s);
        s = ReadOnlyFile::readTextFile(afn);
        assertEq("ARCHIVE", s);
        unlink(afn);
        afn = la.archive(); # archive closed appender
        assertFalse(la.getFile().isOpen());
        assertFalse(la.isOpen());
        s = ReadOnlyFile::readTextFile(afn);
        assertEq("LOG", s);
        assertFalse(is_file(la.getFileName()));
        unlink(afn);

        # multi-level subdir
        afn = tmp_location() + DirSep + unique_name + DirSep + unique_name + DirSep + unique_name + ".log";
        unlink(afn);
        rmdir(dirname(afn));
        rmdir(dirname(dirname(afn)));
        assertFalse(is_dir(dirname(dirname(afn))));
        la = new LoggerAppenderFileArchive("TEST", new LoggerLayoutPattern("%m"), fn, "%p"+unique_name+"%s"+unique_name+"%s%f");
        afn = la.getArchiveFileName();
        assertEq(afn, la.getArchiveFileName());
        assertFalse(la.getFile().isOpen());
        la.open();
        la.post(lle);
        la.close();
        afn = la.archive();
        assertFalse(la.getFile().isOpen());
        assertTrue(is_file(afn));
        s = ReadOnlyFile::readTextFile(afn);
        assertEq("LOG", s);
        assertFalse(is_file(la.getFileName()));
        unlink(afn);
        rmdir(dirname(afn));
        rmdir(dirname(dirname(afn)));

        hash errs = (
            "": "Empty target filename",
            "%P": "Source and target path are equal",
            "%pdummy"+DirSep+".."+DirSep+"%f": "Source and target path are equal",
            "%p": "Target is directory",
        );
        foreach string patt in (keys errs) {
            la = new LoggerAppenderFileArchive("TEST", new LoggerLayoutPattern("%m"), fn, patt);
            assertThrows("LOGGER-ERROR", errs{patt}, \la.archive());
        }
    }

    #! follows next_cursor from a first search until the search ends, checking that every call scans within the
    #! budget and gets further; returns the entries found and the bytes scanned
    private hash<auto> followSearch(LoggerAppender la, hash<auto> request, int budget, int max_calls) {
        list<hash<auto>> entries = ();
        int scanned = 0;
        int calls = 0;
        *string cursor;
        while (True) {
            hash<auto> req = request + {"max_scanned_bytes": budget};
            if (cursor) {
                req.cursor = cursor;
            }
            hash<auto> res = LoggerSearchUtil::searchRenderedEvents(la, req);
            ++calls;
            assertTrue(res.status == "ok" || res.status == "partial", sprintf("call %d: %y", calls, res.reason));
            entries += res.entries;
            scanned += res.scanned_bytes;
            if (!res.next_cursor) {
                assertEq("ok", res.status);
                break;
            }
            # a call that ends at the budget or at the limit scans something and moves the cursor
            assertTrue(res.reason == "max-scanned-bytes" || res.reason == "limit",
                sprintf("call %d: %y", calls, res.reason));
            assertTrue(res.scanned_bytes > 0, sprintf("call %d scanned bytes", calls));
            assertNeq(cursor, res.next_cursor, sprintf("call %d cursor", calls));
            cursor = res.next_cursor;
            if (calls >= max_calls) {
                assertTrue(False, sprintf("the search did not end in %d calls", max_calls));
                break;
            }
        }
        return {"entries": entries, "scanned": scanned, "calls": calls};
    }

    #! writes the given text to a file, replacing its data but keeping its inode
    private static rewriteInPlace(string fn, string text) {
        File f();
        f.open2(fn, O_WRONLY | O_TRUNC);
        f.write(text);
    }

    #! the v3 cursor: a call reads about its budget, a write after the cursor does not make it stale, and a source
    #! that was replaced, truncated or rewritten is reported (issue #5856)
    testLoggerSearchV3Cursor() {
        string fn = tmp_location() + DirSep + unique_name + "-search-v3.log";
        unlink(fn);
        on_exit unlink(fn);

        LoggerAppenderFile la("V3", new LoggerLayoutPattern("%m%n"), fn);
        Logger logger("SearchV3Test", LoggerLevel::getLevelDebug());
        logger.addAppender(la);
        la.open();
        for (int i = 0; i < 20000; ++i) {
            logger.info(sprintf("line %06d: %s%s", i, strmul("x", 80), i == 10 ? " JI 5856: early" : ""));
        }
        la.close();
        int size = hstat(fn).size;
        assertTrue(size > 1800000, sprintf("%d", size));

        # a call reads its budget and the blocks around it, not the source: the first backward call counts the lines
        # of the source once
        int budget = 16384;
        # the reader reads blocks of 64 KiB (LoggerSearchLineReader::BlockSize, internal to the module)
        int max_read = budget + 4 * 65536;
        foreach string dir in ("backward", "forward") {
            *string cursor;
            int scanned = 0;
            int calls = 0;
            list<hash<auto>> found = ();
            while (True) {
                hash<auto> req = {"text": "JI 5856:", "direction": dir, "max_scanned_bytes": budget};
                if (cursor) {
                    req.cursor = cursor;
                }
                hash<auto> res = LoggerSearchUtil::searchRenderedEvents(la, req);
                ++calls;
                scanned += res.scanned_bytes;
                found += res.entries;
                if (calls > 1 || dir == "forward") {
                    assertTrue(res.read_bytes <= max_read, sprintf("%s call %d read %d", dir, calls,
                        res.read_bytes));
                } else {
                    assertTrue(res.read_bytes >= size, sprintf("first backward call read %d", res.read_bytes));
                }
                if (!res.next_cursor) {
                    break;
                }
                assertTrue(res.next_cursor =~ /^v3:0:[0-9]+:[0-9]+:/, res.next_cursor);
                cursor = res.next_cursor;
                if (calls > 200) {
                    assertTrue(False, dir + ": the chain did not end");
                    break;
                }
            }
            # every byte is scanned exactly once, and the match has its line number
            assertEq(size, scanned, dir);
            assertEq(1, found.size(), dir);
            assertEq(11, found[0].line, dir);
            assertTrue(calls > 100, sprintf("%s: %d calls", dir, calls));
        }

        # a write after the cursor does not make it stale; a forward chain finds the lines written later
        string small_fn = tmp_location() + DirSep + unique_name + "-search-v3-active.log";
        unlink(small_fn);
        on_exit unlink(small_fn);
        LoggerAppenderFile sa("V3ACTIVE", new LoggerLayoutPattern("%m%n"), small_fn);
        Logger slogger("SearchV3ActiveTest", LoggerLevel::getLevelDebug());
        slogger.addAppender(sa);
        sa.open();
        for (int i = 0; i < 100; ++i) {
            slogger.info(sprintf("active %04d: %s", i, strmul("a", 40)));
        }
        hash<auto> res = LoggerSearchUtil::searchRenderedEvents(sa, {"text": "JI later:", "direction": "forward",
            "max_scanned_bytes": 1024});
        assertEq("partial", res.status);
        string cursor = res.next_cursor;
        slogger.info("JI later: written after the cursor");
        res = LoggerSearchUtil::searchRenderedEvents(sa, {"text": "JI later:", "direction": "forward",
            "max_scanned_bytes": LoggerSearchUtil::UnlimitedScannedBytes, "cursor": cursor});
        assertEq("ok", res.status, res.reason);
        assertEq(1, res.result_count);
        assertEq(101, res.entries[0].line);
        # a backward cursor into a source that is written to stays usable as well
        res = LoggerSearchUtil::searchRenderedEvents(sa, {"text": "active 0001:", "max_scanned_bytes": 1024});
        cursor = res.next_cursor;
        slogger.info("one more line");
        res = LoggerSearchUtil::searchRenderedEvents(sa, {"text": "active 0001:",
            "max_scanned_bytes": LoggerSearchUtil::UnlimitedScannedBytes, "cursor": cursor});
        assertEq("ok", res.status, res.reason);
        assertEq(2, res.entries[0].line);
        sa.close();

        # an active file-ring source that is written to keeps its cursor too
        string ring_fn = tmp_location() + DirSep + unique_name + "-search-v3-ring-%n.log";
        LoggerAppenderFileRing ra("V3RING", new LoggerLayoutPattern("%m%n"), ring_fn, 3);
        on_exit map unlink(ra.getFileNameForIndex($1)), xrange(0, 3);
        Logger rlogger("SearchV3RingTest", LoggerLevel::getLevelDebug());
        rlogger.addAppender(ra);
        ra.open();
        for (int i = 0; i < 100; ++i) {
            rlogger.info(sprintf("ring %04d: %s", i, strmul("r", 40)));
        }
        res = LoggerSearchUtil::searchRenderedEvents(ra, {"text": "ring 0002:", "max_scanned_bytes": 1024});
        assertEq("partial", res.status);
        cursor = res.next_cursor;
        rlogger.info("a line written after the cursor");
        res = LoggerSearchUtil::searchRenderedEvents(ra, {"text": "ring 0002:",
            "max_scanned_bytes": LoggerSearchUtil::UnlimitedScannedBytes, "cursor": cursor});
        assertEq("ok", res.status, res.reason);
        assertEq(1, res.result_count);
        assertEq(3, res.entries[0].line);
        ra.close();

        # a source replaced by another file (a new inode), rewritten from the start, or truncated before the offset
        # of the cursor is reported, not paged
        string raw_fn = tmp_location() + DirSep + unique_name + "-search-v3-raw.log";
        on_exit unlink(raw_fn);
        string raw = foldl $1 + $2, (map sprintf("raw %04d %s\n", $1, strmul("q", 30)), xrange(0, 999));
        File f();
        f.open2(raw_fn, O_CREAT | O_WRONLY | O_TRUNC);
        f.write(raw);
        f.close();
        LoggerAppenderFile raw_la("V3RAW", new LoggerLayoutPattern("%m%n"), raw_fn);
        code get_cursor = string sub (string dir) {
            # a budget that puts the offset of the cursor past the first bytes of the identity in both directions
            hash<auto> r = LoggerSearchUtil::searchRenderedEvents(raw_la, {"text": "nothing", "direction": dir,
                "max_scanned_bytes": 8192});
            return r.next_cursor;
        };
        code use_cursor = hash<auto> sub (string dir, string c) {
            return LoggerSearchUtil::searchRenderedEvents(raw_la, {"text": "nothing", "direction": dir,
                "max_scanned_bytes": 8192, "cursor": c});
        };
        string new_fn = raw_fn + ".new";
        on_exit unlink(new_fn);
        foreach string dir in ("backward", "forward") {
            # the device, inode and first bytes are the identity of the source: after a rewrite in place with the same
            # data, the cursor continues where it did before
            cursor = get_cursor(dir);
            hash<auto> before = use_cursor(dir, cursor);
            assertEq("partial", before.status, dir + " same identity");
            assertEq("max-scanned-bytes", before.reason, dir + " same identity");
            rewriteInPlace(raw_fn, raw);
            res = use_cursor(dir, cursor);
            assertEq("partial", res.status, dir + " rewritten with the same data");
            assertEq(before.scanned_bytes, res.scanned_bytes, dir + " rewritten with the same data");
            assertEq(before.next_cursor, res.next_cursor, dir + " rewritten with the same data");

            # the same data in a new file created after the source was deleted: once the last reference to a deleted
            # file is gone, the filesystem can give its inode number to the next file (ext4 does), which then has the
            # identity of the source, and the cursor is valid for it, as for the source rewritten in place; with
            # another inode number, the cursor is stale
            int deleted_inode = hstat(raw_fn).inode;
            unlink(raw_fn);
            f.open2(raw_fn, O_CREAT | O_WRONLY | O_TRUNC);
            f.write(raw);
            f.close();
            res = use_cursor(dir, cursor);
            if (hstat(raw_fn).inode == deleted_inode) {
                assertEq("partial", res.status, dir + " recreated at the same inode");
                assertEq(before.next_cursor, res.next_cursor, dir + " recreated at the same inode");
            } else {
                assertEq("invalid", res.status, dir + " recreated at another inode");
                assertEq("stale-cursor", res.reason, dir + " recreated at another inode");
            }

            # the same data in a new file, which replaces the source while it still exists (renamed over it), so
            # that it has another inode number: the cursor is stale
            cursor = get_cursor(dir);
            int old_inode = hstat(raw_fn).inode;
            f.open2(new_fn, O_CREAT | O_WRONLY | O_TRUNC);
            f.write(raw);
            f.close();
            rename(new_fn, raw_fn);
            assertNeq(old_inode, hstat(raw_fn).inode, dir + " replaced: another inode");
            res = use_cursor(dir, cursor);
            assertEq("invalid", res.status, dir + " replaced");
            assertEq("stale-cursor", res.reason, dir + " replaced");

            # rewritten from the start in the same file
            cursor = get_cursor(dir);
            rewriteInPlace(raw_fn, "X" + raw.substr(1));
            res = use_cursor(dir, cursor);
            assertEq("stale-cursor", res.reason, dir + " rewritten");
            # truncated before the offset of the cursor (the first bytes are unchanged)
            rewriteInPlace(raw_fn, raw);
            cursor = get_cursor(dir);
            int offset = int((cursor =~ x/^v3:[0-9]+:([0-9]+):/)[0]);
            rewriteInPlace(raw_fn, raw.substr(0, offset - 10));
            res = use_cursor(dir, cursor);
            assertEq("source-truncated", res.reason, dir + " truncated");
            # the offset is no longer on a line boundary
            rewriteInPlace(raw_fn, raw.substr(0, offset - 5) + "zz" + raw.substr(offset - 5));
            res = use_cursor(dir, cursor);
            assertEq("source-truncated", res.reason, dir + " moved");
            rewriteInPlace(raw_fn, raw);
        }

        # a v2 cursor is still accepted
        list<hash<auto>> sources = LoggerSearchUtil::getAppenderSearchSources(raw_la, {});
        res = LoggerSearchUtil::searchRenderedEvents(raw_la, {"text": "raw 0003 ",
            "cursor": sprintf("v2:0:%d:backward:%s", 10, sources[0].source_fingerprint)});
        assertEq("ok", res.status, res.reason);
        assertEq(1, res.result_count);
        assertEq(4, res.entries[0].line);
        res = LoggerSearchUtil::searchRenderedEvents(raw_la, {"text": "raw 0150 ", "direction": "forward",
            "cursor": sprintf("v2:0:%d:forward:%s", 100, sources[0].source_fingerprint)});
        assertEq(1, res.result_count);
        assertEq(151, res.entries[0].line);

        # the default budget: a call reads about the budget (in chunks and blocks), not the source
        *string dcursor;
        int dcalls = 0;
        while (True) {
            hash<auto> dreq = {"text": "never matches"};
            if (dcursor) {
                dreq.cursor = dcursor;
            }
            res = LoggerSearchUtil::searchRenderedEvents(la, dreq);
            if (++dcalls > 1) {
                assertTrue(res.read_bytes <= LoggerSearchUtil::DefaultMaxScannedBytes + 8 * 65536,
                    sprintf("default budget call %d read %d", dcalls, res.read_bytes));
            }
            if (!res.next_cursor) {
                break;
            }
            dcursor = res.next_cursor;
        }
        assertEq(2, dcalls);

        # context lines across the calls of a v3 chain have the line numbers of the lines they show
        hash<auto> cr = followSearch(la, {"text": "JI 5856:", "context_before": 2, "context_after": 2}, 4096, 1000);
        assertEq((9, 10, 11, 12, 13), (map $1.line, cr.entries));
        assertEq(("before", "before", "match", "after", "after"), (map $1.context, cr.entries));
        assertEq(size, cr.scanned);

        # forward, the last line of an active source without a terminator is not scanned until it is complete, so
        # that the cursor after it is not in the middle of a line once the writer completes it
        string part_fn = tmp_location() + DirSep + unique_name + "-search-v3-partial.log";
        on_exit unlink(part_fn);
        f.open2(part_fn, O_CREAT | O_WRONLY | O_TRUNC);
        f.write("m1 needle\nm2 needle\nm3 partial");
        f.close();
        LoggerAppenderFile part_la("V3PART", new LoggerLayoutPattern("%m%n"), part_fn);
        res = LoggerSearchUtil::searchRenderedEvents(part_la, {"text": "needle", "direction": "forward",
            "max_scanned_bytes": LoggerSearchUtil::UnlimitedScannedBytes});
        assertEq(2, res.result_count);
        assertEq(20, res.scanned_bytes);
        f.open2(part_fn, O_WRONLY | O_APPEND);
        f.write(" needle\n");
        f.close();
        res = LoggerSearchUtil::searchRenderedEvents(part_la, {"text": "needle", "direction": "forward",
            "limit": 2});
        string pcursor = res.next_cursor;
        res = LoggerSearchUtil::searchRenderedEvents(part_la, {"text": "needle", "direction": "forward",
            "cursor": pcursor});
        assertEq("ok", res.status, res.reason);
        assertEq(1, res.result_count);
        assertEq("m3 partial needle", res.entries[0].message);

        # an inactive source (a rotated file) whose last line has no terminator: a cursor after it, at the end of the
        # source, is a valid end of its scan
        string rot_fn = tmp_location() + DirSep + unique_name + "-search-v3-rotated.log";
        LoggerAppenderFileRotate rota("V3ROT", new LoggerLayoutPattern("%m%n"), rot_fn, 2);
        list<string> rot_files = (rot_fn, rota.getArchiveFileName(1), rota.getArchiveFileName(2));
        on_exit map unlink($1), rot_files;
        f.open2(rota.getArchiveFileName(1), O_CREAT | O_WRONLY | O_TRUNC);
        f.write("r1 needle\nr2 needle");
        f.close();
        f.open2(rot_fn, O_CREAT | O_WRONLY | O_TRUNC);
        f.write("a1 other\n");
        f.close();
        list<hash<auto>> rsources = LoggerSearchUtil::getAppenderSearchSources(rota, {"direction": "forward"});
        assertEq(rota.getArchiveFileName(1), rsources[0].path);
        res = LoggerSearchUtil::searchRenderedEvents(rota, {"text": "needle", "direction": "forward", "limit": 2});
        assertEq(2, res.result_count);
        assertEq("r2 needle", res.entries[1].message);
        res = LoggerSearchUtil::searchRenderedEvents(rota, {"text": "needle", "direction": "forward",
            "cursor": res.next_cursor});
        assertEq("ok", res.status, res.reason);
        assertEq(0, res.result_count);
    }

    #! issue #5817: a file larger than max_scanned_bytes is searched within the budget, and next_cursor gets further
    testLoggerSearchScanBudget() {
        string fn = tmp_location() + DirSep + unique_name + "-search-budget.log";
        unlink(fn);
        on_exit unlink(fn);

        LoggerAppenderFile la("BUDGET", new LoggerLayoutPattern("%m%n"), fn);
        Logger logger("SearchBudgetTest", LoggerLevel::getLevelDebug());
        logger.addAppender(la);
        la.open();
        for (int i = 0; i < 500; ++i) {
            logger.info(sprintf("line %04d: %s%s", i, strmul("x", 30), i == 5 ? " JI 42: run" : ""));
        }
        logger.info("JI 7: last run");
        la.close();
        int size = hstat(fn).size;
        assertTrue(size > 20000);

        # the first call scans the newest lines within the budget, finds nothing yet and points further back
        hash<auto> res = LoggerSearchUtil::searchRenderedEvents(la, {"text": "JI 42:", "max_scanned_bytes": 2048});
        assertEq("partial", res.status);
        assertEq("max-scanned-bytes", res.reason);
        assertEq(0, res.result_count);
        assertTrue(res.scanned_bytes > 2000 && res.scanned_bytes <= 2048, sprintf("%d", res.scanned_bytes));
        assertTrue(res.next_cursor instanceof string);
        # the next call gets further back
        hash<auto> res2 = LoggerSearchUtil::searchRenderedEvents(la,
            {"text": "JI 42:", "max_scanned_bytes": 2048, "cursor": res.next_cursor});
        assertTrue(res2.scanned_bytes > 0);
        assertNeq(res.next_cursor, res2.next_cursor);

        # following the cursor backward finds the match, and every byte of the file is scanned exactly once
        hash<auto> r = followSearch(la, {"text": "JI 42:"}, 2048, 20);
        assertEq(1, r.entries.size());
        assertEq(6, r.entries[0].line);
        assertTrue(r.entries[0].message =~ /^line 0005: x+ JI 42: run$/);
        assertEq(size, r.scanned);
        assertTrue(r.calls >= 10, sprintf("%d calls", r.calls));

        # forward: the newest line is found at the end of the chain
        r = followSearch(la, {"text": "JI 7:", "direction": "forward"}, 2048, 20);
        assertEq(1, r.entries.size());
        assertEq("JI 7: last run", r.entries[0].message);
        assertEq(size, r.scanned);

        # a budget smaller than one line still scans a line per call
        r = followSearch(la, {"text": "JI 42:", "limit": 1}, 1, 600);
        assertEq(1, r.entries.size());
        assertEq(6, r.entries[0].line);

        # no limit: one call scans the whole file
        res = LoggerSearchUtil::searchRenderedEvents(la,
            {"text": "JI 42:", "max_scanned_bytes": LoggerSearchUtil::UnlimitedScannedBytes});
        assertEq("ok", res.status);
        assertEq(1, res.result_count);
        assertEq(size, res.scanned_bytes);

        # a rotated file: the cursor goes from the active file to the rotated one
        string rfn = tmp_location() + DirSep + unique_name + "-search-budget-rotate.log";
        LoggerAppenderFileRotate ra("BUDGETROT", new LoggerLayoutPattern("%m%n"), rfn, 3);
        list<string> files = map ra.getArchiveFileName($1), xrange(1, 3);
        on_exit {
            unlink(rfn);
            map unlink($1), files;
        }
        Logger rlogger("SearchBudgetRotateTest", LoggerLevel::getLevelDebug());
        rlogger.addAppender(ra);
        ra.open();
        for (int i = 0; i < 200; ++i) {
            rlogger.info(sprintf("old %04d: %s%s", i, strmul("y", 30), i == 3 ? " JI 99: rotated" : ""));
        }
        ra.rotate();
        for (int i = 0; i < 200; ++i) {
            rlogger.info(sprintf("new %04d: %s", i, strmul("z", 30)));
        }
        ra.close();
        list<hash<auto>> sources = LoggerSearchUtil::getAppenderSearchSources(ra, {});
        assertEq(2, sources.size());
        int total = foldl $1 + $2, (map hstat($1.path).size, sources);
        r = followSearch(ra, {"text": "JI 99:"}, 2048, 20);
        assertEq(1, r.entries.size());
        assertEq(sources[1].path, r.entries[0].source_path);
        assertTrue(r.entries[0].message =~ /^old 0003: y+ JI 99: rotated$/);
        assertEq(total, r.scanned);

        # a budget used up exactly by the active file points at the rotated one without reading it
        int active_size = hstat(sources[0].path).size;
        res = LoggerSearchUtil::searchRenderedEvents(ra, {"text": "JI 99:", "max_scanned_bytes": active_size});
        assertEq("partial", res.status);
        assertEq("max-scanned-bytes", res.reason);
        assertEq(active_size, res.scanned_bytes);
        assertEq(0, res.result_count);
        assertTrue(res.next_cursor =~ /^v3:1:-1:-1:backward:/, res.next_cursor);
        res = LoggerSearchUtil::searchRenderedEvents(ra, {"text": "JI 99:", "max_scanned_bytes": active_size,
            "cursor": res.next_cursor});
        assertEq(1, res.result_count);
        # forward, the rotated file comes first, and a budget used up by it points at the first line of the active one
        # (forward, the cursor is the same whether the active file is read or not; backward above shows that it is
        # not read)
        list<hash<auto>> fsources = LoggerSearchUtil::getAppenderSearchSources(ra, {"direction": "forward"});
        assertEq(sources[1].path, fsources[0].path);
        int rotated_size = hstat(fsources[0].path).size;
        res = LoggerSearchUtil::searchRenderedEvents(ra, {"text": "new 0199", "direction": "forward",
            "max_scanned_bytes": rotated_size});
        assertEq("partial", res.status);
        assertEq("max-scanned-bytes", res.reason);
        assertEq(0, res.result_count);
        assertEq(rotated_size, res.scanned_bytes);
        assertTrue(res.next_cursor =~ /^v3:1:0:0:forward:/, res.next_cursor);
        res = LoggerSearchUtil::searchRenderedEvents(ra, {"text": "new 0199", "direction": "forward",
            "max_scanned_bytes": LoggerSearchUtil::UnlimitedScannedBytes, "cursor": res.next_cursor});
        assertEq(1, res.result_count);
        assertEq(fsources[1].path, res.entries[0].source_path);

        # bytes, not characters, with CRLF line ends, an empty line and no final line terminator
        string raw_fn = tmp_location() + DirSep + unique_name + "-search-budget-raw.log";
        on_exit unlink(raw_fn);
        string raw = "first\r\nh\u00e9\u00e9 \u00df\u00df\r\n\nmiddle needle\r\nlast";
        {
            File f();
            f.open2(raw_fn, O_CREAT | O_WRONLY | O_TRUNC);
            f.write(raw);
        }
        assertEq(raw.size(), hstat(raw_fn).size);
        LoggerAppenderFile raw_la("RAW", new LoggerLayoutPattern("%m%n"), raw_fn);
        foreach string dir in ("backward", "forward") {
            r = followSearch(raw_la, {"text": "needle", "direction": dir}, 5, 10);
            assertEq(1, r.entries.size(), dir);
            assertEq(4, r.entries[0].line, dir);
            # forward, the last line of the active file, which has no terminator, is still being written and is not
            # scanned (issue #5856)
            assertEq(dir == "forward" ? raw.size() - "last".size() : raw.size(), r.scanned, dir);
        }
        # context lines are returned with a match and are not counted in the budget
        r = followSearch(raw_la, {"text": "needle", "context_before": 1, "context_after": 1}, 5, 10);
        assertEq(("before", "match", "after"), (map $1.context, r.entries));
        assertEq(raw.size(), r.scanned);
        # a budget of 0 or a negative one other than UnlimitedScannedBytes scans one line per call
        foreach int budget in (0, -5) {
            r = followSearch(raw_la, {"text": "needle"}, budget, 10);
            assertEq(5, r.calls, sprintf("budget %d", budget));
            assertEq(raw.size(), r.scanned, sprintf("budget %d", budget));
        }
    }

    testLoggerSearchUtil() {
        date pattern_date = 2026-06-06T11:22:33;
        assertEq("test-logs-abc123z",
            LoggerSearchUtil::formatLogIndexPattern("test-logs-abc123z", pattern_date));
        assertEq("logs-2026.06.06",
            LoggerSearchUtil::formatLogIndexPattern("logs-%Y.%m.%d", pattern_date));
        assertEq("logs-2026-6-6-11-22-33",
            LoggerSearchUtil::formatLogIndexPattern("logs-%Y-%-m-%-d-%-H-%-M-%-S", pattern_date));
        assertEq("logs-%Y",
            LoggerSearchUtil::formatLogIndexPattern("logs-%%Y", pattern_date));
        assertEq("logs-%Q",
            LoggerSearchUtil::formatLogIndexPattern("logs-%Q", pattern_date));

        LoggerAppenderNull null_appender("null");
        hash<auto> caps = LoggerSearchUtil::getAppenderSearchCapabilities(null_appender);
        assertFalse(caps.searchable);
        hash<auto> unavailable = LoggerSearchUtil::searchRenderedEvents(null_appender, {"text": "needle"});
        assertEq("unavailable", unavailable.status);

        string fn = tmp_location() + DirSep + unique_name + "-search.log";
        unlink(fn);
        on_exit unlink(fn);

        LoggerAppenderFile la("SEARCH", new LoggerLayoutPattern("%m%n"), fn);
        Logger logger("SearchTest", LoggerLevel::getLevelDebug());
        logger.addAppender(la);
        la.open();
        logger.info("first line");
        logger.error("needle older");
        logger.warn("middle");
        logger.error("needle newest");
        la.close();

        caps = LoggerSearchUtil::getAppenderSearchCapabilities(la);
        assertTrue(caps.searchable);
        assertEq("file", caps.source.kind);
        list<hash<auto>> sources = LoggerSearchUtil::getAppenderSearchSources(la, {});
        assertEq(1, sources.size());
        assertEq("file", sources[0].kind);
        assertEq(fn, sources[0].path);
        assertTrue(sources[0].source_fingerprint instanceof string);

        hash<auto> res = LoggerSearchUtil::searchRenderedEvents(la, {"text": "needle", "limit": 1});
        assertEq("partial", res.status);
        assertEq(1, res.result_count);
        assertEq("needle newest", res.entries[0].message);
        assertTrue(res.next_cursor instanceof string);

        res = LoggerSearchUtil::searchRenderedEvents(la, {"text": "needle", "limit": 1, "cursor": res.next_cursor});
        assertEq(1, res.result_count);
        assertEq("needle older", res.entries[0].message);

        res = LoggerSearchUtil::searchRenderedEvents(la, {"terms": ("needle", "older"), "match": "all"});
        assertEq(1, res.result_count);
        assertEq("needle older", res.entries[0].message);

        res = LoggerSearchUtil::searchRenderedEvents(la,
            {"text": "needle older", "direction": "forward", "limit": 1, "context_before": 1, "context_after": 1});
        assertEq("partial", res.status);
        assertEq(3, res.result_count);
        assertEq("first line", res.entries[0].message);
        assertEq("before", res.entries[0].context);
        assertEq("needle older", res.entries[1].message);
        assertEq("match", res.entries[1].context);
        assertEq("middle", res.entries[2].message);
        assertEq("after", res.entries[2].context);

        res = LoggerSearchUtil::searchRenderedEvents(la, {"text": "[", "regex": True});
        assertEq("invalid", res.status);
        assertEq("invalid-regex", res.reason);

        res = LoggerSearchUtil::searchRenderedEvents(la,
            {"text": "needle older", "regex": True, "direction": "forward", "limit": 1,
                "context_before": 1, "context_after": 1});
        assertEq("partial", res.status);
        assertEq(3, res.result_count);
        assertEq("before", res.entries[0].context);
        assertEq("match", res.entries[1].context);
        assertEq("after", res.entries[2].context);
        assertTrue(res.next_cursor instanceof string);

        res = LoggerSearchUtil::searchRenderedEvents(la, {
            "text": "needle.*",
            "regex": True,
            "max_scanned_bytes": 1,
        });
        assertEq("partial", res.status);
        assertEq("max-scanned-bytes", res.reason);

        string lfn = tmp_location() + DirSep + unique_name + "-search-level.log";
        unlink(lfn);
        on_exit unlink(lfn);

        LoggerAppenderFile level_appender("SEARCHLEVEL", new LoggerLayoutPattern("[%p]: %m%n"), lfn);
        Logger level_logger("SearchLevelTest", LoggerLevel::getLevelDebug());
        level_logger.addAppender(level_appender);
        level_appender.open();
        level_logger.debug("debug needle");
        level_logger.info("info needle");
        level_logger.error("error needle");
        level_appender.close();

        caps = LoggerSearchUtil::getAppenderSearchCapabilities(level_appender);
        assertTrue(caps.levels);
        res = LoggerSearchUtil::searchRenderedEvents(level_appender, {
            "text": "needle",
            "level_min": "INFO",
            "direction": "forward",
            "limit": 10,
        });
        list<string> messages = map $1.message, res.entries;
        assertFalse(inlist("[DEBUG]: debug needle", messages));
        assertTrue(inlist("[INFO]: info needle", messages));
        assertTrue(inlist("[ERROR]: error needle", messages));
        res = LoggerSearchUtil::searchRenderedEvents(level_appender, {"level_min": "BOGUS"});
        assertEq("invalid", res.status);
        assertEq("invalid-level", res.reason);

        string rfn = tmp_location() + DirSep + unique_name + "-search-rotate.log";
        LoggerAppenderFileRotate rotate("SEARCHROT", new LoggerLayoutPattern("%m%n"), rfn, 2);
        unlink(rfn);
        for (int i = 1; i <= rotate.getCount(); ++i) {
            unlink(rotate.getArchiveFileName(i));
        }
        on_exit {
            unlink(rfn);
            for (int i = 1; i <= rotate.getCount(); ++i) {
                unlink(rotate.getArchiveFileName(i));
            }
        }

        Logger rotate_logger("SearchRotateTest", LoggerLevel::getLevelDebug());
        rotate_logger.addAppender(rotate);
        rotate.open();
        rotate_logger.error("rotated needle");
        rotate.rotate();
        rotate_logger.error("active needle");
        rotate.close();

        res = LoggerSearchUtil::searchRenderedEvents(rotate, {"text": "needle", "limit": 10});
        messages = map $1.message, res.entries;
        assertTrue(inlist("active needle", messages));
        assertTrue(inlist("rotated needle", messages));
        sources = LoggerSearchUtil::getAppenderSearchSources(rotate, {"direction": "forward"});
        assertEq(2, sources.size());
        assertTrue(all $1.source_fingerprint instanceof string, sources);

        res = LoggerSearchUtil::searchRenderedEvents(rotate, {
            "text": "needle",
            "direction": "forward",
            "limit": 1,
        });
        assertEq("partial", res.status);
        assertEq("rotated needle", res.entries[0].message);
        string include_rotated_cursor = res.next_cursor;
        res = LoggerSearchUtil::searchRenderedEvents(rotate, {
            "text": "needle",
            "direction": "forward",
            "cursor": include_rotated_cursor,
            "include_rotated": False,
        });
        assertEq("invalid", res.status);
        assertEq("stale-cursor", res.reason);

        res = LoggerSearchUtil::searchRenderedEvents(rotate, {"text": "needle", "limit": 1});
        string stale_cursor = res.next_cursor;
        rotate.open();
        rotate.rotate();
        rotate_logger.error("post-rotate needle");
        rotate.close();

        res = LoggerSearchUtil::searchRenderedEvents(rotate, {"text": "needle", "cursor": stale_cursor});
        assertEq("invalid", res.status);
        assertEq("stale-cursor", res.reason);

        string crfn = tmp_location() + DirSep + unique_name + "-search-compressed-rotate.log";
        LoggerAppenderFileRotate crotate("SEARCHCOMPROT", new LoggerLayoutPattern("%m%n"), crfn, 1);
        unlink(crfn);
        unlink(crotate.getArchiveFileName(1));
        unlink(crotate.getArchiveFileName(1) + ".gz");
        on_exit {
            unlink(crfn);
            unlink(crotate.getArchiveFileName(1));
            unlink(crotate.getArchiveFileName(1) + ".gz");
        }

        Logger crotate_logger("SearchCompressedRotateTest", LoggerLevel::getLevelDebug());
        crotate_logger.addAppender(crotate);
        crotate.open();
        crotate_logger.error("compressed rotated needle");
        crotate.rotate();
        crotate_logger.error("compressed active needle");
        crotate.close();

        string compressed_archive = crotate.getArchiveFileName(1) + ".gz";
        File gz_file();
        gz_file.open(compressed_archive, O_CREAT | O_WRONLY | O_TRUNC, 0600);
        gz_file.write(gzip(ReadOnlyFile::readBinaryFile(crotate.getArchiveFileName(1))));
        gz_file.close();
        unlink(crotate.getArchiveFileName(1));

        caps = LoggerSearchUtil::getAppenderSearchCapabilities(crotate);
        assertTrue(caps.include_compressed_rotated);
        assertTrue(inlist("gzip", caps.compressed_rotated_encodings));
        res = LoggerSearchUtil::searchRenderedEvents(crotate, {
            "text": "compressed rotated",
            "direction": "forward",
            "include_compressed_rotated": True,
        });
        assertEq("ok", res.status);
        assertEq(1, res.result_count);
        assertEq("compressed rotated needle", res.entries[0].message);
        assertTrue(res.entries[0].source.compressed);
        assertEq("gzip", res.entries[0].source.compression);
        assertTrue(res.entries[0].source_fingerprint instanceof string);

        sources = LoggerSearchUtil::getAppenderSearchSources(crotate, {
            "direction": "forward",
            "include_compressed_rotated": True,
        });
        assertTrue(any $1.compressed && $1.compression == "gzip", sources);

        string ring_pattern = tmp_location() + DirSep + unique_name + "-search-ring-%i.log";
        LoggerAppenderFileRing ring("SEARCHRING", new LoggerLayoutPattern("%m%n"), ring_pattern, 1);
        unlink(ring.getFileNameForIndex(0));
        on_exit unlink(ring.getFileNameForIndex(0));

        Logger ring_logger("SearchRingTest", LoggerLevel::getLevelDebug());
        ring_logger.addAppender(ring);
        ring.open();
        ring_logger.error("ring first needle");
        ring_logger.error("ring second needle");
        ring.close();

        res = LoggerSearchUtil::searchRenderedEvents(ring, {"text": "needle", "limit": 1});
        assertEq("partial", res.status);
        string ring_cursor = res.next_cursor;
        ring.open();
        ring.rotate();
        ring_logger.error("ring overwritten needle");
        ring.close();

        res = LoggerSearchUtil::searchRenderedEvents(ring, {"text": "needle", "cursor": ring_cursor});
        assertEq("invalid", res.status);
        assertEq("stale-cursor", res.reason);

        string afn_search = tmp_location() + DirSep + unique_name + "-search-archive.log";
        string archive_pattern = tmp_location() + DirSep + unique_name + "-search-archive.%d";
        LoggerAppenderFileArchive archive("SEARCHARCH", new LoggerLayoutPattern("%m%n"), afn_search,
            archive_pattern);
        unlink(afn_search);
        on_exit unlink(afn_search);
        hash<auto> archive_caps = LoggerSearchUtil::getAppenderSearchCapabilities(archive);
        assertEq("file-archive", archive_caps.source.kind);
        assertFalse(archive_caps.include_archived);
        assertFalse(archive_caps.archive_search);
    }

    testLogger() {
        Logger l1("TEST");
        LoggerRoot l2(LoggerLevel::getLevelError());
        assertEq("TEST", l1.getName());
        # parent test
        assertEq(NOTHING, l1.getParent());
        l1.setParent(l2);
        assertEq(l2, l1.getParent());
        assertEq(NOTHING, l2.getParent());
        l1.setParent(NOTHING);
        assertEq(NOTHING, l1.getParent());
        l1.setParent(l2);
        assertEq(l2, l1.getParent());

        assertThrows("LOGGER-ERROR", "Circular logger chain", \l1.setParent(), (l1));
        assertEq(l2, l1.getParent());
        assertThrows("LOGGER-ERROR", "Cannot set parent for root", \l2.setParent(), (l1));
        assertThrows("LOGGER-ERROR", "Cannot set null level for root", \l2.setLevel());

        # level test
        assertEq(NOTHING, l1.getLevel(False));
        assertEq(LoggerLevel::getLevelError(), l2.getLevel(False));
        assertEq(LoggerLevel::getLevelError(), l1.getLevel());
        assertEq(True, l1.isEnabledFor(LoggerLevel::ERROR));
        assertEq(True, l1.isErrorEnabled());
        assertEq(False, l1.isEnabledFor(LoggerLevel::getLevelDebug()));
        assertEq(False, l1.isDebugEnabled());
        assertEq(True, l1.isEnabledFor("FATAL"));
        assertEq(True, l1.isFatalEnabled());
        l1.setLevel("FATAL");
        assertEq(LoggerLevel::getLevelFatal(), l1.getLevel());
        l1.setLevel(LoggerLevel::ALL);
        assertEq(LoggerLevel::getLevelAll(), l1.getLevel());
        l1.setLevel(NOTHING);
        assertEq(LoggerLevel::getLevelError(), l1.getLevel());

        l1.setParent(NOTHING);
        assertThrows("LOGGER-ERROR", "Cannot get effective level", \l1.getLevel());
        l1.setParent(l2);

        # additivity test
        assertEq(True, l1.getAdditivity());
        l1.setAdditivity(False);
        assertEq(False, l1.getAdditivity());
        l1.setAdditivity(True);
        assertEq(True, l1.getAdditivity());

        # arrange appenders
        LoggerLayoutPattern llp("%c/%m");
        StringOutputStream sos1();
        StreamWriter sw1(sos1);
        LoggerAppenderStream la1("TEST", llp, sw1);

        StringOutputStream sos2();
        StreamWriter sw2(sos2);
        LoggerAppenderStream la2("ALERT", llp, sw2);
        LoggerFilterLevel lfl(LoggerLevel::FATAL);
        la2.addFilter(lfl);

        StringOutputStream sos3();
        StreamWriter sw3(sos3);
        LoggerAppenderStream la3("ROOT", llp, sw3);

        # appender list test
        assertEq((), l1.getAppenders());
        l1.addAppender(la1);
        assertEq((la1, ), l1.getAppenders());
        l1.removeAppender(la1);
        assertEq((), l1.getAppenders());
        l1.addAppender(la1);
        l1.addAppender(la2);
        assertEq((la1, la2), l1.getAppenders());
        assertThrows("LOGGER-ERROR", "Appender already exists in list", \l1.addAppender(), (la1));
        l1.addAppender(la3);
        assertEq((la1, la2, la3), l1.getAppenders());
        l1.removeAppender(la2);
        assertEq((la1, la3), l1.getAppenders());
        l1.removeAllAppenders();
        assertEq((), l1.getAppenders());

        l1.setAdditivity(True);
        l1.setLevel("DEBUG");
        l1.addAppender(la1);
        l1.addAppender(la2);
        l2.addAppender(la3);
        la1.open();
        la2.open();
        la3.open();
        # sos1 ... DEBUG
        # sos2 ... FATAL
        # sos3 ... ERROR

        l1.error("test");
        assertEq("TEST/test", sos1.getData());
        assertEq("", sos2.getData());
        assertEq("/test", sos3.getData());
        l1.setAdditivity(False);
        l1.log("ERROR", "test");
        assertEq("TEST/test", sos1.getData());
        assertEq("", sos2.getData());
        assertEq("", sos3.getData());
        l1.setAdditivity(True);
        l2.log(LoggerLevel::ERROR, "test");
        assertEq("", sos1.getData());
        assertEq("", sos2.getData());
        assertEq("/test", sos3.getData());

        l1.trace("test");
        assertEq("", sos1.getData());
        assertEq("", sos2.getData());
        assertEq("", sos3.getData());

        l1.log(LoggerLevel::getLevelDebug(), "test(%s, %s)", "my", new LoggerEventParameter(\sprintf(), "%y", (1, 2)));
        assertEq("TEST/test(my, [1, 2])", sos1.getData());
        assertEq("", sos2.getData());
        assertEq("", sos3.getData());

        l1.log(LoggerLevel::FATAL, "test");
        assertEq("TEST/test", sos1.getData());
        assertEq("TEST/test", sos2.getData());
        assertEq("/test", sos3.getData());

        l1.logArgs(LoggerLevel::FATAL, "test-%d", 1);
        assertEq("TEST/test-1", sos1.getData());
        assertEq("TEST/test-1", sos2.getData());
        assertEq("/test-1", sos3.getData());

        l1.logArgs(LoggerLevel::FATAL, "test-%d", ("2", ));
        assertEq("TEST/test-2", sos1.getData());
        assertEq("TEST/test-2", sos2.getData());
        assertEq("/test-2", sos3.getData());

        l1.assertLog(False, "test: %d,%s", 1, "a");
        assertEq("TEST/test: 1,a", sos1.getData());
        assertEq("", sos2.getData());
        assertEq("/test: 1,a", sos3.getData());

        int i = 124;
        l1.debugVar("i", i);
        assertEq("TEST/i: 124", sos1.getData());

        llp.setPattern("%F:%L");
        l1.error("ERROR", "test");
        hash<CallStackInfo> loc = get_thread_call_stack()[0];

        assertEq(sprintf("%s:%d", loc.file, loc.line-1), sos1.getData());

        # inc, dec middle level
        l1.setLevel(Logger::LoggerLevel::DEBUG);
        assertEq(Logger::LoggerLevel::getLevel("DEBUG"), l1.getLevel());
        l1.decLevel();
        assertEq(Logger::LoggerLevel::getLevel("TRACE"), l1.getLevel());
        l1.incLevel();
        assertEq(Logger::LoggerLevel::getLevel("DEBUG"), l1.getLevel());

        # dec minimum level
        l1.setLevel(Logger::LoggerLevel::ALL);
        assertEq(Logger::LoggerLevel::getLevel("ALL"), l1.getLevel());
        l1.decLevel();
        assertEq(Logger::LoggerLevel::getLevel("ALL"), l1.getLevel());
        l1.incLevel();
        assertEq(Logger::LoggerLevel::getLevel("TRACE"), l1.getLevel());

        # inc maximum level
        l1.setLevel(Logger::LoggerLevel::OFF);
        assertEq(Logger::LoggerLevel::getLevel("OFF"), l1.getLevel());
        l1.incLevel();
        assertEq(Logger::LoggerLevel::getLevel("OFF"), l1.getLevel());
        l1.decLevel();
        assertEq(Logger::LoggerLevel::getLevel("FATAL"), l1.getLevel());
    }

    testLifecycleMarkers() {
        string fn = tmp_location() + DirSep + unique_name + "-lifecycle.log";
        unlink(fn);
        on_exit unlink(fn);

        # default: markers off, content unchanged
        {
            LoggerAppenderFile la("LIFE", new LoggerLayoutPattern("%m%n"), fn);
            assertFalse(la.lifecycleMarkersEnabled(), "markers off by default");
            la.open();
            la.post(new LoggerEvent("Logger", "a", LoggerLevel::getLevelInfo(), "hello"));
            la.close();
            assertEq("hello\n", ReadOnlyFile::readTextFile(fn), "no marker noise when disabled");
            unlink(fn);
        }

        # plain LoggerAppenderFile: open / close markers via the C++ base
        {
            LoggerAppenderFile la("LIFE", new LoggerLayoutPattern("%m%n"), fn);
            la.setLifecycleMarkers(True);
            assertTrue(la.lifecycleMarkersEnabled());
            la.open();
            la.post(new LoggerEvent("Logger", "a", LoggerLevel::getLevelInfo(), "hello"));
            la.close();
            string content = ReadOnlyFile::readTextFile(fn);
            list<string> lines = content.split("\n");
            assertEq(3, lines.size(), "open marker + payload + close marker");
            assertRegex("^# .* logger=LIFE action=opened file=" + fn + "\$", lines[0]);
            assertEq("hello", lines[1]);
            assertRegex("^# .* logger=LIFE action=closing file=" + fn + "\$", lines[2]);
            unlink(fn);
        }

        # unnamed LoggerAppenderFile: lifecycle markers must not dereference a missing appender name
        {
            LoggerAppenderFile la(new LoggerLayoutPattern("%m%n"), fn);
            assertEq("", la.getName(), "unnamed appender name is empty");
            la.setLifecycleMarkers(True);
            la.open();
            la.post(new LoggerEvent("Logger", "a", LoggerLevel::getLevelInfo(), "hello"));
            la.close();
            string content = ReadOnlyFile::readTextFile(fn);
            list<string> lines = content.split("\n");
            assertEq(3, lines.size(), "unnamed open marker + payload + close marker");
            assertRegex("^# .* logger= action=opened file=" + fn + "\$", lines[0]);
            assertEq("hello", lines[1]);
            assertRegex("^# .* logger= action=closing file=" + fn + "\$", lines[2]);
            unlink(fn);
        }

        # rotate: marker in old file ("rotated -> X.1"), marker in new file ("rotated <- X.1")
        {
            LoggerAppenderFileRotate la("LIFE", new LoggerLayoutPattern("%m%n"), fn, 3);
            la.setLifecycleMarkers(True);
            la.open();
            la.post(new LoggerEvent("Logger", "a", LoggerLevel::getLevelInfo(), "first"));
            la.rotate();
            la.post(new LoggerEvent("Logger", "a", LoggerLevel::getLevelInfo(), "second"));
            la.close();

            # rotated archive at fn.1 should contain: opened, first, rotated -> fn.1
            string archive = ReadOnlyFile::readTextFile(fn + ".1");
            assertRegex("action=opened", archive);
            assertRegex("first", archive);
            assertRegex("action=rotated.*-> " + fn + ".1", archive);

            # current file at fn should contain: rotated <- fn.1, second, closing
            string current = ReadOnlyFile::readTextFile(fn);
            assertRegex("action=rotated.*<- " + fn + ".1", current);
            assertRegex("second", current);
            assertRegex("action=closing", current);

            unlink(fn);
            unlink(fn + ".1");
        }
    }
}
