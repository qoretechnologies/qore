%modern
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires BflRestClient
%requires QoreMediaUtils
%exec-class BflRestClientTest

class BflRestClientTest inherits QUnit::Test {
    constructor() : Test("BFL compatibility and registry", "1.1") {
        addTestCase("connection and media identities remain registered", \registryTest());
        addTestCase("credential normalization is idempotent and sensitive", \optionsTest());
        addTestCase("historical video alias is explicitly retired", \migrationTest());
        set_return_value(main());
    }
    private registryTest() {
        auto info = ConnectionSchemeCache::getScheme("bfl");
        assertEq("Black Forest Labs Connection", info.display_name);
        assertEq("apikey", info.required_options);
        assertTrue(info.options.apikey.sensitive);
        assertEq("BflRestClient", QoreMediaUtils::MediaProviderRegistry::getImageGeneratorFactoryEx("bfl").getInfo().module_name);
        assertEq("BflRestClient", QoreMediaUtils::MediaProviderRegistry::getVideoGeneratorFactoryEx("bfl").getInfo().module_name);
    }
    private optionsTest() {
        auto opts = BflRestClientBase::getOptions({"apikey": "fixture-only"});
        assertEq("x-key", opts.token_api_key_header);
        assertEq("fixture-only", opts.token);
        assertNothing(opts.apikey);
        assertNothing(opts.headers."x-key");
        assertEq(opts, BflRestClientBase::getOptions(opts));
    }
    private migrationTest() {
        assertEq("flux-3-video", DefaultVideoModel);
        assertFalse(VideoModelPathMap.hasKey("flux-1.1-pro-video"));
        assertThrows("MEDIA-CONFIG-ERROR", sub () {
            QoreMediaUtils::MediaProviderRegistry::createVideoGenerator(<QoreMediaUtils::VideoGeneratorConfig>{
                "backend": "bfl", "api_key": "fixture-only", "model": "flux-1.1-pro-video"});
        });
    }
}
