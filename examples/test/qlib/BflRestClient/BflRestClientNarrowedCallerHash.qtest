%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires BflRestClient
%requires QoreMediaUtils

#! Exposes the request defaults of the generator; no request is made
class TestBflImageGenerator inherits BflImageGenerator {
    constructor(hash<ImageGeneratorConfig> config) : BflImageGenerator(config) {
    }

    hash<auto> getDefaults() {
        return defaults;
    }
}

%exec-class BflRestClientNarrowedCallerHashTest

#! Option and configuration hashes whose values all have the same type
/** A hash literal whose values all have the same type, such as \c {"apikey": "..."}, has a narrowed type (here
    \c hash<string, string>); the library must still be able to add values of other types to its own copy and report
    the real problem with the configuration.  No request is sent: connections and clients are only created
*/
class BflRestClientNarrowedCallerHashTest inherits QUnit::Test {
    constructor() : Test("BflRestClientNarrowedCallerHashTest", "1.0", \ARGV) {
        addTestCase("option hash without string values", \nonStringOptions());
        addTestCase("image generator provider options", \imageProviderOptions());
        set_return_value(main());
    }

    #! Returns the hash with its runtime type, as a caller's literal arrives in a library function
    static hash<auto> mk(hash<auto> h) {
        return h;
    }

    nonStringOptions() {
        # the options are a hash<string, int>, which cannot take the string values the connection adds
        assertEq("hash<string, int>", mk({"timeout": 30}).fullType());
        # the missing API key is reported, not a type error from adding the options
        assertThrows("CONNECTION-OPTION-ERROR", "apikey", sub () {
            BflRestConnection c({"name": "test", "url": "bfl://api.bfl.ai", "opts": {"timeout": 30}});
        });
    }
    imageProviderOptions() {
        # the provider options are a hash<string, int>, which cannot take the string aspect ratio or output format
        assertEq("hash<string, int>", mk({"seed": 42}).fullType());
        TestBflImageGenerator gen(<ImageGeneratorConfig>{
            "api_key": "test-key",
            "provider_options": {"seed": 42},
            "aspect_ratio": "16:9",
            "output_format": "png",
        });
        assertEq({"seed": 42, "aspect_ratio": "16:9", "output_format": "png"}, gen.getDefaults());
        assertEq(BflRestClient::DefaultImageModel, gen.getModel());
    }
}
