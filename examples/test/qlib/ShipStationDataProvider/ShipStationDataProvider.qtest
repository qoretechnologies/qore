    private testUsersProvider() {
        ShipStationDataProvider::ShipStationDataProvider prov(client);

        # Get users
        AbstractDataProvider usersProvider = prov.getChildProvider("users");
        list<hash<auto>> users = map $1, usersProvider.searchRecords();

