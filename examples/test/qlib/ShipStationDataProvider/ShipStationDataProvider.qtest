    #! Test create/update warehouse actions with cleanup
    private testWarehouseActions() {
        if (m_options.verbose) {
            printf("\n--- Testing Warehouse Create/Update Actions ---\n");
        }

        ShipStationDataProvider::ShipStationDataProvider prov(client);

        string warehouseName = sprintf("Test Warehouse %s", now_us().format("YYYYMMDDHHmmss"));
        *int createdWarehouseId;

        try {
            # Create warehouse
            AbstractDataProvider createWarehouseProvider = prov.getChildProvider("create-warehouse");
            hash<auto> createRequest = {
                "warehouseName": warehouseName,
                "originAddress": {
                    "name": "Test Origin",
                    "street1": "123 Warehouse St",
                    "city": "Austin",
                    "state": "TX",
                    "postalCode": "78701",
                    "country": "US",
                    "phone": "555-123-4567",
                },
                "returnAddress": {
                    "name": "Test Returns",
                    "street1": "123 Warehouse St",
                    "city": "Austin",
                    "state": "TX",
                    "postalCode": "78701",
                    "country": "US",
                    "phone": "555-123-4567",
                },
                "isDefault": False,
            };

            auto createResult = createWarehouseProvider.doRequest(createRequest);
            assertTrue(exists createResult.warehouseId, "Created warehouse should have an ID");
            createdWarehouseId = createResult.warehouseId;
            if (m_options.verbose) {
                printf("  Created warehouse: %s (ID: %d)\n", warehouseName, createdWarehouseId);
            }

            # Update warehouse
            AbstractDataProvider updateWarehouseProvider = prov.getChildProvider("update-warehouse");
            string updatedName = warehouseName + " Updated";
            hash<auto> updateRequest = {
                "warehouseId": createdWarehouseId,
                "warehouseName": updatedName,
                "originAddress": {
                    "name": "Updated Origin",
                    "street1": "456 Updated St",
                    "city": "Dallas",
                    "state": "TX",
                    "postalCode": "75201",
                    "country": "US",
                    "phone": "555-987-6543",
                },
                "returnAddress": {
                    "name": "Updated Returns",
                    "street1": "456 Updated St",
                    "city": "Dallas",
                    "state": "TX",
                    "postalCode": "75201",
                    "country": "US",
                    "phone": "555-987-6543",
                },
                "isDefault": False,
            };

            auto updateResult = updateWarehouseProvider.doRequest(updateRequest);
            # ShipStation may return the warehouse ID or just success
            assertTrue(exists updateResult.warehouseId || updateResult.success ?? True,
                "Update warehouse should succeed");
            if (m_options.verbose) {
                printf("  Updated warehouse name to: %s (result: %y)\n", updatedName, updateResult);
            }

            # Verify update
            AbstractDataProvider getWarehouseProvider = prov.getChildProvider("get-warehouse");
            auto fetchedWarehouse = getWarehouseProvider.doRequest({"warehouseId": createdWarehouseId});
            assertEq(updatedName, fetchedWarehouse.warehouseName, "Warehouse name should be updated");

            # Cleanup: Note - ShipStation API may not support deleting warehouses
            # The warehouse will remain in the account
            if (m_options.verbose) {
                printf("  Note: ShipStation API does not support deleting warehouses\n");
                printf("  Test warehouse %d will remain in the account\n", createdWarehouseId);
            }

        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("  Test failed: %s: %s\n", ex.err, ex.desc);
            }
            rethrow;
        }

        if (m_options.verbose) {
            printf("--- Warehouse Create/Update tests completed ---\n");
        }
    }

