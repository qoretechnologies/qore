            return;
        }

        int testTagId = tags[0].tagId;
        string testTagName = tags[0].name ?? "Unknown";
        if (m_options.verbose) {
            printf("  Using tag: %s (ID: %d)\n", testTagName, testTagId);
        }

        # Create a test order
        string testOrderNumber = sprintf("TAG_TEST_%s_%d",
            now_us().format("YYYYMMDDHHmmss"), rand() % 10000);

        AbstractDataProvider createOrderProvider = prov.getChildProvider("create-order");
        hash<auto> createRequest = {
            "orderNumber": testOrderNumber,
            "orderDate": now(),
            "orderStatus": "awaiting_shipment",
            "billTo": {
                "name": "Tag Test Customer",
                "street1": "123 Tag Street",
                "city": "Austin",
                "state": "TX",
                "postalCode": "78701",
                "country": "US",
            },
            "shipTo": {
                "name": "Tag Test Customer",
                "street1": "123 Tag Street",
                "city": "Austin",
                "state": "TX",
                "postalCode": "78701",
                "country": "US",
            },
            "weight": {
                "value": 1.0,
                "units": "pounds",
            },
        };

        int orderId;
        try {
            auto createResult = createOrderProvider.doRequest(createRequest);
            orderId = createResult.orderId ?? 0;
            if (m_options.verbose) {
                printf("  Created test order: %d\n", orderId);
            }

            # Add tag to order
            AbstractDataProvider addTagProvider = prov.getChildProvider("add-tag-to-order");
            auto addResult = addTagProvider.doRequest({
                "orderId": orderId,
                "tagId": testTagId,
            });
            assertTrue(addResult.success ?? True, "Add tag should succeed");
            if (m_options.verbose) {
                printf("  Added tag %s to order %d\n", testTagName, orderId);
            }

            # Remove tag from order
            AbstractDataProvider removeTagProvider = prov.getChildProvider("remove-tag-from-order");
            auto removeResult = removeTagProvider.doRequest({
                "orderId": orderId,
                "tagId": testTagId,
            });
            assertTrue(removeResult.success ?? True, "Remove tag should succeed");
            if (m_options.verbose) {
                printf("  Removed tag %s from order %d\n", testTagName, orderId);
            }

            # Cleanup
            AbstractDataProvider deleteOrderProvider = prov.getChildProvider("delete-order");
            deleteOrderProvider.doRequest({"orderId": orderId});
            if (m_options.verbose) {
                printf("  Cleaned up test order: %d\n", orderId);
            }

        } catch (hash<ExceptionInfo> ex) {
            # Cleanup on failure
            if (orderId) {
                try {
                    AbstractDataProvider deleteOrderProvider = prov.getChildProvider("delete-order");
                    deleteOrderProvider.doRequest({"orderId": orderId});
                } catch () {}
            }
            if (m_options.verbose) {
                printf("  Test failed: %s: %s\n", ex.err, ex.desc);
            }
            rethrow;
        }

        if (m_options.verbose) {
            printf("--- Order Tag Operations tests completed ---\n");
        }
    }

