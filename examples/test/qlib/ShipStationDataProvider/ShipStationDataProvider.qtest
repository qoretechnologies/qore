    #! Test assign/unassign user to order with cleanup
    private testUserAssignment() {
        if (m_options.verbose) {
            printf("\n--- Testing User Assignment Actions ---\n");
        }

        ShipStationDataProvider::ShipStationDataProvider prov(client);

        # First get a user
        AbstractDataProvider usersProvider = prov.getChildProvider("users");
        list<hash<auto>> users = map $1, usersProvider.searchRecords();

        if (users.size() == 0) {
            if (m_options.verbose) {
                printf("  Skipping: No users available\n");
            }
            return;
        }

        string userId = users[0].userId;
        if (m_options.verbose) {
            printf("  Using user: %y (ID: %y)\n", users[0].name ?? users[0].userName ?? "N/A", userId);
        }

        # Create a test order
        string testOrderNumber = sprintf("USER_ASSIGN_TEST_%s_%d",
            now_us().format("YYYYMMDDHHmmss"), rand() % 10000);

        AbstractDataProvider createOrderProvider = prov.getChildProvider("create-order");
        hash<auto> createRequest = {
            "orderNumber": testOrderNumber,
            "orderDate": now(),
            "orderStatus": "awaiting_shipment",
            "billTo": {
                "name": "User Assignment Test",
                "street1": "123 Test Street",
                "city": "Austin",
                "state": "TX",
                "postalCode": "78701",
                "country": "US",
            },
            "shipTo": {
                "name": "User Assignment Test",
                "street1": "123 Test Street",
                "city": "Austin",
                "state": "TX",
                "postalCode": "78701",
                "country": "US",
            },
            "weight": {
                "value": 1.0,
                "units": "pounds",
            },
        };

        *int orderId;
        try {
            auto createResult = createOrderProvider.doRequest(createRequest);
            orderId = createResult.orderId;
            if (m_options.verbose) {
                printf("  Created test order: %d\n", orderId);
            }

            # Assign user to order
            AbstractDataProvider assignUserProvider = prov.getChildProvider("assign-user-to-order");
            auto assignResult = assignUserProvider.doRequest({
                "orderIds": (orderId,),
                "userId": userId,
            });
            assertTrue(assignResult.success ?? True, "Assign user should succeed");
            if (m_options.verbose) {
                printf("  Assigned user %y to order %d\n", userId, orderId);
            }

            # Unassign user from order
            AbstractDataProvider unassignUserProvider = prov.getChildProvider("unassign-user-from-order");
            auto unassignResult = unassignUserProvider.doRequest({
                "orderIds": (orderId,),
            });
            assertTrue(unassignResult.success ?? True, "Unassign user should succeed");
            if (m_options.verbose) {
                printf("  Unassigned user from order %d\n", orderId);
            }

            # Cleanup
            AbstractDataProvider deleteOrderProvider = prov.getChildProvider("delete-order");
            deleteOrderProvider.doRequest({"orderId": orderId});
            if (m_options.verbose) {
                printf("  Cleaned up test order: %d\n", orderId);
            }

        } catch (hash<ExceptionInfo> ex) {
            # Cleanup on failure
            if (orderId) {
                try {
                    AbstractDataProvider deleteOrderProvider = prov.getChildProvider("delete-order");
                    deleteOrderProvider.doRequest({"orderId": orderId});
                } catch () {}
            }
            if (m_options.verbose) {
                printf("  Test failed: %s: %s\n", ex.err, ex.desc);
            }
            rethrow;
        }

        if (m_options.verbose) {
            printf("--- User Assignment tests completed ---\n");
        }
    }

    #! Test make-api-call action
    private testMakeApiCall() {
        if (m_options.verbose) {
            printf("\n--- Testing Make API Call Action ---\n");
        }

        ShipStationDataProvider::ShipStationDataProvider prov(client);

        AbstractDataProvider makeApiCallProvider = prov.getChildProvider("make-api-call");

        # Test GET request to carriers endpoint
        auto result = makeApiCallProvider.doRequest({
            "method": "GET",
            "path": "/carriers",
        });

        assertTrue(result.typeCode() == NT_LIST || result.typeCode() == NT_HASH,
            "make-api-call should return data");
        if (m_options.verbose) {
            printf("  GET /carriers returned %s with %d element(s)\n",
                result.typeCode() == NT_LIST ? "list" : "hash",
                result.typeCode() == NT_LIST ? elements result : elements keys result);
        }

        # Test with query parameters
        auto warehouses = makeApiCallProvider.doRequest({
            "method": "GET",
            "path": "/warehouses",
        });

        assertTrue(warehouses.typeCode() == NT_LIST || warehouses.typeCode() == NT_HASH,
            "make-api-call /warehouses should return data");
        if (m_options.verbose) {
            printf("  GET /warehouses returned %s\n",
                warehouses.typeCode() == NT_LIST ? "list" : "hash");
        }

        if (m_options.verbose) {
            printf("--- Make API Call tests completed ---\n");
        }
    }

    #! Webhook trigger tests
    webhookTriggerTests() {
        checkJson();
        if (!client) {
            testSkip("No ShipStation credentials provided");
            return;
        }

        if (m_options.verbose) {
            printf("\n--- Testing Webhook Trigger Registration/Deregistration ---\n");
        }

        # ============================================
        # Test Order Notify Event Provider
        # ============================================
        if (m_options.verbose) {
            printf("\nTesting ShipStationOrderNotifyEventDataProvider...\n");
        }

        # Test event provider instantiation
        ShipStationDataProvider::ShipStationOrderNotifyEventDataProvider eventProv(client, {});
        assertEq("order-notify", eventProv.getName());

        # Verify provider metadata
        assertTrue(eventProv.getInfo().supports_observable);

        # Test event types
        hash<string, hash<DataProviderMessageInfo>> eventTypes = eventProv.getEventTypes();
        assertTrue(eventTypes.hasKey("order-notify"));
        assertTrue(eventTypes{"order-notify"}.desc.val());

        # Test example event data - now attempts to fetch real data
        auto exampleData = eventProv.getExampleEventData("order-notify");
        assertTrue(exampleData.event.val());
        assertTrue(exampleData.hasKey("resource_url"));
        assertTrue(exampleData.hasKey("orderId"));
        assertTrue(exampleData.hasKey("orderNumber"));
        assertTrue(exampleData.hasKey("orderStatus"));
        assertTrue(exampleData.hasKey("shipTo"));
        assertEq("order-notify", exampleData.event);

        # Check if we got real data (orderId != 12345, which is the fake value)
        bool isRealOrderData = exampleData.orderId != 12345;
        if (m_options.verbose) {
            printf("  Event types: %y\n", keys eventTypes);
            printf("  Example data source: %s\n", isRealOrderData ? "REAL API DATA" : "FAKE FALLBACK DATA");
            printf("  Example orderId: %y, orderNumber: %y\n", exampleData.orderId, exampleData.orderNumber);
        }

        # ============================================
        # Test Ship Notify Event Provider
        # ============================================
        if (m_options.verbose) {
            printf("\nTesting ShipStationShipNotifyEventDataProvider...\n");
        }

        ShipStationDataProvider::ShipStationShipNotifyEventDataProvider shipProv(client, {});
        assertEq("ship-notify", shipProv.getName());
        assertTrue(shipProv.getInfo().supports_observable);

        hash<string, hash<DataProviderMessageInfo>> shipEventTypes = shipProv.getEventTypes();
        assertTrue(shipEventTypes.hasKey("ship-notify"));

        # Test example event data - now attempts to fetch real shipment data
        auto shipExampleData = shipProv.getExampleEventData("ship-notify");
        assertTrue(shipExampleData.event.val());
        assertTrue(shipExampleData.hasKey("shipmentId"));
        assertTrue(shipExampleData.hasKey("trackingNumber"));
        assertTrue(shipExampleData.hasKey("carrierCode"));
        assertEq("ship-notify", shipExampleData.event);

        # Check if we got real data (shipmentId != 12345, which is the fake value)
        bool isRealShipmentData = shipExampleData.shipmentId != 12345;
        if (m_options.verbose) {
            printf("  Event types: %y\n", keys shipEventTypes);
            printf("  Example data source: %s\n", isRealShipmentData ? "REAL API DATA" : "FAKE FALLBACK DATA");
            printf("  Example shipmentId: %y, trackingNumber: %y\n",
                shipExampleData.shipmentId, shipExampleData.trackingNumber);
        }

        # ============================================
        # Test Item Order Notify Event Provider
        # ============================================
        if (m_options.verbose) {
            printf("\nTesting ShipStationItemOrderNotifyEventDataProvider...\n");
        }

        ShipStationDataProvider::ShipStationItemOrderNotifyEventDataProvider itemOrderProv(client, {});
        assertEq("item-order-notify", itemOrderProv.getName());
        assertTrue(itemOrderProv.getInfo().supports_observable);

        hash<string, hash<DataProviderMessageInfo>> itemOrderEventTypes = itemOrderProv.getEventTypes();
        assertTrue(itemOrderEventTypes.hasKey("item-order-notify"));

        # Test example event data - should include items
        auto itemOrderExampleData = itemOrderProv.getExampleEventData("item-order-notify");
        assertTrue(itemOrderExampleData.event.val());
        assertTrue(itemOrderExampleData.hasKey("orderId"));
        assertTrue(itemOrderExampleData.hasKey("items"));
        assertEq("item-order-notify", itemOrderExampleData.event);

        bool isRealItemOrderData = itemOrderExampleData.orderId != 12345;
        if (m_options.verbose) {
            printf("  Event types: %y\n", keys itemOrderEventTypes);
            printf("  Example data source: %s\n", isRealItemOrderData ? "REAL API DATA" : "FAKE FALLBACK DATA");
            printf("  Example orderId: %y, items count: %d\n",
                itemOrderExampleData.orderId,
                itemOrderExampleData.items.typeCode() == NT_LIST ? elements itemOrderExampleData.items : 0);
        }

        # ============================================
        # Test Item Ship Notify Event Provider
        # ============================================
        if (m_options.verbose) {
            printf("\nTesting ShipStationItemShipNotifyEventDataProvider...\n");
        }

        ShipStationDataProvider::ShipStationItemShipNotifyEventDataProvider itemShipProv(client, {});
        assertEq("item-ship-notify", itemShipProv.getName());
        assertTrue(itemShipProv.getInfo().supports_observable);

        hash<string, hash<DataProviderMessageInfo>> itemShipEventTypes = itemShipProv.getEventTypes();
        assertTrue(itemShipEventTypes.hasKey("item-ship-notify"));

        # Test example event data - should include shipment items
        auto itemShipExampleData = itemShipProv.getExampleEventData("item-ship-notify");
        assertTrue(itemShipExampleData.event.val());
        assertTrue(itemShipExampleData.hasKey("shipmentId"));
        assertTrue(itemShipExampleData.hasKey("shipmentItems"));
        assertEq("item-ship-notify", itemShipExampleData.event);

        bool isRealItemShipData = itemShipExampleData.shipmentId != 12345;
        if (m_options.verbose) {
            printf("  Event types: %y\n", keys itemShipEventTypes);
            printf("  Example data source: %s\n", isRealItemShipData ? "REAL API DATA" : "FAKE FALLBACK DATA");
            printf("  Example shipmentId: %y, shipmentItems count: %d\n",
                itemShipExampleData.shipmentId,
                itemShipExampleData.shipmentItems.typeCode() == NT_LIST ? elements itemShipExampleData.shipmentItems : 0);
        }

        if (m_options.verbose) {
            printf("\n--- Webhook Trigger tests completed ---\n");
        }
    }
}

#! Test observer for webhook events
class TestObserver inherits Observer {
    public {
        list<hash<auto>> events = ();
    }

    update(string event_id, hash<auto> data) {
        events += {"event_id": event_id, "data": data};
