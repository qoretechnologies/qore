%require-types
%enable-all-warnings
%new-style
%strict-args

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/DataProvider
%requires ../../../../qlib/ConnectionProvider
%requires ../../../../qlib/RestClient.qm
%requires ../../../../qlib/Mime.qm

%try-module json
%define NoJson
%endtry

%requires ../../../../qlib/ShipStationRestClient.qm
%requires ../../../../qlib/ShipStationDataProvider

%exec-class ShipStationDataProviderTest

public class ShipStationDataProviderTest inherits QUnit::Test {
    private {
        #! ShipStation REST client for integration tests
        *ShipStationRestClient::ShipStationRestClient client;

        #! Logger for verbose output
        Logger logger;

        #! Custom command-line options
        const MyOpts = Opts + {
            "apikey": "k,apikey=s",
            "apisecret": "s,apisecret=s",
            "conn": "c,connection=s",
        };

        #! Test store ID for integration tests
        *int testStoreId;

        #! Test warehouse ID for integration tests
        *int testWarehouseId;

        #! Test carrier code for integration tests
        *string testCarrierCode;

        #! Test order ID created during tests (for cleanup)
        *int testOrderId;
    }

    constructor() : Test("ShipStationDataProvider Test", "1.0", \ARGV, MyOpts) {
        logger = new Logger("test", LoggerLevel::getLevelInfo());

        # Unit tests (always run, no credentials needed)
        addTestCase("sanity tests", \sanityTests());
        addTestCase("factory tests", \factoryTests());
        addTestCase("metadata tests", \metadataTests());
        addTestCase("child provider tests", \childProviderTests());
        addTestCase("data type tests", \dataTypeTests());
        addTestCase("negative tests", \negativeTests());
        addTestCase("corner case tests", \cornerCaseTests());
        addTestCase("connection tests", \connectionTests());
        addTestCase("action catalog tests", \actionCatalogTests());

        # Integration tests (require SHIPSTATION_API_KEY and SHIPSTATION_API_SECRET)
        addTestCase("integration tests", \integrationTests());

        # Webhook trigger tests
        addTestCase("webhook trigger tests", \webhookTriggerTests());

        # Try to set up connection for integration tests
        try {
            setupConnection();
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("Connection setup failed: %s: %s\n", ex.err, ex.desc);
            }
        }

        set_return_value(main());
    }

    #! Sets up the ShipStation client for integration tests
    private setupConnection() {
        *string apikey = m_options.apikey ?? ENV.SHIPSTATION_API_KEY;
        *string apisecret = m_options.apisecret ?? ENV.SHIPSTATION_API_SECRET;
        if (!apikey || !apisecret) {
            if (m_options.verbose) {
                printf("No API credentials provided (use -k/-s options or SHIPSTATION_API_KEY/SHIPSTATION_API_SECRET env vars)\n");
            }
            return;
        }
        hash<auto> opts = {
            "api_key": apikey,
            "api_secret": apisecret,
        };
        client = new ShipStationRestClient::ShipStationRestClient(opts);
    }

    #! Check if json module is available
    private checkJson() {
%ifdef NoJson
        testSkip("no json module present");
%endif
    }

    #! Basic sanity tests - provider instantiation
    sanityTests() {
        checkJson();
        # Test creating provider with fake credentials
        ShipStationDataProvider::ShipStationDataProvider prov({
            "api_key": "fake-key-for-testing",
            "api_secret": "fake-secret-for-testing",
        });
        assertEq("shipstation", prov.getName());
        assertEq("ShipStation data provider for shipping and logistics management", prov.getDesc());
    }

    #! Factory tests - verify factory registration
    factoryTests() {
        checkJson();
        # Verify factory is registered
        AbstractDataProviderFactory factory = DataProvider::getFactory("shipstation");
        assertEq("shipstation", factory.getInfo().name);
        assertEq("ShipStation data provider factory", factory.getInfo().desc);
        assertTrue(factory.getInfo().children_can_support_apis);
        assertTrue(factory.getInfo().children_can_support_records);

        # Verify factory can create provider with options
        hash<auto> factoryOpts = factory.getInfo().provider_info.constructor_options;
        assertTrue(factoryOpts.hasKey("api_key"));
        assertTrue(factoryOpts.hasKey("api_secret"));
        assertTrue(factoryOpts.hasKey("shipstationrestclient"));
        assertTrue(factoryOpts.hasKey("shipstationrestclient_options"));
    }

    #! Metadata tests - verify provider info structure
    metadataTests() {
        checkJson();
        ShipStationDataProvider::ShipStationDataProvider prov({
            "api_key": "x",
            "api_secret": "y",
        });
        hash<DataProviderInfo> info = prov.getInfo();

        assertTrue(info.supports_children);
        assertTrue(info.children_can_support_apis);
        assertTrue(info.children_can_support_records);
        assertEq("ShipStationDataProvider", info.type);

        # Check constructor options
        assertTrue(info.constructor_options.hasKey("api_key"));
        assertTrue(info.constructor_options.hasKey("api_secret"));
        assertTrue(info.constructor_options.hasKey("shipstationrestclient"));
    }

    #! Child provider tests - verify hierarchy
    childProviderTests() {
        checkJson();
        ShipStationDataProvider::ShipStationDataProvider prov({
            "api_key": "x",
            "api_secret": "y",
        });

        # Check child provider names
        list<string> children = prov.getChildProviderNames();

        # Collection providers
        assertTrue(children.contains("orders"));
        assertTrue(children.contains("carriers"));
        assertTrue(children.contains("customers"));
        assertTrue(children.contains("products"));
        assertTrue(children.contains("shipments"));
        assertTrue(children.contains("fulfillments"));
        assertTrue(children.contains("stores"));
        assertTrue(children.contains("warehouses"));
        assertTrue(children.contains("users"));
        assertTrue(children.contains("tags"));
        assertTrue(children.contains("marketplaces"));

        # Action providers
        assertTrue(children.contains("get-order"));
        assertTrue(children.contains("create-order"));
        assertTrue(children.contains("update-order"));
        assertTrue(children.contains("delete-order"));
        assertTrue(children.contains("mark-order-as-shipped"));
        assertTrue(children.contains("add-tag-to-order"));
        assertTrue(children.contains("remove-tag-from-order"));
        assertTrue(children.contains("assign-user-to-order"));
        assertTrue(children.contains("unassign-user-from-order"));
        assertTrue(children.contains("get-carrier"));
        assertTrue(children.contains("list-services"));
        assertTrue(children.contains("list-packages"));
        assertTrue(children.contains("add-funds"));
        assertTrue(children.contains("get-customer"));
        assertTrue(children.contains("get-product"));
        assertTrue(children.contains("update-product"));
        assertTrue(children.contains("void-label"));
        assertTrue(children.contains("get-store"));
        assertTrue(children.contains("update-store"));
        assertTrue(children.contains("deactivate-store"));
        assertTrue(children.contains("reactivate-store"));
        assertTrue(children.contains("refresh-store"));
        assertTrue(children.contains("get-warehouse"));
        assertTrue(children.contains("create-warehouse"));
        assertTrue(children.contains("update-warehouse"));
        assertTrue(children.contains("make-api-call"));
        assertTrue(children.contains("events"));

        # Check orders child provider
        AbstractDataProvider orders = prov.getChildProvider("orders");
        assertEq("orders", orders.getName());
        hash<DataProviderInfo> ordersInfo = orders.getInfo();
        assertTrue(ordersInfo.supports_read);
        assertTrue(ordersInfo.supports_native_search);
        assertTrue(ordersInfo.has_record);

        # Check create-order child provider
        AbstractDataProvider createOrder = prov.getChildProvider("create-order");
        assertEq("create-order", createOrder.getName());
        hash<DataProviderInfo> createOrderInfo = createOrder.getInfo();
        assertTrue(createOrderInfo.supports_request);

        # Check events child provider
        AbstractDataProvider events = prov.getChildProvider("events");
        assertEq("events", events.getName());
        hash<DataProviderInfo> eventsInfo = events.getInfo();
        assertTrue(eventsInfo.supports_children);
        assertTrue(eventsInfo.children_can_support_observers);

        # Check events child providers
        list<string> eventChildren = events.getChildProviderNames();
        assertTrue(eventChildren.contains("order-notify"));
        assertTrue(eventChildren.contains("item-order-notify"));
        assertTrue(eventChildren.contains("ship-notify"));
        assertTrue(eventChildren.contains("item-ship-notify"));
    }

    #! Data type tests - verify record type definitions
    dataTypeTests() {
        checkJson();
        # Test order data type
        ShipStationDataProvider::ShipStationOrderDataType orderType();
        hash<string, AbstractDataField> orderFields = orderType.getFields();
        assertTrue(orderFields.hasKey("orderId"));
        assertTrue(orderFields.hasKey("orderNumber"));
        assertTrue(orderFields.hasKey("orderStatus"));
        assertTrue(orderFields.hasKey("orderDate"));
        assertTrue(orderFields.hasKey("shipTo"));
        assertTrue(orderFields.hasKey("items"));

        # Test address data type
        ShipStationDataProvider::ShipStationAddressDataType addressType();
        hash<string, AbstractDataField> addressFields = addressType.getFields();
        assertTrue(addressFields.hasKey("name"));
        assertTrue(addressFields.hasKey("street1"));
        assertTrue(addressFields.hasKey("city"));
        assertTrue(addressFields.hasKey("state"));
        assertTrue(addressFields.hasKey("postalCode"));
        assertTrue(addressFields.hasKey("country"));

        # Test carrier data type
        ShipStationDataProvider::ShipStationCarrierDataType carrierType();
        hash<string, AbstractDataField> carrierFields = carrierType.getFields();
        assertTrue(carrierFields.hasKey("code"));
        assertTrue(carrierFields.hasKey("name"));
        assertTrue(carrierFields.hasKey("accountNumber"));
        assertTrue(carrierFields.hasKey("shippingProviderId"));

        # Test warehouse data type
        ShipStationDataProvider::ShipStationWarehouseDataType warehouseType();
        hash<string, AbstractDataField> warehouseFields = warehouseType.getFields();
        assertTrue(warehouseFields.hasKey("warehouseId"));
        assertTrue(warehouseFields.hasKey("warehouseName"));
        assertTrue(warehouseFields.hasKey("originAddress"));
        assertTrue(warehouseFields.hasKey("isDefault"));

        # Test event data types
        ShipStationDataProvider::ShipStationOrderNotifyEventDataType orderEventType();
        hash<string, AbstractDataField> orderEventFields = orderEventType.getFields();
        assertTrue(orderEventFields.hasKey("event"));
        assertTrue(orderEventFields.hasKey("resource_url"));
        assertTrue(orderEventFields.hasKey("orderId"));
        assertTrue(orderEventFields.hasKey("orderNumber"));

        ShipStationDataProvider::ShipStationShipNotifyEventDataType shipEventType();
        hash<string, AbstractDataField> shipEventFields = shipEventType.getFields();
        assertTrue(shipEventFields.hasKey("event"));
        assertTrue(shipEventFields.hasKey("resource_url"));
        assertTrue(shipEventFields.hasKey("shipmentId"));
        assertTrue(shipEventFields.hasKey("trackingNumber"));
    }

    #! Negative tests - test error handling and invalid inputs
    negativeTests() {
        checkJson();
        ShipStationDataProvider::ShipStationDataProvider prov({
            "api_key": "invalid-key",
            "api_secret": "invalid-secret",
        });

        # Test getting non-existent child provider
        assertThrows("INVALID-CHILD-PROVIDER", sub() {
            prov.getChildProviderEx("nonexistent");
        });

        # Test invalid child in events provider
        AbstractDataProvider events = prov.getChildProvider("events");
        assertThrows("INVALID-CHILD-PROVIDER", sub() {
            events.getChildProviderEx("invalid-event-type");
        });
    }

    #! Corner case tests - edge cases and boundary conditions
    cornerCaseTests() {
        checkJson();
        # Test REST client URL
        ShipStationRestClient::ShipStationRestClient client1({
            "api_key": "x",
            "api_secret": "y",
        });
        assertTrue(client1.getURL() =~ /ssapi\.shipstation\.com$/);

        # Test missing credentials throws error
        assertThrows("SHIPSTATION-ERROR", sub() {
            new ShipStationRestClient::ShipStationRestClient({});
        });

        assertThrows("SHIPSTATION-ERROR", sub() {
            new ShipStationRestClient::ShipStationRestClient({"api_key": "x"});
        });

        assertThrows("SHIPSTATION-ERROR", sub() {
            new ShipStationRestClient::ShipStationRestClient({"api_secret": "y"});
        });
    }

    #! Connection tests - verify connection scheme registration
    connectionTests() {
        checkJson();
        # Verify connection scheme is registered
        hash<ConnectionSchemeInfo> scheme = ConnectionSchemeCache::getScheme("shipstation");
        assertEq("ShipStation REST Connection", scheme.display_name);
        assertTrue(scheme.options.hasKey("api_key"));
        assertTrue(scheme.options.hasKey("api_secret"));
        assertTrue(scheme.options."api_key".sensitive);
        assertTrue(scheme.options."api_secret".sensitive);

        # Verify connection can create data provider
        ShipStationRestClient::ShipStationRestConnection conn("test", "test connection",
            "shipstation://ssapi.shipstation.com", {}, {"api_key": "x", "api_secret": "y"});
        assertTrue(conn.hasDataProvider());
        assertEq("ShipStation", conn.getAppName());
        assertEq("shipstation", conn.getType());
    }

    #! Action catalog tests - verify all actions are registered
    actionCatalogTests() {
        checkJson();
        # Get all actions for the ShipStation app
        *list<hash<DataProviderActionInfo>> actions = DataProviderActionCatalog::getActions(
            ShipStationDataProvider::AppName);
        assertTrue(actions.size() > 0);

        # Verify action names
        list<string> actionNames = map $1.action, actions;

        # Order actions
        assertTrue(actionNames.contains("list-orders"));
        assertTrue(actionNames.contains("get-order"));
        assertTrue(actionNames.contains("create-order"));
        assertTrue(actionNames.contains("update-order"));
        assertTrue(actionNames.contains("delete-order"));
        assertTrue(actionNames.contains("mark-order-as-shipped"));
        assertTrue(actionNames.contains("add-tag-to-order"));
        assertTrue(actionNames.contains("remove-tag-from-order"));
        assertTrue(actionNames.contains("assign-user-to-order"));
        assertTrue(actionNames.contains("unassign-user-from-order"));

        # Carrier actions
        assertTrue(actionNames.contains("list-carriers"));
        assertTrue(actionNames.contains("get-carrier"));
        assertTrue(actionNames.contains("list-services"));
        assertTrue(actionNames.contains("list-packages"));
        assertTrue(actionNames.contains("add-funds"));

        # Customer and product actions
        assertTrue(actionNames.contains("list-customers"));
        assertTrue(actionNames.contains("get-customer"));
        assertTrue(actionNames.contains("list-products"));
        assertTrue(actionNames.contains("get-product"));
        assertTrue(actionNames.contains("update-product"));

        # Shipment actions
        assertTrue(actionNames.contains("list-shipments"));
        assertTrue(actionNames.contains("list-fulfillments"));
        assertTrue(actionNames.contains("void-label"));

        # Store actions
        assertTrue(actionNames.contains("list-stores"));
        assertTrue(actionNames.contains("get-store"));
        assertTrue(actionNames.contains("update-store"));
        assertTrue(actionNames.contains("deactivate-store"));
        assertTrue(actionNames.contains("reactivate-store"));
        assertTrue(actionNames.contains("refresh-store"));
        assertTrue(actionNames.contains("list-marketplaces"));

        # Warehouse actions
        assertTrue(actionNames.contains("list-warehouses"));
        assertTrue(actionNames.contains("get-warehouse"));
        assertTrue(actionNames.contains("create-warehouse"));
        assertTrue(actionNames.contains("update-warehouse"));

        # Other actions
        assertTrue(actionNames.contains("list-tags"));
        assertTrue(actionNames.contains("list-users"));
        assertTrue(actionNames.contains("make-api-call"));

        # Trigger actions
        assertTrue(actionNames.contains("order-notify"));
        assertTrue(actionNames.contains("item-order-notify"));
        assertTrue(actionNames.contains("ship-notify"));
        assertTrue(actionNames.contains("item-ship-notify"));

        # Verify trigger actions have correct action_code
        *hash<DataProviderActionInfo> orderNotifyAction = DataProviderActionCatalog::getAppAction(
            ShipStationDataProvider::AppName, "order-notify");
        assertTrue(exists orderNotifyAction, "order-notify action should exist");
        assertEq(DPAT_EVENT, orderNotifyAction.action_code);
    }

    #! Integration tests - require SHIPSTATION_API_KEY and SHIPSTATION_API_SECRET
    integrationTests() {
        checkJson();
        if (!client) {
            testSkip("No ShipStation credentials provided (use -k/-s options or SHIPSTATION_API_KEY/SHIPSTATION_API_SECRET env vars)");
            return;
        }

        # Test API connectivity
        testApiConnectivity();

        # Test carriers provider
        testCarriersProvider();

        # Test stores provider
        testStoresProvider();

        # Test warehouses provider
        testWarehousesProvider();

        # Test tags provider
        testTagsProvider();

        # Test users provider
        testUsersProvider();

        # Test reference data
        testReferenceData();

        # Test order data integrity
        testOrderDataIntegrity();
    }

    #! Test API connectivity
    private testApiConnectivity() {
        # Test that we can connect to the API
        hash<auto> response = client.get("/carriers");
        assertTrue(response.body.typeCode() == NT_LIST || response.body.typeCode() == NT_HASH);
        if (m_options.verbose) {
            printf("Connected to ShipStation API successfully\n");
        }
    }

    #! Test carriers provider
    private testCarriersProvider() {
        ShipStationDataProvider::ShipStationDataProvider prov(client);

        # Get carriers
        AbstractDataProvider carriersProvider = prov.getChildProvider("carriers");
        list<hash<auto>> carriers = map $1, carriersProvider.searchRecords();

        if (m_options.verbose) {
            printf("Found %d carriers\n", carriers.size());
        }

        # Store first carrier for further tests
        if (carriers.size() > 0) {
            testCarrierCode = carriers[0].code;
            if (m_options.verbose) {
                printf("Using carrier: %s (%s)\n", carriers[0].name ?? "N/A", carriers[0].code);
            }
        }
    }

