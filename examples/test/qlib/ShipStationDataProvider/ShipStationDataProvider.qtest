    #! Test users provider
    private testUsersProvider() {
        ShipStationDataProvider::ShipStationDataProvider prov(client);

        # Get users
        AbstractDataProvider usersProvider = prov.getChildProvider("users");
        list<hash<auto>> users = map $1, usersProvider.searchRecords();

        if (m_options.verbose) {
            printf("Found %d users\n", users.size());
        }
    }

    #! Test reference data
    private testReferenceData() {
        ShipStationDataProvider::ShipStationDataProvider prov(client);

        # Test carriers reference data
        *list<hash<AllowedValueInfo>> carriers = prov.getReferenceData("carriers");
        if (carriers && carriers.size() > 0) {
            assertTrue(carriers[0].display_name.val());
            assertTrue(carriers[0].value.val());
            if (m_options.verbose) {
                printf("Reference data: %d carriers available\n", carriers.size());
            }
        }

        # Test stores reference data
        *list<hash<AllowedValueInfo>> stores = prov.getReferenceData("stores");
        if (stores && stores.size() > 0) {
            assertTrue(stores[0].display_name.val());
            assertTrue(exists stores[0].value);
            if (m_options.verbose) {
                printf("Reference data: %d stores available\n", stores.size());
            }
        }

        # Test warehouses reference data
        *list<hash<AllowedValueInfo>> warehouses = prov.getReferenceData("warehouses");
        if (warehouses && warehouses.size() > 0) {
            assertTrue(warehouses[0].display_name.val());
            assertTrue(exists warehouses[0].value);
            if (m_options.verbose) {
                printf("Reference data: %d warehouses available\n", warehouses.size());
            }
        }

        # Test tags reference data
        *list<hash<AllowedValueInfo>> tags = prov.getReferenceData("tags");
        if (tags && tags.size() > 0) {
            assertTrue(tags[0].display_name.val());
            assertTrue(exists tags[0].value);
            if (m_options.verbose) {
                printf("Reference data: %d tags available\n", tags.size());
            }
        }

        # Test users reference data
        *list<hash<AllowedValueInfo>> users = prov.getReferenceData("users");
        if (users && users.size() > 0) {
            assertTrue(users[0].display_name.val());
            assertTrue(exists users[0].value);
            if (m_options.verbose) {
                printf("Reference data: %d users available\n", users.size());
            }
        }
    }

    #! Test order data integrity - verifies data actually persists
    /** CRITICAL: This test verifies that order data is correctly saved and retrievable.
        This catches issues like:
        - Wrong Content-Type
        - Silent API acceptance without data persistence
        - Incorrect field handling

        The test creates an order with known values, retrieves it, and verifies the values match.
    */
    private testOrderDataIntegrity() {
        if (m_options.verbose) {
            printf("\n--- Testing Order Data Integrity ---\n");
        }

        ShipStationDataProvider::ShipStationDataProvider prov(client);

        # Generate unique test order number
        string testOrderNumber = sprintf("TEST_%s_%d",
            now_us().format("YYYYMMDDHHmmss"), rand() % 10000);

        # Test 1: Create order
        if (m_options.verbose) {
            printf("\nTest 1: Create order...\n");
        }

        AbstractDataProvider createOrderProvider = prov.getChildProvider("create-order");
        hash<auto> createRequest = {
            "orderNumber": testOrderNumber,
            "orderDate": now(),
            "orderStatus": "awaiting_shipment",
            "customerEmail": "test@example.com",
            "billTo": {
                "name": "Test Customer",
                "street1": "123 Test Street",
                "city": "Austin",
                "state": "TX",
                "postalCode": "78701",
                "country": "US",
            },
            "shipTo": {
                "name": "Test Customer",
                "street1": "123 Test Street",
                "city": "Austin",
                "state": "TX",
                "postalCode": "78701",
                "country": "US",
            },
            "weight": {
                "value": 1.0,
                "units": "pounds",
            },
            "advancedOptions": {
                "storeId": testStoreId,
            },
        };

        try {
            auto createResult = createOrderProvider.doRequest(createRequest);
            if (m_options.verbose) {
                printf("  Create result: orderId=%y\n", createResult.orderId);
            }
            assertTrue(exists createResult.orderId, "Order should be created with an ID");
            testOrderId = createResult.orderId;

            # Verify the data was actually saved by fetching it back
            AbstractDataProvider getOrderProvider = prov.getChildProvider("get-order");
            hash<auto> getRequest = {
                "orderId": testOrderId,
            };

            auto fetchedOrder = getOrderProvider.doRequest(getRequest);
            if (m_options.verbose) {
                printf("  Fetched order: orderNumber=%y, orderStatus=%y\n",
                    fetchedOrder.orderNumber, fetchedOrder.orderStatus);
            }

            assertEq(testOrderNumber, fetchedOrder.orderNumber, "Order number should match");
            assertEq("awaiting_shipment", fetchedOrder.orderStatus, "Order status should match");
            assertEq("Test Customer", fetchedOrder.shipTo.name, "Ship-to name should match");
            assertEq("Austin", fetchedOrder.shipTo.city, "Ship-to city should match");
            assertEq("TX", fetchedOrder.shipTo.state, "Ship-to state should match");
            assertEq("78701", fetchedOrder.shipTo.postalCode, "Ship-to postal code should match");

            if (m_options.verbose) {
                printf("  Data integrity verified: order saved and retrieved correctly\n");
            }

            # Cleanup: delete the test order
            AbstractDataProvider deleteOrderProvider = prov.getChildProvider("delete-order");
            hash<auto> deleteRequest = {
                "orderId": testOrderId,
            };

            try {
                deleteOrderProvider.doRequest(deleteRequest);
                if (m_options.verbose) {
                    printf("\nCleaned up test order: %d\n", testOrderId);
                }
                testOrderId = NOTHING;
            } catch (hash<ExceptionInfo> ex) {
                if (m_options.verbose) {
                    printf("Cleanup failed: %s\n", ex.desc);
                }
            }

        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("  Create order failed: %s: %s\n", ex.err, ex.desc);
            }
            rethrow;
        }

        if (m_options.verbose) {
            printf("--- Order Data Integrity tests completed ---\n");
        }
    }

    #! Test order update functionality
    /** Tests that the update-order provider can successfully make API calls.
        Note: ShipStation's createorder API creates or updates based on orderKey.
        This test verifies the provider works, not ShipStation's internal update behavior.
    */
    private testUpdateOrder() {
        if (m_options.verbose) {
            printf("\n--- Testing Order Update Provider ---\n");
        }

        ShipStationDataProvider::ShipStationDataProvider prov(client);

        # Generate unique test order number/key
        string testOrderKey = sprintf("UPDATE_TEST_%s_%d",
            now_us().format("YYYYMMDDHHmmss"), rand() % 10000);

        # Create an order with a known orderKey
        AbstractDataProvider createOrderProvider = prov.getChildProvider("create-order");
        hash<auto> createRequest = {
            "orderNumber": testOrderKey,
            "orderKey": testOrderKey,  # Set orderKey explicitly for update matching
            "orderDate": now(),
            "orderStatus": "awaiting_shipment",
            "billTo": {
                "name": "Original Customer",
                "street1": "100 Original Street",
                "city": "Austin",
                "state": "TX",
                "postalCode": "78701",
                "country": "US",
            },
            "shipTo": {
                "name": "Original Customer",
                "street1": "100 Original Street",
                "city": "Austin",
                "state": "TX",
                "postalCode": "78701",
                "country": "US",
            },
            "weight": {
                "value": 1.0,
                "units": "pounds",
            },
        };

        int orderId;
        try {
            auto createResult = createOrderProvider.doRequest(createRequest);
            orderId = createResult.orderId ?? 0;
            assertTrue(orderId > 0, "Order should be created with an ID");
            if (m_options.verbose) {
                printf("  Created order: %d with orderKey: %s\n", orderId, testOrderKey);
            }

            # Test update-order provider - verify it can make API calls
            AbstractDataProvider updateOrderProvider = prov.getChildProvider("update-order");
            hash<auto> updateRequest = {
                "orderId": orderId,
                "orderKey": testOrderKey,
                "orderNumber": testOrderKey,
                "orderDate": now(),
                "orderStatus": "on_hold",
                "shipTo": {
                    "name": "Updated Customer",
                    "street1": "200 Updated Avenue",
                    "city": "Dallas",
                    "state": "TX",
                    "postalCode": "75201",
                    "country": "US",
                },
                "billTo": {
                    "name": "Updated Customer",
                    "street1": "200 Updated Avenue",
                    "city": "Dallas",
                    "state": "TX",
                    "postalCode": "75201",
                    "country": "US",
                },
                "weight": {
                    "value": 1.5,
                    "units": "pounds",
                },
            };

            auto updateResult = updateOrderProvider.doRequest(updateRequest);
            assertTrue(exists updateResult.orderId, "Update should return an order ID");
            if (m_options.verbose) {
                printf("  Update call succeeded, returned orderId: %y\n", updateResult.orderId);
            }

            # Cleanup - delete both the original and any newly created order
            AbstractDataProvider deleteOrderProvider = prov.getChildProvider("delete-order");
            deleteOrderProvider.doRequest({"orderId": orderId});
            if (updateResult.orderId != orderId) {
                # If a new order was created, delete it too
                try {
                    deleteOrderProvider.doRequest({"orderId": updateResult.orderId});
                } catch () {}
            }
            if (m_options.verbose) {
                printf("  Cleaned up test order(s)\n");
            }

        } catch (hash<ExceptionInfo> ex) {
            # Cleanup on failure
            if (orderId) {
                try {
                    AbstractDataProvider deleteOrderProvider = prov.getChildProvider("delete-order");
                    deleteOrderProvider.doRequest({"orderId": orderId});
                } catch () {}
            }
            if (m_options.verbose) {
                printf("  Test failed: %s: %s\n", ex.err, ex.desc);
            }
            rethrow;
        }

        if (m_options.verbose) {
            printf("--- Order Update tests completed ---\n");
        }
    }

    #! Test order tag operations (add-tag-to-order, remove-tag-from-order)
    private testOrderTagOperations() {
        if (m_options.verbose) {
            printf("\n--- Testing Order Tag Operations ---\n");
