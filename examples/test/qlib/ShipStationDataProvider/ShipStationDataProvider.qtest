        # Get stores
        AbstractDataProvider storesProvider = prov.getChildProvider("stores");
        list<hash<auto>> stores = map $1, storesProvider.searchRecords();

        if (m_options.verbose) {
            printf("Found %d stores\n", stores.size());
        }

        # Store first store for further tests
        if (stores.size() > 0) {
            testStoreId = stores[0].storeId;
            if (m_options.verbose) {
                printf("Using store: %s (ID: %d)\n", stores[0].storeName ?? "N/A", stores[0].storeId);
            }
        }
    }

