%exec-class CohereDataProviderTest

class FakeCohereRestClientIo inherits RestClientIo::RestClientIo {
    public {
        *hash<auto> last_request;
        string last_method;
        string last_path;
        hash<auto> response_body = {};
        *data last_raw;
        *hash<auto> last_headers;
        int requests = 0;
    }

    constructor() : RestClientIo({"url": "https://api.cohere.com", "token": "x"}) {
    }

    RestClient::AbstractRestClient copyWithUrl(string new_url) {
        return self;
    }

    hash<RestClient::RestResponseInfo> restDoRawRequest(string method, string path, *data body,
            *hash<auto> hdr) {
        last_method = method;
        last_path = path;
        last_raw = body;
        last_headers = hdr;
        ++requests;
        last_request = body.val() && (hdr."Content-Type" ?? hdr."content-type" ?? "") !~ /^multipart\//
            ? parse_json(body.toString()) : NOTHING;
        return <RestClient::RestResponseInfo>{"status_code": 200, "body": response_body};
    }

    hash<RestClient::RestResponseInfo> restDoRequest(string method, string path,
            auto body, *hash<auto> hdr) {
        last_method = method;
        last_path = path;
        last_request = body;
        return <RestClient::RestResponseInfo>{"body": response_body};
    }

    hash<RestClient::RestResponseInfo> restGet(string path, *hash<auto> hdr) {
        return restDoRequest("GET", path, NOTHING, hdr);
    }

    hash<RestClient::RestResponseInfo> restPost(string path, auto body,
            *hash<auto> hdr) {
        return restDoRequest("POST", path, body, hdr);
    }

    hash<RestClient::RestResponseInfo> restDel(string path, auto body,
            *hash<auto> hdr) {
        return restDoRequest("DELETE", path, body, hdr);
    }

    string getSafeUrl() {
        return "https://api.cohere.com";
    }
}

#! Local HTTP fixture for verifying actual request paths, headers, and multipart payloads
class CohereWireHandler inherits AbstractHttpRequestHandler {
    private {
        Mutex lock();
        hash<auto> request;
        *data request_body;
    }
    hash handleRequest(hash cx, hash hdr, *data body) {
        AutoLock al(lock);
        request = hdr;
        request_body = body;
        return makeResponse(200, "{}", {"Content-Type": MimeTypeJson});
    }
    hash<auto> getRequest() {
        AutoLock al(lock);
        return request;
    }
    *data getBody() {
        AutoLock al(lock);
        return request_body;
    }
}

public class CohereDataProviderTest inherits QUnit::Test {
    public {
        const MyOpts = Opts + {
            "conn": "c,connection=s",
        };

        const OptionColumn = 22;

        const Requests = {
            "chat": {
                "model": "command-a-03-2025",
                "messages": ({
                    "role": "user",
                    "content": "Hello",
                },),
            },
            "embed": {
                "model": "embed-v4.0",
                "texts": ("Invoice paid",),
                "input_type": "search_document",
            },
            "rerank": {
                "model": "rerank-v3.5",
                "query": "invoice",
                "documents": ("Invoice paid", "Appointment changed",),
            },
            "classify": {
                "inputs": ("A positive comment",),
                "model": "classification-model",
                "examples": ({
                    "text": "Great",
                    "label": "positive",
                }, {
                    "text": "Bad",
                    "label": "negative",
                },),
            },
            "list-models": {
                "endpoint": "chat",
                "page_size": 2,
            },
            "get-model": {
                "model": "command-a-03-2025",
            },
            "tokenize": {
                "model": "command-a-03-2025",
                "text": "Invoice paid",
            },
            "detokenize": {
                "model": "command-a-03-2025",
                "tokens": (10, 20,),
            },
            "parse": {
                "model": "parse-v5.0",
                "document": {
                    "type": "image_url",
                    "image_url": "https://example.org/invoice.png",
                },
                "output_format": "blocks",
            },
            "transcribe": {
                "model": "cohere-transcribe-03-2026",
                "language": "en",
                "file": binary("RIFFcohere-audio"),
            },
            "create-dataset": {
                "name": "Invoices",
                "type": "embed-input",
                "data": binary("{\"text\":\"Invoice paid\"}\n"),
            },
            "list-datasets": {
                "limit": 2,
                "offset": 0,
            },
            "get-dataset": {
                "id": "dataset-1",
            },
            "delete-dataset": {
                "id": "dataset-1",
            },
            "get-dataset-usage": {},
            "create-embed-job": {
                "model": "embed-v4.0",
                "dataset_id": "dataset-1",
                "input_type": "search_document",
            },
            "list-embed-jobs": {},
            "get-embed-job": {
                "id": "job-1",
            },
            "cancel-embed-job": {
                "id": "job-1",
            },
            "create-batch": {
                "name": "Invoices",
                "input_dataset_id": "dataset-1",
                "model": "command-a-03-2025",
            },
            "list-batches": {
                "page_size": 2,
            },
            "get-batch": {
                "id": "batch-1",
            },
            "cancel-batch": {
                "id": "batch-1",
            },
            "check-api-key": {},
        };
    }

    private {
        *string conn_name;
    }

    constructor() : Test("CohereDataProvider Test", "1.0", \ARGV, MyOpts) {
        conn_name = m_options.conn ?? ENV.COHERE_CONNECTION;

        addTestCase("factory + app + 24 actions registered", \registrationTest());
        addTestCase("root provider resolves all 24 action paths",       \rootProviderTest());
        addTestCase("chat hits /v2/chat",                   \chatRequestTest());
        addTestCase("embed injects embedding_types default", \embedRequestTest());
        addTestCase("rerank hits /v2/rerank",               \rerankRequestTest());
        addTestCase("classify uses absolute /v1/classify path",
            \classifyRequestTest());

        addTestCase("all API operations serialize valid requests", \allOperationsTest());
        addTestCase("complete types, enums, and reference metadata", \contractTest());
        addTestCase("model and object dropdowns use their listing endpoints", \referenceDataTest());
        addTestCase("invalid and incomplete requests never reach the transport", \negativeTest());
        addTestCase("HTTP routes, authentication, and multipart bytes", \wireTest());
        addTestCase("live image parsing and audio transcription", \liveMediaTest());
        addTestCase("live dataset upload, retrieval, and cleanup", \liveDatasetTest());
        addTestCase("live key-check action", \liveKeyTest());

        # Live test requires a real Cohere connection.
        # Cost: 1 embedding on embed-english-light-v3.0 (Cohere trial-key
        # friendly — 1000 calls/month free).
        if (conn_name) {
            addTestCase("live: ping + embed (embed-english-light-v3.0)",
                \liveCohereTest());
        }
        set_return_value(main());
    }

    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-c,--connection=ARG",
            "set the Cohere connection name; without it (and "
            "without the COHERE_CONNECTION env var) the live test is skipped",
            OptionColumn);
    }

    private registrationTest() {
        DataProvider::AbstractDataProviderFactory f =
            DataProvider::DataProvider::getFactory("cohere");
        assertEq("cohere", f.getInfo().name);

        hash<DataProviderAppInfo> app =
            DataProvider::DataProviderActionCatalog::getApp("Cohere");
        assertEq("Cohere", app.name);
        assertEq("cohere", app.scheme);

        # filter out the framework-injected make-api-call action (covered by
        # GenericApiCallAutoInjection.qtest in RestClientDataProvider)
        list<hash<DataProviderActionInfo>> actions = select
            DataProvider::DataProviderActionCatalog::getActions("Cohere"),
            $1.action != AbstractDataProvider::GenericApiCallActionName;
        assertEq(24, actions.size());
        list<string> action_names = sort(map $1.action, actions);
        assertEq(sort(keys Requests), action_names);
    }

    private rootProviderTest() {
        FakeCohereRestClientIo fake();
        CohereDataProvider::CohereDataProvider prov(fake);
        # filter out the framework-injected __call__ child (covered by
        # GenericApiCallAutoInjection.qtest in RestClientDataProvider)
        list<string> children = sort(select prov.getChildProviderNames(),
            $1 != AbstractDataProvider::GenericApiCallChildName);
        assertEq(sort(keys Requests), children);
        foreach string name in (children) {
            AbstractDataProvider child = prov.getChildProvider(name);
            assertTrue(child.supportsRequest(), name);
            assertEq(name != "cancel-embed-job", exists child.getResponseType(), name);
        }
        assertNothing(prov.getChildProvider("unknown"));
    }

    private chatRequestTest() {
        FakeCohereRestClientIo fake();
        fake.response_body = {
            "id": "cohere-id",
            "finish_reason": "COMPLETE",
            "message": {
                "role": "assistant",
                "content": (
                    {"type": "text", "text": "Hi"},
                ),
            },
            "usage": {"tokens": {"input_tokens": 10, "output_tokens": 1}},
        };

        CohereDataProvider::CohereChatDataProvider prov(fake);
        auto resp = prov.doRequest({
            "model": "command-r-plus",
            "messages": ({"role": "user", "content": "Hi"},),
        });

        assertEq("POST", fake.last_method);
        assertEq("/v2/chat", fake.last_path);
        assertEq("COMPLETE", resp.finish_reason);
        assertEq("Hi", resp.message.content[0].text);
    }

    private embedRequestTest() {
        FakeCohereRestClientIo fake();
        fake.response_body = {
            "id": "embed-id",
            "embeddings": {"float": ((0.1, 0.2, 0.3),)},
        };

        CohereDataProvider::CohereEmbedDataProvider prov(fake);
        prov.doRequest({
            "model": "embed-multilingual-v3.0",
            "texts": ("hello",),
            "input_type": "search_document",
        });

        assertEq("POST", fake.last_method);
        assertEq("/v2/embed", fake.last_path);
        # `embedding_types` injected by doRequestImpl when caller omits it
        assertEq(("float",), fake.last_request.embedding_types);
        assertEq("search_document", fake.last_request.input_type);
    }

    private rerankRequestTest() {
        FakeCohereRestClientIo fake();
        fake.response_body = {
            "id": "rerank-id",
            "results": (
                {"index": 0, "relevance_score": 0.88,
                 "document": {"text": "Doc A"}},
            ),
        };

        CohereDataProvider::CohereRerankDataProvider prov(fake);
        auto resp = prov.doRequest({
            "model": "rerank-v3.5",
            "query": "test",
            "documents": ("Doc A", "Doc B"),
            "top_n": 1,
        });

        assertEq("POST", fake.last_method);
        assertEq("/v2/rerank", fake.last_path);
        assertEq(0.88, resp.results[0].relevance_score);
    }

    private classifyRequestTest() {
        FakeCohereRestClientIo fake();
        fake.response_body = {
            "id": "cls-id",
            "classifications": (
                {"id": "c1", "input": "Great!", "prediction": "positive",
                 "confidence": 0.95, "labels": {"positive": 0.95, "negative": 0.05}},
            ),
        };

        CohereDataProvider::CohereClassifyDataProvider prov(fake);
        auto resp = prov.doRequest({
            "inputs": ("Great!",),
            "examples": (
                {"text": "I love this", "label": "positive"},
                {"text": "I hate this", "label": "negative"},
            ),
        });

        assertEq("POST", fake.last_method);
        # absolute path addresses v1 endpoint from v2-default client
        assertEq("/v1/classify", fake.last_path);
        assertEq("positive", resp.classifications[0].prediction);
    }

    private allOperationsTest() {
        FakeCohereRestClientIo fake();
        CohereDataProvider::CohereDataProvider root(fake);
        foreach hash<RestSchemaActionInfo> info in (CohereManifest::Manifest) {
            root.getChildProvider(info.action).doRequest(Requests{info.action});
            assertEq(info.method, fake.last_method, info.action);
            string path = info.path;
            path = replace(path, "{id}", Requests{info.action}.id ?? "");
            path = replace(path, "{model}", Requests{info.action}.model ?? "");
            assertEq(path, fake.last_path.split("?")[0], info.action);
        }
        assertEq(24, fake.requests);
    }

    private contractTest() {
        list<hash<DataProviderActionInfo>> actions = DataProviderActionCatalog::getActions("Cohere");
        foreach hash<DataProviderActionInfo> action in (actions) {
            if (action.action == AbstractDataProvider::GenericApiCallActionName) {
                continue;
            }
            assertTrue(action.display_name.val(), action.action);
            assertTrue(action.short_desc.val() && action.short_desc.size() < 80, action.action);
            assertTrue(action.desc.val(), action.action);
            assertEq(action.action != "cancel-embed-job", exists action.output_type, action.action);
            assertFalse(exists action.cls, action.action);
            RestSchemaActionOperation op = CohereSchema::getActionSet().getOperationEx(action.action);
            if (op.getRequestType()) {
                assertEq(sort(keys op.getRequestType().getFields()), sort(keys action.options), action.action);
            }
        }
        hash<string, AbstractDataField> chat = new CohereChatRequestDataType().getFields();
        foreach string name in ("documents", "thinking", "citation_options", "strict_tools", "logprobs") {
            assertTrue(exists chat{name}, name);
        }
        assertFalse(exists chat.stream);
        hash<string, AbstractDataField> embed = new CohereEmbedRequestDataType().getFields();
        foreach string name in ("images", "inputs", "output_dimension", "max_tokens") {
            assertTrue(exists embed{name}, name);
        }
        assertTrue(chat.model.getAttributes().ref_data.val());
        assertTrue(embed.input_type.getAllowedValues().size() > 1);
        assertEq("Top-K", chat.k.getDisplayName());
        assertEq(("Required", "None"), map $1.display_name, chat.tool_choice.getAllowedValues());
        assertEq(("search_document", "search_query", "classification", "clustering", "image"),
            map $1.value, embed.input_type.getAllowedValues());
        assertEq("Search Document - text to be indexed", embed.input_type.getAllowedValues()[0].display_name);
        assertEq(("float", "int8", "uint8", "binary", "ubinary"),
            map $1.value, embed.embedding_types.getElementAllowedValues());
        assertTrue(CohereSchema::getActionSet().getOperationEx("parse").getRequestType()
            .getFields().output_format.getAllowedValues().size() > 1);
        hash<string, AbstractDataField> batch = CohereSchema::getActionSet().getOperationEx("create-batch")
            .getRequestType().getFields();
        foreach string field in ("id", "created_at", "status", "org_id", "output_dataset_id") {
            assertFalse(exists batch{field}, "read-only batch fields are not request options");
        }
    }

    private referenceDataTest() {
        FakeCohereRestClientIo fake();
        CohereDataProvider::CohereDataProvider root(fake);
        foreach string action in ("chat", "embed", "rerank", "classify") {
            fake.response_body = {"models": ({"name": "model-a"}, {"name": "model-b"})};
            *list<hash<AllowedValueInfo>> values = root.getChildProvider(action)
                .getReferenceData(action + "-models");
            assertEq(("model-a", "model-b"), map $1.value, values);
            assertTrue(fake.last_path.startsWith("/v1/models?"));
            assertTrue(index(fake.last_path, "endpoint=" + action) >= 0);
        }
        foreach hash<auto> test in (
                {"action": "get-dataset", "ref": "datasets", "key": "datasets", "id": "id", "path": "/v1/datasets"},
                {"action": "get-embed-job", "ref": "embed-jobs", "key": "embed_jobs", "id": "job_id", "path": "/v1/embed-jobs"},
                {"action": "get-batch", "ref": "batches", "key": "batches", "id": "id", "path": "/v2/batches"}) {
            fake.response_body = {test.key: ({test.id: "id-1", "name": "Invoices"},)};
            *list<hash<AllowedValueInfo>> values = root.getChildProvider(test.action).getReferenceData(test.ref);
            assertEq("id-1", values[0].value);
            assertEq("Invoices", values[0].display_name);
            assertEq(test.path, fake.last_path);
        }
        fake.response_body = {"models": ()};
        assertNothing(root.getChildProvider("chat").getReferenceData("chat-models"));
    }

    private negativeTest() {
        assertThrows("CONSTRUCTOR-ERROR", sub () { new CohereDataProvider::CohereDataProvider({}); });
        FakeCohereRestClientIo fake();
        CohereDataProvider::CohereDataProvider root({"restclient": fake});
        foreach hash<auto> test in (
                {"action": "chat", "request": {}},
                {"action": "chat", "request": {"messages": ({"role": "wrong", "content": "Hi"},)}},
                {"action": "embed", "request": {}},
                {"action": "embed", "request": {"texts": ("hi",), "images": ("data:image/png;base64,AA==",)}},
                {"action": "embed", "request": {"texts": ("hi",), "input_type": "invalid"}},
                {"action": "rerank", "request": {"query": "invoice"}},
                {"action": "parse", "request": {"document": {"type": "image_url", "image_url": "https://example.org/a.png"}, "output_format": "pdf"}},
                {"action": "transcribe", "request": {"language": "en"}},
                {"action": "transcribe", "request": {"language": "en",
                    "file": {"name": "", "content": binary("RIFF")}}},
                {"action": "transcribe", "request": {"language": "en",
                    "file": {"name": "invoice.wav"}}},
                {"action": "create-dataset", "request": {"name": "test", "type": "invalid", "data": binary("x")}},
                {"action": "get-batch", "request": {}},
                {"action": "create-batch", "request": {"name": "Invoices"}}) {
            *hash<ExceptionInfo> error;
            try {
                root.getChildProvider(test.action).doRequest(test.request);
            } catch (hash<ExceptionInfo> ex) {
                error = ex;
            }
            assertTrue(exists error, test.action);
            assertRegex("^(INVALID-REQUEST|RUNTIME-TYPE-ERROR|MISSING-VALUE-ERROR|REST-SCHEMA-ACTION-ERROR|"
                "SCHEMA-VALIDATION-ERROR)$", error.err, test.action);
        }
        assertEq(0, fake.requests, "invalid inputs must be rejected before network I/O");
    }

    private wireTest() {
        Logger logger("cohere-wire", LoggerLevel::getLevelWarn());
        HttpServer server(<HttpServerOptionInfo>{"logger": logger});
        on_exit delete server;
        CohereWireHandler handler();
        server.setDefaultHandler("cohere", handler);
        int port = server.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        CohereRestClient::CohereRestClientIo client({
            "url": sprintf("http://127.0.0.1:%d", port), "apikey": "wire-key", "http_version": "1.1",
        });
        CohereDataProvider::CohereDataProvider root(client);
        root.getChildProvider("classify").doRequest(Requests.classify);
        assertEq("v1/classify", handler.getRequest().path);
        assertEq("Bearer wire-key", handler.getRequest().authorization);
        root.getChildProvider("rerank").doRequest(Requests.rerank);
        assertEq("v2/rerank", handler.getRequest().path);
        # The provider owns a copy; using it must not change the supplied client's v2 prefix.
        client.restPost("chat", Requests.chat);
        assertEq("v2/chat", handler.getRequest().path);
        root.getChildProvider("get-dataset").doRequest({"id": "invoice/a b?"});
        assertEq("v1/datasets/invoice/a b?", handler.getRequest().path);
        root.getChildProvider("transcribe").doRequest(Requests.transcribe);
        assertRegex("multipart/form-data;", handler.getRequest()."content-type");
        assertRegex("RIFFcohere-audio", handler.getBody().toString());
        root.getChildProvider("create-dataset").doRequest(Requests{"create-dataset"});
        assertRegex("multipart/form-data;", handler.getRequest()."content-type");
        assertRegex("Invoice paid", handler.getBody().toString());
        root.getChildProvider("transcribe").doRequest(Requests.transcribe + {
            "file": {"name": "invoice.wav", "content": binary("RIFFcohere-audio"), "mime_type": "audio/wav"},
        });
        hash<string, hash<FormDataMessageInfo>> parts = MultiPartFormDataMessage::parseMessage(
            handler.getRequest()."content-type", handler.getBody().toString());
        assertRegex("boundary=\"[^\"]+\"$", handler.getRequest()."content-type");
        assertEq("invoice.wav", parts.file.filename);
        assertEq("audio/wav", parts.file.hdr."content-type");
        assertEq(binary("RIFFcohere-audio"), parts.file.body);
        assertEq("en", parts.language.body);
        assertEq(NOTHING, parts.language.filename);
        assertEq("cohere-transcribe-03-2026", parts.model.body);
        assertEq(NOTHING, parts.model.filename);
        root.getChildProvider("create-dataset").doRequest(Requests{"create-dataset"} + {
            "data": {"name": "invoices.jsonl", "content": Requests{"create-dataset"}.data},
        });
        parts = MultiPartFormDataMessage::parseMessage(handler.getRequest()."content-type",
            handler.getBody().toString());
        assertEq("invoices.jsonl", parts.data.filename);
        assertEq(Requests{"create-dataset"}.data, binary(parts.data.body));
    }

    private liveMediaTest() {
        if (!ENV.COHERE_APIKEY || !ENV.COHERE_TEST_IMAGE || !ENV.COHERE_TEST_AUDIO) {
            testSkip("set COHERE_APIKEY, COHERE_TEST_IMAGE, and COHERE_TEST_AUDIO for live media checks");
        }
        CohereDataProvider::CohereDataProvider root({"apikey": ENV.COHERE_APIKEY});
        auto parsed = root.getChildProvider("parse").doRequest({
            "document": {"type": "image_url", "image_url": "data:image/png;base64,"
                + make_base64_string(File::readBinaryFile(ENV.COHERE_TEST_IMAGE))},
            "output_format": "markdown",
        });
        assertTrue(parsed.pages[0].markdown.content.val());
        if (ENV.COHERE_TEST_IMAGE_TEXT) {
            assertTrue(parsed.pages[0].markdown.content.find(ENV.COHERE_TEST_IMAGE_TEXT) >= 0);
        }
        auto transcript = root.getChildProvider("transcribe").doRequest({
            "language": "en",
            "file": {"name": basename(ENV.COHERE_TEST_AUDIO),
                "content": File::readBinaryFile(ENV.COHERE_TEST_AUDIO)},
        });
        assertTrue(transcript.text.val());
        if (ENV.COHERE_TEST_AUDIO_TEXT) {
            assertTrue(transcript.text.find(ENV.COHERE_TEST_AUDIO_TEXT) >= 0);
        }
    }

    private liveDatasetTest() {
        if (!ENV.COHERE_APIKEY || ENV.COHERE_TEST_RESOURCES != "1") {
            testSkip("set COHERE_APIKEY and COHERE_TEST_RESOURCES=1 to create and delete a test dataset");
        }
        CohereDataProvider::CohereDataProvider root({"apikey": ENV.COHERE_APIKEY});
        *string cleanup_id;
        on_exit {
            if (cleanup_id.val()) {
                root.getChildProvider("delete-dataset").doRequest({"id": cleanup_id});
            }
        }
        string name = "qore-5433-" + now_us().format("YYYYMMDDHHmmSSus");
        auto created = root.getChildProvider("create-dataset").doRequest({
            "name": name, "type": "embed-input",
            "data": {"name": "invoices.jsonl", "content": binary("{\"text\":\"Invoice total 42 EUR\"}\n")},
        });
        cleanup_id = created.id;
        assertTrue(cleanup_id.val());
        string id = cleanup_id;
        auto retrieved = root.getChildProvider("get-dataset").doRequest({"id": id});
        assertEq(id, retrieved.dataset.id);
        assertEq(name, retrieved.dataset.name);
        assertEq("embed-input", retrieved.dataset.dataset_type);
        root.getChildProvider("delete-dataset").doRequest({"id": id});
        cleanup_id = NOTHING;
        *hash<ExceptionInfo> error;
        try {
            root.getChildProvider("get-dataset").doRequest({"id": id});
        } catch (hash<ExceptionInfo> ex) {
            error = ex;
        }
        assertTrue(exists error);
        assertEq("REST-RESPONSE-ERROR", error.err);
        assertEq(404, error.arg.status_code);
    }

    private liveKeyTest() {
        if (!ENV.COHERE_APIKEY) {
            testSkip("set COHERE_APIKEY to exercise the live key-check action");
        }
        CohereDataProvider::CohereDataProvider root({"apikey": ENV.COHERE_APIKEY});
        assertTrue(root.getChildProvider("check-api-key").doRequest({}).valid);
        CohereDataProvider::CohereDataProvider invalid({"apikey": "invalid-qore-test-key"});
        assertFalse(invalid.getChildProvider("check-api-key").doRequest({}).valid);
    }

    #! Exercises Cohere's live embed endpoint
    /** Verifies the actual wire format against Cohere's production embed
        endpoint with a single-text request on `embed-english-light-v3.0`.
        Cost: 1 embedding (Cohere trial-key friendly — 1000 calls/month free).
    */
    private liveCohereTest() {
        AbstractConnection conn = get_connection(conn_name);
        hash<auto> ping = conn.ping(True);
        assertTrue(ping.ok, sprintf("Cohere connection ping failed: %s",
            ping.info ?? "no info"));

        AbstractDataProvider prov = conn.getDataProvider();
        AbstractDataProvider emb = prov.getChildProvider("embed");
        auto resp = emb.doRequest({
            "model": "embed-english-light-v3.0",
            "texts": ("hello",),
            "input_type": "search_document",
        });
        assertTrue(resp.embeddings.float[0].size() > 0,
            "Cohere returned non-empty embedding vector");
    }
}
