#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires HttpServer
%requires HttpServerUtil
%requires JsonRpcHandler

%exec-class JsonRpcHandlerCredentialsTest

#! The code of a restricted Program that a trusted JSON-RPC handler calls with the request context gets it without its
#! credentials (qore#7303)
/** A method that a handler of trusted code calls with the request context (\c include_context) and the log message
    callback get it without the credentials of the request when their code is of a %Program that a sandbox that does
    not trust its code governs; trusted code gets it as before
*/

#! a hang guard only, never a timing assertion
const HangGuard = 20s;

#! a handler that adds keys to the request context for its methods before the dispatch, and names them (qore#7724)
class KeysHandler inherits JsonRpcHandler {
    constructor(AbstractAuthenticator auth, *code log) : JsonRpcHandler(auth, NOTHING, log) {
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        cx.api_version = "v7";
        # an object, and keys of the request and of the server: never given to restricted code
        cx.api_object = new Mutex();
        return JsonRpcHandler::handleRequest(cx, hdr, body);
    }

    private *list<string> getRpcContextKeys() {
        return ("api_version", "api_object", "auth", "uctx", "hdr");
    }
}

class JsonRpcHandlerCredentialsTest inherits QUnit::Test {
    public {
        #! the tenant's code: records what of the credentials of the request it saw
        const TenantSource = "%modern
string sub seen(hash<auto> cx) {
    return sprintf(\"cx.auth=%y cx.hdr.authorization=%y cx.hdr.cookie=%y function=%y method=%y jsonid=%y \"
        \"jsonrpc_version=%y api_version=%y api_object=%y\", exists cx.auth, exists cx.hdr.authorization,
        exists cx.hdr.cookie, exists cx.function, cx.method, cx.jsonid, cx.jsonrpc_version, cx.api_version,
        exists cx.api_object);
}
code sub get_method(Queue q) {
    return auto sub (hash<auto> cx) { q.push(seen(cx)); return 1; };
}
code sub get_log(Queue q) {
    return *string sub (hash<auto> cx, hash<auto> method, reference<auto> params) { q.push(seen(cx)); };
}
# what of the method's function and context marker the code saw (qore#7726)
string sub seen_dispatch(hash<auto> cx, *hash<auto> method) {
    string rv = sprintf(\"function=%y cmark=%y\", exists cx.function, cx.cmark.typeCode() == NT_OBJECT ? \"object\"
        : cx.cmark);
    if (method) {
        rv += sprintf(\" method.function=%y method.cmark=%y\", exists method.function,
            method.cmark.typeCode() == NT_OBJECT ? \"object\" : method.cmark);
    }
    return rv;
}
code sub get_dispatch_method(Queue q) {
    return auto sub (hash<auto> cx) { q.push(seen_dispatch(cx)); return 1; };
}
# what of the code values of the method the log message callback saw (qore#7726)
code sub get_code_log(Queue q) {
    return *string sub (hash<auto> cx, hash<auto> method, reference<auto> params) {
        q.push(sprintf(\"cmark=%y method.cmark=%y method.logopt=%y method.extra=%y\", exists cx.cmark,
            exists method.cmark, exists method.logopt, exists method.extra));
    };
}
code sub get_dispatch_log(Queue q) {
    return *string sub (hash<auto> cx, hash<auto> method, reference<auto> params) {
        q.push(seen_dispatch(cx, method));
    };
}
";

        #! the handler's own keys (qore#7724)
        const OwnKeys = " method=\"probe\" jsonid=1 jsonrpc_version=\"2.0\"";
        #! what code gets without the credentials of the request
        const Filtered = "cx.auth=False cx.hdr.authorization=False cx.hdr.cookie=False function=True" + OwnKeys
            + " api_version=null api_object=False";
        #! what the log message callback of a restricted Program gets: the method's function only as the name of an
        #! internal method, never the code of the method, also of its own Program (qore#7726)
        const FilteredLog = "cx.auth=False cx.hdr.authorization=False cx.hdr.cookie=False function=False" + OwnKeys
            + " api_version=null api_object=False";
        #! what code gets with them
        const Raw = "cx.auth=True cx.hdr.authorization=True cx.hdr.cookie=True function=True" + OwnKeys
            + " api_version=null api_object=False";
        #! what the code of a restricted Program gets from the subclass that names its keys: only plain data
        const FilteredSubclass = "cx.auth=False cx.hdr.authorization=False cx.hdr.cookie=False function=True"
            + OwnKeys + " api_version=\"v7\" api_object=False";
        #! what the log message callback of a restricted Program gets from the subclass (qore#7726)
        const FilteredSubclassLog = "cx.auth=False cx.hdr.authorization=False cx.hdr.cookie=False function=False"
            + OwnKeys + " api_version=\"v7\" api_object=False";
        #! what trusted code gets from the subclass: the whole context
        const RawSubclass = "cx.auth=True cx.hdr.authorization=True cx.hdr.cookie=True function=True" + OwnKeys
            + " api_version=\"v7\" api_object=True";
    }

    constructor() : Test("JsonRpcHandlerCredentialsTest", "1.0", \ARGV) {
        addTestCase("the code of a restricted Program", \restrictedTest());
        addTestCase("trusted code", \trustedTest());
        addTestCase("the code of a restricted Program: the keys that a subclass names", \restrictedSubclassTest());
        addTestCase("trusted code: the keys that a subclass adds", \trustedSubclassTest());
        addTestCase("the code of a restricted Program: each call of a batch request", \restrictedBatchTest());
        addTestCase("a restricted log message callback of a trusted method", \restrictedLogTrustedMethodTest());
        addTestCase("a restricted method with a context marker that holds an object", \restrictedMethodCmarkTest());
        addTestCase("a trusted log message callback of a trusted method", \trustedLogTrustedMethodTest());
        addTestCase("a restricted log message callback gets no code of the method", \restrictedLogCodeValuesTest());
        set_return_value(main());
    }

    #! returns the tenant's Program with the given sandbox
    private Program getTenant(*SandboxManager sm) {
        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        if (sm) {
            p.setSandboxManager(sm);
        }
        p.parse(TenantSource, "tenant");
        return p;
    }

    #! calls the method with credentials; returns what the method and the log callback saw
    private hash<auto> call(Program p, bool subclass = False) {
        Queue mq();
        Queue lq();
        JsonRpcHandler handler = subclass
            ? new KeysHandler(new PermissiveAuthenticator(), p.callFunction("get_log", lq))
            : new JsonRpcHandler(new PermissiveAuthenticator(), NOTHING, p.callFunction("get_log", lq));
        handler.addMethod("probe", p.callFunction("get_method", mq), "probe", "probe", NOTHING, NOTHING, True);
        HttpServer server(<HttpServerOptionInfo>{});
        on_exit server.stop();
        server.setDefaultHandler("jsonrpc", handler);
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        server.waitForAsyncIo();
        Socket c();
        c.connect("127.0.0.1:" + port, HangGuard);
        on_exit c.close();
        string body = "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"probe\", \"params\": []}";
        c.send(sprintf("POST /JSON HTTP/1.1\r\nHost: localhost\r\nContent-Type: application/json\r\n"
            "Authorization: Bearer secret\r\nCookie: session=secret\r\nContent-Length: %d\r\n\r\n%s", body.size(),
            body));
        hash<auto> h = c.readHTTPHeader(HangGuard);
        assertEq(200, h.status_code, "the request is served");
        return {"method": mq.get(HangGuard), "log": lq.get(HangGuard)};
    }

    restrictedTest() {
        # the default sandbox does not trust its code
        hash<auto> r = call(getTenant(new SandboxManager()));
        assertEq(Filtered, r.method, "the method");
        assertEq(FilteredLog, r.log, "the log message callback");
    }

    trustedTest() {
        hash<auto> r = call(getTenant());
        assertEq(Raw, r.method, "the method");
        assertEq(Raw, r.log, "the log message callback");
    }

    restrictedSubclassTest() {
        hash<auto> r = call(getTenant(new SandboxManager()), True);
        assertEq(FilteredSubclass, r.method, "the method");
        assertEq(FilteredSubclassLog, r.log, "the log message callback");
    }

    restrictedBatchTest() {
        Queue mq();
        Queue lq();
        Program p = getTenant(new SandboxManager());
        JsonRpcHandler handler(new PermissiveAuthenticator(), NOTHING, p.callFunction("get_log", lq));
        handler.addMethod("probe", p.callFunction("get_method", mq), "probe", "probe", NOTHING, NOTHING, True);
        HttpServer server(<HttpServerOptionInfo>{});
        on_exit server.stop();
        server.setDefaultHandler("jsonrpc", handler);
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        server.waitForAsyncIo();
        Socket c();
        c.connect("127.0.0.1:" + port, HangGuard);
        on_exit c.close();
        string body = "[{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"probe\", \"params\": []}, "
            "{\"jsonrpc\": \"2.0\", \"id\": 2, \"method\": \"probe\", \"params\": []}]";
        c.send(sprintf("POST /JSON HTTP/1.1\r\nHost: localhost\r\nContent-Type: application/json\r\n"
            "Authorization: Bearer secret\r\nCookie: session=secret\r\nContent-Length: %d\r\n\r\n%s", body.size(),
            body));
        hash<auto> h = c.readHTTPHeader(HangGuard);
        assertEq(200, h.status_code, "the request is served");
        # each call of the batch gets its own request ID
        foreach int id in (1, 2) {
            assertEq(regex_subst(Filtered, "jsonid=1", "jsonid=" + id), mq.get(HangGuard),
                sprintf("call %d: the method", id));
            assertEq(regex_subst(FilteredLog, "jsonid=1", "jsonid=" + id), lq.get(HangGuard),
                sprintf("call %d: the log message callback", id));
        }
    }

    #! calls a method with the given context marker; returns what the method (if given) and the log callback saw
    private hash<auto> callDispatch(code method, code log, auto cmark, *Queue mq, Queue lq) {
        JsonRpcHandler handler(new PermissiveAuthenticator(), NOTHING, log);
        handler.addMethod("probe", method, "probe", "probe", NOTHING, cmark, True);
        HttpServer server(<HttpServerOptionInfo>{});
        on_exit server.stop();
        server.setDefaultHandler("jsonrpc", handler);
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        server.waitForAsyncIo();
        Socket c();
        c.connect("127.0.0.1:" + port, HangGuard);
        on_exit c.close();
        string body = "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"probe\", \"params\": []}";
        c.send(sprintf("POST /JSON HTTP/1.1\r\nHost: localhost\r\nContent-Type: application/json\r\n"
            "Content-Length: %d\r\n\r\n%s", body.size(), body));
        hash<auto> h = c.readHTTPHeader(HangGuard);
        assertEq(200, h.status_code, "the request is served");
        return {"method": mq ? mq.get(HangGuard) : NOTHING, "log": lq.get(HangGuard)};
    }

    restrictedLogTrustedMethodTest() {
        Program p = getTenant(new SandboxManager());
        Queue lq();
        # the trusted method's code is not given to the restricted callback, nor its marker that holds an object
        hash<auto> r = callDispatch(int sub (hash<auto> cx) { return 1; }, p.callFunction("get_dispatch_log", lq),
            new Mutex(), NOTHING, lq);
        assertEq("function=False cmark=null method.function=False method.cmark=null", r.log, "an object marker");
        # a marker of plain data is given
        r = callDispatch(int sub (hash<auto> cx) { return 1; }, p.callFunction("get_dispatch_log", lq), {"a": 1},
            NOTHING, lq);
        assertEq("function=False cmark={a: 1} method.function=False method.cmark={a: 1}", r.log,
            "a plain data marker");
    }

    restrictedMethodCmarkTest() {
        Program p = getTenant(new SandboxManager());
        Queue mq();
        Queue lq();
        # the restricted method gets its own function, but not its marker that holds an object
        hash<auto> r = callDispatch(p.callFunction("get_dispatch_method", mq), p.callFunction("get_dispatch_log", lq),
            new Mutex(), mq, lq);
        assertEq("function=True cmark=null", r.method, "the method");
        # the log callback is other code than the method: it gets the method's name only
        assertEq("function=False cmark=null method.function=False method.cmark=null", r.log,
            "the log message callback");
    }

    trustedLogTrustedMethodTest() {
        Program p = getTenant();
        Queue lq();
        hash<auto> r = callDispatch(int sub (hash<auto> cx) { return 1; }, p.callFunction("get_dispatch_log", lq),
            new Mutex(), NOTHING, lq);
        assertEq("function=True cmark=\"object\" method.function=True method.cmark=\"object\"", r.log,
            "trusted code gets the method's function and marker");
    }

    #! calls a trusted method whose hash holds code; returns what the log callback saw
    private string callCodeValues(code log, Queue lq, auto cmark) {
        JsonRpcHandler handler(new PermissiveAuthenticator(), NOTHING, log);
        handler.addMethods(({
            "name": "probe",
            "function": int sub (hash<auto> cx) { return 1; },
            "text": "probe",
            "help": "probe",
            "cmark": cmark,
            "logopt": (string sub () { return "trusted"; },),
            "extra": string sub () { return "trusted"; },
        },));
        HttpServer server(<HttpServerOptionInfo>{});
        on_exit server.stop();
        server.setDefaultHandler("jsonrpc", handler);
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        server.waitForAsyncIo();
        Socket c();
        c.connect("127.0.0.1:" + port, HangGuard);
        on_exit c.close();
        string body = "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"probe\", \"params\": []}";
        c.send(sprintf("POST /JSON HTTP/1.1\r\nHost: localhost\r\nContent-Type: application/json\r\n"
            "Content-Length: %d\r\n\r\n%s", body.size(), body));
        hash<auto> h = c.readHTTPHeader(HangGuard);
        assertEq(200, h.status_code, "the request is served");
        return lq.get(HangGuard);
    }

    restrictedLogCodeValuesTest() {
        Queue lq();
        Mutex m();
        # a closure and a call reference to a method of a trusted object as the marker, a closure in the log option
        # and in another key of the method
        foreach auto cmark in ((string sub () { return "trusted"; }, \m.lock())) {
            assertEq("cmark=False method.cmark=False method.logopt=False method.extra=False",
                callCodeValues(getTenant(new SandboxManager()).callFunction("get_code_log", lq), lq, cmark),
                "restricted code gets no code of another Program");
        }
        # trusted code gets them
        assertEq("cmark=True method.cmark=True method.logopt=True method.extra=True",
            callCodeValues(getTenant().callFunction("get_code_log", lq), lq, \m.lock()), "trusted code");
    }

    trustedSubclassTest() {
        hash<auto> r = call(getTenant(), True);
        assertEq(RawSubclass, r.method, "the method");
        assertEq(RawSubclass, r.log, "the log message callback");
    }
}
