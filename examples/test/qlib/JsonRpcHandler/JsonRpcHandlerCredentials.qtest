#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires HttpServer
%requires HttpServerUtil
%requires JsonRpcHandler

%exec-class JsonRpcHandlerCredentialsTest

#! The code of a restricted Program that a trusted JSON-RPC handler calls with the request context gets it without its
#! credentials (qore#7303)
/** A method that a handler of trusted code calls with the request context (\c include_context) and the log message
    callback get it without the credentials of the request when their code is of a %Program that a sandbox that does
    not trust its code governs; trusted code gets it as before
*/

#! a hang guard only, never a timing assertion
const HangGuard = 20s;

class JsonRpcHandlerCredentialsTest inherits QUnit::Test {
    public {
        #! the tenant's code: records what of the credentials of the request it saw
        const TenantSource = "%modern
string sub seen(hash<auto> cx) {
    return sprintf(\"cx.auth=%y cx.hdr.authorization=%y cx.hdr.cookie=%y\", exists cx.auth, exists cx.hdr.authorization,
        exists cx.hdr.cookie);
}
code sub get_method(Queue q) {
    return auto sub (hash<auto> cx) { q.push(seen(cx)); return 1; };
}
code sub get_log(Queue q) {
    return *string sub (hash<auto> cx, hash<auto> method, reference<auto> params) { q.push(seen(cx)); };
}
";

        #! what code gets without the credentials of the request
        const Filtered = "cx.auth=False cx.hdr.authorization=False cx.hdr.cookie=False";
        #! what code gets with them
        const Raw = "cx.auth=True cx.hdr.authorization=True cx.hdr.cookie=True";
    }

    constructor() : Test("JsonRpcHandlerCredentialsTest", "1.0", \ARGV) {
        addTestCase("the code of a restricted Program", \restrictedTest());
        addTestCase("trusted code", \trustedTest());
        set_return_value(main());
    }

    #! returns the tenant's Program with the given sandbox
    private Program getTenant(*SandboxManager sm) {
        Program p(PO_NO_CHILD_PO_RESTRICTIONS);
        if (sm) {
            p.setSandboxManager(sm);
        }
        p.parse(TenantSource, "tenant");
        return p;
    }

    #! calls the method with credentials; returns what the method and the log callback saw
    private hash<auto> call(Program p) {
        Queue mq();
        Queue lq();
        JsonRpcHandler handler(new PermissiveAuthenticator(), NOTHING, p.callFunction("get_log", lq));
        handler.addMethod("probe", p.callFunction("get_method", mq), "probe", "probe", NOTHING, NOTHING, True);
        HttpServer server(<HttpServerOptionInfo>{});
        on_exit server.stop();
        server.setDefaultHandler("jsonrpc", handler);
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        server.waitForAsyncIo();
        Socket c();
        c.connect("127.0.0.1:" + port, HangGuard);
        on_exit c.close();
        string body = "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"probe\", \"params\": []}";
        c.send(sprintf("POST /JSON HTTP/1.1\r\nHost: localhost\r\nContent-Type: application/json\r\n"
            "Authorization: Bearer secret\r\nCookie: session=secret\r\nContent-Length: %d\r\n\r\n%s", body.size(),
            body));
        hash<auto> h = c.readHTTPHeader(HangGuard);
        assertEq(200, h.status_code, "the request is served");
        return {"method": mq.get(HangGuard), "log": lq.get(HangGuard)};
    }

    restrictedTest() {
        # the default sandbox does not trust its code
        hash<auto> r = call(getTenant(new SandboxManager()));
        assertEq(Filtered, r.method, "the method");
        assertEq(Filtered, r.log, "the log message callback");
    }

    trustedTest() {
        hash<auto> r = call(getTenant());
        assertEq(Raw, r.method, "the method");
        assertEq(Raw, r.log, "the log message callback");
    }
}
