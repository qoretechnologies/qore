    filesystemBackendDirectTest() {
        string dir = getTestDir();
        on_exit { cleanupDir(dir); }

        # Test backend directly (not through ModelRegistry)
        QoreModelRegistry::FilesystemBackend backend(dir, "direct-tenant");

        # Verify tenant ID
        assertEq("direct-tenant", backend.getTenantId(),
            "backend tenant_id should match");

        # Register via backend API
        ML::KMeans km = createFittedKMeans();
        binary artifact = ML::ml_serialize(km);
        string version_id = format_date("YYYYMMDDHHmmss", now()) + "_"
            + get_random_bytes(4).toHex();

        hash<QoreModelRegistry::ModelVersionInfo> metadata({
            "version_id": version_id,
            "name": "direct-test",
            "algorithm": "KMeans",
            "created": format_date("YYYY-MM-DDTHH:mm:ssZ", now()),
            "tags": (),
            "file_size": artifact.size(),
            "format": "qml",
            "tenant_id": "direct-tenant",
        });

        string vid = backend.registerVersion("direct-test", artifact, metadata);
        assertEq(version_id, vid, "registerVersion should return version_id");

        # Load artifact
        binary loaded = backend.loadArtifact("direct-test", version_id);
        assertEq(artifact.size(), loaded.size(), "artifact size should match");

        # Deserialize and verify
        object model = ML::ml_deserialize(loaded);
        assertTrue(model instanceof ML::KMeans, "deserialized model should be KMeans");

        # List versions
        list<hash<auto>> versions = backend.listVersions("direct-test");
        assertEq(1, versions.size(), "should have 1 version");
        assertEq(version_id, versions[0].version_id, "version_id should match");
        assertEq("direct-tenant", versions[0].tenant_id,
            "tenant_id in metadata should match");

        # List models
        list<string> models = backend.listModels();
        assertEq(1, models.size(), "should have 1 model");
        assertEq("direct-test", models[0], "model name should match");

        # Tag and untag
        backend.tag("direct-test", version_id, "stable");
        versions = backend.listVersions("direct-test");
        assertTrue(versions[0].tags.contains("stable"), "tag should be present");

        backend.untag("direct-test", version_id, "stable");
        versions = backend.listVersions("direct-test");
        assertFalse(versions[0].tags.contains("stable"), "tag should be removed");

        # Get version metadata
        hash<auto> meta = backend.getVersionMetadata("direct-test", version_id);
        assertEq("KMeans", meta.algorithm, "algorithm should match");

        # Delete model
        backend.deleteModel("direct-test");
        assertEq(0, backend.listModels().size(), "should have 0 models after delete");
    }

    namedArtifactsTest() {
        string dir = getTestDir();
        on_exit { cleanupDir(dir); }

        QoreModelRegistry::ModelRegistry registry({"path": dir});
        ML::KMeans km = createFittedKMeans();
        string vid = registry.register(km, {"name": "artifact-model"});

        binary tokenizer = binary("{\"model\":{\"type\":\"WordPiece\",\"vocab\":{}}}");
        registry.registerNamedArtifact("artifact-model", vid, "tokenizer.json",
            tokenizer, <QoreModelRegistry::ModelArtifactInfo>{
                "name": "tokenizer.json",
                "role": "tokenizer",
                "format": "json",
                "size": tokenizer.size(),
                "safe_to_parse": True,
                "executable": False,
            });

        list<hash<QoreModelRegistry::ModelArtifactInfo>> artifacts =
            registry.listArtifacts("artifact-model", vid);
        assertEq(2, artifacts.size(),
            "native model plus tokenizer artifact should be listed");
        assertEq(tokenizer.size(),
            registry.loadNamedArtifact("artifact-model", vid, "tokenizer.json").size(),
            "named tokenizer artifact should round-trip");

        hash<QoreModelRegistry::ModelVersionInfo> manifest =
            registry.getVersionManifest("artifact-model", vid);
        assertEq(2, manifest.artifacts.size(),
            "manifest should include named artifact metadata");
        assertThrows("ML-REGISTRY-ERROR", \registry.loadNamedArtifact(),
            ("artifact-model", vid, "../bad"));
    }

    executableAdapterNativeTest() {
        string dir = getTestDir();
        on_exit { cleanupDir(dir); }

        ML::KMeans km({"k": 2, "seed": 42});
        km.fit((
            {"x": 1.0, "y": 1.0},
            {"x": 1.1, "y": 1.1},
            {"x": 5.0, "y": 5.0},
            {"x": 5.1, "y": 5.1},
        ));

        QoreModelRegistry::ModelRegistry registry({"path": dir});
        string vid = registry.register(km, {"name": "adapter-kmeans"});

        QoreModelRegistry::ModelExecutableAdapter adapter =
            registry.loadExecutableAdapter("adapter-kmeans", vid);
        assertEq("qore-ml", adapter.getRuntime(), "native model runtime should be qore-ml");
        assertFalse(adapter.isOnnx(), "native model should not be reported as ONNX");
        assertEq(vid, adapter.getVersionId(), "adapter should expose loaded version ID");

        hash<ML::KMeansResult> prediction = adapter.predict({"x": 1.0, "y": 1.0});
        assertTrue(prediction.hasKey("cluster"), "native adapter predict should call predict()");

        hash<auto> batch = adapter.runFeatureMatrix(((1.0, 1.0), (5.0, 5.0)), NOTHING);
        assertTrue(batch.hasKey("prediction"), "native matrix adapter result should have prediction key");
        assertEq(2, batch.prediction.size(), "native matrix adapter should return two predictions");
    }

    executableAdapterOnnxTensorTest() {
        if (skipOnnx()) {
            return;
        }

        string dir = getTestDir();
        on_exit { cleanupDir(dir); }
        string package_dir = dir + DirSep + "onnx_adapter";
        mkdir_ex(package_dir, 0755, True);
        writeBinaryFile(package_dir + DirSep + "model.onnx",
            ReadOnlyFile::readBinaryFile(getTestOnnxModelPath()));

        QoreModelRegistry::ModelRegistry registry({"path": dir});
        string vid = registry.registerPackage(package_dir, {
            "name": "adapter-onnx",
            "description": "adapter ONNX tensor execution fixture",
            "execution_config": <ML::OnnxSessionConfig>{"providers": ()},
        });

        QoreModelRegistry::ModelExecutableAdapter adapter =
            registry.loadExecutableAdapter("adapter-onnx", vid);
        assertEq("onnxruntime", adapter.getRuntime(), "ONNX adapter runtime should be onnxruntime");
        assertTrue(adapter.isOnnx(), "adapter should identify ONNX models");

        hash<auto> tensors = adapter.runFeatureMatrixTensors(((1.0,), (2.0,), (3.0,)), NOTHING);
        assertTrue(tensors.hasKey("Y"), "tensor result should contain ONNX output");
        ML::Tensor y = tensors.Y;
        assertEq("float32", y.getDtype(), "ONNX tensor dtype should be preserved");
        assertEq((3, 1), y.getShape(), "ONNX tensor output shape should be preserved");

        list<auto> values = y.toList();
        assertTrue(abs(3.0 - values[0][0].toFloat()) < 1e-5,
            sprintf("expected tensor output 3.0, got %y", values[0][0]));
        assertTrue(abs(5.0 - values[1][0].toFloat()) < 1e-5,
            sprintf("expected tensor output 5.0, got %y", values[1][0]));
        assertTrue(abs(7.0 - values[2][0].toFloat()) < 1e-5,
            sprintf("expected tensor output 7.0, got %y", values[2][0]));

        hash<auto> rows = adapter.runFeatureMatrix(((1.0,), (2.0,), (3.0,)), NOTHING);
        assertTrue(rows.hasKey("Y"), "row result should contain ONNX output");
        assertTrue(abs(3.0 - rows.Y[0].toFloat()) < 1e-5,
            sprintf("expected row output 3.0, got %y", rows.Y[0]));
        assertTrue(abs(5.0 - rows.Y[1].toFloat()) < 1e-5,
            sprintf("expected row output 5.0, got %y", rows.Y[1]));
        assertTrue(abs(7.0 - rows.Y[2].toFloat()) < 1e-5,
            sprintf("expected row output 7.0, got %y", rows.Y[2]));

        hash<auto> selected = adapter.runFeatureMatrixTensors(((1.0,), (2.0,), (3.0,)), NOTHING, ("Y",));
        assertEq(1, selected.size(), "selected adapter tensor output should only include requested tensors");
        assertTrue(selected.Y instanceof ML::Tensor,
            "selected adapter tensor output should preserve ML::Tensor values");

        hash<auto> diagnostics = adapter.getProviderDiagnostics();
        assertEq("onnxruntime", diagnostics.runtime,
            "provider diagnostics should include runtime");
        assertTrue(diagnostics.hasKey("active_provider"),
            "provider diagnostics should include active provider");
        assertTrue(diagnostics.available_providers.size() > 0,
            "provider diagnostics should include ONNX Runtime providers");
        assertEq("X", diagnostics.inputs[0].name,
            "provider diagnostics should include input tensor metadata");
        assertTrue(diagnostics.io_binding.initialized,
            "adapter tensor execution should initialize reusable I/O binding");
        assertEq(3, diagnostics.io_binding.run_count,
            "adapter tensor execution should use reusable I/O binding for tensor runs");
        assertEq(("Y",), diagnostics.io_binding.bound_outputs,
            "adapter reusable I/O binding should track selected output bindings");
    }

    executableAdapterOnnxStorageDtypesTest() {
        if (skipOnnx()) {
            return;
        }

        string dir = getTestDir();
        on_exit { cleanupDir(dir); }
        string package_dir = dir + DirSep + "onnx_adapter_dtypes";
        mkdir_ex(package_dir, 0755, True);
        writeBinaryFile(package_dir + DirSep + "model.onnx", makeOnnxIdentityModel((
            {"name": "f16", "type": QoreOnnxExport::ONNX_FLOAT16},
            {"name": "bf16", "type": QoreOnnxExport::ONNX_BFLOAT16},
            {"name": "u8", "type": QoreOnnxExport::ONNX_UINT8},
            {"name": "u16", "type": QoreOnnxExport::ONNX_UINT16},
            {"name": "u32", "type": QoreOnnxExport::ONNX_UINT32},
            {"name": "u64", "type": QoreOnnxExport::ONNX_UINT64},
            {"name": "s", "type": QoreOnnxExport::ONNX_STRING},
        )));

        QoreModelRegistry::ModelRegistry registry({"path": dir});
        string vid = registry.registerPackage(package_dir, {
            "name": "adapter-onnx-dtypes",
            "description": "adapter ONNX storage dtype fixture",
            "execution_config": <ML::OnnxSessionConfig>{"providers": ()},
        });

        QoreModelRegistry::ModelExecutableAdapter adapter =
            registry.loadExecutableAdapter("adapter-onnx-dtypes", vid);

        assertEq("float32", adapter.getOnnxInputTensorDtype("f16_in"));
        assertEq("float32", adapter.getOnnxInputTensorDtype("bf16_in"));
        assertEq("int64", adapter.getOnnxInputTensorDtype("u8_in"));
        assertEq("int64", adapter.getOnnxInputTensorDtype("u16_in"));
        assertEq("int64", adapter.getOnnxInputTensorDtype("u32_in"));
        assertEq("int64", adapter.getOnnxInputTensorDtype("u64_in"));
        assertEq("string", adapter.getOnnxInputTensorDtype("s_in"));

        hash<auto> tensor_out = adapter.runTensors({
            "f16_in": new ML::Tensor(data: ((1.5,), (-2.0,)), dtype: "float32"),
            "bf16_in": new ML::Tensor(data: ((3.0,), (4.5,)), dtype: "float32"),
            "u8_in": new ML::Tensor(data: ((0,), (255,)), dtype: "int64"),
            "u16_in": new ML::Tensor(data: ((0,), (65535,)), dtype: "int64"),
            "u32_in": new ML::Tensor(data: ((0,), (4000000000,)), dtype: "int64"),
            "u64_in": new ML::Tensor(data: ((0,), (9223372036854775807,)), dtype: "int64"),
            "s_in": new ML::Tensor(data: (("alpha",), ("beta",)), dtype: "string"),
        });

        assertEq("float32", tensor_out.f16_out.getDtype());
        assertTrue(abs(1.5 - tensor_out.f16_out.toList()[0][0].toFloat()) < 0.001,
            "float16 output should round-trip through float32 storage");
        assertTrue(abs(-2.0 - tensor_out.f16_out.toList()[1][0].toFloat()) < 0.001,
            "negative float16 output should round-trip through float32 storage");
        assertEq("float32", tensor_out.bf16_out.getDtype());
        assertTrue(abs(4.5 - tensor_out.bf16_out.toList()[1][0].toFloat()) < 0.01,
            "bfloat16 output should round-trip through float32 storage");
        assertEq("int64", tensor_out.u8_out.getDtype());
        assertEq(((0,), (255,)), tensor_out.u8_out.toList());
        assertEq(((0,), (65535,)), tensor_out.u16_out.toList());
        assertEq(((0,), (4000000000,)), tensor_out.u32_out.toList());
        assertEq(((0,), (9223372036854775807,)), tensor_out.u64_out.toList());
        assertEq("alpha", tensor_out.s_out.toList()[0][0]);
        assertEq("beta", tensor_out.s_out.toList()[1][0]);

        string f16_package_dir = dir + DirSep + "onnx_adapter_f16";
        mkdir_ex(f16_package_dir, 0755, True);
        writeBinaryFile(f16_package_dir + DirSep + "model.onnx", makeOnnxIdentityModel((
            {"name": "f16", "type": QoreOnnxExport::ONNX_FLOAT16},
        )));
        string f16_vid = registry.registerPackage(f16_package_dir, {
            "name": "adapter-onnx-f16",
            "description": "adapter ONNX single float16 fixture",
            "execution_config": <ML::OnnxSessionConfig>{"providers": ()},
        });
        QoreModelRegistry::ModelExecutableAdapter f16_adapter =
            registry.loadExecutableAdapter("adapter-onnx-f16", f16_vid);

        hash<auto> f16 = f16_adapter.runFeatureTensor(
            new ML::Tensor(data: ((1.5,), (-2.0,)), dtype: "float32"),
            "f16_in", ("f16_out",));
        assertTrue(abs(1.5 - f16.f16_out.toList()[0][0].toFloat()) < 0.001,
            "runFeatureTensor() should accept float32 storage for float16 input");

        hash<auto> matrix_out = f16_adapter.runFeatureMatrixTensors(
            ((1.5,), (-2.0,)), "f16_in", ("f16_out",));
        assertTrue(abs(-2.0 - matrix_out.f16_out.toList()[1][0].toFloat()) < 0.001,
            "runFeatureMatrixTensors() should use float32 storage for float16 input");

        string u8_package_dir = dir + DirSep + "onnx_adapter_u8";
        mkdir_ex(u8_package_dir, 0755, True);
        writeBinaryFile(u8_package_dir + DirSep + "model.onnx", makeOnnxIdentityModel((
            {"name": "u8", "type": QoreOnnxExport::ONNX_UINT8},
        )));
        string u8_vid = registry.registerPackage(u8_package_dir, {
            "name": "adapter-onnx-u8",
            "description": "adapter ONNX single uint8 fixture",
            "execution_config": <ML::OnnxSessionConfig>{"providers": ()},
        });
        QoreModelRegistry::ModelExecutableAdapter u8_adapter =
            registry.loadExecutableAdapter("adapter-onnx-u8", u8_vid);

        hash<auto> u8 = u8_adapter.runFeatureTensor(
            new ML::Tensor(data: ((0,), (255,)), dtype: "int64"),
            "u8_in", ("u8_out",));
        assertEq(((0,), (255,)), u8.u8_out.toList());

        hash<auto> row_out = u8_adapter.runFeatureMatrix(
            ((0.0,), (255.0,)), "u8_in", ("u8_out",));
        assertEq((0, 255), row_out.u8_out);

        assertThrows("ML-REGISTRY-ERROR", "string dtype", sub() {
            adapter.runFeatureMatrixTensors(((1.0,),), "s_in");
        });
    }

    modelPackageInspectionTest() {
        string dir = getTestDir();
        on_exit { cleanupDir(dir); }
        string package_dir = dir + DirSep + "hf_package";
        mkdir_ex(package_dir, 0755, True);

        writeTextFile(package_dir + DirSep + "config.json",
            "{\"model_type\":\"bert\",\"architectures\":[\"BertModel\"],\"torch_dtype\":\"float32\"}");
        writeTextFile(package_dir + DirSep + "tokenizer.json",
            "{\"model\":{\"type\":\"WordPiece\",\"vocab\":{\"[UNK]\":0}}}");
        writeTextFile(package_dir + DirSep + "tokenizer_config.json",
            "{\"model_max_length\":512,\"chat_template\":\"{{ messages }}\"}");
        writeBinaryFile(package_dir + DirSep + "model.safetensors",
            makeSafeTensorsFixture());

        QoreModelRegistry::ModelRegistry registry({"path": dir});
        string vid = registry.registerPackage(package_dir, {
            "name": "hf-source",
            "description": "metadata-only HuggingFace source package",
        });

        hash<QoreModelRegistry::ModelVersionInfo> manifest =
            registry.getVersionManifest("hf-source", vid);
        assertEq("huggingface", manifest.framework, "framework should be inferred");
        assertEq("weights-only", manifest.artifact_kind,
            "SafeTensors package is weights-only");
        assertEq("metadata-only", manifest.runtime,
            "SafeTensors is not locally executable");
        assertFalse(manifest.executable,
            "SafeTensors package should not be executable");
        assertEq("safe-metadata", manifest.safety,
            "SafeTensors should be safe metadata");
        assertEq("tokenizer.json", manifest.tokenizer.tokenizer_json,
            "tokenizer artifact should be detected");
        assertEq(512, manifest.tokenizer.model_max_length,
            "tokenizer_config model_max_length should be captured");
        assertTrue(manifest.tokenizer.has_chat_template,
            "chat template flag should be captured");
        hash<auto> model_config = registry.loadJsonArtifact("hf-source", vid, "config.json");
        assertEq("bert", model_config.model_type,
            "JSON artifact helper should parse config.json");
        hash<auto> tokenizer_config = registry.loadTokenizerConfig("hf-source", vid);
        assertEq("WordPiece", tokenizer_config.model.type,
            "tokenizer helper should load tokenizer.json from the manifest");
        hash<auto> tokenizer_package = registry.loadTokenizerPackageConfig("hf-source", vid);
        assertEq("WordPiece", tokenizer_package.tokenizer_json.model.type,
            "tokenizer package helper should include tokenizer.json");
        assertEq(512, tokenizer_package.tokenizer_config.model_max_length,
            "tokenizer package helper should include tokenizer_config.json");

        list<hash<QoreModelRegistry::ModelArtifactInfo>> artifacts =
            registry.listArtifacts("hf-source", vid);
        assertTrue(artifacts.size() >= 4,
            "all package artifacts should be registered");
        assertThrows("ML-REGISTRY-ERROR", \registry.loadExecutable(), ("hf-source", vid));
    }

    onnxPackageInspectionTest() {
        if (skipOnnx()) {
            return;
        }

        string dir = getTestDir();
        on_exit { cleanupDir(dir); }
        string package_dir = dir + DirSep + "onnx_package";
        mkdir_ex(package_dir, 0755, True);
        writeBinaryFile(package_dir + DirSep + "model.onnx",
            ReadOnlyFile::readBinaryFile(getTestOnnxModelPath()));
        writeBinaryFile(package_dir + DirSep + "model.onnx.data", <01020304>);

        QoreModelRegistry::ModelRegistry registry({"path": dir});
        string vid = registry.registerPackage(package_dir, {
            "name": "onnx-linear",
            "description": "ONNX metadata inspection fixture",
            "execution_config": <ML::OnnxSessionConfig>{"providers": ()},
        });

        hash<QoreModelRegistry::ModelVersionInfo> manifest =
            registry.getVersionManifest("onnx-linear", vid);
        assertEq("onnx", manifest.framework, "ONNX package framework should be inferred");
        assertEq("onnxruntime", manifest.runtime, "ONNX package runtime should be onnxruntime");
        assertEq("raw", manifest.task, "plain ONNX packages should default to raw task");
        assertEq("onnx/raw", manifest.execution.plan.type,
            "plain ONNX packages should expose a raw execution plan");
        assertEq("onnx-preprocess", manifest.preprocess.kind,
            "plain ONNX packages should expose a generated preprocessing contract");
        assertEq("onnx-postprocess", manifest.postprocess.kind,
            "plain ONNX packages should expose a generated postprocessing contract");
        assertEq("raw", manifest.execution.plan.postprocess.output_mode,
            "plain ONNX execution plans should expose raw postprocessing metadata");
        assertEq("onnx-package", manifest.diagnostics.kind,
            "plain ONNX packages should expose actionable diagnostics");
        assertEq("onnx-package", manifest.execution.diagnostics.kind,
            "execution metadata should expose actionable diagnostics");
        assertEq("executable", manifest.artifact_kind, "ONNX package should be executable");
        assertTrue(manifest.execution.input_schema.tensors.size() > 0,
            "ONNX input tensor metadata should be stored in execution input_schema");
        assertEq("X", manifest.execution.input_schema.tensors[0].name,
            "test ONNX model input tensor should be captured");
        assertEq("Y", manifest.execution.output_schema.tensors[0].name,
            "test ONNX model output tensor should be captured");
        assertEq(0, manifest.execution.config.providers.size(),
            "ONNX session configuration should be stored in execution metadata");

        list<hash<QoreModelRegistry::ModelArtifactInfo>> artifacts =
            registry.listArtifacts("onnx-linear", vid);
        assertTrue((select artifacts, $1.role == "external_data").size() > 0,
            "common ONNX external data artifact should be preserved");
        hash<QoreModelRegistry::ModelArtifactInfo> model_artifact =
            (select artifacts, $1.name == "model.onnx")[0];
        assertTrue(model_artifact.metadata.metadata_read,
            "ONNX Runtime should read model metadata during inspection");
        assertTrue(model_artifact.metadata.has_external_data,
            "common adjacent ONNX external data files should be recorded");

        QoreModelRegistry::ModelExecutableAdapter adapter =
            registry.loadExecutableAdapter("onnx-linear", vid);
        hash<auto> rows = adapter.runFeatureMatrix(((4.0,),), NOTHING);
        assertTrue(abs(9.0 - rows.Y[0].toFloat()) < 1e-5,
            sprintf("expected externally-materialized ONNX output 9.0, got %y", rows.Y[0]));
    }

