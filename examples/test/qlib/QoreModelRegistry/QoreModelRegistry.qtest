    constructorWithBackendTest() {
        string dir = getTestDir();
        on_exit { cleanupDir(dir); }

        # Create a backend directly
        QoreModelRegistry::FilesystemBackend backend(dir, "test-tenant");

        # Construct registry with pre-built backend
        QoreModelRegistry::ModelRegistry registry({"backend": backend});

        # Verify it works
        assertEq("test-tenant", registry.getTenantId(),
            "registry should use backend's tenant_id");

        # Register and load a model through the registry
        ML::KMeans km = createFittedKMeans();
        string vid = registry.register(km, {"name": "backend-test"});
        assertTrue(vid.val(), "should get a version_id");

        object loaded = registry.load("backend-test");
        assertTrue(loaded instanceof ML::KMeans, "should load KMeans from backend");

