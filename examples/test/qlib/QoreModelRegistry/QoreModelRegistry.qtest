        });

        hash<QoreModelRegistry::ModelArtifactInfo> info =
            registry.registerOptimizedOnnxArtifact("onnx-opt-linear", vid,
                "model.optimized.onnx",
                <QoreOnnxTools::OnnxOptimizationOptions>{
                    "session_config": <ML::OnnxSessionConfig>{"providers": ()},
                });
