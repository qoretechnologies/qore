class ModelRegistryTest inherits QUnit::Test {
    constructor() : Test("ModelRegistryTest", "1.0") {
        addTestCase("registrationRoundTrip", \registrationRoundTripTest());
        addTestCase("multipleVersions", \multipleVersionsTest());
        addTestCase("tagging", \taggingTest());
        addTestCase("pruning", \pruningTest());
        addTestCase("listModels", \listModelsTest());
        addTestCase("deleteModel", \deleteModelTest());
        addTestCase("errorCases", \errorCasesTest());
        addTestCase("untagging", \untaggingTest());
        addTestCase("getVersionMetadata", \getVersionMetadataTest());
        addTestCase("multiTenantIsolation", \multiTenantIsolationTest());
        addTestCase("multiTenantListTenants", \multiTenantListTenantsTest());
        addTestCase("multiTenantMetadata", \multiTenantMetadataTest());
        addTestCase("multiTenantTagging", \multiTenantTaggingTest());
        addTestCase("multiTenantPruning", \multiTenantPruningTest());
        addTestCase("multiTenantGetTenantId", \multiTenantGetTenantIdTest());
        addTestCase("multiTenantInvalidTenantId", \multiTenantInvalidTenantIdTest());
        addTestCase("backendAccessor", \backendAccessorTest());
        addTestCase("constructorWithBackend", \constructorWithBackendTest());
        addTestCase("deleteTenantStorage", \deleteTenantStorageTest());
        addTestCase("dataProviderNavigation", \dataProviderNavigationTest());
        addTestCase("dataProviderSearch", \dataProviderSearchTest());
        addTestCase("dataProviderPackageCreate", \dataProviderPackageCreateTest());
        addTestCase("dataProviderFactory", \dataProviderFactoryTest());
        addTestCase("filesystemBackendDirect", \filesystemBackendDirectTest());
        addTestCase("namedArtifacts", \namedArtifactsTest());
        addTestCase("executableAdapterNative", \executableAdapterNativeTest());
        addTestCase("executableAdapterOnnxTensor", \executableAdapterOnnxTensorTest());
        addTestCase("executableAdapterOnnxStorageDtypes", \executableAdapterOnnxStorageDtypesTest());
        addTestCase("modelPackageInspection", \modelPackageInspectionTest());
        addTestCase("onnxPackageInspection", \onnxPackageInspectionTest());
        addTestCase("onnxExecutionPlanMetadata", \onnxExecutionPlanMetadataTest());
        addTestCase("onnxRegistryDeploymentContract", \onnxRegistryDeploymentContractTest());
        addTestCase("onnxOptimizedArtifactRegistration", \onnxOptimizedArtifactRegistrationTest());
        addTestCase("onnxQuantizedArtifactDependencyError", \onnxQuantizedArtifactDependencyErrorTest());
        addTestCase("filesystemBackendThreadSafety", \filesystemBackendThreadSafetyTest());
        addTestCase("restBackendCacheInvalidation", \restBackendCacheInvalidationTest());
        addTestCase("databaseBackendIntegration", \databaseBackendIntegrationTest());

        set_return_value(main());
