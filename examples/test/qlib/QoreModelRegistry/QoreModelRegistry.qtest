    deleteTenantStorageTest() {
        string dir = getTestDir();
        on_exit { cleanupDir(dir); }

        # Create tenant registries and register models
        ML::KMeans km = createFittedKMeans();

        QoreModelRegistry::ModelRegistry tenant_a({
            "path": dir,
            "tenant_id": "delete-me",
        });
        tenant_a.register(km, {"name": "model1"});
        tenant_a.register(km, {"name": "model2"});

        QoreModelRegistry::ModelRegistry tenant_b({
            "path": dir,
            "tenant_id": "keep-me",
        });
        tenant_b.register(km, {"name": "model1"});

        # Verify both tenants exist
        QoreModelRegistry::ModelRegistry admin({"path": dir});
        list<string> tenants = admin.listTenants();
        assertEq(2, tenants.size(), "should have 2 tenants before deletion");

        # Delete tenant A's storage
        admin.deleteTenantStorage("delete-me");

        # Verify tenant A is gone
        tenants = admin.listTenants();
        assertEq(1, tenants.size(), "should have 1 tenant after deletion");
        assertEq("keep-me", tenants[0], "remaining tenant should be 'keep-me'");

        # Verify tenant B is unaffected
        list<string> b_models = tenant_b.listModels();
        assertEq(1, b_models.size(), "tenant B should still have 1 model");

        # Deleting nonexistent tenant should throw
        assertThrows("ML-REGISTRY-ERROR", \admin.deleteTenantStorage(),
            "nonexistent-tenant");

        # Deleting invalid tenant_id should throw
        assertThrows("ML-REGISTRY-ERROR", \admin.deleteTenantStorage(),
            "../escape");
    }

    dataProviderNavigationTest() {
        string dir = getTestDir();
        on_exit { cleanupDir(dir); }

        QoreModelRegistry::ModelRegistry registry({"path": dir});

        # Register models
        ML::KMeans km = createFittedKMeans();
        registry.register(km, {"name": "alpha_model"});
        registry.register(km, {"name": "beta_model"});

        # Create DataProvider from existing registry
        QoreModelRegistry::ModelRegistryDataProvider dp(registry);

        # Navigate: list model names as children
        *list<string> children = dp.getChildProviderNames();
        assertEq(2, children.size(), "should have 2 child providers");
        assertTrue(children.contains("alpha_model"),
            "should contain alpha_model");
        assertTrue(children.contains("beta_model"),
            "should contain beta_model");

        # Navigate to a specific model
        *AbstractDataProvider child = dp.getChildProvider("alpha_model");
        assertTrue(child instanceof QoreModelRegistry::ModelVersionsDataProvider,
            "child should be ModelVersionsDataProvider");
        assertEq("alpha_model", child.getName(), "child name should match");

        # Nonexistent model returns NOTHING
        assertNothing(dp.getChildProvider("nonexistent"),
            "nonexistent model should return NOTHING");
    }

    dataProviderSearchTest() {
        string dir = getTestDir();
        on_exit { cleanupDir(dir); }

        QoreModelRegistry::ModelRegistry registry({"path": dir});

        ML::KMeans km = createFittedKMeans();
        ML::LinearRegression lr = createFittedLR();

        string vid1 = registry.register(km, {
            "name": "search_model",
            "description": "first version",
        });
        registry.register(lr, {
            "name": "search_model",
            "description": "second version",
        });

        # Get the model versions provider
        QoreModelRegistry::ModelRegistryDataProvider dp(registry);
        AbstractDataProvider versions_dp = dp.getChildProvider("search_model");

        # Search all versions
        AbstractDataProviderRecordIterator it = versions_dp.searchRecords();
        list<hash<auto>> results();
        while (it.next()) {
            push results, it.getValue();
        }
        assertEq(2, results.size(), "should find 2 versions");
        assertEq("KMeans", results[0].algorithm, "first should be KMeans");
        assertEq("LinearRegression", results[1].algorithm,
            "second should be LinearRegression");

        # Search with filter
        it = versions_dp.searchRecords({"algorithm": "KMeans"});
        results = ();
        while (it.next()) {
            push results, it.getValue();
        }
        assertEq(1, results.size(), "filtered should find 1 version");
        assertEq(vid1, results[0].version_id, "should be the KMeans version");
    }

    dataProviderPackageCreateTest() {
        string dir = getTestDir();
        on_exit { cleanupDir(dir); }
        string registry_dir = dir + DirSep + "registry";
        string package_dir = dir + DirSep + "dp_package";
        mkdir_ex(registry_dir, 0755, True);
        mkdir_ex(package_dir, 0755, True);

        writeTextFile(package_dir + DirSep + "config.json",
            "{\"model_type\":\"bert\",\"architectures\":[\"BertModel\"]}");
        writeTextFile(package_dir + DirSep + "tokenizer.json",
            "{\"model\":{\"type\":\"WordPiece\",\"vocab\":{\"[UNK]\":0}}}");
        writeTextFile(package_dir + DirSep + "tokenizer_config.json",
            "{\"model_max_length\":256}");
        writeBinaryFile(package_dir + DirSep + "model.safetensors",
            makeSafeTensorsFixture());

        QoreModelRegistry::ModelRegistry registry({"path": registry_dir});
        QoreModelRegistry::ModelRegistryDataProvider dp(registry);

        hash<auto> created = dp.createRecord({
            "name": "dp-package",
            "package_path": package_dir,
            "description": "DataProvider-created package",
            "tags": ("data-provider",),
        });
        assertEq("dp-package", created.name, "created package model name should match");
        assertEq("metadata-only", created.runtime, "SafeTensors package runtime");
        assertEq("tokenizer.json", created.tokenizer_json,
            "tokenizer artifact should be exposed in created record");
        assertTrue(created.artifact_count >= 4,
            "created record should expose package artifact count");

        *list<string> children = dp.getChildProviderNames();
        assertTrue(children.contains("dp-package"),
            "root provider cache should be invalidated after create");

        AbstractDataProvider versions_dp = dp.getChildProvider("dp-package");
        assertTrue(versions_dp instanceof QoreModelRegistry::ModelVersionsDataProvider,
            "created model child should be a versions provider");

        AbstractDataProviderRecordIterator it =
            versions_dp.searchRecords({"version_id": created.version_id});
        assertTrue(it.next(), "created version should be searchable");
        hash<auto> version_record = it.getValue();
        assertEq(created.version_id, version_record.version_id,
            "version search should return created version");
        assertEq("tokenizer.json", version_record.tokenizer_json,
            "version record should expose tokenizer metadata");
        assertFalse(it.next(), "version_id filter should return one record");

        *list<string> version_children = versions_dp.getChildProviderNames();
        assertTrue(version_children.contains(created.version_id),
            "version provider should expose version IDs as artifact children");

        AbstractDataProvider artifacts_dp = versions_dp.getChildProvider(created.version_id);
        assertTrue(artifacts_dp instanceof QoreModelRegistry::ModelVersionArtifactsDataProvider,
            "version child should be an artifact provider");

        it = artifacts_dp.searchRecords({"role": "tokenizer"});
        assertTrue(it.next(), "artifact provider should find tokenizer artifact");
        assertEq("tokenizer.json", it.getValue().name,
            "tokenizer artifact name should match");

        string notes_path = dir + DirSep + "notes.json";
        writeTextFile(notes_path, "{\"source\":\"dataprovider\"}");
        hash<auto> artifact = artifacts_dp.createRecord({
            "artifact_path": notes_path,
            "role": "metadata",
            "format": "json",
            "safe_to_parse": True,
        });
        assertEq("notes.json", artifact.name,
            "artifact path create should default artifact_name to basename");
        assertEq("metadata", artifact.role, "artifact role override should be applied");
        assertEq(File::readBinaryFile(notes_path).size(),
            registry.loadNamedArtifact("dp-package", created.version_id, "notes.json").size(),
            "DataProvider-created artifact should round-trip through registry");

        it = artifacts_dp.searchRecords({"name": "notes.json"});
        assertTrue(it.next(), "new artifact should be searchable");
        assertEq("json", it.getValue().format, "new artifact format should match");
    }

    dataProviderFactoryTest() {
