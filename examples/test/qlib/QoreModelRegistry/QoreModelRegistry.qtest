    filesystemBackendThreadSafetyTest() {
        string dir = getTestDir();
        on_exit { cleanupDir(dir); }

        QoreModelRegistry::ModelRegistry registry({"path": dir});

        # Register a base model
        ML::KMeans km = createFittedKMeans();
        registry.register(km, {"name": "thread-test"});

        # Concurrent reads — multiple threads loading simultaneously
        list<Counter> counters();
        Counter done(4);

        for (int t = 0; t < 4; ++t) {
            background sub() {
                on_exit done.dec();
                for (int i = 0; i < 10; ++i) {
                    object model = registry.load("thread-test");
                    @assert(model instanceof ML::KMeans);
                }
            }();
        }

        done.waitForZero();

        # Concurrent writes — multiple threads registering versions
        Counter write_done(4);
        for (int t = 0; t < 4; ++t) {
            background sub() {
                on_exit write_done.dec();
                for (int i = 0; i < 5; ++i) {
                    ML::KMeans k({"k": 2, "seed": 42});
                    k.fitMatrix(((1.0, 1.0), (5.0, 5.0)));
                    registry.register(k, {"name": "thread-test"});
                }
            }();
        }

        write_done.waitForZero();

        # Should have 1 (original) + 20 (4 threads * 5) = 21 versions
        list<hash<auto>> versions = registry.listVersions("thread-test");
        assertEq(21, versions.size(),
            "should have 21 versions after concurrent registration");

        # All versions should be loadable
        foreach hash<auto> v in (versions) {
            object m = registry.load("thread-test", v.version_id);
            assertTrue(m instanceof ML::KMeans,
                sprintf("version %s should load as KMeans", v.version_id));
        }
    }

    databaseBackendIntegrationTest() {
%ifdef NoPgsql
        testSkip("pgsql module not available");
%endif
%ifdef NoSqlUtil
        testSkip("SqlUtil module not available");
%endif
        *string dsn = ENV.QORE_DB_CONNSTR_PGSQL;
        if (!dsn) {
            testSkip("QORE_DB_CONNSTR_PGSQL not set");
        }
        Datasource ds(dsn);
        try {
            ds.open();
        } catch (hash<ExceptionInfo> ex) {
            testSkip(sprintf("PostgreSQL not available: %s", ex.desc));
        }
        on_exit ds.close();

        string prefix = "ml_test_";

        # Use DataSchema with DatabaseBackend's table definitions for
        # DB-independent schema management
        hash<auto> schema_def = {
            "schema": {
                "name": "MlRegistryTest",
                "version": "1.0",
            },
            "sequences": {
                (prefix + "seq_models"): {},
                (prefix + "seq_versions"): {},
                (prefix + "seq_blobs"): {},
            },
            "tables": QoreModelRegistry::DatabaseBackend::getTableDefinitions(prefix),
        };

        hash<auto> normalized = Schema::DataSchemaLoader::loadHash(schema_def, False);
        Schema::DataSchema schema(ds, normalized);
        on_exit {
            schema.drop(True);
            ds.commit();
        }
        schema.align();
        ds.commit();

        # Create backend
        QoreModelRegistry::DatabaseBackend backend(ds, {
            "table_prefix": prefix,
            "tenant_id": "test-tenant",
        });

        # Test: register a model version
        ML::KMeans km = createFittedKMeans();
        binary artifact = ML::ml_serialize(km);
        string version_id = format_date("YYYYMMDDHHmmss", now()) + "_"
            + get_random_bytes(4).toHex();

        hash<QoreModelRegistry::ModelVersionInfo> meta({
            "version_id": version_id,
            "name": "db-test-model",
            "algorithm": "KMeans",
            "created": format_date("YYYY-MM-DDTHH:mm:ssZ", now()),
            "tags": (),
            "file_size": artifact.size(),
            "format": "qml",
            "tenant_id": "test-tenant",
        });

        string vid = backend.registerVersion("db-test-model", artifact, meta);
        assertEq(version_id, vid, "DB: registerVersion should return version_id");

        # Test: list models
        list<string> models = backend.listModels();
        assertEq(1, models.size(), "DB: should have 1 model");
        assertEq("db-test-model", models[0], "DB: model name should match");

        # Test: list versions
        list<hash<QoreModelRegistry::ModelVersionInfo>> versions =
            backend.listVersions("db-test-model");
        assertEq(1, versions.size(), "DB: should have 1 version");
        assertEq(version_id, versions[0].version_id, "DB: version_id should match");
        assertEq("KMeans", versions[0].algorithm, "DB: algorithm should match");
        assertEq("test-tenant", versions[0].tenant_id, "DB: tenant_id should match");

        # Test: load artifact and verify round-trip
        binary loaded = backend.loadArtifact("db-test-model", version_id);
        assertEq(artifact.size(), loaded.size(), "DB: artifact size should match");
        object loaded_model = ML::ml_deserialize(loaded);
        assertTrue(loaded_model instanceof ML::KMeans,
            "DB: deserialized model should be KMeans");

        # Test: get version metadata directly
        hash<QoreModelRegistry::ModelVersionInfo> vmeta =
            backend.getVersionMetadata("db-test-model", version_id);
        assertEq("KMeans", vmeta.algorithm, "DB: metadata algorithm should match");

        # Test: tag and untag
        backend.tag("db-test-model", version_id, "production");
        versions = backend.listVersions("db-test-model");
        assertTrue(versions[0].tags.contains("production"), "DB: tag should be present");

        backend.untag("db-test-model", version_id, "production");
        versions = backend.listVersions("db-test-model");
        assertFalse(versions[0].tags.contains("production"), "DB: tag should be removed");

        # Test: register multiple versions and prune
        for (int i = 0; i < 4; ++i) {
            string v = format_date("YYYYMMDDHHmmss", now()) + "_"
                + get_random_bytes(4).toHex();
            hash<QoreModelRegistry::ModelVersionInfo> m({
                "version_id": v,
                "name": "db-test-model",
                "algorithm": "KMeans",
                "created": format_date("YYYY-MM-DDTHH:mm:ssZ", now()),
                "tags": (),
                "file_size": artifact.size(),
                "format": "qml",
                "tenant_id": "test-tenant",
            });
            backend.registerVersion("db-test-model", artifact, m);
        }
        versions = backend.listVersions("db-test-model");
        assertEq(5, versions.size(), "DB: should have 5 versions before prune");

        int deleted = backend.prune("db-test-model",
            <QoreModelRegistry::PruneOptions>{"keep_latest": 2});
        assertEq(3, deleted, "DB: should prune 3 versions");

        versions = backend.listVersions("db-test-model");
        assertEq(2, versions.size(), "DB: should have 2 versions after prune");

        # Test: multi-tenant isolation
        QoreModelRegistry::DatabaseBackend other_tenant(ds, {
            "table_prefix": prefix,
            "tenant_id": "other-tenant",
        });
        list<string> other_models = other_tenant.listModels();
        assertEq(0, other_models.size(),
            "DB: other tenant should see 0 models");

        # Test: list tenants
        QoreModelRegistry::DatabaseBackend admin_backend(ds, {
            "table_prefix": prefix,
        });
        list<string> tenants = admin_backend.listTenants();
        assertTrue(tenants.contains("test-tenant"),
            "DB: tenants should include test-tenant");

        # Test: delete model
        backend.deleteModel("db-test-model");
        models = backend.listModels();
        assertEq(0, models.size(), "DB: should have 0 models after delete");

        # Test: delete nonexistent model should throw
        assertThrows("ML-REGISTRY-ERROR", \backend.deleteModel(), "nonexistent");
    }

    restBackendCacheInvalidationTest() {
        # Test RestBackend cache invalidation (without a real REST server)
        # We can test the cache invalidation logic directly

        # Create a mock REST client (just an object with get/post/put/del methods)
        MockRestClient mock({"_dummy": True});

        QoreModelRegistry::RestBackend backend(mock, "/api/models");

        # Test cache invalidation by name
        # Manually populate cache (using internal knowledge)
        # Since we can't easily call loadArtifact without a real server,
        # just test the invalidateCache and clearCache methods don't throw
        backend.invalidateCache("some-model");
        backend.invalidateCache("some-model", "some-version");
        backend.clearCache();
        assertTrue(True, "cache invalidation methods should not throw");
    }
}

#! Simple mock REST client for testing
class MockRestClient {
    private {
        hash<auto> responses;
    }

    constructor(hash<auto> responses) {
        self.responses = responses;
    }

    hash<auto> get(string path, auto body, *hash<auto> hdrs) {
        return {"body": responses{path} ?? {}};
    }

    hash<auto> post(string path, auto body, auto x, *hash<auto> hdrs) {
        return {"body": responses{path} ?? {}};
    }

    hash<auto> put(string path, auto body, auto x, *hash<auto> hdrs) {
        return {"body": responses{path} ?? {}};
    }

    hash<auto> del(string path, auto body, *hash<auto> hdrs) {
        return {"body": responses{path} ?? {}};
    }
}
