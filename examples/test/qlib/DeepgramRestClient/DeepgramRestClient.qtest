#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/DeepgramRestClient.qm

%exec-class DeepgramRestClientTest

public class DeepgramRestClientTest inherits QUnit::Test {
    constructor() : Test("DeepgramRestClient Test", "1.0") {
        addTestCase("connection scheme registered",       \connectionSchemeTest());
        addTestCase("apikey maps to Authorization: Token header",
            \tokenAuthMappingTest());
        addTestCase("default URL applied when not provided",
            \defaultUrlTest());
        addTestCase("existing default_headers are preserved",
            \preserveExistingHeadersTest());
        set_return_value(main());
    }

    private connectionSchemeTest() {
        hash<ConnectionSchemeInfo> info =
            ConnectionProvider::ConnectionSchemeCache::getScheme("deepgram");
        assertEq("Deepgram REST Connection", info.display_name);
        assertTrue(info.schemes.deepgram);
        assertEq("apikey", info.required_options);
        assertEq("v1/projects", info.options.ping_path.default_value);
    }

    private tokenAuthMappingTest() {
        hash<auto> opts = DeepgramRestClient::DeepgramRestClientBase::getOptions({
            "apikey": "secret-key-123",
        });
        # apikey is rewritten to Authorization: Token header
        assertEq("Token secret-key-123", opts.default_headers.Authorization);
        # apikey itself is removed from the options hash to avoid Bearer fallback
        assertEq(NOTHING, opts.apikey);
    }

    private defaultUrlTest() {
        hash<auto> opts = DeepgramRestClient::DeepgramRestClientBase::getOptions({
            "apikey": "x",
        });
        assertEq("https://api.deepgram.com", opts.url);
    }

    private preserveExistingHeadersTest() {
        # If the caller already supplied default_headers, they should be merged
        # (not overwritten) by the Authorization injection.
        hash<auto> opts = DeepgramRestClient::DeepgramRestClientBase::getOptions({
            "apikey": "k",
            "default_headers": {"X-Trace-Id": "abc"},
        });
        assertEq("Token k",      opts.default_headers.Authorization);
        assertEq("abc",          opts.default_headers."X-Trace-Id");
    }
}
