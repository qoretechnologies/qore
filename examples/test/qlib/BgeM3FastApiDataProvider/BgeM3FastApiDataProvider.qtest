%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires Mime
%requires QUnit
%requires Logger
%requires HttpServerUtil
%requires HttpServerAsyncIo
%requires HttpServer
%requires RestClient
%requires RestClientIo
%requires ConnectionProvider
%requires DataProvider
%requires BgeM3RestClient
%requires BgeM3FastApiDataProvider

%requires json

%exec-class BgeM3FastApiDataProviderTest

#! HTTP stub that records every request and returns a configurable response per path.
class FakeBgeM3Handler inherits AbstractHttpRequestHandler {
    public {
        list<hash<auto>> requests = ();
        hash<string, hash<auto>> responses;
        Mutex m();
    }

    constructor(hash<string, hash<auto>> responses) {
        self.responses = responses;
    }

    hash handleRequest(hash cx, hash hdr, *data body) {
        m.lock();
        on_exit m.unlock();
        hash<auto> body_parsed = body.val() && hdr."content-type" =~ /json/ ? parse_json(body) : {};
        push requests, {
            "path": cx.raw_path,
            "method": hdr.method,
            "auth": hdr."authorization",
            "accept": hdr."accept",
            "body": body_parsed,
        };
        *hash<auto> resp = responses{cx.raw_path};
        if (!resp) {
            return makeResponse(404, "{\"detail\":\"Not Found\"}",
                {"Content-Type": MimeTypeJson});
        }
        int code = resp.code ?? 200;
        string content_type = resp.content_type ?? MimeTypeJson;
        string body_out = resp.body.typeCode() == NT_STRING
            ? resp.body
            : make_json(resp.body);
        return makeResponse(code, body_out, {"Content-Type": content_type});
    }
}

public class BgeM3FastApiDataProviderTest inherits QUnit::Test {
    private {
        HttpServer http;
        int port;
        FakeBgeM3Handler handler;
    }

    constructor() : Test("BgeM3FastApiDataProviderTest", "1.0") {
        addTestCase("root provider name + child names", \testRootSanity());
        addTestCase("flat ChildMap covers every registered action path",
            \testChildMapPathResolution());
        addTestCase("create-embeddings round-trip", \testEmbeddingsRoundTrip());
        addTestCase("create-embeddings request type fields",
            \testEmbeddingsRequestTypeFields());
        addTestCase("health round-trip", \testHealthRoundTrip());
        addTestCase("metrics round-trip wraps Prometheus body in {text}",
            \testMetricsRoundTrip());
        addTestCase("action catalog options + output_type populated",
            \testActionCatalogShape());
        addTestCase("connection scheme registered + getDataProvider works",
            \testConnectionScheme());
        addTestCase("ping cannot verify the credential (documented limitation)",
            \testPingDoesNotVerifyAuth());
        set_return_value(main());
    }

    globalSetUp() {
        Logger logger("test", LoggerLevel::getLevelWarn());
        hash<HttpServerOptionInfo> http_opts = <HttpServerOptionInfo>{
            "logger": logger,
            "debug": False,
        };
        http = new HttpServer(http_opts);
        port = http.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
    }

    globalTearDown() {
        delete http;
    }

    private checkModule() {
    }

    private installHandler(hash<string, hash<auto>> responses) {
        if (handler) {
            http.removeHandler("emb");
        }
        handler = new FakeBgeM3Handler(responses);
        # path regex ".*" matches every URL, including single-segment paths like
        # "health" / "metrics" that have no embedded "/" once the leading slash
        # is stripped during handler lookup
        http.setHandler("emb", ".*", NOTHING, handler);
    }

    private string testUrl() {
        return "http://localhost:" + port;
    }

    private RestClientIo::RestClientIo makeRest() {
        return new BgeM3RestClient::BgeM3RestClientIo({"url": testUrl()});
    }

    testRootSanity() {
        checkModule();
        installHandler({});
        BgeM3FastApiDataProvider::BgeM3FastApiDataProvider prov(makeRest());
        assertEq("bge-m3-fastapi", prov.getName());
        # filter out the framework-injected __call__ child (covered by
        # GenericApiCallAutoInjection.qtest in RestClientDataProvider)
        assertEq(("create-embeddings", "health", "metrics"),
            sort(select prov.getChildProviderNames(),
                $1 != AbstractDataProvider::GenericApiCallChildName));
    }

    testChildMapPathResolution() {
        # Every registered action path must resolve through the root provider's
        # ChildMap; mismatched paths silently disable ref_data and doRequestImpl.
        installHandler({});
        BgeM3FastApiDataProvider::BgeM3FastApiDataProvider prov(makeRest());
        list<string> child_names = sort(prov.getChildProviderNames());

        list<hash<DataProviderActionInfo>> actions = (
            DataProviderActionCatalog::getAppAction(
                BgeM3FastApiDataProvider::BgeM3FastApiDataProvider::AppName,
                "create-embeddings"),
            DataProviderActionCatalog::getAppAction(
                BgeM3FastApiDataProvider::BgeM3FastApiDataProvider::AppName,
                "health"),
            DataProviderActionCatalog::getAppAction(
                BgeM3FastApiDataProvider::BgeM3FastApiDataProvider::AppName,
                "metrics"),
        );
        foreach hash<DataProviderActionInfo> action in (actions) {
            list<string> segs = action.path.split("/");
            # path is "/<name>" → split yields ("", "<name>")
            string first = segs[1];
            assertEq(True, inlist(first, child_names),
                sprintf("action path %y first segment %y must be a child of root",
                    action.path, first));
        }
    }

    testEmbeddingsRoundTrip() {
        checkModule();
        installHandler({
            "/embed": {
                "code": 200,
                "body": {
                    "dense": ((0.1, 0.2, 0.3),),
                    "sparse": ({"42": 0.9, "73": 0.4},),
                },
            },
        });
        BgeM3FastApiDataProvider::BgeM3FastApiDataProvider prov(makeRest());
        AbstractDataProvider emb = prov.getChildProvider("create-embeddings");
        assertEq("create-embeddings", emb.getName());

        hash<auto> resp = emb.doRequest({
            "texts": ("hello",),
            "return_dense": True,
            "return_sparse": True,
            "batch_size": 128,
        });

        # request shape
        assertEq(1, handler.requests.size());
        assertEq("POST", handler.requests[0].method);
        assertEq("/embed", handler.requests[0].path);
        assertEq(("hello",), handler.requests[0].body.texts);
        assertEq(True, handler.requests[0].body.return_dense);
        assertEq(True, handler.requests[0].body.return_sparse);
        assertEq(128, handler.requests[0].body.batch_size);

        # response shape — both dense and sparse populated
        assertEq(1, resp.dense.size());
        assertEq((0.1, 0.2, 0.3), resp.dense[0]);
        assertEq(1, resp.sparse.size());
        assertEq(0.9, resp.sparse[0]."42");
    }

    testEmbeddingsRequestTypeFields() {
        BgeM3FastApiEmbeddingsRequestDataType req_type();
        hash<string, AbstractDataField> fields = req_type.getFields();

        # Type was constructed via addQoreFields() — fields must actually be present.
        # This catches the silent HashDataType("Name", Fields) anti-pattern.
        assertEq(True, fields.hasKey("texts"));
        assertEq(True, fields.hasKey("return_dense"));
        assertEq(True, fields.hasKey("return_sparse"));
        assertEq(True, fields.hasKey("batch_size"));
        assertEq(4, fields.size());
    }

    testHealthRoundTrip() {
        checkModule();
        installHandler({
            "/health": {
                "code": 200,
                "body": {
                    "status": "ok",
                    "memory": {
                        "total_bytes": 128453689344,
                        "available_bytes": 45852987392,
                        "available_fraction": 0.357,
                        "pressure": "ok",
                    },
                },
            },
        });
        BgeM3FastApiDataProvider::BgeM3FastApiDataProvider prov(makeRest());
        AbstractDataProvider hlth = prov.getChildProvider("health");
        assertEq("health", hlth.getName());

        hash<auto> resp = hlth.doRequest(NOTHING);
        assertEq("GET", handler.requests[0].method);
        assertEq("/health", handler.requests[0].path);
        assertEq("ok", resp.status);
        assertEq("ok", resp.memory.pressure);
        assertEq(128453689344, resp.memory.total_bytes);
    }

    testMetricsRoundTrip() {
        checkModule();
        installHandler({
            "/metrics": {
                "code": 200,
                "content_type": "text/plain",
                "body": "# HELP bge_m3_memory_pressure ok\n"
                    "# TYPE bge_m3_memory_pressure gauge\n"
                    "bge_m3_memory_pressure 0.357\n",
            },
        });
        BgeM3FastApiDataProvider::BgeM3FastApiDataProvider prov(makeRest());
        AbstractDataProvider mtr = prov.getChildProvider("metrics");
        assertEq("metrics", mtr.getName());

        hash<auto> resp = mtr.doRequest(NOTHING);
        assertEq("GET", handler.requests[0].method);
        assertEq("/metrics", handler.requests[0].path);
        # Provider wraps the raw text body in {text}
        assertEq(True, resp.text.val());
        assertRegex("bge_m3_memory_pressure", resp.text);
    }

    testActionCatalogShape() {
        # Per data-provider-checklist §5: every DPAT_API action MUST have
        # `options` populated and `output_type` set.
        list<string> actions = ("create-embeddings", "health", "metrics");
        foreach string a in (actions) {
            hash<DataProviderActionInfo> action = DataProviderActionCatalog::getAppAction(
                BgeM3FastApiDataProvider::BgeM3FastApiDataProvider::AppName, a);
            assertEq(DPAT_API, action.action_code, sprintf("%y action_code", a));
            assertEq(True, exists action.output_type, sprintf("%y output_type", a));
        }

        # create-embeddings: texts is required + preselected; return_dense/return_sparse preselected.
        hash<DataProviderActionInfo> ce = DataProviderActionCatalog::getAppAction(
            BgeM3FastApiDataProvider::BgeM3FastApiDataProvider::AppName,
            "create-embeddings");
        assertEq(True, ce.options.texts.required);
        assertEq(True, ce.options.return_dense.preselected);
        assertEq(True, ce.options.return_sparse.preselected);
        # output_type is the response data type
        assertTrue(ce.output_type
            instanceof BgeM3FastApiDataProvider::BgeM3FastApiEmbeddingsResponseDataType);
    }

    #! Test that the connection's ping cannot detect an unusable credential
    /** This pins a deliberate, documented limitation, not a bug.  The BGE-M3 sidecar serves every
        route it has - \c "/embed", \c "/health" and \c "/metrics" - without authentication, so
        none of them can answer 401 for a missing or wrong key.  \c "/health", the ping target, is
        additionally the Kubernetes liveness and readiness probe path, so it has to stay open even
        in a deployment that fronts the sidecar with an auth-enforcing gateway, because kubelet
        cannot present a bearer token.  A green ping is therefore not evidence that the credential
        works.

        The fake sidecar installed here models exactly that deployment: \c "/health" open, and the
        gateway rejecting the bad credential on \c "/embed".

        If a future change moves the ping to an endpoint that does exercise authentication, this
        test is expected to fail - update @ref bgem3restclientping in BgeM3RestClient.qm with it.
    */
    testPingDoesNotVerifyAuth() {
        checkModule();
        installHandler({
            # the k8s probe path: open even behind an auth-enforcing gateway
            "/health": {
                "code": 200,
                "body": {"status": "ok"},
            },
            # real work: the gateway rejects the bad credential here
            "/embed": {
                "code": 401,
                "body": {"detail": "Unauthorized"},
            },
        });

        string bad_key = "definitely-not-a-valid-bge-m3-key";

        BgeM3RestClient::BgeM3RestConnection conn("test-badkey", "wrong credential",
            "bge-m3://localhost:" + port, {}, {"apikey": bad_key});

        # the ping targets the unauthenticated probe path ...
        assertEq("/health", conn.opts.ping_path);
        assertEq("GET", conn.opts.ping_method);

        # ... so the connection is reported healthy despite carrying an unusable credential
        hash<PingInfo> p = conn.ping(False);
        assertTrue(p.ok, sprintf("ping unexpectedly failed: %y", p.info));
        assertEq("OK", p.info);

        # the ping really did go to /health, and really did carry the credential that the probe
        # path ignores - the key is sent, it is simply never checked
        *hash<auto> ping_req = handler.requests.last();
        assertEq("/health", ping_req.path);
        assertEq("GET", ping_req.method);
        assertEq("Bearer " + bad_key, ping_req.auth);

        # meanwhile the credential is genuinely unusable: embedding traffic fails 401, which is
        # where the problem actually surfaces for an operator
        BgeM3RestClient::BgeM3RestClientIo rest({"url": testUrl(), "apikey": bad_key});
        on_exit delete rest;
        assertThrows("REST-RESPONSE-ERROR", \rest.restDoRequest(),
            ("POST", "/embed", {"texts": ("ping",)}));
    }

    testConnectionScheme() {
        # Scheme was registered at module init time.
        *hash<ConnectionSchemeInfo> info = ConnectionSchemeCache::getScheme("bge-m3");
        assertEq(True, exists info, "bge-m3 scheme registered");
        assertEq(True, info.schemes."bge-m3");

        # Build a connection from the URL and verify it returns a data provider.
        BgeM3RestClient::BgeM3RestConnection conn(
            "test", "test connection", "bge-m3://localhost:" + port);
        assertEq("bge-m3", conn.getType());
        assertEq(True, conn.hasDataProvider());
    }
}
