    constructor() : QUnit::Test("WebSocketClientExtConnectUnsupportedTest", "1.0") {
        logger = new Logger("ws-ext-connect-unsupported-test", LoggerLevel::getLevelInfo());
        logger.addAppender(log_capture);
        addTestCase("2.0: the refusal is reported at once", sub () { testRefusal("2.0"); });
        addTestCase("auto: the HTTP/1.1 Upgrade is tried at once", sub () { testRefusal("auto"); });
        set_return_value(main());
    }

    globalSetUp() {
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }
    }

%ifdef NoProcess
    private testRefusal(string http_version) {
        testSkip("the process module is not available");
    }
%else
    private testRefusal(string http_version) {
        string node_bin = ENV.NODE_BIN ?? "node";
        if (system(node_bin + " -v > /dev/null 2>&1")) {
            testSkip("node is not available");
        }
        TmpDir dir("ws-ext-connect-unsupported-");
        foreach hash<auto> i in ({"cert.pem": CertPem, "key.pem": KeyPem}.pairIterator()) {
            File f();
            f.open2(dir.path + "/" + i.key, O_CREAT | O_TRUNC | O_WRONLY);
            f.write(i.value);
            f.close();
        }
        Process p(node_bin, (get_script_dir() + "/http2-no-connect-protocol-server.js", dir.path + "/cert.pem",
            dir.path + "/key.pem"));
        on_exit {
            if (p.running()) {
                p.terminate();
            }
            p.wait();
        }
        string line = "";
        while (line !~ /\n/) {
            *string s = p.readStdout(1024, 60s);
            if (!exists s) {
                throw "TEST-ERROR", sprintf("the node server did not start: %s", p.readStderr(4096, 0) ?? "");
            }
            line += s;
        }
        *string port = (line =~ x/READY ([0-9]+)/)[0];
        assertTrue(exists port, "the node server reported its port: " + line);

        WebSocketClient wsc(sub (*data msg) {}, {
            "url": "wss://127.0.0.1:" + port + "/ws",
            "logger": logger,
            "http_version": http_version,
            "ssl_verify_cert": False,
            "timeout": 10s,
            "connect_timeout": 10s,
        });
        on_exit {
            try {
                wsc.disconnect();
            } catch () {
            }
        }
        log_capture.takeMessages();
        string err;
        try {
            wsc.connect();
            err = "connected";
        } catch (hash<ExceptionInfo> ex) {
            err = sprintf("%s: %s", ex.err, ex.desc);
        }
        list<string> retries = select log_capture.takeMessages(), $1 =~ /retrying on a fresh connection/;
        assertEq((), retries, http_version + ": the refusal is not retried as a connection error");
        # the server counts the TLS connections: the refusal costs one connection, and the HTTP/1.1 Upgrade of "auto"
        # one more
        p.write("COUNT\n");
        line = "";
        while (line !~ /CONNECTIONS [0-9]+\n/) {
            *string s = p.readStdout(1024, 60s);
            if (!exists s) {
                throw "TEST-ERROR", sprintf("the node server did not report its connections: %s",
                    p.readStderr(4096, 0) ?? "");
            }
            line += s;
        }
        assertEq(http_version == "auto" ? 2 : 1, (line =~ x/CONNECTIONS ([0-9]+)/)[0].toInt(),
            http_version + ": TLS connections");
        if (http_version == "auto") {
            # the HTTP/1.1 Upgrade gets the page
            assertRegex("^WEBSOCKET-ERROR: HTTP server at URL .* returned status code '200' to our WebSocket request; "
                "expecting '101", err, "auto: the fallback's answer");
        } else {
            assertRegex("^HTTP2-EXTENDED-CONNECT-UNSUPPORTED: ", err, "2.0: the refusal");
        }
    }
%endif
}
