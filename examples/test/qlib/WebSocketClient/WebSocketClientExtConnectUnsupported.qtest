%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires FsUtil
%requires Logger
%requires WebSocketClient

%try-module process >= 2.2
%define NoProcess
%endtry

%exec-class WebSocketClientExtConnectUnsupportedTest

#! keeps the messages that the client logs
class LogCapture inherits LoggerAppenderWithLayout {
    private {
        list<string> messages = ();
        Mutex lck();
    }

    constructor() : LoggerAppenderWithLayout("capture", new LoggerLayoutPattern("%m")) {
        open();
    }

    processEventImpl(int type, auto params) {
        if (type == EVENT_LOG) {
            AutoLock al(lck);
            messages += params;
        }
    }

    #! returns the messages logged since the last call and clears them
    list<string> takeMessages() {
        AutoLock al(lck);
        on_exit messages = ();
        return messages;
    }
}

#! issue #5672: an HTTP/2 server's refusal of extended CONNECT is not retried as a connection error
/** A server that does not advertise SETTINGS_ENABLE_CONNECT_PROTOCOL (RFC 8441) cannot tunnel WebSocket over
    HTTP/2; the client raised that as \c HTTP2-CONNECT-ERROR, a connection error, which the WebSocket client retried
    on fresh connections up to its retry budget before it fell back to HTTP/1.1 (or reported it).  The refusal is now
    \c HTTP2-EXTENDED-CONNECT-UNSUPPORTED and is not retried.
*/
