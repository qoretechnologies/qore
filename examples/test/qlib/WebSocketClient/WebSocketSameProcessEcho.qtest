#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

# Copyright (C) 2026 Qore Technologies, s.r.o.

# Tests same-process WebSocket echo (server gotMessage -> send response)
# for all protocol levels. The H3 test exposes the wakeSocket bug where
# the server's QUIC poll op is never woken to flush response packets.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Mime
%requires Logger
%requires DataProvider
%requires ConnectionProvider
%requires HttpServerUtil
%requires AsyncSocketIo
%requires HttpServerAsyncIo
%requires HttpServer
%requires HttpClientIo
%requires WebSocketUtil
%requires WebSocketHandler
%requires WebSocketClient
%requires AsyncApi
%requires json
%requires ../../TestCertificates.qm

%exec-class WebSocketSameProcessEchoTest

class EchoWsConnection inherits WebSocketConnection {
    constructor(WebSocketHandler handler) : WebSocketConnection(handler) {}
    gotMessage(string msg) {
        # Send valid JSON for clients with data="json" serialization
        send(make_json({"echo": msg}));
    }
    gotMessage(binary msg) { gotMessage(msg.toString("UTF-8")); }
}

class EchoWsHandler inherits WebSocketHandler {
    constructor() : WebSocketHandler() {}
    WebSocketConnection getConnectionImpl(hash<auto> cx, hash<auto> hdr, string cid) {
        return new EchoWsConnection(self);
    }
}

class InvalidEchoWsConnection inherits WebSocketConnection {
    constructor(WebSocketHandler handler) : WebSocketConnection(handler) {}
    gotMessage(string msg) {
        send(make_json({"unexpected": msg}));
    }
    gotMessage(binary msg) { gotMessage(msg.toString("UTF-8")); }
}

class InvalidEchoWsHandler inherits WebSocketHandler {
    constructor() : WebSocketHandler() {}
    WebSocketConnection getConnectionImpl(hash<auto> cx, hash<auto> hdr, string cid) {
        return new InvalidEchoWsConnection(self);
    }
}

class WebSocketSameProcessEchoTest inherits Test {
    public {
        const CertPem = TestCertificates::CertPem;

        const KeyPem = TestCertificates::KeyPem;
    }

    constructor() : Test("WebSocketSameProcessEchoTest", "1.0") {
        addTestCase("same-process echo (observer)", \testSameProcessEchoObserver());
        addTestCase("same-process echo (callback)", \testSameProcessEchoCallback());
        addTestCase("same-process HTTP/3 heartbeat", \testSameProcessHttp3Heartbeat());
        addTestCase("AsyncAPI serialized validation", \testAsyncApiSerializedValidation());
        addTestCase("AsyncAPI serialized incoming validation failure",
            \testAsyncApiSerializedIncomingValidationFailure());
        set_return_value(main());
    }

    private static AsyncApi::AsyncApi3Schema createAsyncApiSchema() {
        return AsyncApi::AsyncApi3Loader::fromString(make_json({
            "asyncapi": "3.0.0",
            "info": {
                "title": "WebSocket Echo Test API",
                "version": "1.0.0",
            },
            "channels": {
                "echo": {
                    "address": "/",
                    "messages": {
                        "echoRequest": {
                            "$ref": "#/components/messages/EchoRequest",
                        },
                        "echoResponse": {
                            "$ref": "#/components/messages/EchoResponse",
                        },
                    },
                },
            },
            "operations": {
                "sendEchoRequest": {
                    "action": "send",
                    "channel": {
                        "$ref": "#/channels/echo",
                    },
                    "messages": (
                        {
                            "$ref": "#/channels/echo/messages/echoRequest",
                        },
                    ),
                },
                "receiveEchoResponse": {
                    "action": "receive",
                    "channel": {
                        "$ref": "#/channels/echo",
                    },
                    "messages": (
                        {
                            "$ref": "#/channels/echo/messages/echoResponse",
                        },
                    ),
                },
            },
            "components": {
                "messages": {
                    "EchoRequest": {
                        "payload": {
                            "$ref": "#/components/schemas/EchoRequestPayload",
                        },
                    },
                    "EchoResponse": {
                        "payload": {
                            "$ref": "#/components/schemas/EchoResponsePayload",
                        },
                    },
                },
                "schemas": {
                    "EchoRequestPayload": {
                        "type": "object",
                        "required": ("action", "msg"),
                        "properties": {
                            "action": {
                                "type": "string",
                            },
                            "msg": {
                                "type": "string",
                            },
                        },
                    },
                    "EchoResponsePayload": {
                        "type": "object",
                        "required": ("echo",),
                        "properties": {
                            "echo": {
                                "type": "string",
                            },
                        },
                    },
                },
            },
        }), True);
    }

    private hash<auto> createServer(*WebSocketHandler handler) {
        Logger logger("test", m_options.verbose > 2
            ? LoggerLevel::getLevelDebug()
            : LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }
        HttpServer server(<HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        });
        if (!handler) {
            handler = new EchoWsHandler();
        }
        server.setDefaultHandler("ws", handler);
        hash<auto> linfo = server.addListener(<HttpListenerOptionInfo>{
            "node": "localhost",
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
            "http_version": "auto",
        });
        server.waitForAsyncIo();
        return {
            "server": server,
            "handler": handler,
            "linfo": linfo,
            "logger": logger,
        };
    }

    testSameProcessEchoCallback() {
        hash<auto> ctx = createServer();
        on_exit {
            HttpServer srv = ctx.server;
            srv.stop();
            AsyncSocketIo::AsyncSocketIoController ctrl = AsyncSocketIo::getGlobalAsyncIoController();
            ctrl.stopClear();
        }

        list<auto> l = ();
        Counter c(1);
        code cb = sub (*data msg) {
            if (exists msg) {
                l += msg;
                if (l.size() == 1) {
                    c.dec();
                }
            }
        };
        WebSocketClient wsc(cb, {
            "url": sprintf("wss://localhost:%d", ctx.linfo.port),
            "logger": ctx.logger,
            "http_version": "auto",
            "ssl_verify_cert": False,
        });
        on_exit {
            try { wsc.disconnect(); } catch () {}
            delete wsc;
        }
        wsc.connect();
        assertTrue(wsc.isHttp3(), "auto WebSocket should negotiate HTTP/3");

        wsc.send("ECHO-CB");
        int rc = c.waitForZero(5s);
        assertEq(0, rc, "callback echo must not time out");
        # Server sends JSON: {"echo":"ECHO-CB"}
        assertEq(1, l.size(), "should receive one response");
        assertTrue(l[0].val(), "response should have content");
    }

    # Observer-based delivery — matches the reproducer pattern
    testSameProcessEchoObserver() {
        hash<auto> ctx = createServer();
        on_exit {
            HttpServer srv = ctx.server;
            srv.stop();
            AsyncSocketIo::AsyncSocketIoController ctrl = AsyncSocketIo::getGlobalAsyncIoController();
            ctrl.stopClear();
        }

        Counter c(1);
        *auto response;

        WebSocketClientWithSerialization wsc({
            "url": sprintf("wss://localhost:%d", ctx.linfo.port),
            "logger": ctx.logger,
            "http_version": "auto",
            "ssl_verify_cert": False,
            "data": "json",
        });
        on_exit {
            try { wsc.disconnect(); } catch () {}
            delete wsc;
        }
        TestObserver obs(c, \response);
        wsc.registerObserver(obs);
        wsc.observersReady();
        assertTrue(wsc.isHttp3(), "auto serialized WebSocket should negotiate HTTP/3");

        wsc.sendData({"action": "test", "msg": "hello"});
        int rc = c.waitForZero(5s);
        assertEq(0, rc, "observer echo must not time out");
        assertTrue(response.val(), "observer should receive response");
    }

    testAsyncApiSerializedValidation() {
        hash<auto> ctx = createServer();
        on_exit {
            HttpServer srv = ctx.server;
            srv.stop();
            AsyncSocketIo::AsyncSocketIoController ctrl = AsyncSocketIo::getGlobalAsyncIoController();
            ctrl.stopClear();
        }

        Counter c(1);
        *auto response;

        WebSocketClientWithSerialization wsc({
            "url": sprintf("wss://localhost:%d", ctx.linfo.port),
            "logger": ctx.logger,
            "http_version": "auto",
            "ssl_verify_cert": False,
            "data": "json",
            "validator": createAsyncApiSchema(),
            "asyncapi_channel": "echo",
        });
        on_exit {
            try { wsc.disconnect(); } catch () {}
            delete wsc;
        }
        TestObserver obs(c, \response);
        wsc.registerObserver(obs);
        wsc.observersReady();
        wsc.sendData({"action": "test", "msg": "hello"});
        int rc = c.waitForZero(5s);
        assertEq(0, rc, "AsyncAPI validated observer echo must not time out");
        assertTrue(response.val(), "observer should receive validated response");
        assertTrue(response.echo.val(), "validated response should include echo payload");

        try {
            wsc.sendData({"action": "test"});
            fail("Expected SCHEMA-VALIDATION-ERROR for invalid outgoing payload");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("SCHEMA-VALIDATION-ERROR", ex.err);
        }
    }

    testAsyncApiSerializedIncomingValidationFailure() {
        InvalidEchoWsHandler handler();
        hash<auto> ctx = createServer(handler);
        on_exit {
            HttpServer srv = ctx.server;
            srv.stop();
            AsyncSocketIo::AsyncSocketIoController ctrl = AsyncSocketIo::getGlobalAsyncIoController();
            ctrl.stopClear();
        }

        Counter c(1);
        *auto error;

        WebSocketClientWithSerialization wsc({
            "url": sprintf("wss://localhost:%d", ctx.linfo.port),
            "logger": ctx.logger,
            "http_version": "auto",
            "ssl_verify_cert": False,
            "data": "json",
            "validator": createAsyncApiSchema(),
            "asyncapi_channel": "echo",
        });
        on_exit {
            try { wsc.disconnect(); } catch () {}
            delete wsc;
        }
        TestObserver obs(c, \error, EVENT_WS_ERROR);
        wsc.registerObserver(obs);
        wsc.observersReady();
        wsc.sendData({"action": "test", "msg": "hello"});
        int rc = c.waitForZero(5s);
        assertEq(0, rc, "invalid AsyncAPI response should raise an error event");
        assertTrue(error.val(), "observer should receive validation error details");
        assertEq("SCHEMA-VALIDATION-ERROR", error.err);
    }

    testSameProcessHttp3Heartbeat() {
        hash<auto> ctx = createServer();
        on_exit {
            HttpServer srv = ctx.server;
            srv.stop();
            AsyncSocketIo::AsyncSocketIoController ctrl = AsyncSocketIo::getGlobalAsyncIoController();
            ctrl.stopClear();
        }

        Counter got_pong(1);
        Mutex pong_mutex();
        bool seen_pong = False;
        WebSocketClient wsc(sub (*data msg) {}, {
            "url": sprintf("wss://localhost:%d", ctx.linfo.port),
            "logger": ctx.logger,
            "http_version": "auto",
            "ssl_verify_cert": False,
            "heartbeat": 200ms,
            "pong_callback": sub (*data msg) {
                AutoLock al(pong_mutex);
                if (!seen_pong) {
                    seen_pong = True;
                    got_pong.dec();
                }
            },
        });
        on_exit {
            try { wsc.disconnect(); } catch () {}
            delete wsc;
        }
        wsc.connect();
        assertTrue(wsc.isHttp3(), "auto heartbeat WebSocket should negotiate HTTP/3");

        int rc = got_pong.waitForZero(5s);
        assertEq(0, rc, "HTTP/3 automatic heartbeat should receive a PONG");
    }
}

class TestObserver inherits Observer {
    private {
        Counter c;
        reference<auto> response;
        string event_id;
    }

    constructor(Counter c, reference<auto> response, string event_id = EVENT_WS_DATA) {
        self.c = c;
        self.response = \response;
        self.event_id = event_id;
    }

    update(string event_id, hash<auto> data_) {
        if (event_id == self.event_id) {
            response = data_.data;
            c.dec();
        }
    }
}
