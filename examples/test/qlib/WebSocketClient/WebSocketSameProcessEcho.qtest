#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

# Copyright (C) 2026 Qore Technologies, s.r.o.

# Tests same-process WebSocket echo (server gotMessage -> send response)
# for all protocol levels. The H3 test exposes the wakeSocket bug where
# the server's QUIC poll op is never woken to flush response packets.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Mime
%requires Logger
%requires DataProvider
%requires ConnectionProvider
%requires HttpServerUtil
%requires ../../../../qlib/AsyncSocketIo/AsyncSocketIo.qm
%requires HttpServerAsyncIo
%requires HttpServer
%requires HttpClientIo
%requires WebSocketUtil
%requires WebSocketHandler
%requires WebSocketClient
%try-module json
%define NoJson
%endtry

%exec-class WebSocketSameProcessEchoTest

class EchoWsConnection inherits WebSocketConnection {
    constructor(WebSocketHandler handler) : WebSocketConnection(handler) {}
    gotMessage(string msg) {
%ifndef NoJson
        # Send valid JSON for clients with data="json" serialization
        send(make_json({"echo": msg}));
%else
        send("RESPONSE:" + msg);
%endif
    }
    gotMessage(binary msg) { gotMessage(msg.toString("UTF-8")); }
}

class EchoWsHandler inherits WebSocketHandler {
    constructor() : WebSocketHandler() {}
    WebSocketConnection getConnectionImpl(hash<auto> cx, hash<auto> hdr, string cid) {
        return new EchoWsConnection(self);
    }
}

