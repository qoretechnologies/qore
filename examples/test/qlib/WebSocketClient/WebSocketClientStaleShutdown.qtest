#! A client with serialization whose connecting thread waits until the delivery task reported the connection open
class ReplyClient inherits WebSocketClientWithSerialization {
    public {
        bool hold_before_open = False;
        Counter delivery_opened(1);
        Queue opened_tids();
    }

    constructor(hash<auto> opts) : WebSocketClientWithSerialization(opts) {
    }

    private runInitialDrain(WscConnection c) {
        if (hold_before_open) {
            hold_before_open = False;
            # the server's greeting arrives first: the delivery task makes the open report
            delivery_opened.waitForZero(10s);
        }
        WebSocketClientWithSerialization::runInitialDrain(c);
    }

    private connectionOpened(hash<auto> info) {
        opened_tids.push(gettid());
        if (delivery_opened.getCount()) {
            delivery_opened.dec();
        }
        WebSocketClientWithSerialization::connectionOpened(info);
    }
}

#! A Discord client whose heartbeat stoppers can be held; data other than heartbeats is sent
class HbDiscord inherits DiscordWebSocketClient {
    public {
        Queue events();
        #! hold the next heartbeat sent
        bool block_hb = False;
        Counter release_hb(1);
        #! hold the thread reporting a close after it waited for the heartbeat to end
        bool hold_closing_after_wait = False;
        Counter release_closing(1);
        #! the TID of the thread reporting a close
        int closing_tid = 0;
        #! the next zombie check finds a zombie
        bool force_zombie = False;
        #! forced reconnects are not made
        bool fail_reconnect = False;
        #! gets "destroyed:<tid>" from the destructor and "waiting-threads" from the base destructor
        Queue lifecycle();
        #! gets the TID of the heartbeat thread held in sendData()
        Queue hb_tids();
        #! call heartbeatHandoffFailed() for the running heartbeat on the heartbeat thread in its next beat
        bool handoff_in_beat = False;
        #! hold the next zombie check, which then finds a zombie
        bool hold_zombie = False;
        Counter release_zombie(1);
        #! fail cancelHelloWatchdog() once when given a connection ID (i.e. in the closing callback)
        bool fail_cancel_hello = False;
        #! report the end of each closing callback
        bool report_closing_done = False;
    }

    destructor() {
        lifecycle.push("destroyed:" + gettid());
    }

    private waitLibraryThreads() {
        # a local reference: the queue is read after the object is gone
        Queue q = lifecycle;
        q.push("waiting-threads");
        DiscordWebSocketClient::waitLibraryThreads();
        q.push("threads-done");
    }

    #! returns the current heartbeat record
    DiscordHeartbeat hbRecordForTest() {
        AutoLock al(heartbeat_lock);
        return hb;
    }

    #! starts a heartbeat for the current connection without a HELLO (so no delivery task is involved)
    startHeartbeatForTest(int interval) {
        AutoLock al(heartbeat_lock);
        hb = new DiscordHeartbeat(++hb_seq, getCurrentConnectionId(), interval);
        startHeartbeatThreadIntern();
    }

    private cancelHelloWatchdog(*int cid) {
        if (fail_cancel_hello && exists cid) {
            fail_cancel_hello = False;
            events.push("cancel-hello-failed");
            throw "TEST-ERROR", "a closing step fails";
        }
        DiscordWebSocketClient::cancelHelloWatchdog(cid);
    }

    constructor(hash<auto> opts) : DiscordWebSocketClient(opts) {
    }

    releaseAll() {
        map $1.getCount() ? $1.dec() : NOTHING, (release_hb, release_closing, release_zombie);
    }

    sendData(auto v) {
        if (handoff_in_beat && v.typeCode() == NT_HASH && v.op == 1) {
            handoff_in_beat = False;
            *DiscordHeartbeat h;
            {
                AutoLock al(heartbeat_lock);
                h = hb;
            }
            heartbeatHandoffFailed(h);
            events.push("handoff-returned");
        }
        if (block_hb && v.typeCode() == NT_HASH && v.op == 1) {
            block_hb = False;
            hb_tids.push(gettid());
            events.push("hb-blocked");
            release_hb.waitForZero(LifecycleWsClient::HandoffTimeout);
        }
        DiscordWebSocketClient::sendData(v);
    }

    private closingConnection() {
        closing_tid = gettid();
        on_exit closing_tid = 0;
        DiscordWebSocketClient::closingConnection();
        if (report_closing_done) {
            events.push("closing-done");
        }
    }

    private waitHeartbeatEnded(DiscordHeartbeat h) {
        bool closing = gettid() == closing_tid;
        events.push("waiting:" + (closing ? "closing" : "hello"));
        DiscordWebSocketClient::waitHeartbeatEnded(h);
        if (closing && hold_closing_after_wait) {
            hold_closing_after_wait = False;
            events.push("closing-woke");
            release_closing.waitForZero(LifecycleWsClient::HandoffTimeout);
        }
    }

    private startHeartbeatThreadIntern() {
        DiscordWebSocketClient::startHeartbeatThreadIntern();
        events.push("hb-started:" + hb.cid);
    }

    private bool heartbeatZombieCheck() {
        if (hold_zombie) {
            hold_zombie = False;
            # local references: the client may be released by the test meanwhile
            Queue q = events;
            Counter c = release_zombie;
            q.push("zombie-held");
            c.waitForZero(LifecycleWsClient::HandoffTimeout);
            return True;
        }
        if (force_zombie) {
            force_zombie = False;
            return True;
        }
        return DiscordWebSocketClient::heartbeatZombieCheck();
    }

    private bool reconnectIntern(*int cid) {
        if (fail_reconnect) {
            fail_reconnect = False;
            return False;
        }
        return DiscordWebSocketClient::reconnectIntern(cid);
    }

    private heartbeatHandoffFailed(DiscordHeartbeat h) {
        DiscordWebSocketClient::heartbeatHandoffFailed(h);
        events.push("handoff-failed");
    }

    hash<auto> hbState() {
        AutoLock al(heartbeat_lock);
        return {"cid": hb ? hb.cid : -1, "running": hb ? hb.running.getCount() : 0, "interval": hb ? hb.interval : 0};
    }
}

#! A Discord client whose connects, reconnects and closes can be held; it sends nothing
class WdDiscord inherits DiscordWebSocketClient {
    public {
        Queue events();
        bool hold_handshake = False;
        Counter release_handshake(1);
        bool hold_reest = False;
        Counter release_reest(1);
        bool hold_closing = False;
        Counter release_closing(1);
        bool hold_explicit = False;
        Counter release_explicit(1);
        #! fail the next HELLO watchdog arm
        bool fail_arm = False;
        #! fail the next start of a connection's async I/O
        bool fail_start = False;
        #! report a thread that waits for the action
        bool report_action_wait = False;
        #! released to end holdActionInBackground()
        Counter release_action(1);
        #! gets the connection ID of each forced reconnect
        Queue zombies();
        #! forced reconnects are only recorded, not made
        bool record_zombies_only = False;
        #! fail the next cancelResumeWatchdog() call
        bool fail_cancel_resume = False;
    }

    constructor(hash<auto> opts) : DiscordWebSocketClient(opts) {
    }

    releaseAll() {
        map $1.getCount() ? $1.dec() : NOTHING, (release_handshake, release_reest, release_closing, release_explicit,
            release_action);
    }

    private explicitDisconnect() {
        if (hold_explicit) {
            hold_explicit = False;
            events.push("explicit-held");
            release_explicit.waitForZero(LifecycleWsClient::HandoffTimeout);
        }
        DiscordWebSocketClient::explicitDisconnect();
    }

    sendData(auto v) {
    }

    private hash<auto> connectUnlocked(*hash<auto> hdr0, *reference<hash<auto>> info, *bool reconnect) {
        if (!reconnect && hold_handshake) {
            hold_handshake = False;
            events.push("handshake-held");
            release_handshake.waitForZero(LifecycleWsClient::HandoffTimeout);
        }
        return DiscordWebSocketClient::connectUnlocked(hdr0, \info, reconnect);
    }

    private reestablishConnection(reference<hash<auto>> info) {
        if (hold_reest) {
            hold_reest = False;
            events.push("reest-held");
            release_reest.waitForZero(LifecycleWsClient::HandoffTimeout);
            events.push("reest-released");
        }
        DiscordWebSocketClient::reestablishConnection(\info);
    }

    private doReconnect(int token) {
        Queue q = events;
        on_exit q.push("reconnect-done");
        DiscordWebSocketClient::doReconnect(token);
    }

    private closingConnection() {
        if (hold_closing) {
            hold_closing = False;
            events.push("closing-held");
            release_closing.waitForZero(LifecycleWsClient::HandoffTimeout);
            DiscordWebSocketClient::closingConnection();
            events.push("closing-done:" + getClosingConnectionId());
            return;
        }
        DiscordWebSocketClient::closingConnection();
    }

    hash<auto> wdState() {
        AutoLock al(hello_watchdog_lock);
        return {"hello_received": hello_received, "timer": hello_watchdog_timer, "cid": hello_watchdog_cid,
            "gen": hello_watchdog_gen};
    }

    hash<auto> resumeState() {
        AutoLock al(resume_watchdog_lock);
        return {"completed": resume_completed, "timer": resume_watchdog_timer, "cid": resume_watchdog_cid,
            "gen": resume_watchdog_gen};
    }

    private armHelloWatchdog(int cid = -1) {
        if (fail_arm) {
            fail_arm = False;
            throw "ASYNC-IO-ERROR", "the controller is shutting down";
        }
        DiscordWebSocketClient::armHelloWatchdog(cid);
    }

    private startAsyncIo() {
        if (fail_start) {
            fail_start = False;
            throw "TEST-CONNECT-ERROR", "the connect fails when the async I/O is started";
        }
        DiscordWebSocketClient::startAsyncIo();
    }

    private acquireActionUnlocked(timeout to) {
        if (report_action_wait && action_tid && action_tid != gettid()) {
            events.push("action-wait");
        }
        DiscordWebSocketClient::acquireActionUnlocked(to);
    }

    #! holds the action in another thread, without the client's lock, until release_action is released
    holdActionInBackground() {
        # a method call, not a call reference: a call reference is evaluated in the new thread, out of the object
        background holdActionReported();
    }

    private holdActionReported() {
        try {
            holdAction();
        } catch (hash<ExceptionInfo> ex) {
            TestThreads::report(ex);
        }
    }

    private holdAction() {
        Queue q = events;
        Counter r = release_action;
        {
            AutoLock al(m);
            acquireActionUnlocked(LifecycleWsClient::HandoffTimeout);
        }
        q.push("action-held");
        r.waitForZero(LifecycleWsClient::HandoffTimeout);
        try {
            AutoLock al(m);
            releaseActionUnlocked();
        } catch (hash<ExceptionInfo> ex) {
            # the client was destroyed meanwhile
            if (ex.err != "OBJECT-ALREADY-DELETED") {
                rethrow;
            }
        }
    }

    private bool reconnectIntern(*int cid) {
        Queue q = events;
        bool rv;
        try {
            rv = DiscordWebSocketClient::reconnectIntern(cid);
        } catch (hash<ExceptionInfo> ex) {
            if (exists cid) {
                q.push("reconnect:" + ex.err);
            }
            rethrow;
        }
        # forced reconnects only
        if (exists cid) {
            events.push("reconnect:" + (rv ? "True" : "False"));
        }
        return rv;
    }

    private triggerZombieReconnect(int cid = -1, *DiscordHeartbeat h) {
        zombies.push(cid);
        if (!record_zombies_only) {
            DiscordWebSocketClient::triggerZombieReconnect(cid, h);
        }
    }

    private waitLibraryThreads() {
        Queue q = events;
        q.push("waiting-threads");
        DiscordWebSocketClient::waitLibraryThreads();
        q.push("threads-done");
    }

    private cancelResumeWatchdog(*int cid) {
        # only in the closing callback, which passes the closed connection's ID
        if (fail_cancel_resume && exists cid) {
            fail_cancel_resume = False;
            events.push("cancel-resume-failed");
            throw "TEST-ERROR", "a closing step fails";
        }
        DiscordWebSocketClient::cancelResumeWatchdog(cid);
    }

    int observerCountForTest() {
        return observer_map.size();
    }

    triggerZombieForTest(int cid) {
        DiscordWebSocketClient::triggerZombieReconnect(cid);
    }

    fireHelloForTest(int gen) {
        helloWatchdogFired(gen);
    }

    armResumeForTest(int cid) {
        armResumeWatchdog(cid);
    }

    cancelResumeForTest(int cid) {
        cancelResumeWatchdog(cid);
    }

    fireResumeForTest(int gen) {
        resumeWatchdogFired(gen);
    }
}

