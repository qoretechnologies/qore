#! A start_thread hook that can defer the next thread it starts until the test starts it
/** The deferred code is only stored: a closure value holds no reference to its object, while a function running
    with it as an argument (e.g. a thread waiting to call it) would keep the client alive.
*/
class GatedStarter {
    public {
        bool gate_next = False;
        *code pending;
        Counter started(1);
        Counter gate(1);
    }

    int start(code c) {
        if (gate_next) {
            gate_next = False;
            pending = c;
            started.dec();
            # the thread already runs (a thread cannot be started for a closure of an object being destroyed); it
            # takes the code only once released
            return background runPendingReported();
        }
        return background TestThreads::run(c);
    }

    #! runs the deferred code once released
    private runPending() {
        # the code is released also when the wait is cancelled
        on_exit remove pending;
        gate.waitForZero(LifecycleWsClient::HandoffTimeout);
        *code c = remove pending;
        if (c) {
            c();
        }
    }

    private runPendingReported() {
        try {
            runPending();
        } catch (hash<ExceptionInfo> ex) {
            TestThreads::report(ex);
        }
    }

    #! releases the deferred code without running it, and ends the thread that waits for it
    dropPending() {
        remove pending;
        startPending();
    }

    #! releases the deferred code
    startPending() {
        if (gate.getCount()) {
            gate.dec();
        }
    }
}

#! Runs the threads of the tests and of the clients' start_thread hooks, recording an exception that ends one
class TestThreads {
    public {
        #! the exceptions that ended a thread
        static Queue errors();
        #! set by the tests that cancel threads: THREAD-CANCELLED is not recorded meanwhile
        static bool cancel_expected = False;
    }

    #! runs the given code; an exception that ends it is recorded
    /** a call reference must be evaluated before \c background: \c background evaluates its arguments in the new
        thread, where no object context is available
    */
    static run(code c) {
        try {
            c();
        } catch (hash<ExceptionInfo> ex) {
            TestThreads::report(ex);
        }
    }

    #! records an exception that ended a thread
    static report(hash<ExceptionInfo> ex) {
        # only while a test cancels threads on purpose
        if (ex.err == "THREAD-CANCELLED" && TestThreads::cancel_expected) {
            return;
        }
        TestThreads::errors.push(get_exception_string(ex));
    }
}

#! Holds the heartbeat thread in its own reconnect, and after it stopped its own record
class InlineHoldDiscord inherits HbDiscord {
    public {
        bool hold_inline = False;
        Counter release_inline(1);
        int inline_tid = 0;
        Counter release_after_stop(1);
    }

    constructor(hash<auto> opts) : HbDiscord(opts) {
    }

    private bool reconnectIntern(*int cid) {
        if (hold_inline) {
            hold_inline = False;
            inline_tid = gettid();
            Queue q = events;
            Counter c = release_inline;
            q.push("inline-held");
            c.waitForZero(LifecycleWsClient::HandoffTimeout);
        }
        return HbDiscord::reconnectIntern(cid);
    }

    private bool stopHeartbeatThread(*int cid) {
        Queue q = events;
        Counter c = release_after_stop;
        bool held = inline_tid && gettid() == inline_tid;
        bool rv = HbDiscord::stopHeartbeatThread(cid);
        if (held) {
            inline_tid = 0;
            q.push("after-stop-held");
            c.waitForZero(LifecycleWsClient::HandoffTimeout);
        }
        return rv;
    }
}

#! A start_thread hook whose starts fail once it is told to fail
class FailingStarter {
    public {
        #! the number of starts that succeed before the starts fail; -1: none fails
        int ok_starts = -1;
    }

    int start(code c) {
        if (!ok_starts) {
            throw "TEST-START-ERROR", "the thread cannot be started";
        }
        if (ok_starts > 0) {
            --ok_starts;
        }
        return background TestThreads::run(c);
    }
}
