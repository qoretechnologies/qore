#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

# Copyright (C) 2026 Qore Technologies, s.r.o.

# Regression tests: the teardown of a WebSocketClient connection that a delivery task runs after the connection was
# already closed with disconnect() must leave the client's next connection alone.
#
# A delivery task that holds the "closed" message of a connection runs handleAsyncShutdown() after disconnect() has
# torn that connection down; when the client has connected again meanwhile, the stale teardown used to tear down the
# new connection (mode "after connect"), or to clear the new connection's state without closing it (mode "across
# connect"), so that the next disconnect() did nothing and the next connect() failed with HTTPCLIENT-CAPACITY-ERROR
# (all 1 connections to the server have reached the concurrent stream limit), as the open stream of the leaked
# connection still held the only connection of the client's connection manager.
#
# Further cases cover a connect() made while such a teardown is in progress, from another thread or from the closing
# callback, a connect() that fails after the handshake, and an HTTP/1.1 WebSocket whose HttpClientIo connection was
# marked closed, which isOpen() reported closed so that disconnect() did nothing.
#
# The delivery task is held with lock handoffs in a subclass, so the interleavings are reproduced without timing.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Logger
%requires DataProvider
%requires ConnectionProvider
%requires HttpServerUtil
%requires AsyncSocketIo
%requires HttpServerAsyncIo
%requires HttpServer
%requires HttpClientIo
%requires WebSocketUtil
%requires WebSocketHandler
%requires WebSocketClient

%exec-class WebSocketClientStaleShutdownTest

class StaleEchoWsConnection inherits WebSocketConnection {
    private {
        bool greet;
    }

    constructor(WebSocketHandler handler, bool greet = False) : WebSocketConnection(handler) {
        self.greet = greet;
    }

    registered() {
        if (greet) {
            send("HELLO");
        }
    }

    gotMessage(string msg) {
        if (msg == "bye") {
            # the server closes the connection
            stop();
            return;
        }
        send("ECHO:" + msg);
    }
}

class StaleEchoWsHandler inherits WebSocketHandler {
    WebSocketConnection getConnectionImpl(hash<auto> cx, hash<auto> hdr, string cid) {
        return new StaleEchoWsConnection(self, exists hdr."x-greet");
    }
}

#! A client whose delivery task can be held while it delivers the "closed" message of a connection
class StaleShutdownWsClient inherits WebSocketClient {
    public {
        #! bound of every handoff wait; only reached if the client does not run the expected step
        const HandoffTimeout = 30s;

        #! the TID of the held delivery task
        int hold_tid = 0;

        #! released when the delivery task holds the "closed" message
        Counter held(1);
        #! released by the test to let the delivery task go on
        Counter release(1);
        #! events of the held delivery task after its release: "closed-socket" and "done"
        Queue events();
        #! released by the test to let the delivery task go on after "closed-socket"
        Counter release_close(1);
        #! hold the delivery task after it has closed the connection's socket in the teardown
        bool hold_close = False;
        #! hold the delivery task after it has taken the connection's resources in the teardown
        bool hold_release = False;
        #! hold the teardown after it has handed delivery over, until release_handover is released
        bool hold_handover = False;
        #! report the end of the delivery task that ran the teardown
        bool report_teardown_task_end = False;
        #! released by the test to let a teardown held after handing delivery over end
        Counter release_handover(1);
        #! the step of the next automatic reconnect to hold: "preamble" or "reestablish"
        *string hold_reconnect_step;
        #! released by the test to let a reconnect held at hold_reconnect_step go on
        Counter release_reconnect_step(1);
        #! after the next close handshake started by the client, wait until close_handshake_gate is released
        bool gate_close_handshake = False;
        #! released by the test to let the client go on after its close handshake
        Counter close_handshake_gate(1);
        #! the number of delivery tasks still to hold when they start
        int hold_tasks = 0;
        #! released by the test to let the held delivery tasks go on, in the order they started
        list<Counter> release_task = ();
        #! hold the next automatic reconnect until release_reconnect is released
        bool hold_reconnect = False;
        #! released by the test to let a held automatic reconnect go on
        Counter release_reconnect(1);
        #! the step at which the next connect fails: "handshake" (after the handshake) or "start" (when the async
        #! I/O is started)
        *string fail_connect_at;
    }

    private {
        #! hold the next "closed" message
        bool armed = False;
        #! let the next teardown made by another thread wait until the delivery task holds the "closed" message
        bool gate_stop = False;
    }

    constructor(code cb, hash<auto> opts) : WebSocketClient(cb, opts) {
    }

    #! holds the "closed" message of the current connection when disconnect() is called next
    arm(bool hold_close) {
        self.hold_close = hold_close;
        armed = True;
        gate_stop = True;
    }

    #! holds the teardown of the current connection after it has taken the connection's resources
    /** the delivery task that delivers the "closed" message is not held there
    */
    armTeardown() {
        hold_release = True;
        release.dec();
        armed = True;
    }

    #! records the delivery task that delivers the next "closed" message, without holding it
    armTeardownNoHold() {
        armed = True;
    }

    #! connects in a new thread, which reports "connected" or the connect error
    connectInBackground() {
        background connectAndReport();
    }

    private connectAndReport() {
        try {
            connect();
            events.push("connected");
        } catch (hash<ExceptionInfo> ex) {
            events.push(sprintf("connect error: %s: %s", ex.err, ex.desc));
        }
    }

    #! starts a thread that reports "done" when the held delivery task has ended
    watchDone() {
        Queue q = events;
        Counter c = delivery_thread_counter;
        background sub () {
            if (c.waitForZero(HandoffTimeout)) {
                q.push("timeout");
            } else {
                q.push("done");
            }
        }();
    }

    private int processAsyncMessage(hash<auto> msg) {
        if (msg.type == "closed" && armed) {
            armed = False;
            hold_tid = gettid();
            held.dec();
            release.waitForZero(HandoffTimeout);
        }
        return WebSocketClient::processAsyncMessage(msg);
    }

    private stopAsyncIo() {
        # the teardown made by disconnect() waits until the delivery task holds the "closed" message, which it can
        # read only while the connection's poll operation is set
        if (gate_stop && gettid() != hold_tid) {
            gate_stop = False;
            held.waitForZero(HandoffTimeout);
        }
        WebSocketClient::stopAsyncIo();
    }

    #! aborts the poll operation of the HttpClientIo connection that the HTTP/1.1 WebSocket was upgraded on
    /** The same happens when the client cancels the operation after the upgrade while the I/O thread still runs
        it: the HttpClientIo connection is marked closed, while the WebSocket stays open on its socket.
    */
    abortHttpClientIoOperation() {
        AutoLock al(m);
        hcio_stream.getConnection().getPollOperation().abort();
    }

    #! returns the TID of the thread running the client's delivery task, or 0
    int deliveryThreadId() {
        AutoLock al(delivery_mutex);
        return delivery_thread_id;
    }

    private handleAsyncShutdown(object op, int id) {
        WebSocketClient::handleAsyncShutdown(op, id);
        if (hold_handover && hold_tid && gettid() == hold_tid) {
            hold_handover = False;
            events.push("handed-over");
            release_handover.waitForZero(HandoffTimeout);
        }
    }

    #! holds the next \a n delivery tasks when they start; each is released with release_task
    holdDeliveryTasks(int n) {
        release_task = map new Counter(1), xrange(n);
        hold_tasks = n;
    }

    private deliverPendingMessages(int id) {
        int n = -1;
        if (hold_tasks > 0) {
            n = release_task.size() - hold_tasks--;
            events.push("task-held-" + n);
            release_task[n].waitForZero(HandoffTimeout);
        }
        WebSocketClient::deliverPendingMessages(id);
        if (n >= 0) {
            events.push("task-ended-" + n);
        }
        if (report_teardown_task_end && hold_tid && gettid() == hold_tid) {
            report_teardown_task_end = False;
            events.push("teardown-task-ended");
        }
    }

    private bool sendCloseAndWaitUnlocked(int cmd) {
        bool rv = WebSocketClient::sendCloseAndWaitUnlocked(cmd);
        if (gate_close_handshake) {
            gate_close_handshake = False;
            # let the delivery task take the connection for its own teardown before going on
            m.unlock();
            on_exit m.lock();
            close_handshake_gate.waitForZero(HandoffTimeout);
        }
        return rv;
    }

    #! disconnects in a new thread, which reports "disconnected"
    disconnectInBackground() {
        background disconnectAndReport();
    }

    private disconnectAndReport() {
        try {
            disconnect();
            events.push("disconnected");
        } catch (hash<ExceptionInfo> ex) {
            events.push(sprintf("disconnect error: %s: %s", ex.err, ex.desc));
        }
    }

    #! calls reconnect() in a new thread, which reports "reconnect-called"
    reconnectInBackground() {
        background reconnectAndReport();
    }

    private reconnectAndReport() {
        try {
            WebSocketClient::reconnect();
            events.push("reconnect-called");
        } catch (hash<ExceptionInfo> ex) {
            events.push(sprintf("reconnect error: %s: %s", ex.err, ex.desc));
        }
    }

    private reconnectPreamble() {
        if (hold_reconnect_step == "preamble") {
            remove hold_reconnect_step;
            events.push("reconnect-step");
            release_reconnect_step.waitForZero(HandoffTimeout);
        }
        WebSocketClient::reconnectPreamble();
    }

    private reestablishConnection(reference<hash<auto>> info) {
        if (hold_reconnect_step == "reestablish") {
            remove hold_reconnect_step;
            events.push("reconnect-step");
            release_reconnect_step.waitForZero(HandoffTimeout);
        }
        WebSocketClient::reestablishConnection(\info);
    }

    private doReconnect() {
        if (hold_reconnect) {
            hold_reconnect = False;
            events.push("reconnect-started");
            release_reconnect.waitForZero(HandoffTimeout);
        }
        WebSocketClient::doReconnect();
        events.push("reconnect-done");
    }

    #! returns True if a delivery task is active or scheduled
    bool deliveryActive() {
        AutoLock al(delivery_mutex);
        return delivery_active;
    }

    private hash<auto> connectUnlocked(*hash<auto> hdr0, *reference<hash<auto>> info, *bool reconnect) {
        hash<auto> rv = WebSocketClient::connectUnlocked(hdr0, \info, reconnect);
        if (fail_connect_at == "handshake") {
            remove fail_connect_at;
            throw "TEST-CONNECT-ERROR", "the connect fails after the handshake";
        }
        return rv;
    }

    private startAsyncIo() {
        if (fail_connect_at == "start") {
            remove fail_connect_at;
            throw "TEST-CONNECT-ERROR", "the connect fails when the async I/O is started";
        }
        WebSocketClient::startAsyncIo();
    }

    private releaseAsyncIo(hash<WscAsyncIoResources> res) {
        if (hold_release && hold_tid && gettid() == hold_tid) {
            hold_release = False;
            events.push("detached");
            release_close.waitForZero(HandoffTimeout);
        }
        WebSocketClient::releaseAsyncIo(res);
    }

    private waitAsyncTeardownUnlocked() {
        if (async_teardown_tid && async_teardown_tid != gettid()) {
            events.push("teardown-wait");
        }
        WebSocketClient::waitAsyncTeardownUnlocked();
    }

    private shutdownAndCloseUnlocked() {
        WebSocketClient::shutdownAndCloseUnlocked();
        # the teardown has released the connection's resources and checks next, with the client's lock held, if
        # the connection it tears down is still the client's connection
        if (hold_close && hold_tid && gettid() == hold_tid) {
            hold_close = False;
            events.push("closed-socket");
            release_close.waitForZero(HandoffTimeout);
        }
    }
}

class WebSocketClientStaleShutdownTest inherits QUnit::Test {
    public {
        HttpServer server;
        hash<auto> linfo;
        Logger logger;
    }

    constructor() : Test("WebSocketClientStaleShutdownTest", "1.0") {
        addTestCase("stale teardown after the next connect", \staleTeardownAfterConnectTest());
        addTestCase("stale teardown across the next connect", \staleTeardownAcrossConnectTest());
        addTestCase("connect during the teardown of a connection closed by the server",
            \connectDuringTeardownTest());
        addTestCase("connect in the closing callback", \connectInClosingCallbackTest());
        addTestCase("connect and disconnect in the closing callback", \connectDisconnectInClosingCallbackTest());
        addTestCase("connect during a teardown that starts a reconnect", \connectDuringReconnectTeardownTest());
        addTestCase("connect while a reconnect is about to disconnect", \connectDuringReconnectStepTest(),
            "preamble");
        addTestCase("connect while a reconnect is about to connect", \connectDuringReconnectStepTest(),
            "reestablish");
        addTestCase("disconnect during the teardown run by the delivery task", \closeDuringTeardownTest(),
            "disconnect");
        addTestCase("reconnect during the teardown run by the delivery task", \closeDuringTeardownTest(),
            "reconnect");
        addTestCase("delivery task of a closed connection starting late", \lateDeliveryTaskTest());
        addTestCase("delivery task of a closed connection ending during a callback", \lateDeliveryTaskThreadTest());
        addTestCase("teardown ending after handing delivery over", \handOverDeliveryThreadTest());
        addTestCase("failed connect in the closing callback", \failedConnectInClosingCallbackTest());
        addTestCase("HTTP/1.1 connection whose HttpClientIo operation ended", \endedHttpClientIoOperationTest());
        addTestCase("failed connect after the handshake", \failedConnectTest(), "handshake");
        addTestCase("failed connect when the async I/O starts", \failedConnectTest(), "start");

        logger = new Logger("test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }
        server = new HttpServer(<HttpServerOptionInfo>{"logger": logger});
        server.setDefaultHandler("ws-handler", new StaleEchoWsHandler());
        linfo = server.addListener(<HttpListenerOptionInfo>{"node": "localhost", "service": 0});

        set_return_value(main());

        server.stop();
        AsyncSocketIo::AsyncSocketIoController ctrl = AsyncSocketIo::getGlobalAsyncIoController();
        ctrl.stopClear();
    }

    #! The held delivery task runs the whole teardown of the first connection after the second connect
    staleTeardownAfterConnectTest() {
        runTest(False);
    }

    #! The held delivery task starts the teardown of the first connection before the second connect and ends it
    #! after the second connect
    staleTeardownAcrossConnectTest() {
        runTest(True);
    }

    #! A connect() made while the teardown of a connection closed by the server is in progress
    /** The connect waits until the teardown has ended, so the closed connection is reported closed once, and the
        teardown leaves the new connection alone.
    */
    connectDuringTeardownTest() {
        Queue msgs();
        Counter closed_count();
        code cb = sub (*data msg) {
            if (exists msg) {
                msgs.push(msg);
            } else {
                closed_count.inc();
            }
        };
        StaleShutdownWsClient wsc(cb, {"url": "ws://localhost:" + linfo.port, "logger": logger});
        on_exit {
            # never leave the delivery task held; only this thread releases it
            if (wsc.release_close.getCount()) {
                wsc.release_close.dec();
            }
            try {
                wsc.disconnect();
            } catch () {
            }
            delete wsc;
        }

        wsc.connect();
        assertTrue(wsc.isOpen(), "the first connection is open");
        wsc.armTeardown();
        # the server closes the connection; its teardown is held after taking the connection's resources
        wsc.send("bye");
        assertEq("detached", wsc.events.get(StaleShutdownWsClient::HandoffTimeout));

        wsc.connectInBackground();
        # the connect waits for the end of the teardown
        assertEq("teardown-wait", wsc.events.get(StaleShutdownWsClient::HandoffTimeout));
        wsc.release_close.dec();
        wsc.watchDone();
        hash<string, bool> seen = {};
        string ev;
        while (!seen.connected || !seen.done) {
            ev = wsc.events.get(StaleShutdownWsClient::HandoffTimeout);
            assertTrue(ev == "connected" || ev == "done", sprintf("unexpected event %y", ev));
            seen{ev} = True;
        }

        checkSecondConnection(wsc, msgs, closed_count);
    }

    #! A connect() made in the closing callback of a connection closed by the server
    /** The teardown that called the callback leaves the new connection alone.
    */
    connectInClosingCallbackTest() {
        Queue msgs();
        Counter closed_count();
        Queue errors();
        *StaleShutdownWsClient client;
        bool reconnected;
        code cb = sub (*data msg) {
            if (exists msg) {
                msgs.push(msg);
                return;
            }
            closed_count.inc();
            if (!reconnected) {
                reconnected = True;
                try {
                    client.connect();
                } catch (hash<ExceptionInfo> ex) {
                    errors.push(sprintf("%s: %s", ex.err, ex.desc));
                }
            }
        };
        StaleShutdownWsClient wsc(cb, {"url": "ws://localhost:" + linfo.port, "logger": logger});
        client = wsc;
        on_exit {
            remove client;
            try {
                wsc.disconnect();
            } catch () {
            }
            delete wsc;
        }

        wsc.connect();
        assertTrue(wsc.isOpen(), "the first connection is open");
        # the teardown of the next "closed" message is watched, but not held
        wsc.armTeardown();
        wsc.release_close.dec();
        # the server closes the connection; the closing callback connects again
        wsc.send("bye");
        assertEq("detached", wsc.events.get(StaleShutdownWsClient::HandoffTimeout));
        wsc.watchDone();
        assertEq("done", wsc.events.get(StaleShutdownWsClient::HandoffTimeout));
        assertEq(0, errors.size(), "the connect in the closing callback succeeds");

        checkSecondConnection(wsc, msgs, closed_count);
    }

    #! A connect() followed by a disconnect() in the closing callback
    /** The disconnect closes the new connection completely, and reports it closed.
    */
    connectDisconnectInClosingCallbackTest() {
        Queue msgs();
        Counter closed_count();
        Queue errors();
        *StaleShutdownWsClient client;
        bool reconnected;
        code cb = sub (*data msg) {
            if (exists msg) {
                msgs.push(msg);
                return;
            }
            closed_count.inc();
            if (!reconnected) {
                reconnected = True;
                try {
                    client.connect();
                    client.disconnect();
                } catch (hash<ExceptionInfo> ex) {
                    errors.push(sprintf("%s: %s", ex.err, ex.desc));
                }
            }
        };
        StaleShutdownWsClient wsc(cb, {"url": "ws://localhost:" + linfo.port, "logger": logger});
        client = wsc;
        on_exit {
            remove client;
            try {
                wsc.disconnect();
            } catch () {
            }
            delete wsc;
        }

        wsc.connect();
        wsc.armTeardown();
        wsc.release_close.dec();
        wsc.send("bye");
        assertEq("detached", wsc.events.get(StaleShutdownWsClient::HandoffTimeout));
        wsc.watchDone();
        assertEq("done", wsc.events.get(StaleShutdownWsClient::HandoffTimeout));
        assertEq(0, errors.size(), "the connect and disconnect in the closing callback succeed");
        assertEq(2, closed_count.getCount(), "both connections are reported closed");
        assertFalse(wsc.isOpen(), "the client is not connected");

        checkNextConnection(wsc, msgs, closed_count, 2);
    }

    #! A connect() made while the teardown of a connection closed by the server starts an automatic reconnect
    /** The reconnect does nothing, as a connection was started after the teardown; it used to close that connection.
    */
    connectDuringReconnectTeardownTest() {
        Queue msgs();
        Counter closed_count();
        code cb = sub (*data msg) {
            if (exists msg) {
                msgs.push(msg);
            } else {
                closed_count.inc();
            }
        };
        StaleShutdownWsClient wsc(cb, {"url": "ws://localhost:" + linfo.port, "logger": logger, "reconnect": True});
        on_exit {
            if (wsc.release_close.getCount()) {
                wsc.release_close.dec();
            }
            if (wsc.release_reconnect.getCount()) {
                wsc.release_reconnect.dec();
            }
            try {
                wsc.disconnect();
            } catch () {
            }
            delete wsc;
        }

        wsc.connect();
        wsc.armTeardown();
        wsc.hold_reconnect = True;
        wsc.send("bye");
        assertEq("detached", wsc.events.get(StaleShutdownWsClient::HandoffTimeout));
        wsc.connectInBackground();
        assertEq("teardown-wait", wsc.events.get(StaleShutdownWsClient::HandoffTimeout));
        wsc.release_close.dec();
        wsc.watchDone();
        hash<string, bool> seen = {};
        while (!seen.connected || !seen.done || !seen."reconnect-started") {
            string ev = wsc.events.get(StaleShutdownWsClient::HandoffTimeout);
            assertTrue(ev == "connected" || ev == "done" || ev == "reconnect-started",
                sprintf("unexpected event %y", ev));
            seen{ev} = True;
        }
        # the connect has completed: let the reconnect run
        wsc.release_reconnect.dec();
        assertEq("reconnect-done", wsc.events.get(StaleShutdownWsClient::HandoffTimeout));

        checkSecondConnection(wsc, msgs, closed_count);
    }

    #! A connect() made while an automatic reconnect is about to disconnect or to connect
    /** The reconnect leaves the new connection alone: it checks with the client's lock held, in the disconnect and
        connect it makes, that no connection was started after the teardown it was started for.
    */
    connectDuringReconnectStepTest(string step) {
        Queue msgs();
        Counter closed_count();
        code cb = sub (*data msg) {
            if (exists msg) {
                msgs.push(msg);
            } else {
                closed_count.inc();
            }
        };
        StaleShutdownWsClient wsc(cb, {"url": "ws://localhost:" + linfo.port, "logger": logger, "reconnect": True});
        on_exit {
            if (wsc.release_reconnect_step.getCount()) {
                wsc.release_reconnect_step.dec();
            }
            try {
                wsc.disconnect();
            } catch () {
            }
            delete wsc;
        }

        wsc.connect();
        wsc.hold_reconnect_step = step;
        # the server closes the connection; the teardown starts a reconnect, which is held at the given step after
        # its check that no connection was started meanwhile
        wsc.send("bye");
        assertEq("reconnect-step", wsc.events.get(StaleShutdownWsClient::HandoffTimeout));
        assertEq(1, closed_count.getCount(), "the first connection is reported closed");
        wsc.connect();
        assertTrue(wsc.isOpen(), "the second connection is open");
        wsc.release_reconnect_step.dec();
        assertEq("reconnect-done", wsc.events.get(StaleShutdownWsClient::HandoffTimeout));

        checkSecondConnection(wsc, msgs, closed_count);
    }

    #! A disconnect() or reconnect() whose close handshake ends while the delivery task tears the connection down
    /** It waits for the end of that teardown, which reports the connection closed, instead of tearing the connection
        down and reporting it closed a second time.
    */
    closeDuringTeardownTest(string call) {
        Queue msgs();
        Counter closed_count();
        Counter in_callback(1);
        Counter release_callback(1);
        *StaleShutdownWsClient client;
        code cb = sub (*data msg) {
            if (exists msg) {
                msgs.push(msg);
                return;
            }
            closed_count.inc();
            # the teardown run by the delivery task is held in its closing callback
            if (client.hold_tid && gettid() == client.hold_tid && in_callback.getCount()) {
                in_callback.dec();
                release_callback.waitForZero(StaleShutdownWsClient::HandoffTimeout);
            }
        };
        StaleShutdownWsClient wsc(cb, {"url": "ws://localhost:" + linfo.port, "logger": logger});
        client = wsc;
        on_exit {
            remove client;
            if (wsc.close_handshake_gate.getCount()) {
                wsc.close_handshake_gate.dec();
            }
            if (release_callback.getCount()) {
                release_callback.dec();
            }
            try {
                wsc.disconnect();
            } catch () {
            }
            delete wsc;
        }

        wsc.connect();
        # the delivery task that delivers the "closed" message is recorded, but not held there
        wsc.release.dec();
        wsc.armTeardownNoHold();
        wsc.gate_close_handshake = True;
        if (call == "disconnect") {
            wsc.disconnectInBackground();
        } else {
            wsc.reconnectInBackground();
        }
        # the delivery task tears the connection down and is held in the closing callback
        assertEq(0, in_callback.waitForZero(StaleShutdownWsClient::HandoffTimeout), "the teardown reports the close");
        wsc.close_handshake_gate.dec();
        string ended = call == "disconnect" ? "disconnected" : "reconnect-called";
        # the call waits for the end of the teardown
        assertEq("teardown-wait", wsc.events.get(StaleShutdownWsClient::HandoffTimeout));
        release_callback.dec();
        assertEq(ended, wsc.events.get(StaleShutdownWsClient::HandoffTimeout));
        if (call == "reconnect") {
            assertEq("reconnect-done", wsc.events.get(StaleShutdownWsClient::HandoffTimeout));
            assertTrue(wsc.isOpen(), "the client has reconnected");
            wsc.disconnect();
            assertEq(2, closed_count.getCount(), "the closed connection is reported closed once");
        } else {
            assertFalse(wsc.isOpen(), "the client is not connected");
            assertEq(1, closed_count.getCount(), "the connection is reported closed once");
        }
    }

    #! A delivery task scheduled for a connection that starts after the connection was closed and a new one started
    /** It delivers nothing: the new connection's messages are delivered by the new connection's task, in order; it
        used to deliver them concurrently with that task.
    */
    lateDeliveryTaskTest() {
        Queue msgs();
        Counter closed_count();
        code cb = sub (*data msg) {
            if (exists msg) {
                msgs.push(msg);
            } else {
                closed_count.inc();
            }
        };
        StaleShutdownWsClient wsc(cb, {"url": "ws://localhost:" + linfo.port, "logger": logger});
        on_exit {
            map $1.getCount() ? $1.dec() : NOTHING, wsc.release_task;
            try {
                wsc.disconnect();
            } catch () {
            }
            delete wsc;
        }

        wsc.connect();
        wsc.holdDeliveryTasks(2);
        # the echo schedules the first connection's delivery task, which is held when it starts
        wsc.send("one");
        assertEq("task-held-0", wsc.events.get(StaleShutdownWsClient::HandoffTimeout));
        wsc.disconnect();
        assertEq(1, closed_count.getCount(), "the first connection is reported closed");
        wsc.connect();
        # the echo schedules the second connection's delivery task, which is held when it starts
        wsc.send("two");
        assertEq("task-held-1", wsc.events.get(StaleShutdownWsClient::HandoffTimeout));

        # the first connection's task starts now, with the second connection's message received
        wsc.release_task[0].dec();
        assertEq("task-ended-0", wsc.events.get(StaleShutdownWsClient::HandoffTimeout));
        assertEq(0, msgs.size(), "the task of the closed connection delivers nothing");

        wsc.release_task[1].dec();
        assertEq("task-ended-1", wsc.events.get(StaleShutdownWsClient::HandoffTimeout));
        assertEq("ECHO:two", msgs.get(0ms));
        assertEq(0, msgs.size(), "only the second connection's message is delivered");
        wsc.disconnect();
        assertEq(2, closed_count.getCount(), "the second connection is reported closed");
    }

    #! A delivery task of a closed connection that ends while the new connection's task runs a callback
    /** It leaves the TID of the running task, which the destructor uses to detect that it is called from a callback
        on the delivery thread, alone; it used to overwrite it and clear it, so the destructor called from that
        callback waited for its own task to end.
    */
    lateDeliveryTaskThreadTest() {
        Counter in_callback(1);
        Counter release_callback(1);
        int callback_tid;
        code cb = sub (*data msg) {
            if (msg == "ECHO:block") {
                callback_tid = gettid();
                in_callback.dec();
                release_callback.waitForZero(StaleShutdownWsClient::HandoffTimeout);
            }
        };
        StaleShutdownWsClient wsc(cb, {"url": "ws://localhost:" + linfo.port, "logger": logger});
        on_exit {
            map $1.getCount() ? $1.dec() : NOTHING, wsc.release_task;
            if (release_callback.getCount()) {
                release_callback.dec();
            }
            try {
                wsc.disconnect();
            } catch () {
            }
            delete wsc;
        }

        wsc.connect();
        wsc.holdDeliveryTasks(1);
        # the echo schedules the first connection's delivery task, which is held when it starts
        wsc.send("one");
        assertEq("task-held-0", wsc.events.get(StaleShutdownWsClient::HandoffTimeout));
        wsc.disconnect();
        wsc.connect();
        # the second connection's task runs the callback for this message and is held in it
        wsc.send("block");
        assertEq(0, in_callback.waitForZero(StaleShutdownWsClient::HandoffTimeout), "the callback runs");

        # the first connection's task starts and ends now
        wsc.release_task[0].dec();
        assertEq("task-ended-0", wsc.events.get(StaleShutdownWsClient::HandoffTimeout));
        assertEq(callback_tid, wsc.deliveryThreadId(), "the running task's TID is kept");

        release_callback.dec();
        wsc.disconnect();
    }

    #! A teardown that hands delivery over to a new connection's task and ends while that task runs a callback
    /** It leaves the TID of the new task alone; it used to clear it.
    */
    handOverDeliveryThreadTest() {
        Counter in_callback(1);
        Counter release_callback(1);
        int callback_tid;
        Queue errors();
        *StaleShutdownWsClient client;
        bool reconnected;
        code cb = sub (*data msg) {
            if (msg == "HELLO") {
                callback_tid = gettid();
                in_callback.dec();
                release_callback.waitForZero(StaleShutdownWsClient::HandoffTimeout);
                return;
            }
            if (!exists msg && !reconnected) {
                reconnected = True;
                try {
                    # the server greets the new connection: its message is delivered by the task the teardown
                    # hands delivery over to
                    client.connect({"hdr": {"X-Greet": "1"}});
                } catch (hash<ExceptionInfo> ex) {
                    errors.push(sprintf("%s: %s", ex.err, ex.desc));
                }
            }
        };
        StaleShutdownWsClient wsc(cb, {"url": "ws://localhost:" + linfo.port, "logger": logger});
        client = wsc;
        on_exit {
            remove client;
            if (wsc.release_handover.getCount()) {
                wsc.release_handover.dec();
            }
            if (release_callback.getCount()) {
                release_callback.dec();
            }
            try {
                wsc.disconnect();
            } catch () {
            }
            delete wsc;
        }

        wsc.connect();
        wsc.armTeardown();
        wsc.release_close.dec();
        wsc.hold_handover = True;
        wsc.send("bye");
        assertEq("detached", wsc.events.get(StaleShutdownWsClient::HandoffTimeout));
        assertEq("handed-over", wsc.events.get(StaleShutdownWsClient::HandoffTimeout));
        assertEq(0, errors.size(), "the connect in the closing callback succeeds");
        # the new connection's task runs the callback for the greeting
        assertEq(0, in_callback.waitForZero(StaleShutdownWsClient::HandoffTimeout), "the callback runs");
        # the teardown's task ends now
        wsc.report_teardown_task_end = True;
        wsc.release_handover.dec();
        assertEq("teardown-task-ended", wsc.events.get(StaleShutdownWsClient::HandoffTimeout));
        assertEq(callback_tid, wsc.deliveryThreadId(), "the running task's TID is kept");

        release_callback.dec();
        wsc.disconnect();
    }

    #! A connect() in the closing callback that fails when it starts the async I/O
    /** The teardown that called the callback releases the delivery flag, and the client connects again.
    */
    failedConnectInClosingCallbackTest() {
        Queue msgs();
        Counter closed_count();
        Queue errors();
        *StaleShutdownWsClient client;
        bool reconnected;
        code cb = sub (*data msg) {
            if (exists msg) {
                msgs.push(msg);
                return;
            }
            closed_count.inc();
            if (!reconnected) {
                reconnected = True;
                client.fail_connect_at = "start";
                try {
                    client.connect();
                } catch (hash<ExceptionInfo> ex) {
                    errors.push(ex.err);
                }
            }
        };
        StaleShutdownWsClient wsc(cb, {"url": "ws://localhost:" + linfo.port, "logger": logger});
        client = wsc;
        on_exit {
            remove client;
            try {
                wsc.disconnect();
            } catch () {
            }
            delete wsc;
        }

        wsc.connect();
        assertTrue(wsc.isOpen(), "the first connection is open");
        wsc.armTeardown();
        wsc.release_close.dec();
        wsc.send("bye");
        assertEq("detached", wsc.events.get(StaleShutdownWsClient::HandoffTimeout));
        wsc.watchDone();
        assertEq("done", wsc.events.get(StaleShutdownWsClient::HandoffTimeout));
        assertEq("TEST-CONNECT-ERROR", errors.get(0ms), "the connect in the closing callback fails");
        assertEq(1, closed_count.getCount(), "the first connection is reported closed once");
        assertFalse(wsc.deliveryActive(), "no delivery task is left active");
        assertFalse(wsc.isOpen(), "the client is not connected");

        checkNextConnection(wsc, msgs, closed_count, 1);
    }

    #! An HTTP/1.1 WebSocket stays open when the HttpClientIo connection it was upgraded on is marked closed
    /** disconnect() then closes it; before, isOpen() returned False and disconnect() did nothing.
    */
    endedHttpClientIoOperationTest() {
        Queue msgs();
        Counter closed_count();
        code cb = sub (*data msg) {
            if (exists msg) {
                msgs.push(msg);
            } else {
                closed_count.inc();
            }
        };
        StaleShutdownWsClient wsc(cb, {"url": "ws://localhost:" + linfo.port, "logger": logger});
        on_exit {
            try {
                wsc.disconnect();
            } catch () {
            }
            delete wsc;
        }

        wsc.connect();
        wsc.abortHttpClientIoOperation();
        assertTrue(wsc.isOpen(), "the WebSocket is open");
        wsc.send("one");
        assertEq("ECHO:one", msgs.get(StaleShutdownWsClient::HandoffTimeout));
        wsc.disconnect();
        assertFalse(wsc.isOpen(), "the WebSocket is closed");
        assertEq(1, closed_count.getCount(), "the WebSocket is reported closed");

        checkNextConnection(wsc, msgs, closed_count, 1);
    }

    #! A connect() that fails after acquiring its connection releases it, and the client connects again
    failedConnectTest(string step) {
        Queue msgs();
        Counter closed_count();
        code cb = sub (*data msg) {
            if (exists msg) {
                msgs.push(msg);
            } else {
                closed_count.inc();
            }
        };
        StaleShutdownWsClient wsc(cb, {"url": "ws://localhost:" + linfo.port, "logger": logger});
        on_exit {
            try {
                wsc.disconnect();
            } catch () {
            }
            delete wsc;
        }

        wsc.fail_connect_at = step;
        assertThrows("TEST-CONNECT-ERROR", \wsc.connect());
        assertFalse(wsc.isOpen(), "the client is not connected");

        checkNextConnection(wsc, msgs, closed_count, 0);
    }

    #! checks that the client connects, that the connection works, and that disconnect() closes it
    private checkNextConnection(StaleShutdownWsClient wsc, Queue msgs, Counter closed_count, int closed) {
        wsc.connect();
        assertTrue(wsc.isOpen(), "the next connection is open");
        wsc.send("next");
        assertEq("ECHO:next", msgs.get(StaleShutdownWsClient::HandoffTimeout));
        wsc.disconnect();
        assertFalse(wsc.isOpen(), "the next connection is closed");
        assertEq(closed + 1, closed_count.getCount(), "the next connection is reported closed");
    }

    #! checks that the client's second connection is open, works, and is closed with disconnect()
    private checkSecondConnection(StaleShutdownWsClient wsc, Queue msgs, Counter closed_count) {
        assertTrue(wsc.isOpen(), "the second connection is open");
        assertEq(1, closed_count.getCount(), "the first connection is reported closed once");
        wsc.send("one");
        assertEq("ECHO:one", msgs.get(StaleShutdownWsClient::HandoffTimeout));
        wsc.disconnect();
        assertFalse(wsc.isOpen(), "the second connection is closed");
        assertEq(2, closed_count.getCount(), "the second connection is reported closed");
        wsc.connect();
        assertTrue(wsc.isOpen(), "the third connection is open");
        wsc.disconnect();
    }

    private runTest(bool across) {
        Queue msgs();
        Counter closed_count();
        code cb = sub (*data msg) {
            if (exists msg) {
                msgs.push(msg);
            } else {
                closed_count.inc();
            }
        };
        StaleShutdownWsClient wsc(cb, {"url": "ws://localhost:" + linfo.port, "logger": logger});
        on_exit {
            # never leave the delivery task held; only this thread releases it
            if (wsc.release.getCount()) {
                wsc.release.dec();
            }
            if (wsc.release_close.getCount()) {
                wsc.release_close.dec();
            }
            try {
                wsc.disconnect();
            } catch () {
            }
            delete wsc;
        }

        # first connection
        wsc.connect();
        assertTrue(wsc.isOpen(), "the first connection is open");
        wsc.arm(across);
        wsc.disconnect();
        # disconnect() returned with the "closed" message of the first connection held in the delivery task
        assertEq(0, wsc.held.waitForZero(1ms), "the delivery task holds the closed message");
        assertFalse(wsc.isOpen(), "the first connection is closed");
        assertEq(1, closed_count.getCount(), "the first connection is reported closed once");

        if (across) {
            # let the delivery task start the teardown of the first connection
            wsc.release.dec();
            wsc.watchDone();
            string ev = wsc.events.get(StaleShutdownWsClient::HandoffTimeout);
            if (ev == "closed-socket") {
                # the delivery task is held in the teardown: connect while it is held
                wsc.connect();
                assertTrue(wsc.isOpen(), "the second connection is open");
                wsc.release_close.dec();
                assertEq("done", wsc.events.get(StaleShutdownWsClient::HandoffTimeout));
            } else {
                # the delivery task left the closed connection alone
                assertEq("done", ev);
                wsc.connect();
            }
        } else {
            # connect while the delivery task holds the closed message, then let it go on
            wsc.connect();
            assertTrue(wsc.isOpen(), "the second connection is open");
            wsc.release.dec();
            wsc.watchDone();
            assertEq("done", wsc.events.get(StaleShutdownWsClient::HandoffTimeout));
        }

        # the teardown of the first connection left the second one alone
        assertTrue(wsc.isOpen(), "the second connection is still open");
        assertEq(1, closed_count.getCount(), "the second connection is not reported closed");
        wsc.send("one");
        assertEq("ECHO:one", msgs.get(StaleShutdownWsClient::HandoffTimeout));

        # disconnect() closes the second connection
        wsc.disconnect();
        assertFalse(wsc.isOpen(), "the second connection is closed");
        assertEq(2, closed_count.getCount(), "the second connection is reported closed");

        # and the client connects again
        wsc.connect();
        assertTrue(wsc.isOpen(), "the third connection is open");
        wsc.send("two");
        assertEq("ECHO:two", msgs.get(StaleShutdownWsClient::HandoffTimeout));
        wsc.disconnect();
        assertEq(3, closed_count.getCount(), "the third connection is reported closed");
    }
}
