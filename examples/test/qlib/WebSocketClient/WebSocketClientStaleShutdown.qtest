#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

# Copyright (C) 2026 Qore Technologies, s.r.o.

# Regression tests for the connection lifecycle of WebSocketClient (see "Connection Lifecycle and Concurrency" in the
# module documentation):
# - a connection is taken from the client by exactly one thread, which alone releases it and reports it closed; the
#   end of a connection that the client processes on its own leaves a newer connection alone (the original failure:
#   a stale teardown cleared the state of the next connection without closing it, so the next disconnect() did
#   nothing and the next connect() failed with HTTPCLIENT-CAPACITY-ERROR)
# - connect(), disconnect(), reconnect() and each attempt of an automatic reconnect run as one action at a time; a
#   call waits for an action in progress at most its own timeout (WEBSOCKET-ACTION-TIMEOUT), and never for a teardown
#   or a callback, so a closing callback can run after a new connection is open
# - an automatic reconnect does nothing once a connection was published after the teardown it was started for
# - delivery tasks belong to one connection
#
# Every interleaving is forced with lock handoffs (Counters and Queues) in a subclass; no case depends on timing,
# except the action timeout cases, which check that the wait lasts at least the timeout.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Logger
%requires DataProvider
%requires ConnectionProvider
%requires HttpServerUtil
%requires AsyncSocketIo
%requires HttpServerAsyncIo
%requires HttpServer
%requires HttpClientIo
%requires WebSocketUtil
%requires WebSocketHandler
%requires WebSocketClient
%requires DiscordWebSocketClient
%requires DiscordDataProvider
%requires json
%requires ../../TestCertificates.qm

%exec-class WebSocketClientStaleShutdownTest

class LifecycleWsConnection inherits WebSocketConnection {
    public {
        #! act as a Discord gateway: send HELLO when registered, and acknowledge heartbeats
        bool discord;
        #! the heartbeat interval sent in HELLO
        int hbi = 45000;
    }

    private {
        bool greet;
    }

    constructor(WebSocketHandler handler, bool greet = False) : WebSocketConnection(handler) {
        self.greet = greet;
    }

    registered() {
        if (discord) {
            send(make_json({"op": 10, "d": {"heartbeat_interval": hbi}}));
            return;
        }
        if (greet) {
            send("HELLO");
        }
    }

    gotMessage(string msg) {
        if (msg == "bye") {
            # the server closes the connection
            stop();
            return;
        }
        if (discord) {
            # heartbeats are acknowledged; other gateway messages are ignored
            auto h = parse_json(msg);
            if (h.typeCode() == NT_HASH && h.op == 1) {
                send(make_json({"op": 11}));
            }
            return;
        }
        send("ECHO:" + msg);
    }
}

class LifecycleWsHandler inherits WebSocketHandler {
    WebSocketConnection getConnectionImpl(hash<auto> cx, hash<auto> hdr, string cid) {
        LifecycleWsConnection c(self, exists hdr."x-greet");
        c.discord = exists hdr."x-discord";
        if (hdr."x-hbi") {
            c.hbi = hdr."x-hbi".toInt();
        }
        return c;
    }
}

#! A client whose threads can be held at the steps of the connection lifecycle
class LifecycleWsClient inherits WebSocketClient {
    public {
        #! bound of every handoff wait; only reached if the client does not run the expected step
        const HandoffTimeout = 30s;

        #! events reported by the hooks
        Queue events();

        #! the TID of the delivery task that delivered the "closed" message recorded or held
        int closed_tid = 0;
        #! record the TID of the delivery task that delivers the next "closed" message
        bool record_closed = False;
        #! hold the delivery task that delivers the next "closed" message, before it takes the connection
        bool hold_closed = False;
        #! released when the delivery task holds the "closed" message
        Counter closed_held(1);
        #! released by the test to let the delivery task holding the "closed" message go on
        Counter release_closed(1);

        #! hold the recorded delivery task after it took its connection, before it releases it
        bool hold_after_claim = False;
        #! released by the test to let the delivery task held after taking its connection go on
        Counter release_claim(1);

        #! where to hold the next action until gate_handshake is released: "action" (when it starts) or "claim" (after
        #! it closed and took the connection, if any)
        *string gate_mode;
        #! released by the test to end the gate
        Counter gate_handshake(1);
        #! code to run on the gated thread, inside its action, after the gate
        *code in_handshake_gate;

        #! the number of delivery tasks still to hold when they start
        int hold_tasks = 0;
        #! released by the test to let the held delivery tasks go on, in the order they started
        list<Counter> release_task = ();

        #! hold the next automatic reconnect when it starts
        bool hold_reconnect = False;
        #! released by the test to let the held reconnect go on
        Counter release_reconnect(1);

        #! the step of the next automatic reconnect to hold: "preamble" or "reestablish"
        *string hold_reconnect_step;
        #! released by the test to let a reconnect held at a step go on
        Counter release_reconnect_step(1);

        #! the next reestablishConnection() fails; the one after it is held at "reestablish"
        bool fail_reestablish_then_hold = False;
        #! the next reestablishConnection() fails
        bool fail_reestablish_once = False;
        #! the number of attempts of automatic reconnects
        int reestablish_attempts = 0;
        #! report each attempt of an automatic reconnect
        bool report_attempts = False;

        #! use a Discord-style reconnectPreamble(), which calls disconnectIntern() itself
        bool discord_preamble = False;
        #! code to run on the reconnect thread in reconnectPreamble()
        *code preamble_hook;

        #! the step at which the next connect fails: "handshake" or "start"
        *string fail_connect_at;

        #! report a thread that waits for an action
        bool report_action_wait = False;

        #! hold the next read of a handshake response of an HTTP/2 or HTTP/3 connect, after its request was sent
        bool hold_tunnel_read = False;
        #! released by the test to let the held read go on
        Counter release_tunnel_read(1);
        #! report each HTTP/1.1 Upgrade connect, and the destructor's cancel of the handshakes
        bool report_h1_upgrade = False;
        #! hold the next connectAsync() worker before it takes the action over
        bool hold_worker = False;
        #! the TID of the last connectAsync() worker that an action was handed over to
        int handoff_tid = 0;
        #! released by the test to let the held worker go on
        Counter release_worker(1);

        #! hold the next connect of a reconnect thread in its handshake, with the client's lock held
        bool hold_reconnect_handshake = False;
        #! released by the test to let a connect held in its handshake go on
        Counter release_handshake(1);

        #! hold the next connect notification (connectionOpened())
        bool hold_opened = False;
        #! released by the test to let a held connect notification go on
        Counter release_opened(1);
        #! gets the ID of each connection reported open
        Queue opened_cids();
        #! hold the connecting thread before it reports its connection open
        bool hold_before_open = False;
        #! released by the test to let the connecting thread report its connection open
        Counter release_before_open(1);
        #! gets the TID of the thread that reported each connection open
        Queue opened_tids();

        #! the delay between reconnect attempts
        timeout reconnect_delay = 1;

        #! gets an event when the destructor starts
        Queue destructor_started();

        #! report a thread that starts to wait for a close handshake
        bool report_handshake_wait = False;

        #! report explicitDisconnect() calls
        bool report_explicit_disconnect = False;

        #! the TID of the thread that last waited for a close handshake
        int handshake_tid = 0;
        #! gets the TID of each thread that waits for a close handshake
        Queue handshake_tids();
        #! hold the next close handshake wait until release_close_handshake is released
        bool hold_handshake = False;
        Counter release_close_handshake(1);
        #! gets the event and closing connection IDs seen in each closing callback
        Queue closing_ids();
        #! released when a connection is reported open
        Counter open_counter(1);
        #! wait in startAsyncIo(), after the operation was submitted, until the connection is reported open, then fail
        bool fail_after_open = False;
        #! fail in publishConnectionUnlocked() after the base method published the connection
        bool fail_publish = False;
        #! released to end holdActionInBackground()
        Counter release_action(1);
    }

    constructor(code cb, hash<auto> opts) : WebSocketClient(cb, opts) {
    }

    destructor() {
        destructor_started.push(True);
    }

    #! returns the reconnect flag
    bool getReconnectFlag() {
        AutoLock al(m);
        return self.reconnect;
    }

    #! returns the sequence number of the last connection published
    int getConnSeq() {
        AutoLock al(m);
        return conn_seq;
    }

    #! returns the socket of the HTTP/1.1 WebSocket
    *Socket getSocketForTest() {
        return getActiveSocket();
    }

    #! returns the action timeouts: "connect" and "other"
    hash<auto> getActionTimeouts() {
        return {
            "connect": getConnectActionTimeout(),
            "other": getActionTimeout(),
        };
    }

    #! returns True if the given thread runs a delivery task of the client
    bool isDeliveryThread(int tid) {
        AutoLock al(delivery_mutex);
        return delivery_tids{tid}.toBool();
    }

    #! returns True if a delivery task of the current connection is scheduled or running
    bool deliveryActive() {
        AutoLock al(m);
        if (!conn) {
            return False;
        }
        AutoLock dal(delivery_mutex);
        return conn.delivery_active;
    }

    #! aborts the poll operation of the HttpClientIo connection that the HTTP/1.1 WebSocket was upgraded on
    /** The same happens when the client cancels the operation after the upgrade while the I/O thread still runs
        it: the HttpClientIo connection is marked closed, while the WebSocket stays open on its socket.
    */
    abortHttpClientIoOperation() {
        AutoLock al(m);
        hcio_stream.getConnection().getPollOperation().abort();
    }

    #! holds the next \a n delivery tasks when they start; each is released with release_task
    holdDeliveryTasks(int n) {
        release_task = map new Counter(1), xrange(n);
        hold_tasks = n;
    }

    #! starts a thread that reports "done" when all delivery tasks have ended
    watchDone() {
        Queue q = events;
        Counter c = delivery_thread_counter;
        background TestThreads::run(sub () {
            q.push(c.waitForZero(HandoffTimeout) ? "timeout" : "done");
        });
    }

    #! runs the given call in a new thread, which reports \a name or the error
    inBackground(string name, code call) {
        Queue q = events;
        background TestThreads::run(sub () {
            try {
                call();
                q.push(name);
            } catch (hash<ExceptionInfo> ex) {
                q.push(sprintf("%s error: %s: %s", name, ex.err, ex.desc));
            }
        });
    }

    #! releases every hold, so no thread is left waiting
    releaseAll() {
        map $1.getCount() ? $1.dec() : NOTHING, (release_closed, release_claim, gate_handshake, release_reconnect,
            release_reconnect_step, release_handshake, release_opened, release_before_open, release_close_handshake, release_action) + release_task;
    }

    private runInitialDrain(WscConnection c) {
        if (hold_before_open) {
            hold_before_open = False;
            events.push("before-open");
            release_before_open.waitForZero(HandoffTimeout);
        }
        WebSocketClient::runInitialDrain(c);
    }

    private connectAsyncWorker(*hash<auto> opts, *Queue ready_queue, *bool handed_over) {
        if (handed_over) {
            handoff_tid = gettid();
        }
        if (hold_worker && handed_over) {
            hold_worker = False;
            Queue q = events;
            q.push("worker-held:" + gettid());
            try {
                release_worker.waitForZero(HandoffTimeout);
            } catch (hash<ExceptionInfo> ex) {
                # cancelled: the worker ends without taking the action over
                if (ex.err == "THREAD-CANCELLED") {
                    return;
                }
                rethrow;
            }
        }
        WebSocketClient::connectAsyncWorker(opts, ready_queue, handed_over);
    }

    #! starts a thread of the client running @a body; @a tid gets the TID that the start returns
    int startLibraryThreadForTest(code body, *bool use_start_thread, *Queue tid) {
        int rv = startLibraryThread(body, use_start_thread);
        if (tid) {
            tid.push(rv);
        }
        return rv;
    }

    #! returns the number of counted starts of threads of the client
    int libraryThreadCountForTest() {
        return lib_threads.getCount();
    }

    private auto readHandshakeResponse() {
        if (hold_tunnel_read && !(hcio_stream instanceof HttpClientIo::Http1ClientStreamHandle)) {
            hold_tunnel_read = False;
            events.push("tunnel-read-held");
            if (release_tunnel_read.waitForZero(HandoffTimeout)) {
                events.push("tunnel-read-expired");
            }
        }
        return WebSocketClient::readHandshakeResponse();
    }

    private hash<auto> connectHttp1WebSocketViaHcio(hash<auto> hdr, *reference<hash<auto>> info, *bool reconnect) {
        if (report_h1_upgrade) {
            events.push("h1-upgrade");
        }
        return WebSocketClient::connectHttp1WebSocketViaHcio(hdr, \info, reconnect);
    }

    private cancelHandshakeForDestroy() {
        WebSocketClient::cancelHandshakeForDestroy();
        if (report_h1_upgrade) {
            events.push("handshake-canceled");
        }
    }

    private waitLibraryThreads() {
        # a local reference: the queue is read after the object is gone
        Queue q = events;
        q.push("waiting-threads");
        WebSocketClient::waitLibraryThreads();
        q.push("threads-done");
    }

    #! holds the action in another thread, without the client's lock, until release_action is released
    holdActionInBackground() {
        # a method call, not a call reference: a call reference is evaluated in the new thread, out of the object
        background holdActionReported();
    }

    private holdActionReported() {
        try {
            holdAction();
        } catch (hash<ExceptionInfo> ex) {
            TestThreads::report(ex);
        }
    }

    private holdAction() {
        Queue q = events;
        Counter r = release_action;
        {
            AutoLock al(m);
            acquireActionUnlocked(HandoffTimeout);
        }
        q.push("action-held");
        r.waitForZero(HandoffTimeout);
        try {
            AutoLock al(m);
            releaseActionUnlocked();
        } catch (hash<ExceptionInfo> ex) {
            # the client was destroyed meanwhile
        }
    }

    #! returns the TID of the thread holding the action, or 0
    int getActionTidForTest() {
        AutoLock al(m);
        return action_tid;
    }

    private closingConnection() {
        closing_ids.push({"event": getEventConnectionId(), "closing": getClosingConnectionId()});
        WebSocketClient::closingConnection();
    }

    #! returns the connection ID of the current connection
    int getCidForTest() {
        return getConnectionId();
    }

    private waitCloseHandshake(hash<WscAsyncIoResources> res) {
        handshake_tid = gettid();
        handshake_tids.push(gettid());
        if (report_handshake_wait) {
            report_handshake_wait = False;
            events.push("handshake-wait");
        }
        if (hold_handshake) {
            hold_handshake = False;
            # the close handshake (and the action) waits until the test releases it
            release_close_handshake.waitForZero(HandoffTimeout);
        }
        WebSocketClient::waitCloseHandshake(res);
    }

    private explicitDisconnect() {
        if (report_explicit_disconnect) {
            events.push("explicit-disconnect");
        }
    }

    private connectionOpened(hash<auto> info) {
        opened_cids.push(info.cid);
        opened_tids.push(gettid());
        if (open_counter.getCount()) {
            open_counter.dec();
        }
        if (hold_opened) {
            hold_opened = False;
            # local references: the object may be destroyed while this thread waits
            Queue q = events;
            Counter c = release_opened;
            q.push("opened-held");
            c.waitForZero(HandoffTimeout);
        }
    }

    private timeout getReconnectDelay() {
        return reconnect_delay;
    }

    private int processAsyncMessage(hash<auto> msg) {
        if (msg.type == "closed" && (record_closed || hold_closed)) {
            record_closed = False;
            closed_tid = gettid();
            if (hold_closed) {
                hold_closed = False;
                closed_held.dec();
                release_closed.waitForZero(HandoffTimeout);
            }
        }
        return WebSocketClient::processAsyncMessage(msg);
    }

    private releaseAsyncIo(hash<WscAsyncIoResources> res) {
        if (hold_after_claim && closed_tid && gettid() == closed_tid) {
            hold_after_claim = False;
            events.push("claimed");
            release_claim.waitForZero(HandoffTimeout);
        }
        WebSocketClient::releaseAsyncIo(res);
    }

    #! holds the calling thread in its action until gate_handshake is released, with the lock released
    private gateUnlocked() {
        m.unlock();
        on_exit m.lock();
        events.push("gated");
        gate_handshake.waitForZero(HandoffTimeout);
        *code c = remove in_handshake_gate;
        if (c) {
            c();
        }
    }

    private *hash<WscAsyncIoResources> closeConnectionUnlocked(int cmd) {
        *hash<WscAsyncIoResources> rv = WebSocketClient::closeConnectionUnlocked(cmd);
        if (gate_mode == "claim") {
            remove gate_mode;
            gateUnlocked();
        }
        return rv;
    }

    private acquireActionUnlocked(timeout to) {
        bool handed = handoff_tid == gettid();
        if (report_action_wait && action_tid && action_tid != gettid() && !handed) {
            events.push("action-wait");
        }
        bool reentry = action_tid == gettid();
        WebSocketClient::acquireActionUnlocked(to);
        if ((gate_mode == "action" && !reentry) || (gate_mode == "handover" && handed)) {
            remove gate_mode;
            gateUnlocked();
        }
    }

    private deliverPendingMessages(WscConnection c) {
        int n = -1;
        if (hold_tasks > 0) {
            n = release_task.size() - hold_tasks--;
            events.push("task-held-" + n);
            release_task[n].waitForZero(HandoffTimeout);
        }
        WebSocketClient::deliverPendingMessages(c);
        if (n >= 0) {
            events.push("task-ended-" + n);
        }
    }

    private doReconnect(int token) {
        if (hold_reconnect) {
            hold_reconnect = False;
            events.push("reconnect-started");
            release_reconnect.waitForZero(HandoffTimeout);
        }
        Queue q = events;
        WebSocketClient::doReconnect(token);
        q.push("reconnect-done");
    }

    private reconnectPreamble() {
        if (hold_reconnect_step == "preamble") {
            remove hold_reconnect_step;
            events.push("reconnect-step");
            release_reconnect_step.waitForZero(HandoffTimeout);
        }
        *code hook = remove preamble_hook;
        if (hook) {
            hook();
        }
        if (discord_preamble) {
            # like DiscordWebSocketClient::reconnectPreamble(): state changes in the reconnect's action
            bool ran = runInReconnectAction(sub () {
                events.push("preamble-side-effect");
                disconnectIntern();
            });
            if (!ran) {
                events.push("preamble-superseded");
            }
            return;
        }
        WebSocketClient::reconnectPreamble();
    }

    private reestablishConnection(reference<hash<auto>> info) {
        ++reestablish_attempts;
        if (report_attempts) {
            events.push("attempt");
        }
        if (fail_reestablish_then_hold || fail_reestablish_once) {
            if (fail_reestablish_then_hold) {
                hold_reconnect_step = "reestablish";
            }
            fail_reestablish_then_hold = fail_reestablish_once = False;
            events.push("attempt-failed");
            throw "TEST-RECONNECT-ERROR", "the reconnect attempt fails";
        }
        if (hold_reconnect_step == "reestablish") {
            remove hold_reconnect_step;
            events.push("reconnect-step");
            release_reconnect_step.waitForZero(HandoffTimeout);
        }
        WebSocketClient::reestablishConnection(\info);
    }

    private hash<auto> connectUnlocked(*hash<auto> hdr0, *reference<hash<auto>> info, *bool reconnect) {
        if (reconnect && hold_reconnect_handshake) {
            hold_reconnect_handshake = False;
            events.push("reconnect-handshake");
            release_handshake.waitForZero(HandoffTimeout);
        }
        hash<auto> rv = WebSocketClient::connectUnlocked(hdr0, \info, reconnect);
        if (fail_connect_at == "handshake") {
            remove fail_connect_at;
            throw "TEST-CONNECT-ERROR", "the connect fails after the handshake";
        }
        return rv;
    }

    private WscConnection publishConnectionUnlocked() {
        WscConnection c = WebSocketClient::publishConnectionUnlocked();
        if (fail_publish) {
            fail_publish = False;
            throw "TEST-PUBLISH-ERROR", "the connect fails once its connection was published";
        }
        return c;
    }

    private startAsyncIo() {
        if (fail_connect_at == "start") {
            remove fail_connect_at;
            throw "TEST-CONNECT-ERROR", "the connect fails when the async I/O is started";
        }
        WebSocketClient::startAsyncIo();
        if (fail_after_open) {
            fail_after_open = False;
            # the delivery task reports the connection open; then the start fails
            open_counter.waitForZero(HandoffTimeout);
            throw "TEST-CONNECT-ERROR", "the connect fails after the async I/O started";
        }
    }
}

#! The state of one test case
class LifecycleCtx {
    public {
        #! messages received
        Queue msgs();
        #! connections reported closed
        Counter closed();
        #! errors raised in callbacks
        Queue errors();
        #! the client
        *LifecycleWsClient wsc;
        #! code to run in the closing callback, with the number of the close
        *code on_closed;
        #! code to run for a received message
        *code on_msg;
        #! gets the number of each close once its closing callback has returned
        Queue closes();
        #! the TID of the connecting thread, when a test records it
        int connect_tid = 0;
    }

    #! returns the callback for the client
    code getCallback() {
        return sub (*data msg) {
            if (exists msg) {
                if (on_msg) {
                    on_msg(msg);
                }
                msgs.push(msg);
                return;
            }
            closed.inc();
            int n = closed.getCount();
            if (on_closed) {
                try {
                    on_closed(n);
                } catch (hash<ExceptionInfo> ex) {
                    errors.push(sprintf("%s: %s", ex.err, ex.desc));
                }
            }
            closes.push(n);
        };
    }

    #! releases every hold and destroys the client
    destructor() {
        *LifecycleWsClient c = remove wsc;
        if (c) {
            c.releaseAll();
            try {
                c.disconnect();
            } catch () {
            }
            delete c;
        }
    }
}

class WebSocketClientStaleShutdownTest inherits QUnit::Test {
    public {
        HttpServer server;
        Logger logger;
        #! listener ports by protocol: "h1", "h2", "h3"
        hash<string, int> ports();
    }

    constructor() : Test("WebSocketClientStaleShutdownTest", "1.0") {
        foreach string proto in ("h1", "h2", "h3") {
            addTestCase(proto + ": stale teardown after the next connect", \staleTeardownAfterConnectTest(), proto);
            addTestCase(proto + ": teardown in progress across the next connect", \teardownAcrossConnectTest(), proto);
            addTestCase(proto + ": destructor in the closing callback", \destructorInClosingCallbackTest(), proto);
            addTestCase(proto + ": destructor on the delivery task waits for a thread of the client",
                \destructorOnDeliveryWithThreadTest(), proto);
            addTestCase(proto + ": destructor during a teardown", \destructorDuringTeardownTest(), proto);
            addTestCase(proto + ": destructor of an open connection", \destructorOpenTest(), proto);
            addTestCase(proto + ": disconnect in progress while the closing callback connects",
                \actionInProgressTest(), (proto, "disconnect"));
            addTestCase(proto + ": reconnect in progress while the closing callback connects", \actionInProgressTest(),
                (proto, "reconnect"));
            addTestCase(proto + ": disconnect during a teardown", \closeDuringTeardownTest(), (proto, "disconnect"));
            addTestCase(proto + ": reconnect during a teardown", \closeDuringTeardownTest(), (proto, "reconnect"));
            addTestCase(proto + ": connect during a teardown that starts a reconnect",
                \connectDuringReconnectTeardownTest(), proto);
            addTestCase(proto + ": connect while a reconnect is about to disconnect", \connectDuringReconnectStepTest(),
                (proto, "preamble"));
            addTestCase(proto + ": connect while a reconnect is about to connect", \connectDuringReconnectStepTest(),
                (proto, "reestablish"));
            addTestCase(proto + ": reconnect queued behind a connect", \reconnectQueuedBehindConnectTest(), proto);
            addTestCase(proto + ": reconnect connects before a later connect", \reconnectBeforeConnectTest(), proto);
            addTestCase(proto + ": two reconnect threads", \twoReconnectThreadsTest(), proto);
            addTestCase(proto + ": user calls on the reconnect thread", \reconnectThreadUserCallsTest(), proto);
            addTestCase(proto + ": Discord-style reconnect preamble", \discordPreambleTest(), proto);
            addTestCase(proto + ": disconnect while a reconnect waits between attempts",
                \disconnectBetweenAttemptsTest(), proto);
            addTestCase(proto + ": reconnect() while a reconnect waits between attempts", \reconnectDuringSleepTest(),
                proto);
            addTestCase(proto + ": action timeout in the reconnect preamble", \reconnectPreambleActionTimeoutTest(),
                proto);
            addTestCase(proto + ": destructor cancels a reconnect's handshake",
                \destructorCancelsReconnectHandshakeTest(), proto);
            addTestCase(proto + ": destructor reports a reconnect's connection open",
                \destructorReportsReconnectOpenTest(), proto);
            addTestCase(proto + ": destructor while a reconnect connects", \destructorDuringReconnectConnectTest(),
                proto);
            addTestCase(proto + ": connect waiting for an action times out", \actionTimeoutTest(), (proto, "connect"));
            addTestCase(proto + ": disconnect waiting for an action times out", \actionTimeoutTest(),
                (proto, "disconnect"));
            addTestCase(proto + ": re-entry in an action on the same thread", \reentryTest(), proto);
            addTestCase(proto + ": connect and disconnect in the closing callback",
                \connectDisconnectInClosingCallbackTest(), proto);
            addTestCase(proto + ": failed connect in the closing callback with reconnect",
                \failedConnectInClosingCallbackTest(), proto);
            addTestCase(proto + ": failed connect after the handshake", \failedConnectTest(), (proto, "handshake"));
            addTestCase(proto + ": failed connect when the async I/O starts", \failedConnectTest(), (proto, "start"));
            addTestCase(proto + ": delivery task of a closed connection starting late", \lateDeliveryTaskTest(), proto);
            addTestCase(proto + ": delivery task of a closed connection ending during a callback",
                \lateDeliveryTaskThreadTest(), proto);
            addTestCase(proto + ": callback disconnects and waits for the close", \callbackDisconnectWaitsForCloseTest(),
                proto);
            addTestCase(proto + ": data before the connecting thread reports open", \dataBeforeOpenTest(), proto);
            addTestCase(proto + ": open report while data is pending", \openWhileDataPendingTest(), proto);
            addTestCase(proto + ": connect observer waits for a reply", \connectedObserverWaitsForReplyTest(), proto);
            addTestCase(proto + ": connection ID on every event", \eventConnectionIdTest(), proto);
            addTestCase(proto + ": connect event before the close event", \connectedBeforeClosedTest(), proto);
            addTestCase(proto + ": disconnect from a raw callback during a close handshake",
                \rawCallbackDuringHandshakeTest(), proto);
            addTestCase(proto + ": disconnect while a reconnect is about to connect", \reconnectStoppedTest(), proto);
            addTestCase(proto + ": destructor while connectAsync connects", \destructorDuringConnectAsyncTest(),
                proto);
            addTestCase(proto + ": close cause in a nested closing report", \nestedCloseCauseTest(), proto);
            addTestCase(proto + ": connectAsync from a raw callback during a close handshake",
                \connectAsyncExemptTest(), proto);
            addTestCase(proto + ": connection ID in closing callbacks", \closingEventCidTest(), proto);
            addTestCase(proto + ": connection ID in nested closing callbacks", \nestedClosingEventCidTest(), proto);
            addTestCase(proto + ": pong and error events carry the connection ID", \pongErrorCidTest(), proto);
        }
        addTestCase("Discord HELLO handled in the connect report", \discordHelloTest());
        addTestCase("connect observer on the delivery task waits for a reply", \observerOnDeliveryTaskTest());
        addTestCase("start failing after the connection was reported open", \startFailsAfterOpenTest());
        addTestCase("replaced connection reported closed before a connection that failed to start",
            \replacedClosedBeforeUnstartedTest());
        addTestCase("Discord: concurrent stops of a heartbeat leave the new connection's heartbeat",
            \discordHeartbeatStopRaceTest());
        addTestCase("Discord: a superseded reconnect keeps the HELLO watchdog of the new connection",
            \discordWatchdogSupersededReconnectTest());
        addTestCase("Discord: a connect that fails keeps the HELLO watchdog of the connection",
            \discordWatchdogFailedConnectTest());
        addTestCase("Discord: an older connection's close during a handshake keeps the new HELLO watchdog",
            \discordWatchdogCloseDuringHandshakeTest());
        addTestCase("a connect failing once its connection was published leaves no connection",
            \publishFailsTest());
        addTestCase("a poll connect failing once its connection was published leaves no connection",
            \pollPublishFailsTest());
        addTestCase("Discord: a HELLO watchdog that cannot be armed does not fail the connect",
            \discordArmFailsTest());
        addTestCase("Discord: a connect that publishes and fails cancels its HELLO watchdog",
            \discordPublishedConnectFailsTest());
        addTestCase("Discord: a forced reconnect does not replace a newer connection",
            \discordForcedReconnectNewerConnectionTest());
        addTestCase("Discord: a forced reconnect does not reopen a disconnected client",
            \discordForcedReconnectAfterDisconnectTest());
        addTestCase("Discord: a HELLO watchdog timer of an earlier generation does nothing",
            \discordStaleHelloFireTest());
        addTestCase("Discord: a RESUME watchdog timer of an earlier generation does nothing",
            \discordStaleResumeFireTest());
        addTestCase("Discord: a RESUME watchdog is canceled only for its connection", \discordResumeKeyedTest());
        addTestCase("Discord: a heartbeat whose zombie reconnect is not made is cleared",
            \discordZombieHandoffFailsTest());
        addTestCase("Discord: EVENT_WS_CLOSED and the data provider's connection events", \discordClosedEventTest());
        addTestCase("Discord: a gateway data provider going out of scope is destroyed and stops observing",
            \discordProviderScopeTest());
        addTestCase("Discord: a deleted gateway data provider stops observing", \discordProviderDeleteTest());
        addTestCase("Discord: two gateway data providers on one client", \discordTwoProvidersTest());
        addTestCase("Discord: the destructor waits for a forced reconnect", \discordDestructorWaitsReconnectTest());
        addTestCase("Discord: the last reference released on the heartbeat thread",
            \discordLastRefOnHeartbeatThreadTest());
        addTestCase("Discord: dropping the last reference to a connected client destroys it",
            \discordDropConnectedClientTest());
        addTestCase("Discord: EVENT_WS_CLOSED is raised when a closing step fails", \discordClosedOnStepErrorTest());
        addTestCase("Discord: a failed handoff on the heartbeat thread does not wait for itself",
            \discordHandoffOnHeartbeatThreadTest());
        addTestCase("Discord: a heartbeat started with start_thread does not keep the client alive",
            \discordStartThreadHeartbeatDropTest());
        addTestCase("Discord: the destructor on the heartbeat thread and a forced reconnect do not wait for each "
            "other", \discordDestructorOnHeartbeatWithReconnectTest());
        addTestCase("Discord: a failing closing step does not skip the heartbeat stop", \discordClosingStepsGuardedTest());
        addTestCase("library thread accounting", \libraryThreadAccountingTest());
        addTestCase("no library thread is started once the destructor runs", \noLibraryThreadOnDestroyTest());
        addTestCase("a cancelled thread of the client is not waited for", \cancelledLibraryThreadTest());
        addTestCase("a cancelled thread whose code the hook deferred is not waited for", \cancelledDeferredThreadTest());
        addTestCase("Discord: a cancelled heartbeat thread is not waited for", \cancelledHeartbeatThreadTest());
        addTestCase("Discord: a heartbeat wait of less than a millisecond does not wait for a wakeup",
            \heartbeatShortSleepTest());
        addTestCase("the handoff of an action is decided once", \actionHandoffDecisionTest());
        addTestCase("a cancelled connectAsync() worker does not keep the action", \cancelledConnectAsyncWorkerTest());
        addTestCase("a cancelled connectAsync() caller and its cancelled worker do not keep the action",
            \cancelledConnectAsyncCallerAndWorkerTest());
        addTestCase("Discord: a destructor on another thread waits for a heartbeat thread reconnecting itself",
            \discordDeleteDuringInlineReconnectTest());
        addTestCase("Discord: a destructor on another thread waits for a heartbeat thread that stopped its own record",
            \discordDeleteAfterInlineStopTest());
        addTestCase("Discord: the destructor does not wait for a forced reconnect whose code the hook dropped",
            \discordDroppedStartTest());
        addTestCase("Discord: the destructor on the heartbeat thread does not wait for a forced reconnect whose code "
            "was released unrun", \discordDestructorOnHeartbeatDroppedReconnectTest());
        addTestCase("an action wait ends when the client is destroyed", \actionWaitEndsOnDestroyTest());
        addTestCase("a handshake in progress is canceled when the client is destroyed",
            \handshakeCanceledOnDestroyTest());
        foreach string proto in ("h2", "h3") {
            addTestCase(proto + ": raw callback during the initial drain", \rawCallbackInitialDrainTest(), proto);
            addTestCase(proto + ": raw callback exception during the initial drain",
                \rawCallbackInitialDrainErrorTest(), proto);
        }
        addTestCase("HTTP/1.1 connection whose HttpClientIo operation ended", \endedHttpClientIoOperationTest());
        addTestCase("disconnect from the raw frame callback", \rawCallbackDisconnectTest());
        addTestCase("startPollConnect lifecycle", \startPollConnectTest());
        addTestCase("startPollConnect closed before its event loop", \startPollConnectClosedTest());
        addTestCase("startEventLoop without a connection", \startEventLoopFailureTest());
        addTestCase("connectAsync lifecycle", \connectAsyncTest());
        addTestCase("failed connectAsync", \connectAsyncFailureTest());
        addTestCase("connectAsync followed by disconnect", \connectAsyncOrderTest());
        addTestCase("action timeout rules", \actionTimeoutRulesTest());
        addTestCase("disconnect timing out keeps automatic reconnects", \disconnectTimeoutKeepsReconnectTest());

        logger = new Logger("test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }
        server = new HttpServer(<HttpServerOptionInfo>{"logger": logger});
        server.setDefaultHandler("ws-handler", new LifecycleWsHandler());
        ports.h1 = server.addListener(<HttpListenerOptionInfo>{"node": "localhost", "service": 0}).port;
        try {
            ports.h2 = server.addListener(<HttpListenerOptionInfo>{
                "node": "localhost",
                "service": 0,
                "cert": new SSLCertificate(TestCertificates::CertPem),
                "key": new SSLPrivateKey(TestCertificates::KeyPem),
                "http_version": "auto",
                "enable_h3": False,
            }).port;
            ports.h3 = server.addListener(<HttpListenerOptionInfo>{
                "node": "localhost",
                "service": 0,
                "cert": new SSLCertificate(TestCertificates::CertPem),
                "key": new SSLPrivateKey(TestCertificates::KeyPem),
                "http_version": "auto",
            }).port;
            server.waitForAsyncIo();
        } catch (hash<ExceptionInfo> ex) {
            # TLS listeners not available: the HTTP/2 and HTTP/3 cases are skipped
        }

        addTestCase("Discord: a heartbeat that reconnects on its own thread is not detached",
            \discordInlineReconnectNotDetachedTest());
        addTestCase("a canceled HTTP/2 WebSocket handshake does not fall back to HTTP/1.1",
            \destroyDuringTunnelHandshakeTest());
        foreach string hv in (("auto", "1.1", "2.0")) {
            addTestCase(sprintf("the destructor ends a connect in its TLS handshake (HTTP version %s)", hv),
                \destroyDuringTlsHandshakeTest(), hv);
        }
        addTestCase("the destructor ends a connect in its QUIC handshake (HTTP/3)", \destroyDuringQuicHandshakeTest());
        # last: an exception that no thread of the tests handled fails the run
        addTestCase("no unhandled exception in a thread of the tests", \noUnhandledThreadExceptionsTest());
        set_return_value(main());

        server.stop();
        AsyncSocketIo::AsyncSocketIoController ctrl = AsyncSocketIo::getGlobalAsyncIoController();
        ctrl.stopClear();
    }

    #! creates the client of a test case; skips the case when the protocol is not available
    private LifecycleCtx makeCtx(string proto = "h1", *hash<auto> opts) {
        if (!ports{proto}) {
            testSkip(sprintf("%s listener not available", proto));
        }
        LifecycleCtx ctx();
        hash<auto> o = {};
        o.logger = logger;
        o += opts;
        if (proto == "h1") {
            o.url = "ws://localhost:" + ports.h1;
        } else {
            o += {
                "url": "wss://localhost:" + ports{proto},
                "http_version": "auto",
                "ssl_verify_cert": False,
            };
        }
        ctx.wsc = new LifecycleWsClient(ctx.getCallback(), o);
        return ctx;
    }

    #! connects and checks the negotiated protocol
    private connectChecked(LifecycleCtx ctx, string proto = "h1") {
        ctx.wsc.connect();
        if (proto == "h2" && !ctx.wsc.isHttp2()) {
            testSkip("HTTP/2 was not negotiated");
        }
        if (proto == "h3" && !ctx.wsc.isHttp3()) {
            testSkip("HTTP/3 was not negotiated");
        }
        assertTrue(ctx.wsc.isOpen(), "the connection is open");
    }

    #! checks that the client's connection works
    private checkEcho(LifecycleCtx ctx, string msg) {
        ctx.wsc.send(msg);
        assertEq("ECHO:" + msg, ctx.msgs.get(LifecycleWsClient::HandoffTimeout));
    }

    #! gets the given events, in any order
    private getEvents(LifecycleWsClient wsc, list<string> expected) {
        getEvents(wsc.events, expected);
    }

    #! gets the expected events from the queue, in any order
    private getEvents(Queue events, list<string> expected) {
        hash<string, bool> want = map {$1: True}, expected;
        while (want) {
            string ev = events.get(LifecycleWsClient::HandoffTimeout);
            assertTrue(want{ev}, sprintf("expected one of %y, got %y", keys want, ev));
            remove want{ev};
        }
    }

    #! checks that the current connection works and that disconnect() closes it and reports it closed once
    private checkCurrentConnection(LifecycleCtx ctx, int closed_before, string msg = "check") {
        assertEq(closed_before, ctx.closed.getCount(), "the connection is not reported closed");
        checkEcho(ctx, msg);
        ctx.wsc.disconnect();
        assertFalse(ctx.wsc.isOpen(), "the connection is closed");
        assertEq(closed_before + 1, ctx.closed.getCount(), "the connection is reported closed once");
        # and the client connects again
        ctx.wsc.connect();
        checkEcho(ctx, msg + "-again");
        ctx.wsc.disconnect();
        assertEq(closed_before + 2, ctx.closed.getCount(), "the last connection is reported closed once");
    }

    #! The delivery task holding the "closed" message of a connection closed with disconnect() runs after the next
    #! connect: its teardown finds the connection taken and leaves the new connection alone
    staleTeardownAfterConnectTest(string proto) {
        LifecycleCtx ctx = makeCtx(proto);
        connectChecked(ctx, proto);
        # the server closes the connection; the delivery task holds the "closed" message before it takes the connection
        ctx.wsc.hold_closed = True;
        ctx.wsc.send("bye");
        assertEq(0, ctx.wsc.closed_held.waitForZero(LifecycleWsClient::HandoffTimeout), "the delivery task holds the "
            "closed message");
        # disconnect() takes the connection and reports it closed at once, while the delivery task holds its message
        ctx.wsc.disconnect();
        assertEq(1, ctx.closed.getCount(), "disconnect() reports the connection closed");
        assertFalse(ctx.wsc.isOpen(), "the first connection is closed");

        ctx.wsc.connect();
        ctx.wsc.release_closed.dec();
        ctx.wsc.watchDone();
        assertEq("done", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        assertTrue(ctx.wsc.isOpen(), "the second connection is still open");
        checkCurrentConnection(ctx, 1);
    }

    #! The delivery task takes a connection closed by the server and is held before releasing it; meanwhile
    #! disconnect() does nothing and connect() opens a new connection without waiting; the closed connection is then
    #! reported closed after the new one is open
    teardownAcrossConnectTest(string proto) {
        LifecycleCtx ctx = makeCtx(proto);
        connectChecked(ctx, proto);
        ctx.wsc.record_closed = True;
        ctx.wsc.hold_after_claim = True;
        ctx.wsc.send("bye");
        assertEq("claimed", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        assertFalse(ctx.wsc.isOpen(), "the taken connection is closed");
        # the connection is no longer the client's: disconnect() has nothing to do
        ctx.wsc.disconnect();
        assertEq(0, ctx.closed.getCount(), "the taken connection is not reported closed by disconnect()");
        # connect() does not wait for the teardown in progress
        ctx.wsc.connect();
        checkEcho(ctx, "during");
        ctx.wsc.release_claim.dec();
        ctx.wsc.watchDone();
        assertEq("done", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        assertEq(1, ctx.closed.getCount(), "the taken connection is reported closed once, after the new one opened");
        assertTrue(ctx.wsc.isOpen(), "the new connection is still open");
        checkCurrentConnection(ctx, 1);
    }

    #! The closing callback run by the delivery task destroys the client
    destructorInClosingCallbackTest(string proto) {
        LifecycleCtx ctx = makeCtx(proto);
        connectChecked(ctx, proto);
        Queue deleted();
        # the client is destroyed only once send() returned: destroying it while this thread still runs send() would
        # raise OBJECT-ALREADY-DELETED here
        Counter sent(1);
        on_exit if (sent.getCount()) {
            sent.dec();
        }
        ctx.on_closed = sub (int n) {
            sent.waitForZero(LifecycleWsClient::HandoffTimeout);
            *LifecycleWsClient c = remove ctx.wsc;
            delete c;
            deleted.push(gettid());
        };
        ctx.wsc.send("bye");
        sent.dec();
        int tid = deleted.get(LifecycleWsClient::HandoffTimeout);
        assertTrue(tid > 0, "the client is destroyed in the closing callback");
        assertNothing(ctx.wsc);
        assertEq(1, ctx.closed.getCount(), "the connection is reported closed once");
    }

    #! The last reference is released in the closing callback, on the delivery task, while a thread of the client is
    #! deferred by the start_thread hook: the destructor, on the delivery task, waits for that thread, and not for
    #! itself
    destructorOnDeliveryWithThreadTest(string proto) {
        GatedStarter starter();
        on_exit starter.dropPending();
        LifecycleCtx ctx = makeCtx(proto, {"start_thread": \starter.start()});
        connectChecked(ctx, proto);
        Queue events = ctx.wsc.events;
        # a thread of the client whose code the hook defers
        starter.gate_next = True;
        Queue ran();
        ctx.wsc.startLibraryThreadForTest(sub () { ran.push(True); }, True);
        starter.started.waitForZero(LifecycleWsClient::HandoffTimeout);
        Queue deleted();
        ctx.on_closed = sub (int n) {
            *LifecycleWsClient c = remove ctx.wsc;
            delete c;
            deleted.push(gettid());
        };
        ctx.wsc.send("bye");
        # the destructor, on the delivery task, waits for the deferred thread
        getEventsSkipping(events, "waiting-threads");
        assertEq(0, deleted.size(), "the destructor waits while the thread has not run");
        starter.startPending();
        assertTrue(ran.get(LifecycleWsClient::HandoffTimeout), "the deferred thread ran");
        getEventsSkipping(events, "threads-done");
        int tid = deleted.get(LifecycleWsClient::HandoffTimeout);
        assertTrue(tid > 0, "the client is destroyed on the delivery task once the thread ended");
        assertEq(1, ctx.closed.getCount(), "the connection is reported closed once");
    }

    #! gets events until @a ev, ignoring the others
    private getEventsSkipping(Queue events, string ev) {
        while (True) {
            if (events.get(LifecycleWsClient::HandoffTimeout) == ev) {
                return;
            }
        }
    }

    #! A thread of the client is cancelled: it is uncounted when it ends, so the destructor does not wait for it
    cancelledLibraryThreadTest() {
        TestThreads::cancel_expected = True;
        on_exit TestThreads::cancel_expected = False;
        LifecycleWsClient c(sub (*data msg) {}, {"url": "ws://localhost:" + ports.h1, "logger": logger});
        Counter running(1);
        Counter block(1);
        on_exit if (block.getCount()) {
            block.dec();
        }
        Queue ended();
        int tid = c.startLibraryThreadForTest(sub () {
            on_exit ended.push(True);
            running.dec();
            # a cancellation point: the cancellation ends it with THREAD-CANCELLED
            try {
                block.waitForZero(LifecycleWsClient::HandoffTimeout);
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err != "THREAD-CANCELLED") {
                    rethrow;
                }
            }
        });
        running.waitForZero(LifecycleWsClient::HandoffTimeout);
        cancel_thread(tid, "test");
        assertTrue(ended.get(LifecycleWsClient::HandoffTimeout), "the thread ended");
        thread_join(tid);
        assertEq(0, c.libraryThreadCountForTest(), "the cancelled thread is uncounted");
        destroyChecked(c);
    }

    #! The thread of a start whose code the hook deferred is cancelled before it ran the code, which it releases: the
    #! start is uncounted
    cancelledDeferredThreadTest() {
        TestThreads::cancel_expected = True;
        on_exit TestThreads::cancel_expected = False;
        GatedStarter starter();
        on_exit starter.dropPending();
        LifecycleWsClient c(sub (*data msg) {}, {"url": "ws://localhost:" + ports.h1, "logger": logger,
            "start_thread": \starter.start()});
        starter.gate_next = True;
        Queue started_tid();
        c.startLibraryThreadForTest(sub () {}, True, started_tid);
        starter.started.waitForZero(LifecycleWsClient::HandoffTimeout);
        int tid = started_tid.get(LifecycleWsClient::HandoffTimeout);
        assertEq(1, c.libraryThreadCountForTest(), "the deferred start is counted");
        cancel_thread(tid, "test");
        thread_join(tid);
        assertEq(0, c.libraryThreadCountForTest(), "the start whose code was released unrun is uncounted");
        destroyChecked(c);
    }

    #! The heartbeat thread is cancelled: it reports its end, so the destructor does not wait for it
    cancelledHeartbeatThreadTest() {
        TestThreads::cancel_expected = True;
        on_exit TestThreads::cancel_expected = False;
        Queue tids();
        HbDiscord d({"url": "ws://localhost:" + ports.h1, "token": "x", "logger": logger,
            "start_thread": int sub (code c) {
                int t = background TestThreads::run(c);
                tids.push(t);
                return t;
            }});
        d.connect();
        d.startHeartbeatForTest(45000);
        assertEq("hb-started:" + d.getCurrentConnectionId(), d.events.get(LifecycleWsClient::HandoffTimeout));
        DiscordHeartbeat rec = d.hbRecordForTest();
        int tid = tids.get(LifecycleWsClient::HandoffTimeout);
        cancel_thread(tid, "test");
        thread_join(tid);
        assertTrue(rec.ended, "the cancelled heartbeat thread reported its end");
        assertEq(0, rec.running.getCount());
        destroyChecked(d);
    }

    #! The heartbeat thread's wait for its next beat with less than a millisecond left: a timeout of 0 ms would wait
    #! without a limit, so the beat would never be made
    heartbeatShortSleepTest() {
        DiscordHeartbeat rec(1, 1, 100);
        Queue returned();
        background TestThreads::run(sub () {
            # the heartbeat thread's wait for its next beat, due in less than a millisecond
            rec.waitUntil(now_us() + 500us);
            returned.push(True);
        });
        assertTrue(returned.get(LifecycleWsClient::HandoffTimeout), "the wait returned at once");
    }

    #! The worker of connectAsync() is cancelled before it took the action over: connectAsync() releases the action,
    #! so the next action does not wait for it
    cancelledConnectAsyncWorkerTest() {
        TestThreads::cancel_expected = True;
        on_exit TestThreads::cancel_expected = False;
        LifecycleWsClient c(sub (*data msg) {}, {"url": "ws://localhost:" + ports.h1, "logger": logger,
            "connect_timeout": LifecycleWsClient::HandoffTimeout});
        Queue events = c.events;
        Counter release = c.release_worker;
        on_exit if (release.getCount()) {
            release.dec();
        }
        c.hold_worker = True;
        Queue returned();
        background TestThreads::run(sub () {
            c.connectAsync();
            returned.push(True);
        });
        string ev = events.get(LifecycleWsClient::HandoffTimeout);
        assertTrue(ev =~ /^worker-held:/, ev);
        int tid = ev.split(":")[1].toInt();
        cancel_thread(tid, "test");
        thread_join(tid);
        assertTrue(returned.get(LifecycleWsClient::HandoffTimeout), "connectAsync() returned");
        # the action was released: a connect does not time out waiting for it
        c.connect();
        assertTrue(c.isOpen(), "the next connect was made");
        c.disconnect();
        destroyChecked(c);
    }

    #! The handoff of an action from connectAsync() to its worker is decided once; an action that no thread can
    #! release (the caller stopped waiting and the worker abandoned it) is recorded to be released
    actionHandoffDecisionTest() {
        WscOrphanedActions orphans();
        # taken over: a later abandon (the worker's end) changes nothing
        WscActionHandoff h1(orphans);
        assertTrue(h1.take());
        h1.abandon();
        assertTrue(h1.wait());
        assertEq((), orphans.takeAll());
        # abandoned first (e.g. a start that failed although the hook started the thread): the thread cannot take it
        WscActionHandoff h2(orphans);
        h2.abandon();
        assertFalse(h2.take(), "an abandoned handoff cannot be taken over");
        assertFalse(h2.wait());
        assertEq((), orphans.takeAll(), "the caller, which waits, releases the action itself");
        # the caller stops waiting, then the worker abandons it: the caller's action is recorded
        WscActionHandoff h3(orphans);
        h3.orphan();
        h3.abandon();
        assertEq((gettid(),), orphans.takeAll(), "the action of the caller is to be released");
        # the worker abandons it, then the caller stops waiting
        WscActionHandoff h4(orphans);
        h4.abandon();
        h4.orphan();
        assertEq((gettid(),), orphans.takeAll(), "the action of the caller is to be released");
        # the caller stops waiting, then the worker takes it over
        WscActionHandoff h5(orphans);
        h5.orphan();
        assertTrue(h5.take(), "the worker takes the action over");
        h5.abandon();
        assertEq((), orphans.takeAll());
    }

    #! The caller of connectAsync() is cancelled while it waits for its worker, which is then cancelled before it
    #! took the action over: the action is released by the next thread that starts one
    cancelledConnectAsyncCallerAndWorkerTest() {
        TestThreads::cancel_expected = True;
        on_exit TestThreads::cancel_expected = False;
        LifecycleWsClient c(sub (*data msg) {}, {"url": "ws://localhost:" + ports.h1, "logger": logger,
            "connect_timeout": LifecycleWsClient::HandoffTimeout});
        Queue events = c.events;
        Counter release = c.release_worker;
        on_exit if (release.getCount()) {
            release.dec();
        }
        c.hold_worker = True;
        Queue caller_done();
        int caller = background TestThreads::run(sub () {
            try {
                c.connectAsync();
                caller_done.push("returned");
            } catch (hash<ExceptionInfo> ex) {
                caller_done.push(ex.err);
            }
        });
        string ev = events.get(LifecycleWsClient::HandoffTimeout);
        assertTrue(ev =~ /^worker-held:/, ev);
        int worker = ev.split(":")[1].toInt();
        # the caller first, waiting for the worker's decision; then the worker
        cancel_thread(caller, "test");
        assertEq("THREAD-CANCELLED", caller_done.get(LifecycleWsClient::HandoffTimeout), "the caller was cancelled");
        cancel_thread(worker, "test");
        thread_join(worker);
        # the action was released: a connect does not time out waiting for it
        c.connect();
        assertTrue(c.isOpen(), "the next connect was made");
        c.disconnect();
        destroyChecked(c);
    }

    #! deletes the client on another thread and checks that the destructor returns
    private destroyChecked(WebSocketClient c) {
        Queue deleted();
        background TestThreads::run(sub () {
            delete c;
            deleted.push(True);
        });
        assertTrue(deleted.get(LifecycleWsClient::HandoffTimeout), "the destructor returned");
    }

    #! The client is destroyed on another thread while the delivery task tears its connection down
    destructorDuringTeardownTest(string proto) {
        LifecycleCtx ctx = makeCtx(proto);
        connectChecked(ctx, proto);
        ctx.wsc.record_closed = True;
        ctx.wsc.hold_after_claim = True;
        ctx.wsc.send("bye");
        assertEq("claimed", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        LifecycleWsClient c = remove ctx.wsc;
        Counter release = c.release_claim;
        Queue started = c.destructor_started;
        Queue deleted();
        background TestThreads::run(sub () {
            delete c;
            deleted.push(True);
        });
        # the destructor has started; it waits for the delivery task, which does not wait for the destructor
        assertTrue(started.get(LifecycleWsClient::HandoffTimeout), "the destructor started");
        release.dec();
        assertTrue(deleted.get(LifecycleWsClient::HandoffTimeout), "the client is destroyed");
        assertEq(1, ctx.closed.getCount(), "the connection is reported closed once");
    }

    #! The client is destroyed while its connection is open
    destructorOpenTest(string proto) {
        LifecycleCtx ctx = makeCtx(proto);
        connectChecked(ctx, proto);
        LifecycleWsClient c = remove ctx.wsc;
        delete c;
        assertEq(1, ctx.closed.getCount(), "the connection is reported closed once");
    }

    #! An explicit disconnect() or reconnect() holds the action through its close handshake while the delivery task
    #! takes the connection and its closing callback calls connect(): the connect waits for the action, the
    #! disconnect or reconnect then finds the connection taken, and the new connection stays open
    actionInProgressTest(string proto, string call) {
        LifecycleCtx ctx = makeCtx(proto);
        connectChecked(ctx, proto);
        ctx.on_closed = sub (int n) {
            if (n == 1) {
                ctx.wsc.events.push("callback-connect");
                ctx.wsc.connect();
            }
        };
        # the server closes the connection; the delivery task takes it and is held before releasing it
        ctx.wsc.record_closed = True;
        ctx.wsc.hold_after_claim = True;
        ctx.wsc.send("bye");
        assertEq("claimed", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        # the explicit call holds the action
        ctx.wsc.gate_mode = "action";
        if (call == "disconnect") {
            ctx.wsc.inBackground("disconnected", sub () { ctx.wsc.disconnect(); });
        } else {
            ctx.wsc.inBackground("reconnect-called", sub () { ctx.wsc.reconnect(); });
        }
        assertEq("gated", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        # the delivery task reports the connection closed; its closing callback's connect() waits for the action
        ctx.wsc.report_action_wait = True;
        ctx.wsc.release_claim.dec();
        getEvents(ctx.wsc, ("callback-connect", "action-wait"));
        ctx.wsc.report_action_wait = False;
        ctx.wsc.gate_handshake.dec();
        list<string> expected = (call == "disconnect" ? "disconnected" : "reconnect-called",);
        if (call == "reconnect") {
            # reconnect() found no connection and started a reconnect; it does nothing, as the closing callback opened
            # a connection after it was started
            push expected, "reconnect-done";
        }
        getEvents(ctx.wsc, expected);
        # the closing callback has returned
        assertEq(1, ctx.closes.get(LifecycleWsClient::HandoffTimeout));
        assertEq(0, ctx.errors.size(), "the connect in the closing callback succeeds");
        assertTrue(ctx.wsc.isOpen(), "the connection opened by the closing callback is open");
        ctx.on_closed = NOTHING;
        checkCurrentConnection(ctx, 1);
    }

    #! A disconnect() or reconnect() made while the delivery task tears the connection down does not wait for it
    #! and does not report the connection closed a second time
    closeDuringTeardownTest(string proto, string call) {
        LifecycleCtx ctx = makeCtx(proto);
        connectChecked(ctx, proto);
        ctx.wsc.record_closed = True;
        ctx.wsc.hold_after_claim = True;
        ctx.wsc.send("bye");
        assertEq("claimed", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        if (call == "disconnect") {
            ctx.wsc.disconnect();
            assertEq(0, ctx.closed.getCount(), "disconnect() does not report the taken connection closed");
        } else {
            # no connection: reconnect() starts a new connection in a reconnect thread
            ctx.wsc.hold_reconnect = True;
            assertTrue(ctx.wsc.reconnect(), "the reconnect is started");
            assertEq("reconnect-started", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
            assertEq(0, ctx.closed.getCount(), "reconnect() does not report the taken connection closed");
        }
        ctx.wsc.release_claim.dec();
        if (call == "reconnect") {
            ctx.wsc.release_reconnect.dec();
            assertEq("reconnect-done", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
            assertTrue(ctx.wsc.isOpen(), "the client has reconnected");
        }
        ctx.wsc.watchDone();
        assertEq("done", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        assertEq(1, ctx.closed.getCount(), "the taken connection is reported closed once");
        if (call == "reconnect") {
            checkCurrentConnection(ctx, 1);
        }
    }

    #! A connect() made while the teardown of a connection closed by the server is in progress and will start an
    #! automatic reconnect: the reconnect does nothing, as a connection was published after the teardown
    connectDuringReconnectTeardownTest(string proto) {
        LifecycleCtx ctx = makeCtx(proto, {"reconnect": True});
        connectChecked(ctx, proto);
        ctx.wsc.record_closed = True;
        ctx.wsc.hold_after_claim = True;
        ctx.wsc.send("bye");
        assertEq("claimed", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        ctx.wsc.connect();
        ctx.wsc.release_claim.dec();
        assertEq("reconnect-done", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        assertEq(0, ctx.wsc.reestablish_attempts, "the reconnect made no attempt");
        assertEq(1, ctx.closed.getCount(), "the closed connection is reported closed once");
        assertTrue(ctx.wsc.isOpen(), "the explicit connection is open");
        checkCurrentConnection(ctx, 1);
    }

    #! A connect() made while an automatic reconnect is about to disconnect or to connect: the reconnect leaves the
    #! new connection alone
    connectDuringReconnectStepTest(string proto, string step) {
        LifecycleCtx ctx = makeCtx(proto, {"reconnect": True});
        connectChecked(ctx, proto);
        ctx.wsc.hold_reconnect_step = step;
        ctx.wsc.send("bye");
        assertEq("reconnect-step", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        assertEq(1, ctx.closed.getCount(), "the first connection is reported closed");
        ctx.wsc.connect();
        ctx.wsc.release_reconnect_step.dec();
        assertEq("reconnect-done", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        assertTrue(ctx.wsc.isOpen(), "the explicit connection is open");
        checkCurrentConnection(ctx, 1);
    }

    #! The automatic reconnect connects before an explicit connect() made later: the connect replaces the reconnect's
    #! connection, which is reported closed once
    reconnectBeforeConnectTest(string proto) {
        LifecycleCtx ctx = makeCtx(proto, {"reconnect": True});
        connectChecked(ctx, proto);
        ctx.wsc.send("bye");
        assertEq("reconnect-done", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        assertEq(1, ctx.closed.getCount(), "the first connection is reported closed");
        assertTrue(ctx.wsc.isOpen(), "the reconnect's connection is open");
        ctx.wsc.connect();
        assertEq(2, ctx.closed.getCount(), "the reconnect's connection is reported closed when it is replaced");
        assertEq(1, ctx.wsc.reestablish_attempts, "the reconnect made one attempt");
        checkCurrentConnection(ctx, 2);
    }

    #! A reconnect waiting between attempts and a second reconnect started for a later connection: the first one
    #! makes no further attempt, the second one reconnects
    twoReconnectThreadsTest(string proto) {
        LifecycleCtx ctx = makeCtx(proto, {"reconnect": True});
        connectChecked(ctx, proto);
        # the first reconnect's first attempt fails; its second attempt is held
        ctx.wsc.fail_reestablish_then_hold = True;
        ctx.wsc.send("bye");
        assertEq("attempt-failed", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        assertEq("reconnect-step", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        assertEq(1, ctx.closed.getCount(), "the first connection is reported closed");
        # an explicit connection, closed by the server, starts a second reconnect, which is held
        ctx.wsc.connect();
        ctx.wsc.hold_reconnect = True;
        ctx.wsc.send("bye");
        assertEq("reconnect-started", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        assertEq(2, ctx.closed.getCount(), "the explicit connection is reported closed");
        # the first reconnect's held attempt finds a newer connection and ends
        ctx.wsc.release_reconnect_step.dec();
        assertEq("reconnect-done", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        assertFalse(ctx.wsc.isOpen(), "the first reconnect did not connect");
        # the second reconnect connects
        ctx.wsc.release_reconnect.dec();
        assertEq("reconnect-done", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        assertTrue(ctx.wsc.isOpen(), "the second reconnect connected");
        assertEq(3, ctx.wsc.reestablish_attempts, "two attempts by the first reconnect, one by the second");
        checkCurrentConnection(ctx, 2);
    }

    #! User code on the reconnect thread calls connect() and then disconnect(): both are explicit and work
    reconnectThreadUserCallsTest(string proto) {
        LifecycleCtx ctx = makeCtx(proto, {"reconnect": True});
        connectChecked(ctx, proto);
        ctx.wsc.preamble_hook = sub () {
            ctx.wsc.connect();
            ctx.wsc.events.push(ctx.wsc.isOpen() ? "hook-connected" : "hook-not-connected");
            ctx.wsc.disconnect();
            ctx.wsc.events.push(ctx.wsc.isOpen() ? "hook-not-disconnected" : "hook-disconnected");
        };
        ctx.wsc.send("bye");
        getEvents(ctx.wsc, ("hook-connected", "hook-disconnected", "reconnect-done"));
        assertFalse(ctx.wsc.isOpen(), "the disconnect() on the reconnect thread closed the connection");
        assertEq(2, ctx.closed.getCount(), "both connections are reported closed once");
        assertEq(0, ctx.wsc.reestablish_attempts, "the disconnect() stopped the reconnect");
    }

    #! A Discord-style reconnectPreamble() calls disconnectIntern(): it reconnects, and when a connection was opened
    #! before the preamble ran, it leaves it alone
    discordPreambleTest(string proto) {
        LifecycleCtx ctx = makeCtx(proto, {"reconnect": True});
        ctx.wsc.discord_preamble = True;
        connectChecked(ctx, proto);
        ctx.wsc.send("bye");
        assertEq("preamble-side-effect", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        assertEq("reconnect-done", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        assertTrue(ctx.wsc.isOpen(), "the reconnect connected");
        assertEq(1, ctx.closed.getCount(), "the first connection is reported closed");

        # the next reconnect is held at its preamble while an explicit connect opens a connection
        ctx.wsc.hold_reconnect_step = "preamble";
        ctx.wsc.send("bye");
        assertEq("reconnect-step", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        assertEq(2, ctx.closed.getCount(), "the reconnected connection is reported closed");
        ctx.wsc.connect();
        ctx.wsc.release_reconnect_step.dec();
        # the preamble's state changes are not made: the reconnect is superseded
        assertEq("preamble-superseded", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        assertEq("reconnect-done", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        assertTrue(ctx.wsc.isOpen(), "the preamble left the explicit connection alone");
        checkCurrentConnection(ctx, 2);
    }

    #! An explicit disconnect() made while the automatic reconnect waits between attempts does not wait for an
    #! action and stops the reconnect
    disconnectBetweenAttemptsTest(string proto) {
        LifecycleCtx ctx = makeCtx(proto, {"reconnect": True});
        connectChecked(ctx, proto);
        # the reconnect waits between its attempts until it is woken
        ctx.wsc.reconnect_delay = LifecycleWsClient::HandoffTimeout;
        ctx.wsc.fail_reestablish_then_hold = True;
        ctx.wsc.send("bye");
        assertEq("attempt-failed", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        # the reconnect holds no action while it waits for its next attempt
        ctx.wsc.report_action_wait = True;
        ctx.wsc.disconnect();
        ctx.wsc.report_action_wait = False;
        assertEq("reconnect-done", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        assertEq(1, ctx.wsc.reestablish_attempts, "the reconnect made no further attempt");
        assertFalse(ctx.wsc.isOpen(), "the client is not connected");
        assertEq(0, ctx.wsc.events.size(), "no action wait was reported");
    }

    #! A connect() or disconnect() that finds an action in progress waits at most its own timeout, then raises
    #! WEBSOCKET-ACTION-TIMEOUT, and succeeds once the action ended
    actionTimeoutTest(string proto, string call) {
        LifecycleCtx ctx = makeCtx(proto, {"connect_timeout": 300, "timeout": 300});
        connectChecked(ctx, proto);
        # a disconnect() holds the action after it took the connection
        ctx.wsc.gate_mode = "claim";
        ctx.wsc.inBackground("disconnected", sub () { ctx.wsc.disconnect(); });
        assertEq("gated", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));

        date start = now_us();
        if (call == "connect") {
            assertThrows("WEBSOCKET-ACTION-TIMEOUT", \ctx.wsc.connect());
        } else {
            assertThrows("WEBSOCKET-ACTION-TIMEOUT", \ctx.wsc.disconnect());
        }
        date elapsed = now_us() - start;
        assertTrue(elapsed >= 300ms, sprintf("the wait lasted %y, at least the timeout", elapsed));

        ctx.wsc.gate_handshake.dec();
        assertEq("disconnected", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        assertEq(1, ctx.closed.getCount(), "the connection is reported closed once");
        # the action has ended: the call succeeds
        if (call == "connect") {
            ctx.wsc.connect();
            assertTrue(ctx.wsc.isOpen(), "the connect succeeds after the action ended");
            checkCurrentConnection(ctx, 1);
        } else {
            ctx.wsc.disconnect();
            assertEq(1, ctx.closed.getCount(), "nothing more is reported closed");
        }
    }

    #! A thread that starts an action inside its own action does not wait for itself
    reentryTest(string proto) {
        LifecycleCtx ctx = makeCtx(proto);
        connectChecked(ctx, proto);
        ctx.wsc.gate_mode = "claim";
        ctx.wsc.gate_handshake.dec();
        # in its action, after it took the connection, the disconnecting thread connects again
        ctx.wsc.in_handshake_gate = sub () {
            ctx.wsc.connect();
            ctx.wsc.events.push("reentry-connected");
        };
        ctx.wsc.report_action_wait = True;
        ctx.wsc.disconnect();
        ctx.wsc.report_action_wait = False;
        getEvents(ctx.wsc, ("gated", "reentry-connected"));
        assertEq(0, ctx.wsc.events.size(), "no action wait was reported");
        # the connect opened a new connection; the disconnect then reported the connection it took closed
        assertEq(1, ctx.closed.getCount(), "the first connection is reported closed once");
        assertTrue(ctx.wsc.isOpen(), "the connection made in the action is open");
        checkCurrentConnection(ctx, 1);
    }

    #! A connect() followed by a disconnect() in the closing callback
    connectDisconnectInClosingCallbackTest(string proto) {
        LifecycleCtx ctx = makeCtx(proto);
        connectChecked(ctx, proto);
        ctx.on_closed = sub (int n) {
            if (n == 1) {
                ctx.wsc.connect();
                ctx.wsc.disconnect();
            }
        };
        ctx.wsc.send("bye");
        # the closing callback of the second connection runs in the first one's
        assertEq(2, ctx.closes.get(LifecycleWsClient::HandoffTimeout));
        assertEq(1, ctx.closes.get(LifecycleWsClient::HandoffTimeout));
        assertEq(0, ctx.errors.size(), "the connect and disconnect in the closing callback succeed");
        assertEq(2, ctx.closed.getCount(), "both connections are reported closed once");
        assertFalse(ctx.wsc.isOpen(), "the client is not connected");
        ctx.on_closed = NOTHING;
        ctx.wsc.connect();
        checkCurrentConnection(ctx, 2);
    }

    #! A connect() in the closing callback that fails when it starts the async I/O, with reconnect enabled: the
    #! automatic reconnect still follows
    failedConnectInClosingCallbackTest(string proto) {
        LifecycleCtx ctx = makeCtx(proto, {"reconnect": True});
        connectChecked(ctx, proto);
        ctx.on_closed = sub (int n) {
            if (n == 1) {
                ctx.wsc.fail_connect_at = "start";
                try {
                    ctx.wsc.connect();
                } catch (hash<ExceptionInfo> ex) {
                    ctx.wsc.events.push(ex.err);
                }
            }
        };
        ctx.wsc.send("bye");
        getEvents(ctx.wsc, ("TEST-CONNECT-ERROR", "reconnect-done"));
        assertTrue(ctx.wsc.isOpen(), "the automatic reconnect connected");
        assertEq(1, ctx.closed.getCount(), "only the first connection is reported closed");
        ctx.on_closed = NOTHING;
        checkCurrentConnection(ctx, 1);
    }

    #! A connect() that fails after acquiring its connection releases it, and the client connects again
    failedConnectTest(string proto, string step) {
        LifecycleCtx ctx = makeCtx(proto);
        ctx.wsc.fail_connect_at = step;
        assertThrows("TEST-CONNECT-ERROR", \ctx.wsc.connect());
        assertFalse(ctx.wsc.isOpen(), "the client is not connected");
        assertEq(0, ctx.closed.getCount(), "a connection that did not open is not reported closed");
        ctx.wsc.connect();
        checkCurrentConnection(ctx, 0);
    }

    #! An HTTP/1.1 WebSocket stays open when the HttpClientIo connection it was upgraded on is marked closed
    endedHttpClientIoOperationTest() {
        LifecycleCtx ctx = makeCtx();
        connectChecked(ctx);
        ctx.wsc.abortHttpClientIoOperation();
        assertTrue(ctx.wsc.isOpen(), "the WebSocket is open");
        checkCurrentConnection(ctx, 0);
    }

    #! A delivery task scheduled for a connection that starts after the connection was closed and a new one started
    #! delivers nothing; the new connection's task delivers its messages
    lateDeliveryTaskTest(string proto) {
        LifecycleCtx ctx = makeCtx(proto);
        connectChecked(ctx, proto);
        ctx.wsc.holdDeliveryTasks(2);
        ctx.wsc.send("one");
        assertEq("task-held-0", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        ctx.wsc.disconnect();
        ctx.wsc.connect();
        ctx.wsc.send("two");
        assertEq("task-held-1", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        ctx.wsc.release_task[0].dec();
        assertEq("task-ended-0", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        assertEq(0, ctx.msgs.size(), "the task of the closed connection delivers nothing");
        ctx.wsc.release_task[1].dec();
        assertEq("task-ended-1", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        assertEq("ECHO:two", ctx.msgs.get(0ms));
        assertEq(0, ctx.msgs.size(), "only the second connection's message is delivered");
        checkCurrentConnection(ctx, 1);
    }

    #! A delivery task of a closed connection that ends while the new connection's task runs a callback leaves the
    #! running task recognized as a delivery thread, which the destructor relies on
    lateDeliveryTaskThreadTest(string proto) {
        LifecycleCtx ctx = makeCtx(proto);
        connectChecked(ctx, proto);
        Counter in_callback(1);
        Counter release_callback(1);
        int callback_tid;
        ctx.on_msg = sub (data msg) {
            if (msg == "ECHO:block") {
                callback_tid = gettid();
                in_callback.dec();
                release_callback.waitForZero(LifecycleWsClient::HandoffTimeout);
            }
        };
        on_exit if (release_callback.getCount()) {
            release_callback.dec();
        }
        ctx.wsc.holdDeliveryTasks(1);
        ctx.wsc.send("one");
        assertEq("task-held-0", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        ctx.wsc.disconnect();
        ctx.wsc.connect();
        ctx.wsc.send("block");
        assertEq(0, in_callback.waitForZero(LifecycleWsClient::HandoffTimeout), "the callback runs");
        ctx.wsc.release_task[0].dec();
        assertEq("task-ended-0", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        assertTrue(ctx.wsc.isDeliveryThread(callback_tid), "the running task is still recognized");
        release_callback.dec();
        assertEq("ECHO:block", ctx.msgs.get(LifecycleWsClient::HandoffTimeout));
        ctx.on_msg = NOTHING;
        checkCurrentConnection(ctx, 1);
    }

    #! A disconnect() made in the raw frame callback, on a thread running a callback of the poll operation, does not
    #! wait for the operation to end
    rawCallbackDisconnectTest() {
        LifecycleCtx ctx();
        Queue done();
        *LifecycleWsClient client;
        code raw = int sub (hash<WsMsgInfo> event) {
            if (event.msg == "ECHO:quit") {
                try {
                    client.disconnect();
                    done.push("disconnected");
                } catch (hash<ExceptionInfo> ex) {
                    done.push(sprintf("%s: %s", ex.err, ex.desc));
                }
            }
            return WSC_Process;
        };
        ctx.wsc = client = new LifecycleWsClient(ctx.getCallback(), {
            "url": "ws://localhost:" + ports.h1,
            "logger": logger,
            "raw_callback": raw,
        });
        on_exit remove client;
        connectChecked(ctx);
        ctx.wsc.send("quit");
        assertEq("disconnected", done.get(LifecycleWsClient::HandoffTimeout));
        assertFalse(ctx.wsc.isOpen(), "the client is not connected");
        assertEq(1, ctx.closed.getCount(), "the connection is reported closed once");
    }

    #! startPollConnect() and startEventLoop() follow the same lifecycle as connect()
    startPollConnectTest() {
        LifecycleCtx ctx = makeCtx();
        WebSocketConnectPollOperation op = ctx.wsc.startPollConnect();
        assertTrue(op.goalReached(), "the connect operation is complete");
        ctx.wsc.startEventLoop(op.getOutput());
        checkEcho(ctx, "poll");
        # a server close followed by a connect
        ctx.wsc.send("bye");
        assertEq(1, ctx.closes.get(LifecycleWsClient::HandoffTimeout));
        assertEq(1, ctx.closed.getCount(), "the connection is reported closed once");
        op = ctx.wsc.startPollConnect();
        ctx.wsc.startEventLoop(op.getOutput());
        checkCurrentConnection(ctx, 1);
    }

    #! A connection made with startPollConnect() and closed before its event loop is started releases its
    #! connection; the event loop then cannot start, and the client connects again
    startPollConnectClosedTest() {
        LifecycleCtx ctx = makeCtx();
        WebSocketConnectPollOperation op = ctx.wsc.startPollConnect();
        assertTrue(ctx.wsc.isOpen(), "the connection is open");
        ctx.wsc.disconnect();
        assertFalse(ctx.wsc.isOpen(), "the connection is closed");
        assertEq(1, ctx.closed.getCount(), "the connection is reported closed once");
        assertThrows("WEBSOCKET-ERROR", \ctx.wsc.startEventLoop(), op.getOutput());
        assertFalse(ctx.wsc.isOpen(), "the client is not connected");
        ctx.wsc.connect();
        checkCurrentConnection(ctx, 1);
    }

    #! connectAsync() follows the same lifecycle as connect()
    connectAsyncTest() {
        LifecycleCtx ctx = makeCtx();
        Queue ready();
        ctx.wsc.connectAsync(NOTHING, ready);
        auto rv = ready.get(LifecycleWsClient::HandoffTimeout);
        assertFalse(exists rv.error, sprintf("the async connect succeeds: %y", rv.error));
        checkEcho(ctx, "async");
        ctx.wsc.connectAsync(NOTHING, ready);
        rv = ready.get(LifecycleWsClient::HandoffTimeout);
        assertFalse(exists rv.error, sprintf("the second async connect succeeds: %y", rv.error));
        assertEq(1, ctx.closed.getCount(), "the replaced connection is reported closed once");
        checkCurrentConnection(ctx, 1);
    }
    #! An automatic reconnect that queued for the action before a connect published a connection: its disconnect
    #! checks the token once it holds the action and leaves the new connection alone
    reconnectQueuedBehindConnectTest(string proto) {
        LifecycleCtx ctx = makeCtx(proto, {"reconnect": True});
        connectChecked(ctx, proto);
        # the reconnect is held before its preamble's disconnect
        ctx.wsc.hold_reconnect_step = "preamble";
        ctx.wsc.send("bye");
        assertEq("reconnect-step", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        assertEq(1, ctx.closed.getCount(), "the first connection is reported closed");
        # an explicit connect holds the action before it publishes its connection
        ctx.wsc.gate_mode = "action";
        ctx.wsc.inBackground("connected", sub () { ctx.wsc.connect(); });
        assertEq("gated", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        # the reconnect's disconnect queues for the action
        ctx.wsc.report_action_wait = True;
        ctx.wsc.release_reconnect_step.dec();
        assertEq("action-wait", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        ctx.wsc.report_action_wait = False;
        ctx.wsc.gate_handshake.dec();
        getEvents(ctx.wsc, ("connected", "reconnect-done"));
        assertTrue(ctx.wsc.isOpen(), "the explicit connection stays open");
        checkCurrentConnection(ctx, 1);
    }

    #! A failed connectAsync() leaves automatic reconnects enabled and does not disconnect the client afterwards
    connectAsyncFailureTest() {
        LifecycleCtx ctx = makeCtx("h1", {"reconnect": True});
        connectChecked(ctx);
        Queue ready();
        ctx.wsc.fail_connect_at = "handshake";
        ctx.wsc.connectAsync(NOTHING, ready);
        auto rv = ready.get(LifecycleWsClient::HandoffTimeout);
        assertEq("TEST-CONNECT-ERROR", rv.error.err);
        assertEq(1, ctx.closed.getCount(), "the replaced connection is reported closed");
        assertFalse(ctx.wsc.isOpen(), "the client is not connected");
        assertTrue(ctx.wsc.getReconnectFlag(), "automatic reconnects stay enabled");
        ctx.wsc.connect();
        checkCurrentConnection(ctx, 1);
    }

    #! A disconnect() made after connectAsync() returned runs after the async connect
    connectAsyncOrderTest() {
        LifecycleCtx ctx = makeCtx();
        Queue ready();
        ctx.wsc.connectAsync(NOTHING, ready);
        ctx.wsc.disconnect();
        auto rv = ready.get(LifecycleWsClient::HandoffTimeout);
        assertFalse(exists rv.error, sprintf("the async connect succeeds: %y", rv.error));
        assertFalse(ctx.wsc.isOpen(), "the disconnect closed the async connection");
        assertEq(1, ctx.closed.getCount(), "the async connection is reported closed");
        ctx.wsc.connect();
        checkCurrentConnection(ctx, 1);
    }

    #! A raw frame callback that calls a method of the client while the frames received with an HTTP/2 or HTTP/3
    #! handshake are delivered
    rawCallbackInitialDrainTest(string proto) {
        Queue raw_results();
        *LifecycleWsClient client;
        code raw = int sub (hash<WsMsgInfo> event) {
            if (event.msg == "HELLO") {
                try {
                    raw_results.push(client.isOpen() ? "open" : "closed");
                } catch (hash<ExceptionInfo> ex) {
                    raw_results.push(sprintf("%s: %s", ex.err, ex.desc));
                }
            }
            return WSC_Process;
        };
        LifecycleCtx ctx = makeCtx(proto, {"raw_callback": raw});
        client = ctx.wsc;
        on_exit remove client;
        # the server greets the connection right after the handshake
        ctx.wsc.connect({"hdr": {"X-Greet": "1"}});
        if (proto == "h2" && !ctx.wsc.isHttp2()) {
            testSkip("HTTP/2 was not negotiated");
        }
        if (proto == "h3" && !ctx.wsc.isHttp3()) {
            testSkip("HTTP/3 was not negotiated");
        }
        assertEq("open", raw_results.get(LifecycleWsClient::HandoffTimeout));
        assertEq("HELLO", ctx.msgs.get(LifecycleWsClient::HandoffTimeout));
        checkCurrentConnection(ctx, 0);
    }

    #! startEventLoop() without a connection raises an error and publishes nothing
    startEventLoopFailureTest() {
        LifecycleCtx ctx = makeCtx();
        int seq = ctx.wsc.getConnSeq();
        assertThrows("WEBSOCKET-ERROR", \ctx.wsc.startEventLoop(), {});
        assertEq(seq, ctx.wsc.getConnSeq(), "no connection is published");
        ctx.wsc.connect();
        checkCurrentConnection(ctx, 0);
    }

    #! The client is destroyed while an automatic reconnect is in its connect handshake
    destructorDuringReconnectConnectTest(string proto) {
        LifecycleCtx ctx = makeCtx(proto, {"reconnect": True});
        connectChecked(ctx, proto);
        # the reconnect publishes its connection, whose open report is held (made by the reconnect thread, or by a
        # delivery task if a frame of the connection is delivered first)
        ctx.wsc.hold_opened = True;
        ctx.wsc.send("bye");
        assertEq("opened-held", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        LifecycleWsClient c = remove ctx.wsc;
        Counter release_opened = c.release_opened;
        Counter release_destructor = c.release_close_handshake;
        Queue events = c.events;
        Queue opened_tids = c.opened_tids;
        Queue handshake_tids = c.handshake_tids;
        # the destructor is held in the close handshake wait of the connection it takes
        c.hold_handshake = True;
        c.report_handshake_wait = True;
        on_exit map $1.getCount() ? $1.dec() : NOTHING, (release_opened, release_destructor);
        handshake_tids.clear();
        # the first connection's opener, then the reconnect connection's
        opened_tids.get(LifecycleWsClient::HandoffTimeout);
        int opener_tid = opened_tids.get(LifecycleWsClient::HandoffTimeout);
        Queue deleted();
        background TestThreads::run(sub () {
            delete c;
            deleted.push(True);
        });
        # "reconnect-done" can come at any point before the destructor's thread wait ends
        bool reconnect_done;
        code next = string sub () {
            while (True) {
                string ev = events.get(LifecycleWsClient::HandoffTimeout);
                if (ev == "reconnect-done") {
                    reconnect_done = True;
                    continue;
                }
                return ev;
            }
        };
        # the destructor takes the connection and waits for its close handshake, while the open report is held
        assertEq("handshake-wait", next());
        int destructor_tid = handshake_tids.get(LifecycleWsClient::HandoffTimeout);
        assertTrue(opener_tid != destructor_tid, "another thread reports the connection open");
        # the destructor reports the connection closed while the open report runs, without waiting for it
        release_destructor.dec();
        assertEq("waiting-threads", next());
        assertEq(2, ctx.closed.getCount(), "both connections are reported closed once");
        release_opened.dec();
        # the destructor's thread wait ends only after the reconnect thread ended
        assertEq("threads-done", next());
        assertTrue(reconnect_done, "the reconnect thread ended before the destructor's thread wait");
        assertTrue(deleted.get(LifecycleWsClient::HandoffTimeout), "the client is destroyed");
        assertEq(2, ctx.closed.getCount(), "no connection is reported closed twice");
    }

    #! The client is destroyed while an automatic reconnect runs its handshake: the destructor cancels the
    #! handshake, the reconnect ends without a connection, and the destructor waits for it
    destructorCancelsReconnectHandshakeTest(string proto) {
        LifecycleCtx ctx = makeCtx(proto, {"reconnect": True});
        connectChecked(ctx, proto);
        ctx.wsc.hold_reconnect_handshake = True;
        ctx.wsc.send("bye");
        assertEq("reconnect-handshake", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        LifecycleWsClient c = remove ctx.wsc;
        Counter release = c.release_handshake;
        Queue started = c.destructor_started;
        Queue events = c.events;
        Queue opened_cids = c.opened_cids;
        on_exit if (release.getCount()) {
            release.dec();
        }
        opened_cids.clear();
        Queue deleted();
        background TestThreads::run(sub () {
            delete c;
            deleted.push(True);
        });
        assertTrue(started.get(LifecycleWsClient::HandoffTimeout), "the destructor started");
        # the reconnect's handshake starts after the destructor began: it is canceled, and the reconnect ends (before
        # or after the destructor started waiting for it)
        release.dec();
        getEvents(events, ("waiting-threads", "reconnect-done"));
        assertEq("threads-done", events.get(LifecycleWsClient::HandoffTimeout));
        assertTrue(deleted.get(LifecycleWsClient::HandoffTimeout), "the client is destroyed");
        assertEq(0, opened_cids.size(), "the reconnect published no connection");
        assertEq(1, ctx.closed.getCount(), "only the first connection was reported closed");
    }

    #! The client is destroyed while the reconnect thread, having published its connection, has not reported it open
    #! yet: the destructor, which takes the connection, reports it open before it reports it closed
    destructorReportsReconnectOpenTest(string proto) {
        LifecycleCtx ctx = makeCtx(proto, {"reconnect": True});
        connectChecked(ctx, proto);
        ctx.wsc.hold_before_open = True;
        ctx.wsc.send("bye");
        # the reconnect thread published its connection and is held before it reports it open
        assertEq("before-open", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        LifecycleWsClient c = remove ctx.wsc;
        Counter release_before_open = c.release_before_open;
        Queue events = c.events;
        Queue opened_tids = c.opened_tids;
        Queue opened_cids = c.opened_cids;
        Queue handshake_tids = c.handshake_tids;
        on_exit if (release_before_open.getCount()) {
            release_before_open.dec();
        }
        # the first connection was reported open by the connecting thread
        opened_tids.clear();
        opened_cids.clear();
        handshake_tids.clear();
        Queue deleted();
        background TestThreads::run(sub () {
            delete c;
            deleted.push(True);
        });
        # the destructor takes the connection, reports it open and closed, then waits for the reconnect thread
        assertEq("waiting-threads", events.get(LifecycleWsClient::HandoffTimeout));
        int destructor_tid = handshake_tids.get(LifecycleWsClient::HandoffTimeout);
        assertEq(destructor_tid, opened_tids.get(LifecycleWsClient::HandoffTimeout),
            "the destructor reports the connection open");
        assertEq(1, opened_cids.size(), "once");
        assertEq(2, ctx.closed.getCount(), "both connections are reported closed once");
        release_before_open.dec();
        # the destructor's wait ends only after the reconnect thread ended
        assertEq("reconnect-done", events.get(LifecycleWsClient::HandoffTimeout));
        assertEq("threads-done", events.get(LifecycleWsClient::HandoffTimeout));
        assertTrue(deleted.get(LifecycleWsClient::HandoffTimeout), "the client is destroyed");
        assertEq(0, opened_tids.size(), "the reconnect thread does not report it open again");
        assertEq(2, ctx.closed.getCount(), "no connection is reported closed twice");
    }

    #! reconnect() while an automatic reconnect waits between attempts: a new reconnect connects, and the waiting
    #! one ends
    reconnectDuringSleepTest(string proto) {
        LifecycleCtx ctx = makeCtx(proto, {"reconnect": True});
        connectChecked(ctx, proto);
        ctx.wsc.reconnect_delay = LifecycleWsClient::HandoffTimeout;
        ctx.wsc.fail_reestablish_once = True;
        ctx.wsc.send("bye");
        assertEq("attempt-failed", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        # the waiting reconnect makes no further attempt: it is woken when the new reconnect connects
        assertTrue(ctx.wsc.reconnect(), "a reconnect is started");
        getEvents(ctx.wsc, ("reconnect-done", "reconnect-done"));
        assertTrue(ctx.wsc.isOpen(), "the new reconnect connected");
        assertEq(2, ctx.wsc.reestablish_attempts, "one failed attempt, then the new reconnect's attempt");
        checkCurrentConnection(ctx, 1);
    }

    #! A message callback that calls disconnect() and then waits for the close: the close is reported by the
    #! disconnecting thread at once, while the message callback runs
    callbackDisconnectWaitsForCloseTest(string proto) {
        LifecycleCtx ctx = makeCtx(proto);
        connectChecked(ctx, proto);
        Queue result();
        ctx.on_msg = sub (data msg) {
            if (msg == "ECHO:quit") {
                ctx.wsc.disconnect();
                # the close was reported before disconnect() returned
                try {
                    result.push(ctx.closes.get(5s));
                } catch (hash<ExceptionInfo> ex) {
                    result.push(ex.err);
                }
            }
        };
        ctx.wsc.send("quit");
        assertEq(1, result.get(LifecycleWsClient::HandoffTimeout), "the callback gets the close it waits for");
        assertEq(1, ctx.closed.getCount(), "the connection is reported closed once");
        ctx.on_msg = NOTHING;
        # the message is queued once the callback returns: it is taken, not cleared, so it cannot be queued after
        assertEq("ECHO:quit", ctx.msgs.get(LifecycleWsClient::HandoffTimeout));
        ctx.wsc.connect();
        checkCurrentConnection(ctx, 1);
    }

    #! A message that arrives before the connecting thread reports the connection open: the delivery task reports it
    #! open first, and the connecting thread does not report it again
    dataBeforeOpenTest(string proto) {
        LifecycleCtx ctx = makeCtx(proto);
        ctx.wsc.hold_before_open = True;
        ctx.wsc.inBackground("connected", sub () {
            ctx.connect_tid = gettid();
            ctx.wsc.connect({"hdr": {"X-Greet": "1"}});
        });
        assertEq("before-open", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        # the greeting is delivered while the connecting thread is held; the delivery task reports the connection
        # open first
        assertEq("HELLO", ctx.msgs.get(LifecycleWsClient::HandoffTimeout));
        int cid = ctx.wsc.opened_cids.get(LifecycleWsClient::HandoffTimeout);
        assertTrue(ctx.wsc.opened_tids.get(LifecycleWsClient::HandoffTimeout) != ctx.connect_tid,
            "the connection was reported open by the delivery task, not by the connecting thread");
        ctx.wsc.release_before_open.dec();
        assertEq("connected", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        assertEq(0, ctx.wsc.opened_cids.size(), "the connecting thread did not report it open again");
        assertEq(cid, ctx.wsc.getCidForTest(), "the reported connection ID is the connection's");
        ctx.msgs.clear();
        checkCurrentConnection(ctx, 0);
    }

    #! The connecting thread reports the connection open while a message of the connection is pending: the delivery
    #! task does not wait for the open report to finish
    openWhileDataPendingTest(string proto) {
        LifecycleCtx ctx = makeCtx(proto);
        # the delivery task of the greeting is held when it starts, so the connecting thread reports the connection
        # open first, and is held in that report
        ctx.wsc.holdDeliveryTasks(1);
        ctx.wsc.hold_opened = True;
        ctx.wsc.inBackground("connected", sub () { ctx.wsc.connect({"hdr": {"X-Greet": "1"}}); });
        getEvents(ctx.wsc, ("task-held-0", "opened-held"));
        # the open report has started on the connecting thread; the greeting is delivered meanwhile, without waiting
        ctx.wsc.release_task[0].dec();
        assertEq("task-ended-0", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        assertEq("HELLO", ctx.msgs.get(0ms));
        assertEq(1, ctx.wsc.opened_cids.size(), "the connection is reported open once");
        ctx.wsc.release_opened.dec();
        assertEq("connected", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        assertEq(1, ctx.wsc.opened_cids.size(), "the connection is still reported open once");
        ctx.msgs.clear();
        checkCurrentConnection(ctx, 0);
    }

    #! An EVENT_WS_CONNECTED observer that sends a message and waits for the reply gets it
    connectedObserverWaitsForReplyTest(string proto) {
        hash<auto> opts = getOrderOpts(proto);
        OrderWsClient wsc(opts);
        on_exit delete wsc;
        ReplyObserver observer(wsc);
        wsc.registerObserver(observer);
        # connects
        wsc.observersReady();
        assertEq("ECHO:in-connected", observer.reply.get(LifecycleWsClient::HandoffTimeout),
            "the observer gets the reply it waits for");
    }

    #! Every event of WebSocketClientWithSerialization carries the ID of its connection
    eventConnectionIdTest(string proto) {
        hash<auto> opts = getOrderOpts(proto);
        OrderWsClient wsc(opts);
        on_exit delete wsc;
        OrderObserver observer();
        wsc.registerObserver(observer);
        # connects
        wsc.observersReady();
        hash<auto> ev = observer.full.get(LifecycleWsClient::HandoffTimeout);
        assertEq(EVENT_WS_CONNECTED, ev.id);
        int cid = wsc.getConnectionId();
        assertEq(cid, ev.data.cid, "the connect event carries the connection ID");
        wsc.send("one");
        ev = observer.full.get(LifecycleWsClient::HandoffTimeout);
        assertEq(EVENT_WS_DATA, ev.id);
        assertEq(cid, ev.data.cid, "the data event carries the connection ID");
        wsc.disconnect();
        ev = observer.full.get(LifecycleWsClient::HandoffTimeout);
        assertEq(EVENT_WS_CLOSED, ev.id);
        assertEq(cid, ev.data.cid, "the close event carries the connection ID");
    }

    #! returns client options for a WebSocketClientWithSerialization test client
    private hash<auto> getOrderOpts(string proto) {
        if (!ports{proto}) {
            testSkip(sprintf("%s listener not available", proto));
        }
        hash<auto> opts = {};
        opts.logger = logger;
        if (proto == "h1") {
            opts.url = "ws://localhost:" + ports.h1;
        } else {
            opts += {
                "url": "wss://localhost:" + ports{proto},
                "http_version": "auto",
                "ssl_verify_cert": False,
            };
        }
        return opts;
    }

    #! The connect report is started before the close report, which does not wait for it to finish
    connectedBeforeClosedTest(string proto) {
        hash<auto> opts = getOrderOpts(proto);
        OrderWsClient wsc(opts);
        on_exit {
            if (wsc.closed_seen.getCount()) {
                wsc.closed_seen.dec();
            }
            delete wsc;
        }
        OrderObserver observer();
        observer.client = wsc;
        wsc.registerObserver(observer);
        wsc.hold_open = True;
        wsc.order = observer.events;
        # connects; the server closes the connection while the connecting thread runs the connect report, which
        # waits until the close was reported
        wsc.observersReady();
        assertEq("opened-start", observer.events.get(LifecycleWsClient::HandoffTimeout));
        assertEq(EVENT_WS_CLOSED, observer.events.get(LifecycleWsClient::HandoffTimeout));
        assertEq(EVENT_WS_CONNECTED, observer.events.get(LifecycleWsClient::HandoffTimeout));
    }

    #! A disconnect() that times out waiting for an action changes nothing: automatic reconnects stay enabled
    disconnectTimeoutKeepsReconnectTest() {
        LifecycleCtx ctx = makeCtx(NOTHING, {"reconnect": True, "timeout": 300});
        connectChecked(ctx);
        # an explicit connect holds the action
        ctx.wsc.gate_mode = "action";
        ctx.wsc.inBackground("connected", sub () { ctx.wsc.connect(); });
        assertEq("gated", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        ctx.wsc.report_explicit_disconnect = True;
        assertThrows("WEBSOCKET-ACTION-TIMEOUT", \ctx.wsc.disconnect());
        assertTrue(ctx.wsc.getReconnectFlag(), "automatic reconnects stay enabled");
        ctx.wsc.gate_handshake.dec();
        # the timed-out disconnect did not run the subclass steps of an explicit disconnect
        assertEq("connected", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        ctx.wsc.report_explicit_disconnect = False;
        assertTrue(ctx.wsc.getReconnectFlag(), "automatic reconnects are still enabled");
        assertEq(1, ctx.closed.getCount(), "the replaced connection is reported closed");
        checkCurrentConnection(ctx, 1);
    }

    #! The action timeouts follow the rules of the I/O timeouts of the same options
    actionTimeoutRulesTest() {
        LifecycleCtx ctx = makeCtx(NOTHING, {"connect_timeout": 0, "timeout": -1});
        assertEq({"connect": 15000, "other": 15000}, ctx.wsc.getActionTimeouts());
        ctx = makeCtx(NOTHING, {"connect_timeout": 2000, "timeout": 3000});
        assertEq({"connect": 2000, "other": 3000}, ctx.wsc.getActionTimeouts());
        ctx = makeCtx(NOTHING, {"timeout": 3000});
        assertEq({"connect": 3000, "other": 3000}, ctx.wsc.getActionTimeouts());
        ctx = makeCtx(NOTHING, {"connect_timeout": 2s, "timeout": 3s});
        assertEq({"connect": 2000, "other": 3000}, ctx.wsc.getActionTimeouts());
    }

    #! An action timeout in the automatic reconnect's preamble does not end the reconnect: it goes on with its
    #! attempts
    reconnectPreambleActionTimeoutTest(string proto) {
        LifecycleCtx ctx = makeCtx(proto, {"reconnect": True, "timeout": 300});
        connectChecked(ctx, proto);
        # an explicit connect holds the action before it closes the connection
        ctx.wsc.gate_mode = "action";
        ctx.wsc.inBackground("connected", sub () { ctx.wsc.connect(); });
        assertEq("gated", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        # the server closes the connection; the reconnect's preamble and first attempt time out waiting for the
        # action
        ctx.wsc.report_attempts = True;
        ctx.wsc.send("bye");
        assertEq("attempt", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        ctx.wsc.report_attempts = False;
        ctx.wsc.gate_handshake.dec();
        # the explicit connect publishes its connection; the reconnect then ends
        hash<string, bool> seen = {};
        while (!seen.connected || !seen."reconnect-done") {
            string ev = ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout);
            if (ev == "attempt") {
                continue;
            }
            assertTrue(ev == "connected" || ev == "reconnect-done", sprintf("unexpected event %y", ev));
            seen{ev} = True;
        }
        assertTrue(ctx.wsc.reestablish_attempts > 0, "the reconnect made attempts after its preamble timed out");
        assertTrue(ctx.wsc.isOpen(), "the explicit connection is open");
        checkCurrentConnection(ctx, 1);
    }
    #! A raw frame callback that calls disconnect() while another thread waits for a close handshake that needs the
    #! callback's thread: the callback does not wait for the action
    rawCallbackDuringHandshakeTest(string proto) {
        Counter go(1);
        *LifecycleWsClient client;
        code raw = int sub (hash<WsMsgInfo> event) {
            if (event.msg == "ECHO:raw-quit") {
                client.events.push("raw-in");
                go.waitForZero(LifecycleWsClient::HandoffTimeout);
                try {
                    client.disconnect();
                    client.events.push("raw-disconnected");
                } catch (hash<ExceptionInfo> ex) {
                    client.events.push(sprintf("raw error: %s: %s", ex.err, ex.desc));
                }
            }
            return WSC_Process;
        };
        LifecycleCtx ctx = makeCtx(proto, {"raw_callback": raw, "timeout": 3000});
        client = ctx.wsc;
        on_exit {
            remove client;
            if (go.getCount()) {
                go.dec();
            }
        }
        connectChecked(ctx, proto);
        ctx.wsc.send("raw-quit");
        assertEq("raw-in", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        # another thread disconnects and waits for the close handshake, which the callback's thread must process
        ctx.wsc.report_handshake_wait = True;
        ctx.wsc.inBackground("disconnected", sub () { ctx.wsc.disconnect(); });
        assertEq("handshake-wait", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        go.dec();
        # the callback's disconnect does not wait for the action; the handshake then completes: over HTTP/2 and
        # HTTP/3 only this thread processes the server's close frame, so the callback's disconnect returns first; over
        # HTTP/1.1 the handshake does not need it, so the order is not defined
        if (proto == "h1") {
            getEvents(ctx.wsc, ("raw-disconnected", "disconnected"));
        } else {
            assertEq("raw-disconnected", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
            assertEq("disconnected", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        }
        assertEq(1, ctx.closed.getCount(), "the connection is reported closed once");
    }

    #! An explicit disconnect() made while an automatic reconnect is about to connect stops the reconnect: no
    #! connection is published after it
    reconnectStoppedTest(string proto) {
        LifecycleCtx ctx = makeCtx(proto, {"reconnect": True});
        connectChecked(ctx, proto);
        ctx.wsc.hold_reconnect_step = "reestablish";
        ctx.wsc.send("bye");
        assertEq("reconnect-step", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        assertEq(1, ctx.closed.getCount(), "the first connection is reported closed");
        ctx.wsc.disconnect();
        ctx.wsc.release_reconnect_step.dec();
        assertEq("reconnect-done", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        assertFalse(ctx.wsc.isOpen(), "the reconnect did not connect after the disconnect");
        assertEq(1, ctx.closed.getCount(), "no further connection is reported closed");
    }

    #! The destructor closes the current connection while the worker of connectAsync() is about to connect: the
    #! worker publishes no connection
    destructorDuringConnectAsyncTest(string proto) {
        LifecycleCtx ctx = makeCtx(proto);
        connectChecked(ctx, proto);
        Queue ready();
        # the worker is held once it started the action handed over by connectAsync()
        ctx.wsc.gate_mode = "handover";
        ctx.wsc.connectAsync(NOTHING, ready);
        assertEq("gated", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        LifecycleWsClient c = remove ctx.wsc;
        Counter gate = c.gate_handshake;
        Queue events = c.events;
        Queue deleted();
        c.report_handshake_wait = True;
        # the destructor is held in the close handshake wait until the worker ended: destroying the object while the
        # worker still runs one of its methods would raise OBJECT-ALREADY-DELETED in the worker instead
        c.hold_handshake = True;
        Counter release_destructor = c.release_close_handshake;
        on_exit if (release_destructor.getCount()) {
            release_destructor.dec();
        }
        background TestThreads::run(sub () {
            delete c;
            deleted.push(True);
        });
        # the destructor waits for the close handshake of the connection it took; the worker goes on meanwhile
        assertEq("handshake-wait", events.get(LifecycleWsClient::HandoffTimeout));
        gate.dec();
        auto rv = ready.get(LifecycleWsClient::HandoffTimeout);
        release_destructor.dec();
        assertEq("WEBSOCKET-ERROR", rv.error.err, "the worker publishes no connection");
        assertTrue(deleted.get(LifecycleWsClient::HandoffTimeout), "the client is destroyed");
        assertEq(1, ctx.closed.getCount(), "the connection is reported closed once");
    }

    #! getAsyncCloseCause() in a closing callback returns the connection's own cause, also after the callback
    #! reported another connection closed on the same thread
    nestedCloseCauseTest(string proto) {
        LifecycleCtx ctx = makeCtx(proto, {"idle_timeout": 200, "heartbeat": 0});
        Queue causes();
        ctx.on_closed = sub (int n) {
            if (n == 1) {
                causes.push(ctx.wsc.getAsyncCloseCause());
                ctx.wsc.connect();
                ctx.wsc.disconnect();
                causes.push(ctx.wsc.getAsyncCloseCause());
            }
        };
        connectChecked(ctx, proto);
        # the connection ends at its idle timeout
        string cause = causes.get(LifecycleWsClient::HandoffTimeout);
        assertEq("idle-timeout", cause, "the cause of the idle connection");
        assertEq(cause, causes.get(LifecycleWsClient::HandoffTimeout), "its cause after a nested closing report");
        assertEq(2, ctx.closes.get(LifecycleWsClient::HandoffTimeout), "the nested close is reported");
        assertEq(1, ctx.closes.get(LifecycleWsClient::HandoffTimeout));
    }

    #! An exception of the raw frame callback while the frames received with the handshake are delivered does not
    #! make connect() fail, and the connection works
    rawCallbackInitialDrainErrorTest(string proto) {
        code raw = int sub (hash<WsMsgInfo> event) {
            if (event.msg == "HELLO") {
                throw "TEST-RAW-ERROR", "the raw frame callback fails";
            }
            return WSC_Process;
        };
        LifecycleCtx ctx = makeCtx(proto, {"raw_callback": raw});
        ctx.wsc.connect({"hdr": {"X-Greet": "1"}});
        if (proto == "h2" && !ctx.wsc.isHttp2()) {
            testSkip("HTTP/2 was not negotiated");
        }
        if (proto == "h3" && !ctx.wsc.isHttp3()) {
            testSkip("HTTP/3 was not negotiated");
        }
        assertTrue(ctx.wsc.isOpen(), "the connection is open");
        checkCurrentConnection(ctx, 0);
    }
    #! When the forced reconnect's thread cannot be started, the heartbeat thread reconnects itself and stops its own
    #! record: the record is not detached (only a destructor running on the heartbeat thread detaches it)
    discordInlineReconnectNotDetachedTest() {
        FailingStarter starter();
        HbDiscord d({"url": "ws://localhost:" + ports.h1, "token": "x", "logger": logger,
            "start_thread": \starter.start()});
        on_exit {
            d.releaseAll();
            delete d;
        }
        d.connect();
        d.force_zombie = True;
        # the heartbeat thread starts; the next start (the forced reconnect's thread) fails
        starter.ok_starts = 1;
        d.startHeartbeatForTest(100);
        assertEq("hb-started:" + d.getCurrentConnectionId(), d.events.get(LifecycleWsClient::HandoffTimeout));
        DiscordHeartbeat rec = d.hbRecordForTest();
        # the heartbeat thread finds the zombie, reconnects on its own thread and ends
        rec.running.waitForZero(LifecycleWsClient::HandoffTimeout);
        assertTrue(rec.ended, "the heartbeat thread ended");
        assertFalse(rec.detached, "a heartbeat thread that stops its own record outside of the destructor is not "
            "detached");
    }

    #! The client is destroyed while its HTTP/2 extended CONNECT is not answered: the canceled handshake is not taken
    #! for a server that cannot tunnel WebSocket, so no HTTP/1.1 Upgrade request is made
    destroyDuringTunnelHandshakeTest() {
        if (!ports.h2) {
            testSkip("h2 listener not available");
        }
        LifecycleWsClient c(sub (*data msg) {}, {"url": "wss://localhost:" + ports.h2, "http_version": "auto",
            "ssl_verify_cert": False, "logger": logger});
        Queue events = c.events;
        Counter release = c.release_tunnel_read;
        on_exit if (release.getCount()) {
            release.dec();
        }
        c.hold_tunnel_read = True;
        c.report_h1_upgrade = True;
        Queue ready();
        # connectAsync() returns while its worker, holding the client's lock, waits for the handshake response
        c.connectAsync(NOTHING, ready);
        # the extended CONNECT was sent; its response is not read yet
        assertEq("tunnel-read-held", events.get(LifecycleWsClient::HandoffTimeout));
        assertEq(0, events.size(), "connectAsync() did not wait for the held handshake");
        Queue deleted();
        background TestThreads::run(sub () {
            delete c;
            deleted.push(True);
        });
        assertEq("handshake-canceled", events.get(LifecycleWsClient::HandoffTimeout));
        # the destructor waits for the connect, which now reads the response of its canceled handshake
        release.dec();
        assertTrue(deleted.get(LifecycleWsClient::HandoffTimeout), "the client is destroyed");
        auto r = ready.get(LifecycleWsClient::HandoffTimeout);
        assertEq("WEBSOCKET-ERROR", r.error.err, sprintf("the handshake was canceled: %y", r));
        list<string> rest = ();
        while (events.size()) {
            rest += events.get();
        }
        assertEq((), (select rest, $1 == "h1-upgrade"), sprintf("no HTTP/1.1 Upgrade request was made: %y", rest));
    }

    #! The client is destroyed while its connect waits for the server's TLS handshake: connectAsync() returned at
    #! once, and the destructor shuts the connection manager down instead of waiting for the connect timeout
    destroyDuringTlsHandshakeTest(string http_version) {
        Socket srv();
        srv.bindINET("localhost", "0");
        srv.listen();
        int port = srv.getSocketInfo().port;
        Queue accepted();
        Counter server_done(1);
        on_exit if (server_done.getCount()) {
            server_done.dec();
        }
        background TestThreads::run(sub () {
            # the connection is accepted, and no ServerHello is ever sent
            *Socket s = srv.accept(LifecycleWsClient::HandoffTimeout);
            accepted.push(exists s);
            server_done.waitForZero(LifecycleWsClient::HandoffTimeout * 4);
        });
        LifecycleWsClient c(sub (*data msg) {}, {"url": "wss://localhost:" + port, "http_version": http_version,
            "ssl_verify_cert": False, "logger": logger, "timeout": LifecycleWsClient::HandoffTimeout * 4,
            "connect_timeout": LifecycleWsClient::HandoffTimeout * 4});
        Queue ready();
        c.connectAsync(NOTHING, ready);
        # the server never answers, so the connect cannot have ended: connectAsync() did not wait for it
        assertEq(0, ready.size(), "connectAsync() returned while the connect waits for the TLS handshake");
        assertTrue(accepted.get(LifecycleWsClient::HandoffTimeout), "the client connected");
        Queue deleted();
        background TestThreads::run(sub () {
            delete c;
            deleted.push(True);
        });
        assertTrue(deleted.get(LifecycleWsClient::HandoffTimeout), "destroyed without waiting for the connect timeout");
        auto r = ready.get(LifecycleWsClient::HandoffTimeout);
        assertTrue(exists r.error, sprintf("the connect failed: %y", r));
    }

    #! The same for HTTP/3: the server's UDP socket receives the client's QUIC handshake and never answers it
    destroyDuringQuicHandshakeTest() {
        Socket srv();
        srv.bindINET("127.0.0.1", "0", False, AF_INET, SOCK_DGRAM);
        int port = srv.getSocketInfo().port;
        LifecycleWsClient c(sub (*data msg) {}, {"url": "wss://127.0.0.1:" + port, "http_version": "3.0",
            "ssl_verify_cert": False, "logger": logger, "timeout": LifecycleWsClient::HandoffTimeout * 4,
            "connect_timeout": LifecycleWsClient::HandoffTimeout * 4});
        Queue ready();
        c.connectAsync(NOTHING, ready);
        assertEq(0, ready.size(), "connectAsync() returned while the connect waits for the QUIC handshake");
        assertTrue(srv.isDataAvailable(LifecycleWsClient::HandoffTimeout), "the client started its handshake");
        Queue deleted();
        background TestThreads::run(sub () {
            delete c;
            deleted.push(True);
        });
        assertTrue(deleted.get(LifecycleWsClient::HandoffTimeout), "destroyed without waiting for the connect timeout");
        auto r = ready.get(LifecycleWsClient::HandoffTimeout);
        assertTrue(exists r.error, sprintf("the connect failed: %y", r));
    }

    #! Every thread that the tests or the clients' start_thread hooks started ended without an unhandled exception
    noUnhandledThreadExceptionsTest() {
        list<string> errs = ();
        while (TestThreads::errors.size()) {
            errs += TestThreads::errors.get();
        }
        assertEq((), errs, "no thread of the tests ended with an unhandled exception");
    }

    #! connectAsync() from a raw callback, which acts without the action, does not take the action from its holder
    connectAsyncExemptTest(string proto) {
        Counter go(1);
        *LifecycleWsClient client;
        Queue res();
        code raw = int sub (hash<WsMsgInfo> event) {
            if (event.msg == "ECHO:raw-ca") {
                client.events.push("raw-in");
                go.waitForZero(LifecycleWsClient::HandoffTimeout);
                try {
                    int before = client.getActionTidForTest();
                    client.connectAsync();
                    res.push({"before": before, "after": client.getActionTidForTest()});
                } catch (hash<ExceptionInfo> ex) {
                    res.push({"err": ex.err + ": " + ex.desc});
                }
            }
            return WSC_Process;
        };
        LifecycleCtx ctx = makeCtx(proto, {"raw_callback": raw, "timeout": 3000});
        client = ctx.wsc;
        on_exit {
            remove client;
            if (go.getCount()) {
                go.dec();
            }
        }
        connectChecked(ctx, proto);
        ctx.wsc.send("raw-ca");
        assertEq("raw-in", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        ctx.wsc.report_handshake_wait = True;
        # the disconnect keeps the action until the callback's connectAsync() returned
        ctx.wsc.hold_handshake = True;
        on_exit if (ctx.wsc.release_close_handshake.getCount()) {
            ctx.wsc.release_close_handshake.dec();
        }
        ctx.wsc.inBackground("disconnected", sub () { ctx.wsc.disconnect(); });
        assertEq("handshake-wait", ctx.wsc.events.get(LifecycleWsClient::HandoffTimeout));
        int t1 = ctx.wsc.handshake_tid;
        go.dec();
        hash<auto> r = res.get(LifecycleWsClient::HandoffTimeout);
        ctx.wsc.release_close_handshake.dec();
        assertEq(NOTHING, r.err, "connectAsync() in the callback does not wait for the action");
        assertEq(t1, r.before, "the disconnect holds the action before");
        assertEq(t1, r.after, "the disconnect still holds the action after connectAsync() returned in the callback");
    }

    #! getEventConnectionId() and getClosingConnectionId() in a closing callback give the closed connection's ID
    closingEventCidTest(string proto) {
        LifecycleCtx ctx = makeCtx(proto);
        connectChecked(ctx, proto);
        int cid = ctx.wsc.getCidForTest();
        ctx.wsc.disconnect();
        hash<auto> h = ctx.wsc.closing_ids.get(LifecycleWsClient::HandoffTimeout);
        assertEq(cid, h.closing, "getClosingConnectionId()");
        assertEq(cid, h.event, "getEventConnectionId() in the closing callback");
    }

    #! In a closing callback that connects and disconnects, the nested closing callback gives the inner
    #! connection's ID, and the outer one its own ID again after the nested report
    nestedClosingEventCidTest(string proto) {
        LifecycleCtx ctx = makeCtx(proto);
        connectChecked(ctx, proto);
        int cid1 = ctx.wsc.getCidForTest();
        Queue outer_after();
        Queue inner_cid();
        ctx.on_closed = sub (int n) {
            if (n == 1) {
                ctx.wsc.connect();
                inner_cid.push(ctx.wsc.getCidForTest());
                ctx.wsc.disconnect();
                outer_after.push({"event": ctx.wsc.getEventConnectionId(), "closing": ctx.wsc.getClosingConnectionId()});
            }
        };
        ctx.wsc.disconnect();
        hash<auto> outer = ctx.wsc.closing_ids.get(LifecycleWsClient::HandoffTimeout);
        assertEq(cid1, outer.event, "the outer closing callback: event ID");
        assertEq(cid1, outer.closing, "the outer closing callback: closing ID");
        int cid2 = inner_cid.get(LifecycleWsClient::HandoffTimeout);
        hash<auto> inner = ctx.wsc.closing_ids.get(LifecycleWsClient::HandoffTimeout);
        assertEq(cid2, inner.event, "the nested closing callback: event ID");
        assertEq(cid2, inner.closing, "the nested closing callback: closing ID");
        hash<auto> after = outer_after.get(LifecycleWsClient::HandoffTimeout);
        assertEq(cid1, after.event, "the outer callback after the nested report: event ID");
        assertEq(cid1, after.closing, "the outer callback after the nested report: closing ID");
    }

    #! Pong and error events of WebSocketClientWithSerialization carry the connection ID
    pongErrorCidTest(string proto) {
        hash<auto> opts = getOrderOpts(proto);
        opts += {"data": "json", "heartbeat": 100};
        OrderWsClient wsc(opts);
        on_exit delete wsc;
        OrderObserver observer();
        wsc.registerObserver(observer);
        # connects
        wsc.observersReady();
        hash<auto> ev = observer.full.get(LifecycleWsClient::HandoffTimeout);
        assertEq(EVENT_WS_CONNECTED, ev.id);
        int cid = wsc.getConnectionId();
        # the echo is not JSON: an error event; the heartbeat ping is answered: a pong event
        wsc.send("not json");
        hash<string, bool> seen = {};
        while (!seen{EVENT_WS_ERROR} || !seen{EVENT_WS_PONG}) {
            ev = observer.full.get(LifecycleWsClient::HandoffTimeout);
            if (ev.id == EVENT_WS_ERROR || ev.id == EVENT_WS_PONG) {
                assertEq(cid, ev.data.cid, sprintf("%s carries the connection ID", ev.id));
                seen{ev.id} = True;
            }
        }
    }

    #! A Discord client whose HELLO is handled while its connection is reported open keeps no HELLO watchdog armed
    discordHelloTest() {
        HelloDiscord d({"url": "ws://localhost:" + ports.h1, "token": "x", "logger": logger});
        on_exit delete d;
        HelloObserver o(d);
        d.registerObserver(o);
        d.connect({"hdr": {"X-Discord": "1"}});
        # the HELLO is processed during the connect report when the connecting thread makes it; when a delivery task
        # made it, connect() can return before
        d.hello_seen.waitForZero(LifecycleWsClient::HandoffTimeout);
        hash<auto> st = d.getHelloState();
        assertTrue(st.hello_seen, "HELLO processed");
        assertFalse(st.timer_armed && !st.hello_received, "no HELLO watchdog armed after the HELLO was processed");
        d.disconnect();
    }

    #! An EVENT_WS_CONNECTED observer run by the delivery task, which makes the open report, gets the reply it waits
    #! for
    observerOnDeliveryTaskTest() {
        ReplyClient c({"url": "ws://localhost:" + ports.h1, "logger": logger});
        on_exit delete c;
        ReplyObserver o(c);
        c.registerObserver(o);
        c.hold_before_open = True;
        int tid = gettid();
        c.connect({"hdr": {"X-Greet": "1"}});
        assertTrue(c.opened_tids.get(LifecycleWsClient::HandoffTimeout) != tid,
            "the open report was made by the delivery task");
        # the observer gets a message while it waits: the greeting or the reply, delivered while the open report
        # still runs on the delivery task that made it
        assertNeq("QUEUE-TIMEOUT", o.reply.get(LifecycleWsClient::HandoffTimeout),
            "the observer gets a message while it waits");
        c.disconnect();
    }

    #! A connect whose start fails after a delivery task reported the connection open reports it closed
    startFailsAfterOpenTest() {
        LifecycleCtx ctx = makeCtx("h1");
        ctx.wsc.fail_after_open = True;
        assertThrows("TEST-CONNECT-ERROR", \ctx.wsc.connect(), {"hdr": {"X-Greet": "1"}});
        assertEq(1, ctx.wsc.opened_cids.size(), "the connection was reported open");
        assertEq(1, ctx.closed.getCount(), "and it is reported closed");
        assertFalse(ctx.wsc.isOpen(), "the client is not connected");
        ctx.msgs.clear();
        ctx.wsc.connect();
        checkCurrentConnection(ctx, 1);
    }

    #! The connection replaced by a connect whose start fails is reported closed before the connect's own connection
    replacedClosedBeforeUnstartedTest() {
        LifecycleCtx ctx = makeCtx("h1");
        ctx.wsc.connect();
        int cid1 = ctx.wsc.getCidForTest();
        # the next connection's open report is waited for
        ctx.wsc.open_counter = new Counter(1);
        ctx.wsc.fail_after_open = True;
        assertThrows("TEST-CONNECT-ERROR", \ctx.wsc.connect(), {"hdr": {"X-Greet": "1"}});
        assertEq(cid1, ctx.wsc.opened_cids.get(LifecycleWsClient::HandoffTimeout));
        int cid2 = ctx.wsc.opened_cids.get(LifecycleWsClient::HandoffTimeout);
        assertTrue(cid2 != cid1, "the failed connect's connection was reported open");
        hash<auto> first = ctx.wsc.closing_ids.get(LifecycleWsClient::HandoffTimeout);
        hash<auto> second = ctx.wsc.closing_ids.get(LifecycleWsClient::HandoffTimeout);
        assertEq(cid1, first.closing, "the replaced connection is reported closed first");
        assertEq(cid2, second.closing, "then the connection that failed to start");
    }

    #! The close of a connection and the HELLO of the connection replacing it both stop the old heartbeat; the
    #! stopper that ends last does not touch the heartbeat that the HELLO started for the new connection
    discordHeartbeatStopRaceTest() {
        HbDiscord d({"url": "ws://localhost:" + ports.h1, "token": "x", "logger": logger});
        on_exit {
            d.releaseAll();
            delete d;
        }
        hash<auto> hdr = {"X-Discord": "1", "X-Hbi": "100"};
        # connection A and its heartbeat, held in its next heartbeat
        d.block_hb = True;
        d.connect({"hdr": hdr});
        int cid_a = d.getCurrentConnectionId();
        assertEq("hb-started:" + cid_a, d.events.get(LifecycleWsClient::HandoffTimeout));
        assertEq("hb-blocked", d.events.get(LifecycleWsClient::HandoffTimeout));
        # connect B: the close of A (on the connecting thread) and the HELLO of B (on a delivery task) both stop A's
        # heartbeat, which is held, so both wait for it
        d.hold_closing_after_wait = True;
        Queue xq();
        background TestThreads::run(sub () {
            try {
                d.connect({"hdr": hdr});
                xq.push("ok");
            } catch (hash<ExceptionInfo> ex) {
                xq.push(ex.err);
            }
        });
        hash<string, bool> waiting = {};
        while (waiting.size() < 2) {
            waiting{d.events.get(LifecycleWsClient::HandoffTimeout)} = True;
        }
        assertEq({"waiting:closing": True, "waiting:hello": True}, waiting);
        # A's heartbeat ends; the closing thread is held after its wait until B's heartbeat was started
        d.release_hb.dec();
        hash<string, bool> next = {};
        while (next.size() < 2) {
            next{d.events.get(LifecycleWsClient::HandoffTimeout)} = True;
        }
        int cid_b = d.getCurrentConnectionId();
        assertEq({"closing-woke": True, "hb-started:" + cid_b: True}, next);
        d.release_closing.dec();
        assertEq("ok", xq.get(LifecycleWsClient::HandoffTimeout));
        hash<auto> st = d.hbState();
        assertEq(cid_b, st.cid, "the heartbeat is the new connection's");
        assertEq(1, st.running, "its thread runs");
        assertEq(100, st.interval);
        # and it beats
        d.release_hb = new Counter(1);
        d.block_hb = True;
        assertEq("hb-blocked", d.events.get(LifecycleWsClient::HandoffTimeout));
        d.release_hb.dec();
        d.disconnect();
        assertEq(-1, d.hbState().cid, "the disconnect stopped the heartbeat");
    }

    #! An automatic reconnect superseded by an explicit connect neither arms nor cancels the HELLO watchdog of the
    #! explicit connect's connection
    discordWatchdogSupersededReconnectTest() {
        WdDiscord d({"url": "ws://localhost:" + ports.h1, "token": "x", "logger": logger, "reconnect": True});
        on_exit {
            d.releaseAll();
            delete d;
        }
        d.connect();
        assertEq(d.getCurrentConnectionId(), d.wdState().cid, "the watchdog of the first connection is armed");
        # the reconnect is held before it starts
        d.hold_reest = True;
        d.reconnect();
        assertEq("reest-held", d.events.get(LifecycleWsClient::HandoffTimeout));
        # an explicit connect is held in its handshake, holding its action and the client's lock
        d.hold_handshake = True;
        Queue xq();
        background TestThreads::run(sub () {
            try {
                d.connect();
                xq.push("ok");
            } catch (hash<ExceptionInfo> ex) {
                xq.push(ex.err);
            }
        });
        assertEq("handshake-held", d.events.get(LifecycleWsClient::HandoffTimeout));
        # the reconnect goes on: it waits for the connect, which supersedes it
        d.release_reest.dec();
        assertEq("reest-released", d.events.get(LifecycleWsClient::HandoffTimeout));
        d.release_handshake.dec();
        assertEq("ok", xq.get(LifecycleWsClient::HandoffTimeout));
        assertEq("reconnect-done", d.events.get(LifecycleWsClient::HandoffTimeout));
        hash<auto> st = d.wdState();
        assertTrue(st.timer != 0, "a HELLO watchdog is armed");
        assertFalse(st.hello_received);
        assertEq(d.getCurrentConnectionId(), st.cid, "for the client's connection");
        d.disconnect();
    }

    #! A connect that times out waiting for another action does not cancel the HELLO watchdog of the connection the
    #! client keeps
    discordWatchdogFailedConnectTest() {
        WdDiscord d({"url": "ws://localhost:" + ports.h1, "token": "x", "logger": logger, "connect_timeout": 500});
        on_exit {
            d.releaseAll();
            delete d;
        }
        d.connect();
        int cid = d.getCurrentConnectionId();
        # a disconnect is held in its action, before it closes the connection
        d.hold_explicit = True;
        background TestThreads::run(sub () {
            try {
                d.disconnect();
                d.events.push("disconnected");
            } catch (hash<ExceptionInfo> ex) {
                d.events.push(ex.err);
            }
        });
        assertEq("explicit-held", d.events.get(LifecycleWsClient::HandoffTimeout));
        assertThrows("WEBSOCKET-ACTION-TIMEOUT", \d.connect());
        assertEq(cid, d.getCurrentConnectionId(), "the connection is kept");
        hash<auto> st = d.wdState();
        assertTrue(st.timer != 0, "the HELLO watchdog is still armed");
        assertEq(cid, st.cid, "for the client's connection");
        d.release_explicit.dec();
        assertEq("disconnected", d.events.get(LifecycleWsClient::HandoffTimeout));
    }

    #! The close of an older connection, reported while a connect runs its handshake, does not cancel the HELLO
    #! watchdog of the connection the connect makes
    discordWatchdogCloseDuringHandshakeTest() {
        WdDiscord d({"url": "ws://localhost:" + ports.h1, "token": "x", "logger": logger});
        on_exit {
            d.releaseAll();
            delete d;
        }
        d.connect();
        int cid_a = d.getCurrentConnectionId();
        # the server closes A; its close report is held
        d.hold_closing = True;
        d.send("bye");
        assertEq("closing-held", d.events.get(LifecycleWsClient::HandoffTimeout));
        # a connect runs its handshake while the close of A is reported
        d.hold_handshake = True;
        Queue xq();
        background TestThreads::run(sub () {
            try {
                d.connect();
                xq.push("ok");
            } catch (hash<ExceptionInfo> ex) {
                xq.push(ex.err);
            }
        });
        assertEq("handshake-held", d.events.get(LifecycleWsClient::HandoffTimeout));
        d.release_closing.dec();
        assertEq("closing-done:" + cid_a, d.events.get(LifecycleWsClient::HandoffTimeout));
        d.release_handshake.dec();
        assertEq("ok", xq.get(LifecycleWsClient::HandoffTimeout));
        hash<auto> st = d.wdState();
        assertTrue(st.timer != 0, "a HELLO watchdog is armed");
        assertFalse(st.hello_received);
        assertEq(d.getCurrentConnectionId(), st.cid, "for the new connection");
        d.disconnect();
    }

    #! A connect that fails after its connection was published (e.g. by an override of publishConnectionUnlocked())
    #! takes the connection again: the client has no connection, nothing is reported, and the next connect works
    publishFailsTest() {
        LifecycleCtx ctx = makeCtx("h1");
        ctx.wsc.fail_publish = True;
        assertThrows("TEST-PUBLISH-ERROR", \ctx.wsc.connect());
        assertEq(-1, ctx.wsc.getCurrentConnectionId(), "the client has no connection");
        assertFalse(ctx.wsc.isOpen());
        assertEq(0, ctx.wsc.opened_cids.size(), "nothing is reported open");
        assertEq(0, ctx.closed.getCount(), "nothing is reported closed");
        ctx.wsc.connect();
        checkCurrentConnection(ctx, 0);
    }

    #! As publishFailsTest() for startPollConnect()
    pollPublishFailsTest() {
        LifecycleCtx ctx = makeCtx("h1");
        ctx.wsc.fail_publish = True;
        assertThrows("TEST-PUBLISH-ERROR", \ctx.wsc.startPollConnect());
        assertEq(-1, ctx.wsc.getCurrentConnectionId(), "the client has no connection");
        assertFalse(ctx.wsc.isOpen());
        assertEq(0, ctx.wsc.opened_cids.size(), "nothing is reported open");
        assertEq(0, ctx.closed.getCount(), "nothing is reported closed");
        ctx.wsc.connect();
        checkCurrentConnection(ctx, 0);
    }

    #! A HELLO watchdog that cannot be armed is logged; the connect succeeds
    discordArmFailsTest() {
        WdDiscord d({"url": "ws://localhost:" + ports.h1, "token": "x", "logger": logger});
        on_exit {
            d.releaseAll();
            delete d;
        }
        d.fail_arm = True;
        d.connect();
        assertTrue(d.isOpen(), "the connect succeeded");
        assertEq(0, d.wdState().timer, "no watchdog is armed");
        d.disconnect();
    }

    #! A connect whose connection was published (arming its watchdog) and whose start then fails cancels the watchdog
    #! of that connection, which is no longer the client's
    discordPublishedConnectFailsTest() {
        WdDiscord d({"url": "ws://localhost:" + ports.h1, "token": "x", "logger": logger});
        on_exit {
            d.releaseAll();
            delete d;
        }
        d.fail_start = True;
        assertThrows("TEST-CONNECT-ERROR", \d.connect());
        assertEq(-1, d.getCurrentConnectionId());
        hash<auto> st = d.wdState();
        assertTrue(st.cid >= 0, "the watchdog was armed for the published connection");
        assertEq(0, st.timer, "and canceled when the connect failed");
    }

    #! A reconnect forced for a connection that an explicit connect replaced while it waited is not made
    discordForcedReconnectNewerConnectionTest() {
        WdDiscord d({"url": "ws://localhost:" + ports.h1, "token": "x", "logger": logger});
        on_exit {
            d.releaseAll();
            delete d;
        }
        d.connect();
        int cid_a = d.getCurrentConnectionId();
        # an explicit connect holds the action and the client's lock in its handshake
        d.hold_handshake = True;
        Queue xq();
        background TestThreads::run(sub () {
            try {
                d.connect();
                xq.push("ok");
            } catch (hash<ExceptionInfo> ex) {
                xq.push(ex.err);
            }
        });
        assertEq("handshake-held", d.events.get(LifecycleWsClient::HandoffTimeout));
        # the heartbeat or a watchdog of connection A forces a reconnect, which waits for the connect
        d.triggerZombieForTest(cid_a);
        d.release_handshake.dec();
        assertEq("ok", xq.get(LifecycleWsClient::HandoffTimeout));
        int cid_b = d.getCurrentConnectionId();
        assertEq("reconnect:False", d.events.get(LifecycleWsClient::HandoffTimeout), "no reconnect is made");
        assertEq(cid_b, d.getCurrentConnectionId(), "the new connection is kept");
        assertTrue(d.isOpen());
        d.disconnect();
    }

    #! A reconnect forced for a connection that an explicit disconnect, ahead of it, closed is not made
    discordForcedReconnectAfterDisconnectTest() {
        WdDiscord d({"url": "ws://localhost:" + ports.h1, "token": "x", "logger": logger});
        on_exit {
            d.releaseAll();
            delete d;
        }
        d.connect();
        int cid_a = d.getCurrentConnectionId();
        # another thread holds the action without the lock
        d.holdActionInBackground();
        assertEq("action-held", d.events.get(LifecycleWsClient::HandoffTimeout));
        d.report_action_wait = True;
        # a disconnect waits for the action first, then the forced reconnect of connection A
        background TestThreads::run(sub () {
            try {
                d.disconnect();
                d.events.push("disconnected");
            } catch (hash<ExceptionInfo> ex) {
                d.events.push(ex.err);
            }
        });
        assertEq("action-wait", d.events.get(LifecycleWsClient::HandoffTimeout));
        d.triggerZombieForTest(cid_a);
        assertEq("action-wait", d.events.get(LifecycleWsClient::HandoffTimeout));
        d.report_action_wait = False;
        d.release_action.dec();
        getEvents(d.events, ("disconnected", "reconnect:False"));
        assertFalse(d.isOpen(), "the client stays disconnected");
        assertEq(-1, d.getCurrentConnectionId());
    }

    #! A HELLO watchdog timer whose callback runs after the watchdog was re-armed for a newer connection does nothing
    discordStaleHelloFireTest() {
        WdDiscord d({"url": "ws://localhost:" + ports.h1, "token": "x", "logger": logger});
        on_exit {
            d.releaseAll();
            delete d;
        }
        d.record_zombies_only = True;
        d.connect();
        int gen_a = d.wdState().gen;
        d.connect();
        hash<auto> st = d.wdState();
        assertTrue(st.gen != gen_a, "re-armed for the new connection");
        # the timer of connection A fired; its callback runs now
        d.fireHelloForTest(gen_a);
        assertEq(0, d.zombies.size(), "no reconnect is forced");
        hash<auto> st1 = d.wdState();
        assertEq(st.timer, st1.timer, "the new connection's watchdog stays armed");
        assertEq(d.getCurrentConnectionId(), st1.cid);
        # the current timer's callback acts
        d.fireHelloForTest(st.gen);
        assertEq(d.getCurrentConnectionId(), d.zombies.get(LifecycleWsClient::HandoffTimeout),
            "the current watchdog forces a reconnect of its connection");
        d.disconnect();
    }

    #! As discordStaleHelloFireTest() for the RESUME watchdog
    discordStaleResumeFireTest() {
        WdDiscord d({"url": "ws://localhost:" + ports.h1, "token": "x", "logger": logger});
        on_exit {
            d.releaseAll();
            delete d;
        }
        d.record_zombies_only = True;
        d.connect();
        int cid = d.getCurrentConnectionId();
        d.armResumeForTest(cid);
        int gen_a = d.resumeState().gen;
        d.armResumeForTest(cid);
        hash<auto> st = d.resumeState();
        assertTrue(st.gen != gen_a);
        d.fireResumeForTest(gen_a);
        assertEq(0, d.zombies.size(), "no reconnect is forced");
        assertEq(st.timer, d.resumeState().timer, "the watchdog stays armed");
        d.fireResumeForTest(st.gen);
        assertEq(cid, d.zombies.get(LifecycleWsClient::HandoffTimeout), "the current watchdog forces a reconnect");
        d.disconnect();
    }

    #! The RESUME watchdog is canceled by the events and the close of its own connection only
    discordResumeKeyedTest() {
        WdDiscord d({"url": "ws://localhost:" + ports.h1, "token": "x", "logger": logger});
        on_exit {
            d.releaseAll();
            delete d;
        }
        d.connect();
        int cid = d.getCurrentConnectionId();
        d.armResumeForTest(cid);
        d.cancelResumeForTest(cid + 1000);
        assertTrue(d.resumeState().timer != 0, "not canceled for another connection");
        assertEq(cid, d.resumeState().cid);
        d.cancelResumeForTest(cid);
        assertEq(0, d.resumeState().timer, "canceled for its connection");
        d.disconnect();
    }

    #! A heartbeat that detected a zombie connection whose reconnect is not made is cleared once its thread ended, so
    #! a new connection starts its own
    discordZombieHandoffFailsTest() {
        HbDiscord d({"url": "ws://localhost:" + ports.h1, "token": "x", "logger": logger});
        on_exit {
            d.releaseAll();
            delete d;
        }
        hash<auto> hdr = {"X-Discord": "1", "X-Hbi": "100"};
        d.force_zombie = True;
        d.fail_reconnect = True;
        d.connect({"hdr": hdr});
        int cid_a = d.getCurrentConnectionId();
        assertEq("hb-started:" + cid_a, d.events.get(LifecycleWsClient::HandoffTimeout));
        assertEq("handoff-failed", d.events.get(LifecycleWsClient::HandoffTimeout));
        assertEq(-1, d.hbState().cid, "the heartbeat record is cleared");
        assertNothing(d.getInfo().heartbeat_tid);
        d.connect({"hdr": hdr});
        assertEq("hb-started:" + d.getCurrentConnectionId(), d.events.get(LifecycleWsClient::HandoffTimeout),
            "the new connection starts its heartbeat");
        d.disconnect();
    }

    #! A Discord client raises EVENT_WS_CLOSED, and its gateway data provider its connection and disconnection
    #! events
    discordClosedEventTest() {
        WdDiscord d({"url": "ws://localhost:" + ports.h1, "token": "x", "logger": logger});
        on_exit {
            d.releaseAll();
        }
        EventRecorder client_events();
        d.registerObserver(client_events);
        DiscordGatewayDataProvider prov(d);
        on_exit delete prov;
        EventRecorder prov_events();
        prov.registerObserver(prov_events);
        # connects
        prov.observersReady();
        int cid = d.getCurrentConnectionId();
        assertTrue(cid >= 0);
        d.disconnect();
        hash<auto> info = prov.getInfo();
        hash<string, hash<auto>> seen = {};
        while (!seen{EVENT_WS_CLOSED}) {
            hash<auto> ev = client_events.q.get(LifecycleWsClient::HandoffTimeout);
            seen{ev.id} = ev.data;
        }
        assertEq(cid, seen{EVENT_WS_CLOSED}.cid, "EVENT_WS_CLOSED carries the closed connection's ID");
        assertEq(cid, seen{EVENT_WS_CONNECTED}.cid);
        list<string> prov_ids = ();
        while (prov_ids.size() < 2) {
            prov_ids += prov_events.q.get(LifecycleWsClient::HandoffTimeout).id;
        }
        assertEq((info.connection_event, info.disconnection_event), prov_ids,
            "the provider raises its connection and disconnection events");
    }

    #! A gateway data provider created from a client the caller keeps is destroyed when it goes out of scope: it
    #! disconnects the client and is no longer its observer
    discordProviderScopeTest() {
        WdDiscord d({"url": "ws://localhost:" + ports.h1, "token": "x", "logger": logger});
        on_exit {
            d.releaseAll();
            delete d;
        }
        d.connect();
        int before = d.observerCountForTest();
        Queue q();
        {
            TestGatewayProvider p(d, q);
            assertEq(before + 1, d.observerCountForTest(), "the provider observes the client");
        }
        assertEq(1, q.size(), "the provider was destroyed at the end of its scope");
        assertFalse(d.isOpen(), "its destructor disconnected the client");
        assertEq(before, d.observerCountForTest(), "it no longer observes the client");
    }

    #! A deleted gateway data provider is no longer an observer of the client, so later events do not reach it
    discordProviderDeleteTest() {
        WdDiscord d({"url": "ws://localhost:" + ports.h1, "token": "x", "logger": logger});
        on_exit {
            d.releaseAll();
            delete d;
        }
        int before = d.observerCountForTest();
        Queue q();
        TestGatewayProvider p(d, q);
        delete p;
        assertEq(1, q.size());
        assertEq(before, d.observerCountForTest(), "the deleted provider no longer observes the client");
        # events after the delete reach only the remaining observers
        EventRecorder rec();
        d.registerObserver(rec);
        d.connect();
        assertEq(EVENT_WS_CONNECTED, rec.q.get(LifecycleWsClient::HandoffTimeout).id);
        d.disconnect();
        assertEq(EVENT_WS_CLOSED, rec.q.get(LifecycleWsClient::HandoffTimeout).id);
    }

    #! Two gateway data providers on one client both get its events and both stop observing it
    discordTwoProvidersTest() {
        WdDiscord d({"url": "ws://localhost:" + ports.h1, "token": "x", "logger": logger});
        on_exit {
            d.releaseAll();
            delete d;
        }
        int before = d.observerCountForTest();
        Queue q();
        TestGatewayProvider p1(d, q);
        TestGatewayProvider p2(d, q);
        assertEq(before + 2, d.observerCountForTest());
        EventRecorder r1();
        EventRecorder r2();
        p1.registerObserver(r1);
        p2.registerObserver(r2);
        p1.observersReady();
        p2.observersReady();
        if (!d.isOpen()) {
            d.connect();
        }
        assertEq(EVENT_WS_CONNECTED, r1.q.get(LifecycleWsClient::HandoffTimeout).id);
        assertEq(EVENT_WS_CONNECTED, r2.q.get(LifecycleWsClient::HandoffTimeout).id);
        delete p1;
        assertEq(before + 1, d.observerCountForTest());
        delete p2;
        assertEq(before, d.observerCountForTest());
        assertEq(2, q.size());
    }

    #! The destructor waits for a forced reconnect that waits for the action, so the reconnect does not run on a
    #! destroyed client
    discordDestructorWaitsReconnectTest() {
        WdDiscord d({"url": "ws://localhost:" + ports.h1, "token": "x", "logger": logger});
        Queue events = d.events;
        Counter release_action = d.release_action;
        on_exit if (release_action.getCount()) {
            release_action.dec();
        }
        d.connect();
        int cid = d.getCurrentConnectionId();
        d.holdActionInBackground();
        assertEq("action-held", events.get(LifecycleWsClient::HandoffTimeout));
        d.report_action_wait = True;
        d.triggerZombieForTest(cid);
        assertEq("action-wait", events.get(LifecycleWsClient::HandoffTimeout));
        d.report_action_wait = False;
        Queue deleted();
        background TestThreads::run(sub () {
            delete d;
            deleted.push(True);
        });
        # the destructor ends the forced reconnect's action wait and waits for its thread
        getEvents(events, ("waiting-threads", "reconnect:WEBSOCKET-ERROR"));
        assertEq("threads-done", events.get(LifecycleWsClient::HandoffTimeout));
        assertTrue(deleted.get(LifecycleWsClient::HandoffTimeout), "then the client is destroyed");
        release_action.dec();
    }

    #! When the heartbeat thread releases the last reference to the client, the destructor runs on it and completes
    discordLastRefOnHeartbeatThreadTest() {
        HbDiscord d({"url": "ws://localhost:" + ports.h1, "token": "x", "logger": logger});
        Queue events = d.events;
        Queue lifecycle = d.lifecycle;
        Queue hb_tids = d.hb_tids;
        Counter release_hb = d.release_hb;
        on_exit if (release_hb.getCount()) {
            release_hb.dec();
        }
        d.block_hb = True;
        # no HELLO, so no delivery task holds a reference: the heartbeat is started directly
        d.connect();
        d.startHeartbeatForTest(100);
        assertEq("hb-started:" + d.getCurrentConnectionId(), events.get(LifecycleWsClient::HandoffTimeout));
        assertEq("hb-blocked", events.get(LifecycleWsClient::HandoffTimeout));
        int hb_tid = hb_tids.get(LifecycleWsClient::HandoffTimeout);
        # the heartbeat thread, held in its beat, now holds the only reference
        remove d;
        assertEq(0, lifecycle.size(), "not destroyed while the heartbeat thread beats");
        release_hb.dec();
        assertEq("destroyed:" + hb_tid, lifecycle.get(LifecycleWsClient::HandoffTimeout),
            "destroyed on the heartbeat thread");
        assertEq("waiting-threads", lifecycle.get(LifecycleWsClient::HandoffTimeout),
            "the destructor went on to the base class");
    }

    #! Dropping the last reference to a connected client whose heartbeat runs destroys it at once
    discordDropConnectedClientTest() {
        HbDiscord d({"url": "ws://localhost:" + ports.h1, "token": "x", "logger": logger});
        Queue events = d.events;
        Queue lifecycle = d.lifecycle;
        # no HELLO, so no delivery task holds a reference: the heartbeat is started directly
        d.connect();
        d.startHeartbeatForTest(45000);
        assertEq("hb-started:" + d.getCurrentConnectionId(), events.get(LifecycleWsClient::HandoffTimeout));
        remove d;
        # the heartbeat thread holds no reference while it waits: the client is destroyed here, at once
        assertEq("destroyed:" + gettid(), lifecycle.get(0ms), "destroyed here when the last reference was dropped");
    }

    #! EVENT_WS_CLOSED is raised also when a step of the Discord closing callback fails
    discordClosedOnStepErrorTest() {
        WdDiscord d({"url": "ws://localhost:" + ports.h1, "token": "x", "logger": logger});
        on_exit {
            d.releaseAll();
            delete d;
        }
        EventRecorder rec();
        d.registerObserver(rec);
        d.connect();
        assertEq(EVENT_WS_CONNECTED, rec.q.get(LifecycleWsClient::HandoffTimeout).id);
        d.fail_cancel_resume = True;
        d.disconnect();
        assertEq("cancel-resume-failed", d.events.get(LifecycleWsClient::HandoffTimeout),
            "a step of the closing callback failed");
        assertEq(EVENT_WS_CLOSED, rec.q.get(LifecycleWsClient::HandoffTimeout).id);
    }

    #! heartbeatHandoffFailed() called on the heartbeat thread does not wait for that thread
    discordHandoffOnHeartbeatThreadTest() {
        HbDiscord d({"url": "ws://localhost:" + ports.h1, "token": "x", "logger": logger});
        on_exit {
            d.releaseAll();
            delete d;
        }
        d.handoff_in_beat = True;
        d.connect({"hdr": {"X-Discord": "1", "X-Hbi": "100"}});
        assertEq("hb-started:" + d.getCurrentConnectionId(), d.events.get(LifecycleWsClient::HandoffTimeout));
        assertEq("handoff-failed", d.events.get(LifecycleWsClient::HandoffTimeout));
        assertEq("handoff-returned", d.events.get(LifecycleWsClient::HandoffTimeout));
        d.disconnect();
    }

    #! A heartbeat thread started with the start_thread option holds no reference to the client while it waits
    discordStartThreadHeartbeatDropTest() {
        HbDiscord d({"url": "ws://localhost:" + ports.h1, "token": "x", "logger": logger,
            "start_thread": int sub (code c) { return background TestThreads::run(c); }});
        Queue events = d.events;
        Queue lifecycle = d.lifecycle;
        d.connect();
        d.startHeartbeatForTest(45000);
        assertEq("hb-started:" + d.getCurrentConnectionId(), events.get(LifecycleWsClient::HandoffTimeout));
        remove d;
        assertEq("destroyed:" + gettid(), lifecycle.get(0ms), "destroyed here when the last reference was dropped");
    }

    #! The heartbeat thread detects a zombie, starts the forced reconnect and releases the last reference, so the
    #! destructor runs on it and waits for the forced reconnect, which does not wait for the heartbeat thread
    discordDestructorOnHeartbeatWithReconnectTest() {
        GatedStarter starter();
        HbDiscord d({"url": "ws://localhost:" + ports.h1, "token": "x", "logger": logger,
            "start_thread": \starter.start()});
        Queue events = d.events;
        Queue lifecycle = d.lifecycle;
        Counter release_zombie = d.release_zombie;
        on_exit {
            if (release_zombie.getCount()) {
                release_zombie.dec();
            }
            if (starter.pending) {
                starter.startPending();
            }
        }
        d.connect();
        d.hold_zombie = True;
        d.startHeartbeatForTest(100);
        assertEq("hb-started:" + d.getCurrentConnectionId(), events.get(LifecycleWsClient::HandoffTimeout));
        assertEq("zombie-held", events.get(LifecycleWsClient::HandoffTimeout));
        # the forced reconnect's thread runs only once the destructor waits for it
        starter.gate_next = True;
        # the heartbeat thread now holds the only reference
        remove d;
        release_zombie.dec();
        # the forced reconnect's code was handed to the hook, deferred
        starter.started.waitForZero(LifecycleWsClient::HandoffTimeout);
        string destroyed = lifecycle.get(LifecycleWsClient::HandoffTimeout);
        assertTrue(destroyed =~ /^destroyed:/, destroyed);
        assertEq("waiting-threads", lifecycle.get(LifecycleWsClient::HandoffTimeout));
        # the forced reconnect starts now, while the destructor runs on the heartbeat thread and waits for it
        starter.startPending();
        assertEq("handoff-failed", events.get(LifecycleWsClient::HandoffTimeout), "the forced reconnect ends");
        assertEq("threads-done", lifecycle.get(LifecycleWsClient::HandoffTimeout), "then the destructor goes on");
    }

    #! An explicit delete on another thread while the heartbeat thread reconnects on its own thread: the destructor
    #! waits for the heartbeat thread, which stops its own record in the reconnect, and does not detach it
    discordDeleteDuringInlineReconnectTest() {
        FailingStarter starter();
        InlineHoldDiscord d({"url": "ws://localhost:" + ports.h1, "token": "x", "logger": logger,
            "start_thread": \starter.start()});
        Queue events = d.events;
        Counter rel1 = d.release_inline;
        Counter rel2 = d.release_after_stop;
        on_exit {
            map $1.getCount() ? $1.dec() : NOTHING, (rel1, rel2);
        }
        d.connect();
        d.force_zombie = True;
        starter.ok_starts = 1;
        d.hold_inline = True;
        d.startHeartbeatForTest(100);
        assertEq("hb-started:" + d.getCurrentConnectionId(), events.get(LifecycleWsClient::HandoffTimeout));
        DiscordHeartbeat rec = d.hbRecordForTest();
        # the heartbeat thread found the zombie, could not start the reconnect's thread and reconnects itself
        assertEq("inline-held", events.get(LifecycleWsClient::HandoffTimeout));
        Queue deleted();
        background TestThreads::run(sub () {
            delete d;
            deleted.push({"ended": rec.ended, "detached": rec.detached});
        });
        # the destructor (on another thread) stops the heartbeat and waits for its thread
        assertEq("waiting:hello", events.get(LifecycleWsClient::HandoffTimeout));
        rel1.dec();
        # the heartbeat thread stops its own record (closing callback of its reconnect) and is held after
        assertEq("after-stop-held", events.get(LifecycleWsClient::HandoffTimeout));
        rel2.dec();
        hash<auto> r = deleted.get(LifecycleWsClient::HandoffTimeout);
        assertTrue(r.ended, "the destructor returns only once the heartbeat thread has ended");
        assertFalse(r.detached, "the record is not detached: the destructor does not run on its thread");
    }

    #! The heartbeat thread reconnects itself and stops its own record first; an explicit delete on another thread
    #! then waits for the heartbeat thread to end
    discordDeleteAfterInlineStopTest() {
        FailingStarter starter();
        InlineHoldDiscord d({"url": "ws://localhost:" + ports.h1, "token": "x", "logger": logger,
            "start_thread": \starter.start()});
        Queue events = d.events;
        Counter rel1 = d.release_inline;
        Counter rel2 = d.release_after_stop;
        on_exit {
            map $1.getCount() ? $1.dec() : NOTHING, (rel1, rel2);
        }
        d.connect();
        d.force_zombie = True;
        starter.ok_starts = 1;
        d.hold_inline = True;
        d.startHeartbeatForTest(100);
        assertEq("hb-started:" + d.getCurrentConnectionId(), events.get(LifecycleWsClient::HandoffTimeout));
        DiscordHeartbeat rec = d.hbRecordForTest();
        assertEq("inline-held", events.get(LifecycleWsClient::HandoffTimeout));
        rel1.dec();
        # the heartbeat thread stopped its own record and is held after
        assertEq("after-stop-held", events.get(LifecycleWsClient::HandoffTimeout));
        Queue deleted();
        background TestThreads::run(sub () {
            delete d;
            deleted.push({"ended": rec.ended, "detached": rec.detached});
        });
        # the record is still the client's: the destructor waits for its thread
        assertEq("waiting:hello", events.get(LifecycleWsClient::HandoffTimeout));
        rel2.dec();
        hash<auto> r = deleted.get(LifecycleWsClient::HandoffTimeout);
        assertTrue(r.ended, "the destructor returns only once the heartbeat thread has ended");
        assertFalse(r.detached, "the record is not detached: the destructor does not run on its thread");
    }

    #! A start_thread hook that returns without running the code it was given: the destructor does not wait for a
    #! thread that will never run it
    discordDroppedStartTest() {
        Queue dropped();
        WdDiscord d({"url": "ws://localhost:" + ports.h1, "token": "x", "logger": logger,
            "start_thread": int sub (code c) { dropped.push(True); return 0; }});
        d.connect();
        d.triggerZombieForTest(d.getCurrentConnectionId());
        assertTrue(dropped.get(LifecycleWsClient::HandoffTimeout), "the forced reconnect's code was dropped");
        Queue deleted();
        background TestThreads::run(sub () {
            delete d;
            deleted.push(True);
        });
        assertTrue(deleted.get(LifecycleWsClient::HandoffTimeout), "the client is destroyed");
    }

    #! The heartbeat thread releases the last reference while the forced reconnect's code is deferred by the hook;
    #! the hook's thread then ends without running it: the destructor, on the heartbeat thread, does not wait for it
    discordDestructorOnHeartbeatDroppedReconnectTest() {
        GatedStarter starter();
        HbDiscord d({"url": "ws://localhost:" + ports.h1, "token": "x", "logger": logger,
            "start_thread": \starter.start()});
        Queue events = d.events;
        Queue lifecycle = d.lifecycle;
        Counter release_zombie = d.release_zombie;
        on_exit {
            if (release_zombie.getCount()) {
                release_zombie.dec();
            }
            starter.dropPending();
        }
        d.connect();
        d.hold_zombie = True;
        d.startHeartbeatForTest(100);
        assertEq("hb-started:" + d.getCurrentConnectionId(), events.get(LifecycleWsClient::HandoffTimeout));
        assertEq("zombie-held", events.get(LifecycleWsClient::HandoffTimeout));
        starter.gate_next = True;
        # the heartbeat thread now holds the only reference
        remove d;
        release_zombie.dec();
        starter.started.waitForZero(LifecycleWsClient::HandoffTimeout);
        string destroyed = lifecycle.get(LifecycleWsClient::HandoffTimeout);
        assertTrue(destroyed =~ /^destroyed:/, destroyed);
        assertEq("waiting-threads", lifecycle.get(LifecycleWsClient::HandoffTimeout));
        # the destructor waits for the deferred start; the hook's thread ends without running the code
        assertEq(0, lifecycle.size(), "the destructor waits while the code may still run");
        starter.dropPending();
        assertEq("threads-done", lifecycle.get(LifecycleWsClient::HandoffTimeout), "then the destructor goes on");
    }

    #! A step of the closing callback that fails does not keep the heartbeat from being stopped
    discordClosingStepsGuardedTest() {
        HbDiscord d({"url": "ws://localhost:" + ports.h1, "token": "x", "logger": logger});
        on_exit {
            d.releaseAll();
            delete d;
        }
        d.connect();
        d.startHeartbeatForTest(45000);
        assertEq("hb-started:" + d.getCurrentConnectionId(), d.events.get(LifecycleWsClient::HandoffTimeout));
        d.fail_cancel_hello = True;
        d.report_closing_done = True;
        # the server closes the connection: the closing callback stops the heartbeat (an explicit disconnect would
        # stop it before)
        d.send("bye");
        list<string> evs = ();
        while (True) {
            string ev = d.events.get(LifecycleWsClient::HandoffTimeout);
            if (ev =~ /^waiting:/) {
                continue;
            }
            evs += ev;
            if (ev == "closing-done") {
                break;
            }
        }
        assertEq(("cancel-hello-failed", "closing-done"), evs);
        assertEq(-1, d.hbState().cid, "the heartbeat was stopped");
    }

    #! WscLibraryThreads counts each start once and records nested starts on one thread
    libraryThreadAccountingTest() {
        # a start_thread hook running the code inline, nested on a library thread
        WscLibraryThreads lt();
        int t1 = lt.starting();
        lt.enter(t1);
        int t2 = lt.starting();
        lt.enter(t2);
        lt.leave(t2);
        assertFalse(lt.hasOthers(), "the outer start still runs on this thread");
        assertEq(1, lt.getCount());
        lt.leave(t1);
        assertEq(0, lt.getCount());

        # a hook that started the thread and then threw: the start is uncounted once
        Counter entered(1);
        Counter go(1);
        Counter left(1);
        int t3 = lt.starting();
        background TestThreads::run(sub () {
            lt.enter(t3);
            entered.dec();
            go.waitForZero(LifecycleWsClient::HandoffTimeout);
            lt.leave(t3);
            left.dec();
        });
        entered.waitForZero(LifecycleWsClient::HandoffTimeout);
        lt.startFailed(t3);
        assertTrue(lt.hasOthers(), "the thread that started is still counted");
        go.dec();
        left.waitForZero(LifecycleWsClient::HandoffTimeout);
        assertEq(0, lt.getCount(), "uncounted once");

        # the failure is reported before the thread ran: the thread is never counted again
        int t4 = lt.starting();
        lt.startFailed(t4);
        assertEq(0, lt.getCount());
        lt.enter(t4);
        assertEq(0, lt.getCount(), "not counted again when it runs");
        assertFalse(lt.hasOthers());
        lt.leave(t4);
        assertEq(0, lt.getCount(), "the count never goes below zero");
        assertEq(0, lt.getFailedCount(), "the failed start is forgotten once its thread ended");

        # a failed start whose code is released without being run is forgotten
        int t7 = lt.starting();
        {
            WscStartTicket ticket(lt, t7);
            lt.startFailed(t7);
            assertEq(1, lt.getFailedCount());
        }
        assertEq(0, lt.getFailedCount(), "the failed start is forgotten once its code was released");
        assertEq(0, lt.getCount());

        # the code of a start is released without being run: the start is uncounted, the ticket keeps it counted
        # until then
        int t5 = lt.starting();
        {
            WscStartTicket ticket(lt, t5);
            assertTrue(lt.hasOthers(), "counted while its code exists");
        }
        assertEq(0, lt.getCount(), "uncounted when its code is released unrun");
        assertFalse(lt.hasOthers());
        # a start whose code ran is not uncounted by the release of the code
        int t6 = lt.starting();
        {
            WscStartTicket ticket(lt, t6);
            ticket.enter();
        }
        assertEq(1, lt.getCount(), "a start that ran is counted until it leaves");
        lt.leave(t6);
        assertEq(0, lt.getCount());

        # closed: no start
        lt.close();
        assertThrows("WEBSOCKET-ERROR", \lt.starting());
    }

    #! A delivery callback that calls connectAsync() while the destructor waits for it starts no thread
    noLibraryThreadOnDestroyTest() {
        LifecycleCtx ctx = makeCtx("h1");
        connectChecked(ctx, "h1");
        LifecycleWsClient c = ctx.wsc;
        Counter go(1);
        Queue res();
        Queue cb_in();
        on_exit if (go.getCount()) {
            go.dec();
        }
        ctx.on_msg = sub (*data msg) {
            if (msg == "ECHO:hold") {
                cb_in.push(True);
                go.waitForZero(LifecycleWsClient::HandoffTimeout);
                try {
                    c.connectAsync();
                    res.push("started");
                } catch (hash<ExceptionInfo> ex) {
                    res.push(ex.err);
                }
            }
        };
        c.send("hold");
        assertTrue(cb_in.get(LifecycleWsClient::HandoffTimeout));
        Queue events = c.events;
        remove ctx.wsc;
        # deleted through another variable: the callback keeps its own
        LifecycleWsClient dc = c;
        Queue deleted();
        background TestThreads::run(sub () {
            delete dc;
            deleted.push(True);
        });
        assertEq("waiting-threads", events.get(LifecycleWsClient::HandoffTimeout));
        go.dec();
        assertEq("WEBSOCKET-ERROR", res.get(LifecycleWsClient::HandoffTimeout), "no thread is started");
        assertTrue(deleted.get(LifecycleWsClient::HandoffTimeout));
    }

    #! A thread waiting for an action stops waiting when the client is destroyed
    actionWaitEndsOnDestroyTest() {
        LifecycleCtx ctx = makeCtx("h1");
        connectChecked(ctx, "h1");
        LifecycleWsClient c = remove ctx.wsc;
        Queue events = c.events;
        Counter release_action = c.release_action;
        on_exit if (release_action.getCount()) {
            release_action.dec();
        }
        c.holdActionInBackground();
        assertEq("action-held", events.get(LifecycleWsClient::HandoffTimeout));
        c.report_action_wait = True;
        Queue res();
        background TestThreads::run(sub () {
            try {
                c.reconnect();
                res.push("reconnected");
            } catch (hash<ExceptionInfo> ex) {
                res.push(ex.err);
            }
        });
        assertEq("action-wait", events.get(LifecycleWsClient::HandoffTimeout));
        Queue deleted();
        background TestThreads::run(sub () {
            delete c;
            deleted.push(True);
        });
        assertEq("WEBSOCKET-ERROR", res.get(LifecycleWsClient::HandoffTimeout), "the action wait ended");
        assertTrue(deleted.get(LifecycleWsClient::HandoffTimeout));
        release_action.dec();
    }

    #! A connectAsync() worker waiting for the handshake response of a silent server is canceled by the destructor
    handshakeCanceledOnDestroyTest() {
        Socket srv();
        srv.bindINET("localhost", "0");
        srv.listen();
        int port = srv.getSocketInfo().port;
        Queue server_events();
        Counter server_done(1);
        on_exit {
            if (server_done.getCount()) {
                server_done.dec();
            }
        }
        background TestThreads::run(sub () {
            *Socket s = srv.accept(LifecycleWsClient::HandoffTimeout);
            if (!s) {
                server_events.push("no-connection");
                return;
            }
            # the request is read, and never answered
            string req = "";
            while (req !~ /\r\n\r\n/) {
                req += s.recv(-1, LifecycleWsClient::HandoffTimeout);
            }
            server_events.push("request");
            server_done.waitForZero(LifecycleWsClient::HandoffTimeout * 2);
        });
        LifecycleWsClient c(sub (*data msg) {}, {"url": "ws://localhost:" + port, "logger": logger,
            "timeout": LifecycleWsClient::HandoffTimeout * 4, "connect_timeout": LifecycleWsClient::HandoffTimeout * 4});
        Queue ready();
        c.connectAsync(NOTHING, ready);
        assertEq("request", server_events.get(LifecycleWsClient::HandoffTimeout));
        Queue deleted();
        background TestThreads::run(sub () {
            delete c;
            deleted.push(True);
        });
        assertTrue(deleted.get(LifecycleWsClient::HandoffTimeout), "destroyed without waiting for the response");
        auto r = ready.get(LifecycleWsClient::HandoffTimeout);
        assertEq("WEBSOCKET-ERROR", r.error.err, "the worker's handshake was canceled");
    }
}

#! A client with serialization whose connect report waits until the connection was reported closed
class OrderWsClient inherits WebSocketClientWithSerialization {
    public {
        #! released when the connection was reported closed
        Counter closed_seen(1);
        #! hold the connect report until the close was reported
        bool hold_open = False;
        #! gets "opened-start" when the connect report starts
        *Queue order;
    }

    constructor(hash<auto> opts) : WebSocketClientWithSerialization(opts) {
    }

    private closingConnection() {
        WebSocketClientWithSerialization::closingConnection();
        if (closed_seen.getCount()) {
            closed_seen.dec();
        }
    }

    private connectionOpened(hash<auto> info) {
        if (hold_open) {
            hold_open = False;
            order.push("opened-start");
            # the server closes the connection; the close is reported without waiting for this report
            send("bye");
            closed_seen.waitForZero(LifecycleWsClient::HandoffTimeout);
        }
        WebSocketClientWithSerialization::connectionOpened(info);
    }
}

#! Records the events of a client
class OrderObserver inherits DataProvider::Observer {
    public {
        Queue events();
        Queue full();
        *OrderWsClient client;
    }

    update(string event_id, hash<auto> data_) {
        events.push(event_id);
        full.push({"id": event_id, "data": data_});
    }
}

#! Sends a message when the connection is reported open and waits for the reply
class ReplyObserver inherits DataProvider::Observer {
    public {
        Queue reply();
        WebSocketClientWithSerialization client;
        Queue data();
    }

    constructor(WebSocketClientWithSerialization client) {
        self.client = client;
    }

    update(string event_id, hash<auto> data_) {
        if (event_id == EVENT_WS_DATA) {
            data.push(data_.data);
            return;
        }
        if (event_id == EVENT_WS_CONNECTED) {
            client.send("in-connected");
            try {
                reply.push(data.get(5s));
            } catch (hash<ExceptionInfo> ex) {
                reply.push(ex.err);
            }
        }
    }
}

