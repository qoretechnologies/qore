-----END PRIVATE KEY-----";
    }

    constructor() : Test("WebSocketClientConnectNotTunnelTest", "1.0") {
        addTestCase("HTTP/2: a CONNECT answered with a 200 that ends the stream fails the handshake",
            sub () { testH2("2.0"); });
        addTestCase("HTTP/2 auto mode: the HTTP/1.1 Upgrade fallback is tried", sub () { testH2("auto"); });
        addTestCase("HTTP/3: a refused CONNECT reports the server's status", sub () { testH3("3.0"); });
        addTestCase("HTTP/3 auto mode: the HTTP/1.1 Upgrade fallback is tried", sub () { testH3("auto"); });
        set_return_value(main());
    }

    globalSetUp() {
        logger = new Logger("ws-connect-not-tunnel-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }
    }

    #! returns the error that connecting raises; a client that connected is a failure
    private string connectError(WebSocketClient wsc, string label) {
        on_exit {
            try {
                wsc.disconnect();
            } catch () {
            }
        }
        try {
            wsc.connect();
        } catch (hash<ExceptionInfo> ex) {
            assertFalse(wsc.isOpen(), label + ": the client is not connected");
            return sprintf("%s: %s", ex.err, ex.desc);
        }
        fail(label + ": the client reported the connection as connected");
    }

    private WebSocketClient getClient(string url, string http_version) {
        return new WebSocketClient(sub (*data msg) {}, {
            "url": url,
            "logger": logger,
            "http_version": http_version,
            "ssl_verify_cert": False,
            "timeout": 10s,
            "connect_timeout": 10s,
        });
    }

    #! a server (node) that answers an HTTP/2 extended CONNECT with a 200 response that ends the stream
    private testH2(string http_version) {
%ifdef NoProcess
        testSkip("the process module is not available");
%else
        string node_bin = ENV.NODE_BIN ?? "node";
        if (system(node_bin + " -v > /dev/null 2>&1")) {
            testSkip("node is not available");
        }
        TmpDir dir("ws-connect-not-tunnel-");
        string cert = dir.path + "/cert.pem";
        string key = dir.path + "/key.pem";
        File f();
        f.open2(cert, O_CREAT | O_TRUNC | O_WRONLY);
        f.write(CertPem);
        f.close();
        f.open2(key, O_CREAT | O_TRUNC | O_WRONLY);
        f.write(KeyPem);
        f.close();
        # the server ends the stream in the HEADERS frame of its 200 response, so that the end of the stream arrives with
        # the status: a 200 whose end of stream arrives in a later frame cannot be told apart from a tunnel that the
        # server accepted and closed at once, which the client reports as connected and then closed
        Process p(node_bin, (get_script_dir() + "/http2-plain-200-server.js", cert, key, "headers-only"));
        on_exit {
            if (p.running()) {
                p.terminate();
            }
            p.wait();
        }
        string line = "";
        while (line !~ /\n/) {
            *string s = p.readStdout(1024, 60s);
            if (!exists s) {
                throw "TEST-ERROR", sprintf("the node server did not start: %s", p.readStderr(4096, 0) ?? "");
            }
            line += s;
        }
        *string port = (line =~ x/READY ([0-9]+)/)[0];
        assertTrue(exists port, "the node server reported its port: " + line);
        string err = connectError(getClient("wss://127.0.0.1:" + port + "/ws", http_version), http_version);
        if (http_version == "auto") {
            # the HTTP/1.1 Upgrade gets the page: its status is the server's real answer
            assertRegex("^WEBSOCKET-ERROR: .*returned status code '200'.*expecting", err, "auto: the fallback's answer");
        } else {
            assertRegex("^WEBSOCKET-ERROR: HTTP/2 .*accepted the WebSocket CONNECT request but (ended the stream|the "
                "stream is closed)", err, "2.0: the closed stream fails the handshake");
        }
%endif
    }

    #! HttpServer, which refuses an HTTP/3 extended CONNECT to a handler that is not a socket handler (#5667)
    private testH3(string http_version) {
        HttpServer server(<HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        });
        on_exit {
            server.stop();
        }
        server.setHandler("plain", "", NOTHING, new PlainPageHandler());
        server.setDefaultHandler("plain", new PlainPageHandler());
        server.waitForAsyncIo();
        hash<auto> info = server.addListener(<HttpListenerOptionInfo>{
            "node": "127.0.0.1",
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
            "enable_h3": True,
        });
        server.waitForAsyncIo();
        string err = connectError(getClient("wss://127.0.0.1:" + info.port + "/ws", http_version), http_version);
        if (http_version == "auto") {
            assertRegex("^WEBSOCKET-ERROR: .*returned status code '200'.*expecting", err, "auto: the fallback's answer");
        } else {
            assertRegex("^WEBSOCKET-ERROR: HTTP/3 .*returned status code '501'", err, "3.0: the refusal is reported");
        }
    }
}
