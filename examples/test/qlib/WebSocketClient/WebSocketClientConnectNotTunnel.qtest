-----END PRIVATE KEY-----";
    }

    constructor() : Test("WebSocketClientConnectNotTunnelTest", "1.0") {
        logger = new Logger("ws-connect-not-tunnel-test", LoggerLevel::getLevelInfo());
        logger.addAppender(log_capture);
        addTestCase("HTTP/2: a 200 with a body and the end of the stream fails the handshake",
            sub () { testNoRefusal("2.0"); });
        addTestCase("HTTP/3: a 200 with a body and the end of the stream fails the handshake",
            sub () { testNoRefusal("3.0"); });
        addTestCase("HTTP/2 or HTTP/3 auto mode: the HTTP/1.1 Upgrade fallback is tried",
            sub () { testNoRefusal("auto"); });
        addTestCase("HTTP/3: a refused CONNECT reports the server's status", \testH3Refused());
        addTestCase("HTTP/2: a 200 that ends the stream in its HEADERS frame fails the handshake", \testH2HeadersOnly());
        addTestCase("HTTP/2: a 202 response accepts the connection", \testH2Status202());
        set_return_value(main());
    }

    globalSetUp() {
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }
    }

    #! connects and returns the error raised; asserts that no connection was reported
    private string connectError(WebSocketClient wsc, string label) {
        on_exit {
            try {
                wsc.disconnect();
            } catch () {
            }
        }
        log_capture.takeMessages();
        string err;
        try {
            wsc.connect();
            err = "connected";
        } catch (hash<ExceptionInfo> ex) {
            err = sprintf("%s: %s", ex.err, ex.desc);
        }
        assertFalse(wsc.isOpen(), label + ": the client is not connected");
        list<string> connected = select log_capture.takeMessages(), $1 =~ /^Connected to /;
        assertEq((), connected, label + ": no connection is reported");
        return err;
    }

    private WebSocketClient getClient(string url, string http_version, *code cb) {
        return new WebSocketClient(cb ?? sub (*data msg) {}, {
            "url": url,
            "logger": logger,
            "http_version": http_version,
            "ssl_verify_cert": False,
            "timeout": 10s,
            "connect_timeout": 10s,
        });
    }

    #! returns an HttpServer serving a page for every path, with a TLS listener with HTTP/3 enabled
    private hash<auto> startServer(bool no_refusal) {
        hash<HttpServerOptionInfo> opts({"logger": logger, "debug": True});
        HttpServer server = no_refusal ? new NoRefusalHttpServer(opts) : new HttpServer(opts);
        server.setHandler("plain", "", NOTHING, new PlainPageHandler());
        server.setDefaultHandler("plain", new PlainPageHandler());
        server.waitForAsyncIo();
        hash<auto> info = server.addListener(<HttpListenerOptionInfo>{
            "node": "127.0.0.1",
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
            "enable_h3": True,
        });
        server.waitForAsyncIo();
        return {"server": server, "port": info.port};
    }

    #! a server that answers the extended CONNECT with its page (200, the body and the end of the stream together)
    private testNoRefusal(string http_version) {
        hash<auto> setup = startServer(True);
        HttpServer server = setup.server;
        on_exit {
            server.stop();
        }
        string err = connectError(getClient("wss://127.0.0.1:" + setup.port + "/ws", http_version), http_version);
        if (http_version == "auto") {
            # the HTTP/1.1 Upgrade gets the page: its status is the server's real answer
            assertRegex("^WEBSOCKET-ERROR: HTTP server at URL .* returned status code '200' to our WebSocket request; "
                "expecting '101", err, "auto: the fallback's answer");
        } else {
            # HTTP/3 delivers the response with the end of the stream (the stream is done when it is read); on HTTP/2
            # the end of the stream is processed before the stream state shows it, and installing the frame state
            # fails
            string expected = http_version == "3.0"
                ? "^WEBSOCKET-ERROR: HTTP/3 server at URL .* accepted the WebSocket CONNECT request but ended the "
                    "stream with its response"
                : "^WEBSOCKET-ERROR: HTTP/2 server at URL .* accepted the WebSocket CONNECT request but the stream is "
                    "closed";
            assertRegex(expected, err, http_version + ": the ended stream fails the handshake");
        }
    }

    #! HttpServer refuses an HTTP/3 extended CONNECT to a handler that is not a socket handler (#5667)
    private testH3Refused() {
        hash<auto> setup = startServer(False);
        HttpServer server = setup.server;
        on_exit {
            server.stop();
        }
        string err = connectError(getClient("wss://127.0.0.1:" + setup.port + "/ws", "3.0"), "3.0");
        assertRegex("^WEBSOCKET-ERROR: HTTP/3 .* returned status code '501'", err, "3.0: the refusal is reported");
    }

%ifdef NoProcess
    private testH2HeadersOnly() {
        testSkip("the process module is not available");
    }

    private testH2Status202() {
        testSkip("the process module is not available");
    }
%else
    #! returns the node binary, or skips the test if node cannot serve RFC 8441 extended CONNECT
    private string getNode() {
        string node_bin = ENV.NODE_BIN ?? "node";
        if (system(node_bin + " -e \"process.exit(require('http2').constants.NGHTTP2_SETTINGS_ENABLE_CONNECT_PROTOCOL "
                "? 0 : 1)\" > /dev/null 2>&1")) {
            testSkip("node with RFC 8441 extended CONNECT support is not available");
        }
        return node_bin;
    }

    #! writes the test certificate and key to the directory
    private writeCert(TmpDir dir) {
        foreach hash<auto> i in ({"cert.pem": CertPem, "key.pem": KeyPem}.pairIterator()) {
            File f();
            f.open2(dir.path + "/" + i.key, O_CREAT | O_TRUNC | O_WRONLY);
            f.write(i.value);
            f.close();
        }
    }

    #! starts a node server script and returns the process and the port from its READY line
    private hash<auto> startNode(string node_bin, list<string> args, *hash<string, string> env) {
        Process p(node_bin, args, env ? {"env": Process::getEnvironment() + env} : NOTHING);
        on_error {
            if (p.running()) {
                p.terminate();
            }
            p.wait();
        }
        string line = "";
        while (line !~ /\n/) {
            *string s = p.readStdout(1024, 60s);
            if (!exists s) {
                throw "TEST-ERROR", sprintf("the node server did not start: %s", p.readStderr(4096, 0) ?? "");
            }
            line += s;
        }
        *string port = (line =~ x/READY ([0-9]+)/)[0];
        if (!exists port) {
            throw "TEST-ERROR", "the node server reported no port: " + line;
        }
        return {"process": p, "port": port};
    }

    private stopNode(Process p) {
        if (p.running()) {
            p.terminate();
        }
        p.wait();
    }

    #! a server (node) that answers the extended CONNECT with a 200 response that ends the stream in its HEADERS frame
    private testH2HeadersOnly() {
        string node_bin = getNode();
        TmpDir dir("ws-connect-not-tunnel-");
        writeCert(dir);
        hash<auto> h = startNode(node_bin, (get_script_dir() + "/http2-plain-200-server.js", dir.path + "/cert.pem",
            dir.path + "/key.pem", "headers-only"));
        on_exit stopNode(h.process);
        string err = connectError(getClient("wss://127.0.0.1:" + h.port + "/ws", "2.0"), "2.0");
        assertRegex("^WEBSOCKET-ERROR: HTTP/2 server at URL .* accepted the WebSocket CONNECT request but ended the "
            "stream with its response", err, "2.0: the ended stream fails the handshake");
    }

    #! a WebSocket server (node) that accepts the extended CONNECT with 202: any 2xx status establishes the tunnel
    private testH2Status202() {
        string node_bin = getNode();
        TmpDir dir("ws-connect-not-tunnel-");
        writeCert(dir);
        hash<auto> h = startNode(node_bin, (get_script_dir() + "/http2-ws-server.js", "0", dir.path + "/cert.pem",
            dir.path + "/key.pem"), {"WS_CONNECT_STATUS": "202"});
        on_exit stopNode(h.process);
        Queue q();
        WebSocketClient wsc = getClient("wss://127.0.0.1:" + h.port + "/ws", "2.0", sub (*data msg) {
            if (exists msg) {
                q.push(msg);
            }
        });
        on_exit {
            try {
                wsc.disconnect();
            } catch () {
            }
        }
        wsc.connect();
        assertTrue(wsc.isHttp2(), "the connection uses HTTP/2");
        wsc.send("hello");
        assertEq("hello", q.get(10s), "the tunnel carries messages");
    }
%endif
}
