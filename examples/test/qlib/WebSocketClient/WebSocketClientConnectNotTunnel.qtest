%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Mime
%requires Logger
%requires FsUtil
%requires HttpServerUtil
%requires AsyncSocketIo
%requires HttpServerAsyncIo
%requires HttpServer
%requires HttpClientIo
%requires WebSocketUtil
%requires WebSocketClient

%try-module process >= 2.2
%define NoProcess
%endtry

%exec-class WebSocketClientConnectNotTunnelTest

#! a handler that is not a socket handler and answers every request with a page, as a catch-all web UI handler does
class PlainPageHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(HttpListenerInterface listener, Socket s, hash<auto> cx, hash<auto> hdr,
            *data body) {
        return <HttpResponseInfo>{
            "code": 200,
            "body": "<html><body>index</body></html>",
            "hdr": {"Content-Type": MimeTypeHtml},
        };
    }
}

#! a server that sends a handler's ordinary 2xx response to an extended CONNECT as it is (headers, body and the end of
#! the stream together), as a server without the check of issue #5667 does
class NoRefusalHttpServer inherits HttpServer {
    constructor(hash<HttpServerOptionInfo> opts) : HttpServer(opts) {
    }

    private bool refuseNonTunnelExtendedConnectResponse(hash<auto> cx, hash<auto> hdr, hash<auto> rv) {
        return False;
    }
}

#! keeps the messages that the client logs
class LogCapture inherits LoggerAppenderWithLayout {
    private {
        list<string> messages = ();
        Mutex lck();
    }

    constructor() : LoggerAppenderWithLayout("capture", new LoggerLayoutPattern("%m")) {
        open();
    }

    processEventImpl(int type, auto params) {
        if (type == EVENT_LOG) {
            AutoLock al(lck);
            messages += params;
        }
    }

    #! returns the messages logged since the last call and clears them
    list<string> takeMessages() {
        AutoLock al(lck);
        on_exit messages = ();
        return messages;
    }
}

#! issue #5668: a WebSocket client does not report an HTTP/2 or HTTP/3 CONNECT that the server did not tunnel as connected
/** The client accepted an extended CONNECT on a 200 status alone, reported the connection as connected and failed
    later (\c HTTPCLIENT-STREAM-CLOSED: cannot install frame state) when the server had answered with a page and the
    end of the stream; in "auto" mode the documented HTTP/1.1 fallback was not tried, as the failure came after the
    handshake.  An HTTP/3 refusal whose headers, body and end of stream arrived together was reported as "no response
    received", and only the status 200 accepted a connection, where any 2xx status establishes the tunnel.
*/
