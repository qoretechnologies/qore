#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires DataProvider
%requires ConnectionProvider
%requires Logger
%requires HttpServerUtil
%requires HttpServerAsyncIo
%requires HttpServer
%requires WebSocketUtil
%requires WebSocketHandler
%requires WebSocketClient
%requires AsyncSocketIo

#! The bound on a blocking wait for a message or a state event: a hang guard only, never a timing assertion
const HangGuard = 60s;

%exec-class WebSocketClientPollOperationTest

#! WebSocket connection that echoes messages back
class EchoWsConnection inherits WebSocketConnection {
    constructor(WebSocketHandler handler) : WebSocketConnection(handler) {
    }

    gotMessage(string msg) {
        send("ECHO:" + msg);
    }

    gotMessage(binary msg) {
        send(msg);
    }
}

class EchoWsHandler inherits WebSocketHandler {
    WebSocketConnection getConnectionImpl(hash<auto> cx, hash<auto> hdr, string cid) {
        return new EchoWsConnection(self);
    }
}

#! A WebSocket server for one connection, whose side of the close handshake the test chooses
/** The server accepts one connection, answers its upgrade request, and then:
    - \c "answer": answers the client's close frame with its own code and reason
    - \c "silent": never answers the client's close frame; it reads on until the client closes the connection
    - \c "initiate": starts the close handshake itself with its code and reason, and reads the client's answer

    A code of 0 sends a close frame without a status code.

    The frames it received are reported when the connection ends.
*/
class RawWsServer {
    public {
        #! the port of the server
        int port;
    }

    private {
        Socket listener();
        string mode;
        int code;
        string reason;
        #! gets the list of the frames the server received, or the exception that ended it
        Queue result();
    }

    constructor(string mode, int code = 0, string reason = "") {
        self.mode = mode;
        self.code = code;
        self.reason = reason;
        listener.bindINET("127.0.0.1", "0");
        listener.listen();
        port = listener.getSocketInfo().port;
        background serve();
    }

    #! Returns the server's close frame: one without a status code if the code is 0
    private binary closeFrame() {
        return ws_encode_message(code ? code.encodeMsb(2) + reason.toBinary() : binary(), WSOP_Close);
    }

    #! Returns the frames the server received once the connection has ended
    list<hash<WsMsgInfo>> getFrames() {
        auto r = result.get(HangGuard);
        if (r.typeCode() == NT_HASH && r.err) {
            throw r.err, r.desc;
        }
        return r;
    }

    private serve() {
        list<hash<WsMsgInfo>> frames = ();
        try {
            *Socket s = listener.accept(HangGuard);
            if (!s) {
                throw "RAW-SERVER-ERROR", "no connection";
            }
            listener.close();
            hash<auto> hdr = s.readHTTPHeader(HangGuard);
            s.send(sprintf("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
                "Sec-WebSocket-Accept: %s\r\n\r\n", ws_get_response_key(hdr."sec-websocket-key")));
            if (mode == "initiate") {
                s.send(closeFrame());
            }
            bool answered;
            while (True) {
                hash<WsMsgInfo> frame;
                try {
                    frame = ws_read_message(s, HangGuard);
                } catch (hash<ExceptionInfo> ex) {
                    # the client closed the connection
                    break;
                }
                frames += frame;
                if (frame.op == WSOP_Close && mode == "answer" && !answered) {
                    answered = True;
                    s.send(closeFrame());
                }
            }
            s.close();
            result.push(frames);
        } catch (hash<ExceptionInfo> ex) {
            result.push({"err": ex.err, "desc": ex.desc});
        }
    }
}

public class WebSocketClientPollOperationTest inherits QUnit::Test {
    private {
        HttpServer m_server;
        EchoWsHandler ws_handler();
        hash<auto> linfo;
        Logger logger;
    }

    constructor() : Test("WebSocketClientPollOperationTest", "1.0") {
        addTestCase("basic text send/receive", \basicTextTest());
        addTestCase("binary send/receive", \binaryTest());
        addTestCase("ping/pong", \pingPongTest());
        addTestCase("close handshake", \closeHandshakeTest());
        addTestCase("the server's close frame gives the close code and reason", \serverCloseFrameTest());
        addTestCase("a close the server does not answer ends at the close timeout", \unansweredCloseTest());
        addTestCase("a close the server starts is reported once", \serverInitiatedCloseTest());
        addTestCase("no data frame is sent after a close frame", \noDataAfterCloseTest());
        addTestCase("a close frame without a status code has the close code 1005", \noStatusCloseTest());
        addTestCase("1005 and 1006 are never sent in a close frame", \reservedCloseCodeTest());
        addTestCase("poll state machine", \pollStateMachineTest());
        addTestCase("repeated close request", \repeatedCloseTest());
        addTestCase("multiple messages", \multipleMessagesTest());
        addTestCase("controller integration", \controllerIntegrationTest());
        addTestCase("concurrent send via channel", \concurrentSendTest());
        addTestCase("abort test", \abortTest());
        addTestCase("goal and state accessors", \accessorsTest());

        logger = new Logger("test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }
        hash<HttpServerOptionInfo> http_opts = <HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        };
        m_server = new HttpServer(http_opts);
        m_server.setHandler("ws-handler", "", NOTHING, ws_handler);
        m_server.setDefaultHandler("ws-handler", ws_handler);
        linfo = m_server.addListener(<HttpListenerOptionInfo>{"node": "localhost", "service": 0});

        set_return_value(main());

        m_server.stop();
    }

    #! Helper: perform WebSocket upgrade handshake and return the HTTPClient
    private HTTPClient wsHandshake(*int port) {
        HTTPClient hc({"url": port ? "http://127.0.0.1:" + port : "http://localhost:" + linfo.port});
        # the raw test server accepts one connection: the request's
        if (!port) {
            hc.connect();
        }
        string key = get_random_string(16).toBase64();
        hash<auto> rh = hc.send(NOTHING, "GET", NOTHING, {
            "Upgrade": "websocket",
            "Connection": "Upgrade",
            "Sec-WebSocket-Key": key,
            "Sec-WebSocket-Version": "13",
        });
        if (rh.status_code != 101) {
            throw "WEBSOCKET-ERROR", sprintf("expected 101, got %d", rh.status_code);
        }
        return hc;
    }

    #! Waits for the socket event that a poll operation driven by the test waits for
    /** @param pi the poll info that the operation's continuePoll() returned

        @throw POLL-TIMEOUT no event within the hang guard
    */
    private static waitForPollInfo(hash<SocketPollInfo> pi) {
        # with a poll_timeout_ms hint, Socket::poll() returns when the hint expires, and the operation is continued
        if (!Socket::poll((pi,), HangGuard) && !exists pi.poll_timeout_ms) {
            throw "POLL-TIMEOUT", sprintf("no socket event (events: %d) within %y", pi.events, HangGuard);
        }
    }

    #! Helper to drive a poll operation manually until a message arrives or the operation ends
    private *hash<auto> drivePollUntilMessage(WebSocketClientPollOperation poll_op) {
        while (True) {
            *hash<SocketPollInfo> pi = poll_op.continuePoll();
            if (poll_op.goalReached()) {
                break;
            }
            *hash<auto> msg = poll_op.getReceivedMessage();
            if (msg) {
                return msg;
            }
            if (!pi) {
                break;
            }
            waitForPollInfo(pi);
        }
        # Check one more time
        return poll_op.getReceivedMessage();
    }

    #! Helper to drive poll until goal is reached
    private drivePollUntilGoal(WebSocketClientPollOperation poll_op) {
        while (!poll_op.goalReached()) {
            *hash<SocketPollInfo> pi = poll_op.continuePoll();
            if (!pi) {
                break;
            }
            waitForPollInfo(pi);
        }
    }

    #! Helper: drives the operation until its goal is reached, and returns the messages it received
    private list<hash<auto>> driveAndCollect(WebSocketClientPollOperation poll_op) {
        list<hash<auto>> msgs = ();
        while (!poll_op.goalReached()) {
            *hash<SocketPollInfo> pi = poll_op.continuePoll();
            while (*hash<auto> msg = poll_op.getReceivedMessage()) {
                msgs += msg;
            }
            if (!pi) {
                break;
            }
            waitForPollInfo(pi);
        }
        while (*hash<auto> msg = poll_op.getReceivedMessage()) {
            msgs += msg;
        }
        return msgs;
    }

    #! Helper: returns the messages of a type
    private static list<hash<auto>> messagesOfType(list<hash<auto>> msgs, string type) {
        return select msgs, $1.type == type;
    }

    #! Test basic text message send/receive via poll operation
    basicTextTest() {
        HTTPClient hc = wsHandshake();
        WebSocketClientPollOperation poll_op(hc, "http1", 0, NOTHING, 15s, logger);

        assertEq("ws-client-io", poll_op.getGoal());
        assertEq("connected", poll_op.getState());
        assertFalse(poll_op.goalReached());

        # Send a text message
        poll_op.sendText("hello");

        # Drive poll to send the message and receive the echo
        *hash<auto> msg = drivePollUntilMessage(poll_op);
        assertEq("text", msg.type, "received text message");
        assertEq("ECHO:hello", msg.data, "echo content matches");

        # Clean close
        poll_op.sendClose();
        drivePollUntilGoal(poll_op);
    }

    #! Test binary message send/receive
    binaryTest() {
        HTTPClient hc = wsHandshake();
        WebSocketClientPollOperation poll_op(hc, "http1", 0, NOTHING, 15s, logger);

        binary test_data = <deadbeef01020304>;
        poll_op.sendBinary(test_data);

        *hash<auto> msg = drivePollUntilMessage(poll_op);
        assertEq("binary", msg.type, "received binary message");
        assertEq(test_data, msg.data, "binary data matches");

        poll_op.sendClose();
        drivePollUntilGoal(poll_op);
    }

    #! Test ping/pong handling
    pingPongTest() {
        HTTPClient hc = wsHandshake();
        WebSocketClientPollOperation poll_op(hc, "http1", 0, NOTHING, 15s, logger);

        # Send a ping
        poll_op.sendPing(<01020304>);

        # We should get a pong back from the server
        *hash<auto> pong_msg;
        while (True) {
            *hash<SocketPollInfo> pi = poll_op.continuePoll();
            *hash<auto> msg = poll_op.getReceivedMessage();
            if (msg && msg.type == "pong") {
                pong_msg = msg;
                break;
            }
            if (poll_op.goalReached() || !pi) {
                break;
            }
            waitForPollInfo(pi);
        }
        # The server should echo pings back as pongs
        assertEq("pong", pong_msg.type, "received pong");

        poll_op.sendClose();
        drivePollUntilGoal(poll_op);
        assertTrue(poll_op.goalReached(), "close completed after ping/pong");
    }

    #! Test close handshake
    closeHandshakeTest() {
        HTTPClient hc = wsHandshake();
        WebSocketClientPollOperation poll_op(hc, "http1", 0, NOTHING, 15s, logger);
        assertEq("connected", poll_op.getState());

        # Initiate close
        poll_op.sendClose(WSCC_NormalClosure, "test close");

        # Drive until goal reached (close handshake completes)
        drivePollUntilGoal(poll_op);

        assertTrue(poll_op.goalReached(), "goal reached after close");
        assertEq("closed", poll_op.getState(), "state is closed after close handshake");
        # the close code and reason are those of the server's close frame: the server echoes the code only
        assertEq(WSCC_NormalClosure, poll_op.getCloseCode(), "the close code of the server's close frame");
        assertEq("", poll_op.getCloseReason(), "the server's close frame has no reason");
    }

    #! The close code and reason after a close the client started are those of the server's close frame
    serverCloseFrameTest() {
        RawWsServer server("answer", 4000, "server reason");
        HTTPClient hc = wsHandshake(server.port);
        WebSocketClientPollOperation poll_op(hc, "http1", 0, NOTHING, HangGuard, logger);

        poll_op.sendClose(WSCC_NormalClosure, "client reason");
        list<hash<auto>> msgs = driveAndCollect(poll_op);

        assertEq("closed", poll_op.getState(), "the close handshake completes");
        assertEq(4000, poll_op.getCloseCode(), "the close code is the server's");
        assertEq("server reason", poll_op.getCloseReason(), "the close reason is the server's");
        list<hash<auto>> close_msgs = messagesOfType(msgs, "close");
        assertEq(1, close_msgs.size(), "the server's close frame is reported once");
        assertEq(4000, close_msgs[0].code, "the received close frame has the server's code");
        assertEq("server reason", close_msgs[0].reason, "the received close frame has the server's reason");

        hc.disconnect();
        list<hash<WsMsgInfo>> frames = server.getFrames();
        assertEq((WSOP_Close,), (map $1.op, frames), "the server receives one close frame");
        assertEq(WSCC_NormalClosure, frames[0].close, "the client's close frame has the client's code");
        assertEq("client reason", frames[0].msg, "the client's close frame has the client's reason");
    }

    #! A close with a code that is never sent in a close frame sends a close frame without a status code
    /** RFC 6455 section 7.4.1: 1005 and 1006 must not be set as a status code in a close frame
    */
    reservedCloseCodeTest() {
        foreach int code in ((WSCC_NoStatusRcvd, WSCC_AbnormalClosure)) {
            RawWsServer server("answer", WSCC_NormalClosure, "");
            HTTPClient hc = wsHandshake(server.port);
            WebSocketClientPollOperation poll_op(hc, "http1", 0, NOTHING, HangGuard, logger);

            poll_op.sendClose(code, "reason");
            driveAndCollect(poll_op);
            assertEq("closed", poll_op.getState(), sprintf("%d: the close handshake completes", code));

            hc.disconnect();
            list<hash<WsMsgInfo>> frames = server.getFrames();
            assertEq((WSOP_Close,), (map $1.op, frames), sprintf("%d: the server receives one close frame", code));
            assertEq(WSCC_NoStatusRcvd, frames[0].close, sprintf("%d: the close frame has no status code", code));
            assertNothing(frames[0].msg, sprintf("%d: the close frame has no reason", code));
        }
    }

    #! A close the client started ends at the close timeout when the server never answers it
    /** The idle timeout expires while the client waits for the server's close frame; it does not make the client
        send a second close frame
    */
    unansweredCloseTest() {
        RawWsServer server("silent");
        HTTPClient hc = wsHandshake(server.port);
        WebSocketClientPollOperation poll_op(hc, "http1", 0, NOTHING, 500ms, logger);
        poll_op.setIdleTimeout(50);

        poll_op.sendClose(WSCC_NormalClosure, "client reason");
        list<hash<auto>> msgs = driveAndCollect(poll_op);

        assertEq("closed", poll_op.getState(), "the operation ends closed");
        assertEq(1006, poll_op.getCloseCode(), "no close frame was received from the server");
        assertEq("close handshake timed out", poll_op.getCloseReason(), "the close handshake timed out");
        assertEq((), messagesOfType(msgs, "close"), "no close frame is reported");
        list<hash<auto>> closed_msgs = messagesOfType(msgs, "closed");
        assertEq(1, closed_msgs.size(), "the end is reported once");
        assertEq(1006, closed_msgs[0].code, "the end is reported with code 1006");
        assertEq("close handshake timed out", closed_msgs[0].reason, "the end is reported with its reason");
        assertEq("", poll_op.getCloseCause(), "the idle timeout did not close the connection");

        hc.disconnect();
        list<hash<WsMsgInfo>> frames = server.getFrames();
        assertEq((WSOP_Close,), (map $1.op, frames), "the server receives one close frame");
        assertEq(WSCC_NormalClosure, frames[0].close, "the client's close frame has the client's code");
    }

    #! A data frame cannot be sent once the close handshake has started (RFC 6455 section 5.5.1)
    noDataAfterCloseTest() {
        RawWsServer server("answer", WSCC_NormalClosure, "");
        HTTPClient hc = wsHandshake(server.port);
        WebSocketClientPollOperation poll_op(hc, "http1", 0, NOTHING, HangGuard, logger);

        poll_op.sendText("before");
        poll_op.sendClose(WSCC_NormalClosure, "done");
        assertThrows("WEBSOCKET-CLOSING-ERROR", \poll_op.sendText(), "after");
        assertThrows("WEBSOCKET-CLOSING-ERROR", \poll_op.sendBinary(), <0102>);
        driveAndCollect(poll_op);
        assertEq("closed", poll_op.getState(), "the close handshake completes");
        assertThrows("WEBSOCKET-CLOSING-ERROR", \poll_op.sendText(), "after the close");

        hc.disconnect();
        list<hash<WsMsgInfo>> frames = server.getFrames();
        assertEq((WSOP_Text, WSOP_Close), (map $1.op, frames), "the server receives the message, then the close");
        assertEq("before", frames[0].msg, "the message sent before the close is delivered");
    }

    #! A close frame without a status code has the close code 1005, and its answer has no status code either
    /** RFC 6455 sections 7.1.5 and 7.4.1: 1005 is never sent in a close frame
    */
    noStatusCloseTest() {
        RawWsServer server("initiate", 0);
        HTTPClient hc = wsHandshake(server.port);
        WebSocketClientPollOperation poll_op(hc, "http1", 0, NOTHING, HangGuard, logger);

        list<hash<auto>> msgs = driveAndCollect(poll_op);
        assertEq("closed", poll_op.getState(), "the close handshake completes");
        assertEq(WSCC_NoStatusRcvd, poll_op.getCloseCode(), "the close frame has no status code");
        assertEq("", poll_op.getCloseReason(), "the close frame has no reason");
        assertEq((WSCC_NoStatusRcvd,), (map $1.code, messagesOfType(msgs, "close")), "the close frame is reported");

        hc.disconnect();
        list<hash<WsMsgInfo>> frames = server.getFrames();
        assertEq((WSOP_Close,), (map $1.op, frames), "the server receives the client's answer");
        assertEq(WSCC_NoStatusRcvd, frames[0].close, "the answer has no status code");
    }

    #! A close the server starts is answered, and its close frame is reported once
    serverInitiatedCloseTest() {
        RawWsServer server("initiate", WSCC_GoingAway, "bye");
        HTTPClient hc = wsHandshake(server.port);
        WebSocketClientPollOperation poll_op(hc, "http1", 0, NOTHING, HangGuard, logger);

        list<hash<auto>> msgs = driveAndCollect(poll_op);

        assertEq("closed", poll_op.getState(), "the close handshake completes");
        assertEq(WSCC_GoingAway, poll_op.getCloseCode(), "the close code is the server's");
        assertEq("bye", poll_op.getCloseReason(), "the close reason is the server's");
        list<hash<auto>> close_msgs = messagesOfType(msgs, "close");
        assertEq(1, close_msgs.size(), "the server's close frame is reported once");
        assertEq(WSCC_GoingAway, close_msgs[0].code, "the received close frame has the server's code");
        assertEq("bye", close_msgs[0].reason, "the received close frame has the server's reason");

        assertThrows("WEBSOCKET-CLOSING-ERROR", \poll_op.sendText(), "after the close");

        hc.disconnect();
        list<hash<WsMsgInfo>> frames = server.getFrames();
        assertEq((WSOP_Close,), (map $1.op, frames), "the server receives the client's answer");
        assertEq(WSCC_GoingAway, frames[0].close, "the client's answer echoes the server's code");
    }

    #! Test poll state machine transitions
    pollStateMachineTest() {
        HTTPClient hc = wsHandshake();
        WebSocketClientPollOperation poll_op(hc, "http1", 0, NOTHING, 15s, logger);

        # Initially connected
        assertEq("connected", poll_op.getState());
        assertFalse(poll_op.goalReached());

        # continuePoll should return poll info with at least POLLIN
        *hash<SocketPollInfo> pi = poll_op.continuePoll();
        assertTrue(exists pi, "continuePoll returns poll info");
        assertTrue((pi.events & SOCK_POLLIN) != 0, "POLLIN is set");

        # After sendClose, should transition to closing
        poll_op.sendClose();
        assertTrue(poll_op.getState() == "closing", "state is closing after sendClose");

        drivePollUntilGoal(poll_op);
        assertTrue(poll_op.goalReached(), "goal reached");
    }

    #! A close requested while a close is already in progress is ignored
    /** sendClose() queues the request for the thread that drives the operation, which starts the close handshake
        with the first request; a later request finds the operation closing and changes nothing.
    */
    repeatedCloseTest() {
        HTTPClient hc = wsHandshake();
        WebSocketClientPollOperation poll_op(hc, "http1", 0, NOTHING, 15s, logger);

        poll_op.sendClose(WSCC_NormalClosure, "first");
        poll_op.sendClose(WSCC_GoingAway, "second");
        assertEq("closing", poll_op.getState(), "the operation is closing after the first request");

        drivePollUntilGoal(poll_op);
        assertEq("closed", poll_op.getState(), "the close handshake completes");
        # the server echoes the code of the close frame it received, which is the first request's
        assertEq(WSCC_NormalClosure, poll_op.getCloseCode(), "the first request's close code is sent");
        assertEq("", poll_op.getCloseReason(), "the close reason is that of the server's close frame");
    }

    #! Test multiple messages in sequence
    multipleMessagesTest() {
        HTTPClient hc = wsHandshake();
        WebSocketClientPollOperation poll_op(hc, "http1", 0, NOTHING, 15s, logger);

        # Send multiple messages
        int count = 5;
        for (int i = 0; i < count; ++i) {
            poll_op.sendText("msg" + string(i));
        }

        # Collect all echoed messages
        list<string> received = ();
        while (received.size() < count) {
            *hash<SocketPollInfo> pi = poll_op.continuePoll();
            while (True) {
                *hash<auto> msg = poll_op.getReceivedMessage();
                if (!msg) {
                    break;
                }
                if (msg.type == "text") {
                    received += msg.data;
                }
            }
            if (poll_op.goalReached() || !pi || received.size() == count) {
                break;
            }
            waitForPollInfo(pi);
        }

        assertEq(count, received.size(), "received all messages");
        for (int i = 0; i < count; ++i) {
            assertEq("ECHO:msg" + string(i), received[i], sprintf("message %d content", i));
        }

        poll_op.sendClose();
        drivePollUntilGoal(poll_op);
    }

    #! Test integration with AsyncSocketIoController
    controllerIntegrationTest() {
        HTTPClient hc = wsHandshake();
        WebSocketClientPollOperation poll_op(hc, "http1", 0, NOTHING, 15s, logger);

        # Create a controller for this test
        AsyncSocketIo::AsyncSocketIoController controller(logger);
        string owner = "test-" + get_random_string(8);
        # the controller reports the operation's change into "closed", and its end if it ends before
        Queue<hash<SocketPollStateInfo>> ws_states();

        # Use DelegatingPollOperation to add completion handling to the C++
        # WebSocketClientPollOperation (which doesn't support setCompletionHandler).
        # The callback self-resubmits until goalReached().
        *code make_callback;
        make_callback = sub (hash<SocketPollResultInfo> result) {
            # Re-submit if not done
            if (!poll_op.goalReached()) {
                try {
                    auto wrapper = new DelegatingPollOperation(poll_op, make_callback);
                    controller.submit(<SocketPollOperationInfo>{
                        "sock": hc,
                        "spop": wrapper,
                        "owner": owner,
                        "to": -1s,
                        "stateQueue": ws_states,
                        "notifyStates": "closed",
                    }, True);
                } catch (hash<ExceptionInfo> ex) {
                    # Controller may be stopping
                }
            }
        };

        auto wrapper = new DelegatingPollOperation(poll_op, make_callback);
        controller.submit(<SocketPollOperationInfo>{
            "sock": hc,
            "spop": wrapper,
            "owner": owner,
            "to": -1s,
            "stateQueue": ws_states,
            "notifyStates": "closed",
        });

        controller.waitForProcessing(5s);

        # Send a message — the controller should drive the I/O
        poll_op.sendText("controller-test");
        controller.wakeSocket(hc);

        # Wait for the echo; the bound on each wait is a hang guard only
        *hash<auto> msg;
        while (True) {
            msg = poll_op.getReceivedMessage(HangGuard);
            if (!msg || msg.type == "text") {
                break;
            }
        }

        assertEq("text", msg.type, "received text via controller");
        assertEq("ECHO:controller-test", msg.data, "echo via controller");

        # Close
        poll_op.sendClose();
        controller.wakeSocket(hc);

        # Wait for close to complete: the operation reports its change into "closed" on the I/O thread
        hash<SocketPollStateInfo> event = ws_states.get(HangGuard);
        assertEq("closed", event.state, "the close handshake completes");
        assertFalse(event.done, "the operation reports the close before it ends");

        controller.cancelByOwner(owner);
        controller.flushCallbacksByOwner(owner);
        make_callback = NOTHING;
        assertTrue(poll_op.goalReached(), "poll operation closed after controller test");
    }

    #! Test concurrent sends via the Channel-based queue
    concurrentSendTest() {
        HTTPClient hc = wsHandshake();
        WebSocketClientPollOperation poll_op(hc, "http1", 0, NOTHING, 15s, logger);

        # Send messages from multiple threads
        int threads = 3;
        int msgs_per_thread = 3;
        Counter cnt(threads);

        for (int t = 0; t < threads; ++t) {
            int thread_id = t;
            background sub () {
                on_exit cnt.dec();
                for (int i = 0; i < msgs_per_thread; ++i) {
                    poll_op.sendText(sprintf("t%d-m%d", thread_id, i));
                }
            }();
        }
        cnt.waitForZero();

        # Collect echoes
        int total_expected = threads * msgs_per_thread;
        list<string> received = ();
        while (received.size() < total_expected) {
            *hash<SocketPollInfo> pi = poll_op.continuePoll();
            while (True) {
                *hash<auto> msg = poll_op.getReceivedMessage();
                if (!msg) {
                    break;
                }
                if (msg.type == "text") {
                    received += msg.data;
                }
            }
            if (poll_op.goalReached() || !pi || received.size() == total_expected) {
                break;
            }
            waitForPollInfo(pi);
        }

        assertEq(total_expected, received.size(), "received all concurrent messages");

        poll_op.sendClose();
        drivePollUntilGoal(poll_op);
    }

    #! Test abort
    abortTest() {
        HTTPClient hc = wsHandshake();
        WebSocketClientPollOperation poll_op(hc, "http1", 0, NOTHING, 15s, logger);

        poll_op.abort();
        assertTrue(poll_op.goalReached(), "goal reached after abort");
        assertEq("closed", poll_op.getState(), "state is closed after abort");

        # Check the abort notification was queued
        *hash<auto> msg = poll_op.getReceivedMessage();
        assertTrue(exists msg, "abort notification received");
        assertEq("closed", msg.type, "abort type is closed");
    }

    #! Test getGoal, getState, getOutput, getCloseCode, getCloseReason
    accessorsTest() {
        HTTPClient hc = wsHandshake();
        WebSocketClientPollOperation poll_op(hc, "http1", 0, NOTHING, 15s, logger);

        assertEq("ws-client-io", poll_op.getGoal());
        assertEq("connected", poll_op.getState());
        assertFalse(poll_op.goalReached());
        assertEq(WSCC_NormalClosure, poll_op.getCloseCode());
        assertEq("", poll_op.getCloseReason());
        assertFalse(poll_op.hasReceivedMessages());

        hash<auto> output = poll_op.getOutput();
        assertEq("connected", output.state);

        poll_op.sendClose();
        drivePollUntilGoal(poll_op);
    }
}
