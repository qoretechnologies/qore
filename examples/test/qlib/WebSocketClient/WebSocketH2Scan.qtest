    private {
        HttpServer server;
        *hash<auto> h2info;
        Logger logger("test", LoggerLevel::getLevelInfo());
    }

    constructor() : QUnit::Test("WebSocket HTTP/2 stream scan", "1.0") {
        server = new HttpServer(<HttpServerOptionInfo>{"logger": logger});
        EchoHandler handler();
        server.setHandler("ws-handler", "", NOTHING, handler);
        server.setDefaultHandler("ws-handler", handler);
        try {
            h2info = server.addListener(<HttpListenerOptionInfo>{
                "service": 0,
                "cert": new SSLCertificate(CertPem),
                "key": new SSLPrivateKey(KeyPem),
                "http_version": "auto",
                "enable_h3": False,
            });
        } catch (hash<ExceptionInfo> ex) {
            # SSL might not be available
        }

        addTestCase("streams with concurrent scans", \scanTest());
        set_return_value(main());

        server.stop();
        AsyncSocketIo::AsyncSocketIoController ctrl = AsyncSocketIo::getGlobalAsyncIoController();
        ctrl.stopClear();
    }

    scanTest() {
        if (!h2info) {
            testSkip("HTTPS/HTTP/2 listener not available");
        }
        for (int i = 0; i < Clients; ++i) {
            ScanHolder holder();
            Counter scanning(1);
            Counter received(1);
            *string response;
            code cb = sub (*data msg) {
                if (exists msg && !exists response) {
                    response = msg;
                    received.dec();
                }
            };
            WebSocketClient wsc(cb, {
                "url": "wss://localhost:" + h2info.port,
                "logger": logger,
                "http_version": "2.0",
                "ssl_verify_cert": False,
            });
            holder.client = wsc;
            background scan(holder, scanning);
            wsc.connect();
            assertTrue(wsc.isHttp2(), sprintf("client %d connects over HTTP/2", i));
            wsc.send("REQUEST");
            assertEq(0, received.waitForZero(10s), sprintf("client %d receives the response", i));
            assertEq("RESPONSE:REQUEST", response);
            wsc.disconnect();
            assertEq(0, scanning.waitForZero(60s), sprintf("client %d: the scans complete", i));
            delete holder.client;
        }
    }

    #! assigns an object to a member of the holder, which scans the graph the holder reaches
    private scan(ScanHolder holder, Counter scanning) {
        on_exit {
            scanning.dec();
        }
        for (int i = 0; i < ScansPerClient; ++i) {
            holder.tick = new Mutex();
        }
    }
}
