#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires Logger
%requires HttpServerUtil
%requires HttpServer
%requires WebSocketUtil
%requires WebSocketHandler
%requires WebSocketClient
%requires AsyncSocketIo
%requires ../../TestCertificates.qm

%exec-class WebSocketH2ScanTest

#! echoes each message back
class EchoConnection inherits WebSocketConnection {
    constructor(WebSocketHandler handler) : WebSocketConnection(handler) {
    }

    gotMessage(string msg) {
        send("RESPONSE:" + msg);
    }
}

class EchoHandler inherits WebSocketHandler {
    WebSocketConnection getConnectionImpl(hash<auto> cx, hash<auto> hdr, string cid) {
        return new EchoConnection(self);
    }
}

#! a member assignment of this object scans the graph it reaches, which includes the client's connection
class ScanHolder {
    public {
        *WebSocketClient client;
        *object tick;
    }
}

#! Tests HTTP/2 WebSocket streams opened and closed while the garbage collector scans their connection
/** The HTTP/2 client connection keeps the Queue of each WebSocket stream in a map that its I/O thread changes as
    streams are registered and completed, and that the garbage collector reads whenever a scan reaches the
    connection.  Each client here makes one stream, and a second thread scans the graph of the current client for
    a fixed number of iterations while the streams are opened, used and closed.  Data races between the two are
    reported by ThreadSanitizer builds; every build checks that the streams work and that the scans complete.
*/
class WebSocketH2ScanTest inherits QUnit::Test {
    public {
        #! the number of WebSocket clients opened one after the other
        const Clients = 100;
        #! the number of scans made by the scanning thread for each client
        const ScansPerClient = 200;

        const CertPem = TestCertificates::CertPem;
        const KeyPem = TestCertificates::KeyPem;
    }

    private {
        HttpServer server;
        *hash<auto> h2info;
        Logger logger("test", LoggerLevel::getLevelInfo());
    }

    constructor() : QUnit::Test("WebSocket HTTP/2 stream scan", "1.0") {
        server = new HttpServer(<HttpServerOptionInfo>{"logger": logger});
        EchoHandler handler();
        server.setHandler("ws-handler", "", NOTHING, handler);
        server.setDefaultHandler("ws-handler", handler);
        try {
            h2info = server.addListener(<HttpListenerOptionInfo>{
                "service": 0,
                "cert": new SSLCertificate(CertPem),
                "key": new SSLPrivateKey(KeyPem),
                "http_version": "auto",
                "enable_h3": False,
            });
        } catch (hash<ExceptionInfo> ex) {
            # SSL might not be available
        }

        addTestCase("streams with concurrent scans", \scanTest());
        set_return_value(main());

        server.stop();
        AsyncSocketIo::AsyncSocketIoController ctrl = AsyncSocketIo::getGlobalAsyncIoController();
        ctrl.stopClear();
    }

    scanTest() {
        if (!h2info) {
            testSkip("HTTPS/HTTP/2 listener not available");
        }
        for (int i = 0; i < Clients; ++i) {
            ScanHolder holder();
            Counter scanning(1);
            Counter received(1);
            *string response;
            code cb = sub (*data msg) {
                if (exists msg && !exists response) {
                    response = msg;
                    received.dec();
                }
            };
            WebSocketClient wsc(cb, {
                "url": "wss://localhost:" + h2info.port,
                "logger": logger,
                "http_version": "2.0",
                "ssl_verify_cert": False,
            });
            holder.client = wsc;
            background scan(holder, scanning);
            wsc.connect();
            assertTrue(wsc.isHttp2(), sprintf("client %d connects over HTTP/2", i));
            wsc.send("REQUEST");
            assertEq(0, received.waitForZero(10s), sprintf("client %d receives the response", i));
            assertEq("RESPONSE:REQUEST", response);
            wsc.disconnect();
            assertEq(0, scanning.waitForZero(60s), sprintf("client %d: the scans complete", i));
            delete holder.client;
        }
    }

    #! assigns an object to a member of the holder, which scans the graph the holder reaches
    private scan(ScanHolder holder, Counter scanning) {
        on_exit {
            scanning.dec();
        }
        for (int i = 0; i < ScansPerClient; ++i) {
            holder.tick = new Mutex();
        }
    }
}
