%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires DataProvider
%requires ConnectionProvider
%requires Logger
%requires HttpServerUtil
%requires HttpServerAsyncIo
%requires HttpServer
%requires WebSocketUtil
%requires WebSocketHandler
%requires WebSocketClient
%requires AsyncSocketIo

%exec-class WebSocketClientTest

class MyWsConnection inherits WebSocketConnection {
    private {
        bool send_on_registered;
    }

    constructor(WebSocketHandler handler, bool send_on_registered = False) : WebSocketConnection(handler) {
        self.send_on_registered = send_on_registered;
    }

    sendData() {
        map send($1), WebSocketClientTest::Data;
    }

    sendLargeData() {
        send(WebSocketClientTest::LargeData);
    }

    gotMessage(string msg) {
        send("RESPONSE:" + msg);
        #printf("GOT MSG: %y\n", msg);
    }

    registered() {
        if (send_on_registered) {
            send("REGISTERED");
        }
    }
}

class MyWsHandler inherits WebSocketHandler {
    public {
        bool debug = False;
        *hash<auto> last_hdr;
        # Synchronization for tests that check last_hdr after connect();
        # the 101 response is sent before startImpl() calls getConnectionImpl(),
        # so connect() can return before last_hdr is set
        Mutex hdr_mutex();
        Condition hdr_cond();
        int hdr_gen = 0;
    }

    WebSocketConnection getConnectionImpl(hash<auto> cx, hash<auto> hdr, string cid) {
        {
            hdr_mutex.lock();
            on_exit hdr_mutex.unlock();
            last_hdr = hdr;
            ++hdr_gen;
            hdr_cond.broadcast();
        }
        MyWsConnection conn(self, exists hdr."registered-send");
        if (hdr."send-data") {
            conn.sendData();
        }
        if (hdr."send-large-data") {
            conn.sendLargeData();
        }
        return conn;
    }

    # Returns the current generation; call before connect()
    int getHdrGen() {
        hdr_mutex.lock();
        on_exit hdr_mutex.unlock();
        return hdr_gen;
    }

    # Waits until hdr_gen advances past the given generation
    waitForNewConnection(int prev_gen, timeout t = 5s) {
        hdr_mutex.lock();
        on_exit hdr_mutex.unlock();
        while (hdr_gen == prev_gen) {
            if (hdr_cond.wait(hdr_mutex, t)) {
                throw "TIMEOUT", "waitForNewConnection timed out";
            }
        }
    }

    logError(string fmt) {
        if (debug) {
            vprintf("ERROR " + fmt + "\n", argv);
        }
    }

    logInfo(string fmt) {
        if (debug) {
            vprintf("INFO " + fmt + "\n", argv);
        }
    }

    logDebug(string fmt) {
        if (debug) {
            vprintf("DEBUG " + fmt + "\n", argv);
        }
    }
}

class HealthHandler inherits AbstractHttpRequestHandler {
    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        return makeResponse(200, "OK", {"Content-Type": "text/plain"});
    }
}

class TempFile {
    private {
        string path;
    }

    constructor(string name, data content) {
        path = sprintf("%s%s%s", tmp_location(), DirSep, name);
        File f();
        f.open2(path, O_CREAT | O_WRONLY | O_TRUNC);
        f.write(content);
    }

    destructor() {
        unlink(path);
    }

    string getPath() {
        return path;
    }
}

