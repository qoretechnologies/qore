    private {
        *hash<auto> ext_h2info;
        *TempFile ext_cert;
        *TempFile ext_key;
        *string ext_pidfile;
        *string ext_log;
        int ext_pid = 0;
    }

    private bool waitForConnectionState(WebSocketClientDelayedDataProvider prov, bool expected, date timeout = 5s) {
        date start = now_us();
        while (prov.isConnected() != expected) {
            if (now_us() - start > timeout) {
                return False;
            }
            sleep(100ms);
        }
        return True;
    }

    constructor() : Test("WebSocketClientTest", "1.0") {
        addTestCase("reconnect test", \reconnectTest());
        addTestCase("wedged-state reconnect recovery", \wedgedReconnectRecoveryTest());
        addTestCase("data provider test", \dataProviderTest());
        addTestCase("connection data provider is delayed", \connectionDataProviderIsDelayedTest());
        addTestCase("WebSocketClient tests", \webSocketClientTests());
        addTestCase("HTTP/1.1 async WebSocket tests", \http1AsyncWebSocketTests());
        addTestCase("connection tests", \connectionTests());
        addTestCase("HTTP/2 WebSocket tests", \http2WebSocketTests());
        addTestCase("HTTP/2 WebSocket multi-send tests", \http2WebSocketMultiSendTests());
        addTestCase("HTTP/2 WebSocket external server tests", \http2WebSocketExternalTests());
        addTestCase("cookie option", \testCookieOption());
        addTestCase("cookie option multiple", \testCookieOptionMultiple());
        addTestCase("cookie option absent", \testCookieOptionAbsent());

        logger = new Logger("test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }
        hash<HttpServerOptionInfo> http_opts = <HttpServerOptionInfo>{
            "logger": logger,
            "debug": True,
        };
        mServer = new HttpServer(http_opts);
        mServer.setHandler("ws-handler", "", NOTHING, wsHandler);
        mServer.setHandler("health-handler", "/health", "text/plain", new HealthHandler());
        mServer.setDefaultHandler("ws-handler", wsHandler);
        linfo = mServer.addListener(<HttpListenerOptionInfo>{"service": 0});

        # Try to add HTTPS/HTTP/2 listener.
        #
        # enable_h3 = False: the H2 tests below use http_version=auto on both
        # sides.  With enable_h3 on (default) the paired auto-QUIC listener
        # advertises Alt-Svc h3, and the client's happy-eyeballs race picks
        # H3 over H2 on localhost — isHttp2() then returns False and every
        # H2-specific assertion block is testSkip'd.  Disable H3 on this
        # listener so ALPN definitively selects h2 and the H2-focused tests
        # actually run.  A dedicated HTTP/3 WebSocket test suite exercises
        # the H3 path separately.
        try {
            SSLCertificate cert(CertPem);
            SSLPrivateKey key(KeyPem);
            h2info = mServer.addListener(<HttpListenerOptionInfo>{
                "service": 0,
                "cert": cert,
                "key": key,
                "http_version": "auto",
                "enable_h3": False,
            });
        } catch (hash<ExceptionInfo> ex) {
            # SSL might not be available
        }

        set_return_value(main());

        mServer.stop();
        # Stop the global async I/O controller's ThreadPool to allow clean exit
        AsyncSocketIo::AsyncSocketIoController ctrl = AsyncSocketIo::getGlobalAsyncIoController();
        ctrl.stopClear();
    }

    private bool waitForReadyMessage(string log_path, int port, int retries = 50) {
        string expected = "READY " + port;
        for (int i = 0; i < retries; ++i) {
            if (log_path && is_file(log_path)) {
                try {
                    string content = ReadOnlyFile::readTextFile(log_path);
                    if (content.find(expected) >= 0) {
                        if (m_options.verbose > 2) {
                            @debug {
                                date now = now_us();
                                printf("external ws: ready at %y\n", now);
                            }
                        }
                        return True;
                    }
                } catch (hash<ExceptionInfo> ex) {
                    # ignore transient read errors
                }
            }
            sleep(100ms);
        }
        return False;
    }

    private *hash<auto> startExternalHttp2WsServer() {
        string node_bin = getenv("NODE_BIN") ?? "node";
        if (system(node_bin + " -v > /dev/null 2>&1") != 0) {
            return NOTHING;
        }

        string script = get_script_dir() + DirSep + "http2-ws-server.js";
        if (!is_file(script)) {
            return NOTHING;
        }

        Socket s();
        s.bind("127.0.0.1:0");
        int port = s.getPort();
        s.close();

        ext_cert = new TempFile("http2-ws-cert-" + getpid() + ".pem", CertPem);
        ext_key = new TempFile("http2-ws-key-" + getpid() + ".pem", KeyPem);

        ext_log = tmp_location() + DirSep + "http2-ws-server-" + getpid() + ".log";
        ext_pidfile = tmp_location() + DirSep + "http2-ws-server-" + getpid() + ".pid";

        string cmd = sprintf("%s %s %d %s %s > %s 2>&1 & echo $! > %s",
            node_bin, script, port, ext_cert.getPath(), ext_key.getPath(), ext_log, ext_pidfile);
        if (m_options.verbose > 2) {
            @debug {
                date now = now_us();
                printf("external ws: spawn at %y\n", now);
            }
        }
        if (system(cmd) != 0) {
            stopExternalHttp2WsServer();
            return NOTHING;
        }

        try {
            string pid_str = trim(ReadOnlyFile::readTextFile(ext_pidfile));
            ext_pid = pid_str.toInt();
        } catch (hash<ExceptionInfo> ex) {
            stopExternalHttp2WsServer();
            return NOTHING;
        }

        if (!ext_pid) {
            stopExternalHttp2WsServer();
            return NOTHING;
        }

        if (!waitForReadyMessage(ext_log, port)) {
            stopExternalHttp2WsServer();
            return NOTHING;
        }

        return {
            "port": port,
        };
    }

    private stopExternalHttp2WsServer() {
        if (ext_pid) {
            system("kill " + ext_pid + " > /dev/null 2>&1");
            remove ext_pid;
        }

        if (ext_pidfile && is_file(ext_pidfile)) {
            unlink(ext_pidfile);
        }
        remove ext_pidfile;
        remove ext_log;

        if (ext_cert) {
            delete ext_cert;
        }
        if (ext_key) {
            delete ext_key;
        }
        remove ext_cert;
        remove ext_key;
        remove ext_h2info;
    }

    reconnectTest() {
        MyObserver observer();
        WebSocketClientDelayedDataProvider prov({
            "url": "ws://localhost:" + linfo.port,
            "data": "none",
            "logger": logger,
            "reconnect": True,
        });
        on_error delete prov;
        prov.registerObserver(observer);
        prov.observersReady();

        prov.sendMessage(MESSAGE_WS_PING, "hb");

        observer.wait(EVENT_WS_PONG);
        assertEq(2, observer.l.size());
        assertEq(EVENT_WS_CONNECTED, observer.getFirstMessageId());
        assertEq(EVENT_WS_PONG, observer.getLastMessageId());

        assertTrue(prov.isConnected());
        hash<DataProviderConnectionInfo> cinfo = prov.getConnectionInfo();
        assertTrue(cinfo.connected);
        assertFalse(cinfo.reconnecting);
        assertGe(0, cinfo.info.cid);
        assertGe(1, cinfo.info.num_connects);
        assertEq(linfo.port, cinfo.info.peer.port);

        # stop the listener
        mServer.stopListenerID(linfo.id);

        # wait for the client to detect disconnection
        observer.wait(EVENT_WS_CLOSED);
        observer.clear();

        # check reconnecting status
        assertNothing(prov.sendMessage(MESSAGE_WS_PING),
            "sending a ping while disconnected should not throw or return data");
        assertTrue(waitForConnectionState(prov, False),
            "expected WebSocket client to report disconnected state");

        cinfo = prov.getConnectionInfo();
        assertFalse(cinfo.connected);
        assertTrue(cinfo.reconnecting);
        assertNothing(cinfo.info.peer);
        assertNothing(cinfo.info.socket);

        # clear the observer's event list
        observer.clear();

        # restart listener on the same port
        linfo = mServer.addListener(<HttpListenerOptionInfo>{"service": linfo.port});

        # wait for reconnect
        observer.wait(EVENT_WS_CONNECTED);

        cinfo = prov.getConnectionInfo();
        assertTrue(cinfo.connected);
        assertFalse(cinfo.reconnecting);
        assertGt(0, cinfo.info.cid);
        assertGe(2, cinfo.info.num_connects);
        assertEq(linfo.port, cinfo.info.peer.port);

        # redo ping test
        prov.sendMessage(MESSAGE_WS_PING, "hb");

        observer.wait(EVENT_WS_PONG);
        # Use assertGe instead of assertEq to handle race conditions during reconnection
        # where additional events (like disconnect events) may be captured
        assertGe(2, observer.l.size());
        assertEq(EVENT_WS_PONG, observer.getLastMessageId());

        # clear the observer's event list
        observer.clear();

        # reconnect on the client side
        prov.reconnect();

        # wait for reconnect
        observer.wait(EVENT_WS_CONNECTED);

        cinfo = prov.getConnectionInfo();
        assertTrue(cinfo.connected);
        assertFalse(cinfo.reconnecting);
        assertGt(0, cinfo.info.cid);
        assertGe(3, cinfo.info.num_connects);
        assertEq(linfo.port, cinfo.info.peer.port);

        # redo ping test
        prov.sendMessage(MESSAGE_WS_PING, "hb");

        observer.wait(EVENT_WS_PONG);
        assertGe(3, observer.l.size());
        assertEq(EVENT_WS_PONG, observer.getLastMessageId());
    }

    #! Verifies reconnect() recovers from the wedged tid==0 state
    /** Repros the cloud-bot Discord-gateway wedge: when handleAsyncShutdown()
        reaches clearTid() but never schedules startReconnect() (e.g. start_thread()
        throws inside the recovery path), the client is left at
        @verbatim tid==0, do_reconnect==False, reconnect==True, isOpen()==False @endverbatim
        and the old reconnect() short-circuited with @ref False, leaving the
        connection permanently dead with auto-reconnect on.

        Tests two scenarios:
        - (a) fresh client with reconnect==True (tid==0 since never connected)
          must successfully kick off a connect via reconnect()
        - (b) post-disconnect wedge: a subclass forces startReconnect() to throw
          on the first call (simulating the silent start_thread() failure),
          handleAsyncShutdown()'s new try/catch swallows it, and the next
          reconnect() call recovers via the tid==0 branch
    */
    wedgedReconnectRecoveryTest() {
        # (a) reconnect() on a never-connected client with reconnect==True must
        # kick off a fresh connect via the tid==0 recovery branch instead of
        # the old "return False if tid==0" short-circuit
        {
            MyObserver observer();
            WedgedTestWebSocketClient c({
                "url": "ws://localhost:" + linfo.port,
                "logger": logger,
                "reconnect": True,
            });
            on_exit delete c;
            c.registerObserver(observer);

            assertFalse(c.isOpen());
            assertNothing(c.getTidForTest());
            assertFalse(c.getDoReconnectForTest());

            bool rv = c.reconnect();
            assertTrue(rv, "reconnect() on wedged-equivalent state must return True");

            # the recovery path must have actually started doReconnect
            observer.wait(EVENT_WS_CONNECTED);
            assertTrue(c.isOpen(), "wedged-state recovery must end with an open connection");
        }

        # (b) post-disconnect wedge: arm the subclass to throw on the first
        # startReconnect() call, then trigger a server-side disconnect.  The
        # handleAsyncShutdown() try/catch swallows the throw, leaving the
        # documented wedge; a manual reconnect() must recover from it.
        {
            MyObserver observer();
            WedgedTestWebSocketClient c({
                "url": "ws://localhost:" + linfo.port,
                "logger": logger,
                "reconnect": True,
            });
            on_exit delete c;
            c.registerObserver(observer);

            c.connect();
            observer.wait(EVENT_WS_CONNECTED);
            assertTrue(c.isOpen());

            # Arm the injected failure: the next startReconnect() will throw
            c.throw_on_next_start_reconnect = True;
            observer.clear();

            # Provoke a server-side disconnect by stopping the listener
            int saved_port = linfo.port;
            mServer.stopListenerID(linfo.id);

            # Wait for the client to detect disconnection
            observer.wait(EVENT_WS_CLOSED);

            # Without the fix: handleAsyncShutdown() rethrows out of the
            # ThreadPool task and the wedge silently locks in.  With the fix:
            # the throw is caught + logged, tid==0, do_reconnect==False.
            date deadline = now_us() + 3s;
            while ((c.isOpen() || c.getTidForTest()) && now_us() < deadline) {
                sleep(50ms);
            }
            assertFalse(c.isOpen(), "expected closed state after server stop");
            assertNothing(c.getTidForTest(), "expected wedged tid==0 after injected throw");
            assertFalse(c.getDoReconnectForTest(), "expected do_reconnect cleared after wedge");
            assertGe(1, c.start_reconnect_calls, "startReconnect was at least attempted once");

            # Restart the listener on the same port so the recovery has somewhere to go
            linfo = mServer.addListener(<HttpListenerOptionInfo>{"service": saved_port});

            # The fix in reconnect() must observe tid==0 and kick off a fresh
            # doReconnect rather than returning False
            observer.clear();
            bool rv = c.reconnect();
            assertTrue(rv, "wedged reconnect() must return True (recovery initiated)");

            observer.wait(EVENT_WS_CONNECTED);
            assertTrue(c.isOpen(), "wedged-state recovery must reconnect successfully");
        }
    }

    dataProviderTest() {
        MyObserver observer();
        WebSocketClientDelayedDataProvider prov({
            "url": "ws://localhost:" + linfo.port,
            "data": "none",
            "logger": logger,
        });
        prov.registerObserver(observer);
        prov.observersReady();

        prov.sendMessage(MESSAGE_WS_PING, "hb");

        observer.wait(EVENT_WS_PONG);
        assertEq(2, observer.l.size());
        assertEq(EVENT_WS_CONNECTED, observer.getFirstMessageId());
        assertEq(EVENT_WS_PONG, observer.getLastMessageId());

        AbstractDataProvider child = prov.getChildProvider("wait-for-message");
        prov.sendMessage(MESSAGE_WS_DATA, "hi");

        auto response = child.doRequest();
        assertEq("RESPONSE:hi", response);

        # negative test
        assertThrows("WEBSOCKET-RECV-TIMEOUT", \child.doRequest(), {"timeout": 1});
    }

    connectionDataProviderIsDelayedTest() {
        WebSocketConnectionObject conn({
            "name": "delayed-data-provider-test",
            "url": "ws://localhost:" + linfo.port,
            "opts": {
                "headers": {
                    "test-header": "delayed-provider",
                },
            },
        });
        AbstractDataProvider prov = conn.getDataProvider();
        assertTrue(prov instanceof WebSocketClientDelayedDataProvider,
            "connection data provider must wait for observersReady()");

        WebSocketClientDelayedDataProvider wsprov = cast<WebSocketClientDelayedDataProvider>(prov);
        assertFalse(wsprov.isConnected(),
            "connection data provider must not connect before observersReady()");

        MyObserver observer();
        wsprov.registerObserver(observer);
        int hdr_gen = wsHandler.getHdrGen();
        wsprov.observersReady();
        wsHandler.waitForNewConnection(hdr_gen);
        observer.wait(EVENT_WS_CONNECTED);
        assertTrue(wsprov.isConnected(),
            "connection data provider connects after observersReady()");
        assertEq("delayed-provider", wsHandler.last_hdr."test-header",
            "connection data provider must pass connection headers to the handshake");
    }

    webSocketClientTests() {
        list<auto> l = ();
        Counter c(1);
        code cb = sub (*data msg) {
            #printf("RECEIVED: %y\n", msg);
            if (exists msg) {
                l += msg;
                if (l.size() == responseSize)
                    c.dec();
            }
        };
        responseSize = Data.size();
        hash<auto> opts = {
            "url": "ws://localhost:" + linfo.port,
            "logger": logger,
        };
        WebSocketClient wsc(cb, opts);
        int gen = wsHandler.getHdrGen();
        wsc.connect({"hdr": {"Send-Data": "1"}});
        # Wait for getConnectionImpl; the 101 is sent before last_hdr is set
        wsHandler.waitForNewConnection(gen);
        assertEq(13, wsHandler.last_hdr."sec-websocket-version".toInt(),
            "WebSocket client should send Sec-WebSocket-Version");
        c.waitForZero();
        assertEq(Data, l);
        c.inc();
        l = ();
        responseSize = 1;
        # issue #2566: send a unidirectional PONG to make sure that the WebSocketHandler can handle it
        # https://tools.ietf.org/html/rfc6455#section-5.5.3: unsolicited PONG messages must be ignored
        wsc.pong("heartbeat");
        wsc.send("REQUEST");
        c.waitForZero();
        assertEq(list("RESPONSE:REQUEST"), l);
        wsc.disconnect();
        delete wsc;
    }

    http1AsyncWebSocketTests() {
        {
            list<auto> l = ();
            Counter c(1);
            code cb = sub (*data msg) {
                if (exists msg) {
                    l += msg;
                    if (l.size() == responseSize) {
                        c.dec();
                    }
                }
            };
            responseSize = 1;
            hash<auto> opts = {
                "url": "ws://localhost:" + linfo.port,
                "logger": logger,
                "http_version": "1.1",
            };
            WebSocketClient wsc(cb, opts);
            wsc.connect();
            assertFalse(wsc.isHttp2(), "HTTP/1.1 WebSocket should not negotiate HTTP/2");
            wsc.send("REQUEST");
            c.waitForZero(5s);
            assertEq(list("RESPONSE:REQUEST"), l, "HTTP/1.1 async WebSocket should echo message");
            wsc.disconnect();
            delete wsc;
        }

        {
            Queue msgs();
            WebSocketClient wsc(sub (*data msg) {
                if (exists msg) {
                    msgs.push(msg);
                }
            }, {
                "url": "ws://localhost:" + linfo.port,
                "logger": logger,
                "http_version": "1.1",
            });
            wsc.connect({"hdr": {"Registered-Send": "1"}});
            assertEq("REGISTERED", msgs.get(5s),
                "HTTP/1.1 async WebSocket should receive data sent from registered()");
            wsc.disconnect();
            delete wsc;
        }
    }

    connectionTests() {
        string url = "ws://localhost:8099";
        WebSocketConnectionObject conn("test", "test", url);
        WebSocketClient client = conn.get(False);
        assertEq(url, client.getUrl());

        conn = new WebSocketConnectionObject("test", "test", url, {"monitor": False});
        client = conn.get(False);
        assertEq(url, client.getUrl());

        conn = new WebSocketConnectionObject("test", "test", url, {"monitor": False}, {
            "username": "user",
            "password": "pass",
        });
        client = conn.get(False);
        assertEq(url, client.getUrl());
        assertEq("user", client.getUsername());
        assertEq("pass", client.getPassword());

        # Test polling API support
        {
            url = "ws://localhost:" + linfo.port;
            conn = new WebSocketConnectionObject("test", "test", url);
            assertTrue(conn.supportsPollingApi(), "WebSocketConnectionObject should support polling API");

            # Test async ping with polling API
            AbstractPollOperation poll_op = conn.startPollConnect(logger);
            assertEq("ws-ping", poll_op.getGoal(), "WebSocket poll operation goal should be 'ws-ping'");
            hash<auto> output = waitForWebSocketPingPoll(poll_op);
            assertEq(101, output.code, "WebSocket handshake should return 101 Switching Protocols");
        }

        if (h2info) {
            url = "wss://localhost:" + h2info.port;
            conn = new WebSocketConnectionObject("test", "test", url, {"monitor": False}, {
                "http_version": "auto",
                "ssl_verify_cert": False,
            });
            AbstractPollOperation poll_op = conn.startPollConnect(logger);
            assertEq("ws-ping", poll_op.getGoal(), "WebSocket poll operation goal should be 'ws-ping'");
            hash<auto> output = waitForWebSocketPingPoll(poll_op);
            assertEq(101, output.code,
                "WebSocket ping poll should use an HTTP/1.1 upgrade even with an HTTP/2-capable listener");
        }
    }

    private hash<auto> waitForWebSocketPingPoll(AbstractPollOperation poll_op) {
        date start = now_us();
        date timeout = 10s;
        while (!poll_op.goalReached()) {
            if (now_us() - start > timeout) {
                throw "TIMEOUT", "WebSocket poll operation timed out";
            }
            *hash<SocketPollInfo> info = poll_op.continuePoll();
            if (info) {
                # Wait for socket readiness using Socket::poll() with list argument.
                Socket::poll((info,), 1s);
            }
        }
        assertTrue(poll_op.goalReached(), "WebSocket poll operation should reach goal");
        return poll_op.getOutput();
    }

    #! HTTP/2 WebSocket tests (RFC 8441)
    http2WebSocketTests() {
        if (!h2info) {
            testSkip("HTTPS/HTTP/2 listener not available");
        }

        # Test 0: "auto" mode uses happy eyeballs — ALPN negotiates H2 when available
        {
            list<auto> l = ();
            Counter c(1);
            code cb = sub (*data msg) {
                if (exists msg) {
                    l += msg;
                    if (l.size() == 1) {
                        c.dec();
                    }
                }
            };
            hash<auto> opts = {
                "url": "wss://localhost:" + h2info.port,
                "logger": logger,
                "http_version": "auto",
                "ssl_verify_cert": False,
            };
            WebSocketClient wsc(cb, opts);
            try {
                wsc.connect();
                wsc.send("REQUEST");
                c.waitForZero(5s);
                assertEq(list("RESPONSE:REQUEST"), l, "auto mode should echo messages");
                if (!wsc.isHttp2()) {
                    testSkip("HTTP/2 not negotiated (ALPN may not be available)");
                } else {
                    assertTrue(wsc.isHttp2(), "auto mode should negotiate H2 via ALPN");
                }
                wsc.disconnect();
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err == "TEST-SKIPPED-EXCEPTION") {
                    rethrow;
                }
                assertTrue(False, sprintf("auto mode WS failed: %s: %s", ex.err, ex.desc));
            }
            delete wsc;
        }

        # Test 1: Basic HTTP/2 WebSocket connection and message exchange
        {
            list<auto> l = ();
            Counter c(1);
            code cb = sub (*data msg) {
                if (exists msg) {
                    l += msg;
                    if (l.size() == responseSize) {
                        c.dec();
                    }
                }
            };
            responseSize = Data.size();
            hash<auto> opts = {
                "url": "wss://localhost:" + h2info.port,
                "logger": logger,
                "http_version": "2.0",  # Force HTTP/2 negotiation
                "ssl_verify_cert": False,  # Accept self-signed certificate
            };
            WebSocketClient wsc(cb, opts);
            try {
                wsc.connect({"hdr": {"Send-Data": "1"}});
                c.waitForZero(10s);
                assertEq(Data, l, "HTTP/2 WebSocket should receive data");

                assertTrue(wsc.isHttp2(), "WebSocket should connect over HTTP/2");

                wsc.disconnect();
            } catch (hash<ExceptionInfo> ex) {
                assertTrue(False, sprintf("HTTP/2 WebSocket test failed: %s: %s", ex.err, ex.desc));
            }
            delete wsc;
        }

        # Test 1a: Data sent from registered() before the first client frame
        {
            Queue msgs();
            hash<auto> opts = {
                "url": "wss://localhost:" + h2info.port,
                "logger": logger,
                "http_version": "2.0",
                "ssl_verify_cert": False,
            };
            WebSocketClient wsc(sub (*data msg) {
                if (exists msg) {
                    msgs.push(msg);
                }
            }, opts);
            try {
                wsc.connect({"hdr": {"Registered-Send": "1"}});
                assertTrue(wsc.isHttp2(), "WebSocket should connect over HTTP/2");
                assertEq("REGISTERED", msgs.get(10s),
                    "HTTP/2 WebSocket should receive data sent from registered()");
                wsc.disconnect();
            } catch (hash<ExceptionInfo> ex) {
                assertTrue(False, sprintf("HTTP/2 registered-send test failed: %s: %s", ex.err, ex.desc));
            }
            delete wsc;
        }

        # Test 2: HTTP/2 WebSocket ping/pong
        {
            list<auto> l = ();
            Counter c(1);
            bool got_pong = False;
            code cb = sub (*data msg) {
                if (exists msg) {
                    l += msg;
                    if (l.size() == 1) {
                        c.dec();
                    }
                }
            };
            code pong_cb = sub (*data msg) {
                got_pong = True;
            };
            hash<auto> opts = {
                "url": "wss://localhost:" + h2info.port,
                "logger": logger,
                "http_version": "2.0",
                "pong_callback": pong_cb,
                "ssl_verify_cert": False,  # Accept self-signed certificate
            };
            WebSocketClient wsc(cb, opts);
            try {
                responseSize = 1;
                wsc.connect();

                assertTrue(wsc.isHttp2(), "WebSocket should connect over HTTP/2");

                # Send ping and wait for pong
                wsc.ping("test-ping");
                sleep(500ms);

                # Send message and verify response
                wsc.send("REQUEST");
                c.waitForZero(5s);
                assertEq(list("RESPONSE:REQUEST"), l, "HTTP/2 WebSocket should echo message");

                wsc.disconnect();
            } catch (hash<ExceptionInfo> ex) {
                assertTrue(False, sprintf("HTTP/2 WebSocket ping test failed: %s: %s", ex.err, ex.desc));
            }
            delete wsc;
        }

        # Test 2a: HTTP/2 automatic client heartbeat
        {
            Counter got_pong(1);
            Mutex pong_mutex();
            bool seen_pong = False;
            code cb = sub (*data msg) {};
            code pong_cb = sub (*data msg) {
                AutoLock al(pong_mutex);
                if (!seen_pong) {
                    seen_pong = True;
                    got_pong.dec();
                }
            };
            hash<auto> opts = {
                "url": "wss://localhost:" + h2info.port,
                "logger": logger,
                "http_version": "2.0",
                "heartbeat": 200ms,
                "pong_callback": pong_cb,
                "ssl_verify_cert": False,
            };
            WebSocketClient wsc(cb, opts);
            try {
                wsc.connect();
                assertTrue(wsc.isHttp2(), "WebSocket should connect over HTTP/2");
                int rc = got_pong.waitForZero(5s);
                assertEq(0, rc, "HTTP/2 automatic heartbeat should receive a PONG");
                wsc.disconnect();
            } catch (hash<ExceptionInfo> ex) {
                assertTrue(False, sprintf("HTTP/2 automatic heartbeat test failed: %s: %s", ex.err, ex.desc));
            }
            delete wsc;
        }

        # Test 2b: HTTP/2 client idle timeout
        {
            Counter closed(1);
            Mutex close_mutex();
            bool seen_close = False;
            code cb = sub (*data msg) {
                if (!exists msg) {
                    AutoLock al(close_mutex);
                    if (!seen_close) {
                        seen_close = True;
                        closed.dec();
                    }
                }
            };
            hash<auto> opts = {
                "url": "wss://localhost:" + h2info.port,
                "logger": logger,
                "http_version": "2.0",
                "heartbeat": 0,
                "idle_timeout": 500ms,
                "ssl_verify_cert": False,
            };
            WebSocketClient wsc(cb, opts);
            try {
                wsc.connect();
                assertTrue(wsc.isHttp2(), "WebSocket should connect over HTTP/2");
                int rc = closed.waitForZero(5s);
                assertEq(0, rc, "HTTP/2 idle timeout should close the client");
                assertEq("idle-timeout", wsc.getAsyncCloseCause(),
                    "HTTP/2 idle timeout should surface the close cause");
                try { wsc.disconnect(); } catch () {}
            } catch (hash<ExceptionInfo> ex) {
                assertTrue(False, sprintf("HTTP/2 idle-timeout test failed: %s: %s", ex.err, ex.desc));
            }
            delete wsc;
        }

        # Test 2c: HTTP/2 automatic server heartbeat
        {
            int old_heartbeat = wsHandler.getHeartbeat();
            wsHandler.setHeartbeat(1);
            on_exit wsHandler.setHeartbeat(old_heartbeat);

            MyObserver observer();
            WebSocketClientWithSerialization wsc({
                "url": "wss://localhost:" + h2info.port,
                "logger": logger,
                "http_version": "2.0",
                "heartbeat": 0,
                "data": "none",
                "raise_ping_events": True,
                "ssl_verify_cert": False,
            });
            wsc.registerObserver(observer);
            wsc.observersReady();
            try {
                assertTrue(wsc.isHttp2(), "WebSocket should connect over HTTP/2");
                observer.wait(EVENT_WS_PING);
                wsc.disconnect();
            } catch (hash<ExceptionInfo> ex) {
                try { wsc.disconnect(); } catch () {}
                assertTrue(False, sprintf("HTTP/2 server heartbeat test failed: %s: %s", ex.err, ex.desc));
            }
        }

        # Test 3: Verify isHttp2() method
        {
            code cb = sub (*data msg) {};
            hash<auto> opts = {
                "url": "wss://localhost:" + h2info.port,
                "logger": logger,
                "http_version": "2.0",
                "ssl_verify_cert": False,  # Accept self-signed certificate
            };
            WebSocketClient wsc(cb, opts);
            try {
                wsc.connect();

                assertTrue(wsc.isHttp2(), "isHttp2() should return True for HTTP/2 WebSocket");

                wsc.disconnect();
            } catch (hash<ExceptionInfo> ex) {
                assertTrue(False, sprintf("HTTP/2 isHttp2() test failed: %s: %s", ex.err, ex.desc));
            }
            delete wsc;
        }

        # Test 4: Large message handling (tests HTTP/2 frame fragmentation)
        # Large WebSocket frames are split across multiple HTTP/2 DATA frames (~16KB each)
        {
            *string received_msg;
            Counter c(1);
            code cb = sub (*data msg) {
                if (exists msg) {
                    received_msg = msg;
                    c.dec();
                }
            };
            hash<auto> opts = {
                "url": "wss://localhost:" + h2info.port,
                "logger": logger,
                "http_version": "2.0",
                "ssl_verify_cert": False,
            };
            WebSocketClient wsc(cb, opts);
            try {
                # Connect with Send-Large-Data header to trigger server sending 32KB message
                wsc.connect({"hdr": {"Send-Large-Data": "1"}});

                assertTrue(wsc.isHttp2(), "WebSocket should connect over HTTP/2");

                c.waitForZero(10s);
                assertEq(LargeData.size(), received_msg.size(),
                    "HTTP/2 WebSocket should receive complete large message (32KB)");
                assertEq(LargeData, received_msg, "HTTP/2 WebSocket large message content matches");

                wsc.disconnect();
            } catch (hash<ExceptionInfo> ex) {
                assertTrue(False, sprintf("HTTP/2 WebSocket large message test failed: %s: %s", ex.err, ex.desc));
            }
            delete wsc;
        }

        # Test 5: HTTP/2 CONNECT handshake headers (Sec-WebSocket-Key/Accept)
        {
            hash<auto> http_opts = (
                "url": "https://localhost:" + h2info.port,
                "http_version": "2.0",
                "ssl_verify_cert": False,
                "timeout": 5s,
            );
            HTTPClient hc(http_opts);
            string key = get_random_string(16).toBase64();
            hash<auto> info;
            hash<auto> resp = hc.sendHttp2Connect("/", {"Sec-WebSocket-Key": key}, "websocket", \info);
            assertEq(200, resp.status_code, "HTTP/2 WebSocket CONNECT should return 200");
            hash<auto> rhdr = resp.headers ?? resp;
            assertEq(ws_get_response_key(key), rhdr."sec-websocket-accept",
                "HTTP/2 CONNECT should return Sec-WebSocket-Accept");

            # Verify server is still functional via a separate connection;
            # the active CONNECT stream blocks h2op on the original connection
            # (HTTP/2 requests are serialized per connection in the server)
            {
                HTTPClient hc2(http_opts);
                on_exit delete hc2;
                hash<auto> health_resp = hc2.send(NOTHING, "GET", "/health");
                assertEq(200, health_resp.status_code,
                    "HTTP/2 GET should succeed on separate connection with active CONNECT stream");
                assertEq("OK", health_resp.body, "HTTP/2 GET should return health response");
            }

            binary close_frame = ws_encode_message("", WSOP_Close);
            hc.sendHttp2StreamData(resp.stream_id, close_frame, True);
            delete hc;

            HTTPClient bad_hc(http_opts);
            hash<auto> no_key_resp = bad_hc.sendHttp2Connect("/", {}, "websocket", NOTHING);
            assertEq(200, no_key_resp.status_code, "HTTP/2 CONNECT without key should return 200");
            hash<auto> no_key_hdr = no_key_resp.headers ?? no_key_resp;
            bool has_accept = (exists no_key_hdr."sec-websocket-accept") ?? False;
            assertFalse(has_accept,
                "HTTP/2 CONNECT without Sec-WebSocket-Key should not return Sec-WebSocket-Accept");
            bad_hc.sendHttp2StreamData(no_key_resp.stream_id, close_frame, True);
            delete bad_hc;
        }
    }

    #! Test H2 WebSocket multiple sequential sends on same connection
    /** Reproduces the scenario where an H2 WS connection closes between operations.
    */
    http2WebSocketMultiSendTests() {
        if (!h2info) {
            testSkip("HTTPS/HTTP/2 listener not available");
        }

        # Test 1: rapid sequential sends
        {
            list<auto> received = ();
            Counter c(3);
            code cb = sub (*data msg) {
                if (exists msg) {
                    received += msg;
                    c.dec();
                }
            };
            hash<auto> opts = {
                "url": "wss://localhost:" + h2info.port,
                "logger": logger,
                "http_version": "auto",
                "ssl_verify_cert": False,
            };
            WebSocketClient wsc(cb, opts);
            on_exit {
                try { wsc.disconnect(); } catch () {}
                delete wsc;
            }

            wsc.connect();
            if (!wsc.isHttp2()) {
                testSkip("HTTP/2 not negotiated");
            }

            wsc.send("msg1");
            wsc.send("msg2");
            wsc.send("msg3");
            c.waitForZero(10s);
            assertEq(3, received.size(), "rapid: should receive all 3 responses");
        }

        # Test 2: sends with delays (simulates idle time between test cases)
        {
            list<auto> received = ();
            Counter c(3);
            code cb = sub (*data msg) {
                if (exists msg) {
                    received += msg;
                    c.dec();
                }
            };
            hash<auto> opts = {
                "url": "wss://localhost:" + h2info.port,
                "logger": logger,
                "http_version": "auto",
                "ssl_verify_cert": False,
            };
            WebSocketClient wsc(cb, opts);
            on_exit {
                try { wsc.disconnect(); } catch () {}
                delete wsc;
            }

            wsc.connect();
            if (!wsc.isHttp2()) {
                testSkip("HTTP/2 not negotiated");
            }

            wsc.send("delayed1");
            sleep(500ms);
            assertTrue(wsc.isOpen(), "connection should be open after 500ms idle");
            wsc.send("delayed2");
            sleep(500ms);
            assertTrue(wsc.isOpen(), "connection should be open after second 500ms idle");
            wsc.send("delayed3");
            c.waitForZero(10s);
            assertEq(3, received.size(), "delayed: should receive all 3 responses");
        }
    }

    http2WebSocketExternalTests() {
        ext_h2info = startExternalHttp2WsServer();
        if (!ext_h2info) {
            testSkip("External HTTP/2 WebSocket server not available");
            return;
        }
        on_exit stopExternalHttp2WsServer();

        # Test 1: Basic HTTP/2 WebSocket connection and echo
        {
            if (m_options.verbose > 2) {
                @debug {
                    date now = now_us();
                    printf("external ws: connect start %y\n", now);
                }
            }
            list<auto> l = ();
            Counter c(1);
            code cb = sub (*data msg) {
                if (exists msg) {
                    l += msg;
                    if (l.size() == 1) {
                        c.dec();
                    }
                }
            };
            hash<auto> opts = {
                "url": "wss://localhost:" + ext_h2info.port,
                "logger": logger,
                "http_version": "2.0",
                "ssl_verify_cert": False,
            };
            WebSocketClient wsc(cb, opts);
            wsc.connect();
            if (m_options.verbose > 2) {
                @debug {
                    date now = now_us();
                    printf("external ws: connect done %y\n", now);
                }
            }
            assertTrue(wsc.isHttp2(), "External HTTP/2 WebSocket should negotiate HTTP/2");

            wsc.send("echo-test");
            c.waitForZero(5s);
            if (m_options.verbose > 2) {
                @debug {
                    date now = now_us();
                    printf("external ws: echo received %y\n", now);
                }
            }
            assertEq(list("echo-test"), l, "External HTTP/2 WebSocket should echo messages");

            wsc.disconnect();
            if (m_options.verbose > 2) {
                @debug {
                    date now = now_us();
                    printf("external ws: disconnect done %y\n", now);
                }
            }
            delete wsc;
        }

        # Test 2: Initial data sent by server (mixed text/binary)
        {
            list<auto> l = ();
            Counter c(1);
            responseSize = Data.size();
            code cb = sub (*data msg) {
                if (exists msg) {
                    l += msg;
                    if (l.size() == responseSize) {
                        c.dec();
                    }
                }
            };
            hash<auto> opts = {
                "url": "wss://localhost:" + ext_h2info.port,
                "logger": logger,
                "http_version": "2.0",
                "ssl_verify_cert": False,
            };
            WebSocketClient wsc(cb, opts);
            wsc.connect({"hdr": {"Send-Data": "1"}});
            assertTrue(wsc.isHttp2(), "External HTTP/2 WebSocket should negotiate HTTP/2");

            c.waitForZero(5s);
            assertEq(Data, l, "External HTTP/2 WebSocket should receive server data");

            wsc.disconnect();
            delete wsc;
        }

        # Test 3: Large message handling
        {
            *string received_msg;
            Counter c(1);
            code cb = sub (*data msg) {
                if (exists msg) {
                    received_msg = msg;
                    c.dec();
                }
            };
            hash<auto> opts = {
                "url": "wss://localhost:" + ext_h2info.port,
                "logger": logger,
                "http_version": "2.0",
                "ssl_verify_cert": False,
            };
            WebSocketClient wsc(cb, opts);
            wsc.connect({"hdr": {"Send-Large-Data": "1"}});
            assertTrue(wsc.isHttp2(), "External HTTP/2 WebSocket should negotiate HTTP/2");

            c.waitForZero(10s);
            assertEq(LargeData.size(), received_msg.size(),
                "External HTTP/2 WebSocket should receive complete large message (32KB)");
            assertEq(LargeData, received_msg, "External HTTP/2 WebSocket large message content matches");

            wsc.disconnect();
            delete wsc;
        }

        # Test 4: HTTP/2 ping/pong
        {
            bool got_pong = False;
            code cb = sub (*data msg) {};
            code pong_cb = sub (*data msg) {
                got_pong = True;
            };
            hash<auto> opts = {
                "url": "wss://localhost:" + ext_h2info.port,
                "logger": logger,
                "http_version": "2.0",
                "ssl_verify_cert": False,
                "pong_callback": pong_cb,
            };
            WebSocketClient wsc(cb, opts);
            wsc.connect();
            assertTrue(wsc.isHttp2(), "External HTTP/2 WebSocket should negotiate HTTP/2");

            wsc.ping("test-ping");
            date start = now_us();
            while (!got_pong && (now_us() - start) < 5s) {
                sleep(100ms);
            }
            assertTrue(got_pong, "External HTTP/2 WebSocket should receive pong");

            wsc.disconnect();
            delete wsc;
        }

        # Test 5: HTTP/2 CONNECT handshake headers
        {
            hash<auto> http_opts = (
                "url": "https://localhost:" + ext_h2info.port,
                "http_version": "2.0",
                "ssl_verify_cert": False,
                "timeout": 5s,
            );
            HTTPClient hc(http_opts);
            string key = get_random_string(16).toBase64();
            hash<auto> info;
            hash<auto> resp = hc.sendHttp2Connect("/",
                {"Sec-WebSocket-Key": key, "Sec-WebSocket-Version": "13"}, "websocket", \info);
            hash<auto> rhdr = resp.headers ?? resp;
            assertEq(ws_get_response_key(key), rhdr."sec-websocket-accept",
                "External HTTP/2 CONNECT should return Sec-WebSocket-Accept");

            binary close_frame = ws_encode_message("", WSOP_Close);
            hc.sendHttp2StreamData(resp.stream_id, close_frame, True);
            delete hc;

            HTTPClient bad_hc(http_opts);
            assertThrows("HTTP2-CONNECT-ERROR", sub () {
                bad_hc.sendHttp2Connect("/", {"Sec-WebSocket-Key": key}, "websocket", NOTHING);
            });
            delete bad_hc;

            HTTPClient no_key_hc(http_opts);
            assertThrows("HTTP2-CONNECT-ERROR", sub () {
                no_key_hc.sendHttp2Connect("/", {"Sec-WebSocket-Version": "13"}, "websocket", NOTHING);
            });
            delete no_key_hc;
        }
    }

    # ---- Cookie option tests ----

    testCookieOption() {
        code cb = sub (*data msg) {};
        hash<auto> opts = {
            "url": "ws://localhost:" + linfo.port,
            "logger": logger,
            "cookie": "session=abc123",
        };
        WebSocketClient wsc(cb, opts);
        # Record generation before connect; the 101 response is sent before
        # getConnectionImpl sets last_hdr, so connect() can return early
        int gen = wsHandler.getHdrGen();
        wsc.connect();
        on_exit {
            wsc.disconnect();
            delete wsc;
        }
        wsHandler.waitForNewConnection(gen);
        assertTrue(wsHandler.last_hdr.cookie.val(), "cookie header should be present in upgrade request");
        assertRegex("session=abc123", wsHandler.last_hdr.cookie);
    }

    testCookieOptionMultiple() {
        code cb = sub (*data msg) {};
        hash<auto> opts = {
            "url": "ws://localhost:" + linfo.port,
            "logger": logger,
            "cookie": "a=1; b=2",
        };
        WebSocketClient wsc(cb, opts);
        int gen = wsHandler.getHdrGen();
        wsc.connect();
        on_exit {
            wsc.disconnect();
            delete wsc;
        }
        wsHandler.waitForNewConnection(gen);
        assertTrue(wsHandler.last_hdr.cookie.val(), "cookie header should be present");
        assertRegex("a=1", wsHandler.last_hdr.cookie);
        assertRegex("b=2", wsHandler.last_hdr.cookie);
    }

    testCookieOptionAbsent() {
        code cb = sub (*data msg) {};
        hash<auto> opts = {
            "url": "ws://localhost:" + linfo.port,
            "logger": logger,
        };
        WebSocketClient wsc(cb, opts);
        int gen = wsHandler.getHdrGen();
        wsc.connect();
        on_exit {
            wsc.disconnect();
            delete wsc;
        }
        wsHandler.waitForNewConnection(gen);
        assertFalse(wsHandler.last_hdr.cookie.val(), "no cookie header without cookie option");
    }
}

#! Test subclass that exposes private state and can inject a startReconnect() failure
/** Used by wedgedReconnectRecoveryTest() to reproduce the cloud-bot wedge
    where handleAsyncShutdown() reaches clearTid() but then fails to schedule
    startReconnect() (e.g. start_thread() throws), leaving the client at
    tid==0, do_reconnect==False, reconnect==True, isOpen()==False with no
    recovery possible via the old reconnect() short-circuit.
*/
class WedgedTestWebSocketClient inherits WebSocketClientWithSerialization {
    public {
        #! When True, the next startReconnect() call throws and clears this flag
        bool throw_on_next_start_reconnect = False;
        #! How many times startReconnect() was called (for sanity in assertions)
        int start_reconnect_calls = 0;
    }

    constructor(hash<auto> opts) : WebSocketClientWithSerialization(opts) {
    }

    #! Accessor for inherited private state (post-clearTid wedge has tid==0/NOTHING)
    *int getTidForTest() { return tid; }
    #! Accessor for inherited private state (post-clearTid wedge has do_reconnect==False)
    /** Coerces uninitialised state (NOTHING on a never-connected client) to False
        so the assertions can use assertFalse() against a clean bool.
    */
    bool getDoReconnectForTest() { return do_reconnect ?? False; }

    private startReconnect() {
        ++start_reconnect_calls;
        if (throw_on_next_start_reconnect) {
            throw_on_next_start_reconnect = False;
            throw "TEST-INJECTED-FAILURE", "simulating start_thread() / startReconnect() failure";
        }
        WebSocketClient::startReconnect();
    }
}

class MyObserver inherits Observer {
    public {
        list<hash<auto>> l();
    }

    private {
        Mutex m();
        Condition cond();
        int waiting;
    }

    update(string event_id, hash<auto> data_) {
        m.lock();
        on_exit m.unlock();

        l += {
            "id": event_id,
            "data": data_,
        };

        if (waiting) {
            cond.broadcast();
        }
    }

    wait(*string msg) {
        date start = now_us();

        m.lock();
        on_exit m.unlock();

        bool found;
        while (!found) {
            if (!msg.val()) {
                if (l) {
                    found = True;
                }
            } else {
                # search all entries including those already in the list
                for (int i = 0; i < l.size(); ++i) {
                    if (l[i].id == msg) {
                        found = True;
                        break;
                    }
                }
            }
            if (!found) {
                cond.wait(m, 1s);
                date d = now_us() - start;
                if (d > 5s) {
                    throw "ERROR", sprintf("no matching data received in timeout; msg: %y l: %y", msg, l);
                }
            }
        }
    }

    *string getFirstMessageId() {
        return l[0].id;
    }

    *string getLastMessageId() {
        return l.last().id;
    }

    clear() {
        m.lock();
        on_exit m.unlock();

        l = ();
    }
}
