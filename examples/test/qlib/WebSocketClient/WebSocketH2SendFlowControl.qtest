#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-platform: macos - WebSocket connections over TLS on HTTP/2 and HTTP/3 (QUIC), their send flow control and close

/*  WebSocketH2SendFlowControl.qtest Copyright 2026 Qore Technologies, s.r.o.

    Permission is hereby granted, free of charge, to any person obtaining a
    copy of this software and associated documentation files (the "Software"),
    to deal in the Software without restriction, including without limitation
    the rights to use, copy, modify, merge, publish, distribute, sublicense,
    and/or sell copies of the Software, and to permit persons to whom the
    Software is furnished to do so, subject to the following conditions:

    The above copyright notice and this permission notice shall be included in
    all copies or substantial portions of the Software.

    THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
    IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
    FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
    AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
    LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
    FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
    DEALINGS IN THE SOFTWARE.

    qore#5879: over HTTP/2, WebSocketClient::send() raised HTTP2-FLOW-CONTROL ("buffer full: data dropped") when
    several large messages were sent in a row before the stream's send buffer (1 MiB) drained, and the message was
    lost; the close frame of disconnect() could be lost the same way.  A send now waits for the buffer to drain, as
    on HTTP/3, bounded by the client's timeout.  The cases with a server (node) that grants no flow-control credit
    until the test releases it fail without the fix: the second send raises at once.  The cases with HttpServer,
    which reads at once, check the same sends on HTTP/2 and HTTP/3.
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Logger
%requires HttpServerUtil
%requires HttpServer
%requires AsyncSocketIo
%requires WebSocketUtil
%requires WebSocketHandler
%requires WebSocketClient
%requires FsUtil
%requires ../../TestCertificates.qm

%try-module process >= 2.2
%define NoProcess
%endtry

%exec-class WebSocketH2SendFlowControlTest

#! the number of messages sent in a row
const Count = 8;

#! the size of each message: several times the stream's send buffer together
const Size = 3 * 1024 * 1024;

#! a hang guard only, never a timing assertion
const HangGuard = 60s;

class TestConnection inherits WebSocketConnection {
    public {
        #! the events of the connection: received messages and the close
        Queue events;
    }

    constructor(WebSocketHandler handler, Queue events) : WebSocketConnection(handler) {
        self.events = events;
    }

    gotMessage(binary msg) {
        # the first byte tells which message it is; the size and the last byte that it arrived whole
        events.push({"size": msg.size(), "first": msg[0], "last": msg[msg.size() - 1]});
    }

    gotMessage(string msg) {
        gotMessage(binary(msg));
    }

    connectionClosed() {
        events.push({"closed": getCloseCode()});
    }
}

class TestHandler inherits WebSocketHandler {
    public {
        Queue events();
    }

    WebSocketConnection getConnectionImpl(hash<auto> cx, hash<auto> hdr, string cid) {
        return new TestConnection(self, events);
    }
}

class WebSocketH2SendFlowControlTest inherits QUnit::Test {
    private {
        HttpServer server;
        TestHandler handler();
        int port;
    }

    constructor() : QUnit::Test("WebSocketH2SendFlowControl", "1.0") {
        foreach string ver in (("2.0", "3.0")) {
            addTestCase(sprintf("HTTP/%s: large messages sent in a row all arrive", ver), \testSends(),
                (ver, False));
            addTestCase(sprintf("HTTP/%s: large messages sent in a row, then disconnect(): all arrive, then the "
                "close", ver), \testSends(), (ver, True));
            addTestCase(sprintf("HTTP/%s: a fragmented message of large fragments arrives whole", ver),
                \testFragments(), ver);
        }
        addTestCase("HTTP/2: sends wait for flow-control credit; all messages, then the close, arrive",
            \testNoCredit());
        addTestCase("HTTP/2: a send that gets no flow-control credit within the timeout raises, and sends nothing",
            \testNoCreditTimeout());
        set_return_value(main());
    }

    globalSetUp() {
        server = new HttpServer(<HttpServerOptionInfo>{"logger": new Logger("test", LoggerLevel::getLevelInfo())});
        server.setDefaultHandler("ws", handler);
        port = server.addListener(<HttpListenerOptionInfo>{
            "node": "localhost",
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
            "http_version": "auto",
        }).port;
        server.waitForAsyncIo();
    }

    globalTearDown() {
        if (server) {
            server.stop();
            delete server;
        }
    }

    #! Sends messages larger than the stream's send buffer in a row
    /** @param ver the HTTP version
        @param disconnect if True, the client disconnects right after the last send: the messages and its close
        frame are sent before the connection ends
    */
    testSends(string ver, bool disconnect) {
        handler.events.clear();
        WebSocketClient wsc = connect(ver);
        on_exit {
            try {
                wsc.disconnect();
            } catch () {
            }
        }
        for (int i = 0; i < Count; ++i) {
            wsc.send(message(i, Size));
        }
        if (disconnect) {
            wsc.disconnect();
        }
        for (int i = 0; i < Count; ++i) {
            hash<auto> e = handler.events.get(HangGuard);
            assertEq({"size": Size, "first": i, "last": i}, e, sprintf("message %d arrives whole and in order", i));
        }
        if (disconnect) {
            hash<auto> e = handler.events.get(HangGuard);
            assertEq({"closed": WSCC_GoingAway}, e, "the client's close frame reaches the server");
        }
    }

    #! Sends a message in fragments that are each larger than the stream's send buffer
    testFragments(string ver) {
        handler.events.clear();
        WebSocketClient wsc = connect(ver);
        on_exit {
            try {
                wsc.disconnect();
            } catch () {
            }
        }
        wsc.send(message(1, Size), WSOP_Binary, False);
        wsc.send(message(2, Size), WSOP_Continuation, False);
        wsc.send(message(3, Size), WSOP_Continuation, True);
        hash<auto> e = handler.events.get(HangGuard);
        assertEq({"size": 3 * Size, "first": 1, "last": 3}, e, "the message arrives whole");
    }

%ifdef NoProcess
    testNoCredit() {
        testSkip("the process module is not available");
    }

    testNoCreditTimeout() {
        testSkip("the process module is not available");
    }
%else
    #! Sends messages larger than the stream's send buffer to a server that grants no credit until it is released
    /** The sender disconnects right after its last send; every message and the close frame arrive
    */
    testNoCredit() {
        hash<auto> node = startNode();
        on_exit stopNode(node.process);
        WebSocketClient wsc = connectNode(node.port, HangGuard);
        on_exit {
            try {
                wsc.disconnect();
            } catch () {
            }
        }
        Queue sent();
        background sender(wsc, sent, True);
        # the first message is buffered: the next one waits for credit until the server reads
        assertEq("sent 0", sent.get(HangGuard), "the first message is buffered");
        node.process.write("release\n");
        assertEq("done", result(sent), "every send waits for credit and is made");
        for (int i = 0; i < Count; ++i) {
            assertEq(sprintf("MSG %d %d %d", Size, i, i), readLine(\node),
                sprintf("message %d arrives whole and in order", i));
        }
        assertEq(sprintf("CLOSE %d", WSCC_GoingAway), readLine(\node), "the close frame of disconnect() arrives");
    }

    #! A send that gets no credit within the client's timeout raises, and none of its message is sent
    testNoCreditTimeout() {
        hash<auto> node = startNode();
        on_exit stopNode(node.process);
        # the client's timeout bounds the wait for credit
        WebSocketClient wsc = connectNode(node.port, 2s);
        on_exit {
            try {
                wsc.disconnect();
            } catch () {
            }
        }
        wsc.send(message(0, Size));
        assertThrows("HTTP2-FLOW-CONTROL", "did not drain", \wsc.send(), message(1, Size));
        # once the server reads, it gets the first message, and none of the second one
        node.process.write("release\n");
        assertEq(sprintf("MSG %d 0 0", Size), readLine(\node), "the first message arrives");
        wsc.disconnect();
        assertEq(sprintf("CLOSE %d", WSCC_GoingAway), readLine(\node), "no part of the second message was sent");
    }

    #! Returns the sender's result after its "sent <n>" reports: "done" or the error
    private string result(Queue sent) {
        while (True) {
            string rv = sent.get(HangGuard);
            if (rv !~ /^sent /) {
                return rv;
            }
        }
    }

    #! Sends the messages; pushes "sent <n>" after each, then "done" or the error
    private sender(WebSocketClient wsc, Queue sent, bool disconnect) {
        try {
            for (int i = 0; i < Count; ++i) {
                wsc.send(message(i, Size));
                sent.push(sprintf("sent %d", i));
            }
            if (disconnect) {
                wsc.disconnect();
            }
            sent.push("done");
        } catch (hash<ExceptionInfo> ex) {
            sent.push(sprintf("error: %s: %s", ex.err, ex.desc));
        }
    }

    #! Starts the server that grants no credit until it is released; skips the test without node
    private hash<auto> startNode() {
        string node_bin = ENV.NODE_BIN ?? "node";
        if (system(node_bin + " -e \"process.exit(require('http2').constants.NGHTTP2_SETTINGS_ENABLE_CONNECT_PROTOCOL "
                "? 0 : 1)\" > /dev/null 2>&1")) {
            testSkip("node with RFC 8441 extended CONNECT support is not available");
        }
        TmpDir dir("ws-h2-send-flow-control-");
        foreach hash<auto> i in ({"cert.pem": CertPem, "key.pem": KeyPem}.pairIterator()) {
            File f();
            f.open2(dir.path + "/" + i.key, O_CREAT | O_TRUNC | O_WRONLY);
            f.write(i.value);
            f.close();
        }
        Process p(node_bin, (get_script_dir() + "/http2-ws-paused-server.js", "0", dir.path + "/cert.pem",
            dir.path + "/key.pem"));
        on_error stopNode(p);
        hash<auto> node = {"process": p, "buf": "", "dir": dir};
        string line = readLine(\node);
        *string port = (line =~ x/^READY ([0-9]+)$/)[0];
        if (!exists port) {
            throw "TEST-ERROR", "the node server reported no port: " + line;
        }
        node.port = port.toInt();
        return node;
    }

    #! Returns the next line that the server printed
    private string readLine(reference<hash<auto>> node) {
        while (node.buf !~ /\n/) {
            *string s = node.process.readStdout(4096, HangGuard);
            if (!exists s) {
                throw "TEST-ERROR", sprintf("the node server printed no line: %s",
                    node.process.readStderr(4096, 0) ?? "");
            }
            node.buf += s;
        }
        int i = node.buf.find("\n");
        string line = node.buf.substr(0, i);
        node.buf = node.buf.substr(i + 1);
        return line;
    }

    private stopNode(Process p) {
        if (p.running()) {
            p.terminate();
        }
        p.wait();
    }

    #! Returns a client connected to the node server over HTTP/2
    private WebSocketClient connectNode(int port, timeout to) {
        WebSocketClient wsc(sub (*data msg) {}, {
            "url": sprintf("wss://127.0.0.1:%d/ws", port),
            "http_version": "2.0",
            "ssl_verify_cert": False,
            "timeout": to,
        });
        wsc.connect();
        assertTrue(wsc.isHttp2(), "the connection uses HTTP/2");
        return wsc;
    }
%endif

    #! Returns a connected client
    private WebSocketClient connect(string ver) {
        WebSocketClient wsc(sub (*data msg) {}, {
            "url": sprintf("wss://localhost:%d", port),
            "http_version": ver,
            "ssl_verify_cert": False,
        });
        wsc.connect();
        return wsc;
    }

    #! Returns a message of the given size whose every byte is the given value
    private static binary message(int n, int size) {
        return binary(strmul(chr(n), size));
    }
}
