    Regression tests for the WebSocket-over-HTTP/2 CONNECT connection-retry path.

    A connection that dies while it is still being established (the peer sends a
    FIN in the middle of the TLS handshake) used to fail WebSocketClient::connect()
    outright, even though every other HttpClientIo entry point retries such errors
    on a fresh connection.  See connectViaHcioAuto() in qlib/WebSocketClient.qm.
*/

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Mime
%requires Logger
%requires HttpServerUtil
%requires AsyncSocketIo
%requires HttpServerAsyncIo
%requires HttpServer
%requires HttpClientIo
%requires WebSocketUtil
%requires WebSocketHandler
%requires WebSocketClient
%requires ../../TestCertificates.qm

%exec-class WebSocketClientConnectRetryTest

#! Echoes text messages back with an "ECHO:" prefix
class EchoWsConnection inherits WebSocketConnection {
    constructor(WebSocketHandler handler) : WebSocketConnection(handler) {
    }

    gotMessage(string msg) {
        send("ECHO:" + msg);
    }
}

class EchoWsHandler inherits WebSocketHandler {
    WebSocketConnection getConnectionImpl(hash<auto> cx, hash<auto> hdr, string cid,
            *hash<auto> conn) {
        return new EchoWsConnection(self);
    }
}

#! A raw TCP relay that closes the first \a drop_count connections before relaying anything
/** This reproduces the CI failure mode exactly: the client completes the TCP connect and
    sends its TLS ClientHello, then the peer closes the connection, so SSL_connect() sees
    EOF and the connection is torn down with SOCKET-SSL-ERROR before the WebSocket CONNECT
    request is ever submitted on the stream.

    Connections after the first \a drop_count are relayed byte-for-byte to the backend, so
    a client that retries reaches the real HTTPS/HTTP2 server.
*/
class DropFirstRelay {
    public {
        #! Port the relay listens on
        int port;
    }

    private {
        Socket listener();
        int backend_port;
        int drop_count;
        Counter running(1);
        bool stop_flag = False;
        # number of inbound TCP connections accepted so far (atomic lvalue update)
        int conn_count = 0;
        Mutex relay_lock();
        list<Socket> relay_socks = ();
    }

    #! @param backend_port the HTTPS port to relay to
    #! @param drop_count how many initial connections to close without relaying
    constructor(int backend_port, int drop_count) {
        self.backend_port = backend_port;
        self.drop_count = drop_count;
        listener.bindINET("localhost", "0");
        listener.listen();
        port = listener.getSocketInfo().port;
        background acceptLoop();
    }

    #! Returns the number of inbound TCP connections accepted so far
    int getConnectionCount() {
        return conn_count;
    }

    stop() {
        stop_flag = True;
        try {
            listener.close();
        } catch (hash<ExceptionInfo> ex) {
        }
        {
            AutoLock al(relay_lock);
            foreach Socket s in (relay_socks) {
                try { s.close(); } catch (hash<ExceptionInfo> ex) {}
            }
            relay_socks = ();
        }
        running.waitForZero(20s);
    }

    private acceptLoop() {
        on_exit running.dec();
        while (!stop_flag) {
            *Socket c;
            try {
                c = listener.accept(250ms);
            } catch (hash<ExceptionInfo> ex) {
                if (stop_flag) {
                    return;
                }
                # accept() timeouts are expected while idle
                if (ex.err == "SOCKET-TIMEOUT") {
                    continue;
                }
                return;
            }
            if (!c) {
                continue;
            }
            ++conn_count;
            if (conn_count <= drop_count) {
                # close mid-handshake: the client has connected and will send its
                # ClientHello into a socket that is already gone
                try { c.close(); } catch (hash<ExceptionInfo> ex) {}
                continue;
            }
            background relay(c);
        }
    }

    private relay(Socket client) {
        Socket backend();
        try {
            backend.connectINET("localhost", string(backend_port), 10s);
        } catch (hash<ExceptionInfo> ex) {
            try { client.close(); } catch (hash<ExceptionInfo> ex2) {}
            return;
        }
        {
            AutoLock al(relay_lock);
            relay_socks += client;
            relay_socks += backend;
        }
        Counter dirs(2);
        background pump(client, backend, dirs);
        background pump(backend, client, dirs);
        dirs.waitForZero();
        try { client.close(); } catch (hash<ExceptionInfo> ex) {}
        try { backend.close(); } catch (hash<ExceptionInfo> ex) {}
    }

    #! Copies all available bytes from \a from to \a to until either side closes
    private pump(Socket from, Socket to, Counter dirs) {
        on_exit dirs.dec();
        while (!stop_flag) {
            *binary b;
            try {
                b = from.recvBinary(0, 250ms);
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err == "SOCKET-TIMEOUT") {
                    continue;
                }
                return;
            }
            if (!b) {
                return;
            }
            try {
                to.sendBinary(b);
            } catch (hash<ExceptionInfo> ex) {
                return;
            }
        }
    }
}

class WebSocketClientConnectRetryTest inherits Test {
    public {
        const CertPem = TestCertificates::CertPem;

        const KeyPem = TestCertificates::KeyPem;
    }

    private {
        HttpServer mServer;
        Logger mLogger;
        EchoWsHandler mWsHandler();
        int mSslPort;
    }

    constructor() : Test("WebSocketClientConnectRetryTest", "1.0") {
        addTestCase("connect retries a connection dropped during establishment",
            \testRetryAfterMidHandshakeDrop());
        addTestCase("retry budget is bounded by max_request_retries",
            \testRetryBudgetHonored());
        addTestCase("max_request_retries = 0 disables the retry",
            \testRetryDisabled());
        addTestCase("a healthy server needs exactly one connection",
            \testNoSpuriousRetry());

        set_return_value(main());
    }

    globalSetUp() {
        mLogger = new Logger("ws-connect-retry-test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            mLogger.addAppender(new StdoutAppender());
        }

        mServer = new HttpServer(<HttpServerOptionInfo>{
            "logger": mLogger,
            "debug": True,
        });
        mServer.setHandler("ws-handler", "/ws", NOTHING, mWsHandler);
        mSslPort = mServer.addListener(<HttpListenerOptionInfo>{
            "service": 0,
            "cert": new SSLCertificate(CertPem),
            "key": new SSLPrivateKey(KeyPem),
        }).port;
        mServer.waitForAsyncIo();
    }

    globalTearDown() {
        delete mServer;
    }

    #! Creates a WebSocket client pointed at \a port
    private WebSocketClient getWsClient(int port, code cb, *int max_request_retries) {
        hash<auto> opts = {
            "url": "wss://localhost:" + port + "/ws",
            "logger": mLogger,
            "http_version": "2.0",
            "ssl_verify_cert": False,
            "timeout": 30000,
        };
        if (exists max_request_retries) {
            opts.max_request_retries = max_request_retries;
        }
        return new WebSocketClient(cb, opts);
    }

    #! The connection dropped mid-TLS-handshake must be retried, and the WebSocket must work
    private testRetryAfterMidHandshakeDrop() {
        DropFirstRelay relay(mSslPort, 1);
        on_exit relay.stop();

        list<auto> msgs = ();
        Counter cnt(1);
        WebSocketClient wsc = getWsClient(relay.port, sub (*data msg) {
            if (exists msg) {
                msgs += msg;
                cnt.dec();
            }
        });
        on_exit delete wsc;

        wsc.connect();
        assertTrue(wsc.isHttp2(), "the retried connection is still HTTP/2");
        assertEq(2, relay.getConnectionCount(),
            "the dropped connection was retried exactly once");

        wsc.send("hello");
        cnt.waitForZero(20s);
        assertEq(1, msgs.size(), "the echo arrived on the retried connection");
        assertEq("ECHO:hello", msgs[0], "the retried connection carries WebSocket traffic");

        wsc.disconnect();
    }

    #! With every connection dropped, connect() fails after max_request_retries + 1 attempts
    private testRetryBudgetHonored() {
        # 1000 == "drop everything": the client can never get through
        DropFirstRelay relay(mSslPort, 1000);
        on_exit relay.stop();

        WebSocketClient wsc = getWsClient(relay.port, sub (*data msg) {}, 1);
        on_exit delete wsc;

        assertThrows("HTTPCLIENT-CONNECT-ERROR", \wsc.connect());
        assertEq(2, relay.getConnectionCount(),
            "max_request_retries = 1 means one initial attempt plus one retry");
    }

    #! max_request_retries = 0 must not retry at all
    private testRetryDisabled() {
        DropFirstRelay relay(mSslPort, 1000);
        on_exit relay.stop();

        WebSocketClient wsc = getWsClient(relay.port, sub (*data msg) {}, 0);
        on_exit delete wsc;

        assertThrows("HTTPCLIENT-CONNECT-ERROR", \wsc.connect());
        assertEq(1, relay.getConnectionCount(),
            "max_request_retries = 0 makes exactly one connection attempt");
    }

    #! A server that never drops anything must not trigger a retry
    private testNoSpuriousRetry() {
        DropFirstRelay relay(mSslPort, 0);
        on_exit relay.stop();

        list<auto> msgs = ();
        Counter cnt(1);
        WebSocketClient wsc = getWsClient(relay.port, sub (*data msg) {
            if (exists msg) {
                msgs += msg;
                cnt.dec();
            }
        });
        on_exit delete wsc;

        wsc.connect();
        assertEq(1, relay.getConnectionCount(), "a healthy connect makes exactly one connection");

        wsc.send("hi");
        cnt.waitForZero(20s);
        assertEq("ECHO:hi", msgs[0], "the first-attempt connection carries WebSocket traffic");

        wsc.disconnect();
    }
}
