#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Logger
%requires Mime
%requires HttpServerUtil
%requires HttpServer
%requires HttpServerAsyncIo
%requires GcpAuth

%requires json

%exec-class GcpAuthTest

# Fake token endpoint: accepts grant_type=urn:ietf:...jwt-bearer and emits a
# canned token response.  Used by the offline service-account JWT-bearer test.
class FakeGcpTokenHandler inherits AbstractHttpRequestHandler {
    public {
        string last_grant_type;
        string last_assertion;
        string last_path;
        string last_refresh_token;
        string last_client_id;
        int call_count = 0;
        hash<auto> token_response = {
            "access_token": "fake-access-token",
            "expires_in": 3600,
            "token_type": "Bearer",
        };
        # Toggle to return an HTTP 400-shaped error
        bool error_mode = False;
    }

    hash handleRequest(hash cx, hash hdr, *data body) {
        ++call_count;
        # parse form-encoded body
        string body_str = body ? body.toString("UTF-8") : "";
        hash<auto> form = {};
        foreach string pair in (body_str.split("&")) {
            list<string> kv = pair.split("=");
            if (kv.size() == 2) {
                form{decode_url(kv[0])} = decode_url(kv[1]);
            }
        }
        last_grant_type = form.grant_type ?? "";
        last_assertion = form.assertion ?? "";
        last_refresh_token = form.refresh_token ?? "";
        last_client_id = form.client_id ?? "";
        last_path = cx.raw_path ?? "";

        if (error_mode) {
            return makeResponse({"Content-Type": MimeTypeJson}, 400,
                "{\"error\":\"invalid_grant\",\"error_description\":\"test\"}");
        }
        return makeResponse({"Content-Type": MimeTypeJson}, 200,
            make_json(token_response));
    }
}

# Fake GCE metadata server: emits a canned token at the standard path.
class FakeGcpMetadataHandler inherits AbstractHttpRequestHandler {
    public {
        string last_header_metadata_flavor = "";
        int call_count = 0;
    }

    hash handleRequest(hash cx, hash hdr, *data body) {
        ++call_count;
        last_header_metadata_flavor = hdr."metadata-flavor" ?? "";
        return makeResponse({"Content-Type": MimeTypeJson}, 200,
            "{\"access_token\":\"mds-token\",\"expires_in\":1800,\"token_type\":\"Bearer\"}");
    }
}

public class GcpAuthTest inherits QUnit::Test {
    private {
        HttpServer token_http;
        HttpServer mds_http;
        int token_port;
        int mds_port;
        FakeGcpTokenHandler token_handler;
        FakeGcpMetadataHandler mds_handler;
        string sa_path;
        string au_path;
    }

    constructor() : Test("GcpAuth Test", "1.0") {
        addTestCase("service-account JWT-bearer round-trip",
            \saJwtBearerTest());
        addTestCase("service-account token cache hits",
            \saCacheTest());
        addTestCase("metadata-server token retrieval",
            \mdsTest());
        addTestCase("metadata-server sets Metadata-Flavor: Google",
            \mdsHeaderTest());
        addTestCase("ADC chain resolves to explicit SA path",
            \adcChainTest());
        addTestCase("authorized_user refresh-token round-trip",
            \authorizedUserTest());
        addTestCase("ADC chain dispatches authorized_user files",
            \adcChainAuthorizedUserTest());
        addTestCase("token endpoint is posted at its exact path",
            \exactTokenPathTest());
        addTestCase("missing access_token throws",
            \missingTokenErrorTest());

        try {
            setup();
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("setup error: %s\n", get_exception_string(ex));
            }
        }

        set_return_value(main());
    }

    private setup() {
        Logger logger("test", LoggerLevel::getLevelInfo());

        token_http = new HttpServer(<HttpServerOptionInfo>{"logger": logger});
        token_handler = new FakeGcpTokenHandler();
        token_http.setDefaultHandler("token", token_handler);
        token_port = token_http.addListener(<HttpListenerOptionInfo>{"service": 0}).port;

        mds_http = new HttpServer(<HttpServerOptionInfo>{"logger": logger});
        mds_handler = new FakeGcpMetadataHandler();
        mds_http.setDefaultHandler("mds", mds_handler);
        mds_port = mds_http.addListener(<HttpListenerOptionInfo>{"service": 0}).port;

        # write a usable RSA service-account file
        sa_path = tmp_location() + "/gcp_auth_test_sa_" + get_random_string(8) + ".json";
        File f();
        f.open2(sa_path, O_CREAT | O_WRONLY | O_TRUNC);
        f.write(make_json({
            "type": "service_account",
            "project_id": "test-project",
            "private_key_id": "key-id-1",
            "private_key": TestPrivateKey,
            "client_email": "test@test-project.iam.gserviceaccount.com",
            "token_uri": "http://localhost:" + token_port + "/token",
        }));
        f.close();

        # write a user ("authorized_user") ADC file, as produced by
        # "gcloud auth application-default login"
        au_path = tmp_location() + "/gcp_auth_test_au_" + get_random_string(8) + ".json";
        File af();
        af.open2(au_path, O_CREAT | O_WRONLY | O_TRUNC);
        af.write(make_json({
            "type": "authorized_user",
            "client_id": "test-client-id.apps.googleusercontent.com",
            "client_secret": "test-client-secret",
            "refresh_token": "test-refresh-token",
            "token_uri": "http://localhost:" + token_port + "/token",
            "quota_project_id": "test-project",
        }));
        af.close();
    }

    globalTearDown() {
        if (sa_path && is_file(sa_path)) {
            unlink(sa_path);
        }
        if (au_path && is_file(au_path)) {
            unlink(au_path);
        }
        delete token_http;
        delete mds_http;
    }

    static checkJson(Test test) {
    }

    private saJwtBearerTest() {
        GcpAuthTest::checkJson(self);
        if (!token_http || !mds_http) {
            testSkip("no HttpServer set up");
        }
        GcpAuth::clearTokenCache();
        token_handler.call_count = 0;

        string token = GcpAuth::getAccessTokenFromServiceAccountFile(sa_path,
            ("https://www.googleapis.com/auth/cloud-platform",));
        assertEq("fake-access-token", token);
        assertEq(1, token_handler.call_count);
        assertEq("urn:ietf:params:oauth:grant-type:jwt-bearer",
            token_handler.last_grant_type);
        # assertion looks like a JWT: header.payload.signature
        assertTrue(token_handler.last_assertion =~ /^[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-]+$/,
            "assertion must be a base64url-encoded JWT");

        # decode the payload and verify the scope claim is at the top level
        list<string> parts = token_handler.last_assertion.split(".");
        string b64 = parts[1];
        b64 += strmul("=", (4 - (b64.size() % 4)) % 4);
        b64 =~ s/-/+/g;
        b64 =~ s/_/\//g;
        binary raw = parse_base64_string(b64);
        hash<auto> payload = parse_json(raw.toString("UTF-8"));
        assertEq("test@test-project.iam.gserviceaccount.com", payload.iss);
        assertEq("http://localhost:" + token_port + "/token", payload.aud);
        assertEq("https://www.googleapis.com/auth/cloud-platform", payload.scope);
        assertTrue(payload.exp.typeCode() == NT_INT && payload.exp > payload.iat);
    }

    private saCacheTest() {
        GcpAuthTest::checkJson(self);
        if (!token_http || !mds_http) {
            testSkip("no HttpServer set up");
        }
        GcpAuth::clearTokenCache();
        token_handler.call_count = 0;

        list<string> scopes = ("https://www.googleapis.com/auth/cloud-platform",);
        # call N times; only the first must hit the token endpoint
        for (int i = 0; i < 3; ++i) {
            string token = GcpAuth::getAccessTokenFromServiceAccountFile(sa_path, scopes);
            assertEq("fake-access-token", token);
        }
        assertEq(1, token_handler.call_count, "cache must hit after first call");

        # force_refresh must re-fetch
        string token = GcpAuth::getAccessTokenFromServiceAccountFile(sa_path, scopes,
            {"force_refresh": True});
        assertEq("fake-access-token", token);
        assertEq(2, token_handler.call_count);
    }

    private mdsTest() {
        GcpAuthTest::checkJson(self);
        if (!token_http || !mds_http) {
            testSkip("no HttpServer set up");
        }
        GcpAuth::clearTokenCache();
        mds_handler.call_count = 0;

        string token = GcpAuth::getAccessTokenFromMetadataServer(
            ("https://www.googleapis.com/auth/cloud-platform",),
            {"metadata_endpoint": "http://localhost:" + mds_port});
        assertEq("mds-token", token);
        assertEq(1, mds_handler.call_count);

        # cache hit
        token = GcpAuth::getAccessTokenFromMetadataServer(
            ("https://www.googleapis.com/auth/cloud-platform",),
            {"metadata_endpoint": "http://localhost:" + mds_port});
        assertEq("mds-token", token);
        assertEq(1, mds_handler.call_count);
    }

    private mdsHeaderTest() {
        GcpAuthTest::checkJson(self);
        if (!token_http || !mds_http) {
            testSkip("no HttpServer set up");
        }
        GcpAuth::clearTokenCache();
        mds_handler.last_header_metadata_flavor = "";
        GcpAuth::getAccessTokenFromMetadataServer(("x",),
            {"metadata_endpoint": "http://localhost:" + mds_port});
        assertEq("Google", mds_handler.last_header_metadata_flavor,
            "GCP metadata server requires Metadata-Flavor: Google");
    }

    private adcChainTest() {
        GcpAuthTest::checkJson(self);
        if (!token_http || !mds_http) {
            testSkip("no HttpServer set up");
        }
        GcpAuth::clearTokenCache();
        token_handler.call_count = 0;

        # explicit path wins over env var
        string token = GcpAuth::getAccessToken(sa_path,
            ("https://www.googleapis.com/auth/cloud-platform",));
        assertEq("fake-access-token", token);
        assertEq(1, token_handler.call_count);

        # NOTHING + GOOGLE_APPLICATION_CREDENTIALS env var
        GcpAuth::clearTokenCache();
        token_handler.call_count = 0;
        *string saved_env = getenv("GOOGLE_APPLICATION_CREDENTIALS");
        on_exit {
            saved_env.val()
                ? setenv("GOOGLE_APPLICATION_CREDENTIALS", saved_env)
                : unsetenv("GOOGLE_APPLICATION_CREDENTIALS");
        }
        setenv("GOOGLE_APPLICATION_CREDENTIALS", sa_path);
        token = GcpAuth::getAccessToken(NOTHING,
            ("https://www.googleapis.com/auth/cloud-platform",));
        assertEq("fake-access-token", token);
        assertEq(1, token_handler.call_count);
    }

    private authorizedUserTest() {
        GcpAuthTest::checkJson(self);
        if (!token_http || !mds_http) {
            testSkip("no HttpServer set up");
        }
        GcpAuth::clearTokenCache();
        token_handler.call_count = 0;

        string token = GcpAuth::getAccessTokenFromAuthorizedUserFile(au_path);
        assertEq("fake-access-token", token, "refresh-token grant returns the access token");
        assertEq(1, token_handler.call_count);
        assertEq("refresh_token", token_handler.last_grant_type,
            "authorized_user credentials use the refresh_token grant");
        assertEq("test-refresh-token", token_handler.last_refresh_token);
        assertEq("test-client-id.apps.googleusercontent.com", token_handler.last_client_id);

        # second call must hit the cache (keyed by path)
        token = GcpAuth::getAccessTokenFromAuthorizedUserFile(au_path);
        assertEq("fake-access-token", token);
        assertEq(1, token_handler.call_count, "authorized_user token is cached");
    }

    private adcChainAuthorizedUserTest() {
        GcpAuthTest::checkJson(self);
        if (!token_http || !mds_http) {
            testSkip("no HttpServer set up");
        }
        GcpAuth::clearTokenCache();
        token_handler.call_count = 0;

        # getAccessToken() must detect the authorized_user type and use the
        # refresh-token grant (not the service-account JWT-bearer grant)
        string token = GcpAuth::getAccessToken(au_path,
            ("https://www.googleapis.com/auth/cloud-platform",));
        assertEq("fake-access-token", token);
        assertEq("refresh_token", token_handler.last_grant_type,
            "ADC chain dispatches authorized_user files to the refresh-token grant");
        assertEq("test-refresh-token", token_handler.last_refresh_token);
    }

    private exactTokenPathTest() {
        GcpAuthTest::checkJson(self);
        if (!token_http || !mds_http) {
            testSkip("no HttpServer set up");
        }
        # regression: the token endpoint must be posted at its exact path; an
        # empty relative path produced "/token/" (trailing slash), which the live
        # Google token endpoint rejects with HTTP 404
        GcpAuth::clearTokenCache();
        GcpAuth::getAccessTokenFromServiceAccountFile(sa_path,
            ("https://www.googleapis.com/auth/cloud-platform",), {"force_refresh": True});
        assertEq("/token", token_handler.last_path,
            "service-account token POST targets the exact path");

        GcpAuth::clearTokenCache();
        GcpAuth::getAccessTokenFromAuthorizedUserFile(au_path, {"force_refresh": True});
        assertEq("/token", token_handler.last_path,
            "authorized_user token POST targets the exact path");
    }

    private missingTokenErrorTest() {
        GcpAuthTest::checkJson(self);
        if (!token_http || !mds_http) {
            testSkip("no HttpServer set up");
        }
        GcpAuth::clearTokenCache();
        hash<auto> saved = token_handler.token_response;
        on_exit token_handler.token_response = saved;

        token_handler.token_response = {"expires_in": 60};  # no access_token
        assertThrows("GCP-AUTH-ERROR", sub () {
            GcpAuth::getAccessTokenFromServiceAccountFile(sa_path,
                ("https://www.googleapis.com/auth/cloud-platform",),
                {"force_refresh": True});
        });
    }

    # A 2048-bit RSA private key generated specifically for these tests.
    # Not used to sign anything that touches a real key escrow service.
