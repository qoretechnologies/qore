#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires Util
%requires QUnit
%requires Mime
%requires Logger
%requires HttpServerUtil
%requires ConnectionProvider
%requires RestClient
%requires MewsRestClient
%requires HttpServer
%requires RestClientIo

%requires json

%exec-class Main

#! A local Mews server that records requests
class FakeMewsHandler inherits AbstractHttpRequestHandler {
    public {
        #! the requests received
        list<hash<auto>> requests = ();
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        requests += {
            "method": hdr.method,
            "path": hdr.path,
            "body": body ? parse_json(body.toString()) : NOTHING,
        };
        return <HttpResponseInfo>{
            "code": 200,
            "hdr": {"Content-Type": MimeTypeJson},
            "body": make_json({"Enterprises": ()}),
        };
    }
}

public class Main inherits QUnit::Test {
    private {
        MewsRestConnection mrc;
        Logger logger;

        # command-line options
        const MyOpts = Opts + {
            "conn": "c,connection=s",
        };

        const OptionColumn = 22;
    }

    constructor() : Test("MewsRestClientTest", "1.0", \ARGV, MyOpts) {
        addTestCase("connection tests", \connectionTest());
        addTestCase("poll tests", \pollTest());
        addTestCase("local poll test", \localPollTest());

        try {
            setupConnection();
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose > 2) {
                printf("%s\n", get_exception_string(ex));
            } else if (m_options.verbose) {
                printf("%s: %s\n", ex.err, ex.desc);
            }
        }
        setupLogger();

        # Return for compatibility with test harness that checks return value.
        set_return_value(main());
    }

    setupLogger() {
        LoggerLevel ll;
        if (m_options.verbose > 3) {
            ll = LoggerLevel::LevelDebug;
        } else if (m_options.verbose > 2) {
            ll = LoggerLevel::LevelInfo;
        } else {
            ll = LoggerLevel::LevelWarn;
        }

        logger = new Logger("test", ll);
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }
    }

    tearDown() {
    }

    checkModule() {
    }

    connectionTest() {
        checkModule();
        hash<auto> fake_opts = {
            "access_token": "x",
            "client_token": "x",
        };
        try {
            MewsRestConnection rc({
                "url": "https://api.mews-demo.com",
                "name": "test",
                "desc": "test",
                "opts": fake_opts,
            });
            assertEq(True, rc instanceof MewsRestConnection);

            MewsRestClient client = rc.get(False);
            # issue #3321: check default timeouts
            assertEq(45000, client.getTimeout());
            assertEq(45000, client.getConnectTimeout());
        } catch (hash<ExceptionInfo> ex) {
            *softint status_code = ex.arg.status_code ?? (ex.desc =~ x/status_code: ([0-9]+)/[0]);
            if (status_code == 429 || status_code == 408) {
                remove mrc;
                testSkip("rate limited");
            }
            rethrow;
        }
    }

    #! A polling ping is made with the async client against a local server
    localPollTest() {
        HttpServer server(<HttpServerOptionInfo>{
            "logger": new Logger("server", LoggerLevel::getLevelError()),
        });
        on_exit server.stop();
        int port = server.addListener(<HttpListenerOptionInfo>{"service": 0}).port;
        FakeMewsHandler handler();
        server.setHandler("mews", "", NOTHING, handler);
        server.setDefaultHandler("mews", handler);

        MewsRestConnection conn({
            "name": "mews",
            "url": "http://localhost:" + port,
            "opts": {
                "client_token": "client-1",
                "access_token": "access-1",
                "client": "test-client",
            },
        }, {"monitor": False});
        AbstractPollOperation op = conn.startPollConnect();
        assertTrue(op instanceof RestClientIoPingPollOperation);
        while (*hash<SocketPollInfo> info = op.continuePoll()) {
            Socket::poll((info,), 10s);
        }
        assertTrue(op.goalReached());
        assertEq(1, handler.requests.size());
        assertEq(MewsRestConnection::DefaultMewsPingMethod, handler.requests[0].method);
        assertEq(MewsRestClientBase::DefaultUriPathPrefix + "/" + MewsRestConnection::DefaultMewsPingPath,
            handler.requests[0].path);
        # the tokens are sent in the body
        assertEq("client-1", handler.requests[0].body.ClientToken);
        assertEq("access-1", handler.requests[0].body.AccessToken);
        assertEq("test-client", handler.requests[0].body.Client);
    }

    pollTest() {
        checkModule();
        if (!mrc) {
            testSkip("no connection");
        }

        try {
            # first test a standard ping
            hash<PingInfo> ping = mrc.ping(True);
            assertTrue(ping.ok);
            assertEq("OK", ping.info);

            TestPollingConnectionMonitor monitor(logger);
            on_exit delete monitor;

            monitor.add(mrc);
            hash<auto> info = monitor.waitForResult();
            # check for rate limiting, timeout, or schema validation errors from the polling monitor
            if (info.result == "error" && info.ex) {
                *softint status_code = info.ex.arg.status_code
                    ?? (info.ex.desc =~ x/status_code: ([0-9]+)/[0])
                    ?? (info.ex.desc =~ x/HTTP\/[\d.]+ 429/);
                if (!status_code) {
                    *list<*string> m = (info.ex.desc =~ x/([5][0-9][0-9])/);
                    if (m) {
                        status_code = int(m[0]);
                    }
                }
                if (status_code == 429 || status_code == 408 || info.ex.desc =~ /429 Too Many Requests/) {
                    testSkip("rate limited");
                }
                if (status_code && status_code >= 500) {
                    testSkip("external service unavailable: HTTP " + status_code);
                }
                # skip if external API returns unexpected response (null body, etc)
                if (info.ex.err == "SCHEMA-VALIDATION-ERROR") {
                    testSkip("external API returned unexpected response: " + info.ex.desc);
                }
            }
            on_error if (info.ex) {
                printf("%s\n", get_exception_string(info.ex));
            }
            assertEq("OK", info.result);
        } catch (hash<ExceptionInfo> ex) {
            *softint status_code = ex.arg.status_code ?? (ex.desc =~ x/status_code: ([0-9]+)/[0]);
            if (!status_code) {
                *list<*string> m = (ex.desc =~ x/([5][0-9][0-9])/);
                if (m) {
                    status_code = int(m[0]);
                }
            }
            if (status_code == 429 || status_code == 408) {
                remove mrc;
                testSkip("rate limited");
            }
            if (status_code && status_code >= 500) {
                testSkip("external service unavailable: HTTP " + status_code);
            }
            rethrow;
        }
    }

    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-c,--conn=ARG", "set Mews connection name", OptionColumn);
    }

    private error(string fmt) {
        throw "OPTION-ERROR", sprintf("%s: ERROR: %s", get_script_name(), vsprintf(fmt, argv));
    }

    private setupConnection() {
        *string conn_name = m_options.conn ?? ENV.MEWS_CONNECTION;
        if (conn_name.val()) {
            AbstractConnection conn = get_connection(conn_name);
            if (!(conn instanceof MewsRestConnection)) {
                error("connection %y is type %y; expecting \"MewsRestConnection\"", conn_name, conn.className());
            }
            mrc = conn;
        } else {
            mrc = new MewsRestConnection({
                "url": "https://api.mews-demo.com",
                "name": "demo",
                "desc": "Connection to demo environment",
                "opts": {
                    "access_token": "C66EF7B239D24632943D115EDE9CB810-EA00F8FD8294692C940F6B5A8F9453D",
                    "client_token": "E0D439EE522F44368DC78E1BFB03710C-D24FB11DBE31D4621C4817E028D9E1D",
                },
            });
        }
    }
}

class TestPollingConnectionMonitor inherits PollingConnectionMonitor {
    private {
        Queue msgq();
    }

    constructor(*Logger logger) : PollingConnectionMonitor(logger) {
        ping_timeout = 5s;
    }

    hash<auto> waitForResult() {
        return msgq.get(ping_timeout);
    }

    private failedToStartPing(string name, hash<ExceptionInfo> ex) {
        PollingConnectionMonitor::failedToStartPing(name, ex);
        msgq.push({"name": name, "result": "error", "ex": ex});
    }

    private handlePingSuccess(string name, date delta, *bool oldok) {
        PollingConnectionMonitor::handlePingSuccess(name, delta, oldok);
        msgq.push({"name": name, "result": "OK"});
    }

    private handlePingFailed(string name, date delta, hash<ExceptionInfo> ex) {
        PollingConnectionMonitor::handlePingFailed(name, delta, ex);
        msgq.push({"name": name, "result": "error", "ex": ex});
    }

    private handlePingTimeout(string name, date delta) {
        PollingConnectionMonitor::handlePingTimeout(name, delta);
        msgq.push({"name": name, "result": "timeout"});
    }
}
