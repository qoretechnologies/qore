#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Mime.qm
%requires ../../../../qlib/MapperUtil.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/DataProvider
%requires ../../../../qlib/ConnectionProvider
%requires ../../../../qlib/RestClient.qm
%requires ../../../../qlib/CdsRestClient.qm
%requires ../../../../qlib/CdsRestDataProvider

%try-module json
%define NoJson
%endtry

%requires qore >= 2.0

%new-style
%require-types
%strict-args
%enable-all-warnings

%exec-class CdsRestDataProviderTest

sub checkModule() {
%ifdef NoJson
    throw "SKIPPED", "no json module";
%endif
}

class CdsRestDataProviderTest inherits QUnit::Test {
    public {}

    private {
        # Dynamics connection
        *CdsRestConnection dyn_conn;
        *CdsRestClient dyn_client;

        # Business Central connection
        *BusinessCentralRestConnection bc_conn;
        *CdsRestClient bc_client;

        Logger logger;

        # command-line options
        const MyOpts = Opts + {
            # Dynamics options
            "dyn_conn":           "d,dyn-connection=s",
            "dyn_client_id":      "I,dyn-client-id=s",
            "dyn_client_secret":  "S,dyn-client-secret=s",
            "dyn_url":            "U,dyn-url=s",
            # Business Central options
            "bc_conn":            "b,bc-connection=s",
            "bc_client_id":       "i,bc-client-id=s",
            "bc_client_secret":   "s,bc-client-secret=s",
            "bc_url":             "u,bc-url=s",
            "bc_tenant":          "T,bc-tenant=s",
            "bc_instance_type":   "e,bc-instance-type=s",
            # Common options
            "timeout":            "t,timeout=i",
        };

        const OptionColumn = 28;
    }

    constructor() : Test("CdsRestDataProviderTest", "1.0", \ARGV, MyOpts) {
        # Unit tests (no credentials required)
        addTestCase("Dynamics connection class tests", \dynamicsConnectionClassTests());
        addTestCase("Business Central connection class tests", \bcConnectionClassTests());
        addTestCase("Dynamics data provider class tests", \dynamicsDataProviderClassTests());
        addTestCase("Business Central data provider class tests", \bcDataProviderClassTests());
        addTestCase("Factory tests", \factoryTests());
        addTestCase("App registration tests", \appRegistrationTests());
        addTestCase("Expression support tests", \expressionSupportTests());
        addTestCase("Child provider summary info tests", \childProviderSummaryInfoTests());

        # Integration tests (require credentials)
        addTestCase("Dynamics DataProvider integration tests", \dynamicsDataProviderIntegrationTests());
        addTestCase("Business Central DataProvider integration tests", \bcDataProviderIntegrationTests());
        addTestCase("Business Central poll tests", \bcPollTests());
        addTestCase("Expression CRUD tests", \expressionCrudTests());

        try {
            setupDynamicsConnection();
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("Dynamics setup: %s: %s\n", ex.err, ex.desc);
            }
        }

        try {
            setupBcConnection();
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("Business Central setup: %s: %s\n", ex.err, ex.desc);
            }
        }

        logger = new Logger("test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }

        set_return_value(main());
    }

    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-d,--dyn-connection=ARG", "set Dynamics connection name", OptionColumn);
        printOption("-I,--dyn-client-id=ARG", "set Dynamics OAuth2 client ID", OptionColumn);
        printOption("-S,--dyn-client-secret=ARG", "set Dynamics OAuth2 client secret", OptionColumn);
        printOption("-U,--dyn-url=ARG", "URL for the Dynamics instance", OptionColumn);
        printOption("-b,--bc-connection=ARG", "set Business Central connection name", OptionColumn);
        printOption("-i,--bc-client-id=ARG", "set Business Central OAuth2 client ID", OptionColumn);
        printOption("-s,--bc-client-secret=ARG", "set Business Central OAuth2 client secret", OptionColumn);
        printOption("-u,--bc-url=ARG", "URL for the Business Central instance", OptionColumn);
        printOption("-T,--bc-tenant=ARG", "set Business Central Azure AD tenant", OptionColumn);
        printOption("-e,--bc-instance-type=ARG", "set Business Central instance type", OptionColumn);
        printOption("-t,--timeout=ARG", "set connection timeout in seconds", OptionColumn);
    }

    setupDynamicsConnection() {
        *string conn_name = m_options.dyn_conn ?? ENV.CDS_CONNECTION;
        if (conn_name) {
            AbstractConnection conn = get_connection(conn_name);
            if (!(conn instanceof CdsRestConnection)) {
                throw "CONNECTION-ERROR", sprintf("connection %y is type %y; expecting \"CdsRestConnection\"",
                    conn_name, conn.className());
            }
            dyn_conn = conn;
            dyn_client = conn.get(False);
            return;
        }

        hash<auto> opts;
        opts.url = m_options.dyn_url ?? ENV.CDS_URL;
        if (!opts.url) {
            return;
        }
        opts.oauth2_client_id = m_options.dyn_client_id ?? ENV.CDS_CLIENT_ID;
        if (!opts.oauth2_client_id) {
            return;
        }
        opts.oauth2_client_secret = m_options.dyn_client_secret ?? ENV.CDS_CLIENT_SECRET;
        if (!opts.oauth2_client_secret) {
            return;
        }
        if (m_options.timeout) {
            opts.connect_timeout = m_options.timeout;
        }

        dyn_client = new CdsRestClient(opts);
    }

    setupBcConnection() {
        *string conn_name = m_options.bc_conn ?? ENV.BC_CONNECTION;
        if (conn_name) {
            AbstractConnection conn = get_connection(conn_name);
            if (!(conn instanceof BusinessCentralRestConnection)) {
                throw "CONNECTION-ERROR", sprintf("connection %y is type %y; expecting "
                    "\"BusinessCentralRestConnection\"", conn_name, conn.className());
            }
            bc_conn = conn;
            bc_client = conn.get(False);
            return;
        }

        hash<auto> opts;
        opts.url = m_options.bc_url ?? ENV.BC_URL;
        if (!opts.url) {
            return;
        }
        opts.oauth2_client_id = m_options.bc_client_id ?? ENV.BC_CLIENT_ID;
        if (!opts.oauth2_client_id) {
            return;
        }
        opts.oauth2_client_secret = m_options.bc_client_secret ?? ENV.BC_CLIENT_SECRET;
        if (!opts.oauth2_client_secret) {
            return;
        }
        opts.tenant = m_options.bc_tenant ?? ENV.BC_TENANT;
        opts.instance_type = m_options.bc_instance_type ?? ENV.BC_INSTANCE_TYPE;
        if (m_options.timeout) {
            opts.connect_timeout = m_options.timeout;
        }

        bc_client = new CdsRestClient(opts + {"api_profile": "dynamics-business-central"});
    }

    #! Test Dynamics connection class creation
    dynamicsConnectionClassTests() {
        checkModule();
        string url = "https://example.crm.dynamics.com";

        # Test CdsRestConnection creation
        {
            CdsRestConnection conn({
                "name": "test-cds",
                "desc": "test CDS connection",
                "url": url,
                "opts": {
                    "oauth2_client_id": "test-client-id",
                    "oauth2_client_secret": "test-client-secret",
                },
            });
            assertEq(True, conn instanceof CdsRestConnection);
            assertEq("cdsrests", conn.getType());
            assertTrue(conn.hasDataProvider());
        }

        # Test DynamicsRestConnection creation
        {
            DynamicsRestConnection conn({
                "name": "test-dynamics",
                "desc": "test Dynamics connection",
                "url": url,
                "opts": {
                    "oauth2_client_id": "test-client-id",
                    "oauth2_client_secret": "test-client-secret",
                },
            });
            assertEq(True, conn instanceof DynamicsRestConnection);
            assertEq("dynamics", conn.getType());
            assertTrue(conn.hasDataProvider());
            assertEq("Dynamics", conn.getAppName());
        }

        # Test invalid option error
        assertThrows("CONNECTION-OPTION-ERROR", sub () {
            CdsRestConnection conn({
                "name": "test",
                "desc": "test",
                "url": url,
                "opts": {
                    "oauth2_client_id": "x",
                    "oauth2_client_secret": "x",
                    "invalid_option": 1,
                },
            });
        });
    }

    #! Test Business Central connection class creation
    bcConnectionClassTests() {
        checkModule();
        string url = "https://api.businesscentral.dynamics.com";

        # Test BusinessCentralRestConnection creation
        {
            BusinessCentralRestConnection conn({
                "name": "test-bc",
                "desc": "test Business Central connection",
                "url": url,
                "opts": {
                    "oauth2_client_id": "test-client-id",
                    "oauth2_client_secret": "test-client-secret",
                    "tenant": "test-tenant",
                    "instance_type": "sandbox",
                },
            });
            assertEq(True, conn instanceof BusinessCentralRestConnection);
            assertEq("bcrests", conn.getType());
            assertTrue(conn.hasDataProvider());
            assertEq("BusinessCentral", conn.getAppName());
        }

        # Test with default values
        {
            BusinessCentralRestConnection conn({
                "name": "test-bc-defaults",
                "desc": "test BC connection with defaults",
                "url": url,
                "opts": {
                    "oauth2_client_id": "test-client-id",
                    "oauth2_client_secret": "test-client-secret",
                    "instance_type": "sandbox",
                },
            });
            assertEq(True, conn instanceof BusinessCentralRestConnection);
            # Check that OAuth2 URLs use tenant
            string auth_url = conn.getAuthUrl();
            assertTrue(auth_url.find("login.microsoftonline.com") >= 0);
            string token_url = conn.getTokenUrl();
            assertTrue(token_url.find("login.microsoftonline.com") >= 0);
        }

        # Test with specific tenant
        {
            BusinessCentralRestConnection conn({
                "name": "test-bc-tenant",
                "desc": "test BC connection with tenant",
                "url": url,
                "opts": {
                    "oauth2_client_id": "test-client-id",
                    "oauth2_client_secret": "test-client-secret",
                    "tenant": "my-tenant-guid",
                    "instance_type": "production",
                },
            });
            string auth_url = conn.getAuthUrl();
            assertTrue(auth_url.find("my-tenant-guid") >= 0);
        }

        # Test invalid option error
        assertThrows("CONNECTION-OPTION-ERROR", sub () {
            BusinessCentralRestConnection conn({
                "name": "test",
                "desc": "test",
                "url": url,
                "opts": {
                    "oauth2_client_id": "x",
                    "oauth2_client_secret": "x",
                    "instance_type": "sandbox",
                    "invalid_option": 1,
                },
            });
        });

        # Test missing required instance_type option
        assertThrows("CONNECTION-OPTION-ERROR", sub () {
            BusinessCentralRestConnection conn({
                "name": "test-missing-instance",
                "desc": "test",
                "url": url,
                "opts": {
                    "oauth2_client_id": "x",
                    "oauth2_client_secret": "x",
                },
            });
        });
    }

    #! Test Dynamics data provider class structure
    dynamicsDataProviderClassTests() {
        checkModule();
        # Test CdsRestDataProvider class exists and has correct structure
        {
            hash<DataProviderInfo> info = CdsRestDataProvider::ProviderInfo;
            assertEq("CdsRestDataProvider", info.type);
            assertTrue(info.supports_children);
            assertTrue(info.children_can_support_records);
        }

        # Test ODataEntityDataProvider has correct static info for CDS
        # Note: supports_read, supports_create, etc. are set dynamically in getStaticInfoImpl()
        # based on entity metadata, so we check that search_options are defined
        {
            hash<DataProviderInfo> info = ODataEntityDataProvider::CdsProviderInfo;
            assertTrue(info.search_options.hasKey("columns"));
            assertTrue(info.search_options.hasKey("limit"));
            assertTrue(info.search_options.hasKey("orderby"));
        }

        # Test CdsRestDataProviderFactory
        {
            CdsRestDataProviderFactory factory();
            hash<DataProviderFactoryInfo> info = factory.getInfo();
            assertEq("cdsrest", info.name);
            assertTrue(info.children_can_support_records);
        }
    }

    #! Test Business Central data provider class structure
    bcDataProviderClassTests() {
        checkModule();
        # Test BcRestDataProvider class exists and has correct structure
        {
            hash<DataProviderInfo> info = BcRestDataProvider::ProviderInfo;
            assertEq("BcRestDataProvider", info.type);
            assertTrue(info.supports_children);
            assertTrue(info.children_can_support_records);
        }

        # Test ODataEntityDataProvider has correct static info for BC
        # The BcProviderInfo constant has static flags set
        {
            hash<DataProviderInfo> info = ODataEntityDataProvider::BcProviderInfo;
            assertEq("ODataEntityDataProvider", info.type);
            assertTrue(info.has_record);
            assertTrue(info.supports_read);
            assertTrue(info.supports_create);
            assertTrue(info.supports_update);
            assertTrue(info.supports_delete);
            assertTrue(info.supports_native_search);
            assertTrue(info.supports_upsert);
            assertTrue(info.search_options.hasKey("columns"));
            assertTrue(info.search_options.hasKey("limit"));
            assertTrue(info.search_options.hasKey("orderby"));
        }

        # Test BcCompaniesDataProvider has correct info
        {
            hash<DataProviderInfo> info = BcCompaniesDataProvider::ProviderInfo;
            assertEq("companies", info.name);
            assertTrue(info.supports_children);
        }

        # Test BcTablesDataProvider has correct info
        {
            hash<DataProviderInfo> info = BcTablesDataProvider::ProviderInfo;
            assertEq("tables", info.name);
            assertTrue(info.supports_children);
        }

        # Test BcRestDataProviderFactory
        {
            BcRestDataProviderFactory factory();
            hash<DataProviderFactoryInfo> info = factory.getInfo();
            assertEq("bcrest", info.name);
            assertTrue(info.children_can_support_records);
        }
    }

    #! Test factory registration
    factoryTests() {
        checkModule();
        # Test that factories are registered
        AbstractDataProviderFactory cds_factory = DataProvider::getFactory("cdsrest");
        assertEq(True, cds_factory instanceof CdsRestDataProviderFactory);

        AbstractDataProviderFactory bc_factory = DataProvider::getFactory("bcrest");
        assertEq(True, bc_factory instanceof BcRestDataProviderFactory);
    }

    #! Test app registration in action catalog
    appRegistrationTests() {
        checkModule();
        # Test that app names are defined
        assertEq("Dynamics", CdsRestDataProvider::DynamicsAppName);
        assertEq("BusinessCentral", CdsRestDataProvider::BusinessCentralAppName);
    }

    #! Test DataProvider expression support
    expressionSupportTests() {
        checkModule();
        # Test that ODataExpressions constant is defined with expected operators
        {
            assertTrue(ODataExpressions.hasKey(DP_OP_AND));
            assertTrue(ODataExpressions.hasKey(DP_OP_OR));
            assertTrue(ODataExpressions.hasKey(DP_SEARCH_OP_EQ));
            assertTrue(ODataExpressions.hasKey(DP_SEARCH_OP_NE));
            assertTrue(ODataExpressions.hasKey(DP_SEARCH_OP_LT));
            assertTrue(ODataExpressions.hasKey(DP_SEARCH_OP_LE));
            assertTrue(ODataExpressions.hasKey(DP_SEARCH_OP_GT));
            assertTrue(ODataExpressions.hasKey(DP_SEARCH_OP_GE));
            assertTrue(ODataExpressions.hasKey(DP_SEARCH_OP_NOT));
            assertTrue(ODataExpressions.hasKey(DP_SEARCH_OP_BETWEEN));
            assertTrue(ODataExpressions.hasKey(DP_SEARCH_OP_IN));
            assertTrue(ODataExpressions.hasKey(ODATA_OP_CONTAINS));
            assertTrue(ODataExpressions.hasKey(ODATA_OP_STARTSWITH));
            assertTrue(ODataExpressions.hasKey(ODATA_OP_ENDSWITH));
            assertTrue(ODataExpressions.hasKey(ODATA_OP_NULL));
            assertTrue(ODataExpressions.hasKey(ODATA_OP_NOT_NULL));
        }

        # Test that each expression has both "exp" and "impl" keys
        {
            foreach hash<auto> i in (ODataExpressions.pairIterator()) {
                assertTrue(i.value.hasKey("exp"), sprintf("expression %y missing 'exp' key", i.key));
                assertTrue(i.value.hasKey("impl"), sprintf("expression %y missing 'impl' key", i.key));
            }
        }

        # Test expression constants
        {
            assertEq("contains", ODATA_OP_CONTAINS);
            assertEq("startsWith", ODATA_OP_STARTSWITH);
            assertEq("endsWith", ODATA_OP_ENDSWITH);
            assertEq("null", ODATA_OP_NULL);
            assertEq("notNull", ODATA_OP_NOT_NULL);
        }

        # Test OData expression info structure for contains
        {
            hash<DataProviderExpressionInfo> contains_exp = ODataExpressions{ODATA_OP_CONTAINS}.exp;
            assertEq(DET_Operator, contains_exp.type);
            assertEq("contains", contains_exp.name);
            assertEq("contains", contains_exp.symbol);
            assertTrue(contains_exp.groups[0] == "String");
            assertEq(2, contains_exp.args.size());
            # Test that arg_info is present
            assertEq(2, contains_exp.arg_info.size());
            assertEq("Field", contains_exp.arg_info[0].display_name);
            assertEq("Substring", contains_exp.arg_info[1].display_name);
            assertEq("smith", contains_exp.arg_info[1].example_value);
        }

        # Test startsWith expression structure
        {
            hash<DataProviderExpressionInfo> exp = ODataExpressions{ODATA_OP_STARTSWITH}.exp;
            assertEq(DET_Operator, exp.type);
            assertEq("startsWith", exp.name);
            assertEq("startsWith", exp.symbol);
            assertTrue(exp.groups[0] == "String");
            assertEq(2, exp.args.size());
            assertEq(2, exp.arg_info.size());
            assertEq("A", exp.arg_info[1].example_value);
        }

        # Test endsWith expression structure
        {
            hash<DataProviderExpressionInfo> exp = ODataExpressions{ODATA_OP_ENDSWITH}.exp;
            assertEq(DET_Operator, exp.type);
            assertEq("endsWith", exp.name);
            assertEq("endsWith", exp.symbol);
            assertTrue(exp.groups[0] == "String");
            assertEq(2, exp.args.size());
            assertEq(2, exp.arg_info.size());
            assertEq(".com", exp.arg_info[1].example_value);
        }

        # Test null expression structure
        {
            hash<DataProviderExpressionInfo> exp = ODataExpressions{ODATA_OP_NULL}.exp;
            assertEq(DET_Operator, exp.type);
            assertEq("null", exp.name);
            assertEq("null", exp.symbol);
            assertTrue(exp.groups[0] == "Comparison");
            assertEq(1, exp.args.size());
            assertEq(1, exp.arg_info.size());
            assertEq("eq null", exp.arg_info[0].label_after);
        }

        # Test notNull expression structure
        {
            hash<DataProviderExpressionInfo> exp = ODataExpressions{ODATA_OP_NOT_NULL}.exp;
            assertEq(DET_Operator, exp.type);
            assertEq("notNull", exp.name);
            assertEq("notNull", exp.symbol);
            assertTrue(exp.groups[0] == "Comparison");
            assertEq(1, exp.args.size());
            assertEq(1, exp.arg_info.size());
            assertEq("ne null", exp.arg_info[0].label_after);
        }

        # Test comparison operators have proper arg_info with example values
        {
            hash<DataProviderExpressionInfo> eq_exp = ODataExpressions{DP_SEARCH_OP_EQ}.exp;
            assertEq(2, eq_exp.arg_info.size());
            assertEq("Smith", eq_exp.arg_info[1].example_value);

            hash<DataProviderExpressionInfo> between_exp = ODataExpressions{DP_SEARCH_OP_BETWEEN}.exp;
            assertEq(3, between_exp.arg_info.size());
            assertEq(100, between_exp.arg_info[1].example_value);
            assertEq(1000, between_exp.arg_info[2].example_value);

            hash<DataProviderExpressionInfo> in_exp = ODataExpressions{DP_SEARCH_OP_IN}.exp;
            assertEq(2, in_exp.arg_info.size());
            assertEq(("active", "pending"), in_exp.arg_info[1].example_value);
        }

        # Test that expression-to-filter conversion works correctly
        # We verify the expression structures are valid
        {
            # Test simple equality expression
            hash<DataProviderExpression> eq_exp = <DataProviderExpression>{
                "exp": DP_SEARCH_OP_EQ,
                "args": (<DataProviderFieldReference>{"field": "name"}, "Smith"),
            };

            # We can't directly test the iterator without a REST client,
            # but we can verify the expression structure is valid
            assertEq(DP_SEARCH_OP_EQ, eq_exp.exp);
            assertEq("name", cast<hash<DataProviderFieldReference>>(eq_exp.args[0]).field);
            assertEq("Smith", eq_exp.args[1]);

            # Test AND expression structure
            hash<DataProviderExpression> and_exp = <DataProviderExpression>{
                "exp": DP_OP_AND,
                "args": (
                    <DataProviderExpression>{
                        "exp": DP_SEARCH_OP_EQ,
                        "args": (<DataProviderFieldReference>{"field": "active"}, True),
                    },
                    <DataProviderExpression>{
                        "exp": DP_SEARCH_OP_GT,
                        "args": (<DataProviderFieldReference>{"field": "balance"}, 1000),
                    },
                ),
            };
            assertEq(DP_OP_AND, and_exp.exp);
            assertEq(2, and_exp.args.size());

            # Test nested OR inside AND expression structure
            hash<DataProviderExpression> nested_exp = <DataProviderExpression>{
                "exp": DP_OP_AND,
                "args": (
                    <DataProviderExpression>{
                        "exp": DP_OP_OR,
                        "args": (
                            <DataProviderExpression>{
                                "exp": DP_SEARCH_OP_EQ,
                                "args": (<DataProviderFieldReference>{"field": "name"}, "A"),
                            },
                            <DataProviderExpression>{
                                "exp": DP_SEARCH_OP_EQ,
                                "args": (<DataProviderFieldReference>{"field": "name"}, "B"),
                            },
                        ),
                    },
                    <DataProviderExpression>{
                        "exp": DP_SEARCH_OP_GT,
                        "args": (<DataProviderFieldReference>{"field": "balance"}, 0),
                    },
                ),
            };
            assertEq(DP_OP_AND, nested_exp.exp);
            assertEq(DP_OP_OR, cast<hash<DataProviderExpression>>(nested_exp.args[0]).exp);
        }
    }

    #! Test getChildProviderSummaryInfo() for Business Central data providers
    childProviderSummaryInfoTests() {
        checkModule();
        # Test BcCompaniesDataProvider.getChildProviderSummaryInfo() with mock data
        {
            MockCdsRestClient mock_client({"companies": (
                {"id": "comp-1", "name": "Company One", "displayName": "Company One Display"},
                {"id": "comp-2", "name": "Company Two"},
                {"id": "comp-3", "name": "Company Three", "displayName": "Third Company"},
            )});

            BcCompaniesDataProvider companies_dp(mock_client);

            # Test getChildProviderSummaryInfo returns info for each company
            *list<hash<DataProviderSummaryInfo>> summary = companies_dp.getChildProviderSummaryInfo();
            assertEq(3, summary.size(), "should return 3 company summaries");

            # Check first company: name is ID, display_name uses displayName
            assertEq("comp-1", summary[0].name);
            assertEq("Company One Display", summary[0].display_name);
            assertEq("BcCompanyDataProvider", summary[0].type);
            assertTrue(summary[0].supports_children);
            assertTrue(summary[0].children_can_support_records);

            # Check second company: display_name falls back to name when displayName is missing
            assertEq("comp-2", summary[1].name);
            assertEq("Company Two", summary[1].display_name);
            assertEq("BcCompanyDataProvider", summary[1].type);

            # Check third company: display_name uses displayName
            assertEq("comp-3", summary[2].name);
            assertEq("Third Company", summary[2].display_name);
            assertEq("BcCompanyDataProvider", summary[2].type);
        }

        # Test BcRestDataProvider.getChildProviderSummaryInfo() delegates to BcCompaniesDataProvider
        {
            MockCdsRestClient mock_client({"companies": (
                {"id": "test-company-id", "name": "Test Company", "displayName": "Test Co"},
            )});

            BcRestDataProvider dp(mock_client);

            # Test getChildProviderSummaryInfo returns company info, not static class info
            *list<hash<DataProviderSummaryInfo>> summary = dp.getChildProviderSummaryInfo();
            assertEq(1, summary.size(), "should return 1 company summary");

            # Verify it returns actual company info, not BcCompaniesDataProvider class info
            assertEq("test-company-id", summary[0].name, "name should be company ID");
            assertEq("Test Co", summary[0].display_name, "display_name should be human-readable name");
            assertEq("BcCompanyDataProvider", summary[0].type);
            assertTrue(summary[0].supports_children);
            assertTrue(summary[0].children_can_support_records);
        }

        # Negative test: empty companies list
        {
            MockCdsRestClient mock_client({"companies": ()});

            BcCompaniesDataProvider companies_dp(mock_client);
            *list<hash<DataProviderSummaryInfo>> summary = companies_dp.getChildProviderSummaryInfo();
            assertEq(0, summary.size(), "should return empty list when no companies");

            BcRestDataProvider dp(mock_client);
            summary = dp.getChildProviderSummaryInfo();
            assertEq(0, summary.size(), "BcRestDataProvider should return empty list when no companies");
        }

        # Negative test: companies with missing name/displayName fields - display_name should fall back to ID
        {
            MockCdsRestClient mock_client({"companies": (
                {"id": "no-name-company"},  # Missing both name and displayName
            )});

            BcCompaniesDataProvider companies_dp(mock_client);
            *list<hash<DataProviderSummaryInfo>> summary = companies_dp.getChildProviderSummaryInfo();
            assertEq(1, summary.size());
            # name is always the ID
            assertEq("no-name-company", summary[0].name);
            # display_name should fall back to ID when name/displayName are missing
            assertEq("no-name-company", summary[0].display_name);
            assertEq("BcCompanyDataProvider", summary[0].type);
        }

        # Negative test: empty displayName should fall back to name for display_name
        {
            MockCdsRestClient mock_client({"companies": (
                {"id": "empty-displayname", "name": "Real Name", "displayName": ""},
            )});

            BcCompaniesDataProvider companies_dp(mock_client);
            *list<hash<DataProviderSummaryInfo>> summary = companies_dp.getChildProviderSummaryInfo();
            assertEq(1, summary.size());
            assertEq("empty-displayname", summary[0].name);
            # Should skip empty displayName and use name for display_name
            assertEq("Real Name", summary[0].display_name);
        }

        # Negative test: empty displayName and name should fall back to ID for display_name
        {
            MockCdsRestClient mock_client({"companies": (
                {"id": "all-empty", "name": "", "displayName": ""},
            )});

            BcCompaniesDataProvider companies_dp(mock_client);
            *list<hash<DataProviderSummaryInfo>> summary = companies_dp.getChildProviderSummaryInfo();
            assertEq(1, summary.size());
            assertEq("all-empty", summary[0].name);
            # Should skip empty strings and fall back to ID for display_name
            assertEq("all-empty", summary[0].display_name);
        }

        # Test that getChildProviderNames matches getChildProviderSummaryInfo
        {
            MockCdsRestClient mock_client({"companies": (
                {"id": "comp-a", "name": "Alpha", "displayName": "Alpha Corp"},
                {"id": "comp-b", "name": "Beta"},
            )});

            BcCompaniesDataProvider companies_dp(mock_client);

            list<string> names = companies_dp.getChildProviderNames();
            *list<hash<DataProviderSummaryInfo>> summary = companies_dp.getChildProviderSummaryInfo();

            assertEq(names.size(), summary.size(), "names and summary should have same count");
        }

        # Test multiple calls return consistent results (caching)
        {
            MockCdsRestClient mock_client({"companies": (
                {"id": "cached-id", "name": "Cached Company"},
            )});

            BcCompaniesDataProvider companies_dp(mock_client);

            # First call
            *list<hash<DataProviderSummaryInfo>> summary1 = companies_dp.getChildProviderSummaryInfo();
            # Second call should return same data
            *list<hash<DataProviderSummaryInfo>> summary2 = companies_dp.getChildProviderSummaryInfo();

            assertEq(summary1.size(), summary2.size());
            assertEq(summary1[0].name, summary2[0].name);
            assertEq(summary1[0].display_name, summary2[0].display_name);
        }

        # Negative test: API error should propagate
        {
            MockCdsRestClientWithError mock_client("API-ERROR", "Mock API error");

            BcCompaniesDataProvider companies_dp(mock_client);
            assertThrows("API-ERROR", \companies_dp.getChildProviderSummaryInfo());
        }

        # Test with many companies
        {
            list<hash<auto>> many_companies = ();
            for (int i = 0; i < 100; i++) {
                many_companies += {"id": sprintf("company-%d", i), "name": sprintf("Company %d", i)};
            }
            MockCdsRestClient mock_client({"companies": many_companies});

            BcCompaniesDataProvider companies_dp(mock_client);
            *list<hash<DataProviderSummaryInfo>> summary = companies_dp.getChildProviderSummaryInfo();
            assertEq(100, summary.size(), "should return 100 company summaries");
            # name is the ID
            assertEq("company-0", summary[0].name);
            assertEq("company-99", summary[99].name);
            # display_name is the human-readable name
            assertEq("Company 0", summary[0].display_name);
            assertEq("Company 99", summary[99].display_name);
        }
    }

    #! Dynamics data provider integration tests
    dynamicsDataProviderIntegrationTests() {
        if (!dyn_client) {
            testSkip("no Dynamics connection");
        }

        CdsRestTablesDataProvider dp(dyn_client);

        assertFalse(dp.requiresTransactionManagement());

        # Test getting child provider names
        {
            list<string> children = dp.getChildProviderNames();
            assertEq(Type::List, children.type());
            assertTrue(children.size() > 0);
        }
    }

    #! Business Central data provider integration tests
    bcDataProviderIntegrationTests() {
        if (!bc_client) {
            testSkip("no Business Central connection");
        }

        BcRestDataProvider dp(bc_client);

        assertFalse(dp.requiresTransactionManagement());

        # Test getting child provider names (should have "companies")
        {
            list<string> children = dp.getChildProviderNames();
            assertEq(Type::List, children.type());
            assertTrue(children.size() > 0);
            hash<string, bool> child_map = map {$1: True}, children;
            assertTrue(child_map.companies);
        }

        # Test navigating to companies
        {
            AbstractDataProvider companies = dp.getChildProvider("companies");
            assertEq(True, companies instanceof BcCompaniesDataProvider);

            # Get list of companies
            list<string> company_names = companies.getChildProviderNames();
            if (company_names.size() > 0) {
                # Navigate to first company
                AbstractDataProvider company = companies.getChildProvider(company_names[0]);
                assertEq(True, company instanceof BcCompanyDataProvider);

                # Get tables from company
                AbstractDataProvider tables = company.getChildProvider("tables");
                assertEq(True, tables instanceof BcTablesDataProvider);

                # Get list of tables
                list<string> table_names = tables.getChildProviderNames();
                assertTrue(table_names.size() > 0);

                # Test that we can get a customer entity provider
                if (inlist("customers", table_names)) {
                    AbstractDataProvider customers = tables.getChildProvider("customers");
                    assertEq(True, customers instanceof ODataEntityDataProvider);

                    # Test search records
                    AbstractDataProviderRecordIterator iter = customers.searchRecords(NOTHING, {"limit": 1});
                    assertTrue(iter instanceof ODataRecordIterator);
                }
            }
        }
    }

    #! Business Central poll tests
    bcPollTests() {
        if (!bc_conn) {
            testSkip("no BusinessCentralRestConnection");
        }

        # Test a standard ping
        hash<PingInfo> ping = bc_conn.ping(True);
        assertTrue(ping.ok);
        assertEq("OK", ping.info);

        TestPollingConnectionMonitor monitor(logger);
        on_exit delete monitor;

        monitor.add(bc_conn);
        hash<auto> info = monitor.waitForResult();
        on_error if (info.ex) {
            printf("%s\n", get_exception_string(info.ex));
        }
        assertEq("OK", info.result);
    }

    #! Test update and delete operations with expressions
    expressionCrudTests() {
        if (!bc_client) {
            testSkip("no Business Central connection");
        }

        BcRestDataProvider dp(bc_client);

        # Navigate to companies and get the first one
        AbstractDataProvider companies = dp.getChildProvider("companies");
        list<string> company_names = companies.getChildProviderNames();
        if (!company_names) {
            testSkip("no companies available");
        }

        AbstractDataProvider company = companies.getChildProvider(company_names[0]);
        AbstractDataProvider tables = company.getChildProvider("tables");

        # Get vendors table for testing
        AbstractDataProvider vendors = tables.getChildProvider("vendors");
        assertEq(True, vendors instanceof ODataEntityDataProvider);

        # Generate a unique test vendor name
        string test_name = "QoreTestVendor_" + get_random_string(8);
        string test_city = "TestCity_" + get_random_string(4);
        *hash<auto> created_record;

        # Use on_exit to ensure cleanup even if test fails
        on_exit {
            if (created_record.id) {
                try {
                    vendors.deleteRecords({"id": created_record.id});
                } catch (hash<ExceptionInfo> ex) {
                    # Ignore cleanup errors - record may have been deleted by test
                }
            }
        }

        # Create a test vendor record
        {
            hash<auto> new_vendor = {
                "displayName": test_name,
                "addressLine1": "123 Test Street",
                "city": test_city,
            };
            created_record = vendors.createRecord(new_vendor);
            assertTrue(created_record.id.val());
            assertEq(test_name, created_record.displayName);
            assertEq(test_city, created_record.city);
        }

        # Test 1: Update with expression - update city using displayName match
        {
            string new_city = "UpdatedCity_" + get_random_string(4);
            hash<DataProviderExpression> where_exp = <DataProviderExpression>{
                "exp": DP_SEARCH_OP_EQ,
                "args": (<DataProviderFieldReference>{"field": "displayName"}, test_name),
            };

            int updated = vendors.updateRecords({"city": new_city}, where_exp);
            assertEq(1, updated, "should update exactly one record");

            # Verify the update
            AbstractDataProviderRecordIterator iter = vendors.searchRecords({"id": created_record.id});
            assertTrue(iter.next());
            hash<auto> record = iter.getValue();
            assertEq(new_city, record.city, "city should be updated");
        }

        # Test 2: Update with contains expression
        {
            string new_city = "ContainsCity_" + get_random_string(4);
            # Use contains to match part of the test name
            hash<DataProviderExpression> where_exp = <DataProviderExpression>{
                "exp": ODATA_OP_CONTAINS,
                "args": (<DataProviderFieldReference>{"field": "displayName"}, "QoreTestVendor_"),
            };

            int updated = vendors.updateRecords({"city": new_city}, where_exp);
            assertGe(updated, 1, "should update at least one record with contains");

            # Verify the update
            AbstractDataProviderRecordIterator iter = vendors.searchRecords({"id": created_record.id});
            assertTrue(iter.next());
            hash<auto> record = iter.getValue();
            assertEq(new_city, record.city, "city should be updated via contains expression");
        }

        # Test 3: Update with startsWith expression
        {
            string new_city = "StartsWithCity_" + get_random_string(4);
            hash<DataProviderExpression> where_exp = <DataProviderExpression>{
                "exp": ODATA_OP_STARTSWITH,
                "args": (<DataProviderFieldReference>{"field": "displayName"}, "QoreTest"),
            };

            int updated = vendors.updateRecords({"city": new_city}, where_exp);
            assertGe(updated, 1, "should update at least one record with startsWith");

            # Verify the update
            AbstractDataProviderRecordIterator iter = vendors.searchRecords({"id": created_record.id});
            assertTrue(iter.next());
            hash<auto> record = iter.getValue();
            assertEq(new_city, record.city, "city should be updated via startsWith expression");
        }

        # Test 4: Update with AND expression
        {
            string new_city = "AndExprCity_" + get_random_string(4);
            hash<DataProviderExpression> where_exp = <DataProviderExpression>{
                "exp": DP_OP_AND,
                "args": (
                    <DataProviderExpression>{
                        "exp": ODATA_OP_STARTSWITH,
                        "args": (<DataProviderFieldReference>{"field": "displayName"}, "QoreTest"),
                    },
                    <DataProviderExpression>{
                        "exp": ODATA_OP_CONTAINS,
                        "args": (<DataProviderFieldReference>{"field": "displayName"}, "Vendor_"),
                    },
                ),
            };

            int updated = vendors.updateRecords({"city": new_city}, where_exp);
            assertGe(updated, 1, "should update at least one record with AND expression");

            # Verify the update
            AbstractDataProviderRecordIterator iter = vendors.searchRecords({"id": created_record.id});
            assertTrue(iter.next());
            hash<auto> record = iter.getValue();
            assertEq(new_city, record.city, "city should be updated via AND expression");
        }

        # Test 5: Negative test - update with expression matching nothing
        {
            hash<DataProviderExpression> where_exp = <DataProviderExpression>{
                "exp": DP_SEARCH_OP_EQ,
                "args": (<DataProviderFieldReference>{"field": "displayName"}, "NonExistentVendor_XYZ_12345"),
            };

            int updated = vendors.updateRecords({"city": "ShouldNotUpdate"}, where_exp);
            assertEq(0, updated, "should update zero records when expression matches nothing");
        }

        # Test 6: Negative test - delete with expression matching nothing
        {
            hash<DataProviderExpression> where_exp = <DataProviderExpression>{
                "exp": DP_SEARCH_OP_EQ,
                "args": (<DataProviderFieldReference>{"field": "displayName"}, "NonExistentVendor_XYZ_12345"),
            };

            int deleted = vendors.deleteRecords(where_exp);
            assertEq(0, deleted, "should delete zero records when expression matches nothing");
        }

        # Test 7: Delete with expression - delete the test record
        {
            hash<DataProviderExpression> where_exp = <DataProviderExpression>{
                "exp": DP_SEARCH_OP_EQ,
                "args": (<DataProviderFieldReference>{"field": "displayName"}, test_name),
            };

            int deleted = vendors.deleteRecords(where_exp);
            assertEq(1, deleted, "should delete exactly one record");

            # Verify the delete
            AbstractDataProviderRecordIterator iter = vendors.searchRecords({"id": created_record.id});
            assertFalse(iter.next(), "record should be deleted");

            # Clear created_record so on_exit doesn't try to delete again
            delete created_record;
        }
    }
}

class TestPollingConnectionMonitor inherits PollingConnectionMonitor {
    private {
        Queue msgq();
    }

    constructor(*Logger logger) : PollingConnectionMonitor(logger) {
        ping_timeout = 5s;
    }

    hash<auto> waitForResult() {
        return msgq.get();
    }

    private failedToStartPing(string name, hash<ExceptionInfo> ex) {
        PollingConnectionMonitor::failedToStartPing(name, ex);
        msgq.push({"name": name, "result": "error", "ex": ex});
    }

    private handlePingSuccess(string name, date delta, *bool oldok) {
        PollingConnectionMonitor::handlePingSuccess(name, delta, oldok);
        msgq.push({"name": name, "result": "OK"});
    }

    private handlePingFailed(string name, date delta, hash<ExceptionInfo> ex) {
        PollingConnectionMonitor::handlePingFailed(name, delta, ex);
        msgq.push({"name": name, "result": "error", "ex": ex});
    }

    private handlePingTimeout(string name, date delta) {
        PollingConnectionMonitor::handlePingTimeout(name, delta);
        msgq.push({"name": name, "result": "timeout"});
    }
}

#! Mock CdsRestClient for unit testing without actual API credentials
class MockCdsRestClient inherits CdsRestClient {
    private {
        #! Mock data for API responses
        hash<auto> mock_data;
    }

    #! Creates a mock client with predefined response data
    /** @param data hash with mock data:
        - companies: list of company hashes to return from GET companies
    */
    constructor(hash<auto> data) : CdsRestClient({
        "url": "https://mock.example.com",
        "oauth2_client_id": "mock-client-id",
        "oauth2_client_secret": "mock-client-secret",
    }, True) {  # do_not_connect = True
        mock_data = data;
    }

    #! Override get() to return mock data
    hash<auto> get(string path, auto body, *reference<hash<auto>> info, *hash<auto> hdr) {
        if (path == "companies") {
            return {
                "body": {
                    "value": mock_data.companies ?? (),
                },
            };
        }
        throw "MOCK-ERROR", sprintf("Unexpected GET request to path: %y", path);
    }
}

#! Mock CdsRestClient that throws an error on any request
class MockCdsRestClientWithError inherits CdsRestClient {
    private {
        string error_code;
        string error_desc;
    }

    constructor(string err, string desc) : CdsRestClient({
        "url": "https://mock.example.com",
        "oauth2_client_id": "mock-client-id",
        "oauth2_client_secret": "mock-client-secret",
    }, True) {
        error_code = err;
        error_desc = desc;
    }

    hash<auto> get(string path, auto body, *reference<hash<auto>> info, *hash<auto> hdr) {
        # Populate info like the real client would before throwing
        info = {
            "request-uri": "https://mock.example.com/" + path,
            "response-code": 500,
            "response-body": "Mock error",
        };
        throw error_code, error_desc;
    }
}
