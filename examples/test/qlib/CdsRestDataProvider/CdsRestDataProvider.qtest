#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%requires ../../../../qlib/Util.qm
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Mime.qm
%requires ../../../../qlib/MapperUtil.qm
%requires ../../../../qlib/Logger.qm
%requires ../../../../qlib/DataProvider
%requires ../../../../qlib/ConnectionProvider
%requires ../../../../qlib/RestClient.qm
%requires ../../../../qlib/CdsRestClient.qm
%requires ../../../../qlib/CdsRestDataProvider

%try-module json
%define NoJson
%endtry

%requires qore >= 2.0

%new-style
%require-types
%strict-args
%enable-all-warnings

%exec-class CdsRestDataProviderTest

class CdsRestDataProviderTest inherits QUnit::Test {
    public {}

    private {
        # Dynamics connection
        *CdsRestConnection dyn_conn;
        *CdsRestClient dyn_client;

        # Business Central connection
        *BusinessCentralRestConnection bc_conn;
        *BusinessCentralRestClient bc_client;

        Logger logger;

        # command-line options
        const MyOpts = Opts + {
            # Dynamics options
            "dyn_conn":           "d,dyn-connection=s",
            "dyn_client_id":      "I,dyn-client-id=s",
            "dyn_client_secret":  "S,dyn-client-secret=s",
            "dyn_url":            "U,dyn-url=s",
            # Business Central options
            "bc_conn":            "b,bc-connection=s",
            "bc_client_id":       "i,bc-client-id=s",
            "bc_client_secret":   "s,bc-client-secret=s",
            "bc_url":             "u,bc-url=s",
            "bc_tenant":          "T,bc-tenant=s",
            "bc_instance_type":   "e,bc-instance-type=s",
            # Common options
            "timeout":            "t,timeout=i",
        };

        const OptionColumn = 22;
    }

    constructor() : Test("CdsRestDataProviderTest", "1.0", \ARGV, MyOpts) {
        # Unit tests (no credentials required)
        addTestCase("Dynamics connection class tests", \dynamicsConnectionClassTests());
        addTestCase("Business Central connection class tests", \bcConnectionClassTests());
        addTestCase("Dynamics data provider class tests", \dynamicsDataProviderClassTests());
        addTestCase("Business Central data provider class tests", \bcDataProviderClassTests());
        addTestCase("Factory tests", \factoryTests());
        addTestCase("App registration tests", \appRegistrationTests());

        # Integration tests (require credentials)
        addTestCase("Dynamics DataProvider integration tests", \dynamicsDataProviderIntegrationTests());
        addTestCase("Business Central DataProvider integration tests", \bcDataProviderIntegrationTests());
        addTestCase("Business Central poll tests", \bcPollTests());

        try {
            setupDynamicsConnection();
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("Dynamics setup: %s: %s\n", ex.err, ex.desc);
            }
        }

        try {
            setupBcConnection();
        } catch (hash<ExceptionInfo> ex) {
            if (m_options.verbose) {
                printf("Business Central setup: %s: %s\n", ex.err, ex.desc);
            }
        }

        logger = new Logger("test", LoggerLevel::getLevelInfo());
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        }

        set_return_value(main());
    }

    private usageIntern() {
        TestReporter::usageIntern(OptionColumn);
        printOption("-d,--dyn-connection=ARG", "set Dynamics connection name", OptionColumn);
        printOption("-I,--dyn-client-id=ARG", "set Dynamics OAuth2 client ID", OptionColumn);
        printOption("-S,--dyn-client-secret=ARG", "set Dynamics OAuth2 client secret", OptionColumn);
        printOption("-U,--dyn-url=ARG", "URL for the Dynamics instance", OptionColumn);
        printOption("-b,--bc-connection=ARG", "set Business Central connection name", OptionColumn);
        printOption("-i,--bc-client-id=ARG", "set Business Central OAuth2 client ID", OptionColumn);
        printOption("-s,--bc-client-secret=ARG", "set Business Central OAuth2 client secret", OptionColumn);
        printOption("-u,--bc-url=ARG", "URL for the Business Central instance", OptionColumn);
        printOption("-T,--bc-tenant=ARG", "set Business Central Azure AD tenant", OptionColumn);
        printOption("-e,--bc-instance-type=ARG", "set Business Central instance type", OptionColumn);
        printOption("-t,--timeout=ARG", "set connection timeout in seconds", OptionColumn);
    }

    setupDynamicsConnection() {
        *string conn_name = m_options.dyn_conn ?? ENV.CDS_CONNECTION;
        if (conn_name) {
            AbstractConnection conn = get_connection(conn_name);
            if (!(conn instanceof CdsRestConnection)) {
                throw "CONNECTION-ERROR", sprintf("connection %y is type %y; expecting \"CdsRestConnection\"",
                    conn_name, conn.className());
            }
            dyn_conn = conn;
            dyn_client = conn.get(False);
            return;
        }

        hash<auto> opts;
        opts.url = m_options.dyn_url ?? ENV.CDS_URL;
        if (!opts.url) {
            return;
        }
        opts.oauth2_client_id = m_options.dyn_client_id ?? ENV.CDS_CLIENT_ID;
        if (!opts.oauth2_client_id) {
            return;
        }
        opts.oauth2_client_secret = m_options.dyn_client_secret ?? ENV.CDS_CLIENT_SECRET;
        if (!opts.oauth2_client_secret) {
            return;
        }
        if (m_options.timeout) {
            opts.connect_timeout = m_options.timeout;
        }

        dyn_client = new CdsRestClient(opts);
    }

    setupBcConnection() {
        *string conn_name = m_options.bc_conn ?? ENV.BC_CONNECTION;
        if (conn_name) {
            AbstractConnection conn = get_connection(conn_name);
            if (!(conn instanceof BusinessCentralRestConnection)) {
                throw "CONNECTION-ERROR", sprintf("connection %y is type %y; expecting "
                    "\"BusinessCentralRestConnection\"", conn_name, conn.className());
            }
            bc_conn = conn;
            bc_client = conn.get(False);
            return;
        }

        hash<auto> opts;
        opts.url = m_options.bc_url ?? ENV.BC_URL;
        if (!opts.url) {
            return;
        }
        opts.oauth2_client_id = m_options.bc_client_id ?? ENV.BC_CLIENT_ID;
        if (!opts.oauth2_client_id) {
            return;
        }
        opts.oauth2_client_secret = m_options.bc_client_secret ?? ENV.BC_CLIENT_SECRET;
        if (!opts.oauth2_client_secret) {
            return;
        }
        opts.tenant = m_options.bc_tenant ?? ENV.BC_TENANT;
        opts.instance_type = m_options.bc_instance_type ?? ENV.BC_INSTANCE_TYPE;
        if (m_options.timeout) {
            opts.connect_timeout = m_options.timeout;
        }

        bc_client = new BusinessCentralRestClient(opts);
    }

    #! Test Dynamics connection class creation
    dynamicsConnectionClassTests() {
        string url = "https://example.crm.dynamics.com";

        # Test CdsRestConnection creation
        {
            CdsRestConnection conn({
                "name": "test-cds",
                "desc": "test CDS connection",
                "url": url,
                "opts": {
                    "oauth2_client_id": "test-client-id",
                    "oauth2_client_secret": "test-client-secret",
                },
            });
            assertEq(True, conn instanceof CdsRestConnection);
            assertEq("cdsrests", conn.getType());
            assertTrue(conn.hasDataProvider());
        }

        # Test DynamicsRestConnection creation
        {
            DynamicsRestConnection conn({
                "name": "test-dynamics",
                "desc": "test Dynamics connection",
                "url": url,
                "opts": {
                    "oauth2_client_id": "test-client-id",
                    "oauth2_client_secret": "test-client-secret",
                },
            });
            assertEq(True, conn instanceof DynamicsRestConnection);
            assertEq("dynamics", conn.getType());
            assertTrue(conn.hasDataProvider());
            assertEq("Dynamics", conn.getAppName());
        }

        # Test invalid option error
        assertThrows("CONNECTION-OPTION-ERROR", sub () {
            CdsRestConnection conn({
                "name": "test",
                "desc": "test",
                "url": url,
                "opts": {
                    "oauth2_client_id": "x",
                    "oauth2_client_secret": "x",
                    "invalid_option": 1,
                },
            });
        });
    }

    #! Test Business Central connection class creation
    bcConnectionClassTests() {
        string url = "https://api.businesscentral.dynamics.com";

        # Test BusinessCentralRestConnection creation
        {
            BusinessCentralRestConnection conn({
                "name": "test-bc",
                "desc": "test Business Central connection",
                "url": url,
                "opts": {
                    "oauth2_client_id": "test-client-id",
                    "oauth2_client_secret": "test-client-secret",
                    "tenant": "test-tenant",
                    "instance_type": "sandbox",
                },
            });
            assertEq(True, conn instanceof BusinessCentralRestConnection);
            assertEq("bcrests", conn.getType());
            assertTrue(conn.hasDataProvider());
            assertEq("BusinessCentral", conn.getAppName());
        }

        # Test with default values
        {
            BusinessCentralRestConnection conn({
                "name": "test-bc-defaults",
                "desc": "test BC connection with defaults",
                "url": url,
                "opts": {
                    "oauth2_client_id": "test-client-id",
                    "oauth2_client_secret": "test-client-secret",
                    "instance_type": "sandbox",
                },
            });
            assertEq(True, conn instanceof BusinessCentralRestConnection);
            # Check that OAuth2 URLs use tenant
            string auth_url = conn.getAuthUrl();
            assertTrue(auth_url.find("login.microsoftonline.com") >= 0);
            string token_url = conn.getTokenUrl();
            assertTrue(token_url.find("login.microsoftonline.com") >= 0);
        }

        # Test with specific tenant
        {
            BusinessCentralRestConnection conn({
                "name": "test-bc-tenant",
                "desc": "test BC connection with tenant",
                "url": url,
                "opts": {
                    "oauth2_client_id": "test-client-id",
                    "oauth2_client_secret": "test-client-secret",
                    "tenant": "my-tenant-guid",
                    "instance_type": "production",
                },
            });
            string auth_url = conn.getAuthUrl();
            assertTrue(auth_url.find("my-tenant-guid") >= 0);
        }

        # Test invalid option error
        assertThrows("CONNECTION-OPTION-ERROR", sub () {
            BusinessCentralRestConnection conn({
                "name": "test",
                "desc": "test",
                "url": url,
                "opts": {
                    "oauth2_client_id": "x",
                    "oauth2_client_secret": "x",
                    "instance_type": "sandbox",
                    "invalid_option": 1,
                },
            });
        });

        # Test missing required instance_type option
        assertThrows("CONNECTION-OPTION-ERROR", sub () {
            BusinessCentralRestConnection conn({
                "name": "test-missing-instance",
                "desc": "test",
                "url": url,
                "opts": {
                    "oauth2_client_id": "x",
                    "oauth2_client_secret": "x",
                },
            });
        });
    }

    #! Test Dynamics data provider class structure
    dynamicsDataProviderClassTests() {
        # Test CdsRestDataProvider class exists and has correct structure
        {
            hash<DataProviderInfo> info = CdsRestDataProvider::ProviderInfo;
            assertEq("CdsRestDataProvider", info.type);
            assertTrue(info.supports_children);
            assertTrue(info.children_can_support_records);
        }

        # Test CdsEntityDataProvider has correct static info
        # Note: supports_read, supports_create, etc. are set dynamically in getStaticInfoImpl()
        # based on entity metadata, so we check that search_options are defined
        {
            hash<DataProviderInfo> info = CdsEntityDataProvider::ProviderInfo;
            assertTrue(info.search_options.hasKey("columns"));
            assertTrue(info.search_options.hasKey("limit"));
            assertTrue(info.search_options.hasKey("orderby"));
        }

        # Test CdsRestDataProviderFactory
        {
            CdsRestDataProviderFactory factory();
            hash<DataProviderFactoryInfo> info = factory.getInfo();
            assertEq("cdsrest", info.name);
            assertTrue(info.children_can_support_records);
        }
    }

    #! Test Business Central data provider class structure
    bcDataProviderClassTests() {
        # Test BcRestDataProvider class exists and has correct structure
        {
            hash<DataProviderInfo> info = BcRestDataProvider::ProviderInfo;
            assertEq("BcRestDataProvider", info.type);
            assertTrue(info.supports_children);
            assertTrue(info.children_can_support_records);
        }

        # Test BcEntityDataProvider has correct static info
        # The ProviderInfo constant has static flags set (unlike CdsEntityDataProvider)
        {
            hash<DataProviderInfo> info = BcEntityDataProvider::ProviderInfo;
            assertEq("BcEntityDataProvider", info.type);
            assertTrue(info.has_record);
            assertTrue(info.supports_read);
            assertTrue(info.supports_create);
            assertTrue(info.supports_update);
            assertTrue(info.supports_delete);
            assertTrue(info.supports_native_search);
            assertTrue(info.supports_upsert);
            assertTrue(info.search_options.hasKey("columns"));
            assertTrue(info.search_options.hasKey("limit"));
            assertTrue(info.search_options.hasKey("orderby"));
        }

        # Test BcCompaniesDataProvider has correct info
        {
            hash<DataProviderInfo> info = BcCompaniesDataProvider::ProviderInfo;
            assertEq("companies", info.name);
            assertTrue(info.supports_children);
        }

        # Test BcTablesDataProvider has correct info
        {
            hash<DataProviderInfo> info = BcTablesDataProvider::ProviderInfo;
            assertEq("tables", info.name);
            assertTrue(info.supports_children);
        }

        # Test BcRestDataProviderFactory
        {
            BcRestDataProviderFactory factory();
            hash<DataProviderFactoryInfo> info = factory.getInfo();
            assertEq("bcrest", info.name);
            assertTrue(info.children_can_support_records);
        }
    }

    #! Test factory registration
    factoryTests() {
        # Test that factories are registered
        AbstractDataProviderFactory cds_factory = DataProvider::getFactory("cdsrest");
        assertEq(True, cds_factory instanceof CdsRestDataProviderFactory);

        AbstractDataProviderFactory bc_factory = DataProvider::getFactory("bcrest");
        assertEq(True, bc_factory instanceof BcRestDataProviderFactory);
    }

    #! Test app registration in action catalog
    appRegistrationTests() {
        # Test that app names are defined
        assertEq("Dynamics", CdsRestDataProvider::DynamicsAppName);
        assertEq("BusinessCentral", CdsRestDataProvider::BusinessCentralAppName);
    }

    #! Dynamics data provider integration tests
    dynamicsDataProviderIntegrationTests() {
        if (!dyn_client) {
            testSkip("no Dynamics connection");
        }

        CdsRestTablesDataProvider dp(dyn_client);

        assertFalse(dp.requiresTransactionManagement());

        # Test getting child provider names
        {
            list<string> children = dp.getChildProviderNames();
            assertEq(Type::List, children.type());
            assertTrue(children.size() > 0);
        }
    }

    #! Business Central data provider integration tests
    bcDataProviderIntegrationTests() {
        if (!bc_client) {
            testSkip("no Business Central connection");
        }

        BcRestDataProvider dp(bc_client);

        assertFalse(dp.requiresTransactionManagement());

        # Test getting child provider names (should have "companies")
        {
            list<string> children = dp.getChildProviderNames();
            assertEq(Type::List, children.type());
            assertTrue(children.size() > 0);
            hash<string, bool> child_map = map {$1: True}, children;
            assertTrue(child_map.companies);
        }

        # Test navigating to companies
        {
            AbstractDataProvider companies = dp.getChildProvider("companies");
            assertEq(True, companies instanceof BcCompaniesDataProvider);

            # Get list of companies
            list<string> company_names = companies.getChildProviderNames();
            if (company_names.size() > 0) {
                # Navigate to first company
                AbstractDataProvider company = companies.getChildProvider(company_names[0]);
                assertEq(True, company instanceof BcCompanyDataProvider);

                # Get tables from company
                AbstractDataProvider tables = company.getChildProvider("tables");
                assertEq(True, tables instanceof BcTablesDataProvider);

                # Get list of tables
                list<string> table_names = tables.getChildProviderNames();
                assertTrue(table_names.size() > 0);

                # Test that we can get a customer entity provider
                if (inlist("customers", table_names)) {
                    AbstractDataProvider customers = tables.getChildProvider("customers");
                    assertEq(True, customers instanceof BcEntityDataProvider);

                    # Test search records
                    AbstractDataProviderRecordIterator iter = customers.searchRecords(NOTHING, {"limit": 1});
                    assertTrue(iter instanceof BcRecordIterator);
                }
            }
        }
    }

    #! Business Central poll tests
    bcPollTests() {
        if (!bc_conn) {
            testSkip("no BusinessCentralRestConnection");
        }

        # Test a standard ping
        hash<PingInfo> ping = bc_conn.ping(True);
        assertTrue(ping.ok);
        assertEq("OK", ping.info);

        TestPollingConnectionMonitor monitor(logger);
        on_exit delete monitor;

        monitor.add(bc_conn);
        hash<auto> info = monitor.waitForResult();
        on_error if (info.ex) {
            printf("%s\n", get_exception_string(info.ex));
        }
        assertEq("OK", info.result);
    }
}

class TestPollingConnectionMonitor inherits PollingConnectionMonitor {
    private {
        Queue msgq();
    }

    constructor(*Logger logger) : PollingConnectionMonitor(logger) {
        ping_timeout = 5s;
    }

    hash<auto> waitForResult() {
        return msgq.get();
    }

    private failedToStartPing(string name, hash<ExceptionInfo> ex) {
        PollingConnectionMonitor::failedToStartPing(name, ex);
        msgq.push({"name": name, "result": "error", "ex": ex});
    }

    private handlePingSuccess(string name, date delta, *bool oldok) {
        PollingConnectionMonitor::handlePingSuccess(name, delta, oldok);
        msgq.push({"name": name, "result": "OK"});
    }

    private handlePingFailed(string name, date delta, hash<ExceptionInfo> ex) {
        PollingConnectionMonitor::handlePingFailed(name, delta, ex);
        msgq.push({"name": name, "result": "error", "ex": ex});
    }

    private handlePingTimeout(string name, date delta) {
        PollingConnectionMonitor::handlePingTimeout(name, delta);
        msgq.push({"name": name, "result": "timeout"});
    }
}
