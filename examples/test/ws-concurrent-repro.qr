#!/usr/bin/env qore
# Concurrent WS client test — N parallel clients doing large round-trips

%modern
%requires HttpServer
%requires HttpServerAsyncIo
%requires AsyncSocketIo
%requires WebSocketHandler
%requires WebSocketClient
%requires Logger
%requires DataProvider
%requires json
%requires TestCertificates.qm

class EchoConn inherits WebSocketConnection {
    constructor(WebSocketHandler h) : WebSocketConnection(h) {}
    gotMessage(string msg) {
        hash<auto> response = {"event": "ack", "len": msg.length()};
        try {
            hash<auto> req = parse_json(msg);
            if (req.request_id) {
                response.request_id = req.request_id;
            }
        } catch () {}
        send(make_json(response));
    }
}
class EchoHandler inherits WebSocketHandler {
    constructor() : WebSocketHandler() {}
    WebSocketConnection getConnectionImpl(hash<auto> cx, hash<auto> hdr, string cid) {
        return new EchoConn(self);
    }
}

class MyObs inherits DataProvider::Observer {
    private {
        Mutex m();
        hash<string, Condition> conds;
        hash<string, hash<auto>> responses;
    }

    update(string event_id, hash<auto> data_) {
        if (event_id == "ws-data-event") {
            hash<auto> msg = data_.data;
            *string rid = msg.request_id;
            if (rid.val()) {
                AutoLock al(m);
                if (conds.hasKey(rid)) {
                    responses{rid} = msg;
                    conds{rid}.signal();
                }
            }
        }
    }

    *hash<auto> waitFor(string rid, timeout t) {
        Condition cond();
        *hash<auto> rv;
        {
            AutoLock al(m);
            conds{rid} = cond;
            while (!responses.hasKey(rid)) {
                if (cond.wait(m, t) == ETIMEDOUT && !responses.hasKey(rid)) {
                    remove conds{rid};
                    return NOTHING;
                }
            }
            rv = responses{rid};
            remove conds{rid};
            remove responses{rid};
        }
        return rv;
    }
}

int nclients = int(ENV.NCLIENTS ?? 4);
int nbatches = int(ENV.NBATCHES ?? 10);
int sizeKb = int(ENV.SIZE ?? 1000);

printf("=== Concurrent WS Test: %d clients, %d batches each, %d KB ===\n",
    nclients, nbatches, sizeKb);

Logger logger("test", LoggerLevel::getLevelInfo());
HttpServer server(<HttpServerOptionInfo>{"logger": logger});
EchoHandler handler();
server.setDefaultHandler("ws", handler);

string cert_pem = TestCertificates::CertPem;

string key_pem = TestCertificates::KeyPem;

hash<auto> linfo = server.addListener(<HttpListenerOptionInfo>{
    "node": "localhost", "service": 0,
    "cert": new SSLCertificate(cert_pem),
    "key": new SSLPrivateKey(key_pem),
});
int port = linfo.port;
server.waitForAsyncIo();
printf("Server listening on port %d\n", port);

string padding = strmul("X", sizeKb * 1024);

sub runClient(int client_id, int srv_port, int nb, string pad, *reference<int> failures) {
    try {
        WebSocketClient::WebSocketClientWithSerialization ws({
            "url": sprintf("wss://localhost:%d/ws/test", srv_port),
            "data": "json",
            "ssl_verify_cert": False,
        });
        MyObs obs();
        ws.registerObserver(obs);
        ws.observersReady();
        for (int i = 0; i < nb; ++i) {
            string rid = sprintf("c%d-b%d", client_id, i);
            ws.sendData({"request_id": rid, "data": pad});
            *hash<auto> resp = obs.waitFor(rid, 30s);
            if (!resp) {
                printf("Client %d batch %d TIMEOUT\n", client_id, i);
                ++failures;
                break;
            }
        }
        ws.disconnect();
    } catch (hash<ExceptionInfo> ex) {
        printf("Client %d exception: %s: %s\n", client_id, ex.err, ex.desc);
        ++failures;
    }
}

Counter done(nclients);
int failures = 0;
Mutex fm();

date start = now_us();
for (int i = 0; i < nclients; ++i) {
    int cid = i;
    background sub () {
        int local_failures = 0;
        runClient(cid, port, nbatches, padding, \local_failures);
        {
            AutoLock al(fm);
            failures += local_failures;
        }
        done.dec();
    }();
}
done.waitForZero();
date elapsed = now_us() - start;

printf("\n=== Results: %d/%d clients x %d batches succeeded in %y (failures=%d) ===\n",
    nclients - failures, nclients, nbatches, elapsed, failures);

server.stop();
AsyncSocketIo::AsyncSocketIoController ctrl = AsyncSocketIo::getGlobalAsyncIoController();
ctrl.stopClear();

exit(failures ? 1 : 0);
