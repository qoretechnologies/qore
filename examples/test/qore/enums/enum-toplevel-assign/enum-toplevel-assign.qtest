#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes
# test-platform: macos - JIT and qcc code generation of enum stores and compound assignments in try blocks

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires ../../../TestInterpreter.qm
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class EnumTopLevelAssignTest

#! Tests that a value of an enum's base type stored in an enum variable raises RUNTIME-TYPE-ERROR (qore#6259)
/** An enum variable accepts only the values of its enum, as in the AST interpreter: a value of the base type given by
    a variable of no type, member or not, and the integer that a compound assignment (+=, ++, ...) computes from an
    int enum, raise RUNTIME-TYPE-ERROR, and the variable keeps its value; so do a float enum given a float, and a union
    with an enum, unless another of its types accepts the value.  The IR interpreter stored the plain value in a local
    variable that it did not keep in its own storage (a top-level local, a local of a try block), as its check took
    an enum type for its base type (qore#6197 checks an enum type, and qore#6259 a union with an enum member), and its
    fused integer +=, -=, ++ and -- operations stored the integer in any local; native code raised the error of the
    fused operations outside the try block (qore#6197).
    The checks are in enum-toplevel-assign-worker.qr, which is run in each execution mode, on the IR tier and as a
    program compiled with qcc -O0 and -O3; every run must give the results below.
*/
class EnumTopLevelAssignTest inherits QUnit::Test {
    public {
        #! the result of every check the worker makes
        const Expected = {
            "top-assign-member": "RUNTIME-TYPE-ERROR null nothing",
            "top-init-member": "RUNTIME-TYPE-ERROR",
            "top-init-other": "RUNTIME-TYPE-ERROR",
            "top-assign-member-2": "RUNTIME-TYPE-ERROR 1 enum<Color>",
            "top-assign-other": "RUNTIME-TYPE-ERROR 1 enum<Color>",
            "top-assign-enum": "3 enum<Color>",
            "top-or-nothing-init": "RUNTIME-TYPE-ERROR",
            "top-or-nothing-assign": "RUNTIME-TYPE-ERROR 1 enum<Color>",
            "top-or-nothing-assign-nothing": "null nothing",
            "top-string-init": "RUNTIME-TYPE-ERROR",
            "top-string-assign": "RUNTIME-TYPE-ERROR \"a\" enum<Name>",
            "top-string-assign-enum": "\"b\" enum<Name>",
            "top-float-init": "RUNTIME-TYPE-ERROR",
            "top-float-assign": "RUNTIME-TYPE-ERROR 2.0 enum<FColor>",
            "top-union-init": "RUNTIME-TYPE-ERROR",
            "top-union-assign": "RUNTIME-TYPE-ERROR \"s\" string",
            "top-or-nothing-union-init": "RUNTIME-TYPE-ERROR",
            "top-int-union-init": "3 integer",
            "top-loop-assign": "RUNTIME-TYPE-ERROR 2 enum<Color>",
            "top-closure-assign": "RUNTIME-TYPE-ERROR 1 enum<Color>",
            "top-plus-equals-const": "RUNTIME-TYPE-ERROR 1 enum<Color>",
            "top-plus-equals-auto": "RUNTIME-TYPE-ERROR 1 enum<Color>",
            "top-plus-equals-int": "RUNTIME-TYPE-ERROR 1 enum<Color>",
            "top-minus-equals": "RUNTIME-TYPE-ERROR 1 enum<Color>",
            "top-multiply-equals": "RUNTIME-TYPE-ERROR 1 enum<Color>",
            "top-or-equals": "RUNTIME-TYPE-ERROR 1 enum<Color>",
            "top-shift-left-equals": "RUNTIME-TYPE-ERROR 1 enum<Color>",
            "top-divide-equals": "RUNTIME-TYPE-ERROR 1 enum<Color>",
            "top-post-increment": "RUNTIME-TYPE-ERROR 1 enum<Color>",
            "top-pre-increment": "RUNTIME-TYPE-ERROR 1 enum<Color>",
            "top-post-decrement": "RUNTIME-TYPE-ERROR 1 enum<Color>",
            "top-pre-decrement": "RUNTIME-TYPE-ERROR 1 enum<Color>",
            "top-or-nothing-plus-equals": "RUNTIME-TYPE-ERROR 1 enum<Color>",
            "top-or-nothing-increment": "RUNTIME-TYPE-ERROR 1 enum<Color>",
            "global-assign": "RUNTIME-TYPE-ERROR 1 enum<Color>",
            "fn-init-member": "RUNTIME-TYPE-ERROR",
            "fn-init-other": "RUNTIME-TYPE-ERROR",
            "fn-assign-other": "RUNTIME-TYPE-ERROR 1 enum<Color>",
            "fn-or-nothing-init": "RUNTIME-TYPE-ERROR",
            "fn-string-init": "RUNTIME-TYPE-ERROR",
            "fn-float-init": "RUNTIME-TYPE-ERROR",
            "fn-union-init": "RUNTIME-TYPE-ERROR",
            "fn-plus-equals-const": "RUNTIME-TYPE-ERROR 1 enum<Color>",
            "fn-plus-equals-auto": "RUNTIME-TYPE-ERROR 1 enum<Color>",
            "fn-minus-equals": "RUNTIME-TYPE-ERROR 1 enum<Color>",
            "fn-multiply-equals": "RUNTIME-TYPE-ERROR 1 enum<Color>",
            "fn-shift-left-equals": "RUNTIME-TYPE-ERROR 1 enum<Color>",
            "fn-divide-equals": "RUNTIME-TYPE-ERROR 1 enum<Color>",
            "fn-post-increment": "RUNTIME-TYPE-ERROR 1 enum<Color>",
            "fn-pre-increment": "RUNTIME-TYPE-ERROR 1 enum<Color>",
            "fn-pre-decrement": "RUNTIME-TYPE-ERROR 1 enum<Color>",
            "fn-no-try-assign": "RUNTIME-TYPE-ERROR",
            "fn-no-try-plus-equals": "RUNTIME-TYPE-ERROR",
        };
    }

    private {
        string qore_bin;
        string libqore_dir;
        string qcc_bin;
    }

    constructor() : QUnit::Test("EnumTopLevelAssignTest", "1.0", \ARGV) {
        qore_bin = TestInterpreter::qore_interpreter();
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
            ?? (is_file(libqore_dir + DirSep + "qcc") ? libqore_dir + DirSep + "qcc"
                : dirname(qore_bin) + DirSep + "qcc");
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }

        addTestCase("each execution mode", \testExecModes());
        addTestCase("IR tier", \testIrTier());
        addTestCase("compiled program", \testCompiledProgram());

        set_return_value(main());
    }

    testExecModes() {
        foreach string mode in (ExecModeHarness::ExecModes) {
            string out = ExecModeHarness::run(sprintf("LD_LIBRARY_PATH=%s %s -b --enable-debug --exec-mode=%s %s",
                libqore_dir, qore_bin, mode, getWorker()));
            checkWorkerOutput(mode, out);
        }
    }

    #! every function runs on the IR tier, which the tiered run of ExecModes hardly runs
    testIrTier() {
        checkWorkerOutput("ir-tier", ExecModeHarness::run_ir_tier(sprintf("LD_LIBRARY_PATH=%s %s -b --enable-debug "
            "--exec-mode=tiered %s", libqore_dir, qore_bin, getWorker())));
    }

    testCompiledProgram() {
        TmpDir tmp("qore-enum-toplevel-assign-");
        foreach string opt in ("-O0", "-O3") {
            string exe = tmp.path + DirSep + "enum-toplevel-assign" + opt;
            string compile_out = backquote(sprintf("LD_LIBRARY_PATH=%s %s %s --strip-source -o %s %s 2>&1",
                libqore_dir, qcc_bin, opt, exe, getWorker()));
            assertTrue(is_file(exe), sprintf("compiled program (%s): %s", opt, compile_out));
            checkWorkerOutput("aot" + opt, backquote(sprintf("LD_LIBRARY_PATH=%s %s 2>&1", libqore_dir, exe)));
        }
    }

    private string getWorker() {
        return get_script_dir() + DirSep + "enum-toplevel-assign-worker.qr";
    }

    #! parses the "name=result" lines printed by the worker and checks them; any other output fails
    private checkWorkerOutput(string label, string out) {
        hash<string, string> results = {};
        foreach string line in (out.split("\n")) {
            *list<*string> parts = (line =~ x/^([-a-z0-9]+)=(.*)$/);
            if (!parts) {
                if (line.val()) {
                    fail(sprintf("%s: unexpected worker output: %y", label, out));
                }
                continue;
            }
            results{parts[0]} = parts[1];
        }
        assertEq(sort(keys Expected), sort(keys results), label + ": checks run");
        foreach hash<auto> i in (Expected.pairIterator()) {
            assertEq(i.value, results{i.key}, sprintf("%s: %s", label, i.key));
        }
    }
}
