#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires ../../../TestInterpreter.qm
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class EnumBaseTypeConversionTest

#! Tests the conversions between an enum and its base type that the enum documentation describes (qore#6237)
/** An enum value converts implicitly to its base type; a value of the base type is refused by an enum-typed
    variable or parameter, at parse time or at run time, and converts to the enum only with cast<enum<X>>(), which
    raises RUNTIME-CAST-ERROR for a value that is not a member.  The checks are in
    enum-base-type-conversion-worker.qr, which is run in each execution mode, on the IR tier and as a program
    compiled with qcc at -O0 and -O3; every run must give the results below.
*/
class EnumBaseTypeConversionTest inherits QUnit::Test {
    public {
        #! the result of every check the worker makes
        const Expected = {
            "enum-to-int": "integer:1",
            "enum-to-float": "float:2.0",
            "enum-to-string": "string:\"active\"",
            "enum-to-auto": "enum<Color>:3",
            "enum-to-int-param": "integer:2",
            "auto-int-to-enum-init": "RUNTIME-TYPE-ERROR",
            "auto-int-to-enum-assign": "RUNTIME-TYPE-ERROR",
            "auto-int-to-enum-param": "RUNTIME-OVERLOAD-ERROR",
            "or-nothing-int-to-or-nothing-enum": "RUNTIME-TYPE-ERROR",
            "or-nothing-nothing-to-or-nothing-enum": "nothing:null",
            "other-enum-to-enum": "RUNTIME-TYPE-ERROR",
            "auto-enum-to-enum": "enum<Color>:3",
            "cast-int-var": "enum<Color>:2",
            "cast-auto": "enum<Color>:3",
            "cast-literal-not-member": "RUNTIME-CAST-ERROR",
            "cast-auto-not-member": "RUNTIME-CAST-ERROR",
            "cast-string": "enum<Status>:\"active\"",
            "cast-string-not-member": "RUNTIME-CAST-ERROR",
            "cast-wrong-type": "RUNTIME-CAST-ERROR",
            "cast-float-to-int-enum": "RUNTIME-CAST-ERROR",
            "cast-string-to-int-enum": "RUNTIME-CAST-ERROR",
            "cast-nothing": "RUNTIME-CAST-ERROR",
            "cast-or-nothing-int-nothing": "RUNTIME-CAST-ERROR",
            "cast-or-nothing-nothing": "nothing:null",
            "cast-or-nothing-value": "enum<Status>:\"active\"",
            "cast-other-enum": "enum<Color>:1",
            "cast-other-enum-not-member": "RUNTIME-CAST-ERROR",
            "enum-back-to-int": "integer:2",
            "equals-base": "bool:True",
            "absolute-equals-base": "bool:False",
            "parse-int-literal-to-enum": "PARSE-TYPE-ERROR",
            "parse-int-var-to-enum": "PARSE-TYPE-ERROR",
            "parse-int-var-assign-to-enum": "PARSE-TYPE-ERROR",
            "parse-softint-to-enum": "PARSE-TYPE-ERROR",
            "parse-string-to-int-enum": "PARSE-TYPE-ERROR",
            "parse-int-literal-to-enum-param": "PARSE-TYPE-ERROR",
            "parse-int-var-to-enum-param": "PARSE-TYPE-ERROR",
            "parse-or-nothing-int-to-or-nothing-enum": "ok",
            "parse-enum-to-int": "ok",
            "parse-cast-int-var": "ok",
            "parse-cast-literal-not-member": "ok",
            "parse-cast-int-to-string-enum": "PARSE-EXCEPTION",
            "parse-cast-float-to-int-enum": "PARSE-EXCEPTION",
            "parse-cast-nothing-literal": "PARSE-EXCEPTION",
            "parse-cast-or-nothing-string-to-int-enum": "PARSE-EXCEPTION",
            "parse-cast-or-nothing-int": "ok",
            "parse-or-nothing-cast-nothing-literal": "ok",
        };
    }

    private {
        string qore_bin;
        string libqore_dir;
        string qcc_bin;
    }

    constructor() : QUnit::Test("EnumBaseTypeConversionTest", "1.0", \ARGV) {
        qore_bin = TestInterpreter::qore_interpreter();
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
            ?? (is_file(libqore_dir + DirSep + "qcc") ? libqore_dir + DirSep + "qcc"
                : dirname(qore_bin) + DirSep + "qcc");
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }

        addTestCase("each execution mode", \testExecModes());
        addTestCase("IR tier", \testIrTier());
        addTestCase("compiled program", \testCompiledProgram());

        set_return_value(main());
    }

    testExecModes() {
        foreach string mode in (ExecModeHarness::ExecModes) {
            string out = ExecModeHarness::run(sprintf("LD_LIBRARY_PATH=%s %s -b --enable-debug --exec-mode=%s %s",
                libqore_dir, qore_bin, mode, getWorker()));
            checkWorkerOutput(mode, out);
        }
    }

    #! every function runs on the IR tier, which the tiered run of ExecModes hardly runs
    testIrTier() {
        checkWorkerOutput("ir-tier", ExecModeHarness::run_ir_tier(sprintf("LD_LIBRARY_PATH=%s %s -b --enable-debug "
            "--exec-mode=tiered %s", libqore_dir, qore_bin, getWorker())));
    }

    testCompiledProgram() {
        TmpDir tmp("qore-enum-base-type-conversion-");
        foreach int opt in (0, 3) {
            string label = sprintf("aot -O%d", opt);
            string exe = tmp.path + DirSep + sprintf("enum-base-type-conversion-O%d", opt);
            string compile_out = backquote(sprintf("LD_LIBRARY_PATH=%s %s -O%d --strip-source -o %s %s 2>&1",
                libqore_dir, qcc_bin, opt, exe, getWorker()));
            assertTrue(is_file(exe), label + ": " + compile_out);
            checkWorkerOutput(label, backquote(sprintf("LD_LIBRARY_PATH=%s %s 2>&1", libqore_dir, exe)));
        }
    }

    private string getWorker() {
        return get_script_dir() + DirSep + "enum-base-type-conversion-worker.qr";
    }

    #! parses the "name=result" lines printed by the worker and checks them; any other output fails
    private checkWorkerOutput(string label, string out) {
        hash<string, string> results = {};
        foreach string line in (out.split("\n")) {
            *list<*string> parts = (line =~ x/^([-a-z]+)=(.*)$/);
            if (!parts) {
                if (line.val()) {
                    fail(sprintf("%s: unexpected worker output: %y", label, out));
                }
                continue;
            }
            results{parts[0]} = parts[1];
        }
        assertEq(sort(keys Expected), sort(keys results), label + ": checks run");
        foreach hash<auto> i in (Expected.pairIterator()) {
            assertEq(i.value, results{i.key}, sprintf("%s: %s", label, i.key));
        }
    }
}
