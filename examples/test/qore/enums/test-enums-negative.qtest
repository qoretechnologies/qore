#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern

%requires QUnit
%requires reflection

%exec-class EnumNegativeTest

class EnumNegativeTest inherits QUnit::Test {
    constructor() : Test("EnumNegativeTest", "1.0") {
        addTestCase("Test PO_NO_ENUM restriction", \testNoEnumRestriction());
        addTestCase("Test invalid enum base type", \testInvalidBaseType());
        addTestCase("Test unknown enum in reflection", \testUnknownEnum());
        addTestCase("Test unknown enum member in reflection", \testUnknownEnumMember());
        addTestCase("Test namespace getEnum error", \testNamespaceGetEnumError());
        addTestCase("Test cast<enum<X>> parse-time type mismatch", \testCastParseTimeMismatch());
        addTestCase("Test cast<enum<X>> with unknown enum", \testCastUnknownEnum());
        addTestCase("Test base-type to enum rejection", \testBaseToEnumRejection());
        addTestCase("Test base-type to enum param rejection", \testBaseToEnumParamRejection());
        addTestCase("Test enum to base type allowed", \testEnumToBaseAllowed());
        addTestCase("Test enum hard comparison with base type", \testEnumHardComparison());
        set_return_value(main());
    }

    testNoEnumRestriction() {
        # Test that PO_NO_ENUM prevents enum declarations
        string code = "
%modern
%no-enum
public enum TestEnum : int {
    A = 1,
}
";
        Program p(PO_NEW_STYLE);
        p.setParseOptions(PO_NO_ENUM);
        assertThrows("PARSE-EXCEPTION", \p.parse(), (code, "test"));
    }

    testInvalidBaseType() {
        # Test invalid base type for enum
        string code = "
%modern
public enum TestEnum : bool {
    A = True,
}
";
        Program p(PO_NEW_STYLE);
        assertThrows("PARSE-EXCEPTION", \p.parse(), (code, "test"));
    }

    testUnknownEnum() {
        # Test that trying to get unknown enum throws exception
        assertThrows("UNKNOWN-ENUM", \Enum::forName(), ("NonExistentEnum",));
    }

    testUnknownEnumMember() {
        # Create a simple enum for testing
        string code = "
%modern
public enum SimpleEnum : int {
    A = 1,
}
";
        Program p(PO_NEW_STYLE);
        p.parse(code, "test");

        # Get the enum
        Enum e = Enum::forName(p, "SimpleEnum");

        # Try to get non-existent member
        assertThrows("UNKNOWN-MEMBER", \e.getMember(), ("NonExistent",));
    }

    testNamespaceGetEnumError() {
        # Test getting non-existent enum from namespace throws error
        Namespace ns = Namespace::forName("::");
        assertThrows("UNKNOWN-ENUM", \ns.getEnum(), ("NonExistentEnum",));
    }

    testCastParseTimeMismatch() {
        # Test that casting from incompatible type at parse time raises error
        string code = "
%modern
public enum Status : string {
    Active = \"active\",
}
sub test() {
    int i = 123;
    Status s = cast<enum<Status>>(i);
}
";
        Program p(PO_NEW_STYLE | PO_REQUIRE_TYPES);
        assertThrows("PARSE-EXCEPTION", \p.parse(), (code, "test"));
    }

    testCastUnknownEnum() {
        # Test that casting to unknown enum at parse time raises error
        string code = "
%modern
sub test() {
    string s = \"test\";
    auto x = cast<enum<NonExistentEnum>>(s);
}
";
        Program p(PO_NEW_STYLE | PO_REQUIRE_TYPES);
        assertThrows("PARSE-EXCEPTION", \p.parse(), (code, "test"));
    }

    testBaseToEnumRejection() {
        # Test that assigning a bare base-type value to an enum variable is rejected at parse time
        string code = "
%modern
public enum Color : int {
    Red = 1,
    Green = 2,
}
sub test() {
    Color c = 42;
}
";
        Program p(PO_NEW_STYLE | PO_REQUIRE_TYPES);
        assertThrows("PARSE-TYPE-ERROR", \p.parse(), (code, "test"));
    }

    testBaseToEnumParamRejection() {
        # Test that passing a bare base-type value to an enum parameter is rejected at parse time
        string code = "
%modern
public enum Color : int {
    Red = 1,
    Green = 2,
}
sub foo(Color c) {}
sub test() {
    foo(42);
}
";
        Program p(PO_NEW_STYLE | PO_REQUIRE_TYPES);
        assertThrows("PARSE-TYPE-ERROR", \p.parse(), (code, "test"));
    }

    testEnumToBaseAllowed() {
        # Test that assigning an enum value to a base-type variable is allowed
        string code = "
%modern
public enum Color : int {
    Red = 1,
    Green = 2,
}
sub test() {
    int x = Color::Red;
}
";
        Program p(PO_NEW_STYLE | PO_REQUIRE_TYPES);
        # Should NOT throw — enum to base type is allowed
        p.parse(code, "test");
    }

    testEnumHardComparison() {
        # Test that hard comparison between enum and base type returns false (strict type safety)
        string code = "
%modern
public enum Color : int {
    Red = 1,
    Green = 2,
}
bool sub test() {
    return Color::Red === 1;
}
";
        Program p(PO_NEW_STYLE | PO_REQUIRE_TYPES);
        p.parse(code, "test");
        p.run();
        # enum !== base type — different types are never ===
        assertFalse(p.callFunction("test"));
    }
}
