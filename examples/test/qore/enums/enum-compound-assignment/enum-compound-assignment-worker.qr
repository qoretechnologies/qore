#! applies an operator to a EN local lvalue with no try block
sub en_local_raise(string op) {
    EN v = EN::OneHalf;
    switch (op) {
        case "pe": v += 1n; break;
        case "pri": ++v; break;
        case "pod": v--; break;
    }
}

#! each operator on an lvalue of type EN (local) in a function with no try block, whose error is caught here
hash<string, string> sub en_local_out() {
    hash<string, string> rv;
    foreach string op in ("pe", "pri", "pod") {
        try { en_local_raise(op); rv{op} = "none"; }
        catch (hash<ExceptionInfo> ex) { rv{op} = err_out(ex); }
    }
    return rv;
}

#! applies an operator to a EN closure lvalue with no try block
sub en_closure_raise(string op) {
    EN v = EN::OneHalf;
    code get = auto sub () { return v; };
    switch (op) {
        case "pe": v += 1n; break;
        case "pri": ++v; break;
        case "pod": v--; break;
    }
    get();
}

#! each operator on an lvalue of type EN (closure) in a function with no try block, whose error is caught here
hash<string, string> sub en_closure_out() {
    hash<string, string> rv;
    foreach string op in ("pe", "pri", "pod") {
        try { en_closure_raise(op); rv{op} = "none"; }
        catch (hash<ExceptionInfo> ex) { rv{op} = err_out(ex); }
    }
    return rv;
}

