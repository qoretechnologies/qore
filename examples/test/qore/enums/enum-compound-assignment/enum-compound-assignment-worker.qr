        try { v /= 1; rv.de = ok(v); } catch (hash<ExceptionInfo> ex) { rv.de = err(ex, v); }
    }
    {
        EI v = EI::Seven;
        try { v %= 4; rv.mo = ok(v); } catch (hash<ExceptionInfo> ex) { rv.mo = err(ex, v); }
    }
    {
        EI v = EI::Seven;
        try { v |= 8; rv.oe = ok(v); } catch (hash<ExceptionInfo> ex) { rv.oe = err(ex, v); }
    }
    {
        EI v = EI::Seven;
        try { v &= 3; rv.ae = ok(v); } catch (hash<ExceptionInfo> ex) { rv.ae = err(ex, v); }
    }
    {
        EI v = EI::Seven;
