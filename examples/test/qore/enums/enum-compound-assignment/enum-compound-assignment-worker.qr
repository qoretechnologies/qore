        case "pod": o.en--; break;
    }
}

#! each operator on an lvalue of type EN (member) in a function with no try block, whose error is caught here
hash<string, string> sub en_member_out() {
    hash<string, string> rv;
    Holder o();
    foreach string op in ("pe", "pri", "pod") {
        try { en_member_raise(op, o); rv{op} = ok(o.en); }
        catch (hash<ExceptionInfo> ex) { rv{op} = err(ex, o.en); }
    }
    return rv;
}

#! each operator on a local of type EN in a try block in a loop
hash<string, string> sub en_loop() {
    hash<string, string> rv;
    {
        EN v = EN::OneHalf;
        string r;
        for (int i = 0; i < 50; ++i) {
            try { v += 1n; r = ok(v); }
            catch (hash<ExceptionInfo> ex) { r = err(ex, v) + " (caught " + (i + 1) + ")"; }
        }
        rv.pe = r;
    }
    {
        EN v = EN::OneHalf;
        string r;
        for (int i = 0; i < 50; ++i) {
            try { ++v; r = ok(v); }
            catch (hash<ExceptionInfo> ex) { r = err(ex, v) + " (caught " + (i + 1) + ")"; }
        }
        rv.pri = r;
    }
    {
        EN v = EN::OneHalf;
        string r;
        for (int i = 0; i < 50; ++i) {
            try { v--; r = ok(v); }
            catch (hash<ExceptionInfo> ex) { r = err(ex, v) + " (caught " + (i + 1) + ")"; }
        }
        rv.pod = r;
    }
    return rv;
}

