#! each operator on an lvalue of type EI (member) in a try block
hash<string, string> sub ei_member_in() {
    hash<string, string> rv;
    {
        Holder o();
        try { o.ei += 1; rv.pe = ok(o.ei); } catch (hash<ExceptionInfo> ex) { rv.pe = err(ex, o.ei); }
    }
