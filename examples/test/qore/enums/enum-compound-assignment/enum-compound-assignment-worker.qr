        try { v += 1n; rv.pe = ok(v); } catch (hash<ExceptionInfo> ex) { rv.pe = err(ex, v); }
    }
    {
        *EN v;
        try { ++v; rv.pri = ok(v); } catch (hash<ExceptionInfo> ex) { rv.pri = err(ex, v); }
    }
    {
        *EN v;
        try { v--; rv.pod = ok(v); } catch (hash<ExceptionInfo> ex) { rv.pod = err(ex, v); }
    }
    print_results("enonv-toplevel", rv);
}
{
    hash<string, string> rv;
    {
        ESS v;
        try { v += "x"; rv.pe = ok(v); } catch (hash<ExceptionInfo> ex) { rv.pe = err(ex, v); }
    }
    {
        ESS v;
        try { v += 1; rv."pe-int" = ok(v); } catch (hash<ExceptionInfo> ex) { rv."pe-int" = err(ex, v); }
    }
    print_results("essnv-toplevel", rv);
}
