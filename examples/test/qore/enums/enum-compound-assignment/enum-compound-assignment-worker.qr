#! each operator on a local of type EI in a try block in a loop
hash<string, string> sub ei_loop() {
    hash<string, string> rv;
    {
        EI v = EI::Seven;
        string r;
        for (int i = 0; i < 50; ++i) {
            try { v += 1; r = ok(v); }
            catch (hash<ExceptionInfo> ex) { r = err(ex, v) + " (caught " + (i + 1) + ")"; }
        }
        rv.pe = r;
    }
    {
        EI v = EI::Seven;
        string r;
        for (int i = 0; i < 50; ++i) {
            try { v -= 1; r = ok(v); }
            catch (hash<ExceptionInfo> ex) { r = err(ex, v) + " (caught " + (i + 1) + ")"; }
        }
        rv.me = r;
    }
    {
        EI v = EI::Seven;
        string r;
        for (int i = 0; i < 50; ++i) {
            try { v *= 2; r = ok(v); }
            catch (hash<ExceptionInfo> ex) { r = err(ex, v) + " (caught " + (i + 1) + ")"; }
        }
        rv.te = r;
    }
    {
        EI v = EI::Seven;
        string r;
        for (int i = 0; i < 50; ++i) {
            try { v /= 1; r = ok(v); }
            catch (hash<ExceptionInfo> ex) { r = err(ex, v) + " (caught " + (i + 1) + ")"; }
        }
        rv.de = r;
    }
    {
        EI v = EI::Seven;
        string r;
        for (int i = 0; i < 50; ++i) {
            try { v %= 4; r = ok(v); }
            catch (hash<ExceptionInfo> ex) { r = err(ex, v) + " (caught " + (i + 1) + ")"; }
        }
        rv.mo = r;
    }
    {
        EI v = EI::Seven;
        string r;
        for (int i = 0; i < 50; ++i) {
            try { v |= 8; r = ok(v); }
            catch (hash<ExceptionInfo> ex) { r = err(ex, v) + " (caught " + (i + 1) + ")"; }
        }
        rv.oe = r;
    }
    {
        EI v = EI::Seven;
        string r;
        for (int i = 0; i < 50; ++i) {
            try { v &= 3; r = ok(v); }
            catch (hash<ExceptionInfo> ex) { r = err(ex, v) + " (caught " + (i + 1) + ")"; }
        }
        rv.ae = r;
    }
    {
        EI v = EI::Seven;
        string r;
        for (int i = 0; i < 50; ++i) {
            try { v ^= 1; r = ok(v); }
            catch (hash<ExceptionInfo> ex) { r = err(ex, v) + " (caught " + (i + 1) + ")"; }
        }
        rv.xe = r;
    }
    {
        EI v = EI::Seven;
        string r;
        for (int i = 0; i < 50; ++i) {
            try { v <<= 1; r = ok(v); }
            catch (hash<ExceptionInfo> ex) { r = err(ex, v) + " (caught " + (i + 1) + ")"; }
        }
        rv.sl = r;
    }
    {
        EI v = EI::Seven;
        string r;
        for (int i = 0; i < 50; ++i) {
            try { v >>= 1; r = ok(v); }
            catch (hash<ExceptionInfo> ex) { r = err(ex, v) + " (caught " + (i + 1) + ")"; }
        }
        rv.sr = r;
    }
    {
        EI v = EI::Seven;
        string r;
        for (int i = 0; i < 50; ++i) {
            try { ++v; r = ok(v); }
            catch (hash<ExceptionInfo> ex) { r = err(ex, v) + " (caught " + (i + 1) + ")"; }
        }
        rv.pri = r;
    }
    {
        EI v = EI::Seven;
        string r;
        for (int i = 0; i < 50; ++i) {
            try { v++; r = ok(v); }
            catch (hash<ExceptionInfo> ex) { r = err(ex, v) + " (caught " + (i + 1) + ")"; }
        }
        rv.poi = r;
    }
    {
        EI v = EI::Seven;
        string r;
        for (int i = 0; i < 50; ++i) {
            try { --v; r = ok(v); }
            catch (hash<ExceptionInfo> ex) { r = err(ex, v) + " (caught " + (i + 1) + ")"; }
        }
        rv.prd = r;
    }
    {
        EI v = EI::Seven;
        string r;
        for (int i = 0; i < 50; ++i) {
            try { v--; r = ok(v); }
            catch (hash<ExceptionInfo> ex) { r = err(ex, v) + " (caught " + (i + 1) + ")"; }
        }
        rv.pod = r;
    }
    {
        EI v = EI::Seven;
        int src = 1;
        string r;
        for (int i = 0; i < 50; ++i) {
            try { v += src; r = ok(v); }
            catch (hash<ExceptionInfo> ex) { r = err(ex, v) + " (caught " + (i + 1) + ")"; }
        }
        rv."pe-src" = r;
    }
    {
        EI v = EI::Seven;
        int src = 1;
        string r;
        for (int i = 0; i < 50; ++i) {
            try { v -= src; r = ok(v); }
            catch (hash<ExceptionInfo> ex) { r = err(ex, v) + " (caught " + (i + 1) + ")"; }
        }
        rv."me-src" = r;
    }
    return rv;
}

#! each operator on an lvalue of type EF (local) in a try block
hash<string, string> sub ef_local_in() {
    hash<string, string> rv;
    {
        EF v = EF::Half;
        try { v += 0.5; rv.pe = ok(v); } catch (hash<ExceptionInfo> ex) { rv.pe = err(ex, v); }
    }
    {
        EF v = EF::Half;
        try { v -= 0.5; rv.me = ok(v); } catch (hash<ExceptionInfo> ex) { rv.me = err(ex, v); }
    }
    {
        EF v = EF::Half;
        try { v *= 2.0; rv.te = ok(v); } catch (hash<ExceptionInfo> ex) { rv.te = err(ex, v); }
    }
    {
        EF v = EF::Half;
        try { ++v; rv.pri = ok(v); } catch (hash<ExceptionInfo> ex) { rv.pri = err(ex, v); }
    }
    {
        EF v = EF::Half;
        try { v--; rv.pod = ok(v); } catch (hash<ExceptionInfo> ex) { rv.pod = err(ex, v); }
    }
    return rv;
}

