        catch (hash<ExceptionInfo> ex) { rv."closure-pe-auto" = err(ex, get()); }
    }
    {
        EI v = EI::Seven;
        code get = auto sub () { return v; };
        auto a = 1;
        try { v -= a; rv."closure-me-auto" = ok(get()); }
        catch (hash<ExceptionInfo> ex) { rv."closure-me-auto" = err(ex, get()); }
    }
    {
        EI v = EI::Seven;
        code get = auto sub () { return v; };
        auto a = 8;
        try { v = a; rv."closure-assign-auto" = ok(get()); }
        catch (hash<ExceptionInfo> ex) { rv."closure-assign-auto" = err(ex, get()); }
    }
    {
        EI v = EI::Seven;
        code get = auto sub () { return v; };
        auto a = EI::Eight;
        try { v = a; rv."closure-assign-enum" = ok(get()); }
        catch (hash<ExceptionInfo> ex) { rv."closure-assign-enum" = err(ex, get()); }
    }
    {
        g_ei = EI::Seven;
        auto a = 1;
        try { g_ei += a; rv."global-pe-auto" = ok(g_ei); }
        catch (hash<ExceptionInfo> ex) { rv."global-pe-auto" = err(ex, g_ei); }
    }
    {
        g_ei = EI::Seven;
        auto a = 1;
        try { g_ei -= a; rv."global-me-auto" = ok(g_ei); }
        catch (hash<ExceptionInfo> ex) { rv."global-me-auto" = err(ex, g_ei); }
    }
    {
        g_ei = EI::Seven;
        auto a = 8;
        try { g_ei = a; rv."global-assign-auto" = ok(g_ei); }
        catch (hash<ExceptionInfo> ex) { rv."global-assign-auto" = err(ex, g_ei); }
    }
    {
        g_ei = EI::Seven;
        auto a = EI::Eight;
        try { g_ei = a; rv."global-assign-enum" = ok(g_ei); }
        catch (hash<ExceptionInfo> ex) { rv."global-assign-enum" = err(ex, g_ei); }
    }
    {
        Holder o();
        auto a = 1;
        try { o.ei += a; rv."member-pe-auto" = ok(o.ei); }
        catch (hash<ExceptionInfo> ex) { rv."member-pe-auto" = err(ex, o.ei); }
    }
    {
        Holder o();
        auto a = 1;
        try { o.ei -= a; rv."member-me-auto" = ok(o.ei); }
        catch (hash<ExceptionInfo> ex) { rv."member-me-auto" = err(ex, o.ei); }
    }
    {
        Holder o();
        auto a = 8;
        try { o.ei = a; rv."member-assign-auto" = ok(o.ei); }
        catch (hash<ExceptionInfo> ex) { rv."member-assign-auto" = err(ex, o.ei); }
    }
    {
        Holder o();
        auto a = EI::Eight;
        try { o.ei = a; rv."member-assign-enum" = ok(o.ei); }
        catch (hash<ExceptionInfo> ex) { rv."member-assign-enum" = err(ex, o.ei); }
    }
    return rv;
}

