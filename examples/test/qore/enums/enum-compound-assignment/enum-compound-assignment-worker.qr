        try { h.ei &= 3; rv.ae = ok(h.ei); } catch (hash<ExceptionInfo> ex) { rv.ae = err(ex, h.ei); }
    }
    {
        hash<HolderHash> h();
        try { h.ei ^= 1; rv.xe = ok(h.ei); } catch (hash<ExceptionInfo> ex) { rv.xe = err(ex, h.ei); }
    }
    {
        hash<HolderHash> h();
        try { h.ei <<= 1; rv.sl = ok(h.ei); } catch (hash<ExceptionInfo> ex) { rv.sl = err(ex, h.ei); }
    }
    {
        hash<HolderHash> h();
        try { h.ei >>= 1; rv.sr = ok(h.ei); } catch (hash<ExceptionInfo> ex) { rv.sr = err(ex, h.ei); }
    }
    {
        hash<HolderHash> h();
        try { ++h.ei; rv.pri = ok(h.ei); } catch (hash<ExceptionInfo> ex) { rv.pri = err(ex, h.ei); }
    }
    {
        hash<HolderHash> h();
        try { h.ei++; rv.poi = ok(h.ei); } catch (hash<ExceptionInfo> ex) { rv.poi = err(ex, h.ei); }
    }
    {
        hash<HolderHash> h();
        try { --h.ei; rv.prd = ok(h.ei); } catch (hash<ExceptionInfo> ex) { rv.prd = err(ex, h.ei); }
    }
    {
        hash<HolderHash> h();
        try { h.ei--; rv.pod = ok(h.ei); } catch (hash<ExceptionInfo> ex) { rv.pod = err(ex, h.ei); }
    }
    return rv;
}

#! each operator on an lvalue of type EI (hash) in a try block
hash<string, string> sub ei_hash_in() {
    hash<string, string> rv;
    {
        hash<string, EI> h = {"k": EI::Seven};
        string key = "k";
        try { h.k += 1; rv.pe = ok(h{key}); } catch (hash<ExceptionInfo> ex) { rv.pe = err(ex, h{key}); }
    }
    {
        hash<string, EI> h = {"k": EI::Seven};
        string key = "k";
        try { h.k -= 1; rv.me = ok(h{key}); } catch (hash<ExceptionInfo> ex) { rv.me = err(ex, h{key}); }
    }
    {
        hash<string, EI> h = {"k": EI::Seven};
        string key = "k";
        try { h.k *= 2; rv.te = ok(h{key}); } catch (hash<ExceptionInfo> ex) { rv.te = err(ex, h{key}); }
    }
    {
        hash<string, EI> h = {"k": EI::Seven};
        string key = "k";
        try { h.k /= 1; rv.de = ok(h{key}); } catch (hash<ExceptionInfo> ex) { rv.de = err(ex, h{key}); }
    }
    {
        hash<string, EI> h = {"k": EI::Seven};
        string key = "k";
        try { h.k %= 4; rv.mo = ok(h{key}); } catch (hash<ExceptionInfo> ex) { rv.mo = err(ex, h{key}); }
    }
    {
        hash<string, EI> h = {"k": EI::Seven};
        string key = "k";
        try { h.k |= 8; rv.oe = ok(h{key}); } catch (hash<ExceptionInfo> ex) { rv.oe = err(ex, h{key}); }
    }
    {
        hash<string, EI> h = {"k": EI::Seven};
        string key = "k";
        try { h.k &= 3; rv.ae = ok(h{key}); } catch (hash<ExceptionInfo> ex) { rv.ae = err(ex, h{key}); }
    }
    {
        hash<string, EI> h = {"k": EI::Seven};
        string key = "k";
        try { h.k ^= 1; rv.xe = ok(h{key}); } catch (hash<ExceptionInfo> ex) { rv.xe = err(ex, h{key}); }
    }
    {
        hash<string, EI> h = {"k": EI::Seven};
        string key = "k";
        try { h.k <<= 1; rv.sl = ok(h{key}); } catch (hash<ExceptionInfo> ex) { rv.sl = err(ex, h{key}); }
    }
    {
        hash<string, EI> h = {"k": EI::Seven};
        string key = "k";
        try { h.k >>= 1; rv.sr = ok(h{key}); } catch (hash<ExceptionInfo> ex) { rv.sr = err(ex, h{key}); }
    }
    {
        hash<string, EI> h = {"k": EI::Seven};
        string key = "k";
        try { ++h.k; rv.pri = ok(h{key}); } catch (hash<ExceptionInfo> ex) { rv.pri = err(ex, h{key}); }
    }
    {
        hash<string, EI> h = {"k": EI::Seven};
        string key = "k";
        try { h.k++; rv.poi = ok(h{key}); } catch (hash<ExceptionInfo> ex) { rv.poi = err(ex, h{key}); }
    }
    {
        hash<string, EI> h = {"k": EI::Seven};
        string key = "k";
        try { --h.k; rv.prd = ok(h{key}); } catch (hash<ExceptionInfo> ex) { rv.prd = err(ex, h{key}); }
    }
    {
        hash<string, EI> h = {"k": EI::Seven};
        string key = "k";
        try { h.k--; rv.pod = ok(h{key}); } catch (hash<ExceptionInfo> ex) { rv.pod = err(ex, h{key}); }
    }
    return rv;
}

#! each operator on an lvalue of type EI (list) in a try block
hash<string, string> sub ei_list_in() {
    hash<string, string> rv;
    {
        list<EI> l = (EI::Seven,);
        try { l[0] += 1; rv.pe = ok(l[0]); } catch (hash<ExceptionInfo> ex) { rv.pe = err(ex, l[0]); }
    }
    {
        list<EI> l = (EI::Seven,);
