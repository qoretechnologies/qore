#! applies an operator to an EI parameter
string sub ei_param_pe(EI v) {
    try { v += 1; return ok(v); } catch (hash<ExceptionInfo> ex) { return err(ex, v); }
}

#! applies an operator to an EI lvalue through a reference, with no try block
sub ei_ref_pe(reference<EI> r) {
    r += 1;
}

