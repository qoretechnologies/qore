        string r;
        for (int i = 0; i < 50; ++i) {
            try { v -= src; r = ok(v); }
            catch (hash<ExceptionInfo> ex) { r = err(ex, v) + " (caught " + (i + 1) + ")"; }
        }
        rv."me-src" = r;
    }
    return rv;
}

