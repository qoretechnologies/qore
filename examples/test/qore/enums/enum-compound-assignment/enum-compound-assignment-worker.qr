    }
    {
        g_en = EN::OneHalf;
        try { g_en--; rv.pod = ok(g_en); } catch (hash<ExceptionInfo> ex) { rv.pod = err(ex, g_en); }
    }
    return rv;
}

#! each operator on an lvalue of type EN (member) in a try block
