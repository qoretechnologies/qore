        try { --v; rv.prd = ok(v); } catch (hash<ExceptionInfo> ex) { rv.prd = err(ex, v); }
    }
    {
        int v = 7;
        try { v--; rv.pod = ok(v); } catch (hash<ExceptionInfo> ex) { rv.pod = err(ex, v); }
    }
