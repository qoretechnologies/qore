hash<string, string> sub ef_local_in() {
    hash<string, string> rv;
    {
        EF v = EF::Half;
        try { v += 0.5; rv.pe = ok(v); } catch (hash<ExceptionInfo> ex) { rv.pe = err(ex, v); }
    }
    {
        EF v = EF::Half;
        try { v -= 0.5; rv.me = ok(v); } catch (hash<ExceptionInfo> ex) { rv.me = err(ex, v); }
    }
    {
        EF v = EF::Half;
        try { v *= 2.0; rv.te = ok(v); } catch (hash<ExceptionInfo> ex) { rv.te = err(ex, v); }
    }
    {
        EF v = EF::Half;
        try { ++v; rv.pri = ok(v); } catch (hash<ExceptionInfo> ex) { rv.pri = err(ex, v); }
    }
    {
        EF v = EF::Half;
        try { v--; rv.pod = ok(v); } catch (hash<ExceptionInfo> ex) { rv.pod = err(ex, v); }
    }
    return rv;
}

