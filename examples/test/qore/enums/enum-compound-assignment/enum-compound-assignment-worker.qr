    }
    {
        EI v = EI::Seven;
        code get = auto sub () { return v; };
        try { v |= 8; rv.oe = ok(get()); } catch (hash<ExceptionInfo> ex) { rv.oe = err(ex, get()); }
    }
    {
        EI v = EI::Seven;
        code get = auto sub () { return v; };
        try { v &= 3; rv.ae = ok(get()); } catch (hash<ExceptionInfo> ex) { rv.ae = err(ex, get()); }
    }
    {
        EI v = EI::Seven;
        code get = auto sub () { return v; };
        try { v ^= 1; rv.xe = ok(get()); } catch (hash<ExceptionInfo> ex) { rv.xe = err(ex, get()); }
    }
    {
        EI v = EI::Seven;
        code get = auto sub () { return v; };
        try { v <<= 1; rv.sl = ok(get()); } catch (hash<ExceptionInfo> ex) { rv.sl = err(ex, get()); }
    }
    {
        EI v = EI::Seven;
        code get = auto sub () { return v; };
        try { v >>= 1; rv.sr = ok(get()); } catch (hash<ExceptionInfo> ex) { rv.sr = err(ex, get()); }
    }
    {
        EI v = EI::Seven;
        code get = auto sub () { return v; };
        try { ++v; rv.pri = ok(get()); } catch (hash<ExceptionInfo> ex) { rv.pri = err(ex, get()); }
    }
    {
        EI v = EI::Seven;
        code get = auto sub () { return v; };
        try { v++; rv.poi = ok(get()); } catch (hash<ExceptionInfo> ex) { rv.poi = err(ex, get()); }
    }
    {
        EI v = EI::Seven;
        code get = auto sub () { return v; };
        try { --v; rv.prd = ok(get()); } catch (hash<ExceptionInfo> ex) { rv.prd = err(ex, get()); }
    }
    {
        EI v = EI::Seven;
        code get = auto sub () { return v; };
        try { v--; rv.pod = ok(get()); } catch (hash<ExceptionInfo> ex) { rv.pod = err(ex, get()); }
    }
    {
        EI v = EI::Seven;
        code get = auto sub () { return v; };
        int src = 1;
        try { v += src; rv."pe-src" = ok(get()); } catch (hash<ExceptionInfo> ex) { rv."pe-src" = err(ex, get()); }
    }
    {
        EI v = EI::Seven;
        code get = auto sub () { return v; };
        int src = 1;
        try { v -= src; rv."me-src" = ok(get()); } catch (hash<ExceptionInfo> ex) { rv."me-src" = err(ex, get()); }
    }
    return rv;
}

