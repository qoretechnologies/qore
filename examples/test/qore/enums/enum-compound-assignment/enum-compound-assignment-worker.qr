            catch (hash<ExceptionInfo> ex) { r = err(ex, v) + " (caught " + (i + 1) + ")"; }
        }
        rv.de = r;
    }
    {
        softint v = 7;
        string r;
        for (int i = 0; i < 50; ++i) {
            try { v %= 4; r = ok(v); }
            catch (hash<ExceptionInfo> ex) { r = err(ex, v) + " (caught " + (i + 1) + ")"; }
        }
        rv.mo = r;
    }
    {
        softint v = 7;
        string r;
        for (int i = 0; i < 50; ++i) {
            try { v |= 8; r = ok(v); }
            catch (hash<ExceptionInfo> ex) { r = err(ex, v) + " (caught " + (i + 1) + ")"; }
        }
        rv.oe = r;
    }
    {
        softint v = 7;
        string r;
        for (int i = 0; i < 50; ++i) {
            try { v &= 3; r = ok(v); }
            catch (hash<ExceptionInfo> ex) { r = err(ex, v) + " (caught " + (i + 1) + ")"; }
        }
        rv.ae = r;
    }
    {
        softint v = 7;
        string r;
        for (int i = 0; i < 50; ++i) {
            try { v ^= 1; r = ok(v); }
            catch (hash<ExceptionInfo> ex) { r = err(ex, v) + " (caught " + (i + 1) + ")"; }
        }
        rv.xe = r;
    }
    {
        softint v = 7;
        string r;
        for (int i = 0; i < 50; ++i) {
            try { v <<= 1; r = ok(v); }
            catch (hash<ExceptionInfo> ex) { r = err(ex, v) + " (caught " + (i + 1) + ")"; }
        }
        rv.sl = r;
    }
    {
        softint v = 7;
        string r;
        for (int i = 0; i < 50; ++i) {
            try { v >>= 1; r = ok(v); }
            catch (hash<ExceptionInfo> ex) { r = err(ex, v) + " (caught " + (i + 1) + ")"; }
        }
        rv.sr = r;
    }
    {
        softint v = 7;
        string r;
        for (int i = 0; i < 50; ++i) {
            try { ++v; r = ok(v); }
            catch (hash<ExceptionInfo> ex) { r = err(ex, v) + " (caught " + (i + 1) + ")"; }
        }
        rv.pri = r;
    }
    {
        softint v = 7;
        string r;
        for (int i = 0; i < 50; ++i) {
            try { v++; r = ok(v); }
            catch (hash<ExceptionInfo> ex) { r = err(ex, v) + " (caught " + (i + 1) + ")"; }
        }
        rv.poi = r;
    }
    {
        softint v = 7;
        string r;
        for (int i = 0; i < 50; ++i) {
            try { --v; r = ok(v); }
            catch (hash<ExceptionInfo> ex) { r = err(ex, v) + " (caught " + (i + 1) + ")"; }
        }
        rv.prd = r;
    }
    {
        softint v = 7;
        string r;
        for (int i = 0; i < 50; ++i) {
            try { v--; r = ok(v); }
            catch (hash<ExceptionInfo> ex) { r = err(ex, v) + " (caught " + (i + 1) + ")"; }
        }
        rv.pod = r;
    }
    {
        softint v = 7;
        int src = 1;
        string r;
        for (int i = 0; i < 50; ++i) {
            try { v += src; r = ok(v); }
            catch (hash<ExceptionInfo> ex) { r = err(ex, v) + " (caught " + (i + 1) + ")"; }
        }
        rv."pe-src" = r;
    }
    {
        softint v = 7;
        int src = 1;
        string r;
        for (int i = 0; i < 50; ++i) {
            try { v -= src; r = ok(v); }
            catch (hash<ExceptionInfo> ex) { r = err(ex, v) + " (caught " + (i + 1) + ")"; }
        }
        rv."me-src" = r;
    }
    return rv;
}

