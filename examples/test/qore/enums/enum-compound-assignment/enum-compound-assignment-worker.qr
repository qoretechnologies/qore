#! each operator on an lvalue of type EI (member) in a try block
hash<string, string> sub ei_member_in() {
    hash<string, string> rv;
    {
        Holder o();
        try { o.ei += 1; rv.pe = ok(o.ei); } catch (hash<ExceptionInfo> ex) { rv.pe = err(ex, o.ei); }
    }
    {
        Holder o();
        try { o.ei -= 1; rv.me = ok(o.ei); } catch (hash<ExceptionInfo> ex) { rv.me = err(ex, o.ei); }
    }
    {
        Holder o();
        try { o.ei *= 2; rv.te = ok(o.ei); } catch (hash<ExceptionInfo> ex) { rv.te = err(ex, o.ei); }
    }
    {
        Holder o();
        try { o.ei /= 1; rv.de = ok(o.ei); } catch (hash<ExceptionInfo> ex) { rv.de = err(ex, o.ei); }
    }
    {
        Holder o();
        try { o.ei %= 4; rv.mo = ok(o.ei); } catch (hash<ExceptionInfo> ex) { rv.mo = err(ex, o.ei); }
    }
    {
        Holder o();
        try { o.ei |= 8; rv.oe = ok(o.ei); } catch (hash<ExceptionInfo> ex) { rv.oe = err(ex, o.ei); }
    }
    {
        Holder o();
        try { o.ei &= 3; rv.ae = ok(o.ei); } catch (hash<ExceptionInfo> ex) { rv.ae = err(ex, o.ei); }
    }
    {
        Holder o();
        try { o.ei ^= 1; rv.xe = ok(o.ei); } catch (hash<ExceptionInfo> ex) { rv.xe = err(ex, o.ei); }
    }
    {
        Holder o();
        try { o.ei <<= 1; rv.sl = ok(o.ei); } catch (hash<ExceptionInfo> ex) { rv.sl = err(ex, o.ei); }
    }
    {
        Holder o();
        try { o.ei >>= 1; rv.sr = ok(o.ei); } catch (hash<ExceptionInfo> ex) { rv.sr = err(ex, o.ei); }
    }
    {
        Holder o();
        try { ++o.ei; rv.pri = ok(o.ei); } catch (hash<ExceptionInfo> ex) { rv.pri = err(ex, o.ei); }
    }
    {
        Holder o();
        try { o.ei++; rv.poi = ok(o.ei); } catch (hash<ExceptionInfo> ex) { rv.poi = err(ex, o.ei); }
    }
    {
        Holder o();
        try { --o.ei; rv.prd = ok(o.ei); } catch (hash<ExceptionInfo> ex) { rv.prd = err(ex, o.ei); }
    }
    {
        Holder o();
        try { o.ei--; rv.pod = ok(o.ei); } catch (hash<ExceptionInfo> ex) { rv.pod = err(ex, o.ei); }
    }
    return rv;
}

#! each operator on an lvalue of type EI (hashdecl) in a try block
hash<string, string> sub ei_hashdecl_in() {
