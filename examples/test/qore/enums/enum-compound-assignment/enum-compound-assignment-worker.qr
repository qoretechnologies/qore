#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# applies the compound assignment operators to enum lvalues; run by enum-compound-assignment.qtest

/** An enum lvalue holds only the members of its enum: an operator that changes it computes a plain value of the
    enum's base type, which the enum type refuses, so every operator raises RUNTIME-TYPE-ERROR and leaves the lvalue
    unchanged, as in the AST interpreter, in every kind of lvalue and also when the result is a member's value
    (qore#6197).  The error is caught by a try block around the operator, or by the caller of a function without
    one.  The same operators on int and softint locals are controls.  Each check prints
    "name=<error>|<description>|<type> <value>", or "name=none|<type> <value>" if no error was raised.

    The element of a hash<string, EI> is read with a key given at run time: the IR reads a constant key of a hash
    whose value type returns int as a plain int, also for an enum value type, which is not what these checks test.
*/

enum EI : int {
    One = 1,
    Seven = 7,
    Eight = 8,
    Fourteen = 14,
}

enum EF : float {
    Half = 0.5,
    One = 1.0,
}

enum EN : number {
    OneHalf = 1.5n,
}

class Holder {
    public {
        EI ei = EI::Seven;
        EF ef = EF::Half;
        EN en = EN::OneHalf;
    }
}

hashdecl HolderHash {
    EI ei = EI::Seven;
    EF ef = EF::Half;
    EN en = EN::OneHalf;
}

our EI g_ei;
our EF g_ef;
our EN g_en;

#! returns the result of a check that raised no error: the type and value of the lvalue afterwards
string sub ok(auto v) {
    return sprintf("none|%s %y", v.fullType(), v);
}

#! returns the result of a check that raised an error: the error and the type and value of the lvalue afterwards
string sub err(hash<ExceptionInfo> ex, auto v) {
    return sprintf("%s|%s|%s %y", ex.err, ex.desc, v.fullType(), v);
}

#! returns the result of a check that raised an error in a function that it called
string sub err_out(hash<ExceptionInfo> ex) {
    return sprintf("%s|%s", ex.err, ex.desc);
}

#! prints the results of a group of checks
sub print_results(string group, hash<string, string> results) {
    foreach hash<auto> i in (results.pairIterator()) {
        printf("%s-%s=%s\n", group, i.key, i.value);
    }
}
#! each operator on an lvalue of type EI (local) in a try block
hash<string, string> sub ei_local_in() {
    hash<string, string> rv;
    {
        EI v = EI::Seven;
        try { v += 1; rv.pe = ok(v); } catch (hash<ExceptionInfo> ex) { rv.pe = err(ex, v); }
    }
    {
        EI v = EI::Seven;
        try { v -= 1; rv.me = ok(v); } catch (hash<ExceptionInfo> ex) { rv.me = err(ex, v); }
    }
    {
        EI v = EI::Seven;
        try { v *= 2; rv.te = ok(v); } catch (hash<ExceptionInfo> ex) { rv.te = err(ex, v); }
    }
    {
        EI v = EI::Seven;
        try { v /= 1; rv.de = ok(v); } catch (hash<ExceptionInfo> ex) { rv.de = err(ex, v); }
    }
    {
        EI v = EI::Seven;
        try { v %= 4; rv.mo = ok(v); } catch (hash<ExceptionInfo> ex) { rv.mo = err(ex, v); }
    }
    {
        EI v = EI::Seven;
        try { v |= 8; rv.oe = ok(v); } catch (hash<ExceptionInfo> ex) { rv.oe = err(ex, v); }
    }
    {
        EI v = EI::Seven;
        try { v &= 3; rv.ae = ok(v); } catch (hash<ExceptionInfo> ex) { rv.ae = err(ex, v); }
    }
    {
        EI v = EI::Seven;
        try { v ^= 1; rv.xe = ok(v); } catch (hash<ExceptionInfo> ex) { rv.xe = err(ex, v); }
    }
    {
        EI v = EI::Seven;
        try { v <<= 1; rv.sl = ok(v); } catch (hash<ExceptionInfo> ex) { rv.sl = err(ex, v); }
    }
    {
        EI v = EI::Seven;
        try { v >>= 1; rv.sr = ok(v); } catch (hash<ExceptionInfo> ex) { rv.sr = err(ex, v); }
    }
    {
        EI v = EI::Seven;
        try { ++v; rv.pri = ok(v); } catch (hash<ExceptionInfo> ex) { rv.pri = err(ex, v); }
    }
    {
        EI v = EI::Seven;
        try { v++; rv.poi = ok(v); } catch (hash<ExceptionInfo> ex) { rv.poi = err(ex, v); }
    }
    {
        EI v = EI::Seven;
        try { --v; rv.prd = ok(v); } catch (hash<ExceptionInfo> ex) { rv.prd = err(ex, v); }
    }
    {
        EI v = EI::Seven;
        try { v--; rv.pod = ok(v); } catch (hash<ExceptionInfo> ex) { rv.pod = err(ex, v); }
    }
    {
        EI v = EI::Seven;
        int src = 1;
        try { v += src; rv."pe-src" = ok(v); } catch (hash<ExceptionInfo> ex) { rv."pe-src" = err(ex, v); }
    }
    {
        EI v = EI::Seven;
        int src = 1;
        try { v -= src; rv."me-src" = ok(v); } catch (hash<ExceptionInfo> ex) { rv."me-src" = err(ex, v); }
    }
    return rv;
}

#! each operator on an lvalue of type EI (closure) in a try block
hash<string, string> sub ei_closure_in() {
    hash<string, string> rv;
    {
        EI v = EI::Seven;
        code get = auto sub () { return v; };
        try { v += 1; rv.pe = ok(get()); } catch (hash<ExceptionInfo> ex) { rv.pe = err(ex, get()); }
    }
    {
        EI v = EI::Seven;
        code get = auto sub () { return v; };
        try { v -= 1; rv.me = ok(get()); } catch (hash<ExceptionInfo> ex) { rv.me = err(ex, get()); }
    }
    {
        EI v = EI::Seven;
        code get = auto sub () { return v; };
        try { v *= 2; rv.te = ok(get()); } catch (hash<ExceptionInfo> ex) { rv.te = err(ex, get()); }
    }
