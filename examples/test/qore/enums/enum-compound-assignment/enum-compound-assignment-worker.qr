    }
    {
        list<EI> l = (EI::Seven,);
        try { l[0] ^= 1; rv.xe = ok(l[0]); } catch (hash<ExceptionInfo> ex) { rv.xe = err(ex, l[0]); }
    }
    {
        list<EI> l = (EI::Seven,);
        try { l[0] <<= 1; rv.sl = ok(l[0]); } catch (hash<ExceptionInfo> ex) { rv.sl = err(ex, l[0]); }
    }
    {
        list<EI> l = (EI::Seven,);
        try { l[0] >>= 1; rv.sr = ok(l[0]); } catch (hash<ExceptionInfo> ex) { rv.sr = err(ex, l[0]); }
    }
    {
        list<EI> l = (EI::Seven,);
        try { ++l[0]; rv.pri = ok(l[0]); } catch (hash<ExceptionInfo> ex) { rv.pri = err(ex, l[0]); }
    }
    {
        list<EI> l = (EI::Seven,);
        try { l[0]++; rv.poi = ok(l[0]); } catch (hash<ExceptionInfo> ex) { rv.poi = err(ex, l[0]); }
    }
    {
        list<EI> l = (EI::Seven,);
        try { --l[0]; rv.prd = ok(l[0]); } catch (hash<ExceptionInfo> ex) { rv.prd = err(ex, l[0]); }
    }
    {
        list<EI> l = (EI::Seven,);
        try { l[0]--; rv.pod = ok(l[0]); } catch (hash<ExceptionInfo> ex) { rv.pod = err(ex, l[0]); }
    }
    return rv;
}

#! applies an operator to a EI local lvalue with no try block
sub ei_local_raise(string op) {
    EI v = EI::Seven;
    switch (op) {
        case "pe": v += 1; break;
        case "me": v -= 1; break;
        case "te": v *= 2; break;
        case "de": v /= 1; break;
        case "mo": v %= 4; break;
        case "oe": v |= 8; break;
        case "ae": v &= 3; break;
        case "xe": v ^= 1; break;
        case "sl": v <<= 1; break;
        case "sr": v >>= 1; break;
        case "pri": ++v; break;
        case "poi": v++; break;
        case "prd": --v; break;
        case "pod": v--; break;
    }
}

