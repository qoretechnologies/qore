#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class EnumIntConversionTest

#! Tests the type of an enum member returned or passed as int (qore#6042)
/** The value takes the declared type, as in the AST interpreter: an enum member returned from an int function, or
    passed to an int parameter, is an int.  The IR interpreter kept the enum type, as its check of a return or
    parameter value took an enum member for a plain int.  The checks are in enum-int-conversion-worker.qr, which is
    run in each execution mode and as a program compiled with qcc; every run must give the results below.
*/
class EnumIntConversionTest inherits QUnit::Test {
    public {
        #! the result of every check the worker makes
        const Expected = {
            "function": "integer",
            "function-from-param": "integer",
            "or-nothing-int": "integer",
            "softint": "integer",
            "method": "integer",
            "static-method": "integer",
            "closure": "integer",
            "call-reference": "integer",
            "dynamic-call": "integer",
            "list-element": "integer",
            "hash-value": "integer",
            "parameter": "integer",
            "string-function": "string",
            "string-parameter": "string",
            "hot-calls": "{integer: 4000, string: 2000}",
            "ident-calls": "{int:integer: 2000, float:float: 2000, auto:enum<Shape>: 2000, enum:enum<Shape>: 2000, "
                "or-nothing-enum:enum<Shape>: 2000}",
            "auto-keeps-enum": "enum<Shape>",
            "enum-keeps-enum": "enum<Shape>",
            "or-nothing-enum-keeps-enum": "enum<Shape>",
            "stable": "True",
        };

        #! the execution modes that the worker is run in
        const ExecModes = ("ast", "ir", "jit", "tiered");
    }

    private {
        string qore_bin;
        string libqore_dir;
        string qcc_bin;
    }

    constructor() : QUnit::Test("EnumIntConversionTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
            ?? (is_file(libqore_dir + DirSep + "qcc") ? libqore_dir + DirSep + "qcc"
                : dirname(qore_bin) + DirSep + "qcc");
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }

        addTestCase("each execution mode", \testExecModes());
        addTestCase("compiled program", \testCompiledProgram());

        set_return_value(main());
    }

    testExecModes() {
        foreach string mode in (ExecModes) {
            string out = ExecModeHarness::run(sprintf("LD_LIBRARY_PATH=%s %s -b --enable-debug --exec-mode=%s %s",
                libqore_dir, qore_bin, mode, getWorker()));
            checkWorkerOutput(mode, out);
        }
    }

    testCompiledProgram() {
        TmpDir tmp("qore-enum-int-conversion-");
        string exe = tmp.path + DirSep + "enum-int-conversion";
        string compile_out = backquote(sprintf("LD_LIBRARY_PATH=%s %s --strip-source -o %s %s 2>&1", libqore_dir,
            qcc_bin, exe, getWorker()));
        assertTrue(is_file(exe), "compiled program: " + compile_out);
        checkWorkerOutput("aot", backquote(sprintf("LD_LIBRARY_PATH=%s %s 2>&1", libqore_dir, exe)));
    }

    private string getWorker() {
        return get_script_dir() + DirSep + "enum-int-conversion-worker.qr";
    }

    #! parses the "name=result" lines printed by the worker and checks them; any other output fails
    private checkWorkerOutput(string label, string out) {
        hash<string, string> results = {};
        foreach string line in (out.split("\n")) {
            *list<*string> parts = (line =~ x/^([-a-z]+)=(.*)$/);
            if (!parts) {
                if (line.val()) {
                    fail(sprintf("%s: unexpected worker output: %y", label, out));
                }
                continue;
            }
            results{parts[0]} = parts[1];
        }
        assertEq(sort(keys Expected), sort(keys results), label + ": checks run");
        foreach hash<auto> i in (Expected.pairIterator()) {
            assertEq(i.value, results{i.key}, sprintf("%s: %s", label, i.key));
        }
    }
}
