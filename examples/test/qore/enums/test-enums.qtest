#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern

%requires QUnit
%requires reflection

%exec-class EnumTest

# Test enums in root namespace
public enum ColorInt : int {
    Red = 1,
    Green = 2,
    Blue = 3,
}

public enum ColorString : string {
    Red = "red",
    Green = "green",
    Blue = "blue",
}

public enum Priority : int {
    Low = 0,
    Medium = 5,
    High = 10,
    Critical = 100,
}

public enum Status : string {
    Active = "active",
    Inactive = "inactive",
    Pending = "pending",
    Deleted = "deleted",
}

public enum Multiplier : float {
    Half = 0.5,
    Normal = 1.0,
    Double = 2.0,
    Triple = 3.0,
}

public enum Precision : number {
    Low = 1n,
    Medium = 1000n,
    High = 1000000n,
    Extreme = 1000000000n,
}

# Namespace with enum
namespace Test {
    public enum Level : int {
        Debug = 0,
        Info = 1,
        Warning = 2,
        Error = 3,
        Critical = 4,
    }

    public enum Result : string {
        Success = "success",
        Failure = "failure",
        Pending = "pending",
    }
}

# Nested namespace
namespace Outer {
    public enum Type : int {
        TypeA = 1,
        TypeB = 2,
    }

    namespace Inner {
        public enum SubType : int {
            SubA = 10,
            SubB = 20,
        }
    }
}

class EnumTest inherits QUnit::Test {
    constructor() : Test("EnumTest", "1.0") {
        addTestCase("Test basic int enum access", \testBasicIntEnum());
        addTestCase("Test basic string enum access", \testBasicStringEnum());
        addTestCase("Test float enum access", \testFloatEnum());
        addTestCase("Test number enum access", \testNumberEnum());
        addTestCase("Test enum type checking", \testEnumTypeChecking());
        addTestCase("Test enum value comparison", \testEnumComparison());
        addTestCase("Test namespaced enums", \testNamespacedEnums());
        addTestCase("Test nested namespace enums", \testNestedNamespaceEnums());
        addTestCase("Test enum reflection - Enum class", \testEnumReflection());
        addTestCase("Test enum reflection - EnumMember class", \testEnumMemberReflection());
        addTestCase("Test enum reflection - Namespace enumeration", \testNamespaceEnumeration());
        addTestCase("Test enum value validation", \testEnumValueValidation());
        addTestCase("Test enum type info", \testEnumTypeInfo());
        addTestCase("Test enum in function parameters", \testEnumInFunctionParams());
        addTestCase("Test enum in hash declaration", \testEnumInHashDecl());
        addTestCase("Test enum equality operators", \testEnumEqualityOperators());
        addTestCase("Test cast<enum<X>> functionality", \testEnumCast());
        addTestCase("Test enum type name resolution", \testEnumTypeNameResolution());
        addTestCase("Test enum hash serialization", \testEnumSerialization());
        addTestCase("Test enum stream serialization", \testEnumStreamSerialization());
        addTestCase("Test enum serialization in container", \testEnumSerializationInContainer());
        addTestCase("Test enum serialization backward compat", \testEnumSerializationBackwardCompat());
        addTestCase("Test enum deserialization errors", \testEnumDeserializationErrors());
        set_return_value(main());
    }

    testBasicIntEnum() {
        # Enum values have soft equality with their base values
        assertTrue(ColorInt::Red == 1);
        assertTrue(ColorInt::Green == 2);
        assertTrue(ColorInt::Blue == 3);

        # Same enum values are hard-equal
        assertEq(ColorInt::Red, ColorInt::Red);
        assertEq(ColorInt::Green, ColorInt::Green);

        # Assignment to base type unwraps enum
        int c = ColorInt::Red;
        assertEq(1, c);

        # All priority values
        assertTrue(Priority::Low == 0);
        assertTrue(Priority::Medium == 5);
        assertTrue(Priority::High == 10);
        assertTrue(Priority::Critical == 100);
    }

    testBasicStringEnum() {
        # Soft equality with base values
        assertTrue(ColorString::Red == "red");
        assertTrue(ColorString::Green == "green");
        assertTrue(ColorString::Blue == "blue");

        # Assignment to base type unwraps enum
        string s = Status::Active;
        assertEq("active", s);

        # All status values
        assertTrue(Status::Active == "active");
        assertTrue(Status::Inactive == "inactive");
        assertTrue(Status::Pending == "pending");
        assertTrue(Status::Deleted == "deleted");
    }

    testFloatEnum() {
        assertTrue(Multiplier::Half == 0.5);
        assertTrue(Multiplier::Normal == 1.0);
        assertTrue(Multiplier::Double == 2.0);
        assertTrue(Multiplier::Triple == 3.0);

        # Assignment to base type unwraps
        float m = Multiplier::Double;
        assertEq(2.0, m);
    }

    testNumberEnum() {
        assertTrue(Precision::Low == 1n);
        assertTrue(Precision::Medium == 1000n);
        assertTrue(Precision::High == 1000000n);
        assertTrue(Precision::Extreme == 1000000000n);

        # Assignment to base type unwraps
        number n = Precision::High;
        assertEq(1000000n, n);
    }

    testEnumTypeChecking() {
        # auto variables preserve TAG_ENUM — isEnum() returns True, fullType() returns "enum<X>"
        auto v = ColorInt::Red;
        assertTrue(v.isEnum());
        assertEq("integer", v.type());
        assertEq("enum<ColorInt>", v.fullType());
        assertEq(NT_INT, v.typeCode());

        v = Status::Active;
        assertTrue(v.isEnum());
        assertEq("enum<Status>", v.fullType());

        v = Multiplier::Double;
        assertTrue(v.isEnum());
        assertEq("enum<Multiplier>", v.fullType());

        # Assignment to base type loses enum identity
        int c = ColorInt::Red;
        assertFalse(c.isEnum());
        assertEq("integer", c.type());

        string s = Status::Active;
        assertFalse(s.isEnum());
        assertEq("string", s.type());
    }

    testEnumComparison() {
        # Comparison with same enum values (soft)
        assertTrue(ColorInt::Red == ColorInt::Red);
        assertFalse(ColorInt::Red == ColorInt::Green);

        # Comparison with underlying type (soft)
        assertTrue(ColorInt::Red == 1);
        assertTrue(1 == ColorInt::Red);

        # String enum comparisons (soft)
        assertTrue(Status::Active == "active");
        assertTrue("active" == Status::Active);

        # Priority ordering
        assertTrue(Priority::Low < Priority::Medium);
        assertTrue(Priority::Medium < Priority::High);
        assertTrue(Priority::High < Priority::Critical);
    }

    testNamespacedEnums() {
        # Access enum in namespace — same enum values are hard-equal
        assertEq(Test::Level::Debug, Test::Level::Debug);
        assertEq(Test::Level::Info, Test::Level::Info);

        # Soft equality with base values
        assertTrue(Test::Level::Debug == 0);
        assertTrue(Test::Level::Info == 1);
        assertTrue(Test::Level::Warning == 2);
        assertTrue(Test::Level::Error == 3);
        assertTrue(Test::Level::Critical == 4);

        assertTrue(Test::Result::Success == "success");
        assertTrue(Test::Result::Failure == "failure");
        assertTrue(Test::Result::Pending == "pending");

        # auto preserves enum type
        auto v = Test::Level::Debug;
        assertTrue(v.isEnum());
        assertEq("enum<Level>", v.fullType());
    }

    testNestedNamespaceEnums() {
        # Soft equality with base values
        assertTrue(Outer::Type::TypeA == 1);
        assertTrue(Outer::Type::TypeB == 2);

        assertTrue(Outer::Inner::SubType::SubA == 10);
        assertTrue(Outer::Inner::SubType::SubB == 20);

        # auto preserves enum type
        auto v = Outer::Inner::SubType::SubA;
        assertTrue(v.isEnum());
        assertEq("enum<SubType>", v.fullType());
    }

    testEnumReflection() {
        # Get enum by name
        Enum colorEnum = Enum::forName("ColorInt");
        assertEq("ColorInt", colorEnum.getName());
        assertEq("::ColorInt", colorEnum.getPathName());
        assertFalse(colorEnum.isBuiltin());
        assertTrue(colorEnum.isUser());

        # Check base type
        Type baseType = colorEnum.getBaseType();
        assertEq("int", baseType.getName());

        # Check enum type
        Type enumType = colorEnum.getType();
        assertEq("enum<ColorInt>", enumType.getName());

        # Namespaced enum
        Enum levelEnum = Enum::forName("Test::Level");
        assertEq("Level", levelEnum.getName());
        assertEq("Test::Level", levelEnum.getPathName());
        assertEq("int", levelEnum.getBaseType().getName());

        # Get namespace (root namespace returns empty path)
        Namespace ns = colorEnum.getNamespace();
        assertEq("", ns.getPathName());

        Namespace testNs = levelEnum.getNamespace();
        assertEq("Test", testNs.getPathName());
    }

    testEnumMemberReflection() {
        Enum colorEnum = Enum::forName("ColorInt");

        # Get all members
        list<EnumMember> members = colorEnum.getMembers();
        assertEq(3, members.size());

        # Check member names and values (reflection returns base values)
        hash<string, auto> memberMap;
        foreach EnumMember m in (members) {
            memberMap{m.getName()} = m.getValue();
        }
        assertTrue(memberMap.Red == 1);
        assertTrue(memberMap.Green == 2);
        assertTrue(memberMap.Blue == 3);

        # Get specific member
        EnumMember redMember = colorEnum.getMember("Red");
        assertEq("Red", redMember.getName());
        assertTrue(redMember.getValue() == 1);
        assertFalse(redMember.isBuiltin());
        assertTrue(redMember.isUser());

        # Get enum from member
        Enum fromMember = redMember.getEnum();
        assertEq("ColorInt", fromMember.getName());

        # String enum members
        Enum statusEnum = Enum::forName("Status");
        list<EnumMember> statusMembers = statusEnum.getMembers();
        assertEq(4, statusMembers.size());

        EnumMember activeMember = statusEnum.getMember("Active");
        assertTrue(activeMember.getValue() == "active");
    }

    testNamespaceEnumeration() {
        # Get enums from root namespace
        Namespace rootNs = Namespace::forName("::");
        list<Enum> rootEnums = rootNs.getEnums();

        # Should find our test enums
        hash<string, bool> foundEnums;
        foreach Enum e in (rootEnums) {
            foundEnums{e.getName()} = True;
        }
        assertTrue(foundEnums.ColorInt ?? False);
        assertTrue(foundEnums.ColorString ?? False);
        assertTrue(foundEnums.Priority ?? False);
        assertTrue(foundEnums.Status ?? False);
        assertTrue(foundEnums.Multiplier ?? False);
        assertTrue(foundEnums.Precision ?? False);

        # Get enums from Test namespace
        Namespace testNs = Namespace::forName("::Test");
        list<Enum> testEnums = testNs.getEnums();

        hash<string, bool> foundTestEnums;
        foreach Enum e in (testEnums) {
            foundTestEnums{e.getName()} = True;
        }
        assertTrue(foundTestEnums.Level ?? False);
        assertTrue(foundTestEnums.Result ?? False);

        # Get specific enum from namespace
        Enum levelEnum = testNs.getEnum("Level");
        assertEq("Level", levelEnum.getName());
    }

    testEnumValueValidation() {
        Enum colorEnum = Enum::forName("ColorInt");

        # Valid values
        assertTrue(colorEnum.isValidValue(1));
        assertTrue(colorEnum.isValidValue(2));
        assertTrue(colorEnum.isValidValue(3));

        # Invalid values
        assertFalse(colorEnum.isValidValue(0));
        assertFalse(colorEnum.isValidValue(4));
        assertFalse(colorEnum.isValidValue(-1));
        assertFalse(colorEnum.isValidValue(100));

        # String enum validation
        Enum statusEnum = Enum::forName("Status");
        assertTrue(statusEnum.isValidValue("active"));
        assertTrue(statusEnum.isValidValue("inactive"));
        assertFalse(statusEnum.isValidValue("unknown"));
        assertFalse(statusEnum.isValidValue(""));
    }

    testEnumTypeInfo() {
        Enum colorEnum = Enum::forName("ColorInt");

        # Get type info
        Type enumType = colorEnum.getType();
        assertEq("enum<ColorInt>", enumType.getName());

        # Get or-nothing type
        Type orNothingType = colorEnum.getOrNothingType();
        assertEq("*enum<ColorInt>", orNothingType.getName());
    }

    testEnumInFunctionParams() {
        # Test functions that take enum parameters
        assertEq("low", getPriorityName(Priority::Low));
        assertEq("high", getPriorityName(Priority::High));

        # Using enum value directly
        assertEq("medium", getPriorityName(Priority::Medium));

        # Function with enum parameter type
        assertEq("low", getPriorityNameEnum(Priority::Low));
        assertEq("high", getPriorityNameEnum(Priority::High));
        assertThrows("RUNTIME-CAST-ERROR", sub () { getPriorityNameEnum(cast<enum<Priority>>(99)); });
    }

    string getPriorityName(int priority) {
        switch (priority) {
            case Priority::Low: return "low";
            case Priority::Medium: return "medium";
            case Priority::High: return "high";
            case Priority::Critical: return "critical";
            default: return "unknown";
        }
    }

    string getPriorityNameEnum(enum<Priority> priority) {
        switch (priority) {
            case Priority::Low: return "low";
            case Priority::Medium: return "medium";
            case Priority::High: return "high";
            case Priority::Critical: return "critical";
            default: return "unknown";
        }
    }

    testEnumInHashDecl() {
        hash<auto> data = {
            "color": ColorInt::Blue,
            "status": Status::Active,
            "priority": Priority::High,
        };

        # hash<auto> preserves TAG_ENUM, use soft comparison
        assertTrue(data.color == 3);
        assertTrue(data.status == "active");
        assertTrue(data.priority == 10);

        # enum-to-enum comparison in hash
        assertEq(ColorInt::Blue, data.color);
        assertEq(Status::Active, data.status);
    }

    testEnumEqualityOperators() {
        # Test === operator (strict equality) — same enum members are hard-equal
        assertTrue(ColorInt::Red === ColorInt::Red);
        assertFalse(ColorInt::Red === ColorInt::Green);

        # Test !== operator
        assertTrue(ColorInt::Red !== ColorInt::Green);
        assertFalse(ColorInt::Red !== ColorInt::Red);

        # Cross-type comparison with == (soft — enum vs base type)
        assertTrue(ColorInt::Red == 1);
        assertTrue(Status::Active == "active");

        # Cross-type comparison with === (enum !== base type, strict type safety)
        assertFalse(ColorInt::Red === 1);
        assertFalse(Status::Active === "active");

        # Different enum types with same base value must NOT be === equal
        # (Priority::Low == 0, Test::Level::Debug == 0)
        assertFalse(Priority::Low === Test::Level::Debug);
        # Same enum type, same member must be === equal
        assertTrue(Priority::Low === Priority::Low);
    }

    testEnumCast() {
        # Cast valid string value to string-based enum
        string s = "active";
        Status st = cast<enum<Status>>(s);
        assertEq(Status::Active, st);
        assertTrue(st.isEnum());
        assertEq("enum<Status>", st.fullType());

        # Cast valid int value to int-based enum
        int i = 2;
        ColorInt ci = cast<enum<ColorInt>>(i);
        assertEq(ColorInt::Green, ci);
        assertTrue(ci.isEnum());
        assertEq("enum<ColorInt>", ci.fullType());
        assertTrue(ci === ColorInt::Green);

        # Cast valid float value to float-based enum
        float f = 2.0;
        Multiplier m = cast<enum<Multiplier>>(f);
        assertEq(Multiplier::Double, m);

        # Cast with or_nothing - NOTHING value
        *string ns;
        *Status st2 = cast<*enum<Status>>(ns);
        assertFalse(exists st2);

        # Cast with or_nothing - valid value
        *string ns2 = "inactive";
        *Status st3 = cast<*enum<Status>>(ns2);
        assertEq(Status::Inactive, st3);

        # Cast invalid value - runtime error
        assertThrows("RUNTIME-CAST-ERROR", sub() {
            string invalid = "invalid_status";
            Status st4 = cast<enum<Status>>(invalid);
            remove st4;
        });

        # Cast wrong base type - runtime error (using auto to bypass parse-time check)
        assertThrows("RUNTIME-CAST-ERROR", sub() {
            auto wrongType = 123;
            Status st5 = cast<enum<Status>>(wrongType);
            remove st5;
        });

        # Cast namespaced enum
        int level = 2;
        Test::Level lv = cast<enum<Test::Level>>(level);
        assertEq(Test::Level::Warning, lv);
    }

    testEnumTypeNameResolution() {
        # Test that enum names can be used directly as type names (without enum<> wrapper)
        Status st = Status::Active;
        assertTrue(st == "active");
        assertTrue(st.isEnum());
        assertEq("enum<Status>", st.fullType());

        # Test with namespaced enum
        Test::Level lv = Test::Level::Info;
        assertTrue(lv == 1);
        assertTrue(lv.isEnum());
        assertEq("enum<Level>", lv.fullType());

        # Test with or_nothing variant
        *Status st2 = Status::Pending;
        assertTrue(st2 == "pending");

        # Test function with enum parameter using direct type name
        assertTrue(getStatusString(Status::Active) == "active");
        assertTrue(getStatusString(Status::Inactive) == "inactive");
    }

    string getStatusString(Status s) {
        return string(s);
    }

    testEnumSerialization() {
        # Serialize enum via hash path (serializeToData)
        hash<SerializationInfo> h = Serializable::serializeToData(ColorInt::Red);
        # The data should have _enum and _member keys
        assertEq("::ColorInt", h._data._enum);
        assertEq("Red", h._data._member);

        # Deserialize back
        auto result = Serializable::deserialize(h);
        assertTrue(result.isEnum());
        assertEq("enum<ColorInt>", result.fullType());
        assertEq(ColorInt::Red, result);
        assertTrue(result === ColorInt::Red);

        # String enum round-trip
        h = Serializable::serializeToData(Status::Active);
        assertEq("::Status", h._data._enum);
        assertEq("Active", h._data._member);
        result = Serializable::deserialize(h);
        assertTrue(result.isEnum());
        assertEq("enum<Status>", result.fullType());
        assertEq(Status::Active, result);

        # Float enum round-trip
        h = Serializable::serializeToData(Multiplier::Double);
        result = Serializable::deserialize(h);
        assertTrue(result.isEnum());
        assertEq(Multiplier::Double, result);

        # Number enum round-trip
        h = Serializable::serializeToData(Precision::High);
        result = Serializable::deserialize(h);
        assertTrue(result.isEnum());
        assertEq(Precision::High, result);

        # Namespaced enum round-trip
        h = Serializable::serializeToData(Test::Level::Warning);
        assertEq("Test::Level", h._data._enum);
        result = Serializable::deserialize(h);
        assertTrue(result.isEnum());
        assertEq("enum<Level>", result.fullType());
        assertEq(Test::Level::Warning, result);
    }

    testEnumStreamSerialization() {
        # Serialize enum via stream path (binary)
        binary b = Serializable::serialize(ColorInt::Green);
        auto result = Serializable::deserialize(b);
        assertTrue(result.isEnum());
        assertEq("enum<ColorInt>", result.fullType());
        assertEq(ColorInt::Green, result);
        assertTrue(result === ColorInt::Green);

        # String enum stream round-trip
        b = Serializable::serialize(Status::Pending);
        result = Serializable::deserialize(b);
        assertTrue(result.isEnum());
        assertEq(Status::Pending, result);

        # Float enum stream round-trip
        b = Serializable::serialize(Multiplier::Half);
        result = Serializable::deserialize(b);
        assertTrue(result.isEnum());
        assertEq(Multiplier::Half, result);

        # Number enum stream round-trip
        b = Serializable::serialize(Precision::Extreme);
        result = Serializable::deserialize(b);
        assertTrue(result.isEnum());
        assertEq(Precision::Extreme, result);

        # Namespaced enum stream round-trip
        b = Serializable::serialize(Outer::Inner::SubType::SubA);
        result = Serializable::deserialize(b);
        assertTrue(result.isEnum());
        assertEq(Outer::Inner::SubType::SubA, result);
    }

    testEnumSerializationInContainer() {
        # Hash containing enums
        hash<auto> data = {
            "color": ColorInt::Blue,
            "status": Status::Deleted,
            "level": Test::Level::Error,
            "value": 42,
            "name": "test",
        };

        # Hash path round-trip
        hash<SerializationInfo> h = Serializable::serializeToData(data);
        auto result = Serializable::deserialize(h);
        assertEq("hash<auto>", result.fullType());
        assertTrue(result.color.isEnum());
        assertEq(ColorInt::Blue, result.color);
        assertTrue(result.status.isEnum());
        assertEq(Status::Deleted, result.status);
        assertTrue(result.level.isEnum());
        assertEq(Test::Level::Error, result.level);
        assertEq(42, result.value);
        assertEq("test", result.name);

        # Stream path round-trip
        binary b = Serializable::serialize(data);
        result = Serializable::deserialize(b);
        assertTrue(result.color.isEnum());
        assertEq(ColorInt::Blue, result.color);
        assertTrue(result.status.isEnum());
        assertEq(Status::Deleted, result.status);

        # List containing enums
        list<auto> lst = (ColorInt::Red, ColorInt::Green, ColorInt::Blue);
        h = Serializable::serializeToData(lst);
        result = Serializable::deserialize(h);
        assertEq(3, result.size());
        assertTrue(result[0].isEnum());
        assertEq(ColorInt::Red, result[0]);
        assertTrue(result[1].isEnum());
        assertEq(ColorInt::Green, result[1]);
        assertTrue(result[2].isEnum());
        assertEq(ColorInt::Blue, result[2]);

        # List stream round-trip
        b = Serializable::serialize(lst);
        result = Serializable::deserialize(b);
        assertEq(3, result.size());
        assertTrue(result[0].isEnum());
        assertEq(ColorInt::Red, result[0]);
    }

    testEnumSerializationBackwardCompat() {
        # Deserializing a bare int into auto should work (simulating old format)
        hash<SerializationInfo> h = Serializable::serializeToData(42);
        auto result = Serializable::deserialize(h);
        assertEq(42, result);
        assertFalse(result.isEnum());

        # Deserializing a bare string into auto should work
        h = Serializable::serializeToData("active");
        result = Serializable::deserialize(h);
        assertEq("active", result);
        assertFalse(result.isEnum());

        # Stream path: bare int
        binary b = Serializable::serialize(42);
        result = Serializable::deserialize(b);
        assertEq(42, result);
        assertFalse(result.isEnum());

        # Stream path: bare string
        b = Serializable::serialize("active");
        result = Serializable::deserialize(b);
        assertEq("active", result);
        assertFalse(result.isEnum());
    }

    testEnumDeserializationErrors() {
        # Unknown enum path in hash-based deserialization
        hash<SerializationInfo> h = Serializable::serializeToData(ColorInt::Red);
        # Tamper with the enum path to simulate unknown enum
        h._data._enum = "::NoSuchEnum";
        assertThrows("DESERIALIZATION-ERROR", "no such enum", sub () {
            auto v = Serializable::deserialize(h);
            remove v;
        });

        # Invalid member name in hash-based deserialization
        h = Serializable::serializeToData(ColorInt::Red);
        h._data._member = "NoSuchMember";
        assertThrows("DESERIALIZATION-ERROR", "not a valid member", sub () {
            auto v = Serializable::deserialize(h);
            remove v;
        });

        # _enum key without _member should NOT be treated as enum marker
        # (collision protection — user data with just "_enum" key passes through)
        h = Serializable::serializeToData({"_enum": "some_value"});
        auto result = Serializable::deserialize(h);
        assertEq("some_value", result._enum);

        # _enum + unrelated key (not _member) should also not trigger enum deserialization
        h = Serializable::serializeToData({"_enum": "some_value", "other": 42});
        result = Serializable::deserialize(h);
        assertEq("some_value", result._enum);
        assertEq(42, result.other);
    }
}
