}

#! each operation on a ESS member in a method of its object
hash<string, string> sub ess_self_in() {
    hash<string, string> rv;
    {
        Holder o();
        try { o.ess_rs(); rv.rs = ok(o.ess); }
        catch (hash<ExceptionInfo> ex) { rv.rs = err(ex, o.ess); }
    }
    {
        Holder o();
        try { o.ess_rsg(); rv.rsg = ok(o.ess); }
        catch (hash<ExceptionInfo> ex) { rv.rsg = err(ex, o.ess); }
    }
    {
        Holder o();
        try { o.ess_tl(); rv.tl = ok(o.ess); }
        catch (hash<ExceptionInfo> ex) { rv.tl = err(ex, o.ess); }
    }
    return rv;
}

#! applies an operation to a ESS local with no try block
sub ess_local_raise(string op) {
    ESS v = ESS::A;
    switch (op) {
        case "rs": v =~ s/a/X/; break;
        case "rsg": v =~ s/ /_/g; break;
        case "tl": v =~ tr/a-z/A-Z/; break;
    }
}

#! each operation on a ESS local raised in a function that it calls
hash<string, string> sub ess_local_out() {
    hash<string, string> rv;
    try { ess_local_raise("rs"); rv.rs = "none"; }
    catch (hash<ExceptionInfo> ex) { rv.rs = err_out(ex); }
    try { ess_local_raise("rsg"); rv.rsg = "none"; }
    catch (hash<ExceptionInfo> ex) { rv.rsg = err_out(ex); }
    try { ess_local_raise("tl"); rv.tl = "none"; }
    catch (hash<ExceptionInfo> ex) { rv.tl = err_out(ex); }
    return rv;
}

#! each operation on a ESS local in a try block in a loop
hash<string, string> sub ess_local_loop() {
    hash<string, string> rv;
    {
        ESS v = ESS::A;
        int caught = 0;
        for (int i = 0; i < 50; ++i) {
            try { v =~ s/a/X/; } catch (hash<ExceptionInfo> ex) { ++caught; }
        }
        rv.rs = sprintf("%s (caught %d)", ok(v), caught);
    }
    {
        ESS v = ESS::A;
        int caught = 0;
        for (int i = 0; i < 50; ++i) {
            try { v =~ s/ /_/g; } catch (hash<ExceptionInfo> ex) { ++caught; }
        }
        rv.rsg = sprintf("%s (caught %d)", ok(v), caught);
    }
    {
        ESS v = ESS::A;
        int caught = 0;
        for (int i = 0; i < 50; ++i) {
            try { v =~ tr/a-z/A-Z/; } catch (hash<ExceptionInfo> ex) { ++caught; }
        }
        rv.tl = sprintf("%s (caught %d)", ok(v), caught);
    }
    return rv;
}

string sub ess_param_rs(ESS v) {
    try { v =~ s/a/X/; return ok(v); } catch (hash<ExceptionInfo> ex) { return err(ex, v); }
}
sub ess_refparam_rs(reference<ESS> r) {
    r =~ s/a/X/;
}
string sub ess_param_rsg(ESS v) {
    try { v =~ s/ /_/g; return ok(v); } catch (hash<ExceptionInfo> ex) { return err(ex, v); }
}
sub ess_refparam_rsg(reference<ESS> r) {
    r =~ s/ /_/g;
}
string sub ess_param_tl(ESS v) {
    try { v =~ tr/a-z/A-Z/; return ok(v); } catch (hash<ExceptionInfo> ex) { return err(ex, v); }
}
sub ess_refparam_tl(reference<ESS> r) {
    r =~ tr/a-z/A-Z/;
}

#! each operation on a ESS parameter and through a reference parameter
hash<string, string> sub ess_params() {
    hash<string, string> rv;
    rv."param-rs" = ess_param_rs(ESS::A);
    {
        ESS v = ESS::A;
        try { ess_refparam_rs(\v); rv."refparam-rs" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."refparam-rs" = err(ex, v); }
    }
    rv."param-rsg" = ess_param_rsg(ESS::A);
    {
        ESS v = ESS::A;
        try { ess_refparam_rsg(\v); rv."refparam-rsg" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."refparam-rsg" = err(ex, v); }
    }
    rv."param-tl" = ess_param_tl(ESS::A);
    {
        ESS v = ESS::A;
        try { ess_refparam_tl(\v); rv."refparam-tl" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."refparam-tl" = err(ex, v); }
    }
    return rv;
}

