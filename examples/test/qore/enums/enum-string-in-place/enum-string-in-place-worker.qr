        try { esl_refparam_del(\v); rv."refparam-del" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."refparam-del" = err(ex, v); }
    }
    rv."param-rm-list" = esl_param_rm_list(ESL::B);
    {
        ESL v = ESL::B;
        try { esl_refparam_rm_list(\v); rv."refparam-rm-list" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."refparam-rm-list" = err(ex, v); }
