#! each operation on an ESL lvalue with no value (local)
hash<string, string> sub eslnv_local_in() {
    hash<string, string> rv;
    {
        ESL v;
        try { v =~ s/a/X/; rv.rs = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv.rs = err(ex, v); }
    }
    {
        ESL v;
        try { v =~ s/ /_/g; rv.rsg = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv.rsg = err(ex, v); }
    }
    {
        ESL v;
        try { v =~ tr/a-z/A-Z/; rv.tl = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv.tl = err(ex, v); }
    }
    {
        ESL v;
        try { v += "x"; rv.pe = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv.pe = err(ex, v); }
    }
    {
        ESL v;
        try { v += 1; rv."pe-int" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."pe-int" = err(ex, v); }
    }
    {
        ESL v;
        try { splice v, 0, 1; rv.sp = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv.sp = err(ex, v); }
    }
    {
        ESL v;
        try { splice v, 1, 2; rv."sp-len" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."sp-len" = err(ex, v); }
    }
    {
        ESL v;
        try { splice v, 0, 1, "zz"; rv."sp-rep" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."sp-rep" = err(ex, v); }
    }
    {
        ESL v;
        try { extract v, 0, 1; rv.ex = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv.ex = err(ex, v); }
    }
    {
        ESL v;
        try { extract v, 1, 2, "zz"; rv."ex-rep" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."ex-rep" = err(ex, v); }
    }
    {
        ESL v;
        try { trim v; rv.tr = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv.tr = err(ex, v); }
    }
    {
        ESL v;
        try { chomp v; rv.ch = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv.ch = err(ex, v); }
    }
    {
        ESL v;
        try { remove v[1]; rv.rm = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv.rm = err(ex, v); }
    }
    {
        ESL v;
        try { delete v[1]; rv.del = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv.del = err(ex, v); }
    }
    {
        ESL v;
        try { remove v[1, 2]; rv."rm-list" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."rm-list" = err(ex, v); }
    }
    {
        ESL v;
        try { remove v[1..2]; rv."rm-range" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."rm-range" = err(ex, v); }
    }
    {
        ESL v;
        try { delete v[1, 2]; rv."del-list" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."del-list" = err(ex, v); }
    }
    {
        ESL v;
        try { delete v[1..2]; rv."del-range" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."del-range" = err(ex, v); }
    }
    {
        ESL v;
        auto r;
        try { r = (v =~ s/a/X/); rv."rs-rv" = ok(v) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."rs-rv" = err(ex, v) + "|" + q(r); }
    }
    {
        ESL v;
        auto r;
        try { r = (v =~ tr/a-z/A-Z/); rv."tl-rv" = ok(v) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."tl-rv" = err(ex, v) + "|" + q(r); }
    }
    {
        ESL v;
        auto r;
        try { r = (v += "x"); rv."pe-rv" = ok(v) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."pe-rv" = err(ex, v) + "|" + q(r); }
    }
    {
        ESL v;
        auto r;
        try { r = (extract v, 0, 2); rv."ex-rv" = ok(v) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."ex-rv" = err(ex, v) + "|" + q(r); }
    }
    {
        ESL v;
        auto r;
        try { r = (trim v); rv."tr-rv" = ok(v) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."tr-rv" = err(ex, v) + "|" + q(r); }
    }
    {
        ESL v;
        auto r;
        try { r = (chomp v); rv."ch-rv" = ok(v) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."ch-rv" = err(ex, v) + "|" + q(r); }
    }
    {
        ESL v;
        auto r;
        try { r = (remove v[1]); rv."rm-rv" = ok(v) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."rm-rv" = err(ex, v) + "|" + q(r); }
    }
    {
        ESL v;
        auto r;
        try { r = (remove v[1..2]); rv."rm-range-rv" = ok(v) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."rm-range-rv" = err(ex, v) + "|" + q(r); }
    }
    return rv;
}

