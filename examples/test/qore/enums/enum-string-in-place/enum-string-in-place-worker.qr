        catch (hash<ExceptionInfo> ex) { rv."tl-rv" = err(ex, v) + "|" + q(r); }
    }
    {
        ESS v = ESS::A;
        reference<ESS> rf = \v;
        auto r;
        try { r = (rf += "x"); rv."pe-rv" = ok(v) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."pe-rv" = err(ex, v) + "|" + q(r); }
    }
    {
        ESS v = ESS::A;
        reference<ESS> rf = \v;
        auto r;
        try { r = (extract rf, 0, 2); rv."ex-rv" = ok(v) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."ex-rv" = err(ex, v) + "|" + q(r); }
    }
    {
        ESS v = ESS::A;
        reference<ESS> rf = \v;
        auto r;
        try { r = (trim rf); rv."tr-rv" = ok(v) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."tr-rv" = err(ex, v) + "|" + q(r); }
    }
    {
        ESS v = ESS::A;
        reference<ESS> rf = \v;
        auto r;
        try { r = (chomp rf); rv."ch-rv" = ok(v) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."ch-rv" = err(ex, v) + "|" + q(r); }
    }
    {
        ESS v = ESS::A;
        reference<ESS> rf = \v;
        auto r;
        try { r = (remove rf[1]); rv."rm-rv" = ok(v) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."rm-rv" = err(ex, v) + "|" + q(r); }
    }
    {
        ESS v = ESS::A;
        reference<ESS> rf = \v;
        auto r;
        try { r = (remove rf[1..2]); rv."rm-range-rv" = ok(v) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."rm-range-rv" = err(ex, v) + "|" + q(r); }
    }
    return rv;
}

#! each operation on a ESS member in a method of its object
hash<string, string> sub ess_self_in() {
    hash<string, string> rv;
    {
        Holder o();
        try { o.ess_rs(); rv.rs = ok(o.ess); }
        catch (hash<ExceptionInfo> ex) { rv.rs = err(ex, o.ess); }
    }
    {
        Holder o();
        try { o.ess_rsg(); rv.rsg = ok(o.ess); }
        catch (hash<ExceptionInfo> ex) { rv.rsg = err(ex, o.ess); }
    }
    {
        Holder o();
        try { o.ess_tl(); rv.tl = ok(o.ess); }
        catch (hash<ExceptionInfo> ex) { rv.tl = err(ex, o.ess); }
    }
    {
        Holder o();
        try { o.ess_pe(); rv.pe = ok(o.ess); }
        catch (hash<ExceptionInfo> ex) { rv.pe = err(ex, o.ess); }
    }
    {
        Holder o();
        try { o.ess_pe_int(); rv."pe-int" = ok(o.ess); }
        catch (hash<ExceptionInfo> ex) { rv."pe-int" = err(ex, o.ess); }
    }
    {
        Holder o();
        try { o.ess_sp(); rv.sp = ok(o.ess); }
        catch (hash<ExceptionInfo> ex) { rv.sp = err(ex, o.ess); }
    }
    {
        Holder o();
        try { o.ess_sp_len(); rv."sp-len" = ok(o.ess); }
        catch (hash<ExceptionInfo> ex) { rv."sp-len" = err(ex, o.ess); }
    }
    {
        Holder o();
        try { o.ess_sp_rep(); rv."sp-rep" = ok(o.ess); }
        catch (hash<ExceptionInfo> ex) { rv."sp-rep" = err(ex, o.ess); }
    }
    {
        Holder o();
        try { o.ess_ex(); rv.ex = ok(o.ess); }
        catch (hash<ExceptionInfo> ex) { rv.ex = err(ex, o.ess); }
    }
    {
        Holder o();
        try { o.ess_ex_rep(); rv."ex-rep" = ok(o.ess); }
        catch (hash<ExceptionInfo> ex) { rv."ex-rep" = err(ex, o.ess); }
    }
    {
        Holder o();
        try { o.ess_tr(); rv.tr = ok(o.ess); }
        catch (hash<ExceptionInfo> ex) { rv.tr = err(ex, o.ess); }
    }
    {
        Holder o();
        try { o.ess_ch(); rv.ch = ok(o.ess); }
        catch (hash<ExceptionInfo> ex) { rv.ch = err(ex, o.ess); }
    }
    {
        Holder o();
        try { o.ess_rm(); rv.rm = ok(o.ess); }
        catch (hash<ExceptionInfo> ex) { rv.rm = err(ex, o.ess); }
    }
    {
        Holder o();
        try { o.ess_del(); rv.del = ok(o.ess); }
        catch (hash<ExceptionInfo> ex) { rv.del = err(ex, o.ess); }
    }
    {
        Holder o();
        try { o.ess_rm_list(); rv."rm-list" = ok(o.ess); }
        catch (hash<ExceptionInfo> ex) { rv."rm-list" = err(ex, o.ess); }
    }
    {
        Holder o();
        try { o.ess_rm_range(); rv."rm-range" = ok(o.ess); }
        catch (hash<ExceptionInfo> ex) { rv."rm-range" = err(ex, o.ess); }
    }
    {
        Holder o();
        try { o.ess_del_list(); rv."del-list" = ok(o.ess); }
        catch (hash<ExceptionInfo> ex) { rv."del-list" = err(ex, o.ess); }
    }
    {
        Holder o();
        try { o.ess_del_range(); rv."del-range" = ok(o.ess); }
        catch (hash<ExceptionInfo> ex) { rv."del-range" = err(ex, o.ess); }
    }
    return rv;
}

#! applies an operation to a ESS local with no try block
sub ess_local_raise(string op) {
    ESS v = ESS::A;
    switch (op) {
        case "rs": v =~ s/a/X/; break;
        case "rsg": v =~ s/ /_/g; break;
        case "tl": v =~ tr/a-z/A-Z/; break;
        case "pe": v += "x"; break;
        case "pe-int": v += 1; break;
        case "sp": splice v, 0, 1; break;
        case "sp-len": splice v, 1, 2; break;
        case "sp-rep": splice v, 0, 1, "zz"; break;
        case "ex": extract v, 0, 1; break;
        case "ex-rep": extract v, 1, 2, "zz"; break;
        case "tr": trim v; break;
        case "ch": chomp v; break;
        case "rm": remove v[1]; break;
        case "del": delete v[1]; break;
        case "rm-list": remove v[1, 2]; break;
        case "rm-range": remove v[1..2]; break;
        case "del-list": delete v[1, 2]; break;
        case "del-range": delete v[1..2]; break;
    }
}

#! each operation on a ESS local raised in a function that it calls
hash<string, string> sub ess_local_out() {
    hash<string, string> rv;
    try { ess_local_raise("rs"); rv.rs = "none"; }
    catch (hash<ExceptionInfo> ex) { rv.rs = err_out(ex); }
    try { ess_local_raise("rsg"); rv.rsg = "none"; }
    catch (hash<ExceptionInfo> ex) { rv.rsg = err_out(ex); }
    try { ess_local_raise("tl"); rv.tl = "none"; }
    catch (hash<ExceptionInfo> ex) { rv.tl = err_out(ex); }
    try { ess_local_raise("pe"); rv.pe = "none"; }
    catch (hash<ExceptionInfo> ex) { rv.pe = err_out(ex); }
    try { ess_local_raise("pe-int"); rv."pe-int" = "none"; }
    catch (hash<ExceptionInfo> ex) { rv."pe-int" = err_out(ex); }
    try { ess_local_raise("sp"); rv.sp = "none"; }
    catch (hash<ExceptionInfo> ex) { rv.sp = err_out(ex); }
    try { ess_local_raise("sp-len"); rv."sp-len" = "none"; }
    catch (hash<ExceptionInfo> ex) { rv."sp-len" = err_out(ex); }
    try { ess_local_raise("sp-rep"); rv."sp-rep" = "none"; }
    catch (hash<ExceptionInfo> ex) { rv."sp-rep" = err_out(ex); }
    try { ess_local_raise("ex"); rv.ex = "none"; }
    catch (hash<ExceptionInfo> ex) { rv.ex = err_out(ex); }
    try { ess_local_raise("ex-rep"); rv."ex-rep" = "none"; }
    catch (hash<ExceptionInfo> ex) { rv."ex-rep" = err_out(ex); }
    try { ess_local_raise("tr"); rv.tr = "none"; }
    catch (hash<ExceptionInfo> ex) { rv.tr = err_out(ex); }
    try { ess_local_raise("ch"); rv.ch = "none"; }
    catch (hash<ExceptionInfo> ex) { rv.ch = err_out(ex); }
    try { ess_local_raise("rm"); rv.rm = "none"; }
    catch (hash<ExceptionInfo> ex) { rv.rm = err_out(ex); }
    try { ess_local_raise("del"); rv.del = "none"; }
    catch (hash<ExceptionInfo> ex) { rv.del = err_out(ex); }
    try { ess_local_raise("rm-list"); rv."rm-list" = "none"; }
    catch (hash<ExceptionInfo> ex) { rv."rm-list" = err_out(ex); }
    try { ess_local_raise("rm-range"); rv."rm-range" = "none"; }
    catch (hash<ExceptionInfo> ex) { rv."rm-range" = err_out(ex); }
    try { ess_local_raise("del-list"); rv."del-list" = "none"; }
    catch (hash<ExceptionInfo> ex) { rv."del-list" = err_out(ex); }
    try { ess_local_raise("del-range"); rv."del-range" = "none"; }
    catch (hash<ExceptionInfo> ex) { rv."del-range" = err_out(ex); }
    return rv;
}

#! each operation on a ESS local in a try block in a loop
hash<string, string> sub ess_local_loop() {
    hash<string, string> rv;
    {
        ESS v = ESS::A;
        int caught = 0;
        for (int i = 0; i < 50; ++i) {
            try { v =~ s/a/X/; } catch (hash<ExceptionInfo> ex) { ++caught; }
        }
        rv.rs = sprintf("%s (caught %d)", ok(v), caught);
    }
    {
        ESS v = ESS::A;
        int caught = 0;
        for (int i = 0; i < 50; ++i) {
            try { v =~ s/ /_/g; } catch (hash<ExceptionInfo> ex) { ++caught; }
        }
        rv.rsg = sprintf("%s (caught %d)", ok(v), caught);
    }
    {
        ESS v = ESS::A;
        int caught = 0;
        for (int i = 0; i < 50; ++i) {
            try { v =~ tr/a-z/A-Z/; } catch (hash<ExceptionInfo> ex) { ++caught; }
        }
        rv.tl = sprintf("%s (caught %d)", ok(v), caught);
    }
    {
        ESS v = ESS::A;
        int caught = 0;
        for (int i = 0; i < 50; ++i) {
            try { v += "x"; } catch (hash<ExceptionInfo> ex) { ++caught; }
        }
        rv.pe = sprintf("%s (caught %d)", ok(v), caught);
    }
    {
        ESS v = ESS::A;
        int caught = 0;
        for (int i = 0; i < 50; ++i) {
            try { v += 1; } catch (hash<ExceptionInfo> ex) { ++caught; }
        }
        rv."pe-int" = sprintf("%s (caught %d)", ok(v), caught);
    }
    {
        ESS v = ESS::A;
        int caught = 0;
        for (int i = 0; i < 50; ++i) {
            try { splice v, 0, 1; } catch (hash<ExceptionInfo> ex) { ++caught; }
        }
        rv.sp = sprintf("%s (caught %d)", ok(v), caught);
    }
    {
        ESS v = ESS::A;
        int caught = 0;
        for (int i = 0; i < 50; ++i) {
            try { splice v, 1, 2; } catch (hash<ExceptionInfo> ex) { ++caught; }
        }
        rv."sp-len" = sprintf("%s (caught %d)", ok(v), caught);
    }
    {
        ESS v = ESS::A;
        int caught = 0;
        for (int i = 0; i < 50; ++i) {
            try { splice v, 0, 1, "zz"; } catch (hash<ExceptionInfo> ex) { ++caught; }
        }
        rv."sp-rep" = sprintf("%s (caught %d)", ok(v), caught);
    }
    {
        ESS v = ESS::A;
        int caught = 0;
        for (int i = 0; i < 50; ++i) {
            try { extract v, 0, 1; } catch (hash<ExceptionInfo> ex) { ++caught; }
        }
        rv.ex = sprintf("%s (caught %d)", ok(v), caught);
    }
    {
        ESS v = ESS::A;
        int caught = 0;
        for (int i = 0; i < 50; ++i) {
            try { extract v, 1, 2, "zz"; } catch (hash<ExceptionInfo> ex) { ++caught; }
        }
        rv."ex-rep" = sprintf("%s (caught %d)", ok(v), caught);
    }
    {
        ESS v = ESS::A;
        int caught = 0;
        for (int i = 0; i < 50; ++i) {
            try { trim v; } catch (hash<ExceptionInfo> ex) { ++caught; }
        }
        rv.tr = sprintf("%s (caught %d)", ok(v), caught);
    }
    {
        ESS v = ESS::A;
        int caught = 0;
        for (int i = 0; i < 50; ++i) {
            try { chomp v; } catch (hash<ExceptionInfo> ex) { ++caught; }
        }
        rv.ch = sprintf("%s (caught %d)", ok(v), caught);
    }
    {
        ESS v = ESS::A;
        int caught = 0;
        for (int i = 0; i < 50; ++i) {
            try { remove v[1]; } catch (hash<ExceptionInfo> ex) { ++caught; }
        }
        rv.rm = sprintf("%s (caught %d)", ok(v), caught);
    }
    {
        ESS v = ESS::A;
        int caught = 0;
        for (int i = 0; i < 50; ++i) {
            try { delete v[1]; } catch (hash<ExceptionInfo> ex) { ++caught; }
        }
        rv.del = sprintf("%s (caught %d)", ok(v), caught);
    }
    {
        ESS v = ESS::A;
        int caught = 0;
        for (int i = 0; i < 50; ++i) {
            try { remove v[1, 2]; } catch (hash<ExceptionInfo> ex) { ++caught; }
        }
        rv."rm-list" = sprintf("%s (caught %d)", ok(v), caught);
    }
    {
        ESS v = ESS::A;
        int caught = 0;
        for (int i = 0; i < 50; ++i) {
            try { remove v[1..2]; } catch (hash<ExceptionInfo> ex) { ++caught; }
        }
        rv."rm-range" = sprintf("%s (caught %d)", ok(v), caught);
    }
    {
        ESS v = ESS::A;
        int caught = 0;
        for (int i = 0; i < 50; ++i) {
            try { delete v[1, 2]; } catch (hash<ExceptionInfo> ex) { ++caught; }
        }
        rv."del-list" = sprintf("%s (caught %d)", ok(v), caught);
    }
    {
        ESS v = ESS::A;
        int caught = 0;
        for (int i = 0; i < 50; ++i) {
            try { delete v[1..2]; } catch (hash<ExceptionInfo> ex) { ++caught; }
        }
        rv."del-range" = sprintf("%s (caught %d)", ok(v), caught);
    }
    return rv;
}

string sub ess_param_rs(ESS v) {
    try { v =~ s/a/X/; return ok(v); } catch (hash<ExceptionInfo> ex) { return err(ex, v); }
}
sub ess_refparam_rs(reference<ESS> r) {
    r =~ s/a/X/;
}
string sub ess_param_rsg(ESS v) {
    try { v =~ s/ /_/g; return ok(v); } catch (hash<ExceptionInfo> ex) { return err(ex, v); }
}
sub ess_refparam_rsg(reference<ESS> r) {
    r =~ s/ /_/g;
}
string sub ess_param_tl(ESS v) {
    try { v =~ tr/a-z/A-Z/; return ok(v); } catch (hash<ExceptionInfo> ex) { return err(ex, v); }
}
sub ess_refparam_tl(reference<ESS> r) {
    r =~ tr/a-z/A-Z/;
}
string sub ess_param_pe(ESS v) {
    try { v += "x"; return ok(v); } catch (hash<ExceptionInfo> ex) { return err(ex, v); }
}
sub ess_refparam_pe(reference<ESS> r) {
    r += "x";
}
string sub ess_param_pe_int(ESS v) {
    try { v += 1; return ok(v); } catch (hash<ExceptionInfo> ex) { return err(ex, v); }
}
sub ess_refparam_pe_int(reference<ESS> r) {
    r += 1;
}
string sub ess_param_sp(ESS v) {
    try { splice v, 0, 1; return ok(v); } catch (hash<ExceptionInfo> ex) { return err(ex, v); }
}
sub ess_refparam_sp(reference<ESS> r) {
    splice r, 0, 1;
}
string sub ess_param_sp_len(ESS v) {
    try { splice v, 1, 2; return ok(v); } catch (hash<ExceptionInfo> ex) { return err(ex, v); }
}
sub ess_refparam_sp_len(reference<ESS> r) {
    splice r, 1, 2;
}
string sub ess_param_sp_rep(ESS v) {
    try { splice v, 0, 1, "zz"; return ok(v); } catch (hash<ExceptionInfo> ex) { return err(ex, v); }
}
sub ess_refparam_sp_rep(reference<ESS> r) {
    splice r, 0, 1, "zz";
}
string sub ess_param_ex(ESS v) {
    try { extract v, 0, 1; return ok(v); } catch (hash<ExceptionInfo> ex) { return err(ex, v); }
}
sub ess_refparam_ex(reference<ESS> r) {
    extract r, 0, 1;
}
string sub ess_param_ex_rep(ESS v) {
    try { extract v, 1, 2, "zz"; return ok(v); } catch (hash<ExceptionInfo> ex) { return err(ex, v); }
}
sub ess_refparam_ex_rep(reference<ESS> r) {
    extract r, 1, 2, "zz";
}
string sub ess_param_tr(ESS v) {
    try { trim v; return ok(v); } catch (hash<ExceptionInfo> ex) { return err(ex, v); }
}
sub ess_refparam_tr(reference<ESS> r) {
    trim r;
}
string sub ess_param_ch(ESS v) {
    try { chomp v; return ok(v); } catch (hash<ExceptionInfo> ex) { return err(ex, v); }
}
sub ess_refparam_ch(reference<ESS> r) {
    chomp r;
}
string sub ess_param_rm(ESS v) {
    try { remove v[1]; return ok(v); } catch (hash<ExceptionInfo> ex) { return err(ex, v); }
}
sub ess_refparam_rm(reference<ESS> r) {
    remove r[1];
}
string sub ess_param_del(ESS v) {
    try { delete v[1]; return ok(v); } catch (hash<ExceptionInfo> ex) { return err(ex, v); }
}
sub ess_refparam_del(reference<ESS> r) {
    delete r[1];
}
string sub ess_param_rm_list(ESS v) {
    try { remove v[1, 2]; return ok(v); } catch (hash<ExceptionInfo> ex) { return err(ex, v); }
}
sub ess_refparam_rm_list(reference<ESS> r) {
    remove r[1, 2];
}
string sub ess_param_rm_range(ESS v) {
    try { remove v[1..2]; return ok(v); } catch (hash<ExceptionInfo> ex) { return err(ex, v); }
}
sub ess_refparam_rm_range(reference<ESS> r) {
    remove r[1..2];
}
string sub ess_param_del_list(ESS v) {
    try { delete v[1, 2]; return ok(v); } catch (hash<ExceptionInfo> ex) { return err(ex, v); }
}
sub ess_refparam_del_list(reference<ESS> r) {
    delete r[1, 2];
}
string sub ess_param_del_range(ESS v) {
    try { delete v[1..2]; return ok(v); } catch (hash<ExceptionInfo> ex) { return err(ex, v); }
}
sub ess_refparam_del_range(reference<ESS> r) {
    delete r[1..2];
}

#! each operation on a ESS parameter and through a reference parameter
hash<string, string> sub ess_params() {
    hash<string, string> rv;
    rv."param-rs" = ess_param_rs(ESS::A);
    {
        ESS v = ESS::A;
        try { ess_refparam_rs(\v); rv."refparam-rs" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."refparam-rs" = err(ex, v); }
    }
    rv."param-rsg" = ess_param_rsg(ESS::A);
    {
        ESS v = ESS::A;
        try { ess_refparam_rsg(\v); rv."refparam-rsg" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."refparam-rsg" = err(ex, v); }
    }
    rv."param-tl" = ess_param_tl(ESS::A);
    {
        ESS v = ESS::A;
        try { ess_refparam_tl(\v); rv."refparam-tl" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."refparam-tl" = err(ex, v); }
    }
    rv."param-pe" = ess_param_pe(ESS::A);
    {
        ESS v = ESS::A;
        try { ess_refparam_pe(\v); rv."refparam-pe" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."refparam-pe" = err(ex, v); }
    }
    rv."param-pe-int" = ess_param_pe_int(ESS::A);
    {
        ESS v = ESS::A;
        try { ess_refparam_pe_int(\v); rv."refparam-pe-int" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."refparam-pe-int" = err(ex, v); }
    }
    rv."param-sp" = ess_param_sp(ESS::A);
    {
        ESS v = ESS::A;
        try { ess_refparam_sp(\v); rv."refparam-sp" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."refparam-sp" = err(ex, v); }
    }
    rv."param-sp-len" = ess_param_sp_len(ESS::A);
    {
        ESS v = ESS::A;
        try { ess_refparam_sp_len(\v); rv."refparam-sp-len" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."refparam-sp-len" = err(ex, v); }
    }
    rv."param-sp-rep" = ess_param_sp_rep(ESS::A);
    {
        ESS v = ESS::A;
        try { ess_refparam_sp_rep(\v); rv."refparam-sp-rep" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."refparam-sp-rep" = err(ex, v); }
    }
    rv."param-ex" = ess_param_ex(ESS::A);
    {
        ESS v = ESS::A;
        try { ess_refparam_ex(\v); rv."refparam-ex" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."refparam-ex" = err(ex, v); }
    }
    rv."param-ex-rep" = ess_param_ex_rep(ESS::A);
    {
        ESS v = ESS::A;
        try { ess_refparam_ex_rep(\v); rv."refparam-ex-rep" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."refparam-ex-rep" = err(ex, v); }
    }
    rv."param-tr" = ess_param_tr(ESS::A);
    {
        ESS v = ESS::A;
        try { ess_refparam_tr(\v); rv."refparam-tr" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."refparam-tr" = err(ex, v); }
    }
    rv."param-ch" = ess_param_ch(ESS::A);
    {
        ESS v = ESS::A;
        try { ess_refparam_ch(\v); rv."refparam-ch" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."refparam-ch" = err(ex, v); }
    }
    rv."param-rm" = ess_param_rm(ESS::A);
    {
        ESS v = ESS::A;
        try { ess_refparam_rm(\v); rv."refparam-rm" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."refparam-rm" = err(ex, v); }
    }
    rv."param-del" = ess_param_del(ESS::A);
    {
        ESS v = ESS::A;
        try { ess_refparam_del(\v); rv."refparam-del" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."refparam-del" = err(ex, v); }
    }
    rv."param-rm-list" = ess_param_rm_list(ESS::A);
    {
        ESS v = ESS::A;
        try { ess_refparam_rm_list(\v); rv."refparam-rm-list" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."refparam-rm-list" = err(ex, v); }
    }
    rv."param-rm-range" = ess_param_rm_range(ESS::A);
    {
        ESS v = ESS::A;
        try { ess_refparam_rm_range(\v); rv."refparam-rm-range" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."refparam-rm-range" = err(ex, v); }
    }
    rv."param-del-list" = ess_param_del_list(ESS::A);
    {
        ESS v = ESS::A;
        try { ess_refparam_del_list(\v); rv."refparam-del-list" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."refparam-del-list" = err(ex, v); }
    }
    rv."param-del-range" = ess_param_del_range(ESS::A);
    {
        ESS v = ESS::A;
        try { ess_refparam_del_range(\v); rv."refparam-del-range" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."refparam-del-range" = err(ex, v); }
    }
    return rv;
}

#! each operation on a ESL lvalue (local) in a try block
hash<string, string> sub esl_local_in() {
    hash<string, string> rv;
    {
        ESL v = ESL::B;
        try { v =~ s/a/X/; rv.rs = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv.rs = err(ex, v); }
    }
    {
        ESL v = ESL::B;
        try { v =~ s/ /_/g; rv.rsg = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv.rsg = err(ex, v); }
    }
    {
        ESL v = ESL::B;
        try { v =~ tr/a-z/A-Z/; rv.tl = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv.tl = err(ex, v); }
    }
    {
        ESL v = ESL::B;
        try { v += "x"; rv.pe = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv.pe = err(ex, v); }
    }
    {
        ESL v = ESL::B;
        try { v += 1; rv."pe-int" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."pe-int" = err(ex, v); }
    }
    {
        ESL v = ESL::B;
        try { splice v, 0, 1; rv.sp = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv.sp = err(ex, v); }
    }
    {
        ESL v = ESL::B;
        try { splice v, 1, 2; rv."sp-len" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."sp-len" = err(ex, v); }
    }
    {
        ESL v = ESL::B;
        try { splice v, 0, 1, "zz"; rv."sp-rep" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."sp-rep" = err(ex, v); }
    }
    {
        ESL v = ESL::B;
        try { extract v, 0, 1; rv.ex = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv.ex = err(ex, v); }
    }
    {
        ESL v = ESL::B;
        try { extract v, 1, 2, "zz"; rv."ex-rep" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."ex-rep" = err(ex, v); }
    }
    {
        ESL v = ESL::B;
        try { trim v; rv.tr = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv.tr = err(ex, v); }
    }
    {
        ESL v = ESL::B;
        try { chomp v; rv.ch = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv.ch = err(ex, v); }
    }
    {
        ESL v = ESL::B;
        try { remove v[1]; rv.rm = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv.rm = err(ex, v); }
    }
    {
        ESL v = ESL::B;
        try { delete v[1]; rv.del = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv.del = err(ex, v); }
    }
    {
        ESL v = ESL::B;
        try { remove v[1, 2]; rv."rm-list" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."rm-list" = err(ex, v); }
    }
    {
        ESL v = ESL::B;
        try { remove v[1..2]; rv."rm-range" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."rm-range" = err(ex, v); }
    }
    {
        ESL v = ESL::B;
        try { delete v[1, 2]; rv."del-list" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."del-list" = err(ex, v); }
    }
    {
        ESL v = ESL::B;
        try { delete v[1..2]; rv."del-range" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."del-range" = err(ex, v); }
    }
    {
        ESL v = ESL::B;
        auto r;
        try { r = (v =~ s/a/X/); rv."rs-rv" = ok(v) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."rs-rv" = err(ex, v) + "|" + q(r); }
    }
    {
        ESL v = ESL::B;
        auto r;
        try { r = (v =~ tr/a-z/A-Z/); rv."tl-rv" = ok(v) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."tl-rv" = err(ex, v) + "|" + q(r); }
    }
    {
        ESL v = ESL::B;
        auto r;
        try { r = (v += "x"); rv."pe-rv" = ok(v) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."pe-rv" = err(ex, v) + "|" + q(r); }
    }
    {
        ESL v = ESL::B;
        auto r;
        try { r = (extract v, 0, 2); rv."ex-rv" = ok(v) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."ex-rv" = err(ex, v) + "|" + q(r); }
    }
    {
        ESL v = ESL::B;
        auto r;
        try { r = (trim v); rv."tr-rv" = ok(v) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."tr-rv" = err(ex, v) + "|" + q(r); }
    }
    {
        ESL v = ESL::B;
        auto r;
        try { r = (chomp v); rv."ch-rv" = ok(v) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."ch-rv" = err(ex, v) + "|" + q(r); }
    }
    {
        ESL v = ESL::B;
        auto r;
        try { r = (remove v[1]); rv."rm-rv" = ok(v) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."rm-rv" = err(ex, v) + "|" + q(r); }
    }
    {
        ESL v = ESL::B;
        auto r;
        try { r = (remove v[1..2]); rv."rm-range-rv" = ok(v) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."rm-range-rv" = err(ex, v) + "|" + q(r); }
    }
    return rv;
}

#! each operation on a ESL lvalue (closure) in a try block
hash<string, string> sub esl_closure_in() {
    hash<string, string> rv;
    {
        ESL v = ESL::B;
        code get = auto sub () { return v; };
        try { v =~ s/a/X/; rv.rs = ok(get()); }
        catch (hash<ExceptionInfo> ex) { rv.rs = err(ex, get()); }
    }
    {
        ESL v = ESL::B;
        code get = auto sub () { return v; };
        try { v =~ s/ /_/g; rv.rsg = ok(get()); }
        catch (hash<ExceptionInfo> ex) { rv.rsg = err(ex, get()); }
    }
    {
        ESL v = ESL::B;
        code get = auto sub () { return v; };
        try { v =~ tr/a-z/A-Z/; rv.tl = ok(get()); }
        catch (hash<ExceptionInfo> ex) { rv.tl = err(ex, get()); }
    }
    {
        ESL v = ESL::B;
        code get = auto sub () { return v; };
        try { v += "x"; rv.pe = ok(get()); }
