    }
    rv."param-ex" = esl_param_ex(ESL::B);
    {
        ESL v = ESL::B;
        try { esl_refparam_ex(\v); rv."refparam-ex" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."refparam-ex" = err(ex, v); }
    }
    rv."param-ex-rep" = esl_param_ex_rep(ESL::B);
    {
        ESL v = ESL::B;
        try { esl_refparam_ex_rep(\v); rv."refparam-ex-rep" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."refparam-ex-rep" = err(ex, v); }
    }
    rv."param-tr" = esl_param_tr(ESL::B);
    {
        ESL v = ESL::B;
        try { esl_refparam_tr(\v); rv."refparam-tr" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."refparam-tr" = err(ex, v); }
    }
    rv."param-ch" = esl_param_ch(ESL::B);
