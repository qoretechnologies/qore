        try { r = (extract h{key}, 0, 2); rv."ex-rv" = ok(h{key}) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."ex-rv" = err(ex, h{key}) + "|" + q(r); }
    }
    {
        hash<string, ESS> h = {"k": ESS::A};
