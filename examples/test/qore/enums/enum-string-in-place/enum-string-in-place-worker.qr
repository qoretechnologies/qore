#! each operation on a ESL member in a method of its object
hash<string, string> sub esl_self_in() {
    hash<string, string> rv;
    {
        Holder o();
        try { o.esl_rs(); rv.rs = ok(o.esl); }
        catch (hash<ExceptionInfo> ex) { rv.rs = err(ex, o.esl); }
    }
    {
        Holder o();
        try { o.esl_rsg(); rv.rsg = ok(o.esl); }
        catch (hash<ExceptionInfo> ex) { rv.rsg = err(ex, o.esl); }
    }
    {
        Holder o();
        try { o.esl_tl(); rv.tl = ok(o.esl); }
        catch (hash<ExceptionInfo> ex) { rv.tl = err(ex, o.esl); }
    }
    return rv;
}

#! applies an operation to a ESL local with no try block
sub esl_local_raise(string op) {
    ESL v = ESL::B;
    switch (op) {
        case "rs": v =~ s/a/X/; break;
        case "rsg": v =~ s/ /_/g; break;
        case "tl": v =~ tr/a-z/A-Z/; break;
    }
}

#! each operation on a ESL local raised in a function that it calls
hash<string, string> sub esl_local_out() {
    hash<string, string> rv;
    try { esl_local_raise("rs"); rv.rs = "none"; }
    catch (hash<ExceptionInfo> ex) { rv.rs = err_out(ex); }
    try { esl_local_raise("rsg"); rv.rsg = "none"; }
    catch (hash<ExceptionInfo> ex) { rv.rsg = err_out(ex); }
    try { esl_local_raise("tl"); rv.tl = "none"; }
    catch (hash<ExceptionInfo> ex) { rv.tl = err_out(ex); }
    return rv;
}

#! each operation on a ESL local in a try block in a loop
hash<string, string> sub esl_local_loop() {
    hash<string, string> rv;
    {
        ESL v = ESL::B;
        int caught = 0;
        for (int i = 0; i < 50; ++i) {
            try { v =~ s/a/X/; } catch (hash<ExceptionInfo> ex) { ++caught; }
        }
        rv.rs = sprintf("%s (caught %d)", ok(v), caught);
    }
    {
        ESL v = ESL::B;
        int caught = 0;
        for (int i = 0; i < 50; ++i) {
            try { v =~ s/ /_/g; } catch (hash<ExceptionInfo> ex) { ++caught; }
        }
        rv.rsg = sprintf("%s (caught %d)", ok(v), caught);
    }
    {
        ESL v = ESL::B;
        int caught = 0;
        for (int i = 0; i < 50; ++i) {
            try { v =~ tr/a-z/A-Z/; } catch (hash<ExceptionInfo> ex) { ++caught; }
        }
        rv.tl = sprintf("%s (caught %d)", ok(v), caught);
    }
    return rv;
}

string sub esl_param_rs(ESL v) {
    try { v =~ s/a/X/; return ok(v); } catch (hash<ExceptionInfo> ex) { return err(ex, v); }
}
sub esl_refparam_rs(reference<ESL> r) {
    r =~ s/a/X/;
}
string sub esl_param_rsg(ESL v) {
    try { v =~ s/ /_/g; return ok(v); } catch (hash<ExceptionInfo> ex) { return err(ex, v); }
}
sub esl_refparam_rsg(reference<ESL> r) {
    r =~ s/ /_/g;
}
string sub esl_param_tl(ESL v) {
    try { v =~ tr/a-z/A-Z/; return ok(v); } catch (hash<ExceptionInfo> ex) { return err(ex, v); }
}
sub esl_refparam_tl(reference<ESL> r) {
    r =~ tr/a-z/A-Z/;
}

#! each operation on a ESL parameter and through a reference parameter
hash<string, string> sub esl_params() {
    hash<string, string> rv;
    rv."param-rs" = esl_param_rs(ESL::B);
    {
        ESL v = ESL::B;
        try { esl_refparam_rs(\v); rv."refparam-rs" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."refparam-rs" = err(ex, v); }
    }
    rv."param-rsg" = esl_param_rsg(ESL::B);
    {
        ESL v = ESL::B;
        try { esl_refparam_rsg(\v); rv."refparam-rsg" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."refparam-rsg" = err(ex, v); }
    }
    rv."param-tl" = esl_param_tl(ESL::B);
    {
        ESL v = ESL::B;
        try { esl_refparam_tl(\v); rv."refparam-tl" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."refparam-tl" = err(ex, v); }
    }
    return rv;
}

