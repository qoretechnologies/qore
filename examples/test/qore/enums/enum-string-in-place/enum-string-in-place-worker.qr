#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# applies the operations that modify a string in place to string enum lvalues; run by EnumStringInPlace-1.qtest and EnumStringInPlace-2.qtest
# generated by make-worker.py from worker-header.txt; do not edit

/** A string enum lvalue holds only the members of its enum: an operation that modifies the lvalue's string in place
    (+=, splice, extract, trim, chomp, regex substitution and transliteration) leaves a plain string, which the enum
    type refuses, so every such operation raises RUNTIME-TYPE-ERROR and leaves the lvalue unchanged, in every kind of
    lvalue, and never changes the value of the enum member.  Each check prints "name=<error>|<description>|<type>
    <value>", or "name=none|<type> <value>" if no error was raised; a check that uses the operation's value appends
    "|<type> <value>" of the value.  The same operations on a string lvalue and on lvalues of no type holding an enum
    value are controls, which they change.
*/

enum ESS : string {
    A = " a\n",
}

enum ESL : string {
    B = " a long string value that is not stored inline\n",
}

class Holder {
    public {
        ESS ess = ESS::A;
        ESL esl = ESL::B;
        ESL eslnv;
        *ESL eslonv;
        hash<string, ESL> hesl;
    }

    ess_rs() { ess =~ s/a/X/; }
    ess_rsg() { ess =~ s/ /_/g; }
    ess_tl() { ess =~ tr/a-z/A-Z/; }
    ess_pe() { ess += "x"; }
    ess_pe_int() { ess += 1; }
    ess_sp() { splice ess, 0, 1; }
    ess_sp_len() { splice ess, 1, 2; }
    ess_sp_rep() { splice ess, 0, 1, "zz"; }
    ess_ex() { extract ess, 0, 1; }
    ess_ex_rep() { extract ess, 1, 2, "zz"; }
    ess_tr() { trim ess; }
    ess_ch() { chomp ess; }
    ess_rm() { remove ess[1]; }
    ess_del() { delete ess[1]; }
    ess_rm_list() { remove ess[1, 2]; }
    ess_rm_range() { remove ess[1..2]; }
    ess_del_list() { delete ess[1, 2]; }
    ess_del_range() { delete ess[1..2]; }
    esl_rs() { esl =~ s/a/X/; }
    esl_rsg() { esl =~ s/ /_/g; }
    esl_tl() { esl =~ tr/a-z/A-Z/; }
    esl_pe() { esl += "x"; }
    esl_pe_int() { esl += 1; }
    esl_sp() { splice esl, 0, 1; }
    esl_sp_len() { splice esl, 1, 2; }
    esl_sp_rep() { splice esl, 0, 1, "zz"; }
    esl_ex() { extract esl, 0, 1; }
    esl_ex_rep() { extract esl, 1, 2, "zz"; }
    esl_tr() { trim esl; }
    esl_ch() { chomp esl; }
    esl_rm() { remove esl[1]; }
    esl_del() { delete esl[1]; }
    esl_rm_list() { remove esl[1, 2]; }
    esl_rm_range() { remove esl[1..2]; }
    esl_del_list() { delete esl[1, 2]; }
    esl_del_range() { delete esl[1..2]; }
}

hashdecl HolderHash {
    ESS ess = ESS::A;
    ESL esl = ESL::B;
}

#! a string member followed by an enum member
hashdecl MixedHash {
    string s = " s ";
    ESL e = ESL::B;
}

our ESS g_ess;
our ESL g_esl;
our ESL g_eslnv;

#! returns the type and value of a value, with its line breaks escaped
string sub q(auto v) {
    return replace(sprintf("%s %y", v.fullType(), v), "\n", "\\n");
}

#! returns the type and value of a container and the types of its elements
string sub qc(auto c) {
    list<string> types = c.typeCode() == NT_HASH
        ? (map c{$1}.fullType(), keys c)
        : (map $1.fullType(), c);
    return sprintf("%s [%s]", q(c), types.join(", "));
}

#! returns the result of a check of a container that raised no error
string sub okc(auto c) {
    return "none|" + qc(c);
}

#! returns the result of a check of a container that raised an error
string sub errc(hash<ExceptionInfo> ex, auto c) {
    return sprintf("%s|%s|%s", ex.err, ex.desc, qc(c));
}

#! returns the result of a check that raised no error: the type and value of the lvalue afterwards
string sub ok(auto v) {
    return "none|" + q(v);
}

#! returns the result of a check that raised an error: the error and the type and value of the lvalue afterwards
string sub err(hash<ExceptionInfo> ex, auto v) {
    return sprintf("%s|%s|%s", ex.err, ex.desc, q(v));
}

#! returns the result of a check that raised an error in a function that it called
string sub err_out(hash<ExceptionInfo> ex) {
    return sprintf("%s|%s", ex.err, ex.desc);
}

#! prints the results of a group of checks
sub print_results(string group, hash<string, string> results) {
    foreach hash<auto> i in (results.pairIterator()) {
        printf("%s-%s=%s\n", group, i.key, i.value);
    }
}

#! each operation on a ESS lvalue (local) in a try block
hash<string, string> sub ess_local_in() {
    hash<string, string> rv;
    {
        ESS v = ESS::A;
        try { v =~ s/a/X/; rv.rs = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv.rs = err(ex, v); }
    }
    {
        ESS v = ESS::A;
        try { v =~ s/ /_/g; rv.rsg = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv.rsg = err(ex, v); }
    }
    {
        ESS v = ESS::A;
        try { v =~ tr/a-z/A-Z/; rv.tl = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv.tl = err(ex, v); }
    }
    {
        ESS v = ESS::A;
        try { v += "x"; rv.pe = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv.pe = err(ex, v); }
    }
    {
        ESS v = ESS::A;
        try { v += 1; rv."pe-int" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."pe-int" = err(ex, v); }
    }
    {
        ESS v = ESS::A;
        try { splice v, 0, 1; rv.sp = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv.sp = err(ex, v); }
    }
    {
        ESS v = ESS::A;
        try { splice v, 1, 2; rv."sp-len" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."sp-len" = err(ex, v); }
    }
    {
        ESS v = ESS::A;
        try { splice v, 0, 1, "zz"; rv."sp-rep" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."sp-rep" = err(ex, v); }
    }
    {
        ESS v = ESS::A;
        try { extract v, 0, 1; rv.ex = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv.ex = err(ex, v); }
    }
    {
        ESS v = ESS::A;
        try { extract v, 1, 2, "zz"; rv."ex-rep" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."ex-rep" = err(ex, v); }
    }
    {
        ESS v = ESS::A;
        try { trim v; rv.tr = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv.tr = err(ex, v); }
    }
    {
        ESS v = ESS::A;
        try { chomp v; rv.ch = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv.ch = err(ex, v); }
    }
    {
        ESS v = ESS::A;
        try { remove v[1]; rv.rm = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv.rm = err(ex, v); }
    }
    {
        ESS v = ESS::A;
        try { delete v[1]; rv.del = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv.del = err(ex, v); }
    }
    {
        ESS v = ESS::A;
        try { remove v[1, 2]; rv."rm-list" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."rm-list" = err(ex, v); }
    }
    {
        ESS v = ESS::A;
        try { remove v[1..2]; rv."rm-range" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."rm-range" = err(ex, v); }
    }
    {
        ESS v = ESS::A;
        try { delete v[1, 2]; rv."del-list" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."del-list" = err(ex, v); }
    }
    {
        ESS v = ESS::A;
        try { delete v[1..2]; rv."del-range" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."del-range" = err(ex, v); }
    }
    {
        ESS v = ESS::A;
        auto r;
        try { r = (v =~ s/a/X/); rv."rs-rv" = ok(v) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."rs-rv" = err(ex, v) + "|" + q(r); }
    }
    {
        ESS v = ESS::A;
        auto r;
        try { r = (v =~ tr/a-z/A-Z/); rv."tl-rv" = ok(v) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."tl-rv" = err(ex, v) + "|" + q(r); }
    }
    {
        ESS v = ESS::A;
        auto r;
        try { r = (v += "x"); rv."pe-rv" = ok(v) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."pe-rv" = err(ex, v) + "|" + q(r); }
    }
    {
        ESS v = ESS::A;
        auto r;
        try { r = (extract v, 0, 2); rv."ex-rv" = ok(v) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."ex-rv" = err(ex, v) + "|" + q(r); }
    }
    {
        ESS v = ESS::A;
        auto r;
        try { r = (trim v); rv."tr-rv" = ok(v) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."tr-rv" = err(ex, v) + "|" + q(r); }
    }
    {
        ESS v = ESS::A;
        auto r;
        try { r = (chomp v); rv."ch-rv" = ok(v) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."ch-rv" = err(ex, v) + "|" + q(r); }
    }
    {
        ESS v = ESS::A;
        auto r;
        try { r = (remove v[1]); rv."rm-rv" = ok(v) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."rm-rv" = err(ex, v) + "|" + q(r); }
    }
    {
        ESS v = ESS::A;
        auto r;
        try { r = (remove v[1..2]); rv."rm-range-rv" = ok(v) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."rm-range-rv" = err(ex, v) + "|" + q(r); }
    }
    return rv;
}

