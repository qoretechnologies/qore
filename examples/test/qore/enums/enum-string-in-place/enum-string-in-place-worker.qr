        try { r = (chomp h{key}); rv."ch-rv" = ok(h{key}) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."ch-rv" = err(ex, h{key}) + "|" + q(r); }
    }
    {
        hash<string, ESS> h = {"k": ESS::A};
