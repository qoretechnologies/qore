#! trim and chomp of a container (hash)
hash<string, string> sub cont_hash() {
    hash<string, string> rv;
    {
        hash<string, ESL> c = {"a": ESL::B, "b": ESL::B};
        try { trim c; rv.tr = okc(c); }
        catch (hash<ExceptionInfo> ex) { rv.tr = errc(ex, c); }
    }
    {
        hash<string, ESL> c = {"a": ESL::B, "b": ESL::B};
        try { chomp c; rv.ch = okc(c); }
        catch (hash<ExceptionInfo> ex) { rv.ch = errc(ex, c); }
    }
    {
        hash<string, ESL> c = {"a": ESL::B, "b": ESL::B};
        auto r;
        try { r = (trim c); rv."tr-rv" = okc(c) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."tr-rv" = errc(ex, c) + "|" + q(r); }
    }
    {
        hash<string, ESL> c = {"a": ESL::B, "b": ESL::B};
        auto r;
        try { r = (chomp c); rv."ch-rv" = okc(c) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."ch-rv" = errc(ex, c) + "|" + q(r); }
    }
    return rv;
}

#! trim and chomp of a container (hash-short)
hash<string, string> sub cont_hash_short() {
    hash<string, string> rv;
    {
        hash<string, ESS> c = {"a": ESS::A};
        try { trim c; rv.tr = okc(c); }
        catch (hash<ExceptionInfo> ex) { rv.tr = errc(ex, c); }
    }
    {
        hash<string, ESS> c = {"a": ESS::A};
        try { chomp c; rv.ch = okc(c); }
        catch (hash<ExceptionInfo> ex) { rv.ch = errc(ex, c); }
    }
    {
        hash<string, ESS> c = {"a": ESS::A};
        auto r;
        try { r = (trim c); rv."tr-rv" = okc(c) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."tr-rv" = errc(ex, c) + "|" + q(r); }
    }
    {
        hash<string, ESS> c = {"a": ESS::A};
        auto r;
        try { r = (chomp c); rv."ch-rv" = okc(c) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."ch-rv" = errc(ex, c) + "|" + q(r); }
    }
    return rv;
}

