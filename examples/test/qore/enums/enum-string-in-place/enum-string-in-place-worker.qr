        auto r;
        try { r = (remove h{key}[1]); rv."rm-rv" = ok(h{key}) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."rm-rv" = err(ex, h{key}) + "|" + q(r); }
