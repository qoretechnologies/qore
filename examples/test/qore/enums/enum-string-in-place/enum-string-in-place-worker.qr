        catch (hash<ExceptionInfo> ex) { rv."rm-range-rv" = err(ex, l[0]) + "|" + q(r); }
    }
    return rv;
}

#! each operation on a ESL lvalue (ref) in a try block
hash<string, string> sub esl_ref_in() {
    hash<string, string> rv;
    {
        ESL v = ESL::B;
        reference<ESL> rf = \v;
        try { rf =~ s/a/X/; rv.rs = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv.rs = err(ex, v); }
    }
    {
        ESL v = ESL::B;
        reference<ESL> rf = \v;
        try { rf =~ s/ /_/g; rv.rsg = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv.rsg = err(ex, v); }
    }
    {
        ESL v = ESL::B;
        reference<ESL> rf = \v;
        try { rf =~ tr/a-z/A-Z/; rv.tl = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv.tl = err(ex, v); }
    }
    {
        ESL v = ESL::B;
        reference<ESL> rf = \v;
        try { rf += "x"; rv.pe = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv.pe = err(ex, v); }
    }
    {
        ESL v = ESL::B;
        reference<ESL> rf = \v;
        try { rf += 1; rv."pe-int" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."pe-int" = err(ex, v); }
    }
    {
        ESL v = ESL::B;
        reference<ESL> rf = \v;
        try { splice rf, 0, 1; rv.sp = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv.sp = err(ex, v); }
    }
    {
        ESL v = ESL::B;
        reference<ESL> rf = \v;
        try { splice rf, 1, 2; rv."sp-len" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."sp-len" = err(ex, v); }
    }
    {
        ESL v = ESL::B;
        reference<ESL> rf = \v;
        try { splice rf, 0, 1, "zz"; rv."sp-rep" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."sp-rep" = err(ex, v); }
    }
    {
        ESL v = ESL::B;
        reference<ESL> rf = \v;
        try { extract rf, 0, 1; rv.ex = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv.ex = err(ex, v); }
    }
    {
        ESL v = ESL::B;
        reference<ESL> rf = \v;
        try { extract rf, 1, 2, "zz"; rv."ex-rep" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."ex-rep" = err(ex, v); }
    }
    {
        ESL v = ESL::B;
        reference<ESL> rf = \v;
        try { trim rf; rv.tr = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv.tr = err(ex, v); }
    }
    {
        ESL v = ESL::B;
        reference<ESL> rf = \v;
        try { chomp rf; rv.ch = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv.ch = err(ex, v); }
    }
    {
        ESL v = ESL::B;
        reference<ESL> rf = \v;
        try { remove rf[1]; rv.rm = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv.rm = err(ex, v); }
    }
    {
        ESL v = ESL::B;
        reference<ESL> rf = \v;
        try { delete rf[1]; rv.del = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv.del = err(ex, v); }
    }
    {
        ESL v = ESL::B;
        reference<ESL> rf = \v;
        try { remove rf[1, 2]; rv."rm-list" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."rm-list" = err(ex, v); }
    }
    {
        ESL v = ESL::B;
        reference<ESL> rf = \v;
        try { remove rf[1..2]; rv."rm-range" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."rm-range" = err(ex, v); }
    }
    {
        ESL v = ESL::B;
        reference<ESL> rf = \v;
        try { delete rf[1, 2]; rv."del-list" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."del-list" = err(ex, v); }
    }
    {
        ESL v = ESL::B;
        reference<ESL> rf = \v;
        try { delete rf[1..2]; rv."del-range" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."del-range" = err(ex, v); }
    }
    {
        ESL v = ESL::B;
        reference<ESL> rf = \v;
        auto r;
        try { r = (rf =~ s/a/X/); rv."rs-rv" = ok(v) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."rs-rv" = err(ex, v) + "|" + q(r); }
    }
    {
        ESL v = ESL::B;
        reference<ESL> rf = \v;
        auto r;
        try { r = (rf =~ tr/a-z/A-Z/); rv."tl-rv" = ok(v) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."tl-rv" = err(ex, v) + "|" + q(r); }
    }
    {
        ESL v = ESL::B;
        reference<ESL> rf = \v;
        auto r;
        try { r = (rf += "x"); rv."pe-rv" = ok(v) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."pe-rv" = err(ex, v) + "|" + q(r); }
    }
    {
        ESL v = ESL::B;
        reference<ESL> rf = \v;
        auto r;
        try { r = (extract rf, 0, 2); rv."ex-rv" = ok(v) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."ex-rv" = err(ex, v) + "|" + q(r); }
    }
    {
        ESL v = ESL::B;
        reference<ESL> rf = \v;
        auto r;
        try { r = (trim rf); rv."tr-rv" = ok(v) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."tr-rv" = err(ex, v) + "|" + q(r); }
    }
    {
        ESL v = ESL::B;
        reference<ESL> rf = \v;
        auto r;
        try { r = (chomp rf); rv."ch-rv" = ok(v) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."ch-rv" = err(ex, v) + "|" + q(r); }
    }
    {
        ESL v = ESL::B;
        reference<ESL> rf = \v;
        auto r;
        try { r = (remove rf[1]); rv."rm-rv" = ok(v) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."rm-rv" = err(ex, v) + "|" + q(r); }
    }
    {
        ESL v = ESL::B;
        reference<ESL> rf = \v;
        auto r;
        try { r = (remove rf[1..2]); rv."rm-range-rv" = ok(v) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."rm-range-rv" = err(ex, v) + "|" + q(r); }
    }
    return rv;
}

#! each operation on a ESL member in a method of its object
hash<string, string> sub esl_self_in() {
    hash<string, string> rv;
    {
        Holder o();
        try { o.esl_rs(); rv.rs = ok(o.esl); }
        catch (hash<ExceptionInfo> ex) { rv.rs = err(ex, o.esl); }
    }
    {
        Holder o();
        try { o.esl_rsg(); rv.rsg = ok(o.esl); }
        catch (hash<ExceptionInfo> ex) { rv.rsg = err(ex, o.esl); }
    }
    {
        Holder o();
        try { o.esl_tl(); rv.tl = ok(o.esl); }
        catch (hash<ExceptionInfo> ex) { rv.tl = err(ex, o.esl); }
    }
    {
        Holder o();
        try { o.esl_pe(); rv.pe = ok(o.esl); }
        catch (hash<ExceptionInfo> ex) { rv.pe = err(ex, o.esl); }
    }
    {
        Holder o();
        try { o.esl_pe_int(); rv."pe-int" = ok(o.esl); }
        catch (hash<ExceptionInfo> ex) { rv."pe-int" = err(ex, o.esl); }
    }
    {
        Holder o();
        try { o.esl_sp(); rv.sp = ok(o.esl); }
        catch (hash<ExceptionInfo> ex) { rv.sp = err(ex, o.esl); }
    }
    {
        Holder o();
        try { o.esl_sp_len(); rv."sp-len" = ok(o.esl); }
        catch (hash<ExceptionInfo> ex) { rv."sp-len" = err(ex, o.esl); }
    }
    {
        Holder o();
        try { o.esl_sp_rep(); rv."sp-rep" = ok(o.esl); }
        catch (hash<ExceptionInfo> ex) { rv."sp-rep" = err(ex, o.esl); }
    }
    {
        Holder o();
        try { o.esl_ex(); rv.ex = ok(o.esl); }
        catch (hash<ExceptionInfo> ex) { rv.ex = err(ex, o.esl); }
    }
    {
        Holder o();
        try { o.esl_ex_rep(); rv."ex-rep" = ok(o.esl); }
        catch (hash<ExceptionInfo> ex) { rv."ex-rep" = err(ex, o.esl); }
    }
    {
        Holder o();
        try { o.esl_tr(); rv.tr = ok(o.esl); }
        catch (hash<ExceptionInfo> ex) { rv.tr = err(ex, o.esl); }
    }
    {
        Holder o();
        try { o.esl_ch(); rv.ch = ok(o.esl); }
        catch (hash<ExceptionInfo> ex) { rv.ch = err(ex, o.esl); }
    }
    {
        Holder o();
        try { o.esl_rm(); rv.rm = ok(o.esl); }
        catch (hash<ExceptionInfo> ex) { rv.rm = err(ex, o.esl); }
    }
    {
        Holder o();
        try { o.esl_del(); rv.del = ok(o.esl); }
        catch (hash<ExceptionInfo> ex) { rv.del = err(ex, o.esl); }
    }
    {
        Holder o();
        try { o.esl_rm_list(); rv."rm-list" = ok(o.esl); }
        catch (hash<ExceptionInfo> ex) { rv."rm-list" = err(ex, o.esl); }
    }
    {
        Holder o();
        try { o.esl_rm_range(); rv."rm-range" = ok(o.esl); }
        catch (hash<ExceptionInfo> ex) { rv."rm-range" = err(ex, o.esl); }
    }
    {
        Holder o();
        try { o.esl_del_list(); rv."del-list" = ok(o.esl); }
        catch (hash<ExceptionInfo> ex) { rv."del-list" = err(ex, o.esl); }
    }
    {
        Holder o();
        try { o.esl_del_range(); rv."del-range" = ok(o.esl); }
        catch (hash<ExceptionInfo> ex) { rv."del-range" = err(ex, o.esl); }
    }
    return rv;
}

#! applies an operation to a ESL local with no try block
sub esl_local_raise(string op) {
    ESL v = ESL::B;
    switch (op) {
        case "rs": v =~ s/a/X/; break;
        case "rsg": v =~ s/ /_/g; break;
        case "tl": v =~ tr/a-z/A-Z/; break;
        case "pe": v += "x"; break;
        case "pe-int": v += 1; break;
        case "sp": splice v, 0, 1; break;
        case "sp-len": splice v, 1, 2; break;
        case "sp-rep": splice v, 0, 1, "zz"; break;
        case "ex": extract v, 0, 1; break;
        case "ex-rep": extract v, 1, 2, "zz"; break;
        case "tr": trim v; break;
        case "ch": chomp v; break;
        case "rm": remove v[1]; break;
        case "del": delete v[1]; break;
        case "rm-list": remove v[1, 2]; break;
        case "rm-range": remove v[1..2]; break;
        case "del-list": delete v[1, 2]; break;
        case "del-range": delete v[1..2]; break;
    }
}

#! each operation on a ESL local raised in a function that it calls
hash<string, string> sub esl_local_out() {
    hash<string, string> rv;
    try { esl_local_raise("rs"); rv.rs = "none"; }
    catch (hash<ExceptionInfo> ex) { rv.rs = err_out(ex); }
    try { esl_local_raise("rsg"); rv.rsg = "none"; }
    catch (hash<ExceptionInfo> ex) { rv.rsg = err_out(ex); }
    try { esl_local_raise("tl"); rv.tl = "none"; }
    catch (hash<ExceptionInfo> ex) { rv.tl = err_out(ex); }
    try { esl_local_raise("pe"); rv.pe = "none"; }
    catch (hash<ExceptionInfo> ex) { rv.pe = err_out(ex); }
    try { esl_local_raise("pe-int"); rv."pe-int" = "none"; }
    catch (hash<ExceptionInfo> ex) { rv."pe-int" = err_out(ex); }
    try { esl_local_raise("sp"); rv.sp = "none"; }
    catch (hash<ExceptionInfo> ex) { rv.sp = err_out(ex); }
    try { esl_local_raise("sp-len"); rv."sp-len" = "none"; }
    catch (hash<ExceptionInfo> ex) { rv."sp-len" = err_out(ex); }
    try { esl_local_raise("sp-rep"); rv."sp-rep" = "none"; }
    catch (hash<ExceptionInfo> ex) { rv."sp-rep" = err_out(ex); }
    try { esl_local_raise("ex"); rv.ex = "none"; }
    catch (hash<ExceptionInfo> ex) { rv.ex = err_out(ex); }
    try { esl_local_raise("ex-rep"); rv."ex-rep" = "none"; }
    catch (hash<ExceptionInfo> ex) { rv."ex-rep" = err_out(ex); }
    try { esl_local_raise("tr"); rv.tr = "none"; }
    catch (hash<ExceptionInfo> ex) { rv.tr = err_out(ex); }
    try { esl_local_raise("ch"); rv.ch = "none"; }
    catch (hash<ExceptionInfo> ex) { rv.ch = err_out(ex); }
    try { esl_local_raise("rm"); rv.rm = "none"; }
    catch (hash<ExceptionInfo> ex) { rv.rm = err_out(ex); }
    try { esl_local_raise("del"); rv.del = "none"; }
    catch (hash<ExceptionInfo> ex) { rv.del = err_out(ex); }
    try { esl_local_raise("rm-list"); rv."rm-list" = "none"; }
    catch (hash<ExceptionInfo> ex) { rv."rm-list" = err_out(ex); }
    try { esl_local_raise("rm-range"); rv."rm-range" = "none"; }
    catch (hash<ExceptionInfo> ex) { rv."rm-range" = err_out(ex); }
    try { esl_local_raise("del-list"); rv."del-list" = "none"; }
    catch (hash<ExceptionInfo> ex) { rv."del-list" = err_out(ex); }
    try { esl_local_raise("del-range"); rv."del-range" = "none"; }
    catch (hash<ExceptionInfo> ex) { rv."del-range" = err_out(ex); }
    return rv;
}

#! each operation on a ESL local in a try block in a loop
hash<string, string> sub esl_local_loop() {
    hash<string, string> rv;
    {
        ESL v = ESL::B;
        int caught = 0;
        for (int i = 0; i < 50; ++i) {
            try { v =~ s/a/X/; } catch (hash<ExceptionInfo> ex) { ++caught; }
        }
        rv.rs = sprintf("%s (caught %d)", ok(v), caught);
    }
    {
        ESL v = ESL::B;
        int caught = 0;
        for (int i = 0; i < 50; ++i) {
            try { v =~ s/ /_/g; } catch (hash<ExceptionInfo> ex) { ++caught; }
        }
        rv.rsg = sprintf("%s (caught %d)", ok(v), caught);
    }
    {
        ESL v = ESL::B;
        int caught = 0;
        for (int i = 0; i < 50; ++i) {
            try { v =~ tr/a-z/A-Z/; } catch (hash<ExceptionInfo> ex) { ++caught; }
        }
        rv.tl = sprintf("%s (caught %d)", ok(v), caught);
    }
    {
        ESL v = ESL::B;
        int caught = 0;
        for (int i = 0; i < 50; ++i) {
            try { v += "x"; } catch (hash<ExceptionInfo> ex) { ++caught; }
        }
        rv.pe = sprintf("%s (caught %d)", ok(v), caught);
    }
    {
        ESL v = ESL::B;
        int caught = 0;
        for (int i = 0; i < 50; ++i) {
            try { v += 1; } catch (hash<ExceptionInfo> ex) { ++caught; }
        }
        rv."pe-int" = sprintf("%s (caught %d)", ok(v), caught);
    }
    {
        ESL v = ESL::B;
        int caught = 0;
        for (int i = 0; i < 50; ++i) {
            try { splice v, 0, 1; } catch (hash<ExceptionInfo> ex) { ++caught; }
        }
        rv.sp = sprintf("%s (caught %d)", ok(v), caught);
    }
    {
        ESL v = ESL::B;
        int caught = 0;
        for (int i = 0; i < 50; ++i) {
            try { splice v, 1, 2; } catch (hash<ExceptionInfo> ex) { ++caught; }
        }
        rv."sp-len" = sprintf("%s (caught %d)", ok(v), caught);
    }
    {
        ESL v = ESL::B;
        int caught = 0;
        for (int i = 0; i < 50; ++i) {
            try { splice v, 0, 1, "zz"; } catch (hash<ExceptionInfo> ex) { ++caught; }
        }
        rv."sp-rep" = sprintf("%s (caught %d)", ok(v), caught);
    }
    {
        ESL v = ESL::B;
        int caught = 0;
        for (int i = 0; i < 50; ++i) {
            try { extract v, 0, 1; } catch (hash<ExceptionInfo> ex) { ++caught; }
        }
        rv.ex = sprintf("%s (caught %d)", ok(v), caught);
    }
    {
        ESL v = ESL::B;
        int caught = 0;
        for (int i = 0; i < 50; ++i) {
            try { extract v, 1, 2, "zz"; } catch (hash<ExceptionInfo> ex) { ++caught; }
        }
        rv."ex-rep" = sprintf("%s (caught %d)", ok(v), caught);
    }
    {
        ESL v = ESL::B;
        int caught = 0;
        for (int i = 0; i < 50; ++i) {
            try { trim v; } catch (hash<ExceptionInfo> ex) { ++caught; }
        }
        rv.tr = sprintf("%s (caught %d)", ok(v), caught);
    }
    {
        ESL v = ESL::B;
        int caught = 0;
        for (int i = 0; i < 50; ++i) {
            try { chomp v; } catch (hash<ExceptionInfo> ex) { ++caught; }
        }
        rv.ch = sprintf("%s (caught %d)", ok(v), caught);
    }
    {
        ESL v = ESL::B;
        int caught = 0;
        for (int i = 0; i < 50; ++i) {
            try { remove v[1]; } catch (hash<ExceptionInfo> ex) { ++caught; }
        }
        rv.rm = sprintf("%s (caught %d)", ok(v), caught);
    }
    {
        ESL v = ESL::B;
        int caught = 0;
        for (int i = 0; i < 50; ++i) {
            try { delete v[1]; } catch (hash<ExceptionInfo> ex) { ++caught; }
        }
        rv.del = sprintf("%s (caught %d)", ok(v), caught);
    }
    {
        ESL v = ESL::B;
        int caught = 0;
        for (int i = 0; i < 50; ++i) {
            try { remove v[1, 2]; } catch (hash<ExceptionInfo> ex) { ++caught; }
        }
        rv."rm-list" = sprintf("%s (caught %d)", ok(v), caught);
    }
    {
        ESL v = ESL::B;
        int caught = 0;
        for (int i = 0; i < 50; ++i) {
            try { remove v[1..2]; } catch (hash<ExceptionInfo> ex) { ++caught; }
        }
        rv."rm-range" = sprintf("%s (caught %d)", ok(v), caught);
    }
    {
        ESL v = ESL::B;
        int caught = 0;
        for (int i = 0; i < 50; ++i) {
            try { delete v[1, 2]; } catch (hash<ExceptionInfo> ex) { ++caught; }
        }
        rv."del-list" = sprintf("%s (caught %d)", ok(v), caught);
    }
    {
        ESL v = ESL::B;
        int caught = 0;
        for (int i = 0; i < 50; ++i) {
            try { delete v[1..2]; } catch (hash<ExceptionInfo> ex) { ++caught; }
        }
        rv."del-range" = sprintf("%s (caught %d)", ok(v), caught);
    }
    return rv;
}

string sub esl_param_rs(ESL v) {
    try { v =~ s/a/X/; return ok(v); } catch (hash<ExceptionInfo> ex) { return err(ex, v); }
}
sub esl_refparam_rs(reference<ESL> r) {
    r =~ s/a/X/;
}
string sub esl_param_rsg(ESL v) {
    try { v =~ s/ /_/g; return ok(v); } catch (hash<ExceptionInfo> ex) { return err(ex, v); }
}
sub esl_refparam_rsg(reference<ESL> r) {
    r =~ s/ /_/g;
}
string sub esl_param_tl(ESL v) {
    try { v =~ tr/a-z/A-Z/; return ok(v); } catch (hash<ExceptionInfo> ex) { return err(ex, v); }
}
sub esl_refparam_tl(reference<ESL> r) {
    r =~ tr/a-z/A-Z/;
}
string sub esl_param_pe(ESL v) {
    try { v += "x"; return ok(v); } catch (hash<ExceptionInfo> ex) { return err(ex, v); }
}
sub esl_refparam_pe(reference<ESL> r) {
    r += "x";
}
string sub esl_param_pe_int(ESL v) {
    try { v += 1; return ok(v); } catch (hash<ExceptionInfo> ex) { return err(ex, v); }
}
sub esl_refparam_pe_int(reference<ESL> r) {
    r += 1;
}
string sub esl_param_sp(ESL v) {
    try { splice v, 0, 1; return ok(v); } catch (hash<ExceptionInfo> ex) { return err(ex, v); }
}
sub esl_refparam_sp(reference<ESL> r) {
    splice r, 0, 1;
}
string sub esl_param_sp_len(ESL v) {
    try { splice v, 1, 2; return ok(v); } catch (hash<ExceptionInfo> ex) { return err(ex, v); }
}
sub esl_refparam_sp_len(reference<ESL> r) {
    splice r, 1, 2;
}
string sub esl_param_sp_rep(ESL v) {
    try { splice v, 0, 1, "zz"; return ok(v); } catch (hash<ExceptionInfo> ex) { return err(ex, v); }
}
sub esl_refparam_sp_rep(reference<ESL> r) {
    splice r, 0, 1, "zz";
}
string sub esl_param_ex(ESL v) {
    try { extract v, 0, 1; return ok(v); } catch (hash<ExceptionInfo> ex) { return err(ex, v); }
}
sub esl_refparam_ex(reference<ESL> r) {
    extract r, 0, 1;
}
string sub esl_param_ex_rep(ESL v) {
    try { extract v, 1, 2, "zz"; return ok(v); } catch (hash<ExceptionInfo> ex) { return err(ex, v); }
}
sub esl_refparam_ex_rep(reference<ESL> r) {
    extract r, 1, 2, "zz";
}
string sub esl_param_tr(ESL v) {
    try { trim v; return ok(v); } catch (hash<ExceptionInfo> ex) { return err(ex, v); }
}
sub esl_refparam_tr(reference<ESL> r) {
    trim r;
}
string sub esl_param_ch(ESL v) {
    try { chomp v; return ok(v); } catch (hash<ExceptionInfo> ex) { return err(ex, v); }
}
sub esl_refparam_ch(reference<ESL> r) {
    chomp r;
}
string sub esl_param_rm(ESL v) {
    try { remove v[1]; return ok(v); } catch (hash<ExceptionInfo> ex) { return err(ex, v); }
}
sub esl_refparam_rm(reference<ESL> r) {
    remove r[1];
}
string sub esl_param_del(ESL v) {
    try { delete v[1]; return ok(v); } catch (hash<ExceptionInfo> ex) { return err(ex, v); }
}
sub esl_refparam_del(reference<ESL> r) {
    delete r[1];
}
string sub esl_param_rm_list(ESL v) {
    try { remove v[1, 2]; return ok(v); } catch (hash<ExceptionInfo> ex) { return err(ex, v); }
}
sub esl_refparam_rm_list(reference<ESL> r) {
    remove r[1, 2];
}
string sub esl_param_rm_range(ESL v) {
    try { remove v[1..2]; return ok(v); } catch (hash<ExceptionInfo> ex) { return err(ex, v); }
}
sub esl_refparam_rm_range(reference<ESL> r) {
    remove r[1..2];
}
string sub esl_param_del_list(ESL v) {
    try { delete v[1, 2]; return ok(v); } catch (hash<ExceptionInfo> ex) { return err(ex, v); }
}
sub esl_refparam_del_list(reference<ESL> r) {
    delete r[1, 2];
}
string sub esl_param_del_range(ESL v) {
    try { delete v[1..2]; return ok(v); } catch (hash<ExceptionInfo> ex) { return err(ex, v); }
}
sub esl_refparam_del_range(reference<ESL> r) {
    delete r[1..2];
}

#! each operation on a ESL parameter and through a reference parameter
hash<string, string> sub esl_params() {
    hash<string, string> rv;
    rv."param-rs" = esl_param_rs(ESL::B);
    {
        ESL v = ESL::B;
        try { esl_refparam_rs(\v); rv."refparam-rs" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."refparam-rs" = err(ex, v); }
    }
    rv."param-rsg" = esl_param_rsg(ESL::B);
    {
