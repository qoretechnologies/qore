        try { r = (remove g_ess[1..2]); rv."rm-range-rv" = ok(g_ess) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."rm-range-rv" = err(ex, g_ess) + "|" + q(r); }
    }
    return rv;
}

