        auto r;
        try { r = (chomp v); rv."ch-rv" = ok(get()) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."ch-rv" = err(ex, get()) + "|" + q(r); }
    }
    {
        ESS v = ESS::A;
        code get = auto sub () { return v; };
        auto r;
        try { r = (remove v[1]); rv."rm-rv" = ok(get()) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."rm-rv" = err(ex, get()) + "|" + q(r); }
    }
