        g_ess = ESS::A;
        auto r;
        try { r = (remove g_ess[1]); rv."rm-rv" = ok(g_ess) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."rm-rv" = err(ex, g_ess) + "|" + q(r); }
    }
    {
