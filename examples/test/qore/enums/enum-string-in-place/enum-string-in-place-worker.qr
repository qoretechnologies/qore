    }
    {
        ESS v = ESS::A;
        reference<ESS> rf = \v;
        try { remove rf[1]; rv.rm = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv.rm = err(ex, v); }
    }
    {
        ESS v = ESS::A;
        reference<ESS> rf = \v;
        try { delete rf[1]; rv.del = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv.del = err(ex, v); }
    }
    {
        ESS v = ESS::A;
        reference<ESS> rf = \v;
        try { remove rf[1, 2]; rv."rm-list" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."rm-list" = err(ex, v); }
    }
    {
        ESS v = ESS::A;
        reference<ESS> rf = \v;
        try { remove rf[1..2]; rv."rm-range" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."rm-range" = err(ex, v); }
    }
    {
        ESS v = ESS::A;
        reference<ESS> rf = \v;
        try { delete rf[1, 2]; rv."del-list" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."del-list" = err(ex, v); }
    }
    {
        ESS v = ESS::A;
        reference<ESS> rf = \v;
        try { delete rf[1..2]; rv."del-range" = ok(v); }
        catch (hash<ExceptionInfo> ex) { rv."del-range" = err(ex, v); }
    }
    {
        ESS v = ESS::A;
        reference<ESS> rf = \v;
        auto r;
        try { r = (rf =~ s/a/X/); rv."rs-rv" = ok(v) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."rs-rv" = err(ex, v) + "|" + q(r); }
    }
    {
        ESS v = ESS::A;
