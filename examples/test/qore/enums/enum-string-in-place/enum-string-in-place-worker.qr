        catch (hash<ExceptionInfo> ex) { rv."ch-rv" = errc(ex, o.hesl) + "|" + q(r); }
    }
    return rv;
}

#! trim and chomp of a container (auto-hash)
hash<string, string> sub cont_auto_hash() {
    hash<string, string> rv;
    {
        hash<auto> c = {}; c.a = ESL::B; c.s = " s ";
        try { trim c; rv.tr = okc(c); }
        catch (hash<ExceptionInfo> ex) { rv.tr = errc(ex, c); }
    }
    {
        hash<auto> c = {}; c.a = ESL::B; c.s = " s ";
        try { chomp c; rv.ch = okc(c); }
        catch (hash<ExceptionInfo> ex) { rv.ch = errc(ex, c); }
    }
    {
        hash<auto> c = {}; c.a = ESL::B; c.s = " s ";
        auto r;
        try { r = (trim c); rv."tr-rv" = okc(c) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."tr-rv" = errc(ex, c) + "|" + q(r); }
    }
    {
