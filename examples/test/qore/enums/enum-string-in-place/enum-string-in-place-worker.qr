        catch (hash<ExceptionInfo> ex) { rv."tl-rv" = err(ex, h.esl) + "|" + q(r); }
    }
    {
        hash<HolderHash> h();
        auto r;
        try { r = (h.esl += "x"); rv."pe-rv" = ok(h.esl) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."pe-rv" = err(ex, h.esl) + "|" + q(r); }
    }
    {
        hash<HolderHash> h();
        auto r;
        try { r = (extract h.esl, 0, 2); rv."ex-rv" = ok(h.esl) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."ex-rv" = err(ex, h.esl) + "|" + q(r); }
    }
    {
        hash<HolderHash> h();
        auto r;
        try { r = (trim h.esl); rv."tr-rv" = ok(h.esl) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."tr-rv" = err(ex, h.esl) + "|" + q(r); }
    }
    {
        hash<HolderHash> h();
        auto r;
        try { r = (chomp h.esl); rv."ch-rv" = ok(h.esl) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."ch-rv" = err(ex, h.esl) + "|" + q(r); }
    }
    {
        hash<HolderHash> h();
        auto r;
        try { r = (remove h.esl[1]); rv."rm-rv" = ok(h.esl) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."rm-rv" = err(ex, h.esl) + "|" + q(r); }
    }
    {
        hash<HolderHash> h();
        auto r;
        try { r = (remove h.esl[1..2]); rv."rm-range-rv" = ok(h.esl) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."rm-range-rv" = err(ex, h.esl) + "|" + q(r); }
    }
    return rv;
}

