        catch (hash<ExceptionInfo> ex) { rv."rm-range-rv" = err(ex, get()) + "|" + q(r); }
    }
    return rv;
}

#! each operation on a ESS lvalue (global) in a try block
hash<string, string> sub ess_global_in() {
    hash<string, string> rv;
    {
        g_ess = ESS::A;
        try { g_ess =~ s/a/X/; rv.rs = ok(g_ess); }
        catch (hash<ExceptionInfo> ex) { rv.rs = err(ex, g_ess); }
