        auto r;
        try { r = (h{key} += "x"); rv."pe-rv" = ok(h{key}) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."pe-rv" = err(ex, h{key}) + "|" + q(r); }
    }
    {
        hash<string, ESS> h = {"k": ESS::A};
