    {
        remove g_eslnv;
        try { g_eslnv =~ s/a/X/; rv.rs = ok(g_eslnv); }
        catch (hash<ExceptionInfo> ex) { rv.rs = err(ex, g_eslnv); }
    }
    {
        remove g_eslnv;
        try { g_eslnv =~ s/ /_/g; rv.rsg = ok(g_eslnv); }
        catch (hash<ExceptionInfo> ex) { rv.rsg = err(ex, g_eslnv); }
    }
    {
        remove g_eslnv;
        try { g_eslnv =~ tr/a-z/A-Z/; rv.tl = ok(g_eslnv); }
        catch (hash<ExceptionInfo> ex) { rv.tl = err(ex, g_eslnv); }
    }
    {
        remove g_eslnv;
        auto r;
        try { r = (g_eslnv =~ s/a/X/); rv."rs-rv" = ok(g_eslnv) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."rs-rv" = err(ex, g_eslnv) + "|" + q(r); }
    }
    {
        remove g_eslnv;
        auto r;
        try { r = (g_eslnv =~ tr/a-z/A-Z/); rv."tl-rv" = ok(g_eslnv) + "|" + q(r); }
        catch (hash<ExceptionInfo> ex) { rv."tl-rv" = err(ex, g_eslnv) + "|" + q(r); }
    }
    return rv;
}

