#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit

%exec-class Test

class Test inherits QUnit::Test {
    constructor() : QUnit::Test("parser lvalue-type hint narrowing", "1.0") {
        addTestCase("map operator narrows to typed-hash lvalue",  \mapNarrowing());
        addTestCase("map operator + or-nothing lvalue",           \mapOrNothing());
        addTestCase("map operator + softening runtime coercion",  \mapSoftening());
        addTestCase("hash literal narrows to typed-hash lvalue",  \literalNarrowing());
        addTestCase("hash literal AST-mode softening",            \literalSoftening());
        addTestCase("concrete body type wins over hint",          \concreteBodyWins());
        addTestCase("hint ignored when lvalue is not hash<K,V>",  \hintIgnoredForAutoHash());
        addTestCase("hash.iterator() yields typed $1 in map body", \hashIteratorElementType());
        addTestCase("list.iterator() yields typed $1 + fold safety",  \listIteratorElementType());
        set_return_value(main());
    }

    # Primary regression: the Workflow.qc pattern that previously
    # required a cast<hash<K,V>>(...) workaround.
    mapNarrowing() {
        hash<string, int> h;
        list<hash<auto>> src = (
            {"name": "a", "id": 1},
            {"name": "b", "id": 2},
        );
        h = map {$1.name: $1.id}, src.iterator();
        assertEq(1, h.a);
        assertEq(2, h.b);
        assertEq("integer", h.a.type());
    }

    # Or-nothing form — the actual Workflow.qc case uses *hash<...>.
    mapOrNothing() {
        *hash<string, int> h;
        list<hash<auto>> src = ({"name": "x", "id": 7},);
        h = map {$1.name: $1.id}, src.iterator();
        assertEq(7, h.x);
    }

    # softint value-type coerces string ids to int at runtime.
    mapSoftening() {
        *hash<string, softint> h;
        list<hash<auto>> src = ({"name": "s", "id": "42"},);
        h = map {$1.name: $1.id}, src.iterator();
        assertEq(42, h.s);
        assertEq("integer", h.s.type());
    }

    # Parse-time narrowing for plain hash literals.
    literalNarrowing() {
        hash<string, int> h;
        any v = 99;
        h = {"k": v};
        assertEq(99, h.k);
    }

    # AST-mode softening through the hash-literal path: the narrowed
    # vtype must be used to construct the QoreHashNode so setKeyValue
    # triggers per-value acceptInputKey coercion (string "42" -> 42).
    # Without the evalImpl fix, this test would observe h.k == "42"
    # (string) under AST eval because the hash would be built with
    # autoTypeInfo and no softening would fire.
    literalSoftening() {
        hash<string, softint> h;
        any s = "42";
        h = {"k": s};
        assertEq(42, h.k);
        assertEq("integer", h.k.type());
    }

    # When the body's value expression has a concrete non-auto type,
    # that wins over the hint.  Verified indirectly: a concrete-string
    # body assigned into a hash<string, int> lvalue must parse-error.
    concreteBodyWins() {
        Program p();
        assertThrows("PARSE-TYPE-ERROR",
            sub () {
                p.parse("hash<string, int> sub f() { hash<string, int> h; "
                    "h = {\"a\": \"definitely a string\"}; return h; }", "t");
            });
    }

    # `hash<auto>` lvalue triggers no-op narrowing (hint is just auto).
    hintIgnoredForAutoHash() {
        hash<auto> h;
        list<hash<auto>> src = ({"name": "a", "value": 1},);
        h = map {$1.name: $1.value}, src.iterator();
        assertEq(1, h.a);
    }

    # `$1` typing through `hash<K,V>::iterator()` — the pseudo-method
    # declares `AbstractIterator` as static return type but at runtime
    # creates a HashIterator (Pseudo_QC_Hash.qpp:303-305).
    # getIteratorElementType now surfaces the value type anyway.
    hashIteratorElementType() {
        hash<string, int> src = {"a": 1, "b": 2, "c": 3};
        # Before: $1 was `auto`, so assigning to `list<int>` required a cast.
        # Now: $1 is `int`, direct assignment works.
        list<int> values = map $1, src.iterator();
        assertEq((1, 2, 3), values);
        # Arithmetic on narrowed $1 works in typed lvalue contexts
        list<int> doubled = map $1 * 2, src.iterator();
        assertEq((2, 4, 6), doubled);
    }

    # `$1` typing through `list<T>::iterator()` — same declared-vs-actual
    # gap as the hash case.  This branch needed a fix in
    # analyzeFoldPattern (QoreIRLowering.cpp) to avoid mis-triggering
    # list-specialized fold opcodes (FoldlDiffInt / FoldlSumInt / ...)
    # when the source is an iterator object instead of a list.
    listIteratorElementType() {
        list<int> nums = (2, 3, 4);
        # Map body sees $1 as int now (was auto).
        list<int> doubled = map $1 * 2, nums.iterator();
        assertEq((4, 6, 8), doubled);
        # foldr over an iterator still works (regression guard for
        # the analyzeFoldPattern list-type check).
        int sub1 = foldr $1 - $2, nums.iterator();
        assertEq(-1, sub1);
        int sub2 = foldl $1 - $2, nums.iterator();
        assertEq(-5, sub2);
    }
}
