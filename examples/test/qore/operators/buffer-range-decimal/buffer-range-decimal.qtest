#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes and in programs compiled with qcc

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../../ExecModeHarness.qm
%requires ../../../TestInterpreter.qm

%exec-class BufferRangeDecimalTest

#! Regression test for issue #6263: an empty range slice of a buffer<decimal128> lost its precision and scale
/** An empty range slice of a buffer was created with the default decimal precision and scale (38 and 0) instead of
    those of the buffer it was taken from.

    BufferRangeDecimal.q prints the element type, nullability, precision, scale and values of empty and non-empty
    range slices of decimal128 and other buffers, with constant, int, float and untyped indices; its output must be
    the one in BufferRangeDecimal.expected in every execution mode, on the IR tier and in programs compiled with
    qcc -O0 and -O3.
*/
class BufferRangeDecimalTest inherits QUnit::Test {
    private {
        string qore_bin = TestInterpreter::qore_interpreter();
        string fixture = get_script_dir() + "/BufferRangeDecimal.q";
        string expected = ReadOnlyFile::readTextFile(get_script_dir() + "/BufferRangeDecimal.expected");
    }

    constructor() : QUnit::Test("buffer range slice decimal parameters", "1.0", \ARGV) {
        foreach string mode in (ExecModeHarness::ExecModes) {
            string execution_mode = mode;
            addTestCase("execution mode " + mode, sub () {
                assertEq(expected, ExecModeHarness::run(command(execution_mode)));
            });
        }
        addTestCase("IR tier", sub () {
            assertEq(expected, ExecModeHarness::run_ir_tier(command("tiered")));
        });
        addTestCase("qcc -O0", sub () { checkQcc(0); });
        addTestCase("qcc -O3", sub () { checkQcc(3); });

        set_return_value(main());
    }

    private string command(string mode) {
        return sprintf("%s --enable-debug --exec-mode=%s %s", shellQuote(qore_bin), mode, shellQuote(fixture));
    }

    private checkQcc(int opt) {
        string qcc_bin = ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }
        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        string program = dir + "/buffer-range-decimal";
        string output = backquote(sprintf("%s -O%d -o %s %s 2>&1", shellQuote(qcc_bin), opt, shellQuote(program),
            shellQuote(fixture)));
        assertTrue(is_file(program), "the fixture compiled: " + output);
        assertEq(expected, backquote(shellQuote(program) + " 2>&1"));
    }

    private static string shellQuote(string value) {
        return "'" + replace(value, "'", "'\\''") + "'";
    }
}
