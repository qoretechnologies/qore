#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes
# test-platform: macos - JIT and AOT code generation of post-increments and post-decrements, run with threads

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class UnusedPostIncrementTest

#! Regression test for issue #6199: a post-increment or post-decrement whose value is unused is lowered as the pre form
/** UnusedPostIncrement.q changes lvalues of every kind (int, float, number and untyped locals, closure-bound locals,
    globals, references, hash keys, members, static members, list elements and foreach variables) with post-increments
    and post-decrements whose value is unused (expression statements, the update of a for loop, in a try block) and
    whose value is used (assigned, in an expression, returned), including the overflow of an int and the changes of a
    global and a closure-bound local by several threads.  Its output must be the one in UnusedPostIncrement.expected,
    which the AST interpreter prints, in every execution mode, on the IR tier and in programs compiled with qcc -O0 and
    -O3.
*/
class UnusedPostIncrementTest inherits QUnit::Test {
    private {
        string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        string fixture = get_script_dir() + "/UnusedPostIncrement.q";
        string expected = ReadOnlyFile::readTextFile(get_script_dir() + "/UnusedPostIncrement.expected");
    }

    constructor() : QUnit::Test("unused post-increment", "1.0", \ARGV) {
        foreach string mode in (ExecModeHarness::ExecModes) {
            string execution_mode = mode;
            addTestCase("execution mode " + mode, sub () {
                assertEq(expected, ExecModeHarness::run(command(execution_mode)));
            });
        }
        addTestCase("IR tier", sub () {
            assertEq(expected, ExecModeHarness::run_ir_tier(command("tiered")));
        });
        addTestCase("qcc -O0", sub () { checkQcc(0); });
        addTestCase("qcc -O3", sub () { checkQcc(3); });

        set_return_value(main());
    }

    private string command(string mode) {
        return sprintf("%s --enable-debug --exec-mode=%s %s", shellQuote(qore_bin), mode, shellQuote(fixture));
    }

    private checkQcc(int opt) {
        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        string program = dir + "/unused-post-increment";
        string output = backquote(sprintf("%s -O%d -o %s %s 2>&1", shellQuote(getQcc()), opt, shellQuote(program),
            shellQuote(fixture)));
        assertTrue(is_file(program), "the fixture compiled: " + output);
        assertEq(expected, backquote(shellQuote(program) + " 2>&1"));
    }

    private string getQcc() {
        string qcc_bin = ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        return is_file(qcc_bin) ? qcc_bin : "qcc";
    }

    private static string shellQuote(string value) {
        return "'" + replace(value, "'", "'\\''") + "'";
    }
}
