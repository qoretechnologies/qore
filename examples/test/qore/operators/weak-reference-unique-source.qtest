#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-exec-mode: children - its checks run in child processes that set their own execution modes
# test-platform: macos - JIT and AOT code generation and linking of weak assignments of containers

# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../ExecModeHarness.qm

%exec-class WeakReferenceUniqueSourceTest

#! a weak reference to a variable designates the variable's own container (qore#5756)
/** A weak assignment from a variable now makes the variable's container unique first (a copy if it is shared with a
    literal of the program or with another variable), so that the writes of the owner are seen through the weak
    reference in every mode.  The AST interpreter shared the literal of `hash<auto> h = {"a": 1}` with the program and
    copied it on the first write, leaving the weak reference with the literal, where the compiled modes, which build
    the hash, followed the owner; a container shared with another variable behaved as the AST in all modes.  The rule
    applies to a variable declared with a type that can be a hash or a list and cannot be an object (`hash<auto>`,
    `list<int>`, `hash<string, int>`); an untyped (`auto`) variable, whose value can be an object that the execution
    modes keep alive by the way they access the variable, is not changed.  Every mode must print the output of the
    AST.

    The program is in \c weak-reference-unique-source/.
*/
class WeakReferenceUniqueSourceTest inherits QUnit::Test {
    private {
        string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        string dir = get_script_dir() + "/weak-reference-unique-source";

        const Modes = ("ast", "ir", "jit", "tiered");
        const Programs = ("weak-reference-unique-source",);
    }

    constructor() : QUnit::Test("WeakReferenceUniqueSourceTest", "1.0", \ARGV) {
        addTestCase("the AST interpreter prints the expected output", \testAst());
        addTestCase("IR, JIT and tiered execution print the output of the AST", \testModes());
        addTestCase("qcc executables print the output of the AST", \testCompiled());
        set_return_value(main());
    }

    private string expected(string name) {
        return ReadOnlyFile::readTextFile(dir + "/" + name + ".expected");
    }

    private string run(string name, string mode) {
        hash<ExecModeHarness::ModeRunResult> r = ExecModeHarness::run_command(sprintf("%s -b --enable-debug "
            "--exec-mode=%s %s/%s.q", qore_bin, mode, dir, name));
        assertEq(0, r.rc, sprintf("%s %s: exit status (output: %y)", name, mode, r.out));
        return r.stdout;
    }

    testAst() {
        foreach string name in (Programs) {
            assertEq(expected(name), run(name, "ast"), name + " ast");
        }
    }

    testModes() {
        foreach string name in (Programs) {
            foreach string mode in (Modes) {
                assertEq(expected(name), run(name, mode), name + " " + mode);
            }
        }
    }

    testCompiled() {
        string qcc_bin = ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }
        TmpDir tmp("qore-weak-reference-unique-source-");
        foreach string name in (Programs) {
            foreach string opt in (("0", "3")) {
                string exe = sprintf("%s/%s-O%s", tmp.path, name, opt);
                int rc;
                string out = backquote(sprintf("%s -O%s -o %s %s/%s.q 2>&1", qcc_bin, opt, exe, dir, name), \rc);
                if (rc || !is_file(exe)) {
                    testSkip("qcc is not available or cannot compile " + name + ": " + out);
                }
                # -b must be the first argument of a compiled program
                string result = backquote(sprintf("%s -b 2>&1", exe), \rc);
                assertEq(0, rc, sprintf("%s -O%s: exit status (output: %y)", name, opt, result));
                assertEq(expected(name), result, sprintf("%s -O%s", name, opt));
            }
        }
    }
}
