#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes and in programs compiled with qcc
# test-platform: macos - JIT and AOT code generation of bool to float and int conversions

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class BoolNumericConversionTest

#! Regression test for issue #5716: bool values converted to float in native code
/** Native code (JIT, tiered and AOT execution) converted a bool (an LLVM i1) to float as a signed integer, so True
    became -1.0: float() of a bool or softbool, a softfloat assigned a bool, a sum of such values, float() of a
    comparison or of a negation.  A bool reaching a native int at a control-flow join was extended the same way.

    BoolNumericConversion.q prints every conversion of bool to int, float and number; its output must be the one in
    BoolNumericConversion.expected, which the AST interpreter prints, in every execution mode, on the IR tier and in
    programs compiled with qcc -O0 and -O3.
*/
class BoolNumericConversionTest inherits QUnit::Test {
    private {
        string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        string fixture = get_script_dir() + "/BoolNumericConversion.q";
        string expected = ReadOnlyFile::readTextFile(get_script_dir() + "/BoolNumericConversion.expected");
    }

    constructor() : QUnit::Test("bool to int, float and number conversions", "1.0", \ARGV) {
        foreach string mode in (ExecModeHarness::ExecModes) {
            string execution_mode = mode;
            addTestCase("execution mode " + mode, sub () {
                assertEq(expected, ExecModeHarness::run(command(execution_mode)));
            });
        }
        addTestCase("IR tier", sub () {
            assertEq(expected, ExecModeHarness::run_ir_tier(command("tiered")));
        });
        addTestCase("qcc -O0", sub () { checkQcc(0); });
        addTestCase("qcc -O3", sub () { checkQcc(3); });

        set_return_value(main());
    }

    private string command(string mode) {
        return sprintf("%s --enable-debug --exec-mode=%s %s", shellQuote(qore_bin), mode, shellQuote(fixture));
    }

    private checkQcc(int opt) {
        string qcc_bin = ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }
        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        string program = dir + "/bool-numeric-conversion";
        string output = backquote(sprintf("%s -O%d -o %s %s 2>&1", shellQuote(qcc_bin), opt, shellQuote(program),
            shellQuote(fixture)));
        assertTrue(is_file(program), "the fixture compiled: " + output);
        assertEq(expected, backquote(shellQuote(program) + " 2>&1"));
    }

    private static string shellQuote(string value) {
        return "'" + replace(value, "'", "'\\''") + "'";
    }
}
