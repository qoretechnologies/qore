#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class CharBoolEqualsTest

#! Tests == and != of a char and a bool (qore#6048)
/** A char is compared as an int with the same code point, with either operand order and whether the operands are
    typed or not; before, the AST interpreter compared typed operands as bools.  The checks are in
    char-bool-equals-worker.qr, which is run in each execution mode, on the IR tier and as a program compiled with qcc;
    every run must give the results below.
*/
class CharBoolEqualsTest inherits QUnit::Test {
    public {
        #! the result of every check the worker makes
        const Expected = {
            "typed-a-true": "False True False True",
            "or-nothing-a-true": "False True False True",
            "untyped-a-true": "False True False True",
            "or-nothing-char-a-true": "False True False True",
            "union-a-true": "False True False True",
            "softchar-a-true": "False True False True",
            "typed-a-false": "False True False True",
            "or-nothing-a-false": "False True False True",
            "untyped-a-false": "False True False True",
            "or-nothing-char-a-false": "False True False True",
            "union-a-false": "False True False True",
            "softchar-a-false": "False True False True",
            "typed-nul-true": "False True False True",
            "or-nothing-nul-true": "False True False True",
            "untyped-nul-true": "False True False True",
            "or-nothing-char-nul-true": "False True False True",
            "union-nul-true": "False True False True",
            "softchar-nul-true": "False True False True",
            "typed-nul-false": "True False True False",
            "or-nothing-nul-false": "True False True False",
            "untyped-nul-false": "True False True False",
            "or-nothing-char-nul-false": "True False True False",
            "union-nul-false": "True False True False",
            "softchar-nul-false": "True False True False",
            "typed-one-true": "True False True False",
            "or-nothing-one-true": "True False True False",
            "untyped-one-true": "True False True False",
            "or-nothing-char-one-true": "True False True False",
            "union-one-true": "True False True False",
            "softchar-one-true": "True False True False",
            "typed-one-false": "False True False True",
            "or-nothing-one-false": "False True False True",
            "untyped-one-false": "False True False True",
            "or-nothing-char-one-false": "False True False True",
            "union-one-false": "False True False True",
            "softchar-one-false": "False True False True",
            "or-nothing-char-nothing": "True False True False",
            "union-bool": "True False True False",
            "constant": "False True True False",
            "stable": "True",
        };
    }

    private {
        string qore_bin;
        string libqore_dir;
        string qcc_bin;
    }

    constructor() : QUnit::Test("CharBoolEqualsTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
            ?? (is_file(libqore_dir + DirSep + "qcc") ? libqore_dir + DirSep + "qcc"
                : dirname(qore_bin) + DirSep + "qcc");
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }

        addTestCase("each execution mode", \testExecModes());
        addTestCase("IR tier", \testIrTier());
        addTestCase("%strict-bool-eval in the AST interpreter", \testStrictBoolEval());
        addTestCase("compiled program", \testCompiledProgram());

        set_return_value(main());
    }

    testExecModes() {
        foreach string mode in (ExecModeHarness::ExecModes) {
            string out = ExecModeHarness::run(sprintf("LD_LIBRARY_PATH=%s %s -b --enable-debug --exec-mode=%s %s",
                libqore_dir, qore_bin, mode, getWorker()));
            checkWorkerOutput(mode, out);
        }
    }

    #! every function runs on the IR tier, which the tiered run of ExecModes hardly runs
    testIrTier() {
        checkWorkerOutput("ir-tier", ExecModeHarness::run_ir_tier(sprintf("LD_LIBRARY_PATH=%s %s -b --enable-debug "
            "--exec-mode=tiered %s", libqore_dir, qore_bin, getWorker())));
    }

    #! the strict boolean variant of the operators, which code that is not %modern uses (only the AST interpreter runs
    #! it)
    testStrictBoolEval() {
        TmpDir tmp("qore-char-bool-equals-strict-");
        string path = tmp.path + DirSep + "strict.q";
        File f();
        f.open2(path, O_WRONLY | O_CREAT | O_TRUNC);
        f.write("%new-style\n%strict-bool-eval\n"
            "sub t(char c, bool b) { printf(\"%y %y %y %y\\n\", c == b, c != b, b == c, b != c); }\n"
            "t(c'a', True);\nt(c'\\0', False);\nt(c'\\x01', True);\n");
        f.close();
        assertEq("False True False True\nTrue False True False\nTrue False True False\n",
            backquote(sprintf("LD_LIBRARY_PATH=%s %s -b --enable-debug --exec-mode=ast %s 2>&1", libqore_dir, qore_bin,
                path)));
    }

    testCompiledProgram() {
        TmpDir tmp("qore-char-bool-equals-");
        string exe = tmp.path + DirSep + "char-bool-equals";
        string compile_out = backquote(sprintf("LD_LIBRARY_PATH=%s %s --strip-source -o %s %s 2>&1", libqore_dir,
            qcc_bin, exe, getWorker()));
        assertTrue(is_file(exe), "compiled program: " + compile_out);
        checkWorkerOutput("aot", backquote(sprintf("LD_LIBRARY_PATH=%s %s 2>&1", libqore_dir, exe)));
    }

    private string getWorker() {
        return get_script_dir() + DirSep + "char-bool-equals-worker.qr";
    }

    #! parses the "name=result" lines printed by the worker and checks them; any other output fails
    private checkWorkerOutput(string label, string out) {
        hash<string, string> results = {};
        foreach string line in (out.split("\n")) {
            *list<*string> parts = (line =~ x/^([-a-z]+)=(.*)$/);
            if (!parts) {
                if (line.val()) {
                    fail(sprintf("%s: unexpected worker output: %y", label, out));
                }
                continue;
            }
            results{parts[0]} = parts[1];
        }
        assertEq(sort(keys Expected), sort(keys results), label + ": checks run");
        foreach hash<auto> i in (Expected.pairIterator()) {
            assertEq(i.value, results{i.key}, sprintf("%s: %s", label, i.key));
        }
    }
}
