#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class RemoveBoxedIntegerLeakTest

#! Tests that remove and delete release the integers outside the inline range that they take from a list
/** An integer outside the inline (48-bit) range of a value is a heap QoreBigIntNode.  The removal of list elements
    (<tt>remove l[i]</tt>, <tt>remove l[i, j]</tt>, <tt>remove l[i..j]</tt>, <tt>delete l[i]</tt>) stores the removed
    value in a QoreLValueGeneric, which holds such an integer inline; the objects in the removed value were then
    recorded from QoreLValue::getValue(), which boxes the integer in a new heap node that no one released, so every
    such removal leaked it in the AST tier (qore#6094).

    The worker removes and deletes such integers from lists, hashes, objects and local variables, counts the heap
    integers that exist before and after with dbg_get_live_bigint_count(), which needs library debugging, and reports
    how many it left behind, which must be none.  It runs in every execution mode and as a qcc-compiled executable.
*/
class RemoveBoxedIntegerLeakTest inherits QUnit::Test {
    public {
        #! the results printed by the worker for 2^60
        const Expected = "1152921504606846977 1152921504606846979 [1152921504606846976, 1152921504606846978] "
            "[1152921504606846976, 1152921504606846978] [1152921504606846977, 1152921504606846978] [] "
            "1152921504606846976 1152921504606846977 {a: 1152921504606846976, b: 1152921504606846977} "
            "{l: [null, 1152921504606846977]} 1152921504606846976 1152921504606846976 "
            "{a: 1152921504606846976, b: 1152921504606846977} [1152921504606846976, null] 1152921504606846976 null";
    }

    private {
        string qore_bin;
        string libqore_dir;
        string qcc_bin;
        string worker;
    }

    constructor() : QUnit::Test("RemoveBoxedIntegerLeak", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");
        worker = get_script_dir() + DirSep + "remove-boxed-integer-leak-worker.q";

        addTestCase("each execution mode", \testExecModes());
        addTestCase("compiled executable", \testCompiled());

        set_return_value(main());
    }

    testExecModes() {
        checkDebugging();
        foreach string mode in (ExecModeHarness::ExecModes) {
            checkOutput(mode, ExecModeHarness::run(sprintf("LD_LIBRARY_PATH=%s %s -b --exec-mode=%s %s",
                libqore_dir, qore_bin, mode, worker)));
        }
    }

    testCompiled() {
        checkDebugging();
        TmpDir tmp("qore-remove-boxed-integer-leak-");
        string exe = tmp.path + DirSep + "leak";
        string out = backquote(sprintf("QORE_LIBDIR=%s %s -o %s %s 2>&1", libqore_dir, qcc_bin, exe, worker));
        assertTrue(is_file(exe), "compiled the executable: " + out);
        checkOutput("executable", ExecModeHarness::run_any(sprintf("LD_LIBRARY_PATH=%s %s", libqore_dir, exe)));
    }

    #! skips the test without library debugging, which dbg_get_live_bigint_count() needs
    private checkDebugging() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("dbg_get_live_bigint_count() requires library debugging");
        }
    }

    private checkOutput(string label, string out) {
        list<string> lines = (select out.split("\n"), $1);
        assertEq(Expected, lines[0], label + ": result: " + out);
        assertEq("live heap integers: 0", lines[1], label + ": heap integers left behind: " + out);
    }
}
