#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-exec-mode: children - its checks run in child processes that set their own execution modes
# test-platform: macos - JIT and AOT code generation and linking of weak assignments of untyped locals, globals and class static variables

# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../ExecModeHarness.qm

%exec-class WeakReferenceUniqueSourceUntypedTest

#! a weak reference to any variable designates the variable's own container (qore#5847)
/** The weak assignment of qore#5756 made the container of a variable declared with a hash or list type unique before
    it took the weak reference.  The same rule now applies to the other variables: an untyped (`auto`) local, a
    parameter, a global, a variable that a closure captures and a class static variable (read in a function, a method,
    a static method and at the top level).  The AST interpreter shared the literal of `auto h = {"a": 1}` with the
    program and left the weak reference with it when the owner wrote to the hash, where the compiled modes followed the
    owner; a container that an untyped local shared with another variable was copied by the owner's write in every
    compiled mode and left the weak reference with the old container.  Values that are not a hash or a list (NOTHING,
    an int, a string, an object, a reference) are not touched.  The weak assignment from a global, a class static
    variable or a variable that a closure captures assigns the container that the unique step took under the lock
    of the variable, so that a variable that another thread assigns in between is not read again.  Every mode, qcc
    executables included, must print the output of the AST.

    The program is in \c weak-reference-unique-source-untyped/.
*/
class WeakReferenceUniqueSourceUntypedTest inherits QUnit::Test {
    private {
        string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        string dir = get_script_dir() + "/weak-reference-unique-source-untyped";

        const Modes = ("ast", "ir", "jit", "tiered");
        const Programs = ("weak-reference-unique-source-untyped",);
    }

    constructor() : QUnit::Test("WeakReferenceUniqueSourceUntypedTest", "1.0", \ARGV) {
        addTestCase("the AST interpreter prints the expected output", \testAst());
        addTestCase("IR, JIT and tiered execution print the output of the AST", \testModes());
        addTestCase("qcc executables print the output of the AST", \testCompiled());
        set_return_value(main());
    }

    private string expected(string name) {
        return ReadOnlyFile::readTextFile(dir + "/" + name + ".expected");
    }

    private string run(string name, string mode) {
        hash<ExecModeHarness::ModeRunResult> r = ExecModeHarness::run_command(sprintf("%s -b --enable-debug "
            "--exec-mode=%s %s/%s.q", qore_bin, mode, dir, name));
        assertEq(0, r.rc, sprintf("%s %s: exit status (output: %y)", name, mode, r.out));
        return r.stdout;
    }

    testAst() {
        foreach string name in (Programs) {
            assertEq(expected(name), run(name, "ast"), name + " ast");
        }
    }

    testModes() {
        foreach string name in (Programs) {
            foreach string mode in (Modes) {
                assertEq(expected(name), run(name, mode), name + " " + mode);
            }
        }
    }

    testCompiled() {
        string qcc_bin = ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }
        TmpDir tmp("qore-weak-reference-unique-source-untyped-");
        foreach string name in (Programs) {
            foreach string opt in (("0", "3")) {
                string exe = sprintf("%s/%s-O%s", tmp.path, name, opt);
                int rc;
                string out = backquote(sprintf("%s -O%s -o %s %s/%s.q 2>&1", qcc_bin, opt, exe, dir, name), \rc);
                if (rc || !is_file(exe)) {
                    testSkip("qcc is not available or cannot compile " + name + ": " + out);
                }
                # -b must be the first argument of a compiled program
                string result = backquote(sprintf("%s -b 2>&1", exe), \rc);
                assertEq(0, rc, sprintf("%s -O%s: exit status (output: %y)", name, opt, result));
                assertEq(expected(name), result, sprintf("%s -O%s", name, opt));
            }
        }
    }
}
