#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class CastNestedSoftTest

#! Tests that a cast converts the elements of containers as an assignment does
/** A cast to a container type whose nested element type accepts an element only through a conversion converts the
    element instead of stamping the container with an element type its element does not have.  The checks are in
    cast-nested-soft-worker.qr, which is run in each execution mode and as a program compiled with qcc; every run must
    give the results below.
*/
class CastNestedSoftTest inherits QUnit::Test {
    public {
        #! the result of every check the worker makes
        const Expected = {
            "cast-list-softint": "list<list<softint>>:integer:[[1, 2]]",
            "assign-list-softint": "list<list<softint>>:integer:[[1, 2]]",
            "cast-list-float": "list<list<float>>:float:[[1.0, 2.0]]",
            "assign-list-float": "list<list<float>>:float:[[1.0, 2.0]]",
            "cast-hash-softint": "hash<string, list<softint>>:integer:{a: [1]}",
            "assign-hash-softint": "hash<string, list<softint>>:integer:{a: [1]}",
            "cast-list-of-hash": "list<hash<string, softint>>:integer:[{a: 1}]",
            "assign-list-of-hash": "list<hash<string, softint>>:integer:[{a: 1}]",
            "cast-three-levels": "list<list<list<softint>>>:integer:[[[1]]]",
            "cast-softstring": "list<list<softstring>>:string:[[\"1\", \"2\"]]",
            "cast-already-typed": "list<list<int>>:integer:[[1, 2]]",
            "cast-source-unchanged": "list<list<string>>:string:[[\"1\", \"2\"]]|list<list<softint>>",
            "cast-bad": "RUNTIME-TYPE-ERROR",
            "constant": "list<list<softint>>:integer:[[1, 2]]",
            "cast-hash-top-softint": "hash<string, softint>:integer:{a: 1}",
            "assign-hash-top-softint": "hash<string, softint>:integer:{a: 1}",
            "cast-hash-top-bad": "RUNTIME-TYPE-ERROR",
            "assign-hash-top-bad": "RUNTIME-TYPE-ERROR",
            "cast-hash-top-typed": "hash<string, int>:integer:{a: 1}",
            "cast-hash-top-float": "hash<string, float>:float:{a: 1.0}",
            "stable": "yes",
        };

        #! the execution modes that the worker is run in
        const ExecModes = ("ast", "ir", "jit", "tiered");
    }

    private {
        string qore_bin;
        string libqore_dir;
        string qcc_bin;
    }

    constructor() : QUnit::Test("CastNestedSoftTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? ENV.QORE_QCC_EXECUTABLE
            ?? (is_file(libqore_dir + DirSep + "qcc") ? libqore_dir + DirSep + "qcc"
                : dirname(qore_bin) + DirSep + "qcc");
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }

        addTestCase("each execution mode", \testExecModes());
        addTestCase("compiled program", \testCompiledProgram());

        set_return_value(main());
    }

    testExecModes() {
        foreach string mode in (ExecModes) {
            string out = ExecModeHarness::run(sprintf("LD_LIBRARY_PATH=%s %s -b --enable-debug --exec-mode=%s %s",
                libqore_dir, qore_bin, mode, getWorker()));
            checkWorkerOutput(mode, out);
        }
    }

    testCompiledProgram() {
        TmpDir tmp("qore-cast-nested-soft-");
        string exe = tmp.path + DirSep + "cast-nested-soft";
        string compile_out = backquote(sprintf("LD_LIBRARY_PATH=%s %s --strip-source -o %s %s 2>&1", libqore_dir,
            qcc_bin, exe, getWorker()));
        assertTrue(is_file(exe), "compiled program: " + compile_out);
        checkWorkerOutput("aot", backquote(sprintf("LD_LIBRARY_PATH=%s %s 2>&1", libqore_dir, exe)));
    }

    private string getWorker() {
        return get_script_dir() + DirSep + "cast-nested-soft-worker.qr";
    }

    #! parses the "name=result" lines printed by the worker and checks them
    private checkWorkerOutput(string label, string out) {
        hash<string, string> results = {};
        foreach string line in (out.split("\n")) {
            *list<*string> parts = (line =~ x/^([-a-z]+)=(.*)$/);
            if (!parts) {
                if (line.val()) {
                    fail(sprintf("%s: unexpected worker output: %y", label, out));
                }
                continue;
            }
            results{parts[0]} = parts[1];
        }
        assertEq(sort(keys Expected), sort(keys results), label + ": checks run");
        foreach hash<auto> i in (Expected.pairIterator()) {
            assertEq(i.value, results{i.key}, sprintf("%s: %s", label, i.key));
        }
    }
}
