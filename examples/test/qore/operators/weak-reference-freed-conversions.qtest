#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-exec-mode: children - its checks run in child processes that set their own execution modes
# test-platform: macos - JIT and AOT code generation of the conversions of containers freed under weak references

# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires ../../TestInterpreter.qm
%requires FsUtil
%requires ../../ExecModeHarness.qm

%exec-class WeakReferenceFreedConversionsTest

#! a conversion of a list or hash freed under a weak reference to another type is a new container (qore#7199)
/** A cast of a list or hash freed under a weak reference to another type, and its conversion to a variable or a
    parameter of another type, gave a container that could not be changed (\c LIST-ERROR, \c HASH-ERROR) in some
    cases and a new one in others, and the IR interpreter and the JIT converted a \c hash<string, int> to a
    \c hash<string, softint> variable without making it a new hash, where the AST interpreter did.  A conversion to
    another type is a new container, which can be changed, as the other values computed from a freed container are;
    a value that stays the same container (a cast to the identical type or to its or-nothing type, or \c auto,
    \c hash<auto>, \c list<auto> and \c *list<int> for a \c list<int>) keeps the freed state, as a read of the weak
    reference does.  The program covers the casts, the new expressions and the conversions to variables, parameters,
    members, list elements and return values of lists, hashes, plain containers and hashdecl hashes, freed and live.
    Every mode must print the output of the AST.

    The program is in \c weak-reference-freed-conversions/.
*/
class WeakReferenceFreedConversionsTest inherits QUnit::Test {
    private {
        string qore_bin = TestInterpreter::qore_interpreter();
        string dir = get_script_dir() + "/weak-reference-freed-conversions";

        const Modes = ("ast", "ir", "jit", "tiered");
        const Programs = ("weak-reference-freed-conversions",);
    }

    constructor() : QUnit::Test("WeakReferenceFreedConversionsTest", "1.0", \ARGV) {
        addTestCase("the AST interpreter prints the expected output", \testAst());
        addTestCase("IR, JIT and tiered execution print the output of the AST", \testModes());
        addTestCase("qcc executables print the output of the AST", \testCompiled());
        set_return_value(main());
    }

    private string expected(string name) {
        return ReadOnlyFile::readTextFile(dir + "/" + name + ".expected");
    }

    private string run(string name, string mode) {
        hash<ExecModeHarness::ModeRunResult> r = ExecModeHarness::run_command(sprintf("%s -b --enable-debug "
            "--exec-mode=%s %s/%s.q", qore_bin, mode, dir, name));
        assertEq(0, r.rc, sprintf("%s %s: exit status (output: %y)", name, mode, r.out));
        return r.stdout;
    }

    testAst() {
        foreach string name in (Programs) {
            assertEq(expected(name), run(name, "ast"), name + " ast");
        }
    }

    testModes() {
        foreach string name in (Programs) {
            foreach string mode in (Modes) {
                if (mode == "ast") {
                    continue;
                }
                assertEq(expected(name), run(name, mode), name + " " + mode);
            }
        }
    }

    testCompiled() {
        string qcc_bin = ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        if (!is_file(qcc_bin)) {
            *string path = backquote("command -v qcc 2>/dev/null");
            trim path;
            if (!path) {
                testSkip("qcc is not available");
            }
            qcc_bin = path;
        }
        TmpDir tmp("qore-weak-reference-freed-conversions-");
        foreach string name in (Programs) {
            foreach string opt in (("0", "3")) {
                string exe = sprintf("%s/%s-O%s", tmp.path, name, opt);
                int rc;
                string out = backquote(sprintf("%s -O%s -o %s %s/%s.q 2>&1", qcc_bin, opt, exe, dir, name), \rc);
                assertEq(0, rc, sprintf("%s -O%s: qcc compiles the program: %s", name, opt, out));
                if (rc || !is_file(exe)) {
                    continue;
                }
                # -b must be the first argument of a compiled program
                string result = backquote(sprintf("%s -b 2>&1", exe), \rc);
                assertEq(0, rc, sprintf("%s -O%s: exit status (output: %y)", name, opt, result));
                assertEq(expected(name), result, sprintf("%s -O%s", name, opt));
            }
        }
    }
}
