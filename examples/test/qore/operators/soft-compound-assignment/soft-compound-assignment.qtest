#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes and in programs compiled with qcc
# test-platform: macos - JIT and AOT code generation of compound assignments and increments of soft-typed lvalues

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires ../../../TestInterpreter.qm
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class SoftCompoundAssignmentTest

#! Regression test for issue #6304: compound assignments to soft-typed lvalues that convert the result
/** A compound assignment or increment of an lvalue of a soft type that converts the value that the operator assigns
    (softstring, softbool, *softstring, and softint, softfloat and softnumber with a result of another type) was a
    PARSE-TYPE-ERROR, although an assignment of the same value is valid and converts it.  Such operations are now
    accepted, take the generic operators, and have the result type of the value that the operator gives.

    SoftCompoundAssignment.q (generated by gen.py) prints, for each operation on a local variable, a class member and
    a hashdecl member, the value of the expression and the value of the lvalue afterwards; its output must be the one
    in SoftCompoundAssignment.expected, which the AST interpreter prints, in every execution mode, on the IR tier and
    in programs compiled with qcc -O0 and -O3.
*/
class SoftCompoundAssignmentTest inherits QUnit::Test {
    private {
        string qore_bin = TestInterpreter::qore_interpreter();
        string fixture = get_script_dir() + "/SoftCompoundAssignment.q";
        string expected = ReadOnlyFile::readTextFile(get_script_dir() + "/SoftCompoundAssignment.expected");
    }

    constructor() : QUnit::Test("compound assignments of soft-typed lvalues", "1.0", \ARGV) {
        foreach string mode in (ExecModeHarness::ExecModes) {
            string execution_mode = mode;
            addTestCase("execution mode " + mode, sub () {
                assertEq(expected, ExecModeHarness::run(command(execution_mode)));
            });
        }
        addTestCase("IR tier", sub () {
            assertEq(expected, ExecModeHarness::run_ir_tier(command("tiered")));
        });
        addTestCase("qcc -O0", sub () { checkQcc(0); });
        addTestCase("qcc -O3", sub () { checkQcc(3); });

        set_return_value(main());
    }

    private string command(string mode) {
        return sprintf("%s --enable-debug --exec-mode=%s %s", shellQuote(qore_bin), mode, shellQuote(fixture));
    }

    private checkQcc(int opt) {
        string qcc_bin = ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }
        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        string program = dir + "/soft-compound-assignment";
        string output = backquote(sprintf("%s -O%d -o %s %s 2>&1", shellQuote(qcc_bin), opt, shellQuote(program),
            shellQuote(fixture)));
        assertTrue(is_file(program), "the fixture compiled: " + output);
        assertEq(expected, backquote(shellQuote(program) + " 2>&1"));
    }

    private static string shellQuote(string value) {
        return "'" + replace(value, "'", "'\\''") + "'";
    }
}
