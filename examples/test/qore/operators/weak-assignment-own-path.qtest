#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-exec-mode: children - its checks run in child processes that set their own execution modes
# test-platform: macos - JIT and AOT code generation of weak assignments and threads releasing their sources

# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires ../../TestInterpreter.qm
%requires FsUtil
%requires ../../ExecModeHarness.qm

%exec-class WeakAssignmentOwnPathTest

#! a weak assignment does not keep the list or hash that an lvalue holds, which is its source (qore#7405)
/** A weak assignment held strong references to its source while it resolved its target: a source that the target's
    path passes through (h.w := h, h.a.b.w := h) was shared by them alone, so that a copy-on-write step of the path
    copied it and every container below it on the path.  The weak reference assigned designated the original, which
    nothing held, and so did every other weak reference to the containers copied (h.a.x := h.a.b): a later change
    through them raised HASH-ERROR, in every execution mode.  The assignment now holds a list or a hash that an lvalue
    holds through a weak reference until it assigns it: nothing is copied, and the weak references designate the
    containers that the variables hold.

    The first program covers the root, an inner container and the container holding the inner one, a list, the weak
    references below the source, a source shared with another owner, locals of a function, typed and untyped, and a
    member.  The second program has another thread release the source while the assignment resolves its target (the
    key of the target is evaluated after the source is read): the weak reference then designates a freed container,
    which reads as empty and cannot be changed.  Every mode must print the output of the AST.

    The programs are in \\c weak-assignment-own-path/.
*/
class WeakAssignmentOwnPathTest inherits QUnit::Test {
    private {
        string qore_bin = TestInterpreter::qore_interpreter();
        string dir = get_script_dir() + "/weak-assignment-own-path";

        const Modes = ("ast", "ir", "jit", "tiered");
        const Programs = ("weak-assignment-own-path", "weak-assignment-source-release");
    }

    constructor() : QUnit::Test("WeakAssignmentOwnPathTest", "1.0", \ARGV) {
        addTestCase("the AST interpreter prints the expected output", \testAst());
        addTestCase("IR, JIT and tiered execution print the output of the AST", \testModes());
        addTestCase("qcc executables print the output of the AST", \testCompiled());
        set_return_value(main());
    }

    private string expected(string name) {
        return ReadOnlyFile::readTextFile(dir + "/" + name + ".expected");
    }

    private string run(string name, string mode) {
        hash<ExecModeHarness::ModeRunResult> r = ExecModeHarness::run_command(sprintf("%s -b --enable-debug "
            "--exec-mode=%s %s/%s.q", qore_bin, mode, dir, name));
        assertEq(0, r.rc, sprintf("%s %s: exit status (output: %y)", name, mode, r.out));
        return r.stdout;
    }

    testAst() {
        foreach string name in (Programs) {
            assertEq(expected(name), run(name, "ast"), name + " ast");
        }
    }

    testModes() {
        foreach string name in (Programs) {
            foreach string mode in (Modes) {
                if (mode == "ast") {
                    continue;
                }
                assertEq(expected(name), run(name, mode), name + " " + mode);
            }
        }
    }

    testCompiled() {
        string qcc_bin = ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        if (!is_file(qcc_bin)) {
            *string path = backquote("command -v qcc 2>/dev/null");
            trim path;
            if (!path) {
                testSkip("qcc is not available");
            }
            qcc_bin = path;
        }
        TmpDir tmp("qore-weak-assignment-own-path-");
        foreach string name in (Programs) {
            foreach string opt in (("0", "3")) {
                string exe = sprintf("%s/%s-O%s", tmp.path, name, opt);
                int rc;
                string out = backquote(sprintf("%s -O%s -o %s %s/%s.q 2>&1", qcc_bin, opt, exe, dir, name), \rc);
                assertEq(0, rc, sprintf("%s -O%s: qcc compiles the program: %s", name, opt, out));
                if (rc || !is_file(exe)) {
                    continue;
                }
                # -b must be the first argument of a compiled program
                string result = backquote(sprintf("%s -b 2>&1", exe), \rc);
                assertEq(0, rc, sprintf("%s -O%s: exit status (output: %y)", name, opt, result));
                assertEq(expected(name), result, sprintf("%s -O%s", name, opt));
            }
        }
    }
}
