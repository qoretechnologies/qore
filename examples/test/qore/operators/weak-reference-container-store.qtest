#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-exec-mode: children - its checks run in child processes that set their own execution modes
# test-platform: macos - JIT and AOT code generation of the container stores of locals that hold weak references

# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires ../../TestInterpreter.qm
%requires FsUtil
%requires ../../ExecModeHarness.qm

%exec-class WeakReferenceContainerStoreTest

#! a write through a local that holds a weak reference to a list or a hash changes the container (qore#7299)
/** In IR, JIT, tiered and qcc executables, an element or key store through a typed local that holds a weak reference
    to a list or a hash (\c l[2] = 3, \c h.b = 2, \c h{k} = 3, \c l[0] += 10) copied the container and replaced the
    weak reference with the copy: the store reads the local's container with a reference of its own since qore#7198,
    and its copy-on-write check took that reference for an owner.  The AST interpreter changes the container that the
    weak reference designates, in place.  The program covers the element and key stores through typed and untyped
    locals, a loop, a container that the weak assignment made unique, a freed container, and the other changes of the
    container through the local, which raise in every mode (\c push, \c +=, \c splice: qore#7297).  Every mode must
    print the output of the AST.

    The store holds its own reference to the container until it is done; \c weak-reference-container-store-dtor
    makes that reference the last one, so that releasing it destroys the container and the destructor of an element
    throws: IR, JIT and tiered execution raised that exception after the store's exception handling, so that it escaped
    the try block whose last statement the store is (qore#7355).  It covers a list element, a constant and a dynamic
    hash key, and a store outside a try block, whose exception the caller catches.

    The programs are in \c weak-reference-container-store/.
*/
class WeakReferenceContainerStoreTest inherits QUnit::Test {
    private {
        string qore_bin = TestInterpreter::qore_interpreter();
        string dir = get_script_dir() + "/weak-reference-container-store";

        const Modes = ("ast", "ir", "jit", "tiered");
        const Programs = ("weak-reference-container-store", "weak-reference-container-store-dtor");
    }

    constructor() : QUnit::Test("WeakReferenceContainerStoreTest", "1.0", \ARGV) {
        addTestCase("the AST interpreter prints the expected output", \testAst());
        addTestCase("IR, JIT and tiered execution print the output of the AST", \testModes());
        addTestCase("qcc executables print the output of the AST", \testCompiled());
        set_return_value(main());
    }

    private string expected(string name) {
        return ReadOnlyFile::readTextFile(dir + "/" + name + ".expected");
    }

    private string run(string name, string mode) {
        hash<ExecModeHarness::ModeRunResult> r = ExecModeHarness::run_command(sprintf("%s -b --enable-debug "
            "--exec-mode=%s %s/%s.q", qore_bin, mode, dir, name));
        assertEq(0, r.rc, sprintf("%s %s: exit status (output: %y)", name, mode, r.out));
        return r.stdout;
    }

    testAst() {
        foreach string name in (Programs) {
            assertEq(expected(name), run(name, "ast"), name + " ast");
        }
    }

    testModes() {
        foreach string name in (Programs) {
            foreach string mode in (Modes) {
                if (mode == "ast") {
                    continue;
                }
                assertEq(expected(name), run(name, mode), name + " " + mode);
            }
        }
    }

    testCompiled() {
        string qcc_bin = ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        if (!is_file(qcc_bin)) {
            *string path = backquote("command -v qcc 2>/dev/null");
            trim path;
            if (!path) {
                testSkip("qcc is not available");
            }
            qcc_bin = path;
        }
        TmpDir tmp("qore-weak-reference-container-store-");
        foreach string name in (Programs) {
            foreach string opt in (("0", "3")) {
                string exe = sprintf("%s/%s-O%s", tmp.path, name, opt);
                int rc;
                string out = backquote(sprintf("%s -O%s -o %s %s/%s.q 2>&1", qcc_bin, opt, exe, dir, name), \rc);
                assertEq(0, rc, sprintf("%s -O%s: qcc compiles the program: %s", name, opt, out));
                if (rc || !is_file(exe)) {
                    continue;
                }
                # -b must be the first argument of a compiled program
                string result = backquote(sprintf("%s -b 2>&1", exe), \rc);
                assertEq(0, rc, sprintf("%s -O%s: exit status (output: %y)", name, opt, result));
                assertEq(expected(name), result, sprintf("%s -O%s", name, opt));
            }
        }
    }
}
