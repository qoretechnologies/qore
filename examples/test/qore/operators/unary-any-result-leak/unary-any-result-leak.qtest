#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes
# test-platform: macos - JIT and AOT code generation and the cleanup of the values native code creates

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class UnaryAnyResultLeakTest

#! Tests that native code releases the result of the unary minus and plus operators applied to untyped values
/** The unary minus and plus of an untyped value in native (JIT and qcc-compiled) code take an inline path for an
    inline integer or float and call the runtime otherwise; either way the result can be a new heap value (a heap
    integer, a heap float, a number or a date), which native code did not release outside a try block, so every
    operation leaked it (issue #6132).

    The worker counts the heap integers and floats that exist before and after the operations with
    dbg_get_live_bigint_count() and dbg_get_live_bigfloat_count(), which need library debugging, and reports how
    many they left behind, which must be none.  It runs in every execution mode and as a qcc-compiled executable.
*/
class UnaryAnyResultLeakTest inherits QUnit::Test {
    public {
        #! the result printed by the worker
        const Expected = "[-1152921504606846976, 1152921504606846976, 140737488355328, -1152921504606846976, "
            "-1152921504606846976, -1152921504606846976, \"-1152921504606846976\", 3, -1152921504606846976, "
            "1152921504606846976, -1152921504606846976, 4611686018427400249, -4611686018427400249, "
            "\"-nan.0\", 1.5, -7, <time: -1 hours>, True, True, True, True, True, True, True]";
    }

    private {
        string qore_bin;
        string libqore_dir;
        string qcc_bin;
        string worker;
    }

    constructor() : QUnit::Test("UnaryAnyResultLeak", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");
        worker = get_script_dir() + DirSep + "unary-any-result-leak-worker.q";

        addTestCase("each execution mode", \testExecModes());
        addTestCase("compiled executable", \testCompiled());

        set_return_value(main());
    }

    testExecModes() {
        checkDebugging();
        foreach string mode in (ExecModeHarness::ExecModes) {
            checkOutput(mode, ExecModeHarness::run(sprintf("LD_LIBRARY_PATH=%s %s -b --exec-mode=%s %s",
                libqore_dir, qore_bin, mode, worker)));
        }
    }

    testCompiled() {
        checkDebugging();
        foreach string opt in ("-O0", "-O3") {
            TmpDir tmp("qore-unary-any-result-leak-");
            string exe = tmp.path + DirSep + "leak";
            string out = backquote(sprintf("QORE_LIBDIR=%s %s %s -o %s %s 2>&1", libqore_dir, qcc_bin, opt, exe,
                worker));
            assertTrue(is_file(exe), opt + ": compiled the executable: " + out);
            checkOutput("executable " + opt, ExecModeHarness::run_any(sprintf("LD_LIBRARY_PATH=%s %s -b",
                libqore_dir, exe)));
        }
    }

    #! skips the test without library debugging, which the live heap value counters need
    private checkDebugging() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("dbg_get_live_bigint_count() requires library debugging");
        }
    }

    private checkOutput(string label, string out) {
        list<string> lines = (select out.split("\n"), $1);
        # the C library prints the sign of a NaN on Linux ("-nan") but not on macOS ("nan")
        assertEq(Expected, regex_subst(lines[0], "\"nan\\.0\"", "\"-nan.0\""), label + ": result: " + out);
        assertEq("live heap integers: 0", lines[1], label + ": heap integers left behind: " + out);
        assertEq("live heap floats: 0", lines[2], label + ": heap floats left behind: " + out);
    }
}
