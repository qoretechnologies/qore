#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes and in programs compiled with qcc
# test-platform: macos - JIT and AOT code generation of typed hash and list construction from a lowered initializer

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../../ExecModeHarness.qm

%exec-class NewInitializerLvaluesTest

#! Regression test for issues #5704 and #5705: modifications of locals in the initializer of new hash<K,V>(...)
/** IR and tiered execution evaluated the initializer of <tt>new hash<K,V>(...)</tt> and <tt>new list<T>(...)</tt>
    through its AST node, and its writes to local variables were lost (#5704); qcc refused to compile an initializer
    with extract, splice, list assignment or s/// (#5705).  A list assignment in such an initializer also had the
    parse type of its last lvalue, so the typed hash refused it in every mode.

    NewInitializerLvalues.q modifies locals in the initializer or arguments of each form of new, also in a try block
    and with an initializer of the wrong type; its output must be the one in NewInitializerLvalues.expected, which the
    AST interpreter prints, in every execution mode, on the IR tier and in programs compiled with qcc -O0 and -O3.
*/
class NewInitializerLvaluesTest inherits QUnit::Test {
    private {
        string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        string fixture = get_script_dir() + "/NewInitializerLvalues.q";
        string expected = ReadOnlyFile::readTextFile(get_script_dir() + "/NewInitializerLvalues.expected");
    }

    constructor() : QUnit::Test("modifications of locals in new initializers", "1.0", \ARGV) {
        foreach string mode in (ExecModeHarness::ExecModes) {
            string execution_mode = mode;
            addTestCase("execution mode " + mode, sub () {
                assertEq(expected, ExecModeHarness::run(command(execution_mode)));
            });
        }
        addTestCase("IR tier", sub () {
            assertEq(expected, ExecModeHarness::run_ir_tier(command("tiered")));
        });
        addTestCase("qcc -O0", sub () { checkQcc(0); });
        addTestCase("qcc -O3", sub () { checkQcc(3); });

        set_return_value(main());
    }

    private string command(string mode) {
        return sprintf("%s --enable-debug --exec-mode=%s %s", shellQuote(qore_bin), mode, shellQuote(fixture));
    }

    private checkQcc(int opt) {
        string qcc_bin = ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }
        string dir = make_tmp_dir();
        on_exit remove_tree(dir);
        string program = dir + "/new-initializer-lvalues";
        string output = backquote(sprintf("%s -O%d -o %s %s 2>&1", shellQuote(qcc_bin), opt, shellQuote(program),
            shellQuote(fixture)));
        assertTrue(is_file(program), "the fixture compiled: " + output);
        assertEq(expected, backquote(shellQuote(program) + " 2>&1"));
    }

    private static string shellQuote(string value) {
        return "'" + replace(value, "'", "'\\''") + "'";
    }
}
