#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-exec-mode: children - its checks run in child processes that set their own execution modes
# test-platform: macos - JIT and AOT code generation and linking of weak assignments of objects

# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires ../../TestInterpreter.qm
%requires FsUtil
%requires ../../ExecModeHarness.qm

%exec-class WeakReferenceTypedStoreTest

#! a weak assignment to a typed variable that is not a plain local checks the type of the value assigned (qore#6979)
/** In IR, JIT, tiered and qcc executables, a weak assignment (\c :=) of an object to a variable of an object type that
    is not a plain local (a local that a closure captures, a closure variable, a global, a thread-local) raised
    \c RUNTIME-TYPE-ERROR (\c "expects type '*object', but got type 'weak reference'"): the store was given the weak
    reference made already, where the AST interpreter checks the type of the value assigned and then makes the weak
    reference.  The program covers the variables of the object types \c *object, \c object and \c *C, their
    declarations with a weak initializer (also \c const and in a loop), the value of the assignment, the values of a
    type that the variable refuses, and the weak and opaque (\c @=) assignments that worked before (a plain local, an
    untyped variable, hash and list types).  Every mode must print the output of the AST.

    The program \c weak-reference-store-through-reference covers the weak and opaque assignments to a local that
    holds a reference (a local of a reference type, an untyped local, a parameter, a local given a reference as an
    element of a list): the referenced lvalue is assigned with its own type, which converts the value (a softlist, a
    \c hash<string, softint>) or refuses it before the weak reference is made.  In JIT code and qcc executables, the
    store converted the value to the type of the local and assigned it to the referenced lvalue unconverted
    (qore#7164).

    The programs are in \c weak-reference-typed-store/.
*/
class WeakReferenceTypedStoreTest inherits QUnit::Test {
    private {
        string qore_bin = TestInterpreter::qore_interpreter();
        string dir = get_script_dir() + "/weak-reference-typed-store";

        const Modes = ("ast", "ir", "jit", "tiered");
        const Programs = ("weak-reference-typed-store", "weak-reference-store-through-reference");
    }

    constructor() : QUnit::Test("WeakReferenceTypedStoreTest", "1.0", \ARGV) {
        addTestCase("the AST interpreter prints the expected output", \testAst());
        addTestCase("IR, JIT and tiered execution print the output of the AST", \testModes());
        addTestCase("qcc executables print the output of the AST", \testCompiled());
        set_return_value(main());
    }

    private string expected(string name) {
        return ReadOnlyFile::readTextFile(dir + "/" + name + ".expected");
    }

    private string run(string name, string mode) {
        hash<ExecModeHarness::ModeRunResult> r = ExecModeHarness::run_command(sprintf("%s -b --enable-debug "
            "--exec-mode=%s %s/%s.q", qore_bin, mode, dir, name));
        assertEq(0, r.rc, sprintf("%s %s: exit status (output: %y)", name, mode, r.out));
        return r.stdout;
    }

    testAst() {
        foreach string name in (Programs) {
            assertEq(expected(name), run(name, "ast"), name + " ast");
        }
    }

    testModes() {
        foreach string name in (Programs) {
            foreach string mode in (Modes) {
                if (mode == "ast") {
                    continue;
                }
                assertEq(expected(name), run(name, mode), name + " " + mode);
            }
        }
    }

    testCompiled() {
        string qcc_bin = ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        if (!is_file(qcc_bin)) {
            *string path = backquote("command -v qcc 2>/dev/null");
            trim path;
            if (!path) {
                testSkip("qcc is not available");
            }
            qcc_bin = path;
        }
        TmpDir tmp("qore-weak-reference-typed-store-");
        foreach string name in (Programs) {
            foreach string opt in (("0", "3")) {
                string exe = sprintf("%s/%s-O%s", tmp.path, name, opt);
                int rc;
                string out = backquote(sprintf("%s -O%s -o %s %s/%s.q 2>&1", qcc_bin, opt, exe, dir, name), \rc);
                assertEq(0, rc, sprintf("%s -O%s: qcc compiles the program: %s", name, opt, out));
                if (rc || !is_file(exe)) {
                    continue;
                }
                # -b must be the first argument of a compiled program
                string result = backquote(sprintf("%s -b 2>&1", exe), \rc);
                assertEq(0, rc, sprintf("%s -O%s: exit status (output: %y)", name, opt, result));
                assertEq(expected(name), result, sprintf("%s -O%s", name, opt));
            }
        }
    }
}
