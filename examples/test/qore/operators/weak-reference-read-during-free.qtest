#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-exec-mode: children - its checks run in child processes that set their own execution modes
# test-platform: macos - reads through weak references of lists and hashes that other threads free, in native code

# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires ../../TestInterpreter.qm
%requires FsUtil
%requires ../../ExecModeHarness.qm

%exec-class WeakReferenceReadDuringFreeTest

#! a list or hash read through a weak reference while another thread frees it reads as freed (qore#7198)
/** A weak reference (\c :=) does not keep the entries of its list or hash; a read through it took a reference to the
    container also when its last reference had been released and another thread was freeing it, and the entries were
    freed under the reference.  A debug hook (dbg_hold_container_free()) holds the freeing thread at the start of the
    free, so that each case reads at that point deterministically, with no sleeps.  The programs are in
    \c weak-reference-read-during-free/:
    - \c weak-reference-read-during-free.q reads through an object member, a local, a closure and a global variable, a
      hash member and a list element: every mode, the JIT also with synchronous compilation, and qcc executables must
      print the output of the AST
    - \c weak-reference-read-during-free-interp.q reads through the variable of a foreach loop and an identity map,
      which native code reads borrowed from runtime helpers whose ownership changes with the AOT batch; it is run by
      the AST and IR interpreters only, and native code relies on the weak holders' reference for these reads until
      then (qore#7163)

    The hook is in debug builds only, which the test jobs build.
*/
class WeakReferenceReadDuringFreeTest inherits QUnit::Test {
    private {
        string qore_bin = TestInterpreter::qore_interpreter();
        string dir = get_script_dir() + "/weak-reference-read-during-free";

        const Modes = ("ast", "ir", "jit", "tiered");
        const Programs = ("weak-reference-read-during-free",);
        #! read by the interpreters only (see the class description)
        const InterpreterPrograms = ("weak-reference-read-during-free-interp",);
    }

    constructor() : QUnit::Test("WeakReferenceReadDuringFreeTest", "1.0", \ARGV) {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            addTestCase("the reads during a free", sub () {
                testSkip("the free is held with dbg_hold_container_free(), which only a library debug build has");
            });
            set_return_value(main());
            return;
        }
        addTestCase("the AST interpreter prints the expected output", \testAst());
        addTestCase("IR, JIT and tiered execution print the output of the AST", \testModes());
        addTestCase("the IR interpreter reads foreach variables and identity maps as the AST does", \testInterpreters());
        addTestCase("qcc executables print the output of the AST", \testCompiled());
        set_return_value(main());
    }

    private string expected(string name) {
        return ReadOnlyFile::readTextFile(dir + "/" + name + ".expected");
    }

    private string run(string name, string mode, string env = "") {
        hash<ExecModeHarness::ModeRunResult> r = ExecModeHarness::run_command(sprintf("%s%s -b --enable-debug "
            "--exec-mode=%s %s/%s.q", env, qore_bin, mode, dir, name));
        assertEq(0, r.rc, sprintf("%s %s: exit status (output: %y)", name, mode, r.out));
        return r.stdout;
    }

    testAst() {
        foreach string name in (Programs) {
            assertEq(expected(name), run(name, "ast"), name + " ast");
        }
    }

    testModes() {
        foreach string name in (Programs) {
            foreach string mode in (Modes) {
                if (mode == "ast") {
                    continue;
                }
                assertEq(expected(name), run(name, mode), name + " " + mode);
            }
            # the functions compiled before they run
            assertEq(expected(name), run(name, "jit", "QORE_JIT_SYNC_COMPILE=1 "), name + " jit (synchronous)");
        }
    }

    testInterpreters() {
        foreach string name in (InterpreterPrograms) {
            assertEq(expected(name), run(name, "ast"), name + " ast");
            assertEq(expected(name), run(name, "ir"), name + " ir");
        }
    }

    testCompiled() {
        string qcc_bin = ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        if (!is_file(qcc_bin)) {
            *string path = backquote("command -v qcc 2>/dev/null");
            trim path;
            if (!path) {
                testSkip("qcc is not available");
            }
            qcc_bin = path;
        }
        TmpDir tmp("qore-weak-reference-read-during-free-");
        foreach string name in (Programs) {
            foreach string opt in (("0", "3")) {
                string exe = sprintf("%s/%s-O%s", tmp.path, name, opt);
                int rc;
                string out = backquote(sprintf("%s -O%s -o %s %s/%s.q 2>&1", qcc_bin, opt, exe, dir, name), \rc);
                assertEq(0, rc, sprintf("%s -O%s: qcc compiles the program: %s", name, opt, out));
                if (rc || !is_file(exe)) {
                    continue;
                }
                # -b must be the first argument of a compiled program
                string result = backquote(sprintf("%s -b 2>&1", exe), \rc);
                assertEq(0, rc, sprintf("%s -O%s: exit status (output: %y)", name, opt, result));
                assertEq(expected(name), result, sprintf("%s -O%s", name, opt));
            }
        }
    }
}
