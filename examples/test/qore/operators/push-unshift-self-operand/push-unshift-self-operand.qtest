#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - all checks run in workers with explicit execution modes or as qcc executables
# test-platform: macos - JIT/AOT compilation and linking of the push and unshift operators

%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires ../../../TestInterpreter.qm
%requires FsUtil
%requires ../../../ExecModeHarness.qm
%exec-class PushUnshiftSelfOperandTest

#! push and unshift of an lvalue's own value push the value that the operand had when it was evaluated
/** The operand is the lvalue's own list: the list is copied before it is changed, so it does not contain itself
    (the AST interpreter pushed the list into itself, or failed an assertion of a debug build for unshift).  Every
    execution mode and a compiled executable must give the expected values.
*/
class PushUnshiftSelfOperandTest inherits QUnit::Test {
    private {
        string qore_bin = TestInterpreter::qore_interpreter();
        string libdir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        string qcc_bin = ENV.QCC_BIN ?? ENV.QORE_QCC_EXECUTABLE ?? libdir + "/qcc";
        string worker = get_script_dir() + "/push-unshift-self-operand-worker.q";
        string prefix;
    }

    constructor() : QUnit::Test("PushUnshiftSelfOperand", "1.0", \ARGV) {
        prefix = "LD_LIBRARY_PATH=" + quote(libdir) + " DYLD_LIBRARY_PATH=" + quote(libdir)
            + " QORE_LIBDIR=" + quote(libdir) + " ";
        addTestCase("push and unshift of the lvalue's own value in every execution mode", \checkModes());
        set_return_value(main());
    }

    private static string quote(string value) {
        return "'" + replace(value, "'", "'\"'\"'") + "'";
    }

    private checkOutput(string out, string mode) {
        list<string> lines = select out.split("\n"), $1;
        assertEq(24, lines.size(), mode + ": all cases ran");
        assertEq((), (select lines, !($1 =~ /^PASS /)), mode + ": every case gives the expected value");
    }

    checkModes() {
        foreach string mode in (ExecModeHarness::ExecModes) {
            checkOutput(ExecModeHarness::run(prefix + quote(qore_bin) + " -b --enable-debug --exec-mode=" + mode + " "
                + quote(worker)), mode);
        }
        checkOutput(ExecModeHarness::run_ir_tier(prefix + quote(qore_bin) + " -b --enable-debug --exec-mode=tiered "
            + quote(worker)), ExecModeHarness::IRTierName);
        TmpDir tmp("qore-push-self-");
        string exe = tmp.path + DirSep + "push-self";
        ExecModeHarness::run_any(prefix + quote(qcc_bin) + " -O2 -o " + quote(exe) + " " + quote(worker));
        assertTrue(is_file(exe), "qcc produced the executable");
        checkOutput(ExecModeHarness::run_any(prefix + quote(exe) + " -b --enable-debug"), "AOT");
    }
}
