#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-exec-mode: children - its checks run in child processes that set their own execution modes
# test-platform: macos - JIT and AOT code generation of implicit argument lists and of the release order of values

# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../ExecModeHarness.qm

%exec-class ImplicitArgvContextTest

#! $$ in the contexts that set it, and the release order of folds and hash maps (qore#5804, #5807, #5808, #5806)
/** `$$` is the list of the implicit arguments: the single element of a map, select or hash map, the two values of a
    foldl or foldr, and in a loop body the arguments of the function.  The compiled modes built the list from the
    values of the context even when the element had no value (the AST interpreter has no list then, so `$$` is
    NOTHING, where they gave `[NULL]`), and the body of a foreach loop, which has a context of its own that holds
    only an element, gave an empty list instead of the function's arguments.  `$$` has no element type at parse time,
    and the values of a fold and of a hash map are released in the order of the AST interpreter.  Every mode, qcc
    executables included, must print the output of the AST.

    The program is in \c implicit-argv-context/.
*/
class ImplicitArgvContextTest inherits QUnit::Test {
    private {
        string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        string dir = get_script_dir() + "/implicit-argv-context";

        const Modes = ("ast", "ir", "jit", "tiered");
        const Programs = ("implicit-argv-context",);
    }

    constructor() : QUnit::Test("ImplicitArgvContextTest", "1.0", \ARGV) {
        addTestCase("the AST interpreter prints the expected output", \testAst());
        addTestCase("IR, JIT and tiered execution print the output of the AST", \testModes());
        addTestCase("qcc executables print the output of the AST", \testCompiled());
        set_return_value(main());
    }

    private string expected(string name) {
        return ReadOnlyFile::readTextFile(dir + "/" + name + ".expected");
    }

    private string run(string name, string mode) {
        hash<ExecModeHarness::ModeRunResult> r = ExecModeHarness::run_command(sprintf("%s -b --enable-debug "
            "--exec-mode=%s %s/%s.q", qore_bin, mode, dir, name));
        assertEq(0, r.rc, sprintf("%s %s: exit status (output: %y)", name, mode, r.out));
        return r.stdout;
    }

    testAst() {
        foreach string name in (Programs) {
            assertEq(expected(name), run(name, "ast"), name + " ast");
        }
    }

    testModes() {
        foreach string name in (Programs) {
            foreach string mode in (Modes) {
                assertEq(expected(name), run(name, mode), name + " " + mode);
            }
        }
    }

    testCompiled() {
        string qcc_bin = ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }
        TmpDir tmp("qore-implicit-argv-context-");
        foreach string name in (Programs) {
            foreach string opt in (("0", "3")) {
                string exe = sprintf("%s/%s-O%s", tmp.path, name, opt);
                int rc;
                string out = backquote(sprintf("%s -O%s -o %s %s/%s.q 2>&1", qcc_bin, opt, exe, dir, name), \rc);
                if (rc || !is_file(exe)) {
                    testSkip("qcc is not available or cannot compile " + name + ": " + out);
                }
                # -b must be the first argument of a compiled program
                string result = backquote(sprintf("%s -b 2>&1", exe), \rc);
                assertEq(0, rc, sprintf("%s -O%s: exit status (output: %y)", name, opt, result));
                assertEq(expected(name), result, sprintf("%s -O%s", name, opt));
            }
        }
    }
}
