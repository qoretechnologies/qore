#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

# @file closure_destruction_order.qtest
# Comprehensive tests for closure-captured variables destruction order (issue #5168)
#
# Tests that closure-captured variables at program scope are destroyed in
# reverse declaration order, not after all non-captured variables.

%modern
%enable-all-warnings

%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/Util.qm

%exec-class ClosureDestructionOrderTest

class ClosureDestructionOrderTest inherits QUnit::Test {
    constructor() : QUnit::Test("Closure destruction order test", "1.0") {
        addTestCase("basic closure capture", \testBasicClosureCapture());
        addTestCase("first variable captured", \testFirstVariableCaptured());
        addTestCase("last variable captured", \testLastVariableCaptured());
        addTestCase("all variables captured", \testAllVariablesCaptured());
        addTestCase("single variable with closure", \testSingleVariableWithClosure());
        addTestCase("multiple closures same variable", \testMultipleClosuresSameVariable());
        addTestCase("multiple closures different variables", \testMultipleClosuresDifferentVariables());
        addTestCase("nested closures", \testNestedClosures());
        addTestCase("program scope destruction", \testProgramScopeDestruction());
        addTestCase("closure never called", \testClosureNeverCalled());
        addTestCase("nested blocks with closures", \testNestedBlocksWithClosures());
        addTestCase("dependent object destruction order", \testDependentObjectDestructionOrder());
        addTestCase("interleaved capture and declaration", \testInterleavedCaptureAndDeclaration());
        set_return_value(main());
    }

    private string getTrackedClassDef() {
        return "
class Tracked {
    private { string id; }
    constructor(string n) { id = n; }
    destructor() { push destruction_order, id; }
    string getId() { return id; }
}
";
    }

    private string getHeader() {
        return "
%modern

our list<string> destruction_order = ();
";
    }

    private hash<auto> runScript(string script) {
        # Write script to temp file and execute
        string tmp_file = tmp_location() + DirSep + "closure_test_" + get_random_string() + ".q";
        on_exit {
            unlink(tmp_file);
        }

        File f();
        f.open2(tmp_file, O_WRONLY | O_CREAT | O_TRUNC);
        f.write(script);
        f.close();

        string qore_exe = ENV.QORE_EXECUTABLE ?? "qore";
        string cmd = sprintf("%s %s 2>&1", qore_exe, tmp_file);
        string output;
        int exit_code = 0;
        try {
            output = backquote(cmd);
        } catch (hash<ExceptionInfo> ex) {
            # backquote throws on non-zero exit; extract exit code from exception
            output = ex.desc;
            # The exception arg contains the exit code
            exit_code = ex.arg ?? 1;
        }

        return {
            "stdout": output,
            "exit_code": exit_code,
        };
    }

    private assertDestructionOrder(string test_name, string script, list<string> expected) {
        hash<auto> result = runScript(script);
        if (result.exit_code != 0) {
            fail(sprintf("%s: Script failed with exit code %d: %s",
                test_name, result.exit_code, result.stdout));
            return;
        }
        assertTrue(result.stdout.find("PASS") >= 0,
            sprintf("%s: Expected PASS, got: %s", test_name, result.stdout));
    }

    # Basic test: middle variable captured
    testBasicClosureCapture() {
        string script = getHeader() + getTrackedClassDef() + "
{
    Tracked t1('t1');
    Tracked t2('t2');
    Tracked t3('t3');

    code closure = sub() { t2.getId(); };

    Tracked t4('t4');
    Tracked t5('t5');
}

list<string> expected = ('t5', 't4', 't3', 't2', 't1');
if (destruction_order != expected) {
    printf('FAIL: Expected %y, got %y\\n', expected, destruction_order);
    exit(1);
}
printf('PASS\\n');
";
        assertDestructionOrder("basic closure capture", script, ("t5", "t4", "t3", "t2", "t1"));
    }

    # Corner case: first variable is captured
    testFirstVariableCaptured() {
        string script = getHeader() + getTrackedClassDef() + "
{
    Tracked t1('t1');
    code closure = sub() { t1.getId(); };
    Tracked t2('t2');
    Tracked t3('t3');
}

list<string> expected = ('t3', 't2', 't1');
if (destruction_order != expected) {
    printf('FAIL: Expected %y, got %y\\n', expected, destruction_order);
    exit(1);
}
printf('PASS\\n');
";
        assertDestructionOrder("first variable captured", script, ("t3", "t2", "t1"));
    }

    # Corner case: last variable is captured
    testLastVariableCaptured() {
        string script = getHeader() + getTrackedClassDef() + "
{
    Tracked t1('t1');
    Tracked t2('t2');
    Tracked t3('t3');
    code closure = sub() { t3.getId(); };
}

list<string> expected = ('t3', 't2', 't1');
if (destruction_order != expected) {
    printf('FAIL: Expected %y, got %y\\n', expected, destruction_order);
    exit(1);
}
printf('PASS\\n');
";
        assertDestructionOrder("last variable captured", script, ("t3", "t2", "t1"));
    }

    # Corner case: all variables are captured
    testAllVariablesCaptured() {
        string script = getHeader() + getTrackedClassDef() + "
{
    Tracked t1('t1');
    Tracked t2('t2');
    Tracked t3('t3');
    code closure = sub() {
        t1.getId();
        t2.getId();
        t3.getId();
    };
}

list<string> expected = ('t3', 't2', 't1');
if (destruction_order != expected) {
    printf('FAIL: Expected %y, got %y\\n', expected, destruction_order);
    exit(1);
}
printf('PASS\\n');
";
        assertDestructionOrder("all variables captured", script, ("t3", "t2", "t1"));
    }

    # Corner case: single variable with closure
    testSingleVariableWithClosure() {
        string script = getHeader() + getTrackedClassDef() + "
{
    Tracked t1('t1');
    code closure = sub() { t1.getId(); };
}

list<string> expected = ('t1',);
if (destruction_order != expected) {
    printf('FAIL: Expected %y, got %y\\n', expected, destruction_order);
    exit(1);
}
printf('PASS\\n');
";
        assertDestructionOrder("single variable with closure", script, ("t1",));
    }

    # Multiple closures capturing the same variable
    testMultipleClosuresSameVariable() {
        string script = getHeader() + getTrackedClassDef() + "
{
    Tracked t1('t1');
    Tracked t2('t2');
    code c1 = sub() { t2.getId(); };
    code c2 = sub() { t2.getId(); };
    Tracked t3('t3');
}

list<string> expected = ('t3', 't2', 't1');
if (destruction_order != expected) {
    printf('FAIL: Expected %y, got %y\\n', expected, destruction_order);
    exit(1);
}
printf('PASS\\n');
";
        assertDestructionOrder("multiple closures same variable", script, ("t3", "t2", "t1"));
    }

    # Multiple closures capturing different variables
    testMultipleClosuresDifferentVariables() {
        string script = getHeader() + getTrackedClassDef() + "
{
    Tracked t1('t1');
    Tracked t2('t2');
    code c1 = sub() { t1.getId(); };
    Tracked t3('t3');
    code c2 = sub() { t3.getId(); };
    Tracked t4('t4');
}

list<string> expected = ('t4', 't3', 't2', 't1');
if (destruction_order != expected) {
    printf('FAIL: Expected %y, got %y\\n', expected, destruction_order);
    exit(1);
}
printf('PASS\\n');
";
        assertDestructionOrder("multiple closures different variables", script, ("t4", "t3", "t2", "t1"));
    }

    # Nested closures
    testNestedClosures() {
        string script = getHeader() + getTrackedClassDef() + "
{
    Tracked t1('t1');
    Tracked t2('t2');
    # Outer closure captures t1 and t2
    code outer = sub() {
        t1.getId();
        t2.getId();
    };
    Tracked t3('t3');
}

list<string> expected = ('t3', 't2', 't1');
if (destruction_order != expected) {
    printf('FAIL: Expected %y, got %y\\n', expected, destruction_order);
    exit(1);
}
printf('PASS\\n');
";
        assertDestructionOrder("nested closures", script, ("t3", "t2", "t1"));
    }

    # Program scope (not block scope) - this was the original bug scenario
    testProgramScopeDestruction() {
        string script = getHeader() + getTrackedClassDef() + "
# Program scope variables (no surrounding block)
Tracked t1('t1');
Tracked t2('t2');
code closure = sub() { t2.getId(); };
Tracked t3('t3');

# The verification happens via exit handler
our bool verified = False;

# We can't easily verify at program scope since destruction happens after
# all code runs, so we just ensure no crash occurs
printf('PASS\\n');
";
        hash<auto> result = runScript(script);
        assertEq(0, result.exit_code, sprintf("Program scope test should not crash: %s",
            result.stdout));
    }

    # Closure that is never called should still have correct destruction order
    testClosureNeverCalled() {
        string script = getHeader() + getTrackedClassDef() + "
{
    Tracked t1('t1');
    Tracked t2('t2');
    # This closure captures t2 but is never called
    code closure = sub() { t2.getId(); };
    Tracked t3('t3');
    # closure is never invoked
}

list<string> expected = ('t3', 't2', 't1');
if (destruction_order != expected) {
    printf('FAIL: Expected %y, got %y\\n', expected, destruction_order);
    exit(1);
}
printf('PASS\\n');
";
        assertDestructionOrder("closure never called", script, ("t3", "t2", "t1"));
    }

    # Nested blocks with closures
    testNestedBlocksWithClosures() {
        string script = getHeader() + getTrackedClassDef() + "
{
    Tracked t1('t1');
    {
        Tracked t2('t2');
        code closure = sub() { t2.getId(); };
        Tracked t3('t3');
    }
    # t2, t3 should be destroyed here in reverse order
    Tracked t4('t4');
}

# Inner block: t3, t2; Outer block: t4, t1
list<string> expected = ('t3', 't2', 't4', 't1');
if (destruction_order != expected) {
    printf('FAIL: Expected %y, got %y\\n', expected, destruction_order);
    exit(1);
}
printf('PASS\\n');
";
        assertDestructionOrder("nested blocks with closures", script, ("t3", "t2", "t4", "t1"));
    }

    # Test dependent object destruction order (simulates the ZMQ scenario from the bug report)
    # Object B depends on Object A - A must be destroyed AFTER B
    testDependentObjectDestructionOrder() {
        string script = getHeader() + "
# Use a global to track context active state
our bool ctx_active = False;

class TestContext {
    constructor() {
        ctx_active = True;
    }
    destructor() {
        push destruction_order, 'context';
        ctx_active = False;
    }
    bool isActive() { return ctx_active; }
}

class TestSocket {
    private {
        TestContext ctx;
        string name;
    }
    constructor(TestContext c, string n) {
        ctx = c;
        name = n;
    }
    destructor() {
        push destruction_order, name;
        # In real ZMQ, this would deadlock if context is already destroyed
        if (!ctx.isActive()) {
            printf('ERROR: Context destroyed before socket %s!\\n', name);
            exit(2);
        }
    }
    string getName() { return name; }
}

{
    TestContext ctx();
    TestSocket sock(ctx, 'socket');

    # Closure captures sock - previously this would cause sock to be destroyed
    # AFTER ctx, causing the simulated deadlock
    code closure = sub() { sock.getName(); };
}

# Socket must be destroyed before context
# Expected: socket, context (reverse declaration, respecting dependencies)
list<string> expected = ('socket', 'context');
if (destruction_order != expected) {
    printf('FAIL: Expected %y, got %y\\n', expected, destruction_order);
    exit(1);
}
printf('PASS\\n');
";
        hash<auto> result = runScript(script);
        assertEq(0, result.exit_code,
            sprintf("Dependent object test failed (possible destruction order bug): %s",
                result.stdout));
        assertTrue(result.stdout.find("PASS") >= 0,
            sprintf("Dependent object test should pass: %s", result.stdout));
        assertTrue(result.stdout.find("ERROR") < 0,
            sprintf("Context should not be destroyed before socket: %s", result.stdout));
    }

    # Interleaved capture and declaration - complex scenario
    testInterleavedCaptureAndDeclaration() {
        string script = getHeader() + getTrackedClassDef() + "
{
    Tracked t1('t1');
    code c1 = sub() { t1.getId(); };
    Tracked t2('t2');
    code c2 = sub() { t1.getId(); t2.getId(); };
    Tracked t3('t3');
    code c3 = sub() { t2.getId(); t3.getId(); };
    Tracked t4('t4');
}

# All should be destroyed in reverse declaration order
list<string> expected = ('t4', 't3', 't2', 't1');
if (destruction_order != expected) {
    printf('FAIL: Expected %y, got %y\\n', expected, destruction_order);
    exit(1);
}
printf('PASS\\n');
";
        assertDestructionOrder("interleaved capture and declaration", script, ("t4", "t3", "t2", "t1"));
    }
}
