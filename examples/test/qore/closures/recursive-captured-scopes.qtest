#!/usr/bin/env qore
# Copyright 2026 Qore Technologies, s.r.o.
%modern
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires ../../../../qlib/QUnit.qm
%requires ../../../../qlib/FsUtil.qm
%requires ../../ExecModeHarness.qm
%exec-class RecursiveCapturedScopesTest

class RecursiveCapturedScopesTest inherits QUnit::Test {
    private {
        string qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        string fixture = get_script_dir() + "/RecursiveCapturedScopes.qm";
    }

    constructor() : QUnit::Test("Recursive captured scopes", "1.0", \ARGV) {
        foreach string mode in (("ast", "ir", "jit", "tiered")) {
            string execution_mode = mode;
            addTestCase("recursive scopes, escaped captures, and exceptions: " + mode, sub () {
                checkFixture(fixture, execution_mode);
            });
        }
        addTestCase("AOT preserves the same captured-local lifetimes", \testAot());
        set_return_value(main());
    }

    private checkFixture(string module_path, string mode, bool restored_closures = False,
            *ExecModeHarness::NativeCheck check) {
        # Compilation must finish before the short test proceeds; otherwise a native regression can falsely pass while
        # running only the IR tier: ExecModeHarness compiles synchronously and checks that native code ran.
        string environment = restored_closures ? "QORE_DISABLE_AOT_NATIVE_CLOSURES=1 " : "";
        string output = ExecModeHarness::run(environment + sprintf("%s -b --enable-debug --exec-mode=%s -l %s -ne %s",
            shellQuote(qore_bin), shellQuote(mode), shellQuote(module_path),
            shellQuote("printf(\"%d\\n\", RecursiveCapturedScopes::ScopeChecks::run());")), check);
        assertEq("6000\n", output, "all captured values survived their lexical and recursive scope exits");
    }

    private testAot() {
        string qcc_bin = ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }
        string module_dir = make_tmp_dir();
        on_exit remove_tree(module_dir);
        string module_path = module_dir + "/RecursiveCapturedScopes.qmod";
        string output = backquote(sprintf("%s -m --strip-source --parse-option=PO_ENABLE_DEBUG -o %s %s 2>&1", shellQuote(qcc_bin),
            shellQuote(module_path), shellQuote(fixture)));
        assertTrue(is_file(module_path) && hstat(module_path).size > 0,
            "the captured-scope fixture compiled: " + output);
        # the module's code is compiled ahead of time, so tiered execution compiles nothing
        checkFixture(module_path, "tiered", False, ExecModeHarness::NativeCheck::Jit);
        checkFixture(module_path, "jit", True);
    }

    private static string shellQuote(string value) {
        return "'" + replace(value, "'", "'\\''") + "'";
    }
}
