#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# test-exec-mode: children - its checks run in child processes that set their own execution modes
# test-platform: macos - JIT and AOT code generation of the type checks of typed callables

# Copyright 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires ../../TestInterpreter.qm
%requires FsUtil
%requires ../../ExecModeHarness.qm

%exec-class TypedCallableSignatureTest

#! the signature of a typed callable is checked when a closure or call reference is stored or passed (qore#6660)
/** A code<...> type accepts a closure or call reference whose signature is compatible with its own (covariant return
    type, contravariant parameter types); before, every code<...> type accepted every callable at run time, a
    list<code<int(int)>> kept a string() closure, and two variants that differed only in the signature of a typed
    callable parameter were duplicates.  Every mode, qcc executables included, must print the output of the AST, and
    a mismatch known at parse time is a parse error.

    The programs are in \c typed-callable-signature/.
*/
class TypedCallableSignatureTest inherits QUnit::Test {
    private {
        string qore_bin = TestInterpreter::qore_interpreter();
        string dir = get_script_dir() + "/typed-callable-signature";

        const Modes = ("ast", "ir", "jit", "tiered");
        const Programs = ("typed-callable-signature", "typed-callable-overload");

        #! code that is a parse error: a mismatch known at parse time
        const ParseErrors = {
            "variable": "code<int(int)> d = string sub () { return \"x\"; };",
            "parameter": "sub f(code<int(int)> c) {} f(string sub () { return \"x\"; });",
            "typed variable": "code<string()> c = string sub () { return \"x\"; }; code<int(int)> d = c;",
            "return": "code<int(int)> sub f() { return string sub () { return \"x\"; }; }",
        };
    }

    constructor() : QUnit::Test("TypedCallableSignatureTest", "1.0", \ARGV) {
        addTestCase("the AST interpreter prints the expected output", \testAst());
        addTestCase("IR, JIT and tiered execution print the output of the AST", \testModes());
        addTestCase("qcc executables print the output of the AST", \testCompiled());
        addTestCase("a mismatch known at parse time is a parse error", \testParseErrors());
        set_return_value(main());
    }

    private string expected(string name) {
        return ReadOnlyFile::readTextFile(dir + "/" + name + ".expected");
    }

    private string run(string name, string mode) {
        hash<ExecModeHarness::ModeRunResult> r = ExecModeHarness::run_command(sprintf("%s -b --enable-debug "
            "--exec-mode=%s %s/%s.q", qore_bin, mode, dir, name));
        assertEq(0, r.rc, sprintf("%s %s: exit status (output: %y)", name, mode, r.out));
        return r.stdout;
    }

    testAst() {
        foreach string name in (Programs) {
            assertEq(expected(name), run(name, "ast"), name + " ast");
        }
    }

    testModes() {
        foreach string name in (Programs) {
            foreach string mode in (Modes) {
                assertEq(expected(name), run(name, mode), name + " " + mode);
            }
        }
    }

    testCompiled() {
        string qcc_bin = ENV.QCC_BIN ?? dirname(qore_bin) + "/qcc";
        if (!is_file(qcc_bin)) {
            qcc_bin = "qcc";
        }
        TmpDir tmp("qore-typed-callable-signature-");
        foreach string name in (Programs) {
            foreach string opt in (("0", "3")) {
                string exe = sprintf("%s/%s-O%s", tmp.path, name, opt);
                int rc;
                string out = backquote(sprintf("%s -O%s -o %s %s/%s.q 2>&1", qcc_bin, opt, exe, dir, name), \rc);
                if (rc || !is_file(exe)) {
                    testSkip("qcc is not available or cannot compile " + name + ": " + out);
                }
                # -b must be the first argument of a compiled program
                string result = backquote(sprintf("%s -b 2>&1", exe), \rc);
                assertEq(0, rc, sprintf("%s -O%s: exit status (output: %y)", name, opt, result));
                assertEq(expected(name), result, sprintf("%s -O%s", name, opt));
            }
        }
    }

    testParseErrors() {
        TmpDir tmp("qore-typed-callable-signature-parse-");
        foreach hash<auto> i in (ParseErrors.pairIterator()) {
            string file = sprintf("%s/%s.q", tmp.path, replace(i.key, " ", "-"));
            File f();
            f.open2(file, O_CREAT | O_TRUNC | O_WRONLY);
            f.write("%modern\n" + i.value + "\n");
            f.close();
            hash<ExecModeHarness::ModeRunResult> r = ExecModeHarness::run_command(sprintf("%s -b --exec-mode=ast %s",
                qore_bin, file));
            assertNeq(0, r.rc, i.key + ": exit status");
            assertRegex("PARSE-TYPE-ERROR|PARSE-EXCEPTION", r.out, i.key);
        }
    }
}
