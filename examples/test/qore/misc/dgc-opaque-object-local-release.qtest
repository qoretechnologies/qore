#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# test-exec-mode: children - its checks run in child processes that set their own execution modes

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires FsUtil
%requires ../../ExecModeHarness.qm

%exec-class DgcOpaqueObjectLocalReleaseTest

#! Regression test: a value held through an opaque reference is released with the reference's registration
/** Every strong reference held through an opaque reference (the \c \@= operator) is registered with the opaque
    target registry, which the teardown of the target's Program uses to break the cycles that the collector cannot
    see (see design/dgc.md, "Opaque references").  A value read through an opaque reference keeps its opaque
    representation, and with it one registration for its reference, so every release of such a value must end its
    registration.  Releases that did not left the target registered after its last reference was released:
    - an object that the Program's teardown found still registered was deleted by it although other code still held
      it;
    - a target freed while registered was read after it had been freed by the teardown of its Program
      (qore_program_private_base::clearOpaqueTargets()); the qualification of the Pipedrive app schema of module-v8
      crashed at exit in tiered execution so (QoreModuleManager::delUser()), and a library with debugging aborts when
      such a target is freed.

    The releases that the cases check (Cases):
    - the locals of an object type (a class, \c object, also optional) keep their value in IR storage in the IR, JIT
      and tiered execution modes, which marks the object with a real reference; their release (the IR interpreter's
      slot cache and qore_rt_object_slot_release() for native code) released the object with QoreObject::realDeref()
      alone;
    - an assignment with \c := or \c \@= released the value that it replaced with its weak or opaque form as a plain
      node (LValueHelper::assign());
    - a change through an opaque reference to a container that is shared copies the container (copy-on-write); the
      copy replaced the opaque value as an ordinary value and the value replaced was released as a plain node
      (LValueHelper::ensureUnique(), also for a push in native code), in every execution mode;
    - the \c hash<auto!> and \c list<auto!> coercion of a typed container read through an opaque reference copies it
      and released the value it replaced as a plain node (QoreTypeInfo::applyNoNarrowCoercion()).

    GuardCases hold values read through an opaque reference on paths that release them with their registration
    already (foreach variables, locals of no type, container values assigned with \c \@= or \c :=, a value read
    through a reference); they fail neither before nor after the fix and keep these paths checked.

    The driver script parses each case in a child Program in the execution mode given, calls a function that stores
    two objects with \c \@= and gives a value read through an opaque reference to the code of the case, and checks
    that the objects it returns are still alive after the child Program is deleted; a second function lets the
    objects be freed when it returns, before the Program is deleted.  Each function is called three times, so that
    JIT and tiered execution run it as native code (ExecModeHarness::TraceEnv); the tiered run on the IR tier
    (ExecModeHarness::run_ir_tier()) runs it with the IR interpreter in every call.  The driver also checks that a
    container held through an opaque reference stays held through one when a change copies it: a cycle through the
    copy is not collected while the Program lives, and is broken by its teardown.

    The cases also run in the driver's own Program, compiled into an executable by qcc as well (AotScript): there, a
    target freed while registered aborts a library with debugging, and the teardown of the Program at exit reads it
    after it has been freed.
*/
class DgcOpaqueObjectLocalReleaseTest inherits QUnit::Test {
    public {
        #! the cases whose release of a value read through an opaque reference left its registration before the fix
        const Cases = {
            "class local": "N x = h.a;",
            "object local": "object x = h.a;",
            "optional class local given by a call": "*N x = get_a(h);",
            "class local reassigned": "N x = h.b; x = h.a;",
            "class local read from an object member": "Holder hold(); hold.slot @= a; N x = hold.slot;",
            "class local read from a nested hash": "hash<auto> m = {\"k\": {}}; m.k.v @= a; *N x = m.k.v;",
            "class local read from a list": "list<auto> l = (); l[0] @= a; N x = l[0];",
            "class local assigned with @=": "N x; x @= h.a;",
            "class local assigned with :=": "N x; x := h.a;",
            "local of no type assigned with @=": "auto x; x @= h.a;",
            "local of no type assigned with :=": "auto x; x := h.a;",
            "hash held with @= changed through it": "hash<auto> inner = {}; inner.o = a; h.ih @= inner; h.ih.x = 2;",
            "string in a hash held with @= changed through it": "hash<auto> inner = {}; inner.o = a; "
                "inner.q = \"abc\"; h.ih @= inner; h.ih.q += \"x\";",
            "list held with @= changed through it": "list<auto> inner = (); inner[0] = a; h.il @= inner; "
                "h.il[1] = 3;",
            "list held with @= pushed to": "list<auto> inner = (); inner[0] = a; h.il @= inner; push h.il, 3;",
            "list held with @= appended to": "list<auto> inner = (); inner[0] = a; h.il @= inner; h.il += 3;",
            "typed hash held with @= given to a hash<auto!> local": "hash<string, N> inner = {\"o\": a}; "
                "h.ih @= inner; hash<auto!> c = h.ih; c.x = \"str\";",
            "typed hash held with @= given to a hash<auto!> parameter": "hash<string, N> inner = {\"o\": a}; "
                "h.ih @= inner; change_hash(h.ih);",
            "typed list held with @= given to a list<auto!> local": "list<N> inner = (a,); h.il @= inner; "
                "list<auto!> c = h.il; c += \"str\";",
            "typed list held with @= given to a list<auto!> parameter": "list<N> inner = (a,); h.il @= inner; "
                "change_list(h.il);",
        };

        #! cases on paths that release a value read through an opaque reference with its registration already
        const GuardCases = {
            "foreach variable of a class": "list<auto> l = (); l[0] @= a; foreach N x in (l) { x.other = 1; }",
            "foreach variable of no type": "list<auto> l = (); l[0] @= a; foreach auto x in (l) { x.other = 1; }",
            "local of no type": "auto x = h.a; x.other = 1;",
            "hash value assigned with @=": "hash<auto> h2 = {}; h2.c @= h.a;",
            "object member assigned with @=": "Holder hold(); hold.slot @= h.a;",
            "hash value assigned with :=": "hash<auto> h2 = {}; h2.c := h.a;",
            "object read through a reference": "reference<auto> r = \\h.a; auto v = r; v = r; v = r;",
        };

        #! the declarations that the code of the cases uses
        const Declarations = "class N { public { auto other; } }\n"
            "class Holder { public { auto slot; } }\n"
            "*N sub get_a(hash<auto> h) { return h.a; }\n"
            "sub change_hash(hash<auto!> p) { p.x = \"str\"; }\n"
            "sub change_list(list<auto!> p) { p += \"str\"; }\n";

        #! the driver script; ARGV[0] is the execution mode of the child Programs
        const Script = '%%modern
%%no-child-restrictions
const Cases = %s;
const Code = "%%modern\n"
    %s
    # returns an object stored with @= that the code of the case was given
    "N sub build() {\n"
    "    hash<auto> h = {};\n"
    "    N a();\n"
    "    N b();\n"
    "    h.a @= a;\n"
    "    h.b @= b;\n"
    "    %%s\n"
    "    return a;\n"
    "}\n"
    # the objects stored with @= are freed when it returns
    "sub release() {\n"
    "    hash<auto> h = {};\n"
    "    N a();\n"
    "    N b();\n"
    "    h.a @= a;\n"
    "    h.b @= b;\n"
    "    %%s\n"
    "}\n";
# a cycle through a copy of a hash held with @=: the edge from h to the copy stays opaque
const CowCode = "%%modern\n"
    "our code report;\n"
    "class D { public { auto other; } destructor() { report(); } }\n"
    "sub build() {\n"
    "    D d();\n"
    "    hash<auto> inner = {};\n"
    "    inner.d = d;\n"
    "    hash<auto> h = {};\n"
    "    h.ih @= inner;\n"
    "    # shared with inner: the change copies it\n"
    "    h.ih.x = 2;\n"
    "    d.other = h;\n"
    "}\n";
const Modes = {"ast": EM_AST, "ir": EM_IR, "jit": EM_JIT, "tiered": EM_TIERED};
ExecMode mode = Modes{ARGV[0]};
foreach hash<auto> i in (Cases.pairIterator()) {
    list<object> kept = ();
    {
        Program p(new ParseOptions(("allow-opaque-references", "allow-weak-references")));
        p.setExecMode(mode);
        p.parse(sprintf(Code, i.value, i.value), i.key);
        # several calls, so that JIT and tiered execution run the functions as native code
        for (int n = 0; n < 3; ++n) {
            kept += p.callFunction("build");
            p.callFunction("release");
        }
        # the teardown deletes only the objects that are still registered as opaque targets
        delete p;
    }
    printf("%%s: %%d of %%d kept\n", i.key, (select kept, $1).size(), kept.size());
}
{
    int destroyed = 0;
    code report = sub () { ++destroyed; };
    Program p(new ParseOptions("allow-opaque-references"));
    p.setExecMode(mode);
    p.parse(CowCode, "copy-on-write");
    p.setGlobalVarValue("report", report);
    for (int n = 0; n < 3; ++n) {
        p.callFunction("build");
    }
    printf("copy-on-write: %%d cycles collected while the Program lives\n", destroyed);
    delete p;
    printf("copy-on-write: %%d cycles broken by its teardown\n", destroyed);
}
printf("done\n");
';

        #! the cases run in the script's own Program, which is also compiled by qcc
        const AotScript = '%%modern
%%allow-opaque-references
%%allow-weak-references
%s
%s
# several calls, so that JIT and tiered execution run the functions as native code
for (int n = 0; n < 3; ++n) {
%s
}
printf("done\n");
';
    }

    private {
        string qore_bin;
        string libqore_dir;
        string qcc_bin;
    }

    constructor() : QUnit::Test("DgcOpaqueObjectLocalReleaseTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);
        qcc_bin = ENV.QCC ?? ENV.QORE_QCC
            ?? (is_file(libqore_dir + "/qcc") ? libqore_dir + "/qcc" : "qcc");
        foreach string mode in (ExecModeHarness::ExecModes) {
            addTestCase(sprintf("the targets are released with their registration in %s mode", mode),
                getModeTest(mode));
        }
        addTestCase("the targets are released with their registration on the IR tier", \runIrTier());
        foreach string mode in (ExecModeHarness::ExecModes) {
            addTestCase(sprintf("the cases run in the script's own Program in %s mode", mode),
                getOwnProgramTest(mode));
        }
        addTestCase("the cases run in a qcc executable", \runAot());
        set_return_value(main());
    }

    #! returns the test case of the given mode
    /** The mode is a parameter of its own for each closure: a closure created in the loop over the modes would see
        the loop variable's last value
    */
    private code getModeTest(string mode) {
        return sub () { runMode(mode); };
    }

    #! returns the test case running AotScript in the given mode
    private code getOwnProgramTest(string mode) {
        return sub () { runOwnProgram(mode); };
    }

    #! runs the driver in the given mode
    private runMode(string mode) {
        TmpDir tmp("qore-dgc-opaque-object-local-");
        string path = writeFile(tmp, "dgc-opaque-object-local-driver.qr", getScript());
        string out = ExecModeHarness::run(getCommand(mode, path, mode));
        assertEq(getExpected(), out, mode);
    }

    #! runs the driver with tiered execution on the IR tier
    runIrTier() {
        TmpDir tmp("qore-dgc-opaque-object-local-");
        string path = writeFile(tmp, "dgc-opaque-object-local-driver.qr", getScript());
        string out = ExecModeHarness::run_ir_tier(getCommand("tiered", path, "tiered"));
        assertEq(getExpected(), out, ExecModeHarness::IRTierName);
    }

    #! runs AotScript in the given mode
    private runOwnProgram(string mode) {
        TmpDir tmp("qore-dgc-opaque-object-local-");
        string path = writeFile(tmp, "dgc-opaque-object-local-own.qr", getAotScript());
        assertEq("done\n", ExecModeHarness::run(getCommand(mode, path)), mode);
    }

    #! compiles AotScript with qcc and runs the executable
    runAot() {
        TmpDir tmp("qore-dgc-opaque-object-local-");
        string path = writeFile(tmp, "dgc-opaque-object-local-own.qr", getAotScript());
        string exe = tmp.path + DirSep + "dgc-opaque-object-local-own";
        string out = backquote(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s %s -o %s %s 2>&1", libqore_dir,
            libqore_dir, qcc_bin, exe, path));
        assertTrue(is_file(exe), "compiled the executable: " + out);
        assertEq("done\n", ExecModeHarness::run_any(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s %s",
            libqore_dir, libqore_dir, exe)), "executable");
    }

    #! returns the command running a script
    /** @param mode the execution mode of the script
        @param path the path of the script
        @param arg the argument of the script, if any
    */
    private string getCommand(string mode, string path, *string arg) {
        return sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s %s -b --enable-debug --exec-mode=%s %s %s",
            libqore_dir, libqore_dir, qore_bin, mode, path, arg ?? "");
    }

    #! returns every case
    private static hash<string, string> getAllCases() {
        return Cases + GuardCases;
    }

    #! returns the output of the driver: every target is kept, a cycle through a copy-on-write copy is not collected
    #! while its Program lives, and the driver ends
    private static string getExpected() {
        return (foldl $1 + $2, (map sprintf("%s: 3 of 3 kept\n", $1), keys getAllCases()))
            + "copy-on-write: 0 cycles collected while the Program lives\n"
            + "copy-on-write: 3 cycles broken by its teardown\n"
            + "done\n";
    }

    #! returns the driver script
    private static string getScript() {
        return sprintf(Script, getHashLiteral(getAllCases()),
            foldl $1 + "\n    " + $2, (map quote($1 + "\n"), Declarations.split("\n")));
    }

    #! returns AotScript with a function for each case, which the script calls
    private static string getAotScript() {
        list<string> funcs = ();
        list<string> calls = ();
        int i = 0;
        foreach string code in (getAllCases().values()) {
            funcs += sprintf("sub case_%d() {\n    hash<auto> h = {};\n    N a();\n    N b();\n    h.a @= a;\n"
                "    h.b @= b;\n    %s\n}", i, code);
            calls += sprintf("    case_%d();", i);
            ++i;
        }
        return sprintf(AotScript, Declarations, funcs.join("\n"), calls.join("\n"));
    }

    #! writes a file into the directory given and returns its path
    private static string writeFile(TmpDir tmp, string name, string contents) {
        string path = tmp.path + DirSep + name;
        File f();
        f.open2(path, O_WRONLY | O_CREAT | O_TRUNC);
        on_exit f.close();
        f.write(contents);
        return path;
    }

    #! returns a hash of strings as a Qore hash literal
    private static string getHashLiteral(hash<string, string> h) {
        return "{" + (foldl $1 + ", " + $2, (map sprintf("%s: %s", quote($1.key), quote($1.value)),
            h.pairIterator())) + "}";
    }

    #! returns a Qore string literal for the given string
    private static string quote(string str) {
        return "\"" + replace(replace(replace(str, "\\", "\\\\"), "\"", "\\\""), "\n", "\\n") + "\"";
    }
}
