#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires QUnit
%requires ../../TestInterpreter.qm

%try-module process
%define NoProcess
%endtry

%exec-class KeyedHashSitesTest

#! The containers of the library whose keys come from data hash them with the keyed hash of the process (qore#7750)
/** Each such container records its site when it is constructed (debug builds: QORE_KEYED_HASH_SITE()), with the hash
    of a fixed probe by its hasher; dbg_keyed_hash_sites() returns them.  Child processes with fixed secret keys
    (QORE_DBG_HASH_KEY) construct the containers: each site must be recorded, and its hash must follow the key.
*/
class KeyedHashSitesTest inherits QUnit::Test {
    public {
        #! the sites of the containers that the child processes construct
        const NetworkSites = (
            "quic-connection-ids",
            "http3-server-stream-queues",
            "http3-server-tunnel-streams",
            "http3-server-pending-stream-data",
            "http3-server-response-send-watches",
            "http3-server-close-notify-streams",
            "http3-server-peer-closed-streams",
        );

        #! the time limit of a child process
        const ChildTimeout = 120s;

        const Key1 = "000102030405060708090a0b0c0d0e0f";
        const Key2 = "0f0e0d0c0b0a09080706050403020100";
    }

    constructor() : QUnit::Test("keyed hash sites", "1.0", \ARGV) {
        addTestCase("the network containers hash with the key of the process", \networkTest());
        set_return_value(main());
    }

    networkTest() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("the sites of keyed containers are only recorded in debug builds");
        }
        if (!Option::HAVE_HTTP3) {
            testSkip("HTTP/3 is not available");
        }
        # an HTTP/3 server operation on a UDP socket creates the connection ID map of the socket and its stream maps
        string src = "%modern\n"
            "Socket s();\n"
            "s.bindINET(\"127.0.0.1\", 0, False, AF_INET, SOCK_DGRAM);\n"
            "Http3ServerPollOperation op(s);\n"
            "hash<auto> sites = call_function(\"dbg_keyed_hash_sites\");\n"
            "foreach string site in (keys sites) {\n"
            "    printf(\"%s=%s\\n\", site, sites{site});\n"
            "}\n";
        hash<string, string> s1 = runSites(src, Key1);
        hash<string, string> s1b = runSites(src, Key1);
        hash<string, string> s2 = runSites(src, Key2);
        foreach string site in (NetworkSites) {
            assertTrue(exists s1{site}, sprintf("site %y is recorded", site));
            assertEq(s1{site}, s1b{site}, sprintf("site %y: the same key gives the same hash", site));
            assertNeq(s1{site}, s2{site}, sprintf("site %y: another key gives another hash", site));
        }
    }

    #! runs \a src in a child process with the secret key \a key and returns the sites that it prints
    private hash<string, string> runSites(string src, string key) {
        hash<string, string> rv = {};
        foreach string line in (trim(runChild(src, key)).split("\n")) {
            if (line =~ /^([a-z0-9-]+)=([0-9a-f]{16})$/) {
                list<string> l = line.split("=");
                rv{l[0]} = l[1];
            } else {
                assertTrue(False, "unexpected output line: " + line);
            }
        }
        return rv;
    }

    #! runs \a src in a child interpreter with QORE_DBG_HASH_KEY set to \a key and returns its output
    /** the child is ended if it does not finish within the time limit; the test is skipped without the process
        module, which bounds the run
    */
    private string runChild(string src, string key) {
%ifdef NoProcess
        testSkip("the process module is required to run bounded child processes");
        return "";
%else
        string file = tmp_location() + DirSep + sprintf("keyed-hash-sites-%d-%d.q", getpid(), ++child_count);
        File f();
        f.open2(file, O_CREAT | O_WRONLY | O_TRUNC);
        f.write(src);
        f.close();
        on_exit unlink(file);
        hash<auto> env = ENV - "QORE_DBG_HASH_KEY";
        env.QORE_DBG_HASH_KEY = key;
        StringOutputStream out_stream();
        StringOutputStream err_stream();
        Process p(TestInterpreter::qore_interpreter(), (file,), {
            "env": env,
            "stdout": out_stream,
            "stderr": err_stream,
        });
        bool done = p.wait(ChildTimeout);
        if (!done) {
            p.terminate();
            p.wait();
        }
        # getData() empties the stream, so each is read once
        string out = out_stream.getData();
        string err = err_stream.getData();
        assertTrue(done, "the child process finished within the time limit");
        assertEq(0, p.exitCode(), out + err);
        assertEq("", err, "the child process wrote nothing to stderr");
        return out;
%endif
    }

    private {
        int child_count = 0;
    }
}
