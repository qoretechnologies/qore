#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.

%modern
%no-child-restrictions

%prepend-module-path "${SCRIPT_DIR}/../../../../../qlib"
%requires QUnit
%requires FsUtil

%include expression-result-types-checks.qi

%exec-class ExpressionResultTypesTest

#! Tests that every execution engine takes the operands of an operator for the values they have
/** The checks in expression-result-types-checks.qi run in this program, in each execution mode, and from a compiled
    (AOT) module; every engine must give the same results, and every check must pass.
*/
class ExpressionResultTypesTest inherits QUnit::Test {
    public {
        const ExecModes = ("ast", "ir", "jit", "tiered");
    }

    private {
        string qore_bin;
        string libqore_dir;
        #! the results of the checks in this program
        list<string> expected;
    }

    constructor() : QUnit::Test("ExpressionResultTypesTest", "1.0", \ARGV) {
        qore_bin = ENV.QORE_BIN ?? ENV.QORE_BINARY ?? QORE_ARGV[0] ?? "qore";
        libqore_dir = ENV.QORE_LIBDIR ?? dirname(qore_bin);

        addTestCase("in this program", \testInProcess());
        addTestCase("each execution mode", \testExecModes());
        addTestCase("a compiled module", \testCompiledModule());
        set_return_value(main());
    }

    globalSetUp() {
        expected = ExpressionResultTypeChecks::get_results();
    }

    testInProcess() {
        checkResults("in-process", expected);
    }

    testExecModes() {
        foreach string mode in (ExecModes) {
            checkWorkerOutput(mode, runWorker("expression-result-types-worker.q", get_script_dir(), "--exec-mode=" + mode));
        }
    }

    testCompiledModule() {
        TmpDir tmp("qore-expression-result-types-");
        string qmod_path = tmp.path + DirSep + "ExpressionResultTypeChecks.qmod";
        string src_path = get_script_dir() + DirSep + "ExpressionResultTypeChecks.qm";
        string compile_out = backquote(sprintf("QORE_LIBDIR=%s %s -b --compile-module --strip-source --output "
            "%s %s 2>&1", libqore_dir, qore_bin, qmod_path, src_path));
        assertTrue(is_file(qmod_path), "compiled checks module: " + compile_out);

        # the directory holds only the compiled module, so the worker cannot load the source instead
        checkWorkerOutput("aot", runWorker("expression-result-types-module-worker.q", tmp.path));
    }

    #! runs a worker with the given module directory and options and returns its output
    private string runWorker(string worker_name, string module_dir, string opts = "") {
        string worker = get_script_dir() + DirSep + worker_name;
        return backquote(sprintf("LD_LIBRARY_PATH=%s DYLD_LIBRARY_PATH=%s QORE_MODULE_DIR=%s %s -b %s %s 2>&1",
            libqore_dir, libqore_dir, module_dir, qore_bin, opts, worker));
    }

    #! compares the lines printed by a worker with the results of the checks in this program
    private checkWorkerOutput(string label, string out) {
        list<string> results = select out.split("\n"), $1.val();
        checkResults(label, results);
        assertEq(expected, results, label + ": the same checks as in this program");
    }

    #! checks that every check passed
    private checkResults(string label, list<string> results) {
        assertTrue(results.size() > 0, label + ": checks ran");
        foreach string line in (results) {
            assertTrue(line =~ /^ok /, label + ": " + line);
        }
    }
}
