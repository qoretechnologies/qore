# module of aot-dependency-domains.qtest: a module that declares the locale control domain and requires a module that
# uses it after its header with a version requirement (qore#6351)

%modern

module DdVer {
    version = "1.0";
    desc = "a module with a versioned request";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
    domains = "LOCALE_CONTROL";
}

%requires DdInner >= 1.0

public namespace DdVer {
    public string sub run() {
        return DdInner::run();
    }
}
