# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# module of aot-dependency-domains.qtest: a module that restricts locale control itself where it is loaded with
# PO_NO_GUI (a conditional on a parse option), and requires DdSxI: DdSxI keeps the restriction (qore#6351)

%modern

module DdCfN {
    version = "1.0";
    desc = "a module of aot-dependency-domains.qtest";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
}

%ifdef PO_NO_GUI
%no-locale-control
%endif
%requires DdSxI

public namespace DdCfN {
    public string sub run() {
        return DdSxI::run();
    }
}
