# module of aot-dependency-domains.qtest: a module that declares the locale control domain, requires an unrelated
# module before its header and a module that uses locale control after it, which is relieved (qore#6351)

%modern
%requires DdUnrel

module DdPos {
    version = "1.0";
    desc = "a module that requires an unrelated module before its header";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
    domains = "LOCALE_CONTROL";
}

%requires DdInner

public namespace DdPos {
    public string sub run() {
        return DdInner::run();
    }
}
