%modern

module DdOuterOther {
    version = "1.0";
    desc = "a module that declares the process control domain";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
    domains = "PROCESS_CONTROL";
}

%requires DdInner

public namespace DdOuterOther {
    public string sub run() {
        return DdInner::run();
    }
}
