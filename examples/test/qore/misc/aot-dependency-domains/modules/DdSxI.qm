# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# module of aot-dependency-domains.qtest: a module that uses locale control at run time, with the restrictions it was
# loaded with (qore#6351)

%modern

module DdSxI {
    version = "1.0";
    desc = "a module of aot-dependency-domains.qtest";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
}

public namespace DdSxI {
    public string sub run() {
        try {
            call_function("set_thread_tz", TimeZone::get());
            return "inner ran";
        } catch (hash<ExceptionInfo> ex) {
            return "restricted: " + ex.err;
        }
    }
}
