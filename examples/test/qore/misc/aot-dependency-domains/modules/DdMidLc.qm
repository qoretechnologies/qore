# module of aot-dependency-domains.qtest: a module that declares the locale control domain and requires a module that
# uses it after its header; DdTopPre requires it before its own header (qore#6351)

%modern

module DdMidLc {
    version = "1.0";
    desc = "a module required before a header";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
    domains = "LOCALE_CONTROL";
}

%requires DdInner

public namespace DdMidLc {
    public string sub run() {
        return DdInner::run();
    }
}
