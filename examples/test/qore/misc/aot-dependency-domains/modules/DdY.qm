# module of aot-dependency-domains.qtest: a module that declares the locale control domain and restricts
# locale control again after its header, before it requires DdPrD: DdPrD and DdPrEx keep the restriction
# (qore#6351)

%modern

module DdY {
    version = "1.0";
    desc = "a module of aot-dependency-domains.qtest";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
    domains = "LOCALE_CONTROL";
}

%no-locale-control
%requires DdPrD

public namespace DdY {
    public string sub run() {
        return DdPrD::run();
    }
}
