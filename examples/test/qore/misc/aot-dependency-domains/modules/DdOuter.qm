%modern

module DdOuter {
    version = "1.0";
    desc = "a module that declares the locale control domain";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
    domains = "LOCALE_CONTROL";
}

%requires DdInner

public namespace DdOuter {
    public string sub run() {
        return DdInner::run();
    }
}
