# module of aot-dependency-domains.qtest: a module that restricts locale control itself after its header and requires
# DdSxI: DdSxI has the restriction, also when the module loading this one has removed it (DdSxO) (qore#6351)

%modern

module DdSxN {
    version = "1.0";
    desc = "a module of aot-dependency-domains.qtest";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
}

%no-locale-control
%requires DdSxI

public namespace DdSxN {
    public string sub run() {
        return DdSxI::run();
    }
}
