# module of aot-dependency-domains.qtest: a module that declares the locale control domain and requires a module that
# uses it before and after its header: it is loaded before the header, with the restriction (qore#6351)

%modern
%requires DdInner

module DdDup {
    version = "1.0";
    desc = "a module with a request before and after its header";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
    domains = "LOCALE_CONTROL";
}

%requires DdInner

public namespace DdDup {
    public string sub run() {
        return DdInner::run();
    }
}
