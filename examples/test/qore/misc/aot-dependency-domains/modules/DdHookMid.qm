# module of aot-dependency-domains.qtest: a module, always loaded from source, whose constant runs the callbacks of
# DdHook while it is parsed: the code of the Program that registered them runs while DdHookTop's dependency is loaded
# (qore#6351)

%modern

%requires DdHook

module DdHookMid {
    version = "1.0";
    desc = "a module of aot-dependency-domains.qtest";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
}

public namespace DdHookMid {
    const Fired = DdHook::Hooks::fire();

    public string sub run() {
        return "mid";
    }
}
