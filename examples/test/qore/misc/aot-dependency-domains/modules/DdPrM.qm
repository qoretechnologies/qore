# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# module of aot-dependency-domains.qtest: a module that declares the locale control domain, requests DdPrB before its
# header with an included file, which loads DdPrEx with the restriction, and requires DdPrD after its header, which
# requires DdPrEx too: DdPrEx keeps the restriction (qore#6351)

%modern
%include DdPrM.inc

module DdPrM {
    version = "1.0";
    desc = "a module whose dependency shares a module loaded before its header";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
    domains = "LOCALE_CONTROL";
}

%requires DdPrD

public namespace DdPrM {
    public string sub run() {
        return DdPrD::run();
    }
}
