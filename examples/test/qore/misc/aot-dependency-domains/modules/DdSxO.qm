# module of aot-dependency-domains.qtest: a module that declares the locale control domain and requires DdSxN after its
# header, which restricts locale control itself (qore#6351)

%modern

module DdSxO {
    version = "1.0";
    desc = "a module of aot-dependency-domains.qtest";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
    domains = "LOCALE_CONTROL";
}

%requires DdSxN

public namespace DdSxO {
    public string sub run() {
        return DdSxN::run();
    }
}
