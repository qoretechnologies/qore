# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
# module of aot-dependency-domains.qtest: a module that declares the locale control domain, has a conditional on a
# library option (which depends on the build configuration of the library), and requires a module that uses locale
# control after its header: it runs from source; a compiled module relieves nothing (it fails closed) (qore#6351)

%modern

module DdOpt {
    version = "1.0";
    desc = "a module of aot-dependency-domains.qtest";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
    domains = "LOCALE_CONTROL";
}

%ifdef HAVE_SHA256
%endif
%requires DdInner

public namespace DdOpt {
    public string sub run() {
        return DdInner::run();
    }
}
