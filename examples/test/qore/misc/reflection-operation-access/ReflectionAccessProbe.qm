%modern
%requires reflection

/** @section reflectionaccessprobeintro Reflection access test fixture
    Exercises the trusted-module boundary from source and compiled module code.
*/
module ReflectionAccessProbe {
    version = "1.0";
    desc = "Reflection operation access regression fixture";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
}

public class ReflectionAccessProbe {
    static auto read(GlobalVar value) {
        return value.getValue();
    }

    static write(GlobalVar value) {
        value.setValue(99);
    }

    static auto call(Function func) {
        return func.call();
    }

    static auto defaultValue(AbstractMember member) {
        return member.getDefaultValue();
    }

    static object construct(Class cls, string operation, list<auto> args) {
        switch (operation) {
            case "newObject": return cls.newObject(args[0]);
            case "newObjectArgs": return cls.newObjectArgs(args);
            case "callConstructor": return cls.callConstructor(args, NOTHING);
            case "method": return cls.getConstructorMethod().call(args[0]);
            case "methodArgs": return cls.getConstructorMethod().callArgs(args);
            case "variant": return cls.getConstructorVariants()[0].call(args[0]);
            case "variantArgs": return cls.getConstructorVariants()[0].callArgs(args);
        }
        throw "TEST-ERROR", "unknown constructor operation";
    }

    static auto callStatic(StaticMethodVariant method) {
        return method.call();
    }
}
