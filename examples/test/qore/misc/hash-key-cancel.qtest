%modern
%prepend-module-path "${SCRIPT_DIR}/../../../../qlib"
%requires ../../../../qlib/QUnit.qm
%exec-class HashKeyCancelTest

class HashKeyCancelTest inherits QUnit::Test {
    constructor() : Test("Hash key scan cancellation", "1.0", \ARGV) {
        addTestCase("chunk boundaries, cancellation, deferral and recovery", \nativeChecks());
        set_return_value(main());
    }

    private nativeChecks() {
        string qore = ENV.QORE_BINARY ?? QORE_ARGV[0];
        string native = ENV.QORE_HASH_KEY_CANCEL_TEST ?? dirname(qore) + "/qore-hash-key-cancel-test";
        if (!is_file(native)) {
            testSkip("the native hash key cancellation test executable is not available");
            return;
        }
        int rc;
        string output = backquote("'" + replace(native, "'", "'\\''") + "' 2>&1", \rc);
        assertEq(0, rc, output);
        assertEq("PASS: 172 hash key cancellation checks\n", output);
    }
}
